digraph {
	"QuincyRank6Convo5 begins." [color=orange];
		"QuincyRank6Convo5 begins." -> j240003470;
	j240003470 [label="我有套理論",shape=box,color=blue];
		j240003470 -> j531356195;
	j531356195 [label="而我不需要來你確認或否認，我只是好奇",shape=box,color=blue];
		j531356195 -> j911487206;
	j911487206 [label="就當作我只是在「自言自語」還什麼的",shape=box,color=blue];
		j911487206 -> j1871782582;
		j911487206 -> j3578666745;
	j1871782582 [label="你覺得誰又被誰煞到了？",shape=box,color=red];
		j1871782582 -> j2438870064;
	j3578666745 [label="哦？我洗耳恭聽。",shape=box,color=red];
		j3578666745 -> j2826138563;
	j2438870064 [label="笑死，不，如果你問我的話，見鬼了，這支隊伍有一半的人都需要把它從他們該死的體內釋放出來",shape=box,color=blue];
		j2438870064 -> j1822962475;
	j2826138563 [label="我跟老大一起在屋頂上狙擊科腐者",shape=box,color=blue];
		j2826138563 -> j530383281;
		j2826138563 -> j473079857;
		j2826138563 -> j531310484;
		j2826138563 -> j1381813332;
	j1822962475 [label="但，隨便了，不是來這裡聊八卦，雖然那一直都是很棒的笑料，哈哈",shape=box,color=blue];
		j1822962475 -> j2826138563;
	j530383281 [label="那……聽起來像是在虐待動物……",shape=box,color=red];
		j530383281 -> j665413787;
	j473079857 [label="我想我跟得上你講的話。",shape=box,color=red];
		j473079857 -> j577485972;
	j531310484 [label="老大？",shape=box,color=red];
		j531310484 -> j3446544910;
	j1381813332 [label="狙擊？",shape=box,color=red];
		j1381813332 -> j1969823052;
	j665413787 [label="你嘛幫幫忙",shape=box,color=blue];
		j665413787 -> j1457105910;
	j577485972 [label="你學得很好，哈哈",shape=box,color=blue];
		j577485972 -> j3348018787;
	j3446544910 [label="是亞瑟，哈哈",shape=box,color=blue];
		j3446544910 -> j3348018787;
	j1969823052 [label="哈哈，擊殺，在這種情況下是射殺的意思",shape=box,color=blue];
		j1969823052 -> j3348018787;
	j1457105910 [label="意思是我跟亞瑟一起在屋頂上射殺科腐者，你這白癡",shape=box,color=blue];
		j1457105910 -> j3348018787;
	j3348018787 [label="是的，他很遜不會用瞄準鏡，對吧，於是我就在那裡，我們為了好玩在射殺一些遊蕩的科腐者",shape=box,color=blue];
		j3348018787 -> j4108742590;
	j4108742590 [label="同時也給他指點一二，對吧？就在那個當下我意識到",shape=box,color=blue];
		j4108742590 -> j815532892;
	j815532892 [label="等一下",shape=box,color=blue];
		j815532892 -> j1261820004;
	j1261820004 [label="我到底在幹嘛",shape=box,color=blue];
		j1261820004 -> j3608157623;
	j3608157623 [label="和陛下玩在一起，好像我們很要好似得",shape=box,color=blue];
		j3608157623 -> j2594752905;
	j2594752905 [label="就是，對呀，我知道你修好了問題，我們不必在那個循環中不斷死亡了，但",shape=box,color=blue];
		j2594752905 -> j2531482995;
	j2531482995 [label="夥計，亞瑟和我從來就不是朋友",shape=box,color=blue];
		j2531482995 -> j1805861198;
		j2531482995 -> j3150769698;
	j1805861198 [label="我……很抱歉？",shape=box,color=red];
		j1805861198 -> j1173973403;
	j3150769698 [label="所以你是想暗示什麼？",shape=box,color=red];
		j3150769698 -> j1275427300;
	j1173973403 [label="所以這就是問題所在，某方面來說這是你的「錯」，我感覺得到，只是我搞不明白",shape=box,color=blue];
		j1173973403 -> j1275427300;
	j1275427300 [label="所以，我們循環過多少次了？你知道嗎？",shape=box,color=blue];
		j1275427300 -> j503827398;
		j1275427300 -> j4472578;
	j503827398 [label="很多次了。怎麼了嗎？",shape=box,color=red];
		j503827398 -> j2315895387;
	j4472578 [label="我沒有確切地數過。",shape=box,color=red];
		j4472578 -> j2315895387;
	j2315895387 [label="我不會記得每次循環，會嗎？不，別回答",shape=box,color=blue];
		j2315895387 -> j1659648708;
	j1659648708 [label="但即使我頭腦不記得，某個部分的我還是感受得到，對吧？",shape=box,color=blue];
		j1659648708 -> j430293052;
	j430293052 [label="因為我知道我應該會有某種感覺，但實際上我卻有不同感覺",shape=box,color=blue];
		j430293052 -> j1342789268;
	j1342789268 [label="而我唯一能想到的是，因為某種原因……某部分的我們……不知道欸……存在於循環之外？",shape=box,color=blue];
		j1342789268 -> j2239631658;
	j2239631658 [label="我開始在講屁話了，而且我對這些香火和晶石沒什麼興趣，這些都是愛琳娜拿手的東西",shape=box,color=blue];
		j2239631658 -> j2762684741;
	j2762684741 [label="你覺得我講得有道理嗎？",shape=box,color=blue];
		j2762684741 -> j861830656;
		j2762684741 -> j461830765;
		j2762684741 -> j2113604636;
	j861830656 [label="沒有，抱歉。",shape=box,color=red];
		j861830656 -> j870599495;
	j461830765 [label="我不明白這到底是怎麼回事。或許是你身上被感染的部分？或者是虛空……之類的關係？",shape=box,color=red];
		j461830765 -> j1394132225;
	j2113604636 [label="非常有道理。我完全相信你。",shape=box,color=red];
		j2113604636 -> j530309227;
	j870599495 [label="呃，隨便，至少我試過了",shape=box,color=blue];
		j870599495 -> "Chat ends.";
	j1394132225 [label="+5 Chemistry",color=orange];
		j1394132225 -> j4202124054;
	j530309227 [label="+5 Chemistry",color=orange];
		j530309227 -> j1684290671;
	"Chat ends." [color=orange];
	j4202124054 [label="不知道，真的不在乎為什麼會發生，只是它確實有發生",shape=box,color=blue];
		j4202124054 -> j1259633126;
	j1684290671 [label="至少我還沒完全瘋掉。又或至少我不是一個人在瘋，哈哈",shape=box,color=blue];
		j1684290671 -> j1259633126;
	j1259633126 [label="我想這算是件好事吧，知道我們還能持續進化和學習",shape=box,color=blue];
		j1259633126 -> j822926167;
	j822926167 [label="還是什麼的",shape=box,color=blue];
		j822926167 -> j2191003416;
	j2191003416 [label="好了，這些深奧的東西聊夠了，我要去跟那把該死會說話的吉他喝到斷片",shape=box,color=blue];
		j2191003416 -> j2171015288;
	j2171015288 [label="如果你隨便餵她過期的軍用口糧，她就會告訴你一些荒謬至極的故事，只是別告訴弗烈爾，笑死",shape=box,color=blue];
		j2171015288 -> "Chat ends.";
}