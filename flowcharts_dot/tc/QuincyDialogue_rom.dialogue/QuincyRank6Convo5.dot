	3844 [label="好了，這些深奧的東西聊夠了，我要去跟那把該死會說話的吉他喝到斷片",shape=box,color=blue];
		3844 -> 3845;
	3845 [label="如果你隨便餵她過期的軍用口糧，她就會告訴你一些荒謬至極的故事，只是別告訴弗烈爾，笑死",shape=box,color=blue];
		3845 -> 3846;
