		3801 -> 3803;
	3802 [label="笑死，不，如果你問我的話，見鬼了，這支隊伍有一半的人都需要把它從他們該死的體內釋放出來",shape=box,color=blue];
		3802 -> 3804;
	3803 [label="我跟老大一起在屋頂上狙擊科腐者",shape=box,color=blue];
		3803 -> 3805;
		3803 -> 3806;
		3803 -> 3807;
		3803 -> 3808;
	3804 [label="但，隨便了，不是來這裡聊八卦，雖然那一直都是很棒的笑料，哈哈",shape=box,color=blue];
		3804 -> 3803;
	3805 [label="那……聽起來像是在虐待動物……",shape=box,color=red];
		3805 -> 3809;
	3806 [label="我想我跟得上你講的話。",shape=box,color=red];
		3806 -> 3810;
	3807 [label="老大？",shape=box,color=red];
		3807 -> 3811;
	3808 [label="狙擊？",shape=box,color=red];
		3808 -> 3812;
	3809 [label="你嘛幫幫忙",shape=box,color=blue];
		3809 -> 3813;
	3810 [label="你學得很好，哈哈",shape=box,color=blue];
		3810 -> 3814;
	3811 [label="是亞瑟，哈哈",shape=box,color=blue];
		3811 -> 3814;
	3812 [label="哈哈，擊殺，在這種情況下是射殺的意思",shape=box,color=blue];
		3812 -> 3814;
	3813 [label="意思是我跟亞瑟一起在屋頂上射殺科腐者，你這白癡",shape=box,color=blue];
		3813 -> 3814;
	3814 [label="是的，他很遜不會用瞄準鏡，對吧，於是我就在那裡，我們為了好玩在射殺一些遊蕩的科腐者",shape=box,color=blue];
		3814 -> 3815;
	3815 [label="同時也給他指點一二，對吧？就在那個當下我意識到",shape=box,color=blue];
		3815 -> 3816;
	3816 [label="等一下",shape=box,color=blue];
		3816 -> 3817;
	3817 [label="我到底在幹嘛",shape=box,color=blue];
		3817 -> 3818;
	3818 [label="和陛下玩在一起，好像我們很要好似得",shape=box,color=blue];
		3818 -> 3819;
	3819 [label="就是，對呀，我知道你修好了問題，我們不必在那個循環中不斷死亡了，但",shape=box,color=blue];
		3819 -> 3820;
	3820 [label="夥計，亞瑟和我從來就不是朋友",shape=box,color=blue];
		3820 -> 3821;
		3820 -> 3822;
	3821 [label="我……很抱歉？",shape=box,color=red];
		3821 -> 3823;
	3822 [label="所以你是想暗示什麼？",shape=box,color=red];
		3822 -> 3824;
	3823 [label="所以這就是問題所在，某方面來說這是你的「錯」，我感覺得到，只是我搞不明白",shape=box,color=blue];
		3823 -> 3824;
	3824 [label="所以，我們循環過多少次了？你知道嗎？",shape=box,color=blue];
		3824 -> 3825;
		3824 -> 3826;
	3825 [label="很多次了。怎麼了嗎？",shape=box,color=red];
		3825 -> 3827;
	3826 [label="我沒有確切地數過。",shape=box,color=red];
		3826 -> 3827;
	3827 [label="我不會記得每次循環，會嗎？不，別回答",shape=box,color=blue];
		3827 -> 3828;
	3828 [label="但即使我頭腦不記得，某個部分的我還是感受得到，對吧？",shape=box,color=blue];
		3828 -> 3829;
	3829 [label="因為我知道我應該會有某種感覺，但實際上我卻有不同感覺",shape=box,color=blue];
		3829 -> 3830;
	3830 [label="而我唯一能想到的是，因為某種原因……某部分的我們……不知道欸……存在於循環之外？",shape=box,color=blue];
		3830 -> 3831;
	3831 [label="我開始在講屁話了，而且我對這些香火和晶石沒什麼興趣，這些都是愛琳娜拿手的東西",shape=box,color=blue];
		3831 -> 3832;
	3832 [label="你覺得我講得有道理嗎？",shape=box,color=blue];
		3832 -> 3833;
		3832 -> 3834;
		3832 -> 3835;
	3833 [label="沒有，抱歉。",shape=box,color=red];
		3833 -> 3836;
	3834 [label="我不明白這到底是怎麼回事。或許是你身上被感染的部分？或者是虛空……之類的關係？",shape=box,color=red];
		3834 -> 3837;
	3835 [label="非常有道理。我完全相信你。",shape=box,color=red];
		3835 -> 3838;
	3836 [label="呃，隨便，至少我試過了",shape=box,color=blue];
		3836 -> 3839;
	3837 [label="+5 Chemistry",color=orange];
		3837 -> 3840;
	3838 [label="+5 Chemistry",color=orange];
		3838 -> 3841;
	3839 [label="Chat ends.",color=orange];
	3840 [label="不知道，真的不在乎為什麼會發生，只是它確實有發生",shape=box,color=blue];
		3840 -> 3842;
	3841 [label="至少我還沒完全瘋掉。又或至少我不是一個人在瘋，哈哈",shape=box,color=blue];
		3841 -> 3842;
	3842 [label="我想這算是件好事吧，知道我們還能持續進化和學習",shape=box,color=blue];
