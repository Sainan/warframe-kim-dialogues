digraph {
	2386 [label="EleanorRank5Convo4 begins.",color=orange];
		2386 -> 2387;
	2387 [label="Check boolean EleanorDating",color=orange];
		2387 -> 2388 [label=true,color=green];
		2387 -> 2389 [label=false,color=brown];
	2388 [label="親愛的？如果你在的話，我想借你的耳朵。",shape=box,color=blue];
		2388 -> 2390;
	2389 [label="如果你在的話，我想找個朋友。",shape=box,color=blue];
		2389 -> 2390;
	2390 [label="Check boolean EleanorArthurNightmare",color=orange];
		2390 -> 2391 [label=true,color=green];
		2390 -> 2392 [label=false,color=brown];
	2391 [label="我又做那些亞瑟的夢了。那些他要殺了我的夢。",shape=box,color=blue];
		2391 -> 2394;
		2391 -> 2395;
	2392 [label="我一直做這個關於亞瑟的可怕的夢，那些他要殺了我的夢。當他將刀插入我的肋骨之間的時候，我尖叫「愛琳娜就在這裡，你這個愚蠢的混蛋！」但他再也聽不到我的聲音了。",shape=box,color=blue];
		2392 -> 2393;
	2394 [label="我在這裡。沒事的。",shape=box,color=red];
		2394 -> 2397;
	2395 [label="[無視]",shape=box,color=red];
		2395 -> 2396;
	2393 [label="Update boolean EleanorArthurNightmare",color=orange];
		2393 -> 2394;
		2393 -> 2395;
	2397 [label="亞瑟不會殺你，愛琳娜。你是他的姐姐。他知道的。",shape=box,color=red];
		2397 -> 2398;
	2396 [label="Chat ends.",color=orange];
	2398 [label="不止如此。 「你不再是我的姐姐了。」這是他在夢裡說的。然後他用他的玩具劍刺穿了我的胸口。",shape=box,color=blue];
		2398 -> 2399;
	2399 [label="我們在夢裡不過是小孩子，如果這個夢還不夠瘋狂的話。",shape=box,color=blue];
		2399 -> 2400;
		2399 -> 2401;
	2400 [label="這不是真的。我不相信亞瑟會傷害你，無論你被感染的程度高或低。",shape=box,color=red];
		2400 -> 2402;
	2401 [label="……哎呀。",shape=box,color=red];
		2401 -> 2403;
	2402 [label="甚至不「給我個痛快」嗎？即使我在受苦也不給我嗎？",shape=box,color=blue];
		2402 -> 2408;
	2403 [label="對啊。這是最糟糕的部分。",shape=box,color=blue];
		2403 -> 2404;
	2408 [label="他是他父親的兒子。他堅持要做對的事，而不是做容易的事。",shape=box,color=blue];
		2408 -> 2409;
		2408 -> 2410;
	2404 [label="夢活現眼前，那麼的真實。就像我在回憶一些確實發生過的事情一樣。",shape=box,color=blue];
		2404 -> 2405;
		2404 -> 2406;
	2409 [label="無論你認為你的家庭有多糟糕，跟我遇到的一些人相比都算不了什麼。",shape=box,color=red];
		2409 -> 2411;
	2410 [label="等等。你父親跟這件事有什麼關係？",shape=box,color=red];
		2410 -> 2412;
	2405 [label="不過我肯定亞瑟不會真的這麼做的。",shape=box,color=red];
		2405 -> 2408;
	2406 [label="也許你可以跟亞瑟談談這件事？",shape=box,color=red];
		2406 -> 2407;
	2411 [label="我想也是。未來在殘酷方面非常有創意。",shape=box,color=blue];
		2411 -> 2413;
	2412 [label="所有事情。",shape=box,color=blue];
		2412 -> 2414;
		2412 -> 2415;
	2407 [label="我不可以。他是他父親的兒子。他堅持要做對的事，而不是做容易的事。",shape=box,color=blue];
		2407 -> 2409;
		2407 -> 2410;
	2413 [label="但我關心的是過去。",shape=box,color=blue];
		2413 -> 2416;
	2414 [label="如果你想讓我明白的話你要跟我多解釋一點。",shape=box,color=red];
		2414 -> 2416;
	2415 [label="愛琳娜。拜託不要再裝傻了。",shape=box,color=red];
		2415 -> 2417;
	2416 [label="這是其中一件我們從不討論的許多事情之一。",shape=box,color=blue];
		2416 -> 2420;
	2417 [label="我沒有。",shape=box,color=blue];
		2417 -> 2418;
	2420 [label="我們不談論在卡芳娜發生的事情，我們不談論克里斯多福，我們從不談論嘉莉奶奶。",shape=box,color=blue];
		2420 -> 2421;
		2420 -> 2422;
	2418 [label="我真的在盡力解釋。",shape=box,color=blue];
		2418 -> 2419;
	2421 [label="那或許你不應該去談論。",shape=box,color=red];
		2421 -> 2423;
	2422 [label="那或許你應該去談論。",shape=box,color=red];
		2422 -> 2425;
	2419 [label="我父親為亞瑟以及我處理我們之間問題的方式訂立了榜樣。或者更確切地說，我們不處理。",shape=box,color=blue];
		2419 -> 2420;
	2423 [label="或許我不應該去談論。",shape=box,color=blue];
		2423 -> 2424;
	2425 [label="或許我應該去談論。",shape=box,color=blue];
		2425 -> 2426;
	2424 [label="Chat ends.",color=orange];
	2426 [label="或許也是時候了。",shape=box,color=blue];
		2426 -> 2427;
	2427 [label="你想聽完整的故事嗎？或者我精簡地重點說？",shape=box,color=blue];
		2427 -> 2428;
		2427 -> 2429;
	2428 [label="我哪裡也不去。跟我說完整的故事。",shape=box,color=red];
		2428 -> 2432;
	2429 [label="我可以聽那個精簡版嗎？",shape=box,color=red];
		2429 -> 2430;
	2432 [label="嘉莉奶奶是我們的祖母。嘉莉絲塔・潘洛斯・南丁格爾。",shape=box,color=blue];
		2432 -> 2433;
	2430 [label="嘉莉奶奶病得很重。老年癡呆。父親不願讓她繼續受苦，而是用枕頭讓她窒息至死。希望這對你來說夠簡短了吧。",shape=box,color=blue];
		2430 -> 2431;
	2433 [label="她患有佩勒姆綜合症。現在應該已經有療法了吧（她憂憂的說道）。這個病會侵蝕一個人的心智。你愛的人並不會一下子就去世，而是慢慢地逐漸地消散，就像一張在陽光下曬而褪色的舊相片，或是一段複製了太多次的影片。",shape=box,color=blue];
		2433 -> 2434;
		2433 -> 2435;
	2431 [label="Chat ends.",color=orange];
	2434 [label="就像蘇達的經歷讓她決定成為中樞。我明白。",shape=box,color=red];
		2434 -> 2436;
	2435 [label="其實……沒有，我們尚未可以徹底治療這個病症……",shape=box,color=red];
		2435 -> 2436;
	2436 [label="當她第一次跟我們一起住的時候，亞瑟和我非常興奮。對我們來說，她是一位可愛的老人家，散發著紫羅蘭的香氣，用各種不同的聲音講述故事。她在我們生日時送我們實質的錢。我們還以為會一直像每天過生日一樣。",shape=box,color=blue];
		2436 -> 2437;
	2437 [label="然後她開始走下坡。開始她只是有點健忘。然後她開始認不清我們跟其他人。她叫我做艾伯丁，叫阿瑟做查理。想知道吉米跑到哪裡去了。我們從來不知道吉米是隻狗，貓還是男朋友。",shape=box,color=blue];
		2437 -> 2438;
	2438 [label="然後她開始跟不在現場的人交談。天黑後她開始在房子裡閒晃。",shape=box,color=blue];
		2438 -> 2440;
		2438 -> 2441;
	2440 [label="那種情況對你們兩個來說一定很可怕。",shape=box,color=red];
		2440 -> 2439;
	2441 [label="噢，虛空。",shape=box,color=red];
		2441 -> 2439;
	2439 [label="我記得半夜去洗手間的時候，看到她在黑暗中沿著走廊搖搖晃晃地向我走來，呻吟著，她的臉扭曲著，她的頭髮就像一頂瘋狂的小丑假髮。我無法停止尖叫。",shape=box,color=blue];
		2439 -> 2442;
	2442 [label="當情況變得非常惡劣時，她會躺在床上尖叫。早上我們出去上學，當我轉入我們的街時，我的心會沉下去，因為八個小時後，我可以從十棟房子之外便聽到她的尖叫聲。",shape=box,color=blue];
		2442 -> 2443;
	2443 [label="我們的父親曾經說過要在她臉上蓋個枕頭。我們以為他在開玩笑，因為他肯定是在開玩笑，那是他的媽媽。",shape=box,color=blue];
		2443 -> 2444;
		2443 -> 2445;
	2444 [label="現在很多事情都說得通了。",shape=box,color=red];
		2444 -> 2446;
	2445 [label="……噢。",shape=box,color=red];
		2445 -> 2446;
	2446 [label="一天晚上她在尖叫，然後尖叫聲突然停止了。我起床去了亞瑟的房間。當然，他也醒了。我們坐在一起一直聽一直聽，然後我們聽到她房間的門關上了。",shape=box,color=blue];
		2446 -> 2447;
	2447 [label="第二天爸爸說，她在睡夢中去世了。",shape=box,color=blue];
		2447 -> 2448;
		2447 -> 2449;
	2448 [label="而你擔心亞瑟也會對你做相同的事情嗎？",shape=box,color=red];
		2448 -> 2450;
	2449 [label="亞瑟不是你的父親。他不會做你爸爸所做過的事。",shape=box,color=red];
		2449 -> 2451;
	2450 [label="如果他真的認為這是最好的做法呢？",shape=box,color=blue];
		2450 -> 2452;
	2451 [label="你不知道的。如果亞瑟真的認為這是最好的做法？",shape=box,color=blue];
		2451 -> 2452;
	2452 [label="我不知道。或許。現在我跟第二個人傾訴後，這個可能性好像低了很多。",shape=box,color=blue];
		2452 -> 2453;
	2453 [label="+20 Chemistry",color=orange];
		2453 -> 2454;
	2454 [label="你很好。謝謝你聽我說。我很需要跟人傾訴。",shape=box,color=blue];
		2454 -> 2455;
	2455 [label="Update boolean EleanorDreams",color=orange];
		2455 -> 2456;
	2456 [label="Chat ends.",color=orange];
}