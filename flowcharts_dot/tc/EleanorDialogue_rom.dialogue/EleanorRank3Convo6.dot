		1339 -> 1340;
	1342 [label="天哪。經手術變美的人會放肆在未經測試的藥物上？不。",shape=box,color=blue];
		1342 -> 1346;
	1343 [label="你看。我對看著兩個大汗淋漓的男人互相殘殺沒有意見。但不了。",shape=box,color=blue];
		1343 -> 1346;
	1344 [label="猜得好。你可以得到任何東西，由布絲蓮手袋和手套組合到冰上的人類眼球。但不了。",shape=box,color=blue];
		1344 -> 1346;
	1345 [label="那，你當然不知道。你是一個剛進來的新人。",shape=box,color=blue];
