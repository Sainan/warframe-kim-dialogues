		1340 -> 1341;
	1346 [label="公共澡堂！",shape=box,color=blue];
		1346 -> 1347;
	1341 [label="Chat ends.",color=orange];
	1347 [label="不知道你那裡有沒有類似的東西。有是這些寺廟，我想你會這樣叫它們，通常有一套太陽房間跟一套太陰房間。你可以在公共或私人池中泡澡。所有池水都聞起來有草藥跟熱氣的味道，這對醒腦提神大有幫助。",shape=box,color=blue];
		1347 -> 1348;
	1348 [label="霍爾瓦尼亞一直有這種非常重要的清潔儀式傳統。我想這可以追溯到這座城市賴以建立的溫泉。",shape=box,color=blue];
		1348 -> 1349;
	1349 [label="維克多說的那些「純潔」廢話？他在唱一首古老的曲調。所有的公民都知道他的意思。",shape=box,color=blue];
		1349 -> 1350;
	1350 [label="我以前喜歡花費額外的霍爾瓦尼亞幣，請一位肌肉發達的專業人士來緩解我的肌肉緊張。你一定會喜歡的。我肯定你會。",shape=box,color=blue];
		1350 -> 1351;
		1350 -> 1352;
		1350 -> 1353;
	1351 [label="我不太肯定。",shape=box,color=red];
		1351 -> 1354;
	1352 [label="聽起來我會很喜歡。",shape=box,color=red];
		1352 -> 1357;
	1353 [label="他們接下來發生了什麼事？",shape=box,color=red];
		1353 -> 1359;
	1354 [label="你會穿著由 Infested 人體製成的套裝走來走去，但不想被按摩？",shape=box,color=blue];
		1354 -> 1355;
	1357 [label="我就知道你是我的同類。",shape=box,color=blue];
		1357 -> 1358;
	1359 [label="我相信你也猜到。 科腐者摧毀得太多東西了。疫情爆發後，澡堂不可能繼續營業。",shape=box,color=blue];
		1359 -> 1360;
	1355 [label="奇怪。",shape=box,color=blue];
		1355 -> 1356;
	1358 [label="我希望其他人不要那麼緊張。遺憾的是，疫情爆發後，澡堂無法繼續營業。",shape=box,color=blue];
		1358 -> 1360;
	1360 [label="據我觀察，現在有些基本上都已經是產卵池了。老實說這讓我很傷心。我記得在蠕動的血肉下發現有千年歷史的大理石和馬賽克地板。",shape=box,color=blue];
		1360 -> 1361;
