		1369 -> 1372;
	1370 [label="這是 Grineer 的傳統。這是向整個星系廣播的競技場格鬥儀式。",shape=box,color=red];
		1370 -> 1373;
	1371 [label="……算是吧？這就像是股票交易跟四人暴力的結合。我知道這聽起來很奇怪。",shape=box,color=red];
