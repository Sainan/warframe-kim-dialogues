digraph {
	"EleanorRank6Convo10 begins." [color=orange];
		"EleanorRank6Convo10 begins." -> j2799464830;
	j2799464830 [label="所以我在想，十二月底的時候年份又會一如往常地循環，雖然會感覺像是全新的一年，但實際上並不是真的",shape=box,color=blue];
		j2799464830 -> j1442263159;
	j1442263159 [label="雖然我以為自己知道這種情況之前發生過多少次，但其實我並不知道，因為我可能根本不記得了",shape=box,color=blue];
		j1442263159 -> j2453876919;
	j2453876919 [label="要是我記憶中的第一次循環實際上是第一萬五千零四十二次呢？",shape=box,color=blue];
		j2453876919 -> j2450806380;
	j2450806380 [label="然後我想，好吧，管它的，不如徹底放飛自我，愛做什麼就做什麼，因為反正你總是可以再次敲打地板來重置一切",shape=box,color=blue];
		j2450806380 -> j2635866856;
	j2635866856 [label="但我又接著想，不對，等等，萬一這一次是真的會持續下去的那一次呢？要是我們終於能從 1999 年跨到 2000 年了呢？",shape=box,color=blue];
		j2635866856 -> j4168395852;
	j4168395852 [label="我可不想在這個可能是最後決定性的 1999 年的循環中把自己整成傻子。結果到時候我就永遠無法翻身了。",shape=box,color=blue];
		j4168395852 -> j3656115072;
	j3656115072 [label="用那個老掉牙的比喻來說，總有一天迎來春日而不是無盡冬日",shape=box,color=blue];
		j3656115072 -> j420725480;
	j420725480 [label="Check boolean EleanorDating",color=orange];
		j420725480 -> j3594260764 [label=true,color=green];
		j420725480 -> j1724970071 [label=false,color=brown];
	j3594260764 [label="在那之前，你和我必須溫暖彼此。x",shape=box,color=blue];
		j3594260764 -> "Chat ends.";
	j1724970071 [label="在那之前，我們都必須溫暖彼此。",shape=box,color=blue];
		j1724970071 -> "Chat ends.";
	"Chat ends." [color=orange];
}