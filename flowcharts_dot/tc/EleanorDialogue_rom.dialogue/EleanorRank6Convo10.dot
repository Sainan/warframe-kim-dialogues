digraph {
	3285 [label="EleanorRank6Convo10 begins.",color=orange];
		3285 -> 3286;
	3286 [label="所以我在想，十二月底的時候年份又會一如往常地循環，雖然會感覺像是全新的一年，但實際上並不是真的",shape=box,color=blue];
		3286 -> 3287;
	3287 [label="雖然我以為自己知道這種情況之前發生過多少次，但其實我並不知道，因為我可能根本不記得了",shape=box,color=blue];
		3287 -> 3288;
	3288 [label="要是我記憶中的第一次循環實際上是第一萬五千零四十二次呢？",shape=box,color=blue];
		3288 -> 3289;
	3289 [label="然後我想，好吧，管它的，不如徹底放飛自我，愛做什麼就做什麼，因為反正你總是可以再次敲打地板來重置一切",shape=box,color=blue];
		3289 -> 3290;
	3290 [label="但我又接著想，不對，等等，萬一這一次是真的會持續下去的那一次呢？要是我們終於能從 1999 年跨到 2000 年了呢？",shape=box,color=blue];
		3290 -> 3291;
	3291 [label="我可不想在這個可能是最後決定性的 1999 年的循環中把自己整成傻子。結果到時候我就永遠無法翻身了。",shape=box,color=blue];
		3291 -> 3292;
	3292 [label="用那個老掉牙的比喻來說，總有一天迎來春日而不是無盡冬日",shape=box,color=blue];
		3292 -> 3293;
