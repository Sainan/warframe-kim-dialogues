	3195 [label="這就好比在聽某人為你調製一杯在水泥攪拌機裡攪拌的睪酮奶昔。",shape=box,color=blue];
		3195 -> 3198;
	3196 [label="Chat ends.",color=orange];
	3197 [label="『保持冷靜，讓專業人士處理這件事』，八歲的亞瑟幫著動作安格斯配音咆哮道，同時塑膠的空降特勤團從恐龍軍團手中拯救出我的一個珊迪娃娃",shape=box,color=blue];
		3197 -> 3199;
