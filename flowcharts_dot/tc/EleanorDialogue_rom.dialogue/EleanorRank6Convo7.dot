	j914780286 [label="+5 Chemistry",color=orange];
		j914780286 -> j4061754969;
	j1912042748 [label="嗯，好吧",shape=box,color=blue];
		j1912042748 -> j3636253034;
	j624254905 [label="我的意思是，它也沒有不好",shape=box,color=blue];
		j624254905 -> j1535376176;
	j3876361716 [label="我覺得你肯定知道我的意思，但我會友善地接受你的回答。",shape=box,color=blue];
		j3876361716 -> j2003822848;
	j4061754969 [label="太好了。這顯然是天然免疫力的案例！",shape=box,color=blue];
		j4061754969 -> j1796926679;
	j3636253034 [label="據我所知，在這件事上你肯定不是唯一一人",shape=box,color=blue];
		j3636253034 -> j1870828712;
	j1535376176 [label="但我實在是無法認真看待。我有我的原因。",shape=box,color=blue];
		j1535376176 -> j1870828712;
	j2003822848 [label="大部分時間亞瑟的嗓音就像個普通不過的正常人，但有些時候他會用那種嗓音說話。",shape=box,color=blue];
		j2003822848 -> j962508884;
	j1796926679 [label="我們必須確保你的遺體捐贈給醫學科學。",shape=box,color=blue];
		j1796926679 -> "Chat ends.";
	j1870828712 [label="……我只是想要你知道，對我來說，那永遠會是他的動作安格斯嗓音。",shape=box,color=blue];
		j1870828712 -> j2743724033;
	j962508884 [label="這就好比在聽某人為你調製一杯在水泥攪拌機裡攪拌的睪酮奶昔。",shape=box,color=blue];
		j962508884 -> j3190385776;
	"Chat ends." [color=orange];
	j2743724033 [label="『保持冷靜，讓專業人士處理這件事』，八歲的亞瑟幫著動作安格斯配音咆哮道，同時塑膠的空降特勤團從恐龍軍團手中拯救出我的一個珊迪娃娃",shape=box,color=blue];
		j2743724033 -> j4088111856;
	j3190385776 [label="那聲音粗啞到你甚至可以從中挑出新石器時代的斧頭了。",shape=box,color=blue];
		j3190385776 -> j3530241140;
	j4088111856 [label="+5 Chemistry",color=orange];
		j4088111856 -> j3665838394;
	j3530241140 [label="出於某種原因，它讓原本理智和適應良好的人雙膝發軟。",shape=box,color=blue];
