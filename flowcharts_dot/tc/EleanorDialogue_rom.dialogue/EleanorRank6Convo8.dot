		3222 -> 3225;
		3222 -> 3226;
	3223 [label="是的。她在我們一次聊天聊到一半時突然丟出，「你很酷，但你也很雷。我永遠不知道你對任何事情會有什麼反應。」",shape=box,color=blue];
