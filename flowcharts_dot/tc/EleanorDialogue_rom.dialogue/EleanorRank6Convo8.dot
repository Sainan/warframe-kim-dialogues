	j3987636154 [label="謝謝，夥計。",shape=box,color=blue];
		j3987636154 -> j653201582;
	j2805026518 [label="謝謝，親愛的。",shape=box,color=blue];
		j2805026518 -> j653201582;
	j653201582 [label="我有很雷嗎？",shape=box,color=blue];
		j653201582 -> j1844246120;
	j1844246120 [label="因為卡婭說我是。然後我就有了那種「靠」的頓悟時刻──當你回過頭看與某人的所有對話時，你就以全新角度看待自己了。",shape=box,color=blue];
		j1844246120 -> j703233738;
		j1844246120 -> j1837465236;
		j1844246120 -> j3433963218;
	j703233738 [label="不，你一點都不雷。",shape=box,color=red];
		j703233738 -> j391150246;
	j1837465236 [label="我想我知道她在說什麼了，是的。抱歉，但她說得對。",shape=box,color=red];
		j1837465236 -> j2649918825;
	j3433963218 [label="等一下，卡婭這麼說？",shape=box,color=red];
		j3433963218 -> j4242230301;
	j391150246 [label="+5 Chemistry",color=orange];
		j391150246 -> j1037994718;
	j2649918825 [label="哦。",shape=box,color=blue];
		j2649918825 -> j2225973299;
		j2649918825 -> j2092058186;
	j4242230301 [label="是的。她在我們一次聊天聊到一半時突然丟出，「你很酷，但你也很雷。我永遠不知道你對任何事情會有什麼反應。」",shape=box,color=blue];
		j4242230301 -> j703233738;
		j4242230301 -> j1837465236;
	j1037994718 [label="很高興聽到這個。謝謝你。",shape=box,color=blue];
		j1037994718 -> j126441017;
	j2225973299 [label="我很高興卡婭指出了這點。我在這裡說了一些我認為無傷大雅的話，而你的反應就好像我點燃了你的頭髮似的。",shape=box,color=red];
		j2225973299 -> j1448631758;
		j2225973299 -> j1575574026;
	j2092058186 [label="你有時反應真的很極端。和我對你說的話相比太超過了。",shape=box,color=red];
		j2092058186 -> j1575574026;
		j2092058186 -> j1448631758;
	j126441017 [label="青少年嘛，是吧？",shape=box,color=blue];
		j126441017 -> "Chat ends.";
	j1448631758 [label="這就像你一下子就用最負面的意思解讀我說的話。",shape=box,color=red];
		j1448631758 -> j1712271788;
	j1575574026 [label="有時你就完全退出對話，而我甚至都沒有機會解釋自己。",shape=box,color=red];
		j1575574026 -> j1712271788;
	j1712271788 [label="好吧。",shape=box,color=blue];
		j1712271788 -> j3650316707;
	j3650316707 [label="現在我超想立刻登出，再也不開密了。",shape=box,color=blue];
		j3650316707 -> j3513921567;
		j3650316707 -> j4038550043;
	j3513921567 [label="也許回想一下你剛才說的話？",shape=box,color=red];
		j3513921567 -> j2525507668;
	j4038550043 [label="你就這樣。雷爆了。轟。",shape=box,color=red];
		j4038550043 -> j2881780336;
		j4038550043 -> j2525507668;
	j2525507668 [label="你難道沒看到嗎？",shape=box,color=red];
		j2525507668 -> j2879549052;
	j2881780336 [label="我覺得你需要花點時間來反思這件事。[結束]",shape=box,color=red];
		j2881780336 -> "Chat ends.";
	j2879549052 [label="好的。好的。聽我說。",shape=box,color=blue];
		j2879549052 -> j2775220737;
	j2775220737 [label="拜託。",shape=box,color=blue];
		j2775220737 -> j3092645885;
	j3092645885 [label="所以記得這點",shape=box,color=blue];
		j3092645885 -> j2124468396;
	j2124468396 [label="我有心靈感應能力。我沒想要有這種能力。但我就是有。我能感知到別人心裡在想什麼。",shape=box,color=blue];
		j2124468396 -> j3618523206;
	j3618523206 [label="如果我們面對面交談，那我就有各種線索可以感知你的感受",shape=box,color=blue];
		j3618523206 -> j1017716157;
	j1017716157 [label="臉部表情、肢體語言，還有呢，有時甚至是實際的想法，因為就像我說的，我能夠心靈感應",shape=box,color=blue];
		j1017716157 -> j888341465;
	j888341465 [label="但在開密上，我只能靠猜的，也沒有什麼線索",shape=box,color=blue];
		j888341465 -> j1152307052;
	j1152307052 [label="所以沒錯，我有時候就是會反應過激。",shape=box,color=blue];
		j1152307052 -> j2165508059;
		j1152307052 -> j580574856;
	j2165508059 [label="廢話。",shape=box,color=red];
		j2165508059 -> j3302152209;
	j580574856 [label="是的。你確實會。",shape=box,color=red];
		j580574856 -> j3302152209;
	j3302152209 [label="是的。所以。",shape=box,color=blue];
		j3302152209 -> j1102637714;
	j1102637714 [label="愛琳娜，呼吸，坐直，振作",shape=box,color=blue];
		j1102637714 -> j1247618423;
	j1247618423 [label="我會盡我最大的努力以後不再那麼雷了。",shape=box,color=blue];
		j1247618423 -> j1153732982;
	j1153732982 [label="還有我會再回過頭看我們以前的聊天記錄，好好反省。",shape=box,color=blue];
		j1153732982 -> j1646959763;
	j1646959763 [label="我欠你這個。因為無論我雷不雷，你依然在這裡。你都繼續前行。x",shape=box,color=blue];
