	"EleanorRank6Convo9 begins." [color=orange];
		"EleanorRank6Convo9 begins." -> j328869;
	j328869 [label="所以，像我媽會問的那樣，用大白話告訴我「Mara Lohk」到底是什麼東西？",shape=box,color=blue];
		j328869 -> j3396216420;
		j328869 -> j2321436781;
	j3396216420 [label="漠然是這樣叫我的。",shape=box,color=red];
		j3396216420 -> j3540904928;
	j2321436781 [label="我不知道。這是虛空語。",shape=box,color=red];
		j2321436781 -> j3540904928;
	j3540904928 [label="啊。因為我有時在看著你的時候，會在腦海裡隱約聽到它。",shape=box,color=blue];
		j3540904928 -> j1403727449;
	j1403727449 [label="Check boolean EleanorDating",color=orange];
		j1403727449 -> j840472251 [label=true,color=green];
		j1403727449 -> j3662770465 [label=false,color=brown];
	j840472251 [label="還有其它像是，「噗哇」、「該死」還有「是的，那是我的漂泊者」之類的話。",shape=box,color=blue];
		j840472251 -> j3404858574;
	j3662770465 [label="還有其它像是，「該死，他們真酷」和「是的，那是我的夥計」之類的話。",shape=box,color=blue];
		j3662770465 -> j3404858574;
	j3404858574 [label="這個語言裡有什麼詞是你確實知道的嗎？",shape=box,color=blue];
		j3404858574 -> j44409081;
	j44409081 [label="有幾個。",shape=box,color=red];
		j44409081 -> j3418772485;
	j3418772485 [label="Netra 代表「衰變」、Xata 代表「真理」、Ris 代表「光明」……",shape=box,color=red];
		j3418772485 -> j4104604935;
	j4104604935 [label="Lohk 代表「虛空」、Oull 代表「機遇」、Khra 代表「時間」……",shape=box,color=red];
		j4104604935 -> j294130060;
	j294130060 [label="用這些詞來做成冰箱磁鐵的詩，祝你好運了",shape=box,color=blue];
		j294130060 -> j2383857937;
	j2383857937 [label="等一下。如果「Lohk」是虛空，那麼 Mara Lohk 就是什麼虛空。或是虛空什麼。",shape=box,color=blue];
		j2383857937 -> j1128255648;
	j1128255648 [label="虛空夢魘？噩夢？虛空惡魔？",shape=box,color=blue];
		j1128255648 -> j3901261520;
		j1128255648 -> j2543997420;
	j3901261520 [label="小心。這不只是一種語言。",shape=box,color=red];
		j3901261520 -> j4026304387;
	j2543997420 [label="我被人叫過更難聽的。",shape=box,color=red];
		j2543997420 -> j1132239928;
	j4026304387 [label="這是不是我回頭一看就會看到黑眼睛的愛琳娜在對我詭笑的時刻？",shape=box,color=blue];
		j4026304387 -> j742385181;
	j1132239928 [label="如果我回來再為這件事煩你，別太驚訝。",shape=box,color=blue];
		j1132239928 -> j223283756;
	j742385181 [label="我想我還是稍微看一下，確認一下……",shape=box,color=blue];
		j742385181 -> j1773309750;
	j223283756 [label="+5 Chemistry",color=orange];
		j223283756 -> j4078396412;
	j1773309750 [label="我的老月",shape=box,color=blue];
		j1773309750 -> j3974967616;
	j4078396412 [label="就是忍不住要打探。這是我記者的天性。",shape=box,color=blue];
		j4078396412 -> "Chat ends.";
	j3974967616 [label="怎麼了？",shape=box,color=red];
		j3974967616 -> j4054659634;
	"Chat ends." [color=orange];
	j4054659634 [label="蜘蛛",shape=box,color=blue];
		j4054659634 -> j1249126370;
	j1249126370 [label="真的嗎？",shape=box,color=red];
		j1249126370 -> j1682134335;
	j1682134335 [label="我本來還準備要跟你開玩笑說那裡什麼鬼都沒有，但是有隻該死的大蜘蛛從天花板上垂下來",shape=box,color=blue];
		j1682134335 -> j836521365;
	j836521365 [label="晚點再聊，要去拿個杯子和紙板",shape=box,color=blue];
		j836521365 -> "Chat ends.";
}