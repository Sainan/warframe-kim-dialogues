digraph {
	3255 [label="EleanorRank6Convo9 begins.",color=orange];
		3255 -> 3256;
	3256 [label="所以，像我媽會問的那樣，用大白話告訴我「Mara Lohk」到底是什麼東西？",shape=box,color=blue];
		3256 -> 3257;
		3256 -> 3258;
	3257 [label="漠然是這樣叫我的。",shape=box,color=red];
		3257 -> 3259;
	3258 [label="我不知道。這是虛空語。",shape=box,color=red];
		3258 -> 3259;
	3259 [label="啊。因為我有時在看著你的時候，會在腦海裡隱約聽到它。",shape=box,color=blue];
		3259 -> 3260;
	3260 [label="Check boolean EleanorDating",color=orange];
		3260 -> 3262 [label=true,color=green];
		3260 -> 3261 [label=false,color=brown];
	3262 [label="還有其它像是，「噗哇」、「該死」還有「是的，那是我的漂泊者」之類的話。",shape=box,color=blue];
		3262 -> 3263;
	3261 [label="還有其它像是，「該死，他們真酷」和「是的，那是我的夥計」之類的話。",shape=box,color=blue];
		3261 -> 3263;
	3263 [label="這個語言裡有什麼詞是你確實知道的嗎？",shape=box,color=blue];
		3263 -> 3264;
	3264 [label="有幾個。",shape=box,color=red];
		3264 -> 3265;
	3265 [label="Netra 代表「衰變」、Xata 代表「真理」、Ris 代表「光明」……",shape=box,color=red];
		3265 -> 3266;
	3266 [label="Lohk 代表「虛空」、Oull 代表「機遇」、Khra 代表「時間」……",shape=box,color=red];
		3266 -> 3267;
	3267 [label="用這些詞來做成冰箱磁鐵的詩，祝你好運了",shape=box,color=blue];
		3267 -> 3268;
	3268 [label="等一下。如果「Lohk」是虛空，那麼 Mara Lohk 就是什麼虛空。或是虛空什麼。",shape=box,color=blue];
		3268 -> 3269;
	3269 [label="虛空夢魘？噩夢？虛空惡魔？",shape=box,color=blue];
		3269 -> 3270;
		3269 -> 3271;
	3270 [label="小心。這不只是一種語言。",shape=box,color=red];
		3270 -> 3272;
	3271 [label="我被人叫過更難聽的。",shape=box,color=red];
		3271 -> 3273;
	3272 [label="這是不是我回頭一看就會看到黑眼睛的愛琳娜在對我詭笑的時刻？",shape=box,color=blue];
		3272 -> 3274;
	3273 [label="如果我回來再為這件事煩你，別太驚訝。",shape=box,color=blue];
		3273 -> 3275;
	3274 [label="我想我還是稍微看一下，確認一下……",shape=box,color=blue];
		3274 -> 3276;
	3275 [label="+5 Chemistry",color=orange];
		3275 -> 3277;
	3276 [label="我的老月",shape=box,color=blue];
		3276 -> 3278;
	3277 [label="就是忍不住要打探。這是我記者的天性。",shape=box,color=blue];
		3277 -> 3279;
	3278 [label="怎麼了？",shape=box,color=red];
		3278 -> 3280;
	3279 [label="Chat ends.",color=orange];
	3280 [label="蜘蛛",shape=box,color=blue];
		3280 -> 3281;
	3281 [label="真的嗎？",shape=box,color=red];
		3281 -> 3282;
	3282 [label="我本來還準備要跟你開玩笑說那裡什麼鬼都沒有，但是有隻該死的大蜘蛛從天花板上垂下來",shape=box,color=blue];
		3282 -> 3283;
	3283 [label="晚點再聊，要去拿個杯子和紙板",shape=box,color=blue];
		3283 -> 3284;
	3284 [label="Chat ends.",color=orange];
