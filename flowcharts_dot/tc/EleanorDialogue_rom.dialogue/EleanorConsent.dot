	3318 [label="Chat ends.",color=orange];
	3319 [label="我想這件事讓我有點不爽的唯一點在於，是我先在你腦海裡發現了他們的存在。",shape=box,color=blue];
		3319 -> 3320;
	3317 [label="Chat ends.",color=orange];
	3320 [label="哦，拜託。又不是說我不知道你正打算前來禮貌地徵求同意。",shape=box,color=blue];
		3320 -> 3321;
	3321 [label="答案無非是雙臂交叉且非常賭氣地回答「好的，當然可以」，而我卻只能坐在這裡拼命不去想你跑去和我在你幻想裡瞥見的那個非常美麗的存在廝混。",shape=box,color=blue];
		3321 -> 3322;
	3322 [label="而那些現在都在我的幻想裡了，因為我被困在這個時空，還真是多謝你啊！",shape=box,color=blue];
		3322 -> 3323;
	3323 [label="對不起。我真的打算來徵求你同意。我知道這不是我們之前討論過的事。我想確認你的想法。",shape=box,color=red];
		3323 -> 3324;
	3324 [label="當然沒問題！我能在你的心眼裡看到他們。而如果你信任他們，那我就信任他們。",shape=box,color=blue];
		3324 -> 3325;
	3325 [label="我只是難過我沒辦法自己親身去爽個幾回。",shape=box,color=blue];
		3325 -> 3326;
	3326 [label="+20 Chemistry",color=orange];
		3326 -> 3327;
	3327 [label="但也許我可以透過你來間接體驗，現在想想還真是個好主意。",shape=box,color=blue];
		3327 -> 3328;
	3328 [label="Update boolean EleanorConsentComplete",color=orange];
		3328 -> 3329;
