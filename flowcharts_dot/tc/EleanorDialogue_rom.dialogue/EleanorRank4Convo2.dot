digraph {
	1521 [label="EleanorRank4Convo2 begins.",color=orange];
		1521 -> 1522;
	1522 [label="噢漂泊者！噢時間和空間的流浪者啊！看到你出現在我的這個小螢幕我是多麼的高興啊！",shape=box,color=blue];
		1522 -> 1523;
		1522 -> 1524;
	1523 [label="嘿，愛琳娜。",shape=box,color=red];
		1523 -> 1526;
	1524 [label="很快回來，卡利莫斯又在玩繩子了，她可能會斷線[結束]。",shape=box,color=red];
		1524 -> 1525;
	1526 [label="嘿老友。",shape=box,color=blue];
		1526 -> 1527;
	1525 [label="Chat ends.",color=orange];
	1527 [label="你猜我們要聊什麼。",shape=box,color=blue];
		1527 -> 1528;
		1527 -> 1529;
	1528 [label="你是不是對未來的生活有疑惑？",shape=box,color=red];
		1528 -> 1530;
	1529 [label="你長出了一條尾巴。",shape=box,color=red];
		1529 -> 1531;
	1530 [label="呃。我真的是太好預料了。",shape=box,color=blue];
		1530 -> 1533;
	1531 [label="……但你喜歡這樣子，不是嗎？",shape=box,color=blue];
		1531 -> 1532;
	1533 [label="是的，我我。還有一個。但這確實是一個大問題，所以耐心點，好嗎？",shape=box,color=blue];
		1533 -> 1534;
	1532 [label="唉，不。我的臀部並沒有因為多了一條尾巴而變得更好。它不會變得更好，因為它已經是完美的了。",shape=box,color=blue];
		1532 -> 1535;
	1534 [label="我盡量吧。",shape=box,color=red];
		1534 -> 1536;
	1535 [label="不過，我的確有個問題想問你。",shape=box,color=blue];
		1535 -> 1537;
	1536 [label="好。很好。所以。",shape=box,color=blue];
		1536 -> 1537;
	1537 [label="在你的時代，那些人是如何交往的？我的意思是，是那些一般的「兩個或以上的成年人以不同程度的正式方式聚在一起」嗎？或者有各種規則說誰跟誰才可以在一起嗎？",shape=box,color=blue];
		1537 -> 1538;
		1537 -> 1539;
		1537 -> 1540;
	1538 [label="這不是我很瞭解的事。",shape=box,color=red];
		1538 -> 1541;
	1539 [label="這要看那個文化。",shape=box,color=red];
		1539 -> 1542;
	1540 [label="……你為什麼會問這個問題？",shape=box,color=red];
		1540 -> 1543;
	1541 [label="天哪。",shape=box,color=blue];
		1541 -> 1547;
	1542 [label="對。當然。",shape=box,color=blue];
		1542 -> 1548;
	1543 [label="Check boolean EleanorEntrati",color=orange];
		1543 -> 1544 [label=true,color=green];
		1543 -> 1545 [label=false,color=brown];
	1547 [label="我知道你在渡域裡很孤單，但我不知道你孤單得到這個程度。",shape=box,color=blue];
		1547 -> 1552;
	1548 [label="讓我試試另一種問法。",shape=box,color=blue];
		1548 -> 1550;
	1544 [label="火衛二上的那兩個人，父親和母親。他們是一對已婚夫婦。他們可能是巨大的 Infested 前 Orokin 生物之類的東西，但他們的婚姻關係顯然很痛苦，就像我媽媽和爸爸一樣。",shape=box,color=blue];
		1544 -> 1546;
	1545 [label="從我從你腦海中收集到的絲絲點點中，我仍然看到了人跟人之間的標準配對。他們的婚姻關係顯然很痛苦，就像我媽媽和爸爸一樣。",shape=box,color=blue];
		1545 -> 1546;
	1552 [label="+15 Chemistry",color=orange];
		1552 -> 1549;
	1550 [label="來看看……",shape=box,color=blue];
		1550 -> 1554;
	1546 [label="那麼這是 Orokin 當時的標準嗎？",shape=box,color=blue];
		1546 -> 1551;
	1549 [label="如果我這樣問會令你感到不安，我衷心抱歉。",shape=box,color=blue];
		1549 -> 1553;
	1554 [label="好。那麼你來自的地方，比如說一個人跟中樞在一起又正常嗎？",shape=box,color=blue];
		1554 -> 1555;
		1554 -> 1556;
	1551 [label="Orokin 很看重規則和禁忌。他們喜歡階級制度。人際關係不能跨越社會界線。比如說，禁衛不能跟 Orokin 貴族在一起。",shape=box,color=red];
		1551 -> 1554;
	1553 [label="Chat ends.",color=orange];
	1555 [label="如果你想知道的話我可以試試把  Ordis 拉回這個時代……",shape=box,color=red];
		1555 -> 1557;
	1556 [label="……我從來沒聽過，也不知道是如何運作的。",shape=box,color=red];
		1556 -> 1560;
	1557 [label="我在想問一個理論上的問題！",shape=box,color=blue];
		1557 -> 1558;
	1560 [label="該死。讓我再試多一次。",shape=box,color=blue];
		1560 -> 1561;
	1558 [label="我不想跟你那玻璃朋友耳鬢廝磨，無論他多麼迷人都好",shape=box,color=blue];
		1558 -> 1559;
	1561 [label="想像一個屬於你時代既是女性又危險的人物。也很強。就像沒有惡魔附身的露莎卡少校。",shape=box,color=blue];
		1561 -> 1562;
		1561 -> 1563;
	1559 [label="我在試著詢問你有關權力不平衡的問題但不得要領",shape=box,color=blue];
		1559 -> 1561;
	1562 [label="一個 Grineer 狙擊手？",shape=box,color=red];
		1562 -> 1564;
	1563 [label="一個禁衛？",shape=box,color=red];
		1563 -> 1565;
	1564 [label="那好。假設有一位 Grineer 狙擊手女士而她愛上了一個人類。兩情相悅。苦命鴛鴦。悲情至極。他們可以在一起嗎？",shape=box,color=blue];
		1564 -> 1566;
		1564 -> 1567;
		1564 -> 1568;
		1564 -> 1569;
	1565 [label="那好。假設有一位禁衛戰士女士而她愛上了一個低等人類。兩情相悅。苦命鴛鴦。悲情至極。他們可以在一起嗎？",shape=box,color=blue];
		1565 -> 1566;
		1565 -> 1567;
		1565 -> 1568;
		1565 -> 1569;
	1566 [label="如果是他們兩個想要的結果，當然可以。",shape=box,color=red];
		1566 -> 1570;
	1567 [label="有何不可？",shape=box,color=red];
		1567 -> 1570;
	1568 [label="我會想看看有什麼人試著阻撓他們。",shape=box,color=red];
		1568 -> 1570;
	1569 [label="對，但會很難。",shape=box,color=red];
		1569 -> 1576;
	1570 [label="我說得越來越亂了。",shape=box,color=blue];
		1570 -> 1572;
	1576 [label="+5 Chemistry",color=orange];
		1576 -> 1571;
	1572 [label="在你來自的地方，人跟比自己強大得多危險得多的伴侶在一起是正常的嗎？就像《甘比利與龍的襪子》中精靈王子最後嫁給了巨人一樣？",shape=box,color=blue];
		1572 -> 1574;
	1571 [label="謝謝。",shape=box,color=blue];
		1571 -> 1573;
	1574 [label="……你根本不知道我在說什麼，對嗎。",shape=box,color=blue];
		1574 -> 1578;
		1574 -> 1579;
	1573 [label="問：兩個體型跟殺傷力程度差距很大的人可以談戀愛嗎？答：可以。",shape=box,color=blue];
		1573 -> 1575;
	1578 [label="事實上，我蠻肯定我知道。",shape=box,color=red];
		1578 -> 1582;
	1579 [label="不太知道。",shape=box,color=red];
		1579 -> 1580;
	1575 [label="這就是我要想知道的答案。",shape=box,color=blue];
		1575 -> 1577;
	1582 [label="我並不想毀了你的一天。對不起。",shape=box,color=blue];
		1582 -> 1583;
	1580 [label="我最好不要再說下去。不然我可會出醜。",shape=box,color=blue];
		1580 -> 1581;
	1577 [label="Chat ends.",color=orange];
	1583 [label="允許我自怨自艾地抱怨一番嗎？",shape=box,color=blue];
		1583 -> 1584;
		1583 -> 1585;
	1581 [label="Chat ends.",color=orange];
	1584 [label="隨便抱怨吧。",shape=box,color=red];
		1584 -> 1587;
	1585 [label="我沒空聊這個，抱歉。[結束]",shape=box,color=red];
		1585 -> 1586;
	1587 [label="我並不是說如果沒有人跟我分享我的生活就沒有意義",shape=box,color=blue];
		1587 -> 1588;
	1586 [label="Chat ends.",color=orange];
	1588 [label="我並不是由我選擇愛的人來定義的",shape=box,color=blue];
		1588 -> 1589;
	1589 [label="我一個人自給自足",shape=box,color=blue];
		1589 -> 1590;
	1590 [label="但是如果在我激動時我可能會意外殺死某個人的話，我又怎樣建立一段關係",shape=box,color=blue];
		1590 -> 1591;
	1591 [label="歡迎來到愛琳娜以及她的角質螳螂問題",shape=box,color=blue];
		1591 -> 1592;
	1592 [label="如果我找到那個源拓氏王八蛋，我會把他的睪丸做成耳環。如果他還有的話。",shape=box,color=blue];
		1592 -> 1593;
		1592 -> 1594;
	1593 [label="你可以跟六煞幫的其他人約會。",shape=box,color=red];
		1593 -> 1595;
	1594 [label="等等。你單身是因為怕傷害到別人嗎？",shape=box,color=red];
		1594 -> 1596;
	1595 [label="噢我的老天啊",shape=box,color=blue];
		1595 -> 1597;
	1596 [label="對。",shape=box,color=blue];
		1596 -> 1601;
	1597 [label="我正在咬住舌頭才能忍住不笑",shape=box,color=blue];
		1597 -> 1598;
	1601 [label="你比我更了解我是什麼人。我是個原型 Warframe。我是一部部分變形的戰爭機器，而且我感覺那個部份一天比一天更少了。",shape=box,color=blue];
		1601 -> 1602;
	1598 [label="這四個人之中我唯一會考慮約會的是葵，這很複雜，因為亞瑟的關係",shape=box,color=blue];
		1598 -> 1599;
	1602 [label="無論是誰設計可憐的「Nyx」，都不過在製造一個殺手。現在就是我。高效率。致命。危險又可愛。",shape=box,color=blue];
		1602 -> 1603;
	1599 [label="謝謝你提出這個建議，但不了，一百萬年都後不會",shape=box,color=blue];
		1599 -> 1600;
	1603 [label="日常工作一切都沒有問題，但是在辦公室派對誰又會去親吻槲寄生下的活生生的死亡陷阱呢？",shape=box,color=blue];
		1603 -> 1604;
		1603 -> 1606;
	1600 [label="Chat ends.",color=orange];
	1604 [label="你擔心會造成的這種無心傷害。有發生過嗎？你曾經傷害過跟你在一起的人嗎？",shape=box,color=red];
		1604 -> 1605;
	1606 [label="我意思是，至少好消息是如果真的發生意外，重置後霍爾瓦尼亞沒有人會死……",shape=box,color=red];
		1606 -> 1607;
	1605 [label="沒有，它沒有發生過，因為我一直都沒有讓它發生。好嗎？",shape=box,color=blue];
		1605 -> 1608;
	1607 [label="……",shape=box,color=blue];
		1607 -> 1609;
	1608 [label="沒有伴侶，就不會有傷亡。不值得冒這個風險。",shape=box,color=blue];
		1608 -> 1610;
	1609 [label="我從來沒有考慮到這一點。",shape=box,color=blue];
		1609 -> 1611;
	1610 [label="我寧願孤單一人也不願意沉浸在愧疚之中，謝謝。",shape=box,color=blue];
		1610 -> 1612;
	1611 [label="但我們的記憶猶在。",shape=box,color=blue];
		1611 -> 1613;
	1612 [label="那麼自從源拓氏的血清之後你就一直都是單身了？",shape=box,color=red];
		1612 -> 1618;
	1613 [label="我認為沒有人願意跟一個曾經咬斷自己頭的人交往，就算情況有好轉也好。",shape=box,color=blue];
		1613 -> 1614;
	1618 [label="+20 Chemistry",color=orange];
		1618 -> 1615;
	1614 [label="太陰哭了。我現在需要喝一杯。",shape=box,color=blue];
		1614 -> 1620;
	1615 [label="對。一個我非常願意做的犧牲。",shape=box,color=blue];
		1615 -> 1616;
	1620 [label="Chat ends.",color=orange];
	1616 [label="對不起。我不肯定談論這個話題是不是個好主意。",shape=box,color=blue];
		1616 -> 1617;
	1617 [label="我想我需要自己一個人一陣子。",shape=box,color=blue];
		1617 -> 1619;
	1619 [label="Chat ends.",color=orange];
}