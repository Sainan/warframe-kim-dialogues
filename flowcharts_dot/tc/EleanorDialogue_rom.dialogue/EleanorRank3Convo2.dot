digraph {
	924 [label="EleanorRank3Convo2 begins.",color=orange];
		924 -> 926;
	926 [label="Check boolean EleanorIndifference",color=orange];
		926 -> 925 [label=true,color=green];
		926 -> 927 [label=false,color=brown];
	925 [label="你在嗎？我需要談談。",shape=box,color=blue];
		925 -> 928;
		925 -> 929;
	927 [label="你在嗎？我需要跟你說說一些事情。很嚴重。",shape=box,color=blue];
		927 -> 931;
		927 -> 929;
	928 [label="我在這。",shape=box,color=red];
		928 -> 932;
	929 [label="非常抱歉。現在不行。[結束]",shape=box,color=red];
		929 -> 930;
	931 [label="我在這。請說。",shape=box,color=red];
		931 -> 933;
	932 [label="記得我告訴你我是怎樣嘗試用自己的心靈接觸露莎卡的心靈，而我卻跟漠然接通了嗎？",shape=box,color=blue];
		932 -> 935;
	930 [label="Chat ends.",color=orange];
	933 [label="謝謝。",shape=box,color=blue];
		933 -> 934;
	935 [label="我當然記得。",shape=box,color=red];
		935 -> 938;
	934 [label="你知道露莎卡少校發生了什麼事嗎？",shape=box,color=blue];
		934 -> 936;
		934 -> 937;
	938 [label="好的。當時我還沒準備好討論這件事。如果你想的話，我現在已經準備好了。",shape=box,color=blue];
		938 -> 945;
	936 [label="她被利用了。漠然正在操縱她。",shape=box,color=red];
		936 -> 939;
	937 [label="很確定她被掏空了，像個……呃……Warframe 一樣被奴役著…？",shape=box,color=red];
		937 -> 940;
	945 [label="如果你確定的話。",shape=box,color=red];
		945 -> 946;
	939 [label="「漠然」。你就是這樣叫它的？",shape=box,color=blue];
		939 -> 941;
	940 [label="被掏空了，是的。",shape=box,color=blue];
		940 -> 942;
	946 [label="我確定。",shape=box,color=blue];
		946 -> 947;
	941 [label="謝謝你。",shape=box,color=blue];
		941 -> 943;
	942 [label="但無論是何人何物在操縱她，都不是你。",shape=box,color=blue];
		942 -> 944;
	947 [label="這種生物，這種存在，就是我們最終要面對的。我現在就知道這麼多了。",shape=box,color=blue];
		947 -> 951;
	943 [label="給它取一個名字感覺就像我重新獲得了一點點的控制權。",shape=box,color=blue];
		943 -> 948;
	944 [label="它當中任何具有人性的特質都像是一種嘲弄。",shape=box,color=blue];
		944 -> 949;
	951 [label="請告訴我實話。你覺得還有希望嗎？",shape=box,color=blue];
		951 -> 956;
		951 -> 957;
		951 -> 958;
	948 [label="我透過我的心靈觸碰到那個東西。我以為我在探究露莎卡的思想，但是……外層就像潮濕的海綿石膏板般下陷，然後我就沉進去。掙扎著。",shape=box,color=blue];
		948 -> 950;
	949 [label="它就像商店的人體模型那樣人性化。分成碎塊。",shape=box,color=blue];
		949 -> 952;
	956 [label="現在？……沒有。",shape=box,color=red];
		956 -> 960;
	957 [label="真心話？我……不確定。",shape=box,color=red];
		957 -> 961;
	958 [label="是的，我相信。",shape=box,color=red];
		958 -> 962;
	950 [label="Update boolean EleanorIndifference",color=orange];
		950 -> 951;
	952 [label="我接觸過它，你看。透過我的心靈。我試過探探她的情況，但她不在。",shape=box,color=blue];
		952 -> 953;
	960 [label="至少你誠實。",shape=box,color=blue];
		960 -> 963;
	961 [label="我理解。",shape=box,color=blue];
		961 -> 964;
	962 [label="不要告訴我是什麼原因。",shape=box,color=blue];
		962 -> 965;
	953 [label="我知道你的意思。我們叫它做漠然。",shape=box,color=red];
		953 -> 954;
	963 [label="那好。就讓希望破滅吧。",shape=box,color=blue];
		963 -> 966;
	964 [label="我們不瞭解的事物太多了。",shape=box,color=blue];
		964 -> 967;
	965 [label="堅持這個信念。讓我感受一下。",shape=box,color=blue];
		965 -> 968;
	954 [label="謝謝。",shape=box,color=blue];
		954 -> 955;
	966 [label="我會為了一份純粹的堅持執著而繼續戰鬥下去。",shape=box,color=blue];
		966 -> 969;
	967 [label="在經歷了今年發生的那些事之後，我們又怎能再訂立有用的計劃？",shape=box,color=blue];
		967 -> 970;
	968 [label="拜託了。",shape=box,color=blue];
		968 -> 971;
	955 [label="給它取一個名字感覺就像我重新獲得了一點點的控制權。",shape=box,color=blue];
		955 -> 959;
	969 [label="仇恨。憤怒。任何都可以。",shape=box,color=blue];
		969 -> 973;
	970 [label="也許希望只是一種幻想。我不知道。",shape=box,color=blue];
		970 -> 974;
	971 [label="我當時嘗試接觸露莎卡，彷彿手指碰到了她的臉然後直接穿過。面具直接瓦解了。",shape=box,color=blue];
		971 -> 975;
	959 [label="Update boolean EleanorIndifference",color=orange];
		959 -> 972;
	973 [label="比無聲無息好。比順從屈服要好。",shape=box,color=blue];
		973 -> 978;
	974 [label="我現在真的需要一份希望。",shape=box,color=blue];
		974 -> 977;
	975 [label="下面的東西就像是……",shape=box,color=blue];
		975 -> 976;
	972 [label="我透過我的心靈觸碰到那個東西。我以為我在探究露莎卡的思想，但是……外層就像潮濕的海綿石膏板般下陷，然後我就沉進去。掙扎著。",shape=box,color=blue];
		972 -> 976;
	978 [label="我準備好了。",shape=box,color=blue];
		978 -> 979;
	977 [label="啊，那。也確實是這樣。即使我們在黑暗中跌跌碰碰地前進，至少我們還有彼此的陪伴。",shape=box,color=blue];
		977 -> 980;
	976 [label="有一個詞語。 「熱病。」這是一種曾經影響水手的瘋狂病症。他們開始相信，四周的綠色海洋根本不是水而是綠草。",shape=box,color=blue];
		976 -> 981;
	979 [label="Chat ends.",color=orange];
	980 [label="Chat ends.",color=orange];
	981 [label="他們會渴望從船上跳到美麗的綠色草地上，然後跑過去。如果有船員阻止他們，他們就會反抗。",shape=box,color=blue];
		981 -> 982;
	982 [label="我跳下去，期待會是草。下一秒我就陷入了冰冷的黑暗之中。",shape=box,color=blue];
		982 -> 983;
	983 [label="Update boolean EleanorIndifference2",color=orange];
		983 -> 984;
		983 -> 986;
	984 [label="我覺得你這樣討論這件事不安全。",shape=box,color=red];
		984 -> 985;
	986 [label="我在這。繼續說。",shape=box,color=red];
		986 -> 987;
	985 [label="那，該死。",shape=box,color=blue];
		985 -> 988;
	987 [label="有種形容不出來的感覺。你看看這個世界你就會瞭解到，所有的平凡 — 建築、汽車、人、職銜、工作，例行公事 — 都只是無底深淵上面的一層薄薄外殼，如果他們意識到這一點，他們就一定會開始尖叫直到永遠。",shape=box,color=blue];
		987 -> 989;
	988 [label="我才剛剛替自己鼓足勇氣，那現在，是怎樣？我們不能講到魔鬼就是怕會召喚他出來？",shape=box,color=blue];
		988 -> 990;
	989 [label="我掉穿那層薄薄的外殼了。",shape=box,color=blue];
		989 -> 992;
	990 [label="如果你在半夜聽到尖叫聲，那是我。",shape=box,color=blue];
		990 -> 991;
	992 [label="那不是空虛。我本來可以忍受的。它一直一直地延續下去，但不僅僅是寒冷的空間。裡面還有東西跟我在一起。",shape=box,color=blue];
		992 -> 993;
		992 -> 994;
		992 -> 995;
	991 [label="Chat ends.",color=orange];
	993 [label="一隻眼睛？",shape=box,color=red];
		993 -> 997;
	994 [label="一個被困在牆裡的人？",shape=box,color=red];
		994 -> 997;
	995 [label="那是什麽來的？",shape=box,color=red];
		995 -> 996;
	997 [label="我不知道。但它知道我在那裡。它留意到我。就像大象會知道一隻蒼蠅爬過牠的眼睛一樣。",shape=box,color=blue];
		997 -> 998;
	996 [label="+5 Chemistry",color=orange];
		996 -> 997;
	998 [label="我記得我當時想「這麼龐大的東西應該不會留意到我的存在」。",shape=box,color=blue];
		998 -> 999;
	999 [label="感覺是我如此一文不值，如此不屑一顧得讓我想原地消失。",shape=box,color=blue];
		999 -> 1000;
		999 -> 1001;
	1000 [label="它……是這樣的。",shape=box,color=red];
		1000 -> 1002;
	1001 [label="那你怎麼做？",shape=box,color=red];
		1001 -> 1002;
	1002 [label="我想如果它憎恨我的話我還可以應付。那我就會有一些價值，一點意義。但它認為我毫無意義，而我看到了它所看到的。我只是一點。什麼都不是。",shape=box,color=blue];
		1002 -> 1003;
	1003 [label="我曾經歷的一切，每一個溫柔的時刻，每一個笑聲，愛琳娜・南丁格爾的一絲絲回憶都在這場風暴中被吹走了。",shape=box,color=blue];
		1003 -> 1004;
	1004 [label="它感覺到我的光芒正在消失，我發誓，一陣滿足的微細顫抖傳遍了它全身。好像它很高興打擊到我。一隻在指甲下的跳蚤。",shape=box,color=blue];
		1004 -> 1005;
	1005 [label="但你回來了，不是嗎？你還在這裡。你證明了那個東西是錯的。",shape=box,color=red];
		1005 -> 1006;
	1006 [label="我有嗎？",shape=box,color=blue];
		1006 -> 1007;
	1007 [label="它依然在那裡，不是嗎？",shape=box,color=blue];
		1007 -> 1008;
		1007 -> 1009;
	1008 [label="是，它是的。但你在這裡，也在。",shape=box,color=red];
		1008 -> 1011;
	1009 [label="星星不會因為太空浩瀚，寒冷和黑暗而停止燃燒。",shape=box,color=red];
		1009 -> 1010;
	1011 [label="我的老友，漠然最終都會勝出，不管我們把多少陳腔濫調扔進深淵中。",shape=box,color=blue];
		1011 -> 1012;
	1010 [label="但它們會停止燃燒。始終有一天。宇宙的熱寂。",shape=box,color=blue];
		1010 -> 1011;
	1012 [label="這就是神智清醒的苦惱。你受思維清晰的詛咒。",shape=box,color=blue];
		1012 -> 1013;
	1013 [label="你知道我在說什麼。你原本有可能像麻雀蛋一樣碎掉，或被藥物摧毀你的大腦直到你不再有任何感覺。都比現在……清楚知道的痛苦少很多。",shape=box,color=blue];
		1013 -> 1014;
	1014 [label="我不明白你為什麼還沒有離開這個對話。",shape=box,color=blue];
		1014 -> 1015;
		1014 -> 1016;
	1015 [label="我知道熵是什麼。也許無比漠然也是同個東西。也許它最後會贏。我不知道。但我知道的是，這次我不會讓它得逞。",shape=box,color=red];
		1015 -> 1017;
	1016 [label="我在等你做決定。你是想逃避這一切並瘋掉呢？還是你想站穩戰鬥？",shape=box,color=red];
		1016 -> 1018;
	1017 [label="如果我們能存活下來的話，我們會一起克服這個難關。",shape=box,color=red];
		1017 -> 1020;
	1018 [label="怎樣戰鬥",shape=box,color=blue];
		1018 -> 1019;
	1020 [label="所以你忍著我存在主義絕望的哀號作為一種戰鬥策略？這樣你真的太有亞瑟作風了。",shape=box,color=blue];
		1020 -> 1021;
	1019 [label="這就是你跟亞瑟知道的唯一方法嗎？戰鬥？",shape=box,color=blue];
		1019 -> 1022;
	1021 [label="其實，不管你信不信，我是關心你的。",shape=box,color=red];
		1021 -> 1027;
	1022 [label="對於存在的本質上的無意義，你的答案是「找出種方法來打它？」",shape=box,color=blue];
		1022 -> 1023;
	1027 [label="我也關心你，老友。我們是隊友。我們經歷了很多高高低低。",shape=box,color=blue];
		1027 -> 1028;
	1023 [label="我不敢相信我曾經以為我們有共同點。",shape=box,color=blue];
		1023 -> 1024;
	1028 [label="我有責任警告你，愛琳娜號這艘好船可能會沉沒，一是在血海中或是在漆黑的沼澤中，而當她沉沒時，你不會想在船上的。",shape=box,color=blue];
		1028 -> 1030;
	1024 [label="愚蠢的我。",shape=box,color=blue];
		1024 -> 1025;
	1030 [label="+20 Chemistry",color=orange];
		1030 -> 1029;
	1025 [label="Update boolean EleanorNoDate",color=orange];
		1025 -> 1026;
	1029 [label="謝謝。你應該走了。我現在沒事的。真的。",shape=box,color=blue];
		1029 -> 1031;
	1026 [label="Chat ends.",color=orange];
	1031 [label="Chat ends.",color=orange];
}