digraph {
	1906 [label="EleanorRank4Convo6 begins.",color=orange];
		1906 -> 1907;
		1906 -> 1908;
	1907 [label="所以……為什麼是水晶？",shape=box,color=red];
		1907 -> 1909;
	1908 [label="所以。你跟崑西。你們有沒有……你知道的？",shape=box,color=red];
		1908 -> 1910;
	1909 [label="噢，我一直很愛他們。在我小時候，我爸爸帶我們去了拉德斯頓的創新博物館，我跟亞瑟都得到了這些水晶生長套裝。亞瑟的水晶長很很糟糕，簡直就像一塊凹凸不平的小石頭糞便。它被丟進了垃圾桶。我的則是一粒美麗的藍色鑽石。從那天起，不知何故，我就感覺水晶支持我一樣。",shape=box,color=blue];
		1909 -> 1912;
	1910 [label="好，我今天感覺很大方，所以我免費贈你這個資訊吧。",shape=box,color=blue];
		1910 -> 1911;
	1912 [label="那麼它們只是裝飾品嗎？",shape=box,color=red];
		1912 -> 1916;
	1911 [label="我們從來沒有。我們一點點都沒有。",shape=box,color=blue];
		1911 -> 1913;
	1916 [label="啊。不。",shape=box,color=blue];
		1916 -> 1917;
	1913 [label="我不禁想到崑西最喜歡的體位是「伴侶在上面拿著鏡子，這樣他就可以想像他正在跟自己做愛」。",shape=box,color=blue];
		1913 -> 1914;
	1917 [label="我知道有很多關於水晶的各種胡言。我不相信。我不相信它們淨化了我的光環或點亮了我的脈輪。",shape=box,color=blue];
		1917 -> 1918;
	1914 [label="不謝謝。我遠觀欣賞就好。",shape=box,color=blue];
		1914 -> 1915;
	1918 [label="不過它們的確存在。",shape=box,color=blue];
		1918 -> 1919;
	1915 [label="Chat ends.",color=orange];
	1919 [label="對不起。我知道我聽起來就像是一個徹徹底底的傻瓜。",shape=box,color=blue];
		1919 -> 1920;
		1919 -> 1921;
		1919 -> 1922;
	1920 [label="我很高興是你這樣說而不是我。它們只不過是漂亮的石頭。",shape=box,color=red];
		1920 -> 1923;
	1921 [label="我有一些朋友是中樞。它們實際上就是以玻璃立方體形態呈現的智興。你為什麼覺得我會嘲笑你所認為水晶確實存在的看法？",shape=box,color=red];
		1921 -> 1924;
	1922 [label="我花了這麼多時間從地下挖掘出水晶，它們不可能沒有更深層次的意義。你會很驚訝發現有多少 Warframe 是部分由一種或多種水晶製成的。",shape=box,color=red];
		1922 -> 1925;
	1923 [label="噢你有時真是讓人抓狂。",shape=box,color=blue];
		1923 -> 1926;
	1924 [label="那，現在我因為覺得自己很蠢而感到愚蠢。",shape=box,color=blue];
		1924 -> 1929;
	1925 [label="覺得又驚訝既有趣！",shape=box,color=blue];
		1925 -> 1930;
	1926 [label="我還以為你，在全部人當中，會有這個視野能超越純粹物質之上。",shape=box,color=blue];
		1926 -> 1927;
	1929 [label="我期待你會擁有一些我夢寐以求的水晶。",shape=box,color=blue];
		1929 -> 1931;
		1929 -> 1932;
		1929 -> 1933;
	1930 [label="告訴我，有智慧的旅行者，你那個時代的水晶。",shape=box,color=blue];
		1930 -> 1932;
	1927 [label="你去吧你。讓我跟我漂亮的石頭一起。",shape=box,color=blue];
		1927 -> 1928;
	1931 [label="氬晶。你只能在虛空中找到它，一旦挖掘出土它便立刻分解。",shape=box,color=red];
		1931 -> 1934;
	1932 [label="有一整個由水晶製成的 Warframe。Citrine。",shape=box,color=red];
		1932 -> 1944;
	1933 [label="我們有一對變成了水晶的苦命鴛鴦。",shape=box,color=red];
		1933 -> 1941;
	1928 [label="Chat ends.",color=orange];
	1934 [label="你說「你只能在虛空中找到它」，好像人們可以隨便進出虛空一樣。我還以為這是一個令人瘋狂的維度，而不是海濱度假勝地。",shape=box,color=blue];
		1934 -> 1937;
	1944 [label="+10 Chemistry",color=orange];
		1944 -> 1935;
	1941 [label="+10 Chemistry",color=orange];
		1941 -> 1936;
	1937 [label="我想我還沒告訴過你關於 Orokin 堡壘的事。它們就像虛空中的大本營，是為了防止 Sentient 試圖攻擊而建立的。",shape=box,color=red];
		1937 -> 1951;
	1935 [label="那是她的名字？我想我在你的腦海裡看到了她！",shape=box,color=blue];
		1935 -> 1938;
	1936 [label="多美麗又悲傷。成為愛情的紀念碑，會是什麼感覺？",shape=box,color=blue];
		1936 -> 1939;
	1951 [label="+20 Chemistry",color=orange];
		1951 -> 1946;
	1938 [label="那位漂亮的晶洞女士。我想她跟我現在有親戚關係了。一個令人心安的想法。",shape=box,color=blue];
		1938 -> 1943;
	1939 [label="我希望沒有人把它們削成碎片當做紀念品。這肯定會發生在我的時代。",shape=box,color=blue];
		1939 -> 1940;
	1946 [label="這個聽起來可熟悉了。拉德斯頓跟曼庫尼亞地下有這些高度安全的地堡。這個想法是，如果發生輻射戰爭，有錢人跟權貴就會躲在他們的豪華避難所裡喝著含羞草雞尾酒，而我們其他人則在上面被燒成灰燼。",shape=box,color=blue];
		1946 -> 1947;
	1943 [label="歡迎加入這個大家庭，我想？",shape=box,color=red];
		1943 -> 1945;
	1940 [label="那些人的確會試，但我們會確保他們的安全。這是起碼我們能夠做的。",shape=box,color=red];
		1940 -> 1942;
	1947 [label="一樣的舊情節，她嘆了口氣說道。",shape=box,color=blue];
		1947 -> 1948;
	1945 [label="Chat ends.",color=orange];
	1942 [label="Chat ends.",color=orange];
	1948 [label="很有趣。在我成長的過程中每個人都非常害怕輻射戰爭。我記得以前有公共服務廣播。關於如何儲存物資，如何準備避難室，以及即使你不想埋葬死去的親人也要如何埋葬這些沉重的建議。",shape=box,color=blue];
		1948 -> 1949;
	1949 [label="當我看到反應爐在你腦海中爆炸時，我立刻回想起所有那些惡夢。我知道我們必須阻止它，無論付出什麼代價。我會令別人相信你。",shape=box,color=blue];
		1949 -> 1950;
	1950 [label="不過，等待這個星球的不是一場輻射戰爭，不是嗎？是科腐者。無論如何，這個循環將會自行散播而當發生時，世界其餘所有地方都會受到感染。",shape=box,color=blue];
		1950 -> 1952;
	1952 [label="Chat ends.",color=orange];
}