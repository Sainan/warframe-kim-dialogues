		2844 -> 2300 [label=true,color=green];
		2844 -> 2299 [label=true,color=green];
		2844 -> 2296 [label=false,color=brown];
	2300 [label="我已厭倦了跟人進行這種對話。我不會離開。就是這樣。[結束]",shape=box,color=red];
		2300 -> 2301;
	2299 [label="我非常關心這個團隊。現在你們……都是我的家人了。一個我從未真正擁有過的家庭。",shape=box,color=red];
		2299 -> 2304;
