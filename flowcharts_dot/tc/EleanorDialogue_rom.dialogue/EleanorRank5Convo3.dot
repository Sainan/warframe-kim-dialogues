		2310 -> 2311 [label=true,color=green];
		2310 -> 2315 [label=false,color=brown];
	2314 [label="Chat ends.",color=orange];
	2315 [label="我會跟你做一筆交易。去找莉蒂，請她對你進行一次快速的心理評估，搞清楚這裡到底發生了什麼，然後我們把這次對話拋諸腦後吧。",shape=box,color=blue];
		2315 -> 2316;
		2315 -> 2317;
		2315 -> 2318;
	2311 [label="我以為我已經說得很清楚了。",shape=box,color=red];
		2311 -> 2315;
	2316 [label="我不需要心理評估。喜歡你並不是什麼瘋狂的事。如果你對我沒有同樣的感覺，請說出來。",shape=box,color=red];
		2316 -> 2321;
	2317 [label="如果你對我沒有同樣的感覺，就直接說出來。",shape=box,color=red];
