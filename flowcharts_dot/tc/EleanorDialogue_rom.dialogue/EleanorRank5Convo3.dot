		2296 -> 2299 [label=false,color=brown];
		2296 -> 2300 [label=false,color=brown];
	2301 [label="……等等，你剛剛離開了嗎？",shape=box,color=blue];
		2301 -> 2302;
	2304 [label="而我感謝上天你加入我們的那一天。",shape=box,color=blue];
		2304 -> 2307;
	2297 [label="我還以為我們在一起的就足夠說明我為什麼想來這裡。",shape=box,color=red];
		2297 -> 2303;
	2298 [label="我一定要說得那麼白嗎？我在這裡完全因你。  [表白心意]",shape=box,color=red];
		2298 -> 2305;
	2302 [label="Chat ends.",color=orange];
	2307 [label="我很高興你找到了你要找的東西。所有的河流最終都會流向大海。",shape=box,color=blue];
		2307 -> 2313;
	2303 [label="那，現在我在想我做了什麼來引你入局。或者操縱你。也許我在你腦子裡埋下了某些想法。",shape=box,color=blue];
		2303 -> 2308;
	2305 [label="那，現在我在想我做了什麼來引你入局。或者操縱你。也許我在你腦子裡埋下了某些想法。或者你的系統中可能存在二級科腐者病毒，而它被我的系統中的病毒所吸引。",shape=box,color=blue];
		2305 -> 2306;
	2313 [label="+20 Chemistry",color=orange];
		2313 -> 2312;
	2308 [label="或者你的系統中可能存在二級科腐者病毒，而它被我的系統中的病毒所吸引。",shape=box,color=blue];
		2308 -> 2309;
	2306 [label="我被你吸引了，愛琳娜。出於各種原因。",shape=box,color=red];
		2306 -> 2310;
	2312 [label="作為一個家庭來說，這是個亂糟糟的家庭。但給我什麼都不換。",shape=box,color=blue];
		2312 -> 2314;
	2309 [label="或者是（深呼吸）其實你也像我喜歡你一樣喜歡我。事情會不會真的就這麼簡單？",shape=box,color=blue];
		2309 -> 2315;
