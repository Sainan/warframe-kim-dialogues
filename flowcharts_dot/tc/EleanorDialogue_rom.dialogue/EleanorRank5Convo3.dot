		2322 -> 2323;
	2320 [label="Chat ends.",color=orange];
	2323 [label="即是說這樣不會持續太久了，而且我們越早承認越好",shape=box,color=blue];
		2323 -> 2324;
	2324 [label="因為這就是約定俗成的做法",shape=box,color=blue];
