digraph {
	2659 [label="EleanorRank5Convo8 begins.",color=orange];
		2659 -> 2660;
	2660 [label="我一直在想。我有一件想做的事。",shape=box,color=blue];
		2660 -> 2661;
	2661 [label="我會需要幫助。",shape=box,color=blue];
		2661 -> 2662;
		2661 -> 2663;
	2662 [label="永遠都會為你服務。你在想什麼？",shape=box,color=red];
		2662 -> 2665;
	2663 [label="現在不能聊，抱歉。[結束]",shape=box,color=red];
		2663 -> 2664;
	2665 [label="Check boolean EleanorChristopher2",color=orange];
		2665 -> 2667 [label=true,color=green];
		2665 -> 2666 [label=false,color=brown];
	2664 [label="Chat ends.",color=orange];
	2667 [label="那。是克里斯多福。",shape=box,color=blue];
		2667 -> 2675;
	2666 [label="Check boolean EleanorChristopher1",color=orange];
		2666 -> 2671 [label=true,color=green];
		2666 -> 2668 [label=false,color=brown];
	2675 [label="這麼多年我一直對他無法忘懷。亞瑟也同樣。為了紀念他，我們每年都會舉辦儀式。但今年不行。我沒有辦法面對。",shape=box,color=blue];
		2675 -> 2676;
	2671 [label="那……把一個很長又悲慘的故事長話短說的話……克里斯多福在我們結婚前死於路邊炸彈。",shape=box,color=blue];
		2671 -> 2672;
	2668 [label="是時候要告訴你關於克里斯多福的事了。",shape=box,color=blue];
		2668 -> 2669;
	2676 [label="我不知道鬼魂是否存在，但也肯定存在，因為我已讓他成為了鬼魂。",shape=box,color=blue];
		2676 -> 2677;
	2672 [label="或許改天我會告訴你整個故事。或許我不會。",shape=box,color=blue];
		2672 -> 2673;
	2669 [label="亞瑟最好的朋友。我們當時訂了婚。我以為我很愛他。",shape=box,color=blue];
		2669 -> 2670;
	2677 [label="不要對自己那麼苛刻。你當時很愛他。",shape=box,color=red];
		2677 -> 2678;
	2673 [label="我現在告訴你這一切是因為……",shape=box,color=blue];
		2673 -> 2674;
	2670 [label="Update boolean EleanorChristopher1",color=orange];
		2670 -> 2671;
	2678 [label="噢老友。我以為我是。我愛過他，但我甚至不知道我有沒有愛上他。",shape=box,color=blue];
		2678 -> 2679;
	2674 [label="Update boolean EleanorChristopher2",color=orange];
		2674 -> 2675;
	2679 [label="聽起來很無情，對吧？不過，是真的。在當時，這似乎並不重要。然後他死了，這就是我們全部的故事。",shape=box,color=blue];
		2679 -> 2680;
	2680 [label="我喜歡他的一切都被他死亡的方式蒙上陰影。一想到他，我的心就像被石頭壓住。",shape=box,color=blue];
		2680 -> 2681;
	2681 [label="這不公平。對他來說。他應該得到更好的下場。",shape=box,color=blue];
		2681 -> 2682;
		2681 -> 2683;
	2682 [label="我明白。完全明白。我選擇了配得上我父母的方式來愐懷他們。",shape=box,color=red];
		2682 -> 2684;
	2683 [label="曾經發生過事情很可怕。沒有躲避的餘地。但我們不能為了它永遠耿耿於懷。",shape=box,color=red];
		2683 -> 2684;
	2684 [label="那為什麼我會感到這麼內疚呢？",shape=box,color=blue];
		2684 -> 2685;
	2685 [label="為什麼我覺得放下他就等同拋棄他？",shape=box,color=blue];
		2685 -> 2686;
		2685 -> 2688;
	2686 [label="因為你已經背負他太久，久得你不知道怎樣放下。",shape=box,color=red];
		2686 -> 2687;
	2688 [label="因為你擔心沒有其他人能愛你。",shape=box,color=red];
		2688 -> 2689;
	2687 [label="天啊。你說得真對，你知道。",shape=box,color=blue];
		2687 -> 2692;
	2689 [label="Check boolean EleanorDating",color=orange];
		2689 -> 2690 [label=true,color=green];
		2689 -> 2691 [label=false,color=brown];
	2692 [label="我們對如何處理這些問題一竅不通，我們這種人。我們把一切都收藏在心底。我們擺出勇敢的姿態在戰壕裡吹著口哨。這樣做讓我們繼續生活，如同我們的父母如何繼續生活一樣。但我們不知道怎樣改變。",shape=box,color=blue];
		2692 -> 2693;
	2690 [label="就是這個原因嗎？我有那麼膚淺嗎？",shape=box,color=blue];
		2690 -> 2694;
	2691 [label="我懷疑以我目前的景況來看即使是克里斯多福也不會愛我。",shape=box,color=blue];
		2691 -> 2696;
	2693 [label="我該怎樣做？我該如何放下？",shape=box,color=blue];
		2693 -> 2698;
	2694 [label="我覺得我現在不配得到你們其中的任何一個人",shape=box,color=blue];
		2694 -> 2695;
	2696 [label="……不。這不公平。我對他一點也不公平，對嗎？",shape=box,color=blue];
		2696 -> 2697;
	2698 [label="Check boolean LettieDiasdeMuertos",color=orange];
		2698 -> 2699 [label=true,color=green];
		2698 -> 2700 [label=true,color=green];
		2698 -> 2701 [label=true,color=green];
		2698 -> 2700 [label=false,color=brown];
		2698 -> 2701 [label=false,color=brown];
	2695 [label="我想……我希望你得到所有的我。我不能放任某部份的自己在無盡的哀悼中。",shape=box,color=blue];
		2695 -> 2698;
	2697 [label="他不會想阻礙我得到幸福的。他很善良。",shape=box,color=blue];
		2697 -> 2698;
	2699 [label="其實我覺得莉蒂可以幫得上忙。",shape=box,color=red];
		2699 -> 2702;
	2700 [label="你可以寫一封信給他。",shape=box,color=red];
		2700 -> 2703;
	2701 [label="或許跟亞瑟談談。他跟你一起經歷過這種悲痛。",shape=box,color=red];
		2701 -> 2704;
	2702 [label="莉蒂？",shape=box,color=blue];
		2702 -> 2705;
	2703 [label="某部分的我覺得這是個蠢主意。他不會看到這封信。他死了。不過……",shape=box,color=blue];
		2703 -> 2706;
	2704 [label="是，他有。也許這就是問題的其中一部分。我知道他因為我今年沒有舉行我們的小型紀念儀式而感到難過。",shape=box,color=blue];
		2704 -> 2707;
	2705 [label="為什麼是她？",shape=box,color=blue];
		2705 -> 2708;
	2706 [label="……我越想，就越覺得這個主意沒那麼蠢。",shape=box,color=blue];
		2706 -> 2710;
	2707 [label="我只不過……這次以我的方式跟克里斯多福說再見。從此放下。",shape=box,color=blue];
		2707 -> 2711;
	2708 [label="她有很多經驗。她對紀念亡者的一切瞭如指掌。",shape=box,color=red];
		2708 -> 2709;
	2710 [label="好。我會這樣做。有些話我需要跟他說。他在生的時候我從來沒有說過這些話。也許這樣他就可以安眠了。",shape=box,color=blue];
		2710 -> 2712;
	2711 [label="對亞瑟來說，他永遠是個一個失落的兄弟，一個陣亡的士兵。這就是他所知道跟理解的哀悼。但這不是我的方式。",shape=box,color=blue];
		2711 -> 2713;
	2709 [label="我相信如果你向她尋求建議的話，有禮物地，她不會拒絕你的。",shape=box,color=red];
		2709 -> 2720;
	2712 [label="感謝你的聆聽跟建議。",shape=box,color=blue];
		2712 -> 2714;
	2713 [label="我不能再按照亞瑟的方式去做了。我想……只要我跟他說清楚，他會明白的。",shape=box,color=blue];
		2713 -> 2718;
	2720 [label="……",shape=box,color=blue];
		2720 -> 2721;
	2714 [label="+20 Chemistry",color=orange];
		2714 -> 2715;
	2718 [label="+10 Chemistry",color=orange];
		2718 -> 2719;
	2721 [label="對。",shape=box,color=blue];
		2721 -> 2722;
	2715 [label="我永遠，永遠都不會忘記的。",shape=box,color=blue];
		2715 -> 2716;
	2719 [label="謝謝你。",shape=box,color=blue];
		2719 -> 2717;
	2722 [label="是時候了。",shape=box,color=blue];
		2722 -> 2723;
	2716 [label="Chat ends.",color=orange];
	2717 [label="Chat ends.",color=orange];
	2723 [label="+20 Chemistry",color=orange];
		2723 -> 2724;
	2724 [label="我想我需要放下棄很多東西。",shape=box,color=blue];
		2724 -> 2725;
	2725 [label="讓我跟她說。如果她叫我滾蛋，那就這樣吧。但至少我有嘗試過，對吧？",shape=box,color=blue];
		2725 -> 2726;
	2726 [label="肯定值得一試。莉蒂並不像人們想的那樣無情。",shape=box,color=red];
		2726 -> 2727;
	2727 [label="我想也是。這樣生活，做著我們每天做的事情，我們都築起了圍牆。我們只是忘記給它們裝上閘門。",shape=box,color=blue];
		2727 -> 2728;
	2728 [label="謝謝你用你可愛的頭去撞我的牆。",shape=box,color=blue];
		2728 -> 2729;
	2729 [label="Chat ends.",color=orange];
}