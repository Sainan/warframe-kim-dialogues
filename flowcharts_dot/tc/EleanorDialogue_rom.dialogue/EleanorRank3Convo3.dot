digraph {
	1032 [label="EleanorRank3Convo3 begins.",color=orange];
		1032 -> 1033;
	1033 [label="嘿，愛琳娜。你好嗎？",shape=box,color=red];
		1033 -> 1034;
	1034 [label="好得很。剛剛在剃我的舌頭。",shape=box,color=blue];
		1034 -> 1035;
		1034 -> 1036;
	1035 [label="剃？",shape=box,color=red];
		1035 -> 1037;
	1036 [label="等下。 *什麼？*",shape=box,color=red];
		1036 -> 1038;
	1037 [label="剃啊。這些小東西不斷長出來。我想它們以前是味蕾。如果我不把切掉它們，它們就會變得又長又動來動去。就像海葵一樣。",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="這其實跟剪指甲沒什麼分別。",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="對不起。我原本真的應該提醒你一下的。",shape=box,color=blue];
		1039 -> 1041;
	1040 [label="或許，是有點亂。但跟去除多餘的贅生物是沒有分別的。",shape=box,color=blue];
		1040 -> 1041;
	1041 [label="人人都知道，當愛琳娜拿著菜刀和一瓶醫用酒精走進廁所的時候，要躲在一百碼之外。",shape=box,color=blue];
		1041 -> 1042;
	1042 [label="只要耐心等待而最後我會滿臉血地走出來，手中拿著一袋像蟹肉之類的東西。我曾經嘗試將這些廢料變成漢堡，但沒有人想吃。",shape=box,color=blue];
		1042 -> 1043;
	1043 [label="抱歉，你是想要半小時的色情聊天體驗還是五分鐘？",shape=box,color=blue];
		1043 -> 1044;
		1043 -> 1045;
	1044 [label="不要繼續叫我感到噁心。",shape=box,color=red];
		1044 -> 1046;
	1045 [label="那，既然我們都在討論舌頭的同時......",shape=box,color=red];
		1045 -> 1048;
	1046 [label="哎。我才是那個氣管裡塞下半條鰻魚的人。原諒我試著拿這件事開玩笑吧。",shape=box,color=blue];
		1046 -> 1047;
	1048 [label="繼續。",shape=box,color=blue];
		1048 -> 1049;
	1047 [label="Chat ends.",color=orange];
	1049 [label="……你對它有多少控制？",shape=box,color=red];
		1049 -> 1050;
	1050 [label="好。等一下。",shape=box,color=blue];
		1050 -> 1051;
	1051 [label="姐麼多吧",shape=box,color=blue];
		1051 -> 1052;
	1052 [label="我表現滴怎麼樣",shape=box,color=blue];
		1052 -> 1053;
		1052 -> 1054;
	1053 [label="不是告訴我你是……",shape=box,color=red];
		1053 -> 1056;
	1054 [label="噢，才不是呢。我要走了。[結束]",shape=box,color=red];
		1054 -> 1055;
	1056 [label="噢但我是啊嘻嘻",shape=box,color=blue];
		1056 -> 1058;
		1056 -> 1057;
	1055 [label="Chat ends.",color=orange];
	1058 [label="你在用它打字？！",shape=box,color=red];
		1058 -> 1060;
	1057 [label="如果這太私人請原諒我……但是……你還能用它做*什麼*……？",shape=box,color=red];
		1057 -> 1059;
	1060 [label="嗯",shape=box,color=blue];
		1060 -> 1066;
	1059 [label="啊",shape=box,color=blue];
		1059 -> 1061;
	1066 [label="有不過很短時間，只因為當時鍵盤沾滿了我的口水。",shape=box,color=blue];
		1066 -> 1067;
	1061 [label="想想要是你會做什麼",shape=box,color=blue];
		1061 -> 1062;
	1067 [label="怎樣也好。現在你知道了。",shape=box,color=blue];
		1067 -> 1068;
		1067 -> 1069;
	1062 [label="我也可以",shape=box,color=blue];
		1062 -> 1063;
	1068 [label="你曾經控制不住它嗎？",shape=box,color=red];
		1068 -> 1070;
	1069 [label="你有沒有試過不小心咬到它？",shape=box,color=red];
		1069 -> 1071;
	1063 [label="感覺不錯吧嘻嘻",shape=box,color=blue];
		1063 -> 1064;
	1070 [label="該死的東西似乎確實有自己的想法。當我想到這一點時，我便能控制它。但當我不這樣做時，它似乎會對我的情緒做出反應。",shape=box,color=blue];
		1070 -> 1072;
	1071 [label="經常。它好得很快。",shape=box,color=blue];
		1071 -> 1074;
	1064 [label="Update boolean EleanorFlirt",color=orange];
		1064 -> 1065;
		1064 -> 1069;
	1072 [label="更可怕的可能性是，它不是由我控制而是由我跟科腐者的潛在連結所驅動的。我不願意考慮這個選擇。",shape=box,color=blue];
		1072 -> 1073;
	1074 [label="那是我唯一一次把它完全咬斷，它又長回來了。現在我被這東西纏住了。",shape=box,color=blue];
		1074 -> 1075;
	1065 [label="我。嘻。那，好吧。我想我的下一個問題是……你曾經控制不住它嗎？",shape=box,color=red];
		1065 -> 1070;
	1073 [label="不過它阻礙到我的牙齒時我很討厭它。那是我唯一一次把它完全咬斷，它又長回來了。現在我被這東西纏住了。",shape=box,color=blue];
		1073 -> 1075;
	1075 [label="至少它不會長得更長。只會長出些窄長的分支。",shape=box,color=blue];
		1075 -> 1076;
		1075 -> 1077;
	1076 [label="你會希望回到源拓氏改變你之前的樣子嗎？",shape=box,color=red];
		1076 -> 1078;
	1077 [label="你對這有什麼感想？你真的……有什麼感覺？",shape=box,color=red];
		1077 -> 1079;
	1078 [label="我意思是，想啊？巴不得。但我沒辦法，那麼再想這件事又有什麼意義呢？",shape=box,color=blue];
		1078 -> 1080;
	1079 [label="我不會選擇這個結果。但我不討厭它。感覺像是它一開始就在那裡。",shape=box,color=blue];
		1079 -> 1081;
	1080 [label="發生在我們身上的每件事都有原因的。",shape=box,color=red];
		1080 -> 1083;
	1081 [label="我想念自己的聲音。我痛恨我不能再唱歌了。",shape=box,color=blue];
		1081 -> 1082;
	1083 [label="對。只是有時候那個原因是：一個邪惡的混蛋做了些邪惡的事情。",shape=box,color=blue];
		1083 -> 1084;
	1082 [label="但舌頭？你可能會覺得難以置信，但有時這會讓人感到一份安慰。我再也不會手無寸鐵了。",shape=box,color=blue];
		1082 -> 1099;
		1082 -> 1100;
	1084 [label="所以如果你說所有事都會船到橋頭自然直的話，就像這一切都有一個偉大的計劃或目的，那麼只有你這樣想了。我不相信這一點。",shape=box,color=blue];
		1084 -> 1085;
	1099 [label="那……你最喜歡現時你自己的什麼地方？",shape=box,color=red];
		1099 -> 1101;
	1100 [label="我很慶幸你們當中至少有一個人正在努力找到樂觀的一面…...",shape=box,color=red];
		1100 -> 1102;
	1085 [label="Check boolean EleanorHeroVirus",color=orange];
		1085 -> 1086 [label=true,color=green];
		1085 -> 1087 [label=false,color=brown];
	1101 [label="自覺刀槍不入。",shape=box,color=blue];
		1101 -> 1107;
	1102 [label="只有一個？你有見過阿米爾嗎？",shape=box,color=blue];
		1102 -> 1103;
	1086 [label="這是英雄病毒。你會以為自己是其他人故事中的主角。",shape=box,color=blue];
		1086 -> 1087;
	1087 [label="這裡沒有什麼精彩的故事，老友。沒有哪個作家會在我的生活中添加情節以增添戲劇性。",shape=box,color=blue];
		1087 -> 1088;
	1107 [label="介意我跟你說個故事嗎？",shape=box,color=blue];
		1107 -> 1108;
	1103 [label="他有他的黑暗時刻，但那個男孩子對我們所有人來說有一個激勵作用。",shape=box,color=blue];
		1103 -> 1104;
	1088 [label="我可以從發生在我身上的愚蠢事件中找出意義。我是藝術家，而不是太陽或太陰或中間的任何星星。",shape=box,color=blue];
		1088 -> 1089;
	1108 [label="請說。",shape=box,color=red];
		1108 -> 1109;
	1104 [label="跟那些黑口黑面到處遊蕩的人相比，我寧願選擇阿米爾的態度。",shape=box,color=blue];
		1104 -> 1105;
	1089 [label="Check boolean EleanorGalvanized",color=orange];
		1089 -> 1090 [label=true,color=green];
		1089 -> 1091 [label=false,color=brown];
		1089 -> 1092 [label=false,color=brown];
	1109 [label="在我十八歲的時候，我們一大群人出去慶祝考試結束。我們都擠在這輛小車裡。我橫躺在後座的三個人大腿上。",shape=box,color=blue];
		1109 -> 1110;
	1105 [label="+10 Chemistry",color=orange];
		1105 -> 1106;
	1090 [label="是你讓我想起了這一點。我不知道你還記不記得。我為自己感到難過，而你卻讓我擺脫了那個想法。",shape=box,color=blue];
		1090 -> 1091;
		1090 -> 1092;
	1091 [label="興幸我能幫得上忙。",shape=box,color=red];
		1091 -> 1093;
	1092 [label="你不是說生命沒有意義吧，是嗎？",shape=box,color=red];
		1092 -> 1095;
	1110 [label="塞巴・可羅姆利在後尾箱抱怨。克里斯多福跟馬可坐在前面。我們每個人都喝草莓伏特加喝到醉跟淡愛爾。",shape=box,color=blue];
		1110 -> 1111;
	1106 [label="Chat ends.",color=orange];
	1093 [label="+10 Chemistry",color=orange];
		1093 -> 1094;
	1095 [label="天啊，不。我是說意義隱藏在表面之下，而需要雕塑家的鑿子才能發掘那些意義。",shape=box,color=blue];
		1095 -> 1096;
	1111 [label="馬可衝了紅燈，對面開過來的一架車橫撞我們車身，我們滾出了路面，最後掉進了溝裡。我知道這些發生過都是全因警察告訴我的。",shape=box,color=blue];
		1111 -> 1112;
	1094 [label="Chat ends.",color=orange];
	1096 [label="有時候，一切都讓人感到淒涼，可怕和空虛而我不想離開沙發。但當我再次回到正常情緒時，我知道那種感覺是個謊言。",shape=box,color=blue];
		1096 -> 1097;
	1112 [label="他們當時需要把我從車上切割才救得下來。我不停地尖叫。那種痛是你身體內沒有任何罅隙可以躲進去逃避。你因為存在而受到懲罰。",shape=box,color=blue];
		1112 -> 1113;
	1097 [label="沒有任何人掌握意義的鑰匙，你知道嗎？這是你和宇宙之間的即興演奏會。她向你丟難題，你即興發揮。",shape=box,color=blue];
		1097 -> 1098;
	1113 [label="我像一隻小兔子一樣無助。像一支蠟筆般融化。煙消雲散。就躺在那裡發出一聲又一聲的尖叫。在這件事之前，我一直認為自己是個硬朗的人。",shape=box,color=blue];
		1113 -> 1114;
	1098 [label="它有助於專注在我真正喜歡的半感染部分。",shape=box,color=blue];
		1098 -> 1099;
		1098 -> 1100;
	1114 [label="Update boolean EleanorCrash",color=orange];
		1114 -> 1115;
	1115 [label="我知道你所說的那種痛苦。",shape=box,color=red];
		1115 -> 1116;
	1116 [label="兩天前我被一輛清剿隊裝甲運兵車碾過。",shape=box,color=blue];
		1116 -> 1117;
	1117 [label="那往日的痛苦如潮水般湧遍我全身，但它不再讓我無法移動。它就像燃料一樣，讓我興奮，讓我暴怒。",shape=box,color=blue];
		1117 -> 1118;
	1118 [label="我自己站了起來，重新調整肩膀位置並赤手撕裂那輛裝甲運兵車。",shape=box,color=blue];
		1118 -> 1119;
	1119 [label="痛苦，沒錯。但令人著迷。",shape=box,color=blue];
		1119 -> 1121;
	1121 [label="+20 Chemistry",color=orange];
		1121 -> 1120;
	1120 [label="所以對啊，非常感謝，源拓氏。無論你身處何方。",shape=box,color=blue];
		1120 -> 1122;
	1122 [label="Chat ends.",color=orange];
}