digraph {
	1621 [label="EleanorRank4Convo3 begins.",color=orange];
		1621 -> 1622;
	1622 [label="我想我已經做到了。我突破了。我接觸到了。",shape=box,color=blue];
		1622 -> 1623;
	1623 [label="你在嗎？請拜托你一定要在。",shape=box,color=blue];
		1623 -> 1624;
	1624 [label="我一定要透過心靈感應來做到嗎？天啊。拜訪不要是現在。",shape=box,color=blue];
		1624 -> 1625;
		1624 -> 1626;
	1625 [label="愛琳娜，慢慢說。發生什麼事了？",shape=box,color=red];
		1625 -> 1628;
	1626 [label="[無視]",shape=box,color=red];
		1626 -> 1627;
	1628 [label="Check boolean EleanorSister",color=orange];
		1628 -> 1640 [label=true,color=green];
		1628 -> 1629 [label=false,color=brown];
	1627 [label="Chat ends.",color=orange];
	1640 [label="另一個我。成為修女的人。我一直在嘗試接觸她。",shape=box,color=blue];
		1640 -> 1641;
	1629 [label="自從你出現後，有個問題就一直困擾著我。一個相信我剛剛可能已回答了的問題。親愛的日尊，我不知道我做了什麼。                                                                           ",shape=box,color=blue];
		1629 -> 1630;
	1641 [label="而我剛剛做到了。",shape=box,color=blue];
		1641 -> 1642;
	1630 [label="從頭開始說。我不知道你在說什麼。是什麼問題？",shape=box,color=red];
		1630 -> 1631;
	1642 [label="當然只要我還留在這個世界上就永遠不會成功。我已經是這個世界的「我」了。我必須穿過那白色咆哮之地。黑色朦朧之境。水蛭之灣。這就是你到達另一邊的方式。那些可能性和可能發生過的情況。",shape=box,color=blue];
		1642 -> 1643;
	1631 [label="是你！是這該死的你的問題。你不是存在一次而是兩次。",shape=box,color=blue];
		1631 -> 1632;
	1643 [label="虛空！我看到虛空了！",shape=box,color=blue];
		1643 -> 1644;
		1643 -> 1645;
	1632 [label="如果你可以做另一個版本的自己存在於另一個世界，為什麼我不可以呢？",shape=box,color=blue];
		1632 -> 1633;
	1644 [label="你……確定你沒有拿了莉蒂的特別收藏品嗎？",shape=box,color=red];
		1644 -> 1646;
	1645 [label="這不可能的，愛琳娜。在阿爾布雷希特．源拓氏之前，沒有人可以進入虛空。未來距離我們現在還有很遠很遠。",shape=box,color=red];
		1645 -> 1647;
	1633 [label="在現在已被證實存在的廣闊的可能宇宙中的某個地方，有一個我一直想我是否應該成為的那個版本的自己。",shape=box,color=blue];
		1633 -> 1634;
	1646 [label="親愛的漂泊者，我欣賞你用幽默作為應對機制的能力，但此刻我是非常認真的。",shape=box,color=blue];
		1646 -> 1648;
	1647 [label="我是透過我的思想而不是我的身體進去的。這就是分別。",shape=box,color=blue];
		1647 -> 1650;
	1634 [label="那個遠離塵囂成為修女的人。",shape=box,color=blue];
		1634 -> 1635;
	1648 [label="我做了我計劃做的事。",shape=box,color=blue];
		1648 -> 1649;
	1650 [label="嗚頭痛嗚嗚嗚",shape=box,color=blue];
		1650 -> 1651;
	1635 [label="太陰的信徒坐在某個山頂上，芳香雲煙環繞著她。",shape=box,color=blue];
		1635 -> 1636;
	1649 [label="我不單看到了虛空，而且還進入了它。",shape=box,color=blue];
		1649 -> 1650;
	1651 [label="Check boolean EleanorIndifference2",color=orange];
		1651 -> 1652 [label=true,color=green];
		1651 -> 1654 [label=true,color=green];
		1651 -> 1653 [label=false,color=brown];
		1651 -> 1654 [label=false,color=brown];
	1636 [label="我一直在嘗試接觸她。嘗試穿過虛空去尋找她。",shape=box,color=blue];
		1636 -> 1637;
	1652 [label="如果你真的進入了虛空，我無法形容你把自己置於多麼危險的境地。你明知道入面有什麼，但你還是一頭闖進去？",shape=box,color=red];
		1652 -> 1655;
	1654 [label="你瘋了嗎？！",shape=box,color=red];
		1654 -> 1657;
	1653 [label="那你看到了什麼？發生了什麼事？",shape=box,color=red];
		1653 -> 1656;
	1637 [label="Update boolean EleanorSister",color=orange];
		1637 -> 1638;
		1637 -> 1639;
	1655 [label="這就是我當初怎樣進入虛空的。透過那段記憶。恐怖只是一股煙霧，穿過煙霧是一扇門。如果我當時不是那麼害怕的話，我第一次便能看清楚。",shape=box,color=blue];
		1655 -> 1662;
	1657 [label="一丁點都沒有。",shape=box,color=blue];
		1657 -> 1659;
	1656 [label="有種形容不出來的感覺。你看看這個世界你就會瞭解到，所有的平凡 — 建築、汽車、人、職銜、工作，例行公事 — 都只是無底深淵上面的一層薄薄外殼，如果他們意識到這一點，他們就一定會開始尖叫直到永遠。",shape=box,color=blue];
		1656 -> 1658;
	1638 [label="噢不。",shape=box,color=red];
		1638 -> 1641;
	1639 [label="然後呢……？",shape=box,color=red];
		1639 -> 1641;
	1662 [label="這是一個錯誤。露莎卡被帶走了。差一點就奪去了阿爾布雷希特。它也可以輕鬆地帶走你。",shape=box,color=red];
		1662 -> 1663;
	1659 [label="聽我講。拜托。並試著去理解。",shape=box,color=blue];
		1659 -> 1664;
		1659 -> 1665;
	1658 [label="我掉穿那層薄薄的外殼了。",shape=box,color=blue];
		1658 -> 1660;
	1663 [label="它嘗試過。我感覺到了。我知道它很好奇，想接觸我。",shape=box,color=blue];
		1663 -> 1664;
		1663 -> 1665;
	1664 [label="那在無數個可能的世界中，你就那麼剛好找到了正確的一個？",shape=box,color=red];
		1664 -> 1666;
	1665 [label="愛琳娜，漠然可以變成任何它想要的樣子。它看起來就像阿爾布雷希特第一次遇到它時的樣子。",shape=box,color=red];
		1665 -> 1667;
	1660 [label="那不是空虛。我本來可以忍受的。它一直一直地延續下去，但不僅僅是寒冷的空間。裡面還有東西跟我在一起。",shape=box,color=blue];
		1660 -> 1661;
	1666 [label="你不相信也沒關係。我知道這聽起來很瘋狂。但聽我講完，好嗎？",shape=box,color=blue];
		1666 -> 1668;
	1667 [label="我想或許它感覺到了你想要什麼，而呈現出你想看到的形態。",shape=box,color=red];
		1667 -> 1668;
	1661 [label="Update boolean EleanorIndifference2",color=orange];
		1661 -> 1662;
	1668 [label="我會跟你做個協議。",shape=box,color=blue];
		1668 -> 1669;
	1669 [label="首先你讓我把發生的事跟你講完。",shape=box,color=blue];
		1669 -> 1670;
	1670 [label="我講完之後，你就可以自己判斷到底是不是漠然在弄我。我保證我會把你的意見認真聽進去。",shape=box,color=blue];
		1670 -> 1671;
	1671 [label="成交？",shape=box,color=blue];
		1671 -> 1672;
		1671 -> 1673;
	1672 [label="成交。",shape=box,color=red];
		1672 -> 1682;
	1673 [label="我不敢相信你竟然這樣做。永遠不要再這樣做了，愛琳娜！我不能讓那個東西奪去你！",shape=box,color=red];
		1673 -> 1674;
	1682 [label="就像我剛才說的。我找到她了。",shape=box,color=blue];
		1682 -> 1683;
	1674 [label="什麼？",shape=box,color=blue];
		1674 -> 1675;
	1683 [label="我可以感覺到漠然的目光。當它向我伸出手時，我能感覺到它的表情就像那些風乾的沙漠木乃伊。我向她伸出手，她把我拉了過去。",shape=box,color=blue];
		1683 -> 1684;
	1675 [label="我不知道應該說什麼。我有點擔心，因為你聽起來很難過，但我沒有想到你會這麼在乎。",shape=box,color=blue];
		1675 -> 1676;
	1684 [label="她正以 Lotus 姿勢坐在一座類似露天的神殿裡，旁邊是一個滿佈餘燼的坑。當時是晚上。月光昏暗，透過一波波雲彩透現。",shape=box,color=blue];
		1684 -> 1685;
	1676 [label="我沒事。請不用擔心我。",shape=box,color=blue];
		1676 -> 1678;
	1685 [label="她把一隻手指放在嘴唇上。",shape=box,color=blue];
		1685 -> 1686;
	1678 [label="+5 Chemistry",color=orange];
		1678 -> 1677;
	1686 [label="有那麼一瞬間，我感覺到那隻巨形之手仍在探索我。然後它縮了回去，就像斷頭台斬在它的一根手指上。",shape=box,color=blue];
		1686 -> 1687;
	1677 [label="我不能答應你什麼，但我會盡量不再讓你擔心。",shape=box,color=blue];
		1677 -> 1679;
		1677 -> 1680;
	1687 [label="草兒低語。蟋蟀歌唱。只剩我們二人。",shape=box,color=blue];
		1687 -> 1689;
	1679 [label="好吧……那就……告訴我發生了什麼事。",shape=box,color=red];
		1679 -> 1682;
	1680 [label="我不能再繼續下去了。[結束]",shape=box,color=red];
		1680 -> 1681;
	1689 [label="這一切聽起來都非常熟悉。然後呢？",shape=box,color=red];
		1689 -> 1688;
	1681 [label="Chat ends.",color=orange];
	1688 [label="我們對著火坑坐在大家對面。她沒有說話，但她讓我探視她的內心，溫柔而充滿姐妹情愫。",shape=box,color=blue];
		1688 -> 1690;
	1690 [label="她是那麼的幸福，那麼的滿足。一個女人在適合她的地方。長滿繭的腳，清澈的眼睛。呼吸著熊火暢飲著月光。",shape=box,color=blue];
		1690 -> 1691;
		1690 -> 1692;
	1691 [label="所以你覺得這對你來說是個正確的選擇嗎？",shape=box,color=red];
		1691 -> 1693;
	1692 [label="你當時想留下來嗎？",shape=box,color=red];
		1692 -> 1693;
	1693 [label="不！完全相反！",shape=box,color=blue];
		1693 -> 1694;
	1694 [label="我不需要走那條道路，因為她已經走了。你不明白嗎？我現在自由了。我不需要知道「如果」，因為已經有了一位愛琳娜修女了。她會支持我。你懂我在說什麼嗎？",shape=box,color=blue];
		1694 -> 1695;
	1695 [label="算是吧？我想知道的是，這對你有幫助嗎？",shape=box,color=red];
		1695 -> 1696;
	1696 [label="噢很有。我從未都未這樣有信心下一步該做什麼。",shape=box,color=blue];
		1696 -> 1698;
	1698 [label="+15 Chemistry",color=orange];
		1698 -> 1697;
	1697 [label="我會珍惜她給予了我自由的生命，並且盡情享受。",shape=box,color=blue];
		1697 -> 1699;
	1699 [label="Chat ends.",color=orange];
}