digraph {
	143 [label="EleanorRank1Convo3 begins.",color=orange];
		143 -> 144;
	144 [label="所以。有關虛空。",shape=box,color=blue];
		144 -> 145;
	145 [label="老實說我真的蠻很好奇。所以……",shape=box,color=blue];
		145 -> 146;
	146 [label="……可以直接問你一些問題嗎？",shape=box,color=blue];
		146 -> 147;
		146 -> 148;
		146 -> 149;
	147 [label="當然可以。",shape=box,color=red];
		147 -> 154;
	148 [label="我可能不知道所有的答案，但你請吧。",shape=box,color=red];
		148 -> 153;
	149 [label="不可以。[結束]",shape=box,color=red];
		149 -> 150;
	154 [label="太好了。所以……",shape=box,color=blue];
		154 -> 155;
	153 [label="+10 Chemistry",color=orange];
		153 -> 152;
	150 [label="……因此，你具備那種我非常欣賞的神秘氛圍。",shape=box,color=blue];
		150 -> 151;
	155 [label="……你會怎樣用幾句話來總結虛空對你的意義呢？",shape=box,color=blue];
		155 -> 156;
		155 -> 157;
		155 -> 158;
	152 [label="我欣賞你的直白。",shape=box,color=blue];
		152 -> 154;
	151 [label="Chat ends.",color=orange];
	156 [label="這麼突然。這是個訪問嗎？",shape=box,color=red];
		156 -> 159;
	157 [label="對我來說有什麼「意義」？",shape=box,color=red];
		157 -> 160;
	158 [label="沒有人真正瞭解虛空是什麼。它是個維度，它是個能量場，它是個穿越空間的捷徑，它是 Orokin 隱身的孔洞……",shape=box,color=red];
		158 -> 161;
	159 [label="對不起。舊習慣。",shape=box,color=blue];
		159 -> 162;
	160 [label="是的。",shape=box,color=blue];
		160 -> 163;
	161 [label="雖說這一切非常有趣，但聽起來很技術性。我更感興趣的是這對你來說有什麼意義。因為你看起來，嗯，一呼一吸都依賴它。實際上地。",shape=box,color=blue];
		161 -> 164;
		161 -> 165;
		161 -> 166;
	162 [label="原諒我。我不再是名記者，而你也不再是個故事。我只是深感興趣。",shape=box,color=blue];
		162 -> 164;
		162 -> 165;
		162 -> 166;
	163 [label="用你自己的角度說吧。",shape=box,color=blue];
		163 -> 164;
		163 -> 165;
		163 -> 166;
	164 [label="虛空給予了我完成不可能事情的能力。發射能量束啊，讓我隱身啊，那些好技能。我來自的地方，這正正能讓 Warframe 發揮他們的潛能的因素。",shape=box,color=red];
		164 -> 201;
	165 [label="虛空讓我的父母瘋了。",shape=box,color=red];
		165 -> 167;
	166 [label="我忘記有多久但虛空曾經是我的家。它迎合了我而成型。或者我以某種方式打造了它。還是摸不透到底發生了什麼事。",shape=box,color=red];
		166 -> 169;
	201 [label="等等。等等。",shape=box,color=blue];
		201 -> 202;
	167 [label="抱歉。問出了這樣的問題此刻我覺得自己很失禮。",shape=box,color=blue];
		167 -> 168;
	169 [label="噢。你勾起了我的興趣。",shape=box,color=blue];
		169 -> 170;
	202 [label="虛空是個奇蹟引擎，你是這樣的意思嗎？",shape=box,color=blue];
		202 -> 203;
	168 [label="那他們有好點了嗎？",shape=box,color=blue];
		168 -> 171;
	170 [label="Check boolean EleanorDuviri",color=orange];
		170 -> 172 [label=true,color=green];
		170 -> 174 [label=false,color=brown];
	203 [label="我已經跟它連接到了？",shape=box,color=blue];
		203 -> 205;
	171 [label="他們從來都沒有機會。",shape=box,color=red];
		171 -> 176;
	172 [label="你指的形狀是指……渡域？高塔，島嶼跟飛馬？",shape=box,color=blue];
		172 -> 178;
	174 [label="它採用了什麼形狀？",shape=box,color=blue];
		174 -> 179;
	205 [label="你說的連接，是什麼意思？",shape=box,color=red];
		205 -> 204;
	176 [label="噢日尊。太不幸了。",shape=box,color=blue];
		176 -> 177;
	178 [label="對啊。真的是個童話故事成真。",shape=box,color=red];
		178 -> 182;
	179 [label="有本我曾經很喜歡的書。 《渡域故事集》。故事是關於一個神奇王國，但背後的意義是他們可以教會你的情感跟教誨。",shape=box,color=red];
		179 -> 180;
	204 [label="我的意思是我是 Warframe。或是個原型 Warframe。我跟他們一樣。",shape=box,color=blue];
		204 -> 206;
	177 [label="你會不會希望暫時先不討論這個話題？",shape=box,color=blue];
		177 -> 175;
		177 -> 173;
	182 [label="這是真的嗎？不會感覺像做夢嗎？",shape=box,color=blue];
		182 -> 189;
	180 [label="虛空讓它成為現實而我需生活在裡面。然後它變成了監獄。不過那是另一個故事了。",shape=box,color=red];
		180 -> 181;
	206 [label="而我現在有些本事了。精神控制。臉部融化。",shape=box,color=blue];
		206 -> 207;
	175 [label="我沒問題。",shape=box,color=red];
		175 -> 186;
	173 [label="啊，我不太想說。 [結束]",shape=box,color=red];
		173 -> 183;
	189 [label="不，愛琳娜，每天一早被謀殺並不感覺是一場夢。我每一秒都確實感受到。",shape=box,color=red];
		189 -> 190;
	181 [label="Update boolean EleanorDuviri",color=orange];
		181 -> 182;
	207 [label="這就是來自我內心的力量嗎？虛空？",shape=box,color=blue];
		207 -> 208;
	186 [label="把父母跟孩子分開。挑撥離間。對我來說聽起來不是巧合。",shape=box,color=blue];
		186 -> 187;
	183 [label="那下次吧。",shape=box,color=blue];
		183 -> 184;
	190 [label="明白。",shape=box,color=blue];
		190 -> 192;
	208 [label="等等，往前一點。在我的年代，有這個……泵。戰慄魔心。",shape=box,color=red];
		208 -> 209;
	187 [label="這聽起來像是有意識的企圖。",shape=box,color=blue];
		187 -> 188;
	184 [label="Update boolean EleanorDrifterParentsAsked",color=orange];
		184 -> 185;
	192 [label="我……",shape=box,color=blue];
		192 -> 196;
	209 [label="等一下。讓我坐得舒服點。",shape=box,color=blue];
		209 -> 210;
	188 [label="幾乎像是被扭曲了的科學一樣。",shape=box,color=blue];
		188 -> 191;
	185 [label="Chat ends.",color=orange];
	196 [label="不知道那會是什麼樣的感覺。",shape=box,color=blue];
		196 -> 197;
	210 [label="好。你剛剛講到。我急不及待想聽下去。",shape=box,color=blue];
		210 -> 211;
	191 [label="對啊。虛空中是有些東西。我知道的就這麼多了。冷漠、無法合上之眼、「牆中人」。當我說虛空是始作俑者時，我意思是其實是他。",shape=box,color=red];
		191 -> 193;
	197 [label="話語，被轉化成真。一個具體的現實，從無到有。",shape=box,color=blue];
		197 -> 215;
	211 [label="《戰慄魔心》讓整個始源星系沉浸在一種虛空光環之中。就像背景輻射一樣。任何汲取虛空能量的東西都取決於這個魔心。",shape=box,color=red];
		211 -> 212;
	193 [label="所以他們不是同一個東西嗎？",shape=box,color=blue];
		193 -> 195;
	215 [label="「魔法」這個形容詞似乎不能反映出它的厲害。",shape=box,color=blue];
		215 -> 218;
	212 [label="那現在。",shape=box,color=blue];
		212 -> 213;
	195 [label="他們可能是。但我希望他們不是。",shape=box,color=red];
		195 -> 194;
	218 [label="+10 Chemistry",color=orange];
		218 -> 216;
	213 [label="如果我的時代沒有戰慄魔心，那麼虛空又可以如何接觸到我呢？",shape=box,color=blue];
		213 -> 214;
	194 [label="Update boolean EleanorDrifterParents",color=orange];
		194 -> 198;
	216 [label="你正在描述的東西太奇幻了。",shape=box,color=blue];
		216 -> 217;
	214 [label="因為我能感覺到，你知道。我肯定我可以。",shape=box,color=blue];
		214 -> 215;
	198 [label="厲害。",shape=box,color=blue];
		198 -> 199;
	217 [label="Update boolean EleanorVoidLove",color=orange];
		217 -> 219;
	199 [label="那是為什麼？",shape=box,color=blue];
		199 -> 200;
	219 [label="Chat ends.",color=orange];
	200 [label="未來基本上是是依舊虛空運作。星際旅行、Warframe、Tenno……如果沒有虛空，一切都無法成事。",shape=box,color=red];
		200 -> 201;
}