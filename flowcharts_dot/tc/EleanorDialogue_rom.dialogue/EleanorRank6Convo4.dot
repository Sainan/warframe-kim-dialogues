digraph {
	"EleanorRank6Convo4 begins." [color=orange];
		"EleanorRank6Convo4 begins." -> j711725784;
	j711725784 [label="你有沒有遇過那種情況，就是在洗澡的時候，突然有個奇怪的小聲音問你一個你從來沒想過要問自己的問題？",shape=box,color=blue];
		j711725784 -> j25551004;
		j711725784 -> j2288047525;
		j711725784 -> j2890457786;
	j25551004 [label="還好，沒有。[結束]",shape=box,color=red];
		j25551004 -> "Chat ends.";
	j2288047525 [label="像說，「當月球突然再次出現在天空中時，地球上的人們怎麼想？」之類的想法？",shape=box,color=red];
		j2288047525 -> j2697613578;
	j2890457786 [label="你指的是像說，「指揮官！你有沒有考慮過把你的庫狛做成標本？」之類的想法？",shape=box,color=red];
		j2890457786 -> j3211973613;
	"Chat ends." [color=orange];
	j2697613578 [label="是的，沒錯。",shape=box,color=blue];
		j2697613578 -> j2308131202;
	j3211973613 [label="那只是 Ordis 。他很常這樣。",shape=box,color=red];
		j3211973613 -> j2112037704;
	j2308131202 [label="等一下",shape=box,color=blue];
		j2308131202 -> j696092234;
	j2112037704 [label="願他平安。不，我指的是發自內心的聲音。",shape=box,color=blue];
		j2112037704 -> j1612179143;
	j696092234 [label="月球不見了？",shape=box,color=blue];
		j696092234 -> j3400900450;
	j1612179143 [label="有點像你在忙著打理個人衛生的同時，你的大腦在忙自己的事。",shape=box,color=blue];
		j1612179143 -> j466151657;
	j3400900450 [label="消失多久？她去哪裡了？那潮汐怎麼辦？",shape=box,color=blue];
		j3400900450 -> j1944489821;
		j3400900450 -> j2169419119;
	j466151657 [label="我經常遇到這種情況。隨機而詭異。最近頻繁到我都開始懷疑它們是不是真的出自我自己的頭腦。",shape=box,color=blue];
		j466151657 -> j2610813391;
	j1944489821 [label="按照順序作答：不知，虛空，不知。",shape=box,color=red];
		j1944489821 -> j165417022;
	j2169419119 [label="Lotus 在遠古之戰末期把月球送進了虛空。那小子是最近才把月球帶了回來。",shape=box,color=red];
		j2169419119 -> j1771870335;
	j2610813391 [label="我已經把其中一些想法畫成了畫。",shape=box,color=blue];
		j2610813391 -> j165417022;
	j165417022 [label="沒關係，我們可以回頭再談論這個話題。",shape=box,color=blue];
		j165417022 -> j3208330575;
	j1771870335 [label="不清楚潮汐的事。",shape=box,color=red];
		j1771870335 -> j1070631489;
	j3208330575 [label="所以話說回來，洗澡時的突發奇想。今天早上我腦中突然冒出一個絕對震撼的想法。",shape=box,color=blue];
		j3208330575 -> j2297596949;
	j1070631489 [label="Lotus 是怎麼移動整個月球的？",shape=box,color=blue];
		j1070631489 -> j165417022;
	j2297596949 [label="它是這樣的，「嘿，如果神祇是真實存在那會怎樣？」",shape=box,color=blue];
		j2297596949 -> j3979170811;
	j3979170811 [label="我有一瞬間感到全身無力。不得不用冷水沖臉來讓自己恢復清醒。",shape=box,color=blue];
		j3979170811 -> j3141285525;
		j3979170811 -> j1391087252;
		j3979170811 -> j648825260;
	j3141285525 [label="這有什麼好奇怪的？對我來說這似乎是再基本不過的問題了。",shape=box,color=red];
		j3141285525 -> j1052161362;
	j1391087252 [label="……難道人們不認為神祇是真實存在的嗎？我非常確定莉蒂是這麼認為的。",shape=box,color=red];
		j1391087252 -> j1292843208;
	j648825260 [label="嗯，那是個可怕的想法。",shape=box,color=red];
		j648825260 -> j2257144041;
	j1052161362 [label="啊，這就是為什麼我喜歡和你談論這些事情",shape=box,color=blue];
		j1052161362 -> j3213226734;
	j1292843208 [label="哦，拜託。沒有人真的會把神祇當真。不會真的把衪們當作桌子和椅子那般真實存在。",shape=box,color=blue];
		j1292843208 -> j666358256;
	j2257144041 [label="不是嗎？如果每次你認為宇宙在向你傳遞訊息時，其實它就是在向你傳遞訊息呢？",shape=box,color=blue];
		j2257144041 -> j3223854650;
	j3213226734 [label="你的人生經歷離譜到，以至於對你來說神祇的真實性就像評比披薩配料的優劣性一樣自然",shape=box,color=blue];
		j3213226734 -> j2226875759;
	j666358256 [label="真正的神祇就像村莊裡的水井和茅坑。衪們是人們過去曾經擁有的東西。",shape=box,color=blue];
		j666358256 -> j4020579990;
	j3223854650 [label="想像一下，世間萬物一切都掌握在這些卑鄙、不死的混蛋手中，衪們掌權只是因為事情就是這樣，而不是因為他們配得上",shape=box,color=blue];
		j3223854650 -> j1598161233;
	j2226875759 [label="你甚至都可能已經遇見過一位神了。如果漠然就是神的話。",shape=box,color=blue];
		j2226875759 -> j293784606;
	j4020579990 [label="如今衪們只是符號、隱喻，或其它狗屁之類的東西。",shape=box,color=blue];
		j4020579990 -> j1849842461;
		j4020579990 -> j1011967747;
	j1598161233 [label="而令人難以置信的是，那就是人們實際上的生活。那就是每天他們生活中的現實。",shape=box,color=blue];
		j1598161233 -> j2622344957;
	j293784606 [label="你剛好讓我想起一件事，在扎日曼號上。我第一次遇到漠然的時候。",shape=box,color=red];
		j293784606 -> j4143107342;
	j1849842461 [label="也許人們只是比較不那麼害怕了？",shape=box,color=red];
		j1849842461 -> j767737141;
	j1011967747 [label="我還以為太陽和太陰是你們的神祇。",shape=box,color=red];
		j1011967747 -> j1463765938;
	j2622344957 [label="對他們來說，神祇就像天氣一樣真實，而且對他們也同樣不在乎。",shape=box,color=blue];
		j2622344957 -> j602899234;
	j4143107342 [label="當然，我當時不知道那是什麼。不過，我記得當時它說過什麼。",shape=box,color=red];
		j4143107342 -> j391425073;
	j767737141 [label="是的，我想是因為這個原因。",shape=box,color=blue];
		j767737141 -> j2206726834;
	j1463765938 [label="嗯，是，衪們是啊。但衪們也只是天體而已。",shape=box,color=blue];
		j1463765938 -> j2037799098;
	j602899234 [label="老實說，聽起來和 Orokin 統治下的生活沒什麼差別。",shape=box,color=red];
		j602899234 -> j2536212940;
	j391425073 [label="我說它可以帶走我的光，然後它就對著我詭笑說，「謝啦，小鬼。我想我會的」。",shape=box,color=red];
		j391425073 -> j203976664;
	j2206726834 [label="我想我也知道為什麼了。",shape=box,color=blue];
		j2206726834 -> j2839530546;
	j2037799098 [label="就像不列坦尼亞是個國家，有名字和特色等等，但它也就只是一片土地和土石而已。它同時可以兩者皆是。",shape=box,color=blue];
		j2037799098 -> j4189227268;
	j2536212940 [label="不會死，又卑鄙，掌權是因為他們本來就掌權……",shape=box,color=red];
		j2536212940 -> j63661940;
	j203976664 [label="哦，天哪，你讓我全身顫抖",shape=box,color=blue];
		j203976664 -> j1031535003;
	j2839530546 [label="這一切都與光有關。",shape=box,color=blue];
		j2839530546 -> j3616136477;
	j4189227268 [label="你可以在一個陽光明媚的美好日子外出，心懷感激，仰望太陽說一聲，「謝謝！」。你是真心實意的。那是正常人類會做的事。",shape=box,color=blue];
		j4189227268 -> j976876945;
	j63661940 [label="沒錯。你們有活生生的神祇。但你們把衪們都殺了。",shape=box,color=blue];
		j63661940 -> j2426414769;
	j1031535003 [label="在所有古老的民間傳說中，魔鬼就藏在法律文件的細節裡",shape=box,color=blue];
		j1031535003 -> j3555925469;
	j3616136477 [label="在任何人想到把衪們當作神祇之前，太陽和太陰究竟是什麼？衪們是光。",shape=box,color=blue];
		j3616136477 -> j1714028163;
		j3616136477 -> j192298392;
	j976876945 [label="但現今不會有人認為太陽或太陰真的讓某某人類婦女懷孕，或衪們懷上了某個人類男人的孩子，而國王就是這樣誕生的。",shape=box,color=blue];
		j976876945 -> j3704318161;
	j2426414769 [label="別誤會，我為你感到高興。",shape=box,color=blue];
		j2426414769 -> j4226807275;
	j3555925469 [label="你有沒有覺得它是不是認為你向它承諾了某件東西？你的「光」？",shape=box,color=blue];
		j3555925469 -> j1729831623;
		j3555925469 -> j2103468473;
	j1714028163 [label="是的。無論身處何方，光明始終象徵良善。",shape=box,color=red];
		j1714028163 -> j4288206105;
	j192298392 [label="這是人類長久以來唯一擁有的光源。",shape=box,color=red];
		j192298392 -> j4288206105;
	j3704318161 [label="人們曾經相信那種東西。現今的我們知道那些故事止於傳說。我們已經超脫了這套想法。",shape=box,color=blue];
		j3704318161 -> j2397729435;
		j3704318161 -> j2824846274;
	j4226807275 [label="你把我和那小子搞混了。我從來沒有參與那場大型的 Tenno 叛亂。",shape=box,color=red];
		j4226807275 -> j2214706855;
	j1729831623 [label="它說我們達成了一筆「交易」。所以我想它認為我欠了它……什麼東西。",shape=box,color=red];
		j1729831623 -> j1210534402;
	j2103468473 [label="我指的是我攜帶的燈球，但誰知道它指的是什麼。",shape=box,color=red];
		j2103468473 -> j1210534402;
	j4288206105 [label="是的。",shape=box,color=blue];
		j4288206105 -> j2427370178;
	j2397729435 [label="神祇和人類……走到一起？",shape=box,color=red];
		j2397729435 -> j2836975140;
	j2824846274 [label="神祇為雙親的國王？我還以為 Orokin 才是混蛋呢。",shape=box,color=red];
		j2824846274 -> j2836975140;
	j2214706855 [label="從來就沒有參與過 Margulis 的特殊孩童計劃，從來就沒有獲得過Warframe，從來就沒有參與過遠古之戰。",shape=box,color=red];
		j2214706855 -> j269600472;
	j1210534402 [label="至少我知道關於它的一件事。就是它愛耍花招。",shape=box,color=red];
		j1210534402 -> j4015623429;
	j2427370178 [label="但是後來某個洞穴宅，大概被某個大隻洞穴女欺負了，就想出了整個雙石互相敲擊的把戲，不敲不知道，一敲不得了。",shape=box,color=blue];
		j2427370178 -> j3536655859;
	j2836975140 [label="哦，這種事稀鬆平常。全世界都有發生。",shape=box,color=blue];
		j2836975140 -> j3161381719;
	j269600472 [label="……那麼你會想嗎？",shape=box,color=blue];
		j269600472 -> j2318535493;
		j269600472 -> j1189265487;
		j269600472 -> j3666530848;
	j4015623429 [label="+20 Chemistry",color=orange];
		j4015623429 -> j990686091;
	j3536655859 [label="要光有光！完全不必看老天臉色賜的光！",shape=box,color=blue];
		j3536655859 -> j3667693030;
	j3161381719 [label="想像一下，你是某個狂妄祭司，飄洋過海向新世界當地的「野人」傳教太陽的福音，結果發現他們不僅已經知道有關太陽的一切了，他們還有太陽的親生兒子來統治他們。",shape=box,color=blue];
		j3161381719 -> j535406043;
	j2318535493 [label="我真的不知道。",shape=box,color=red];
		j2318535493 -> j1313128495;
	j1189265487 [label="老實說，不會欸。",shape=box,color=red];
		j1189265487 -> j85051102;
	j3666530848 [label="當然，我超想。",shape=box,color=red];
		j3666530848 -> j1913813428;
	j990686091 [label="好的。無論你今天做什麼，無論你和誰在一起，無論是我還是亞瑟還是我們之中的任何人……都要注意安全。",shape=box,color=blue];
		j990686091 -> j3435349021;
	j3667693030 [label="如今看看我們。光無處不在。是我們讓它失去了價值。",shape=box,color=blue];
		j3667693030 -> j293784606;
	j535406043 [label="你會夾著尾巴迅速返航，或者就地皈依。",shape=box,color=blue];
		j535406043 -> j3166823115;
		j535406043 -> j3839874860;
	j1313128495 [label="那很合理。我尊重這點。",shape=box,color=blue];
		j1313128495 -> j2991126293;
	j85051102 [label="我很高興。如果你覺得你的生活可能會變得比現在更糟，那我想我們就有值得慶祝的理由了，是吧？",shape=box,color=blue];
		j85051102 -> j2991126293;
	j1913813428 [label="我想，我能夠理解。那你錯過了很多大場面，不是嗎？",shape=box,color=blue];
		j1913813428 -> j2991126293;
	j3435349021 [label="Check boolean EleanorDating",color=orange];
		j3435349021 -> j1145479810 [label=true,color=green];
		j3435349021 -> j3051531944 [label=false,color=brown];
	j3166823115 [label="不過，你真的認為神祇是真實存在的嗎？還是只是你害怕衪們可能真實存在的這種想法？",shape=box,color=red];
		j3166823115 -> j638712645;
	j3839874860 [label="好的。所以你是說，如果以前的人們一直都是對的那會怎樣？",shape=box,color=red];
		j3839874860 -> j638712645;
	j2991126293 [label="Check boolean EleanorDating",color=orange];
		j2991126293 -> j2571644835 [label=true,color=green];
		j2991126293 -> j79821935 [label=false,color=brown];
	j1145479810 [label="我愛你。任何試圖阻撓我們的神明最好向眾神之神或什麼的鬼東西祈禱。",shape=box,color=blue];
		j1145479810 -> "Chat ends.";
	j3051531944 [label="你是我親愛的朋友。任何試圖從我身邊帶走你的神明都將發現其現實受到嚴峻考驗。",shape=box,color=blue];
		j3051531944 -> "Chat ends.";
	j638712645 [label="這麼說好了，我曾經對物質枯燥乏味的實體現實比現在更有信心。",shape=box,color=blue];
		j638712645 -> j567056142;
	j2571644835 [label="+20 Chemistry",color=orange];
		j2571644835 -> j1022247483;
	j79821935 [label="+20 Chemistry",color=orange];
		j79821935 -> j3920441713;
	j567056142 [label="而自信曾經所在的位置，如今留下了漂泊者形狀的空洞。",shape=box,color=blue];
		j567056142 -> j2877538956;
	j1022247483 [label="我的愛人，我們都背負著自己的傷疤。",shape=box,color=blue];
		j1022247483 -> "Chat ends.";
	j3920441713 [label="我的朋友，我們都背負著自己的傷疤。",shape=box,color=blue];
		j3920441713 -> "Chat ends.";
	j2877538956 [label="+20 Chemistry",color=orange];
		j2877538956 -> j864421041;
	j864421041 [label="老實說？我並不懷念這些東西，真的。偶爾對各種可能性感到驚訝也挺不錯。",shape=box,color=blue];
		j864421041 -> "Chat ends.";
}