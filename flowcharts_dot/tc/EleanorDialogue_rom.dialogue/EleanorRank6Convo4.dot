digraph {
	2968 [label="EleanorRank6Convo4 begins.",color=orange];
		2968 -> 2969;
	2969 [label="你有沒有遇過那種情況，就是在洗澡的時候，突然有個奇怪的小聲音問你一個你從來沒想過要問自己的問題？",shape=box,color=blue];
		2969 -> 2970;
		2969 -> 2971;
		2969 -> 2972;
	2970 [label="還好，沒有。[結束]",shape=box,color=red];
		2970 -> 2973;
	2971 [label="像說，「當月球突然再次出現在天空中時，地球上的人們怎麼想？」之類的想法？",shape=box,color=red];
		2971 -> 2974;
	2972 [label="你指的是像說，「指揮官！你有沒有考慮過把你的庫狛做成標本？」之類的想法？",shape=box,color=red];
		2972 -> 2975;
	2973 [label="Chat ends.",color=orange];
	2974 [label="是的，沒錯。",shape=box,color=blue];
		2974 -> 2976;
	2975 [label="那只是 Ordis 。他很常這樣。",shape=box,color=red];
		2975 -> 2977;
	2976 [label="等一下",shape=box,color=blue];
		2976 -> 2978;
	2977 [label="願他平安。不，我指的是發自內心的聲音。",shape=box,color=blue];
		2977 -> 2979;
	2978 [label="月球不見了？",shape=box,color=blue];
		2978 -> 2980;
	2979 [label="有點像你在忙著打理個人衛生的同時，你的大腦在忙自己的事。",shape=box,color=blue];
		2979 -> 2981;
	2980 [label="消失多久？她去哪裡了？那潮汐怎麼辦？",shape=box,color=blue];
		2980 -> 2982;
		2980 -> 2983;
	2981 [label="我經常遇到這種情況。隨機而詭異。最近頻繁到我都開始懷疑它們是不是真的出自我自己的頭腦。",shape=box,color=blue];
		2981 -> 2984;
	2982 [label="按照順序作答：不知，虛空，不知。",shape=box,color=red];
		2982 -> 2985;
	2983 [label="Lotus 在遠古之戰末期把月球送進了虛空。那小子是最近才把月球帶了回來。",shape=box,color=red];
		2983 -> 2986;
	2984 [label="我已經把其中一些想法畫成了畫。",shape=box,color=blue];
		2984 -> 2985;
	2985 [label="沒關係，我們可以回頭再談論這個話題。",shape=box,color=blue];
		2985 -> 2987;
	2986 [label="不清楚潮汐的事。",shape=box,color=red];
		2986 -> 2988;
	2987 [label="所以話說回來，洗澡時的突發奇想。今天早上我腦中突然冒出一個絕對震撼的想法。",shape=box,color=blue];
		2987 -> 2989;
	2988 [label="Lotus 是怎麼移動整個月球的？",shape=box,color=blue];
		2988 -> 2985;
	2989 [label="它是這樣的，「嘿，如果神祇是真實存在那會怎樣？」",shape=box,color=blue];
		2989 -> 2990;
	2990 [label="我有一瞬間感到全身無力。不得不用冷水沖臉來讓自己恢復清醒。",shape=box,color=blue];
		2990 -> 2991;
		2990 -> 2992;
		2990 -> 2993;
	2991 [label="這有什麼好奇怪的？對我來說這似乎是再基本不過的問題了。",shape=box,color=red];
		2991 -> 2994;
	2992 [label="……難道人們不認為神祇是真實存在的嗎？我非常確定莉蒂是這麼認為的。",shape=box,color=red];
		2992 -> 2995;
	2993 [label="嗯，那是個可怕的想法。",shape=box,color=red];
		2993 -> 2996;
	2994 [label="啊，這就是為什麼我喜歡和你談論這些事情",shape=box,color=blue];
		2994 -> 2997;
	2995 [label="哦，拜託。沒有人真的會把神祇當真。不會真的把衪們當作桌子和椅子那般真實存在。",shape=box,color=blue];
		2995 -> 2998;
	2996 [label="不是嗎？如果每次你認為宇宙在向你傳遞訊息時，其實它就是在向你傳遞訊息呢？",shape=box,color=blue];
		2996 -> 2999;
	2997 [label="你的人生經歷離譜到，以至於對你來說神祇的真實性就像評比披薩配料的優劣性一樣自然",shape=box,color=blue];
		2997 -> 3000;
	2998 [label="真正的神祇就像村莊裡的水井和茅坑。衪們是人們過去曾經擁有的東西。",shape=box,color=blue];
		2998 -> 3001;
	2999 [label="想像一下，世間萬物一切都掌握在這些卑鄙、不死的混蛋手中，衪們掌權只是因為事情就是這樣，而不是因為他們配得上",shape=box,color=blue];
		2999 -> 3002;
	3000 [label="你甚至都可能已經遇見過一位神了。如果漠然就是神的話。",shape=box,color=blue];
		3000 -> 3003;
	3001 [label="如今衪們只是符號、隱喻，或其它狗屁之類的東西。",shape=box,color=blue];
		3001 -> 3004;
		3001 -> 3005;
	3002 [label="而令人難以置信的是，那就是人們實際上的生活。那就是每天他們生活中的現實。",shape=box,color=blue];
		3002 -> 3006;
	3003 [label="你剛好讓我想起一件事，在扎日曼號上。我第一次遇到漠然的時候。",shape=box,color=red];
		3003 -> 3007;
	3004 [label="也許人們只是比較不那麼害怕了？",shape=box,color=red];
		3004 -> 3008;
	3005 [label="我還以為太陽和太陰是你們的神祇。",shape=box,color=red];
		3005 -> 3009;
	3006 [label="對他們來說，神祇就像天氣一樣真實，而且對他們也同樣不在乎。",shape=box,color=blue];
		3006 -> 3010;
	3007 [label="當然，我當時不知道那是什麼。不過，我記得當時它說過什麼。",shape=box,color=red];
		3007 -> 3011;
	3008 [label="是的，我想是因為這個原因。",shape=box,color=blue];
		3008 -> 3012;
	3009 [label="嗯，是，衪們是啊。但衪們也只是天體而已。",shape=box,color=blue];
		3009 -> 3013;
	3010 [label="老實說，聽起來和 Orokin 統治下的生活沒什麼差別。",shape=box,color=red];
		3010 -> 3014;
	3011 [label="我說它可以帶走我的光，然後它就對著我詭笑說，「謝啦，小鬼。我想我會的」。",shape=box,color=red];
		3011 -> 3015;
	3012 [label="我想我也知道為什麼了。",shape=box,color=blue];
		3012 -> 3016;
	3013 [label="就像不列坦尼亞是個國家，有名字和特色等等，但它也就只是一片土地和土石而已。它同時可以兩者皆是。",shape=box,color=blue];
		3013 -> 3017;
	3014 [label="不會死，又卑鄙，掌權是因為他們本來就掌權……",shape=box,color=red];
		3014 -> 3018;
	3015 [label="哦，天哪，你讓我全身顫抖",shape=box,color=blue];
		3015 -> 3019;
	3016 [label="這一切都與光有關。",shape=box,color=blue];
		3016 -> 3020;
	3017 [label="你可以在一個陽光明媚的美好日子外出，心懷感激，仰望太陽說一聲，「謝謝！」。你是真心實意的。那是正常人類會做的事。",shape=box,color=blue];
		3017 -> 3021;
	3018 [label="沒錯。你們有活生生的神祇。但你們把衪們都殺了。",shape=box,color=blue];
		3018 -> 3022;
	3019 [label="在所有古老的民間傳說中，魔鬼就藏在法律文件的細節裡",shape=box,color=blue];
		3019 -> 3023;
	3020 [label="在任何人想到把衪們當作神祇之前，太陽和太陰究竟是什麼？衪們是光。",shape=box,color=blue];
		3020 -> 3024;
		3020 -> 3025;
	3021 [label="但現今不會有人認為太陽或太陰真的讓某某人類婦女懷孕，或衪們懷上了某個人類男人的孩子，而國王就是這樣誕生的。",shape=box,color=blue];
		3021 -> 3026;
	3022 [label="別誤會，我為你感到高興。",shape=box,color=blue];
		3022 -> 3027;
	3023 [label="你有沒有覺得它是不是認為你向它承諾了某件東西？你的「光」？",shape=box,color=blue];
		3023 -> 3028;
		3023 -> 3029;
	3024 [label="是的。無論身處何方，光明始終象徵良善。",shape=box,color=red];
		3024 -> 3030;
	3025 [label="這是人類長久以來唯一擁有的光源。",shape=box,color=red];
		3025 -> 3030;
	3026 [label="人們曾經相信那種東西。現今的我們知道那些故事止於傳說。我們已經超脫了這套想法。",shape=box,color=blue];
		3026 -> 3031;
		3026 -> 3032;
	3027 [label="你把我和那小子搞混了。我從來沒有參與那場大型的 Tenno 叛亂。",shape=box,color=red];
		3027 -> 3033;
	3028 [label="它說我們達成了一筆「交易」。所以我想它認為我欠了它……什麼東西。",shape=box,color=red];
		3028 -> 3034;
	3029 [label="我指的是我攜帶的燈球，但誰知道它指的是什麼。",shape=box,color=red];
		3029 -> 3034;
	3030 [label="是的。",shape=box,color=blue];
		3030 -> 3035;
	3031 [label="神祇和人類……走到一起？",shape=box,color=red];
		3031 -> 3036;
	3032 [label="神祇為雙親的國王？我還以為 Orokin 才是混蛋呢。",shape=box,color=red];
		3032 -> 3036;
	3033 [label="從來就沒有參與過 Margulis 的特殊孩童計劃，從來就沒有獲得過Warframe，從來就沒有參與過遠古之戰。",shape=box,color=red];
		3033 -> 3037;
	3034 [label="至少我知道關於它的一件事。就是它愛耍花招。",shape=box,color=red];
		3034 -> 3038;
	3035 [label="但是後來某個洞穴宅，大概被某個大隻洞穴女欺負了，就想出了整個雙石互相敲擊的把戲，不敲不知道，一敲不得了。",shape=box,color=blue];
		3035 -> 3039;
	3036 [label="哦，這種事稀鬆平常。全世界都有發生。",shape=box,color=blue];
		3036 -> 3040;
	3037 [label="……那麼你會想嗎？",shape=box,color=blue];
		3037 -> 3041;
		3037 -> 3042;
		3037 -> 3043;
	3038 [label="+20 Chemistry",color=orange];
		3038 -> 3044;
	3039 [label="要光有光！完全不必看老天臉色賜的光！",shape=box,color=blue];
		3039 -> 3045;
	3040 [label="想像一下，你是某個狂妄祭司，飄洋過海向新世界當地的「野人」傳教太陽的福音，結果發現他們不僅已經知道有關太陽的一切了，他們還有太陽的親生兒子來統治他們。",shape=box,color=blue];
		3040 -> 3046;
	3041 [label="我真的不知道。",shape=box,color=red];
		3041 -> 3047;
	3042 [label="老實說，不會欸。",shape=box,color=red];
		3042 -> 3048;
	3043 [label="當然，我超想。",shape=box,color=red];
		3043 -> 3049;
	3044 [label="好的。無論你今天做什麼，無論你和誰在一起，無論是我還是亞瑟還是我們之中的任何人……都要注意安全。",shape=box,color=blue];
		3044 -> 3050;
	3045 [label="如今看看我們。光無處不在。是我們讓它失去了價值。",shape=box,color=blue];
		3045 -> 3003;
	3046 [label="你會夾著尾巴迅速返航，或者就地皈依。",shape=box,color=blue];
		3046 -> 3051;
		3046 -> 3052;
	3047 [label="那很合理。我尊重這點。",shape=box,color=blue];
		3047 -> 3057;
	3048 [label="我很高興。如果你覺得你的生活可能會變得比現在更糟，那我想我們就有值得慶祝的理由了，是吧？",shape=box,color=blue];
		3048 -> 3057;
	3049 [label="我想，我能夠理解。那你錯過了很多大場面，不是嗎？",shape=box,color=blue];
		3049 -> 3057;
	3050 [label="Check boolean EleanorDating",color=orange];
		3050 -> 3054 [label=true,color=green];
		3050 -> 3055 [label=false,color=brown];
	3051 [label="不過，你真的認為神祇是真實存在的嗎？還是只是你害怕衪們可能真實存在的這種想法？",shape=box,color=red];
		3051 -> 3056;
	3052 [label="好的。所以你是說，如果以前的人們一直都是對的那會怎樣？",shape=box,color=red];
		3052 -> 3056;
	3057 [label="Check boolean EleanorDating",color=orange];
		3057 -> 3053 [label=true,color=green];
		3057 -> 3310 [label=false,color=brown];
	3054 [label="我愛你。任何試圖阻撓我們的神明最好向眾神之神或什麼的鬼東西祈禱。",shape=box,color=blue];
		3054 -> 3058;
	3055 [label="你是我親愛的朋友。任何試圖從我身邊帶走你的神明都將發現其現實受到嚴峻考驗。",shape=box,color=blue];
		3055 -> 3059;
	3056 [label="這麼說好了，我曾經對物質枯燥乏味的實體現實比現在更有信心。",shape=box,color=blue];
		3056 -> 3060;
	3053 [label="+20 Chemistry",color=orange];
		3053 -> 3061;
	3310 [label="+20 Chemistry",color=orange];
		3310 -> 3062;
	3058 [label="Chat ends.",color=orange];
	3059 [label="Chat ends.",color=orange];
	3060 [label="而自信曾經所在的位置，如今留下了漂泊者形狀的空洞。",shape=box,color=blue];
		3060 -> 3063;
	3061 [label="我的愛人，我們都背負著自己的傷疤。",shape=box,color=blue];
		3061 -> 3064;
	3062 [label="我的朋友，我們都背負著自己的傷疤。",shape=box,color=blue];
		3062 -> 3065;
	3063 [label="+20 Chemistry",color=orange];
		3063 -> 3066;
	3064 [label="Chat ends.",color=orange];
	3065 [label="Chat ends.",color=orange];
	3066 [label="老實說？我並不懷念這些東西，真的。偶爾對各種可能性感到驚訝也挺不錯。",shape=box,color=blue];
		3066 -> 3067;
	3067 [label="Chat ends.",color=orange];
}