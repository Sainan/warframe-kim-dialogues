digraph {
	2607 [label="EleanorRank5Convo7 begins.",color=orange];
		2607 -> 2608;
	2608 [label="「漠然」到底是它的本質，還是它想要的？",shape=box,color=blue];
		2608 -> 2609;
		2608 -> 2610;
		2608 -> 2611;
	2609 [label="你知道，你跟莉蒂都是這樣。你忘記說「你好」了。",shape=box,color=red];
		2609 -> 2613;
	2610 [label="大部份人都會說聲「你好」。",shape=box,color=red];
		2610 -> 2614;
	2611 [label="[無視]",shape=box,color=red];
		2611 -> 2612;
	2613 [label="你找到我們的共通點了，恭喜你。還有抱歉。不過這件事更重要。",shape=box,color=blue];
		2613 -> 2615;
	2614 [label="抱歉。不過這件事更重要。",shape=box,color=blue];
		2614 -> 2615;
	2612 [label="Chat ends.",color=orange];
	2615 [label="不知怎地我覺得「無比漠然」想對我們挑撥離間。",shape=box,color=blue];
		2615 -> 2616;
	2616 [label="不要笑。我可以感覺到它，在我的骨髓深處。露莎卡的那個東西可高興看到我們把彼此碎屍萬段。",shape=box,color=blue];
		2616 -> 2617;
	2617 [label="我不知道什麼原因。我有直覺。",shape=box,color=blue];
		2617 -> 2618;
		2617 -> 2619;
	2618 [label="對啊。我想你是對的。",shape=box,color=red];
		2618 -> 2620;
	2619 [label="也許這就是源拓氏家族的遭遇。他們多年來一直住在他的實驗室頂上，但他們自己都不知道。當那個孩子找到他們時，他們如陌路人，沉浸在怨恨之中。",shape=box,color=red];
		2619 -> 2620;
	2620 [label="我在你的腦中看過。阿爾布雷希特跟 Loid。母親和父親。你跟你的父母。據我們所知，露莎卡跟維克多。當然還有我們六個人。",shape=box,color=blue];
		2620 -> 2621;
	2621 [label="這東西冷酷無情。變態。但它背後某部份是有動機的。",shape=box,color=blue];
		2621 -> 2622;
		2621 -> 2623;
	2622 [label="我想你是對的。在扎日曼號上，父母首先失去了理智。也許堅守者之所以能撐這麼久是因為他們都沒有孩子。",shape=box,color=red];
		2622 -> 2627;
	2623 [label="我不喜歡裝我瞭解*神靈*。它玩意試著瞭解情感。不過它不太懂玩它手上的玩具。",shape=box,color=red];
		2623 -> 2624;
	2627 [label="就讓它對我們挑撥離間吧。所以日尊幫幫我吧，我會解決它。我會找到辦法的。",shape=box,color=blue];
		2627 -> 2628;
	2624 [label="非常好的理論，但我們無法確定，不是嗎？",shape=box,color=blue];
		2624 -> 2625;
	2628 [label="宇宙中有一些東西它無法抗衡的力量。我全身的每一粒原子都相信是真的。",shape=box,color=blue];
		2628 -> 2629;
	2625 [label="如果你是對的，它就是無辜的了。幾乎像個小孩子一樣。這跟我們認知的不符。它是有惡意的。",shape=box,color=blue];
		2625 -> 2626;
	2629 [label="如果它把我整個人吞下去的話，我就會卡住它的喉嚨並噎死它。",shape=box,color=blue];
		2629 -> 2630;
		2629 -> 2631;
	2626 [label="Chat ends.",color=orange];
	2630 [label="好一個死法。",shape=box,color=red];
		2630 -> 2632;
	2631 [label="我還不知道我們要怎麼做，但我認同你。我們一定要贏。",shape=box,color=red];
		2631 -> 2635;
	2632 [label="反正在這種情況下我已經死了。",shape=box,color=blue];
		2632 -> 2633;
	2635 [label="如果這是一個故事的話，你會想出一些聰明花招。你會挖出巨人的石頭心臟，然後用天鵝羽毛把它割破，或者誘導它自己跳下懸崖。",shape=box,color=blue];
		2635 -> 2636;
	2633 [label="但至少我可以對著它眼睛吐口水。",shape=box,color=blue];
		2633 -> 2634;
	2636 [label="你說過你是「記者」。這些不是你以前講的那種故事，對嗎？你說的是實話，不管現實有多醜陋。",shape=box,color=red];
		2636 -> 2637;
	2634 [label="Chat ends.",color=orange];
	2637 [label="如果那些古老的故事沒有講真話，人們就不會一直流傳下去。",shape=box,color=blue];
		2637 -> 2638;
	2638 [label="我並不是說巨人是真的。我只是說古老的故事敘述了不同的真相。",shape=box,color=blue];
		2638 -> 2639;
		2638 -> 2640;
	2639 [label="我們需要的不只是童話故事來度過這個難關，無論它們有多鼓舞人心都好。",shape=box,color=red];
		2639 -> 2641;
	2640 [label="我生活在一個由故事組成的王國裡。我瞭解他們的力量有多強大。",shape=box,color=red];
		2640 -> 2643;
	2641 [label="我知道。我希望我除了直覺之外還有其他資訊。",shape=box,color=blue];
		2641 -> 2642;
	2643 [label="我認為所有這些巨人殺手故事的共同點是：它們都是說怎樣學懂規矩並想方法如何巧妙地運用它們。",shape=box,color=blue];
		2643 -> 2644;
	2642 [label="我們正在面對一些巨大的、可怕的、超乎我們所理解的事物。一般來說只有小孩子才能做到的。這就是童話故事存在的原因。",shape=box,color=blue];
		2642 -> 2645;
		2642 -> 2646;
	2644 [label="有些怪物很蠢的。有些需透過文字表達。有些擁有秘密。但除非你瞭解怪物遵守的規則，否則你贏不了。",shape=box,color=blue];
		2644 -> 2645;
		2644 -> 2646;
	2645 [label="它卡在牆上了。我甚至不知道那面牆是什麼。",shape=box,color=red];
		2645 -> 2647;
	2646 [label="我不覺得漠然會受任何規則的約束。",shape=box,color=red];
		2646 -> 2649;
	2647 [label="沒關係。如果它真的卡住了，那麼我們便可以推斷出兩件事，不是嗎？",shape=box,color=blue];
		2647 -> 2651;
	2649 [label="一定有！就算是神也有規矩要遵守！不管漠然表面有多強大，它都不是神。",shape=box,color=blue];
		2649 -> 2650;
	2651 [label="一，我們可以捕捉它。甚至可以囚禁它。",shape=box,color=blue];
		2651 -> 2653;
	2650 [label="你打敗了戰魁。不管你失敗了受挫多少次都不重要。你是後贏了。為什麼你不能打敗牆中人呢？",shape=box,color=blue];
		2650 -> 2648;
	2653 [label="+15 Chemistry",color=orange];
		2653 -> 2652;
	2648 [label="你什麼時候不再怕它了，愛琳娜？",shape=box,color=red];
		2648 -> 2655;
	2652 [label="而第二，它想得到某些東西。它想出去。如果我們知道它想要什麼，我們就已經領先它一步了。",shape=box,color=blue];
		2652 -> 2654;
	2655 [label="我沒有。",shape=box,color=blue];
		2655 -> 2657;
	2654 [label="Chat ends.",color=orange];
	2657 [label="+20 Chemistry",color=orange];
		2657 -> 2656;
	2656 [label="我只是更害怕會失去你，好嗎？",shape=box,color=blue];
		2656 -> 2658;
	2658 [label="Chat ends.",color=orange];
}