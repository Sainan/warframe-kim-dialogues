		2043 -> 2046 [label=false,color=brown];
		2043 -> 2047 [label=false,color=brown];
	2042 [label="Chat ends.",color=orange];
	2045 [label="嘿愛琳娜？你還記得阿米爾正在炮製的棋盤遊戲嗎？《寓言與先驅》？",shape=box,color=red];
		2045 -> 2044;
	2046 [label="嘿愛琳娜？你和阿米爾關係很好，對嗎？",shape=box,color=red];
		2046 -> 2048;
	2047 [label="你喜歡棋盤遊戲，對吧？",shape=box,color=red];
		2047 -> 2049;
	2044 [label="是的。那個你說會浪費時間的事，你只是出於同情他而跟他一起，就是那個，對嗎？",shape=box,color=blue];
		2044 -> 2050;
		2044 -> 2052;
		2044 -> 2053;
	2048 [label="他是個迷人的小惡魔。為什麼你這樣問？",shape=box,color=blue];
		2048 -> 2055;
		2048 -> 2056;
	2049 [label="我想，跟其他人一樣吧。為什麼這樣問？",shape=box,color=blue];
		2049 -> 2055;
		2049 -> 2056;
	2050 [label="哎呀。好吧。你還在生氣。明白。",shape=box,color=red];
		2050 -> 2051;
	2052 [label="我當時覺得你對這遊戲來說「太酷了」所以不屑一顧，而我只是想假裝我也是。現在我更知道怎樣做了。",shape=box,color=red];
		2052 -> 2054;
	2053 [label="對啊，我……我只是想為這件事道歉，我……我不是那個意思。我只是怕你會拒絕。",shape=box,color=red];
		2053 -> 2062;
	2055 [label="阿米爾正召集團隊一起玩《寓言與先驅》遊戲，我說我會幫忙。",shape=box,color=red];
		2055 -> 2057;
	2056 [label="阿米爾真的很想跟大家一起玩《寓言與先驅》。你玩嗎？",shape=box,color=red];
		2056 -> 2057;
	2051 [label="Chat ends.",color=orange];
	2054 [label="那麼我們之中是哪一個人對遊戲來說不再「太酷了」呢？是你還是我？",shape=box,color=blue];
		2054 -> 2058;
		2054 -> 2059;
		2054 -> 2060;
	2062 [label="我們一生中都曾經歷過這樣的時訓……試著戴上面具來給別人留下深刻印象，但卻因為看不到自己要去哪裡而摔倒。而當時你問我的時候，你跟我才剛認識。好吧。我原諒你了。",shape=box,color=blue];
		2062 -> 2067;
	2057 [label="啊。我明白了。你是被雷王選中的信差，來招募美麗的愛琳娜。毫無疑問，有各種各樣的鬧劇在等著我。這些那些的。",shape=box,color=blue];
		2057 -> 2063;
		2057 -> 2064;
	2058 [label="你。我依然認為這是一個愚蠢的遊戲，但怎樣也好。",shape=box,color=red];
		2058 -> 2061;
	2059 [label="我。肯定是我。你對這個遊戲來說還是太酷了。但我是個十足的書呆子，至少崑西是這樣說的。",shape=box,color=red];
		2059 -> 2062;
	2060 [label="……兩個都是？",shape=box,color=red];
		2060 -> 2062;
	2067 [label="老實說，用搞笑的聲音表演幾個小時聽起來很好玩。算我一起吧。",shape=box,color=blue];
		2067 -> 2068;
	2063 [label="老實說，我認為這會很有趣。而且這對他來說似乎意義重大。",shape=box,color=red];
		2063 -> 2067;
	2064 [label="對啊，我認為這完全是浪費時間，不過我想表現得友善一點。",shape=box,color=red];
		2064 -> 2065;
	2061 [label="Chat ends.",color=orange];
	2068 [label="噢！我會想做個巫師。或者是一個吟遊詩人。或者兩樣都試試？你可以兩個都做嗎？",shape=box,color=blue];
		2068 -> 2069;
	2065 [label="我會幫你一個忙不把這些話轉達給他。不過給你個忠告：將來在我面前多尊重他一點。",shape=box,color=blue];
		2065 -> 2066;
	2069 [label="或者我可以做個沼澤女巫！只要我可以穿緊身衣的話我就不介意。苔蘚媽會吃掉妳的骨頭，小東西。",shape=box,color=blue];
		2069 -> 2077;
	2066 [label="Chat ends.",color=orange];
	2077 [label="+20 Chemistry",color=orange];
