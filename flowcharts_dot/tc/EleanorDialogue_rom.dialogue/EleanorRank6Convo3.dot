digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"EleanorRank6Convo3 begins." [color=orange];
		"EleanorRank6Convo3 begins." -> j1281846630;
	j1281846630 [label="我不知道你有沒有注意到，但發生了一件非常精彩的事。",shape=box,color=blue];
		j1281846630 -> j3541209374;
	j3541209374 [label="亞瑟又開始唱歌了。感謝眾神明。",shape=box,color=blue];
		j3541209374 -> j4129920665;
		j3541209374 -> j2600457020;
		j3541209374 -> j1255369515;
	j4129920665 [label="那他之前為什麼不唱了？",shape=box,color=red];
		j4129920665 -> j2929446365;
	j2600457020 [label="我算不上粉絲，但如果這樣能讓他開心的話……",shape=box,color=red];
		j2600457020 -> j1948270431;
	j1255369515 [label="我很高興。他很會唱。",shape=box,color=red];
		j1255369515 -> j1741541453;
	j2929446365 [label="表演焦慮。就這麼簡單。",shape=box,color=blue];
		j2929446365 -> j1040075194;
	j1948270431 [label="謝謝你這麼委婉地表明這點。",shape=box,color=blue];
		j1948270431 -> j1388184526;
	j1741541453 [label="不是嗎？",shape=box,color=blue];
		j1741541453 -> j4112224829;
	j1040075194 [label="很難相信像亞瑟這麼勇敢的人都會怕成那樣。",shape=box,color=red];
		j1040075194 -> j2331984583;
	j1388184526 [label="你的關心我看在眼裡。",shape=box,color=blue];
		j1388184526 -> j3241876415;
	j4112224829 [label="當我想到他站在人群面前唱歌所付出的一切努力……",shape=box,color=blue];
		j4112224829 -> j4272925538;
	j2331984583 [label="他是因為什麼而感到自卑？",shape=box,color=red];
		j2331984583 -> j3367774290;
	j3241876415 [label="尤其是他放棄唱歌是有原因的，而這些原因你是不可能事先知道。",shape=box,color=blue];
		j3241876415 -> j3640698136;
		j3241876415 -> j978306078;
	j4272925538 [label="……我想說的是，那是他第一次真正沒了勇氣。",shape=box,color=blue];
		j4272925538 -> j674819574;
	j3367774290 [label="是他的姓名。這就是該死的問題所在。",shape=box,color=blue];
		j3367774290 -> j2343443685;
	j3640698136 [label="精神支持不夠嗎？",shape=box,color=red];
		j3640698136 -> j962165120;
	j978306078 [label="觀眾太難伺候了嗎？",shape=box,color=red];
		j978306078 -> j962165120;
	j674819574 [label="八零年代的冬至頌歌音樂會。想像一下我們的小男孩穿著短褲，獨唱《晨露多明亮》。",shape=box,color=blue];
		j674819574 -> j2203758516;
		j674819574 -> j1918430190;
	j2343443685 [label="「哦，你的姓氏是夜鶯是嗎，哈哈，那給我們唱首歌吧」",shape=box,color=blue];
		j2343443685 -> j182819793;
	j962165120 [label="更像是，被開同個玩笑，聽都聽煩了。",shape=box,color=blue];
		j962165120 -> j3367774290;
	j2203758516 [label="那畫面很有臨場感。",shape=box,color=red];
		j2203758516 -> j3267601137;
	j1918430190 [label="我沒聽過那首。",shape=box,color=red];
		j1918430190 -> j508056166;
	j182819793 [label="不同白癡，同個句字，騷擾了我們一輩子。現在就連維克多也這樣鬧。",shape=box,color=blue];
		j182819793 -> j2471969720;
	j3267601137 [label="他非常認真看待這件事。連續好幾週都在練習，然後在當晚，他怯場了。他躲在側台不肯登台。",shape=box,color=blue];
		j3267601137 -> j69506925;
		j3267601137 -> j1040075194;
	j508056166 [label="嗯。我可以唱給你聽，但我不確定如果我唱的話會跑出什麼樣的聲音。",shape=box,color=blue];
		j508056166 -> j561333673;
	j2471969720 [label="+5 Chemistry",color=orange];
		j2471969720 -> j559909195;
	j69506925 [label="你是怎麼說服他的？",shape=box,color=red];
		j69506925 -> j658420450;
	j561333673 [label="該死的科腐者。我試著為葵唱生日快樂歌，唱出來就像夾在碎紙機裡的牛蛙一樣。",shape=box,color=blue];
		j561333673 -> j3587889165;
	j559909195 [label="老實說，我為亞瑟有勇氣去唱而感到驕傲。",shape=box,color=blue];
		j559909195 -> "Chat ends.";
	j658420450 [label="我其實教訓了他一頓。自己也是千百個不願意。但不得不這麼做。",shape=box,color=blue];
		j658420450 -> j1762365905;
	j3587889165 [label="很抱歉。不能再唱歌肯定很難受。",shape=box,color=red];
		j3587889165 -> j3562205642;
	"Chat ends." [color=orange];
	j1762365905 [label="重點是，他做的所有那些練習不是為了我們父母或是讓亨肖夫人高興。",shape=box,color=blue];
		j1762365905 -> j1092311786;
	j3562205642 [label="哦，這也沒什麼好可惜的。反正我本來就不會唱就是了。",shape=box,color=blue];
		j3562205642 -> j1108843610;
	j1092311786 [label="他唱歌是因為他真心喜歡。但當聚光燈打在他身上時，他就僵住了。",shape=box,color=blue];
		j1092311786 -> j3146667215;
		j1092311786 -> j2331984583;
	j1108843610 [label="我最接近唱的一次是在我臥室裡大喊大叫幹砲樂團的歌詞，因為我好想加入曼蒂・潔麗蔻的樂團，因為我超迷戀她。",shape=box,color=blue];
		j1108843610 -> j174829522;
	j3146667215 [label="或許他只需要想起他有多愛唱歌這件事。",shape=box,color=red];
		j3146667215 -> j193277440;
	j174829522 [label="我爸不堪其擾跑來狂敲房門威脅說，如果讓他再聽到那些下流的髒話，就要用煤酚皂把我嘴洗乾淨。",shape=box,color=blue];
		j174829522 -> j1671265604;
	j193277440 [label="亞瑟最快樂的時候是忘掉怎麼當亞瑟。當他能夠與自己和解，他就能真正做到忘我做自己。",shape=box,color=blue];
		j193277440 -> j146799879;
	j1671265604 [label="我不知道你來的那裡有沒有龐克樂，但不會唱更像是條件而不是缺陷。",shape=box,color=blue];
		j1671265604 -> j3102913981;
		j1671265604 -> j3427411079;
	j146799879 [label="啤酒有幫助。",shape=box,color=blue];
		j146799879 -> j831422420;
	j3102913981 [label="我們沒有龐克樂，但我們有斯階樂。",shape=box,color=red];
		j3102913981 -> j2978876660;
	j3427411079 [label="那樂隊後來怎麼了？",shape=box,color=red];
		j3427411079 -> j246100287;
	j831422420 [label="而且，如果亞瑟能夠從目錄中選擇一個父親的話，韋利米爾表現得像亞瑟會挑選的那個，這肯定有益無害。",shape=box,color=blue];
		j831422420 -> j360165285;
		j831422420 -> j979310363;
	j2978876660 [label="你休想在聊天對話中丟下這種話題然後不多加說明。",shape=box,color=blue];
		j2978876660 -> j629543732;
	j246100287 [label="他們甚至沒有到達「在當地酒吧同情演出」的階段。",shape=box,color=blue];
		j246100287 -> j2747987341;
	j360165285 [label="這我不怪他。",shape=box,color=red];
		j360165285 -> j2128539505;
	j979310363 [label="我本以為韋利米爾和米娜瓦有點太像你的親生父母了。",shape=box,color=red];
		j979310363 -> j1371823859;
	j629543732 [label="我要求你告訴我斯階樂是什麼。",shape=box,color=blue];
		j629543732 -> j1404435067;
	j2747987341 [label="聽說曼蒂打算向觀眾吐口水，然後就這樣沒戲了。真可惜。",shape=box,color=blue];
		j2747987341 -> j4179206746;
		j2747987341 -> j1696427054;
	j2128539505 [label="亞瑟隨身帶著那隻泰迪熊已經好幾個月了。現在韋利米爾出現了。好像命運感覺到亞瑟生活中缺少一個熊形的身影……",shape=box,color=blue];
		j2128539505 -> j3551723906;
	j1371823859 [label="嗯，是啊。也許那些拌嘴讓他感覺像在家一樣自在。",shape=box,color=blue];
		j1371823859 -> j3005071692;
	j1404435067 [label="因為它聽起來像是在拉德斯頓住宅區裡用小夾鏈袋在賣的東西。",shape=box,color=blue];
		j1404435067 -> j3063278831;
		j1404435067 -> j2796547695;
	j4179206746 [label="誰會介意那一點口水？",shape=box,color=red];
		j4179206746 -> j2155336103;
	j1696427054 [label="口水？聽起來像技改細胞勾瘩體對美好夜晚的想法。",shape=box,color=red];
		j1696427054 -> j2051479692;
	j3551723906 [label="+5 Chemistry",color=orange];
		j3551723906 -> j2399426624;
	j3005071692 [label="+5 Chemistry",color=orange];
		j3005071692 -> j665858806;
	j3063278831 [label="就像音樂，只不過你基本上是透過敲打管線、還有通風口、還有 Corpus 頭盔、還有任何你能找到可以敲打的東西，來製作這種風格的音樂。",shape=box,color=red];
		j3063278831 -> j3572251398;
	j2796547695 [label="這只是無意義的噪音。只有通風小子喜歡這種樂風。",shape=box,color=red];
		j2796547695 -> j4096479998;
	j2155336103 [label="+5 Chemistry",color=orange];
		j2155336103 -> j3143281300;
	j2051479692 [label="那是個不同的年代。當時龐克還是真正的龐克。",shape=box,color=blue];
		j2051479692 -> j223980654;
	j2399426624 [label="……抱歉。我無權妄加揣測。我只是很高興他很開心而已。",shape=box,color=blue];
		j2399426624 -> "Chat ends.";
	j665858806 [label="能夠讓你想家的東西有時還蠻奇怪的，不覺得嗎？",shape=box,color=blue];
		j665858806 -> "Chat ends.";
	j3572251398 [label="這是通風小子的樂風。",shape=box,color=red];
		j3572251398 -> j673328254;
	j4096479998 [label="蛤。「無意義的噪音」。我以前聽過這種說法。",shape=box,color=blue];
		j4096479998 -> j502926343;
	j3143281300 [label="我完全不介意，這點我篤定。",shape=box,color=blue];
		j3143281300 -> j223980654;
	j223980654 [label="……我只是想到，「我希望她能看到現在的我」。我想她會喜歡這個版本的我。",shape=box,color=blue];
		j223980654 -> j524369700;
	j673328254 [label="+5 Chemistry",color=orange];
		j673328254 -> j2368958746;
	j502926343 [label="我不認為有什麼事情是無意義到不能成為某人青春歲月的配樂。",shape=box,color=blue];
		j502926343 -> j1439918442;
	j524369700 [label="天啊，看看我，我變得感性又懷舊了。",shape=box,color=blue];
		j524369700 -> j3275259483;
	j2368958746 [label="嗯。聽起來像求生樂。如果你有機會幫我錄製幾首曲子，我不介意聽聽看。",shape=box,color=blue];
		j2368958746 -> j3134989727;
	j1439918442 [label="我還是最好停下來好了。我開始變得感傷了。",shape=box,color=blue];
		j1439918442 -> "Chat ends.";
	j3275259483 [label="+5 Chemistry",color=orange];
		j3275259483 -> j1091777612;
	j3134989727 [label="不過，最好還是別在商場的揚聲器上播放了。",shape=box,color=blue];
		j3134989727 -> "Chat ends.";
	j1091777612 [label="還是回去忙好了。謝謝你洗耳恭聽。",shape=box,color=blue];
		j1091777612 -> "Chat ends.";
}