digraph {
	2888 [label="EleanorRank6Convo3 begins.",color=orange];
		2888 -> 2889;
	2889 [label="我不知道你有沒有注意到，但發生了一件非常精彩的事。",shape=box,color=blue];
		2889 -> 2890;
	2890 [label="亞瑟又開始唱歌了。感謝眾神明。",shape=box,color=blue];
		2890 -> 2891;
		2890 -> 2892;
		2890 -> 2893;
	2891 [label="那他之前為什麼不唱了？",shape=box,color=red];
		2891 -> 2894;
	2892 [label="我算不上粉絲，但如果這樣能讓他開心的話……",shape=box,color=red];
		2892 -> 2895;
	2893 [label="我很高興。他很會唱。",shape=box,color=red];
		2893 -> 2896;
	2894 [label="表演焦慮。就這麼簡單。",shape=box,color=blue];
		2894 -> 2897;
	2895 [label="謝謝你這麼委婉地表明這點。",shape=box,color=blue];
		2895 -> 2898;
	2896 [label="不是嗎？",shape=box,color=blue];
		2896 -> 2899;
	2897 [label="很難相信像亞瑟這麼勇敢的人都會怕成那樣。",shape=box,color=red];
		2897 -> 2900;
	2898 [label="你的關心我看在眼裡。",shape=box,color=blue];
		2898 -> 2901;
	2899 [label="當我想到他站在人群面前唱歌所付出的一切努力……",shape=box,color=blue];
		2899 -> 2902;
	2900 [label="他是因為什麼而感到自卑？",shape=box,color=red];
		2900 -> 2903;
	2901 [label="尤其是他放棄唱歌是有原因的，而這些原因你是不可能事先知道。",shape=box,color=blue];
		2901 -> 2904;
		2901 -> 2905;
	2902 [label="……我想說的是，那是他第一次真正沒了勇氣。",shape=box,color=blue];
		2902 -> 2906;
	2903 [label="是他的姓名。這就是該死的問題所在。",shape=box,color=blue];
		2903 -> 2907;
	2904 [label="精神支持不夠嗎？",shape=box,color=red];
		2904 -> 2908;
	2905 [label="觀眾太難伺候了嗎？",shape=box,color=red];
		2905 -> 2908;
	2906 [label="八零年代的冬至頌歌音樂會。想像一下我們的小男孩穿著短褲，獨唱《晨露多明亮》。",shape=box,color=blue];
		2906 -> 2909;
		2906 -> 2910;
	2907 [label="「哦，你的姓氏是夜鶯是嗎，哈哈，那給我們唱首歌吧」",shape=box,color=blue];
		2907 -> 2911;
	2908 [label="更像是，被開同個玩笑，聽都聽煩了。",shape=box,color=blue];
		2908 -> 2903;
	2909 [label="那畫面很有臨場感。",shape=box,color=red];
		2909 -> 2912;
	2910 [label="我沒聽過那首。",shape=box,color=red];
		2910 -> 2913;
	2911 [label="不同白癡，同個句字，騷擾了我們一輩子。現在就連維克多也這樣鬧。",shape=box,color=blue];
		2911 -> 2914;
	2912 [label="他非常認真看待這件事。連續好幾週都在練習，然後在當晚，他怯場了。他躲在側台不肯登台。",shape=box,color=blue];
		2912 -> 2915;
		2912 -> 2897;
	2913 [label="嗯。我可以唱給你聽，但我不確定如果我唱的話會跑出什麼樣的聲音。",shape=box,color=blue];
		2913 -> 2916;
	2914 [label="+5 Chemistry",color=orange];
		2914 -> 2917;
	2915 [label="你是怎麼說服他的？",shape=box,color=red];
		2915 -> 2918;
	2916 [label="該死的科腐者。我試著為葵唱生日快樂歌，唱出來就像夾在碎紙機裡的牛蛙一樣。",shape=box,color=blue];
		2916 -> 2919;
	2917 [label="老實說，我為亞瑟有勇氣去唱而感到驕傲。",shape=box,color=blue];
		2917 -> 2920;
	2918 [label="我其實教訓了他一頓。自己也是千百個不願意。但不得不這麼做。",shape=box,color=blue];
		2918 -> 2921;
	2919 [label="很抱歉。不能再唱歌肯定很難受。",shape=box,color=red];
		2919 -> 2922;
	2920 [label="Chat ends.",color=orange];
	2921 [label="重點是，他做的所有那些練習不是為了我們父母或是讓亨肖夫人高興。",shape=box,color=blue];
		2921 -> 2923;
	2922 [label="哦，這也沒什麼好可惜的。反正我本來就不會唱就是了。",shape=box,color=blue];
		2922 -> 2924;
	2923 [label="他唱歌是因為他真心喜歡。但當聚光燈打在他身上時，他就僵住了。",shape=box,color=blue];
		2923 -> 2925;
		2923 -> 2900;
	2924 [label="我最接近唱的一次是在我臥室裡大喊大叫幹砲樂團的歌詞，因為我好想加入曼蒂・潔麗蔻的樂團，因為我超迷戀她。",shape=box,color=blue];
		2924 -> 2926;
	2925 [label="或許他只需要想起他有多愛唱歌這件事。",shape=box,color=red];
		2925 -> 2927;
	2926 [label="我爸不堪其擾跑來狂敲房門威脅說，如果讓他再聽到那些下流的髒話，就要用煤酚皂把我嘴洗乾淨。",shape=box,color=blue];
		2926 -> 2928;
	2927 [label="亞瑟最快樂的時候是忘掉怎麼當亞瑟。當他能夠與自己和解，他就能真正做到忘我做自己。",shape=box,color=blue];
		2927 -> 2929;
	2928 [label="我不知道你來的那裡有沒有龐克樂，但不會唱更像是條件而不是缺陷。",shape=box,color=blue];
		2928 -> 2930;
		2928 -> 2931;
	2929 [label="啤酒有幫助。",shape=box,color=blue];
		2929 -> 2932;
	2930 [label="我們沒有龐克樂，但我們有斯階樂。",shape=box,color=red];
		2930 -> 2933;
	2931 [label="那樂隊後來怎麼了？",shape=box,color=red];
		2931 -> 2934;
	2932 [label="而且，如果亞瑟能夠從目錄中選擇一個父親的話，韋利米爾表現得像亞瑟會挑選的那個，這肯定有益無害。",shape=box,color=blue];
		2932 -> 2935;
		2932 -> 2936;
	2933 [label="你休想在聊天對話中丟下這種話題然後不多加說明。",shape=box,color=blue];
		2933 -> 2937;
	2934 [label="他們甚至沒有到達「在當地酒吧同情演出」的階段。",shape=box,color=blue];
		2934 -> 2938;
	2935 [label="這我不怪他。",shape=box,color=red];
		2935 -> 2939;
	2936 [label="我本以為韋利米爾和米娜瓦有點太像你的親生父母了。",shape=box,color=red];
		2936 -> 2940;
	2937 [label="我要求你告訴我斯階樂是什麼。",shape=box,color=blue];
		2937 -> 2941;
	2938 [label="聽說曼蒂打算向觀眾吐口水，然後就這樣沒戲了。真可惜。",shape=box,color=blue];
		2938 -> 2942;
		2938 -> 2943;
	2939 [label="亞瑟隨身帶著那隻泰迪熊已經好幾個月了。現在韋利米爾出現了。好像命運感覺到亞瑟生活中缺少一個熊形的身影……",shape=box,color=blue];
		2939 -> 2944;
	2940 [label="嗯，是啊。也許那些拌嘴讓他感覺像在家一樣自在。",shape=box,color=blue];
		2940 -> 2945;
	2941 [label="因為它聽起來像是在拉德斯頓住宅區裡用小夾鏈袋在賣的東西。",shape=box,color=blue];
		2941 -> 2946;
		2941 -> 2947;
	2942 [label="誰會介意那一點口水？",shape=box,color=red];
		2942 -> 2948;
	2943 [label="口水？聽起來像技改細胞勾瘩體對美好夜晚的想法。",shape=box,color=red];
		2943 -> 2949;
	2944 [label="+5 Chemistry",color=orange];
		2944 -> 2950;
	2945 [label="+5 Chemistry",color=orange];
		2945 -> 2951;
	2946 [label="就像音樂，只不過你基本上是透過敲打管線、還有通風口、還有 Corpus 頭盔、還有任何你能找到可以敲打的東西，來製作這種風格的音樂。",shape=box,color=red];
		2946 -> 2952;
	2947 [label="這只是無意義的噪音。只有通風小子喜歡這種樂風。",shape=box,color=red];
		2947 -> 2953;
	2948 [label="+5 Chemistry",color=orange];
		2948 -> 2954;
	2949 [label="那是個不同的年代。當時龐克還是真正的龐克。",shape=box,color=blue];
		2949 -> 2955;
	2950 [label="……抱歉。我無權妄加揣測。我只是很高興他很開心而已。",shape=box,color=blue];
		2950 -> 3311;
	2951 [label="能夠讓你想家的東西有時還蠻奇怪的，不覺得嗎？",shape=box,color=blue];
		2951 -> 2956;
	2952 [label="這是通風小子的樂風。",shape=box,color=red];
		2952 -> 2957;
	2953 [label="蛤。「無意義的噪音」。我以前聽過這種說法。",shape=box,color=blue];
		2953 -> 2958;
	2954 [label="我完全不介意，這點我篤定。",shape=box,color=blue];
		2954 -> 2955;
	2955 [label="……我只是想到，「我希望她能看到現在的我」。我想她會喜歡這個版本的我。",shape=box,color=blue];
		2955 -> 2959;
	3311 [label="Chat ends.",color=orange];
	2956 [label="Chat ends.",color=orange];
	2957 [label="+5 Chemistry",color=orange];
		2957 -> 2960;
	2958 [label="我不認為有什麼事情是無意義到不能成為某人青春歲月的配樂。",shape=box,color=blue];
		2958 -> 2961;
	2959 [label="天啊，看看我，我變得感性又懷舊了。",shape=box,color=blue];
		2959 -> 2962;
	2960 [label="嗯。聽起來像求生樂。如果你有機會幫我錄製幾首曲子，我不介意聽聽看。",shape=box,color=blue];
		2960 -> 2963;
	2961 [label="我還是最好停下來好了。我開始變得感傷了。",shape=box,color=blue];
		2961 -> 2964;
	2962 [label="+5 Chemistry",color=orange];
		2962 -> 2965;
	2963 [label="不過，最好還是別在商場的揚聲器上播放了。",shape=box,color=blue];
		2963 -> 2966;
	2964 [label="Chat ends.",color=orange];
	2965 [label="還是回去忙好了。謝謝你洗耳恭聽。",shape=box,color=blue];
		2965 -> 2967;
	2966 [label="Chat ends.",color=orange];
	2967 [label="Chat ends.",color=orange];
