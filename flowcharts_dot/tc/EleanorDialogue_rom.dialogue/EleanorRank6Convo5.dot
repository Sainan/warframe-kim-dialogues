digraph {
	"EleanorRank6Convo5 begins." [color=orange];
		"EleanorRank6Convo5 begins." -> j2741862621;
	j2741862621 [label="我在想，一如往常地那樣……",shape=box,color=blue];
		j2741862621 -> j3468291044;
	j3468291044 [label="一旦這個循環最終關閉後，不管怎樣發生，地球接下來會怎樣？",shape=box,color=blue];
		j3468291044 -> j3868913301;
	j3868913301 [label="我知道 2000 年對你來說已經是相當遙遠的過去了，但你能告訴我關於我們這個小星球在未來會發生的任何事嗎？",shape=box,color=blue];
		j3868913301 -> j182255124;
		j3868913301 -> j308844768;
	j182255124 [label="情況恐怕不是很樂觀。",shape=box,color=red];
		j182255124 -> j3794302348;
	j308844768 [label="老實說，我覺得我不應該這麼做。",shape=box,color=red];
		j308844768 -> j1979578357;
	j3794302348 [label="據我所知，科腐者成了全球性問題。人們用核武器來解決牠們──又或至少試圖這麼做。",shape=box,color=red];
		j3794302348 -> j1432097044;
	j1979578357 [label="如果你預先知道即將發生的事情，你可能會試圖改變它，而這可能意味著我永遠沒有存在過。",shape=box,color=red];
		j1979578357 -> j2683399688;
	j1432097044 [label="第一次「輻射戰爭」就是這麼開始的。",shape=box,color=red];
		j1432097044 -> j964132416;
	j2683399688 [label="叫我自私也無妨，但我就喜歡存在。",shape=box,color=red];
		j2683399688 -> j3187909658;
	j964132416 [label="……而最終星球變得難以生活，以至於 Orokin 想要逃離，去別的地方生活，對吧？",shape=box,color=blue];
		j964132416 -> j1543746359;
	j3187909658 [label="哦？好像你做的所有事情都沒有在改變未來似的？",shape=box,color=blue];
		j3187909658 -> j2192603077;
	j1543746359 [label="……這導致了整個扎日曼事件，而你就是在這裡登場的。",shape=box,color=blue];
		j1543746359 -> j2600345871;
	j2192603077 [label="你可能改變了小細節，但基本上大局都沒有變。",shape=box,color=blue];
		j2192603077 -> j1292177086;
	j2600345871 [label="想起來就覺得很奇怪，這一切都是從這座城市開始的。",shape=box,color=blue];
		j2600345871 -> j2612045757;
		j2600345871 -> j2233064756;
	j1292177086 [label="我認為宇宙知道自己在做什麼。",shape=box,color=blue];
		j1292177086 -> j1470695583;
	j2612045757 [label="也許這就是為什麼這一年會這麼重要的部分原因。",shape=box,color=red];
		j2612045757 -> j1730190276;
	j2233064756 [label="是啊。從霍爾瓦尼亞到扎日曼 10-0 號。這條時間線貫穿發生過的一切。",shape=box,color=red];
		j2233064756 -> j3220301977;
	j1470695583 [label="除了看不見的粒子在無序運動之外，還有更多事情在悄然發生。",shape=box,color=blue];
		j1470695583 -> j1845166087;
		j1470695583 -> j3148726420;
	j1730190276 [label="+5 Chemistry",color=orange];
		j1730190276 -> j1859594833;
	j3220301977 [label="慢著……",shape=box,color=blue];
		j3220301977 -> j223640505;
	j1845166087 [label="我不同意你的觀點。宇宙是無意識的。",shape=box,color=red];
		j1845166087 -> j2409997276;
	j3148726420 [label="我同意。像人類情感這類東西都有可能塑造虛空……",shape=box,color=red];
		j3148726420 -> j3749760367;
	j1859594833 [label="有道理。如果阿爾布雷希特的核彈爆炸了，那是否意味著沒有科腐者，所以也沒有殘破不堪的地球，不需要逃離，沒有首次探索虛空之旅，也就沒有漠然？",shape=box,color=blue];
		j1859594833 -> j111242626;
	j223640505 [label="如果你搭的是扎日曼 10-0 號，那麼扎日曼 1-0 號到 9-0 號發生了什麼事？",shape=box,color=blue];
		j223640505 -> j2237173930;
	j2409997276 [label="或許從宏觀或微觀的角度來看是這樣，但不會是你我所存在的這個維度。",shape=box,color=blue];
		j2409997276 -> j1157304733;
	j3749760367 [label="+5 Chemistry",color=orange];
		j3749760367 -> j1172008193;
	j111242626 [label="……我要去看一下莉蒂有沒有泡好的咖啡。",shape=box,color=blue];
		j111242626 -> "Chat ends.";
	j2237173930 [label="我記得的話，是自動化無人機。",shape=box,color=red];
		j2237173930 -> j3266631735;
	j1157304733 [label="如果我們能夠賦予意義，而我們又是宇宙的一部分，那麼按照定義宇宙就是有意義的。",shape=box,color=blue];
		j1157304733 -> j3621234442;
	j1172008193 [label="確實。我們賦予的意義不僅僅是自我安慰的錯覺。",shape=box,color=blue];
		j1172008193 -> j2789123862;
	"Chat ends." [color=orange];
	j3266631735 [label="或是中樞駕駛的地球化改造艙。他們進行的實驗多不勝數。",shape=box,color=red];
		j3266631735 -> j663420244;
	j3621234442 [label="+5 Chemistry",color=orange];
		j3621234442 -> j1375227936;
	j2789123862 [label="但總會有那個聲音在你耳邊低語，堅持說這一些都不重要。",shape=box,color=blue];
		j2789123862 -> j1663964091;
	j663420244 [label="他們稱之為「計劃」。",shape=box,color=red];
		j663420244 -> j1716981115;
	j1375227936 [label="我們的存在並不比夸克或超新星更不真實或更不重要。無論接受與否，我們都很重要。",shape=box,color=blue];
		j1375227936 -> "Chat ends.";
	j1663964091 [label="也許宇宙大對決不是在善與惡之間，而是在有意義與無意義之間？",shape=box,color=blue];
		j1663964091 -> "Chat ends.";
	j1716981115 [label="+5 Chemistry",color=orange];
		j1716981115 -> j3421718553;
	j3421718553 [label="聽起來比「帶我們這些不負責任的老屁股到一個我們能夠繼續糟蹋的新星系」行動還要來得好聽。",shape=box,color=blue];
		j3421718553 -> "Chat ends.";
}