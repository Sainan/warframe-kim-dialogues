digraph {
	3068 [label="EleanorRank6Convo5 begins.",color=orange];
		3068 -> 3069;
	3069 [label="我在想，一如往常地那樣……",shape=box,color=blue];
		3069 -> 3070;
	3070 [label="一旦這個循環最終關閉後，不管怎樣發生，地球接下來會怎樣？",shape=box,color=blue];
		3070 -> 3071;
	3071 [label="我知道 2000 年對你來說已經是相當遙遠的過去了，但你能告訴我關於我們這個小星球在未來會發生的任何事嗎？",shape=box,color=blue];
		3071 -> 3072;
		3071 -> 3074;
	3072 [label="情況恐怕不是很樂觀。",shape=box,color=red];
		3072 -> 3073;
	3074 [label="老實說，我覺得我不應該這麼做。",shape=box,color=red];
		3074 -> 3076;
	3073 [label="據我所知，科腐者成了全球性問題。人們用核武器來解決牠們──又或至少試圖這麼做。",shape=box,color=red];
		3073 -> 3075;
	3076 [label="如果你預先知道即將發生的事情，你可能會試圖改變它，而這可能意味著我永遠沒有存在過。",shape=box,color=red];
		3076 -> 3078;
	3075 [label="第一次「輻射戰爭」就是這麼開始的。",shape=box,color=red];
		3075 -> 3077;
	3078 [label="叫我自私也無妨，但我就喜歡存在。",shape=box,color=red];
		3078 -> 3080;
	3077 [label="……而最終星球變得難以生活，以至於 Orokin 想要逃離，去別的地方生活，對吧？",shape=box,color=blue];
		3077 -> 3079;
	3080 [label="哦？好像你做的所有事情都沒有在改變未來似的？",shape=box,color=blue];
		3080 -> 3082;
	3079 [label="……這導致了整個扎日曼事件，而你就是在這裡登場的。",shape=box,color=blue];
		3079 -> 3081;
	3082 [label="你可能改變了小細節，但基本上大局都沒有變。",shape=box,color=blue];
		3082 -> 3085;
	3081 [label="想起來就覺得很奇怪，這一切都是從這座城市開始的。",shape=box,color=blue];
		3081 -> 3083;
		3081 -> 3084;
	3085 [label="我認為宇宙知道自己在做什麼。",shape=box,color=blue];
		3085 -> 3088;
	3083 [label="也許這就是為什麼這一年會這麼重要的部分原因。",shape=box,color=red];
		3083 -> 3086;
	3084 [label="是啊。從霍爾瓦尼亞到扎日曼 10-0 號。這條時間線貫穿發生過的一切。",shape=box,color=red];
		3084 -> 3087;
	3088 [label="除了看不見的粒子在無序運動之外，還有更多事情在悄然發生。",shape=box,color=blue];
		3088 -> 3091;
		3088 -> 3092;
	3086 [label="+5 Chemistry",color=orange];
		3086 -> 3089;
	3087 [label="慢著……",shape=box,color=blue];
		3087 -> 3090;
	3091 [label="我不同意你的觀點。宇宙是無意識的。",shape=box,color=red];
		3091 -> 3095;
	3092 [label="我同意。像人類情感這類東西都有可能塑造虛空……",shape=box,color=red];
		3092 -> 3096;
	3089 [label="有道理。如果阿爾布雷希特的核彈爆炸了，那是否意味著沒有科腐者，所以也沒有殘破不堪的地球，不需要逃離，沒有首次探索虛空之旅，也就沒有漠然？",shape=box,color=blue];
		3089 -> 3093;
	3090 [label="如果你搭的是扎日曼 10-0 號，那麼扎日曼 1-0 號到 9-0 號發生了什麼事？",shape=box,color=blue];
		3090 -> 3094;
	3095 [label="或許從宏觀或微觀的角度來看是這樣，但不會是你我所存在的這個維度。",shape=box,color=blue];
		3095 -> 3099;
	3096 [label="+5 Chemistry",color=orange];
		3096 -> 3100;
	3093 [label="……我要去看一下莉蒂有沒有泡好的咖啡。",shape=box,color=blue];
		3093 -> 3097;
	3094 [label="我記得的話，是自動化無人機。",shape=box,color=red];
		3094 -> 3098;
	3099 [label="如果我們能夠賦予意義，而我們又是宇宙的一部分，那麼按照定義宇宙就是有意義的。",shape=box,color=blue];
		3099 -> 3102;
	3100 [label="確實。我們賦予的意義不僅僅是自我安慰的錯覺。",shape=box,color=blue];
		3100 -> 3103;
	3097 [label="Chat ends.",color=orange];
	3098 [label="或是中樞駕駛的地球化改造艙。他們進行的實驗多不勝數。",shape=box,color=red];
		3098 -> 3101;
	3102 [label="+5 Chemistry",color=orange];
		3102 -> 3105;
	3103 [label="但總會有那個聲音在你耳邊低語，堅持說這一些都不重要。",shape=box,color=blue];
		3103 -> 3106;
	3101 [label="他們稱之為「計劃」。",shape=box,color=red];
		3101 -> 3104;
	3105 [label="我們的存在並不比夸克或超新星更不真實或更不重要。無論接受與否，我們都很重要。",shape=box,color=blue];
		3105 -> 3108;
	3106 [label="也許宇宙大對決不是在善與惡之間，而是在有意義與無意義之間？",shape=box,color=blue];
		3106 -> 3109;
	3104 [label="+5 Chemistry",color=orange];
		3104 -> 3107;
	3108 [label="Chat ends.",color=orange];
	3109 [label="Chat ends.",color=orange];
	3107 [label="聽起來比「帶我們這些不負責任的老屁股到一個我們能夠繼續糟蹋的新星系」行動還要來得好聽。",shape=box,color=blue];
		3107 -> 3110;
	3110 [label="Chat ends.",color=orange];
}