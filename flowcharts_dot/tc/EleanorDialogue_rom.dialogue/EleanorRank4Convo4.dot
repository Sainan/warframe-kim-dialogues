digraph {
	1700 [label="EleanorRank4Convo4 begins.",color=orange];
		1700 -> 1701;
		1700 -> 1702;
		1700 -> 1703;
	1701 [label="你跟莉蒂曾經是朋友嗎？",shape=box,color=red];
		1701 -> 1704;
	1702 [label="這是一個頗親密的群組。你們有人跟六煞幫的其他人約會過嗎？",shape=box,color=red];
		1702 -> 1705;
	1703 [label="如果亞瑟跟某人開始浪漫關係，你會有什麼反應？",shape=box,color=red];
		1703 -> 1706;
	1704 [label="噢天哪，對。有一段時間我們親密得形影不離。",shape=box,color=blue];
		1704 -> 1707;
	1705 [label="這個問題有點私人，老友，不過我會接受你這樣問。你跟我們一起有一段時間了。你有權利了解這地盤的情況。",shape=box,color=blue];
		1705 -> 1708;
	1706 [label="你不是指某個在一百萬英里之外的人吧，是嗎？",shape=box,color=blue];
		1706 -> 1709;
	1707 [label="當然，那是在源拓氏之前。",shape=box,color=blue];
		1707 -> 1710;
	1708 [label="除了亞瑟跟葵約會之外？沒有，反正據我所知……而我肯定什麼都知道的。",shape=box,color=blue];
		1708 -> 1711;
	1709 [label="不用回答。",shape=box,color=blue];
		1709 -> 1712;
	1710 [label="現在她表現得好像我是不同的人一樣。對她來說有好處。如果我不是真正的愛琳娜的話，那麼她可以隨心所欲地傷害我，因為她沒有傷害她認識的人。我認為這是懦弱的舉動。",shape=box,color=blue];
		1710 -> 1715;
	1711 [label="而假如你正在考慮對我們其中的任何人出手的話……",shape=box,color=blue];
		1711 -> 1713;
	1712 [label="如果我知道他們清楚自己在做什麼並且對那個人有真摯的情感，我會很高興。肯定會。",shape=box,color=blue];
		1712 -> 1714;
	1715 [label="但她依然希望你能從這件事復原過來，對嗎？",shape=box,color=red];
		1715 -> 1723;
	1713 [label="……你能贏得昆西的信任已不錯了。他的目光銳利得很。也許你可以寫下筆記作參考。",shape=box,color=blue];
		1713 -> 1716;
	1714 [label="但我想確保他們知道要傷害他有多容易。",shape=box,color=blue];
		1714 -> 1719;
	1723 [label="噢，拜托。在那發生之前我便會長出翅膀和尾巴了。",shape=box,color=blue];
		1723 -> 1724;
	1716 [label="+5 Chemistry",color=orange];
		1716 -> 1717;
	1719 [label="那些外表全是盔甲跟高姿態但裡面全部是柔軟，軟綿綿的有機體的機器人東西是什麼？",shape=box,color=blue];
		1719 -> 1718;
		1719 -> 1720;
		1719 -> 1721;
	1724 [label="源拓氏已經滾蛋了。如果曾經有希望找回昔日的愛琳娜，那個在淋浴時唱歌，對街上的孩子們微笑的人，那麼那個希望被他帶走了。",shape=box,color=blue];
		1724 -> 1728;
		1724 -> 1729;
	1717 [label="Chat ends.",color=orange];
	1718 [label="索拉里斯？",shape=box,color=red];
		1718 -> 1722;
	1720 [label="毒命者？",shape=box,color=red];
		1720 -> 1722;
	1721 [label="Sentient？",shape=box,color=red];
		1721 -> 1722;
	1728 [label="莉蒂需要照照鏡子，明白她距離失去人性只有幾天的時間了。",shape=box,color=red];
		1728 -> 1730;
	1729 [label="如果亞瑟認為你仍然是他的姐姐的話，那對莉蒂來說也同樣。",shape=box,color=red];
		1729 -> 1731;
	1722 [label="都不重要。重點是，亞瑟就是這樣的人。",shape=box,color=blue];
		1722 -> 1725;
	1730 [label="你是想博取我的好感嗎？",shape=box,color=blue];
		1730 -> 1732;
	1731 [label="你以為。",shape=box,color=blue];
		1731 -> 1733;
	1725 [label="如果他對你心房大開，看在日尊的份上，對他溫柔一些。",shape=box,color=blue];
		1725 -> 1726;
	1732 [label="我意思是，對。她想。",shape=box,color=blue];
		1732 -> 1734;
	1733 [label="莉蒂愛慕亞瑟。他是她從未有過的哥哥。如果亞瑟不在的話，我醒來時就會發現嘴上蓋著一塊哥羅芳抹布，然後沉到河底。",shape=box,color=blue];
		1733 -> 1735;
	1726 [label="+5 Chemistry",color=orange];
		1726 -> 1727;
	1734 [label="我依然還未原諒她所說的讓這座城市被燒毀的言論。",shape=box,color=blue];
		1734 -> 1736;
	1735 [label="她認為他有妄想症，對過去耿耿於懷。但她愛他而且她是一名好士兵，所以她永遠不會背叛他。",shape=box,color=blue];
		1735 -> 1737;
		1735 -> 1738;
	1727 [label="Chat ends.",color=orange];
	1736 [label="甚至連葵都感到震驚。這讓你去想誰才是真正的怪物，對不對？",shape=box,color=blue];
		1736 -> 1737;
		1736 -> 1738;
	1737 [label="她到底為什麼這麼憎恨你？",shape=box,color=red];
		1737 -> 1739;
	1738 [label="真的只是舌頭的問題讓她感到恐懼嗎？還是那個讀心術？",shape=box,color=red];
		1738 -> 1739;
	1739 [label="很複雜的。不只一個原因。",shape=box,color=blue];
		1739 -> 1740;
	1740 [label="她當面告訴我，我不能在她的腦裡窺探。如果我不同意，她就會離開六煞幫並自己承擔風險。瘋狂言論。",shape=box,color=blue];
		1740 -> 1741;
	1741 [label="其實部分原因只是她害怕我會閱讀她青少年時期的日記。我會窺視她最尷尬的秘密並哈哈大笑而她將永遠抬不起頭。",shape=box,color=blue];
		1741 -> 1742;
	1742 [label="事實上，我真的沒有那麼八卦。無論她對我隱瞞了什麼噁心的小秘密，都是安全的。",shape=box,color=blue];
		1742 -> 1743;
		1742 -> 1744;
	1743 [label="你們兩個曾經有過……一個浪漫的歷史嗎？",shape=box,color=red];
		1743 -> 1745;
	1744 [label="你覺得可能她喜歡你嗎？",shape=box,color=red];
		1744 -> 1746;
	1745 [label="你認為我會泄露天機嗎？",shape=box,color=blue];
		1745 -> 1747;
	1746 [label="我曾經這樣想過。",shape=box,color=blue];
		1746 -> 1748;
	1747 [label="沒有。我們沒有。",shape=box,color=blue];
		1747 -> 1749;
	1748 [label="我想我其實會願意的。朋友之間親吻撫摸並沒有什麼問題，特別是如果亞瑟不得不在簡報會上給我們做一次尷尬的演講，關於我們怎樣不能讓我們的感情妨礙我們的工作。",shape=box,color=blue];
		1748 -> 1750;
	1749 [label="那是件好事，因為你可以想像我們之間現在會有多尷尬嗎？",shape=box,color=blue];
		1749 -> 1751;
	1750 [label="它可以排解壓力，有利於士氣，而且成本低廉。",shape=box,color=blue];
		1750 -> 1752;
	1751 [label="我的意思是……我當時不會拒絕的。只是從未發生過這個情節。",shape=box,color=blue];
		1751 -> 1755;
	1752 [label="但無論加西亞女士在隱瞞什麼，都是一些別人可以用來傷害她的東西。所以我是一個威脅，因為我可能會在她的腦海中看到這個東西。",shape=box,color=blue];
		1752 -> 1754;
	1755 [label="+10 Chemistry",color=orange];
		1755 -> 1753;
	1754 [label="等下，亞瑟跟葵不是一對嗎？",shape=box,color=red];
		1754 -> 1757;
	1753 [label="那如果你對她動心了，那就去吧！我會為你打氣的！太陰知道莉蒂在她那黯淡無愛的生活需要一些快樂。",shape=box,color=blue];
		1753 -> 1756;
	1757 [label="為什麼？你對我弟弟有什麼居心嗎？還是對葵？",shape=box,color=blue];
		1757 -> 1758;
		1757 -> 1759;
		1757 -> 1760;
	1756 [label="Chat ends.",color=orange];
	1758 [label="那。嗯。其實……",shape=box,color=red];
		1758 -> 1761;
	1759 [label="呃……不…我其實是對*你*有居心……",shape=box,color=red];
		1759 -> 1762;
	1760 [label="不了。哈哈。他們不是我那杯茶，抱歉。太「英雄本色」了。",shape=box,color=red];
		1760 -> 1801;
	1761 [label="噢！噢！快娓娓道來……",shape=box,color=blue];
		1761 -> 1764;
		1761 -> 1765;
	1762 [label="有趣。",shape=box,color=blue];
		1762 -> 1793;
	1801 [label="+20 Chemistry",color=orange];
		1801 -> 1763;
	1764 [label="亞瑟。",shape=box,color=red];
		1764 -> 1766;
	1765 [label="葵。",shape=box,color=red];
		1765 -> 1767;
	1793 [label="抱歉，這可能不是你期望聽到的回覆，對嗎？",shape=box,color=blue];
		1793 -> 1794;
	1763 [label="哈哈哈",shape=box,color=blue];
		1763 -> 1798;
	1766 [label="我就知道。",shape=box,color=blue];
		1766 -> 1768;
	1767 [label="我一點都不怪你。",shape=box,color=blue];
		1767 -> 1770;
	1794 [label="那。",shape=box,color=blue];
		1794 -> 1795;
	1798 [label="硬朗瀟灑的亞瑟？純潔善良的葵？他們隨便一個都無法讓你心動嗎？",shape=box,color=blue];
		1798 -> 1799;
	1768 [label="我不忍心告訴你你讓自己陷入了什麼處境。這條路你自己走吧。",shape=box,color=blue];
		1768 -> 1769;
	1770 [label="我知道她外表看起來純潔得不太真實，但相信我，她跟我們其他人一樣是個士兵。",shape=box,color=blue];
		1770 -> 1771;
	1795 [label="再看吧。",shape=box,color=blue];
		1795 -> 1796;
	1799 [label="非常有趣。",shape=box,color=blue];
		1799 -> 1800;
	1769 [label="我們說清楚一點：玩弄亞瑟是我才有的特權。如果你蓄意傷害他的話，我會殺了你。還有一件事……",shape=box,color=blue];
		1769 -> 1772;
	1771 [label="瞭解真正的葵，而不是你腦海中對她的任何印象，你就會沒事的。還有……",shape=box,color=blue];
		1771 -> 1772;
	1796 [label="+5 Chemistry",color=orange];
		1796 -> 1797;
	1800 [label="我們下次再說這個話題，她說，用潮紅色的斗篷圍住她的臉龐並離開了……",shape=box,color=blue];
		1800 -> 1802;
	1772 [label="亞瑟跟葵的關係是這場衝突的首要受害者之一。他們兩個都還未復原。這是一個開放性傷口，所以要小心。",shape=box,color=blue];
		1772 -> 1773;
		1772 -> 1774;
	1797 [label="Chat ends.",color=orange];
	1802 [label="Chat ends.",color=orange];
	1773 [label="他們為什麼會分手？",shape=box,color=red];
		1773 -> 1775;
	1774 [label="我看不到他們開花結果的可能。",shape=box,color=red];
		1774 -> 1791;
	1775 [label="你為什麼這麼問？",shape=box,color=blue];
		1775 -> 1776;
		1775 -> 1777;
	1791 [label="+10 Chemistry",color=orange];
		1791 -> 1788;
	1776 [label="一些無聊的八卦沒有什麼大礙。",shape=box,color=red];
		1776 -> 1778;
	1777 [label="瞭解一下會有所幫助，這樣我就不會在任何開放性傷口上撒鹽了。",shape=box,color=red];
		1777 -> 1786;
	1788 [label="嗯，你並不是唯一一個這樣想的人。",shape=box,color=blue];
		1788 -> 1789;
	1778 [label="嗯。我不認同。",shape=box,color=blue];
		1778 -> 1779;
	1786 [label="+20 Chemistry",color=orange];
		1786 -> 1782;
	1789 [label="但你不會走到傷心的人面前說「我早就告訴過你了」。你們會團結起來。我盡可能安慰亞瑟，而莉蒂則試圖修補葵受傷的心。",shape=box,color=blue];
		1789 -> 1790;
	1779 [label="葵是我的朋友。而不管亞瑟有多傻，他依然是我的兄弟。",shape=box,color=blue];
		1779 -> 1780;
	1782 [label="好的。我不知道他們會告訴你什麼東西，但從我的角度來看，他們當時向不同的方向進發。",shape=box,color=blue];
		1782 -> 1783;
	1790 [label="小心行事。我只是想這樣說。",shape=box,color=blue];
		1790 -> 1792;
	1780 [label="我不肯定我是否應該向你透露任何事情。",shape=box,color=blue];
		1780 -> 1781;
	1783 [label="他們都是浪漫主義者，只是不同路線。亞瑟想要一間門圍著玫瑰的鄉村小屋。他口口聲聲說不是，但他其實心裡很渴望。",shape=box,color=blue];
		1783 -> 1784;
	1792 [label="Chat ends.",color=orange];
	1781 [label="Chat ends.",color=orange];
	1784 [label="天哪，他有時甚至曾經說過要接手一家酒吧。我可以想像他跟他的一小群常客，一邊喝著啤酒，一邊做星期天的烤肉，充斥著得來不易的智慧。",shape=box,color=blue];
		1784 -> 1785;
	1785 [label="你可以想像葵在這樣的夢裡有個適合她的位置嗎？我不能。她需要振翅高飛。",shape=box,color=blue];
		1785 -> 1787;
	1787 [label="Chat ends.",color=orange];
}