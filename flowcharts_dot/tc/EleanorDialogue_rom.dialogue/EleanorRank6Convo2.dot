digraph {
	"EleanorRank6Convo2 begins." [color=orange];
		"EleanorRank6Convo2 begins." -> j1644586884;
	j1644586884 [label="嘿。想要聽取一下你的意見。",shape=box,color=blue];
		j1644586884 -> j752251480;
	j752251480 [label="在想關於萬惡夜的事。我已經好幾年沒有特別裝扮了，但我在翻閱阿米爾的一本漫畫時突然想到──等一下，我可以裝扮成女伯爵！我已經有獠牙還有其它什麼的通通都有了！",shape=box,color=blue];
		j752251480 -> j2145284014;
	j2145284014 [label="但那樣會不會太明顯了？還是我應該裝扮成丹迪・達美吉呢？
",shape=box,color=blue];
		j2145284014 -> j2652202695;
		j2145284014 -> j1934423668;
		j2145284014 -> j286858574;
	j2652202695 [label="誰是丹迪・達美吉？",shape=box,color=red];
		j2652202695 -> j2354338464;
	j1934423668 [label="如果你想讓人困惑的話，你總是可以扮成 Lotus。",shape=box,color=red];
		j1934423668 -> j2972827243;
	j286858574 [label="……你得告訴我什麼是萬惡夜。",shape=box,color=red];
		j286858574 -> j198150241;
	j2354338464 [label="哦，夥計。",shape=box,color=blue];
		j2354338464 -> j2745155618;
	j2972827243 [label="噢，我的天啊，那樣肯定不行了。我在你腦海裡見過她。我永遠都無法重現她的風采。",shape=box,color=blue];
		j2972827243 -> j3721235001;
	j198150241 [label="哦。有時候我會忘記你是個天真的外來人。",shape=box,color=blue];
		j198150241 -> j101005393;
	j2745155618 [label="丹迪・達美吉開闢道路好讓 Temple 和撕裂者能夠大展身手。他是每位母親的噩夢，也是每名迷茫青少年的美夢。",shape=box,color=blue];
		j2745155618 -> j2394863831;
	j3721235001 [label="還有那頂頭盔。那是頭盔嗎？是她身體的一部分嗎？她是怎麼透過它看東西的？",shape=box,color=blue];
		j3721235001 -> j3842717345;
	j101005393 [label="萬惡夜慶祝的是太陽對世界的影響力消退的時節。",shape=box,color=blue];
		j101005393 -> j2099565913;
	j2394863831 [label="身材像竹節蟲，妝容像默片女王。嘴唇像糖果。細直條紋、皮革和狗鏈。顴骨像骷髏的髖骨。",shape=box,color=blue];
		j2394863831 -> j3573415898;
		j2394863831 -> j1405119290;
	j3842717345 [label="不管怎樣，她是三位一體。我永遠都無法從她們之中選出其中一個。",shape=box,color=blue];
		j3842717345 -> j3573415898;
		j3842717345 -> j1405119290;
	j2099565913 [label="這乍看之下，沒什麼道理。為什麼要慶祝黑暗的崛起？為什麼要歡慶無法無天的混亂？",shape=box,color=blue];
		j2099565913 -> j3690111700;
	j3573415898 [label="裝扮？狂歡？在戰區裡？你真的以為這種事會發生嗎？",shape=box,color=red];
		j3573415898 -> j1927003813;
	j1405119290 [label="你知道嗎，萬惡夜聽起來很像納貝流士之夜。人們也喜歡在那個節日特別裝扮。",shape=box,color=red];
		j1405119290 -> j1927003813;
	j3690111700 [label="我覺得這就像疫苗接種，也許吧。我們透過一小部分恐懼的事物來強化自己。又或這只是戴上惡魔面具、大肆狂歡的藉口。",shape=box,color=blue];
		j3690111700 -> j3573415898;
		j3690111700 -> j1405119290;
	j1927003813 [label="……我可能只是在耍白癡。我太幼稚了。對吧？",shape=box,color=blue];
		j1927003813 -> j1113144085;
	j1113144085 [label="哦，我到底在想什麼。",shape=box,color=blue];
		j1113144085 -> j2887848670;
	j2887848670 [label="我根本不需要裝扮，對吧？我已經是個怪物了。永永遠遠。",shape=box,color=blue];
		j2887848670 -> j2436064064;
	j2436064064 [label="Check boolean EleanorDating",color=orange];
		j2436064064 -> j1620996028 [label=true,color=green];
		j2436064064 -> j413497674 [label=true,color=green];
		j2436064064 -> j3186602716 [label=true,color=green];
		j2436064064 -> j413497674 [label=false,color=brown];
		j2436064064 -> j3186602716 [label=false,color=brown];
	j1620996028 [label="愛琳娜，你是我愛的怪物。我一點都不後悔。",shape=box,color=red];
		j1620996028 -> j1168924760;
	j413497674 [label="我開始覺得你還蠻喜歡這樣形容自己的。",shape=box,color=red];
		j413497674 -> j2882801564;
	j3186602716 [label="不。真正的怪物是不會像你那樣關心別人的。",shape=box,color=red];
		j3186602716 -> j3162712848;
	j1168924760 [label="+5 Chemistry",color=orange];
		j1168924760 -> j3105260676;
	j2882801564 [label="如果你真的認為那才是自己，那麼萬惡夜就是慶祝它的完美契機。",shape=box,color=red];
		j2882801564 -> j469605454;
		j2882801564 -> j3162712848;
	j3162712848 [label="我知道你害怕自己可能會變成的樣子。但那不是現在的你。",shape=box,color=red];
		j3162712848 -> j2291085451;
	j3105260676 [label="哦對！傻傻的我都忘了在我們的小故事裡怪物最終得到了幸福快樂的結局。",shape=box,color=blue];
		j3105260676 -> j1461570599;
	j469605454 [label="成為怪物。接受它。在一年之中的這一夜，驕傲地冠上那個頭銜。",shape=box,color=red];
		j469605454 -> j4136093717;
	j2291085451 [label="所以裝扮起來。玩得開心。虛空知道六煞幫全員需要歡樂一下。",shape=box,color=red];
		j2291085451 -> j3177512241;
	j1461570599 [label="原諒我。我還是不太敢相信這確實是你想要的。也許我只是需要多一點點的說服。",shape=box,color=blue];
		j1461570599 -> j3297633673;
	j4136093717 [label="哦，有太多理由說明這是個超爛的主意",shape=box,color=blue];
		j4136093717 -> j1105173676;
	j3177512241 [label="那我就接受你的提議了。還有謝謝你。又再一次。x",shape=box,color=blue];
		j3177512241 -> "Chat ends.";
	j3297633673 [label="我們晚點來吃一下對方吧。xxx",shape=box,color=blue];
		j3297633673 -> "Chat ends.";
	j1105173676 [label="太。多。了。",shape=box,color=blue];
		j1105173676 -> j834531599;
	"Chat ends." [color=orange];
	j834531599 [label="我現在想不出任何一個理由，但我相信有千百種",shape=box,color=blue];
		j834531599 -> j3392828955;
	j3392828955 [label="……可惡。",shape=box,color=blue];
		j3392828955 -> j4161452528;
	j4161452528 [label="你巧妙地利用我的言語來智取我。高招喔。好樣的。x",shape=box,color=blue];
		j4161452528 -> "Chat ends.";
}