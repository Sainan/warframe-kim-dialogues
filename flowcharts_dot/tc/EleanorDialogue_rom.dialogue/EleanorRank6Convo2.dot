digraph {
	2845 [label="EleanorRank6Convo2 begins.",color=orange];
		2845 -> 2846;
	2846 [label="嘿。想要聽取一下你的意見。",shape=box,color=blue];
		2846 -> 2847;
	2847 [label="在想關於萬惡夜的事。我已經好幾年沒有特別裝扮了，但我在翻閱阿米爾的一本漫畫時突然想到──等一下，我可以裝扮成女伯爵！我已經有獠牙還有其它什麼的通通都有了！",shape=box,color=blue];
		2847 -> 2848;
	2848 [label="但那樣會不會太明顯了？還是我應該裝扮成丹迪・達美吉呢？
",shape=box,color=blue];
		2848 -> 2849;
		2848 -> 2850;
		2848 -> 2851;
	2849 [label="誰是丹迪・達美吉？",shape=box,color=red];
		2849 -> 2852;
	2850 [label="如果你想讓人困惑的話，你總是可以扮成 Lotus。",shape=box,color=red];
		2850 -> 2853;
	2851 [label="……你得告訴我什麼是萬惡夜。",shape=box,color=red];
		2851 -> 2854;
	2852 [label="哦，夥計。",shape=box,color=blue];
		2852 -> 2855;
	2853 [label="噢，我的天啊，那樣肯定不行了。我在你腦海裡見過她。我永遠都無法重現她的風采。",shape=box,color=blue];
		2853 -> 2856;
	2854 [label="哦。有時候我會忘記你是個天真的外來人。",shape=box,color=blue];
		2854 -> 2857;
	2855 [label="丹迪・達美吉開闢道路好讓 Temple 和撕裂者能夠大展身手。他是每位母親的噩夢，也是每名迷茫青少年的美夢。",shape=box,color=blue];
		2855 -> 2858;
	2856 [label="還有那頂頭盔。那是頭盔嗎？是她身體的一部分嗎？她是怎麼透過它看東西的？",shape=box,color=blue];
		2856 -> 2859;
	2857 [label="萬惡夜慶祝的是太陽對世界的影響力消退的時節。",shape=box,color=blue];
		2857 -> 2860;
	2858 [label="身材像竹節蟲，妝容像默片女王。嘴唇像糖果。細直條紋、皮革和狗鏈。顴骨像骷髏的髖骨。",shape=box,color=blue];
		2858 -> 2861;
		2858 -> 2862;
	2859 [label="不管怎樣，她是三位一體。我永遠都無法從她們之中選出其中一個。",shape=box,color=blue];
		2859 -> 2861;
		2859 -> 2862;
	2860 [label="這乍看之下，沒什麼道理。為什麼要慶祝黑暗的崛起？為什麼要歡慶無法無天的混亂？",shape=box,color=blue];
		2860 -> 2863;
	2861 [label="裝扮？狂歡？在戰區裡？你真的以為這種事會發生嗎？",shape=box,color=red];
		2861 -> 2864;
	2862 [label="你知道嗎，萬惡夜聽起來很像納貝流士之夜。人們也喜歡在那個節日特別裝扮。",shape=box,color=red];
		2862 -> 2864;
	2863 [label="我覺得這就像疫苗接種，也許吧。我們透過一小部分恐懼的事物來強化自己。又或這只是戴上惡魔面具、大肆狂歡的藉口。",shape=box,color=blue];
		2863 -> 2861;
		2863 -> 2862;
	2864 [label="……我可能只是在耍白癡。我太幼稚了。對吧？",shape=box,color=blue];
		2864 -> 2865;
	2865 [label="哦，我到底在想什麼。",shape=box,color=blue];
		2865 -> 2866;
	2866 [label="我根本不需要裝扮，對吧？我已經是個怪物了。永永遠遠。",shape=box,color=blue];
		2866 -> 2867;
	2867 [label="Check boolean EleanorDating",color=orange];
		2867 -> 2868 [label=true,color=green];
		2867 -> 2869 [label=true,color=green];
		2867 -> 2870 [label=true,color=green];
		2867 -> 2869 [label=false,color=brown];
		2867 -> 2870 [label=false,color=brown];
	2868 [label="愛琳娜，你是我愛的怪物。我一點都不後悔。",shape=box,color=red];
		2868 -> 2871;
	2869 [label="我開始覺得你還蠻喜歡這樣形容自己的。",shape=box,color=red];
		2869 -> 2872;
	2870 [label="不。真正的怪物是不會像你那樣關心別人的。",shape=box,color=red];
		2870 -> 2873;
	2871 [label="+5 Chemistry",color=orange];
		2871 -> 2874;
	2872 [label="如果你真的認為那才是自己，那麼萬惡夜就是慶祝它的完美契機。",shape=box,color=red];
		2872 -> 2875;
		2872 -> 2873;
	2873 [label="我知道你害怕自己可能會變成的樣子。但那不是現在的你。",shape=box,color=red];
		2873 -> 2876;
	2874 [label="哦對！傻傻的我都忘了在我們的小故事裡怪物最終得到了幸福快樂的結局。",shape=box,color=blue];
		2874 -> 2877;
	2875 [label="成為怪物。接受它。在一年之中的這一夜，驕傲地冠上那個頭銜。",shape=box,color=red];
		2875 -> 2878;
	2876 [label="所以裝扮起來。玩得開心。虛空知道六煞幫全員需要歡樂一下。",shape=box,color=red];
		2876 -> 2879;
	2877 [label="原諒我。我還是不太敢相信這確實是你想要的。也許我只是需要多一點點的說服。",shape=box,color=blue];
		2877 -> 2880;
	2878 [label="哦，有太多理由說明這是個超爛的主意",shape=box,color=blue];
		2878 -> 2881;
	2879 [label="那我就接受你的提議了。還有謝謝你。又再一次。x",shape=box,color=blue];
		2879 -> 2882;
	2880 [label="我們晚點來吃一下對方吧。xxx",shape=box,color=blue];
		2880 -> 2883;
	2881 [label="太。多。了。",shape=box,color=blue];
		2881 -> 2884;
	2882 [label="Chat ends.",color=orange];
	2883 [label="Chat ends.",color=orange];
	2884 [label="我現在想不出任何一個理由，但我相信有千百種",shape=box,color=blue];
		2884 -> 2885;
	2885 [label="……可惡。",shape=box,color=blue];
		2885 -> 2886;
	2886 [label="你巧妙地利用我的言語來智取我。高招喔。好樣的。x",shape=box,color=blue];
		2886 -> 2887;
	2887 [label="Chat ends.",color=orange];
}