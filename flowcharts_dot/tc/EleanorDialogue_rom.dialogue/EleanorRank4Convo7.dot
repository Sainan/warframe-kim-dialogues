digraph {
	1953 [label="EleanorRank4Convo7 begins.",color=orange];
		1953 -> 1954;
	1954 [label="我想問你一些事，但我不知道你會有什麼反應，所以如果我越了界請告訴我。",shape=box,color=blue];
		1954 -> 1955;
	1955 [label="好。",shape=box,color=red];
		1955 -> 1956;
	1956 [label="你父母是怎樣的人？",shape=box,color=blue];
		1956 -> 1957;
		1956 -> 1958;
		1956 -> 1959;
		1956 -> 1960;
		1956 -> 1962;
	1957 [label="時間太久我都記不清楚了。",shape=box,color=red];
		1957 -> 1963;
	1958 [label="善良。他們努力好好的養育我。",shape=box,color=red];
		1958 -> 1965;
	1959 [label="嚴格。他們擁有絕對權利並確保我認識到這一點。",shape=box,color=red];
		1959 -> 1967;
	1960 [label="絕望。我還不如被野生庫狛養大。",shape=box,color=red];
		1960 -> 1972;
	1962 [label="我……不能討論這個話題。對不起。 [結束]",shape=box,color=red];
		1962 -> 1978;
	1963 [label="對不起。我愚蠢地假使，因為你對扎日曼的記憶如此清晰，所以你也能記起你的父母。",shape=box,color=blue];
		1963 -> 1964;
	1965 [label="我很慶幸。如果你不介意我這麼說的話，你身上反映出你的教養。",shape=box,color=blue];
		1965 -> 1966;
	1967 [label="我不認為你接受過溫和的教養。我想殖民者一定要堅強硬朗。",shape=box,color=blue];
		1967 -> 1970;
	1972 [label="噢親愛的。那，不管怎樣，你把自己變成一個正派得體的人了。",shape=box,color=blue];
		1972 -> 1973;
	1978 [label="不，對不起。我沒有權利去問。",shape=box,color=blue];
		1978 -> 1979;
	1964 [label="我忘記你已經存活了多少世代了。",shape=box,color=blue];
		1964 -> 1968;
	1966 [label="你內在有一股溫暖的善良火焰而我在想是誰助燃了它。",shape=box,color=blue];
		1966 -> 1969;
	1970 [label="有那些 Orokin 監管，有人能成長為一個正常人都是奇蹟。",shape=box,color=blue];
		1970 -> 1971;
	1973 [label="我只希望你這過程能輕鬆一點。",shape=box,color=blue];
		1973 -> 1974;
	1979 [label="Chat ends.",color=orange];
	1968 [label="Update boolean DrifterParentsUnknown",color=orange];
		1968 -> 1980;
	1969 [label="Update boolean DrifterParentsKind",color=orange];
		1969 -> 1980;
	1971 [label="Update boolean DrifterParentsStrict",color=orange];
		1971 -> 1980;
	1974 [label="Update boolean DrifterParentsUseless",color=orange];
		1974 -> 1980;
	1980 [label="你為什麼問？",shape=box,color=red];
		1980 -> 1981;
	1981 [label="我在想我的童年。其實我常常這樣做。我一屁股坐著，想知道爸爸媽媽會怎麼看他們的孩子的長大後的樣子",shape=box,color=blue];
		1981 -> 1982;
		1981 -> 1983;
	1982 [label="他們是什麼樣的人？",shape=box,color=red];
		1982 -> 1984;
	1983 [label="他們是什麼樣的父母？",shape=box,color=red];
		1983 -> 1985;
	1984 [label="以人的層面來說他們根本不匹配，即是說他們的關係在最初的幾年裡如火般熾熱明亮，之後崩塌瓦解成一個吞噬的黑洞。",shape=box,color=blue];
		1984 -> 1986;
	1985 [label="一句話，不適合。爸爸希望我們獨立，所以他會透過營造某些情景來訓練我們。給我們一把小刀就把我們丟到樹林裡，諸如此類的事情。媽媽總是來救援。這是注定行不通的。",shape=box,color=blue];
		1985 -> 1987;
	1986 [label="爸爸是退伍軍人。歡樂又佈滿皺紋的小眼睛，說話就像一個新聞廣播員，但他的內心千瘡百孔，如果你把他抱起來大力搖，他就會像一袋礫石般碰撞作響。他極為容易心煩意亂。我說了我覺得一些溫和的意見，之後聽到他在廁所裡哭。",shape=box,color=blue];
		1986 -> 1988;
	1987 [label="亞瑟跟我很快就學會怎樣叫他們對著幹。你知道的，小孩子那些行為。",shape=box,color=blue];
		1987 -> 1989;
	1988 [label="媽媽的家境富裕得多，也即是說她擁有很多自由。她沒有走上那些派對之路，沒有喝酒，吸毒，也沒有在拉德斯頓的公寓裡狂歡一週。那更像是珍妮絲姨姨會做的事。媽媽更喜歡鮮花，陶刺蝟，百花香，喜歡漂亮溫馨的東西。",shape=box,color=blue];
		1988 -> 1990;
	1989 [label="父母總是會過度彌補他們認為他們自己的父母做得不好的地方，不是嗎？",shape=box,color=blue];
		1989 -> 1990;
	1990 [label="你說的一半話像是虛空語般，不想我想我聽懂了。",shape=box,color=red];
		1990 -> 1991;
	1991 [label="那，他們現在離婚了。出於「考量」，他們等到我們十幾歲的時候才這樣做。那真善良，你不覺得嗎？逼迫我們住在一個他媽的戰場屋裡，就因為小孩子需要安穩或之類的垃圾。",shape=box,color=blue];
		1991 -> 1992;
	1992 [label="那你們還有聯絡嗎？",shape=box,color=red];
		1992 -> 1993;
	1993 [label="偶爾。我們以前常回家過冬至。那真叫我掛念。裝飾星樹，給日尊加冕，小孩子們打扮成太陰的三種面貌逐家逐戶地敲門，烤雞……雖然說這很傷他悶透，但我真的很喜歡這些回憶。",shape=box,color=blue];
		1993 -> 1994;
	1994 [label="爸爸媽媽總是在冬至那天簽訂和平協議而他們總會遵守。如果那一年幸運的話，即使一直喝著李子白蘭地，他們也只能遵守到第三天便互相撕殺。",shape=box,color=blue];
		1994 -> 1995;
	1995 [label="如果你剛剛感覺到一股巨大的思鄉之情席捲你的話，那是我。對不起。",shape=box,color=blue];
		1995 -> 1996;
	1996 [label="我努力把強烈的情緒獨自承受，但有時它就像鍋裡沸騰的牛奶滿瀉出來，然後每個人都會承擔。然後開密道歉。",shape=box,color=blue];
		1996 -> 1997;
	1997 [label="為什麼現在提起他們？",shape=box,color=red];
		1997 -> 1998;
	1998 [label="我只是在想他們怎樣看你。如果我們離開這個地方，我想跟我的時空旅行朋友一起吃冬至晚餐。",shape=box,color=blue];
		1998 -> 1999;
	1999 [label="我想你會喜歡的。你跟爸爸還有亞瑟可以坐在爐火旁交流戰爭故事，媽媽可以探探你口風是否單身。",shape=box,color=blue];
		1999 -> 2000;
		1999 -> 2001;
		1999 -> 2002;
		1999 -> 2003;
	2000 [label="我想我會嚇到他們。",shape=box,color=red];
		2000 -> 2016;
	2001 [label="為了你，我會表現出我最好的一面。",shape=box,color=red];
		2001 -> 2017;
	2002 [label="老實講，這聽起來很有趣。",shape=box,color=red];
		2002 -> 2018;
	2003 [label="單身？等等，我會以一個伴侶的身分回家嗎？",shape=box,color=red];
		2003 -> 2007;
	2016 [label="+15 Chemistry",color=orange];
		2016 -> 2004;
	2017 [label="+15 Chemistry",color=orange];
		2017 -> 2005;
	2018 [label="+15 Chemistry",color=orange];
		2018 -> 2006;
	2007 [label="嗯。",shape=box,color=blue];
		2007 -> 2011;
	2004 [label="哈！這只會讓我更想實行。",shape=box,color=blue];
		2004 -> 2008;
	2005 [label="你真體貼！",shape=box,color=blue];
		2005 -> 2009;
	2006 [label="噢天啊，就這樣做吧。如果有機會的話，我們一定會把它變成現實。",shape=box,color=blue];
		2006 -> 2010;
	2011 [label="意想不到的發展，她說，一邊搧著扇子。",shape=box,color=blue];
		2011 -> 2015;
	2008 [label="我可以想像到爸爸禮貌地問：「所以總是以刺穿的方式被殺死，還是他們會稍微變下新花樣？」",shape=box,color=blue];
		2008 -> 2012;
	2009 [label="……在我努力實現這個夢想之前，我應該放棄它。我們在這裡，就是現在，而且戰爭仍在繼續。",shape=box,color=blue];
		2009 -> 2013;
	2010 [label="謝謝你。",shape=box,color=blue];
