		2028 -> 2035;
	2029 [label="對。",shape=box,color=blue];
		2029 -> 2030;
	2026 [label="我只不過很單純地討論我的父母，沒有其他用心，但現在你居然對我旁敲側擊。",shape=box,color=blue];
		2026 -> 2031;
	2035 [label="我的錯。",shape=box,color=blue];
