digraph {
	460 [label="EleanorRank2Convo3 begins.",color=orange];
		460 -> 461;
	461 [label="好，我們已經認識有一段時間了，而你來自未來，我想我可以相信你會對我坦白，所以我必須問那個最重要的問題。",shape=box,color=blue];
		461 -> 462;
	462 [label="是不是只有我們？還是我們最終接通了其他東西？",shape=box,color=blue];
		462 -> 463;
		462 -> 464;
		462 -> 465;
	463 [label="你是說外星生命嗎？尚未，但或許會有那麼一天。",shape=box,color=red];
		463 -> 466;
	464 [label="很不幸，我們能夠走到最接近的距離也只能是一片「漠然」。",shape=box,color=red];
		464 -> 467;
	465 [label="對，只有我們。除了人類跟人類所創造的事物之外什麼都沒有。",shape=box,color=red];
		465 -> 468;
	466 [label="那，真該死。",shape=box,color=blue];
		466 -> 469;
	467 [label="什麼是「漠然」？我在你的腦海中看到了一些片段，但我無法拼湊出來。這讓我想離開並縮在有一面厚牆壁的地方。",shape=box,color=blue];
		467 -> 470;
		467 -> 471;
	468 [label="是個最為悲觀的答案。",shape=box,color=blue];
		468 -> 472;
	469 [label="我真的希望在外面有一些我們可以交流的對象。對我們物種具有真正外部視野的東西。",shape=box,color=blue];
		469 -> 473;
	470 [label="我們仍然不確定它是什麼。甚至它想要什麼。我們甚至不知道它是否像血色面紗所認為的那樣是一個古老的實體，或者阿爾布雷希特是否以某種方式創造了它。",shape=box,color=red];
		470 -> 474;
	471 [label="就是那個帶走露莎卡少校的東西。",shape=box,color=red];
		471 -> 475;
	472 [label="我不知道是為何。一句到尾，智能就是智能。是我們發掘它還是創造出它根本不重要。",shape=box,color=blue];
		472 -> 540;
	473 [label="交流以及……其他事，當然的。",shape=box,color=blue];
		473 -> 477;
		473 -> 476;
	474 [label="如果我告訴你這是當時附身在露莎卡少校的東西，這會有幫助嗎？",shape=box,color=red];
		474 -> 475;
	475 [label="噢。",shape=box,color=blue];
		475 -> 543;
	540 [label="我想我只是想得到確認宇宙並沒有把所有的雞蛋放在同一個籃子裡。因為如果只有人類，那麼真的是一個很差的情況了。",shape=box,color=blue];
		540 -> 541;
	477 [label="正在尋找一個觸手怪物同伴交朋友嗎？",shape=box,color=red];
		477 -> 494;
	476 [label="等一下。你心裡想的互動是什麼樣的？",shape=box,color=red];
		476 -> 479;
	543 [label="噢不。",shape=box,color=blue];
		543 -> 544;
	541 [label="啊，那。",shape=box,color=blue];
		541 -> 542;
	494 [label="+5 Chemistry",color=orange];
		494 -> 478;
	479 [label="算是某種交流，我想。不一定是任何實體的東西。我只是跟一些不只是人類，甚至不屬於地球的東西作精神上的交流。",shape=box,color=blue];
		479 -> 481;
	544 [label="噢該死。",shape=box,color=blue];
		544 -> 545;
	542 [label="Chat ends.",color=orange];
	478 [label="小心說話。我不是「觸手怪物」。我是個碰巧有一條觸手的怪物。目前只有一條。",shape=box,color=blue];
		478 -> 480;
	481 [label="我曾經試過跟莉蒂的其中一隻老鼠作精神上的交流，來看看會發生什麼事。",shape=box,color=blue];
		481 -> 483;
		481 -> 484;
	545 [label="那個東西？這跟你的「漠然」是一樣東西？",shape=box,color=blue];
		545 -> 546;
	480 [label="如果我只不過想跟有觸手的東西談天說地的話，我會去露西娜公主動物園並跟八爪魚做朋友。",shape=box,color=blue];
		480 -> 482;
	483 [label="可憐的小東西沒有受傷吧，牠有嗎？",shape=box,color=red];
		483 -> 485;
	484 [label="好，我一定要追問當天的下文。",shape=box,color=red];
		484 -> 485;
	546 [label="我摸了它。我用我心靈的某一小部份觸碰了那個東西，然後我把那記憶鎖起來。",shape=box,color=blue];
		546 -> 547;
	482 [label="……現在的我很希望我當時有這樣做。八爪魚非常聰明。我們現在或會一起寫詩了。我想知道那隻八爪魚在哪裡？",shape=box,color=blue];
		482 -> 486;
	485 [label="這對他來說是很恐怖的三秒鐘。",shape=box,color=blue];
		485 -> 491;
	547 [label="我甚至都不記得是什麼時候發生的。 她正透過播音系統發表她其中一篇的演講， 我當時在想「 我從來都沒有探視過她的腦袋，不知道裡面有什麼呢，可能都會是皮革和針線」，而我就探視了之後……",shape=box,color=blue];
		547 -> 548;
	486 [label="應該有人吃了牠吧。一旦沒有資源，被隔離城市的動物園動物通常會發生這種事。",shape=box,color=blue];
		486 -> 487;
	491 [label="可憐的小東西。你看，我沒有想過他會跟我作精神上的交流對他來說是怎樣的。想像一下一個小孩子迷失在一個無邊際的百貨商場裡，一遍又一遍地大聲呼喊著媽媽。一切都那麼巨型又讓人困惑，又有聲音和形狀，而不是氣味。",shape=box,color=blue];
		491 -> 492;
	548 [label="死了死了死了",shape=box,color=blue];
		548 -> 549;
	487 [label="未被吃掉的東西現在都會被科腐者蹂躪摧殘。",shape=box,color=blue];
		487 -> 488;
	492 [label="我已盡快斷開連結。大約一個小時左右，他有點頭暈然後就沒事了。我懷疑他甚至不記得發生在他身上的事。",shape=box,color=blue];
		492 -> 497;
		492 -> 496;
	549 [label="我暫時無法談論這個話題。對不起。",shape=box,color=blue];
		549 -> 550;
	488 [label="……在「夢」裡就是這樣的，不是嗎？只不過這根本不是夢。它實實在在地發生了。或者將會發生。或相似的結果會發生。那個動物園發生了一些事。",shape=box,color=blue];
		488 -> 489;
	497 [label="你這邊的體會呢？當老鼠又是什麼感覺？",shape=box,color=red];
		497 -> 500;
	496 [label="這只是隻小老鼠，拜托。",shape=box,color=red];
		496 -> 498;
	550 [label="+20 Chemistry",color=orange];
		550 -> 551;
	489 [label="我會努力記住的。",shape=box,color=blue];
		489 -> 490;
	500 [label="我不知道你有否經歷過那種頹廢時期而你只想躺在床上吸氣和呼氣，僅僅活著而不做任何其他事情，但情況就像那個時期的感覺。",shape=box,color=blue];
		500 -> 501;
	498 [label="不要讓莉蒂聽到你這樣說。如果你希望你的五臟六腑留在他們原來的位置的話。",shape=box,color=blue];
		498 -> 499;
	551 [label="Update boolean EleanorIndifference",color=orange];
		551 -> 552;
	490 [label="不要嘗試來阻止我。",shape=box,color=blue];
		490 -> 493;
	501 [label="很簡單。簡單的需求以簡單的方式來滿足。",shape=box,color=blue];
		501 -> 502;
	499 [label="Chat ends.",color=orange];
	552 [label="Chat ends.",color=orange];
	493 [label="Update boolean EleanorRemembers",color=orange];
		493 -> 495;
	502 [label="童年的純真無法跟老鼠的意識作比較。",shape=box,color=blue];
		502 -> 503;
		502 -> 504;
	495 [label="Chat ends.",color=orange];
	503 [label="聽你這樣說，聽起來蠻開心的。",shape=box,color=red];
		503 -> 505;
	504 [label="你在嫉妒一隻老鼠嗎？",shape=box,color=red];
		504 -> 506;
	505 [label="噢，是啊。我確信作為老鼠也有不好的一面，例如必須吃掉你死了的兄弟來避免被獵食者聞到，但那稍縱即逝的簡單時刻幾乎像是某種宗教的領悟。",shape=box,color=blue];
		505 -> 507;
	506 [label="有點吧。",shape=box,color=blue];
		506 -> 509;
	507 [label="我猜做一隻老鼠很像做一個和尚。靠剩菜剩飯過日子，在世界上卑微地生活，永遠都沒法擁有汽車或房子。",shape=box,color=blue];
		507 -> 508;
	509 [label="我其實覺得做個簡單而需求不高的小人物是很偉大的。",shape=box,color=blue];
		509 -> 510;
	508 [label="宗教的領悟？",shape=box,color=red];
		508 -> 509;
	510 [label="不管你信不信，我想做修女很久了。",shape=box,color=blue];
		510 -> 511;
	511 [label="Update boolean EleanorNun1",color=orange];
		511 -> 512;
		511 -> 513;
	512 [label="你一定要告訴我那是什麼，愛琳娜。",shape=box,color=red];
		512 -> 514;
	513 [label="修女？",shape=box,color=red];
		513 -> 515;
	514 [label="對，是的。看來你來自的地方沒有這些人。",shape=box,color=blue];
		514 -> 516;
	515 [label="是的。或者你來自的地方沒有這些人。",shape=box,color=blue];
		515 -> 516;
	516 [label="就像太陰的擁護者一樣。剃著光頭，根據不同場合而穿著的白色或黑色的長袍，生活非常嚴謹。你應該專注於的神聖的事物而忽視其他一切。每天祈禱和冥想。清茶淡飯。",shape=box,color=blue];
		516 -> 517;
		516 -> 518;
		516 -> 519;
		516 -> 520;
	517 [label="那聽起來很枯燥。",shape=box,color=red];
		517 -> 521;
	518 [label="那聽起來很棒。",shape=box,color=red];
		518 -> 522;
	519 [label="那聽起來很具挑戰性。",shape=box,color=red];
		519 -> 523;
	520 [label="那聽起來……不是我的風格。",shape=box,color=red];
		520 -> 526;
	521 [label="從表面上看確實如此。修道院跟獄中生活的唯一分別就是你是專程修行的。",shape=box,color=blue];
		521 -> 527;
	522 [label="對於大多數年輕修行者來說，這聽起來也很棒，直到他們真正體驗到修道院的生活。我認為退出率大約是百分之八十。",shape=box,color=blue];
		522 -> 527;
	523 [label="噢，不。我的意思是，首先，是的，你需要放下社會教會你的所有事物。這個階段可能是最難的。",shape=box,color=blue];
		523 -> 528;
	526 [label="+10 Chemistry",color=orange];
		526 -> 524;
	527 [label="發現這種生活不適合我。我太享受生活在這個世界了。",shape=box,color=blue];
		527 -> 525;
	528 [label="但一旦你習慣了，會是什麼挑戰？誘惑嗎？你永遠都不會看到任何誘惑。這個目的就是讓你遠離一切可能分散你對神聖的專注力的事物。",shape=box,color=blue];
		528 -> 527;
	524 [label="發現這種生活也不適合我。我太享受生活在這個世界了。",shape=box,color=blue];
		524 -> 525;
	525 [label="但日尊……就像另一個版本的我坐在某個山頂上，芳香雲煙環繞著她，黑玉和月光石珠子在她指間數著滴答滴答，帶著卑鄙的憐憫俯視著我。",shape=box,color=blue];
		525 -> 529;
	529 [label="我知道這只是一個幻想。就像亞瑟的盔甲騎士故事一樣。",shape=box,color=blue];
		529 -> 530;
		529 -> 531;
	530 [label="我們都幻想有一天能生活美滿。",shape=box,color=red];
		530 -> 532;
	531 [label="我一直在跟另一個版本的自己交談。我們一起吃過飯。這並不像你說的那麼瘋狂。",shape=box,color=red];
		531 -> 533;
	532 [label="謝謝。不知為何聽到這些話讓人心中感到安慰。",shape=box,color=blue];
		532 -> 534;
	533 [label="對。我總是忘記你所經歷的一切以任何正常標準來看都是非常瘋狂。",shape=box,color=blue];
		533 -> 534;
	534 [label="你……知道，我從來沒有這樣做過，但我想我會嘗試跟她接觸，以防萬一她真的存在。對。或者我可以用心靈感應的方式聯絡「愛琳娜修女」。",shape=box,color=blue];
		534 -> 535;
	535 [label="最差的情況又會怎樣呢？",shape=box,color=blue];
		535 -> 538;
	538 [label="+10 Chemistry",color=orange];
		538 -> 536;
	536 [label="我可能會從另外一個自己獲得一些建議。 想像一下那個畫面。噢，月球。我現在感到很興奮。",shape=box,color=blue];
		536 -> 537;
	537 [label="Update boolean EleanorSister",color=orange];
		537 -> 539;
	539 [label="Chat ends.",color=orange];
