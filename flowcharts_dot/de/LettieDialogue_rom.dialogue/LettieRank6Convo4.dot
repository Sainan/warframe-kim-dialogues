		j2620068520 -> j1874816709;
	j4255829716 [label="Sólo las arañas\nRichten sich wieder häuslich ein\nSie gehen vorbei",shape=box,color=blue];
		j4255829716 -> j3756511174;
	j1874816709 [label="No, nichts Neues\nSólo las arañas\nRichten sich wieder häuslich ein\nSie gehen vorbei",shape=box,color=blue];
		j1874816709 -> j3756511174;
	j3756511174 [label="Manchmal wünschte ich,\nEs wäre einfach ein Problem\nDann könnte ich es beheben, ¿sí?\nDrüber reden, es hin und her wenden jajaja",shape=box,color=blue];
		j3756511174 -> j4058082729;
	j4058082729 [label="Probleme können behoben werden\nProbleme haben Antworten\nLos sentimientos no se arreglan\nGlaub mir, ich habe es versucht",shape=box,color=blue];
		j4058082729 -> j4281394823;
		j4058082729 -> j3511698464;
	j4281394823 [label="Es gibt aber eine Menge, worüber du glücklich sein kannst.",shape=box,color=red];
		j4281394823 -> j2805519762;
	j3511698464 [label="Ich habe in Duviri auf die harte Tour gelernt, dass \"Gefühle zu reparieren\" manchmal die schlechtere Wahl ist.",shape=box,color=red];
		j3511698464 -> j2268276151;
	j2805519762 [label="Ay, sí, bin ich\nDas weiß ich auch\nUnd manchmal wünschte ich,\nLeute würden verstehen, dass dieser Teil von mir\ndas nie verinnerlichen wird",shape=box,color=blue];
		j2805519762 -> j2497363187;
	j2268276151 [label="Síí...\nAber manchmal ist es verlockend jajaja\nEs einfach wegwünschen\nAber du hast mir gesagt, was passiert\nWenn alles einfach taub wird",shape=box,color=blue];
		j2268276151 -> j2863923391;
	j2497363187 [label="Ich wünschte, ich könnte anders sein\nAber ich bin, wer ich bin\nUnd ich habe vor langer Zeit aufgehört\nMich dafür zu entschuldigen",shape=box,color=blue];
		j2497363187 -> "Chat ends.";
	j2863923391 [label="Wünsche ich niemandem\nOk, vielleicht Albrecht\nPinche güey\nSein Herz ist allerdings schon zu kalt",shape=box,color=blue];
		j2863923391 -> j3744988034;
		j2863923391 -> j249707140;
	j3744988034 [label="Was können wir tun, um deinen Verstand abzulenken? Oder möchtest du lieber drinnen bleiben?",shape=box,color=red];
		j3744988034 -> j922050232;
	j249707140 [label="Wir können nur hoffen, dass er auf lange Sicht spielt.",shape=box,color=red];
		j249707140 -> j3024511931;
	j922050232 [label="Hmm, gute Frage\nEhrlich gesagt, bin ich unsicher\nDrinnen bleiben könnte nett sein\nOder wir könnten rausgehen und Sachen töten\n¿Te quedas?, ¿o vamos a matar cosas?\nSo viel Auswahl ...",shape=box,color=blue];
		j922050232 -> j399019819;
		j922050232 -> j2296382662;
	j3024511931 [label="Das Einzige, worauf ich hoffe, was den cabrón betrifft\nIst eine lange Aufzugfahrt\nMit mir\nUnd einem Baseballschläger",shape=box,color=blue];
		j3024511931 -> j1229852356;
	j399019819 [label="Ich bin für drinnen bleiben.",shape=box,color=red];
