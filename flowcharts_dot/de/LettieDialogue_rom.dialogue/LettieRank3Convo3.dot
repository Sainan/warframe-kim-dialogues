	j95982536 [label="Ich komme nicht wirklich von irgendwoher.",shape=box,color=red];
		j95982536 -> j1932921269;
	j3790028552 [label="Ganz ehrlich? Keine Ahnung. Die Orokin haben die meisten Aufzeichnungen der alten Erde zerstört. Daher habe ich keine Ahnung, wie weit aus der Zukunft ich komme.",shape=box,color=red];
