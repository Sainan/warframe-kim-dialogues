		j2848432270 -> j1345758012;
	j2456377300 [label="Das ist das Schiff, ¿no? \nIst das nicht jetzt verlassen?",shape=box,color=blue];
		j2456377300 -> j2182372952;
		j2456377300 -> j3173860353;
	j1957680447 [label="Warum denkst du, ich würde dich auslachen",shape=box,color=blue];
		j1957680447 -> j3311966944;
	j2937204983 [label="Sí, du, der wandert \nDer kein Zuhause hat",shape=box,color=blue];
		j2937204983 -> j3311966944;
	j2460475222 [label="Meine Familie zog oft um, dann ging ich zur Armee \nDann trat ich dem IKA bei, ich passe zu niemandem und nirgendwohin \nAlso verstehe ich in gewisser Weise, wie sich deplatziert anfühlt",shape=box,color=blue];
		j2460475222 -> j1393236624;
	j3286694468 [label="Manchmal können wir uns nicht aussuchen, was unser Zuhause uns antut.",shape=box,color=red];
		j3286694468 -> j2822591960;
	j1345758012 [label="Was es mir angetan hat, habe ich mir selbst angetan. Nur Albträume, die sich in meinem Kopf immer und immer wieder wiederholten.",shape=box,color=red];
		j1345758012 -> j1169226767;
	j2182372952 [label="Das ... ist eine komplizierte Frage. Es hat seine eigenen Geister.",shape=box,color=red];
		j2182372952 -> j1169226767;
	j3173860353 [label="Nein, es ist nicht verlassen. Es hat die Erinnerungen derer, die es ihr Zuhause nannten.",shape=box,color=red];
		j3173860353 -> j1169226767;
	j1393236624 [label="Aber ich habe Leute und eine Kultur, die ich mein Eigen nenne \nAuch wenn sie weit weg sind",shape=box,color=blue];
		j1393236624 -> j4129421074;
		j1393236624 -> j2019833532;
	j2822591960 [label="Sí, kenne ich zu gut \nMeine Familie zog oft um, dann ging ich zur Armee \nDann trat ich dem IKA bei, ich passe zu niemandem und nirgendwohin",shape=box,color=blue];
		j2822591960 -> j2565949842;
	j1169226767 [label="Mehr fantasmans, mehr Tod, der dir folgt \nUnd ich dachte, ich kenne La Flaca gut",shape=box,color=blue];
		j1169226767 -> j1517349212;
		j1169226767 -> j1306000817;
	j4129421074 [label="Meine andere Option ist Duviri und ... nein. Meine Geschichte mit diesem Ort ist ... zu kompliziert.",shape=box,color=red];
		j4129421074 -> j1169226767;
	j2019833532 [label="Meine andere Option ist die Zariman und der Ort ist nicht freundlicher. Hat genauso viele Geister und Albträume. Außer, dass dort mehr gestorben sind, als NUR ich.",shape=box,color=red];
		j2019833532 -> j1169226767;
	j2565949842 [label="Aber mein Zuhause hat mir nicht das angetan, was dieser Ort dir angetan hat, babas \nIch respektiere, dass du es immer noch als das siehst, wo du herkommst",shape=box,color=blue];
		j2565949842 -> j157605922;
		j2565949842 -> j2019833532;
	j1517349212 [label="Sie hat mich auf Kurzwahl.",shape=box,color=red];
		j1517349212 -> j2147050049;
	j1306000817 [label="Geister folgen mir, wo ich auch hingehe. Manchmal frage ich mich, ob ich selbst ein Geist bin.",shape=box,color=red];
		j1306000817 -> j4250570709;
	j157605922 [label="Das ist der Ort, den ich am besten kenne und der mich am besten kennt, nehme ich an.",shape=box,color=red];
		j157605922 -> j2460254048;
	j2147050049 [label="Jaja scheint so \nAber deine Geister geben mir Hoffnung",shape=box,color=blue];
		j2147050049 -> j2785155685;
	j4250570709 [label="Armer heimgesuchter babas \nAber du gibst mir Hoffnung",shape=box,color=blue];
