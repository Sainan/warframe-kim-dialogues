	j1828854235 [label="Freut mich, dass mein Leid dir Freude bringt.",shape=box,color=red];
		j1828854235 -> j1945290486;
	j2143581110 [label="Sí, das muss man dem Vertrauten lassen \nIch nehme an, mit der Zeit, wird sich dieser Ort für mich wie ein Zuhause anfühlen \nMierda, ich hoffe, das dauert noch",shape=box,color=blue];
		j2143581110 -> j2434798245;
