	j1932921269 [label="Boolean LettieHomeNowhere is now true.",color=orange];
		j1932921269 -> j2937204983;
	j3311966944 [label="Das muss schwer sein \nSich zu fühlen, als kämst du von keinem Ort und aus keiner Zeit",shape=box,color=blue];
