		j3702107533 -> "Chat ends.";
	j2171703931 [label="Ich möchte mit dir über etwas sprechen und möchte sichergehen, dass es für dich in Ordnung ist.",shape=box,color=red];
		j2171703931 -> j686917596;
	j686917596 [label="Mir ist es wichtig, dass du nicht das Gefühl hast, ich lüge dich an oder bin dir gegenüber in irgendeiner Weise unehrlich.",shape=box,color=red];
		j686917596 -> j3440286775;
