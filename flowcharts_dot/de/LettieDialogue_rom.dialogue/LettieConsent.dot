		j4172583155 -> "Chat ends." [label=false,color=brown];
	j2880492808 [label="Hey Lettie? Können wir reden? [Einwilligung für mehrerer Partner einholen.]",shape=box,color=red];
		j2880492808 -> j389362582;
	j4058984412 [label="[Ende.]",shape=box,color=red];
		j4058984412 -> j3702107533;
	j389362582 [label="Immer\nAber für dich?\n¿Qué?",shape=box,color=blue];
		j389362582 -> j2171703931;
	j3702107533 [label="Boolean LettieConsentComplete is now true.",color=orange];
		j3702107533 -> "Chat ends.";
	j2171703931 [label="Ich möchte mit dir über etwas sprechen und möchte sichergehen, dass es für dich in Ordnung ist.",shape=box,color=red];
		j2171703931 -> j686917596;
	j686917596 [label="Mir ist es wichtig, dass du nicht das Gefühl hast, ich lüge dich an oder bin dir gegenüber in irgendeiner Weise unehrlich.",shape=box,color=red];
		j686917596 -> j531595244;
		j686917596 -> j1581262301;
		j686917596 -> j2351753222;
	j531595244 [label="Bitte, tu mir nicht weh.",shape=box,color=red];
		j531595244 -> j2507852739;
	j1581262301 [label="Bitte, sei nicht wütend.",shape=box,color=red];
		j1581262301 -> j4154053945;
	j2351753222 [label="Ich hoffe, du verstehst.",shape=box,color=red];
		j2351753222 -> j87198216;
	j2507852739 [label="Jajajajaj\nWir haben darüber gesprochen\nIch tue dir nur weh, so, wie du es magst\nUnd jetzt, wovon redest du?",shape=box,color=blue];
		j2507852739 -> j830343849;
	j4154053945 [label="¿Sí?\nUnd worüber sollte ich wütend werden?",shape=box,color=blue];
		j4154053945 -> j830343849;
	j87198216 [label="¿Sí?\nUnd was soll ich verstehen?",shape=box,color=blue];
		j87198216 -> j830343849;
	j830343849 [label="Ich möchte dich nicht in eine Situation bringen, mit der du nicht einverstanden bist. Ich weiß, dass wir das noch nie besprochen haben. Wenn du also Nein sagst, ist das völlig in Ordnung. Das wollte ich dir nur sagen.",shape=box,color=red];
		j830343849 -> j2947533451;
	j2947533451 [label="Was wir haben, ist mir wichtig – sehr wichtig – und es ist real. Ich möchte nicht, dass du daran zweifelst.",shape=box,color=red];
		j2947533451 -> j1026867841;
	j1026867841 [label="Aah, entiendo...\nDu weißt, so bin ich normal nicht gerne\nIch denke, ich will nur wissen\nSind sie dir wichtig, solecito?\n¿Quiénes son?\nSind sie dir wirklich wichtig?",shape=box,color=blue];
		j1026867841 -> j83508641;
		j1026867841 -> j1720651118;
	j83508641 [label="Ja, sie sind mir wichtig. Aber du bist mir auch sehr wichtig.",shape=box,color=red];
		j83508641 -> j2695807426;
	j1720651118 [label="Ich hätte wissen sollen, dass du das schnell herausfindest.",shape=box,color=red];
		j1720651118 -> j776099599;
	j2695807426 [label="Ay, sí\nSchwer, dir einen Vorwurf zu machen, wenn du so viel erlebst\nSo viel reist\nFrag mich nur nicht, ob ich mitmachen will\nMit ist es recht",shape=box,color=blue];
		j2695807426 -> j1119650487;
	j776099599 [label="Ich habe getäuscht\nEleanor hat mich gewarnt\nJajaja, sie ist eine furchtbare Klatschtante",shape=box,color=blue];
		j776099599 -> j649908847;
	j1119650487 [label="Aber nicht die Hex\nMi familia no, ¿por favor?\nSonst müsste ich mich eine Woche lang waschen",shape=box,color=blue];
		j1119650487 -> j3563024917;
	j649908847 [label="Schwer, dir einen Vorwurf zu machen, wenn du so viel erlebst\nSo viel reist\nFrag mich nur nicht, ob ich mitmachen will\nMit ist es recht",shape=box,color=blue];
		j649908847 -> j1119650487;
	j3563024917 [label="+20 Chemistry",color=orange];
		j3563024917 -> j206400303;
	j206400303 [label="Du bist mir sehr wichtig geworden, solecito\nUnd sie machen dich glücklich?\nDann tun sie das für mich auch\nSo einfach ist es",shape=box,color=blue];
		j206400303 -> j2467792677;
	j2467792677 [label="Oh\nUnd finde einen Weg, sie irgendwann hierher zu bringen\nIch möchte sie treffen",shape=box,color=blue];
		j2467792677 -> j1410971409;
		j2467792677 -> j3588056309;
	j1410971409 [label="Ja Ma'am. :)",shape=box,color=red];
		j1410971409 -> j3702107533;
	j3588056309 [label="Mal sehen, was ich tun kann.",shape=box,color=red];
		j3588056309 -> j3702107533;
}