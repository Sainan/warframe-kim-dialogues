		j2070321133 -> j1702335950;
	j1259604370 [label="¿Sí?
Und was soll ich verstehen?",shape=box,color=blue];
		j1259604370 -> j1702335950;
	j1702335950 [label="Ich möchte dich nicht in eine Situation bringen, mit der du nicht einverstanden bist. Ich weiß, dass wir das noch nie besprochen haben. Wenn du also Nein sagst, ist das völlig in Ordnung. Das wollte ich dir nur sagen.",shape=box,color=red];
		j1702335950 -> j1246532461;
	j1246532461 [label="Was wir haben, ist mir wichtig – sehr wichtig – und es ist real. Ich möchte nicht, dass du daran zweifelst.",shape=box,color=red];
		j1246532461 -> j2831868200;
	j2831868200 [label="Aah, entiendo...
Ich denke, ich will nur wissen
Sind sie dir wirklich wichtig, solecito?
¿Quiénes son?",shape=box,color=blue];
		j2831868200 -> j1414109931;
		j2831868200 -> j1065085075;
	j1414109931 [label="Ja, sie sind mir wichtig. Aber du bist mir auch sehr wichtig.",shape=box,color=red];
		j1414109931 -> j72954489;
	j1065085075 [label="Ich hätte wissen sollen, dass du das schnell herausfindest.",shape=box,color=red];
		j1065085075 -> j1944413704;
	j72954489 [label="Ay, sí
