		j2985861959 -> j799935259;
		j2985861959 -> j3849251447;
	j2027743698 [label="Wir sitzen an ihren Gräbern und erzählen Geschichten \nWir essen mit ihnen, was wir für sie mitbringen \nWir reden mit ihnen und lachen mit ihnen \nWir flüstern oder weinen nicht, wenn sie in der Nacht zu uns kommen",shape=box,color=blue];
