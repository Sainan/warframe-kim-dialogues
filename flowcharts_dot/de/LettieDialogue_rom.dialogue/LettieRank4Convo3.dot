		j1725855646 -> j2003010268;
	j2080395155 [label="Wenn du willstt, können wir einen ofrenda für deine Familie bauen \nVielleicht kommen sie nach so langer Zeit, um babas zu sehen \nIch bin sicher, sie sind stolz auf dich",shape=box,color=blue];
