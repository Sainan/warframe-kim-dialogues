	j3032232638 [label="Boolean LettieDiasdeMuertos is now true.",color=orange];
		j3032232638 -> j1185860192;
	j1337682795 [label="Nein \nIch sehe sie einmal im Jahr beim Totenfest \n¡Mierda! Bevor du fragst: Nein, es ist nicht so, wie es klingt \nWir graben sie nicht aus, wir feiern ihre Seelen, jajaja \nOk, manche tun das – aber wir nicht, es hängt davon ab, woher du kommst",shape=box,color=blue];
		j1337682795 -> j504786252;
		j1337682795 -> j2669000068;
	j4180239841 [label="Sí, aber ich vermisse sie nicht\nSie sind aus meinem Alltag verschwunden, aber nicht aus meiner Seele. Sie besuchen weiterhin einmal im Jahr beim Totenfest \nWir graben sie nicht aus, wir feiern ihre Seelen, jajaja \nOk, manche tun das – wir jedoch nicht, es hängt davon ab, woher du kommst",shape=box,color=blue];
		j4180239841 -> j504786252;
		j4180239841 -> j2669000068;
	j3167813562 [label="Mi papá ließ mich warten, bis ich 20 war, bevor ich beitrat \nAber ich war bereit, früher zu gehen, jajaja \nIch war ungeduldig, wollte ihn und mi tía stolz machen \nIch bin froh, dass er mich warten ließ, ich war nicht bereit",shape=box,color=blue];
		j3167813562 -> j2171702178;
	j1185860192 [label="Ich hoffe, sie kommt bis hierher ... \nIch muss ihr Ringelblumen aus Papier machen \nVielleicht hilft mir Arthur, pan de muerto zu machen\nIch bin ein beschissener Bäcker, jajaja",shape=box,color=blue];
		j1185860192 -> j3774824899;
		j1185860192 -> j1746152937;
	j504786252 [label="Puh. Ich wollte gerade sagen. lol",shape=box,color=red];
		j504786252 -> j1664670609;
	j2669000068 [label="LOL! Klingt aber nach einem coolen Feiertag.",shape=box,color=red];
		j2669000068 -> j1664670609;
	j2171702178 [label="Zuzusehen, wie die eigene Tante langsam an Herzversagen stirbt, ist eine Sache \nZuzusehen, wie Menschen sich gegenseitig brutal umbringen \nSchreiende Tode, blutende Tode \nDas ist etwas ganz anderes",shape=box,color=blue];
		j2171702178 -> j57498640;
	j3774824899 [label="Ich bin sicher, er würde gerne helfen.",shape=box,color=red];
		j3774824899 -> j3018346605;
	j1746152937 [label="Ich würde auch gerne helfen.",shape=box,color=red];
		j1746152937 -> j1725855646;
	j1664670609 [label="Wir errichten ofrendas für unsere Lieben, machen pan de muerto und calaveritas de azúcar und legen unsere Ringelblumen aus, um sie nach Hause einzuladen \nWir essen mit ihnen, was wir für sie mitgebracht haben\nWir sitzen an ihren Gräbern und erzählen Geschichten über sie \nWir reden mit ihnen und lachen mit ihnen",shape=box,color=blue];
		j1664670609 -> j1919398787;
	j57498640 [label="Aber das weißt du selbst, oder? \nDu kennst La Flaca genauso gut wie ich \nApropos \nSie wartet auf niemanden und schon gar nicht auf unsere Gespräche",shape=box,color=blue];
		j57498640 -> "Chat ends.";
