		j3972242181 -> "Chat ends.";
	j3367816485 [label="Wegen dem, was dein Xipe Totec dich tun ließ \nEs war nicht deine Schuld, sie wurden in den Wahnsinn getrieben \nManchmal muss man die Wunde ausbrennen\nDu hast sie eingeschläfert, es war kein Mord",shape=box,color=blue];
		j3367816485 -> j3514941432;
