	j3147160021 [label="Wir können nicht einfach irgendeinem Teenager weh tun.",shape=box,color=red];
		j3147160021 -> j2808628079;
	j3997318531 [label="Ich will ihm zeigen, wie es ist, wenn er derjenige ist, der Angst hat und die ganze Welt gegen ihn ist.\nWenn jeder über ihn lacht\nIhn verspottet",shape=box,color=blue];
		j3997318531 -> j1687784733;
	j2808628079 [label="Wer sagt, dass das der Plan ist\nIch kenne solche Typen\nFeiglinge, allesamt, schießen ihre Worte aus der \"sicheren\" Deckung ab",shape=box,color=blue];
		j2808628079 -> j3997318531;
	j1687784733 [label="Weißt du, wie es war, aufzuwachsen und so auszusehen, wie ich?\nSo zu klingen, wie ich?\nSich so anzuziehen, wie ich?\nUmgeben von Kindern auf Militärbasen, die nicht so waren?",shape=box,color=blue];
		j1687784733 -> j1515488355;
	j1515488355 [label="Ich kam meistens ramponiert nach Hause, weil ich für mich selbst einstand\nMi mamá sagte immer tsts und dass ich den Kopf hätte einziehen sollen\n¿Quedarme callada?\nNiemals",shape=box,color=blue];
