		j580547789 -> j2483488714 [label=false,color=brown];
	j3364137974 [label="Ich nehme es ihr nicht übel, dass sie weglaufen wollte\nHätte ich es gekonnt, hätte ich es getan\nAber\nHast du bemerkt, dass sie wiederkam?",shape=box,color=blue];
		j3364137974 -> j3757683522;
		j3364137974 -> j2330056110;
	j2483488714 [label="Ich nehme es ihr nicht übel, dass sie weglaufen wollte\nHätte ich es gekonnt, hätte ich es getan\nWenn sie älter wird, wird es verblassen",shape=box,color=blue];
