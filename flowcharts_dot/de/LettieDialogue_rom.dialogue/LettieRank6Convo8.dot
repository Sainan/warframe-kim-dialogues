	j3464671995 [label="Ist das etwas, wobei du ihr helfen kannst?",shape=box,color=red];
		j3464671995 -> j546741605;
	j1381571134 [label="JAJAJA erinner mich daran, dich nie als Notfallkontakt einzusetzen\nSííí, sie verschwindet immer mal, aber sie kommt hierher zurück\nFür Temporale Archi-was-auch-immer\nAber auch wegen uns ... glaube ich",shape=box,color=blue];
		j1381571134 -> j1953470502;
	j882944291 [label="Sííí, Temporale Archi-was-auch-immer\nAber auch wegen ... uns, denke ich",shape=box,color=blue];
		j882944291 -> j1953470502;
	j546741605 [label="Manchmal braucht es einfach Zeit\nAber ich werde ihr helfen, wenn ich kann\nLua weiß, sie ist neugierig genug auf medizinische Wissenschaft jajaja\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
		j546741605 -> j820587656;
	j1953470502 [label="Ich habe sie gern um mich\nIch glaube, sie weiß das\nSie hilft mir gern bei Operationen ...\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
		j1953470502 -> j1168207719;
	j820587656 [label="Dass sie teleportiert ist keine Hilfe\nIch liebe es, wenn sie Amir erschreckt\nDer schnelle Bastard verdient es, erschreckt uns oft genug JAJAJAJA",shape=box,color=blue];
