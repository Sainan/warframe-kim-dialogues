	j1168207719 [label="Dass sie teleportiert ist keine Hilfe\nIch liebe es, wenn sie Amir erschreckt\nDer schnelle Bastard verdient es, erschreckt uns oft genug JAJAJAJA\nHoffe, sie bleibt nie ganz weg",shape=box,color=blue];
