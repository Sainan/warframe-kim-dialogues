		j238781430 -> j4093388285;
	j4168768209 [label="Könnte ein Vulpaphyla sein? Sah es aus, wie ein \"Fuchs\" oder ein dünner \"Hund\", mit großen langen Ohren und glühenden Sachen auf ihnen?",shape=box,color=red];
		j4168768209 -> j986402041;
