	j2762170017 [label="Ja ... keine Ahnung, tut mir leid.",shape=box,color=red];
		j2762170017 -> j4093388285;
	j2347191727 [label="Das ist mein Listiger Vulpaphyla. Sie stammen von Deimos, dem befallenen Planeten. Ist sehr selten einen außerhalb von Deimos zu sehen. :) Sie sind harmlos. Naja, für dich jedenfalls.",shape=box,color=red];
