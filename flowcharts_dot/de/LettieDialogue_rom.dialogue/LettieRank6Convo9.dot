		j3843232042 -> j751064847;
	j3345652817 [label="Könnte ein Wesir-Prädasit sein? Sah es aus, wie ... ein großer, stämmiger \"Hund\", mit was Leuchtendem auf dem Kopf? Große Fledermausohren?",shape=box,color=red];
		j3345652817 -> j2315677919;
