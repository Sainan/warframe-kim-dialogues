	j1502623174 [label="Das ist mein Sichel-Vulpaphyla. Sie stammen von Deimos, dem befallenen Planeten. Ist sehr selten einen außerhalb von Deimos zu sehen. :) Sie sind harmlos. Naja, für dich jedenfalls.",shape=box,color=red];
		j1502623174 -> j2950462224;
	j1302474183 [label="Das it mein Panzer-Vulpaphyla. Sie stammen von Deimos, dem befallenen Planeten. :) Sie sind harmlos. Naja, für dich jedenfalls.",shape=box,color=red];
