	"Chat ends." [color=orange];
	j2146431788 [label="Sí, sí\nJa, ja\nHallo Freund jajaja",shape=box,color=blue];
		j2146431788 -> j2594312456;
	j3390664047 [label="Sie werden ewig bei mir leben \nAuch wenn sie einen Unfall hätten oder die gata mutante sie erwischen würde \nWenn das neue Jahr kommt\nAls wäre nichts passiert, ¿no?",shape=box,color=blue];
		j3390664047 -> j3310776490;
		j3390664047 -> j1325960325;
	j3310776490 [label="Hm, Ja. Hab ich gar nicht drüber nachgedacht. Die Schleife gilt auch für Tiere.",shape=box,color=red];
		j3310776490 -> j3084703085;
	j1325960325 [label="Ich glaube nicht, dass es Tieren so wichtig ist, wie Menschen. Das heißt, ich glaube nicht, dass es sie stört.",shape=box,color=red];
		j1325960325 -> j3084703085;
	j3084703085 [label="Sí \nDas bedeutet, dass ich Anita immer wieder dazu erziehen muss, nichts zu fressen, was sie nicht sollte jajaja \nUnd Tláloc wird nie aufhören zu beißen",shape=box,color=blue];
		j3084703085 -> j4167458994;
	j4167458994 [label="Aber es bedeutet auch, dass wenn ich sie verliere \nSie bald zurückkommen \nEs ist schön zu wissen, dass ich immer Gesellschaft haben werde",shape=box,color=blue];
		j4167458994 -> j1319721791;
