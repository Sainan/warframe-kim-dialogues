	j2009450134 [label="Ich nahm an, dass dir Haustiere lieber sind als Menschen und das bestätigt es.",shape=box,color=red];
		j2009450134 -> j201829899;
	j2770569962 [label="Ich nehme an, Anita und Tláloc sind zwei deiner Ratten?",shape=box,color=red];
		j2770569962 -> j3209672446;
	j2164501094 [label="¡JAJA! \nLo siento, lo siento \nEs ist nur so, dass \nMenschen waren nie eine Konstante in meinem Leben \nTiere schon",shape=box,color=blue];
