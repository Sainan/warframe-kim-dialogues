	j3695545502 [label="Gracias\nAber das ist die Natur des Lebens\nSie ist kurz",shape=box,color=blue];
		j3695545502 -> j2184127173;
	j2184127173 [label="Ratten leben im Vergleich zu Menschen kurz\nMenschen leben im Vergleich zu Bäumen kurz\nBäume leben im Vergleich zu Göttern kurz",shape=box,color=blue];
		j2184127173 -> j1271828881;
	j1271828881 [label="Und Käfer leben im Vergleich zu Ratten kurz\nEs ist alles relativ\nUnd wir drehen uns einfach immer weiter im Kreis, nicht wahr, jajaja",shape=box,color=blue];
		j1271828881 -> j2656719618;
	j2656719618 [label="Ich schätze, wir sind das, was Amir \"Grenzfälle\" nennt\nOder was auch immer",shape=box,color=blue];
