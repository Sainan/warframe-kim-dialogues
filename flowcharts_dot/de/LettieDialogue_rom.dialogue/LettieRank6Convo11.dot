		j2645325864 -> j660069179;
	j3167650761 [label="Dejar de hacerme mensa y hacer las cosas, jajaja\nIch denke nicht, ich sage nur\nWir müssen daran denken, im Moment zu leben",shape=box,color=blue];
		j3167650761 -> j1988881608;
	j660069179 [label="Por supuesto que sí\nIch denke, ich sage nur\nWir müssen daran denken, im Moment zu leben",shape=box,color=blue];
		j660069179 -> j1988881608;
	j1988881608 [label="Deshalb habe ich überhaupt Ratten\nIhr Leben ist kurz, aber sie vergessen nie, es zu leben\nErfreuen sich an jedem Krümel, den sie finden können\nUnd geben jedes Quäntchen Liebe zurück, das ihnen gegeben wird\nMan weiß nie, wann es weg sein wird",shape=box,color=blue];
