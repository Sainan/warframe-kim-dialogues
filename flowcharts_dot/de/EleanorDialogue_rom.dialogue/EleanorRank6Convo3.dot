digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"EleanorRank6Convo3 begins." [color=orange];
		"EleanorRank6Convo3 begins." -> j3792364543;
	j3792364543 [label="Ich weiß nicht, ob du es bemerkt hast, aber was absolut fantastisches ist passiert.",shape=box,color=blue];
		j3792364543 -> j1057301383;
	j1057301383 [label="Arthur singt wieder. Den Göttern sei Dank.",shape=box,color=blue];
		j1057301383 -> j3581291000;
		j1057301383 -> j4013354026;
		j1057301383 -> j2857888413;
	j3581291000 [label="Warum hat er aufgehört?",shape=box,color=red];
		j3581291000 -> j699633824;
	j4013354026 [label="Ich bin zwar kein besonders großer Fan, aber wenn es ihn glücklich macht ...",shape=box,color=red];
		j4013354026 -> j2681669631;
	j2857888413 [label="Ich bin froh. Er ist echt gut.",shape=box,color=red];
		j2857888413 -> j800071517;
	j699633824 [label="Lampenfieber. So einfach ist das.",shape=box,color=blue];
		j699633824 -> j3740131768;
	j2681669631 [label="Vielen Dank, dass du es so einfühlsam ausgedrückt hast.",shape=box,color=blue];
		j2681669631 -> j3282861871;
	j800071517 [label="Oder?",shape=box,color=blue];
		j800071517 -> j2152973432;
	j3740131768 [label="Es ist schwer vorstellbar, dass jemand, der so mutig wie Arthur ist, so verängstigt sein kann.",shape=box,color=red];
		j3740131768 -> j2083633736;
	j3282861871 [label="Es ist mir wichtig, dass du dir Gedanken darüber machst.",shape=box,color=blue];
		j3282861871 -> j2866338616;
	j2152973432 [label="Wenn ich daran denke, wie mühsam es war, ihn dazu zu bringen, vor einer Menschenmenge zu stehen und zu singen ...",shape=box,color=blue];
		j2152973432 -> j786935068;
	j2083633736 [label="Was ist die Schwachstelle in seiner Rüstung?",shape=box,color=red];
		j2083633736 -> j1406571018;
	j2866338616 [label="Insbesondere, weil es einen Grund dafür gab, warum er das Singen aufgab. Einen Grund, den du unmöglich hättest wissen können.",shape=box,color=blue];
		j2866338616 -> j3931199477;
		j2866338616 -> j1909437141;
	j786935068 [label="... also das erste Mal, als er seinen Nerven verlor, meine ich.",shape=box,color=blue];
		j786935068 -> j2461079442;
	j1406571018 [label="Es ist der Name. Das ist das verdammte Problem.",shape=box,color=blue];
		j1406571018 -> j83904805;
	j3931199477 [label="Nicht genug moralische Unterstützung?",shape=box,color=red];
		j3931199477 -> j1843394506;
	j1909437141 [label="Ein zu großes Publikum?",shape=box,color=red];
		j1909437141 -> j1843394506;
	j2461079442 [label="Das Sonnenwenden-Konzert in den Achtzigern. Stell dir unseren kleinen Mann in kurzen Hosen vor, wie er das Solo zu \"How Bright the Dew Upon That Morn\" singt.",shape=box,color=blue];
		j2461079442 -> j812333859;
		j2461079442 -> j1945518595;
	j83904805 [label="\"Oh, dein Name ist Nightingale - so wie Nachtigall? Haha, dann sing uns ein Lied.\"",shape=box,color=blue];
		j83904805 -> j1088491765;
	j1843394506 [label="Denn selben Witz immer und immer wieder zu hören.",shape=box,color=blue];
		j1843394506 -> j1406571018;
	j812333859 [label="Was für eine Vorstellung.",shape=box,color=red];
		j812333859 -> j2986120883;
	j1945518595 [label="Das kenn ich nicht.",shape=box,color=red];
		j1945518595 -> j4045054457;
	j1088491765 [label="Andere Wichser, aber immer derselbe Spruch, unser ganzes Leben lang. Und jetzt macht Viktor es.",shape=box,color=blue];
		j1088491765 -> j2419045777;
	j2986120883 [label="Er hat es so ernst genommen. Hat wochenlang geübt und dann, am Abend der Vorstellung, bekam er kalte Füße. Hat sich hinter den Kulissen versteckt uns ich geweigert, rauszugehen.",shape=box,color=blue];
		j2986120883 -> j3359046159;
		j2986120883 -> j3740131768;
	j4045054457 [label="Nun. Ich würde es dir vorsingen, aber ich bin mir nicht sicher, was für Geräusche dabei herauskäme, wenn ich es versuchte.",shape=box,color=blue];
		j4045054457 -> j916784398;
	j2419045777 [label="+5 Chemistry",color=orange];
		j2419045777 -> j1836681435;
	j3359046159 [label="Wie hast du ihn überzeugt?",shape=box,color=red];
		j3359046159 -> j1683684089;
	j916784398 [label="Verdammter Techrot. Ich hab versucht Aoi Happy Birthday zu singen und es klang, als ob man einen Ochsenfrosch in einen Schredder geworfen hätte.",shape=box,color=blue];
		j916784398 -> j3819574458;
	j1836681435 [label="Ehrlich, ich bin so stolz auf Arthur, dass er den Mut hat zu singen.",shape=box,color=blue];
		j1836681435 -> "Chat ends.";
	j1683684089 [label="Ich habe ihm wortwörtlich in den Hintern getreten. Ich bin nicht stolz darauf. Aber es musste getan werden.",shape=box,color=blue];
		j1683684089 -> j3888512752;
	j3819574458 [label="Tut mir leid. Das muss hurt sein, wenn man nicht mehr singen kann.",shape=box,color=red];
		j3819574458 -> j2211449564;
	"Chat ends." [color=orange];
	j3888512752 [label="Die Sache war, er hat nicht die ganze Zeit geübt, um unsere Eltern oder Mrs. Henshaw stolz zu machen.",shape=box,color=blue];
		j3888512752 -> j1954215873;
	j2211449564 [label="Oh, es ist kein großer Verlust. Ich konnte eh nicht singen.",shape=box,color=blue];
		j2211449564 -> j1220011355;
	j1954215873 [label="Er hat gesungen, weil er es geliebt hat. Aber als das Rampenlicht auf ihn fiel, war er wie versteinert.",shape=box,color=blue];
		j1954215873 -> j1420303714;
		j1954215873 -> j2083633736;
	j1220011355 [label="Was dem Singen am nächsten kam, war als ich die Songtexte von den Shag Cannons in meinem Zimmer geschrien hab. Ich wollte in Mandy Jellicoes Band sein, weil ich in sie verknallt war.",shape=box,color=blue];
		j1220011355 -> j3493075433;
	j1420303714 [label="Vielleicht musste er einfach daran erinnert werden, warum es geliebt hat.",shape=box,color=red];
		j1420303714 -> j1730633169;
	j3493075433 [label="Mein Vater hämmerte darauf an die Tür und drohte mir den Mund mit Karbol auszuwaschen, sollte er noch mehr von dem Dreck hören.",shape=box,color=blue];
		j3493075433 -> j3649920883;
	j1730633169 [label="Arthur ist am glücklichsten, wenn er Arthur vergessen kann. Wenn er den Geist seiner Selbst zur Ruhe betten kann und einfach nur IST.",shape=box,color=blue];
		j1730633169 -> j400599358;
	j3649920883 [label="(Ich weiß nicht, ob es da, wo du herkommst, 'Punk' gibt, aber da ist der Punkt nicht singen zu können eher eine Voraussetzung und kein Nachteil.)",shape=box,color=blue];
		j3649920883 -> j580056735;
		j3649920883 -> j490853898;
	j400599358 [label="Bier hilft.",shape=box,color=blue];
		j400599358 -> j488403691;
	j580056735 [label="Wir haben keinen Punk, aber wir haben Skeg.",shape=box,color=red];
		j580056735 -> j600967895;
	j490853898 [label="Was ist mit der Band passiert?",shape=box,color=red];
		j490853898 -> j4034181789;
	j488403691 [label="Und es dürfte auch nicht schaden, dass Velimir sich wie der Vater verhält, den sich Arthur ausgesucht hätte, wenn er einen aus dem Katalog hätte bestellen können.",shape=box,color=blue];
		j488403691 -> j2685695099;
		j488403691 -> j190039200;
	j600967895 [label="Wage es ja nicht so etwas in den Chat zu schreiben und dann nicht weiter zu erläutern.",shape=box,color=blue];
		j600967895 -> j1784601518;
	j4034181789 [label="Sie haben nicht einmal einen 'Mitleidsauftritt' in der örtlichen Kneipe bekommen.",shape=box,color=blue];
		j4034181789 -> j3713742466;
	j2685695099 [label="Kann ich ihm nicht verübeln.",shape=box,color=red];
		j2685695099 -> j4262479512;
	j190039200 [label="Ich hätte gedacht, dass Velimir und Minerva euren tatsächlichen Eltern vielleicht etwas zu ähnlich sind.",shape=box,color=red];
		j190039200 -> j1832094346;
	j1784601518 [label="Ich verlange zu wissen, was Skeg ist.",shape=box,color=blue];
		j1784601518 -> j2050324299;
	j3713742466 [label="Es kam heraus, dass Mandy vorhatte auf das Publikum zu spucken und damit hatte sich alles erledigt. Schade.",shape=box,color=blue];
		j3713742466 -> j2766149933;
		j3713742466 -> j726639526;
	j4262479512 [label="Arthur hat den Teddybären monatelang mit sich herumgeschleppt. Jetzt taucht Velimir auf. Es ist, als hätte das Schicksal ein bärenförmiges Loch in Arthurs Leben gespürt ...",shape=box,color=blue];
		j4262479512 -> j2852242795;
	j1832094346 [label="Nun ja. Vielleicht trägt das Gezanke dazu bei, dass er sich wie zu Hause fühlt.",shape=box,color=blue];
		j1832094346 -> j828749547;
	j2050324299 [label="Denn es hört sich an wie etwas, dass man in kleinen Tüten im Ludston Anwesen verkaufen würde.",shape=box,color=blue];
		j2050324299 -> j2172984602;
		j2050324299 -> j485610151;
	j2766149933 [label="Wer fürchtet sich vor ein bisschen Spucke?",shape=box,color=red];
		j2766149933 -> j2952086874;
	j726639526 [label="Spucken? Hört sich nach etwas an, woran die Technocyte Coda eine Freude hätten.",shape=box,color=red];
		j726639526 -> j1539232044;
	j2852242795 [label="+5 Chemistry",color=orange];
		j2852242795 -> j2234052431;
	j828749547 [label="+5 Chemistry",color=orange];
		j828749547 -> j252073943;
	j2172984602 [label="Es ist wie Musik, nur dass sie durch das Schlagen auf Rohre erzeugt wird. Und Lüftungen. Und Helmen der Corpus. Und so ziemlich allem, worauf man schlagen kann.",shape=box,color=red];
		j2172984602 -> j2360853610;
	j485610151 [label="Es ist einfach nur sinnloser Lärm. Nur Ventkids mögen ihn.",shape=box,color=red];
		j485610151 -> j3343493680;
	j2952086874 [label="+5 Chemistry",color=orange];
		j2952086874 -> j3856448490;
	j1539232044 [label="Das war eine andere Zeit. Damals war Punk noch wahrer Punk.",shape=box,color=blue];
		j1539232044 -> j897924288;
	j2234052431 [label="... tut mir leid. Es steht mir nicht zu, zu spekulieren. Ich bin nur glücklich, dass er glücklich ist.",shape=box,color=blue];
		j2234052431 -> "Chat ends.";
	j252073943 [label="Seltsam, für was man Heimweh verspüren kann, oder?",shape=box,color=blue];
		j252073943 -> "Chat ends.";
	j2360853610 [label="Hat was mit den Ventkids zu tun.",shape=box,color=red];
		j2360853610 -> j3465497916;
	j3343493680 [label="Hm. \"Sinnloser Lärm\". Das habe ich schon mal gehört.",shape=box,color=blue];
		j3343493680 -> j3247381221;
	j3856448490 [label="Ich war es verdammt nochmal nicht, dass kann ich dir sagen.",shape=box,color=blue];
		j3856448490 -> j897924288;
	j897924288 [label="... Ich dachte nur \"Ich wünschte, sie könnte mich jetzt sehen\". Ich denke, ihr würde mein jetziges Ich gefallen.",shape=box,color=blue];
		j897924288 -> j1831947347;
	j3465497916 [label="+5 Chemistry",color=orange];
		j3465497916 -> j1023975889;
	j3247381221 [label="Ich glaube nicht, dass es irgendetwas gibt, dass so sinnlos ist, dass es nicht zu einem Soundtrack für die Jugend werden kann.",shape=box,color=blue];
		j3247381221 -> j3569198907;
	j1831947347 [label="Bei den Göttern schau mich nur an. Ich werde hier ganz sentimental und nostalgisch.",shape=box,color=blue];
		j1831947347 -> j579083934;
	j1023975889 [label="Hmm. Hört sich an wie die Musik von Überlebenden. Ich würde es gerne mal hören, solltest du eine Chance haben, es für mich aufzunehmen.",shape=box,color=blue];
		j1023975889 -> j1244213943;
	j3569198907 [label="Ich höre besser auf. Ich werde ganz sentimental.",shape=box,color=blue];
		j3569198907 -> "Chat ends.";
	j579083934 [label="+5 Chemistry",color=orange];
		j579083934 -> j563150633;
	j1244213943 [label="Aber wir spielen es besser nicht über die Lautsprecher des Einkaufszentrums ab.",shape=box,color=blue];
		j1244213943 -> "Chat ends.";
	j563150633 [label="Ich mach dann besser mal weiter. Danke fürs Zuhören.",shape=box,color=blue];
		j563150633 -> "Chat ends.";
