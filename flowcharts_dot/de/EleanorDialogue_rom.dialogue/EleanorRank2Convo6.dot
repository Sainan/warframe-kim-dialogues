		1975 -> 787;
	786 [label="Er ist ein charmanter, kleiner Schelm. Warum fragst du?",shape=box,color=blue];
		786 -> 788;
		786 -> 789;
	787 [label="Genauso wie jeder andere, schätze ich. Warum fragst du?",shape=box,color=blue];
		787 -> 788;
		787 -> 789;
	788 [label="Amir versucht, das Team für eine Partie Fables & Frontiers zusammenzutrommeln, und ich habe gesagt, ich würde helfen.",shape=box,color=red];
		788 -> 790;
	789 [label="Amir möchte unbedingt Fables & Frontiers mit uns allen spielen. Bist du dabei?",shape=box,color=red];
		789 -> 790;
	790 [label="Ah. Ich verstehe. Du bist der auserwählte Bote, der vom Donnerkeilkönig geschickt wurde, um die schöne Eleanor anzuwerben. Zweifellos erwarten mich allerlei Gaunereien. Firlefanz und so weiter.",shape=box,color=blue];
		790 -> 791;
		790 -> 792;
	791 [label="Ja, ich glaube, das wird reine Zeitverschwendung, aber ich versuche, nett zu sein.",shape=box,color=red];
		791 -> 793;
	792 [label="Ehrlich gesagt, ich glaube, es wird Spaß machen. Und es scheint ihm viel zu bedeuten.",shape=box,color=red];
		792 -> 794;
	793 [label="Ich werde dir einen Gefallen tun und ihm NICHT erzählen, was du gerade gesagt hast. Ein guter Rat: Behandel ihn in Zukunft mit mehr Respekt in meiner Gegenwart.",shape=box,color=blue];
		793 -> 436;
	794 [label="Ein paar Stunden mit alberner Stimme zu reden und so zu tun als ob, klingt ehrlich gesagt perfekt. Ich bin dabei.",shape=box,color=blue];
		794 -> 795;
	436 [label="Chat ends.",color=orange];
	795 [label="Oh! Ich möchte ein Zauberer sein. Oder vielleicht ein Barde. Oder vielleicht beides? Kann man beides SEIN?",shape=box,color=blue];
		795 -> 796;
	796 [label="Oder ich eine Sumpfhexe! Solange ich ein enges Mieder tragen darf, wohlgemerkt. Mutter Moosbusen wird deine Knochen abnagen, kleines Männchen.",shape=box,color=blue];
