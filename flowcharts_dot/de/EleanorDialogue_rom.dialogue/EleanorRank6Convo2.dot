digraph {
	2845 [label="EleanorRank6Convo2 begins.",color=orange];
		2845 -> 2846;
	2846 [label="Hey, ich muss ein paar Ideen mit dir austauschen.",shape=box,color=blue];
		2846 -> 2847;
	2847 [label="Ich habe über Fiendsnight nachgedacht. Ich habe mich seit Jahren nicht dafür verkleidet, aber ich hab Amirs Comics durchgeblättert und mir kam plötzlich der Gedanke: Warte - ich könnte die Contessa sein! Ich habe die Eckzähne dafür!",shape=box,color=blue];
		2847 -> 2848;
	2848 [label="Aber wäre das zu offensichtlich? Sollte ich doch besser Dandy Damage sein?",shape=box,color=blue];
		2848 -> 2849;
		2848 -> 2850;
		2848 -> 2851;
	2849 [label="Wer ist Dandy Damage?",shape=box,color=red];
		2849 -> 2852;
	2850 [label="Du könntest dich immer als die Lotus verkleiden, falls du die Leute verwirren möchtest.",shape=box,color=red];
		2850 -> 2853;
	2851 [label="... Du müsstest mir erklären, was Fiendsnight ist.",shape=box,color=red];
		2851 -> 2854;
	2852 [label="Oh je. ",shape=box,color=blue];
		2852 -> 2855;
	2853 [label="Bei den Göttern, nein. Ich habe sie in deinem Kopf gesehen. Ich könnte ihr niemals gerecht werden.",shape=box,color=blue];
		2853 -> 2856;
	2854 [label="Mhm. Ich vergesse manchmal, dass du in dieser Hinsicht unschuldig bist.",shape=box,color=blue];
		2854 -> 2857;
	2855 [label="Dandy Damage ging, damit Temple and the Rippers laufen konnten. Er war der Albtraum einer jeden Mutter und der katastrophale Traum eines jeden Teenagers.",shape=box,color=blue];
		2855 -> 2858;
	2856 [label="Und dieser Helm. Ist das ein Helm? Oder ist es ein Teil von ihr? Wie kann sie mit ihm etwas sehen?",shape=box,color=blue];
		2856 -> 2859;
	2857 [label="Fiendsnight feiert den schwinden Einfluss von Sol auf die Welt.",shape=box,color=blue];
		2857 -> 2860;
	2858 [label="Gebaut wie eine Stabheuschrecke, geschminkt wie eine Königin des Stummfilms. Ein Mund wie Bonbons. Nadelstreifen und Leder und Stachelhalsband. Wangenknochen, wie die Hüften eines Skeletts.",shape=box,color=blue];
		2858 -> 2861;
		2858 -> 2862;
	2859 [label="Wie dem auch sei, es sind drei von ihr in einem Körper. Ich könnte nie eine den anderen vorziehen.",shape=box,color=blue];
		2859 -> 2861;
		2859 -> 2862;
	2860 [label="Was im ersten Moment nicht viel Sinn ergibt. Warum sollte man die kommende Dunkelheit feiern? Warum Gesetzlosigkeit und Anarchie feiern?",shape=box,color=blue];
		2860 -> 2863;
	2861 [label="Sich mit Kostümen zu verkleiden? Parties? In einer Kriegszone? Denkst du wirklich, dass das passieren wird?",shape=box,color=red];
		2861 -> 2864;
	2862 [label="Weißt du, Fiendsnight hört sich sehr wie Naberus an. Die Leute verkleiden sich dafür auch.",shape=box,color=red];
		2862 -> 2864;
	2863 [label="Vielleicht ist es ein wenig wie eine Impfung. Ein kleines Bisschen von dem, was wir fürchten, um uns zu stärken. Oder vielleicht ist es nur eine Ausrede, die Teufelsmaske aufzusetzen und die Hölle loszulassen.",shape=box,color=blue];
		2863 -> 2861;
		2863 -> 2862;
	2864 [label="... Wahrscheinlich bin ich einfach nur albern. Kindisch. Nicht wahr?",shape=box,color=blue];
		2864 -> 2865;
	2865 [label="Oh, was hab ich mir nur gedacht.",shape=box,color=blue];
		2865 -> 2866;
	2866 [label="Ich muss mich doch nicht verkleiden, oder? Ich bin schon ein Monster. Für immer und ewig.",shape=box,color=blue];
		2866 -> 2867;
	2867 [label="Check boolean EleanorDating",color=orange];
		2867 -> 2868 [label=true,color=green];
		2867 -> 2869 [label=true,color=green];
		2867 -> 2870 [label=true,color=green];
		2867 -> 2869 [label=false,color=brown];
		2867 -> 2870 [label=false,color=brown];
	2868 [label="Du bist das Monster, das ich liebe, Eleanor. Ich bereue nichts.",shape=box,color=red];
		2868 -> 2871;
	2869 [label="Ich fange an zu glauben, dass es dir Spaß macht, so über dich selbst zu sprechen.",shape=box,color=red];
		2869 -> 2872;
	2870 [label="Nein. Echte Monster kümmern sich nicht um andere, so wie du es tust.",shape=box,color=red];
		2870 -> 2873;
	2871 [label="+5 Chemistry",color=orange];
		2871 -> 2874;
	2872 [label="Wenn du das jedoch wirklich von dir glaubst, dann scheint Fiendsnight die perfekte Möglichkeit zu sein dies zu feiern.",shape=box,color=red];
		2872 -> 2875;
		2872 -> 2873;
	2873 [label="Ich weiß, dass es dir Angst macht, zu was du werden könntest. Aber das bist du JETZT nicht.",shape=box,color=red];
		2873 -> 2876;
	2874 [label="Oh ja! Wie dumm von mir. Ich hatte ganz vergessen, dass unsere kleine Geschichte für das Monster glücklich endet.",shape=box,color=blue];
		2874 -> 2877;
	2875 [label="SEI das Monster. Steh dazu. Für diese eine Nacht im Jahr, trage den Titel mit Stolz.",shape=box,color=red];
		2875 -> 2878;
	2876 [label="Also, verkleide dich. Hab Spaß daran. Beim Void, alle Hex könnten etwas davon gebrauchen.",shape=box,color=red];
		2876 -> 2879;
	2877 [label="Verzeih mir. Ich kann immer noch nicht ganz fassen, dass du dies wirklich WILLST. Vielleicht musst du mich noch ein wenig weiter davon überzeugen.",shape=box,color=blue];
		2877 -> 2880;
	2878 [label="Oh es gibt SO VIELE Gründe, warum dies eine FURCHTBARE IDEE ist",shape=box,color=blue];
		2878 -> 2881;
	2879 [label="Ich nehme dein Wort an. Und danke. Nochmals. x",shape=box,color=blue];
		2879 -> 2882;
	2880 [label="Verschlingen wir einander später. xxx",shape=box,color=blue];
		2880 -> 2883;
	2881 [label="SO. VIELE.",shape=box,color=blue];
		2881 -> 2884;
	2882 [label="Chat ends.",color=orange];
	2883 [label="Chat ends.",color=orange];
	2884 [label="(Ich komm gerade auf keinen, aber ich bin mir sicher, es gibt DUTZENDE)",shape=box,color=blue];
		2884 -> 2885;
	2885 [label="... scheiße.",shape=box,color=blue];
		2885 -> 2886;
	2886 [label="du hast mich höchst geschickt auf meinem eigenen schaschlik aufgespießt. sei verdammt. gut gemacht. x",shape=box,color=blue];
		2886 -> 2887;
	2887 [label="Chat ends.",color=orange];
}