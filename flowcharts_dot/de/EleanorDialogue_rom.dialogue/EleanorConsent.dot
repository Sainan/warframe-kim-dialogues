	"Chat ends." [color=orange];
	j3364311394 [label="Check boolean EleanorConsentComplete",color=orange];
		j3364311394 -> "Chat ends." [label=true,color=green];
		j3364311394 -> j3705713567 [label=false,color=brown];
	j3528729371 [label="Check boolean EleanorPolyamorySuccess",color=orange];
		j3528729371 -> j3364311394 [label=true,color=green];
		j3528729371 -> "Chat ends." [label=false,color=brown];
	j3705713567 [label="Ich glaube, das Einzige, was mich daran stört, ist, dass ich zuerst Gedanken an jemanden in deinem Kopf entdeckt habe.",shape=box,color=blue];
		j3705713567 -> j2627341545;
	j2627341545 [label="Nicht, dass ich nicht wüsste, dass du kurz davor warst, höflich um Erlaubnis zu bitten. Hallo.",shape=box,color=blue];
		j2627341545 -> j1908864207;
	j1908864207 [label="Die Antwort ist ein sehr schmollendes, mit verschränkten Armen einhergehendes \"Ja, natürlich\", während ich hier sitze und nicht daran denke, wie du dich mit diesem wunderschönen Wesen, das ich in deinen Fantasien erblickt habe, vergnügst.",shape=box,color=blue];
		j1908864207 -> j2262766813;
	j2262766813 [label="Das jetzt in MEINEN Fantasien existiert, da ich hier in dieser Zeit und an diesem Ort festsitze, vielen Dank!",shape=box,color=blue];
		j2262766813 -> j2184443903;
	j2184443903 [label="Es tut mir leid. Ich wollte dich tatsächlich um deine Zustimmung bitten. Ich weiß, wir haben das vorher noch nie besprochen. Ich wollte nur sichergehen, dass das alles für dich in Ordnung ist.",shape=box,color=red];
		j2184443903 -> j3741153032;
	j3741153032 [label="Natürlich ist es das! Ich kann die Person vor deinem inneren Auge sehen. Und wenn du ihr vertraust, dann vertraue ich diesem Geschöpf auch.",shape=box,color=blue];
		j3741153032 -> j948331489;
	j948331489 [label="Ich bin einfach traurig, dass ich damit keine Erfahrung machen kann.",shape=box,color=blue];
		j948331489 -> j1682723121;
	j1682723121 [label="+20 Chemistry",color=orange];
		j1682723121 -> j3099693822;
	j3099693822 [label="Aber vielleicht kann ich es stellvertretend durch dich, das ist doch mal eine Idee.",shape=box,color=blue];
		j3099693822 -> j298331240;
	j298331240 [label="Boolean EleanorConsentComplete is now true.",color=orange];
		j298331240 -> "Chat ends.";
}