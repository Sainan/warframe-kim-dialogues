	3222 [label="oh.",shape=box,color=blue];
		3222 -> 3225;
		3222 -> 3226;
	3223 [label="Ja. Sie hat es einfach mitten in einem Gespräch fallen lassen. 'Du bist cool, aber du bist ein Minenfeld. Ich weiß nie, wie du auf irgendetwas reagieren wirst.'",shape=box,color=blue];
		3223 -> 3218;
		3223 -> 3219;
	3224 [label="Freut mich das zu hören. Danke.",shape=box,color=blue];
		3224 -> 3227;
	3225 [label="Ich bin froh, dass Kaya dich darauf angesprochen hat. Ich habe hier Dinge gesagt, die ich für harmlos hielt, und du hast reagiert, als hätte ich dir die Haare in Brand gesetzt.",shape=box,color=red];
		3225 -> 3228;
		3225 -> 3229;
	3226 [label="Du reagierst manchmal wirklich extrem. In keinem Verhältnis zu dem, was ich dir gesagt habe.",shape=box,color=red];
		3226 -> 3229;
		3226 -> 3228;
	3227 [label="Teenager, oder?",shape=box,color=blue];
		3227 -> 3230;
	3228 [label="Es ist, als würdest du sofort zur schlimmstmöglichen Interpretation dessen springen, was ich gemeint haben könnte.",shape=box,color=red];
		3228 -> 3231;
	3229 [label="Manchmal brichst du das Gespräch einfach komplett ab und ich bekomme nicht einmal die Chance, etwas zu erklären.",shape=box,color=red];
		3229 -> 3231;
	3230 [label="Chat ends.",color=orange];
	3231 [label="Nun.",shape=box,color=blue];
		3231 -> 3232;
