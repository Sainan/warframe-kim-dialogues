		3216 -> 3217;
	3217 [label="Kaya sagt nämlich, dass ich das bin. Und ich hatte einen dieser 'Oh Scheiße'-Momente, als ich auf all die Gespräche zurückgeschaut habe, die ich mit jemandem geführt habe, und mich selbst plötzlich in einem neuen Licht sah.",shape=box,color=blue];
