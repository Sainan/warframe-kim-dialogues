	3060 [label="Dort, wo früher diese Versicherung war, ist jetzt ein Drifter-förmiges Loch.",shape=box,color=blue];
		3060 -> 3063;
	3061 [label="Wir haben beide unsere Narben, mein Schatz. ",shape=box,color=blue];
