digraph {
	2968 [label="EleanorRank6Convo4 begins.",color=orange];
		2968 -> 2969;
	2969 [label="Kennst du das auch, wenn man unter der Dusche steht und plötzlich kommt so eine komische kleine Stimme und fragt dich etwas, worüber du noch nie nachgedacht hast?",shape=box,color=blue];
		2969 -> 2970;
		2969 -> 2971;
		2969 -> 2972;
	2970 [label="Nicht wirklich, nein. [Ende.]",shape=box,color=red];
		2970 -> 2973;
	2971 [label="Wie etwa: \"Was dachten die Menschen auf der Erde, als Lua plötzlich wieder am Himmel erschien?\"",shape=box,color=red];
		2971 -> 2974;
	2972 [label="Du meinst so etwas wie: \"Operator! Könntet ihr euch vorstellen, euren Kubrow ausstopfen zu lassen?\"",shape=box,color=red];
		2972 -> 2975;
	2973 [label="Chat ends.",color=orange];
	2974 [label="Genau das, ja.",shape=box,color=blue];
		2974 -> 2976;
	2975 [label="Das ist einfach nur Ordis. Er macht das.",shape=box,color=red];
		2975 -> 2977;
	2976 [label="Moment",shape=box,color=blue];
		2976 -> 2978;
	2977 [label="Himmel. Nein, ich meine eine innere Stimme.",shape=box,color=blue];
		2977 -> 2979;
	2978 [label="Lua ist verschwunden?",shape=box,color=blue];
		2978 -> 2980;
	2979 [label="Ein bisschen so, als ob dein Gehirn sich selbst beschäftigt, während du dich um die wichtige Aufgabe der Körperhygiene kümmerst.",shape=box,color=blue];
		2979 -> 2981;
	2980 [label="Für wie lange? Wohin ist sie verschwunden? Was ist mit den Gezeiten passiert?",shape=box,color=blue];
		2980 -> 2982;
		2980 -> 2983;
	2981 [label="Mir passiert das ständig. Seltsam zufällig. In letzter Zeit so oft, dass ich mich frage, ob sie überhaupt aus meinem eigenen Kopf kommt.",shape=box,color=blue];
		2981 -> 2984;
	2982 [label="Der Reihe nach: keine Ahnung, in den Void, keine Ahnung.",shape=box,color=red];
		2982 -> 2985;
	2983 [label="Die Lotus schickte sie gegen Ende des Alten Krieges in den Void. Der Zwerg hat sie erst vor Kurzem wieder herausgeholt.",shape=box,color=red];
		2983 -> 2986;
	2984 [label="Einige dieser Stimmen habe ich in Gemälde verwandelt.",shape=box,color=blue];
		2984 -> 2985;
	2985 [label="egal, wir können darauf zurückkommen.",shape=box,color=blue];
		2985 -> 2987;
	2986 [label="Keine Ahnung, was die Gezeiten angeht.",shape=box,color=red];
		2986 -> 2988;
	2987 [label="Also, zufällige Gedanken unter der Dusche. Heute Morgen hatte ich einen absoluten Knaller.",shape=box,color=blue];
		2987 -> 2989;
	2988 [label="Wie konnte die Lotus einen ganzen MOND versetzen?",shape=box,color=blue];
		2988 -> 2985;
	2989 [label="Die Stimme fragte: \"Hey, was, wenn es die Götter wirklich gibt?\"",shape=box,color=blue];
		2989 -> 2990;
	2990 [label="Mir wurde ganz schwummrig. Ich musste mein Gesicht in kaltes Wasser halten, um wieder auf die Beine zu kommen.",shape=box,color=blue];
		2990 -> 2991;
		2990 -> 2992;
		2990 -> 2993;
	2991 [label="Was ist daran seltsam? Scheint mir eine ziemlich einfache Frage zu sein.",shape=box,color=red];
		2991 -> 2994;
	2992 [label="... glauben Leute etwa nicht, dass die Götter real sind? Bin mir ziemlich sicher, dass Lettie das tut.",shape=box,color=red];
		2992 -> 2995;
	2993 [label="Ja, das ist ein furchtbarer Gedanke.",shape=box,color=red];
		2993 -> 2996;
	2994 [label="Ah, deshalb liebe ich es, mit dir über diese Dinge zu sprechen",shape=box,color=blue];
		2994 -> 2997;
	2995 [label="Ach, komm schon. Niemand glaubt wirklich, dass Götter real sind. Nicht so wie, ich weiß nicht, Tische und Stühle.",shape=box,color=blue];
		2995 -> 2998;
	2996 [label="Nicht wahr? Was, wenn jedes Mal, wenn du denkst, das Universum schickt dir eine Nachricht, dies tatsächlich der Fall ist?",shape=box,color=blue];
		2996 -> 2999;
	2997 [label="dein Leben ist so fantastisch absurd, dass die Realität der Götter für dich eine ebenso natürliche Spekulation ist wie die relativen Vorzüge von Pizzabelägen",shape=box,color=blue];
		2997 -> 3000;
	2998 [label="Echte Götter sind wie Dorfbrunnen und Außentoiletten. Sie waren etwas, was Leute FRÜHER hatten. ",shape=box,color=blue];
		2998 -> 3001;
	2999 [label="Stell dir vor, alles liegt in den Händen dieser kleinen, unsterblichen Bastarde, die das Sagen haben, nur weil es so ist, nicht weil sie es verdient haben.",shape=box,color=blue];
		2999 -> 3002;
	3000 [label="Vielleicht bist du sogar einem Gott begegnet. Wenn es das ist, was die Gleichgültigkeit ist.",shape=box,color=blue];
		3000 -> 3003;
	3001 [label="Heutzutage sind sie bloß Symbole oder Metaphern oder ähnlicher Blödsinn.",shape=box,color=blue];
		3001 -> 3004;
		3001 -> 3005;
	3002 [label="Und das Verrückte daran ist, dass Menschen tatsächlich so gelebt haben. Das war ihre Realität, jeden Tag ihres Lebens.",shape=box,color=blue];
		3002 -> 3006;
	3003 [label="Du hast mich gerade an etwas erinnert, damals auf der Zariman. Als ich zum ersten Mal der Gleichgültigkeit begegnet bin.",shape=box,color=red];
		3003 -> 3007;
	3004 [label="Vielleicht haben Leute einfach weniger Angst?",shape=box,color=red];
		3004 -> 3008;
	3005 [label="Ich dachte, Sol und Lua wären eure Götter.",shape=box,color=red];
		3005 -> 3009;
	3006 [label="Für sie waren die Götter so real wie das Wetter. Und den Göttern waren sie genauso so egal.",shape=box,color=blue];
		3006 -> 3010;
	3007 [label="Damals wusste ich natürlich nicht, dass es das war. Ich weiß aber noch, was es sagte. ",shape=box,color=red];
		3007 -> 3011;
	3008 [label="Ich denke, das ist es, ja.",shape=box,color=blue];
		3008 -> 3012;
	3009 [label="Ja, das sind sie. Aber es sind auch nur Himmelskörper.",shape=box,color=blue];
		3009 -> 3013;
	3010 [label="Ehrlich gesagt, klingt das nicht wirklich anders als das Leben unter den Orokin.",shape=box,color=red];
		3010 -> 3014;
	3011 [label="Ich sagte, es könne mein Licht nehmen, und es grinste mich an und antwortete: 'Danke, Kleiner. Ich glaube, das werde ich.'",shape=box,color=red];
		3011 -> 3015;
	3012 [label="Ich denke, ich weiß auch, warum.",shape=box,color=blue];
		3012 -> 3016;
	3013 [label="Genau wie Britannien ein Land mit Namen, Identität und so ist, aber gleichzeitig auch nur eine Masse aus Erde und Gestein. Es kann beides gleichzeitig sein.",shape=box,color=blue];
		3013 -> 3017;
	3014 [label="Unsterblich, kleinlich, verantwortlich, weil sie einfach das Sagen hatten ...",shape=box,color=red];
		3014 -> 3018;
	3015 [label="Oh verdammt, du machst mir Gänsehaut",shape=box,color=blue];
		3015 -> 3019;
	3016 [label="Es dreht sich alles um Licht.",shape=box,color=blue];
		3016 -> 3020;
	3017 [label="Du kannst an einem schönen sonnigen Tag hinausgehen, dankbar sein, zu Sol aufblicken und \"Prost!\" sagen. Und es ernst meinen. Das ist menschlich.",shape=box,color=blue];
		3017 -> 3021;
	3018 [label="Richtig. Ihr HATTET lebende Götter. Aber ihr habt sie alle getötet.",shape=box,color=blue];
		3018 -> 3022;
	3019 [label="Der Teufel ist ein Verfechter dessen, was die Worte des Gesetzes angeht, in allen alten Volksmärchen",shape=box,color=blue];
		3019 -> 3023;
	3020 [label="Was sind Sol und Lua denn eigentlich? Bevor irgendjemand auf die Idee kam, sie als Götter zu betrachten? Sie waren LICHTER.",shape=box,color=blue];
		3020 -> 3024;
		3020 -> 3025;
	3021 [label="Aber niemand glaubt heutzutage mehr, dass Sol oder Lua buchstäblich eine menschliche Frau geschwängert oder das Kind irgendeines Mannes aufgezogen haben und der König stammt von ihnen ab.",shape=box,color=blue];
		3021 -> 3026;
	3022 [label="(Versteh mich nicht falsch, ich bin froh darüber für dich.)",shape=box,color=blue];
		3022 -> 3027;
	3023 [label="Glaubst du, es glaubt, du hättest ihm etwas versprochen? Dein 'Licht'?",shape=box,color=blue];
		3023 -> 3028;
		3023 -> 3029;
	3024 [label="Richtig. Licht symbolisiert das Gute, wohin man auch geht.",shape=box,color=red];
		3024 -> 3030;
	3025 [label="Die einzigen Lichter, ddie die Menschheit für eine sehr lange Zeit hatte.",shape=box,color=red];
		3025 -> 3030;
	3026 [label="Früher haben Leute so etwas geglaubt. Heute wissen wir, dass diese Geschichten nur Legenden waren. Wir sind ihnen entwachsen.",shape=box,color=blue];
		3026 -> 3031;
		3026 -> 3032;
	3027 [label="Du verwechselst mich mit dem Zwerg. Ich war nie Teil des großen Tenno-Aufstands.",shape=box,color=red];
		3027 -> 3033;
	3028 [label="Es sagte, wir hätten einen 'Deal' gemacht. Also denkt es wohl, ich schulde ... etwas.",shape=box,color=red];
		3028 -> 3034;
	3029 [label="Ich meinte die Kugellampe, die ich trug, aber wer weiß, was es gemeint hat.",shape=box,color=red];
		3029 -> 3034;
	3030 [label="GENAU.",shape=box,color=blue];
		3030 -> 3035;
	3031 [label="Götter und Menschen ... haben sich vereint?",shape=box,color=red];
		3031 -> 3036;
	3032 [label="Könige, deren Eltern Götter waren? Und ich dachte, die Orokin wären Arschlöcher.",shape=box,color=red];
		3032 -> 3036;
	3033 [label="Ich war nie Teil von Margulis‘ Programm für ganz besondere Kinder, habe nie einen Warframe bekommen und nie im Alten Krieg gekämpft.",shape=box,color=red];
		3033 -> 3037;
	3034 [label="Ich weiß zumindest eins darüber: Es spielt Spielchen.",shape=box,color=red];
		3034 -> 3038;
	3035 [label="Doch dann kam irgendein kleiner Höhlen-Typ, der wahrscheinlich von den großen Höhlenmädchen geärgert wurde, auf den Trick mit dem Aneinanderschlagen von Steinen, und Bingo.",shape=box,color=blue];
		3035 -> 3039;
	3036 [label="Oh, so etwas passierte SEHR OFT. Überall auf der Welt.",shape=box,color=blue];
		3036 -> 3040;
	3037 [label="... hättest du es gewollt?",shape=box,color=blue];
		3037 -> 3041;
		3037 -> 3042;
		3037 -> 3043;
	3038 [label="+20 Chemistry",color=orange];
		3038 -> 3044;
	3039 [label="Licht auf Abruf! Unabhängigkeit von den großen Lichtern am Himmel!",shape=box,color=blue];
		3039 -> 3045;
	3040 [label="Stell dir vor, du bist ein arroganter Priester, der über das Meer aufbricht, um den 'Wilden' in der neuen Welt das Evangelium von Sol zu verkünden, und stellst dann fest, dass diese nicht nur bereits alles über Sol wissen, sondern auch noch von Sols leiblichem Sohn beherrscht werden.",shape=box,color=blue];
		3040 -> 3046;
	3041 [label="Ich weiß es wirklich nicht.",shape=box,color=red];
		3041 -> 3047;
	3042 [label="Ehrlich gesagt, nein.",shape=box,color=red];
		3042 -> 3048;
	3043 [label="Ja, hätte ich.",shape=box,color=red];
		3043 -> 3049;
	3044 [label="Okay. Was auch immer du heute machst, mit wem auch immer du zusammen bist, ob mit mir oder Arthur oder sonst wem von uns ... pass auf dich auf.",shape=box,color=blue];
		3044 -> 3050;
	3045 [label="Und jetzt schau uns an. Lichter überall. Wir haben es wertlos gemacht.",shape=box,color=blue];
		3045 -> 3003;
	3046 [label="Du würdest mit eingezogenem Schwanz nach Hause rennen oder auf der Stelle konvertieren.",shape=box,color=blue];
		3046 -> 3051;
		3046 -> 3052;
	3047 [label="Das ist fair. Ich respektiere das.",shape=box,color=blue];
		3047 -> 3057;
	3048 [label="Das freut mich. Wenn du das Gefühl hast, dein Leben hätte schlimmer sein können, dann haben wir doch einen Grund zum Feiern, oder?",shape=box,color=blue];
		3048 -> 3057;
	3049 [label="Ich glaube, ich verstehe. Du hast viel verpasst, nicht wahr?",shape=box,color=blue];
		3049 -> 3057;
	3050 [label="Check boolean EleanorDating",color=orange];
		3050 -> 3054 [label=true,color=green];
		3050 -> 3055 [label=false,color=brown];
	3051 [label="Glaubst du wirklich, dass es Götter gibt? Oder hast du nur Angst vor der Vorstellung, dass es sie geben könnte?",shape=box,color=red];
		3051 -> 3056;
	3052 [label="Okay. Du denkst also: Was, wenn die Menschen in der Vergangenheit die ganze Zeit Recht hatten?",shape=box,color=red];
		3052 -> 3056;
	3057 [label="Check boolean EleanorDating",color=orange];
		3057 -> 3053 [label=true,color=green];
		3057 -> 3310 [label=false,color=brown];
	3054 [label="Ich liebe dich. Jeder Gott, der versucht, sich dem in den Weg zu stellen, sollte besser zu dem beten, was auch immer über den Göttern steht.",shape=box,color=blue];
		3054 -> 3058;
	3055 [label="Du bist mein teurer Freund. Jeder Gott, der versucht, dich mir zu nehmen, wird seine Realität auf eine harte Probe stellen müssen.",shape=box,color=blue];
		3055 -> 3059;
	3056 [label="Sagen wir einfach, dass ich früher viel mehr Vertrauen in die langweilige materielle Realität der Dinge hatte als heute.",shape=box,color=blue];
