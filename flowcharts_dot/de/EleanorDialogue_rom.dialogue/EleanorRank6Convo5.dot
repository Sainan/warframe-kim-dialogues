digraph {
	"EleanorRank6Convo5 begins." [color=orange];
		"EleanorRank6Convo5 begins." -> j3829636015;
	j3829636015 [label="Ich habe mich, wie so oft, gefragt ...",shape=box,color=blue];
		j3829636015 -> j632144957;
	j632144957 [label="Wenn diese Schleife endgültig aufgehört hat, wie auch immer das geschieht, was kommt als Nächstes für die Erde?",shape=box,color=blue];
		j632144957 -> j3028475301;
	j3028475301 [label="Ich weiß, das Jahr 2000 liegt für dich schon ziemlich weit zurück, aber kannst du mir IRGENDWAS darüber sagen, was unserem kleinen Planeten bevorsteht?",shape=box,color=blue];
		j3028475301 -> j144901392;
		j3028475301 -> j3976876752;
	j144901392 [label="Ich fürchte, es ist nichts Gutes.",shape=box,color=red];
		j144901392 -> j2614237738;
	j3976876752 [label="Ehrlich gesagt, glaube ich nicht, dass ich das sollte.",shape=box,color=red];
		j3976876752 -> j3580851783;
	j2614237738 [label="Soweit ich es weiß, wird Techrot zu einem globalen Problem. Sie lösen es mit Atomwaffen – oder versuchen es zumindest.",shape=box,color=red];
		j2614237738 -> j1336616042;
	j3580851783 [label="Wenn du vor dem, was kommt, gewarnt bist, versuchst du vielleicht, es zu ändern, und das könnte zur Folge haben, dass ich nie existiere.",shape=box,color=red];
		j3580851783 -> j27094327;
	j1336616042 [label="So beginnt der erste der 'Strahlungskriege'.",shape=box,color=red];
		j1336616042 -> j649850278;
	j27094327 [label="Du kannst mich egoistisch nennen, aber ich existiere gerne.",shape=box,color=red];
		j27094327 -> j4052241436;
	j649850278 [label="... und irgendwann ist der Planet so hinüber, dass die Orokin ihn verlassen und woanders leben wollen, richtig?",shape=box,color=blue];
		j649850278 -> j1464178251;
	j4052241436 [label="Oh, als ob alles, was du getan hast, die Zukunft NICHT verändert hätte?",shape=box,color=blue];
		j4052241436 -> j664518217;
	j1464178251 [label="... was zu der ganzen Sache mit der Zariman führt, und da kommst DU ins Spiel.",shape=box,color=blue];
		j1464178251 -> j1297852379;
	j664518217 [label="Du hast zwar die kleinen Details geändert, aber die großen sind so ziemlich gleich geblieben.",shape=box,color=blue];
		j664518217 -> j2004481792;
	j1297852379 [label="Es ist seltsam, zu wissen, dass alles genau hier in dieser Stadt beginnt.",shape=box,color=blue];
		j1297852379 -> j658739057;
		j1297852379 -> j23079827;
	j2004481792 [label="Ich glaube, das Universum weiß, was es tut.",shape=box,color=blue];
		j2004481792 -> j212593194;
	j658739057 [label="Vielleicht ist dieses Jahr deshalb zum Teil so wichtig.",shape=box,color=red];
		j658739057 -> j284523704;
	j23079827 [label="Ja. Von Höllvania bis zur Zariman Ten-Zero. Das ist ein roter Faden.",shape=box,color=red];
		j23079827 -> j3285393615;
	j212593194 [label="Da steckt mehr dahinter, als nur irgendwelche blinden Partikel, die umhertreiben.",shape=box,color=blue];
		j212593194 -> j2776603479;
		j212593194 -> j3114507805;
	j284523704 [label="+5 Chemistry",color=orange];
		j284523704 -> j3592972721;
	j3285393615 [label="warte mal ...",shape=box,color=blue];
		j3285393615 -> j3265860865;
	j2776603479 [label="Ich teile deine Ansicht nicht. Das Universum ist geistlos.",shape=box,color=red];
		j2776603479 -> j1318869179;
	j3114507805 [label="Ich stimme zu. Wenn etwas so Menschliches wie Emotion den Void formen kann ...",shape=box,color=red];
		j3114507805 -> j690481104;
	j3592972721 [label="Das ergibt Sinn. Wenn Albrechts Atombombe explodiert wäre, heißt das, es gäbe keinen Techrot, demnach keine zerstörte Erde, keine Flucht, keine erste Reise in den Void und keine Gleichgültigkeit??",shape=box,color=blue];
		j3592972721 -> j2200094332;
	j3265860865 [label="Wenn die Zariman Ten-Zero deine war, was ist mit den Zarimans Eins bis Neun passiert?",shape=box,color=blue];
		j3265860865 -> j1160482648;
	j1318869179 [label="Vielleicht aus einer sehr großen oder sehr kleinen Perspektive, aber nicht auf der Ebene, auf der du und ich existieren.",shape=box,color=blue];
		j1318869179 -> j1251785539;
	j690481104 [label="+5 Chemistry",color=orange];
		j690481104 -> j3712620542;
	j2200094332 [label="... Ich schau mal, ob Lettie Kaffee auf Lager hat.",shape=box,color=blue];
		j2200094332 -> "Chat ends.";
	j1160482648 [label="Unbemannte Drohnen, soweit ich mich erinnere.",shape=box,color=red];
		j1160482648 -> j2223076438;
	j1251785539 [label="Wenn wir Bedeutung schaffen können und wir Teil des Universums sind, dann ist das Universum definitionsgemäß sinnvoll.",shape=box,color=blue];
		j1251785539 -> j877424041;
	j3712620542 [label="Genau. Die Bedeutung, die wir erzeugen, ist nicht bloß eine bequeme Illusion.",shape=box,color=blue];
		j3712620542 -> j365158774;
	"Chat ends." [color=orange];
	j2223076438 [label="Oder von Cephalons gesteuerte Terraforming-Kapseln. Sie haben VIEL experimentiert.",shape=box,color=red];
		j2223076438 -> j2229173173;
	j877424041 [label="+5 Chemistry",color=orange];
		j877424041 -> j3714435984;
	j365158774 [label="Aber da ist immer diese Stimme, die einem zuflüstert und darauf besteht, dass das alles unwichtig ist.",shape=box,color=blue];
		j365158774 -> j265440410;
	j2229173173 [label="Sie nannten es 'Das Projekt'. ",shape=box,color=red];
		j2229173173 -> j1429691708;
	j3714435984 [label="Unsere Existenz ist nicht weniger wahr oder gültig als die von Quarks oder Supernovas. Wir sind wichtig, ob es uns gefällt oder nicht.",shape=box,color=blue];
		j3714435984 -> "Chat ends.";
	j265440410 [label="Vielleicht geht es bei dem großen kosmischen Kampf nicht um Gut und Böse, sondern um Sinn und Sinnlosigkeit?",shape=box,color=blue];
		j265440410 -> "Chat ends.";
	j1429691708 [label="+5 Chemistry",color=orange];
		j1429691708 -> j2412187535;
	j2412187535 [label="Klingt besser als 'Operation: Bringt unsere verantwortungslosen Ärsche zu einem neuen Planeten, auf dem wir dann weiterhin überall hinscheißen können'.",shape=box,color=blue];
		j2412187535 -> "Chat ends.";
}