digraph {
	3068 [label="EleanorRank6Convo5 begins.",color=orange];
		3068 -> 3069;
	3069 [label="Ich habe mich, wie so oft, gefragt ...",shape=box,color=blue];
		3069 -> 3070;
	3070 [label="Wenn diese Schleife endgültig aufgehört hat, wie auch immer das geschieht, was kommt als Nächstes für die Erde?",shape=box,color=blue];
		3070 -> 3071;
	3071 [label="Ich weiß, das Jahr 2000 liegt für dich schon ziemlich weit zurück, aber kannst du mir IRGENDWAS darüber sagen, was unserem kleinen Planeten bevorsteht?",shape=box,color=blue];
		3071 -> 3072;
		3071 -> 3074;
	3072 [label="Ich fürchte, es ist nichts Gutes.",shape=box,color=red];
		3072 -> 3073;
	3074 [label="Ehrlich gesagt, glaube ich nicht, dass ich das sollte.",shape=box,color=red];
		3074 -> 3076;
	3073 [label="Soweit ich es weiß, wird Techrot zu einem globalen Problem. Sie lösen es mit Atomwaffen – oder versuchen es zumindest.",shape=box,color=red];
		3073 -> 3075;
	3076 [label="Wenn du vor dem, was kommt, gewarnt bist, versuchst du vielleicht, es zu ändern, und das könnte zur Folge haben, dass ich nie existiere.",shape=box,color=red];
		3076 -> 3078;
	3075 [label="So beginnt der erste der 'Strahlungskriege'.",shape=box,color=red];
		3075 -> 3077;
	3078 [label="Du kannst mich egoistisch nennen, aber ich existiere gerne.",shape=box,color=red];
		3078 -> 3080;
	3077 [label="... und irgendwann ist der Planet so hinüber, dass die Orokin ihn verlassen und woanders leben wollen, richtig?",shape=box,color=blue];
		3077 -> 3079;
	3080 [label="Oh, als ob alles, was du getan hast, die Zukunft NICHT verändert hätte?",shape=box,color=blue];
		3080 -> 3082;
	3079 [label="... was zu der ganzen Sache mit der Zariman führt, und da kommst DU ins Spiel.",shape=box,color=blue];
		3079 -> 3081;
	3082 [label="Du hast zwar die kleinen Details geändert, aber die großen sind so ziemlich gleich geblieben.",shape=box,color=blue];
		3082 -> 3085;
	3081 [label="Es ist seltsam, zu wissen, dass alles genau hier in dieser Stadt beginnt.",shape=box,color=blue];
		3081 -> 3083;
		3081 -> 3084;
	3085 [label="Ich glaube, das Universum weiß, was es tut.",shape=box,color=blue];
		3085 -> 3088;
	3083 [label="Vielleicht ist dieses Jahr deshalb zum Teil so wichtig.",shape=box,color=red];
		3083 -> 3086;
	3084 [label="Ja. Von Höllvania bis zur Zariman Ten-Zero. Das ist ein roter Faden.",shape=box,color=red];
		3084 -> 3087;
	3088 [label="Da steckt mehr dahinter, als nur irgendwelche blinden Partikel, die umhertreiben.",shape=box,color=blue];
		3088 -> 3091;
		3088 -> 3092;
	3086 [label="+5 Chemistry",color=orange];
		3086 -> 3089;
	3087 [label="warte mal ...",shape=box,color=blue];
		3087 -> 3090;
	3091 [label="Ich teile deine Ansicht nicht. Das Universum ist geistlos.",shape=box,color=red];
		3091 -> 3095;
	3092 [label="Ich stimme zu. Wenn etwas so Menschliches wie Emotion den Void formen kann ...",shape=box,color=red];
		3092 -> 3096;
	3089 [label="Das ergibt Sinn. Wenn Albrechts Atombombe explodiert wäre, heißt das, es gäbe keinen Techrot, demnach keine zerstörte Erde, keine Flucht, keine erste Reise in den Void und keine Gleichgültigkeit??",shape=box,color=blue];
		3089 -> 3093;
	3090 [label="Wenn die Zariman Ten-Zero deine war, was ist mit den Zarimans Eins bis Neun passiert?",shape=box,color=blue];
		3090 -> 3094;
	3095 [label="Vielleicht aus einer sehr großen oder sehr kleinen Perspektive, aber nicht auf der Ebene, auf der du und ich existieren.",shape=box,color=blue];
		3095 -> 3099;
	3096 [label="+5 Chemistry",color=orange];
		3096 -> 3100;
	3093 [label="... Ich schau mal, ob Lettie Kaffee auf Lager hat.",shape=box,color=blue];
		3093 -> 3097;
	3094 [label="Unbemannte Drohnen, soweit ich mich erinnere.",shape=box,color=red];
		3094 -> 3098;
	3099 [label="Wenn wir Bedeutung schaffen können und wir Teil des Universums sind, dann ist das Universum definitionsgemäß sinnvoll.",shape=box,color=blue];
		3099 -> 3102;
	3100 [label="Genau. Die Bedeutung, die wir erzeugen, ist nicht bloß eine bequeme Illusion.",shape=box,color=blue];
		3100 -> 3103;
	3097 [label="Chat ends.",color=orange];
	3098 [label="Oder von Cephalons gesteuerte Terraforming-Kapseln. Sie haben VIEL experimentiert.",shape=box,color=red];
		3098 -> 3101;
	3102 [label="+5 Chemistry",color=orange];
		3102 -> 3105;
	3103 [label="Aber da ist immer diese Stimme, die einem zuflüstert und darauf besteht, dass das alles unwichtig ist.",shape=box,color=blue];
		3103 -> 3106;
	3101 [label="Sie nannten es 'Das Projekt'. ",shape=box,color=red];
		3101 -> 3104;
	3105 [label="Unsere Existenz ist nicht weniger wahr oder gültig als die von Quarks oder Supernovas. Wir sind wichtig, ob es uns gefällt oder nicht.",shape=box,color=blue];
		3105 -> 3108;
	3106 [label="Vielleicht geht es bei dem großen kosmischen Kampf nicht um Gut und Böse, sondern um Sinn und Sinnlosigkeit?",shape=box,color=blue];
		3106 -> 3109;
	3104 [label="+5 Chemistry",color=orange];
		3104 -> 3107;
	3108 [label="Chat ends.",color=orange];
	3109 [label="Chat ends.",color=orange];
	3107 [label="Klingt besser als 'Operation: Bringt unsere verantwortungslosen Ärsche zu einem neuen Planeten, auf dem wir dann weiterhin überall hinscheißen können'.",shape=box,color=blue];
		3107 -> 3110;
	3110 [label="Chat ends.",color=orange];
