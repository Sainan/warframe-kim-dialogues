		2444 -> 2448 [label="RoatheBirdThree",color=purple];
		2444 -> 2447 [label="false",color=purple];
	2445 [label="Evaluate expressions",color=orange];
		2445 -> 2449 [label="RoatheUnloved2",color=purple];
		2445 -> 2449 [label="RoatheUnloved1",color=purple];
		2445 -> 2449 [label="RoatheAlone1",color=purple];
		2445 -> 2449 [label="RoatheBirdThree",color=purple];
		2445 -> 2450 [label="false",color=purple];
	2446 [label="Sein Name ist einzigartig für dich.",shape=box,color=blue];
		2446 -> 2451;
	2448 [label="Reiz es nicht aus, Usurpator. \"Freude\" ist etwas übertrieben. Eher so, dass ihr mir ans Herz gewachsen seid. Wie Schimmel.",shape=box,color=blue];
		2448 -> 2453;
	2447 [label="\"Freude\" Ist es das? Mir war nie bewusst, dass ich so ein Masochist bin. Hm. Oder ist es einfach nur das Gefühl, wie mein Körper verfällt und ihr mir alle immer mehr \"ans Herz wachst\"?",shape=box,color=blue];
		2447 -> 2452;
	2449 [label="Es ist durchaus angenehm, jemanden zum Reden zu haben. Auch wenn ihr, wie du schon sagtest, manchmal echt nervt.",shape=box,color=blue];
		2449 -> 2454;
	2450 [label="Einsamkeit? Pff. Das Einzige, was ihr damit bekämpft, ist der letzte Funke Vernunft, der in mein Leben zurückkehren will. Falls du damit andeuten willst, dass ihr mir \"ans Herz gewachsen\" seid, weißt du, was sonst noch so etwas macht?",shape=box,color=blue];
		2450 -> 2455;
	2451 [label="Aber nicht für die Sterne.",shape=box,color=blue];
		2451 -> 2456;
	2453 [label="+5 Chemistry",color=orange];
		2453 -> 2457;
	2452 [label="Wie Schimmel.",shape=box,color=blue];
		2452 -> 2457;
	2454 [label="+5 Chemistry",color=orange];
		2454 -> 2458;
	2455 [label="Schimmel.",shape=box,color=blue];
		2455 -> 2457;
	2456 [label="Stelle meine Art ruhig in Purpur da, so viel du willst. Schmilz das Gold der Orokin ein und nenne uns Monster. Wir verdienen jeden Tropfen Hass, den du uns entgegenbringen kannst.",shape=box,color=blue];
		2456 -> 2459;
	2457 [label="Update boolean RoatheAlone2",color=orange];
		2457 -> 2460;
	2458 [label="Ich muss zugeben, ihr seid ... wie Schimmel.",shape=box,color=blue];
		2458 -> 2457;
	2459 [label="Aber glaube nicht mal eine Sekunde lang, dass das alles war, wozu wir fähig waren.",shape=box,color=blue];
		2459 -> 2461;
	2460 [label="Check boolean LoidFamilyComplete",color=orange];
		2460 -> 2462 [label=true,color=green];
		2460 -> 2463 [label=false,color=brown];
	2461 [label="Willst du alle Orokin ausrotten? Dann geh die Treppe hinauf. Du hast ein paar Überlebende, die deinem Zorn nicht entkommen können. Fang mit \"Großmutter\" an.",shape=box,color=blue];
		2461 -> 2464;
	2462 [label="+10 Chemistry",color=orange];
		2462 -> 2465;
	2463 [label="Es gibt noch einen anderen Grund, warum ich nicht in einen wahnsinnigen, blutrünstigen, grausamen Amoklauf verfallen bin, Usurpator.",shape=box,color=blue];
		2463 -> 2466;
	2464 [label="Schließlich hat sie die meisten von unseresgleichen gesehen.",shape=box,color=blue];
		2464 -> 2467;
	2465 [label="Chat ends.",color=orange];
	2466 [label="Ich warte noch auf den Ausgang des kleinen Dramas zwischen unserem lieben Butler und Albrechts entfremdeter Familie oben.",shape=box,color=blue];
		2466 -> 2468;
	2467 [label="Update boolean RoatheNoDate",color=orange];
		2467 -> 2469;
	2468 [label="Vergiss nicht, dass ich ein persönliches Interesse an der ganzen Sache habe, unabhängig davon, ob wir eine Vereinbarung haben oder nicht. Ich werde dafür sorgen, dass Albrecht, wenn er zum ersten Mal wieder dieses Sanctum betritt, als erstes folgendes Gesicht sieht:",shape=box,color=blue];
		2468 -> 2470;
	2469 [label="Chat ends.",color=orange];
	2470 [label="Nämlich meins.",shape=box,color=blue];
		2470 -> 2471;
	2471 [label="Ich kann mich einfach noch nicht entscheiden, ob ich von den Leichen seiner Angehörigen umgeben sein werde oder nicht, wenn er mich sieht.",shape=box,color=blue];
		2471 -> 2472;
	2472 [label="Entscheidungen, Entscheidungen ...",shape=box,color=blue];
		2472 -> 2473;
	2473 [label="+10 Chemistry",color=orange];
		2473 -> 2474;
	2474 [label="Chat ends.",color=orange];
