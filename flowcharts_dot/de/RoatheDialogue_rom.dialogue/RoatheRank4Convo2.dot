		2407 -> 2409 [label="false",color=purple];
		2407 -> 2411 [label="false",color=purple];
	2409 [label="Du hast die Mittel. Du hast die Macht. Du hast deinen Unmut über deine Situation schon oft genug zum Ausdruck gebracht.",shape=box,color=red];
		2409 -> 2413;
	2410 [label="Ich verstehe einfach nicht, warum \"Der Teufel von Tau\" sich damit zufriedengibt, in einer Gruft zu sitzen und Däumchen zu drehen. Selbst mit unserem Abkommen.",shape=box,color=red];
		2410 -> 2414;
	2411 [label="Du bist ein Orokin. Du hasst ganz offensichtlich alle um dich herum. Was hält dich auf?",shape=box,color=red];
		2411 -> 2415;
	2408 [label="Ich verstehe einfach nicht, warum \"Der Teufel von Tau\" sich damit zufriedengibt, in einer Gruft zu sitzen und Däumchen zu drehen. Vor allem, da wir ja keinerlei Abkommen haben.",shape=box,color=red];
		2408 -> 2412;
	2413 [label="+5 Chemistry",color=orange];
		2413 -> 2418;
	2414 [label="Check boolean RoatheKnowsReset2",color=orange];
		2414 -> 2420 [label=true,color=green];
		2414 -> 2419 [label=false,color=brown];
	2415 [label="Vergib mir, ich brauche einen Moment, um meine Gedanken zu sammeln, um dieses Gespräch nicht aus einem Zustand zu beginnen, der einzig und allein von Wut und Groll getrieben ist.",shape=box,color=blue];
		2415 -> 2421;
	2412 [label="Check boolean RoatheKnowsReset2",color=orange];
		2412 -> 2417 [label=true,color=green];
		2412 -> 2416 [label=false,color=brown];
	2418 [label="Und es freut mich, dass du erkennst, dass ich durchaus in der Lage wäre, diesen Ort mit Leichtigkeit in einen Schlachthof zu verwandeln.",shape=box,color=blue];
		2418 -> 2424;
	2420 [label="Denn es bleibt immer noch das Rätsel, warum ich dir so sehr vertraut habe, dass ich dir so viel erzählt habe, nur damit du dann anschließend das Vertrauen missbrauchst, Usurpator.",shape=box,color=blue];
		2420 -> 2423;
	2419 [label="Es gibt noch einiges zu tun, Usurpator. Ich kann deine Hilfe bei der Wiedererlangung meiner Erinnerungen ja schlecht in Anspruch nehmen, wenn ich anfange, jeden in der Umgebung umzubringen, nicht wahr?",shape=box,color=blue];
		2419 -> 2422;
	2421 [label="Während ich mich sehr bemühe, deine These nicht sofort zu bestätigen.",shape=box,color=blue];
		2421 -> 2425;
	2417 [label="Denn es bleibt immer noch das Rätsel, warum ich dir so sehr vertraut habe, dass ich dir so viel erzählt habe, nur damit du dann anschließend das Vertrauen missbrauchst, Usurpator.",shape=box,color=blue];
		2417 -> 2423;
	2416 [label="Vielleicht hoffe ich ja, dass du zur Vernunft kommst und deine Meinung änderst. Und die Chancen dafür sinken drastisch, wenn ich alle in der Umgebung abgeschlachtet habe, nicht wahr?",shape=box,color=blue];
		2416 -> 2422;
	2424 [label="Aber es würde ja nichts bringen, oder? Wenn man aus dem Krieg eines lernt, dann dies: Mord bewirkt am Ende erschreckend wenig.",shape=box,color=blue];
		2424 -> 2427;
	2423 [label="Und die Chancen dafür sinken dramatisch, wenn ich alle in der Umgebung abgeschlachtet habe, nicht wahr? Wenn man aus dem Krieg eines lernt, dann dies: Mord bewirkt am Ende erschreckend wenig.",shape=box,color=blue];
		2423 -> 2426;
	2422 [label="Außerdem würde es ja nichts bringen, oder? Wenn man aus dem Krieg eines lernt, dann dies: Mord bewirkt am Ende erschreckend wenig.",shape=box,color=blue];
		2422 -> 2426;
	2425 [label="Ich verstehe deinen Hass auf die Orokin. Glaub mir. Die meisten Orokin verachteten die Orokin. Ich bin mir unserer Verbrechen und der Gräueltaten, die wir begangen haben, durchaus bewusst.",shape=box,color=blue];
		2425 -> 2428;
	2427 [label="So reizvoll es auch sein mag, hin und wieder dem Wunsch nachzugeben, sich ein wenig davon zu widmen.",shape=box,color=blue];
		2427 -> 2431;
		2427 -> 2430;
		2427 -> 2429;
	2426 [label="So reizvoll es auch sein mag, hin und wieder dem Wunsch nachzugeben, sich ein wenig davon zu widmen.",shape=box,color=blue];
		2426 -> 2429;
		2426 -> 2430;
		2426 -> 2431;
	2428 [label="Allein das Yuvan-Theater wäre Grund genug, unsere Gesellschaft in Schutt und Asche zu legen. Doch du verurteilst ein ganzes Volk – dessen Produkt du warst, nebenbei bemerkt, mein Usurpator – mit einem einzigen Schlag!",shape=box,color=blue];
		2428 -> 2432;
	2431 [label="Der einzige Grund, warum du alle am Leben gelassen hast, ist also, dass es sinnlos wäre, sie zu töten?",shape=box,color=red];
		2431 -> 2435;
	2430 [label="Gibt es keinen anderen Grund, warum du alle am Leben lässt?",shape=box,color=red];
		2430 -> 2434;
	2429 [label="Sogar Marie und Lyon?",shape=box,color=red];
		2429 -> 2433;
	2432 [label="Du weißt nichts von all den gütigen Seelen, die innerhalb dieser goldenen Mauern schufteten und starben. Die Sagen über jene Leben, die im Laufe der Zeit verloren gingen.",shape=box,color=blue];
		2432 -> 2436;
	2435 [label="Es wäre sinnlos, sie zu töten. Oder etwa nicht? Willst du mich etwa vom Gegenteil überzeugen? Usurpator, ich bin beeindruckt – ich hätte dich nie für so ein hinterlistiges Monster gehalten!",shape=box,color=blue];
		2435 -> 2438;
		2435 -> 2439;
	2434 [label="Wenn du schon eine versteckte Andeutung machen willst, Usurpator, dann sag es doch einfach.",shape=box,color=blue];
		2434 -> 2438;
		2434 -> 2439;
	2433 [label="Ich bin mir ziemlich sicher, dass ich einen ordentlichen Anschiss bekommen würde, wenn du in die Krypta hinunterkommen würdest und dort zwei blutige Flecken findest, wo die Eiferer einst standen, nicht wahr?",shape=box,color=blue];
		2433 -> 2437;
	2436 [label="Die unzähligen Tränen, die über die Tragödien vergossen wurden, die für immer unbesungen bleiben werden, einfach weil sie dir unbekannt sind.",shape=box,color=blue];
		2436 -> 2440;
	2438 [label="Es ist völlig in Ordnung zuzugeben, dass dir Gesellschaft Freude bereitet. Menschen können mehr sein, als nur einen praktischen Zweck zu erfüllen.",shape=box,color=red];
		2438 -> 2441;
	2439 [label="Es ist in Ordnung zuzugeben, dass wir deine Einsamkeit vertreiben, auch wenn wir dich damit nerven.",shape=box,color=red];
		2439 -> 2442;
	2437 [label="Von dir, dem Butler, den Tenno oder der furchteinflößenden \"Mutter\" der Tenno. Igitt. Die. Die macht mir Sorgen. Ein Thema für ein anderes Mal.",shape=box,color=blue];
		2437 -> 2439;
		2437 -> 2438;
	2440 [label="Ich höre dein Kind-Duplikat immer wieder den Namen Adis weinen.",shape=box,color=blue];
		2440 -> 2443;
	2441 [label="Add 1 to Thermostat",color=orange];
		2441 -> 2444;
	2442 [label="Add -1 to Thermostat",color=orange];
		2442 -> 2445;
	2443 [label="Adis war einer von Millionen.",shape=box,color=blue];
		2443 -> 2446;
	2444 [label="Evaluate expressions",color=orange];
		2444 -> 2448 [label="RoatheUnloved2",color=purple];
		2444 -> 2448 [label="RoatheUnloved1",color=purple];
