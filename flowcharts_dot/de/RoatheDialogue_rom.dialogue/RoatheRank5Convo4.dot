	j2099623384 [label="Boolean RoatheResetDealComplete is now true.",color=orange];
		j2099623384 -> j830011449;
		j2099623384 -> j3235987418;
	j2475579505 [label="Was für eine erstaunliche Frage. Ich habe mir das selbst schon oft gestellt, seit ich mich in dieses befallene Amalgam verwandelt habe.",shape=box,color=blue];
		j2475579505 -> j2441493733;
	j1316676158 [label="Ich werde kommen, um mir das zu holen, was mir zusteht, unabhängig davon, ob ich den Teil der Abmachung erfüllen musste oder nicht.",shape=box,color=blue];
		j1316676158 -> j3501113646;
		j1316676158 -> j1465605699;
	j583650686 [label="Ich konnte sie nicht dazu bewegen, ihre Meinung zu ändern ...",shape=box,color=red];
		j583650686 -> j1331109808;
	j2216674672 [label="Es ist in Ordnung, die Sache so zu belassen, wie sie ist. Ich brauche deine Hilfe nicht.",shape=box,color=red];
		j2216674672 -> j3490754674;
	j830011449 [label="Nein, ich habe das Gefühl, ich habe ihn im Stich gelassen.",shape=box,color=red];
		j830011449 -> j1077103974;
	j3235987418 [label="Es ist in Ordnung, die Sache so zu belassen, wie sie ist. Ich brauche deine Hilfe nicht.",shape=box,color=red];
		j3235987418 -> j1519326181;
	j2441493733 [label="Aber jetzt, wo meine Erinnerungen vollständig zurückgekehrt sind, denke ich öfter an sie.",shape=box,color=blue];
		j2441493733 -> j2668158706;
	j3501113646 [label="Und was genau wäre das? Du hast nie gesagt, was du dir daraus erhoffst.",shape=box,color=red];
		j3501113646 -> j792294928;
	j1465605699 [label="Ich glaube, du bluffst. Ich glaube, du hast nicht mal einen Plan, was du eigentlich willst.",shape=box,color=red];
		j1465605699 -> j2135302346;
	j1331109808 [label="Nun, dann werde ich dieses Problem für dich lösen und ich werde auch demnächst eintreiben, was mir zusteht.",shape=box,color=blue];
		j1331109808 -> j1645131207;
		j1331109808 -> j2613280586;
	j3490754674 [label="Du kannst es genauso gut in Anspruch nehmen. Ich werde mir holen, was mir zusteht, unabhängig davon, ob du deinen Teil der Abmachung erfüllst oder nicht.",shape=box,color=blue];
		j3490754674 -> j2613280586;
		j3490754674 -> j1645131207;
	j1077103974 [label="Nun, dann werde ich dieses Problem für dich lösen und ich werde auch demnächst eintreiben, was mir zusteht.",shape=box,color=blue];
		j1077103974 -> j1524331054;
		j1077103974 -> j1474415457;
	j1519326181 [label="Du kannst es genauso gut in Anspruch nehmen. Ich werde mir holen, was mir zusteht, unabhängig davon, ob du deinen Teil der Abmachung erfüllst oder nicht.",shape=box,color=blue];
		j1519326181 -> j1524331054;
		j1519326181 -> j1474415457;
	j2668158706 [label="Du musst verstehen, wie zutiefst komplex und ... schädlich meine Beziehung zu dieser Frau wirklich war. Es ist schwer zu beschreiben, wie sehr ich sie verehrte. Und wie sehr ich sie verachtete.",shape=box,color=blue];
		j2668158706 -> j2578255081;
	j792294928 [label="Dir ist schon klar, wie mächtig du bist, ja? Und wie wichtig es sein könnte, dich in meiner Tasche zu haben?",shape=box,color=blue];
		j792294928 -> j3431798309;
	j2135302346 [label="Das \"Was\" ist bei weitem nicht so wichtig wie das \"Wer\", Usurpator.",shape=box,color=blue];
		j2135302346 -> j792294928;
	j1645131207 [label="Ich glaube, du bluffst. Ich glaube, du hast nicht mal einen Plan, was du eigentlich willst.",shape=box,color=red];
		j1645131207 -> j2685809791;
	j2613280586 [label="Und was genau wäre das? Du hast nie gesagt, was du dir daraus erhoffst.",shape=box,color=red];
		j2613280586 -> j1277692112;
	j1524331054 [label="Und was genau wäre das? Du hast nie gesagt, was du dir daraus erhoffst.",shape=box,color=red];
		j1524331054 -> j1752346719;
	j1474415457 [label="Ich glaube, du bluffst. Ich glaube, du hast nicht mal einen Plan, was du eigentlich willst.",shape=box,color=red];
		j1474415457 -> j700897060;
	j2578255081 [label="Noch wichtiger jedoch, wie sehr sie mich dazu brachte, jeden Teil von mir selbst bis ins Mark zu verachten. Und dennoch, ohne sie gäbe es mich nicht. Ich wäre nicht der Mann, der ich bin.",shape=box,color=blue];
		j2578255081 -> j2076465442;
	j3431798309 [label="Das nennt man, glaube ich, im alten Sprachgebrauch einen \"Blankoscheck\"? Und du hast ihn bereitwillig unterschrieben.",shape=box,color=blue];
		j3431798309 -> j2491096066;
