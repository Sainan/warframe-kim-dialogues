		j700897060 -> j1752346719;
	j2076465442 [label="Sie hat mich erschaffen. Sie hat mich gebrochen.",shape=box,color=blue];
		j2076465442 -> j3390895400;
	j2491096066 [label="+5 Chemistry",color=orange];
		j2491096066 -> j1296915871;
	j2073780238 [label="Das nennt man, glaube ich, im alten Sprachgebrauch einen \"Blankoscheck\"? Und du hast ihn bereitwillig unterschrieben. Also was sagst du? Willst du meine Hilfe mit Marie oder nicht?",shape=box,color=blue];
		j2073780238 -> j717975509;
		j2073780238 -> j1281122735;
	j151854703 [label="Das nennt man, glaube ich, im alten Sprachgebrauch einen \"Blankoscheck\"? Und du hast ihn bereitwillig unterschrieben. Also was sagst du? Willst du meine Hilfe mit Lyon oder nicht?",shape=box,color=blue];
		j151854703 -> j802869581;
		j151854703 -> j3460672998;
	j3390895400 [label="Ich liebte sie. Ich wollte ihren Tod.",shape=box,color=blue];
		j3390895400 -> j3275757216;
	j1296915871 [label="Das Einzige, was noch gefährlicher ist als ein Teufel ... ist ein Teufel mit Freunden wie dir, die Schulden zu begleichen haben.",shape=box,color=blue];
		j1296915871 -> "Chat ends.";
	j717975509 [label="Ja, einverstanden ...",shape=box,color=red];
		j717975509 -> j1659276176;
