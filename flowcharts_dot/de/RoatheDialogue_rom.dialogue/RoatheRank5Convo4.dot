	j2038242171 [label="Boolean RoatheMarieEntratiDeal is now false.",color=orange];
		j2038242171 -> j2018775447;
	j4102290966 [label="Wie du wünschst. Aber denk daran: Das Einzige, was noch gefährlicher ist als ein Teufel ... ist ein Teufel mit Freunden wie dir, die Schulden zu begleichen haben.",shape=box,color=blue];
		j4102290966 -> "Chat ends.";
	j3604340684 [label="Boolean RoatheLyonConfessionDeal is now false.",color=orange];
		j3604340684 -> j1992187100;
	j2402026860 [label="Ich hoffe, das weckt keine Eifersucht in dir. Das ist nicht meine Absicht. Ich versuche lediglich zu erklären, wie sehr sie mir geschadet hat.",shape=box,color=blue];
		j2402026860 -> j2892215955;
	j926473328 [label="Ohne sie wäre ich nicht der, der ich bin. Ich habe alles, was ich weiß, von ihr gelernt. Sie nahm rohen Ton und formte ihn.",shape=box,color=blue];
		j926473328 -> j3521109659;
		j926473328 -> j13045702;
		j926473328 -> j997399005;
	j2018775447 [label="+5 Chemistry",color=orange];
		j2018775447 -> j2778181233;
	j1992187100 [label="+5 Chemistry",color=orange];
		j1992187100 -> j745382838;
	j2892215955 [label="Und gleichzeitig, wie viel ich ihr dennoch verdanke! Ohne sie wäre ich nicht der, der ich bin. Ich habe alles, was ich weiß, von ihr gelernt. Sie nahm rohen Ton und formte ihn.",shape=box,color=blue];
		j2892215955 -> j3521109659;
		j2892215955 -> j218011899;
		j2892215955 -> j1028502061;
	j3521109659 [label="Ich verstehe. Ich war selbst einmal in einer ähnlichen Beziehung.",shape=box,color=red];
		j3521109659 -> j851095788;
	j13045702 [label="Es klingt so, als ob du deine Gefühle für sie noch nicht ganz überwunden hättest.",shape=box,color=red];
		j13045702 -> j1151299776;
	j997399005 [label="Glaubst du, sie lebt noch? Oder glaubst du, sie ist tot?",shape=box,color=red];
		j997399005 -> j2778954298;
	j2778181233 [label="Betrachte es als erledigt. Aber denk daran: Das Einzige, was noch gefährlicher ist als ein Teufel ... ist ein Teufel mit Freunden wie dir, die Schulden zu begleichen haben.",shape=box,color=blue];
		j2778181233 -> "Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j745382838 [label="Betrachte es als erledigt. Aber denk daran: Das Einzige, was noch gefährlicher ist als ein Teufel ... ist ein Teufel mit Freunden wie dir, die Schulden zu begleichen haben.",shape=box,color=blue];
		j745382838 -> "Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j218011899 [label="Ich verstehe. Alles gut.",shape=box,color=red];
		j218011899 -> j80334240;
	j1028502061 [label="Ich wünschte, du würdest nicht über sie reden.",shape=box,color=red];
		j1028502061 -> j4269570261;
	j851095788 [label="+5 Chemistry",color=orange];
		j851095788 -> j404777931;
	j1151299776 [label="Das stimmt so nicht ganz. Habe ich. Ich liebe sie nicht mehr. Es ist mir gleichgültig, ob sie durch meine Hand einen grausamen Tod erleidet. Aber ich bin ungemein neugierig, wie ihre Geschichte ausgegangen ist.",shape=box,color=blue];
		j1151299776 -> j238879147;
	j2778954298 [label="Es ist schwer vorstellbar, dass jemand mit einer solchen Vorliebe für Blut und Tod all die Jahrhunderte lang so still gewesen sein könnte.",shape=box,color=blue];
		j2778954298 -> j2283189069;
	"Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
	"Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j80334240 [label="Der Vergangenheit willen bin ich neugierig, was aus ihr geworden ist. Einfach, weil ich wissen möchte, wie ihre Geschichte ausgegangen ist. Falls es überhaupt ein Ende gibt.",shape=box,color=blue];
		j80334240 -> j238879147;
	j4269570261 [label="Verzeih, schließlich hast du das Thema angefangen. Du bist wirklich ziemlich verwirrend, Drifter Lieber.",shape=box,color=blue];
		j4269570261 -> "Chat ends.";
	j404777931 [label="Dann verstehst du vielleicht, warum ich so neugierig bin, was aus ihr geworden ist. Einfach, weil ich wissen möchte, wie ihre Geschichte ausgegangen ist. Falls es überhaupt ein Ende gibt.",shape=box,color=blue];
		j404777931 -> j238879147;
	j238879147 [label="Es ist schwer, sich von denen zu trennen, die eine so wichtige Rolle in der eigenen Geschichte gespielt haben. Ganz gleich, wie bösartig sie sind.",shape=box,color=blue];
		j238879147 -> j2778954298;
	j2283189069 [label="Falls sie noch lebt, ist sie nicht freiwillig so schweigsam.",shape=box,color=blue];
		j2283189069 -> j1165041505;
	j1165041505 [label="Eines möchte ich jedoch sagen: Falls sie noch lebt?",shape=box,color=blue];
		j1165041505 -> j89792121;
	j89792121 [label="+5 Chemistry",color=orange];
		j89792121 -> j2083735971;
	j2083735971 [label="Wirst du die dabei ertappen, dir zu wünschen, dass Ballas zurückkehrt.",shape=box,color=blue];
		j2083735971 -> "Chat ends.";
}