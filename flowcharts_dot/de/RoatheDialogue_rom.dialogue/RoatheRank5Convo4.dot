		j1277692112 -> j2073780238;
	j1752346719 [label="Dir ist schon klar, wie mächtig du bist, ja? Und wie wichtig es sein könnte, dich in meiner Tasche zu haben?",shape=box,color=blue];
		j1752346719 -> j151854703;
