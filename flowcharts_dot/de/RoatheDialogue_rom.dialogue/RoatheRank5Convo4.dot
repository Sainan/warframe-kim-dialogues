	j3431702098 [label="Wir haben eine Abmachung getroffen, Drifter. Bist du zufrieden damit, wie deine Sache mit Marie und ihre Meinung über Albrecht gelaufen ist? Mir scheint, die kleine schwebende Unterwürfige bleibt ihrem Glauben treu.",shape=box,color=blue];
		j3431702098 -> j2264716046;
	j3905628845 [label="Wir haben eine Abmachung getroffen, Drifter. Bist du zufrieden damit, wie deine Sache mit Lyon gelaufen ist? Mir scheint, der arme Kerl ist nach wie vor völlig verzweifelt.",shape=box,color=blue];
		j3905628845 -> j2099623384;
	j348787213 [label="Was glaubst du, was mit Nitokh passiert ist?",shape=box,color=red];
		j348787213 -> j2475579505;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j1466996711 [label="Wir haben eine Abmachung getroffen, Drifter. Und auch wenn es so aussieht, als hättest du meine Hilfe mit Marie doch nicht gebraucht, sei dir im Klaren, dass der Teufel immer seine Schulden eintreibt.",shape=box,color=blue];
		j1466996711 -> j1316676158;
	j4027935450 [label="Wir haben eine Abmachung getroffen, Drifter. Und auch wenn es so aussieht, als hättest du meine Hilfe mit Lyon doch nicht gebraucht, sei dir im Klaren, dass der Teufel immer seine Schulden eintreibt.",shape=box,color=blue];
