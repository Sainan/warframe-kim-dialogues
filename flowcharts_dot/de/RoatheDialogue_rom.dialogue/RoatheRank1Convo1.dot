digraph {
	"RoatheRank1Convo1 begins." [color=orange];
		"RoatheRank1Convo1 begins." -> j3998890108;
	j3998890108 [label="Evaluate expressions on HellStory counter",color=orange];
		j3998890108 -> j3978297698 [label="x >= 21",color=purple];
		j3998890108 -> j3736726357 [label="x >= 6",color=purple];
		j3998890108 -> j879519964 [label="x < 6",color=purple];
		j3998890108 -> j879519964 [label="false",color=purple];
	j3978297698 [label="Ich muss dir wirklich zu deiner Dreistigkeit gratulieren! Bist du dir ganz sicher, dass du nicht ein getarnter Orokin bist? Vielleicht verbirgst du deine azurblaue Haut, um die anderen nicht zu alarmieren?!",shape=box,color=blue];
		j3978297698 -> j4241675735;
		j3978297698 -> j2698914919;
		j3978297698 -> j2309150602;
	j3736726357 [label="Boolean RoatheResetEdgeCase is now true.",color=orange];
		j3736726357 -> j879519964;
	j879519964 [label="Die Void-geborene Anomalie. \"Der Drifter\". Der Usurpator. Endlich reden wir miteinander. Komm. Der Teufel hat einen Vorschlag zu machen ...",shape=box,color=blue];
		j879519964 -> j1498877651;
		j879519964 -> j3355933665;
		j879519964 -> j2348555103;
		j879519964 -> j299937132;
	j4241675735 [label="Hallo, Roathe.",shape=box,color=red];
		j4241675735 -> j1973557289;
	j2698914919 [label="Was genau wirfst du mir vor?",shape=box,color=red];
		j2698914919 -> j2893337572;
	j2309150602 [label="Was bitte?",shape=box,color=red];
		j2309150602 -> j2893337572;
	j1498877651 [label="Usurpator?",shape=box,color=red];
		j1498877651 -> j501975079;
	j3355933665 [label="Welche ... Art von Vorschlag?",shape=box,color=red];
		j3355933665 -> j253926473;
	j2348555103 [label="Was für einen Vorschlag könnte \"der Teufel von Tau\" wohl haben?",shape=box,color=red];
		j2348555103 -> j1544324174;
	j299937132 [label="Hallo, Roathe.",shape=box,color=red];
		j299937132 -> j1343723447;
	j1973557289 [label="Ah, gut! Du kennst also doch meinen Namen! Ich war mir sicher, du hast ihn irgendwie übersehen, da du ja offensichtlich zu sehr damit beschäftigt warst, mich immer wieder abzuschlachten!",shape=box,color=blue];
		j1973557289 -> j3486849899;
	j2893337572 [label="Hast du wirklich nichts Produktiveres zu tun?! Oder ist es wirklich die beste Weise, deine Zeit zu verschwenden, indem du immer wieder \"Steck das Horn auf den Yaznak\" spielst?!",shape=box,color=blue];
		j2893337572 -> j3486849899;
	j501975079 [label="Boolean RoatheUsurper is now true.",color=orange];
		j501975079 -> j2132723625;
	j253926473 [label="Hm, kein Grund zur Sorge ... oder Aufregung. Noch nicht. Es handelt sich lediglich um eine Geschäftsvereinbarung zwischen zwei Personen, die beide erheblich davon profitieren werden.",shape=box,color=blue];
		j253926473 -> j1343723447;
	j1544324174 [label="+5 Chemistry",color=orange];
		j1544324174 -> j791866330;
	j1343723447 [label="Also. Hör genau zu. Die beiden Eiferer haben mich mit ihren wiederholten Beschimpfungen auf so schreckliche und mühsame Weise verunglimpft. Ich erwarte von dir, dass du dich über solch ein erbärmliches Verhalten erhebst.",shape=box,color=blue];
		j1343723447 -> j3605932087;
		j1343723447 -> j4125189731;
	j3486849899 [label="Ich kann es mir nicht vorstellen, dass all dies – all das Unrecht, das ich durch deine Hand erlitten habe, all diese Zerstörung meiner Psyche – nicht einzig und allein aus Bosheit und auf dein Geheiß geschehen ist!",shape=box,color=blue];
		j3486849899 -> j340297768;
		j3486849899 -> j2445952209;
		j3486849899 -> j2125385756;
	j2132723625 [label="+5 Chemistry",color=orange];
		j2132723625 -> j271224324;
	j791866330 [label="Ich sehe, mein Ruf eilt mir voraus. Gut. Das spart uns Zeit.",shape=box,color=blue];
		j791866330 -> j1185969788;
	j3605932087 [label="Ich nehme von dir keine Befehle entgegen.",shape=box,color=red];
		j3605932087 -> j4026548805;
	j4125189731 [label="Mal sehen, was ich tun kann.",shape=box,color=red];
		j4125189731 -> j3197207691;
	j340297768 [label="Es schien keine Priorität zu haben?",shape=box,color=red];
		j340297768 -> j294101201;
	j2445952209 [label="Ich ... bin einfach nicht früher dazu gekommen.",shape=box,color=red];
		j2445952209 -> j3666872243;
	j2125385756 [label="Du erinnerst dich nicht ... aber wir haben das schon einmal durchgemacht.",shape=box,color=red];
		j2125385756 -> j1422729451;
	j271224324 [label="Ah! Das bist du doch, ja? Die Tenno haben das Ursprungssystem den Orokin entrissen. Und du, wie ein kleines Windei im Nest, hast dich aus deiner eigenen Welt in diese eingeschlichen.",shape=box,color=blue];
		j271224324 -> j3290116565;
	j1185969788 [label="Und es besteht kein Grund zur Sorge oder Aufregung ... noch nicht. Es handelt sich lediglich um eine Geschäftsvereinbarung zwischen zwei Personen, die beide erheblich davon profitieren werden.",shape=box,color=blue];
		j1185969788 -> j1343723447;
	j4026548805 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4026548805 -> j4129531935 [label="x >= 21",color=purple];
		j4026548805 -> j2967393536 [label="x >= 1",color=purple];
		j4026548805 -> j3566608733 [label="x <= 0",color=purple];
		j4026548805 -> j3566608733 [label="false",color=purple];
	j3197207691 [label="Mach das.",shape=box,color=blue];
		j3197207691 -> j1269595779;
	j294101201 [label="Es schien keine -",shape=box,color=blue];
		j294101201 -> j3121864683;
	j3666872243 [label="Oh! Es tut mir sehr leid, dir Unannehmlichkeiten bereitet zu haben, ich wusste nicht, dass die Termine auf deiner Tanzkarte bereits belegt waren!",shape=box,color=blue];
		j3666872243 -> j3651538518;
	j1422729451 [label="+5 Chemistry",color=orange];
		j1422729451 -> j4051120418;
	j3290116565 [label="Und das macht dich in meinen Augen mindestens in zweierlei Hinsicht zu einem Usurpator. (Und vielleicht in einem dritten Punkt, wenn wir das mitzählen, was mir der Butler über Duviri erzählt hat, aber das ist ein Thema für ein anderes Mal.)",shape=box,color=blue];
		j3290116565 -> j1343723447;
	j4129531935 [label="Das hast du wiederholt und schonungslos deutlich gemacht, danke.",shape=box,color=blue];
		j4129531935 -> j1269595779;
	j2967393536 [label="Das hast du deutlich gemacht.",shape=box,color=blue];
		j2967393536 -> j1269595779;
	j3566608733 [label="Wir werden sehen.",shape=box,color=blue];
		j3566608733 -> j1269595779;
	j1269595779 [label="Nun, die Sache ist einfach, mein charmant-gleitfähiger und dunstiger neuer \"Freund\".",shape=box,color=blue];
		j1269595779 -> j1071362491;
	j3121864683 [label="Es schien keine Priorität zu haben?!",shape=box,color=blue];
		j3121864683 -> j3483745489;
	j3651538518 [label="Wirklich. Ich bin fassungslos. Deine Manieren sind absolut unmöglich, Drifter.",shape=box,color=blue];
		j3651538518 -> j2543938223;
	j4051120418 [label="Wie bitte? Und wie kommt es, dass ich dich vergessen habe, wie du in meinen Gedanken herumgewühlt hast wie die Maliumschale auf einer Naberus-Party!",shape=box,color=blue];
		j4051120418 -> j2154931984;
		j4051120418 -> j2957001165;
	j1071362491 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j1071362491 -> j1494262935 [label="x >= 21",color=purple];
		j1071362491 -> j1934035969 [label="x >= 1",color=purple];
		j1071362491 -> j3918083582 [label="x <= 0",color=purple];
		j1071362491 -> j3918083582 [label="false",color=purple];
	j3483745489 [label="Wühlst du normalerweise in den Erinnerungen anderer herum und zerstörst ihre Vorstellungen, ohne vorher die Gelegenheit zu nutzen, sie kennenzulernen?!",shape=box,color=blue];
		j3483745489 -> j5829532;
	j2543938223 [label="Aber ich nehme an, da lässt sich jetzt nichts mehr machen. Du kennst die Wahrheit. Ich bin dir offenbart, in all meiner abscheulichen Feigheit.",shape=box,color=blue];
		j2543938223 -> j4132427572;
	j2154931984 [label="Kurz gesagt, es gibt da ... den Befall, der sich scheinbar auch auf die Protoframe-Seren ausdehnt ...",shape=box,color=red];
		j2154931984 -> j3212189069;
	j2957001165 [label="Ah. Nun ja. Ähm. Ich habe die Fähigkeit, eine Zeitschleife zu machen.",shape=box,color=red];
		j2957001165 -> j3212189069;
	j1494262935 [label="Da du in meinem Kopf schon wie ein betrunkener Razaliorn in einer Glasmacherwerkstatt herumgetobt hast, brauche ich deine Hilfe, um zu versuchen, das alles zu entschlüsseln.",shape=box,color=blue];
		j1494262935 -> j2266026878;
	j1934035969 [label="Du und die beiden Eiferer habt schon angefangen, in meinem Kopf herumzuwühlen wie ein betrunkener Razaliorn in einer Glasmacherwerkstatt. Ich brauche deine Hilfe, um zu entschlüsseln, was das alles bedeutet.",shape=box,color=blue];
		j1934035969 -> j2266026878;
	j3918083582 [label="Als Albrecht mir die Spritze in den Hals rammte und mich in dieses - Ding - verwandelte, tat er noch etwas anderes. Spiele unter Orokin sind eine Sache. Aber das hier? Das ist etwas ganz anderes.",shape=box,color=blue];
		j3918083582 -> j2468838921;
	j5829532 [label="Deine Manieren sind absolut grauenhaft!",shape=box,color=blue];
		j5829532 -> j2543938223;
	j4132427572 [label="Ich nehme an, du bist nur hierhergekommen, um mich zu verspotten. Ich bitte dich, dich nun daran zu ergötzen, damit wir das Thema ungestört fortsetzen können.",shape=box,color=blue];
		j4132427572 -> j247418901;
	j3212189069 [label="Und ich dachte, es hätte 1999 auf den Protoframes funktioniert, weil sich das Jahr selbst wiederholte, aber das ist nicht der Fall.",shape=box,color=red];
		j3212189069 -> j884955633;
	j2266026878 [label="Ich benötige nicht nur deine Hilfe, um meine Erinnerungen wiederzuerlangen – sondern als ob das nicht schon schlimm genug wäre, scheine ich auch nicht in der Lage zu sein, die Wahrheit hinter ihnen selbst zu erkennen!",shape=box,color=blue];
		j2266026878 -> j2543843648;
		j2266026878 -> j2673746412;
	j2468838921 [label="Er hat mir viele meiner Erinnerungen geraubt. Ich sehe dieses kleine es ... diese Version von dir, wie sie mit all ihren traumatisierten Tenno-Freunden umherirrt. Ich sehe, was die Lotus ihr hilft, wiederzuerlangen.",shape=box,color=blue];
		j2468838921 -> j448043486;
		j2468838921 -> j2070928162;
	j247418901 [label="Ich möchte nicht ständig damit zu kämpfen haben, dass mir so ein Vieh wie der zur Zierde gezüchtete, kläffende Kubrow einer Diva unter den Füßen herumläuft.",shape=box,color=blue];
		j247418901 -> j1093063802;
		j247418901 -> j3842489173;
	j884955633 [label="Ich glaube, es hat ... eher mit dem Befall selbst zu tun? Da ist diese sprechende Gitarre, die da so eine Andeutung gemacht hat. Und du bist in einem Helminth hierher gereist, nicht wahr?",shape=box,color=red];
		j884955633 -> j3789588212;
	j2543843648 [label="Du meinst also, du ... musst einfach mit jemandem reden?",shape=box,color=red];
		j2543843648 -> j2811167225;
	j2673746412 [label="Ich helfe dir gerne, wenn ich kann, ich weiß nur leider nicht genau wie.",shape=box,color=red];
		j2673746412 -> j28123237;
	j448043486 [label="Und ... warum gehst du nicht allein in die Dunkle Spiegelung?",shape=box,color=red];
		j448043486 -> j4024736535;
	j2070928162 [label="Das Kind ist kein \"es\".",shape=box,color=red];
		j2070928162 -> j3458237652;
	j1093063802 [label="Du bist geflohen. Aber viele fliehen. Es geht darum, sich dem Geschehenen zu stellen.",shape=box,color=red];
		j1093063802 -> j2480437847;
	j3842489173 [label="Ich werde dich nicht verspotten. Du hast dich entschieden, an einem anderen Tag weiterzukämpfen.",shape=box,color=red];
		j3842489173 -> j881656773;
	j3789588212 [label="Du scheinst über diese ganze Unterhaltung beunruhigend unsicher zu sein, Drifter. Vor allem, wenn es um den Inhalt meines Schädels geht.",shape=box,color=blue];
		j3789588212 -> j2094368771;
	j2811167225 [label="Oh, bitte lass es nicht so klingen, als ob ich mich einfach auf ein Sofa legen und meine \"Gefühle\" laut aussprechen müsste.",shape=box,color=blue];
		j2811167225 -> j28123237;
	j28123237 [label="Ich benötige jemanden, der die Maschine nach meinen Anweisungen bedient, da ich dazu momentan selbst nicht in der Lage bin.",shape=box,color=blue];
		j28123237 -> j4290024237;
	j4024736535 [label="Ich würde es ja selbst tun, glaub mir – aber ich kann nicht! Das verfluchte Protoframe-Serum, mit dem Albrecht mich vergiftet hat, hat mir jede Fähigkeit genommen, diese verdammte Apparatur selbst zu bedienen!",shape=box,color=blue];
		j4024736535 -> j948750719;
	j3458237652 [label="Ich versichere dir, das ist \"es\" sehr wohl.",shape=box,color=blue];
		j3458237652 -> j1245716977;
	j2480437847 [label="Add 1 to Thermostat counter",color=orange];
		j2480437847 -> j898384129;
	j881656773 [label="Add -1 to Thermostat counter",color=orange];
		j881656773 -> j4117148462;
	j2094368771 [label="Und ja. Ich bin tatsächlich durch einen Helminth hierhergekommen. Den ich selbst erschaffen und gezüchtet habe, danke. Nun, du behauptest also, dass du ... meine Erinnerungen gelöscht hast?! Was denn, unsere gemeinsamen Gespräche?! ",shape=box,color=blue];
		j2094368771 -> j1484081533;
	j4290024237 [label="Ich benötige außerdem jemanden, der mir hilft, meine Erinnerungen aufzuzeichnen und zu sortieren. Eine Art vorübergehende Assistenz.",shape=box,color=blue];
		j4290024237 -> j1886774134;
	j948750719 [label="Und außerdem benötige ich nicht nur deine Hilfe, um meine Erinnerungen wiederzuerlangen – sondern als ob das nicht schon schlimm genug wäre, scheine ich auch nicht in der Lage zu sein, die Wahrheit hinter ihnen selbst zu erkennen!",shape=box,color=blue];
		j948750719 -> j2543843648;
		j948750719 -> j2673746412;
	j1245716977 [label="Und ich würde es ja selbst tun, glaub mir – aber ich kann nicht! Das verfluchte Protoframe-Serum, mit dem Albrecht mich vergiftet hat, hat mir jede Fähigkeit genommen, diese verdammte Apparatur selbst zu bedienen!",shape=box,color=blue];
		j1245716977 -> j948750719;
	j898384129 [label="Fantastisch. Schon wieder so ein summendes Mistvieh, das mir um die Ohren schwirrt und mir einreden will, ich bräuchte Selbstreflexion und Reue?",shape=box,color=blue];
		j898384129 -> j391820043;
	j4117148462 [label="+5 Chemistry",color=orange];
		j4117148462 -> j4222840156;
	j1484081533 [label="Denn ich habe ganz gewiss \"schöne\" Erinnerungen daran, wie du mich zu Hackfleisch verarbeitet hast, nur zu deinem blutigen Vergnügen. Wie soll das denn bitte Sinn ergeben?",shape=box,color=blue];
		j1484081533 -> j3843589303;
		j1484081533 -> j2580123981;
	j1886774134 [label="Und im Gegenzug - verspreche ich dir feierlich, dass ich hier ... friedlich sitzen werde. Ich werde für niemanden eine Bedrohung darstellen ... wozu ich durchaus fähig bin. Ich werde weder den Eiferern noch dem Butler noch Albrechts vom Void verdorbenen Tieren etwas antun.",shape=box,color=blue];
		j1886774134 -> j281340083;
	j391820043 [label="Ich bin ein Glückspilz.",shape=box,color=blue];
		j391820043 -> j4046520473;
	j4222840156 [label="Im Moment scheint es eher so, also ob ich \"in einer Gruft mit zwei begriffsstutzigen Fanatikern verrotte und Kinkerlitzchen an kriegstraumatisierte Kinder verteile\".",shape=box,color=blue];
		j4222840156 -> j2991243704;
	j3843589303 [label="Ich weiß es nicht, und ich bin auch nicht hier, um mich weiterhin von dir beschimpfen zu lassen, Roathe. Ich habe nicht alle in die Schleife gesteckt, nur damit ich mich deswegen von dir anfeinden lassen muss.",shape=box,color=red];
		j3843589303 -> j924809495;
	j2580123981 [label="Soweit ich das beurteilen kann? Unsere Gespräche reichen nicht tief. Es sind oberflächliche Erinnerungen. Was wir in deiner Vergangenheit aufgedeckt haben, war ... eher Teil deiner Kernerinnerungen, nehme ich an?",shape=box,color=red];
		j2580123981 -> j3433970105;
	j281340083 [label="Und noch wichtiger: Ich werde Albrechts verdrehter Familie, die wie mutierte Pflanzen über uns thront – und dabei unsere Anwesenheit völlig ignoriert –, keinen Schaden zufügen.",shape=box,color=blue];
		j281340083 -> j728617917;
		j281340083 -> j4054575949;
		j281340083 -> j512792242;
	j4046520473 [label="Ich werde meinen Geschäften nachgehen, Drifter, aber Tatsache bleibt: Du weißt zu viel über meine Vergangenheit und meine Taten. Und wir werden uns wohl oder übel ... damit abfinden müssen.",shape=box,color=blue];
		j4046520473 -> j3147580672;
	j2991243704 [label="Aber ich nehme an, so nennt man es jetzt.",shape=box,color=blue];
		j2991243704 -> j4046520473;
	j924809495 [label="Ja. Ich könnte eine Vermutung wagen, warum du deine Void-Kräfte eingesetzt hast, um unsere Erinnerungen an die jüngsten Ereignisse auszulöschen. Wie vorhersehbar.",shape=box,color=blue];
		j924809495 -> j3485630335;
	j3433970105 [label="Fantastisch. Absolut wunderbar. Ich bin jetzt in den Händen eines Verrückten, der meine Erinnerungen nach Belieben auslöschen kann! Wie entzückend.",shape=box,color=blue];
		j3433970105 -> j3485630335;
	j728617917 [label="Ich dachte, das wäre ein Vorschlag. Und jetzt bedrohst du mich?",shape=box,color=red];
		j728617917 -> j1122536909;
	j4054575949 [label="Roathe? Bitte hör auf und hör mir einen Moment zu.",shape=box,color=red];
		j4054575949 -> j3988910388;
	j512792242 [label="Was soll ich tun?",shape=box,color=red];
		j512792242 -> j3838128256;
	j3147580672 [label="Versuche, mir die Situation nicht allzu unangenehm zu machen, und ich verspreche dir, dass ich im Gegenzug dasselbe versuchen werde.",shape=box,color=blue];
		j3147580672 -> j2415862323;
		j3147580672 -> j2646371822;
	j3485630335 [label="Nun gut. Wenn das, was du sagst, stimmt – und ich nehme an, diese Geschichte ist verrückt genug, um wahr zu sein –, werde ich versuchen, es dir nicht übel zu nehmen, dass du diese tiefe und schreckliche Wahrheit von mir kennst.",shape=box,color=blue];
		j3485630335 -> j4102197672;
	j1122536909 [label="Hast du nicht aufgepasst? Ehrlich, Leseverständnis heutzutage ... Ich habe dich nicht bedroht, Usurpator. Und auch sonst niemanden.",shape=box,color=blue];
		j1122536909 -> j387147891;
	j3988910388 [label="Das wird bestimmt großartig. Bitte. Nur zu; die Bühne gehört dir.",shape=box,color=blue];
		j3988910388 -> j1412685412;
		j3988910388 -> j3716119797;
		j3988910388 -> j449719237;
	j3838128256 [label="Hast du nicht aufgepasst? Ehrlich, Leseverständnis heutzutage ... Ich versuche, mit dir einen Handel abzuschließen, Usurpator. Ich kann kaum glauben, dass du nicht folgen kannst.",shape=box,color=blue];
		j3838128256 -> j3756248994;
	j2415862323 [label="Nein.",shape=box,color=red];
		j2415862323 -> j477174122;
	j2646371822 [label="Ich denke das ist fair.",shape=box,color=red];
		j2646371822 -> j2953527902;
	j4102197672 [label="Ich möchte dich jedoch bitten – wenn ich darf –, dass du dich nach Herzenslust über mich lustig machst, damit wir das Thema ungestört beenden können.",shape=box,color=blue];
		j4102197672 -> j247418901;
	j387147891 [label="Ich wollte lediglich darauf hinweisen, dass ich, sollte ich an einen Punkt gelangen, an dem ich meine Endziele nicht mehr erreichen kann, möglicherweise keinen Grund mehr habe, länger still zu sitzen.",shape=box,color=blue];
		j387147891 -> j3756248994;
	j1412685412 [label="Ich bin der Grund dafür, dass Ballas Tod ist. Zwing mich nicht, meinen Terminkalender freizuräumen.",shape=box,color=red];
		j1412685412 -> j2023899136;
	j3716119797 [label="Wenn du meine Hilfe möchtest, ist das kein guter Weg, sie zu bekommen.",shape=box,color=red];
		j3716119797 -> j2722708881;
	j449719237 [label="Ich weiß, wir haben nicht viel Erfahrung miteinander – nicht wirklich. Aber ich bin hier, um dir zu helfen.",shape=box,color=red];
		j449719237 -> j3874050804;
	j3756248994 [label="Wenn mein Vorschlag deinen Ansprüchen nicht genügt, soll ich ihn für dich noch etwas versüßen?",shape=box,color=blue];
		j3756248994 -> j3136518450;
	j477174122 [label="+5 Chemistry",color=orange];
		j477174122 -> j3732930793;
	j2953527902 [label="+15 Chemistry",color=orange];
		j2953527902 -> j3058198827;
	j2023899136 [label="+5 Chemistry",color=orange];
		j2023899136 -> j213336777;
	j2722708881 [label="Und wenn du meine willst, dann schlage ich vor – wie gesagt –, dass wir eine Vereinbarung treffen.",shape=box,color=blue];
		j2722708881 -> j3756248994;
	j3874050804 [label="Und? Ah, verstehe. Du störst dich also an meinem \"Ton\"? Das tut mir furchtbar leid. Ich wusste nicht, dass du so empfindlich bist.",shape=box,color=blue];
		j3874050804 -> j3756248994;
	j3136518450 [label="Mir ist zu Ohren gekommen, dass auf Deimos eine Vielzahl von Angelegenheiten gibt, bei denen meine Hilfe nicht nur sinnvoll, sondern, ich wage es zu sagen, von entscheidender Bedeutung sein könnte.",shape=box,color=blue];
		j3136518450 -> j3848354927;
	j3732930793 [label="Ha! Respekt zu deiner Ehrlichkeit, wenn sonst auch zu nichts anderem.",shape=box,color=blue];
		j3732930793 -> j3229972535;
	j3058198827 [label="Wunderbar. Es ist gut zu wissen, dass du zumindest ... umgänglich bist.",shape=box,color=blue];
		j3058198827 -> j3229972535;
