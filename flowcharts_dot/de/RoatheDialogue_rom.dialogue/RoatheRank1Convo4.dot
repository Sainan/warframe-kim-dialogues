digraph {
	472 [label="RoatheRank1Convo4 begins.",color=orange];
		472 -> 473;
	473 [label="Check boolean LoidFamilyComplete",color=orange];
		473 -> 474 [label=true,color=green];
		473 -> 475 [label=false,color=brown];
	474 [label="Es ist fast schon tragisch, was aus Euleria und Petros geworden ist. Wir waren nie Freunde, wohlgemerkt. Aber sie waren trotzdem Orokin. Und jetzt sind nur noch wenige von uns übrig. Wobei ich wohl vorsichtig sein sollte, was ich sage – wer weiß, worin ich mit der Zeit noch verwandeln könnte.",shape=box,color=blue];
		474 -> 476;
	475 [label="Ich finde es geradezu urkomisch, dass Euleria und Petros wirklich nicht die geringste Ahnung haben, dass wir hier unten sind. Wie Ratten, die unter ihren Füßen herumwuseln. Wie habt ihr es bloß so lange geschafft, das alles geheim zu halten?",shape=box,color=blue];
		475 -> 477;
	476 [label="Am wenigsten überrascht mich, dass \"Großmutter\" überlebt hat. (Stell dir vor, einen so schönen Namen wie Dagath aufzugeben.)",shape=box,color=blue];
		476 -> 478;
		476 -> 479;
	477 [label="Evaluate expressions on HellStory",color=orange];
		477 -> 481 [label="x >= 21",color=purple];
		477 -> 480 [label="x < 21",color=purple];
		477 -> 480 [label="false",color=purple];
	478 [label="Petros?",shape=box,color=red];
		478 -> 482;
	479 [label="Was hältst du von den Kindern?",shape=box,color=red];
		479 -> 483;
	481 [label="Obwohl ich ehrlich gesagt viel überraschter bin, dass \"Großmutter\" es nicht mitbekommt. (Stell dir vor, einen so schönen Namen wie Dagath aufzugeben.) Ich hätte ihr mehr Verstand zugetraut.",shape=box,color=blue];
		481 -> 486;
	480 [label="Obwohl ich ehrlich gesagt viel überraschter bin, dass \"Großmutter\" es nicht mitbekommt. (Stell dir vor, einen so schönen Namen wie Dagath aufzugeben.) Ich hätte ihr mehr Intellekt zugetraut.",shape=box,color=blue];
		480 -> 484;
		480 -> 485;
	482 [label="Hm? Ah. Der Nekraloid teilte mir mit, dass du oder das Kind herumgestampft seid und ihnen geholfen habt, sich falsche Namen auszudenken, da sie ihre ursprünglichen vergessen hatten. Du kennst ihn als \"Vilcor\".",shape=box,color=blue];
		482 -> 487;
	483 [label="Der Junge ist trotzig, nervtötend und egozentrisch. Ein typischer Orokin. \"Kaelli\", wie sie sich jetzt lieber nennen lässt, finde ich bemerkenswert intelligent und ihre Anwesenheit ist fast zu ertragen.",shape=box,color=blue];
		483 -> 488;
	486 [label="Ich. Das ist absurd. Ich weiß, wir haben das alles schon einmal durchgemacht. Und wir haben bereits darüber gesprochen. Was mich nach wie vor sehr verstört.",shape=box,color=blue];
		486 -> 491;
	484 [label="Sie haben ihre eigenen ... Probleme, auf die sie sich konzentrieren müssen.",shape=box,color=red];
		484 -> 489;
	485 [label="Petros?",shape=box,color=red];
		485 -> 490;
	487 [label="Aber ich kannte ihn als Petros Vorten. Den stolzen Erfinder der Necramech-Flotte. Es ist seltsam, sich vorzustellen, wie viel Zeit für ihn vergangen ist und wie wenig Zeit – relativ gesehen – für mich vergangen ist.",shape=box,color=blue];
		487 -> 488;
	488 [label="Aber wieso weißt du das nicht schon längst? Willst du mich etwa für dumm verkaufen, Usurpator? Sicherlich treten wir nur ... alten Pfaden nach, nicht wahr?",shape=box,color=blue];
		488 -> 492;
	491 [label="Evaluate expressions",color=orange];
		491 -> 498 [label="RoatheDatingDeal",color=purple];
		491 -> 498 [label="RoatheMarieDatingDeal",color=purple];
		491 -> 498 [label="RoatheLyonDatingDeal",color=purple];
		491 -> 498 [label="RoatheSerumDeal",color=purple];
		491 -> 497 [label="RoatheFamilyDeal",color=purple];
		491 -> 498 [label="RoatheMarieEntratiDeal",color=purple];
		491 -> 498 [label="RoatheLyonConfessionDeal",color=purple];
		491 -> 499 [label="false",color=purple];
	489 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		489 -> 494 [label=true,color=green];
		489 -> 493 [label=false,color=brown];
	490 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		490 -> 496 [label=true,color=green];
		490 -> 495 [label=false,color=brown];
	492 [label="Update boolean RoatheKnowsReset",color=orange];
		492 -> 500;
		492 -> 501;
		492 -> 502;
	498 [label="Hier bin ich nun, bereit, einen etwas wirren Vortrag über die Gesellschaft der Orokin zu halten, in der Hoffnung, dass es dich vielleicht ein wenig interessieren könnte. Und dann erinnere ich mich: Deswegen bist du nicht hier, nicht wahr, Drifter? Du hast noch ein anderes Spiel zu spielen ...",shape=box,color=blue];
		498 -> 506;
	497 [label="Hier bin ich nun, bereit, einen etwas wirren Vortrag über die Gesellschaft der Orokin zu halten, in der Hoffnung, dass es dich vielleicht ein wenig interessieren könnte. Und dann erinnere ich mich: Du hast das alles höchstwahrscheinlich schon einmal gehört, nicht wahr?",shape=box,color=blue];
		497 -> 505;
	499 [label="Soll ich einfach mitspielen? Oder ... verfolgst du damit ein bestimmtes Ziel? Ich bin eher verwirrt, was du dir von diesem grausamen Spiel erhoffst.",shape=box,color=blue];
		499 -> 507;
	494 [label="Ja, das habe ich vom Nekraloid bereits gehört. Es scheint aber, als ob es weniger geworden sind, seitdem du oder das Kind an der Lösung dieser gearbeitet haben. Zumindest zerfleischen sie sich nicht mehr – im wahrsten Sinne des Wortes.",shape=box,color=blue];
		494 -> 504;
	493 [label="Ja, das habe ich vom Nekraloid bereits gehört. Es scheint, als seien sie immer noch darauf aus, sich selbst zu zerfleischen.",shape=box,color=blue];
		493 -> 503;
	496 [label="Hm? Ah. Der Nekraloid teilte mir mit, dass du oder das Kind herumgestampft seid und ihnen geholfen habt, sich falsche Namen auszudenken, da sie ihre ursprünglichen vergessen hatten. Du kennst ihn als \"Vilcor\". Aber ich kannte ihn als Petros Vorten. Stolzer Erfinder der Necramech-Flotte.",shape=box,color=blue];
		496 -> 504;
	495 [label="Hm? Ah. Ich kannte ihn als Petros Vorten. Stolzer Erfinder der Necramech-Flotte. Aber der Nekraloid teilte mir mit, dass sie ihre Namen vergessen haben. Du kennst ihn wahrscheinlich nur weiterhin als \"Vater\".",shape=box,color=blue];
		495 -> 503;
	500 [label="Nein, das habe ich noch nie gehört. Bitte, fahre fort.",shape=box,color=red];
		500 -> 508;
	501 [label="Ich spreche mit dir, Roathe ... weil ich mit dir reden möchte.",shape=box,color=red];
		501 -> 509;
	502 [label="Das habe ich schon einmal gehört, ja. Aber bitte erzähl es mir trotzdem noch einmal.",shape=box,color=red];
		502 -> 510;
	506 [label="Update boolean RoatheKnowsReset",color=orange];
		506 -> 500;
		506 -> 501;
		506 -> 502;
	505 [label="Update boolean RoatheKnowsReset",color=orange];
		505 -> 500;
		505 -> 501;
		505 -> 502;
	507 [label="Update boolean RoatheKnowsReset",color=orange];
		507 -> 515;
	504 [label="Evaluate expressions",color=orange];
		504 -> 514 [label="RoatheDeal",color=purple];
		504 -> 513 [label="RoatheNoDeal",color=purple];
		504 -> 513 [label="false",color=purple];
	503 [label="Evaluate expressions",color=orange];
		503 -> 512 [label="RoatheDeal",color=purple];
		503 -> 511 [label="RoatheNoDeal",color=purple];
		503 -> 511 [label="false",color=purple];
	508 [label="+5 Chemistry",color=orange];
		508 -> 516;
	509 [label="Check boolean DrifterRoathe",color=orange];
		509 -> 517 [label=true,color=green];
		509 -> 518 [label=false,color=brown];
	510 [label="Du gibst also zu, dass du meine Zeit verschwendest. Wie fantastisch! Ich bin doch kein verbitterter, seniler alter Mann, der nur eine einzige Kriegsgeschichte erzählt, weil er sich an keine andere erinnern kann.",shape=box,color=blue];
		510 -> 519;
	515 [label="Hier bin ich nun, bereit, einen etwas wirren Vortrag über die Gesellschaft der Orokin zu halten, in der Hoffnung, dass es dich vielleicht ein wenig interessieren könnte. Und dann erinnere ich mich: Du hast das alles höchstwahrscheinlich schon einmal gehört, nicht wahr?",shape=box,color=blue];
		515 -> 500;
		515 -> 501;
		515 -> 502;
	514 [label="Was gut ist, denn ohne dich oder das Kind, wären wir kaum weitergekommen, da ihr diesen ersten Schritt erledigt habt. Ich fürchte, der Butler wäre sonst wohl zu Hackfleisch verarbeitet worden, sobald wir ihn die Treppe hinaufgeschickt hätten.",shape=box,color=blue];
		514 -> 522;
	513 [label="Hast du meinen Vorschlag übrigens noch einmal überdacht? Dass ich hier ruhig sitze, im Gegenzug für meine Hilfe bei der Versöhnung des Butlers und den verseuchten, verlassenen Ausgestoßenen der Orokin im Obergeschoss?",shape=box,color=blue];
		513 -> 520;
		513 -> 521;
	512 [label="Vielleicht solltest du dieses Problem zuerst lösen, bevor wir versuchen, den Butler die Treppe hinaufzuschicken. Sonst wird er dabei womöglich zu Hackfleisch verarbeitet.",shape=box,color=blue];
		512 -> 522;
	511 [label="Hast du meinen Vorschlag übrigens noch einmal überdacht? Dass ich hier ruhig sitze, im Gegenzug für meine Hilfe bei der Versöhnung des Butlers und den verseuchten, verlassenen Ausgestoßenen der Orokin im Obergeschoss? Die Versöhnung der Familie wäre der erste Schritt, aber ...",shape=box,color=blue];
		511 -> 520;
		511 -> 521;
	516 [label="Du hast einen Orokin zum Sprechen aufgefordert. Du weißt nicht, was du getan hast. Du wirst hier eine Stunde festhängen, wenn du nicht vorsichtig bist.",shape=box,color=blue];
		516 -> 523;
	517 [label="+5 Chemistry",color=orange];
		517 -> 524;
	518 [label="Oh? So sage mir, warum das so ist, ich \"bitte\" dich.",shape=box,color=blue];
		518 -> 528;
		518 -> 527;
		518 -> 525;
		518 -> 526;
	519 [label="Der Grund, warum ich mich an dieses Gespräch nicht erinnern kann, steht in deinem verdammten Spiegel!",shape=box,color=blue];
		519 -> 529;
	522 [label="Etwas musst du verstehen: Der Butler und die Familie Entrati sind, so weit entfernt sie auch sind, dennoch Orokin. Sie wurden in diese Gesellschaft geboren und in ihr erzogen, mit all ihren ... vielen Fehlern.",shape=box,color=blue];
		522 -> 532;
	520 [label="Nein, ich ändere meine Meinung nicht, Roathe. Es ist nicht so wichtig.",shape=box,color=red];
		520 -> 530;
	521 [label="Ja, habe ich. Ich ... stimme zu.",shape=box,color=red];
		521 -> 531;
	523 [label="Aber ich nehme an, du hattest nicht viele Gelegenheiten, dich mit Orokin abzugeben, nicht wahr, Drifter? Das Kind führte ein ganz anderes Leben.",shape=box,color=blue];
		523 -> 533;
	524 [label="Hm. Genau. Und wir beide wissen, warum, nicht wahr? Aber du wirst Geduld haben.",shape=box,color=blue];
		524 -> 534;
	528 [label="[Gefühle gestehen.] Ich glaube, du weißt es.",shape=box,color=red];
		528 -> 538;
	527 [label="Ich finde dich faszinierend.",shape=box,color=red];
		527 -> 537;
	525 [label="Ich hatte nie wirklich Gelegenheit, mit Orokin zu interagieren. Zumindest nicht ... wenn ich gerade nicht gegen sie gekämpft habe. Du bist faszinierend.",shape=box,color=red];
		525 -> 535;
	526 [label="Vergiss es. [Ende.]",shape=box,color=red];
		526 -> 536;
	529 [label="Chat ends.",color=orange];
	532 [label="Und trotz all ihrer schwerwiegenden Verfehlungen wurden Rang und Ordnung nie infrage gestellt. Weder beim Militär noch in der Gesellschaft. Die Archimeden gehorchten den Orokin. Die Orokin gehorchten den Exekutoren. Die Exekutoren gehorchten den Herrschern ... zumindest dem Namen nach.",shape=box,color=blue];
		532 -> 541;
	530 [label="Wie du willst. Die Tür bleibt nicht lange offen.",shape=box,color=blue];
		530 -> 539;
	531 [label="Update boolean RoatheNoDeal",color=orange];
		531 -> 540;
	533 [label="Soweit ich gehört habe, hast du einen anderen Pfad eingeschlagen, als die Tragödie der Zariman Ten-Zero ihren Höhepunkt erreichte.",shape=box,color=blue];
		533 -> 542;
		533 -> 543;
		533 -> 544;
	534 [label="Wenn du in der Zwischenzeit \"zuhören\" möchtest, komme ich deinem Wunsch gerne nach. Nur zur Warnung: Du hast einen Orokin gebeten zu sprechen.",shape=box,color=blue];
		534 -> 545;
	538 [label="+5 Chemistry",color=orange];
		538 -> 549;
	537 [label="+5 Chemistry",color=orange];
		537 -> 548;
	535 [label="Kenne deinen Feind, ist es das? Oder vielleicht nur Neugier, dem Unmöglichen sprichwörtlich gegenüberzusitzen?",shape=box,color=blue];
		535 -> 546;
	536 [label="Zappel so viel du willst, Fisch. Du bist zu mir geschwommen.",shape=box,color=blue];
		536 -> 547;
	541 [label="Und selbst wenn du nicht glaubst, dass Loid mir zuhören wird, nach all der Zeit, aufgrund dieser alten Traditionen? Bedenke, dass ich sehr ... überzeugend sein kann. Schließlich war ich die rechte Hand des schlimmsten der Exekutoren.",shape=box,color=blue];
		541 -> 551;
		541 -> 552;
		541 -> 553;
	539 [label="Chat ends.",color=orange];
	540 [label="Update boolean RoatheDeal",color=orange];
		540 -> 550;
	542 [label="Nein. Ich habe mich vor der Zariman nie wirklich mit den Orokin beschäftigt – und danach, nun ja ... Du kennst sicher das wesentliche.",shape=box,color=red];
		542 -> 554;
	543 [label="Ich habe genug mit den Orokin zu tun gehabt, um zu wissen, dass man ihnen nicht über den Weg trauen kann.",shape=box,color=red];
		543 -> 555;
	544 [label="Ich muss dir leider gestehen, dass ich deine Art genauso wenig liebe wie das Kind.",shape=box,color=red];
		544 -> 555;
	545 [label="Du weißt nicht, was du getan hast. Du wirst hier eine Stunde festhängen, wenn du nicht vorsichtig bist.",shape=box,color=blue];
		545 -> 523;
	549 [label="Hm. Ja, das tue ich. Und ich dachte schon, du würdest mir die Ehre erweisen, es mir schriftlich zu zeigen. Nun ja ...",shape=box,color=blue];
		549 -> 557;
	548 [label="Ist das so? Hm. Mal sehen, wie lange ich diesen Fisch am Speer halten kann.",shape=box,color=blue];
		548 -> 534;
	546 [label="+5 Chemistry",color=orange];
		546 -> 556;
	547 [label="Chat ends.",color=orange];
	551 [label="Der schlimmste war Ballas.",shape=box,color=red];
		551 -> 559;
	552 [label="Welchem hast du gedient?",shape=box,color=red];
		552 -> 560;
	553 [label="Wie meinst du das?",shape=box,color=red];
		553 -> 561;
	550 [label="+5 Chemistry",color=orange];
		550 -> 558;
	554 [label="Ja, kenne ich. Ach, Ballas. Es mag dich schockieren zu erfahren, dass er nicht der Schlimmste von ihnen war.",shape=box,color=blue];
		554 -> 562;
		554 -> 563;
	555 [label="Ich glaube auch nicht, dass ich dir die Schuld gebe. Ich dachte, sie wären noch zu retten. Könnten eingeschmolzen werden, sozusagen – umgeformt, neu gegossen, wie Gold.",shape=box,color=blue];
		555 -> 564;
	557 [label="Ein anderes Mal vielleicht. Denn du, Usurpator, musst lernen, diese Momente zu genießen.",shape=box,color=blue];
		557 -> 566;
	556 [label="Respektabel. Weise sogar. Hätte ich die Gelegenheit gehabt, einen Sentient zu interviewen und mich vielleicht sogar mit ihm anzufreunden? Ich hätte genauso gehandelt.",shape=box,color=blue];
		556 -> 565;
	559 [label="Ich respektiere deine Meinung und mache die deswegen keinen Vorwurf. Ballas war ein Idiot und ein Meister unter den Verkommenen, darüber will ich nicht mit dir streiten.",shape=box,color=blue];
		559 -> 567;
	560 [label="Evaluate expressions on HellStory",color=orange];
		560 -> 569 [label="x >= 1",color=purple];
		560 -> 568 [label="x <= 1",color=purple];
		560 -> 568 [label="false",color=purple];
	561 [label="Ich verstehe, dass du persönlich mit Ballas zu tun hattest, und ich kann es dir nicht verdenken, dass du ihn wahrscheinlich für den Schlimmsten der Sieben Goldenen Herrscher hältst. Er war ein Meister der Verkommenheit, da stimme ich dir zu.",shape=box,color=blue];
		561 -> 570;
	558 [label="Wunderbar! Ich bin froh, dass du endlich zur Vernunft gekommen bist. Jetzt werden wir endlich weiter kommen.",shape=box,color=blue];
		558 -> 522;
	562 [label="Wirklich?",shape=box,color=red];
		562 -> 571;
	563 [label="Es wird dir schwerfallen, mich davon zu überzeugen.",shape=box,color=red];
		563 -> 571;
	564 [label="Naja. Außer den Exekutoren. Sie waren ein hoffnungsloser Fall. Es mag dich schockieren zu erfahren, dass Ballas nicht der Schlimmste von ihnen war.",shape=box,color=blue];
		564 -> 563;
		564 -> 562;
	566 [label="Update boolean DrifterRoathe",color=orange];
		566 -> 534;
	565 [label="Es bietet einen psychologischen Vorteil, falls du jemals einem – oder gar dein ehemaliger Verbündeter – auf dem Schlachtfeld begegnest.",shape=box,color=blue];
		565 -> 572;
	567 [label="Und tatsächlich habe ich den Schrecken dieser \"Narmer\"-Sache, von der mir der Butler erzählt hat und von der ich aus den Aufzeichnungen auf dieser POM-2-Maschine hier weiß, nicht selbst miterlebt.",shape=box,color=blue];
		567 -> 573;
	569 [label="Du hast mich schon von ihr sprechen hören. Und, noch wichtiger, auch von unseren Plänen. Aber das ist eine andere Geschichte. Exekutorin Nitokh. Großregent-Exekutorin Nitokh, um genau zu sein. Befehlshaberin all unserer Streitkräfte und die bösartigste und tödlichste der Sieben Goldenen Herrscher.",shape=box,color=blue];
		569 -> 574;
	568 [label="Exekutorin Nitokh. Großregent-Exekutorin Nitokh, um genau zu sein. Die Befehlshaberin aller Streitkräfte des Imperiums der Orokin. Und die bösartigste und tödlichste der Sieben Goldenen Herrscher.",shape=box,color=blue];
		568 -> 574;
	570 [label="Es ist sogar durchaus möglich, dass er die alten Exekutoren mit dieser ... \"Narmer\"-Sache, von der mir der Butler erzählt hat und von der ich auf diesem POM-2 gelesen habe, übertroffen hat.",shape=box,color=blue];
		570 -> 573;
	571 [label="Ich behaupte nicht, er sei ein Heiliger gewesen. Ich sage dir nur, dass selbst der schlimmste Teufel seinen Kollegen ebenbürtig war. Das ist Haarspalterei, Usurpator.",shape=box,color=blue];
		571 -> 575;
	572 [label="Nun, wenn du \"zuhören\" möchtest, komme ich deinem Wunsch gerne nach. Nur zur Warnung: Du hast einen Orokin gebeten zu sprechen.",shape=box,color=blue];
		572 -> 545;
	573 [label="Dennoch möchte ich darauf hinweisen, dass dieser Eindruck auf deine sehr persönliche Nähe zu Ballas und deine sehr begrenzten Interaktionen mit den anderen sechs Goldenen Herrschern zurückzuführen ist.",shape=box,color=blue];
		573 -> 574;
	574 [label="Goldene Sieben. Pah. Weißt du, was das Beste an Gold ist, Drifter? Man kann es unendlich oft einschmelzen und zu etwas Besserem wiederverwerten.",shape=box,color=blue];
		574 -> 576;
	575 [label="Aber war Ballas der Schlimmste? Für dich vielleicht. Und vielleicht übertrafen seine Verbrechen in dieser Zeit sogar die der Exekutoren vergangener Zeiten.",shape=box,color=blue];
		575 -> 577;
	576 [label="Ich dachte – und glaube es gewissermaßen immer noch –, dass die Orokin noch zu retten waren. Dass wir das Imperium hätten wenden können. Aber die Exekutoren? Nein. Sie mussten gestoppt werden. Sie waren das Schlimmste, was die Menschheit zu bieten hatte, wenn auch nur in anderem Maße.",shape=box,color=blue];
		576 -> 578;
	577 [label="Doch wenn du die purpurroten Seen und die Felder voller verbogener und zerfetzter Leichen, die wie weggeworfenes Kinderspielzeug aussahen, gesehen hättest –",shape=box,color=blue];
		577 -> 579;
	578 [label="Und das kommt von mir, Usurpator. Erlaube mir also, dem Teufel von Tau, dir zu versichern – als Fachkundiger höchstpersönlich – dass Ballas nicht der Schlimmste unter ihnen war.",shape=box,color=blue];
		578 -> 580;
	579 [label="Hättest du gesehen, welch verheerende Zerstörung Nitokh in einem Wimpernschlag anrichten konnte ... ",shape=box,color=blue];
		579 -> 581;
	580 [label="Check boolean RoatheUsurper",color=orange];
		580 -> 583 [label=true,color=green];
		580 -> 584 [label=true,color=green];
		580 -> 582 [label=false,color=brown];
		580 -> 583 [label=false,color=brown];
		580 -> 584 [label=false,color=brown];
	581 [label="Doch solche Schrecken sind schwer zu begreifen, wenn man sie nicht selbst miterlebt hat. Solche Tragödien lassen sich nicht in Zahlen fassen. Ich könnte ausführlich erzählen, was ich gesehen habe, aber für dich wären es eben nur - Geschichten.",shape=box,color=blue];
		581 -> 585;
	583 [label="Es wird dir schwerfallen, mich davon zu überzeugen.",shape=box,color=red];
		583 -> 587;
	584 [label="Wirklich?",shape=box,color=red];
		584 -> 587;
	582 [label="Warum nennst du mich immer wieder \"Usurpator\"?",shape=box,color=red];
		582 -> 586;
	585 [label="Für dich wird Ballas immer der weitaus präsentere und schrecklichere Übeltäter bleiben. Und das ist auch zu erwarten.",shape=box,color=blue];
		585 -> 588;
	587 [label="Wenn du die purpurroten Seen und die Felder voller verbogener und zerfetzter Leichen, die wie weggeworfenes Kinderspielzeug aussahen, gesehen hättest –",shape=box,color=blue];
		587 -> 579;
	586 [label="Ah! Das bist du doch, ja? Die Tenno haben das Ursprungssystem den Orokin entrissen. Und du, wie ein kleines Windei im Nest, hast dich aus deiner eigenen Welt in diese eingeschlichen.",shape=box,color=blue];
		586 -> 589;
	588 [label="Aber es gibt vieles über ihn, was du nicht weißt. Über diesen Idioten wurde schon viel zu viel gesagt. Und ich fürchte, es muss noch mehr gesagt werden.",shape=box,color=blue];
		588 -> 590;
		588 -> 591;
	589 [label="Und das macht dich in meinen Augen mindestens in zweierlei Hinsicht zu einem Usurpator. (Und vielleicht in einem dritten Punkt, wenn wir das mitzählen, was mir der Butler über Duviri erzählt hat, aber das ist ein Thema für ein anderes Mal.)",shape=box,color=blue];
		589 -> 592;
	590 [label="Wie zum Beispiel?",shape=box,color=red];
		590 -> 593;
	591 [label="Ich habe kein Interesse daran, etwas über Ballas' Leben zu hören.",shape=box,color=red];
		591 -> 594;
	592 [label="Lenk mich nicht ab, Usurpator. Ich verstehe, dass es dir schwerfällt mir zu glauben, aber wenn du die purpurroten Seen und die Felder voller verbogener und zerfetzter Leichen, die wie weggeworfenes Kinderspielzeug aussahen, gesehen hättest –",shape=box,color=blue];
		592 -> 595;
	593 [label="Update boolean RoatheBallas1",color=orange];
		593 -> 596;
	594 [label="Hm, ja. Nun, dann musst du dir wohl oder übel Geschichten aus meinem Leben anhören. Wie drollig.",shape=box,color=blue];
		594 -> 597;
