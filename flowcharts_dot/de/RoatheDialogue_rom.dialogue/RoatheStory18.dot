	2292 [label="Transkript: 'Frieden?'",shape=box,color=blue];
		2292 -> 5717;
	5717 [label="Ihre Stimme klang wie zerbrochenes Glas in meinen Ohren.",shape=box,color=blue];
		5717 -> 5718;
	5718 [label="Exekutorin Nitokh war unzufrieden. Sie erwartete eine glorreiche Eskalation, Schlacht um Schlacht, die im triumphalen Untergang der Orokin gipfeln sollte.",shape=box,color=blue];
		5718 -> 5719;
	5719 [label="Danach würde sie aus ihrem Versteck auftauchen und ... nun ja, darüber kann ich nur spekulieren. Vielleicht erwartete sie, in das Vertrauen der Sentients aufgenommen zu werden.",shape=box,color=blue];
		5719 -> 2291;
	2291 [label="Oder sie dachte, sie würden die verbrannten, verseuchten Überreste des Ursprungssystems zurücklassen und ihr die Errichtung eines eigenen neuen Königreichs überlassen.",shape=box,color=blue];
		2291 -> 2297;
	2297 [label="Wie dem auch sei, Frieden würde nicht toleriert werden. Also machten wir uns daran, ihn zu untergraben.",shape=box,color=blue];
		2297 -> 2290;
	2290 [label="Add 1 to HellStory",color=orange];
		2290 -> 2345;
