	j3629362451 [label="SN: VERRAT",shape=box,color=blue];
		j3629362451 -> j2162129704;
	j2162129704 [label="Transkript: 'Frieden?'",shape=box,color=blue];
		j2162129704 -> j3876098630;
	j3876098630 [label="Ihre Stimme klang wie zerbrochenes Glas in meinen Ohren.",shape=box,color=blue];
		j3876098630 -> j1571744999;
	j1571744999 [label="Exekutorin Nitokh war unzufrieden. Sie erwartete eine glorreiche Eskalation, Schlacht um Schlacht, die im triumphalen Untergang der Orokin gipfeln sollte.",shape=box,color=blue];
		j1571744999 -> j1097353399;
	j1097353399 [label="Danach würde sie aus ihrem Versteck auftauchen und ... nun ja, darüber kann ich nur spekulieren. Vielleicht erwartete sie, in das Vertrauen der Sentients aufgenommen zu werden.",shape=box,color=blue];
		j1097353399 -> j3086733487;
	j3086733487 [label="Oder sie dachte, sie würden die verbrannten, verseuchten Überreste des Ursprungssystems zurücklassen und ihr die Errichtung eines eigenen neuen Königreichs überlassen.",shape=box,color=blue];
		j3086733487 -> j3094519441;
	j3094519441 [label="Wie dem auch sei, Frieden würde nicht toleriert werden. Also machten wir uns daran, ihn zu untergraben.",shape=box,color=blue];
		j3094519441 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}