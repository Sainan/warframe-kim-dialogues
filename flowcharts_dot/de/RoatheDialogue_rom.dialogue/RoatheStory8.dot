	"Chat ends." [color=orange];
	j1585746301 [label="SN: BANNER",shape=box,color=blue];
		j1585746301 -> j3119781284;
	j3119781284 [label="Transkript: Nichts verdeutlicht die Prunksucht, mit der wir Kreaturen das Kriegsgemetzel betrachten, so treffend wie die Bannerträger.",shape=box,color=blue];
		j3119781284 -> j3985729581;
	j3985729581 [label="Jene, die um jeden Preis beschützt und denen bedingungslos gefolgt werden muss.",shape=box,color=blue];
		j3985729581 -> j3157308370;
	j3157308370 [label="Und die, nebenbei bemerkt, gezwungen werden können, Befehle auszuführen, die kein vernünftiger Soldat je befolgen würde, aus Angst, ein noch schrecklicheres Schicksal zu erleiden.",shape=box,color=blue];
		j3157308370 -> j4154158809;
	j4154158809 [label="Lächerlich, wie das auch klingen mag.",shape=box,color=blue];
		j4154158809 -> j1638365123;
	j1638365123 [label="Ihre Gestalten zogen meinen Blick inmitten der anderen immer an, obwohl ihre zerfetzten Körper sich nicht unterschieden.",shape=box,color=blue];
		j1638365123 -> j3437720207;
	j3437720207 [label="Es war stets die Standarte, die sie noch trugen, glänzend im Gold der Orokin besudelt mit gesprenkeltem Purpurrot.",shape=box,color=blue];
		j3437720207 -> j3426020669;
	j3426020669 [label="Ich sorgte stets dafür, dass sie stolz auf dem Schlachtfeld stand, bevor ich es verließ.",shape=box,color=blue];
		j3426020669 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}