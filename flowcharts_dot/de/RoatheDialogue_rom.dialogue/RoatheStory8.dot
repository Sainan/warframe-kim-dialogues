	2198 [label="Transkript: Nichts verdeutlicht die Prunksucht, mit der wir Kreaturen das Kriegsgemetzel betrachten, so treffend wie die Bannerträger.",shape=box,color=blue];
		2198 -> 5694;
	5694 [label="Jene, die um jeden Preis beschützt und denen bedingungslos gefolgt werden muss.",shape=box,color=blue];
		5694 -> 5695;
	5695 [label="Und die, nebenbei bemerkt, gezwungen werden können, Befehle auszuführen, die kein vernünftiger Soldat je befolgen würde, aus Angst, ein noch schrecklicheres Schicksal zu erleiden.",shape=box,color=blue];
		5695 -> 2203;
	2203 [label="Lächerlich, wie das auch klingen mag.",shape=box,color=blue];
		2203 -> 5731;
	5731 [label="Ihre Gestalten zogen meinen Blick inmitten der anderen immer an, obwohl ihre zerfetzten Körper sich nicht unterschieden.",shape=box,color=blue];
		5731 -> 2195;
	2195 [label="Es war stets die Standarte, die sie noch trugen, glänzend im Gold der Orokin besudelt mit gesprenkeltem Purpurrot.",shape=box,color=blue];
		2195 -> 2204;
	2204 [label="Ich sorgte stets dafür, dass sie stolz auf dem Schlachtfeld stand, bevor ich es verließ.",shape=box,color=blue];
