		j3337095015 -> j1984239598;
	j2672478658 [label="Es tut mir leid. Du hast recht. Ich liebe dich nicht.",shape=box,color=red];
		j2672478658 -> j2193678157;
	j808216081 [label="Ich liebe alles, was du bist. Ich liebe, was du werden kannst. Ich liebe, wer du sein willst. Was du gewesen bist. Alles, wozu du fähig bist. Ich liebe dich, Roathe.",shape=box,color=red];
		j808216081 -> j1744252635;
	j1770799535 [label="Ich liebe dich nicht trotz dessen, wer du bist, Roathe. Ich liebe dich, wegen dem, wer du bist. Mit allem, was du bist. Mit allem Guten und Bösen, zu dem du fähig bist.",shape=box,color=red];
		j1770799535 -> j2058286114;
	j1301522248 [label="Schon gut. Ich hab's vergessen.",shape=box,color=red];
		j1301522248 -> j1481776582;
