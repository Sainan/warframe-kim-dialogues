		j1576365027 -> j3073832499;
	j3216255088 [label="Freunde. Ja. Ich nehme an, das sind wir jetzt, nicht wahr? Was für ein seltsamer Gedanke. Ich gebe zu, ich bin es nicht gewohnt, welche zu haben.",shape=box,color=blue];
		j3216255088 -> j2214696447;
	j1551095138 [label="Du hast wahrscheinlich recht, dich nicht mit Höflichkeiten aufzuhalten. Weiter geht's. Wir haben viel zu tun.",shape=box,color=blue];
		j1551095138 -> j3073832499;
	j1984239598 [label="Du bist ein gefährliches Wesen, wenn du den Teufel deinen Freund nennst. Aber ich würde dich gerne zu meinen Freunden zählen.",shape=box,color=blue];
		j1984239598 -> j2214696447;
	j2193678157 [label="Ich will nicht so tun, als ob mich das nicht besonders tief verletzt. Ein Sturz aus größerer Höhe schmerzt eben doch mehr.",shape=box,color=blue];
		j2193678157 -> j2936009789;
	j1744252635 [label="Ich weiß nicht, was ich sagen soll. Mir fehlen ausnahmsweise die Worte.",shape=box,color=blue];
		j1744252635 -> j3138456077;
	j2058286114 [label="Ich bin fass ... verblüfft. Und mir fehlen die Worte.",shape=box,color=blue];
		j2058286114 -> j3138456077;
	j1481776582 [label="Du bist manchmal schlimmer als Vogel Drei, ich schwöre.",shape=box,color=blue];
		j1481776582 -> "Chat ends.";
	j2478697497 [label="Ich liebe alles, was du bist. Ich liebe, was du werden kannst. Ich liebe, wer du sein willst. Was du gewesen bist. Alles, wozu du fähig bist. Ich liebe dich, Roathe.",shape=box,color=red];
		j2478697497 -> j1363781265;
	j1393989679 [label="Aber was mache ich aus dem, was ich bin? Und zu welcher Veränderung bin ich fähig? Das ist ein neuer Weg, den ich beschreiten muss. Und dafür bin ich dir dankbar.",shape=box,color=blue];
		j1393989679 -> "Chat ends.";
	j1983920130 [label="Du bist schlimmer als Vogel Drei, ich schwöre.",shape=box,color=blue];
		j1983920130 -> "Chat ends.";
	j443222753 [label="Das ist doch nicht dein Ernst! Schatz, bist du etwa betrunken? Du hast mich überzeugt, meine Vergangenheit zu akzeptieren und all das zu ignorieren, was andere über mich sagen, und jetzt sagst du mir, du liebst mich?",shape=box,color=blue];
		j443222753 -> j4011984577;
	j4192264748 [label="Stell dir nur vor, was wir zusammen alles erreichen könnten, du und ich ...",shape=box,color=blue];
		j4192264748 -> j1610406490;
	j121619938 [label="Was kommt als Nächstes?",shape=box,color=red];
		j121619938 -> j1029675099;
	j3059823024 [label="Glaubst du, du wirst dich immer so nennen?",shape=box,color=red];
		j3059823024 -> j3300432449;
