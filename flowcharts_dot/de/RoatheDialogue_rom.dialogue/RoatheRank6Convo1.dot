	j2726519434 [label="Ich wäre allerdings nachlässig, wenn ich nicht einen Moment innehalten und sagen würde, dass ich, bevor wir in der ganzen Butler-Angelegenheit zu weit gingen, nicht zugegeben habe, dass ich ein Geständnis abzulegen hatte.",shape=box,color=blue];
