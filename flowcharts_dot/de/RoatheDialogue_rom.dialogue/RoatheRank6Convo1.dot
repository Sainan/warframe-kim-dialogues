		j837347042 -> j3337095015;
	j3964741066 [label="Vor allem, bevor ich mich lächerlich mache. Nicht, dass du in letzter Zeit nicht schon meine schlimmsten Seiten erlebt hättest.",shape=box,color=blue];
		j3964741066 -> j2672478658;
		j3964741066 -> j808216081;
	j1162889896 [label="Insbesondere angesichts der Tatsache, dass du mich davon überzeugt hast, meine Vergangenheit zu akzeptieren und all das zu ignorieren, was andere über mich sagen.",shape=box,color=blue];
		j1162889896 -> j2672478658;
		j1162889896 -> j1770799535;
	j4067203213 [label="Plötzlich bin ich es, die von einem überwältigenden Gefühl der Furcht erfasst wird. Du hast wirklich ein Talent dafür, das Blatt unerwartet zu wenden, mein Schatz. Was gibt's?",shape=box,color=blue];
		j4067203213 -> j1301522248;
		j4067203213 -> j92911715;
	j3399692577 [label="Mit mir. Ja. Gefährten. An einen solchen Gedanken bin ich nicht gewöhnt.",shape=box,color=blue];
		j3399692577 -> j2969673519;
	j4079917824 [label="Plötzlich bin ich es, die von einem überwältigenden Gefühl der Furcht erfasst wird. Vorsicht, mein Schatz. Du spielst ein gefährliches Spiel. Was gibt's?",shape=box,color=blue];
		j4079917824 -> j1182445899;
		j4079917824 -> j411222268;
	j3961753479 [label="Und es macht mir Spaß, sie auszusprechen! Deshalb verstehen wir uns so gut. Und genau das wollte ich kurz und bündig sagen.",shape=box,color=blue];
		j3961753479 -> j4227332171;
	j1302367154 [label="Freunde. Ja. Ich nehme an, das sind wir jetzt, nicht wahr? Was für ein seltsamer Gedanke.",shape=box,color=blue];
		j1302367154 -> j3422394725;
	j3434073150 [label="Natürlich, für deine Hilfe, meine Erinnerungen wiederzuerlangen und sie zu verarbeiten. Was denn sonst? Es ist ja nicht so, als hättest du eifrig meine Wäsche zusammengelegt.",shape=box,color=blue];
		j3434073150 -> j553793022;
	j1217543471 [label="Muss ich es denn buchstabieren? Na gut. Aber erwarte keine überschwänglichen Lobeshymnen von mir. Du wirst von anderen schon ausreichend gelobt. Du benötigst nicht noch mehr davon von mir.",shape=box,color=blue];
		j1217543471 -> j1991841769;
