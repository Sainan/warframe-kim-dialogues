		j2570917897 -> j3788487326;
	j1222694449 [label="Ich liebe dich nicht trotz dessen, wer du bist, Roathe. Ich liebe dich, wegen dem, wer du bist. Mit allem, was du bist. Mit allem Guten und Bösen, zu dem du fähig bist.",shape=box,color=red];
		j1222694449 -> j3236508750;
	j14599428 [label="Und mit \"wir\" meine ich \"mich\".",shape=box,color=blue];
		j14599428 -> j3277549150;
		j14599428 -> j2233863866;
	j72593426 [label="Du glaubst mir vielleicht nicht, aber ich ... ich liebe dich.",shape=box,color=red];
		j72593426 -> j4047452585;
	j2110526958 [label="Du glaubst mir vielleicht nicht, aber ich ... ich liebe dich.",shape=box,color=red];
		j2110526958 -> j4256071351;
	j3073832499 [label="Und mit \"wir\" meine ich \"mich\".",shape=box,color=blue];
		j3073832499 -> j601714818;
		j3073832499 -> j2233863866;
	j2214696447 [label="Aber leider bleibt keine Zeit für Höflichkeiten. Wir haben viel zu tun. Und mit \"wir\" meine ich \"mich\".",shape=box,color=blue];
		j2214696447 -> j601714818;
		j2214696447 -> j2233863866;
	j2936009789 [label="Ich fürchte, ich kann diese einseitige Farce nicht fortsetzen. Ich hoffe, du verstehst das.",shape=box,color=blue];
		j2936009789 -> j3286997924;
	j3138456077 [label="Außer folgende:",shape=box,color=blue];
		j3138456077 -> j2837157840;
	j1363781265 [label="Ich ...",shape=box,color=blue];
		j1363781265 -> j542010523;
	j4011984577 [label="Geht es dir gut? Du musst krank sein.",shape=box,color=blue];
		j4011984577 -> j2143938338;
	j1610406490 [label="Das Ursprungssystem würde uns zu Füßen liegen.",shape=box,color=blue];
		j1610406490 -> "Chat ends.";
	j1029675099 [label="Ich weiß es nicht, außer hier zu bleiben. Und das begeistert mich mehr, als ich in Worte fassen kann. Mein nächstes Kapitel ist noch ungeschrieben.",shape=box,color=blue];
		j1029675099 -> j1393989679;
	j3300432449 [label="Ja, ich denke schon. Ich habe ein neues Ziel und eine neue Lebensaufgabe, aber ich bin immer noch ich selbst. Ich bin immer noch Roathe. Und meine Handlungen sind die meinen.",shape=box,color=blue];
		j3300432449 -> j1393989679;
	j1642901737 [label="Dies.",shape=box,color=blue];
		j1642901737 -> "Chat ends.";
	j1352963422 [label="Suche nicht unnötig nach Gefälligkeiten, Drifter. Das ziemt sich nicht.",shape=box,color=blue];
		j1352963422 -> "Chat ends.";
	j1430678252 [label="Du bist ein gefährliches Wesen, wenn du den Teufel deinen Freund nennst. Aber ich würde dich gerne zu meinen Freunden zählen.",shape=box,color=blue];
		j1430678252 -> j195504548;
		j1430678252 -> j2585171148;
	j2197101956 [label="Ich will nicht so tun, als ob mich das nicht besonders tief verletzt. Ein Sturz aus größerer Höhe schmerzt eben doch mehr.",shape=box,color=blue];
		j2197101956 -> j425913840;
	j3788487326 [label="Ich weiß nicht, was ich sagen soll. Mir fehlen ausnahmsweise die Worte.",shape=box,color=blue];
		j3788487326 -> j602508339;
	j3236508750 [label="Ich bin fass ... verblüfft. Und mir fehlen die Worte.",shape=box,color=blue];
		j3236508750 -> j602508339;
	j3277549150 [label="Bitte sei nachsichtig mit ihm.",shape=box,color=red];
		j3277549150 -> j263085459;
	j2233863866 [label="Wie weiß ich, dass du ihn überzeugt hast?",shape=box,color=red];
		j2233863866 -> j3400098926;
	j4047452585 [label="Ich liebe alles, was du bist. Ich liebe, was du werden kannst. Ich liebe, wer du sein willst. Was du gewesen bist. Alles, wozu du fähig bist. Ich liebe dich, Roathe.",shape=box,color=red];
		j4047452585 -> j4123981182;
	j4256071351 [label="Das ist doch nicht dein Ernst! Schatz, bist du etwa betrunken? Du hast mich überzeugt, meine Vergangenheit zu akzeptieren und all das zu ignorieren, was andere über mich sagen, und jetzt sagst du mir, du liebst mich?",shape=box,color=blue];
		j4256071351 -> j860818638;
