	j1106468336 [label="Ich wäre allerdings nachlässig, wenn ich dir nicht auch dafür danken würde, dass du meine Erinnerungen wiedergefunden und mir geholfen hast, sie zu verarbeiten, Schatz.",shape=box,color=blue];
