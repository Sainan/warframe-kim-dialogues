		j1106468336 -> j2456137481;
	j2226437223 [label="Solltest du jedoch auch Dank für deine Hilfe bei der Wiedererlangung und dem Verarbeiten meiner Erinnerungen erwarten, dann möchte ich dir für deine Unterstützung meinen tiefsten Dank aussprechen, Schatz.",shape=box,color=blue];
