digraph {
	"RoatheRank3Convo5 begins." [color=orange];
		"RoatheRank3Convo5 begins." -> j311521122;
	j311521122 [label="Albrecht war von Anfang an ein Problem. Er und seine ganze Sache mit dem Void. Ich glaube, man hat ihm Gerivaine zugeteilt, in der Hoffnung, dass ihn eine Familie ruhig stellen würde.",shape=box,color=blue];
		j311521122 -> j292132406;
	j292132406 [label="Stattdessen, glaube ich, hat es alles nur noch schlimmer gemacht. Sobald er Kinder hatte, sah er sie als zusätzliche Hilfskräfte. Komplizen in seinen wahnsinnigen Experimenten.",shape=box,color=blue];
		j292132406 -> j4266254137;
	j4266254137 [label="Entbehrlich. Wie alles in seinem Leben.",shape=box,color=blue];
		j4266254137 -> j1154161553;
		j4266254137 -> j832747375;
		j4266254137 -> j129698615;
	j1154161553 [label="Gerivaine?",shape=box,color=red];
		j1154161553 -> j3289804056;
	j832747375 [label="Er betrachtet Menschen als mehr als nur entbehrlich.",shape=box,color=red];
		j832747375 -> j1961849306;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j3289804056 [label="Ein Name, der vielleicht in den Annalen der Zeit verloren gegangen ist ... Albrecht Entratis Frau, Usurpator. Die Mutter seiner Kinder.",shape=box,color=blue];
		j3289804056 -> j4103666644;
	j1961849306 [label="Gut, ich gebe zu, dass er alles und jeden in seinem Leben mit der Kaltblütigkeit eines Exekutors ermordet. Aber er tut es nicht ohne Grund.",shape=box,color=blue];
		j1961849306 -> j872454100;
	"Chat ends." [color=orange];
	j4103666644 [label="Check boolean LoidFamilyComplete",color=orange];
		j4103666644 -> j1404432979 [label=true,color=green];
		j4103666644 -> j980320606 [label=false,color=brown];
	j872454100 [label="Weißt du, wenn ich jetzt darüber nachdenke, war es seine gefühllose Art, die ihn in unserer Zeit so gefährlich machte. Er war bereit, alles zu opfern, um seine Ziele zu erreichen. Wirklich alles.",shape=box,color=blue];
		j872454100 -> j4039012722;
		j872454100 -> j3770765503;
	j1404432979 [label="Aber da hast du es wieder, wahrscheinlich hältst du mich mal wieder für dumm – denn die Chancen stehen ziemlich gut, dass du diese Information bereits kanntest, jetzt, wo der Butler wieder mit ihnen in Kontakt steht.",shape=box,color=blue];
		j1404432979 -> j268252409;
	j980320606 [label="Jene, die so selig und ahnungslos sind von unserer Existenz unten in diesem verfallenden Sanctum. Was ich nach wie vor für unbezahlbar halte.",shape=box,color=blue];
		j980320606 -> j872454100;
	j4039012722 [label="Ich dachte, die Orokin hätten kein Problem damit, Dinge zu opfern, die ihnen wichtig sind. Ihr schient alle extrem rücksichtslos zueinander zu sein.",shape=box,color=red];
		j4039012722 -> j4133327964;
	j3770765503 [label="Wie kommst du darauf?",shape=box,color=red];
		j3770765503 -> j3999401549;
	j268252409 [label="Aber ich werde jetzt nicht schon wieder mit dir darüber streiten. Mir ist nicht danach.",shape=box,color=blue];
		j268252409 -> j872454100;
	j4133327964 [label="Du bist sehr darauf bedacht, vieles anzunehmen, wovon du nichts weißt, Drifter.",shape=box,color=blue];
		j4133327964 -> j1676893260;
	j3999401549 [label="+10 Chemistry",color=orange];
		j3999401549 -> j1146693321;
	j1676893260 [label="Oder hatte deine Haut einen bläulichen Ton, den ich übersehen habe? Warst du ein Orokin? Falls ja, bitte ich dich zutiefst und aufrichtig um Entschuldigung!",shape=box,color=blue];
		j1676893260 -> j2835232508;
		j1676893260 -> j3433371129;
	j1146693321 [label="Es mag ein weit verbreiteter Irrglaube sein, dass wir Orokin nichts anderes taten, als uns gegenseitig zu hintergehen und umzubringen. Davon gab es reichlich, versteh mich nicht falsch. Wir waren nahezu unsterblich, wir hatten kaum etwas anderes zu tun.",shape=box,color=blue];
		j1146693321 -> j3921215095;
	j2835232508 [label="Es tut mir leid. Ich wollte dich nicht beleidigen. Ehrlich gesagt erinnere ich mich selbst nicht mehr viel an die Gesellschaft der Orokin- – ich stand ja außerhalb, habe nur zugeschaut.",shape=box,color=red];
		j2835232508 -> j3438375347;
	j3433371129 [label="Tut mir leid, falls meine Erinnerung an die Gesellschaft der Oroin getrübt ist. Es waren hauptsächlich aufgezeichnete Befehle, die über Lautsprecher ausgerufen wurden. Das war, bevor ich im Void gefangen war ...",shape=box,color=red];
		j3433371129 -> j3859835542;
	j3921215095 [label="Aber wir waren auch ein zutiefst leidenschaftliches Volk. Niemand schuf Kunst so wie die Orokin. Niemand komponierte Musik, Theaterstücke oder Gedichte, wie wir sie schufen.",shape=box,color=blue];
		j3921215095 -> j2861392278;
	j3438375347 [label="Entschuldigung angenommen. Diesmal. Ich habe hier schon genug mit dieser Art von Respektlosigkeit zu tun. So faszinierend du auch sein magst, ich bin nicht jedermanns Nadelkissen. Ich habe Besseres mit meiner Zeit anzufangen.",shape=box,color=blue];
		j3438375347 -> j1751983291;
	j3859835542 [label="Boolean RoatheInsulted is now true.",color=orange];
		j3859835542 -> j3910109229;
	j2861392278 [label="Und niemand liebte so tief wie wir, wenn unsere Herzen für einen anderen schlugen.",shape=box,color=blue];
		j2861392278 -> j2834999051;
	j1751983291 [label="Wo war ich stehen geblieben? Ach ja. Unser ungerührter Entrati.",shape=box,color=blue];
		j1751983291 -> j1146693321;
	j3910109229 [label="Eine Warnung vorab. Ich habe hier schon genug mit dieser Art von Respektlosigkeit zu tun. So faszinierend du auch sein magst, ich bin nicht jedermanns Nadelkissen. Ich habe Besseres mit meiner Zeit anzufangen.",shape=box,color=blue];
		j3910109229 -> j1751983291;
	j2834999051 [label="Alle außer Albrecht. Alles, was er tat, jeder, mit dem er interagierte, war, als ob er es durch einen Teil seines geliebten Seriglases betrachtete.",shape=box,color=blue];
		j2834999051 -> j2703239127;
	j2703239127 [label="Entfremdet. Distanziert. Desinteressiert. Unbeeinflusst. Selbst als Gerivaine starb und er seine kleine Tochter allein großziehen musste.",shape=box,color=blue];
		j2703239127 -> j1969269467;
	j1969269467 [label="Check boolean LoidFamilyComplete",color=orange];
		j1969269467 -> j1947411483 [label=true,color=green];
		j1969269467 -> j1151823056 [label=false,color=brown];
	j1947411483 [label="Die mit Sicherheit dazu bestimmt war, mehr zu erreichen, als er je erreicht hat. Wenn sie nicht am Ende befallen und an Ort und Stelle gefesselt worden wäre. Welch eine Verschwendung.",shape=box,color=blue];
		j1947411483 -> j2869480154;
		j1947411483 -> j3832130034;
	j1151823056 [label="Die mit Sicherheit dazu bestimmt war, mehr zu erreichen, als er je erreicht hat. Ich bin gespannt, was aus ihr und dem Rest der Entrati geworden ist. In all ihrer ... befallenen Pracht.",shape=box,color=blue];
		j1151823056 -> j1085334546;
		j1151823056 -> j3477282261;
	j2869480154 [label="Ich bin froh, dass wir Loid dazu bringen konnten, nach oben zu gehen.",shape=box,color=red];
		j2869480154 -> j4149327127;
	j3832130034 [label="Ich weiß, du kannst dich nicht erinnern, warum wir das getan haben, aber es war gut, dass wir es geschafft haben, Loid nach oben zu bringen.",shape=box,color=red];
		j3832130034 -> j2675744689;
	j1085334546 [label="Ich frage mich immer noch, ob das die beste Idee ist ...",shape=box,color=red];
		j1085334546 -> j485616390;
	j3477282261 [label="Wenn wir es schaffen, Loid dazu zu bringen, nach oben zu gehen, was hast du dann vor?",shape=box,color=red];
		j3477282261 -> j1144493926;
	j4149327127 [label="Das sagst du. Und ich stehe da, wie ein Idiot, behüte sie und höre ihnen zu, wie sie über das Wiedersehen reden, als ob ich mich daran erinnern könnte. Weißt du, wie unangenehm das ist?!",shape=box,color=blue];
		j4149327127 -> j60312157;
	j2675744689 [label="Weißt du, wie seltsam es ist, da zu stehen und so zu tun, als ob ich mich an das Widersehen erinnern könnte?! Wenn ich mich beim besten Willen nicht daran erinnern kann?!",shape=box,color=blue];
		j2675744689 -> j60312157;
	j485616390 [label="Hm, höchstwahrscheinlich nicht. Ich bin neugierig: Hast dz zufällig Albrechts Nachsendeadresse?",shape=box,color=blue];
		j485616390 -> j4265689721;
	j1144493926 [label="Ich habe mich noch nicht entschieden. Vielleicht fange ich an, ihnen die Gliedmaßen abzuschneiden und sie in Flüssigkeit einzulegen. Hast du zufällig Albrechts Nachsendeadresse?",shape=box,color=blue];
		j1144493926 -> j4230843446;
	j60312157 [label="Es ist, als wäre man auf einer Gala, und jemand kommt auf dich zu und kennt dich ganz genau, aber du kannst dich absolut nicht erinnern, wer das ist, bist aber gezwungen, das Gespräch so fortzusetzen, als ob man sich kennen würde!",shape=box,color=blue];
		j60312157 -> j2183744290;
	j4265689721 [label="Nein, warum?",shape=box,color=red];
		j4265689721 -> j1152336209;
	j4230843446 [label="Wie bitte?!",shape=box,color=red];
		j4230843446 -> j3514305768;
	j2183744290 [label="Hast du auch nur die geringste Ahnung, in welch eine Hölle du mich gebracht hast?! Überhaupt eine Idee?! Es ist elend, da oben so zu stehen, und das ist alles deine Schuld!",shape=box,color=blue];
		j2183744290 -> j2335973601;
	j1152336209 [label="Ich hatte mir überlegt, sobald ich oben bin, könnte ich anfangen, seiner Familie die Gliedmaßen abzuhacken und sie ihm einzeln in Gläsern zuzuschicken.",shape=box,color=blue];
		j1152336209 -> j4230843446;
	j3514305768 [label="+10 Chemistry",color=orange];
		j3514305768 -> j3659715131;
	j2335973601 [label="Ach, genug davon. Ich brauche einen Drink.",shape=box,color=blue];
		j2335973601 -> j1933300832;
	j3659715131 [label="Beruhige dich! Versteht hier denn niemand einen Witz?",shape=box,color=blue];
		j3659715131 -> j2783357536;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j2783357536 [label="Wer würde sie denn für mich verschicken?",shape=box,color=blue];
		j2783357536 -> "Chat ends.";
}