		2276 -> 2275;
	2274 [label="Chat ends.",color=orange];
	2275 [label="Transkript: Traivon. Ich sah, wie du deinen Railjack in Praghasas Rachen schleudertest. Abgelenkt nährte sie sich an dir und deinen Männern, ohne zu bemerken, wie mein Schiff davonraste.",shape=box,color=blue];
		2275 -> 5713;
	5713 [label="Du gabst dein Leben für deinen Vorgesetzten. Deine Selbstlosigkeit traf mich wie ein Schlag ins Gesicht.",shape=box,color=blue];
		5713 -> 5714;
	5714 [label="Maryna. Du gabst mir deinen Körper. Gemeinsam tranken wir in diesem Graben Kuva. Meine Hände zitterten, und aus meiner aufgeschlitzten Kehle sickerte Flüssigkeit, aber ich konnte genug Tropfen hinunterspülen.",shape=box,color=blue];
		5714 -> 2278;
	2278 [label="Ich erinnere mich an deinen letzten Salut. Das Verblassen. Dann öffnete ich die Augen, die einst deine gewesen waren, und sah meinen ausgeweideten Körper tot im Schlamm.",shape=box,color=blue];
		2278 -> 2272;
	2272 [label="Rostig. Etwas sei beim Klonen schiefgelaufen, sagten sie. Was sonst könnte einen Grineer dazu bringen, bei lebendigem Leibe in seinem Geschützturm zu verharren? Selbst eine Ratte versteht Selbsterhaltung!",shape=box,color=blue];
		2272 -> 2279;
	2279 [label="Nein. Dein 'Defekt' stellte dich über sie.",shape=box,color=blue];
		2279 -> 2271;
	2271 [label="Add 1 to HellStory",color=orange];
		2271 -> 2343;
	2343 [label="{\"Id\":2343,\"Incoming\":[2271],\"Outgoing\":[2270],\"GraphPos\":[4809,-5333],\"CompletionType\":1}",color=orange];
		2343 -> 2270;
	2270 [label="Chat ends.",color=orange];
}