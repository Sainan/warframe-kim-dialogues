	"Chat ends." [color=orange];
	j2762111912 [label="SN: OPFER",shape=box,color=blue];
		j2762111912 -> j3407520145;
	j3407520145 [label="Transkript: Traivon. Ich sah, wie du deinen Railjack in Praghasas Rachen schleudertest. Abgelenkt nährte sie sich an dir und deinen Männern, ohne zu bemerken, wie mein Schiff davonraste.",shape=box,color=blue];
		j3407520145 -> j3013919815;
	j3013919815 [label="Du gabst dein Leben für deinen Vorgesetzten. Deine Selbstlosigkeit traf mich wie ein Schlag ins Gesicht.",shape=box,color=blue];
		j3013919815 -> j3581734626;
	j3581734626 [label="Maryna. Du gabst mir deinen Körper. Gemeinsam tranken wir in diesem Graben Kuva. Meine Hände zitterten, und aus meiner aufgeschlitzten Kehle sickerte Flüssigkeit, aber ich konnte genug Tropfen hinunterspülen.",shape=box,color=blue];
		j3581734626 -> j2425958968;
	j2425958968 [label="Ich erinnere mich an deinen letzten Salut. Das Verblassen. Dann öffnete ich die Augen, die einst deine gewesen waren, und sah meinen ausgeweideten Körper tot im Schlamm.",shape=box,color=blue];
		j2425958968 -> j3245017892;
	j3245017892 [label="Rostig. Etwas sei beim Klonen schiefgelaufen, sagten sie. Was sonst könnte einen Grineer dazu bringen, bei lebendigem Leibe in seinem Geschützturm zu verharren? Selbst eine Ratte versteht Selbsterhaltung!",shape=box,color=blue];
		j3245017892 -> j2004448865;
	j2004448865 [label="Nein. Dein 'Defekt' stellte dich über sie.",shape=box,color=blue];
		j2004448865 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}