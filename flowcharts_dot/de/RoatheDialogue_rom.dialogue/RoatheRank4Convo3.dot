digraph {
	2475 [label="RoatheRank4Convo3 begins.",color=orange];
		2475 -> 2476;
	2476 [label="Verstehe mich nicht falsch, Usurpator: Glaubst du, du könntest deinen Tenno-Gegenpart im Kampf bis zum Tod besiegen, wenn es hart auf hart käme?",shape=box,color=blue];
		2476 -> 2478;
		2476 -> 2477;
		2476 -> 2479;
	2478 [label="Was? Warum ...?",shape=box,color=red];
		2478 -> 2481;
	2477 [label="Darüber werde ich mich nicht unterhalten.",shape=box,color=red];
		2477 -> 2480;
	2479 [label="[Ende.]",shape=box,color=red];
		2479 -> 2482;
	2481 [label="Denn ich bin mir nicht sicher, ob es dir aufgefallen ist, aber \"die Lotus\" ist nicht nur ein Sentient – und dafür verantwortlich, dass Lua in den Void verbannt wurde, möchte ich hinzufügen –, sondern sie hat auch messbar die Kontrolle über ihre Schaltkreise verloren.",shape=box,color=blue];
		2481 -> 2483;
		2481 -> 2484;
		2481 -> 2485;
		2481 -> 2486;
		2481 -> 2487;
	2480 [label="Ich will nicht unhöflich sein. Ich meine es ganz ernst, das ist dir klar. Dies ist ein rein pragmatisches Gespräch.",shape=box,color=blue];
		2480 -> 2481;
	2482 [label="Chat ends.",color=orange];
	2483 [label="Es geht ihr gut. Du weißt nicht, wovon du redest.",shape=box,color=red];
		2483 -> 2488;
	2484 [label="Sie hat die Kontrolle über ihre Schaltkreise verloren? Was meinst du damit?",shape=box,color=red];
		2484 -> 2489;
	2485 [label="Nein. Das mache ich nicht. Lotus hat mir das Leben gerettet. Sie hat den Tenno unzählige Male das Leben gerettet. Wir verdanken ihr alles.",shape=box,color=red];
		2485 -> 2490;
	2486 [label="Halt die Klappe, Roathe, ich mach das nicht. [Ende.]",shape=box,color=red];
		2486 -> 2491;
	2487 [label="Ich weiß, ich mache mir auch Sorgen. Aber sie hat so viel für uns getan, und ich kann sie nicht im Stich lassen. Ich muss sie unterstützen.",shape=box,color=red];
		2487 -> 2492;
	2488 [label="Ach nein? Mach die Augen auf! Schau dich um! Wie viele Monate stand sie am Rand einer Klippe, einen altertümlichen Pager in der Hand, vor sich hin summend? In den Void starrend?",shape=box,color=blue];
		2488 -> 2493;
	2489 [label="Wie viele Monate stand sie am Rand einer Klippe, mit einem altertümlichen Pager in der Hand und summte vor sich hin? Starrte in den Void?",shape=box,color=blue];
		2489 -> 2493;
	2490 [label="Dafür habe ich Verständnis. Ich verstehe, wie es dir geht. Du schuldest ihr viel. Ich sage dir nicht, du sollst sie töten, ich sage dir nur, lass nicht weiter zu, dass sie Einfluss auf dein Umfeld nimmt.",shape=box,color=blue];
		2490 -> 2489;
	2491 [label="Wie du wünschst. Aber wenn das alles um dich herum zusammenbricht? Dann komm nicht angekrochen und bitte mich um Hilfe.",shape=box,color=blue];
		2491 -> 2494;
	2492 [label="+5 Chemistry",color=orange];
		2492 -> 2495;
	2493 [label="Und nun ist sie nur noch ... präsent? In der Dunkelheit? Schickt dein Kind-selbst immer tiefer in dessen Erinnerungen, wofür? Um nach Hause zu gelangen, nur weil Albrecht mit den Fingern schnippte und das magische Wort flüsterte?",shape=box,color=blue];
		2493 -> 2496;
	2494 [label="Chat ends.",color=orange];
	2495 [label="Dafür habe ich Verständnis. Ich verstehe, wie es dir geht. Du schuldest ihr viel. Ich sage dir nicht, du sollst sie töten, ich sage dir nur, lass nicht weiter zu, dass sie Einfluss auf dein Umfeld nimmt.",shape=box,color=blue];
		2495 -> 2497;
	2496 [label="Findest du das nicht verdächtig? Findest du das nicht gefährlich? Es ist eine Falle. Sie wird manipuliert. Entweder von Albrecht oder von dieser sogenannten \"Gleichgültigkeit\". Sie ist ein defektes Programm. Ihre Verhaltensregeln funktionieren nicht mehr.",shape=box,color=blue];
		2496 -> 2498;
	2497 [label="Als sie da am Rand der Klippe stand, einen altertümlichen Pager in der Hand, vor sich hin summend, und in den Void starrte – dachtest du nicht, sie würde springen?",shape=box,color=blue];
		2497 -> 2493;
	2498 [label="Ich glaube nicht, dass sie dir schaden will. Ich denke, sie wird nur benutzt. Aber wenn es so weit ist, musst du dich vielleicht verteidigen. Oder du wirst sie vielleicht töten müssen.",shape=box,color=blue];
		2498 -> 2499;
	2499 [label="Und obwohl du (hoffentlich) wahrscheinlich einsehen wirst, dass es sinnvoll ist, eine zweite Runde zu vermeiden, in der die Lotus zum Problem wird, wird ihre wilde Kinderarmee das nicht tun. Deshalb frage ich noch einmal:",shape=box,color=blue];
		2499 -> 2500;
	2500 [label="Wer würde deiner Meinung nach gewinnen, wenn der schreckliche Tag käme und du mit all deinen Ressourcen kämpfen müsstest? Du und alles, was du hast, gegen alle Tenno und die Lotus?",shape=box,color=blue];
		2500 -> 2501;
		2500 -> 2502;
		2500 -> 2503;
	2501 [label="Das ist idiotisch. Nein.",shape=box,color=red];
		2501 -> 2504;
	2502 [label="Es gibt ... ich weiß nicht, hundert von denen. Und mich nur einmal, Roathe.",shape=box,color=red];
		2502 -> 2505;
	2503 [label="Ich weiß nicht mal, wo ich anfangen soll.",shape=box,color=red];
		2503 -> 2506;
	2504 [label="Dann betrachte es doch einfach als ein albernes Spiel, wenn es sein muss! Ein theoretisches Spiel, von Kindern gespielt.",shape=box,color=blue];
		2504 -> 2507;
		2504 -> 2508;
	2505 [label="+5 Chemistry",color=orange];
		2505 -> 2509;
	2506 [label="Dann ist es ein Glück, dass du mit \"dem Teufel von Tau\" sprichst. Ich bin nicht umsonst als Stratege bekannt. Fangen wir ganz oben an: Zahlen. In diesem Bereich bist du hoffnungslos unterlegen.",shape=box,color=blue];
		2506 -> 2510;
	2507 [label="Das ist kein Spiel.",shape=box,color=red];
		2507 -> 2511;
	2508 [label="Zum letzten Mal? Nein. [Ende.]",shape=box,color=red];
		2508 -> 2512;
	2509 [label="Perfekt. Wir haben die allererste Regel für die Gestaltung des Schlachtfelds festgelegt: die Zahlen. Offensichtlich bist du der schieren Übermacht hoffnungslos unterlegen.",shape=box,color=blue];
		2509 -> 2510;
	2510 [label="Check boolean IsDating",color=orange];
		2510 -> 2513 [label=true,color=green];
		2510 -> 2514 [label=false,color=brown];
	2511 [label="Du hast Recht. Das ist es nicht. Und eines Tages könnte es um Leben und Tod gehen. Du gegen deine kleine ... Miniatur-Version. Und dessen Rudel wilder Gefährten.",shape=box,color=blue];
		2511 -> 2515;
	2512 [label="Chat ends.",color=orange];
	2513 [label="Wenn sich jedoch Gerüchte über deine \"persönlichen Aktivitäten\" und Liebschaften unter den Protoframes anderer Zeitlinien verbreiten ließen, könnten diese Ressourcen vielleicht irgendwie herbeigerufen werden. Mehrere Helminthe müssten speziell für diesen Zweck erforscht und gezüchtet werden ...",shape=box,color=blue];
		2513 -> 2516;
	2514 [label="Ich habe von deinen Interaktionen mit anderen Protoframes in anderen Zeitlinien gehört. Vielleicht könnten diese Ressourcen irgendwie herbeigerufen werden. Mehrere Helminthe müssten speziell für diesen Zweck erforscht und gezüchtet werden ...",shape=box,color=blue];
		2514 -> 2516;
	2515 [label="Wilde Begleiter, die sich im Übrigen bereits als gewalttätig und unbändig erwiesen haben und dafür bekannt sind, ihre Artgenossen grausam zu verstoßen, wenn diese zu weit von ihren eigenen Vorstellungen von Normalität abweichen.",shape=box,color=blue];
		2515 -> 2517;
		2515 -> 2518;
		2515 -> 2519;
	2516 [label="Ich weiß nicht einmal, ob das möglich ist, aber es hat uns die Durchreise hierher ermöglicht, also sehe ich keinen Grund, warum nicht ...",shape=box,color=blue];
		2516 -> 2520;
		2516 -> 2521;
		2516 -> 2522;
	2517 [label="Du behauptest jetzt, dass die Tenno böse sind?",shape=box,color=red];
		2517 -> 2523;
	2518 [label="Was willst du damit sagen?",shape=box,color=red];
		2518 -> 2524;
	2519 [label="Nein. Ich bin fertig. [Ende.]",shape=box,color=red];
		2519 -> 2525;
	2520 [label="Roathe? Fahr zur Hölle.",shape=box,color=red];
		2520 -> 2526;
	2521 [label="Ich werde sie nicht in diesen Schlamassel hineinziehen.",shape=box,color=red];
		2521 -> 2527;
	2522 [label="Ich bin beunruhigt darüber, wie viel Gedanken du dir darüber gemacht hast.",shape=box,color=red];
		2522 -> 2528;
	2523 [label="Nein, nicht böse. Ich glaube nicht an das \"Böse\", Usurpator. Das habe ich nie getan und werde ich nie tun. Ich glaube, dass die Tenno wunderbar und schön menschlich sind, wie alle anderen auch. Einfach Menschen. Und darüber hinaus? Sind sie Kinder.",shape=box,color=blue];
		2523 -> 2529;
	2524 [label="Dass eines Tages die Zeit kommen mag, ein schrecklicher Tag, an dem du bereit sein musst, das Undenkbare zu tun.",shape=box,color=blue];
		2524 -> 2530;
	2525 [label="Du kannst dem Gespräch aus dem Weg gehen, wenn du willst, aber du weißt, dass jedes Wort davon der Wahrheit entspricht. Du willst es nur nicht wahrhaben.",shape=box,color=blue];
		2525 -> 2531;
	2526 [label="+5 Chemistry",color=orange];
		2526 -> 2532;
	2527 [label="Ah! Du gibst also zu, dass es ein Schlamassel gibt. Das ist ein Fortschritt. Darf ich wenigstens meine Argumente darlegen?",shape=box,color=blue];
		2527 -> 2533;
		2527 -> 2534;
	2528 [label="Und ich bin beunruhigt darüber, wie wenig du offensichtlich darüber nachgedacht hast. Darf ich wenigstens meine Argumente darlegen?",shape=box,color=blue];
		2528 -> 2533;
		2528 -> 2534;
	2529 [label="Kinder, die mit Schrecken konfrontiert wurden und Gräueltaten begehen mussten, die die abgehärteten Krieger der Orokin zerbrachen, die bereits Hunderte von Jahren erlebt haben.",shape=box,color=blue];
		2529 -> 2535;
	2530 [label="Die Tenno sind wunderbar und schön menschlich, wie alle anderen auch. Einfach Menschen. Und darüber hinaus? Sind sie Kinder.",shape=box,color=blue];
		2530 -> 2529;
	2531 [label="Chat ends.",color=orange];
	2532 [label="Da bin ich bereits, Usurpator. Da bin ich bereits.",shape=box,color=blue];
		2532 -> 2536;
	2533 [label="Okay. Sicher. Nur zu. Ich höre.",shape=box,color=red];
		2533 -> 2537;
	2534 [label="Nein. Ich bin fertig.",shape=box,color=red];
		2534 -> 2538;
	2535 [label="Ich habe Dax gesehen – ihr goldene Elite! – wie sie ihre heiligen, vergoldeten Schwerter fallen ließen und vom Schlachtfeld flohen, das die Tenno mit ihren Warframes betraten.",shape=box,color=blue];
		2535 -> 2539;
	2536 [label="Update boolean RoatheNoDate",color=orange];
		2536 -> 2540;
	2537 [label="+5 Chemistry",color=orange];
		2537 -> 2541;
	2538 [label="Und siehe da, ich auch.",shape=box,color=blue];
		2538 -> 2540;
	2539 [label="Ihr vermeintlicher Kokon aus befallenem Schutz bewahrte zwar ihre Körper, aber nicht ihre Seelen. Sie sind nicht schuld an ihrem Zustand.",shape=box,color=blue];
		2539 -> 2542;
	2540 [label="Chat ends.",color=orange];
	2541 [label="Danke. Dass eines Tages die Zeit kommen mag, ein schrecklicher Tag, an dem du bereit sein musst, das Undenkbare zu tun.",shape=box,color=blue];
		2541 -> 2530;
	2542 [label="Vom Void gequält ... gezwungen, die eigenen Eltern zu ermorden oder deren Tod mitzuerleben ... dem Krieg ausgesetzt ... ihrer Erinnerungen beraubt ... jahrhundertelang im Kryoschlaf gefangen ...",shape=box,color=blue];
		2542 -> 2543;
	2543 [label="Dass sie keine rasenden Wahnsinnigen sind, grenzt an ein Wunder, Usurpator. Ich sage nicht, dass es schiefgehen wird. Ich sage nur, dass es könnte. Und dass du einen Plan haben musst, falls dieser Tag kommt.",shape=box,color=blue];
		2543 -> 2544;
	2544 [label="Es schadet nicht, auf das Schlimmste vorbereitet zu sein. Es schadet ungemein, es nicht zu sein.",shape=box,color=blue];
		2544 -> 2545;
		2544 -> 2546;
		2544 -> 2547;
		2544 -> 2548;
	2545 [label="Ich ... werde die Sache im Auge behalten. Okay? Aber ich werde niemanden hintergehen.",shape=box,color=red];
		2545 -> 2549;
	2546 [label="Ich hasse es absolut, dass ich dir hier irgendwie zustimme.",shape=box,color=red];
		2546 -> 2550;
	2547 [label="Dir ist klar, dass ich genauso gelitten habe wie die Tenno, oder?",shape=box,color=red];
		2547 -> 2551;
	2548 [label="Ich werde ihr Vertrauen nicht hintergehen.",shape=box,color=red];
		2548 -> 2552;
	2549 [label="+5 Chemistry",color=orange];
		2549 -> 2553;
	2550 [label="+5 Chemistry",color=orange];
		2550 -> 2554;
	2551 [label="Und wer kann schon sagen, dass ich diese Gespräche nicht auch mit ihnen führe, hm?",shape=box,color=blue];
		2551 -> 2555;
	2552 [label="Und ich erwarte auch nicht das du es tust.",shape=box,color=blue];
		2552 -> 2556;
	2553 [label="Selbstverständlich! Mehr könnte sich kein Teufel wünschen, vielen Dank.",shape=box,color=blue];
		2553 -> 2557;
	2554 [label="Hm. Das ist nach all den Jahren einfach das Gefühl der zurückkehrenden Vernunft in dein Gehirn. Du wirst dich daran gewöhnen.",shape=box,color=blue];
		2554 -> 2558;
	2555 [label="Schlaf gut, Usurpator. ",shape=box,color=blue];
		2555 -> 2559;
	2556 [label="Add 1 to Thermostat",color=orange];
		2556 -> 2560;
	2557 [label="Add 1 to Thermostat",color=orange];
		2557 -> 2561;
	2558 [label="Add -1 to Thermostat",color=orange];
		2558 -> 2562;
	2559 [label="Add -1 to Thermostat",color=orange];
		2559 -> 2563;
	2560 [label="Chat ends.",color=orange];
	2561 [label="Chat ends.",color=orange];
	2562 [label="Chat ends.",color=orange];
	2563 [label="Chat ends.",color=orange];
}