	2285 [label="Der Krieg war so gut wie verloren; die Sentients waren unbesiegbar; also lasst uns diese seltsamen und surrealen Krieger erschaffen und sie mit Waffen uralter Herkunft ausrüsten.",shape=box,color=blue];
