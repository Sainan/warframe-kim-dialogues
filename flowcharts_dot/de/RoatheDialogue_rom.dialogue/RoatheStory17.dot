	j2613846381 [label="SN: WARFRAMES",shape=box,color=blue];
		j2613846381 -> j203141965;
	j203141965 [label="Transkript: Zunächst wirkten die Warframes eher wie eine künstlerische Stellungnahme, statt legitime Waffe.",shape=box,color=blue];
		j203141965 -> j2406796319;
	j2406796319 [label="Der Krieg war so gut wie verloren; die Sentients waren unbesiegbar; also lasst uns diese seltsamen und surrealen Krieger erschaffen und sie mit Waffen uralter Herkunft ausrüsten.",shape=box,color=blue];
		j2406796319 -> j249515373;
	j249515373 [label="Unsere Niederlage sollte wenigstens schön sein. Unvergesslich.",shape=box,color=blue];
		j249515373 -> j613454480;
	j613454480 [label="Doch entgegen aller Erwartungen siegten sie. Bald sickerten Geschichten von unerhörtem, unwahrscheinlichem Heldentum von der Front durch.",shape=box,color=blue];
		j613454480 -> j3704450851;
	j3704450851 [label="Warframes fielen vom Himmel, engelsgleich, befreiten Gefangene und zerstörten Festungen der Sentients. Einzelne waren bereits Wunder; in Gruppen glichen sie Göttern.",shape=box,color=blue];
		j3704450851 -> j1769554914;
	j1769554914 [label="Kein Wunder also, dass sie als bloße Propaganda abgetan wurden.",shape=box,color=blue];
		j1769554914 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
