	762 [label="Ja, und da wir diesen Weg schon einmal gegangen sind, weiß ich genau, wie er enden wird.",shape=box,color=red];
		762 -> 781;
	763 [label="Glaubst du wirklich, dies ist der richtige Zeitpunkt dafür?",shape=box,color=red];
