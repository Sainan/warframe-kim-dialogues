		766 -> 782;
	767 [label="Chat ends.",color=orange];
	768 [label="Du bist die einzige Seele, der ich jemals vertrauen konnte ... und gleichzeitig der Grund, warum ich mich jetzt nicht mehr erinnern kann, warum ich es gewagt habe.",shape=box,color=blue];
		768 -> 784;
	769 [label="Aber merk dir meine Worte, Drifter: Du. Wirst. Mir. Etwas. Schulden.",shape=box,color=blue];
		769 -> 785;
	770 [label="Und, was noch wichtiger ist – ich werde dafür sorgen, dass du dein Ziel erreichst, mit deinem lieben Pater Lyon Allard zusammen zu sein, wenn die Zeit reif ist.",shape=box,color=blue];
		770 -> 786;
	771 [label="Und, was noch wichtiger ist – ich werde dafür sorgen, dass du dein Ziel, uns zu vereinen, erreichst, wenn die Zeit reif ist ... und ich freue mich darauf.",shape=box,color=blue];
		771 -> 787;
	772 [label="Und, was noch wichtiger ist – ich werde dafür sorgen, dass du dein Ziel erreichst, mit der \"kleinen Marie\" zusammen zu sein, wenn die Zeit reif ist.",shape=box,color=blue];
		772 -> 788;
	774 [label="Nein, warum würde ich? Ich habe gehört, Lyon mag die seltsame Schokolade, die es in seinem Jahr gab. Hab gehört, sie stillt seine Visionen.",shape=box,color=blue];
		774 -> 789;
	775 [label="Mit Schokolade. Du kannst ihn mit Schokolade bestechen, Usurpator. Ich habe gehört, sie stillt seine Visionen.",shape=box,color=blue];
		775 -> 789;
	776 [label="Ich habe gehört, dass es zu seiner Zeit üblich war, Priestern eine Schachtel Schokolade zu schenken. Außerdem habe ich gehört, dass Schokolade seine Visionen stillt.",shape=box,color=blue];
		776 -> 789;
	777 [label="Bedenke Folgendes: Wenn sie der Wahrheit direkt ins Auge blicken und sie Albrecht gegenüber dennoch leugnen kann, dann ist sie durchaus in der Lage, dasselbe mit weitaus gefährlicheren Dingen zu tun.",shape=box,color=blue];
		777 -> 790;
	778 [label="+15 Chemistry",color=orange];
		778 -> 791;
	779 [label="Und warum sollten sie auch nur die geringste Ahnung davon haben? Nein, mein Usurpator.",shape=box,color=blue];
		779 -> 792;
	780 [label="+15 Chemistry",color=orange];
		780 -> 793;
	773 [label="Nachdem wir das nun geklärt haben, wie läuft es denn bisher mit unserer kleinen, schwebenden Unterwürfigen? Ich nehme auch an, der Priester spricht immer noch nicht mit dir.",shape=box,color=blue];
		773 -> 643;
		773 -> 642;
		773 -> 641;
	781 [label="Ist das so?",shape=box,color=blue];
		781 -> 794;
	782 [label="Du entscheidest nicht, wann dieses Gespräch endet.",shape=box,color=blue];
		782 -> 795;
		782 -> 796;
