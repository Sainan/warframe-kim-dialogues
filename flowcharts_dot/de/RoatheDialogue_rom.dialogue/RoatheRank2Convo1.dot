		718 -> 733;
	719 [label="Erstens: Ich bin beeindruckt! Du hast all unsere Erinnerungen ausgelöscht, um noch einmal zu versuchen seine Zuneigung zu gewinnen?!",shape=box,color=blue];
		719 -> 734;
	720 [label="Oh, das ist ja wirklich magisch! Du hast all unsere Erinnerungen ausgelöscht, um noch einmal zu versuchen mein Herz zu erobern?!",shape=box,color=blue];
		720 -> 735;
	721 [label="Erstens: Ich bin beeindruckt! Du hast all unsere Erinnerungen ausgelöscht, um noch einmal zu versuchen ihre Zuneigung zu gewinnen?!",shape=box,color=blue];
		721 -> 736;
	722 [label="Ich werde vor den Eiferern so tun, als ob ich nichts davon wüsste.",shape=box,color=blue];
		722 -> 737;
	724 [label="Weißt du, ob ich ihn irgendwie verstimmt habe?",shape=box,color=red];
		724 -> 739;
	725 [label="Irgendeine Idee, wie ich ihn dazu bringen kann, mit mir zu reden?",shape=box,color=red];
		725 -> 739;
	726 [label="Sie hat das Thema schon etwas angesprochen. Sie ist überzeugt, dass er nichts Schlechtes tun kann?",shape=box,color=red];
		726 -> 740;
	727 [label="Inwiefern ist sie Entrati so ergeben?",shape=box,color=red];
