	707 [label="Das ist sehr Orokin von dir.",shape=box,color=blue];
		707 -> 722;
	710 [label="Und das komische daran? Ich ziehe ihn dennoch der Nonne vor. Mit ihm kann man wenigstens vernünftig reden.",shape=box,color=blue];
		710 -> 724;
		710 -> 725;
	711 [label="Sie ist einfach so unglaublich todlangweilig fromm.",shape=box,color=blue];
		711 -> 726;
		711 -> 727;
	712 [label="Nebenbei gesagt, das Ding haben sie doch tatsächlich immer noch in dieser verdammten Kathedrale benutzt! Im Ernst ...",shape=box,color=blue];
		712 -> 728;
	708 [label="Aber um es mit den Worten der kleinen Unterwürfigen zu sagen? C'est la vie. Wie läuft es mit ihr eigentlich? Ich nehme auch an, der Priester spricht immer noch nicht mit dir.",shape=box,color=blue];
		708 -> 643;
		708 -> 642;
		708 -> 641;
	709 [label="Ich bin so froh, dass du deine Meinung geändert hast und wir endlich vorankommen können! Ich dachte schon, wir würden jahrhundertelang im Kreis gefangen sein.",shape=box,color=blue];
		709 -> 723;
	713 [label="Add 1 to Thermostat",color=orange];
		713 -> 729;
	714 [label="Add -1 to Thermostat",color=orange];
