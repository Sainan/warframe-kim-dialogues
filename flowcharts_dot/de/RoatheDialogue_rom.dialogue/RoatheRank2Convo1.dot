		677 -> 699;
	676 [label="Update boolean RoatheLyonConfessionDealNo",color=orange];
		676 -> 698;
	679 [label="Ich glaube, ich fange auch an zu verstehen, warum du unsere Erinnerungen komplett gelöscht hast. Angesichts all deiner gescheiterten Versuche und Bemühungen ... warum nicht einfach alles über Bord werfen und es von vorn versuchen?",shape=box,color=blue];
		679 -> 701;
	680 [label="Du hast frustriert feststellt, dass du sie nicht mehr von der simplen Wahrheit überzeugen konntest und hast auf das zurückgegriffen, was übrig war – und nutzt diese ... Gabe von dir.",shape=box,color=blue];
		680 -> 702;
	681 [label="Ich mag es nicht, dass du in meinen Gedanken herumgeisterst, um deine Fehler zu korrigieren, Drifter. Dass du es aber meinetwegen versuchst, ist ... nun ja, irgendwie akzeptabel.",shape=box,color=blue];
		681 -> 703;
	682 [label="Update boolean DrifterLyon",color=orange];
		682 -> 704;
	683 [label="Update boolean DrifterRoathe",color=orange];
		683 -> 705;
	684 [label="Update boolean DrifterMarie",color=orange];
		684 -> 706;
	685 [label="Da du wusstest, dass du das, was zuvor in deiner Reichweite lag, unerreichbar ist, hast du auf das zurückgegriffen, was noch möglich war – und nutzt diese ... Gabe von dir.",shape=box,color=blue];
		685 -> 707;
	688 [label="Es ist immer ein Glücksspiel, welche Seite man bekommt, und ich kann mich nie entscheiden, was ich bevorzuge.",shape=box,color=blue];
		688 -> 710;
	689 [label="Diese Frau ist in ihrer unerschütterlichen und obsessiven Hingabe zu Albrecht unermüdlich. Ich würde sagen, der Butler sollte sich Sorgen machen, aber ich bin ehrlich gesagt fest davon überzeugt, dass es sich um eine unschuldige Verehrung handelt. Und das aus meinem Mund.",shape=box,color=blue];
		689 -> 711;
	690 [label="Diese beiden Eiferer können keine zwei Minuten vergehen lassen, ohne \"Sol\" dies oder \"Lua\" das oder ohne zu versuchen, den Scheißeimer zu segnen.",shape=box,color=blue];
		690 -> 712;
	686 [label="Update boolean RoatheFamilyFail",color=orange];
		686 -> 708;
	687 [label="+5 Chemistry",color=orange];
		687 -> 709;
	691 [label="Dein Optimismus amüsiert mich. Helden. Mehr seid ihr nicht, ich schwöre. Aufgeblasene Fleisch- und Knochensäcke, angetrieben von purem Optimismus und Hoffnung. Davon verfaulen einem ja die Zähne.",shape=box,color=blue];
		691 -> 713;
	692 [label="Nein, du verstehst mich falsch. In gewisser Weise finde ich es tröstlich. Es bedeutet, dass wir, selbst wenn man uns auf unsere wesentlichen Bestandteile reduziert, immer noch dieselben sind. Wir können uns nicht ändern.",shape=box,color=blue];
		692 -> 714;
	693 [label="Du bist die einzige Seele, der ich jemals vertrauen konnte ... und gleichzeitig der Grund, warum ich mich jetzt nicht mehr erinnern kann, warum ich es gewagt habe.",shape=box,color=blue];
		693 -> 715;
