	856 [label="Aber du hast genug für Marie und Lyon zurückgebracht?",shape=box,color=red];
		856 -> 858;
	857 [label="Du hast also einfach das Gebäck gestohlen.",shape=box,color=red];
		857 -> 859;
	858 [label="Ah. Du hast also erwartet, dass ich mir nur genug für mich nehme und sie leer ausgehen lasse? Nur weil ich ihre Gesellschaft nicht genieße und sie loswerden möchte?",shape=box,color=blue];
		858 -> 860;
	859 [label="Alles auf diesem Planeten würde in Kürze dem Imperium der Orokin gehören. Es gehörte mir daher ohnehin rechtmäßig.",shape=box,color=blue];
		859 -> 861;
	860 [label="Du glaubst, meine Abneigung gegen sie rechtfertige irgendwie, dass ich auch grausam zu ihnen bin. Weil ich ein Teufel bin und daher zu solchen Taten neige, lautet die Schlussfolgerung.",shape=box,color=blue];
		860 -> 862;
	861 [label="Außerdem hatte ich kein Geld. Was hast du denn erwartet?",shape=box,color=blue];
		861 -> 863;
	862 [label="Wie enttäuschend! Solch oberflächliche Aktionen sind etwas für Extrem-Langweiler und Schulhofschläger.",shape=box,color=blue];
		862 -> 864;
	863 [label="Und ich weiß, dass du durch Schiffe rennst und dir nimmst, was immer du brauchst oder willst – schau mich nicht mit deinen unschuldigen Augen an, Usurpator.",shape=box,color=blue];
		863 -> 865;
		863 -> 866;
	864 [label="Ich hasse sie. Trotzdem muss ich mit ihnen zusammenleben. Ich will ihnen doch nicht ihren albernen Gebäckgenuss vorenthalten. Es ist doch nur Gebäck. Warum sollte man die Sache unnötig verschlimmern?",shape=box,color=blue];
		864 -> 867;
		864 -> 868;
		864 -> 869;
	865 [label="Vergiss es. ",shape=box,color=red];
		865 -> 870;
	866 [label="Guter Einwand, würd ich sagen.",shape=box,color=red];
		866 -> 871;
	867 [label="Oder du könntest versuchen, freundlich zu ihnen zu sein – einfach so, ohne Grund.",shape=box,color=red];
		867 -> 872;
	868 [label="Nur um das klarzustellen: Du warst nett, weil du sie hasst.",shape=box,color=red];
		868 -> 873;
	869 [label="So habe ich das wohl noch nie betrachtet.",shape=box,color=red];
		869 -> 874;
	870 [label="Fantastisch. Noch so einer, der einfach nicht nachgeben kann. Als ob die Eiferer nicht schon genug wären, die mich zu jeder Tages- und Nachtzeit anschreien und mich anflehen, Buße zu tun.",shape=box,color=blue];
		870 -> 758;
		870 -> 759;
		870 -> 760;
		870 -> 761;
