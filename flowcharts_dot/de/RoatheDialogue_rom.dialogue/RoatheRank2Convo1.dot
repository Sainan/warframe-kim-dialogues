	793 [label="Ha! Ich werde dir eine Liste erstellen! Sie ist umfassend und doch unspezifisch, sie schwankt ständig zwischen unbegreiflich Bösem und scheinbar unergründlicher Korruption!",shape=box,color=blue];
		793 -> 792;
	794 [label="Update boolean RoatheKnowsReset2",color=orange];
		794 -> 806;
	795 [label="Du bist zu wütend. Im Moment bist du überzeugt, den feigen Ausweg gewählt zu haben, aber du erinnerst dich an nichts mehr, was zu diesem Moment geführt hat.",shape=box,color=red];
		795 -> 807;
	796 [label="Du hast mir schon einmal deine Geschichten anvertraut – aber jetzt nicht. Die Gespräche, die wir führen müssen? Die kannst du nicht führen.",shape=box,color=red];
		796 -> 808;
	797 [label="+10 Chemistry",color=orange];
		797 -> 809;
	798 [label="Hör bitte auf, mich anzulügen.",shape=box,color=red];
