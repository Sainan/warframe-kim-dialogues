		731 -> 746;
	5763 [label="Und, was noch wichtiger ist – ich werde dafür sorgen, dass du dein Ziel, Lyon durch seinen Schmerz zu begleiten, dieses Mal erreichst, koste es, was es wolle.",shape=box,color=blue];
		5763 -> 5764;
