		871 -> 875;
	872 [label="Ja, vor allem wenn sie dir Tag und Nacht rund um die Uhr in den Ohren hängen, deinen Namen verfluchen und dich anflehen, Buße zu tun.",shape=box,color=blue];
		872 -> 758;
