		607 -> 618 [label="false",color=purple];
	609 [label="Ich finde es ungemein faszinierend, dass du mit mir gemeinsame Sache gemacht hast, um ... meinen eigenen Weg zu ebnen. Der Teufel handelt, so scheint es, mit seinem eigenen Fleisch.",shape=box,color=blue];
		609 -> 619;
	608 [label="Wie läuft es bei dir, mein Usurpator? Ich ziehe eifrig die Fäden und Hebel zu deinen Gunsten, auch wenn mein Einfluss bisher unsichtbar und unmerklich geblieben ist.",shape=box,color=blue];
		608 -> 619;
	610 [label="Sag mir, dass du deine Meinung zu meinem Angebot geändert hast. Wo ich dir vielleicht vorher im Weg gestanden hätte, was deine ... romantischen Ziele angeht? Werde ich jetzt so zahm sein wie ein Schnee-Terrisk. Hm. Es sei denn, du willst das nicht. Das kannst du selbst entscheiden.",shape=box,color=blue];
		610 -> 620;
	611 [label="Sag mir, dass du deine Meinung zu meinem Angebot geändert hast. Ich kann das Problem mit Marie für dich lösen. Sicherstellen, dass du deine romantischen Ziele mit ihr ganz mühelos erreichst.",shape=box,color=blue];
		611 -> 620;
	612 [label="Sag mir, dass du deine Meinung zu meinem Angebot geändert hast. Ich kann das Problem mit Lyon für dich lösen. Sicherstellen, dass du deine romantischen Ziele mit ihm ganz mühelos erreichst.",shape=box,color=blue];
		612 -> 620;
	613 [label="Sag mir, dass du deine Meinung zu meinem Angebot geändert hast. Wo ich mich zuvor vielleicht widersetzt hätte, was meine ... Einnahme des Serums betrifft? Werde ich mich so fügsam wie ein Schnee-Terrisk verhalten.",shape=box,color=blue];
		613 -> 620;
	614 [label="Sag mir, dass du deine Meinung zu meinem Angebot geändert hast. Wo ich zuvor vielleicht ein Hindernis gewesen wäre, den Butler und seine Familie wiederzuvereinen? Werde ich mich so fügsam erweisen wie eine Schnee-Terrisk.",shape=box,color=blue];
		614 -> 620;
	615 [label="Sag mir, dass du deine Meinung zu meinem Angebot geändert hast - Ich kann das Problem mit Marie für dich lösen. Sicherstellen, dass deine Gespräche mit ihr mühelos laufen.",shape=box,color=blue];
		615 -> 620;
	616 [label="Sag mir, dass du deine Meinung zu meinem Angebot geändert hast - Ich kann das Problem mit Lyon für dich lösen. Sicherstellen, dass deine Gespräche mit ihm mühelos laufen.",shape=box,color=blue];
		616 -> 620;
	617 [label="Ich kann mir nicht helfen, aber ich glaube, dass du aus einem bestimmten Grund in unseren Gesprächen verweilst, Usurpator. Und dass es etwas gibt, bei dem ich dir vielleicht helfen kann.",shape=box,color=blue];
		617 -> 621;
	618 [label="Evaluate expressions on HellStory",color=orange];
		618 -> 606 [label="x >= 21",color=purple];
		618 -> 622 [label="x < 21",color=purple];
		618 -> 622 [label="false",color=purple];
	619 [label="Aus meiner Sicht ist es eine seltsame Herausforderung, nur mit einem Teil meiner intakten Erinnerungen zu arbeiten und zu wissen, dass du die andere Hälfte der Karten in der Hand hältst.",shape=box,color=blue];
		619 -> 623;
	620 [label="Aber all dieses ... wiederkäuen? Das ist reine Zeitverschwendung. Also komm schon. Sag es einfach. Und dein Problem ist gelöst.",shape=box,color=blue];
		620 -> 624;
		620 -> 625;
	621 [label="Sag mir, was du anstrebst, und lass uns eine Einigung erzielen. Dieses ganze ... wiedergekäue ist reine Zeitverschwendung.",shape=box,color=blue];
		621 -> 626;
	622 [label="Evaluate expressions",color=orange];
		622 -> 628 [label="RoatheDeal",color=purple];
		622 -> 627 [label="RoatheNoDeal",color=purple];
		622 -> 627 [label="false",color=purple];
	623 [label="Dann mache ich eben weiter, da ich nichts Besseres zu tun habe. \"Wie steht es eigentlich mit unserer kleinen, schwebenden Unterwürfigen? Ich nehme auch an, der Priester spricht immer noch nicht mit dir.\" Ach, was für eine Farce.",shape=box,color=blue];
		623 -> 629;
		623 -> 630;
		623 -> 631;
	624 [label="Nein. Tut mir leid. Ich treffe keine Abmachungen mit Orokin. Weder damals, noch heute, noch jemals.",shape=box,color=red];
		624 -> 632;
	625 [label="Ich hoffe wirklich, dass du mich das nicht bereuen lässt, Roathe. Gut. Einverstanden. Ich brauche deine Hilfe.",shape=box,color=red];
		625 -> 633;
	626 [label="Check boolean LoidFamilyComplete",color=orange];
		626 -> 634 [label=true,color=green];
		626 -> 635 [label=true,color=green];
		626 -> 636 [label=true,color=green];
		626 -> 637 [label=true,color=green];
		626 -> 634 [label=false,color=brown];
		626 -> 635 [label=false,color=brown];
		626 -> 636 [label=false,color=brown];
		626 -> 637 [label=false,color=brown];
		626 -> 638 [label=false,color=brown];
	628 [label="Wie läuft es denn bisher mit unserer kleinen, schwebenden Unterwürfigen? Ich nehme auch an, der Priester spricht immer noch nicht mit dir.",shape=box,color=blue];
		628 -> 641;
		628 -> 642;
		628 -> 643;
	627 [label="Sag mir, hast du deine Meinung zu meinem Angebot geändert? Das ist deine letzte Chance, Usurpator. Ich bin ein geduldiger Teufel, aber ich halte Türen nicht ewig offen, wie ein Narr.",shape=box,color=blue];
		627 -> 639;
		627 -> 640;
	629 [label="Ich komme bisher ganz gut mit Marie zurecht.",shape=box,color=red];
		629 -> 644;
	630 [label="Nein, aber er wird es irgendwann.",shape=box,color=red];
		630 -> 645;
	631 [label="Du scheinst sie nicht besonders zu mögen. Warum?",shape=box,color=red];
		631 -> 646;
	632 [label="Wie du willst. Nur zur Warnung: Dies war deine letzte Chance. Du bist jetzt auf dich allein gestellt.",shape=box,color=blue];
		632 -> 647;
	633 [label="Evaluate expressions",color=orange];
		633 -> 649 [label="RoatheDatingDealNo",color=purple];
		633 -> 650 [label="RoatheMarieDatingDealNo",color=purple];
		633 -> 651 [label="RoatheLyonDatingDealNo",color=purple];
		633 -> 652 [label="RoatheSerumDealNo",color=purple];
		633 -> 655 [label="RoatheFamilyDealNo",color=purple];
		633 -> 654 [label="RoatheMarieEntratiDealNo",color=purple];
		633 -> 653 [label="RoatheLyonConfessionDealNo",color=purple];
		633 -> 648 [label="false",color=purple];
	634 [label="Lyon hat ... er hat mit so vielem zu kämpfen. Und ich weiß nicht, wie ich da durchkommen kann.",shape=box,color=red];
		634 -> 656;
	635 [label="Marie will Entrati nicht so sehen, wie er wirklich ist. Und ich kann sie nicht dazu bringen, die Wahrheit zu erkennen, egal was ich tue.",shape=box,color=red];
		635 -> 657;
	636 [label="Nun ja, siehst du, du hast da diese ganze Sache ... mit dem warum du das Serum genommen hast, und ich ... habe die falschen Dinge zur falschen Zeit gesagt.",shape=box,color=red];
		636 -> 658;
	637 [label="Es ist etwas peinlich, aber ... ich habe Gefühle für einen von euch dreien.",shape=box,color=red];
		637 -> 659;
		637 -> 660;
		637 -> 661;
	638 [label="Ich versuche, dich und die anderen dazu zu bringen, mir zu helfen, Loid wieder mit seiner Familie über uns zu vereinen, und ... ich ... konnte es nicht ...",shape=box,color=red];
		638 -> 662;
	641 [label="Nein, Lyon ... scheint nicht viel zu reden.",shape=box,color=red];
		641 -> 665;
	642 [label="Ich verstehe mich gut mit Marie. Warum nennst du sie eine Unterwürfige?",shape=box,color=red];
		642 -> 666;
	643 [label="Du scheinst sie nicht besonders zu mögen. Warum?",shape=box,color=red];
		643 -> 667;
	639 [label="Nein. Tut mir leid. Ich treffe keine Abkommen mit Orokin. Weder damals, noch heute, noch jemals.",shape=box,color=red];
		639 -> 663;
	640 [label="Ich hoffe wirklich, dass du mich das nicht bereuen lässt, Roathe. Gut. Einverstanden.",shape=box,color=red];
		640 -> 664;
	644 [label="\"Bisher.\" Faszinierend. Und wir treten tatsächlich alle nur im Kreise in unsere Fußspuren, wie Höflinge, die einen Tanze nachahmen? Immer und immer wieder, dazu verdammt, uns zu wiederholen?",shape=box,color=blue];
		644 -> 668;
		644 -> 669;
	645 [label="Ich vermute, du weißt das, nicht wahr? Interessant, dass es so vorhersehbar ist. Schön zu wissen, dass selbst jemand, der so zerrüttet ist wie er, ab und zu noch verlässlich ist.",shape=box,color=blue];
		645 -> 670;
	646 [label="Weißt du das etwa nicht schon? Hm. Vielleicht bist du nicht so weit gekommen. Oder du hast beim ersten oder zwanzigtausendsten Mal in dieser kleinen Geschichte nicht daran gedacht zu fragen.",shape=box,color=blue];
		646 -> 670;
	647 [label="Oh. Und noch etwas, bevor ich es vergesse?",shape=box,color=blue];
		647 -> 671;
	649 [label="Du hast deine Seele tatsächlich dem Teufel verkauft, und das gleich zweimal ... nur um sicherzustellen, dass mein Bett mit dir teile? Oder hast du es auf mein Herz abgesehen, Usurpator? Hm. Wir werden sehen. Wenn die Zeit reif ist.",shape=box,color=blue];
		649 -> 672;
	650 [label="Wenn die Zeit reif ist, Usurpator, werde ich dafür sorgen, dass dein Weg frei ist, um unsere kleine schwebende, Unterwürfige für dich zu gewinnen. Betrachte das als erledigt.",shape=box,color=blue];
		650 -> 673;
	651 [label="Wenn die Zeit reif ist, Usurpator, werde ich dafür sorgen, dass dein Weg frei ist, um den armen, gebrochenen Priester für dich zu gewinnen. Betrachte das als erledigt.",shape=box,color=blue];
		651 -> 674;
	652 [label="Wenn die Zeit reif ist, werde ich mich daran erinnern. Sollten wir erneut Meinungsverschiedenheiten über meine Erinnerungen haben, werden wir deine früheren Fehler nicht wiederholen.",shape=box,color=blue];
		652 -> 675;
	655 [label="Wenn die Zeit reif ist, werde ich dafür sorgen, dass der kleine Butler die Treppe hinaufsteigt. Betrachte das als erledigt.",shape=box,color=blue];
		655 -> 678;
	654 [label="Ich betrachte deine Angelegenheit mit Marie und ihrer unterwürfigen Verehrung von Entrati als erledigt. Wenn dir Zeit reif ist, werde ich mich darum kümmern.",shape=box,color=blue];
		654 -> 677;
	653 [label="Betrachte deine Angelegenheit mit Lyon und seinen Schrecken als erledigt, Usurpator. Wenn die Zeit reif ist, werde ich mich darum kümmern.",shape=box,color=blue];
		653 -> 676;
	648 [label="Ich ... habe offenbar vergessen, was du wolltest. Schuld daran ist dein Herumspielen mit meinen Erinnerungen. Was war es noch mal?",shape=box,color=blue];
		648 -> 626;
	656 [label="Ich würde dir stattdessen einfach zur Geduld raten, aber ... es liegt mir fern, dir zu raten, einen Meißel zu benutzen, wenn eine Laserspitzhacke neben dir liegt.",shape=box,color=blue];
		656 -> 679;
	657 [label="Hm. Verstehe. Ein edles Unterfangen, wenn ich ehrlich bin. Eines, das ich selbst schon unzählige Male versucht habe. Und dabei ebenso oft gescheitert bin.",shape=box,color=blue];
		657 -> 680;
	658 [label="Hm.",shape=box,color=blue];
		658 -> 681;
	659 [label="Lyon.",shape=box,color=red];
		659 -> 682;
	660 [label="... für dich.",shape=box,color=red];
		660 -> 683;
	661 [label="Marie.",shape=box,color=red];
		661 -> 684;
	662 [label="Hm. Ich verstehe. Ich habe dir eine Vereinbarung angeboten, und du konntest deinen Teil der Abmachung aus irgendeinem Grund nicht einhalten, sodass dein Gewinn vor deiner Nase entschwand.",shape=box,color=blue];
		662 -> 685;
	665 [label="Wenn er spricht, lässt sich das im Allgemeinen in zwei Kategorien einteilen – entsetzlich irrsinnig oder entsetzlich wahnsinnig.",shape=box,color=blue];
		665 -> 688;
	666 [label="Hm? Bist du bisher ungeschoren davongekommen? Ich beneide dich ungemein. Es wird aber nicht mehr lange dauern, bis du im Explosionsradius gefangen bist, deshalb ist es gut, wenn du rechtzeitig gewarnt bist.",shape=box,color=blue];
		666 -> 689;
	667 [label="Mein armer Drifter. Hast du etwa vergessen, wie vehement wir Orokin jegliche Vorstellung von heiligen Gottheiten ablehnten? Wir verehrten nur uns selbst.",shape=box,color=blue];
		667 -> 690;
	663 [label="Wie du willst. Ich warne dich jedoch, diese Entscheidung kann nicht ohne Folgen rückgängig gemacht werden.",shape=box,color=blue];
		663 -> 686;
	664 [label="Du benimmst dich und hilfst mir, Loid dazu zu bringen, nach oben zu gehen und sich mit der Familie zu versöhnen? Und ich helfe dir, deine Erinnerungen zu ordnen.",shape=box,color=red];
		664 -> 687;
	668 [label="Das heißt nicht, dass du keine Handlungsfähigkeit hast. Es bedeutet lediglich, dass manches ein paar Versuche mehr erfordert.",shape=box,color=red];
		668 -> 691;
	669 [label="Ich hoffe, das macht dich nicht wütend.",shape=box,color=red];
		669 -> 692;
	670 [label="Sind wir wirklich alle dazu verdammt, uns zu wiederholen, wie Höflinge, die einen Tanze nachahmen?",shape=box,color=blue];
		670 -> 668;
		670 -> 669;
	671 [label="Vor nicht allzu langer Zeit vertraute ich dir eine schreckliche Wahrheit an. Jetzt kann ich mich nicht mehr erinnern, warum.",shape=box,color=blue];
		671 -> 693;
	672 [label="Update boolean RoatheFamilyDealNo",color=orange];
		672 -> 694;
	673 [label="Update boolean RoatheFamilyDealNo",color=orange];
		673 -> 695;
	674 [label="Update boolean RoatheLyonDatingDealNo",color=orange];
