		800 -> 812;
	799 [label="Das könnte schwierig werden. Hat Lyon sonst noch irgendwelche Wünsche, die ich ... ihm ... erfüllen kann?",shape=box,color=red];
		799 -> 811;
	801 [label="Du weißt nicht, wie es ist, wenn dir diese Eiferer rund um die Uhr über die Schulter schauen und dich anschreien und belehren, wie sehr du Buße tun musst.",shape=box,color=blue];
		801 -> 758;
		801 -> 759;
		801 -> 760;
		801 -> 761;
	802 [label="Ich weiß, wir sind am Ende unserer Möglichkeiten, ich spüre, wie mein Verstand gegen mich ankämpft. Du gibst dein Bestes, um mir zu helfen, meine Erinnerungen wiederzuerlangen. Dafür bin ich dir dankbar. ",shape=box,color=blue];
		802 -> 813;
	803 [label="Wir haben gerade erst begonnen, die spärlichsten Bruchstücke dessen aufzudecken, was mir vorenthalten wurde. Ich weiß nicht, was Albrecht ihnen über meine Verbrechen erzählt hat, Drifter.",shape=box,color=blue];
		803 -> 814;
	804 [label="Wir haben erst an der Oberfläche dessen gekratzt, was mir vorenthalten wurde. Ich weiß nicht, was Albrecht ihnen über meine Verbrechen erzählt hat, Drifter.",shape=box,color=blue];
		804 -> 814;
	805 [label="Ich weiß nicht, was Albrecht ihnen über meine Verbrechen erzählt hat, denn selbst mir sind sie unbekannt. Die Wahrheit liegt in meinen Erinnerungen verborgen, Drifter.",shape=box,color=blue];
		805 -> 814;
	806 [label="Vor nicht allzu langer Zeit vertraute ich dir eine schreckliche Wahrheit an. Jetzt kann ich mich nicht mehr erinnern, warum.",shape=box,color=blue];
		806 -> 815;
	807 [label="Tief in dir brodelt es, das weiß ich. Und ich weiß, wir müssen erst einen gewissen Punkt erreichen, bevor wir darüber reden können.",shape=box,color=red];
		807 -> 816;
	808 [label="Und warum solltest du mir auch vertrauen? Alles, was du über mich weißt, ist, dass ich ... deine Erinnerung manipuliert habe.",shape=box,color=red];
		808 -> 817;
	809 [label="Update boolean RoatheKnowsReset2",color=orange];
		809 -> 818;
	810 [label="Wenn du nicht langweilig sein willst, Drifter, warum sollte ich dann meine Zeit mit dir verschwenden? Ich habe ja schon die Eiferer, und anscheinend muss ich auch noch Zeit mit ihnen verbringen.",shape=box,color=blue];
		810 -> 819;
	812 [label="Ah, sie hat es dir also erzählt. Natürlich hat sie das. Nun ja, es ist ja wohl kaum meine Schuld! Diese verdammten Leckereien waren das einzig Gute an diesem verschlafenen Drecksloch von einer Stadt.",shape=box,color=blue];
		812 -> 821;
		812 -> 822;
	811 [label="+5 Chemistry",color=orange];
		811 -> 820;
	813 [label="Ich muss wissen, was mir genommen wurde, Drifter. Ich muss wissen, was Albrecht mir geraubt hat, als er mir dieses Serum gewaltsam verabreichte.",shape=box,color=blue];
		813 -> 823;
		813 -> 824;
	814 [label="Ich muss wissen, was Albrecht mir geraubt hat, als er mir dieses Serum gewaltsam verabreichte. Ich muss wissen, was in meinem Kopf verschlossen ist, Drifter. Natürlich nur, wenn es dir keine Umstände bereitet ...",shape=box,color=blue];
		814 -> 825;
		814 -> 826;
	815 [label="Du bist die einzige Seele, der ich jemals vertrauen konnte ... und gleichzeitig der Grund, warum ich mich jetzt nicht mehr erinnern kann, warum ich es gewagt habe.",shape=box,color=blue];
		815 -> 827;
	816 [label="Und warum bin ich wütend, Drfter?",shape=box,color=blue];
		816 -> 828;
		816 -> 829;
		816 -> 830;
	817 [label="\"Meine Erinnerungen manipuliert.\" Als wäre ich eine Ayatan-Skulptur, mit der man nur herumspielt. Du hast nicht nur mein Gedächtnis manipuliert, du hast es komplett gelöscht.",shape=box,color=blue];
		817 -> 831;
		817 -> 832;
	818 [label="Update boolean RoatheRank2Convo1Complete",color=orange];
		818 -> 833;
	819 [label="Update boolean RoatheRank2Convo1Complete",color=orange];
		819 -> 834;
	821 [label="Es stimmt also. Du hast dich nach Gallien rausgeschlichen, um Schokolade zu stehlen? Aussehend wie ...?",shape=box,color=red];
		821 -> 836;
	822 [label="Wie genau bist du da ran gekommen?",shape=box,color=red];
		822 -> 837;
	820 [label="Ha! Gut erfasst. Diese verdammte Schokolade war das einzig Gute an diesem verschlafenen Drecksloch von einer Stadt.",shape=box,color=blue];
		820 -> 835;
	823 [label="Das verspreche ich.",shape=box,color=red];
		823 -> 838;
	824 [label="Wir werden es herausfinden. Aber das braucht Zeit.",shape=box,color=red];
		824 -> 839;
	825 [label="Ich werde es schaffen.",shape=box,color=red];
		825 -> 840;
	826 [label="Ich versuche es ja. Aber du machst es mir nicht gerade leicht.",shape=box,color=red];
		826 -> 841;
	827 [label="Verstehe, was das aus dir macht, für mich.",shape=box,color=blue];
		827 -> 842;
	828 [label="Du hast behauptet, du bist nicht wütend auf mich, weil ich deine Erinnerungen gelöscht habe, aber ich weiß, dass du lügst. Denn ... es ist nicht das erste Mal, dass ich das getan habe.",shape=box,color=red];
		828 -> 843;
	829 [label="Weil du dich selbst verabscheust, das Serum freiwillig eingenommen zu haben. Du hasst dich selbst, und das macht dich wütend – denn du bist alles, was dir geblieben ist.",shape=box,color=red];
		829 -> 844;
	830 [label="Du hast behauptet, du bist nicht wütend auf mich, weil ich deine Erinnerungen gelöscht habe, aber das kann ich einfach nicht glauben.",shape=box,color=red];
		830 -> 844;
	831 [label="Du hast nichts Wertvolles verloren, nur unsere Gespräche.",shape=box,color=red];
		831 -> 845;
	832 [label="Aber nicht alles – nur unsere Gesprächen hier. Alles andere ist noch da, sogar das, was wir in \"der Abgründigkeit\" wiederhergestellt haben.",shape=box,color=red];
		832 -> 845;
	833 [label="Chat ends.",color=orange];
	834 [label="Chat ends.",color=orange];
	836 [label="Ja, mit der blauen Haut, dem Schwanz, dem befallenen Fleisch und allem drum und dran. Es ist erstaunlich, was ein Umhang, ein Hut und eine Maske ausmachen können.",shape=box,color=blue];
		836 -> 847;
	837 [label="Es war kinderleicht. Außerdem – als \"Protoframe\" und kampferprobter Elitekämpfer der Orokin bin ich meiner Meinung nach durchaus in der Lage, mir auf dem Markt ein paar Gebäckstücke zu besorgen, ohne die Behörden zu alarmieren.",shape=box,color=blue];
		837 -> 848;
	835 [label="Bevor du fragst: Diese Geschichte erzählt am besten Marie selbst, sonst muss ich mir wieder die Eiferer anhören, die mich anschreien und beschimpfen.",shape=box,color=blue];
		835 -> 846;
	838 [label="Versprechen an den Teufel ... eine gefährliche Sache.",shape=box,color=blue];
		838 -> 849;
	839 [label="Und ich bin ein geduldiger Teufel.",shape=box,color=blue];
		839 -> 849;
	840 [label="Mach das.",shape=box,color=blue];
		840 -> 850;
	841 [label="Natürlich nicht! Wo bliebe denn da der Spaß?",shape=box,color=blue];
		841 -> 850;
	842 [label="Update boolean RoatheKnowsReset2",color=orange];
		842 -> 851;
	843 [label="Wie wunderbar reizend! Und ich bin kaum überrascht! Was kümmert es mich schon, ob es die Wahrheit ist oder nicht?! Und außerdem –",shape=box,color=blue];
		843 -> 844;
	844 [label="Falsch! Atemberaubend, wunderschön, glückselig, falsch! Sprich nicht mit mir, als ob du die Feinheiten einer Wut kennst, die du ganz offensichtlich nicht einmal ansatzweise begreifen kannst.",shape=box,color=blue];
		844 -> 746;
	845 [label="Wage es nicht, mir vorzuschreiben, was in meinem Geist wertvoll ist und was nicht, Drifter. Es steht dir nicht zu, darüber Besitz zu beanspruchen.",shape=box,color=blue];
		845 -> 746;
	847 [label="Menschen neigen dazu, diejenigen schnell zu ignorieren, die sie nicht sehen wollen. Außerdem – als \"Protoframe\" und kampferprobter Elitekämpfer der Orokin bin ich meiner Meinung nach durchaus in der Lage, mir auf dem Markt ein paar Gebäckstücke zu besorgen, ohne die Behörden zu alarmieren.",shape=box,color=blue];
		847 -> 852;
	848 [label="Ja, mit der blauen Haut, dem Schwanz, dem befallenen Fleisch und allem drum und dran. Es ist erstaunlich, was ein Umhang, ein Hut und eine Maske ausmachen können.",shape=box,color=blue];
		848 -> 852;
	846 [label="Es reicht schon, wenn sie mich ständig anschreien über Sünde und wie nötig es sei, Buße zu tun, ohne den Zusatz \"dass ich schon wieder über meine Version der Geschichte lüge\".",shape=box,color=blue];
		846 -> 758;
		846 -> 759;
		846 -> 760;
		846 -> 761;
