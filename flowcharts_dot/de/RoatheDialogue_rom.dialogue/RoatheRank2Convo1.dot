		716 -> 731;
	5762 [label="Ich werde vor den Eiferern so tun, als ob ich nichts davon wüsste.",shape=box,color=blue];
		5762 -> 5763;
	717 [label="Ich werde vor den Eiferern so tun, als ob ich nichts davon wüsste.",shape=box,color=blue];
