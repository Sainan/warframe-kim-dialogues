	"Chat ends." [color=orange];
	j3629712662 [label="SN: KOMMANDANTEN",shape=box,color=blue];
		j3629712662 -> j2998992521;
	j2998992521 [label="Transkript: Ich erinnere mich an sie. Scharen lachender Jugend der Orokin.",shape=box,color=blue];
		j2998992521 -> j1221155039;
	j1221155039 [label="Adelige in den noch unbefleckten Gewändern der Befehlshaber.",shape=box,color=blue];
		j1221155039 -> j1690771029;
	j1690771029 [label="Kindheitsfreunde, die nun Legionen von Dax, Grineer, Nullmateriezellen, sich selbst replizierenden Karzinatoren, primitiven Biodrohnen-Klingenspinnen und Kanister mit technologisch einfachen Truppen befehligten.",shape=box,color=blue];
		j1690771029 -> j4168770411;
	j4168770411 [label="Goldene Jungen und Mädchen mit reißenden Teufeln zu ihren Diensten.",shape=box,color=blue];
		j4168770411 -> j2869506798;
	j2869506798 [label="Ihre Arroganz rinnt mir wie stechender Schweiß in den Kopf. Sie tranken und sangen, prahlten mit der Zukunft.",shape=box,color=blue];
		j2869506798 -> j698653229;
	j698653229 [label="Sie würden sich einen Namen machen. Ihre Familien zu hohem Ansehen erheben.",shape=box,color=blue];
		j698653229 -> j2389380782;
	j2389380782 [label="So viele von ihnen fielen. Nicht einmal ihre Leichen wurden zurückgebracht.",shape=box,color=blue];
		j2389380782 -> j285569716;
	j285569716 [label="Um zu verhindern, dass der Feind unsere Geheimnisse erlangte, wurden sie mit Kuva-Schocks verflüssigt, sobald sie starben.",shape=box,color=blue];
		j285569716 -> j3723224595;
	j3723224595 [label="Die Hoffnung einer Generation verwandelte sich in eine ölige Pfütze, durch die Stiefel der Grineer waten.",shape=box,color=blue];
		j3723224595 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}