	2208 [label="Transkript: Ich erinnere mich an sie. Scharen lachender Jugend der Orokin.",shape=box,color=blue];
		2208 -> 2212;
	2212 [label="Adelige in den noch unbefleckten Gewändern der Befehlshaber.",shape=box,color=blue];
		2212 -> 2205;
	2205 [label="Kindheitsfreunde, die nun Legionen von Dax, Grineer, Nullmateriezellen, sich selbst replizierenden Karzinatoren, primitiven Biodrohnen-Klingenspinnen und Kanister mit technologisch einfachen Truppen befehligten.",shape=box,color=blue];
		2205 -> 2213;
	2213 [label="Goldene Jungen und Mädchen mit reißenden Teufeln zu ihren Diensten.",shape=box,color=blue];
		2213 -> 2215;
	2215 [label="Ihre Arroganz rinnt mir wie stechender Schweiß in den Kopf. Sie tranken und sangen, prahlten mit der Zukunft.",shape=box,color=blue];
		2215 -> 5696;
	5696 [label="Sie würden sich einen Namen machen. Ihre Familien zu hohem Ansehen erheben.",shape=box,color=blue];
		5696 -> 5697;
	5697 [label="So viele von ihnen fielen. Nicht einmal ihre Leichen wurden zurückgebracht.",shape=box,color=blue];
		5697 -> 5698;
	5698 [label="Um zu verhindern, dass der Feind unsere Geheimnisse erlangte, wurden sie mit Kuva-Schocks verflüssigt, sobald sie starben.",shape=box,color=blue];
		5698 -> 5699;
	5699 [label="Die Hoffnung einer Generation verwandelte sich in eine ölige Pfütze, durch die Stiefel der Grineer waten.",shape=box,color=blue];
