	j822319399 [label="Transkript: Ich erinnere mich, dass die Entwicklungen der Kriegs-Archimeden anfangs als Unterhaltung präsentiert wurden.",shape=box,color=blue];
		j822319399 -> j2935940750;
	j2935940750 [label=" Wie lüsterne Wüstlinge, die im Zirkus der Hinrichtung von Verbrechern zusehen.",shape=box,color=blue];
		j2935940750 -> j343919003;
	j343919003 [label="Wir bildeten uns ein, neue und aufregende Wege zu finden, einen weit unterlegenen Feind zu vernichten.",shape=box,color=blue];
		j343919003 -> j2227670319;
	j2227670319 [label="Wie selbstgefällig wir waren! In Wahrheit tüftelten wir verzweifelt an Neuerungen, wissend, dass wir unseren wandelbaren Feinden unterlegen waren.",shape=box,color=blue];
		j2227670319 -> j2175944069;
	j2175944069 [label="Sie überrannten uns wie eine Horde Kinder, die ihre aufgeblähte Mutter verschlingen.",shape=box,color=blue];
		j2175944069 -> j521385781;
	j521385781 [label="Ausgetrocknet, zwischen den Seiten der Zeit zerquetscht, wurden wir einfach evolutionär überholt.",shape=box,color=blue];
		j521385781 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
