		2300 -> 2305;
	2305 [label="Aus mir unerfindlichen Gründen wählte er den Frieden; es stand vier zu drei, und so wurden die verschlingenden Sentients plötzlich zu Verbündeten und Freunden.",shape=box,color=blue];
		2305 -> 2308;
