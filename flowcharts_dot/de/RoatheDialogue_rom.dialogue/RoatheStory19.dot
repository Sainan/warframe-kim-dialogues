	j1868438396 [label="SN: DIPLOMATIE",shape=box,color=blue];
		j1868438396 -> j4193883327;
	j4193883327 [label="Transkript: Unter den Sieben Exekutoren hatte sich Ballas als Erster unter Gleichen inszeniert.",shape=box,color=blue];
		j4193883327 -> j3756671263;
	j3756671263 [label="Stets Diplomat, stets der charmante Verführer, schlichtete er die Streitigkeiten und Auseinandersetzungen der anderen.",shape=box,color=blue];
		j3756671263 -> j530152336;
	j530152336 [label="Zu meiner größten Freude stellte ich fest, dass er nun zwischen zwei Dornensträuchern gefangen war.",shape=box,color=blue];
		j530152336 -> j3322247981;
	j3322247981 [label="Die Kriegstreiber unter Nitokh zogen in die eine Richtung, die Pazifisten unter Scarne in die andere.",shape=box,color=blue];
		j3322247981 -> j3052054346;
	j3052054346 [label="Ballas musste sich entscheiden und riskierte den erbitterten Hass der gegenseitigen Gruppe.",shape=box,color=blue];
		j3052054346 -> j610402491;
	j610402491 [label="Aus mir unerfindlichen Gründen wählte er den Frieden; es stand vier zu drei, und so wurden die verschlingenden Sentients plötzlich zu Verbündeten und Freunden.",shape=box,color=blue];
		j610402491 -> j4239787981;
	j4239787981 [label="'So oder so, er wird sich fügen', versprach Nitokh, während ich ausgesandt wurde, um unter den Dax in den Garnisonen nach Unzufriedenen zu suchen.",shape=box,color=blue];
		j4239787981 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}