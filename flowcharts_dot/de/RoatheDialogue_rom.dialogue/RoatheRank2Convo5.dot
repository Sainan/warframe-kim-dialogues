digraph {
	1224 [label="RoatheRank2Convo5 begins.",color=orange];
		1224 -> 1225;
	1225 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1225 -> 1226 [label=true,color=green];
		1225 -> 1227 [label=false,color=brown];
	1226 [label="Check boolean RoatheKnowsReset2",color=orange];
		1226 -> 1229 [label=true,color=green];
		1226 -> 1228 [label=false,color=brown];
	1227 [label="Chat ends.",color=orange];
	1229 [label="Wie viel hat dir der Roathe der Vergangenheit über seine Geschäfte mit Exekutorin Nitokh erzählt? Pah. Versuche, das alles in Einklang zu bringen: dass mein früheres Ich dir so persönliche Informationen anvertraut hat ... nur damit du sie komplett aus meinem Gedächtnis löschen kannst?",shape=box,color=blue];
		1229 -> 1232;
	1228 [label="Evaluate expressions on HellStory",color=orange];
		1228 -> 1231 [label="x >= 1",color=purple];
		1228 -> 1230 [label="x <= 1",color=purple];
		1228 -> 1230 [label="false",color=purple];
	1232 [label="Es schmerzt mich zutiefst. Dass ich dir alles erzählt haben könnte, wirklich alles – alles offengelegt, bis ins Innerste meiner Seele, und du ... hast alles wieder ausgelöscht. Als wäre ich für dich nichts weiter als ein kleines Spielzeug.",shape=box,color=blue];
		1232 -> 1234;
	1231 [label="Du hast mich schon einmal über Exekutorin Nitokh sprechen hören. Und über meine ... Geschäfte mit ihr. Du musst versuchen zu verstehen, dass das Imperium der Orokin nicht gänzlich böse war.",shape=box,color=blue];
		1231 -> 1233;
	1230 [label="Chat ends.",color=orange];
	1234 [label="Ich nehme an, das ist nur gerecht. So haben wir Orokin die Menschheit doch behandelt, nicht wahr? Das Yuvan-Theater? Schöne Körper zur Schau gestellt, unsere neuen Identitäten nach Belieben gewählt, uns gegenseitig mit Spielen gequält, zu unserem kranken Vergnügen, wie es uns passte ...",shape=box,color=blue];
		1234 -> 1236;
	1233 [label="Es bricht mir das Herz, dass es nur für seine Verwüstung und Grausamkeit in Erinnerung bleiben wird. Ja, davon gab es viel, das will ich gar nicht bestreiten. ",shape=box,color=blue];
		1233 -> 1235;
	1236 [label="Ich hasse es. Ich hasse es so sehr.",shape=box,color=blue];
		1236 -> 1239;
		1236 -> 1240;
		1236 -> 1238;
	1235 [label="Aber es war auch zu solch einer Schönheit fähig. Zu solch einer Freude. Zu solch einer Liebe. Zu solch wissenschaftlichen und künstlerischen Fortschritten. Schau, was wir alles erreichen konnten!",shape=box,color=blue];
		1235 -> 1237;
	1239 [label="Obwohl ich dich nicht so verletzen wollte und es mir leid tut, dass ich es getan habe, ist es eine wertvolle Lektion, wenn du dadurch gelernt hast, wie es ist, auf der anderen Seite des Imperiums der Orokin zu stehen.",shape=box,color=red];
		1239 -> 1245;
	1240 [label="Ich wollte dich nie so verletzen. Du solltest dich nicht für die Art und Weise entschuldigen müssen, wie die Gesellschaft der Orokin funktionierte – du hast sie nicht aufgebaut. Du hast versucht, sie zu retten.",shape=box,color=red];
		1240 -> 1246;
	1238 [label="[Ende.]",shape=box,color=red];
		1238 -> 1244;
	1237 [label="Als Nitokh mich also zu sich rief und mir sagte, sie will alle Orokin auslöschen, stimmte ich sofort zu. Ich wollte der vergifteten Schlange den Kopf abschlagen. Ich wollte sie durch ein gütigeres System ersetzen. Einen gütigeren Herrscher.",shape=box,color=blue];
		1237 -> 1241;
		1237 -> 1242;
		1237 -> 1243;
	1245 [label="Add 3 to Thermostat",color=orange];
		1245 -> 1250;
	1246 [label="Add -3 to Thermostat",color=orange];
		1246 -> 1251;
	1244 [label="Chat ends.",color=orange];
	1241 [label="Du meinst, du wolltest die Herrscher und die Exekutoren durch dich selbst ersetzen.",shape=box,color=red];
		1241 -> 1247;
	1242 [label="Und wer sollte dieser Herrscher sein?",shape=box,color=red];
		1242 -> 1248;
	1243 [label="[Ende.]",shape=box,color=red];
		1243 -> 1249;
	1250 [label="Das Imperium der Orokin war nicht gänzlich böse. Es bricht mir das Herz, dass es nur für seine Verwüstung und Grausamkeit in Erinnerung bleiben wird. Ja, davon gab es viel, das will ich gar nicht bestreiten.",shape=box,color=blue];
		1250 -> 1253;
	1251 [label="Wenn die anderen es doch nur auch so gesehen hätten. Wenn Nitokh es doch nur so gesehen hätte.",shape=box,color=blue];
		1251 -> 1254;
	1247 [label="Ja, natürlich!",shape=box,color=blue];
		1247 -> 1252;
	1248 [label="Ich selbst, natürlich.",shape=box,color=blue];
		1248 -> 1252;
	1249 [label="Chat ends.",color=orange];
	1253 [label="Aber es war auch zu solch einer Schönheit fähig. Zu solch einer Freude. Zu solch einer Liebe. Zu solch wissenschaftlichen und künstlerischen Fortschritten. Schau, was wir alles erreichen konnten!",shape=box,color=blue];
		1253 -> 1256;
	1254 [label="Das Imperium der Orokin war nicht gänzlich böse. Es bricht mir das Herz, dass es nur für seine Verwüstung und Grausamkeit in Erinnerung bleiben wird. Ja, davon gab es viel, das will ich gar nicht bestreiten.",shape=box,color=blue];
		1254 -> 1253;
	1252 [label="Ich hätte dafür gesorgt, dass alle Exekutoren und Herrscher ... entfernt worden wären, und ich hätte die Rolle des Übergang-Exekutoren übernommen, bis ein neues System eingeführt worden wäre.",shape=box,color=blue];
		1252 -> 1255;
	1256 [label="Als Nitokh mich also zu sich rief und mir sagte, sie will alle Orokin auslöschen, stimmte ich sofort zu. Ich wollte der vergifteten Schlange den Kopf abschlagen. Ich wollte sie durch ein gütigeres System ersetzen. Einen gütigeren Herrscher.",shape=box,color=blue];
		1256 -> 1260;
		1256 -> 1261;
	1255 [label="Wie lange das gedauert hätte, weiß ich nicht, aber es wäre besser als das, was nach dem Großen Krieg folgte, nicht wahr?",shape=box,color=blue];
		1255 -> 1257;
		1255 -> 1258;
		1255 -> 1259;
	1260 [label="Du meinst, du wolltest die Herrscher und die Exekutoren durch dich selbst ersetzen.",shape=box,color=red];
		1260 -> 1265;
	1261 [label="Und wer sollte dieser Herrscher sein?",shape=box,color=red];
		1261 -> 1266;
	1257 [label="Großer Krieg?",shape=box,color=red];
		1257 -> 1262;
	1258 [label="Sei ehrlich zu dir selbst: Glaubst du, dass du jemals diese Macht abgegeben hättest?",shape=box,color=red];
		1258 -> 1263;
	1259 [label="Ich glaube nicht, dass du jemals auf die Macht verzichtet hättest, Roathe.",shape=box,color=red];
		1259 -> 1264;
	1265 [label="Ja, natürlich! Und tu nicht so, als hättest du das noch nie gehört, ich bin mir sicher, dass du es hast.",shape=box,color=blue];
		1265 -> 1270;
	1266 [label="Ich, natürlich. Und tu nicht so, als hättest du das noch nie gehört, ich bin mir sicher, dass du es hast.",shape=box,color=blue];
		1266 -> 1270;
	1262 [label="Du nennst das heute den \"Alten Krieg\". Für mich ist er kaum \"alt\", er fand meiner Erinnerung nach erst vor wenigen Jahren statt.",shape=box,color=blue];
		1262 -> 1267;
	1263 [label="Hm. Ich weiß es nicht. Es spielt ja jetzt keine Rolle mehr, oder? Aber damals war ich fest davon überzeugt, dass ich es getan hätte.",shape=box,color=blue];
		1263 -> 1268;
	1264 [label="+5 Chemistry",color=orange];
		1264 -> 1269;
	1270 [label="Ich hätte dafür gesorgt, dass alle Exekutoren und Herrscher ... entfernt worden wären, und ich hätte die Rolle des Übergang-Exekutoren übernommen, bis ein neues System eingeführt worden wäre.",shape=box,color=blue];
		1270 -> 1274;
	1267 [label="Zeitreisen sind schon seltsam.",shape=box,color=blue];
		1267 -> 1271;
	1268 [label="Ich habe mich so sehr bemüht, hierher zurückzukehren, nur um festzustellen, dass ... mein Volk nun tot ist. Ich wäre zusammen mit ihnen hingerichtet worden.",shape=box,color=blue];
		1268 -> 1272;
	1269 [label="Schweig.",shape=box,color=blue];
		1269 -> 1273;
	1274 [label="Wie lange das gedauert hätte, weiß ich nicht, aber es wäre besser als das, was nach dem Großen Krieg folgte, nicht wahr?",shape=box,color=blue];
		1274 -> 1258;
		1274 -> 1259;
		1274 -> 1257;
	1271 [label="In nur wenigen Jahren, in meiner Wahrnehmung, sind Tausende in der \"Realität\" vergangen – in denen das Imperium unterging und mein gesamtes Volk mit ihm. ",shape=box,color=blue];
		1271 -> 5775;
	1272 [label="Die Tenno hätten mich in der Nacht der Naga-Trommeln zusammen mit allen anderen abgeschlachtet. Ich wäre wahrscheinlich gestorben, im Versuch, Nitokhs Leben zu retten.",shape=box,color=blue];
		1272 -> 1275;
	1273 [label="Damals war ich fest davon überzeugt, dass ich es getan hätte. Aber jetzt spielt es kaum noch eine Rolle, oder?",shape=box,color=blue];
		1273 -> 1268;
	5775 [label="Mir ist klar geworden, dass es keine Rolle spielt, ob ich die Macht abgegeben hätte oder nicht, obwohl ich damals davon überzeugt war, dass ich es getan hätte.",shape=box,color=blue];
		5775 -> 1272;
	1275 [label="Ich frage mich, was aus ihr geworden ist? In den Aufzeichnungen wird ihr Name nicht einmal erwähnt ... all die Gräueltaten, die in ihrem Namen begangen wurden, all die Tode, all die Schrecken ... und ich bin scheinbar der Einzige, der davon weiß.",shape=box,color=blue];
		1275 -> 1276;
	1276 [label="Nun ja. Und was auch immer in Zukunft noch durch den Geist des Tenno durch diese Dunkle Spiegelung freigesetzt werden mag. Aber das ist wohl kaum mein Problem.",shape=box,color=blue];
		1276 -> 1277;
		1276 -> 1278;
		1276 -> 1279;
	1277 [label="Du scheinst etwas eingeschüchtert von dem Knirps zu sein.",shape=box,color=red];
		1277 -> 1280;
	1278 [label="Was ist zwischen dir und Nitokh vorgefallen?",shape=box,color=red];
		1278 -> 1281;
	1279 [label="Du hattest also vor, die Orokin zu verraten?",shape=box,color=red];
		1279 -> 1282;
	1280 [label="Ich sah zu, wie eine Schar schulpflichtiger, vom Void verheerter Kinder befallene Kriegsmaschinen fernsteuerte, die einst Soldaten gewesen waren und nun zu grotesken, schönen und mörderischen Kunstwerken umgestaltet worden sind, und ganze Bataillone von Soldaten vernichteten. ",shape=box,color=blue];
		1280 -> 1283;
	1281 [label="Alles.",shape=box,color=blue];
		1281 -> 1284;
	1282 [label="Ja. Wir beide. Obwohl ich glaube, dass Nitokh mich hintergehen wollte, und ich hatte das Gleiche mit Nitokh vor. Du weißt ja, wie das bei uns Orokin so ist.",shape=box,color=blue];
		1282 -> 1285;
	1283 [label="Ich habe erfahren, dass sie mein Imperium zerstört haben. Ein Imperium, das das gesamte Ursprungssystem beherrschte und im Begriff war, die Rebellion auf Tau auszulöschen.",shape=box,color=blue];
		1283 -> 1286;
	1284 [label="Alles geschah zwischen Nitokh und mir.",shape=box,color=blue];
		1284 -> 1287;
	1285 [label="Jeder schmiedet ständig Intrigen gegen jeden. Ganz normaler Wochentag, wirklich.",shape=box,color=blue];
		1285 -> 1288;
	1286 [label="Und sie haben es in einer Nacht geschafft.",shape=box,color=blue];
		1286 -> 1289;
	1287 [label="Alles und noch viel mehr.",shape=box,color=blue];
		1287 -> 1290;
	1288 [label="Verrat unter Orokin war an der Tagesordnung. Doch das gesamte Imperium zu verraten? Solch ein Verrat verdiente nicht nur die Hinrichtung durch Jade-Licht, sondern auch die Bestrafung durch das Cephalon-Programm.",shape=box,color=blue];
		1288 -> 1291;
	1289 [label="Wärst du nicht auch eingeschüchtert?!",shape=box,color=blue];
		1289 -> 1292;
	1290 [label="Und das ist alles, was ich im Augenblick zu diesem Thema sagen möchte.",shape=box,color=blue];
		1290 -> 1293;
	1291 [label="Update boolean RoatheTraitor1",color=orange];
		1291 -> 1294;
		1291 -> 1295;
	1292 [label="Ich kann nicht ausdrücken, was wir riskierten, als wir versuchten, die Exekutoren zu ermorden – geschweige denn alle Orokin, Usurpator.",shape=box,color=blue];
		1292 -> 1288;
	1293 [label="Update boolean RoatheExecutor1",color=orange];
		1293 -> 1292;
	1294 [label="Was davon ist deiner Meinung nach das Schlimmere?",shape=box,color=red];
		1294 -> 1296;
	1295 [label="Solche Machenschaften waren also nicht normal?",shape=box,color=red];
		1295 -> 1297;
	1296 [label="Nihils Cephalon-Programm, mit Abstand. Die Kreationen des Glasmachers sind ...",shape=box,color=blue];
		1296 -> 1298;
	1297 [label="Die Existenz des Imperiums der Orokin hing am seidenen Faden, Usurpator. Es balancierte stets am Rande des Abgrunds. Nur eines hielt es am Leben:",shape=box,color=blue];
		1297 -> 1299;
	1298 [label="Das Jade-Licht erledigt diejenigen schnell, die keine Rüstung oder Schilde besitzen, um einen einzigen Treffer zu überleben. Es ist ein gnädiger Tod.",shape=box,color=blue];
		1298 -> 1300;
	1299 [label="Gesellschaftliche Normen.",shape=box,color=blue];
		1299 -> 1301;
	1300 [label="Cephalons können schmerzlos und sogar nicht-destruktiv umgewandelt werden, wenn sie aus einem freiwilligen Subjekt entstehen. Wenn es jedoch ... eine Bestrafung ist?",shape=box,color=blue];
		1300 -> 1302;
	1301 [label="Man erhob sich nicht einfach und metzelte die Orokin nieder! Sowas tat man einfach nicht, Drifter! Undenkbar! Absolut unpassend!",shape=box,color=blue];
		1301 -> 1303;
	1302 [label="Erinnerungen sind den Orokin heilig, Drifter. Letztendlich sind sie alles, was wir sind. Unsere Körper sind vergänglich. Unsere Gesichter, unsere Stimmen, unser Blut – alles veränderlich. Alles kann wie Mode gewechselt werden.",shape=box,color=blue];
		1302 -> 1304;
	1303 [label="Was es am Ende auch lächerlich einfach machte. Wie dein Tenno-Doppelgänger sicher festgestellt hat. ",shape=box,color=blue];
		1303 -> 1305;
		1303 -> 1306;
	1304 [label="Check boolean RoatheKnowsReset2",color=orange];
		1304 -> 1307 [label=true,color=green];
		1304 -> 1305 [label=false,color=brown];
		1304 -> 1306 [label=false,color=brown];
	1305 [label="Aber du bist offensichtlich nie weit genug gekommen, um es überhaupt zu versuchen.",shape=box,color=red];
		1305 -> 1308;
	1306 [label="Was ist aus deinem Plan geworden?",shape=box,color=red];
		1306 -> 1309;
	1307 [label="Was im Übrigen wahrscheinlich der Grund dafür ist, dass ich so zutiefst und absolut gereizt darüber bin, weil du mit ihnen herumspielst.",shape=box,color=blue];
		1307 -> 1305;
		1307 -> 1306;
	1308 [label="Evaluate expressions on HellStory",color=orange];
		1308 -> 1310 [label="x >= 21",color=purple];
		1308 -> 1311 [label="x < 21",color=purple];
		1308 -> 1311 [label="false",color=purple];
	1309 [label="Evaluate expressions on HellStory",color=orange];
		1309 -> 1312 [label="x >= 21",color=purple];
		1309 -> 5777 [label="x < 21",color=purple];
		1309 -> 5777 [label="false",color=purple];
	1310 [label="Du hast völlig recht! Albrecht traf mich in jenem Flur, bevor Nitokh und ich Zeit hatten, unsere Falle für die Exekutoren zuschnappen zu lassen.",shape=box,color=blue];
		1310 -> 1313;
	1311 [label="Nein, ganz offensichtlich nicht. Ich wurde von Albrecht gewaltsam in dieses ... Ding verwandelt, bevor Nitokh und ich Zeit hatten, unsere Falle für die Exekutoren zuschnappen zu lassen.",shape=box,color=blue];
		1311 -> 1314;
	1312 [label="Du weißt recht genau, was mit unserem Plan passiert ist, nicht wahr?! Albrecht traf mich in jenem Flur, bevor Nitokh und ich Zeit hatten, unsere Falle für die Exekutoren zuschnappen zu lassen.",shape=box,color=blue];
		1312 -> 1315;
	5777 [label="Ich wurde von Albrecht gewaltsam in dieses ... Ding verwandelt, bevor Nitokh und ich Zeit hatten, unsere Falle für die Exekutoren zuschnappen zu lassen.",shape=box,color=blue];
		5777 -> 1314;
	1313 [label="Und bot mir das Protoframe-Serum an. Und ... nun ja ... wir beide wissen, was dann geschah.",shape=box,color=blue];
		1313 -> 1316;
	1314 [label="Im einen Moment stand ich in einem prächtigen goldenen Flur, im nächsten schrie ich vor Schmerzen in irgendeinem abgelegenen Drecksloch in \"Gallien\".",shape=box,color=blue];
		1314 -> 1317;
	1315 [label="Er bot mir das Protoframe-Serum an. Und ... nun ja ... wir beide wissen, was dann geschah!",shape=box,color=blue];
		1315 -> 1316;
	1316 [label="Eine Sache, wegen der ich immer noch auf mich selbst wütend bin. Warum?! Warum habe ich dir das anvertraut?! Woher weißt du das?!",shape=box,color=blue];
		1316 -> 1318;
	1317 [label="Nitokh muss den Plan aufgegeben haben, nachdem ich verschwunden war. Wahrscheinlich hat sie mir, als Sündenbock, die ganze Affäre mit dem Hochverrat in die Schuhe geschoben.",shape=box,color=blue];
		1317 -> 1319;
	1318 [label="Pff! Nein. Egal. Ich gehe jetzt, bevor ich diesen verdammten Computer in einem Wutanfall zerlege.",shape=box,color=blue];
		1318 -> 1320;
	1319 [label="Das erklärt all die Aufzeichnungen, in denen ich als \"Feigling\" bezeichnet werde. Natürlich hielten sie mich für einen Feigling – sie dachten ja, ich bin geflohen! Pah.",shape=box,color=blue];
		1319 -> 1321;
	1320 [label="+10 Chemistry",color=orange];
		1320 -> 1322;
	1321 [label="+10 Chemistry",color=orange];
		1321 -> 1323;
	1322 [label="Chat ends.",color=orange];
	1323 [label="Es ist schön zu wissen, dass ich für den Plan so entscheidend war, dass er nach meinem Verschwinden komplett verworfen werden musste.",shape=box,color=blue];
		1323 -> 1324;
		1323 -> 1325;
	1324 [label="Ich bin mir nicht sicher, ob das die richtige Schlussfolgerung aus dieser Geschichte ist.",shape=box,color=red];
		1324 -> 1326;
	1325 [label="Es ist schön, das Gefühl zu haben, gebraucht zu werden.",shape=box,color=red];
		1325 -> 1327;
	1326 [label="Add 1 to Thermostat",color=orange];
		1326 -> 1328;
	1327 [label="+5 Chemistry",color=orange];
		1327 -> 1329;
	1328 [label="Finde deinen Wert, wo du willst, Drifter, und lass mich meinen finden.",shape=box,color=blue];
		1328 -> 1330;
	1329 [label="Add -1 to Thermostat",color=orange];
		1329 -> 1331;
	1330 [label="Chat ends.",color=orange];
	1331 [label="Siehst du? Du verstehst.",shape=box,color=blue];
		1331 -> 1332;
	1332 [label="Chat ends.",color=orange];
}