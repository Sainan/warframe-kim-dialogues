digraph {
	3120 [label="RoatheRank4Convo8 begins.",color=orange];
		3120 -> 3121;
		3120 -> 3122;
	3121 [label="Wie war deine Kindheit, Roathe?",shape=box,color=red];
		3121 -> 3123;
	3122 [label="[Ende.]",shape=box,color=red];
		3122 -> 3124;
	3123 [label="Hm? Eine interessante Frage. \"Wie\" war sie? Ich kann mich wirklich nicht an viel erinnern. Und die Sterne und Skulpturen, welche diese Erinnerungen enthielten, sind vermutlich längst zu Staub zerfallen oder wurden in Endo verwandelt.",shape=box,color=blue];
		3123 -> 3125;
	3124 [label="Chat ends.",color=orange];
	3125 [label="Ich fürchte, ich kann mich nur noch vage erinnern, es war vor so langer Zeit. Bei vielem davon frage ich mich, ob ich es mir nicht einbilde, wie in einem Traum oder als wären es Ereignisse, die ich in einem Geschichtsbuch gelesen habe.",shape=box,color=blue];
		3125 -> 3126;
	3126 [label="Woran ich mich also erinnern kann, ist wahrscheinlich sehr unzuverlässig. Warum fragst du?",shape=box,color=blue];
		3126 -> 3127;
		3126 -> 3128;
		3126 -> 3129;
	3127 [label="Auch wenn die Geschichten falsch sind, sind sie doch, was man sich über seine prägenden Jahre erzählt. Es lohnt sich trotzdem, sie zu kennen.",shape=box,color=red];
		3127 -> 3130;
	3128 [label="Ich frage mich, wie es war, als Adliger der Orokin aufzuwachsen.",shape=box,color=red];
		3128 -> 3131;
	3129 [label="Ich frage mich, was dich zu \"dir\" gemacht hat. Wie du so geworden bist.",shape=box,color=red];
		3129 -> 3132;
	3130 [label="+5 Chemistry",color=orange];
		3130 -> 3133;
	3131 [label="Wie alle Orokin Jugendlichen, die für Großes bestimmt waren, wurde ich schon in jungen Jahren an einen Ort geschickt, den die Fanatiker als \"Internat\" bezeichnet hätten. Dort wurde ich auf meine Neigungen und Begabungen getestet und trainiert.",shape=box,color=blue];
		3131 -> 3134;
		3131 -> 3135;
	3132 [label="+5 Chemistry",color=orange];
		3132 -> 3136;
	3133 [label="Ich stimme zu, dass die Lügen, die wir uns selbst erzählen, oft wichtiger sind, als die Wahrheit. Eine wunderbare Erkenntnis, Usurpator.",shape=box,color=blue];
		3133 -> 3137;
	3134 [label="Deine Eltern haben dich einfach weggeschickt? Für wie lange?",shape=box,color=red];
		3134 -> 3138;
	3135 [label="Wie war es dort?",shape=box,color=red];
		3135 -> 3139;
	3136 [label="Du versuchst herauszufinden, wo ich \"falsch\" abgebogen bin? Verstehe! Wie amüsant. Ich weiß nicht, ob du viel in meiner Kindheit findest, dass dir die gesuchte Antwort liefern wird.",shape=box,color=blue];
		3136 -> 3140;
	3137 [label="Add -1 to Thermostat",color=orange];
		3137 -> 3131;
	3138 [label="Mein gesamtes junges Leben. Ich glaube, ich sah meine Erzeuger nie wieder. Vielleicht bei der Zeremonie, als ich als Jahrgangsbester verkündet wurde?",shape=box,color=blue];
		3138 -> 3141;
	3139 [label="Ich denke, die Antwort würde stark davon abhängen, wen du fragst. Als ich ankam, waren die Prügel, die ich von den älteren Jungen erhielt, schnell und ihre Lektionen äußerst effektiv.",shape=box,color=blue];
		3139 -> 3142;
	3140 [label="Add 1 to Thermostat",color=orange];
		3140 -> 3131;
	3141 [label="Ich glaube, das war das erste Mal, dass sie es für angebracht hielten, Anspruch für mich zu erheben. Ich denke nicht viel darüber nach.",shape=box,color=blue];
		3141 -> 3143;
	3142 [label="Aber ich habe schon immer schnell gelernt. Und ich lernte, dass ich, wenn ich mich in diesem speziellen Bereich der Archimeden hervortun wollte, ich am besten kreative Techniken anwendete, um nicht mit den Schlechtesten unterzugehen.",shape=box,color=blue];
		3142 -> 3144;
		3142 -> 3145;
	3143 [label="Ich erinnere mich kaum an meine Eltern. Während einige Orokin ihre Nachkommen gerne selbst aufzogen, waren meine nicht so. Sie wollten mich gerne loswerden und ihr eigenes Leben weiterleben.",shape=box,color=blue];
		3143 -> 3146;
		3143 -> 3147;
	3144 [label="Die Achimeden ließen dies geschehen?",shape=box,color=red];
		3144 -> 3148;
	3145 [label="Das ist ... entsetzlich.",shape=box,color=red];
		3145 -> 3149;
	3146 [label="Es scheint dich im Leben nicht behindert zu haben.",shape=box,color=red];
		3146 -> 3150;
	3147 [label="Tut mir leid. Scheint eine traurige Art und Weise zu sein.",shape=box,color=red];
		3147 -> 3150;
	3148 [label="Mein armer Usurpator. Es war der Internatsleiter selbst, der eine Flasche Kuva und einen Dienerjungen mitbrachte, als die Dinge eines Abends für einen der neuen Initianten zu weit gingen.",shape=box,color=blue];
		3148 -> 3151;
	3149 [label="Tradition ist ein mächtiges Werkzeug, Usurpator. Ein mächtiges und gefährliches Werkzeug, dass man dazu nutzen kann, vernünftige Menschen in irren Denkweisen gefangenzuhalten.",shape=box,color=blue];
		3149 -> 3152;
	3150 [label="Ganz im Gegenteil. Durch fehlende familiäre Bindungen hatte ich mehr Zeit, mich militaristischen Strategien zu widmen, die für meine Artgenossen archaisch und antiquiert waren.",shape=box,color=blue];
		3150 -> 3153;
	3151 [label="Tradition ist ein mächtiges Werkzeug. Ein mächtiges und gefährliches Werkzeug, dass man dazu nutzen kann, vernünftige Menschen in irren Denkweisen gefangen zu halten.",shape=box,color=blue];
		3151 -> 3154;
		3151 -> 3155;
	3152 [label="Es war der Internatsleiter selbst, der eine Flasche Kuva und einen Dienerjungen mitbrachte, als die Dinge eines Abends für einen der neuen Initianten zu weit gingen.",shape=box,color=blue];
		3152 -> 3154;
		3152 -> 3155;
	3153 [label="Sie ahnten damals noch nicht, wie sehr mir das in der Zukunft helfen würde.",shape=box,color=blue];
		3153 -> 3156;
		3153 -> 3157;
	3154 [label="Was war mit deinen Eltern?",shape=box,color=red];
		3154 -> 3143;
	3155 [label="Hattest du dort irgendwelche Freunde?",shape=box,color=red];
		3155 -> 3158;
	3156 [label="Denkst du, dass es das alles wert war?",shape=box,color=red];
		3156 -> 3159;
	3157 [label="Es klingt, als hättest du ein sehr einsames Leben gehabt.",shape=box,color=red];
		3157 -> 3160;
	3158 [label="Nein, ich blieb für mich. Ich lernte, dass Angst bei anderen leicht zu erzeugen und nutzen ist, aber es ist wie eine sehr dünne, zerbrechliche Eisschicht, die bei Kontakt mit Licht schmilzt.",shape=box,color=blue];
		3158 -> 3161;
	3159 [label="Sie ahnten damals noch nicht, wie sehr mir meine Studien in der Zukunft helfen würde. Aber wenn du nach Gewinn oder Verlust fragst?",shape=box,color=blue];
		3159 -> 3162;
	3160 [label="Ja, das habe ich. Aber so ist es nun mal, wenn man das Leben eines Teufels führt, nicht wahr? Aber schon damals sah man mich als machtlosen Stellvertreter und als Konkubine oder als blutrünstigen Kriegsherrn und wütendes Monster.",shape=box,color=blue];
		3160 -> 3163;
	3161 [label="Monster muss man im Dunkeln halten. Und wenn ich eine Aura der Gefahr um mich erhalten wollte, musste ich alleine bleiben.",shape=box,color=blue];
		3161 -> 3146;
		3161 -> 3147;
	3162 [label="Hm, ich weiß es nicht.",shape=box,color=blue];
		3162 -> 3164;
		3162 -> 3165;
	3163 [label="Ich war weder über noch unter meinem Stand willkommen. Und ich hatte keine Gleichgestellten.",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="Du hast eine weitere Chance, das wiedergutzumachen, was du getan hast. Sie nicht.",shape=box,color=red];
		3164 -> 3167;
	3165 [label="Tja, immerhin sind sie tot und du nicht. Also haben sie wohl geholfen.",shape=box,color=red];
		3165 -> 3168;
	3166 [label="Update boolean RoatheUnloved2",color=orange];
		3166 -> 3169;
		3166 -> 3170;
	3167 [label="Add 1 to Thermostat",color=orange];
		3167 -> 3171;
	3168 [label="Add -1 to Thermostat",color=orange];
		3168 -> 3171;
	3169 [label="Du hast eine weitere Chance, das wiedergutzumachen, was du getan hast. Sie nicht.",shape=box,color=red];
		3169 -> 3172;
	3170 [label="Immerhin hast du den Rest deiner Zukunft, um zu entscheiden, wie du sie leben willst. Das haben sie nicht.",shape=box,color=red];
		3170 -> 3173;
	3171 [label="+5 Chemistry",color=orange];
		3171 -> 3174;
	3172 [label="Add 1 to Thermostat",color=orange];
		3172 -> 3171;
	3173 [label="Add -1 to Thermostat",color=orange];
		3173 -> 3171;
	3174 [label="Das werden wir dann sehen, nicht wahr?",shape=box,color=blue];
		3174 -> 3175;
	3175 [label="Chat ends.",color=orange];
}