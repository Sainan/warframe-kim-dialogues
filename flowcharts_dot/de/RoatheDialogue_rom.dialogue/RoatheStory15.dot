	j254513730 [label="SN: LÜGEN",shape=box,color=blue];
		j254513730 -> j1104097912;
	j1104097912 [label="Transkript: Ich beherrschte viele unserer Waffen mühelos, doch im Umgang mit einer war ich unübertroffen: Der Lüge.",shape=box,color=blue];
		j1104097912 -> j3966818378;
	j3966818378 [label="Am häufigsten wandte ich sie gegen meine eigenen Truppen an. Ich peitschte sie bis aufs Mark mit Lügen über Pflicht und Disziplin.",shape=box,color=blue];
		j3966818378 -> j3741892180;
	j3741892180 [label="Ich erstickte sie mit der Lüge, der Krieg sei zu gewinnen. Durchbohrte sie mit der Lüge meiner Gunst, meiner angeblichen Hochachtung.",shape=box,color=blue];
		j3741892180 -> j169145964;
	j169145964 [label="Allein, im Verborgenen, richtete ich diese Waffe gegen mich selbst. Oh, wie ich blutete.",shape=box,color=blue];
		j169145964 -> j1648694156;
	j1648694156 [label="Add 1 to HellStory counter",color=orange];
		j1648694156 -> "Chat ends. Next chat will be RoatheStory16.";
