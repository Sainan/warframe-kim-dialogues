		5404 -> 5406 [label=false,color=brown];
	5799 [label="Check boolean RoathePolyamorySuccess",color=orange];
		5799 -> 5404 [label=true,color=green];
		5799 -> 5405 [label=false,color=brown];
	5408 [label="Chat ends.",color=orange];
	5407 [label="Hey Roathe? Hast du kurz Zeit? [Einwilligung für mehrerer Partner einholen.]",shape=box,color=red];
		5407 -> 5410;
	5406 [label="[Ende.]",shape=box,color=red];
		5406 -> 5409;
	5405 [label="Chat ends.",color=orange];
	5410 [label="Hm? Um was geht's, Schatz?",shape=box,color=blue];
		5410 -> 5412;
	5409 [label="Update boolean RoatheConsentComplete",color=orange];
		5409 -> 5411;
	5412 [label="Ich möchte mit dir über etwas sprechen und möchte sichergehen, dass es für dich in Ordnung ist.",shape=box,color=red];
		5412 -> 5413;
	5411 [label="Chat ends.",color=orange];
	5413 [label="Mir ist es wichtig, dass du nicht das Gefühl hast, ich lüge dich an oder bin dir gegenüber unehrlich.",shape=box,color=red];
		5413 -> 5414;
	5414 [label="Sprich weiter. Das klingt, als ob es richtig spannend werden wird.",shape=box,color=blue];
		5414 -> 5415;
	5415 [label="Ich möchte dich nicht in eine Situation bringen, mit der du nicht einverstanden bist. Wenn du also Nein sagst, ist das völlig in Ordnung. Das wollte ich dir nur sagen.",shape=box,color=red];
		5415 -> 5416;
	5416 [label="Was wir haben, ist mir wichtig – sehr wichtig – und es ist real. Ich möchte nicht, dass du daran zweifelst.",shape=box,color=red];
		5416 -> 5417;
	5417 [label="Moment. Beim Void. Versuchst du mir gerade vorsichtig beibringen, dass du noch einen weiteren Partner hast?",shape=box,color=blue];
		5417 -> 5418;
	5418 [label="Für was für einen Narren hältst du mich eigentlich? Das weiß ich bereits, Drifter-Schatzi!",shape=box,color=blue];
		5418 -> 5419;
		5418 -> 5420;
	5419 [label="Daraus schließe ich, dass es dir nichts ausmacht?",shape=box,color=red];
		5419 -> 5421;
	5420 [label="Du ... weißt es?",shape=box,color=red];
		5420 -> 5422;
	5421 [label="Wenn du mich doch nur jetzt im Sanctum lachen hören könntest. Drifter, Schatzi. Lieber, süßer Drifter. Ich bin Orokin. Natürlich macht mir das nichts aus.",shape=box,color=blue];
		5421 -> 5423;
	5422 [label="Wenn du mich doch nur jetzt im Sanctum lachen hören könntest. Drifter, Schatzi. Lieber, süßer Drifter.",shape=box,color=blue];
		5422 -> 5424;
	5423 [label="Denk über meine Art und unsere Vorliebe dafür, die Gesellschaft anderer zu genießen, wie du willst - auch wenn du es vielleicht als herablassend oder abwertend empfindest. Wir verstanden dennoch, was es heißt, zu lieben.",shape=box,color=blue];
		5423 -> 5425;
	5424 [label="Ich wusste es in dem Moment, als es passierte. Ich habe meine Methoden. Und nein, es stört mich kein bisschen. Ich bin Orokin.",shape=box,color=blue];
		5424 -> 5423;
	5425 [label="Niemand verstand die Liebe so gut wie die Orokin. Und wir wussten, dass im Herzen Platz für mehr als eine Person sein konnte.",shape=box,color=blue];
		5425 -> 5426;
	5426 [label="Ich bin lediglich enttäuscht, dass die Eiferer wahrscheinlich zu engstirnig sind, um mitzumachen.",shape=box,color=blue];
		5426 -> 5427;
	5427 [label="Pah. Bei näherer Betrachtung ist das wahrscheinlich das Beste. Kannst du dir den Blödsinn vorstellen, den das verursachen würde?",shape=box,color=blue];
		5427 -> 5428;
	5428 [label="Update boolean RoatheConsentComplete",color=orange];
		5428 -> 5429;
	5429 [label="Nun ja, wie dem auch sei. Wenn dich die andere Person glücklich macht, dann genieße das. Aber denk daran, wenn du mit mir zusammen bist?",shape=box,color=blue];
		5429 -> 5430;
	5430 [label="+5 Chemistry",color=orange];
		5430 -> 5431;
	5431 [label="Dann gehörst du mir und nur mir allein.",shape=box,color=blue];
		5431 -> 5432;
	5432 [label="Chat ends.",color=orange];
}