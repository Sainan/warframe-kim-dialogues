		j4082858284 -> j511900548 [label=true,color=green];
		j4082858284 -> "Chat ends." [label=false,color=brown];
	j164703716 [label="Hey Roathe? Hast du kurz Zeit? [Einwilligung für mehrerer Partner einholen.]",shape=box,color=red];
		j164703716 -> j21225457;
	j1999221639 [label="[Ende.]",shape=box,color=red];
		j1999221639 -> j604242687;
	j21225457 [label="Hm? Um was geht's, Schatz?",shape=box,color=blue];
		j21225457 -> j619861896;
	j604242687 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j604242687 -> "Chat ends.";
	j619861896 [label="Ich möchte mit dir über etwas sprechen und möchte sichergehen, dass es für dich in Ordnung ist.",shape=box,color=red];
		j619861896 -> j3844661357;
	j3844661357 [label="Mir ist es wichtig, dass du nicht das Gefühl hast, ich lüge dich an oder bin dir gegenüber unehrlich.",shape=box,color=red];
		j3844661357 -> j2825877213;
	j2825877213 [label="Sprich weiter. Das klingt, als ob es richtig spannend werden wird.",shape=box,color=blue];
		j2825877213 -> j848912474;
	j848912474 [label="Ich möchte dich nicht in eine Situation bringen, mit der du nicht einverstanden bist. Wenn du also Nein sagst, ist das völlig in Ordnung. Das wollte ich dir nur sagen.",shape=box,color=red];
		j848912474 -> j2201242752;
	j2201242752 [label="Was wir haben, ist mir wichtig – sehr wichtig – und es ist real. Ich möchte nicht, dass du daran zweifelst.",shape=box,color=red];
		j2201242752 -> j3682773777;
	j3682773777 [label="Moment. Beim Void. Versuchst du mir gerade vorsichtig beibringen, dass du noch einen weiteren Partner hast?",shape=box,color=blue];
		j3682773777 -> j2007278366;
	j2007278366 [label="Für was für einen Narren hältst du mich eigentlich? Das weiß ich bereits, Drifter-Schatzi!",shape=box,color=blue];
		j2007278366 -> j825136076;
		j2007278366 -> j3180357375;
	j825136076 [label="Daraus schließe ich, dass es dir nichts ausmacht?",shape=box,color=red];
		j825136076 -> j3708611490;
	j3180357375 [label="Du ... weißt es?",shape=box,color=red];
		j3180357375 -> j4070311959;
	j3708611490 [label="Wenn du mich doch nur jetzt im Sanctum lachen hören könntest. Drifter, Schatzi. Lieber, süßer Drifter. Ich bin Orokin. Natürlich macht mir das nichts aus.",shape=box,color=blue];
		j3708611490 -> j4036344248;
	j4070311959 [label="Wenn du mich doch nur jetzt im Sanctum lachen hören könntest. Drifter, Schatzi. Lieber, süßer Drifter.",shape=box,color=blue];
		j4070311959 -> j4072820413;
	j4036344248 [label="Denk über meine Art und unsere Vorliebe dafür, die Gesellschaft anderer zu genießen, wie du willst - auch wenn du es vielleicht als herablassend oder abwertend empfindest. Wir verstanden dennoch, was es heißt, zu lieben.",shape=box,color=blue];
		j4036344248 -> j55588706;
	j4072820413 [label="Ich wusste es in dem Moment, als es passierte. Ich habe meine Methoden. Und nein, es stört mich kein bisschen. Ich bin Orokin.",shape=box,color=blue];
		j4072820413 -> j4036344248;
	j55588706 [label="Niemand verstand die Liebe so gut wie die Orokin. Und wir wussten, dass im Herzen Platz für mehr als eine Person sein konnte.",shape=box,color=blue];
		j55588706 -> j4022254353;
	j4022254353 [label="Ich bin lediglich enttäuscht, dass die Eiferer wahrscheinlich zu engstirnig sind, um mitzumachen.",shape=box,color=blue];
		j4022254353 -> j446956430;
	j446956430 [label="Pah. Bei näherer Betrachtung ist das wahrscheinlich das Beste. Kannst du dir den Blödsinn vorstellen, den das verursachen würde?",shape=box,color=blue];
		j446956430 -> j1799103221;
	j1799103221 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j1799103221 -> j1483719280;
	j1483719280 [label="Nun ja, wie dem auch sei. Wenn dich die andere Person glücklich macht, dann genieße das. Aber denk daran, wenn du mit mir zusammen bist?",shape=box,color=blue];
		j1483719280 -> j3586926806;
	j3586926806 [label="+5 Chemistry",color=orange];
		j3586926806 -> j2832882129;
	j2832882129 [label="Dann gehörst du mir und nur mir allein.",shape=box,color=blue];
		j2832882129 -> "Chat ends.";
}