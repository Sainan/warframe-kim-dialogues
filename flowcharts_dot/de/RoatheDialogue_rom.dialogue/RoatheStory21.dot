	j2572543075 [label="SN: VERGESSEN",shape=box,color=blue];
		j2572543075 -> j2598136895;
	j2598136895 [label="Transkript: Feigling.",shape=box,color=blue];
		j2598136895 -> j3111563355;
	j3111563355 [label="So nannten sie mich, nicht wahr? Ich habe die Geschichtsbücher gelesen, die in dieser staubigen Halle verstreut liegen. Eine Lüge. Sie kannten die Wahrheit nicht. Dass ich aus meiner Zeit gerissen wurde, bevor ich mein Werk vollenden konnte.",shape=box,color=blue];
		j3111563355 -> j442419748;
	j442419748 [label="Feigling.",shape=box,color=blue];
		j442419748 -> j248444329;
	j248444329 [label="Jetzt erinnere ich mich. Er näherte sich mir in den Goldenen Hallen. Ein mir unbekanntes Gesicht. Aber das ist nicht so ungewöhnlich für unseresgleichen. Ich kannte seine Stimme. Ich kannte seine Bewegungen.",shape=box,color=blue];
		j248444329 -> j1747742349;
	j1747742349 [label="Feigling!",shape=box,color=blue];
		j1747742349 -> j1910191859;
	j1910191859 [label="Er stellte mir eine einzige Frage. Glaubte ich wirklich, dass mir jemals vergeben werden könnte, dass ich alles in Asche gelegt hatte?",shape=box,color=blue];
		j1910191859 -> j3521627205;
	j3521627205 [label="FEIGLING!",shape=box,color=blue];
		j3521627205 -> j538069415;
	j538069415 [label="In dieser blassen, ausgestreckten Hand ... eine Spritze. Glitzernd vor Freiheit ... vor einer neuen Chance ... vor einem neuen Leben.",shape=box,color=blue];
		j538069415 -> j2303908104;
	j2303908104 [label="Ich nahm sie.",shape=box,color=blue];
		j2303908104 -> j118609308;
	j118609308 [label="FEIGLING!",shape=box,color=blue];
		j118609308 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}