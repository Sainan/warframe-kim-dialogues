	"Chat ends." [color=orange];
	j3512781372 [label="Du Narr! Was hast du getan?! Warum, warum bist du in Höhlen vorgedrungen, in denen du nicht willkommen bist?!",shape=box,color=blue];
		j3512781372 -> j603902782;
	j603902782 [label="Boolean RoatheFailNot21 is now false.",color=orange];
		j603902782 -> j2226690408;
	j2226690408 [label="Ich verlange, dass du das in Ordnung bringst. Das ist deine Schuld. Ich spüre es, wie es an mir zerrt, mich zerreißt. Wie ein riesiges Ungeheuer.",shape=box,color=blue];
		j2226690408 -> j1961444305;
	j1961444305 [label="Befreie mich davon. Befreie mich von dieser Plage. Lösche meine Erinnerungen. Ich weiß, du kannst es. Nutze deine Gabe und beende alles. Sofort.",shape=box,color=blue];
		j1961444305 -> j2362542841;
		j1961444305 -> j2716901831;
		j1961444305 -> j1883615037;
	j2362542841 [label="Bist du dir sicher? Aber ... du bist clever, ich habe den Eindruck du wirst merken, dass etwas nicht stimmt.",shape=box,color=red];
		j2362542841 -> j3217741422;
	j2716901831 [label="Das ist eine andere Art von Erinnerungen, Roathe. Das funktioniert bei denen nicht. Sie sind tiefer in deiner Psyche vergraben.",shape=box,color=red];
		j2716901831 -> j1380043379;
	j1883615037 [label="Vor der Wahrheit wegzulaufen und sich zu verstecken, bringt nichts. Wir landen am Ende genau da, wo wir angefangen haben.",shape=box,color=red];
		j1883615037 -> j1872005249;
	j3217741422 [label="Sehr wahrscheinlich. Ich werde Zwei und Zwei zusammenzählen und dich dafür verantwortlich machen, etwas getan zu haben, worum ich dich nicht gebeten habe. Ich bin sicher, du wirst das überleben.",shape=box,color=blue];
		j3217741422 -> j1134503321;
	j1380043379 [label="Das mag sein. Du hast wahrscheinlich recht. Aber ich habe im Moment keine anderen Möglichkeiten, oder? Es ist einen Versuch wert.",shape=box,color=blue];
		j1380043379 -> j1134503321;
	j1872005249 [label="Und wenn das der Fall ist, dann kannst du es einfach wiederholen. Es ist, als hättest du eine unerschöpfliche Gabe, nicht wahr?",shape=box,color=blue];
		j1872005249 -> j1134503321;
	j1134503321 [label="Ich bin mir sicher, ich werde furchtbar wütend auf dich sein, sobald ich merke, dass du meine Erinnerungen verändert hast. Und ich rate dir, mir nicht zu sagen, dass es auf meinen Wunsch geschah, Schatz.",shape=box,color=blue];
		j1134503321 -> j3524718900;
	j3524718900 [label="Ich werde einfach behaupten, dass du lügst, und das wird meine Meinung über dich wahrscheinlich irreparabel schädigen.",shape=box,color=blue];
		j3524718900 -> j1716104940;
		j3524718900 -> j1111700262;
	j1716104940 [label="Nein. Ich mache das nicht. Ich werde das nicht tun. Wir müssen diese Situation gemeinsam bewältigen. Können wir nicht einfach darüber reden?",shape=box,color=red];
		j1716104940 -> j60415274;
	j1111700262 [label="Ich ... gibt es wirklich keinen anderen Weg?",shape=box,color=red];
		j1111700262 -> j60415274;
	j60415274 [label="Nein. Soll der Butler nach oben gehen? Dann lösche diesen ganzen Unsinn aus meinem Geist, wie ich es verlangt habe. Ist es dir egal? Dann mach, was du willst. Es kümmert mich nicht.",shape=box,color=blue];
		j60415274 -> j1551828374;
	j1551828374 [label="Das, und natürlich unsere persönliche Freundschaft, ist mein einziges Druckmittel in dieser Situation. So einfach ist das.",shape=box,color=blue];
		j1551828374 -> j2099001967;
	j2099001967 [label="Was sagst du?",shape=box,color=blue];
		j2099001967 -> j214863438;
		j2099001967 -> j494807927;
	j214863438 [label="Okay. Ich ... ich werde es tun. Ich werde dein Gedächtnis löschen. Selbst wenn es Maries und Lyons Erinnerungen mit sich reißt.",shape=box,color=red];
		j214863438 -> j3706789869;
	j494807927 [label="Nein, ich weigere mich, tut mir leid. Wir müssen uns dem stellen.",shape=box,color=red];
		j494807927 -> j2547160344;
		j494807927 -> j2450068201;
	j3706789869 [label="+10 Chemistry",color=orange];
		j3706789869 -> j3479594825;
	j2547160344 [label="Lass uns das in Ruhe besprechen.",shape=box,color=red];
		j2547160344 -> j3564009144;
	j2450068201 [label="Hass mich, wenn du willst. Aber ich werde nichts unternehmen, bis wir das hier zuerst gelöst haben.",shape=box,color=red];
		j2450068201 -> j1717115896;
	j3479594825 [label="Gut. Leg los.",shape=box,color=blue];
		j3479594825 -> j4072107213;
	j3564009144 [label="Wage es nicht – wage es nicht, mir zu sagen \"mich zu beruhigen\"! Glaubst du nicht, ich hätte jedes Recht, mich innerlich zerrissen zu fühlen?!",shape=box,color=blue];
		j3564009144 -> j1051973624;
	j1717115896 [label="Faszinierend. Faszinierend und unerwartet. Erkläre das.",shape=box,color=blue];
		j1717115896 -> j1473639839;
		j1717115896 -> j1398772950;
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j1051973624 [label="Ich fühle mich, als ob mein Selbstverständnis, mein gesamtes Fundament, wie die verfluchte Lua selbst zerbrochen und aufgerissen worden wäre! Neu geschrieben mit Tinte, die verläuft. Feigling!",shape=box,color=blue];
		j1051973624 -> j3600065565;
	j1473639839 [label="Ich tat, was ich tat, weil es notwendig war. Du konntest dich nicht länger davor verstecken.",shape=box,color=red];
		j1473639839 -> j1830055178;
	j1398772950 [label="Denk von mir, was du willst. Aber ich erkenne eine Spirale, wenn ich eine sehe.",shape=box,color=red];
		j1398772950 -> j3232217275;
	j302033967 [label="Boolean RoatheWillReset is now true.",color=orange];
		j302033967 -> "Chat ends.";
	j3600065565 [label="Und du wagst es, mir zu sagen, ich solle mich \"beruhigen\"?!",shape=box,color=blue];
		j3600065565 -> j1830055178;
	j1830055178 [label="Evaluate expressions",color=orange];
		j1830055178 -> j2439764149 [label="RoatheForgivenessShortcut",color=purple];
		j1830055178 -> j759391385 [label="RoatheVillainyShortcut",color=purple];
		j1830055178 -> j2318547072 [label="false",color=purple];
	j3232217275 [label="Ja, ich denke, du bist ein wahrer \"Kenner\" solcher Dinge, nicht wahr? Sprich weiter.",shape=box,color=blue];
		j3232217275 -> j3355215178;
		j3232217275 -> j1652258060;
	j2439764149 [label="Wut löst keine Probleme, Roathe. Du bist wütend, weil du Angst hast, dich dem zu stellen, was du getan hast. Und dem, was aus dir geworden ist.",shape=box,color=red];
		j2439764149 -> j2313322476;
	j759391385 [label="Gut. Sei wütend. Aber nutze diese Wut für etwas Sinnvolles. Nutze sie, um all den Hass in dir abzuschütteln, den du in die falsche Richtung richtest.",shape=box,color=red];
		j759391385 -> j749456054;
	j2318547072 [label="Evaluate expressions on Thermostat counter",color=orange];
		j2318547072 -> j2439764149 [label="x >= 5",color=purple];
		j2318547072 -> j759391385 [label="x <= 0",color=purple];
		j2318547072 -> j85154477 [label="x > 0 && x < 5",color=purple];
		j2318547072 -> j85154477 [label="false",color=purple];
	j3355215178 [label="Wenn du um Vergebung bitten möchtest, kannst du das tun. Aber du musst es wirklich wollen. Du musst diesen Weg selbst wählen. Niemand sonst kann das tun.",shape=box,color=red];
		j3355215178 -> j3134825413;
	j1652258060 [label="Willst du deinen eigenen Weg gehen? Für dich selbst? Dann tu es. Entschuldige dich nicht. Aber du musst diesen Weg selbst wählen, niemand anderes kann das.",shape=box,color=red];
		j1652258060 -> j3374323171;
	j2313322476 [label="Du lässt zu, dass diese Wut dich innerlich zerfrisst. Du könntest sie nutzen, um gegen diejenigen anzukämpfen, die diese Welt weiterhin zerstören. Hier. Jetzt.",shape=box,color=red];
		j2313322476 -> j1631361543;
	j749456054 [label="Du richtest sie gegen dich selbst. Du solltest sie gegen die Welt richten, die dich dafür verantwortlich macht, dass du dein Bestes getan hast, um sie vor dem Imperium der Orokin zu retten.",shape=box,color=red];
		j749456054 -> j4239685282;
	j85154477 [label="Ich wünschte, ich wüsste, wie ich dir helfen kann. Ich wünschte, ich wüsste, was ich sagen soll. Es wirkt, als wärst du hin- und hergerissen. Welchen Weg willst du gehen?",shape=box,color=red];
		j85154477 -> j3750317225;
	j3134825413 [label="Du wirst nicht durch deine Vergangenheit definiert, Roathe. Du wirst durch deine Zukunft definiert. Und du hast noch eine Zukunft vor dir, anders als all die Orokin, die in der Nacht der Naga-Trommeln starben.",shape=box,color=red];
		j3134825413 -> j2467416296;
	j3374323171 [label="Du wirst nicht durch die Meinungen jener um dich herum definiert. Auch nicht durch das, was sie über deine Handlungen denken. Du wirst allein durch das definiert, was du über dich selbst und deine Entscheidungen glaubst.",shape=box,color=red];
		j3374323171 -> j1037531822;
	j1631361543 [label="Das ist das Einzige, was dich jetzt noch ausmacht. Du kannst dich ändern. Und du kannst die Welt um dich herum ändern. Meine einzige Frage ist: Wirst du es wenigstens versuchen?",shape=box,color=red];
		j1631361543 -> j2308075428;
	j4239685282 [label="Du wirst nicht durch die Meinungen jener um dich herum definiert. Auch nicht durch das, was sie über deine Handlungen denken. Du wirst allein durch das definiert, was du über dich selbst und deine Entscheidungen glaubst.",shape=box,color=red];
		j4239685282 -> j472773395;
	j3750317225 [label="Boolean RoatheFail is now true.",color=orange];
		j3750317225 -> j2933180419;
	j2467416296 [label="Das ist das Einzige, was dich jetzt noch ausmacht. Du kannst dich ändern. Und du kannst die Welt um dich herum ändern. Meine einzige Frage ist: Wirst du es wenigstens versuchen?",shape=box,color=red];
		j2467416296 -> j594651784;
	j1037531822 [label="Und die einfache Wahrheit ist: Du bist einer der wenigen Orokin, die wir kennen, der die Nacht der Naga-Trommeln überlebt hat. Aus meiner Sicht war es ein strategischer Rückzug.",shape=box,color=red];
		j1037531822 -> j2022864639;
	j2308075428 [label="Versuche, dir selbst zu vergeben und nach vorn zu blicken?",shape=box,color=red];
		j2308075428 -> j1317244448;
	j472773395 [label="Und die einfache Wahrheit ist: Du bist einer der wenigen Orokin, die wir kennen, der die Nacht der Naga-Trommeln überlebt hat. Aus meiner Sicht war es ein strategischer Rückzug.",shape=box,color=red];
		j472773395 -> j1180806805;
	j2933180419 [label="Ich weiß es nicht, Usurpator. Und genau darin liegt das größte Problem.",shape=box,color=blue];
		j2933180419 -> j4020563760;
	j594651784 [label="Versuche, dir selbst zu vergeben und nach vorn zu blicken?",shape=box,color=red];
		j594651784 -> j1170177799;
