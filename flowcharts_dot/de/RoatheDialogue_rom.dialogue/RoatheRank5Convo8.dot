		j284970141 -> j654889751;
	j1976854019 [label="Nein. Ich weiß, worum du bitten wirst, und die Antwort lautet bereits nein.",shape=box,color=red];
		j1976854019 -> j4194233398;
	"Chat ends. Next chat will be Roathe5Day2." [color=orange];
	j654889751 [label="Du besitzt eine Gabe. Eine Gabe, die die Zeit aufheben kann. Die sie in Spiralen, wenn nicht gar in eine Schleifen, formen kann. Und dies hat ... einen interessanten Effekt auf den Verstand eines Protoframes, durch seine Verbindung zum Befall und seine Verbindung zur Zeit.",shape=box,color=blue];
		j654889751 -> j357839641;
	j4194233398 [label="Kannst du mir versichern, dass du deine Gaben niemals dazu benutzt hast, mit den Erinnerungen der Protoframes zu spielen, die du Freunde und Geliebte nennst, und kannst du das ohne eine Lüge in deiner Seele sagen?",shape=box,color=blue];
		j4194233398 -> j2367457067;
	j357839641 [label="Und damit auch unsere Bindung an die Zeit. Ich bitte dich nun. Nein, ich flehe dich an, sie jetzt für mich einzusetzen. Nimm mir diese Gedanken. Nimm mir diese Erinnerungen.",shape=box,color=blue];
		j357839641 -> j688168869;
	j2367457067 [label="Dann gut. So sei es. Ich werde dich jetzt nicht darum bitten. Aber wenn du es nie aus reinem Vergnügen, aus Neugier oder um Fehler im Umgang mit anderen wiedergutzumachen getan hast?!",shape=box,color=blue];
		j2367457067 -> j688168869;
