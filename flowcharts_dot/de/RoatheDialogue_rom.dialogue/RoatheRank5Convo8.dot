		j2460742701 -> j666628366;
	j3916133672 [label="Und ich weiß nicht, wie ihren Hunger stillen soll. Ich weiß nicht, ob ich es überhaupt kann. Ich hatte gehofft, diese Gespräche würden mir einen Weg zeigen; aber ich sehe jetzt, dass das vergeblich ist.",shape=box,color=blue];
		j3916133672 -> j4275867576;
	j1880633219 [label="+20 Chemistry",color=orange];
		j1880633219 -> j672716063;
	j938163970 [label="Mir selbst vergeben für das, was ich getan habe? Und voraus in die Zukunft blicken? Hm.",shape=box,color=blue];
		j938163970 -> j2645976380;
	j666628366 [label="+20 Chemistry",color=orange];
		j666628366 -> j2996448869;
	j4275867576 [label="Es gibt aber eine Lösung, nicht wahr? Du hast die Macht, das zu beheben ... diese furchtbare Qual in meinem Verstand.",shape=box,color=blue];
		j4275867576 -> j2585433012;
	j672716063 [label="Nun gut. Ich gebe nach und akzeptiere deine Argumentation. Danke, Drifter, dass ... du mich von diesem Abgrund zurückgeholt hast.",shape=box,color=blue];
		j672716063 -> j3879296590;
	j2645976380 [label="Obwohl ich ... etwas skeptisch bin, was deine Umdeutung der Situation angeht, finde ich ... diese neue Zukunft und was sie mir bringen könnte, zu verlockend, um zu widerstehen, Usurpator. Drifter.",shape=box,color=blue];
		j2645976380 -> j2745977244;
	j2996448869 [label="Ein Rückzug, um den Krieg zu gewinnen. Hm.",shape=box,color=blue];
		j2996448869 -> j896698171;
	j2585433012 [label="Usurpator. Drifter. Ich flehe dich an. Es ist tatsächlich der einzige Weg, wie wir vorankommen können, nicht wahr? Es dient auch deinem eigenen Interesse.",shape=box,color=blue];
		j2585433012 -> j1002096848;
	j3879296590 [label="Ich weiß das zu schätzen. Mehr, als du vielleicht ahnst.",shape=box,color=blue];
		j3879296590 -> j2172834138;
	j2745977244 [label="Dieser \"neue Lebensabschnitt\". Nun gut. Ich gebe nach und akzeptiere deine Argumentation. Danke, Drifter, dass ... du mich von diesem Abgrund zurückgeholt hast.",shape=box,color=blue];
		j2745977244 -> j3879296590;
	j896698171 [label="Obwohl ich ... etwas skeptisch bin, was deine Umdeutung der Ereignisse als taktischen Rückzug angeht, gebe ich zu, dass ich ... trotzdem dafür bin, Usurpator. Drifter.",shape=box,color=blue];
		j896698171 -> j672716063;
	j1002096848 [label="Falls du wirklich willst, dass der Butler nach oben geht und sich mit der Familie Entrati versöhnt, musst du machen, was ich sage. Unbedingt.",shape=box,color=blue];
		j1002096848 -> j284970141;
		j1002096848 -> j1976854019;
	j2172834138 [label="Ich muss gehen. Ich habe Lust, seht viel Alkohol zu trinken und grüblerisch in die Ferne zu starren.",shape=box,color=blue];
