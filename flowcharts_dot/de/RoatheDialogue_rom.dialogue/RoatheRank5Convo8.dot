digraph {
	5151 [label="RoatheRank5Convo8 begins.",color=orange];
		5151 -> 5152;
	5152 [label="Check boolean RoatheFailNot21",color=orange];
		5152 -> 5154 [label=true,color=green];
		5152 -> 5153 [label=false,color=brown];
	5154 [label="Evaluate expressions on HellStory",color=orange];
		5154 -> 5155 [label="x >= 21",color=purple];
		5154 -> 5156 [label="x <= 21",color=purple];
		5154 -> 5156 [label="false",color=purple];
	5153 [label="Chat ends.",color=orange];
	5155 [label="Du Narr! Was hast du getan?! Warum, warum bist du in Höhlen vorgedrungen, in denen du nicht willkommen bist?!",shape=box,color=blue];
		5155 -> 5157;
	5156 [label="Chat ends.",color=orange];
	5157 [label="Ich verlange, dass du das in Ordnung bringst. Das ist deine Schuld. Ich spüre es, wie es an mir zerrt, mich zerreißt. Wie ein riesiges Ungeheuer.",shape=box,color=blue];
		5157 -> 5158;
	5158 [label="Befreie mich davon. Befreie mich von dieser Plage. Lösche meine Erinnerungen. Ich weiß, du kannst es. Nutze deine Gabe und beende alles. Sofort.",shape=box,color=blue];
		5158 -> 5159;
		5158 -> 5160;
		5158 -> 5161;
	5159 [label="Bist du dir sicher? Aber ... du bist clever, ich habe den Eindruck du wirst merken, dass etwas nicht stimmt.",shape=box,color=red];
		5159 -> 5162;
	5160 [label="Das ist eine andere Art von Erinnerungen, Roathe. Das funktioniert bei denen nicht. Sie sind tiefer in deiner Psyche vergraben.",shape=box,color=red];
		5160 -> 5163;
	5161 [label="Vor der Wahrheit wegzulaufen und sich zu verstecken, bringt nichts. Wir landen am Ende genau da, wo wir angefangen haben.",shape=box,color=red];
		5161 -> 5164;
	5162 [label="Sehr wahrscheinlich. Ich werde Zwei und Zwei zusammenzählen und dich dafür verantwortlich machen, etwas getan zu haben, worum ich dich nicht gebeten habe. Ich bin sicher, du wirst das überleben.",shape=box,color=blue];
		5162 -> 5165;
	5163 [label="Das mag sein. Du hast wahrscheinlich recht. Aber ich habe im Moment keine anderen Möglichkeiten, oder? Es ist einen Versuch wert.",shape=box,color=blue];
		5163 -> 5165;
	5164 [label="Und wenn das der Fall ist, dann kannst du es einfach wiederholen. Es ist, als hättest du eine unerschöpfliche Gabe, nicht wahr?",shape=box,color=blue];
		5164 -> 5165;
	5165 [label="Ich bin mir sicher, ich werde furchtbar wütend auf dich sein, sobald ich merke, dass du meine Erinnerungen verändert hast. Und ich rate dir, mir nicht zu sagen, dass es auf meinen Wunsch geschah, Schatz.",shape=box,color=blue];
		5165 -> 5166;
	5166 [label="Ich werde einfach behaupten, dass du lügst, und das wird meine Meinung über dich wahrscheinlich irreparabel schädigen.",shape=box,color=blue];
		5166 -> 5167;
		5166 -> 5168;
	5167 [label="Nein. Ich mache das nicht. Ich werde das nicht tun. Wir müssen diese Situation gemeinsam bewältigen. Können wir nicht einfach darüber reden?",shape=box,color=red];
		5167 -> 5169;
	5168 [label="Ich ... gibt es wirklich keinen anderen Weg?",shape=box,color=red];
		5168 -> 5169;
	5169 [label="Nein. Soll der Butler nach oben gehen? Dann lösche diesen ganzen Unsinn aus meinem Geist, wie ich es verlangt habe. Ist es dir egal? Dann mach, was du willst. Es kümmert mich nicht.",shape=box,color=blue];
		5169 -> 5170;
	5170 [label="Das, und natürlich unsere persönliche Freundschaft, ist mein einziges Druckmittel in dieser Situation. So einfach ist das.",shape=box,color=blue];
		5170 -> 5171;
	5171 [label="Was sagst du?",shape=box,color=blue];
		5171 -> 5172;
		5171 -> 5173;
	5172 [label="Okay. Ich ... ich werde es tun. Ich werde dein Gedächtnis löschen. Selbst wenn es Maries und Lyons Erinnerungen mit sich reißt.",shape=box,color=red];
		5172 -> 5174;
	5173 [label="Nein. Ich weigere mich. Ich werde einen anderen Weg finden, dich zum Weitermachen zu bewegen.",shape=box,color=red];
		5173 -> 5175;
	5174 [label="+10 Chemistry",color=orange];
		5174 -> 5176;
	5175 [label="Ich wünsche dir viel Glück.",shape=box,color=blue];
		5175 -> 5179;
	5176 [label="Gut. Leg los.",shape=box,color=blue];
		5176 -> 5178;
	5179 [label="Update boolean LyonRoatheRepair",color=orange];
		5179 -> 5177;
	5178 [label="Add 1 to Promise",color=orange];
		5178 -> 5180;
	5177 [label="Chat ends.",color=orange];
	5180 [label="Update boolean RoatheWillReset",color=orange];
		5180 -> 5181;
	5181 [label="Chat ends.",color=orange];
}