		j3450302375 -> "Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j2030100201 [label="Aber gemäß deinem Wunsch, werden wir ... die Sache beschleunigen. Es wäre jedoch nachlässig, nicht zu fragen, ob du dieses Projekt weiterhin vorantreiben willst?",shape=box,color=blue];
