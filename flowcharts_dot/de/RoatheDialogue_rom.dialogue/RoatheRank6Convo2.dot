		j2180283727 -> j3106118459;
	j569879261 [label="Und wie du es schon befürchtet hast, hast du dich mit deiner auserwählten Beute, Marie, selbst in eine Sackgasse manövriert. Nicht wahr? Egal. Der Teufel ist hier, um dich zu retten, gemäß unserer Abmachung.",shape=box,color=blue];
