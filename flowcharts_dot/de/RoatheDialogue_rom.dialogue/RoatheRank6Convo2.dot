	j3966482011 [label="Bist du zufrieden damit, wie die Sache bisher mit ihm gelaufen ist? Oder möchtest du, dass ich ihn zu einem weiteren Gespräch mit dir anrege?",shape=box,color=blue];
		j3966482011 -> j1779744107;
	j2180283727 [label="Wie du ja richtig vorhergesagt hast, brauchtest du meine Unterstützung. Schließlich warst du ziemlich streitlustig und lästig.",shape=box,color=blue];
		j2180283727 -> j1682951786;
