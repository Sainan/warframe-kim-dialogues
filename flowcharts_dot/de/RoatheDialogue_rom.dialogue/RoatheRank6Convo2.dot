		j732227904 -> j1776983371;
	j2248854982 [label="Großartig. Ich brauche Hilfe ...",shape=box,color=red];
		j2248854982 -> j1120021110;
	j1742147952 [label="Wenn du das so ausdrückst, klingt das alles widerlich.",shape=box,color=red];
		j1742147952 -> j3899863108;
	j1406715841 [label="[Ende.]",shape=box,color=red];
		j1406715841 -> j4238361143;
	j1443087129 [label="Du hast es komplett verpfuscht, nicht wahr? Meine Güte, das ist ja fast lächerlich. Nun gut, ich sichere dir meine Unterstützung zu, auch wenn sie zurückhaltend ist.",shape=box,color=blue];
		j1443087129 -> j2956801782;
	j1528969660 [label="Wie hast du es bloß geschafft, es bei beiden zu vermasseln?! Na schön. Es hat jetzt wohl keinen Sinn mehr, darüber zu jammern.",shape=box,color=blue];
		j1528969660 -> j2396360220;
	j3966697409 [label="Du hast es geschafft, es sowohl mit mir als auch mit Marie zu vermasseln. Fantastisch. Nun, ich sichere dir meine Unterstützung zu, auch wenn sie zurückhaltend ist.",shape=box,color=blue];
		j3966697409 -> j789750981;
	j2931788640 [label="Du hast es geschafft, es sowohl mit mir als auch mit Lyon zu vermasseln. Fantastisch. Nun, ich sichere dir meine Unterstützung zu, auch wenn sie zurückhaltend ist.",shape=box,color=blue];
		j2931788640 -> j2300543278;
	j3380948363 [label="Scheinbar bin ich der Einzige verbliebene Widerstand? Nun, das macht die Sache einfach. Ich sichere dir meine Unterstützung zu, auch wenn sie zurückhaltend ist.",shape=box,color=blue];
		j3380948363 -> j1024304427;
	j2508479790 [label="Es scheint, dass Marie der letzte verbliebene Widerstand ist.",shape=box,color=blue];
		j2508479790 -> j928545140;
	j1863294739 [label="Es scheint, dass Lyon der letzte verbliebene Widerstand ist.",shape=box,color=blue];
		j1863294739 -> j1881205274;
	j252424906 [label="Ich brauche Hilfe ...",shape=box,color=red];
		j252424906 -> j72277957;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j2642819779 [label="Ich brauche Hilfe ...",shape=box,color=red];
		j2642819779 -> j3450302375;
	j2737483170 [label="Vertraglich bin ich verpflichtet, dir zu verzeihen, aber es steht nichts davon, dass dein Kopf auf deinen Schultern bleiben muss. Daher rate ich dir, in Zukunft auf deine Worte zu achten.",shape=box,color=blue];
		j2737483170 -> j2030100201;
	j2419565393 [label="Vertraglich bin ich verpflichtet, dir zu verzeihen, daher bin ich mir nicht sicher, warum du dir die Mühe machst, dich zu entschuldigen, aber ich weiß es trotzdem zu schätzen.",shape=box,color=blue];
		j2419565393 -> j447078153;
	j179834003 [label="Ich bin mir dessen durchaus bewusst.",shape=box,color=blue];
		j179834003 -> j447078153;
	j1097294379 [label="Ich habe den Vertrag schließlich nicht aufgesetzt! Und falls du jetzt überlegst, davon zurückzutreten, sei dir bewusst, dass ich auch in Zukunft von dir die Einhaltung deiner Verpflichtungen erwarte, unabhängig davon, ob ich meine erfülle.",shape=box,color=blue];
		j1097294379 -> j4211731857;
