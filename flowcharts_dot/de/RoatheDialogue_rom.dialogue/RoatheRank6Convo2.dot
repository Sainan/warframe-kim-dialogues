	5477 [label="Du hast es komplett verpfuscht, nicht wahr? Meine Güte, das ist ja fast lächerlich. Nun gut, ich sichere dir meine Unterstützung zu, auch wenn sie zurückhaltend ist.",shape=box,color=blue];
		5477 -> 5496;
	5476 [label="Wie hast du es bloß geschafft, es bei beiden zu vermasseln?! Na schön. Es hat jetzt wohl keinen Sinn mehr, darüber zu jammern.",shape=box,color=blue];
		5476 -> 5495;
	5475 [label="Du hast es geschafft, es sowohl mit mir als auch mit Marie zu vermasseln. Fantastisch. Nun, ich sichere dir meine Unterstützung zu, auch wenn sie zurückhaltend ist.",shape=box,color=blue];
		5475 -> 5494;
