	j2032070620 [label="+5 Chemistry",color=orange];
		j2032070620 -> j2448722618;
	j3749375676 [label="Denn ich kann es kaum erwarten zu sehen, was wir gemeinsam diesem Ursprungssystem antun werden ... und unzähligen anderen.",shape=box,color=blue];
		j3749375676 -> "Chat ends.";
	j1528651077 [label="Denn was wir gemeinsam leisten können, ist schier unglaublich, nicht wahr?",shape=box,color=blue];
		j1528651077 -> "Chat ends.";
	j2448722618 [label="Die Zukunft erwartet uns.",shape=box,color=blue];
