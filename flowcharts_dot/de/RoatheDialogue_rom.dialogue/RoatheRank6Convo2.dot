	5614 [label="Du musst auch verstehen, dass meine Liebe bis jetzt ein Gut war, das niemand für sich beanspruchen wollte. Nicht in irgendeiner bedeutungsvollen Weise.",shape=box,color=blue];
		5614 -> 5615;
	5615 [label="Du schienst also bereit zu sein, deine Seele für ein einziges Stückchen Wertvolles zu verkaufen. Du kannst dir meine Verwirrung vorstellen. Wie verblüfft ich war.",shape=box,color=blue];
