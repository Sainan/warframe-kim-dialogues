	j1682951786 [label="Können wir die Standpauke überspringen?",shape=box,color=red];
		j1682951786 -> j2737483170;
	j301180891 [label="Es tut mir Leid.",shape=box,color=red];
		j301180891 -> j2419565393;
	j3106118459 [label="Du bist nicht gerade der einfachste Gesprächspartner.",shape=box,color=red];
		j3106118459 -> j179834003;
	j3017528680 [label="Wenn du das so ausdrückst, klingt das alles widerlich.",shape=box,color=red];
		j3017528680 -> j1097294379;
	j1729200660 [label="Großartig. Ich brauche Hilfe ...",shape=box,color=red];
