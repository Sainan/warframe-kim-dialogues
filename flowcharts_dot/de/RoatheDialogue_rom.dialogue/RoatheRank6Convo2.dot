	j1917959093 [label="Das \"Was\" ist bei weitem nicht so wichtig wie das \"Wer\", Usurpator.",shape=box,color=blue];
		j1917959093 -> j3187066959;
	j3187066959 [label="Dir ist schon klar, wie mächtig du bist, ja? Und wie wichtig es sein könnte, dich in meiner Tasche zu haben?",shape=box,color=blue];
		j3187066959 -> j3046405762;
	j3006904211 [label="Das \"Was\" ist bei weitem nicht so wichtig wie das \"Wer\", Usurpator.",shape=box,color=blue];
		j3006904211 -> j2250003824;
	j2250003824 [label="Dir ist schon klar, wie mächtig du bist, ja? Und wie wichtig es sein könnte, dich in meiner Tasche zu haben?",shape=box,color=blue];
		j2250003824 -> j1532306119;
	j38044158 [label="Du schuldest mir immer noch meinen Teil der Abmachung, unabhängig davon, ob du willst, dass ich meinen Teil erfülle oder nicht.",shape=box,color=blue];
		j38044158 -> j172658291;
	j2701110890 [label="Nun, ich muss dir sagen, während ich durchaus bereit bin zu \"teilen\", sind es die Eiferer ... vermutlich nicht. Ich empfehle, deine derzeitige Situation zu klären, bevor unsere weiter geht.",shape=box,color=blue];
		j2701110890 -> j2733265819;
	j2705275030 [label="Boolean RoatheDating is now true.",color=orange];
		j2705275030 -> j1589205949;
	j3046405762 [label="Das nennt man, glaube ich, im alten Sprachgebrauch einen \"Blankoscheck\"? Und du hast ihn bereitwillig unterschrieben.",shape=box,color=blue];
		j3046405762 -> j7438689;
	j1532306119 [label="Das nennt man, glaube ich, im alten Sprachgebrauch einen \"Blankoscheck\"? Und du hast ihn bereitwillig unterschrieben.",shape=box,color=blue];
		j1532306119 -> j894576413;
	j172658291 [label="Und der Teufel wird immer seine Schulden eintreiben.",shape=box,color=blue];
		j172658291 -> "Chat ends.";
	j2733265819 [label="Glaub mir, niemand ist mehr enttäuscht, als ich.",shape=box,color=blue];
		j2733265819 -> "Chat ends.";
	j1589205949 [label="Boolean IsDating is now true.",color=orange];
		j1589205949 -> j3672775496;
	j7438689 [label="+10 Chemistry",color=orange];
		j7438689 -> j2226231717;
	j894576413 [label="+10 Chemistry",color=orange];
		j894576413 -> j1206205827;
	j3672775496 [label="Boolean RoatheHasDated is now true.",color=orange];
		j3672775496 -> j3379818458;
	j2226231717 [label="Das Einzige, was noch gefährlicher ist als ein Teufel ... ist ein Teufel mit Freunden wie dir, die ihm etwas schulden. Nun, würdest du mich entschuldigen? Ich muss einer schwebenden \"Schwester von Sol\" auf die Nerven gehen.",shape=box,color=blue];
		j2226231717 -> "Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j1206205827 [label="Das Einzige, was noch gefährlicher ist als ein Teufel ... ist ein Teufel mit Freunden wie dir, die ihm etwas schulden. Nun, würdest du mich entschuldigen? Ich muss einem verrückten Priester auf die Nerven gehen.",shape=box,color=blue];
		j1206205827 -> "Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j3379818458 [label="Was für ein wirklich seltsames kleines Wesen du bist. Köstlich, aber seltsam, Drifter-Schatz.",shape=box,color=blue];
		j3379818458 -> j3870496008;
	j3870496008 [label="Ich muss jedoch fragen: Warum? Warum diese unfassbare Abmachung? Bist du nach so vielen Jahrhunderten so neugierig darauf, das Fleisch eines Orokin zu kosten?",shape=box,color=blue];
		j3870496008 -> j3857720484;
	j3857720484 [label="Evaluate expressions",color=orange];
		j3857720484 -> j2236535912 [label="RoatheUnloved3",color=purple];
		j3857720484 -> j2314163435 [label="RoatheUnloved3",color=purple];
		j3857720484 -> j2236535912 [label="RoatheUnloved2",color=purple];
		j3857720484 -> j2314163435 [label="RoatheUnloved2",color=purple];
		j3857720484 -> j1848119688 [label="false",color=purple];
		j3857720484 -> j2236535912 [label="false",color=purple];
	j2236535912 [label="Ich will ja nicht oberflächlich und taktlos klingen, aber ... hast du dich in letzter Zeit mal im Spiegel angesehen?",shape=box,color=red];
		j2236535912 -> j950744167;
	j2314163435 [label="Roathe. Du glaubst mir vielleicht nicht, aber ich ... ich liebe dich.",shape=box,color=red];
		j2314163435 -> j2052645775;
	j1848119688 [label="Ob du es glaubst oder nicht, du bist mir wichtig.",shape=box,color=red];
		j1848119688 -> j1655120199;
	j950744167 [label="+10 Chemistry",color=orange];
		j950744167 -> j1167825889;
	j2052645775 [label="Bitte was?",shape=box,color=blue];
		j2052645775 -> j3395570034;
	j1655120199 [label="Ich bin mir sicher, dass an dem, was du sagst, etwas Wahres dran ist. Oder zumindest glaube ich, dass du deine eigene Selbsttäuschung nicht erkennst.",shape=box,color=blue];
		j1655120199 -> j4039701864;
	j1167825889 [label="Ehrlichkeit ist eine wunderbare Sache, mein Drifter Lieber. Glaubst du, ich würde dich dafür verurteilen, dass du dich amüsierst? Wohl kaum.",shape=box,color=blue];
		j1167825889 -> j18856184;
	j3395570034 [label="Nein. Das ist nicht dein Ernst?",shape=box,color=blue];
		j3395570034 -> j634870452;
	j4039701864 [label="Ich glaube, die größte Errungenschaft des Imperiums der Orokin war dessen Fähigkeit, diejenigen darin davon zu überzeugen, an ihre eigenen Einbildungen zu glauben.",shape=box,color=blue];
		j4039701864 -> j2475649045;
	j18856184 [label="Auf eine Beziehung, die gleichermaßen Befriedigung bereitet.",shape=box,color=blue];
		j18856184 -> j3921499284;
	j634870452 [label="Aber warum dann eine solche Vereinbarung treffen, es sei denn ...?",shape=box,color=blue];
		j634870452 -> j222574009;
		j634870452 -> j1788150633;
	j2475649045 [label="Vielleicht ist das sogar das wahre Bindeglied der Menschheit: unsere meisterhafte Fähigkeit, in den Spiegel zu schauen und uns selbst zu täuschen.",shape=box,color=blue];
		j2475649045 -> j3219415974;
	j3921499284 [label="Boolean RoatheUnloved4 is now true.",color=orange];
		j3921499284 -> j2965571546;
	j222574009 [label="Ich habe es letztes Mal verpfuscht Dieses Risiko wollte ich nicht noch einmal eingehen.",shape=box,color=red];
		j222574009 -> j3884867427;
	j1788150633 [label="Ich habe die Vereinbarung abgeschlossen, weil ich unbedingt alles richtig machen wollte.",shape=box,color=red];
		j1788150633 -> j3884867427;
	j3219415974 [label="Alles nur, um die schreckliche Scham zu vermeiden, zugeben zu müssen, wann wir uns ändern müssen.",shape=box,color=blue];
		j3219415974 -> j3699244152;
	j2965571546 [label="Boolean RoatheRedeemed is now false.",color=orange];
		j2965571546 -> j631673681;
