	j631673681 [label="Boolean RoatheVillain is now false.",color=orange];
		j631673681 -> "Chat ends.";
	j3827931279 [label="Du hast deine Seele dem Teufel persönlich verkauft, weil ... er, ohne es zu wissen, bereits dein gebrochenes Herz besaß.",shape=box,color=blue];
		j3827931279 -> j2072008515;
	j428983340 [label="Nicht, dass ich irgendetwas über dieses Thema wüsste.",shape=box,color=blue];
		j428983340 -> j4081414586;
	j791553408 [label="Wie du ja weißt, bin ich in diesem Bereich so etwas wie ein Experte.",shape=box,color=blue];
		j791553408 -> j4081414586;
	j2072008515 [label="Drifter ... mein armer, süßer Drifter ...",shape=box,color=blue];
		j2072008515 -> j3235030106;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j3235030106 [label="Vergib mir. Bitte vergib mir. Ich wusste es nicht.",shape=box,color=blue];
		j3235030106 -> j2474178208;
	j2474178208 [label="Du musst auch verstehen, dass meine Liebe bis jetzt ein Gut war, das niemand für sich beanspruchen wollte. Nicht in irgendeiner bedeutungsvollen Weise.",shape=box,color=blue];
		j2474178208 -> j1403987424;
	j1403987424 [label="Du schienst also bereit zu sein, deine Seele für ein einziges Stückchen Wertvolles zu verkaufen. Du kannst dir meine Verwirrung vorstellen. Wie verblüfft ich war.",shape=box,color=blue];
		j1403987424 -> j4032076407;
	j4032076407 [label="Und jetzt? Jetzt, wo ich die Wahrheit kenne? Drifter, mein Drifter ... ich bin überglücklich, dass du es getan hast.",shape=box,color=blue];
		j4032076407 -> j2907313479;
