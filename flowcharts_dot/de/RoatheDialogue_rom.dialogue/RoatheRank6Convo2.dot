		j916225909 -> j2926689633;
	j1247063389 [label="Ich jedoch finde es allerdings recht amüsant, dass du versuchst, mit mir um meine Zuneigung zu feilschen. Nun gut. Aber es wäre nachlässig, nicht zu fragen, ob du diese Sache weiterhin verfolgen willst?",shape=box,color=blue];
