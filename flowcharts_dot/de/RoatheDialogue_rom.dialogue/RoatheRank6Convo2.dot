		j4211731857 -> j287777228;
		j4211731857 -> j2438902334;
	j3873454877 [label="Betrachte es als erledigt. Ich werde sehen, was ich tun kann, um die Sache zwischen euch zu beschleunigen. Danach liegt es aber an dir, den Rest sozusagen abzuschließen. Ich kann nicht die ganze Zeit Händchen halten.",shape=box,color=blue];
