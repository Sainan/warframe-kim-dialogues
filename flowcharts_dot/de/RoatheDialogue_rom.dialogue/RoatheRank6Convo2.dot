	5584 [label="Ich will ja nicht oberflächlich und taktlos klingen, aber ... hast du dich in letzter Zeit mal im Spiegel angesehen?",shape=box,color=red];
		5584 -> 5587;
	5585 [label="Roathe. Du glaubst mir vielleicht nicht, aber ich ... ich liebe dich.",shape=box,color=red];
		5585 -> 5588;
	5583 [label="Ob du es glaubst oder nicht, du bist mir wichtig.",shape=box,color=red];
		5583 -> 5586;
	5587 [label="+10 Chemistry",color=orange];
		5587 -> 5590;
	5588 [label="Bitte was?",shape=box,color=blue];
		5588 -> 5591;
	5586 [label="Ich bin mir sicher, dass an dem, was du sagst, etwas Wahres dran ist. Oder zumindest glaube ich, dass du deine eigene Selbsttäuschung nicht erkennst.",shape=box,color=blue];
		5586 -> 5589;
	5590 [label="Ehrlichkeit ist eine wunderbare Sache, mein Drifter Lieber. Glaubst du, ich würde dich dafür verurteilen, dass du dich amüsierst? Wohl kaum.",shape=box,color=blue];
		5590 -> 5593;
	5591 [label="Nein. Das ist nicht dein Ernst?",shape=box,color=blue];
		5591 -> 5594;
	5589 [label="Ich glaube, die größte Errungenschaft des Imperiums der Orokin war dessen Fähigkeit, diejenigen darin davon zu überzeugen, an ihre eigenen Einbildungen zu glauben.",shape=box,color=blue];
		5589 -> 5592;
	5593 [label="Auf eine Beziehung, die gleichermaßen Befriedigung bereitet.",shape=box,color=blue];
		5593 -> 5596;
	5594 [label="Aber warum dann eine solche Vereinbarung treffen, es sei denn ...?",shape=box,color=blue];
		5594 -> 5597;
		5594 -> 5598;
	5592 [label="Vielleicht ist das sogar das wahre Bindeglied der Menschheit: unsere meisterhafte Fähigkeit, in den Spiegel zu schauen und uns selbst zu täuschen.",shape=box,color=blue];
		5592 -> 5595;
