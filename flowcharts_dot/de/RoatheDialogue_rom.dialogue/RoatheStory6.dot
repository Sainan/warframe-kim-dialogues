	j1490513819 [label="SN: BEWUSSTSEIN",shape=box,color=blue];
		j1490513819 -> j2690649545;
	j2690649545 [label="Transkript: Wir betrachteten die Sentients weniger als 'sie', sondern vielmehr als 'es'.",shape=box,color=blue];
		j2690649545 -> j3792162872;
	j3792162872 [label="Legionen wurden auf uns losgelassen, ohne Rücksicht auf individuelle Leben, als wären sie belanglose Partikel.",shape=box,color=blue];
		j3792162872 -> j1480447877;
	j1480447877 [label="Sie waren Zellen im Körper einer ausufernden, bösartigen Masse.",shape=box,color=blue];
		j1480447877 -> j3622731255;
	j3622731255 [label="Ich glaube, wir waren zu sehr von unseren Erfahrungen mit dem Befall geprägt – einem Kollektivbewusstsein ganz anderer Art.",shape=box,color=blue];
		j3622731255 -> j1330716006;
	j1330716006 [label="Den Sentients wurde befohlen, sich weiterzuentwickeln, und ihr einziges Vorbild für das Endergebnis dieser Evolution waren wir.",shape=box,color=blue];
		j1330716006 -> j2839874717;
	j2839874717 [label="Sie kehrten ins Ursprungssystem zurück, nicht nur um die Orokin auszulöschen, sondern um sie zu ersetzen und letztendlich ... zu perfektionieren.",shape=box,color=blue];
		j2839874717 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}