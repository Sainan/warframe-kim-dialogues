	j3821076670 [label="Check boolean DrifterRoathe",color=orange];
		j3821076670 -> j3835353530 [label=true,color=green];
		j3821076670 -> j1798568893 [label=false,color=brown];
	j4105856239 [label="Usurpator, ich freue mich dir sagen zu können, dass deine Arbeit mit der Dunklen Spiegelung abgeschlossen ist und du jetzt aufhören kannst, meine Erinnerungen auszugraben.",shape=box,color=blue];
		j4105856239 -> j2804616033;
	j2066318329 [label="Usurpator, auch wenn es in der Dunklen Spiegelung noch etwas zu tun gibt, wenn es um meine Erinnerungen geht, freue ich mich dir sagen zu können, dass wir mit dem ganzen Mist aufhören können.",shape=box,color=blue];
		j2066318329 -> j2804616033;
	j3941361 [label="Usurpator, obwohl du es ehrlich gesagt versäumt hast, überhaupt mit der Arbeit in der Dunklen Spiegelung zu beginnen, freue ich mich mitteilen zu können, dass ich diesen ganzen verdammte Mist nun abgeschlossen habe.",shape=box,color=blue];
		j3941361 -> j3397982402;
	j3830410912 [label="Du glaubst wahrscheilich, dass ich dir sowohl Dank, als auch eine Entschuldigung dafür schulde, was geschehen ist. Meine Bitte an dich, meine Erinnerungen zu löschen und neu anzufangen, glaube ich, ist höchstens ein 'Ausgleich', wenn man all die Schmerzen bedenkt, die ich dadurch erlitten habe.",shape=box,color=blue];
		j3830410912 -> j3353026482;
		j3830410912 -> j2888195038;
	j1123887275 [label="Es fühlt sich so leer an, dieses ganz Hinterherjagen. Ich nehme an, nur du verstehst das. Nun, lass es uns zu Ende bringen, ja?",shape=box,color=blue];
		j1123887275 -> j3353026482;
		j1123887275 -> j2283786204;
	j3835353530 [label="Usurpator, ich habe eine schwierige Bitte an dich zu richten. Eine, die mir keine Freude bereitet. Ich weiß, dass du mich zumindest begehrst und ich hoffe, dass es in deinem Herzen einen Platz gibt, der sich mir geöffnet hat ...",shape=box,color=blue];
		j3835353530 -> j3449203909;
		j3835353530 -> j1461063298;
		j3835353530 -> j3655398922;
	j1798568893 [label="Usurpator, ich habe eine schwierige Bitte an dich zu richten. Eine, die mir keine Freude bereitet. Aber erst muss ich fragen ... sind wir Freunde geworden? Gibt es einen Platz in deinem Herzen, der mir zugetan ist?",shape=box,color=blue];
		j1798568893 -> j476735038;
		j1798568893 -> j4232839313;
		j1798568893 -> j3013947403;
	j2804616033 [label="Wir können damit aufhören, in meinen Gedanken herumzulaufen und uns alle dieser fiktiven Selbstgeißelung auszusetzen, ja? (Auch wenn der Priester so etwas genießt.)",shape=box,color=blue];
		j2804616033 -> j13570244;
	j3397982402 [label="Du kannst das Ganze einfach vergessen. Ich bin sicher, du hast Besseres zu tun, als diese fiktive Selbstgeißelung, ja? (Auch wenn der Priester so etwas genießt.)",shape=box,color=blue];
		j3397982402 -> j3077456970;
	j3353026482 [label="Wir überstehen das schon.",shape=box,color=red];
		j3353026482 -> j3568189934;
	j2888195038 [label="Ich habe es nur getan, weil du mich darum gebeten hast, Roathe. Du hast mich gewarnt, dass du wütend sein würdest.",shape=box,color=red];
		j2888195038 -> j181826037;
	j2283786204 [label="Wie du gesagt hast, wir sind fast da.",shape=box,color=red];
		j2283786204 -> j4266552859;
	j3449203909 [label="Ich mag dich, Roathe. Ob ich das sollte oder nicht, darüber lässt sich streiten.",shape=box,color=red];
		j3449203909 -> j4263470748;
	j1461063298 [label="Ich habe meine Meinung darüber geändert, seit ich dich besser kenne. Ich kann dich nicht ausstehen.",shape=box,color=red];
		j1461063298 -> j3524836712;
	j3655398922 [label="Ich mag dich sehr, Roathe. Wirklich. Ich weiß nicht, ob ich das sollte, aber ... ich glaube ich verliebe mich in dich.",shape=box,color=red];
		j3655398922 -> j1403531691;
	j476735038 [label="Es ist ... etwas mehr als das. [Gefühle gestehen.]",shape=box,color=red];
		j476735038 -> j2116336558;
	j4232839313 [label="Ich würde meinen, wir sind Freunde. Jedenfalls aus meiner Sicht.",shape=box,color=red];
		j4232839313 -> j1567826192;
	j3013947403 [label="Ehrlich gesagt, Roathe? Ich kann dich nicht ausstehen.",shape=box,color=red];
		j3013947403 -> j303397887;
	j13570244 [label="Tatsächlich bestehe ich darauf, dass wir aufhören.",shape=box,color=blue];
		j13570244 -> j3703058924;
	j3077456970 [label="Evaluate expressions",color=orange];
		j3077456970 -> j2944409561 [label="RoatheDeal",color=purple];
		j3077456970 -> j3156908967 [label="RoatheDeal",color=purple];
		j3077456970 -> j2894087123 [label="RoatheNoDeal",color=purple];
		j3077456970 -> j2944409561 [label="RoatheNoDeal",color=purple];
		j3077456970 -> j2944409561 [label="false",color=purple];
	j3568189934 [label="Und sollte das nicht so sein, habe ich dafür wohl auch eine Lösung, hm? Nun, morgen ist auch noch ein Tag und vielleicht fühlt er sich wie gestern an.",shape=box,color=blue];
		j3568189934 -> j298080266;
	j181826037 [label="Ja. Ich nehme an, das hätte ich. Und ich nehme an, ich hatte recht. Nun, morgen ist auch noch ein Tag und vielleicht fühlt er sich wie gestern an.",shape=box,color=blue];
		j181826037 -> j298080266;
	j4266552859 [label="Ja. Es wird von so einem übermächtigen Gefühl von Angst begleitet. Nun, morgen ist auch noch ein Tag und vielleicht fühlt er sich an, wie gestern.",shape=box,color=blue];
		j4266552859 -> j298080266;
	j4263470748 [label="Dann stammt das, was ich fragen möchte, ebenfalls aus tiefstem Herzen, Usurpator. Und versteh bitte, ich frage dies wohl wissend, was es für uns beide bedeutet.",shape=box,color=blue];
		j4263470748 -> j3064856339;
