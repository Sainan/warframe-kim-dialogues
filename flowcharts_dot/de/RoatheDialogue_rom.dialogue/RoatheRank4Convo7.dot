		j2948652946 -> j818532081;
	j743026603 [label="Nichts hat sich geändert. Ich bin zufrieden, mit dem, was wir gefunden haben. Diese archäologische Ausgrabung hat Früchte getragen und ich habe entschieden, wir haben genug deiner Zeit verschwendet.",shape=box,color=blue];
		j743026603 -> j1651647116;
		j743026603 -> j3636771346;
