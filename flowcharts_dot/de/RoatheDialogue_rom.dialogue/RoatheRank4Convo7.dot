		j1587163311 -> j3675651310;
	j3653603560 [label="Faszinierend ... Ich möchte diesen Moment nicht nutzen, um auf Einzelheiten einzugehen, und entschuldige mich für die Unverfrorenheit der folgenden Frage, da sie äußerst taktlos und unhöflich ist, aber sie hat einen großen Einfluss auf das, worum ich gleich bitten werde.",shape=box,color=blue];
		j3653603560 -> j3161531311;
	j1164704728 [label="Und ob du es glaubst oder nicht, ich habe die gleichen Gefühle für dich. Ich genieße unsere Gespräche wirklich sehr.",shape=box,color=blue];
		j1164704728 -> j153532480;
	j3260560911 [label="Großartig! Großartige Neuigkeiten. Das wird es dir umso leichter machen, meine Bitte durchzuführen!",shape=box,color=blue];
