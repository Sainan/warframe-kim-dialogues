	j40152846 [label="Usurpator. Ich glaube, wir sind fast am Ziel. Noch ein paar Tage, und meine Erinnerungen werden fast vollständig sein. Wir werden fast wieder da sein, wo wir zuletzt aufgehört haben, denke ich. Es ist schon seltsam, darüber nachzudenken.",shape=box,color=blue];
