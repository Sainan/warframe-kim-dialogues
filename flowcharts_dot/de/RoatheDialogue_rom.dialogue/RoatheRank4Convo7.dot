		j3675651310 -> j3261387107;
	j3161531311 [label="Ist deine ... Schwärmerei für mich nur flüchtiges Interesse, eine vorübergehende Laune, körperliche Anziehung oder vielleicht die Liebe jugendlichen Frühlings? Oder ...?",shape=box,color=blue];
