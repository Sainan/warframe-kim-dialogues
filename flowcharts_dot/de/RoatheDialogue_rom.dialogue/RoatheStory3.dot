	2150 [label="Transkript: Das Imperium der Orokin hatte schon lange keine Feinde. Das Militär existierte nur, um kleinliche Fehden auszutragen, Haus gegen Haus, Exekutor gegen Exekutor.",shape=box,color=blue];
		2150 -> 2153;
	2153 [label="Als die Sentients angriffen, erlebten wir eine Einheit, die uns lange verwehrt geblieben war. Die Dax zogen ihre Schwerter gegen etwas anderes als einen unverschämten Bauern oder einen diebischen Händler.",shape=box,color=blue];
		2153 -> 2154;
	2154 [label="Die Herrscher, die unsterblichen nominellen Gebieter des Imperiums, deren Macht den Exekutoren oblag, erwachten auf ihren staubigen goldenen Thronen.",shape=box,color=blue];
		2154 -> 5683;
	5683 [label="Krieg, ein großartiger Krieg! Endlich hatte das Imperium Bedeutung. Geprägt von einem Untergang, der unmittelbarer war als der Tod der Sonne, tranken wir tief vom Nektar des Lebens.",shape=box,color=blue];
