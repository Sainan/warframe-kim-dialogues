	j4015469338 [label="SN: OROKIN",shape=box,color=blue];
		j4015469338 -> j3017307490;
	j3017307490 [label="Transkript: Das Imperium der Orokin hatte schon lange keine Feinde. Das Militär existierte nur, um kleinliche Fehden auszutragen, Haus gegen Haus, Exekutor gegen Exekutor.",shape=box,color=blue];
		j3017307490 -> j876093948;
	j876093948 [label="Als die Sentients angriffen, erlebten wir eine Einheit, die uns lange verwehrt geblieben war. Die Dax zogen ihre Schwerter gegen etwas anderes als einen unverschämten Bauern oder einen diebischen Händler.",shape=box,color=blue];
		j876093948 -> j3717728381;
	j3717728381 [label="Die Herrscher, die unsterblichen nominellen Gebieter des Imperiums, deren Macht den Exekutoren oblag, erwachten auf ihren staubigen goldenen Thronen.",shape=box,color=blue];
		j3717728381 -> j3859030183;
	j3859030183 [label="Krieg, ein großartiger Krieg! Endlich hatte das Imperium Bedeutung. Geprägt von einem Untergang, der unmittelbarer war als der Tod der Sonne, tranken wir tief vom Nektar des Lebens.",shape=box,color=blue];
		j3859030183 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}