	j4085386627 [label="Die Familie wird Schutz brauchen. Ich sollte Wache halten. Das kann ich nicht, wenn ich im Keller eingesperrt bin.",shape=box,color=blue];
		j4085386627 -> j780094961;
	j1488000854 [label="Er hat meine Erinnerungen zerstört und dafür gesorgt, dass ich niemanden außer dir habe, an den ich mich wenden kann, um sie wiederzuerlangen.",shape=box,color=blue];
		j1488000854 -> j2578459868;
	j1444329343 [label="Die Familie wird Schutz brauchen. Und sie sind alle ein bisschen \"an ihren Platz gebunden\", nicht wahr?",shape=box,color=blue];
		j1444329343 -> j2179998195;
	j3097229398 [label="Aber das Risiko wird es wert sein. Sie hat keine andere Möglichkeit, Deimos zu schützen. Oder ihre Familie.",shape=box,color=blue];
		j3097229398 -> j922402759;
	j895729621 [label="+10 Chemistry",color=orange];
		j895729621 -> j1387986024;
	j2959610073 [label="Bis er mit ansehen muss, wie ich sie vor seinen Augen ermorde.",shape=box,color=blue];
