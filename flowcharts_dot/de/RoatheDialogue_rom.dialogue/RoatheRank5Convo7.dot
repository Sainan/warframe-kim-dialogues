	j1028452029 [label="Ich denke, ich könnte dir behilflich sein, ja. Und es wäre mir nützlich, sie dazu zu bringen, dir eine zweite Chance zu geben und sie zum Helfen zu bewegen, denke ich.",shape=box,color=blue];
