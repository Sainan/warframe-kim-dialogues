	2140 [label="Transkript: Als die Sentients die Solarschiene nach Tau fertigstellten, gab es keinen großen Rummel. Sie ging einfach in Betrieb.",shape=box,color=blue];
		2140 -> 2143;
	2143 [label="Eine Zeremonie wurde natürlich eilig inszeniert, denn kein echter Orokin putzt sich die Nase, ohne ein gewisses Maß an Pomp und Prunk zu wahren.",shape=box,color=blue];
		2143 -> 2144;
	2144 [label="Um den ersten Transporter, der die Überfahrt wagte, gab es großen Wirbel.",shape=box,color=blue];
		2144 -> 2147;
	2147 [label="Es war Exekutor Tormis' stattlicher Kreuzer, und die Wahl von Tormis zum Expeditionsleiter konnte als kollektive Rüge an Exekutor Tuvul für das groteske Unglück der Zariman Ten-Zero gelesen werden.",shape=box,color=blue];
		2147 -> 2137;
	2137 [label="Tormis reiste ab und kehrte zurück, beladen mit wundervollen, juwelenbesetzten Erinnerungen an ein neues System und neue Welten, die es zu besiedeln galt.",shape=box,color=blue];
		2137 -> 5682;
	5682 [label="Innerhalb weniger Tage war eine Flotte von Kolonieschiffen unterwegs, begierig, die unberührten Küsten zu betreten.",shape=box,color=blue];
		5682 -> 2148;
	2148 [label="Der darauffolgende Angriff der Sentients trübte die Stimmung jedoch erheblich.",shape=box,color=blue];
