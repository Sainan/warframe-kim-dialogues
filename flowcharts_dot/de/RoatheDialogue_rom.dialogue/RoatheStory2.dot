	"Chat ends." [color=orange];
	j1854494856 [label="SN: VERBINDUNG",shape=box,color=blue];
		j1854494856 -> j120872649;
	j120872649 [label="Transkript: Als die Sentients die Solarschiene nach Tau fertigstellten, gab es keinen großen Rummel. Sie ging einfach in Betrieb.",shape=box,color=blue];
		j120872649 -> j4166327688;
	j4166327688 [label="Eine Zeremonie wurde natürlich eilig inszeniert, denn kein echter Orokin putzt sich die Nase, ohne ein gewisses Maß an Pomp und Prunk zu wahren.",shape=box,color=blue];
		j4166327688 -> j2655337365;
	j2655337365 [label="Um den ersten Transporter, der die Überfahrt wagte, gab es großen Wirbel.",shape=box,color=blue];
		j2655337365 -> j1036477728;
	j1036477728 [label="Es war Exekutor Tormis' stattlicher Kreuzer, und die Wahl von Tormis zum Expeditionsleiter konnte als kollektive Rüge an Exekutor Tuvul für das groteske Unglück der Zariman Ten-Zero gelesen werden.",shape=box,color=blue];
		j1036477728 -> j2249963541;
	j2249963541 [label="Tormis reiste ab und kehrte zurück, beladen mit wundervollen, juwelenbesetzten Erinnerungen an ein neues System und neue Welten, die es zu besiedeln galt.",shape=box,color=blue];
		j2249963541 -> j255348259;
	j255348259 [label="Innerhalb weniger Tage war eine Flotte von Kolonieschiffen unterwegs, begierig, die unberührten Küsten zu betreten.",shape=box,color=blue];
		j255348259 -> j2207094489;
	j2207094489 [label="Der darauffolgende Angriff der Sentients trübte die Stimmung jedoch erheblich.",shape=box,color=blue];
		j2207094489 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}