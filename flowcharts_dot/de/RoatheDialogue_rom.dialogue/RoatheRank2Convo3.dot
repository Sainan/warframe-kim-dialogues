		j4208251187 -> j3438455715 [label=true,color=green];
		j4208251187 -> "Chat ends." [label=false,color=brown];
	j3438455715 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3438455715 -> j1326810513 [label=true,color=green];
		j3438455715 -> j4081325559 [label=false,color=brown];
	"Chat ends." [color=orange];
	j1326810513 [label="Ich weiß, dass du das wahrscheinlich schon einmal gehört hast, und heute ist es mir egal – ich habe keine Geduld dafür.",shape=box,color=blue];
		j1326810513 -> j4081325559;
	j4081325559 [label="Ich glaube, der Untergang des Imperiums der Orokin war auf zu viele Glasschichten zurückzuführen.",shape=box,color=blue];
		j4081325559 -> j687953935;
		j4081325559 -> j524930399;
		j4081325559 -> j129698615;
	j687953935 [label="Wie das?",shape=box,color=red];
		j687953935 -> j3360118153;
	j524930399 [label="Zu unpersönlich?",shape=box,color=red];
		j524930399 -> j3442373613;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j3360118153 [label="Stell dir eine Gesellschaft vor, die auf dem Wissen beruht, dass du praktisch für immer sicher bist. Geschützt. Selbst vor dem Tod.",shape=box,color=blue];
		j3360118153 -> j2213561796;
	j3442373613 [label="+5 Chemistry",color=orange];
		j3442373613 -> j3532060785;
	j2213561796 [label="Wo dir nichts schaden kann.",shape=box,color=blue];
		j2213561796 -> j3109134840;
	j3532060785 [label="Genau. Zu distanziert von der Gefahr und der Realität der Sache.",shape=box,color=blue];
		j3532060785 -> j3360118153;
	j3109134840 [label="Das führt zu einer Art Langeweile, die ihre eigene Gefahr birgt, Usurpator. Politik. Hofintrigen. Plötzlich ersannen wir raffinierte neue Wege, uns selbst zu gefährden, da wir die alten eliminiert hatten.",shape=box,color=blue];
		j3109134840 -> j2053994455;
		j3109134840 -> j3185304751;
	j2053994455 [label="Warum erzählst du mir das?",shape=box,color=red];
		j2053994455 -> j691956951;
	j3185304751 [label="Was ist schlimmer? Beschossen zu werden oder ständig auf der Hut sein zu müssen?",shape=box,color=red];
		j3185304751 -> j4181975009;
	j691956951 [label="Es gab nur wenige interessante oder angenehme Aspekte an meinem ... unfreiwilligen Aufenthalt in \"Gallien\". Das Essen war einer davon. Der zweite jedoch ... waren die Stürme.",shape=box,color=blue];
		j691956951 -> j2007815676;
	j4181975009 [label="Ha! Ich bin mir nicht sicher, ob ich eine Präferenz habe, da ich in beiden Bereichen bestens ausgebildet bin, fürchte ich. Was bevorzugst du?",shape=box,color=blue];
		j4181975009 -> j1510543342;
		j4181975009 -> j124699526;
	j2007815676 [label="Gewitter, wie ich sie in all meinen Jahren als Orokin noch nie erlebt hatte. Sie ließen die Erde erbeben und die Glasfenster in ihren Rahmen klirren. Ich konnte sie sogar unten in der staubigen Gruft hören, wo wir waren.",shape=box,color=blue];
		j2007815676 -> j3975080517;
	j1510543342 [label="Ich will wissen, wer meine Feinde sind, ganz einfach. Sollen sie mit gezückten Waffen auf mich losgehen.",shape=box,color=red];
		j1510543342 -> j976916726;
	j124699526 [label="Beschossen werden. Mir ist es lieber, die Fäden zu ziehen, um die Sache zu erledigen. Ich kann mir Zeit lassen.",shape=box,color=red];
		j124699526 -> j587876110;
	j3975080517 [label="Wenn sie über die Stadt zogen, kletterte ich auf den Glockenturm, um so nah wie möglich heranzukommen. Ich wollte die Spannung in der Luft spüren – den prasselnden Regen auf meiner Haut.",shape=box,color=blue];
		j3975080517 -> j2494336034;
		j3975080517 -> j1555297274;
		j3975080517 -> j2929236468;
	j976916726 [label="Add 1 to Thermostat counter",color=orange];
		j976916726 -> j655856123;
	j587876110 [label="Add -1 to Thermostat counter",color=orange];
		j587876110 -> j3004554715;
	j2494336034 [label="War das nicht ein bisschen gefährlich?",shape=box,color=red];
		j2494336034 -> j1639941942;
	j1555297274 [label="Das klingt großartig.",shape=box,color=red];
		j1555297274 -> j667821704;
	j2929236468 [label="Wie fanden Marie und Lyon es, dass du dich davongeschlichen hast?",shape=box,color=red];
		j2929236468 -> j499212008;
	j655856123 [label="Ich verstehe deinen Standpunkt und stimme dir zu, dass eine gewisse Einfachheit darin ihren Reiz hat. Es ist schwer, einen Feind mit etwas anderem zu verwechseln, wenn einem eine Pistole ins Gesicht gehalten wird.",shape=box,color=blue];
		j655856123 -> j62749190;
	j3004554715 [label="Mmm, köstlich, nicht wahr? Ein sorgfältig ausgearbeiteter Plan, kunstvoll geplant, der Früchte trägt? Zuzusehen, wie alle Teile zusammenpassen ... das macht wirklich Spaß.",shape=box,color=blue];
		j3004554715 -> j62749190;
	j1639941942 [label="Genau darum ging es bei diesem Unterfangen! Ich kann nicht beschreiben, wie es war, diese rohe Kraft zu spüren. Nein, es war mehr als das; es war wahre Macht. Ich blickte hinauf in die wirbelnden, dunklen Wolken, die von wütenden Blitzen erhellt wurden, und ich sah, was meine Vorfahren so verzweifelt zu bändigen gesucht hatten.",shape=box,color=blue];
		j1639941942 -> j3850618531;
	j667821704 [label="+5 Chemistry",color=orange];
		j667821704 -> j4005693004;
	j499212008 [label="Du schreibst das so, als hätte ich auch nur einen flüchtigen Gedanken daran verschwendet. Sie folgten mir nicht, falls du das meinst. Dem Priester war es sicher völlig egal, ob ich mich vom Blitz erschlagen ließe. Und Marie? Die war wohl zu sehr damit beschäftigt, ihre falschen Götzen anzubeten. Sol oder Albrecht, such dir was aus.",shape=box,color=blue];
		j499212008 -> j1178389397;
	j62749190 [label="+5 Chemistry",color=orange];
		j62749190 -> j1308035923;
	j3850618531 [label="Außerdem wusste ich, dass mich meine Anwesenheit dort töten könnte und dass es kein Kuva gab, um mich wiederzubeleben. Darüber hinaus wusste ich, dass das heilige Kuva auf meinen entstellten und verkrüppelten Körper sowieso keine Wirkung gehabt hätte.",shape=box,color=blue];
		j3850618531 -> j1645085246;
	j4005693004 [label="Das war es! Ich kann nicht beschreiben, wie es war, diese rohe Kraft zu spüren. Nein, es war mehr als das; es war wahre Macht. Ich blickte hinauf in die wirbelnden, dunklen Wolken, die von wütenden Blitzen erhellt wurden, und ich sah, was meine Vorfahren so verzweifelt zu bändigen gesucht hatten.",shape=box,color=blue];
		j4005693004 -> j3850618531;
	j1178389397 [label="Doch diese rohe Kraft zu spüren? Nein, es war mehr als das; es war wahre Macht. Ich blickte hinauf in die wirbelnden, dunklen Wolken, die von wütenden Blitzen erhellt wurden, und ich sah, was meine Vorfahren so verzweifelt zu bändigen gesucht hatten.",shape=box,color=blue];
		j1178389397 -> j3850618531;
	j1308035923 [label="Ich bin jedoch der Ansicht, dass – wie bei allem im Leben – Mäßigung und eine ausgewogene Mischung aus beidem der Schlüssel zum Erfolg sind. Wer sich zu sehr auf das eine konzentriert, riskiert, das andere zu vernachlässigen.",shape=box,color=blue];
		j1308035923 -> j3925310668;
	j1645085246 [label="Es hat mich entsetzt. Ich hatte Angst, Drifter. Angst. Zum ersten Mal seit ... Jahrhunderten, vielleicht?",shape=box,color=blue];
		j1645085246 -> j3589030169;
		j1645085246 -> j1796025040;
	j3925310668 [label="So erschaffen wir Kreaturen wie Ballas und Nitokh, fürchte ich. Den Manipulator und die Blutkönigin. Pff.",shape=box,color=blue];
		j3925310668 -> j3620257043;
	j3589030169 [label="Du hast Angst zu sterben?",shape=box,color=red];
		j3589030169 -> j4253241677;
	j1796025040 [label="Was hast du getan?",shape=box,color=red];
		j1796025040 -> j2366151125;
	j3620257043 [label="Aber ich bin hier, um über Stürme zu sprechen.",shape=box,color=blue];
		j3620257043 -> j691956951;
	j4253241677 [label="Ja, so scheint es! Und zwar sehr große Angst, möchte ich hinzufügen. Und das war in diesem Moment eine Erkenntnis für mich. Ich fürchte nicht, was nach dem Tod kommt, Drifter. Ich will noch nicht, dass mein Leben endet. Ich bin noch nicht damit fertig, es auszuleben.",shape=box,color=blue];
		j4253241677 -> j3906884903;
	j2366151125 [label="Ich kletterte auf den steinernen Baluster neben dem knorrigen Gargoyle, breitete die Arme weit aus und ... lachte. Ich lachte in den Sturm hinein.",shape=box,color=blue];
		j2366151125 -> j1983653562;
	j3906884903 [label="Das war eine wahre Offenbarung. Ich kletterte auf den steinernen Baluster neben dem knorrigen Gargoyle, breitete die Arme weit aus und ... lachte. Ich lachte in den Sturm hinein.",shape=box,color=blue];
		j3906884903 -> j3703490766;
	j1983653562 [label="Denn mir wurde plötzlich klar, dass ich nicht fürchte, was nach dem Tod kommt, Drifter. Ich will noch nicht, dass mein Leben endet. Ich bin noch nicht fertig damit, es auszuleben.",shape=box,color=blue];
		j1983653562 -> j3703490766;
	j3703490766 [label="Trotz allem. Trotz der Verwüstung von Tau. Trotz der Zerstörung des Imperiums der Orokin, die unausweichlich war. Trotz der Perversion meines Körpers in diesem ... Schlamassel. Trotz der Tatsache, dass ich in die Vergangenheit geworfen und meinem Schicksal überlassen wurde.",shape=box,color=blue];
		j3703490766 -> j3835326198;
	j3835326198 [label="Wusste ich, dass ich einen Weg zurück hierher finden werde. In diese Zeit. An diesen Ort. Dorthin, wo Albrecht all seine wertvollsten Dinge zurückgelassen hat.",shape=box,color=blue];
		j3835326198 -> j2430501870;
	j2430501870 [label="+5 Chemistry",color=orange];
		j2430501870 -> j2729865282;
	j2729865282 [label="Denn ich habe mein Leben noch nicht ausgelebt. Aber beim Void, ich werde dafür sorgen, dass sein Leben beendet wird.",shape=box,color=blue];
		j2729865282 -> j3359792563;
	j3359792563 [label="Boolean RoatheEntrati1 is now true.",color=orange];
		j3359792563 -> "Chat ends.";
}