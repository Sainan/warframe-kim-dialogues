	"Chat ends." [color=orange];
	j1082297459 [label="SN: ANPASSUNG",shape=box,color=blue];
		j1082297459 -> j341907852;
	j341907852 [label="Transkript: Viele der Sentients entwickelten sich zwischen den Begegnungen weiter, sodass wir nie sicher sein konnten, demselben Feind zweimal gegenüberzustehen. Andere hingegen blieben unverändert, als hätten sie vor langer Zeit eine Grenze erreicht.",shape=box,color=blue];
		j341907852 -> j1266560204;
	j1266560204 [label="Perfektionierte Killer, die denselben kalten Schrecken verbreiteten wie ein Hai.",shape=box,color=blue];
		j1266560204 -> j1652531347;
	j1652531347 [label="Es war Wahnsinn. Wie sollte ich Strategien für das Verhalten der Sentient Krabbenschiffe entwickeln, wenn die Krabbenschiffe durch Wurmschiffe ersetzt wurden, kaum dass meine Taktiken perfektioniert waren?",shape=box,color=blue];
		j1652531347 -> j1961795489;
	j1961795489 [label="Und wie lange hatten wir, bis diese Wurmschiffe selbst von einer neuen Monstrosität abgelöst wurden?",shape=box,color=blue];
		j1961795489 -> j70615296;
	j70615296 [label="Uns blieb nichts anderes übrig, als zurückzufallen. Fortschritt wurde zum Verhängnis. Alte Traditionen, ehrwürdige Pfade der Ehre und Disziplin, verdienten sich ihren Respekt.",shape=box,color=blue];
		j70615296 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}