		j3361283050 -> j1902848168 [label="false",color=purple];
	j2822770596 [label="Ich frage mich, ob es das war, was du mir genommen hast, Usurpator? Dass wir Liebende waren, dass ich dir meine Liebe gestanden habe und du nicht dasselbe empfunden hast?",shape=box,color=blue];
		j2822770596 -> j1094494596;
	j1352114133 [label="Ich habe jede schlechte Meinung, die du über mich hast, verdient. Und du bist damit ganz sicher nicht allein. Nicht im Geringsten.",shape=box,color=blue];
		j1352114133 -> "Chat ends.";
	j1606845166 [label="So tragisch, wirklich ... Ich möchte fast die Details wissen, aber ich habe das Gefühl, das würde zum Ende des Buches vorgreifen, bevor wir bereit sind.",shape=box,color=blue];
		j1606845166 -> j230799886;
	j3564309345 [label="Aber wen will ich eigentlich zum Narren halten?! Wir wissen doch, warum du das getan hast, oder? Und es war nicht aus Liebe zu mir. Es war aus Liebe jemand anderem. Ich bin hier nur ein bisschen poetisch.",shape=box,color=blue];
		j3564309345 -> j230799886;
	j2505176047 [label="Aber wen will ich eigentlich zum Narren halten?! Wir wissen doch, warum du das getan hast, oder? Und es war nicht aus Liebe zu mir. Es war überhaupt nicht aus Liebe. Ich bin hier nur ein bisschen poetisch.",shape=box,color=blue];
		j2505176047 -> j230799886;
	j1902848168 [label="Pah. Aber was bringt es, hier herumzusitzen und sich in poetischen Schwärmereien zu ergehen?",shape=box,color=blue];
		j1902848168 -> j230799886;
	j230799886 [label="Aber ich bin nicht hier, um dein Mitleid oder deine Sympathie zu gewinnen. Das alles habe ich selbst verschuldet. Ich habe jede schlechte Meinung, die du über mich hast, verdient. Und du bist damit sicherlich nicht allein.",shape=box,color=blue];
		j230799886 -> j3426236319;
