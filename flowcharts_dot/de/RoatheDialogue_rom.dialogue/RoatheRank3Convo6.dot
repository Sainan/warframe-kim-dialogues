digraph {
	"RoatheRank3Convo6 begins." [color=orange];
		"RoatheRank3Convo6 begins." -> j4175976882;
		"RoatheRank3Convo6 begins." -> j2426097775;
		"RoatheRank3Convo6 begins." -> j129698615;
	j4175976882 [label="Warum verbringst du so viel Zeit mit den Cavia, Roathe?",shape=box,color=red];
		j4175976882 -> j1663912537;
	j2426097775 [label="Halte dich fern von den Cavia, Roathe. Das macht mich nervös.",shape=box,color=red];
		j2426097775 -> j3748251048;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j1663912537 [label="Hm? Nun, ich finde sie sind eindeutig die traurigsten und erbärmlichsten Geschöpfe, die mir je im gesamten, vom Void verfluchten Ursprungssystem begegnet sind.",shape=box,color=blue];
		j1663912537 -> j1184645209;
	j3748251048 [label="Um in dieser Situation so wenig Missverständnisse wie möglich zu verursachen, verzichte ich auf meine übliche Weitschweifigkeit und sage einfach Folgendes:",shape=box,color=blue];
		j3748251048 -> j1545080119;
	"Chat ends." [color=orange];
	j1184645209 [label="Labortiere. Labortiere, Albrecht! Du hast Tiere in den verdammten Void geworfen, und als sie dann herauskamen und in deiner erfundenen Kindersprache wirres Zeug plapperten, hast du deinem Butler befohlen, sie einzuschläfern?!",shape=box,color=blue];
		j1184645209 -> j2677944594;
	j1545080119 [label="Nein.",shape=box,color=blue];
		j1545080119 -> "Chat ends.";
	j2677944594 [label="Immer müsse andere seine Drecksarbeit erledigen. Aber ich schweife ab. Du fragst mich, warum ich da sitze und mit ihnen rede. Besonders mit dem Vogel. Ganz einfach. Aber ich würde dich gern raten lassen. Mal sehen, ob du es herausfindest.",shape=box,color=blue];
		j2677944594 -> j3558711770;
		j2677944594 -> j3698709538;
		j2677944594 -> j2460112395;
		j2677944594 -> j3643218397;
		j2677944594 -> j3882062595;
	j3558711770 [label="Er weiß nicht, wer du bist.",shape=box,color=red];
		j3558711770 -> j740275315;
	j3698709538 [label="Vogel 3 liebt alles und jeden.",shape=box,color=red];
		j3698709538 -> j3353170719;
	j2460112395 [label="Du umgibst dich gerne mit jenen, die dir das Gefühl geben, klug zu sein.",shape=box,color=red];
		j2460112395 -> j2144866591;
	j3643218397 [label="Er hat ein scharfes Auge für diejenigen in seiner Umgebung.",shape=box,color=red];
		j3643218397 -> j2377310457;
	j3882062595 [label="Er ist leicht zu manipulieren.",shape=box,color=red];
		j3882062595 -> j2080657305;
	j740275315 [label="Ja. In gewisser Weise ist es genau das. Er weiß nicht, wer ich bin. Er weiß nichts vom \"Teufel von Tau\". Und außerdem ... ist es ihm völlig egal.",shape=box,color=blue];
		j740275315 -> j3537662470;
	j3353170719 [label="Das tut er. Er ist in seiner naiven Einfalt wirklich bestechend. Aber was du damit sagen willst, etwas freundlicher und indirekter ausgedrückt, ist, dass mich sonst niemand lieben könnte, richtig?",shape=box,color=blue];
		j3353170719 -> j893811790;
	j2144866591 [label="Ich wünschte, du würdest verstehen, wie sehr du dich irrst. Wie weit dein Pfeil vom Ziel abweicht ... aber du bist nicht allein mit deiner Meinung über mich.",shape=box,color=blue];
		j2144866591 -> j700319797;
	j2377310457 [label="Das hat er. Und seine Beobachtungsgabe ist durchaus nützlich, aber nichts, was ich nicht selbst innerhalb weniger Augenblicke erreichen kann.",shape=box,color=blue];
		j2377310457 -> j3678095842;
	j2080657305 [label="Ich wünschte, du würdest verstehen, wie sehr du dich irrst. Wie weit dein Pfeil vom Ziel abweicht ... aber du bist nicht allein mit deiner Meinung über mich.",shape=box,color=blue];
		j2080657305 -> j3682916563;
	j3537662470 [label="+10 Chemistry",color=orange];
		j3537662470 -> j759655634;
	j893811790 [label="Daher bin ich auf den blöden Vogel als Gesellschaft angewiesen? Aber du bist der Wahrheit wohl nahe genug, daher ... hast du bestanden.",shape=box,color=blue];
		j893811790 -> j759655634;
	j700319797 [label="Nicht im geringsten.",shape=box,color=blue];
		j700319797 -> j3705997063;
	j3678095842 [label="Was du also, etwas freundlicher und indirekter ausgedrückt, sagen willst, ist, du glaubst, ich benutze den großen sprechenden Vogel für meine eigenen Zwecke? Ist es das?",shape=box,color=blue];
		j3678095842 -> j3794346257;
	j3682916563 [label="Ganz und gar nicht.",shape=box,color=blue];
		j3682916563 -> j3705997063;
	j759655634 [label="Für ihn bin ich nicht Roathe. Ich bin kein Orokin. Ich bin kein Verbrecher. Kein Verräter. Kein Feigling. Ich kann einfach ... ich selbst sein.",shape=box,color=blue];
		j759655634 -> j810976008;
	j3705997063 [label="Boolean RoatheAlone1 is now true.",color=orange];
		j3705997063 -> j4081414586;
	j3794346257 [label="Nein. Aber du bist mit deiner Meinung über mich nicht allein. Ganz und gar nicht.",shape=box,color=blue];
		j3794346257 -> j3705997063;
	j810976008 [label="Ich glaube nicht, dass ich dir beschreiben kann, welch einfache und seltene Erleichterung das ist ...",shape=box,color=blue];
		j810976008 -> j5146986;
		j810976008 -> j1982977641;
		j810976008 -> j2276797159;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j5146986 [label="Du kannst alles loslassen, weißt du. Du kannst dich ändern. Sogar hier, sogar jetzt.",shape=box,color=red];
		j5146986 -> j4067698760;
	j1982977641 [label="Das muss eine furchtbare Belastung sein. Sich ständig mit den Erwartungen an den eigenen Ruf auseinanderzusetzen, egal wo man hingeht, sogar hier.",shape=box,color=red];
		j1982977641 -> j4245524527;
	j2276797159 [label="Willst du damit andeuten, dass der Rest davon eine Art Show ist, die du inszeniert hast?",shape=box,color=red];
		j2276797159 -> j4061675846;
	j4067698760 [label="Add 2 to Thermostat counter",color=orange];
		j4067698760 -> j3076908319;
	j4245524527 [label="Add -1 to Thermostat counter",color=orange];
		j4245524527 -> j1058322881;
	j4061675846 [label="Wäre es doch so einfach, alles nur eine große Fassade, die ich wie eine Maske austauschen könnte! Nein, Usurpator. Das bin ich, bis ins verrottete Mark jedes meiner Knochen.",shape=box,color=blue];
		j4061675846 -> j3799161984;
	j3076908319 [label="Wäre es doch nur so einfach, Usurpator. Du lässt alles so verlockend klingen. Kann ich? Vielleicht ... Vielleicht ist es noch nicht zu spät, selbst für einen traurigen, tragischen Teufel wie mich.",shape=box,color=blue];
		j3076908319 -> j1190563698;
	j1058322881 [label="+10 Chemistry",color=orange];
		j1058322881 -> j1312004593;
	j3799161984 [label="Das heißt aber nicht, dass ich es nicht genieße, für eine Stunde alles hinter mir zu lassen und mich einfach mit jemandem zu unterhalten, der nichts von all den schrecklichen Verbrechen ahnt, die ich im Laufe meines Lebens begangen habe.",shape=box,color=blue];
		j3799161984 -> j172570375;
	j1190563698 [label="+10 Chemistry",color=orange];
		j1190563698 -> j1879388638;
	j1312004593 [label="Es ist zermürbend, Usurpator. Und ich wünschte, ich könnte diese Rolle wie eine Maske ablegen und sie nie wieder aufnehmen. Aber so bin ich nun mal, bis ins verrottete Mark jedes meiner Knochen.",shape=box,color=blue];
		j1312004593 -> j3799161984;
	j172570375 [label="Boolean RoatheBirdThree is now true.",color=orange];
		j172570375 -> j2910266224;
		j172570375 -> j70491633;
	j1879388638 [label="Ist das alles nur eine Fassade, die ich trage? Oder sitzt es tief bis in meine verrotteteten Knochen? Ich weiß es noch nicht. Ich kann nur sagen, dass ich es genieße, wenn ich die Möglichkeit habe, für eine Stunde alles abzulegen.",shape=box,color=blue];
		j1879388638 -> j4195363670;
	j2910266224 [label="Entschuldige meine Grobheit, aber ... es klingt, als wäre dein Leben einsam gewesen.",shape=box,color=red];
		j2910266224 -> j2902082429;
	j70491633 [label="Du bist es nicht gewohnt, viele Freunde zu haben, oder?",shape=box,color=red];
		j70491633 -> j2539663690;
	j4195363670 [label="Ich lege die Bürde beiseite und setze mich zu jemandem, der nichts von meinen schrecklichen Verbrechen ahnt, unterhalte mich mit dem riesigen, charmant-einfältigen Vogel und finde ... Frieden. Zum ersten Mal seit Langem.",shape=box,color=blue];
		j4195363670 -> j3953346947;
	j2902082429 [label="Evaluate expressions",color=orange];
		j2902082429 -> j3046235995 [label="RoatheUnloved1, RoatheKnowsReset2",color=purple];
		j2902082429 -> j1319907970 [label="RoatheKnowsReset2",color=purple];
		j2902082429 -> j3652788389 [label="RoatheUnloved1",color=purple];
		j2902082429 -> j1719746295 [label="false",color=purple];
	j2539663690 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2539663690 -> j438601127 [label=true,color=green];
		j2539663690 -> j2920718286 [label=false,color=brown];
	j3953346947 [label="Vielleicht steckt ja doch Hoffnung in dem, was du sagst. Oder vielleicht mache ich mir etwas vor. Und es ist nur ein kurzer Moment der Erleichterung.",shape=box,color=blue];
		j3953346947 -> j172570375;
	j3046235995 [label="Ja, das war es. Zumindest, soweit ich mich erinnern kann. Oder ist es das, was du mir genommen hast, Usurpator? Dass wir Liebende waren, dass ich dir meine Liebe gestanden habe und du nicht dasselbe empfunden hast?",shape=box,color=blue];
		j3046235995 -> j1094494596;
	j1319907970 [label="Ich gebe zu, das war es. Zumindest soweit ich mich erinnern kann. Würde es dich schockieren zu erfahren, dass ich noch nie verliebt war? Jedenfalls nicht wechselseitig. Vielleicht aber auch nicht. Schließlich haben wir das alles wahrscheinlich schon einmal durchgekaut.",shape=box,color=blue];
		j1319907970 -> j2813039291;
	j3652788389 [label="Das war es. Lang und einsam. Aber es ist alles mein eigenes Werk, Usurpator. Ich bin nicht hier, um dein Mitleid oder deine Sympathie zu gewinnen.",shape=box,color=blue];
		j3652788389 -> j1625989357;
	j1719746295 [label="Ich gebe zu, das war es. Zumindest soweit ich mich erinnern kann. Würde es dich schockieren zu erfahren, dass ich noch nie verliebt war? Aber das ist ganz allein mein Werk, Usurpator. Ich bin nicht hier, um dein Mitleid oder deine Sympathie zu gewinnen.",shape=box,color=blue];
		j1719746295 -> j1533984229;
	j438601127 [label="Wer weiß? Vielleicht hatte ich Freunde und kann mich einfach nicht an sie erinnern, weil du und ich Freunde waren, bevor du dem ein Ende gesetzt hast, hm?",shape=box,color=blue];
		j438601127 -> j421089056;
	j2920718286 [label="Wer weiß? Vielleicht hatte ich Freunde, an die ich mich einfach nicht erinnern kann, weil Entrati in meinem Kopf herumgespukt und mir meine Erinnerungen genommen hat.",shape=box,color=blue];
		j2920718286 -> j421089056;
	j1094494596 [label="Oder war es umgekehrt? Du hast dich unsterblich in den Teufel selbst verliebt, doch sein Herz blieb dir gegenüber kalt. Verzweifelt hast du das Einzige getan, was dir blieb – du hast seinen Verstand in tausend Stücke gerissen!",shape=box,color=blue];
		j1094494596 -> j3361283050;
	j2813039291 [label="Boolean RoatheUnloved1 is now true.",color=orange];
		j2813039291 -> j2822770596;
	j1625989357 [label="Boolean RoatheAlone1 is now true.",color=orange];
		j1625989357 -> j1352114133;
	j1533984229 [label="Boolean RoatheUnloved1 is now true.",color=orange];
		j1533984229 -> j1625989357;
	j421089056 [label="So viel Gutes das mir gebracht zu haben scheint.",shape=box,color=blue];
		j421089056 -> "Chat ends.";
	j3361283050 [label="Evaluate expressions",color=orange];
