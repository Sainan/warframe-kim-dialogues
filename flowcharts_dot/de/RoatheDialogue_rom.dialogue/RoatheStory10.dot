		j2140020543 -> j323337289;
	j323337289 [label="Transkript: Es war Scarne, mürrisch, intellektuell und bissig, der den Plan noch vor dem Krieg ins Gespräch brachte. 'Wir müssen das Nest verlassen, denn es brennt.'",shape=box,color=blue];
		j323337289 -> j3460937227;
	j3460937227 [label="Durch Übernutzung und leichtsinnige Experimente hatten wir das System so sehr geschädigt, dass jede Hoffnung auf Regeneration verloren war.",shape=box,color=blue];
		j3460937227 -> j2578530807;
	j2578530807 [label="Die Expansion in neue Horizonte war nun unsere einzige Option.",shape=box,color=blue];
		j2578530807 -> j3512939537;
	j3512939537 [label="Auch er hatte die feigen Türme im Void eingeweiht.",shape=box,color=blue];
		j3512939537 -> j3141545981;
	j3141545981 [label="Die Furcht vor der Rückkehr der Sentients war so groß, dass er sich nur einen Rückzug auf Inseln im Void vorstellen konnte.",shape=box,color=blue];
		j3141545981 -> j3106450713;
	j3106450713 [label="Wie wenig Anerkennung wir den Sentients für ihren Mut zollten.",shape=box,color=blue];
		j3106450713 -> j847306767;
	j847306767 [label="Sie ertrugen bereitwillig das sengende Feuer des Voids, nur um uns bestrafen zu können.",shape=box,color=blue];
		j847306767 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
