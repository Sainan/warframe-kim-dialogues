	1860 [label="+10 Chemistry",color=orange];
		1860 -> 1864;
	1861 [label="Wie du schon sagtest. Es ist an der Zeit, dass wir uns zurückholen, was mir gehört.",shape=box,color=blue];
		1861 -> 1865;
	1866 [label="Das werde ich.",shape=box,color=red];
		1866 -> 1869;
	1867 [label="Ich sollte dich um Geduld bitten, Roathe. Nicht umgekehrt.",shape=box,color=red];
		1867 -> 1870;
	1864 [label="Ich weiß deine Besorgnis dennoch zu schätzen.",shape=box,color=blue];
		1864 -> 1868;
