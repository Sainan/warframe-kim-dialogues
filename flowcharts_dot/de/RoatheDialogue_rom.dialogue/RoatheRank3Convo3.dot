digraph {
	1781 [label="RoatheRank3Convo3 begins.",color=orange];
		1781 -> 1782;
	1782 [label="Evaluate expressions on HellStory",color=orange];
		1782 -> 1786 [label="x >= 21",color=purple];
		1782 -> 1785 [label="x >= 13",color=purple];
		1782 -> 1784 [label="x < 13 && x > 1",color=purple];
		1782 -> 1783 [label="x == 0",color=purple];
		1782 -> 1783 [label="false",color=purple];
	1786 [label="Es lässt mich nicht los, Tag und Nacht. Dieses ständige, nagende Wissen, dass ich dir nicht nur meine tiefsten Geheimnisse anvertraut habe, sondern dass du dieses Vertrauen auch missbraucht und mir alles genommen hast, und jetzt kann ich mich nicht mehr erinnern, warum …",shape=box,color=blue];
		1786 -> 1793;
	1785 [label="Wir kommen gut voran, diese Erinnerungen in meinem Geist aufzudecken. Albrecht hat mir ganz schön zugesetzt, als er mir dieses Serum injizierte.",shape=box,color=blue];
		1785 -> 1791;
		1785 -> 1792;
		1785 -> 1790;
	1784 [label="Du lässt nach im Fortschritt bei der Hilfe meine Erinnerungen wiederzuerlangen. Willst du deinen Teil der Abmachung einhalten, dann erwarte ich von dir, dass du deine Arbeit in der Abgründigkeit fortsetzt.",shape=box,color=blue];
		1784 -> 1789;
		1784 -> 1787;
		1784 -> 1788;
		1784 -> 1790;
	1783 [label="Du hast noch keinerlei Fortschritte in der Abgründigkeit erzielt bei der Aufdeckung meiner Erinnerungen. Wenn du willst, dass ich meinen Teil der Abmachung einhalte, solltest du daran arbeiten, deinen einzuhalten.",shape=box,color=blue];
		1783 -> 1787;
		1783 -> 1788;
		1783 -> 1789;
		1783 -> 1790;
	1793 [label="Check boolean RoatheResetForgiven",color=orange];
		1793 -> 1801 [label=true,color=green];
		1793 -> 1800 [label=false,color=brown];
	1791 [label="Sie scheinen nicht angenehm zu sein.",shape=box,color=red];
		1791 -> 1798;
	1792 [label="Sie scheinen nicht angenehm zu sein. Bist du sicher, dass wir weitermachen sollen?",shape=box,color=red];
		1792 -> 1799;
	1790 [label="[Ende.]",shape=box,color=red];
		1790 -> 1797;
	1789 [label="Ich habe ehrlich gesagt ziemlich damit zu kämpfen ... Ich sterbe ständig, egal wie sehr ich mich auch anstrenge.",shape=box,color=red];
		1789 -> 1796;
	1787 [label="Ich nehme von dir keine Befehle entgegen, Roathe.",shape=box,color=red];
		1787 -> 1794;
	1788 [label="Ich war beschäftigt. Ich kümmere mich darum.",shape=box,color=red];
		1788 -> 1795;
	1801 [label="Ich habe dir nicht nur verziehen, dass du mir diese Erinnerungen genommen hast ...",shape=box,color=blue];
		1801 -> 1807;
	1800 [label="Ich beginne nicht nur dir zu verzeihen, dass du mir diese Erinnerungen genommen hast ...",shape=box,color=blue];
		1800 -> 1807;
	1798 [label="Nein. Das sind sie nicht. Was hast du denn vom \"Teufel von Tau\" erwartet, Erinnerungen an einen sonnigen Nachmittag im Park, in denen ich auf einer Decke liege und Weintrauben von einer Platte nasche?",shape=box,color=blue];
		1798 -> 1805;
	1799 [label="Ich werde erst wissen, was er mir genommen hat, wenn ich alles zurückhabe. Natürlich sollten wir weitermachen! Diese Erinnerungen gehören mir, Drifter. Sie machen mich aus, wer ich war. Sie sind das Wesen meines Seins.",shape=box,color=blue];
		1799 -> 1806;
	1797 [label="Chat ends.",color=orange];
	1796 [label="Update boolean RoatheStrugglebus",color=orange];
		1796 -> 1804;
	1794 [label="Nein, das tust du nicht. Und es ist mir völlig egal, wie du deinen Tag verbringst. Ich sage lediglich, dass du eine Aufgabe zu erledigen hast, wenn du willst, dass dieser schmächtige kleine Butler die Treppe hinaufgeht.",shape=box,color=blue];
		1794 -> 1802;
	1795 [label="Mach das. Es ist mir völlig egal, wie du deinen Tag verbringst. Ich sage lediglich, dass du eine Aufgabe zu erledigen hast, wenn du willst, dass dieser schmächtige kleine Butler die Treppe hinaufgeht.",shape=box,color=blue];
		1795 -> 1803;
	1807 [label="Sondern ich wünsche mir langsam, dir wieder vertrauen zu können. Wieder! Obwohl ich genau weiß, was du getan hast. Obwohl ich weiß, dass du mich wahrscheinlich wieder verraten wirst!",shape=box,color=blue];
		1807 -> 1815;
	1805 [label="Mein armer Usurpator, ich fürchte, was wir in den Annalen meines Geistes finden werden, wird nichts als Blut, Gemetzel und Scheitern sein.",shape=box,color=blue];
		1805 -> 1811;
		1805 -> 1812;
	1806 [label="Aus dem, was ich von den anderen erfahren habe, über deine Zeit in Duviri, geht hervor, dass du etwas Ähnliches durchgemacht hast, nicht wahr?",shape=box,color=blue];
		1806 -> 1813;
		1806 -> 1814;
	1804 [label="Ich höre ständig Geschichten von deinen Siegen über die Narmer. Wie du Horden von Grineer besiegst. Wie du Wellen des Raunens auf Schritt und Tritt abwehrst. Und doch ist es mir gelungen, dich zu überraschen?",shape=box,color=blue];
		1804 -> 1810;
	1802 [label="Ist es dir egal? Dann ist es mir auch egal. Ich habe meine eigenen Angelegenheiten zu erledigen.",shape=box,color=blue];
		1802 -> 1808;
	1803 [label="Ist es dir egal? Dann ist es mir auch egal. Ich habe meine eigenen Angelegenheiten zu erledigen.",shape=box,color=blue];
		1803 -> 1809;
	1815 [label="Doch dann sitze ich in dieser Gruft, stehe vom Stuhl auf und denke mir: \"Ich frage mich, ob Drifter hier ist und ob er reden möchte.\"",shape=box,color=blue];
		1815 -> 1822;
	1811 [label="Du steuerst dieses Schiff. Wenn du es weiter ins Schwarze Loch steuern willst, dann volle Kraft voraus.",shape=box,color=red];
		1811 -> 1818;
	1812 [label="Bist du dir sicher, dass du daher weitermachen willst?",shape=box,color=red];
		1812 -> 1819;
	1813 [label="Wir sind sehr unterschiedlich, Roathe.",shape=box,color=red];
		1813 -> 1820;
	1814 [label="Das habe ich. Erinnerung und Apathie. Ich kann mich immer noch nicht an ... ganze Zeitabschnitte dort erinnern.",shape=box,color=red];
		1814 -> 1821;
	1810 [label="+20 Chemistry",color=orange];
		1810 -> 1817;
	1808 [label="Chat ends.",color=orange];
	1809 [label="+10 Chemistry",color=orange];
		1809 -> 1816;
	1822 [label="Wie erbärmlich ist das bitte? Wie tief bin ich gesunken? Ich?! Ein Orokin?! Roathe! Der Teufel von Tau! So ruhelos, so intellektuell ausgehungert, so verzweifelt nach jeglicher Art von Anregung, dass ich hier bin und mit dir rede!",shape=box,color=blue];
		1822 -> 1831;
		1822 -> 1830;
		1822 -> 1829;
		1822 -> 1828;
	1818 [label="+10 Chemistry",color=orange];
		1818 -> 1824;
	1819 [label="Ich werde erst wissen, was er mir genommen hat, wenn ich alles zurückhabe. Natürlich sollten wir weitermachen! Diese Erinnerungen gehören mir, Drifter. Sie machen mich aus, wer ich war. Sie sind das Wesen meines Seins.",shape=box,color=blue];
		1819 -> 1825;
		1819 -> 1826;
	1820 [label="Das mag sein, aber darum ging es hier nicht. Und genau das wills du ja nicht zugeben. Also. Angenommen, du hättest theoretisch Erinnerungen verloren – würdest du versuchen, sie wiederzuerlangen, wenn du könntest?",shape=box,color=blue];
		1820 -> 1825;
		1820 -> 1826;
	1821 [label="Wenn du die Möglichkeit hättest, deine verlorenen Erinnerungen wiederzuerlangen, würdest du es tun?",shape=box,color=blue];
		1821 -> 1827;
		1821 -> 1825;
		1821 -> 1826;
	1817 [label="Ich gehe davon aus, du lügst mich nicht an? Ich gebe zu, das ist ziemlich schmeichelhaft. Rührend. Unendlich traurig. Aber schmeichelhaft.",shape=box,color=blue];
		1817 -> 1823;
	1816 [label="Chat ends.",color=orange];
	1831 [label="Ich freue mich auf unsere Gespräche, egal ob du es auch tust oder nicht.",shape=box,color=red];
		1831 -> 1838;
	1830 [label="Ich werde versuchen, das nicht persönlich zu nehmen.",shape=box,color=red];
		1830 -> 1837;
	1829 [label="Vielleicht sprichst dich einfach gerne mit mir?",shape=box,color=red];
		1829 -> 1836;
	1828 [label="[Ende.]",shape=box,color=red];
		1828 -> 1835;
	1824 [label="Gut gesagt, Drifter. Ich werde das ganze Ausmaß dessen, was mir genommen wurde, erst begreifen, wenn ich alles zurückhabe. Diese Erinnerungen machen mich aus, wer ich war. Sie sind das Wesen meines Seins.",shape=box,color=blue];
		1824 -> 1827;
		1824 -> 1825;
		1824 -> 1826;
	1825 [label="Ich denke, es ist besser, zu wissen, als nicht zu wissen, aber ... wir müssen darauf vorbereitet sein.",shape=box,color=red];
		1825 -> 1832;
	1826 [label="Manchmal denke ich, dass Dinge aus gutem Grund begraben bleiben sollten.",shape=box,color=red];
		1826 -> 1833;
	1827 [label="Sie gehören dir. Zeit, sie zu holen. Was soll schon schiefgehen? Du bist ein Orokin, du hast schon Schlimmeres getan, ganz sicher.",shape=box,color=red];
		1827 -> 1834;
	1823 [label="Chat ends.",color=orange];
	1838 [label="Dann bin ich unendlich froh, dass ich nicht zu einem sabbernden Idioten wurde, als du mit einer Gabel in meinem Schädel herumgestochert hast.",shape=box,color=blue];
		1838 -> 1842;
	1837 [label="Vielleicht solltest du das aber. Schließlich hast du mit einer Gabel in meinem Schädel herumgestochert.",shape=box,color=blue];
		1837 -> 1842;
	1836 [label="Vielleicht würde ich das, wenn ich nicht wüsste, dass du mit einer Gabel in meinem Schädel herumgestochert hast.",shape=box,color=blue];
		1836 -> 1842;
	1835 [label="Chat ends.",color=orange];
	1832 [label="Vorbereitet, wie das? Glaubst du, ich werde wie ein zerbrechliches Kartenhaus zusammenbrechen, wenn ich die schreckliche Wahrheit über ein groteskes Kriegsverbrechen erfahre?",shape=box,color=blue];
		1832 -> 1839;
	1833 [label="Sind wir dann nicht dazu verdammt, unsere früheren Fehler zu wiederholen? Niemals lernend, niemals weiterentwickelnd, für immer in seliger Unkenntnis unseres früheren Selbst lebend?",shape=box,color=blue];
		1833 -> 1840;
	1834 [label="+10 Chemistry",color=orange];
		1834 -> 1841;
	1842 [label="Check boolean RoatheResetForgiven",color=orange];
		1842 -> 1846 [label=true,color=green];
		1842 -> 1847 [label=false,color=brown];
	1839 [label="Glaub mir, ich kann mir alles Mögliche vorstellen, was ich den Sentients, den Orokin oder einer beliebigen Kombination davon hätte antun können, und es gibt kaum etwas, was mich schockieren oder entsetzen würde.",shape=box,color=blue];
		1839 -> 1843;
	1840 [label="Hm. Mir ist klar, dass ich damit für die meisten wohl eher gegen meine eigene Beweisführung argumentiert habe.",shape=box,color=blue];
		1840 -> 1844;
	1841 [label="Hört, hört! Ich werde wohl kaum wie ein zartes Kartenhaus zusammenbrechen, wenn ich die schreckliche Wahrheit über ein groteskes Kriegsverbrechen erfahre.",shape=box,color=blue];
		1841 -> 1845;
	1846 [label="Ich habe dir vergeben. Und ich versuche, mein Versprechen zu halten. Es ist nur so, dass Worte etwas nicht unbedingt wahr werden lassen. Jemandem zu vergeben klingt zwar gut, aber manchmal tun sich Gefühle schwer, der Realität zu folgen.",shape=box,color=blue];
		1846 -> 1851;
		1846 -> 1852;
	1847 [label="Wirklich, das alles ist ziemlich irritierend. Ich möchte mich mit dir unterhalten. Aber ich möchte dich auch erwürgen, weil du meine Gedanken vernebelt hast.",shape=box,color=blue];
		1847 -> 1853;
		1847 -> 1854;
	1843 [label="Add 1 to Thermostat",color=orange];
		1843 -> 1848;
	1844 [label="Add -1 to Thermostat",color=orange];
		1844 -> 1849;
	1845 [label="Add -2 to Thermostat",color=orange];
		1845 -> 1850;
	1851 [label="Ich verstehe. Es ist schwer zu akzeptieren, und du willst es vielleicht auch, kannst es aber nicht.",shape=box,color=red];
		1851 -> 1857;
	1852 [label="Du ... vergibst mir also nicht?",shape=box,color=red];
		1852 -> 1857;
	1853 [label="Du musst das Geschehene einfach akzeptieren und hinter dir lassen, Roathe.",shape=box,color=red];
		1853 -> 1858;
	1854 [label="Glaubst du, du kannst mir jemals verzeihen?",shape=box,color=red];
		1854 -> 1859;
	1848 [label="Ich erinnere mich noch an genug, um zu wissen, dass ich die nächsten zweitausend Jahre am Altar der Himmlischen um \"Vergebung\" bitten könnte und sie mir niemals gewährt würde.",shape=box,color=blue];
		1848 -> 1855;
	1849 [label="Ich ziehe es vor, mir alle Fakten selbst zu anzuschauen und die Situation dann zu beurteilen.",shape=box,color=blue];
		1849 -> 1855;
	1850 [label="Ich kann mir alles Mögliche vorstellen, was ich den Sentients, den Orokin oder einer beliebigen Kombination davon hätte antun können, und es gibt kaum etwas, was mich schockieren oder entsetzen würde.",shape=box,color=blue];
		1850 -> 1856;
	1857 [label="Ich gebe mein verdammt Bestes, Usurpator. Denn irgendetwas an dir hat mich in seinen Bann gezogen. Du bist faszinierend. Und das ist in meiner Welt eine Seltenheit.",shape=box,color=blue];
		1857 -> 1862;
	1858 [label="Mmhm.",shape=box,color=blue];
		1858 -> 1863;
	1859 [label="Update boolean RoatheResetForgiven",color=orange];
		1859 -> 1857;
	1855 [label="Nein, was mich in den Tiefen meines Bewusstseins erwartet, ängstigt mich nicht. Ich möchte lediglich das zurückerlangen, was mir zu Unrecht genommen wurde.",shape=box,color=blue];
		1855 -> 1860;
	1856 [label="Nein, was mich in den Tiefen meines Bewusstseins erwartet, ängstigt mich nicht. Ich möchte lediglich das zurückerlangen, was mir zu Unrecht genommen wurde.",shape=box,color=blue];
		1856 -> 1861;
	1862 [label="Sei also bitte geduldig mit mir, wenn möglich, während ich versuche, all dies in Einklang zu bringen.",shape=box,color=blue];
		1862 -> 1866;
		1862 -> 1867;
