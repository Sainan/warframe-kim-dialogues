digraph {
	135 [label="RoatheRank1Convo2 begins.",color=orange];
		135 -> 136;
	136 [label="Dir ist schon klar, dass deine sogenannte \"Gleichgültigkeit\" kein wirklicher \"Gott\" ist, oder?",shape=box,color=blue];
		136 -> 139;
		136 -> 138;
		136 -> 137;
	139 [label="Es ist nah genug dran.",shape=box,color=red];
		139 -> 142;
	138 [label="Und was macht dich da so sicher?",shape=box,color=red];
		138 -> 141;
	137 [label="[Ende.]",shape=box,color=red];
		137 -> 140;
	142 [label="Alle, mit denen ich in diesem Irrenhaus spreche, sind felsenfest davon überzeugt, dass dieser \"Mann in der Wand\" eine Art buchstäblicher und lächerlicher Gott ist. Ein wahrer Gott. Sogar diese beiden Fanatiker scheinen mit dem Gedanken zu spielen!",shape=box,color=blue];
		142 -> 144;
		142 -> 145;
		142 -> 146;
	141 [label="Nun, aufgrund der harten Realität, dass jeder Glaube an einen Gott oder Götter von Idioten stammt, die sich an Folgendes klammern: Erstens an das erdrückende Bedürfnis, ein Stofftier umklammern zu müssen, wenn sie dem brutalen Schrecken der Endgültigkeit ihrer Seele beim Tod ins Auge sehen,",shape=box,color=blue];
		141 -> 143;
	140 [label="Chat ends.",color=orange];
	144 [label="Du glaubst nicht, dass er real ist?",shape=box,color=red];
		144 -> 148;
	145 [label="Und wenn du ihn nicht für einen Gott hältst, was glaubst du, was er ist?",shape=box,color=red];
		145 -> 149;
	146 [label="Und du nicht?",shape=box,color=red];
		146 -> 150;
	143 [label="Zweitens, die Angst, die sie empfinden, wenn sie erkennen, dass es keine \"höhere Macht\" gibt, die unser Leben vor uns ausbreitet, und dass wir daher einfach für unsere eigenen Handlungen verantwortlich sind und somit, im weiteren Sinne,",shape=box,color=blue];
		143 -> 147;
	148 [label="Habe ich das behauptet? Leg mir nicht so schnell Worte in den Mund, du vergänglicher Usurpator. Ich habe nicht geleugnet, dass die Gleichgültigkeit \"real\" ist. Ich behaupte, dass es keine Gottheit ist.",shape=box,color=blue];
		148 -> 152;
		148 -> 153;
	149 [label="Ich kann dir diese falsche Gottheit in zwei einfachen Worten entlarven, die du kennst und gut verstehst:",shape=box,color=blue];
		149 -> 154;
	150 [label="Auf keinen Fall! Erstens gibt es keinen Gott und keine Götter, die Vorstellung ist absurd. Zweitens, zu glauben, Albrecht hätte einen Gott des Voids entfesselt? Noch lächerlicher!",shape=box,color=blue];
		150 -> 155;
	147 [label="Drittens, den gerechte Zorn, der mit der Angst und dem Entsetzen einhergeht, wenn all dies zu der Erkenntnis führt, dass es keine \"Hölle\" gibt, die auf Teufel wartet, noch einen \"Himmel\", der auf Engel wartet.",shape=box,color=blue];
		147 -> 151;
	152 [label="Das Ding ist mächtiger als alles, womit ich je zu tun hatte.",shape=box,color=red];
		152 -> 156;
	153 [label="Was glaubst du, was er dann ist?",shape=box,color=red];
		153 -> 149;
	154 [label="Konzeptionelle Verkörperung.",shape=box,color=blue];
		154 -> 157;
		154 -> 158;
		154 -> 159;
	155 [label="Im Void gibt es nichts. Deshalb heißt es ja auch Void!",shape=box,color=blue];
		155 -> 160;
		155 -> 161;
	151 [label="Ich gehe davon aus, dass du kein fanatischer Eiferer bist, der sich an Wut, Entsetzen oder Angst klammert. Unter dieser Annahme werde ich nun das zweite Argument vorbringen, das ich dir für die Entthronung der Göttlichkeit der \"Gleichgültigkeit\" präsentieren möchte:",shape=box,color=blue];
		151 -> 154;
	156 [label="Und wann habe ich das jemals bestritten? Tatsächlich scheint es, als ob ihr euch alle in eine regelrechte hysterische und unnötig ungeheuerliche Bedrängnis hineingesteigert habt.",shape=box,color=blue];
		156 -> 162;
		156 -> 163;
	157 [label="Der Void und was wir daraus machen können, ist gefährlich und mächtig – glaub mir, ich weiß das. Aber er hat Grenzen. Glaubst du wirklich, es kann so etwas manifestieren? Ganze Sprachen erschaffen, Finger, die Schiffe antreiben, die durch den Void springen?",shape=box,color=red];
		157 -> 164;
	158 [label="Es ist ... sehr verlockend zu glauben, dass es nur ein Monster unter dem Bett ist, Roathe. Aber ich habe dieses Ding gesehen, Angesicht zu \"Angesicht\", und ich glaube nicht, dass so etwas einfach aus unserem Kopf kommt.",shape=box,color=red];
		158 -> 165;
	159 [label="Konzeptionelle Verkörperung kann nicht das leisten, wozu der Mann in der Wand fähig ist. Auch wenn Entrati dieses Wesen manifestiert haben mag – und dafür verantwortlich ist, es hierher gebracht zu haben – glaube ich nicht, dass er dessen Ursprung ist.",shape=box,color=red];
		159 -> 166;
	160 [label="Nein. Ich habe Dinge gesehen, die aus dem Void kommen. Engel. Gesang. Geister.",shape=box,color=red];
		160 -> 167;
	161 [label="Ich ...",shape=box,color=red];
		161 -> 167;
	162 [label="Was willst du damit sagen?",shape=box,color=red];
		162 -> 168;
	163 [label="Moment mal. Inwiefern sind wir dafür verantwortlich? Albrecht ist der Schuldige, er hat es losgelassen.",shape=box,color=red];
		163 -> 169;
	164 [label="Die Menschheit ist wahrlich erfinderisch, wenn es um die Vielfalt und das Ausmaß neuer Formen des Leidens geht, die sie sich selbst zusammenbraut, nicht wahr? Du selbst warst Zeuge vieler Grausamkeiten, die sich wohl niemand zu Zeiten unserer lieben Fanatiker hätte vorstellen können.",shape=box,color=blue];
		164 -> 170;
	165 [label="Ah, du bist der Wahrheit so nah und verwirfst sie doch so schnell. Glaubst du, es sei \"verlockend\", es für ein Produkt deines eigenen Geistes zu halten, weil es dann einfacher wäre, es zu verwerfen? Nein, ich denke, es ist viel gefährlicher, sich einer eigenen Schöpfung zu stellen als einem Gott.",shape=box,color=blue];
		165 -> 171;
	166 [label="Ich schätze deine Bescheidenheit, doch ich stelle dein beschränktes Verständnis der menschlichen Kreativität infrage – insbesondere im Hinblick darauf, wie sie neue Formen des Leidens hervorbringen kann. Bist du nicht tatsächlich ganz allein dafür verantwortlich, dein eigenes Universum aus dem Void geschaffen zu haben?",shape=box,color=blue];
		166 -> 172;
	167 [label="Aus dem Void kommt nur das, was wir hineinlegen – und was davon zurückkehrt. Es verändert Materie und Energie – aber es kann sie nicht erschaffen.",shape=box,color=blue];
		167 -> 173;
	168 [label="Was ich sagen will, ist: Albrecht war vielleicht derjenige, der als Erster seine eigene Anmaßung als das Antlitz eines grinsenden Zerstörungsgottes vor sich sah, ja.",shape=box,color=blue];
		168 -> 174;
	169 [label="Albrecht war vielleicht derjenige, der als Erster seine eigene Anmaßung als das Antlitz eines grinsenden Zerstörungsgottes vor sich sah, ja.",shape=box,color=blue];
		169 -> 174;
	170 [label="+15 Chemistry",color=orange];
		170 -> 175;
	171 [label="Einen äußeren Feind kann man verstehen, manipulieren, besiegen oder notfalls sogar mit ihm verhandeln. Er hat Schwächen, die man ausnutzen kann. Aber ein innerer Feind? Einer, den wir selbst geschaffen haben? Der ist weitaus heimtückischer.",shape=box,color=blue];
		171 -> 176;
	172 [label="Du selbst warst Zeuge vieler Formen von Grausamkeiten geworden, von denen ich sicher bin, dass sich niemand vorstellen konnte, dass sie zur Zeit unserer lieben Eiferer möglich waren.",shape=box,color=blue];
		172 -> 177;
	173 [label="Denk nach, Drifter. Diese \"Void-Engel\", von denen du sprichst. Diese Geister. Wurden sie aus denen gemacht, die bereits im Void verloren waren?",shape=box,color=blue];
		173 -> 178;
	174 [label="Aber ihr seid alle gleichermaßen schuldig, dass ihr diesen riesigen Insektenhaufen so lange den Hügel hinuntergerollt habt, und er ist mit jedem Kotkrümel, den er unterwegs aufsammelt, immer größer geworden!",shape=box,color=blue];
		174 -> 179;
	175 [label="Als Spezies sind wir geradezu erstaunlich in unserer Fähigkeit, unsere Ängste zu nähren, um neue Wege zur Selbstzerstörung zu schaffen.",shape=box,color=blue];
		175 -> 180;
	176 [label="+20 Chemistry",color=orange];
		176 -> 181;
	177 [label="+10 Chemistry",color=orange];
		177 -> 175;
	178 [label="Sie waren lediglich Echos von Energie, die wie ein bunter Kutak wiedergekäut wurde, um seine Kinder zu nähren.",shape=box,color=blue];
		178 -> 179;
	179 [label="Erlaube mir, diese Diskussion für dich zu vereifachen. Ich kann dir diese falsche Gottheit in zwei einfachen Worten entlarven, die du kennst und gut verstehst:",shape=box,color=blue];
		179 -> 154;
	180 [label="Hm. Ich fürchte, ich muss gehen. Ich lasse dich eine Weile darüber nachdenken und meine Worte verarbeiten.",shape=box,color=blue];
		180 -> 182;
		180 -> 183;
	181 [label="Denn dann müssen wir unsere eigenen Dämonen bekämpfen. Und die Menschheit ... gewinnt solche Kriege nie, nicht wahr?",shape=box,color=blue];
		181 -> 180;
	182 [label="Das werde ich tun. Danke.",shape=box,color=red];
		182 -> 184;
	183 [label="Denk über meine nach, vielleicht wirst du es am Ende doch glauben, wenn du einem Anti-Gott gegenüberstehst.",shape=box,color=red];
		183 -> 184;
	184 [label="Update boolean RoatheMITW1",color=orange];
		184 -> 185;
	185 [label="Chat ends.",color=orange];
}