	j3260378405 [label="SN: HOCHMUT",shape=box,color=blue];
		j3260378405 -> j1257386869;
	j1257386869 [label="Transkript: Eine Niederlage wurde nicht erwartet.",shape=box,color=blue];
		j1257386869 -> j4063353925;
	j4063353925 [label="Nach dem ersten Angriff der Sentients hatten wir einen vernichtenden Gegenschlag vorbereitet.",shape=box,color=blue];
		j4063353925 -> j3373752888;
	j3373752888 [label="Die Gildenglas-Magierin erhob sich mit tödlichen Schwingen aus dem Nebel von Ceres, eine Galeone, schwer beladen mit Drohnen und silbergepanzerten Myrmidons.",shape=box,color=blue];
		j3373752888 -> j3448352155;
	j3448352155 [label="Feine Schaltkreise bildeten ein zartes Netz unter ihrer durchscheinenden Panzerung.",shape=box,color=blue];
		j3448352155 -> j2157895747;
	j2157895747 [label="Sie war so gewaltig, dass sie kaum durch die Solarschiene passte.",shape=box,color=blue];
		j2157895747 -> j3473948946;
	j3473948946 [label="Die Sentients sorgten dafür, dass wir das Ergebnis sahen. Sie sangen, und unsere Technologie versagte. Unsere Krieger kämpften und erstickten in ihren glänzenden Anzügen.",shape=box,color=blue];
		j3473948946 -> j3786361599;
	j3786361599 [label="Die Besatzung der Gildenglas-Magierin verbrannte bei lebendigem Leib, als sie antriebslos durch die Lüfte von Tau stürzte – ein komplexes und kostspieliges Feuerwerk.",shape=box,color=blue];
		j3786361599 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
