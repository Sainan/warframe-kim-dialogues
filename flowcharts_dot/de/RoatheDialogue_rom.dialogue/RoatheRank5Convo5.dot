	j2427947675 [label="+5 Chemistry",color=orange];
		j2427947675 -> j3020419569;
	j854414266 [label="Ich habe dir alle meine besten Argumente vorgebracht und fürchte nun, dass sie alle vergebens sind. Deshalb frage ich dich ein letztes Mal und bete, dass die Vernunft siegt.",shape=box,color=blue];
		j854414266 -> j1396258302;
