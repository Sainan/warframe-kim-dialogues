		j1633208230 -> j187883846;
		j1633208230 -> j3243108613;
		j1633208230 -> j4272181683;
	j2634853617 [label="Wer ist denn nun der Feigling? Gut. Erlaube mir, es zu vereinfachen und gleich zur Sache zu kommen:",shape=box,color=blue];
		j2634853617 -> j3129416696;
	j2687844375 [label="Und diese Gleichgültigkeit von dir ist eine höchste Wesenheit oder Kreatur? Und übt Macht über einen Aspekt der ... Gleichgültigkeit aus? Über die Gefühllosigkeit?",shape=box,color=blue];
		j2687844375 -> j3081351330;
		j2687844375 -> j2845046403;
	j1777541244 [label="Ah, verstehe. Genau da liegt der Haken. Ja, unsere Definitionen stimmten nicht überein. Ist diese \"Gleichgültigkeit\" eine Entität, wie du es beschreibst? Ja. Da sind wir uns einig.",shape=box,color=blue];
		j1777541244 -> j4000349032;
	j549600451 [label="Enttäuschend. Ich hielt dich für intelligenter. Aber erlaube mir, diese Frage zu stellen und gleich zur Sache zu kommen:",shape=box,color=blue];
		j549600451 -> j3288978813;
	j1166610909 [label="Enttäuschend. Aber erlaube mir, diese Frage zu stellen und gleich zur Sache zu kommen:",shape=box,color=blue];
		j1166610909 -> j3288978813;
	j4144260451 [label="Friedensstifter. Warum muss es immer einen Friedensstifter geben?",shape=box,color=blue];
		j4144260451 -> j4292249734;
	j3498372553 [label="Daher unterstellst du in deiner bescheidenen Unwissenheit, dass wir alle im Dunkeln tappen.",shape=box,color=blue];
		j3498372553 -> j169056800;
	j1352737196 [label="Oh, großartig. Du glaubst also, \"Götter\" können nicht sterben!",shape=box,color=blue];
		j1352737196 -> j4292249734;
	j2423182419 [label="Und deiner Logik nach ... können Götter sterben, weil ... \"Götter\" wie Pobber sind?",shape=box,color=blue];
		j2423182419 -> j3812953983;
	j1595097600 [label="Ja, das ist natürlich klar, aber versuch mir zu folgen, Drifter. Dein Fokus ist gefragt.",shape=box,color=blue];
		j1595097600 -> j3812953983;
	j187883846 [label="Keine Ahnung, ganz ehrlich.",shape=box,color=red];
		j187883846 -> j1260011375;
	j3243108613 [label="Alles kann getötet werden. Sogar die Gleichgültigkeit. Irgendwie.",shape=box,color=red];
		j3243108613 -> j2780800866;
	j4272181683 [label="Wir können sie vielleicht nicht vernichten, aber das heißt nicht, wir können sie nicht aufhalten.",shape=box,color=red];
		j4272181683 -> j2889067849;
	j3081351330 [label="Ja. Ich denke schon.",shape=box,color=red];
		j3081351330 -> j3611529262;
	j2845046403 [label="Ich weiß es nicht.",shape=box,color=red];
		j2845046403 -> j3611529262;
	j4000349032 [label="Es lag einfach an einer unterschiedlichen Verwendung der Kurzbezeichnungen. Wie amüsant.",shape=box,color=blue];
		j4000349032 -> j4252252329;
	j4292249734 [label="Es gibt nur zwei Möglichkeiten für dich. Entweder du glaubst, dieses Ding kann sterben und ist deswegen kein \"Gott\",",shape=box,color=blue];
		j4292249734 -> j4100317401;
	j169056800 [label="Wenn keiner von uns wissen kann, ob ein \"Gott\" sterben kann, und diese Gleichgültigkeit ist einer, warum kämpfen wir dann überhaupt dagegen?",shape=box,color=blue];
		j169056800 -> j4292249734;
	j3812953983 [label="Void hoch Zwei, ich glaube, ich habe es mit einem Idioten zu tun.",shape=box,color=blue];
