		j3611529262 -> j3288978813;
	j4252252329 [label="Ich vermute \"schrecklicher, unheimlicher Schrecken jenseits unseres Verständnisses\" ist, ehrlich gesagt, viel zu lang, um darüber zu plaudern. Erlaube mir also, zur Sache zu kommen:",shape=box,color=blue];
		j4252252329 -> j3288978813;
	j4100317401 [label="Oder du glaubst, es ist unbesiegbar, und es spielt keine Rolle, wie wir es nennen, denn wir warten lediglich darauf, dass es uns alle verschlingt.",shape=box,color=blue];
		j4100317401 -> j854414266;
