	"Chat ends." [color=orange];
	j1486308810 [label="Hast du noch einmal über mein Argument bezüglich deiner \"Gleichgültigkeit\" nachgedacht?",shape=box,color=blue];
		j1486308810 -> j3428424556;
		j1486308810 -> j1415838475;
		j1486308810 -> j2416982685;
		j1486308810 -> j2835256923;
	j3428424556 [label="Ja, habe ich. Ich glaube, was Entrati aus dem Void entfesselt hat, war ein formloser Gott, der schon vor unserer Ankunft im Äther existierte.",shape=box,color=red];
		j3428424556 -> j3428107480;
	j1415838475 [label="Habe ich. Ich glaube, du redest Schwachsinn.",shape=box,color=red];
		j1415838475 -> j4099310853;
	j2416982685 [label="Ja, habe ich. Ich glaube, du hast recht. Ich glaube nicht, dass sie existierte, bevor Entrati damit interagierte. Er wollte einen Gott finden ... also spuckte der Void etwas aus, das vorgibt, einer zu sein.",shape=box,color=red];
		j2416982685 -> j1943013978;
	j2835256923 [label="Ja, habe ich. Ich glaube die Antwort liegt irgendwo dazwischen. Sie war vorher wahrscheinlich kein Gott, ist es jetzt aber. Ich glaube, Entrati hat ihn in dem Moment ins Leben gerufen, als er den Void öffnete.",shape=box,color=red];
		j2835256923 -> j3681158414;
	j3428107480 [label="Er kann einfach nicht verstehen, was wir sind.",shape=box,color=red];
		j3428107480 -> j2137162314;
	j4099310853 [label="Check boolean RoatheDating",color=orange];
		j4099310853 -> j1988102727 [label=true,color=green];
		j4099310853 -> j1447304169 [label=false,color=brown];
	j1943013978 [label="Und seitdem füttern wir es mit Angst.",shape=box,color=red];
		j1943013978 -> j63392828;
	j3681158414 [label="So wie Rell jetzt sowohl existiert als auch nicht, so ist auch die Gleichgültigkeit nie ein Gott gewesen, und doch war sie es immer.",shape=box,color=red];
		j3681158414 -> j1834291860;
	j2137162314 [label="Kann ich dich davon überzeugen, meine Position noch einmal zu überdenken? Oder sind deine Ansichten zu diesem Thema unveränderlich?",shape=box,color=blue];
		j2137162314 -> j1892611618;
		j2137162314 -> j4013639727;
	j1988102727 [label="Ich habe nicht erwartet, dass du so empfindlich bist, Drifter Lieber. Aber um es mit den Worten der Eiferer zu sagen: \"C'est la vie.\"",shape=box,color=blue];
		j1988102727 -> j650387292;
	j1447304169 [label="Um es mit den Worten der Eiferer zu sagen: \"C'est la vie.\"",shape=box,color=blue];
		j1447304169 -> "Chat ends.";
	j63392828 [label="Boolean DrifterMITWNotGod is now true.",color=orange];
		j63392828 -> j3017055156;
	j1834291860 [label="Ich hasse euch Eternalismus-Anhänger. Ihr benutzt das als Ausrede für alles. Sobald ein Archimede glaubt, es verstanden zu haben, gibt es kein Halten mehr.",shape=box,color=blue];
		j1834291860 -> j1685085638;
	j1892611618 [label="Du kannst es versuchen.",shape=box,color=red];
		j1892611618 -> j1678720811;
	j4013639727 [label="Zeitverschwendung.",shape=box,color=red];
		j4013639727 -> j1447304169;
	j650387292 [label="Boolean RoatheNoDate is now true.",color=orange];
		j650387292 -> j776748929;
	j3017055156 [label="+5 Chemistry",color=orange];
		j3017055156 -> j734555591;
	j1685085638 [label="\"Ich habe nicht vergessen, deine Büropflanze zu gießen, wie ich versprochen habe; sie erlebt einfach einen anderen Zweig des Eternalismus, der parallel zu unserem verläuft.\"",shape=box,color=blue];
		j1685085638 -> j1191428874;
	j1678720811 [label="Auch wenn du heute nicht gerade philosophisch klingst, will ich es trotzdem versuchen.",shape=box,color=blue];
		j1678720811 -> j752412668;
	j776748929 [label="Boolean RoatheDating is now false.",color=orange];
		j776748929 -> j178902881;
	j734555591 [label="Großartig! Endlich geht es voran. Lasst die Trompeten erschallen, läutet die Glocken, endlich hat es jemand begriffen!",shape=box,color=blue];
		j734555591 -> j4290145;
	j1191428874 [label="Ich könnte schreien! Könnt ihr euch in eurem elenden Leben nicht endlich einmal zu irgendetwas entscheiden?!",shape=box,color=blue];
		j1191428874 -> j979192539;
		j1191428874 -> j1111275957;
	j752412668 [label="Es ist ja nicht so, als hätte ich etwas Besseres mit meiner Zeit anzufangen.",shape=box,color=blue];
		j752412668 -> j171899201;
	j178902881 [label="Boolean IsDating is now false.",color=orange];
		j178902881 -> "Chat ends.";
	j4290145 [label="Check boolean RoatheDating",color=orange];
		j4290145 -> j2007747346 [label=true,color=green];
		j4290145 -> j807593502 [label=false,color=brown];
	j979192539 [label="Was ich versuche zu sagen ist, dass sie vorher kein Gott war, aber jetzt einer ist.",shape=box,color=red];
		j979192539 -> j2040518377;
	j1111275957 [label="Vergiss es.",shape=box,color=red];
		j1111275957 -> j2800993047;
	j171899201 [label="Fangen wir ganz oben an, ja? Wie würdest du definieren, was ein \"Gott\" ist?",shape=box,color=blue];
		j171899201 -> j2044288021;
		j171899201 -> j1499796055;
		j171899201 -> j1763573304;
	j2007747346 [label="Obwohl ich keinen Zweifel daran hatte, dass du dich überzeugen lassen würdest, mein lieber Drifter, hast du ja bereits bewiesen, dass du einen feinen Geschmack hast.",shape=box,color=blue];
		j2007747346 -> j3117597659;
	j807593502 [label="Obwohl ich keinen Zweifel daran hatte, dass du dich überzeugen lassen würdest, Drifter. Ich bin durchaus einnehmend.",shape=box,color=blue];
		j807593502 -> j3117597659;
	j2040518377 [label="Verstehe. Albrecht formte sie aus dem Void zu einem \"Gott\". Und nun haben wir einen \"Gott\", der frei herumläuft. Wie reizend.",shape=box,color=blue];
		j2040518377 -> j3940300555;
		j2040518377 -> j4033675945;
	j2800993047 [label="Genau.",shape=box,color=blue];
		j2800993047 -> "Chat ends.";
	j2044288021 [label="Eine höchste Wesenheit. Etwas, das über uneingeschränkte und unbestreitbare Autorität oder Macht verfügt.",shape=box,color=red];
		j2044288021 -> j559077313;
	j1499796055 [label="Ein übermenschliches Wesen oder Geschöpf, das Macht über einen bestimmten Aspekt der Schöpfung oder des menschlichen Schicksals besitzt.",shape=box,color=red];
		j1499796055 -> j3991107647;
	j1763573304 [label="Ich bin mir nicht sicher. Du zuerst.",shape=box,color=red];
		j1763573304 -> j1257221110;
	j3117597659 [label="Wenn wir jetzt nur noch einen Weg fänden, all die anderen Irren in dieser Anstalt zu überzeugen ...",shape=box,color=blue];
		j3117597659 -> j571083367;
		j3117597659 -> j1092088288;
	j3940300555 [label="Richtig, ja.",shape=box,color=red];
		j3940300555 -> j1713532526;
	j4033675945 [label="Ja, aber ich glaube, wir definieren, was ein \"Gott\" ist, unterschiedlich und verstricken uns darin deshalb.",shape=box,color=red];
		j4033675945 -> j3087083968;
	j559077313 [label="Und du glaubst, dass deine Gleichgültigkeit eine dieser höchsten Wesenheiten ist?",shape=box,color=blue];
		j559077313 -> j1500911062;
		j559077313 -> j408264822;
	j3991107647 [label="Und diese Gleichgültigkeit von dir ist eine höchste Wesenheit oder Kreatur? Und übt Macht über einen Aspekt der ... Gleichgültigkeit aus? Über die Gefühllosigkeit?",shape=box,color=blue];
		j3991107647 -> j408264822;
		j3991107647 -> j1500911062;
	j1257221110 [label="Wer ist denn nun der Feigling? Gut. Erlaube mir, es zu vereinfachen und gleich zur Sache zu kommen:",shape=box,color=blue];
		j1257221110 -> j3288978813;
	j571083367 [label="Was ich nicht verstehe, ist, was uns das bringt?",shape=box,color=red];
		j571083367 -> j1009596867;
	j1092088288 [label="Wozu die Mühe?",shape=box,color=red];
		j1092088288 -> j1286534809;
	j1713532526 [label="Dann lass mich die Sache vereinfachen und gleich zur Sache kommen: Glaubst du, ein \"Gott\" kann sterben?",shape=box,color=blue];
		j1713532526 -> j3129416696;
	j3087083968 [label="Ein berechtigter Einwand. Wie definierst du einen \"Gott\"?",shape=box,color=blue];
		j3087083968 -> j3539419904;
		j3087083968 -> j2275292181;
		j3087083968 -> j3166734324;
	j1500911062 [label="Ich weiß es nicht.",shape=box,color=red];
		j1500911062 -> j2600388546;
	j408264822 [label="Ja. Ich denke schon.",shape=box,color=red];
		j408264822 -> j3323216182;
	j3288978813 [label="Glaubst du, dass ein \"Gott\" sterben kann?",shape=box,color=blue];
		j3288978813 -> j1539287929;
		j3288978813 -> j3281689783;
		j3288978813 -> j527861630;
		j3288978813 -> j1849154376;
		j3288978813 -> j2961677460;
	j1009596867 [label="Was es uns bringt? Alles Gute der Welt! Natürlich, du hast immer allein gekämpft. Du warst nie den Taktiken einer Armee unterworfen.",shape=box,color=blue];
		j1009596867 -> j1633208230;
	j1286534809 [label="Wozu die Mühe? Du armes Ding. Natürlich, du hast immer allein gekämpft. Du warst nie den Taktiken einer Armee unterworfen.",shape=box,color=blue];
		j1286534809 -> j1633208230;
	j3129416696 [label="Kann ein \"Gott\" auf irgendeine Weise aufhören zu existieren?",shape=box,color=blue];
		j3129416696 -> j3288978813;
	j3539419904 [label="Ich bin mir nicht sicher. Du zuerst.",shape=box,color=red];
		j3539419904 -> j2634853617;
	j2275292181 [label="Als ein übermenschliches Wesen oder Geschöpf, das Macht über einen bestimmten Aspekt der Schöpfung oder des menschlichen Schicksals besitzt.",shape=box,color=red];
		j2275292181 -> j2687844375;
	j3166734324 [label="Als eine Wesenheit, die unser Verständnis übersteigt. Eine Kreatur, die in einer Dimension außerhalb unserer existiert und daher nicht \"wie wir\" existiert.",shape=box,color=red];
		j3166734324 -> j1777541244;
	j2600388546 [label="Genug davon, wir drehen uns im Kreis. Erlaube mir, direkt zur Sache zu kommen:",shape=box,color=blue];
		j2600388546 -> j3288978813;
	j3323216182 [label="Check boolean RoatheDating",color=orange];
		j3323216182 -> j549600451 [label=true,color=green];
		j3323216182 -> j1166610909 [label=false,color=brown];
	j1539287929 [label="Ich hoffe, ich kann ihn dorthin zurückschicken, woher er gekommen ist.",shape=box,color=red];
		j1539287929 -> j4144260451;
	j3281689783 [label="Ich weiß es nicht. Und ich glaube, niemand weiß es.",shape=box,color=red];
		j3281689783 -> j3498372553;
	j527861630 [label="Nein. Ich glaube nicht. Erhalt der Materie und so weiter.",shape=box,color=red];
		j527861630 -> j1352737196;
	j1849154376 [label="Ja, ich denke schon. Sonst würden wir ja überrannt werden, nicht wahr?",shape=box,color=red];
		j1849154376 -> j2423182419;
	j2961677460 [label="Ich hoffe es inständig.",shape=box,color=red];
		j2961677460 -> j1595097600;
