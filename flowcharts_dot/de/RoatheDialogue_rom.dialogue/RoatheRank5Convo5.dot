	j3916490114 [label="Ich hoffe sehr, dass du genauso gut darin bist, \"spontan\" Lösungen zu finden, wie die anderen behaupten.",shape=box,color=blue];
		j3916490114 -> j2799262519;
	j3020419569 [label="Hm. Denn es klappte ja gut, den Finger von dem Ding in ein Glas zu stopfen und das dann zu vervielfältigen.",shape=box,color=blue];
		j3020419569 -> j801281297;
	j1396258302 [label="Und ich flehe dich inständig an, alles in Betracht zu ziehen, was ich dir gesagt habe.",shape=box,color=blue];
