	2312 [label="SN: UNTERWERFUNG",shape=box,color=blue];
		2312 -> 2311;
	2315 [label="Chat ends.",color=orange];
	2311 [label="Transkript: Ich verstand von Anfang an – sowohl auf dem Schlachtfeld als auch im Schlafgemach –, dass der Weg zum Sieg über scheinbare Unterwerfung führt.",shape=box,color=blue];
		2311 -> 5722;
	5722 [label="Wo der Feind dich nachgeben sieht, ist sicher, dass er dich angreifen wird; und so kannst du ihn leicht zu Fall bringen.",shape=box,color=blue];
		5722 -> 5723;
	5723 [label="'Lakai', nannten sie mich. 'Schoßhund.' Nitokh wähnte sich in der Kontrolle. Wie subtil ich sie doch lenkte.",shape=box,color=blue];
		5723 -> 2310;
	2310 [label="Roathe, der Blutige. Roathe, der Oger, gemästet an den Leichen seiner Männer. Verschwender von Leben.",shape=box,color=blue];
		2310 -> 2314;
	2314 [label="Als ob ich nur um des Kampfes willen kämpfte! Nein. Das Imperium der Orokin muss untergehen.",shape=box,color=blue];
		2314 -> 5724;
	5724 [label="Dafür muss der Krieg weitergehen. Nur eine Niederlage, absolut und unwiderruflich, kann diese sieben goldenen Gargoyles stürzen.",shape=box,color=blue];
		5724 -> 2316;
	2316 [label="Nicht einmal Nitokh kannte mein wahres Herz. Sie dachte, ich strebe danach, an ihrer Seite zu herrschen.",shape=box,color=blue];
		2316 -> 2309;
	2309 [label="Add 1 to HellStory",color=orange];
		2309 -> 2347;
	2347 [label="{\"Id\":2347,\"Incoming\":[2309],\"Outgoing\":[2313],\"GraphPos\":[4758,-3705],\"CompletionType\":1}",color=orange];
