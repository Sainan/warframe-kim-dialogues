	"Chat ends." [color=orange];
	j2512182159 [label="SN: UNTERWERFUNG",shape=box,color=blue];
		j2512182159 -> j4111157540;
	j4111157540 [label="Transkript: Ich verstand von Anfang an – sowohl auf dem Schlachtfeld als auch im Schlafgemach –, dass der Weg zum Sieg über scheinbare Unterwerfung führt.",shape=box,color=blue];
		j4111157540 -> j964396673;
	j964396673 [label="Wo der Feind dich nachgeben sieht, ist sicher, dass er dich angreifen wird; und so kannst du ihn leicht zu Fall bringen.",shape=box,color=blue];
		j964396673 -> j569755070;
	j569755070 [label="'Lakai', nannten sie mich. 'Schoßhund.' Nitokh wähnte sich in der Kontrolle. Wie subtil ich sie doch lenkte.",shape=box,color=blue];
		j569755070 -> j2589325768;
	j2589325768 [label="Roathe, der Blutige. Roathe, der Oger, gemästet an den Leichen seiner Männer. Verschwender von Leben.",shape=box,color=blue];
		j2589325768 -> j1119506566;
	j1119506566 [label="Als ob ich nur um des Kampfes willen kämpfte! Nein. Das Imperium der Orokin muss untergehen.",shape=box,color=blue];
		j1119506566 -> j2747764041;
	j2747764041 [label="Dafür muss der Krieg weitergehen. Nur eine Niederlage, absolut und unwiderruflich, kann diese sieben goldenen Gargoyles stürzen.",shape=box,color=blue];
		j2747764041 -> j3979740759;
	j3979740759 [label="Nicht einmal Nitokh kannte mein wahres Herz. Sie dachte, ich strebe danach, an ihrer Seite zu herrschen.",shape=box,color=blue];
		j3979740759 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}