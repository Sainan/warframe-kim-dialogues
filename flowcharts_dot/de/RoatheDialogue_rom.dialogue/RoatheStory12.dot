		2239 -> 2236;
	2236 [label="Die Sieben befahlen mir, ein Teufel mit einem Dreizack aus Sprengköpfen zu werden, ein Sämann mit einem Sack ungezügelter Strahlung.",shape=box,color=blue];
		2236 -> 5704;
	5704 [label="An jenem Tag erfuhren wir, dass die Sentients nicht nur unsere Technologie neutralisieren, sondern sie auch beherrschen konnten.",shape=box,color=blue];
