	"Chat ends." [color=orange];
	j2588472448 [label="SN: FEUER",shape=box,color=blue];
		j2588472448 -> j3387551394;
	j3387551394 [label="Transkript: Monstrosität und Exzess leisteten uns in der Vergangenheit hervorragende Dienste. Man erwartete von mir, das als Kriegstaktik anzuwenden.",shape=box,color=blue];
		j3387551394 -> j2371852503;
	j2371852503 [label="Wie hatten wir den Befall zu Zeiten unserer Vorfahren gezähmt? Indem wir das Herz des Atoms wie eine Rosenknospe aufrissen, natürlich!",shape=box,color=blue];
		j2371852503 -> j218118119;
	j218118119 [label="Die Sieben befahlen mir, ein Teufel mit einem Dreizack aus Sprengköpfen zu werden, ein Sämann mit einem Sack ungezügelter Strahlung.",shape=box,color=blue];
		j218118119 -> j3173584032;
	j3173584032 [label="An jenem Tag erfuhren wir, dass die Sentients nicht nur unsere Technologie neutralisieren, sondern sie auch beherrschen konnten.",shape=box,color=blue];
		j3173584032 -> j827243280;
	j827243280 [label="Der Schwarm bösartiger kleiner Gleichmacher-Drohnen, die wir aussandten, kam fröhlich zu uns zurück, weiterhin schwer mit Bomben beladen, kichernd in unbekannten Silben, und detonierte in den Mutterschiffen, die sie entsandt hatten.",shape=box,color=blue];
		j827243280 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}