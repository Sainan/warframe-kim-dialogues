		j1611817759 -> j2390808084;
	j2390808084 [label="Transkript: Unter den Sieben galt ich – so wurde mir gesagt – als Nitokhs Spielzeug und Konkubine.",shape=box,color=blue];
		j2390808084 -> j1517418644;
	j1517418644 [label="Zu Kriegsbeginn ernannten sie mich auf ihr Drängen hin zum Vizeregent Groß-Carnus, und hielten es für einen Scherz.",shape=box,color=blue];
		j1517418644 -> j3348678395;
	j3348678395 [label="Schnell verwandelte sich ihr Gelächter in feierlichen Beifall, als ich Nachricht von einem Sieg nach dem anderen brachte.",shape=box,color=blue];
		j3348678395 -> j54019800;
	j54019800 [label="Das Blut besserer Männer befleckte mich wie Medaillen. Heimlich häufte ich Waffen an für Nitokh.",shape=box,color=blue];
		j54019800 -> j131090745;
	j131090745 [label="Es war ein Leichtes. Ich war zu ruhmreich, um mich zu verdächtigen.",shape=box,color=blue];
		j131090745 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
