digraph {
	2564 [label="RoatheRank4Convo4 begins.",color=orange];
		2564 -> 2565;
	2565 [label="Ich habe eine philosophische Frage an dich, Usurpator. Und bevor du voreilige Schlüsse ziehst, auf wen ich mich beziehe – sei es auf mich selbst, auf Ballas oder, Gott bewahre, auf Albrecht –, sei gesagt: Es handelt sich lediglich um ein Gedankenexperiment. Wollen wir spielen?",shape=box,color=blue];
		2565 -> 2566;
		2565 -> 2567;
		2565 -> 2568;
	2566 [label="Jetzt bin ich neugierig.",shape=box,color=red];
		2566 -> 2569;
	2567 [label="Klar. Frag ruhig.",shape=box,color=red];
		2567 -> 2570;
	2568 [label="Ich bin nicht in Stimmung dafür. [Ende.]",shape=box,color=red];
		2568 -> 2571;
	2569 [label="+5 Chemistry",color=orange];
		2569 -> 2572;
	2570 [label="Die Frage ist einfach, aber von großer Tragweite: Glaubst du, dass es jeder verdient, geliebt zu werden?",shape=box,color=blue];
		2570 -> 2573;
	2571 [label="Schade.",shape=box,color=blue];
		2571 -> 2574;
	2572 [label="Gut! Die Frage ist einfach, aber von großer Tragweite: Glaubst du, dass es jeder verdient, geliebt zu werden?",shape=box,color=blue];
		2572 -> 2573;
	2573 [label="Evaluate expressions",color=orange];
		2573 -> 2575 [label="RoatheMargulis1",color=purple];
		2573 -> 2578 [label="RoatheMargulis1",color=purple];
		2573 -> 2579 [label="RoatheMargulis1",color=purple];
		2573 -> 2576 [label="RoatheUnloved1",color=purple];
		2573 -> 2578 [label="RoatheUnloved1",color=purple];
		2573 -> 2579 [label="RoatheUnloved1",color=purple];
		2573 -> 2577 [label="RoatheExecutor1",color=purple];
		2573 -> 2577 [label="RoatheTraitor1",color=purple];
		2573 -> 2578 [label="RoatheTraitor1",color=purple];
		2573 -> 2579 [label="RoatheTraitor1",color=purple];
		2573 -> 2578 [label="false",color=purple];
		2573 -> 2579 [label="false",color=purple];
		2573 -> 2580 [label="false",color=purple];
	2574 [label="Chat ends.",color=orange];
	2575 [label="Du fragst mich das, nachdem du mir die Geschichte über Ballas und Margulis erzählt hast, und es geht nicht um ihn?",shape=box,color=red];
		2575 -> 2581;
	2578 [label="Nach allem, was Albrecht dir angetan hat, und dieser \"Kann den Orokin vergeben werden?\"-Geschichte, und es geht nicht um ihn?",shape=box,color=red];
		2578 -> 2581;
	2579 [label="Okay, ich spiele mit. Glaube ich, dass \"es jeder verdient, geliebt zu werden\"? Das ist eindeutig eine Frage der Moral und der Werte.",shape=box,color=red];
		2579 -> 2582;
	2576 [label="Ausgerechnet der Orokin, der mir erzählt hat, er kennt keine Liebe, stellt mir genau diese Frage, und es geht dabei nicht um ihn?",shape=box,color=red];
		2576 -> 2581;
	2577 [label="Der Orokin, der einer Exekutorin als Konkubine diente, dann aber plante, sie zu verraten, stellt mir diese Frage, und es geht nicht um ihn?",shape=box,color=red];
		2577 -> 2581;
	2580 [label="Willst du mir ernsthaft weismachen, dass das nur eine philosophische Frage ist?",shape=box,color=red];
		2580 -> 2581;
	2581 [label="Ich möchte mich nicht in Details verlieren. Das zieht die ganze Sache in Belanglosigkeiten. \"Also, schau, diese Person hat dies getan, und jene Person hat das getan, was dies nichtig macht\", und dann sitzen wir alle in unserem kleinen Zeugenstand.",shape=box,color=blue];
		2581 -> 2583;
		2581 -> 2584;
	2582 [label="+5 Chemistry",color=orange];
		2582 -> 2585;
	2583 [label="Entweder du sprichst Klartext oder schweig. Wenn du mir nicht sagst, um wen es hier wirklich geht, verschwende ich meine Zeit nicht mit dir.",shape=box,color=red];
		2583 -> 2586;
	2584 [label="Na gut. Spielen wir dein kleines, sprichwörtliches Spielchen.",shape=box,color=red];
		2584 -> 2587;
	2585 [label="Vielen Dank! Namen aus diesem kleinen Testament auszulassen, macht es viel verdaulicher. Sonst verliert man sich in Details und kommt nicht weiter.",shape=box,color=blue];
		2585 -> 2588;
	2586 [label="Und ich werde das auch nicht tun, so einfach ist das.",shape=box,color=blue];
		2586 -> 2589;
	2587 [label="Gut! Die Frage ist, wie bereits gesagt. Glaubst du, dass es jeder verdient, geliebt zu werden?",shape=box,color=blue];
		2587 -> 2590;
	2588 [label="Und ja, genau. Niemand stellt in Frage, ob der gerechte Held es verdient zu lieben und geliebt zu werden. Das wird in unseren großen Fabeln nie zur Debatte gestellt, nicht wahr?",shape=box,color=blue];
		2588 -> 2591;
	2589 [label="Update boolean RoatheNoDate",color=orange];
		2589 -> 2592;
	2590 [label="Niemand stellt infrage, ob der gerechte Held es verdient zu lieben und geliebt zu werden. Das wird in unseren großen Fabeln nie zur Debatte gestellt, nicht wahr?",shape=box,color=blue];
		2590 -> 2591;
	2591 [label="Nur der Hund. Der Schurke. Das Monster. Der moralisch verkommene Zerstörer von Welten.",shape=box,color=blue];
		2591 -> 2593;
		2591 -> 2594;
	2592 [label="Chat ends.",color=orange];
	2593 [label="[Lass ihn weiterreden.]",shape=box,color=red];
		2593 -> 2595;
	2594 [label="Der Teufel?",shape=box,color=red];
		2594 -> 2596;
	2595 [label="Add 1 to Thermostat",color=orange];
		2595 -> 2597;
	2596 [label="Spiel mit, Usurpator.",shape=box,color=blue];
		2596 -> 2598;
	2597 [label="Ich schlage folgende Aussage vor: Das Einzige, was diese Geschöpfe moralisch ausgrenzt, ist die Tatsache, dass es andere gibt, die sie moralisch ausgrenzen können.",shape=box,color=blue];
		2597 -> 2599;
	2598 [label="Add -1 to Thermostat",color=orange];
		2598 -> 2600;
		2598 -> 2601;
	2599 [label="Wenn ein Individuum im Vakuum \"böse Taten\" begehen würde, als Einzelperson ohne andere drumherum, die darüber richten könnten, gäbe es niemanden, der es als böse verurteilen könnte, nicht wahr?",shape=box,color=blue];
		2599 -> 2602;
	2600 [label="Ich meine ...",shape=box,color=red];
		2600 -> 2603;
	2601 [label="Tut mir leid.",shape=box,color=red];
		2601 -> 2603;
	2602 [label="Wenn ein Mistkerl einen Wald niederbrennt und niemand da ist, der es hört, macht das dann ein Geräusch? Der einzige Maßstab, den wir haben, um \"gute\" und \"böse\" Taten zu beurteilen, sind die Taten anderer.",shape=box,color=blue];
		2602 -> 2604;
		2602 -> 2605;
		2602 -> 2606;
	2603 [label="Aber ja, da du unbedingt darauf bestanden hast, es anzusprechen: Der Teufel! Das ultimative aller Übel!",shape=box,color=blue];
		2603 -> 2597;
	2604 [label="Es muss Taten geben, die von sich aus böse sind.",shape=box,color=red];
		2604 -> 2607;
	2605 [label="Du meinst also, dass eine Person eine zweite Person braucht, um \"böse\" zu sein?",shape=box,color=red];
		2605 -> 2608;
	2606 [label="Ich weiß nicht, ob ich dem zustimme.",shape=box,color=red];
		2606 -> 2607;
	2607 [label="Selbst die schrecklichsten Taten, die jemand begehen kann, erfordern mindestens eine zweite Person. Ein einzelner Mensch kann, isoliert betrachtet, nichts Verwerfliches tun. Zerstöre einen unbewohnten Planeten? Oh weh.",shape=box,color=blue];
		2607 -> 2609;
	2608 [label="Ja. Denk mal darüber nach. Selbst die schrecklichsten Taten, die jemand begehen kann, erfordern mindestens eine zweite Person. Ein einzelner Mensch kann, isoliert betrachtet, nichts Verwerfliches tun. Zerstöre einen unbewohnten Planeten? Oh weh.",shape=box,color=blue];
		2608 -> 2609;
	2609 [label="Und ohne eine Gesellschaft, die mit dem Finger auf die Person zeigt und sagt: \"Diese schreckliche Tat hättest du nicht begehen sollen\", wie sollten wir überhaupt wissen, dass diese Tat so entsetzlich war? Das würden wir nicht.",shape=box,color=blue];
		2609 -> 2610;
	2610 [label="Es ist lediglich ein Messlatte, die von der Gesellschaft benutzt wird, um Ihre Handlungen mit denen anderer zu vergleichen, wie ich bereits sagte.",shape=box,color=blue];
		2610 -> 2611;
		2610 -> 2612;
	2611 [label="Angenommen, du hast Recht. Angenommen, du hast mich überzeugt, und Gut und Böse sind nur ... soziale Konstrukte. Was dann?",shape=box,color=red];
		2611 -> 2613;
	2612 [label="Ich glaube, dass Handlungen auch außerhalb ihres sozialen Kontextes gut oder böse sein können. Warum sonst sollten so viele von ihnen in völlig unterschiedlichen Gesellschaften so ähnlich sein?",shape=box,color=red];
		2612 -> 2614;
	2613 [label="Add -1 to Thermostat",color=orange];
		2613 -> 2615;
	2614 [label="Add 1 to Thermostat",color=orange];
		2614 -> 2616;
		2614 -> 2617;
	2615 [label="+5 Chemistry",color=orange];
		2615 -> 2618;
	2616 [label="Aber der Argumentation halber fahr fort.",shape=box,color=red];
		2616 -> 2615;
	2617 [label="Es ist wohl am besten, wenn wir hier aufhören. Ich sehe keinen guten Ausgang. [Ende.]",shape=box,color=red];
		2617 -> 2619;
	2618 [label="Sehr gut. Wenn wir sagen können, dass \"das Böse\" kein Zustand, sondern ein soziales Konstrukt ist, dann können wir auch darin übereinstimmen, dass alle Geschichten über große Verbrechen ihrerseits soziale Konstrukte sind. Fabeln.",shape=box,color=blue];
		2618 -> 2620;
	2619 [label="Wie du wünschst.",shape=box,color=blue];
		2619 -> 2621;
	2620 [label="Warum werden dann in allen großen Fabeln diejenigen, die die größten Übel begehen, ihrem Schicksal überlassen?",shape=box,color=blue];
		2620 -> 2622;
		2620 -> 2623;
		2620 -> 2624;
		2620 -> 2625;
	2621 [label="Chat ends.",color=orange];
	2622 [label="Weil sie unfähig sind zu lieben?",shape=box,color=red];
		2622 -> 2626;
	2623 [label="Weil in ihrem Herzen kein Platz für Liebe ist?",shape=box,color=red];
		2623 -> 2627;
	2624 [label="Weil sie es nicht verdienen, geliebt zu werden?",shape=box,color=red];
		2624 -> 2628;
	2625 [label="Weil wir versuchen, eine Lektion zu erteilen?",shape=box,color=red];
		2625 -> 2629;
	2626 [label="Manchmal, ja, es gibt einiges an inhumanem Bösen, dass der Liebe nicht fähig ist. Aber warum? Ich würde sagen, dass alle großen Fabeln eine Lektion erteilen sollen, oder nicht?",shape=box,color=blue];
		2626 -> 2630;
	2627 [label="Manchmal, ja, scheinen sie so sehr mit ihren großen Verbrechen beschäftigt zu sein, dass sie sich nicht mit solchen sogenannten \"trivialen Dingen\" abfinden. Aber warum? Alle großen Fabeln dienen doch dazu, eine Lektion zu erteilen, oder nicht?",shape=box,color=blue];
		2627 -> 2630;
	2628 [label="Hm, jetzt wiederholst du nur meine Worte, Usurpator. Wir haben doch schon entschieden, dass \"verdienen\" relativ ist. Denk nach. Alle großen Fabeln erteilen doch eine Lektion, oder nicht?",shape=box,color=blue];
		2628 -> 2630;
	2629 [label="+5 Chemistry",color=orange];
		2629 -> 2631;
	2630 [label="Und wenn wir einen großes Böses zeigen würden, das friedlich, glücklich und wunderbar verliebt lebt ... nun ja ... welche Lehre würden wir daraus ziehen?",shape=box,color=blue];
		2630 -> 2632;
		2630 -> 2633;
		2630 -> 2634;
	2631 [label="Das wäre meine Theorie, ja! Alle großen Fabeln dienen doch dazu, eine Lektion zu erteilen, nicht wahr?",shape=box,color=blue];
		2631 -> 2630;
	2632 [label="Es ist schwer zu vereinbaren, dass jemand \"böse\" ist und gleichzeitig zur Liebe fähig.",shape=box,color=red];
		2632 -> 2635;
	2633 [label="Dass ihre \"bösen Taten\" vielleicht doch noch durch Liebe gesühnt werden könnten?",shape=box,color=red];
		2633 -> 2636;
	2634 [label="Dass diejenigen, die \"Böses\" tun, dennoch für jemand anderen in dieser Welt von Wert sein können und daher nicht \"rein böse\" sind?",shape=box,color=red];
		2634 -> 2637;
	2635 [label="Check boolean RoatheMargulis1",color=orange];
		2635 -> 2638 [label=true,color=green];
		2635 -> 2639 [label=false,color=brown];
	2636 [label="Add 1 to Thermostat",color=orange];
		2636 -> 2640;
	2637 [label="Add -1 to Thermostat",color=orange];
		2637 -> 2641;
	2638 [label="+5 Chemistry",color=orange];
		2638 -> 2642;
	2639 [label="+5 Chemistry",color=orange];
		2639 -> 2643;
	2640 [label="Du klingst wie die Eiferer. \"Erlösung.\" Aber du klopfst an die Tür der Wahrheit. Denn du implizierst, dass beides in unserer Welt nicht gleichzeitig existieren kann, und das stimmt doch, oder? Liebe und Böses dürfen in der Gesellschaft nicht nebeneinander bestehen.",shape=box,color=blue];
		2640 -> 2644;
	2641 [label="Du bist nah dran, aber noch nicht ganz. Ja, aber geh noch einen Schritt weiter. Was würde es bedeuten, wenn jemand, der zu bösen Taten fähig ist, dennoch von einem anderen geliebt würde? Welche Auswirkungen hätte das auf die Gesellschaft?",shape=box,color=blue];
		2641 -> 2644;
	2642 [label="Ganz genau! Diese beiden Dinge wollen in unseren Köpfen nicht zusammen existieren, nicht wahr? Als ich dir die Geschichte von Ballas und Margulis erzählte, war es schwer zu akzeptieren, dass ihre Liebe zueinander einst echt war, nicht wahr?",shape=box,color=blue];
		2642 -> 2645;
	2643 [label="Ganz genau! Diese beiden Dinge passen einfach nicht zusammen, oder? Würdest du mir glauben, wenn ich dir erzählen würde, dass Ballas und Margulis einst unsterblich ineinander verliebt waren, bevor alles schiefging?",shape=box,color=blue];
		2643 -> 2645;
	2644 [label="Check boolean RoatheMargulis1",color=orange];
		2644 -> 2646 [label=true,color=green];
		2644 -> 2647 [label=false,color=brown];
	2645 [label="Ohne auf Einzelheiten einzugehen und zu weit von meiner eigenen Regel abzuweichen, die Dinge rein philosophisch zu halten – sie sind ein gemeinsamer Bezugspunkt für uns beide.",shape=box,color=blue];
		2645 -> 2648;
	2646 [label="Als ich dir die Geschichte von Ballas und Margulis erzählte, war es schwer zu akzeptieren, dass ihre Liebe zueinander einst echt war, nicht wahr?",shape=box,color=blue];
		2646 -> 2645;
	2647 [label="Würdest du mir glauben, wenn ich dir erzählen würde, dass Ballas und Margulis einst unsterblich ineinander verliebt waren, bevor alles schiefging?",shape=box,color=blue];
		2647 -> 2645;
	2648 [label="Es steht außer Frage, dass Ballas zu einigen der schlimmsten Formen der Grausamkeit fähig war, die die Menschheit je gekannt hat. Und doch kannte er Liebe. Gegenseitige Liebe.",shape=box,color=blue];
		2648 -> 2649;
	2649 [label="Das ist eine Tatsache, auch wenn du es jetzt vielleicht leugnen möchtest: Ballas und Margulis liebten einander innig. Es ging einfach furchtbar schief.",shape=box,color=blue];
		2649 -> 2650;
	2650 [label="Update boolean RoatheMargulis1",color=orange];
		2650 -> 2651;
	2651 [label="Aber wir müssen diese Geschichte ihrer Liebe tilgen. Wir müssen sagen, dass sie nicht existierte. Wir müssen sagen, dass sie nicht real war, dass sie ein Irrglaube war. Warum?",shape=box,color=blue];
		2651 -> 2652;
		2651 -> 2653;
		2651 -> 2654;
	2652 [label="Ich weiß es nicht.",shape=box,color=red];
		2652 -> 2655;
	2653 [label="Denn Liebe ist das ultimative menschliche Gefühl, und wenn wir uns erlauben, zu denken, dass jemand geliebt werden kann, vermenschlicht das denjenigen.",shape=box,color=red];
		2653 -> 2656;
	2654 [label="Denn das Böse muss in den Spiegel blicken und an sich arbeiten. Es muss bestraft werden. Und zu lieben und geliebt zu werden ist die höchste Belohnung.",shape=box,color=red];
		2654 -> 2657;
	2655 [label="Und all meine Arbeit war umsonst. Schade.",shape=box,color=blue];
		2655 -> 2658;
	2656 [label="Add -2 to Thermostat",color=orange];
		2656 -> 2659;
	2657 [label="Add 2 to Thermostat",color=orange];
		2657 -> 2660;
	2658 [label="Chat ends.",color=orange];
	2659 [label="Sehr gut, Usurpator. Sehr gut. Genau so. Das große Übel muss immer das \"Andere\" bleiben, und wir dürfen ihm niemals Sympathie entgegenbringen. Wenn wir ihm erlauben, Liebe zu empfinden und geliebt zu werden? Ich glaube, die ganze Welt würde um uns herum zusammenbrechen.",shape=box,color=blue];
		2659 -> 2661;
	2660 [label="Sehr gut, Usurpator. Sehr gut. Genau so. Wir müssen das große Übel zur Rechenschaft ziehen. Wenn wir ihm erlauben, Liebe zu empfinden und geliebt zu werden? Ich glaube, die ganze Welt würde um uns herum zusammenbrechen.",shape=box,color=blue];
		2660 -> 2661;
	2661 [label="Update boolean RoatheUnloved3",color=orange];
		2661 -> 2662;
	2662 [label="Und wo wären wir dann?",shape=box,color=blue];
		2662 -> 2663;
	2663 [label="Chat ends.",color=orange];
}