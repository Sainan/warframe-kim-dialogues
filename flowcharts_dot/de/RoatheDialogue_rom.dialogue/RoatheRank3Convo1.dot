digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank3Convo1 begins." [color=orange];
		"RoatheRank3Convo1 begins." -> j715325037;
	j715325037 [label="Sprichst du endlich mit unserem lieben Lyon? Oder ignoriert er dich immer noch? Ehrlich gesagt, wäre es vielleicht besser, wenn du Abstand hältst.",shape=box,color=blue];
		j715325037 -> j3634380201;
		j715325037 -> j1077304744;
		j715325037 -> j129698615;
	j3634380201 [label="Kommst du mit ihm nicht zurecht?",shape=box,color=red];
		j3634380201 -> j2410725625;
	j1077304744 [label="Wenn du etwas freundlicher zu Marie und Lyon wärst, wären sie vielleicht auch freundlicher zu dir.",shape=box,color=red];
		j1077304744 -> j836316038;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j2410725625 [label="Ich würde besser mit ihm \"zurechtkommen\", würde er sich bemühen, etwas mehr über mich und meine Herkunft zu erfahren. Ich bin, wer ich bin. Und das schon seit Jahrhunderten. Ich erwarte nicht, mich zu ändern, nur weil sie es jetzt fordern.",shape=box,color=blue];
		j2410725625 -> j3060654953;
	j836316038 [label="Und was ist mit ihrer Güte mir gegenüber, Usurpator? Ich bin, wer ich bin. Und das war ich schon seit Jahrhunderten. Ich erwarte nicht, mich zu ändern, nur weil sie es jetzt fordern.",shape=box,color=blue];
		j836316038 -> j3060654953;
	"Chat ends." [color=orange];
	j3060654953 [label="Evaluate expressions on HellStory counter",color=orange];
		j3060654953 -> j689294977 [label="x >= 21",color=purple];
		j3060654953 -> j1970552175 [label="x < 21",color=purple];
		j3060654953 -> j1970552175 [label="false",color=purple];
	j689294977 [label="Ich habe das Serum vielleicht freiwillig eingenommen – aber ich habe mich nicht dazu bereit erklärt, mir von diesen beiden Undankbaren rund um die Uhr Predigten anzuhören.  ",shape=box,color=blue];
		j689294977 -> j4262066255;
	j1970552175 [label="Es ist Albrechts Schuld, dass ich so bin! Es ist seine Schuld, dass ich hier mit ihnen gefangen bin, nicht meine! Ich hatte mit dieser abscheulichen Situation nichts zu tun!",shape=box,color=blue];
		j1970552175 -> j4262066255;
	j4262066255 [label="Sie können ihre Beschwerden bei ihrem hochverehrten \"Kardinal\" vorbringen, nicht bei mir.",shape=box,color=blue];
		j4262066255 -> j3432053550;
		j4262066255 -> j2781829046;
		j4262066255 -> j416582258;
	j3432053550 [label="Sie meinen es gut, auch wenn sie es nicht auf die beste Art und Weise angehen.",shape=box,color=red];
		j3432053550 -> j301554335;
	j2781829046 [label="Hast du nicht das Gefühl, dass dir für deine Taten vergeben werden muss?",shape=box,color=red];
		j2781829046 -> j749733110;
	j416582258 [label="Sie versuchen nur, dir zu helfen.",shape=box,color=red];
		j416582258 -> j3471635193;
	j301554335 [label="Add -1 to Thermostat counter",color=orange];
		j301554335 -> j1761741151;
	j749733110 [label="Add 1 to Thermostat counter",color=orange];
		j749733110 -> j2473846789;
	j3471635193 [label="\"Helfen.\" Ja. \"Hilfe.\" Verzeih mir, dass ich ihre Art der \"Hilfe\" als äußerst \"unbehilflich\" empfinde.",shape=box,color=blue];
		j3471635193 -> j153142695;
	j1761741151 [label="Ja, das ist das Tragische an der ganzen Sache. Sie glauben tatsächlich, dass sie versuchen, \"Gutes\" zu tun.",shape=box,color=blue];
		j1761741151 -> j4162657006;
	j2473846789 [label="Vergeben von wem? Von dir? Von ihnen? Vom Butler? Von Albrecht? Oder von \"den Göttern\"?",shape=box,color=blue];
		j2473846789 -> j3634125986;
		j2473846789 -> j2752470379;
		j2473846789 -> j3814860241;
	j153142695 [label="Tatsächlich fände ich es \"hilfreicher\", wenn sie meinen Wein gegen eine ätzende Flüssigkeit tauschen würden, Usurpator.",shape=box,color=blue];
		j153142695 -> j325238320;
	j4162657006 [label="Und was denkst du? Glaubst du, ich brauche eine Art \"große Erlösung\"? Eine Art \"heilige Vergebung\"?",shape=box,color=blue];
		j4162657006 -> j937239071;
	j3634125986 [label="Du lässt einen wichtigen Punkt auf dieser Liste aus.",shape=box,color=red];
		j3634125986 -> j385467552;
	j2752470379 [label="Du bist ein Orokin. Du hast im Krieg und aufgrund der Natur deiner Gesellschaft Gräueltaten begangen. Du hast viel wiedergutzumachen.",shape=box,color=red];
		j2752470379 -> j1420701395;
	j3814860241 [label="Erkennst du denn nicht wenigstens, dass du in deinem Leben schreckliche Dinge getan hast?",shape=box,color=red];
		j3814860241 -> j3318095138;
	j325238320 [label="Das wäre zumindest effizienter.",shape=box,color=blue];
		j325238320 -> j3208970047;
	j937239071 [label="Evaluate expressions",color=orange];
		j937239071 -> j238463019 [label="RoatheTraitor2",color=purple];
		j937239071 -> j2642041272 [label="RoatheTraitor2",color=purple];
		j937239071 -> j2282920611 [label="RoatheTraitor2",color=purple];
		j937239071 -> j3946413550 [label="RoatheTraitor2",color=purple];
		j937239071 -> j238463019 [label="RoatheTraitor1",color=purple];
		j937239071 -> j2642041272 [label="RoatheTraitor1",color=purple];
		j937239071 -> j2282920611 [label="RoatheTraitor1",color=purple];
		j937239071 -> j3946413550 [label="RoatheTraitor1",color=purple];
		j937239071 -> j238463019 [label="RoatheExecutor2",color=purple];
		j937239071 -> j2642041272 [label="RoatheExecutor2",color=purple];
		j937239071 -> j2282920611 [label="RoatheExecutor2",color=purple];
		j937239071 -> j3946413550 [label="RoatheExecutor2",color=purple];
		j937239071 -> j238463019 [label="false",color=purple];
		j937239071 -> j2642041272 [label="false",color=purple];
		j937239071 -> j2282920611 [label="false",color=purple];
	j385467552 [label="Sag an. ",shape=box,color=blue];
		j385467552 -> j1668777178;
		j385467552 -> j1689879037;
		j385467552 -> j668835850;
	j1420701395 [label="Für die Gesellschaft der Orokin werde ich mich nicht entschuldigen, da ich sie nicht erschaffen habe. Ich war lediglich ein Teil von ihr. Und wenn man all jene verurteilen will, die an einem System teilhaben, in das sie hineingeboren wurden, würde man in seiner anmaßenden Selbstgerechtigkeit Milliarden verdammen. Und was den Rest betrifft?",shape=box,color=blue];
		j1420701395 -> j1432769041;
	j3318095138 [label="Und was, wenn ich es getan habe? Ich kann es jetzt nicht mehr ändern. Was bringt es, Schuldgefühle zu haben?",shape=box,color=blue];
		j3318095138 -> j2622451062;
		j3318095138 -> j1014953359;
	j3208970047 [label="Obwohl ich von beiden den Priester bevorzuge, muss ich zugeben. Er hört auf die Vernunft. Vielleicht erkennt er ja noch, dass die Gleichgültigkeit kein wirklicher Gott ist.",shape=box,color=blue];
		j3208970047 -> j2338476768;
	j238463019 [label="Ich denke, es ist wichtig, über unsere Taten nachzudenken, die anderen geschadet haben, und zu versuchen, sie wiedergutzumachen. Aber ich glaube nicht, dass die beiden den richtigen Weg gehen.",shape=box,color=red];
		j238463019 -> j88908736;
	j2642041272 [label="Ich glaube nicht, dass man irgendjemandem außer sich selbst vergeben muss. Bist du mit deinen Taten im Reinen? Dann ist es eben so.",shape=box,color=red];
		j2642041272 -> j2494709449;
	j2282920611 [label="Du wurdest in eine Gesellschaft hineingeboren, in der viele Verhaltensweisen der Orokin einfach ... normal waren. Erwartet wurden. Für dich war es nicht \"falsch\". Ich sage nicht, dass es dadurch in Ordnung ist, sondern nur, dass es verständlich ist.",shape=box,color=red];
		j2282920611 -> j2492233699;
	j3946413550 [label="Du hattest vor, die Orokin zu stürzen. Du wusstest, sie waren korrupt und du wolltest sie reformieren.",shape=box,color=red];
		j3946413550 -> j3606800777;
	j1668777178 [label="Dir selbst.",shape=box,color=red];
		j1668777178 -> j959970570;
	j1689879037 [label="Deinem eigenen Volk, das du im Begriff warst zu verraten.",shape=box,color=red];
		j1689879037 -> j1442345312;
	j668835850 [label="Den Sentients, die du abgeschlachtet hast.",shape=box,color=red];
		j668835850 -> j1432769041;
	j1432769041 [label="Es war Krieg. Und es liegt in der Natur des Krieges, diejenigen in großer Zahl zu töten, gegen die man kämpft. Trauerst du um die Grineer oder um die \"Corpus\", die du vernichtest?",shape=box,color=blue];
		j1432769041 -> j739993162;
		j1432769041 -> j1621059777;
		j1432769041 -> j2956487183;
	j2622451062 [label="Vergebung anderer ist wichtig.",shape=box,color=red];
		j2622451062 -> j3568936263;
	j1014953359 [label="Du kannst dein zukünftiges Verhalten ändern.",shape=box,color=red];
		j1014953359 -> j2297965065;
	j2338476768 [label="Tatsächlich kann ich ihn vielleicht sogar noch davon überzeugen, seine gesamte Religion zu hinterfragen – stell dir das vor! Ein Mann, der zwar fantastische und blutige Halluzinationen hat, aber auch Vernunft und Logik besitzt. Welch eine Rarität.",shape=box,color=blue];
		j2338476768 -> j169768787;
		j2338476768 -> j1407404097;
	j88908736 [label="Hm. Ich verstehe. Du beanstandest also nicht die Handlung an sich, sondern die Vorgehensweise. Hiermit widerrufe ich meine vorherige Zustimmung und ersetze sie durch Fassungslosigkeit.",shape=box,color=blue];
		j88908736 -> "Chat ends.";
	j2494709449 [label="Boolean RoatheVillainSelf is now true.",color=orange];
		j2494709449 -> j3829163780;
	j2492233699 [label="Boolean RoatheVillainOrokin is now true.",color=orange];
		j2492233699 -> j3829163780;
	j3606800777 [label="Ich denke daher, selbst wenn du vorhattest, das Imperium nach deinen eigenen Vorstellungen umzugestalten? Wusstest du, dass es sich ändern musste.",shape=box,color=red];
		j3606800777 -> j243676213;
		j3606800777 -> j180690623;
	j959970570 [label="Check boolean RoatheKnowsReset2",color=orange];
		j959970570 -> j2080654422 [label=true,color=green];
		j959970570 -> j2005873687 [label=false,color=brown];
	j1442345312 [label="Ich habe keine schlaflosen Nächte wegen Schuldgefühlen, mein eigenes Volk verraten zu haben, Usurpator. Glaub mir.",shape=box,color=blue];
		j1442345312 -> j2683381727;
	j739993162 [label="Nein. Aber die Sentients sind eine ganz andere Sache.",shape=box,color=red];
		j739993162 -> j3306620404;
	j1621059777 [label="Ja, das tue ich.",shape=box,color=red];
		j1621059777 -> j4177633775;
	j2956487183 [label="Wie ich über die Leben denke, die ich nehmen muss, ist meine Sache. Wir reden über dich.",shape=box,color=red];
		j2956487183 -> j569500486;
	j3568936263 [label="Warum? Damit ich in Ruhe gelassen werde? Damit ich nicht so etwas wie ein ... Verfluchter, ein sozialer Außenseiter bin?",shape=box,color=blue];
		j3568936263 -> j2744454719;
	j2297965065 [label="Aus Fehlern zu lernen ist wichtig, ja. Aber man muss keine \"Schuldgefühle\" haben, um \"Misserfolge\" zu verstehen.",shape=box,color=blue];
		j2297965065 -> j622457927;
	j169768787 [label="Lyon scheint mit genug eigenen Problemen zu kämpfen zu haben, denkst du nicht?",shape=box,color=red];
		j169768787 -> j2747940956;
	j1407404097 [label="Entschuldigung, was hast du vor?",shape=box,color=red];
		j1407404097 -> j952307522;
	j3829163780 [label="Deine Lebensumstände damals waren anders als unsere jetzt. Und was wir als grausam und schrecklich empfinden, wurde dir als ganz normaler Teil der Welt erklärt.",shape=box,color=red];
		j3829163780 -> j2442044201;
	j243676213 [label="Das entschuldigt zwar nicht alles, was du getan hast – Gräueltaten bleiben Gräueltaten und Schrecken bleiben Schrecken. Aber du hast es versucht.",shape=box,color=red];
		j243676213 -> j947767237;
	j180690623 [label="Aus meiner Sicht warst du im Krieg und hast versucht, dich in einer Gesellschaft von Soziopathen zurechtzufinden, während du gleichzeitig den Sturz des Systems geplant hast. Und dafür wurdest du als Teufel bezeichnet. Ich finde das nicht fair.",shape=box,color=red];
		j180690623 -> j3947379007;
	j2080654422 [label="Weil du weggerannt bist.",shape=box,color=red];
		j2080654422 -> j2340587127;
	j2005873687 [label="Weil du gescheitert bist.",shape=box,color=red];
		j2005873687 -> j2340587127;
	j2683381727 [label="Ich werde mich nicht für das Imperium der Orokin entschuldigen, da ich nicht sein Schöpfer, sondern lediglich ein Bewohner war. Genauso wenig werde ich die Schuld dafür übernehmen, dass ich seinen Untergang geplant habe. Wir haben verdient, was uns widerfahren ist, und noch Schlimmeres.",shape=box,color=blue];
		j2683381727 -> j2606612220;
	j3306620404 [label="Jede Situation ist eine \"andere Sache\", Usurpator. Der Kontext ist immer entscheidend. Und du betrachtest den \"Alten Krieg\" einfach mit der Klarheit der Nachbetrachtung.",shape=box,color=blue];
		j3306620404 -> j296053358;
	j4177633775 [label="Dann empfinde ich ein immenses Mitleid mit dir, Usurpator. Meine Empfehlung, nimm deine Aufgabe entweder an oder ziehe dich aus diesem Leben zurück und widme dich der Landwirtschaft.",shape=box,color=blue];
		j4177633775 -> j1326819478;
	j569500486 [label="Hm. Ich liebe es, wenn du so deutlich zeigst, dass ich dich provoziert habe, es ist einfach köstlich. Du lenkst das Gespräch ungeschickt ab.",shape=box,color=blue];
		j569500486 -> j83493729;
	j2744454719 [label="Sieh mich an, Usurpator. Sieh, was ich bin. Ein Orokin, aus seinem Reich vertrieben.",shape=box,color=blue];
		j2744454719 -> j1698556612;
	j622457927 [label="Und was ist letztendlich der Sinn der Vergebung? Von wem sollte ich um Vergebung streben? Von anderen? Damit ich nicht zum Verfluchten werde?",shape=box,color=blue];
		j622457927 -> j2744454719;
	j2747940956 [label="Und genau damit will ich ihm helfen! Ich versuche lediglich, ihm seine Unsicherheit bezüglich der Gleichgültigkeit und dem, was Entrati ihm gesagt hat, zu nehmen.",shape=box,color=blue];
		j2747940956 -> j3556686190;
	j952307522 [label="Nichts Gefährliches, egal was die lästige, herumschwebende Schnake dir erzählt. Ich versuche ihm lediglich zu helfen, seine Unsicherheit bezüglich der Gleichgültigkeit und dem, was Entrati ihm gesagt hat, zu überwinden.",shape=box,color=blue];
		j952307522 -> j3556686190;
	j2442044201 [label="+10 Chemistry",color=orange];
		j2442044201 -> j364302038;
	j947767237 [label="Boolean RoatheVillainOrokin is now true.",color=orange];
		j947767237 -> j2442044201;
	j3947379007 [label="Boolean RoatheVillainShortcut is now true.",color=orange];
		j3947379007 -> j4176730125;
	j2340587127 [label="Boolean RoatheForgivenessShortcut is now true.",color=orange];
		j2340587127 -> j1933300832;
	j2606612220 [label="Gibt es etwas, wofür ich mich schuldig fühle? Die Tatsache, dass die Tenno letztendlich alles niederbrannten und nicht ich.",shape=box,color=blue];
		j2606612220 -> j533316691;
	j296053358 [label="Wenn du alle vergangenen Handlungen mit allen Informationen, die dir in der Zukunft zur Verfügung stehen, beurteilst, wirst du unaufhörlich beschämt sein.",shape=box,color=blue];
		j296053358 -> j1918970185;
	j1326819478 [label="Letzteres wäre allerdings wirklich eine Schade. Es ist ein Vergnügen, dir bei der Arbeit zuzusehen. Nicht besonders effizient - aber wunderbar spektakulär.",shape=box,color=blue];
		j1326819478 -> j1071609814;
	j83493729 [label="Ich vermute jedoch, wenn man Jahrhunderte allein verbringt und niemanden hat, mit dem man sprechen kann außer den ausgedachten Schöpfungen der eigenen Fantasie, dass dies die Möglichkeiten zur Verbesserung der sozialen Fähigkeiten einschränkt.",shape=box,color=blue];
		j83493729 -> j90560214;
	j1698556612 [label="Ich war zu meiner Zeit \"der Teufel von Tau\". Und hier bin ich bereits \"der Teufel\" für alle, die mir begegnen.",shape=box,color=blue];
		j1698556612 -> j240710425;
	j3556686190 [label="Entrati sagte ihm, seine \"Visionen\" seien nicht ein Produkt Luas, sondern der Gleichgültigkeit. Das führt ihn in eine Art \"Glaubenskrise\".",shape=box,color=blue];
		j3556686190 -> j3639968093;
	j364302038 [label="Wie schön zu wissen, dass das Konzept von Abstufung und Scharfsinn doch nicht ausgestorben ist. Ja, du hast vollkommen recht. Ich bin das Produkt einer anderen Zeit, einer anderen Ära, einer anderen Gesellschaft.",shape=box,color=blue];
		j364302038 -> j3955286529;
	j4176730125 [label="+20 Chemistry",color=orange];
		j4176730125 -> j3601460263;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j533316691 [label="Boolean RoatheForgivenessNoGuilt is now true.",color=orange];
		j533316691 -> j1933300832;
	j1918970185 [label="Akzeptiere, was in der Vergangenheit geschah, und geh deinen Weg.",shape=box,color=blue];
		j1918970185 -> j1191814664;
	j1071609814 [label="Du machst du das Schlachtfeld \"unterhaltsam\". ",shape=box,color=blue];
		j1071609814 -> j1191814664;
	j90560214 [label="Streite mit dem Priester, ihr braucht beide die Übung.",shape=box,color=blue];
		j90560214 -> j4081414586;
	j240710425 [label="Albrecht hielt es für angebracht, dafür zu sorgen, dass dieser Name dauerhaft ist.",shape=box,color=blue];
		j240710425 -> j1191814664;
	j3639968093 [label="Ich versuche ihn jedoch davon zu überzeugen, dass dies nicht der Fall ist und dass auch kein \"Gott\" sie geschickt hat, da es keine \"Götter\" gibt. Er ist einfach nur krank.",shape=box,color=blue];
		j3639968093 -> j2054822353;
		j3639968093 -> j2175205591;
	j3955286529 [label="Ich habe die Grausamkeit und die Gräueltaten meines Volkes jedoch als solche erkannt. Es gab Tiefpunkte, zu denen viele meiner Art herabsanken, die selbst ich nicht ertragen konnte.",shape=box,color=blue];
		j3955286529 -> j2560097755;
	j3601460263 [label="Ich wusste doch, dass ich dich aus gutem Grund mochte, Usurpator. Endlich! Jemand, der mich wertschätzt! Hat ja nur ... wie viele Jahrhunderte gedauert?!",shape=box,color=blue];
		j3601460263 -> j230649661;
	j1191814664 [label="Hier mein Rat an dich: Vernichte alle Schuldgefühle in deinem Herzen wegen deiner Taten, so wie ich es getan habe. Stoße ihnen ein Messer in die Brust, bis sie tot sind.",shape=box,color=blue];
		j1191814664 -> j664163532;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j2054822353 [label="Möchte Lyon deine Hilfe?",shape=box,color=red];
		j2054822353 -> j1527704601;
	j2175205591 [label="Und du denkst, dass das die Sache für ihn besser macht?",shape=box,color=red];
		j2175205591 -> j2794612309;
	j2560097755 [label="Aber solche Angelegenheiten sind ... kompliziert. Und ich weiß es zu schätzen, dass du das verstehst. Ach. Der Butler wirft mir einen bösen Blick zu. Ich muss dieses Gespräch beenden. Wir sprechen bald wieder.",shape=box,color=blue];
		j2560097755 -> "Chat ends.";
	j230649661 [label="Na toll. Der Butler wirft mir einen bösen Blick zu. Ich muss dieses Gespräch beenden. Wir sprechen bald wieder.",shape=box,color=blue];
		j230649661 -> "Chat ends.";
	j664163532 [label="Schuld ist nichts anderes als ein Verräter in der Nacht, der dir alles raubt, was dir lieb und teuer ist. Sie fügt dir nur Schaden zu.",shape=box,color=blue];
		j664163532 -> j533316691;
	j1527704601 [label="Er hat sich nicht geweigert zuzuhören. Er hat mir nicht gesagt, aufzuhören zu reden. Das würde ich, wenn er es will.",shape=box,color=blue];
		j1527704601 -> j95130269;
	j2794612309 [label="Ist es für religiös orientierte besser, ihn zu manipulieren, nur weil sie es können? Seine Halluzinationen als \"Visionen\" abzutun, anstatt ihm zu helfen?",shape=box,color=blue];
		j2794612309 -> j3936833263;
	j95130269 [label="Es macht mich wütend zu sehen, wie diejenigen um Lyon herum ihn ausnutzen und manipulieren, ob sie es nun merken oder nicht. Alles im Namen von \"Religion\" und \"Glauben\".",shape=box,color=blue];
		j95130269 -> j3936833263;
	j3936833263 [label="Ich habe gelesen, was passiert ist. Diese ... \"Red Veil\" hätten all die Jahrhunderte lang versuchen können, den Tenno aus seinem Harrow zu befreien. Aber sie taten es nicht. Sie ließen ihn verkümmern und sterben.",shape=box,color=blue];
		j3936833263 -> j1475262024;
	j1475262024 [label="Und warum? Um sich gegen einen ... theoretischen \"Gott des Voids\" zu verteidigen.",shape=box,color=blue];
		j1475262024 -> j3242460512;
		j1475262024 -> j3359998917;
	j3242460512 [label="Du denkst, Rells Opfer war umsonst?",shape=box,color=red];
		j3242460512 -> j3216275205;
	j3359998917 [label="Rell war das Einzige, was das Ding all die Jahre zurückgehalten hat.",shape=box,color=red];
		j3359998917 -> j1541629624;
	j3216275205 [label="Nein. Er wollte vor etwas schützen. Aber wer weiß, wie sehr er die Lage dadurch verschlimmert hat? Wer weiß, wie viel von sich selbst, seiner Angst und Furcht er über all die Jahrhunderte hinweg damit genährt hat?",shape=box,color=blue];
		j3216275205 -> j874599184;
	j1541629624 [label="Oder er war all die Jahre das Einzige, was es genährt hat.",shape=box,color=blue];
		j1541629624 -> j874599184;
	j874599184 [label="Konzeptionelle Verkörperung manifestiert nur aus dem, was ihr zum Erschaffen gegeben wurde. Und der Void kann nur mit dem Stoff arbeiten, der ihm zum Nähen gegeben wird.",shape=box,color=blue];
		j874599184 -> j3159159206;
	j3159159206 [label="Wie viel hat dieser eine Tenno wohl allein in diese Existenz hineinfließen lassen? Er war ein wahrer Inbegriff von Qual, Schmerz, Verrat, Trauer ... und Einsamkeit ...",shape=box,color=blue];
		j3159159206 -> j3420848573;
	j3420848573 [label="Und die Gefühllosigkeit, die mit den Jahrtausenden einhergehen muss, die er allein an diesem Ort verbrachte und ins Nichts sprach. Was folgt daraus, wenn nicht Gleichgültigkeit?",shape=box,color=blue];
		j3420848573 -> j1266821547;
		j3420848573 -> j1365040065;
	j1266821547 [label="Es ist möglich, dass das, was du sagst, stimmt. Ich weiß ... es einfach nicht. Und ich weiß auch nicht, ob es nicht stimmt.",shape=box,color=red];
		j1266821547 -> j1067984700;
	j1365040065 [label="Es war schon mächtig, bevor es Rell erreichte. Er hätte sich nicht ohne triftigen Grund so geopfert.",shape=box,color=red];
		j1365040065 -> j230106269;
	j1067984700 [label="+10 Chemistry",color=orange];
		j1067984700 -> j3337042507;
	j230106269 [label="Das sind auch Kinderalbträume. Für ein sechsjähriges Kind sind sie die mächtigsten Wesen im Universum. Für einen Erwachsenen hingegen sind sie nichts weiter als ein Fussel, das sich in einem Lüftungsschacht verfangen hat und zu nah ans Licht geraten ist.",shape=box,color=blue];
		j230106269 -> j507953325;
	j3337042507 [label="Ich glaube, um mehr kann ich gar nicht bitten, als dass du einfach zugibst, dass du nicht genau weißt, womit wir es zu tun haben.",shape=box,color=blue];
		j3337042507 -> j1990431745;
	j507953325 [label="Wir machen aus Staubkörnern Berge, einfach weil wir einen Grund brauchen, unglücklich zu sein und uns selbst zu zerstören.",shape=box,color=blue];
		j507953325 -> j2208275316;
	j1990431745 [label="Das ist ein wunderbarer Ausgangspunkt. Und es ist eine bewundernswerte Eigenschaft, die jeder besitzen sollte: die einfache Fähigkeit, einfach zu sagen ... \"Ich weiß es nicht.\"",shape=box,color=blue];
		j1990431745 -> j248843136;
	j2208275316 [label="Die Menschheit auf einen Blick.",shape=box,color=blue];
		j2208275316 -> j3208040028;
	j248843136 [label="Wenn wir Orokin das hin und wieder hätten aufbringen können, hätten wir vielleicht überlebt.",shape=box,color=blue];
		j248843136 -> j3208040028;
	j3208040028 [label="Boolean RoatheMITW3 is now true.",color=orange];
		j3208040028 -> j1933300832;
}