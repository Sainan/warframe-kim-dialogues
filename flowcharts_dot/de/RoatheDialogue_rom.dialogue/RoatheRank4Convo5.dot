digraph {
	2664 [label="RoatheRank4Convo5 begins.",color=orange];
		2664 -> 2665;
	2665 [label="An wie viel erinnerst du dich noch aus deiner Zeit im Imperium, Usurpator? Es scheint bestenfalls bruchstückhaft zu sein. Nicht, dass ich mir da ein Urteil anmaßen würde.",shape=box,color=blue];
		2665 -> 2668;
		2665 -> 2666;
		2665 -> 2667;
		2665 -> 2669;
	2668 [label="Genug, um zu wissen, dass ihr alle es verdient habt, zu brennen.",shape=box,color=red];
		2668 -> 2671;
	2666 [label="Bruchstückhaft in der Tat. Warum?",shape=box,color=red];
		2666 -> 2670;
	2667 [label="Ich war noch ziemlich jung, als wir an Bord der Zariman gebracht wurden. Und danach ... nun ja.",shape=box,color=red];
		2667 -> 2670;
	2669 [label="[Ende.]",shape=box,color=red];
		2669 -> 2672;
	2671 [label="Das ist durchaus berechtigt. Allerdings fehlen dir ganze Bereiche unserer Geschichte und Kultur. Ich weiß, dass wir nach dem Fall wenig Zuneigung erfuhren, aber ...",shape=box,color=blue];
		2671 -> 2674;
	2670 [label="Hm. Es erscheint mir einfach seltsam, dass so wenige vollständige Aufzeichnungen über unsere Gesellschaft und Kultur erhalten geblieben sind. Ich weiß, dass wir nach dem Fall wenig Zuneigung erfuhren, aber ...",shape=box,color=blue];
		2670 -> 2673;
	2672 [label="Chat ends.",color=orange];
	2674 [label="Nicht einmal eine Erwähnung dessen, was mit den Kryoleen geschehen ist?",shape=box,color=blue];
		2674 -> 2677;
		2674 -> 2678;
	2673 [label="Nicht einmal eine Erwähnung dessen, was mit den Kryoleen geschehen ist?",shape=box,color=blue];
		2673 -> 2675;
		2673 -> 2676;
	2677 [label="Wird das am Ende eine schreckliche Form einer Folter der Orokin sein?",shape=box,color=red];
		2677 -> 2680;
	2678 [label="Ich glaube, ich würde mich an das Wort erinnern, wenn ich es schon einmal gehört hätte.",shape=box,color=red];
		2678 -> 2681;
	2675 [label="Den ... was?",shape=box,color=red];
		2675 -> 2679;
	2676 [label="Ich glaube, ich würde mich an das Wort erinnern, wenn ich es schon einmal gehört hätte.",shape=box,color=red];
		2676 -> 2679;
	2680 [label="Schockierenderweise? Nein. Vielleicht liegt es daran, dass ich die letzten ... viel zu vielen Jahre mit diesen beiden Eiferern in einer Krypta gefangen verbracht habe, aber es ist für mich schockierend, dass absolut keine Aufzeichnungen darüber erhalten geblieben sind, wie die Orokin mit ihren Toten umgegangen sind.",shape=box,color=blue];
		2680 -> 2684;
		2680 -> 2685;
	2681 [label="Vielleicht liegt es daran, dass ich die letzten ... viel zu vielen Jahre mit diesen beiden Eiferern in einer Krypta gefangen verbracht habe, aber es ist für mich schockierend, dass absolut keine Aufzeichnungen darüber erhalten geblieben sind, wie die Orokin mit ihren Toten umgegangen sind.",shape=box,color=blue];
		2681 -> 2686;
		2681 -> 2687;
	2679 [label="Vielleicht liegt es daran, dass ich die letzten ... viel zu vielen Jahre mit diesen beiden Eiferern in einer Krypta gefangen verbracht habe, aber es ist für mich schockierend, dass absolut keine Aufzeichnungen darüber erhalten geblieben sind, wie die Orokin mit ihren Toten umgegangen sind.",shape=box,color=blue];
		2679 -> 2682;
		2679 -> 2683;
	2684 [label="Ich wusste nicht, dass ihr gestorben seid. Ihr habt nur neue Körper im Yuvan-Theater gestohlen.",shape=box,color=red];
		2684 -> 2690;
	2685 [label="Ich dachte, ihr hättet Menschen gestohlen, um dieses Problem zu lösen. Ihr habt den Tod verhöhnt.",shape=box,color=red];
		2685 -> 2691;
	2686 [label="Ich wusste nicht, dass ihr gestorben seid. Ihr habt nur neue Körper im Yuvan-Theater gestohlen.",shape=box,color=red];
		2686 -> 2692;
	2687 [label="Sprich weiter.",shape=box,color=red];
		2687 -> 2693;
	2682 [label="Ich wusste nicht, dass ihr gestorben seid. Ihr habt nur neue Körper im Yuvan-Theater gestohlen.",shape=box,color=red];
		2682 -> 2688;
	2683 [label="Sprich weiter.",shape=box,color=red];
		2683 -> 2689;
	2690 [label="Ja, aber was ist mit all den anderen, die zwar \"nahe\" waren, aber \"noch nicht wichtig genug\"? Die Archimeden? Oder die rangniedrigeren Orokin? Es gab immer Hierarchieebenen innerhalb von Hierarchieebenen. Selbst wenn die Grenzen aus Glas waren, existierten sie. Glaub mir.",shape=box,color=blue];
		2690 -> 2695;
	2691 [label="Das taten wir tatsächlich. Bei jeder sich bietenden Gelegenheit. Aber nicht alle wurden verschont, oder? Was ist mit denen, die \"nahe\" waren, aber \"nicht wichtig genug\"? Den Archimeden? Den rangniedrigeren Orokin?",shape=box,color=blue];
		2691 -> 2696;
	2692 [label="Ja, aber was ist mit all den anderen, die zwar \"nahe\" waren, aber \"noch nicht wichtig genug\"? Die Archimeden? Oder die rangniedrigeren Orokin? Es gab immer Hierarchieebenen innerhalb von Hierarchieebenen. Selbst wenn die Grenzen aus Glas waren, existierten sie. Glaub mir.",shape=box,color=blue];
		2692 -> 2695;
	2693 [label="Denk an all jene, die \"nahe\" waren, aber \"nicht wichtig genug\". Die Archimeden. Die rangniedrigeren Orokin. Es gab immer Hierarchien innerhalb von Hierarchien. Selbst wenn die Grenzen aus Glas waren, existierten sie. Glaub mir.",shape=box,color=blue];
		2693 -> 2695;
	2688 [label="Ja, aber was ist mit all den anderen, die zwar \"nahe\" waren, aber \"noch nicht wichtig genug\"? Die Archimeden? Oder die rangniedrigeren Orokin? Es gab immer Hierarchieebenen innerhalb von Hierarchieebenen. Selbst wenn die Grenzen aus Glas waren, existierten sie. Glaub mir.",shape=box,color=blue];
		2688 -> 2694;
	2689 [label="Denk an all jene, die \"nahe\" waren, aber \"nicht wichtig genug\". Die Archimeden. Die rangniedrigeren Orokin. Es gab immer Hierarchien innerhalb von Hierarchien. Selbst wenn die Grenzen aus Glas waren, existierten sie. Glaub mir.",shape=box,color=blue];
		2689 -> 2694;
	2695 [label="Nicht alle hatten das Glück, jedes Mal neues Fleisch geschenkt zu bekommen, wenn ihr alter Körper verfiel. Aber ich bin sicher, du findest das Yuvan-Theater eine widerliche Praxis, nicht wahr?",shape=box,color=blue];
		2695 -> 2699;
		2695 -> 2700;
	2696 [label="Nicht alle hatten das Glück, jedes Mal neues Fleisch geschenkt zu bekommen, wenn ihr alter Körper verfiel. Du hältst ganz offenbar das Yuvan-Theater für eine widerliche Praxis.",shape=box,color=blue];
		2696 -> 2701;
		2696 -> 2700;
	2694 [label="Nicht alle hatten das Glück, jedes Mal neues Fleisch geschenkt zu bekommen, wenn ihr alter Körper verfiel. Aber ich bin sicher, du findest das Yuvan-Theater eine widerliche Praxis, nicht wahr?",shape=box,color=blue];
		2694 -> 2697;
		2694 -> 2698;
	2699 [label="Ich kenne mich mit dieser Praxis nicht ausreichend aus, um eine Beurteilung abgeben zu können.",shape=box,color=red];
		2699 -> 2704;
	2700 [label="Ja, ich finde es abscheulich, was ihr alle getan habt. Alles, was über das Yuvan-Theater geschrieben wurde, besagt, dass ihr Kinder entführt und ihre Erinnerungen ausgelöscht habt.",shape=box,color=red];
		2700 -> 2705;
	2701 [label="Wie könnte ich das nicht? Ihr habt Kinder aus ihren Familien entführt und ihre Erinnerungen ausgelöscht, um sie durch eure eigenen zu ersetzen!",shape=box,color=red];
		2701 -> 2706;
	2697 [label="Ich kenne mich mit dieser Praxis nicht ausreichend aus, um eine Beurteilung abgeben zu können.",shape=box,color=red];
		2697 -> 2702;
	2698 [label="Ja, ich finde es abscheulich, was ihr alle getan habt. Alles, was über das Yuvan-Theater geschrieben wurde, besagt, dass ihr Kinder entführt und ihre Erinnerungen ausgelöscht habt.",shape=box,color=red];
		2698 -> 2703;
	2704 [label="+5 Chemistry",color=orange];
		2704 -> 2709;
	2705 [label="\"Alles, was über das Yuvan-Theater geschrieben wurde, besagt ...\" Wo sind all diese Dinge aufgezeichnet? Viel wichtiger jedoch: Wer hat all diese Dinge geschrieben?",shape=box,color=blue];
		2705 -> 2708;
	2706 [label="Und woher weißt du das alles? Hast du selbst einmal ein Yuvan-Theater erlebt?",shape=box,color=blue];
		2706 -> 2710;
		2706 -> 2711;
		2706 -> 2712;
	2702 [label="+5 Chemistry",color=orange];
		2702 -> 2707;
	2703 [label="Dennoch sagtest du gerade, dass nur noch Bruchstücke unserer Geschichte und unserer kulturellen Aufzeichnungen erhalten geblieben sind. Und wo sind all diese Dinge aufgezeichnet? Noch wichtiger: Wer hat all diese Dinge geschrieben?",shape=box,color=blue];
		2703 -> 2708;
	2709 [label="Du hältst dich mit einem Urteil zurück, bis du alle Informationen hast? Donnerwetter, Usurpator! Du klingst intelligent! Welch eine Seltenheit!",shape=box,color=blue];
		2709 -> 2713;
	2708 [label="Es sind Geschichten, erzählt von jenen, die ein ausgeprägtes Interesse daran haben, jeden Aspekt der Orokin so verheerend und böse wie möglich darzustellen.",shape=box,color=blue];
		2708 -> 2714;
	2710 [label="Nein.",shape=box,color=red];
		2710 -> 2715;
	2711 [label="Ja.",shape=box,color=red];
		2711 -> 2716;
	2712 [label="Es spielt keine Rolle, ob ich es erlebt habe oder nicht, die Sachlage ist eindeutig.",shape=box,color=red];
		2712 -> 2717;
	2707 [label="Du hältst dich mit einem Urteil zurück, bis du alle Informationen hast? Donnerwetter, Usurpator! Du klingst intelligent! Welch eine Seltenheit!",shape=box,color=blue];
		2707 -> 2713;
	2713 [label="Erlaube mir, dir einen anderen Blickwinkel auf die Geschichte zu eröffnen, wenn ich darf. Überlege einmal, woher die Berichte über das Yuvan-Theater stammen, die du vielleicht gehört hast.",shape=box,color=blue];
		2713 -> 2708;
	2714 [label="Denn diejenigen, die sämtliche Stützstrukturen der Gesellschaft des Ursprungssystems zerstören und sie ins totale Chaos stürzen, müssen denjenigen, die auf diese Gesellschaft angewiesen sind, einen guten Grund dafür geben.",shape=box,color=blue];
		2714 -> 2718;
	2715 [label="Dann stützt du dich auf Berichte aus zweiter Hand. Überlege, wo diese Berichte verfasst wurden. Noch wichtiger ist jedoch, wer sie geschrieben hat.",shape=box,color=blue];
		2715 -> 2708;
	2716 [label="Ha! Du lügst.",shape=box,color=blue];
		2716 -> 2719;
	2717 [label="Ist es so? Überlege, wo diese Berichte verfasst wurden. Noch wichtiger ist jedoch, wer all diese Berichte verfasst hat.",shape=box,color=blue];
		2717 -> 2708;
	2718 [label="Stell dir das Leben eines Durchschnittsmenschen auf einem Relais vor, Usurpator. Fernab der Prüfungen und Leiden der Tenno. Eines Menschen, dem der Große Krieg völlig gleichgültig war.",shape=box,color=blue];
		2718 -> 2720;
	2719 [label="Du stützt dich auf Berichte aus zweiter Hand. Überlege, wo diese Berichte verfasst wurden. Noch wichtiger ist jedoch, wer sie geschrieben hat.",shape=box,color=blue];
		2719 -> 2708;
	2720 [label="Nach dem Fall der Orokin stürzten sie im entstandenen Machtvakuum in die Hölle. Erklärungen mussten erfunden werden. Bildnisse mussten angefertigt und verbrannt werden. Wir mussten zu Monstern in der Dunkelheit gemacht werden.",shape=box,color=blue];
		2720 -> 2721;
		2720 -> 2722;
	2721 [label="Willst du mir etwa sagen, dass ihr keine Kinder gegen ihren Willen für das Yuvan-Theater entführt habt?",shape=box,color=red];
		2721 -> 2723;
	2722 [label="Was geschah also tatsächlich im Yuvan-Theater?",shape=box,color=red];
		2722 -> 2724;
	2723 [label="Nein, das ist vollkommen richtig.",shape=box,color=blue];
		2723 -> 2725;
	2724 [label="+5 Chemistry",color=orange];
		2724 -> 2726;
	2725 [label="Ich möchte dich lediglich bitten, deine Quellen zu überprüfen.",shape=box,color=blue];
		2725 -> 2727;
	2726 [label="Zu behaupten, wir hätten keine Opfer gegen ihren Willen gebracht, ist falsch. Das haben wir. Aber das ist nicht die ganze Wahrheit. Solche Dinge sind selten so einfach und nie so schwarz-weiß.",shape=box,color=blue];
		2726 -> 2728;
	2727 [label="Denn es ist nicht die ganze Wahrheit. Die Dinge sind selten so einfach und nie so schwarz-weiß. Die Welt ist grau, Usurpator. Grenzen lassen sich nicht so leicht ziehen.",shape=box,color=blue];
		2727 -> 2729;
	2728 [label="Die Welt ist grau, Usurpator. Grenzen lassen sich nicht so einfach ziehen.",shape=box,color=blue];
		2728 -> 2729;
	2729 [label="Diese Praxis begann nicht auf so schändliche Weise. Anfangs galt es als höchste Ehre, sich selbst hinzugeben, damit das Reich ungebrochen fortbestehen konnte. Unbeugsam. Damit das Werk weitergehen konnte.",shape=box,color=blue];
		2729 -> 2730;
	2730 [label="Es begann auch nicht mit den Jungen. Es begann mit denen, die einfach mehr Jahre zu leben hatten. Doch dann wurden diejenigen, die sich freiwillig meldeten ... immer jünger und jünger. Hingabe ist eine starke Droge.",shape=box,color=blue];
		2730 -> 2731;
	2731 [label="Ich habe etwas Ähnliches bei denen beobachtet, die sich freiwillig zum Krieg meldeten. Sie logen auf den Formularen über ihr Alter, um \"den Kampf für das Gute zu führen\". Sie ahnten nicht, dass sie damit einen gefährlichen Präzedenzfall für all jene schufen, die unfreiwillig nach ihnen kommen würden.",shape=box,color=blue];
		2731 -> 2732;
	2732 [label="Irgendwann erkannte ein Exekutor, dass es als ... Strafmaßnahme eingesetzt werden konnte. Dass sich bestimmte Städte ... oder gar ganze Planeten unter Kontrolle halten ließen, wenn man mit dem Yuvan-Theater drohte. Wenn die Opfer besonders brutal eingefordert wurden.",shape=box,color=blue];
		2732 -> 2733;
		2732 -> 2734;
	2733 [label="Und wie stehst du dazu?",shape=box,color=red];
		2733 -> 2735;
	2734 [label="Hast du jemals an einem unfreiwilligen Opfer teilgenommen?",shape=box,color=red];
		2734 -> 2736;
	2735 [label="+5 Chemistry",color=orange];
		2735 -> 2737;
	2736 [label="Ich will dich nicht anlügen. Ich habe es getan. Und du kannst mich deswegen ruhig für ein Monster halten. Aber wenn deine gesamte Gesellschaft auf der jahrhundertelangen Normalisierung von etwas beruht, ist es sehr schwer, sich davon abzuwenden.",shape=box,color=blue];
		2736 -> 2738;
	2737 [label="Hm. Mit gemischten Gefühlen. Einerseits habe ich selbst schon oft am Theater teilgenommen. Es wäre heuchlerisch, es zu verurteilen. Wenn eine ganze Gesellschaft auf der jahrhundertelangen Normalisierung von etwas beruht, ist es sehr schwer, sich davon abzuwenden.",shape=box,color=blue];
		2737 -> 2739;
	2738 [label="Selbst im Nachhinein oder in einem Moment der Klarheit ist es so überdeutlich.",shape=box,color=blue];
		2738 -> 2740;
	2739 [label="Andererseits wird im Nachhinein, isoliert betrachtet, das Grauen der Tat ganz deutlich.",shape=box,color=blue];
		2739 -> 2740;
	2740 [label="+5 Chemistry",color=orange];
		2740 -> 2741;
	2741 [label="Niemand sollte ewig leben, Usurpator. Und das Theater ist der Beweis dafür.",shape=box,color=blue];
		2741 -> 2742;
	2742 [label="Chat ends.",color=orange];
}