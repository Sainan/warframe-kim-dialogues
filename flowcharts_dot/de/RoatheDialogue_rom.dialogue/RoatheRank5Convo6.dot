	4805 [label="Chat ends.",color=orange];
	4806 [label="Was ich von Marie halte? Abgesehen davon, dass ich versuche, dich davon zu überzeugen, dass sie uns für ein oder zwei Nächte Gesellschaft leistet, Drifter-Schatz? (Nur ein Witz. Ein Witz.)",shape=box,color=blue];
		4806 -> 4821;
	4807 [label="Was ich von Marie halte? Abgesehen davon, dass ich versuche, dich davon zu überzeugen, dass ich euch für ein oder zwei Nächte Gesellschaft leiste? (Nur Spaß. Ein Spaß.)",shape=box,color=blue];
		4807 -> 4822;
	4808 [label="Wie hast du es bloß geschafft, sie von davon zu überzeugen, dass Albrecht keine reine Weste hat? Du bist ja ein wahrer \"Wundertäter\". Vielleicht sollten sie nicht Sol und Lua, sondern dich verehren.",shape=box,color=blue];
		4808 -> 4823;
	4810 [label="Ich wusste nicht, dass sie weiterhin täglich Schmerzen hat. Sie verbirgt es, als ob sie nicht da wären. Sie hat nie darüber gesprochen, bis sie es dir erzählt hat. Du hast eine gewisse Kluft zwischen uns überbrückt.",shape=box,color=blue];
		4810 -> 4825;
	4809 [label="Ich wusste bis vor Kurzem nichts von ihrer Kindheit. Sie hat mir ihre Geschichte nie erzählt, bis sie sie dir anvertraute. Du hast eine gewisse Kluft zwischen uns überbrückt.",shape=box,color=blue];
		4809 -> 4824;
	4811 [label="Alles wie immer. Ich verbringe jede wache Minute damit, in meiner Verzweiflung nicht zu versuchen, mir mit meinen Krallen das Gesicht abzukratzen, um sie zu übertönen.",shape=box,color=blue];
		4811 -> 4826;
	4812 [label="Besser jetzt, da ich jemanden habe, bei dem ich meinen Frust ablassen kann. Aber im Ernst, die Spannungen zwischen uns haben sich deutlich gebessert.",shape=box,color=blue];
		4812 -> 4827;
	4813 [label="Ich bin nicht derjenige, zwischen dem und Lyon es \"läuft\", oder? Ha! Entschuldige den schlechten Witz. Ich konnte nicht anders, und du hast es mir viel zu leicht gemacht.",shape=box,color=blue];
		4813 -> 4828;
	4814 [label="Besser als es zwischen dir und ihm läuft, wie es scheint. Wie hast du das bloß mit ihm verpfuscht? Er brauchte doch nur jemanden, der zuhört.",shape=box,color=blue];
		4814 -> 4829;
	4815 [label="Die Spannungen zwischen uns haben sich deutlich gebessert, insbesondere seit du ihm das Vertrauen gegeben hast, über seine Probleme zu sprechen.",shape=box,color=blue];
		4815 -> 4830;
	4816 [label="Die Spannungen zwischen uns haben sich deutlich gebessert, insbesondere seit du ihm das Vertrauen gegeben hast, über seine Probleme zu sprechen.",shape=box,color=blue];
		4816 -> 4831;
	4817 [label="Alles wie immer. Ich verbringe jede wache Minute damit, in meiner Verzweiflung nicht zu versuchen, mir mit meinen Krallen das Gesicht abzukratzen, um ihn zu übertönen.",shape=box,color=blue];
		4817 -> 4832;
	4820 [label="Ich gebe zu, dass ich sie nach und nach etwas erträglicher finde. Ich denke, das liegt vor allem daran, dass sie mich nach und nach aufgeben.",shape=box,color=blue];
		4820 -> 4835;
	4819 [label="Ich gebe zu, dass ich sie nach und nach etwas erträglicher finde. Ich denke, meine jüngsten Erkenntnisse könnten damit etwas zu tun haben.",shape=box,color=blue];
		4819 -> 4834;
	4818 [label="Ich frage mich immer öfter, ob mich die Tatsache, dass ich als Protoframe die Dunkle Spiegelung nicht nutzen kann, um meine Erinnerungen zurückzuholen ... ",shape=box,color=blue];
		4818 -> 4833;
	4821 [label="Ich frage mich, ob ihr klar ist, dass mein Sticheln nicht mehr dazu gedacht ist zu Nerven, sondern spielerisches Necken sein soll?",shape=box,color=blue];
		4821 -> 4836;
	4822 [label="Ich muss zugeben, ich mache dir keinerlei Vorwurf. Und das nicht nur, weil sie umwerfend aussieht. Ich habe Augen im Kopf. Diese Frau besitzt mehr Mitgefühl, als ich in ihrem Alter für möglich gehalten hätte.",shape=box,color=blue];
		4822 -> 4821;
	4823 [label="Pah. Genau diese Art von Aussage führte zum Aufstieg des Imperiums der Orokin. Diesen Fehler sollte dieses System nie wiederholen.",shape=box,color=blue];
		4823 -> 4821;
	4825 [label="Ich gebe zu, dass ich zu den Narren gehöre, von denen sie spricht, die sich nicht vorstellen können, Tag für Tag auf diese Weise zu leben.",shape=box,color=blue];
		4825 -> 4838;
	4824 [label="Undenkbar, dass ihre Familie sie auf die Straße geworfen hat. Sie. Marie. Diese Marie. Diejenige, die mehr Mitgefühl in sich hat, als man für möglich halten sollte?!",shape=box,color=blue];
		4824 -> 4837;
	4826 [label="Chat ends.",color=orange];
	4827 [label="Sie kennen mein ... Geheimnis. Die Wahrheit, dass ich das Serum freiwillig eingenommen habe.",shape=box,color=blue];
		4827 -> 4839;
		4827 -> 4840;
	4828 [label="Ich bewundere dich dafür, dass du dich diesem armen Irren gestellt hast. Er braucht Gesellschaft. Und die Zuneigung.",shape=box,color=blue];
		4828 -> 4841;
	4829 [label="Und du hast ihn ausgeschlossen. Schäm dich!",shape=box,color=blue];
		4829 -> 4842;
	4830 [label="Er erzählte mir von dem Tenno-Kind, das er früher gehört hat. Und, dass er es nun nicht mehr hört.",shape=box,color=blue];
		4830 -> 4843;
	4831 [label="Ich wusste erschreckend wenig darüber, was ihm angetan wurde. Erst als er es dir erzählte, war er bereit, es mir zu sagen.",shape=box,color=blue];
		4831 -> 4844;
	4832 [label="Chat ends.",color=orange];
	4835 [label="Ich scherze. Ich entwickle eine seltsame Zuneigung zu ihnen, trotz meines erneuten Vorsatzes, ihre Kritik an meinen Lebensentscheidungen auszuschließen.",shape=box,color=blue];
		4835 -> 4847;
		4835 -> 4848;
	4834 [label="Ich hatte erwartet, sie würden meine Reue mit Hohn begrüßen, mit Sticheleien wie \"Endlich, er sieht das Licht\" oder \"Wir haben es dir ja gesagt\". Aber weit gefehlt. Sie haben kaum ein Wort darüber verloren.",shape=box,color=blue];
		4834 -> 4846;
	4833 [label="... dennoch nicht davon abhält, mich einfach darin zu ertränken.",shape=box,color=blue];
		4833 -> 4845;
	4836 [label="Ich hoffe es. Es macht einfach zu viel Spaß, sie zu ärgern. Ihr dabei zuzusehen, wie sie wütend wird und mich in ihrer Muttersprache anschreit, ist mein neues Lieblingsvergnügen.",shape=box,color=blue];
		4836 -> 4849;
	4838 [label="Wie kann sie nur so gefasst bleiben? Geschweige denn Mitgefühl empfinden? Ich glaube, ich wäre in ihrem Zustand genauso verrückt geworden wie der Priester.",shape=box,color=blue];
		4838 -> 4821;
	4837 [label="Ich kann dir nicht beschreiben, wie sehr ich wünsche einen Helminth zu nutzen, um in die Vergangenheit zu reisen und ihre gesamte Familie zu ermorden. Ganz langsam. Aber ich fürchte, sie hätte etwas dagegen.",shape=box,color=blue];
		4837 -> 4850;
	4839 [label="Ich habe es ihnen nicht erzählt.",shape=box,color=red];
		4839 -> 4851;
	4840 [label="Wie haben sie es herausgefunden?",shape=box,color=red];
		4840 -> 4852;
	4841 [label="Aber im Ernst, die Spannungen zwischen uns haben sich deutlich verbessert.",shape=box,color=blue];
		4841 -> 4827;
	4842 [label="Chat ends.",color=orange];
	4843 [label="Ich nehme an, die Stimme wird ihn trotzdem in seinen alptraumhaften Wachträumen verfolgen. Der arme Mann wird immer die Grenze zwischen Realität und Fiktion hinterfragen.",shape=box,color=blue];
		4843 -> 4853;
	4844 [label="Ich kann dir nicht beschreiben, wie sehr ich wünsche einen Helminth zu nutzen, um in die Vergangenheit zu reisen und seine Eltern zu ermorden. Ganz langsam. Aber ich fürchte, er hätte etwas dagegen.",shape=box,color=blue];
		4844 -> 4854;
	4847 [label="Ihr drei steckt sowieso zusammen fest. Entrati hat dafür gesorgt. Also, schadet es ja nicht das Beste draus zu machen.",shape=box,color=red];
		4847 -> 4855;
	4848 [label="Das freut mich. Ich glaube, sie haben dich ehrlich gern.",shape=box,color=red];
		4848 -> 4856;
	4846 [label="Ich bin froh, dass sie es nicht taten. Ich will das nicht unter die Nase gerieben bekommen wie ein Hund, der auf den Teppich gepinkelt hat. Ich habe schon genug andere Sorgen.",shape=box,color=blue];
		4846 -> 4847;
		4846 -> 4848;
	4845 [label="Chat ends.",color=orange];
	4849 [label="Ein weiterer Grund für die Verbesserung unseres Verhältnisses? Sie kennen mein Geheimnis. Die Wahrheit, dass ich das Serum freiwillig eingenommen habe.",shape=box,color=blue];
		4849 -> 4857;
		4849 -> 4858;
	4850 [label="Rachemorde werden von Sol wahrscheinlich missbilligt usw. und so fort.",shape=box,color=blue];
		4850 -> 4821;
	4851 [label="Ich habe auch nicht behauptet, dass du das getan hast, Drifter-Schatz. Ich habe es ihnen gesagt.",shape=box,color=blue];
		4851 -> 4859;
	4852 [label="Ich habe es ihnen offenbart, Drifter-Schatz.",shape=box,color=blue];
		4852 -> 4859;
	4853 [label="Ein weiterer Grund jedoch, warum die Dinge zwischen und besser sind?",shape=box,color=blue];
		4853 -> 4827;
	4854 [label="Rachemorde werden von Lua wahrscheinlich missbilligt usw. und so fort.",shape=box,color=blue];
		4854 -> 4860;
	4855 [label="Ganz genau. Es macht keinen Sinn, sich mit seinen neuen Mitbewohnern zu verfeinden. Genau deshalb habe ich in Gallien ständig dieses Gebäck gestohlen.",shape=box,color=blue];
		4855 -> 4861;
	4856 [label="Trotz all meiner Bemühungen, ja. Und es ist einfach unfassbar. Und sie tun es trotzdem.",shape=box,color=blue];
		4856 -> 4862;
	4857 [label="Wie haben sie es herausgefunden?",shape=box,color=red];
		4857 -> 4863;
	4858 [label="Ich habe es ihnen nicht erzählt.",shape=box,color=red];
		4858 -> 4864;
	4859 [label="Evaluate expressions",color=orange];
		4859 -> 4865 [label="RoatheRedeemed",color=purple];
		4859 -> 4866 [label="RoatheVillain",color=purple];
		4859 -> 4867 [label="false",color=purple];
	4860 [label="Aber der andere Grund für die Verbesserung unserer Beziehungen?",shape=box,color=blue];
		4860 -> 4827;
	4861 [label="Hm. Vielleicht werde ich versuchen, hier dasselbe zu tun. Aber so oder so werde ich mein Bestes tun, um den Frieden zu wahren. Na ja. Meistens zumindest.",shape=box,color=blue];
		4861 -> 4868;
	4862 [label="+10 Chemistry",color=orange];
		4862 -> 4869;
	4863 [label="Ich habe es ihnen offenbart, Drifter-Schatz.",shape=box,color=blue];
		4863 -> 4870;
	4864 [label="Ich habe auch nicht behauptet, dass du das getan hast, Drifter-Schatz. Ich habe es ihnen gesagt.",shape=box,color=blue];
		4864 -> 4870;
	4865 [label="Es ist nur eine weitere Sache, die ich wiedergutmachen muss. Sie hätten die Wahrheit sowieso irgendwann herausgefunden. Besser, sie hören sie von mir selbst.",shape=box,color=blue];
		4865 -> 4871;
		4865 -> 4872;
	4866 [label="Es gibt nichts, wofür ich mich schämen muss. Es schien sinnlos, es zu verheimlichen. Sie hätten die Wahrheit ohnehin bald herausgefunden. Besser, sie hören sie von mir selbst. ",shape=box,color=blue];
		4866 -> 4871;
		4866 -> 4872;
	4867 [label="Sie hätten die Wahrheit sowieso irgendwann herausgefunden. Besser, sie hören sie von mir selbst.",shape=box,color=blue];
		4867 -> 4871;
		4867 -> 4872;
	4868 [label="+10 Chemistry",color=orange];
		4868 -> 4873;
	4869 [label="Ich werde mein Bestes tun, um dir nicht alles zu verderben, hm? Nun ja. Nicht, dass es nicht wieder gutzumachen wäre. Ich darf dir die Tage nicht zu langweilig machen, sonst wirst du noch verrückt wie der Priester.",shape=box,color=blue];
		4869 -> 4874;
	4870 [label="Evaluate expressions",color=orange];
		4870 -> 4875 [label="RoatheRedeemed",color=purple];
		4870 -> 4876 [label="RoatheVillain",color=purple];
		4870 -> 4877 [label="false",color=purple];
	4871 [label="Hat sich dadurch etwas geändert?",shape=box,color=red];
		4871 -> 4878;
	4872 [label="Wie hat Lyon reagiert?",shape=box,color=red];
		4872 -> 4879;
	4873 [label="Ich darf dir die Tage nicht zu langweilig machen, sonst wirst du noch verrückt wie der Priester.",shape=box,color=blue];
		4873 -> 4874;
	4874 [label="Chat ends.",color=orange];
	4875 [label="Es ist nur eine weitere Sache, die ich wiedergutmachen muss. Sie hätten die Wahrheit sowieso irgendwann herausgefunden. Besser, sie hören sie von mir selbst.",shape=box,color=blue];
		4875 -> 4880;
		4875 -> 4881;
	4876 [label="Es gibt nichts, wofür ich mich schämen muss. Es schien sinnlos, es zu verheimlichen. Sie hätten die Wahrheit ohnehin bald herausgefunden. Besser, sie hören sie von mir selbst. ",shape=box,color=blue];
		4876 -> 4880;
		4876 -> 4881;
	4877 [label="Sie hätten die Wahrheit sowieso irgendwann herausgefunden. Besser, sie hören sie von mir selbst.",shape=box,color=blue];
		4877 -> 4880;
		4877 -> 4881;
	4878 [label="Ich hatte erwartet, sie würden meine Reue mit Hohn begrüßen, mit Sticheleien wie \"Endlich, der Teufel wurde in die Knie gezwungen\". Aber weit gefehlt. Sie haben kaum ein Wort darüber verloren.",shape=box,color=blue];
		4878 -> 4882;
	4879 [label="Nicht, wie ich es erwartet hätte. Als ich eines Abends ein paar Nächte danach still und allein las, kam er von selbst auf mich zu.",shape=box,color=blue];
		4879 -> 4883;
	4880 [label="Hat sich dadurch etwas geändert?",shape=box,color=red];
		4880 -> 4884;
	4881 [label="Wie hat Marie reagiert?",shape=box,color=red];
		4881 -> 4885;
	4882 [label="Besonders Lyon. Ich glaube, er versteht, wie schwer es ist, sich die Vergangenheit vors Gesicht zu halten und sich den getroffenen Entscheidungen zu stellen. Siehe: Augenklappe.",shape=box,color=blue];
		4882 -> 4886;
	4883 [label="Er setzte sich neben mich und erzählte mir, wie er seinen Glauben infrage gestellt hat, seit Entrati ihm das Serum gegeben hat. Wie sehr er sich für seine Zweifel schämte. Wie sehr er es bereute, das Serum genommen zu haben.",shape=box,color=blue];
		4883 -> 4887;
	4884 [label="Ich hatte erwartet, sie würden meine Reue mit Hohn begrüßen, mit Sticheleien wie \"Endlich, der Teufel wurde in die Knie gezwungen\". Aber weit gefehlt. Sie haben kaum ein Wort darüber verloren.",shape=box,color=blue];
		4884 -> 4888;
	4885 [label="Nicht, wie ich es erwartet hätte. Sie sagte nichts. Stattdessen, hat sie mich ... umarmt.",shape=box,color=blue];
		4885 -> 4889;
	4886 [label="Check boolean LyonConfession2",color=orange];
		4886 -> 4890 [label=true,color=green];
		4886 -> 4891 [label=true,color=green];
		4886 -> 4891 [label=false,color=brown];
	4887 [label="Am wichtigsten jedoch, wie sehr er sich wünschte, alles vergessen zu können. Und dass wir drei vielleicht auf einer tieferen Ebene doch nicht gleich sind.",shape=box,color=blue];
		4887 -> 4892;
		4887 -> 4893;
	4888 [label="Insbesondere Marie. Ich glaube, sie versteht, dass es nichts bringt, mich ständig mit Angelegenheiten aus der Vergangenheit zu konfrontieren.",shape=box,color=blue];
		4888 -> 4894;
	4889 [label="Evaluate expressions",color=orange];
		4889 -> 4895 [label="RoatheRedeemed",color=purple];
		4889 -> 4896 [label="RoatheVillain",color=purple];
		4889 -> 4897 [label="false",color=purple];
	4890 [label="Ich glaube, er weiß auch, wie es ist, ein Produkt seiner Gesellschaft und seines Umfelds zu sein. Er hat vielleicht mehr Verständnis für deine Vergangenheit, als du denkst.",shape=box,color=red];
		4890 -> 4898;
	4891 [label="Ich bin einfach nur froh, dass ihr zwei überhaupt eine Art Freundschaft gefunden habt. Selbst wenn es nur ein Waffenstillstand ist.",shape=box,color=red];
		4891 -> 4899;
	4892 [label="Und was hast du getan?",shape=box,color=red];
		4892 -> 4900;
	4893 [label="Und was ist mit Marie?",shape=box,color=red];
		4893 -> 4901;
	4894 [label="Check boolean MarieEntratiCompleteA",color=orange];
		4894 -> 4902 [label=true,color=green];
		4894 -> 4903 [label=true,color=green];
		4894 -> 4903 [label=false,color=brown];
	4895 [label="Der alte Roathe hätte die Gelegenheit genutzt, sich ihre Nieren zu holen, aber ich stellte fest, dass ich dazu kein Verlangen mehr hatte.",shape=box,color=blue];
		4895 -> 4904;
	4896 [label="Es kostete mich all meine Willenskraft, ihr nicht die Nieren herauszureißen. Aber sie wollte mir einfach nur Trost spenden.",shape=box,color=blue];
		4896 -> 4905;
	4897 [label="Sie wollte mir lediglich einfach Trost spenden.",shape=box,color=blue];
		4897 -> 4906;
		4897 -> 4907;
	4898 [label="+10 Chemistry",color=orange];
		4898 -> 4908;
	4899 [label="+5 Chemistry",color=orange];
		4899 -> 4909;
	4900 [label="Ich habe ihm die Hand geschüttelt und ihm als Freund gedankt. Ich bin zwar ein Orokin, aber kein Monster.",shape=box,color=blue];
		4900 -> 4910;
	4901 [label="Als ich ihr die Wahrheit erzählte, die wir erfahren haben, sagte sie nichts. Stattdessen ... umarmte sie mich einfach.",shape=box,color=blue];
		4901 -> 4911;
	4902 [label="Vor allem nach allem, was sie über Entrati gelernt hat. Sie weiß, dass Menschen komplexer sein können als eine einfache Schwarz-Weiß-Malerei.",shape=box,color=red];
		4902 -> 4912;
	4903 [label="Ich bin einfach nur froh, dass ihr zwei überhaupt eine Art Freundschaft gefunden habt. Selbst wenn es nur ein Waffenstillstand ist.",shape=box,color=red];
		4903 -> 4913;
	4904 [label="Zum ersten Mal in meinem elenden Leben nahm ich das einfache Angebot des Trostes an, als das an, was es war.",shape=box,color=blue];
		4904 -> 4905;
	4905 [label="Es war eine einfache Art, mir zu sagen, dass es ihr vielleicht nicht annähernd so viel bedeutete wie mir. Und dass es ihr leid tat, wie sehr ich mir deswegen selbst wehgetan habe.",shape=box,color=blue];
		4905 -> 4906;
		4905 -> 4907;
	4906 [label="Und was ist mit Lyon?",shape=box,color=red];
		4906 -> 4914;
	4907 [label="Und was hast du getan?",shape=box,color=red];
		4907 -> 4915;
	4908 [label="Ich fürchte, du hast wahrscheinlich recht. Er wurde vom Schicksal schwer getroffen und hat alles getan, um dem zu widerstehen.",shape=box,color=blue];
		4908 -> 4916;
	4909 [label="Ich glaube, am Ende wird es mehr sein. Auch wenn ich diese Tatsache verabscheue. Ich kann mich dem nicht entziehen, schließlich bin ich mit ihnen gefangen.",shape=box,color=blue];
		4909 -> 4916;
	4910 [label="Und seitdem?",shape=box,color=blue];
		4910 -> 4917;
	4911 [label="Evaluate expressions",color=orange];
		4911 -> 4918 [label="RoatheRedeemed",color=purple];
		4911 -> 4919 [label="RoatheVillain",color=purple];
		4911 -> 4920 [label="false",color=purple];
	4912 [label="+10 Chemistry",color=orange];
		4912 -> 4921;
	4913 [label="+5 Chemistry",color=orange];
		4913 -> 4922;
	4914 [label="Als ich eines Abends ein paar Nächte danach still und allein las, kam er von selbst auf mich zu.",shape=box,color=blue];
		4914 -> 4923;
	4915 [label="Ich umarmte sie natürlich auch. Ich bin zwar ein Orokin, aber kein Monster.",shape=box,color=blue];
		4915 -> 4924;
	4916 [label="Dieser Priester. Wenn ich mit einem einzigen Gedanken schließen soll, dann mit diesem: Seine Widerstandsfähigkeit ist irgendwie so unendlich wie die Zeit selbst.",shape=box,color=blue];
		4916 -> 4925;
	4917 [label="Er erwähnte kaum etwas davon. Wofür ich sehr dankbar bin. Ich erwartete Sticheleien und Hohn. \"Endlich, der Teufel wurde in die Knie gezwungen.\" Weit gefehlt. Sie tun so, als wäre nichts geschehen.",shape=box,color=blue];
		4917 -> 4882;
	4918 [label="Der alte Roathe hätte die Gelegenheit genutzt, sich ihre Nieren zu holen, aber ich stellte fest, dass ich dazu kein Verlangen mehr hatte.",shape=box,color=blue];
		4918 -> 4926;
	4919 [label="Es kostete mich all meine Willenskraft, ihr nicht die Nieren herauszureißen. Aber sie wollte mir einfach nur Trost spenden.",shape=box,color=blue];
		4919 -> 4927;
	4920 [label="Sie wollte mir lediglich einfach Trost spenden.",shape=box,color=blue];
		4920 -> 4928;
	4921 [label="In der Tat. Und dafür habe ich dir zu danken, nicht wahr?",shape=box,color=blue];
		4921 -> 4929;
	4922 [label="Ich glaube, am Ende wird es mehr sein. Auch wenn ich diese Tatsache verabscheue. Ich kann mich dem nicht entziehen, schließlich bin ich mit ihnen gefangen.",shape=box,color=blue];
		4922 -> 4929;
	4923 [label="Er setzte sich neben mich und erzählte mir, wie er seinen Glauben infrage gestellt hat, seit Entrati ihm das Serum gegeben hat. Wie sehr er sich für seine Zweifel schämte. Wie sehr er es bereute, das Serum genommen zu haben.",shape=box,color=blue];
		4923 -> 4930;
	4924 [label="Und seitdem?",shape=box,color=blue];
		4924 -> 4931;
	4925 [label="Für einen Mann, der zerschmettert ist, ist er noch nicht auseinanderfallen. ",shape=box,color=blue];
		4925 -> 4932;
	4926 [label="Zum ersten Mal in meinem elenden Leben nahm ich das einfache Angebot des Trostes an, als das an, was es war.",shape=box,color=blue];
		4926 -> 4927;
	4927 [label="Es war eine einfache Art, mir zu sagen, dass es ihr vielleicht nicht annähernd so viel bedeutete wie mir. Und dass es ihr leid tat, wie sehr ich mir deswegen selbst wehgetan habe.",shape=box,color=blue];
		4927 -> 4928;
	4928 [label="Und seitdem?",shape=box,color=blue];
		4928 -> 4933;
	4929 [label="Diese Schwester von Sol. Wenn ich mit einem einzigen Gedanken schließen soll, dann mit diesem: Ihre Güte ist irgendwie so grenzenlos wie die Zeit selbst.",shape=box,color=blue];
		4929 -> 4934;
	4930 [label="Am wichtigsten jedoch, wie sehr er sich wünschte, alles vergessen zu können. Und dass wir drei vielleicht auf einer tieferen Ebene doch nicht gleich sind.",shape=box,color=blue];
		4930 -> 4924;
	4931 [label="Sie erwähnten kaum etwas davon. Wofür ich sehr dankbar bin. Ich erwartete Sticheleien und Hohn. \"Endlich, der Teufel wurde in die Knie gezwungen.\" Weit gefehlt. Sie tun so, als wäre nichts geschehen.",shape=box,color=blue];
		4931 -> 4888;
	4932 [label="Check boolean LyonDating",color=orange];
		4932 -> 4935 [label=true,color=green];
		4932 -> 4936 [label=false,color=brown];
	4933 [label="Sie erwähnten kaum etwas davon. Wofür ich sehr dankbar bin. Ich erwartete Sticheleien und Hohn. \"Endlich, der Teufel wurde in die Knie gezwungen.\" Weit gefehlt. Sie tun so, als wäre nichts geschehen.",shape=box,color=blue];
		4933 -> 4882;
	4934 [label="Die Vergebung und das Mitgefühl, die sie anderen entgegenbringt, sind bedingungslos.",shape=box,color=blue];
