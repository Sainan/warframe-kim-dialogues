	264 [label="+5 Chemistry",color=orange];
		264 -> 272;
	265 [label="+5 Chemistry",color=orange];
		265 -> 273;
	266 [label="+5 Chemistry",color=orange];
		266 -> 274;
	262 [label="Zweitens überkommt mich unmittelbare Wut und Zorn darüber, dass mit meinem Verstand nicht nur einmal, sondern gleich zweimal in jüngster Zeit gespielt wurde. Doch da ist noch ein anderes Gefühl, das den Zorn verdrängt. Ein Gefühl, das ich noch nicht ganz verstehe.",shape=box,color=blue];
		262 -> 271;
	267 [label="Ich kenne die Einzelheiten nicht, da mir die Erinnerungen daran fehlen, zusammen mit so vielen anderen, aufgrund der von ihm erzwungenen Veränderung.",shape=box,color=blue];
		267 -> 275;
	268 [label="Ja! Ganz genau! Mit Proben meines eigenen Blutes, wohlgemerkt! ich habe nicht im selben Jahr angefangen, das wir verließen, so viel steht fest! Beim Void, ich werde ihm mit meinen neuen Klauen das Fleisch vom Leib reißen, sobald ich sein dummes, selbstgefälliges Gesicht sehe -",shape=box,color=blue];
		268 -> 276;
	269 [label="Ich würde dir stattdessen einfach zur Geduld raten, aber ... es liegt mir fern, dir zu raten, einen Meißel zu benutzen, wenn eine Laserspitzhacke neben dir liegt.",shape=box,color=blue];
		269 -> 277;
	270 [label="+5 Chemistry",color=orange];
		270 -> 278;
	5737 [label="Zweitens überkommt mich unmittelbare Wut und Zorn darüber, dass mit meinem Verstand nicht nur einmal, sondern gleich zweimal in jüngster Zeit gespielt wurde. Doch da ist noch ein anderes Gefühl, das den Zorn verdrängt. Ein Gefühl, das ich noch nicht ganz verstehe.",shape=box,color=blue];
		5737 -> 5740;
	272 [label="Erstens: Ich bin beeindruckt! Du hast all unsere Erinnerungen ausgelöscht, um noch einmal zu versuchen seine Zuneigung zu gewinnen?!",shape=box,color=blue];
		272 -> 280;
	273 [label="Erstens: Ich bin beeindruckt! Du hast all unsere Erinnerungen ausgelöscht, um noch einmal zu versuchen ihre Zuneigung zu gewinnen?!",shape=box,color=blue];
		273 -> 281;
	274 [label="Oh, das ist ja wirklich magisch! Du hast all unsere Erinnerungen ausgelöscht, um noch einmal zu versuchen mein Herz zu erobern?!",shape=box,color=blue];
		274 -> 282;
	271 [label="Verrat.",shape=box,color=blue];
		271 -> 279;
	275 [label="Aber ich habe Erinnerungsfetzen. Bruchstücke eines goldenen Flurs. Eine Stimme, die ich wiedererkannte – aber kein Gesicht. Es war Albrecht, aber nicht der, den ich kannte.",shape=box,color=blue];
		275 -> 283;
	276 [label="Erlaube mir einen Augenblick, um meine Wut zu zügeln.",shape=box,color=blue];
		276 -> 284;
	277 [label="Ich sitze hier und mir fallen sofort zwei Dinge auf, nachdem sich mein Verdacht bestätigt hat:",shape=box,color=blue];
		277 -> 285;
	278 [label="Hm. Verstehe. Ein edles Unterfangen, wenn ich ehrlich bin. Eines, das ich selbst schon unzählige Male versucht habe. Und dabei ebenso oft gescheitert bin.",shape=box,color=blue];
		278 -> 286;
	5740 [label="Verrat.",shape=box,color=blue];
		5740 -> 5741;
	280 [label="Das ist sehr Orokin von dir.",shape=box,color=blue];
		280 -> 288;
	281 [label="Das ist sehr Orokin von dir.",shape=box,color=blue];
		281 -> 289;
	282 [label="Das ist sehr Orokin von dir.",shape=box,color=blue];
		282 -> 290;
	279 [label="Warum?",shape=box,color=blue];
		279 -> 287;
	283 [label="Ein brennender, stechender Schmerz. Wie ich ihn noch nie zuvor erlebt habe. Und einer meiner vorherigen Körper verlor im Krieg durch eine Explosion einen Arm und ein Bein, Drifter. Ich war so schwerwiegend verbrannt, dass ich mich ohne Kuva nicht davon erholt hätte. Ich kenne Qualen.",shape=box,color=blue];
		283 -> 291;
	284 [label="Vielen Dank. Wir können fortfahren.",shape=box,color=blue];
		284 -> 292;
	285 [label="Ich frage mich ... Wie viele Kämpfe hätte ich wohl vom Schlachtfeld gefegt und wiederholt, wenn ich über eine solche Macht verfügen würde?",shape=box,color=blue];
		285 -> 293;
	286 [label="Ich sitze hier und mir fallen sofort zwei Dinge auf, nachdem sich mein Verdacht bestätigt hat:",shape=box,color=blue];
		286 -> 294;
	5741 [label="Warum?",shape=box,color=blue];
		5741 -> 5742;
	288 [label="Zweitens: Wie unfähig bist du eigentlich?! Ich bin mir ziemlich sicher, dass du die unsterbliche Liebe und Verehrung des Priesters gewinnen würdest, wenn du ihn einfach einmal täglich füttern und tränken würdest.",shape=box,color=blue];
		288 -> 296;
	289 [label="Zweitens: Hast du versucht, vor ihr zu humpeln? Eine Krankheit vorzutäuschen? Mit den Wimpern zu klimpern? Ihr einfach zu sagen, dass sie hübsch aussieht? Sie scheint nicht besonders schwer zu erobern zu sein.",shape=box,color=blue];
		289 -> 297;
	290 [label="Ich sitze hier und mir fallen sofort zwei Dinge auf, nachdem sich mein Verdacht bestätigt hat:",shape=box,color=blue];
		290 -> 298;
	287 [label="Aber das ist ein Thema für ein anderes Mal. Denn ich habe einen Vorschlag für diche. Einen, an dem du, wie ich glaube, weitaus mehr Interesse haben wirst.",shape=box,color=blue];
		287 -> 295;
	291 [label="Mein Körper wurde zerrissen und neu zusammengesetzt. Mit Gewalt. Ich habe mir das nicht ausgesucht. Ich weiß nicht, ob es den anderen genauso erging.",shape=box,color=blue];
		291 -> 299;
	292 [label="Ich habe Proben meines eigenen Blutes verwendet, um einen Helminth nachzubauen, durch Herumprobieren praktisch. Das war nicht leicht, ohne jegliche Gerätschaften der Orokin. Oder überhaupt irgendeiner Ausrüstung, außer dem, was ich stehlen konnte von den ...",shape=box,color=blue];
		292 -> 300;
	293 [label="Wie viele Gedanken hätte ich verdorben, wenn ich stattdessen über deine Gaben verfügt hätte?",shape=box,color=blue];
		293 -> 301;
	294 [label="Ich frage mich ... Wie viele Kämpfe hätte ich wohl vom Schlachtfeld gefegt und wiederholt, wenn ich über eine solche Macht verfügen würde?",shape=box,color=blue];
		294 -> 302;
	5742 [label="Aber das ist ein Thema für ein anderes Mal. Denn ich habe einen Vorschlag für dich. Einen, an dem du, wie ich glaube, weitaus mehr Interesse haben wirst.",shape=box,color=blue];
		5742 -> 5739;
	296 [label="Versteh mich nicht falsch! Ich bin ziemlich beeindruckt von deiner Verschalgenheit. ",shape=box,color=blue];
		296 -> 304;
	297 [label="Drittens: Ich sitze hier und bin plötzlich überwältigt von Erkenntnissen, nachdem sich mein Verdacht bestätigt hat:",shape=box,color=blue];
		297 -> 305;
	298 [label="Ich frage mich ... Wie viele Kämpfe hätte ich wohl vom Schlachtfeld gefegt und wiederholt, wenn ich über eine solche Macht verfügen würde?",shape=box,color=blue];
		298 -> 306;
	295 [label="Ich werde vor den Eiferern so tun, als ob ich nichts davon wüsste ...",shape=box,color=blue];
		295 -> 303;
	299 [label="Ich erinnere mich an die kalten Stufen unter mir, als ich darauf stürzte. Es waren Kathedralentreppen, das weiß ich jetzt, denn Lyon und Marie haben mir die Geschichte aus ihren Erinnerungen erzählt.",shape=box,color=blue];
		299 -> 307;
	300 [label="Ich werde ihnen nicht den Gefallen tun, sie als \"rudimentäre\" Krankenhäuser zu bezeichnen. Albrecht hatte einen Helminth benutzt, um uns in die Vergangenheit zu transportieren. Wie er dort gewachsen war, weiß ich nicht, da er ja schon da gewesen sein musste, als wir ankamen. Er verkümmerte und starb dabei – ich vermutete, dass man für eine Rückreise einen anderen benutzen könnte.",shape=box,color=blue];
		300 -> 308;
	301 [label="Zweitens überkommt mich unmittelbare Wut und Zorn darüber, dass mit meinem Verstand nicht nur einmal, sondern gleich zweimal in jüngster Zeit gespielt wurde. Doch da ist noch ein anderes Gefühl, das den Zorn verdrängt. Ein Gefühl, das ich noch nicht ganz verstehe.",shape=box,color=blue];
		301 -> 309;
	302 [label="Wie viele Gedanken hätte ich verdorben, wenn ich stattdessen über deine Gaben verfügt hätte?",shape=box,color=blue];
		302 -> 310;
	5739 [label="Ich werde vor den Eiferern so tun, als ob ich nichts davon wüsste ...",shape=box,color=blue];
		5739 -> 5738;
	304 [label="Ich glaube ehrlich gesagt nicht, dass ich dich verurteilen kann. Wie viele Kämpfe hätte ich wohl vom Schlachtfeld gefegt und wiederholt, wenn ich über eine solche Macht verfügen würde?",shape=box,color=blue];
		304 -> 312;
	305 [label="Ich frage mich ... Wie viele Kämpfe hätte ich wohl vom Schlachtfeld gefegt und wiederholt, wenn ich über eine solche Macht verfügen würde?",shape=box,color=blue];
		305 -> 313;
	306 [label="Wie viele Gedanken hätte ich verdorben, wenn ich stattdessen über deine Gaben verfügt hätte?",shape=box,color=blue];
		306 -> 314;
	303 [label="Und, was noch wichtiger ist – ich werde dafür sorgen, dass du dein Ziel, Albrechts Butler und die Familie wieder zusammenzubringen, dieses Mal auf jeden Fall erreichen wirst.",shape=box,color=blue];
		303 -> 311;
	307 [label="Albrecht hatte mich in ihre Zeit und in ihre törichte Kathedrale gebracht und mich ihrer \"Obhut\" anvertraut.",shape=box,color=blue];
		307 -> 315;
	308 [label="Ich hatte Recht. Obwohl der Herstellungsprozess ... mühsam und langwierig war.",shape=box,color=blue];
		308 -> 316;
	309 [label="Verrat.",shape=box,color=blue];
		309 -> 317;
	310 [label="Zweitens überkommt mich unmittelbare Wut und Zorn darüber, dass mit meinem Verstand nicht nur einmal, sondern gleich zweimal in jüngster Zeit gespielt wurde. Doch da ist noch ein anderes Gefühl, das den Zorn verdrängt. Ein Gefühl, das ich noch nicht ganz verstehe.",shape=box,color=blue];
		310 -> 318;
	5738 [label="Und, was noch wichtiger ist – ich werde dafür sorgen, dass du dein Ziel, Albrechts Butler und die Familie wieder zusammenzubringen, dieses Mal auf jeden Fall erreichen wirst.",shape=box,color=blue];
