		366 -> 376;
		366 -> 377;
	370 [label="+20 Chemistry",color=orange];
		370 -> 381;
	371 [label="Dennoch bin ich überrascht, dass er nicht hier ist. Ich war mir sicher, dass er sich hier verstecken würde - mit seinem Geliebten. Oder seiner Familie.",shape=box,color=blue];
		371 -> 382;
	372 [label="Ich erinnere mich an die kalten Stufen unter mir, als ich darauf stürzte. Es waren Kathedralentreppen, das weiß ich jetzt, denn Lyon und Marie haben mir die Geschichte aus ihren Erinnerungen erzählt.",shape=box,color=blue];
