digraph {
	186 [label="RoatheRank1Convo3 begins.",color=orange];
		186 -> 188;
		186 -> 187;
	188 [label="Darf ich fragen – wie bist du hierher gekommen? Von ... wann genau?",shape=box,color=red];
		188 -> 190;
	187 [label="[Ende.]",shape=box,color=red];
		187 -> 189;
	190 [label="Evaluate expressions on HellStory",color=orange];
		190 -> 191 [label="x >= 21",color=purple];
		190 -> 192 [label="x < 21",color=purple];
		190 -> 192 [label="false",color=purple];
	189 [label="Chat ends.",color=orange];
	191 [label="Warum vermute ich, dass du die Antwort darauf schon längst kennst, mein Usurpator? Was für ein Spiel treibst du, indem du nach solchen Belanglosigkeiten fragst, wenn du doch schon die Bruchstücke meines Geistes durchwühlt hast?",shape=box,color=blue];
		191 -> 193;
	192 [label="Ja, du darfst fragen! Es gibt mir die Gelegenheit, meine eigene Brillanz auszubreiten und mich über Albrechts bemerkenswerte Fähigkeit zu beklagen, gleichzeitig hirnlos und trottelig und doch ein absoluter Feigling zu sein!",shape=box,color=blue];
		192 -> 194;
	193 [label="Check boolean RoatheKnowsReset",color=orange];
		193 -> 196 [label=true,color=green];
		193 -> 195 [label=false,color=brown];
	194 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		194 -> 197 [label="x >= 1",color=purple];
		194 -> 198 [label="x <= 0",color=purple];
		194 -> 198 [label="false",color=purple];
	196 [label="Du bist genauso abscheulich wie Albrecht, du manipulierst die Gedanken derer um dich herum – als wären sie deine Spielzeuge! Also sag schon. Warum fragst du, wenn du die Antworten schon kennst, hm?",shape=box,color=blue];
		196 -> 201;
		196 -> 202;
	195 [label="Sag mir. Vermute ich richtig, dass du die Antworten, die du suchst, bereits kennst? Du weißt bereits, wie ich mit den Eiferern hierher zurückgekehrt bin – von genau wann und woher. Und wahrscheinlich noch viel mehr, nicht wahr?",shape=box,color=blue];
		195 -> 199;
		195 -> 200;
	197 [label="Ich hab schon vermutet, dass du nicht freiwillig von Albrecht dort platziert wurdest.",shape=box,color=red];
		197 -> 203;
	198 [label="Ah. Du wurdest also nicht freiwillig in die Vergangenheit versetzt.",shape=box,color=red];
		198 -> 203;
	201 [label="Ich versuche euch alle durch diesen Prozess zu leiten, und beim letzten Mal habe ich es total vermasselt. Ich versuche es noch einmal. \"Ganz von oben\", sozusagen.",shape=box,color=red];
		201 -> 206;
	202 [label="Ich weiß nicht genau, wie ich das erklären soll. Ich habe um diese Fähigkeit, eure Erinnerungen zu löschen, nicht gebeten und versuche, so gut wie möglich damit umzugehen.",shape=box,color=red];
		202 -> 207;
	199 [label="Nein, nicht wirklich.",shape=box,color=red];
		199 -> 204;
	200 [label="Ich ... gebe zu, dass ich das tue, ja.",shape=box,color=red];
		200 -> 205;
	203 [label="Nein. Ganz und gar nicht. Nun, hier ist etwas, das du über die Orokin verstehen musst: Wir spielen – nun ja ... genauer gesagt, spielten – häufig Spiele miteinander. Spiele aller Art. Politische, psychologische, sexuelle. Es spielte keine Rolle.",shape=box,color=blue];
		203 -> 208;
	206 [label="+5 Chemistry",color=orange];
		206 -> 211;
	207 [label="Dann machst du deine Sache aber ziemlich schlecht, mein beständiger Freund. Welche Ziele versuchst du zu erreichen, die du nicht schon zuvor erreicht hast?",shape=box,color=blue];
		207 -> 212;
	204 [label="Ha. Und jetzt weiß ich, dass du nicht nur ein Erinnerungs-Dieb, sondern auch ein Lügner bist, Usurpator.",shape=box,color=blue];
		204 -> 209;
	205 [label="Update boolean RoatheKnowsReset",color=orange];
		205 -> 210;
	208 [label="Durch die Nutzung von Kuva und des Yuvan-Theaters waren wir grundlegend und praktisch unsterblich. Kannst du dir vorstellen, wie unglaublich anstrengend das ist?",shape=box,color=blue];
		208 -> 213;
		208 -> 214;
	211 [label="Update boolean RoatheResetScrewedUp",color=orange];
		211 -> 215;
	212 [label="Check boolean LoidFamilyComplete",color=orange];
		212 -> 217 [label=true,color=green];
		212 -> 218 [label=true,color=green];
		212 -> 216 [label=false,color=brown];
		212 -> 217 [label=false,color=brown];
		212 -> 218 [label=false,color=brown];
	209 [label="Chat ends.",color=orange];
	210 [label="Warum stellst du mir dann Fragen, deren Antwort du bereits kennst?",shape=box,color=blue];
		210 -> 201;
		210 -> 202;
	213 [label="Ich habe da tatsächlich einige Erfahrungen, ob du es glaubst oder nicht.",shape=box,color=red];
		213 -> 219;
	214 [label="Das kann ich tatsächlich. Aber bitte fahr fort.",shape=box,color=red];
		214 -> 220;
	215 [label="Also das ... finde ich faszinierend ... hast du es bei mir \"vermasselt\" oder bei Lyon oder Marie?",shape=box,color=blue];
		215 -> 221;
		215 -> 222;
		215 -> 223;
	217 [label="Nun ja, siehst du, du hast da diese ganze Sache ... mit dem warum du das Serum genommen hast, und ich ... habe die falschen Dinge zur falschen Zeit gesagt.",shape=box,color=red];
		217 -> 225;
	218 [label="Ich ... versuche, das Herz von einem von euch zu gewinnen, und ich ... habe es wirklich ... vergeigt ...",shape=box,color=red];
		218 -> 226;
	216 [label="Ich versuche, dich und die anderen dazu zu bringen, mir zu helfen, Loid wieder mit seiner Familie über uns zu vereinen, und ... ich ... konnte es nicht ...",shape=box,color=red];
		216 -> 224;
	219 [label="Du hast, wie ich gehört habe, Erfahrung damit auf ewig zu sterben. Das ist weitaus interessanter – und dennoch hast du am Ende einen Grund gefunden, gegenüber all dem abzustumpfen.",shape=box,color=blue];
		219 -> 220;
	220 [label="Mein Punkt war also – ich bin es gewohnt, sogar sehr gewohnt –, die Intrigen und Ränkespiele zu kennen, mit denen wir Orokin uns unterhalten. So vertreiben wir uns die Zeit.",shape=box,color=blue];
		220 -> 227;
	221 [label="Lyon ...",shape=box,color=red];
		221 -> 228;
	222 [label="Marie ...",shape=box,color=red];
		222 -> 229;
	223 [label="Bei dir ...",shape=box,color=red];
		223 -> 230;
	225 [label="+5 Chemistry",color=orange];
		225 -> 232;
	226 [label="+5 Chemistry",color=orange];
		226 -> 233;
	224 [label="Hm. Ich verstehe. Wir hatten eine Vereinbarung, und du konntest deinen Teil der Abmachung aus irgendeinem Grund nicht einhalten, sodass dein Gewinn vor deiner Nase entschwand.",shape=box,color=blue];
		224 -> 231;
	227 [label="Es gibt jedoch Grenzen, die wir nicht überschreiten. Handlungen, die wir nicht begehen. Ich könnte ins Detail gehen, werde es aber nicht. Ich fasse es kurz zusammen: Albrecht hat sie alle überschritten.",shape=box,color=blue];
		227 -> 234;
	228 [label="Wirklich? Hast du mal versucht, ihn einfach einmal täglich zu füttern und zu tränken und zu sehen, ob das hilft? Na gut ...",shape=box,color=blue];
		228 -> 235;
	229 [label="Und du konntest dieses fluffige, kleine, unschuldige Wesen nicht dazu bringen, mitzumachen? Ich ... hoffe ... dass du keine Karriere als Vermittler einschlägst, meine ewige Bekanntschaft.",shape=box,color=blue];
		229 -> 236;
	230 [label="+5 Chemistry",color=orange];
		230 -> 237;
	232 [label="Hm.",shape=box,color=blue];
		232 -> 239;
	233 [label="HA! Das ist ja herrlich! Jetzt hast du meine volle Aufmerksamkeit ... wer ist der Herzensbrecher? Hm? Erzähl schon ... nur keine Scheu. Vielleicht können wir eine ... Vereinbarung treffen.",shape=box,color=blue];
		233 -> 240;
		233 -> 241;
		233 -> 242;
	231 [label="Ich sitze hier und mir fallen sofort zwei Dinge auf, nachdem sich mein Verdacht bestätigt hat:",shape=box,color=blue];
		231 -> 238;
	234 [label="Er hat mich dort zurückgelassen, in einer grauenhaften Vergangeheit, in irgendeinem abgelegenen Kaff am Arsch des Ursprungssystems! Wusstest du, dass diese vom Void verlassene \"Cathédrale\" noch nicht einmal Strom hatte?! Strom!",shape=box,color=blue];
		234 -> 243;
	235 [label="Was genau mit ihm hat dir solche Schwierigkeiten bereitet? Vielleicht könnten wir eine Vereinbarung treffen?",shape=box,color=blue];
		235 -> 244;
	236 [label="Aber sag mir, was genau mit ihr hat dir solche Schwierigkeiten bereitet? Vielleicht könnten wir eine ... Vereinbarung treffen?",shape=box,color=blue];
		236 -> 245;
	237 [label="HA! Das ist ja herrlich! Jetzt hast du meine volle Aufmerksamkeit ... inwiefern? Hm? Erzähl schon ... nur keine Scheu. Vielleicht können wir eine ... Vereinbarung treffen.",shape=box,color=blue];
		237 -> 246;
	239 [label="Ich sitze hier und mir fallen sofort zwei Dinge auf, nachdem sich mein Verdacht bestätigt hat:",shape=box,color=blue];
		239 -> 248;
	240 [label="Lyon ...",shape=box,color=red];
		240 -> 249;
