		331 -> 340;
	328 [label="Nicht heute. Nicht morgen.",shape=box,color=blue];
		328 -> 337;
	332 [label="Ich weiß, was er den beiden Eiferern gesagt hat, so wenig man auch darauf geben mag. \"Uriel, Ketzer von Xata, in der Verbannung, antworte – Kann den Orokin jemals vergeben werden?\"",shape=box,color=blue];
		332 -> 341;
	333 [label="Durch einen Helminth. Wie er dort gewachsen war, weiß ich nicht, da er ja schon da gewesen sein musste, als wir ankamen. Er verkümmerte und starb dabei – ich vermutete, dass man für eine Rückreise einen anderen benutzen könnte.",shape=box,color=blue];
		333 -> 342;
	334 [label="Ich kenne die Einzelheiten nicht, da mir die Erinnerungen daran fehlen, zusammen mit so vielen anderen, aufgrund der von ihm erzwungenen Veränderung.",shape=box,color=blue];
		334 -> 343;
	335 [label="Ich werde vor den Eiferern so tun, als ob ich nichts davon wüsste ...",shape=box,color=blue];
		335 -> 344;
	336 [label="Aber das ist ein Thema für ein anderes Mal. Denn ich habe einen Vorschlag für diche. Einen, an dem du, wie ich glaube, weitaus mehr Interesse haben wirst.",shape=box,color=blue];
		336 -> 345;
	5746 [label="Nicht heute. Nicht morgen.",shape=box,color=blue];
		5746 -> 5745;
	338 [label="Warum?",shape=box,color=blue];
		338 -> 347;
	339 [label="Warum?",shape=box,color=blue];
		339 -> 348;
	340 [label="Aber das ist ein Thema für ein anderes Mal. Denn ich habe einen Vorschlag für diche. Einen, an dem du, wie ich glaube, weitaus mehr Interesse haben wirst.",shape=box,color=blue];
		340 -> 349;
	337 [label="Aber du wirst dem Teufel etwas schulden.",shape=box,color=blue];
		337 -> 346;
	341 [label="Wäre ich bei Bewusstsein gewesen, als er das sagte, hätte ich ihm ins Gesicht gelacht. Denn ich bin ja hier eindeutig nicht diejenige, der um Vergebung bittet, oder?",shape=box,color=blue];
		341 -> 350;
	342 [label="Ich hatte Recht. Obwohl der Prozess der Herstellung ... gelinde gesagt, mühsam und langwierig war! Ich habe Proben meines eigenen Blutes verwendet, um einen Helminth nachzubauen, durch verdammtes Herumprobieren!",shape=box,color=blue];
		342 -> 351;
	343 [label="Aber ich habe Erinnerungsfetzen. Bruchstücke eines goldenen Flurs. Eine Stimme, die ich wiedererkannte – aber kein Gesicht. Es war Albrecht, aber nicht der, den ich kannte.",shape=box,color=blue];
		343 -> 352;
	344 [label="Und, was noch wichtiger ist – ich werde dafür sorgen, dass du dein Ziel, Lyon durch seinen Schmerz zu begleiten, dieses Mal erreichst, koste es, was es wolle.",shape=box,color=blue];
		344 -> 353;
	345 [label="Ich werde vor den Eiferern so tun, als ob ich nichts davon wüsste ...",shape=box,color=blue];
		345 -> 354;
	5745 [label="Aber du wirst dem Teufel etwas schulden.",shape=box,color=blue];
		5745 -> 5747;
	347 [label="Aber das ist ein Thema für ein anderes Mal. Denn ich habe einen Vorschlag für diche. Einen, an dem du, wie ich glaube, weitaus mehr Interesse haben wirst.",shape=box,color=blue];
		347 -> 357;
	348 [label="Aber das ist ein Thema für ein anderes Mal. Denn ich habe einen Vorschlag für diche. Einen, an dem du, wie ich glaube, weitaus mehr Interesse haben wirst.",shape=box,color=blue];
		348 -> 358;
	349 [label="Ich werde vor den Eiferern so tun, als ob ich nichts davon wüsste ...",shape=box,color=blue];
		349 -> 359;
	346 [label="Sind wir uns einig?",shape=box,color=blue];
		346 -> 355;
		346 -> 356;
	350 [label="Er ist es, der vor seiner Familie, vor seinem Geliebten, vor dem Kampf flieht, den er mit seinem falschen Gott begonnen hat! Ich bin nicht der verfluchte Feigling zwischen uns!",shape=box,color=blue];
		350 -> 360;
	351 [label="Update boolean RoatheHelminth1",color=orange];
		351 -> 361;
	352 [label="Ein brennender, stechender Schmerz. Wie ich ihn noch nie zuvor erlebt habe. Und einer meiner vorherigen Körper verlor im Krieg durch eine Explosion einen Arm und ein Bein, Drifter. Ich war so schwerwiegend verbrannt, dass ich mich ohne Kuva nicht davon erholt hätte. Ich kenne Qualen.",shape=box,color=blue];
		352 -> 362;
	353 [label="Aber merk dir meine Worte, Drifter.",shape=box,color=blue];
		353 -> 363;
	354 [label="Und, was noch wichtiger ist – ich werde dafür sorgen, dass du dein Ziel diesmal erreichst, Marie die \"Augen zu öffnen\", was Entrati betrifft, koste es, was es wolle.",shape=box,color=blue];
		354 -> 364;
	5747 [label="Sind wir uns einig?",shape=box,color=blue];
		5747 -> 5752;
