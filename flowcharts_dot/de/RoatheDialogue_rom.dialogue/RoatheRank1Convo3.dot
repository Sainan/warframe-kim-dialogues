	313 [label="Wie viele Gedanken hätte ich verdorben, wenn ich stattdessen über deine Gaben verfügt hätte?",shape=box,color=blue];
		313 -> 321;
	314 [label="Zweitens überkommt mich unmittelbare Wut und Zorn darüber, dass mit meinem Verstand nicht nur einmal, sondern gleich zweimal in jüngster Zeit gespielt wurde. Doch da ist noch ein anderes Gefühl, das den Zorn verdrängt. Ein Gefühl, das ich noch nicht ganz verstehe.",shape=box,color=blue];
		314 -> 322;
	311 [label="Aber merk dir meine Worte, Drifter.",shape=box,color=blue];
		311 -> 319;
