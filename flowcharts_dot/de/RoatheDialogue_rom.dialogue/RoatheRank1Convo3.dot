		260 -> 225;
	261 [label="[Gefühle gestehen.] Das ist ... das ist wirklich peinlich, aber ich ...",shape=box,color=red];
		261 -> 251;
	263 [label="Wie viele Gedanken hätte ich verdorben, wenn ich stattdessen über deine Gaben verfügt hätte?",shape=box,color=blue];
