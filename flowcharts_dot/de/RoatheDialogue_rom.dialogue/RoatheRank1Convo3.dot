	5743 [label="Aber merk dir meine Worte, Drifter.",shape=box,color=blue];
		5743 -> 5744;
	320 [label="Hm ... nein, bei genauerem Hinsehen, Usurpator – ich glaube nicht, dass es Wut ist, die ich empfinde, seit ich weiß, dass du mein Gedächtnis gelöscht hast, um unsere Gespräche erneut zu versuchen –",shape=box,color=blue];
		320 -> 329;
	321 [label="Und ich bin überwältigt von der unmittelbaren Wut und dem Zorn darüber, dass mit meinem Verstand nicht nur einmal, sondern gleich zweimal in jüngster Zeit gespielt wurde. Doch da ist noch ein anderes Gefühl, das den Zorn verdrängt. Ein Gefühl, das ich noch nicht ganz verstehe.",shape=box,color=blue];
		321 -> 330;
	322 [label="Verrat.",shape=box,color=blue];
