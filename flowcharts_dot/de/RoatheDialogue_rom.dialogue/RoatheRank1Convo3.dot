		323 -> 332;
	324 [label="Wie hat er dich in die Vergangenheit gebracht?",shape=box,color=red];
		324 -> 333;
	325 [label="Wie hat er dich überhaupt in einen Protoframe verwandelt?",shape=box,color=red];
		325 -> 334;
	326 [label="Aber das ist ein Thema für ein anderes Mal. Denn ich habe einen Vorschlag für diche. Einen, an dem du, wie ich glaube, weitaus mehr Interesse haben wirst.",shape=box,color=blue];
		326 -> 335;
	327 [label="Warum?",shape=box,color=blue];
		327 -> 336;
