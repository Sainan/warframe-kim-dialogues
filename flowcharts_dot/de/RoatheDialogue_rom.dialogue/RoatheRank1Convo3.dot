	5751 [label="Nein. Nein, absolut nicht!",shape=box,color=red];
		5751 -> 5753;
	367 [label="Und, was noch wichtiger ist – ich werde dafür sorgen, dass du dein Ziel erreichst, mit deinem lieben Pater Lyon Allard zusammen zu sein, wenn die Zeit reif ist.",shape=box,color=blue];
		367 -> 378;
	368 [label="Und, was noch wichtiger ist – ich werde dafür sorgen, dass du dein Ziel erreichst, mit der \"kleinen Marie\" zusammen zu sein, wenn die Zeit reif ist.",shape=box,color=blue];
