		356 -> 366;
	360 [label="Update boolean RoatheXata1",color=orange];
		360 -> 370;
	361 [label="Sagen wir einfach, ich habe den Prozess nicht in dem Jahr in Gang gesetzt, das ich verließ, hm? Nun, wir sind ja jetzt hier. Albrecht hat es trotz all seiner Bemühungen nicht geschafft, mich in diesem Höllenloch zurückzulassen.",shape=box,color=blue];
		361 -> 371;
	362 [label="Mein Körper wurde zerrissen und neu zusammengesetzt. Mit Gewalt. Ich habe mir das nicht ausgesucht. Ich weiß nicht, ob es den anderen genauso erging.",shape=box,color=blue];
		362 -> 372;
	363 [label="Du. Wirst. Mir. Etwas. Schulden.",shape=box,color=blue];
		363 -> 373;
