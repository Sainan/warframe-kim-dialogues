	247 [label="Wie viele Gedanken hätte ich verdorben, wenn ich stattdessen über deine Gaben verfügt hätte?",shape=box,color=blue];
		247 -> 262;
	252 [label="Also ... Moment. Ich bin verwirrt. Wie und wann hat Entrati dich in einen Protoframe verwandelt?",shape=box,color=red];
		252 -> 267;
	253 [label="Du. Moment. Du hast was getan?!",shape=box,color=red];
		253 -> 268;
	254 [label="Er hat ... er hat mit so vielem zu kämpfen. Und ich weiß nicht, wie ich da durchkommen kann.",shape=box,color=red];
		254 -> 269;
	256 [label="Ich habe Gefühle für ihn ...",shape=box,color=red];
		256 -> 249;
	255 [label="Ich versuche, dich und die anderen dazu zu bringen, mir zu helfen, Loid wieder mit seiner Familie über uns zu vereinen, und ... ich ... konnte es nicht ...",shape=box,color=red];
		255 -> 224;
	257 [label="Sie will Entrati nicht so sehen, wie er wirklich ist. Und ich kann sie nicht dazu bringen, die Wahrheit zu erkennen, egal was ich tue.",shape=box,color=red];
		257 -> 270;
	259 [label="Ich habe Gefühle für sie ...",shape=box,color=red];
