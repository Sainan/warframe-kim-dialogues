		241 -> 250;
	242 [label="Du ...",shape=box,color=red];
		242 -> 251;
	238 [label="Ich frage mich ... Wie viele Kämpfe hätte ich wohl vom Schlachtfeld gefegt und wiederholt, wenn ich über eine solche Macht verfügen würde?",shape=box,color=blue];
		238 -> 247;
	243 [label="Hast du eine Ahnung, wie schwierig es war, einen Helminth ohne Elektrizität zu rekonstruieren?!",shape=box,color=blue];
		243 -> 252;
		243 -> 253;
