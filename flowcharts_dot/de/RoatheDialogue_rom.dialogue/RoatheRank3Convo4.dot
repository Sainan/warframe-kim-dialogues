		1983 -> 1988;
	1984 [label="Chat ends.",color=orange];
	1985 [label="Chat ends.",color=orange];
	1986 [label="Je mehr du mir von deinen irren Theorien erzählst, desto mehr bin ich davon überzeugt, dass ich Recht habe. Ihr alle habt euch ein Scheinargument eures eigenen Wahnsinns aufgebaut, und das Ganze nährt sich von euren eigenen Unsicherheiten.",shape=box,color=blue];
