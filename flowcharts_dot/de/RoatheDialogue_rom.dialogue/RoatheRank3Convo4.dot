	1886 [label="Du scheinst fest entschlossen zu sein, in diesem Universum mit einem Putzeimer hinter Albrecht herzulaufen. Sieh dir nur mal deine Zusammenarbeit mit seinem Butler an.",shape=box,color=blue];
		1886 -> 1889;
