	1889 [label="Check boolean IsDating",color=orange];
		1889 -> 1891 [label=true,color=green];
		1889 -> 1890 [label=false,color=brown];
	1891 [label="Es scheint, als ob du in der Zwischenzeit deine eigenen Bedürfnisse befriedigen willst – und dafür zolle ich dir Respekt, ich verurteile dich keineswegs. Es erscheint mir einfach seltsam, dass jemand, der sonst so ... wunderbar wild frech ist, sonst so gehorsam ist.",shape=box,color=blue];
		1891 -> 1892;
		1891 -> 1893;
		1891 -> 1894;
	1890 [label="Es erscheint mir einfach seltsam, dass jemand, der sonst so ... wunderbar wild frech ist, sonst so gehorsam ist.",shape=box,color=blue];
		1890 -> 1892;
		1890 -> 1893;
		1890 -> 1894;
	1892 [label="Zuzulassen, dass die Gleichgültigkeit das Ursprungssystem – oder irgendetwas anderes – zerstört, hilft niemandem.",shape=box,color=red];
		1892 -> 1895;
	1893 [label="Ich gehorche Entrati nicht.",shape=box,color=red];
		1893 -> 1896;
	1894 [label="Ich habe meine eigenen Gründe. Und die gehen nur mich was an.",shape=box,color=red];
		1894 -> 1897;
	1895 [label="Ah, verstehe. Es handelt sich also lediglich um einen vorübergehenden Service, den du anbietest, bis die Situation mit der \"Gleichgültigkeit\" geklärt ist. Und was planst du dann zu tun?",shape=box,color=blue];
		1895 -> 1898;
		1895 -> 1899;
		1895 -> 1900;
		1895 -> 1901;
		1895 -> 1902;
	1896 [label="Wirklich? Von meinem Standpunkt aus scheint es so. Er schnippt mit den Fingern, und du hockst wie ein dressierter Kubrow zu seinen Füßen. Er flüstert sogar den Namen \"Tau\", und du versuchst verzweifelt, dich an jedes noch so kleine Detail dessen zu erinnern, das du verloren hast.",shape=box,color=blue];
		1896 -> 1903;
		1896 -> 1904;
	1897 [label="So geheimnisvoll, so undurchschaubar! Und so ein Haufen Viehtreiber-Mist. Wenn du nicht einfach zugeben willst, dass du ihm gehorchst, dann sei es so.",shape=box,color=blue];
		1897 -> 1905;
	1898 [label="Warum bohrst du so nach? Was willst du mich eigentlich fragen?",shape=box,color=red];
		1898 -> 1906;
	1899 [label="Ehrlich gesagt habe ich mir darüber noch nicht so weit im Voraus Gedanken gemacht.",shape=box,color=red];
		1899 -> 1907;
	1900 [label="Ich werde ihn für dieses Chaos büßen lassen. Er hat viel wiedergutzumachen.",shape=box,color=red];
		1900 -> 1908;
	1901 [label="Vorausgesetzt, ich überlebe, meinst du?",shape=box,color=red];
		1901 -> 1909;
	1902 [label="Ich gehe dorthin, wo ich gebraucht werde, wie immer. In der Regel finden Probleme mich.",shape=box,color=red];
		1902 -> 1910;
	1903 [label="Warum versuchst du so sehr, mich wütend zu machen?",shape=box,color=red];
		1903 -> 1911;
	1904 [label="Ich tue einfach, was ich tun muss, um anderen aus ihren elenden Situationen zu helfen.",shape=box,color=red];
		1904 -> 1912;
	1905 [label="Denn aus meiner Sicht scheint es, als würde er mit den Fingern schnippen, und du hockst wie dressierter Kubrow zu seinen Füßen. Er flüstert sogar den Namen \"Tau\", und du versuchst verzweifelt, dich an jedes noch so kleine Detail dessen zu erinnern, das du verloren hast.",shape=box,color=blue];
		1905 -> 1903;
		1905 -> 1904;
	1906 [label="+5 Chemistry",color=orange];
		1906 -> 1913;
	1907 [label="Ah! Du gibst also zu, ein Idiot zu sein! Wie erfrischend. Ich liebe es, wenn Dummköpfe ihre Dummheit so offen zugeben; das macht meine Manipulation umso einfacher.",shape=box,color=blue];
		1907 -> 1914;
	1908 [label="Ah! Du sinnst also auf simple, urtümliche Rache! Herrlich. Ein tollwütiges Tier, bereit, an den Knochen derer zu nagen, die dir Unrecht getan haben.",shape=box,color=blue];
		1908 -> 1915;
	1909 [label="+5 Chemistry",color=orange];
		1909 -> 1916;
	1910 [label="Ah, verstehe. Teilnahmslosigkeit, verkleidet als Edelmut. Du weißt nicht, wo du hingehörst, wo du bleiben sollst, also hüllst du dich in diesen Schleier von \"gerechter Opferbereitschaft\" und tust, was andere dir befehlen?",shape=box,color=blue];
		1910 -> 1917;
	1911 [label="Weil ich beim besten Willen nicht begreifen kann, warum du, ein Wesen, das, soweit ich das beurteilen kann, aus einer völlig anderen Realität stammt, darauf aus bist, in Zeit und Raum Amok zu laufen und \"Therapeut zu spielen\".",shape=box,color=blue];
		1911 -> 1918;
	1912 [label="Ja, das ist der Kern der Sache! Warum bestehst du darauf, durch Zeit und Raum zu wandern und den \"Therapeuten zu spielen\"? Du, ein Wesen, das, soweit ich das beurteilen kann, aus einer völlig anderen Version der Realität stammt. ",shape=box,color=blue];
		1912 -> 1918;
	1913 [label="Scharfsinnig. Ja, gut, ich komme nun direkt zum Kern meiner Frage. Ich habe versucht, dich zu provozieren, um eine ehrlichere Antwort zu erhalten.",shape=box,color=blue];
		1913 -> 1919;
	1914 [label="Du bist wie ein Kubrow, der endlich ein Kaithe erwischt hat. Du weißt nicht, was du jetzt tun sollst, wo du deine Zähne in seinem Bein hast.",shape=box,color=blue];
		1914 -> 1904;
		1914 -> 1903;
	1915 [label="Eine der einfachsten und ältesten menschlichen Motivationen. Und daher auch eine der am leichtesten zu verstehenden.",shape=box,color=blue];
		1915 -> 1904;
	1916 [label="Obwohl du nie Soldat warst, höre ich doch in deinem Tonfall die Müdigkeit des kampferprobtesten unter ihnen.",shape=box,color=blue];
		1916 -> 1920;
	1917 [label="Wie unendlich tragisch.",shape=box,color=blue];
		1917 -> 1921;
		1917 -> 1922;
	1918 [label="Wäre ich an deiner Stelle, würde ich nach Duviri zurückkehren und versuchen, weitere Löcher im Gefüge des Voids zu entdecken, die ich durchbrechen könnte! Stell dir die Möglichkeiten vor! Stell dir die Welten vor, die nur darauf warten, erobert zu werden!",shape=box,color=blue];
		1918 -> 1923;
		1918 -> 1924;
	1919 [label="Aber ich nehme an, das muss reichen.",shape=box,color=blue];
		1919 -> 1925;
	1920 [label="Nun gut. Zwischen uns, und aus Respekt, komme ich direkt zum Kern meiner Frage. Ich habe versucht, dich zu provozieren, um eine ehrlichere Antwort zu erhalten.",shape=box,color=blue];
		1920 -> 1925;
	1921 [label="Ich habe einen Ort, an den ich gehöre.",shape=box,color=red];
		1921 -> 1926;
	1922 [label="Du hast keine Ahnung, wovon du redest.",shape=box,color=red];
		1922 -> 1927;
	1923 [label="Du bist kein bisschen anders als Albrecht. Er reist durch die Zeit und verursacht all diese Probleme. Und du willst das mit ganzen Dimensionen machen?!",shape=box,color=red];
		1923 -> 1928;
	1924 [label="Das ist das Problem mit euch Orokin. Ihr glaubt, ganze Welten gehörten euch und ihr könntet damit machen, was ihr wollt.",shape=box,color=red];
		1924 -> 1929;
	1925 [label="+5 Chemistry",color=orange];
		1925 -> 1930;
	1926 [label="Tatsache! Ist es dieses Höllvania? Oder vielleicht Duviri? Oder vielleicht dein abgestürzter Orbiter auf den Überresten der Erde?",shape=box,color=blue];
		1926 -> 1904;
		1926 -> 1903;
	1927 [label="Dann erzähl mir alles über dein Zuhause! Ist es dieses Höllvania? Oder vielleicht Duviri? Oder vielleicht dein abgestürzter Orbiter auf den Überresten der Erde?",shape=box,color=blue];
		1927 -> 1904;
		1927 -> 1903;
	1928 [label="Und warum auch nicht? Wir sind doch die überlegenen Geschöpfe, nicht wahr? Albrecht macht, was er will, und du hast kein Problem damit, hinter ihm aufzuräumen! Warum sollte ich nicht dasselbe Recht haben? Was macht sein Streben \"gerechtfertigt\" und meines nicht?",shape=box,color=blue];
		1928 -> 1931;
	1929 [label="Und warum auch nicht? Wir sind doch die überlegenen Geschöpfe, nicht wahr? Albrecht tut, was er will, wütet durch die Zeit, infiziert Massen mit einer Krankheit, die er kaum versteht, alles im Namen der \"Bezwingung eines sogenannten Gottes\".",shape=box,color=blue];
		1929 -> 1931;
	1930 [label="Ich kann beim besten Willen nicht begreifen, warum du, ein Wesen, das, soweit ich das beurteilen kann, aus einer völlig anderen Realität stammt, darauf aus bist, in Zeit und Raum Amok zu laufen und \"Therapeut zu spielen\".",shape=box,color=blue];
		1930 -> 1932;
