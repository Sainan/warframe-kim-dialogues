	1961 [label="Update boolean RoatheUnloved1",color=orange];
		1961 -> 1969;
	1963 [label="Hab Geduld. Wir müssen uns zuerst mit der Gleichgültigkeit auseinandersetzen.",shape=box,color=red];
		1963 -> 1971;
	1964 [label="Vielleicht, wenn sich die Lage beruhigt hat. Aber nicht jetzt.",shape=box,color=red];
		1964 -> 1972;
	1965 [label="Und du glaubst, ich würde dich dafür auswählen? Das ist lächerlich.",shape=box,color=red];
		1965 -> 1973;
	1966 [label="Du weißt weder, was du tust, noch warum du es tust; du tust einfach nur, was dir befohlen wird. Ein weiterer selbstherrlicher Handlanger eines selbstherrlichen Orokin. Schande.",shape=box,color=blue];
		1966 -> 1974;
	1967 [label="Ich will damit nur sagen, dass du anscheinend wirklich wütend darüber bist, dass Menschen nicht mehr unglücklich sind. Und du scheinst das sehr persönlich zu nehmen.",shape=box,color=red];
		1967 -> 1975;
	1968 [label="Was ich versuche zu sagen ist, dass, wenn die \"Gleichgültigkeit\" sich von einem Mangel an Emotionen nährt, dann sind Emotionen vielleicht der Schlüssel zu ihrer Überwindung.",shape=box,color=red];
		1968 -> 1976;
	1970 [label="Glaubst du, es ist unmöglich, dass dich jemand liebt? Oder glaubst du, du bist nicht fähig, Liebe für jemand anderen zu empfinden? Oder glaubst du, es ist einfach noch nicht passiert?",shape=box,color=red];
		1970 -> 1977;
	1969 [label="Nein, war und hab ich nicht. Wenn du darauf bestehst, dass wir das Universum vor dieser \"Gleichgültigkeit\" retten werden, indem wir Händchen halten und Lieder singen, entschuldige mich bitte, während ich in Fibonaccis Tank kotze.",shape=box,color=blue];
		1969 -> 1970;
		1969 -> 1967;
