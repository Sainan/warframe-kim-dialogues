	1974 [label="Chat ends.",color=orange];
	1975 [label="Weil geteiltes Leid halbes Leid ist? Vielleicht. Oder weil ich einfach nicht verstehe, warum du deine Zeit verschwendest, anstatt sinnvolle Arbeit zu erledigen.",shape=box,color=blue];
		1975 -> 1980;
	1976 [label="Ein weiterer Beweis dafür, dass das Ganze nur deiner Fantasie entspringt! Welcher wahre Gott oder \"Anti-Gott\" könnte jemals durch die \"Güte menschlicher Gefühle\" besiegt werden?! Ha! ",shape=box,color=blue];
		1976 -> 1981;
	1977 [label="Update boolean RoatheUnloved2",color=orange];
		1977 -> 1982;
	1978 [label="Ich vermute, wir haben noch einiges zu tun, wie du sagst. Ich kann einfach nicht begreifen, dass sowas ... kindisches einen Sinn haben soll. Aber gut, ich sitze hier am Rande des Geschehens, und du bist derjenige, der die Schlüssel zum Universum besitzt.",shape=box,color=blue];
		1978 -> 1983;
	1979 [label="Ein berechtigter Einwand. Warum würdest du ausgerechnet jemanden so verabscheuungswürdigen wie den Teufel von Tau auswählen?",shape=box,color=blue];
		1979 -> 1984;
	1980 [label="Aber jetzt bin ich überzeugt, dass du weder weißt, was du tust, noch warum, und dass du einfach nur Befehle befolgst. Ein weiterer selbstherrlicher Handlanger eines selbstherrlichen Orokin. Schande.",shape=box,color=blue];
		1980 -> 1985;
