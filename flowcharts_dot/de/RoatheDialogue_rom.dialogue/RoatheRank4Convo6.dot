digraph {
	"RoatheRank4Convo6 begins." [color=orange];
		"RoatheRank4Convo6 begins." -> j2243454925;
	j2243454925 [label="Welches ist deine liebste Art zu töten, Usurpator?",shape=box,color=blue];
		j2243454925 -> j3525077598;
		j2243454925 -> j3458209386;
		j2243454925 -> j129698615;
	j3525077598 [label="Wie bitte?",shape=box,color=red];
		j3525077598 -> j1433975091;
	j3458209386 [label="Willst du es herausfinden?",shape=box,color=red];
		j3458209386 -> j751281308;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j1433975091 [label="Ich neige in letzter Zeit dazu, philosophisch zu werden, und bin einfach neugierig.",shape=box,color=blue];
		j1433975091 -> j1277517134;
	j751281308 [label="Ha! Wohl kaum. Obwohl ... ein paar Runden mit dir wären schon ganz lustig. Nein, ich neige in letzter Zeit dazu, philosophisch zu werden, und bin einfach neugierig.",shape=box,color=blue];
		j751281308 -> j1277517134;
	"Chat ends." [color=orange];
	j1277517134 [label="Zahlenmäßig dürften wir wohl auf gleicher Höhe sein. Was die Tödlichkeit angeht, nun ja ... ich würde keine Wette abschließen wollen und bin auch nicht sonderlich an einem sprichwörtlichen Schwertvergleich interessiert.",shape=box,color=blue];
		j1277517134 -> j3421991484;
	j3421991484 [label="Killer zu Killer. Was bevorzugst du? Den persönlichen Nahkampf? Oder lieber Heimlichkeit oder das Chaos des Schlachtfelds?",shape=box,color=blue];
		j3421991484 -> j1335569033;
		j3421991484 -> j1661789141;
		j3421991484 -> j215987068;
		j3421991484 -> j2198088055;
	j1335569033 [label="Ich bevorzuge Chaos. Explosionen. Schüsse. Laute Geräusche. Je mehr, desto besser.",shape=box,color=red];
		j1335569033 -> j4099836879;
	j1661789141 [label="Heimlichkeit. Ich ziehe es vor, meinen Feind auszuschalten, bevor er mich überhaupt bemerkt. Am liebsten würde ich es dort tun, wo er schläft.",shape=box,color=red];
		j1661789141 -> j1914403219;
	j215987068 [label="Ich hasse Kämpfen. Ich wünschte, ich müsste nie tun.",shape=box,color=red];
		j215987068 -> j2732621572;
	j2198088055 [label="Das ist ein krankes Gespräch.",shape=box,color=red];
		j2198088055 -> j1805917563;
	j4099836879 [label="Boolean RoatheSoldier is now true.",color=orange];
		j4099836879 -> j3417528289;
	j1914403219 [label="Boolean RoatheAssassin is now true.",color=orange];
		j1914403219 -> j4053318298;
	j2732621572 [label="Oh mein armer, armer Usurpator, hättest du mich doch nur lachen hören können ...",shape=box,color=blue];
		j2732621572 -> j2411373303;
	j1805917563 [label="Dann, kusch.",shape=box,color=blue];
		j1805917563 -> "Chat ends.";
	j3417528289 [label="Ein kampferprobter Soldat wie ich. Angesichts deiner Vergangenheit bin ich nicht überrascht. So viel Blut folgt dir auf Schritt und Tritt. Erst Duviri, dann \"Narmer\", dieses Höllvania. Und jetzt diese Sache.",shape=box,color=blue];
		j3417528289 -> j1646853252;
	j4053318298 [label="Ah, ein Attentäter unter uns! So nützlich und doch so unterschätzt. Ich habe Attentäter immer mit talentierten Butlern verglichen.",shape=box,color=blue];
		j4053318298 -> j56195092;
	j2411373303 [label="Du elende, armselige Kreatur. Ich hoffe für dich, dass du mich anlügst.",shape=box,color=blue];
		j2411373303 -> j4108516697;
	j1646853252 [label="Wer weiß, was sonst noch geschah, oder was du in der Zwischenzeit vergessen hast. Der Tod ist deine Kunst, und du malst die Welten in ihm.",shape=box,color=blue];
		j1646853252 -> j2783682048;
	j56195092 [label="Wenn sie ihre Arbeit außergewöhnlich gut machen, bleiben sie stets unbemerkt.",shape=box,color=blue];
		j56195092 -> j2841205976;
	j4108516697 [label="+20 Chemistry",color=orange];
		j4108516697 -> j1827927941;
	j2783682048 [label="Na dann! Was ist dein Lieblingspinsel? Lass uns tiefer gehen.",shape=box,color=blue];
		j2783682048 -> j1245474815;
		j2783682048 -> j3922958919;
		j2783682048 -> j3615684417;
		j2783682048 -> j292341955;
	j2841205976 [label="Also. Dolch? Gift? Bogen?",shape=box,color=blue];
		j2841205976 -> j4015050261;
		j2841205976 -> j3826122745;
		j2841205976 -> j1808620116;
		j2841205976 -> j846585167;
		j2841205976 -> j3500395446;
	j1827927941 [label="Ansonsten wäre das vielleicht das Traurigste, was ich in all meinen Jahren je gehört habe.",shape=box,color=blue];
		j1827927941 -> j2927459171;
	j1245474815 [label="Ich werde mit dem auskommen, was ich habe, ehrlich gesagt. Ich improvisiere gern.",shape=box,color=red];
		j1245474815 -> j893725072;
	j3922958919 [label="Bogen. Anmutig und tödlich.",shape=box,color=red];
		j3922958919 -> j1790841065;
	j3615684417 [label="Eine Klinge. Ich gehe gern ganz nah ran.",shape=box,color=red];
		j3615684417 -> j1351731654;
	j292341955 [label="Gewehre und Pistolen. Laut, aber sie erfüllen ihren Zweck.",shape=box,color=red];
		j292341955 -> j2846537853;
	j4015050261 [label="Ich werde mit dem auskommen, was ich habe, ehrlich gesagt. Ich improvisiere gern.",shape=box,color=red];
		j4015050261 -> j826621503;
	j3826122745 [label="Bogen. Anmutig und lautlos.",shape=box,color=red];
		j3826122745 -> j3980190096;
	j1808620116 [label="Scharfschützengewehr. Ein Schuss? Ein Treffer.",shape=box,color=red];
		j1808620116 -> j2134763898;
	j846585167 [label="Gift. Ich bin weg, bevor sie überhaupt merken, dass sie tot sind.",shape=box,color=red];
		j846585167 -> j2875509375;
	j3500395446 [label="Dolch. Ich mag die Intimität daran.",shape=box,color=red];
		j3500395446 -> j2149501764;
	j2927459171 [label="Boolean RoatheWeaponNone is now true.",color=orange];
		j2927459171 -> "Chat ends.";
	j893725072 [label="Ich stelle mir gerade vor, wie du mit einer Sanitätsbank über das Schlachtfeld stürmst. Wie du mit einem an ein verbogenes Rohr geschnallten Reifen durch die Reihen der Soldaten fegst.",shape=box,color=blue];
		j893725072 -> j4119415482;
	j1790841065 [label="Im Kampfgetümmel einen Bogen zu führen, erfordert Entschlossenheit und Geistesklarheit, wie sie nur wenige aufbringen können. Und natürlich ruhige Hände.",shape=box,color=blue];
		j1790841065 -> j3338648635;
	j1351731654 [label="Mm, vorsichtig. Begeister mich nicht zu sehr, Usurpator. Wie gern würde ich dich über das Schlachtfeld tanzen sehen, die Waffen in der Hand, Blutfontänen wie die Blütenblätter einer sich weit öffnenden Blume ...",shape=box,color=blue];
		j1351731654 -> j892096636;
	j2846537853 [label="Sie sind seit ihrer Erfindung nicht ohne Grund das Arbeitspferd jedes Krieges, Usurpator. Es lässt sich jedoch kaum leugnen, dass sie, sobald sie ihr Ziel erreichen, ihren Zweck erfüllen.",shape=box,color=blue];
		j2846537853 -> j1800068603;
	j826621503 [label="Ich stelle mir gerade vor, wie du jemanden mit einer Gabel oder einem Stuhlbein ermordest. Jemandem mit einem Gardinenhalter das Leben raubst.",shape=box,color=blue];
		j826621503 -> j1009965068;
	j3980190096 [label="Die Methode des Jägers. Unkompliziert, aber elegant in ihrer Schlichtheit. Manchmal sind die einfachsten und ältesten Methoden im Grunde die wirksamsten.",shape=box,color=blue];
		j3980190096 -> j1844972073;
	j2134763898 [label="Etwas unpersönlich und klinisch für meinen Geschmack, aber ich kann die Effizienz nicht verurteilen. Die Ruhe hat durchaus ihren Reiz.",shape=box,color=blue];
		j2134763898 -> j1362094894;
	j2875509375 [label="Wie ein finsterer Apotheker, hm? Braut Tinkturen und schüttet sie den Ahnungslosen in die Gläser? Oder mit Gift präparierte Messer und Kugeln, sodass der geringste Streifschuss auf dem Schlachtfeld tödlich wird?",shape=box,color=blue];
		j2875509375 -> j3495591097;
	j2149501764 [label="Mm, vorsichtig. Begeister mich nicht zu sehr, Usurpator. Wie verlockend, die Vorstellung, eines Nachts aufzuwachen und dich im Schatten lauern zu sehen, den Dolch gezückt, bereit zuzuschlagen ...",shape=box,color=blue];
		j2149501764 -> j933059390;
	j4119415482 [label="+10 Chemistry",color=orange];
		j4119415482 -> j1838413892;
	j3338648635 [label="Die Stille dabei ist bewundernswert. Das Auflegen des Pfeils, das Spannen, die Vorfreude auf den Abschuss ... und dann der süße, süße Tod, wenn er sein Ziel trifft?",shape=box,color=blue];
		j3338648635 -> j64197591;
	j892096636 [label="Ich verstehe den Wunsch nach persönlicher Note. Zuzusehen, wie die Gliedmaßen des Opfers abfallen, während dessen Leben endet. Zu sehen, wie leblose Körper vor dir zusammenbrechen. Zu wissen, dass du es warst, der dies getan hat, und niemand sonst.",shape=box,color=blue];
		j892096636 -> j4253491281;
	j1800068603 [label="Schmutzig, laut, unverschämt teuer. Aber so, so gut im Töten.",shape=box,color=blue];
		j1800068603 -> j1822998508;
	j1009965068 [label="+10 Chemistry",color=orange];
		j1009965068 -> j2289347813;
	j1844972073 [label="Die Stille dabei ist bewundernswert. Das Auflegen des Pfeils, das Spannen, die Vorfreude auf den Abschuss ... und dann der süße, süße Tod, wenn er sein Ziel trifft?",shape=box,color=blue];
		j1844972073 -> j3884505922;
	j1362094894 [label="Im scheinbar unerbittlichen Lärm des Schlachtfelds muss der Scharfschütze wie die Gezeiten des Ozeans seinen Atem finden. Einatmen, ausatmen und ein Leben nehmen.",shape=box,color=blue];
		j1362094894 -> j2867606829;
	j3495591097 [label="Ich habe ganze Bataillone gesehen, die durch eine einzige Schnittwunde am Arm eines einzigen Soldaten zu Brühe wurden. Ein Giftstoff, der sich vom Blut über die Lunge in die Lunge eines anderen ausbreitet, kann ganze Länder zerstören.",shape=box,color=blue];
		j3495591097 -> j4212289695;
	j933059390 [label="Ich schätze den Wunsch nach persönlicher Nähe. Jemandem in die Augen zu schauen und zu sehen, wie sie glasig und trüb werden, während das Licht schwindet und die Wärme aus seinem Körper weicht.",shape=box,color=blue];
		j933059390 -> j3505265563;
	j1838413892 [label="Ich kann mich nicht entscheiden, ob dich das furchteinflößender oder weniger furchterregend macht, Usurpator. Ich tendiere eher zu furchteinflößender. So oder so finde ich es amüsant und auf seine Art bemerkenswert.",shape=box,color=blue];
		j1838413892 -> j777855750;
	j64197591 [label="+10 Chemistry",color=orange];
		j64197591 -> j2090162801;
	j4253491281 [label="+10 Chemistry",color=orange];
		j4253491281 -> j1394862125;
	j1822998508 [label="+10 Chemistry",color=orange];
		j1822998508 -> j2286986422;
	j2289347813 [label="Ich kann mich nicht entscheiden, ob dich das furchteinflößender oder weniger furchterregend macht, Usurpator. Ich tendiere eher zu furchteinflößender. So oder so finde ich es amüsant und auf seine Art bemerkenswert.",shape=box,color=blue];
		j2289347813 -> j777855750;
	j3884505922 [label="+10 Chemistry",color=orange];
		j3884505922 -> j707835305;
	j2867606829 [label="+10 Chemistry",color=orange];
		j2867606829 -> j44746084;
	j4212289695 [label="+10 Chemistry",color=orange];
		j4212289695 -> j276377991;
	j3505265563 [label="+10 Chemistry",color=orange];
		j3505265563 -> j1976767516;
	j777855750 [label="Boolean RoatheWeaponImprov is now true.",color=orange];
		j777855750 -> j1649123792;
		j777855750 -> j3806893510;
		j777855750 -> j3335465002;
	j2090162801 [label="Wundervoll.",shape=box,color=blue];
		j2090162801 -> j2888608214;
	j1394862125 [label="Was für ein schöner Moment.",shape=box,color=blue];
		j1394862125 -> j918012326;
	j2286986422 [label="Es hat eine gewisse Schönheit.",shape=box,color=blue];
		j2286986422 -> j4290874667;
	j707835305 [label="Wundervoll.",shape=box,color=blue];
		j707835305 -> j2888608214;
	j44746084 [label="Darin liegt Schönheit.",shape=box,color=blue];
		j44746084 -> j4290874667;
	j276377991 [label="Tod in solch einem Ausmaß? Darin liegt eine Schönheit.",shape=box,color=blue];
		j276377991 -> j3609398078;
	j1976767516 [label="Was für ein wundervoller Moment.",shape=box,color=blue];
		j1976767516 -> j918012326;
	j1649123792 [label="Bei dir klingt das so, als wäre es eine Art ... Kunstform.",shape=box,color=red];
		j1649123792 -> j817281078;
	j3806893510 [label="Ich mag es nicht, töten zu müssen, Roathe.",shape=box,color=red];
		j3806893510 -> j2915329972;
	j3335465002 [label="Und was ist dein Favorit?",shape=box,color=red];
		j3335465002 -> j1147219045;
	j2888608214 [label="Boolean RoatheWeaponBow is now true.",color=orange];
		j2888608214 -> j1649123792;
		j2888608214 -> j3806893510;
		j2888608214 -> j3335465002;
	j918012326 [label="Boolean RoatheWeaponDagger is now true.",color=orange];
		j918012326 -> j1649123792;
		j918012326 -> j3806893510;
		j918012326 -> j3335465002;
	j4290874667 [label="Boolean RoatheWeaponSniper is now true.",color=orange];
		j4290874667 -> j1649123792;
		j4290874667 -> j3806893510;
		j4290874667 -> j3335465002;
	j3609398078 [label="Boolean RoatheWeaponPoison is now true.",color=orange];
		j3609398078 -> j1649123792;
		j3609398078 -> j3806893510;
		j3609398078 -> j3335465002;
	j817281078 [label="Das ist es. Und das weißt du. Tatsächlich basiert die Hälfte deiner Existenz buchstäblich auf dem Konzept, das Töten als Kunstform zu betrachten!",shape=box,color=blue];
		j817281078 -> j2712176221;
	j2915329972 [label="Oh? Wirklich? Lass uns das einen Moment genauer betrachten.",shape=box,color=blue];
		j2915329972 -> j1589966132;
	j1147219045 [label="Es hat sich in letzter Zeit geändert. Und das stört mich ungemein.",shape=box,color=blue];
		j1147219045 -> j2133315471;
		j1147219045 -> j4259579295;
	j2712176221 [label="Ich sehe diese \"Schulen\", die die Tenno führen und die du indirekt übernimmst. Ganz zu schweigen von den Lehren der Dax. Wie sie endlos über Funk redeten, egal wie oft wir ihnen sagten, dass es ein eingeschränkter Kanal sei.",shape=box,color=blue];
		j2712176221 -> j3511390472;
	j1589966132 [label="Verrat mir etwas, und bitte antworte ehrlich. Denn Lügen in diesem Moment schaden uns beiden, vor allem aber dir selbst:",shape=box,color=blue];
		j1589966132 -> j259115677;
	j2133315471 [label="Geändert, wie?",shape=box,color=red];
		j2133315471 -> j2083035860;
	j4259579295 [label="Wegen Uriel?",shape=box,color=red];
		j4259579295 -> j2585302925;
	j3511390472 [label="Wenn ich nie wieder einen von ihnen sagen höre: \"Ich bin eine Klinge\" und \"Ich existiere, um zuzuschlagen\", werde ich glücklich sterben, Usurpator.",shape=box,color=blue];
		j3511390472 -> j2175851822;
	j259115677 [label="Wolltest du jemals eine Waffe oder einen Warframe haben, der deinem persönlichen Geschmack entspricht? Vielleicht mit einer einzigartigen Lackierung oder einem Aussehen, das besser zu deiner Stimmung passt?",shape=box,color=blue];
		j259115677 -> j3131581005;
		j259115677 -> j2898869815;
		j259115677 -> j381399096;
	j2083035860 [label="Früher bevorzugte ich das Schwert als Waffe. Elegant. Schnell. Ich konnte mich über das Schlachtfeld bewegen und meine Feinde im Nahkampf niederstrecken. Purpurrot auf einer silbernen Klinge, aufblitzend im Schein eines blauen Sterns.",shape=box,color=blue];
		j2083035860 -> j1370004792;
	j2585302925 [label="Ich nehme es an. Oder vielleicht liegt es an meinen Erinnerungslücken. Ich weiß nicht, welche anderen Gründe dafür verantwortlich sein könnten.",shape=box,color=blue];
		j2585302925 -> j2083035860;
	j2175851822 [label="Die Menschheit hat \"Mord\" immer als Sünde, das \"Töten\" hingegen als Kunst betrachtet. Ist dir das nie seltsam vorgekommen? Ein Schwert zu führen und einen Feind im Kampf zu fällen, lässt einen beinahe transzendent erscheinen.",shape=box,color=blue];
		j2175851822 -> j2734637114;
	j3131581005 [label="Ja ... was hat das denn damit zu tun?",shape=box,color=red];
		j3131581005 -> j1955101275;
	j2898869815 [label="Nein. Niemals.",shape=box,color=red];
		j2898869815 -> j1621319357;
	j381399096 [label="Dieses Spiel mache ich nicht mit. [Ende.]",shape=box,color=red];
		j381399096 -> j1994751785;
	j1370004792 [label="Aber jetzt? Jetzt will ich das Blut zwischen meinen Zähnen schmecken. Spüren, wie es unter meinen Klauen hervorquillt. Ich will meine Finger tief in Fleisch und Knochen versenken und es in Stücke reißen.",shape=box,color=blue];
		j1370004792 -> j3649324092;
	j2734637114 [label="Einen Mann in einer Gasse mit einem geschärften Metallstück zu töten, bedeutet, ein Feigling und ein Verkommener zu sein.",shape=box,color=blue];
		j2734637114 -> j4068848243;
	j1955101275 [label="Ich schätze deine Ehrlichkeit. Nun will ich nicht bestreiten, dass du höchstwahrscheinlich keine Freude an kaltblütigem Mord hast und dass die Auslöschung eines unschuldigen Lebens nichts ist, woran du Vergnügen findest (obwohl du es vielleicht doch hast und deine vorherige Aussage eine Lüge war, und wie reizvoll wäre es, dies aufzudecken; darum geht es hier aber nicht).",shape=box,color=blue];
		j1955101275 -> j1543788685;
	j1621319357 [label="Ich bitte dich, einen Moment innezuhalten und nachzudenken. Ich habe deine Tenno-Freunde hier wüten sehen, wie bunte, alptraumhafte Gestalten aus einem Zirkus. Als wäre ein wildes Tier in die Farbtöpfe eines Künstlers gefallen.",shape=box,color=blue];
		j1621319357 -> j3181790688;
	j1994751785 [label="Wie du willst.",shape=box,color=blue];
		j1994751785 -> "Chat ends.";
	j3649324092 [label="Ich will den Blutsaft tief trinken, während ich Sehnen zerreiße und spüre, wie der Körper unter mir zu blutigen Splittern zerfällt. Ihn wie eine süße Frucht auseinanderschälen, während das Mark fließt.",shape=box,color=blue];
		j3649324092 -> j1245686433;
		j3649324092 -> j3878215208;
	j4068848243 [label="Worin liegt der Unterschied? \"Ehre?\" Wer entscheidet, was ehrenhaft ist und was nicht? Der Verlierer? Oder der Gewinner? Oder ist es einfach die Existenz einer ausreichenden Tradition, die festlegt, was ehrenhaft ist und was nicht?",shape=box,color=blue];
		j4068848243 -> j1881974097;
		j4068848243 -> j165181062;
		j4068848243 -> j3786808030;
	j1543788685 [label="Angenommen, das ist nicht der Fall und du tötest einfach, weil du es \"musst\", wie du behauptest, warum, bitte schön, würdest du dann Zeit damit verbringen, deine Tötungswaffen individuell auszustatten?",shape=box,color=blue];
		j1543788685 -> j740792869;
	j3181790688 [label="Hast du dich nie gezwungen gefühlt, dasselbe zu tun? Nicht ein einziges Mal? Ich versichere dir, dass ich dich deswegen nicht weniger schätzen werde.",shape=box,color=blue];
		j3181790688 -> j4083082446;
		j3181790688 -> j3556683749;
	j1245686433 [label="Roathe?",shape=box,color=red];
		j1245686433 -> j501423632;
	j3878215208 [label="Und das ist ... nicht normal für dich?",shape=box,color=red];
		j3878215208 -> j611938171;
	j1881974097 [label="Ich verstehe, was du meinst. Die Grenze ist fließend.",shape=box,color=red];
		j1881974097 -> j4270433436;
	j165181062 [label="Das eine erfordert Übung und Hingabe. Das andere ist einfach nur ... Brutalität.",shape=box,color=red];
		j165181062 -> j14720943;
	j3786808030 [label="Darüber unterhalte ich mich nicht. [Ende.]",shape=box,color=red];
		j3786808030 -> j547454960;
	j740792869 [label="Warum sollte es dich kümmern, wie du auf dem Schlachtfeld auf andere wirkst? Sicherlich nicht, damit man deine Leiche erkennt. Dich gibt es nirgendwo zu verwechseln. Nein, denn wenn du schon ein Mörder sein musst, mein lieber Usurpator, dann wette ich, dass du es mit Stil tun willst.",shape=box,color=blue];
		j740792869 -> j740614143;
	j4083082446 [label="Nein.",shape=box,color=red];
		j4083082446 -> j1994751785;
	j3556683749 [label="Gut. Habe ich. Warum?",shape=box,color=red];
		j3556683749 -> j1955101275;
	j501423632 [label="Ja, ich weiß! Ich weiß. Ich werde aber nichts davon tun, wohlgemerkt. Ich werde auch nicht den ganzen Laden hier niederbrennen, obwohl es mich danach giert.",shape=box,color=blue];
		j501423632 -> j4288893600;
	j611938171 [label="Nein! Nein, das ist es nicht! Und es ist auch nicht normal, dass mir beim Gedanken daran, diesen ganzen Ort um mich herum niederzubrennen, das Wasser im Mund zusammenläuft!",shape=box,color=blue];
		j611938171 -> j4288893600;
	j4270433436 [label="Alle diese Grenzen sind willkürlich gezogen. Und je eher wir das alle begreifen, desto schneller können wir uns darüber einigen, welche Kämpfe wichtig sind und welche nicht.",shape=box,color=blue];
		j4270433436 -> j1653170270;
	j14720943 [label="Gut, folgen wir dieser Argumentation mal zu Ende. Töten durch genügend Übung macht es ehrenhaft? Du meinst also, wenn ich wie Dax bin und meinen Mord nur mit genügend Pomp und Prunk verkleide, wird er dadurch zur Kunst?",shape=box,color=blue];
		j14720943 -> j1430778285;
	j547454960 [label="Wie du meinst.",shape=box,color=blue];
		j547454960 -> "Chat ends.";
	j740614143 [label="Und was ist das anderes als die Freude an der Tat, frage ich?",shape=box,color=blue];
		j740614143 -> j2896198573;
	j4288893600 [label="Uriel ist schuld daran. Ich gebe zwar zu, dass ich schon früher zu solch zerstörerischen und blutrünstigen Gedanken neigte, aber sie waren bei Weitem nicht so katastrophal.",shape=box,color=blue];
		j4288893600 -> j3161302100;
	j1653170270 [label="Die Frage, ob ein Mord ehrenhaft begangen wurde, ist wie die Frage, was schlimmer ist: Tod durch Feuer oder Tod durch Ertrinken. Beides ist qualvoll.",shape=box,color=blue];
		j1653170270 -> j3039787052;
	j1430778285 [label="Wir bewegen uns nun am Rande von Ritual und Religion.",shape=box,color=blue];
		j1430778285 -> j2258493759;
	j2896198573 [label="Versteh mich nicht falsch! Ich verurteile dich nicht. Du machst das Beste aus deiner Situation! Der Tod hat dich in diesem großen Theaterstück des Lebens zu seinem Tanzpartner gemacht, und du kannst nicht anders, als seinem Ruf zu folgen.",shape=box,color=blue];
		j2896198573 -> j3273645727;
	j3161302100 [label="Und ganz gewiss nicht so ... apokalyptisch.",shape=box,color=blue];
		j3161302100 -> "Chat ends.";
	j3039787052 [label="Alle Wege führen zum Grab, also wozu die Haarspalterei? Wir haben weitaus wichtigere Probleme zu lösen.",shape=box,color=blue];
		j3039787052 -> "Chat ends.";
	j2258493759 [label="Zumindest liegt in dem einfachen, schnellen Tod durch ein Messer im Rücken eine gewisse Ehrlichkeit. Nichts daran ist fromm, nichts Aufdringliches oder Überladenes. Es passiert einfach.",shape=box,color=blue];
		j2258493759 -> j3136741230;
	j3273645727 [label="Hättest du deine Waffen niedergelegt, wie viele wären dann wohl noch neben dir tot gewesen? Nein, warum nicht ein wenig Stolz auf deine Arbeit empfinden? Ein wenig Freude an der Kunstfertigkeit? Was ist die Alternative, frage ich dich? Wahnsinn? Vergessenheit?",shape=box,color=blue];
		j3273645727 -> j2310693419;
	j3136741230 [label="Ist darin nicht Kunst?",shape=box,color=blue];
		j3136741230 -> "Chat ends.";
	j2310693419 [label="Ich habe zu viele diesen Weg gehen sehen und am Ende wartete der Galgen auf sie. Nein. Ich sage: Tu, was du willst, Usurpator. Denn das Leben hat dir gewiss seinen Willen aufgezwungen.",shape=box,color=blue];
		j2310693419 -> "Chat ends.";
}