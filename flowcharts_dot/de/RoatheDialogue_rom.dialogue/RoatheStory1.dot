	j3792979253 [label="SN: NITOKH",shape=box,color=blue];
		j3792979253 -> j1865026676;
	j1865026676 [label="Transkript: Ihr Wahnsinn war verführerisch, weil so offensichtlich.",shape=box,color=blue];
		j1865026676 -> j3141726226;
	j3141726226 [label="Man wusste immer, woran man bei ihr war – am Rande des Abgrunds.",shape=box,color=blue];
		j3141726226 -> j456530050;
	j456530050 [label="'Spring hinein', sagten ihre Augen zu mir, glänzend vor Freude über einen gigantischen kosmischen Scherz.",shape=box,color=blue];
		j456530050 -> j3761819060;
	j3761819060 [label="Durch ihre wahnsinnigen Visionen konnte ich der langen, trostlosen Stagnation des Daseins der Orokin entfliehen.",shape=box,color=blue];
		j3761819060 -> j1168767286;
	j1168767286 [label="Unsere Sinne waren schon vor Jahrhunderten abgestumpft. Doch sie war auf ihre Weise noch immer frisch.",shape=box,color=blue];
		j1168767286 -> j4083058878;
	j4083058878 [label="Ewig. Unstillbar in ihrem Hunger. Eines Abends rief sie mich zu ihrem Bad. Ich schritt durch die sich vermischenden Pfützen aus duftendem Wasser und Blut und stand pflichtbewusst bereit.",shape=box,color=blue];
		j4083058878 -> j1254701161;
	j1254701161 [label="'Mir ist langweilig, Roathe. Lass uns alle anderen Orokin töten und die Herrschaft übernehmen.'",shape=box,color=blue];
		j1254701161 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}