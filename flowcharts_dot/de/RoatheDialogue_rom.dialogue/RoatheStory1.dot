	2132 [label="Transkript: Ihr Wahnsinn war verführerisch, weil so offensichtlich.",shape=box,color=blue];
		2132 -> 5636;
	5636 [label="Man wusste immer, woran man bei ihr war – am Rande des Abgrunds.",shape=box,color=blue];
		5636 -> 5635;
	5635 [label="'Spring hinein', sagten ihre Augen zu mir, glänzend vor Freude über einen gigantischen kosmischen Scherz.",shape=box,color=blue];
		5635 -> 5637;
	5637 [label="Durch ihre wahnsinnigen Visionen konnte ich der langen, trostlosen Stagnation des Daseins der Orokin entfliehen.",shape=box,color=blue];
		5637 -> 2136;
	2136 [label="Unsere Sinne waren schon vor Jahrhunderten abgestumpft. Doch sie war auf ihre Weise noch immer frisch.",shape=box,color=blue];
		2136 -> 5638;
	5638 [label="Ewig. Unstillbar in ihrem Hunger. Eines Abends rief sie mich zu ihrem Bad. Ich schritt durch die sich vermischenden Pfützen aus duftendem Wasser und Blut und stand pflichtbewusst bereit.",shape=box,color=blue];
		5638 -> 5639;
	5639 [label="'Mir ist langweilig, Roathe. Lass uns alle anderen Orokin töten und die Herrschaft übernehmen.'",shape=box,color=blue];
		5639 -> 2135;
	2135 [label="Add 1 to HellStory",color=orange];
		2135 -> 2328;
