digraph {
	"RoatheRank2Convo4 begins." [color=orange];
		"RoatheRank2Convo4 begins." -> j1115193858;
	j1115193858 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		j1115193858 -> j1437250236 [label=true,color=green];
		j1115193858 -> "Chat ends." [label=false,color=brown];
	j1437250236 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1437250236 -> j1497355402 [label=true,color=green];
		j1437250236 -> j1692949551 [label=false,color=brown];
	"Chat ends." [color=orange];
	j1497355402 [label="Hm. Sag mal. Konnte ich dich beim letzten Mal davon überzeugen, dass deine \"Gleichgültigkeit\" lediglich eine Ansammlung zusammengewürfelter Kinderspielzeuge ist, oder glaubst du am Ende immer noch, dass es sich um eine \"große, unergründliche Entität aus dem Void\" handelt?",shape=box,color=blue];
		j1497355402 -> j367996510;
	j1692949551 [label="Check boolean RoatheMITW1",color=orange];
		j1692949551 -> j4103835033 [label=true,color=green];
		j1692949551 -> j1114899445 [label=false,color=brown];
	j367996510 [label="Wenn es etwas auf der Welt gibt, das ich verabscheue, dann ist es, meinen Schwanz zu jagen. Und diese Metapher war früher viel treffender als heute, wie mir gerade klar wurde.",shape=box,color=blue];
		j367996510 -> j3896401165;
		j367996510 -> j152843436;
		j367996510 -> j3422587141;
	j4103835033 [label="Bevor wir fortfahren, möchte ich jedoch sichergehen, dass ich alles richtig verstanden habe. Du glaubst also, dass die Gleichgültigkeit eine schreckliche, unergründliche Entität aus dem Void ist, die aufgrund von Albrechts Fehlern in unsere Realität eindringt?",shape=box,color=blue];
		j4103835033 -> j1934501120;
	j1114899445 [label="Alle, mit denen ich in diesem Irrenhaus spreche, sind felsenfest davon überzeugt, dass dieser \"Mann in der Wand\" eine Art buchstäblicher und lächerlicher Gott ist. Ein wahrer Gott. Sogar diese beiden Fanatiker scheinen mit dem Gedanken zu spielen!",shape=box,color=blue];
		j1114899445 -> j4168857704;
		j1114899445 -> j3841534208;
		j1114899445 -> j751700322;
	j3896401165 [label="Nein, konntest du nicht. Tut mir leid.",shape=box,color=red];
		j3896401165 -> j1484647985;
	j152843436 [label="Das hast du tatsächlich getan.",shape=box,color=red];
		j152843436 -> j3710014381;
	j3422587141 [label="Wir haben uns nicht wirklich einigen können.",shape=box,color=red];
		j3422587141 -> j226091073;
	j1934501120 [label="Erlaube mir, meine Frage folgendermaßen zu formulieren, bevor wir uns im Kreis drehen und am Ende wieder unsere Schwänze jagen. Was ... eine Metapher ist, die, wie ich jetzt erst merke, früher viel sprichwörtlicher war als heute, aber ich schweife ab.",shape=box,color=blue];
		j1934501120 -> j769695223;
	j4168857704 [label="Du glaubst nicht, dass er real ist?",shape=box,color=red];
		j4168857704 -> j1546018429;
	j3841534208 [label="Und wenn du ihn nicht für einen Gott hältst, was glaubst du, was er ist?",shape=box,color=red];
		j3841534208 -> j2450265427;
	j751700322 [label="Und du nicht?",shape=box,color=red];
		j751700322 -> j3072632749;
	j1484647985 [label="Boolean RoatheMITWSkip is now true.",color=orange];
		j1484647985 -> j3009590685;
	j3710014381 [label="Boolean RoatheMITWSkip is now true.",color=orange];
		j3710014381 -> j3535956323;
	j226091073 [label="Ah! Nun, dann muss ich da wohl noch etwas dran arbeiten.",shape=box,color=blue];
		j226091073 -> j3864067293;
	j769695223 [label="Glaubst du, dass die Entität, die du jetzt die Gleichgültigkeit nennst, bereits existierte, bevor Albrecht damit anfing rumzuspielen? Oder glaubst du, er hat sie erschaffen, als er zum ersten Mal mit dem Void interagierte?",shape=box,color=blue];
		j769695223 -> j3834511663;
		j769695223 -> j4154936658;
		j769695223 -> j227917826;
		j769695223 -> j1150216581;
	j1546018429 [label="Habe ich das behauptet? Leg mir nicht so schnell Worte in den Mund, du vergänglicher Usurpator. Ich habe nicht geleugnet, dass die Gleichgültigkeit \"real\" ist. Ich behaupte, dass es keine Gottheit ist.",shape=box,color=blue];
		j1546018429 -> j436506494;
		j1546018429 -> j610917129;
	j2450265427 [label="Ich kann dir diese falsche Gottheit in zwei einfachen Worten entlarven, die du kennst und gut verstehst:",shape=box,color=blue];
		j2450265427 -> j3969827930;
	j3072632749 [label="Auf keinen Fall! Erstens gibt es keinen Gott und keine Götter, die Vorstellung ist absurd. Zweitens, zu glauben, Albrecht hätte einen Gott des Voids entfesselt? Noch lächerlicher!",shape=box,color=blue];
		j3072632749 -> j1432878132;
	j3009590685 [label="Boolean RoatheMITW5Real is now true.",color=orange];
		j3009590685 -> j138478475;
	j3535956323 [label="Boolean RoatheMITW5Fake is now true.",color=orange];
		j3535956323 -> j2048110825;
	j3864067293 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j3864067293 -> j3983032530;
	j3834511663 [label="Ich weiß es nicht. Und ich glaube, du auch nicht.",shape=box,color=red];
		j3834511663 -> j76624767;
	j4154936658 [label="Ich glaube, es ist eine Entität, die bereits vor Entratis Interaktion existierte. Er gab ihr lediglich durch konzeptionelle Verkörperung Gestalt und Form.",shape=box,color=red];
		j4154936658 -> j1382633762;
	j227917826 [label="Ich weiß es ... wirklich nicht.",shape=box,color=red];
		j227917826 -> j1785191518;
	j1150216581 [label="Glaubst du wirklich, dass Entrati einen bösartigen Voidgott aus dem Nichts erschaffen hat?",shape=box,color=red];
		j1150216581 -> j472636999;
	j436506494 [label="Das Ding ist mächtiger als alles, womit ich je zu tun hatte.",shape=box,color=red];
		j436506494 -> j2364792595;
	j610917129 [label="Was glaubst du, was er dann ist?",shape=box,color=red];
		j610917129 -> j2450265427;
	j3969827930 [label="Konzeptionelle Verkörperung.",shape=box,color=blue];
		j3969827930 -> j3931888034;
		j3969827930 -> j4109059462;
		j3969827930 -> j459039614;
	j1432878132 [label="Im Void gibt es nichts. Deshalb heißt es ja auch Void!",shape=box,color=blue];
		j1432878132 -> j1806275392;
		j1432878132 -> j4042352004;
	j138478475 [label="+10 Chemistry",color=orange];
		j138478475 -> j3928200571;
	j2048110825 [label="+20 Chemistry",color=orange];
		j2048110825 -> j875398930;
	j3983032530 [label="Aber bevor wir fortfahren, möchte ich jedoch sichergehen, dass ich alles richtig verstanden habe. Du glaubst also, dass die Gleichgültigkeit eine schreckliche, unergründliche Entität aus dem Void ist, die aufgrund von Albrechts Fehlern in unsere Realität eindringt?",shape=box,color=blue];
		j3983032530 -> j1934501120;
	j76624767 [label="Doch! Ich weiß es! Es ist so schmerzlich offensichtlich, was hier passiert, und so absolut lächerlich, dass ihr euch alle einbildet, da würde irgendein riesiges Ungeheuer am Fenster kratzen, dabei ist es doch nur ein Ast im Wind.",shape=box,color=blue];
		j76624767 -> j1748489417;
	j1382633762 [label="Nicht du auch! Ich hatte so große Hoffnungen. Es ist so schmerzlich offensichtlich, was hier passiert, und so absolut lächerlich, dass ihr euch alle einbildet, da würde irgendein riesiges Ungeheuer am Fenster kratzen, dabei ist es doch nur ein Ast im Wind.",shape=box,color=blue];
		j1382633762 -> j1748489417;
	j1785191518 [label="Es ist so schmerzlich offensichtlich, was hier passiert, und so absolut lächerlich, dass ihr euch alle einbildet, da würde irgendein riesiges Ungeheuer am Fenster kratzen, dabei ist es doch nur ein Ast im Wind.",shape=box,color=blue];
		j1785191518 -> j1748489417;
	j472636999 [label="Ja! Glaube ich! Es ist so schmerzlich offensichtlich, was hier passiert, und so absolut lächerlich, dass ihr euch alle einbildet, da würde irgendein riesiges Ungeheuer am Fenster kratzen, dabei ist es doch nur ein Ast im Wind.",shape=box,color=blue];
		j472636999 -> j1748489417;
	j2364792595 [label="Und wann habe ich das jemals bestritten? Tatsächlich scheint es, als ob ihr euch alle in eine regelrechte hysterische und unnötig ungeheuerliche Bedrängnis hineingesteigert habt.",shape=box,color=blue];
		j2364792595 -> j3110277383;
		j2364792595 -> j2337064993;
	j3931888034 [label="Der Void und was wir daraus machen können, ist gefährlich und mächtig – glaub mir, ich weiß das. Aber er hat Grenzen. Glaubst du wirklich, es kann so etwas manifestieren? Ganze Sprachen erschaffen, Finger, die Schiffe antreiben, die durch den Void springen?",shape=box,color=red];
		j3931888034 -> j3347896720;
	j4109059462 [label="Es ist ... sehr verlockend zu glauben, dass es nur ein Monster unter dem Bett ist, Roathe. Aber ich habe dieses Ding gesehen, Angesicht zu \"Angesicht\", und ich glaube nicht, dass so etwas einfach aus unserem Kopf kommt.",shape=box,color=red];
		j4109059462 -> j785052457;
	j459039614 [label="Konzeptionelle Verkörperung kann nicht das leisten, wozu der Mann in der Wand fähig ist. Auch wenn Entrati dieses Wesen manifestiert haben mag – und dafür verantwortlich ist, es hierher gebracht zu haben – glaube ich nicht, dass er dessen Ursprung ist.",shape=box,color=red];
		j459039614 -> j3472353211;
	j1806275392 [label="Ich ...",shape=box,color=red];
		j1806275392 -> j2083996874;
	j4042352004 [label="Nein. Ich habe Dinge gesehen, die aus dem Void kommen. Engel. Gesang. Geister.",shape=box,color=red];
		j4042352004 -> j2083996874;
	j3928200571 [label="Ich bin zwar enttäuscht, dass du so stur bist, aber deine Ehrlichkeit finde ich äußerst erfrischend. Und ich bin froh, dass wir in Zukunft nicht mehr meine Zeit verschwenden. Ich bin sicher, wir werden andere Wege finden, uns zu amüsieren.",shape=box,color=blue];
		j3928200571 -> j554559907;
	j875398930 [label="Fantastisch. Ich bin froh, dass mein früheres Ich so überzeugend war. Und ich hoffe, du bist ehrlich und lügst mich nicht an, um mich zum \"Schweigen\" zu bringen. Aber ich habe keine Wahl und muss dir wohl glauben.",shape=box,color=blue];
		j875398930 -> j3361860744;
	j1748489417 [label="Erst jetzt, unter dem Einfluss des Voids, habt ihr sie alle mit so viel Angst und Macht gefüttert, dass sie sich, wie in einer Rückkopplungsschleife, zu diesem ... Ding zusammengeballt hat. Diesem Mann in der Wand.",shape=box,color=blue];
		j1748489417 -> j1653562929;
	j3110277383 [label="Was willst du damit sagen?",shape=box,color=red];
		j3110277383 -> j686200560;
	j2337064993 [label="Moment mal. Inwiefern sind wir dafür verantwortlich? Albrecht ist der Schuldige, er hat es losgelassen.",shape=box,color=red];
		j2337064993 -> j605265682;
	j3347896720 [label="Die Menschheit ist wahrlich erfinderisch, wenn es um die Vielfalt und das Ausmaß neuer Formen des Leidens geht, die sie sich selbst zusammenbraut, nicht wahr? Du selbst warst Zeuge vieler Grausamkeiten, die sich wohl niemand zu Zeiten unserer lieben Fanatiker hätte vorstellen können.",shape=box,color=blue];
		j3347896720 -> j2138978473;
	j785052457 [label="Ah, du bist der Wahrheit so nah und verwirfst sie doch so schnell. Glaubst du, es sei \"verlockend\", es für ein Produkt deines eigenen Geistes zu halten, weil es dann einfacher wäre, es zu verwerfen? Nein, ich denke, es ist viel gefährlicher, sich einer eigenen Schöpfung zu stellen als einem Gott.",shape=box,color=blue];
		j785052457 -> j895927443;
	j3472353211 [label="Ich schätze deine Bescheidenheit, doch ich stelle dein beschränktes Verständnis der menschlichen Kreativität infrage – insbesondere im Hinblick darauf, wie sie neue Formen des Leidens hervorbringen kann. Bist du nicht tatsächlich ganz allein dafür verantwortlich, dein eigenes Universum aus dem Void geschaffen zu haben?",shape=box,color=blue];
		j3472353211 -> j2945736137;
	j2083996874 [label="Aus dem Void kommt nur das, was wir hineinlegen – und was davon zurückkehrt. Es verändert Materie und Energie – aber es kann sie nicht erschaffen.",shape=box,color=blue];
		j2083996874 -> j2293016353;
	j554559907 [label="Ich für meinen Teil bin dankbar, dass mir eine zweite Runde zielloser und endloser Debatten über die Feinheiten der konzeptionellen Verkörperung erspart bleibt.",shape=box,color=blue];
		j554559907 -> j3702092281;
	j3361860744 [label="So oder so bin ich mir sicher, dass wir andere Wege finden werden, uns zu amüsieren, als uns in ziellosen und kreisenden Debatten über die Feinheiten der konzeptionellen Verkörperung zu verlieren.",shape=box,color=blue];
		j3361860744 -> j1430028804;
	j1653562929 [label="Albrecht mag diesen Unsinn angezettelt haben, aber ihr alle habt das Feuer weiter angefacht, bis es zum Inferno wurde. Die Gleichgültigkeit existierte nie. Bis plötzlich doch.",shape=box,color=blue];
		j1653562929 -> j18813831;
	j686200560 [label="Was ich sagen will, ist: Albrecht war vielleicht derjenige, der als Erster seine eigene Anmaßung als das Antlitz eines grinsenden Zerstörungsgottes vor sich sah, ja.",shape=box,color=blue];
		j686200560 -> j4070060590;
	j605265682 [label="Albrecht war vielleicht derjenige, der als Erster seine eigene Anmaßung als das Antlitz eines grinsenden Zerstörungsgottes vor sich sah, ja.",shape=box,color=blue];
		j605265682 -> j4070060590;
	j2138978473 [label="+5 Chemistry",color=orange];
		j2138978473 -> j1474856311;
	j895927443 [label="Einen äußeren Feind kann man verstehen, manipulieren, besiegen oder notfalls sogar mit ihm verhandeln. Er hat Schwächen, die man ausnutzen kann. Aber ein innerer Feind? Einer, den wir selbst geschaffen haben? Der ist weitaus heimtückischer.",shape=box,color=blue];
		j895927443 -> j2884491939;
	j2945736137 [label="Du selbst warst Zeuge vieler Formen von Grausamkeiten geworden, von denen ich sicher bin, dass sich niemand vorstellen konnte, dass sie zur Zeit unserer lieben Eiferer möglich waren.",shape=box,color=blue];
		j2945736137 -> j2138978473;
	j2293016353 [label="Denk nach, Drifter. Diese \"Void-Engel\", von denen du sprichst. Diese Geister. Wurden sie aus denen gemacht, die bereits im Void verloren waren?",shape=box,color=blue];
		j2293016353 -> j2317093377;
	j3702092281 [label="Das bedeutet allerdings mehr Zeit, sich von den Eiferern belehren zu lassen ... na ja. Entscheidungen, Entscheidungen, Entscheidungen ...",shape=box,color=blue];
		j3702092281 -> "Chat ends.";
	j1430028804 [label="Ich für meinen Teil bin dankbar, dass mir eine zweite Runde erspart bleibt.",shape=box,color=blue];
		j1430028804 -> j3702092281;
	j18813831 [label="Und ihr alle seid schuld daran.",shape=box,color=blue];
		j18813831 -> j1990866657;
		j18813831 -> j4060779543;
		j18813831 -> j628014829;
	j4070060590 [label="Aber ihr seid alle gleichermaßen schuldig, dass ihr diesen riesigen Insektenhaufen so lange den Hügel hinuntergerollt habt, und er ist mit jedem Kotkrümel, den er unterwegs aufsammelt, immer größer geworden!",shape=box,color=blue];
		j4070060590 -> j1646011543;
	j1474856311 [label="Als Spezies sind wir geradezu erstaunlich in unserer Fähigkeit, unsere Ängste zu nähren, um neue Wege zur Selbstzerstörung zu schaffen.",shape=box,color=blue];
		j1474856311 -> j3260942256;
	j2884491939 [label="+5 Chemistry",color=orange];
		j2884491939 -> j2156381020;
	j2317093377 [label="Sie waren lediglich Echos von Energie, die wie ein bunter Kutak wiedergekäut wurde, um seine Kinder zu nähren.",shape=box,color=blue];
		j2317093377 -> j1646011543;
	j1990866657 [label="Wir können so etwas nicht erschaffen, Roathe – das hab ich dir doch gesagt. Konzeptionelle Verkörperung hat ihre Grenzen.",shape=box,color=red];
		j1990866657 -> j2710748806;
	j4060779543 [label="Gib uns dafür nicht die Schuld. Wir sind nicht verantwortlich für den Schaden, den dieses Ding verursacht hat.",shape=box,color=red];
		j4060779543 -> j297142718;
	j628014829 [label="Erkläre mir bitte deine Argumentation, wie das funktionieren soll. Die meisten Dinge, die durch konzeptionelle Verkörperung aus dem Void entstehen, können diesen nicht verlassen – zumindest nicht für lange.",shape=box,color=red];
		j628014829 -> j1470612459;
	j1646011543 [label="Erlaube mir, diese Diskussion für dich zu vereifachen. Ich kann dir diese falsche Gottheit in zwei einfachen Worten entlarven, die du kennst und gut verstehst:",shape=box,color=blue];
		j1646011543 -> j3969827930;
	j3260942256 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j3260942256 -> j1934501120;
	j2156381020 [label="Denn dann müssen wir unsere eigenen Dämonen bekämpfen. Und die Menschheit ... gewinnt solche Kriege nie, nicht wahr?",shape=box,color=blue];
		j2156381020 -> j3260942256;
	j2710748806 [label="Sagt jemand, der im Alleingang eine ganze alternative Dimension erschaffen hat? Bitte, Drifter ... benutze deine Fantasie, wie du es einst vor so langer Zeit getan hast.",shape=box,color=blue];
		j2710748806 -> j1470612459;
	j297142718 [label="Ich rüge dich nicht! Die Sache war schon lange in Planung, bevor du überhaupt ins Spiel kamst. Albrecht hat dafür gesorgt.",shape=box,color=blue];
		j297142718 -> j2437154522;
	j1470612459 [label="Konzeptuelle Verkörperung funktioniert folgendermaßen: Bei Interaktion mit dem Void oder in dessen Nähe können sich starke Emotionen und Gedanken physisch manifestieren. Das wissen wir beide.",shape=box,color=blue];
		j1470612459 -> j2793314534;
		j1470612459 -> j4102291886;
		j1470612459 -> j179684406;
	j2437154522 [label="Er sah sein Spiegelbild und erkannte wahre Angst. Und so entzündete sich der erste Funke, der das Feuer entfachte, das alles zu zerstören droht. Ihr gießt einfach immer mehr Öl ins Feuer.",shape=box,color=blue];
		j2437154522 -> j1470612459;
	j2793314534 [label="Richtig. Wie Duviri, es hat über die Zariman eine Verbindung zu dieser Welt.",shape=box,color=red];
		j2793314534 -> j235712767;
	j4102291886 [label="Wie die Zariman, die Standhaften und die Void-Engel. Der Void ist überall auf diesem Schiff.",shape=box,color=red];
		j4102291886 -> j235712767;
	j179684406 [label="Ja. Und?",shape=box,color=red];
		j179684406 -> j2142626916;
	j235712767 [label="Genau. Wohin der Void geht, kann die konzeptionelle Verkörperung folgen. Und nur dorthin.",shape=box,color=blue];
		j235712767 -> j22822814;
		j235712767 -> j2185933570;
	j2142626916 [label="Wohin der Void geht, kann die konzeptionelle Verkörperung folgen. Und nur dorthin.",shape=box,color=blue];
		j2142626916 -> j22822814;
		j2142626916 -> j2185933570;
	j22822814 [label="Aber er ist bis 1999 gekommen. Er hat Albrecht überallhin verfolgt. Und mich auch.",shape=box,color=red];
		j22822814 -> j4141404331;
	j2185933570 [label="Moment ...",shape=box,color=red];
		j2185933570 -> j2636952620;
	j4141404331 [label="Die verfluchten Finger. Wir nahmen diese verfluchten Finger in einem verzweifelten und wahnwitzigen Versuch, Tau zu erreichen, und wir Orokin fanden einen Weg, sie zu replizieren, nicht wahr?",shape=box,color=blue];
		j4141404331 -> j3926682142;
	j2636952620 [label="Ja. Jetzt verstehst du es. Die verfluchten Finger. Wir nahmen diese verfluchten Finger in einem verzweifelten und wahnwitzigen Versuch, Tau zu erreichen, und wir Orokin fanden einen Weg, sie zu replizieren, nicht wahr?",shape=box,color=blue];
		j2636952620 -> j3926682142;
	j3926682142 [label="Kleine Fragmente des Voids, überall, wo man hingeht ... Ein Netz aus Gräben und Tunneln, in dem dieses Ding auftauchen kann, wo immer es will. Und noch schlimmer?",shape=box,color=blue];
		j3926682142 -> j1466691820;
	j1466691820 [label="Die Tenno. Und ihr. Ihr alle, vom Void berührt. Und ihr alle, verfolgt von diesem Ding, denn wohin ihr auch geht, es kann euch folgen.",shape=box,color=blue];
		j1466691820 -> j1431318780;
	j1431318780 [label="Und vermutlich jedem, der sich länger damit befasst hat. Entrati selbst. Sein Butler. Die Cavia. Ich selbst, die Eiferer, aufgrund unserer Nähe zu diesem Sanctum. Die Liste lässt sich fortsetzen.",shape=box,color=blue];
		j1431318780 -> j4051727414;
		j1431318780 -> j892382040;
	j4051727414 [label="Du behauptest also, dass jeder, der genügend Kontakt mit dem Void hat – oder jeder, der eine Art \"Batterie\" ist – zu einem weiteren Fenster wird, durch das der Mann in der Wand spähen kann?",shape=box,color=red];
		j4051727414 -> j3823786294;
	j892382040 [label="Aber wie ist es in Rusalka hineingelangt, frage ich mich?",shape=box,color=red];
		j892382040 -> j3459947794;
	j3823786294 [label="So ist es.",shape=box,color=blue];
		j3823786294 -> j2064378721;
	j3459947794 [label="In wen?",shape=box,color=blue];
		j3459947794 -> j1086435843;
		j3459947794 -> j1932709750;
	j2064378721 [label="Das würde erklären, warum es nicht sein eigenes Gesicht tragen kann, nicht wahr? Es kann nur als diejenigen erscheinen, die es quält, und denen, die es zu quälen versucht.",shape=box,color=blue];
		j2064378721 -> j2664987765;
	j1086435843 [label="Major Neci Rusalka. Sie war 1999 in Höllvania für die Scaldra, eine Militäreinheit, verantwortlich.",shape=box,color=red];
		j1086435843 -> j1829384573;
	j1932709750 [label="Kurz gesagt, ich sollte euch beiden niemals erlauben, euch zu treffen.",shape=box,color=red];
		j1932709750 -> j1677301152;
	j2664987765 [label="Tatsächlich scheint es nur dann das Antlitz der Architektur anzunehmen, wenn es sich nicht als etwas Größeres und Anderes darzustellen vermag. Wenn es verzweifelt versucht, ein Gefühl von Erhabenheit und Göttlichkeit zu vermitteln.",shape=box,color=blue];
		j2664987765 -> j333115899;
		j2664987765 -> j1794104366;
	j1829384573 [label="Sie war – oder ist – von der Gleichgültigkeit besessen. Sie teilt ihren Geist, benutzt sie wie eine Marionette. Oder sie hat es zugelassen. Wir wissen es nicht. Wir wissen auch nicht, ob sie die Kontrolle wiedererlangt hat.",shape=box,color=red];
		j1829384573 -> j1143520846;
	j1677301152 [label="Du bist wirklich ein Spielverderber, Usurpator. Aber was genau hat sie mit unserer ... Gleichgültigkeit zu tun?",shape=box,color=blue];
		j1677301152 -> j1829384573;
	j333115899 [label="Du denkst also, es trägt alle Gesichter der Menschen, mit denen es in Kontakt kommt ... weil es selbst keins hat?",shape=box,color=red];
		j333115899 -> j3287934076;
	j1794104366 [label="Ich glaube, der Mann in der Wand trägt unsere Gesichter, weil er nicht begreifen kann, was es heißt, ein Mensch zu sein. Andernfalls ist er zu \"groß\".",shape=box,color=red];
		j1794104366 -> j3287934076;
	j1143520846 [label="Sie klingt nach einer ungemein beeindruckenden Persönlichkeit. Und nach einem wahren Schatz. Aber das ist im Moment unerheblich. Du sagst, die Gleichgültigkeit hat Besitz von ihrem Verstand ergriffen? Und das begann während deines kurzen Ausflugs in die Vergangenheit?",shape=box,color=blue];
		j1143520846 -> j3121066950;
	j3287934076 [label="Nein, du Dummkopf. Es ahmt nur das nach, was es erschaffen hat. Es ist kein vollständiges Wesen – es ist nur ein Spielzeug, zusammengesetzt aus unpassenden Teilen all der Ängste, Schrecken und Leiden, mit denen es gefüttert wurde.",shape=box,color=blue];
		j3287934076 -> j1957362592;
	j3121066950 [label="Nun, wenn unsere Kenntnisse über den Void zutreffen, dann ist eines von zwei Dingen passiert: Entweder ist sie 1999 aus eigenem Antrieb in eine Instanz des Voids geraten (was ich für äußerst unwahrscheinlich, aber nicht unmöglich halte), oder ...",shape=box,color=blue];
		j3121066950 -> j2480640595;
	j1957362592 [label="Na ja. Ich sehe schon, ich werde heute nicht weiterkommen. Macht nichts, du bist ja tief in dieser Propaganda verstrickt, mit der man dich gefüttert hat. Albrecht ist ein unglaublich überzeugender Sektenführer, fürchte ich.",shape=box,color=blue];
		j1957362592 -> j2082126455;
	j2480640595 [label="Unser lieber Albrecht hat sich mal wieder eingemischt.",shape=box,color=blue];
		j2480640595 -> j3678287098;
		j2480640595 -> j1142911272;
		j2480640595 -> j2551785960;
	j2082126455 [label="+10 Chemistry",color=orange];
		j2082126455 -> j2122266455;
	j3678287098 [label="Willst du damit andeuten, dass Albrecht Neci absichtlich zur Marionette der Gleichgültigkeit gemacht hat?",shape=box,color=red];
		j3678287098 -> j803471615;
	j1142911272 [label="Wir wissen nicht, ob irgendetwas davon stimmt. Gar nichts. Das ist alles reine Spekulation. Es könnten auch alles Lügen sein.",shape=box,color=red];
		j1142911272 -> j1233605975;
	j2551785960 [label="Wenn er 1999 ein Loch in den Void gerissen und diesen absichtlich hereingelassen hat ... würde das erklären, warum Warframes dort überhaupt funktionierten ... das Gleiche gilt für deine Zeit - allerdings ohne das Herz von Deimos.",shape=box,color=red];
		j2551785960 -> j3183247435;
	j2122266455 [label="Boolean RoatheMITW2 is now true.",color=orange];
		j2122266455 -> j3747620709;
	j803471615 [label="Ich sitze hier lediglich und lese Kaffeesatz, Usurpator. Es läge mir fern, zu unterstellen, Albrecht hätte absichtlich ein Loch in den Void in Höllvania gerissen und die Gleichgültigkeit hereingelassen, um ihr einen eigenen Avatar zu geben ...",shape=box,color=blue];
		j803471615 -> j1797436369;
	j1233605975 [label="Natürlich! Ich sitze hier lediglich und lese Kaffeesatz, Usurpator. Es läge mir fern, zu unterstellen, Albrecht hätte absichtlich ein Loch in den Void in Höllvania gerissen und die Gleichgültigkeit hereingelassen, um ihr einen eigenen Avatar zu geben ...",shape=box,color=blue];
		j1233605975 -> j1797436369;
	j3183247435 [label="Siehst du? Trau niemals einem Wissenschaftler. Die sind zu allem bereit, um irgendwas zu erfinden. Aber gut, ich sitze hier ja auch nur und lese Kaffeesatz, Usurpator. Das alles sind nur Vermutungen.",shape=box,color=blue];
		j3183247435 -> j3276152825;
	j3747620709 [label="Ich hoffe, ich konnte dir zumindest etwas zum Nachdenken geben. Jetzt, muss ich aber gehen.",shape=box,color=blue];
		j3747620709 -> "Chat ends.";
	j1797436369 [label="Mir als Taktiker und jemandem, der mit Kriegsstrategien bestens vertraut ist, erscheint es jedoch ...",shape=box,color=blue];
		j1797436369 -> j2603485489;
	j3276152825 [label="Es liegt mir fern, zu unterstellen, Albrecht hätte absichtlich ein Loch in den Void in Höllvania gerissen und die Gleichgültigkeit hereingelassen, um ihr einen eigenen Avatar zu geben! Mir als Taktiker und jemandem, der mit Kriegsstrategien bestens vertraut ist, erscheint es jedoch ...",shape=box,color=blue];
		j3276152825 -> j2603485489;
	j2603485489 [label="Dass es der erste Schritt sein sollte, die Auswahlmöglichkeiten auf so wenige wie möglich zu begrenzen, wenn es darum geht, einen gesichtslosen Gegner zu besiegen, der überall, als jeder und jederzeit auftauchen kann.",shape=box,color=blue];
		j2603485489 -> j3768803851;
	j3768803851 [label="+20 Chemistry",color=orange];
		j3768803851 -> j2703173168;
	j2703173168 [label="Und sicherzustellen, dass diese Optionen ausgeblutet werden können.",shape=box,color=blue];
