	j1151246033 [label="Wie komme ich da wieder raus?",shape=box,color=red];
		j1151246033 -> j3527458539;
	j3705280296 [label="Du hast deinen Teil der Abmachung nicht erfüllt, also werde ich meinen auch nicht erfüllen.",shape=box,color=blue];
