		j3705280296 -> j3496837629;
	j3261363075 [label="Das, und natürlich unsere persönliche Freundschaft, ist mein einziges Druckmittel in dieser Situation. So einfach ist das.",shape=box,color=blue];
		j3261363075 -> j1892771708;
	j3398975195 [label="Im Gegenzug werde ich dir jetzt helfen. Der Butler. Willst du ihn immer noch mit Albrechts Familie über uns wiedervereinen?",shape=box,color=blue];
