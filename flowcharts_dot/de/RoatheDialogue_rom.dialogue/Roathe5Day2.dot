		j2304643196 -> j2260349792 [label="RoatheFailStall",color=purple];
		j2304643196 -> j231620123 [label="false",color=purple];
	j53895608 [label="Und hier sitzen wir nun und drehen Däumchen. Entweder hast du wirklich nichts Besseres zu tun, Usurpator, oder du hast alles von mir bekommen, was du willst. Was trifft zu?",shape=box,color=blue];
		j53895608 -> j1579043781;
		j53895608 -> j2409463315;
		j53895608 -> j3156208498;
	j617454213 [label="Evaluate expressions on HellStory counter",color=orange];
		j617454213 -> j1680390219 [label="x >= 21",color=purple];
		j617454213 -> "Chat ends." [label="x <= 21",color=purple];
		j617454213 -> "Chat ends." [label="false",color=purple];
	j1743998674 [label="Ein neuer Tag bricht an, und zum ersten Mal seit Langem ... plane ich meine Zukunft. Ich denke darüber nach, wie ich die Welt um mich herum verändern könnte. Wie ich mein Wissen, mein Wesen, besser einsetzen könnte.",shape=box,color=blue];
		j1743998674 -> j3984658869;
	j3134829238 [label="Ein neuer Tag bricht an, und zum ersten Mal seit Langem plane ich meine Zukunft. Ich denke darüber nach, was das für mich bedeutet, was ich will und wie ich mein Umfeld nach meinen Vorstellungen gestalten möchte.",shape=box,color=blue];
		j3134829238 -> j2558396776;
	j3132707352 [label="Darf ich fragen, worauf du eigentlich wartest? Ich sitze hier und erinnere mich sehr genau an die Ereignisse. Du hast mir versprochen, diese aus meinem Gedächtnis zu löschen.",shape=box,color=blue];
		j3132707352 -> j4223759902;
		j3132707352 -> j2722654657;
		j3132707352 -> j2661474368;
	j2260349792 [label="Hast du dich entschieden? Ich bin zwar ein geduldiger Teufel, aber auch ich habe meine Grenzen. Wirst du meine Erinnerungen auslöschen oder willst du mich weiterhin verweilen lassen?",shape=box,color=blue];
		j2260349792 -> j815421090;
		j2260349792 -> j2916578509;
	j231620123 [label="Hier sind wir nun, und hier werden wir verweilen. In diesem Fegefeuer. Ich hoffe, es gefällt dir hier, denn ich glaube nicht, wir kommen je einen Schritt weiter.",shape=box,color=blue];
		j231620123 -> j2171950327;
	j1579043781 [label="Was meinst du damit?",shape=box,color=red];
		j1579043781 -> j3830763878;
	j2409463315 [label="Ein bisschen aus Spalte A, ein bisschen aus Spalte B?",shape=box,color=red];
		j2409463315 -> j2033202239;
	j3156208498 [label="Das alles hat nichts mit dir zu tun, Roathe. Das hat es nie.",shape=box,color=red];
		j3156208498 -> j4099213079;
	j1680390219 [label="Du Narr! Was hast du getan?! Warum, warum bist du in Höhlen vorgedrungen, in denen du nicht willkommen bist?!",shape=box,color=blue];
		j1680390219 -> j317716044;
	"Chat ends." [color=orange];
	j3984658869 [label="Check boolean RoatheDating",color=orange];
		j3984658869 -> j419306600 [label=true,color=green];
		j3984658869 -> j3693512906 [label=false,color=brown];
	j2558396776 [label="Check boolean RoatheDating",color=orange];
		j2558396776 -> j1104310283 [label=true,color=green];
		j2558396776 -> j2268776866 [label=false,color=brown];
	j4223759902 [label="Ich weiß. Aber sowas braucht Zeit, und wir müssen warten.",shape=box,color=red];
		j4223759902 -> j2695252947;
	j2722654657 [label="Ich habe es mir anders überlegt. Tut mir leid.",shape=box,color=red];
		j2722654657 -> j1639201242;
	j2661474368 [label="Das werde ich. Ich bin dabei. Versprochen.",shape=box,color=red];
		j2661474368 -> j447776955;
	j815421090 [label="Nein. Ich mache es nicht. Es tut mir leid. Ich kann dir das nicht antun.",shape=box,color=red];
		j815421090 -> j470554625;
	j2916578509 [label="Na gut. Ich gebe nach. Ich werde tun, was du willst.",shape=box,color=red];
		j2916578509 -> j1052024788;
	j2171950327 [label="Check boolean LoidFamilyComplete",color=orange];
		j2171950327 -> j176437276 [label=true,color=green];
		j2171950327 -> j814464100 [label=false,color=brown];
	j3830763878 [label="Was immer du von mir willst, du wirst es jetzt nicht bekommen. Du kannst es genauso gut beenden und meine Erinnerung an diese Farce von uns auslöschen.",shape=box,color=blue];
		j3830763878 -> j3619809620;
	j2033202239 [label="Nun, was immer du von mir willst, du wirst es jetzt nicht bekommen. Du kannst es genauso gut beenden und meine Erinnerung an diese Farce von uns auslöschen.",shape=box,color=blue];
		j2033202239 -> j3619809620;
	j4099213079 [label="Das ist eindeutig, du brauchst dir keine Sorgen zu machen.",shape=box,color=blue];
		j4099213079 -> "Chat ends.";
	j317716044 [label="Ich verlange, dass du das in Ordnung bringst. Das ist deine Schuld. Ich spüre es, wie es an mir zerrt, mich zerreißt. Wie ein riesiges Ungeheuer.",shape=box,color=blue];
		j317716044 -> j2572679843;
	j419306600 [label="Es wäre unangebracht, nicht anzuerkennen, dass dies deiner Hilfe zu verdanken ist, Schatz. Danke.",shape=box,color=blue];
		j419306600 -> j3362626765;
		j419306600 -> j1716027396;
	j3693512906 [label="Es wäre unangebracht, nicht anzuerkennen, dass dies deiner Hilfe zu verdanken ist. Danke.",shape=box,color=blue];
		j3693512906 -> j35654274;
		j3693512906 -> j3930417988;
	j1104310283 [label="Es wäre unangebracht, nicht anzuerkennen, dass dies größtenteils deiner Hilfe zu verdanken ist, Schatz.",shape=box,color=blue];
		j1104310283 -> j2115671314;
		j1104310283 -> j1542838463;
	j2268776866 [label="Es wäre unangebracht, nicht anzuerkennen, dass dies größtenteils deiner Hilfe zu verdanken ist, Usurpator.",shape=box,color=blue];
		j2268776866 -> j3761365704;
		j2268776866 -> j3327959923;
	j2695252947 [label="Hm. Nun gut. Ich bin zwar ein geduldiger Teufel, aber auch dieser Brunnen kann mit der Zeit versiegen, glaub mir.",shape=box,color=blue];
		j2695252947 -> "Chat ends.";
	j1639201242 [label="Ich verstehe. So einfach ist das also?",shape=box,color=blue];
		j1639201242 -> j431793363;
	j447776955 [label="Hm. Das solltest du schleunigst. Ich bin zwar ein geduldiger Teufel, aber auch dieser Brunnen kann mit der Zeit versiegen, glaub mir.",shape=box,color=blue];
		j447776955 -> "Chat ends.";
	j470554625 [label="Selbst wenn es bedeutet, dass wir für immer in dieser Sackgasse gefangen sind? Du armer, trauriger Usurpator ... nun gut. Das Fegefeuer ist für einen Teufel eine Verbesserung gegenüber der Hölle, nicht wahr?",shape=box,color=blue];
		j470554625 -> j3275996368;
	j1052024788 [label="Gut. Leg los. Ich habe es satt, mit diesem Wissen im Kopf leben zu müssen.",shape=box,color=blue];
		j1052024788 -> j378811769;
	j176437276 [label="Aber was kümmert es dich? Du hast alles, was du von meinem leeren Körper schneiden willst. Meine Rippen sind nackt und gebleicht.",shape=box,color=blue];
		j176437276 -> j1776100240;
	j814464100 [label="Tragisch, nicht wahr? Zu wissen, dass die letzten Überreste von Entratis Familie niemals erfahren werden, dass der Butler hier unten vor sich hinvegetiert und in Trauer die Hände ringt? Ganz allein?",shape=box,color=blue];
		j814464100 -> j1776100240;
	j3619809620 [label="Wenn es das ist, was du willst, ist das der einzige Weg für dich. Wenn es dir egal ist, ist es mir auch egal. Mach, was du willst.",shape=box,color=blue];
		j3619809620 -> j2045617664;
	j2572679843 [label="Befreie mich davon. Befreie mich von dieser Plage. Lösche meine Erinnerungen. Ich weiß, du kannst es. Nutze deine Gabe und beende alles. Sofort.",shape=box,color=blue];
		j2572679843 -> j2208792608;
		j2572679843 -> j4170329653;
		j2572679843 -> j2010872779;
	j3362626765 [label="Ich konnte dich nicht ewig deinem spitzen Schwanz hinterherjagen lassen.",shape=box,color=red];
		j3362626765 -> j1137970808;
	j1716027396 [label="Gern geschehen.",shape=box,color=red];
		j1716027396 -> j2665556245;
	j35654274 [label="Ich konnte dich nicht ewig deinem spitzen Schwanz hinterherjagen lassen. Er wäre traurig geworden.",shape=box,color=red];
		j35654274 -> j1905149336;
	j3930417988 [label="Gern geschehen.",shape=box,color=red];
		j3930417988 -> j578416406;
	j2115671314 [label="Größtenteils? Wenn ich nicht wäre, würdest du immer noch deinem spitzen Schwanz hinterherjagen, Roathe.",shape=box,color=red];
		j2115671314 -> j2988469007;
	j1542838463 [label="Gern geschehen.",shape=box,color=red];
		j1542838463 -> j2536340549;
	j3761365704 [label="Größtenteils? Wenn ich nicht wäre, würdest du immer noch deinem spitzen Schwanz hinterherjagen, Roathe.",shape=box,color=red];
		j3761365704 -> j2770920860;
	j3327959923 [label="Gern geschehen.",shape=box,color=red];
		j3327959923 -> j578416406;
	j431793363 [label="Boolean RoatheFailUltimate is now true.",color=orange];
		j431793363 -> j3126144633;
	j3275996368 [label="Ich weiß nicht, von wem die Eiferer mehr enttäuscht sein werden: von dir oder von mir.",shape=box,color=blue];
		j3275996368 -> j620297114;
	j378811769 [label="Add 1 to Promise counter",color=orange];
		j378811769 -> j567952179;
	j1776100240 [label="Evaluate expressions",color=orange];
		j1776100240 -> j2279345898 [label="RoatheDatingDeal",color=purple];
		j1776100240 -> j2279345898 [label="RoatheMarieDatingDeal",color=purple];
		j1776100240 -> j2279345898 [label="RoatheLyonDatingDeal",color=purple];
		j1776100240 -> j2279345898 [label="RoatheFamilyDeal",color=purple];
