	j1990550316 [label="Ja. Versuch bitte mitzuhalten. Ich nehme an, du möchtest ihn immer noch mit Albrechts Familie über uns wiedervereinen, richtig?",shape=box,color=blue];
		j1990550316 -> j1949841813;
	j2278729002 [label="Nein. Und ich habe auch keine Lust mehr, dir in solchen Belangen behilflich zu sein.",shape=box,color=blue];
