		j2665556245 -> j2432502256 [label="false",color=purple];
	j1905149336 [label="Wie ... reizend.",shape=box,color=blue];
		j1905149336 -> j2665556245;
	j578416406 [label="+5 Chemistry",color=orange];
		j578416406 -> j2665556245;
	j2988469007 [label="+5 Chemistry",color=orange];
		j2988469007 -> j1034664389;
	j2536340549 [label="Mm. Ja. Nun.",shape=box,color=blue];
		j2536340549 -> j2665556245;
	j2770920860 [label="Reize dein Glück nicht aus, Usurpator.",shape=box,color=blue];
		j2770920860 -> j2665556245;
	j3126144633 [label="Boolean RoatheNoDate is now true.",color=orange];
		j3126144633 -> j1311246052;
	j620297114 [label="Boolean RoatheRepair1 is now true.",color=orange];
		j620297114 -> "Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j567952179 [label="Boolean RoatheWillReset is now true.",color=orange];
		j567952179 -> j2989953447;
	j2279345898 [label="Du kannst dich auch von unserer anderen Vereinbarung verabschieden.",shape=box,color=blue];
		j2279345898 -> j4191386833;
		j2279345898 -> j816468147;
	j1989340780 [label="Ich freute mich schon darauf, zuzusehen, wie er vor Angst zitternd, beschämt die Treppe hinaufkriecht.",shape=box,color=blue];
		j1989340780 -> j3204234293;
		j1989340780 -> j3750574492;
	j1968885904 [label="Aber was kümmert es dich?",shape=box,color=blue];
		j1968885904 -> j343201631;
	j444371281 [label="Das mag sein. Du hast wahrscheinlich recht. Aber ich habe im Moment keine anderen Möglichkeiten, oder? Es ist einen Versuch wert.",shape=box,color=blue];
		j444371281 -> j1353657132;
	j2510567497 [label="Und wenn das der Fall ist, dann kannst du es einfach wiederholen. Es ist, als hättest du eine unerschöpfliche Gabe, nicht wahr?",shape=box,color=blue];
		j2510567497 -> j1353657132;
	j2413846838 [label="Sehr wahrscheinlich. Ich werde Zwei und Zwei zusammenzählen und dich dafür verantwortlich machen, etwas getan zu haben, worum ich dich nicht gebeten habe. Ich bin sicher, du wirst das überleben.",shape=box,color=blue];
		j2413846838 -> j1353657132;
	j1034664389 [label="Mm, ja, nun ja. Ich weiß, wie sehr du meinen \"spitzen Schwanz\" magst.",shape=box,color=blue];
		j1034664389 -> j2665556245;
	j3709593369 [label="Ich wollte einfach nur meine Dankbarkeit ausdrücken. Nicht weiter darauf eingehen.",shape=box,color=blue];
		j3709593369 -> j4081414586;
	j2432502256 [label="Nachdem wir das nun erledigt haben, glaube ich, dass wir noch etwas anderes zu besprechen haben, nicht wahr?",shape=box,color=blue];
		j2432502256 -> j1466456391;
	j1311246052 [label="Check boolean RoatheDating",color=orange];
		j1311246052 -> j3194320576 [label=true,color=green];
		j1311246052 -> j2033202239 [label=false,color=brown];
	"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j2989953447 [label="Boolean RoatheFailStall is now false.",color=orange];
		j2989953447 -> "Chat ends.";
	j4191386833 [label="Typisch.",shape=box,color=red];
		j4191386833 -> j833429570;
	j816468147 [label="Warte. Warum?!",shape=box,color=red];
		j816468147 -> j3302688112;
	j3204234293 [label="Du hast gesagt, du würdest helfen, wenn ich dir helfe, deine Erinnerungen wiederzuerlangen. Und das habe ich getan. Das war unsere Abmachung!",shape=box,color=red];
		j3204234293 -> j3136019979;
	j3750574492 [label="Moment mal. Warum willst du mir nicht mehr helfen?",shape=box,color=red];
		j3750574492 -> j3136019979;
	j343201631 [label="Gar nichts.",shape=box,color=blue];
		j343201631 -> "Chat ends.";
	j1353657132 [label="Ich bin mir sicher, ich werde furchtbar wütend auf dich sein, sobald ich merke, dass du meine Erinnerungen verändert hast. Und ich rate dir, mir nicht zu sagen, dass es auf meinen Wunsch geschah, Schatz.",shape=box,color=blue];
		j1353657132 -> j3387572175;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j1466456391 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1466456391 -> j2024141513 [label=true,color=green];
		j1466456391 -> j3818812735 [label=false,color=brown];
	j3194320576 [label="Boolean IsDating is now false.",color=orange];
		j3194320576 -> j2925451056;
	j833429570 [label="Sei nicht so verbittert, nur weil du jetzt merkst, dass du überlistet wurdest. Ich habe dir die Vertragsbedingungen dargelegt, ohne jemals meinen Teil zu erwähnen. Oder hast du das etwa übersehen?",shape=box,color=blue];
		j833429570 -> j563323949;
	j3302688112 [label="Ich habe dir die Vertragsbedingungen dargelegt, ohne jemals meinen Teil der Sache darzulegen. Oder hast du das etwa übersehen?",shape=box,color=blue];
		j3302688112 -> j563323949;
	j3136019979 [label="\"Ich benötige jemanden, der mir hilft, meine Erinnerungen aufzuzeichnen und zu sortieren. Eine Art vorübergehende Assistenz.\"",shape=box,color=blue];
		j3136019979 -> j933380178;
	j3387572175 [label="Ich werde einfach behaupten, dass du lügst, und das wird meine Meinung über dich wahrscheinlich irreparabel schädigen.",shape=box,color=blue];
		j3387572175 -> j454478784;
		j3387572175 -> j1097695887;
	j2024141513 [label="Jedes Mal, wenn wir miteinander reden, frage ich mich, ob dir die Themen, die wir ansprechen, vertraut oder fremd sind. Ob ich mich nur wiederhole oder ob ich eine neue Überraschung parat habe.",shape=box,color=blue];
		j2024141513 -> j3158370531;
	j3818812735 [label="Du hast deinen Teil der Abmachung erfüllt. Wir sind nun am vorletzten Punkt angelangt, an dem wir die Einzelheiten unserer Angriffsstrategie festlegen müssen.",shape=box,color=blue];
		j3818812735 -> j535240707;
	j2925451056 [label="Boolean RoatheDating is now false.",color=orange];
		j2925451056 -> j2821307763;
	j563323949 [label="Ich habe lediglich gesagt, was du aus der Vereinbarung bekommst. Ich habe nie gesagt, was du dafür tun musst oder warum. Und du hast blindlings zugestimmt.",shape=box,color=blue];
		j563323949 -> j4109718977;
	j933380178 [label="Du hast zwar das erste Kriterium erfüllt \"meine Erinnerungen aufzuzeichnen\", bist aber beim zweiten Kriterium, \"mir beim Sortieren dieser Erinnerungen zu helfen\", kläglich gescheitert.",shape=box,color=blue];
		j933380178 -> j2201419909;
	j454478784 [label="Nein. Ich mache das nicht. Ich werde das nicht tun. Wir müssen diese Situation gemeinsam bewältigen. Können wir nicht einfach darüber reden?",shape=box,color=red];
		j454478784 -> j1198488166;
	j1097695887 [label="Ich ... gibt es wirklich keinen anderen Weg?",shape=box,color=red];
		j1097695887 -> j1198488166;
	j3158370531 [label="So oder so, ich ziehe es vor, du sagst es mir nicht. Ich hasse es, wenn ich zu vorhersehbar bin. Ungeachtet dessen hast du mir geholfen, etwas sehr Wichtiges für mich zu klären.",shape=box,color=blue];
		j3158370531 -> j3861610262;
	j535240707 [label="Dieser Kampf muss an drei Fronten geführt werden. Alle müssen zusammenarbeiten, damit dieser Krieg gewonnen werden kann.",shape=box,color=blue];
		j535240707 -> j4032536395;
		j535240707 -> j659686754;
	j2821307763 [label="Nun, was immer du von mir willst, du wirst es jetzt nicht bekommen. Du kannst es genauso gut beenden und meine Erinnerung an diese Farce von uns auslöschen, \"Drifter Lieber\".",shape=box,color=blue];
		j2821307763 -> j3619809620;
	j4109718977 [label="Das nennt man, glaube ich, im alten Sprachgebrauch einen \"Blankoscheck\"? Und du hast ihn bereitwillig unterschrieben.",shape=box,color=blue];
		j4109718977 -> j3106030335;
		j4109718977 -> j1151246033;
	j2201419909 [label="Ich würde kaum sagen, dass sie in Einklang sind, oder?",shape=box,color=blue];
		j2201419909 -> j3705280296;
	j1198488166 [label="Nein. Soll der Butler nach oben gehen? Dann lösche diesen ganzen Unsinn aus meinem Geist, wie ich es verlangt habe. Ist es dir egal? Dann mach, was du willst. Es ist mir egal.",shape=box,color=blue];
		j1198488166 -> j3261363075;
	j3861610262 [label="Ich habe letzte Nacht so gut geschlafen wie schon lange nicht mehr. Eher sogar \"länger, als ich mich erinnern kann\", aber das wäre ein ziemlich dürftiger Witz.",shape=box,color=blue];
		j3861610262 -> j3398975195;
	j4032536395 [label="Wie bitte?",shape=box,color=red];
		j4032536395 -> j4132300015;
	j659686754 [label="Reden wir von Loid?",shape=box,color=red];
		j659686754 -> j1990550316;
	j3106030335 [label="Gibt es irgendeine Möglichkeit, wie ich dich umstimmen könnte?",shape=box,color=red];
