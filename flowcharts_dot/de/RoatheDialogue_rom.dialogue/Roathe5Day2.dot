		j1776100240 -> j2279345898 [label="RoatheLyonConfessionDeal",color=purple];
		j1776100240 -> j1989340780 [label="RoatheDeal",color=purple];
		j1776100240 -> j1968885904 [label="false",color=purple];
	j2045617664 [label="Und verschwende keine Zeit damit, die Eiferer zu belästigen, damit sie mir die Ohren voll jammern, in der Hoffnung, mich zu Gnade zu bewegen. Es wird nicht funktionieren.",shape=box,color=blue];
		j2045617664 -> "Chat ends.";
	j2208792608 [label="Das ist eine andere Art von Erinnerungen, Roathe. Das funktioniert bei denen nicht. Sie sind tiefer in deiner Psyche vergraben.",shape=box,color=red];
		j2208792608 -> j444371281;
	j4170329653 [label="Vor der Wahrheit wegzulaufen und sich zu verstecken, bringt nichts. Wir landen am Ende genau da, wo wir angefangen haben.",shape=box,color=red];
		j4170329653 -> j2510567497;
	j2010872779 [label="Bist du dir sicher? Aber ... du bist clever, ich habe den Eindruck du wirst merken, dass etwas nicht stimmt.",shape=box,color=red];
		j2010872779 -> j2413846838;
	j1137970808 [label="+5 Chemistry",color=orange];
		j1137970808 -> j1034664389;
