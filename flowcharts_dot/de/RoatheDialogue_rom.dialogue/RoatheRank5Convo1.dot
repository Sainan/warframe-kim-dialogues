	3553 [label="Der Weg voran, frei von den Hindernissen meiner Vergangenheit. Er ist verlockend, Schatz. Es fühlt sich ... irgendwie falsch an. Den Zorn nach so langer Zeit endlich loszulassen.",shape=box,color=blue];
