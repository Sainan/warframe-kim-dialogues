		3570 -> 3591;
	3569 [label="Ein Rückzug, um den Krieg zu gewinnen. Hm.",shape=box,color=blue];
		3569 -> 3590;
	3571 [label="Du besitzt eine Gabe. Eine Gabe, die die Zeit aufheben kann. Die sie in Spiralen, wenn nicht gar in eine Schleifen, formen kann. Und dies hat ... einen interessanten Effekt auf den Verstand eines Protoframes, durch seine Verbindung zum Befall und seine Verbindung zur Zeit. ",shape=box,color=blue];
		3571 -> 3592;
	3572 [label="Kannst du mir versichern, dass du deine Gaben niemals dazu benutzt hast, mit den Erinnerungen der Protoframes zu spielen, die du Freunde und Geliebte nennst, und kannst du das ohne eine Lüge in deiner Seele sagen?",shape=box,color=blue];
		3572 -> 3593;
	3573 [label="Ich muss gehen. Ich habe Lust, seht viel Alkohol zu trinken und grüblerisch in die Ferne zu starren.",shape=box,color=blue];
		3573 -> 3594;
	3577 [label="Ich glaube, es wird eine Maske sein, die ich sehr lange tragen werde. Auch wenn ich sie nicht wirklich vertrete. Aber ... du hast absolut recht.",shape=box,color=blue];
		3577 -> 3598;
	3576 [label="Aber das zu werden, was ich schon immer hätte sein können, frei von allem, was mich zurückhielt? Ja. Ja, darin könnte ich große Freude finden.",shape=box,color=blue];
		3576 -> 3597;
	3574 [label="Ich gebe dir also noch eine Chance, mich zu überzeugen. Ich überlasse dir sogar die Wahl, welchen Weg wir einschlagen. Mein Teil der Abmachung ist erfüllt. Vergiss nicht: Du schuldest dem Teufel etwas. Und ich werde es eintreiben.",shape=box,color=blue];
		3574 -> 3595;
	3575 [label="Mindestens zweimal! Soweit ich weiß! Wer weiß, wie oft wir dieses Thema schon durchgekaut haben.",shape=box,color=blue];
		3575 -> 3596;
	3578 [label="Ich glaube, es wird eine Maske sein, die ich sehr lange tragen werde. Auch wenn ich sie nicht wirklich vertrete. Aber ... du hast absolut recht.",shape=box,color=blue];
		3578 -> 3599;
	3579 [label="Aber das zu werden, was ich schon immer hätte sein können, frei von allem, was mich zurückhielt? Ja. Ja, darin könnte ich große Freude finden.",shape=box,color=blue];
		3579 -> 3600;
	3580 [label="Ich gebe dir also noch eine Chance, mich zu überzeugen. Ich überlasse dir sogar die Wahl, welchen Weg wir einschlagen. Mein Teil der Abmachung ist erfüllt. Vergiss nicht: Du schuldest dem Teufel etwas. Und ich werde es eintreiben.",shape=box,color=blue];
