		3448 -> 3477;
	3453 [label="Du wirst nicht durch deine Vergangenheit definiert, Roathe. Du wirst durch deine Zukunft definiert. Und du hast noch eine Zukunft vor dir, anders als all die Orokin, die in der Nacht der Naga-Trommeln starben.",shape=box,color=red];
		3453 -> 3481;
	3452 [label="Du wirst nicht durch die Meinungen jener um dich herum definiert. Auch nicht durch das, was sie über deine Handlungen denken. Du wirst allein durch das definiert, was du über dich selbst und deine Entscheidungen glaubst.",shape=box,color=red];
		3452 -> 3480;
	3451 [label="Update boolean RoatheFail",color=orange];
		3451 -> 3398;
	3454 [label="Und ich weiß nicht, wie ihren Hunger stillen soll. Ich weiß nicht, ob ich es überhaupt kann. Ich hatte gehofft, diese Gespräche würden mir einen Weg zeigen; aber ich sehe jetzt, dass das vergeblich ist.",shape=box,color=blue];
