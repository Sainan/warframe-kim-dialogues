		3421 -> 3452;
	3418 [label="Wut löst keine Probleme, Roathe. Du bist wütend, weil du Angst hast, dich dem zu stellen, was du getan hast. Und dem, was aus dir geworden ist.",shape=box,color=red];
		3418 -> 3422;
	3419 [label="Gut. Sei wütend. Aber nutze diese Wut für etwas Sinnvolles. Nutze sie, um all den Hass in dir abzuschütteln, den du in die falsche Richtung richtest.",shape=box,color=red];
		3419 -> 3421;
	3420 [label="Ich wünschte, ich wüsste, wie ich dir helfen kann. Ich wünschte, ich wüsste, was ich sagen soll. Es wirkt, als wärst du hin- und hergerissen. Welchen Weg willst du gehen?",shape=box,color=red];
		3420 -> 3451;
	3423 [label="In mir tobt eine wilde, rasende Bestie, die meinen Brustkorb von innen heraus auffrisst.",shape=box,color=blue];
		3423 -> 3454;
	3424 [label="Und die einfache Wahrheit ist: Du bist einer der wenigen Orokin, die wir kennen, der die Nacht der Naga-Trommeln überlebt hat. Aus meiner Sicht war es ein strategischer Rückzug.",shape=box,color=red];
		3424 -> 3455;
	3425 [label="Das ist das Einzige, was dich jetzt noch ausmacht. Du kannst dich ändern. Und du kannst die Welt um dich herum ändern. Meine einzige Frage ist: Wirst du es wenigstens versuchen?",shape=box,color=red];
