	3556 [label="Der Weg voran, frei von den Hindernissen meiner Vergangenheit. Er ist verlockend, Usurpator. Drifter. Es fühlt sich ... irgendwie falsch an. Den Zorn nach so langer Zeit loszulassen.",shape=box,color=blue];
