	3446 [label="Ich weiß, wie es ist, immer wieder zu versuchen, etwas zu entkommen, von dem du glaubst, es nie loszuwerden. Vor etwas wegzulaufen, das dir immer folgen wird, egal wie weit du rennst.",shape=box,color=red];
