	3201 [label="Verleumdet, missverstanden, verflucht. Vom Himmel verstoßen und dem Verfall preisgegeben. Seelenverwandte, wahrlich!",shape=box,color=blue];
		3201 -> 3210;
	3202 [label="Ich weiß, dass wir das nicht zum ersten Mal durchmachen. Ich erinnere mich, hier gewesen zu sein. Und ich weiß, dass es wahrscheinlich nicht das letzte Mal sein wird. Ich bitte dich immer wieder, hier innezuhalten und von vorn anzufangen, und es bedeutet mir unendlich viel, dass du es tust.",shape=box,color=blue];
