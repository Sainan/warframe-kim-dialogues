		3450 -> 3479;
	3449 [label="Hast diese Spielchen mitgespielt. Hast an den Schnüren anderer getanzt. Hast getan, was erwartet wurde, Wenn es erwartet wurde. Wie es erwartet wurde. Hast Kriege anderer geführt. Das ist es, was dich innerlich zerreißt.",shape=box,color=red];
