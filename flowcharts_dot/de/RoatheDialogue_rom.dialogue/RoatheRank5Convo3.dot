	j1310910473 [label="Drifter ... mein armer, süßer Drifter ...",shape=box,color=blue];
		j1310910473 -> j2194106269;
	j155347791 [label="Ich fürchte, ich bin hier unten in dieser nachgebauten Krypta mit diesen beiden Fanatikern schon etwas zu lange allein gelassen worden.",shape=box,color=blue];
		j155347791 -> j727335053;
	j197744858 [label="Es verblüffte mich zunächst, als du zu Beginn mit mir verhandelt hast. Warum? Warum würdest du für eine so seltsame Bitte eine so gefährlich unsichere Abmachung eingehen?",shape=box,color=blue];
		j197744858 -> j1879598647;
	j246919186 [label="Albrecht und sein dürrer kleiner Butler fanden es angebracht, dir eine Sammlung kaputter Spielsachen aufzubürden. Sehr attraktiver kaputter Spielsachen.",shape=box,color=blue];
		j246919186 -> j2201103779;
	j3576577066 [label="Wahrer Zuneigung?",shape=box,color=blue];
		j3576577066 -> j3674582561;
	j38044158 [label="Du schuldest mir immer noch meinen Teil der Abmachung, unabhängig davon, ob du willst, dass ich meinen Teil erfülle oder nicht.",shape=box,color=blue];
		j38044158 -> j172658291;
	j2701110890 [label="Nun, ich muss dir sagen, während ich durchaus bereit bin zu \"teilen\", sind es die Eiferer ... vermutlich nicht. Ich empfehle, deine derzeitige Situation zu klären, bevor unsere weiter geht.",shape=box,color=blue];
		j2701110890 -> j2733265819;
	j1888940717 [label="Boolean RoatheDating is now true.",color=orange];
		j1888940717 -> j1705271760;
	j2217791856 [label="Du schienst also bereit zu sein, deine Seele für ein einziges Stückchen Wertvolles zu verkaufen. Du kannst dir meine Verwirrung vorstellen.",shape=box,color=blue];
		j2217791856 -> j1456396285;
	j2022041923 [label="Ich bin erleichtert, dass du mir das nicht übel nimmst.",shape=box,color=red];
		j2022041923 -> j3876089880;
	j3162596116 [label="Es ist ... nicht nur Einsamkeit, Roathe. Du liegst mir wirklich am Herzen.",shape=box,color=red];
		j3162596116 -> j3141893256;
	j776837565 [label="Ich muss jedoch fragen: Warum? Bist du nach so vielen Jahrhunderten so neugierig darauf, das Fleisch eines Orokin zu kosten?",shape=box,color=blue];
