	j2677991597 [label="Du folgst seinen Befehlen, heilst zerbrochene Familien und leere Herzen, wo immer du auch hingehst. Wüsste ich nicht, was du wirklich empfindest, würde ich denken, du nimmst Fleisch als Bezahlung an. Mein Fleisch, um genau zu sein.",shape=box,color=blue];
		j2677991597 -> j2984800514;
	j1609092377 [label="Du folgst seinen Befehlen, heilst zerbrochene Familien und leere Herzen, wo immer du auch hingehst. Aber du nimmst dir auch etwas davon, nicht wahr? In Fleisch und Blut. Mein Fleisch.",shape=box,color=blue];
