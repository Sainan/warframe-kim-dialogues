		j776748929 -> j178902881;
	j110675205 [label="Natürlich nicht! All die Jahrhunderte ganz allein. Keine Freunde. Keine Gefährten. Du amüsierst dich einfach!",shape=box,color=blue];
		j110675205 -> j760061449;
	j1997738327 [label="+10 Chemistry",color=orange];
		j1997738327 -> j739166564;
	j3399133926 [label="Bitte was?",shape=box,color=blue];
		j3399133926 -> j2611815899;
	j662751248 [label="Ich bin mir sicher, dass an dem, was du sagst, etwas Wahres dran ist. Oder zumindest glaube ich, dass du deine eigene Selbsttäuschung nicht erkennst.",shape=box,color=blue];
		j662751248 -> j438927856;
	j2874518720 [label="[Gefühle gestehen.] Nun ja, es lag nicht daran, dass ich keine Gefühle für dich habe, ich wusste einfach nicht, wie ich es ansprechen sollte ...",shape=box,color=red];
		j2874518720 -> j2316133914;
	j2305518278 [label="Ich war mir nicht sicher, wie ihr alle zu diesem Thema steht.",shape=box,color=red];
		j2305518278 -> j2870830943;
	j1950012863 [label="Es ist nicht altmodisch. So lebe ich mein Leben. Ich bin meinem Partner treu.",shape=box,color=red];
		j1950012863 -> j3641683127;
	j404451461 [label="Keiner von euch reizt mich, Roathe. Nichts für ungut.",shape=box,color=red];
		j404451461 -> j372197998;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j3546713601 [label="Boolean RoatheLoved is now true.",color=orange];
		j3546713601 -> j1310910473;
	j1253820097 [label="Ich. Mir fehlen die Worte.",shape=box,color=red];
		j1253820097 -> j155347791;
	j3105532719 [label="Geht es dir gut?",shape=box,color=red];
		j3105532719 -> j155347791;
	j3797203843 [label="Ja. Das ist mir jetzt klar. Du hast deine Seele dem Teufel persönlich verkauft, weil ... er, ohne es zu wissen, bereits dein gebrochenes Herz besaß.",shape=box,color=blue];
		j3797203843 -> j197744858;
	j705317910 [label="Kaum! Ich würde dir applaudieren, wenn wir im selben Raum säßen, Drifter Lieber. Du hast einfach das Beste aus deiner Situation gemacht.",shape=box,color=blue];
		j705317910 -> j246919186;
	j3699863448 [label="Oh? Und du willst damit andeuten, dass du mit mir eine Abmachung getroffen hast, um sicherzustellen, dass ich dir eine faire Chance gebe, meine Zuneigung zu gewinnen ... aufgrund wovon?",shape=box,color=blue];
		j3699863448 -> j3576577066;
	j2394806500 [label="Was für ein wirklich seltsames kleines Wesen du bist. Lass uns reden, wenn du deine Meinung änderst.",shape=box,color=blue];
		j2394806500 -> j38044158;
