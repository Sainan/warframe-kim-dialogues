		j760061449 -> j1851925502 [label="false",color=purple];
	j739166564 [label="Ehrlichkeit ist eine wunderbare Sache, mein Drifter Lieber. Glaubst du, ich würde dich dafür verurteilen, dass du dich amüsierst? Wohl kaum.",shape=box,color=blue];
		j739166564 -> j3238870454;
	j2611815899 [label="Nein. Das ist nicht dein Ernst?",shape=box,color=blue];
		j2611815899 -> j3379753340;
	j438927856 [label="Ich glaube, die größte Errungenschaft des Imperiums der Orokin war dessen Fähigkeit, diejenigen darin davon zu überzeugen, an ihre eigenen Einbildungen zu glauben.",shape=box,color=blue];
		j438927856 -> j472425928;
	j2316133914 [label="Check boolean RoatheNoDate",color=orange];
		j2316133914 -> j2272242381 [label=true,color=green];
		j2316133914 -> j1316884051 [label=false,color=brown];
	j2870830943 [label="Nun, ich persönlich hätte nichts dagegen, wie du diesem Gespräch wahrscheinlich entnehmen kannst. Ich bezweifle, dass die Eiferer anders denken.",shape=box,color=blue];
		j2870830943 -> j2040653207;
	j3641683127 [label="+5 Chemistry",color=orange];
		j3641683127 -> j3046850156;
