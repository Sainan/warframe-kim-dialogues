		j3466715080 -> j2157787640;
	j2514226559 [label="Ich mache dir jedoch keinen Vorwurf. Ich habe ja Augen im Kopf. Obwohl ich mir nicht vorstellen könnte, mit jemandem auszugehen, der so verrückt ist wie er. So sehr ich das Gefühl der Gefahr auch schätze.",shape=box,color=blue];
