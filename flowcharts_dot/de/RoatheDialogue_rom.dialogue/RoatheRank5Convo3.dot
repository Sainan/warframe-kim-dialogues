	j1794243075 [label="+5 Chemistry",color=orange];
		j1794243075 -> j1521370997;
	j3749375676 [label="Denn ich kann es kaum erwarten zu sehen, was wir gemeinsam diesem Ursprungssystem antun werden ... und unzähligen anderen.",shape=box,color=blue];
		j3749375676 -> "Chat ends.";
	j1231893234 [label="Denn was wir gemeinsam leisten können, ist schier unglaublich, nicht wahr, mein lieber Drifter-Schatz?",shape=box,color=blue];
		j1231893234 -> "Chat ends.";
	j2448722618 [label="Die Zukunft erwartet uns.",shape=box,color=blue];
		j2448722618 -> "Chat ends.";
	j3238870454 [label="Auf eine Beziehung, die gleichermaßen Befriedigung bereitet.",shape=box,color=blue];
		j3238870454 -> j1492113065;
	j3379753340 [label="Boolean RoatheLoved is now true.",color=orange];
		j3379753340 -> j4262459761;
	j472425928 [label="Vielleicht ist das sogar das wahre Bindeglied der Menschheit: unsere meisterhafte Fähigkeit, in den Spiegel zu schauen und uns selbst zu täuschen.",shape=box,color=blue];
		j472425928 -> j3440220700;
	j2272242381 [label="Oh, mein Drifter-Schatz. Als ich \"uns drei\" erwähnte, meinte ich das eher im allgemeinen Sinne.",shape=box,color=blue];
		j2272242381 -> j220178902;
	j1316884051 [label="Hm?",shape=box,color=blue];
		j1316884051 -> j889444205;
	j2040653207 [label="Was deine bisherigen Verpflichtungen angeht? Ehrlichkeit und Einvernehmen sind in allen Lebensbereichen entscheidend, Usurpator, aber das weißt du ja. ",shape=box,color=blue];
		j2040653207 -> j4100462337;
	j3046850156 [label="Ach, verwechsele meine Belustigung nicht mit Verhöhnung. Genieße das Leben, wie es dir gefällt, mein lieber Usurpator. Das ist mein Motto.",shape=box,color=blue];
		j3046850156 -> j1298007025;
	j1270195165 [label="Ha! Kein Problem. Genieße das Leben, wie es dir gefällt, mein lieber Usurpator. Das ist mein Motto.",shape=box,color=blue];
		j1270195165 -> j1298007025;
	j2194106269 [label="Vergib mir. Bitte vergib mir. Ich wusste es nicht.",shape=box,color=blue];
