	j987212141 [label="Ah.",shape=box,color=blue];
		j987212141 -> j3916372424;
	j1873031089 [label="Das ist ganz natürlich. Ich merke sogar, dass ich die Eiferer mit der Zeit etwas weniger hasse, je länger ich gezwungen bin, in ihrer Gegenwart zu sein. Es ist zum Verzweifeln.",shape=box,color=blue];
		j1873031089 -> j1125321024;
