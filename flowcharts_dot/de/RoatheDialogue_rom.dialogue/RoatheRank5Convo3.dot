		j3083880592 -> j1075391089;
	j1881643177 [label="Ach so? Und du willst damit andeuten, dass du diese Zeit mit mir verbringst aus ... was? Wahrer Zuneigung? Bitte bringe mich nicht zum Lachen.",shape=box,color=blue];
