	j401144920 [label="Weißt du, sie waren einst verliebt.",shape=box,color=blue];
		j401144920 -> j1623173998;
		j401144920 -> j130575420;
		j401144920 -> j129698615;
	j2747403239 [label="Unsere Gedanken manipulieren ... alles nur aus Begierde? Liebe? Was genau? Wie würdest du es nennen? Ich frage mich einfach, ob es das wert war. Oder du weißt es selbst noch nicht, weil deine Belohnung noch nicht ausgezahlt wurde.",shape=box,color=blue];
		j2747403239 -> j3842413794;
	j2763233067 [label="Unsere Gedanken manipulieren ... und wozu das alles? Um eine ... unsichtbare To-do-Liste abzuarbeiten? Oder geschieht das alles im Namen der Bezwingung deines heraufbeschworenen, sogenannten \"Gottes\"?",shape=box,color=blue];
		j2763233067 -> j3184965841;
	j1623173998 [label="Wer?",shape=box,color=red];
		j1623173998 -> j2087632995;
	j130575420 [label="Das kann ich mir schwer vorstellen.",shape=box,color=red];
		j130575420 -> j1148131403;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j3842413794 [label="Ich nehme an, es ist auf seltsame Weise romantisch, wenn auch ein wenig ... dystopisch, so weit zu gehen, um das Herz (und/oder den Körper) des/der Auserwählten zu gewinnen.",shape=box,color=blue];
		j3842413794 -> j774665754;
	j3184965841 [label="Oder ist es sogar noch schlimmer, und du warst einfach nur neugierig, was passieren würde? Und du sitzt einfach nur da und zupfst Insekten die Beine aus? Wir haben das \"Was\" hinter deinen Handlungen geklärt. Nun versuche ich, das \"Warum\" zu ergründen.",shape=box,color=blue];
		j3184965841 -> j3362610447;
	j2087632995 [label="Ballas und Margulis.",shape=box,color=blue];
		j2087632995 -> j2666240932;
	j1148131403 [label="Das stimmt! Ich kann fast deinen Spott aus dem Sanctum hören. Aber Ballas und Margulis waren sehr verliebt.",shape=box,color=blue];
		j1148131403 -> j2457901093;
	j774665754 [label="Oder ist es noch schlimmer, und du warst einfach nur neugierig, was passieren würde? Und du sitzt einfach nur da und zupfst Insekten die Beine aus? Wir haben das \"Was\" hinter deinen Handlungen geklärt. Nun versuche ich, das \"Warum\" zu ergründen.",shape=box,color=blue];
		j774665754 -> j2868117985;
