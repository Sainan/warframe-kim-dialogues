		j2868117985 -> j2676667352 [label=false,color=brown];
		j2868117985 -> j2441289991 [label=false,color=brown];
	j3172820145 [label="Du hast zuvor erwähnt, dass du es \"vermasselt\" hast, oder dass die Sache mit den Eiferern irgendwie so verwickelt sei, dass sie sich nicht mehr entwirren ließe. Du dachtest also wirklich, das sei die beste Option?",shape=box,color=blue];
		j3172820145 -> j2638028909;
		j3172820145 -> j958514659;
		j3172820145 -> j3868813347;
		j3172820145 -> j1873734759;
	j1873734759 [label="Ich wusste nicht, was ich sonst tun sollte. Ich hatte keine anderen Optionen.",shape=box,color=red];
		j1873734759 -> j3772047713;
	j3868813347 [label="Ja, das habe ich gedacht. Mir war nicht klar ... dass du in so einem Zustand enden würdest, mit bruchstückhaften Erinnerungen. Es tut mir leid.",shape=box,color=red];
		j3868813347 -> j1333843191;
	j2638028909 [label="Um ganz ehrlich zu sein, Roathe? Ich ... dachte nicht, dass es tatsächlich eine Rolle spielt, dass ich das kann.",shape=box,color=red];
		j2638028909 -> j3167535063;
	j2238740804 [label="Ich war neugierig, was passieren würde.",shape=box,color=red];
		j2238740804 -> j3748610308;
	j2209540976 [label="Was ist passiert, dass sich die Dinge so drastisch verändert haben?",shape=box,color=red];
		j2209540976 -> j1450949667;
	j2552639555 [label="Menschen ändern sich nicht so sehr. Tief in seinem Inneren war er immer zu dem fähig, was er getan hat.",shape=box,color=red];
		j2552639555 -> j197272477;
	j3302457659 [label="Du hast zuvor erwähnt, dass du es zwischen uns \"vermasselt\" hast, oder dass die Sache mit den Eiferern irgendwie so verwickelt sei, dass sie sich nicht mehr entwirren ließe. Du dachtest also wirklich, das sei die beste Option?",shape=box,color=blue];
