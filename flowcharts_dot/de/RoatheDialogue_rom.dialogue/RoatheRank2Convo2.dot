		j1646847578 -> j2376291079 [label="x < 21",color=purple];
		j1646847578 -> j2376291079 [label="false",color=purple];
	j2327455016 [label="Ah, du gehörst also doch zum Imperium der Orokin. Wie wunderbar. Ich kann mir kaum vorstellen, dass du das im Namen der \"Liebe\" getan hast.",shape=box,color=blue];
		j2327455016 -> j3918350520;
	j631239791 [label="Ah, verstehe ... gewohnt, das ohne Konsequenzen zu tun. Nun, wahrscheinlich hattest du es noch nie mit einem anderen Protoframe zu tun, dessen Erinnerungen ... so zersplittert sind wie meine. Insofern habe ich wohl etwas Verständnis für dich. Und das alles im Namen der \"Liebe\".",shape=box,color=blue];
		j631239791 -> j3748535684;
	j1667079611 [label="Hm, ja. Nun, du hattest vermutlich noch nie mit einem anderen Protoframe zu tun, dessen Erinnerungen so ... zersplittert sind wie meine. Insofern habe ich wohl ein gewisses Verständnis dafür. Und das alles in Namen der \"Liebe\".",shape=box,color=blue];
		j1667079611 -> j3748535684;
	j1231081132 [label="Und so beginne ich zu verstehen, wie es überhaupt dazu kam, dass du es \"vermasselt\" hast, Usurpator.",shape=box,color=blue];
		j1231081132 -> j2378827931;
	j3446436871 [label="+5 Chemistry",color=orange];
		j3446436871 -> j3446929291;
	j3219110383 [label="+5 Chemistry",color=orange];
		j3219110383 -> j4199197961;
	j2378827931 [label="Ich würde dich für das, was du im Namen der Erfüllung deiner Ziele getan hast, tadeln, aber mir fällt auf, dass die Orokin weit Schlimmeres, wenn nicht gar kreativeres, getan haben.",shape=box,color=blue];
		j2378827931 -> j572047407;
	j334512840 [label="Du bist passiert. Oder besser gesagt, die Kinder. Die Tenno. Manchmal frage ich mich, ob das, was geschah, unvermeidlich war. Oder ob er hätte überzeugt werden können, seinen Kurs zu ändern.",shape=box,color=blue];
		j334512840 -> j2550572220;
	j1499862114 [label="Vielleicht hast du recht. Oder vielleicht sind wir am Ende alle ungeschliffene Juwelen. Wir haben unsere Fehler, unsere Eigenheiten. Hier Adern, dort Makel.",shape=box,color=blue];
		j1499862114 -> j1597169935;
	j1659913018 [label="Und so beginne ich zu verstehen, wie es überhaupt dazu kommen konnte, dass du es \"vermasselt\" hast, Usurpator. Ich kann mir kaum vorstellen, dass du das im Namen der \"Liebe\" getan hast.",shape=box,color=blue];
		j1659913018 -> j3918350520;
	j3895076962 [label="+5 Chemistry",color=orange];
		j3895076962 -> j1777250654;
	j2376291079 [label="+5 Chemistry",color=orange];
		j2376291079 -> j2996607854;
	j3918350520 [label="Aber die Orokin hatten wohl schon immer eine seltsame Art, ihre Gefühle auszudrücken.",shape=box,color=blue];
		j3918350520 -> j572047407;
	j3748535684 [label="Ich würde dich für das, was du im Namen der sogenannten \"Liebe\" getan hast, tadeln, aber mir fällt auf, dass die Orokin weit Schlimmeres, wenn nicht gar kreativeres, getan haben.",shape=box,color=blue];
		j3748535684 -> j572047407;
	j3446929291 [label="Ich persönlich würde raten, seine Fehler stillschweigend hinzunehmen und die Niederlage als das zu akzeptieren, was sie ist, aber das würde mich zu einem ziemlich tobenden Heuchler machen, nicht wahr?",shape=box,color=blue];
		j3446929291 -> j3671599876;
	j4199197961 [label="Ich persönlich würde raten, seine Fehler stillschweigend hinzunehmen und eine Niederlage zu akzeptieren. Doch ich besitze nicht die vom Void verliehene Gabe, Zeitschleifen zu erzeugen und Erinnerungen auszulöschen.",shape=box,color=blue];
		j4199197961 -> j1970993738;
	j572047407 [label="Habe ich dir die Geschichte von Ballas und Margulis erzählt? Ich verlasse mich darauf, dass du ehrlich zu mir bist, da ich sonst absolut keine Möglichkeit habe, die Wahrheit herauszufinden.",shape=box,color=blue];
		j572047407 -> j1537777305;
	j2550572220 [label="Ich glaube, dass wir alle im Grunde ungeschliffene Juwelen sind. Wir haben unsere Fehler, unsere Eigenheiten. Hier Adern, dort Makel.",shape=box,color=blue];
		j2550572220 -> j1597169935;
	j1597169935 [label="Und wir werden auf bestimmte Weise facettiert, um entweder das Licht einzufangen und zu kunstvollen Kunstwerken zu werden ... oder zu Waffen geschärft zu werden ... oder zu Staub zerschmettert zu werden.",shape=box,color=blue];
		j1597169935 -> j1143240181;
	j1777250654 [label="Ich persönlich würde raten, seine Fehler stillschweigend hinzunehmen und die Niederlage als das zu akzeptieren, was sie ist, aber das würde mich zu einem ziemlich tobenden Heuchler machen, nicht wahr?",shape=box,color=blue];
		j1777250654 -> j1152121978;
	j2996607854 [label="Ich persönlich würde raten, seine Fehler stillschweigend hinzunehmen und eine Niederlage zu akzeptieren. Doch ich besitze nicht die vom Void verliehene Gabe, Zeitschleifen zu erzeugen und Erinnerungen auszulöschen.",shape=box,color=blue];
		j2996607854 -> j2466935946;
	j3671599876 [label="Und wer kann schon sagen, dass ich die mir vom Void verliehene Gabe, Zeitschleifen zu erzeugen und Erinnerungen auszulöschen, nicht genutzt hätte?",shape=box,color=blue];
		j3671599876 -> j1970993738;
	j1970993738 [label="Wie ... genau funktioniert das eigentlich?",shape=box,color=blue];
		j1970993738 -> j1337172369;
		j1970993738 -> j2187441616;
		j1970993738 -> j129698615;
	j1537777305 [label="Und ich verabscheue das, das kann ich dir sagen.",shape=box,color=blue];
		j1537777305 -> j3145680627;
		j1537777305 -> j625047454;
		j1537777305 -> j1520179668;
		j1537777305 -> j2981309257;
	j1143240181 [label="Vielleicht ist das eine naive Annahme, und wir sind tatsächlich alle unveränderlich. Du weißt es sicher besser als ich, habe ich gehört.",shape=box,color=blue];
		j1143240181 -> j2929776597;
	j1152121978 [label="Und wer kann schon sagen, dass ich die mir vom Void verliehene Gabe, Zeitschleifen zu erzeugen und Erinnerungen auszulöschen, nicht genutzt hätte?",shape=box,color=blue];
		j1152121978 -> j2466935946;
	j2466935946 [label="Wie ... genau funktioniert das eigentlich?",shape=box,color=blue];
		j2466935946 -> j1138855841;
		j2466935946 -> j3272325579;
		j2466935946 -> j129698615;
	j1337172369 [label="Du bist jetzt befallen. Und du trägst eine Verbindung zu den befallenen Stämmen, die zur Herstellung aller Protoframe-Serumchargen verwendet wurden.",shape=box,color=red];
		j1337172369 -> j1536724659;
	j2187441616 [label="Eine sprechende Gitarre schuldet mir ein paar Gefallen.",shape=box,color=red];
		j2187441616 -> j166527289;
	j3145680627 [label="Ich kenne sie.",shape=box,color=red];
		j3145680627 -> j2807526391;
	j625047454 [label="Ich kenne sie, aber bitte, fahre fort.",shape=box,color=red];
		j625047454 -> j2358538161;
	j1520179668 [label="Ich kenne sie tatsächlich noch nicht.",shape=box,color=red];
		j1520179668 -> j700328063;
	j2981309257 [label="Nein, ich kenne die Geschichte nicht ... und genau das ist teilweise der Grund, warum wir hier sind. Ich weiß, dass ich beim ersten Mal Chancen verpasst habe.",shape=box,color=red];
		j2981309257 -> j4074013423;
	j2929776597 [label="Aber du lässt mich das alles in der falschen Reihenfolge erzählen. Erlaube mir, richtig anzufangen.",shape=box,color=blue];
		j2929776597 -> j1881022758;
	j1138855841 [label="Du bist jetzt befallen. Und du trägst eine Verbindung zu den befallenen Stämmen, die zur Herstellung aller Protoframe-Serumchargen verwendet wurden.",shape=box,color=red];
		j1138855841 -> j1372977394;
	j3272325579 [label="Eine sprechende Gitarre schuldet mir ein paar Gefallen.",shape=box,color=red];
		j3272325579 -> j4073083048;
	j1536724659 [label="Soweit mir gesagt wurde – und sie ist nicht sehr verlässlich, also sollte man das mit Vorsicht genießen – können die Befallstämme für jede Charge von Protoframes individuell beeinflusst werden.",shape=box,color=red];
		j1536724659 -> j904192385;
	j166527289 [label="Ich ... verstehe.",shape=box,color=blue];
		j166527289 -> j826073204;
	j2807526391 [label="+10 Chemistry",color=orange];
		j2807526391 -> j2500966314;
	j2358538161 [label="Entweder versuchst du, mein Ego zu schmeicheln, was ich dir hoch anrechne, oder du bist einfach nur extrem gelangweilt von deinem Tag. Womit ich, als jemand, der selbst schon unzählige Lebenszyklen erlebt hat, fast mitfühlen kann.",shape=box,color=blue];
		j2358538161 -> j1790959358;
	j700328063 [label="Faszinierend. Entweder lügst du, oder ich habe noch einige Geheimnisse, die du nicht kennst. Deshalb bist du wahrscheinlich erneut hier, um bereits durchwühlte Themen durchzugehen.",shape=box,color=blue];
		j700328063 -> j2806763723;
	j4074013423 [label="Hm, Stück für Stück schaffst du es fast, mich davon zu überzeugen, dir dieses Chaos zu verzeihen, das du angerichtet hast.",shape=box,color=blue];
		j4074013423 -> j2457601190;
	j1881022758 [label="Lange bevor die Zariman Ten-Zero startete und die Tenno überhaupt nur eine Randnotiz in der Geschichte waren, trafen sich Margulis die Archimede und Ballas bei der Eröffnung eines neuen Kuppelkonservatoriums.",shape=box,color=blue];
		j1881022758 -> j1081250997;
	j1372977394 [label="Soweit mir gesagt wurde – und sie ist nicht sehr verlässlich, also sollte man das mit Vorsicht genießen – können die Befallstämme für jede Charge von Protoframes individuell beeinflusst werden.",shape=box,color=red];
		j1372977394 -> j3622970021;
	j4073083048 [label="Ich ... verstehe.",shape=box,color=blue];
		j4073083048 -> j503509802;
	j904192385 [label="Jeder einzelne existiert gewissermaßen in seiner eigenen \"Kontinuität\" oder Zeit. Alle Befallstämme sind miteinander verbunden, aber sie leben in ... Knötchen. Es ist alles sehr kompliziert.",shape=box,color=red];
		j904192385 -> j1194639881;
	j826073204 [label="Das Universum ist seit meiner Abwesenheit gewiss seltsamer geworden ...",shape=box,color=blue];
		j826073204 -> j24816315;
		j826073204 -> j1757750668;
	j2500966314 [label="Dann werde ich dich nicht mit einer weiteren Erzählung der Geschichte langweilen und dir den Rest des Tages für andere Vergnügungen überlassen.",shape=box,color=blue];
		j2500966314 -> j2888030837;
	j1790959358 [label="Wäre ich nicht Gegenstand deiner Belustigung.",shape=box,color=blue];
		j1790959358 -> j2806763723;
	j2806763723 [label="Aber? Trotzdem ...",shape=box,color=blue];
		j2806763723 -> j219314232;
	j2457601190 [label="Boolean RoatheResetForgiven is now true.",color=orange];
		j2457601190 -> j2806763723;
	j1081250997 [label="Ballas war nur wegen der Zeremonie da – wir lieben unseren Pomp und unsere Pracht natürlich – und Margulis versuchte verzweifelt, nicht aufzufallen.",shape=box,color=blue];
		j1081250997 -> j3639904656;
	j3622970021 [label="Jeder einzelne existiert gewissermaßen in seiner eigenen \"Kontinuität\" oder Zeit. Alle Befallstämme sind miteinander verbunden, aber sie leben in ... Knötchen. Es ist alles sehr kompliziert.",shape=box,color=red];
		j3622970021 -> j1887443527;
	j503509802 [label="Das Universum ist seit meiner Abwesenheit gewiss seltsamer geworden ...",shape=box,color=blue];
		j503509802 -> j2163107397;
		j503509802 -> j2618401701;
	j1194639881 [label="Da ich also Zeitschleifen auslösen kann, kann ich die Befalls-\"Chargen\" in begrenztem Umfang ebenfalls in einer Schleife wiederholen.",shape=box,color=red];
		j1194639881 -> j1982030298;
	j24816315 [label="Du hast ja keine Ahnung.",shape=box,color=red];
		j24816315 -> j2378827931;
	j1757750668 [label="Sie ist einfach unübertroffen. Na ja ... egal.",shape=box,color=red];
		j1757750668 -> j2378827931;
	j2888030837 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j2888030837 -> "Chat ends.";
	j219314232 [label="Ballas und Margulis.",shape=box,color=blue];
		j219314232 -> j1881022758;
	j3639904656 [label="Eines musst du verstehen, mein Usurpator: Ballas hatte keinen Grund, sich mit ihr abzugeben. Absolut keinen, es sei denn, seine Schwärmerei war echt.",shape=box,color=blue];
		j3639904656 -> j1224703396;
	j1887443527 [label="Da ich also Zeitschleifen auslösen kann, kann ich die Befalls-\"Chargen\" in begrenztem Umfang ebenfalls in einer Schleife wiederholen.",shape=box,color=red];
		j1887443527 -> j1835445572;
	j2163107397 [label="Du hast ja keine Ahnung.",shape=box,color=red];
		j2163107397 -> j3090496060;
	j2618401701 [label="Sie ist einfach unübertroffen. Na ja ... egal.",shape=box,color=red];
		j2618401701 -> j3090496060;
	j1982030298 [label="Und \"sie\" ist?",shape=box,color=blue];
		j1982030298 -> j3599426590;
		j1982030298 -> j3865664378;
	j1224703396 [label="Es war nicht bloß Begierde, denn er hätte haben können, wen er wollte – und tat es auch recht häufig. Wenn er sie gewollt hätte, hätte er sie einfach haben können und die Sache wäre erledigt gewesen.",shape=box,color=blue];
		j1224703396 -> j3498031954;
	j1835445572 [label="Und \"sie\" ist?",shape=box,color=blue];
		j1835445572 -> j3197809122;
		j1835445572 -> j1885729165;
	j3090496060 [label="Trotzdem. All das im Namen der \"Liebe\"?",shape=box,color=blue];
		j3090496060 -> j3748535684;
	j3599426590 [label="Lizzie. Sie würde dich lieben.",shape=box,color=red];
		j3599426590 -> j166527289;
	j3865664378 [label="Eine sprechende Gitarre.",shape=box,color=red];
		j3865664378 -> j166527289;
	j3498031954 [label="Er war ein Exekutor. Einer der mächtigsten der Sieben, um genau zu sein. Er hätte sie in seine Gemächer rufen können, und sie wäre ohne zu zögern gekommen.",shape=box,color=blue];
		j3498031954 -> j2431979820;
	j3197809122 [label="Lizzie. Sie würde dich lieben.",shape=box,color=red];
		j3197809122 -> j4073083048;
	j1885729165 [label="Eine sprechende Gitarre.",shape=box,color=red];
		j1885729165 -> j4073083048;
	j2431979820 [label="Aber genau das tat er nicht. Ballas warf ihr an jenem Abend einen Blick zu, und ... er war wie vom Blitz getroffen, Drifter. Völlig außer sich.",shape=box,color=blue];
		j2431979820 -> j2989294345;
	j2989294345 [label="So etwas hatte ich noch nie erlebt. Es war, als ob außer Margulis niemand sonst im Raum existierte. Er schien sogar ... irgendwie zu schüchtern, um mit ihr zu sprechen. Er! Ballas!",shape=box,color=blue];
		j2989294345 -> j1178582525;
		j2989294345 -> j165259219;
	j1178582525 [label="Ernsthaft?",shape=box,color=red];
		j1178582525 -> j3041957695;
	j165259219 [label="Du denkst dir das aus.",shape=box,color=red];
		j165259219 -> j1821218502;
	j3041957695 [label="Ich schwöre bei meiner Ehre! Und welchen Grund hätte ich zu lügen? Was kümmert mich deine Meinung zur Wahrhaftigkeit ihrer Beziehung?",shape=box,color=blue];
		j3041957695 -> j818349960;
	j1821218502 [label="Ich schwöre bei meiner Ehre, dass ich das nicht mache! Und welchen Grund hätte ich, zu lügen? Was kümmert mich deine Meinung über die Wahrhaftigkeit ihrer Beziehung?",shape=box,color=blue];
		j1821218502 -> j818349960;
	j818349960 [label="Es betrübt mich einfach, dass du etwas so schnell vereinfachen würdest, das in Wirklichkeit weitaus komplizierter ist, als es dir passt.",shape=box,color=blue];
		j818349960 -> j2800254227;
	j2800254227 [label="Sie waren verliebt, ob du es glaubst oder nicht. Ballas missachtete alle Standesregeln und Traditionen, um eine Archimede zu seiner Geliebten – und einzigen romantischen Gefährtin – zu nehmen.",shape=box,color=blue];
		j2800254227 -> j1008920637;
	j1008920637 [label="Nur wahre Liebe konnte einen Mann so spektakulär in den Wahnsinn treiben, wie sie es tat, als alles so schrecklich schiefging ...",shape=box,color=blue];
		j1008920637 -> j498833145;
		j1008920637 -> j2014581701;
	j498833145 [label="Wie kommst du darauf? War er nicht schließlich für ihren Tod verantwortlich?",shape=box,color=red];
		j498833145 -> j646295371;
	j2014581701 [label="Ballas war es, der sie hinrichten ließ.",shape=box,color=red];
		j2014581701 -> j646295371;
	j646295371 [label="Nehmen wir zunächst an, dass alles, was du weißt, stimmt und dass seine Handlungen dort ausschließlich aus eigenem Antrieb erfolgten. Nehmen wir an, dass es keine anderen politischen Manöver, Erpressungen oder sonstige Machenschaften im Hintergrund gab, die ihn zu diesem Handeln gezwungen haben könnten.",shape=box,color=blue];
		j646295371 -> j3084045573;
	j3084045573 [label="Selbst wenn dem so wäre und Ballas ihre Hinrichtung völlig unbeeinflusst gefordert hätte, war es bereits zu spät. Der Verrat, den er empfand, hatte ihn innerlich zerrissen.",shape=box,color=blue];
		j3084045573 -> j3975570039;
	j3975570039 [label="Sein Herz und sein Verstand waren bereits zerschmettert.",shape=box,color=blue];
		j3975570039 -> j440766688;
		j3975570039 -> j3984457131;
	j440766688 [label="Ich werde jetzt kein Mitleid mit ihm haben, falls du das von mir erwartest.",shape=box,color=red];
		j440766688 -> j2893875045;
	j3984457131 [label="Wegen der Tenno? Oder wegen dem, was sie ihr angetan haben?",shape=box,color=red];
		j3984457131 -> j3159936279;
	j2893875045 [label="Ich verlange nichts dergleichen von dir! Ballas verdient nichts, außer dem Urin, das du entbehren kannst, um auf seine Leiche zu pissen, wo auch immer du sie vergraben hast – falls er überhaupt ein Grab hat.",shape=box,color=blue];
		j2893875045 -> j2204447049;
	j3159936279 [label="In gewisser Weise wegen beidem. Und in gewisser Weise wegen keinem davon. Er wurde an jenem Tag in den Wahnsinn getrieben, als er ihre Hinrichtung forderte. Tatsächlich würde es mich nicht wundern, wenn ein Teil von ihm sich nicht mehr vollständig an die Tat hat erinnern können.",shape=box,color=blue];
		j3159936279 -> j2262110590;
	j2204447049 [label="Ich sage lediglich, dass er an dem Tag, als er ihre Hinrichtung anordnete, von Sinnen war. Es würde mich nicht wundern, wenn ein Teil von ihm sich nicht mehr vollständig an die Tat hat erinnern können.",shape=box,color=blue];
		j2204447049 -> j2262110590;
	j2262110590 [label="Ballas liebte Margulis. Mit ganzem Herzen, vollkommen – mit absoluter Hingabe. Er hätte alles und jeden für sie geopfert. Seine Seele, seinen Körper, das Imperium der Orokin. Alles, wovon man nur träumen konnte.",shape=box,color=blue];
		j2262110590 -> j1641936604;
	j1641936604 [label="Kein Preis war zu hoch. Keine Moralvorstellungen, zu wertvoll, geopfert zu werden. Hättest du ihm ein Neugeborenes in die Hand gedrückt und gesagt, Margulis will dessen Hirn auf den Felsen zerschmettert, wäre es tot gewesen, bevor du den Satz beendet hättest.",shape=box,color=blue];
		j1641936604 -> j2424953312;
	j2424953312 [label="Er hätte das Ursprungssystem in Schutt und Asche gelegt und es nach ihrem Ebenbild wieder aufgebaut, Usurpator ... aber genau darin liegt die Tragödie.",shape=box,color=blue];
		j2424953312 -> j4239297639;
	j4239297639 [label="Margulis? Ach, Margulis. Die liebe, süße, wahrhaftige Margulis ... sie hatte noch ein Gewissen.",shape=box,color=blue];
		j4239297639 -> j3817776801;
	j3817776801 [label="Und als sie die armen Tenno sah, die armen, vom Void zerrissenen Kinder ...",shape=box,color=blue];
		j3817776801 -> j3311211090;
	j3311211090 [label="War etwas in ihrem Leben wichtiger als Ballas. Etwas in ihrem Leben war es wert, ihr Leben dafür zu opfern ... und das war nicht er.",shape=box,color=blue];
		j3311211090 -> j2434865431;
	j2434865431 [label="Es war nicht ihre Liebe zu ihm.",shape=box,color=blue];
		j2434865431 -> j2112391209;
	j2112391209 [label="Und er wusste das, meine lieber Drifter. Er wusste es von dem Moment an, als Margulis sie sah. Und es wurde endgültig klar, als ihre \"verrückten Tiere\" dafür sorgten, dass sie das Letzte waren, was sie je sah. Oder zumindest besagten das die Gerüchte unter uns Orokin.",shape=box,color=blue];
		j2112391209 -> j4265702136;
	j4265702136 [label="Kannst du dir die Freude der Orokin vorstellen? Zuzusehen, wie die vom Void zerrissenen, tollwütigen Gören Ballas' kostbarer Archimede die Augen ausbrannten?",shape=box,color=blue];
		j4265702136 -> j2664982296;
	j2664982296 [label="Aber ich glaube, es war vorher, genau in dem Moment, als Margulis darum kämpfte, die Tenno zu retten, dass Ballas' Herz in tausend Stücke zerbrach und sich nie wieder erholte.",shape=box,color=blue];
		j2664982296 -> j1621130072;
	j1621130072 [label="Denn er wusste, dass er in seiner eigenen Rolle verdrängt worden war.",shape=box,color=blue];
		j1621130072 -> j2348732240;
	j2348732240 [label="Ich nehme an, deshalb tat er mir leid. Aber was dann geschah? Eine Liebesgeschichte für die Ewigkeit ... und wie sie in einer so tragischen Katastrophe endete.",shape=box,color=blue];
		j2348732240 -> j2215373653;
	j2215373653 [label="Ich wünschte, du hättest sehen können, wie sie einander anlächelten ...",shape=box,color=blue];
		j2215373653 -> j3458302791;
		j2215373653 -> j2166713289;
	j3458302791 [label="Man kann ihre Beziehung verklären, aber das entschuldigt nicht, wer er war. Ballas kann nicht vergeben werden, was alles, was er getan hat.",shape=box,color=red];
		j3458302791 -> j857843834;
	j2166713289 [label="Ich bin froh, dass ihre Liebe echt war. Dass er damals ... kompliziert war. Und dass Margulis nicht die ganze Zeit nur ausgenutzt wurde.",shape=box,color=red];
		j2166713289 -> j3566595112;
	j857843834 [label="Add 1 to Thermostat counter",color=orange];
		j857843834 -> j3604633779;
	j3566595112 [label="Add -1 to Thermostat counter",color=orange];
		j3566595112 -> j1103503324;
	j3604633779 [label="+10 Chemistry",color=orange];
		j3604633779 -> j4013331301;
	j1103503324 [label="+10 Chemistry",color=orange];
		j1103503324 -> j3701940223;
	j4013331301 [label="Ich habe auch nicht versucht, die beiden gleichzusetzen, Usurpator. Ich habe lediglich gesagt, dass ein Mann geliebt werden kann, aber auch zu schrecklichen Dingen fähig ist. Nun ja ... Keine Hoffnung mehr für uns verdorbene Narren, nehme ich an ...",shape=box,color=blue];
		j4013331301 -> j1057584426;
	j3701940223 [label="In der Tat. Manchmal beruhigt mich der Gedanke, dass, wenn selbst dieser Meister der Verderbtheit eine Gefährtin finden kann, es auch für uns anderen noch Hoffnung gibt, hm? Ha!",shape=box,color=blue];
		j3701940223 -> j1057584426;
	j1057584426 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j1057584426 -> j1903537845;
	j1903537845 [label="Aber ich habe dich für heute genug aufgehalten. Auf mit dir, los.",shape=box,color=blue];
		j1903537845 -> "Chat ends.";
}