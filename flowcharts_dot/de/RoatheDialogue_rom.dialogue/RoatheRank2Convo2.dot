	j1333843191 [label="Hm, ja. Nun, du hattest vermutlich noch nie mit einem anderen Protoframe zu tun, dessen Erinnerungen so ... zersplittert sind wie meine. Insofern habe ich wohl ein gewisses Verständnis dafür.",shape=box,color=blue];
		j1333843191 -> j2378827931;
	j3167535063 [label="Ah, verstehe ... gewohnt, das ohne Konsequenzen zu tun. Nun, wahrscheinlich hattest du es noch nie mit einem anderen Protoframe zu tun, dessen Erinnerungen ... so zersplittert sind wie meine.",shape=box,color=blue];
		j3167535063 -> j2378827931;
