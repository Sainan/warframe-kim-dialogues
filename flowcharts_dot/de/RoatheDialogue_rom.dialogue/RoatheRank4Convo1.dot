	j3652665456 [label="Boolean RoatheTraitor1 is now true.",color=orange];
		j3652665456 -> j2665161490;
		j3652665456 -> j129698615;
	j2501810582 [label="Du nennst mich immer wieder \"Usurpator\". Soll das eine Beleidigung sein?",shape=box,color=red];
		j2501810582 -> j3237481166;
	j3138375044 [label="Boolean RoatheUsurper is now true.",color=orange];
		j3138375044 -> j361752448;
	j3417817511 [label="Ich sage nur, dass es ziemlich dreist von dir ist, das als Beleidigung zu verwenden, wenn du selbst der gleichen Tat schuldig bist.",shape=box,color=red];
		j3417817511 -> j2595198708;
	j3969726408 [label="Ich versuche nur herauszufinden, warum du das immer wieder als Titel für mich verwendest.",shape=box,color=red];
		j3969726408 -> j97648464;
	j3237481166 [label="Ha! Wohl kaum! Du bist extrem geduldig, wenn du glaubst, ich hätte dich jetzt schon tagelang so beiläufig verspottet. ",shape=box,color=blue];
		j3237481166 -> j2389195802;
	j361752448 [label="Nun, das bist du doch, oder? Die Tenno haben das Ursprungssystem den Orokin entrissen. Und du, wie ein kleines Windei im Nest, hast dich aus deiner eigenen Welt in diese eingeschlichen.",shape=box,color=blue];
		j361752448 -> j242966629;
	j2595198708 [label="Ha! Eine Beleidigung? Du bist extrem geduldig, wenn du glaubst, ich hätte dich jetzt schon tagelang so beiläufig verspottet.",shape=box,color=blue];
		j2595198708 -> j1583718725;
	j97648464 [label="+5 Chemistry",color=orange];
		j97648464 -> j1216799052;
	j2389195802 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2389195802 -> j1802085951 [label=true,color=green];
		j2389195802 -> j1158242838 [label=false,color=brown];
	j242966629 [label="Und das macht dich in meinen Augen mindestens in zweierlei Hinsicht zu einem Usurpator. (Und vielleicht in einem dritten Punkt, wenn wir das mitzählen, was mir der Butler über Duviri erzählt hat, aber das ist ein Thema für ein anderes Mal.)",shape=box,color=blue];
		j242966629 -> j878244577;
		j242966629 -> j1688955691;
	j1583718725 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1583718725 -> j3272437617 [label=true,color=green];
		j1583718725 -> j634567661 [label=false,color=brown];
	j1216799052 [label="Denn genau das ist es – ein Titel. Eine Ehrenbezeichnung. Du hast erreicht, was ich angestrebt habe.",shape=box,color=blue];
		j1216799052 -> j1770862175;
	j1802085951 [label="Vor allem, wenn doch so schmerzlich deutlich ist, dass du in dieser Situation so viel Macht hast, die kaum einseitig ist, hm?",shape=box,color=blue];
		j1802085951 -> j2114461463;
	j1158242838 [label="Vor allem, wenn ich weiß, dass du deine vom Void verliehenen Kräfte einfach nutzen könntest, um durch die Wand zu treten und mir jederzeit ein paar Kugeln in den Hinterkopf zu jagen.",shape=box,color=blue];
		j1158242838 -> j2114461463;
	j878244577 [label="Also ... beleidigst du mich.",shape=box,color=red];
		j878244577 -> j2595198708;
	j1688955691 [label="Okay. Warum benutzt du das weiter als Titel?",shape=box,color=red];
		j1688955691 -> j97648464;
	j3272437617 [label="Vor allem, wenn doch so schmerzlich deutlich ist, dass du in dieser Situation so viel Macht hast, die kaum einseitig ist, hm?",shape=box,color=blue];
		j3272437617 -> j3521215469;
	j634567661 [label="Vor allem, wenn ich weiß, dass du deine vom Void verliehenen Kräfte einfach nutzen könntest, um durch die Wand zu treten und mir jederzeit ein paar Kugeln in den Hinterkopf zu jagen.",shape=box,color=blue];
		j634567661 -> j3521215469;
	j1770862175 [label="Der Titel ist lediglich Ausdruck meiner verhaltenen Bewunderung. Auch wenn er meinen Bedürfnissen entsprechend sarkastisch ist, ja, das gebe ich zu.",shape=box,color=blue];
		j1770862175 -> j1653012846;
		j1770862175 -> j3283532288;
		j1770862175 -> j1727091490;
		j1770862175 -> j1285260581;
	j2114461463 [label="Ich habe keine Lust, dich zum Feind zu machen, Usurpator. Nein. Das ist keine Beleidigung. Aufgrund deiner eigenen Nachlässigkeit hast du nicht erkannt, wie viele Parallelen zwischen meiner Vergangenheit und deiner bestehen.",shape=box,color=blue];
		j2114461463 -> j682050250;
	j3521215469 [label="Ich habe keine Lust, dich zum Feind zu machen, Usurpator. Nein. Wenn überhaupt, ist es eine Ehrenbezeichnung. Du hast erreicht, was ich anstrebte. Nicht mehr und nicht weniger.",shape=box,color=blue];
		j3521215469 -> j1770862175;
	j1653012846 [label="Waren alle Orokin so wie du?",shape=box,color=red];
		j1653012846 -> j2404504540;
	j3283532288 [label="Wenn ich dich freundlich bitte, mich anders zu nennen, würdest du es machen?",shape=box,color=red];
		j3283532288 -> j1349434016;
	j1727091490 [label="Ich werde es ertragen.",shape=box,color=red];
		j1727091490 -> j2219839681;
	j1285260581 [label="Hört auf, mich Usurpator zu nennen.",shape=box,color=red];
		j1285260581 -> j873700753;
	j682050250 [label="Ich war fest entschlossen, die Orokin zu stürzen, genau wie dein Tenno-Kind-Klon und seinesgleichen. Ich wurde einfach aus der Zeitlinie gerissen, bevor ich meine Chance hatte.",shape=box,color=blue];
		j682050250 -> j3946278214;
	j2404504540 [label="+10 Chemistry",color=orange];
		j2404504540 -> j2534473206;
	j1349434016 [label="+5 Chemistry",color=orange];
		j1349434016 -> j2764305974;
	j2219839681 [label="+5 Chemistry",color=orange];
		j2219839681 -> j2601174751;
	j873700753 [label="Hm ...",shape=box,color=blue];
		j873700753 -> j445861799;
	j3946278214 [label="Boolean RoatheTraitor1 is now true.",color=orange];
		j3946278214 -> j1770862175;
	j2534473206 [label="Ha! Ich konnte fast das Seufzen aus dem Sanctum hören. Waren sie alle wie ich? Nein. Sie waren weitaus unterlegen. Und noch viel nerviger, fürchte ich.",shape=box,color=blue];
		j2534473206 -> j2392671004;
	j2764305974 [label="Hm ... nein. Aber ich schätze deine angemessenen Umgangsformen. Du musst dir deine Titel von mir verdienen, Usurpator. Das weißt du.",shape=box,color=blue];
		j2764305974 -> j2392671004;
	j2601174751 [label="Gut. Du hast in dieser Angelegenheit ohnehin keine Wahl.",shape=box,color=blue];
		j2601174751 -> j2392671004;
	j445861799 [label="Nein.",shape=box,color=blue];
		j445861799 -> j2392671004;
	j2392671004 [label="+5 Chemistry",color=orange];
		j2392671004 -> j1926818929;
	j1926818929 [label="Echt, du machst das Ganze viel zu unterhaltsam.",shape=box,color=blue];
