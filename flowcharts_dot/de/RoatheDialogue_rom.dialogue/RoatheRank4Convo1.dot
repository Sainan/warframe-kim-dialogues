	2360 [label="Update boolean RoatheTraitor1",color=orange];
		2360 -> 2353;
		2360 -> 2366;
	2358 [label="Du nennst mich immer wieder \"Usurpator\". Soll das eine Beleidigung sein?",shape=box,color=red];
		2358 -> 2364;
	2359 [label="[Ende.]",shape=box,color=red];
		2359 -> 2365;
	2361 [label="Update boolean RoatheUsurper",color=orange];
		2361 -> 2367;
	2362 [label="Ich sage nur, dass es ziemlich dreist von dir ist, das als Beleidigung zu verwenden, wenn du selbst der gleichen Tat schuldig bist.",shape=box,color=red];
		2362 -> 2368;
	2363 [label="Ich versuche nur herauszufinden, warum du das immer wieder als Titel für mich verwendest.",shape=box,color=red];
		2363 -> 2369;
	2366 [label="[Ende.]",shape=box,color=red];
		2366 -> 2371;
	2364 [label="Ha! Wohl kaum! Du bist extrem geduldig, wenn du glaubst, ich hätte dich jetzt schon tagelang so beiläufig verspottet. ",shape=box,color=blue];
		2364 -> 2370;
	2365 [label="Chat ends.",color=orange];
	2367 [label="Nun, das bist du doch, oder? Die Tenno haben das Ursprungssystem den Orokin entrissen. Und du, wie ein kleines Windei im Nest, hast dich aus deiner eigenen Welt in diese eingeschlichen.",shape=box,color=blue];
		2367 -> 2372;
	2368 [label="Ha! Eine Beleidigung? Du bist extrem geduldig, wenn du glaubst, ich hätte dich jetzt schon tagelang so beiläufig verspottet.",shape=box,color=blue];
		2368 -> 2373;
	2369 [label="+5 Chemistry",color=orange];
		2369 -> 2374;
	2371 [label="Chat ends.",color=orange];
	2370 [label="Check boolean RoatheKnowsReset2",color=orange];
		2370 -> 2375 [label=true,color=green];
		2370 -> 2376 [label=false,color=brown];
	2372 [label="Und das macht dich in meinen Augen mindestens in zweierlei Hinsicht zu einem Usurpator. (Und vielleicht in einem dritten Punkt, wenn wir das mitzählen, was mir der Butler über Duviri erzählt hat, aber das ist ein Thema für ein anderes Mal.)",shape=box,color=blue];
		2372 -> 2377;
		2372 -> 2378;
	2373 [label="Check boolean RoatheKnowsReset2",color=orange];
		2373 -> 2380 [label=true,color=green];
		2373 -> 2379 [label=false,color=brown];
	2374 [label="Denn genau das ist es – ein Titel. Eine Ehrenbezeichnung. Du hast erreicht, was ich angestrebt habe.",shape=box,color=blue];
		2374 -> 2381;
	2375 [label="Vor allem, wenn doch so schmerzlich deutlich ist, dass du in dieser Situation so viel Macht hast, die kaum einseitig ist, hm?",shape=box,color=blue];
		2375 -> 2382;
	2376 [label="Vor allem, wenn ich weiß, dass du deine vom Void verliehenen Kräfte einfach nutzen könntest, um durch die Wand zu treten und mir jederzeit ein paar Kugeln in den Hinterkopf zu jagen.",shape=box,color=blue];
		2376 -> 2382;
	2377 [label="Also ... beleidigst du mich.",shape=box,color=red];
		2377 -> 2368;
	2378 [label="Okay. Warum benutzt du das weiter als Titel?",shape=box,color=red];
		2378 -> 2383;
	2380 [label="Vor allem, wenn doch so schmerzlich deutlich ist, dass du in dieser Situation so viel Macht hast, die kaum einseitig ist, hm?",shape=box,color=blue];
		2380 -> 2384;
	2379 [label="Vor allem, wenn ich weiß, dass du deine vom Void verliehenen Kräfte einfach nutzen könntest, um durch die Wand zu treten und mir jederzeit ein paar Kugeln in den Hinterkopf zu jagen.",shape=box,color=blue];
		2379 -> 2384;
	2381 [label="Der Titel ist lediglich Ausdruck meiner verhaltenen Bewunderung. Auch wenn er meinen Bedürfnissen entsprechend sarkastisch ist, ja, das gebe ich zu.",shape=box,color=blue];
		2381 -> 2385;
		2381 -> 2386;
		2381 -> 2387;
		2381 -> 2388;
	2382 [label="Ich habe keine Lust, dich zum Feind zu machen, Usurpator. Nein. Das ist keine Beleidigung. Aufgrund deiner eigenen Nachlässigkeit hast du nicht erkannt, wie viele Parallelen zwischen meiner Vergangenheit und deiner bestehen.",shape=box,color=blue];
		2382 -> 2389;
	2383 [label="+5 Chemistry",color=orange];
		2383 -> 2374;
	2384 [label="Ich habe keine Lust, dich zum Feind zu machen, Usurpator. Nein. Wenn überhaupt, ist es eine Ehrenbezeichnung. Du hast erreicht, was ich anstrebte. Nicht mehr und nicht weniger.",shape=box,color=blue];
		2384 -> 2381;
	2385 [label="Waren alle Orokin so wie du?",shape=box,color=red];
		2385 -> 2390;
	2386 [label="Wenn ich dich freundlich bitte, mich anders zu nennen, würdest du es machen?",shape=box,color=red];
		2386 -> 2391;
	2387 [label="Ich werde es ertragen.",shape=box,color=red];
		2387 -> 2392;
	2388 [label="Hört auf, mich Usurpator zu nennen.",shape=box,color=red];
		2388 -> 2393;
	2389 [label="Ich war fest entschlossen, die Orokin zu stürzen, genau wie dein Tenno-Kind-Klon und seinesgleichen. Ich wurde einfach aus der Zeitlinie gerissen, bevor ich meine Chance hatte.",shape=box,color=blue];
		2389 -> 2394;
	2390 [label="+10 Chemistry",color=orange];
		2390 -> 2395;
	2391 [label="+5 Chemistry",color=orange];
		2391 -> 2396;
	2392 [label="+5 Chemistry",color=orange];
		2392 -> 2397;
	2393 [label="Hm ...",shape=box,color=blue];
		2393 -> 2398;
	2394 [label="Update boolean RoatheTraitor1",color=orange];
		2394 -> 2381;
	2395 [label="Ha! Ich konnte fast das Seufzen aus dem Sanctum hören. Waren sie alle wie ich? Nein. Sie waren weitaus unterlegen. Und noch viel nerviger, fürchte ich.",shape=box,color=blue];
		2395 -> 2399;
	2396 [label="Hm ... nein. Aber ich schätze deine angemessenen Umgangsformen. Du musst dir deine Titel von mir verdienen, Usurpator. Das weißt du.",shape=box,color=blue];
		2396 -> 2399;
	2397 [label="Gut. Du hast in dieser Angelegenheit ohnehin keine Wahl.",shape=box,color=blue];
		2397 -> 2399;
	2398 [label="Nein.",shape=box,color=blue];
		2398 -> 2399;
	2399 [label="+5 Chemistry",color=orange];
