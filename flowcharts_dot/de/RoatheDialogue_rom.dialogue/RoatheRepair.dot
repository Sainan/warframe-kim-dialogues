digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRepair begins." [color=orange];
		"RoatheRepair begins." -> j2688688654;
	j2688688654 [label="Evaluate expressions",color=orange];
		j2688688654 -> j2912801068 [label="LyonRoatheFailFix & MarieRoatheFailFix",color=purple];
		j2688688654 -> "Chat ends." [label="false",color=purple];
	j2912801068 [label="Genug! Genug! Ich gebe auf! Ruf deine fanatischen Eiferer zurück! Sie sind schlimmer als tollwütige Kubrodons! Diese verdammten Kreaturen verfolgen mich auf Schritt und Tritt. Ich kann nicht einmal mehr schlafen!",shape=box,color=blue];
		j2912801068 -> j3969901623;
	"Chat ends." [color=orange];
	j3969901623 [label="Was?! Was willst du?!",shape=box,color=blue];
		j3969901623 -> j2761369059;
		j3969901623 -> j2101712558;
		j3969901623 -> j3995910283;
	j2761369059 [label="Eine weitere Gelegenheit, mit dir über die Einnahme des Serums zu sprechen. Roathe, es ist Zeit, mit dem Wegrennen aufzuhören.",shape=box,color=red];
		j2761369059 -> j1979205857;
	j2101712558 [label="Roathe. Die Einnahme des Serums macht dich nicht zum Feigling. Sie macht dich zum einzigen noch lebenden Orokin. Akzeptiere es.",shape=box,color=red];
		j2101712558 -> j1420398166;
	j3995910283 [label="Roathe. Die Einnahme des Serums macht dich nicht zum Feigling. Sie gibt dir eine zweite Chance zu leben. Wirklich etwas zu verändern.",shape=box,color=red];
		j3995910283 -> j62611055;
	j1979205857 [label="Evaluate expressions on Thermostat counter",color=orange];
		j1979205857 -> j2045284172 [label="x >= 5",color=purple];
		j1979205857 -> j1320919817 [label="x <= 0",color=purple];
		j1979205857 -> j3911658614 [label="x > 0 && x < 5",color=purple];
		j1979205857 -> j3911658614 [label="false",color=purple];
	j1420398166 [label="Add -5 to Thermostat counter",color=orange];
		j1420398166 -> j1979205857;
	j62611055 [label="Add 5 to Thermostat counter",color=orange];
		j62611055 -> j1979205857;
	j2045284172 [label="Du lässt zu, dass diese Wut dich innerlich zerfrisst. Du könntest sie nutzen, um gegen diejenigen anzukämpfen, die diese Welt weiterhin zerstören. Hier. Jetzt.",shape=box,color=red];
		j2045284172 -> j152940070;
	j1320919817 [label="Du richtest sie gegen dich selbst. Du solltest sie gegen die Welt richten, die dich dafür verantwortlich macht, dass du dein Bestes getan hast, um sie vor dem Imperium der Orokin zu retten.",shape=box,color=red];
		j1320919817 -> j3367642279;
	j3911658614 [label="Deshalb hast du sie also dazu gebracht, mich Tag und Nacht zu belästigen? Dafür? Ein letzter verzweifelter Versuch, mich dazu zu bringen, deinem jämmerlichen Argument zuzuhören?",shape=box,color=blue];
		j3911658614 -> j1018426855;
	j152940070 [label="Du wirst nicht durch deine Vergangenheit definiert, Roathe. Du wirst durch deine Zukunft definiert. Und du hast noch eine Zukunft vor dir, anders als all die Orokin, die in der Nacht der Naga-Trommeln starben.",shape=box,color=red];
		j152940070 -> j3199943104;
	j3367642279 [label="Du wirst nicht durch die Meinungen jener um dich herum definiert. Auch nicht durch das, was sie über deine Handlungen denken. Du wirst allein durch das definiert, was du über dich selbst und deine Entscheidungen glaubst.",shape=box,color=red];
		j3367642279 -> j3177320432;
	j1018426855 [label="Nein.",shape=box,color=blue];
		j1018426855 -> j4065502984;
	j3199943104 [label="Das ist das Einzige, was dich jetzt noch ausmacht. Du kannst dich ändern. Und du kannst die Welt um dich herum ändern. Meine einzige Frage ist: Wirst du es wenigstens versuchen?",shape=box,color=red];
		j3199943104 -> j2963997522;
	j3177320432 [label="Und die einfache Wahrheit ist: Du bist einer der wenigen Orokin, die wir kennen, der die Nacht der Naga-Trommeln überlebt hat. Aus meiner Sicht war es ein strategischer Rückzug.",shape=box,color=red];
		j3177320432 -> j873634418;
	j4065502984 [label="Dein Versagen ist erbärmlich. Nicht nur einmal, sondern jetzt schon zum zweiten Mal.",shape=box,color=blue];
		j4065502984 -> j2131978098;
	j2963997522 [label="Versuche, dir selbst zu vergeben und nach vorn zu blicken?",shape=box,color=red];
		j2963997522 -> j3772843709;
	j873634418 [label="Nicht mehr. Nicht weniger.",shape=box,color=red];
		j873634418 -> j1646833742;
	j2131978098 [label="Ich rate davon ab, für ein öffentliches Amt zu kandidieren.",shape=box,color=blue];
		j2131978098 -> "Chat ends.";
	j3772843709 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j3772843709 -> j3098011055;
	j1646833742 [label="Boolean RoatheVillain is now true.",color=orange];
		j1646833742 -> j1232238893;
	j3098011055 [label="+20 Chemistry",color=orange];
		j3098011055 -> j2032380867;
	j1232238893 [label="+20 Chemistry",color=orange];
		j1232238893 -> j705744632;
	j2032380867 [label="Mir selbst vergeben für das, was ich getan habe? Und voraus in die Zukunft blicken? Hm.",shape=box,color=blue];
		j2032380867 -> j2907449182;
	j705744632 [label="Ein Rückzug, um den Krieg zu gewinnen. Hm.",shape=box,color=blue];
		j705744632 -> j4004739278;
	j2907449182 [label="Obwohl ich ... etwas skeptisch bin, was deine Umdeutung der Situation angeht, finde ich ... diese neue Zukunft und was sie mir bringen könnte, zu verlockend, um zu widerstehen, Drifter Lieber.",shape=box,color=blue];
		j2907449182 -> j2470826637;
	j4004739278 [label="Obwohl ich ... etwas skeptisch bin, was deine Umdeutung der Ereignisse als taktischen Rückzug angeht, gebe ich zu, dass ich ... trotzdem dafür bin, Drifter Lieber.",shape=box,color=blue];
		j4004739278 -> j1762250295;
	j2470826637 [label="Dieser \"neue Lebensabschnitt\". Nun gut. Ich gebe nach und akzeptiere deine Argumentation. Auch wenn es spät kommt, war es dennoch ... effektiv.",shape=box,color=blue];
		j2470826637 -> j1884289086;
	j1762250295 [label="Gut. Ich gebe dir Recht und akzeptiere deine Argumentation. Auch wenn es spät kommt, war es dennoch ... effektiv.",shape=box,color=blue];
		j1762250295 -> j1884289086;
	j1884289086 [label="Ich weiß das zu schätzen. Mehr, als du vielleicht ahnst.",shape=box,color=blue];
		j1884289086 -> j757561088;
	j757561088 [label="Boolean RoatheFail is now false.",color=orange];
		j757561088 -> j2141078128;
	j2141078128 [label="Boolean RoatheFamilyFail is now false.",color=orange];
		j2141078128 -> j313480356;
	j313480356 [label="Boolean RoatheFailStall is now false.",color=orange];
		j313480356 -> j3136897973;
	j3136897973 [label="Check boolean LoidFamilyComplete",color=orange];
		j3136897973 -> "Chat ends." [label=true,color=green];
		j3136897973 -> j525241223 [label=false,color=brown];
	j525241223 [label="Und nun, denke ich, können wir uns unserem nächsten Kampf im Krieg zuwenden, ja? Dem Butler.",shape=box,color=blue];
		j525241223 -> j120412006;
	j120412006 [label="Ich für meinen Teil kann es kaum erwarten.",shape=box,color=blue];
		j120412006 -> j1288719760;
	j1288719760 [label="Boolean RoatheFamilyDelay is now true.",color=orange];
		j1288719760 -> "Chat ends.";
}