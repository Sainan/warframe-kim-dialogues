	1466 [label="Chat ends.",color=orange];
	1468 [label="Warum fragst du mich das? Was willst du damit herausfinden, Drifter? Sicherlich nicht den Standort von Munition.",shape=box,color=blue];
		1468 -> 1470;
	1469 [label="Warum? Planst du, in die Vergangenheit zu reisen und den Rekord deines jüngeren Ichs zu brechen? Brauchst du Rat, wie du eine totalitäre Staatsführung stürzen kannst? Suchst den Standort vergrabener Munition, die ganze Planeten zerstören könnte?",shape=box,color=blue];
		1469 -> 1471;
	1470 [label="Warum sollte ich dir vertrauen? Warum habe ich dir überhaupt vertraut?!",shape=box,color=blue];
		1470 -> 1472;
	1471 [label="Oder willst du nur etwas plaudern?",shape=box,color=blue];
		1471 -> 1473;
		1471 -> 1474;
		1471 -> 1475;
	1472 [label="Check boolean RoatheResetForgiven",color=orange];
		1472 -> 1477 [label=true,color=green];
		1472 -> 1476 [label=false,color=brown];
	1473 [label="Ich bin ehrlich gesagt neugierig, ob du irgendetwas davon bereust. Ob du im Nachhinein etwas an deinen Plänen ändern würdest.",shape=box,color=red];
		1473 -> 1478;
	1474 [label="Ich bin fasziniert von der Vorstellung, wie es gewesen sein muss, einen solchen Plan zu entwickeln. Es muss ein Meisterwerk gewesen sein.",shape=box,color=red];
		1474 -> 1479;
	1475 [label="Es wäre ehrlich gesagt gut zu wissen, ob du irgendwelche dieser Waffen irgendwo versteckt hast, wo sie noch zugänglich sind.",shape=box,color=red];
		1475 -> 1480;
	1477 [label="Ich habe dir vergeben. Ich wünschte nur, ich könnte mich erinnern, warum – warum nur! Warum ausgerechnet du?!",shape=box,color=blue];
		1477 -> 1483;
		1477 -> 1481;
	1476 [label="Warum! Warum ausgerechnet du?!",shape=box,color=blue];
		1476 -> 1481;
		1476 -> 1482;
	1478 [label="Add 1 to Thermostat",color=orange];
		1478 -> 1484;
	1479 [label="Add -1 to Thermostat",color=orange];
		1479 -> 1485;
	1480 [label="+5 Chemistry",color=orange];
		1480 -> 1486;
	1483 [label="Ich weiß. Und es tut mir wirklich leid.",shape=box,color=red];
		1483 -> 1489;
	1481 [label="Ich versuche, dich an einen Punkt zu bringen, an dem du weißt, warum.",shape=box,color=red];
		1481 -> 1487;
	1482 [label="Es tut mir wirklich leid, dein Vertrauen missbraucht zu haben, Roathe. Das war nicht Absicht, glaub es oder nicht.",shape=box,color=red];
		1482 -> 1488;
	1484 [label="Ich bedauere nur, dass es nie zustande kam. Ich bereue die verschwendete Zeit.",shape=box,color=blue];
		1484 -> 1490;
	1485 [label="Ein Meisterwerk war es in der Tat, Usurpator.",shape=box,color=blue];
		1485 -> 1490;
	1486 [label="Praktisch. Aber viele der Orte, an denen ich meine Vorräte \"versteckt\" habe, sind wahrscheinlich in den vielen, vielen Jahren, die vergangen sind ... verschwunden.",shape=box,color=blue];
		1486 -> 1491;
	1489 [label="Ja, ja. Ich denke, wir sollten diese alberne Unterhaltung fortsetzen und unsere früheren Gespräche noch einmal aufwärmen.",shape=box,color=blue];
		1489 -> 1493;
	1487 [label="+5 Chemistry",color=orange];
		1487 -> 1492;
	1488 [label="Ja, du hast wahrscheinlich geglaubt, deine Handlungen hätten keine Konsequenzen. Dennoch, wir sollten diese alberne Unterhaltung fortsetzen, in der wir unsere früheren selbst erneuern, und einfach weitermachen.",shape=box,color=blue];
		1488 -> 1493;
	1490 [label="+5 Chemistry",color=orange];
		1490 -> 1494;
	1491 [label="Und viele davon waren selbst mir geheim. Der Plan war mehr als nur komplex. Schicht um Schicht um Schicht.",shape=box,color=blue];
		1491 -> 1495;
	1493 [label="Wie war deine Frage noch mal? Ach ja. \"Wie hatte ich vor, die Exekutoren zu stürzen?\"",shape=box,color=blue];
		1493 -> 1496;
	1492 [label="Indem ich immer wieder dieselben sinnlosen Gespräche darüber führe, warum ich Menschen ermorden wollte, die längst tot und zu Staub zerfallen sind? Zumindest ist das der pragmatische Ansatz.",shape=box,color=blue];
		1492 -> 1493;
	1494 [label="Der Plan war mehr als nur komplex. Er reichte über viele Ebenen. Attentäter, die die Attentäter anderer Attentäter töten würden, sollte der erste Attentäter scheitern.",shape=box,color=blue];
		1494 -> 1497;
	1495 [label="Attentäter, die die Attentäter anderer Attentäter töten würden, falls der erste Attentäter scheitern sollte.",shape=box,color=blue];
		1495 -> 1497;
	1496 [label="Warum?",shape=box,color=blue];
		1496 -> 1473;
		1496 -> 1474;
		1496 -> 1475;
	1497 [label="Bomben platziert in mehreren Gebäuden, ganze Schiffe und ein ganzer Mond mit gestohlenem Sprengstoff präpariert. Eine Solarschiene, die kurz davor war, aus ihrer Umlaufbahn zu stürzen.",shape=box,color=blue];
		1497 -> 1498;
	1498 [label="Und das alles war so inszeniert, dass es zum gegebenen Zeitpunkt wie eine \"Große Katastrophe der Sentients\" aussehen würd. Nitokh und ich hätten den Ausnahmezustand über das Imperium ausgerufen, sobald die Exekutoren und Herrscher ... erledigt waren.",shape=box,color=blue];
		1498 -> 1499;
	1499 [label="Update boolean RoatheTraitor2",color=orange];
		1499 -> 1500;
	1500 [label="Check boolean RoatheExecutor1",color=orange];
		1500 -> 1501 [label=true,color=green];
		1500 -> 1502 [label=true,color=green];
		1500 -> 1503 [label=true,color=green];
		1500 -> 1501 [label=false,color=brown];
		1500 -> 1502 [label=false,color=brown];
	1501 [label="Was, wenn dein Plan nicht funktioniert hätte?",shape=box,color=red];
		1501 -> 1504;
	1502 [label="Und was wolltest du dann tun?",shape=box,color=red];
		1502 -> 1505;
	1503 [label="Was hattest bezüglich Nitokh vor?",shape=box,color=red];
		1503 -> 1506;
	1504 [label="Es war eines von vielen tausend möglichen Ergebnissen, für das ich einen Plan hatte.",shape=box,color=blue];
		1504 -> 1507;
	1505 [label="Es gab tausend mögliche Ergebnisse für unser Vorhaben. Für jede Variable wurde eine mögliche Verlaufsvariante erstellt.",shape=box,color=blue];
		1505 -> 1508;
	1506 [label="Check boolean RoatheKnowsReset2",color=orange];
		1506 -> 1510 [label=true,color=green];
		1506 -> 1509 [label=false,color=brown];
	1507 [label="Wenn wir grandios gescheitert wären, hätte ich einfach das Ende eines Lex gegessen und den Tag damit abgeschlossen.",shape=box,color=blue];
		1507 -> 1511;
	1508 [label="Und für jede einzelne hatte ich ein Resultat festgelegt. Und für jedes einzelne hatte ich eine Vorgehensweise. Viele ähnelten sich in ihren Grundzügen, unterschieden sich aber in den Details.",shape=box,color=blue];
		1508 -> 1512;
	1510 [label="Was habe ich dir zuvor darüber erzählt? Denn ich vertraue dir noch nicht genug, um es dir ganz einfach zu erzählen.",shape=box,color=blue];
		1510 -> 1515;
		1510 -> 1516;
	1509 [label="Es war eine komplexe Angelegenheit, die einige ... intensive Verhandlungen zwischen uns erforderte.",shape=box,color=blue];
		1509 -> 1513;
		1509 -> 1514;
	1511 [label="Es hätte keinen Sinn gehabt, über verschüttetes Kuva und dergleichen zu heulen.",shape=box,color=blue];
		1511 -> 1517;
		1511 -> 1518;
	1512 [label="Wenn wir grandios gescheitert wären, hätte ich einfach das Ende eines Lex gegessen und den Tag damit abgeschlossen.",shape=box,color=blue];
		1512 -> 1519;
	1515 [label="Du hast mir alles erzählt.",shape=box,color=red];
		1515 -> 1522;
	1516 [label="Dann werde ich dich nicht drängen, mir mehr zu erzählen, als du möchtest.",shape=box,color=red];
		1516 -> 1523;
	1513 [label="In diesem Satz ist vieles vergraben.",shape=box,color=red];
		1513 -> 1520;
	1514 [label="Welche Art von Verhandlungen?",shape=box,color=red];
		1514 -> 1521;
	1517 [label="Ich meinerseits wäre geflohen.",shape=box,color=red];
		1517 -> 1524;
	1518 [label="Du hättest einfach den Tod akzeptiert?",shape=box,color=red];
		1518 -> 1525;
	1519 [label="Bei einem mäßigen Erfolg, was am wahrscheinlichsten war, wäre eine Bereinigung nötig gewesen, um sicherzustellen, dass alle losen Enden \"beseitigt\" würden. Natürlich war ich eines dieser Enden. Und ich hatte Vorkehrungen getroffen, um sicherzustellen, dass ich auf kurze Sicht noch zu wertvoll war, um mit dem Rest abgeschnitten zu werden.",shape=box,color=blue];
		1519 -> 1526;
	1522 [label="Dann hat es ja keinen Sinn, dass ich mich jetzt wiederhole, oder? Tatsächlich ist dieses Gespräch eigentlich völlig sinnlos. Ich wünsche dir noch einen schönen Tag.",shape=box,color=blue];
		1522 -> 1529;
	1523 [label="+5 Chemistry",color=orange];
		1523 -> 1530;
	1520 [label="+5 Chemistry",color=orange];
		1520 -> 1527;
	1521 [label="Jede erdenkliche Art.",shape=box,color=blue];
		1521 -> 1528;
	1524 [label="Geflohen wohin, mein Usurpator? Nicht jeder von uns hat Paralleluniversen, in die wir uns in Panik flüchten können.",shape=box,color=blue];
		1524 -> 1531;
	1525 [label="Ich hätte wohl kaum eine andere Wahl gehabt, oder? Ich hätte mich nirgendwo verstecken können.",shape=box,color=blue];
		1525 -> 1531;
	1526 [label="Wenn die Situation ein voller Erfolg gewesen wäre, wäre ich mit der zweiten Phase des Plans fortgefahren.",shape=box,color=blue];
		1526 -> 1532;
		1526 -> 1533;
	1529 [label="Chat ends.",color=orange];
	1530 [label="Gut. Ich kann sagen, es war eine komplexe Angelegenheit, die einige ... intensive Verhandlungen zwischen uns erforderte.",shape=box,color=blue];
		1530 -> 1513;
		1530 -> 1514;
