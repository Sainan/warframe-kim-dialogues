	1624 [label="Wie meinst du das?",shape=box,color=red];
		1624 -> 1640;
	1625 [label="Ich hasste sie nicht alle. Nur einige. Diejenigen, die an der Macht waren. Und deshalb war es am Ende so furchtbar zum Scheitern verurteilt.",shape=box,color=blue];
		1625 -> 1641;
	1626 [label="+5 Chemistry",color=orange];
		1626 -> 1642;
	1627 [label="+5 Chemistry",color=orange];
		1627 -> 1643;
	1628 [label="Denkst du über alle deine Liebhaber so? Oder nur über sie?",shape=box,color=red];
