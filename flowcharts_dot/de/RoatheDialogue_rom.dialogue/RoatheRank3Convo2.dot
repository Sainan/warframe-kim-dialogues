		1534 -> 1539 [label="x < 7",color=purple];
		1534 -> 1539 [label="false",color=purple];
	1535 [label="Und du warst damit einverstanden?",shape=box,color=red];
		1535 -> 1541;
	1536 [label="Es war keine besonders gute Idee, dich zu bedrohen, wenn sie deine Loyalität wollte.",shape=box,color=red];
		1536 -> 1542;
	1537 [label="Natürlich die Ermordung von Nitokh. Kaum eine überraschende Wendung. Sie wusste selbst, dass es wahrscheinlich so kommen würde, und neckte mich regelmäßig damit.",shape=box,color=blue];
		1537 -> 1543;
		1537 -> 1544;
	1538 [label="+5 Chemistry",color=orange];
		1538 -> 1545;
	1540 [label="Wie du weißt, war ich eines ihrer vielen, vielen Spielzeuge.",shape=box,color=blue];
		1540 -> 1548;
	1539 [label="Ich war einer ihrer vielen Partner, musst du verstehen.",shape=box,color=blue];
		1539 -> 1546;
		1539 -> 1547;
	1541 [label="+5 Chemistry",color=orange];
		1541 -> 1549;
	1542 [label="Eines musst du über die Orokin verstehen: Wir haben immer gegeneinander intrigiert.",shape=box,color=blue];
		1542 -> 1550;
	1543 [label="Und sie hatte damit kein Problem?",shape=box,color=red];
		1543 -> 1551;
	1544 [label="Ihr wusstet beide einfach, dass ihr euch gegenseitig umbringen würdet?",shape=box,color=red];
		1544 -> 1552;
	1545 [label="Check boolean RoatheKnowsReset2",color=orange];
		1545 -> 1554 [label=true,color=green];
		1545 -> 1553 [label=false,color=brown];
	1548 [label="Einst glaubte ich, wir seien Partner. In der Politik, in Intrigen, im Bett ...",shape=box,color=blue];
		1548 -> 1557;
	1546 [label="Geschäftspartner?",shape=box,color=red];
		1546 -> 1555;
	1547 [label="Partner, welcher Art?",shape=box,color=red];
		1547 -> 1556;
	1549 [label="Nicht wirklich. Aber eines musst du über die Orokin verstehen: Wir haben ständig gegeneinander intrigiert. ",shape=box,color=blue];
		1549 -> 1550;
	1550 [label="Ich wusste, dass Nitokh mich jederzeit ohne zu zögern töten würde, wenn es ihr auch nur im Geringsten bei der Verfolgung ihrer Ziele helfen könnte.",shape=box,color=blue];
		1550 -> 1558;
	1551 [label="Ich glaube, sie genoss die Herausforderung, Usurpator. Das Gefühl der Gefahr. Den Nervenkitzel, mit jemandem zu schlafen, der sie tot sehen wollte.",shape=box,color=blue];
		1551 -> 1559;
	1552 [label="Ich würde ja gerne so tun, als wären wir die ersten Orokin, die sich in einer solchen Situation wiederfanden, aber so ungewöhnlich war das gar nicht.",shape=box,color=blue];
		1552 -> 1559;
	1554 [label="Genau! Es klingt fast so, als hättest du das schon mal gehört. Kaum eine überraschende Wendung. Sie hat mich damit regelmäßig geärgert.",shape=box,color=blue];
		1554 -> 1543;
		1554 -> 1544;
	1553 [label="Ganz genau! Kaum eine überraschende Wendung. Sie hat es auch kommen sehen, und neckte mich regelmäßig damit.",shape=box,color=blue];
		1553 -> 1543;
		1553 -> 1544;
	1557 [label="Ich glaubte natürlich nicht, dass wir gleichberechtigt waren. Sie war eine Exekutorin. Die große Nitokh. Aber ich hielt mich für die Nummer Eins unter ihren Untergebenen.",shape=box,color=blue];
		1557 -> 1561;
	1555 [label="Du bist süß. Ja, in gewisser Weise waren wir Geschäftspartner. Aber wir waren auch in vielerlei anderer, wichtigerer Hinsicht Partner.",shape=box,color=blue];
		1555 -> 1556;
	1556 [label="Im Krieg. In der Politik. In Intrigen. Im Bett.",shape=box,color=blue];
		1556 -> 1560;
	1558 [label="Doch sie wusste auch, dass ich hinter ihrem Rücken meine Messer schärfte und sehnsüchtig auf den Moment wartete, ihr den Kopf von den Schultern zu trennen.",shape=box,color=blue];
		1558 -> 1562;
	1559 [label="Je länger ich lebe, desto mehr wird mir bewusst, dass wir vielleicht keine Spezies waren, die für die Unsterblichkeit geschaffen wurde.",shape=box,color=blue];
		1559 -> 1563;
	1561 [label="Was für ein Narr ich doch war ...",shape=box,color=blue];
		1561 -> 1565;
		1561 -> 1566;
		1561 -> 1567;
		1561 -> 1568;
		1561 -> 1569;
	1560 [label="Aber ich frage mich, ob meine Erinnerungen mich trügen. Ich frage mich, ob \"Partner\" ein zu starkes Wort für das ist, was wir wirklich waren.",shape=box,color=blue];
		1560 -> 1564;
	1562 [label="Man könnte sagen, dass Nitokh und ich eine ... komplizierte Beziehung hatten.",shape=box,color=blue];
		1562 -> 1569;
		1562 -> 1568;
		1562 -> 1567;
		1562 -> 1565;
		1562 -> 1566;
	1563 [label="Aber ja. Man könnte sagen, dass Nitokh und ich eine ... komplizierte Beziehung hatten.",shape=box,color=blue];
		1563 -> 1569;
		1563 -> 1568;
		1563 -> 1567;
		1563 -> 1565;
		1563 -> 1566;
	1565 [label="War sie dir wichtig?",shape=box,color=red];
		1565 -> 1570;
	1566 [label="Hast du sie geliebt?",shape=box,color=red];
		1566 -> 1571;
	1567 [label="Hast du ihr vertraut?",shape=box,color=red];
		1567 -> 1572;
	1568 [label="Bereue nicht, was du getan hast. Du hast deine Entscheidungen getroffen. Es gibt kein Zurück. Nur vorwärts.",shape=box,color=red];
		1568 -> 1573;
	1569 [label="Das Einzige, was wir tun können, um das, was wir zuvor getan haben, wiedergutzumachen, ist, mit klarem Blick nach vorn zu blicken.",shape=box,color=red];
		1569 -> 1574;
	1564 [label="Sie war schließlich die Große Nitokh. Eine Exekutorin.",shape=box,color=blue];
		1564 -> 1561;
	1570 [label="Zum Void, nein! Wäre sie eines Nachmittags betrunken durch eine Luftschleuse gewandert, hätte das viele meiner verdammten Probleme gelöst.",shape=box,color=blue];
		1570 -> 1575;
	1571 [label="+5 Chemistry",color=orange];
		1571 -> 1576;
	1572 [label="Zum Void, nein! Trau niemals einem Orokin, Drifter. Mich eingeschlossen. Vor allem mir nicht! Liebe uns, hasse uns, verehre uns, verachte uns – aber trau uns niemals, niemals!",shape=box,color=blue];
		1572 -> 1577;
	1573 [label="Add -1 to Thermostat",color=orange];
		1573 -> 1578;
	1574 [label="Add 1 to Thermostat",color=orange];
		1574 -> 1579;
	1575 [label="Ich verabscheute sie zutiefst und hätte nichts lieber getan, als ihre blaue Haut langsam, vorsichtig und sanft mit bloßen Händen von ihrem Körper zu schälen.",shape=box,color=blue];
		1575 -> 1580;
		1575 -> 1581;
	1576 [label="Was für eine unverschämte Frage! Ich bete dich dafür an, dass du sie stellst. Weißt du, ich glaube, ich habe sie wirklich geliebt, nur ein bisschen. Ehrlich gesagt, habe ich darüber bis jetzt noch gar nicht nachgedacht.",shape=box,color=blue];
		1576 -> 1582;
	1577 [label="Wir neigen zu Anfällen von Rastlosigkeit.",shape=box,color=blue];
		1577 -> 1583;
		1577 -> 1584;
	1578 [label="+10 Chemistry",color=orange];
		1578 -> 1585;
	1579 [label="+10 Chemistry",color=orange];
		1579 -> 1586;
	1580 [label="Das war ... anschaulich.",shape=box,color=red];
		1580 -> 1587;
	1581 [label="Und trotzdem hast du mit ihr geschlafen?",shape=box,color=red];
		1581 -> 1588;
	1582 [label="Ja, ich glaube, ich war ein kleines bisschen in sie verknallt. Was für eine merkwürdige Erkenntnis ...",shape=box,color=blue];
		1582 -> 1589;
	1583 [label="Notiert.",shape=box,color=red];
		1583 -> 1590;
	1584 [label="Das wird kein Problem darstellen.",shape=box,color=red];
		1584 -> 1591;
	1585 [label="Du hast vielleicht recht. In der Vergangenheit zu leben ist gefährlich, denn wir belasten uns damit nur mit Bedauern und Scham.",shape=box,color=blue];
		1585 -> 1592;
	1586 [label="Du hast vielleicht recht. In der Vergangenheit zu leben ist gefährlich, denn wir belasten uns damit nur mit Bedauern und Scham.",shape=box,color=blue];
		1586 -> 1593;
	1587 [label="Mir das vorzustellen, war das Einzige, was mir half, viele meiner ... unfreiwilligen Abende in ihrem Bett zu ertragen. Es tut mir leid.",shape=box,color=blue];
		1587 -> 1594;
		1587 -> 1595;
	1588 [label="Dass du glaubst, diese beiden Dinge schließen sich gegenseitig aus, ist geradezu bezaubernd. Ich hoffe, du hast eines Tages die Gelegenheit, einen Abend mit so einer \"Bekanntschaft\" zu verbringen; es ist wirklich magisch.",shape=box,color=blue];
		1588 -> 1596;
	1589 [label="Du musst verstehen, dass es auch von tiefstem und überwältigendstem Hass durchdrungen war. Ich verachtete sie zutiefst und hätte nichts lieber getan, als ihr langsam, vorsichtig und sanft mit bloßen Händen die blaue Haut vom Körper zu schälen.",shape=box,color=blue];
		1589 -> 1597;
		1589 -> 1598;
	1590 [label="Evaluate expressions",color=orange];
		1590 -> 1601 [label="RoatheDatingDeal",color=purple];
		1590 -> 1600 [label="RoatheMarieDatingDeal",color=purple];
		1590 -> 1599 [label="RoatheLyonDatingDeal",color=purple];
		1590 -> 1602 [label="DrifterRoathe",color=purple];
		1590 -> 1604 [label="DrifterMarie",color=purple];
		1590 -> 1603 [label="DrifterLyon",color=purple];
		1590 -> 1605 [label="false",color=purple];
	1591 [label="Hm, klar. Ich habe den Eindruck, dass ich dich mit meinem \"teuflischen Charme\" nicht wirklich für mich gewinne, oder?",shape=box,color=blue];
		1591 -> 1606;
		1591 -> 1607;
	1592 [label="Welchen Zweck hat es, unsere vergangenen Taten, vergangenen Fehler und unsere Reue erneut zu durchleben? Wir können sie nicht ändern – selbst mit dieser Gabe der Zeitreise wäre es nur ein Weg in den Wahnsinn, zu versuchen, das \"Getane\" noch einmal \"rückgängig\" zu machen.",shape=box,color=blue];
		1592 -> 1608;
	1593 [label="Aber wir dürfen auch die Verfehlungen unseres früheren Selbst nicht vergessen, denn wir riskieren, nichts anderes als Wahnsinnige und Despoten zu werden, kriegerische Geschöpfe, die keinen Fehler in sich selbst sehen, sondern nur in anderen.",shape=box,color=blue];
		1593 -> 1609;
	1594 [label="Denkst du über alle deine Liebhaber so? Oder nur über sie?",shape=box,color=red];
		1594 -> 1610;
	1595 [label="Eine Entschuldigung ist nicht nötig. Ich bin einfach immer noch schockiert darüber, wie sehr du dein eigenes Volk gehasst hast.",shape=box,color=red];
		1595 -> 1611;
	1596 [label="Ich rate dir dringend davon ab, solche Beziehungen zu einer dauerhaften Angelegenheit werden zu lassen. Es ist für beide Partner extrem ungesund. Meistens endet es mit Mord, für einen oder beide.",shape=box,color=blue];
		1596 -> 1594;
		1596 -> 1612;
		1596 -> 1613;
	1597 [label="Wie kann beides gleichzeitig wahr sein?",shape=box,color=red];
		1597 -> 1614;
	1598 [label="Das war ... anschaulich.",shape=box,color=red];
		1598 -> 1615;
	1601 [label="Ich dachte nur, ich sollte dich vorwarnen, da wir ja unsere kleine ... Vereinbarung haben.",shape=box,color=blue];
		1601 -> 1618;
	1600 [label="Hm, aber für dich wird das ja nie ein Problem sein, oder? Dein Auge ist längst auf etwas weitaus Näheres gerichtet ... auf Marie, mit unserer kleinen \"Vereinbarung\".",shape=box,color=blue];
		1600 -> 1617;
	1599 [label="Hm, aber für dich wird das ja nie ein Problem sein, oder? Dein Auge ist längst auf etwas weitaus Näheres gerichtet ... auf jenen wahnsinnigen Priester, stimmt’s?",shape=box,color=blue];
		1599 -> 1616;
	1602 [label="Ich dachte nur, ich sollte dich vorwarnen, da du deine ... Interessen bereits geäußert hast.",shape=box,color=blue];
