	1605 [label="+5 Chemistry",color=orange];
		1605 -> 1619;
	1606 [label="Nein. Tut mir leid. Du bist nicht mein Typ.",shape=box,color=red];
		1606 -> 1620;
	1607 [label="Doch schon. Ich traue dir nur nicht.",shape=box,color=red];
		1607 -> 1621;
	1608 [label="Nein. Ich bin, wer ich bin. Ich gehe meinen eigenen Weg und habe den Punkt überschritten, an dem ich mich für mich selbst entschuldigen möchte. Ich werde mich nicht ändern, nur um den Meinungen anderer zu entsprechen.",shape=box,color=blue];
		1608 -> 1622;
	1609 [label="Dies war eine Eigenschaft, die ich bei vielen der ärmsten Exekutoren und Herrscher erkannte – blinder Glaube an ihre eigene Makellosigkeit und Unschuld. Ich verachtete sie dafür und schwor mir, niemals solch egozentrische Anmaßung zu teilen.",shape=box,color=blue];
		1609 -> 1622;
	1610 [label="Ich hatte nur rein körperliche Beziehungen, Drifter. Emotionale Beziehungen hatte ich nie. Zumindest keine, die auf Gegenseitigkeit beruhten.",shape=box,color=blue];
		1610 -> 1623;
		1610 -> 1624;
	1611 [label="+5 Chemistry",color=orange];
		1611 -> 1625;
	1612 [label="Ich werde mir das zu Herzen nehmen.",shape=box,color=red];
		1612 -> 1626;
	1613 [label="Das hatte ich nicht vor, aber danke für den Tipp.",shape=box,color=red];
		1613 -> 1627;
	1614 [label="Dass du so etwas noch nie erlebt hast, ist dein wahres Glück, Usurpator. Ich rate dir dringend davon ab, dich in eine solche Situation zu begeben; sie endet meist mit Mord für einen oder beide.",shape=box,color=blue];
		1614 -> 1628;
		1614 -> 1629;
		1614 -> 1630;
	1615 [label="Mir das vorzustellen, war das Einzige, was mir ermöglichte, so manche lange Sitzung durchzustehen. Ich bitte um Entschuldigung.",shape=box,color=blue];
		1615 -> 1628;
		1615 -> 1631;
		1615 -> 1632;
	1618 [label="+5 Chemistry",color=orange];
		1618 -> 1634;
	1617 [label="Sie ist wirklich wunderschön, da kann ich dir nichts vorwerfen. Allerdings denke ich, dass ich persönlich diese selbstgerechte Frömmigkeit nicht ertragen könnte.",shape=box,color=blue];
		1617 -> 1633;
	1616 [label="Er ist durchaus attraktiv. Aber er sieht so aus, als ob er das Ende der Welt deklarieren würde, sobald eine Blume verwelkt und sich dann vom nächsten Turm stürzt.",shape=box,color=blue];
		1616 -> 1633;
	1619 [label="Ich frage mich, ob und wer von uns dein Interesse geweckt hat.",shape=box,color=blue];
		1619 -> 1635;
	1620 [label="Dein Pech, aber du hast ja eine ganze Reihe von Möglichkeiten zur Auswahl, nicht wahr? Ich bin mir sicher, du wirst jemanden finden, mit dem du dich ... amüsieren kannst.",shape=box,color=blue];
		1620 -> 1635;
	1621 [label="Check boolean IsDating",color=orange];
		1621 -> 1636 [label=true,color=green];
