	1528 [label="Update boolean RoatheExecutor2",color=orange];
		1528 -> 1534;
	1531 [label="Nitokh hatte unmissverständlich klargemacht, dass ich öffentliche geopfert worden wäre im Falle eines Scheiterns.",shape=box,color=blue];
		1531 -> 1535;
		1531 -> 1536;
	1532 [label="Was war Phase zwei?",shape=box,color=red];
		1532 -> 1537;
