		1635 -> 1650 [label=true,color=green];
		1635 -> 1649 [label=false,color=brown];
	1636 [label="Hm. Klug. Das wirft allerdings die Frage auf: Habe ich etwa dein Interesse geweckt, Drifter? Falls du glaubst, es stört mich, dass du mit jemand anderem zusammen bist – das tut es nicht.",shape=box,color=blue];
