	1629 [label="Das hatte ich nicht vor, aber danke für den Tipp.",shape=box,color=red];
		1629 -> 1627;
	1630 [label="Ich werde mir das zu Herzen nehmen.",shape=box,color=red];
		1630 -> 1626;
