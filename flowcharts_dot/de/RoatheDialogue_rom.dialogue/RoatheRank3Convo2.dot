		1682 -> 1697;
	1680 [label="Ich denke, ich werde mich einfach zurücklehnen und zuschauen, wie alles von selbst auseinanderfällt. Oder du hast Erfolg und einer von den beiden lässt sich zu sehr von ihrem scheinbar unlösbaren Ziel, mich zu schikanieren, ablenken.",shape=box,color=blue];
