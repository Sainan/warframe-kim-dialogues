	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank3Convo3 begins." [color=orange];
		"MarieRank3Convo3 begins." -> j336195646;
	j336195646 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j336195646 -> j971302504;
	j971302504 [label="Check boolean MarieGraveyard1",color=orange];
		j971302504 -> j3860699903 [label=true,color=green];
		j971302504 -> j4198664291 [label=true,color=green];
		j971302504 -> j129698615 [label=true,color=green];
		j971302504 -> j3380693552 [label=false,color=brown];
		j971302504 -> j4198664291 [label=false,color=brown];
		j971302504 -> j129698615 [label=false,color=brown];
	j3860699903 [label="Kannst du mir mehr darüber erzählen, wie es war, in der Kathedrale zu leben? Bevor Entrati kam?",shape=box,color=red];
		j3860699903 -> j2043102610;
	j4198664291 [label="Wo bist du aufgewachsen, Marie?",shape=box,color=red];
		j4198664291 -> j2561967033;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j3380693552 [label="Wie war dein Leben in der Kathedrale, bevor Entrati auftauchte?",shape=box,color=red];
		j3380693552 -> j1432479792;
	j2043102610 [label="Einsam, denke ich, ist die Wahrheit. Ich hatte Lyon, aber du weißt ja, wie er manchmal sein kann. (Oh! Ich freue mich so, dass ihr jetzt miteinander sprecht !)",shape=box,color=blue];
		j2043102610 -> j278862917;
	j2561967033 [label="Boolean MarieBackstory1 is now true.",color=orange];
		j2561967033 -> j1690546780;
	"Chat ends." [color=orange];
	j1432479792 [label="Oh, ich weiß nicht, ob das besonders interessant ist, aber ich werde es dir trotzdem erzählen, wenn du es wissen möchtest.",shape=box,color=blue];
		j1432479792 -> j3952118077;
	j278862917 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j278862917 -> j3941082876;
	j1690546780 [label="Ich dachte, die Sprache würde es verraten, aber ich erinnere mich, dass du nicht aus meiner Welt stammst, wie ich sie kenne, hah !",shape=box,color=blue];
		j1690546780 -> j553125279;
	j3952118077 [label="Ich verbrachte mein Leben damit, meinen Pflichten als eine Schwester von Sol nachzugehen, das Abendmahlsgeschirr zu polieren und Votivgaben für die Gemeindemitglieder aufzustellen.",shape=box,color=blue];
		j3952118077 -> j1630938944;
	j3941082876 [label="Aber das ist nicht der Grund, warum ich so viel Zeit damit verbringe, mit den Toten zu sprechen.",shape=box,color=blue];
		j3941082876 -> j1554283443;
	j553125279 [label="Ich komme aus der Cité de la Lumière, der Hauptstadt eines Landes namens Gallien. Im großen Maßstab der Welt ist sie auf der Karte nicht allzu weit von Höllvania entfernt.",shape=box,color=blue];
		j553125279 -> j747036588;
	j1630938944 [label="Die Pflege der crypte und des Friedhofs war meine Lieblingsaufgabe.",shape=box,color=blue];
		j1630938944 -> j599994416;
		j1630938944 -> j3956450136;
	j1554283443 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j1554283443 -> j255733364;
	j747036588 [label="Ich frage mich, ob meine Cathédrale im Jahr 1999 noch steht? Was für ein interessanter Gedanke !",shape=box,color=blue];
		j747036588 -> j3768377286;
		j747036588 -> j2324933727;
	j599994416 [label="Warum hast du das am liebsten gemacht?",shape=box,color=red];
		j599994416 -> j2848745550;
	j3956450136 [label="Tut mir leid. Kannst du den letzten Teil erklären?",shape=box,color=red];
		j3956450136 -> j2827594872;
	j255733364 [label="Diese Orte haben eine Schönheit, eine tranquillité. Sie sind so still. Friedlich.",shape=box,color=blue];
		j255733364 -> j1005689576;
	j3768377286 [label="Du schweifst gerne vom Thema ab, nicht wahr?",shape=box,color=red];
		j3768377286 -> j1526986158;
	j2324933727 [label="Ich könnte wahrscheinlich zwei meiner Freunde fragen, sie sind ziemlich weit gereist. Ich glaube, sie erwähnten sogar diese Stadt.",shape=box,color=red];
		j2324933727 -> j1929192659;
	j2848745550 [label="Es hat mir viel Freude bereitet, mit den Ruhenden zu sprechen. Sie hörten sich meine Sorgen an, ohne ein Wort des Urteils zu erheben.",shape=box,color=blue];
		j2848745550 -> j3182348126;
	j2827594872 [label="Es war meine Pflicht, mich um die Toten der Cathédrale zu kümmern. Ich fegte den Staub vom Boden der crypte und jätete das Gras im Hof.",shape=box,color=blue];
		j2827594872 -> j2848745550;
	j1005689576 [label="Ich glaube, ich erzähle ihnen gern von meinen Problemen et les activités des autres, weil ihre Sorgen vorbei sind, oui ?",shape=box,color=blue];
		j1005689576 -> j1684270933;
	j1526986158 [label="+5 Chemistry",color=orange];
		j1526986158 -> j259270111;
	j1929192659 [label="+5 Chemistry",color=orange];
		j1929192659 -> j1826330864;
	j3182348126 [label="Nun, sie hatten kein einziges Wort erwidert, mais cela me convenait tout à fait ! Mir war es viel lieber, wenn sie schwiegen.",shape=box,color=blue];
		j3182348126 -> j2943352933;
	j1684270933 [label="Alles muss ihnen jetzt nichtig vorkommen, und das ist für mich tröstlich.",shape=box,color=blue];
		j1684270933 -> j296773018;
		j1684270933 -> j3246025782;
		j1684270933 -> j433825890;
	j259270111 [label="Das ist dir aufgefallen, oui ? Lyon neckt mich ständig damit, dass ich ein Staubkorn im Sonnenstrahl sei, das dahintreibt, wohin der Wind mich trägt. (Ich bin so froh, dass ihr jetzt miteinander redet !)",shape=box,color=blue];
		j259270111 -> j2778667565;
	j1826330864 [label="Oh, belästige sie nicht, das war einfach nur ein Gedanke. Ich weiß nicht, wie traurig ich wäre, wenn ich wüsste, dass sie nicht mehr da ist.",shape=box,color=blue];
		j1826330864 -> j2778667565;
	j2943352933 [label="+5 Chemistry",color=orange];
		j2943352933 -> j2055873165;
	j296773018 [label="Ich weiß nicht, ich habe ... Angst davor, richtig zu sterben, ich war noch nie gern dem Tod nahe.",shape=box,color=red];
		j296773018 -> j3761250833;
	j3246025782 [label="So habe ich noch nie darüber nachgedacht.",shape=box,color=red];
		j3246025782 -> j933234083;
	j433825890 [label="Ich habe auf Friedhöfen und Begräbnisstätten denselben Frieden gefunden. Ich verstehe das vollkommen.",shape=box,color=red];
		j433825890 -> j2323754400;
	j2778667565 [label="Ich bin einfach nur neugierig, non? Ich möchte tout ce qui existe wissen, was es zu wissen gibt. Ich glaube, deshalb war es le Cardinal und mir bestimmt, uns zu begegnen.",shape=box,color=blue];
		j2778667565 -> j765659923;
	j2055873165 [label="Kannst du dir das vorstellen? Sprechende Totenköpfe, so wie dein Nekraloid ? Ha !",shape=box,color=blue];
		j2055873165 -> j2730961687;
		j2055873165 -> j2500740840;
	j3761250833 [label="Ich weiß, kleine morbide Marie ! So seltsam. Aber jedem das Seine, non ?",shape=box,color=blue];
		j3761250833 -> j2537605775;
	j933234083 [label="Damit bist du nicht allein. Wir verbringen nicht gerne unsere Zeit damit, darüber nachzudenken, was danach kommt. Zumindest nicht, bis wir kurz davor sind.",shape=box,color=blue];
		j933234083 -> j3429248741;
	j2323754400 [label="Ich bin so froh, dass du das verstehst !",shape=box,color=blue];
		j2323754400 -> j3429248741;
	j765659923 [label="Où en étais-je ? Ah ! Oui. Meine Geschichte.",shape=box,color=blue];
		j765659923 -> j2743446768;
	j2730961687 [label="Mit deinem Rollstuhl war das sicherlich nicht die einfachste Aufgabe.",shape=box,color=red];
		j2730961687 -> j1119021111;
	j2500740840 [label="Hattest du keine anderen Freunde zum Unterhalten?",shape=box,color=red];
		j2500740840 -> j960897484;
	j2537605775 [label="Jemand muss sich um sie kümmern. Und ich mache das sehr gerne.",shape=box,color=blue];
		j2537605775 -> j3429248741;
	j3429248741 [label="Lyon scherzt, dass ich näher am Boden sei und deshalb so oft an das Grab denke.",shape=box,color=blue];
		j3429248741 -> j1323278102;
	j2743446768 [label="Ich wurde in eine reiche famille hineingeboren, was dich vielleicht überrascht. Die bürgerliche Klasse, den Orokin näher, als sonst nichts.",shape=box,color=blue];
		j2743446768 -> j489630373;
	j1119021111 [label="Nein, war es nicht. Aber Lyon half mir die Treppe zur crypte hinauf und hinunter, wenn es so weit war und den Rest schaffte ich mit der Zeit allein.",shape=box,color=blue];
		j1119021111 -> j1511122621;
	j960897484 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j960897484 -> j3287075945;
	j1323278102 [label=" Ich frage ihn, ob sein Kopf leer ist und deshalb so voller Geister.",shape=box,color=blue];
		j1323278102 -> j1727606338;
	j489630373 [label="Aber so geboren, wie ich war ... deformiert, mit mes pieds tordus et inutilisables ? Oh, das konnte ma mère nicht ertragen.",shape=box,color=blue];
		j489630373 -> j151331968;
	j1511122621 [label="Es ist beeindruckend, was man mit Sturheit erreichen kann, oui ?",shape=box,color=blue];
		j1511122621 -> j3382307179;
	j3287075945 [label="Ich hatte natürlich Lyon. Aber du siehst ja, wie gut das an manchen Tagen geht.",shape=box,color=blue];
		j3287075945 -> j1554283443;
	j1727606338 [label="Dann drohte er, mich einen Hügel hinunterzustoßen, und ich drohe, seinen Talar mit Brennnesseln zu füllen.",shape=box,color=blue];
		j1727606338 -> j1118776134;
	j151331968 [label="Es galt, den Schein zu wahren, oui ? Standards einzuhalten.",shape=box,color=blue];
		j151331968 -> j3650783352;
	j3382307179 [label="Nun ja. Sturheit und einem kräftigen Oberkörper, ha !",shape=box,color=blue];
		j3382307179 -> j1393194449;
	j1118776134 [label="La famille.",shape=box,color=blue];
		j1118776134 -> j3734911544;
		j1118776134 -> j404472946;
		j1118776134 -> j3566512113;
		j1118776134 -> j2429183793;
	j3650783352 [label="Was also sollte mit der armen, missgebildeten Marie geschehen? Man brachte mich in die Cité de la Lumière, wo ich mit Sicherheit auf der Straße enden würde ...",shape=box,color=blue];
		j3650783352 -> j424456632;
	j1393194449 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j1393194449 -> j1554283443;
	j3734911544 [label="Es tut mir leid, dass Entrati das, was ihr hattet, gestört hat.",shape=box,color=red];
		j3734911544 -> j1498315578;
	j404472946 [label="Ich bin so froh, dass ihr euch hattet.",shape=box,color=red];
		j404472946 -> j3292452515;
	j3566512113 [label="Ihr zwei bringt mich zum Lächeln.",shape=box,color=red];
		j3566512113 -> j3971054397;
	j2429183793 [label="Also wart ihr beide ... nie romantisch verbunden?",shape=box,color=red];
		j2429183793 -> j2541326375;
	j424456632 [label="Ausgesetzt und dem Tod überlassen.",shape=box,color=blue];
		j424456632 -> j770015118;
		j424456632 -> j341022108;
	j1498315578 [label="+10 Chemistry",color=orange];
		j1498315578 -> j2490072350;
	j3292452515 [label="+20 Chemistry",color=orange];
		j3292452515 -> j475902827;
	j3971054397 [label="+20 Chemistry",color=orange];
		j3971054397 -> j3958432899;
	j2541326375 [label="Oh, Sol ! Non ! Er ist wie mein Bruder, wenn auch nicht blutsverwandt. Ich bin von dem Gedanken complètement dégoûtée !",shape=box,color=blue];
		j2541326375 -> j3942899896;
		j2541326375 -> j2902006710;
	j770015118 [label="Deine Familie hat dich zum Sterben zurückgelassen?",shape=box,color=red];
		j770015118 -> j2755552534;
	j341022108 [label="Wie alt warst du?",shape=box,color=red];
		j341022108 -> j3827393650;
	j2490072350 [label="Entrati hat nichts gestört. Lyon und ich sind so stark wie nie zuvor. Die Dinge haben sich einfach geändert, non ?",shape=box,color=blue];
		j2490072350 -> j1202923772;
	j475902827 [label="Ohne ihn wäre ich nirgends. Außer vielleicht am Fuße eines Hügels. Hah !",shape=box,color=blue];
		j475902827 -> j2091242443;
	j3958432899 [label="Er bringt mich auf die seltsamste Art zum Lachen. Aber ich finde, du auch, Wolf. Ich freue mich immer mehr, hier zu sein.",shape=box,color=blue];
		j3958432899 -> j770417869;
	j3942899896 [label="Ich war nur neugierig.",shape=box,color=red];
		j3942899896 -> j3385888755;
	j2902006710 [label="Ich gebe zu, ich bin etwas erleichtert.",shape=box,color=red];
		j2902006710 -> j1335227973;
	j2755552534 [label="In ihren Augen hatten sie jahrelang ihr Bestes gegeben, um mich zu heilen. Lehrer, die mir das Gehen beibrachten. Beinstützen. Schuhe.",shape=box,color=blue];
		j2755552534 -> j2984781299;
	j3827393650 [label="Sechs ? Sieben ? In ihren Augen hatten sie jahrelang ihr Bestes gegeben, um mich zu heilen. Lehrer, die mir das Gehen beibrachten. Beinstützen. Schuhe.",shape=box,color=blue];
		j3827393650 -> j2984781299;
	j1202923772 [label="Lua ist ständig im Wandel. Sogar Sol, so beständig er auch sein mag, wird in seinen Umlaufbahnen beeinflusst.",shape=box,color=blue];
		j1202923772 -> j4127634899;
	j2091242443 [label="Er ist wirklich mein Seelenbruder. Ich freue mich immer mehr, hier zu sein.",shape=box,color=blue];
		j2091242443 -> j770417869;
	j770417869 [label="Ich hoffe nur, dass es ihm bald auch so geht ... aber der Teufel verfolgt ihn mit seinen Einflüsterungen und Lügen.",shape=box,color=blue];
		j770417869 -> j249230318;
	j3385888755 [label="+10 Chemistry",color=orange];
		j3385888755 -> j1930259134;
	j1335227973 [label="Check boolean DrifterMarie",color=orange];
		j1335227973 -> j1710697377 [label=true,color=green];
		j1335227973 -> j1656926218 [label=false,color=brown];
	j2984781299 [label="Sie waren dieser Last überdrüssig. Und so landete ich, kaum in der Lage, zu lesen und zu schreiben, im Dreck.",shape=box,color=blue];
		j2984781299 -> j3727650593;
		j2984781299 -> j528016656;
	j4127634899 [label="Wir dürfen nicht starr in unseren Gewohnheiten bleiben, sonst werden wir daran zerbrechen, Wolf. Außerdem freue ich mich immer mehr, hier zu sein.",shape=box,color=blue];
		j4127634899 -> j770417869;
	j249230318 [label="Bah ! Sprich über ihn und er ruft. Ich muss gehen.",shape=box,color=blue];
		j249230318 -> "Chat ends.";
	j1930259134 [label="Check boolean DrifterMarie",color=orange];
		j1930259134 -> j2623524975 [label=true,color=green];
		j1930259134 -> j2259746996 [label=false,color=brown];
	j1710697377 [label="Oui, du hast deine Absichten deutlich gemacht. Ich muss dich warnen, ich werde ihn nicht im Stich lassen. Ich kenne Lyon viel länger als dich.",shape=box,color=blue];
		j1710697377 -> j2259746996;
	j1656926218 [label="Oui ? Und welchen von uns beiden ... jagst du ?",shape=box,color=blue];
		j1656926218 -> j440120793;
		j1656926218 -> j908150562;
	j3727650593 [label="Wie hast du überlebt?",shape=box,color=red];
		j3727650593 -> j251854413;
	j528016656 [label="Das ist entsetzlich.",shape=box,color=red];
		j528016656 -> j251854413;
	j2623524975 [label="Oui. Nur \"neugierig\". Du machst mir nichts vor. Ich muss dich warnen, ich werde ihn nicht im Stich lassen. Ich kenne Lyon viel länger als dich.",shape=box,color=blue];
		j2623524975 -> j2259746996;
	j2259746996 [label="+20 Chemistry",color=orange];
		j2259746996 -> j3472974236;
	j440120793 [label="Dich.",shape=box,color=red];
		j440120793 -> j1722460889;
	j908150562 [label="Lyon.",shape=box,color=red];
		j908150562 -> j2979694570;
	j251854413 [label="Check boolean MarieSecretPower",color=orange];
		j251854413 -> j1618178991 [label=true,color=green];
		j251854413 -> j2790756726 [label=false,color=brown];
	j3472974236 [label="Ohne ihn wäre ich nirgends. Außer vielleicht am Fuße eines Hügels. Hah !",shape=box,color=blue];
		j3472974236 -> j3435544006;
	j1722460889 [label="Boolean DrifterMarie is now true.",color=orange];
		j1722460889 -> j3252273728;
	j2979694570 [label="Vraiment ?!",shape=box,color=blue];
		j2979694570 -> j2204512568;
	j1618178991 [label="Es war, wie du sagtest, non ? Alle Unannehmlichkeiten bringen eine geheime Macht mit sich.",shape=box,color=blue];
		j1618178991 -> j2790756726;
	j2790756726 [label="Was mich zu une indésirable pour ma mère machte, machte mich bei den anderen Straßenkindern sehr beliebt.",shape=box,color=blue];
		j2790756726 -> j2491986673;
	j3435544006 [label="Trotzdem, du machst mich neugierig, Wolf. Ich freue mich mehr und mehr hier zu sein.",shape=box,color=blue];
		j3435544006 -> j770417869;
	j3252273728 [label="+10 Chemistry",color=orange];
		j3252273728 -> j3500397206;
	j2204512568 [label="+10 Chemistry",color=orange];
		j2204512568 -> j960016104;
	j2491986673 [label="Was ist weitaus mehr pathétique als ein Kind ohne Füße, oui ? Ich verdiente an einem Tag durch betteln mehr, als sie in einer Woche zusammenstehlen konnten.",shape=box,color=blue];
		j2491986673 -> j2519770793;
	j3500397206 [label="Oh ! Par Sol. Ich gebe zu, du überraschst mich. Und jetzt sitze ich hier mit gerötetem Gesicht und verstecke es vor Monsieur Loid ...",shape=box,color=blue];
		j3500397206 -> j2539022739;
	j960016104 [label="Du weißt nicht, wie glücklich mich das macht, aber bitte, bedenke, was du sagst.",shape=box,color=blue];
		j960016104 -> j1243019476;
	j2519770793 [label="Dies führte dazu, dass ich auf der Straße von einer der Sœurs de Sol gefunden wurde. Sie boten mir an, mich aufzunehmen.",shape=box,color=blue];
		j2519770793 -> j2055131800;
		j2519770793 -> j1658160288;
	j2539022739 [label="Ich muss dich warnen, ich werde ihn nicht im Stich lassen. Ich kenne Lyon viel länger als dich.",shape=box,color=blue];
		j2539022739 -> j4241248491;
	j1243019476 [label="Boolean DrifterLyon is now true.",color=orange];
		j1243019476 -> j1040848803;
	j2055131800 [label="Und die anderen Kinder?",shape=box,color=red];
		j2055131800 -> j4223722629;
	j1658160288 [label="Du hast natürlich zugestimmt.",shape=box,color=red];
		j1658160288 -> j3305668996;
	j4241248491 [label="+10 Chemistry",color=orange];
		j4241248491 -> j770417869;
	j1040848803 [label="Lyon ist mein Bruder. Ich liebe ihn mehr, als du dir vorstellen kannst, aber er hat Sorgen. Wähle deine Worte mit Bedacht, bevor du ihm nachsetzt, n'est-ce pas ?",shape=box,color=blue];
		j1040848803 -> j1087939827;
	j4223722629 [label="+5 Chemistry",color=orange];
		j4223722629 -> j4140542518;
	j3305668996 [label="Oui, was sonst? Es war nur eine Frage der Zeit, krank zu werden. Das wusste ich schon selbst als Kind.",shape=box,color=blue];
		j3305668996 -> j249998447;
		j3305668996 -> j3689294977;
	j1087939827 [label="Wir sprechen bald wieder darüber, denke ich. Versteh mich nicht falsch, ich ermutige dich ! Ich möchte nur, dass du es überdenkst.",shape=box,color=blue];
		j1087939827 -> j4241248491;
	j4140542518 [label="Du hast so ein gutes Herz. Natürlich konnten sie nicht alle aufnehmen ... aber ich vergaß meine Freunde nicht.",shape=box,color=blue];
		j4140542518 -> j268647781;
	j249998447 [label="Wie waren die Schwestern?",shape=box,color=red];
		j249998447 -> j3987781107;
	j3689294977 [label="Wie hast du dich an das Leben in der Kathedrale gewöhnt?",shape=box,color=red];
		j3689294977 -> j1485399919;
	j268647781 [label="Ich kam jede Woche mit meinem salaire und allen Resten zurück, die ich aus der Küche oder von den anderen auftreiben konnte.",shape=box,color=blue];
		j268647781 -> j2364540968;
	j3987781107 [label="Die Nonnen waren so nett zu mir ! Obwohl, du musst dir das anders vorgestellt haben, non ?",shape=box,color=blue];
		j3987781107 -> j1401078678;
	j1485399919 [label="Wie ich es geliebt habe ! Obwohl, du musst dir das anders vorgestellt haben, non ?",shape=box,color=blue];
		j1485399919 -> j1401078678;
	j2364540968 [label="Ich habe mich so gut wie möglich um sie gekümmert, solange meine Freunde noch da waren. Viele starben an variole ou tuberculose ...",shape=box,color=blue];
		j2364540968 -> j296487798;
	j1401078678 [label="Drei Mahlzeiten, ein warmes Bett, ein Dach über dem Kopf. Ich musste keine Angst haben, geschlagen oder ausgeraubt zu werden oder Schlimmeres ?",shape=box,color=blue];
		j1401078678 -> j957939796;
	j296487798 [label="Einige zogen weg, andere starben gewaltsam oder durch Kämpfe. Die meisten fanden ehrliche Arbeit und wuchsen auf. Gründeten ihre eigene famille.",shape=box,color=blue];
		j296487798 -> j2583130169;
	j957939796 [label="Ich wurde unterrichtet. Man lehrte mich die Evangelien von Sol und Lua. Mir wurde gesagt, ich solle meinen Weg im Glauben finden. Ich hätte gehen können, wenn ich gewollt hätte.",shape=box,color=blue];
		j957939796 -> j1994322793;
	j2583130169 [label="Einige kamen sogar in der Cathédrale vorbei, um mich zu besuchen. Das wärmte mir das Herz.",shape=box,color=blue];
		j2583130169 -> j1994322793;
	j1994322793 [label="Ich fühlte mich lange schuldig, weil ich von der Straße geholt wurde und andere nicht. An manchen Tagen tue ich das immer noch.",shape=box,color=blue];
		j1994322793 -> j2166477;
		j1994322793 -> j1444641184;
	j2166477 [label="Wenn ich an all diejenige denke, die um mich herum gestorben sind, obwohl ich selbst überlebt habe? Geht es mir genauso. Aber das können wir uns nicht antun. Wir müssen weiterkämpfen, um die Dinge zu verbessern, wo immer es geht.",shape=box,color=red];
		j2166477 -> j2680549729;
	j1444641184 [label="Du hast dein Bestes getan, um anderen mit dem zu helfen, was dir gegeben wurde. Andere haben dich unterstützt, und du versuchtest, andere zu unterstützen, jetzt, da dir diese Möglichkeit gegeben wurde.",shape=box,color=red];
		j1444641184 -> j3745656400;
	j2680549729 [label="Wird es immer so bleiben ? Ein Kampf ? Ein Krieg gegen eine Flut, die uns ertränken will ?",shape=box,color=blue];
		j2680549729 -> j3107340519;
	j3745656400 [label="Add 1 to Thermostat counter",color=orange];
		j3745656400 -> j1372110476;
	j3107340519 [label="Add -1 to Thermostat counter",color=orange];
		j3107340519 -> j3683171675;
	j1372110476 [label="+10 Chemistry",color=orange];
		j1372110476 -> j3076250209;
	j3683171675 [label="+10 Chemistry",color=orange];
		j3683171675 -> j321574027;
	j3076250209 [label="Oui, genau so ist es. Ich wurde auf das Floß gehoben und jetzt muss ich das für andere tun.",shape=box,color=blue];
		j3076250209 -> j4083293369;
	j321574027 [label="Aber ich weiß, was du meinst. Grundsätzlich soll man nicht aufgeben. Mir wurden diese Gaben gegeben, damit ich anderen als Schutzschild zur Seite stehen kann.",shape=box,color=blue];
		j321574027 -> j4083293369;
	j4083293369 [label="Merci. Aber jetzt muss ich gehen.",shape=box,color=blue];
		j4083293369 -> "Chat ends.";
}