		3741 -> 1489;
	1491 [label="Wie habt du und Lyon euch kennengelernt?",shape=box,color=red];
		1491 -> 1494;
	1490 [label="Geht es ... Lyon gut?",shape=box,color=red];
		1490 -> 1493;
	1489 [label="[Ende.]",shape=box,color=red];
		1489 -> 1492;
	1494 [label="Mein lieber Lyon war schon lange in der Cathédrale ansässig, als die Mère Supérieure mich aufnahm und ich der Kirche der Himmlischen als Nonne beitrat. (Ich bin ganz aufgeregt, dass ihr redet!)",shape=box,color=blue];
		1494 -> 1497;
		1494 -> 1498;
	1493 [label="Ich bitte dich, dies zu definieren, bevor wir fortfahren. Und ich bitte dich, dies behutsam zu tun und erinnere dich eindringlich daran, dass er der Bruder meiner Seele ist.",shape=box,color=blue];
		1493 -> 1495;
		1493 -> 1496;
	1492 [label="Chat ends.",color=orange];
	1497 [label="Brauchtest du ... eine Unterkunft?",shape=box,color=red];
		1497 -> 1501;
	1498 [label="Darf ich eine persönliche Frage stellen?",shape=box,color=red];
		1498 -> 1502;
	1495 [label="Wenn du dieses Gespräch nicht möchtest, können wir zu etwas anderem übergehen.",shape=box,color=red];
		1495 -> 1499;
	1496 [label="Ich möchte dich nicht verärgern. Ich mache mir nur Sorgen um ihn. Er wirkt stoisch, aber ich habe das Gefühl, dass er Schmerzen hat, das ist alles.",shape=box,color=red];
		1496 -> 1500;
	1501 [label="Weil ma famille mich viele Jahre zuvor als kleines Mädchen dort ausgesetzt hatte. Ich verbrachte viele Jahre als Bettlerin und lebte, wie ich nur konnte.",shape=box,color=blue];
		1501 -> 1507;
	1502 [label="+5 Chemistry",color=orange];
		1502 -> 1508;
	1499 [label="Nein, nein. Alles in Ordnung. Ich bin einfach daran gewöhnt, dass Neugierige herumschleichen und an die Gitterstäbe seines Käfigs klopfen, als wäre er eine Art monstre de cirque.",shape=box,color=blue];
		1499 -> 1503;
		1499 -> 1504;
		1499 -> 1505;
	1500 [label="+5 Chemistry",color=orange];
		1500 -> 1506;
	1507 [label="Update boolean MarieBeggar1",color=orange];
		1507 -> 1512;
	1508 [label="Man sagt, du seist ein Wolf, und mir gegenüber hast du solche Manieren ! Das ist so nett. Ich glaube, ich weiß, was du fragen willst. Warum war ich auf der Straße ?",shape=box,color=blue];
		1508 -> 1501;
	1503 [label="Wie habt ihr euch kennengelernt?",shape=box,color=red];
		1503 -> 1509;
	1504 [label="Ich bin es gewohnt, eine Art \"lokale Attraktion\" zu sein, und ich verstehe, wenn du defensiv reagierst.",shape=box,color=red];
		1504 -> 1510;
	1505 [label="Alles in Ordnung. Ich mache mir nur Sorgen um ihn.",shape=box,color=red];
		1505 -> 1511;
	1506 [label="Ich ... entschuldige mich für meine Schroffheit. Ich bin einfach daran gewöhnt, dass Neugierige herumschleichen und an die Gitterstäbe seines Käfigs klopfen, als wäre er eine Art monstre de cirque.",shape=box,color=blue];
		1506 -> 1504;
		1506 -> 1505;
	1512 [label="Du kannst dir vorstellen, für jemanden wie mich, ohne funktionierenden Füße, gab es dans le Cité de la Lumière damals nicht viel Arbeit oder etwas, wo ich hätte hingehen können.",shape=box,color=blue];
		1512 -> 1518;
	1509 [label="Mein lieber Lyon war schon lange in der Cathédrale ansässig, als die Mère Supérieure mich aufnahm und ich der Kirche der Himmlischen als Nonne beitrat.",shape=box,color=blue];
		1509 -> 1513;
		1509 -> 1514;
	1510 [label="Ja, das musst du wohl sein, ein zeitreisendes Wesen, das Zeit in einer Schleife durchlaufen und Welten aus dem Nichts heraufbeschwören kann! Du bist ein wenig wie ein Zauberer, non ?",shape=box,color=blue];
		1510 -> 1515;
		1510 -> 1516;
	1511 [label="+5 Chemistry",color=orange];
		1511 -> 1517;
	1518 [label="Deshalb sind Lyon und ich wohl so schnell zu einer Familie geworden. Er hat mich nie mitleidig angesehen. Und ich ihn auch nicht.",shape=box,color=blue];
		1518 -> 1525;
	1513 [label="Brauchtest du ... eine Unterkunft?",shape=box,color=red];
		1513 -> 1519;
	1514 [label="Darf ich eine persönliche Frage stellen?",shape=box,color=red];
		1514 -> 1520;
	1515 [label="Das fasst es ziemlich gut zusammen.",shape=box,color=red];
		1515 -> 1521;
	1516 [label="Ehrlich gesagt hoffe ich, dass man mehr in mir sieht als das.",shape=box,color=red];
		1516 -> 1522;
	1517 [label="Und ich bewundere dich dafür. Er ist stark und kann allem standhalten, was ihm auferlegt wurde. Aber gemeinsam sind alle Lasten leichter zu tragen.",shape=box,color=blue];
		1517 -> 1523;
		1517 -> 1524;
	1525 [label="Während andere allzu neugierig auf die Gitterstäbe seines Käfigs klopfen, als wäre er eine Art monstre de cirque.",shape=box,color=blue];
		1525 -> 1531;
	1519 [label="Weil ma famille mich viele Jahre zuvor als kleines Mädchen dort ausgesetzt hatte. Ich verbrachte viele Jahre als Bettlerin und lebte, wie ich nur konnte.",shape=box,color=blue];
		1519 -> 1526;
	1520 [label="+5 Chemistry",color=orange];
		1520 -> 1527;
	1521 [label="+10 Chemistry",color=orange];
		1521 -> 1528;
	1522 [label="+15 Chemistry",color=orange];
		1522 -> 1529;
	1523 [label="Ich habe das Gefühl, dass er nicht mit mir reden will.",shape=box,color=red];
		1523 -> 1530;
	1524 [label="Ich möchte ihm helfen, wenn ich kann. Hast du einen Rat?",shape=box,color=red];
		1524 -> 1530;
	1531 [label="Ich hoffe, das ist nicht das, was du hier machst.",shape=box,color=blue];
		1531 -> 1536;
		1531 -> 1537;
	1526 [label="Update boolean MarieBeggar1",color=orange];
		1526 -> 1532;
	1527 [label="Man sagt, du seist ein Wolf, und mir gegenüber hast du solche Manieren ! Das ist so nett. Ich glaube, ich weiß, was du fragen willst. Warum war ich auf der Straße ?",shape=box,color=blue];
		1527 -> 1519;
	1528 [label="Eines Tages wird ein Märchenbuch über dich geschrieben, denke ich. Welch charmanter Gedanke. Vielleicht werde ich es schreiben. Aber auf Gaullique! Imaginez cela !",shape=box,color=blue];
		1528 -> 1533;
	1529 [label="Dann verstehst du es wirklich. Ich bin mehr als Schwester Marie, das arme Mädchen ohne Füße, dem die Fähigkeit zum Fliegen gegeben wurde. Und Lyon ist mehr als ein tragischer Priester, der seine Lasten schweigend trägt.",shape=box,color=blue];
		1529 -> 1534;
	1530 [label="+10 Chemistry",color=orange];
		1530 -> 1535;
	1536 [label="Ich bin es gewohnt, eine Art \"lokale Attraktion\" zu sein, ich weiß, wie ihr euch beide fühlt. Nein, darum geht es hier nicht.",shape=box,color=red];
		1536 -> 1541;
	1537 [label="Nein, ich war einfach nur neugierig. Ehrlich gesagt, machte ich mir etwas Sorgen um ihn. Ich glaube, er verbirgt einen Großteil seines Schmerzes.",shape=box,color=red];
		1537 -> 1542;
	1532 [label="Du kannst dir vorstellen, für jemanden wie mich, ohne funktionierenden Füße, gab es dans le Cité de la Lumière damals nicht viel Arbeit oder etwas, wo ich hätte hingehen können.",shape=box,color=blue];
		1532 -> 1538;
	1533 [label="Oder stell dir sowas besser nicht vor, es könnte wahr werden. Hah! Und in diesem Sinne muss ich mich leider von dir verabschieden. Das Raunen ruht nie !",shape=box,color=blue];
		1533 -> 1539;
	1534 [label="Vergiss das nicht, und wir werden gute Freunde sein, denke ich. Und in diesem Sinne muss ich mich leider von dir verabschieden. Das Raunen ruht nie !",shape=box,color=blue];
		1534 -> 1540;
	1535 [label="Hab Geduld. Er ist ... anfangs nicht gerade zuvorkommend. Aber er wird zu dir kommen, wenn die Zeit reif ist. Wenn du es gut meinst, wird er es wissen. Doch jetzt muss ich mich leider von dir verabschieden.",shape=box,color=blue];
		1535 -> 2424;
	1541 [label="Ja, das musst du wohl sein, ein zeitreisendes Wesen, das Zeit in einer Schleife durchlaufen und Welten aus dem Nichts heraufbeschwören kann! Du bist ein wenig wie ein Zauberer, non ?",shape=box,color=blue];
		1541 -> 1545;
		1541 -> 1546;
	1542 [label="+15 Chemistry",color=orange];
		1542 -> 1547;
	1538 [label="Deshalb sind Lyon und ich wohl so schnell zu einer Familie geworden. Er hat mich nie mitleidig angesehen. Und ich ihn auch nicht.",shape=box,color=blue];
		1538 -> 1543;
		1538 -> 1544;
	1539 [label="Chat ends.",color=orange];
	1540 [label="Chat ends.",color=orange];
	2424 [label="Chat ends.",color=orange];
	1545 [label="Das fasst es ziemlich gut zusammen.",shape=box,color=red];
		1545 -> 1521;
	1546 [label="Ehrlich gesagt hoffe ich, dass man mehr in mir sieht als das.",shape=box,color=red];
		1546 -> 1522;
	1547 [label="Du hast Recht, das tut er. Aber er hält es für notwendig, um sein Umfeld zu schützen. Wenn er das Gefühl hat, dass du sowas nicht mehr brauchst, wird er dir sagen, was ihn bedrückt. Hab Geduld. Er wird irgendwann mit dir sprechen.",shape=box,color=blue];
		1547 -> 1550;
	1543 [label="Ich hoffe, er fühlt sich bald wohl genug, um mit mir zu sprechen.",shape=box,color=red];
		1543 -> 1548;
	1544 [label="Ich freue mich, dass ihr beide zueinander gefunden habt. Wir sind alle mehr, als wir auf den ersten Blick scheinen.",shape=box,color=red];
		1544 -> 1549;
	1550 [label="Ich fürchte, ich muss mich von dir verabschieden. Das Raunen ruht nie !",shape=box,color=blue];
		1550 -> 1553;
	1548 [label="+10 Chemistry",color=orange];
		1548 -> 1551;
	1549 [label="+15 Chemistry",color=orange];
		1549 -> 1552;
	1553 [label="Chat ends.",color=orange];
