digraph {
	"MarieRank3Convo6 begins." [color=orange];
		"MarieRank3Convo6 begins." -> j63629230;
	j63629230 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j63629230 -> j2488061261;
	j2488061261 [label="Ich muss dir eine Frage stellen und flehe dich an, mich dafür nicht zu verurteilen, Drifter.",shape=box,color=blue];
		j2488061261 -> j3470679902;
		j2488061261 -> j2691531731;
		j2488061261 -> j129698615;
	j3470679902 [label="Du bist in eine außergewöhnliche Situation geraten. Natürlich werde ich dich nicht verurteilen.",shape=box,color=red];
		j3470679902 -> j3274354562;
	j2691531731 [label="Ich werde mein Bestes geben.",shape=box,color=red];
		j2691531731 -> j771541115;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j3274354562 [label="Vraiment gentil, mir diese Gnade zu erweisen, ohne mich zu kennen oder zu wissen, was ich dir schreiben wollte.",shape=box,color=blue];
		j3274354562 -> j1803620775;
	j771541115 [label="+10 Chemistry",color=orange];
		j771541115 -> j728527090;
	"Chat ends." [color=orange];
	j1803620775 [label="Aber ... verursacht dir der großköpfige sprechende Fisch auch Kopfschmerzen ? Fibonacci ?",shape=box,color=blue];
		j1803620775 -> j54452360;
		j1803620775 -> j4223444332;
		j1803620775 -> j710831666;
	j728527090 [label="Das weiß ich zu schätzen, danke.",shape=box,color=blue];
		j728527090 -> j1803620775;
	j54452360 [label="Ja. Ja, absolut. Danke.",shape=box,color=red];
		j54452360 -> j1118300981;
	j4223444332 [label="Die Vorstellung, dass du dich über Fibonacci ärgerst, ist unglaublich liebenswert.",shape=box,color=red];
		j4223444332 -> j764915227;
	j710831666 [label="Nein, eigentlich nicht. Ich finde ihn umwerfend.",shape=box,color=red];
		j710831666 -> j539580171;
	j1118300981 [label="Dann bin ich froh, dass ich nicht allein bin. Aber um es klarzustellen: Ich will ihn nicht beleidigen. Wenn ich mich aufgrund meiner derzeitigen Lage unwohl fühle, denke ich, dass er es so gut erträgt, wie er kann.",shape=box,color=blue];
		j1118300981 -> j4221919745;
	j764915227 [label="Oh ? Wieso ? Ich denke, darüber bin ich froh, aber ich verstehe einfach nicht, warum. Meine Kopfschmerzen sind jedenfalls nicht annähernd so bestechend.",shape=box,color=blue];
		j764915227 -> j545259961;
		j764915227 -> j616973282;
	j539580171 [label="Dann kann ich dich nur um Verzeihung bitten. Ich möchte ihn nicht beleidigen. Wenn ich mich aufgrund meiner derzeitigen Lage unwohl fühle, denke ich, dass er es so gut erträgt, wie er kann.",shape=box,color=blue];
		j539580171 -> j3290725116;
	j4221919745 [label="Seine Vorgehensweise ist mir einfach nicht sympathisch, wenn ich sie mir ausführlich anhöre, das ist alles.",shape=box,color=blue];
		j4221919745 -> j2452504358;
	j545259961 [label="Ich verbringe die meiste Zeit damit, um mein Leben zu kämpfen. Solche kleinen Erinnerungen an die Menschlichkeit sind ... sozusagen das, wofür ich lebe.",shape=box,color=red];
		j545259961 -> j671871043;
	j616973282 [label="Ich denke, ich muss ab und zu einen Schritt zurücktreten und über die Absurdität des Ganzen nachdenken. Ein Norg und eine Priesterin von Sol ...",shape=box,color=red];
		j616973282 -> j3902060764;
	j3290725116 [label="Seine Vorgehensweise ist mir einfach nicht sympathisch, wenn ich sie mir ausführlich anhöre, das ist alles.",shape=box,color=blue];
		j3290725116 -> j2452504358;
	j2452504358 [label="Bäh. Ich sollte mich überhaupt nicht beschweren. Ich muss Lyon heute Abend sein Abendessen bringen, er liegt mal wieder mit einer schrecklichen megrim flach.",shape=box,color=blue];
		j2452504358 -> j343881242;
		j2452504358 -> j1690114161;
	j671871043 [label="+5 Chemistry",color=orange];
		j671871043 -> j1991328374;
	j3902060764 [label="+5 Chemistry",color=orange];
		j3902060764 -> j540758491;
	j343881242 [label="Hat er das oft?",shape=box,color=red];
		j343881242 -> j1910591330;
	j1690114161 [label="Entschuldige ... was?",shape=box,color=red];
		j1690114161 -> j289844810;
	j1991328374 [label="Verliere nie diesen Teil von dir, Drifter. Lass den Teil von dir, der nach den Funken des Lebens sucht, nie los.",shape=box,color=blue];
		j1991328374 -> j809245149;
	j540758491 [label="Meine Güte, wenn du es so ausdrückst, ist das kein Wunder. Es klingt wirklich wie einer dieser Kinderwitze, n'est-ce pas ?",shape=box,color=blue];
		j540758491 -> j276489762;
	j1910591330 [label="Oui, oui. Alle paar Wochen ? Einmal alle zwei Monate ? Die längste Zeit, in der er keine hatte, waren vielleicht sechs Monate.",shape=box,color=blue];
		j1910591330 -> j547018639;
	j289844810 [label="Oh je ! Hm. Stell dir Kopfschmerzen vor, nur viel intensiver. Ich habe gehört, dass andere sie als Gallenkopfschmerzen bezeichnen. Sie kommen häufiger bei Frauen vor.",shape=box,color=blue];
		j289844810 -> j582997662;
		j289844810 -> j3834505594;
	j809245149 [label="Die Welt ist nur allzu bereit, finster und ernst zu werden. Sie ist nur allzu bereit, uns auf Schritt und Tritt Leid aufzuerlegen.",shape=box,color=blue];
		j809245149 -> j3703564311;
	j276489762 [label="Eine Nonne, ein Priester und ein Teufel aus der Zukunft werden in die Vergangenheit geschickt ... und dann in die Zukunft ... und treffen auf einen Fisch, ein Hirschwesen, einen riesigen Vogel und einen Butler ...",shape=box,color=blue];
		j276489762 -> j2828199652;
	j547018639 [label="Check boolean Megrim",color=orange];
		j547018639 -> j1606937916 [label=true,color=green];
		j547018639 -> j28840617 [label=true,color=green];
		j547018639 -> j3111506002 [label=true,color=green];
		j547018639 -> j1606937916 [label=false,color=brown];
		j547018639 -> j28840617 [label=false,color=brown];
		j547018639 -> j1060940382 [label=false,color=brown];
	j582997662 [label="Ich glaube, wir nennen das jetzt \"Migräne\".",shape=box,color=red];
		j582997662 -> j3689776842;
	j3834505594 [label="Hmm. megrims. Danke.",shape=box,color=red];
		j3834505594 -> j2918696159;
	j3703564311 [label="Wir müssen nach jeder erdenklichen Helligkeit und Leichtigkeit suchen, selbst in Form von Kindlichkeit, wenn es sein muss.",shape=box,color=blue];
		j3703564311 -> j2679582146;
	j2828199652 [label="Es ist ziemlich amüsant, du hast vollkommen recht !",shape=box,color=blue];
		j2828199652 -> j3310143146;
	j1606937916 [label="Ich frage mich, was das verursacht.",shape=box,color=red];
		j1606937916 -> j3748982865;
	j28840617 [label="Das klingt furchtbar ...",shape=box,color=red];
		j28840617 -> j867991294;
	j3111506002 [label="Ich bekomme auch megrims. Es ist schrecklich.",shape=box,color=red];
		j3111506002 -> j531302533;
	j1060940382 [label="Ich kriege auch solche Kopfschmerzen. Sie sind furchtbar.",shape=box,color=red];
		j1060940382 -> j531302533;
	j3689776842 [label="Ich bin gespannt, welche weiteren faszinierenden historischen particularités wir noch entdecken werden ! Aufregend. Ich liebe es, Neues zu lernen. \"Migräne.\" Die Reise war offensichtlich nicht weit.",shape=box,color=blue];
		j3689776842 -> j400355799;
	j2918696159 [label="Boolean Megrim is now true.",color=orange];
		j2918696159 -> j2374194693;
	j2679582146 [label="Wenn Lyon das jetzt nur genauso sehen würde.",shape=box,color=blue];
		j2679582146 -> j3717690019;
	j3310143146 [label="Wenn mein lieber Lyon nur die Helligkeit darin auf die gleiche Weise sehen würde.",shape=box,color=blue];
		j3310143146 -> j3717690019;
	j3748982865 [label="Er hat seine Theorien.",shape=box,color=blue];
		j3748982865 -> j481418483;
	j867991294 [label="Ich bin sicher, wenn du Mitgefühl zeigst, wird er sich freuen. Und auch wenn es anders aussehen mag, wird er deine Gesellschaft zu schätzen wissen.",shape=box,color=blue];
		j867991294 -> j4101364366;
	j531302533 [label="Wirklich ? Du solltest Lyon davon erzählen. Er muss wissen, dass auch andere auf ähnliche Weise leiden können.",shape=box,color=blue];
		j531302533 -> j3533848904;
	j400355799 [label="Boolean Migraine is now true.",color=orange];
		j400355799 -> j2374194693;
	j2374194693 [label="Egal wie der Name lautet, Lyon ist krank und wird es bis zum Morgen bleiben. Der arme Mann kann nur noch verschwommen sehen und spürt weder Hände noch Füße. Und er sagt, die Schmerzen seien unerträglich.",shape=box,color=blue];
		j2374194693 -> j547018639;
	j3717690019 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j3717690019 -> j1906095926;
	j481418483 [label="Obwohl es vielleicht richtiger wäre zu sagen, dass er bis vor kurzem seine Theorien hatte.",shape=box,color=blue];
		j481418483 -> j1535767263;
	j4101364366 [label="Auch wenn sein Verhalten dich vielleicht davon abzubringen versucht, bitte ich dich, standhaft zu bleiben, Drifter. Unter seiner scheinbar stoischen und steinernen Fassade verbirgt sich ein Mann mit großen Bedürfnissen.",shape=box,color=blue];
		j4101364366 -> j3748577345;
		j4101364366 -> j3440963559;
		j4101364366 -> j719182239;
	j3533848904 [label="+5 Chemistry",color=orange];
		j3533848904 -> j920921820;
	j1906095926 [label="Apropos. Ich fühle mich schrecklich, weil ich mich über Kopfschmerzen beschwere. Ich muss Lyon heute Abend sein Abendessen bringen, er liegt mal wieder mit einer schrecklichen Megrim flach.",shape=box,color=blue];
		j1906095926 -> j1690114161;
		j1906095926 -> j343881242;
	j1535767263 [label="Boolean MarieLyonFaith1 is now true.",color=orange];
		j1535767263 -> j4101364366;
	j3748577345 [label="Ich kann sehr stur sein. Mach dir keine Sorgen.",shape=box,color=red];
		j3748577345 -> j173160418;
	j3440963559 [label="Ich habe bereits einen \"Man in der Wand\" ... warum nicht zwei?",shape=box,color=red];
		j3440963559 -> j1694859016;
	j719182239 [label="Er ist ein erwachsener Mann. Wenn er reden möchte, kann er reden.",shape=box,color=red];
		j719182239 -> j4040842764;
	j920921820 [label="Die Himmlischen wissen, dass er sonst bereitwillig allein leiden würde ...",shape=box,color=blue];
		j920921820 -> j2315908171;
	j173160418 [label="+5 Chemistry",color=orange];
		j173160418 -> j2582656627;
	j1694859016 [label="Mach solche Scherze mit mir, aber mach ihm gegenüber keine solchen Bemerkungen. Das Thema mit deiner Gleichgültigkeit ist ihm ein Dorn im Auge.",shape=box,color=blue];
		j1694859016 -> j765551945;
	j4040842764 [label="Er ist erwachsen, ja. Er ist ein Mann, ja. Und ich glaube, er möchte reden. Aber ich fordere dich heraus, zu hinterfragen, ob er reden kann.",shape=box,color=blue];
		j4040842764 -> j2136034793;
	j2315908171 [label="Boolean MarieLyonSuffering2 is now true.",color=orange];
		j2315908171 -> j4101364366;
	j2582656627 [label="Ich fürchte, das wirst du bei ihm brauchen. Danke, Drifter. Er ist mein bester Freund und wie ein Bruder für mich. Und es bricht mir das Herz, ihn so leiden zu sehen.",shape=box,color=blue];
		j2582656627 -> j2557413376;
	j765551945 [label="Sei nachgiebig. Und geduldig. Und freundlich. Er ist wie ein Bruder für mich und mein bester Freund, Drifter. Und es bricht mir das Herz, ihn so leiden zu sehen.",shape=box,color=blue];
		j765551945 -> j2557413376;
	j2136034793 [label="Nicht alle von uns sind gleichermaßen begabt oder glauben, dass wir Anspruch auf solche Dinge haben. Er hat Schmerzen und glaubt, dass es sein Schicksal ist, Schmerzen zu haben.",shape=box,color=blue];
		j2136034793 -> j1402915474;
	j2557413376 [label="Wir sprechen uns bald wieder. Par la grâce de Sol.",shape=box,color=blue];
		j2557413376 -> "Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j1402915474 [label="Er ist auch wie ein Bruder für mich und mein bester Freund. Und mein Herz bricht für ihn. Deshalb kann ich dich nur bitten: Sei geduldig. Und freundlich. Wenn du dazu in der Lage bist.",shape=box,color=blue];
		j1402915474 -> j2557413376;
	"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
}