digraph {
	2239 [label="MarieRank4Convo3 begins.",color=orange];
		2239 -> 2240;
		2239 -> 2241;
	2240 [label="Wie geht es dir heute, Marie?",shape=box,color=red];
		2240 -> 2242;
	2241 [label="[Ende.]",shape=box,color=red];
		2241 -> 2243;
	2242 [label="Mir get es nicht so grand. Vielleicht möchtest du morgen mit mir reden. Heute werde ich keine angenehme Gesellschaft sein.",shape=box,color=blue];
		2242 -> 2244;
		2242 -> 2245;
		2242 -> 2246;
	2243 [label="Chat ends.",color=orange];
	2244 [label="Ich gehe, wenn du willst, aber wenn du reden möchtest, höre ich dir gerne zu.",shape=box,color=red];
		2244 -> 2247;
	2245 [label="Okay, ich verstehe.",shape=box,color=red];
		2245 -> 2248;
	2246 [label="Darf ich fragen, was los ist ...?",shape=box,color=red];
		2246 -> 2247;
	2247 [label="C'est vraiment gentil, aber es ist ein altes Problem ... nichts, worüber du dir den Kopf zerbrechen musst. Wird wieder gut.",shape=box,color=blue];
		2247 -> 2249;
	2248 [label="Chat ends.",color=orange];
	2249 [label="Update boolean MarieChronicPain",color=orange];
		2249 -> 2250;
		2249 -> 2251;
		2249 -> 2252;
	2250 [label="Wenn du dir sicher bist, aber ich bin da, falls du darüber reden möchtest.",shape=box,color=red];
		2250 -> 2253;
	2251 [label="Ich ... weiß, wie das ist. Bevor ich mit den 'Zeitschleifen' anfing, verletzte ich mich in Duviri ziemlich schwer. Es ist verheilt, aber es schmerzt manchmal furchtbar. Ich versuche mein Zusammenzucken zu verbergen, wenn es passiert.",shape=box,color=red];
		2251 -> 2254;
	2252 [label="Alte, hartnäckige Probleme können manchmal genauso problematisch sein wie neue. Nur weil sie kommen und gehen und bei uns bleiben, heißt das nicht, dass sie es nicht wert sind, darüber zu sprechen.",shape=box,color=red];
		2252 -> 2255;
	2253 [label="Du bist so lieb, und ... nun gut. Ich bin mal wieder die kleine, sture Marie.",shape=box,color=blue];
		2253 -> 2256;
	2254 [label="Update boolean DrifterChronicPain",color=orange];
		2254 -> 2257;
	2255 [label="Oui, tu as raison. Ich bin wieder die kleine, sture Marie.",shape=box,color=blue];
		2255 -> 2256;
	2256 [label="Es ist schwer zu erklären, aber ich werde es versuchen. Mes pieds, oui ? Meine Füße. Das sérum hat mich verändert, mir das Fliegen verliehen -",shape=box,color=blue];
		2256 -> 2258;
	2257 [label="Par les Luminaires, es tut mir so leid. Du verstehst also, wie es ist, oui ?",shape=box,color=blue];
		2257 -> 2259;
	2258 [label="Aber ich spüre es dennoch, dieses Verkrüppelte, das droht, mich zu verschlingen, das droht, alle Hoffnung und Freude aus meiner Seele zu tilgen.",shape=box,color=blue];
		2258 -> 2260;
	2259 [label="Einen Körper zu haben, der einen im Stich lässt, der den Geist bremst. Selbst jetzt ist es so seltsam. Das sérum hat mich verändert, mir das Fliegen verliehen -",shape=box,color=blue];
		2259 -> 2258;
	2260 [label="Sie schmerzen. Immer. Selbst jetzt, während ich hier sitze und an sie denke, spüre ich den Schmerz. Aber manchmal nehme ich es nicht wahr.",shape=box,color=blue];
		2260 -> 2261;
	2261 [label="Und doch wecken mich die Schmerzen nachts weiterhin auf. Und ich frage mich, Sol, pourquoi ? Warum muss ich diese ... agonie interminable fühlen ?",shape=box,color=blue];
		2261 -> 2262;
	2262 [label="Welchen Zweck hat das ? Ach, aber dann kommt der Morgen, und ich lache und sage mir: \"Schweig, Marie, du bist gesegnet. Sieh dir an, was du alles hast, was du alles tun kannst.\"",shape=box,color=blue];
		2262 -> 2263;
	2263 [label="In der Cathédrale hieß es: \"Du kannst lesen, schreiben, essen, schlafen. Du kannst dich gut genug bewegen. Du hast Augen zum Sehen und eine Zunge zum Sprechen. Hände zum Schreiben. Diejenigen, die sich um dich kümmern.\" Und nun kann ich fliegen! Ich kann die Zukunft vor dem Void selbst beschützen. Vor l'Indifférence !",shape=box,color=blue];
		2263 -> 2264;
	2264 [label="\"Weine jetzt, du dummes Mädchen, dieser ständige Schmerz wird dich stark machen gegen das, was noch kommen wird\", sage ich mir. Und der Tag geht in einen neuen über, und der nächste ist nicht mehr so schlimm.",shape=box,color=blue];
		2264 -> 2265;
	2265 [label="Check boolean DrifterChronicPain",color=orange];
		2265 -> 2266 [label=true,color=green];
		2265 -> 2269 [label=true,color=green];
		2265 -> 2267 [label=false,color=brown];
		2265 -> 2268 [label=false,color=brown];
	2266 [label="Wenn es uns eines gebracht hat, dann wohl eine gewisse Schmerztoleranz.",shape=box,color=red];
		2266 -> 2270;
	2269 [label="Manchmal aber ... wache ich auf und habe das Gefühl, dass heute der Tag sein wird, an dem ich zusammenbreche.",shape=box,color=red];
		2269 -> 2270;
	2267 [label="Es ... hört wirklich nie auf weh zu tun? Es tut mir so, so leid, Marie ...",shape=box,color=red];
		2267 -> 2271;
	2268 [label="Und es gibt keine Medikamente? Keine Behandlung?",shape=box,color=red];
		2268 -> 2272;
	2270 [label="Einmal fragte mich ein Gemeindemitglied: \"Du hast Schmerzen? Immer?\" Worauf ich antwortete: \"Oui, monsieur. Je le suis.\" Sein Blick war von Erstaunen und Entsetzen zugleich.",shape=box,color=blue];
		2270 -> 2273;
	2271 [label="Manchmal saß ich da und dachte darüber nach, was ich alles tun könnte, wenn ich nicht so viel Schmerz ertragen müsste, oui ? Wenn ich nicht so ... gefangen wäre in einem Käfig aus Fleisch, der mich bei jeder Gelegenheit so sehr behindert.",shape=box,color=blue];
		2271 -> 2274;
	2272 [label="Ich wünschte, es gäbe etwas. Aber nein, es gibt es nicht. Nicht zu meiner Zeit, und ich fürchte, wahrscheinlich auch nicht in dieser.",shape=box,color=blue];
		2272 -> 2275;
	2273 [label="\"Wie kannst du das ertragen?\", war seine nächste Frage. Und ich erinnere mich, dass ich ihn anlächelte und antwortete: \"Was bleibt mir denn sonst übrig, Monsieur ...?\"",shape=box,color=blue];
		2273 -> 2276;
		2273 -> 2277;
	2274 [label="Wie wütend mich das gemacht hat! Wie neidisch war ich auf jene, deren Körper sie nicht verraten haben. Aber was nützt das letztlich, à part rendre nos vies plus amères? Noch verbitterter?",shape=box,color=blue];
		2274 -> 2278;
	2275 [label="Manche Krankheiten sind jenseits der Heilung durch Mensch, Wissenschaft und Glauben.",shape=box,color=blue];
		2275 -> 2271;
	2276 [label="Ich habe dasselbe Gespräch schon so oft geführt ...",shape=box,color=red];
		2276 -> 2271;
	2277 [label="Genau. Es tut mir so leid.",shape=box,color=red];
		2277 -> 2279;
	2278 [label="Aucun. Ich bin, wie ich bin, und ich werde ausdauern.",shape=box,color=blue];
		2278 -> 2280;
	2279 [label="Non, es tut mir einfach nur leid, dass du ein so ähnliches Leid erfahren musstest.",shape=box,color=blue];
		2279 -> 2271;
	2280 [label="Check boolean DrifterChronicPain",color=orange];
		2280 -> 2281 [label=true,color=green];
		2280 -> 2282 [label=false,color=brown];
	2281 [label="Und so wirst du auch du es. So wirst du es. Daran glaube ich.",shape=box,color=blue];
		2281 -> 2282;
	2282 [label="+20 Chemistry",color=orange];
		2282 -> 2283;
	2283 [label="Ich kann nicht in Worte fassen, wie viel mir dieses Gespräch bedeutet hat. Deshalb sage ich einfach nur: Merci, Drifter.",shape=box,color=blue];
		2283 -> 2284;
	2284 [label="Et encore merci.",shape=box,color=blue];
		2284 -> 2285;
	2285 [label="Chat ends.",color=orange];
}