digraph {
	3964 [label="MarieRank1Convo5 begins.",color=orange];
		3964 -> 3965;
	3965 [label="Bonjour, bonjour ! Du musst der Drifter sein, oui ? Monsieur Loid hat mir sehr viel über dich erzählt. Ich freue mich sehr, dich zu \"treffen\" auf diesem ...",shape=box,color=blue];
		3965 -> 3966;
	3966 [label="Appareil cliquetant, auch wenn es clever ist !",shape=box,color=blue];
		3966 -> 3967;
	3967 [label="Ich bin Sœur Marie Leroux, aber du kannst Marie sagen. Ich bin vor Kurzem hier mit meinem Seelenbruder, Pater Lyon Allard, eingetroffen und ... naja, ich denke Monsieur Loid könnte dich vor dem Teufel gewart haben, n'est-ce pas ?",shape=box,color=blue];
		3967 -> 3968;
		3967 -> 3969;
		3967 -> 3970;
	3968 [label="Es freut mich, dich kennenzulernen. Versteh das bitte nicht falsch, ihr seid hier durchaus willkommen, aber ... was macht ihr alle hier?",shape=box,color=red];
		3968 -> 3972;
	3969 [label="Der Teufel? Du meinst den Orokin?",shape=box,color=red];
		3969 -> 3974;
	3970 [label="[Ende.]",shape=box,color=red];
		3970 -> 3971;
	3972 [label="+5 Chemistry",color=orange];
		3972 -> 3973;
	3974 [label="Oui, ce monstre irritant à la peau bleue, das uns le Cardinal anvertraut hat. Ich glaube, du kennst ihn als Albrecht Entrati ? Er ist der Grund, warum wir hier sind. Aber das ist eine sehr lange Geschichte, j'en ai bien peur.",shape=box,color=blue];
		3974 -> 3975;
		3974 -> 3976;
	3971 [label="Chat ends.",color=orange];
	3973 [label="Merci ! Das Wie und Warum unserer Anwesenheit hier ist eine lange Geschichte, j'en ai bien peur. Wir wurden von le Cardinal hier hergeschickt. Ich glaube, du kennst ihn als Albrecht Entrati ? Er vertraute uns das blauhäutige, lästige monstrueux an.",shape=box,color=blue];
		3973 -> 3975;
		3973 -> 3976;
	3975 [label="Ich tue, was ich kann, um zu helfen.",shape=box,color=red];
		3975 -> 3980;
	3976 [label="\"Anvertraut\"?",shape=box,color=red];
		3976 -> 3977;
	3980 [label="+5 Chemistry",color=orange];
		3980 -> 3981;
	3977 [label="Wir sollen tun, was wir können, um seine Seele zu leiten, si c'est possible. Et si ce n'est pas le cas ? Dann sollen wir sicherstellen, dass er keinen weiteren Schaden anrichtet.",shape=box,color=blue];
		3977 -> 3978;
		3977 -> 3979;
	3981 [label="Du bist genau, wie Monsieur Loid und die Cavia dich beschrieben haben ! Ich glaube, wir werden gute Freunde werden.",shape=box,color=blue];
		3981 -> 3983;
	3978 [label="Ich werde ich gerne helfen, wenn ich kann.",shape=box,color=red];
		3978 -> 3980;
	3979 [label="Er ist Orokin. Der einzige Weg, dass zu erreichen, ist eine Kugel zwischen die Augen.",shape=box,color=red];
		3979 -> 3982;
	3983 [label="Ah ! Ich muss gehen, entschuldige. Ich hoffe, wir sprechen uns bald wieder ! À la revoyure !",shape=box,color=blue];
		3983 -> 3984;
	3982 [label="Du klingst wie Lyon. Aber ich gebe die Hoffnung nicht auf. Noch nicht.",shape=box,color=blue];
		3982 -> 3983;
	3984 [label="Chat ends.",color=orange];
}