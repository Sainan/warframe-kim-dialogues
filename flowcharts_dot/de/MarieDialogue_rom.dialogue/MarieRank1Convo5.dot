digraph {
	"MarieRank1Convo5 begins." [color=orange];
		"MarieRank1Convo5 begins." -> j3803090734;
	j3803090734 [label="Bonjour, bonjour ! Du musst der Drifter sein, oui ? Monsieur Loid hat mir sehr viel über dich erzählt. Ich freue mich sehr, dich zu \"treffen\" auf diesem ...",shape=box,color=blue];
		j3803090734 -> j2621004410;
	j2621004410 [label="Appareil cliquetant, auch wenn es clever ist !",shape=box,color=blue];
		j2621004410 -> j3657002776;
	j3657002776 [label="Ich bin Sœur Marie Leroux, aber du kannst Marie sagen. Ich bin vor Kurzem hier mit meinem Seelenbruder, Pater Lyon Allard, eingetroffen und ... naja, ich denke Monsieur Loid könnte dich vor dem Teufel gewart haben, n'est-ce pas ?",shape=box,color=blue];
		j3657002776 -> j1420323305;
		j3657002776 -> j932245279;
		j3657002776 -> j129698615;
	j1420323305 [label="Es freut mich, dich kennenzulernen. Versteh das bitte nicht falsch, ihr seid hier durchaus willkommen, aber ... was macht ihr alle hier?",shape=box,color=red];
		j1420323305 -> j2106552108;
	j932245279 [label="Der Teufel? Du meinst den Orokin?",shape=box,color=red];
		j932245279 -> j852328698;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j2106552108 [label="+5 Chemistry",color=orange];
		j2106552108 -> j2515653162;
	j852328698 [label="Oui, ce monstre irritant à la peau bleue, das uns le Cardinal anvertraut hat. Ich glaube, du kennst ihn als Albrecht Entrati ? Er ist der Grund, warum wir hier sind. Aber das ist eine sehr lange Geschichte, j'en ai bien peur.",shape=box,color=blue];
		j852328698 -> j1071102851;
		j852328698 -> j3394435993;
	"Chat ends." [color=orange];
	j2515653162 [label="Merci ! The what and the how of our being here is a very long story, j'en ai bien peur. We were sent here by le Cardinal. I believe you know him as Albrecht Entrati ? He entrusted us with that blue-skinned monstre irritant.",shape=box,color=blue];
		j2515653162 -> j1071102851;
		j2515653162 -> j3394435993;
	j1071102851 [label="Ich tue, was ich kann, um zu helfen.",shape=box,color=red];
		j1071102851 -> j1399745643;
	j3394435993 [label="\"Anvertraut\"?",shape=box,color=red];
		j3394435993 -> j1655330023;
	j1399745643 [label="+5 Chemistry",color=orange];
		j1399745643 -> j878886838;
	j1655330023 [label="Wir sollen tun, was wir können, um seine Seele zu leiten, si c'est possible. Et si ce n'est pas le cas ? Dann sollen wir sicherstellen, dass er keinen weiteren Schaden anrichtet.",shape=box,color=blue];
		j1655330023 -> j2184489741;
		j1655330023 -> j2533209298;
	j878886838 [label="Du bist genau, wie Monsieur Loid und die Cavia dich beschrieben haben ! Ich glaube, wir werden gute Freunde werden.",shape=box,color=blue];
		j878886838 -> j2669356977;
	j2184489741 [label="Ich werde ich gerne helfen, wenn ich kann.",shape=box,color=red];
		j2184489741 -> j1399745643;
	j2533209298 [label="Er ist Orokin. Der einzige Weg, dass zu erreichen, ist eine Kugel zwischen die Augen.",shape=box,color=red];
		j2533209298 -> j1979072945;
	j2669356977 [label="Ah ! Ich muss gehen, entschuldige. Ich hoffe, wir sprechen uns bald wieder ! À la revoyure !",shape=box,color=blue];
		j2669356977 -> "Chat ends.";
	j1979072945 [label="Du klingst wie Lyon. Aber ich gebe die Hoffnung nicht auf. Noch nicht.",shape=box,color=blue];
		j1979072945 -> j2669356977;
}