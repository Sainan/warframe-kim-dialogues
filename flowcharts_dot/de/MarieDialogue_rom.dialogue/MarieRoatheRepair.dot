digraph {
	3815 [label="MarieRoatheRepair begins.",color=orange];
		3815 -> 3816;
	3816 [label="Evaluate expressions",color=orange];
		3816 -> 3817 [label="RoatheMarieDatingDeal, MarieNoDate",color=purple];
		3816 -> 3818 [label="RoatheFamilyDeal, MarieFamilyFail",color=purple];
		3816 -> 3818 [label="MarieFamilyFail",color=purple];
		3816 -> 3819 [label="RoatheMarieEntratiDeal, MarieEntratiCompleteB",color=purple];
		3816 -> 3819 [label="RoatheMarieEntratiDeal, MarieEntratiCompleteC",color=purple];
		3816 -> 3820 [label="false",color=purple];
	3817 [label="Drifter. Ich werde vom Teufel verfolgt. Er ärgert mich unaufhörlich mit seinen kleinen Ungeheuern! Alles in deinem Namen! Er sagt, du wolltest dich einfach nur kniend entschuldigen.",shape=box,color=blue];
		3817 -> 3821;
		3817 -> 3822;
	3818 [label="Ich werde vom Teufel verfolgt. Er treibt mich mit seinen kleinen Ungeheuern zur Verzweiflung ! Alles in deinem Namen ! Er sagt, du willst mit mir über meine Hilfe sprechen, Monsieur Loid nach oben zu bringen ?",shape=box,color=blue];
		3818 -> 3823;
		3818 -> 3824;
	3819 [label="Ich werde vom Teufel verfolgt. Er ärgert mich unaufhörlich mit seinen kleinen Ungeheuern ! Alles in deinem Namen ! Er sagt, du willst meine Verpflichtung gegenüber le Cardinal noch einmal besprechen ?",shape=box,color=blue];
		3819 -> 3825;
		3819 -> 3826;
	3820 [label="Chat ends.",color=orange];
	3821 [label="Ja, möchte ich.",shape=box,color=red];
		3821 -> 3827;
	3822 [label="Hat er?",shape=box,color=red];
		3822 -> 3828;
	3823 [label="Ja, möchte ich.",shape=box,color=red];
		3823 -> 3829;
	3824 [label="Hat er?",shape=box,color=red];
		3824 -> 3828;
	3825 [label="Ja, möchte ich.",shape=box,color=red];
		3825 -> 3830;
	3826 [label="Hat er?",shape=box,color=red];
		3826 -> 3828;
	3827 [label="Es tut mir unendlich leid. Ich weiß, ich habe dich beleidigt. Und das wollte ich auf keinen Fall. Glaub mir, das war das Letzte, was ich tun wollte.",shape=box,color=red];
		3827 -> 3831;
	3828 [label="Je vais le tuer ! Je savais que ce démon était rempli de la pire merde qui soit ! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses !",shape=box,color=blue];
		3828 -> 3832;
	3829 [label="Ich werde mich kurzfassen, da er in deiner Abwesenheit bereits viel Überzeugungsarbeit geleistet hat. Und wie der Teufel so an sich hat, hat er dafür durchaus gute Argumente vorgebracht.",shape=box,color=blue];
		3829 -> 3833;
	3830 [label="Ich werde mich kurzfassen, da er in deiner Abwesenheit bereits viel Überzeugungsarbeit geleistet hat. Und wie der Teufel so an sich hat, hat er dafür durchaus gute Argumente vorgebracht.",shape=box,color=blue];
		3830 -> 3834;
	3831 [label="Und warum genau?",shape=box,color=blue];
		3831 -> 3835;
		3831 -> 3836;
	3832 [label="Chat ends.",color=orange];
	3833 [label="Und ich gebe zu, dass ich ... es langsam leid bin, hier unten festzusitzen sans recours.",shape=box,color=blue];
		3833 -> 3837;
	3834 [label="Aber nicht seinen Worten, sondern seiner Klugheit solltest du danken. Er setzte mich mit Monsieur Loid zusammen.",shape=box,color=blue];
		3834 -> 3838;
		3834 -> 3839;
	3835 [label="[Gefühle gestehen.] Weil du mir sehr am Herzen liegst, Marie. Ich bin verrückt nach dir.",shape=box,color=red];
		3835 -> 3840;
	3836 [label="Schon gut. Das war ganz klar ein Fehler.",shape=box,color=red];
		3836 -> 3841;
	3837 [label="Daher, sage ich, na gut. Ich werde dir helfen. Du kannst auf meine Unterstützung zählen.",shape=box,color=blue];
		3837 -> 3842;
	3838 [label="Oh?",shape=box,color=red];
		3838 -> 3843;
	3839 [label="Aber Loid liebt Albrecht. Oder nicht?",shape=box,color=red];
		3839 -> 3844;
	3840 [label="Ich wusste, dass ich ins Fettnäpfchen treten würde. Und siehe da, es geschah.",shape=box,color=red];
		3840 -> 3845;
	3841 [label="Du bist genauso schlimm wie er.",shape=box,color=blue];
		3841 -> 3846;
	3842 [label="Update boolean MarieFamilySuccess",color=orange];
		3842 -> 3847;
	3843 [label="Es war Loids klare Sichtweise, die es mir ermöglichte, durch meine eigene getrübte Linse zu sehen. Denn Loid liebt le Cardinal – seinen Albrecht – trotz all seiner Fehler.",shape=box,color=blue];
		3843 -> 3848;
	3844 [label="Ja. Das tut er. Trotz all seiner Fehler. Und genau diese klare Sichtweise erlaubte es mir, durch meine eigene getrübte Linse zu sehen.",shape=box,color=blue];
		3844 -> 3848;
	3845 [label="Es tut mir sehr leid, dass ich mich an Roathe gewandt habe, um deine Aufmerksamkeit zu erregen, aber ich wusste nicht, an wen ich mich sonst wenden sollte.",shape=box,color=red];
		3845 -> 3849;
	3846 [label="Chat ends.",color=orange];
	3847 [label="Update boolean MarieFamilyFail",color=orange];
		3847 -> 3850;
	3848 [label="Denn was bedeutet es, einen anderen Menschen zu lieben, außer ihn mit all seinen Stärken und Schwächen anzunehmen, après tout ?",shape=box,color=blue];
		3848 -> 3851;
	3849 [label="Oh, Drifter ... mein armer Drifter. Du hättest nicht so weit gehen müssen, um meine Vergebung zu erlangen.",shape=box,color=blue];
		3849 -> 3852;
	3850 [label="Chat ends.",color=orange];
	3851 [label="Update boolean MarieEntratiCompleteA",color=orange];
		3851 -> 3853;
	3852 [label="Ich hätte dir vergeben, hättest du mich einfach darum gefragt. Du hast bereits einen Platz in meinem Herzen, weißt du ?",shape=box,color=blue];
		3852 -> 3854;
		3852 -> 3855;
	3853 [label="Update boolean MarieEntratiCompleteB",color=orange];
		3853 -> 3856;
	3854 [label="Habe ... ich?",shape=box,color=red];
		3854 -> 3857;
	3855 [label="Aber ich habe so viel durchgemacht ...",shape=box,color=red];
		3855 -> 3858;
	3856 [label="Update boolean MarieEntratiCompleteC",color=orange];
		3856 -> 3859;
	3857 [label="Oui ! Aber wenn du mit mir zusammen sein willst, dann würde ich das auch wollen.",shape=box,color=blue];
		3857 -> 3860;
		3857 -> 3861;
	3858 [label="Und das ist deine eigene Schuld, nicht meine ! Aber wenn du mit mir zusammen sein willst, dann würde ich das auch wollen.",shape=box,color=blue];
		3858 -> 3861;
		3858 -> 3860;
	3859 [label="Chat ends.",color=orange];
	3860 [label="Das würde ich liebend gerne, Marie.",shape=box,color=red];
		3860 -> 3862;
	3861 [label="Eigentlich, geht es mir gut, so wie es ist.",shape=box,color=red];
		3861 -> 3863;
	3862 [label="Ah ! Du hast mich so glücklich gemacht !",shape=box,color=blue];
		3862 -> 3864;
	3863 [label="Je vais te jeter directement dans le Néant.",shape=box,color=blue];
		3863 -> 3865;
	3864 [label="Update boolean MarieDating",color=orange];
		3864 -> 3866;
	3865 [label="Chat ends.",color=orange];
	3866 [label="Update boolean IsDating",color=orange];
		3866 -> 3867;
