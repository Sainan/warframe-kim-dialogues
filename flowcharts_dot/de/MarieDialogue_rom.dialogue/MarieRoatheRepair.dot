		j4217867269 -> "Chat ends." [label="false",color=purple];
	j2338747314 [label="Drifter. Ich werde vom Teufel verfolgt. Er ärgert mich unaufhörlich mit seinen kleinen Ungeheuern! Alles in deinem Namen! Er sagt, du wolltest dich einfach nur kniend entschuldigen.",shape=box,color=blue];
		j2338747314 -> j1691120282;
		j2338747314 -> j3401472338;
	j2913466256 [label="Ich werde vom Teufel verfolgt. Er treibt mich mit seinen kleinen Ungeheuern zur Verzweiflung ! Alles in deinem Namen ! Er sagt, du willst mit mir über meine Hilfe sprechen, Monsieur Loid nach oben zu bringen ?",shape=box,color=blue];
		j2913466256 -> j2447726620;
		j2913466256 -> j3401472338;
	j2212359584 [label="Ich werde vom Teufel verfolgt. Er ärgert mich unaufhörlich mit seinen kleinen Ungeheuern ! Alles in deinem Namen ! Er sagt, du willst meine Verpflichtung gegenüber le Cardinal noch einmal besprechen ?",shape=box,color=blue];
		j2212359584 -> j914286461;
		j2212359584 -> j3401472338;
	"Chat ends." [color=orange];
	j1691120282 [label="Ja, möchte ich.",shape=box,color=red];
		j1691120282 -> j902747593;
	j3401472338 [label="Hat er?",shape=box,color=red];
		j3401472338 -> j4177712951;
	j2447726620 [label="Ja, möchte ich.",shape=box,color=red];
		j2447726620 -> j603791550;
	j914286461 [label="Ja, möchte ich.",shape=box,color=red];
		j914286461 -> j2136569137;
	j902747593 [label="Es tut mir unendlich leid. Ich weiß, ich habe dich beleidigt. Und das wollte ich auf keinen Fall. Glaub mir, das war das Letzte, was ich tun wollte.",shape=box,color=red];
		j902747593 -> j3227703950;
	j4177712951 [label="Je vais le tuer ! Je savais que ce démon était rempli de la pire merde qui soit ! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses !",shape=box,color=blue];
		j4177712951 -> "Chat ends.";
	j603791550 [label="Ich werde mich kurzfassen, da er in deiner Abwesenheit bereits viel Überzeugungsarbeit geleistet hat. Und wie der Teufel so an sich hat, hat er dafür durchaus gute Argumente vorgebracht.",shape=box,color=blue];
		j603791550 -> j391454373;
	j2136569137 [label="Ich werde mich kurzfassen, da er in deiner Abwesenheit bereits viel Überzeugungsarbeit geleistet hat. Und wie der Teufel so an sich hat, hat er dafür durchaus gute Argumente vorgebracht.",shape=box,color=blue];
		j2136569137 -> j2027361064;
	j3227703950 [label="Und warum genau?",shape=box,color=blue];
		j3227703950 -> j36799573;
		j3227703950 -> j1148598033;
	j391454373 [label="Und ich gebe zu, dass ich ... es langsam leid bin, hier unten festzusitzen sans recours.",shape=box,color=blue];
		j391454373 -> j3415798087;
	j2027361064 [label="Aber nicht seinen Worten, sondern seiner Klugheit solltest du danken. Er setzte mich mit Monsieur Loid zusammen.",shape=box,color=blue];
		j2027361064 -> j2972018658;
		j2027361064 -> j786798962;
	j36799573 [label="[Gefühle gestehen.] Weil du mir sehr am Herzen liegst, Marie. Ich bin verrückt nach dir.",shape=box,color=red];
		j36799573 -> j63396241;
	j1148598033 [label="Schon gut. Das war ganz klar ein Fehler.",shape=box,color=red];
		j1148598033 -> j1643099606;
	j3415798087 [label="Daher, sage ich, na gut. Ich werde dir helfen. Du kannst auf meine Unterstützung zählen.",shape=box,color=blue];
		j3415798087 -> j3151953893;
	j2972018658 [label="Oh?",shape=box,color=red];
		j2972018658 -> j3371858684;
	j786798962 [label="Aber Loid liebt Albrecht. Oder nicht?",shape=box,color=red];
		j786798962 -> j1455762681;
	j63396241 [label="Ich wusste, dass ich ins Fettnäpfchen treten würde. Und siehe da, es geschah.",shape=box,color=red];
		j63396241 -> j1635794028;
	j1643099606 [label="Du bist genauso schlimm wie er.",shape=box,color=blue];
		j1643099606 -> "Chat ends.";
	j3151953893 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3151953893 -> j2529015854;
	j3371858684 [label="Es war Loids klare Sichtweise, die es mir ermöglichte, durch meine eigene getrübte Linse zu sehen. Denn Loid liebt le Cardinal – seinen Albrecht – trotz all seiner Fehler.",shape=box,color=blue];
		j3371858684 -> j3118268700;
	j1455762681 [label="Ja. Das tut er. Trotz all seiner Fehler. Und genau diese klare Sichtweise erlaubte es mir, durch meine eigene getrübte Linse zu sehen.",shape=box,color=blue];
		j1455762681 -> j3118268700;
	j1635794028 [label="Es tut mir sehr leid, dass ich mich an Roathe gewandt habe, um deine Aufmerksamkeit zu erregen, aber ich wusste nicht, an wen ich mich sonst wenden sollte.",shape=box,color=red];
		j1635794028 -> j1148865044;
	j2529015854 [label="Boolean MarieFamilyFail is now false.",color=orange];
		j2529015854 -> "Chat ends.";
	j3118268700 [label="Denn was bedeutet es, einen anderen Menschen zu lieben, außer ihn mit all seinen Stärken und Schwächen anzunehmen, après tout ?",shape=box,color=blue];
		j3118268700 -> j3722403271;
	j1148865044 [label="Oh, Drifter ... mein armer Drifter. Du hättest nicht so weit gehen müssen, um meine Vergebung zu erlangen.",shape=box,color=blue];
		j1148865044 -> j3076732245;
	j3722403271 [label="Boolean MarieEntratiCompleteA is now true.",color=orange];
		j3722403271 -> j2737891827;
	j3076732245 [label="Evaluate expressions",color=orange];
		j3076732245 -> j2528536772 [label="RoatheDating",color=purple];
		j3076732245 -> j3572759373 [label="LyonDating",color=purple];
		j3076732245 -> "Chat ends." [label="MarieDating",color=purple];
		j3076732245 -> j2770660992 [label="false",color=purple];
	j2737891827 [label="Boolean MarieEntratiCompleteB is now false.",color=orange];
		j2737891827 -> j3065315887;
	j2528536772 [label="Aber ich fürchte, du hast bereits den Teufel als Bürde, non ? Ich werde mich nicht in seine Angelegenheiten einmischen.",shape=box,color=blue];
		j2528536772 -> j701848489;
	j3572759373 [label="Aber ich fürchte, du hast dein Herz schon meinem Seelenbruder gegeben. Ich könnte es ihm nicht entreißen.",shape=box,color=blue];
		j3572759373 -> j701848489;
	j2770660992 [label="Ich hätte dir vergeben, hättest du mich einfach darum gefragt. Du hast bereits einen Platz in meinem Herzen, weißt du ?",shape=box,color=blue];
		j2770660992 -> j128829018;
		j2770660992 -> j2839527514;
	j3065315887 [label="Boolean MarieEntratiCompleteC is now false.",color=orange];
		j3065315887 -> "Chat ends.";
	j701848489 [label="Ich werde dir deine vorherigen Fehler verzeihen, aber du dich im Bezug auf deine anderen Angelegenheiten entscheiden.",shape=box,color=blue];
		j701848489 -> j1837572236;
	j128829018 [label="Habe ... ich?",shape=box,color=red];
		j128829018 -> j520425468;
	j2839527514 [label="Aber ich habe so viel durchgemacht ...",shape=box,color=red];
		j2839527514 -> j2292570646;
	j1837572236 [label="Das verstehst du sicher, n'est pas ?",shape=box,color=blue];
		j1837572236 -> j3947636400;
	j520425468 [label="Oui ! Aber wenn du mit mir zusammen sein willst, dann würde ich das auch wollen.",shape=box,color=blue];
		j520425468 -> j4043439662;
		j520425468 -> j1952770898;
	j2292570646 [label="Und das ist deine eigene Schuld, nicht meine ! Aber wenn du mit mir zusammen sein willst, dann würde ich das auch wollen.",shape=box,color=blue];
		j2292570646 -> j1952770898;
		j2292570646 -> j4043439662;
	j3947636400 [label="Boolean MarieWillDate is now true.",color=orange];
		j3947636400 -> j4047025782;
	j4043439662 [label="Das würde ich liebend gerne, Marie.",shape=box,color=red];
		j4043439662 -> j1454148357;
	j1952770898 [label="Eigentlich, geht es mir gut, so wie es ist.",shape=box,color=red];
		j1952770898 -> j488936631;
	j4047025782 [label="Boolean MarieNoDate is now false.",color=orange];
		j4047025782 -> "Chat ends.";
	j1454148357 [label="Ah ! Du hast mich so glücklich gemacht !",shape=box,color=blue];
		j1454148357 -> j1309863619;
	j488936631 [label="Je vais te jeter directement dans le Néant.",shape=box,color=blue];
		j488936631 -> "Chat ends.";
