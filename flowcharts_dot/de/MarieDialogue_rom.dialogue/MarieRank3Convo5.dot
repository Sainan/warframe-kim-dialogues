		j1847964820 -> j666627075;
	j3097971511 [label="Gut und dir?",shape=box,color=red];
		j3097971511 -> j3497518673;
	j666627075 [label="Mir ging es schon besser, danke der Nachfrage. Und dir?",shape=box,color=red];
		j666627075 -> j1749576843;
	j839843400 [label="Ich ... sollte jetzt zugeben, dass ich gelogen habe, ich bin nicht ... wirklicher ein Anhänger Sols.",shape=box,color=red];
		j839843400 -> j2729873184;
	j3817116136 [label="Besser, jetzt wo ich mit dir spreche. Aber erhellst jeden meine Tage mit deiner Anwesenheit.",shape=box,color=red];
		j3817116136 -> j2163228954;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j3497518673 [label="Soweit gut, denke ich. Wenn ich so darüber nachdenke, fühle ich mich, als sollte es nicht so sein.",shape=box,color=blue];
		j3497518673 -> j3793330751;
		j3497518673 -> j596790949;
	j1749576843 [label="Mir geht es gut, aber jetzt bin ich neugierig. Qu'y a-t-il ?",shape=box,color=blue];
		j1749576843 -> j3083233553;
		j1749576843 -> j1921495226;
		j1749576843 -> j1263484532;
		j1749576843 -> j3696351507;
	j2729873184 [label="Oh ! Ich... verstehe. Pourquoi ?",shape=box,color=blue];
		j2729873184 -> j228374492;
		j2729873184 -> j1459033564;
		j2729873184 -> j1228639541;
	j2163228954 [label="Wolf ! Wegen dir falle ich noch vom Stuhl !",shape=box,color=blue];
		j2163228954 -> j2066900939;
		j2163228954 -> j514348264;
	"Chat ends." [color=orange];
	j3793330751 [label="Was genau meinst du?",shape=box,color=red];
		j3793330751 -> j2391594198;
	j596790949 [label="Dort hat mich auch schon mal der Schuh gedrückt.",shape=box,color=red];
		j596790949 -> j2893440730;
	j3083233553 [label="Ist einfach ... schwer zu erklären.",shape=box,color=red];
		j3083233553 -> j470700758;
	j1921495226 [label="Zu Vieles, um das ich mich kümmern muss. Zu wenig Zeit.",shape=box,color=red];
		j1921495226 -> j2347093625;
	j1263484532 [label="Ein Freund beschrieb das mal als \"Spinnen\". Ab und zu schleichen sie sich ein.",shape=box,color=red];
		j1263484532 -> j4042323786;
	j3696351507 [label="Manchmal überfordert mich einfach ... alles. Aber das wird schon.",shape=box,color=red];
		j3696351507 -> j2815025909;
	j228374492 [label="Ich dachte, es wäre eine Möglichkeit, dich besser kennenzulernen ...",shape=box,color=red];
		j228374492 -> j2678871340;
	j1459033564 [label="Ich dachte, es wäre lustig?",shape=box,color=red];
		j1459033564 -> j3426448769;
	j1228639541 [label="Ich weiß es wirklich nicht. Es war einfach nur impulsiv.",shape=box,color=red];
		j1228639541 -> j1986541628;
	j2066900939 [label="Ich meine es ernst. Es tut mir leid, wenn es dir unangenehm ist.",shape=box,color=red];
		j2066900939 -> j1180282791;
	j514348264 [label="Tut mir leid. Ich habe nur gescherzt.",shape=box,color=red];
		j514348264 -> j1180282791;
	j2391594198 [label="Ich bin eine Sœur de Sol. Ich bin nicht dazu bestimmt... zu kämpfen. Zu töten. The Murmure sind nicht lebendig, sagen jedenfalls die Cavia... aber was ist mit den anderen, denen ich gegenüberstehe ?",shape=box,color=blue];
		j2391594198 -> j273965248;
	j2893440730 [label="+5 Chemistry",color=orange];
		j2893440730 -> j16854719;
	j470700758 [label="Dann werde ich nicht weiter fragen. Ich weiß, dass es manchmal schwer ist, Dinge auszudrücken.",shape=box,color=blue];
		j470700758 -> j232586527;
	j2347093625 [label="Es gab eine Schwester in der Cathédrale, die auch so war. Ist ständig nur rumgewuselt. Einmal fand ich sie um drei Uhr morgens, wie sie Silber polierte.",shape=box,color=blue];
		j2347093625 -> j2792705334;
	j4042323786 [label="Ah, oui. Ich glaube, ich weiß, was du meinst. Eine Art ... Wolke, die sich vor die Sonne schiebt.",shape=box,color=blue];
		j4042323786 -> j3123254460;
	j2815025909 [label="Wie eine Tasse, die mit Wasser gefüllt wird, Tropfen für Tropfen, non ?",shape=box,color=blue];
		j2815025909 -> j3346949713;
	j2678871340 [label="Du hättest mit keine solche mensonge erzählen müssen, um mich kennenzulernen.",shape=box,color=blue];
		j2678871340 -> j215624599;
	j3426448769 [label="Je ne comprends pas votre humour. Vielleicht ist \"lustig\" anders in der Zukunft ?",shape=box,color=blue];
		j3426448769 -> j762686818;
	j1986541628 [label="Ich weiß nicht, welcher Instinkt dich dazu gebracht mir so eine mensonge zu erzählen.",shape=box,color=blue];
		j1986541628 -> j1245100181;
	j1180282791 [label="Bon, où en étais-je ?",shape=box,color=blue];
		j1180282791 -> j4244769428;
	j273965248 [label="Im Namen Sols zu kämpfen ... soll das mein Weg sein ? Ob ich in seinem Namen töten soll ? Moi, petite Marie ?",shape=box,color=blue];
		j273965248 -> j3725539656;
		j273965248 -> j4290564728;
	j16854719 [label="Ich weiß, dass es une métaphore ist, aber ich schütte mich gerade aus vor Lachen ! Ich glaub nicht, dass meine Schuhe dich je drücken könnten!",shape=box,color=blue];
		j16854719 -> j2779240731;
	j232586527 [label="Es gibt so viele Möglichkeiten für unsere Tage und Gedanken durcheinander zu kommen. Es können dunkle Löcher entstehen, in denen wir stecken bleiben, non ?",shape=box,color=blue];
		j232586527 -> j828714532;
	j2792705334 [label="Ich fragte sie, warum sie das tat und sagte, sie könnte nicht schlagen, sie mache sich zu viele Sorgen.",shape=box,color=blue];
		j2792705334 -> j452952303;
	j3123254460 [label="Wir haben ein Wort dafür, ennui. Eine Erschöpfung und Unzufriedenheit, die alles ... sinnlos erscheinen lässt.",shape=box,color=blue];
		j3123254460 -> j945139667;
	j3346949713 [label="Irgendwann ist sie voll und läuft über. Kippt vielleicht sogar um. Und alles sieht aus, wie une catastrophe.",shape=box,color=blue];
		j3346949713 -> j3533463291;
	j215624599 [label="Eine Seele ist mehr, als der Glaube, den sie trägt. Ich bin eine Sœur de Sol, aber ich hoffe du siehst in mir mehr als das, non ?",shape=box,color=blue];
		j215624599 -> j1854772460;
	j762686818 [label="Für mich ist es das nicht.",shape=box,color=blue];
		j762686818 -> j1097657522;
	j1245100181 [label="Ich kann nur hoffen, es war gut gemeint und nicht ein böser Scherz auf meine Kosten. Also werde ich Sols Beispiel folgen ...",shape=box,color=blue];
		j1245100181 -> j404991823;
	j4244769428 [label="Check boolean DrifterFaithSol",color=orange];
		j4244769428 -> j2611166297 [label=true,color=green];
		j4244769428 -> j995154839 [label=false,color=brown];
	j3725539656 [label="Ich wurde nicht als Soldat ausgebildet. Nicht, wie das Kind. Und du auch nicht.",shape=box,color=red];
		j3725539656 -> j2201320252;
	j4290564728 [label="Ich war... nicht immer so. Nicht immer ein Kämpfer. Das musste ich auf die harte Tour lernen.",shape=box,color=red];
		j4290564728 -> j1950163649;
	j2779240731 [label="Das Bild, das ich gerade im Kopf habe, lässt mich wanken. Bevor ich nicht mehr atmen kann, sag mir - worauf beziehst du dich ?",shape=box,color=blue];
		j2779240731 -> j3725539656;
		j2779240731 -> j4290564728;
	j828714532 [label="Wir können nur versuchen, mit uns selbst geduldig und freundlich umzugehen, wenn das passiert.",shape=box,color=blue];
		j828714532 -> j2667669361;
	j452952303 [label="Ich fand sie jedes Mal so vor. Ich fragte, ob sie companie wollte. Manchmal sagte sie ja, manchmal nein.",shape=box,color=blue];
		j452952303 -> j232586527;
	j945139667 [label="Oder vielleicht meinst du den Wunsch, sich zu verstecken, zu weinen, mehr wie eine Verzweiflung, das kann ich nicht sagen.",shape=box,color=blue];
		j945139667 -> j3493201870;
	j3533463291 [label="Du machst alles sauber, stellst die Tasse wieder hin ... und alles beginnt von vorne, oui ?",shape=box,color=blue];
		j3533463291 -> j69130224;
	j1854772460 [label="Es gibt so viele Themen aus denen wir wählen können, wie Sterne am Himmel !",shape=box,color=blue];
		j1854772460 -> j2105440489;
		j1854772460 -> j3807372893;
	j1097657522 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j1097657522 -> j1508231473;
	j404991823 [label="... dessen Glauben ich folge, egal ob du es tust und ich vergebe dir. Wärst du wie Lyon, würde ich dir sagen, dass deine Strafe zehn Peitschenhiebe sind.",shape=box,color=blue];
		j404991823 -> j3559998886;
	j2611166297 [label="Ma famille à Sol ! Meine Familie in Sol, wie geht es uns heute ?",shape=box,color=blue];
