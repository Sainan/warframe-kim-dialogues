		j995154839 -> j839843400;
		j995154839 -> j129698615;
	j2201320252 [label="Oui ! Die winzige Kopie und seine traurige Geschichte... Der Gedanke daran bringt mich zum Weinen. Von denen, die wir für famille hielten, in eine Kriegsmaschine verwandelt zu werden ?",shape=box,color=blue];
		j2201320252 -> j743925383;
	j1950163649 [label="Oui ! Davon habe ich gehört, du hast viel gelitten, um das Kämpfen so zu lernen. Der Tod ist ein grausamer Lehrer, ich kann es mir nicht vorstellen...",shape=box,color=blue];
		j1950163649 -> j743925383;
	j2667669361 [label="Ich weiß nicht, ob diese Worte dir etwas bedeuten. Oder ob sie nur leuchtende Punkte auf einer surrenden machinerie sind.",shape=box,color=blue];
		j2667669361 -> j2752209557;
	j3493201870 [label="Ich kenne deinen Freund nicht, aber ich denke - es ist gut, dass sie dich haben.",shape=box,color=blue];
		j3493201870 -> j232586527;
	j69130224 [label="Es gab einen Pater in der Kirche mit einem Temperament, das deinem ähnlich war, glaube ich. Ich konnte alles aushalten - bis er es nicht mehr konnte.",shape=box,color=blue];
		j69130224 -> j2184658661;
	j2105440489 [label="Es tut mir leid. Das war dumm von mir.",shape=box,color=red];
		j2105440489 -> j2634746453;
	j3807372893 [label="Also vergibst du mir?",shape=box,color=red];
		j3807372893 -> j3769415414;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j3559998886 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j3559998886 -> j1939033961;
	j743925383 [label="Non. Ich wäre lieber so, wie ich jetzt bin. Ich entschied mich dazu le Cardinals Hand zu nehmen, das sérum, das er mir anbot.",shape=box,color=blue];
		j743925383 -> j869393159;
	j2752209557 [label="Wenn man sich die Realität vor Augen führt, könnten tatsächlich Tage oder Jahre vergangen sein, nachdem ich diese Worte geschrieben habe, je nachdem, wann du dich befindest.",shape=box,color=blue];
		j2752209557 -> j3830610554;
	j2184658661 [label="Wenn ihm alles zu viel wurde und alles wie Chaos aussah, fragte ich ihn, ob er companie wollte. Des fois, oui, des fois, non.",shape=box,color=blue];
		j2184658661 -> j232586527;
	j2634746453 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j2634746453 -> j354752691;
	j3769415414 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j3769415414 -> j4234167574;
	j1939033961 [label="Wir sind alle nur blinde Wesen, die versuchen in dieser Welt ihren Weg zu finden.",shape=box,color=blue];
		j1939033961 -> j639431561;
	j869393159 [label="Aber du kennst die Traurigkeit, die mich plagt, die Ungewissheit. Nicht in dieses Leben aus Krieg hineingeboren oder dafür erzogen worden zu sein.",shape=box,color=blue];
		j869393159 -> j1266588560;
		j869393159 -> j2497655044;
	j3830610554 [label="Ich möchte nur sagen, dass ich verstehe, dass es sich leer anfühlen kann, wenn ich sage, dass du nicht alleine bist.",shape=box,color=blue];
		j3830610554 -> j3023525416;
	j354752691 [label="+10 Chemistry",color=orange];
		j354752691 -> j2377994030;
	j4234167574 [label="+5 Chemistry",color=orange];
		j4234167574 -> j3580551728;
	j639431561 [label="Aber ich habe gefragt, wie es dir geht. Und die Frage bleibt, petit mensonge ou non.",shape=box,color=blue];
		j639431561 -> j719923705;
		j639431561 -> j1110694328;
		j639431561 -> j2502184052;
	j1266588560 [label="Manchmal denke ich daran, wie viel ich selbst herausfinden musste und ich werde etwas eifersüchtig auf das Kind und das Training, das es bekommen hat.",shape=box,color=red];
		j1266588560 -> j882285788;
	j2497655044 [label="Ich glaube, es gibt keinen \"guten\" Weg, in einem Leben aus Krieg zu landen. Hineingeboren zu werden, darin erzogen zu werden oder es zu wählen. Am Ende geht es darum, wer du bist und was du damit machst.",shape=box,color=red];
		j2497655044 -> j2323791787;
	j3023525416 [label="Dass diejenigen um dich herum fern erscheinen oder digital wirken oder vielleicht geduldig darauf warten, dass du Hallo sagst.",shape=box,color=blue];
		j3023525416 -> j1815496993;
	j2377994030 [label="Oui und wärst du wie Lyon, würde ich dir sagen, dass deine Strafe zehn Peitschenhiebe sind ! Aber das bist du nicht und ich vergebe dir.",shape=box,color=blue];
		j2377994030 -> j1939033961;
	j3580551728 [label="Oui, ich vergebe dir. Wärst du wie Lyon, würde ich dir sagen, dass deine Strafe zehn Peitschenhiebe sind.",shape=box,color=blue];
		j3580551728 -> j1939033961;
	j719923705 [label="Ging mir ehrlich gesagt schon besser.",shape=box,color=red];
		j719923705 -> j2150671948;
	j1110694328 [label="Mir geht es gut, ehrlich. Aber wie geht es dir?",shape=box,color=red];
		j1110694328 -> j3497518673;
	j2502184052 [label="Inzwischen besser, danke. Ich habe gehört, dass Beichten gut für Menschen ist, richtig?",shape=box,color=red];
		j2502184052 -> j1319958074;
	j882285788 [label="Add -1 to Thermostat counter",color=orange];
		j882285788 -> j3888284330;
	j2323791787 [label="Add 1 to Thermostat counter",color=orange];
		j2323791787 -> j2192469500;
	j1815496993 [label="Ich hoffe für dich, dass dieser Moment schnell vorbei geht.",shape=box,color=blue];
		j1815496993 -> j2552851098;
	j2150671948 [label="Qu'y a-t-il ? Was ist das Problem ?",shape=box,color=blue];
		j2150671948 -> j3083233553;
		j2150671948 -> j1921495226;
		j2150671948 -> j1263484532;
		j2150671948 -> j3696351507;
	j1319958074 [label="+5 Chemistry",color=orange];
		j1319958074 -> j3107416320;
	j3888284330 [label="+10 Chemistry",color=orange];
		j3888284330 -> j3710505606;
	j2192469500 [label="+10 Chemistry",color=orange];
		j2192469500 -> j1146431600;
	j2552851098 [label="Und sollte das nicht der Fall sein ? Dann habe ich eine Lösung, die immer hilft !",shape=box,color=blue];
		j2552851098 -> j2741842295;
	j3107416320 [label="Hah ! Oui, so ist es. Très bien, freut mich zu hören.",shape=box,color=blue];
		j3107416320 -> j3035725683;
	j3710505606 [label="Oui, aber dann wärst du nicht der verwegene Wolf, den wir kennen und lieben, oder ? Ich glaube, Sol hat dich genau dorthin gebracht, wo du sein solltest.",shape=box,color=blue];
		j3710505606 -> j2547199548;
	j1146431600 [label="Oui, dem stimme ich völlig zu. Niemand ist für den Krieg geboren. Naja, abgesehen von den \"Grin-ire\", von denen ich gehört habe, aber selbst dann...",shape=box,color=blue];
		j1146431600 -> j192373463;
	j2741842295 [label="Des pâtisseries !",shape=box,color=blue];
		j2741842295 -> j4132951681;
	j3035725683 [label="Ah ! Mittagessen ist serviert. Ich muss los. Bis später, Wolf. Ich bin froh, dass wir geredet haben.",shape=box,color=blue];
		j3035725683 -> "Chat ends.";
	j2547199548 [label="Aber ich weiß, was du meinst. Du siehst die Struktur und die Anleitung, die deinem anderen Ich gegeben wurde und wünschst dir, du hättest das auch erhalten. Vor allem, wo du so furchtbar allein warst.",shape=box,color=blue];
		j2547199548 -> j644821238;
	j192373463 [label="Ich frage mich, ob sie nicht einen anderen Weg wählen würden, wenn sie eine wirkliche Wahl hätten ?",shape=box,color=blue];
		j192373463 -> j1749095977;
		j192373463 -> j286798173;
	j4132951681 [label="Check boolean MarieRoathePastry1",color=orange];
		j4132951681 -> j1899202346 [label=true,color=green];
		j4132951681 -> j4281788528 [label=true,color=green];
		j4132951681 -> j2304596789 [label=true,color=green];
		j4132951681 -> j4281788528 [label=false,color=brown];
		j4132951681 -> j4276179994 [label=false,color=brown];
	j644821238 [label="Ich kann nicht anders, als eine winzige Kopie zu sehen, die so alleine ist... und ein Wolf, der mit einem Rudel läuft.",shape=box,color=blue];
		j644821238 -> j4110604077;
	j1749095977 [label="Es ist schwer, das abzuschütteln, wenn einem eingeimpft wurde, dass dies die einzige Existenz, der einzige Zweck ist. Zweck gibt Menschen Trost.",shape=box,color=red];
		j1749095977 -> j2828387240;
	j286798173 [label="Ich denke schon. Ich habe ein paar von ihnen getroffen, die mir bewiesen haben, dass es bei den Grineer um mehr geht, als nur Krieg und Tod.",shape=box,color=red];
		j286798173 -> j2745953047;
	j1899202346 [label="Ich muss nur sicherstellen, dass ich genug Teilchen für alle habe.",shape=box,color=red];
		j1899202346 -> j2220033007;
	j4281788528 [label="Danke Marie.",shape=box,color=red];
		j4281788528 -> j4284045448;
	j2304596789 [label="Ich lasse Roathe einfach nicht in ihre Nähe.",shape=box,color=red];
		j2304596789 -> j3668726030;
	j4276179994 [label="Teilchen sind nie verkehrt.",shape=box,color=red];
		j4276179994 -> j1453138965;
	j4110604077 [label="Ich denke, das Blatt hat sich gewendet, non ?",shape=box,color=blue];
		j4110604077 -> j1002178338;
		j4110604077 -> j3073038268;
	j2828387240 [label="Add -1 to Thermostat counter",color=orange];
		j2828387240 -> j3987690330;
	j2745953047 [label="Add 1 to Thermostat counter",color=orange];
		j2745953047 -> j219397012;
	j2220033007 [label="+20 Chemistry",color=orange];
		j2220033007 -> j968235303;
	j4284045448 [label="+20 Chemistry",color=orange];
		j4284045448 -> j4232126126;
	j3668726030 [label="+20 Chemistry",color=orange];
		j3668726030 -> j430102038;
	j1453138965 [label="Lass nur den Teufel nicht in ihre Nähe. Sinon, il va les voler ! Er hat die Angewohnheit, Süßigkeiten zu stehlen, wenn er nicht satt wird !",shape=box,color=blue];
		j1453138965 -> j420323306;
	j1002178338 [label="Sie sind immer noch auf dem Weg der Besserung. Ihre Reise ist noch nicht beendet.",shape=box,color=red];
		j1002178338 -> j1021724058;
	j3073038268 [label="Ich wünschte, ich könnte mehr für sie tun.",shape=box,color=red];
		j3073038268 -> j1021724058;
	j3987690330 [label="Oui, du hast recht. So viele suchen den Glauben in der Hoffnung, genau das zu finden... einen Zweck. Eine Richtung.",shape=box,color=blue];
		j3987690330 -> j824948096;
	j219397012 [label="(So wird das geschrieben, danke !) Es freut mich, das zu hören. Dass sogar eine Rasse der beigebracht wurde, dass dies ihr einziger Zweck sei, einen anderen finden kann.",shape=box,color=blue];
		j219397012 -> j3630584584;
	j968235303 [label="So ist es richtig ! Auch ein Teufel verdient ab und an ein Teilchen, nehme ich an.",shape=box,color=blue];
		j968235303 -> j2596269032;
	j4232126126 [label="Je vous en prie. Ich hoffe, ich konnte dich etwas aufmuntern. Jedenfalls hast du mich aufgemuntert.",shape=box,color=blue];
		j4232126126 -> "Chat ends.";
	j430102038 [label="Ach, ich beklage mich, aber sogar der niedrigste Teufel hat sich dann und wann ein paar Teilchen verdient, oui ?",shape=box,color=blue];
