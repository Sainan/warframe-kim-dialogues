		2084 -> 2089;
	2085 [label="Er war so etwas wie der Anführer der Gruppe. Und er sorgte immer dafür, dass mich niemand schikanierte und dass es mir an nichts fehlt.",shape=box,color=blue];
		2085 -> 2090;
	2086 [label="Es galt, den Schein zu wahren, oui ? Standards einzuhalten.",shape=box,color=blue];
		2086 -> 2091;
	2087 [label="Bien ! Ich hatte befürchtet, dass meine Metaphern mit mir durchgehen.",shape=box,color=blue];
		2087 -> 2092;
	2088 [label="Marie und ihre Metaphern. Ah, bon.",shape=box,color=blue];
		2088 -> 2092;
	2089 [label="Mince alors. Ich hatte schon befürchtet, dass meine Metaphern wieder mit mir durchgehen.",shape=box,color=blue];
		2089 -> 2092;
	2090 [label="Er half mir sogar dabei, mir des béquilles zu bauen – du würdest das ... äh ... Krücken nennen ? Aus Holz, das wir zusammengesucht hatten, damit konnte ich mich herumschleppen.",shape=box,color=blue];
		2090 -> 2093;
	2091 [label="Was also sollte mit der armen, missgebildeten Marie geschehen? Man brachte mich in die Cité de la Lumière, wo ich mit Sicherheit auf der Straße enden würde ...",shape=box,color=blue];
		2091 -> 2094;
	2092 [label="Hm. Mir fällt auf, Lyon mit einem streunenden Hund zu vergleichen ist nicht gerade sehr schmeichelhaft ... ",shape=box,color=blue];
