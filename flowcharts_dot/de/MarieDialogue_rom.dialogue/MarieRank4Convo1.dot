		2055 -> 2056;
	2056 [label="Aber du machst dir Sorgen, du willst ihm helfen – ich bin sicher, er weiß das. Ah ! So in etwa. Er ist wie ein streunender Hund mit einer Narbe am Bein. Sie ist verheilt, aber falsch verheilt. Deshalb schmerzt sie weiterhin und juckt.",shape=box,color=blue];
		2056 -> 2065;
	2057 [label="Moment, ich wollte nicht, dass du dich einmischst!",shape=box,color=red];
