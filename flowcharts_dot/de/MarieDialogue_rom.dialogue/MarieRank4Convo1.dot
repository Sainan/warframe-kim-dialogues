	2100 [label="Aber er hat uns eine Nachricht hinterlassen. Kaum lesbar. Er war der Einzige von den anderen Kindern, der lesen und schreiben konnte, und ich musste sie vorlesen.",shape=box,color=blue];
		2100 -> 2105;
	2101 [label="Sechs ? Sieben ? In ihren Augen hatten sie jahrelang ihr Bestes gegeben, um mich zu heilen. Lehrer, die mir das Gehen beibrachten. Beinstützen. Schuhe.",shape=box,color=blue];
		2101 -> 2106;
