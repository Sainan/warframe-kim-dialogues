		2103 -> 2107;
	2104 [label="Dein Geheimnis ist bei mir sicher.",shape=box,color=red];
		2104 -> 2108;
	2105 [label="Ich erinnere mich, wie meine Stimme versagte. Aber ich musste stark bleiben. Denn schon damals wusste ich, ich habe den anderen gegenüber eine Pflicht.",shape=box,color=blue];
		2105 -> 2109;
	2106 [label="Sie waren dieser Last überdrüssig. Und so landete ich, kaum in der Lage, zu lesen und zu schreiben, im Dreck.",shape=box,color=blue];
		2106 -> 2110;
		2106 -> 2111;
	2107 [label="Quelle horrible personne ! J'espère que votre chaise va s'effondrer et vous donner plein d'échardes douloureuses !",shape=box,color=blue];
		2107 -> 2112;
	2108 [label="Merci ! Was für eine Erleichterung ...",shape=box,color=blue];
		2108 -> 2113;
	2109 [label="Hugo schien immer so fröhlich, sagten sie zu mir. Si joyeux. Er begegnete dem Leben stets mit einem Lachen und einem Grinsen.",shape=box,color=blue];
		2109 -> 2114;
	2110 [label="Das ist entsetzlich.",shape=box,color=red];
		2110 -> 2115;
	2111 [label="Wie hast du überlebt?",shape=box,color=red];
		2111 -> 2115;
	2112 [label="Chat ends.",color=orange];
	2113 [label="Chat ends.",color=orange];
	2114 [label="Selbst wenn wir verjagt wurden oder er wegen Diebstahls oder Herumlungerns mit einem Stock geschlagen wurde, schien ihn das nicht zu stören.",shape=box,color=blue];
		2114 -> 2116;
	2115 [label="Check boolean MarieSecretPower",color=orange];
		2115 -> 2117 [label=true,color=green];
		2115 -> 2118 [label=false,color=brown];
	2116 [label="Doch wir wissen nie, wie tief der Schmerz anderer in ihren Herzen ist. Und aus diesem Brief wusste ich, dass er mit Lua weinte.",shape=box,color=blue];
		2116 -> 2119;
	2117 [label="Es war, wie du sagtest, non ? Alle Unannehmlichkeiten bringen eine geheime Macht mit sich.",shape=box,color=blue];
		2117 -> 2118;
	2118 [label="Was mich zu indésirable pour ma mère machte, machte mich bei den anderen Straßenkindern sehr beliebt.",shape=box,color=blue];
		2118 -> 2120;
	2119 [label="Doch nun fand er Frieden an ihrer Seite. Eine Zeit lang war ich ihm böse, dass er gegangen war. Denn die anderen suchten bei mir Rat. Und ich war ihm böse, dass er mich im Stich gelassen hat.",shape=box,color=blue];
		2119 -> 2121;
	2120 [label="Was ist weitaus mehr pathétique als ein Kind ohne Füße, oui ? Ich verdiente an einem Tag durch betteln mehr, als sie in einer Woche zusammenstehlen konnten.",shape=box,color=blue];
		2120 -> 2122;
	2121 [label="Doch mit der Zeit begriff ich die Wahrheit dahinter.",shape=box,color=blue];
		2121 -> 2123;
	2122 [label="Und ich habe immer gern geteilt. Deshalb hatte ich viele Freunde, die auf mich aufpassten und sich um mich kümmerten. Hugo, ein großer, älterer Junge war einer von ihnen.",shape=box,color=blue];
		2122 -> 2085;
	2123 [label="Wir können uns nur selbst vergeben, dass wir menschlich sind. Und uns den Schmerz ihres Abschieds vergeben.",shape=box,color=blue];
		2123 -> 2124;
	2124 [label="Denn es ist ihre Abwesenheit, die uns schmerzt. Und der Gedanke, dass wir nicht mehr tun konnten, um ihnen zu helfen.",shape=box,color=blue];
		2124 -> 2125;
	2125 [label="Wir werden niemals die Lasten kennen, die andere tragen.",shape=box,color=blue];
		2125 -> 2126;
	2126 [label="Und das ist eine große tragédie. Aber das ist es, was es heißt, Mensch zu sein.",shape=box,color=blue];
		2126 -> 2127;
	2127 [label="Ich weiß nicht, ob dir diese Geschichte geholfen hat. Ich bete, dass sie es getan hat. Ich muss gehen, Monsieur Loid ruft.",shape=box,color=blue];
		2127 -> 2128;
		2127 -> 2129;
	2128 [label="Danke, Marie.",shape=box,color=red];
		2128 -> 2130;
	2129 [label="[Schweig.]",shape=box,color=red];
		2129 -> 2131;
	2130 [label="+20 Chemistry",color=orange];
		2130 -> 2132;
	2131 [label="+20 Chemistry",color=orange];
		2131 -> 2133;
	2132 [label="Gerne geschehen. À bientôt.",shape=box,color=blue];
		2132 -> 2134;
	2133 [label="À la revoyure.",shape=box,color=blue];
		2133 -> 2135;
