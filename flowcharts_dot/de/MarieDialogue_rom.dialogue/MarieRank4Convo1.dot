		2070 -> 2060;
	2071 [label="Du kennst den Anfang meiner Geschichte, aber es gibt einen Teil, den ich dir nicht erzählt habe.",shape=box,color=blue];
		2071 -> 2077;
	2072 [label="Update boolean MarieBackstory1",color=orange];
		2072 -> 2078;
	2073 [label="Es schmerzt ihn, aber es ist dennoch ein Teil von ihm. Und wenn du ihm avec colère begegnest, wenn du grob bist, wird er vor deiner Berührung zurückschrecken.",shape=box,color=blue];
		2073 -> 2079;
	2074 [label="Chat ends.",color=orange];
	2075 [label="Chat ends.",color=orange];
	2076 [label="Chat ends.",color=orange];
	2077 [label="Ich habe dir erzählt, dass ich als jeune fille auf der Straße bettelte. Und dass es mir gut ging und ich viele Freunde hatte.",shape=box,color=blue];
		2077 -> 2080;
	2078 [label="Ich wurde in eine reiche famille hineingeboren, was dich vielleicht überrascht. Die bürgerliche Klasse, den Orokin näher, als sonst nichts.",shape=box,color=blue];
		2078 -> 2081;
	2079 [label="Du musst dir das Vertrauen des Streuners verdienen. Lasse ihn zu dir kommen, non ? Macht das SInn ?",shape=box,color=blue];
		2079 -> 2082;
		2079 -> 2083;
		2079 -> 2084;
	2080 [label="Hugo, ein großer, älterer Junge war einer von ihnen.",shape=box,color=blue];
		2080 -> 2085;
	2081 [label="Aber so geboren, wie ich war ... deformiert, mit mes pieds tordus et inutilisables ? Oh, das konnte ma mère nicht ertragen.",shape=box,color=blue];
		2081 -> 2086;
	2082 [label="Ja, tatsächlich. Danke.",shape=box,color=red];
		2082 -> 2087;
