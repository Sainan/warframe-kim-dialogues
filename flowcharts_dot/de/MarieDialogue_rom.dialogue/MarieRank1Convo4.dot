digraph {
	"MarieRank1Convo4 begins." [color=orange];
		"MarieRank1Convo4 begins." -> j3227087977;
	j3227087977 [label="Darf ich eine, wie ich hoffe, nicht unhöfliche Frage stellen ? Unsere Freundschaft steht noch ganz am Anfang, insbesondere für dich, da du, wie man hört, schon so viele Jahre kennst.",shape=box,color=blue];
		j3227087977 -> j1629720117;
		j3227087977 -> j1797419798;
		j3227087977 -> j129698615;
	j1629720117 [label="Ehrlich gesagt habe ich die meisten Jahre, die ich kenne, vergessen.",shape=box,color=red];
		j1629720117 -> j1763238663;
	j1797419798 [label="Natürlich macht es mir nichts aus. Nur zu.",shape=box,color=red];
		j1797419798 -> j2947588656;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j1763238663 [label="Sol ! Du brichst mir mit deinen Worten das Herz. Du und der Teufel, ihr beide findet euren Verstand leer vor, wie ein Buch, aus dem Kapitel entfernt wurden, non ?",shape=box,color=blue];
		j1763238663 -> j2885509326;
		j1763238663 -> j2252407457;
	j2947588656 [label="+5 Chemistry",color=orange];
		j2947588656 -> j523704316;
	"Chat ends." [color=orange];
	j2885509326 [label="Ich vermisse die Teile meiner Vergangenheit nicht, die mir fehlen.",shape=box,color=red];
		j2885509326 -> j4185828422;
	j2252407457 [label="Wenn auch aus ganz unterschiedlichen Gründen, ja.",shape=box,color=red];
		j2252407457 -> j437997654;
	j523704316 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j523704316 -> j1109477919 [label="x > 0",color=purple];
		j523704316 -> j3829443565 [label="x <= 0",color=purple];
		j523704316 -> j3829443565 [label="false",color=purple];
	j4185828422 [label="Wirklich? Dann scheinst nur du dies nicht zu tun. Zwischen dem Kind und dem Teufel scheinen alle nach Teilen von sich selbst zu suchen, die sie verloren haben.",shape=box,color=blue];
		j4185828422 -> j1348717291;
		j4185828422 -> j3351582859;
	j437997654 [label="Ist es zu viel verlangt von mir, zu fragen, warum du dessen beraubt bist ? Die Gründe des Kindes und des Teufels sind mir bekannt, aber nicht deine.",shape=box,color=blue];
		j437997654 -> j1348717291;
		j437997654 -> j3351582859;
	j1109477919 [label="Warum hast du sich bereit erklärt, dem Teufel bei seinen Bemühungen zu helfen? Ich habe gehört, dass du für die Ermordung der seinen verantwortlich bist.",shape=box,color=blue];
		j1109477919 -> j3031182080;
		j1109477919 -> j1782526858;
		j1109477919 -> j1215811054;
	j3829443565 [label="Willst du dem Teufel bei seinen Bemühungen helfen? Ich habe gehört, du bist für die Ermordung der seinen verantwortlich.",shape=box,color=blue];
		j3829443565 -> j3031182080;
		j3829443565 -> j1782526858;
		j3829443565 -> j1215811054;
	j1348717291 [label="Ich habe eine unbekannte Anzahl von Jahren damit verbracht, durch die Hand von ... nun ja? Mir selbst zu sterben. Es macht mir nichts aus, dass ich mich nicht an jedes davon erinnern kann.",shape=box,color=red];
		j1348717291 -> j55352310;
	j3351582859 [label="Zusammenfassend kann ich sagen, dass ich viele Jahre lang gelitten habe. Ich schätze, es ist eine Art Selbstschutzmechanismus, zu vergessen.",shape=box,color=red];
		j3351582859 -> j789446032;
	j3031182080 [label="Das war mein anderes Ich. Ich glaube, dass die Schuld beim einzelnen liegen sollte, nicht bei der Gesellschaft.",shape=box,color=red];
		j3031182080 -> j1414375193;
	j1782526858 [label="Das war nicht ich, das war das Kind. Aber ich hasse die Orokin genauso sehr wie das Kind.",shape=box,color=red];
		j1782526858 -> j1921643583;
	j1215811054 [label="Ich war nicht dabei, in der Nacht der Naga-Trommeln, als die Tenno sich gegen die Orokin gewendet haben. Das war das Kind.",shape=box,color=red];
		j1215811054 -> j3049146436;
	j55352310 [label="Und ich mache dir auch keine Vorwürfe. Wäre ich auf diese Weise missbraucht worden, würde ich auch alles vergessen wollen. Zumindest würde ich nicht danach suchen.",shape=box,color=blue];
		j55352310 -> j2231502967;
	j789446032 [label="Das bezweifele ich nicht l! Wenn ich solchen Misshandlungen ausgesetzt wäre, würde meine Seele vermutlich etwas Ähnliches tun. Alles verstecken, was nicht repariert werden kann und nichts nützt.",shape=box,color=blue];
		j789446032 -> j2231502967;
	j1414375193 [label="Add 1 to Thermostat counter",color=orange];
		j1414375193 -> j1904779345;
	j1921643583 [label="Add -1 to Thermostat counter",color=orange];
		j1921643583 -> j245420816;
	j3049146436 [label="Nacht der Naga-Trommeln. Oh, ich sehe es vor meinem geistigen Auge. Quelles couleurs magnifiques !",shape=box,color=blue];
		j3049146436 -> j2905650528;
	j2231502967 [label="+5 Chemistry",color=orange];
		j2231502967 -> j1799861212;
	j1904779345 [label="Oui, je comprends. Wir sind so schnell dabei, Gebäude niederzubrennen, obwohl der Gestank von den Ratten in den Mauern verursacht wird.",shape=box,color=blue];
		j1904779345 -> j1621308709;
	j245420816 [label="Je meurs d'envie de savoir pourquoi ! Aber darüber sprechen wir ein anderes Mal. Sonst bleiben wir ewig hier, und Monsieur Loid wird böse auf mich.",shape=box,color=blue];
		j245420816 -> j4192617946;
	j2905650528 [label="Für weitere Einzelheiten muss ich mit Monsieur Loid sprechen. Aber !",shape=box,color=blue];
		j2905650528 -> j4192617946;
	j1799861212 [label="Dies könnte mir jedoch einen Einblick in das geben, worüber ich mit dir sprechen wollte.",shape=box,color=blue];
		j1799861212 -> j523704316;
	j1621308709 [label="Aber darüber sprechen wir ein anderes Mal. Sonst bleiben wir ewig hier, und Monsieur Loid wird böse auf mich.",shape=box,color=blue];
		j1621308709 -> j4192617946;
	j4192617946 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4192617946 -> j3976158555 [label="x > 0",color=purple];
		j4192617946 -> j1946511322 [label="x <= 0",color=purple];
		j4192617946 -> j1946511322 [label="false",color=purple];
	j3976158555 [label="Pardonnez-moi ! Ich gebe dir keine Gelegenheit zu antworten. Warum also dem Teufel helfen ?",shape=box,color=blue];
		j3976158555 -> j3587015332;
		j3976158555 -> j3587657952;
		j3976158555 -> j3552019849;
		j3976158555 -> j2167016617;
	j1946511322 [label="Pardonnez-moi ! Ich gebe dir keine Gelegenheit zu antworten. Wirst du dem Teufel helfen ?",shape=box,color=blue];
		j1946511322 -> j2167016617;
		j1946511322 -> j3552019849;
		j1946511322 -> j3587657952;
		j1946511322 -> j3587015332;
	j3587015332 [label="Er hat noch nichts getan, das beweist, dass er es nicht wert ist, ihm zu helfen ... noch nicht.",shape=box,color=red];
		j3587015332 -> j1435625562;
	j3587657952 [label="Ich glaube nicht, ich kann es mir zur Aufgabe machen, Verbündete abzuweisen.",shape=box,color=red];
		j3587657952 -> j652172455;
	j3552019849 [label="[Gesteht Interesse an Roathe.] Er hat etwas Fesselndes an sich ...",shape=box,color=red];
		j3552019849 -> j3870827882;
	j2167016617 [label="Er scheint das zu tun, was zum Überleben nötig ist. Das kann ich ihm nicht verübeln.",shape=box,color=red];
		j2167016617 -> j1735731860;
	j1435625562 [label="Add 1 to Thermostat counter",color=orange];
		j1435625562 -> j411003167;
	j652172455 [label="Boolean MarieRoatheSoldier is now true.",color=orange];
		j652172455 -> j2140946084;
	j3870827882 [label="Boolean DrifterRoathe is now true.",color=orange];
		j3870827882 -> j456994481;
	j1735731860 [label="Add -1 to Thermostat counter",color=orange];
		j1735731860 -> j1098824820;
	j411003167 [label="+5 Chemistry",color=orange];
		j411003167 -> j451823278;
	j2140946084 [label="Ah, ich verstehe. Du bist einfach nur im Geschäft, Soldaten zu sammeln. Aber dieser Teufel würde dir eher einen Dolch zwischen die Rippen rammen, als dir den Rücken zu decken.",shape=box,color=blue];
		j2140946084 -> j207819473;
	j456994481 [label="Le diable séduit les cœurs les plus forts. Er spielt das listige Spiel, aber sei vorsichtig. Stell sicher, dass er dir in die Augen sieht und sonst nirgends. ",shape=box,color=blue];
		j456994481 -> j1969469449;
	j1098824820 [label="Mir scheint, er hat länger überlebt, als irgendjemand sollte. Ich denke, vielleicht sollte die Hölle sich das Ihrige zurückholen, denn es scheint sich davongemacht zu haben.",shape=box,color=blue];
		j1098824820 -> j1969469449;
	j451823278 [label="Ich lobe dein Mitgefühl, es erfüllt mein Herz mit Freude. Die Himmlischen lehren uns, dass allen geholfen werden kann. Allen kann vergeben werden. Aber ... nur, wenn sie darum bitten.",shape=box,color=blue];
		j451823278 -> j4196120598;
	j207819473 [label="Er ist nicht dein Verbündeter und wird es auch nie sein. Dieser Teufel steht nur auf der Seite derer, die seinen Bedürfnissen dienen.",shape=box,color=blue];
		j207819473 -> j1303848446;
		j207819473 -> j2817340683;
		j207819473 -> j2839059009;
	j1969469449 [label="+5 Chemistry",color=orange];
		j1969469449 -> j6789889;
	j4196120598 [label="Endlose Plackerei, um denen zu helfen, die auf dem Gebiet ihrer eigenen Erlösung nie schwitzen, ist das Leben eines Sklaven, der in Not geraten ist.",shape=box,color=blue];
		j4196120598 -> j1303848446;
		j4196120598 -> j2817340683;
		j4196120598 -> j2839059009;
	j1303848446 [label="Ich weiß mehr über die Orokin und seine Situation als du. Ich brauche deine Hilfe nicht.",shape=box,color=red];
		j1303848446 -> j1209991428;
	j2817340683 [label="Ich weiß deine Warnungen zu schätzen. Ich werde sie im Hinterkopf behalten, wenn ich mich mit ihm abgebe.",shape=box,color=red];
		j2817340683 -> j3140555916;
	j2839059009 [label="Danke. Aber ich komme schon klar. Und, was noch wichtiger ist: Ich habe mich schon mit Schlimmerem auseinandergesetzt.",shape=box,color=red];
		j2839059009 -> j3106000603;
	j6789889 [label="Aber ich bin unfreundlich ... du kennst ihn nicht. Du siehst ihn nicht als das, was er ist. Ich möchte einfach nicht, dass du verletzt wirst.",shape=box,color=blue];
		j6789889 -> j1303848446;
		j6789889 -> j2817340683;
		j6789889 -> j2839059009;
	j1209991428 [label="Boolean MarieRoatheWarning is now true.",color=orange];
		j1209991428 -> j3376718167;
	j3140555916 [label="+10 Chemistry",color=orange];
		j3140555916 -> j3779503241;
	j3106000603 [label="+5 Chemistry",color=orange];
		j3106000603 -> j659445403;
	j3376718167 [label="Pardon. Ich kenne dich kaum oder deine Widerstandskraft gegen Manipulation. Ich mache mir nur Sorgen, weil wir dir unser Leid aufgebürdet haben.",shape=box,color=blue];
		j3376718167 -> j219683321;
	j3779503241 [label="Das ist alles, worum ich bitten kann. Merci, merci, merci. Nun muss ich leider gehen.",shape=box,color=blue];
		j3779503241 -> "Chat ends.";
	j659445403 [label="Oui, vous avez raison. Ich kenne dich kaum oder deine Widerstandskraft gegen Manipulation. Ich mache mir nur Sorgen, weil wir dir unser Leid aufgebürdet haben.",shape=box,color=blue];
		j659445403 -> j1623913055;
	j219683321 [label="Ich werde nicht noch erneut deine Grenzen überschreiten.",shape=box,color=blue];
		j219683321 -> "Chat ends.";
	j1623913055 [label="Und jetzt fürchte ich, dass ich gehen muss.",shape=box,color=blue];
		j1623913055 -> "Chat ends.";
}