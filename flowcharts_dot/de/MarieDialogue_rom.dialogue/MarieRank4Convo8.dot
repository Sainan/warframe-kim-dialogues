		1591 -> 1599;
	1592 [label="Ein weiterer Beweis dafür, dass der Teufel und seinesgleichen zu Recht verurteilt wurden. Aber vielleicht hast du mit Otak und seinesgleichen recht, oder vielleicht beruhigt es dich, das zu glauben.",shape=box,color=blue];
		1592 -> 1593;
	1593 [label="Und auch, wenn wir am Ende vielleicht falsch liegen ... es schadet nie Güte und Respekt zu zeigen.",shape=box,color=blue];
		1593 -> 1600;
	1594 [label="Vielleicht hast du recht, aber ich glaube nicht, dass die Orokin-Teufel mehr über die Funktionsweise der Seele wussten als wir. Sie waren keine großen Götter.",shape=box,color=blue];
		1594 -> 1593;
	1595 [label="Vielleicht hast du recht, oder vielleicht beruhigt es dich, das zu glauben.",shape=box,color=blue];
