		1948 -> 1560 [label="false",color=purple];
	1949 [label="Oui ! Du hast Recht, das ist der Kern oder eher der Schädel der Sache - ha. Einer hält ihn für sacro-saint, der andere für eine copie.",shape=box,color=blue];
		1949 -> 1948;
	1947 [label="Er war allem Anschein nach ein Genie und der Kopf hinter der Nutzung von Argon-Kristallen.",shape=box,color=red];
		1947 -> 1556;
	1558 [label="Wie kann Monsieur Necraloid eine Seele haben, wenn er nicht mal seine eigenen Knochen hat ?",shape=box,color=blue];
		1558 -> 1562;
		1558 -> 1563;
		1558 -> 1564;
	1557 [label="Ist dies ein weiterer Beweis dafür, dass Monsieur Necraloid keine Seele hat ?",shape=box,color=blue];
		1557 -> 1562;
		1557 -> 1563;
		1557 -> 1564;
	1559 [label="Ich weiß, dass du dir nicht sicher bist, ob Monsieur Necraloid eine Seele haben kann. Aber ich wüsste nicht, wie das gehen sollte, er hat nicht einmal seine eigenen Knochen.",shape=box,color=blue];
		1559 -> 1562;
		1559 -> 1563;
		1559 -> 1564;
	1560 [label="Ich spreche von einem sehr komplexen Stück Technologie, das einem Menschen ähnelt, nicht wahr ? Ein phonographe, aber viel, viel komplexer.",shape=box,color=blue];
		1560 -> 1565;
		1560 -> 1566;
		1560 -> 1567;
		1560 -> 1568;
		1560 -> 1569;
	1556 [label="Die aus dem Void gewonnen werden – sie sind der Grund, warum wir viele der mächtigen Warframes und Waffen erschaffen können, die wir herstellen.",shape=box,color=red];
		1556 -> 1561;
	1562 [label="Vielleicht hast du recht. Vielleicht sind sie wirklich nur Kopien von Menschen. Aber ich bin mir da nicht sicher und wir sollten sie trotzdem wie Menschen behandeln.",shape=box,color=red];
		1562 -> 1571;
	1563 [label="Ich glaube, Necraloid ist die Ausnahme, nicht die Regel. Er wurde als Replik einer Person geschaffen, nicht aus einer Person.",shape=box,color=red];
		1563 -> 1572;
	1564 [label="Du hast recht. Es ist wohl besser und humaner, wenn sie nicht tatsächlich Seelen sind, die in ausgeklügelter Wissenschaft gefangen sind...",shape=box,color=red];
		1564 -> 1573;
	1565 [label="Necraloid hat zwar keine Seele, ist aber einzigartig. Andere Cephalons, wie Otak, haben eine Seele. Sie wurden durch ihre Entstehung zerstört.",shape=box,color=red];
		1565 -> 1574;
	1566 [label="Du hast recht. Was soll ich also dagegen tun?",shape=box,color=red];
		1566 -> 1575;
	1567 [label="Du hast recht. Sie haben keine. Aber das heißt nicht, dass wir sie einfach schlecht behandeln können.",shape=box,color=red];
		1567 -> 1576;
	1568 [label="Ich weiß nicht, ob du recht hast oder nicht. Aber sie können weiterhin denken und fühlen, und wir können sie nicht wie Dinge behandeln.",shape=box,color=red];
		1568 -> 1577;
	1569 [label="Necraloid hat eine Seele. Alle Cephalons haben eine.",shape=box,color=red];
		1569 -> 1578;
	1561 [label="Er spezialisierte sich auf Kristallographie. Und seine Arbeiten wurden hier in den Laboren archiviert.",shape=box,color=red];
		1561 -> 1570;
