		1602 -> 1609;
	1614 [label="Merci ! À la revoyure !",shape=box,color=blue];
		1614 -> 1617;
	1615 [label="Oh ! Es ist eines der Rituale von Lua. Am Todestag einer Seele flechtet man eine Krone oder einen Kranz aus Blumen und legt ihn auf den Schädel der Person oder auf ihr Grab.",shape=box,color=blue];
		1615 -> 1618;
	1616 [label="Merci, werd ich haben ! À la revoyure !",shape=box,color=blue];
		1616 -> 1617;
	1609 [label="Oui. Aber es ist nicht sein Schweigen, was mich beunruhigt. Ich habe Monsieur Necraloid gefragt, ob der Schädel, den er trägt, irgendwann einem lebenden Wesen gehörte oder nicht.",shape=box,color=blue];
		1609 -> 1936;
	1617 [label="Chat ends.",color=orange];
	1618 [label="In traditionellen Gruften lagen die Toten oft offen aufgebahrt, oui ? Also könntest du das machen. Ich glaube manches davon, überdauert bis heute.",shape=box,color=blue];
		1618 -> 1619;
	1619 [label="Ich kann es in einigen Kunstwerken der Orokin sehen, ihre Liebe zu Schädeln.",shape=box,color=blue];
		1619 -> 1620;
		1619 -> 1621;
		1619 -> 1622;
	1620 [label="Das erklärt so einiges.",shape=box,color=red];
		1620 -> 1623;
	1621 [label="Je mehr sich Dinge ändern, wie?",shape=box,color=red];
		1621 -> 1623;
	1622 [label="Ich glaube Tochter hat das schon einmal versucht, du machst sie noch eifersüchtig.",shape=box,color=red];
		1622 -> 1624;
	1623 [label="Oui ! Es ist soviel Zeit vergangen und doch ist der Einfluss geblieben. Es freut mich zu wissen, dass selbst eine Kleinigkeit noch davon über ist.",shape=box,color=blue];
		1623 -> 1625;
	1624 [label="Oui ? Dann freue ich mich auf den Tag, an dem ich sie treffe ! Ich werde ihr sagen, dass ich ihm keine Wahl gelassen habe.",shape=box,color=blue];
		1624 -> 1625;
	1625 [label="Faux Schädel oder nicht, Monsieur Necraloid sollte eine Krone haben. Und er wird so schüchtern, wenn ich ihn umsorge ! Ich glaube, wenn er könnte, würde er rot werden. Und das bringt mich zum Lächeln.",shape=box,color=blue];
		1625 -> 1626;
	1626 [label="À la revoyure !",shape=box,color=blue];
		1626 -> 1627;
