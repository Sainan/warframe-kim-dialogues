		1925 -> 1926 [label=false,color=brown];
	1927 [label="Drifter, je länger ich um Monsieur Necraloid und Monsieur Otak weiß, desto mehr beunruhigt mich dieses Wissen...",shape=box,color=blue];
		1927 -> 1930;
		1927 -> 1931;
	1926 [label="Drifter, kann ich mit dir sprechen ?",shape=box,color=blue];
		1926 -> 1928;
		1926 -> 1929;
	1930 [label="Wie meinst du das?",shape=box,color=red];
		1930 -> 1934;
	1931 [label="Was genau ist es Problem?",shape=box,color=red];
		1931 -> 1934;
	1928 [label="Natürlich, worum geht es?",shape=box,color=red];
		1928 -> 1932;
	1929 [label="[Ende.]",shape=box,color=red];
		1929 -> 1933;
	1934 [label="Ich habe Monsieur Necraloid gefragt, ob der Schädel, den er trägt, irgendwann einem lebenden Wesen gehörte oder nicht.",shape=box,color=blue];
		1934 -> 1936;
	1932 [label="Ich frage mich, warum auf seinem Rücken ein weiteres Gesicht ist, das an die Kritzeleien eines Kindes erinnert.",shape=box,color=blue];
		1932 -> 1935;
	1933 [label="Chat ends.",color=orange];
	1936 [label="Und Monsieur Necraloid sagte, dass es \"sein\" Schädel ist, obwohl er zugab, dass Monsieur Loid das \"Original\" sei. Monsieur Loid warf ein, dass es sich um eine \"Nachbildung\" seines Schädels handelt.",shape=box,color=blue];
		1936 -> 1938;
	1935 [label="Ich habe Monsieur Necraloid und Monsieur Loid gefragt und keiner von beiden wollte darüber sprechen. Sie nannten mir nur einen Namen: Otak. Und sie erwähnten das mit großer Traurigkeit.",shape=box,color=blue];
		1935 -> 1937;
	1938 [label="Wie ist das möglich ? Und was bedeutet \"Nachbildung\" ? Ist es ein echter Schädel ou bien c'est un faux ? Warum sollten Monsieur Necraloid und Monsieur Loid verschiedene Antworten haben ?",shape=box,color=blue];
		1938 -> 1940;
		1938 -> 1941;
		1938 -> 1942;
	1937 [label="Deshalb spreche ich hier mit dir, in der Hoffnung, dass du mir helfen kannst.",shape=box,color=blue];
		1937 -> 1939;
	1940 [label="Ich nehme an, aus Necraloids Sicht ist es sein Schädel. Soviel stimmt. Aber aus Loids Sicht ist es eine Nachbildung.",shape=box,color=red];
		1940 -> 1944;
	1941 [label="Ich weiß wirklich nicht, woraus er besteht. Könnte Knochen sein. Oder eine Art Polymer ...",shape=box,color=red];
		1941 -> 1945;
	1942 [label="Ich glaube der Kern der Frage, der dich beschäftigt ist \"ist Necraloid real\",  nicht \"ist der Schädel real\".",shape=box,color=red];
		1942 -> 1946;
	1939 [label="Erzählst du mir die Geschichte des armen Monsieur Otak ?",shape=box,color=blue];
		1939 -> 1943;
	1944 [label="Ich glaub, das ist es, was mich beunruhigt. Die Art, wie beide Gentlemen seinen Ursprung sehen. Einer hält es für sacro-saint, der andere für eine copie.",shape=box,color=blue];
		1944 -> 1948;
	1945 [label="Ich weiß nicht, ob es das Material des Schädels ist, das mich so beunruhigt. Es ist seine Herkunft. Oder vielleicht wie beide Gentlemen seinen Ursprung sehen. Einer hält es für sacro-saint, der andere für eine copie.",shape=box,color=blue];
		1945 -> 1948;
	1946 [label="+5 Chemistry",color=orange];
		1946 -> 1949;
	1943 [label="Otak war einst ein Archimede, Wissenschaftler und Akademiker der Orokin. Was ihm widerfahren ist, ist nicht gerade eine schöne Geschichte.",shape=box,color=red];
		1943 -> 1947;
	1948 [label="Evaluate expressions",color=orange];
