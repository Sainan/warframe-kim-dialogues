	1596 [label="Update boolean MarieOtak1",color=orange];
		1596 -> 2945;
	1603 [label="Oui, weise Worte. Ich denke nur laut darüber nach und frage mich, was sie sein könnten. Aber du hast recht, es schadet nie Güte und Respekt zu zeigen",shape=box,color=blue];
		1603 -> 1610;
	1604 [label="Vielleicht hast du recht. Ich hoffe, du hast recht ! Wie dem auch sei, wir müssen gütig sein, denn sie sind denkende Kreaturen. Und was denkt, kann auch fühlen.",shape=box,color=blue];
