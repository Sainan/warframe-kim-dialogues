digraph {
	0 [label="MarieRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Bonjour, bonjour, Drifter! Wie geht es dir an diesem schönen Tag? Oder Abend. Ich weiß wirklich nicht, wie spät es hier ist.",shape=box,color=blue];
		1 -> 2;
	2 [label="Ich bin sicher, dass einer dieser Nippesgegenstände, die Monsieur Loid aufbewahrt, eine Uhr ist, aber ich kann beim besten Willen nicht herausfinden, welcher es ist.",shape=box,color=blue];
		2 -> 3;
	3 [label="Ich habe Angst, in diesem seltsamen Heiligtum irgendein Gerät zu berühren. Ich bin überzeugt, ich kann mich genauso einfach in eine weit entfernte Zeit katapultieren, als wenn ich eine Tasse Tee machen will.",shape=box,color=blue];
		3 -> 5;
		3 -> 6;
		3 -> 4;
	5 [label="Es ist wahrscheinlich am besten, keine Tasten zu drücken, bei denen du dir nicht sicher bist, nein.",shape=box,color=red];
		5 -> 8;
	6 [label="Ich bin sicher, du bist ungefährdet.",shape=box,color=red];
		6 -> 9;
	4 [label="[Ende.]",shape=box,color=red];
		4 -> 7;
	8 [label="Ein wirklich guter Rat. Monsieur Loid sagte, dass du dein eigenes Aventure Temporelle hattest. Ich frage mich –",shape=box,color=blue];
		8 -> 10;
	9 [label="C'est très gentil de votre part, aber ... du wurdest nicht in eine andere ... ah. Richtig! Ja !",shape=box,color=blue];
		9 -> 11;
	7 [label="Chat ends.",color=orange];
	10 [label="War es so gefährlich wie dieses ?",shape=box,color=blue];
		10 -> 12;
		10 -> 13;
	11 [label="Du solltest es wissen, nicht wahr? Verzeih mir. War dein persönliches Abenteuer genauso gefährlich wie dieses?",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="Der Zeitraum? Oder mein Aufenthalt dort spezifisch?",shape=box,color=red];
		12 -> 14;
	13 [label="Es war anders, aber ich verspreche dir, dass du hier sicher bist.",shape=box,color=red];
		13 -> 15;
	14 [label="+10 Chemistry",color=orange];
		14 -> 16;
	15 [label="Ich weiß dein mitreißendes Vertrauensvotum sehr zu schätzen, teile es aber nicht uneingeschränkt. Vor allem nicht, da es mir bereits schwerfällt, die Uhrzeit zu erkennen.",shape=box,color=blue];
		15 -> 17;
	16 [label="Gut, diese Unterscheidung zu machen. Ich bezweifle nicht, deine Erfahrungen mit der Vergangenheit waren nach allgemeinen Maßstäben \"normal\". Ich hoffe jedenfalls nicht, dass es so ist.",shape=box,color=blue];
		16 -> 18;
	17 [label="Man würde erwarten, dass sich in der Ecke dieses ... \"Bildschirms\" hier eine befindet, aber da ist nichts! Mauvaise qualité, wenn du mich fragst.",shape=box,color=blue];
		17 -> 19;
	18 [label="Ich meinte den \"Zeitraum\" selbst. Erlaube mir, es anders zu formulieren -",shape=box,color=blue];
		18 -> 20;
	19 [label="Wie dem auch sei, wir sind ziemlich weit von meiner Frage abgekommen!",shape=box,color=blue];
		19 -> 20;
	20 [label="War diese \"vergangene\" Ära, in die du gereist bist und die tatsächlich viel näher an der \"weiteren Vergangenheit\" liegt, aus der ich stamme, mehr oder weniger latent gefährlich als die Zeit, in der wir uns derzeit befinden?",shape=box,color=blue];
		20 -> 21;
	21 [label="(Meine Güte! Ich liebe das wirklich, ich muss sagen, es ist viel interessanter, als Abendmahlsgeschirr abzustauben.)",shape=box,color=blue];
		21 -> 22;
		21 -> 23;
		21 -> 24;
		21 -> 25;
	22 [label="Ich denke, es ist ungefähr dasselbe. Die Waffen sind anders und sie wissen vielleicht noch nicht, was sie erwartet, aber Krieg ist Krieg und Tod ist Tod.",shape=box,color=red];
		22 -> 26;
	23 [label="Ich denke, diese Zeit ist weniger gefährlich. Wir sind besser in der Lage, die Herausforderungen zu bewältigen, die vor uns liegen. Wir stehen erst am Anfang.",shape=box,color=red];
		23 -> 27;
	24 [label="Ich denke, diese Zeit ist gefährlicher. Wir haben zwar immer noch die Befallenen, aber sie hatten weitaus rudimentärere Waffen.",shape=box,color=red];
		24 -> 27;
	25 [label="Ehrlich gesagt bin ich einfach froh, dass es dir Spaß macht. Es kann etwas viel sein, sich an alles auf einmal zu gewöhnen.",shape=box,color=red];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="Vielleicht hast du recht. Ich werde darüber nachdenken. Danke.",shape=box,color=blue];
		27 -> 30;
	28 [label="+5 Chemistry",color=orange];
		28 -> 31;
	29 [label="Wie bei allen Dingen ist es wohl relativ, non ? Das Raubtier, das uns heute tötet, ist genauso tödlich wie das, das uns damals gejagt hat. Es schärft nur seine Zähne.",shape=box,color=blue];
		29 -> 32;
		29 -> 33;
	30 [label="Chat ends.",color=orange];
	31 [label="Le Cardinal Dimanche, dein Albrecht Entrati, hat mich darauf vorbereitet. Anders als mein lieber Lyon habe ich seine Worte als Tatsachen geglaubt. Und anders als Lyon sehe ich dies als unser großes Abenteuer, nicht als Last.",shape=box,color=blue];
		31 -> 34;
	32 [label="Es sei denn, du bist Orokin, und hast einen Weg gefunden, dem Tod zu entgehen ... theoretisch, wenn auch nicht in der Praxis.",shape=box,color=red];
		32 -> 35;
	33 [label="Ich freue mich auch, dass du dich gut an die Zukunft anpasst.",shape=box,color=red];
		33 -> 36;
	34 [label="Der Dienst an den Himmlischen muss kein Akt des Leidens sein. Darin waren wir uns schon immer uneinig.",shape=box,color=blue];
		34 -> 37;
	35 [label="Und ich glaube, der Teufel ist ein perfektes Beispiel dafür, warum der Tod das größte Geschenk ist, das Lua uns je gemacht hat.",shape=box,color=blue];
		35 -> 38;
	36 [label="+5 Chemistry",color=orange];
		36 -> 39;
	37 [label="Update boolean MarieLyonSuffering1",color=orange];
		37 -> 40;
	38 [label="Update boolean MarieRoathe1",color=orange];
		38 -> 41;
	39 [label="Le Cardinal Dimanche, dein Albrecht Entrati, hat mich darauf vorbereitet. Anders als mein lieber Lyon habe ich seine Worte als Tatsachen geglaubt. Und anders als Lyon sehe ich dies als unser großes Abenteuer, nicht als Last.",shape=box,color=blue];
		39 -> 42;
	40 [label="Und weiche meiner Frage nicht aus, Dummerchen! Welche ist gefährlicher?",shape=box,color=blue];
		40 -> 43;
		40 -> 44;
		40 -> 45;
	41 [label="Oh ! Das ist das Geräusch einer Uhr, das ich kenne, obwohl ich immer noch nicht weiß, wo das verdammte Ding ist. Wie auch immer, ich fürchte, ich muss gehen. Es war herrlich. Auf \"wiedersehen\" ! Aux Dieux !",shape=box,color=blue];
		41 -> 46;
	42 [label="Der Dienst an den Himmlischen muss kein Akt des Leidens sein. Darin waren wir uns schon immer uneinig.",shape=box,color=blue];
		42 -> 47;
	43 [label="Ich glaube, diese Zeit ist tödlicher. Wie viele unfassbare Feinde versuchen uns zu töten?",shape=box,color=red];
		43 -> 48;
	44 [label="Ich glaube, unsere Zeit ist weniger gefährlich. Sie entdecken nur neue Wege, sich gegenseitig umzubringen. Unsere Methoden sehen vielleicht nur etwas aufregender aus.",shape=box,color=red];
		44 -> 48;
	45 [label="Ich glaube, am Ende ist es wahrscheinlich ungefähr gleich. Tod ist Tod, nicht wahr?",shape=box,color=red];
		45 -> 49;
	46 [label="Chat ends.",color=orange];
	47 [label="Update boolean MarieLyonSuffering1",color=orange];
		47 -> 41;
	48 [label="Vielleicht hast du recht. Ich werde darüber nachdenken. Danke.",shape=box,color=blue];
		48 -> 50;
	49 [label="+5 Chemistry",color=orange];
		49 -> 51;
	50 [label="Chat ends.",color=orange];
	51 [label="Wie bei allen Dingen ist es wohl relativ, non ? Das Raubtier, das uns heute tötet, ist genauso tödlich wie das, das uns damals gejagt hat. Es schärft nur seine Zähne.",shape=box,color=blue];
		51 -> 52;
		51 -> 53;
	52 [label="Als jemand, der versucht, sich gegen den Wolf zu verteidigen, bin ich dadurch oft erschöpft.",shape=box,color=red];
		52 -> 54;
	53 [label="Es sei denn, du bist Orokin, und hast einen Weg gefunden, dem Tod zu entgehen ... theoretisch, wenn auch nicht in der Praxis.",shape=box,color=red];
		53 -> 55;
	54 [label="Ich glaube, du, mein lieber Drifter, wirst dich eher dem Wolfsrudel anschließen, als nur Wache zu stehen. Und das meine ich als Kompliment.",shape=box,color=blue];
		54 -> 41;
	55 [label="Und ich glaube, der Teufel ist ein perfektes Beispiel dafür, warum der Tod das größte Geschenk ist, das Lua uns je gemacht hat.",shape=box,color=blue];
		55 -> 56;
	56 [label="Update boolean MarieRoathe1",color=orange];
		56 -> 41;
}