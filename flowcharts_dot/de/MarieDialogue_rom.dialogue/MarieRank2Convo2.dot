	496 [label="Ich stehe neben einem Teufel, der unzählige Jahrhunderte durchlebt hat. In der Nähe ist eine Frau, die eine Maschine ist und selbst die Seelen dreier Götter besitzt.",shape=box,color=blue];
		496 -> 505;
	498 [label="Hah! Geradu du solltest wissen, dass Glaube nie weise ist. Und trotzdem tragen Seelen wie unsere ihn, auch wenn er uns verbrennt. Ich vermute, das weißt du, falls unser früheres Gespräch die Wahrheit war.",shape=box,color=blue];
		498 -> 507;
		498 -> 508;
