digraph {
	418 [label="MarieRank2Convo2 begins.",color=orange];
		418 -> 421;
		418 -> 420;
		418 -> 419;
	421 [label="Woher kennst du Entrati?",shape=box,color=red];
		421 -> 424;
	420 [label="Darf ich fragen, was du von Entrati hältst, jetzt, wo du hier bist?",shape=box,color=red];
		420 -> 423;
	419 [label="[Ende.]",shape=box,color=red];
		419 -> 422;
	424 [label="Ich kannte ihn als Cardinal Dimanche. Es mag dich überraschen, wie viele Jahre er in der Kirche verbrachte und zu unserer Gemeinde predigte.",shape=box,color=blue];
		424 -> 426;
		424 -> 427;
	423 [label="+5 Chemistry",color=orange];
		423 -> 425;
	422 [label="Chat ends.",color=orange];
	426 [label="Denkst du, alles war gelogen? Oder meinst du, er hat es geglaubt?",shape=box,color=red];
		426 -> 429;
	427 [label="Tut es nicht. Er ist ein guter Lügner.",shape=box,color=red];
		427 -> 430;
	425 [label="Ah, eine sehr höfliche Frage, die eine sehr herausfordernde Antwort verbirgt und ich muss zugeben, sehr clever formuliert.",shape=box,color=blue];
		425 -> 428;
	429 [label="Er sprach von Vergebung, von Familie und Empathie mit solcher Inbrunst und Hingabe, dass ich nicht wüsste, wie das nur gespielt sein könnte.",shape=box,color=blue];
		429 -> 434;
	430 [label="Ich verstehe, dass deine Erfahrungen mit ihm, nicht dieselben sind, wie meine. Aber du musst auch verstehen, dass er zu mir nur freundlich und fürsorglich war.",shape=box,color=blue];
		430 -> 435;
	428 [label="Dasselbe, was ich von ihm hielt, als ich ihm dabei zusah, wie er am ersten Tag eine Predigt für unsere paroissiens hielt. Ich war gesegnet, in seiner présence zu sein.",shape=box,color=blue];
		428 -> 431;
		428 -> 432;
		428 -> 433;
	434 [label="Ob er selbst an die Himmlischen geglaubt hat ? An Sol und Lua ? Das kann ich nicht länger sagen, wissend, woher und von wann er stammt. Peu importe.",shape=box,color=blue];
		434 -> 437;
	435 [label="Straft deine Wahrheit die meine Lügen oder an welche soll ich glauben? Soll ich jeden Akt der Barmherzigkeit oder Sanftmut verdammen, den er der Gemeinde über die Jahre gezeigt hat?",shape=box,color=blue];
		435 -> 438;
	431 [label="Freut mich zu hören, ehrlich. Ich glaube, man verurteilt ihn zu schnell.",shape=box,color=red];
		431 -> 436;
	432 [label="Denkst du, er hat alle hereingelegt? Oder meinst du, er hat es geglaubt?",shape=box,color=red];
		432 -> 429;
	433 [label="Tut ... tut mir leid, dass du auf seine Tricks hereingefallen bist.",shape=box,color=red];
		433 -> 430;
	437 [label="Welche Bedeutung haben die Namen der Götter, zu denen du betest, wenn du ihre Liebe im Herzen trägst ? Ich sage, gar keine.",shape=box,color=blue];
		437 -> 440;
		437 -> 441;
	438 [label="Non. Ich glaube nicht.",shape=box,color=blue];
		438 -> 442;
	436 [label="+10 Chemistry",color=orange];
		436 -> 439;
	440 [label="Das ist eine schöne Art, die Dinge zu sehen.",shape=box,color=red];
		440 -> 444;
	441 [label="Sehe ich anders. Ein netter Mensch zu sein, macht mich nicht sofort zu einem Anhänger eines gütigen Gottes.",shape=box,color=red];
		441 -> 445;
	442 [label="Verzeih mir, aber ich werde ihn nicht zu einem Monster machen, nur weil du das sagst.",shape=box,color=blue];
		442 -> 446;
	439 [label="Update boolean MarieEntratiFan1",color=orange];
		439 -> 443;
	444 [label="Ich glaube, le Cardinal glaubt tief in seiner Seele an die Himmlischen, auch wenn er nicht glaubt, dass sie im Jenseits auf ihn warten.",shape=box,color=blue];
		444 -> 450;
	445 [label="+5 Chemistry",color=orange];
		445 -> 451;
	446 [label="Update boolean MarieEntratiMonster1",color=orange];
		446 -> 452;
	443 [label="Oh ! Es erwärmt mein Herz, das zu hören. Ich dachte, ich wäre alleine in dieser Hinsicht. Ich bin umgeben von solchen, die nur schlecht über le Cardinal denken.",shape=box,color=blue];
		443 -> 447;
		443 -> 448;
		443 -> 449;
	450 [label="Denn welcher andere Mensch kennt denn den Wert der Empathie gegen die Dunkelheit der Indifférence, non ?",shape=box,color=blue];
		450 -> 456;
	451 [label="Du hast recht, das tut es nicht. Ich würde dich nicht einen Anhänger Sols nennen, nur weil du unwissentlich seinem Weg folgst. Mehr Gutes in der Welt verbessert die Welt, es ist mir egal, welchen Namens es trägt.",shape=box,color=blue];
		451 -> 457;
	452 [label="Chat ends.",color=orange];
	447 [label="Ich wünschte nur, es gäbe einen Weg, dass sie ihm alle vergeben. Er gibt sein Bestes, um die Dinge in Ordnung zu bringen.",shape=box,color=red];
		447 -> 453;
	448 [label="Sie haben ihre Gründe. Aber er ist unsere einzige Chance, die Gleichgültigkeit aufzuhalten.",shape=box,color=red];
		448 -> 454;
	449 [label="Entrati hält auch nicht sonderlich viel von sich selbst.",shape=box,color=red];
		449 -> 455;
