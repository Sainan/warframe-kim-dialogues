		456 -> 461 [label=false,color=brown];
	457 [label="Und daher glaube ich, dass le Cardinal gesegnet ist, auch wenn er nicht wirklich den Glauben des Namens vertritt, den ich ihm geben würde.",shape=box,color=blue];
		457 -> 450;
	453 [label="Add 1 to Thermostat",color=orange];
		453 -> 458;
	454 [label="Add -1 to Thermostat",color=orange];
		454 -> 459;
	455 [label="Oui, et comme c'est tragique ... wenn ich daran denke, kommen mir die Tränen. Und an Monsieur Loid alleine, ihre Liebe im Void treibend.",shape=box,color=blue];
		455 -> 460;
	462 [label="Vergib mir, ich vergaß ... du glaubst nicht, dass deine Indifférence real ist. Nur eine Halluzination. Aber du glaubst an die Emotion, die damit verbunden ist, oui ?",shape=box,color=blue];
		462 -> 467;
		462 -> 468;
	461 [label="Es ist perfekt, dass er kam, um uns die Botschaft zu predigen, als Gegengewicht dessen, was er entfesselt hat, n'est-ce pas ?",shape=box,color=blue];
		461 -> 464;
		461 -> 465;
		461 -> 466;
	458 [label="Qui und ich denke, das ist die Aufgabe, die vor uns allen liegt.",shape=box,color=blue];
		458 -> 460;
	459 [label="Oui, aber der Kampf gegen die Gleichgültigkeit wird nicht mit Schwertern und Steinen gewonnen. Er wird mit dem Herzen gewonnen, verstehst du das nicht ?",shape=box,color=blue];
		459 -> 460;
	460 [label="Es sind kaum die Orokin Teufel, denen wir vergeben sollen, non ? Es ist le Cardinal, soviel ist sicher. Und ich glaube, es ist die Liebe von Monsieur Loid, die alles inspiriert.",shape=box,color=blue];
		460 -> 463;
	467 [label="Alle Emotionen haben einen Zweck, sogar Gleichgültigkeit.",shape=box,color=red];
		467 -> 474;
	468 [label="Das tue ich. Ich bin ihr in Duviri zum Opfer gefallen. Ich ließ mich von der Apathie zerfressen, bis sie alles war, was noch übrig war.",shape=box,color=red];
		468 -> 475;
	464 [label="Ich wünschte, ich könnte helfen, das Problem zu lösen.",shape=box,color=red];
		464 -> 471;
	465 [label="Ich wünschte, er hätte einen besseren Plan als \"predigen\".",shape=box,color=red];
		465 -> 472;
	466 [label="Nun, da es seine Schuld ist, dass diese Ding außer Kontrolle geraten ist ... ja. Es ist das Mindeste, was er tun konnte.",shape=box,color=red];
		466 -> 473;
	463 [label="Es bricht mir das Herz. Ich wünsche mir nichts mehr, als sie wieder vereint zu sehen !",shape=box,color=blue];
		463 -> 469;
		463 -> 470;
	474 [label="Natürlich erfüllt sie einen Zweck. Je ne le nie pas.",shape=box,color=blue];
		474 -> 482;
