		576 -> 574;
	574 [label="Deshalb war le Cardinal so eine willkommene présence in meinem Leben. Er hatte so viel Wärme. Und er hat mich nie verachtet oder bemitleidet. Er hat mich kein einziges Mal als une invalide betrachtet.",shape=box,color=blue];
