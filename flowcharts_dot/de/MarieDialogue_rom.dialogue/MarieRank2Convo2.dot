	531 [label="Es gibt einen Unterschied, an Götter oder an Menschen zu glauben. Und Entrati ist nur ein Mensch.",shape=box,color=red];
		531 -> 488;
	524 [label="Interessant. Ich kenne die Kultur der Orokin nicht gut genug, um zu wissen, ob es ihrer Lebensweise widersprochen hätte. Aber ich weiß, dass es in vielen alten Kulturen nicht verpönt war.",shape=box,color=blue];
		524 -> 534;
	525 [label="Er hat sich heruntergebeugt, um mich zu begrüßen, sodass ich in meinem Stuhl über ihm war.",shape=box,color=blue];
		525 -> 535;
	538 [label="Aber am Ende, wenn wir der Vettel gegenüberstehen, wenn Lua ihre silbernen Tränen für uns vergießt und der Tod nahe ist, ist es das Gewicht unseres eigenen Herzens, dass wir tragen müssen.",shape=box,color=blue];
		538 -> 545;
		538 -> 546;
	539 [label="Den Schaden wiedergutzumachen, den man vielleicht angerichtet hat, ist sogar noch wichtiger für die Seele.",shape=box,color=blue];
		539 -> 538;
	536 [label="Bis dahin schlage ich vor, überleg noch einmal, was es heißt, gesegnet zu sein. Auf Wiedersehen.",shape=box,color=blue];
		536 -> 544;
	537 [label="Oui, das eine ist greifbar. Gegenwärtig. Das andere erfordert, die Augen zu schließen und einfach zu vertrauen.",shape=box,color=blue];
		537 -> 527;
	534 [label="Aber es ist kaum an uns, dies zu entscheiden ... in diesem Fall bin ich nicht hier, um über le Cardinals Liebeserklärung an Monsieur Loid zu urteilen oder über Monsieur Loids Erwiderung.",shape=box,color=blue];
		534 -> 540;
