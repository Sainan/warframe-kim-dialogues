	513 [label="Es war ein schöner, sonniger Nachmittag. Ich erinnere mich daran, dass er vor dem Altar stand und mit einem Lächeln auf dem Gesicht zum Buntglas hinauf sah, auch wenn ich nicht wusste, warum.",shape=box,color=blue];
		513 -> 525;
	532 [label="Versteh mich nicht falsch, zu versuchen den Schaden, den man angerichtet hat, gutzumachen, ist wichtig. Wo immer es möglich ist, Vergebung von den Geschädigten zu erfahren, ist ein großer Trost.",shape=box,color=blue];
		532 -> 538;
	533 [label="Oh ich sage nicht, dass es unwichtig ist Vergebung von denen zu erbitten, denen man geschadet hat ! Es ist !",shape=box,color=blue];
		533 -> 539;
	526 [label="Sprich noch einmal über die, die nur \"Menschen\" sind und ich werde versuchen nicht zu lachen, ich verspreche es.",shape=box,color=blue];
		526 -> 536;
	528 [label="Wir glauben, weil wir es müssen. Wir können nicht anders. Egal, was es am Ende bedeutet. Ich kenne das Gefühl.",shape=box,color=blue];
		528 -> 527;
	529 [label="Glaube ist keine Konstante. Er ist wie die Gezeiten. Er kommt und geht und das ist in Ordnung.",shape=box,color=blue];
		529 -> 527;
