digraph {
	"MarieRank2Convo1 begins." [color=orange];
		"MarieRank2Convo1 begins." -> j3795383305;
	j3795383305 [label="Ich hoffe, du hältst meine Frage nicht für unhöflich, aber ich bin furchtbar neugierig. Bist du gläubig? Glaubst du die Himmlischen oder an etwas anderes?",shape=box,color=blue];
		j3795383305 -> j736689162;
		j3795383305 -> j2236407599;
		j3795383305 -> j129698615;
	j736689162 [label="Was, wenn ich sagen würde, dass ich mehr an dir interessiert wäre? Wäre das blasphemisch?",shape=box,color=red];
		j736689162 -> j4282068385;
	j2236407599 [label="Nein, es wäre gar nicht unhöflich.",shape=box,color=red];
		j2236407599 -> j2928479460;
		j2236407599 -> j1215040324;
		j2236407599 -> j1367044295;
		j2236407599 -> j139849845;
		j2236407599 -> j3605840496;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j4282068385 [label="Boolean DrifterMarie is now true.",color=orange];
		j4282068385 -> j1590699844;
	j2928479460 [label="Es ist ... kompliziert. Ich glaube, dass da draußen etwas ist, aber ich habe keinen wirklichen Namen für meinen Glauben.",shape=box,color=red];
		j2928479460 -> j1123374829;
	j1215040324 [label="Ja, bin ich. Ich habe an einen Glauben, der dir jedoch unbekannt sein dürfte.",shape=box,color=red];
		j1215040324 -> j3890838098;
	j1367044295 [label="Ich glaube an die Himmlischen, genau wie du.",shape=box,color=red];
		j1367044295 -> j4026393250;
	j139849845 [label="Nein, bin ich nicht. Ich glaube nicht an Götter. Nur an Wissenschaft, die wir noch nicht verstehen.",shape=box,color=red];
		j139849845 -> j481491808;
	j3605840496 [label="Ehrlich gesagt, weiß ich es nicht. Ich glaube, die Welt ist zu kompliziert, als dass ich die Antwort hätte.",shape=box,color=red];
		j3605840496 -> j2910544956;
	"Chat ends." [color=orange];
	j1590699844 [label="Ah, oui ? Was ist das ? Quelle audace, ich muss sagen, du überrascht mich ! Ich hatte nicht erwartet ...",shape=box,color=blue];
		j1590699844 -> j315747095;
	j1123374829 [label="Boolean DrifterFaithPersonal is now true.",color=orange];
		j1123374829 -> j901685385;
	j3890838098 [label="+5 Chemistry",color=orange];
		j3890838098 -> j1431335544;
	j4026393250 [label="+5 Chemistry",color=orange];
		j4026393250 -> j4099970478;
	j481491808 [label="+5 Chemistry",color=orange];
		j481491808 -> j594057448;
	j2910544956 [label="Boolean DrifterFaithAgnostic is now true.",color=orange];
		j2910544956 -> j2582128704;
	j315747095 [label="Du versuchst nur, mich abzulenken ! Ich habe zwar nichts dagegen, aber dafür ist es noch viel zu früh, n'est-ce pas ?",shape=box,color=blue];
		j315747095 -> j2051414630;
	j901685385 [label="+5 Chemistry",color=orange];
		j901685385 -> j2703526071;
	j1431335544 [label="In Glauben, egal bei welchem Namen, finde ich Schönheit. Sag mir, ist er neu ? Alt ? Würde ich ihn überhaupt erkennen ?",shape=box,color=blue];
		j1431335544 -> j1616839329;
		j1431335544 -> j3060840221;
	j4099970478 [label="Tust du ! Oh, comme c'est fascinant ! Zu wissen, dass jemand so weit in der Zukunft gläubig ist, cela remplit mon cœur de joie. Ich bin überwältigt vor Freude. Obwohl ich denke, dass deine Vergangenheit vielleicht etwas damit zu tun hatte, oder ? Ach, egal.",shape=box,color=blue];
		j4099970478 -> j2148040431;
	j594057448 [label="Ich respektiere deine Antwort. Muss aber fragen: Wie kannst du dir so sicher sein? Ist das nicht eine Art Glaube an sich? Und was ist diese ... Gleichgültigkeit, wenn nicht ein Gott?",shape=box,color=blue];
		j594057448 -> j3019775295;
		j594057448 -> j2402898922;
		j594057448 -> j1846597618;
	j2582128704 [label="+10 Chemistry",color=orange];
		j2582128704 -> j470149806;
	j2051414630 [label="Ich ... hätte trotzdem gern eine Antwort auf meine Frage, s'il vous plait, wenn es dir nichts ausmacht. Jetzt bin ich ganz rot geworden !",shape=box,color=blue];
		j2051414630 -> j2928479460;
		j2051414630 -> j1215040324;
		j2051414630 -> j1367044295;
		j2051414630 -> j139849845;
		j2051414630 -> j3605840496;
	j2703526071 [label="Ah, oui. Ein Wanderer, das ist in deinem Namen. Du hast viele Kulturen, viele Glaubensrichtungen, viele Welten gesehen. Cela est très spirituel, non ? Teile davon gesammelt wie Muscheln.",shape=box,color=blue];
		j2703526071 -> j758046220;
		j2703526071 -> j2145810533;
	j1616839329 [label="Ich denke nicht, dass du etwas davon erkennen würdest, nein.",shape=box,color=red];
		j1616839329 -> j3643734081;
	j3060840221 [label="Etwas davon wird dir vielleicht bekannt vorkommen, anderes ist dir sicherlich völlig fremd.",shape=box,color=red];
		j3060840221 -> j3532582741;
	j2148040431 [label="Ich würde gerne wissen, ob du dich dem einen oder dem anderen verschrieben hast oder ob du nach Gleichgewicht suchst ?",shape=box,color=blue];
		j2148040431 -> j295044817;
		j2148040431 -> j905838101;
		j2148040431 -> j1721654936;
	j3019775295 [label="Ich bin nicht absolut sicher, dass ich recht habe, das kann niemand. Aber ich persönlich glaube trotzdem nicht an Götter.",shape=box,color=red];
		j3019775295 -> j2016426279;
	j2402898922 [label="Ich glaube, Religion ist dazu da, eine Lücke im Leben der Menschen zu füllen, die durch die Angst vor dem Tod und dem Unbekannten entstanden ist.",shape=box,color=red];
		j2402898922 -> j2989156579;
	j1846597618 [label="Ich weiß nicht, was die Gleichgültigkeit ist, aber sie ist kein Gott. Wir müssen dem nur auf den Grund gehen.",shape=box,color=red];
		j1846597618 -> j870628604;
	j470149806 [label="Ah, vielleicht die weiseste Antwort von allen! Denn wer sind wir bloßen Sterblichen – falls wir das überhaupt noch behaupten können –, dass wir vorgeben, den Plan der Götter zu entschlüsseln?",shape=box,color=blue];
		j470149806 -> j77752298;
	j758046220 [label="Ich glaube, es gibt auch etwas Älteres, Wahreres und Tieferes, das uns alle anspricht. So etwas wie ein Bindegewebe.",shape=box,color=red];
		j758046220 -> j4209738894;
	j2145810533 [label="Genau. Ich sehe in allen etwas Schönes, ich weiß nicht, ob irgendetwas richtig oder falsch ist.",shape=box,color=red];
		j2145810533 -> j4209738894;
	j3643734081 [label="Boolean DrifterFaithYesForeign is now true.",color=orange];
		j3643734081 -> j3051422819;
	j3532582741 [label="Boolean DrifterFaithYesSimilar is now true.",color=orange];
		j3532582741 -> j2646431956;
	j295044817 [label="Ich fühle mich mehr zu Sol hingezogen.",shape=box,color=red];
		j295044817 -> j2612407650;
	j905838101 [label="Ich fühle mich mehr zu Lua hingezogen.",shape=box,color=red];
		j905838101 -> j1275130622;
	j1721654936 [label="Ich strebe nach Ausgewogenheit. Ich denke, das ist die natürliche Ordnung der Dinge.",shape=box,color=red];
		j1721654936 -> j2999947934;
	j2016426279 [label="Boolean DrifterFaithNoMaybe is now true.",color=orange];
		j2016426279 -> j2229647312;
	j2989156579 [label="Boolean DrifterFaithNoFear is now true.",color=orange];
		j2989156579 -> j247838839;
	j870628604 [label="Boolean DrifterFaithNoMITW is now true.",color=orange];
		j870628604 -> j3700326604;
	j77752298 [label="Oft saß ich im Heiligtum meiner Cathédrale und sprach mit Freude mit Fremden, die gekommen waren, um zu lernen, und zu nichts anderem.",shape=box,color=blue];
		j77752298 -> j2246472516;
	j4209738894 [label="+5 Chemistry",color=orange];
		j4209738894 -> j3283113738;
	j3051422819 [label="+5 Chemistry",color=orange];
		j3051422819 -> j1722862732;
	j2646431956 [label="+5 Chemistry",color=orange];
		j2646431956 -> j3223668959;
	j2612407650 [label="Boolean DrifterFaithSol is now true.",color=orange];
		j2612407650 -> j909314082;
	j1275130622 [label="Boolean DrifterFaithLua is now true.",color=orange];
		j1275130622 -> j1102122144;
	j2999947934 [label="Boolean DrifterFaithBalance is now true.",color=orange];
		j2999947934 -> j2738542979;
	j2229647312 [label="Oui, je vois ... Vielleicht brauchst du deinen eigenen \"Beweis\", um sicher zu sein? Ist in deinem Leben noch nie etwas passiert, das dir ein solches Gefühl des Glaubens und der Inbrunst vermittelt hätte, wie wir es empfinden?",shape=box,color=blue];
		j2229647312 -> j1487755793;
		j2229647312 -> j965251852;
	j247838839 [label="Oui, c'est vrai - das ist wahr. Glaube beantwortet viele Fragen vieler Seelen. Fürchtest du dich nicht vor dem, was nach dem Tod kommen könnte?",shape=box,color=blue];
		j247838839 -> j4293854233;
		j247838839 -> j1196010830;
	j3700326604 [label="Comme c'est fascinant ... und jetzt sind es zwei, die dieselben Worte wiederholen ... der Teufel hat dasselbe geflüstert.",shape=box,color=blue];
		j3700326604 -> j337600185;
	j2246472516 [label="So neugierig auf unseren Glauben, wollten aber nicht sagen: \"Ja, ja, das ist die Wahrheit.\" Ich hoffe, dass ich ihnen ein Stück unserer Freude mitgeben konnte.",shape=box,color=blue];
		j2246472516 -> j3525581205;
		j2246472516 -> j1246108728;
	j3283113738 [label="Je comprends et c'est magnifique. Ich habe mich oft gefragt, ob die Himmlischen nicht andere Gesichter hatten. Andere Namen.",shape=box,color=blue];
		j3283113738 -> j2422369382;
	j1722862732 [label="Oh, comme c'est fascinant ! Wie gerne würde ich eines Tages etwas über deinen Glauben erfahren. Von deinen Ritualen hören.",shape=box,color=blue];
		j1722862732 -> j737616073;
		j1722862732 -> j2879504489;
	j3223668959 [label="Oh, comme c'est fascinant ! Wie gerne würde ich eines Tages hören, wie es übereinstimmt und doch so anders ist.",shape=box,color=blue];
		j3223668959 -> j737616073;
		j3223668959 -> j2879504489;
	j909314082 [label="+10 Chemistry",color=orange];
		j909314082 -> j283340259;
	j1102122144 [label="+5 Chemistry",color=orange];
		j1102122144 -> j546947033;
	j2738542979 [label="+5 Chemistry",color=orange];
		j2738542979 -> j3430095570;
	j1487755793 [label="Nein, ich glaube einfach nicht daran.",shape=box,color=red];
		j1487755793 -> j9166459;
	j965251852 [label="So ist es. Ich habe nie ... Glauben \"verspürt\". Oder diesen gebraucht.",shape=box,color=red];
		j965251852 -> j3480476014;
	j4293854233 [label="Jeder stirbt. Sich davor zu fürchten, ist albern. Er kommt uns alle holen. Oder zumindest ... sollte er das.",shape=box,color=red];
		j4293854233 -> j1886900451;
	j1196010830 [label="Ich bin oft genug gestorben. Ich habe keine Angst vor dem, was danach kommt. Ich freue mich darauf.",shape=box,color=red];
		j1196010830 -> j3229432577;
	j337600185 [label="+5 Chemistry",color=orange];
		j337600185 -> j3850203201;
	j3525581205 [label="Ich bin ein wenig überrascht, dass du offen für Menschen bist, die deinen Glauben nicht teilen.",shape=box,color=red];
		j3525581205 -> j1937541703;
	j1246108728 [label="Genau das ist es. Ich möchte nicht sagen, jemand hat \"recht\" oder \"unrecht\".",shape=box,color=red];
		j1246108728 -> j1418394082;
	j2422369382 [label="Es ist bekannt, dass sie ihre Gestalt ändern, um ihren Anhängern anderer Sekten zu gefallen. Aber das ist mein Glaube, nicht deiner.",shape=box,color=blue];
		j2422369382 -> j1347675180;
	j737616073 [label="Das wäre nett.",shape=box,color=red];
		j737616073 -> j1227904949;
	j2879504489 [label="Ich bin überrascht, dass du anderen Religionen gegenüber aufgeschlossen bist.",shape=box,color=red];
		j2879504489 -> j2340645179;
	j283340259 [label="Ein Wanderer ganz nach meinem Geschmack ! Du zauberst mir ein Lächeln ins Gesicht. Ich hoffe, du lügst nicht, um mir zu schmeicheln.",shape=box,color=blue];
		j283340259 -> j2047582207;
	j546947033 [label="Aah, der Wanderer folgt dem Pfad der Nacht wie mein lieber Lyon. Wenn er bereit ist, solltest du mit ihm über die Wege seiner dunklen Dame sprechen, er wird überglücklich sein.",shape=box,color=blue];
		j546947033 -> j2047582207;
	j3430095570 [label="Gleichgewicht ohne Unentschlossenheit. Durch das Leben reisen und dabei wissen, wann die Sonne aufgehen und der Mond ihr antworten muss, aber niemals dem Zweifel verfallen ?",shape=box,color=blue];
		j3430095570 -> j184939449;
	j9166459 [label="+5 Chemistry",color=orange];
		j9166459 -> j1437992968;
	j3480476014 [label="+5 Chemistry",color=orange];
		j3480476014 -> j4044360595;
	j1886900451 [label="+5 Chemistry",color=orange];
		j1886900451 -> j3694765126;
	j3229432577 [label="+5 Chemistry",color=orange];
		j3229432577 -> j4197765353;
	j3850203201 [label="Es schmerzt mich, ihm Glauben zu schenken, aber in diesem Fall ? Vielleicht solltest du mit ihm sprechen. Sei jedoch vorsichtig. Der Teufel spielt ein gefährliches Spiel.",shape=box,color=blue];
		j3850203201 -> j2144883196;
		j3850203201 -> j3856604940;
	j1937541703 [label="Es mag überraschend sein, dass jemand, der die Roben trägt, keine strengen Erwartungen an andere stellt. Ich finde jedoch, dass Predigten an diejenigen, die keinen Trost suchen, wenig Zuspruch findet.",shape=box,color=blue];
		j1937541703 -> j499771107;
	j1418394082 [label="+5 Chemistry",color=orange];
		j1418394082 -> j302312738;
	j1347675180 [label="Ich hoffe einfach: Dein Glaube, bringt dir das Frieden ?",shape=box,color=blue];
		j1347675180 -> j3346217871;
		j1347675180 -> j3959582952;
		j1347675180 -> j2430963326;
	j1227904949 [label="Ô joie! Ich lerne so gern. Ich fragte mich oft, ob die Himmlischen nicht andere Gesichter hatten. Andere Namen.",shape=box,color=blue];
		j1227904949 -> j1883966852;
	j2340645179 [label="Es mag überraschend sein, dass jemand, der die Roben trägt, keine strengen Erwartungen an andere stellt. Ich finde jedoch, dass Predigten an diejenigen, die keinen Trost suchen, wenig Zuspruch findet.",shape=box,color=blue];
		j2340645179 -> j3501019510;
	j2047582207 [label="Ich frage mich einfach: Dein Glaube, bringt dir das Frieden ?",shape=box,color=blue];
		j2047582207 -> j3346217871;
		j2047582207 -> j3959582952;
		j2047582207 -> j2430963326;
	j184939449 [label="Das ist eine seltene Gabe ... und ich hoffe, dass du sie nutzt. Wer zu lange an der Kreuzung verweilt, wird, fürchte ich, von Zwietracht verzehrt.",shape=box,color=blue];
		j184939449 -> j358591139;
	j1437992968 [label="Dann muss das Leben einfacher sein. Nicht nach den Regeln von Göttern und Kirchen zu leben. Ich gebe zu, ich bin ein bisschen neidisch.",shape=box,color=blue];
		j1437992968 -> j3949769218;
	j4044360595 [label="Dann bin ich neidisch auf dich, Wanderer ! So viele Jahrhunderte zu leben, frei vom Verlangen die Götter kennen zu müssen.",shape=box,color=blue];
		j4044360595 -> j3949769218;
	j3694765126 [label="Du klingst wie ein Schüler von Lua, und das meine ich nicht böse. Oui, die Vettel kommt, um uns alle zu holen, und weint ihre silbernen Tränen. Aber deine Worte machen mich nachdenklich ...",shape=box,color=blue];
		j3694765126 -> j3871972680;
	j4197765353 [label="Oui, das macht mich stutzig. Ich schau dich an, das Kind, den Teufel, sogar Monsieur Loid oder le Cardinal ... viele Jahrhunderte liegen hinter euch allen.",shape=box,color=blue];
		j4197765353 -> j2985562652;
	j2144883196 [label="Welche Art gefährliches Spiel?",shape=box,color=red];
		j2144883196 -> j3011316372;
	j3856604940 [label="Er glaubt auch nicht, dass der Mann in der Wand echt ist?",shape=box,color=red];
		j3856604940 -> j3910835904;
	j499771107 [label="+5 Chemistry",color=orange];
		j499771107 -> j2351928;
	j302312738 [label="Ich lächle über deine Weisheit und Freundlichkeit gegenüber den Überzeugungen anderer.",shape=box,color=blue];
		j302312738 -> j2714065995;
	j3346217871 [label="Das tut es nicht.",shape=box,color=red];
		j3346217871 -> j3355664068;
	j3959582952 [label="Ganz ehrlich, ich denke nicht viel darüber nach.",shape=box,color=red];
		j3959582952 -> j4208488836;
	j2430963326 [label="Das tut es.",shape=box,color=red];
		j2430963326 -> j4187272476;
	j1883966852 [label="Es ist bekannt, dass sie ihre Gestalt ändern, um ihren Anhängern anderer Sekten zu gefallen. Aber das ist mein Glaube, nicht deiner. Ich werde nicht zu denen predigen, die keinen Trost suchen. Ich finde, das stößt nicht auf große Zustimmung.",shape=box,color=blue];
		j1883966852 -> j3501019510;
	j3501019510 [label="Nein, mein Glaube gehört mir und deiner gehört dir. Ich hoffe einfach, dass es dir Frieden bringt?",shape=box,color=blue];
		j3501019510 -> j3346217871;
		j3501019510 -> j3959582952;
		j3501019510 -> j2430963326;
	j358591139 [label="Letztlich muss jeder den Weg wählen, den er gehen möchte. Doch der Scheideweg ist der Ausgangspunkt für alle, denn das Gleichgewicht ist die Grundlage aller Strukturen.",shape=box,color=blue];
		j358591139 -> j2066372921;
	j3949769218 [label="Ich frage mich jedoch: Dieser Unglaube, bringt dir das Frieden ?",shape=box,color=blue];
		j3949769218 -> j3346217871;
		j3949769218 -> j3959582952;
		j3949769218 -> j2430963326;
	j3871972680 [label="Von wem sprichst du, wenn du sagst, dass er euch alle kommen holen \"sollte\" ? Ich schau dich an, das Kind, den Teufel, sogar Monsieur Loid oder le Cardinal ... viele Jahrhunderte liegen hinter euch allen.",shape=box,color=blue];
		j3871972680 -> j2985562652;
	j2985562652 [label="Ich frage mich, wie viele Jahrhunderte noch vor uns liegen, bis Lua für uns kommt. Und ich frage mich, wie sehnsüchtig ich sie umarmen werde, wenn dieser Tag kommt. Aber das ist mein Glaube, nicht deiner.",shape=box,color=blue];
		j2985562652 -> j3949769218;
	j3011316372 [label="Ich weiß es noch nicht. Er behält seine Pläne für sich, wie ein guter Teufel. Aber er glaubt nicht an Götter. Außer vielleicht an sich selbst.",shape=box,color=blue];
		j3011316372 -> j3949769218;
	j3910835904 [label="Non, das tut er nicht. Er ist dir sehr ähnlich, er glaubt nicht an Götter. Außer vielleicht an sich selbst.",shape=box,color=blue];
		j3910835904 -> j3949769218;
	j2351928 [label="Non, jeder, der mit offenem Geist kommt, wird mit offenen Armen empfangen.",shape=box,color=blue];
		j2351928 -> j2714065995;
	j2714065995 [label="Ich frage mich einfach: Bringt dir das Frieden ?",shape=box,color=blue];
		j2714065995 -> j3346217871;
		j2714065995 -> j3959582952;
		j2714065995 -> j2430963326;
	j3355664068 [label="Boolean DrifterFaithNoPeace is now true.",color=orange];
		j3355664068 -> j3938373337;
	j4208488836 [label="+10 Chemistry",color=orange];
		j4208488836 -> j1654352773;
	j4187272476 [label="+10 Chemistry",color=orange];
		j4187272476 -> j3928931949;
	j2066372921 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j2066372921 -> j406813896;
	j3938373337 [label="+10 Chemistry",color=orange];
		j3938373337 -> j27393286;
	j1654352773 [label="Meine Eifersucht ist grenzenlos! Sie würde mich verzehren. Ich würde ... gern noch einmal mit dir darüber sprechen, wenn du erlaubst? Ich möchte weder predigen noch neugierig sein. Ich möchte dich nicht beunruhigen.",shape=box,color=blue];
		j1654352773 -> j1159178443;
	j3928931949 [label="Dann weiß ich, dass mein Sol dir zulächelt, ob du zu ihm betest oder nicht, denn du hast den einzigen Weg gefunden, den du benötigst.",shape=box,color=blue];
		j3928931949 -> j244567254;
	j406813896 [label="Aah, pardonne-moi ! Die kleine Marie hält eine Predigt, wie peinlich! Ich bin nicht hier, um dir wie ein Schullehrer einen Vortrag zu halten.",shape=box,color=blue];
		j406813896 -> j2047582207;
	j27393286 [label="Deine Ehrlichkeit berührt mich zutiefst, Wanderer. Ich würde ... gern noch einmal mit dir darüber sprechen, wenn du erlaubst? Ich möchte weder predigen noch neugierig sein. Ich möchte dich nicht beunruhigen.",shape=box,color=blue];
		j27393286 -> j1159178443;
	j1159178443 [label="Ich bin nur neugierig und möchte dir helfen, wenn ich kann. Bitte sag einfach nein und wir sprechen nie wieder darüber.",shape=box,color=blue];
		j1159178443 -> j1747291239;
		j1159178443 -> j2954718440;
	j244567254 [label="Können wir noch einmal darüber sprechen? Ich bin so neugierig und möchte mehr erfahren.",shape=box,color=blue];
		j244567254 -> j1747291239;
		j244567254 -> j2954718440;
	j1747291239 [label="Nein danke.",shape=box,color=red];
		j1747291239 -> j3609063368;
	j2954718440 [label="Natürlich.",shape=box,color=red];
		j2954718440 -> j2264345400;
	j3609063368 [label="Boolean DrifterFaithStop is now true.",color=orange];
		j3609063368 -> j544665589;
	j2264345400 [label="Merci, merci ! In dem, was du mir gerade gegeben hast, liegt großes Vertrauen. Ich werde es nicht verschwenden. Bis dahin.",shape=box,color=blue];
		j2264345400 -> "Chat ends.";
