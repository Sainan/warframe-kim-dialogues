		j1632146016 -> j1282587679;
	j1121917319 [label="Tu crois pouvoir débarquer ici depuis le futur et tous nous manipuler comme des marionnettes ?! Je te suggère de prendre cette machine, de te pencher et de te l'enfoncer fermement dans le derrière, espèce de sale pourriture répugnante et puante !",shape=box,color=blue];
		j1121917319 -> j4010450685;
	j4163774039 [label="Ein \"Paar?\" Mein lieber Wolf, ich glaube, die Zeiten haben sich seit meiner Ära von fiancés und arrangierten Ehen geändert ... Ich bezweifle stark, dass du um eine Heirat bittest !",shape=box,color=blue];
		j4163774039 -> j2288405293;
	j3448596377 [label="Oui, das ist vernünftig. Durchaus vernünftig. Ich komme aus einer Zeit, der formellen Brautwerbung, oui ? Ich bin allerdings neugierig zu erfahren, wie sich die Zeiten geändert haben.",shape=box,color=blue];
		j3448596377 -> j2444678806;
