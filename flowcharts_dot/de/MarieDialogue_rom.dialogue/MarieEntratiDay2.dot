digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieEntratiDay2 begins." [color=orange];
		"MarieEntratiDay2 begins." -> j1372880521;
	j1372880521 [label="Drifter. Ich habe mir Zeit zum Nachdenken genommen und mich ... beruhigt. Ich habe eine strenge Regel, was Gespräche angeht, wenn ich furieuse bin.",shape=box,color=blue];
		j1372880521 -> j69936295;
	j69936295 [label="Evaluate expressions",color=orange];
		j69936295 -> j1577672930 [label="MarieEntrati5a",color=purple];
		j69936295 -> j2390786810 [label="MarieEntrati5b",color=purple];
		j69936295 -> j1068129440 [label="MarieEntrati5c",color=purple];
		j69936295 -> j1957829018 [label="MarieEntrati5d",color=purple];
		j69936295 -> j2488406824 [label="MarieEntrati5e",color=purple];
		j69936295 -> j1847858267 [label="MarieEntrati5f",color=purple];
		j69936295 -> j1279781145 [label="MarieEntrati5g",color=purple];
		j69936295 -> j3811382613 [label="MarieEntrati5h",color=purple];
		j69936295 -> j427812575 [label="MarieEntrati5i",color=purple];
		j69936295 -> "Chat ends." [label="false",color=purple];
	j1577672930 [label="Es war ... ein Dolchstoß in die Rippen, den du mir gestern versetzt hast. Ich gebe zu, ich bin aus Wut geflohen, oui, aber auch aus répulsion. Nicht wegen dir, sondern wegen mir selbst.",shape=box,color=blue];
		j1577672930 -> j1573354713;
	j2390786810 [label="Doch bevor wir fortfahren, muss ich zunächst eine Sache ansprechen – deinen Tonfall mir gegenüber. Ich weiß, du hältst mich für ein Kind. Du bist Jahrhunderte alt, wenn nicht mehr.",shape=box,color=blue];
		j2390786810 -> j780651336;
	j1068129440 [label="Ich habe lange über deine Worte nachgedacht. Dass dies kein heiliger Krieg ist und dass le Cardinal manipulativ vorgegangen ist.",shape=box,color=blue];
		j1068129440 -> j2805456102;
	j1957829018 [label="Du hattest ... natürlich recht mit deiner Frage, wo in den Schriften von Sol steht, dass Unschuldige entbehrlich sind. Es steht dort nicht.",shape=box,color=blue];
		j1957829018 -> j469021118;
	j2488406824 [label="Bevor wir fortfahren, muss ich zunächst etwas ansprechen – deine Bereitschaft, meinen Glauben in einer Auseinandersetzung gegen mich zu verwenden, währen du selbst nicht gläubig bist.",shape=box,color=blue];
		j2488406824 -> j3229396789;
	j1847858267 [label="Es ... tut mir leid, dass ich gestern unser Gespräch abgebrochen habe. Es war einfach zu viel. Bevor wir fortfahren, muss ich jedoch wissen: Waren deine Worte ernst gemeint? Oder wolltest du nur meine Gefühle manipulieren, um dir eine unangenehme Auseinandersetzung zu ersparen ?",shape=box,color=blue];
		j1847858267 -> j3467427491;
		j1847858267 -> j3400999447;
	j1279781145 [label="Es scheint, als wären wir in Bezug auf le Cardinal in einer Sackgasse gelandet, oui ? Du siehst ihn als monstre, und ich als einen Heiligen.",shape=box,color=blue];
		j1279781145 -> j2251833554;
	j3811382613 [label="Ich möchte mit dir über deine Entscheidung sprechen, dich auf die Seite von Entrati zu stellen, nur um meine Gunst zu gewinnen, wenn du dazu bereit bist.",shape=box,color=blue];
		j3811382613 -> j2966893622;
	j427812575 [label="Ich möchte jetzt mit dir über deine Lüge sprechen, wenn du dazu bereit bist.",shape=box,color=blue];
		j427812575 -> j2966893622;
	"Chat ends." [color=orange];
	j1573354713 [label="Warum war ich so überrascht, dass du so tödlich präzise zielst? Meine Worte mit denen des Teufels vergleichst ...",shape=box,color=blue];
		j1573354713 -> j2803286868;
	j780651336 [label="Du bist durch unbekannte Dimensionen gereist, durch den Void selbst. Hast gegen Götter und Engel gekämpft. Wer bin ich für dich, oui ? Nur die kleine, dumme Marie.",shape=box,color=blue];
		j780651336 -> j138655395;
	j2805456102 [label="Und ich glaube ... oui, du hast recht. Dies ist kein heiliger Krieg. So etwas gibt es nicht. Krieg ist niemals heilig, gerecht oder rechtschaffen. Schmerz sollte niemals den Weg weisen.",shape=box,color=blue];
		j2805456102 -> j397684392;
	j469021118 [label="Krieg ist niemals heilig, gerecht oder rechtschaffen. Schmerz sollte niemals den Weg weisen.",shape=box,color=blue];
		j469021118 -> j397684392;
	j3229396789 [label="Das war heuchlerisch, Drifter. Grausam und wirkungslos. Es war ein Versuch, ein Gespräch zu \"gewinnen\", und so sollte man sich nicht verhalten.",shape=box,color=blue];
		j3229396789 -> j3841664941;
	j3467427491 [label="Ich habe es ernst gemeint. Es tut mir leid, falls mein Timing ... unpassend war. Ich mag dich sehr, Marie ...",shape=box,color=red];
		j3467427491 -> j2164512383;
	j3400999447 [label="Ich meinte es nicht so, ich war einfach ... hin- und hergerissen. Es tut mir wirklich sehr leid. Die Leidenschaft des Augenblicks.",shape=box,color=red];
		j3400999447 -> j1560623629;
	j2251833554 [label="Dennoch ... ich möchte das nicht so zwischen uns beenden. Du bist eine gütige Seele, und es gibt vieles zwischen uns, das ich nicht verbittert zurücklassen möchte.",shape=box,color=blue];
		j2251833554 -> j483300420;
	j2966893622 [label="Der Versuch, die Situation zu manipulieren, um meine Gefühle zu kontrollieren, ist ... heuchlerisch und grausam. Ich gebe zu, dass ich dich dafür hassen will, Drifter.",shape=box,color=blue];
		j2966893622 -> j2149032297;
	j2803286868 [label="Ich hielt mich für jemanden, dessen Geist und Herz offen sind für die Welt und alle in ihr. Und du hast mich mit einem einzigen, messerscharfen Pfeil eines Besseren belehrt.",shape=box,color=blue];
		j2803286868 -> j2013256519;
	j138655395 [label="Einerseits verstehe ich das. Ich habe Verständnis. Wir waren beide aufgebracht. Andererseits bitte ich dich, mir in Zukunft mehr Feingefühl und Takt entgegenzubringen.",shape=box,color=blue];
		j138655395 -> j884084877;
	j397684392 [label="Selbst das, was wir jetzt tun – die Zerstörung des Raunens und den Kampf gegen all deine vielen Feinde – ist nicht der Weg der Himmlischen.",shape=box,color=blue];
		j397684392 -> j4022101222;
	j3841664941 [label="Glaube ist keine Waffe, die man gegen andere einsetzt, und sollte es auch niemals sein. Er ist ein Schild. Ein Licht in der Dunkelheit. Eine Stimme, die den Weg weist.",shape=box,color=blue];
		j3841664941 -> j2379180049;
	j2164512383 [label="Bevor ich mich der Tragweite dessen stelle, muss ich mich erklären bezüglich le Cardinal, s'il vous plaît.",shape=box,color=blue];
		j2164512383 -> j4179242246;
	j1560623629 [label="Boolean DrifterMarie is now false.",color=orange];
		j1560623629 -> j3991303549;
	j483300420 [label="Check boolean LoidFamilyComplete",color=orange];
		j483300420 -> j955488138 [label=true,color=green];
		j483300420 -> j1166644243 [label=false,color=brown];
	j2149032297 [label="Dennoch ... ich möchte das nicht so zwischen uns beenden. Es gibt vieles zwischen uns, das ich nicht verbittert zurücklassen möchte.",shape=box,color=blue];
		j2149032297 -> j3805730835;
	j2013256519 [label="Ich bin wohl hier, pour m'excuser - es tut mir leid, dass ich so töricht in meiner Position verharrt habe. Ich hoffe, du verstehst das.",shape=box,color=blue];
		j2013256519 -> j3834055427;
		j2013256519 -> j3825897517;
	j884084877 [label="Denn ich habe auf der Straße gelebt. Ich habe jeden Tag meines Lebens körperliche Qualen erlitten. Ich habe Herzschmerz, Liebe, Angst und Ablehnung erfahren. Ich habe Leben und Verlust erlebt.",shape=box,color=blue];
		j884084877 -> j2647570126;
	j4022101222 [label="So notwendig es auch sein mag, das Schwert zu erheben, damit die Welt nicht von ihresgleichen überrannt wird, sollte es nicht verehrt werden. Und es ist gewiss nicht zu entschuldigen, wenn dabei Unschuldige zu Schaden kommen.",shape=box,color=blue];
		j4022101222 -> j3633783560;
	j2379180049 [label="Und dein Versuch, es gegen mich zu verwenden, um mich einfach zu \"besiegen\"? Das war eine feige Taktik. Aber wir waren beide aufgebracht, und ich werde ... dir verzeihen, wenn du mir verzeihst, für das, was ich im Zorn gesagt habe.",shape=box,color=blue];
		j2379180049 -> j1771129073;
		j2379180049 -> j3098557634;
	j4179242246 [label="Es fällt mir schwer, meine défense von le Cardinal aufzugeben ... und ich brauchte etwas, um zu verstehen, warum ich ihn nicht gehen lassen konnte.",shape=box,color=blue];
		j4179242246 -> j634287302;
	j3991303549 [label="Non, ich verstehe ... Wie viele Morde wurden als \"Verbrechen aus Leidenschaft\" begangen, oui ? Sicherlich wurden auch ebenso viele Kinder gezeugt in solchen Momenten.",shape=box,color=blue];
		j3991303549 -> j1865480270;
	j955488138 [label="Und du bist mir in so kurzer Zeit so wichtig geworden ... Ich empfinde unsere Gespräche als sehr joyeuses.",shape=box,color=blue];
		j955488138 -> j1186072069;
	j1166644243 [label="Ich wünsche mir wirklich, dass Monsieur Loid mit denen oben vereint wird. Ich wünsche mir, dass le Cardinals verbliebene Familie Trost findet, und du bist der Weg dorthin !",shape=box,color=blue];
		j1166644243 -> j955488138;
	j3805730835 [label="Check boolean LoidFamilyComplete",color=orange];
		j3805730835 -> j4127199124 [label=true,color=green];
		j3805730835 -> j3431333753 [label=false,color=brown];
	j3834055427 [label="Tue ich. Und es tut mir leid, falls meine Worte dich verletzt haben. Ich wusste einfach nicht, wie ich es anders ausdrücken sollte.",shape=box,color=red];
		j3834055427 -> j4232461146;
	j3825897517 [label="Ich bin froh, dass meine Worte bei dir angekommen sind. Ich hatte schon fast die Hoffnung verloren.",shape=box,color=red];
		j3825897517 -> j1873426660;
	j2647570126 [label="Und wenn du wirklich denkst, du stehst so hoch über uns allen, dann wirst du nichts als die Wolken sehen, in denen du dich verirrt hast.",shape=box,color=blue];
		j2647570126 -> j1771129073;
		j2647570126 -> j3098557634;
	j3633783560 [label="Daher ... räume ich ein, dass le Cardinal nicht dazu berechtigt ist, anderen im Namen eines \"höheren Wohls\" Schaden zuzufügen.",shape=box,color=blue];
		j3633783560 -> j3347135811;
	j1771129073 [label="Ich war frustriert, aber ich weiß nicht, wie ich dir sonst Vernunft beibringen soll. Entrati ist nicht dein Freund. Oder dein Vater.",shape=box,color=red];
		j1771129073 -> j2737820815;
	j3098557634 [label="Es tut mir leid. Ich habe mich von meinem Temperament leiten lassen und Dinge gesagt, die ich nicht sagen wollte.",shape=box,color=red];
		j3098557634 -> j2709042495;
	j634287302 [label="Ich möchte einfach nicht, dass du mich verachtest, wenn ich dir die ganze Wahrheit beichte. Es erscheint mir so kleinlich und pathétique.",shape=box,color=blue];
		j634287302 -> j3083289139;
		j634287302 -> j131324065;
	j1865480270 [label="Ich bin ... enttäuscht. Verletzt. Aber ich ... ich verzeihe dir.",shape=box,color=blue];
		j1865480270 -> j3087327568;
	j1186072069 [label="Evaluate expressions",color=orange];
		j1186072069 -> j1533972170 [label="DrifterMarie",color=purple];
		j1186072069 -> j1211131201 [label="DrifterLyon",color=purple];
		j1186072069 -> j630541090 [label="DrifterRoathe",color=purple];
		j1186072069 -> j1374972215 [label="false",color=purple];
	j4127199124 [label="Und es gibt noch so viel Güte, die du meinem Lyon und sogar dem Teufel erweisen könntest, nehme ich an ...",shape=box,color=blue];
		j4127199124 -> j3581565173;
		j4127199124 -> j3321546652;
	j3431333753 [label="Ich wünsche mir wirklich, dass Monsieur Loid mit denen oben vereint wird. Ich wünsche mir, dass le Cardinals verbliebene Familie Trost findet, und du bist der Weg dorthin !",shape=box,color=blue];
		j3431333753 -> j4127199124;
	j4232461146 [label="+10 Chemistry",color=orange];
		j4232461146 -> j2925130441;
	j1873426660 [label="Es spricht einiges dafür, großzügig zu sein, wenn man \"gewinnt\", weißt du.",shape=box,color=blue];
		j1873426660 -> j1571886900;
		j1873426660 -> j1301612703;
	j3347135811 [label="Welches \"höhere Wohl\" bleibt übrig, wenn nichts als zerbrochene Leben und Herzen auf dem Pfad dorthin verbleiben ?",shape=box,color=blue];
		j3347135811 -> j2013256519;
	j2737820815 [label="Non. Er ist nicht mein Vater. Denn mein Vater hat mich als Kind auf der Straße ausgesetzt, und le Cardinal hat nichts annähernd so Grausames getan.",shape=box,color=blue];
		j2737820815 -> j786197016;
	j2709042495 [label="Viele Gräueltaten wurden im Affekt begangen. So ist das nun mal.",shape=box,color=blue];
		j2709042495 -> j1983156873;
	j3083289139 [label="Ich glaube, ich weiß, was es sein könnte.",shape=box,color=red];
		j3083289139 -> j1938586169;
	j131324065 [label="Ich werde dich nicht verachten, Marie. Versprochen.",shape=box,color=red];
		j131324065 -> j211280932;
	j3087327568 [label="Um ... das Gespräch über le Cardinal zu beenden, wenn wir - meinen Herzschmerz einmal beiseite gelassen, s'il te plaît ?",shape=box,color=blue];
		j3087327568 -> j32525334;
	j1533972170 [label="Wie könnte ich dich tatsächlich von mir weisen, nachdem du mir deine Gefühle gestanden hast ?",shape=box,color=blue];
		j1533972170 -> j241469344;
	j1211131201 [label="Wie könnte ich dich abweisen, nachdem du mir deine Gefühle für unseren lieben Lyon anvertraut hast ? Du könntest ihm so viel Frieden ... und Trost schenken ...",shape=box,color=blue];
		j1211131201 -> j241469344;
	j630541090 [label="Wie könnte ich dich abweisen, wo du doch so vom Teufel besessen zu sein scheinst ? Ich verstehe deinen Geschmack nicht, aber ... es scheint, als ob du an unserer Seite stehen solltest, oui ?",shape=box,color=blue];
		j630541090 -> j241469344;
	j1374972215 [label="Ich möchte dich nicht als Gefährten verlieren. Können wir das alles beiseite lassen, auch wenn wir nicht einer Meinung sind, aber trotzdem weitermachen ?",shape=box,color=blue];
		j1374972215 -> j1735144508;
		j1374972215 -> j555822654;
	j3581565173 [label="Marie, warte. Bitte. Ich möchte mich entschuldigen.",shape=box,color=red];
		j3581565173 -> j3656872417;
	j3321546652 [label="Ich dachte ehrlich gesagt nicht, dass das, was ich dir sagte, von Bedeutung ist – ich dachte nicht, es wäre dir so wichtig.",shape=box,color=red];
		j3321546652 -> j3656872417;
	j2925130441 [label="Ich weiß das zu schätzen, mehr als du dir vorstellen kannst, Danke.",shape=box,color=blue];
		j2925130441 -> j4290168747;
	j1571886900 [label="Ich habe nur gescherzt.",shape=box,color=red];
		j1571886900 -> j344367253;
	j1301612703 [label="Tut mir leid. Ich \"gewinne\" nicht sehr oft.",shape=box,color=red];
		j1301612703 -> j2251724598;
	j786197016 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j786197016 -> j542165713;
	j1983156873 [label="+5 Chemistry",color=orange];
		j1983156873 -> j427740760;
	j1938586169 [label="Ich denke, für dich ist es offensichtlich, non ? Jemanden, der ebenfalls seine famille verloren hat.",shape=box,color=blue];
		j1938586169 -> j2711095482;
	j211280932 [label="Wir werden sehen. Ich glaube, ich habe in ihm ein bisschen den Vater gesehen, der mich verlassen hat, so klein und traurig mir das jetzt auch erscheint.",shape=box,color=blue];
		j211280932 -> j2711095482;
	j32525334 [label="Es fällt mir schwer, meine défense von le Cardinal aufzugeben ... und ich brauchte etwas, um zu verstehen, warum ich ihn nicht gehen lassen konnte.",shape=box,color=blue];
		j32525334 -> j1707025775;
	j241469344 [label="Können wir das alles beiseite lassen, auch wenn wir nicht einer Meinung sind, aber trotzdem weitermachen ?",shape=box,color=blue];
		j241469344 -> j1735144508;
		j241469344 -> j555822654;
	j1735144508 [label="Nein, ich bin damit noch nicht fertig. Wir müssen dieses Gespräch beenden.",shape=box,color=red];
		j1735144508 -> j2551683190;
	j555822654 [label="Ich denke das fair. Ich stimme zu.",shape=box,color=red];
		j555822654 -> j4069519823;
	j3656872417 [label="Ich verzeihe dir deine Lügen, Drifter. Wir können weiterhin Freunde und Verbündete sein. Aber warum hast du mich so angelogen, was wolltest du ... damit erreichen ?",shape=box,color=blue];
		j3656872417 -> j1574691804;
	j4290168747 [label="Es fällt mir schwer, meine défense von le Cardinal aufzugeben ... und ich brauchte etwas, um zu verstehen, warum ich ihn nicht gehen lassen konnte.",shape=box,color=blue];
		j4290168747 -> j3595537065;
	j344367253 [label="Oui, ja, nun.",shape=box,color=blue];
		j344367253 -> j4290168747;
	j2251724598 [label="+5 Chemistry",color=orange];
		j2251724598 -> j344367253;
	j542165713 [label="Add -10 to Family counter",color=orange];
		j542165713 -> j816189513;
	j427740760 [label="Ich nehme deine Entschuldigung an ... da ich mich auch von meinem Temperament habe beherrschen lassen.",shape=box,color=blue];
		j427740760 -> j1660528703;
	j2711095482 [label="Die Vorstellung ... dass ich nach all den Jahren von jemandem mit solch einer Freundlichkeit umgarnt werden könnte ?",shape=box,color=blue];
		j2711095482 -> j3614547170;
	j1707025775 [label="Ich möchte einfach nicht, dass du mich verachtest, wenn ich dir die ganze Wahrheit beichte. Es erscheint mir so kleinlich und pathétique.",shape=box,color=blue];
		j1707025775 -> j2754187890;
		j1707025775 -> j3169562145;
	j2551683190 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j2551683190 -> j4055920456;
	j4069519823 [label="+5 Chemistry",color=orange];
		j4069519823 -> j125169487;
	j1574691804 [label="Check boolean DrifterMarieWhoops",color=orange];
		j1574691804 -> j4018439358 [label=true,color=green];
		j1574691804 -> j1228329886 [label=false,color=brown];
	j3595537065 [label="Ich möchte einfach nicht, dass du mich verachtest, wenn ich dir die ganze Wahrheit beichte. Es erscheint mir so kleinlich und pathétique.",shape=box,color=blue];
		j3595537065 -> j2375936058;
		j3595537065 -> j2471726719;
	j816189513 [label="Boolean MarieEntratiCompleteB is now true.",color=orange];
		j816189513 -> j1508231473;
	j1660528703 [label="Erlaube mir ... zu erklären, warum es mir so schwerfällt, meine Verteidigung von le Cardinal aufzugeben. Und warum ich etwas brauchte, um zu verstehen, warum ich ihn nicht loslassen konnte.",shape=box,color=blue];
		j1660528703 -> j3595537065;
	j3614547170 [label="Die dumme kleine Marie ... natürlich war er nicht das, was er vorgab.",shape=box,color=blue];
		j3614547170 -> j1511795134;
		j3614547170 -> j3421245731;
	j2754187890 [label="Ich glaube, ich weiß, was es sein könnte.",shape=box,color=red];
		j2754187890 -> j3799378686;
	j3169562145 [label="Ich werde dich nicht verachten, Marie. Versprochen.",shape=box,color=red];
		j3169562145 -> j648398283;
	j4055920456 [label="Add -10 to Family counter",color=orange];
		j4055920456 -> j1128411;
	j125169487 [label="Bien. Wenigstens haben wir eine Übereinkunft.",shape=box,color=blue];
		j125169487 -> j361545222;
	j4018439358 [label="Mit mir ins Bett steigen ? Das ist widerlich.",shape=box,color=blue];
		j4018439358 -> j2261855889;
	j1228329886 [label="Mich benutzen ? Das ist abscheulich.",shape=box,color=blue];
		j1228329886 -> j2261855889;
	j2375936058 [label="Ich glaube, ich weiß, was es sein könnte.",shape=box,color=red];
		j2375936058 -> j1949664893;
	j2471726719 [label="Ich werde dich nicht verachten, Marie. Versprochen.",shape=box,color=red];
		j2471726719 -> j1371381175;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j1511795134 [label="Du bist nicht dumm, Marie. Ganz im Gegenteil. Wenn überhaupt, beweist mir das nur, wie wundervoll du wirklich bist.",shape=box,color=red];
		j1511795134 -> j2390324414;
	j3421245731 [label="Du bist mir so wichtig geworden, Marie ... und es tut mir so leid, dass dieses Gespräch so verlaufen ist.",shape=box,color=red];
		j3421245731 -> j2390324414;
	j3799378686 [label="Ich denke, für dich ist es offensichtlich, non ? Jemanden, der ebenfalls seine famille verloren hat.",shape=box,color=blue];
		j3799378686 -> j1325842658;
	j648398283 [label="Wir werden sehen. Ich glaube, ich habe in ihm ein bisschen den Vater gesehen, der mich verlassen hat, so klein und traurig mir das jetzt auch erscheint.",shape=box,color=blue];
		j648398283 -> j1325842658;
	j1128411 [label="Je ne pense pas.",shape=box,color=blue];
		j1128411 -> j3239706595;
	j361545222 [label="À la revoyure.",shape=box,color=blue];
		j361545222 -> j2853513911;
	j2261855889 [label="Deshalb muss ich sagen, dass ich dir niemals mein Herz anvertrauen kann. Ich möchte mich für diese Worte entschuldigen, die dich sicherlich enttäuschen werden -",shape=box,color=blue];
		j2261855889 -> j3709138139;
	j1949664893 [label="Ich denke, für dich ist es offensichtlich, non ? Jemanden, der ebenfalls seine famille verloren hat.",shape=box,color=blue];
		j1949664893 -> j1457742910;
	j1371381175 [label="Wir werden sehen. Ich glaube, ich habe in ihm ein bisschen den Vater gesehen, der mich verlassen hat, so klein und traurig mir das jetzt auch erscheint.",shape=box,color=blue];
		j1371381175 -> j1457742910;
	j2390324414 [label="Aber du musstest erkennen, dass Entrati kompliziert sein kann. Dass er genauso viel Schaden anrichten kann. Ich wollte nicht, dass du später noch mehr verletzt wirst.",shape=box,color=red];
		j2390324414 -> j3578069535;
