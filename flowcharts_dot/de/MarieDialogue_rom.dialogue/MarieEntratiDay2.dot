		j416877291 -> j764472111;
	j1131629439 [label="[Gefühle gestehen.] Du bist nicht dumm, Marie. Ganz im Gegenteil. Wenn überhaupt, beweist mir das nur, wie wundervoll du wirklich bist.",shape=box,color=red];
		j1131629439 -> j2722904624;
	j4239999718 [label="Und das sagst du mir, während du gleichzeitig meinem Seelenbruder deine Liebe gestehst ?! Glaubst du, du kannst uns beide für dumm verkaufen ?!",shape=box,color=blue];
		j4239999718 -> j1136076188;
	j964504860 [label="Und das sagst du mir, während du dich mit dem Teufel abgibst ?! Glaubst du, du kannst uns beide für dumm verkaufen ?!",shape=box,color=blue];
		j964504860 -> j1136076188;
	j2889195967 [label="Ich ... Oh, mon cœur. Mon cœur ! Oh, wie ich dasselbe fühle ! Aber ich wagte nicht, die Worte auszusprechen, ich wagte nicht, sie dir zu schreiben – denn ich hielt mich deswegen für eine Närrin.",shape=box,color=blue];
		j2889195967 -> j3272615681;
	j2248617153 [label="Oui, wie du sagtest, und nun sehe ich es ganz klar. Ich ... kann dir nur noch erneut für deine Geduld danken.",shape=box,color=blue];
