		j2486207884 -> j3110220910 [label="MarieDating",color=purple];
		j2486207884 -> j4189307511 [label="false",color=purple];
	j3764080359 [label="Unser lieber Lyon hätte sich so etwas nie im Leben vorstellen können. Sich so mit anderen zu unterhalten. Er amüsierte sich prächtig.",shape=box,color=blue];
		j3764080359 -> j1972157655;
	j3110220910 [label="Lyon hätte sich so etwas nie im Leben vorstellen können. Sich so mit anderen zu unterhalten. Er amüsierte sich prächtig, mon cœur.",shape=box,color=blue];
		j3110220910 -> j1972157655;
	j4189307511 [label="Lyon hätte sich so etwas nie im Leben vorstellen können. Sich so mit anderen zu unterhalten. Er amüsierte sich prächtig.",shape=box,color=blue];
		j4189307511 -> j1972157655;
	j1972157655 [label="Und ich weiß, dass ich im Abendgebet nicht den Himmlischen dafür danken muss. Sondern dir.",shape=box,color=blue];
		j1972157655 -> j3123960711;
	j3123960711 [label="Check boolean LyonDating",color=orange];
		j3123960711 -> j1982340295 [label=true,color=green];
		j3123960711 -> j719680036 [label=true,color=green];
		j3123960711 -> j719680036 [label=false,color=brown];
		j3123960711 -> j581259709 [label=false,color=brown];
	j1982340295 [label="Er liegt mir unendlich am Herzen. Ich bin froh, dass ich ihm Sicherheit geben kann.",shape=box,color=red];
		j1982340295 -> j2922677408;
	j719680036 [label="Ich bin froh über jeden Beitrag, den ich dazu geleistet habe.",shape=box,color=red];
		j719680036 -> j2922677408;
	j581259709 [label="Er verdient einen Ort, an dem er sich sicher fühlen kann. Freunde. Familie.",shape=box,color=red];
		j581259709 -> j2922677408;
	j2922677408 [label="+15 Chemistry",color=orange];
		j2922677408 -> j3446209423;
	j3446209423 [label="Oui ! Und das ist einfach ein weiterer Beweis dafür, dass wir genau da sind, wo wir hingehören. Hier. Bei dir. In diesem Sanctum. Und gemeinsam.",shape=box,color=blue];
		j3446209423 -> j3844703164;
	j3844703164 [label="Evaluate expressions",color=orange];
		j3844703164 -> j741903730 [label="MarieFamilyFail",color=purple];
