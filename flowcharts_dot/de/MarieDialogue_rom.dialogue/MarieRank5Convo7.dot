	j2965202005 [label="Bonjour ! Können wir kurz reden ? Es geht um deinen lieben Lyon ...",shape=box,color=blue];
		j2965202005 -> j1104246932;
	j3934760078 [label="Mon cœur ! Können wir kurz reden ? Es geht um Lyon ...",shape=box,color=blue];
