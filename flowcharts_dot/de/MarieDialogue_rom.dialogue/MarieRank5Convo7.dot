	j1007895435 [label="Bonjour ! Können wir kurz reden ? Es geht um Lyon ...",shape=box,color=blue];
		j1007895435 -> j1104246932;
	"Chat ends." [color=orange];
	j1104246932 [label="Er sagt, er hat dir jetzt alles erzählt, oui ? Allein der Gedanke daran treibt mir fast die Tränen in die Augen ...",shape=box,color=blue];
		j1104246932 -> j3661532468;
		j1104246932 -> j3892622951;
		j1104246932 -> j3867286231;
	j3661532468 [label="Ich glaube, es geht ihm gut. Es ist nur ... was er durchgemacht hat – das ist eine Menge.",shape=box,color=red];
		j3661532468 -> j2704946318;
	j3892622951 [label="Es hat mir das Herz gebrochen ... Ich wünschte nur, ich könnte mehr für ihn tun ...",shape=box,color=red];
		j3892622951 -> j296644566;
	j3867286231 [label="Ich bin einfach nur froh, dass er ...mir endlich genug vertraute, um mir seine ganze Geschichte zu erzählen ...",shape=box,color=red];
		j3867286231 -> j2269236118;
	j2704946318 [label="+5 Chemistry",color=orange];
		j2704946318 -> j2667443512;
	j296644566 [label="Du hilfst so viel allein durchs Zuhören. Dadurch, dass du da bist, wenn er reden möchte. Er ist nicht zerbrochen – die Risse in ihm reichen nicht so tief, dass sie sein Fundament gefährden. Es sind oberflächliche Narben.",shape=box,color=blue];
		j296644566 -> j2615372481;
	j2269236118 [label="+5 Chemistry",color=orange];
		j2269236118 -> j2721289808;
	j2667443512 [label="Oui, du verstehst. Er ist kein zerbrochenes, leeres Wesen. Die Risse in ihm gefährden nicht sein Fundament. Es sind oberflächliche Narben.",shape=box,color=blue];
		j2667443512 -> j2615372481;
	j2615372481 [label="Wusstest du, dass ich ihn gestern dabei erwischt habe, wie er M'sieur Fibonacci ein Buch über antike Philosophie vorlas ?",shape=box,color=blue];
		j2615372481 -> j1786775587;
	j2721289808 [label="Oui. Dein Zuhören bewirkt so viel. Er ist kein zerbrochenes, leeres Wesen. Die Risse in ihm gefährden nicht sein Fundament. Es sind oberflächliche Narben.",shape=box,color=blue];
		j2721289808 -> j2615372481;
	j1786775587 [label="M'sieur Fibonacci bettelt schon ewig darum, dass ihm jemand daraus vorliest, aber alle weigerten sich ! Wollten ihm keine Munition geben, ha !",shape=box,color=blue];
		j1786775587 -> j2486207884;
	j2486207884 [label="Evaluate expressions",color=orange];
