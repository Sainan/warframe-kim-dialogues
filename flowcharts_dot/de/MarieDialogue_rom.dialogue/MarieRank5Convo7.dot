		j3844703164 -> j2553842955 [label="MarieFamilySuccess",color=purple];
		j3844703164 -> j2553842955 [label="false",color=purple];
	j741903730 [label="Deswegen ... überdenke ich nochmal meine Entscheidung, mit dir an der Wiederherstellung der Beziehungen zwischen Monsieur Loid und der Familie oben zu arbeiten.",shape=box,color=blue];
		j741903730 -> j3878296974;
		j741903730 -> j1620100631;
	j708134293 [label="Mir wird dadurch bewusst, welch eine tragédie es ist, dass der Teufel sich weigert, unsere Bemühungen beim Wiederaufbau der Brücke zwischen Monsieur Loid und der Familie oben zu unterstützen ... Ich frage mich, ob man da nicht etwas tun kann.",shape=box,color=blue];
		j708134293 -> j3413405907;
		j708134293 -> j910125775;
	j2553842955 [label="Das bestärkt mich nur noch mehr in meinem Wunsch, die Kluft zwischen Monsieur Loid und der Familie oben zu überbrücken ! Lass uns zügig daran arbeiten !",shape=box,color=blue];
		j2553842955 -> "Chat ends.";
	j3878296974 [label="Ich ... hätte wirklich nicht gedacht, dass ich dich dazu bringen kann, mir zu helfen.",shape=box,color=red];
		j3878296974 -> j3997272488;
	j1620100631 [label="Wirklich? Du änderst deine Meinung dazu?",shape=box,color=red];
		j1620100631 -> j3997272488;
	j3413405907 [label="Bist du dir sicher, dass du es deswegen mit ihm aufnehmen willst?",shape=box,color=red];
		j3413405907 -> j2619476522;
	j910125775 [label="Im Ernst? Du würdest in meinem Namen mit Roathe streiten?",shape=box,color=red];
		j910125775 -> j2619476522;
	j3997272488 [label="Nach allem, was du getan hast, um meinem Seelenbruder zu helfen ? Auch wenn wir in anderen Dingen nicht übereinstimmen – und vielleicht nie einer Meinung sein werden –, dies? Dies werde ich für dich tun.",shape=box,color=blue];
		j3997272488 -> j1006036585;
	j2619476522 [label="Ha ! Ich habe schon wegen viel weniger mit dem Teufel gestritten. Nachdem, was du getan hast, um meinem Seelenbruder zu helfen ? Das würde ich mit Freuden tun. ",shape=box,color=blue];
		j2619476522 -> j2111058214;
	j1006036585 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j1006036585 -> j2005594156;
	j2111058214 [label="Der Teufel kennt seinen Meister nicht. Schau, wie ich seinen Willen unter meinem eigenen vernichte. Marie sera victorieuse !",shape=box,color=blue];
