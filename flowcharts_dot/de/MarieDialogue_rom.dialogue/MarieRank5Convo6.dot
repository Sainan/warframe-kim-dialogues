		j3097375491 -> j4196020304 [label=true,color=green];
		j3097375491 -> j594232532 [label=false,color=brown];
	j1833998282 [label="Wolf ! Mein Wolf ! Ich habe Otak getroffen ! Ich habe ihn endlich getroffen !",shape=box,color=blue];
		j1833998282 -> j394648735;
		j1833998282 -> j2115626695;
	j1055738010 [label="Ich habe Otak getroffen ! Ich habe ihn endlich getroffen !",shape=box,color=blue];
		j1055738010 -> j394648735;
		j1055738010 -> j2115626695;
	j4196020304 [label="Wolf ! Mein Wolf ! Das Gesicht auf dem Rücken von Monsieur Necraloid ! Ich habe ihn endlich getroffen !",shape=box,color=blue];
		j4196020304 -> j3030325561;
		j4196020304 -> j2582969073;
		j4196020304 -> j1074079853;
	j594232532 [label="Das Gesicht auf dem Rücken von Monsieur Necraloid ! Ich habe ihn endlich getroffen !",shape=box,color=blue];
		j594232532 -> j3030325561;
		j594232532 -> j2582969073;
		j594232532 -> j1074079853;
	j394648735 [label="Wie ist das Gespräch mit ihm verlaufen?",shape=box,color=red];
		j394648735 -> j2168126787;
	j2115626695 [label="Hast du dich gerne mit ihm unterhalten?",shape=box,color=red];
		j2115626695 -> j629823618;
	j3030325561 [label="Du hast Otak getroffen? Auweia ... Wie ist es gelaufen?",shape=box,color=red];
		j3030325561 -> j2527698801;
	j2582969073 [label="Ich freue mich, dass ihr euch endlich kennengelernt habt. Otak ist manchmal etwas schwer zu erklären.",shape=box,color=red];
		j2582969073 -> j2431718181;
	j1074079853 [label="Armer Otak ... Wie ist es gelaufen?",shape=box,color=red];
		j1074079853 -> j1602530497;
	j2168126787 [label="Er ... hat sich mir dreimal im gleichen Gespräch vorgestellt, als wären wir uns bisher nicht vorgestellt worden.",shape=box,color=blue];
		j2168126787 -> j2828693962;
	j629823618 [label="Habe ich. Obwohl ich vielleicht lieber geweint hätte. Er hat sich mir dreimal im gleichen Gespräch vorgestellt, als wären wir uns bisher nicht vorgestellt worden.",shape=box,color=blue];
		j629823618 -> j2828693962;
	j2527698801 [label="Warum bist du nicht erfreut darüber, dass ich ihn getroffen habe ?",shape=box,color=blue];
		j2527698801 -> j3382099466;
		j2527698801 -> j171298610;
		j2527698801 -> j1179176857;
	j2431718181 [label="Ja, das kann ich mir vorstellen. Kinder-Gekritzel auf dem Rücken eines Automatons. Er war einfach nur liebenswürdig und charmant !",shape=box,color=blue];
		j2431718181 -> j29047196;
	j1602530497 [label="Er war einfach nur liebenswürdig und charmant ! Aber unter einer dicken Schicht Humor, verbirgt sich ein tiefer Schmerz.",shape=box,color=blue];
		j1602530497 -> j2671976589;
	j2828693962 [label="Er hat mich auf dieselbe unerschrockene, fröhliche Art begrüßt, wie auch schon vorher. Aber er kannte mich als eine Sœur de Sol !",shape=box,color=blue];
		j2828693962 -> j3282375784;
	j3382099466 [label="Tut mir leid. Er kann Leuten manchmal auf die Nerven gehen. Es ist nicht seine Schuld.",shape=box,color=red];
		j3382099466 -> j567417617;
	j171298610 [label="So sollte es nicht klingen. Er kann für manche nur etwas ... entmutigend wirken.",shape=box,color=red];
		j171298610 -> j567417617;
	j1179176857 [label="Er geht mir manchmal einfach auf die Nerven, das ist alles.",shape=box,color=red];
		j1179176857 -> j1697868422;
	j29047196 [label="Aber unter einer dicken Schicht Humor, verbirgt sich ein tiefer Schmerz.",shape=box,color=blue];
		j29047196 -> j2671976589;
	j2671976589 [label="Erzählst du mir die Geschichte des armen Monsieur Otak ?",shape=box,color=blue];
		j2671976589 -> j176193530;
	j3282375784 [label="Tatsächlich wusste er viel über die Himmlischen ! Wir haben lange über \"alte Religionen\" gesprochen, wie er sie nannte, in den \"Tagen vor Imperium der Orokin\".",shape=box,color=blue];
		j3282375784 -> j3784178665;
	j567417617 [label="Und ich hoffe, dass man ihm Freundlichkeit und Geduld entgegenbringt. Mais par la grâce de Sol gehen wir alle unseren Weg.",shape=box,color=blue];
		j567417617 -> j261674412;
	j1697868422 [label="Ich wünschte mir, du versuchst freundlicher zu jemandem zu sein, der ganz klar infirme ist. Nur durch Sols Gnade gehen wir alle unseren Weg.",shape=box,color=blue];
		j1697868422 -> j261674412;
	j176193530 [label="Otak war einst ein Archimede, Wissenschaftler und Akademiker der Orokin. Was ihm widerfahren ist, ist nicht gerade eine schöne Geschichte.",shape=box,color=red];
		j176193530 -> j1707119468;
	j3784178665 [label="Obwohl er sagte, dass viel von diesem Wissen inzwischen verloren ist, tief in den Archiven und strengstens verboten. Er verpflichtete mich zur Geheimhaltung.",shape=box,color=blue];
		j3784178665 -> j928842700;
	j261674412 [label="Ein solches Schicksal könnte auf jeden von uns warten. Sogar auf dich.",shape=box,color=blue];
		j261674412 -> j876827764;
		j261674412 -> j76151006;
	j1707119468 [label="Er war allem Anschein nach ein Genie und der Kopf hinter der Nutzung von Argon-Kristallen.",shape=box,color=red];
		j1707119468 -> j2460543428;
	j928842700 [label="Er sagte mir, er sei zutiefst besorgt, dass Exekutor Ballas - wer auch immer das sein mag - meine Sekte an Ketzern entdecken und mich hinrichten lassen könnte.",shape=box,color=blue];
		j928842700 -> j737975390;
		j928842700 -> j2694081141;
	j876827764 [label="Ich kann einfach keine Zeit für ihn aufwenden, es tut mir leid.",shape=box,color=red];
		j876827764 -> j1323736917;
	j76151006 [label="Du hast recht, es tut mir leid. So habe ich das nicht gemeint.",shape=box,color=red];
		j76151006 -> j2671976589;
	j2460543428 [label="Die aus dem Void gewonnen werden – sie sind der Grund, warum wir viele der mächtigen Warframes und Waffen erschaffen können, die wir herstellen.",shape=box,color=red];
		j2460543428 -> j3335022828;
	j737975390 [label="Das ... wird nicht passieren. Sprich weiter.",shape=box,color=red];
		j737975390 -> j2508257015;
	j2694081141 [label="Ballas ist tot ... sprich weiter.",shape=box,color=red];
		j2694081141 -> j2508257015;
	j1323736917 [label="Dann tut es mir leid, dass ich noch mehr deiner Zeit verschwendet habe.",shape=box,color=blue];
		j1323736917 -> j3007723528;
	j3335022828 [label="Er spezialisierte sich auf Kristallographie. Und seine Arbeiten wurden hier in den Laboren archiviert.",shape=box,color=red];
		j3335022828 -> j2805309690;
	j2508257015 [label="+5 Chemistry",color=orange];
		j2508257015 -> j1842405683;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j2805309690 [label="Aus irgendeinem Grund, ich weiß nicht warum, wurde er in ein Cephalon verwandelt und erhielt seine eigene Nekraloid-Hülle.",shape=box,color=red];
		j2805309690 -> j2431551917;
	j1842405683 [label="Habe ich schon vermutet ... Also, er fragte, wo ich herkomme und als ich es ihm sage, hat er gelacht und gesagt \"Nein, das ist unmöglich! Ich weiß das schließlich, ich bin -\"",shape=box,color=blue];
		j1842405683 -> j2658387214;
	j2431551917 [label="Nicht alle Cephalons wurden als Bestrafung erschaffen. Aber hier auf Deimos lief es ... nicht gut, und er wurde schwer beschädigt.",shape=box,color=red];
		j2431551917 -> j937500931;
	j2658387214 [label="Und dann ... stellte er sich mir wieder vor. Und fragte mich, ob ich mit Mineralienproben aus den Ebenen zurückkäme ...",shape=box,color=blue];
		j2658387214 -> j2608782739;
		j2658387214 -> j3592574079;
	j937500931 [label="Pauvre petit ...",shape=box,color=blue];
		j937500931 -> j1698645168;
	j2608782739 [label="Oh Marie. Es tut mir so leid ...",shape=box,color=red];
		j2608782739 -> j3044859895;
	j3592574079 [label="Ja ... das ist Otak.",shape=box,color=red];
		j3592574079 -> j3044859895;
	j1698645168 [label="Boolean MarieOtak1 is now true.",color=orange];
		j1698645168 -> j394648735;
		j1698645168 -> j2115626695;
	j3044859895 [label="Es zerreißt mich förmlich daran zu denken, dass man nichts mehr für ihn tun kann.",shape=box,color=blue];
		j3044859895 -> j1970966774;
	j1970966774 [label="Evaluate expressions",color=orange];
		j1970966774 -> j3756416516 [label="MarieCephalonSoul",color=purple];
		j1970966774 -> j2456945781 [label="MarieCephalonNoSoul",color=purple];
		j1970966774 -> j1469590578 [label="MarieCephalonUnsure",color=purple];
		j1970966774 -> j3695119899 [label="false",color=purple];
	j3756416516 [label="Oh Himmlische - was für eine Hölle habt ihr für ihn geschaffen, dass ihr seine Seele in diesem Käfig aus Wissenschaft und flackernden Lichtern gefangen haltet ?",shape=box,color=blue];
		j3756416516 -> j356156735;
	j2456945781 [label="Ich kann nur zu den Himmlischen beten, dass du recht hast und nichts in dieser Hülle übrig ist, außer ... Wissenschaft und flackernde Lichter.",shape=box,color=blue];
		j2456945781 -> j2753526690;
	j1469590578 [label="Ich weiß, dass du dir nicht sicher bist, ob Cephalons Seelen haben - aber ich kann nur zu den Himmlischen beten, dass ... der arme Otak nicht leidet.",shape=box,color=blue];
		j1469590578 -> j3722165392;
	j3695119899 [label="Ich kann nur zu den Himmlischen beten, dass in dieser Hülle nichts anderes übrig ist als ... Wissenschaft und flackernde Lichter.",shape=box,color=blue];
		j3695119899 -> j2165716714;
	j356156735 [label="Warum habt ihr ihn dort zurückgelassen, zerbrochen und wartend, bis er sterben darf, um Frieden zu finden ? Ich kann nur beten ... dass, sollte es dort drin eine Art von Präsenz geben -",shape=box,color=blue];
		j356156735 -> j938510727;
	j2753526690 [label="Und dass es keine Seele ist, die in diesem kaputten Ding gefangen ist, die nur darauf wartet, dass sie endlich sterben darf, um Frieden zu finden.",shape=box,color=blue];
		j2753526690 -> j857543691;
	j3722165392 [label="Dass es keine Seele ist, die in diesem kaputten Ding gefangen ist, die nur darauf wartet, dass sie endlich sterben darf, um Frieden zu finden.",shape=box,color=blue];
		j3722165392 -> j511544211;
	j2165716714 [label="Und dass es keine Seele ist, die in diesem kaputten Ding gefangen ist, die nur darauf wartet, dass sie endlich sterben darf, um Frieden zu finden.",shape=box,color=blue];
		j2165716714 -> j511544211;
	j938510727 [label="- dass sie freiwillig dort ist, als eine Art einsame Wache ...",shape=box,color=blue];
		j938510727 -> j3507398046;
	j857543691 [label="Denn, wenn du falsch liegst und wirklich eine Seele gegen ihren Willen in diesem Käfig verbleibt ?",shape=box,color=blue];
		j857543691 -> j2657480982;
	j511544211 [label="Oder sollte es noch eine Art Präsenz geben, dass sie freiwillig dort ist, als eine Art einsame Wache.",shape=box,color=blue];
		j511544211 -> j1220512705;
	j3507398046 [label="Alles andere wäre genug, die Güte der Götter infrage zu stellen, non ?",shape=box,color=blue];
		j3507398046 -> j847055341;
	j2657480982 [label="Dann ist das genug, die Güte der Götter infrage zu stellen, non ?",shape=box,color=blue];
		j2657480982 -> j847055341;
	j1220512705 [label="Alles andere wäre, die Güte der Götter infrage zu stellen, non ?",shape=box,color=blue];
		j1220512705 -> j847055341;
	j847055341 [label="Und wo würde ich dann bleiben ?",shape=box,color=blue];
		j847055341 -> j83417062;
	j83417062 [label="Vergib mir, ich bin ... je suis mélancolique aujourd'hui.",shape=box,color=blue];
		j83417062 -> j4190999030;
	j4190999030 [label="Evaluate expressions",color=orange];
		j4190999030 -> j4057618467 [label="MarieRoathePastry1",color=purple];
		j4190999030 -> j3958691879 [label="MarieRoathePastry1",color=purple];
		j4190999030 -> j1453253803 [label="MarieRoathePastry1",color=purple];
		j4190999030 -> j2469621914 [label="MarieRoathePastry1",color=purple];
		j4190999030 -> j4057618467 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j3958691879 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j1453253803 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j2469621914 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j4057618467 [label="false",color=purple];
		j4190999030 -> j1453253803 [label="false",color=purple];
		j4190999030 -> j2469621914 [label="false",color=purple];
	j4057618467 [label="Kann ich dich irgendwie aufmuntern? Wir könnten Roathe ärgern gehen.",shape=box,color=red];
		j4057618467 -> j792762010;
	j3958691879 [label="Kann ich dich irgendwie aufmuntern? Vielleicht etwas Gebäck stibitzen?",shape=box,color=red];
		j3958691879 -> j2337520772;
	j1453253803 [label="Manchmal sind Götter grausam, Marie. So ist das Leben.",shape=box,color=red];
		j1453253803 -> j1865021272;
	j2469621914 [label="Schon ok. Dazu hast du jedes Recht.",shape=box,color=red];
		j2469621914 -> j2023534905;
	j792762010 [label="+15 Chemistry",color=orange];
		j792762010 -> j1668018348;
	j2337520772 [label="+20 Chemistry",color=orange];
		j2337520772 -> j1668018348;
	j1865021272 [label="+5 Chemistry",color=orange];
		j1865021272 -> j1933036534;
	j2023534905 [label="+20 Chemistry",color=orange];
		j2023534905 -> j1899064770;
	j1668018348 [label="Ha ! Merci. Damit trocknest du meine dummen Tränen bestimmt. Du weißt genau, wie man die dumme kleine Marie aufmuntert, non ?",shape=box,color=blue];
		j1668018348 -> j2091274392;
		j1668018348 -> j982403357;
	j1933036534 [label="Oui. Du hast ja recht. Das sind sie. Die Welt ist voller Geschichten, wie der von Monsieur Otak und viele sind schlimmer als seine. Ich sollte wegen einer nicht weinen.",shape=box,color=blue];
		j1933036534 -> j2058364603;
	j1899064770 [label="Merci. Nun, ich möchte es nicht länger sein. Ich werde etwas Erfreulicheres tun ! Ich glaube, M'sieur Fibonaccis Behälter sollte mal wieder abgestaubt werden.",shape=box,color=blue];
		j1899064770 -> j2425134241;
	j2091274392 [label="Du bist nicht dumm, gar nicht. Ich fühle mich genauso.",shape=box,color=red];
		j2091274392 -> j2235898819;
	j982403357 [label="Das ist das Mindeste, was ich für dich tun kann.",shape=box,color=red];
		j982403357 -> j2235898819;
	j2058364603 [label="Und trotzdem sitze ich hier und tue genau das. Danke, dass du mich an meine Dummheit erinnerst. Fie ! Dumme kleine Marie. Naja ... ich glaube M’sieur Fibonaccis Behälter sollte mal wieder abgestaubt werden.",shape=box,color=blue];
		j2058364603 -> j2425134241;
	j2425134241 [label="Check boolean MarieDating",color=orange];
		j2425134241 -> j1090427720 [label=true,color=green];
		j2425134241 -> j1783435543 [label=false,color=brown];
	j2235898819 [label="+5 Chemistry",color=orange];
		j2235898819 -> j4093292054;
	j1090427720 [label="À la revoyure, mein Wolf.",shape=box,color=blue];
		j1090427720 -> j3007723528;
	j1783435543 [label="À la revoyure !",shape=box,color=blue];
		j1783435543 -> j3007723528;
	j4093292054 [label="Check boolean MarieDating",color=orange];
		j4093292054 -> j1161940765 [label=true,color=green];
		j4093292054 -> j2079033712 [label=false,color=brown];
	j1161940765 [label="Merci, merci, merci, mein Wolf. Dann lass uns gehen und Unfug anstellen.",shape=box,color=blue];
		j1161940765 -> j3007723528;
	j2079033712 [label="Merci, merci, merci. Dann lass uns gehen und Unfug anstellen.",shape=box,color=blue];
