digraph {
	"MarieRank2Convo4 begins." [color=orange];
		"MarieRank2Convo4 begins." -> j1310385846;
		"MarieRank2Convo4 begins." -> j4034706027;
		"MarieRank2Convo4 begins." -> j129698615;
	j1310385846 [label="Darf ich dich etwas über Roathe fragen? Oder würdest du dann in Rage geraten?",shape=box,color=red];
		j1310385846 -> j3046238341;
	j4034706027 [label="Darf ich dich nach dem Elefanten im Raum fragen?",shape=box,color=red];
		j4034706027 -> j1582592956;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j3046238341 [label="Ce diable est un imbécile qui se croit au-dessus de tout reproche ! Je préfèrerais boire un pot de vernis à bois plutôt que de passer une minute de plus à l'écouter s'enorgueillir comme un chat qui se lèche le pelage !",shape=box,color=blue];
		j3046238341 -> j1157453965;
		j3046238341 -> j501954464;
	j1582592956 [label="Quoi! Où ça? Un éléphant ?!",shape=box,color=blue];
		j1582592956 -> j2114645308;
	"Chat ends." [color=orange];
	j1157453965 [label="Das war sehr kreativ.",shape=box,color=red];
		j1157453965 -> j1724879267;
	j501954464 [label="Ich ... gehe davon aus, nichts davon war etwas Nettes.",shape=box,color=red];
		j501954464 -> j2004234442;
	j2114645308 [label="Ich sehe nur einen Fisch, einen Vogel und ... was auch immer M'sieur Tagfer ist. Ich sehe viele seltsame Dinge in diesem Heiligtum, aber keinen éléphant – war das ein Witz ?",shape=box,color=blue];
		j2114645308 -> j742040804;
	j1724879267 [label="+5 Chemistry",color=orange];
		j1724879267 -> j1634218591;
	j2004234442 [label="+5 Chemistry",color=orange];
		j2004234442 -> j2019476809;
	j742040804 [label="Oh! Entschuldigung. Diese Redewendung habe ich von meinen Freunden aus dem Jahr 1999 gelernt ... ",shape=box,color=red];
		j742040804 -> j298859795;
		j742040804 -> j3974739474;
	j1634218591 [label="Merci. Es war kreativ, aber du hast mir eine Frage gestellt, und mein Zorn hätte sich nicht gegen dich richten sollen, verzeih mir.",shape=box,color=blue];
		j1634218591 -> j3218359144;
	j2019476809 [label="War es nicht, nein. Verzeih, ich hätte dir das nicht entgegenwerfen sollen.",shape=box,color=blue];
		j2019476809 -> j3218359144;
	j298859795 [label="Ich habe es nicht wörtlich gemeint.",shape=box,color=red];
		j298859795 -> j2645495802;
	j3974739474 [label="Jetzt verstehe ich, warum sie das immer so niedlich finden, wenn ich verwirrt bin ...",shape=box,color=red];
		j3974739474 -> j146378137;
	j3218359144 [label="Evaluate expressions",color=orange];
		j3218359144 -> j2813511700 [label="MarieRoatheWarning",color=purple];
		j3218359144 -> j1667544350 [label="DrifterRoathe",color=purple];
		j3218359144 -> j79036757 [label="MarieRoatheSoldier",color=purple];
		j3218359144 -> j4059141573 [label="false",color=purple];
	j2645495802 [label="+5 Chemistry",color=orange];
		j2645495802 -> j1177286634;
	j146378137 [label="+5 Chemistry",color=orange];
		j146378137 -> j829093632;
	j2813511700 [label="Allerdings überrascht es mich, dass du mich erneut um meine Meinung bittest. Deine Warnung war deutlich genug. Du willst nicht, dass ich schlecht über ihn und seinesgleichen rede.",shape=box,color=blue];
		j2813511700 -> j1736422886;
		j2813511700 -> j3351813143;
	j1667544350 [label="Ich gebe zu, ich weiß nicht, ob ich dieses Gespräch fortsetzen soll, wenn ich ehrlich bin. Du scheinst dich zu ihm hingezogen zu fühlen wie comme un papillon vers une flamme.",shape=box,color=blue];
		j1667544350 -> j626168116;
		j1667544350 -> j581469012;
	j79036757 [label="Willst du ihn immer noch als Verbündeten? Du spielst ein gefährliches Spiel, wenn du ihn deinem Rudel hinzufügst, Wolf. Er könnte dir die Kehle herausreißen, wenn du es am wenigsten erwartest.",shape=box,color=blue];
		j79036757 -> j2496921276;
		j79036757 -> j3869565476;
	j4059141573 [label="Ich bin überrascht, dass du mich fragst. Es ist klar, dass ich nicht viel von diesem Teufel halte.",shape=box,color=blue];
		j4059141573 -> j699094487;
		j4059141573 -> j848990519;
	j1177286634 [label="Es würde mich nicht überraschen, wenn du es so gemeint hättest ! Es scheint, als hätten wir hier alle möglichen Arten von ménagerie.",shape=box,color=blue];
		j1177286634 -> j3079994693;
	j829093632 [label="Oui, es ist wirklich bezaubernd, nicht wahr ? Ich sage oft etwas zu Monsieur Loid und er sieht mich an, als hätte ich ihn völlig unvorbereitet erwischt.",shape=box,color=blue];
		j829093632 -> j3296043234;
	j1736422886 [label="Ich war barsch und entschuldige mich dafür. Ich möchte ihn nicht voreilig für seine Taten verurteilen – ich versuche, ihn von allen Seiten zu verstehen.",shape=box,color=red];
		j1736422886 -> j1538238204;
	j3351813143 [label="Nein, will ich nicht. Er hat ein Leben geführt, das schwer zu verstehen ist. Aber ich wollte wissen, ob du mir erzählen kannst, wie ihr euch kennengelernt habt.",shape=box,color=red];
		j3351813143 -> j2164516507;
	j626168116 [label="Ich versuche einfach, eine Erklärung dafür zu finden, warum er so ist, wie er ist. Ich versuche, ihn zu verstehen.",shape=box,color=red];
		j626168116 -> j1575288639;
	j581469012 [label="Wenn ich mehr über ihn weiß, kann ich vielleicht herausfinden, wie ich ihn auf einen eher ... guten Weg führen kann.",shape=box,color=red];
		j581469012 -> j1158174393;
	j2496921276 [label="Ich weiß. Aber ich kann ihn nicht dafür hassen, dass er tat, was er tun musste, um den seinen zu dienen. Ich musste dasselbe tun.",shape=box,color=red];
		j2496921276 -> j2111721665;
	j3869565476 [label="Er ist einer der gefährlichsten Orokin, die das Imperium je kannte. Wir wären Narren, wenn wir diese Art von Hilfe ablehnen würden.",shape=box,color=red];
		j3869565476 -> j39487859;
	j699094487 [label="Ich weiß, aber du kennst ihn. Ich versuche, ihn besser zu verstehen.",shape=box,color=red];
		j699094487 -> j1858258129;
	j848990519 [label="Deswegen frage ich dich über ihn. Ich möchte ihn besser verstehen, und ich vertraue seiner Seite der Geschichte nicht besonders.",shape=box,color=red];
		j848990519 -> j261573582;
	j3079994693 [label="Was bedeutet diese Redewendung ? Wenn es einen Elefanten im Raum gibt, warum sollten wir nicht darüber sprechen?",shape=box,color=blue];
		j3079994693 -> j2296847112;
	j3296043234 [label="Und das ist ein Mann, der der Diener der Königin selbst hätte sein können, daher bin ich stolz darauf.",shape=box,color=blue];
		j3296043234 -> j3079994693;
	j1538238204 [label="Add 1 to Thermostat counter",color=orange];
		j1538238204 -> j1392315670;
	j2164516507 [label="Add 1 to Thermostat counter",color=orange];
		j2164516507 -> j3005510860;
	j1575288639 [label="Add -1 to Thermostat counter",color=orange];
		j1575288639 -> j4052277695;
	j1158174393 [label="Add 1 to Thermostat counter",color=orange];
		j1158174393 -> j3404939843;
	j2111721665 [label="Add 1 to Thermostat counter",color=orange];
		j2111721665 -> j3397746973;
	j39487859 [label="Add -1 to Thermostat counter",color=orange];
		j39487859 -> j3043012600;
	j1858258129 [label="Add -1 to Thermostat counter",color=orange];
		j1858258129 -> j3327801741;
	j261573582 [label="Add 1 to Thermostat counter",color=orange];
		j261573582 -> j2954298357;
	j2296847112 [label="Ich kann mir nicht vorstellen, dass ein Elefant kein Gesprächsstoff wäre für die meisten Menschen, die sich nicht mit fliegenden Köpfen und sprechenden Tieren umgeben.",shape=box,color=blue];
		j2296847112 -> j4178381139;
	j1392315670 [label="+5 Chemistry",color=orange];
		j1392315670 -> j3058262982;
	j3005510860 [label="Und du glaubst, ich würde das nicht verstehen? Ich bin kein Narr – ich wurde nicht hysterisch, so versetzt wie ich wurde, so verändert ich auch bin.",shape=box,color=blue];
		j3005510860 -> j730056269;
		j3005510860 -> j818046354;
	j4052277695 [label="Zu verstehen, bis zu welchem Grad, ist meine Sorge. Aber du brauchst keine Vorträge von mir. Ich bin nicht deine Mutter und möchte diese Freundschaft auch nicht gleich am Anfang zunichte machen ...",shape=box,color=blue];
		j4052277695 -> j1152062143;
	j3404939843 [label="+5 Chemistry",color=orange];
		j3404939843 -> j932004728;
	j3397746973 [label="+5 Chemistry",color=orange];
		j3397746973 -> j991672156;
	j3043012600 [label="Ich rate nur zur Vorsicht. Er könnte sogar Lua dazu verzaubern, ihm die Sterne vom Himmel zu schenken, denke ich.",shape=box,color=blue];
		j3043012600 -> j790625423;
	j3327801741 [label="Zu verstehen, bis zu welchem Grad, ist meine Sorge. Aber du brauchst keine Vorträge von mir.",shape=box,color=blue];
		j3327801741 -> j2979024476;
	j2954298357 [label="+5 Chemistry",color=orange];
		j2954298357 -> j1556603244;
	j4178381139 [label="... Ich vermute, ich habe meine eigene Frage beantwortet, oder nicht ?",shape=box,color=blue];
		j4178381139 -> j1840075002;
	j3058262982 [label="Ich weiß die Entschuldigung zu schätzen und nehme sie an, bedenke jedoch, dass ich sowohl versetzt als auch verändert wurde und mich nun vom Unmöglichen umgeben sehe.",shape=box,color=blue];
		j3058262982 -> j1789000284;
	j730056269 [label="Vergiss es. Ich werde einfach selbst mit dem Teufel reden.",shape=box,color=red];
		j730056269 -> j4014689105;
	j818046354 [label="Es tut mir leid. Ich möchte nicht mit dir streiten, so meinte ich es nicht. ",shape=box,color=red];
		j818046354 -> j1455392555;
		j818046354 -> j3627001506;
	j1152062143 [label="Ich mache mir einfach Sorgen um dich. Er ist eine geschickte und manipulative Bestie ...",shape=box,color=blue];
		j1152062143 -> j2720525954;
	j932004728 [label="Und ich würde dich zum Heiligen von Sol erklären, weil du überhaupt einen Versuch in dieser Richtung machst.",shape=box,color=blue];
		j932004728 -> j2720525954;
	j991672156 [label="Oui, der Fluch des Soldaten ... Brenne die Stadt nieder, um das Land zu retten. Töte den Mann, um die Familie zu retten. Doch wo endet der Horror ?",shape=box,color=blue];
		j991672156 -> j470915505;
	j790625423 [label="Denk daran, wer und was er letzten Endes ist ... kein Gott und nicht einmal eine Bestie, sondern ein Mensch. Ein Mensch, der zu viel von sich hält.",shape=box,color=blue];
		j790625423 -> j2720525954;
	j2979024476 [label="Er könnte sogar Lua dazu verzaubern, ihm die Sterne vom Himmel zu schenken, denke ich. Sei vorsichtig, ist alles, was ich damit sagen will.",shape=box,color=blue];
		j2979024476 -> j2720525954;
	j1556603244 [label="Es ist klug von dir, nicht auf seine süßen Worte zu hören. Er könnte sogar Lua dazu verzaubern, ihm die Sterne vom Himmel zu schenken, denke ich.",shape=box,color=blue];
		j1556603244 -> j2720525954;
	j1840075002 [label="Das hast du. Es bedeutet: \"Können wir über das Thema sprechen, das wir alle vermeiden, als ob wir nicht über den riesigen Elefanten im Raum sprechen würden.\"",shape=box,color=red];
		j1840075002 -> j1474592875;
	j1789000284 [label="Wenn du glaubst, ich kann die Vergangenheit anderer nicht verstehen oder kein Verständnis dafür aufbringen, denk bitte noch einmal darüber nach, oui ?",shape=box,color=blue];
		j1789000284 -> j4251891825;
	j4014689105 [label="Qu'il en soit ainsi.",shape=box,color=blue];
		j4014689105 -> "Chat ends.";
	j1455392555 [label="Er ist Soldat. Er musste im Namen eines \"höheren Zwecks\" schreckliche Dinge tun. Ich weiß, wie sich das anfühlt. Manchmal macht einen so ein Leben ... nun ja. So wie ihn.",shape=box,color=red];
		j1455392555 -> j1816175149;
	j3627001506 [label="Er lebte Hunderte, wenn nicht Tausende von Jahren. Wer weiß, was das wirklich mit einem macht? Wie viel Schmerz, wie viel Leid? Ich weiß, wie sich das anfühlt.",shape=box,color=red];
		j3627001506 -> j4000785932;
	j2720525954 [label="Aber du wolltest mich doch über den Teufel befragen, nicht wahr? Was willst du wissen?",shape=box,color=blue];
		j2720525954 -> j1551557293;
		j2720525954 -> j523645013;
		j2720525954 -> j2419727202;
	j470915505 [label="Wir müssen Krieg mit den Augen eines Statistikers sehen, denn wenn wir ihn mit den Augen der Gefallenen betrachten würden, würden wir auf ewig weinen.",shape=box,color=blue];
		j470915505 -> j2720525954;
	j1474592875 [label="Und ich rate ein zweites Mal, was die Natur dieses éléphant betrifft ... hat dieser eine blaue Hautfarbe ?",shape=box,color=blue];
		j1474592875 -> j3218359144;
	j4251891825 [label="Und ich für meinen Teil werde es mir auch zweimal überlegen, bevor ich mich in deine Angelegenheiten mische.",shape=box,color=blue];
		j4251891825 -> j730056269;
		j4251891825 -> j1484014530;
	j1816175149 [label="+5 Chemistry",color=orange];
		j1816175149 -> j531580684;
	j4000785932 [label="+5 Chemistry",color=orange];
		j4000785932 -> j2503512164;
	j1551557293 [label="Warum hast du solch eine Abneigung gegen ihn?",shape=box,color=red];
		j1551557293 -> j3914458363;
	j523645013 [label="Warum hat Entrati ihn euch, dir und Lyon überlassen?",shape=box,color=red];
		j523645013 -> j2789189029;
	j2419727202 [label="Ich bin neugierig. Wie habt ihr euch kennengelernt?",shape=box,color=red];
		j2419727202 -> j2035041273;
	j1484014530 [label="Einverstanden.",shape=box,color=red];
		j1484014530 -> j2834343216;
	j531580684 [label="Ah, und jetzt komme ich mir wirklich wie ein Idiot vor. Ja, natürlich weißt du, wie es ist, im Namen eines \"Zwecks\" zu töten, wie du sagtest ... Natürlich willst du jemanden verstehen, der dasselbe getan hat.",shape=box,color=blue];
		j531580684 -> j220486526;
	j2503512164 [label="Ah, und jetzt komme ich mir wirklich wie ein Idiot vor. Ja, natürlich weißt du, wie es ist, immer wieder neu zu leben ... Natürlich willst du jemanden verstehen, der dasselbe getan hat.",shape=box,color=blue];
		j2503512164 -> j220486526;
	j3914458363 [label="Ist das nicht offensichtlich ? Er benimmt sich wie eine große Raubkatze, die darauf besteht, ihr Revier zu markieren und Dinge von Regalen zu werfen.",shape=box,color=blue];
		j3914458363 -> j146261669;
		j3914458363 -> j3543492763;
	j2789189029 [label="Als Cardinal Dimanche – Entrati – uns letztlich verließ, ließ er den Teufel vor unserer Tür zurück. Gebrochen, blutend und kaum in der Lage, sich an seinen eigenen Namen zu erinnern.",shape=box,color=blue];
		j2789189029 -> j3996593376;
	j2035041273 [label="Es stürmte in der Nacht, in der der Teufel zu uns kam. Ein schreckliches Donnern erzitterte die Mauern der Cathédrale.",shape=box,color=blue];
		j2035041273 -> j4132570505;
	j2834343216 [label="Boolean MarieRoatheWarning is now false.",color=orange];
		j2834343216 -> j570507641;
	j220486526 [label="Lass uns zu einer Einigung kommen. Wenn du glaubst, ich kann die Vergangenheit anderer nicht verstehen oder kein Verständnis dafür aufbringen, denk bitte noch einmal darüber nach, oui ?",shape=box,color=blue];
		j220486526 -> j4251891825;
	j146261669 [label="Ich persönlich mag Katzen.",shape=box,color=red];
		j146261669 -> j2629833800;
	j3543492763 [label="Magst du keine Katzen?",shape=box,color=red];
		j3543492763 -> j1752456416;
	j3996593376 [label="Ich weiß jetzt, dass ihm das sérum damals gerade erst verabreicht wurde und dass die Verwandlung, wenn man sie nicht will, ... schmerzhaft ist.",shape=box,color=blue];
		j3996593376 -> j3282504434;
	j4132570505 [label="Check boolean MarieLyonVisions",color=orange];
		j4132570505 -> j2261032924 [label=true,color=green];
		j4132570505 -> j1595933666 [label=false,color=brown];
	j570507641 [label="Magnifique ! Aber du wolltest mich doch über den Teufel befragen, nicht wahr? Was willst du wissen?",shape=box,color=blue];
		j570507641 -> j1551557293;
		j570507641 -> j523645013;
		j570507641 -> j2419727202;
	j2629833800 [label="Katzen sind etwas Wundervolles, wenn eine Katze eine Katze ist! Er ist ein Mann, ein erwachsener Mann, mit vielen Lebensjahren hinter sich!",shape=box,color=blue];
		j2629833800 -> j3634308966;
	j1752456416 [label="Doch, schon, wenn eine Katze eine Katze ist! Er ist ein Mann, ein erwachsener Mann, mit vielen Lebensjahren hinter sich!",shape=box,color=blue];
		j1752456416 -> j3634308966;
	j3282504434 [label="Le Cardinal blickte auf den Teufel herab und sprach: \"Uriel, Ketzer von Xata, in der Verbannung, antworte – Kann den Orokin jemals vergeben werden ?\"",shape=box,color=blue];
		j3282504434 -> j3059562330;
	j2261032924 [label="Wenn Lyon dir von dem Sturm erzählt, der unser Zuhause erschütterte, spricht er tatsächlich über die Realität, die wir geteilt haben.",shape=box,color=blue];
		j2261032924 -> j1595933666;
	j1595933666 [label="Es war ein wunderbares cliché, denke ich, dass so viel Böses in einem solchen Mahlstrom ankam.",shape=box,color=blue];
		j1595933666 -> j2789189029;
	j3634308966 [label="Viel mehr Jahren, als ein Mensch je haben sollte, egal ob er blau ist oder auf andere Weise bis zur Unkenntlichkeit, wie er es gerne hätte, verändert ist.",shape=box,color=blue];
		j3634308966 -> j2496998255;
		j3634308966 -> j1084320212;
		j3634308966 -> j499860604;
	j3059562330 [label="Und mit einem Donnerschlag, als würden die Götter ihn selbst herbeirufen, war le Cardinal einfach verschwunden.",shape=box,color=blue];
		j3059562330 -> j1375165545;
	j2496998255 [label="Die genetische Veränderung der eigenen Gestalt war in der Zeit der Orokin in Mode. Aber sie waren genauso menschlich, wie wir es sind. Oder zumindest mal waren, denke ich.",shape=box,color=red];
		j2496998255 -> j1221193387;
	j1084320212 [label="Abgesehen vom Schwanz sieht er ehrlich gesagt ... menschlicher aus als viele Orokin damals.",shape=box,color=red];
		j1084320212 -> j2607440354;
	j499860604 [label="Keine Sorge, ich finde dich viel hübscher als ihn.",shape=box,color=red];
		j499860604 -> j2617491924;
	j1375165545 [label="Und wir blieben mit ... ihm zurück. Dem Teufel.",shape=box,color=blue];
		j1375165545 -> j3447242503;
	j1221193387 [label="Ja, ich glaube, ich weiß nicht mehr, was ich bin. Teils Marie, teils ... \"Wisp\", teils ... was auch immer für befallene Dinge jetzt durch meine Adern fließen.",shape=box,color=blue];
		j1221193387 -> j101660355;
	j2607440354 [label="Ja, ich habe mir ein altes Porträt angesehen, von le Cardinal, auf dem er noch eher wie der Teufel aussah. Er erzählte mir von den Sitten der Orokin und wie sie sich selbst veränderten.",shape=box,color=blue];
		j2607440354 -> j2955015370;
	j2617491924 [label="Check boolean DrifterMarie",color=orange];
		j2617491924 -> j1629354877 [label=true,color=green];
		j2617491924 -> j3496294667 [label=false,color=brown];
	j3447242503 [label="Vielleicht, überließ le Cardinal es uns ... uns um seine Seele zu kümmern? Oder zumindest um die Ketten, die ihn fesseln. Je préférerais le renvoyer en enfer.",shape=box,color=blue];
		j3447242503 -> j3361921116;
		j3447242503 -> j1422077864;
	j101660355 [label="Vielleicht ist das ein Gespräch für ein anderes Mal.",shape=box,color=blue];
		j101660355 -> j207973045;
	j2955015370 [label="Wie ähnlich und doch so fremd, wie die Damen meiner Zeit, die protzige Perücken trugen, die bis zum Himmel reichten, oder Kleider, in denen ohne großen Aufwand ein ganzes Waisenhaus Platz hätte finden können!",shape=box,color=blue];
		j2955015370 -> j4182035339;
	j1629354877 [label="Hör auf, mich in Verlegenheit zu bringen ! Monsieur Loid fragt sich noch, warum ich hier rumsitze !",shape=box,color=blue];
		j1629354877 -> j1869932457;
	j3496294667 [label="Boolean DrifterMarie is now true.",color=orange];
		j3496294667 -> j3271500015;
	j3361921116 [label="Glaubst du, dass am Ende jedem vergeben werden kann?",shape=box,color=red];
		j3361921116 -> j3932447;
	j1422077864 [label="Gibt es irgendetwas an ihm, das du magst? Irgendetwas?",shape=box,color=red];
		j1422077864 -> j1097243316;
	j207973045 [label="Boolean MarieInfestation is now true.",color=orange];
		j207973045 -> j373629297;
	j4182035339 [label="Menschen sind, was sie immer sein werden – unglücklich in ihrer eigenen, von Sol gegebenen Gestalt. Begierig darauf, ihr eigenes Fleisch wie Ton zu bearbeiten. Ich bin da wohl keine Ausnahme.",shape=box,color=blue];
		j4182035339 -> j56283982;
	j1869932457 [label="Außerdem ist es nicht schwierig, hübscher als der Teufel zu sein, non ? Seine Züge sind zwar attraktiv, aber das Blau ... ce n'est pas pour moi.",shape=box,color=blue];
		j1869932457 -> j2446625608;
	j3271500015 [label="Ah ! Du bringst mich ganz in Verlegenheit ! Was wird Monsieur Loid nur denken, wenn er mich hier so sitzen sieht ?",shape=box,color=blue];
		j3271500015 -> j1869932457;
	j3932447 [label="Glaube ich ? Ja. Ich glaube, dass alle Seelen Vergebung für ihre Verfehlungen erlangen können.",shape=box,color=blue];
		j3932447 -> j3312372311;
	j1097243316 [label="Nichts. Absolut nichts.",shape=box,color=blue];
		j1097243316 -> j464888042;
		j1097243316 -> j852852794;
	j373629297 [label="Mein Problem mit ihm ist, dass er das mörderische Ego einer Katze hat, ohne den Charme eines kleinen, liebenswerten Haustieres.",shape=box,color=blue];
		j373629297 -> j1870301108;
	j56283982 [label="Voller Eifer das sérum zu nehmen, das mich teils zu Marie, teils zu \"Wisp\" und teils zu ... was auch immer für befallenen Dinge jetzt durch meine Adern fließen, machte.",shape=box,color=blue];
		j56283982 -> j101660355;
	j2446625608 [label="Ich nehme dein Kompliment an, wenn es ernst gemeint war. Ich war nur überrascht. Können wir ... zum eigentlichen Thema zurückkehren ?",shape=box,color=blue];
		j2446625608 -> j207973045;
	j3312372311 [label="Die Frage bleibt ... Hat er überhaupt das Gefühl, dass er so etwas braucht ?",shape=box,color=blue];
		j3312372311 -> j4014481777;
	j464888042 [label="Nun, ich danke dir für die Einsicht. Entrati möchte also, dass ihm ... vergeben wird? Wofür? Tau? Oder einfach nur, weil er Orokin ist?",shape=box,color=red];
		j464888042 -> j3058248202;
	j852852794 [label="Alles klar, ich glaube dir. Ich glaube nicht, dass du mich anlügen würdest.",shape=box,color=red];
		j852852794 -> j1727205224;
	j1870301108 [label="Er hat eine zu hohe Meinung von sich. Er nimmt Leben ohne Zögern hin. Er spielt mit seinen Feinden, als wären sie nichts weiter als eine Maus, die er in die Enge getrieben hat.",shape=box,color=blue];
		j1870301108 -> j3447242503;
	j4014481777 [label="Vergebung kann denen nicht gegeben werden, die nicht glauben, dass sie welche benötigen. Es ist einfacher, einem Fisch das Fliegen beizubringen.",shape=box,color=blue];
		j4014481777 -> j2342698710;
	j3058248202 [label="Ich weiß es nicht. Und die andere Frage bleibt: Hat er überhaupt das Gefühl, dass er so etwas wie Vergebung braucht ?",shape=box,color=blue];
		j3058248202 -> j4014481777;
	j1727205224 [label="Fie ! Gut. Eines haben wir gemeinsam ... die teuflische Versuchung von Süßigkeiten. Der Teufel kehrte oft in die Cathédrale zurück, nachdem er Gebäck aus den Läden mitgenommen hatte, ohne es zu bezahlen.",shape=box,color=blue];
		j1727205224 -> j3182227806;
	j2342698710 [label="Aber sprich selbst mit ihm darüber, wenn du die unüberwindbare Herausforderung verstehen willst, vor der du stehst, wenn du diesen speziellen Kampf gewinnen willst.",shape=box,color=blue];
		j2342698710 -> j3523700268;
	j3182227806 [label="Ich erklärte ihm, dass das Diebstahl ist, und er hielt einen langatmigen Vortrag darüber, dass die Orokin bald das Sonnensystem beherrschen würden und es sich daher im Prinzip kein Diebstahl ist ...",shape=box,color=blue];
		j3182227806 -> j3916536983;
	j3523700268 [label="Ich wünsche dir lediglich Glück.",shape=box,color=blue];
		j3523700268 -> j1933300832;
	j3916536983 [label="Ich schrie ihn an und Lyon war gezwungen einzugreifen ...",shape=box,color=blue];
		j3916536983 -> j478660569;
		j3916536983 -> j2691752777;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j478660569 [label="Und das Gebäck ...?",shape=box,color=red];
		j478660569 -> j1087038371;
	j2691752777 [label="Hast du dich jemals gefragt, ob er sie brachte, damit ihr diese gemeinsam genießen könnt?",shape=box,color=red];
		j2691752777 -> j4093738746;
	j1087038371 [label="Wir konnten sie doch nicht einfach verderben lassen, oder? Es war eine Sünde, sie zu essen, aber eine noch schlimmere Sünde wäre es gewesen, sie verrotten zu lassen. Also genossen wir sie.",shape=box,color=blue];
		j1087038371 -> j1254450972;
	j4093738746 [label="Wenn das der wahre Grund war, dann war er nicht sehr überzeugend. Aber ... vielleicht hast du recht. Trotzdem konnten wir sie nicht verderben lassen. Es war eine Sünde, sie zu essen, aber eine noch schlimmere, sie verrotten zu lassen. Also haben wir sie genossen.",shape=box,color=blue];
		j4093738746 -> j1254450972;
	j1254450972 [label="+10 Chemistry",color=orange];
		j1254450972 -> j4274490578;
	j4274490578 [label="Hm. Wenn ich jetzt so darüber nachdenke, war es vielleicht eine Art Angewohnheit von ihm, mehr mitzubringen, als er alleine hätte essen können ...",shape=box,color=blue];
		j4274490578 -> j3295003295;
	j3295003295 [label="Boolean MarieRoathePastry1 is now true.",color=orange];
		j3295003295 -> j1592377077;
	j1592377077 [label="Ich werde darüber nachdenken. Bis morgen. À la revoyure.",shape=box,color=blue];
		j1592377077 -> "Chat ends.";
