	"MarieRank4Convo5 begins." [color=orange];
		"MarieRank4Convo5 begins." -> j1316635360;
	j1316635360 [label="Evaluate expressions",color=orange];
		j1316635360 -> j1271842245 [label="LoidFamilyComplete",color=purple];
		j1316635360 -> j4063456456 [label="MarieFamilyOther",color=purple];
		j1316635360 -> j2801042807 [label="MarieFamily2",color=purple];
		j1316635360 -> j2801042807 [label="MarieFamily1",color=purple];
		j1316635360 -> j10698901 [label="false",color=purple];
	j1271842245 [label="Drifter ! Ich hab nachgedacht.",shape=box,color=blue];
		j1271842245 -> j720947873;
		j1271842245 -> j129698615;
	j4063456456 [label="Drifter ! Ich habe Pläne geschmiedet, habe über die Familie über uns nachgedacht. Und wie sie uns als Eindringlinge betrachten könnten.",shape=box,color=blue];
		j4063456456 -> j3673773134;
	j2801042807 [label="Drifter ! Ich habe darüber nachgedacht, was du über die Familie über uns gesagt hast. Es tut mir leid für sie ...",shape=box,color=blue];
		j2801042807 -> j1000557311;
	j10698901 [label="Warum können wir nicht nach oben gehen ? Warum können wir nicht mit denen sprechen, die le Cardinal famille genannt hat ?",shape=box,color=blue];
		j10698901 -> j2698991527;
		j10698901 -> j129698615;
	j720947873 [label="Sollte ich mich fürchten?",shape=box,color=red];
		j720947873 -> j2454935243;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j3673773134 [label="Als die \"andere Familie\" in compétition, oui ? Es beunruhigt mich sehr.",shape=box,color=blue];
		j3673773134 -> j1000557311;
	j1000557311 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j1000557311 -> j1965379007 [label=true,color=green];
		j1000557311 -> j3642914 [label=false,color=brown];
	j2698991527 [label="Nun ... kurz gefasst, ein Teil von Entratis Familie ist oben und sie sind sich nicht ... wirklich bewusst, dass wir hier unten sind.",shape=box,color=red];
		j2698991527 -> j3196937514;
	j2454935243 [label="Oui ! Die kleinen fliegenden Roboter. Die Necra... Necra ... Wie nennst du sie ?",shape=box,color=blue];
		j2454935243 -> j2464557770;
	"Chat ends." [color=orange];
	j1965379007 [label="Wir wetteifern nicht um die Gunst von le Cardinal, wie können wir ihnen das begreiflich machen ?",shape=box,color=blue];
		j1965379007 -> j3325389605;
		j1965379007 -> j3602611676;
		j1965379007 -> j2487638761;
	j3642914 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j3642914 -> j1965379007 [label=true,color=green];
		j3642914 -> j2539415767 [label=false,color=brown];
	j3196937514 [label="Boolean MarieFamily1 is now true.",color=orange];
		j3196937514 -> j4242532232;
	j2464557770 [label="Necramiten?",shape=box,color=red];
		j2464557770 -> j4013844812;
	j3325389605 [label="Du hast recht. Man nicht um etwas wetteifern, was eine Person nicht bereit ist zu geben.",shape=box,color=red];
		j3325389605 -> j380005824;
	j3602611676 [label="Das Öffnen verkrusteter Wunden ist gefährlich. Vielleicht beseitigt man eine Infektion ... oder verblutet dabei.",shape=box,color=red];
		j3602611676 -> j2952898253;
	j2487638761 [label="Ihr - wir - haben alles etwas gemeinsam. Irgendwann wurden wir von Entrati zurückgelassen.",shape=box,color=red];
		j2487638761 -> j2515192195;
	j2539415767 [label="Wie geht deine Arbeit voran, ihre inneren Konflikte zu lösen ?",shape=box,color=blue];
		j2539415767 -> j829488717;
		j2539415767 -> j2828230146;
		j2539415767 -> j3339030976;
		j2539415767 -> j129698615;
	j4242532232 [label="Par les Luminaires ... Du meinst, wir sind alle hier unten im Geheimen ?! Dürfen wir diesen Ort deshalb nicht verlassen ?! Mais pourquoi ?!",shape=box,color=blue];
		j4242532232 -> j3256415632;
	j4013844812 [label="Oui ! Ha ! Sind sind so hartnäckig darin, die Möbel zu ersetzen, non ? Aber wenn man Dinge umstellt... machen sie genau dasselbe.",shape=box,color=blue];
		j4013844812 -> j3253693070;
	j380005824 [label="Evaluate expressions",color=orange];
		j380005824 -> j129490453 [label="MarieEntrati3a",color=purple];
		j380005824 -> j129490453 [label="MarieEntrati3b",color=purple];
		j380005824 -> j129490453 [label="MarieEntrati3",color=purple];
		j380005824 -> j3061936741 [label="MarieEntratiFamily",color=purple];
		j380005824 -> j2344958258 [label="MarieEntratiMonster1",color=purple];
		j380005824 -> j2344958258 [label="MarieEntratiMonster2",color=purple];
		j380005824 -> j2695498790 [label="MarieEntratiFan1",color=purple];
		j380005824 -> j2695498790 [label="MarieEntratiFan2",color=purple];
		j380005824 -> j625743647 [label="MarieEntratiNeutral",color=purple];
		j380005824 -> j3061936741 [label="false",color=purple];
	j2952898253 [label="Evaluate expressions",color=orange];
		j2952898253 -> j2186907562 [label="MarieEntrati3a",color=purple];
		j2952898253 -> j2186907562 [label="MarieEntrati3b",color=purple];
		j2952898253 -> j1552768121 [label="MarieEntrati3",color=purple];
		j2952898253 -> j2845126370 [label="MarieEntratiFamily",color=purple];
		j2952898253 -> j1174372857 [label="MarieEntratiMonster1",color=purple];
		j2952898253 -> j1174372857 [label="MarieEntratiMonster2",color=purple];
		j2952898253 -> j2569746602 [label="MarieEntratiFan1",color=purple];
		j2952898253 -> j2569746602 [label="MarieEntratiFan2",color=purple];
		j2952898253 -> j1384291203 [label="MarieEntratiNeutral",color=purple];
		j2952898253 -> j1612692861 [label="false",color=purple];
	j2515192195 [label="Evaluate expressions",color=orange];
		j2515192195 -> j2879964913 [label="MarieEntrati3a",color=purple];
		j2515192195 -> j2879964913 [label="MarieEntrati3b",color=purple];
		j2515192195 -> j2522249406 [label="MarieEntrati3",color=purple];
		j2515192195 -> j3911262049 [label="MarieEntratiFamily",color=purple];
		j2515192195 -> j3161008455 [label="MarieEntratiMonster1",color=purple];
		j2515192195 -> j3161008455 [label="MarieEntratiMonster2",color=purple];
		j2515192195 -> j2569746602 [label="MarieEntratiFan1",color=purple];
		j2515192195 -> j2569746602 [label="MarieEntratiFan2",color=purple];
		j2515192195 -> j1384291203 [label="MarieEntratiNeutral",color=purple];
		j2515192195 -> j23563573 [label="false",color=purple];
	j829488717 [label="Ganz ehrlich? Ich wurde abgelenkt.",shape=box,color=red];
		j829488717 -> j1432713527;
	j2828230146 [label="Es könnte besser laufen.",shape=box,color=red];
		j2828230146 -> j3986026521;
	j3339030976 [label="Ich mache Fortschritte.",shape=box,color=red];
		j3339030976 -> j920878830;
	j3256415632 [label="Seine Tochter Euleria – genannt Mutter – und ihre Familie haben sich die ganze Zeit um Deimos gekümmert.",shape=box,color=red];
		j3256415632 -> j546952181;
	j3253693070 [label="Was hält uns davon ab, einfach alle Möbel wegzuräumen, dann können sie sie ersetzen und dann ... machen wir das erneut ? Wir könnten sie alle verkaufen und mit mobilier étrange Profit machen !",shape=box,color=blue];
		j3253693070 -> j433959669;
		j3253693070 -> j1364654175;
		j3253693070 -> j1155830468;
	j129490453 [label="Ich bin mir unserer ungelösten Differenzen über le Cardinal bewusst. Ich versuche die Unterhaltung civilisée zu halten.",shape=box,color=blue];
		j129490453 -> j2723650175;
	j3061936741 [label="Ich verstehe, dass du nicht über das Überbrücken von Differenzen sprechen möchtest, ohne diejenigen bloßzustellen, die deiner Meinung nach an ihnen Schuld sind.",shape=box,color=blue];
		j3061936741 -> j2723650175;
	j2344958258 [label="Oui ! Wie du mich so oft erinnerst, hältst du ihn für eine Art monstre ! Mit nichts als Bosheit und Leere im Herzen !",shape=box,color=blue];
		j2344958258 -> j2723650175;
	j2695498790 [label="Ich dachte, dass du im Kampf um le Cardinals Seele auf meiner Seite bist ?",shape=box,color=blue];
		j2695498790 -> j1555232377;
	j625743647 [label="Ich dachte, du hättest dich im Bezug auf le Cardinal noch nicht entschieden ? Oder hat sich das geändert ?",shape=box,color=blue];
		j625743647 -> j2035630618;
		j625743647 -> j2782454605;
	j2186907562 [label="Oui. Das lerne ich gerade von M'sieur Tagfer...",shape=box,color=blue];
		j2186907562 -> j3118300043;
	j1552768121 [label="Sprich nicht von verkrusteten Wunden, Wolf. Ich lecke immer noch die, die ich von unserer letzten Diskussion über le Cardinal davongetragen habe.",shape=box,color=blue];
		j1552768121 -> j2723650175;
	j2845126370 [label="Oui, aber das hast du schon gesagt - wir müssen aufhören uns gegenseitig die Schuld an unseren Wunden zu geben.",shape=box,color=blue];
		j2845126370 -> j59847156;
	j1174372857 [label="Ich weiß, dass du glaubst, das le Cardinal eine Art furchtbares monstre ist, dass er solche Wunden schlägt.",shape=box,color=blue];
		j1174372857 -> j2723650175;
	j2569746602 [label="Ich weiß, dass du im Kampf um le Cardinals Seele auf meiner Seite bist und dafür werde ich ewig dankbar sein.",shape=box,color=blue];
		j2569746602 -> j1612692861;
	j1384291203 [label="Ich weiß, dass du dein Urteil über ihn zurückhältst und dafür bin ich dir unendlich dankbar. ",shape=box,color=blue];
		j1384291203 -> j1612692861;
	j1612692861 [label="Ich weiß, dass die anderen schnell bereit sind, le Cardinal die Schuld zu geben, aber ich möchte nicht, dass wir gespalten sind und bluten, wenn wir doch vereint sein könnten.",shape=box,color=blue];
		j1612692861 -> j2867007187;
	j2879964913 [label="Oui, auch wenn ich gerade von M'sieur Tagfer lerne, dass es vielleicht nicht für alles dasselbe ist.",shape=box,color=blue];
		j2879964913 -> j3118300043;
	j2522249406 [label="Und ich lerne gerade, dass es nicht für alle das gleiche Ausmaß hat, wie du mit so \"freundlich\" gesagt hast, non ?",shape=box,color=blue];
		j2522249406 -> j2723650175;
	j3911262049 [label="Oui, ja ! Auch wenn ich le Cardinal nicht vorwerfe, dass er gegangen ist, denn seine Arbeit ist unantastbar - ",shape=box,color=blue];
		j3911262049 -> j1612692861;
	j3161008455 [label="Und ich weiß, dass du glaubst, das le Cardinal eine Art furchtbares monstre ist, dass er solche Wunden schlägt.",shape=box,color=blue];
		j3161008455 -> j2723650175;
	j23563573 [label="Und während andere schnell bereit sind, ihr für ihre Schmerzen die Schuld zu geben, möcht ich einfach nicht, dass wir getrennt werden und leiden.",shape=box,color=blue];
		j23563573 -> j2867007187;
	j1432713527 [label="Und was bitte könnte dich ablenken ? Was könnte wichtiger sein, als sich hinzusetzen und die Beschwerden der mécontents durchzugehen ?",shape=box,color=blue];
		j1432713527 -> j4276855371;
	j3986026521 [label="Was kann so schwierig daran sein, sich hinzusetzen und die Beschwerden der mécontents durchzugehen ?",shape=box,color=blue];
		j3986026521 -> j971473906;
	j920878830 [label="Oh, fantastisch !",shape=box,color=blue];
		j920878830 -> j2551540820;
	j546952181 [label="Über diesen Ort und das Herz gewacht, das Void-Energie in das Ursprungssystem pumpt und uns alle ... wirklich verwendbar hält, seit Entrati gegangen ist.",shape=box,color=red];
		j546952181 -> j3916832970;
	j433959669 [label="Ich weiß nicht, ob es eine Nachfrage für Entratis Stühle gibt ...",shape=box,color=red];
		j433959669 -> j392654570;
	j1364654175 [label="Würden wir den Markt nicht überschwemmen? Wir müssten sie ziemlich billig verkaufen ...",shape=box,color=red];
		j1364654175 -> j392654570;
	j1155830468 [label="Großartig. Darin sehe ich kaum ein Problem.",shape=box,color=red];
		j1155830468 -> j3554026502;
	j2723650175 [label="Auch wenn ich verstehe, dass diese beiden Themen untrennbar verbunden sind möchte ich dich bitten, heute produktiv zu bleiben, oui ?",shape=box,color=blue];
		j2723650175 -> j1831900767;
	j1555232377 [label="Was ist das für eine Täuschung von dir, Wolf ? Oder ist die kleine Marie nur ein jeu für dich ?",shape=box,color=blue];
		j1555232377 -> j668753810;
		j1555232377 -> j2782454605;
	j2035630618 [label="Ich bin mir noch nicht im Klaren über die notwendig seiner Handlungen. Aber es steht kaum außer Frage, dass er abgebrüht ist.",shape=box,color=red];
		j2035630618 -> j2723650175;
	j2782454605 [label="Es tut mir leid, ich bin es leid, so zu tun.",shape=box,color=red];
		j2782454605 -> j20523365;
	j3118300043 [label="Wir müssen aufhören uns gegenseitig die Schuld an unseren Wunden zu geben.",shape=box,color=blue];
		j3118300043 -> j59847156;
	j59847156 [label="Ich bin auch nicht damit einverstanden, le Cardinal die Schuld zu geben, aber ich möchte nicht, dass wir gespalten sind und bluten, wenn wir vereint sein könnten.",shape=box,color=blue];
		j59847156 -> j4022487367;
		j59847156 -> j229856833;
	j2867007187 [label="Wir müssen aufhören uns gegenseitig die Schuld an unseren Wunden zu geben, egal wer letztendlich Schuld ist.",shape=box,color=blue];
		j2867007187 -> j4022487367;
		j2867007187 -> j229856833;
	j4276855371 [label="Ich mache nur Spaß ! Ich kann mir nicht vorstellen, wie beschäftigt du sein musst, alle die Orte ... und Zeiten ... wo du gebraucht wirst.",shape=box,color=blue];
		j4276855371 -> j2551540820;
	j971473906 [label="Ich mache nur Spaß ! Ich kann mir nicht vorstellen, was sie durchgemacht haben müssen. Und wie schwierig es sein muss, alles zu vestehen.",shape=box,color=blue];
		j971473906 -> j2551540820;
	j2551540820 [label="Ich fürchte nur, wenn ihre Probleme nicht gelöst werden, werden wir unter ihnen nie willkommen sein. Das größere Problem bleibt ungelöst - ",shape=box,color=blue];
		j2551540820 -> j1965379007;
	j3916832970 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3916832970 -> j3496643933 [label=true,color=green];
		j3916832970 -> j3337182392 [label=false,color=brown];
	j392654570 [label="Pff ! Ich glaube, es ist ein Experiment wert. Vielleicht können wir den Teufel hinter einem Meer von Bücherregalen einsperren !",shape=box,color=blue];
		j392654570 -> j347667214;
	j3554026502 [label="Ich werde gehorsam deinen Sarkasmus ignorieren, denn ich glaube es ist ein lohnenswertes Experiment. Vielleicht können wir den Teufel hinter einem Meer von Bücherregalen einsperren !",shape=box,color=blue];
		j3554026502 -> j347667214;
	j1831900767 [label="Ich möchte uns allen in mit dieser ... seltsamen Koexistenz, in der wir uns befinden, helfen und nicht streiten.",shape=box,color=blue];
		j1831900767 -> j3118300043;
	j668753810 [label="Nein, kein Spiel. Aber Entrati kann man nicht trauen und ich weiß nicht, wie ich dich sonst überzeugen kann, als so zu tun, als wäre ich auf deiner Seite.",shape=box,color=red];
		j668753810 -> j3446293510;
	j20523365 [label="Oui ? Dann freut es mich dir sagen zu können, dass das nicht länger nötig ist.",shape=box,color=blue];
		j20523365 -> j1509439757;
	j4022487367 [label="Alle zusammen sind wir eine ... seltsame Familie. Aber immerhin sind wir eine Familie.",shape=box,color=red];
		j4022487367 -> j1625808289;
	j229856833 [label="Zusammen sind wir stärker, als getrennt.",shape=box,color=red];
		j229856833 -> j1839418755;
		j229856833 -> j1611667163;
	j3496643933 [label="Sie hat sich mit seiner Abwesenheit abgefunden und sie haben Frieden miteinander geschlossen, aber es war hart erkämpft.",shape=box,color=red];
		j3496643933 -> j1383749184;
	j3337182392 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j3337182392 -> j3496643933 [label=true,color=green];
		j3337182392 -> j426757818 [label=false,color=brown];
	j347667214 [label="+20 Chemistry",color=orange];
		j347667214 -> j1001542052;
	j3446293510 [label="Oui ? Dann freut es mich dir sagen zu können, dass du gescheitert bist.",shape=box,color=blue];
		j3446293510 -> j1509439757;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j1625808289 [label="Add +1 to Family counter",color=orange];
		j1625808289 -> j1839418755;
		j1625808289 -> j1611667163;
	j1839418755 [label="Und in Zeiten, in denen wir leiden, ist manchmal alles, was wir wirklich haben, einander. Entweder diejenigen, die uns gegeben wurden, oder diejenigen, die wir gefunden haben.",shape=box,color=red];
		j1839418755 -> j2708290068;
	j1611667163 [label="Ich weiß nicht, ob es langfristig helfen oder schaden würde, aber dieses... Fegefeuer, ist auch nicht richtig.",shape=box,color=red];
		j1611667163 -> j2264159243;
	j1383749184 [label="Zu wissen, dass er weiterhin da draußen ist, Amok läuft und dass er kein Wort mit ihr gewechselt oder ihr nicht einmal einen Brief geschickt hat ...?",shape=box,color=red];
		j1383749184 -> j4016668361;
	j426757818 [label="Sie hat sich mit seiner Abwesenheit nicht abgefunden und die beiden liegen sich gegenseitig an die Gurgel.",shape=box,color=red];
		j426757818 -> j1474728113;
	j1001542052 [label="Viel zu tun ! À la revoyure !",shape=box,color=blue];
		j1001542052 -> "Chat ends.";
	j2631316640 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j2631316640 -> j1508231473;
	j2708290068 [label="Add +1 to Family counter",color=orange];
		j2708290068 -> j2264159243;
	j2264159243 [label="Ja, dem stimme ich zu. Aber ich kann die Kluft zwischen uns nicht schließen, ich weiß nicht, wie ! Für die da oben bin ich eine Fremde...",shape=box,color=blue];
		j2264159243 -> j805953331;
		j2264159243 -> j2775576578;
	j4016668361 [label="Ich kann mir nicht vorstellen, wie schmerzhaft das für sie wäre. Für beide.",shape=box,color=red];
		j4016668361 -> j2200803117;
	j1474728113 [label="Zu wissen, dass er weiterhin da draußen ist, Amok läuft und dass er kein Wort mit ihr gewechselt oder ihr nicht einmal einen Brief geschickt hat ...?",shape=box,color=red];
		j1474728113 -> j2536181148;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j805953331 [label="Loid kannte die Entrati Familie. Er sollte es tun. Aber ihn davon zu überzeugen... das ist eine andere Sache.",shape=box,color=red];
		j805953331 -> j3014622476;
	j2775576578 [label="Roathe vielleicht ? Er ist Orokin, er kannte sie alle.",shape=box,color=red];
		j2775576578 -> j3189269900;
	j2200803117 [label="Ich verstehe zwar die Logik hinter der Entscheidung, sie vor dem Schmerz zu schützen, die le Cardinal durch seinen notwendigen Aufbruch verursacht hat ...",shape=box,color=blue];
		j2200803117 -> j2040338776;
	j2536181148 [label="Das würde die geringe Chance auf eine Versöhnung zerstören, die sie möglicherweise haben.",shape=box,color=red];
		j2536181148 -> j3629214644;
	j3014622476 [label="+5 Chemistry",color=orange];
		j3014622476 -> j1442929290;
	j3189269900 [label="Non, nicht der Teufel - jeder, außer dem Teufel. Aber da ist etwas Wahres dran. Die beste Lösung wäre Monsieur Loid, non ?",shape=box,color=blue];
		j3189269900 -> j3825739444;
	j2040338776 [label="Aber ich finde es unnötig grausam, du nicht ? Sie könnten ihn für tot halten. Oder Schlimmeres! Und wir, leben hier comme des rats d'égout ?",shape=box,color=blue];
		j2040338776 -> j3932406861;
		j2040338776 -> j1871966657;
		j2040338776 -> j1441025954;
	j3629214644 [label="Oui ... ich verstehe die Logik. Ich würde daran arbeiten, ihre Familie wieder zusammenzubringen, wenn du kannst, non ? Es scheint die einzige Hoffnung für uns zu sein, hier rauszukommen. ",shape=box,color=blue];
		j3629214644 -> j3388878283;
	j1442929290 [label="Oui, oui ! C'est ça ! Aber wie überzeugen wir ihn ? Er hat seine Position konsequent vertreten, non ?",shape=box,color=blue];
		j1442929290 -> j2097776795;
		j1442929290 -> j1897680329;
	j3825739444 [label="Aber wie überzeugen wir ihn ? Er hat seine Position konsequent vertreten, non ?",shape=box,color=blue];
		j3825739444 -> j1897680329;
		j3825739444 -> j2097776795;
	j3932406861 [label="Ich habe übrigens eine Freundin, die Ratten liebt. Ich finde sie süß.",shape=box,color=red];
		j3932406861 -> j851590237;
	j1871966657 [label="Diese Entscheidung kann ich nicht wirklich treffen.",shape=box,color=red];
		j1871966657 -> j3834424057;
	j1441025954 [label="Was soll ich tun?",shape=box,color=red];
		j1441025954 -> j3377280791;
	j3388878283 [label="Damit wir nicht den Rest unseres Lebens hier gefangen verbringen, comme des rats d'égout.",shape=box,color=blue];
		j3388878283 -> j1580551986;
		j3388878283 -> j190412747;
	j2097776795 [label="Denkst du, du oder Lyon könnten ihn überzeugen?",shape=box,color=red];
		j2097776795 -> j860612612;
	j1897680329 [label="Meine Antwort wird dir nicht gefallen, Marie ...",shape=box,color=red];
		j1897680329 -> j3134079532;
	j851590237 [label="Und ich würde sie gerne eines Tages kennenlernen, aber das ist nicht der Punkt, den ich machen will, Dummkopf.",shape=box,color=blue];
		j851590237 -> j3377280791;
	j3834424057 [label="Ich weiß. Es ist die Entscheidung von Monsieur Loid und allen anderen, sich zu erkennen zu geben.",shape=box,color=blue];
		j3834424057 -> j3377280791;
	j3377280791 [label="Ich denke, es sind Schuldgefühle und nicht Edelmut, die uns hier unten halten.",shape=box,color=blue];
		j3377280791 -> j404800863;
	j1580551986 [label="Ich habe übrigens eine Freundin, die Ratten liebt. Ich finde sie süß. ",shape=box,color=red];
		j1580551986 -> j851590237;
	j190412747 [label="Ich war nachlässig. Du hast recht. Ich mache mich an die Arbeit.",shape=box,color=red];
		j190412747 -> j4107980774;
	j860612612 [label="Er mag uns ganz gern, er ist freundlich und sanftmütig. Aber wir sind éstrangers für ihn, Neulinge.",shape=box,color=blue];
		j860612612 -> j4230078202;
	j3134079532 [label="Ah bon ?",shape=box,color=blue];
		j3134079532 -> j3417970809;
	j404800863 [label="Dass wir eine große und schreckliche Sünde verbergen.",shape=box,color=blue];
		j404800863 -> j2292545469;
	j4107980774 [label="Vielen Dank. Ich weiß nicht, ob du Erfolg haben wirst, aber manchmal muss man es einfach nur versuchen.",shape=box,color=blue];
		j4107980774 -> j3377280791;
	j4230078202 [label="Ich werde darüber nachdenken. Tu dasselbe ! Wir finden eine Lösung, Sol hat uns bis hierher begleitet !",shape=box,color=blue];
		j4230078202 -> j1045633305;
	j3417970809 [label="Loid könnte auf Roathe hören. Er ist Orokin, sie haben eine gemeinsame Geschichte, das könnte nützlich sein.",shape=box,color=red];
		j3417970809 -> j1395469513;
	j2292545469 [label="Und diese Sünde muss vergeben werden oder sich vielleicht als falsch erweisen ?",shape=box,color=blue];
		j2292545469 -> j3025634547;
		j2292545469 -> j4006668667;
	j1045633305 [label="+15 Chemistry",color=orange];
		j1045633305 -> j1345056062;
	j1395469513 [label="Non ! Er ist ein Lügner, ein Manipulator, er würde das nur gegen eine hohe Gegenleistung tun !",shape=box,color=blue];
		j1395469513 -> j127155111;
	j3025634547 [label="Die Situation oben ist ... sogar an guten Tagen zerbrechlich. Ich möchte sie nicht verstimmen.",shape=box,color=red];
		j3025634547 -> j2293217498;
	j4006668667 [label="Wir müssen einfach vorsichtig sein. Ich fürchte, die eine Hälfte, wird die andere Hälfte als \"die andere Familie\" betrachten.",shape=box,color=red];
		j4006668667 -> j2791376001;
	j1345056062 [label="Wir finden einen Weg Monsieur Loid zu überzeugen, diese Stufen hinaufzugehen... ich weiß es.",shape=box,color=blue];
		j1345056062 -> j1632489172;
	j127155111 [label="Wir finden einen anderen Weg Monsieur Loid zu überzeugen, diese Stufen hinaufzugehen... ich weiß es.",shape=box,color=blue];
		j127155111 -> j923284599;
	j2293217498 [label="Du wärst überrascht, wie widerstandsfähig die Seele ist. Und diejenigen, die mich umgeben, sind inzwischen so alt, so vom Zahn der Zeit gezeichnet.",shape=box,color=blue];
		j2293217498 -> j4174410789;
	j2791376001 [label="Add +1 to Family counter",color=orange];
		j2791376001 -> j4038046181;
	j1632489172 [label="Ich muss gehen. Ich muss über vieles nachdenken, vieles tun. À la revoyure.",shape=box,color=blue];
		j1632489172 -> j3419468122;
	j923284599 [label="Ich muss gehen. Ich muss über vieles nachdenken, vieles tun. À la revoyure.",shape=box,color=blue];
		j923284599 -> j3493145735;
	j4174410789 [label="Du hast sie oft überrascht. Lass sie diesmal dich überraschen.",shape=box,color=blue];
		j4174410789 -> j3168466109;
	j4038046181 [label="Oh... Sol, ich glaube, du hast es gelöst !",shape=box,color=blue];
		j4038046181 -> j330373952;
