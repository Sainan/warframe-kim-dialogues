		1651 -> 1674 [label="false",color=purple];
	1652 [label="Und was bitte könnte dich ablenken ? Was könnte wichtiger sein, als sich hinzusetzen und die Beschwerden der mécontents durchzugehen ?",shape=box,color=blue];
		1652 -> 1676;
	1653 [label="Was kann so schwierig daran sein, sich hinzusetzen und die Beschwerden der mécontents durchzugehen ?",shape=box,color=blue];
		1653 -> 1677;
	1654 [label="Oh, fantastisch !",shape=box,color=blue];
		1654 -> 1678;
	1655 [label="Chat ends.",color=orange];
	1656 [label="Seine Tochter Euleria – genannt Mutter – und ihre Familie haben sich die ganze Zeit um Deimos gekümmert.",shape=box,color=red];
		1656 -> 1679;
	2937 [label="Was hält uns davon ab, einfach alle Möbel wegzuräumen, dann können sie sie ersetzen und dann ... machen wir das erneut ? Wir könnten sie alle verkaufen und mit mobilier étrange Profit machen !",shape=box,color=blue];
		2937 -> 2938;
		2937 -> 2939;
		2937 -> 2940;
	1658 [label="Ich bin mir unserer ungelösten Differenzen über le Cardinal bewusst. Ich versuche die Unterhaltung civilisée zu halten.",shape=box,color=blue];
		1658 -> 1680;
	1661 [label="Ich verstehe, dass du nicht über das Überbrücken von Differenzen sprechen möchtest, ohne diejenigen bloßzustellen, die deiner Meinung nach an ihnen Schuld sind.",shape=box,color=blue];
		1661 -> 1680;
	1657 [label="Oui ! Wie du mich so oft erinnerst, hältst du ihn für eine Art monstre ! Mit nichts als Bosheit und Leere im Herzen !",shape=box,color=blue];
		1657 -> 1680;
	1659 [label="Ich dachte, dass du im Kampf um le Cardinals Seele auf meiner Seite bist ?",shape=box,color=blue];
		1659 -> 1681;
	1660 [label="Ich dachte, du hättest dich im Bezug auf le Cardinal noch nicht entschieden ? Oder hat sich das geändert ?",shape=box,color=blue];
		1660 -> 1682;
		1660 -> 1683;
	1668 [label="Oui. Das lerne ich gerade von M'sieur Tagfer...",shape=box,color=blue];
		1668 -> 1686;
	1662 [label="Sprich nicht von verkrusteten Wunden, Wolf. Ich lecke immer noch die, die ich von unserer letzten Diskussion über le Cardinal davongetragen habe.",shape=box,color=blue];
		1662 -> 1680;
	1663 [label="Oui, aber das hast du schon gesagt - wir müssen aufhören uns gegenseitig die Schuld an unseren Wunden zu geben.",shape=box,color=blue];
		1663 -> 1684;
	1664 [label="Ich weiß, dass du glaubst, das le Cardinal eine Art furchtbares monstre ist, dass er solche Wunden schlägt.",shape=box,color=blue];
		1664 -> 1680;
	1665 [label="Ich weiß, dass du im Kampf um le Cardinals Seele auf meiner Seite bist und dafür werde ich ewig dankbar sein.",shape=box,color=blue];
		1665 -> 1666;
	1667 [label="Ich weiß, dass du dein Urteil über ihn zurückhältst und dafür bin ich dir unendlich dankbar. ",shape=box,color=blue];
		1667 -> 1666;
	1666 [label="Ich weiß, dass die anderen schnell bereit sind, le Cardinal die Schuld zu geben, aber ich möchte nicht, dass wir gespalten sind und bluten, wenn wir doch vereint sein könnten.",shape=box,color=blue];
		1666 -> 1685;
	1675 [label="Oui, auch wenn ich gerade von M'sieur Tagfer lerne, dass es vielleicht nicht für alles dasselbe ist.",shape=box,color=blue];
		1675 -> 1686;
	1669 [label="Und ich lerne gerade, dass es nicht für alle das gleiche Ausmaß hat, wie du mit so \"freundlich\" gesagt hast, non ?",shape=box,color=blue];
		1669 -> 1680;
	1670 [label="Oui, ja ! Auch wenn ich le Cardinal nicht vorwerfe, dass er gegangen ist, denn seine Arbeit ist unantastbar - ",shape=box,color=blue];
		1670 -> 1666;
	1671 [label="Und ich weiß, dass du glaubst, das le Cardinal eine Art furchtbares monstre ist, dass er solche Wunden schlägt.",shape=box,color=blue];
		1671 -> 1680;
	1672 [label="Ich weiß, dass du im Kampf um le Cardinals Seele auf meiner Seite bist und dafür werde ich ewig dankbar sein.",shape=box,color=blue];
		1672 -> 1666;
	1673 [label="Ich weiß, dass du dein Urteil über ihn zurückhältst und dafür bin ich dir unendlich dankbar. ",shape=box,color=blue];
		1673 -> 1666;
	1674 [label="Und während andere schnell bereit sind, ihr für ihre Schmerzen die Schuld zu geben, möcht ich einfach nicht, dass wir getrennt werden und leiden.",shape=box,color=blue];
		1674 -> 1685;
	1676 [label="Ich mache nur Spaß ! Ich kann mir nicht vorstellen, wie beschäftigt du sein musst, alle die Orte ... und Zeiten ... wo du gebraucht wirst.",shape=box,color=blue];
		1676 -> 1678;
	1677 [label="Ich mache nur Spaß ! Ich kann mir nicht vorstellen, was sie durchgemacht haben müssen. Und wie schwierig es sein muss, alles zu vestehen.",shape=box,color=blue];
		1677 -> 1678;
	1678 [label="Ich fürchte nur, wenn ihre Probleme nicht gelöst werden, werden wir unter ihnen nie willkommen sein. Das größere Problem bleibt ungelöst - ",shape=box,color=blue];
		1678 -> 1637;
	1679 [label="Über diesen Ort und das Herz gewacht, das Void-Energie in das Ursprungssystem pumpt und uns alle ... wirklich verwendbar hält, seit Entrati gegangen ist.",shape=box,color=red];
		1679 -> 1687;
	2938 [label="Ich weiß nicht, ob es eine Nachfrage für Entratis Stühle gibt ...",shape=box,color=red];
		2938 -> 2942;
	2939 [label="Würden wir den Markt nicht überschwemmen? Wir müssten sie ziemlich billig verkaufen ...",shape=box,color=red];
		2939 -> 2942;
	2940 [label="Großartig. Darin sehe ich kaum ein Problem.",shape=box,color=red];
		2940 -> 2941;
	1680 [label="Auch wenn ich verstehe, dass diese beiden Themen untrennbar verbunden sind möchte ich dich bitten, heute produktiv zu bleiben, oui ?",shape=box,color=blue];
		1680 -> 1688;
	1681 [label="Was ist das für eine Täuschung von dir, Wolf ? Oder ist die kleine Marie nur ein jeu für dich ?",shape=box,color=blue];
		1681 -> 1689;
		1681 -> 1683;
	1682 [label="Ich bin mir noch nicht im Klaren über die notwendig seiner Handlungen. Aber es steht kaum außer Frage, dass er abgebrüht ist.",shape=box,color=red];
		1682 -> 1680;
	1683 [label="Es tut mir leid, ich bin es leid, so zu tun.",shape=box,color=red];
		1683 -> 1690;
	1686 [label="Wir müssen aufhören uns gegenseitig die Schuld an unseren Wunden zu geben.",shape=box,color=blue];
		1686 -> 1684;
	1684 [label="Ich bin auch nicht damit einverstanden, le Cardinal die Schuld zu geben, aber ich möchte nicht, dass wir gespalten sind und bluten, wenn wir vereint sein könnten.",shape=box,color=blue];
		1684 -> 1691;
		1684 -> 1692;
	1685 [label="Wir müssen aufhören uns gegenseitig die Schuld an unseren Wunden zu geben, egal wer letztendlich Schuld ist.",shape=box,color=blue];
		1685 -> 1691;
		1685 -> 1692;
	1687 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1687 -> 1693 [label=true,color=green];
		1687 -> 1694 [label=false,color=brown];
	2942 [label="Pff ! Ich glaube, es ist ein Experiment wert. Vielleicht können wir den Teufel hinter einem Meer von Bücherregalen einsperren !",shape=box,color=blue];
		2942 -> 2943;
	2941 [label="Ich werde gehorsam deinen Sarkasmus ignorieren, denn ich glaube es ist ein lohnenswertes Experiment. Vielleicht können wir den Teufel hinter einem Meer von Bücherregalen einsperren !",shape=box,color=blue];
		2941 -> 2943;
	1688 [label="Ich möchte uns allen in mit dieser ... seltsamen Koexistenz, in der wir uns befinden, helfen und nicht streiten.",shape=box,color=blue];
		1688 -> 1686;
	1689 [label="Nein, kein Spiel. Aber Entrati kann man nicht trauen und ich weiß nicht, wie ich dich sonst überzeugen kann, als so zu tun, als wäre ich auf deiner Seite.",shape=box,color=red];
		1689 -> 1695;
	1690 [label="Oui ? Dann freut es mich dir sagen zu können, dass das nicht länger nötig ist.",shape=box,color=blue];
		1690 -> 1696;
	1691 [label="Alle zusammen sind wir eine ... seltsame Familie. Aber immerhin sind wir eine Familie.",shape=box,color=red];
		1691 -> 1697;
	1692 [label="Zusammen sind wir stärker, als getrennt.",shape=box,color=red];
		1692 -> 1698;
		1692 -> 1699;
	1693 [label="Sie hat sich mit seiner Abwesenheit abgefunden und sie haben Frieden miteinander geschlossen, aber es war hart erkämpft.",shape=box,color=red];
		1693 -> 1700;
	1694 [label="Sie hat sich mit seiner Abwesenheit nicht abgefunden und die beiden liegen sich gegenseitig an die Gurgel.",shape=box,color=red];
		1694 -> 1701;
	2943 [label="+20 Chemistry",color=orange];
		2943 -> 2944;
	1695 [label="Oui ? Dann freut es mich dir sagen zu können, dass du gescheitert bist.",shape=box,color=blue];
		1695 -> 1696;
	1696 [label="Update boolean MarieEntratiFan1",color=orange];
		1696 -> 1702;
	1697 [label="Add +1 to Family",color=orange];
		1697 -> 1698;
		1697 -> 1699;
	1698 [label="Und in Zeiten, in denen wir leiden, ist manchmal alles, was wir wirklich haben, einander. Entweder diejenigen, die uns gegeben wurden, oder diejenigen, die wir gefunden haben.",shape=box,color=red];
		1698 -> 1703;
	1699 [label="Ich weiß nicht, ob es langfristig helfen oder schaden würde, aber dieses... Fegefeuer, ist auch nicht richtig.",shape=box,color=red];
		1699 -> 1704;
	1700 [label="Zu wissen, dass er weiterhin da draußen ist, Amok läuft und dass er kein Wort mit ihr gewechselt oder ihr nicht einmal einen Brief geschickt hat ...?",shape=box,color=red];
		1700 -> 1705;
	1701 [label="Zu wissen, dass er weiterhin da draußen ist, Amok läuft und dass er kein Wort mit ihr gewechselt oder ihr nicht einmal einen Brief geschickt hat ...?",shape=box,color=red];
		1701 -> 1706;
	2944 [label="Viel zu tun ! À la revoyure !",shape=box,color=blue];
		2944 -> 2929;
	1702 [label="Update boolean MarieEntratiFan2",color=orange];
		1702 -> 1707;
	1703 [label="Add +1 to Family",color=orange];
		1703 -> 1704;
	1704 [label="Ja, dem stimme ich zu. Aber ich kann die Kluft zwischen uns nicht schließen, ich weiß nicht, wie ! Für die da oben bin ich eine Fremde...",shape=box,color=blue];
		1704 -> 1708;
		1704 -> 1709;
	1705 [label="Ich kann mir nicht vorstellen, wie schmerzhaft das für sie wäre. Für beide.",shape=box,color=red];
		1705 -> 1710;
	1706 [label="Das würde die geringe Chance auf eine Versöhnung zerstören, die sie möglicherweise haben.",shape=box,color=red];
		1706 -> 1711;
	2929 [label="Chat ends.",color=orange];
	1707 [label="Update boolean MarieNoDate",color=orange];
		1707 -> 1712;
	1708 [label="Loid kannte die Entrati Familie. Er sollte es tun. Aber ihn davon zu überzeugen... das ist eine andere Sache.",shape=box,color=red];
		1708 -> 1713;
	1709 [label="Roathe vielleicht ? Er ist Orokin, er kannte sie alle.",shape=box,color=red];
		1709 -> 1714;
	1710 [label="Ich verstehe zwar die Logik hinter der Entscheidung, sie vor dem Schmerz zu schützen, die le Cardinal durch seinen notwendigen Aufbruch verursacht hat ...",shape=box,color=blue];
		1710 -> 1715;
	1711 [label="Oui ... ich verstehe die Logik. Ich würde daran arbeiten, ihre Familie wieder zusammenzubringen, wenn du kannst, non ? Es scheint die einzige Hoffnung für uns zu sein, hier rauszukommen. ",shape=box,color=blue];
		1711 -> 1716;
	1712 [label="Chat ends.",color=orange];
	1713 [label="+5 Chemistry",color=orange];
		1713 -> 1717;
	1714 [label="Non, nicht der Teufel - jeder, außer dem Teufel. Aber da ist etwas Wahres dran. Die beste Lösung wäre Monsieur Loid, non ?",shape=box,color=blue];
		1714 -> 1718;
	1715 [label="Aber ich finde es unnötig grausam, du nicht ? Sie könnten ihn für tot halten. Oder Schlimmeres! Und wir, leben hier comme des rats d'égout ?",shape=box,color=blue];
		1715 -> 1719;
		1715 -> 1720;
		1715 -> 1721;
	1716 [label="Damit wir nicht den Rest unseres Lebens hier gefangen verbringen, comme des rats d'égout.",shape=box,color=blue];
		1716 -> 1722;
		1716 -> 1723;
	1717 [label="Oui, oui ! C'est ça ! Aber wie überzeugen wir ihn ? Er hat seine Position konsequent vertreten, non ?",shape=box,color=blue];
		1717 -> 1724;
		1717 -> 1725;
	1718 [label="Aber wie überzeugen wir ihn ? Er hat seine Position konsequent vertreten, non ?",shape=box,color=blue];
		1718 -> 1725;
		1718 -> 1724;
	1719 [label="Ich habe übrigens eine Freundin, die Ratten liebt. Ich finde sie süß.",shape=box,color=red];
		1719 -> 1726;
	1720 [label="Diese Entscheidung kann ich nicht wirklich treffen.",shape=box,color=red];
		1720 -> 1727;
	1721 [label="Was soll ich tun?",shape=box,color=red];
		1721 -> 1728;
	1722 [label="Ich habe übrigens eine Freundin, die Ratten liebt. Ich finde sie süß. ",shape=box,color=red];
		1722 -> 1729;
	1723 [label="Ich war nachlässig. Du hast recht. Ich mache mich an die Arbeit.",shape=box,color=red];
		1723 -> 1730;
	1724 [label="Denkst du, du oder Lyon könnten ihn überzeugen?",shape=box,color=red];
		1724 -> 1731;
	1725 [label="Meine Antwort wird dir nicht gefallen, Marie ...",shape=box,color=red];
		1725 -> 1732;
	1726 [label="Und ich würde sie gerne eines Tages kennenlernen, aber das ist nicht der Punkt, den ich machen will, Dummkopf.",shape=box,color=blue];
		1726 -> 1728;
	1727 [label="Ich weiß. Es ist die Entscheidung von Monsieur Loid und allen anderen, sich zu erkennen zu geben.",shape=box,color=blue];
		1727 -> 1728;
	1728 [label="Ich denke, es sind Schuldgefühle und nicht Edelmut, die uns hier unten halten.",shape=box,color=blue];
		1728 -> 1733;
	1729 [label="Und ich würde sie gerne eines Tages kennenlernen, aber das ist nicht der Punkt, den ich machen will, Dummkopf.",shape=box,color=blue];
		1729 -> 1728;
	1730 [label="Vielen Dank. Ich weiß nicht, ob du Erfolg haben wirst, aber manchmal muss man es einfach nur versuchen.",shape=box,color=blue];
		1730 -> 1728;
	1731 [label="Er mag uns ganz gern, er ist freundlich und sanftmütig. Aber wir sind éstrangers für ihn, Neulinge.",shape=box,color=blue];
		1731 -> 1734;
	1732 [label="Ah bon ?",shape=box,color=blue];
		1732 -> 1735;
	1733 [label="Dass wir eine große und schreckliche Sünde verbergen.",shape=box,color=blue];
		1733 -> 1736;
	1734 [label="Ich werde darüber nachdenken. Tu dasselbe ! Wir finden eine Lösung, Sol hat uns bis hierher begleitet !",shape=box,color=blue];
		1734 -> 1737;
	1735 [label="Loid könnte auf Roathe hören. Er ist Orokin, sie haben eine gemeinsame Geschichte, das könnte nützlich sein.",shape=box,color=red];
		1735 -> 1738;
	1736 [label="Und diese Sünde muss vergeben werden oder sich vielleicht als falsch erweisen ?",shape=box,color=blue];
		1736 -> 1739;
		1736 -> 1740;
	1737 [label="+15 Chemistry",color=orange];
		1737 -> 1741;
	1738 [label="Non ! Er ist ein Lügner, ein Manipulator, er würde das nur gegen eine hohe Gegenleistung tun !",shape=box,color=blue];
		1738 -> 1742;
	1739 [label="Die Situation oben ist ... sogar an guten Tagen zerbrechlich. Ich möchte sie nicht verstimmen.",shape=box,color=red];
		1739 -> 1743;
	1740 [label="Wir müssen einfach vorsichtig sein. Ich fürchte, die eine Hälfte, wird die andere Hälfte als \"die andere Familie\" betrachten.",shape=box,color=red];
		1740 -> 1744;
	1741 [label="Wir finden einen Weg Monsieur Loid zu überzeugen, diese Stufen hinaufzugehen... ich weiß es.",shape=box,color=blue];
		1741 -> 1745;
	1742 [label="Wir finden einen anderen Weg Monsieur Loid zu überzeugen, diese Stufen hinaufzugehen... ich weiß es.",shape=box,color=blue];
		1742 -> 1746;
	1743 [label="Du wärst überrascht, wie widerstandsfähig die Seele ist. Und diejenigen, die mich umgeben, sind inzwischen so alt, so vom Zahn der Zeit gezeichnet.",shape=box,color=blue];
		1743 -> 1747;
	1744 [label="Add +1 to Family",color=orange];
		1744 -> 1748;
	1745 [label="Ich muss gehen. Ich muss über vieles nachdenken, vieles tun. À la revoyure.",shape=box,color=blue];
		1745 -> 1749;
	1746 [label="Ich muss gehen. Ich muss über vieles nachdenken, vieles tun. À la revoyure.",shape=box,color=blue];
		1746 -> 1750;
