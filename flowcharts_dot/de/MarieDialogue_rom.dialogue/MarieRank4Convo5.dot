	2930 [label="Drifter ! Ich hab nachgedacht.",shape=box,color=blue];
		2930 -> 2931;
		2930 -> 2932;
	1630 [label="Drifter ! Ich habe Pläne geschmiedet, habe über die Familie über uns nachgedacht. Und wie sie uns als Eindringlinge betrachten könnten.",shape=box,color=blue];
		1630 -> 1633;
	1631 [label="Drifter ! Ich habe darüber nachgedacht, was du über die Familie über uns gesagt hast. Es tut mir leid für sie ...",shape=box,color=blue];
		1631 -> 1634;
	1632 [label="Warum können wir nicht nach oben gehen ? Warum können wir nicht mit denen sprechen, die le Cardinal famille genannt hat ?",shape=box,color=blue];
		1632 -> 1635;
		1632 -> 1636;
	2931 [label="Sollte ich mich fürchten?",shape=box,color=red];
		2931 -> 2934;
	2932 [label="[Ende.]",shape=box,color=red];
		2932 -> 2933;
	1633 [label="Als die \"andere Familie\" in compétition, oui ? Es beunruhigt mich sehr.",shape=box,color=blue];
		1633 -> 1634;
	1634 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1634 -> 1637 [label=true,color=green];
		1634 -> 1638 [label=false,color=brown];
	1635 [label="Nun ... kurz gefasst, ein Teil von Entratis Familie ist oben und sie sind sich nicht ... wirklich bewusst, dass wir hier unten sind.",shape=box,color=red];
		1635 -> 1639;
	1636 [label="[Ende.]",shape=box,color=red];
		1636 -> 1640;
	2934 [label="Oui ! Die kleinen fliegenden Roboter. Die Necra... Necra ... Wie nennst du sie ?",shape=box,color=blue];
		2934 -> 2935;
	2933 [label="Chat ends.",color=orange];
	1637 [label="Wir wetteifern nicht um die Gunst von le Cardinal, wie können wir ihnen das begreiflich machen ?",shape=box,color=blue];
		1637 -> 1641;
		1637 -> 1642;
		1637 -> 1643;
	1638 [label="Wie geht deine Arbeit voran, ihre inneren Konflikte zu lösen ?",shape=box,color=blue];
		1638 -> 1644;
		1638 -> 1645;
		1638 -> 1646;
		1638 -> 1647;
	1639 [label="Update boolean MarieFamily1",color=orange];
		1639 -> 1648;
	1640 [label="Chat ends.",color=orange];
	2935 [label="Necramiten?",shape=box,color=red];
		2935 -> 2936;
	1641 [label="Du hast recht. Man nicht um etwas wetteifern, was eine Person nicht bereit ist zu geben.",shape=box,color=red];
		1641 -> 1649;
	1642 [label="Das Öffnen verkrusteter Wunden ist gefährlich. Vielleicht beseitigt man eine Infektion ... oder verblutet dabei.",shape=box,color=red];
		1642 -> 1650;
	1643 [label="Ihr - wir - haben alles etwas gemeinsam. Irgendwann wurden wir von Entrati zurückgelassen.",shape=box,color=red];
		1643 -> 1651;
	1644 [label="Ganz ehrlich? Ich wurde abgelenkt.",shape=box,color=red];
		1644 -> 1652;
	1645 [label="Es könnte besser laufen.",shape=box,color=red];
		1645 -> 1653;
	1646 [label="Ich mache Fortschritte.",shape=box,color=red];
		1646 -> 1654;
	1647 [label="[Ende.]",shape=box,color=red];
		1647 -> 1655;
	1648 [label="Par les Luminaires ... Du meinst, wir sind alle hier unten im Geheimen ?! Dürfen wir diesen Ort deshalb nicht verlassen ?! Mais pourquoi ?!",shape=box,color=blue];
		1648 -> 1656;
	2936 [label="Oui ! Ha ! Sind sind so hartnäckig darin, die Möbel zu ersetzen, non ? Aber wenn man Dinge umstellt... machen sie genau dasselbe.",shape=box,color=blue];
		2936 -> 2937;
