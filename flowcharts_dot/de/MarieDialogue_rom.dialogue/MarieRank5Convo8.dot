	3772 [label="Chat ends.",color=orange];
	3779 [label="Ich fürchte, ich muss ihn nun \"unseren\" Teufel nennen, non ? Denn er wird uns so schnell nicht verlassen. Ha !",shape=box,color=blue];
		3779 -> 3784;
	3775 [label="Ich habe das Gefühl, ich sollte dir diese Frage stellen, non ? Schließlich springst du jetzt mit ihm herum !",shape=box,color=blue];
		3775 -> 3781;
	3776 [label="Ich weiß nicht, wie du das geschafft hast. Aber er hat uns die Wahrheit erzählt, über das Serum und seine Einnahme.",shape=box,color=blue];
		3776 -> 3782;
	3777 [label="Ich weiß nicht, wie du das geschafft hast. Aber er hat uns die Wahrheit erzählt, über das sérum und seine Einnahme.",shape=box,color=blue];
	3778 [label="Ich mache mir Sorgen um ihn. Ich glaube, er tut sich mehr weh, als er zugibt, n'est-ce pas ?",shape=box,color=blue];
		3778 -> 3783;
	3774 [label="Es tut mir leid, falls das jetzt etwas überraschend kommt, aber ich wusste nicht, wie ich es dir früher sagen sollte.",shape=box,color=red];
		3774 -> 3780;
	3784 [label="Es ist dir gelungen, seine Hilfe zu erhalten für Monsieur Loid. Ich glaubte nicht, das wäre möglich.",shape=box,color=blue];
		3784 -> 3786;
	3781 [label="Ich widersetze mich dem Versuch, dich um toutes sortes de commérages zu bitten.",shape=box,color=blue];
		3781 -> 3786;
	3782 [label="Sol, es brach mir das Herz. Seine Stimme zitterte nicht, als er sprach. Mais je l'ai vu dans ses yeux.",shape=box,color=blue];
		3782 -> 3786;
	3783 [label="Es bricht mir das Herz. Ich hoffe, dass seins nicht eines Tages in seiner Brust zerbricht. Ich weiß nicht, ob er es überleben wird. Ich weiß nicht, ob es irgendjemand von uns überleben wird.",shape=box,color=blue];
		3783 -> 3787;
	3780 [label="Ich verehre dich. Ich bin einfach total vernarrt in dich.",shape=box,color=red];
		3780 -> 3785;
	3786 [label="Er hat sich verändert. Subtil, aber der Wandel ist da. ",shape=box,color=blue];
		3786 -> 3789;
	3787 [label="Chat ends.",color=orange];
	3785 [label="Also, ich wollte fragen ... ob du Lust hättest ... nun ja ... ein Paar zu werden?",shape=box,color=red];
