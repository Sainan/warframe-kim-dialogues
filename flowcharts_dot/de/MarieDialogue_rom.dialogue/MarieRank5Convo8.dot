	3790 [label="Oh ! Oh, Drifter. Ich weiß nicht, wie ich das sagen soll, also sage ich es einfach direkt.",shape=box,color=blue];
		3790 -> 3793;
	3791 [label="Oh, mir geht es genauso ! Mais je ne sais pas comment te l'écrire, je n'ose pas taper les mots ! Ich hielt mich für eine Närrin, überhaupt daran zu denken !",shape=box,color=blue];
		3791 -> 3794;
	3795 [label="Ich weiß nicht, ob er es begrüßen wird, aber er wird immer Freunde haben.",shape=box,color=blue];
