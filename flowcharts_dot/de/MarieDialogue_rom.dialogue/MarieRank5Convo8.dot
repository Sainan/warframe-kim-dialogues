		3799 -> 3803;
	3800 [label="Es hat sich alles definitiv etwas weiterentwickelt. Ich würde nicht sagen, dass sie \"formeller\" geworden sind, aber ich zeige es ... dir gerne.",shape=box,color=red];
		3800 -> 3804;
	3805 [label="Comme un gros chat de gouttière. Ich habe mich an ihn gewöhnt.",shape=box,color=blue];
		3805 -> 3808;
	3806 [label="Oui ! Ich auch. Er wird jeden Tag ein bisschen weniger unerträglich.",shape=box,color=blue];
		3806 -> 3805;
	3803 [label="Keine Sorge, jetzt bin ich es, die scherzt. Aber je suis ravie, so oder so ! Und freue mich darauf, diese neuen ... romantiques Bräuche kennenzulernen.",shape=box,color=blue];
