	3798 [label="Aber ich denke, dass ich nie müde werde, ihn anzuschreien !",shape=box,color=blue];
		3798 -> 3801;
		3798 -> 3802;
	3796 [label="Chat ends.",color=orange];
	3797 [label="Wenn du eine etwas ... formellere Annäherung wünschst, dann oui ! Oui ! Das würde mir gefallen.",shape=box,color=blue];
