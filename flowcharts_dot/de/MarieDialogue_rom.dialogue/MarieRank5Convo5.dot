		3092 -> 3094 [label=false,color=brown];
	3093 [label="Bonjour, bonjour, mon cœur ! Ich muss dir etwas Albernes erzählen.",shape=box,color=blue];
		3093 -> 3095;
		3093 -> 3096;
	3094 [label="Bonjour ! Ich muss dir etwas Albernes erzählen.",shape=box,color=blue];
		3094 -> 3095;
		3094 -> 3096;
	3095 [label="Oh? Was ist passiert?",shape=box,color=red];
		3095 -> 3097;
	3096 [label="[Ende.]",shape=box,color=red];
		3096 -> 3098;
	3097 [label="Ich habe M'sieur Vogel Trois nach seinem Geburtstag gefragt und er wusste es nicht ! Schrecklich traurig !",shape=box,color=blue];
		3097 -> 3099;
	3098 [label="Chat ends.",color=orange];
	3099 [label="Keiner der Cavia kennt seinen Geburtstag, was wohl auch Sinn ergibt, wenn man bedenkt, dass sie ohne die Fähigkeit zu sprechen geboren wurden und keinen calendrier wie wir kennen.",shape=box,color=blue];
		3099 -> 3100;
	3100 [label="Also dachte ist, dass das eine tragédie ist ! Das müssen wir sofort berichtigen, non ?",shape=box,color=blue];
		3100 -> 3101;
		3100 -> 3102;
		3100 -> 3103;
	3101 [label="Darüber hab ich nie nachgedacht.",shape=box,color=red];
		3101 -> 3104;
	3102 [label="Wie findest du heraus, wann sie geboren wurden?",shape=box,color=red];
		3102 -> 3105;
	3103 [label="Dürfen sie sich einen Geburtstag aussuchen?",shape=box,color=red];
		3103 -> 3106;
	3104 [label="Oui ! Monsieur Loid auch nicht. Als ich das herausgefunden habe, verriet sein Gesicht eine tiefe Trauer...",shape=box,color=blue];
		3104 -> 3107;
	3105 [label="Erst dachte ich daran, die Aufzeichnungen von le Cardinal einzusehen - vielleicht hat er aufgeschrieben, wann sie geboren worden waren, oui ?",shape=box,color=blue];
		3105 -> 3108;
	3106 [label="\"Dürfen ?\" Du sagst das so, als wäre das meine Aufgabe !",shape=box,color=blue];
		3106 -> 3105;
	3107 [label="Es bricht mir das Herz, dass er glaubt, es sei sein Fehler, weil er nicht als Erster daran gedacht hat. Es ist nicht seine Schuld, er tut so viel, für so viele...",shape=box,color=blue];
		3107 -> 3109;
	3108 [label="Evaluate expressions",color=orange];
		3108 -> 3110 [label="MarieEntratiComplete",color=purple];
		3108 -> 3110 [label="MarieEntrati3a",color=purple];
		3108 -> 3111 [label="false",color=purple];
	3109 [label="Wir alle haben Glück, die Güte von Monsieur Loid kennenzulernen. Die Tiefe der Quelle, aus der er seine Kraft bezieht, kennt kein Ende.",shape=box,color=blue];
		3109 -> 3112;
		3109 -> 3113;
	3110 [label="Aber dann habe ich mich... an meine Gespräche mit M'sieur Tagfer erinnert und mit den anderen und dachte, das ist vielleicht nicht so eine gute Idee.",shape=box,color=blue];
		3110 -> 3114;
	3111 [label="Aber sie schienen kein Interesse daran zu haben, Aufzeichnungen ihrer Vergangenheit zu finden. Ich weiß, wie schmerzhaft es sein kann, sich an seine Wurzeln zu erinnern.",shape=box,color=blue];
		3111 -> 3114;
	3112 [label="Wir haben Glück, dass er hier ist.",shape=box,color=red];
		3112 -> 3115;
	3113 [label="Ich wünschte nur, er wäre ab und zu etwas fröhlicher.",shape=box,color=red];
		3113 -> 3116;
	3114 [label="Meinen eigenen Geburtstag kenne ich schließlich auch nicht.",shape=box,color=blue];
		3114 -> 3117;
		3114 -> 3118;
		3114 -> 3119;
	3115 [label="Oui, auf jeden Fall. Das ist für uns alle so.",shape=box,color=blue];
		3115 -> 3120;
	3116 [label="Er ist ein ernster Mann, aber ich habe ihn schon lächeln sehen. Er hat Humor, wenn man es am wenigsten erwartet. Man muss nur Geduld haben.",shape=box,color=blue];
		3116 -> 3120;
	3117 [label="Fall dich das tröstet, ich auch nicht. Ich glaube, der Zwerg kennt seinen auch nicht.",shape=box,color=red];
		3117 -> 3121;
	3118 [label="Geburtstage werden überbewertet.",shape=box,color=red];
		3118 -> 3122;
	3119 [label="Es macht sowieso mehr Spaß, sich einen auszusuchen. Es ist poignant.",shape=box,color=red];
		3119 -> 3123;
	3120 [label="Check boolean MarieDating",color=orange];
		3120 -> 3125 [label=true,color=green];
		3120 -> 3124 [label=false,color=brown];
	3121 [label="Noch ein Grund, um dich und deine minuscule copie zu weinen. Noch etwas, was wir gemeinsam haben !",shape=box,color=blue];
		3121 -> 3120;
	3122 [label="Ich glaube nicht, dass sie überbewertet werden ! Wir müssen diejenigen feiern, die noch bei uns sind, ebenso wie die, die es nicht mehr sind.",shape=box,color=blue];
		3122 -> 3120;
	3123 [label="Poignant ? Ich wusste nicht, dass Gaullique prichst ! Hast du das von mir aufgeschnappt ?",shape=box,color=blue];
		3123 -> 3126;
		3123 -> 3127;
	3125 [label="+20 Chemistry",color=orange];
		3125 -> 3129;
	3124 [label="+20 Chemistry",color=orange];
		3124 -> 3128;
	3126 [label="Ich... glaube, das gibt es in beiden Sprachen ...",shape=box,color=red];
		3126 -> 3130;
	3127 [label="Ich denke, das habe ich von dir.",shape=box,color=red];
		3127 -> 3131;
	3129 [label="Nun ! Dann mal los, mon cœur ! Auch, wenn daraus nichts wird, ist es immer der Gedanke, der zählt ! Au calendrier !",shape=box,color=blue];
		3129 -> 3132;
	3128 [label="Nun ! Dann mal los ! Auch, wenn daraus nichts wird, ist es der Gedanke, der zählt ! Au calendrier !",shape=box,color=blue];
		3128 -> 3132;
	3130 [label="Pfft ! Andere Sprachen stehlen ständig das Beste des Gaullique und geben als ihre eigene Erfindung aus ! Es gibt Dinge, die werden sich nie ändern !",shape=box,color=blue];
		3130 -> 3120;
	3131 [label="Dann bist du klug ! Gaullique ist eine der schönsten Sprachen, die es je gegeben hat und ich bin froh, sie in diese futur zu bringen.",shape=box,color=blue];
		3131 -> 3120;
	3132 [label="Chat ends.",color=orange];
}