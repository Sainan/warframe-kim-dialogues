	j2190373430 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j2190373430 -> j727776813;
	j727776813 [label="Ich habe neulich mit Monsieur Loid über seine Kindheit gesprochen und hatte eine Frage an dich.",shape=box,color=blue];
		j727776813 -> j3610495003;
		j727776813 -> j1208178247;
		j727776813 -> j3295273113;
		j727776813 -> j129698615;
	j3610495003 [label="Tut mir leid. Was bitte?",shape=box,color=red];
		j3610495003 -> j11850715;
	j1208178247 [label="Ich ... weiß ... nicht, was ich davon halten soll.",shape=box,color=red];
		j1208178247 -> j1346035989;
	j3295273113 [label="Was ist die Frage?",shape=box,color=red];
		j3295273113 -> j3352481915;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j11850715 [label="Er erzählte mir von seiner Jugend. Ai-je fait quelque chose qui vous a offensé ?",shape=box,color=blue];
		j11850715 -> j3872141128;
		j11850715 -> j2782733519;
	j1346035989 [label="Ich verstehe nicht. Ai-je fait quelque chose qui vous a offensé ?",shape=box,color=blue];
		j1346035989 -> j3872141128;
		j1346035989 -> j2782733519;
	j3352481915 [label="Die Archimeden– waren sie Orokin ? Oder waren sie es nicht ? Das Wort wird mit so viel Leichtfertigkeit verwendet.",shape=box,color=blue];
		j3352481915 -> j1501292011;
	"Chat ends." [color=orange];
	j3872141128 [label="Ich denke, ich bin einfach nur ... neidisch.",shape=box,color=red];
		j3872141128 -> j30662892;
	j2782733519 [label="Ich denke, ich bin einfach ... überrascht.",shape=box,color=red];
		j2782733519 -> j1010099276;
	j1501292011 [label="Ich könnte den Teufel fragen. Aber ich rede nicht gern mit ihm, wenn ich es vermeiden kann.",shape=box,color=blue];
		j1501292011 -> j63373758;
		j1501292011 -> j1529661219;
	j30662892 [label="De la jalousie ? Pourquoi ?",shape=box,color=blue];
		j30662892 -> j4147183442;
	j1010099276 [label="Pourquoi ?",shape=box,color=blue];
		j1010099276 -> j1603664574;
		j1010099276 -> j4105475136;
	j63373758 [label="Nein, die Archimeden standen einen Rang unter den Orokin.",shape=box,color=red];
		j63373758 -> j1905930448;
	j1529661219 [label="Das Reich der Orokin wird so genannt, weil es von den Orokin regiert wurde, aber Orokin war auch nur der Name der herrschenden Klasse.",shape=box,color=red];
		j1529661219 -> j1905930448;
	j4147183442 [label="+10 Chemistry",color=orange];
		j4147183442 -> j3324303205;
	j1603664574 [label="Ich bin nur ein wenig überrascht, dass du jetzt mehr über ihn weißt als ich.",shape=box,color=red];
		j1603664574 -> j4147183442;
	j4105475136 [label="Ich weiß nichts über Loids Vergangenheit und ich kenne ihn schon eine Weile.",shape=box,color=red];
		j4105475136 -> j4147183442;
	j1905930448 [label="Das passiert oft. Du bist nicht allein.",shape=box,color=red];
		j1905930448 -> j2602243711;
	j3324303205 [label="Oh ! Nimm es nicht persönlich, s'il vous plaît !",shape=box,color=blue];
		j3324303205 -> j4110453352;
	j2602243711 [label="Haben die Orokin ihre Gesellschaft absichtlich verwirrend und stumpfsinnig gemacht ?",shape=box,color=blue];
		j2602243711 -> j4476801;
		j2602243711 -> j1201368911;
		j2602243711 -> j3376922598;
	j4110453352 [label="Monsieur Loid ist, wie sagt man, distanziert ?",shape=box,color=blue];
		j4110453352 -> j1935864067;
		j4110453352 -> j4125726714;
	j4476801 [label="Hat man tausende von Jahren die Verantwortung, fängt man an sich zu ... langweilen. Langeweile erschafft komplizierte Systeme.",shape=box,color=red];
		j4476801 -> j1585970658;
	j1201368911 [label="Sie hatten eine Vorliebe für das Verzierte und Komplizierte, und das galt auch für die Bürokratie.",shape=box,color=red];
		j1201368911 -> j1585970658;
	j3376922598 [label="Ehrlich? Ich fange an, das zu glauben.",shape=box,color=red];
		j3376922598 -> j1585970658;
	j1935864067 [label="Ich weiß nichts über ihn, wirklich.",shape=box,color=red];
		j1935864067 -> j3138771294;
	j4125726714 [label="Er ist ein bisschen reserviert, ja.",shape=box,color=red];
		j4125726714 -> j3138771294;
	j1585970658 [label="+10 Chemistry",color=orange];
		j1585970658 -> j2868773144;
	j3138771294 [label="Schau, mit wem ich meine Zeit verbringe, oui ? Wenn du weißt, eine Statue zu lesen, ist es nicht allzu schwer, eine andere ebenfalls zu lesen.",shape=box,color=blue];
		j3138771294 -> j421070868;
	j2868773144 [label="Ich glaube, sie haben es nur getan, um lästig zu sein !",shape=box,color=blue];
		j2868773144 -> j1451255618;
	j421070868 [label="+10 Chemistry",color=orange];
		j421070868 -> j1596015576;
	j1451255618 [label="Et ils se demandent pourquoi des rébellions éclatent. Vous aviez peut-être vos warframes, mais nous avions nos guillotines !",shape=box,color=blue];
		j1451255618 -> j3566713005;
	j1596015576 [label="Obwohl ich zugeben muss, dass Monsieur Loid ein bisschen ... piquant ist als der liebe Lyon.",shape=box,color=blue];
		j1596015576 -> j4131402859;
		j1596015576 -> j1155140496;
	j3566713005 [label="Vive la révolution !",shape=box,color=blue];
		j3566713005 -> j393444504;
		j3566713005 -> j2381062626;
		j3566713005 -> j794493291;
	j4131402859 [label="Er hat seine Gründe.",shape=box,color=red];
		j4131402859 -> j3289374553;
	j1155140496 [label="Wie auch immer ... Was war deine Frage?",shape=box,color=red];
		j1155140496 -> j641510640;
	j393444504 [label="Sollte ich mir Sorgen machen?",shape=box,color=red];
		j393444504 -> j410903739;
	j2381062626 [label="Vive la révolution! Glaube ich.",shape=box,color=red];
		j2381062626 -> j2128190730;
	j794493291 [label="Ich bin nicht ganz sicher, was gerade passiert ist, aber ich denke, ich stimme zu?",shape=box,color=red];
		j794493291 -> j2128190730;
	j3289374553 [label="Ja, die hat er sicherlich.",shape=box,color=blue];
		j3289374553 -> j164350293;
	j641510640 [label="Ah ! Ja.",shape=box,color=blue];
		j641510640 -> j164350293;
	j410903739 [label="Kümmere dich nicht um mich, ich mache nur ein bisschen Spaß. Dumme kleine Marie, la révolutionnaire.",shape=box,color=blue];
		j410903739 -> j678158581;
	j2128190730 [label="+10 Chemistry",color=orange];
		j2128190730 -> j410903739;
	j164350293 [label="Ich fürchte, ich habe völlig vergessen, was ich dich jetzt hier fragen wollte ! Ha ! Na ja. Es wird mir wieder einfallen.",shape=box,color=blue];
		j164350293 -> j783185183;
	j678158581 [label="Vielen Dank für die Antwort auf meine Frage. Ich sollte dich nun deines Weges gehen lassen.",shape=box,color=blue];
		j678158581 -> j783185183;
	j783185183 [label="Ich entschuldige mich, deinen Tag unterbrochen zu haben. Oder Abend. Oder wann auch immer es ist, wann und wo auch immer du dich befindest.",shape=box,color=blue];
		j783185183 -> j4101990552;
	j4101990552 [label="À la revoyure !",shape=box,color=blue];
		j4101990552 -> "Chat ends.";
