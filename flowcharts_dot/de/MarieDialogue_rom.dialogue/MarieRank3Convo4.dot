		1255 -> 1257;
	1253 [label="+10 Chemistry",color=orange];
		1253 -> 1256;
	1257 [label="Schau, mit wem ich meine Zeit verbringe, oui ? Wenn du weißt, eine Statue zu lesen, ist es nicht allzu schwer, eine andere ebenfalls zu lesen.",shape=box,color=blue];
		1257 -> 1259;
	1256 [label="Ich glaube, sie haben es nur getan, um lästig zu sein !",shape=box,color=blue];
