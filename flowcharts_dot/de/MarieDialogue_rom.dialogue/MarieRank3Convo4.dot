		1252 -> 1254;
		1252 -> 1255;
	1249 [label="Hat man tausende von Jahren die Verantwortung, fängt man an sich zu ... langweilen. Langeweile erschafft komplizierte Systeme.",shape=box,color=red];
		1249 -> 1253;
	1250 [label="Sie hatten eine Vorliebe für das Verzierte und Komplizierte, und das galt auch für die Bürokratie.",shape=box,color=red];
