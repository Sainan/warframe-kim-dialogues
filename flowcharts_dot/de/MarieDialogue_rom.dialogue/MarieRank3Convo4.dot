		1270 -> 1272;
	1267 [label="Kümmere dich nicht um mich, ich mache nur ein bisschen Spaß. Dumme kleine Marie, la révolutionnaire.",shape=box,color=blue];
		1267 -> 1271;
	1268 [label="+10 Chemistry",color=orange];
		1268 -> 1267;
	1272 [label="Ich fürchte, ich habe völlig vergessen, was ich dich jetzt hier fragen wollte ! Ha ! Na ja. Es wird mir wieder einfallen.",shape=box,color=blue];
