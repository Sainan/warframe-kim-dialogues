		1239 -> 1243;
	1240 [label="Das Reich der Orokin wird so genannt, weil es von den Orokin regiert wurde, aber Orokin war auch nur der Name der herrschenden Klasse.",shape=box,color=red];
		1240 -> 1243;
	1244 [label="+10 Chemistry",color=orange];
		1244 -> 1248;
	1245 [label="Ich bin nur ein wenig überrascht, dass du jetzt mehr über ihn weißt als ich.",shape=box,color=red];
