		j3979133402 -> j1624197565 [label=true,color=green];
		j3979133402 -> j1573294803 [label=false,color=brown];
	j2751201669 [label="Wolf ! Mein Wolf ! Ich habe Otak getroffen ! Ich habe ihn endlich getroffen !",shape=box,color=blue];
		j2751201669 -> j3752727874;
		j2751201669 -> j1516080566;
	j208310047 [label="Ich habe Otak getroffen ! Ich habe ihn endlich getroffen !",shape=box,color=blue];
		j208310047 -> j3752727874;
		j208310047 -> j1516080566;
	j1624197565 [label="Wolf ! Mein Wolf ! Das Gesicht auf dem Rücken von Monsieur Necraloid ! Ich habe ihn endlich getroffen !",shape=box,color=blue];
		j1624197565 -> j121293818;
		j1624197565 -> j1145453482;
		j1624197565 -> j891540447;
	j1573294803 [label="Das Gesicht auf dem Rücken von Monsieur Necraloid ! Ich habe ihn endlich getroffen !",shape=box,color=blue];
		j1573294803 -> j121293818;
		j1573294803 -> j1145453482;
		j1573294803 -> j891540447;
	j3752727874 [label="Hast du dich gerne mit ihm unterhalten?",shape=box,color=red];
		j3752727874 -> j2615205935;
	j1516080566 [label="Wie ist das Gespräch mit ihm verlaufen?",shape=box,color=red];
		j1516080566 -> j3913172831;
	j121293818 [label="Armer Otak ... Wie ist das gelaufen?",shape=box,color=red];
		j121293818 -> j3883674983;
	j1145453482 [label="Ich freue mich, dass ihr euch endlich kennengelernt habt. Otak ist manchmal etwas schwer zu erklären.",shape=box,color=red];
		j1145453482 -> j3529116870;
	j891540447 [label="Du hast Otak kennengelernt? Auweia ... Wie ist es gelaufen?",shape=box,color=red];
		j891540447 -> j3455104900;
	j2615205935 [label="Habe ich. Obwohl ich vielleicht lieber geweint hätte. Er hat sich mir dreimal im gleichen Gespräch vorgestellt, als wären wir uns bisher nicht vorgestellt worden.",shape=box,color=blue];
		j2615205935 -> j1151068744;
	j3913172831 [label="Er ... hat sich mir dreimal im gleichen Gespräch vorgestellt, als wären wir uns bisher nicht vorgestellt worden.",shape=box,color=blue];
		j3913172831 -> j1151068744;
	j3883674983 [label="Er war einfach nur liebenswürdig und charmant ! Aber unter einer dicken Schicht Humor, verbirgt sich ein tiefer Schmerz.",shape=box,color=blue];
		j3883674983 -> j1898518022;
	j3529116870 [label="Ja, das kann ich mir vorstellen. Kinder-Gekritzel auf dem Rücken eines Automatons. Er war einfach nur liebenswürdig und charmant !",shape=box,color=blue];
		j3529116870 -> j2333346273;
	j3455104900 [label="Warum bist du nicht erfreut darüber, dass ich ihn getroffen habe ?",shape=box,color=blue];
		j3455104900 -> j1150175047;
		j3455104900 -> j3323163161;
		j3455104900 -> j1112100810;
	j1151068744 [label="Er hat mich auf dieselbe unerschrockene, fröhliche Art begrüßt, wie auch schon vorher. Aber er kannte mich als eine Sœur de Sol !",shape=box,color=blue];
		j1151068744 -> j478954881;
	j1898518022 [label="Erzählst du mir die Geschichte des armen Monsieur Otak ?",shape=box,color=blue];
		j1898518022 -> j2070340921;
	j2333346273 [label="Aber unter einer dicken Schicht Humor, verbirgt sich ein tiefer Schmerz.",shape=box,color=blue];
		j2333346273 -> j1898518022;
	j1150175047 [label="Er geht mir manchmal einfach auf die Nerven, das ist alles.",shape=box,color=red];
		j1150175047 -> j3760032771;
	j3323163161 [label="So sollte es nicht klingen. Er kann für manche nur etwas ... entmutigend wirken.",shape=box,color=red];
		j3323163161 -> j619838904;
	j1112100810 [label="Tut mir leid. Er kann Leuten manchmal auf die Nerven gehen. Es ist nicht seine Schuld.",shape=box,color=red];
		j1112100810 -> j619838904;
	j478954881 [label="Tatsächlich wusste er viel über die Himmlischen ! Wir haben lange über \"alte Religionen\" gesprochen, wie er sie nannte, in den \"Tagen vor Imperium der Orokin\".",shape=box,color=blue];
		j478954881 -> j144714877;
	j2070340921 [label="Otak war einst ein Archimede, Wissenschaftler und Akademiker der Orokin. Was ihm widerfahren ist, ist nicht gerade eine schöne Geschichte.",shape=box,color=red];
		j2070340921 -> j4234482805;
	j3760032771 [label="Ich wünschte mir, du versuchst freundlicher zu jemandem zu sein, der ganz klar infirme ist. Mais par la grâce de Sol, gehen wir alle unseren Weg.",shape=box,color=blue];
		j3760032771 -> j2059904703;
	j619838904 [label="Und ich hoffe, dass man ihm Freundlichkeit und Geduld entgegenbringt. Mais par la grâce de Sol gehen wir alle unseren Weg.",shape=box,color=blue];
		j619838904 -> j2059904703;
	j144714877 [label="Obwohl er sagte, dass viel von diesem Wissen inzwischen verloren ist, tief in den Archiven und strengstens verboten. Er verpflichtete mich zur Geheimhaltung.",shape=box,color=blue];
		j144714877 -> j3456720106;
	j4234482805 [label="Er war allem Anschein nach ein Genie und der Kopf hinter der Nutzung von Argon-Kristallen.",shape=box,color=red];
		j4234482805 -> j3379699656;
	j2059904703 [label="Ein solches Schicksal könnte auf jeden von uns warten. Sogar auf dich.",shape=box,color=blue];
		j2059904703 -> j2667682692;
		j2059904703 -> j876827764;
	j3456720106 [label="Er sagte mir, er sei zutiefst besorgt, dass Exekutor Ballas - wer auch immer das sein mag - meine Sekte an Ketzern entdecken und mich hinrichten lassen könnte.",shape=box,color=blue];
		j3456720106 -> j497608976;
		j3456720106 -> j1666436763;
	j3379699656 [label="Die aus dem Void gewonnen werden – sie sind der Grund, warum wir viele der mächtigen Warframes und Waffen erschaffen können, die wir herstellen.",shape=box,color=red];
		j3379699656 -> j3767661121;
	j2667682692 [label="Du hast recht, es tut mir leid. So habe ich das nicht gemeint.",shape=box,color=red];
		j2667682692 -> j1898518022;
	j876827764 [label="Ich kann einfach keine Zeit für ihn aufwenden, es tut mir leid.",shape=box,color=red];
		j876827764 -> j1323736917;
	j497608976 [label="Ballas ist tot ... sprich weiter.",shape=box,color=red];
		j497608976 -> j3871259561;
	j1666436763 [label="Das ... wird nicht passieren. Sprich weiter.",shape=box,color=red];
		j1666436763 -> j3871259561;
	j3767661121 [label="Er spezialisierte sich auf Kristallographie. Und seine Arbeiten wurden hier in den Laboren archiviert.",shape=box,color=red];
		j3767661121 -> j3455374278;
	j1323736917 [label="Dann tut es mir leid, dass ich noch mehr deiner Zeit verschwendet habe.",shape=box,color=blue];
		j1323736917 -> j3007723528;
	j3871259561 [label="+5 Chemistry",color=orange];
		j3871259561 -> j967539501;
	j3455374278 [label="Aus irgendeinem Grund, ich weiß nicht warum, wurde er in ein Cephalon verwandelt und erhielt seine eigene Nekraloid-Hülle.",shape=box,color=red];
		j3455374278 -> j2764155903;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j967539501 [label="Habe ich schon vermutet ... Also, er fragte, wo ich herkomme und als ich es ihm sage, hat er gelacht und gesagt \"Nein, das ist unmöglich! Ich weiß das schließlich, ich bin -\"",shape=box,color=blue];
		j967539501 -> j2253817768;
	j2764155903 [label="Nicht alle Cephalons wurden als Bestrafung erschaffen. Aber hier auf Deimos lief es ... nicht gut, und er wurde schwer beschädigt.",shape=box,color=red];
		j2764155903 -> j4130637993;
	j2253817768 [label="Und dann ... stellte er sich mir wieder vor. Und fragte mich, ob ich mit Mineralienproben aus den Ebenen zurückkäme ...",shape=box,color=blue];
		j2253817768 -> j2663596736;
		j2253817768 -> j1320925084;
	j4130637993 [label="Pauvre petit ...",shape=box,color=blue];
		j4130637993 -> j253530729;
	j2663596736 [label="Ja ... das ist Otak.",shape=box,color=red];
		j2663596736 -> j584749793;
	j1320925084 [label="Oh Marie. Es tut mir so leid ...",shape=box,color=red];
		j1320925084 -> j584749793;
	j253530729 [label="Boolean MarieOtak1 is now true.",color=orange];
		j253530729 -> j3752727874;
		j253530729 -> j1516080566;
	j584749793 [label="Es zerreißt mich förmlich daran zu denken, dass man nichts mehr für ihn tun kann.",shape=box,color=blue];
		j584749793 -> j457335464;
	j457335464 [label="Evaluate expressions",color=orange];
		j457335464 -> j2682431092 [label="MarieCephalonSoul",color=purple];
		j457335464 -> j773325974 [label="MarieCephalonNoSoul",color=purple];
		j457335464 -> j1707410313 [label="MarieCephalonUnsure",color=purple];
		j457335464 -> j603050612 [label="false",color=purple];
	j2682431092 [label="Oh Himmlische - was für eine Hölle habt ihr für ihn geschaffen, dass ihr seine Seele in diesem Käfig aus Wissenschaft und flackernden Lichtern gefangen haltet ?",shape=box,color=blue];
		j2682431092 -> j2600814913;
	j773325974 [label="Ich kann nur zu den Himmlischen beten, dass du recht hast und nichts in dieser Hülle übrig ist, außer ... Wissenschaft und flackernde Lichter.",shape=box,color=blue];
		j773325974 -> j3260508973;
	j1707410313 [label="Ich weiß, dass du dir nicht sicher bist, ob Cephalons Seelen haben - aber ich kann nur zu den Himmlischen beten, dass ... der arme Otak nicht leidet.",shape=box,color=blue];
		j1707410313 -> j2393035668;
	j603050612 [label="Ich kann nur zu den Himmlischen beten, dass in dieser Hülle nichts anderes übrig ist als ... Wissenschaft und flackernde Lichter.",shape=box,color=blue];
		j603050612 -> j526077176;
	j2600814913 [label="Warum habt ihr ihn dort zurückgelassen, zerbrochen und wartend, bis er sterben darf, um Frieden zu finden ? Ich kann nur beten ... dass, sollte es dort drin eine Art von Präsenz geben -",shape=box,color=blue];
		j2600814913 -> j3409752032;
	j3260508973 [label="Und dass es keine Seele ist, die in diesem kaputten Ding gefangen ist, die nur darauf wartet, dass sie endlich sterben darf, um Frieden zu finden.",shape=box,color=blue];
		j3260508973 -> j1324445216;
	j2393035668 [label="Dass es keine Seele ist, die in diesem kaputten Ding gefangen ist, die nur darauf wartet, dass sie endlich sterben darf, um Frieden zu finden.",shape=box,color=blue];
		j2393035668 -> j2937567941;
	j526077176 [label="Und dass es keine Seele ist, die in diesem kaputten Ding gefangen ist, die nur darauf wartet, dass sie endlich sterben darf, um Frieden zu finden.",shape=box,color=blue];
		j526077176 -> j2937567941;
	j3409752032 [label="- dass sie freiwillig dort ist, als eine Art einsame Wache ...",shape=box,color=blue];
		j3409752032 -> j3662370697;
	j1324445216 [label="Denn, wenn du falsch liegst und wirklich eine Seele gegen ihren Willen in diesem Käfig verbleibt ?",shape=box,color=blue];
		j1324445216 -> j4194330909;
	j2937567941 [label="Oder sollte es noch eine Art Präsenz geben, dass sie freiwillig dort ist, als eine Art einsame Wache.",shape=box,color=blue];
		j2937567941 -> j3662370697;
	j3662370697 [label="Alles andere wäre genug, die Güte der Götter infrage zu stellen, non ?",shape=box,color=blue];
		j3662370697 -> j3290036952;
	j4194330909 [label="Dann ist das genug, die Güte der Götter infrage zu stellen, non ?",shape=box,color=blue];
		j4194330909 -> j3290036952;
	j3290036952 [label="Und wo würde ich dann bleiben ?",shape=box,color=blue];
		j3290036952 -> j1918493692;
	j1918493692 [label="Verzeiht mir, ich bin ... ich bin heute melancholisch.",shape=box,color=blue];
		j1918493692 -> j3251038745;
	j3251038745 [label="Evaluate expressions",color=orange];
		j3251038745 -> j4173813198 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j38574399 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j280094659 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j1066960274 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j4173813198 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j38574399 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j280094659 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j1066960274 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j4173813198 [label="false",color=purple];
		j3251038745 -> j38574399 [label="false",color=purple];
		j3251038745 -> j1066960274 [label="false",color=purple];
	j4173813198 [label="Schon ok. Dazu hast du jedes Recht.",shape=box,color=red];
		j4173813198 -> j8721011;
	j38574399 [label="Kann ich dich irgendwie aufmuntern? Wir könnten Roathe ärgern gehen.",shape=box,color=red];
		j38574399 -> j2333064057;
	j280094659 [label="Kann ich dich irgendwie aufmuntern? Vielleicht etwas Gebäck stibitzen?",shape=box,color=red];
		j280094659 -> j3550114339;
	j1066960274 [label="Manchmal sind Götter grausam, Marie. So ist das Leben.",shape=box,color=red];
		j1066960274 -> j254757486;
	j8721011 [label="+20 Chemistry",color=orange];
		j8721011 -> j3579641538;
	j2333064057 [label="+15 Chemistry",color=orange];
		j2333064057 -> j1612395726;
	j3550114339 [label="+20 Chemistry",color=orange];
		j3550114339 -> j1612395726;
	j254757486 [label="+5 Chemistry",color=orange];
		j254757486 -> j1842080451;
	j3579641538 [label="Merci. Nun, ich möchte es nicht länger sein. Ich werde etwas Erfreulicheres tun ! Ich glaube, M'sieur Fibonaccis Behälter sollte mal wieder abgestaubt werden.",shape=box,color=blue];
		j3579641538 -> j2486340526;
	j1612395726 [label="Ha ! Merci. Damit trocknest du meine dummen Tränen bestimmt. Du weißt genau, wie man die dumme kleine Marie aufmuntert, non ?",shape=box,color=blue];
		j1612395726 -> j3392522392;
		j1612395726 -> j2289069503;
	j1842080451 [label="Oui. Du hast ja recht. Das sind sie. Die Welt ist voller Geschichten, wie der von Monsieur Otak und viele sind schlimmer als seine. Ich sollte wegen einer nicht weinen.",shape=box,color=blue];
		j1842080451 -> j1296270896;
	j2486340526 [label="Check boolean MarieDating",color=orange];
		j2486340526 -> j1090427720 [label=true,color=green];
		j2486340526 -> j1783435543 [label=false,color=brown];
	j3392522392 [label="Das ist das Mindeste, was ich für dich tun kann.",shape=box,color=red];
		j3392522392 -> j1350233930;
	j2289069503 [label="Du bist nicht dumm, gar nicht. Ich fühle mich genauso.",shape=box,color=red];
		j2289069503 -> j1350233930;
	j1296270896 [label="Und trotzdem sitze ich hier und tue genau das. Danke, dass du mich an meine Dummheit erinnerst. Fie ! Dumme kleine Marie. Naja ... ich glaube M’sieur Fibonaccis Behälter sollte mal wieder abgestaubt werden.",shape=box,color=blue];
		j1296270896 -> j2486340526;
	j1090427720 [label="À la revoyure, mein Wolf.",shape=box,color=blue];
		j1090427720 -> j3007723528;
	j1783435543 [label="À la revoyure !",shape=box,color=blue];
		j1783435543 -> j3007723528;
	j1350233930 [label="+5 Chemistry",color=orange];
		j1350233930 -> j4058209286;
	j4058209286 [label="Check boolean MarieDating",color=orange];
		j4058209286 -> j1161940765 [label=true,color=green];
		j4058209286 -> j2079033712 [label=false,color=brown];
	j1161940765 [label="Merci, merci, merci, mein Wolf. Dann lass uns gehen und Unfug anstellen.",shape=box,color=blue];
		j1161940765 -> j3007723528;
	j2079033712 [label="Merci, merci, merci. Dann lass uns gehen und Unfug anstellen.",shape=box,color=blue];
		j2079033712 -> j3007723528;
