	j1701554180 [label="Die Gabe, einander zum Lachen zu bringen. Zum Weinen. Einander von Wahrheit oder Lüge zu überzeugen. Meinungen zu ändern. Trotz Schmerz einander aufzumuntern. Einander in Torheit zu verletzen.",shape=box,color=blue];
