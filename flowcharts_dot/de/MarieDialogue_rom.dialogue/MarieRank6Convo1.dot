	j1854293193 [label="Mon cœur ! Hast du einen Moment ? Ich würde gerne mit dir reden, falls du Zeit hast.",shape=box,color=blue];
		j1854293193 -> j267631886;
		j1854293193 -> j129698615;
	j3482225371 [label="Mein liebster Schatz ! Hast du einen Moment Zeit, mit mir zu sprechen ?",shape=box,color=blue];
		j3482225371 -> j1721728147;
		j3482225371 -> j129698615;
	j77224598 [label="Teufelsbändiger ! Hast du einen Moment Zeit, mit mir zu sprechen ?",shape=box,color=blue];
		j77224598 -> j247903639;
		j77224598 -> j129698615;
	j32208496 [label="Hast du einen Moment ? Ich würde gerne mit dir reden, falls du Zeit hast.",shape=box,color=blue];
		j32208496 -> j3376820364;
		j32208496 -> j129698615;
	j2857106949 [label="Hast du einen Moment ? Ich würde gerne mit dir reden, falls du Zeit hast.",shape=box,color=blue];
		j2857106949 -> j3298044252;
		j2857106949 -> j2867793141;
		j2857106949 -> j129698615;
	j267631886 [label="Für dich, immer. Was gibt's?",shape=box,color=red];
		j267631886 -> j569094021;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j1721728147 [label="Jederzeit. Was gibt's?",shape=box,color=red];
		j1721728147 -> j3684988887;
	j247903639 [label="He. Ich bin mir nicht sicher, ob er gebändigt ist. Worum geht's?",shape=box,color=red];
		j247903639 -> j2749105786;
	j3376820364 [label="Für dich, immer. Was gibt's?",shape=box,color=red];
		j3376820364 -> j1864957210;
	j3298044252 [label="Natürlich, was gibt's?",shape=box,color=red];
		j3298044252 -> j2308188459;
	j2867793141 [label="[Gefühle gestehen.] Gutes Timing, ich wollte auch etwas loswerden ...",shape=box,color=red];
		j2867793141 -> j2064453539;
	j569094021 [label="Ich denke darüber nach, wie viel Zeit wir miteinander verbracht haben. Wie wenig es war, im Vergleich zu all den Jahren, die du gelebt hast.",shape=box,color=blue];
		j569094021 -> j961266457;
	"Chat ends." [color=orange];
	j3684988887 [label="Deine Freundschaft ist so gut und lieb. Ein Verbündeter, um den ich nicht einmal hätte beten können.",shape=box,color=blue];
		j3684988887 -> j1550207412;
	j2749105786 [label="Oui, und ich glaube, das ist dir lieber so, non ? Ha ! So will ich mir den Teufel gar nicht vorstellen – egal ! Deshalb bin ich nicht hier.",shape=box,color=blue];
		j2749105786 -> j3470333215;
	j1864957210 [label="Evaluate expressions",color=orange];
		j1864957210 -> j4111907318 [label="RoatheDating",color=purple];
		j1864957210 -> j4111907318 [label="LyonDating",color=purple];
		j1864957210 -> j741933451 [label="IsDating",color=purple];
		j1864957210 -> j4211117453 [label="false",color=purple];
	j2308188459 [label="Ich denke darüber nach, wie viel Zeit wir miteinander verbracht haben. Wie wenig es war, im Vergleich zu all den Jahren, die du gelebt hast.",shape=box,color=blue];
		j2308188459 -> j2075261964;
	j2064453539 [label="Non, lass mich zuerst reden, sonst verliere ich den Mut !",shape=box,color=blue];
		j2064453539 -> j1471879296;
	j961266457 [label="Aber ich denke daran, wie viel es mir bedeutet. Wie sehr diese Zeit mich und den Verlauf meines Lebens verändert hat, wie bei einem Schiff auf hoher See.",shape=box,color=blue];
		j961266457 -> j359126861;
	j1550207412 [label="Evaluate expressions",color=orange];
		j1550207412 -> j2432308694 [label="LyonFaith3Yes",color=purple];
		j1550207412 -> j666948661 [label="LyonFaith3No",color=purple];
		j1550207412 -> j1364539202 [label="LyonFaith3Maybe",color=purple];
	j3470333215 [label="Evaluate expressions",color=orange];
		j3470333215 -> j1282402543 [label="LoidFamilyComplete",color=purple];
		j3470333215 -> j421896480 [label="RoatheRedeemed",color=purple];
		j3470333215 -> j1451367569 [label="RoatheVillain",color=purple];
		j3470333215 -> j1885924404 [label="RoatheHellComplete",color=purple];
		j3470333215 -> j600164848 [label="false",color=purple];
	j4111907318 [label="Ich weiß, du hast einmal gesagt, du hast Gefühle für mich. Und nun sehe ich dich mit jemand anderem. Ich wollte dir nur sagen, dass ich mich für dich freue !",shape=box,color=blue];
		j4111907318 -> j2617554350;
	j741933451 [label="Du hast mir einmal gesagt, dass du ... ach, ich weiß gar nicht, wie ich es ausdrücken soll. Dass du Gefühle für mich hast. Doch ich weiß, dass da noch jemand anderes ist.",shape=box,color=blue];
		j741933451 -> j3752633378;
		j741933451 -> j265096969;
	j4211117453 [label="Du hast mir einmal gesagt, dass du ... ach, ich weiß gar nicht, wie ich es ausdrücken soll. Dass du Gefühle für mich hast.",shape=box,color=blue];
		j4211117453 -> j1928846357;
	j2075261964 [label="Aber ich denke daran, wie viel es mir bedeutet. Wie sehr diese Zeit mich und den Verlauf meines Lebens verändert hat, wie bei einem Schiff auf hoher See.",shape=box,color=blue];
		j2075261964 -> j3753754528;
	j1471879296 [label="Evaluate expressions",color=orange];
		j1471879296 -> j3533675119 [label="MarieNoDate",color=purple];
		j1471879296 -> j2664814580 [label="MarieWillDate",color=purple];
		j1471879296 -> j3533675119 [label="false",color=purple];
	j359126861 [label="Und ich frage mich, ob es das ist, was die Gleichgültigkeit zerstören will ? Ist es das, was die Gleichgültigkeit verzehrt ? Die Macht jener, andere zu beeinflussen ?",shape=box,color=blue];
		j359126861 -> j4176498166;
	j2432308694 [label="Du hast meinem Seelenbruder solchen Frieden geschenkt. Du hast ihn davon überzeugt, dass wir einen wahren Feind zu bekämpfen haben – und ihm Hoffnung gegeben.",shape=box,color=blue];
		j2432308694 -> j1939745555;
	j666948661 [label="Du hast meinem Seelenbruder Trost und Frieden geschenkt, wo er zuvor keinen hatte. Ich glaube, deine Gesellschaft bedeutet ihm mehr, als er ausdrücken kann.",shape=box,color=blue];
		j666948661 -> j1939745555;
	j1364539202 [label="Auch wenn wir die wahre Natur dieser Gleichgültigkeit vielleicht nie ganz ergründen werden, wissen wir, dass es letztendlich keine Rolle spielt. Wir müssen uns der Herausforderung stellen, die sie darstellt – und die ist real.",shape=box,color=blue];
		j1364539202 -> j1939745555;
	j1282402543 [label="Ich hätte nicht gedacht, dass sich unser Teufel dazu bewegen ließe, Monsieur Loid und le Cardinals Familie bei der Versöhnung zu helfen. Ich weiß, seine Gründe sind ... zweifelhaft, und ich traue ihm immer noch nicht ganz.",shape=box,color=blue];
		j1282402543 -> j3519975275;
	j421896480 [label="Ich hätte nie gedacht, dass unser Teufel seine Fehler einsehen könnte. Dass er überhaupt Reue für die unschuldigen Leben empfinden könnte, die er ausgelöscht hat. Du hast mich eines Besseren belehrt.",shape=box,color=blue];
		j421896480 -> j1932277570;
	j1451367569 [label="Womit auch immer du unseren Teufel gefesselt hast, es hält ihn im Zaum. Er wirkt ... gezügelter als zuvor. Und das verdanken wir dir.",shape=box,color=blue];
		j1451367569 -> j1932277570;
	j1885924404 [label="Die Erinnerungen, die er durch unsere Hilfe wiedererlangt hat, scheinen ihn geläutert zu haben. Vielleicht hat ihn die Trauer um all die, die er verlor, auch daran erinnert, wen er noch verlieren könnte.",shape=box,color=blue];
		j1885924404 -> j1932277570;
	j600164848 [label="Vielleicht ist es seine Zuneigung zu dir, die ihn so zügelt, ich weiß es nicht. Was auch immer der Grund ist, ich weiß, dass du dafür verantwortlich bist.",shape=box,color=blue];
		j600164848 -> j1932277570;
	j2617554350 [label="Ich hege keinen Groll gegen dich und nur Freude für euch beide, oui ?",shape=box,color=blue];
		j2617554350 -> j1506703180;
		j2617554350 -> j1266185436;
	j3752633378 [label="Die Dinge haben sich geändert, und ... ich muss treu bleiben, tut mir leid.",shape=box,color=red];
		j3752633378 -> j181772463;
	j265096969 [label="Es mag schwer zu glauben oder vielleicht sogar zu akzeptieren sein, ich weiß. Aber ich ... liebe dich. Und ich liebe auch diese Person. Gleichermaßen.",shape=box,color=red];
		j265096969 -> j3734127592;
	j1928846357 [label="Evaluate expressions",color=orange];
		j1928846357 -> j3288939252 [label="MarieNoDate",color=purple];
		j1928846357 -> j917137683 [label="MarieWillDate",color=purple];
		j1928846357 -> j1572015787 [label="MarieWillDate",color=purple];
		j1928846357 -> j3288939252 [label="false",color=purple];
	j3753754528 [label="Und ich frage mich, ob es das ist, was die Gleichgültigkeit zerstören will ? Ist es das, was die Gleichgültigkeit verzehrt ? Die Macht jener, andere zu beeinflussen ?",shape=box,color=blue];
		j3753754528 -> j1010642398;
	j3533675119 [label="Ich fürchte, du wirst mir gleich etwas sagen, was du nicht mehr zurücknehmen kannst. Und das wird unsere Beziehung für immer verändern.",shape=box,color=blue];
		j3533675119 -> j2450755937;
	j2664814580 [label="Mon cœur t'appartient depuis notre première rencontre ...",shape=box,color=blue];
		j2664814580 -> j890858213;
		j2664814580 -> j59730293;
	j4176498166 [label="Die Gabe, einander zum Lachen zu bringen. Zum Weinen. Einander von Wahrheit oder Lüge zu überzeugen. Die Meinung des anderen zu ändern. Einander in Schmerzen aufzumuntern. Einander in Torheit zu verletzen.",shape=box,color=blue];
		j4176498166 -> j3780024395;
	j1939745555 [label="Und was ist die Gleichgültigkeit, wenn du da bist, um Lyon durch die dunkelsten Stunden zu begleiten und ihn in seinen Momenten des Schmerzes und der agonie zu stützen ?",shape=box,color=blue];
		j1939745555 -> j927361038;
	j3519975275 [label="Die Ergebnisse sind zweifellos dir zu verdanken. Roathe ist hier und beschützt le Cardinals Familie und das alles dank dir.",shape=box,color=blue];
		j3519975275 -> j1932277570;
	j1932277570 [label="Und ich weiß, unser Teufel ist nicht unser Feind, oui ? Es ist die Gleichgültigkeit. Und was lehrt uns die Gleichgültigkeit, wenn nicht, an allem festzuhalten, was sie ablehnt, an allem, was sie zerstört ?",shape=box,color=blue];
		j1932277570 -> j2498254432;
	j1506703180 [label="Aber ... was wäre, wenn",shape=box,color=red];
		j1506703180 -> j2734875478;
	j1266185436 [label="Ich habe auch für dich Gefühle, Marie.",shape=box,color=red];
		j1266185436 -> j704568534;
	j181772463 [label="Oui, ich verstehe. Natürlich verstehe ich das ! Wie könnte ich dir vorwerfen, dass du deiner Seele folgst ?",shape=box,color=blue];
		j181772463 -> j2152028046;
	j3734127592 [label="Evaluate expressions",color=orange];
		j3734127592 -> j3288939252 [label="MarieNoDate",color=purple];
		j3734127592 -> j3037561821 [label="MarieWillDate",color=purple];
		j3734127592 -> j3288939252 [label="false",color=purple];
	j3288939252 [label="Ich weiß nicht, wie ich das sagen soll, ohne grausam zu sein, deshalb ... werde ich es einfach sagen.",shape=box,color=blue];
		j3288939252 -> j3383913449;
	j917137683 [label="Ja, habe ich. Ich ... nehme an, du empfindest nicht dasselbe?",shape=box,color=red];
		j917137683 -> j2711830741;
	j1572015787 [label="Die Dinge haben sich geändert, und ... es tut mir leid.",shape=box,color=red];
		j1572015787 -> j3955530414;
	j1010642398 [label="Die Gabe, einander zum Lachen zu bringen. Zum Weinen. Einander von Wahrheit oder Lüge zu überzeugen. Meinungen zu ändern. Trotz Schmerz einander aufzumuntern. Einander in Torheit zu verletzen.",shape=box,color=blue];
		j1010642398 -> j1451402179;
	j2450755937 [label="Und es schmerzt mich, oh, wie sehr es mich schmerzt, dich daran zu hindern, bevor du es tust.",shape=box,color=blue];
		j2450755937 -> j3817666656;
	j890858213 [label="Ich ... verstehe nicht, was das bedeutet, Marie.",shape=box,color=red];
		j890858213 -> j2803090800;
	j59730293 [label="Mon cœur t'appartient également, Marie !",shape=box,color=red];
		j59730293 -> j2856044581;
	j3780024395 [label="Sich gegenseitig Freude zu schenken, wenn man verliebt ist. Sich gegenseitig Leid zuzufügen, wenn man dem Hass verfallen ist. Das ist die Gabe der humanité – das ist, was die Gleichgültigkeit nicht ist.",shape=box,color=blue];
		j3780024395 -> j2569845521;
	j927361038 [label="Was lehrt uns die Gleichgültigkeit, ungeachtet ihrer Ursprünge, wenn nicht, an allem festzuhalten, was sie ablehnt, an allem, was sie zerstört ?",shape=box,color=blue];
		j927361038 -> j2454022779;
	j2498254432 [label="Ich denke darüber nach, wie viel Zeit wir miteinander verbracht haben. Wie wenig es war, im Vergleich zu all den Jahren, die du gelebt hast.",shape=box,color=blue];
		j2498254432 -> j3273652024;
	j2734875478 [label="Stattdessen? Dann … fürchte ich, dass du zuerst die Fäden deines eigenen Herzens entwirren musst, Drifter. Ich kann das nicht für dich tun.",shape=box,color=blue];
		j2734875478 -> j3699890413;
	j704568534 [label="Und das mag durchaus der Fall sein. Ich bin kein eifersüchtiges Wesen, aber es ist eine Sache, zu wissen, dass jemand dein Herz erobert hat, und ich denjenigen nicht kenne -",shape=box,color=blue];
		j704568534 -> j339416898;
	j2152028046 [label="+10 Chemistry",color=orange];
		j2152028046 -> j3477454658;
	j3037561821 [label="Ich – oh ! Oh, mon cœur !",shape=box,color=blue];
		j3037561821 -> j695925782;
	j3383913449 [label="Ich fürchte ... du solltest dich einfach der anderen Person zuwenden. Ich empfinde für dich nicht, was du für mich empfindest. Verzeih mir.",shape=box,color=blue];
		j3383913449 -> j1175010343;
	j2711830741 [label="Ich – oh ! Oh, mon cœur !",shape=box,color=blue];
		j2711830741 -> j639913665;
	j3955530414 [label="Oui, ich verstehe. Natürlich verstehe ich das ! Wie könnte ich dir vorwerfen, dass du deiner Seele folgst ?",shape=box,color=blue];
		j3955530414 -> j608124473;
	j1451402179 [label="Sich gegenseitig Freude zu schenken, wenn man verliebt ist. Sich gegenseitig Leid zuzufügen, wenn man dem Hass verfallen ist. Das ist die Gabe der humanité – das ist, was die Gleichgültigkeit nicht ist.",shape=box,color=blue];
		j1451402179 -> j3947871065;
	j3817666656 [label="Ich weiß nicht, wie ich das sagen soll, ohne grausam zu sein, deshalb ... werde ich es einfach sagen.",shape=box,color=blue];
		j3817666656 -> j3008847949;
	j2803090800 [label="Oui, ich weiß ! Genau das ist der Punkt ! Ich habe zu viel Angst, es zu sagen ... zu sagen, wie sehr ich dich mittlerweile mag.",shape=box,color=blue];
		j2803090800 -> j2583366958;
	j2856044581 [label="+10 Chemistry",color=orange];
		j2856044581 -> j780109846;
	j2569845521 [label="Es ist unrein und unvollkommen, aber wunderschön wie die Sterne am Himmel. Eine Milliarde kleiner Punkte, die einen Teppich aus einem Lichterozean bilden.",shape=box,color=blue];
		j2569845521 -> j4257804831;
	j2454022779 [label="Ich denke darüber nach, wie viel Zeit wir miteinander verbracht haben. Wie wenig es war, im Vergleich zu all den Jahren, die du gelebt hast.",shape=box,color=blue];
		j2454022779 -> j863031123;
	j3273652024 [label="Aber ich denke daran, wie viel es mir bedeutet. Wie sehr diese Zeit mich und den Verlauf meines Lebens verändert hat, wie bei einem Schiff auf hoher See.",shape=box,color=blue];
		j3273652024 -> j1229978353;
	j3699890413 [label="Evaluate expressions",color=orange];
		j3699890413 -> j874139835 [label="LyonDating",color=purple];
		j3699890413 -> j2771193879 [label="RoatheDating",color=purple];
	j339416898 [label="Und es ist etwas ganz anderes, wenn es sich um meinen Seelenbruder oder den Teufel handelt, mit dem ich täglich zu kämpfen habe.",shape=box,color=blue];
		j339416898 -> j343316656;
	j3477454658 [label="Möge Sol euch und eure Herzen segnen. Ich schätze mich glücklich, zu denen zu gehören, die du Freunde nennst !",shape=box,color=blue];
		j3477454658 -> j2744432123;
	j695925782 [label="Ich weiß nicht, was ich sagen soll, außer dass ich dir glaube. Und dass ich ... dasselbe empfinde. Mon cœur t'appartient depuis notre première rencontre.",shape=box,color=blue];
		j695925782 -> j225451630;
	j1175010343 [label="Aber du kannst darauf vertrauen, dass du in der kleinen Marie eine Verbündete hast, die dir bis zum Ende zur Seite steht, egal was passiert.",shape=box,color=blue];
		j1175010343 -> "Chat ends.";
	j639913665 [label="Ich weiß nicht, was ich sagen soll, außer dass ich ... Ich empfinde dasselbe. Mon cœur t'appartient depuis notre première rencontre.",shape=box,color=blue];
		j639913665 -> j225451630;
	j608124473 [label="+10 Chemistry",color=orange];
		j608124473 -> j683619050;
	j3947871065 [label="Es ist unrein und unvollkommen, aber wunderschön wie die Sterne am Himmel. Eine Milliarde kleiner Punkte, die einen Teppich aus einem Lichterozean bilden.",shape=box,color=blue];
		j3947871065 -> j890915509;
	j3008847949 [label="Was du für mich empfindest, empfinde ich nicht für dich. Verzeih mir.",shape=box,color=blue];
		j3008847949 -> j1175010343;
	j2583366958 [label="Mon cœur t'appartient depuis notre première rencontre.",shape=box,color=blue];
		j2583366958 -> j225451630;
	j780109846 [label="Ah ! Wo hast du das gelernt ?! Lyon ?! Ach, egal ! Oh, mein Wolf !",shape=box,color=blue];
		j780109846 -> j225451630;
	j4257804831 [label="Es ist alles Detail ohne précision, oui ? Wen kümmert es, woher das kommt ... es ist, was wir sind.",shape=box,color=blue];
		j4257804831 -> j3375154058;
	j863031123 [label="Aber ich denke daran, wie viel es mir bedeutet. Wie sehr diese Zeit mich und den Verlauf meines Lebens verändert hat, wie bei einem Schiff auf hoher See.",shape=box,color=blue];
		j863031123 -> j2134887357;
	j1229978353 [label="Und ich frage mich, ob es das ist, was die Gleichgültigkeit zerstören will ? Ist es das, was die Gleichgültigkeit verzehrt ? Die Macht jener, andere zu beeinflussen ?",shape=box,color=blue];
		j1229978353 -> j1502195112;
	j874139835 [label="Ich hoffe nur, dass du Lyon nicht in die Irre führst oder ihn unnötig verletzt. Unter seiner harten Schale ist er sehr zerbrechlich.",shape=box,color=blue];
		j874139835 -> j2696583273;
	j2771193879 [label="Ich möchte nicht, dass Roathe leidet, so sehr ich ihn auch ärgere und belehre. Verletze ihn nicht, wenn du es vermeiden kannst.",shape=box,color=blue];
		j2771193879 -> j2696583273;
	j343316656 [label="Ich könnte mich mit dem Gedanken anfreunden, dich mit jemand anderem zu teilen – aber mit Familie oder einem Feind ? Ich glaube, das ist zu viel für mich.",shape=box,color=blue];
		j343316656 -> j2036618318;
		j343316656 -> j534220844;
	j2744432123 [label="Und du kannst darauf vertrauen, dass du in der kleinen Marie eine Freundin hast, die dir bis zum Ende zur Seite steht, egal was passiert.",shape=box,color=blue];
		j2744432123 -> "Chat ends.";
	j225451630 [label="Ich denke darüber nach, wie viel Zeit wir miteinander verbracht haben. Wie wenig es war, im Vergleich zu all den Jahren, die du gelebt hast.",shape=box,color=blue];
		j225451630 -> j2750662632;
	j683619050 [label="Ich schätze mich glücklich, zu denen zu gehören, die du Freunde nennst !",shape=box,color=blue];
		j683619050 -> j2744432123;
	j890915509 [label="Es ist alles Detail ohne précision, oui ? Wen kümmert es, woher das kommt ... es ist, was wir sind.",shape=box,color=blue];
		j890915509 -> j663042185;
	j3375154058 [label="Und es ist alles das, was du mit mir teilst, oui ?",shape=box,color=blue];
		j3375154058 -> j3042341930;
	j2134887357 [label="Und ich frage mich, ob es das ist, was die Gleichgültigkeit zerstören will ? Ist es das, was die Gleichgültigkeit verzehrt ? Die Macht jener, andere zu beeinflussen ?",shape=box,color=blue];
		j2134887357 -> j1701554180;
	j1502195112 [label="Die Gabe, einander zum Lachen zu bringen. Zum Weinen. Einander von Wahrheit oder Lüge zu überzeugen. Meinungen zu ändern. Trotz Schmerz einander aufzumuntern. Einander in Torheit zu verletzen.",shape=box,color=blue];
		j1502195112 -> j3554760136;
	j2696583273 [label="Ich möchte niemandem schaden und ich werde nicht \"die Andere\" im Leid eines anderen sein. Und solltest du etwas stärker für mich empfinden, auf Kosten anderer?",shape=box,color=blue];
		j2696583273 -> j841037284;
	j2036618318 [label="Das respektiere ich.",shape=box,color=red];
		j2036618318 -> j3433005135;
	j534220844 [label="Aber ...",shape=box,color=red];
		j534220844 -> j665558782;
	j2750662632 [label="Aber ich denke daran, wie viel es mir bedeutet. Wie sehr diese Zeit mich und den Verlauf meines Lebens verändert hat, wie bei einem Schiff auf hoher See.",shape=box,color=blue];
		j2750662632 -> j493270847;
	j663042185 [label="Und genau das möchte ich mit dir mit Stolz teilen, meiner Freundschaft, meiner liebsten Freundschaft.",shape=box,color=blue];
