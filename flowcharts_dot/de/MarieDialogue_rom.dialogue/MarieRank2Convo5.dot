digraph {
	"MarieRank2Convo5 begins." [color=orange];
		"MarieRank2Convo5 begins." -> j1631090094;
	j1631090094 [label="Evaluate expressions",color=orange];
		j1631090094 -> j1103729250 [label="MarieOtak1",color=purple];
		j1631090094 -> j1395399582 [label="MarieFamily1",color=purple];
		j1631090094 -> j1679940128 [label="false",color=purple];
	j1103729250 [label="Ich habe darüber nachgedacht, was du mir über Monsieur Otak erzählt hast.",shape=box,color=blue];
		j1103729250 -> j3968313545;
	j1395399582 [label="Ich habe darüber nachgedacht, was du mir über die Familie von le Cardinal erzählt hast.",shape=box,color=blue];
		j1395399582 -> j2468658905;
	j1679940128 [label="Ich habe immer noch eine Frage zu Monsieur \"Necraloid\", wenn ich darf?",shape=box,color=blue];
		j1679940128 -> j2943650129;
		j1679940128 -> j129698615;
	j3968313545 [label="Ich habe mich gefragt, ob es vielleicht einer meiner eigenen Geschichten ähnelt. Darf ich sie dir erzählen, falls du Zeit hast?",shape=box,color=blue];
		j3968313545 -> j1046215755;
		j3968313545 -> j129698615;
	j2468658905 [label="Ich habe mich gefragt, ob du mir die Geschichte von Otak erzählen kannst, dem kindlichen Gesicht auf der Rückseite von Necraloids Schädel?",shape=box,color=blue];
		j2468658905 -> j2246915268;
		j2468658905 -> j2023988374;
	j2943650129 [label="Ja natürlich, was ist die Frage?",shape=box,color=red];
		j2943650129 -> j1322543334;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j1046215755 [label="Ich höre.",shape=box,color=red];
		j1046215755 -> j1337125731;
	j2246915268 [label="Sicher.",shape=box,color=red];
		j2246915268 -> j1029067448;
	j2023988374 [label="Vielleicht später. [Ende.]",shape=box,color=red];
		j2023988374 -> "Chat ends.";
	j1322543334 [label="Ich frage mich, warum auf seinem Rücken ein weiteres Gesicht ist, das an die Kritzeleien eines Kindes erinnert.",shape=box,color=blue];
		j1322543334 -> j610488330;
	"Chat ends." [color=orange];
	j1337125731 [label="Es gab eine Schwester in der Cathédrale, die sich einst in den Gängen ihrer Vergangenheit verlor. Schwester Cécilia.",shape=box,color=blue];
		j1337125731 -> j1324233191;
	j1029067448 [label="Er war allem Anschein nach ein Genie und der Kopf hinter der Nutzung von Argon-Kristallen.",shape=box,color=red];
		j1029067448 -> j1912295884;
	j610488330 [label="Ich habe Monsieur Necraloid und Monsieur Loid gefragt und keiner von beiden wollte darüber sprechen. Sie nannten mir nur einen Namen: Otak. Und sie erwähnten das mit großer Traurigkeit.",shape=box,color=blue];
		j610488330 -> j205575734;
	j1324233191 [label="Sie stand immer vor der großen Uhr in der Halle und verkündete, es sei zwei Uhr nachmittags, aber sie wusste nicht, wie spät es war.",shape=box,color=blue];
		j1324233191 -> j3754501517;
	j1912295884 [label="Die aus dem Void gewonnen werden – sie sind der Grund, warum wir viele der mächtigen Warframes und Waffen erschaffen können, die wir herstellen.",shape=box,color=red];
		j1912295884 -> j4074930830;
	j205575734 [label="Deshalb spreche ich hier mit dir, in der Hoffnung, dass du mir helfen kannst.",shape=box,color=blue];
		j205575734 -> j2020027112;
		j205575734 -> j1836013650;
	j3754501517 [label="Wir fanden alle Gemälde in den Fluren herumgedreht und sie sagte, sie flüsterten ihr schreckliche Pläne zu.",shape=box,color=blue];
		j3754501517 -> j3933697678;
	j4074930830 [label="Er spezialisierte sich auf Kristallographie. Und seine Arbeiten wurden hier in den Laboren archiviert.",shape=box,color=red];
		j4074930830 -> j1432232638;
	j2020027112 [label="Willst du etwas über Otak erfahren? Oder warum du nicht mit ihm sprechen kannst?",shape=box,color=red];
		j2020027112 -> j1508392635;
	j1836013650 [label="Otak ist schwer zu erklären ...",shape=box,color=red];
		j1836013650 -> j2100059297;
	j3933697678 [label="Wir fanden heraus, dass sie einfach Gespräche in anderen Räumen hörte und dachte, dass die Gemälde sprachen ...",shape=box,color=blue];
		j3933697678 -> j145325604;
	j1432232638 [label="Aus irgendeinem Grund, ich weiß nicht warum, wurde er in ein Cephalon verwandelt und erhielt seine eigene Nekraloid-Hülle.",shape=box,color=red];
		j1432232638 -> j3907946294;
	j1508392635 [label="Ich glaube, ich möchte beides wissen irgendwann, aber ich überlasse es dir, wo du anfängst. Ich weiß nicht après tout, was wichtiger ist.",shape=box,color=blue];
		j1508392635 -> j2100059297;
	j2100059297 [label="Check boolean LoidFamilyComplete",color=orange];
		j2100059297 -> j968281699 [label=true,color=green];
		j2100059297 -> j968281699 [label=false,color=brown];
		j2100059297 -> j2695989018 [label=false,color=brown];
	j145325604 [label="Einmal hielt sie alle Kissen in einem Aufenthaltsraum für Kinder und lud sie alle zum Tee ein ...",shape=box,color=blue];
		j145325604 -> j2385348451;
	j3907946294 [label="Nicht alle Cephalons wurden als Bestrafung erschaffen. Aber hier auf Deimos lief es ... nicht gut, und er wurde schwer beschädigt.",shape=box,color=red];
		j3907946294 -> j3045370272;
	j968281699 [label="Otak war einst ein Archimede, Wissenschaftler und Akademiker der Orokin. Was ihm widerfahren ist, ist nicht gerade eine schöne Geschichte.",shape=box,color=red];
		j968281699 -> j3519763658;
	j2695989018 [label="Nun ... kurz gefasst, ein Teil von Entratis Familie ist oben und sie sind sich nicht ... wirklich bewusst, dass wir hier unten sind.",shape=box,color=red];
		j2695989018 -> j232517097;
	j2385348451 [label="Als ich ins Zimmer kam, sah sie zu mir auf und sagte: \"Oh, Schwester Odette, da bist du ja! Die Kinder aus dem Waisenhaus sind hier, möchtest du dich zu mir setzen?\"",shape=box,color=blue];
		j2385348451 -> j1468662815;
		j2385348451 -> j1782618518;
	j3045370272 [label="+5 Chemistry",color=orange];
		j3045370272 -> j981817931;
	j3519763658 [label="Boolean MarieOtak1 is now true.",color=orange];
		j3519763658 -> j2443266611;
	j232517097 [label="Boolean MarieFamily1 is now true.",color=orange];
		j232517097 -> j1057534601;
	j1468662815 [label="Was hast du gemacht?",shape=box,color=red];
		j1468662815 -> j1785018756;
	j1782618518 [label="Wer war Schwester Odette?",shape=box,color=red];
		j1782618518 -> j410179073;
	j981817931 [label="Pauvre petit ...",shape=box,color=blue];
		j981817931 -> j4139393723;
	j2443266611 [label="Par les Luminaires ... bitte, sprich weiter.",shape=box,color=blue];
		j2443266611 -> j1029067448;
	j1057534601 [label="Par les Luminaires ... Du meinst, wir sind alle hier unten im Geheimen ?! Dürfen wir diesen Ort deshalb nicht verlassen ?! Mais pourquoi ?!",shape=box,color=blue];
		j1057534601 -> j3400259673;
	j1785018756 [label="Ich rollte meinen Stuhl an einen leeren Platz am Tisch und trank mit ihr und den Kissen Tee. Was blieb mir sonst übrig ?",shape=box,color=blue];
		j1785018756 -> j3055435858;
	j410179073 [label="Schwester Odette war, muss ich leider gestehen, seit dreißig Jahren tot.",shape=box,color=blue];
		j410179073 -> j2891249186;
	j4139393723 [label="Also wurde er zum Haupt-Necraloid transferiert – dem einzigen Necraloid, der übrig geblieben ist – und ... nun ja? Es ist schwer zu erklären.",shape=box,color=red];
		j4139393723 -> j1936826009;
		j4139393723 -> j1752436168;
		j4139393723 -> j2612476980;
	j3400259673 [label="Seine Tochter Euleria – genannt Mutter – und ihre Familie haben sich die ganze Zeit um Deimos gekümmert.",shape=box,color=red];
		j3400259673 -> j122070274;
	j3055435858 [label="Was haben wir zusammen gelacht, als sie mir Geschichten aus ihrer Vergangenheit erzählte. Geschichten, die Schwester Cécilia, soweit ich weiß, noch nie jemandem erzählt hatte.",shape=box,color=blue];
		j3055435858 -> j3743066709;
	j2891249186 [label="Ich rollte meinen Stuhl an einen leeren Platz am Tisch und trank mit ihr und den Kissen Tee.",shape=box,color=blue];
		j2891249186 -> j3055435858;
	j1936826009 [label="Ich wünschte nur, wir könnten ihn reparieren, ehrlich. Den echten Otak zurückbringen.",shape=box,color=red];
		j1936826009 -> j1337125731;
	j1752436168 [label="Er bringt mich zum Lächeln. Er ist witzig, aber dahinter verbirgt sich etwas Tragisches und Zerbrochenes.",shape=box,color=red];
		j1752436168 -> j1337125731;
	j2612476980 [label="Leider ist er nicht mehr zu retten. Und ich glaube, er geht vielen auf die Nerven.",shape=box,color=red];
		j2612476980 -> j1337125731;
	j122070274 [label="Über diesen Ort und das Herz gewacht, das Void-Energie in das Ursprungssystem pumpt und uns alle ... wirklich verwendbar hält, seit Entrati gegangen ist.",shape=box,color=red];
		j122070274 -> j251199736;
	j3743066709 [label="Ihre Augen leuchteten manchmal, waren aber auch trüb in anderen Momenten, wie die einer Kinderpuppe ...",shape=box,color=blue];
		j3743066709 -> j3810381901;
		j3743066709 -> j1726426581;
		j3743066709 -> j1295327958;
		j3743066709 -> j723217005;
	j251199736 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j251199736 -> j3750466030 [label=true,color=green];
		j251199736 -> j527253693 [label=false,color=brown];
	j3810381901 [label="Warum hast du dich zu ihr gesellt?",shape=box,color=red];
		j3810381901 -> j119812552;
	j1726426581 [label="Was ist mit Schwester Cécilia passiert?",shape=box,color=red];
		j1726426581 -> j1502737745;
	j1295327958 [label="Ich hoffe, es hat ihr etwas bedeutet, dass du da warst.",shape=box,color=red];
		j1295327958 -> j1659724230;
	j723217005 [label="Es war nett von dir, sich zu ihr zu gesellen.",shape=box,color=red];
		j723217005 -> j813479890;
	j3750466030 [label="Sie hat sich mit seiner Abwesenheit abgefunden und sie haben Frieden miteinander geschlossen, aber es war hart erkämpft.",shape=box,color=red];
		j3750466030 -> j314695903;
	j527253693 [label="Sie hat sich mit seiner Abwesenheit nicht abgefunden und die beiden liegen sich gegenseitig an die Gurgel.",shape=box,color=red];
		j527253693 -> j207595223;
	j119812552 [label="+15 Chemistry",color=orange];
		j119812552 -> j841290306;
	j1502737745 [label="Was mit allen passiert in ihrem Zustand. Sie verblasste immer weiter, wie ein Gemälde in der Sonne, bis nichts mehr übrig war.",shape=box,color=blue];
		j1502737745 -> j4020860260;
	j1659724230 [label="+10 Chemistry",color=orange];
		j1659724230 -> j1713011482;
	j813479890 [label="+5 Chemistry",color=orange];
		j813479890 -> j3800843954;
	j314695903 [label="Zu wissen, dass er weiterhin da draußen ist, Amok läuft und dass er kein Wort mit ihr gewechselt oder ihr nicht einmal einen Brief geschickt hat ...?",shape=box,color=red];
		j314695903 -> j3676627908;
	j207595223 [label="Zu wissen, dass er weiterhin da draußen ist, Amok läuft und dass er kein Wort mit ihr gewechselt oder ihr nicht einmal einen Brief geschickt hat ...?",shape=box,color=red];
		j207595223 -> j432154174;
	j841290306 [label="Eine weise Frage. Eine sehr weise Frage. Ich glaube, es gab viele Gründe, die mich inspiriert haben. Ich hoffe, dass es Güte war, die mich an ihren Tisch geführt hat.",shape=box,color=blue];
		j841290306 -> j3201274510;
	j4020860260 [label="Dann verließ sie uns und wir hielten eine Mahnwache bei Kerzenlicht für sie ab. Ich hoffe, sie erinnerte sich am Ende an diejenigen, die wirklich gütig zu ihr waren.",shape=box,color=blue];
		j4020860260 -> j1874198575;
	j1713011482 [label="Das hoffe ich, irgendwo unter der Oberfläche hat sie das vielleicht.",shape=box,color=blue];
		j1713011482 -> j1874198575;
	j3800843954 [label="War es Güte? Oder war es Schuldgefühl, das mich dazu veranlasste? Ach, aber du bist selbst gütig, das zu sagen.",shape=box,color=blue];
		j3800843954 -> j1874198575;
	j3676627908 [label="Ich kann mir nicht vorstellen, wie schmerzhaft das für sie wäre. Für beide.",shape=box,color=red];
		j3676627908 -> j1651214409;
	j432154174 [label="Das würde die geringe Chance auf eine Versöhnung zerstören, die sie möglicherweise haben.",shape=box,color=red];
		j432154174 -> j3236413855;
	j3201274510 [label="Aber ich glaube, tief in meinem Inneren hatte ich vielleicht Schuldgefühle. Hätte ich es nicht getan, hätte ich sie vernachlässigt. So wie man ein Kind vernachlässigen würde.",shape=box,color=blue];
		j3201274510 -> j1874198575;
	j1874198575 [label="Ich hoffe, dass dein Otak diejenigen erkennt, die gütig sind und Geduld mit ihm haben. Aber andererseits ist er nicht wirklich da, oder ?",shape=box,color=blue];
		j1874198575 -> j2035613125;
	j1651214409 [label="Ich verstehe zwar die Logik hinter der Entscheidung, sie vor dem Schmerz zu schützen, die le Cardinal durch seinen notwendigen Aufbruch verursacht hat ...",shape=box,color=blue];
		j1651214409 -> j60744558;
	j3236413855 [label="+10 Chemistry",color=orange];
		j3236413855 -> j378728531;
	j2035613125 [label="Ich spreche von einem sehr komplexen Stück Technologie, das einem Menschen ähnelt, nicht wahr ? Ein phonographe, aber viel, viel komplexer. Wie Necraloid hat er keine Seele.",shape=box,color=blue];
		j2035613125 -> j4168748798;
		j2035613125 -> j874861658;
		j2035613125 -> j767290375;
		j2035613125 -> j1994573977;
		j2035613125 -> j2984161606;
	j60744558 [label="Aber ich finde es unnötig grausam, du nicht ? Sie könnten ihn für tot halten. Oder Schlimmeres! Und wir, leben hier comme des rats d'égout ?",shape=box,color=blue];
		j60744558 -> j2254248008;
		j60744558 -> j2875176193;
	j378728531 [label="Oui ... ich verstehe die Logik. Ich würde daran arbeiten, ihre Familie wieder zusammenzubringen, wenn du kannst, non ? Es scheint die einzige Hoffnung für uns zu sein, hier rauszukommen. ",shape=box,color=blue];
		j378728531 -> j2831922453;
	j4168748798 [label="Necraloid hat zwar keine Seele, ist aber einzigartig. Andere Cephalons, wie Otak, haben eine Seele. Sie wurden durch ihre Entstehung zerstört.",shape=box,color=red];
		j4168748798 -> j2624807270;
	j874861658 [label="Du hast recht. Was soll ich also dagegen tun?",shape=box,color=red];
		j874861658 -> j388402128;
	j767290375 [label="Du hast recht. Sie haben keine. Aber das heißt nicht, dass wir sie einfach schlecht behandeln können.",shape=box,color=red];
		j767290375 -> j2824771758;
	j1994573977 [label="Ich weiß nicht, ob du recht hast oder nicht. Aber sie können weiterhin denken und fühlen, und wir können sie nicht wie Dinge behandeln.",shape=box,color=red];
		j1994573977 -> j2044104505;
	j2984161606 [label="Necraloid hat eine Seele. Alle Cephalons haben eine.",shape=box,color=red];
		j2984161606 -> j1536985412;
	j2254248008 [label="Diese Entscheidung kann ich nicht wirklich treffen.",shape=box,color=red];
		j2254248008 -> j1231537939;
	j2875176193 [label="Ich habe übrigens eine Freundin, die Ratten liebt. Ich finde sie süß.",shape=box,color=red];
		j2875176193 -> j1239731755;
	j2831922453 [label="Damit wir nicht den Rest unseres Lebens hier gefangen verbringen, comme des rats d'égout.",shape=box,color=blue];
		j2831922453 -> j3719531161;
		j2831922453 -> j4052068543;
	j2624807270 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j2624807270 -> j947480724;
	j388402128 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j388402128 -> j3881475488;
	j2824771758 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j2824771758 -> j220669176;
	j2044104505 [label="Boolean MarieCephalonUnsure is now true.",color=orange];
		j2044104505 -> j1541290646;
	j1536985412 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j1536985412 -> j459671856;
	j1231537939 [label="Ich weiß. Es ist die Entscheidung von Monsieur Loid und allen anderen, sich zu erkennen zu geben.",shape=box,color=blue];
		j1231537939 -> j2078111242;
	j1239731755 [label="+15 Chemistry",color=orange];
		j1239731755 -> j2435496084;
	j3719531161 [label="Ich war nachlässig. Du hast recht. Ich mache mich an die Arbeit.",shape=box,color=red];
		j3719531161 -> j4264032007;
	j4052068543 [label="Ich habe übrigens eine Freundin, die Ratten liebt. Ich finde sie süß. ",shape=box,color=red];
		j4052068543 -> j3806388997;
	j947480724 [label="+5 Chemistry",color=orange];
		j947480724 -> j2623736409;
	j3881475488 [label="Oh, ich möchte natürlich nicht, dass du grausam zu ihnen bist ! Non ! Schätze sie, denn sie sind kostbar und ohne eigenes Verschulden so, wie sie sind!",shape=box,color=blue];
		j3881475488 -> j1826108452;
	j220669176 [label="+5 Chemistry",color=orange];
		j220669176 -> j3881475488;
	j1541290646 [label="+5 Chemistry",color=orange];
		j1541290646 -> j3583678966;
	j459671856 [label="+5 Chemistry",color=orange];
		j459671856 -> j1110933578;
	j2078111242 [label="Ich denke, es sind Schuldgefühle und nicht Edelmut, die uns hier unten halten.",shape=box,color=blue];
		j2078111242 -> j3925557620;
	j2435496084 [label="Und ich würde sie gerne eines Tages kennenlernen, aber das ist nicht der Punkt, den ich machen will, Dummkopf.",shape=box,color=blue];
		j2435496084 -> j2078111242;
	j4264032007 [label="+5 Chemistry",color=orange];
		j4264032007 -> j3732697204;
	j3806388997 [label="+5 Chemistry",color=orange];
		j3806388997 -> j2435496084;
	j2623736409 [label="Ein weiterer Beweis dafür, dass der Teufel und seinesgleichen zu Recht verurteilt wurden. Aber vielleicht hast du mit Otak und seinesgleichen recht, oder vielleicht beruhigt es dich, das zu glauben.",shape=box,color=blue];
		j2623736409 -> j3714568733;
	j1826108452 [label="Es tut mir im Herzen weh, angesichts der zerschmetterten Körper, die die Orokin-Teufel zurückgelassen haben. Sie waren keine Götter, sondern haben alles verschlungen, was ihnen folgte. Sieh dir zum Beweis nur den an, mit dem wir reisen.",shape=box,color=blue];
		j1826108452 -> j210666355;
	j3583678966 [label="Vielleicht hast du recht, aber ich glaube nicht, dass die Orokin-Teufel mehr über die Funktionsweise der Seele wussten als wir. Sie waren keine großen Götter.",shape=box,color=blue];
		j3583678966 -> j1439890150;
	j1110933578 [label="Vielleicht hast du recht, oder vielleicht beruhigt es dich, das zu glauben.",shape=box,color=blue];
		j1110933578 -> j210666355;
	j3925557620 [label="Dass wir eine große und schreckliche Sünde verbergen.",shape=box,color=blue];
		j3925557620 -> j3631207496;
	j3732697204 [label="Vielen Dank. Ich weiß nicht, ob du Erfolg haben wirst, aber manchmal muss man es einfach nur versuchen.",shape=box,color=blue];
		j3732697204 -> j2078111242;
	j3714568733 [label="Wie dem auch sei, ich glaube, dass der Otak, der vor langer Zeit gestorben ist, dir jetzt wohlgesonnen wäre, wenn du dem, was in seiner Erinnerung weiterlebt, gütig gegenüber bist.",shape=box,color=blue];
		j3714568733 -> j1531393501;
	j210666355 [label="Es fällt mir einfach schwer zu sagen, dass Necraloid eine Seele hat, wenn Loid direkt neben ihm steht, oui ?",shape=box,color=blue];
		j210666355 -> j3714568733;
	j1439890150 [label="Technologie vielleicht – Wissenschaft ja – aber die Seele ? Sie konnten kaum ihr eigenes Herz beherrschen ! Wenn du weitere Beweise dafür brauchst, schau dir den Teufel an, mit dem wir reisen.",shape=box,color=blue];
		j1439890150 -> j210666355;
	j3631207496 [label="Und diese Sünde muss vergeben werden.",shape=box,color=blue];
		j3631207496 -> j3814938864;
	j1531393501 [label="Check boolean LoidFamilyComplete",color=orange];
		j1531393501 -> j497415699 [label=true,color=green];
		j1531393501 -> j1341596894 [label=false,color=brown];
	j3814938864 [label="Vielen Dank, Du hast mir viel zum Nachdenken gegeben. À la revoyure.",shape=box,color=blue];
		j3814938864 -> "Chat ends.";
	j497415699 [label="Ich muss los. Aber, merci. Du hast mir viel zum Nachdenken gegeben.",shape=box,color=blue];
		j497415699 -> "Chat ends.";
	j1341596894 [label="Ich hoffe einfach, dass ich das seltsame fac-similé, das weiterlebt, eines Tages kennenlerne, wenn Monsieur Necraloid wieder nach oben kommt.",shape=box,color=blue];
		j1341596894 -> j2844508839;
		j1341596894 -> j2952908610;
	j2844508839 [label="Ich bin nicht sicher, ob es klug ist, sich in die Angelegenheiten anderer einzumischen.",shape=box,color=red];
		j2844508839 -> j3351551251;
	j2952908610 [label="Ich hoffe, dass wir der Familie Entrati eines Tages die Wahrheit sagen können. Je eher, desto besser.",shape=box,color=red];
		j2952908610 -> j3351551251;
	j3351551251 [label="Check boolean MarieFamily1",color=orange];
		j3351551251 -> j2038953511 [label=true,color=green];
		j3351551251 -> j2145195063 [label=false,color=brown];
	j2038953511 [label="Wir werden sehen, ich möchte von dir mehr Einzelheiten darüber erfahren, warum wir bleiben müssen.",shape=box,color=blue];
		j2038953511 -> j3700129597;
