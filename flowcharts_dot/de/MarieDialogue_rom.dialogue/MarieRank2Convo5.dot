digraph {
	735 [label="MarieRank2Convo5 begins.",color=orange];
		735 -> 736;
	736 [label="Evaluate expressions",color=orange];
		736 -> 739 [label="MarieOtak1",color=purple];
		736 -> 738 [label="MarieFamily1",color=purple];
		736 -> 737 [label="false",color=purple];
	739 [label="Ich habe darüber nachgedacht, was du mir über Monsieur Otak erzählt hast.",shape=box,color=blue];
		739 -> 743;
	738 [label="Ich habe darüber nachgedacht, was du mir über die Familie von le Cardinal erzählt hast.",shape=box,color=blue];
		738 -> 742;
	737 [label="Ich habe immer noch eine Frage zu Monsieur \"Necraloid\", wenn ich darf?",shape=box,color=blue];
		737 -> 741;
		737 -> 740;
	743 [label="Ich habe mich gefragt, ob es vielleicht einer meiner eigenen Geschichten ähnelt. Darf ich sie dir erzählen, falls du Zeit hast?",shape=box,color=blue];
		743 -> 749;
		743 -> 748;
	742 [label="Ich habe mich gefragt, ob du mir die Geschichte von Otak erzählen kannst, dem kindlichen Gesicht auf der Rückseite von Necraloids Schädel?",shape=box,color=blue];
		742 -> 747;
		742 -> 746;
	741 [label="Ja natürlich, was ist die Frage?",shape=box,color=red];
		741 -> 745;
	740 [label="[Ende.]",shape=box,color=red];
		740 -> 744;
	749 [label="Ich höre.",shape=box,color=red];
		749 -> 754;
	748 [label="[Ende.]",shape=box,color=red];
		748 -> 753;
	747 [label="Sicher.",shape=box,color=red];
		747 -> 752;
	746 [label="Vielleicht später. [Ende.]",shape=box,color=red];
		746 -> 751;
	745 [label="Ich frage mich, warum auf seinem Rücken ein weiteres Gesicht ist, das an die Kritzeleien eines Kindes erinnert.",shape=box,color=blue];
		745 -> 750;
	744 [label="Chat ends.",color=orange];
	754 [label="Es gab eine Schwester in der Cathédrale, die sich einst in den Gängen ihrer Vergangenheit verlor. Schwester Cécilia.",shape=box,color=blue];
		754 -> 757;
	753 [label="Chat ends.",color=orange];
	752 [label="Er war allem Anschein nach ein Genie und der Kopf hinter der Nutzung von Argon-Kristallen.",shape=box,color=red];
		752 -> 756;
	751 [label="Chat ends.",color=orange];
	750 [label="Ich habe Monsieur Necraloid und Monsieur Loid gefragt und keiner von beiden wollte darüber sprechen. Sie nannten mir nur einen Namen: Otak. Und sie erwähnten das mit großer Traurigkeit.",shape=box,color=blue];
		750 -> 755;
	757 [label="Sie stand immer vor der großen Uhr in der Halle und verkündete, es sei zwei Uhr nachmittags, aber sie wusste nicht, wie spät es war.",shape=box,color=blue];
		757 -> 761;
	756 [label="Die aus dem Void gewonnen werden – sie sind der Grund, warum wir viele der mächtigen Warframes und Waffen erschaffen können, die wir herstellen.",shape=box,color=red];
		756 -> 760;
	755 [label="Deshalb spreche ich hier mit dir, in der Hoffnung, dass du mir helfen kannst.",shape=box,color=blue];
		755 -> 758;
		755 -> 759;
	761 [label="Wir fanden alle Gemälde in den Fluren herumgedreht und sie sagte, sie flüsterten ihr schreckliche Pläne zu.",shape=box,color=blue];
		761 -> 766;
	760 [label="Er spezialisierte sich auf Kristallographie. Und seine Arbeiten wurden hier in den Laboren archiviert.",shape=box,color=red];
		760 -> 765;
	758 [label="Willst du etwas über Otak erfahren? Oder warum du nicht mit ihm sprechen kannst?",shape=box,color=red];
		758 -> 762;
	759 [label="Otak ist schwer zu erklären ...",shape=box,color=red];
		759 -> 2919;
	766 [label="Wir fanden heraus, dass sie einfach Gespräche in anderen Räumen hörte und dachte, dass die Gemälde sprachen ...",shape=box,color=blue];
		766 -> 770;
	765 [label="Aus irgendeinem Grund, ich weiß nicht warum, wurde er in ein Cephalon verwandelt und erhielt seine eigene Nekraloid-Hülle.",shape=box,color=red];
		765 -> 769;
	762 [label="Ich glaube, ich möchte beides wissen irgendwann, aber ich überlasse es dir, wo du anfängst. Ich weiß nicht après tout, was wichtiger ist.",shape=box,color=blue];
		762 -> 2919;
	2919 [label="Check boolean LoidFamilyComplete",color=orange];
		2919 -> 764 [label=true,color=green];
		2919 -> 764 [label=false,color=brown];
		2919 -> 763 [label=false,color=brown];
	770 [label="Einmal hielt sie alle Kissen in einem Aufenthaltsraum für Kinder und lud sie alle zum Tee ein ...",shape=box,color=blue];
		770 -> 774;
	769 [label="Nicht alle Cephalons wurden als Bestrafung erschaffen. Aber hier auf Deimos lief es ... nicht gut, und er wurde schwer beschädigt.",shape=box,color=red];
		769 -> 773;
	764 [label="Otak war einst ein Archimede, Wissenschaftler und Akademiker der Orokin. Was ihm widerfahren ist, ist nicht gerade eine schöne Geschichte.",shape=box,color=red];
		764 -> 768;
	763 [label="Nun ... kurz gefasst, ein Teil von Entratis Familie ist oben und sie sind sich nicht ... wirklich bewusst, dass wir hier unten sind.",shape=box,color=red];
		763 -> 767;
	774 [label="Als ich ins Zimmer kam, sah sie zu mir auf und sagte: \"Oh, Schwester Odette, da bist du ja! Die Kinder aus dem Waisenhaus sind hier, möchtest du dich zu mir setzen?\"",shape=box,color=blue];
		774 -> 777;
		774 -> 778;
	773 [label="+5 Chemistry",color=orange];
		773 -> 776;
	768 [label="Update boolean MarieOtak1",color=orange];
		768 -> 772;
	767 [label="Update boolean MarieFamily1",color=orange];
		767 -> 771;
	777 [label="Was hast du gemacht?",shape=box,color=red];
		777 -> 781;
	778 [label="Wer war Schwester Odette?",shape=box,color=red];
		778 -> 782;
	776 [label="Pauvre petit ...",shape=box,color=blue];
		776 -> 780;
	772 [label="Par les Luminaires ... bitte, sprich weiter.",shape=box,color=blue];
		772 -> 752;
	771 [label="Par les Luminaires ... Du meinst, wir sind alle hier unten im Geheimen ?! Dürfen wir diesen Ort deshalb nicht verlassen ?! Mais pourquoi ?!",shape=box,color=blue];
		771 -> 775;
	781 [label="Ich rollte meinen Stuhl an einen leeren Platz am Tisch und trank mit ihr und den Kissen Tee. Was blieb mir sonst übrig ?",shape=box,color=blue];
		781 -> 787;
	782 [label="Schwester Odette war, muss ich leider gestehen, seit dreißig Jahren tot.",shape=box,color=blue];
		782 -> 788;
	780 [label="Also wurde er zum Haupt-Necraloid transferiert – dem einzigen Necraloid, der übrig geblieben ist – und ... nun ja? Es ist schwer zu erklären.",shape=box,color=red];
		780 -> 784;
		780 -> 785;
		780 -> 786;
	775 [label="Seine Tochter Euleria – genannt Mutter – und ihre Familie haben sich die ganze Zeit um Deimos gekümmert.",shape=box,color=red];
		775 -> 779;
	787 [label="Was haben wir zusammen gelacht, als sie mir Geschichten aus ihrer Vergangenheit erzählte. Geschichten, die Schwester Cécilia, soweit ich weiß, noch nie jemandem erzählt hatte.",shape=box,color=blue];
		787 -> 791;
	788 [label="Ich rollte meinen Stuhl an einen leeren Platz am Tisch und trank mit ihr und den Kissen Tee.",shape=box,color=blue];
		788 -> 787;
	784 [label="Ich wünschte nur, wir könnten ihn reparieren, ehrlich. Den echten Otak zurückbringen.",shape=box,color=red];
		784 -> 754;
	785 [label="Er bringt mich zum Lächeln. Er ist witzig, aber dahinter verbirgt sich etwas Tragisches und Zerbrochenes.",shape=box,color=red];
		785 -> 754;
	786 [label="Leider ist er nicht mehr zu retten. Und ich glaube, er geht vielen auf die Nerven.",shape=box,color=red];
		786 -> 754;
	779 [label="Über diesen Ort und das Herz gewacht, das Void-Energie in das Ursprungssystem pumpt und uns alle ... wirklich verwendbar hält, seit Entrati gegangen ist.",shape=box,color=red];
		779 -> 783;
	791 [label="Ihre Augen leuchteten manchmal, waren aber auch trüb in anderen Momenten, wie die einer Kinderpuppe ...",shape=box,color=blue];
		791 -> 794;
		791 -> 795;
		791 -> 796;
		791 -> 797;
	783 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		783 -> 789 [label=true,color=green];
		783 -> 790 [label=false,color=brown];
	794 [label="Warum hast du dich zu ihr gesellt?",shape=box,color=red];
		794 -> 800;
	795 [label="Was ist mit Schwester Cécilia passiert?",shape=box,color=red];
		795 -> 801;
	796 [label="Ich hoffe, es hat ihr etwas bedeutet, dass du da warst.",shape=box,color=red];
		796 -> 802;
	797 [label="Es war nett von dir, sich zu ihr zu gesellen.",shape=box,color=red];
		797 -> 803;
	789 [label="Sie hat sich mit seiner Abwesenheit abgefunden und sie haben Frieden miteinander geschlossen, aber es war hart erkämpft.",shape=box,color=red];
		789 -> 792;
	790 [label="Sie hat sich mit seiner Abwesenheit nicht abgefunden und die beiden liegen sich gegenseitig an die Gurgel.",shape=box,color=red];
		790 -> 793;
	800 [label="+15 Chemistry",color=orange];
		800 -> 806;
	801 [label="Was mit allen passiert in ihrem Zustand. Sie verblasste immer weiter, wie ein Gemälde in der Sonne, bis nichts mehr übrig war.",shape=box,color=blue];
		801 -> 807;
	802 [label="+10 Chemistry",color=orange];
		802 -> 808;
	803 [label="+5 Chemistry",color=orange];
		803 -> 809;
	792 [label="Zu wissen, dass er weiterhin da draußen ist, Amok läuft und dass er kein Wort mit ihr gewechselt oder ihr nicht einmal einen Brief geschickt hat ...?",shape=box,color=red];
		792 -> 798;
	793 [label="Zu wissen, dass er weiterhin da draußen ist, Amok läuft und dass er kein Wort mit ihr gewechselt oder ihr nicht einmal einen Brief geschickt hat ...?",shape=box,color=red];
		793 -> 799;
	806 [label="Eine weise Frage. Eine sehr weise Frage. Ich glaube, es gab viele Gründe, die mich inspiriert haben. Ich hoffe, dass es Güte war, die mich an ihren Tisch geführt hat.",shape=box,color=blue];
		806 -> 812;
	807 [label="Dann verließ sie uns und wir hielten eine Mahnwache bei Kerzenlicht für sie ab. Ich hoffe, sie erinnerte sich am Ende an diejenigen, die wirklich gütig zu ihr waren.",shape=box,color=blue];
		807 -> 813;
	808 [label="Das hoffe ich, irgendwo unter der Oberfläche hat sie das vielleicht.",shape=box,color=blue];
		808 -> 813;
	809 [label="War es Güte? Oder war es Schuldgefühl, das mich dazu veranlasste? Ach, aber du bist selbst gütig, das zu sagen.",shape=box,color=blue];
		809 -> 813;
	798 [label="Ich kann mir nicht vorstellen, wie schmerzhaft das für sie wäre. Für beide.",shape=box,color=red];
		798 -> 804;
	799 [label="Das würde die geringe Chance auf eine Versöhnung zerstören, die sie möglicherweise haben.",shape=box,color=red];
		799 -> 805;
	812 [label="Aber ich glaube, tief in meinem Inneren hatte ich vielleicht Schuldgefühle. Hätte ich es nicht getan, hätte ich sie vernachlässigt. So wie man ein Kind vernachlässigen würde.",shape=box,color=blue];
		812 -> 813;
	813 [label="Ich hoffe, dass dein Otak diejenigen erkennt, die gütig sind und Geduld mit ihm haben. Aber andererseits ist er nicht wirklich da, oder ?",shape=box,color=blue];
		813 -> 817;
	804 [label="Ich verstehe zwar die Logik hinter der Entscheidung, sie vor dem Schmerz zu schützen, die le Cardinal durch seinen notwendigen Aufbruch verursacht hat ...",shape=box,color=blue];
		804 -> 810;
	805 [label="+10 Chemistry",color=orange];
		805 -> 811;
	817 [label="Ich spreche von einem sehr komplexen Stück Technologie, das einem Menschen ähnelt, nicht wahr ? Ein phonographe, aber viel, viel komplexer. Wie Necraloid hat er keine Seele.",shape=box,color=blue];
		817 -> 822;
		817 -> 823;
		817 -> 824;
		817 -> 825;
		817 -> 826;
	810 [label="Aber ich finde es unnötig grausam, du nicht ? Sie könnten ihn für tot halten. Oder Schlimmeres! Und wir, leben hier comme des rats d'égout ?",shape=box,color=blue];
		810 -> 814;
		810 -> 815;
	811 [label="Oui ... ich verstehe die Logik. Ich würde daran arbeiten, ihre Familie wieder zusammenzubringen, wenn du kannst, non ? Es scheint die einzige Hoffnung für uns zu sein, hier rauszukommen. ",shape=box,color=blue];
		811 -> 816;
	822 [label="Necraloid hat zwar keine Seele, ist aber einzigartig. Andere Cephalons, wie Otak, haben eine Seele. Sie wurden durch ihre Entstehung zerstört.",shape=box,color=red];
		822 -> 831;
	823 [label="Du hast recht. Was soll ich also dagegen tun?",shape=box,color=red];
		823 -> 832;
	824 [label="Du hast recht. Sie haben keine. Aber das heißt nicht, dass wir sie einfach schlecht behandeln können.",shape=box,color=red];
		824 -> 833;
	825 [label="Ich weiß nicht, ob du recht hast oder nicht. Aber sie können weiterhin denken und fühlen, und wir können sie nicht wie Dinge behandeln.",shape=box,color=red];
		825 -> 834;
	826 [label="Necraloid hat eine Seele. Alle Cephalons haben eine.",shape=box,color=red];
		826 -> 835;
	814 [label="Diese Entscheidung kann ich nicht wirklich treffen.",shape=box,color=red];
		814 -> 818;
	815 [label="Ich habe übrigens eine Freundin, die Ratten liebt. Ich finde sie süß.",shape=box,color=red];
		815 -> 819;
	816 [label="Damit wir nicht den Rest unseres Lebens hier gefangen verbringen, comme des rats d'égout.",shape=box,color=blue];
		816 -> 820;
		816 -> 821;
	831 [label="Update boolean MarieCephalonSoul",color=orange];
		831 -> 839;
	832 [label="Update boolean MarieCephalonNoSoul",color=orange];
		832 -> 840;
	833 [label="Update boolean MarieCephalonNoSoul",color=orange];
		833 -> 841;
	834 [label="Update boolean MarieCephalonUnsure",color=orange];
		834 -> 842;
	835 [label="Update boolean MarieCephalonSoul",color=orange];
		835 -> 843;
	818 [label="Ich weiß. Es ist die Entscheidung von Monsieur Loid und allen anderen, sich zu erkennen zu geben.",shape=box,color=blue];
		818 -> 827;
	819 [label="+15 Chemistry",color=orange];
		819 -> 828;
	820 [label="Ich war nachlässig. Du hast recht. Ich mache mich an die Arbeit.",shape=box,color=red];
		820 -> 829;
	821 [label="Ich habe übrigens eine Freundin, die Ratten liebt. Ich finde sie süß. ",shape=box,color=red];
		821 -> 830;
	839 [label="+5 Chemistry",color=orange];
		839 -> 845;
	840 [label="Oh, ich möchte natürlich nicht, dass du grausam zu ihnen bist ! Non ! Schätze sie, denn sie sind kostbar und ohne eigenes Verschulden so, wie sie sind!",shape=box,color=blue];
		840 -> 846;
	841 [label="+5 Chemistry",color=orange];
		841 -> 840;
	842 [label="+5 Chemistry",color=orange];
		842 -> 847;
	843 [label="+5 Chemistry",color=orange];
		843 -> 848;
	827 [label="Ich denke, es sind Schuldgefühle und nicht Edelmut, die uns hier unten halten.",shape=box,color=blue];
		827 -> 836;
	828 [label="Und ich würde sie gerne eines Tages kennenlernen, aber das ist nicht der Punkt, den ich machen will, Dummkopf.",shape=box,color=blue];
		828 -> 827;
	829 [label="+5 Chemistry",color=orange];
		829 -> 837;
	830 [label="+5 Chemistry",color=orange];
		830 -> 838;
	845 [label="Ein weiterer Beweis dafür, dass der Teufel und seinesgleichen zu Recht verurteilt wurden. Aber vielleicht hast du mit Otak und seinesgleichen recht, oder vielleicht beruhigt es dich, das zu glauben.",shape=box,color=blue];
		845 -> 850;
	846 [label="Es tut mir im Herzen weh, angesichts der zerschmetterten Körper, die die Orokin-Teufel zurückgelassen haben. Sie waren keine Götter, sondern haben alles verschlungen, was ihnen folgte. Sieh dir zum Beweis nur den an, mit dem wir reisen.",shape=box,color=blue];
		846 -> 851;
	847 [label="Vielleicht hast du recht, aber ich glaube nicht, dass die Orokin-Teufel mehr über die Funktionsweise der Seele wussten als wir. Sie waren keine großen Götter.",shape=box,color=blue];
		847 -> 852;
	848 [label="Vielleicht hast du recht, oder vielleicht beruhigt es dich, das zu glauben.",shape=box,color=blue];
		848 -> 851;
	836 [label="Dass wir eine große und schreckliche Sünde verbergen.",shape=box,color=blue];
		836 -> 844;
	837 [label="Vielen Dank. Ich weiß nicht, ob du Erfolg haben wirst, aber manchmal muss man es einfach nur versuchen.",shape=box,color=blue];
		837 -> 827;
	838 [label="Und ich würde sie gerne eines Tages kennenlernen, aber das ist nicht der Punkt, den ich machen will, Dummkopf.",shape=box,color=blue];
		838 -> 827;
	850 [label="Wie dem auch sei, ich glaube, dass der Otak, der vor langer Zeit gestorben ist, dir jetzt wohlgesonnen wäre, wenn du dem, was in seiner Erinnerung weiterlebt, gütig gegenüber bist.",shape=box,color=blue];
		850 -> 2920;
	851 [label="Es fällt mir einfach schwer zu sagen, dass Necraloid eine Seele hat, wenn Loid direkt neben ihm steht, oui ?",shape=box,color=blue];
		851 -> 850;
	852 [label="Technologie vielleicht – Wissenschaft ja – aber die Seele ? Sie konnten kaum ihr eigenes Herz beherrschen ! Wenn du weitere Beweise dafür brauchst, schau dir den Teufel an, mit dem wir reisen.",shape=box,color=blue];
		852 -> 851;
	844 [label="Und diese Sünde muss vergeben werden.",shape=box,color=blue];
		844 -> 849;
	2920 [label="Check boolean LoidFamilyComplete",color=orange];
		2920 -> 2921 [label=true,color=green];
		2920 -> 854 [label=false,color=brown];
	849 [label="Vielen Dank, Du hast mir viel zum Nachdenken gegeben. À la revoyure.",shape=box,color=blue];
		849 -> 853;
	2921 [label="Ich muss los. Aber, merci. Du hast mir viel zum Nachdenken gegeben.",shape=box,color=blue];
		2921 -> 2922;
	854 [label="Ich hoffe einfach, dass ich das seltsame fac-similé, das weiterlebt, eines Tages kennenlerne, wenn Monsieur Necraloid wieder nach oben kommt.",shape=box,color=blue];
		854 -> 855;
		854 -> 856;
	853 [label="Chat ends.",color=orange];
	2922 [label="Chat ends.",color=orange];
	855 [label="Ich bin nicht sicher, ob es klug ist, sich in die Angelegenheiten anderer einzumischen.",shape=box,color=red];
		855 -> 857;
	856 [label="Ich hoffe, dass wir der Familie Entrati eines Tages die Wahrheit sagen können. Je eher, desto besser.",shape=box,color=red];
		856 -> 857;
	857 [label="Check boolean MarieFamily1",color=orange];
		857 -> 858 [label=true,color=green];
		857 -> 859 [label=false,color=brown];
	858 [label="Wir werden sehen, ich möchte von dir mehr Einzelheiten darüber erfahren, warum wir bleiben müssen.",shape=box,color=blue];
		858 -> 860;
	859 [label="Es gibt etwas, das du mir, glaube ich, vorenthältst. Aber ich denke, für heute gab es genug Geschichten, oui ?",shape=box,color=blue];
		859 -> 860;
	860 [label="Wir werden uns sehr bald wieder weiter über die Familie Entrati unterhalten.",shape=box,color=blue];
		860 -> 147;
	147 [label="Chat ends.",color=orange];
}