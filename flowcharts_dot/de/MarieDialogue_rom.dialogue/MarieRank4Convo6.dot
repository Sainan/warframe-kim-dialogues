		1771 -> 1773;
		1771 -> 1774;
	1772 [label="Ich habe ihn mit den Qualen kämpfen sehen, die die Götter ihm auferlegt haben. Ich wusste, wann ich an seiner Seite schweigen musste und wann ich die sprichwörtliche Wand sein musste, gegen die er mit den Fäusten schlagen konnte.",shape=box,color=blue];
		1772 -> 1775;
	1773 [label="Ich glaube nicht, dass Lyon meine Hilfe haben möchte.",shape=box,color=red];
		1773 -> 1776;
	1774 [label="Ich versuche, für ihn da zu sein, aber er hört nicht auf mich.",shape=box,color=red];
		1774 -> 1777;
	1775 [label="Mais ça ? Dieser Ort, die Worte des Teufels, die Unsicherheit, die le Cardinal verursacht hat ... All dies hat ihm Schmerzen eingebracht, von denen er sich hoffentlich erholen kann.",shape=box,color=blue];
		1775 -> 1778;
		1775 -> 1779;
	1776 [label="Ich nehme an... wir können nichts weiter tun als geduldig zu sein, non ?",shape=box,color=blue];
		1776 -> 1780;
	1777 [label="Auf mich auch nicht, daher bin ich gekommen, um dies mit dir zu diskutieren. Ich konnte ihn immer trösten -",shape=box,color=blue];
		1777 -> 1781;
	1778 [label="Also gibst du zu, das Entrati Lyon geschadet hat? Und wie geht es dir damit?",shape=box,color=red];
		1778 -> 1782;
	1779 [label="Ich fühle, dass er auf der Schwelle steht. Wie hole ich ihn davon zurück?",shape=box,color=red];
		1779 -> 1783;
	1780 [label="Merci. Tut mir leid, dass ich deine Zeit verschwendet habe.",shape=box,color=blue];
		1780 -> 1784;
	1781 [label="Ich bin erstaunt über seine Wut, seine désespoir... er vermeidet meine Gesellschaft, wie er es nie zuvor getan hat.",shape=box,color=blue];
		1781 -> 1785;
	1782 [label="Pas bien... Aber wie soll zwischen der Liebe für meinen Bruder und meiner Bewunderung für le Cardinal wählen ? Wie soll ich zwischen meiner famille wählen ?",shape=box,color=blue];
		1782 -> 1786;
		1782 -> 1787;
		1782 -> 1788;
		1782 -> 3961;
	1783 [label="Ich weiß es nicht, deshalb bin ich hier, um das mit dir zu besprechen. Ich konnte ihn immer trösten -",shape=box,color=blue];
		1783 -> 1781;
	1784 [label="Chat ends.",color=orange];
	1785 [label="Was beunruhigt ihn so sehr ? Kennst du den Grund ?",shape=box,color=blue];
		1785 -> 1789;
	1786 [label="Du musst nicht wählen,  Marie. Menschen können kompliziert sein, so wie sie in unserem Leben existieren.",shape=box,color=red];
		1786 -> 1790;
	1787 [label="Ich würde die Familie wählen, die immer noch hier ist, nie die, die mich verlassen hat.",shape=box,color=red];
		1787 -> 1791;
	1788 [label="Ich bin sicher, Entrati wollte Lyon nicht so verletzen.",shape=box,color=red];
