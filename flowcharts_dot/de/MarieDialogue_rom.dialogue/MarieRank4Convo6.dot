		1789 -> 1796 [label="false",color=purple];
	1790 [label="Das ist das Problem mit Leuten, wie Entrati. Sie sind nicht einfach \"gute\" oder \"böse\" Kräfte. Sie sind eine Mischung.",shape=box,color=red];
		1790 -> 1799;
	1791 [label="Lass uns le Cardinal aus dieser Konversation heraushalten, oui ? Ich mache mir Sorgen um meinen Seelenbruder.",shape=box,color=blue];
		1791 -> 1781;
	1792 [label="Ich glaube es auch nicht, aber die Tatsache bleibt, oui ? Aber ich schätze deine Worte. Cela dit...",shape=box,color=blue];
		1792 -> 1791;
	3962 [label="Update boolean DrifterMarie",color=orange];
		3962 -> 3963;
	1793 [label="Lyon versucht sich mit der Tatsache abzufinden, dass die Gleichgültigkeit kein richtiger Gott ist.",shape=box,color=red];
		1793 -> 1800;
	1795 [label="Ich glaube nicht, dass es nur eine Ursache gibt. Ich glaube er ist zwischen großen Dingen gefangen.",shape=box,color=red];
		1795 -> 1802;
	1797 [label="Lyon hörte die Stimme eines Tenno, ein Kind namens Rell. Rell ... starb. Ich glaube, er verkraftet das nicht gut.",shape=box,color=red];
		1797 -> 1804;
	1798 [label="Roathe flüstert ihm Lügen über den Mann in der Wand zu.",shape=box,color=red];
		1798 -> 1805;
	1794 [label="Ich nehme an, dass Entrati ihm zugeflüstert hat, dass die Stimmen seiner Götter tatsächlich aus dem Void kommen, hat nicht geholfen.",shape=box,color=red];
		1794 -> 1801;
	1796 [label="Ich weiß es wirklich nicht.",shape=box,color=red];
		1796 -> 1803;
	1799 [label="Lass uns le Cardinal aus dieser Konversation heraushalten, oui ? Ich mache mir Sorgen um meinen Seelenbruder. Aber... ich weiß, dass das was du sagst ... mehr und mehr die reine Wahrheit wird.",shape=box,color=blue];
		1799 -> 1806;
	3963 [label="Glaub nicht, ich hätte nicht bemerkt, was du gemacht hast, dich selbst als erstes hinzuschmuggeln, Wolf.",shape=box,color=blue];
		3963 -> 1799;
	1800 [label="Und du bist in dieser Angelegenheit keine Hilfe, wenn du so mit ihm redest. Auch wenn diese Worte die Wahrheit sind, muss man darauf achten, wie man sie ausspricht.",shape=box,color=blue];
		1800 -> 1807;
	1802 [label="Oui, er war für so viele eine Zuflucht im Sturm... und jetzt ist er selbst in einem gefangen.",shape=box,color=blue];
		1802 -> 1809;
	1804 [label="Ich habe gehört, wie er diesen Namen aussprach, Rell - das Schicksal dieses Jungen bricht mir das Herz.",shape=box,color=blue];
		1804 -> 1811;
	1805 [label="Der Teufel hat mehr Leid in seinem langen Leben verursacht als so mancher ! Aber ich glaube nicht, dass dies die einzige Ursache für seinen Konflikt ist, non ?",shape=box,color=blue];
		1805 -> 1812;
	1801 [label="S'il te plaît, nichts mehr über le Cardinal. Ich bestreite nicht, dass seine Worte zu Lyons Unruhe beitragen haben, aber sie können nicht die einzige Ursache sein.",shape=box,color=blue];
		1801 -> 1808;
	1803 [label="Dann nehme ich an... wir können nur geduldig sein und hoffen, dass wir herausfinden, was ihn bedrückt.",shape=box,color=blue];
		1803 -> 1810;
	1806 [label="Update boolean MarieEntrati4a",color=orange];
		1806 -> 1781;
	1807 [label="Ein chirurgischer Eingriff sollte nicht mit einer Axt durchgeführt werden. Wir sind nicht in der brittanischen Navy.",shape=box,color=blue];
		1807 -> 1813;
	1809 [label="Nach allen Seiten gezerrt und nicht wissend, welchen Weg er nehmen soll...",shape=box,color=blue];
		1809 -> 1815;
		1809 -> 1816;
	1811 [label="Aber ich glaube nicht, dass das der einzige Grund für seine Unruhe ist? Lyon folgt dem Weg von Lua. La mort est une compagne qui marche à ses côtés",shape=box,color=blue];
		1811 -> 1813;
	1812 [label="Es hat zu seiner Unsicherheit beigetragen... Aber den Worten eines Teufel soviel Bedeutung beizumessen ? Mein Lyon weiß es besser. Ich glaube, dass ihn jetzt viele Dinge belasten.",shape=box,color=blue];
		1812 -> 1818;
		1812 -> 1819;
	1808 [label="Update boolean MarieEntrati4b",color=orange];
		1808 -> 1814;
	1810 [label="+15 Chemistry",color=orange];
		1810 -> 1817;
	1813 [label="Non, ich glaube viele Dinge lasten auf seinen Schultern.",shape=box,color=blue];
		1813 -> 1818;
		1813 -> 1819;
	1815 [label="Dann werden wir seine Zuflucht sein müssen. Ein Ort von dem er weiß, dass er ihm nichts tut.",shape=box,color=red];
		1815 -> 1820;
	1816 [label="Dann werden wir ihm den Weg zurück in die Sicherheit zeigen müssen. Sein Licht in der Dunkelheit sein.",shape=box,color=red];
		1816 -> 1821;
	1818 [label="Dann werden wir ... ihm den Weg zurück in die Sicherheit zeigen müssen. Sein Licht in der Dunkelheit sein.",shape=box,color=red];
		1818 -> 1821;
	1819 [label="Dann werden wir ... seine Zuflucht sein müssen. Ein Ort von dem er weiß, dass er ihm nichts tut.",shape=box,color=red];
		1819 -> 1823;
	1814 [label="Er maß den Worten von le Cardinal nicht genug Bedeutung bei, dass sie ihn in solche Dunkelheit hätten stoßen können. Ich glaube, viele Dinge lasten auf seinen Schultern.",shape=box,color=blue];
		1814 -> 1819;
		1814 -> 1818;
	1817 [label="Merci. Ich weiß, du tust dein Bestes. Und dafür bin ich dir dankbar.",shape=box,color=blue];
		1817 -> 1822;
	1820 [label="+10 Chemistry",color=orange];
		1820 -> 1824;
	1821 [label="Wie hilft man jemandem, der einen Ruf nicht hören und Licht nicht sehen kann ? Non, Lua hat ihn in Dunkelheit gehüllt.",shape=box,color=blue];
		1821 -> 1825;
	1823 [label="+5 Chemistry",color=orange];
		1823 -> 1824;
	1822 [label="Chat ends.",color=orange];
	1824 [label="Oui, ich denke, du hast recht. Wir müssen die sein, an die er sich wenden kann, wenn alles andere versagt.",shape=box,color=blue];
		1824 -> 1826;
	1825 [label="Ich glaube, nicht einmal Sols Licht könnte den Schleier durchdringen.",shape=box,color=blue];
		1825 -> 1826;
	1826 [label="Wo sein Glaube wankt,  müssen wir der feste Boden unter seinen Füßen sein.",shape=box,color=blue];
		1826 -> 1827;
