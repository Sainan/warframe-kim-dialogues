		j737842484 -> j2228185537 [label="MarieEntratiFan1",color=purple];
		j737842484 -> j3671008687 [label="false",color=purple];
	j1591510439 [label="Evaluate expressions",color=orange];
		j1591510439 -> j3561922818 [label="DrifterFaithSol",color=purple];
		j1591510439 -> j3576349105 [label="DrifterFaithLua",color=purple];
		j1591510439 -> j3920244105 [label="DrifterFaithBalance",color=purple];
		j1591510439 -> j3897919184 [label="false",color=purple];
	j3702916532 [label="Mir wurde nur vom Befall erzählt, ich weiß wenig darüber ... aber ich glaube dir. Und wenn das, was ich fühle, wahr ist, und ich bete darum, dann glaube ich nicht, dass sie gefangen ist.",shape=box,color=blue];
		j3702916532 -> j3146199642;
	j1036904848 [label="Das ist wirklich nett von dir. Wenn das, was ich fühle, wahr ist – und ich bete, dass es so ist –, dann, ja, ich glaube, du hast recht. Ich glaube nicht, dass sie gefangen ist.",shape=box,color=blue];
		j1036904848 -> j3146199642;
	j2748115861 [label="Wenn das, was ich fühle, wahr ist, und ich bete darum, dann glaube ich nicht, dass sie gefangen ist.",shape=box,color=blue];
		j2748115861 -> j3146199642;
	j655234070 [label="Wenn das, was ich fühle, wahr ist, und ich bete darum, dann oui, dann hast du recht. Und sie bleiben, um uns zu helfen. Ich glaube ich nicht, dass sie gefangen ist.",shape=box,color=blue];
		j655234070 -> j3146199642;
	j1739060436 [label="Oui, le Cardinal hat mich gesegnet ... aber ich weiß, dass meine Liebe zu ihm nahezu einzigartig ist, denn sie ist nicht durch Kummer, Hass oder Groll getrübt.",shape=box,color=blue];
		j1739060436 -> j3673842290;
	j707424296 [label="Ich weiß, du denkst, er ist eine Art schreckliches Monster. Aber ich muss fragen: Warum misstraust du ihm so sehr ?",shape=box,color=blue];
		j707424296 -> j3658686071;
		j707424296 -> j2046289650;
		j707424296 -> j3780106335;
	j1035587827 [label="Ich dachte, du glaubst an ihn ? Warum dieser plötzliche Sinneswandel ? Bist du so wankelmütig ?",shape=box,color=blue];
		j1035587827 -> j4230798840;
		j1035587827 -> j2547830059;
	j1806378325 [label="Warum misstraust du ihm so sehr ?",shape=box,color=blue];
		j1806378325 -> j3658686071;
		j1806378325 -> j3780106335;
		j1806378325 -> j2046289650;
	j4160900443 [label="Oui, so schnell änderst du deine Meinung ? Du lügst. Wozu, weiß ich nicht. Et je ne veux pas le savoir.",shape=box,color=blue];
		j4160900443 -> j1508231473;
	j2228185537 [label="+5 Chemistry",color=orange];
		j2228185537 -> j1345234783;
	j3671008687 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j3671008687 -> j1345234783;
	j3561922818 [label="Diejenigen von uns, die dem Pfad von Sol folgen, müssen immer das Leitlicht für diejenigen sein, die versuchen, die Abzweigung zu verlassen, nicht wahr ? ",shape=box,color=blue];
		j3561922818 -> j2832735223;
	j3576349105 [label="Du bist ein Anhänger von Lua, du weißt doch, wir lehren, dass manche allein im Schatten wandeln müssen, oui ?",shape=box,color=blue];
		j3576349105 -> j2832735223;
	j3920244105 [label="Du bist ein Anhänger der Himmlischen, du weißt doch, wir lehren, dass manche auf unbekannten Wegen allein wandeln müssen, oui ?",shape=box,color=blue];
		j3920244105 -> j2832735223;
	j3897919184 [label="In meinem Glauben kennen wir diejenigen, die die Wege des Lebens beschreiten und sich an der Kreuzung wiederfinden, an der Lua und Sol aufeinandertreffen.",shape=box,color=blue];
		j3897919184 -> j2832735223;
	j3146199642 [label="Von ihr spüre ich nur Sols warmes Lächeln. Le Cardinal war weise in seiner Wahl, denke ich. Es ist mir eine Ehre, sie in meinen Adern zu tragen.",shape=box,color=blue];
		j3146199642 -> j4241190647;
		j3146199642 -> j4229430968;
		j3146199642 -> j2253121762;
		j3146199642 -> j3691300916;
	j3673842290 [label="Ich verzeihe ihm, dass er uns verlassen hat. Ich glaube, das tut sonst niemand ...",shape=box,color=blue];
		j3673842290 -> j1313358781;
		j3673842290 -> j1378898301;
		j3673842290 -> j3658686071;
		j3673842290 -> j3780106335;
	j3658686071 [label="Er ... kam nach Duviri. Vor langer Zeit ...",shape=box,color=red];
		j3658686071 -> j3580348034;
	j2046289650 [label="Nun, zunächst einmal schoss er mir in die Brust und ließ mich sterbend zurück.",shape=box,color=red];
		j2046289650 -> j1625352245;
	j3780106335 [label="Er hinterlässt nichts als Schmerz, Tod und Verlassenheit.",shape=box,color=red];
		j3780106335 -> j1591510439;
	j4230798840 [label="Ich habe ihm nie getraut, ich wollte dich nur nicht verschrecken.",shape=box,color=red];
		j4230798840 -> j3992737367;
	j2547830059 [label="Ich wollte zuvor nicht lügen, ich wusste nur nicht, wie ich das Thema ansprechen sollte. Du verehrst ihn offensichtlich ...",shape=box,color=red];
		j2547830059 -> j838050093;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j1345234783 [label="Ja, wir müssen stark bleiben ! Braves contre les ténèbres, pour toujours et à jamais !",shape=box,color=blue];
		j1345234783 -> j2217155752;
	j2832735223 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j2832735223 -> j3012972972;
	j1313358781 [label="Er hat viele verletzt und im Stich gelassen, da hast du recht. Und ich glaube, er glaubt, dass er das tun musste.",shape=box,color=red];
		j1313358781 -> j1930699843;
	j1378898301 [label="Es ist hart, wenn jemand, der einem so viel bedeutet – den man liebt und auf den man sich verlässt – weggeht. Vor allem, wenn man nicht weiß, warum. Oder ob eine Rückkehr zu erwarten ist.",shape=box,color=red];
		j1378898301 -> j2169577895;
	j3580348034 [label="Sol ! Diese Welt, die du erschaffen hast, beschworen aus dem Buch seiner Tochter, oui ? Monsieur Loid hat davon gesprochen ... Le Cardinal war da ? Warum ? ",shape=box,color=blue];
		j3580348034 -> j3007471844;
		j3580348034 -> j3894256092;
		j3580348034 -> j415416081;
	j1625352245 [label="Et pourtant, vous êtes toujours en vie ! Du lebst, nicht wahr ? Und es geht dir gut? Und es geht dir prächtig, wenn man Monsieur Loids Erzählungen über deine Abenteuer in der Vergangenheit und Zukunft Glauben schenken darf.",shape=box,color=blue];
		j1625352245 -> j4231093281;
	j3992737367 [label="Ah, je vois ! Je suis une idiote, c'est ça ?! Juste une petite invalide venue d'un passé lointain, incapable de penser par elle-même ?! Mieux vaut l'approcher comme un faon dans les bois, de peur de l'effrayer !",shape=box,color=blue];
		j3992737367 -> j2523403966;
	j838050093 [label="Ah, oui ... ich habe es dir nicht leicht gemacht, die Wahrheit zu sagen, n'est-ce pas ?",shape=box,color=blue];
		j838050093 -> j472821477;
	j2217155752 [label="Ich habe ihm verziehen, dass er uns verlassen hat. Ich glaube, das tut sonst niemand ...",shape=box,color=blue];
		j2217155752 -> j1313358781;
		j2217155752 -> j1378898301;
	j3012972972 [label="Le Cardinal muss den Weg zurück zu uns finden. Wir können nur tun, was in unserer Macht ist, um ihm zu helfen, wenn er ruft, und tun, was die, die wie er gesegnet sind, uns sagen.",shape=box,color=blue];
		j3012972972 -> j989297039;
	j1930699843 [label="+5 Chemistry",color=orange];
		j1930699843 -> j1145120567;
	j2169577895 [label="+5 Chemistry",color=orange];
		j2169577895 -> j999284554;
	j3007471844 [label="Ich glaube, zunächst suchte ein Teil von ihm nach der Tochter, die er zurückgelassen hat. Stattdessen fand er einen Weg, die Gleichgültigkeit zu bekämpfen – mit den Emotionen, von denen er Abstand halten wollte.",shape=box,color=red];
		j3007471844 -> j396189975;
	j3894256092 [label="Seine Notizen enthalten eine sehr widerlich selbstschmeichelnde Geschichte darüber, dass er konzeptionelle Verkörperung studieren wollte und stattdessen lernte, wie wertvoll es ist, die Gleichgültigkeit zu bekämpfen.",shape=box,color=red];
		j3894256092 -> j1160749504;
	j415416081 [label="Seinen Notizen zufolge, war er dort, um Duviri – und damit auch mir – beizubringen, wie man sich gegen die Gleichgültigkeit wehrt. Welchen Nutzen das letztlich auch hatte.",shape=box,color=red];
		j415416081 -> j3452660099;
	j4231093281 [label="Check boolean IsDating",color=orange];
		j4231093281 -> j2233654633 [label=true,color=green];
		j4231093281 -> j2493462148 [label=false,color=brown];
	j2523403966 [label="Va t'asseoir sur une ruche.",shape=box,color=blue];
		j2523403966 -> j1508231473;
	j472821477 [label="Dann sag mir jetzt die Wahrheit, Wolf. Warum glaubst du, dass man ihm nicht trauen kann? Und ich werde versuchen, meine Fassung zu bewahren.",shape=box,color=blue];
		j472821477 -> j1378898301;
		j472821477 -> j3658686071;
		j472821477 -> j3780106335;
		j472821477 -> j2046289650;
	j989297039 [label="Evaluate expressions",color=orange];
		j989297039 -> j3089713459 [label="MarieEntratiMonster1",color=purple];
		j989297039 -> j4247064499 [label="MarieEntratiMonster1",color=purple];
		j989297039 -> j3089713459 [label="MarieEntratiFan1",color=purple];
		j989297039 -> j4152702498 [label="MarieEntratiFan1",color=purple];
		j989297039 -> j3089713459 [label="false",color=purple];
		j989297039 -> j4247064499 [label="false",color=purple];
		j989297039 -> j4152702498 [label="false",color=purple];
		j989297039 -> j3781350682 [label="false",color=purple];
	j1145120567 [label="Oui, du hast recht. Ich glaube, er hat Schuldgefühle für alles, was er getan hat. Ich glaube, er distanziert sich ganz bewusst von anderen.",shape=box,color=blue];
		j1145120567 -> j2296500187;
	j999284554 [label="Oui, es ist eine schreckliche Trauer, ein furchtbarer Schmerz. Zu wissen, dass jemand ... noch lebt und sich scheinbar dafür entschied, nicht an deiner Seite zu sein ?",shape=box,color=blue];
		j999284554 -> j2296500187;
	j396189975 [label="Mon cœur se brise dans la tragédie – Ich glaube nicht, dass ich die Traurigkeit dessen ertragen kann ... und trotzdem, will sie ihm nicht vergeben ?",shape=box,color=blue];
		j396189975 -> j16899797;
		j396189975 -> j2052821575;
	j1160749504 [label="Weißt du, warum er fortging ?",shape=box,color=blue];
		j1160749504 -> j16899797;
		j1160749504 -> j423181938;
	j3452660099 [label="Wie meinst du das ? ",shape=box,color=blue];
		j3452660099 -> j2790765526;
		j3452660099 -> j2094994044;
	j2233654633 [label="Wenn die Gerüchte unter den Cavia wahr sind, vous y avez vraiment trouvé beaucoup de joie, non ?",shape=box,color=blue];
		j2233654633 -> j2493462148;
	j2493462148 [label="Non, le Cardinal hat vielen anderen weitaus Schlimmeres angetan. Du bist einfach nur verärgert, weil dir Unannehmlichkeiten bereitet wurden.",shape=box,color=blue];
		j2493462148 -> j1591510439;
	j3089713459 [label="Ich wünschte nur ... wir könnten alle um Entrati herum davon überzeugen, sich nicht mehr selbst und anderen die Schuld für das Geschehene zu geben.",shape=box,color=red];
		j3089713459 -> j2956894394;
	j4247064499 [label="Ich weiß nicht, ob ich ihn jemals als gesegnet bezeichnen würde.",shape=box,color=red];
		j4247064499 -> j22460418;
	j4152702498 [label="Es wäre viel einfacher, Entrati seine Missetaten zu verzeihen, wenn ich sie verstehen könnte.",shape=box,color=red];
		j4152702498 -> j3461352138;
	j3781350682 [label="Ich werde tun, was er von mir verlangt, um dieses Problem zu lösen. Und dann werde ich über ihn urteilen, wenn alles gesagt und getan ist.",shape=box,color=red];
		j3781350682 -> j887198345;
	j2296500187 [label="Il inflige la douleur dans le cœur des autres, car la douleur vaut mieux que rien du tout. Denn Leiden ist besser als Leere, non ?",shape=box,color=blue];
		j2296500187 -> j1390233082;
	j16899797 [label="Wenn er keine Erklärung hat, können wir uns leider nur unsere eigenen Gründe ausdenken.",shape=box,color=red];
		j16899797 -> j859112770;
	j2052821575 [label="Du verstehst es nicht. Er hat mich dort zurückgelassen. Er sah jemanden, verlassen im Void, und er ließ mich dort.",shape=box,color=red];
		j2052821575 -> j2535435472;
	j423181938 [label="Nein. Ich weiß nur, dass er mich dort zurückließ. Er sah jemanden, verlassen im Void, und ... ließ mich dort.",shape=box,color=red];
		j423181938 -> j859112770;
	j2790765526 [label="Er hat mich dort zurückgelassen. Irgendwann kam er an, ich weiß nicht wann, und sah jemanden, verlassen im Void, und ... ließ mich dort zurück.",shape=box,color=red];
		j2790765526 -> j2535435472;
	j2094994044 [label="Die Gleichgültigkeit kam am Ende trotzdem nach Duviri. (Obwohl sie unerwartete Hilfe erhielt. Aber das tut jetzt nichts zur Sache.)",shape=box,color=red];
		j2094994044 -> j426613527;
	j2956894394 [label="Boolean MarieEntratiFamily is now true.",color=orange];
		j2956894394 -> j3841825190;
	j22460418 [label="Dann einigen wir uns, glaube ich, weiterhin darauf, anderer Meinung zu sein.",shape=box,color=blue];
		j22460418 -> j1554011687;
	j3461352138 [label="Ich bete, dass es uns am Ende gelingt. Ich bete, wir alle überleben und erleben es. Aber jetzt sehe ich famille um mich herum und bete, sie finden Vergebung in ihren Herzen. Für ihr eigenes Glück.",shape=box,color=blue];
		j3461352138 -> j7331651;
	j887198345 [label="+10 Chemistry",color=orange];
		j887198345 -> j3920880722;
	j1390233082 [label="Das ist eine Lektion, die mein liebster Lyon besser kennt als die meisten ... Ich bin so froh, dass er jetzt mit dir redet. Aber wir reden heute über le Cardinal.",shape=box,color=blue];
		j1390233082 -> j221931327;
	j859112770 [label="Ich vermute, dass dies vor dem ... Mord ad infinitum geschah.",shape=box,color=red];
		j859112770 -> j3420623998;
	j2535435472 [label="Und du weißt nicht, warum er dich dort zurückgelassen hat ?",shape=box,color=blue];
		j2535435472 -> j4214232361;
		j2535435472 -> j859112770;
		j2535435472 -> j192798608;
	j426613527 [label="Non. Moment. L'Indifférence hat ... einen Verbündeten ?",shape=box,color=blue];
		j426613527 -> j2696630003;
		j426613527 -> j3304831143;
	j3841825190 [label="Add 1 to Family counter",color=orange];
		j3841825190 -> j3815066362;
	j1554011687 [label="Boolean MarieEntratiMonster2 is now true.",color=orange];
		j1554011687 -> j4238609287;
	j7331651 [label="Boolean MarieEntratiFan2 is now true.",color=orange];
		j7331651 -> j4238609287;
	j3920880722 [label="Oui, c'est raisonnable und durchaus fair, angesichts all dessen, was du gesehen hast und weißt. Mehr kann ich von dir nicht verlangen.",shape=box,color=blue];
		j3920880722 -> j930710568;
	j221931327 [label="Boolean MarieLyonSuffering3 is now true.",color=orange];
		j221931327 -> j1591510439;
	j3420623998 [label="Dann bitte ich dich, nicht das Schlimmste von ihm anzunehmen, denn das würde dein Herz verbittern.",shape=box,color=blue];
		j3420623998 -> j3918025746;
	j4214232361 [label="Ich hoffe einfach nur, dass er einen guten Grund hatte.",shape=box,color=red];
		j4214232361 -> j3949402244;
	j192798608 [label="Nein, und es spielt keine Rolle. Er hätte mich retten können. Und er tat es nicht.",shape=box,color=red];
		j192798608 -> j1990729314;
	j2696630003 [label="Sie trägt einfach ein anderes Gesicht.",shape=box,color=red];
		j2696630003 -> j2600493938;
	j3304831143 [label="Möglich? Oder eine Geisel. Oder sie trägt einfach ihr Gesicht. Wir wissen es nicht genau.",shape=box,color=red];
		j3304831143 -> j2600493938;
	j3815066362 [label="+10 Chemistry",color=orange];
		j3815066362 -> j1256958290;
	j4238609287 [label="Ah, Lyon ruft mich an. À la revoyure !",shape=box,color=blue];
		j4238609287 -> "Chat ends.";
	j930710568 [label="Boolean MarieEntratiNeutral is now true.",color=orange];
		j930710568 -> j4238609287;
	j3918025746 [label="Vielleicht wolltest du Duviri noch nicht aufgeben. Vielleicht war es dir noch nicht vergrämt. Vielleicht wolltest du Freunde nicht verlassen ?",shape=box,color=blue];
		j3918025746 -> j920322122;
	j3949402244 [label="+5 Chemistry",color=orange];
		j3949402244 -> j996421294;
	j1990729314 [label="Kannst du behaupten, dass es auf keinen Fall einen Grund gibt, in keinem Dasein, warum er dich zurückgelassen hat? ",shape=box,color=blue];
		j1990729314 -> j3918025746;
	j2600493938 [label="Boolean MarieNeci is now true.",color=orange];
		j2600493938 -> j3102500442;
	j1256958290 [label="Ooh, was für ein Gedanke. Ich denke, das ist eine Sache, für die es sich zu kämpfen lohnt !",shape=box,color=blue];
		j1256958290 -> j3612371029;
	j920322122 [label="Vielleicht wusste er nicht, ob er dich daraus befreien konnte, aus Angst, vor einem Zusammenbruch im fragilen Zustand. Vielleicht dachte er, l'Indifférence würde es einfordern, wärst du weg. Peut-être, peut-être, peut-être.",shape=box,color=blue];
		j920322122 -> j1591510439;
	j996421294 [label="Merci, merci – das liegt mir am Herzen. Wir dürfen nicht vom Schlimmsten ausgehen, denn das macht unsere Herzen am bittersten.",shape=box,color=blue];
		j996421294 -> j4010633984;
	j3102500442 [label="Ich weiß nicht, was ich davon halten soll ... aber es ist ziemlich seltsam ...",shape=box,color=blue];
		j3102500442 -> j2535435472;
	j3612371029 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j3612371029 -> j1905297345 [label=true,color=green];
		j3612371029 -> j201643798 [label=false,color=brown];
	j4010633984 [label="Vielleicht wolltest du Duviri noch nicht aufgeben. Vielleicht war es dir noch nicht vergrämt. Vielleicht wolltest du Freunde nicht verlassen ?",shape=box,color=blue];
		j4010633984 -> j920322122;
	j1905297345 [label="Du und die winzige Kopie haben sich bei seiner Familie schon so gut geschlagen ... Hmm, jetzt werde ich Pläne schmieden !",shape=box,color=blue];
		j1905297345 -> j4238609287;
	j201643798 [label="Hmm ... jetzt schmiede ich Pläne ! Aber zuerst musst du deine Arbeit mit seiner Familie oben fortsetzen. Du oder die winzige Kopie.",shape=box,color=blue];
		j201643798 -> j4238609287;
}