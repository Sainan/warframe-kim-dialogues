	j766913761 [label="Ich fürchte, wir wissen nicht viel über die Leute, die in die ursprünglichen Warframes verwandelt wurden.",shape=box,color=red];
		j766913761 -> j119993671;
	j3216415974 [label="Über die ursprüngliche Wisp ist nicht viel bekannt, fürchte ich.",shape=box,color=red];
		j3216415974 -> j119993671;
	j3924307684 [label="Wolf, erzähl mir von dieser hier namens \"Wisp\", deren korrumpiertes Blut in mir fließt und die mir dieses Geschenk des Fliegens gegeben hat und deren Seele ich im Schatten der Nacht so nah neben meiner eigenen spüre.",shape=box,color=blue];
		j3924307684 -> j4238544572;
		j3924307684 -> j792901223;
	j2049592446 [label="Wolf, erzähl mir von dieser hier namens \"Wisp\", deren korrumpiertes Blut in mir fließt und die mir dieses Geschenk des Fliegens gegeben hat und deren Seele ich im Schatten der Nacht so nah neben meiner eigenen spüre.",shape=box,color=blue];
		j2049592446 -> j3731404710;
	j119993671 [label="Vraiment ? Sind die Aufzeichnungen im Laufe der Zeit verloren gegangen oder glaubst du, dass sie einfach als nicht wichtig genug erachtet wurden, um sich daran zu erinnern ?",shape=box,color=blue];
		j119993671 -> j4161655687;
		j119993671 -> j2590767754;
		j119993671 -> j965153311;
	j4238544572 [label="Ich fürchte, wir wissen nicht viel über die Leute, die in die ursprünglichen Warframes verwandelt wurden.",shape=box,color=red];
		j4238544572 -> j3312884528;
	j792901223 [label="Über die ursprüngliche Wisp ist nicht viel bekannt, fürchte ich.",shape=box,color=red];
		j792901223 -> j3312884528;
	j3731404710 [label="Wenn dir die Diskussion über Seelen nichts ausmacht ? Ich verstehe, falls doch, und wir können es auf praktischere Dinge beschränken. Ich möchte dir keine Unannehmlichkeiten bereiten.",shape=box,color=blue];
		j3731404710 -> j1361738883;
		j3731404710 -> j3067922834;
		j3731404710 -> j129698615;
	j4161655687 [label="Ich glaube, sie waren nicht wichtig genug, um sich an sie zu erinnern.",shape=box,color=red];
		j4161655687 -> j623674969;
	j2590767754 [label="Ich glaube, sie sind im Laufe der Zeit verloren gegangen.",shape=box,color=red];
		j2590767754 -> j623674969;
	j965153311 [label="Letztendlich ein bisschen von beidem. Für ihren Schöpfer waren sie ... teils Waffe, teils Kunstwerk.",shape=box,color=red];
		j965153311 -> j2133612339;
	j3312884528 [label="Vraiment? Denn ich habe das Gefühl, sie zu kennen, als wäre sie meine eigene Schwester – eine vom eigenen Blut, nicht eine von der Cathédrale.",shape=box,color=blue];
		j3312884528 -> j948437253;
	j1361738883 [label="Schon gut, wir können uns über Seelen unterhalten.",shape=box,color=red];
		j1361738883 -> j4238544572;
		j1361738883 -> j792901223;
		j1361738883 -> j129698615;
	j3067922834 [label="Ich glaube nicht wirklich an Seelen, können wir uns, wenn möglich, auf harte Fakten beschränken?",shape=box,color=red];
		j3067922834 -> j484329457;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j623674969 [label="Siehst du ? Ces Orokin, sie sind Teufel.",shape=box,color=blue];
		j623674969 -> j1848129823;
		j623674969 -> j1382687394;
	j2133612339 [label="+5 Chemistry",color=orange];
		j2133612339 -> j2778553126;
	j948437253 [label="Ich höre sie nicht, nicht so, wie Lyon die Götter und seine Schutzgeister hört. Ich sehe sie nicht. Ich spüre sie einfach dort, neben mir.",shape=box,color=blue];
		j948437253 -> j304661696;
	j484329457 [label="Boolean DrifterFaithStop is now true.",color=orange];
		j484329457 -> j1273990951;
	"Chat ends." [color=orange];
	j1848129823 [label="Waffen können sowohl zum Schutz als auch zum Schaden eingesetzt werden. Wir haben es nicht gern sie zu benötigen, aber... wir brauchen sie.",shape=box,color=red];
		j1848129823 -> j738589746;
	j1382687394 [label="Nicht alle. Aber der da? Ja. Es gibt noch welche, die ich nicht sofort verurteilen würde.",shape=box,color=red];
		j1382687394 -> j3175593596;
	j2778553126 [label="Une horrible toile d'os peinte avec du sang ... verstehst du? Ces Orokin, das sind Teufel.",shape=box,color=blue];
		j2778553126 -> j1848129823;
		j2778553126 -> j1382687394;
	j304661696 [label="Ähnlich wie eine alte Freundin. Ich weiß, was sie mochte, ich weiß, wie sie sich bewegte. Ich erinnere mich an den Klang ihres Lachens im Wind ...",shape=box,color=blue];
		j304661696 -> j1410037732;
	j1273990951 [label="+5 Chemistry",color=orange];
		j1273990951 -> j3733151176;
	j738589746 [label="Add -1 to Thermostat counter",color=orange];
		j738589746 -> j498977722;
	j3175593596 [label="Add 1 to Thermostat counter",color=orange];
		j3175593596 -> j1087568329;
	j1410037732 [label="Ich muss mich für dich ziemlich verrückt anhören! Verzeih mir.",shape=box,color=blue];
		j1410037732 -> j677387860;
		j1410037732 -> j1065115834;
		j1410037732 -> j1868091798;
		j1410037732 -> j1522895975;
	j3733151176 [label="Oui, bien sûr ! Niemand möchte belehrt werden, schon gar nicht von einer Nonne. Ich verstehe. Merci, ich wollte mich nicht lächerlich machen.",shape=box,color=blue];
		j3733151176 -> j766913761;
		j3733151176 -> j3216415974;
		j3733151176 -> j129698615;
	j498977722 [label="Ja, das stimmt. Ich bin jetzt eine Waffe, wie das Raunen nur zu gut weiß! Aber ich möchte dem Weg folgen, den le Cardinal mir gewiesen hat, so gesegnet er ist.",shape=box,color=blue];
		j498977722 -> j2253121762;
		j498977722 -> j3691300916;
	j1087568329 [label="Wie le Cardinal. Er war Orokin, nicht wahr ? Und ich würde ihn ganz sicher nicht verurteilen. Ohne ihn wäre ich nicht das, was ich jetzt bin. Gesegnet.",shape=box,color=blue];
		j1087568329 -> j4229430968;
		j1087568329 -> j4241190647;
	j677387860 [label="Warframes wurden ... nicht gerade auf nette Art hergestellt. Ich hoffe nur, dass sie nicht im Befall gefangen ist.",shape=box,color=red];
		j677387860 -> j2804701106;
	j1065115834 [label="Ich glaube, wer auch immer Wisp war, sie würde sich freuen, dich kennenzulernen.",shape=box,color=red];
		j1065115834 -> j3061329726;
	j1868091798 [label="Ich hoffe, dass ihre Seelen weiterziehen und Ruhe finden konnten, aber ich denke, ein Teil ihrer Erinnerung bleibt bestehen.",shape=box,color=red];
		j1868091798 -> j1758981254;
	j1522895975 [label="Überhaupt nicht. Ich glaube, dass ein Teil derer, die in Warframes verwandelt wurden, in ihren Grundschemata verblieben sind.",shape=box,color=red];
		j1522895975 -> j4013411498;
	j2253121762 [label="Ich könnte über vieles mit ihm streiten, aber ich gebe zu, er scheint ein gutes Gespür dafür zu haben, wem er welches Protoframe-Serum geben soll. Auch wenn ich nicht weiß, warum er es tut.",shape=box,color=red];
		j2253121762 -> j1948379513;
	j3691300916 [label="Ich wünschte, du würdest Entrati nicht so sehr vertrauen. Wir wissen nicht, warum er tut, was er tut, und seine Motive sind unklar.",shape=box,color=red];
		j3691300916 -> j1722407835;
	j4229430968 [label="Wir müssen uns an Entrati halten. Ich denke, wir müssen ihm einfach folgen. Er ist unsere einzige Chance, die Gleichgültigkeit zu stoppen.",shape=box,color=red];
		j4229430968 -> j737842484;
	j4241190647 [label="Er ist ein Lügner, Marie. Er verletzt und lässt jeden in seinem Leben im Stich. Er hat dich bereits im Stich gelassen, verstehst du das nicht?",shape=box,color=red];
		j4241190647 -> j1591510439;
	j2804701106 [label="+5 Chemistry",color=orange];
		j2804701106 -> j3702916532;
	j3061329726 [label="+5 Chemistry",color=orange];
		j3061329726 -> j1036904848;
	j1758981254 [label="+5 Chemistry",color=orange];
		j1758981254 -> j2748115861;
