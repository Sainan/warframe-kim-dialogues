digraph {
	"MarieRank3Convo2 begins." [color=orange];
		"MarieRank3Convo2 begins." -> j3102612293;
	j3102612293 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j3102612293 -> j369807617;
	j369807617 [label="Check boolean LoidFamilyComplete",color=orange];
		j369807617 -> j2047112817 [label=true,color=green];
		j369807617 -> j1668831657 [label=false,color=brown];
	j2047112817 [label="Ich hoffe, du hältst mich nicht für infirme... aber manchmal habe ich das seltsame Gefühl, als hätte ich das alles schon einmal getan ?",shape=box,color=blue];
		j2047112817 -> j2971519368;
	j1668831657 [label="Check boolean MarieFamily1",color=orange];
		j1668831657 -> j879114065 [label=true,color=green];
		j1668831657 -> j864368806 [label=false,color=brown];
	j2971519368 [label="Habe diese Unterhaltungen geführt... diese Leute getroffen... obwohl das unmöglich ist, non ?",shape=box,color=blue];
		j2971519368 -> j938489281;
	j879114065 [label="Erzählst du mir mehr von der famille von le Cardinal ? Seine Vergangenheit fasziniert mich.",shape=box,color=blue];
		j879114065 -> j4075839083;
		j879114065 -> j1381204226;
		j879114065 -> j129698615;
	j864368806 [label="Erzählst du mir von der famille von le Cardinal ? Seine Vergangenheit fasziniert mich.",shape=box,color=blue];
		j864368806 -> j4075839083;
		j864368806 -> j1381204226;
		j864368806 -> j129698615;
	j938489281 [label="+20 Chemistry",color=orange];
		j938489281 -> j2641210182;
	j4075839083 [label="Ich sage dir, was ich weiß, aber ich fürchte, ich weiß nicht so viel, wie du vielleicht glaubst.",shape=box,color=red];
		j4075839083 -> j2717204153;
	j1381204226 [label="Oh. Sicher, aber ... wäre Loid nicht der bessere Ansprechpartner?",shape=box,color=red];
		j1381204226 -> j1528149216;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j2641210182 [label="Nennen wir es ein déjà vu. Muss wohl das sérum sein und das Zeitreisen. C'est la vie !",shape=box,color=blue];
		j2641210182 -> "Chat ends.";
	j2717204153 [label="Was immer du mir erzählen kannst, werde ich in Ehren halten. Promis !",shape=box,color=blue];
		j2717204153 -> j1106428135;
	j1528149216 [label="Über le Cardinal zu sprechen ... scheint Monsieur Loid sehr zu verletzen. Das möchte ich nicht allzu sehr tun.",shape=box,color=blue];
		j1528149216 -> j1106428135;
	"Chat ends." [color=orange];
	j1106428135 [label="Vor allem, weil ich es avec une certaine joie tue, was sonst niemand zu tun scheint.",shape=box,color=blue];
		j1106428135 -> j2480201537;
		j1106428135 -> j4284337065;
	j2480201537 [label="Über wen möchtest du etwas wissen?",shape=box,color=red];
		j2480201537 -> j3858098732;
	j4284337065 [label="Also, oben gibt es gibt Mutter, Vater, Sohn, Tochter und Großmutter.",shape=box,color=red];
		j4284337065 -> j3858098732;
	j3858098732 [label="Lass uns erst etwas klären, ja ? Der Teufel lacht mich jedes Mal aus, wenn ich frage, als wäre es ein Scherz, den nur er versteht. Grand-mère. Großmutter.",shape=box,color=blue];
		j3858098732 -> j4231475650;
	j4231475650 [label="Das ist doch nicht die Frau von le Cardinal, non ?",shape=box,color=blue];
		j4231475650 -> j3303437624;
	j3303437624 [label="Nein, das ist Vaters Mutter. Mutters Schwiegermutter.",shape=box,color=red];
		j3303437624 -> j1480758325;
	j1480758325 [label="Je ... vois. Und ... warum nennt man sie nicht bei ihren Namen ? Ne serait-ce pas plus simple ?",shape=box,color=blue];
		j1480758325 -> j1709800189;
		j1480758325 -> j1511945477;
	j1709800189 [label="Willst du die ganze Geschichte hören?",shape=box,color=red];
		j1709800189 -> j4094712793;
	j1511945477 [label="Ich gebe dir eine Zusammenfassung.",shape=box,color=red];
		j1511945477 -> j974241060;
	j4094712793 [label="Oui ! Ich muss im Augenblick nirgendwo hin.",shape=box,color=blue];
		j4094712793 -> j3473327580;
	j974241060 [label="Die Familie oben war hier gefangen, als das Imperium der Orokin zerbrach. Sohn, Entratis Enkel, ließ den Befall herein.",shape=box,color=red];
		j974241060 -> j1727123746;
	j3473327580 [label="Also, wir befinden uns auf einem Mond namens Deimos. Und hier wurde vor langer Zeit eine biologische Bombe gezündet, in einem verzweifelten Versuch, die Sentients abzuwehren.",shape=box,color=red];
		j3473327580 -> j442857259;
	j1727123746 [label="Par Sol ! Mit Absicht ?",shape=box,color=blue];
		j1727123746 -> j2060196651;
	j442857259 [label="Diejenigen, mit denen die Orokin vor so langer Zeit im Krieg lagen ? Diejenigen, die wir in der Dunklen Spiegelung mit dem Teufel sehen, oui ?",shape=box,color=blue];
		j442857259 -> j2418771964;
	j2060196651 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j2060196651 -> j1433240824 [label=true,color=green];
		j2060196651 -> j2370678624 [label=true,color=green];
		j2060196651 -> j4255342777 [label=false,color=brown];
	j2418771964 [label="Ja. Sie haben versucht, den Befall zu nutzen, um die Sentients zu bekämpfen. Aber Deimos wurde überrannt. Sie verbarrikadierten sich im Necralisk - der über uns ist - um Schutz zu suchen.",shape=box,color=red];
		j2418771964 -> j1996888448;
	j1433240824 [label="Nein, ich glaube, es war ein Unfall. Ich glaube, er meint es gut.",shape=box,color=red];
		j1433240824 -> j2798403824;
	j2370678624 [label="Ich kenne die Wahrheit noch nicht, aber ich behalte mir ein Urteil vor, bis ich mehr weiß.",shape=box,color=red];
		j2370678624 -> j2798403824;
	j4255342777 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j4255342777 -> j1433240824 [label=true,color=green];
		j4255342777 -> j2370678624 [label=true,color=green];
		j4255342777 -> j2370678624 [label=false,color=brown];
		j4255342777 -> j3611988287 [label=false,color=brown];
	j1996888448 [label="Sohn, Entratis Enkel, war jedoch fest entschlossen zu versuchen, die befallenen Tiere zu retten und zu studieren.",shape=box,color=red];
		j1996888448 -> j3141354881;
	j2798403824 [label="+10 Chemistry",color=orange];
		j2798403824 -> j3136647234;
	j3611988287 [label="Ich kenne die Wahrheit noch nicht, aber er ist arrogant, soviel kann ich dir sagen.",shape=box,color=red];
		j3611988287 -> j2772924256;
	j3141354881 [label="Oh, Sol ... meinte er es gut ?",shape=box,color=blue];
		j3141354881 -> j616297335;
	j3136647234 [label="Sehr nett von dir. Continuez, s'il vous plaît.",shape=box,color=blue];
		j3136647234 -> j1377364404;
	j2772924256 [label="Solch Schande. Ich hoffe, das ist nicht wahr, ihm und uns zuliebe. Bitte erzähl weiter.",shape=box,color=blue];
		j2772924256 -> j1377364404;
	j616297335 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j616297335 -> j1328100232 [label=true,color=green];
		j616297335 -> j3560430792 [label=true,color=green];
		j616297335 -> j1749998635 [label=true,color=green];
		j616297335 -> j3220361227 [label=false,color=brown];
	j1377364404 [label="Naja, gefangen im Necralisk, zerfressen von Trauer, keine Orokin Imperium, das sie retten konnte und jetzt dringt auch noch der Befall ein ...",shape=box,color=red];
		j1377364404 -> j4222080705;
	j1328100232 [label="Ja, ich glaube schon. Ich glaube, die Tiere waren ihm wirklich wichtig.",shape=box,color=red];
		j1328100232 -> j454504843;
	j3560430792 [label="Leider, hat es nicht geholfen, der Schaden war bereits angerichtet.",shape=box,color=red];
		j3560430792 -> j2055342866;
	j1749998635 [label="Nein, es war Arroganz, die ihn inspirierte. Auch wenn er behauptet, es sei ein Unfall gewesen.",shape=box,color=red];
		j1749998635 -> j76440873;
	j3220361227 [label="Check boolean nil",color=orange];
		j3220361227 -> j1328100232 [label=true,color=green];
		j3220361227 -> j3560430792 [label=true,color=green];
		j3220361227 -> j1749998635 [label=true,color=green];
		j3220361227 -> j1328100232 [label=false,color=brown];
		j3220361227 -> j3560430792 [label=false,color=brown];
		j3220361227 -> j103276302 [label=false,color=brown];
	j4222080705 [label="Da wandten sie sich gegeneinander. Zerrissen sich gegenseitig, von innen heraus. Und der Befall erledigte den Rest. Er entwendete ihnen sogar die Namen.",shape=box,color=red];
		j4222080705 -> j2458684868;
	j454504843 [label="+10 Chemistry",color=orange];
		j454504843 -> j3580176365;
	j2055342866 [label="+5 Chemistry",color=orange];
		j2055342866 -> j2452118805;
	j76440873 [label="Schäm dich. Ich hoffe, das ist nicht wahr, ihm und uns zuliebe. Bitte erzähl weiter.",shape=box,color=blue];
		j76440873 -> j1377364404;
	j103276302 [label="Ich kenne die Wahrheit noch nicht, aber er ist arrogant, soviel kann ich dir sagen.",shape=box,color=red];
		j103276302 -> j76440873;
	j2458684868 [label="Es ist die ultimative Form der Grausamkeit, nicht mal einen Namen zu haben ...",shape=box,color=blue];
		j2458684868 -> j482800561;
	j3580176365 [label="Ich frage mich, was er von den Cavia halten würde ... zu schade, dass er sie nicht treffen kann ...",shape=box,color=blue];
		j3580176365 -> j1101952709;
		j3580176365 -> j663855993;
	j2452118805 [label="Wenn es nur alleine auf die Reinheit der Absicht ankäme, wäre die Welt ein wundervoller Ort, non ? C'est la vie.",shape=box,color=blue];
		j2452118805 -> j422244115;
	j482800561 [label="Boolean MarieFamily2 is now true.",color=orange];
		j482800561 -> j940566821;
		j482800561 -> j3305431520;
		j482800561 -> j56359520;
	j1101952709 [label="Ich lächele bei dem Gedanken. Aber ich glaube nicht, es wäre weise.",shape=box,color=red];
		j1101952709 -> j2376107196;
	j663855993 [label="Ich hoffe, das passiert eines Tages. Wirklich.",shape=box,color=red];
		j663855993 -> j3948333923;
	j422244115 [label="Et ensuite ?",shape=box,color=blue];
		j422244115 -> j1377364404;
	j940566821 [label="Es sei denn, du gibst ihn fort, wie Großmutter.",shape=box,color=red];
		j940566821 -> j4003410382;
	j3305431520 [label="Es ist eigentlich nicht so schlimm, man gewöhnt sich daran.",shape=box,color=red];
		j3305431520 -> j673367435;
	j56359520 [label="Tiere haben auch keine Namen und scheinen völlig glücklich zu sein. Wir geben nur aus Eigennutz einen Namen.",shape=box,color=red];
		j56359520 -> j3138890663;
	j2376107196 [label="Und warum nicht ?",shape=box,color=blue];
		j2376107196 -> j3774716710;
		j2376107196 -> j1939689457;
	j3948333923 [label="Add 1 to Family counter",color=orange];
		j3948333923 -> j2139319721;
	j4003410382 [label="+5 Chemistry",color=orange];
		j4003410382 -> j3562674099;
	j673367435 [label="Aaah ! Quelle horreur ! So habe ich das nicht gemein. Ich bin beschämt ! Es tut mir so leid, vergib mir bitte, so meinte ich das wirklich nicht, ich bin so ein Narr !",shape=box,color=blue];
		j673367435 -> j2597760623;
		j673367435 -> j1518963760;
	j3138890663 [label="+5 Chemistry",color=orange];
		j3138890663 -> j4182522442;
	j3774716710 [label="Ich fürchte, die eine Hälfte, wird die andere Hälfte als \"die andere Familie\" betrachten.",shape=box,color=red];
		j3774716710 -> j719137162;
	j1939689457 [label="Die Situation oben ist ... sogar an guten Tagen zerbrechlich. Ich möchte sie nicht verstimmen.",shape=box,color=red];
		j1939689457 -> j1299372986;
	j2139319721 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j2139319721 -> j805603015 [label=true,color=green];
		j2139319721 -> j1740816331 [label=false,color=brown];
	j3562674099 [label="Sie klingt nach einer Dame, die ich gerne mal treffen würde ...",shape=box,color=blue];
		j3562674099 -> j2850468367;
	j2597760623 [label="Wie willst du das wiedergutmachen?",shape=box,color=red];
		j2597760623 -> j1729413184;
	j1518963760 [label="Ist schon gut, ich mache nur Spaß. Ich bin nicht verärgert.",shape=box,color=red];
		j1518963760 -> j2224970618;
	j4182522442 [label="Das ist schon wahr ! So habe ich das noch nie gesehen. Und du könntest ihn selbst wählen. In gewisser Weise sehr befreiend.",shape=box,color=blue];
		j4182522442 -> j2850468367;
	j719137162 [label="Add 1 to Family counter",color=orange];
		j719137162 -> j3119552928;
	j1299372986 [label="Du wärst überrascht, wie widerstandsfähig die Seele ist. Und diejenigen, die mich umgeben, sind inzwischen so alt, so vom Zahn der Zeit gezeichnet.",shape=box,color=blue];
		j1299372986 -> j3505312304;
	j805603015 [label="Es ist möglich. Vielleicht leichter, als du meinst. Wir müssen nur überlegen, wie.",shape=box,color=blue];
		j805603015 -> j1118645169;
		j805603015 -> j1939689457;
	j1740816331 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j1740816331 -> j805603015 [label=true,color=green];
		j1740816331 -> j6880332 [label=false,color=brown];
	j2850468367 [label="Es war ein wunderbares Gespräch, aber ich fürchte ich bin an der Reihe, um das Mittagessen zu servieren. Monsieur Loid bringt mir bei, wie man auf seine Art Tee serviert !",shape=box,color=blue];
		j2850468367 -> "Chat ends.";
	j1729413184 [label="Maintenant, vous parlez aussi mal que le diable. Nein, ich werde nicht auf deine Tricks reinfallen.",shape=box,color=blue];
		j1729413184 -> "Chat ends.";
	j2224970618 [label="+5 Chemistry",color=orange];
		j2224970618 -> j1671319133;
	j3119552928 [label="+5 Chemistry",color=orange];
		j3119552928 -> j1241562179;
	j3505312304 [label="+5 Chemistry",color=orange];
		j3505312304 -> j3688285470;
	j1118645169 [label="Wir müssen einfach vorsichtig sein. Ich fürchte, die eine Hälfte, wird die andere Hälfte als \"die andere Familie\" betrachten.",shape=box,color=red];
		j1118645169 -> j719137162;
	j6880332 [label="Oui ? Und wie läuft deine Arbeit oder die deiner Mini-Kopie mit der famille oben ?",shape=box,color=blue];
		j6880332 -> j1218982937;
		j6880332 -> j1939689457;
	j1671319133 [label="Oh, loué soit Sol ! Aber das wirfst die Frage auf ... Weißt du, woher dieser Name kommt ? \"Le Drifter ?\"",shape=box,color=blue];
		j1671319133 -> j1910508165;
		j1671319133 -> j3750871725;
	j1241562179 [label="Oh... Par Sol, ich glaube, du hast es gelöst !",shape=box,color=blue];
		j1241562179 -> j2924538745;
	j3688285470 [label="Du hast sie oft überrascht. Lass sie diesmal dich überraschen.",shape=box,color=blue];
		j3688285470 -> j1198518929;
	j1218982937 [label="Langsam. Vorsichtig. Ich fürchte, die eine Hälfte, wird die andere Hälfte als \"die andere Familie\" betrachten.",shape=box,color=red];
		j1218982937 -> j719137162;
	j1910508165 [label="Ich hoffe, ich habe ihn selbst gewählt.",shape=box,color=red];
		j1910508165 -> j3986801319;
	j3750871725 [label="Ich kann mich wirklich nicht erinnern.",shape=box,color=red];
		j3750871725 -> j3907344359;
	j2924538745 [label="Boolean MarieFamilyOther is now true.",color=orange];
		j2924538745 -> j1702145003;
	j1198518929 [label="Aber bitte, bitte s'il vous plaît, führe deine Geschichte fort. Dein kleiner Wolf Marie muss ihre Beute kennen, bevor sie richtig jagen kann, non ?",shape=box,color=blue];
		j1198518929 -> j1859885752;
		j1198518929 -> j118168943;
		j1198518929 -> j934579411;
	j3986801319 [label="Das wäre sehr befreiend ! Den eigenen Namen zu wählen. In der Cathédrale konnte ich nicht mal meine eigene Kleidung wählen. Hah !",shape=box,color=blue];
		j3986801319 -> j2850468367;
	j3907344359 [label="Du trägst so viele mystéres mit dir herum !",shape=box,color=blue];
		j3907344359 -> j2850468367;
	j1702145003 [label="Ich bin außer mir vor Freude - je suis assise ici, remuant sur ma chaise !",shape=box,color=blue];
		j1702145003 -> j1198518929;
	j1859885752 [label="Wo war ich?",shape=box,color=red];
		j1859885752 -> j3813450220;
	j118168943 [label="Das war ein bisschen verschlagen von dir, oder?",shape=box,color=red];
		j118168943 -> j4177738461;
	j934579411 [label="Vielleicht möchte ich, dass du mich jagst ...",shape=box,color=red];
		j934579411 -> j448634867;
	j3813450220 [label="Sohn hatte die Animaux Infestés zu nah eingeladen.",shape=box,color=blue];
		j3813450220 -> j1377364404;
	j4177738461 [label="Peut-être ! Aber was schadet schon ein bisschen Verschlagenheit im Namen des Guten, hm ?",shape=box,color=blue];
		j4177738461 -> j2649487127;
		j4177738461 -> j1508165029;
	j448634867 [label="Boolean DrifterMarie is now true.",color=orange];
		j448634867 -> j1423231930;
	j2649487127 [label="Richtig ... egal, zurück zur Geschichte.",shape=box,color=red];
		j2649487127 -> j1377364404;
	j1508165029 [label="Versteh das nicht falsch. Ich habe es genossen.",shape=box,color=red];
		j1508165029 -> j3092275936;
	j1423231930 [label="Du bringst mich noch in Schwierigkeiten ! Ich habe hörbar gequiekt und Monsieur Loid hat gefragt, ob alles in Ordnung ist. Ich musste lügen und sagen, ich hätte eine Maus gesehen, nur damit er mir erklären konnte, dass es in dieser Zeit gar keine Mäuse gibt !",shape=box,color=blue];
		j1423231930 -> j2616478708;
	j3092275936 [label="Hah ! Das dachte ich mir. Genug mit deinem Unsinn und zurück zur Geschichte. Sohn hatte die Animaux Infestés zu nah eingeladen, oui ?",shape=box,color=blue];
		j3092275936 -> j1377364404;
	j2616478708 [label="+5 Chemistry",color=orange];
		j2616478708 -> j2189726668;
	j2189726668 [label="Quelle méchanceté, tu es terrible ! Je te déteste et tu me fais rougir maintenant !",shape=box,color=blue];
		j2189726668 -> j3366624298;
		j2189726668 -> j2649487127;
	j3366624298 [label="Bist du wütend auf mich?",shape=box,color=red];
		j3366624298 -> j2937765500;
	j2937765500 [label="Non ! Erzähl einfach weiter !",shape=box,color=blue];
		j2937765500 -> j1377364404;
}