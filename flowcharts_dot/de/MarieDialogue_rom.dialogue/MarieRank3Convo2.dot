digraph {
	1015 [label="MarieRank3Convo2 begins.",color=orange];
		1015 -> 3736;
	3736 [label="Update boolean MarieLyonAvailable",color=orange];
		3736 -> 2923;
	2923 [label="Check boolean LoidFamilyComplete",color=orange];
		2923 -> 2924 [label=true,color=green];
		2923 -> 1016 [label=false,color=brown];
	2924 [label="Ich hoffe, du hältst mich nicht für infirme... aber manchmal habe ich das seltsame Gefühl, als hätte ich das alles schon einmal getan ?",shape=box,color=blue];
		2924 -> 2925;
	1016 [label="Check boolean MarieFamily1",color=orange];
		1016 -> 1017 [label=true,color=green];
		1016 -> 1018 [label=false,color=brown];
	2925 [label="Habe diese Unterhaltungen geführt... diese Leute getroffen... obwohl das unmöglich ist, non ?",shape=box,color=blue];
		2925 -> 2926;
	1017 [label="Erzählst du mir mehr von der famille von le Cardinal ? Seine Vergangenheit fasziniert mich.",shape=box,color=blue];
		1017 -> 1020;
		1017 -> 1021;
		1017 -> 1019;
	1018 [label="Erzählst du mir von der famille von le Cardinal ? Seine Vergangenheit fasziniert mich.",shape=box,color=blue];
		1018 -> 1020;
		1018 -> 1021;
		1018 -> 1019;
	2926 [label="+20 Chemistry",color=orange];
		2926 -> 2927;
	1020 [label="Ich sage dir, was ich weiß, aber ich fürchte, ich weiß nicht so viel, wie du vielleicht glaubst.",shape=box,color=red];
		1020 -> 1023;
	1021 [label="Oh. Sicher, aber ... wäre Loid nicht der bessere Ansprechpartner?",shape=box,color=red];
		1021 -> 1024;
	1019 [label="[Ende.]",shape=box,color=red];
		1019 -> 1022;
	2927 [label="Nennen wir es ein déjà vu. Muss wohl das sérum sein und das Zeitreisen. C'est la vie !",shape=box,color=blue];
		2927 -> 2928;
	1023 [label="Was immer du mir erzählen kannst, werde ich in Ehren halten. Promis !",shape=box,color=blue];
		1023 -> 1025;
	1024 [label="Über le Cardinal zu sprechen ... scheint Monsieur Loid sehr zu verletzen. Das möchte ich nicht allzu sehr tun.",shape=box,color=blue];
		1024 -> 1025;
	1022 [label="Chat ends.",color=orange];
	2928 [label="Chat ends.",color=orange];
	1025 [label="Vor allem, weil ich es avec une certaine joie tue, was sonst niemand zu tun scheint.",shape=box,color=blue];
		1025 -> 1026;
		1025 -> 1027;
	1026 [label="Über wen möchtest du etwas wissen?",shape=box,color=red];
		1026 -> 1028;
	1027 [label="Also, oben gibt es gibt Mutter, Vater, Sohn, Tochter und Großmutter.",shape=box,color=red];
		1027 -> 1028;
	1028 [label="Lass uns erst etwas klären, ja ? Der Teufel lacht mich jedes Mal aus, wenn ich frage, als wäre es ein Scherz, den nur er versteht. Grand-mère. Großmutter.",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="Das ist doch nicht die Frau von le Cardinal, non ?",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="Nein, das ist Vaters Mutter. Mutters Schwiegermutter.",shape=box,color=red];
		1030 -> 1031;
	1031 [label="Je ... vois. Und ... warum nennt man sie nicht bei ihren Namen ? Ne serait-ce pas plus simple ?",shape=box,color=blue];
		1031 -> 1032;
		1031 -> 1033;
	1032 [label="Willst du die ganze Geschichte hören?",shape=box,color=red];
		1032 -> 1034;
	1033 [label="Ich gebe dir eine Zusammenfassung.",shape=box,color=red];
		1033 -> 1035;
	1034 [label="Oui ! Ich muss im Augenblick nirgendwo hin.",shape=box,color=blue];
		1034 -> 1036;
	1035 [label="Die Familie oben war hier gefangen, als das Imperium der Orokin zerbrach. Sohn, Entratis Enkel, ließ den Befall herein.",shape=box,color=red];
		1035 -> 1037;
	1036 [label="Also, wir befinden uns auf einem Mond namens Deimos. Und hier wurde vor langer Zeit eine biologische Bombe gezündet, in einem verzweifelten Versuch, die Sentients abzuwehren.",shape=box,color=red];
		1036 -> 1038;
	1037 [label="Par Sol ! Mit Absicht ?",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="Diejenigen, mit denen die Orokin vor so langer Zeit im Krieg lagen ? Diejenigen, die wir in der Dunklen Spiegelung mit dem Teufel sehen, oui ?",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1039 -> 1041 [label=true,color=green];
		1039 -> 1042 [label=true,color=green];
		1039 -> 1042 [label=false,color=brown];
		1039 -> 1043 [label=false,color=brown];
	1040 [label="Ja. Sie haben versucht, den Befall zu nutzen, um die Sentients zu bekämpfen. Aber Deimos wurde überrannt. Sie verbarrikadierten sich im Necralisk - der über uns ist - um Schutz zu suchen.",shape=box,color=red];
		1040 -> 1044;
	1041 [label="Nein, ich glaube, es war ein Unfall. Ich glaube, er meint es gut.",shape=box,color=red];
		1041 -> 1045;
	1042 [label="Ich kenne die Wahrheit noch nicht, aber ich behalte mir ein Urteil vor, bis ich mehr weiß.",shape=box,color=red];
		1042 -> 1045;
	1043 [label="Ich kenne die Wahrheit noch nicht, aber er ist arrogant, soviel kann ich dir sagen.",shape=box,color=red];
		1043 -> 1046;
	1044 [label="Sohn, Entratis Enkel, war jedoch fest entschlossen zu versuchen, die befallenen Tiere zu retten und zu studieren.",shape=box,color=red];
		1044 -> 1047;
	1045 [label="+10 Chemistry",color=orange];
		1045 -> 1048;
	1046 [label="Solch Schande. Ich hoffe, das ist nicht wahr, ihm und uns zuliebe. Bitte erzähl weiter.",shape=box,color=blue];
		1046 -> 1049;
	1047 [label="Oh, Sol ... meinte er es gut ?",shape=box,color=blue];
		1047 -> 1076;
	1048 [label="Sehr nett von dir. Continuez, s'il vous plaît.",shape=box,color=blue];
		1048 -> 1049;
	1049 [label="Naja, gefangen im Necralisk, zerfressen von Trauer, keine Orokin Imperium, das sie retten konnte und jetzt dringt auch noch der Befall ein ...",shape=box,color=red];
		1049 -> 1053;
	1076 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1076 -> 1051 [label=true,color=green];
		1076 -> 1052 [label=true,color=green];
		1076 -> 1055 [label=true,color=green];
		1076 -> 1051 [label=false,color=brown];
		1076 -> 1052 [label=false,color=brown];
		1076 -> 1054 [label=false,color=brown];
	1053 [label="Da wandten sie sich gegeneinander. Zerrissen sich gegenseitig, von innen heraus. Und der Befall erledigte den Rest. Er entwendete ihnen sogar die Namen.",shape=box,color=red];
		1053 -> 1058;
	1051 [label="Ja, ich glaube schon. Ich glaube, die Tiere waren ihm wirklich wichtig.",shape=box,color=red];
		1051 -> 1056;
	1052 [label="Leider, hat es nicht geholfen, der Schaden war bereits angerichtet.",shape=box,color=red];
		1052 -> 1057;
	1055 [label="Nein, es war Arroganz, die ihn inspirierte. Auch wenn er behauptet, es sei ein Unfall gewesen.",shape=box,color=red];
		1055 -> 1059;
	1054 [label="Ich kenne die Wahrheit noch nicht, aber er ist arrogant, soviel kann ich dir sagen.",shape=box,color=red];
		1054 -> 1059;
	1058 [label="Es ist die ultimative Form der Grausamkeit, nicht mal einen Namen zu haben ...",shape=box,color=blue];
		1058 -> 1062;
	1056 [label="+10 Chemistry",color=orange];
		1056 -> 1060;
	1057 [label="+5 Chemistry",color=orange];
		1057 -> 1061;
	1059 [label="Schäm dich. Ich hoffe, das ist nicht wahr, ihm und uns zuliebe. Bitte erzähl weiter.",shape=box,color=blue];
		1059 -> 1049;
	1062 [label="Update boolean MarieFamily2",color=orange];
		1062 -> 1066;
		1062 -> 1067;
		1062 -> 1068;
	1060 [label="Ich frage mich, was er von den Cavia halten würde ... zu schade, dass er sie nicht treffen kann ...",shape=box,color=blue];
		1060 -> 1063;
		1060 -> 1064;
	1061 [label="Wenn es nur alleine auf die Reinheit der Absicht ankäme, wäre die Welt ein wundervoller Ort, non ? C'est la vie.",shape=box,color=blue];
		1061 -> 1065;
	1066 [label="Es sei denn, du gibst ihn fort, wie Großmutter.",shape=box,color=red];
		1066 -> 1071;
	1067 [label="Es ist eigentlich nicht so schlimm, man gewöhnt sich daran.",shape=box,color=red];
		1067 -> 1072;
	1068 [label="Tiere haben auch keine Namen und scheinen völlig glücklich zu sein. Wir geben nur aus Eigennutz einen Namen.",shape=box,color=red];
		1068 -> 1073;
	1063 [label="Ich lächele bei dem Gedanken. Aber ich glaube nicht, es wäre weise.",shape=box,color=red];
		1063 -> 1069;
	1064 [label="Ich hoffe, das passiert eines Tages. Wirklich.",shape=box,color=red];
		1064 -> 1070;
	1065 [label="Et ensuite ?",shape=box,color=blue];
		1065 -> 1049;
	1071 [label="+5 Chemistry",color=orange];
		1071 -> 1077;
	1072 [label="Aaah ! Quelle horreur ! So habe ich das nicht gemein. Ich bin beschämt ! Es tut mir so leid, vergib mir bitte, so meinte ich das wirklich nicht, ich bin so ein Narr !",shape=box,color=blue];
		1072 -> 1078;
		1072 -> 1079;
	1073 [label="+5 Chemistry",color=orange];
		1073 -> 1080;
	1069 [label="Und warum nicht ?",shape=box,color=blue];
		1069 -> 1074;
		1069 -> 1075;
	1070 [label="Add 1 to Family",color=orange];
		1070 -> 1050;
	1077 [label="Sie klingt nach einer Dame, die ich gerne mal treffen würde ...",shape=box,color=blue];
		1077 -> 1085;
	1078 [label="Wie willst du das wiedergutmachen?",shape=box,color=red];
		1078 -> 1086;
	1079 [label="Ist schon gut, ich mache nur Spaß. Ich bin nicht verärgert.",shape=box,color=red];
		1079 -> 1087;
	1080 [label="Das ist schon wahr ! So habe ich das noch nie gesehen. Und du könntest ihn selbst wählen. In gewisser Weise sehr befreiend.",shape=box,color=blue];
		1080 -> 1085;
	1074 [label="Ich fürchte, die eine Hälfte, wird die andere Hälfte als \"die andere Familie\" betrachten.",shape=box,color=red];
		1074 -> 1081;
	1075 [label="Die Situation oben ist ... sogar an guten Tagen zerbrechlich. Ich möchte sie nicht verstimmen.",shape=box,color=red];
		1075 -> 1082;
	1050 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1050 -> 1083 [label=true,color=green];
		1050 -> 1084 [label=false,color=brown];
	1085 [label="Es war ein wunderbares Gespräch, aber ich fürchte ich bin an der Reihe, um das Mittagessen zu servieren. Monsieur Loid bringt mir bei, wie man auf seine Art Tee serviert !",shape=box,color=blue];
		1085 -> 1094;
	1086 [label="Maintenant, vous parlez aussi mal que le diable. Nein, ich werde nicht auf deine Tricks reinfallen.",shape=box,color=blue];
		1086 -> 1095;
	1087 [label="+5 Chemistry",color=orange];
		1087 -> 1096;
	1081 [label="Add 1 to Family",color=orange];
		1081 -> 1088;
	1082 [label="Du wärst überrascht, wie widerstandsfähig die Seele ist. Und diejenigen, die mich umgeben, sind inzwischen so alt, so vom Zahn der Zeit gezeichnet.",shape=box,color=blue];
		1082 -> 1089;
	1083 [label="Es ist möglich. Vielleicht leichter, als du meinst. Wir müssen nur überlegen, wie.",shape=box,color=blue];
		1083 -> 1090;
		1083 -> 1091;
	1084 [label="Oui ? Und wie läuft deine Arbeit oder die deiner Mini-Kopie mit der famille oben ?",shape=box,color=blue];
		1084 -> 1092;
		1084 -> 1093;
	1094 [label="Chat ends.",color=orange];
	1095 [label="Chat ends.",color=orange];
	1096 [label="Oh, loué soit Sol ! Aber das wirfst die Frage auf ... Weißt du, woher dieser Name kommt ? \"Le Drifter ?\"",shape=box,color=blue];
		1096 -> 1099;
		1096 -> 1100;
	1088 [label="+5 Chemistry",color=orange];
		1088 -> 1097;
	1089 [label="+5 Chemistry",color=orange];
		1089 -> 1098;
	1090 [label="Wir müssen einfach vorsichtig sein. Ich fürchte, die eine Hälfte, wird die andere Hälfte als \"die andere Familie\" betrachten.",shape=box,color=red];
		1090 -> 1081;
	1091 [label="Die Situation oben ist ... sogar an guten Tagen zerbrechlich. Ich möchte sie nicht verstimmen.",shape=box,color=red];
		1091 -> 1082;
	1092 [label="Langsam. Vorsichtig. Ich fürchte, die eine Hälfte, wird die andere Hälfte als \"die andere Familie\" betrachten.",shape=box,color=red];
		1092 -> 1081;
	1093 [label="Die Situation oben ist ... sogar an guten Tagen zerbrechlich. Ich möchte sie nicht verstimmen.",shape=box,color=red];
		1093 -> 1082;
	1099 [label="Ich hoffe, ich habe ihn selbst gewählt.",shape=box,color=red];
		1099 -> 1103;
	1100 [label="Ich kann mich wirklich nicht erinnern.",shape=box,color=red];
		1100 -> 1104;
	1097 [label="Oh... Par Sol, ich glaube, du hast es gelöst !",shape=box,color=blue];
		1097 -> 1101;
	1098 [label="Du hast sie oft überrascht. Lass sie diesmal dich überraschen.",shape=box,color=blue];
		1098 -> 1102;
	1103 [label="Das wäre sehr befreiend ! Den eigenen Namen zu wählen. In der Cathédrale konnte ich nicht mal meine eigene Kleidung wählen. Hah !",shape=box,color=blue];
		1103 -> 1085;
	1104 [label="Du trägst so viele mystéres mit dir herum !",shape=box,color=blue];
		1104 -> 1085;
	1101 [label="Update boolean MarieFamilyOther",color=orange];
		1101 -> 1105;
	1102 [label="Aber bitte, bitte s'il vous plaît, führe deine Geschichte fort. Dein kleiner Wolf Marie muss ihre Beute kennen, bevor sie richtig jagen kann, non ?",shape=box,color=blue];
		1102 -> 1106;
		1102 -> 1107;
		1102 -> 3914;
	1105 [label="Ich bin außer mir vor Freude - je suis assise ici, remuant sur ma chaise !",shape=box,color=blue];
		1105 -> 1102;
	1106 [label="Wo war ich?",shape=box,color=red];
		1106 -> 1108;
	1107 [label="Das war ein bisschen verschlagen von dir, oder?",shape=box,color=red];
		1107 -> 1109;
	3914 [label="Vielleicht möchte ich, dass du mich jagst ...",shape=box,color=red];
		3914 -> 3915;
	1108 [label="Sohn hatte die Animaux Infestés zu nah eingeladen.",shape=box,color=blue];
		1108 -> 1049;
	1109 [label="Peut-être ! Aber was schadet schon ein bisschen Verschlagenheit im Namen des Guten, hm ?",shape=box,color=blue];
		1109 -> 1110;
		1109 -> 1111;
	3915 [label="Update boolean DrifterMarie",color=orange];
		3915 -> 3913;
	1110 [label="Richtig ... egal, zurück zur Geschichte.",shape=box,color=red];
		1110 -> 1049;
	1111 [label="Versteh das nicht falsch. Ich habe es genossen.",shape=box,color=red];
		1111 -> 1112;
	3913 [label="Du bringst mich noch in Schwierigkeiten ! Ich habe hörbar gequiekt und Monsieur Loid hat gefragt, ob alles in Ordnung ist. Ich musste lügen und sagen, ich hätte eine Maus gesehen, nur damit er mir erklären konnte, dass es in dieser Zeit gar keine Mäuse gibt !",shape=box,color=blue];
		3913 -> 3916;
	1112 [label="Hah ! Das dachte ich mir. Genug mit deinem Unsinn und zurück zur Geschichte. Sohn hatte die Animaux Infestés zu nah eingeladen, oui ?",shape=box,color=blue];
		1112 -> 1049;
	3916 [label="+5 Chemistry",color=orange];
		3916 -> 3917;
	3917 [label="Quelle méchanceté, tu es terrible ! Je te déteste et tu me fais rougir maintenant !",shape=box,color=blue];
		3917 -> 3918;
		3917 -> 3919;
	3918 [label="Bist du wütend auf mich?",shape=box,color=red];
		3918 -> 3920;
	3919 [label="Richtig ... egal, zurück zur Geschichte.",shape=box,color=red];
		3919 -> 1049;
	3920 [label="Non ! Erzähl einfach weiter !",shape=box,color=blue];
		3920 -> 1049;
}