	3578 [label="Mon cœur, können wir reden ? Nur für einen Moment.",shape=box,color=blue];
		3578 -> 3580;
		3578 -> 3579;
	3576 [label="Chat ends.",color=orange];
	3580 [label="Hallo, klar. Was gibt's?",shape=box,color=red];
		3580 -> 3582;
	3579 [label="[Ende.]",shape=box,color=red];
		3579 -> 3581;
	3582 [label="Ich wollte nur sagen, dass ... ich weiß, dass dein Herz auch jemand anderem gehört. Und obwohl ich diese Person nicht kenne, freut sich mein Herz darüber.",shape=box,color=blue];
		3582 -> 3584;
	3581 [label="Update boolean MarieConsentComplete",color=orange];
		3581 -> 3583;
	3584 [label="Ich vertraue dir, und wenn diese Person einen Platz in deiner Seele hat, dann freue ich mich sehr, diesen zu teilen.",shape=box,color=blue];
		3584 -> 3585;
	3583 [label="Chat ends.",color=orange];
	3585 [label="Ich hoffe einfach, dass wir uns eines Tages kennenlernen, oui ? Die Liebe meiner Liebe muss auch meine Liebe sein ...",shape=box,color=blue];
		3585 -> 3586;
	3586 [label="Das heißt, falls du denkst, dass diese Person dazu geneigt wäre.",shape=box,color=blue];
		3586 -> 3587;
		3586 -> 3588;
		3586 -> 3589;
	3587 [label="Ehrlich gesagt, bist du vielleicht nicht der richtige Typ.",shape=box,color=red];
		3587 -> 3590;
	3588 [label="Sie würde dich verehren, Marie. Genau wie ich.",shape=box,color=red];
		3588 -> 3591;
	3589 [label="Ich glaube wirklich nicht, dass sie widerstehen könnte.",shape=box,color=red];
		3589 -> 3591;
	3590 [label="Pff! Du bist schrecklich, mein Wolf. Lass mich meine Träume haben. Bis dahin habe ich dich, wenn ich dich habe, nehme ich an !",shape=box,color=blue];
		3590 -> 3592;
	3591 [label="Bis dahin werde ich dich haben, wann immer ich dich habe. Und ich werde dich gerne mit denen teilen, die dich genauso lieben wie ich.",shape=box,color=blue];
		3591 -> 3592;
	3592 [label="Irgendjemand muss ja schließlich Wache halten vor dem Raunen, während du herumtollst und dich vergnügst !",shape=box,color=blue];
		3592 -> 3593;
	3593 [label="Und damit ruft die Pflicht. À la revoyure !",shape=box,color=blue];
		3593 -> 3594;
	3594 [label="Update boolean MarieConsentComplete",color=orange];
		3594 -> 3595;
	3595 [label="Chat ends.",color=orange];
