digraph {
	77 [label="MarieRank1Convo3 begins.",color=orange];
		77 -> 78;
	78 [label="Il y a un crâne volant ! Keksekça ?! Da ist ein fliegender, sprechender Totenkopf und alle gehen ihrem Alltag nach, als ob nichts passiert, und ich brauche jemanden, der die Merkwürdigkeit ihrer gesamten Existenz anerkennt.",shape=box,color=blue];
		78 -> 79;
		78 -> 81;
		78 -> 80;
	79 [label="Das ist nur Necraloid. Also, ein Necraloid. Es ist kompliziert.",shape=box,color=red];
		79 -> 82;
	81 [label="Das ist Necraloid. Er ist ein Cephalon, er wird dir nichts tun.",shape=box,color=red];
		81 -> 84;
	80 [label="[Ende.]",shape=box,color=red];
		80 -> 83;
	82 [label="Pardon, ist das ein Name oder ein Objekt?",shape=box,color=blue];
		82 -> 85;
		82 -> 86;
	84 [label="Ich halte ihn nicht für eine Bedrohung! Er macht mir keine Angst.",shape=box,color=blue];
		84 -> 87;
	83 [label="Chat ends.",color=orange];
	85 [label="Ich … weiß es nicht genau.",shape=box,color=red];
		85 -> 88;
	86 [label="Ja.",shape=box,color=red];
		86 -> 89;
	87 [label="Tatsächlich finde ich ihn ausgesprochen charmant, wenn auch im Gespräch etwas unnachgiebig. Nicht ganz unähnlich seiner lebendigen Inspiration. Aber angesichts der Natur meines bevorzugten Reisegefährten stört mich das nicht wirklich sonderlich.",shape=box,color=blue];
		87 -> 90;
	88 [label="Zunächst: Auf wessen Entwürfen basieren diese \"Necraloids ?\" Wenn sie sowohl ein Name und, vielleicht, auch eine Bezeichnung sind?",shape=box,color=blue];
		88 -> 91;
		88 -> 92;
	89 [label="Ich ... verstehe nicht. Und welche Rolle spielt Loid dabei ?",shape=box,color=blue];
		89 -> 88;
	90 [label="Nein, ich versichere dir, das, was du an seinem Gesicht grotesk findest, ist nicht das, was mich derzeit beschäftigt.",shape=box,color=blue];
		90 -> 93;
		90 -> 94;
	91 [label="Dein Cardinal Dimanche. Entrati.",shape=box,color=red];
		91 -> 95;
	92 [label="Entrati hat diesen gemacht. Aber das Konzept dessen, was sie sind – Cephalons – wurde von den Orokin erfunden.",shape=box,color=red];
		92 -> 95;
	93 [label="Ich bin überrascht, dass der Totenkopf dich nicht abschreckt.",shape=box,color=red];
		93 -> 96;
	94 [label="Ich gebe zu, aus dem Kontext gerissen muss er seltsam erscheinen. Aber was genau befremdet dich?",shape=box,color=red];
		94 -> 97;
	95 [label="Excusez-moi, willst du damit andeuten, dass le Cardinal einen Replikanten eines fliegenden Totenkopfdieners nach dem Vorbild seines eigenen Gefährten geschaffen und ihn so benannt hat?",shape=box,color=blue];
		95 -> 98;
	96 [label="Du weißt wenig über mich, und das ist nicht deine Schuld. Ich habe einen Großteil meines Lebens damit verbracht, mich um die Toten und ihre Ruhestätten zu kümmern.",shape=box,color=blue];
		96 -> 99;
	97 [label="Ich frage mich, warum auf seinem Rücken ein weiteres Gesicht ist, das an die Kritzeleien eines Kindes erinnert.",shape=box,color=blue];
		97 -> 100;
	98 [label="Warum gibt es dann nicht mehr von ihnen, diesen Necraloids ?",shape=box,color=blue];
		98 -> 101;
		98 -> 102;
		98 -> 103;
	99 [label="In Wahrheit waren sie einen Großteil meines Lebens meine guten Freunde. Sie hören mir gern zu, wenn ich über meine täglichen Sorgen spreche.",shape=box,color=blue];
		99 -> 104;
	100 [label="Ich habe Monsieur Necraloid und Monsieur Loid gefragt und keiner von beiden wollte darüber sprechen. Sie nannten mir nur einen Namen: Otak. Und sie erwähnten das mit großer Traurigkeit.",shape=box,color=blue];
		100 -> 105;
	101 [label="Vielleicht wurde ihm klar, wie entsetzlich es ist, eine digitale Kopie deines eigenen Geliebten zu erstellen.",shape=box,color=red];
		101 -> 106;
	102 [label="Vielleicht hatte er immer nur vor, einen einzigen zu machen.",shape=box,color=red];
		102 -> 107;
	103 [label="Ich bin nicht sicher. Vielleicht kam er nie dazu, mehr zu machen?",shape=box,color=red];
		103 -> 108;
	104 [label="Update boolean MarieGraveyard1",color=orange];
		104 -> 109;
		104 -> 110;
	105 [label="Deshalb spreche ich hier mit dir, in der Hoffnung, dass du mir helfen kannst.",shape=box,color=blue];
		105 -> 111;
		105 -> 112;
	106 [label="Ou bien, ein Tribut an seine Liebe und seinen Respekt, dass er nicht glaubte, dieses seltsame Labor könnte ohne Monsieur Loid weiter funktionieren.",shape=box,color=blue];
		106 -> 113;
		106 -> 114;
	107 [label="+5 Chemistry",color=orange];
		107 -> 115;
	108 [label="Stell dir vor: ein fliegender Totenkopfschwarm, mühelos und mit perfekter Effizienz!",shape=box,color=blue];
		108 -> 114;
		108 -> 116;
	109 [label="Mochtest du es Friedhöfe zu pflegen?",shape=box,color=red];
		109 -> 117;
	110 [label="Haben sie jemals geantwortet?",shape=box,color=red];
		110 -> 118;
	111 [label="Willst du etwas über Otak erfahren? Oder warum du nicht mit ihm sprechen kannst?",shape=box,color=red];
		111 -> 119;
	112 [label="Otak ist schwer zu erklären ...",shape=box,color=red];
		112 -> 2918;
	113 [label="Ich denke, es ist eine seltsame romantische Geste, aber ich bin nicht der richtige, das zu beurteilen.",shape=box,color=red];
		113 -> 122;
	114 [label="Ehrlich gesagt hätte ich nichts dagegen, wenn ein Nekraloid bei mir herumschwirrt.",shape=box,color=red];
		114 -> 123;
	115 [label="Auf seine Art, gleichzeitig tragisch und schön, non ? Ein Tribut an seine Liebe und seinen Respekt, dass er nicht glaubte, dieses seltsame Labor könnte ohne Monsieur Loid weiter funktionieren.",shape=box,color=blue];
		115 -> 124;
		115 -> 113;
	116 [label="Ich gestehe, ich bin froh, dass es nur einen von ihm gibt. Ich glaube, die Welt ist nicht bereit dafür.",shape=box,color=red];
		116 -> 125;
	117 [label="Und Mausoleen und Krypten, oh ja. Aber ich gebe zu, mir gefielen die Außenbereiche besser, obwohl sie für meinen Stuhl eine Herausforderung waren. Genau wie Treppen, fürchte ich.",shape=box,color=blue];
		117 -> 126;
	118 [label="Hah ! Nein, zum Glück nicht. Erst als dein \"Necraloid\" mit dem morbiden Antlitz mir antwortete. Ob es zu den Gaben der Himmlischen gehört, mit den Toten zu sprechen, weiß ich nicht.",shape=box,color=blue];
		118 -> 127;
	119 [label="Ich glaube, ich möchte beides wissen irgendwann, aber ich überlasse es dir, wo du anfängst. Ich weiß nicht après tout, was wichtiger ist.",shape=box,color=blue];
		119 -> 2918;
	2918 [label="Check boolean LoidFamilyComplete",color=orange];
		2918 -> 121 [label=true,color=green];
		2918 -> 121 [label=false,color=brown];
		2918 -> 120 [label=false,color=brown];
	122 [label="Und jetzt bin ich neugierig, aber das scheint eine Geschichte für ein anderes Mal zu sein. Cela dit ...",shape=box,color=blue];
		122 -> 97;
	123 [label="Deswegen bin ich mir absolut sicher, dass du wahrscheinlich entweder das Bedürfnis nach Gesellschaft oder nach Organisation oder beides hast. Aber das ist ein Thema für ein anderes Mal.",shape=box,color=blue];
		123 -> 97;
	124 [label="Ich glaube, es ging mehr darum, dafür zu sorgen, dass dieser Ort nicht aus den Fugen gerät, als um irgendetwas anderes.",shape=box,color=red];
		124 -> 130;
	125 [label="In der Tat! Ich auch nicht. Was mich zu meiner nächsten Frage bringt.",shape=box,color=blue];
		125 -> 97;
	126 [label="Update boolean MarieSerum1",color=orange];
		126 -> 131;
		126 -> 132;
	127 [label="Nein, Geister und Stimmen zu hören, liegt eher in der Macht meines lieben Lyon als in meiner. Allerdings frage ich mich, ob Monsieur Necraloid nicht auch von Geistern heimgesucht wird, bedenkt man die Kritzelei des Kindes auf seinem Hinterkopf.",shape=box,color=blue];
		127 -> 133;
	121 [label="Otak war einst ein Archimede, Wissenschaftler und Akademiker der Orokin. Was ihm widerfahren ist, ist nicht gerade eine schöne Geschichte.",shape=box,color=red];
		121 -> 129;
	120 [label="Nun ... kurz gefasst, ein Teil von Entratis Familie ist oben und sie sind sich nicht ... wirklich bewusst, dass wir hier unten sind.",shape=box,color=red];
		120 -> 128;
	130 [label="Und du hast wahrscheinlich durchaus recht. Dem fliegenden Amalgam scheint viel von der raison d'être und den Nuancen des echten Monsieur Loid zu fehlen. Cela dit ...",shape=box,color=blue];
		130 -> 97;
	131 [label="Ich war mir nicht sicher, ob es unangemessen wäre, zu fragen, ob deine Füße durch das Serum verändert wurden oder nicht ...",shape=box,color=red];
		131 -> 136;
	132 [label="Deinen Stuhl?",shape=box,color=red];
		132 -> 137;
	133 [label="Aus diesem Grund bin ich eigentlich hierhergekommen, um mit dir zu sprechen, wenn es dir nichts ausmacht.",shape=box,color=blue];
		133 -> 100;
	129 [label="Update boolean MarieOtak1",color=orange];
		129 -> 135;
	128 [label="Update boolean MarieFamily1",color=orange];
		128 -> 134;
	136 [label="+10 Chemistry",color=orange];
		136 -> 140;
	137 [label="Ich weiß nicht, wie du es nennen würdest? Un fauteuil roulant oder ... vielleicht ein Begriff, den ich überhaupt nicht mag: un fauteuil pour invalide.",shape=box,color=blue];
		137 -> 141;
	135 [label="Par les Luminaires ... bitte, sprich weiter.",shape=box,color=blue];
		135 -> 139;
	134 [label="Par les Luminaires ... Du meinst, wir sind alle hier unten im Geheimen ?! Dürfen wir diesen Ort deshalb nicht verlassen ?! Mais pourquoi ?!",shape=box,color=blue];
		134 -> 138;
	140 [label="Oh ! Oh, du armes Ding. Die Vorstellung, wie du da sitzt und dich fragst, ob mir le Cardinal die Füße weggenommen hat! Non, non, non – nichts dergleichen.",shape=box,color=blue];
		140 -> 144;
	141 [label="So wie das, worauf wir jetzt sitzen, um mit diesen kleinen, süßen Geräten zu kommunizieren. Aber mit Rädern an den Seiten, um sich fortzubewegen. Ein Stuhl mit Rädern, wenn man so will.",shape=box,color=blue];
		141 -> 145;
		141 -> 146;
	139 [label="Er war allem Anschein nach ein Genie und der Kopf hinter der Nutzung von Argon-Kristallen.",shape=box,color=red];
		139 -> 143;
	138 [label="Seine Tochter Euleria – genannt Mutter – und ihre Familie haben sich die ganze Zeit um Deimos gekümmert.",shape=box,color=red];
		138 -> 142;
	144 [label="Sol hielt es für angebracht, mir die Unannehmlichkeit aufzubürden, mit Füßen geboren zu sein, die unbrauchbar waren. Ich konnte nicht gehen. ",shape=box,color=blue];
		144 -> 149;
	145 [label="Du warst eine Invalidin, bevor du zum Protoframe wurdest?",shape=box,color=red];
		145 -> 150;
	146 [label="Wir nennen das Rollstühle, ob du es glaubst oder nicht.",shape=box,color=red];
		146 -> 151;
	143 [label="Die aus dem Void gewonnen werden – sie sind der Grund, warum wir viele der mächtigen Warframes und Waffen erschaffen können, die wir herstellen.",shape=box,color=red];
		143 -> 148;
	142 [label="Über diesen Ort und das Herz gewacht, das Void-Energie in das Ursprungssystem pumpt und uns alle ... wirklich verwendbar hält, seit Entrati gegangen ist.",shape=box,color=red];
		142 -> 861;
	149 [label="Aber es war einfach nur eine Unannehmlichkeit.",shape=box,color=blue];
		149 -> 155;
	150 [label="Nein. Das war ich ganz und gar nicht.",shape=box,color=blue];
		150 -> 156;
	151 [label="Hah ! Oh, und nun sitze ich hier und lache über mich selbst, weil ich so dumm bin. Ja, ich nehme an, man würde sie Rollstühle nennen, da es Stühle mit Rädern sind. Wie dumm von mir.",shape=box,color=blue];
		151 -> 155;
	148 [label="Er spezialisierte sich auf Kristallographie. Und seine Arbeiten wurden hier in den Laboren archiviert.",shape=box,color=red];
		148 -> 154;
	861 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		861 -> 152 [label=true,color=green];
		861 -> 153 [label=false,color=brown];
	155 [label="Allerdings vermisse ich es nicht, mich rollend herumzuschieben. Lyon auch nicht, denke ich. Was für eine Freiheit es ist zu fliegen !",shape=box,color=blue];
		155 -> 160;
		155 -> 161;
		155 -> 162;
	156 [label="Update boolean MarieInvalid",color=orange];
		156 -> 163;
	154 [label="Aus irgendeinem Grund, ich weiß nicht warum, wurde er in ein Cephalon verwandelt und erhielt seine eigene Nekraloid-Hülle.",shape=box,color=red];
		154 -> 159;
	152 [label="Sie hat sich mit seiner Abwesenheit abgefunden und sie haben Frieden miteinander geschlossen, aber es war hart erkämpft.",shape=box,color=red];
		152 -> 157;
	153 [label="Sie hat sich mit seiner Abwesenheit nicht abgefunden und die beiden liegen sich gegenseitig an die Gurgel.",shape=box,color=red];
		153 -> 158;
	160 [label="Ich versuche Behinderungen als etwas zu sehen, dass uns verändert. Sie schränken uns ein, ja, aber sie geben uns auch Stärken, die andere nicht haben.",shape=box,color=red];
		160 -> 167;
	161 [label="Du hast deinen Zustand nie als Problem betrachtet?",shape=box,color=red];
		161 -> 168;
	162 [label="Wusstest du, dass das Protoframe-Serum dies mit dir machen würde?",shape=box,color=red];
		162 -> 169;
	163 [label="Chat ends.",color=orange];
	159 [label="Nicht alle Cephalons wurden als Bestrafung erschaffen. Aber hier auf Deimos lief es ... nicht gut, und er wurde schwer beschädigt.",shape=box,color=red];
		159 -> 166;
	157 [label="Zu wissen, dass er weiterhin da draußen ist, Amok läuft und dass er kein Wort mit ihr gewechselt oder ihr nicht einmal einen Brief geschickt hat ...?",shape=box,color=red];
		157 -> 164;
	158 [label="Zu wissen, dass er weiterhin da draußen ist, Amok läuft und dass er kein Wort mit ihr gewechselt oder ihr nicht einmal einen Brief geschickt hat ...?",shape=box,color=red];
		158 -> 165;
	167 [label="+5 Chemistry",color=orange];
		167 -> 173;
	168 [label="Ich habe nie einen Grund gesehen, mich darüber zu beklagen. Ich genieße es allerdings, ohne Hilfe Gegenstände aus hohen Regalen holen zu können, ungefragt.",shape=box,color=blue];
		168 -> 174;
	169 [label="Oui, le Cardinal erklärte Lyon und mir alles, was die Einnahme der Seren, die unsere Gestalt veränderten, bewirken würde. Wir wussten, was passieren wird.",shape=box,color=blue];
		169 -> 175;
	166 [label="+5 Chemistry",color=orange];
		166 -> 172;
	164 [label="Ich kann mir nicht vorstellen, wie schmerzhaft das für sie wäre. Für beide.",shape=box,color=red];
		164 -> 170;
	165 [label="Das würde die geringe Chance auf eine Versöhnung zerstören, die sie möglicherweise haben.",shape=box,color=red];
		165 -> 171;
	173 [label="Update boolean MarieSecretPower",color=orange];
		173 -> 179;
	174 [label="Ce qui est fait est fait. Ich konnte Sol nicht um ein Wunder bitten, während so viele um mich herum mehr litten, so viele es noch nötiger hatten. Die Himmlischen hatten mir schon so viel gegeben.",shape=box,color=blue];
		174 -> 180;
	175 [label="Aber wie bei allen Dingen habe ich meine mit Freude angenommen und Lyon seine ... oh, ich fürchte, ich verpetze ihn, und das sollte ich nicht.",shape=box,color=blue];
		175 -> 181;
		175 -> 182;
	172 [label="Pauvre petit ...",shape=box,color=blue];
		172 -> 178;
	170 [label="Ich verstehe zwar die Logik hinter der Entscheidung, sie vor dem Schmerz zu schützen, die le Cardinal durch seinen notwendigen Aufbruch verursacht hat ...",shape=box,color=blue];
		170 -> 176;
	171 [label="+10 Chemistry",color=orange];
		171 -> 177;
	179 [label="Oui ! Du verstehst. Ich habe die Welt aus einer anderen Perspektive kennengelernt. Meine Arme waren stärker. Ich bin geduldiger. Ich weiß, was es heißt, den Moment zu genießen.",shape=box,color=blue];
		179 -> 190;
	180 [label="Ich muss los. Danke für diese wunderbare Abwechslung.",shape=box,color=blue];
		180 -> 191;
	181 [label="Alles in Ordnung. Erzähl mir nicht mehr, als dir lieb ist.",shape=box,color=red];
		181 -> 192;
	182 [label="Bitte sprich weiter. Es fällt mir schwer, zu ihm durchzudringen.",shape=box,color=red];
		182 -> 193;
	178 [label="Also wurde er zum Haupt-Necraloid transferiert – dem einzigen Necraloid, der übrig geblieben ist – und ... nun ja? Es ist schwer zu erklären.",shape=box,color=red];
		178 -> 187;
		178 -> 188;
		178 -> 189;
	176 [label="Ich finde es unnötig grausam, du nicht ? Sie könnten ihn für tot halten. Oder Schlimmeres! Und wir, leben hier comme des rats d'égout ?",shape=box,color=blue];
		176 -> 183;
		176 -> 184;
		176 -> 185;
	177 [label="Ja, ich verstehe die Logik. Ich würde daran arbeiten, ihre Familie wieder zusammenzubringen, wenn du kannst, non ? Es scheint die einzige Hoffnung für uns zu sein, hier rauszukommen. ",shape=box,color=blue];
		177 -> 186;
	190 [label="Wenn ich mein Ziel erreiche, genieße ich seine Eleganz. Ich husche nicht umher wie ein Käfer mit Millionen kleiner Beine.",shape=box,color=blue];
		190 -> 202;
	191 [label="Chat ends.",color=orange];
	192 [label="+5 Chemistry",color=orange];
		192 -> 203;
	193 [label="+5 Chemistry",color=orange];
		193 -> 204;
	187 [label="Ich wünschte nur, wir könnten ihn reparieren, ehrlich. Den echten Otak zurückbringen.",shape=box,color=red];
		187 -> 199;
	188 [label="Er bringt mich zum Lächeln. Er ist witzig, aber dahinter verbirgt sich etwas Tragisches und Zerbrochenes.",shape=box,color=red];
		188 -> 200;
	189 [label="Leider ist er nicht mehr zu retten. Und ich glaube, er geht vielen auf die Nerven.",shape=box,color=red];
		189 -> 201;
	183 [label="Du hast recht. Ich wünschte, wir könnten etwas tun.",shape=box,color=red];
		183 -> 194;
	184 [label="Diese Entscheidung kann ich nicht wirklich machen.",shape=box,color=red];
		184 -> 195;
	185 [label="Ich habe übrigens eine Freundin, die Ratten liebt. Ich finde sie süß.",shape=box,color=red];
		185 -> 196;
	186 [label="Damit wir nicht den Rest unseres Lebens hier gefangen verbringen, comme des rats d'égout.",shape=box,color=blue];
		186 -> 197;
		186 -> 198;
	202 [label="Ich wünschte einfach, mein lieber Lyon könnte die Welt so sehen wie Sie. Dass alle Unannehmlichkeiten eine geheime Macht sein könnten, wie du sagst.",shape=box,color=blue];
		202 -> 213;
	203 [label="Ich weiß deine Freundlichkeit zu schätzen, Drifter. Ich werde es einfach dabei belassen, um die Belastungen, die ich dir möglicherweise auferlege, nicht zu überschreiten – ",shape=box,color=blue];
		203 -> 214;
	204 [label="Damit bist du nicht allein, Drifter. Lyon ist wie eine Familie für mich, und trotzdem frage ich mich manchmal, ob ich ihn kaum besser kenne als die Heiligenstatuen in der Kathedrale.",shape=box,color=blue];
		204 -> 215;
	199 [label="+15 Chemistry",color=orange];
		199 -> 210;
	200 [label="+15 Chemistry",color=orange];
		200 -> 211;
	201 [label="+15 Chemistry",color=orange];
		201 -> 212;
	194 [label="Add 1 to Family",color=orange];
		194 -> 205;
	195 [label="Ich weiß. Es ist die Entscheidung von Monsieur Loid und allen anderen, sich zu erkennen zu geben.",shape=box,color=blue];
		195 -> 206;
	196 [label="+10 Chemistry",color=orange];
		196 -> 207;
	197 [label="Ich war nachlässig. Du hast recht. Ich mache mich an die Arbeit.",shape=box,color=red];
		197 -> 208;
	198 [label="Ich habe übrigens eine Freundin, die Ratten liebt. Ich finde sie süß. ",shape=box,color=red];
		198 -> 209;
	213 [label="Oh, ich habe Angst, als würde ich ihn verpetzen, und das sollte ich nicht.",shape=box,color=blue];
		213 -> 181;
		213 -> 182;
	214 [label="- Lyon malt die Welt in blutrot, was auch immer sein äußeres Auftreten vermuten lässt. Es tut mir leid, dass er immer noch nicht mit dir spricht. Ich dränge ihn dazu ...",shape=box,color=blue];
		214 -> 221;
	215 [label="Check boolean MarieLyonSuffering1",color=orange];
		215 -> 223 [label=true,color=green];
		215 -> 222 [label=false,color=brown];
	210 [label="Ich kenne den Drang, den du verspürst. Danke, du hast mir viel zum Nachdenken gegeben.",shape=box,color=blue];
		210 -> 220;
	211 [label="Ich weiß, wie du dich fühlst. Danke, du hast mir viel zum Nachdenken gegeben.",shape=box,color=blue];
		211 -> 220;
	212 [label="Ja, ich ... kenne eine ähnliche Situation. Danke, du hast mir viel zum Nachdenken gegeben.",shape=box,color=blue];
		212 -> 220;
	205 [label="+15 Chemistry",color=orange];
		205 -> 216;
	206 [label="Ich denke, es sind Schuldgefühle und nicht Edelmut, die uns hier unten halten.",shape=box,color=blue];
		206 -> 217;
	207 [label="Und ich würde sie gerne eines Tages kennenlernen, aber das ist nicht der Punkt, den ich machen will, Dummkopf.",shape=box,color=blue];
		207 -> 206;
	208 [label="Add 1 to Family",color=orange];
		208 -> 218;
	209 [label="+5 Chemistry",color=orange];
		209 -> 219;
	221 [label="Update boolean MarieLyonSuffering1",color=orange];
		221 -> 227;
	223 [label="Du hast schon selbst herausgefunden, dass Lyon eine tiefe und schmerzliche Last auf dem Herzen trägt. Eine, von der er glaubt, er müsse sie allein tragen.",shape=box,color=blue];
		223 -> 229;
	222 [label="Lyon trägt eine tiefe und schmerzliche Last auf dem Herzen. Eine, von der er glaubt, er müsse sie allein tragen.",shape=box,color=blue];
		222 -> 228;
	220 [label="À la revoyure.",shape=box,color=blue];
		220 -> 226;
	216 [label="Vielleicht können wir das ! Ich gebe die Hoffnung nicht auf. Wir müssen die Grundkrankheit verstehen, um sie behandeln zu können, non ?",shape=box,color=blue];
		216 -> 206;
	217 [label="Dass wir eine große und schreckliche Sünde verbergen.",shape=box,color=blue];
		217 -> 224;
	218 [label="+5 Chemistry",color=orange];
		218 -> 225;
	219 [label="Und ich würde sie gerne eines Tages kennenlernen, aber das ist nicht der Punkt, den ich machen will, Dummkopf.",shape=box,color=blue];
		219 -> 206;
	227 [label="Ich muss los. Danke für diese wunderbare Abwechslung.",shape=box,color=blue];
		227 -> 231;
	229 [label="Update boolean MarieLyonSuffering2",color=orange];
		229 -> 232;
	228 [label="Update boolean MarieLyonSuffering1",color=orange];
		228 -> 232;
	226 [label="Chat ends.",color=orange];
	224 [label="Und diese Sünde muss vergeben werden.",shape=box,color=blue];
		224 -> 230;
	225 [label="Vielen Dank. Ich weiß nicht, ob du Erfolg haben wirst, aber manchmal muss man es einfach nur versuchen.",shape=box,color=blue];
		225 -> 206;
