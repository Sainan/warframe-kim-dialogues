	2288 [label="Marie? Können wir reden?",shape=box,color=red];
		2288 -> 2292;
	2290 [label="Roathe hat mir ... vom Kampf mit Tagfer erzählt. Können wir darüber reden?",shape=box,color=red];
		2290 -> 2293;
	2291 [label="[Ende.]",shape=box,color=red];
		2291 -> 2294;
	2289 [label="Chat ends.",color=orange];
	2292 [label="Oui, obwohl ich das Gefühl habe, zu wissen, worum es geht ... Ich habe mich schlecht benommen. Wer hat es dir erzählt?",shape=box,color=blue];
		2292 -> 2295;
		2292 -> 2296;
		2292 -> 2297;
	2293 [label="Bien sûr, ce salaud de diable ouvre sa bouche et vous raconte tout ! Il ne cherche qu'à m'embarrasser !",shape=box,color=blue];
		2293 -> 2298;
	2294 [label="Chat ends.",color=orange];
	2295 [label="Das ist unwichtig.",shape=box,color=red];
		2295 -> 2299;
	2296 [label="Loid.",shape=box,color=red];
		2296 -> 2300;
	2297 [label="Roathe.",shape=box,color=red];
		2297 -> 2293;
	2298 [label="Si je le pouvais, je prendrais ce couteau qu'il aime tant utiliser pour agacer les autres et je le fourrerais là où seule Lua peut le voir !",shape=box,color=blue];
		2298 -> 2301;
	2299 [label="Das glaube ich nicht, aber ich denke, du willst mich nicht verärgern. Deshalb ... werde ich dich nicht weiter bedrängen.",shape=box,color=blue];
		2299 -> 2302;
	2300 [label="Ich glaube, du lügst, um mich nicht zu verärgern, also ... werde ich dich nicht weiter bedrängen.",shape=box,color=blue];
		2300 -> 2302;
	2301 [label="Verzeih mir. Das war ... unangemessen. Ich bin une Sœur de Sol und darf weder die Beherrschung verlieren noch so unbedacht reden.",shape=box,color=blue];
		2301 -> 2303;
	2302 [label="+5 Chemistry",color=orange];
		2302 -> 2304;
	2303 [label="+5 Chemistry",color=orange];
		2303 -> 2305;
	2304 [label="Ich möchte in diesem Gespräch so viel Würde bewahren, wie mir vielleicht noch vergönnt ist.",shape=box,color=blue];
		2304 -> 2306;
	2305 [label="Mein Ärger richtet sich nicht gegen dich. Und ich bin dir stets dankbar für deine Ehrlichkeit.",shape=box,color=blue];
		2305 -> 2307;
	2306 [label="Falls du mit mir über den Streit sprechen willst, den ich mit M'sieur Tagfer hatte, leugne ich nicht, dass das passiert ist.",shape=box,color=blue];
		2306 -> 2307;
	2307 [label="Ich nehme an, der Teufel hat dir gesagt, worum es in dem Streit ging ?",shape=box,color=blue];
		2307 -> 2308;
	2308 [label="Evaluate expressions",color=orange];
		2308 -> 2310 [label="MarieTagferFight2a",color=purple];
		2308 -> 2311 [label="MarieTagferFight2a",color=purple];
		2308 -> 2309 [label="MarieTagferFight2b",color=purple];
		2308 -> 2310 [label="MarieTagferFight2b",color=purple];
		2308 -> 2310 [label="false",color=purple];
		2308 -> 2312 [label="false",color=purple];
	2310 [label="Er brauchte es mir nicht zu sagen, ich konnte es mir denken. Entrati.",shape=box,color=red];
		2310 -> 2314;
	2311 [label="Das hat er. Obwohl er sich scheinbar mehr um dich als um alles andere sorgte.",shape=box,color=red];
		2311 -> 2315;
	2309 [label="Das hat er. Er ist besorgt über die Situation, weil er, glaube ich, Mitleid mit den Cavia hat.",shape=box,color=red];
		2309 -> 2313;
	2312 [label="Nein, ehrlich. Er meinte nur, ich soll mal nach dir sehen.",shape=box,color=red];
		2312 -> 2316;
	2314 [label="Oui. M'sieur Tagfer stritt über le Cardinal als Thema.",shape=box,color=blue];
		2314 -> 2318;
		2314 -> 2319;
	2315 [label="Ich verstehe nicht, warum der Teufel dich so etwas glauben lassen will. Oder welchen Zweck es ihm dient.",shape=box,color=blue];
		2315 -> 2320;
	2313 [label="Der Teufel sieht drei verletzte Tiere und weiß, dass er mit seinem charisme leicht erreichen kann, dass sie ihm zu Füßen liegen.",shape=box,color=blue];
		2313 -> 2317;
	2316 [label="Ich verstehe nicht, warum der Teufel dich zu so etwas verleiten will. Oder welchen Zweck es ihm dient.",shape=box,color=blue];
		2316 -> 2321;
	2318 [label="Tagfer ist nicht der größte Anhänger von Entrati, nein.",shape=box,color=red];
		2318 -> 2323;
	2319 [label="Ich nehme an, es war ein lauter Streit.",shape=box,color=red];
		2319 -> 2324;
	2320 [label="Alle vermeintliche Güte des Teufels mir gegenüber dient seinem Ziel – mich gegen le Cardinal aufzubringen. Das weiß ich. ",shape=box,color=blue];
		2320 -> 2322;
	2317 [label="Er tut das, um das Blatt gegen mich zu wenden. Er will mich gegen le Cardinal aufhetzen. Er will, dass ich mich von ihm abwende. Das weiß ich.",shape=box,color=blue];
		2317 -> 2322;
	2321 [label="Aber ... darum geht es hier nicht. Der Streit bezog sich auf le Cardinal. ",shape=box,color=blue];
		2321 -> 2318;
		2321 -> 2319;
	2323 [label="Und genau das verstehe ich nicht ! Schau, was ihnen gegeben wurde !",shape=box,color=blue];
		2323 -> 2325;
		2323 -> 2326;
	2324 [label="Oui ! Er nannte mich dumm. Er sagte mir, ich sei nichts weiter als ein Kind.",shape=box,color=blue];
		2324 -> 2327;
		2324 -> 2325;
	2322 [label="Und es war le Cardinal als Thema, über das M'sieur Tagfer und ich stritten.",shape=box,color=blue];
		2322 -> 2318;
		2322 -> 2319;
	2325 [label="Bitte fang von vorne an. Wie hat dieser ganze Streit angefangen?",shape=box,color=red];
		2325 -> 2328;
	2326 [label="Ich verstehe langsam, warum es zu diesem Streit kam.",shape=box,color=red];
		2326 -> 2328;
	2327 [label="Hat er dich tatsächlich als dumm und kindisch bezeichnet?",shape=box,color=red];
		2327 -> 2329;
	2328 [label="Oui. Ich habe le Cardinal erwähnt, ich weiß nicht mal in welchem Zusammenhang. ",shape=box,color=blue];
		2328 -> 2330;
	2329 [label="Schlimmer vielleicht.",shape=box,color=blue];
		2329 -> 2331;
	2330 [label="M'sieur Tagfer verdrehte die Augen und schnaubte. Ich bat ihn, seine Verachtung zu erklären.",shape=box,color=blue];
		2330 -> 2332;
	2331 [label="\"Du bist ein kleines Kind, Marie ! Unschuldig. Dein ganzes Leben lang von anderen abhängig. Zusammengekauert in deinem kleinen Nest des blinden Glaubens !\"",shape=box,color=blue];
		2331 -> 2333;
	2332 [label="\"Albrecht ist ein dreckiger, stinkender Lügner!\"",shape=box,color=blue];
		2332 -> 2334;
	2333 [label="\"Du lebst von dem, was deine Vorfahren durchgekaut und dir in deinen leichtgläubigen, klaffenden Mund gespuckt haben !\"",shape=box,color=blue];
		2333 -> 2335;
	2334 [label="Et j'ai répondu, \"Schau dir die Gaben an, die dir gegeben wurden - die Gaben des Denkens, der Sprache, des Selbst !\"",shape=box,color=blue];
		2334 -> 2336;
	2335 [label="Update boolean MarieEntrati3",color=orange];
		2335 -> 2337;
		2335 -> 2338;
		2335 -> 2339;
	2336 [label="\"Du solltest le Cardinal dankbar sein für all das, womit er dich gesegnet hat.\"",shape=box,color=blue];
		2336 -> 2340;
		2336 -> 2341;
	2337 [label="Tagfer kennt nur seine Version der Geschichte. Entratis wahre Beweggründe oder Meinungen wurden nicht ... klar dargelegt.",shape=box,color=red];
		2337 -> 2342;
	2338 [label="Ich weiß, wie du dich fühlst, wenn du von anderen \"abhängig\" bist, und es tut mir leid, dass er diese Dinge zu dir gesagt hat.",shape=box,color=red];
		2338 -> 2343;
	2339 [label="Tagfer hat gute Gründe, so zu denken, wie er denkt.",shape=box,color=red];
		2339 -> 2344;
	2340 [label="Und wie hat er das aufgenommen?",shape=box,color=red];
		2340 -> 2331;
	2341 [label="Oh nein ...",shape=box,color=red];
