		2344 -> 2351 [label="MarieEntratiNeutral",color=purple];
		2344 -> 2350 [label="false",color=purple];
	2345 [label="Das gibt ihm dennoch kein Recht dazu ! Ich weiß nicht, ob er ahnt, wie sehr mich seine Worte verletzt haben. En outre -",shape=box,color=blue];
		2345 -> 2344;
	2346 [label="Merci, ich weiß nicht, ob er ahnt, wie tief mich seine Worte verletzt haben.",shape=box,color=blue];
		2346 -> 2352;
		2346 -> 2353;
		2346 -> 2354;
	2347 [label="Wenn das der Empfang ist, der le Cardinal bei seiner Rückkehr erwartet, ist es kein Wunder, dass er fernbleibt!",shape=box,color=blue];
		2347 -> 2355;
		2347 -> 2356;
	2348 [label="Und du stehst in all dem auch auf der Seite von M'sieur Tagfer, nicht wahr? Du hältst le Cardinal genauso für ein Monster wie das Biest selbst.",shape=box,color=blue];
		2348 -> 2357;
		2348 -> 2358;
	2349 [label="Ich bin überrascht, je pensais que tu étais de mon côté ! Hast du dich nicht gerade erst mit mir für le Cardinals Sache eingesetzt ?",shape=box,color=blue];
		2349 -> 2359;
	2351 [label="Was spielt das schon für eine Rolle, wie du bereits sagtest ? Wir sollen ihm in seinen Taten dienen und ihn später richten. Dieser Streit ist sinnlos, nicht wahr ?",shape=box,color=blue];
		2351 -> 2361;
		2351 -> 2362;
	2350 [label="Ich weiß, sie wurden vom Void durch die Hände von le Cardinal erschaffen. Wir alle haben Gaben von le Cardinal erhalten, die ein Fluch sind, wenn wir sie mit gebrochenem Herzen betrachten !",shape=box,color=blue];
		2350 -> 2360;
	2352 [label="Und weißt du, wie tief deine Worte ihn verletzt haben? Kennst du ihre ganze Geschichte?",shape=box,color=red];
		2352 -> 2350;
	2353 [label="Und was du gesagt hast, hat ihn genauso sehr verletzt.",shape=box,color=red];
		2353 -> 2363;
	2354 [label="Ich bin auf deiner Seite, ehrlich, aber ... wir müssen versuchen, den Frieden zu wahren, Marie.",shape=box,color=red];
		2354 -> 2364;
		2354 -> 2365;
	2355 [label="Marie, bitte. Ich will nicht streiten. Ich will dir nur verständlich machen, was sie durchgemacht haben.",shape=box,color=red];
		2355 -> 2366;
	2356 [label="Wenn Entrati stets bleiben würde, um seine eigenen Fehler auszubügeln, hätte er vielleicht mehr Freunde auf der Welt.",shape=box,color=red];
		2356 -> 2367;
	2357 [label="Marie, bitte. Ich will nicht streiten. Ich will dir nur verständlich machen, was sie durchgemacht haben.",shape=box,color=red];
		2357 -> 2366;
	2358 [label="Ja, ich stehe auf seiner Seite. Denn du hörst nicht auf die Vernunft. Du musst verstehen, dass \"le Cardinal\" nicht der ist, der er zu sein scheint.",shape=box,color=red];
		2358 -> 2366;
	2359 [label="War das etwa eine große Täuschung von dir ? Hast du etwa mit der kleinen Marie Spielchen gespielt ?",shape=box,color=blue];
		2359 -> 2368;
		2359 -> 2369;
	2361 [label="Es spielt eine Rolle, ob am Ende niemand mehr da ist, der uns geholfen hat. Sie haben viel durchgemacht.",shape=box,color=red];
		2361 -> 2366;
	2362 [label="Ich bin sicher, er wird es vergessen. Und du mit Sicherheit auch.",shape=box,color=red];
		2362 -> 2371;
	2360 [label="Wir alle wurden von ihm im Stich gelassen ! Sagt mir, warum haben sie so viel mehr Unrecht erlitten, dass ich solchen Hass dulden muss ?!",shape=box,color=blue];
		2360 -> 2370;
	2363 [label="Oui ?! Dann sag mir warum !",shape=box,color=blue];
		2363 -> 2350;
	2364 [label="Die Situation, die die Cavia durchgemacht haben, war ... hart.",shape=box,color=red];
		2364 -> 2350;
	2365 [label="Es sind Tiere, und selbst wenn sie Intelligenz besitzen, bleiben sie Tiere. Ihre Fähigkeiten sind begrenzt.",shape=box,color=red];
		2365 -> 2372;
	2366 [label="Oui ? Dann spiele die Rolle der Lumière Sacrée de Sol und vertreibe die Dunkelheit ! Erleuchte die kleine, törichte Marie !",shape=box,color=blue];
		2366 -> 2350;
	2367 [label="Oui ! Ja, es reicht nicht, dass er versucht, das bekannte Universum vor einem Gott des Voids zu retten, non ?!",shape=box,color=blue];
		2367 -> 2373;
	2368 [label="Nein, ich lüge nicht. Ich bin ganz deiner Meinung. Ich sage nur, dass ihre Situation ... hart war.",shape=box,color=red];
		2368 -> 2366;
	2369 [label="Nein, nicht wirklich ein Spiel ...? Aber Entrati kann man nicht trauen und ich weiß nicht, wie ich dich sonst überzeugen kann, als so zu tun, als wäre ich auf deiner Seite.",shape=box,color=red];
		2369 -> 2374;
	2371 [label="Non ! Du hast dieses Gespräch begonnen und du wirst es fortsetzen. Explique !",shape=box,color=blue];
		2371 -> 2350;
	2370 [label="Evaluate expressions",color=orange];
