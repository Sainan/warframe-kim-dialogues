		2403 -> 2406;
	2404 [label="Deshalb war er wütend, Marie. Deshalb hasst er Entrati. Und deshalb wird er ihn wohl auf ewig hassen.",shape=box,color=red];
		2404 -> 2407;
	2405 [label="Ich weiß, du glaubst, er tut, was er für richtig hält. Und ich weiß, du glaubst an Vergebung. Ich auch. Aber du musst verstehen, warum das für manche nicht möglich ist. Zumindest noch nicht.",shape=box,color=red];
		2405 -> 2408;
	2406 [label="Es gibt Zeiten, in denen man nicht in der Lage ist, denen zu vergeben, die einen verletzt haben. Sicherlich nicht jetzt, und vielleicht niemals.",shape=box,color=red];
