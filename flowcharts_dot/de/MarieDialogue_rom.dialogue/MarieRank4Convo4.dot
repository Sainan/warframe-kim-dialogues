		2370 -> 2375 [label="false",color=purple];
	2372 [label="Falls du versuchst, mich dazu zu bewegen, ihnen Sympathie entgegenzubringen und meinen Zorn gegen dich zu richten, dann bin ich gerade versucht.",shape=box,color=blue];
		2372 -> 2380;
	2373 [label="Vielleicht ist es am besten, wir hören hier auf. Bevor wir uns alle in Rage reden.",shape=box,color=blue];
		2373 -> 2381;
	2374 [label="Oui ? Dann freut es mich dir sagen zu können, dass du gescheitert bist.",shape=box,color=blue];
		2374 -> 2382;
	2375 [label="Die Cavia waren ein Unfall geboren aus Experimenten. Labortiere, die nie zur Existenz bestimmt waren. Der Void verlieh ihnen Intelligenz.",shape=box,color=red];
		2375 -> 2383;
	2377 [label="Du sagtest selbst: \"Es ist die höchste Form der Grausamkeit, keinen Namen zu haben.\" Entrati machte sich nicht die Mühe, ihnen Namen zu geben, sie waren es nicht wert.",shape=box,color=red];
		2377 -> 2385;
	2378 [label="Du hast mir erzählt, wie du auf der Straße aufgewachsen bist. Wie deine Familie dich rausgeworfen hat, weil du ihnen nicht gut genug warst.",shape=box,color=red];
		2378 -> 2386;
	2379 [label="Stell dir vor, wie du dich gefühlt hättest, wenn du gegen deinen Willen einfach in einen Protoframe verwandelt und dann dir selbst überlassen worden wärst?",shape=box,color=red];
		2379 -> 2387;
	2376 [label="Stell dir vor, wie du dich fühlen würdest, wenn Entrati einfach auftauchte, Lyon in einen Protoframe verwandelte und ihn dann im Stich ließe?",shape=box,color=red];
		2376 -> 2384;
	2380 [label="Vielleicht ist es am besten, wir hören hier auf. Bevor wir uns alle in Rage reden.",shape=box,color=blue];
		2380 -> 2388;
	2381 [label="Chat ends.",color=orange];
	2382 [label="Update boolean MarieEntratiFan1",color=orange];
		2382 -> 2389;
	2383 [label="Und als Entrati sah, was er getan hat? Als ihm klar wurde, was er erschaffen hat? Diese armen Tiere, in der Voidsprache sprechend und krank von der Einwirkung?",shape=box,color=red];
		2383 -> 2390;
	2385 [label="Für ihn waren sie nur Dinge. Dinge, zum Benutzen und Wegwerfen. \"Tagfer?\" Das bedeutet \"Getaggt für Entsorgung.\"",shape=box,color=red];
		2385 -> 2392;
	2386 [label="Deine Familie hielt dich für wertlos.",shape=box,color=red];
		2386 -> 2393;
	2387 [label="Stell dir vor, wie es gewesen wäre, den Befall im Blut zu haben, zu leiden, ohne irgendjemand, den das kümmert?",shape=box,color=red];
		2387 -> 2394;
	2384 [label="Ihn wie ein billiges wissenschaftliches Experiment benutzt hätte und ihn dann vergessen würde? Ihr konntet euch vor und nach eurer Veränderung aufeinander verlassen. Die Cavia nicht.",shape=box,color=red];
		2384 -> 2391;
	2388 [label="Chat ends.",color=orange];
	2389 [label="Update boolean MarieEntratiFan2",color=orange];
		2389 -> 2395;
	2390 [label="Es war ihm egal.",shape=box,color=red];
		2390 -> 2396;
	2392 [label="Vogel 3? Das ist ein Vogel mit einer Zahl als Namen. Fibonacci hat sich selbst einen Namen gegeben.",shape=box,color=red];
		2392 -> 2397;
	2393 [label="Das waren die Cavia für Entrati. Wegwerf-Labortiere. \"Tagfer?\" Das bedeutet \"Getaggt für Entsorgung.\"",shape=box,color=red];
		2393 -> 2392;
	2394 [label="Dass dein Leid überhaupt von Bedeutung ist? Die Cavia waren – sind – für Entrati wertlos. Wegwerf-Labortiere. \"Tagfer?\" Das bedeutet \"Getaggt für Entsorgung.\"",shape=box,color=red];
		2394 -> 2392;
	2391 [label="Für Entrati waren die Cavia nichts weiter als Wegwerf-Labortiere. Wertlos. \"Tagfer?\" Das bedeutet \"Getaggt für Entsorgung.\"",shape=box,color=red];
		2391 -> 2392;
	2395 [label="Update boolean MarieNoDate",color=orange];
		2395 -> 2398;
	2396 [label="Das waren die Cavia für Entrati. Wegwerfware. \"Tagfer?\" Das bedeutet \"Getaggt für Entsorgung.\"",shape=box,color=red];
		2396 -> 2399;
	2397 [label="Verwendet in einem Void-Experiment. Überlebende in einer langen Reihe toter Tiere. Nie zur Existenz bestimmt.",shape=box,color=red];
		2397 -> 2400;
	2398 [label="Chat ends.",color=orange];
	2399 [label="Der Letzte seiner Art. Getaggt für Entsorgung. Seine Gefährtin? Minn? Die Einzige andere, die noch übrig war? Starb im Experiment.",shape=box,color=red];
		2399 -> 2401;
	2400 [label="Sie leben nur, dank Loid. Er hat sie erhalten, weil er es nicht übers Herz brachte, sie \"gemäß Entratis Anweisung\" einzuschläfern.",shape=box,color=red];
		2400 -> 2402;
	2401 [label="Deshalb war er wütend, Marie. Deshalb hasst er Entrati. Und deshalb wird er ihn wohl auf ewig hassen.",shape=box,color=red];
		2401 -> 2403;
	2402 [label="Und Tagfer? Er ist der Letzte seiner Art. Seine Gefährtin Minn? Die einzige andere, die noch übrig war? Sie starb bei dem Experiment.",shape=box,color=red];
		2402 -> 2404;
	2403 [label="Update boolean MarieEntrati3b",color=orange];
