	j1606426654 [label="+20 Chemistry",color=orange];
		j1606426654 -> j1944752245;
	j1320247306 [label="Evaluate expressions",color=orange];
		j1320247306 -> j1007561202 [label="MarieFamily3a",color=purple];
		j1320247306 -> j2740683401 [label="MarieFamily3a",color=purple];
		j1320247306 -> j1910200303 [label="MarieFamily3b",color=purple];
		j1320247306 -> j1388663080 [label="MarieFamily3b",color=purple];
		j1320247306 -> j1007561202 [label="MarieFamilyOther",color=purple];
		j1320247306 -> j2740683401 [label="MarieFamilyOther",color=purple];
		j1320247306 -> j489711963 [label="false",color=purple];
	j1944752245 [label="S'il te plaît, mach, dass es aufhört - sonst lache ich bald noch über seine Witze. Dann weiß ich, dass ich wirklich verloren bin !",shape=box,color=blue];
		j1944752245 -> j758933647;
	j1007561202 [label="Hast du nochmal darüber nachgedacht, wie wir Loid dazu bringen, oben mit der Entrati Familie zu sprechen?",shape=box,color=red];
		j1007561202 -> j3487613436;
	j2740683401 [label="Ich habe darüber nachgedacht, wie ich Loid überzeugen kann, diese Stufen hinaufzugehen und endlich mit der Familie zu sprechen und... ich habe eine Idee, aber ich glaube, sie wird dir nicht gefallen.",shape=box,color=red];
		j2740683401 -> j668862974;
	j1910200303 [label="Marie, ist es dir immer noch recht, dass... wir Loid vielleicht überzeugen, mit den \"Nachbarn von oben\" zu sprechen? Ich weiß, dass wir das etwas seltsam beendet haben.",shape=box,color=red];
		j1910200303 -> j374072022;
	j1388663080 [label="Was den Versuch angeht, Loid und die Entrati Familie zum Gespräch zu bewegen, ich habe mich gefragt ... ob du Roathes Rolle nochmal überdacht hast?",shape=box,color=red];
		j1388663080 -> j374072022;
	j489711963 [label="Ich habe darüber nachgedacht, warum Monsieur Loid solche Angst hat, mit le Cardinals Familie zu sprechen.",shape=box,color=blue];
		j489711963 -> j2953638996;
	j758933647 [label="Check boolean MarieNoDate",color=orange];
		j758933647 -> "Chat ends." [label=true,color=green];
		j758933647 -> j2768654365 [label=false,color=brown];
	j3487613436 [label="Check boolean MarieDating",color=orange];
		j3487613436 -> j2260469996 [label=true,color=green];
		j3487613436 -> j3357070874 [label=false,color=brown];
	j668862974 [label="Check boolean MarieDating",color=orange];
		j668862974 -> j1582705566 [label=true,color=green];
		j668862974 -> j1039450084 [label=false,color=brown];
	j374072022 [label="Check boolean MarieDating",color=orange];
		j374072022 -> j729521042 [label=true,color=green];
		j374072022 -> j923301987 [label=false,color=brown];
	j2953638996 [label="Und wie wir diesen Stillstand überwinden müssen. Dieses purgatoire, in dem wir gefangen sind, darf nicht bestehen bleiben. Es erscheint so unnötig schmerzhaft.",shape=box,color=blue];
		j2953638996 -> j1165605182;
	j2768654365 [label="Boolean MarieWillDate is now true.",color=orange];
		j2768654365 -> "Chat ends.";
	j2260469996 [label="Bonjour, mon cœur ! Ich habe noch mal darüber nachgedacht, oui ... und ich hasse wirklich, es zuzugeben. Es macht mir keine Freude, das zu sagen.",shape=box,color=blue];
		j2260469996 -> j3948006174;
	j3357070874 [label="Bonjour - ich habe noch mal darüber nachgedacht, oui ... und ich hasse wirklich, es zuzugeben. Es macht mir keine Freude, das zu sagen.",shape=box,color=blue];
		j3357070874 -> j3948006174;
	j1582705566 [label="Bonjour, mon cœur ! Und was glaubst du, wird mir nicht gefallen ?",shape=box,color=blue];
		j1582705566 -> j1452093293;
	j1039450084 [label="Bonjour ! Oh ? Und was glaubst du, wird mir nicht gefallen ?",shape=box,color=blue];
		j1039450084 -> j1452093293;
	j729521042 [label="Bonjour, bonjour, mon cœur ! Ich habe noch mal darüber nachgedacht, oui ... und ich hasse wirklich, es zuzugeben. Es macht mir keine Freude, das zu sagen.",shape=box,color=blue];
		j729521042 -> j3073295169;
	j923301987 [label="Bonjour - ich habe noch mal darüber nachgedacht, oui ... und ich hasse wirklich, es zuzugeben. Es macht mir keine Freude, das zu sagen.",shape=box,color=blue];
		j923301987 -> j3073295169;
	j1165605182 [label="Aber ich habe das Gefühl, wir brauchen... eine Art Schutzwall, non ? Hast du irgendwelche Ideen ?",shape=box,color=blue];
		j1165605182 -> j3080555911;
		j1165605182 -> j1452093293;
	j3948006174 [label="Aber ich denke... ich denke - oh Sol hilf mir - dass die Hilfe des Teufel wirklich nötig ist. Ich glaube nicht, dass Monsieur Lois sonst auf uns hören wird.",shape=box,color=blue];
		j3948006174 -> j916533578;
	j1452093293 [label="Ich glaube, wir brauchen Roathes Hilfe, um Loid zu überzeugen, mit der Entrati Familie zu sprechen. Sonst wird er es kaum tun. Jedenfalls ohne Zusicherung, dass die Familie und er selbst, geschützt werden.",shape=box,color=red];
		j1452093293 -> j2928598465;
	j3073295169 [label="Ich glaube, du könntest recht haben. Der Teufel könnte das fehlende Puzzleteil sein. Ah, es schmerzt mich schon, dies überhaupt zu schreiben !",shape=box,color=blue];
		j3073295169 -> j409794056;
	j3080555911 [label="Ich habe kaum gute Ideen, die nicht die Hilfe von fragwürdigen Quellen erfordern. Quellen, die uns später in noch größere Schwierigkeiten bringen könnten. Wie z. B. Roathe.",shape=box,color=red];
		j3080555911 -> j3686743413;
	j916533578 [label="Der Teufel ist mächtig und verspricht eine gewisse Stärke, falls etwas schief gehen sollte, non ?",shape=box,color=blue];
		j916533578 -> j3413919045;
		j916533578 -> j3805804485;
	j2928598465 [label="Ich... gebe es nicht gerne zu, aber ich glaube, du könntest recht haben... Sol vergib mir.",shape=box,color=blue];
		j2928598465 -> j409794056;
	j409794056 [label="Evaluate expressions",color=orange];
		j409794056 -> j2792767885 [label="RoatheFamilyFail",color=purple];
		j409794056 -> j1457423746 [label="RoatheRedeemed & RoatheFamilyDelay
",color=purple];
		j409794056 -> j4235645535 [label="RoatheVillain & RoatheFamilyDelay",color=purple];
		j409794056 -> j1086183810 [label="false",color=purple];
	j3686743413 [label="Bist du sicher ? Wenn ich meine différences mit dem Teufel beiseitelegen kann, dann du sicher auch auch, non ?",shape=box,color=blue];
		j3686743413 -> j1438331688;
		j3686743413 -> j3340493498;
	j3413919045 [label="Du hast recht. Ich hätte nicht gedacht, dass du zustimmen würdest. Daher hatte ich Angst zu fragen.",shape=box,color=red];
		j3413919045 -> j409794056;
	j3805804485 [label="Nein, es muss einen anderen Weg geben. Ich weigere mich, ihn hierfür um Hilfe zu bitten.",shape=box,color=red];
		j3805804485 -> j3686743413;
	j2792767885 [label="Aber wird er uns in dieser Sache helfen ?",shape=box,color=blue];
		j2792767885 -> j301394024;
	j1457423746 [label="Aber wird er uns in dieser Sache helfen ?",shape=box,color=blue];
		j1457423746 -> j3438223610;
	j4235645535 [label="Aber wird er uns in dieser Sache helfen ?",shape=box,color=blue];
		j4235645535 -> j2141731520;
	j1086183810 [label="Meinst du denn, du könntest ihn dazu überreden, uns zu helfen ?",shape=box,color=blue];
		j1086183810 -> j3455125840;
		j1086183810 -> j435794800;
	j1438331688 [label="In Ordnung. Wenn es dir recht ist, dann komme ich auch damit zurecht.",shape=box,color=red];
		j1438331688 -> j2346421023;
	j3340493498 [label="Nein, tut mir leid.",shape=box,color=red];
		j3340493498 -> j1836471948;
	j301394024 [label="Leider nein... ich denke, bei ihm für das in eine Sackgasse. Meinst du, es gibt einen anderen Weg?",shape=box,color=red];
		j301394024 -> j308973658;
	j3438223610 [label="Das wird er. Ich habe ihn überzeugt, uns dabei zu helfen, sie zu vereinigen, damit er die Entrati Familie schützen kann. Immerhin sind sie alles, was noch von den Orokin über ist.",shape=box,color=red];
		j3438223610 -> j3804162503;
	j2141731520 [label="Das wird er. Ich habe ihn überzeugt, uns dabei zu helfen, sie zu vereinigen und, was dich nicht überraschen wird, das überwiegend, um Albrecht in seiner Abwesenheit eins auszuwischen.",shape=box,color=red];
		j2141731520 -> j1000926422;
	j3455125840 [label="Ich arbeite noch daran, aber ich denke schon.",shape=box,color=red];
		j3455125840 -> j961489522;
	j435794800 [label="Noch ist nichts entschieden. Er ist ... naja, du weißt, wie er sein kann.",shape=box,color=red];
		j435794800 -> j3827853471;
	j2346421023 [label="Oui, es  muss mir nicht gefallen, aber es ist un médicament, das wir schlucken müssen, nehme ich an.",shape=box,color=blue];
		j2346421023 -> j409794056;
	j1836471948 [label="+20 Chemistry",color=orange];
		j1836471948 -> j2868576021;
	j308973658 [label="Oh ! Das ist ... bedauerlich. Ich weiß nicht ! Ich glaube kaum ... Fällt dir ein anderer Weg ein, mit dem Teufel umzugehen ? Oder ein neuer Ansatz ?",shape=box,color=blue];
		j308973658 -> j3702260366;
	j3804162503 [label="Er hilft uns, die Familie des Mannes zu schützen, der ihn, gegen seinen Willen, in einen Protoframe verwandelt, ihn in die Vergangenheit verbannt und dann auch noch seine Erinnerungen gestohlen hat...",shape=box,color=blue];
		j3804162503 -> j4144307228;
	j1000926422 [label="Du hast recht... es überrascht mich nicht.",shape=box,color=blue];
		j1000926422 -> j2503142996;
		j1000926422 -> j1856167172;
	j961489522 [label="Check boolean RoatheDating",color=orange];
		j961489522 -> j4031027232 [label=true,color=green];
		j961489522 -> j2461760583 [label=false,color=brown];
	j3827853471 [label="Check boolean RoatheDating",color=orange];
		j3827853471 -> j4097842969 [label=true,color=green];
		j3827853471 -> j1112400890 [label=false,color=brown];
	j2868576021 [label="Dann unterstütze ich deine Entscheidung auch.",shape=box,color=blue];
		j2868576021 -> j1179567760;
	j3702260366 [label="In der Zwischenzeit werde ich mit Lyon sprechen, aber ich habe nicht viel Hoffnung.",shape=box,color=blue];
		j3702260366 -> j3598075256;
	j4144307228 [label="+20 Chemistry",color=orange];
		j4144307228 -> j1433624506;
	j2503142996 [label="Das ist wohl nur die Ausrede, die er als Vorwand benutzt.",shape=box,color=red];
		j2503142996 -> j2256572417;
	j1856167172 [label="Immerhin hilft er wenigstens. Und ich stelle sicher, dass er seine Drohungen nicht tatsächlich wahr macht.",shape=box,color=red];
		j1856167172 -> j1300254877;
	j4031027232 [label="Aber ich glaube, du hast eine besondere Art ihn zu überzeugen, wenn alle anderen scheitern, non ?",shape=box,color=blue];
		j4031027232 -> j932788212;
		j4031027232 -> j3326060209;
	j2461760583 [label="Ich wünsche dir viel Glück. Selbst in besten Zeiten ist der Teufel stur. Manchmal denke ich, er genießt es einfach widerspenstig zu sein !",shape=box,color=blue];
		j2461760583 -> j3596596117;
		j2461760583 -> j2516220180;
	j4097842969 [label="Oui, ich weiß. Aber ich glaube, du hast eine besondere Art ihn zu überzeugen, wenn alle anderen scheitern, non ?",shape=box,color=blue];
		j4097842969 -> j932788212;
		j4097842969 -> j3326060209;
	j1112400890 [label="Oui, natürlich weiß ich das. Selbst in besten Zeiten ist der Teufel stur. Manchmal denke ich, er genießt es einfach widerspenstig zu sein !",shape=box,color=blue];
		j1112400890 -> j3596596117;
		j1112400890 -> j2516220180;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j3598075256 [label="+20 Chemistry",color=orange];
		j3598075256 -> j467512297;
	j1433624506 [label="Ich habe unseren Teufel völlig falsch eingeschätzt...",shape=box,color=blue];
		j1433624506 -> j1357437404;
	j2256572417 [label="Oui, ich hoffe, du hast recht.",shape=box,color=blue];
		j2256572417 -> j70687620;
	j1300254877 [label="Oui. Immerhin bist du da, um sicherzustellen, dass er seine Drohungen nicht wirklich wahr macht... niedere Instinkte.",shape=box,color=blue];
		j1300254877 -> j70687620;
	j932788212 [label="Was willst du damit andeuten, Marie?",shape=box,color=red];
		j932788212 -> j3278411942;
	j3326060209 [label="Ich möchte meine Beziehung zu ihm nicht als Werkzeug für Verhandlungen nutzen.",shape=box,color=red];
		j3326060209 -> j3080397585;
	j3596596117 [label="Das kann er sein, aber ich glaube vieles davon ist nur Show.",shape=box,color=red];
		j3596596117 -> j3072666854;
	j2516220180 [label="Ich genieße es sogar irgendwie. so komisch das auch klingt. Wir verstehen einander.",shape=box,color=red];
		j2516220180 -> j2344600426;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j467512297 [label="Der Teufel ist launisch ! C'est la vie, wie man sagt !",shape=box,color=blue];
		j467512297 -> j3569999725;
	j1357437404 [label="Und ich bin nicht so dumm, dass ich nicht erkennen kann, welche Rolle du darin gespielt hat, dass alles so zustande kam !",shape=box,color=blue];
		j1357437404 -> j1263896752;
	j70687620 [label="Check boolean MarieDating",color=orange];
		j70687620 -> j3221803947 [label=true,color=green];
		j70687620 -> j32902783 [label=false,color=brown];
	j3278411942 [label="+5 Chemistry",color=orange];
		j3278411942 -> j876553254;
	j3080397585 [label="Oh ! Das wollte ich damit nicht unterstellen, pardonne-moi ! Nur, dass er dich zu bevorzugen scheint. Ich glaube er würde dir zuhören, wo er alle anderen ignoriert.",shape=box,color=blue];
		j3080397585 -> j1746422497;
	j3072666854 [label="Oui ? Was meinst du damit ?",shape=box,color=blue];
		j3072666854 -> j1155893159;
	j2344600426 [label="Oui, er scheint dich in der Tat zu bevorzugen. Vielleicht, weil ihr euch eine Zeit und einen Ort teilt, wir aber nicht ? Warum sonst ?",shape=box,color=blue];
		j2344600426 -> j1155893159;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j1263896752 [label="Check boolean MarieDating",color=orange];
		j1263896752 -> j3195129815 [label=true,color=green];
		j1263896752 -> j3346606997 [label=false,color=brown];
	j3221803947 [label="+10 Chemistry",color=orange];
		j3221803947 -> j3350878610;
	j32902783 [label="+10 Chemistry",color=orange];
		j32902783 -> j2132075148;
	j876553254 [label="Ich weiß nicht, was du meinst ! Ich will gar nichts andeuten. Ich bin nur une innocente Sœur de Sol.",shape=box,color=blue];
		j876553254 -> j1563471782;
	j1746422497 [label="+5 Chemistry",color=orange];
		j1746422497 -> j2290017678;
	j1155893159 [label="Evaluate expressions",color=orange];
		j1155893159 -> j3814629106 [label="RoatheVillain",color=purple];
		j1155893159 -> j1723719459 [label="RoatheRedeemed",color=purple];
		j1155893159 -> j3556588294 [label="RoatheUnloved3",color=purple];
		j1155893159 -> j3669525075 [label="RoatheTraitor2",color=purple];
		j1155893159 -> j1718792416 [label="RoatheExecutor2",color=purple];
		j1155893159 -> j350218926 [label="false",color=purple];
	j3195129815 [label="Merci, merci, merci, mon cœur !",shape=box,color=blue];
		j3195129815 -> j3394948141;
	j3346606997 [label="Merci, merci, merci !",shape=box,color=blue];
		j3346606997 -> j3394948141;
	j3350878610 [label="Nun ! Wenn es soweit ist, werde ich bereit sein und warten ! Bis dahin, merci, mon cœur.",shape=box,color=blue];
		j3350878610 -> j3569999725;
	j2132075148 [label="Nun ! Wenn es soweit ist, werde ich bereit sein und warten ! Bis dahin, merci.",shape=box,color=blue];
		j2132075148 -> j3569999725;
	j1563471782 [label="Ich würde niemals andeuten, dass nur, weil der Teufel dich bevorzugt, er vielleicht auf dich hört, wo er alle anderen ignoriert.",shape=box,color=blue];
		j1563471782 -> j1416952012;
	j2290017678 [label="Ich bin einfach glücklich, dass du glücklich bist. Und wenn der Teufel etwas hat, worauf er seine... Mühen verwenden kann... um so besser, non ?",shape=box,color=blue];
		j2290017678 -> j3473547704;
	j3814629106 [label="Jeder in seinem Leben hat versucht, ihn als eine Art Monster hinzustellen. Ich nehme an, ich bin die erste Person, die das nicht getan hat.",shape=box,color=red];
		j3814629106 -> j27380702;
	j1723719459 [label="Es gibt vieles, was er einfach nicht zeigen kann. Es ist nicht direkt eine Rüstung - aber vertraut nicht darauf, dass Menschen ihn nicht verletzen werden.",shape=box,color=red];
		j1723719459 -> j3634806141;
	j3556588294 [label="Ihm ist ... in all den Jahren oft das Herz gebrochen worden. Es ist mit Dornen überkrustet, das ist alles.",shape=box,color=red];
		j3556588294 -> j3829132688;
	j3669525075 [label="Ich denke, ich kann seinen Lebensweg nachvollziehen. Ich habe genauso viel Tod gesehen, wie er.",shape=box,color=red];
		j3669525075 -> j2263206348;
	j1718792416 [label="Er hat immer nur versucht zu tun, was richtig war. Sicher, vielleicht auf die falsche Art, aber er hat versucht, das Ursprungssystem vor den Orokin zu retten.",shape=box,color=red];
		j1718792416 -> j1950322146;
	j350218926 [label="Ich mag seinen trockenen Humor. Er ist clever, wenn man mal von seinem Ego absieht.",shape=box,color=red];
		j350218926 -> j2547973551;
	j3394948141 [label="Nun ! Wenn es soweit ist, werde ich bereit sein und warten ! Bis dahin !",shape=box,color=blue];
		j3394948141 -> j3569999725;
	j1416952012 [label="Und niemals in privaten Momenten. Non. Jamais.",shape=box,color=blue];
		j1416952012 -> j3824353854;
		j1416952012 -> j3537435846;
	j3473547704 [label="Erst recht für uns alle, wenn du eine Art ange auf seiner Schulter sein kannst, um ihn zu besänftigen.",shape=box,color=blue];
		j3473547704 -> j822447449;
		j3473547704 -> j123302831;
	j27380702 [label="Ich nehmen, in letzter Zeit stehe ich ganz oben auf dieser Liste, non ? Ich nehmen an, ich sollte... seine Gründe bedenken, warum er so ist, wie er ist. Verurteilung rettet keine Seelen.",shape=box,color=blue];
		j27380702 -> j1261058703;
	j3634806141 [label="Es gibt immer einen Schmerz, den wir vor anderen verbergen. Manchmal brauchen wir Schutz, aus Angst, andere könnten ihn ausnutzen. Ich denke, ich sollte versuchen, netter zu ihm zu sein, wenn es wahr ist, was du sagst.",shape=box,color=blue];
		j3634806141 -> j1261058703;
	j3829132688 [label="Ich kann mir kaum das Ausmaß an Liebe und Verlust in all diesen Jahren vorstellen. Es scheint so unwirklich, sogar nach allem, was ich gesehen habe.",shape=box,color=blue];
		j3829132688 -> j2962199546;
	j2263206348 [label="Manchmal vergesse ich, wieviele Jahrhunderte er gelebt hat, wenn ich mit ihm spreche. Es ist so surreal, sogar angesichts dessen, was ich alles gesehen habe.",shape=box,color=blue];
		j2263206348 -> j771878212;
	j1950322146 [label="Es gibt immer... Nuancen, oui ? Gründe, warum man sich so oder so verhält. Ich denke, ich sollte versuchen, netter zu ihm zu sein, wenn es wahr ist, was du sagst.",shape=box,color=blue];
		j1950322146 -> j1261058703;
