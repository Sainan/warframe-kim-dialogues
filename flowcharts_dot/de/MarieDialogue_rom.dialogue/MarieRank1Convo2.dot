		j129698615 -> "Chat ends.";
	j442954030 [label="Hum ? Pourquoi ? Oh ... weil er noch nicht über dieses Gerät mit dir spricht ?",shape=box,color=blue];
		j442954030 -> j2515413686;
		j442954030 -> j213840698;
