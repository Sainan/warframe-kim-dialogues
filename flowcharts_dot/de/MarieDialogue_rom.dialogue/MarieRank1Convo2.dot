digraph {
	57 [label="MarieRank1Convo2 begins.",color=orange];
		57 -> 59;
		57 -> 58;
	59 [label="Marie? Habe ich Lyon irgendwie beleidigt?",shape=box,color=red];
		59 -> 61;
	58 [label="[Ende.]",shape=box,color=red];
		58 -> 60;
	61 [label="Hum ? Pourquoi ? Oh ... weil er noch nicht über dieses Gerät mit dir spricht ?",shape=box,color=blue];
		61 -> 62;
		61 -> 63;
		61 -> 64;
	60 [label="Chat ends.",color=orange];
	62 [label="Kann er nicht tippen?",shape=box,color=red];
		62 -> 65;
	63 [label="Ist er technophob?",shape=box,color=red];
		63 -> 66;
	64 [label="Stimmt. Ich dachte, da du und Roathe beide hier seid ...",shape=box,color=red];
		64 -> 67;
	65 [label="Ha ! Er ist einer der lernfähigsten, die ich je getroffen habe, Drifter! Ich an deiner Stelle wäre vorsichtig, ihn zu Rätselwetten herauszufordern, bei denen es um Geld geht.",shape=box,color=blue];
		65 -> 67;
	66 [label="Non, er kommt gut mit Neuem zurecht. Ich traue es ihm zu, die machines ambulantes, die in den Höhlen da unten herumstampfen, studiert zu haben und bald seine eigenen Pläne zu entwickeln.",shape=box,color=blue];
		66 -> 67;
	67 [label="Es liegt einfach daran, dass er dich nicht kennt. Lyon ist nicht gerade ... gesellig. Das soll dich nicht beleidigen.",shape=box,color=blue];
		67 -> 68;
		67 -> 69;
	68 [label="Kannst du irgendetwas machen?",shape=box,color=red];
		68 -> 70;
	69 [label="Ich bin froh, dass ich nicht der Grund bin ...",shape=box,color=red];
		69 -> 71;
	70 [label="Lyon hat ... viel Lärm in seinem Kopf. Er achtet sehr darauf, mit wem er ihn teilt.",shape=box,color=blue];
		70 -> 72;
	71 [label="+5 Chemistry",color=orange];
		71 -> 73;
	72 [label="+15 Chemistry",color=orange];
		72 -> 74;
	73 [label="Non, non, non, du bist es nicht. Lyon hat ... viel Lärm in seinem Kopf. Er achtet sehr darauf, mit wem er ihn teilt.",shape=box,color=blue];
		73 -> 72;
	74 [label="Es wird Zeit brauchen. Und Geduld.",shape=box,color=blue];
		74 -> 75;
	75 [label="Ah ! Ich muss gehen. Wir sprechen uns bald.",shape=box,color=blue];
		75 -> 76;
	76 [label="Chat ends.",color=orange];
}