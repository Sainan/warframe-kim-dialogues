	"Chat ends." [color=orange];
	j2515413686 [label="Kann er nicht tippen?",shape=box,color=red];
		j2515413686 -> j333669751;
	j213840698 [label="Ist er technophob?",shape=box,color=red];
		j213840698 -> j3385293880;
	j1869253079 [label="Stimmt. Ich dachte, da du und Roathe beide hier seid ...",shape=box,color=red];
		j1869253079 -> j2347988186;
	j333669751 [label="Ha ! Er ist einer der lernfähigsten, die ich je getroffen habe, Drifter! Ich an deiner Stelle wäre vorsichtig, ihn zu Rätselwetten herauszufordern, bei denen es um Geld geht.",shape=box,color=blue];
		j333669751 -> j2347988186;
	j3385293880 [label="Non, er kommt gut mit Neuem zurecht. Ich traue es ihm zu, die machines ambulantes, die in den Höhlen da unten herumstampfen, studiert zu haben und bald seine eigenen Pläne zu entwickeln.",shape=box,color=blue];
		j3385293880 -> j2347988186;
	j2347988186 [label="Es liegt einfach daran, dass er dich nicht kennt. Lyon ist nicht gerade ... gesellig. Das soll dich nicht beleidigen.",shape=box,color=blue];
		j2347988186 -> j2554876373;
		j2347988186 -> j1088487820;
	j2554876373 [label="Kannst du irgendetwas machen?",shape=box,color=red];
		j2554876373 -> j149392303;
	j1088487820 [label="Ich bin froh, dass ich nicht der Grund bin ...",shape=box,color=red];
		j1088487820 -> j2876119303;
	j149392303 [label="Lyon hat ... viel Lärm in seinem Kopf. Er achtet sehr darauf, mit wem er ihn teilt.",shape=box,color=blue];
		j149392303 -> j1771588857;
	j2876119303 [label="+5 Chemistry",color=orange];
		j2876119303 -> j1391854914;
	j1771588857 [label="+15 Chemistry",color=orange];
		j1771588857 -> j1161633733;
	j1391854914 [label="Non, non, non, du bist es nicht. Lyon hat ... viel Lärm in seinem Kopf. Er achtet sehr darauf, mit wem er ihn teilt.",shape=box,color=blue];
		j1391854914 -> j1771588857;
	j1161633733 [label="Es wird Zeit brauchen. Und Geduld.",shape=box,color=blue];
		j1161633733 -> j4292995835;
	j4292995835 [label="Ah ! Ich muss gehen. Wir sprechen uns bald.",shape=box,color=blue];
		j4292995835 -> "Chat ends.";
}