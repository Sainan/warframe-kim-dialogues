	j1013516414 [label="Marie, er ist kein Gott. Er ist nur ein Mann. Er ist genauso arrogant und genauso gefährlich wie Roathe. Er stammt aus derselben Gesellschaft und leidet unter denselben Problemen.",shape=box,color=red];
		j1013516414 -> j2295799795;
	j4085914923 [label="Ich weiß, dass er gütig zu dir war. Ich weiß, dass er zu dir anders war, als zu einer Menge anderer Leute. Vielleicht hat er dich sogar wie eine Tochter behandelt... Aber bitte sieh dir das große Ganze an.",shape=box,color=red];
