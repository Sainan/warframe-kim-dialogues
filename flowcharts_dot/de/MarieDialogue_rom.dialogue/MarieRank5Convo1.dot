digraph {
	"MarieRank5Convo1 begins." [color=orange];
		"MarieRank5Convo1 begins." -> j1250159667;
	j1250159667 [label="Können wir uns unterhalten ?",shape=box,color=blue];
		j1250159667 -> j709500590;
	j709500590 [label="Evaluate expressions",color=orange];
		j709500590 -> j3395010155 [label="MarieEntrati4a",color=purple];
		j709500590 -> j1149198031 [label="MarieEntrati4b",color=purple];
		j709500590 -> j3979403597 [label="MarieEntrati3a",color=purple];
		j709500590 -> j2316387598 [label="MarieEntrati3b",color=purple];
		j709500590 -> j2475849341 [label="MarieEntrati3",color=purple];
		j709500590 -> j2365498706 [label="false",color=purple];
	j3395010155 [label="Ich habe darüber nachgedacht, was du über le Cardinal gesagt hast. Seine Taten sind eine... \"Mischung\" aus Gut und Böse.",shape=box,color=blue];
		j3395010155 -> j3348255589;
	j1149198031 [label="Ich habe darüber nachgedacht, was du über le Cardinal gesagt hast. Seine Taten haben Lyon Schmerzen zugefügt.",shape=box,color=blue];
		j1149198031 -> j3348255589;
	j3979403597 [label="Ich habe nochmal über unser Gespräch über M'sieur Tagfer nachgedacht und deine Argumente, warum er le Cardinal so sehr hasst.",shape=box,color=blue];
		j3979403597 -> j3348255589;
	j2316387598 [label="Ich habe weiter über mein Streitgespräch mit M'sieur Tagfer nachgedacht und seine Gründe, warum er le Cardinal so sehr hasst.",shape=box,color=blue];
		j2316387598 -> j3348255589;
	j2475849341 [label="Ich habe weiter über mein Streitgespräch mit M'sieur Tagfer nachgedacht. Und unsere Debatte über das Gespräch.",shape=box,color=blue];
		j2475849341 -> j3348255589;
	j2365498706 [label="Ich habe das Gefühl, im Bezug auf le Cardinal ist vieles unausgesprochen geblieben. Die anderen gehen, wie auf Eiern, aus Angst, über ihn zu sprechen.",shape=box,color=blue];
		j2365498706 -> j3348255589;
	j3348255589 [label="Ich weiß, dass andere ihn als Hund, als Wahnsinnigen oder Verräter hinstellen wollen. Aber für mich war er nichts davon.",shape=box,color=blue];
		j3348255589 -> j2718976672;
	j2718976672 [label="Check boolean MarieBackstory1",color=orange];
		j2718976672 -> j2625835653 [label=true,color=green];
		j2718976672 -> j4034672386 [label=false,color=brown];
	j2625835653 [label="Vielleicht liegt es daran, dass ich es gewöhnt bin, verlassen zu werden.",shape=box,color=blue];
		j2625835653 -> j1954651353;
	j4034672386 [label="Meine Familie hat mich verlassen, mich als Kind in den Straßen zurückgelassen, weil ich... abnormal was. Kaputt. Ungeeignet für die feine Gesellschaft.",shape=box,color=blue];
		j4034672386 -> j1954651353;
	j1954651353 [label="Vielleicht liegt es daran, dass ich wirklich einen Vater hatte und daher bin ich bereitwillig, ihm seine Abwesenheit zu vergeben.",shape=box,color=blue];
		j1954651353 -> j4106479212;
	j4106479212 [label="Evaluate expressions",color=orange];
		j4106479212 -> j207127346 [label="MarieEntrati4a",color=purple];
		j4106479212 -> j2799827588 [label="MarieEntrati4b",color=purple];
		j4106479212 -> j2877871582 [label="MarieEntrati3a",color=purple];
		j4106479212 -> j1874072273 [label="MarieEntrati3b",color=purple];
		j4106479212 -> j2015728857 [label="MarieEntrati3",color=purple];
		j4106479212 -> j887145478 [label="false",color=purple];
	j207127346 [label="Aber die Tatsache bleibt, dass ich ihm vergebe. Ich sehe mehr Wert in seinen guten Taten, als Schaden in seinen schlechten.",shape=box,color=blue];
		j207127346 -> j3718054759;
		j207127346 -> j3533589460;
		j207127346 -> j2118063649;
		j207127346 -> j904096497;
		j207127346 -> j3395796669;
	j2799827588 [label="Ich bete darum, dass Lyon stark ist und seine Glaubenskrise übersteht, aber ich glaube nicht, sie alleine die Schuld von le Cardinal ist.",shape=box,color=blue];
		j2799827588 -> j3718054759;
		j2799827588 -> j3533589460;
		j2799827588 -> j2118063649;
		j2799827588 -> j2201040331;
		j2799827588 -> j3456329257;
	j2877871582 [label="Während ich also deine überzeugenden Argumente in Bezug auf M'sieur Tagfer und alle, denen er Schaden zugefügt hat, schätze, sehe ich dennoch mehr Wert in seinen guten Taten als Schaden in seinen üblen.",shape=box,color=blue];
		j2877871582 -> j3718054759;
		j2877871582 -> j3533589460;
		j2877871582 -> j2118063649;
		j2877871582 -> j3461481463;
		j2877871582 -> j2730054195;
	j1874072273 [label="Doch während ich M'sieur Tagfers Wut verstehe und auch seine Argumente nachvollziehen kann, muss er selbst einen Weg finden, le Cardinal zu vergeben. Denn ich sehe mehr Wert in le Cardinals guten Taten als Schaden in seinen üblen.",shape=box,color=blue];
		j1874072273 -> j3718054759;
		j1874072273 -> j3533589460;
		j1874072273 -> j2118063649;
		j1874072273 -> j3568089236;
		j1874072273 -> j124385949;
	j2015728857 [label="Ich verstehe die Vergangenheit, die alle mit le Cardinal verbindet, vor allem die von M'sieur Tagfer, aber ich sehe trotzdem mehr Wert in seinen guten Taten als Schaden in seinen schlechten.",shape=box,color=blue];
		j2015728857 -> j3718054759;
		j2015728857 -> j3533589460;
		j2015728857 -> j2118063649;
		j2015728857 -> j409089786;
	j887145478 [label="Ich verstehe die Vergangenheit, die alle mit le Cardinal verbindet, aber ich sehe trotzdem mehr Wert in seinen guten Taten als Schaden in seinen schlechten.",shape=box,color=blue];
		j887145478 -> j3718054759;
		j887145478 -> j3533589460;
		j887145478 -> j2118063649;
	j3718054759 [label="Ich mache dir keinen Vorwurf, dass du das Gute schätzt, was er in seinem Leben getan hat, genauso wie ich anderen keinen Vorwurf machen kann, dass sie den Schaden verabscheuen, den er bei ihnen anrichtet hat.",shape=box,color=red];
		j3718054759 -> j1061225286;
	j3533589460 [label="Ich weiß nicht. Ich glaube seine Taten haben mehr zu Schlechtem, als zu Gutem geführt. Ich wünschte, du könntest das auch so sehen.",shape=box,color=red];
		j3533589460 -> j4288371264;
	j2118063649 [label="Ich bin auf deiner Seite Marie. Ich kann Entrati nichts von dem übel nehmen, was er getan hat. Er bekämpft die Gleichgültigkeit.",shape=box,color=red];
		j2118063649 -> j3142094137;
	j904096497 [label="Du hast recht damit, Entrati zu vergeben. Ich wünschte, die anderen würden deinem Beispiel folgen.",shape=box,color=red];
		j904096497 -> j3142094137;
	j3395796669 [label="Ich kann niemandem Vergebung vorwerfen. But man kann jemandem vergeben und gleichzeitig sich selbst und andere vor dieser Person schützen.",shape=box,color=red];
		j3395796669 -> j3033415252;
	j2201040331 [label="Glaubst du, Lyons Leid ist seine eigene Schuld?",shape=box,color=red];
		j2201040331 -> j2915043901;
	j3456329257 [label="Lyon leidet unter weit mehr, als nur einer Glaubenskrise, Marie. Und vieles davon, hat mit Entrati zu tun.",shape=box,color=red];
		j3456329257 -> j4288371264;
	j3461481463 [label="Nichts von dem, was ich gesagt habe, hat das Ungleichgewicht auch nur im Geringsten ausgeglichen?",shape=box,color=red];
		j3461481463 -> j1584738827;
	j2730054195 [label="Wie kannst du angesichts all dessen, was Entrati getan hat, immer noch mehr Gutes als Schlechtes sehen?",shape=box,color=red];
		j2730054195 -> j4288371264;
	j3568089236 [label="Ich glaube, du unterschätzt den Ernst dessen, was die Cavia und Tagfer durchgemacht haben.",shape=box,color=red];
		j3568089236 -> j4288371264;
	j124385949 [label="Vergebung ist wichtig. Aber es ist ebenso wichtig anzuerkennen, dass Entrati komplizierter sein könnte, als du bereit bist zuzugeben.",shape=box,color=red];
		j124385949 -> j1584738827;
	j409089786 [label="Ich glaube, du verstehst immer noch nicht, was Tagfer und die Cavia durchgemacht haben. Es ist schlimmer als das, was du durchgemacht hast.",shape=box,color=red];
		j409089786 -> j4288371264;
	j1061225286 [label="Aber du verstehst, dass die beiden nicht gleichwertig sind ? Verbitterung und Ehrfurcht ? Ich möchte, dass die anderen ihren bösartigen Groll aufgeben.",shape=box,color=blue];
		j1061225286 -> j3645475188;
		j1061225286 -> j405153589;
	j4288371264 [label="Evaluate expressions",color=orange];
		j4288371264 -> j2755771920 [label="MarieEntratiMonster1",color=purple];
		j4288371264 -> j2755771920 [label="MarieEntratiMonster2",color=purple];
		j4288371264 -> j2965379006 [label="MarieEntratiFan1",color=purple];
		j4288371264 -> j2965379006 [label="MarieEntratiFan2",color=purple];
		j4288371264 -> j2597298134 [label="false",color=purple];
	j3142094137 [label="Evaluate expressions",color=orange];
		j3142094137 -> j682971368 [label="MarieEntratiMonster1",color=purple];
		j3142094137 -> j682971368 [label="MarieEntratiMonster2",color=purple];
		j3142094137 -> j1486028337 [label="MarieEntratiFan1",color=purple];
		j3142094137 -> j1486028337 [label="MarieEntratiFan2",color=purple];
		j3142094137 -> j3877121828 [label="false",color=purple];
	j3033415252 [label="Und das ist dein Vorschlag ? Le Cardinal verstoßen ? Mein Argument wäre, das hat er sich bereits selbst angetan, non ?",shape=box,color=blue];
		j3033415252 -> j4238362439;
		j3033415252 -> j405153589;
	j2915043901 [label="Ich denke, Lyon leidet unter vielen Problemen und die meisten davon gehen auf seine Selbstzweifel zurück und das er seinem eigenen Verstand nicht traut. Le Cardinal scheint ... das nur verschlimmert zu haben.",shape=box,color=blue];
		j2915043901 -> j1794332031;
		j2915043901 -> j405153589;
	j1584738827 [label="Und was genau soll ich machen ? Eine le Cardinal Puppe verbrennen und mich abwenden ? Ihn in den Void verbannen, ihm Schlechtes wünschen, wie M'sieur Tagfer ?",shape=box,color=blue];
		j1584738827 -> j4238362439;
		j1584738827 -> j405153589;
	j3645475188 [label="Das ist das Problem, Marie. Was du von anderen erwartest. Nicht, was sie von dir erwarten. Oder von Entrati.",shape=box,color=red];
		j3645475188 -> j579507044;
	j405153589 [label="Entrati hinterlässt Verletzungen, wo immer er auftaucht. Ich versuche nur den Menschen zu helfen, wieder auf die Beine zu kommen. \"gut\" oder \"böse\" interessiert mich in diesem Fall nicht wirklich.",shape=box,color=red];
		j405153589 -> j141602266;
	j2755771920 [label="Oui, und du bist sehr konsequent in deinem Hass auf ihn ! Hat nichts von dem, was ich gesagt habe, dich milder im Bezug auf le Cardinal gestimmt ?",shape=box,color=blue];
		j2755771920 -> j2725961914;
	j2965379006 [label="Hast du mir nicht gerade erst gesagt, dass du Entrati bevorzugst, genau, wie ich ? Was hat auf einmal deine Meinung geändert ?",shape=box,color=blue];
		j2965379006 -> j3575126283;
		j2965379006 -> j20009267;
		j2965379006 -> j2924158907;
		j2965379006 -> j3911119020;
	j2597298134 [label="Oui, und du scheinst du glauben, dass Entrati ein solches monstre ist ! Du tust seine Güte sehr schnell ab !",shape=box,color=blue];
		j2597298134 -> j2725961914;
	j682971368 [label="Hast du mir nicht gerade erst von Entratis monstruosité erzählt ? Was hat auf einmal deine Meinung geändert ?",shape=box,color=blue];
		j682971368 -> j3575126283;
		j682971368 -> j20009267;
		j682971368 -> j2924158907;
		j682971368 -> j3911119020;
	j1486028337 [label="Merci und du bist mein treuer Begleiter auf diesem Kreuzzug! Ich fürchte, wir sind mit dieser Ansicht allein – selbst Monsieur Loid hegt solchen Groll...",shape=box,color=blue];
		j1486028337 -> j3005422629;
	j3877121828 [label="Merci und wie es mich freut, das zu hören ! Aber ich fürchte, damit stehen wir alleine da - sogar Monsieur Loid hegt einen solchen Groll...",shape=box,color=blue];
		j3877121828 -> j3005422629;
	j4238362439 [label="Ich glaube, das Problem ist eher, was du von anderen erwartest, nicht, was sie von dir erwarten. Oder Entrati.",shape=box,color=red];
		j4238362439 -> j579507044;
	j1794332031 [label="Und das stört dich nicht?",shape=box,color=red];
		j1794332031 -> j2159116448;
	j579507044 [label="Und was erwarte ich von anderen, dass so grotesk ist ? Dass sie Vergebung in ihre Herzen aufnehmen ?",shape=box,color=blue];
		j579507044 -> j224460203;
		j579507044 -> j551416000;
	j141602266 [label="Es ist nobel, aber ermüdend, durch Raum und Zeit zu reisen und seinen mécontents zu helfen, non ? Sicher verübelst du ihm das...",shape=box,color=blue];
		j141602266 -> j1417843886;
		j141602266 -> j2855454013;
	j2725961914 [label="Dieses Gespräch war ein Fehler...",shape=box,color=blue];
		j2725961914 -> j3284178398;
		j2725961914 -> j2968321534;
	j3575126283 [label="Es fällt mir schwer, mit dir über dieses Thema zu reden. Sehr schwer. Ich persönlich glaube, dass er ... weder gut noch böse ist. Eher eine Mischung.",shape=box,color=red];
		j3575126283 -> j1446304179;
	j20009267 [label="Ich habe meine Meinung tatsächlich geändert. Ich bin auf seiner Seite. Und deiner. Du hast mich überzeugt.",shape=box,color=red];
		j20009267 -> j4052390903;
	j2924158907 [label="[Gefühle gestehen.] Ich versuche nur mein Bestes ... mich einzuschmeicheln, fürchte ich. Ich habe Gefühle für dich. Mehr, als ich zugegeben will.",shape=box,color=red];
		j2924158907 -> j1823840953;
	j3911119020 [label="Ich hab einfach meine Meinung geändert und entschieden, dass er ein Monster ist. Ein für alle mal.",shape=box,color=red];
		j3911119020 -> j101399395;
	j3005422629 [label="Vielleicht können wir uns zusammen gegen diejenigen stellen, die seine guten Taten herabwürdigen wollen, oui ? Aber ich frage mich, bei allem, was dich umgibt... warum ergreifst du meine Seite ?",shape=box,color=blue];
		j3005422629 -> j107834219;
	j2159116448 [label="Check boolean LyonDating",color=orange];
		j2159116448 -> j1218588452 [label=true,color=green];
		j2159116448 -> j1586872330 [label=false,color=brown];
	j224460203 [label="Du hast Entrati auf ein Podest gestellt, Marie. Und du verlangst von anderen, dass sie dasselbe tun, als wären sie Idioten.",shape=box,color=red];
		j224460203 -> j2344799009;
	j551416000 [label="Ich glaube, du verlangst mehr von ihnen, als Entrati zu vergeben. Du verlangst von ihnen so zu tun, als wäre nichts von dem, was er getan hat, je falsch gewesen.",shape=box,color=red];
		j551416000 -> j2441059837;
	j1417843886 [label="Sicher. Aber ich \"verdanke\" ihm auch einige der wichtigsten Beziehungen und Freundschaften, die je gehabt habe.",shape=box,color=red];
		j1417843886 -> j3885510894;
	j2855454013 [label="Nein, nicht wirklich. Er braucht meine Hilfe, also tue ich es. Ich werde über ihn urteilen, wenn das alles vorbei ist.",shape=box,color=red];
		j2855454013 -> j3885510894;
	j3284178398 [label="Warte, Marie. Bitte. Lass es mich erklären.",shape=box,color=red];
		j3284178398 -> j2557225687;
		j3284178398 -> j3986323888;
		j3284178398 -> j671203160;
		j3284178398 -> j1965578273;
	j2968321534 [label="Ich habe sehr deutlich gemacht, was ich von Entrati halte. Es tut mir leid. Bei manchen Dingen sind wir einfach unterschiedlicher Meinung.",shape=box,color=red];
		j2968321534 -> j212343863;
	j1446304179 [label="Boolean MarieEntratiMonster1 is now false.",color=orange];
		j1446304179 -> j3351924048;
	j4052390903 [label="Boolean MarieEntratiMonster1 is now false.",color=orange];
		j4052390903 -> j1456656860;
	j1823840953 [label="Boolean DrifterMarieWhoops is now true.",color=orange];
		j1823840953 -> j2336264612;
	j101399395 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j101399395 -> j1853048268;
	j107834219 [label="Versteh mich nicht falsch, ich beschwere mich nicht !",shape=box,color=blue];
		j107834219 -> j3395894333;
		j107834219 -> j2080498305;
		j107834219 -> j2774290388;
	j1218588452 [label="Ich weiß, dass er einen Platz in deinem Herzen gefunden hat und dafür bin ich dankbar - vielleicht kann ich endlich aufhören, mir Sorgen um ihn zu machen und dieser ganze Streit ist bald überflüssig - ",shape=box,color=blue];
		j1218588452 -> j1586872330;
	j1586872330 [label="Natürlich bedrückt es mich. Er ist mein Seelenbruder ! Mein Lyon ist mir das Liebste auf der Welt und ihn leiden zu sehen, schmerzt mich, als wäre sein Leid mein eigenes.",shape=box,color=blue];
		j1586872330 -> j875982284;
	j2344799009 [label="Pass auf, was du sagst, Drifter.",shape=box,color=blue];
		j2344799009 -> j2797280948;
	j2441059837 [label="Je ne suis pas naïve, also sprich nicht mit mir, als wäre ich eins !",shape=box,color=blue];
		j2441059837 -> j2536027485;
	j3885510894 [label="Vielleicht nutzt er nur ein Gift, damit der Körper sich selbst heilen kann und all dies ist nur eine notwendige Grausamkeit.",shape=box,color=blue];
		j3885510894 -> j343265001;
		j3885510894 -> j1473087932;
	j2557225687 [label="[Gefühle gestehen.] Du bist mir wichtig. Mehr, als ich zugegeben habe. Und ... es tut mir leid, dass ich so hart war, aber ich kann nicht zulassen, dass er dich verletzt. Nicht, wie er so viele andere verletzt hat.",shape=box,color=red];
		j2557225687 -> j3632601017;
	j3986323888 [label="Ich habe zugesehen, wie Entrati nichts getan hat, als jeden im Stich zu lassen, der ihm etwas bedeutet hat. Jeden, den er angeblich geliebt hat. Ich will nicht, dass dir das auch passiert.",shape=box,color=red];
		j3986323888 -> j3528803587;
	j671203160 [label="Ich kann mich nicht gut ausdrücken, dafür entschuldige ich mich. Aber er ... ich fürchte, er benutzt dich nur und benutzt deine Güte, um dich zu manipulieren. Das ist alles.",shape=box,color=red];
		j671203160 -> j181132570;
	j1965578273 [label="Du magst Entrati ja als Retter sehen, aber ich sehe ihn als alten, verängstigten Mann, der verzweifelt nach Antworten sucht. Vielleicht liegt die Wahrheit irgendwo dazwischen.",shape=box,color=red];
		j1965578273 -> j2344799009;
	j212343863 [label="Oui. So sieht es wohl aus.",shape=box,color=blue];
		j212343863 -> j3051126039;
	j3351924048 [label="Boolean MarieEntratiMonster2 is now false.",color=orange];
		j3351924048 -> j3516804486;
	j1456656860 [label="Boolean MarieEntratiMonster2 is now false.",color=orange];
		j1456656860 -> j1535327832;
	j2336264612 [label="Und du hast dich entschieden, mich zu täuschen, um meine Gunst zu gewinnen... je vois.",shape=box,color=blue];
		j2336264612 -> j3069197137;
		j2336264612 -> j300435951;
	j1853048268 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j1853048268 -> j2089095377;
	j3395894333 [label="[Gefühle gestehen.] Du bedeutest mir etwas. Mehr als ich zugegeben will.",shape=box,color=red];
		j3395894333 -> j2090528097;
	j2080498305 [label="Ich glaube, in diesem Krieg ist alles nötig. Immerhin versuchen wir, das Universum gegen die Gleichgültigkeit zu verteidigen, nicht wahr?",shape=box,color=red];
		j2080498305 -> j3587846330;
	j2774290388 [label="Ich glaube an Entrati. Ehrlich. Ich glaube, er einen Plan, eine Lösung und das alles letztendlich dem Wohl aller dient.",shape=box,color=red];
		j2774290388 -> j618061584;
	j875982284 [label="Aber sein Abfall vom Glauben ist nicht das Werk von le Cardinal. Die Risse im Fundament waren schon vorher da. Es kam lediglich weiterer Druck dazu, oui ?",shape=box,color=blue];
		j875982284 -> j3885510894;
	j2797280948 [label="Boolean MarieWarning is now true.",color=orange];
		j2797280948 -> j2441059837;
	j2536027485 [label="Ich weiß sehr wohl, dass le Cardinal sowohl Lua als auch Sol ist - gut und böse. Er ist keins von beidem und er ist beides, fähig zu Güte und Grausamkeit.",shape=box,color=blue];
		j2536027485 -> j1013516414;
		j2536027485 -> j4085914923;
	j343265001 [label="Deshalb sind die anderen verärgert, wenn du über ihn sprichst. Du überspielst alles, was er anderen angetan und tust so, als wäre nichts passiert, als wären sie Idioten.",shape=box,color=red];
		j343265001 -> j2344799009;
	j1473087932 [label="Marie, hör auf. Du musst akzeptieren, dass er dies alles nicht nur tut, weil er ein guter Mann ist. Das ist er nicht. Er ist komplizierter als das.",shape=box,color=red];
		j1473087932 -> j2441059837;
	j3632601017 [label="Boolean DrifterMarie is now true.",color=orange];
		j3632601017 -> j31252668;
	j3528803587 [label="Pass auf, was du sagst, Drifter.",shape=box,color=blue];
		j3528803587 -> j3209977669;
	j181132570 [label="So, wie ich bin, muss ich nicht beschützt werden ! Je ne suis pas une enfant naïve !",shape=box,color=blue];
		j181132570 -> j3062583130;
	j3051126039 [label="Boolean MarieEntrati5g is now true.",color=orange];
		j3051126039 -> "Chat ends. Next chat will be MarieEntratiDay2.";
	j3516804486 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j3516804486 -> j38378398;
	j1535327832 [label="Boolean MarieEntratiFan2 is now true.",color=orange];
		j1535327832 -> j2994429700;
	j3069197137 [label="Na, wenn du es so ausdrückst ...",shape=box,color=red];
		j3069197137 -> j1073700449;
	j300435951 [label="Nur teilweise.",shape=box,color=red];
