		j3399525703 -> j232946136;
		j3399525703 -> j3091314036;
		j3399525703 -> j2504803174;
	j3043177891 [label="Ich könnte dich dasselbe über Lua fragen, nicht wahr ? Warum bist du gläubig ?",shape=box,color=blue];
		j3043177891 -> j767696128;
		j3043177891 -> j232946136;
		j3043177891 -> j3091314036;
		j3043177891 -> j2504803174;
		j3043177891 -> j1387548500;
	j1367079213 [label="Warum gerade Sol ? Statt Lua oder vielleicht wegen der Ausgewogenheit, die dir wichtig ist ? Eine sehr gute Frage. Warum bist du gläubig ?",shape=box,color=blue];
		j1367079213 -> j767696128;
		j1367079213 -> j1387548500;
		j1367079213 -> j232946136;
		j1367079213 -> j3091314036;
		j1367079213 -> j2504803174;
	j3306972105 [label="Du fragst dich, woher ich meine Gewissheit nehme ? Da du sagst, dass wir das Universum nicht kennen ?",shape=box,color=blue];
		j3306972105 -> j2109688353;
	j2165175733 [label="Da du keiner Religion angehörst, kann ich verstehen, warum das seltsam erscheinen mag, oui.",shape=box,color=blue];
		j2165175733 -> j88712949;
	j2620008947 [label="Du fragst dich, woher ich meine Gewissheit nehme ?",shape=box,color=blue];
		j2620008947 -> j2109688353;
	j1132726391 [label="Weißt du, was das bedeutet ?!",shape=box,color=blue];
		j1132726391 -> j3049729072;
		j1132726391 -> j4291082108;
	j1002775741 [label="Oui ! Ich mag keine Schnittblumen. Wenn du mir etwas schenken möchtest, dann bitte keine Rosen in einer Vase.",shape=box,color=blue];
		j1002775741 -> j613906330;
		j1002775741 -> j2834632384;
	j3648719684 [label="Pour toi ? Bien sûr.",shape=box,color=blue];
		j3648719684 -> j2721345201;
		j3648719684 -> j129698615;
	j767696128 [label="Ich ... fühle mich wohl dazu verpflichtet.",shape=box,color=red];
		j767696128 -> j3222404579;
	j1387548500 [label="Ich war nicht wirklich ehrlich zu dir, als ich dir diese Antwort gab.",shape=box,color=red];
		j1387548500 -> j3679956925;
	j232946136 [label="Ich hatte ein Erlebnis. Es hat mein Leben verändert.",shape=box,color=red];
		j232946136 -> j3646424098;
	j3091314036 [label="Es ist nie etwas passiert, es ist einfach ein Gefühl, das ich habe. Es hat mich geleitet.",shape=box,color=red];
		j3091314036 -> j4190199247;
	j2504803174 [label="Ich möchte glauben. Deshalb tue ich es.",shape=box,color=red];
		j2504803174 -> j3080931226;
	j2109688353 [label="Ich fürchte, meine Antwort wird dich enttäuschen, Wolf. Es gab kein großes miracle. Keine Strahlen vom Himmel, die auf mich herabfielen.",shape=box,color=blue];
		j2109688353 -> j2362127900;
	j88712949 [label="\"Warum glaubt diese vernünftige junge Frau an Dinge, die ich nicht für real halte ? Das erscheint mir albern.\", non ?",shape=box,color=blue];
		j88712949 -> j3713145166;
		j88712949 -> j3090073057;
	j3049729072 [label="Nein?",shape=box,color=red];
		j3049729072 -> j2421704032;
	j4291082108 [label="Habe ich Grund zur Besorgnis?",shape=box,color=red];
		j4291082108 -> j1165185108;
	j613906330 [label="Woher wusstest du, dass ich das fragen würde? Das ist unglaublich.",shape=box,color=red];
		j613906330 -> j930984418;
	j2834632384 [label="Das ... wollte ich nicht fragen, aber ich werde es mir merken, vielen Dank!",shape=box,color=red];
		j2834632384 -> j1992944777;
	j2721345201 [label="Warum glaubst du an Sol?",shape=box,color=red];
		j2721345201 -> j2563733639;
	j3222404579 [label="Check boolean DrifterFaithNoPeace",color=orange];
		j3222404579 -> j2034057090 [label=true,color=green];
		j3222404579 -> j3175525917 [label=false,color=brown];
	j3679956925 [label="Oui ? Ich bin neugierig, warum hast du gelogen ?",shape=box,color=blue];
		j3679956925 -> j121403475;
		j3679956925 -> j1229105045;
	j3646424098 [label="Dann bin ich neidisch ! Die meisten haben nicht das Glück, ein so besonderes Ereignis vorweisen zu können, oui ?",shape=box,color=blue];
		j3646424098 -> j2370799863;
	j4190199247 [label="Ah, dann sind unsere Antworten gleich. Ich habe noch nie un miracle erlebt, außer vielleicht le Cardinal's Ankunft in der Cathédrale.",shape=box,color=blue];
		j4190199247 -> j169677543;
	j3080931226 [label="Check boolean DrifterFaithNoPeace",color=orange];
		j3080931226 -> j4145501426 [label=true,color=green];
		j3080931226 -> j765386807 [label=false,color=brown];
	j2362127900 [label="Non, ich hatte immer nur das Gefühl, dass in meinem Leben eine présence war, die mich geführt hat. Ein Gönner, der lächelt und mir den Weg weist, wenn ich an einer Weggabelung stehe, nicht mehr und nicht weniger.",shape=box,color=blue];
		j2362127900 -> j1642468076;
		j2362127900 -> j3549644584;
	j3713145166 [label="Ehrlich? Ja, irgendwie schon. Ich wollte es aber nicht so formulieren.",shape=box,color=red];
		j3713145166 -> j926380977;
	j3090073057 [label="Ich habe mich eher gefragt, ob es ein Ereignis oder ... einen Moment gab, der dazu geführt hat.",shape=box,color=red];
		j3090073057 -> j2109688353;
	j2421704032 [label="Ich auch nicht ! Aber die Möglichkeiten sind jetzt endlos !",shape=box,color=blue];
		j2421704032 -> j3289359978;
	j1165185108 [label="Peut-être ! Denn die Möglichkeiten sind jetzt endlos !",shape=box,color=blue];
		j1165185108 -> j3289359978;
	j930984418 [label="Der Teufel hat mir gesagt, du würdest das fragen.",shape=box,color=blue];
		j930984418 -> j2041846252;
	j1992944777 [label="Oh ! Oh, entschuldige ! Es tut mir leid. Was wolltest du wissen ? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		j1992944777 -> j2721345201;
		j1992944777 -> j129698615;
	j2034057090 [label="Und du sagst, es bringe dir nicht wirklich Frieden ... das bricht mir das Herz.",shape=box,color=blue];
		j2034057090 -> j3175525917;
	j3175525917 [label="Ich werde dir nicht vorschreiben, was zu tun ist. Und ich werde dir nicht sagen, welche Wege du einschlagen sollst.",shape=box,color=blue];
		j3175525917 -> j3211352625;
	j121403475 [label="Um ehrlich zu sein, ich bin mir nicht sicher. Es war eine impulsive Entscheidung.",shape=box,color=red];
		j121403475 -> j1118639586;
	j1229105045 [label="Ich dachte, es wäre eine Möglichkeit, dich besser kennenzulernen ...",shape=box,color=red];
		j1229105045 -> j3733340938;
	j2370799863 [label="Aber deine Frage bezog sich darauf, warum ich gläubig bin, und ich war unhöflich, dies als Gegenfrage zu stellen, je m'excuse.",shape=box,color=blue];
		j2370799863 -> j2109688353;
	j169677543 [label="Selbst das, das war ein Werk von Mensch und Wissenschaft, nicht das der Himmlischen, non ? Dieses sérum, das mir die Gabe des Fliegens verlieh –",shape=box,color=blue];
		j169677543 -> j1425141446;
	j4145501426 [label="Aber du sagst, es bringt dir nicht wirklich Frieden ? Das bricht mir das Herz ...",shape=box,color=blue];
		j4145501426 -> j2816296721;
	j765386807 [label="Ich denke, dein Glaube ist vielleicht der stärkste von allen, non ?",shape=box,color=blue];
		j765386807 -> j1465720927;
	j1642468076 [label="Du würdest Entratis Serum nicht als Wunder bezeichnen?",shape=box,color=red];
		j1642468076 -> j169677543;
	j3549644584 [label="Nicht einmal Lyons Stimmen? Oder die Gleichgültigkeit?",shape=box,color=red];
		j3549644584 -> j3164290240;
	j926380977 [label="Oh, mich für verrückt zu halten, weil ich an die Himmlischen glaube, ist eins der höflichsten Dinge, die man über jemanden mit einem anderen Glauben denken kann.",shape=box,color=blue];
		j926380977 -> j1283991882;
	j3289359978 [label="Der Teufel sollte sich sehr fürchten ! Hüte dich, du Sündhafter! Das Licht wird dich von oben peinigen !",shape=box,color=blue];
		j3289359978 -> j2718912295;
	j2041846252 [label="Nein, nein, nein... Das wolltest du gar nicht fragen, oder ? Ah !! Je vais lui faire bouffer un de ces livres !",shape=box,color=blue];
		j2041846252 -> j2004606596;
	j3211352625 [label="Denn ich bin ein armseliger Zufluchtsort in diesem Void-Sturm, in dem du dich befindest.",shape=box,color=blue];
		j3211352625 -> j317087034;
	j1118639586 [label="Ich weiß nicht, welcher Instinkt dich dazu bewogen hat, mir soetwas zu erzählen. Aber ich bin froh, dass du jetzt die Wahrheit gesagt hast.",shape=box,color=blue];
		j1118639586 -> j3402145023;
	j3733340938 [label="Oh ... sowas brauchst du mir nicht zu erzählen, um mich kennenzulernen.",shape=box,color=blue];
		j3733340938 -> j3402145023;
	j1425141446 [label="Das ist das Produkt eines Menschen. Aber ich glaube, dass es Sol war, der unsere Wege zusammengeführt hat.",shape=box,color=blue];
		j1425141446 -> j2774533554;
	j2816296721 [label="Mir kommt es so vor, als ob du im Wald umherirrst und verzweifelt nach einem Pfad suchst, von dem du hoffst, er sei da.",shape=box,color=blue];
		j2816296721 -> j3874632346;
	j1465720927 [label="Den Pfad im Wald entlanggehen, einfach nur mit der Hoffnung im Herzen, den Weg zu weisen ?",shape=box,color=blue];
		j1465720927 -> j4062672346;
	j3164290240 [label="Das könnte eins sein, ich weiß es nicht. Vielleicht hat der Teufel recht, und alles ist ein Produkt von Wissenschaft, die wir noch nicht verstehen. Beides schließt sich ja nicht aus, non ?",shape=box,color=blue];
		j3164290240 -> j2774533554;
	j1283991882 [label="Es beleidigt mich in keiner Weise, und ich bin immer dankbar für deine Ehrlichkeit.",shape=box,color=blue];
		j1283991882 -> j2109688353;
	j2718912295 [label="+20 Chemistry",color=orange];
		j2718912295 -> j3199134152;
	j2004606596 [label="Was wolltest du wissen ? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		j2004606596 -> j2721345201;
		j2004606596 -> j129698615;
	j317087034 [label="Aber ich frage mich, ob du dich nicht an einem Scheideweg befindest und darüber nachdenken solltest, welchen Weg du einschlagen willst, non ?",shape=box,color=blue];
		j317087034 -> j4144399492;
	j3402145023 [label="Eine Seele ist mehr, als der Glaube, den sie trägt. Ich bin eine Sœur de Sol, aber ich hoffe du siehst in mir mehr als das, non ?",shape=box,color=blue];
		j3402145023 -> j120486452;
	j2774533554 [label="Deshalb glaube ich. Ich spüre Sol an meiner Seite, wenn ich an Orte komme, an denen ich am unsichersten bin. Ich schließe die Augen et il est là, um mich zu führen.",shape=box,color=blue];
		j2774533554 -> j2439198864;
		j2774533554 -> j1352055786;
		j2774533554 -> j3194965842;
	j3874632346 [label="Ich weiß nicht, ob du ihn jemals finden wirst, aber ich bete darum. Denn was du dort entdecken könntest, wäre un miracle. ",shape=box,color=blue];
		j3874632346 -> j2370799863;
	j4062672346 [label="Das ist wundervoll ...",shape=box,color=blue];
		j4062672346 -> j2370799863;
	j3199134152 [label="Sainte Mère Sol, vous avez béni votre fille aujourd'hui ! HA-HA !!",shape=box,color=blue];
		j3199134152 -> "Chat ends.";
	j4144399492 [label="Verpflichtung ist kein Grund gläubig zu sein. Sie nährt bestenfalls Zweifel, schlimmstenfalls aber hohle Verachtung.",shape=box,color=blue];
		j4144399492 -> j3328072895;
	j120486452 [label="Es gibt so viele Themen aus denen wir wählen können, wie Sterne am Himmel !",shape=box,color=blue];
		j120486452 -> j1006126461;
		j120486452 -> j1523894737;
	j2439198864 [label="Das ist wundervoll.",shape=box,color=red];
		j2439198864 -> j2425503397;
	j1352055786 [label="Hat er dich jemals im Stich gelassen?",shape=box,color=red];
		j1352055786 -> j817687359;
	j3194965842 [label="Ich wünschte, ich hätte das ...",shape=box,color=red];
		j3194965842 -> j2947449114;
	j3328072895 [label="Glaube sollte Balsam für die Seele sein. Keine Krücke und keine Ausrede.",shape=box,color=blue];
		j3328072895 -> j74134656;
	j1006126461 [label="Du verzeihst mir also?",shape=box,color=red];
		j1006126461 -> j4054943396;
	j1523894737 [label="Es tut mir leid. Das war dumm von mir.",shape=box,color=red];
		j1523894737 -> j3282458583;
	j2425503397 [label="Oui, und ich weiß, dass ich Glück habe. Und es ist ein Frieden, den man anderen zu gerne aufzwingen möchte, ob sie ihn nun wollen oder nicht.",shape=box,color=blue];
		j2425503397 -> j331822519;
	j817687359 [label="Oui, oft. Und dann frage ich mich, warum. Vielleicht soll ich einfach meinen eigenen Weg finden, non ? Ou peut-être que je suis une folle après tout, hah ! Wir sollen nicht immer alles wissen.",shape=box,color=blue];
		j817687359 -> j331822519;
	j2947449114 [label="Oui, und ich bete, dass du es eines Tages erlangen wirst. Aber es ist nichts, was man geben oder lehren kann, es ist etwas, das man finden muss.",shape=box,color=blue];
		j2947449114 -> j925820934;
	j74134656 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j74134656 -> j2370799863;
	j4054943396 [label="Oui, ich vergebe dir. Wärst du wie Lyon, würde ich dir sagen, dass deine Strafe zehn Peitschenhiebe sind.",shape=box,color=blue];
		j4054943396 -> j2875430438;
	j3282458583 [label="Oui und wärst du wie Lyon, würde ich dir sagen, dass deine Strafe zehn Peitschenhiebe sind ! Aber das bist du nicht und ich vergebe dir.",shape=box,color=blue];
		j3282458583 -> j2875430438;
	j331822519 [label="Solange ich aber niemandem mit meinen Überzeugungen schade, sehe ich keinen Schaden darin, sie zu vertreten, oui ?",shape=box,color=blue];
		j331822519 -> j29370536;
	j925820934 [label="Innerlich oder äußerlich, wo es sich befinden mag, ist für jeden anders.",shape=box,color=blue];
		j925820934 -> j29370536;
	j2875430438 [label="Boolean DrifterFaithBalance is now false.",color=orange];
		j2875430438 -> j955165242;
