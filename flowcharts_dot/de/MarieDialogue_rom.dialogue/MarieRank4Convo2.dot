	j186264682 [label="+5 Chemistry",color=orange];
		j186264682 -> j3648719684;
	j2304538395 [label="Du hast mir gesagt, dass du einen ähnlichen Glauben wie ich hast, non ? Warum bist du gläubig ?",shape=box,color=blue];
		j2304538395 -> j767696128;
