		j2304538395 -> j3091314036;
		j2304538395 -> j2504803174;
	j3873949881 [label="Du hast mir erzählt, du hast einen Glauben, der sich zwar von meinem unterscheidet, aber trotzdem Glaube ist. Warum bist du gläubig ?",shape=box,color=blue];
		j3873949881 -> j767696128;
		j3873949881 -> j1387548500;
		j3873949881 -> j232946136;
		j3873949881 -> j3091314036;
		j3873949881 -> j2504803174;
	j3215792664 [label="Ich weiß, du hast gesagt, dein Glaube sei etwas Persönliches, wie eine selbstgeschaffene Geschichte, aber es ist trotzdem Glaube. Warum bist du gläubig ?",shape=box,color=blue];
		j3215792664 -> j767696128;
