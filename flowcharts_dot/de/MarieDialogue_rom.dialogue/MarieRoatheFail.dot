	3751 [label="Ich versuche Roathe davon zu überzeugen, uns bei der Wiedervereinigung von Loid und der Familie Entrati zu helfen. Aber er ist stur über seine Einnahme des Serums. Ich brauche deine Hilfe, um mit ihm zu reden.",shape=box,color=red];
		3751 -> 3756;
	3752 [label="Ich versuche, Roathe klarzumachen, dass er die Kraft zur Veränderung hat. Dass er sich selbst vergeben kann für das, was er in der Vergangenheit getan hat. Und dafür brauche ich deine Hilfe.",shape=box,color=red];
		3752 -> 3757;
	3753 [label="Roathe quält sich innerlich mit dem, was er getan hat. Und ohne deine Hilfe befürchte ich, dass er sich weiterhin selbst zerstören wird, wenn er nicht mit seiner Identität ins Reine kommt.",shape=box,color=red];
		3753 -> 3758;
	3754 [label="Roathe hat die Wahrheit über das Serum erfahren. Dass er es freiwillig genommen hat. Und es zerstört ihn. Ich brauche deine Hilfe, um ihn zu beruhigen.",shape=box,color=red];
		3754 -> 3759;
	3755 [label="Roathe macht mich wahnsinnig. Ich weiß nicht, wie ich mit ihm reden soll. Hast du einen Rat?",shape=box,color=red];
		3755 -> 3759;
	3756 [label="Non, wenn ich gut darin wäre, mit diesem Teufel zu sprechen, glaubst du, ich würde ihn ständig in Gaullique anschreien?",shape=box,color=blue];
