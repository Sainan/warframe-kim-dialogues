		j4259657855 -> "Chat ends." [label=false,color=brown];
	j148501058 [label="Evaluate expressions",color=orange];
		j148501058 -> j3485591904 [label="MarieFamily3a",color=purple];
		j148501058 -> j1234282405 [label="MarieFamily3a",color=purple];
		j148501058 -> j861071072 [label="MarieFamily3b",color=purple];
		j148501058 -> j3737502349 [label="MarieFamily3b",color=purple];
		j148501058 -> j3485591904 [label="MarieFamilyOther",color=purple];
		j148501058 -> j1234282405 [label="MarieFamilyOther",color=purple];
		j148501058 -> j3646059626 [label="false",color=purple];
	j3485591904 [label="Ich habe darüber nachgedacht, wie ich Loid überzeugen kann, diese Stufen hinaufzugehen und endlich mit der Familie zu sprechen und... ich habe eine Idee, aber ich glaube, sie wird dir nicht gefallen.",shape=box,color=red];
		j3485591904 -> j3431982611;
	j1234282405 [label="Hast du nochmal darüber nachgedacht, wie wir Loid dazu bringen, oben mit der Entrati Familie zu sprechen?",shape=box,color=red];
		j1234282405 -> j2607534784;
	j861071072 [label="Was den Versuch angeht, Loid und die Entrati Familie zum Gespräch zu bewegen, ich habe mich gefragt ... ob du Roathes Rolle nochmal überdacht hast?",shape=box,color=red];
		j861071072 -> j1903226774;
	j3737502349 [label="Marie, ist es dir immer noch recht, dass... wir Loid vielleicht überzeugen, mit den \"Nachbarn von oben\" zu sprechen? Ich weiß, dass wir das etwas seltsam beendet haben.",shape=box,color=red];
		j3737502349 -> j1903226774;
	j3646059626 [label="Ich habe darüber nachgedacht, warum Monsieur Loid solche Angst hat, mit le Cardinals Familie zu sprechen.",shape=box,color=blue];
		j3646059626 -> j270262971;
	j3431982611 [label="Check boolean MarieDating",color=orange];
		j3431982611 -> j2890392165 [label=true,color=green];
		j3431982611 -> j2747551527 [label=false,color=brown];
	j2607534784 [label="Check boolean MarieDating",color=orange];
		j2607534784 -> j656883304 [label=true,color=green];
		j2607534784 -> j656883304 [label=false,color=brown];
	j1903226774 [label="Check boolean MarieDating",color=orange];
		j1903226774 -> j1220231814 [label=true,color=green];
		j1903226774 -> j570915031 [label=false,color=brown];
	j270262971 [label="Und wie wir diesen Stillstand überwinden müssen. Dieses purgatoire, in dem wir gefangen sind, darf nicht bestehen bleiben. Es erscheint so unnötig schmerzhaft.",shape=box,color=blue];
		j270262971 -> j1873782416;
	j2890392165 [label="Bonjour, mon cœur ! Und was glaubst du, wird mir nicht gefallen ?",shape=box,color=blue];
		j2890392165 -> j1777132046;
	j2747551527 [label="Bonjour ! Oh ? Und was glaubst du, wird mir nicht gefallen ?",shape=box,color=blue];
		j2747551527 -> j1777132046;
	j656883304 [label="Bonjour, mon cœur ! Ich habe noch mal darüber nachgedacht, oui ... und ich hasse wirklich, es zuzugeben. Es macht mir keine Freude, das zu sagen.",shape=box,color=blue];
		j656883304 -> j1984406971;
	j1220231814 [label="Bonjour, bonjour, mon cœur ! Ich habe noch mal darüber nachgedacht, oui ... und ich hasse wirklich, es zuzugeben. Es macht mir keine Freude, das zu sagen.",shape=box,color=blue];
		j1220231814 -> j428313390;
	j570915031 [label="Bonjour - ich habe noch mal darüber nachgedacht, oui ... und ich hasse wirklich, es zuzugeben. Es macht mir keine Freude, das zu sagen.",shape=box,color=blue];
		j570915031 -> j428313390;
	j1873782416 [label="Aber ich habe das Gefühl, wir brauchen... eine Art Schutzwall, non ? Hast du irgendwelche Ideen ?",shape=box,color=blue];
		j1873782416 -> j912049817;
		j1873782416 -> j1777132046;
	j1777132046 [label="Ich glaube, wir brauchen Roathes Hilfe, um Loid zu überzeugen, mit der Entrati Familie zu sprechen. Sonst wird er es kaum tun. Jedenfalls ohne Zusicherung, dass die Familie und er selbst, geschützt werden.",shape=box,color=red];
		j1777132046 -> j2525522284;
	j1984406971 [label="Aber ich denke... ich denke - oh Sol hilf mir - dass die Hilfe des Teufel wirklich nötig ist. Ich glaube nicht, dass Monsieur Lois sonst auf uns hören wird.",shape=box,color=blue];
		j1984406971 -> j2634052170;
	j428313390 [label="Ich glaube, du könntest recht haben. Der Teufel könnte das fehlende Puzzleteil sein. Ah, es schmerzt mich schon, dies überhaupt zu schreiben !",shape=box,color=blue];
		j428313390 -> j636489540;
	j912049817 [label="Ich habe kaum gute Ideen, die nicht die Hilfe von fragwürdigen Quellen erfordern. Quellen, die uns später in noch größere Schwierigkeiten bringen könnten. Wie z. B. Roathe.",shape=box,color=red];
		j912049817 -> j2439076109;
	j2525522284 [label="Ich... gebe es nicht gerne zu, aber ich glaube, du könntest recht haben... Sol vergib mir.",shape=box,color=blue];
		j2525522284 -> j636489540;
	j2634052170 [label="Der Teufel ist mächtig und verspricht eine gewisse Stärke, falls etwas schief gehen sollte, non ?",shape=box,color=blue];
		j2634052170 -> j2120268852;
		j2634052170 -> j835410318;
	j636489540 [label="Evaluate expressions",color=orange];
		j636489540 -> j2792767885 [label="RoatheFamilyFail",color=purple];
		j636489540 -> j4251234139 [label="RoatheRedeemed, RoatheFamilyDelay
",color=purple];
		j636489540 -> j4251234139 [label="RoatheRedeemed, RoatheFamilySuccess
",color=purple];
		j636489540 -> j4140508334 [label="RoatheVillain, RoatheFamilyDelay
",color=purple];
		j636489540 -> j4140508334 [label="RoatheVillain, RoatheFamilySuccess",color=purple];
		j636489540 -> j3735755111 [label="false",color=purple];
	j2439076109 [label="Bist du sicher ? Wenn ich meine différences mit dem Teufel beiseitelegen kann, dann du sicher auch auch, non ?",shape=box,color=blue];
		j2439076109 -> j3340493498;
		j2439076109 -> j2423989149;
	j2120268852 [label="Nein, es muss einen anderen Weg geben. Ich weigere mich, ihn hierfür um Hilfe zu bitten.",shape=box,color=red];
		j2120268852 -> j2439076109;
	j835410318 [label="Du hast recht. Ich hätte nicht gedacht, dass du zustimmen würdest. Daher hatte ich Angst zu fragen.",shape=box,color=red];
		j835410318 -> j636489540;
	j2792767885 [label="Aber wird er uns in dieser Sache helfen ?",shape=box,color=blue];
		j2792767885 -> j301394024;
	j4251234139 [label="Aber wird er uns in dieser Sache helfen ?",shape=box,color=blue];
		j4251234139 -> j448718110;
	j4140508334 [label="Aber wird er uns in dieser Sache helfen ?",shape=box,color=blue];
		j4140508334 -> j1539046943;
	j3735755111 [label="Meinst du denn, du könntest ihn dazu überreden, uns zu helfen ?",shape=box,color=blue];
		j3735755111 -> j2031330592;
		j3735755111 -> j1636892508;
	j3340493498 [label="Nein, tut mir leid.",shape=box,color=red];
		j3340493498 -> j1836471948;
	j2423989149 [label="In Ordnung. Wenn es dir recht ist, dann komme ich auch damit zurecht.",shape=box,color=red];
		j2423989149 -> j3934855442;
	j301394024 [label="Leider nein... ich denke, bei ihm für das in eine Sackgasse. Meinst du, es gibt einen anderen Weg?",shape=box,color=red];
		j301394024 -> j308973658;
	j448718110 [label="Das wird er. Ich habe ihn überzeugt, uns dabei zu helfen, sie zu vereinigen, damit er die Entrati Familie schützen kann. Immerhin sind sie alles, was noch von den Orokin über ist.",shape=box,color=red];
		j448718110 -> j1435086981;
	j1539046943 [label="Das wird er. Ich habe ihn überzeugt, uns dabei zu helfen, sie zu vereinigen und, was dich nicht überraschen wird, das überwiegend, um Albrecht in seiner Abwesenheit eins auszuwischen.",shape=box,color=red];
		j1539046943 -> j4105267552;
	j2031330592 [label="Noch ist nichts entschieden. Er ist ... naja, du weißt, wie er sein kann.",shape=box,color=red];
		j2031330592 -> j2913252443;
	j1636892508 [label="Ich arbeite noch daran, aber ich denke schon.",shape=box,color=red];
		j1636892508 -> j1104176810;
	j1836471948 [label="+20 Chemistry",color=orange];
		j1836471948 -> j2868576021;
	j3934855442 [label="Oui, es  muss mir nicht gefallen, aber es ist un médicament, das wir schlucken müssen, nehme ich an.",shape=box,color=blue];
		j3934855442 -> j636489540;
	j308973658 [label="Oh ! Das ist ... bedauerlich. Ich weiß nicht ! Ich glaube kaum ... Fällt dir ein anderer Weg ein, mit dem Teufel umzugehen ? Oder ein neuer Ansatz ?",shape=box,color=blue];
		j308973658 -> j3702260366;
	j1435086981 [label="Er hilft uns, die Familie des Mannes zu schützen, der ihn, gegen seinen Willen, in einen Protoframe verwandelt, ihn in die Vergangenheit verbannt und dann auch noch seine Erinnerungen gestohlen hat...",shape=box,color=blue];
		j1435086981 -> j3481687616;
	j4105267552 [label="Du hast recht... es überrascht mich nicht.",shape=box,color=blue];
		j4105267552 -> j1829152002;
		j4105267552 -> j983220469;
	j2913252443 [label="Check boolean RoatheDating",color=orange];
		j2913252443 -> j2504328326 [label=true,color=green];
		j2913252443 -> j756032724 [label=false,color=brown];
	j1104176810 [label="Check boolean RoatheDating",color=orange];
		j1104176810 -> j1634701092 [label=true,color=green];
		j1104176810 -> j290827839 [label=false,color=brown];
	j2868576021 [label="Dann unterstütze ich deine Entscheidung auch.",shape=box,color=blue];
		j2868576021 -> j1179567760;
	j3702260366 [label="In der Zwischenzeit werde ich mit Lyon sprechen, aber ich habe nicht viel Hoffnung.",shape=box,color=blue];
		j3702260366 -> j3598075256;
	j3481687616 [label="+20 Chemistry",color=orange];
		j3481687616 -> j1177294023;
	j1829152002 [label="Immerhin hilft er wenigstens. Und ich stelle sicher, dass er seine Drohungen nicht tatsächlich wahr macht.",shape=box,color=red];
		j1829152002 -> j2185628068;
	j983220469 [label="Das ist wohl nur die Ausrede, die er als Vorwand benutzt.",shape=box,color=red];
		j983220469 -> j4238151487;
	j2504328326 [label="Oui, ich weiß. Aber ich glaube, du hast eine besondere Art ihn zu überzeugen, wenn alle anderen scheitern, non ?",shape=box,color=blue];
		j2504328326 -> j331995883;
		j2504328326 -> j2726263314;
	j756032724 [label="Oui, natürlich weiß ich das. Selbst in besten Zeiten ist der Teufel stur. Manchmal denke ich, er genießt es einfach widerspenstig zu sein !",shape=box,color=blue];
		j756032724 -> j708291485;
		j756032724 -> j3746452626;
	j1634701092 [label="Aber ich glaube, du hast eine besondere Art ihn zu überzeugen, wenn alle anderen scheitern, non ?",shape=box,color=blue];
		j1634701092 -> j331995883;
		j1634701092 -> j2726263314;
	j290827839 [label="Ich wünsche dir viel Glück. Selbst in besten Zeiten ist der Teufel stur. Manchmal denke ich, er genießt es einfach widerspenstig zu sein !",shape=box,color=blue];
		j290827839 -> j708291485;
		j290827839 -> j3746452626;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j3598075256 [label="+20 Chemistry",color=orange];
		j3598075256 -> j467512297;
	j1177294023 [label="Ich habe unseren Teufel völlig falsch eingeschätzt...",shape=box,color=blue];
		j1177294023 -> j416983808;
	j2185628068 [label="Oui. Immerhin bist du da, um sicherzustellen, dass er seine Drohungen nicht wirklich wahr macht... niedere Instinkte.",shape=box,color=blue];
		j2185628068 -> j2198758823;
	j4238151487 [label="Oui, ich hoffe, du hast recht.",shape=box,color=blue];
		j4238151487 -> j2198758823;
	j331995883 [label="Ich möchte meine Beziehung zu ihm nicht als Werkzeug für Verhandlungen nutzen.",shape=box,color=red];
		j331995883 -> j70456628;
	j2726263314 [label="Was willst du damit andeuten, Marie?",shape=box,color=red];
		j2726263314 -> j972343999;
	j708291485 [label="Ich genieße es sogar irgendwie. so komisch das auch klingt. Wir verstehen einander.",shape=box,color=red];
		j708291485 -> j2114323775;
	j3746452626 [label="Das kann er sein, aber ich glaube vieles davon ist nur Show.",shape=box,color=red];
		j3746452626 -> j1056018417;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j467512297 [label="Der Teufel ist launisch ! C'est la vie, wie man sagt !",shape=box,color=blue];
		j467512297 -> j3569999725;
	j416983808 [label="Und ich bin nicht so dumm, dass ich nicht erkennen kann, welche Rolle du darin gespielt hat, dass alles so zustande kam !",shape=box,color=blue];
		j416983808 -> j3242583483;
	j2198758823 [label="Check boolean MarieDating",color=orange];
		j2198758823 -> j3221803947 [label=true,color=green];
		j2198758823 -> j32902783 [label=false,color=brown];
	j70456628 [label="Oh ! Das wollte ich damit nicht unterstellen, pardonne-moi ! Nur, dass er dich zu bevorzugen scheint. Ich glaube er würde dir zuhören, wo er alle anderen ignoriert.",shape=box,color=blue];
		j70456628 -> j2935956861;
	j972343999 [label="+5 Chemistry",color=orange];
		j972343999 -> j519304760;
	j2114323775 [label="Oui, er scheint dich in der Tat zu bevorzugen. Vielleicht, weil ihr euch eine Zeit und einen Ort teilt, wir aber nicht ? Warum sonst ?",shape=box,color=blue];
		j2114323775 -> j3822691405;
	j1056018417 [label="Oui ? Was meinst du damit ?",shape=box,color=blue];
		j1056018417 -> j3822691405;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j3242583483 [label="Check boolean MarieDating",color=orange];
		j3242583483 -> j3195129815 [label=true,color=green];
		j3242583483 -> j3346606997 [label=false,color=brown];
	j3221803947 [label="+10 Chemistry",color=orange];
		j3221803947 -> j3350878610;
	j32902783 [label="+10 Chemistry",color=orange];
		j32902783 -> j2132075148;
	j2935956861 [label="+5 Chemistry",color=orange];
		j2935956861 -> j503537681;
	j519304760 [label="Ich weiß nicht, was du meinst ! Ich will gar nichts andeuten. Ich bin nur une innocente Sœur de Sol.",shape=box,color=blue];
		j519304760 -> j2459992778;
	j3822691405 [label="Evaluate expressions",color=orange];
		j3822691405 -> j4024253050 [label="RoatheVillain",color=purple];
		j3822691405 -> j802635489 [label="RoatheRedeemed",color=purple];
		j3822691405 -> j268481043 [label="RoatheUnloved3",color=purple];
		j3822691405 -> j2156686771 [label="RoatheTraitor2",color=purple];
		j3822691405 -> j2196378877 [label="RoatheExecutor2",color=purple];
		j3822691405 -> j704926226 [label="false",color=purple];
	j3195129815 [label="Merci, merci, merci, mon cœur !",shape=box,color=blue];
		j3195129815 -> j3394948141;
	j3346606997 [label="Merci, merci, merci !",shape=box,color=blue];
		j3346606997 -> j3394948141;
	j3350878610 [label="Nun ! Wenn es soweit ist, werde ich bereit sein und warten ! Bis dahin, merci, mon cœur.",shape=box,color=blue];
		j3350878610 -> j3569999725;
	j2132075148 [label="Nun ! Wenn es soweit ist, werde ich bereit sein und warten ! Bis dahin, merci.",shape=box,color=blue];
		j2132075148 -> j3569999725;
	j503537681 [label="Ich bin einfach glücklich, dass du glücklich bist. Und wenn der Teufel etwas hat, worauf er seine... Mühen verwenden kann... um so besser, non ?",shape=box,color=blue];
		j503537681 -> j4273382071;
	j2459992778 [label="Ich würde niemals andeuten, dass nur, weil der Teufel dich bevorzugt, er vielleicht auf dich hört, wo er alle anderen ignoriert.",shape=box,color=blue];
		j2459992778 -> j882862770;
	j4024253050 [label="Jeder in seinem Leben hat versucht, ihn als eine Art Monster hinzustellen. Ich nehme an, ich bin die erste Person, die das nicht getan hat.",shape=box,color=red];
		j4024253050 -> j3532400951;
	j802635489 [label="Es gibt vieles, was er einfach nicht zeigen kann. Es ist nicht direkt eine Rüstung - aber vertraut nicht darauf, dass Menschen ihn nicht verletzen werden.",shape=box,color=red];
		j802635489 -> j1489156514;
	j268481043 [label="Ihm ist ... in all den Jahren oft das Herz gebrochen worden. Es ist mit Dornen überkrustet, das ist alles.",shape=box,color=red];
		j268481043 -> j660296750;
	j2156686771 [label="Ich denke, ich kann seinen Lebensweg nachvollziehen. Ich habe genauso viel Tod gesehen, wie er.",shape=box,color=red];
		j2156686771 -> j3577095792;
	j2196378877 [label="Er hat immer nur versucht zu tun, was richtig war. Sicher, vielleicht auf die falsche Art, aber er hat versucht, das Ursprungssystem vor den Orokin zu retten.",shape=box,color=red];
		j2196378877 -> j326853630;
	j704926226 [label="Ich mag seinen trockenen Humor. Er ist clever, wenn man mal von seinem Ego absieht.",shape=box,color=red];
		j704926226 -> j1055967857;
	j3394948141 [label="Nun ! Wenn es soweit ist, werde ich bereit sein und warten ! Bis dahin !",shape=box,color=blue];
		j3394948141 -> j3569999725;
	j4273382071 [label="Erst recht für uns alle, wenn du eine Art ange auf seiner Schulter sein kannst, um ihn zu besänftigen.",shape=box,color=blue];
		j4273382071 -> j123302831;
		j4273382071 -> j822447449;
	j882862770 [label="Und niemals in privaten Momenten. Non. Jamais.",shape=box,color=blue];
		j882862770 -> j2218435296;
		j882862770 -> j2424392826;
	j3532400951 [label="Ich nehmen, in letzter Zeit stehe ich ganz oben auf dieser Liste, non ? Ich nehmen an, ich sollte... seine Gründe bedenken, warum er so ist, wie er ist. Verurteilung rettet keine Seelen.",shape=box,color=blue];
		j3532400951 -> j4273629468;
	j1489156514 [label="Es gibt immer einen Schmerz, den wir vor anderen verbergen. Manchmal brauchen wir Schutz, aus Angst, andere könnten ihn ausnutzen. Ich denke, ich sollte versuchen, netter zu ihm zu sein, wenn es wahr ist, was du sagst.",shape=box,color=blue];
		j1489156514 -> j4273629468;
	j660296750 [label="Ich kann mir kaum das Ausmaß an Liebe und Verlust in all diesen Jahren vorstellen. Es scheint so unwirklich, sogar nach allem, was ich gesehen habe.",shape=box,color=blue];
		j660296750 -> j4184688333;
	j3577095792 [label="Manchmal vergesse ich, wieviele Jahrhunderte er gelebt hat, wenn ich mit ihm spreche. Es ist so surreal, sogar angesichts dessen, was ich alles gesehen habe.",shape=box,color=blue];
		j3577095792 -> j1892185032;
	j326853630 [label="Es gibt immer... Nuancen, oui ? Gründe, warum man sich so oder so verhält. Ich denke, ich sollte versuchen, netter zu ihm zu sein, wenn es wahr ist, was du sagst.",shape=box,color=blue];
		j326853630 -> j4273629468;
	j1055967857 [label="Keiner hat je behauptet, der Teufel wäre nicht clever.",shape=box,color=blue];
		j1055967857 -> j2980685359;
	j123302831 [label="Wer sagt, ich versuche ihn zu besänftigen?",shape=box,color=red];
		j123302831 -> j233411399;
	j822447449 [label="Ich kann nichts versprechen.",shape=box,color=red];
		j822447449 -> j1830751604;
	j2218435296 [label="Ich wusste nicht, dass du so eine Seite hast.",shape=box,color=red];
		j2218435296 -> j2935956861;
	j2424392826 [label="Du überraschst mich. Ich bin beeindruckt.",shape=box,color=red];
		j2424392826 -> j2935956861;
	j4273629468 [label="+10 Chemistry",color=orange];
		j4273629468 -> j2607690008;
	j4184688333 [label="Oui, welchen Schaden das einer Seele zufügen könnte ? Ich verstehe, warum du jemanden suchst, der dich versteht. Und er dich.",shape=box,color=blue];
		j4184688333 -> j4273629468;
	j1892185032 [label="So lange gelebt zu haben, so viel Tod gesehen zu haben - und selbst soviel dafür gezahlt zu haben ?",shape=box,color=blue];
		j1892185032 -> j4184688333;
	j2980685359 [label="+5 Chemistry",color=orange];
		j2980685359 -> j2607690008;
