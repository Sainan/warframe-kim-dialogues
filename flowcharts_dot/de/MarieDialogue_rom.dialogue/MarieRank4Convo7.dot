digraph {
	1842 [label="MarieRank4Convo7 begins.",color=orange];
		1842 -> 1843;
	1843 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		1843 -> 1844 [label="x >= 0",color=purple];
		1843 -> 1845 [label="x <= 0",color=purple];
		1843 -> 1845 [label="false",color=purple];
	1844 [label="Drifter, excusez-moi ... Glaubst du im Ernst, es sei klug, dem Teufel zu helfen ?",shape=box,color=blue];
		1844 -> 1846;
	1845 [label="Chat ends.",color=orange];
	1846 [label="Ich möchte diejenigen, die um Vergebung oder Hilfe bitten, nicht abweisen, aber ... ich glaube, der Teufel will keins von beidem.",shape=box,color=blue];
		1846 -> 1847;
		1846 -> 1848;
		1846 -> 1849;
		1846 -> 1850;
	1847 [label="Und was glaubst du, was er wirklich will?",shape=box,color=red];
		1847 -> 1851;
	1848 [label="Ich weiß, dass ihr zwei euch nicht versteht, und das tut mir leid. Aber ich kann ihn ja schlecht rausschmeißen.",shape=box,color=red];
		1848 -> 1852;
	1849 [label="Roathe hat mehr über die Orokin vergessen – im wahrsten Sinne des Wortes –, als wir je wissen werden. Wir brauchen ihn.",shape=box,color=red];
		1849 -> 1853;
	1850 [label="[Ende.]",shape=box,color=red];
		1850 -> 1854;
	1851 [label="Er ist ein wildes Tier. Er kommt näher, wenn man ihm Futter und einen warmen Platz zum Schlafen anbietet, aber er wird sofort verschwinden, sobald man nicht mehr nützlich ist.",shape=box,color=blue];
		1851 -> 1855;
	1852 [label="Add 1 to Thermostat",color=orange];
		1852 -> 1856;
	1853 [label="Add -1 to Thermostat",color=orange];
		1853 -> 1851;
	1854 [label="Chat ends.",color=orange];
	1855 [label="Er braucht etwas von dir. Von uns.",shape=box,color=blue];
		1855 -> 1857;
	1856 [label="Non, das wollte ich damit nicht ausdrücken. Ich sage nur, dass man ihm ... nicht trauen kann. Weder jetzt noch jemals.",shape=box,color=blue];
		1856 -> 1851;
	1857 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		1857 -> 1859 [label="x > 5",color=purple];
		1857 -> 1858 [label="x <= 5",color=purple];
		1857 -> 1858 [label="false",color=purple];
	1859 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		1859 -> 1863 [label="x >= 21",color=purple];
		1859 -> 1862 [label="x < 21",color=purple];
		1859 -> 1862 [label="false",color=purple];
	1858 [label="Seine verlorenen Erinnerungen, diese vergangenen Schrecken von Tau ... Ich mache mir Sorgen darüber, was sie bedeuten.",shape=box,color=blue];
		1858 -> 1860;
		1858 -> 1861;
	1863 [label="Ich weiß, du denkst, wir hätten alles aufgedeckt, was es in seinem zerrütteten Geist zu wissen gibt.",shape=box,color=blue];
		1863 -> 1866;
		1863 -> 1861;
	1862 [label="Je mehr wir erfahren, je tiefer wir in seine zerrüttete Seele eindringen, desto beunruhigter werde ich. Je deutlicher die Gefahr wird.",shape=box,color=blue];
		1862 -> 1861;
		1862 -> 1860;
	1860 [label="Ich denke nicht, dass er einfach verschwindet, sobald er seine Erinnerungen zurück hat. Da steckt mehr dahinter.",shape=box,color=red];
		1860 -> 1864;
	1861 [label="Wahrscheinlich sucht er noch mehr. Nicht in seinen Erinnerungen, sondern bei uns.",shape=box,color=red];
		1861 -> 1865;
	1866 [label="Ich glaube ihm, wenn er sagt, dass wir dabei nichts weiter herausfinden werden. Und wenn dem so wäre, warum ist er dann noch hier?",shape=box,color=red];
		1866 -> 1864;
	1864 [label="Ich gebe zu, dass ich mir mehr Sorgen darüber mache, was er mit diesem Wissen vorhat, als über das Wissen selbst.",shape=box,color=blue];
		1864 -> 1867;
	1865 [label="Oui ! Genau das ist meine Sorge. Aber was könnte es sein ? Welchem Zweck dienen wir ihm jetzt ?",shape=box,color=blue];
		1865 -> 1867;
	1867 [label="Wie auch immer er seine neue Existenz nutzen will, ich fürchte, er will uns hineinziehen. Und ich will einfach, dass wir nicht blindlings der Hoffnung nachgehen, er sei irgendwie harmlos.",shape=box,color=blue];
		1867 -> 1868;
		1867 -> 1869;
		1867 -> 1870;
	1868 [label="Ich bin ganz deiner Meinung. Ich traue ihm nicht.",shape=box,color=red];
		1868 -> 1871;
	1869 [label="Er ist stark und hat Wissen. Jemand, den ich sehr gerne an meiner Seite haben würde.",shape=box,color=red];
		1869 -> 1872;
	1870 [label="Es bringt nichts, sich zu fragen, ob er uns verraten wird – das hat er nicht. Und ich bezichtige niemanden der Sünden, die noch nicht begangen wurden.",shape=box,color=red];
		1870 -> 1873;
	1871 [label="+20 Chemistry",color=orange];
		1871 -> 1874;
	1872 [label="Add -1 to Thermostat",color=orange];
		1872 -> 1875;
	1873 [label="Add 1 to Thermostat",color=orange];
		1873 -> 1876;
	1874 [label="Bien ! Zumindest bin ich beruhigt, da ich weiß, dass noch andere Augen diesen Teufel im Auge behalten. Das könnte mir beim Einschlafen helfen. Merci.",shape=box,color=blue];
		1874 -> 1877;
	1875 [label="Oui, aber ich frage mich, was der wahre Preis dieser Allianz am Ende sein wird. Vielleicht wirst du es bereuen.",shape=box,color=blue];
		1875 -> 1878;
	1876 [label="Oui ... ich denke, du hast recht. Wir dürfen nicht vor jedem Schatten zurückschrecken. Wir müssen Seite an Seite mit all jenen stehen, die die Gleichgültigkeit besiegen wollen.",shape=box,color=blue];
		1876 -> 1879;
	1877 [label="Update boolean MarieRoatheNoTrust",color=orange];
		1877 -> 1880;
	1878 [label="Ich möchte dir nur raten, vorsichtig zu sein ... er ist ein Monster im Gewand eines Gentlemans. Sei vorsichtig mit ihm, s'il te plaît ?",shape=box,color=blue];
		1878 -> 1881;
		1878 -> 1882;
	1879 [label="Check boolean DrifterFaithNoMITW",color=orange];
		1879 -> 1883 [label=true,color=green];
		1879 -> 1884 [label=false,color=brown];
	1880 [label="Chat ends.",color=orange];
	1881 [label="Ich finde, du bist ihm gegenüber etwas unfair.",shape=box,color=red];
		1881 -> 1885;
	1882 [label="Ich werde vorsichtig sein. Versprochen.",shape=box,color=red];
		1882 -> 1886;
	1883 [label="Selbst wenn man glaubt, dass die dahinterstehende Kraft nicht von einem Gott, sondern aus unserem eigenen Geist stammt, stellt sie dennoch eine Bedrohung dar.",shape=box,color=blue];
		1883 -> 1878;
	1884 [label="Selbst wenn er glaubt, dass die dahinterstehende Kraft nicht von einem Gott, sondern aus unserem eigenen Geist stammt, stellt sie dennoch eine Bedrohung dar.",shape=box,color=blue];
		1884 -> 1878;
	1885 [label="Add -1 to Thermostat",color=orange];
		1885 -> 1887;
	1886 [label="+20 Chemistry",color=orange];
		1886 -> 1888;
	1887 [label="Oui ? Wieso ? Das meine ich nicht boshaft, ich bin wirklich neugierig.",shape=box,color=blue];
		1887 -> 1889;
		1887 -> 1890;
		1887 -> 1891;
		1887 -> 1892;
	1888 [label="Merci. Das ist alles, wwas ich möchte.",shape=box,color=blue];
		1888 -> 1893;
	1889 [label="Er wuchs in einer anderen Gesellschaft, in einer anderen Zeit auf – mit anderen Erwartungen. Das mag uns nicht gefallen, aber er ist, wie er ist.",shape=box,color=red];
		1889 -> 1894;
	1890 [label="Du und Lyon habt das Protoframe-Serum von Entrati angenommen. Freiwillig. Er nicht. Kannst du dir vorstellen, wie das ist?",shape=box,color=red];
		1890 -> 1895;
		1890 -> 1896;
		1890 -> 1894;
	1891 [label="Er verbrachte ganze Jahrhunderte seines Lebens damit, zu tun, was er für notwendig hielt. Wir sind uns nur uneinig darüber, was das genau ist.",shape=box,color=red];
		1891 -> 1895;
		1891 -> 1897;
	1892 [label="Ich glaube, es ist eher sein Auftreten, das dich so aufregt. Nicht seine Taten.",shape=box,color=red];
		1892 -> 1897;
		1892 -> 1895;
	1893 [label="Chat ends.",color=orange];
	1894 [label="Er ist ein hochrangiger Soldat und ein Lebemann. Und beides erfordert manchmal, dass man zweifelhafte Entscheidungen trifft.",shape=box,color=red];
		1894 -> 1898;
	1895 [label="Ich glaube, dass jemand etwas in guter Absicht tun kann, was wir dennoch als \"falsch\" empfinden.",shape=box,color=red];
		1895 -> 1899;
	1896 [label="Er tat all das, um das Imperium der Orokin zu retten – und sein Dank dafür war, gegen seinen Willen in dieses Schlamassel hineingezogen zu werden.",shape=box,color=red];
		1896 -> 1898;
	1897 [label="Ich glaube, er stößt dir sauer auf, weil er stolz auf das ist, was er erreicht hat.",shape=box,color=red];
		1897 -> 1900;
	1898 [label="Check boolean MarieGrineer",color=orange];
		1898 -> 1902 [label=true,color=green];
		1898 -> 1901 [label=false,color=brown];
	1899 [label="Du hältst ihn für den Teufel, aber in seinen Augen ist die Wahrheit weit davon entfernt.",shape=box,color=red];
		1899 -> 1898;
	1900 [label="Oui, ich habe kein Verständnis für diejenigen, die sich am Tod ergötzen. Und seine Gier, Blut zu vergießen, ist erschreckend. Und die Tatsache, dass dich das nicht beunruhigt, ebenso.",shape=box,color=blue];
		1900 -> 1903;
	1902 [label="Und ich denke, diejenigen, die die \"Corpus\" oder \"Grineer\" befehligen, gegen die du kämpfst, würden dasselbe sagen. Sie glauben nicht, dass sie im Unrecht sind.",shape=box,color=blue];
		1902 -> 1904;
	1901 [label="Und ich denke, diejenigen, die die \"Corpus\" oder \"Grin-ire\" befehligen, gegen die du kämpfst, würden dasselbe sagen. Sie glauben nicht, dass sie im Unrecht sind.",shape=box,color=blue];
		1901 -> 1904;
	1903 [label="Es ist allzu einfach, den Weg der Selbstverleugnung auf die Sünde der Gewalt anzuwenden, den Schrecken davon abzulehnen, zu sagen, es sei bedeutungslos im Namen dessen, \"was zählt\".",shape=box,color=blue];
		1903 -> 1905;
	1904 [label="Sie glauben, ihre Handlungen seien gerecht, gut und notwendig. Wie kann man das eine Übel gutheißen, das andere aber nicht ?",shape=box,color=blue];
		1904 -> 1906;
		1904 -> 1907;
		1904 -> 1908;
		1904 -> 1909;
	1905 [label="Stolz auf die Tat selbst zu sein ... das geht mir zu weit. Ich freue mich nicht, wenn ich ein Leben nehmen muss, aber er schon. Insofern ? Sind wir da grundverschieden.",shape=box,color=blue];
		1905 -> 1910;
	1906 [label="Ich werde versuchen, sie aufzuhalten, wenn sie Dinge tun, mit denen ich nicht einverstanden bin. Aber ... ich werde an ihrer Seite kämpfen, wenn es nötig ist.",shape=box,color=red];
		1906 -> 1911;
	1907 [label="Ich glaube nicht, dass diese Gruppen per Definition \"gut\" oder \"böse\" sind. Nur allein die Handlungen, die sie begehen.",shape=box,color=red];
		1907 -> 1912;
	1908 [label="Es steht mir nicht zu, zu bestimmen, welche Handlungen \"gut\" und welche \"schlecht\" sind. Ich tue, was ich tue, um diejenigen zu schützen, die Schutz benötigen.",shape=box,color=red];
		1908 -> 1911;
	1909 [label="Du erwartest von mir, eine ganze Gruppe nach denselben Kriterien zu beurteilen, nach denen ich auch ein einzelnes Individuum beurteilen würde.",shape=box,color=red];
		1909 -> 1912;
	1910 [label="Ich kann nur beten, dass es nicht zu spät ist, falls der Teufel beschließt, dir sein Messer in die Rippen zu stoßen. Ich will nicht, dass deine letzten Gedanken lauten: \"Marie hat mich gewarnt.\"",shape=box,color=blue];
		1910 -> 1913;
		1910 -> 1914;
	1911 [label="Und du glaubst, der Teufel sei keine Bedrohung ? Dass er für diejenigen um ihn keine Gefahr darstellt ? Er kann großen Schaden anrichten.",shape=box,color=blue];
		1911 -> 1915;
		1911 -> 1916;
	1912 [label="Und was ist mit den schrecklichen Taten, die er begangen hat ? All dem Tod, all dem Gemetzel ? War das in deinen Augen gerechtfertigt ?",shape=box,color=blue];
		1912 -> 1916;
	1913 [label="Das wird er nicht. Und versucht er es, werde ich ihn daran hindern.",shape=box,color=red];
		1913 -> 1917;
	1914 [label="Ich verspreche, das werden nicht meine letzten Gedanken sein.",shape=box,color=red];
		1914 -> 1918;
	1915 [label="Sollte er sich jemals gegen uns wenden, werde ich handeln. Bisher hat er sich als ein Verbündeter erwiesen. Wenn auch ... etwas melodramatisch.",shape=box,color=red];
		1915 -> 1919;
	1916 [label="Ich sehe seine Gefährlichkeit nicht als Problem. Er ist eine Waffe. Und Waffen können zum Morden oder zum Schutz eingesetzt werden.",shape=box,color=red];
		1916 -> 1920;
	1917 [label="Ich bewundere dich für dein Selbstvertrauen, auch wenn ich bedauere, dass du ihm traust. Also werde ich wohl im Gegenzug dir vetrauen.",shape=box,color=blue];
		1917 -> 1921;
	1918 [label="Ich glaube, du meinst diese Worte nicht so, wie ich es mir wünsche, aber ich will nicht zu viel hineininterpretieren.",shape=box,color=blue];
		1918 -> 1921;
	1919 [label="Add 1 to Thermostat",color=orange];
		1919 -> 1910;
	1920 [label="Add -1 to Thermostat",color=orange];
		1920 -> 1910;
	1921 [label="Ich muss gehen. Aber nochmals, ich bitte dich inständig – sei vorsichtig. Um meinetwillen, wenn nicht um deinetwillen, d'accord ?",shape=box,color=blue];
		1921 -> 1922;
	1922 [label="+20 Chemistry",color=orange];
		1922 -> 1923;
	1923 [label="Chat ends.",color=orange];
}