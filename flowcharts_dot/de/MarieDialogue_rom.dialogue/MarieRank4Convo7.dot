digraph {
	"MarieRank4Convo7 begins." [color=orange];
		"MarieRank4Convo7 begins." -> j3255816954;
	j3255816954 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j3255816954 -> j99939289 [label="x >= 0",color=purple];
		j3255816954 -> "Chat ends." [label="x <= 0",color=purple];
		j3255816954 -> "Chat ends." [label="false",color=purple];
	j99939289 [label="Drifter, excusez-moi ... Glaubst du im Ernst, es sei klug, dem Teufel zu helfen ?",shape=box,color=blue];
		j99939289 -> j3094705502;
	"Chat ends." [color=orange];
	j3094705502 [label="Ich möchte diejenigen, die um Vergebung oder Hilfe bitten, nicht abweisen, aber ... ich glaube, der Teufel will keins von beidem.",shape=box,color=blue];
		j3094705502 -> j2974269296;
		j3094705502 -> j234596728;
		j3094705502 -> j928925634;
		j3094705502 -> j129698615;
	j2974269296 [label="Und was glaubst du, was er wirklich will?",shape=box,color=red];
		j2974269296 -> j839777900;
	j234596728 [label="Ich weiß, dass ihr zwei euch nicht versteht, und das tut mir leid. Aber ich kann ihn ja schlecht rausschmeißen.",shape=box,color=red];
		j234596728 -> j1707358737;
	j928925634 [label="Roathe hat mehr über die Orokin vergessen – im wahrsten Sinne des Wortes –, als wir je wissen werden. Wir brauchen ihn.",shape=box,color=red];
		j928925634 -> j2750970570;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j839777900 [label="Er ist ein wildes Tier. Er kommt näher, wenn man ihm Futter und einen warmen Platz zum Schlafen anbietet, aber er wird sofort verschwinden, sobald man nicht mehr nützlich ist.",shape=box,color=blue];
		j839777900 -> j1439608305;
	j1707358737 [label="Add 1 to Thermostat counter",color=orange];
		j1707358737 -> j2942850548;
	j2750970570 [label="Add -1 to Thermostat counter",color=orange];
		j2750970570 -> j839777900;
	j1439608305 [label="Er braucht etwas von dir. Von uns.",shape=box,color=blue];
		j1439608305 -> j863296879;
	j2942850548 [label="Non, das wollte ich damit nicht ausdrücken. Ich sage nur, dass man ihm ... nicht trauen kann. Weder jetzt noch jemals.",shape=box,color=blue];
		j2942850548 -> j839777900;
	j863296879 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j863296879 -> j4093421340 [label="x > 5",color=purple];
		j863296879 -> j116910763 [label="x <= 5",color=purple];
		j863296879 -> j116910763 [label="false",color=purple];
	j4093421340 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4093421340 -> j3483281397 [label="x >= 21",color=purple];
		j4093421340 -> j3408423378 [label="x < 21",color=purple];
		j4093421340 -> j3408423378 [label="false",color=purple];
	j116910763 [label="Seine verlorenen Erinnerungen, diese vergangenen Schrecken von Tau ... Ich mache mir Sorgen darüber, was sie bedeuten.",shape=box,color=blue];
		j116910763 -> j2986001169;
		j116910763 -> j3458866846;
	j3483281397 [label="Ich weiß, du denkst, wir hätten alles aufgedeckt, was es in seinem zerrütteten Geist zu wissen gibt.",shape=box,color=blue];
		j3483281397 -> j4080230382;
		j3483281397 -> j3458866846;
	j3408423378 [label="Je mehr wir erfahren, je tiefer wir in seine zerrüttete Seele eindringen, desto beunruhigter werde ich. Je deutlicher die Gefahr wird.",shape=box,color=blue];
		j3408423378 -> j3458866846;
		j3408423378 -> j2986001169;
	j2986001169 [label="Ich denke nicht, dass er einfach verschwindet, sobald er seine Erinnerungen zurück hat. Da steckt mehr dahinter.",shape=box,color=red];
		j2986001169 -> j3233544897;
	j3458866846 [label="Wahrscheinlich sucht er noch mehr. Nicht in seinen Erinnerungen, sondern bei uns.",shape=box,color=red];
		j3458866846 -> j576874225;
	j4080230382 [label="Ich glaube ihm, wenn er sagt, dass wir dabei nichts weiter herausfinden werden. Und wenn dem so wäre, warum ist er dann noch hier?",shape=box,color=red];
		j4080230382 -> j3233544897;
	j3233544897 [label="Ich gebe zu, dass ich mir mehr Sorgen darüber mache, was er mit diesem Wissen vorhat, als über das Wissen selbst.",shape=box,color=blue];
		j3233544897 -> j326146572;
	j576874225 [label="Oui ! Genau das ist meine Sorge. Aber was könnte es sein ? Welchem Zweck dienen wir ihm jetzt ?",shape=box,color=blue];
		j576874225 -> j326146572;
	j326146572 [label="Wie auch immer er seine neue Existenz nutzen will, ich fürchte, er will uns hineinziehen. Und ich will einfach, dass wir nicht blindlings der Hoffnung nachgehen, er sei irgendwie harmlos.",shape=box,color=blue];
		j326146572 -> j3263032263;
		j326146572 -> j2116745513;
		j326146572 -> j3148708956;
	j3263032263 [label="Ich bin ganz deiner Meinung. Ich traue ihm nicht.",shape=box,color=red];
		j3263032263 -> j2003582259;
	j2116745513 [label="Er ist stark und hat Wissen. Jemand, den ich sehr gerne an meiner Seite haben würde.",shape=box,color=red];
		j2116745513 -> j3896016697;
	j3148708956 [label="Es bringt nichts, sich zu fragen, ob er uns verraten wird – das hat er nicht. Und ich bezichtige niemanden der Sünden, die noch nicht begangen wurden.",shape=box,color=red];
		j3148708956 -> j749307507;
	j2003582259 [label="+20 Chemistry",color=orange];
		j2003582259 -> j3219454149;
	j3896016697 [label="Add -1 to Thermostat counter",color=orange];
		j3896016697 -> j941932204;
	j749307507 [label="Add 1 to Thermostat counter",color=orange];
		j749307507 -> j1707733702;
	j3219454149 [label="Bien ! Zumindest bin ich beruhigt, da ich weiß, dass noch andere Augen diesen Teufel im Auge behalten. Das könnte mir beim Einschlafen helfen. Merci.",shape=box,color=blue];
		j3219454149 -> j3984234322;
	j941932204 [label="Oui, aber ich frage mich, was der wahre Preis dieser Allianz am Ende sein wird. Vielleicht wirst du es bereuen.",shape=box,color=blue];
		j941932204 -> j2786145705;
	j1707733702 [label="Oui ... ich denke, du hast recht. Wir dürfen nicht vor jedem Schatten zurückschrecken. Wir müssen Seite an Seite mit all jenen stehen, die die Gleichgültigkeit besiegen wollen.",shape=box,color=blue];
		j1707733702 -> j808986917;
	j3984234322 [label="Boolean MarieRoatheNoTrust is now true.",color=orange];
		j3984234322 -> "Chat ends.";
	j2786145705 [label="Ich möchte dir nur raten, vorsichtig zu sein ... er ist ein Monster im Gewand eines Gentlemans. Sei vorsichtig mit ihm, s'il te plaît ?",shape=box,color=blue];
		j2786145705 -> j690605480;
		j2786145705 -> j3399916714;
	j808986917 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j808986917 -> j4291397100 [label=true,color=green];
		j808986917 -> j963958530 [label=false,color=brown];
	j690605480 [label="Ich finde, du bist ihm gegenüber etwas unfair.",shape=box,color=red];
		j690605480 -> j705087671;
	j3399916714 [label="Ich werde vorsichtig sein. Versprochen.",shape=box,color=red];
		j3399916714 -> j1698151827;
	j4291397100 [label="Selbst wenn man glaubt, dass die dahinterstehende Kraft nicht von einem Gott, sondern aus unserem eigenen Geist stammt, stellt sie dennoch eine Bedrohung dar.",shape=box,color=blue];
		j4291397100 -> j2786145705;
	j963958530 [label="Selbst wenn er glaubt, dass die dahinterstehende Kraft nicht von einem Gott, sondern aus unserem eigenen Geist stammt, stellt sie dennoch eine Bedrohung dar.",shape=box,color=blue];
		j963958530 -> j2786145705;
	j705087671 [label="Add -1 to Thermostat counter",color=orange];
		j705087671 -> j657844692;
	j1698151827 [label="+20 Chemistry",color=orange];
		j1698151827 -> j3933677905;
	j657844692 [label="Oui ? Wieso ? Das meine ich nicht boshaft, ich bin wirklich neugierig.",shape=box,color=blue];
		j657844692 -> j1121742708;
		j657844692 -> j1810820932;
		j657844692 -> j2393572490;
		j657844692 -> j2254112024;
	j3933677905 [label="Merci. Das ist alles, wwas ich möchte.",shape=box,color=blue];
		j3933677905 -> "Chat ends.";
	j1121742708 [label="Er wuchs in einer anderen Gesellschaft, in einer anderen Zeit auf – mit anderen Erwartungen. Das mag uns nicht gefallen, aber er ist, wie er ist.",shape=box,color=red];
		j1121742708 -> j4043091924;
	j1810820932 [label="Du und Lyon habt das Protoframe-Serum von Entrati angenommen. Freiwillig. Er nicht. Kannst du dir vorstellen, wie das ist?",shape=box,color=red];
		j1810820932 -> j579472671;
		j1810820932 -> j3128273414;
		j1810820932 -> j4043091924;
	j2393572490 [label="Er verbrachte ganze Jahrhunderte seines Lebens damit, zu tun, was er für notwendig hielt. Wir sind uns nur uneinig darüber, was das genau ist.",shape=box,color=red];
		j2393572490 -> j579472671;
		j2393572490 -> j3737588684;
	j2254112024 [label="Ich glaube, es ist eher sein Auftreten, das dich so aufregt. Nicht seine Taten.",shape=box,color=red];
		j2254112024 -> j3737588684;
		j2254112024 -> j579472671;
	j4043091924 [label="Er ist ein hochrangiger Soldat und ein Lebemann. Und beides erfordert manchmal, dass man zweifelhafte Entscheidungen trifft.",shape=box,color=red];
		j4043091924 -> j681163897;
	j579472671 [label="Ich glaube, dass jemand etwas in guter Absicht tun kann, was wir dennoch als \"falsch\" empfinden.",shape=box,color=red];
		j579472671 -> j1303858137;
	j3128273414 [label="Er tat all das, um das Imperium der Orokin zu retten – und sein Dank dafür war, gegen seinen Willen in dieses Schlamassel hineingezogen zu werden.",shape=box,color=red];
		j3128273414 -> j681163897;
	j3737588684 [label="Ich glaube, er stößt dir sauer auf, weil er stolz auf das ist, was er erreicht hat.",shape=box,color=red];
		j3737588684 -> j4205657994;
	j681163897 [label="Check boolean MarieGrineer",color=orange];
		j681163897 -> j475266974 [label=true,color=green];
		j681163897 -> j1659258519 [label=false,color=brown];
	j1303858137 [label="Du hältst ihn für den Teufel, aber in seinen Augen ist die Wahrheit weit davon entfernt.",shape=box,color=red];
		j1303858137 -> j681163897;
	j4205657994 [label="Oui, ich habe kein Verständnis für diejenigen, die sich am Tod ergötzen. Und seine Gier, Blut zu vergießen, ist erschreckend. Und die Tatsache, dass dich das nicht beunruhigt, ebenso.",shape=box,color=blue];
		j4205657994 -> j2861874135;
	j475266974 [label="Und ich denke, diejenigen, die die \"Corpus\" oder \"Grineer\" befehligen, gegen die du kämpfst, würden dasselbe sagen. Sie glauben nicht, dass sie im Unrecht sind.",shape=box,color=blue];
		j475266974 -> j2656316639;
	j1659258519 [label="Und ich denke, diejenigen, die die \"Corpus\" oder \"Grin-ire\" befehligen, gegen die du kämpfst, würden dasselbe sagen. Sie glauben nicht, dass sie im Unrecht sind.",shape=box,color=blue];
		j1659258519 -> j2656316639;
	j2861874135 [label="Es ist allzu einfach, den Weg der Selbstverleugnung auf die Sünde der Gewalt anzuwenden, den Schrecken davon abzulehnen, zu sagen, es sei bedeutungslos im Namen dessen, \"was zählt\".",shape=box,color=blue];
		j2861874135 -> j2033600859;
	j2656316639 [label="Sie glauben, ihre Handlungen seien gerecht, gut und notwendig. Wie kann man das eine Übel gutheißen, das andere aber nicht ?",shape=box,color=blue];
		j2656316639 -> j2537966656;
		j2656316639 -> j4282465133;
		j2656316639 -> j67749703;
		j2656316639 -> j2558047262;
	j2033600859 [label="Stolz auf die Tat selbst zu sein ... das geht mir zu weit. Ich freue mich nicht, wenn ich ein Leben nehmen muss, aber er schon. Insofern ? Sind wir da grundverschieden.",shape=box,color=blue];
		j2033600859 -> j653022852;
	j2537966656 [label="Ich werde versuchen, sie aufzuhalten, wenn sie Dinge tun, mit denen ich nicht einverstanden bin. Aber ... ich werde an ihrer Seite kämpfen, wenn es nötig ist.",shape=box,color=red];
		j2537966656 -> j1347429762;
	j4282465133 [label="Ich glaube nicht, dass diese Gruppen per Definition \"gut\" oder \"böse\" sind. Nur allein die Handlungen, die sie begehen.",shape=box,color=red];
		j4282465133 -> j4020814096;
	j67749703 [label="Es steht mir nicht zu, zu bestimmen, welche Handlungen \"gut\" und welche \"schlecht\" sind. Ich tue, was ich tue, um diejenigen zu schützen, die Schutz benötigen.",shape=box,color=red];
		j67749703 -> j1347429762;
	j2558047262 [label="Du erwartest von mir, eine ganze Gruppe nach denselben Kriterien zu beurteilen, nach denen ich auch ein einzelnes Individuum beurteilen würde.",shape=box,color=red];
		j2558047262 -> j4020814096;
	j653022852 [label="Ich kann nur beten, dass es nicht zu spät ist, falls der Teufel beschließt, dir sein Messer in die Rippen zu stoßen. Ich will nicht, dass deine letzten Gedanken lauten: \"Marie hat mich gewarnt.\"",shape=box,color=blue];
		j653022852 -> j1016514321;
		j653022852 -> j1662277345;
	j1347429762 [label="Und du glaubst, der Teufel sei keine Bedrohung ? Dass er für diejenigen um ihn keine Gefahr darstellt ? Er kann großen Schaden anrichten.",shape=box,color=blue];
		j1347429762 -> j507634178;
		j1347429762 -> j2645075610;
	j4020814096 [label="Und was ist mit den schrecklichen Taten, die er begangen hat ? All dem Tod, all dem Gemetzel ? War das in deinen Augen gerechtfertigt ?",shape=box,color=blue];
		j4020814096 -> j2645075610;
	j1016514321 [label="Das wird er nicht. Und versucht er es, werde ich ihn daran hindern.",shape=box,color=red];
		j1016514321 -> j2541488494;
	j1662277345 [label="Ich verspreche, das werden nicht meine letzten Gedanken sein.",shape=box,color=red];
		j1662277345 -> j1820472922;
	j507634178 [label="Sollte er sich jemals gegen uns wenden, werde ich handeln. Bisher hat er sich als ein Verbündeter erwiesen. Wenn auch ... etwas melodramatisch.",shape=box,color=red];
		j507634178 -> j2214327696;
	j2645075610 [label="Ich sehe seine Gefährlichkeit nicht als Problem. Er ist eine Waffe. Und Waffen können zum Morden oder zum Schutz eingesetzt werden.",shape=box,color=red];
		j2645075610 -> j2489657632;
	j2541488494 [label="Ich bewundere dich für dein Selbstvertrauen, auch wenn ich bedauere, dass du ihm traust. Also werde ich wohl im Gegenzug dir vetrauen.",shape=box,color=blue];
		j2541488494 -> j4105349636;
	j1820472922 [label="Ich glaube, du meinst diese Worte nicht so, wie ich es mir wünsche, aber ich will nicht zu viel hineininterpretieren.",shape=box,color=blue];
		j1820472922 -> j4105349636;
	j2214327696 [label="Add 1 to Thermostat counter",color=orange];
		j2214327696 -> j653022852;
	j2489657632 [label="Add -1 to Thermostat counter",color=orange];
		j2489657632 -> j653022852;
	j4105349636 [label="Ich muss gehen. Aber nochmals, ich bitte dich inständig – sei vorsichtig. Um meinetwillen, wenn nicht um deinetwillen, d'accord ?",shape=box,color=blue];
		j4105349636 -> j367054140;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
}