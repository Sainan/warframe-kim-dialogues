	2827 [label="Wenn du dir sicher bist, aber ich bin da, falls du darüber reden möchtest.",shape=box,color=red];
		2827 -> 2838;
	2828 [label="Ich ... weiß, wie das ist. Bevor ich mit den 'Zeitschleifen' anfing, verletzte ich mich in Duviri ziemlich schwer. Es ist verheilt, aber es schmerzt manchmal furchtbar. Ich versuche mein Zusammenzucken zu verbergen, wenn es passiert.",shape=box,color=red];
		2828 -> 2839;
	2829 [label="Alte, hartnäckige Probleme können manchmal genauso problematisch sein wie neue. Nur weil sie kommen und gehen und bei uns bleiben, heißt das nicht, dass sie es nicht wert sind, darüber zu sprechen.",shape=box,color=red];
		2829 -> 2840;
