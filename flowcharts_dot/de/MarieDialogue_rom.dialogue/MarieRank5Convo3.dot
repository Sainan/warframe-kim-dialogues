	2841 [label="Oui, das ist es. Par exemple -",shape=box,color=blue];
		2841 -> 2850;
	2842 [label="Aber es ist, wie du sagtest, non ? Alle Unannehmlichkeiten bringen eine geheime Macht mit sich. Wir müssen sie nur finden.",shape=box,color=blue];
		2842 -> 2851;
	2843 [label="Oui, das ist es. Manchmal saß ich da und starrte auf ein Buch in der obersten Reihe eines Regals und dachte, wie ungerecht es doch ist, dass ich es nicht erreichen kann.",shape=box,color=blue];
		2843 -> 2852;
	2844 [label="Ich habe neulich im Sanctum alle Kronleuchter abgestaubt. Monsieur Loid hat mich angefleht aufzuhören.",shape=box,color=blue];
		2844 -> 2853;
	2848 [label="Es ist schwer zu erklären, aber ich werde es versuchen. Mes pieds, oui ? Meine Füße. Das sérum hat mich verändert, mir das Fliegen verliehen -",shape=box,color=blue];
		2848 -> 2858;
	2849 [label="Par les Luminaires, es tut mir so leid. Du verstehst also, wie es ist, oui ?",shape=box,color=blue];
		2849 -> 2859;
	2854 [label="Oui ! Oh, ich habe neulich im Sanctum alle Kronleuchter abgestaubt. Monsieur Loid hat mich angefleht aufzuhören.",shape=box,color=blue];
		2854 -> 2863;
	2855 [label="Aber es ist, wie du sagtest, non ? Alle Unannehmlichkeiten wie unsere bringen eine geheime Macht mit sich. Wir müssen sie nur finden.",shape=box,color=blue];
		2855 -> 2864;
	2856 [label="Oui, ich kenne deinen Frust. Manchmal saß ich da und starrte auf ein Buch in der obersten Reihe eines Regals und dachte, wie ungerecht es doch ist, dass ich es nicht erreichen kann.",shape=box,color=blue];
		2856 -> 2865;
	2857 [label="Oui !! Oh, du verstehst es !! Zum Beispiel -",shape=box,color=blue];
		2857 -> 2866;
	2850 [label="Weißt du, wie anstrengend es ist, ständig zu schweben, jour après jour, heure après heure, während andere gehen können ?",shape=box,color=blue];
		2850 -> 2860;
	2851 [label="Aber ja, es ist frustrierend. Manchmal saß ich da und starrte auf ein Buch in der obersten Reihe eines Regals und dachte, wie ungerecht es doch ist, dass ich es nicht erreichen kann.",shape=box,color=blue];
		2851 -> 2852;
	2852 [label="Es enthielt Wissen, das mir wichtig war, sonst niemandem, warum also wurde es mir vorenthalten ? Und dann kam irgendeine hilfsbereite Seele und holte es für mich aus Mitleid ...",shape=box,color=blue];
		2852 -> 2861;
	2853 [label="Ich sagte ihm, ich muss mich beschäftigen, meine Hände in Bewegung halten. Ich glaube, er hat nicht ganz verstanden, warum ich so aktiv bleiben muss.",shape=box,color=blue];
		2853 -> 2862;
	2858 [label="Aber ich spüre es dennoch, dieses Verkrüppelte, das droht, mich zu verschlingen, das droht, alle Hoffnung und Freude aus meiner Seele zu tilgen.",shape=box,color=blue];
		2858 -> 2867;
	2859 [label="Einen Körper zu haben, der einen im Stich lässt, der den Geist bremst. Selbst jetzt ist es so seltsam. Das sérum hat mich verändert, mir das Fliegen verliehen -",shape=box,color=blue];
		2859 -> 2868;
	2863 [label="Ich sagte ihm, ich muss mich beschäftigen, meine Hände in Bewegung halten. Ich glaube, er hat nicht ganz verstanden, warum ich so aktiv bleiben muss.",shape=box,color=blue];
		2863 -> 2872;
	2864 [label="Aber ich kenne deinen Frust. Oh, ich kennen das nur zu gut. Manchmal saß ich da und starrte auf ein Buch in der obersten Reihe eines Regals und dachte, wie ungerecht es doch ist, dass ich es nicht erreichen kann.",shape=box,color=blue];
		2864 -> 2865;
