		2825 -> 2834;
	2826 [label="Oui ! Das tust du ja gerade, indem du mit mir redest. Der Geist ist schon etwas Wunderbares, nicht wahr ? Ich glaube, mes pieds schmerzen ständig, und doch habe ich gelernt, sie einfach zu ignorieren.",shape=box,color=blue];
