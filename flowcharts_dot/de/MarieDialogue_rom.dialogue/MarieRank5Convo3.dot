		2887 -> 2899;
	2888 [label="Nein, kenne ich nicht ... sprich weiter.",shape=box,color=red];
		2888 -> 2900;
	2892 [label="Ich will nicht von Glauben sprechen, außer ... so fehlerhaft unsere Vorstellungen von uns selbst aus dieser begrenzten Perspektive auch sein mögen, wir ... müssen Frieden schließen mit dem, was wir sind, non ? Es ist alles, was wir haben.",shape=box,color=blue];
		2892 -> 2901;
	2891 [label="Ich weiß, unsere Glaubensvorstellungen ähneln sich, deshalb sage ich Folgendes ... Sol hat mich so erschaffen, wie ich bin, und ich muss seiner Kreation vertrauen, non ? So fehlerhaft sie aus meiner begrenzten Sicht auch erscheinen mag. Das müsste doch auch aus deiner Glaubenssicht ähnlich sein können.",shape=box,color=blue];
		2891 -> 2901;
	2893 [label="Ich weiß, unsere Glaubensvorstellungen unterscheiden sich, deshalb äußere ich mich nicht zu Themen, in denen ich mich nicht auskenne. Ich möchte nur sagen, dass Sol mich so erschaffen hat, wie ich bin, und dass ich seiner Kreation vertrauen muss, non ? So fehlerhaft sie aus meiner begrenzten Sicht auch erscheinen mag. Das müsste doch auch aus deiner Glaubenssicht ähnlich sein können.",shape=box,color=blue];
		2893 -> 2901;
	2894 [label="Ich weiß, dass dein Glaube eine persönliche Angelegenheit ist, deshalb frage ich nicht. Aber Sol hat mich so erschaffen, wie ich bin, und ich muss seiner Kreation vertrauen, non ? So fehlerhaft sie aus meiner begrenzten Sicht auch erscheinen mag. Das müsste doch auch aus deiner Glaubenssicht ähnlich sein können.",shape=box,color=blue];
		2894 -> 2901;
	2898 [label="Sol hat uns beide so erschaffen, wie wir sind, und wir müssen Vertrauen in seine Kreation haben, non ? So fehlerhaft sie uns aus unserer begrenzten Sicht auch erscheinen mag.",shape=box,color=blue];
		2898 -> 2901;
	2889 [label="Lua erschuf dich so, wie du bist, und Sol erschuf mich so, wie ich bin. Wir müssen Vertrauen in ihre Kreation haben, non ? So fehlerhaft sie uns aus unserer begrenzten Sicht auch erscheinen mag.",shape=box,color=blue];
		2889 -> 2901;
	2890 [label="Die Himmlischen haben uns so erschaffen, wie wir sind. Wir müssen Vertrauen in ihre Kreation haben, non? So fehlerhaft sie uns aus unserer begrenzten Sicht auch erscheinen mag.",shape=box,color=blue];
		2890 -> 2901;
	2895 [label="Ich weiß, du bist der Ansicht, dass keiner von uns die wahre Antwort auf die Fragen des Universums kennt, und das respektiere ich. Aber Sol hat mich so erschaffen, wie ich bin, und ich muss Vertrauen in seine Kreation haben, non ? So fehlerhaft sie mir aus meiner begrenzten Sicht auch erscheinen mag.",shape=box,color=blue];
		2895 -> 2901;
	2896 [label="Ich weiß, du bist nicht gläubig, und das respektiere ich. Aber Sol hat mich so erschaffen, wie ich bin, und ich muss Vertrauen in seine Kreation haben, non ? So fehlerhaft sie mir aus meiner begrenzten Sicht auch erscheinen mag.",shape=box,color=blue];
		2896 -> 2901;
