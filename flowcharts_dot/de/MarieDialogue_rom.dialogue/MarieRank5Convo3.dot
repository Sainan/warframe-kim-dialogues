		2865 -> 2873;
		2865 -> 2874;
	2866 [label="Weißt du, wie anstrengend es ist, ständig zu schweben, jour après jour, heure après heure, während andere gehen können ?",shape=box,color=blue];
		2866 -> 2875;
	2860 [label="Ich bin ravie davon, so mobil zu sein und alles erreichen zu können, was ich möchte, versteh mich nicht falsch. Aber es ist trotzdem so anstrengend !",shape=box,color=blue];
		2860 -> 2862;
	2861 [label="Und es ist nicht ihre Schuld, denn sie tun etwas Gutes – ich brauchte die Hilfe. Und es ist nicht ihre Schuld, dass ich sie brauchte. Aber ach, wie frustrierend ist es doch, auf diese Hilfe angewiesen zu sein.",shape=box,color=blue];
		2861 -> 2869;
		2861 -> 2870;
	2862 [label="Es ist einfach ... so schön, über all das sprechen zu können. Ich kann es nicht richtig in Worte fassen. Es ist so selten, über diese unsichtbare, stille Plage, an der ich leide, sprechen zu können.",shape=box,color=blue];
		2862 -> 2871;
	2867 [label="Sie schmerzen. Immer. Selbst jetzt, während ich hier sitze und an sie denke, spüre ich den Schmerz. Aber manchmal nehme ich es nicht wahr.",shape=box,color=blue];
		2867 -> 2811;
		2867 -> 2810;
	2868 [label="Aber ich spüre es dennoch, dieses Verkrüppelte, das droht, mich zu verschlingen, das droht, alle Hoffnung und Freude aus meiner Seele zu tilgen.",shape=box,color=blue];
		2868 -> 2876;
	2872 [label="Ach, es freut mich einfach zu wissen, dass hier jemand versteht, wie das ist. Das ist so selten. Diese stille, unsichtbare Plage, unter der wir leiden.",shape=box,color=blue];
		2872 -> 2880;
	2873 [label="Was ist daran falsch?",shape=box,color=red];
		2873 -> 2881;
	2874 [label="Ja, ich weiß. Und es ist nicht ihre Schuld.",shape=box,color=red];
		2874 -> 2882;
	2875 [label="Ich bin ravie davon, so mobil zu sein und alles erreichen zu können, was ich möchte, versteh mich nicht falsch. Aber es ist trotzdem so anstrengend !!",shape=box,color=blue];
		2875 -> 2872;
	2869 [label="Es tut mir sehr leid, dass du das alles ertragen musst.",shape=box,color=red];
		2869 -> 2877;
	2870 [label="Und du kannst diese Frustration nicht einmal ausdrücken.",shape=box,color=red];
		2870 -> 2877;
	2871 [label="Wie eine winzige kleine abeille, die auf mir sitzt und mich jeden Tag sticht. Nicht genug, um zu zerstören, aber genug, um unangenehm zu sein.",shape=box,color=blue];
		2871 -> 2878;
		2871 -> 2879;
	2876 [label="Sie schmerzen. Immer. Selbst jetzt, während ich hier sitze und an sie denke, spüre ich den Schmerz. Aber manchmal nehme ich es nicht wahr.",shape=box,color=blue];
		2876 -> 2813;
		2876 -> 2812;
	2880 [label="Wie eine winzige kleine abeille, die auf uns sitzt und uns jeden Tag sticht. Nicht genug, um uns zu zerstören, aber genug, um unangenehm zu sein.",shape=box,color=blue];
		2880 -> 2879;
		2880 -> 2878;
	2881 [label="Nichts ! Nichts ist falsch daran. Ich brauchte die Hilfe. Aber genau das ist der Kern des Problems: Ich brauchte die Hilfe. Und es ist, wie du schon sagtest ... frustrierend.",shape=box,color=blue];
		2881 -> 2885;
	2882 [label="Oui! Es ist nicht ihre Schuld, denn sie tun etwas Gutes – ich brauchte die Hilfe. Und es ist nicht ihre Schuld, dass ich sie brauchte. Aber ach, wie frustrierend ist es doch, auf diese Hilfe angewiesen zu sein.",shape=box,color=blue];
