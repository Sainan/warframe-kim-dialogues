	2834 [label="Der Geist ist wirklich etwas Wunderbares. Ich finde es faszinierend, dass es immer und ständig weh tun muss, und doch habe ich gelernt, es einfach zu ignorieren.",shape=box,color=blue];
		2834 -> 2835;
		2834 -> 2836;
		2834 -> 2837;
	2835 [label="Mir geht es genauso. Sobald ich mich konzentriere – ja, da ist der Schmerz. Manchmal frage ich mich, ob ich deshalb ständig so verdammt beschäftigt bin.",shape=box,color=red];
		2835 -> 2845;
	2836 [label="Manchmal werde ich wütend, wenn ich daran denke, wie viel ich schaffen könnte, wenn ich nicht ständig von den Schmerzen abgelenkt wäre.",shape=box,color=red];
		2836 -> 2846;
	2837 [label="Bist du auch ständig müde? Manchmal frage ich mich, ob das der Grund für meine Erschöpfung ist. Ich habe immer wieder unterschwellige Schmerzen.",shape=box,color=red];
		2837 -> 2847;
