	"MinVelRank1Convo3 begins." [color=orange];
		"MinVelRank1Convo3 begins." -> j3675741730;
	j3675741730 [label="MomToxicated: Drifter. Können wir reden?",shape=box,color=blue];
		j3675741730 -> j4093820820;
		j3675741730 -> j1665548713;
		j3675741730 -> j1876904536;
		j3675741730 -> j4058898227;
	j4093820820 [label="Guten Morgen, Minerva. Falls das dein richtiger Name ist.",shape=box,color=red];
		j4093820820 -> j4148843789;
	j1665548713 [label="Ich sehe, wir lassen die \"Anführungszeichen\" weg.",shape=box,color=red];
		j1665548713 -> j1599460710;
	j1876904536 [label="Jetzt fragst du?",shape=box,color=red];
		j1876904536 -> j1599460710;
	j4058898227 [label="Ja?",shape=box,color=red];
		j4058898227 -> j3004054319;
	j4148843789 [label="+5 Chemistry",color=orange];
		j4148843789 -> j4020714227;
	j1599460710 [label="MomToxicated: Mir wurde ein Vortrag gehalten über mein sogenanntes schlechtes Benehmen.",shape=box,color=blue];
		j1599460710 -> j2706524165;
	j3004054319 [label="+5 Chemistry",color=orange];
		j3004054319 -> j1318353385;
	j4020714227 [label="MomToxicated: Glaub es oder nicht, das ist er.",shape=box,color=blue];
		j4020714227 -> j3867727044;
	j2706524165 [label="MomToxicated: Was, alles in allem, urkomisch ist.",shape=box,color=blue];
		j2706524165 -> j958726774;
	j1318353385 [label="MomToxicated: Kommen wir gleich zur Sache. Gut.",shape=box,color=blue];
		j1318353385 -> j958726774;
	j3867727044 [label="MomToxicated: Aber darum geht es nicht.",shape=box,color=blue];
		j3867727044 -> j958726774;
	j958726774 [label="MomToxicated: Wir sind hier in Höllvania und müssen ein Problem lösen. Und du kannst mir dabei helfen.",shape=box,color=blue];
		j958726774 -> j2848902254;
	j2848902254 [label="MomToxicated: Deshalb musst du - und ich frage hiermit - mir helfen.",shape=box,color=blue];
		j2848902254 -> j2577594511;
		j2848902254 -> j673673766;
		j2848902254 -> j75936907;
	j2577594511 [label="Welches Problem soll ich lösen?",shape=box,color=red];
		j2577594511 -> j2187639417;
	j673673766 [label="Warum sollte ich dir helfen?",shape=box,color=red];
		j673673766 -> j2187639417;
	j75936907 [label="Und was hat das mit Rusalka zu tun?",shape=box,color=red];
		j75936907 -> j2187639417;
	j2187639417 [label="MomToxicated: Das ist eine sehr gute Frage.",shape=box,color=blue];
		j2187639417 -> j1250989156;
	j1250989156 [label="MomToxicated: Du musst mir nicht meinetwegen helfen. Wir haben einen gemeinsamen Feind. Diesen \"Mann in der Wand\".",shape=box,color=blue];
		j1250989156 -> j2883087215;
	j2883087215 [label="MomToxicated: Soweit ich es beurteilen kann, interessiert uns beide, wohin er gegangen ist, was er vorhat und warum er es überhaupt auf Rusalka abgesehen hat.",shape=box,color=blue];
		j2883087215 -> j3064775231;
	j3064775231 [label="MomToxicated: Habe ich mit dieser Einschätzung recht?",shape=box,color=blue];
		j3064775231 -> j835486283;
		j3064775231 -> j1950716269;
		j3064775231 -> j2385709013;
	j835486283 [label="Kannst du einen Augenblick innehalten und mir erklären, warum dir Rusalka so am Herzen liegt?",shape=box,color=red];
		j835486283 -> j1658474737;
	j1950716269 [label="Die ersten beiden Punkte, ja. Es ist mir allerdings scheißegal, warum er hinter Rusalka her war.",shape=box,color=red];
		j1950716269 -> j2121271466;
	j2385709013 [label="Sicher. Ja. Das ist richtig.",shape=box,color=red];
		j2385709013 -> j1472310083;
	j1658474737 [label="MomToxicated: Das Warum ist nicht wichtig.",shape=box,color=blue];
		j1658474737 -> j89058604;
	j2121271466 [label="MomToxicated: Wenn du nicht zumindest ein bisschen an ihrem Wohlergehen interessiert bist, warum hast du sie dann verschont? Wir haben die Geschichte gehört.",shape=box,color=blue];
		j2121271466 -> j1866068672;
		j2121271466 -> j3403650875;
		j2121271466 -> j2185759940;
	j1472310083 [label="Es tut mir wirklich leid, aber wir müssen wahrscheinlich warten, bis der Mann in der Wand seinen nächsten Schritt macht.",shape=box,color=red];
		j1472310083 -> j618813619;
	j89058604 [label="PapaPolar: es ist aber doch. und sie haben es wahrscheinlich sowieso schon herausgefunden. es ist nicht so, als wären wir gerade dezent",shape=box,color=blue];
		j89058604 -> j3531883764;
	j1866068672 [label="Weil ich sonst genau wie die Gleichgültigkeit wäre. Wie Scaldra. Wie Entrati. Ich laufe nicht herum und bringe sinnlos Leute um.",shape=box,color=red];
		j1866068672 -> j1508046487;
	j3403650875 [label="Weil es nicht wirklich ihre Entscheidungen waren, die sie an diesen Punkt gebracht haben. Nur weil ich sie im Moment nicht dafür töten würde, heißt das nicht, dass sie mir *wichtig* genug ist, um sie zu retten.",shape=box,color=red];
		j3403650875 -> j2897841546;
	j2185759940 [label="Weil ich nicht vorhatte, die Drecksarbeit für Entrati zu erledigen. Wenn er die neue Marionette der Gleichgültigkeit töten will, kann er das selbst tun.",shape=box,color=red];
		j2185759940 -> j3727831512;
	j618813619 [label="MomToxicated: Und warum? Hast du keine Möglichkeit, ihn aufzuspüren? Es? Was auch immer es ist? Oder weißt du einfach nicht, was es wirklich will?",shape=box,color=blue];
		j618813619 -> j850888033;
		j618813619 -> j3075321331;
	j3531883764 [label="PapaPolar: und vielleicht, *nur vielleicht* wenn du unserem neuen kleinen freund hier ein paar informationen anvertrauen würdest, dann wären sie vielleicht eher bereit, *uuuuuns zu heeelfen*",shape=box,color=blue];
		j3531883764 -> j1054378725;
	j1508046487 [label="Das würde andeuten, dass ich absichtlich morde. Was ich aber nicht mache. Ich meine, ich bringe Menschen um. Aber das ist etwas anderes. Du weißt, was ich meine.",shape=box,color=red];
		j1508046487 -> j470936489;
	j2897841546 [label="Ich *kenne* sie nicht.",shape=box,color=red];
		j2897841546 -> j1603655875;
	j3727831512 [label="Aber wie ich vermutet habe, schießt der alte Bastard nur auf Leute, von denen er weiß, dass sie sich wieder erheben werden.",shape=box,color=red];
		j3727831512 -> j1064062225;
	j850888033 [label="Nein, ich kann einem Halbgott-Ding nicht einfach einen Peilsender antackern.",shape=box,color=red];
		j850888033 -> j3092442889;
	j3075321331 [label="Seine Beweggründe sind uns im Moment ein wenig schleierhaft, ja. Aber sie sind definitiv nicht gut.",shape=box,color=red];
		j3075321331 -> j3092442889;
	j1054378725 [label="PapaPolar: es ist fast so, als würden Leute manchmal genau so funktionieren. ",shape=box,color=blue];
		j1054378725 -> j490828589;
	j470936489 [label="+5 Chemistry",color=orange];
		j470936489 -> j2453080162;
	j1603655875 [label="PapaPolar: und wir geben dir nicht wirklich einen grund, warum sie dir wichtig sein sollte, oder, M?",shape=box,color=blue];
		j1603655875 -> j1820738757;
	j1064062225 [label="PapaPolar: eine sehr seltsam spezifische aussage, aber okay",shape=box,color=blue];
		j1064062225 -> j646771880;
		j1064062225 -> j2739792745;
	j3092442889 [label="MomToxicated: Du schlägst also vor, dass wir abwarten. Und warten. Bis es ... was? Den Kopf herausstreckt? Und dann spielen wir eine Runde Hau-Drauf?!",shape=box,color=blue];
		j3092442889 -> j2501941165;
	j490828589 [label="MomToxicated: Was würde es bringen?",shape=box,color=blue];
		j490828589 -> j157248896;
	j2453080162 [label="PapaPolar: du sprichst mit ehemaligen militär-spezialeinheiten, wir haben es verstanden. lol",shape=box,color=blue];
		j2453080162 -> j765792978;
	j1820738757 [label="MomToxicated: Halt die Klappe, Velimir.",shape=box,color=blue];
		j1820738757 -> j1658474737;
	j646771880 [label="Ist schon ok. Ich sterbe oft. Ich bin daran gewöhnt.",shape=box,color=red];
		j646771880 -> j3570950196;
	j2739792745 [label="Es ist nicht wirklich wichtig.",shape=box,color=red];
		j2739792745 -> j1472310083;
		j2739792745 -> j3472347863;
	j2501941165 [label="PapaPolar: wenigstens gibt es hier gute gesellschaft und eine nette bar?",shape=box,color=blue];
		j2501941165 -> j4029669091;
	j157248896 [label="PapaPolar: es schadet nicht, freunde in dieser welt zu haben, M.",shape=box,color=blue];
		j157248896 -> j2885012401;
	j765792978 [label="PapaPolar: was wir im namen des \"allgemeinwohls\" tun müssen, ist manchmal verschwommen",shape=box,color=blue];
		j765792978 -> j3778951694;
	j3570950196 [label="PapaPolar: oookie dokie ... schon klar ... sicher ...",shape=box,color=blue];
		j3570950196 -> j339472763;
	j3472347863 [label="Warum wollt ihr so dringend erfahren, was mit Rusalka passiert ist?",shape=box,color=red];
		j3472347863 -> j1658474737;
	j4029669091 [label="PapaPolar: musik ist ziemlich gut. dieser arthur-typ scheint meine art von trinkkumpel zu sein",shape=box,color=blue];
		j4029669091 -> j2139854505;
	j2885012401 [label="MomToxicated: Wozu brauchen wir \"Freunde\"?! Wir verschwinden hier, sobald wir wissen, wo wir hin müssen, um Neci zu retten.",shape=box,color=blue];
		j2885012401 -> j1998632716;
	j3778951694 [label="PapaPolar: und deswegen, wenn etwas wichtig ist, dann tun wir es, wenn wir können. deshalb sind wir hier und versuchen, neci zu retten",shape=box,color=blue];
		j3778951694 -> j1472310083;
		j3778951694 -> j3472347863;
	j339472763 [label="PapaPolar: wie auch immer ...",shape=box,color=blue];
		j339472763 -> j1472310083;
		j339472763 -> j3472347863;
	j2139854505 [label="MomToxicated: Und sonst, was, wir machen einfach weiter, ohne zu wissen, was wirklich mit ihr passiert ist?! Oder ob es ihr gut geht?! Oder ob sie überhaupt noch sie selbst ist?!",shape=box,color=blue];
		j2139854505 -> j647582753;
	j1998632716 [label="PapaPolar: bin mir dessen nicht sicher. scheint schwierig zu sein, die bewegungen eines halbgott-void-monster ... dingens vorherzusagen. stimmt's kleiner freund?",shape=box,color=blue];
		j1998632716 -> j3075321331;
		j1998632716 -> j850888033;
	j647582753 [label="MomToxicated: Wie kannst du hier rumsitzen. Wie kann dir das EGAL sein, Velimir?!",shape=box,color=blue];
		j647582753 -> j3717091736;
	j3717091736 [label="PapaPolar: ich habe nie behauptet, dass es mir egal ist, M! ich verstehe nur, dass wir abwarten müssen!",shape=box,color=blue];
		j3717091736 -> j3494228143;
	j3494228143 [label="MomToxicated: Ich sprach mit Eleanor. Sie hat mir erzählt, was sie fühlte, als sie Necis Geist berührte. Oder was davon übrig war.",shape=box,color=blue];
		j3494228143 -> j2729935626;
	j2729935626 [label="MomToxicated: Die Frau, die wir großgezogen haben. Die Frau, die wir wie unser eigenes Kind geliebt haben.",shape=box,color=blue];
		j2729935626 -> j1310912223;
	j1310912223 [label="MomToxicated: Wer weiß was -",shape=box,color=blue];
		j1310912223 -> j1602167784;
	j1602167784 [label="MomToxicated: Und du willst über Trinkgelage mit Arthur schwafeln.",shape=box,color=blue];
		j1602167784 -> j1977205548;
	j1977205548 [label="MomToxicated: Du-te dracu, Velimir.",shape=box,color=blue];
		j1977205548 -> j22692693;
	j22692693 [label="PapaPolar: uuuuuund weg ist sie ...",shape=box,color=blue];
		j22692693 -> j61599526;
		j22692693 -> j3072332603;
	j61599526 [label="Was hat sie gesagt ...?",shape=box,color=red];
		j61599526 -> j441047417;
	j3072332603 [label="Ich vermute, das war eine Beleidigung.",shape=box,color=red];
		j3072332603 -> j2754876273;
