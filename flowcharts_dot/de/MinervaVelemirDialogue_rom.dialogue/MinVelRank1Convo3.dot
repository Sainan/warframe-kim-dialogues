		j441047417 -> j1276009796;
		j441047417 -> j862730297;
	j2754876273 [label="PapaPolar: jap. das spaßige daran, bei so vielen auslandseinsätzen stationiert gewesen zu sein. beschimpft zu werden in 100 verschiedenen sprachen",shape=box,color=blue];
		j2754876273 -> j1276009796;
		j2754876273 -> j862730297;
	j1276009796 [label="Seid ihr zwei ... verheiratet?",shape=box,color=red];
		j1276009796 -> j3983984126;
	j862730297 [label="Ihr zwei ... habt ... Rusalka großgezogen?",shape=box,color=red];
		j862730297 -> j3557148526;
	j3983984126 [label="Boolean MinervaVelimir1 is now true.",color=orange];
		j3983984126 -> j1941046376;
	j3557148526 [label="Boolean MinervaNeci3a is now true.",color=orange];
		j3557148526 -> j3662466320;
	j1941046376 [label="PapaPolar: mmm. irgendwie. nicht mehr wirklich. nur auf dem papier. irgendwo. in einem land, das seit etwa 1982 nicht mehr existiert?",shape=box,color=blue];
		j1941046376 -> j2934546278;
	j3662466320 [label="PapaPolar: mehr oder weniger. wir waren in einer kleinen stadt in übersee ein paar länder südlich von hier. wurde alles in stücke gerissen. fand sie dort in einem gebäude, rote haare und wüüüütend.",shape=box,color=blue];
		j3662466320 -> j1779377170;
	j2934546278 [label="PapaPolar: zählt das?",shape=box,color=blue];
		j2934546278 -> j771685267;
		j2934546278 -> j1902263130;
	j1779377170 [label="PapaPolar: sie hat sechsmal versucht, mich mit einem löffel zu erstechen, bahahaha, das süßeste kleine ding, das du je gesehen hast.",shape=box,color=blue];
		j1779377170 -> j28685001;
	j771685267 [label="Ja, es scheint, als wärt ihr beide nicht mehr zusammen.",shape=box,color=red];
		j771685267 -> j75587382;
	j1902263130 [label="Das erklärt, denke ich, eure Streitigkeiten.",shape=box,color=red];
		j1902263130 -> j3144261245;
	j28685001 [label="PapaPolar: hatte allerdings dieses kleine plüschkaninchen, an dem sie sich festklammerte. M sagte ihr, sie würde es mit ihrem leben beschützen und es in sicherheit bringen.",shape=box,color=blue];
		j28685001 -> j2607848151;
	j75587382 [label="PapaPolar: was hat uns verraten.",shape=box,color=blue];
		j75587382 -> j3144261245;
	j3144261245 [label="PapaPolar: als neci uns verließ, um sich scaldra anzuschließen ... war zwischen uns nichts mehr so wie früher. das war der letzte tropfen, der das fass zum überlaufen brachte, glaube ich.",shape=box,color=blue];
		j3144261245 -> j2158498958;
	j2607848151 [label="PapaPolar: dadurch gewann sie sehr schnell necis vertrauen. sie rannte direkt auf M zu und umarmte sie. wir verließen dann das militär. nun ja, offiziell. wir wurden \"berater\".",shape=box,color=blue];
		j2607848151 -> j1837090385;
	j2158498958 [label="PapaPolar: seufz.",shape=box,color=blue];
		j2158498958 -> j4294350550;
	j1837090385 [label="PapaPolar: also ... ja. man könnte sagen, wir haben sie großgezogen.",shape=box,color=blue];
		j1837090385 -> j4294350550;
	j4294350550 [label="PapaPolar: okay, ich muss tun, was ich am besten kann.",shape=box,color=blue];
		j4294350550 -> j1106337044;
	j1106337044 [label="PapaPolar: vorgeben, als wüsste ich, was ich falsches gesagt habe, und vorgeben, dass ich es in Zukunft nicht noch einmal so vermassele.",shape=box,color=blue];
		j1106337044 -> j2017522426;
