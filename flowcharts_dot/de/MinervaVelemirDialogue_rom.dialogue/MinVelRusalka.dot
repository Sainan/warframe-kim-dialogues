	"Chat ends." [color=orange];
	j857369328 [label="Hey ... Leute?",shape=box,color=red];
		j857369328 -> j1339883508;
	j1339883508 [label="MomToxicated: Ja?",shape=box,color=blue];
		j1339883508 -> j1971595676;
	j1971595676 [label="PapaPolar: was gibt's, kleiner freund?",shape=box,color=blue];
		j1971595676 -> j422314042;
		j1971595676 -> j2213997762;
		j1971595676 -> j2349714525;
	j422314042 [label="Ich habe gute und schlechte Nachrichten. Über Neci.",shape=box,color=red];
		j422314042 -> j4110946244;
	j2213997762 [label="Macht euch keine allzu großen Hoffnungen. Ich habe Neuigkeiten über Neci, aber sie sind ... gemischt. Und nicht eindeutig.",shape=box,color=red];
		j2213997762 -> j3856757824;
	j2349714525 [label="Pfff ... Eigentlich, ach nichts. [Ende.]",shape=box,color=red];
		j2349714525 -> "Chat ends.";
	j4110946244 [label="PapaPolar: mach es wie erwachsene. schlechte nachrichten zuerst.",shape=box,color=blue];
		j4110946244 -> j1072223286;
	j3856757824 [label="+5 Chemistry",color=orange];
		j3856757824 -> j80643570;
	j1072223286 [label="MomToxicated: Ich stimme zu. Schlechte Nachrichten immer zuerst.",shape=box,color=blue];
		j1072223286 -> j1285866534;
	j80643570 [label="MomToxicated: Das ist generell bei allen Dingen im Leben so. Aber danke für die Warnung.",shape=box,color=blue];
		j80643570 -> j3784915497;
	j1285866534 [label="Also. Die Gleichgültigkeit ging nach Duviri. Und sie ... nahm Neci mit.",shape=box,color=red];
		j1285866534 -> j845141790;
	j3784915497 [label="+5 Chemistry",color=orange];
		j3784915497 -> j1563516273;
	j845141790 [label="PapaPolar: moment. moment. moment. diese märchendimension?",shape=box,color=blue];
		j845141790 -> j1802787177;
	j1563516273 [label="PapaPolar: bin bereit für die neuigkeiten, aber es hört sich an, als wäre sie ... zumindest nicht tot?",shape=box,color=blue];
		j1563516273 -> j3032474515;
	j1802787177 [label="MomToxicated: Die mit dem Kinddiktator, der dich immer wieder umgebracht hat?",shape=box,color=blue];
		j1802787177 -> j1460933783;
		j1802787177 -> j2544302056;
	j3032474515 [label="Ich ... weiß es nicht. Ich glaube nicht. Ich sage euch einfach, was ich weiß, und überlasse euch die Entscheidung.",shape=box,color=red];
		j3032474515 -> j1285866534;
	j1460933783 [label="Offenbar war es ein Ereignis für ihn an dem er gewachsen ist? Nicht der Punkt. Wie auch immer-",shape=box,color=red];
		j1460933783 -> j2671411856;
	j2544302056 [label="Genau diese.",shape=box,color=red];
		j2544302056 -> j2671411856;
	j2671411856 [label="Neci ... bestieg den Thron. Das Raunen – die 'Armee' der Gleichgültigkeit, in Ermangelung eines besseren Wortes – marschierte ein und sie übernahm die Macht.",shape=box,color=red];
		j2671411856 -> j1804902246;
	j1804902246 [label="MomToxicated: Heh. Das ist mein kleines Mädchen.",shape=box,color=blue];
		j1804902246 -> j516264146;
	j516264146 [label="PapaPolar: aber war es wirklich *sie*? oder nur das ding, das ihr gesicht trug?",shape=box,color=blue];
		j516264146 -> j3930958669;
		j516264146 -> j1458598457;
	j3930958669 [label="Ich weiß es nicht.",shape=box,color=red];
		j3930958669 -> j2342265692;
	j1458598457 [label="Darüber wollte ich mit euch sprechen.",shape=box,color=red];
		j1458598457 -> j2342265692;
	j2342265692 [label="Ich habe diese Aufnahmen gefunden. Sie waren zusammenhanglos. Aber als ich sie alle zusammenfügte, erhielt ich diese Nachricht.",shape=box,color=red];
		j2342265692 -> j1582542521;
	j1582542521 [label="Ich war neugierig, ob es für euch Sinn ergibt.",shape=box,color=red];
		j1582542521 -> j3875516814;
	j3875516814 [label="MomToxicated: Rätsel und seltsame Botschaften? Das ist unsere Sprache.",shape=box,color=blue];
		j3875516814 -> j3039508812;
	j3039508812 [label="PapaPolar: 0-800-spionage-kram, hier bist du richtig",shape=box,color=blue];
		j3039508812 -> j1984707374;
	j1984707374 [label="\"Wenn Sol und Lua sich vereinen, werden die Verlorenen ihren Weg nach Hause finden.\"",shape=box,color=red];
		j1984707374 -> j2473893071;
	j2473893071 [label="PapaPolar: .... scheiße. M. SCHEISSE.",shape=box,color=blue];
		j2473893071 -> j2297998278;
	j2297998278 [label="MomToxicated: Fall nicht darauf herein. Wenn das Ding in ihrem Kopf ist, weiß es, was sie weiß.",shape=box,color=blue];
		j2297998278 -> j2706096868;
		j2297998278 -> j2957591642;
	j2706096868 [label="Was? Was bedeutet das?",shape=box,color=red];
		j2706096868 -> j3384723089;
	j2957591642 [label="Das ist der zweite Teil, nicht wahr?",shape=box,color=red];
		j2957591642 -> j3710155426;
	j3384723089 [label="PapaPolar: \"Suche an leeren Kreuzungen die Sonnenfinsternis.\"",shape=box,color=blue];
		j3384723089 -> j2117139655;
	j3710155426 [label="+5 Chemistry",color=orange];
		j3710155426 -> j1662801184;
	j2117139655 [label="PapaPolar: was ich dir gesagt habe, das, was du unserem kleinen mädchen sagen sollst, wenn du sie wiedersiehst.",shape=box,color=blue];
		j2117139655 -> j2655623766;
	j1662801184 [label="PapaPolar: du hast es erfasst ...",shape=box,color=blue];
		j1662801184 -> j2465043359;
	j2655623766 [label="PapaPolar: unsere hälfte eines codesatzes. so fingen wir jedes telefongespräch an, um zu wissen, dass wir uns auf einer abgesicherten leitung befanden und alles sicher war.",shape=box,color=blue];
		j2655623766 -> j1652387603;
	j2465043359 [label="PapaPolar: wir hatten einen codesatz. so begannen wir jedes telefongespräch, um zu wissen, dass wir uns auf einer abgesicherten leitung befanden und alles sicher war.",shape=box,color=blue];
		j2465043359 -> j1652387603;
	j1652387603 [label="MomToxicated: Dass wir tatsächlich ... wir selbst waren.",shape=box,color=blue];
		j1652387603 -> j3252089386;
	j3252089386 [label="PapaPolar: \"Suche an leeren Kreuzungen die Sonnenfinsternis.\" war unsere hälfte.",shape=box,color=blue];
		j3252089386 -> j2516229253;
	j2516229253 [label="MomToxicated: \"Wenn Sol und Lua sich vereinen, werden die Verlorenen ihren Weg nach Hause finden.\" war die Antwort.",shape=box,color=blue];
		j2516229253 -> j2205991492;
	j2205991492 [label="MomToxicated: *Ihre* Hälfte.",shape=box,color=blue];
		j2205991492 -> j1723917680;
		j2205991492 -> j1403711579;
	j1723917680 [label="Aber wir können nicht sicher sein, dass sie es war, wie du sagtest, Minerva. Die Gleichgültigkeit weiß, was sie weiß.",shape=box,color=red];
		j1723917680 -> j1855987430;
	j1403711579 [label="Ich weiß nicht, warum die Gleichgültigkeit euch das sagen würde ...",shape=box,color=red];
		j1403711579 -> j2905079562;
	j1855987430 [label="MomToxicated: Aber warum würde sie versuchen, uns Hoffnung zu machen? Es sei denn, sie wollte uns einfach nur verletzen.",shape=box,color=blue];
		j1855987430 -> j2929584619;
	j2905079562 [label="MomToxicated: Um falsche Hoffnungen zu erwecken? Um uns Schmerz zuzufügen?",shape=box,color=blue];
		j2905079562 -> j3002748915;
	j2929584619 [label="PapaPolar: ist das schmerzlich?",shape=box,color=blue];
		j2929584619 -> j2506158741;
	j3002748915 [label="PapaPolar: ist es falsche hoffnung? ist das schmerzlich?",shape=box,color=blue];
		j3002748915 -> j2506158741;
	j2506158741 [label="PapaPolar: oder ist es eine art frieden, zu wissen, dass unser kleines mädchen irgendwo da draußen, noch am leben ist?",shape=box,color=blue];
		j2506158741 -> j3788922836;
	j3788922836 [label="PapaPolar: dass sie trotz aller widrigkeiten immer noch kämpft und sich namen macht?",shape=box,color=blue];
		j3788922836 -> j977926170;
	j977926170 [label="PapaPolar: auch wenn sie nicht mit uns ist?",shape=box,color=blue];
		j977926170 -> j2010278199;
	j2010278199 [label="PapaPolar: ich weiß nicht, wie es dir geht, aber mir wärmt es mein großes, dummes herz.",shape=box,color=blue];
		j2010278199 -> j1951247243;
	j1951247243 [label="PapaPolar: und etwas sagt mir, dass das nicht das ist, was die sogenannte gleichgültigkeit im sinn hatte",shape=box,color=blue];
		j1951247243 -> j1513393977;
	j1513393977 [label="MomToxicated: Du hast absolut recht. Diesen Satz zu hören und zu glauben, dass sie *+vielleicht* noch da draußen ist, schmerzt nicht.",shape=box,color=blue];
		j1513393977 -> j597908039;
	j597908039 [label="MomToxicated: Ich bin stolz auf sie.",shape=box,color=blue];
		j597908039 -> j774912947;
		j597908039 -> j827358908;
		j597908039 -> j1427487674;
	j774912947 [label="Selbst wenn sie immer noch von der Gleichgültigkeit als Geisel gehalten wird?",shape=box,color=red];
		j774912947 -> j4007635482;
	j827358908 [label="Selbst wenn es ein Trick der Gleichgültigkeit ist?",shape=box,color=red];
		j827358908 -> j1758870196;
	j1427487674 [label="Sie könnte auch bereitwillig mit der Gleichgültigkeit arbeiten.",shape=box,color=red];
		j1427487674 -> j1596838072;
	j4007635482 [label="PapaPolar: sie ist so hart im nehmen wie eine tüte nägel in einem großen block aus titanguss",shape=box,color=blue];
		j4007635482 -> j2931180527;
	j1758870196 [label="MomToxicated: Warum? Wozu? Welchen Vorteil würden wir der Gleichgültigkeit geben?",shape=box,color=blue];
		j1758870196 -> j2170348213;
	j1596838072 [label="MomToxicated: Dann hat sie einen der mächtigsten Verbündeten des Universums. Sie hat sich für eine Seite entschieden. Wie wir auch.",shape=box,color=blue];
		j1596838072 -> j2128760091;
	j2931180527 [label="PapaPolar: und ich wette, dein \"mann in der wand\" wusste das, und deshalb hat er sie sich überhaupt geschnappt",shape=box,color=blue];
		j2931180527 -> j1478024400;
	j2170348213 [label="PapaPolar: wir sind kleine fische für dieses ding. das sage ich auf die freundliche art und weise",shape=box,color=blue];
		j2170348213 -> j3212996034;
	j2128760091 [label="MomToxicated: Hoffentlich stehen wir uns nie mit gezogenen Waffen gegenüber. Und wenn doch? Dann werden wir uns damit auseinandersetzen.",shape=box,color=blue];
		j2128760091 -> j1479954150;
	j1478024400 [label="PapaPolar: nee. sie macht das schon. entweder ist sie schon lange tot, oder sie haben ein einvernehmliches abkommen, oder sie hält seinen arsch als geisel. lol",shape=box,color=blue];
		j1478024400 -> j3212996034;
	j3212996034 [label="MomToxicated: Nein, ich glaube, die Nachricht war echt. Und ich glaube, sie war von unserem kleinen Mädchen. Das uns sagt ... sie ist da draußen.",shape=box,color=blue];
		j3212996034 -> j2949232679;
	j1479954150 [label="PapaPolar: sie kann auf sich selbst aufpassen. so haben wir sie schließlich erzogen",shape=box,color=blue];
		j1479954150 -> j3212996034;
	j2949232679 [label="MomToxicated: Sie sagt uns, dass es ihr \"gut\" geht auf ihre eigene Art.",shape=box,color=blue];
		j2949232679 -> j1015232316;
	j1015232316 [label="MomToxicated: Und dass wir uns um sie keine Sorgen machen müssen.",shape=box,color=blue];
		j1015232316 -> j3397059119;
	j3397059119 [label="PapaPolar: heh. als ob wir das je könnten",shape=box,color=blue];
		j3397059119 -> j3762791493;
	j3762791493 [label="MomToxicated: Fluch und Segen, Eltern zu sein.",shape=box,color=blue];
		j3762791493 -> j1629731417;
	j1629731417 [label="PapaPolar: möchtest du irgendwann kinder, drifter? äääh, antworte nicht. wahrscheinlich irgendein void-wahnsinn, von dem ich nichts wissen will.",shape=box,color=blue];
		j1629731417 -> j2296335205;
		j1629731417 -> j577838533;
		j1629731417 -> j2988224244;
	j2296335205 [label="Was zu trinken? Lasst und was trinken.",shape=box,color=red];
