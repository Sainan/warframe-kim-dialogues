		j2813390637 -> j3675821034;
	j3675821034 [label="PapaPolar: ich würde gerne ein paar trinken und ein paar schöne geschichten über unser kleines mädchen erzählen",shape=box,color=blue];
		j3675821034 -> j910029202;
	j1720479496 [label="PapaPolar: endlich was vernünftiges",shape=box,color=blue];
		j1720479496 -> j3675821034;
	j910029202 [label="MomToxicated: Und ... Drifter? Danke. Nochmals. Für alles, was du tust.",shape=box,color=blue];
		j910029202 -> j1017995501;
	j1017995501 [label="PapaPolar: ja. im ernst, kleiner freund. keine ahnung, wie wir es dir jemals zurückzahlen können. aber wenn sich die chance ergibt? werden wir da sein.",shape=box,color=blue];
		j1017995501 -> j3213763890;
	j3213763890 [label="PapaPolar: du gehörst jetzt zur familie, ob es dir gefällt oder nicht. 8-)",shape=box,color=blue];
