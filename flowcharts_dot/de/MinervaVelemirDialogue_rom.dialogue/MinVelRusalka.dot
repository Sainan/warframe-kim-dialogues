		j4107887740 -> j2813390637;
	j2063881632 [label="PapaPolar: naja, es ist kein glückliches lächeln. es ist ein melancholisch-glückliches lächeln? aber",shape=box,color=blue];
		j2063881632 -> j3675821034;
	j3514570026 [label="MomToxicated: Das ist eine berechtigte Antwort, dem stimme ich zu. Heh. Was haltet ihr beide von ein paar Drinks?",shape=box,color=blue];
		j3514570026 -> j1720479496;
