	j204763574 [label="Denn falls das hier jemand liest: Es war KAYA VELASCO, die es herausgefunden hat.",shape=box,color=blue];
		j204763574 -> j4026571219;
	j3967772520 [label="Und wenn ich rauskäme, wäre das fast fies. Es wäre für jeden zu gefährlich mir zu folgen.",shape=box,color=blue];
		j3967772520 -> j132618571;
	j4026571219 [label="Wenn du nach meinem Namen suchst, wirst du zwei Dinge finden: Dass ich es GELÖST habe und dass ich das Jahr 1999 verlassen habe.",shape=box,color=blue];
