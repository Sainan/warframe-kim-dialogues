		430 -> 433;
	433 [label="Krass, oder? Mega eklig. Aber dann habe ich nachgeschaut. Es war ein Plastikbehälter, den er im Kuchen versteckt hatte, gefüllt mit versiegelten Jinymon-Karten. Meine absolute Lieblingssache.",shape=box,color=blue];
		433 -> 434;
	434 [label="Aber ein Mädchen wie ich würde sich in der Schule nie mit so etwas erwischen lassen. Aber offensichtlich hat dieser schüchterne Junge erkannt, wie ich wirklich bin. Er hat mir heimlich das echte Geschenk zugesteckt, ließ es aber so aussehen, als wollte er bloß meine Aufmerksamkeit mit einem großen Kuchen oder so, keine Ahnung.",shape=box,color=blue];
