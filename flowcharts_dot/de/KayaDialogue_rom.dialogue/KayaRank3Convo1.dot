		426 -> 430;
	432 [label="Ich hatte gute Noten. Mehr als gut sogar. Und war Kapitänin der Cheerleader. Es war eine große Sache, zu meiner Geburtstagsparty eingeladen zu werden.",shape=box,color=blue];
