digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank5Convo3 begins." [color=orange];
		"KayaRank5Convo3 begins." -> j3621004736;
	j3621004736 [label="Ohhh, hallo, kann ich dir freundlicherweise eine Einführung in JINYMON-KARTEN geben?",shape=box,color=blue];
		j3621004736 -> j408453061;
	j408453061 [label="Amir ist natürlich begeistert, dass er endlich jemanden hat, mit dem er spielen (und gegen den er verlieren) kann.",shape=box,color=blue];
		j408453061 -> j922721535;
	j922721535 [label="Aber wir beide dachten, dass es toll wäre dir auch Jinymon beizubringen. ",shape=box,color=blue];
		j922721535 -> j3655146728;
		j922721535 -> j2313491743;
		j922721535 -> j2342927799;
	j3655146728 [label="Spielt ihr beiden mal. Ich bin beschäftigt. [Ende.]",shape=box,color=red];
		j3655146728 -> j145506587;
	j2313491743 [label="Mir brennen ein paar Höllar in der Tasche, wo fangen wir an?",shape=box,color=red];
		j2313491743 -> j3523851324;
	j2342927799 [label="Hilf mir auf die Sprünge ... worüber reden wir?",shape=box,color=red];
		j2342927799 -> j139357058;
	j145506587 [label="+20 Chemistry",color=orange];
		j145506587 -> "Chat ends. Next chat will be KayaRank5Convo4.";
	j3523851324 [label="Oooookay, ja! Also, konzentrieren wir uns zunächst auf dich. Siehst du dich selbst eher als Drache, Adler oder Panther?",shape=box,color=blue];
		j3523851324 -> j875705615;
		j3523851324 -> j3063797311;
		j3523851324 -> j3713666608;
	j139357058 [label="Es ist einfach DIE beliebteste Show, das beliebteste Spiel und die beliebtesten Sammelkarten des Jahres 1999!",shape=box,color=blue];
		j139357058 -> j2173515803;
	"Chat ends. Next chat will be KayaRank5Convo4." [color=orange];
	j875705615 [label="Als Panther.",shape=box,color=red];
		j875705615 -> j3240623080;
	j3063797311 [label="Als Adler.",shape=box,color=red];
		j3063797311 -> j3059923539;
	j3713666608 [label="Als Drache.",shape=box,color=red];
		j3713666608 -> j3402654437;
	j2173515803 [label="Du weißt schon, supercoole Charaktere und Kreaturen ...",shape=box,color=blue];
		j2173515803 -> j2736522742;
	j3240623080 [label="O.K. dann würdest du das Spiel UNBEDINGT mit Tailala anfangen wollen.",shape=box,color=blue];
		j3240623080 -> j2946808597;
	j3059923539 [label="O.K. dann würdest du das Spiel DEFINITIV mit Plumebert anfangen wollen.",shape=box,color=blue];
		j3059923539 -> j3915800502;
	j3402654437 [label="O.K. dann würdest du das Spiel WAHRSCHEINLICH mit Frogobogo anfangen wollen.",shape=box,color=blue];
		j3402654437 -> j1210130193;
	j2736522742 [label="Das ist aber nicht der Punkt. Daher fangen wir mit dir an. Siehst du dich selbst eher als Drache, Adler oder Panther?",shape=box,color=blue];
		j2736522742 -> j875705615;
		j2736522742 -> j3063797311;
		j2736522742 -> j3713666608;
	j2946808597 [label="Das ist so ziemlich die coolste Option, aber auf jeden Fall schwierig und fängt wirklich schwach an.",shape=box,color=blue];
		j2946808597 -> j2363716431;
	j3915800502 [label="Das ist etwas fortgeschritten, aber wirklich cool.",shape=box,color=blue];
		j3915800502 -> j3636009172;
	j1210130193 [label="Das ist eine großartige Wahl für Anfänger.",shape=box,color=blue];
		j1210130193 -> j2280079993;
	j2363716431 [label="Aber am Ende? Der prächtigste und majestätischste Panther gehört praktisch dir.",shape=box,color=blue];
		j2363716431 -> j4047411982;
	j3636009172 [label="Und Plumebert ist supersüß, weil du ihn mit Sprudeltrauben füttern kannst, um schneller als alle anderen ein Level aufzusteigen.",shape=box,color=blue];
		j3636009172 -> j3853835432;
	j2280079993 [label="Und natürlich fängst du im Grunde mit dem süßesten Frosch aller Zeiten an, aber wenn du schließlich genügend Schlachten gewinnst ...",shape=box,color=blue];
		j2280079993 -> j2690628168;
	j4047411982 [label="Eine absolut erstklassige Wahl.",shape=box,color=blue];
		j4047411982 -> j966789177;
	j3853835432 [label="Wodurch du ein ganzes Erntesystem freischaltest.",shape=box,color=blue];
		j3853835432 -> j966789177;
	j2690628168 [label="Kannst du Frogobogo in einen DRACHEN verwandeln.",shape=box,color=blue];
		j2690628168 -> j966789177;
	j966789177 [label="Was genau ist das für ein Spiel ...",shape=box,color=red];
		j966789177 -> j2387213338;
	j2387213338 [label="Also gut, du sammelst Jinymons und die kämpfen für dich und du kannst Abenteuer erleben.",shape=box,color=blue];
		j2387213338 -> j1650370727;
	j1650370727 [label="Aber das ist nur in der Videospielversion so. In der Kartenspielversion ist es so, als würdest DU im wirklichen Leben Kämpfe gegen jemand anderen austragen.",shape=box,color=blue];
		j1650370727 -> j4180970587;
	j4180970587 [label="Es ist aber alles dieselbe Idee. Jinymon, Jinymon, Jinymon.",shape=box,color=blue];
		j4180970587 -> j2599494144;
	j2599494144 [label="Also, bereit für dein erstes Spiel?",shape=box,color=blue];
		j2599494144 -> j2129817040;
		j2599494144 -> j2705249024;
		j2599494144 -> j2249675176;
		j2599494144 -> j490475662;
	j2129817040 [label="Auf keinen Fall. [Ende.]",shape=box,color=red];
		j2129817040 -> j145506587;
	j2705249024 [label="Klar, warum nicht, Anfängerglück wird auf meiner Seite sein.",shape=box,color=red];
		j2705249024 -> j2145735565;
	j2249675176 [label="Du willst einfach nur einen leichten Sieg. Ohne mich.",shape=box,color=red];
		j2249675176 -> j3270768664;
	j490475662 [label="Nein, ich bin jetzt noch mehr verwirrt. Du hast nichts erklärt!",shape=box,color=red];
		j490475662 -> j3270768664;
	j2145735565 [label="Großartig ... du musst lediglich etwa 10.000 Höllar für dein eigenes Starterpaket berappen ...",shape=box,color=blue];
		j2145735565 -> j478406471;
		j2145735565 -> j1028277923;
	j3270768664 [label="Ach komm schon ... ich werde es dir leicht machen. Amir kann dir sogar helfen! ",shape=box,color=blue];
		j3270768664 -> j1298070619;
	j478406471 [label="Wenn du das sagst ...",shape=box,color=red];
		j478406471 -> j2628999325;
	j1028277923 [label="Was zum! So viel Geld habe ich nicht.",shape=box,color=red];
		j1028277923 -> j2628999325;
	j1298070619 [label="Und wenn du gewinnst, schenke ich dir eine ungeöffnete Jinymon-Packung!",shape=box,color=blue];
		j1298070619 -> j1903136354;
		j1298070619 -> j4203201915;
		j1298070619 -> j1773723499;
	j2628999325 [label="Kein Problem, gib einfach deine Bankdaten hier ein ...",shape=box,color=blue];
		j2628999325 -> j2023353922;
		j2628999325 -> j3401477312;
	j1903136354 [label="Na gut. Aber nur, wenn Amir mir hilft.",shape=box,color=red];
		j1903136354 -> j2145735565;
	j4203201915 [label="Ein anderes mal, o.k.?",shape=box,color=red];
		j4203201915 -> j1681325311;
	j1773723499 [label="Nein Danke!",shape=box,color=red];
		j1773723499 -> j1681325311;
	j2023353922 [label="Darauf falle ich nicht rein!",shape=box,color=red];
		j2023353922 -> j1089833830;
	j3401477312 [label="Alles klar, 4 ..1",shape=box,color=red];
		j3401477312 -> j639405311;
	j1681325311 [label="Eben nicht.",shape=box,color=blue];
		j1681325311 -> j145506587;
	j1089833830 [label="Herzlichen Glückwunsch, du hast den K.O.L.-Sicherheitstest bestanden.",shape=box,color=blue];
		j1089833830 -> j3604211634;
	j639405311 [label="OMG, NEIN! Das war ein Test. Du darfst deine Bankdaten NICHT bei den K.O.L.-Internetdiensten angeben!",shape=box,color=blue];
		j639405311 -> j2851291270;
	j3604211634 [label="OmG, Amir war sich so sicher, dass du darauf hereinfallen würdest.",shape=box,color=blue];
		j3604211634 -> j2640300150;
	j2851291270 [label="Ach, verdammt! Ich schulde Amir ein Spiel. Er sagte, du würdest darauf hereinfallen.",shape=box,color=blue];
		j2851291270 -> j145506587;
	j2640300150 [label="Also, wir werden später spielen.",shape=box,color=blue];
		j2640300150 -> j145506587;
}