digraph {
	887 [label="KayaRank5Convo3 begins.",color=orange];
		887 -> 888;
	888 [label="Ohhh, hallo, kann ich dir freundlicherweise eine Einführung in JINYMON-KARTEN geben?",shape=box,color=blue];
		888 -> 889;
	889 [label="Amir ist natürlich begeistert, dass er endlich jemanden hat, mit dem er spielen (und gegen den er verlieren) kann.",shape=box,color=blue];
		889 -> 890;
	890 [label="Aber wir beide dachten, dass es toll wäre dir auch Jinymon beizubringen. ",shape=box,color=blue];
		890 -> 891;
		890 -> 892;
		890 -> 893;
	891 [label="Spielt ihr beiden mal. Ich bin beschäftigt. [Ende.]",shape=box,color=red];
		891 -> 894;
	892 [label="Mir brennen ein paar Höllar in der Tasche, wo fangen wir an?",shape=box,color=red];
		892 -> 895;
	893 [label="Hilf mir auf die Sprünge ... worüber reden wir?",shape=box,color=red];
		893 -> 896;
	894 [label="+20 Chemistry",color=orange];
		894 -> 897;
	895 [label="Oooookay, ja! Also, konzentrieren wir uns zunächst auf dich. Siehst du dich selbst eher als Drache, Adler oder Panther?",shape=box,color=blue];
		895 -> 898;
		895 -> 899;
		895 -> 900;
	896 [label="Es ist einfach DIE beliebteste Show, das beliebteste Spiel und die beliebtesten Sammelkarten des Jahres 1999!",shape=box,color=blue];
		896 -> 901;
	897 [label="Chat ends. Next chat will be KayaRank5Convo4.",color=orange];
	898 [label="Als Panther.",shape=box,color=red];
		898 -> 902;
	899 [label="Als Adler.",shape=box,color=red];
		899 -> 903;
	900 [label="Als Drache.",shape=box,color=red];
		900 -> 904;
	901 [label="Du weißt schon, supercoole Charaktere und Kreaturen ...",shape=box,color=blue];
		901 -> 905;
	902 [label="O.K. dann würdest du das Spiel UNBEDINGT mit Tailala anfangen wollen.",shape=box,color=blue];
		902 -> 906;
	903 [label="O.K. dann würdest du das Spiel DEFINITIV mit Plumebert anfangen wollen.",shape=box,color=blue];
		903 -> 907;
	904 [label="O.K. dann würdest du das Spiel WAHRSCHEINLICH mit Frogobogo anfangen wollen.",shape=box,color=blue];
		904 -> 908;
	905 [label="Das ist aber nicht der Punkt. Daher fangen wir mit dir an. Siehst du dich selbst eher als Drache, Adler oder Panther?",shape=box,color=blue];
		905 -> 898;
		905 -> 899;
		905 -> 900;
	906 [label="Das ist so ziemlich die coolste Option, aber auf jeden Fall schwierig und fängt wirklich schwach an.",shape=box,color=blue];
		906 -> 909;
	907 [label="Das ist etwas fortgeschritten, aber wirklich cool.",shape=box,color=blue];
		907 -> 910;
	908 [label="Das ist eine großartige Wahl für Anfänger.",shape=box,color=blue];
		908 -> 911;
	909 [label="Aber am Ende? Der prächtigste und majestätischste Panther gehört praktisch dir.",shape=box,color=blue];
		909 -> 912;
	910 [label="Und Plumebert ist supersüß, weil du ihn mit Sprudeltrauben füttern kannst, um schneller als alle anderen ein Level aufzusteigen.",shape=box,color=blue];
		910 -> 913;
	911 [label="Und natürlich fängst du im Grunde mit dem süßesten Frosch aller Zeiten an, aber wenn du schließlich genügend Schlachten gewinnst ...",shape=box,color=blue];
		911 -> 914;
	912 [label="Eine absolut erstklassige Wahl.",shape=box,color=blue];
		912 -> 915;
	913 [label="Wodurch du ein ganzes Erntesystem freischaltest.",shape=box,color=blue];
		913 -> 915;
	914 [label="Kannst du Frogobogo in einen DRACHEN verwandeln.",shape=box,color=blue];
		914 -> 915;
	915 [label="Was genau ist das für ein Spiel ...",shape=box,color=red];
		915 -> 916;
	916 [label="Also gut, du sammelst Jinymons und die kämpfen für dich und du kannst Abenteuer erleben.",shape=box,color=blue];
		916 -> 917;
	917 [label="Aber das ist nur in der Videospielversion so. In der Kartenspielversion ist es so, als würdest DU im wirklichen Leben Kämpfe gegen jemand anderen austragen.",shape=box,color=blue];
		917 -> 918;
	918 [label="Es ist aber alles dieselbe Idee. Jinymon, Jinymon, Jinymon.",shape=box,color=blue];
		918 -> 919;
	919 [label="Also, bereit für dein erstes Spiel?",shape=box,color=blue];
		919 -> 920;
		919 -> 921;
		919 -> 922;
		919 -> 923;
	920 [label="Auf keinen Fall. [Ende.]",shape=box,color=red];
		920 -> 924;
	921 [label="Klar, warum nicht, Anfängerglück wird auf meiner Seite sein.",shape=box,color=red];
		921 -> 925;
	922 [label="Du willst einfach nur einen leichten Sieg. Ohne mich.",shape=box,color=red];
		922 -> 926;
	923 [label="Nein, ich bin jetzt noch mehr verwirrt. Du hast nichts erklärt!",shape=box,color=red];
		923 -> 926;
	924 [label="+20 Chemistry",color=orange];
		924 -> 927;
	925 [label="Großartig ... du musst lediglich etwa 10.000 Höllar für dein eigenes Starterpaket berappen ...",shape=box,color=blue];
		925 -> 928;
		925 -> 929;
	926 [label="Ach komm schon ... ich werde es dir leicht machen. Amir kann dir sogar helfen! ",shape=box,color=blue];
		926 -> 930;
	927 [label="Chat ends. Next chat will be KayaRank5Convo4.",color=orange];
	928 [label="Wenn du das sagst ...",shape=box,color=red];
		928 -> 931;
	929 [label="Was zum! So viel Geld habe ich nicht.",shape=box,color=red];
		929 -> 931;
	930 [label="Und wenn du gewinnst, schenke ich dir eine ungeöffnete Jinymon-Packung!",shape=box,color=blue];
		930 -> 932;
		930 -> 933;
		930 -> 934;
	931 [label="Kein Problem, gib einfach deine Bankdaten hier ein ...",shape=box,color=blue];
		931 -> 935;
