		j2395333576 -> j1211137507;
	j947857697 [label="Japp! Natürlich gibt es ein paar Vorbehalte. Der sicherste Weg ist, GENAU in das wann zu gehen, aus dem du hergekommen bist, denn dort gibt es so etwas wie einen \n'Void-Fingerabdruck'.",shape=box,color=blue];
