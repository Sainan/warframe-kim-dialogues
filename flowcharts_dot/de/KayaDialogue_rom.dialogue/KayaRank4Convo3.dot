	j587368570 [label="Ähm, bist du verrückt? Nicht abartig. TROTZDEM!",shape=box,color=blue];
		j587368570 -> j1242827405;
	j122124369 [label="Es gibt keine Nachteile. Entweder, ich finde es heraus, oder nicht. Wir sehen uns hier oder wir sehen uns dort. Richtig? Bis dann!",shape=box,color=blue];
		j122124369 -> j465934596;
