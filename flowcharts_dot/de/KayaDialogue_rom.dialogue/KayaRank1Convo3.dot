	"KayaRank1Convo3 begins." [color=orange];
		"KayaRank1Convo3 begins." -> j1235958463;
	j1235958463 [label="Zeitreisen – sind die teuer? Sind sie mit Rohstoffkosten verbunden? Oder wurden sie in deiner Zeit in einer Weise kommerzialisiert, die hier relevant ist?",shape=box,color=blue];
		j1235958463 -> j2523960306;
		j1235958463 -> j2298686353;
	j2523960306 [label="Warum? Willst du ein paar Höllar ansparen und mich bestechen?",shape=box,color=red];
		j2523960306 -> j3115564125;
	j2298686353 [label="Manche Kosten haben keinen Preis in Währung. Und hallo, übrigens. ",shape=box,color=red];
		j2298686353 -> j1878544139;
	j3115564125 [label="Bei Entrati hat es funktioniert.",shape=box,color=blue];
		j3115564125 -> j3770420036;
		j3115564125 -> j4262111461;
	j1878544139 [label="Hallo. Es ist also nicht so, dass ich einfach jemanden dafür bezahlen kann, um zu lernen, wie es geht?",shape=box,color=blue];
		j1878544139 -> j2555358642;
		j1878544139 -> j3413780840;
		j1878544139 -> j3358418651;
	j3770420036 [label="Wie bitte?",shape=box,color=red];
		j3770420036 -> j1310704431;
	j4262111461 [label="Wie?",shape=box,color=red];
		j4262111461 -> j1310704431;
	j2555358642 [label="Dir ist klar, dass deine Serie, 'Nova', nichts mit Zeitreisen zu tun hat, oder?",shape=box,color=red];
		j2555358642 -> j389248088;
	j3413780840 [label="Hör mal, du scheinst dich wirklich nur für eine Sache zu interessieren: Zeitreisen. Warum?",shape=box,color=red];
		j3413780840 -> j1132767882;
	j3358418651 [label="Nein, kannst du nicht. [Ende].",shape=box,color=red];
		j3358418651 -> j3994434447;
	j1310704431 [label="Check boolean KayaSetFound",color=orange];
		j1310704431 -> j730778934 [label=true,color=green];
		j1310704431 -> j2000354650 [label=false,color=brown];
	j389248088 [label="Was Nova kann und was nicht, spielt keine Rolle.",shape=box,color=blue];
		j389248088 -> j2647674648;
	j1132767882 [label="Du würdest es nicht verstehen.",shape=box,color=blue];
		j1132767882 -> j2875260249;
		j1132767882 -> j3022558220;
	j3994434447 [label="+20 Chemistry",color=orange];
		j3994434447 -> "Chat ends. Next chat will be KayaRank2Convo1.";
	j730778934 [label="Äh, das habe ich dir doch gesagt. Ich habe ihn gefunden.",shape=box,color=blue];
		j730778934 -> j1470583778;
	j2000354650 [label="Und stell dir vor.",shape=box,color=blue];
		j2000354650 -> j1055327943;
	j2647674648 [label="Check boolean KayaAmirTravel",color=orange];
		j2647674648 -> j3824597733 [label=true,color=green];
		j2647674648 -> j368315635 [label=false,color=brown];
	j2875260249 [label="Du kennst mich nicht. Oh warte, das ist dein Spruch, nicht?",shape=box,color=red];
		j2875260249 -> j2020005469;
	j3022558220 [label="Ich verspreche, ich werde.",shape=box,color=red];
		j3022558220 -> j2561746149;
	"Chat ends. Next chat will be KayaRank2Convo1." [color=orange];
	j1470583778 [label="+5 Chemistry",color=orange];
		j1470583778 -> j2000354650;
	j1055327943 [label="Er ist also an seinem Computer oder was auch immer.",shape=box,color=blue];
		j1055327943 -> j2595411966;
	j3824597733 [label="Nun, ich denke, wir versuchen, das Beste aus dem Gegebenen herauszuholen. Hast du Amir gefragt?",shape=box,color=red];
		j3824597733 -> j3299701708;
	j368315635 [label="Check boolean KayaLettieHeal",color=orange];
		j368315635 -> j1927341836 [label=true,color=green];
		j368315635 -> j342565261 [label=false,color=brown];
	j2020005469 [label="Richtig, ich kenne dich nicht. Ich weiß nur, was du kannst. Deshalb reden wir ja. Also, bleib bei der Sache.",shape=box,color=blue];
		j2020005469 -> j1459016630;
	j2561746149 [label="Ein Versprechen von einem Fremden im Internet. Mach mal Pause. Ha. Sag mir einfach, was ich wissen will.",shape=box,color=blue];
		j2561746149 -> j662803177;
	j2595411966 [label="Und ich tauche auf und er bekommt tatsächlich Angst. Als ob er NICHT damit gerechnet hätte, dass jemand auftaucht.",shape=box,color=blue];
		j2595411966 -> j4157702439;
		j2595411966 -> j2794500828;
	j3299701708 [label="Habe ich. Wir sind uns in einigen Grundprinzipien einig, aber er scheint nicht an einem konkreten und reproduzierbaren Zeitreisetheorem interessiert zu sein. ",shape=box,color=blue];
		j3299701708 -> j3549323323;
	j1927341836 [label="Nun, ich denke, wir versuchen, das Beste aus dem Gegebenen herauszuholen. Hast du mit Lettie gesprochen? Ich denke, ihr zwei würdet gut miteinander auskommen.",shape=box,color=red];
		j1927341836 -> j608600331;
	j342565261 [label="Richtig, ich meinte nur, dass es etwas einfacher wäre, wenn du auf mehr Werkzeuge aus meiner Zeit zugreifen könntest.",shape=box,color=red];
		j342565261 -> j3835790572;
	j1459016630 [label="Okay, bleiben wir bei der Sache.",shape=box,color=red];
		j1459016630 -> j3834046525;
		j1459016630 -> j4161238058;
	j662803177 [label="Ist mit dir etwas passiert?",shape=box,color=red];
		j662803177 -> j2856434928;
	j4157702439 [label="Wow, das ist beeindruckend.",shape=box,color=red];
		j4157702439 -> j1083248241;
	j2794500828 [label="Wow, prahlst du etwa?",shape=box,color=red];
		j2794500828 -> j1083248241;
	j3549323323 [label="Tatsächlich hat er mich davon überzeugt, dass einige meiner ursprünglichen Hypothesen falsch waren. Es war also hilfreich. Er mich aber auch daran erinnert, dass ich mir vielleicht einfach eine Antwort erkaufen kann oder zumindest dafür bezahlen kann, mit jemand anderem aus der Zukunft zu sprechen, wenn du mir nicht hilfst.",shape=box,color=blue];
		j3549323323 -> j3233584655;
		j3549323323 -> j4160346465;
	j608600331 [label="Wir verstehen uns. Sie erinnert mich an eine Lehrerin, die ich einmal hatte. Sie war nie gemein und hat meinen Verstand erkannt.",shape=box,color=blue];
		j608600331 -> j2815422473;
	j3835790572 [label="Ist das ein Angebot? Worauf kann ich zugreifen? Alles wäre hilfreich.",shape=box,color=blue];
		j3835790572 -> j1708557074;
	j3834046525 [label="Du willst Zeitreisen, aber wohin? Warum?",shape=box,color=red];
		j3834046525 -> j2301934036;
	j4161238058 [label="Hast du dich umgesehen?",shape=box,color=red];
		j4161238058 -> j2128207140;
	j2856434928 [label="Mit uns allen ist etwas passiert. Sag mir einfach Bescheid, wenn du weißt, wie du mir helfen kannst. ",shape=box,color=blue];
		j2856434928 -> j3994434447;
	j1083248241 [label="Uff, warum erzähle ich dir das erneut?",shape=box,color=blue];
		j1083248241 -> j373017021;
	j3233584655 [label="Für 10 Höllar sage ich dir, wie du sterben wirst.",shape=box,color=red];
		j3233584655 -> j879205241;
	j4160346465 [label="Jeder, der dir so etwas verkauft, lügt. Ich werde versuchen, dir zu helfen, wirklich. Kostenlos.",shape=box,color=red];
		j4160346465 -> j2189131198;
	j2815422473 [label="Sie ist eigentlich total entspannt. Und auch schlau. Allerdings hat sie mir gesagt, ich solle dir wirklich vertrauen, das wird sich also noch zeigen.",shape=box,color=blue];
		j2815422473 -> j3770088011;
		j2815422473 -> j2498579008;
	j1708557074 [label="Ich werde sehen, was ich für dich finden kann, wenn du es zu deinen Bedingungen herausfinden willst.",shape=box,color=red];
		j1708557074 -> j3967024959;
	j2301934036 [label="Kannst du IRGENDWAS herausfinden? Echt.",shape=box,color=blue];
		j2301934036 -> j2718147804;
	j2128207140 [label="Ja, das habe ich. Ich habe alles gesehen. Diese wunderbare Jahrtausendwende. Einladungen zu sooo vielen Partys, weil die Leute 'dieses Mädchen' dort haben wollten.",shape=box,color=blue];
		j2128207140 -> j3903710197;
	j373017021 [label="Sag mir einfach nur, ob ich sparen muss oder so?",shape=box,color=blue];
		j373017021 -> j473110902;
		j373017021 -> j751156356;
	j879205241 [label="Pfff, du Perverser.",shape=box,color=blue];
		j879205241 -> j3994434447;
	j2189131198 [label="Wird sich zeigen.",shape=box,color=blue];
		j2189131198 -> j3994434447;
	j3770088011 [label="Ich bin nicht hier, um dich zu hintergehen oder so, und ich bin kein Zeitreise-Lehrbuch.",shape=box,color=red];
		j3770088011 -> j456815235;
	j2498579008 [label="Ich verspreche dir, dass du mir vertrauen kannst. Ich verstehe überhaupt nicht, warum du so feindselig bist.",shape=box,color=red];
		j2498579008 -> j4227989317;
	j3967024959 [label="Will ich. Werde ich.",shape=box,color=blue];
		j3967024959 -> j3994434447;
	j2718147804 [label="Wer würde hier überhaupt bleiben wollen? Echt jetzt ...",shape=box,color=blue];
		j2718147804 -> j2320673735;
	j3903710197 [label="Es wird nie aufhören. Schau voraus. Finde mich, wenn du helfen kannst.",shape=box,color=blue];
		j3903710197 -> j3994434447;
	j473110902 [label="Kaya, ich glaube, du bist ein bisschen zu sehr darauf fixiert. Was ist, wenn du es nicht herausfindest?",shape=box,color=red];
		j473110902 -> j1667094300;
	j751156356 [label="Keine Ahnung. Ich bin die Auserrrrrwählte, Kaya. ",shape=box,color=red];
		j751156356 -> j4057709606;
	j456815235 [label="Ähm. O.K.",shape=box,color=blue];
		j456815235 -> j3994434447;
	j4227989317 [label="Ich habe meine Gründe.",shape=box,color=blue];
		j4227989317 -> j3994434447;
	j2320673735 [label="Ich werde es herausfinden, ich weiß, dass ich es kann, im Ernst. Tschüß.",shape=box,color=blue];
		j2320673735 -> j3994434447;
	j1667094300 [label="Werde ich aber.",shape=box,color=blue];
		j1667094300 -> j3994434447;
	j4057709606 [label="Ja, ein total auserwähltes ARSCHLOCH",shape=box,color=blue];
		j4057709606 -> j3994434447;
}