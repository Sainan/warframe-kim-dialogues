	j3749131174 [label="Und er ist immer noch da, obwohl ich weg bin. Im Void.",shape=box,color=red];
		j3749131174 -> j3433501444;
	j3433501444 [label="Und das System, in dem das andere Kind ist, ist ein Ort, an dem ich gewesen bin.",shape=box,color=red];
		j3433501444 -> j3093326484;
