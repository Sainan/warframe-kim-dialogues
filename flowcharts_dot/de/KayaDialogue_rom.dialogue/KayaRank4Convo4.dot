		j922809699 -> j3226782538;
	j3226782538 [label="Es ist wie ein großes, leuchtendes Void-Ausgang-Schild, wenn es darum geht, dass Partikel von ihrer nächsten Form angezogen werden.",shape=box,color=blue];
		j3226782538 -> j3819721535;
	j3819721535 [label="Entschuldigung, ähm, richtig, aber was ist 'Duviri'? Ein Materiezustand? ",shape=box,color=blue];
		j3819721535 -> j2704298481;
		j3819721535 -> j1744094990;
	j2704298481 [label="Es ist ein Ort, den ich im Void erschaffen habe.",shape=box,color=red];
		j2704298481 -> j846421903;
	j1744094990 [label="In vielerlei Hinsicht ist es mein wahres Zuhause. Wo ich ... aufgewachsen bin.",shape=box,color=red];
		j1744094990 -> j4037746708;
	j846421903 [label="Gefüllt mit Verkörperungen von Konzepten und Emotionen.",shape=box,color=red];
