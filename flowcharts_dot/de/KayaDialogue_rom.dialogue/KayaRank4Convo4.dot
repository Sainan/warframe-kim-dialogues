		j2099819776 -> j1670104903;
	j3635528588 [label="Würdest du? Es gibt eine wissenschaftliche Richtung, die davon ausgeht, dass die Beobachtung von Duviri der Schlüssel zu seiner Existenz ist.",shape=box,color=blue];
		j3635528588 -> j975293859;
