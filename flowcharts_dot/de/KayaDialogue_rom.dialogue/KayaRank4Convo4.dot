	j3035032695 [label="Ich denke, ich habe etwas, das dir helfen kann.",shape=box,color=red];
		j3035032695 -> j21793079;
	j21793079 [label="Ich kenne da einen Ort, von wo ich herkomme, eigentlich. Duviri.",shape=box,color=red];
