digraph {
	0 [label="KayaRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Hallo. Kann jeder Zeitreisen, oder nur du?",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="Auch dir einen schönen Tag. Hör zu, Kleines, so einfach ist das nicht.",shape=box,color=red];
		2 -> 4;
	3 [label="Hallo? Kaya? Wie läuft dein Tag.",shape=box,color=red];
		3 -> 5;
	4 [label="Ich bin kein Kleines. Ich bin 19.",shape=box,color=blue];
		4 -> 6;
		4 -> 7;
	5 [label="Schön.",shape=box,color=blue];
		5 -> 8;
	6 [label="Richtig. Aber die Jüngste dieser neuen Gruppe, Kleines, würde ich sagen.",shape=box,color=red];
		6 -> 9;
	7 [label="Ja, ja, aber überstürze nichts mit Zeitreisen. Es ist ... kompliziert.",shape=box,color=red];
		7 -> 10;
	8 [label="Also. Nur du? Gibt es noch andere? Wird in der Zukunft Zeitreisen in der Schule gelehrt?",shape=box,color=blue];
		8 -> 11;
	9 [label="Ähm. Die Jüngste, sicher, aber auch diejenige, die offensichtlich am meisten darauf aus ist, Antworten zu finden. Versuch, mitzuhalten. Also: Zeitreisen. Wie und wer?",shape=box,color=blue];
		9 -> 12;
	10 [label="Äh. Wie kompliziert? Formeln? Chemische und atomare Elemente? Ich werde es schon herausfinden, sag mir einfach die Richtung.",shape=box,color=blue];
		10 -> 13;
		10 -> 14;
	11 [label="Sagen wir, nur ich. Das macht es einfacher.",shape=box,color=red];
		11 -> 15;
	12 [label="Und warum gerade du? Hast du einen Plan? ",shape=box,color=blue];
		12 -> 16;
	13 [label="Ich weiß nicht wirklich, was ich dir sagen soll. Es ist nicht nur ein Bereich der Wissenschaft, und wenn doch, dann ist es eine Wissenschaft, die Entrati beherrscht.",shape=box,color=red];
		13 -> 17;
	14 [label="Hier ist eine Richtung: Stopp [Ende.]",shape=box,color=red];
		14 -> 1022;
	15 [label="Was das Unterrichten an Schulen betrifft, wenn ja, dann habe ich es nicht gelernt. Aber vielleicht wurde es? ",shape=box,color=red];
		15 -> 18;
	16 [label="Und wenn nicht, was kannst du empfehlen, damit ich wissenschaftliche Quellen zu deinen Fähigkeiten bekomme?",shape=box,color=blue];
		16 -> 19;
	17 [label="Uhm, dieser Bastard. Ich wusste, ich hätte ihm mehr Fragen stellen sollen. Ok. Wenn es wissenschaftlich ist, dann kann ich es zumindest reproduzieren, und da du kommen und gehen kannst, kann ich es herausfinden. Tschüß.",shape=box,color=blue];
		17 -> 20;
	1022 [label="+20 Chemistry",color=orange];
		1022 -> 1018;
	18 [label="Warum, willst du Hausaufgaben? Zeitreisen sind im Moment wahrscheinlich zu fortgeschritten ...",shape=box,color=red];
		18 -> 21;
	19 [label="So viele Fragen, Kleines. Ich hasse es, das zu gestehen, aber: Ich weiß es nicht. Nur Entrati hat die Antworten.",shape=box,color=red];
		19 -> 22;
	20 [label="+20 Chemistry",color=orange];
		20 -> 1015;
	1018 [label="{\"Id\":1018,\"Incoming\":[1022],\"Outgoing\":[1023],\"GraphPos\":[3236,718],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1018 -> 1023;
	21 [label="Öh, ist das dein Ernst?",shape=box,color=blue];
		21 -> 24;
	22 [label="Update boolean KayaSetKid",color=orange];
		22 -> 25;
	1015 [label="{\"Id\":1015,\"Incoming\":[20],\"Outgoing\":[23],\"GraphPos\":[3252,817],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1015 -> 23;
	1023 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	24 [label="Hat das irgendjemand von den Hex herausgefunden? Haben die irgendwelche Informationen? ",shape=box,color=blue];
		24 -> 26;
		24 -> 27;
	25 [label="O.K.",shape=box,color=blue];
		25 -> 28;
	23 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	26 [label="Vielleicht Amir? Er spielt wahrscheinlich Zeitreise-Spiele ...",shape=box,color=red];
		26 -> 29;
	27 [label="Glaube ich nicht, Kleines. Aber wenn du etwas Nützliches lernen willst, frag Lettie nach einer Einführung ins Heilen.",shape=box,color=red];
		27 -> 30;
	28 [label="+20 Chemistry",color=orange];
		28 -> 996;
	29 [label="Update boolean KayaAmirTravel",color=orange];
		29 -> 32;
	30 [label="Update boolean KayaLettieHeal",color=orange];
		30 -> 33;
	996 [label="{\"Id\":996,\"Incoming\":[28],\"Outgoing\":[31],\"GraphPos\":[4241,541],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		996 -> 31;
	32 [label="Spiele? Ich brauche nur Antworten, eine Richtung, irgendetwas. Ich werde es herausfinden. Wenn dir etwas HILFREICHES einfällt, sag bescheid.",shape=box,color=blue];
		32 -> 34;
	33 [label="Nicht mein Stil. Egal.",shape=box,color=blue];
		33 -> 35;
	31 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	34 [label="+20 Chemistry",color=orange];
		34 -> 998;
	35 [label="+20 Chemistry",color=orange];
		35 -> 997;
	998 [label="{\"Id\":998,\"Incoming\":[34],\"Outgoing\":[36],\"GraphPos\":[5087,255],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		998 -> 36;
	997 [label="{\"Id\":997,\"Incoming\":[35],\"Outgoing\":[37],\"GraphPos\":[4970,380],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		997 -> 37;
	36 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	37 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
}