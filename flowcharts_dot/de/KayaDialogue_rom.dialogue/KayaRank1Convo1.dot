digraph {
	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j2654669432;
	j2654669432 [label="Hallo. Kann jeder Zeitreisen, oder nur du?",shape=box,color=blue];
		j2654669432 -> j3915056661;
		j2654669432 -> j157557785;
	j3915056661 [label="Auch dir einen schönen Tag. Hör zu, Kleines, so einfach ist das nicht.",shape=box,color=red];
		j3915056661 -> j2342144027;
	j157557785 [label="Hallo? Kaya? Wie läuft dein Tag.",shape=box,color=red];
		j157557785 -> j209750861;
	j2342144027 [label="Ich bin kein Kleines. Ich bin 19.",shape=box,color=blue];
		j2342144027 -> j1301799241;
		j2342144027 -> j1912034235;
	j209750861 [label="Schön.",shape=box,color=blue];
		j209750861 -> j1974142480;
	j1301799241 [label="Richtig. Aber die Jüngste dieser neuen Gruppe, Kleines, würde ich sagen.",shape=box,color=red];
		j1301799241 -> j1628776600;
	j1912034235 [label="Ja, ja, aber überstürze nichts mit Zeitreisen. Es ist ... kompliziert.",shape=box,color=red];
		j1912034235 -> j2378705004;
	j1974142480 [label="Also. Nur du? Gibt es noch andere? Wird in der Zukunft Zeitreisen in der Schule gelehrt?",shape=box,color=blue];
		j1974142480 -> j760649758;
	j1628776600 [label="Ähm. Die Jüngste, sicher, aber auch diejenige, die offensichtlich am meisten darauf aus ist, Antworten zu finden. Versuch, mitzuhalten. Also: Zeitreisen. Wie und wer?",shape=box,color=blue];
		j1628776600 -> j3531373579;
	j2378705004 [label="Äh. Wie kompliziert? Formeln? Chemische und atomare Elemente? Ich werde es schon herausfinden, sag mir einfach die Richtung.",shape=box,color=blue];
		j2378705004 -> j3295521363;
		j2378705004 -> j865266527;
	j760649758 [label="Sagen wir, nur ich. Das macht es einfacher.",shape=box,color=red];
		j760649758 -> j178799436;
	j3531373579 [label="Und warum gerade du? Hast du einen Plan? ",shape=box,color=blue];
		j3531373579 -> j2749086672;
	j3295521363 [label="Ich weiß nicht wirklich, was ich dir sagen soll. Es ist nicht nur ein Bereich der Wissenschaft, und wenn doch, dann ist es eine Wissenschaft, die Entrati beherrscht.",shape=box,color=red];
		j3295521363 -> j2861394465;
	j865266527 [label="Hier ist eine Richtung: Stopp [Ende.]",shape=box,color=red];
		j865266527 -> "Chat ends.";
	j178799436 [label="Was das Unterrichten an Schulen betrifft, wenn ja, dann habe ich es nicht gelernt. Aber vielleicht wurde es? ",shape=box,color=red];
		j178799436 -> j3398089845;
	j2749086672 [label="Und wenn nicht, was kannst du empfehlen, damit ich wissenschaftliche Quellen zu deinen Fähigkeiten bekomme?",shape=box,color=blue];
		j2749086672 -> j3355488087;
	j2861394465 [label="Uhm, dieser Bastard. Ich wusste, ich hätte ihm mehr Fragen stellen sollen. Ok. Wenn es wissenschaftlich ist, dann kann ich es zumindest reproduzieren, und da du kommen und gehen kannst, kann ich es herausfinden. Tschüß.",shape=box,color=blue];
		j2861394465 -> j2547432773;
	"Chat ends." [color=orange];
	j3398089845 [label="Warum, willst du Hausaufgaben? Zeitreisen sind im Moment wahrscheinlich zu fortgeschritten ...",shape=box,color=red];
		j3398089845 -> j1518646448;
	j3355488087 [label="So viele Fragen, Kleines. Ich hasse es, das zu gestehen, aber: Ich weiß es nicht. Nur Entrati hat die Antworten.",shape=box,color=red];
		j3355488087 -> j208224960;
	j2547432773 [label="+20 Chemistry",color=orange];
		j2547432773 -> "Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue";
	j1518646448 [label="Öh, ist das dein Ernst?",shape=box,color=blue];
		j1518646448 -> j2553748087;
	j208224960 [label="Boolean KayaSetKid is now true.",color=orange];
		j208224960 -> j3789912129;
	"Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue" [label="Queue conversation HexKayaConvo1 in HexDialogue_rom.dialogue",color=orange];
		"Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue" -> "Chat ends. Next chat will be KayaRank1Convo2.";
	j2553748087 [label="Hat das irgendjemand von den Hex herausgefunden? Haben die irgendwelche Informationen? ",shape=box,color=blue];
		j2553748087 -> j2668994248;
		j2553748087 -> j2162629827;
	j3789912129 [label="O.K.",shape=box,color=blue];
		j3789912129 -> j2547432773;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j2668994248 [label="Vielleicht Amir? Er spielt wahrscheinlich Zeitreise-Spiele ...",shape=box,color=red];
		j2668994248 -> j1937353403;
	j2162629827 [label="Glaube ich nicht, Kleines. Aber wenn du etwas Nützliches lernen willst, frag Lettie nach einer Einführung ins Heilen.",shape=box,color=red];
		j2162629827 -> j2646685698;
	j1937353403 [label="Boolean KayaAmirTravel is now true.",color=orange];
		j1937353403 -> j1022423658;
	j2646685698 [label="Boolean KayaLettieHeal is now true.",color=orange];
		j2646685698 -> j462132669;
	j1022423658 [label="Spiele? Ich brauche nur Antworten, eine Richtung, irgendetwas. Ich werde es herausfinden. Wenn dir etwas HILFREICHES einfällt, sag bescheid.",shape=box,color=blue];
		j1022423658 -> j2547432773;
	j462132669 [label="Nicht mein Stil. Egal.",shape=box,color=blue];
		j462132669 -> j2547432773;
