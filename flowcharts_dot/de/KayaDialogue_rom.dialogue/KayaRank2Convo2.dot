		j3463263331 -> j1701918546;
	j2571292388 [label="Ich muss nicht bescheiden sein. Ich hatte die besten Zensuren in der Geschichte meiner Highschool UND in meinem ersten Jahr an der Universität hatte ich die besten Noten seit 100 Jahren.",shape=box,color=blue];
