		j377794171 -> j1852898757;
	j3218031384 [label="Ich war mehr als eine gute Studentin. Universitäten haben sich bei mir beworben, damit ich dort studiere. Mein erstes Jahr wäre perfekt gewesen ...",shape=box,color=blue];
