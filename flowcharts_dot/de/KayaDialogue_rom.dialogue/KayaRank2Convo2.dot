		j3947915548 -> j1469054132;
		j3947915548 -> j163684491;
	j1852898757 [label="Mhmm, sicher. Nun, ich konnte eine Formel für zeitliches Abfangen erstellen, das letztendlich zum Empfang von Schallwellen führte!",shape=box,color=blue];
