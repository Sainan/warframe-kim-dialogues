	"KayaRank5Convo1 begins." [color=orange];
		"KayaRank5Convo1 begins." -> j3046273952;
	j3046273952 [label="Ich finde immer wieder diese lilafarbenen Dinger, aber sie verschwinden sofort am nächsten Tag.",shape=box,color=blue];
		j3046273952 -> j343370710;
	j343370710 [label="Und ich denke, es hat irgendetwas auf sich mit ihrem Verfall.",shape=box,color=blue];
		j343370710 -> j257588192;
	j257588192 [label="Denn die Materie formt sich nicht einfach zu einem Zerfallszustand eines neuen Isotopes um.",shape=box,color=blue];
		j257588192 -> j3852613862;
	j3852613862 [label="Sie verschwindet tatsächlich von HIER.",shape=box,color=blue];
		j3852613862 -> j3647241500;
		j3852613862 -> j1191750190;
	j3647241500 [label="Meinst du Kryotik?",shape=box,color=red];
		j3647241500 -> j4095607788;
	j1191750190 [label="Meinst du Argon-Kristalle? ",shape=box,color=red];
		j1191750190 -> j2248086202;
	j4095607788 [label="Mmm, nee, nicht das.",shape=box,color=blue];
		j4095607788 -> j1191750190;
		j4095607788 -> j2816088643;
	j2248086202 [label="Das muss es sein!",shape=box,color=blue];
		j2248086202 -> j3734649325;
	j2816088643 [label="Meinst du Orokin Zellen?",shape=box,color=red];
		j2816088643 -> j1570991288;
	j3734649325 [label="Schaffst du es, sie zu behalten, wo du herkommst?",shape=box,color=blue];
		j3734649325 -> j360391329;
		j3734649325 -> j2761381417;
	j1570991288 [label="Mmm, nee, das definitiv auch nicht.",shape=box,color=blue];
		j1570991288 -> j4184981038;
		j1570991288 -> j1644649731;
	j360391329 [label="Sie verschwinden immer, sobald man sie aus dem Void bringt.",shape=box,color=red];
		j360391329 -> j1093757069;
	j2761381417 [label="Niemals, ich bin immer davon ausgegangen, dass sie einfach verfallen. ",shape=box,color=red];
		j2761381417 -> j1093757069;
	j4184981038 [label="Meinst du Rubedo?",shape=box,color=red];
		j4184981038 -> j1426238626;
	j1644649731 [label="Meinst du Argon-Kristalle?",shape=box,color=red];
		j1644649731 -> j2248086202;
	j1093757069 [label="Nun, das ist es – im Void sind sie inaktiv.",shape=box,color=blue];
		j1093757069 -> j1028010637;
	j1426238626 [label="Ich glaube nicht. Wenn wir es nicht herausfinden, werde ich es wahrscheinlich nie lösen.",shape=box,color=blue];
		j1426238626 -> j2826715694;
		j1426238626 -> j1644649731;
	j1028010637 [label="Und dann, wenn sie den Void verlassen, kehren sie immer zum Void zurück. Sie zerfallen nicht zu neuer Materie.",shape=box,color=blue];
		j1028010637 -> j2519882256;
	j2826715694 [label="Meinst du Nanosporen?",shape=box,color=red];
		j2826715694 -> j1594075841;
	j2519882256 [label="Sie kehren zurück in den Void. Der Void ist überall und holt sie zurück.",shape=box,color=blue];
		j2519882256 -> j221969447;
	j1594075841 [label="Oh nein, die letzte Probe, die ich hatte, ist weg. Ich ... äh. Ich muss los.",shape=box,color=blue];
		j1594075841 -> j228980182;
	j221969447 [label="Boolean KayaFutureWin2 is now true.",color=orange];
		j221969447 -> j1750174419;
		j221969447 -> j3537856896;
	j228980182 [label="Ich glaube nicht, dass ich das kann.",shape=box,color=blue];
		j228980182 -> j4123196853;
	j1750174419 [label="Bringt dich aus 1999 heraus? Hast du vor, dich im Void zu verstecken? Das würde ich nicht empfehlen.",shape=box,color=red];
		j1750174419 -> j2456529354;
	j3537856896 [label="Ist das für dein Ziel wichtig?",shape=box,color=red];
		j3537856896 -> j2812405983;
	j4123196853 [label="+20 Chemistry",color=orange];
		j4123196853 -> "Chat ends. Next chat will be KayaRank5Convo2.";
	j2456529354 [label="Es geht eher um die Zustände der Materie und die Theorie, dass der Void nicht 'linear' ist, unserem Verständnis nach, sodass ich ihn als Trampolin verwenden kann, um DIR effektiv zu folgen.",shape=box,color=blue];
		j2456529354 -> j2488625061;
	j2812405983 [label="Sehr, sehr, sehr! Es bedeutet, dass Materie eine Verbindung zwischen dem VOID und dem HIER hat. Atome, Materie, sie sind in beiden Bereichen KONSISTENT.",shape=box,color=blue];
		j2812405983 -> j4167060877;
	"Chat ends. Next chat will be KayaRank5Convo2." [color=orange];
	j2488625061 [label="Warte, mir folgen? ",shape=box,color=red];
		j2488625061 -> j3250674224;
	j4167060877 [label="Der Void ist nicht 'linear', unserem Verständnis nach, sodass ich ihn als Trampolin verwenden kann, um DIR effektiv zu folgen.",shape=box,color=blue];
		j4167060877 -> j2488625061;
	j3250674224 [label="Ja, egal, wie oft ich Tests oder Gleichungen durchführe, mir fehlt sozusagen ein 'Leuchtfeuer'. Der Trampolinsprung muss irgendwo landen, und wenn du auch nur einmal zurückgegangen bist, sollte das für die Kalibrierung ausreichen. ",shape=box,color=blue];
		j3250674224 -> j2736631925;
		j3250674224 -> j4064878805;
	j2736631925 [label="Ich hoffe, du kannst einen Rückwärtssalto machen! Leuchtfeuer ist im Anmarsch. ",shape=box,color=red];
		j2736631925 -> j2486666128;
	j4064878805 [label="Boah, ich weiß nicht, mir gefällt das nicht. Was, wenn du steckenbleibst oder verloren gehst?!",shape=box,color=red];
		j4064878805 -> j4219818376;
	j2486666128 [label="Natürlich bin ich noch nicht ganz fertig. Miss zweimal, schneide einmal. Miss ... 1000 Mal.",shape=box,color=blue];
		j2486666128 -> j1351695383;
		j2486666128 -> j3820353139;
	j4219818376 [label="Das werde ich nicht.",shape=box,color=blue];
		j4219818376 -> j3666808637;
	j1351695383 [label="Richtig so, Wissenschaft sollte mit Selbstvertrauen ausgeführt werden.",shape=box,color=red];
		j1351695383 -> j3922578303;
	j3820353139 [label="Versuchen wir es! Keine Zeit für Vorsicht, lass es uns jetzt tun!",shape=box,color=red];
		j3820353139 -> j4290221574;
	j3666808637 [label="Aber du könntest.",shape=box,color=red];
		j3666808637 -> j1402368077;
	j3922578303 [label="Du lernst von mir, wie ich sehe.",shape=box,color=blue];
		j3922578303 -> j1830767311;
		j3922578303 -> j27276979;
	j4290221574 [label="Ahh nein, nein, ich bin noch nicht soweit! Das sollte man nicht überstürzen!",shape=box,color=blue];
		j4290221574 -> j915005283;
	j1402368077 [label="Nein.",shape=box,color=blue];
		j1402368077 -> j551999974;
		j1402368077 -> j2808986517;
	j1830767311 [label="Träum weiter! ",shape=box,color=red];
		j1830767311 -> j4123196853;
	j27276979 [label="Oh sicher, du bist eine tolle Lehrerin. Obwohl ich glaube, das Einzige, was du getan hast bisher, war es, Minerva neue Trinkspiele beizubringen.",shape=box,color=red];
		j27276979 -> j1542801052;
	j915005283 [label="Na guuuut, dir scheint immer noch bewusst zu sein, wie gefährlich das sein könnte. Sehr gut.",shape=box,color=red];
		j915005283 -> j4054468883;
	j551999974 [label="Seufz ...",shape=box,color=red];
		j551999974 -> j2965515959;
	j2808986517 [label="Aber ... du könntest.",shape=box,color=red];
		j2808986517 -> j2965515959;
	j1542801052 [label="Eine verkaterte Minerva ist allerdings viel gefährlicher als Zeitreisen. RENN!",shape=box,color=blue];
