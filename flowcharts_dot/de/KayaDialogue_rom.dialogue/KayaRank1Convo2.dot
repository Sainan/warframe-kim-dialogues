	41 [label="Gleich auf den Punkt, okay. Nein, das 'Internet' hat es nicht bis zu meiner Zeit geschafft, also kann es nicht erforderlich sein. Oder vielleicht doch. ",shape=box,color=red];
		41 -> 43;
