digraph {
	38 [label="KayaRank1Convo2 begins.",color=orange];
		38 -> 39;
	39 [label="Hallo. Warum würde Entratis zeitübergreifende Einrichtung eine scheinbar aktive Verbindung zum Kinemantik-Online-Netzwerk beinhalten?",shape=box,color=blue];
