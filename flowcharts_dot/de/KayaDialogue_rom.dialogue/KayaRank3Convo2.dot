	472 [label="Obwohl, so hat es angefangen.",shape=box,color=red];
		472 -> 473;
	473 [label="Aber das alles jetzt? Ist jenseits dessen. Es ist, weil Albrecht irgendwo hingegangen ist, etwas aufgeweckt hat und es ihm zurückgefolgt ist. Der Void.",shape=box,color=red];
		473 -> 474;
		473 -> 475;
	474 [label="Der Void ist lebendig, aber auch nicht. Er ist und er ist nicht. Er ist ein Paradox, weil er Ursache und Grund für alles ist, was jedem Einzelnen von uns widerfahren ist.",shape=box,color=red];
		474 -> 476;
	475 [label="Es gibt weder ein 'Periodensystem' noch eine Formel dafür.",shape=box,color=red];
