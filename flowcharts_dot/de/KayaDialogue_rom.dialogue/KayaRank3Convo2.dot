	494 [label="Ich denke daher, ich vertraue dem Void mehr als anderen Menschen.",shape=box,color=blue];
		494 -> 497;
		494 -> 498;
		494 -> 499;
	495 [label="Keine Magie. Nur ... Void. Der Void. Eine Energie von irgendwo anders.",shape=box,color=red];
		495 -> 500;
