	481 [label="+5 Chemistry",color=orange];
		481 -> 485;
	482 [label="Es war das ALLERERSTE, was jemals im Internet verschickt wurde. Die erste Nachricht. Vom Erfinder des Internets, um zu zeigen, dass es 'funktionierte'.",shape=box,color=blue];
		482 -> 486;
	484 [label="Ich habe dir gesagt, du musst mit dem Void vorsichtig sein. Und zwar aus diesem Grund.",shape=box,color=red];
		484 -> 488;
	483 [label="Was, wenn nicht?",shape=box,color=red];
		483 -> 487;
	485 [label="Ha! Schön wär's, oh mein Gott. Aber kennst du 'Hallo Welt'?",shape=box,color=blue];
		485 -> 482;
	486 [label="Und von da an brach die Hölle los. Leute verloren VERDAMMT noch mal den Verstand. Wissenschaft. Bankwesen. Technologie. Unterhaltung.",shape=box,color=blue];
		486 -> 489;
	488 [label="Manche Dinge folgen keinen Regeln.",shape=box,color=red];
