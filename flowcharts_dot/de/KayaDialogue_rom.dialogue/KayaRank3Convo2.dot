	487 [label="Was, wenn alles, von dem du glaubst, es folgt Regeln ...",shape=box,color=red];
		487 -> 490;
	489 [label="Und durch Milliarden von Entscheidungen und Ursachen und Wirkungen kam es dazu, dass ich eines Tages online ging und ...",shape=box,color=blue];
		489 -> 492;
	491 [label="Manches kann man nicht erklären.",shape=box,color=red];
		491 -> 493;
	490 [label="nur passiert, weil etwas da draußen es so wollte.",shape=box,color=red];
		490 -> 493;
	492 [label="Und es war das Ende von Nova, oder vielmehr Kaya. Ihrer Zukunft, ihrer Karriere, ihrer Freunde, von allem. Wegen eines Fehlers.",shape=box,color=blue];
		492 -> 494;
	493 [label="Du behauptest also, dass der fehlende Teil meiner Experimente, Tests, Forschungen und Hypothesen 'Magie' ist.",shape=box,color=blue];
		493 -> 495;
