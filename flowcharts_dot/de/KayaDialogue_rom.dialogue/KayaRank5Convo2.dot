		847 -> 853;
	842 [label="Chat ends. Next chat will be KayaRank5Convo3.",color=orange];
	843 [label="Hätte ich Zylo bei mir ... wäre das alles viel einfacher.",shape=box,color=blue];
		843 -> 848;
	849 [label="Und nicht NUR mir. Uns allen. Und Loid, Gomaitru ... es ist widerlich. Ich weiß nicht, ob ich mich zurückhalten kann, wenn ich ihn sehe.",shape=box,color=red];
		849 -> 851;
	850 [label="Ballas verkörpert alles, wovor ich Angst habe. Er ist das Schlimmste, was das Leben zu bieten hat.",shape=box,color=red];
		850 -> 851;
	851 [label="Betrachtet man es aus dieser Sicht ... schätze ich, das Leben und Menschen sind manchmal einfach beschissen, oder?",shape=box,color=blue];
		851 -> 855;
	852 [label="Wo ich herkomme, haben wir auch noch große Kubrows!",shape=box,color=red];
