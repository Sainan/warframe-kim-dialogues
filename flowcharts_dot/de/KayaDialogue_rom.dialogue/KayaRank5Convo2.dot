		833 -> 839;
	834 [label="Das ich mich selbst aufgegeben habe.",shape=box,color=red];
		834 -> 840;
	835 [label="Obwohl das normalerweise eine dieser Internetfragen von Hackern ist, also erzähl das niemandem.",shape=box,color=blue];
		835 -> 841;
	829 [label="Mein Beileid. Wir hören am besten hier auf. [Ende.]",shape=box,color=red];
