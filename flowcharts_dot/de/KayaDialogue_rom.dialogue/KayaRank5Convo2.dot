	836 [label="+20 Chemistry",color=orange];
		836 -> 842;
	837 [label="Eigentlich ist es irgendwie unfair. Entrati darf mit seiner Freak-Katze durch die Zeit reisen?",shape=box,color=blue];
		837 -> 843;
	844 [label="Ich weiß, er glaubt, er lehrt mich etwas, aber diesem Arschloch ist nicht einmal klar, was er mir angetan hat.",shape=box,color=red];
		844 -> 849;
	845 [label="Aber ich weiß, wenn ich auch nur eine Minute schneller gewesen wäre, hätte jemand weniger gelitten.",shape=box,color=red];
