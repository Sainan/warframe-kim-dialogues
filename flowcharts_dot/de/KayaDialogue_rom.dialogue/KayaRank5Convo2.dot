	860 [label="Mein Zylo hat mich um jeden Preis beschützt.",shape=box,color=blue];
		860 -> 848;
	858 [label="Aber ich kam von meinem ersten Schultag in der ersten Klasse nach Hause und Zylo war da.",shape=box,color=blue];
