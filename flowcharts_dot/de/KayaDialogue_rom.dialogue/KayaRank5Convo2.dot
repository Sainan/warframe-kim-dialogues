	853 [label="Ähm, ich weiß nicht, Herr Volkov ist ziemlich zäh.",shape=box,color=red];
		853 -> 857;
	848 [label="Zylo war das erste Lebewesen, das mich weinen sah, weißt du. ",shape=box,color=blue];
