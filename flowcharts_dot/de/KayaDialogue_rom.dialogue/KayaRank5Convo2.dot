		839 -> 845;
	840 [label="Es ist egal, wie es für andere aussieht. Es gab einen Punkt, an dem ich mich selbst mehr gehasst habe als irgendjemand sonst.",shape=box,color=red];
		840 -> 846;
	841 [label="Sein Name war Zylo. Ich glaube, du würdest ihn einen Kubrow nennen.",shape=box,color=blue];
