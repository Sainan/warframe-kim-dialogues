		855 -> 859;
	856 [label="Oh mein Gott ... ein Grund mehr für mich, DORT HINZUKOMMEN. Wow!",shape=box,color=blue];
		856 -> 860;
	857 [label="Da könntest du vielleicht recht haben ... aber egal, großer, gefährlicher Zylo. Aber er hat mich um jeden Preis beschützt.",shape=box,color=blue];
		857 -> 848;
	854 [label="Ich war ungefähr 5 Jahre alt, und soweit ich mich erinnern kann, habe ich mich geweigert zu weinen.",shape=box,color=blue];
		854 -> 858;
	859 [label="Wir können uns nicht durch unser größtes Bedauern definieren. Ich habe das Gefühl, dass du mir geholfen hast, meines hinter mir zu lassen.",shape=box,color=blue];
