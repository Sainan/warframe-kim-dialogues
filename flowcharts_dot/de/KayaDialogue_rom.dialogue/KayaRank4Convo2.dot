		j3051414897 -> j2072611246 [label=false,color=brown];
	j1765485182 [label="Das mache ich vielleicht. Wir haben schließlich jede Menge Zeit.",shape=box,color=red];
		j1765485182 -> j636956295;
	j941294803 [label="Das verspreche ich. Du bist nicht allein auf dieser Welt. Wir alle gehen mit anderen Menschen ein Risiko ein.",shape=box,color=red];
