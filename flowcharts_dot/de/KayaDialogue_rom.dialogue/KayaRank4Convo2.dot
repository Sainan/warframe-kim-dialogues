		j968263794 -> j3423406130;
	j3423406130 [label="Deine Umwelt sah dich dadurch anders.",shape=box,color=red];
		j3423406130 -> j2120013962;
	j2120013962 [label="Verstehst du jetzt, warum ich weg muss?",shape=box,color=blue];
		j2120013962 -> j2675877455;
	j2675877455 [label="Es ist, als wäre das, was mir passiert ist, noch KEINEM anderen passiert.",shape=box,color=blue];
		j2675877455 -> j433878362;
	j433878362 [label="Es machte Schlagzeilen. Leute verspotteten mich, ich würde vorgeben, das Opfer gewesen zu sein, obwohl es meine eigene Entscheidung war, dieses Foto zu teilen.",shape=box,color=blue];
		j433878362 -> j4246553781;
	j4246553781 [label="Du kannst meinen Namen nicht einmal in der Studentendatenbank nachschlagen, ohne dass die Leute an die 'KLS' denken, die kleine Lehrer-Schlampe.",shape=box,color=blue];
		j4246553781 -> j1475466581;
	j1475466581 [label="Und ihr werdet das Bild auch finden und keiner von euch wird mich je wieder so sehen wie vorher. Jeglicher Respekt ... wir verschwinden. Für immer",shape=box,color=blue];
		j1475466581 -> j1511712300;
	j1511712300 [label="Ich muss hier weg, ich muss voran, zu einer Zeit und einem Ort, wo ich klug genug war, das alles hinter mir zu lassen.",shape=box,color=blue];
		j1511712300 -> j2060335191;
		j1511712300 -> j499196901;
		j1511712300 -> j3129726440;
	j2060335191 [label="Mehr habe ich dazu nicht zu sagen. Wir alle haben Dinge getan, die wir bereuen.",shape=box,color=red];
		j2060335191 -> j980735320;
	j499196901 [label="Wenn überhaupt, respektiere ich dich mehr dadurch.",shape=box,color=red];
		j499196901 -> j2076300007;
	j3129726440 [label="Es wird nie einen Moment geben, in dem einer von uns dich dafür verurteilt.",shape=box,color=red];
		j3129726440 -> j3051414897;
	j980735320 [label="Vielleicht kannst du mir eines Tages erzählen, was du am meisten bereust ...",shape=box,color=blue];
