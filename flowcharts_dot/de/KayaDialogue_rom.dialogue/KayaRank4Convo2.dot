	j577121901 [label="Was dir passiert ist, ist eine absolute Verletzung deiner Privatsphäre.",shape=box,color=red];
		j577121901 -> j1914904160;
	j1914904160 [label="Jemand hat dein Vertrauen missbraucht und versucht, dich zu demütigen.",shape=box,color=red];
