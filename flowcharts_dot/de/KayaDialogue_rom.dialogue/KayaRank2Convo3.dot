	j100001474 [label="Äh. Tschüss? Tschüss.",shape=box,color=blue];
		j100001474 -> j2189522063;
	j1532647030 [label="Ich habe gefragt, um Antworten zu ihrer Verbindung mit Zeit zu erhalten, zumindest zu dem was ich sehen kann ...",shape=box,color=blue];
		j1532647030 -> j1311113659;
	j1311113659 [label="Richtig. Wegen Zeitreisen oder dem Anschein einer gewissen Beherrschung zeitlicher Dinge.",shape=box,color=red];
		j1311113659 -> j2891885427;
	j2406199388 [label="Du kennst diese Art?",shape=box,color=red];
		j2406199388 -> j4150049743;
	j3057463566 [label="Er ist nicht vollkommen schlecht, aber ziemlich nah dran.",shape=box,color=red];
		j3057463566 -> j185182390;
	j3674639241 [label="Er ist für vieles verantwortlich. Zu viel, um es aufzuzählen, aber Protea ist etwas davon.",shape=box,color=red];
