		j1730209245 -> j4273892859;
	j3217821720 [label="Falls du jemals darüber reden willst ...",shape=box,color=red];
		j3217821720 -> j4273892859;
	j4274683945 [label="Also hm. Eigentlich. Ja, sagen wir, der Void hat etwas damit zu tun.",shape=box,color=blue];
