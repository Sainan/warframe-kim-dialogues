		j1873889785 -> j4091188892;
	j491759744 [label="Hm. Nun, nehmen wir an, Protea hat von allen diesen Schöpfungen das am weitesten entwickelte zeitliche Verständnis.",shape=box,color=blue];
		j491759744 -> j3652564819;
	j1284355510 [label="Hier ist der Deal und wie es genau laufen wird.",shape=box,color=blue];
		j1284355510 -> j2373418798;
	j4091188892 [label="Noten sind bedeutungslos, wenn deine Lehrer dir den Zugang zum Unterricht verweigern.",shape=box,color=blue];
		j4091188892 -> j1730209245;
		j4091188892 -> j3217821720;
	j3652564819 [label="Basiert das Verständnis auf Theorie, Wissenschaft, angeborener Fähigkeit oder ... ihm.",shape=box,color=blue];
		j3652564819 -> j4274683945;
