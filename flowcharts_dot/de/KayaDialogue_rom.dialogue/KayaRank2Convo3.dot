		j1489271688 -> j3684281344;
	j3221602090 [label="Und an den Meistbietenden verkauft werden möchtest.",shape=box,color=red];
		j3221602090 -> j1400877031;
	j4121718885 [label="Versuchen wir, uns auf das zu beschränken, was dir hier helfen könnte.",shape=box,color=red];
