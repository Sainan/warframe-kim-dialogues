	j4273892859 [label="Ich weiiiiß, ich weiiiiß ...",shape=box,color=blue];
		j4273892859 -> j396804996;
	j57917334 [label="Der Void ist nichts, was man einfach 'lösen' kann.",shape=box,color=red];
		j57917334 -> j3054741811;
	j3894489703 [label="Der Void hat mit ... allem etwas zu tun.",shape=box,color=red];
		j3894489703 -> j3169517136;
	j3411243626 [label="Und dann werde ich wissen, ob du mich jemals verraten wirst oder ob ich dir wirklich vertrauen kann. Ich werde wissen, was die Zukunft bringt.",shape=box,color=blue];
		j3411243626 -> j3081146911;
	j396804996 [label="Ich sag dir was, sobald ich diese Sache mit dem 'Zeitreisen' herausgefunden habe, erzähle ich dir mehr. Ich habe nichts zu verlieren.",shape=box,color=blue];
		j396804996 -> j2189522063;
