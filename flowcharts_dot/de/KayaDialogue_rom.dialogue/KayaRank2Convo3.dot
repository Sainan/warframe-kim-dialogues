	j4251810006 [label="Also ist ER derjenige, mit dem ich reden sollte?",shape=box,color=blue];
		j4251810006 -> j2573057908;
		j4251810006 -> j1557309042;
	j3723059609 [label="Denn aus irgendeinem Grund muss Nova den einzigen Zeitreisenden, den sie kennt, zum Thema Zeitreisen befragen.",shape=box,color=red];
		j3723059609 -> j139732515;
	j2972038324 [label="Weil du wirklich nicht aufgeben willst? Ich will das zwar nicht, aber ich weiß wirklich nicht, wie ich dir helfen kann.",shape=box,color=red];
		j2972038324 -> j3607034298;
	j2558707684 [label="Der Dekan meiner Universität war so. Sollte ich ihn JEMALS wiedersehen ...",shape=box,color=blue];
		j2558707684 -> j1489271688;
	j2573057908 [label="Wenn du für den Rest deines Lebens als wissenschaftliches Experiment aufbewahrt werden willst, klar.",shape=box,color=red];
		j2573057908 -> j3221602090;
	j1557309042 [label="Ich glaube nicht, dass es eine gute Idee ist, dich mit ihm in Kontakt zu bringen, selbst wenn es möglich wäre.",shape=box,color=red];
		j1557309042 -> j4121718885;
	j139732515 [label="+5 Chemistry",color=orange];
		j139732515 -> j1384993361;
	j3607034298 [label="Protea, Einzelheiten. Gibt es da ein Ich von ihr? Du weißt schon, so ein halbgarer Freak?",shape=box,color=blue];
		j3607034298 -> j3062419149;
		j3607034298 -> j1432236502;
	j1489271688 [label="Ich dachte, er wäre auf meiner Seite, aber ...",shape=box,color=blue];
