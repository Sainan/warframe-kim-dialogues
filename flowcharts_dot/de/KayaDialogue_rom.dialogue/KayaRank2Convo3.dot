	j1384993361 [label="Ja.",shape=box,color=blue];
		j1384993361 -> j3568048509;
	j3062419149 [label="Der halbgare Freak, der das Problem der Zeitreisen lösen wird. Die Anerkennung steht dir zu.",shape=box,color=red];
		j3062419149 -> j3257253746;
	j1432236502 [label="Protea, der Warframe, den wir kennen.",shape=box,color=red];
