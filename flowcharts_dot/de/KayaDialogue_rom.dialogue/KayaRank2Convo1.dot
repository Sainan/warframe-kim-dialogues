digraph {
	"KayaRank2Convo1 begins." [color=orange];
		"KayaRank2Convo1 begins." -> j3501000838;
	j3501000838 [label="Hey, Kaya!",shape=box,color=red];
		j3501000838 -> j345897913;
	j345897913 [label="Nova, online heiße ich Nova.",shape=box,color=blue];
		j345897913 -> j1428109994;
		j345897913 -> j3953770472;
	j1428109994 [label="Okay, dann eben Nova. ",shape=box,color=red];
		j1428109994 -> j625052455;
	j3953770472 [label="Verstehe. Seit wann?",shape=box,color=red];
		j3953770472 -> j3340136290;
	j625052455 [label="O.K. danke, nenn mich im Internet einfach nicht Kaya. Du kannst mich persönlich so nennen, aber hier: NOVA. Ok?",shape=box,color=blue];
		j625052455 -> j601334392;
		j625052455 -> j1507299340;
	j3340136290 [label="Ähm, ist das wichtig? Das ist das Internet, ich benutze lieber nicht meinen richtigen Namen.",shape=box,color=blue];
		j3340136290 -> j2030211694;
		j3340136290 -> j4233507725;
	j601334392 [label="Okay, aber darf ich fragen, warum?",shape=box,color=red];
		j601334392 -> j4157575959;
	j1507299340 [label="Verstanden. Nova. Nova. Richtig. Ich wollte fragen: Kann ich irgendetwas tun, um es dir hier angenehmer zu machen?",shape=box,color=red];
		j1507299340 -> j394335389;
	j2030211694 [label="Genau, ich würde auch nicht wollen, dass Leute sehen, wie oft du mich nach Zeitreisen fragst.",shape=box,color=red];
		j2030211694 -> j2323154661;
	j4233507725 [label="Oh? Ich bin ziemlich sicher, dass Amir dieses Netzwerk ziemlich gut geschützt hat, es sei denn, ich übersehe etwas?",shape=box,color=red];
		j4233507725 -> j4104489264;
	j4157575959 [label="Hast du sonst noch jemanden gefragt, ob ihm ein Spitzname gefällt? Mach einfach. ",shape=box,color=blue];
		j4157575959 -> j1507299340;
	j394335389 [label="Ich weiß, keiner von uns hat wirklich darum gebeten, 'hier' in diesem provisorischen Zuhause zu sein, aber wir tun unser Bestes.",shape=box,color=red];
		j394335389 -> j3861513879;
	j2323154661 [label="Ist das dein Ernst? Das Internet ist gefährlich. Also in Echt.",shape=box,color=blue];
		j2323154661 -> j2829011197;
		j2323154661 -> j998194607;
	j4104489264 [label="Es ist mir wichtig. Ich möchte nicht, dass irgendjemand jemals wieder Kaya online findet.",shape=box,color=blue];
		j4104489264 -> j3509696278;
		j4104489264 -> j3409661452;
	j3861513879 [label="Hmm. Ähm. Hmm. Angenehmer. Niemand hat Gerüchte über mich verbreitet, oder?",shape=box,color=blue];
		j3861513879 -> j2840257533;
		j3861513879 -> j4286746810;
	j2829011197 [label="Ist dir etwas passiert?",shape=box,color=red];
		j2829011197 -> j960515419;
	j998194607 [label="Und du denkst, Zeitreisen seien das nicht?",shape=box,color=red];
		j998194607 -> j4294415938;
	j3509696278 [label="Die Zeitpolizei wird dich nicht erwischen, ich schwöre.",shape=box,color=red];
		j3509696278 -> j1148274325;
	j3409661452 [label="Hast du dich in Schwierigkeiten gebracht?",shape=box,color=red];
		j3409661452 -> j3250349168;
	j2840257533 [label="Nun, Aoi hat gesagt ...",shape=box,color=red];
		j2840257533 -> j2080403760;
	j4286746810 [label="Kein Wort. Ich bin einfach nur froh, dass du hier bist.",shape=box,color=red];
		j4286746810 -> j4128422408;
	j960515419 [label="Check boolean KayaSetKid",color=orange];
		j960515419 -> j3347806175 [label=true,color=green];
		j960515419 -> j1996767523 [label=false,color=brown];
	j4294415938 [label="Check boolean KayaSetKid",color=orange];
		j4294415938 -> j3271355953 [label=true,color=green];
		j4294415938 -> j202083557 [label=false,color=brown];
	j1148274325 [label="Uhh. Nicht witzig. ",shape=box,color=blue];
		j1148274325 -> j2292283515;
	j3250349168 [label="Ich habe einen DUMMEN Fehler gemacht. Einmal.",shape=box,color=blue];
		j3250349168 -> j538499697;
	j2080403760 [label="Mach keinen Witz draus.",shape=box,color=blue];
		j2080403760 -> j4139495508;
	j4128422408 [label="Arthur und Eleanor sehen in dir definitiv eine kleine Schwester, die viel cleverer ist als sie.",shape=box,color=red];
		j4128422408 -> j548962818;
	j3347806175 [label="Du sagst doch ständig Kleines zu mir. Was wäre, wenn mir etwas passieren würde?",shape=box,color=blue];
		j3347806175 -> j3306687943;
	j1996767523 [label="Nichts, was ich jetzt ändern könnte.",shape=box,color=blue];
		j1996767523 -> j3718752672;
	j3271355953 [label="Hör mal, ich weiß, du denkst, ich bin nur ein Kind.",shape=box,color=blue];
		j3271355953 -> j2719030509;
	j202083557 [label="Gut. Du hast recht.",shape=box,color=blue];
	j2292283515 [label="+20 Chemistry",color=orange];
		j2292283515 -> "Chat ends. Next chat will be KayaRank2Convo2.";
	j538499697 [label="Und ich mache keine Fehler.",shape=box,color=blue];
		j538499697 -> j2246215851;
	j4139495508 [label="Das ist nicht einmal lustig. Man steckt Mädchen wie uns in einen Raum und jeder erwartet, dass wir uns gegenseitig an die Gurgel gehen.",shape=box,color=blue];
		j4139495508 -> j814485349;
	j548962818 [label="Amir und Quincy kommen nicht über dein Wurmloch hinweg und ich schwöre, wenn du nicht aufpasst, springen sie hindurch.",shape=box,color=red];
		j548962818 -> j673089732;
	j3306687943 [label="Dann hoffe ich, dass du an deinem Umfeld erkennst, dass wir ein Team sind, das sich gegenseitig hilft.",shape=box,color=red];
		j3306687943 -> j1381876702;
	j3718752672 [label="Also, ist das der Grund, warum du diese Sache mit dem Zeitreisen herausfinden willst? Um etwas zu beweisen?",shape=box,color=red];
		j3718752672 -> j415379422;
	j2719030509 [label="Aber",shape=box,color=blue];
		j2719030509 -> j3250349168;
	"Chat ends. Next chat will be KayaRank2Convo2." [color=orange];
	j2246215851 [label="Gib mir also noch ein paar Tage, vielleicht ein paar Wochen, und ich finde das alles heraus, und dann heißt es Abschied nehmen von 1999.",shape=box,color=blue];
		j2246215851 -> j2811764492;
	j814485349 [label="Eifersucht. Vergleiche. Bläh. Mit diesem Teil meines Lebens bin ich fertig. Versuch nicht, mich gegen die anderen Mädels aufzubringen. ",shape=box,color=blue];
		j814485349 -> j2292283515;
	j673089732 [label="Aoi und Lettie können sich anscheinend nicht entscheiden, ob sie deine beste Freundin oder deine Mutter sein wollen.",shape=box,color=red];
		j673089732 -> j2878680873;
	j1381876702 [label="Mmm. ",shape=box,color=blue];
		j1381876702 -> j1669652686;
	j415379422 [label="Vielleicht.",shape=box,color=blue];
		j415379422 -> j3988904255;
	j2811764492 [label="Kannst darauf wetten.",shape=box,color=blue];
		j2811764492 -> j2292283515;
	j2878680873 [label="Und ich bin einfach nur froh, dass jemand verstehen möchte, wie zum Teufel ich hier gelandet bin.",shape=box,color=red];
		j2878680873 -> j2096148180;
	j1669652686 [label="Du hast recht. Du bist nicht gerade unbeliebt.",shape=box,color=blue];
		j1669652686 -> j2855461710;
	j3988904255 [label="Warum kümmert dich das eigentlich?",shape=box,color=blue];
		j3988904255 -> j533002019;
		j3988904255 -> j2866330800;
		j3988904255 -> j2624483689;
	j2096148180 [label="Ihr alle ... habt mich gern?",shape=box,color=blue];
		j2096148180 -> j3959038302;
		j2096148180 -> j4122061027;
	j2855461710 [label="Und alle scheinen dir zu vertrauen, oder behaupten es zumindest.",shape=box,color=blue];
		j2855461710 -> j2624483689;
		j2855461710 -> j2866330800;
		j2855461710 -> j533002019;
	j533002019 [label="Menschen zu vertrauen und zusammenzuarbeiten, ist das, was uns ausmacht.",shape=box,color=red];
		j533002019 -> j4135060691;
	j2866330800 [label="Meinen Freunden beizustehen, ist eine Stärke. Es ist ein Grund, all diesen Mist zu ertragen.",shape=box,color=red];
		j2866330800 -> j4135060691;
	j2624483689 [label="Wir alle haben unseren Mist, mit dem wir klarkommen müssen. Das allein zu tun, ist schwer.",shape=box,color=red];
		j2624483689 -> j4135060691;
	j3959038302 [label="Wir warten nur darauf, dass du dich bei uns wohlfühlst.",shape=box,color=red];
		j3959038302 -> j3783264663;
	j4122061027 [label="Wieso sollten wir nicht? ",shape=box,color=red];
		j4122061027 -> j3783264663;
	j4135060691 [label="LOL Klingt wie der Werbespruch einer Schwesternschaft.",shape=box,color=blue];
		j4135060691 -> j757526411;
		j4135060691 -> j859248522;
	j3783264663 [label="Ich ... verstehe.",shape=box,color=blue];
		j3783264663 -> j2292283515;
