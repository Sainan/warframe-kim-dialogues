digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank4Convo1 begins." [color=orange];
		"KayaRank4Convo1 begins." -> j2556548099;
	j2556548099 [label="Willst du wissen, wie das ist? Das Internet taucht auf, verspricht uns so viel.",shape=box,color=blue];
		j2556548099 -> j1699200487;
	j1699200487 [label="Du bist also ich. Du wirst 18. Du gehst online. Du fängst an, mit neuen Freunden zu chatten, ÜBERALL!",shape=box,color=blue];
		j1699200487 -> j872957535;
	j872957535 [label="Und für ein sogenanntes 'cleveres Mädchen' wie mich machst du das Dümmste, was man im Internet machen kann. ",shape=box,color=blue];
		j872957535 -> j2782206579;
	j2782206579 [label="Du vertraust der Person auf der anderen Seite. ",shape=box,color=blue];
		j2782206579 -> j3395585385;
	j3395585385 [label="Und du siehst all diese neue Technologie und vergisst, dass Menschen weiterhin Menschen sind.",shape=box,color=blue];
		j3395585385 -> j4169425226;
	j4169425226 [label="Du schickst also ein Nacktfoto von dir, das Lua erröten lassen würde. Du glaubst, du hast eine Verbindung mit jemandem, den du im Internet kennengelernt hast. Du kannst deinem Online-Freund vertrauen.",shape=box,color=blue];
		j4169425226 -> j769117136;
	j769117136 [label="Und am nächsten Tag ist das Foto überall. Jeder auf dem Campus hat es gesehen. Jeder teilte es. Schickte es an die PROFESSOREN. Überall im INTERNET. In Ländern, von denen ich nicht einmal wusste, dass es sie gibt.",shape=box,color=blue];
		j769117136 -> j3571353444;
	j3571353444 [label="Ich könnte der klügste Mensch auf diesem Felsen sein und Leute würden sich nur an mich erinnern, wegen diesem einen Bild.",shape=box,color=blue];
		j3571353444 -> j4125562655;
	j4125562655 [label="Wenn ich also sage, dass ich hier verschwinde, dann meine ich das auch so. Ich weiß, dass dieses Bild NICHTS bedeutet, die Zukunft ging weiter, die Leute hatten ihren Kick.",shape=box,color=blue];
		j4125562655 -> j1273704471;
	j1273704471 [label="Aber für mich hat es mein Leben ruiniert. Ich möchte in einer Zukunft ohne Internet leben. Ich möchte beweisen, dass ich darüber hinwegkommen kann. In die Vergangenheit zu gehen, beweist, dass SIE recht haben, dass ich nicht darüber hinwegkommen kann.",shape=box,color=blue];
		j1273704471 -> j270581248;
	j270581248 [label="Also warte einfach. Du wirst mich dort sehen, wo du herkommst.",shape=box,color=blue];
		j270581248 -> j164553868;
	j164553868 [label="Und wir können auf die Welt blicken und darüber lachen, dass meine Entscheidungen mich nicht zerstört haben. Sie haben mich nur klüger gemacht. Clever genug, um da rauszukommen.",shape=box,color=blue];
		j164553868 -> j3258508148;
	j3258508148 [label="+20 Chemistry",color=orange];
		j3258508148 -> "Chat ends. Next chat will be KayaRank4Convo2.";
	"Chat ends. Next chat will be KayaRank4Convo2." [color=orange];
}