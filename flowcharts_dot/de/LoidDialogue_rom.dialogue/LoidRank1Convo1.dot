digraph {
	0 [label="LoidRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Drifter. Verzeih mir die Unangemessenheit dieses Ansinnens, ich wollte dich eigentlich nicht über dieses Gerät erreichen. Aber es grenzt an einen Notfall und ich wusste nicht, an wen ich mich sonst hätte wenden können.",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="POM2_LAB1?",shape=box,color=red];
		2 -> 4;
	3 [label="Wer ist das ...?",shape=box,color=red];
		3 -> 4;
	4 [label="Ah, ja. Immer noch auf Standardeinstellungen. Hier ist Loid. Das hätte ich ... zuerst sagen sollen, aber die Dinge hier im Sanctum Anatomica waren in letzter Zeit sehr chaotisch.",shape=box,color=blue];
		4 -> 5;
	5 [label="Daher melde ich mich. Ich brauche deine Hilfe. Es sind drei Protoframes hier im Sanctum angekommen, in meiner Zeit. Keiner davon ist uns bisher bekannt.",shape=box,color=blue];
		5 -> 6;
	6 [label="Einer von ihnen ist ein",shape=box,color=blue];
		6 -> 7;
	7 [label="Entschuldigung",shape=box,color=blue];
		7 -> 8;
	8 [label="Einer von ihnen ist Orokin, Drifter.",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
		8 -> 11;
	9 [label="Wo ist die Lotus?",shape=box,color=red];
		9 -> 12;
	10 [label="Oh nein ...",shape=box,color=red];
		10 -> 13;
	11 [label="Was?!",shape=box,color=red];
		11 -> 13;
	12 [label="Die Lotus und der Operator müssen sich um andere Dinge kümmern, glaub mir. Sie sind bereits bis zum Äußersten ausgelastet. Ich würde dich nicht um Hilfe bitten, wenn ich mich an jemand anderes wenden könnte.",shape=box,color=blue];
		12 -> 14;
	13 [label="Ich würde dich nicht um Hilfe bitten, wenn ich mich an jemand anderes wenden könnte. Du ... scheinst der neue Experte in diesen Dingen zu sein.",shape=box,color=blue];
		13 -> 15;
	14 [label="Du ... scheinst der neue Experte in diesen Dingen zu sein.",shape=box,color=blue];
		14 -> 15;
	15 [label="Ich weiß nicht, wie ich sie am besten beschreiben soll. Aber wenn du zum Sanctum kommst, wirst du sie kaum übersehen können. Zwei von ihnen sind bereit, hier mit dir zu sprechen, über POM-2. Der andere muss noch etwas überzeugt werden.",shape=box,color=blue];
		15 -> 16;
	16 [label="Ich habe ... Vertrauen ... dass du Erfolg haben wirst.",shape=box,color=blue];
		16 -> 29;
	29 [label="Update boolean LoidTriadAvailable",color=orange];
		29 -> 17;
	17 [label="Chat ends. Next chat will be LoidFamily.",color=orange];
}