		2940 -> 2941;
	2959 [label="Und wenn sie jetzt sprechen, es begann so hoffnungslos. So falsch. Die Voidsprache ließ diese Kreaturen am Anfang nur eines fühlen: hoffnungslos.",shape=box,color=red];
