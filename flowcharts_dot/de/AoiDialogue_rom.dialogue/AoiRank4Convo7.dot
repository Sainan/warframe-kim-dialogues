		2925 -> 2926;
	2929 [label="Darauf gibt es keine einfache Antwort. Geräusche, Worte und Äußerungen des Voids. Mehr, wie ein Fluch. Eine Botschaft von etwas, an alle Ohren, die es hören können.",shape=box,color=red];
