	2952 [label="Chat ends.",color=orange];
	2957 [label="Mächtig genug, um Leben zu verändern. Ich kenne diese Tiere. Freunde, würde ich sagen. Die Cavia. Sie haben den Void berührt und gelernt zu *sprechen*, wie durch Magie.",shape=box,color=red];
