		2269 -> 2271 [label="RoatheFailNot21",color=purple];
		2269 -> 2270 [label="RoatheFailUnloved",color=purple];
	2273 [label="Roathe musste sich der Wahrheit stellen, dass er ... nun ja ... das Serum genommen hat. Und ich weiß nicht wie, aber ich glaube, ich habe ihm dabei nicht gut genug geholfen.",shape=box,color=red];
		2273 -> 2277;
	2272 [label="Ich bin mir nicht sicher. Ich glaube, ich habe etwas gesagt, was ich nicht hätte sagen sollen.",shape=box,color=red];
		2272 -> 2276;
	2271 [label="Er hat mir verboten, weiter in seinen Erinnerungen zu wühlen. Also habe ich es nicht getan. Und nun scheinen wir ... festzustecken?",shape=box,color=red];
		2271 -> 2275;
	2270 [label="Ich sagte ihm, ich bin nur mit ihm zusammen für eine lockere Beziehung, und obwohl er damit scheinbar kein Problem hatte, habe ich jetzt das Gefühl, dass wir einen Rückschritt gemacht haben.",shape=box,color=red];
		2270 -> 2274;
	2277 [label="Ich verstehe. Es kann schwierig sein, eigene vergangenen Taten zu akzeptieren, wenn sie in einem neuen Licht erscheinen. Ich verfluche Entrati dafür, dass er ihn und uns in diese verabscheuungswürdige Lage gebracht hat.",shape=box,color=blue];
		2277 -> 2280;
	2276 [label="Ich verstehe. Ich fürchte, ich muss dir sagen, dass ich in dieser Angelegenheit wenig tun kann, da du in diesem Zusammenhang \"erntest, was du gesät hast\".",shape=box,color=blue];
		2276 -> 2278;
	2275 [label="Ich verstehe. Manchmal ist es nicht dasselbe, im besten Interesse anderer zu handeln, wie ihren Wünschen buchstabengetreu nachzukommen.",shape=box,color=blue];
		2275 -> 2279;
	2274 [label="Ich verstehe. Ich fürchte, ich muss dir sagen, dass ich in dieser Angelegenheit wenig tun kann, da du in diesem Zusammenhang \"erntest, was du gesät hast\".",shape=box,color=blue];
		2274 -> 2278;
	2280 [label="Ich werde mein Möglichstes tun, um ihn davon zu überzeugen, dir zuzuhören. Ich rate dir jedoch dringend, bessere Argumente vorzubringen, warum er sein Handeln nicht als Feigheit interpretieren sollte.",shape=box,color=blue];
		2280 -> 2282;
	2278 [label="Ein solch gefühlloses und rücksichtsloses Verhalten führt zwangsläufig zu entsprechenden Reaktionen. Besonders im Umgang mit jemandem wie Roathe.",shape=box,color=blue];
		2278 -> 2281;
	2279 [label="Es ist eine schreckliche Tat, den Wünschen eines anderen zu widersprechen, insbesondere bei einer so schwerwiegenden Handlung wie dem Durchwühlen privater Erinnerungen und Gedanken.",shape=box,color=blue];
		2279 -> 2341;
	2282 [label="Denn ich weiß, das frisst in seinem Inneren an ihm.",shape=box,color=blue];
		2282 -> 2284;
	2281 [label="Ich weiß nicht, welche Möglichkeiten du hast, um das zu klären. Aber ich glaube nicht, dass du über Marie oder mich einen Ausweg finden wirst, vergib mir.",shape=box,color=blue];
		2281 -> 2283;
	2341 [label="Ich verfluche Entrati dafür, dass er ihn und uns in so eine erbärmliche Lage gezwungen hat.",shape=box,color=blue];
		2341 -> 2342;
	2284 [label="Ich weiß, dass wir in dieser Angelegenheit auch Maries Hilfe benötigen werden. Es wird jedoch schwerer sein, sie zu überzeugen. Du weißt ja, dass zwischen den beiden keine Freundschaft herrscht.",shape=box,color=blue];
		2284 -> 2286;
	2283 [label="Vielleicht ist es an diesem Punkt am besten, andere Optionen zu verfolgen.",shape=box,color=blue];
		2283 -> 2285;
	2342 [label="Aber leider scheint es so zu sein, dass der einzige Weg ihm zu helfen, ist, genau das zu tun. Und weiterhin die Abgründigkeit zu erforschen, bis keine Erinnerung mehr unentdeckt bleibt.",shape=box,color=blue];
		2342 -> 2343;
	2286 [label="Update boolean LyonRoatheFailFix",color=orange];
