digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRoatheFail begins." [color=orange];
		"LyonRoatheFail begins." -> j2372524677;
		"LyonRoatheFail begins." -> j129698615;
	j2372524677 [label="Lyon, ich brauche deine Hilfe mit Roathe.",shape=box,color=red];
		j2372524677 -> j421763245;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j421763245 [label="Check boolean LyonDating",color=orange];
		j421763245 -> j2592390757 [label=true,color=green];
		j421763245 -> j3876846922 [label=false,color=brown];
	"Chat ends." [color=orange];
	j2592390757 [label="Wenn ich irgendwie helfen kann, werde ich es tun, mon miracle. Was ist zwischen euch beiden schiefgelaufen?",shape=box,color=blue];
		j2592390757 -> j572992334;
	j3876846922 [label="Wenn ich irgendwie helfen kann, werde ich es tun, mein Freund. Was ist zwischen euch beiden schiefgelaufen?",shape=box,color=blue];
		j3876846922 -> j572992334;
	j572992334 [label="Evaluate expressions",color=orange];
		j572992334 -> j3090754370 [label="RoatheFail",color=purple];
		j572992334 -> j3090754370 [label="RoatheFailStall",color=purple];
		j572992334 -> j3671934065 [label="RoatheFailUltimate",color=purple];
		j572992334 -> j2176806060 [label="RoatheFailNot21",color=purple];
		j572992334 -> j75049604 [label="RoatheFailUnloved",color=purple];
		j572992334 -> j3090754370 [label="RoatheRepair1",color=purple];
	j3090754370 [label="Roathe musste sich der Wahrheit stellen, dass er ... nun ja ... das Serum genommen hat. Und ich weiß nicht wie, aber ich glaube, ich habe ihm dabei nicht gut genug geholfen.",shape=box,color=red];
		j3090754370 -> j2912602927;
	j3671934065 [label="Ich bin mir nicht sicher. Ich glaube, ich habe etwas gesagt, was ich nicht hätte sagen sollen.",shape=box,color=red];
		j3671934065 -> j1488022851;
	j2176806060 [label="Er hat mir verboten, weiter in seinen Erinnerungen zu wühlen. Also habe ich es nicht getan. Und nun scheinen wir ... festzustecken?",shape=box,color=red];
		j2176806060 -> j3463091178;
	j75049604 [label="Ich sagte ihm, ich bin nur mit ihm zusammen für eine lockere Beziehung, und obwohl er damit scheinbar kein Problem hatte, habe ich jetzt das Gefühl, dass wir einen Rückschritt gemacht haben.",shape=box,color=red];
		j75049604 -> j1488022851;
	j2912602927 [label="Ich verstehe. Es kann schwierig sein, eigene vergangenen Taten zu akzeptieren, wenn sie in einem neuen Licht erscheinen. Ich verfluche Entrati dafür, dass er ihn und uns in diese verabscheuungswürdige Lage gebracht hat.",shape=box,color=blue];
		j2912602927 -> j2216721158;
	j1488022851 [label="Ich verstehe. Ich fürchte, ich muss dir sagen, dass ich in dieser Angelegenheit wenig tun kann, da du in diesem Zusammenhang \"erntest, was du gesät hast\".",shape=box,color=blue];
		j1488022851 -> j315898505;
	j3463091178 [label="Ich verstehe. Manchmal ist es nicht dasselbe, im besten Interesse anderer zu handeln, wie ihren Wünschen buchstabengetreu nachzukommen.",shape=box,color=blue];
		j3463091178 -> j2175493250;
	j2216721158 [label="Ich werde mein Möglichstes tun, um ihn davon zu überzeugen, dir zuzuhören. Ich rate dir jedoch dringend, bessere Argumente vorzubringen, warum er sein Handeln nicht als Feigheit interpretieren sollte.",shape=box,color=blue];
		j2216721158 -> j1323953072;
	j315898505 [label="Ein solch gefühlloses und rücksichtsloses Verhalten führt zwangsläufig zu entsprechenden Reaktionen. Besonders im Umgang mit jemandem wie Roathe.",shape=box,color=blue];
		j315898505 -> j1678451094;
	j2175493250 [label="Es ist eine schreckliche Tat, den Wünschen eines anderen zu widersprechen, insbesondere bei einer so schwerwiegenden Handlung wie dem Durchwühlen privater Erinnerungen und Gedanken.",shape=box,color=blue];
		j2175493250 -> j2710291678;
	j1323953072 [label="Denn ich weiß, das frisst in seinem Inneren an ihm.",shape=box,color=blue];
		j1323953072 -> j558081994;
	j1678451094 [label="Ich weiß nicht, welche Möglichkeiten du hast, um das zu klären. Aber ich glaube nicht, dass du über Marie oder mich einen Ausweg finden wirst, vergib mir.",shape=box,color=blue];
		j1678451094 -> j2153726835;
	j2710291678 [label="Ich verfluche Entrati dafür, dass er ihn und uns in so eine erbärmliche Lage gezwungen hat.",shape=box,color=blue];
		j2710291678 -> j1774299485;
	j558081994 [label="Boolean LyonRoatheFailFix is now true.",color=orange];
		j558081994 -> j618688711;
	j2153726835 [label="Vielleicht ist es an diesem Punkt am besten, andere Optionen zu verfolgen.",shape=box,color=blue];
		j2153726835 -> "Chat ends.";
	j1774299485 [label="Aber leider scheint es so zu sein, dass der einzige Weg ihm zu helfen, ist, genau das zu tun. Und weiterhin die Abgründigkeit zu erforschen, bis keine Erinnerung mehr unentdeckt bleibt.",shape=box,color=blue];
		j1774299485 -> j3943362726;
	j618688711 [label="Check boolean MarieRoatheFailFix",color=orange];
		j618688711 -> j3211697863 [label=true,color=green];
		j618688711 -> j543378715 [label=false,color=brown];
	j3943362726 [label="Egal, wie viel der Teufel auch protestieren mag.",shape=box,color=blue];
		j3943362726 -> "Chat ends.";
	j3211697863 [label="Es scheint, als hättest du bereits Maries Unterstützung, ihn zu überzeugen. Ich bin beeindruckt. Zwischen den beiden herrscht keine große Freundschaft.",shape=box,color=blue];
		j3211697863 -> j1011692685;
	j543378715 [label="Ich weiß, dass wir in dieser Angelegenheit auch Maries Hilfe benötigen werden. Es wird jedoch schwerer sein, sie zu überzeugen. Du weißt ja, dass zwischen den beiden keine Freundschaft herrscht.",shape=box,color=blue];
		j543378715 -> j435203136;
	j1011692685 [label="Dann können wir wohl anfangen.",shape=box,color=blue];
		j1011692685 -> "Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue";
	j435203136 [label="Möge Lua dich führen.",shape=box,color=blue];
		j435203136 -> "Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	"Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue" [label="Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue",color=orange];
		"Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue" -> "Chat ends.";
	"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
}