		j3291097851 -> j2805069408 [label="RoatheFamilySuccess",color=purple];
		j3291097851 -> j3586051770 [label="MarieFamilySuccess",color=purple];
		j3291097851 -> j3204769290 [label="RoatheFamilyDelay",color=purple];
		j3291097851 -> j3963110389 [label="false",color=purple];
	j1759467020 [label="Du benötigst meine Hilfe mit dem Butler, nicht wahr?",shape=box,color=blue];
		j1759467020 -> j1542817961;
		j1759467020 -> j129698615;
	j228115647 [label="Ja, nun ja. Ich glaube, ich beginne zu verstehen, wie das passieren konnte.",shape=box,color=blue];
		j228115647 -> "Chat ends.";
	j3297510696 [label="Könntest du mich nur lachen hören! Ich verurteile dich nicht, ich habe ehrlich gesagt mehr Mitgefühl mit dir, als du vielleicht ahnst. Und genau deshalb werde ich dir helfen.",shape=box,color=blue];
		j3297510696 -> j3357769809;
	j3253827334 [label="Ich glaube, ich verstehe es jetzt.",shape=box,color=blue];
		j3253827334 -> "Chat ends.";
	j1662536181 [label="Check boolean MarieNoDate",color=orange];
		j1662536181 -> j1362168795 [label=true,color=green];
		j1662536181 -> j504928094 [label=false,color=brown];
	j3019977147 [label="Ich verstehe deine Frustration, glaube mir.",shape=box,color=blue];
		j3019977147 -> j4192858112;
	j594991916 [label="Das sollte eigentlich nicht möglich sein.",shape=box,color=red];
		j594991916 -> j3558787097;
	j1158746491 [label="Der Teufel scheint ... sich Zeit zu lassen. Aber ohne Marie kommst du auch nicht weit.",shape=box,color=blue];
		j1158746491 -> j1673705396;
	j2805069408 [label="Der Orokin hat dir Unterstützung zugesagt, aber Marie nicht. Eine Angelegenheit, die sich leicht lösen lässt. Aber ich frag mich: Wie hast du das geschafft?",shape=box,color=blue];
		j2805069408 -> j4151575977;
		j2805069408 -> j2084771567;
	j3586051770 [label="Es scheint, du hast die Hilfe von Marie, aber nicht von Roathe? Wenig überraschend.",shape=box,color=blue];
		j3586051770 -> j1785377693;
		j3586051770 -> j3298340968;
	j3204769290 [label="Der Teufel scheint ... sich Zeit zu lassen.",shape=box,color=blue];
		j3204769290 -> j1673705396;
	j3963110389 [label="Bin ich der Einzige, den du überzeugen konntest? Ich bin ... beeindruckt.",shape=box,color=blue];
		j3963110389 -> j487579141;
		j3963110389 -> j1777947882;
	j1542817961 [label="Ja, brauche ich.",shape=box,color=red];
		j1542817961 -> j1351093954;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j3357769809 [label="Marie ist meine Seelenverwandte, und der Teufel schuldet mit etwas. Wofür, werde ich nicht verraten; es ist ein Geheimnis, das ich mit ins Grab nehme. Fragt also gar nicht erst danach.",shape=box,color=blue];
		j3357769809 -> j1804855987;
	j1362168795 [label="Oder, du hast dich doch gelungen ausgedrückt, so wie es sich anhört.",shape=box,color=blue];
		j1362168795 -> "Chat ends.";
	j504928094 [label="Ich spreche mit ihr. Mal sehen, was ich tun kann.",shape=box,color=blue];
		j504928094 -> j65720282;
		j504928094 -> j1810445309;
	j4192858112 [label="Ich werde mit ihm sprechen. Er ... schuldet mir einen Gefallen.",shape=box,color=blue];
		j4192858112 -> j1218503792;
	j3558787097 [label="Und doch sind wir hier an diesem Punkt.",shape=box,color=blue];
		j3558787097 -> j766087323;
	j1673705396 [label="Eine Angelegenheit, die sich leicht beheben lässt, wenn du es mir gestattest?",shape=box,color=blue];
		j1673705396 -> j3661241445;
		j1673705396 -> j3098573445;
	j1351093954 [label="Meine Gedanken schweifen in letzter Zeit oft in seltsame Richtungen ab. Natürlich werde ich helfen.",shape=box,color=blue];
		j1351093954 -> j1436756777;
	j1804855987 [label="Selbstverständlich helfe ich, erlaubst ... du mir das Problem zu lösen?",shape=box,color=blue];
		j1804855987 -> j3661241445;
		j1804855987 -> j3098573445;
	j65720282 [label="Wirklich?",shape=box,color=red];
		j65720282 -> j4103796527;
	j1810445309 [label="Danke!",shape=box,color=red];
		j1810445309 -> j4103796527;
	j1218503792 [label="Frag nicht, wofür. Das begleitet mich bis ins Grab.",shape=box,color=blue];
		j1218503792 -> j2755011704;
		j1218503792 -> j1510932907;
	j766087323 [label="Ich hätte dir empfohlen, mit einem Priester zu sprechen, aber ... nun bist du hier.",shape=box,color=blue];
		j766087323 -> j2186833626;
	j3661241445 [label="Ähm ... nein. Ich mache das lieber alleine, danke.",shape=box,color=red];
