	j858457841 [label="Es scheint, als wäre es sowohl mit Marie als auch dem Orokin ziemlich schiefgegangen. Ich ... bin beeindruckt.",shape=box,color=blue];
		j858457841 -> j487579141;
		j858457841 -> j1777947882;
	j3530439088 [label="Es scheint, als wäre es mit Marie ziemlich schiefgegangen. Wie hast du das bloß geschafft?",shape=box,color=blue];
		j3530439088 -> j4151575977;
		j3530439088 -> j2084771567;
	j1345950112 [label="Es scheint, als wäre es mit dem Orokin ziemlich schiefgegangen. Ich bin nicht wirklich überrascht.",shape=box,color=blue];
		j1345950112 -> j1785377693;
		j1345950112 -> j3298340968;
	j2246696572 [label="Ich habe dir meine Hilfe bei der Angelegenheit mit dem Butler zugesichert, aber anscheinend ist dieser Plan etwas schiefgelaufen.",shape=box,color=blue];
		j2246696572 -> j3291097851;
	j4044333263 [label="Mon miracle, ich denke, ich war nicht ganz bei der Sache. Ich muss mich entschuldigen.",shape=box,color=blue];
		j4044333263 -> j1759467020;
	j1712178562 [label="Mein Freund, ich denke, ich war nicht ganz bei der Sache. Ich muss mich entschuldigen.",shape=box,color=blue];
		j1712178562 -> j1759467020;
	j487579141 [label="Bitte fang nicht damit an. Ich brauche keine Schuldgefühle vom Priester, danke.",shape=box,color=red];
		j487579141 -> j228115647;
	j1777947882 [label="Ich glaube ehrlich gesagt, wenn stattdessen eine der Ratten einer Freundin auf den Tasten rumgehopst und zufällige Wörter erzeugt hätte, hätte ich mich besser angestellt.",shape=box,color=red];
		j1777947882 -> j3297510696;
	j4151575977 [label="Sie hat mich missverstanden.",shape=box,color=red];
		j4151575977 -> j3253827334;
	j2084771567 [label="Ich ... habe Dinge gesagt, die ich nicht hätte sagen sollen. Ich wünschte, ich hätte mich besser angestellt. Ich glaube, ich habe meine Absichten schlecht dargestellt.",shape=box,color=red];
		j2084771567 -> j1662536181;
	j1785377693 [label="Die Sache zwischen ihm und mir ist ... kompliziert und verwirrend.",shape=box,color=red];
		j1785377693 -> j3019977147;
	j3298340968 [label="Fang bloß nicht damit an.",shape=box,color=red];
		j3298340968 -> j3019977147;
