		j680575522 -> j1449267514 [label="LyonBackstory1",color=purple];
		j680575522 -> j2020614264 [label="false",color=purple];
	j3064429082 [label="+20 Chemistry",color=orange];
		j3064429082 -> j745758785;
	j184117411 [label="Mein Freund, du warst sehr geduldig mit mir und gütiger, als du hättest sein sollen. Und du hast dich sicher gefragt, was in der Nacht passierte, als Lua am dunkelsten war.",shape=box,color=blue];
		j184117411 -> j3131641436;
	j1963749381 [label="Mein Freund, du warst sehr geduldig mit mir. Und du hast dich sicher gefragt, was in der Nacht passierte, als Lua am dunkelsten war.",shape=box,color=blue];
		j1963749381 -> j3131641436;
	j1449267514 [label="Mein Freund, du musst dich nach meiner Vergangenheit gefragt haben. Und du hast dich sicher gefragt, was in der Nacht passierte, als Lua am dunkelsten war.",shape=box,color=blue];
		j1449267514 -> j3131641436;
	j2020614264 [label="Mein Freund, ich bin sicher, du hast dich nach meiner Geschichte gefragt, was in der Nacht passierte, als Lua am dunkelsten war.",shape=box,color=blue];
		j2020614264 -> j3131641436;
	j745758785 [label="[Konversation wurde aufgrund von zuvor aktivierter Triggerwarnung übersprungen.]",shape=box,color=blue];
		j745758785 -> j370687875;
	j3131641436 [label="Es ist eine Geschichte, die ich geschworen habe, nie zu erzählen. Nur Marie kennt sie, da sie sie in meinen Tagebüchern gelesen hat. Und jetzt, werde ich sie dir hier erzählen.",shape=box,color=blue];
		j3131641436 -> j280394462;
	j370687875 [label="Boolean LyonConfession1 is now true.",color=orange];
		j370687875 -> "Chat ends.";
	j280394462 [label="Sobald ich anfange, kann ich nicht aufhören, denn ich kann nicht wieder von vorne anfangen. Also vergib mir bitte, wenn in keine Fragen beantworte.",shape=box,color=blue];
		j280394462 -> j812139589;
		j280394462 -> j1187564717;
		j280394462 -> j780863449;
		j280394462 -> j1132094242;
	"Chat ends." [color=orange];
	j812139589 [label="Natürlich.",shape=box,color=red];
		j812139589 -> j1923726971;
	j1187564717 [label="[Lass ihn weiterreden.]",shape=box,color=red];
		j1187564717 -> j3327518431;
	j780863449 [label="[Warnung: Diskussion über Selbstverletzung und Kindesmisshandlung. Hier klicken, zum Verlassen. Du verlierst dadurch keine Chemiepunkte mit Lyon.]",shape=box,color=red];
		j780863449 -> j784838610;
	j1132094242 [label="[Ende.]",shape=box,color=red];
		j1132094242 -> j3856020424;
	j1923726971 [label="Vielen Dank.",shape=box,color=blue];
		j1923726971 -> j141195667;
	j3327518431 [label="+5 Chemistry",color=orange];
		j3327518431 -> j1923726971;
	j784838610 [label="Check boolean LyonSpeech",color=orange];
		j784838610 -> j3342655806 [label=true,color=green];
		j784838610 -> j3794260945 [label=false,color=brown];
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j141195667 [label="Evaluate expressions",color=orange];
		j141195667 -> j1492434322 [label="LyonBackstory3a",color=purple];
		j141195667 -> j1492434322 [label="LyonBackstory3b",color=purple];
		j141195667 -> j2357218259 [label="false",color=purple];
	j3342655806 [label="+20 Chemistry",color=orange];
		j3342655806 -> j370687875;
	j3794260945 [label="Solltest du dich wegen dieser Entscheidung als Feigling betrachten, bitte tue das nicht. Dies ist ein Schmerz, dem du dich nicht zu stellen brauchst. Sondern ich. Du hast nicht darum gebeten, diesen Moment ertragen zu müssen.",shape=box,color=blue];
		j3794260945 -> j4425189;
	j1492434322 [label="Wir haben über meine Familie gesprochen. Von meiner Zeit auf dem Bauernhof, auf dem ich aufwuchs. Von den Visionen, die mich gequält und zur Gewalt getrieben haben.",shape=box,color=blue];
		j1492434322 -> j2958990644;
	j2357218259 [label="Ich weiß, dass ich dir nicht viel über diejenigen erzählt habe, die mich aufgezogen haben. Und ich fürchte, aus gutem Grund.",shape=box,color=blue];
		j2357218259 -> j4136031228;
	j4425189 [label="Diese mechanische Vorrichtung, vor der wir sitzen, erweckt den Eindruck von verschleierter Unpersönlichkeit. Dass wir irgendwie vor jeglichem Schaden geschützt sind, den ein anderer uns durch seine getippten Worte zufügen könnte.",shape=box,color=blue];
		j4425189 -> j66003537;
	j2958990644 [label="Ich habe dir von den Stimmen erzählt, die ich hörte, die mir zuflüsterten und mir aus anderen Räumen zuriefen. Manchmal klang es, als würden sie meinen Namen rufen ...",shape=box,color=blue];
		j2958990644 -> j3748354766;
	j4136031228 [label="Meine Mutter ... sah meine Visionen als das Werk des Teufels. Und versuchte, sie mit einer Rute auszutreiben. Oft, bis ich nicht mehr stehen konnte.",shape=box,color=blue];
		j4136031228 -> j741751387;
	j66003537 [label="Ich würde eher das Gegenteil behaupten, dass wir ohne den Schutz, den wir in alltäglicheren sozialen Begegnungen anlegen, auch dessen beraubt sind, was uns hier schützen könnte.",shape=box,color=blue];
		j66003537 -> j1053120125;
	j3748354766 [label="... andere Male klangen sie nach nichts bestimmten. Unverständliches Gebrabbel oder die Sprache des Teufels.",shape=box,color=blue];
		j3748354766 -> j1953920355;
	j741751387 [label="Und mein Vater? Naja. So grausam meine Mutter auch war, mein Vater war schlimmer. Ich erspare dir Einzelheiten.",shape=box,color=blue];
		j741751387 -> j2442083815;
	j1053120125 [label="Daher bin ich mir in Situationen wie dieser durchaus bewusst, dass ein Pfeil, den ich abschieße, vielleicht nicht einen kampfbereiten Soldaten vorfindet, sondern die ungeschützte Halsschlagader eines Rehs im Wald.",shape=box,color=blue];
		j1053120125 -> j1492705172;
	j1953920355 [label="Zuerst jagten mir die wirren Worte Angst ein. Ich flehte sie an, Sinn zu ergeben. Ich betete zu Lua, ihre Geister mögen mir sagen, was sie von mir wollten.",shape=box,color=blue];
		j1953920355 -> j4042356469;
	j2442083815 [label="Aber ihre Gewalt stand meiner in nichts nach. Meine Visionen machten es schwierig, mit mir umzugehen, vor allem, sobald ich körperlich größer und kräftiger war, als sogar mein Vater.",shape=box,color=blue];
		j2442083815 -> j1001574901;
	j1492705172 [label="Daher möchte ich dich hiermit zurücklassen:",shape=box,color=blue];
		j1492705172 -> j4189663067;
	j4042356469 [label="Aber als ich zu entschlüsseln begann, was sie von mir wollten ... bereute ich, wonach ich so sehr gebetet hatte. Denn jetzt wusste ich, welche Taten sie von mir verlangten, in ihrem Namen zu vollbringen.",shape=box,color=blue];
		j4042356469 -> j3535143204;
	j1001574901 [label="Und die Visionen nahmen oft die Form von Stimmen an. Manchmal klang es, als würden sie meinen Namen rufen ...",shape=box,color=blue];
		j1001574901 -> j3748354766;
	j4189663067 [label="Wir müssen uns daran erinnern, die Kraft zu finden, einem anderen aufzuhelfen, auch wenn wir selbst nicht die Kraft haben, zu stehen.",shape=box,color=blue];
		j4189663067 -> j442584520;
	j3535143204 [label="Und was für einen schrecklichen Preis sie dafür hätten zahlen müssen.",shape=box,color=blue];
		j3535143204 -> j2432121336;
	j442584520 [label="Das ist der wahre Zweck von Geschichten.",shape=box,color=blue];
		j442584520 -> j2682414398;
	j2432121336 [label="Versteh mich nicht falsch. Ich liebte weder meinen Vater noch meine Mutter. Jegliche familiäre Loyalität, die ich für sie gefühlt haben mag, war längst unter einer Litanei von blauen Flecken und Narben verschwunden.",shape=box,color=blue];
		j2432121336 -> j523798304;
	j2682414398 [label="+20 Chemistry",color=orange];
		j2682414398 -> j155054802;
	j523798304 [label="Aber was sie verlangten, dass ich für sie tue ...? Und wozu sie mit in dieser dunkelsten aller Nächte zwingen wollten ...?",shape=box,color=blue];
		j523798304 -> j829613110;
	j155054802 [label="Lass es dir gut gehen, Drifter. Wir sprechen uns bald wieder.",shape=box,color=blue];
		j155054802 -> j3031733020;
	j829613110 [label="Ich war kaum mehr als ein Junge, wohl kaum ein Mann. Vielleicht gerade sechzehn? Achtzehn? Zuerst dachte ich, es sei alles ein neuer, schrecklicher Albtraum, nur ein verzerrter Traum.",shape=box,color=blue];
		j829613110 -> j1195587027;
	j3031733020 [label="-Pater Lyon Allard",shape=box,color=blue];
		j3031733020 -> j370687875;
	j1195587027 [label="Gestalten standen um mich herum, hagere und verzerrte Erscheinungen, die nur aus Bosheit und Schatten bestanden.",shape=box,color=blue];
		j1195587027 -> j1374575686;
	j1374575686 [label="Sie verspotten mich, verlangen von mir zu tun, was getan werden musste, dass diejenigen, die mich liebten, nur mein Fleisch haben wollten und warum ich im Gegenzug ihres nehmen sollte ...",shape=box,color=blue];
		j1374575686 -> j2382528690;
	j2382528690 [label="Als ich aus dem Albtraum erwachte oder vielleicht war ich auch die ganze Zeit wach, ich weiß es wirklich nicht, hatte ich ein Jagdmesser in der Hand. Und ich stand vor der Tür zum Zimmer meiner Eltern.",shape=box,color=blue];
		j2382528690 -> j1207095745;
	j1207095745 [label="Es war Neumond. Die Wolken hingen dicht. Es gab nicht das geringste Licht, das etwas erhellt hätte. Die Dunkelheit war absolut.",shape=box,color=blue];
		j1207095745 -> j4070439456;
	j4070439456 [label="Lua hatte mich verlassen.",shape=box,color=blue];
		j4070439456 -> j2803085420;
	j2803085420 [label="Ich konnte dem Ruf der Stimmen nicht folgen. Ich konnte ihnen die Seelen meiner Mutter und meines Vaters nicht geben.",shape=box,color=blue];
		j2803085420 -> j3786546643;
	j3786546643 [label="Ich floh in die leere Nacht. In die tiefen Wälder, die Zweige rissen meine nackte Haut auf, aber der Schmerz war mich völlig gleichgültig.",shape=box,color=blue];
		j3786546643 -> j2756497077;
	j2756497077 [label="Ich rannte, bis meine Beine unter mir zusammenbrachen und mich nicht weiter tragen konnten. Vielleicht habe ich geweint, ich weiß es nicht.",shape=box,color=blue];
		j2756497077 -> j2889001738;
	j2889001738 [label="Aber die Manifestationen waren mir gefolgt. Und sie dürsteten immer noch nach Blut.",shape=box,color=blue];
		j2889001738 -> j179361038;
	j179361038 [label="Ich hatte gehofft, wenn ich sie nicht sehen könnte, dass sie dann verschwinden würden ... als ich mir das Messer in die Augenhöhle rammte ...",shape=box,color=blue];
		j179361038 -> j1117819466;
	j1117819466 [label="Es ist eine Schande, dass ich ohnmächtig wurde und meine Aufgabe nicht vollenden konnte. Jetzt werde ich es nie erfahren.",shape=box,color=blue];
		j1117819466 -> j3831671512;
	j3831671512 [label="Als ich aufwachte, war ich in der örtlichen Pfarrei von Lua. Ein Bruder hatte mich gefunden und meine Wunden versorgt. Er fragte mich, wovor ich weggelaufen war.",shape=box,color=blue];
		j3831671512 -> j3581184947;
	j3581184947 [label="Ich war erschöpft. Ich konnte ihn nicht belügen. Ich gestand ihm alles ... die Visionen und was sie mir befohlen. Ich rechnete mit Verurteilung.",shape=box,color=blue];
		j3581184947 -> j1415188359;
	j1415188359 [label="Als ich fertig war, lächelte er mit solch wissender Traurigkeit und legte mir ein Amulett von Lua in die Hand. \"Sie ist Segen und Fluch zugleich, mein Sohn.\"",shape=box,color=blue];
		j1415188359 -> j335100993;
	j335100993 [label="Er schickte mich zur Kathedrale in der Cité de la Lumière. Und dort blieb ich, bis Entrati mich fand ...",shape=box,color=blue];
		j335100993 -> j3279295594;
	j3279295594 [label="Jetzt ... weißt du alles.",shape=box,color=blue];
		j3279295594 -> j2454412960;
	j2454412960 [label="Aber jetzt ... muss ich gehen.",shape=box,color=blue];
		j2454412960 -> j899759413;
	j899759413 [label="Boolean LyonConfession1 is now true.",color=orange];
		j899759413 -> j60939596;
	j60939596 [label="+20 Chemistry",color=orange];
		j60939596 -> j3311435967;
	j3311435967 [label="- Lyon",shape=box,color=blue];
		j3311435967 -> "Chat ends.";
}