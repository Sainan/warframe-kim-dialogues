		j1574114424 -> j2862131335;
	j2049358715 [label="Dreh dich um und verlasse den Raum in deinen Gedanken.",shape=box,color=red];
		j2049358715 -> j2694910659;
	j775000027 [label="Ich sehe M. Necraloid und höre die Geschichten über M. Ordis oder M. Otak. Ich denke an die leeren Warframes, deren Gedanken aus ihren Schädeln gerissen wurden.",shape=box,color=blue];
		j775000027 -> j798816541;
