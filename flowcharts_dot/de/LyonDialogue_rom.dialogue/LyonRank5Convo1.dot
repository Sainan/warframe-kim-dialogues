		j798816541 -> j1357383545 [label=true,color=green];
		j798816541 -> j1596804237 [label=false,color=brown];
	j61303417 [label="Danke ... aber ich frage mich, wie lange es dauern würde, bis die Trauer nur eine weitere Last werden würde, die mit der Zeit leichter zu ertragen ist.",shape=box,color=blue];
		j61303417 -> j775000027;
	j2228720352 [label="Evaluate expressions",color=orange];
		j2228720352 -> j395527685 [label="DrifterLiar",color=purple];
		j2228720352 -> j2166650944 [label="LyonNoDate",color=purple];
		j2228720352 -> j429931300 [label="false",color=purple];
	j3125100806 [label="Ich muss dich um Vergebung bitten. Es gibt Momente, in denen meine Gedanken verworren sind und ich verabscheue es, wenn andere dies miterleben.",shape=box,color=blue];
		j3125100806 -> j1242024200;
	j1357383545 [label="Es wäre so einfach, nachzugeben. Aufzugeben. Meine Qualen am Altar des Leidens niederzulegen und nichts mehr zu sagen.",shape=box,color=blue];
		j1357383545 -> j1927450679;
	j1596804237 [label="Es wäre so einfach, nachzugeben. Aufzugeben. Meine Qualen am Altar des Leidens niederzulegen und nichts mehr zu sagen. Oder Schlimmeres zu tun, etwas, was viele befürchtet haben, dass ich es mit einem Messer in der Dunkelheit der Nacht tun könnte.",shape=box,color=blue];
		j1596804237 -> j1927450679;
	j395527685 [label="Da gibt es ... nur ein Problem, Drifter. Wie kann ich deinen Worten Wahrheit beimessen, wenn ich weiß, dass du schon früher Lügen verbreitet hast.",shape=box,color=blue];
		j395527685 -> j2678287569;
