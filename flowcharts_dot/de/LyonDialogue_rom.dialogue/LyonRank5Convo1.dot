	j3746556343 [label="Durchatmen, Lyon. Atmen. Sie sind nicht wirklich da.",shape=box,color=red];
		j3746556343 -> j4202610603;
	j1098538253 [label="Ich ... es tut mir leid, Lyon. Konzentrier dich auf den Bildschirm, ich bin hier.",shape=box,color=red];
		j1098538253 -> j3642292672;
	j2858127800 [label="Es ist eine furchtbare Last, die dir aufgebürdet wurde. Und vielleicht ist es Unrecht, aber ich sehe keinen Ausweg.",shape=box,color=red];
		j2858127800 -> j2968235813;
	j996551631 [label="Du bedeutest Marie alles. Und du bist mir so ein guter Freund geworden. Ich denke, sogar Roathe würde dich vermissen, obwohl der das nicht zugeben würde.",shape=box,color=red];
		j996551631 -> j588255091;
	j1062799977 [label="[Gefühle gestehen.] Es würde mir das Herz brechen, wenn du das zulassen würdest, Lyon. Ich ... sorge mich um dich.",shape=box,color=red];
		j1062799977 -> j2316571309;
	j4202610603 [label="und da liegst du falsch\nsie sind da\nund sie werden mich nie allein lassen\nnie wieder\ndafür hat entrati gesorgt\nvergib mir",shape=box,color=blue];
		j4202610603 -> j2862131335;
	j3642292672 [label="zerreißen mein fleisch\nschälen es von meinen knochen\nwarum? wozu?\nwessen hunger wird gestillt?",shape=box,color=blue];
		j3642292672 -> j2044660938;
		j3642292672 -> j2889248009;
	j2968235813 [label="Nicht ohne ... auf das Undenkbare zurückzugreifen. Oder ... das.",shape=box,color=red];
		j2968235813 -> j2879452720;
	j588255091 [label="Du wirst geschätzt. Du wirst geliebt. Du hast Familie und Freunde. Auch wenn es sich nicht immer so anfühlt.",shape=box,color=red];
		j588255091 -> j4228151897;
	j2316571309 [label="Das ... ist nicht dein Ernst. Das kannst du nicht ernst meinen, nachdem, was du gerade erlebt hast? Entweder hast du den Verstand verloren oder dein Mitleid hat dich übermannt.",shape=box,color=blue];
		j2316571309 -> j1090126753;
		j2316571309 -> j202836861;
	j2862131335 [label="+10 Chemistry",color=orange];
		j2862131335 -> j4006363057;
	j2044660938 [label="Niemandes. Du brauchst nicht mehr zu leiden. Lass los.",shape=box,color=red];
		j2044660938 -> j1574114424;
	j2889248009 [label="Ich weiß. Ich weiß, dass es weh tut. Es tut mir leid. Es tut mir so leid. Verlasse den Raum.",shape=box,color=red];
		j2889248009 -> j2049358715;
	j2879452720 [label="+10 Chemistry",color=orange];
		j2879452720 -> j775000027;
	j4228151897 [label="Du bist nicht allein, Lyon. Und man würde dich vermissen.",shape=box,color=red];
		j4228151897 -> j2869725063;
	j1090126753 [label="Nein, Lyon, ich meine es ernst. Du bedeutest mir alles und ich wünschte, ich könnte dich davon überzeugen.",shape=box,color=red];
