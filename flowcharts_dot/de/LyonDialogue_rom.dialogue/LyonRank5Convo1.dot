		j3626627435 -> j129698615 [label="false",color=purple];
	j3399686224 [label="Du hast erwähnt, dass du über die Tatsache sprechen wolltest, dass ich wirklich nicht glaube, die Gleichgültigkeit sei ein \"wahrer Gott\". Hast du Zeit?",shape=box,color=red];
		j3399686224 -> j4271594658;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j1707665827 [label="Du hast mich neulich nach der konzeptionellen Verkörperung gefragt und nach der Gleichgültigkeit. Stimmt etwas nicht?",shape=box,color=red];
		j1707665827 -> j4125831338;
	j2427263546 [label="Roathe ist davon überzeugt, dass der Mann in der Wand kein wahrer Gott ist. Dass er das Produkt \"Konzeptioneller Verkörperung\" ist. Was denkst du?",shape=box,color=red];
		j2427263546 -> j2633135950;
	j2651369910 [label="Lyon, was geht zwischen dir und Roathe vor? Ich habe bisher nur Bruchstücke aufgeschnappt.",shape=box,color=red];
		j2651369910 -> j1463222635;
	j4271594658 [label="Ich bin mir nicht sicher, ob es überhaupt einen \"guten\" Zeitpunkt dafür gibt, das konkrete Problem zu besprechen, das mir dies bereitet, Drifter.",shape=box,color=blue];
		j4271594658 -> j892911355;
	"Chat ends." [color=orange];
	j4125831338 [label="Es stimmen eine ganze Menge Dinge nicht, Drifter. Das Thema der Gleichgültigkeit und der konzeptionellen Verkörperung ist nur eins davon, fürchte ich.",shape=box,color=blue];
		j4125831338 -> j915876020;
	j2633135950 [label="Das Problem ist, Drifter, dass ich keine Ahnung habe. Wenn ich die Antwort wüsste, würde ich mich nicht selbst mit so einem inneren Kampf quälen.",shape=box,color=blue];
		j2633135950 -> j308759708;
	j1463222635 [label="Ich fasse es zusammen, obwohl es mich überrascht, dass du Roathes Tiraden darüber nicht mitbekommen hast. Er nutzt jede Gelegenheit, seine Theorien mit jedem zu teilen, der vorbeikommt.",shape=box,color=blue];
		j1463222635 -> j137605820;
	j892911355 [label="Aber damit ist jetzt ein genauso \"guter\" Zeitpunkt, wie jeder andere. Es hat mich überrascht, dass du dich auf Roathes Seite geschlagen hast mit der Ansicht, dass die Gleichgültigkeit kein wahrer Gott ist.",shape=box,color=blue];
		j892911355 -> j308759708;
	j915876020 [label="Oder vielleicht zwei, je nachdem, wie man die Situation betrachtet. Aber ich nehme an, dass es sich dabei um den Kern meines Dilemmas handelt.",shape=box,color=blue];
		j915876020 -> j308759708;
	j308759708 [label="Aber ich ... sollte von vorne anfangen. Du kannst nicht verstehen, warum gerade dieses Thema so wichtig für mich ist, wenn du keinen Zusammenhang hast ...",shape=box,color=blue];
		j308759708 -> j3073180163;
	j137605820 [label="Er glaubt nicht, dass die Gleichgültigkeit in irgendeiner Form ein Gott des Voids ist, sondern vielmehr von Entrati erschaffen wurde und all jenen, die danach mit ihr interagiert haben ...",shape=box,color=blue];
		j137605820 -> j3717203246;
	j3073180163 [label="Ich bin ein Bruder von Lua. Ich habe mein Leben ihrer Verehrung gewidmet. Dies habe ich mein ganzes Leben lang geglaubt.",shape=box,color=blue];
		j3073180163 -> j461212902;
	j3717203246 [label="... geschaffen aus dem Void durch das, was du als \"Konzeptionelle Verkörperung\" kennst.",shape=box,color=blue];
		j3717203246 -> j2148160751;
	j461212902 [label="Über all die Jahre, seit ich der Kirche beitrat, habe ich an meinem Glauben festgehalten, an der festen Überzeugung, dass mein Leiden, meine Schmerzen und meine Visionen ...",shape=box,color=blue];
		j461212902 -> j938733451;
	j2148160751 [label="Ganz ähnlich, wie du Duviri erschaffen hast, denke ich.",shape=box,color=blue];
		j2148160751 -> j308759708;
	j938733451 [label="- ihr gedient haben. In ihrem Namen und für ihren Zweck.",shape=box,color=blue];
		j938733451 -> j1152527587;
	j1152527587 [label="Zumindest bis ... \"Cardinal Dimanche\" sich als Albrecht Entrati zu erkennen gab.",shape=box,color=blue];
		j1152527587 -> j2577367265;
	j2577367265 [label="Bis er uns die Wahrheit über seine Identität erzählte, seine Verfehlungen mit dem Void und alles, was daraus wurde. Genauer gesagt ... was daraus hervorging.",shape=box,color=blue];
		j2577367265 -> j1427773761;
		j2577367265 -> j2963138693;
	j1427773761 [label="Die Gleichgültigkeit.",shape=box,color=red];
		j1427773761 -> j1415494898;
	j2963138693 [label="Und?",shape=box,color=red];
		j2963138693 -> j1162590500;
	j1415494898 [label="Genau. Er erzählte uns von dem höhnischen Ding, das ihn begrüßte, von den Fingern, die er von dem Ort zurückholte, der wie sein Labor aussah.",shape=box,color=blue];
		j1415494898 -> j1685513278;
	j1162590500 [label="Er erzählte uns von seinem Abstieg in der Buntglas-Glocke, hinein in die Leere. Von dem Ort, der aussah, wie sein Labor.",shape=box,color=blue];
		j1162590500 -> j1685513278;
	j1685513278 [label="Darüber hinaus erzählte er uns von der tiefen Unruhe, die er gefühlt hat, wissend, dass das Ding, das er entfesselt hatte, ihm nicht nur durch Raum, sondern auch durch die Zeit folgen konnte.",shape=box,color=blue];
		j1685513278 -> j3441446047;
	j3441446047 [label="Ein Gott des Nichts. Ein Ding, das gebändigt werden muss. Eine Kreatur, von der er Teile hatte, die an den Wänden kratzten, um befreit zu werden.",shape=box,color=blue];
		j3441446047 -> j3799641906;
	j3799641906 [label="Ein schrecklicher und verschlingender Gott, der gleichzeitig frei und gefangen war.",shape=box,color=blue];
		j3799641906 -> j2947784192;
		j3799641906 -> j1775982567;
	j2947784192 [label="Was meinst du?",shape=box,color=red];
		j2947784192 -> j3826452011;
	j1775982567 [label="Gleichzeitig \"frei\" und \"gefangen\"?",shape=box,color=red];
		j1775982567 -> j3826452011;
	j3826452011 [label="Check boolean LyonRell1",color=orange];
		j3826452011 -> j2071660143 [label=true,color=green];
		j3826452011 -> j1454540595 [label=false,color=brown];
	j2071660143 [label="Zeit ist ... verworren, für jemanden wie mich, in dem Zustand, in dem ich jetzt bin. Es ist schwer zu beschreiben. Ich habe es mal versucht und ich machte das nicht besonders gut.",shape=box,color=blue];
		j2071660143 -> j4058943982;
	j1454540595 [label="Zeit ist ... verworren, für jemanden wie mich, in dem Zustand, in dem ich jetzt bin. Es ist schwer zu beschreiben und ich mache das nicht besonders gut.",shape=box,color=blue];
		j1454540595 -> j4058943982;
	j4058943982 [label="Ich würde die Einzelheiten lieber ein anderes Mal erläutern, da dies nicht der Punkt dessen ist, worauf wir heute hinaus wollen.",shape=box,color=blue];
		j4058943982 -> j366078008;
	j366078008 [label="Check boolean LyonRell1",color=orange];
		j366078008 -> j3154123474 [label=true,color=green];
