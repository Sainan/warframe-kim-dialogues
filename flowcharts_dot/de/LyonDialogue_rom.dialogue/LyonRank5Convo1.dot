		j2869725063 -> j61303417;
	j981353560 [label="Ich ...",shape=box,color=blue];
		j981353560 -> j2228720352;
	j3492803949 [label="Gut. Ich bin froh, dass du dich von deinem eigenen Moment des Irrsinns befreit hast. Es muss doch ansteckend sein. Wir sollten eine Pause von diesem Gerät einlegen, ich fürchte es hat begonnen, dein Hirn zu verfaulen.",shape=box,color=blue];
		j3492803949 -> "Chat ends.";
	j2694910659 [label="ja\nsie werden zu einer anderen zeit dort sein\ndiese kammer aus blut und ketten\naus warten\newiges warten",shape=box,color=blue];
		j2694910659 -> j3125100806;
