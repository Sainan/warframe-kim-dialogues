		j366078008 -> j678043020 [label=false,color=brown];
	j3154123474 [label="Aber falls du Rell hörst oder gehört hast ... würde ich gerne darüber sprechen.",shape=box,color=red];
		j3154123474 -> j4274233174;
	j316988320 [label="Ok, du hast das Sagen.",shape=box,color=red];
		j316988320 -> j324529270;
	j678043020 [label="Aber ich möchte schon mehr darüber erfahren ...",shape=box,color=red];
		j678043020 -> j2725148259;
	j4274233174 [label="Ich weiß. Und ich habe wirklich versucht, dieses Thema zu vermeiden. Alleine sein Name ...",shape=box,color=blue];
		j4274233174 -> j950314043;
	j324529270 [label="Ich weiß, ich habe dieses Thema bisher sträflich vernachlässigt und es tut mir leid. Aber es wird mich vermutlich in eine Vision schicken, von der ich mich nicht so schnell erholen werde.",shape=box,color=blue];
		j324529270 -> j1198745452;
	j2725148259 [label="Ich versichere dir, das wirst du. Ich weiß, ich habe dieses Thema bisher sträflich vernachlässigt und es tut mir leid. Aber es wird mich vermutlich in eine Vision schicken, von der ich mich nicht so schnell erholen werde.",shape=box,color=blue];
		j2725148259 -> j1198745452;
	j950314043 [label="... ist genug, um ...",shape=box,color=blue];
		j950314043 -> j2084469927;
	j1198745452 [label="Ich möchte diese Unterhaltung nicht schon wieder abbrechen müssen, da ich sie aufgrund meiner eigenen Schwächen nicht fortsetzen kann.",shape=box,color=blue];
		j1198745452 -> j325485231;
		j1198745452 -> j3385830070;
		j1198745452 -> j219905218;
	j2084469927 [label="... Bilder eines Mannes in Ketten zu beschwören ...",shape=box,color=blue];
		j2084469927 -> j1615320941;
	j325485231 [label="Ich glaube nicht, dass ich jemanden, der so viel durchgemacht, als \"schwach\" bezeichnen würde, Lyon.",shape=box,color=red];
		j325485231 -> j2322465296;
	j3385830070 [label="Schwach ist ein furchtbarer Ausdruck für \"geplagt von Visionen, um die er nicht gebeten hat\". Aber, wie du meinst.",shape=box,color=red];
		j3385830070 -> j2322465296;
	j219905218 [label="Du weißt, wozu du fähig bist, also folge ich deinem Beispiel.",shape=box,color=red];
		j219905218 -> j2032014163;
	j1615320941 [label="... blutig ...",shape=box,color=blue];
		j1615320941 -> j2740089443;
	j2322465296 [label="Ich weiß die Geste zu schätzen. Aber ich weiß, dass ich sogar an guten Tagen nur ein zerbrochenes Buntglasfenster bin. Ich stehe hier und frage mich, wo so viele Bruchstücke abgeblieben sind.",shape=box,color=blue];
		j2322465296 -> j35785286;
	j2032014163 [label="Danke. Deine Geduld fasziniert mich. Ich weiß die Geste zu schätzen. Aber ich weiß, dass ich sogar an guten Tagen nur ein zerbrochenes Buntglasfenster bin. Ich stehe hier und frage mich, wo so viele Bruchstücke abgeblieben sind.",shape=box,color=blue];
		j2032014163 -> j35785286;
	j2740089443 [label="... gemeißelte Sehnen und Fleisch ...",shape=box,color=blue];
		j2740089443 -> j395659407;
	j35785286 [label="Jedes Mal, wenn ich eins finde, dass ich verloren habe, ist es wahrscheinlicher, dass ich mich schneide, als dass es mir hilft, es wieder an seinen Platz zu legen.",shape=box,color=blue];
		j35785286 -> j3733490242;
	j395659407 [label="... bitte mach, dass es aufhört ...",shape=box,color=blue];
		j395659407 -> j3733846019;
	j3733490242 [label="Manchmal frage ich mich, ob es nicht besser wäre, einer dieser Harrows mit leerem Blick zu werden, die ich im Geiste sehe und die so weit reichen, wie meine Albträume es erlauben.",shape=box,color=blue];
		j3733490242 -> j3090338735;
	j3733846019 [label="ihre gesicher\nunzählige tausende\nleer und gebrochen\ngefangen in stille\nauf ewig zerschmetterte gebete\nwas aus mir werden wird",shape=box,color=blue];
		j3733846019 -> j3746556343;
