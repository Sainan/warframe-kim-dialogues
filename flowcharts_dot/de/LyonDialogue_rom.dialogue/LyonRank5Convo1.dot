		j1242024200 -> j1866791401 [label="false",color=purple];
		j1242024200 -> j311962305 [label="false",color=purple];
	j1927450679 [label="Aber das ... ist ... nicht, wer ich bin. Und das werde ich auch nie sein. Ich werde ... dieses zerbrochene Bollwerk bleiben, dieser zerbrochene Schild ...",shape=box,color=blue];
		j1927450679 -> j982542737;
	j2678287569 [label="Ich habe dich bereits beim Lügen ertappt. Ich kenne zwar nicht den Sinn dieser Lüge, aber ich fürchte, du hast mein Vertrauen in dich bereits zerstört.",shape=box,color=blue];
		j2678287569 -> j964453239;
	j780993537 [label="Das ist nicht völlig ungewöhnlich in meinem Fall, aber ich fühle mich, als sollte ich auf eine ...",shape=box,color=blue];
		j780993537 -> j323678719;
	j1443804265 [label="Willst du lieber aufhören? Oder kannst du weitermachen? Ich verstehe beides.",shape=box,color=red];
		j1443804265 -> j395117520;
	j311962305 [label="Es ist alles in Ordnung. Ich bin für dich da. Wird alles wieder gut?",shape=box,color=red];
		j311962305 -> j1647331886;
	j1866791401 [label="[Gefühle gestehen.] Lyon, ich ... ich sorge mich um dich. Ich möchte hier sein für dich, in diesen Momenten, falls du mich lässt.",shape=box,color=red];
		j1866791401 -> j1226613885;
	j982542737 [label="Immer blutend, niemals sterbend ...",shape=box,color=blue];
		j982542737 -> j3627938888;
	j964453239 [label="Und obwohl ich sehr geschmeichelt bin, fürchte ich, meine Antwort ist ein einfaches und unmissverständliches -",shape=box,color=blue];
		j964453239 -> j1545080119;
	j323678719 [label="... clevere Art antworten oder zumindest auf eine Art, die dieser Situation angemessen ist und dir nicht ...",shape=box,color=blue];
		j323678719 -> j2810920452;
	j395117520 [label="Ich kann weitermachen, danke. Sie sind vorbei, sie gehen immer vorbei. Diese ... Visionen sind wie Wolken, die über Lua hinwegziehen. Sie können in ihrer Dunkelheit vollkommen sein, aber oft sind sie nur von kurzer Dauer.",shape=box,color=blue];
