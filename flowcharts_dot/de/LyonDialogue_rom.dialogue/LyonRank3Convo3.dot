digraph {
	"LyonRank3Convo3 begins." [color=orange];
		"LyonRank3Convo3 begins." -> j2368759916;
	j2368759916 [label="Ich habe M. Loid dabei geholfen, in der Bibliothek Bücher wieder in die Regale zu räumen, obwohl er darauf bestanden hat, dass diese fliegenden ... Apparaturen das auch erledigen könnten - ",shape=box,color=blue];
		j2368759916 -> j257183899;
	j257183899 [label="Dabei habe ich einen kuriosen Band mit Kindergeschichten gefunden, die in einer fiktiven Welt spielen und der von einer gewissen Euleria Entrati verfasst wurde.",shape=box,color=blue];
		j257183899 -> j2885078683;
	j2885078683 [label="Als ich bemerkte, dass der Nachname des Autors der wahre Name unseres \"Cardinal Dimanche\" ist, hab ich den Band sofort für mich beiseite gelegt.",shape=box,color=blue];
		j2885078683 -> j164340542;
		j2885078683 -> j2028763352;
		j2885078683 -> j4221938618;
	j164340542 [label="Ich glaube, ich weiß, auf welches Buch du dich beziehst...",shape=box,color=red];
		j164340542 -> j595698068;
	j2028763352 [label="Können wir das Geplänkel überspringen, bitte? Frag einfache, was du wissen möchtest.",shape=box,color=red];
		j2028763352 -> j3162983652;
	j4221938618 [label="[Ignorieren.]",shape=box,color=red];
		j4221938618 -> "Chat ends.";
	j595698068 [label="+5 Chemistry",color=orange];
		j595698068 -> j3921629961;
	j3162983652 [label="Boolean LyonMITW1 is now true.",color=orange];
		j3162983652 -> j1422147136;
	"Chat ends." [color=orange];
	j3921629961 [label="Das würde ich annehmen, angesichts des entsetzten Blicks, den M. Loid mir zugeworfen hat und seiner Aufforderung, das Buch sofort zurückzugeben, \"bevor ich dich beunruhige\", dass du etwas darüber weißt.",shape=box,color=blue];
		j3921629961 -> j3288069000;
	j1422147136 [label="Meine Frage bezieht sich auf das Wesen der \"Konzeptionellen Verkörperung\". Nach der Lektüre wurde mir bewusst, dass das Buch den Kindern beibringen soll, ihre Emotionen nicht mit dem Void interagieren zu lassen.",shape=box,color=blue];
		j1422147136 -> j3116566882;
		j1422147136 -> j652828723;
	j3288069000 [label="\"Die Geschichten aus Duviri\". Obwohl ich eine recht ... ausdauernde und langwierige Erklärung von M. Loid darüber erhalten habe, was du durchgemacht hast, gibt eine bestimmte Angelegenheit, zu der ich eine Frage hätte.",shape=box,color=blue];
		j3288069000 -> j3800658141;
	j3116566882 [label="Es hat nur nicht viel geholfen. Vor allem in meinem Fall.",shape=box,color=red];
		j3116566882 -> j1034358284;
	j652828723 [label="Wenn starke Gefühle mit dem Void interagieren, kann dies zu ... schweren Problemen führen.",shape=box,color=red];
		j652828723 -> j381970864;
	j3800658141 [label="Natürlich nur, falls es nicht zu beunruhigen ist?",shape=box,color=blue];
		j3800658141 -> j432888443;
		j3800658141 -> j716096554;
	j1034358284 [label="Wie viel unseres Lebens von anderen als Tatsache vorgegeben wurde, nur um sich als nutzlos herauszustellen, wenn es getestet wird?",shape=box,color=blue];
		j1034358284 -> j2675951675;
	j381970864 [label="So it seems. I have met the Cavia. I have been told of Void Angels. I have seen the Murmur first-hand. ",shape=box,color=blue];
		j381970864 -> j1318277998;
	j432888443 [label="Nein. Ich höre.",shape=box,color=red];
		j432888443 -> j3162983652;
	j716096554 [label="Das hängt ganz von den Einzelheiten ab, nehme ich an. Ich weiß nicht, was du mich fragen willst.",shape=box,color=red];
		j716096554 -> j32130481;
	j2675951675 [label="Boolean LyonFaith1 is now true.",color=orange];
		j2675951675 -> j1672912499;
	j1318277998 [label="Und darum geht es bei meiner Neugier. Ich habe darüber \"laut\" nachgedacht, um zu sehen, ob du darauf näher eingehen könntest. Wenn der Void Form annimmt, was aus ihm herauskommt ... ist es \"real\"?",shape=box,color=blue];
		j1318277998 -> j970426806;
		j1318277998 -> j3025008245;
		j1318277998 -> j20967194;
	j32130481 [label="+5 Chemistry",color=orange];
		j32130481 -> j3918040455;
	j1672912499 [label="Ich frage mich oft, warum man anderen solch unnütze Lügen einredet? Geht es um Macht? Einfluss? Oder meinst du, sie glauben ihren eigenen Worten und sind sich ihrer eigenen Unwahrheiten nicht bewusst?",shape=box,color=blue];
		j1672912499 -> j2087056009;
		j1672912499 -> j3591610452;
	j970426806 [label="Nein, ich glaube, dass alles, was vom Void geschaffen wird ... vergänglich ist. Ein Bruchstück dessen, wer oder was etwas erschaffen hat. Der Schatten einer Erinnerung.",shape=box,color=red];
		j970426806 -> j1088573939;
	j3025008245 [label="Ich glaube schon, ja. Wie ein Gemälde eines Künstlers, es mag im Geist einer Person entstanden sein, aber sobald es geschaffen wurde, ist es real.",shape=box,color=red];
		j3025008245 -> j877234817;
	j20967194 [label="Das hängt völlig von deiner Definition von \"real\" ab.",shape=box,color=red];
		j20967194 -> j756147033;
	j3918040455 [label="Ja, verzeih mir. Ich bin nicht geübt darin, mich einfach ... direkt zu unterhalten. Vor allem bei einer so seltsamen Methode, wie dieser hier. Aber ich werde mich jetzt darum bemühen.",shape=box,color=blue];
		j3918040455 -> j3162983652;
	j2087056009 [label="In diesem Fall glaube ich, dass Euleria Entrati mit dem, was sie geschrieben hat, etwas Nützliches bezwecken wollte. Es hat mir jedoch einfach nicht geholfen, als ich es gebraucht habe.",shape=box,color=red];
		j2087056009 -> j152745003;
	j3591610452 [label="Ich weiß nicht, welche Lügen man dir erzählt hat, Lyon?",shape=box,color=red];
		j3591610452 -> j4181829687;
	j1088573939 [label="Sind dann die Effekte, die von diesem Void-Elementen verursacht werden, auch nicht \"real\"?",shape=box,color=blue];
		j1088573939 -> j3978079512;
	j877234817 [label="Aber deine Analogie ist nicht ganz zutreffend, oder? Materie, die aus dem Void gewonnen wurde, kehr auch zum Void zurück, oder nicht?",shape=box,color=blue];
		j877234817 -> j842852038;
	j756147033 [label="+5 Chemistry",color=orange];
		j756147033 -> j1625088286;
	j152745003 [label="Zu ihrer Verteidigung, ich war dem Void wesentlich länger ausgesetzt, als es vorgesehen und wofür ihr Buch als Leitfaden gedacht war.",shape=box,color=red];
		j152745003 -> j2272314177;
	j4181829687 [label="Keine, die ich mit dir besprechen möchte.",shape=box,color=blue];
		j4181829687 -> "Chat ends.";
	j3978079512 [label="So manche Erinnerung hat einen Mann zur Flasche getrieben oder ihn dazu gebracht, sich das Leben zu nehmen. Solche Erinnerung sind nicht \"real\"?",shape=box,color=blue];
		j3978079512 -> j528194245;
	j842852038 [label="Nun gut, dann ein Gedanke. Ein Gedicht oder ein Lied existiert auch dann, wenn es nicht niedergeschrieben wurde.",shape=box,color=red];
		j842852038 -> j3596236441;
	j1625088286 [label="Kannst du das erläutern?",shape=box,color=blue];
		j1625088286 -> j146907272;
	j2272314177 [label="+5 Chemistry",color=orange];
		j2272314177 -> j1648308096;
	j528194245 [label="Mein Punkt ist, dass es sich dabei um interne Kräfte gehandelt hat, die jemand auf sich wirken sich. Keine externen Kräfte.",shape=box,color=red];
		j528194245 -> j2035008771;
	j3596236441 [label="Aber wenn sie vergessen werden, hören sie auf zu existieren. Eine Geschichte, die im Lauf der Zeit verloren geht, ist für immer verloren.",shape=box,color=blue];
		j3596236441 -> j1111535081;
	j146907272 [label="Wie misst man \"Echtheit\"?",shape=box,color=red];
		j146907272 -> j1608338273;
		j146907272 -> j2246467299;
		j146907272 -> j1375089391;
	j1648308096 [label="Unglückliche Unwissenheit ist das Beste, worauf einer von uns hoffen kann, und sie könnte die Bösartigkeit anderer hervorrufen.",shape=box,color=blue];
		j1648308096 -> j1495363517;
	j2035008771 [label="Meine Frage lautet dabei, was ist der Unterschied? Spielt es überhaupt eine Rolle, wenn das Endergebnis dasselbe ist?",shape=box,color=blue];
		j2035008771 -> j4088273863;
		j2035008771 -> j2020561585;
		j2035008771 -> j928036257;
	j1111535081 [label="Eine Revolution, die nur in den Köpfen derer vorhanden ist, die über sie nachdenken, ist nur ein stumpfes Schwert.",shape=box,color=blue];
		j1111535081 -> j4088273863;
		j1111535081 -> j2020561585;
		j1111535081 -> j928036257;
	j1608338273 [label="Durch physische Beständigkeit? Gewicht und Masse? Was aus dem Void kam, ist nur temporär hier.",shape=box,color=red];
		j1608338273 -> j1502166931;
	j2246467299 [label="Durch seine Wirkung auf Ereignisse? Was aus dem Void gekommen ist, hat den Pfad der Geschichte verändert.",shape=box,color=red];
		j2246467299 -> j2956004761;
	j1375089391 [label="Durch die Wirkung auf andere? Der Einfluss von \"Dingen\", die aus dem Void stammen, ist durchaus vorhanden.",shape=box,color=red];
		j1375089391 -> j2561327393;
	j1495363517 [label="Meine Neugier gilt jedoch nicht dem Buch oder seinem Nutzen. Verzeih mir den kurzen poetischen Ausflug.",shape=box,color=blue];
		j1495363517 -> j1255577773;
	j4088273863 [label="Du fragst nich danach, ob sie \"real\" sind, du fragst nach ihrer \"Gültigkeit\". Ob sie verworfen werden sollten oder nicht.",shape=box,color=red];
		j4088273863 -> j1763604553;
	j2020561585 [label="Dann könnte ich auch fragen, ob deine Himmlischen \"real\" sind, wenn du Sol und Lua nicht einmal die Hand schütteln kannst.",shape=box,color=red];
		j2020561585 -> j1447534415;
	j928036257 [label="Du fragst im Prinzip auf Umwegen, ob alle \"Dinge\" aus dem Void nur deshalb existieren, weil unser Wille sie ins Leben gerufen hat.",shape=box,color=red];
		j928036257 -> j3092803787;
	j1502166931 [label="Also du sagst, was aus dem Void kam, muss auch dorthin zurückkehren? Aber besteht der Void, per Definition, nicht aus Nichts?",shape=box,color=blue];
		j1502166931 -> j2389443027;
	j2956004761 [label="Ein guter Einwand. Ist eine Revolution etwas nicht \"real\", weil man sie nicht in einen Korb leben und wiegen kann?",shape=box,color=blue];
		j2956004761 -> j2561327393;
	j2561327393 [label="Sie hat schon viele Seelen den Kopf gekostet. Sie würden ihre Gültigkeit durchaus verteidigen. Trotzdem, bedenke Folgendes:",shape=box,color=blue];
		j2561327393 -> j2550828886;
	j1255577773 [label="Ich habe darüber \"laut\" nachgedacht, um zu sehen, ob du darauf näher eingehen könntest. Wenn der Void Form annimmt, was aus ihm herauskommt ... ist es \"real\"?",shape=box,color=blue];
		j1255577773 -> j970426806;
		j1255577773 -> j20967194;
		j1255577773 -> j3025008245;
	j1763604553 [label="+5 Chemistry",color=orange];
		j1763604553 -> j2625675289;
	j1447534415 [label="Wir sprechen nicht über die Himmlischen. Wir sprechen über den Void.",shape=box,color=blue];
		j1447534415 -> j1133107428;
		j1447534415 -> j2212533250;
		j1447534415 -> j3377257909;
		j1447534415 -> j1951972396;
	j3092803787 [label="+5 Chemistry",color=orange];
		j3092803787 -> j1966705437;
	j2389443027 [label="Vermutlich? Die Teile des Voids, mit denen ich interagiert habe, schienen bereits geprägt zu sein. Ihnen wurde bereits eine Art Form gegeben. Oder vielleicht haben wir die Grenze zwischen den Realitäten zu sehr verwischt.",shape=box,color=red];
		j2389443027 -> j2021073293;
		j2389443027 -> j2692087048;
	j2550828886 [label="Eine Revolution erhält ihre Gültigkeit nur durch ihre Existenz in den Köpfen derer, die sie ersonnen haben.",shape=box,color=blue];
		j2550828886 -> j2743851708;
	j2625675289 [label="Ja, ich denke, so könnte man es ausdrücken. Sollten wir die Geister, die unsere Hallen heimsuchen, ignorieren, oder verstärken wir sie etwa noch, indem wir ihnen Beachtung schenken?",shape=box,color=blue];
		j2625675289 -> j1133107428;
		j2625675289 -> j2212533250;
		j2625675289 -> j3377257909;
		j2625675289 -> j1951972396;
	j1133107428 [label="Ich glaube, dass die Herausforderungen, vor denen wir momentan stehen, gefährlich sind. Sehr gefährlich. Und so sollten wir sie auch behandeln.",shape=box,color=red];
		j1133107428 -> j2548526416;
	j2212533250 [label="Geister sind real genug, um uns Schmerzen zuzufügen. Aber man kann sie nicht mit Kugeln bekämpfen. Jedenfalls nicht mit denen, die ich kenne.",shape=box,color=red];
		j2212533250 -> j1449782176;
	j3377257909 [label="Was soll das Ganze, Lyon? Worum geht es?",shape=box,color=red];
		j3377257909 -> j3367528472;
	j1951972396 [label="Ich kann es wirklich nicht sagen, Lyon. Ich wünschte, ich könnte es.",shape=box,color=red];
		j1951972396 -> j747433435;
	j1966705437 [label="Ja, ich denke, so könnte man es ausdrücken. Wie können wir sicher sein, dass wir nicht ... unsere eigenen Dämonen ins Leben gerufen haben?",shape=box,color=blue];
		j1966705437 -> j1133107428;
		j1966705437 -> j2212533250;
		j1966705437 -> j3377257909;
		j1966705437 -> j1951972396;
	j2021073293 [label="Ganze Strukturen, sogar Lua selbst, wurden im Void platziert und wieder zurückgeholt. Es verbraucht also nicht einfach Materie, die darin existiert.",shape=box,color=red];
		j2021073293 -> j3511975114;
	j2692087048 [label="Was du implizierst, ist die Existenz eines \"tieferen\" Void, in dem nichts existieren kann und dazu kann ich mich nicht äußern.",shape=box,color=red];
		j2692087048 -> j1949316947;
	j2743851708 [label="Würde sie aus den Gedanken derer um sie herum gelöscht, würde sie aufhören zu existieren, nicht wahr?",shape=box,color=blue];
		j2743851708 -> j2020561585;
		j2743851708 -> j4088273863;
		j2743851708 -> j928036257;
	j2548526416 [label="Boolean LyonReal1 is now true.",color=orange];
		j2548526416 -> j367119188;
	j1449782176 [label="Boolean LyonFake1 is now true.",color=orange];
		j1449782176 -> j1739424946;
	j3367528472 [label="Boolean LyonFaith1 is now true.",color=orange];
		j3367528472 -> j1448790368;
	j747433435 [label="Deine Ehrlichkeit zuzugeben, dass du etwas nicht weißt, ist erfrischend. Hätten nur mehr Menschen diese Gabe.",shape=box,color=blue];
		j747433435 -> j3029809852;
	j3511975114 [label="Es geht mir nicht um Materie, die im Void platziert und wieder daraus hervorgeholt wurde. Es geht mir darum, was aus dem Void, dem reinen Nichts, erschaffen wurde.",shape=box,color=blue];
		j3511975114 -> j4088273863;
		j3511975114 -> j2020561585;
		j3511975114 -> j928036257;
	j1949316947 [label="Ich schätze deine Offenheit. Ich nehme an, ich bin weniger daran interessiert, was nicht existieren kann, als an dem, was jetzt existiert.",shape=box,color=blue];
		j1949316947 -> j4088273863;
		j1949316947 -> j2020561585;
		j1949316947 -> j928036257;
	j367119188 [label="Ja, ich nehme an, du müsstest wissen, was aus dem Void man mit Gewalt begegnen kann und was nicht ...",shape=box,color=blue];
		j367119188 -> j2148193595;
	j1739424946 [label="Vielleicht greifen deshalb so viele zu Exzessen ... um eine blutende Wunde zu stillen, die man nicht sieht, die aber trotzdem schmerzt. Heilbar. Aber durch die Stärke der Seele, nicht durch Waffen.",shape=box,color=blue];
		j1739424946 -> j2148193595;
	j1448790368 [label="Ich bin dieses Thema offensichtlich falsch angegangen. Wir sprechen ein anderes Mal darüber. Vergib mir die Störung.",shape=box,color=blue];
		j1448790368 -> j1599833162;
	j3029809852 [label="Wie auch immer, ich bin in dieser Angelegenheit immer noch sehr unschlüssig.",shape=box,color=blue];
		j3029809852 -> j1448790368;
	j2148193595 [label="Obwohl ich, wie immer, noch Zweifel habe. Verzeih mir die Störung. Danke für deine Zeit, Drifter.",shape=box,color=blue];
		j2148193595 -> j1599833162;
	j1599833162 [label="-Pater Lyon Allard",shape=box,color=blue];
		j1599833162 -> "Chat ends.";
}