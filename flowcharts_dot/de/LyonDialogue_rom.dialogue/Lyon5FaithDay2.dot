		j3287457751 -> j2882204172 [label="DrifterFaithAgnostic",color=purple];
		j3287457751 -> j2273686173 [label="DrifterFaithNoFear",color=purple];
		j3287457751 -> j1898923461 [label="DrifterFaithNoMITW",color=purple];
		j3287457751 -> j2273686173 [label="DrifterFaithNoMaybe",color=purple];
		j3287457751 -> j261936803 [label="false",color=purple];
	j242579553 [label="Wo Sol den Schmerz wegbrennen würde, wie ein glühendes Messer eine Wunde veröden kann ... würde Lua wollen, dass ich die Wärme des Schmerzes umarme, den mir seine Abwesenheit bringen könnte.",shape=box,color=blue];
		j242579553 -> j2446136569;
	j1401971357 [label="Und ich weiß, wäre es mir immer noch möglich Rell zu finden und die Präsenz seines Harrows, würden sie nicht wollen, dass ich über ihren Verlust verzweifle. Sie haben Frieden gefunden.",shape=box,color=blue];
		j1401971357 -> j3993975539;
	j54314197 [label="Oh, Lyon ... du hast so viel durchgemacht. Zweifel sind nicht die Folge von Schwäche, sie sind die Folge von Schmerz.",shape=box,color=red];
		j54314197 -> j1249384550;
		j54314197 -> j2385876160;
		j54314197 -> j2090785078;
		j54314197 -> j2107653692;
		j54314197 -> j4199872005;
	j1135767056 [label="Glaube muss nicht gleichbleibend sein und das wird auch nicht erwartet. Wie viele Geschichten gibt es über jemanden, der seinen Glauben verliert und ihn dann wiederfindet?",shape=box,color=red];
		j1135767056 -> j1249384550;
		j1135767056 -> j2385876160;
		j1135767056 -> j2090785078;
	j43045969 [label="Du hast dein Leben den Himmlischen gewidmet, Lyon. Glaubst du, sie würden sich wegen so etwas von dir abwenden?",shape=box,color=red];
		j43045969 -> j1249384550;
		j43045969 -> j2385876160;
		j43045969 -> j2090785078;
	j2882204172 [label="Ich weiß nicht, ob es Götter gibt oder nicht, Lyon, aber ich glaube nicht, dass wir es je wirklich wissen werden. Was ich aber weiß ist, dass du viel durchgemacht hast.",shape=box,color=red];
		j2882204172 -> j1249384550;
		j2882204172 -> j2090785078;
		j2882204172 -> j2107653692;
	j2273686173 [label="Während ich persönlich nicht glaube, dass es Götter gibt, weiß ich doch, wie wichtig es für dich in deinem Leben ist. Das möchte ich nicht kleinreden.",shape=box,color=red];
		j2273686173 -> j2090785078;
		j2273686173 -> j4199872005;
	j1898923461 [label="Die Gleichgültigkeit wurde von uns geschaffen, sie ist kein Gott, Lyon. Lass nicht zu, dass Entratis Fehler dich zerstört. Und was deinen Glauben angeht?",shape=box,color=red];
		j1898923461 -> j2090785078;
		j1898923461 -> j4199872005;
	j261936803 [label="Ich hasse es, dich so zu sehen, mitten in jedermanns Unsinn. Das hast du nicht verdient.",shape=box,color=red];
		j261936803 -> j1249384550;
		j261936803 -> j2385876160;
		j261936803 -> j2090785078;
		j261936803 -> j2107653692;
		j261936803 -> j4199872005;
	j2446136569 [label="Denn es ist die Abwesenheit von Schmerz, die uns zu zerstören droht, so wie ein Übermaß und erdrücken könnte.",shape=box,color=blue];
		j2446136569 -> j2424250518;
		j2446136569 -> j2204884081;
		j2446136569 -> j1132094242;
	j3993975539 [label="Noch glaube ich, dass mein ganzes Leid umsonst war. Das, was ich durchgemacht habe, wurde nicht ungültig gemacht.",shape=box,color=blue];
		j3993975539 -> j463597956;
	j1249384550 [label="Ich sage nicht, dass du deinen Glauben wiederfinden musst. Ich sage nur, wenn du ihn wiederfinden willst oder das Gefühl hast, ihn zu brauchen, dass er nicht auf ewig verloren ist.",shape=box,color=red];
		j1249384550 -> j1700935993;
	j2385876160 [label="Sicherlich kann Lua sehen, was du durchgemacht hast. Was du in ihrem Namen ertragen hast.",shape=box,color=red];
		j2385876160 -> j274500294;
	j2090785078 [label="Ich glaube, du solltest dich darauf konzentrieren, eine Art inneren Frieden zu finden, wie auch immer du ihn finden kannst.",shape=box,color=red];
		j2090785078 -> j1700935993;
	j2107653692 [label="Falls es einen Gott gibt, falls Lua existiert ... kann sie sicher sehen, was du durchgemacht hast. Was du in ihrem Namen ertragen hast. Dass muss ihr etwas bedeuten.",shape=box,color=red];
		j2107653692 -> j274500294;
	j4199872005 [label="Ich glaube, du solltest dich von der Vorstellung verabschieden, dass es Götter gibt oder auch nicht, und dich darauf konzentrieren, dich zunächst selbst zu heilen.",shape=box,color=red];
		j4199872005 -> j2642792231;
	j2424250518 [label="Glaub mir ... ich weiß, wie gefährlich Apathie sein kann.",shape=box,color=red];
		j2424250518 -> j2523011586;
	j2204884081 [label="Bedeutet das, dass du deinen Glauben wiedergefunden hast?",shape=box,color=red];
		j2204884081 -> j1302362034;
	j1132094242 [label="[Ende.]",shape=box,color=red];
		j1132094242 -> j3856020424;
