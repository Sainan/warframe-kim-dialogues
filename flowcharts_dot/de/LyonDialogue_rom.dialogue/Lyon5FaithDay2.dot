	j1539918576 [label="Ich habe über die Natur unserer Unterhaltung von gestern nachgedacht. Und was es bedeutet, dass Rell und Harrow so unerbittlich Teil meines Lebens sind ...",shape=box,color=blue];
		j1539918576 -> j3920221179;
	j657711922 [label="Ich habe über die Natur unserer Unterhaltung von gestern nachgedacht. Und was es bedeutet, dass Rell und Harrow so unerbittlich Teil meines Lebens sind ...",shape=box,color=blue];
