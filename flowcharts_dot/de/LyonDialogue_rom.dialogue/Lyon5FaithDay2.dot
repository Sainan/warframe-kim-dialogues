		j2642792231 -> j188801445;
	j2523011586 [label="So scheint es.",shape=box,color=blue];
		j2523011586 -> j1119507377;
	j1302362034 [label="Schwer zu sagen. Ich weiß nicht, ob Glaube etwas ist, das jemand wie ich jemals wirklich \"gefunden\" oder \"verloren\" hat, oder vielmehr etwas, das man immer wieder neu sucht. Immer wieder hinterfragt ... immer wieder auf der Suche nach Antworten.",shape=box,color=blue];
		j1302362034 -> j4210804018;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j2691574626 [label="Bedeutet das, dass du deinen Glauben aufgegeben hast?",shape=box,color=red];
		j2691574626 -> j1302362034;
	j2685480975 [label="Ich denke darüber nach, was es bedeutet, dass Rell und Harrow so unerbittlich Teil meines Lebens sind ...",shape=box,color=blue];
		j2685480975 -> j1528958664;
	j1344721425 [label="Ich denke an die Jahre, die ich im Dienst einer Organisation verbracht habe, die im Inneren Gutes in der Welt vollbringen wollte ... was es bedeutet, dass Rell und Harrow so unerbittlich Teil meines Lebens sind ...",shape=box,color=blue];
		j1344721425 -> j1079451939;
	j188801445 [label="Ich denke darüber nach, was es bedeutet, dass Rell und Harrow so unerbittlich Teil meines Lebens sind ...",shape=box,color=blue];
		j188801445 -> j17324261;
	j1119507377 [label="Ich weiß nicht, ob Glaube etwas ist, das jemand wie ich jemals wirklich \"gefunden\" oder \"verloren\" hat, oder vielmehr etwas, das man immer wieder neu sucht. Immer wieder hinterfragt ... immer wieder auf der Suche nach Antworten.",shape=box,color=blue];
		j1119507377 -> j4210804018;
	j4210804018 [label="Aber ich glaube, dass es , wie bei Schmerzen, darum geht, eine Balance zu finden, damit man weder erdrückt wird, noch sich so daran gewöhnt, dass man immun und gefühllos wird.",shape=box,color=blue];
		j4210804018 -> j1286686499;
	j1528958664 [label="Nur, damit ihre Gegenwart erneut aus meiner Seele gerissen wird und nur als Erinnerung zurückbleibt. Ich weiß nicht, ob es bedeutet, dass es in unserer Welt Götter gibt oder nicht.",shape=box,color=blue];
		j1528958664 -> j3963851554;
