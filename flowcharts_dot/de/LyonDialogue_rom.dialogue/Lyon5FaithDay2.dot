		j1286686499 -> j405136973 [label=false,color=brown];
		j1286686499 -> j4082155497 [label=false,color=brown];
	j3572737391 [label="Vielleicht hast du recht. Vielleicht würde nur unsere Silberne Frau einen solch tragischen Segen spenden.  Sie würde nicht die Erinnerung an Schmerz entfernen wollen, wie es mit Roathe geschehen ist.",shape=box,color=blue];
		j3572737391 -> j174325546;
	j2889777604 [label="Dann stimmst du mir und Roathe zu, dass der Mann in der Wand kein richtiger Gott ist?",shape=box,color=red];
		j2889777604 -> j947546059;
	j4082155497 [label="Wo siehst du die Gleichgültigkeit in alle dem?",shape=box,color=red];
		j4082155497 -> j795192422;
	j405136973 [label="Stellst du dich dann auf Roathe Seite, wenn es darum geht, ob die Gleichgültigkeit ein wirklicher Gott ist oder nicht?",shape=box,color=red];
		j405136973 -> j947546059;
	j947546059 [label="Ich bin mir in dieser Angelegenheit immer noch nicht sicher. Mir fehlen die Beweise, um eine Entscheidung zu treffen. Aber ich nehme an, es macht keinen großen Unterschied, oder?",shape=box,color=blue];
		j947546059 -> j415576678;
		j947546059 -> j1435745944;
	j795192422 [label="Ob die Gleichgültigkeit ein Gott ist oder nicht? Ich bin mir in dieser Angelegenheit immer noch nicht sicher. Mir fehlen die Beweise, um eine Entscheidung zu treffen. Aber ich nehme an, es macht keinen großen Unterschied, oder?",shape=box,color=blue];
		j795192422 -> j415576678;
		j795192422 -> j1435745944;
	j415576678 [label="Ich glaube, es ändert eine Menge. Ist sie kein wahrer Gott, wurde sie von Menschen erschaffen. Das bedeutet auch, sie kann von Menschen besiegt werden.",shape=box,color=red];
		j415576678 -> j2032924566;
	j1435745944 [label="Was genau meinst du?",shape=box,color=red];
		j1435745944 -> j2743623512;
	j2032924566 [label="Wenn es keine Hoffnung gäbe, dass sie durch unsere Bemühungen besiegt werden kann, warum sich dann erst gegen sie stellen? Du bist wahrlich eine rätselhafte Kreatur.",shape=box,color=blue];
		j2032924566 -> j672632880;
	j2743623512 [label="Die Art und Weise, wie sie in unser Universum gelangt ist, ändert nichts an der Methode, mit der wir sie besiegen.",shape=box,color=blue];
		j2743623512 -> j1323090638;
	j672632880 [label="Du kannst diese Worte nicht ernst meinen. Folgst du dann einfach dem, was andere tun? Du kämpfst, weil du nichts Besseres mit deiner Zeit anzufangen weißt?",shape=box,color=blue];
		j672632880 -> j1540494903;
	j1323090638 [label="Denn siehe: ein Gott unserer Schöpfung, geschaffen aus dem Stoff unserer eigenen Leere.",shape=box,color=blue];
		j1323090638 -> j533136089;
	j1540494903 [label="Du kannst dir doch sicher ein besseres Hobby ausdenken.",shape=box,color=blue];
		j1540494903 -> j2645738526;
		j1540494903 -> j1980992255;
	j533136089 [label="Eine Stoffpuppe, die wir mit Trauer, Kummer, Schmerz, Wut und Qualen vollstopfen, bis die Nähte zu platzen drohen.",shape=box,color=blue];
		j533136089 -> j2802058740;
	j2645738526 [label="Nein, ich dachte nicht, dass es hoffnungslos sie ... das ist nicht, was ich gemeint habe.",shape=box,color=red];
		j2645738526 -> j795481404;
	j1980992255 [label="Was ich damit sagen wollte, war, dass dies die Sichtweise darauf ändert, wie wir sie besiegen können. Sie verstehen können.",shape=box,color=red];
		j1980992255 -> j1123372223;
	j2802058740 [label="Du wirst mir verzeihen, wenn mich das mit weitaus mehr Schrecken erfüllte, als wenn es sich vor unserer Ankunft wirklich um einen Gott gehandelt hätte.",shape=box,color=blue];
		j2802058740 -> j2400884467;
	j795481404 [label="Nachzudenken, bevor man Worte in die Welt setzt, ist keine Voraussetzung. Das gilt auch für Kugeln.",shape=box,color=blue];
		j795481404 -> j1323090638;
	j1123372223 [label="Ich glaube nicht, dass dies stimmt. Ich würde argumentieren, dass wir jetzt genauso wenig über ihre Beweggründe wissen, als wenn sie eine \"große und unerkennbare Gottheit\" wäre.",shape=box,color=blue];
		j1123372223 -> j1323090638;
	j2400884467 [label="In der Tat würde ich das sogar bevorzugen.",shape=box,color=blue];
		j2400884467 -> j4221908111;
	j4221908111 [label="Es besteht vielleicht die Hoffnung, dass sie intelligenter ist, als die Menschheit im Allgemeinen.",shape=box,color=blue];
		j4221908111 -> j4279392435;
	j4279392435 [label="Und mit diesem ... wahrlich düsteren Gedanken verabschiede ich mich für heute.",shape=box,color=blue];
		j4279392435 -> j742749064;
