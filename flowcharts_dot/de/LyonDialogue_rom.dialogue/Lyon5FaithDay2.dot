		j752153009 -> j1394701999;
	j2161545557 [label="Es gibt etwas, worüber ich mit dir reden wollte und ich habe jetzt erst die Gelegenheit dazu. Als ... Rell, Harrow und ich miteinander verwoben wurden ... das wie und warum ist nicht wichtig ...",shape=box,color=blue];
		j2161545557 -> j3769774194;
	"Chat ends." [color=orange];
	j3920221179 [label="Nur, damit ihre Gegenwart erneut aus meiner Seele gerissen wird und nur als Erinnerung zurückbleibt. Und ob das vielleicht ein Geschenk von Lua war ...",shape=box,color=blue];
		j3920221179 -> j322204525;
	j3046433254 [label="Nur, damit ihre Gegenwart erneut aus meiner Seele gerissen wird und nur als Erinnerung zurückbleibt. Und du hast recht. Es könnte bedeuten, dass es in unserer Welt keine Götter gibt.",shape=box,color=blue];
		j3046433254 -> j616190676;
	j1394701999 [label="Nur, damit ihre Gegenwart erneut aus meiner Seele gerissen wird und nur als Erinnerung zurückbleibt. Ich weiß nicht, ob es bedeutet, dass es in unserer Welt Götter gibt oder nicht.",shape=box,color=blue];
		j1394701999 -> j3963851554;
	j3769774194 [label="... wurde ich mit ihrer Vergangenheit verstrickt, so, wie meiner verstrickt wurden. Sie sah alles von der Zariman Ten Zero, Bruchstücke des Alten Krieges und genauso sahen sie, wie meine Vergangenheit aussah.",shape=box,color=blue];
		j3769774194 -> j1258162467;
	j322204525 [label="Mir ist klar geworden, dass nur unsere Silberne Frau einen solch tragischen Segen spenden würde.  Sie würde nicht die Erinnerung an Schmerz entfernen wollen, wie es mit Roathe geschehen ist.",shape=box,color=blue];
		j322204525 -> j174325546;
	j616190676 [label="Aber ich glaube, dass ändert nichts an den Jahren, die ich im Dienst einer Organisation verbracht habe, die tief im Inneren Gutes in dieser Welt vollbringen wollte.",shape=box,color=blue];
		j616190676 -> j2440835637;
	j3963851554 [label="Wie du bereits gesagt hast ... vielleicht werden wir es nie wissen. Vielleicht ist es nicht an uns, es zu wissen. Aber ich glaube, dass ändert nichts an den Jahren, die ich im Dienst einer Organisation verbracht habe, die tief im Inneren Gutes in dieser Welt vollbringen wollte.",shape=box,color=blue];
		j3963851554 -> j2440835637;
	j1258162467 [label="Es ... wurden eine Menge Dinge für mich infrage gestellt, vor allem ... mein Glaube. Er zerfiel, wie verkohltes Papier, das sich ... in Staub verwandelt. Ich verabscheue mich, für diese Schwäche ...",shape=box,color=blue];
		j1258162467 -> j3287457751;
	j174325546 [label="Noch würde sie den Schmerz der Hiebe von meinem Fleisch nehmen. Es ist nicht ihre Art, mich vor der Trauer über seinen Tod zu schützen.",shape=box,color=blue];
		j174325546 -> j242579553;
	j2440835637 [label="Um denen zu helfen, die den Schmerz in ihrem Leben lindern möchten, in den Momenten, wo er sie erdrücken könnte.",shape=box,color=blue];
		j2440835637 -> j1401971357;
	j3287457751 [label="Evaluate expressions",color=orange];
		j3287457751 -> j54314197 [label="LyonDating",color=purple];
		j3287457751 -> j1135767056 [label="DrifterFaithYesSimilar",color=purple];
		j3287457751 -> j1135767056 [label="DrifterFaithYesForeign",color=purple];
		j3287457751 -> j1135767056 [label="DrifterFaithPersonal",color=purple];
		j3287457751 -> j43045969 [label="DrifterFaithSol",color=purple];
		j3287457751 -> j43045969 [label="DrifterFaithLua",color=purple];
