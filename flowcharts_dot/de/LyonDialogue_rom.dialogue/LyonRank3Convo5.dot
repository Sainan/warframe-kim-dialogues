digraph {
	445 [label="LyonRank3Convo5 begins.",color=orange];
		445 -> 446;
	446 [label="Es gab einen Gewittersturm in der Nacht, als \"Cardinal Dimanche\" zu uns kam. Er stand im Altarraum der Kirche, unberührt von dem Unwetter, das draußen tobte.",shape=box,color=blue];
		446 -> 447;
	447 [label="Schon das hätte Anlass zur Sorge sein sollen. Stattdessen neigte ich mein Haupt und begrüßte ihn, wie einen neuen Gesandten der Heiligen Mutter.",shape=box,color=blue];
		447 -> 448;
	448 [label="Immerhin erwarteten wir einen neuen Cardinal, da der letzte vor einigen Monaten krankheitsbedingt ausgeschieden war.",shape=box,color=blue];
		448 -> 449;
	449 [label="Dimanche begrüßte mich mit einem warmen Lächeln und einem festen Händedruck. Ich frage ihn, ob er eine lange Reise gehabt hätte. Seine Antwort werde ich nie vergessen.",shape=box,color=blue];
		449 -> 450;
	450 [label="\"Sie war schwierig… aber nicht lang.\"",shape=box,color=blue];
		450 -> 451;
	451 [label="Damals verwunderte sie mich und auch die Tatsache, dass sein Mantel knochentrocken war. Aber ich tat es ab, wie man das eben macht, wenn etwas keinen Sinn ergibt.",shape=box,color=blue];
		451 -> 452;
	452 [label="Ich hatte auch keine Zeit, darüber nachzudenken, da Marie in ihrem Eifer nur einen Moment später erschien.",shape=box,color=blue];
		452 -> 453;
	453 [label="Er kniete sich hin, um sie in ihrem Stuhl auf Augenhöhe zu begrüßen und nahme ihre Hände in seine. Ich hätte die Manipulation als solche erkennen müssen.",shape=box,color=blue];
		453 -> 454;
	454 [label="Immerhin war er nicht der einzige Teufel, der in einem Sturm bei uns erschien.",shape=box,color=blue];
		454 -> 455;
	455 [label="Update boolean LyonEntrati1",color=orange];
		455 -> 456;
	456 [label="Check boolean MarieEntrati1",color=orange];
		456 -> 457 [label=true,color=green];
		456 -> 459 [label=true,color=green];
		456 -> 460 [label=true,color=green];
		456 -> 458 [label=false,color=brown];
		456 -> 457 [label=false,color=brown];
	457 [label="Der andere Teufel war Roathe?",shape=box,color=red];
		457 -> 461;
	459 [label="Sie erzählt diese Geschichte völlig anders.",shape=box,color=red];
		459 -> 463;
	460 [label="Sie glaubt immer noch an seine guten Absichten. Und du?",shape=box,color=red];
		460 -> 464;
	458 [label="Ich nehmen an, du bist kein Verbündeter von Entrati?",shape=box,color=red];
		458 -> 462;
	461 [label="Ja, aber das ist eine Geschichte für einen anderen Tag. Wenn ich anfange, über ihn zu sprechen, wird meine ohnehin schlechte Laune ...",shape=box,color=blue];
		461 -> 465;
	463 [label="Ja. Das würde sie.",shape=box,color=blue];
		463 -> 467;
		463 -> 468;
	464 [label="+5 Chemistry",color=orange];
		464 -> 469;
	462 [label="Nachdem wir seine Lügen und seinen Verrat erdulden mussten und wir weiterhin seine Manipulation von Marie erleben, sollte ich einer sein? Nein, ganz sicher nicht.",shape=box,color=blue];
		462 -> 466;
	465 [label="... haltlos. Ich würde meine jetzige Laune viel lieber auf Entratis Missetaten lenken, wenn es dir nichts ausmacht.",shape=box,color=blue];
		465 -> 470;
	467 [label="Sie hat mir erzählt, dass du manchmal Dinge siehst, die andere nicht sehen.",shape=box,color=red];
		467 -> 472;
	468 [label="Und? ",shape=box,color=red];
		468 -> 473;
	469 [label="Marie glaubt an das Beste in allen Seelen. Es ist eine Fähigkeit, die sie verfeinert, perfektioniert und poliert hat, als Schutzschild gegen die Welt um sie herum.",shape=box,color=blue];
		469 -> 474;
		469 -> 475;
	466 [label="+5 Chemistry",color=orange];
		466 -> 471;
	470 [label="Check boolean RoatheSerum1",color=orange];
		470 -> 476 [label=true,color=green];
		470 -> 477 [label=true,color=green];
		470 -> 476 [label=false,color=brown];
		470 -> 478 [label=false,color=brown];
	472 [label="Und was würdest du aus dieser Aussage machen, Drifter, wenn sie wahr wäre?",shape=box,color=blue];
		472 -> 480;
	473 [label="\"Und\" nichts weiter. Ich habe dir gesagt, wie ich die Ereignis erlebt habe, die Wahrheit meiner Erfahrung. Nichts weiter.",shape=box,color=blue];
		473 -> 469;
	474 [label="Marie kennt nicht alle Fakten darüber, wozu Entrati wirklich fähig ist, und über all die entsetzlichen Dinge, die er im Namen des \"Fortschritts\" getan hat und nun im Namen der \"Erlösung\" tut.",shape=box,color=red];
		474 -> 481;
	475 [label="Marie ist eine erwachsene Frau. Ich bewundere zwar dein Verlangen, sie zu beschützen, aber sie kann selbst entscheiden, was sie glaubt und wem sie vertraut.",shape=box,color=red];
		475 -> 482;
	471 [label="Er verunreinigt unsere Körper, zerstört unsere Zukunft und korrumpiert unsere Vergangenheit ... all das könnte ich vielleicht vergeben.",shape=box,color=blue];
		471 -> 479;
	476 [label="Entrati hat vielleicht nicht die besten Umgangsformen, aber er versucht, das Universum zu retten.",shape=box,color=red];
		476 -> 471;
	477 [label="Hat er dich gezwungen, ein Protoframe zu werden, wie Roathe?",shape=box,color=red];
		477 -> 483;
	478 [label="Natürlich. Warum bist du wütend auf Entrati?",shape=box,color=red];
		478 -> 484;
	480 [label="Check boolean LyonVisions1",color=orange];
		480 -> 486 [label=true,color=green];
		480 -> 488 [label=true,color=green];
		480 -> 489 [label=true,color=green];
		480 -> 486 [label=false,color=brown];
		480 -> 487 [label=false,color=brown];
		480 -> 488 [label=false,color=brown];
	481 [label="Vertrauen ist ein Buntglasfenster. Filigran in seiner Entstehung. Wunderschön in seiner Pracht. Tragisch im Zerbrechen. Und sobald es zerstört ist, gefährlich.",shape=box,color=blue];
		481 -> 496;
	482 [label="Vertrauen ist ein Buntglasfenster. Filigran in seiner Entstehung. Wunderschön in seiner Pracht. Tragisch im Zerbrechen. Und sobald es zerstört ist, gefährlich.",shape=box,color=blue];
		482 -> 491;
	479 [label="Aber zu sehen, wie er Marie verdreht hat ... wie er ihren Glauben an die Güte in anderen für seine Zwecke missbraucht hat?",shape=box,color=blue];
		479 -> 485;
	483 [label="Nein. Ich hatte meine Gründe, das Elixier zu akzeptieren. Ich wusste, in was für eine verdrehte Kreatur es mich verwandeln würde. So wie Marie.",shape=box,color=blue];
		483 -> 492;
	484 [label="+5 Chemistry",color=orange];
		484 -> 471;
	486 [label="Ich denke, es ist mir eigentlich ziemlich egal.",shape=box,color=red];
		486 -> 493;
	488 [label="Ich möchte nur wissen, wenn du Dinge siehst, beunruhigen dich diese Visionen?",shape=box,color=red];
		488 -> 495;
	489 [label="Was du neulich gesagt hast ... ich habe mich gefragt, ob mit dir alles in Ordnung ist.",shape=box,color=red];
		489 -> 494;
	487 [label="Ich frage mich nur, ob es dir gut geht, sonst nichts.",shape=box,color=red];
		487 -> 494;
	496 [label="+15 Chemistry",color=orange];
		496 -> 502;
	491 [label="Im warmen Licht von Sol, sonnt sie sich, unfähig die Risse zu sehen, die sich auf der Oberfläche bilden. Unfähig zu hören, dass sie sich vertiefen.",shape=box,color=blue];
		491 -> 497;
	485 [label="Das werde ich ihm nie vergeben. Das möchte ich ihm mit meinem Weihrauchfass aus dem Leib prügeln, bis er um Erlösung fleht.",shape=box,color=blue];
		485 -> 474;
		485 -> 475;
	492 [label="Wir wurden nicht ... gewaltsam gebrochen, so wie der Teufel. Ein Teil meines Herzens hat Mitleid mit Roathe, für das, was er durchmachen musste.",shape=box,color=blue];
		492 -> 498;
	493 [label="Dann sehe ich keinen Grund, diese Unterhaltung fortzusetzen.",shape=box,color=blue];
		493 -> 499;
	495 [label="Ich werde dir ganz direkt sagen, dass ich nicht weiß, was ich darauf antworten soll, Drifter.",shape=box,color=blue];
		495 -> 501;
	494 [label="Update boolean LyonAllRight",color=orange];
		494 -> 500;
	502 [label="Wenn ich nur die Korruption entfernen könnte, die er in ihrem Geist gesät hat. Ich kann nur beten, dass du Erfolg hast, wo ich versagt habe.",shape=box,color=blue];
		502 -> 507;
	497 [label="Unwissend, dass die Scherben ihres eigenen Meisterwerks sich schon bald gegen sie richten. Sie hat sich entschlossen, die Augen vor dem zu verschließen, was unweigerlich folgen wird.",shape=box,color=blue];
		497 -> 503;
	498 [label="Und dann, beginnt er zu sprechen.",shape=box,color=blue];
		498 -> 504;
		498 -> 505;
	499 [label="Chat ends.",color=orange];
	501 [label="In all den Jahren habe ich Gräuel gesehen, die andere in eine Irrenanstalt getrieben hätten. Noch tragischer ist, manchmal wurden meine Visionen Realität.",shape=box,color=blue];
		501 -> 506;
	500 [label="Ob es mir \"gut geht\"? Ich werde dir ganz direkt sagen, dass ich nicht weiß, was ich darauf antworten soll, Drifter.",shape=box,color=blue];
		500 -> 501;
	507 [label="-Pater Lyon Allard",shape=box,color=blue];
		507 -> 513;
	503 [label="Wenn ich nur an ihrer Stelle das Leid ertragen könnte, ich würde es mit Freude auf meine Seele tätowieren lassen. Aber dies ist für sie und nur für sie.",shape=box,color=blue];
		503 -> 508;
	504 [label="Du musst im Hinterkopf behalten, wie er erzogen wurde. Die Umgebung, die er überleben musste. Er war ... ist ... Orokin.",shape=box,color=red];
		504 -> 509;
		504 -> 510;
	505 [label="Eigenlich glaube ich nicht, dass er so furchtbar ist. Er wächst mir ans Herz.",shape=box,color=red];
		505 -> 511;
	506 [label="Update boolean LyonVisions1",color=orange];
		506 -> 512;
	513 [label="Chat ends.",color=orange];
	508 [label="Also werde ich versuchen, diesen Schmerz zu verhindern, Drifter.",shape=box,color=blue];
		508 -> 514;
	509 [label="Das macht es nicht besser, aber es könnte dabei helfen, ihm auf halbem Weg entgegenzukommen.",shape=box,color=red];
		509 -> 515;
	510 [label="Er tut, was glaubt tun zu müssen.",shape=box,color=red];
		510 -> 516;
	511 [label="Ich würde M. Loid um ein Heilmittel für diese Beschwerden bitten, bevor sie sich ausbreiten.",shape=box,color=blue];
		511 -> 517;
		511 -> 518;
	512 [label="Update boolean LyonBackstory1",color=orange];
		512 -> 519;
	514 [label="Und falls du das als Versuch siehst, sie klein zu machen?",shape=box,color=blue];
		514 -> 520;
	515 [label="Add 1 to Thermostat",color=orange];
		515 -> 521;
	516 [label="Add -1 to Thermostat",color=orange];
		516 -> 522;
	517 [label="Der Teufel hat immer einen gewissen Charme.",shape=box,color=red];
		517 -> 523;
	518 [label="Keine Sorge, sein Charme wird mich nicht einwickeln.",shape=box,color=red];
		518 -> 524;
	519 [label="Daher hielt ich sie für Weisungen Luas. Dass die Himmlischen mich auserwählt hätten, eine solche Bürde zu tragen. Zumindest dachte ich das damals. Daher strebte ich danach, Priester zu werden.",shape=box,color=blue];
		519 -> 525;
		519 -> 526;
		519 -> 527;
	520 [label="Dann möge Lua deiner Seele gnädig sein.",shape=box,color=blue];
		520 -> 528;
	521 [label="In unseren heiligen Schriften verhandelt man nicht mit Dämonen, man treibt sie aus. Aber auf diesen besonderen Zustand wurden wir nicht vorbereitet.",shape=box,color=blue];
		521 -> 529;
	522 [label="Vielleicht. Ich bin mir noch nicht sicher, dass es im Herzen dieser Kreatur keinen Zweifel gibt.",shape=box,color=blue];
		522 -> 529;
	523 [label="Add -1 to Thermostat",color=orange];
		523 -> 530;
	524 [label="Add 1 to Thermostat",color=orange];
		524 -> 531;
	525 [label="Du dachtest, die Visionen kämen von Lua? Denkst du das nun nicht mehr?",shape=box,color=red];
		525 -> 532;
	526 [label="Was für Gräuel ...?",shape=box,color=red];
		526 -> 533;
	527 [label="Und was denkst du jetzt darüber?",shape=box,color=red];
		527 -> 534;
	528 [label="-Pater Lyon Allard",shape=box,color=blue];
		528 -> 535;
	529 [label="Mit der Zeit werden wir sehen, welchen Pfad dieser bestimmte Teufel einschlägt, nicht wahr?",shape=box,color=blue];
		529 -> 536;
	530 [label="Und genau das macht mir Sorgen. Der Teufel lächelt und ergibt Sinn, wenn alle anderen Wahnsinn verbreiten.",shape=box,color=blue];
		530 -> 537;
	531 [label="+20 Chemistry",color=orange];
		531 -> 538;
	532 [label="Was ich glaube, ist ... schwierig geworden, in letzter Zeit, durch das Lernen neuer Informationen.",shape=box,color=blue];
		532 -> 534;
	533 [label="Wir haben gerade erst begonnen, uns über solche Dinge zu unterhalten, Drifter. Es ist nicht so, dass ich nicht glaube, dass du schlimmstes Leid aus erster Hand gesehen hast, oder dass ich denke, dass du Schutz vor den dürftigen Beschreibungen benötigst, die ich vielleicht vermitteln könnte.",shape=box,color=blue];
		533 -> 539;
	534 [label="Einfach gesagt, Drifter, es wäre nur ehrlich, wenn ich sage, dass ich nicht weiß, was ich glauben soll.",shape=box,color=blue];
		534 -> 540;
	535 [label="Chat ends.",color=orange];
	536 [label="-Pater Lyon Allard",shape=box,color=blue];
		536 -> 541;
	537 [label="Er erwischt uns, wenn wir es am wenigsten erwarten, wenn wir verletzlich sind. Schwach. Wenn wir Antworten brauchen.",shape=box,color=blue];
		537 -> 542;
		537 -> 543;
	538 [label="Gut. Sieh zu, dass das so bleibt. Ich würde dir nicht gerne Vernunft einprügeln müssen. Du scheinst jemand zu sein, der zurückschlägt.",shape=box,color=blue];
		538 -> 544;
	539 [label="Es ist einfach nur anstrengend, mit jemandem darüber zu sprechen, den ich gerade erst getroffen habe, nur damit sie nie wieder mit mir in Kontakt treten. Das würde ich in einer Situation, in der wir gezwungen sind, miteinander zu arbeiten, zumindest für den Moment, lieber verhindern.",shape=box,color=blue];
		539 -> 545;
		539 -> 546;
	540 [label="Update boolean LyonFaith1",color=orange];
		540 -> 547;
	541 [label="+20 Chemistry",color=orange];
		541 -> 548;
	542 [label="Ich kann auf mich aufpassen. Ich verspreche, er wird mir nicht zu Kopf steigen.",shape=box,color=red];
		542 -> 549;
	543 [label="Es scheint, du sprichst aus Erfahrung. Welche Antworten hat er dir gegeben?",shape=box,color=red];
		543 -> 550;
	544 [label="Und in welch einem seltsamen Zustand würden wir uns dann wiederfinden?",shape=box,color=blue];
		544 -> 551;
	545 [label="Wenn du warten möchtest, bis du mir mehr vertraust, verstehe ich das.",shape=box,color=red];
		545 -> 552;
	546 [label="Ich gehe nirgendwohin, Lyon. Du kannst mir vertrauen.",shape=box,color=red];
		546 -> 553;
	547 [label="Aber ich fürchte, das ist eine Sache für einen anderen Tag.",shape=box,color=blue];
		547 -> 554;
	548 [label="Chat ends.",color=orange];
	549 [label="+20 Chemistry",color=orange];
		549 -> 555;
	550 [label="Welche, die leider ... viele Dinge in Zweifel gezogen haben. Aber ich fürchte, das ist eine Sache für einen anderen Tag.",shape=box,color=blue];
		550 -> 556;
	551 [label="Chat ends.",color=orange];
