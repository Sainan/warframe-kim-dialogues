		554 -> 559;
	555 [label="Gut. Sieh zu, dass das so bleibt. Ich würde dir nicht gerne Vernunft einprügeln müssen. Du scheinst jemand zu sein, der zurückschlägt.",shape=box,color=blue];
		555 -> 560;
	556 [label="Update boolean LyonFaith1",color=orange];
		556 -> 561;
	557 [label="Danke. Es ist nicht so, dass ich die Ernsthaftigkeit dessen, was du schreibst, anzweifle. Aber meine Erfahrungen haben mich einfach etwas anderes gelehrt.",shape=box,color=blue];
		557 -> 559;
	558 [label="Es ist nicht so, dass ich die Ernsthaftigkeit dessen, was du schreibst, anzweifle. Aber meine Erfahrungen haben mich einfach etwas anderes gelehrt.",shape=box,color=blue];
		558 -> 559;
	559 [label="In der Zwischenzeit kann ich dich nur um Vergebung und Geduld bitten.",shape=box,color=blue];
		559 -> 562;
