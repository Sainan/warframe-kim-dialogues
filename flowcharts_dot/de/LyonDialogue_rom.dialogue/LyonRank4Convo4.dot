		1043 -> 1046 [label=false,color=brown];
	1044 [label="Meine Mutter was schon lange tot, bevor wir herkamen. Und jetzt, ist sie nur noch Staub. Sie lebte ein Leben voller Trübsal ... und sie war dazu verdammt, Trübsal zu verbreiten.",shape=box,color=blue];
		1044 -> 1047;
	1046 [label="Ein Kind zu verletzen ... Das ist unverzeihlich.",shape=box,color=red];
		1046 -> 1042;
	1045 [label="Ist das der Grund, warum du ...?",shape=box,color=red];
		1045 -> 1048;
	1047 [label="Sie hatte Angst. Was immer mich plagte, ob es eine Bürde der Götter war, Wahnsinn, ein Fluch, sie konnte einfach nicht damit umgehen.",shape=box,color=blue];
		1047 -> 1049;
	1048 [label="Check boolean LyonLecture2",color=orange];
		1048 -> 1050 [label=true,color=green];
		1048 -> 1051 [label=false,color=brown];
	1049 [label="Doch so grausam meine Mutter auch war? Mein Vater war schlimmer. Ich erspare dir die Einzelheiten.",shape=box,color=blue];
		1049 -> 1052;
	1050 [label="Vielleicht. Ich habe mich oft gefragt, ob es nicht Teil eines Zwangs war. Aber wie ich dir bereits gesagt habe, was es auch eine Methode von Lua.",shape=box,color=blue];
		1050 -> 1053;
	1051 [label="Vielleicht. Ich habe mich oft gefragt, ob es nicht Teil eines Zwangs war. Aber es ist auch eine Methode von Lua, von dem Himmlischen. Ich bin nicht der Einzige, der dies praktiziert.",shape=box,color=blue];
		1051 -> 1054;
	1052 [label="Als ich älter wurde, verwandelten sich die Visionen in Stimmen. Ein Flüstern, dass mich zu jeder Tag- und Nachtzeit erreichte. Wach oder träumend. Meine Arbeit auf der Farm litt darunter und ich litt im Gegenzug.",shape=box,color=blue];
		1052 -> 1055;
		1052 -> 1056;
	1053 [label="+5 Chemistry",color=orange];
