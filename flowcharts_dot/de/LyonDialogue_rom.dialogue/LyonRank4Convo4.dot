		995 -> 999;
	996 [label="Deine ... Wortwahl beunruhigt mich, muss ich zugeben. Obwohl ich nicht weiß, ob du sie so meinst, wie ich sie interpretiere.",shape=box,color=blue];
		996 -> 1000;
		996 -> 1001;
