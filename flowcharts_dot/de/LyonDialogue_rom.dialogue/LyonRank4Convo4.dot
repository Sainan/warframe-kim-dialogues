		986 -> 992;
	993 [label="+5 Chemistry",color=orange];
		993 -> 983;
	997 [label="Ja und das ist es ... was mich zunehmend beunruhigt, muss ich zugeben. Um mich zu beruhigen, bestätige mir bitte, was ich mehr und mehr fürchte, dass du meinen könntest.",shape=box,color=blue];
		997 -> 1000;
