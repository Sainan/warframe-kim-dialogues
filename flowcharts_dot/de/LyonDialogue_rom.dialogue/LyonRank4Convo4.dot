	1055 [label="Was brachte dich zur Kirche?",shape=box,color=red];
		1055 -> 1059;
	1056 [label="Manche Leute sollten keine Eltern sein.",shape=box,color=red];
		1056 -> 1060;
	2233 [label="Ich versichere dir, dass es mir ein wenig Frieden bringt, auch wenn ich weiß, dass es seltsam erscheinen muss, dass es so ist.",shape=box,color=blue];
		2233 -> 1049;
	1058 [label="Einer der Pater in der Kathedrale hat es mir beigebracht, um mir zu helfen ... meinen Geist zu klären. Diejenigen, die von Lua auserwählt werden, werden oft durch Visionen \"gesegnet\".",shape=box,color=blue];
		1058 -> 1061;
	1059 [label="Check boolean LyonPainOff",color=orange];
		1059 -> 1063 [label=true,color=green];
		1059 -> 1062 [label=false,color=brown];
	1060 [label="Ich weiß die Geste zu würdigen, aber ich kann auch nicht unterschätzen, wie schwierig ich als Kind war, vor allem, sobald ich körperlich größer und kräftiger war als sie.",shape=box,color=blue];
		1060 -> 1059;
	1061 [label="Update boolean LyonLecture2",color=orange];
		1061 -> 1049;
	1063 [label="Meine Visionen und die Stimmen verursachten bei mir oft heftige Wutanfälle, Drifter. Mich selbst zu quälen war oft der einzige Weg, mich aus dem zu erwecken, was ich sah.",shape=box,color=blue];
		1063 -> 1064;
	1062 [label="Meine Visionen und die Stimmen verursachten bei mir oft heftige Wutanfälle, Drifter. Ich griff oft zu einem Messer, um mich zu schneiden, denn nur der Schmerz konnte mich daraus erwecken.",shape=box,color=blue];
		1062 -> 1064;
	1064 [label="Aber als die Stimmen mich anwiesen, zu ...",shape=box,color=blue];
		1064 -> 1065;
	1065 [label="Ich ... ich kann nicht. Kann es einfach nicht. Vergib mir. Meine Hände zittern, während ich dies schreibe. Ich muss für den Moment aufhören.",shape=box,color=blue];
		1065 -> 1066;
		1065 -> 1067;
	1066 [label="Natürlich. Das ist in Ordnung, keine Eile. Ich bin jederzeit hier, wenn du bereit bist.",shape=box,color=red];
		1066 -> 1068;
	1067 [label="Ich verstehe, das war bereits sehr viel. Ruh dich aus, ja? Und ... danke. Dies bedeutet mir viel.",shape=box,color=red];
