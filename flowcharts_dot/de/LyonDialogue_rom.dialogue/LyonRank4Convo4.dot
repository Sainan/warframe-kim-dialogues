	1040 [label="Sie war ignorant. Sie wusste es nicht besser.",shape=box,color=red];
		1040 -> 1042;
	1041 [label="Vier, vielleicht. Höchstens sechs. Ich weiß es nicht mehr. Wir hielten unsere Jahre nicht so akribisch fest, wie ihr heute.",shape=box,color=blue];
		1041 -> 1043;
	1042 [label="+5 Chemistry",color=orange];
