	1029 [label="Drei Monate später wurde eine Frau im Dorf tot in ihrem Haus aufgefunden. Ihre Augen waren von Ratten gefressen worden.",shape=box,color=blue];
		1029 -> 1031;
	1030 [label="Drei Monate später wurde eine Frau im Dorf tot in ihrem Haus aufgefunden. Ihre Augen waren von Ratten gefressen worden.",shape=box,color=blue];
		1030 -> 1032;
	1031 [label="Ich habe meiner Mutter davon erzählt, was ich gesehen habe, von der Nacht, in der die Vision mich geweckt hatte. Sie erinnerte sich an das was ich gesehen hatte, genau, wie ich.",shape=box,color=blue];
		1031 -> 1033;
		1031 -> 1034;
	1032 [label="Ja, Drifter. Die Visionen ängstigen mich.",shape=box,color=blue];
		1032 -> 1031;
	1033 [label="Was hat sie getan?",shape=box,color=red];
		1033 -> 1035;
	1034 [label="Dachte sie, es war ein Zufall oder ein Zeichen?",shape=box,color=red];
		1034 -> 1036;
	1035 [label="Sie schlug mich, bis ich nicht mehr stehen konnte. Mein Rücken blutete, bis ich gezwungen war, auf dem Bauch zu schlafen. Ich erinnere mich immer noch an ihre Schreie, während sie mich schlug. \"Diable ! Sorcier !\"",shape=box,color=blue];
		1035 -> 1037;
		1035 -> 1038;
		1035 -> 1039;
		1035 -> 1040;
	1036 [label="Ich weiß es nicht. Ich weiß nur, dass sie schlug mich, bis ich nicht mehr stehen konnte. Mein Rücken blutete, bis ich gezwungen war, auf dem Bauch zu schlafen. Ich erinnere mich immer noch an ihre Schreie, während sie mich schlug. \"Diable ! Sorcier !\"",shape=box,color=blue];
		1036 -> 1037;
		1036 -> 1038;
		1036 -> 1039;
		1036 -> 1040;
	1037 [label="Wie alt warst du?",shape=box,color=red];
