digraph {
	32 [label="LyonRank3Convo2 begins.",color=orange];
		32 -> 33;
	33 [label="Wenn ich darf, würde ich dir gerne die Geschichte einer Straßenkatze erzählen, die immer zur Rückseite der Kirche kam.",shape=box,color=blue];
		33 -> 36;
		33 -> 35;
		33 -> 34;
	36 [label="Mach weiter.",shape=box,color=red];
		36 -> 39;
	35 [label="Warum?",shape=box,color=red];
		35 -> 38;
	34 [label="[Ignorieren.]",shape=box,color=red];
		34 -> 37;
	39 [label="Vielen Dank.",shape=box,color=blue];
		39 -> 41;
	38 [label="Ich fürchte, die Erklärung würde länger dauern, als es das Ganze wert ist.",shape=box,color=blue];
		38 -> 40;
	37 [label="Chat ends.",color=orange];
	41 [label="Obwohl ich annehme, dass eine Geschichte über einen alten Streuner nichts Neues und meine Begegnungen mit ihm nicht bemerkenswert ist, verdient sie es doch, erzählt zu werden.",shape=box,color=blue];
		41 -> 43;
	40 [label="Vergiss es.",shape=box,color=blue];
		40 -> 42;
	43 [label="Er kam jeden Tag vorbei, um nach Resten zu betten oder nach der wenigen Zuneigung, die er von mir oder den anderen Brüdern und Schwestern bekommen konnte.",shape=box,color=blue];
		43 -> 44;
	42 [label="Chat ends.",color=orange];
	44 [label="Er war ein zerlumpter Streuner, der hinkte und dem ein Teil eines Ohres fehlte.",shape=box,color=blue];
		44 -> 45;
	45 [label="Als er einige Tage nicht vorbeikam, war Marie außer sich vor Sorge. Aber was soll man schon für einen alten Streuner tun, der sein Ende gefunden hat, außer ein Gebet an Lua zu richten?",shape=box,color=blue];
		45 -> 46;
	46 [label="Update boolean LyonStray",color=orange];
		46 -> 47;
		46 -> 48;
		46 -> 49;
	47 [label="[Lass ihn weiterreden.]",shape=box,color=red];
		47 -> 50;
	48 [label="Ist das in deiner Religion gestattet? Für Tiere zu beten, meine ich.",shape=box,color=red];
		48 -> 51;
	49 [label="Du würdest für die Seele eines verstorbenen Streuner beten?",shape=box,color=red];
		49 -> 52;
	50 [label="Wie auch immer, stell dir meine Überraschung vor, als ich losging, um Brot vom Markt zu holen, und ich den Streuner neben dem Besitzer des Stands sitzen sah.",shape=box,color=blue];
		50 -> 53;
	51 [label="+10 Chemistry",color=orange];
		51 -> 54;
	52 [label="Natürlich. Einige der reinsten, lichten Seelen, die ich je getroffen habe, waren in den Körper eines Tieres gehüllt. Es steht mir nicht zu, darüber zu urteilen, auf welchen Weg die Himmlischen sie gebracht haben.",shape=box,color=blue];
		52 -> 55;
	53 [label="Er begrüßte mich mit einem rauen Maunzer, wie sonst auch, und sprang herunter, um mir um die Beine zu streichen.",shape=box,color=blue];
		53 -> 56;
	54 [label="Eine gute Frage. In manchen Kapiteln, nein. Es würde als Ketzerei gelten. Aber in unserem, ja. Wir erkennen an, dass Tiere Seelen haben.",shape=box,color=blue];
		54 -> 55;
	55 [label="Die Heilige Elisabeth die Weise war bekannt für ihre Wohltätigkeit gegenüber Tieren, auch wenn viele Traditionen die Heiligen nicht als Apostel der Himmlischen anerkennen.",shape=box,color=blue];
		55 -> 57;
	56 [label="Und ich möchte anmerken, Drifter, dass er dies tat ohne zu humpeln.",shape=box,color=blue];
		56 -> 58;
	57 [label="Ich frage mich, ob irgendwelche Einflüsse unseres Ordens bis heute überlebt haben ... aber das war kaum der Punkt des Gesprächs.",shape=box,color=blue];
		57 -> 59;
	58 [label="\"Ah, noch jemand, den der alte Devereaux zum Narren gehalten hat, wie ich sehe\". Der Mann lachte, als er mein Brot einpackte.",shape=box,color=blue];
		58 -> 60;
	59 [label="Update boolean LyonLecture1",color=orange];
		59 -> 50;
	60 [label="Es stellte sich heraus, dass der alte Kater uns und einigen anderen in der Nachbarschaft nur einen Streich gespielt hatte. Er stand weder kurz vor dem Verhungern, noch war er krank oder in irgendeiner Weise vernachlässigt.",shape=box,color=blue];
		60 -> 61;
	61 [label="Wenn man den Worten des Mannes Glauben schenken durfte, war er stattdessen ein eher mörderischer Dämon, was die einheimische Vogelpopulation anging.",shape=box,color=blue];
		61 -> 62;
		61 -> 63;
		61 -> 64;
	62 [label="Hast du aufgehört, Old Devereaux zu füttern, wenn er vorbeikam?",shape=box,color=red];
		62 -> 65;
	63 [label="Versuchst du,  mich vor Roathe zu warnen?",shape=box,color=red];
		63 -> 66;
	64 [label="Bist du der Streuner in dieser Geschichte?",shape=box,color=red];
		64 -> 67;
	65 [label="+10 Chemistry",color=orange];
		65 -> 68;
	66 [label="Es gibt viele Dinge, vor denen ich dich warnen könnte, die der Teufel \"Cardinal Dimanche\" zu unserer Schwelle geführt hat. Vielleicht gehört dies dazu. Vielleicht auch nicht.",shape=box,color=blue];
		66 -> 69;
	67 [label="Die Himmlischen wissen, dass ich in letzter Zeit etwas mitgenommen bin. Aber soll diese Geschichte eine Warnung vor mir selbst sein? Vielleicht. Vielleicht auch nicht.",shape=box,color=blue];
		67 -> 69;
	68 [label="Nein, haben wir nicht. Tatsächlich hat Marie ihn danach noch herzlicher begrüßt und ihn liebvoll \"ihren kleinen Kobold\" getauft.",shape=box,color=blue];
		68 -> 70;
	69 [label="Es ist nur eine Geschichte, die besagt, wenn ein Wesen in Not zu sein scheint -",shape=box,color=blue];
		69 -> 71;
	70 [label="Aber wir haben uns keine Sorgen mehr um ihn gemacht. Wir wussten, dass Old Devereaux hervorragend für sich selbst sorgen konnte. Er brauchte uns nicht wirklich.",shape=box,color=blue];
		70 -> 72;
		70 -> 73;
	71 [label="+15 Chemistry",color=orange];
		71 -> 74;
	72 [label="Weißt du, was aus Old Devereaux geworden ist?",shape=box,color=red];
		72 -> 75;
	73 [label="Was glaubst du, warum hat Old Devereaux euch besucht, wenn es nicht nötig war?",shape=box,color=red];
		73 -> 76;
	74 [label="- überprüfe, wie scharf seine Klauen sein könnten.",shape=box,color=blue];
		74 -> 77;
	75 [label="Als er das nächste Mal verschwand, zwei Jahre später, blieb er verschwunden.",shape=box,color=blue];
		75 -> 78;
		75 -> 79;
	76 [label="Die zynische Antwort, die ich dir geben könnte, ist \"Gier\". Wenn man ein Festmahl haben kann, warum nicht zwei? Warum nicht zehn?",shape=box,color=blue];
		76 -> 80;
		76 -> 81;
	77 [label="Chat ends.",color=orange];
	78 [label="Hast du für ihn gebetet?",shape=box,color=red];
		78 -> 82;
	79 [label="Ich hoffe er hat diese Welt in Frieden und geliebt verlassen.",shape=box,color=red];
		79 -> 83;
	80 [label="Was wäre eine nicht-zynische Antwort?",shape=box,color=red];
		80 -> 84;
	81 [label="Bleibst du bei der Antwort, auch wenn er nur Zuneigung suchte?",shape=box,color=red];
		81 -> 85;
	82 [label="Ich habe eine Kerze angezündet in der Nacht, als ich von seinem Tod erfuhr und ich betete zu Lua, sie möge seine Seele ... dorthin leiten, wohin auch immer sie einen kleinen Kobold wie ihn leiten würde.",shape=box,color=blue];
		82 -> 86;
	83 [label="Darf ich fragen, warum?",shape=box,color=blue];
		83 -> 87;
		83 -> 88;
	84 [label="+10 Chemistry",color=orange];
		84 -> 89;
	85 [label="Ein habgieriges Verlangen nach Zuneigung ist immer noch Völlerei, auch wenn es kein Hunger ist, der von Fleisch und Wein befriedigt wird. Und unter solch falschen Vorwänden?",shape=box,color=blue];
		85 -> 90;
		85 -> 91;
	86 [label="Ich dankte Old Devereaux für all die Freude, die er Marie im Austausch für heimliche Hühnchenstücke und Kopfkrauler gebracht hatte.",shape=box,color=blue];
		86 -> 92;
	87 [label="Er war ein Tier. Er suchte nur nach Erfüllung ... Nahrung, Schutz, Liebe ... er wurde nicht von denselben Motiven wie Menschen angetrieben. Er hat nicht \"gelogen\", er jagte mit anderen Mitteln.",shape=box,color=red];
		87 -> 93;
	88 [label="Ich habe eine Menge Gewalt gesehen, Lyon. Und ich habe selbst genug verursacht. Ich hoffe inzwischen, dass jeder, egal wer er ist oder was er getan hat, einen friedlichen Tod verdient, im Kreise seiner Lieben.",shape=box,color=red];
		88 -> 94;
	89 [label="Ich empfand einen seltsamen ... Respekt für ihn, für die Platz, den er für sich in dieser Welt gefunden hatte.",shape=box,color=blue];
		89 -> 95;
	90 [label="Er war ein Kater, Lyon. Er wusste wohl kaum, was er tat.",shape=box,color=red];
		90 -> 96;
	91 [label="Wir sprechen immer noch über einen Kater, oder?",shape=box,color=red];
		91 -> 97;
	92 [label="Danke. Ich werden deinen Tag nicht weiter behindern.",shape=box,color=blue];
		92 -> 98;
	93 [label="Er nahm anderen nichts fort, indem er sie zu \"Narren\" machte. Im Gegenteil ... jeder schien durch seine Besuche bereichert worden zu sein.",shape=box,color=red];
		93 -> 99;
	94 [label="Interessant. Ich hätte gedacht, du verachtest deine Feinde. Aber das ist meine eigene Dummheit, zu glauben, dass ich weiß, wie irgendjemand sich in der jetzigen Zeit verhalten würde.",shape=box,color=blue];
		94 -> 100;
	95 [label="Er war eine Kreatur, die gelernt hatte, ihren Zustand, ihr Aussehen, Alter und ihre Narben als Waffen gegen die \"Narren\" um sich herum einzusetzen, die diesen Trick nicht durchschauten.",shape=box,color=blue];
		95 -> 101;
	96 [label="Er wusste genug, um ein Humpeln vorzutäuschen.",shape=box,color=blue];
		96 -> 84;
	97 [label="Du kannst aus diesem Gespräch machen, was du willst, Drifter.",shape=box,color=blue];
		97 -> 84;
	98 [label="-Pater Lyon Allard",shape=box,color=blue];
		98 -> 102;
	99 [label="Add -1 to Thermostat",color=orange];
		99 -> 103;
	100 [label="Add 1 to Thermostat",color=orange];
		100 -> 104;
	101 [label="Ein Kobol mit verfilztem Fell, das war er wirklich. Und trotzdem streichelte ich ihn jedes Mal, wenn er zu Besuch kam.",shape=box,color=blue];
		101 -> 105;
	102 [label="Chat ends.",color=orange];
	103 [label="Ja, das waren wir wohl. Und es mangelte uns nicht an Hühnchenstücken oder Kopfkraulern.",shape=box,color=blue];
		103 -> 106;
	104 [label="Geschweige denn jemand mit deiner faszinierenden Herkunft.",shape=box,color=blue];
		104 -> 107;
	105 [label="Und es brach mir das Herz, als er zwei Jahre später endgültig verschwand.",shape=box,color=blue];
		105 -> 78;
		105 -> 79;
	106 [label="Vielleicht habe ich deshalb eine Kerze für ihn angezündet und gebetet, dass Lua seine Seele ... dorthin leiten möge, wohin auch immer sie einen kleinen Kobold wie ihn leiten würde.",shape=box,color=blue];
		106 -> 108;
	107 [label="+5 Chemistry",color=orange];
		107 -> 109;
	108 [label="+5 Chemistry",color=orange];
		108 -> 110;
	109 [label="Danke. Ich werden deinen Tag nicht weiter behindern. Dies war ein sehr interessantes Gespräch. Bis zum nächsten Mal.",shape=box,color=blue];
		109 -> 111;
	110 [label="Und warum ich Old Devereaux in dieser Nacht für all die Freude dankte, die er Marie gebracht hat.",shape=box,color=blue];
		110 -> 112;
	111 [label="-Pater Lyon Allard",shape=box,color=blue];
		111 -> 113;
	112 [label="Vielleicht brachte seine kleine Schurkerei auf Umwegen doch etwas Gutes.",shape=box,color=blue];
		112 -> 109;
	113 [label="Chat ends.",color=orange];
}