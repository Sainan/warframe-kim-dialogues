	"LyonRank3Convo6 begins." [color=orange];
		"LyonRank3Convo6 begins." -> j1003003424;
		"LyonRank3Convo6 begins." -> j129698615;
	j1003003424 [label="Wie lange war Entrati bei euch in der Kathedrale, bevor Roathe eintraf?",shape=box,color=red];
		j1003003424 -> j794068005;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j794068005 [label="Warum fragst du mich das?",shape=box,color=blue];
		j794068005 -> j4196769031;
	"Chat ends." [color=orange];
	j4196769031 [label="Evaluate expressions",color=orange];
		j4196769031 -> j3553333913 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j2829440178 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j1390802041 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j3169761844 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j2829440178 [label="LyonVisions1",color=purple];
		j4196769031 -> j1390802041 [label="LyonVisions1",color=purple];
		j4196769031 -> j3169761844 [label="LyonVisions1",color=purple];
		j4196769031 -> j3553333913 [label="LyonVisions1",color=purple];
		j4196769031 -> j2829440178 [label="false",color=purple];
		j4196769031 -> j1390802041 [label="false",color=purple];
	j3553333913 [label="Ich wurde gewarnt, dass du die Dinge vielleicht nicht so siehst, wie wir. Aber das stört mich nicht. Mich interessiert, was du weißst.",shape=box,color=red];
		j3553333913 -> j2370951025;
	j2829440178 [label="Marie schein besessen von \"le Cardinal\" zu sein. Und Roathe hasst ihn offensichtlich. Ich versuche, jemand neutrales zu finden. Und du kommst dem am nächsten.",shape=box,color=red];
		j2829440178 -> j1282935424;
	j1390802041 [label="Ich ... weiß nicht, was ich dich sonst fragen soll?",shape=box,color=red];
		j1390802041 -> j3443257139;
	j3169761844 [label="Ich wurde gewarnt, dass du die Dinge vielleicht nicht so siehst, wie wir. Aber ich denke, du könntest die Wahrheit sehen, wo andere sie nicht sehen.",shape=box,color=red];
		j3169761844 -> j307836108;
	j2370951025 [label="Hm. Stört es dich, dich mit Verrückten und Irren zu umgeben? Interessant. Obwohl du dich offenbar mit sprechenden Tieren und ... Kreaturen aus anderen Zeiten umgibst. Ich nehme an, ich bin nicht weniger seltsam, als der Rest seiner Sammlung.",shape=box,color=blue];
		j2370951025 -> j2845885253;
	j1282935424 [label="Was für ein Mangel an vernünftigen Alternativen, wenn deine einzige Option für eine \"neutrale\" Meinung ein Wahnsinniger und Irrer ist. Ich kann nicht begreifen, warum du überhaupt mit mir sprichst.",shape=box,color=blue];
		j1282935424 -> j2845885253;
	j3443257139 [label="Warum willst du überhaupt mit mir sprechen? Du weißt, dass du das nicht brauchst. Wenn du dich mit Marie anfreunden oder ihr sogar den Hof machen willst, ich bin weder ihr Vormund noch ihr Vater. Und was auch immer deine Absichten für Roathe sind, abgesehen von den Antworten, die er mir schuldet, sind sie mir egal.",shape=box,color=blue];
		j3443257139 -> j2845885253;
	j307836108 [label="\"Wahrheit\". Ich wünschte, du könntest verstehen, wie lächerlich das in letzter Zeit für mich klingt. Stört es dich, dich mit Verrückten und Irren zu umgeben? Interessant. Obwohl du dich offenbar mit sprechenden Tieren und ... Kreaturen aus anderen Zeiten umgibst. Ich nehme an, ich bin nicht weniger seltsam, als der Rest seiner Sammlung.",shape=box,color=blue];
		j307836108 -> j2845885253;
	j2845885253 [label="Evaluate expressions",color=orange];
		j2845885253 -> j3430222268 [label="LyonFirstFlirt",color=purple];
		j2845885253 -> j3430222268 [label="DrifterLyon",color=purple];
		j2845885253 -> j2821894665 [label="LyonOffer",color=purple];
		j2845885253 -> j84658775 [label="false",color=purple];
	j3430222268 [label="Und bitte, erspare uns beiden einen weitere ... peinlichen Moment, ja? Ich weiß, was du gesagt hast, ist dein Grund, mit mir zu sprechen. Und auch wenn es schmeichelhaft ist, finde ich es lächerlich unaufrichtig.",shape=box,color=blue];
		j3430222268 -> j2111765275;
		j3430222268 -> j571727838;
		j3430222268 -> j1884663477;
	j2821894665 [label="Und bitte, erspare uns beiden eine weitere Predigt darüber, dass du mir \"helfen\" oder \"mein Freund sein\" möchtest. Ich bin sicher, du versuchst nett zu sein, aber die lächerliche Unaufrichtigkeit ist ärgerlich.",shape=box,color=blue];
		j2821894665 -> j2111765275;
		j2821894665 -> j571727838;
		j2821894665 -> j1884663477;
	j84658775 [label="Und bitte, erspare uns beiden eine lange Predigt darüber, dass du mir \"helfen\" oder \"mein Freund sein\" möchtest. Ich bin sicher, du versuchst nett zu sein, aber die lächerliche Unaufrichtigkeit ist ärgerlich.",shape=box,color=blue];
		j84658775 -> j2111765275;
		j84658775 -> j571727838;
		j84658775 -> j1884663477;
	j2111765275 [label="Unaufrichtig, weil du denkst, ich meine nicht, was ich sage, oder unaufrichtig, weil du denkst, ich meine es nicht über dich?",shape=box,color=red];
		j2111765275 -> j3107728442;
	j571727838 [label="Priester, ich wollte nur wissen, wie lange Entrati sich als \"le Cardinal\" ausgegeben hat. Nichts weiter.",shape=box,color=red];
		j571727838 -> j2413691705;
	j1884663477 [label="Was meinst du mit \"unaufrichtig\"? Nennst du mich einen Lügner?",shape=box,color=red];
		j1884663477 -> j5625625;
	j3107728442 [label="Weder noch. Deine Worte sind eine wohltat, die ich weder brauche, noch will.",shape=box,color=blue];
		j3107728442 -> j2906375351;
		j3107728442 -> j1435945703;
	j2413691705 [label="Natürlich. Drei Jahre, zwei Monate und elf Tage diente er als Cardinal Dimanche in unserer Kathedrale. Und die ganze Zeit dienten Marie und ich ihm, ohne zu ahnen, was er mit uns vorhatte.",shape=box,color=blue];
		j2413691705 -> j1144572516;
	j5625625 [label="Evaluate expressions",color=orange];
		j5625625 -> j654132386 [label="DrifterLiar",color=purple];
		j5625625 -> j3797721105 [label="LyonSuspicious",color=purple];
		j5625625 -> j300621535 [label="false",color=purple];
	j2906375351 [label="Wie hält Marie das nur aus ...?",shape=box,color=red];
		j2906375351 -> j641642565;
	j1435945703 [label="Du denkst, dass jeder, der sich mit dir unterhält, nur eine Wohltat vollbringt?",shape=box,color=red];
		j1435945703 -> j161426038;
	j1144572516 [label="Ich kenne deine Fragen, bevor du sie stellst. Was führte er im Schilde? Hat er die Stadt infiziert, wie er es in Höllvania getan hat? Was waren seine Pläne? Seine Entdeckungen?",shape=box,color=blue];
		j1144572516 -> j173858601;
	j654132386 [label="Gibt es etwas, was du beichten möchtest, Drifter? Gibt es eine Buße, die du leisten möchtest?",shape=box,color=blue];
		j654132386 -> j3025650456;
	j3797721105 [label="Hm, nein. Jedenfalls noch nicht.",shape=box,color=blue];
		j3797721105 -> j300621535;
	j300621535 [label="Deine Wohltätigkeit ist keine Unwahrheit. Es ist als Wohltätigkeit gemeint. Wohltätigkeit, die ich weder brauche, noch will.",shape=box,color=blue];
		j300621535 -> j2906375351;
		j300621535 -> j1435945703;
	j641642565 [label="Das fragst du sie besser selbst. Ich hab mich das auch schon oft gefragt.",shape=box,color=blue];
		j641642565 -> "Chat ends.";
	j161426038 [label="Einfach gesagt? Ja.",shape=box,color=blue];
		j161426038 -> j3994772085;
	j173858601 [label="Dazu kann ich nur sagen, du wirst enttäuscht sein. In diesen drei Jahren, zwei Monaten und elf Tagen? Hat er gepredigt. Er hat studiert. Sich ausgeruht. Und er hat gebetet.",shape=box,color=blue];
		j173858601 -> j1695913155;
		j173858601 -> j4006058178;
		j173858601 -> j962299942;
	j3025650456 [label="Es ist irrelevant. Du bist diesem Gespräch nicht beigetreten, weil du Vergebung suchst, noch sind deine früheren Lügen dasselbe, wie deine jetzigen Unaufrichtigkeiten.",shape=box,color=blue];
		j3025650456 -> j1091235701;
	j3994772085 [label="Boolean LyonHate1 is now true.",color=orange];
		j3994772085 -> j1851162789;
		j3994772085 -> j1688806955;
		j3994772085 -> j3176747330;
	j1695913155 [label="Wann hat er euch in Protoframes verwandelt?",shape=box,color=red];
		j1695913155 -> j1061404465;
	j4006058178 [label="Es fällt mir sehr schwer, mir Entrati beim Beten vorzustellen.",shape=box,color=red];
		j4006058178 -> j1591698004;
	j962299942 [label="Also hat er sich ... eine Auszeit genommen?!",shape=box,color=red];
		j962299942 -> j1412162954;
	j1091235701 [label="Was du jetzt sagst, ist nichts als Wohltätigkeit. Wohltätigkeit, die ich weder brauche, noch will.",shape=box,color=blue];
		j1091235701 -> j2906375351;
		j1091235701 -> j1435945703;
	j1851162789 [label="Etwas, für einen anderen Tag ... ich kann fühlen, dass dieses Gespräch außer Kontrolle gerät.",shape=box,color=red];
		j1851162789 -> j328421784;
	j1688806955 [label="Was ist mit Marie ...?",shape=box,color=red];
		j1688806955 -> j827694018;
	j3176747330 [label="Du scheinst von dir selbst nicht viel zu halten.",shape=box,color=red];
		j3176747330 -> j2254504229;
	j1061404465 [label="Nach diesen drei Jahren und einigen Tagen verschwand er mitten in einem schrecklichen Sturm. Demselben, in dem er aufgetaucht war.",shape=box,color=blue];
		j1061404465 -> j3307858394;
	j1591698004 [label="Es ist unmöglich, einem anderen Menschen hinter die Stirn zu blicken. Er kniete am Altar, mit gebeugtem Haupt. Hat er gebetet? Oder verlor er sich nur in seinen eigenen Gedanken? Ich weiß es nicht.",shape=box,color=blue];
		j1591698004 -> j1061404465;
	j1412162954 [label="+5 Chemistry",color=orange];
		j1412162954 -> j2814140670;
	j328421784 [label="+5 Chemistry",color=orange];
		j328421784 -> j2512887138;
	j827694018 [label="Marie würde einen tollwütigen Bären auf dem Schoß wiegen und sich die Kehle herausreißen lassen, wenn sie glauben würde, es würde dem Tier einen Moment des Friedens bescheren.",shape=box,color=blue];
		j827694018 -> j352546857;
	j2254504229 [label="Ich würde es als unerschütterliches Bekenntnis zum Pragmatismus sehen, aber definiere es, wie auch immer du magst.",shape=box,color=blue];
		j2254504229 -> j67306739;
	j3307858394 [label="Evaluate expressions",color=orange];
		j3307858394 -> j4171707419 [label="MarieLyonVisions",color=purple];
		j3307858394 -> j4171707419 [label="LyonVisions1",color=purple];
		j3307858394 -> j1405395337 [label="false",color=purple];
	j2814140670 [label="Ha. So habe ich das noch nicht betrachtet, aber ja ... vielleicht war es das. Wie unglaublich ärgerlich für euch alle. Es scheint zu dem wenigen zu passen, dass wir von seiner wahren Natur kennen.",shape=box,color=blue];
		j2814140670 -> j1061404465;
	j2512887138 [label="Vermutlich eine weise Entscheidung. Du hast nach \"Cardinal Dimanche\" und seiner Zeit in der Kathedrale gefragt.",shape=box,color=blue];
		j2512887138 -> j889772471;
	j352546857 [label="Sie ist eine einzigartig schöne Seele, die ich bis zum letzten Atemzug beschützen werde.",shape=box,color=blue];
		j352546857 -> j67306739;
	j67306739 [label="+5 Chemistry",color=orange];
		j67306739 -> j38269983;
	j4171707419 [label="Auch wenn mir bewusst ist, dass andere diesen Sturm nicht wahrgenommen haben, war er für mich deutlich spürbar.",shape=box,color=blue];
		j4171707419 -> j1405395337;
	j1405395337 [label="Genau ein Jahr später erschien er ein letztes Mal, mit ... Roathe, so, wie du ihn jetzt kennst, bewusstlos und zusammengebrochen zu seinen Füßen.",shape=box,color=blue];
		j1405395337 -> j4213498294;
	j889772471 [label="Drei Jahre, zwei Monate und elf Tage diente er als Cardinal Dimanche in unserer Kathedrale. Und die ganze Zeit dienten Marie und ich ihm, ohne zu ahnen, was er mit uns vorhatte.",shape=box,color=blue];
		j889772471 -> j1144572516;
	j38269983 [label="Aber genau das passiert, wenn man einem Verrückten eine einfache Frage stellt, man wird in die Irre geführt. Gestatte mir, uns zum ursprünglichen Thema zurückzubringen und fort von mir.",shape=box,color=blue];
		j38269983 -> j889772471;
	j4213498294 [label="Ein Teufel in Menschengestalt, so schien es jedenfalls. Das war, als Entrati uns die Wahrheit darüber sagte, wer er war und die tatsächliche Aufgabe, die er für uns hatte.",shape=box,color=blue];
		j4213498294 -> j3741428038;
	j3741428038 [label="Dass er uns beide für die \"heiligste Mission\" auserwählt hatte.",shape=box,color=blue];
		j3741428038 -> j4154850842;
		j3741428038 -> j1773441414;
	j4154850842 [label="Warum \"heiligste Mission\"?",shape=box,color=red];
		j4154850842 -> j345428734;
	j1773441414 [label="Das klingt, als würdest du ihm nicht glauben.",shape=box,color=red];
		j1773441414 -> j345428734;
	j345428734 [label="Ich habe vieles gelernt, was mich daran zweifeln lässt, dass Entratis sich an irgendetwas hält, was für eine Natur oder einen Gott heilig wäre ... falls so etwas existiert ...",shape=box,color=blue];
		j345428734 -> j695302400;
		j345428734 -> j583532126;
	j695302400 [label="Falls so etwas existiert? Was meinst du damit, Lyon?",shape=box,color=red];
		j695302400 -> j2780928393;
	j583532126 [label="Sprich weiter.",shape=box,color=red];
		j583532126 -> j2918941397;
	j2780928393 [label="Boolean LyonFaith2 is now true.",color=orange];
		j2780928393 -> j4006386849;
	j2918941397 [label="Marie nahm das Serum bereitwillig an. Natürlich, tat sie das. Was hätte sie sonst tun sollen? Und wie hätte ich ihr nicht folgen können? Wie hätte ich nicht die Wahrheit suchen können, egal wohin sie führt?",shape=box,color=blue];
		j2918941397 -> j1813802388;
	j4006386849 [label="Eine Angelegenheit für ein anderes Mal, bitte.",shape=box,color=blue];
		j4006386849 -> j2918941397;
	j1813802388 [label="Boolean LyonSerum1 is now true.",color=orange];
		j1813802388 -> j1044548900;
		j1813802388 -> j4205189659;
		j1813802388 -> j2037251510;
	j1044548900 [label="Ich glaube, sie verehrt Entrati immer noch etwas zu sehr.",shape=box,color=red];
		j1044548900 -> j3118913127;
	j4205189659 [label="Wie ging es weiter?",shape=box,color=red];
		j4205189659 -> j2169076472;
	j2037251510 [label="Bereust du es?",shape=box,color=red];
		j2037251510 -> j437893719;
	j3118913127 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j3118913127 -> j4234402994;
	j2169076472 [label="Roathe erwachte. Zuerst konnte er sich kaum an seinen Namen erinnern. Entrati sagte noch einen Satz zu dem Bastard. \"Uriel, Ketzer von Xata, verbannt, antworte ... kann den Orokin jemals vergeben werden?\"",shape=box,color=blue];
		j2169076472 -> j3860822594;
	j437893719 [label="Ich bereue alles, Drifter. Natürlich tue ich das. Aber würde ich es wieder tun? Natürlich würde ich das. Ich kann Marie nicht alleine lassen.",shape=box,color=blue];
		j437893719 -> j3172697043;
	j4234402994 [label="Darin sind wir uns einig. Aber ich kann es ihr nicht vorwerfen. Gib ihr Zeit. Sie wird es verstehen. Sie ist hochintelligent, Drifter. Behandele sie nicht wie einen Dummkopf.",shape=box,color=blue];
		j4234402994 -> j3172697043;
	j3860822594 [label="Dann verschwand Entrati endgültig. Und ließ Roathe bei uns zurück, gerade erst verwandelt in das, was du vor dir siehst ... besser fähig es mit dem launischen Teufel aufzunehmen.",shape=box,color=blue];
		j3860822594 -> j1217409872;
	j3172697043 [label="Um die Geschichte zu beenden ... dann verschwand Entrati endgültig. Und ließ Roathe bei uns zurück, gerade erst verwandelt in das, was du vor dir siehst ... besser fähig es mit dem launischen Teufel aufzunehmen.",shape=box,color=blue];
		j3172697043 -> j1217409872;
	j1217409872 [label="Der Rest, fürchte ich, ist eine Geschichte, die noch warten muss. M. Loid benötigt POM-2 und ich geben es nur zu gern zurück. Ich hoffe, dass beantwortet zumindest ein paar deiner Fragen.",shape=box,color=blue];
		j1217409872 -> j819356586;
		j1217409872 -> j1478399757;
	j819356586 [label="Und hat doppelt so viele neue aufgeworfen.",shape=box,color=red];
		j819356586 -> j3417845135;
	j1478399757 [label="Das hat es, danke.",shape=box,color=red];
		j1478399757 -> j4088836645;
	j3417845135 [label="+15 Chemistry",color=orange];
		j3417845135 -> j3368386452;
	j4088836645 [label="+10 Chemistry",color=orange];
		j4088836645 -> j3286954228;
	j3368386452 [label="Dann habe ich meiner Pflicht als Priester Genüge getan. Ich wünsche dir eine gute Nacht.",shape=box,color=blue];
		j3368386452 -> j1599833162;
	j3286954228 [label="Dann wünsche ich dir eine gute Nacht.",shape=box,color=blue];
		j3286954228 -> j1599833162;
	j1599833162 [label="-Pater Lyon Allard",shape=box,color=blue];
		j1599833162 -> "Chat ends.";
}