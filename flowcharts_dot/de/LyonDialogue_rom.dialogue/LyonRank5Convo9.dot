digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank5Convo9 begins." [color=orange];
		"LyonRank5Convo9 begins." -> j3594191379;
	j3594191379 [label="Evaluate expressions",color=orange];
		j3594191379 -> "Chat ends." [label="LyonDating & LyonDatingConfession",color=purple];
		j3594191379 -> j1925659939 [label="LyonDating",color=purple];
		j3594191379 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j1925659939 [label="Mon miracle, ich ... muss sicherstellen, dass du etwas verstehst, bevor ich dir meine nächste Anekdote erzähle.",shape=box,color=blue];
		j1925659939 -> j208402429;
	j208402429 [label="Es ist wichtig für mich, dass du die nächsten Worte, die ich sende, sehr genau liest. Verstehst du mich?",shape=box,color=blue];
		j208402429 -> j3839706316;
		j208402429 -> j2080761041;
	j3839706316 [label="Du machst mich nervös. Was ist los?",shape=box,color=red];
		j3839706316 -> j2563013379;
	j2080761041 [label="Ja, ich bin hier. Leg los.",shape=box,color=red];
		j2080761041 -> j3043019457;
	j2563013379 [label="Nichts ist los, ganz im Gegenteil. Deshalb ist es so wichtig für dich zu verstehen, vor welchen schlimmen Konsequenzen ich dich bewahren möchte, solltest du fürchten, dass sie eintreten könnten.",shape=box,color=blue];
		j2563013379 -> j3600644731;
		j2563013379 -> j3576542040;
		j2563013379 -> j2164886351;
	j3043019457 [label="+5 Chemistry",color=orange];
		j3043019457 -> j1742914144;
	j3600644731 [label="Ich höre.",shape=box,color=red];
		j3600644731 -> j3682546814;
	j3576542040 [label="Du ergibst nicht viel Sinn.",shape=box,color=red];
		j3576542040 -> j3349122990;
	j2164886351 [label="Was für schwerwiegende Konsequenzen?",shape=box,color=red];
		j2164886351 -> j2449762058;
	j1742914144 [label="Danke. Bevor ich anfange, möchte ich dir versichern, dass nichts los ist, aber darin liegen vielleicht auch die schwerwiegenden Konsequenzen, vor denen ich dich bewahren möchte, solltest du annehmen, dass es zu solchen kommen könnte.",shape=box,color=blue];
		j1742914144 -> j3600644731;
		j1742914144 -> j3576542040;
		j1742914144 -> j2164886351;
	j3682546814 [label="+5 Chemistry",color=orange];
		j3682546814 -> j857677345;
	j3349122990 [label="Ja, das ist mir schmerzlich bewusst.",shape=box,color=blue];
		j3349122990 -> j2449762058;
	j2449762058 [label="Lass mich von vorne anfangen.",shape=box,color=blue];
		j2449762058 -> j857677345;
	j857677345 [label="Mir ist klar, dass mich viele für - krank halten - und vielleicht bin ich das auch wirklich. Zumindest bin ich nicht vollständig bei Sinnen.",shape=box,color=blue];
		j857677345 -> j3479910479;
	j3479910479 [label="Ich habe mich längst damit abgefunden. Es bereitet mir keine Schwierigkeiten mehr. Die Visionen, die mich quälen ... die Stimmen ... ich habe Wege gefunden, mit ihnen zu leben, ohne Angst oder Hass.",shape=box,color=blue];
		j3479910479 -> j2152565578;
	j2152565578 [label="(In letzter Zeit denke ich, ein wenig aus Trotz, wenn ich ehrlich sein darf, aber das tut hier nichts zur Sache.)",shape=box,color=blue];
		j2152565578 -> j830291694;
	j830291694 [label="Aber ich möchte, dass du verstehst, solltest du die Dinge zwischen uns beenden wollen, diese Verbindung, von der ich vormals dachte, dass sie niemals zwischen einem anderen und mir existieren könnten ...",shape=box,color=blue];
		j830291694 -> j1649834171;
	j1649834171 [label="Sollte dein Herz sich je von meinem abwenden?",shape=box,color=blue];
		j1649834171 -> j1161145283;
	j1161145283 [label="Werde ich es aushalten, mon miracle.",shape=box,color=blue];
		j1161145283 -> j4092256520;
	j4092256520 [label="Ich werde nicht von dem verzehrt werden, was mich geplagt hat.",shape=box,color=blue];
		j4092256520 -> j2851720794;
	j2851720794 [label="Check boolean LyonAllRight",color=orange];
		j2851720794 -> j2719702132 [label=true,color=green];
		j2851720794 -> j706705383 [label=false,color=brown];
	j2719702132 [label="Ich werde, um es mit deinen Worten zu sagen \"ok sein\". Ich werde einen Grund finden, erneut zu Lächeln und zu Lachen.",shape=box,color=blue];
		j2719702132 -> j3713629162;
		j2719702132 -> j2056237398;
	j706705383 [label="Ich werde überleben. Mir wird es gut gehen. Ich werde einen Grund finden, erneut zu Lächeln und zu Lachen.",shape=box,color=blue];
		j706705383 -> j3713629162;
		j706705383 -> j2056237398;
	j3713629162 [label="Oh Lyon, du bist keine Last für mich.",shape=box,color=red];
		j3713629162 -> j3565021222;
	j2056237398 [label="Willst du mir sagen ... dass du die Dinge zwischen uns beenden willst?",shape=box,color=red];
		j2056237398 -> j4158736016;
	j3565021222 [label="Ich versuche nur, dich von jeglicher vermeintlichen Belastung zu befreien, die du meinetwegen empfinden könntest ...",shape=box,color=blue];
		j3565021222 -> j2500855554;
		j3565021222 -> j568007142;
		j3565021222 -> j854187584;
	j4158736016 [label="Nein! Nichts dergleichen! Ich versuche nur, dich von jeglicher vermeintlichen Belastung zu befreien, die du meinetwegen empfinden könntest.",shape=box,color=blue];
		j4158736016 -> j2500855554;
		j4158736016 -> j568007142;
		j4158736016 -> j854187584;
	j2500855554 [label="Dein Schmerz ... erinnert mich an meinen eigenen. Es wäre mir niemals eine Last, dir dabei zu helfen.",shape=box,color=red];
		j2500855554 -> j3348612268;
	j568007142 [label="Ich kann nicht beschreiben, was mich an dir fasziniert. Aber du wirst niemals eine Pflicht oder eine Last sein.",shape=box,color=red];
		j568007142 -> j2715892214;
	j854187584 [label="[Trennen.] Es wird einfach alles zu viel für mich, es tut mir leid. Es ist das beste, dies hier zu beenden.",shape=box,color=red];
		j854187584 -> j2905351332;
	j3348612268 [label="Ich kann gar nicht in Worte fassen, wie sehr mir das Herz für dich bricht. Aber ich bin unendlich dankbar, dass unsere einsamen Geister des Schmerzes einander gefunden haben.",shape=box,color=blue];
		j3348612268 -> j2338467438;
	j2715892214 [label="Wofür ich meine Dankbarkeit nicht angemessen ausdrücken kann und ich glaube nicht, dass Worten dies je gelingen wird.",shape=box,color=blue];
		j2715892214 -> j2338467438;
	j2905351332 [label="Ja, natürlich. Es wäre ... heuchlerisch, zu diesem Zeitpunkt eine andere Antwort zu akzeptieren ...",shape=box,color=blue];
		j2905351332 -> j749247099;
	j2338467438 [label="Aber nun, da ich mir große Mühe gegeben habe, diese äußerst spektakuläre, selbstgefällige Einleitung durchzugehen ...",shape=box,color=blue];
		j2338467438 -> j2898726509;
		j2338467438 -> j144924308;
		j2338467438 -> j233622311;
	j749247099 [label="Ich verstehe vollkommen. Und ich wünsche dir nur das Beste. Und ich werde all die Momente, die wir zusammen verbracht haben, in Ehren halten.",shape=box,color=blue];
		j749247099 -> j719540946;
	j2898726509 [label="Für jemanden, der so schweigsam angefangen hat, bist du ganz schön gesprächig geworden.",shape=box,color=red];
		j2898726509 -> j1717588105;
	j144924308 [label="Ich finde sie liebenswert, keine Sorge.",shape=box,color=red];
		j144924308 -> j1705021856;
	j233622311 [label="Du hättest auch sagen können: \"Mir wird es gut gehen, solltest du je getrennte Wege gehen wollen.\"",shape=box,color=red];
		j233622311 -> j4293792477;
	j719540946 [label="Ich werde sie in meiner Seele bewahren, auch, wenn sie aus meinem Gedächtnis verschwinden mögen. Lebe wohl.",shape=box,color=blue];
		j719540946 -> j3994460333;
	j1717588105 [label="+5 Chemistry",color=orange];
		j1717588105 -> j750249848;
	j1705021856 [label="+5 Chemistry",color=orange];
		j1705021856 -> j2393864148;
	j4293792477 [label="+5 Chemistry",color=orange];
		j4293792477 -> j725586003;
	j3994460333 [label="Boolean LyonDating is now false.",color=orange];
		j3994460333 -> j4254443866;
	j750249848 [label="Pah! Wenn du nicht wissen wolltest, was in meinem Inneren vor sich geht, hättest du dort nicht herumschnüffeln sollen. Das bist du selber schuld.",shape=box,color=blue];
		j750249848 -> j1508196879;
	j2393864148 [label="Es freut mich, dass dir meine Erzählungen gefallen. Genau deshalb spreche ich so wenig. Kannst du dir vorstellen, das persönlich aushalten zu müssen? Marie hätte mich vor Jahren wie einen tollwütigen Hund schlafen gelegt.",shape=box,color=blue];
		j2393864148 -> j1508196879;
	j725586003 [label="Es gibt eine gewisse Respektlosigkeit und einen gewissen Sarkasmus, die dir natürlich zufallen und die ich niemals erreichen könnte. Ich überlasse das dir.",shape=box,color=blue];
		j725586003 -> j1508196879;
	j4254443866 [label="Boolean IsDating is now false.",color=orange];
		j4254443866 -> j3311435967;
	j1508196879 [label="Dennoch sollte das alles nur als Vorwand für die Geschichte dienen, die jetzt im Vergleich ziemlich kurz zu sein scheint ...",shape=box,color=blue];
		j1508196879 -> j107048984;
	j3311435967 [label="- Lyon",shape=box,color=blue];
		j3311435967 -> "Chat ends.";
	j107048984 [label="Letzte Nacht bin ich aus einem Albtraum aufgewacht. Als ich aufwachte, war ich von Schatten umgeben. Das ist nichts Ungewöhnliches oder Neues in meinem Gemütszustand. Sie ragten über meinem Bett auf und wollten nicht verschwinden.",shape=box,color=blue];
		j107048984 -> j3346031784;
	j3346031784 [label="Ich fürchtete sie nicht, denn ich wusste, sie konnten mir nichts anhaben. Aber sie gingen mir auch nicht aus dem Kopf. Ich kannte nur einen Weg, sie zu vertreiben.",shape=box,color=blue];
		j3346031784 -> j1887811369;
	j1887811369 [label="Ich rappelte mich auf, zog mich so gut ich konnte an und taumelte durch die verschwommene Vision meines anhaltenden Albtraums. Ich griff mein Weihrauchfass, fiel in der Mitte des Raum auf die Knie und bereitete mich darauf vor ... nun ja.",shape=box,color=blue];
		j1887811369 -> j315418588;
	j315418588 [label="Ich bereitete mich darauf vor, \"meinen Geist zu befreien\". Lassen wir es dabei.",shape=box,color=blue];
		j315418588 -> j1400899590;
	j1400899590 [label="Aber als ich meine Augen schloss, schweiften meine Gedanken ab. Sie schweiften ab ... zu dir, mon miracle ...",shape=box,color=blue];
		j1400899590 -> j1464016846;
	j1464016846 [label="Der Klang deiner Stimme. Die Berührung deiner Hand auf meiner Schulter ...",shape=box,color=blue];
		j1464016846 -> j757054727;
	j757054727 [label="Und die Visionen ... flohen. Sie verließen ihren Posten, verjagt von einem stärkeren Geist ... von dir.",shape=box,color=blue];
		j757054727 -> j3203760417;
	j3203760417 [label="Ich ... stand auf. Stellte mein Weihrauchfass auf den Nachttisch und ... beschloss stattdessen, durch den Sand des Sanctums zu wandern ...",shape=box,color=blue];
		j3203760417 -> j3571533081;
		j3203760417 -> j213935472;
	j3571533081 [label="Jetzt kann ich das Bedürfnis nach einem Vorwand verstehen.",shape=box,color=red];
		j3571533081 -> j1356403898;
	j213935472 [label="Ich weiß nicht, was ich sagen soll ...",shape=box,color=red];
		j213935472 -> j1309117036;
	j1356403898 [label="Ja. Nun, auf meiner Wanderung, wurde mir ... augenblicklich die dunkle Gefahr eines solchen Moments bewusst. Dass du es ... als Verantwortung ansehen könntest und mich als Fessel, die ich belasten könnte.",shape=box,color=blue];
		j1356403898 -> j1014979004;
	j1309117036 [label="+5 Chemistry",color=orange];
		j1309117036 -> j1440988138;
	j1014979004 [label="Ich flehe dich an ... ich bete zu jedem Gott im Himmel oder auf Erden, dass dies niemals  passiert. Du hast mir ein Geschenk gegeben und jedes Mal werden ich seine Neuheit wertschätzen.",shape=box,color=blue];
		j1014979004 -> j808394743;
	j1440988138 [label="Es braucht keine Worte, mon miracle ...",shape=box,color=blue];
		j1440988138 -> j2955059874;
	j808394743 [label="Versprich es mir, mon miracle ... sollte eine Zeit kommen, in der ich für dich zu einem leeren Käfig werden ... wirst du dich von mir befreien.",shape=box,color=blue];
		j808394743 -> j2265881045;
	j2955059874 [label="Auf meiner Wanderung, wurde mir ... augenblicklich die dunkle Gefahr eines solchen Moments bewusst. Dass du es ... als Verantwortung ansehen könntest und mich als Fessel, die ich belasten könnte.",shape=box,color=blue];
		j2955059874 -> j1014979004;
	j2265881045 [label="Ich werde für die, die ich liebe, kein leeres Gefängnis sein. Nicht für dich. Nicht für Marie.",shape=box,color=blue];
		j2265881045 -> j2614612464;
		j2265881045 -> j1269351691;
	j2614612464 [label="[Trennen.] Ich ... das kann ich nicht versprechen, tut mir leid.",shape=box,color=red];
		j2614612464 -> j2871211904;
	j1269351691 [label="Ich verspreche es.",shape=box,color=red];
		j1269351691 -> j1347512467;
	j2871211904 [label="+10 Chemistry",color=orange];
		j2871211904 -> j2194742709;
	j1347512467 [label="+10 Chemistry",color=orange];
		j1347512467 -> j3242544498;
	j2194742709 [label="Danke. Danke, mon miracle, für deine Ehrlichkeit. Das hat Mut erfordert, in diesem Moment und dafür bewundere ich dich.",shape=box,color=blue];
		j2194742709 -> j34062247;
	j3242544498 [label="Danke. Ich danke dir, mon miracle ...",shape=box,color=blue];
		j3242544498 -> j3564271695;
	j34062247 [label="Ich werde alle Momente, die wir zusammen verbracht haben, in Ehren halten. Und dies bedeutet mir mehr, als du ahnen kannst.",shape=box,color=blue];
		j34062247 -> j719540946;
	j3564271695 [label="Ich bin plötzlich so müde, als wäre ... eine große Last von meinen Schultern genommen worden. Ich fürchte, ich muss mich hinlegen.",shape=box,color=blue];
		j3564271695 -> j21916968;
	j21916968 [label="- Lyon",shape=box,color=blue];
		j21916968 -> j3446510588;
	j3446510588 [label="Boolean LyonDatingConfession is now true.",color=orange];
		j3446510588 -> "Chat ends.";
}