	j3745573286 [label="Standen dir in deiner Verzweiflung wirklich keine anderen Möglichkeiten zur Verfügung, dass du Roathe gebeten hast, mich in deinem Namen zu bedrängen?",shape=box,color=blue];
		j3745573286 -> j2984571859;
	"Chat ends." [color=orange];
	j3684517027 [label="Dir ist klar, wie absurd das klingt, ja?",shape=box,color=blue];
		j3684517027 -> j946282378;
		j3684517027 -> j532861892;
	j2897498334 [label="Ich möchte nicht noch mehr Zeit mit dem Anhören seiner Argumente verschwenden. Ich sage einfach: Nun gut.",shape=box,color=blue];
		j2897498334 -> j2169173578;
	j2984571859 [label="Das Problem war, korrigiere mich, falls ich falsch liege, dass du meine Vergangenheit nicht aufwühlen wolltest. Hast du jetzt deine Meinung geändert?",shape=box,color=blue];
		j2984571859 -> j3008608731;
	j946282378 [label="Ich wusste nicht, dass er gesagt hatte, ich würde mich entschuldigen.",shape=box,color=red];
		j946282378 -> j650586352;
	j532861892 [label="Ich wusste nicht, was ich sonst tun sollte. Im Nachhinein betrachtet ist es lächerlich.",shape=box,color=red];
		j532861892 -> j247031014;
	j2169173578 [label="Check boolean MarieFamilyFail",color=orange];
		j2169173578 -> j2304217915 [label=true,color=green];
		j2169173578 -> j452496746 [label=false,color=brown];
	j3008608731 [label="Ich verstehe das nicht. Wir können nicht zurück. Diese Gewässer können nicht erneut befahren werden.",shape=box,color=blue];
		j3008608731 -> j3247869534;
		j3008608731 -> j3778234470;
	j650586352 [label="Ich verstehe.",shape=box,color=blue];
		j650586352 -> "Chat ends.";
	j247031014 [label="Das Komische daran, das gebe ich zu, war mit ein Grund, warum ich der Sache nachgegangen bin. Bist du so verzweifelt? Ich kann mir nicht vorstellen, dass das Fehlen meiner Gesellschaft in deinem Leben so schlimm ist.",shape=box,color=blue];
		j247031014 -> j607064540;
	j2304217915 [label="Du hast meine Unterstützung, wie du es wünschst. Ich bedauere, was dein Teufel als Nächstes mit Marie anstellen wird.",shape=box,color=blue];
		j2304217915 -> j92487004;
	j452496746 [label="Du hast meine Unterstützung, wie du es wünschst. Und nun, rufe deinen Teufel zurück.",shape=box,color=blue];
		j452496746 -> j770168571;
	j3247869534 [label="Oh. Nun, dann war das wohl eine riesige Zeitverschwendung, nicht wahr?",shape=box,color=red];
		j3247869534 -> "Chat ends.";
	j3778234470 [label="Ich denke, dann ... werde mich einfach entschuldigen. Dafür, dass ich dir nicht zugehört habe.",shape=box,color=red];
		j3778234470 -> j2826955004;
	j607064540 [label="Ist es, Lyon. Du bedeutest mir viel. Sehr viel. Und ich weiß, dass ich dich sehr verletzt habe.",shape=box,color=red];
		j607064540 -> j4212673402;
	j92487004 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j92487004 -> j547953661;
	j770168571 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j770168571 -> j3711686580;
	j2826955004 [label="Darf ich fragen, warum du es nicht getan hast? Hattest du Angst vor dem Thema? War es dir zu langweilig? Oder dachtest du, du wärst nicht stark genug, es durchzustehen?",shape=box,color=blue];
		j2826955004 -> j4089254041;
		j2826955004 -> j547720002;
		j2826955004 -> j3563453338;
	j4212673402 [label="Und es tut mir unendlich leid.",shape=box,color=red];
		j4212673402 -> j42720713;
	j547953661 [label="Boolean LyonFamilyFail is now false.",color=orange];
		j547953661 -> "Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j3711686580 [label="Boolean LyonFamilyFail is now false.",color=orange];
		j3711686580 -> "Chat ends.";
	j4089254041 [label="Ich hatte Angst davor.",shape=box,color=red];
		j4089254041 -> j3297749027;
	j547720002 [label="Ich denke, ich war stark genug, das zu bewältigen.",shape=box,color=red];
		j547720002 -> j3297749027;
	j3563453338 [label="Damals war es mir egal. Aber jetzt nicht mehr.",shape=box,color=red];
		j3563453338 -> j2338992243;
	j42720713 [label="Ich wusste keinen anderen Ausweg, als mich an Roathe um Hilfe zu wenden.",shape=box,color=red];
		j42720713 -> j3662293952;
	"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
	j3297749027 [label="Dann bleibt mir nichts anderes übrig, als dir zu vergeben. ",shape=box,color=blue];
		j3297749027 -> j106665696;
	j2338992243 [label="Und was hat sich geändert, dass es dich plötzlich interessiert, wo es dir vorher egal war?",shape=box,color=blue];
		j2338992243 -> j2417097900;
		j2338992243 -> j3737385886;
	j3662293952 [label="Mir bleibt natürlich nichts anderes übrig, als dir zu vergeben. Ich verstehe nicht, warum du so ein kaputtes Wesen wie mich in deinem Leben haben möchtest.",shape=box,color=blue];
		j3662293952 -> j3297708840;
	j106665696 [label="Boolean LyonConfessionFail is now false.",color=orange];
		j106665696 -> "Chat ends.";
	j2417097900 [label="Ich habe meine Meinung über dich geändert.",shape=box,color=red];
		j2417097900 -> j3297749027;
	j3737385886 [label="Ich habe das Gefühl, dass Fortschritte blockiert werden könnten, wenn ich deine Geschichten nicht höre.",shape=box,color=red];
		j3737385886 -> j3277959337;
	j3297708840 [label="Aber ich stelle fest, dass mein Ärger über deine Worte schwindet, jetzt, wo ich weiß, zu welch bizarren Mitteln du greifen würdest, um mich an deiner Seite zu haben.",shape=box,color=blue];
		j3297708840 -> j2398113586;
	j3277959337 [label="Ein Mittel zum Zweck.",shape=box,color=blue];
