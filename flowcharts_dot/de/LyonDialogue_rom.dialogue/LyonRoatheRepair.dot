		2306 -> 2312;
	2307 [label="Das Komische daran, das gebe ich zu, war mit ein Grund, warum ich der Sache nachgegangen bin. Bist du so verzweifelt? Ich kann mir nicht vorstellen, dass das Fehlen meiner Gesellschaft in deinem Leben so schlimm ist.",shape=box,color=blue];
