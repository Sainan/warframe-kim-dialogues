	j422964442 [label="Standen dir in deiner Verzweiflung wirklich keine anderen Möglichkeiten zur Verfügung, dass du Roathe gebeten hast, mich in deinem Namen zu bedrängen ... um eine Entschuldigung zu erwägen?",shape=box,color=blue];
		j422964442 -> j3684517027;
	j3415282618 [label="Standen dir in deiner Verzweiflung wirklich keine anderen Möglichkeiten zur Verfügung, dass du Roathe gebeten hast, mich in deinem Namen zu bedrängen, damit M. Loid nach oben geschickt wird?",shape=box,color=blue];
