		250 -> 234;
	255 [label="Anderer, die ich ebenfalls nicht kenne und denen ich ebenfalls nicht traue. All dies wird uns aufgebürdet, ganz zu schweigen von dem, was man nicht sehen kann.",shape=box,color=blue];
