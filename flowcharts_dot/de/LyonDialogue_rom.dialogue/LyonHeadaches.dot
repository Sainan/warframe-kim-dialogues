	224 [label="Ich weiß nur aus persönlicher Erfahrung, dass manchmal die Momente, in denen wir keine Hilfe von Fremden annehmen wollen, genau die Momente sind, in denen wir sie am meisten brauchen.",shape=box,color=red];
		224 -> 233;
	225 [label="Ich respektiere das. Ich werde nicht nachhaken, wenn du nicht reden möchtest. Aber ich gerne zu, falls es doch der Fall ist.",shape=box,color=red];
		225 -> 233;
	228 [label="Sie schien anzudeuten, dass du Theorien darüber hast, warum du diese Kopfschmerzen bekommst?",shape=box,color=red];
		228 -> 235;
	227 [label="Marie denkt, dass du die Bürde der Situation alleine zu tragen versuchst. Ich wollte dich nur wissen lassen, dass ich hier bin.",shape=box,color=red];
