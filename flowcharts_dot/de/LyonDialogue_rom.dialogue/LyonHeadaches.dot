		246 -> 234;
	245 [label="Alles, was ich je gekannt habe, wurde von leuchtenden Strahlen aus \"Jade-Licht\" hinweggefegt und das \"Orokin Imperium\" und \"der Void\" werden vom \"Raunen\" bedroht.",shape=box,color=blue];
		245 -> 251;
	243 [label="Wie du \"sehen\" kannst, bin ich schon wieder genesen. Und jetzt solltest du dich, um dich selbst kümmern. Finde einen dunklen Ort, um dich zu erholen.",shape=box,color=blue];
