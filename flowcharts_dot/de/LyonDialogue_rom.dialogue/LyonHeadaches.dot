		244 -> 250;
		244 -> 224;
	251 [label="Daher wirst du mir verzeihen müssen, dass ich dieses ... Freundschaftsangebot in seiner Naivität ziemlich lächerlich finde. Weder kenne ich dich, noch vertraue ich dir. Alles, worauf ich mich verlassen kann, sind die Worte anderer.",shape=box,color=blue];
		251 -> 255;
