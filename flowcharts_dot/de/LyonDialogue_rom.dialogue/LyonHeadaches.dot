	248 [label="Wenn wir schon direkt sind, ich kann einfach nicht aufhören, an dich zu denken, seit wir uns begegnet sind.",shape=box,color=red];
		248 -> 254;
	249 [label="Entrati hat euch in Protoframes verwandelt und jetzt seid ihr hier, ohne Vorbereitung, ohne irgendwas. Wenn ich dir irgendwie helfen kann, dich einzugewöhnen, möchte ich das tun.",shape=box,color=red];
		249 -> 234;
