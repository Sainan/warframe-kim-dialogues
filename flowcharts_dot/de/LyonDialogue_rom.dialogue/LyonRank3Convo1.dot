digraph {
	0 [label="LyonRank3Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Grüße, Drifter.",shape=box,color=blue];
		1 -> 2;
	2 [label="Mir wurde gesagt, dass du mit mir sprechen möchtest.",shape=box,color=blue];
		2 -> 3;
		2 -> 4;
		2 -> 5;
	3 [label="Es freut mich, hier mit dir zu reden, Lyon, danke.",shape=box,color=red];
		3 -> 6;
	4 [label="Hat Marie dich endlich überzeugt, dass ich keine Bedrohung darstelle?",shape=box,color=red];
		4 -> 7;
	5 [label="Oh! Hallo, Lyon. Ich habe ehrlich nicht gedacht, man könnte dich überzeugen. Es freut mich, dass du deine Meinung geändert hast.",shape=box,color=red];
		5 -> 8;
	6 [label="Am Ende wirst du dir noch wünschen, nicht so eifrig gewesen zu sein, aber gut. Gern geschehen.",shape=box,color=blue];
		6 -> 9;
		6 -> 10;
	7 [label="Bring mich nicht so schnell dazu, einen Grund zu finden, den Kurs zu ändern.",shape=box,color=blue];
		7 -> 11;
	8 [label="Tja, vielleicht bist du nicht mehr so froh darüber, wenn das alles vorbei ist.",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
	9 [label="Ich habe von den anderen erfahren, dass es Dinge gibt, über die wir sprechen sollten. Kann ich dir irgendwie helfen?",shape=box,color=red];
		9 -> 12;
	10 [label="Stimmt etwas nicht?",shape=box,color=red];
		10 -> 13;
	11 [label="+10 Chemistry",color=orange];
		11 -> 14;
	12 [label="Mit der Zeit, vielleicht. Aber unser Gespräch hat gerade erst begonnen. Ich bin nur hier ... um dir zu sagen, dass ich Maries Drängen nachgegeben habe, dass man sich sicher mit der unterhalten kann.",shape=box,color=blue];
		12 -> 15;
	13 [label="Was für eine fast lächerlich unzureichende Frage, dich ich nicht versuchen werde zu beantworten, wo wir unser Gespräch gerade erst begonnen haben. Ich bin nur hier ... um dir zu sagen, dass ich Maries Drängen, dass man sich sicher mit dir unterhalten kann, nachgegeben haben,",shape=box,color=blue];
		13 -> 15;
	14 [label="Chat ends.",color=orange];
	15 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		15 -> 16 [label="x > 0",color=purple];
		15 -> 17 [label="x <= 0",color=purple];
		15 -> 17 [label="false",color=purple];
	16 [label="Da wir nun in diesem Vorhaben, das Roathe unbedingt vorantreiben will, zusammenarbeiten, erscheint es nur richtig, dass wir uns vernünftig vorstellen. Dies scheint deine bevorzugte Art des Gesprächs zu sein. Daher bin ich hier.",shape=box,color=blue];
		16 -> 18;
		16 -> 19;
	17 [label="Da wir nun in diesem Vorhaben, das Roathe unbedingt vorantreiben will, eventuell zusammenarbeiten, erscheint es nur richtig, dass wir uns vernünftig vorstellen. Dies scheint deine bevorzugte Art des Gesprächs zu sein. Daher bin ich hier.",shape=box,color=blue];
		17 -> 18;
		17 -> 19;
	18 [label="Es fühlt sich an, als wäre ich das Ganze jetzt schon falsch angegangen.",shape=box,color=red];
		18 -> 20;
	19 [label="Gibt es... einen anderen Weg, der dir lieber wäre?",shape=box,color=red];
		19 -> 21;
	20 [label="Nein, durchaus nicht. Ich bin vermutlich nur nicht die Art Person, mit der du dich für gewöhnlich unterhältst. Daher hattest du bisher in dieser Hinsicht Glück, da Verrückte meines Kalibers eine Seltenheit sind.",shape=box,color=blue];
		20 -> 22;
	21 [label="Nein. Dies ist akzeptabel. Tatsächlich gibt diese Methode mir die Zeit, meine Gedanken in eine Form zu bringen, die mir gefällt. Ich kann sehen, warum dieses Gerät Vorzüge hat.",shape=box,color=blue];
		21 -> 23;
	22 [label="Doch ich schweife ab.Ich bin nicht hierhergekommen, um viel Zeit mit \"Tippen\" zu verbringen, was dich sicher enttäuscht. Ich wollte dir nur deine Kapitulation mitteilen.",shape=box,color=blue];
		22 -> 24;
		22 -> 25;
	23 [label="Ich bin jedoch nicht hierhergekommen, um viel Zeit mit \"Tippen\" zu verbringen, was dich sicher enttäuscht. Ich wollte dir nur deine Kapitulation mitteilen.",shape=box,color=blue];
		23 -> 25;
		23 -> 24;
	24 [label="Marie ist gefährlicher, als sie aussieht, oder?",shape=box,color=red];
		24 -> 26;
	25 [label="Dann werde ich nochmal einfach Danke sagen.",shape=box,color=red];
		25 -> 27;
	26 [label="+20 Chemistry",color=orange];
		26 -> 28;
	27 [label="+15 Chemistry",color=orange];
		27 -> 29;
	28 [label="Du hast gerade erst begonnen, die Tiefen dieser Wasser auszuloten.",shape=box,color=blue];
		28 -> 30;
	29 [label="Und dir sage ich... was auch immer es wert sein mag, gern geschehen.",shape=box,color=blue];
		29 -> 30;
	30 [label="-Pater Lyon Allard",shape=box,color=blue];
		30 -> 31;
	31 [label="Chat ends.",color=orange];
}