digraph {
	1556 [label="LyonRank5Convo3 begins.",color=orange];
		1556 -> 1557;
	1557 [label="Evaluate expressions",color=orange];
		1557 -> 1559 [label="LyonDating",color=purple];
		1557 -> 1560 [label="LyonConvession1",color=purple];
		1557 -> 1560 [label="LyonRell2a",color=purple];
		1557 -> 1560 [label="LyonRell2b",color=purple];
		1557 -> 1560 [label="LyonRell1",color=purple];
		1557 -> 1558 [label="false",color=purple];
	1559 [label="Ich bin nicht stolz darauf, aber ich hab eine ganze Flasche Wein geleert und jetzt bin ich bereit dir den Rest von dem zu erzählen, was ich verzweifelt verbergen wollte, mon miracle ...",shape=box,color=blue];
		1559 -> 1561;
	1560 [label="Ich bin nicht stolz darauf, aber ich hab eine ganze Flasche Wein geleert und jetzt bin ich bereit dir den Rest von dem zu erzählen, was ich verzweifelt verbergen wollte ...",shape=box,color=blue];
		1560 -> 1561;
	1558 [label="Chat ends.",color=orange];
	1561 [label="Sofern diese Flasche tatsächlich Wein enthielt, sie hatte kein Etikett - und M. Loid war sich nicht sicher, dass er das, was wir in meiner Zeit Wein nannten, als solchen erkennen würde.",shape=box,color=blue];
		1561 -> 1562;
	1562 [label="Zu meiner Verteidigung, ich wollte nicht die ganze Flasche leeren ... aber ich versuchte herauszufinden, ob es sich in der Tat um dieselbe Substanz handelte und dann war sie leer ...",shape=box,color=blue];
		1562 -> 1563;
		1562 -> 1564;
		1562 -> 1565;
	1563 [label="Nein, das mache ich nicht.",shape=box,color=red];
		1563 -> 1566;
	1564 [label="Ist der Geschmack der gleiche?",shape=box,color=red];
		1564 -> 1567;
	1565 [label="Bist du betrunken?",shape=box,color=red];
		1565 -> 1568;
	1566 [label="Wenn ich nur so leicht entkommen könnte. Ich mache dir keinen Vorwurf.",shape=box,color=blue];
		1566 -> 1569;
	1567 [label="Ich weiß es nicht. Das war das frustrierendste an der ganzen Sache! Aber darum geht es nicht. Es ging darum, betrunken zu werden. Und ich bin nicht mal sicher, ob ich es bin. Aber ich bin sicher nicht nüchtern, wie dem auch sei ...",shape=box,color=blue];
		1567 -> 1570;
	1568 [label="Möglicherweise. Ich bin sicher nicht das, was man als nüchtern bezeichnen würde.",shape=box,color=blue];
		1568 -> 1571;
	1569 [label="Update boolean LyonConfessionFail",color=orange];
		1569 -> 1572;
	1570 [label="... es wird reichen müssen, nehme ich an.",shape=box,color=blue];
		1570 -> 1573;
		1570 -> 1574;
	1571 [label="Was genau der Sinn dieses Vorhabens war. Also wird das wohl genügen müssen.",shape=box,color=blue];
		1571 -> 1573;
		1571 -> 1574;
	1572 [label="Chat ends.",color=orange];
	1573 [label="Was ist so furchtbar, dass du betrunken sein musst, um es mir zu erzählen?",shape=box,color=red];
		1573 -> 1575;
	1574 [label="Ich bin bereit, wenn du es bist ...",shape=box,color=red];
		1574 -> 1575;
	1575 [label="Rapp ... Tapp ... Tapp ...",shape=box,color=blue];
		1575 -> 1576;
		1575 -> 1577;
	1576 [label="... Oh.",shape=box,color=red];
		1576 -> 1578;
	1577 [label="Das reicht in der Tat.",shape=box,color=red];
		1577 -> 1578;
	1578 [label="Ich weiß mit Sicherheit, dass sie nicht mein Leben lang in meinen Gedanken waren. Der Tenno genannt Rell und sein Beschützer Harrow. Es ist unmöglich, dass sie in den Wänden meines Elternhauses waren.",shape=box,color=blue];
		1578 -> 1579;
	1579 [label="Es ist unmöglich, dass sie all diese Jahre in meinem Geist widerhallten, vermischt mit den geflüsterten, undeutlichen Stimmen meiner Visionen. Und trotzdem sehe ich sie dort, höre ich sie dort, in meinen Erinnerungen.",shape=box,color=blue];
		1579 -> 1580;
	1580 [label="Check boolean LyonTime1",color=orange];
		1580 -> 1581 [label=true,color=green];
		1580 -> 1582 [label=false,color=brown];
	1581 [label="Im philosophischen Sinn verstand ich all das, was Entrati mir erklärte, wie Energie in der Zeit an mehreren Orten existieren kann. Aber emotional verstand ich es erst, als ich ... das Serum injizierte.",shape=box,color=blue];
		1581 -> 1583;
	1582 [label="Es ist, als ob in dem Moment, als ich das Serum injizierte ... alles eins wurde. Als Entrati sich offenbarte und die ganze Wahrheit seiner Existenz ...",shape=box,color=blue];
		1582 -> 1584;
	1583 [label="Manchmal sehe ich vor meinem inneren Auge einen großen, flachen, stillen See, der sich in alle Richtungen erstreckt. Schwarz und glatt, wie ein Onyx-Spiegel.",shape=box,color=blue];
		1583 -> 1585;
	1584 [label="Er sagte mir alles, was er über die Konzepte von \"Quantenverschränkung\", \"Superposition\" und \"Eternalismus\" wusste.",shape=box,color=blue];
		1584 -> 1586;
	1585 [label="Ein großer, schwarzer See, der in die Ewigkeit fließt. Unmöglich zu verstehen.",shape=box,color=blue];
		1585 -> 1587;
	1586 [label="Ich verstand alles im wissenschaftlichen, eher philosophischen Sinn. Aber ich verstand es nicht emotional, bis ... ich das Serum injizierte.",shape=box,color=blue];
		1586 -> 1583;
	1587 [label="Und dort würde ich sie finden. Dort würden wir uns treffen. Und dort würde ich sie auch spüren ...",shape=box,color=blue];
		1587 -> 1588;
	1588 [label="Sie?",shape=box,color=red];
		1588 -> 1589;
	1589 [label="Die anderen Harrows ... Leere Statuen von Dingen, Echos von Echos von Echos ... Sie erstrecken sich endlos in alle Richtungen ...",shape=box,color=blue];
		1589 -> 1590;
	1590 [label="Rell tauchte in einen von ihnen ein. Verlor sich darin. Und damit, verlor er sich in allen von ihnen ...",shape=box,color=blue];
		1590 -> 1591;
	1591 [label="Einschließlich mir. Einschließlich des Harrow, der sich in dem Serum befand, das mich erschaffen hat.",shape=box,color=blue];
		1591 -> 1592;
		1591 -> 1593;
	1592 [label="Void, mir war nicht mal klar ...",shape=box,color=red];
		1592 -> 1594;
	1593 [label="Oh nein ...",shape=box,color=red];
		1593 -> 1594;
	1594 [label="Sie waren in meinen Gedanken bei mir ... Rell und sein Harrow, so sehr wie ich und doch so anders.",shape=box,color=blue];
		1594 -> 1595;
	1595 [label="Er hatte keine Angst. Er war sich seiner Sache so sicher. Zwei Dinge, die auf mich gar nicht zutrafen.",shape=box,color=blue];
		1595 -> 1596;
	1596 [label="Er war standhaft gegenüber der Gleichgültigkeit, ihm war egal, was es war oder auch nicht. Wusste einfach, was getan werden musste.",shape=box,color=blue];
		1596 -> 1597;
	1597 [label="Selbst nach all der Grausamkeit, die er erlitten hatte. In all den Jahren, im \"Jetzt\" und im \"Damals\" dieser Ewigkeit, von dem Moment an, in dem ich das Serum injizierte ... im \"Vorher\" und \"Nachher\", war er da.",shape=box,color=blue];
		1597 -> 1598;
	1598 [label="Er war mein Freund. Er war mein Bruder.",shape=box,color=blue];
		1598 -> 1599;
	1599 [label="Und nun? Im hier und jetzt?",shape=box,color=blue];
		1599 -> 1600;
	1600 [label="Kann ich ihn nicht mehr spüren.",shape=box,color=blue];
		1600 -> 1601;
		1600 -> 1602;
	1601 [label="Er ... ruht nun, Lyon ... er hat Frieden gefunden.",shape=box,color=red];
		1601 -> 1603;
	1602 [label="Oh, Lyon ...",shape=box,color=red];
		1602 -> 1604;
	1603 [label="Ich weiß. Ich habe es gespürt, als er nicht mehr da war. Ich vermisse ihn sehr. Sein Echo ist immer noch da ... irgendwie, auf irgendeine Weise, auch wenn ich es nicht völlig verstehe.",shape=box,color=blue];
		1603 -> 1605;
		1603 -> 1606;
	1604 [label="Ich vermisse ihn sehr. Sein Echo ist immer noch da ... irgendwie, auf irgendeine Weise, auch wenn ich es nicht völlig verstehe.",shape=box,color=blue];
		1604 -> 1605;
		1604 -> 1606;
	1605 [label="Rell war der Stärkste von uns allen. Ich bin froh, dass du die Gelegenheit hattest, ihn kennenzulernen.",shape=box,color=red];
		1605 -> 1607;
	1606 [label="Rell wurde aufgrund der Ignoranz und Grausamkeit von Kindern ausgestoßen ... er hat nicht verdient, was ihm passiert ist.",shape=box,color=red];
		1606 -> 1608;
	1607 [label="Darüber bin ich auch froh. Und was seine Stärke angeht? Vielleicht, vielleicht auch nicht. Am Ende wusste er einfach, was getan werden musste und er war stark genug, es durchzuhalten.",shape=box,color=blue];
		1607 -> 1609;
	1608 [label="Vielleicht. Aber am Ende, tat er was nötig war. Und er war stark genug, bis zum Ende durchzuhalten.",shape=box,color=blue];
		1608 -> 1609;
	1609 [label="In solchen Momenten ist \"stark genug\" alles, worauf wir hoffen können, denke ich.",shape=box,color=blue];
		1609 -> 1610;
	1610 [label="Was ich leider nicht von diesem Wein sagen kann ... der sehr stark war, aber seine Wirkung setzt sehr langsam ein.",shape=box,color=blue];
		1610 -> 1611;
	1611 [label="Ich sollte gehen bevor ...",shape=box,color=blue];
		1611 -> 1612;
	1612 [label="Ich sollte gehen.",shape=box,color=blue];
		1612 -> 1613;
	1613 [label="Check boolean LyonDating",color=orange];
		1613 -> 1614 [label=true,color=green];
		1613 -> 1615 [label=false,color=brown];
	1614 [label="+20 Chemistry",color=orange];
		1614 -> 1616;
	1615 [label="+20 Chemistry",color=orange];
		1615 -> 1617;
	1616 [label="Vielen Dank, Schatz.",shape=box,color=blue];
		1616 -> 1618;
	1617 [label="Vielen Dank, mein Freund.",shape=box,color=blue];
		1617 -> 1618;
	1618 [label="- Lyon",shape=box,color=blue];
		1618 -> 1619;
	1619 [label="Update boolean LyonConfession2",color=orange];
		1619 -> 1620;
	1620 [label="Update boolean LyonWillDate",color=orange];
		1620 -> 1621;
	1621 [label="Chat ends.",color=orange];
}