digraph {
	1285 [label="LyonRank4Convo7 begins.",color=orange];
		1285 -> 1286;
	1286 [label="Drifter? Darf ich mich bei dir für etwas entschuldigen?",shape=box,color=blue];
		1286 -> 1287;
		1286 -> 1288;
		1286 -> 1289;
	1287 [label="Sicher. Wofür?",shape=box,color=red];
		1287 -> 1290;
	1288 [label="Das brauchst du nicht, Lyon. Du hast nichts falsches getan.",shape=box,color=red];
		1288 -> 1291;
	1289 [label="[Ende.]",shape=box,color=red];
		1289 -> 1292;
	1290 [label="+5 Chemistry",color=orange];
		1290 -> 1293;
	1291 [label="Auch wenn ich das schätze, glaube ich doch, dass du es verdient hast. Ich tue mein Bestes, mich kurzzufassen und mich nicht mit unnötigem Wissen zu belasten.",shape=box,color=blue];
		1291 -> 1294;
	1292 [label="Chat ends.",color=orange];
	1293 [label="Danke. Ich tue mein Bestes, mich kurzzufassen und mich nicht mit unnötigem Wissen zu belasten.",shape=box,color=blue];
		1293 -> 1294;
	1294 [label="Gespräche sind schwierig für mich. Sie sind noch schwieriger bei intimen Begegnungen, als in diesen unpersönlichen, mechanischen Gesprächen oder per Post.",shape=box,color=blue];
		1294 -> 1295;
	1295 [label="Ich weiß nicht, wie ich es beschreiben soll, außer als das, was es ist ... als würde ich nach etwas greifen, nur um zu sehen, wie mir Staubkörner durch die Finger gleiten.",shape=box,color=blue];
		1295 -> 1296;
	1296 [label="Es fühlt sich an, als wäre ich ein leerer Fetzen Leinwand, auf dessen Oberfläche Ölfarben verschmieren, ein nutzloser Versuch den Schatten eines Bildes zu erstellen, den ich vor meinem inneren Auge sehen kann.",shape=box,color=blue];
		1296 -> 1297;
	1297 [label="Und je mehr ich mich anstrenge, desto hoffnungsloser wird das Ganze.",shape=box,color=blue];
		1297 -> 1298;
	1298 [label="Je mehr ich es versuche, desto mehr entgleitet es mir. Also habe ich einfach gelernt ... es gar nicht mehr zu versuchen.",shape=box,color=blue];
		1298 -> 1299;
	1299 [label="Deshalb bin ich dir am Anfang aus dem Weg gegangen. Warum ich immer noch ... zu Phasen der Einsamkeit neige. Mir fehlen die Worte.",shape=box,color=blue];
		1299 -> 1300;
		1299 -> 1301;
		1299 -> 1302;
	1300 [label="Ich werde mich immer freuen, dich in aller Stille neben mir zu haben.",shape=box,color=red];
		1300 -> 1303;
	1301 [label="Manchmal geht es mir genauso. Es ist in Ordnung.",shape=box,color=red];
		1301 -> 1304;
	1302 [label="Entschuldigung angenommen.",shape=box,color=red];
		1302 -> 1305;
	1303 [label="+15 Chemistry",color=orange];
		1303 -> 1306;
	1304 [label="+15 Chemistry",color=orange];
		1304 -> 1307;
	1305 [label="+10 Chemistry",color=orange];
		1305 -> 1308;
	1306 [label="Ich werde mir das merken. Danke, Drifter.",shape=box,color=blue];
		1306 -> 1309;
	1307 [label="Das war mir nicht bewusst. Ich werde nicht mehr annehmen, dass ich so alleine in dieser Welt bin ... Danke, Drifter.",shape=box,color=blue];
		1307 -> 1309;
	1308 [label="Natürlich. Danke, Drifter.",shape=box,color=blue];
		1308 -> 1309;
	1309 [label="-Pater Lyon Allard",shape=box,color=blue];
		1309 -> 1310;
	1310 [label="Chat ends.",color=orange];
}