	328 [label="Interessant. Ich hatte angenommen, du würdest die Gleichgültigkeit für eine Gottheit halten, ähnlich, wie Lua oder Sol. War das falsch?",shape=box,color=blue];
		328 -> 337;
		328 -> 338;
	333 [label="Nein. Aber letzten Endes gibt es mir eine Art Frieden zu glauben, dass ich ahnen kann, was die Gleichgültigkeit tut.",shape=box,color=red];
		333 -> 342;
	334 [label="Nein, im Endeffekt wohl doch nicht. Aber ich bin oft genug darauf gestoßen, dass ich berechtigt bin, es herauszufinden.",shape=box,color=red];
		334 -> 343;
	335 [label="Was könnte es sonst sein? Ich glaube, die Gleichgültigkeit nimmt jeden Teil des menschlichen Körpers und versucht einzeln seinen Zweck zu ergründen.",shape=box,color=red];
		335 -> 344;
	336 [label="Zumindest zerfallen sie dazu, sobald sie getötet werden. Das haben wir bereits mehrfach bewiesen.",shape=box,color=blue];
		336 -> 345;
		336 -> 346;
		336 -> 347;
	341 [label="Hm, ja. Marie hat mir davon erzählt. Du glaubst nicht an unsichtbare Kräfte in unserer Welt und das schließt die Gleichgültigkeit mit ein. Stimmt das?",shape=box,color=blue];
		341 -> 352;
		341 -> 353;
	340 [label="Interessant. Dies ist das zweite Mal, dass ich den Eindruck habe, du würdest nicht an die Realität deiner Gleichgültigkeit glauben. Ist das so?",shape=box,color=blue];
		340 -> 350;
		340 -> 351;
	339 [label="Interessant. Darf ich darauf schließen, dass dein eigener Glaube in letzter Zeit erschüttert wurde? Oder hast du von vornherein nie an deine Gleichgültigkeit geglaubt?",shape=box,color=blue];
		339 -> 350;
		339 -> 351;
	337 [label="Ich bin mir nicht sicher, dass die Gleichgültigkeit real war, bevor wir sie real gemacht haben. Ich glaube, wir haben sie heraufbeschworen, so wie ich Duviri heraufbeschworen habe.",shape=box,color=red];
		337 -> 348;
	338 [label="Ich denke, die Gleichgültigkeit ist eine reale Gottheit, hinter der sich ein reales Bewusstsein versteckt.",shape=box,color=red];
		338 -> 349;
	342 [label="Manchmal frage ich mich, ob das nicht letztlich der Grund ist, warum sich so viele dem Glauben zuwenden.",shape=box,color=blue];
		342 -> 354;
	343 [label="Verzeihung, aber ich fange an, mir Sorgen zu machen, wenn sich jemand \"berechtigt\" fühlt, vor allem, wenn es darum geht, die Beweggründe anderer vorherzusagen.",shape=box,color=blue];
		343 -> 355;
		343 -> 356;
	344 [label="Sollten wir uns Gedanken darüber machen, was passiert, wenn es die weniger offensichtlichen Teile erreicht?",shape=box,color=blue];
		344 -> 357;
	345 [label="Ich glaube, die Gleichgültigkeit versucht zu lernen, was es heißt, \"menschlich\" zu sein. Es was immer etwas Größeres. Anders. Also lernt sie gerade, als etwas Kleineres zu existieren, als Wir.",shape=box,color=red];
		345 -> 358;
	346 [label="Manchmal frage ich mich, ob die Gleichgültigkeit nie wirklich einen eigenen Körper hatte, bevor wir mit ihr interagiert haben. Also lernt sie gerade erst, zu existieren.",shape=box,color=red];
		346 -> 359;
