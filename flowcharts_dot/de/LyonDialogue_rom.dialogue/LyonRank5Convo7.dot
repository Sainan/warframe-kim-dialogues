	"Chat ends." [color=orange];
	j419054240 [label="Mon miracle, ich ... muss sicherstellen, dass du etwas verstehst, bevor ich dir meine nächste Anekdote erzähle.",shape=box,color=blue];
		j419054240 -> j2626296058;
	j301041278 [label="Ich bin nicht überrascht, dass Marie dein Herz mit ihren Händen gefangen hat, wie einen Schmetterling. Sie ist ... etwas Besonderes.",shape=box,color=blue];
		j301041278 -> j2183298434;
	j1243665097 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j1243665097 -> j3347279118 [label="x >= 21",color=purple];
		j1243665097 -> j1970638984 [label="x < 21",color=purple];
		j1243665097 -> j1970638984 [label="false",color=purple];
	j3009249836 [label="Wie geht es dir heute, Lyon?",shape=box,color=red];
		j3009249836 -> j1698114208;
	j188846189 [label="[Gefühle gestehen.] Lyon? Ich habe mich gefragt, ob wir über etwas sprechen können.",shape=box,color=red];
		j188846189 -> j731349746;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j2626296058 [label="Es ist wichtig für mich, dass du die nächsten Worte, die ich sende, sehr genau liest. Verstehst du mich?",shape=box,color=blue];
		j2626296058 -> j2923670365;
		j2626296058 -> j2434998512;
	j2183298434 [label="Check boolean LyonHasDated",color=orange];
		j2183298434 -> j2585166471 [label=true,color=green];
		j2183298434 -> j3098647753 [label=true,color=green];
		j2183298434 -> j4293395196 [label=true,color=green];
		j2183298434 -> j3098647753 [label=false,color=brown];
		j2183298434 -> j4293395196 [label=false,color=brown];
	j3347279118 [label="Ich bin froh, dass jemand die Stärke gefunden hat, durch alle Widerstände von Roathes Persönlichkeit zu blicken und das gebrochene Etwas dahinter zu sehen.",shape=box,color=blue];
		j3347279118 -> j635903023;
	j1970638984 [label="Darf ich dir eine unpassende Frage stellen, mein Freund?",shape=box,color=blue];
		j1970638984 -> j3365989645;
		j1970638984 -> j45537130;
	j1698114208 [label="Was für eine wundervoll harmlose und charmant alltägliche Frage. So etwas werde ich nicht oft gefragt.",shape=box,color=blue];
		j1698114208 -> j285063124;
	j731349746 [label="Ja, worum geht es? Ist etwas passiert?",shape=box,color=blue];
		j731349746 -> j421847197;
		j731349746 -> j1122257513;
	j2923670365 [label="Du machst mich nervös. Was ist los?",shape=box,color=red];
		j2923670365 -> j3119984118;
	j2434998512 [label="Ja, ich bin hier. Leg los.",shape=box,color=red];
		j2434998512 -> j1005928443;
	j2585166471 [label="Ich wusste nicht, wie du dich fühlen würdest, weil ...",shape=box,color=red];
		j2585166471 -> j2651103302;
	j3098647753 [label="Ich bin ... beeindruckt von ihr.",shape=box,color=red];
		j3098647753 -> j4244024780;
	j4293395196 [label="Ist das ein Gespräch, in dem du mir drohst? Oder?",shape=box,color=red];
		j4293395196 -> j2758131379;
	j635903023 [label="Ich weiß, dass er es vehement abstreitet, dass er sich selbst für einen Feigling hält. Ich würde ihn nicht so bezeichnen.",shape=box,color=blue];
		j635903023 -> j123967552;
	j3365989645 [label="Natürlich. Ich habe dich schon viel gefragt.",shape=box,color=red];
		j3365989645 -> j1131036766;
	j45537130 [label="Warum ich mit Roathe ausgehe?",shape=box,color=red];
		j45537130 -> j3175418666;
	j285063124 [label="Mir geht es ... durchaus gut, vielen Dank.",shape=box,color=blue];
		j285063124 -> j38410644;
	j421847197 [label="Schon gut. Tut mir leid. Ich hab vergessen, was ich eigentlich sagen wollte.",shape=box,color=red];
		j421847197 -> j3155138620;
	j1122257513 [label="Ich weiß nicht, wie das am besten sage, also sage ich es einfach direkt: ich habe Gefühle für dich.",shape=box,color=red];
		j1122257513 -> j3698878647;
	j3119984118 [label="Nichts ist los, ganz im Gegenteil. Deshalb ist es so wichtig für dich zu verstehen, vor welchen schlimmen Konsequenzen ich dich bewahren möchte, solltest du fürchten, dass sie eintreten könnten.",shape=box,color=blue];
		j3119984118 -> j2389214246;
		j3119984118 -> j1116753016;
		j3119984118 -> j3061807000;
	j1005928443 [label="+5 Chemistry",color=orange];
		j1005928443 -> j448505163;
	j2651103302 [label="Ha, denkst du, ich bin überrascht? Ich stehe im Schatten ihres Lichts, wie seit jeher. Nein, mein Freund, ich verspreche dir, ich bin weder verbittert noch eifersüchtig.",shape=box,color=blue];
		j2651103302 -> j3284419082;
	j4244024780 [label="So, wie wir alle. Meine Seelenverwandte überrascht mich immer wieder. Ich freue mich für euch beide, mehr, als ich in Worte fassen kann.",shape=box,color=blue];
		j4244024780 -> j1796108144;
	j2758131379 [label="Hm? Nein. Ich wäre kaum so überheblich herumzulaufen und vorzugeben, ich sei ihr Hüter. Sie ist durchaus in der Lage, dir die Knochen zu brechen, wenn sie dich für würdig hält.",shape=box,color=blue];
		j2758131379 -> j1048183147;
	j123967552 [label="Entrati hat ihm gesagt, er würde gebraucht, um eine Zukunft zu retten, die er nicht mal kannte. Eine Zukunft, über die er nicht herrschen würde, in der ihm niemand zu Füßen liegen würde, in der ihn keine Diener anbeten würden.",shape=box,color=blue];
		j123967552 -> j596315825;
	j1131036766 [label="Was ... siehst du in Roathe, dass dazu geführt hat, dass ihr ... eine Romanze habt?",shape=box,color=blue];
		j1131036766 -> j4274586075;
		j1131036766 -> j3762848452;
		j1131036766 -> j1996563388;
	j3175418666 [label="Ich sehe, du wurdest entweder schon darauf angesprochen oder du hast die Frage erwartet. Ja, genau das. Was ... siehst du in ihm?",shape=box,color=blue];
		j3175418666 -> j4274586075;
		j3175418666 -> j3762848452;
		j3175418666 -> j1996563388;
	j38410644 [label="+20 Chemistry",color=orange];
		j38410644 -> j1667427223;
	j3155138620 [label="Passiert mir häufiger. Oft, wenn ich durch Türen gehe. Ich habe mich schon oft gefragt, warum das so ist.",shape=box,color=blue];
		j3155138620 -> j1572459140;
	j3698878647 [label="Ich ... bist du ... sicher? Geht es dir gut? Du hast dir doch nicht etwas kürzlich den Kopf gestoßen?",shape=box,color=blue];
		j3698878647 -> j2246131417;
		j3698878647 -> j1361683570;
	j2389214246 [label="Ich höre.",shape=box,color=red];
		j2389214246 -> j3482518848;
	j1116753016 [label="Du ergibst nicht viel Sinn.",shape=box,color=red];
		j1116753016 -> j268003946;
	j3061807000 [label="Was für schwerwiegende Konsequenzen?",shape=box,color=red];
		j3061807000 -> j3030319167;
	j448505163 [label="Danke. Bevor ich anfange, möchte ich dir versichern, dass nichts los ist, aber darin liegen vielleicht auch die schwerwiegenden Konsequenzen, vor denen ich dich bewahren möchte, solltest du annehmen, dass es zu solchen kommen könnte.",shape=box,color=blue];
		j448505163 -> j2389214246;
		j448505163 -> j1116753016;
		j448505163 -> j3061807000;
	j3284419082 [label="Ich hege keinen Groll wegen dem, was zwischen uns vorgefallen ist. Ich kann nur meine tiefe Dankbarkeit für die Zeit ausdrücken, wie wir zusammen verbracht haben.",shape=box,color=blue];
		j3284419082 -> j3719573823;
	j1796108144 [label="Sie hat so viel Freude in ihren Augen, wenn sie über dich spricht. Und sie ist ganz aufgeregt, wann immer sie glaubt, dass du vorbeischaust.",shape=box,color=blue];
		j1796108144 -> j4128609241;
	j1048183147 [label="Ich wollte dir nur sagen, dass ihre Freude ansteckend ist und dass auch ich lächele, wenn ich daran denke. Und auch dafür danke ich dir.",shape=box,color=blue];
		j1048183147 -> j3311435967;
	j596315825 [label="Vielleicht sieht er es als einen Akt der Angst, als wäre er eine Ratte, die das sinkende Schiff verlässt, als er das Serum nahm und alles vergaß, was dazu führte.",shape=box,color=blue];
		j596315825 -> j2594672456;
	j4274586075 [label="Ganz offen gesagt? Hast du ihn dir mal angesehen?",shape=box,color=red];
		j4274586075 -> j597104300;
	j3762848452 [label="Ich glaube, da ist ein Schmerz in ihm, irgendwo unter all dem ... Humor und seiner Persönlichkeit.",shape=box,color=red];
		j3762848452 -> j1227000636;
	j1996563388 [label="Ich ... kann es nicht ändern. Da ist eine Dunkelheit und eine Gefahr in ihm, die mich fasziniert. Das zieht mich an.",shape=box,color=red];
		j1996563388 -> j6468198;
	j1667427223 [label="Ja, ich es geht mir heute wirklich gut.",shape=box,color=blue];
		j1667427223 -> j3197236733;
	j1572459140 [label="+5 Chemistry",color=orange];
		j1572459140 -> j3197236733;
	j2246131417 [label="Warum ist das so schwer zu glauben?",shape=box,color=red];
		j2246131417 -> j1952799602;
	j1361683570 [label="Ich bin sicher, Lyon. Ich habe keine Gehirnerschütterung.",shape=box,color=red];
		j1361683570 -> j1952799602;
	j3482518848 [label="+5 Chemistry",color=orange];
		j3482518848 -> j3500965168;
	j268003946 [label="Ja, das ist mir schmerzlich bewusst.",shape=box,color=blue];
		j268003946 -> j3030319167;
	j3030319167 [label="Lass mich von vorne anfangen.",shape=box,color=blue];
		j3030319167 -> j3500965168;
	j3719573823 [label="+10 Chemistry",color=orange];
		j3719573823 -> j3719914011;
	j4128609241 [label="+10 Chemistry",color=orange];
		j4128609241 -> j1048183147;
	j3311435967 [label="- Lyon",shape=box,color=blue];
		j3311435967 -> "Chat ends.";
	j2594672456 [label="Ich sehe ihn als einen Mann, der die Lage auf dem Schlachtfeld durchschaute und wusste, wann er eine aussichtslose Sache aufgeben musste. Denn der Krieg war noch längst nicht vorbei.",shape=box,color=blue];
		j2594672456 -> j1494212890;
	j597104300 [label="Es liegt mir fern, über dich zu urteilen.",shape=box,color=blue];
		j597104300 -> j2174395964;
	j1227000636 [label="+5 Chemistry",color=orange];
		j1227000636 -> j2078340285;
	j6468198 [label="Ich kann die Anziehung verstehen. Ich werde nicht leugnen, dass ich sie nicht spüre. Doch hoffe ich für dich, dass du dich davon nicht vereinnahmen lässt.",shape=box,color=blue];
		j6468198 -> j1339126082;
	j3197236733 [label="Hab noch einen schönen Tag. -Lyon",shape=box,color=blue];
		j3197236733 -> "Chat ends.";
	j1952799602 [label="Naja, ich möchte offen sein ... wenn du so viele andere Möglichkeiten hast ... Marie oder Roathe ... oder jeder andere im Universum ...",shape=box,color=blue];
		j1952799602 -> j2780773571;
	j3500965168 [label="Mir ist klar, dass viele mich als krank betrachten und in Wirklichkeit bin ich es vielleicht auch. Zumindest bin ich nicht völlig bei Sinnen.",shape=box,color=blue];
		j3500965168 -> j497941963;
	j3719914011 [label="Jetzt freue ich mich, dass du sie mit ihr verbringst. Sie wird dir Freude bringen, wo ich dir nur Kummer bringen konnte. Sei glücklich mit ihr. Ihr habt meinen Segen.",shape=box,color=blue];
		j3719914011 -> j3311435967;
	j1494212890 [label="Evaluate expressions",color=orange];
		j1494212890 -> j170917486 [label="RoatheVillian",color=purple];
		j1494212890 -> j2493814151 [label="RoatheVillian",color=purple];
		j1494212890 -> j1133340638 [label="RoatheVillian",color=purple];
		j1494212890 -> j170917486 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j2493814151 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j1921202867 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j1133340638 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j170917486 [label="false",color=purple];
		j1494212890 -> j2493814151 [label="false",color=purple];
	j2174395964 [label="Aber ich hoffe für dich, dass diese Laune schnell verfliegt und nicht zur Sucht wird. Ich habe gesehen, wie andere auf diese Weise zerstört wurden.",shape=box,color=blue];
		j2174395964 -> j3399257416;
	j2078340285 [label="Ja, ich habe es selbst gesehen. Auch, wenn er tief vergraben sein mag. Aber er wird deine Neugier wohl kaum begrüßen.Ich glaube, er genießt, was aus ihm wurde.",shape=box,color=blue];
		j2078340285 -> j3399257416;
	j1339126082 [label="Solche Beziehungen sollten auf mehr basieren, als ... nur Dunkelheit. Aber ich werde dich nicht belehren.",shape=box,color=blue];
		j1339126082 -> j3399257416;
	j2780773571 [label="Es fällt mir schwer zu glauben, dass du dich mit einem zerbrochenen Buntglasfenster wie mir abgeben würdest ... es sei denn, dir ist nicht gut.",shape=box,color=blue];
		j2780773571 -> j2884230813;
		j2780773571 -> j921344318;
	j497941963 [label="Ich habe mich längst damit abgefunden. Es bereitet mir keine Schwierigkeiten mehr. Die Visionen, die mich quälen ... die Stimmen ... ich habe Wege gefunden, mit ihnen zu leben, ohne Angst oder Hass.",shape=box,color=blue];
		j497941963 -> j1912958568;
	j170917486 [label="Ich bin nur froh, dass ich für ihn da sein kann, in welcher Form auch immer.",shape=box,color=red];
		j170917486 -> j3430168532;
	j2493814151 [label="Was ihm passiert ist ... kompliziert. Ich glaube, er wird noch lange damit zu kämpfen haben.",shape=box,color=red];
		j2493814151 -> j3430168532;
	j1133340638 [label="Genau. Er tat es, um den Krieg zu gewinnen ... und manchmal bedeutet das, dass man ein paar Schlachten verliert.",shape=box,color=red];
		j1133340638 -> j3430168532;
	j1921202867 [label="Er wird sich mit der Zeit selbst vergeben. Aber ich glaube nicht, dass sich seine äußere Hülle je wirklich ändern wird.",shape=box,color=red];
		j1921202867 -> j3430168532;
	j3399257416 [label="Du kennst deine eigenen Wünsche und Grenzen. Ich wünsche euch beiden alles Gute.",shape=box,color=blue];
		j3399257416 -> j2195823893;
	j2884230813 [label="Lyon? Ich habe Gefühle für dich. Du bist mir wichtig. Ich möchte mir dir zusammen sein, sofern du auch mit mir zusammen möchtest.",shape=box,color=red];
		j2884230813 -> j2830073011;
	j921344318 [label="Wenn du sagst, dass es nicht gegenseitig ist ...",shape=box,color=red];
		j921344318 -> j2028461682;
	j1912958568 [label="(In letzter Zeit denke ich, ein wenig aus Trotz, wenn ich ehrlich sein darf, aber das tut hier nichts zur Sache.)",shape=box,color=blue];
		j1912958568 -> j3813473061;
	j3430168532 [label="+10 Chemistry",color=orange];
		j3430168532 -> j3794383079;
	j2195823893 [label="+10 Chemistry",color=orange];
		j2195823893 -> j4284678760;
	j2830073011 [label="Vergib mir, bitte vergib mir ... ich dachte nur ... ich hielt es nicht für möglich, dass ... es ist nicht etwas, was ich mir hätte vorstellen können ...",shape=box,color=blue];
		j2830073011 -> j372163651;
	j2028461682 [label="Kaum! Das ist wirklich nicht, was ich meine! Weit davon entfernt, wirklich, ich ... hielt es einfach nicht für möglich ... dass ... ich hätte mir das nicht vorstellen können ...",shape=box,color=blue];
		j2028461682 -> j372163651;
	j3813473061 [label="Aber ich möchte, dass du verstehst, solltest du die Dinge zwischen uns beenden wollen, diese Verbindung, von der ich vormals dachte, dass sie niemals zwischen einem anderen und mir existieren könnten ...",shape=box,color=blue];
		j3813473061 -> j3647410210;
	j3794383079 [label="Dafür wünsche ich euch beiden das Allerbeste.",shape=box,color=blue];
		j3794383079 -> j4284678760;
	j4284678760 [label="Davon abgesehen, jetzt, wo er eine \"Alternative\" hat, hat er aufgehört, Marie zu einem offenen Konflikt zu provozieren.",shape=box,color=blue];
		j4284678760 -> j1943092810;
	j372163651 [label="+20 Chemistry",color=orange];
		j372163651 -> j1494655862;
	j3647410210 [label="Sollte dein Herz sich je von meinem abwenden?",shape=box,color=blue];
		j3647410210 -> j407626006;
	j1943092810 [label="Naja, jedenfalls nicht so oft. Bis später.",shape=box,color=blue];
		j1943092810 -> j3745530910;
	j1494655862 [label="Du bist wahrlich mon miracle ...",shape=box,color=blue];
		j1494655862 -> j1374158912;
	j407626006 [label="Werde ich es aushalten, mon miracle.",shape=box,color=blue];
		j407626006 -> j3603921094;
	j3745530910 [label="-Lyon",shape=box,color=blue];
		j3745530910 -> "Chat ends.";
	j1374158912 [label="Boolean LyonDating is now true.",color=orange];
		j1374158912 -> j4115967391;
	j3603921094 [label="Ich werde nicht von dem verzehrt werden, was mich geplagt hat.",shape=box,color=blue];
		j3603921094 -> j1697539566;
	j4115967391 [label="Boolean IsDating is now true.",color=orange];
		j4115967391 -> j3642226382;
	j1697539566 [label="Check boolean LyonAllRight",color=orange];
		j1697539566 -> j2467017396 [label=true,color=green];
		j1697539566 -> j3643628750 [label=false,color=brown];
	j3642226382 [label="Boolean LyonHasDated is now true.",color=orange];
		j3642226382 -> "Chat ends.";
	j2467017396 [label="Ich werde, um es mit deinen Worten zu sagen \"ok sein\". Ich werde einen Grund finden, erneut zu Lächeln und zu Lachen.",shape=box,color=blue];
		j2467017396 -> j2545267727;
		j2467017396 -> j3326698626;
	j3643628750 [label="Ich werde überleben. Mir wird es gut gehen. Ich werde einen Grund finden, erneut zu Lächeln und zu Lachen.",shape=box,color=blue];
		j3643628750 -> j2545267727;
		j3643628750 -> j3326698626;
	j2545267727 [label="Oh Lyon, du bist keine Last für mich.",shape=box,color=red];
		j2545267727 -> j258526705;
	j3326698626 [label="Willst du mir sagen ... dass du die Dinge zwischen uns beenden willst?",shape=box,color=red];
		j3326698626 -> j1926507523;
	j258526705 [label="Ich versuche nur, dich von jeglicher vermeintlichen Belastung zu befreien, die du meinetwegen empfinden könntest ...",shape=box,color=blue];
		j258526705 -> j70281202;
		j258526705 -> j1363819843;
		j258526705 -> j1457308716;
	j1926507523 [label="Nein! Nichts dergleichen! Ich versuche nur, dich von jeglicher vermeintlichen Belastung zu befreien, die du meinetwegen empfinden könntest ...",shape=box,color=blue];
		j1926507523 -> j70281202;
		j1926507523 -> j1363819843;
		j1926507523 -> j1457308716;
	j70281202 [label="Dein Schmerz ... erinnert mich an meinen eigenen. Es wäre mir niemals eine Last, dir dabei zu helfen.",shape=box,color=red];
		j70281202 -> j541114603;
	j1363819843 [label="Ich kann nicht beschreiben, was mich an dir fasziniert. Aber du wirst niemals eine Pflicht oder eine Last sein.",shape=box,color=red];
		j1363819843 -> j1337705115;
	j1457308716 [label="[Trennen.] Es ist einfach alles zu viel für mich, es tut mir leid. Es ist das beste, dies hier zu beenden.",shape=box,color=red];
		j1457308716 -> j3380732135;
	j541114603 [label="Ich kann gar nicht in Worte fassen, wie sehr mir das Herz für dich bricht. Aber ich bin unendlich dankbar, dass unsere einsamen Geister des Schmerzes einander gefunden haben.",shape=box,color=blue];
		j541114603 -> j682125779;
	j1337705115 [label="Wofür ich meine Dankbarkeit nicht angemessen ausdrücken kann und ich glaube nicht, dass Worten dies je gelingen wird.",shape=box,color=blue];
		j1337705115 -> j682125779;
	j3380732135 [label="Ja, natürlich. Es wäre ... heuchlerisch, zu diesem Zeitpunkt eine andere Antwort zu akzeptieren ...",shape=box,color=blue];
		j3380732135 -> j3102506291;
	j682125779 [label="Aber nun, da ich mir große Mühe gegeben habe, diese äußerst spektakuläre, selbstgefällige Einleitung durchzugehen ...",shape=box,color=blue];
		j682125779 -> j1129372176;
		j682125779 -> j3734722656;
		j682125779 -> j3155673829;
	j3102506291 [label="Ich verstehe vollkommen. Und ich wünsche dir nur das Beste. Und ich werde all die Momente, die wir zusammen verbracht haben, in Ehren halten.",shape=box,color=blue];
		j3102506291 -> j631059260;
	j1129372176 [label="Für jemanden, der so schweigsam angefangen hat, bist du ganz schön gesprächig geworden.",shape=box,color=red];
		j1129372176 -> j2593911680;
	j3734722656 [label="Ich finde sie liebenswert, keine Sorge.",shape=box,color=red];
		j3734722656 -> j2378775330;
	j3155673829 [label="Du hättest auch sagen können: \"Mir wird es gut gehen, solltest du je getrennte Wege gehen wollen.\"",shape=box,color=red];
		j3155673829 -> j1885114987;
	j631059260 [label="Ich werde sie in meiner Seele bewahren, auch, wenn sie aus meinem Gedächtnis verschwinden mögen. Lebe wohl.",shape=box,color=blue];
		j631059260 -> j183093822;
	j2593911680 [label="+5 Chemistry",color=orange];
		j2593911680 -> j3192115166;
	j2378775330 [label="+5 Chemistry",color=orange];
		j2378775330 -> j2093086097;
	j1885114987 [label="+5 Chemistry",color=orange];
		j1885114987 -> j3034694126;
	j183093822 [label="Boolean LyonDating is now false.",color=orange];
		j183093822 -> j175813166;
	j3192115166 [label="Pah! Wenn du nicht wissen wolltest, was in meinem Inneren vor sich geht, hättest du dort nicht herumschnüffeln sollen. Das bist du selber schuld.",shape=box,color=blue];
		j3192115166 -> j1131955518;
	j2093086097 [label="Es freut mich, dass dir meine Erzählungen gefallen. Genau deshalb spreche ich so wenig. Kannst du dir vorstellen, das persönlich aushalten zu müssen? Marie hätte mich vor Jahren wie einen tollwütigen Hund schlafen gelegt.",shape=box,color=blue];
		j2093086097 -> j1131955518;
	j3034694126 [label="Es gibt eine gewisse Respektlosigkeit und einen gewissen Sarkasmus, die dir natürlich zufallen und die ich niemals erreichen könnte. Ich überlasse das dir.",shape=box,color=blue];
		j3034694126 -> j1131955518;
	j175813166 [label="Boolean IsDating is now false.",color=orange];
		j175813166 -> j3745530910;
	j1131955518 [label="Dennoch sollte das alles nur als Vorwand für die Geschichte dienen, die jetzt im Vergleich ziemlich kurz zu sein scheint ...",shape=box,color=blue];
		j1131955518 -> j1208159439;
	j1208159439 [label="Letzte Nacht bin ich aus einem Albtraum aufgewacht. Als ich aufwachte, war ich von Schatten umgeben. Das ist nichts Ungewöhnliches oder Neues in meinem Gemütszustand. Sie ragten über meinem Bett auf und wollten nicht verschwinden.",shape=box,color=blue];
		j1208159439 -> j2205493671;
	j2205493671 [label="Ich fürchtete sie nicht, denn ich wusste, sie konnten mir nichts anhaben. Aber sie gingen mir auch nicht aus dem Kopf. Ich kenne nur einen Weg, sie zu vertreiben.",shape=box,color=blue];
		j2205493671 -> j4292459266;
	j4292459266 [label="Ich rappelte mich auf, zog mich so gut ich konnte an und taumelte durch die verschwommene Vision meines anhaltenden Albtraums. Ich griff mein Weihrauchfass, fiel in der Mitte des Raum auf die Knie und bereitete mich darauf vor ... nun ja.",shape=box,color=blue];
		j4292459266 -> j696703118;
	j696703118 [label="Ich bereitete mich darauf vor, \"meinen Geist zu befreien\". Lassen wir es dabei.",shape=box,color=blue];
		j696703118 -> j2506925358;
	j2506925358 [label="Aber als ich meine Augen schloss, schweiften meine Gedanken ab. Sie schweiften ab ... zu dir, mon miracle ...",shape=box,color=blue];
		j2506925358 -> j2011258899;
	j2011258899 [label="Der Klang deiner Stimme. Die Berührung deiner Hand auf meiner Schulter ...",shape=box,color=blue];
		j2011258899 -> j2159542503;
	j2159542503 [label="Und die Visionen ... flohen. Sie verließen ihren Posten, verjagt von einem stärkeren Geist ... von dir.",shape=box,color=blue];
		j2159542503 -> j3485095750;
	j3485095750 [label="Ich ... stand auf. Stellte mein Weihrauchfass auf den Nachttisch und ... beschloss stattdessen, durch den Sand des Sanctums zu wandern ...",shape=box,color=blue];
		j3485095750 -> j278798956;
		j3485095750 -> j624186134;
	j278798956 [label="Jetzt kann ich das Bedürfnis nach einem Vorwand verstehen.",shape=box,color=red];
		j278798956 -> j745268362;
	j624186134 [label="Ich weiß nicht, was ich sagen soll ...",shape=box,color=red];
		j624186134 -> j3354694073;
	j745268362 [label="Ja. Nun, auf meiner Wanderung, wurde mir ... augenblicklich die dunkle Gefahr eines solchen Moments bewusst. Dass du es ... als Verantwortung ansehen könntest und mich als Fessel, die ich belasten könnte.",shape=box,color=blue];
		j745268362 -> j3917563505;
	j3354694073 [label="+5 Chemistry",color=orange];
		j3354694073 -> j2012528201;
	j3917563505 [label="Ich flehe dich an ... ich bete zu jedem Gott im Himmel oder auf Erden, dass dies niemals  passiert. Du hast mir ein Geschenk gegeben und jedes Mal werden ich seine Neuheit wertschätzen.",shape=box,color=blue];
		j3917563505 -> j3630217431;
	j2012528201 [label="Es braucht keine Worte, mon miracle ...",shape=box,color=blue];
		j2012528201 -> j2663167129;
	j3630217431 [label="Versprich es mir, mon miracle ... sollte eine Zeit kommen, in der ich für dich zu einem leeren Käfig werden ... wirst du dich von mir befreien.",shape=box,color=blue];
		j3630217431 -> j3798623477;
	j2663167129 [label="Auf meiner Wanderung, wurde mir ... augenblicklich die dunkle Gefahr eines solchen Moments bewusst. Dass du es ... als Verantwortung ansehen könntest und mich als Fessel, die ich belasten könnte.",shape=box,color=blue];
		j2663167129 -> j3917563505;
	j3798623477 [label="Ich werde für die, die ich liebe, kein leeres Gefängnis sein. Nicht für dich. Nicht für Marie.",shape=box,color=blue];
		j3798623477 -> j2614612464;
		j3798623477 -> j1269351691;
	j2614612464 [label="[Trennen.] Ich ... das kann ich nicht versprechen, tut mir leid.",shape=box,color=red];
		j2614612464 -> j2871211904;
	j1269351691 [label="Ich verspreche es.",shape=box,color=red];
		j1269351691 -> j1347512467;
	j2871211904 [label="+10 Chemistry",color=orange];
		j2871211904 -> j2194742709;
	j1347512467 [label="+10 Chemistry",color=orange];
		j1347512467 -> j3242544498;
	j2194742709 [label="Danke. Danke, mon miracle, für deine Ehrlichkeit. Das hat Mut erfordert, in diesem Moment und dafür bewundere ich dich.",shape=box,color=blue];
		j2194742709 -> j34062247;
	j3242544498 [label="Danke. Ich danke dir, mon miracle ...",shape=box,color=blue];
		j3242544498 -> j3564271695;
	j34062247 [label="Ich werde alle Momente, die wir zusammen verbracht haben, in Ehren halten. Und dies bedeutet mir mehr, als du ahnen kannst.",shape=box,color=blue];
		j34062247 -> j719540946;
	j3564271695 [label="Ich bin plötzlich so müde, als wäre ... eine große Last von meinen Schultern genommen worden. Ich fürchte, ich muss mich hinlegen.",shape=box,color=blue];
		j3564271695 -> j21916968;
	j719540946 [label="Ich werde sie in meiner Seele bewahren, auch, wenn sie aus meinem Gedächtnis verschwinden mögen. Lebe wohl.",shape=box,color=blue];
		j719540946 -> j3994460333;
	j21916968 [label="- Lyon",shape=box,color=blue];
		j21916968 -> j3446510588;
	j3994460333 [label="Boolean LyonDating is now false.",color=orange];
		j3994460333 -> j4254443866;
	j3446510588 [label="Boolean LyonDatingConfession is now true.",color=orange];
		j3446510588 -> "Chat ends.";
	j4254443866 [label="Boolean IsDating is now false.",color=orange];
		j4254443866 -> j3311435967;
}