	2215 [label="Chat ends.",color=orange];
	2216 [label="Ich möchte, wenn ich darf, kurz etwas ansprechen, von dem ich glaube, dass es für uns beide wichtig ist, mon miracle.",shape=box,color=blue];
		2216 -> 2217;
		2216 -> 2218;
	2214 [label="Chat ends.",color=orange];
	2217 [label="[Ende.]",shape=box,color=red];
		2217 -> 2219;
	2218 [label="Stimmt etwas nicht, Lyon?",shape=box,color=red];
		2218 -> 2220;
	2219 [label="Update boolean LyonConsentComplete",color=orange];
		2219 -> 2221;
	2220 [label="Nein, alles in Ordnung. Ich wollte nur sagen, dass ich weiß, dass du Zeit mit jemand anderem ... auf leidenschaftliche Art verbringst, wenn du nicht bei mir bist.",shape=box,color=blue];
		2220 -> 2222;
	2221 [label="Chat ends.",color=orange];
	2222 [label="Ich wollte dir lediglich versichern, dass mich dies weder stört noch beunruhigt. Deine Anwesenheit in meinem Leben hat mir nichts als Frieden und Freude gebracht ...",shape=box,color=blue];
		2222 -> 2223;
	2223 [label="Und wie könnte ich es jemals verweigern, dass ein solches Geschenk einem anderen Menschen zuteilwird?",shape=box,color=blue];
		2223 -> 2224;
		2223 -> 2225;
	2224 [label="Ich bin mir sicher, meine andere Beziehung würde dich vergöttern.",shape=box,color=red];
		2224 -> 2226;
	2225 [label="Vielen Dank. Das bedeutet mir sehr viel.",shape=box,color=red];
		2225 -> 2227;
	2226 [label="Der Gedanke daran lässt mich lächeln. Und wer weiß, vielleicht begegnen wir uns in einem anderen Leben oder an einem anderen Tag.",shape=box,color=blue];
		2226 -> 2228;
	2227 [label="So wie wir sind – so wie ich bin, mit allem, was du mir gebracht hast, allem, wofür wir stehen ... bin ich zufrieden. Nein, ich bin ... glücklich. Zum ersten Mal seit sehr, sehr langer Zeit.",shape=box,color=blue];
		2227 -> 2229;
	2228 [label="Aber hier und jetzt bin ich zufrieden, so wie es ist. Nein, ich bin ... glücklich. Zum ersten Mal seit sehr, sehr langer Zeit.",shape=box,color=blue];
		2228 -> 2229;
	2229 [label="Und dafür habe ich dir zu danken. Fürs Erste verabschiede ich mich jedoch von dir.",shape=box,color=blue];
		2229 -> 2230;
	2230 [label="- Lyon",shape=box,color=blue];
		2230 -> 1193;
	1193 [label="Update boolean LyonConsentComplete",color=orange];
		1193 -> 1187;
	1187 [label="Chat ends.",color=orange];
}