	700 [label="Update boolean LyonSuspicious",color=orange];
		700 -> 710;
	701 [label="Ich frage mich, in wie weit sich unsere Glaubensrichtungen gegenseitig beeinflusst haben, absichtlich oder unabsichtlich.",shape=box,color=blue];
		701 -> 704;
	698 [label="Faszinierend! Als Priester hoffe ich sehr, dass wir genügend Zeit haben werden, gegenseitig über unsere jeweiligen Glaubensvorstellungen zu lernen.",shape=box,color=blue];
		698 -> 704;
	695 [label="Das ist eine lange Geschichte.",shape=box,color=red];
		695 -> 707;
	696 [label="Ich habe eine Reihe verschiedener Religionen studiert und keine davon hat mir wirklich zugesagt. Am Ende hatte ich eine ziemlich skurrile Sammlung der Menschheit.",shape=box,color=red];
		696 -> 708;
	697 [label="Ich glaube, was ich fühle. Und dafür brauche ich weder ein Gebäude noch ein Buch.",shape=box,color=red];
		697 -> 709;
	690 [label="Wahrhaftig? Ich bin ... überrascht. Überrascht, aber erfreut. Dann ist es auch kein Wunder, dass du neugierig bist. Unsere Lehren müssen dir völlig fremd sein. So viel Zeit wie vergangen ist.",shape=box,color=blue];
		690 -> 704;
	691 [label="Das kann ich respektieren. Es ist ehrenvoll, anzuerkennen, was wir nicht verstehen können, die Kleinheit des menschlichen Daseins zu begreifen.",shape=box,color=blue];
		691 -> 704;
	692 [label="Keine Sorge, ich nehme es dir nicht übel. Und in vielen Fällen hast du sicher recht.",shape=box,color=blue];
		692 -> 705;
		692 -> 706;
	693 [label="Ich gebe zu, ich bin neidisch darüber, dass du dir keine Gedanken darüber machst, was auf uns jenseits von allem warten könnte. Wäre das mehr Menschen so gegangen, hätte unsere Welt friedlichere Zeiten erlebt.",shape=box,color=blue];
		693 -> 704;
	694 [label="Das ist ein Thema, das ich gerne ausführlich mit dir besprechen möchte. Nur nicht jetzt, zu diesem Zeitpunkt bin ich für ein solches Gespräch noch nicht bereit.",shape=box,color=blue];
		694 -> 704;
	688 [label="Ein kluger Anfang. Eine Kultur über ihre Feiertage kennenzulernen, heißt, ihr Inneres zu verstehen. So, wie ein Volk feiert, so bleibt es in Erinnerung. Diese Momente sind diejenigen, die von denen, die sei teilen, am meisten geschätzt werden.",shape=box,color=blue];
		688 -> 702;
	689 [label="Natürlich. Lass uns damit beginnen, was du schon wissen könntest: Sol und Lua, die Sonne und der Mond. Sie sind Gottheiten, deren Aspekte sich ständig verändern.",shape=box,color=blue];
		689 -> 703;
	710 [label="Hm. Dann erlaube mir, deine Neugier zu befriedigen. Damit ich dich nicht zu Tode langweile, wo möchtest du beginnen?",shape=box,color=blue];
		710 -> 665;
		710 -> 664;
	704 [label="Und ich bedauere es, dass ich nicht beim Thema bleibe. Ich fürchte, ich bin weit vom ursprünglichen Thema abgewichen.",shape=box,color=blue];
		704 -> 714;
	707 [label="+20 Chemistry",color=orange];
		707 -> 717;
	708 [label="+20 Chemistry",color=orange];
		708 -> 718;
	709 [label="+20 Chemistry",color=orange];
		709 -> 719;
	705 [label="Das bedeutet aber nicht, dass ich kein Interesse daran habe, zu lernen.",shape=box,color=red];
		705 -> 715;
	706 [label="Wie in deinem Fall?",shape=box,color=red];
		706 -> 716;
	702 [label="Unsere wichtigsten und verbreitesten Feiertage sind Winter- und Sommersonnenwende, die den kürzesten und längsten Tag des Jahres markieren.",shape=box,color=blue];
		702 -> 711;
	703 [label="Sie erschienen ihren Gläubigen im Laufe der Jahrhunderte in vielen verschiedenen Formen. Manchmal männlich,  manchmal weiblich. Aber immer als Sol, die Sonne und Lua, der Mond.",shape=box,color=blue];
		703 -> 712;
		703 -> 713;
	714 [label="Du wolltest etwas über die Orthodoxie der Himmlischen wissen, nicht wahr? Damit ich dich nicht zu Tode langweile, wo möchtest du anfangen?",shape=box,color=blue];
		714 -> 665;
		714 -> 664;
	717 [label="Hm, und eine, die man am besten einem vertrauten Freund erzählt. Das verstehe ich völlig. Davon abgesehen, wolltest du Informationen von mir haben, nicht umgekehrt.",shape=box,color=blue];
		717 -> 704;
	718 [label="Ein Buntglasfenster der Seele. Zerbrochen, wenn man es auseinandernimmt, aber was für ein schönes Bild es ergibt, wenn es zusammengefügt ist.",shape=box,color=blue];
		718 -> 704;
	719 [label="Die Welt wäre ein besserer Ort, wenn sie deinen Glauben teilte.",shape=box,color=blue];
		719 -> 704;
	715 [label="Und dafür lobe ich deine neugierige und wissenschaftliche Natur.",shape=box,color=blue];
		715 -> 704;
	716 [label="Mein Fall ist ... komplex. Aber ich werde nicht lügen und behaupten, ich hätte keine Angst gehabt. Auch wenn die Religion eine Flut an Angst in mein Leben gespült hat, hat sie sie nie entfernen können.",shape=box,color=blue];
		716 -> 704;
	711 [label="Beide Feiertage sind von großen Festen geprägt, aber die Art der Feier unterscheidet sich, je nachdem, mit wem sie teilt. Die Wintersonnenwende teilt man mit Familie und Freunden, die Sommersonnenwende teilt man mit Fremden.",shape=box,color=blue];
		711 -> 720;
		711 -> 721;
	712 [label="Oh, das ergibt jetzt sehr viel mehr Sinn.",shape=box,color=red];
		712 -> 722;
	713 [label="[Lass ihn weiterreden.]",shape=box,color=red];
		713 -> 723;
	720 [label="Tatsächlich? Erzähl mir mehr von der Sommersonnenwende.",shape=box,color=red];
		720 -> 724;
	721 [label="Erzähl mir mehr von der Wintersonnenwende.",shape=box,color=red];
		721 -> 725;
	722 [label="Ja, manche Kapitel können sehr streng in der Wahl ihrer Ikonographie sein, indem sie sagen Sol \"muss\" so oder so sein, aber die Orthodoxie erkennt dies nicht als Tatsache an.",shape=box,color=blue];
		722 -> 726;
	723 [label="Jeder der Himmlischen hat in sich selbst verschiedene Aspekte. Jeder Aspekt kann als Funktion des Ganzen betrachtet werden. Lua zum Beispiel ist die Mutter, die Jungfrau, die Alte.",shape=box,color=blue];
		723 -> 731;
	724 [label="Die Sommersonnenwende ist ein Fest des Teilens, währenddessen wir Fremde zusammenbringen, die sich noch nie begegnet sind. Man versammelt sich in einem Feld, bringt Essen und selbstgemachte Waren mit, ganz egal, was.",shape=box,color=blue];
		724 -> 728;
	725 [label="Die Wintersonnenwende dient dazu, sich gegen die Kälte zu wappnen und jene zu ehren, die uns in dunklen Zeiten warm halten. Man dekoriert einen Baum mit Kerzen, ein Licht für jeden, der vor uns kam und uns nun als Stern am Himmel den Weg weist.",shape=box,color=blue];
		725 -> 729;
	726 [label="Ich nehme an, dass das, was bis in diese ferne Zukunft überlebt hat ... ein wenig verwirrend ist, was die Dokumentation meiner Religion angeht.",shape=box,color=blue];
		726 -> 730;
	731 [label="Kann aber auch \"Er, der die Seelen entlang des Flusses aus Tränen in die Dunkelheit leitet\" sein. Der Tod selbst. Vorbote und Herold.",shape=box,color=blue];
		731 -> 734;
	728 [label="Kerzen, Brot, Kleidung, Gemälde. Oder Gedichtbände. Oder Kränze aus Blumen. Auch wenn man mit leeren Händen und nur einer \"frohen Botschaft\" kommt, gilt es als Segen.",shape=box,color=blue];
		728 -> 732;
	729 [label="Und auf der Spitze, Sol selbst, leidend oben auf dem Sternenbaum in der Dunkelheit. Verdunkelt, aber nicht vergessen. Denn dies ist die Zeit von Lua und wir feiern Lua in der Zeit der Schatten.",shape=box,color=blue];
		729 -> 733;
	730 [label="Ich fühle mich, wie ein lebendes archäologisches Relikt. Sehr deprimierend. Aber ich schweife ab.",shape=box,color=blue];
		730 -> 723;
	734 [label="In anderen Kapiteln ist der Tod eine alte verschleierte Frau. Es gibt Unterschiede. Aber man bezieht sich immer auf dasselbe Wesen, welches uns alle erreicht. Die silberne Hand, die uns in unseren letzten Momenten führen möchte.",shape=box,color=blue];
		734 -> 737;
	732 [label="An Sols längstem Tag werden Leben, Lachen und Musik gefeiert und Teilen all dieser Dinge.",shape=box,color=blue];
		732 -> 735;
	733 [label="Und während wir näher zusammenrücken, laben wir uns an einem gebratenen Vogel und Wurzelgemüse und allem, was jetzt neu in der gefrorenen Erde wächst und halten unsere Liebsten fest. Dann erzählen wir Geschichten von denen, die nicht mehr unter uns sind.",shape=box,color=blue];
		733 -> 736;
	737 [label="Der Mond, der in der Sonnenfinsternis vor die Sonne gleitet und uns am Scheideweg durch den Moment führt, bei dem alles verloren scheint.",shape=box,color=blue];
		737 -> 739;
	735 [label="Alle waren willkommen, um neue Freunde aus Fremden zu machen und das mit nach Hause zu nehmen, was man brauchte.",shape=box,color=blue];
		735 -> 738;
	736 [label="Während Luas längster Nacht erinnern wir uns daran, dass Lua uns und unsere Familie durch das Ende führen wird.",shape=box,color=blue];
		736 -> 738;
	739 [label="Update boolean DrifterEclipse",color=orange];
		739 -> 741;
	738 [label="Aber der heiligste aller Feiertage der Himmlischen war Summum Bonum. Ein seltenes Ereignis, wenn sich Sol und Lua in einer perfekten Sonnenfinsternis zusammentreffen.",shape=box,color=blue];
		738 -> 740;
	741 [label="Check boolean VelimirEclipse",color=orange];
		741 -> 744 [label=true,color=green];
		741 -> 743 [label=false,color=brown];
	740 [label="Es ist ein wundersames und heiliges Ereignis, bei dem die gesamte Natur reagiert. Hattest du das Glück, selbst einen mitzuerleben?",shape=box,color=blue];
		740 -> 742;
	744 [label="Moment ...",shape=box,color=red];
		744 -> 747;
	743 [label="Hast du je eine Sonnenfinsternis gesehen?",shape=box,color=red];
		743 -> 746;
	742 [label="Update boolean DrifterEclipse",color=orange];
		742 -> 745;
	747 [label="Das klingt ... sehr vertraut.",shape=box,color=red];
		747 -> 755;
	746 [label="Ich hatte das Glück, es zweimal mitzuerleben. Und beide Male fand ich es ... transformierend. Wenn ich für immer in diesem kurzen Moment verweilen könnte, würde ich es tun.",shape=box,color=blue];
		746 -> 754;
