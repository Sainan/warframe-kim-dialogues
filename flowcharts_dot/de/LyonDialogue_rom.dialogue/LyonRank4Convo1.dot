	662 [label="Ich fürchte, da gibt es viele Themen, die man ausführlich besprechen kann. Und versteh mich  nicht falsch, das würde ich gerne, aber ich möchte dich nicht zu Tode langweilen. Also, wo möchtest du anfangen?",shape=box,color=blue];
		662 -> 664;
		662 -> 665;
	675 [label="Nein, ich bin einfach nur neugierig.",shape=box,color=red];
		675 -> 686;
	676 [label="Ich bin religiös. Mein Glaube ist deinem ähnlich, auch wenn du ihn nicht wiedererkennen würdest.",shape=box,color=red];
		676 -> 687;
	674 [label="Ich bin religiös. Aber du würdest unsere Bräuche nicht wiedererkennen.",shape=box,color=red];
		674 -> 685;
	673 [label="Ich bin religiös. Mein Glaube ist sehr persönlich für mich, er hat nicht wirklich einen Namen.",shape=box,color=red];
		673 -> 684;
	672 [label="Ich folge dem Pfad von Sol, wie Marie.",shape=box,color=red];
		672 -> 679;
	671 [label="Ich bin wie du, ich folge dem Pfad von Lua.",shape=box,color=red];
		671 -> 679;
	666 [label="Ich folge den Himmlischen, aber ich versuche, einen ausgewogenen Pfad zu nehmen.",shape=box,color=red];
		666 -> 679;
	667 [label="Ich glaube, dass da draußen etwas ist, aber ich glaube nicht, dass man letztlich die Antwort wirklich begreifen kann.",shape=box,color=red];
		667 -> 680;
	668 [label="Ich bin nicht religiös. Nichts für ungut, aber ich denke, dass Religion eine Krücke für Ängstliche ist.",shape=box,color=red];
		668 -> 681;
	669 [label="Ich bin nicht religiös. Ich will nicht sagen, dass es nicht etwas dort draußen geben könnte, das ist nur nichts, worüber ich mir Gedanken mache.",shape=box,color=red];
		669 -> 682;
	670 [label="Ich bin nicht religiös. Ich glaube, alle Götter, sogar die Gleichgültigkeit, sind ein Produkt unserer Fantasie. Nichts für ungut.",shape=box,color=red];
		670 -> 683;
	664 [label="Kannst du mir von euren Feiertagen berichten?",shape=box,color=red];
		664 -> 677;
	665 [label="Kannst du mir von Sol und Lua erzählen?",shape=box,color=red];
		665 -> 678;
