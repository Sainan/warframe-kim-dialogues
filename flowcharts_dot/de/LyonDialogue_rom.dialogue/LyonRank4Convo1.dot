	755 [label="Wie meinst du das?",shape=box,color=blue];
		755 -> 760;
	754 [label="Ein anders Mal werde ich dir die Geschichte der ersten Sonnenfinsternis erzählen, die ich miterlebt habe. Es ist spät geworden. Oder früh. Ich kann es nicht genau sagen.",shape=box,color=blue];
		754 -> 759;
	748 [label="Leider nein.",shape=box,color=red];
		748 -> 756;
	749 [label="Das habe ich, es war beeindruckend.",shape=box,color=red];
		749 -> 757;
	750 [label="Das habe ich, es war okay.",shape=box,color=red];
		750 -> 757;
	751 [label="Das habe ich, es war fantastisch.",shape=box,color=red];
		751 -> 746;
	753 [label="Ja, da habe ich. Hat eine furchtbare megrim oculaire ausgelöst, ob du es glaubst oder nicht. Aber es war fantastisch.",shape=box,color=red];
		753 -> 758;
	752 [label="Ja, da habe ich. Hat eine furchtbare Augenmigräne ausgelöst, ob du es glaubst oder nicht. Aber es war fantastisch.",shape=box,color=red];
		752 -> 758;
	760 [label="Klingt dieser Satz für dich vertraut: \"Suche an einem leeren Scheideweg die Sonnenfinsternis ... denn wenn sich Sol und Lua vereinen, werden die Verlorenen ihren Weg nach Hause finden.\"",shape=box,color=red];
		760 -> 764;
	759 [label="Update boolean LyonFirstEclipse",color=orange];
		759 -> 762;
		759 -> 763;
	756 [label="Falls du je die Gelegenheit hast, geniesse es.",shape=box,color=blue];
		756 -> 746;
	757 [label="Ich wünschte, ich könnte deine Gleichgültigkeit gegenüber diesem Ereignis teilen ...",shape=box,color=blue];
		757 -> 746;
	758 [label="Die Himmlischen müssen dich berührt haben und ihre Anwesenheit war zu viel für dich. Oder vielleicht wollten sie dich für eine schwere Sünde bestrafen. Eines von beidem. Ha.",shape=box,color=blue];
		758 -> 761;
	764 [label="Celestines 18:19, aus dem Dritten Buch der Orthodoxen von Lua. Wo im Namen der Himmlischen hast du denn das gehört?",shape=box,color=blue];
		764 -> 767;
		764 -> 768;
	762 [label="Wann immer du bereit bist.",shape=box,color=red];
		762 -> 765;
	763 [label="Ich freue mich darauf. Danke für deine Zeit, Lyon.",shape=box,color=red];
		763 -> 766;
	761 [label="So sind die Wege der Götter. Ihre Zeichen können oft unterschiedlich ausgelegt werden.",shape=box,color=blue];
		761 -> 754;
	767 [label="Sehr lange Geschichte. Aber ich denke, dass einige eurer Schriften von der Gleichgültigkeit aufgenommen wurden.",shape=box,color=red];
		767 -> 770;
	768 [label="Von einigen alten Freunden. Sie nutzen diesen Satz als zwei Hälften eines Losunswortes für ihre Tocher, die ... naja, lassen wir das.",shape=box,color=red];
		768 -> 771;
