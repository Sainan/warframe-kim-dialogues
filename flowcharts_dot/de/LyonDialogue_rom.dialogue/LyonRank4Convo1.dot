	771 [label="Dabei ging es um den Mann in der Wand, war alles ziemlich chaotisch.",shape=box,color=red];
		771 -> 770;
	769 [label="Hm, ja. Es scheint unvermeidlich zu werden.",shape=box,color=blue];
		769 -> 772;
	773 [label="Ich ... verstehe. Ich würde bald gerne mehr darüber erfahren, wenn ich darf. Jetzt bin ich nicht darauf vorbereitet und es ist hier spät geworden. Oder vielleicht auch früh. Schwer zu sagen.",shape=box,color=blue];
