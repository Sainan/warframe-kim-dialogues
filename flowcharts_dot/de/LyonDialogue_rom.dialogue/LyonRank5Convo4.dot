		j2424658669 -> j1730791731;
	j1418110040 [label="Ich weiß nicht, ob sich beides gegenseitig ausschließt, aber ... ich weiß nicht. Vielleicht werden wir es nie erfahren.",shape=box,color=red];
		j1418110040 -> j3336209981;
	j1833904328 [label="Ich bin einfach ... froh, dass Rell und Harrow bei dir sein konnten, Lyon ... wenn auch nur in der Erinnerung.",shape=box,color=red];
		j1833904328 -> j917768549;
	j917768549 [label="Danke. Ich vermisse ihre Anwesenheit. Aber ich ... lerne langsam, dass es an diesem Ort mehr Leute gibt, die meinen Schmerz verstehen können, als solche, die es nicht tun.",shape=box,color=blue];
		j917768549 -> j3099767311;
	j76346375 [label="Danke. Ich vermisse ihre Anwesenheit. Aber ich ... bin nicht länger alleine, nicht wahr, mon miracle?",shape=box,color=blue];
		j76346375 -> j3099767311;
	j1730791731 [label="Ja. Denke nicht, dass ich dies nicht in Betracht gezogen hätte. Ich bin mir nicht sicher, ob mein Glaube so leicht wiederhergestellt werden kann, aber ... es ist doch tröstlich, darüber nachzudenken.",shape=box,color=blue];
		j1730791731 -> j3099767311;
	j3336209981 [label="In der Tat. Denke nicht, ich hätte nicht darüber nachgedacht, ob Rell und Harrow von den Himmlischen gesandt wurden, um mich zu trösten. Aber wie du gesagt hast, es ist nicht an uns, dies zu wissen.",shape=box,color=blue];
		j3336209981 -> j3099767311;
