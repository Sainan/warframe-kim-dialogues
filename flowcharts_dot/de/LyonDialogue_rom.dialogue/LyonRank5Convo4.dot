		j2793227429 -> "Chat ends." [label="false",color=purple];
	j3224421746 [label="[Konversation wurde aufgrund von zuvor aktivierter Triggerwarnung übersprungen.]",shape=box,color=blue];
		j3224421746 -> j1028404978;
	j623336186 [label="Ich weiß nicht, ob ich richtig beschreiben kann, was für ein seltsamer Moment es war, als ich das Serum injizierte, mon miracle.",shape=box,color=blue];
		j623336186 -> j1510537834;
		j623336186 -> j1293221251;
		j623336186 -> j2938589332;
		j623336186 -> j1132094242;
	j778972378 [label="Ich weiß nicht, ob ich richtig beschreiben kann, was für ein seltsamer Moment es war, als ich das Serum injizierte, mein Freund.",shape=box,color=blue];
		j778972378 -> j1510537834;
		j778972378 -> j1293221251;
		j778972378 -> j2938589332;
		j778972378 -> j1132094242;
	"Chat ends." [color=orange];
	j1028404978 [label="Boolean LyonRell3 is now true.",color=orange];
		j1028404978 -> j4075781927;
	j1510537834 [label="Ich habe gehört, dass es äußerst schmerzhaft ist.",shape=box,color=red];
		j1510537834 -> j973232896;
	j1293221251 [label="Ich kann es mir nicht vorstellen.",shape=box,color=red];
		j1293221251 -> j2301990212;
	j2938589332 [label="[Warnung: Erwähnung von Selbstverletzung und Kindesmisshandlung. Hier klicken, zum Verlassen. Du verlierst dadurch keine Chemiepunkte mit Lyon.]",shape=box,color=red];
		j2938589332 -> j1843578849;
	j1132094242 [label="[Ende.]",shape=box,color=red];
		j1132094242 -> j3856020424;
	j4075781927 [label="Boolean LyonWillDate is now true.",color=orange];
		j4075781927 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j973232896 [label="Ich nehme es an. Obwohl ich denke, dass ich in dieser Hinsicht jahrelange Übung hatte, und daher ließen Entratis Warnungen das Ganze wesentlich eindrucksvoller erscheinen, als es am Ende war.",shape=box,color=blue];
		j973232896 -> j2301990212;
	j2301990212 [label="Marie und ich entschieden, das Serum jeweils alleine einzunehmen. Ich bat sie darum, als erster die Veränderung zu erleben, damit ich sie danach durch ihre eigene leiten konnte, aber natürlich, lehnte sie standhaft ab.",shape=box,color=blue];
		j2301990212 -> j1675207878;
	j1843578849 [label="+20 Chemistry",color=orange];
		j1843578849 -> j2698387260;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	"Chat ends. Next chat will be Lyon5FaithDay2." [color=orange];
	j1675207878 [label="Sie spottete über die bloße Vorstellung, ich würde irgendwohin gehen oder irgendetwas tun, ohne sie an meiner Seite zu haben und begab sich in ihre eigenen Gemächer.",shape=box,color=blue];
		j1675207878 -> j408929860;
	j2698387260 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j2698387260 -> j2559080857;
	j408929860 [label="Ich verriegelte meine Tür, zog mich aus und saß in der Mitte des Zimmers auf dem Boden, so weit weg von allen Objekten, wie es ging, bevor ich mir die Nadel in die Seite stieß.",shape=box,color=blue];
		j408929860 -> j3875825206;
	j2559080857 [label="Boolean LyonRell3 is now true.",color=orange];
		j2559080857 -> j4008758555;
	j3875825206 [label="Ich hatte gesehen, was der Befall Roathe angetan hatte, sein Fleisch wurde mit dem verschmolzen, was er zu dem Zeitpunkt getragen hatte, ich hatte kein Interesse daran, dieses Schicksal zu teilen.",shape=box,color=blue];
		j3875825206 -> j2261534092;
	j4008758555 [label="Boolean LyonFaith3Unknown is now true.",color=orange];
		j4008758555 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j2261534092 [label="Als die Qual vorbei war, war mein ohnehin schon getrübter Blick ... verschwommen. Irgendwie ... doppelt? Als würde ich nicht einfach, sondern zweifach sehen.",shape=box,color=blue];
		j2261534092 -> j1656404823;
	j1656404823 [label="Ich bin durchaus stolz auf meine Widerstandskraft, denn ich schaffte es, meine Hose anzuziehen, bevor ich mich übergab und ohnmächtig wurde.",shape=box,color=blue];
		j1656404823 -> j3915334963;
	j3915334963 [label="Als ich aufwachte, war ich nicht alleine. Noch lag ich auf dem Boden meines Zimmers. Ich saß in meinem Kinderzimmer, auf dem alten, knarrenden Dielenboden, den ich so gut kannte.",shape=box,color=blue];
		j3915334963 -> j4048649638;
	j4048649638 [label="Und neben mir saß ein junger Mann. Neben ihm stand eine Gestalt, die ich jetzt als Harrow kenne. Der junge Mann hielt eine kleine Holzfigur in den Händen. Die Gelenke der Glieder waren steif, die Farbe war längst abgenutzt, außer in den Falten und Rissen. Sie gehörte meinem Vater. Sie stellte einen Soldaten dar.",shape=box,color=blue];
		j4048649638 -> j2288333521;
	j2288333521 [label="Als Kind war dies das einzige Spielzeug, das mir gehörte.",shape=box,color=blue];
		j2288333521 -> j736840742;
		j2288333521 -> j154025901;
	j736840742 [label="Als Kind hatte ich eine ähnliche Figur. Es war eines meiner liebsten Spielzeuge.",shape=box,color=red];
		j736840742 -> j3623784697;
	j154025901 [label="Rell?",shape=box,color=red];
		j154025901 -> j549862128;
	j3623784697 [label="Ich habe davon gehört. Ich glaube mein Spielzeug war am Ende harmloser.",shape=box,color=blue];
		j3623784697 -> j1858329302;
		j3623784697 -> j2096761774;
		j3623784697 -> j3848569459;
	j549862128 [label="In der Tat.",shape=box,color=blue];
		j549862128 -> j3258067641;
	j1858329302 [label="Thrax ist ein kompliziertes Thema. Da möchte ich jetzt lieber nicht näher darauf eingehen.",shape=box,color=red];
		j1858329302 -> j3067977532;
	j2096761774 [label="Er war wirklich nicht sein Fehler. Er war einfach der, den ich in diesem Moment brauchte.",shape=box,color=red];
		j2096761774 -> j2241475893;
	j3848569459 [label="Ist in Ordnung. Er macht langsam Fortschritte. Irgendwie. Das scheinbar Unmögliche kann sich ändern.",shape=box,color=red];
		j3848569459 -> j4074223029;
	j3258067641 [label="Der junge Mann und sein stiller Wächter, die mich in meinem Traum ... in meinem Geist ... besuchten, waren gleichzeitig Fremde und doch so vertraut, als wären wir als Brüder zusammen aufgewachsen.",shape=box,color=blue];
		j3258067641 -> j4069986762;
	j3067977532 [label="Verständlich. Wir könnten uns hier stundenlang in Diskussionen über die moralischen und theologischen Implikationen von Duviri verlieren.",shape=box,color=blue];
		j3067977532 -> j3258067641;
	j2241475893 [label="Wenn ich auch nur ansatzweise darüber nachdenke, was ich an deiner Stelle heraufbeschworen hätte, überkommt mich Entsetzen. Wir könnten das hier stundenlang diskutieren.",shape=box,color=blue];
		j2241475893 -> j3258067641;
	j4074223029 [label="Wenn er Anzeichen von Veränderung zeigt und ein Produkt deiner Gefühle ist, deutet das vielleicht auf etwas anderes hin. Aber das ist ein Thema für ein anderes Mal.",shape=box,color=blue];
		j4074223029 -> j3258067641;
	j4069986762 [label="Vergib mir diese übertriebene Metapher, aber es war, als wären wir drei Bäume, deren Wurzeln so miteinander verwachsen waren, dass sie nicht mehr voneinander zu unterscheiden waren ...",shape=box,color=blue];
		j4069986762 -> j2388645834;
	j2388645834 [label="... die einfach in diesem Zustand ins Leben gerufen worden waren. Ich erinnerte mich an mein Leben ohne Rell und Harrow. Und doch waren sie da. In jedem Moment, jedem Augenblick, neben mir.",shape=box,color=blue];
		j2388645834 -> j1054188120;
	j1054188120 [label="Nur so nebenbei, ich wünschte, ich könnte mit Entrati darüber sprechen. Ich will unbedingt wissen, was für eine Wissenschaft ... ohne Scherz ... die Wurzel all dessen ist, aber als wir uns endlich von unserer Veränderung erholten, war Entrati fort.",shape=box,color=blue];
		j1054188120 -> j1937133691;
	j1937133691 [label="Check boolean LoidFamilyComplete",color=orange];
		j1937133691 -> j399286170 [label=true,color=green];
		j1937133691 -> j2037087036 [label=false,color=brown];
		j1937133691 -> j399286170 [label=false,color=brown];
	j399286170 [label="Soweit ich den Befall kenne und wie er funktioniert, scheint er irgendwie ... vielleicht ... ich weiß nicht, außerhalb der Zeit zu existieren?",shape=box,color=red];
		j399286170 -> j3405696227;
	j2037087036 [label="Entratis Tochter ist oben. Sie hat an seiner Seite studiert und gearbeitet. Vielleicht kann sie helfen.",shape=box,color=red];
		j2037087036 -> j1896818506;
	j3405696227 [label="Es gibt eine ... Gitarre ... es ist alles schwer zu erklären, aber wir beide sind durch Helminth durch die Zeit gereist ...",shape=box,color=red];
		j3405696227 -> j2783129442;
	j1896818506 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j1896818506 -> j1990086451;
	j2783129442 [label="Und das ist ein Vorgang, von dem ich glaube, dass er noch lange in meinen Albträumen verfolgen wird. Wie dem auch sei, ich kenne die genauen Gründe nicht, warum Rell, Harrow und ich auf so ... molekulare und spirituelle Weise verbunden wurden.",shape=box,color=blue];
		j2783129442 -> j988351013;
	j1990086451 [label="Add 1 to Family counter",color=orange];
		j1990086451 -> j1984290405;
	j988351013 [label="Aber das funktioniert in beide Richtungen. Wo sie in meinem Leben auftauchen, tauchte ich in ihrem auf. Ich habe die Gleichgültigkeit gesehen. Ich verstand, was sie bewachten. Ich erhaschte einen Blick auf Harrow und auf den Mann, der er mal war.",shape=box,color=blue];
		j988351013 -> j2269929157;
	j1984290405 [label="Wenn wir nur mit ihr sprechen dürften. Ich nehme an, es gibt bereits entsprechende Pläne. Sollte das der Fall sein, kannst du auf ... meine Hilfe zählen. Ich kann überzeugend sein, wenn es nötig ist.",shape=box,color=blue];
		j1984290405 -> j4083769334;
	j2269929157 [label="Aber die Gleichgültigkeit gewann die Oberhand. Ich konnte sie spüren ... und hörte, was sie hörten, das Klopfen an der Wand. Rapp ... tapp ... tapp ...",shape=box,color=blue];
		j2269929157 -> j1971512931;
	j4083769334 [label="Wie dem auch sei, ich kenne die genauen Gründe nicht, warum Rell, Harrow und ich auf so ... molekulare und spirituelle Weise verbunden wurden.",shape=box,color=blue];
		j4083769334 -> j988351013;
	j1971512931 [label="All die Visionen meiner Jugend, all die Gräuel, die ich gesehen habe ... waren sie alle nur die Gleichgültigkeit? Erinnerte ich mich nur falsch? Oder war ich doch von Lua \"gesegnet\"?",shape=box,color=blue];
		j1971512931 -> j3988335425;
	j3988335425 [label="Der Glaube in mir ... er zerfiel und verschwand. Nichts als verkohltes Papier, das sich in Staub verwandelt. Und wie sehr ich mich für meine Schwäche verachte ...",shape=box,color=blue];
		j3988335425 -> j2547210604;
	j2547210604 [label="Evaluate expressions",color=orange];
		j2547210604 -> j2330956073 [label="LyonDating",color=purple];
		j2547210604 -> j1564891283 [label="DrifterFaithYesSimilar",color=purple];
		j2547210604 -> j1564891283 [label="DrifterFaithYesForeign",color=purple];
		j2547210604 -> j1564891283 [label="DrifterFaithPersonal",color=purple];
		j2547210604 -> j3135965228 [label="DrifterFaithSol",color=purple];
		j2547210604 -> j3135965228 [label="DrifterFaithLua",color=purple];
		j2547210604 -> j3135965228 [label="DrifterFaithBalance",color=purple];
		j2547210604 -> j2788313182 [label="DrifterFaithAgnostic",color=purple];
		j2547210604 -> j3770534147 [label="DrifterFaithNoFear",color=purple];
		j2547210604 -> j3281083995 [label="DrifterFaithNoMITW",color=purple];
		j2547210604 -> j3770534147 [label="DrifterFaithNoMaybe",color=purple];
		j2547210604 -> j2846884589 [label="false",color=purple];
	j2330956073 [label="Oh, Lyon ... du hast so viel durchgemacht. Zweifel sind nicht die Folge von Schwäche, sie sind die Folge von Schmerz.",shape=box,color=red];
		j2330956073 -> j3151003443;
		j2330956073 -> j143413565;
		j2330956073 -> j1846460966;
		j2330956073 -> j3913827787;
		j2330956073 -> j2300536203;
	j1564891283 [label="Glaube muss nicht gleichbleibend sein und das wird auch nicht erwartet. Wie viele Geschichten gibt es über jene, die ihren Glauben verlieren und dann wiederfinden?",shape=box,color=red];
		j1564891283 -> j3151003443;
		j1564891283 -> j143413565;
		j1564891283 -> j1846460966;
	j3135965228 [label="Du hast dein Leben den Himmlischen gewidmet, Lyon. Glaubst du, sie würden sich wegen so etwas von dir abwenden?",shape=box,color=red];
		j3135965228 -> j3151003443;
		j3135965228 -> j143413565;
		j3135965228 -> j1846460966;
	j2788313182 [label="Ich weiß nicht, ob es Götter gibt oder nicht, Lyon, aber ich glaube nicht, dass wir es je wirklich wissen werden. Was ich aber weiß ist, dass du viel durchgemacht hast.",shape=box,color=red];
		j2788313182 -> j3151003443;
		j2788313182 -> j1846460966;
		j2788313182 -> j3913827787;
	j3770534147 [label="Während ich persönlich nicht glaube, dass es Götter gibt, weiß ich doch, wie wichtig es für dich in deinem Leben ist. Das möchte ich nicht kleinreden.",shape=box,color=red];
		j3770534147 -> j1846460966;
		j3770534147 -> j2300536203;
	j3281083995 [label="Die Gleichgültigkeit wurde von uns geschaffen, sie ist kein Gott, Lyon. Lass nicht zu, dass Entratis Fehler dich zerstört. Und was deinen Glauben angeht?",shape=box,color=red];
		j3281083995 -> j1846460966;
		j3281083995 -> j2300536203;
	j2846884589 [label="Ich hasse es, dich so zu sehen, mitten in jedermanns Unsinn. Das hast du nicht verdient.",shape=box,color=red];
		j2846884589 -> j3151003443;
		j2846884589 -> j143413565;
		j2846884589 -> j1846460966;
		j2846884589 -> j3913827787;
		j2846884589 -> j2300536203;
	j3151003443 [label="Ich sage nicht, dass du deinen Glauben wiederfinden musst. Ich sage nur, wenn du ihn wiederfinden willst oder das Gefühl hast, ihn zu brauchen, dass er nicht auf ewig verloren ist.",shape=box,color=red];
		j3151003443 -> j2797086433;
	j143413565 [label="Sicherlich kann Lua sehen, was du durchgemacht hast. Was du in ihrem Namen ertragen hast.",shape=box,color=red];
		j143413565 -> j3156854587;
	j1846460966 [label="Ich glaube, du solltest dich darauf konzentrieren, eine Art inneren Frieden zu finden, wie auch immer du ihn finden kannst.",shape=box,color=red];
		j1846460966 -> j2797086433;
	j3913827787 [label="Falls es einen Gott gibt, falls Lua existiert ... kann sie sicher sehen, was du durchgemacht hast. Was du in ihrem Namen ertragen hast. Das muss ihr etwas bedeuten.",shape=box,color=red];
		j3913827787 -> j3156854587;
	j2300536203 [label="Ich glaube, du solltest dich von der Vorstellung verabschieden, dass es Götter gibt oder auch nicht, und dich darauf konzentrieren, dich zunächst selbst zu heilen.",shape=box,color=red];
		j2300536203 -> j2779911332;
	j2797086433 [label="Boolean LyonFaith3Maybe is now true.",color=orange];
		j2797086433 -> j1217623279;
	j3156854587 [label="Boolean LyonFaith3Yes is now true.",color=orange];
		j3156854587 -> j1217623279;
	j2779911332 [label="Boolean LyonFaith3No is now true.",color=orange];
		j2779911332 -> j1217623279;
	j1217623279 [label="Vielleicht hast du recht ... Und meine traurige Geschichte voller Zweifel war ja kaum der springende Punkt. Aber ich werde deine Worte bedenken. Wir werden das morgen ausführlicher besprechen.",shape=box,color=blue];
		j1217623279 -> j3404366893;
	j3404366893 [label="Ich sah Rells Leben an Bord der Zariman Ten-Zero und alles, was er danach ertragen musste. Ich sah Harrows Leben als Soldat, das durch den Befall ausgelöscht wurde. Genau wie sie mein Leben in Gallien und all mein Leid sahen.",shape=box,color=blue];
		j3404366893 -> j1483466435;
	j1483466435 [label="Es mag dir seltsam erscheinen, dass wir nie auch nur ein Wort gewechselt haben. Das brauchten wir nie. Es gab zwischen uns einfach ein ... Verstehen.",shape=box,color=blue];
		j1483466435 -> j928616954;
		j1483466435 -> j199015720;
	j928616954 [label="Wirklich nie?",shape=box,color=red];
		j928616954 -> j3483312304;
	j199015720 [label="Ja ... kann ich nachvollziehen.",shape=box,color=red];
		j199015720 -> j2078696148;
	j3483312304 [label="Ich konnte ihre Stimmen hören ... ich kannte alle Worte, die sie im Leben je gesprochen hatten. Aber sie waren nie an mich gerichtet.",shape=box,color=blue];
		j3483312304 -> j2078696148;
	j2078696148 [label="Braucht ein Lächeln eine Erklärung? Oder ein Stirnrunzeln? Musst du ein Kind weinen hören oder sehen, um zu wissen, dass es Schmerzen oder Angst hat? Nein, wir wussten einfach was zwischen uns ausgetauscht wurde.",shape=box,color=blue];
		j2078696148 -> j1694437697;
	j1694437697 [label="Bis dies ... nicht mehr der Fall war.",shape=box,color=blue];
		j1694437697 -> j944777217;
	j944777217 [label="Check boolean LyonDating",color=orange];
		j944777217 -> j3168991767 [label=true,color=green];
		j944777217 -> j2791199780 [label=false,color=brown];
	j3168991767 [label="Sie sind nicht fort, mon miracle ... nur tot.",shape=box,color=blue];
		j3168991767 -> j804459482;
	j2791199780 [label="Sie sind nicht fort, mein Freund ... nur tot.",shape=box,color=blue];
		j2791199780 -> j804459482;
	j804459482 [label="Ich kann ihre unbestimmten Teile nicht länger hören. Ich glaube, jetzt kann ich nur noch die Teile hören, die bestimmt waren.",shape=box,color=blue];
		j804459482 -> j3769518917;
		j804459482 -> j4092507270;
	j3769518917 [label="Es tut mir leid, bestimmt?",shape=box,color=red];
		j3769518917 -> j3605867597;
	j4092507270 [label="Wann hast du aufgehört ... ihn zu hören?",shape=box,color=red];
		j4092507270 -> j2241208854;
	j3605867597 [label="Ich kann es nicht besser erklären, als ich es bereits getan habe. Ich weiß nicht, wie. Entschuldige.",shape=box,color=blue];
		j3605867597 -> j2241208854;
	j2241208854 [label="Von dem Moment an, als wir mit Roathe durch den Helminth hierher zum Sanctum kamen. Ich weiß nicht ... warum. Oder wie.",shape=box,color=blue];
		j2241208854 -> j3701360030;
	j3701360030 [label="Aber als wir durch diesen Schleier der Zeit schritten, meine Freunde, meine Brüder ... die Bäume, deren Wurzeln so eng mit meiner Seele verwoben waren ... verdorrten und starben neben mir.",shape=box,color=blue];
		j3701360030 -> j1339093402;
	j1339093402 [label="Jetzt ist dort nur Leere. Fäule. Ihre Erinnerung verdirbt immer noch meine eigenen. Aber ich würde sie nicht hergeben, selbst wenn dich die Chance dazu hätte ...",shape=box,color=blue];
		j1339093402 -> j210830086;
		j1339093402 -> j4245137;
	j210830086 [label="Oh?",shape=box,color=red];
		j210830086 -> j2257159510;
	j4245137 [label="Warum nicht?",shape=box,color=red];
		j4245137 -> j2257159510;
	j2257159510 [label="Ich erinnere mich an das erste Mal, als meine Mutter mich schlug. Ich erinnere mich an zwei Versionen, so klar wie Sols hellstes Licht und ich weiß, dass alle Versionen davon wahr sind.",shape=box,color=blue];
		j2257159510 -> j2999314188;
	j2999314188 [label="In einer ... weine ich alleine in der Dunkelheit meines Zimmers. In einer anderen, stehen zwei Gestalten neben mir in den Schatten.",shape=box,color=blue];
		j2999314188 -> j769875181;
	j769875181 [label="Ich erinnere mich zweimal daran, als ich das erste Mal eine Klinge an meine Haut setzte, um die Stimmen aus meinem Geist zu vertreiben. Einmal ist der Raum leer.",shape=box,color=blue];
		j769875181 -> j1230104912;
	j1230104912 [label="Ein anderes Mal höre ich ein Summen hinter mir. Fühle die stille Anwesenheit eines stoischen Wächters.",shape=box,color=blue];
		j1230104912 -> j2350571603;
	j2350571603 [label="Ich habe meinen Glauben an meine Göttin Lua verloren und habe im Gegenzug ihre Führung erhalten ... vielleicht ein Tausch, den ich bereitwillig eingehe.",shape=box,color=blue];
		j2350571603 -> j2400849994;
	j2400849994 [label="Evaluate expressions",color=orange];
		j2400849994 -> j1132626308 [label="LyonDating",color=purple];
		j2400849994 -> j817388500 [label="LyonDating",color=purple];
		j2400849994 -> j1132626308 [label="DrifterFaithYesSimilar",color=purple];
		j2400849994 -> j1984677772 [label="DrifterFaithYesSimilar",color=purple];
		j2400849994 -> j1132626308 [label="DrifterFaithYesForeign",color=purple];
		j2400849994 -> j1984677772 [label="DrifterFaithYesForeign",color=purple];
