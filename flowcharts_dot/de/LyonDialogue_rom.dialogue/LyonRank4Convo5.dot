digraph {
	"LyonRank4Convo5 begins." [color=orange];
		"LyonRank4Convo5 begins." -> j3425926750;
	j3425926750 [label="Check boolean LyonSerum1",color=orange];
		j3425926750 -> j2447097868 [label=true,color=green];
		j3425926750 -> j129698615 [label=true,color=green];
		j3425926750 -> j4203763270 [label=false,color=brown];
		j3425926750 -> j129698615 [label=false,color=brown];
	j2447097868 [label="Lyon, ich habe mich gefragt, ob du mir den Rest der Geschichte erzählst, wie Roathe zu dir und Marie in die Kathedrale kam?",shape=box,color=red];
		j2447097868 -> j3275078107;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j4203763270 [label="Lyon, ich habe mich gefragt, ob du mir die Geschichte erzählst, wie Roathe zu dir und Marie in die Kathedrale kam?",shape=box,color=red];
		j4203763270 -> j2002088294;
	j3275078107 [label="Wenn du möchtest. Es ist jedoch keine besonders schöne Geschichte. Er wurde vor unserer Tür abgelegt, wie ein verwundeter, verwilderter Kater.",shape=box,color=blue];
		j3275078107 -> j3769319211;
	"Chat ends." [color=orange];
	j2002088294 [label="Wenn du möchtest. Er wurde vor unserer Tür ausgesetzt, wie ein verletzter Streuner. Die Geschichte ist nicht sehr erfreulich.",shape=box,color=blue];
		j2002088294 -> j3769319211;
	j3769319211 [label="Evaluate expressions",color=orange];
		j3769319211 -> j2402883769 [label="LyonStray",color=purple];
		j3769319211 -> j876772975 [label="RoatheSerum1",color=purple];
		j3769319211 -> j3558962622 [label="false",color=purple];
	j2402883769 [label="Ich hatte recht, die Geschichte handelte von Roathe.",shape=box,color=red];
		j2402883769 -> j649305629;
	j876772975 [label="So, wie er es erzählt, hatte er allen Grund, etwas ... wild zu sein, als er auftauchte.",shape=box,color=red];
		j876772975 -> j1694622884;
	j3558962622 [label="Wie du meinst, sprich weiter.",shape=box,color=red];
		j3558962622 -> j2266356665;
	j649305629 [label="Das war eine Geschichte über einen Streuner, der unsere Kathedrale besucht hat. Welchen Sinn du darin siehst oder warum ich sie dir erzählt habe, liegt allein in deiner Verantwortung. Ich bin schließlich ein Priester, nicht wahr?",shape=box,color=blue];
		j649305629 -> j2266356665;
	j1694622884 [label="Das wäre meine Erwartung, dass jemand seines Status und seiner Persönlichkeit sich von den Taten Entratis gegen ihn, verraten fühlt. Ganz ehrlich, ich wäre erstaunt gewesen, wenn er es mit stiller Würde ertragen hätte.",shape=box,color=blue];
		j1694622884 -> j2266356665;
	j2266356665 [label="Evaluate expressions",color=orange];
		j2266356665 -> j1550268284 [label="LyonSerum1",color=purple];
		j2266356665 -> j1754386487 [label="false",color=purple];
	j1550268284 [label="Ich glaube, ich habe da aufgehört, wo Entrati nach seinem Verschwinden wieder mit Roathe aufgetaucht war, so wie er jetzt ist, bereits verändert. Entrati offenbarte uns all die Lügen, die er uns über drei Jahre lang erzählt hatte.",shape=box,color=blue];
		j1550268284 -> j3830806040;
	j1754386487 [label="Ich werde versuchen, die Ereignisse, die zu diesem Moment geführt haben, zusammenzufassen, anderfalls könnten die Dinge ... bestenfalls unsinnig klingen.",shape=box,color=blue];
		j1754386487 -> j799044938;
	j3830806040 [label="Er bot uns die \"Protoframe-Seren\" an, die uns in das verwandelt haben, was wir nun sind und sobald wir sie angenommen hatten ... verließ er uns erneut.",shape=box,color=blue];
		j3830806040 -> j3860740576;
	j799044938 [label="Für drei Jahre, zwei Monate und elf Tage diente er als Cardinal Dimanche in unserer Kathedrale. Und die ganze Zeit dienten Marie und ich ihm, ohne zu ahnen, was er mit uns vorhatte.",shape=box,color=blue];
		j799044938 -> j195584935;
	j3860740576 [label="Und dort blieben wir zurück, als frisch verwaiste Mischwesen, Köper und Seelen umgeformt in Kreationen, die wir kaum verstehen, geschweige denn beherrschen konnten.",shape=box,color=blue];
		j3860740576 -> j4195160778;
	j195584935 [label="Ich kenne deine Fragen, bevor du sie stellst. Was führte er im Schilde? Hat er die Stadt infiziert, wie er es in Höllvania getan hat? Was waren seine Pläne? Seine Entdeckungen?",shape=box,color=blue];
		j195584935 -> j2849655868;
	j4195160778 [label="Gestrandet in einer Stadt, die zwar unser Zuhause, aber uns nicht länger freundlich gesinnt war. Wir waren gezwungen ... uns zu verstecken.",shape=box,color=blue];
		j4195160778 -> j4213257640;
		j4195160778 -> j453360095;
	j2849655868 [label="Darauf antworte ich dir, du wirst enttäuscht sein. Er predigte. Er studierte. Er ruhte. Und er hat gebetet. Dann, eines Nachts, verschwand er mitten in einem schrecklichen Sturm. Demselben, in dem er aufgetaucht war.",shape=box,color=blue];
		j2849655868 -> j2575044127;
	j4213257640 [label="Aufgrund eures Aussehens?",shape=box,color=red];
		j4213257640 -> j1486993599;
	j453360095 [label="Hat die Kathedrale euch fortgeschickt?",shape=box,color=red];
		j453360095 -> j405560853;
	j2575044127 [label="Check boolean MarieLyonVisions",color=orange];
		j2575044127 -> j2462253748 [label=true,color=green];
		j2575044127 -> j635713325 [label=false,color=brown];
	j1486993599 [label="Ich weiß nicht, ob dir das entgangen ist, aber Marie kann fliegen und Roathe ist ... blau, neben anderen Problemen.",shape=box,color=blue];
		j1486993599 -> j2465933040;
	j405560853 [label="Nicht ganz. Wir mussten uns vom öffentlichen Leben fernhalten. Aber unsere Brüder und Schwestern verbannten uns nicht auf die Straße oder verbrannten uns auf einem Scheiterhaufen. \"Cardinal Dimanche\" überzeugte sie, dass unsere Veränderung ... das Werk der Himmlischen war.",shape=box,color=blue];
		j405560853 -> j3532032108;
	j2462253748 [label="Auch wenn mir bewusst ist, dass andere diesen Sturm nicht wahrgenommen haben, war er für mich deutlich spürbar.",shape=box,color=blue];
		j2462253748 -> j635713325;
	j635713325 [label="Genau ein Jahr später erschien er ein letztes Mal, mit ... Roathe, so, wie du ihn jetzt kennst, bewusstlos und zusammengebrochen zu seinen Füßen.",shape=box,color=blue];
		j635713325 -> j1237122437;
	j2465933040 [label="Ich weiß, dass du deine Tage mit sprechenden Tieren und Schädeln verbringst und der Frage nach dem kosmischen Void, aber das ist nicht die Regel für die meisten Menschen.",shape=box,color=blue];
		j2465933040 -> j3483484480;
	j3532032108 [label="Wir wurden in den Krypten versteckt und blieben außer Sicht. Unsere ehemaligen Brüder, auch wenn sie Angst vor uns hatten, versorgten uns mit Vorräten.",shape=box,color=blue];
		j3532032108 -> j533126095;
	j1237122437 [label="Ein Teufel in Menschengestalt, so schien es jedenfalls. Das war, als Entrati uns die Wahrheit darüber sagte, wer er war und die tatsächliche Aufgabe, die er für uns hatte. Das er uns beide für eine \"heilige Mission\" auserwählt hatte.",shape=box,color=blue];
		j1237122437 -> j1743766504;
	j3483484480 [label="In der Tat wäre von uns dreien ich derjenige, der am ehesten unter die Leute gehen könnte, wenn ich mich nur gut genug verhüllen würde.",shape=box,color=blue];
		j3483484480 -> j2676646157;
		j3483484480 -> j2720816094;
	j533126095 [label="Sie ... bestanden darauf, nur mit Marie zu interagieren, trotz ihrer plötzlichen geisterhaften Erscheinungen, um sie auf der Treppe zu begrüßen.",shape=box,color=blue];
		j533126095 -> j3720102431;
		j533126095 -> j3358054373;
	j1743766504 [label="Marie nahm das Serum bereitwillig an. Natürlich, tat sie das. Was hätte sie sonst tun sollen? Und wie hätte ich ihr nicht folgen können? Wie hätte ich nicht die Wahrheit suchen können, egal wohin sie führt?",shape=box,color=blue];
		j1743766504 -> j249472217;
	j2676646157 [label="Wo habt ihr gelebt?",shape=box,color=red];
		j2676646157 -> j3485919622;
	j2720816094 [label="Wie seid ihr alle hier gelandet?",shape=box,color=red];
		j2720816094 -> j2324161527;
	j3720102431 [label="Ich verstehe, dass sie Roathe aus dem Weg gehen wollten, aber ... Warum wollten sie nicht mit dir sprechen?",shape=box,color=red];
		j3720102431 -> j3588055182;
	j3358054373 [label="Sie ist sehr nett ...",shape=box,color=red];
		j3358054373 -> j1052332160;
	j249472217 [label="Boolean LyonSerum1 is now true.",color=orange];
		j249472217 -> j428074109;
		j249472217 -> j4148499066;
		j249472217 -> j2341990430;
	j3485919622 [label="Unsere Brüder und Schwestern verbannten uns nicht auf die Straße oder verbrannten uns auf einem Scheiterhaufen. \"Cardinal Dimanche\" überzeugte sie, dass unsere Veränderung ... das Werk der Himmlischen war.",shape=box,color=blue];
		j3485919622 -> j232325412;
	j2324161527 [label="Roathe wir die Einzelheiten des \"wie\" kennen, aber nach ... vielen Jahren der Arbeit schuf er einen Helminth aus unseren Blutproben.",shape=box,color=blue];
		j2324161527 -> j336414095;
	j3588055182 [label="Wir sind uns schon begegnet, oder?",shape=box,color=blue];
		j3588055182 -> j460451704;
	j1052332160 [label="Eben.",shape=box,color=blue];
		j1052332160 -> j3827513041;
	j428074109 [label="Ich glaube, sie verehrt Entrati immer noch etwas zu sehr.",shape=box,color=red];
		j428074109 -> j4060173096;
	j4148499066 [label="Wie ging es weiter?",shape=box,color=red];
		j4148499066 -> j1256783417;
	j2341990430 [label="Bereust du es?",shape=box,color=red];
		j2341990430 -> j2163082390;
	j232325412 [label="Wir wurden in den Krypten versteckt und blieben außer Sicht. Unsere ehemaligen Brüder, auch wenn sie Angst vor uns hatten, versorgten uns mit Vorräten.",shape=box,color=blue];
		j232325412 -> j346918974;
	j336414095 [label="Ich glaube der Befall ist mit sich selbst irgendeine durch ... die Zeit verbunden, obwohl mir die Details ziemlich unklar sind.",shape=box,color=blue];
		j336414095 -> j1935675995;
		j336414095 -> j4289190885;
	j460451704 [label="Wie lange habt ihr dort unten festgesessen?",shape=box,color=red];
		j460451704 -> j2499825478;
	j3827513041 [label="Also ... habt ihr im Keller gelebt?",shape=box,color=red];
		j3827513041 -> j2696215860;
	j4060173096 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j4060173096 -> j1587518437;
	j1256783417 [label="Roathe erwachte. Zuerst konnte er sich kaum an seinen Namen erinnern. Entrati sagte noch einen Satz zu dem Bastard. \"Uriel, Ketzer von Xata, verbannt, antworte ... kann den Orokin jemals vergeben werden?\"",shape=box,color=blue];
		j1256783417 -> j2648531714;
	j2163082390 [label="Ich bereue alles, Drifter. Natürlich tue ich das. Aber würde ich es wieder tun? Natürlich würde ich das. Ich kann Marie nicht alleine lassen.",shape=box,color=blue];
		j2163082390 -> j2749507541;
	j346918974 [label="Sie ... bestanden darauf, nur mit Marie zu interagieren, trotz ihrer plötzlichen geisterhaften Erscheinungen, um sie auf der Treppe zu begrüßen.",shape=box,color=blue];
		j346918974 -> j4131034959;
		j346918974 -> j1752550301;
	j1935675995 [label="Er hat einen Helminth nachgebaut?! Wie lange hat das gedauert?!",shape=box,color=red];
		j1935675995 -> j3909850297;
	j4289190885 [label="Ich glaube nicht, dass es jemand versteht. Es ist eine neue Entdeckung.",shape=box,color=red];
		j4289190885 -> j2941447347;
	j2499825478 [label="Vielleicht solltest du mich nicht danach fragen, wie viele Jahre vergingen, nachdem wir in sprechende, befallene Mischwesen verwandelt wurden. Mein Zeitgefühl ist seit dem ziemlich ... verworren.",shape=box,color=blue];
		j2499825478 -> j1224895132;
		j2499825478 -> j3628771806;
	j2696215860 [label="Das klingt vielleicht härter, als es scheint. Sie konnten uns sonst nirgendwo unterbringen. Der Glockenturm war zu offen, zu sehr den Elementen ausgesetzt. Die Krypta war geschützt und warm.",shape=box,color=blue];
		j2696215860 -> j2609163362;
	j1587518437 [label="Darin sind wir uns einig. Aber ich kann es ihr nicht vorwerfen. Gib ihr Zeit. Sie wird es verstehen. Sie ist hochintelligent, Drifter. Behandele sie nicht wie einen Dummkopf.",shape=box,color=blue];
		j1587518437 -> j2749507541;
	j2648531714 [label="Dann verschwand Entrati endgültig. Und ließ Roathe bei uns zurück, gerade erst verwandelt in das, was du vor dir siehst ... besser fähig es mit dem launischen Teufel aufzunehmen.",shape=box,color=blue];
		j2648531714 -> j3860740576;
	j2749507541 [label="Um die Geschichte fortzusetzen ... dann verschwand Entrati endgültig. Und ließ Roathe bei uns zurück, gerade erst verwandelt in das, was du vor dir siehst ... besser fähig es mit dem launischen Teufel aufzunehmen.",shape=box,color=blue];
		j2749507541 -> j3860740576;
	j4131034959 [label="Ich verstehe, dass sie Roathe aus dem Weg gehen wollten, aber ... Warum wollten sie nicht mit dir sprechen?",shape=box,color=red];
		j4131034959 -> j1151348602;
	j1752550301 [label="Sie ist sehr nett ...",shape=box,color=red];
		j1752550301 -> j395411241;
	j3909850297 [label="Boolean LyonRoatheHelminth is now true.",color=orange];
		j3909850297 -> j2638201519;
	j2941447347 [label="Ich kann nicht sagen, ob dieses Wissen tröstlich oder beruhigend ist, danke auch. Es ist seltsam genug, jetzt zu wissen, dass der Befall sprechen kann.",shape=box,color=blue];
		j2941447347 -> j3923906766;
		j2941447347 -> j524693814;
	j1224895132 [label="Auf welche Weise verworren?\n",shape=box,color=red];
		j1224895132 -> j1252446844;
	j3628771806 [label="Ich bin mir nicht sicher, ob ich dir sagen sollte, dass der Befall auch sprechen kann ...",shape=box,color=red];
		j3628771806 -> j2944606280;
	j2609163362 [label="Und leider mussten wir feststellen, dass sie Ausgänge hatte, die Roathe nutzen konnte, um ... herumzuwandern.",shape=box,color=blue];
		j2609163362 -> j845860967;
	j1151348602 [label="Wir sind uns schon begegnet, oder?",shape=box,color=blue];
		j1151348602 -> j460451704;
		j1151348602 -> j3827513041;
	j395411241 [label="Eben.",shape=box,color=blue];
		j395411241 -> j3827513041;
		j395411241 -> j460451704;
	j2638201519 [label="Vielleicht bin ich nicht derjenige, den du fragen solltest. Mein Zeitgefühl ist seitdem, sehr ... verworren. Aber vielleicht wäre \"noch verworrener\" eher zutreffend. Als ob die Dinge nicht schon schrecklich genug wären ...",shape=box,color=blue];
		j2638201519 -> j1224895132;
		j2638201519 -> j3628771806;
	j3923906766 [label="Nicht alle Haushaltsgegenstände. Der Stuhl kann manchmal ... naja ... egal, bitte fahre fort.",shape=box,color=red];
		j3923906766 -> j2813416722;
	j524693814 [label="Ich erspare dir jetzt ein Gespräch über die Gitarre",shape=box,color=red];
		j524693814 -> j1792339292;
	j1252446844 [label="Boolean LyonTime1 is now true.",color=orange];
		j1252446844 -> j2890219176;
	j2944606280 [label="Glaub mir, das weiß ich. Und es ist beunruhigend, danke auch. Obwohl es so scheint, als könnte hier jeder Haushaltsgegenstand sprechen.",shape=box,color=blue];
		j2944606280 -> j3923906766;
		j2944606280 -> j524693814;
	j845860967 [label="Evaluate expressions",color=orange];
		j845860967 -> j1848449207 [label="MarieRoathePastry1",color=purple];
		j845860967 -> j1848449207 [label="RoatheMariePastry1",color=purple];
		j845860967 -> j432140076 [label="false",color=purple];
	j2813416722 [label="Wenn du jetzt \"besetzt\" sagen wolltest, auch das habe ich schon gesehen, Drifter. Der eine, der flüstern kann. Der in der Wand. Ich habe das Klopfen gehört ...",shape=box,color=blue];
		j2813416722 -> j2898720038;
	j1792339292 [label="Danke dafür. Obwohl ich es weitaus tröstlicher fände, ein Musikinstrument zu haben, das ein Halbgott ist, als ... was immer meinen Geist heimsucht und verdrängt. Ist es seltsam, dass ich ... seit er ...",shape=box,color=blue];
		j1792339292 -> j382437882;
	j2890219176 [label="Ich bin mir nicht sicher, ob das einfach an meiner einzigartigen Sensibilität liegt, an ... den Umständen meiner Entstehung oder ... ihm ...",shape=box,color=blue];
		j2890219176 -> j3412136364;
	j1848449207 [label="Ich habe davon gehört.",shape=box,color=red];
		j1848449207 -> j3765128981;
	j432140076 [label="Oh?",shape=box,color=red];
		j432140076 -> j2304160066;
	j2898720038 [label="Es gibt eine Stimme, die mich ruft, die ich nicht mein ganzes Leben lang noch gehört habe, die sich jedoch bis in meine Vergangenheit und weit in meine Zukunft erstreckt ...",shape=box,color=blue];
		j2898720038 -> j3960336765;
	j382437882 [label="Bitte?",shape=box,color=red];
		j382437882 -> j2898720038;
	j3412136364 [label="Und ich weiß, dass du mich für einen völlig Verrückten hältst, wenn ich dir sage, dass ich die Zeit nicht auf ... rein ... lineare Weise wahrnehme.",shape=box,color=blue];
		j3412136364 -> j1625398163;
		j3412136364 -> j1119539365;
	j3765128981 [label="Ich halte es für eine seiner wenigen positiven Eigenschaften. Nicht der Diebstahl, wohlgemerkt. Aber der Gedanke dahinter. Ich vermute, dass er illegal Waren besorgt hat, um Marie zu Gesprächen mit ihm zu provozieren.",shape=box,color=blue];
		j3765128981 -> j4049610693;
	j2304160066 [label="Es ist weder Fisch noch Fleisch.",shape=box,color=blue];
		j2304160066 -> j2099366694;
		j2304160066 -> j689727486;
	j3960336765 [label="Es ist unmöglich, dass sie schon immer da war. Und doch kann ich mich gut daran erinnern, wie an das silberne Licht von Lua selbst, hinter den Mauern meines Elternhauses. Die Stimme eines jungen Mannes ... \"Rapp tapp tapp ...\"",shape=box,color=blue];
		j3960336765 -> j1789039668;
	j1625398163 [label="\"Ihm?\" Wer ist \"ihm\"?",shape=box,color=red];
		j1625398163 -> j2898720038;
	j1119539365 [label="Ich habe die Zeit über unzählige Jahrhunderte in sich windenden Spiralen wahrgenommen, Lyon.",shape=box,color=red];
		j1119539365 -> j3603375525;
	j4049610693 [label="Und vielleicht, weil es sie zum Lächeln brachte, wenn sie dachte, er würde nicht hinsehen. Einmal hat er mir gesagt \"es ist eine große Ungerechtigkeit des Schicksals, wie sehr ihr ein Leben vorenthalten wurde\".",shape=box,color=blue];
		j4049610693 -> j3733610902;
	j2099366694 [label="Wie lange habt ihr alle gebraucht, um zurück nach ... naja, jetzt zu kommen?",shape=box,color=red];
		j2099366694 -> j3305148833;
	j689727486 [label="Wie ging es weiter?",shape=box,color=red];
		j689727486 -> j2324161527;
	j1789039668 [label="Ich ... vergib mir. Ich muss gehen. Ich kann darüber noch nicht sprechen. Ich bin ... es tut mir leid. Bitte frag mich nicht mehr danach.",shape=box,color=blue];
		j1789039668 -> j2260091065;
	j3603375525 [label="Was sagst du, wenn ich von einer Stimme spreche, die mich über meinen eigenen rationalen Verstand hinaus geleitet hat? Ich weiß, dass ich sie nicht mein ganzes Leben lang gehört habe. Es ist unmöglich, dass sie schon immer da war.",shape=box,color=blue];
		j3603375525 -> j2839471025;
	j3733610902 [label="Boolean LyonRoathePastry is now true.",color=orange];
		j3733610902 -> j428314518;
		j3733610902 -> j2099366694;
	j3305148833 [label="Vielleicht solltest du mich nicht danach fragen, wie viele Jahre vergingen, nachdem wir in sprechende, befallene Mischwesen verwandelt wurden. Mein Zeitgefühl ist seit dem ziemlich ... verworren.",shape=box,color=blue];
		j3305148833 -> j3628771806;
		j3305148833 -> j1224895132;
	j2260091065 [label="Lyon, warte!",shape=box,color=red];
		j2260091065 -> j777162605;
	j2839471025 [label="Und doch kann ich mich gut daran erinnern, wie an das silberne Licht von Lua selbst, hinter den Mauern meines Elternhauses. Die Stimme eines jungen Mannes ... \"Rapp tapp tapp ...\"",shape=box,color=blue];
		j2839471025 -> j1789039668;
	j428314518 [label="Du hast recht, dass ist für ihn schon fast liebenswert. Was ist als nächstes passiert?",shape=box,color=red];
		j428314518 -> j2324161527;
	j777162605 [label="Boolean LyonRell1 is now true.",color=orange];
		j777162605 -> j367054140;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
}