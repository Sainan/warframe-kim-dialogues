		j3431306498 -> j3199340165;
	j1245269911 [label="Also, was du sagst ist ... es gibt eine Chance?",shape=box,color=red];
		j1245269911 -> j4076422969;
	j3199340165 [label="+20 Chemistry",color=orange];
		j3199340165 -> j2015198176;
	j4076422969 [label="+20 Chemistry",color=orange];
		j4076422969 -> j2124336650;
	j2015198176 [label="Nun ... Sollte ich entscheiden, dass ich dich nicht verabscheue, wenn wir diesen Punkt erreichen, werden wir diese Diskussion vielleicht wieder aufnehmen.",shape=box,color=blue];
		j2015198176 -> j1315750703;
	j2124336650 [label="Ja, vielleicht. Sollte ich entscheiden, dass ich dich nicht verabscheue, wenn wir diesen Punkt erreichen. Und das wird sich erst noch herausstellen, Drifter.",shape=box,color=blue];
		j2124336650 -> j1315750703;
