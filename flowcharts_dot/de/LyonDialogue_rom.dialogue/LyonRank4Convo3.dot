	j3181721155 [label="Wie kommst du mit den Cavia zurecht?",shape=box,color=red];
		j3181721155 -> j3740438882;
	j2778153037 [label="Was hältst du von Loid?",shape=box,color=red];
		j2778153037 -> j2212628654;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j3740438882 [label="Ich höre ihrem Geplänkel sehr gerne zu, obwohl ich natürlich nicht daran teilnehme. Ich kann zu ihrem Gespräch nur sehr wenig beitragen.",shape=box,color=blue];
		j3740438882 -> j846606898;
	j2212628654 [label="Ich finde ihn überaus angenehm. Tatsächlich, von meinen neuen ... Weggefährten ist er derjenige, zu dessen Gesellschaft ich mich am meisten hingezogen fühle.",shape=box,color=blue];
		j2212628654 -> j1989531271;
	"Chat ends." [color=orange];
	j846606898 [label="Es beunruhigt mich jedoch, wenn ich sehe, dass Roathe bei Vogel 3 steht und sich lange mit ihm unterhält. Ich weiß nicht, was er damit bezwecken will.",shape=box,color=blue];
		j846606898 -> j2507757158;
	j1989531271 [label="Obwohl das wohl niemanden wirklich überrascht, denke ich. Auf den ersten Blick sind wir uns sehr ähnlich.",shape=box,color=blue];
		j1989531271 -> j505570674;
	j2507757158 [label="Boolean LyonRoatheCavia1 is now true.",color=orange];
		j2507757158 -> j4283439305;
		j2507757158 -> j2706911821;
	j505570674 [label="Es ist der junge Operator, den ich seltsamer finde ... und die, die man Lotus nennt. Und wie wir man uns ihnen gegenüber auf Distanz hält.",shape=box,color=blue];
		j505570674 -> j3908504917;
	j4283439305 [label="Hm, ich werde ihn danach fragen.",shape=box,color=red];
		j4283439305 -> j1057098469;
	j2706911821 [label="Warum glaubst du, er führt etwas im Schilde?",shape=box,color=red];
		j2706911821 -> j3779580079;
	j3908504917 [label="Wir dürfen interagieren, natürlich. Aber nicht wie hier. Warum ist das so?",shape=box,color=blue];
		j3908504917 -> j230761243;
		j3908504917 -> j168724460;
	j1057098469 [label="Das wäre vielleicht klug. Ich würde es bedauern, wenn er diese Kreaturen wie Objekte manipulieren würde, mehr, als sie es ohnehin schon wurden.",shape=box,color=blue];
		j1057098469 -> j505570674;
	j3779580079 [label="Roathe hat immer ein Ziel vor Augen, wenn er sich mit jemandem unterhält. Ich würde es bedauern, wenn er diese Kreaturen wie Objekte manipulieren würde, mehr, als sie es ohnehin schon wurden.",shape=box,color=blue];
		j3779580079 -> j2896643185;
	j230761243 [label="Das Kind ... hat seine eigenen Probleme. Wir können ihm nicht noch mehr zumuten. Das wäre nicht richtig.",shape=box,color=red];
		j230761243 -> j3829363180;
	j168724460 [label="Vermutlich ... weil ich bereits Erfahrung mit Protoframes habe, nehme ich an?",shape=box,color=red];
		j168724460 -> j3260070664;
	j2896643185 [label="Es wäre gut, dem nachzugehen, wenn du Zeit hast. Aber das liegt letztlich ganz bei dir.",shape=box,color=blue];
		j2896643185 -> j505570674;
	j3829363180 [label="Ja. Ich habe Gerüchte darüber gehört, was es ertragen musste. Geschichten von Kriegen und ... Freundschaften, die auseinandergerissen wurden.",shape=box,color=blue];
		j3829363180 -> j2082179870;
	j3260070664 [label="Check boolean IsDating",color=orange];
		j3260070664 -> j2323293968 [label=true,color=green];
		j3260070664 -> j3968353750 [label=false,color=brown];
	j2082179870 [label="Es bricht mir das Herz, was alles durch Krieg zerstört wird. Noch seltsamer ist, was dadurch entstehen kann.",shape=box,color=blue];
		j2082179870 -> j3968353750;
	j2323293968 [label="Hm. Nennt man das so? \"Bereits Erfahrung haben?\" Wie geschmackvoll. Während Entrati ein ziemliches Durcheinander angerichtet hat, bin ich froh, dass du ... einen Weg gefunden hast, dich zu amüsieren.",shape=box,color=blue];
		j2323293968 -> j1635481636;
		j2323293968 -> j4217207308;
		j2323293968 -> j3732140981;
	j3968353750 [label="M. Loid hat mir von deinem \"Missgeschick\" in Höllvania in der Vergangenheit erzählt, in unserer Zukunft. Entrati hat ein ziemliches Durcheinander angerichtet.",shape=box,color=blue];
		j3968353750 -> j2434538568;
		j3968353750 -> j3779820582;
	j1635481636 [label="Habe ich etwas falsch gemacht?",shape=box,color=red];
		j1635481636 -> j3487893497;
	j4217207308 [label="Vorsicht oder ich könnte glauben du fragst dich, ob das Gras auf der anderen Seite des Zauns nicht doch etwas grüner ist, Priester.",shape=box,color=red];
		j4217207308 -> j619519124;
	j3732140981 [label="Bei dir klingt es nach einem kurzen Flirt, Lyon. Bitte beleidige mich nicht so.",shape=box,color=red];
		j3732140981 -> j1331458418;
	j2434538568 [label="Es hätte wesentlich schlimmer sein können, glaub mir.",shape=box,color=red];
		j2434538568 -> j380555466;
	j3779820582 [label="Diese Protoframes sind gute Freunde von mir. Sie sind für mich zur Familie geworden",shape=box,color=red];
		j3779820582 -> j3874713186;
	j3487893497 [label="Check boolean LyonFirstFlirt",color=orange];
		j3487893497 -> j2494320887 [label=true,color=green];
		j3487893497 -> j301940714 [label=false,color=brown];
	j619519124 [label="Check boolean LyonFirstFlirt",color=orange];
		j619519124 -> j2494320887 [label=true,color=green];
		j619519124 -> j142195936 [label=false,color=brown];
	j1331458418 [label="Check boolean LyonFirstFlirt",color=orange];
		j1331458418 -> j2494320887 [label=true,color=green];
		j1331458418 -> j1354831476 [label=false,color=brown];
	j380555466 [label="Und ich bin mir sicher, dies war alles Teil von Entratis meisterhaftem Plan. Das Schicksal der Zukunft dir und einer Bande von Außenseitern zu überlassen.",shape=box,color=blue];
		j380555466 -> j997608192;
	j3874713186 [label="Meine Großeltern lernten sich während der Gaullischen Revolution kennen. Krieg und Tod waren schon immer auf die seltsamste Weise in Kameradschaft verbunden.",shape=box,color=blue];
		j3874713186 -> j3628502303;
	j2494320887 [label="Vergib mir. Als wir das letzte Mal etwas besprochen haben, schienst du ...",shape=box,color=blue];
		j2494320887 -> j3695484215;
	j301940714 [label="Vergib mir. Ich kenne weder dein Herz, noch das von anderen. Was du in deiner Freizeit mit anderen machst, ist alleine deine Sache.",shape=box,color=blue];
		j301940714 -> j1289634818;
		j301940714 -> j3867852622;
	j142195936 [label="Vergib mir. Nein, du hast Recht. Ich möchte nicht eifersüchtig klingen oder als würde ich mich selbst als Provokateur aufspielen. Was du in deiner Freizeit mit anderen machst, ist alleine deine Sache.",shape=box,color=blue];
		j142195936 -> j1289634818;
		j142195936 -> j3867852622;
	j1354831476 [label="Natürlich. Vergib mir. Ich kenne weder dein Herz, noch das von anderen. Was du in deiner Freizeit mit anderen machst, ist alleine deine Sache.",shape=box,color=blue];
		j1354831476 -> j1289634818;
		j1354831476 -> j3867852622;
	j997608192 [label="Ich ... Drifster, ich weiß, ich bin nicht ... der umgänglichste Mensch, mit dem du notgedrungen interagieren musst und dafür entschuldige ich mich weiterhin.",shape=box,color=blue];
		j997608192 -> j2153426372;
	j3628502303 [label="Boolean LyonBackstory2 is now true.",color=orange];
		j3628502303 -> j2771411313;
		j3628502303 -> j149436098;
	j3695484215 [label="Vergiss es ... Ich sollte nicht überrascht sein, dass Herzen wankelmütig und unberechenbar sind. Vor allem, wenn es mich betrifft.",shape=box,color=blue];
		j3695484215 -> j3212055550;
		j3695484215 -> j3502751652;
	j1289634818 [label="Wir haben ... einiges zusammen durchgemacht. Sowas schweißt Menschen zusammen.",shape=box,color=red];
		j1289634818 -> j1374991379;
	j3867852622 [label="[Gefühle gestehen.] Ganz ehrlich, ich habe ohnehin überlegt, wie ich dieses Thema irgendwann bei dir ansprechen könnte.",shape=box,color=red];
		j3867852622 -> j182903581;
	j2153426372 [label="So bin ich nun mal und ich weiß nicht, wie ich das ändern sollte. Tatsächlich glaube ich nicht, dass ich den Schaden an meiner Seele, der mir von den Verdammten, die mich heimsuchen, zugefügt wurde, rückgängig machen kann.",shape=box,color=blue];
		j2153426372 -> j4232603656;
	j2771411313 [label="Das scheint wirklich so zu sein, es zieht sich durch die Geschichte.",shape=box,color=red];
		j2771411313 -> j396088765;
	j149436098 [label="Ich würde gerne mehr über deine Familie erfahren.",shape=box,color=red];
		j149436098 -> j1613115481;
	j3212055550 [label="Warte. Du bekommst einen falschen Eindruck. Ich habe dich nicht in die Irre geführt. Die Dinge sind nur ... naja, kompliziert.",shape=box,color=red];
		j3212055550 -> j1252291096;
	j3502751652 [label="Ich dachte mir, dass du an mir kein Interesse hast.",shape=box,color=red];
		j3502751652 -> j2590377894;
	j1374991379 [label="Meine Großeltern lernten sich während der Gaullischen Revolution kennen. Krieg und Tod waren schon immer auf die seltsamste Weise durch Liebe und Leidenschaft verbunden.",shape=box,color=blue];
		j1374991379 -> j3628502303;
	j182903581 [label="Und jetzt bin ich furchtbar nervös ... darf ich fragen, warum?",shape=box,color=blue];
		j182903581 -> j157410678;
		j182903581 -> j388672655;
	j4232603656 [label="Was sich unter der Oberfläche aus zerbrechendem Glas verbirgt, ist ...",shape=box,color=blue];
		j4232603656 -> j4288047837;
		j4232603656 -> j224847198;
	j396088765 [label="In der Tat. Ich nehme an, ich sollte nichts Positives ablehnen, was aus der Dunkelheit und der Zerstörung des Krieges entsteht.",shape=box,color=blue];
		j396088765 -> j3795364530;
		j396088765 -> j342240722;
	j1613115481 [label="Es ist keine Geschichte, die ich gern erzähle. Niemandem. Deshalb wirst du mir verzeihen, wenn ich nicht gerade begeistert bin, sie mit dir zu teilen. Vielleicht ein anderes Mal.",shape=box,color=blue];
		j1613115481 -> j3720224511;
		j1613115481 -> j3626545034;
	j1252291096 [label="Sprich weiter.",shape=box,color=blue];
		j1252291096 -> j157410678;
		j1252291096 -> j388672655;
	j2590377894 [label="Bei allem Respekt, ich kenne dich nicht. Und bei allem, was sonst noch in meinem Leben vor sich geht, ist eine romantische Beziehung mit einem Fremden kaum meine oberste Priorität.",shape=box,color=blue];
		j2590377894 -> j2579211651;
	j157410678 [label="Ich ... wir versuchen es ein anderes Mal erneut, es tut mir leid.",shape=box,color=red];
		j157410678 -> j2620255860;
	j388672655 [label="Ich weiß nicht, ob dies einfach zu begreifen ist oder ob es einfach verrückt klingt, aber ... für mich, ich ... kann für mehr als eine Person gleichzeitig starke Zuneigung empfinden.",shape=box,color=red];
		j388672655 -> j1763209858;
	j4288047837 [label="Ist schon gut, Lyon. Das wird schon. Ich habe keine Eile, glaub mir.",shape=box,color=red];
		j4288047837 -> j1724165061;
	j224847198 [label="Ist was?",shape=box,color=red];
		j224847198 -> j2887301697;
	j3795364530 [label="Wie meinst du das?",shape=box,color=red];
		j3795364530 -> j4155268809;
	j342240722 [label="Du lehnst es ab?",shape=box,color=red];
		j342240722 -> j4288466359;
	j3720224511 [label="Ich werde hier sein.",shape=box,color=red];
		j3720224511 -> j3845241604;
	j3626545034 [label="Natürlich. Wann immer du bereit bist, Lyon.",shape=box,color=red];
		j3626545034 -> j3734851004;
	j2579211651 [label="Ich bin sicher, es gibt andere, die in solchen Situationen Trost in den Armen eines anderen finden würden, aber ich gehöre nicht zu diesen Glücklichen.",shape=box,color=blue];
		j2579211651 -> j2038668938;
	j2620255860 [label="+20 Chemistry",color=orange];
		j2620255860 -> j3654652991;
	j1763209858 [label="Ich habe Gefühle für dich. Aber ich habe auch Gefühle für sie. Und für mich, ist beides wahr.",shape=box,color=red];
		j1763209858 -> j2099038378;
	j1724165061 [label="+20 Chemistry",color=orange];
		j1724165061 -> j3597598660;
	j2887301697 [label="+10 Chemistry",color=orange];
		j2887301697 -> j865944854;
	j4155268809 [label="Vergib mir. Es ist keine Geschichte, die ich gern erzähle. Niemandem. Deshalb wirst du mir verzeihen, wenn ich nicht gerade begeistert bin, sie mit dir zu teilen. Vielleicht ein anderes Mal.",shape=box,color=blue];
		j4155268809 -> j3720224511;
		j4155268809 -> j3626545034;
	j4288466359 [label="Nicht das Vorhandensein von Liebe, aber vielleicht, dass sie in meiner eigenen Familie fehlte. Vergib mir. Es ist keine Geschichte, die ich gern erzähle. Niemandem. Deshalb wirst du mir verzeihen, wenn ich nicht gerade begeistert bin, sie mit dir zu teilen. Vielleicht ein anderes Mal.",shape=box,color=blue];
		j4288466359 -> j3720224511;
		j4288466359 -> j3626545034;
	j3845241604 [label="+15 Chemistry",color=orange];
		j3845241604 -> j3700048992;
	j3734851004 [label="+20 Chemistry",color=orange];
		j3734851004 -> j633347589;
	j2038668938 [label="Sei so gut und wende dich stattdessen an jemand anderen. Bis dann.",shape=box,color=blue];
		j2038668938 -> j1599833162;
	j3654652991 [label="Gut. Sprechen wir ein anderes Mal darüber, wenn du möchtest. Bis dahin kehre ich zu meinen Tagespflichten zurück.",shape=box,color=blue];
		j3654652991 -> j1599833162;
	j2099038378 [label="Ein solches Konzept ist mir nicht so fremd, wie du vielleicht glaubst. Es ist auch nicht die Vorstellung an sich, sondern mehr die beteiligten Personen ... nichts für ungut.",shape=box,color=blue];
		j2099038378 -> j1865329778;
	j3597598660 [label="Boolean LyonVisions3 is now true.",color=orange];
		j3597598660 -> j3092369250;
	j865944854 [label="Für die meisten ist es zuviel. Und danke, dass du es weiterhin versuchst. Das ist alles.",shape=box,color=blue];
		j865944854 -> j1599833162;
	j3700048992 [label="Ich komme langsam zu dieser unausweichlichen Überzeugung, ja. Mach es gut.",shape=box,color=blue];
		j3700048992 -> j1599833162;
	j633347589 [label="Danke. Bis wir uns wieder sprechen, wünsche ich dir einen guten Tag.",shape=box,color=blue];
		j633347589 -> j1599833162;
	j1599833162 [label="-Pater Lyon Allard",shape=box,color=blue];
		j1599833162 -> "Chat ends.";
	j1865329778 [label="Und vielleicht auch, wie nah an unserem neuen \"Zuhause\" sich das alles abspielt.",shape=box,color=blue];
		j1865329778 -> j3431306498;
		j1865329778 -> j1245269911;
	j3092369250 [label="Danke ...",shape=box,color=blue];
		j3092369250 -> j1599833162;
