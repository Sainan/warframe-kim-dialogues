		j1774407233 -> j2871216685;
	j1235475038 [label="Du hast ihm eine gewisse Sicherheit gegeben. Eine Aufgabe. Und dafür könnte ich nicht dankbar sein. Und ich weiß, dass dies auch für Marie gilt.",shape=box,color=blue];
		j1235475038 -> j1273061235;
