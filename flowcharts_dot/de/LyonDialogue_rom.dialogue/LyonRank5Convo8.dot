	j485397676 [label="Die Dinge in dieser falschen Gruft haben sich sehr verbessert,  muss ich sagen. Vielleicht ist das auch nur meine Sicht der Dinge. Ich bin ... abgelenkt in letzter Zeit.",shape=box,color=blue];
		j485397676 -> j1890799654;
