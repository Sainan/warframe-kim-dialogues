	j2805890735 [label="Du hast ihm eine gewisse Sicherheit gegeben. Eine Aufgabe. Und dafür könnte ich nicht dankbar sein. Und ich weiß, dass dies auch für Marie gilt.",shape=box,color=blue];
		j2805890735 -> j4208404973;
