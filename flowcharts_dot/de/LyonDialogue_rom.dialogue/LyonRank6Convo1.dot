	2194 [label="Ich werde in stillem Gebet verweilen und dem Gott danken, der dich zu uns geführt hat, für deine Geduld und Freundlichkeit, mir so lange zuzuhören.",shape=box,color=blue];
		2194 -> 2197;
	2193 [label="Ich werde in stillem Gebet verweilen und dem Gott danken, der dich zu uns geführt hat, für deine Geduld und Freundlichkeit, mir so lange zuzuhören.",shape=box,color=blue];
		2193 -> 2196;
	2192 [label="Dass ich dir so viel von meinem Schmerz erzählen konnte und du es ertragen hast? Und nichts im Gegenzug von mir verlangt hast ... Mein Dank ist im Vergleich dazu gering.",shape=box,color=blue];
		2192 -> 2195;
	2191 [label="Ich weiß, dass das, was ich geworden bin, das, was ich immer war, für andere nicht so leicht zu ertragen ist.",shape=box,color=blue];
		2191 -> 2195;
	2197 [label="Dass ich dir so unbedacht die Wahrheit meiner Seele anvertrauen konnte und du sie mit offenen Herzen ertragen hast.",shape=box,color=blue];
		2197 -> 2198;
	2196 [label="Dass ich dir so unbedacht die Wahrheit meiner Seele anvertrauen konnte und du sie mit offenen Armen ertragen hast.",shape=box,color=blue];
		2196 -> 2198;
	2195 [label="Und für all die Geduld, die du mir entgegengebracht hast, bin ich dir sehr dankbar.",shape=box,color=blue];
