	2199 [label="Mon miracle, ich werde vor deinem Altar knien, als ergebenster und treuerster Diener und Soldat.",shape=box,color=blue];
		2199 -> 2203;
	2200 [label="Mein Freund, ich werde an deiner Seite kämpfen, komme, was wolle. Wie könnte ich dich nicht beschützen, der du das Herz meiner Schwester erobert hast?",shape=box,color=blue];
		2200 -> 2204;
	2201 [label="Mein Freund, ich werde an deiner Seite kämpfen, komme, was wolle. Wie könnte ich dich nicht beschützen, der es geschafft hat, selbst den Teufel zu bezwingen?",shape=box,color=blue];
		2201 -> 2204;
	2202 [label="Mein Freund, ich werde an deiner Seite kämpfen, was auch immer geschehen mag.",shape=box,color=blue];
