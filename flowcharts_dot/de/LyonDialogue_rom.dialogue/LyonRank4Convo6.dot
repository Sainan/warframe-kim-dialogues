	2232 [label="+20 Chemistry",color=orange];
		2232 -> 2231;
	1186 [label="Lyon, ich habe mit Marie über deine ... Gewohnheiten gesprochen und ich habe mich gefragt, ob wir reden können?",shape=box,color=red];
		1186 -> 1192;
	1183 [label="[Deaktiviere alle Gespräche über Selbstverletzung. Du verlierst dadurch keine Chemiepunkte mit Lyon oder mit den Charakteren.]",shape=box,color=red];
		1183 -> 1189;
	1182 [label="[Ende.]",shape=box,color=red];
		1182 -> 1188;
	1185 [label="Lyon? Können wir über etwas sprechen ... was dir etwas unangenehm sein könnte?",shape=box,color=red];
		1185 -> 1191;
	1184 [label="Lyon, ich wollte fragen, ob wir uns darüber unterhalten können, warum ... naja, du dich selbst verletzt, wenn das in Ordnung ist?",shape=box,color=red];
		1184 -> 1190;
	2231 [label="[Konversation wurde aufgrund von zuvor aktivierter Triggerwarnung übersprungen.]",shape=box,color=blue];
		2231 -> 1057;
	1192 [label="Sie hat mir gesagt, dass ihr euch unterhalten habt, ja, natürlich. Es mag dich überraschen, wie wenig es mir ausmacht, über diese besondere Eigenschaft von mir zu sprechen.",shape=box,color=blue];
		1192 -> 1197;
	1189 [label="Update boolean LyonPainOff",color=orange];
		1189 -> 1194;
	1188 [label="Chat ends.",color=orange];
	1191 [label="Du kannst fragen, aber ich behalte mir das Recht vor, das Gespräch nicht weiterzuführen, wenn ich das Gefühl habe, dass es in einen Bereich vordringt, den ich nicht wieder zu diskutieren gedenke.",shape=box,color=blue];
		1191 -> 1196;
	1190 [label="Hm. Ich bin ehrlich überrascht, dass es so lang gedauert hat, bis du nach dieser besonderen Eigenschaft von mir fragst. Die meisten kommentieren diese Tatsache bereitwillig.",shape=box,color=blue];
		1190 -> 1195;
	1057 [label="Chat ends.",color=orange];
	1197 [label="Für gewöhnlich ist es das, worüber am ehesten gesprochen wird. Entweder aus Sorge, aus Abscheu oder morbider Neugier.",shape=box,color=blue];
		1197 -> 1204;
	1194 [label="Solltest du dich wegen dieser Entscheidung als Feigling betrachten, bitte tue das nicht. Dies ist ein Schmerz, dem du dich nicht zu stellen brauchst. Sondern ich. Du hast nicht darum gebeten, diesen Moment ertragen zu müssen.",shape=box,color=blue];
		1194 -> 1198;
	1196 [label="Es geht um die Tatsache, dass du dich manchmal selbst verletzt. Ich wollte nur vorsichtig sein, wie ich das Thema bei dir anspreche.",shape=box,color=red];
		1196 -> 1203;
	1195 [label="Entweder aus Sorge, Abscheu oder morbiden Neugier spähen die meisten in den Käfig des Verrückten. Ich frage mich, was auf dich zutrifft?",shape=box,color=blue];
		1195 -> 1199;
		1195 -> 1200;
		1195 -> 1201;
		1195 -> 1202;
	1204 [label="Evaluate expressions",color=orange];
		1204 -> 1199 [label="LyonBackstory3a",color=purple];
		1204 -> 1210 [label="LyonBackstory3a",color=purple];
		1204 -> 1199 [label="LyonBackstory3b",color=purple];
		1204 -> 1210 [label="LyonBackstory3b",color=purple];
		1204 -> 1199 [label="DrifterHarmHelp",color=purple];
		1204 -> 1201 [label="DrifterHarmHelp",color=purple];
		1204 -> 1199 [label="DrifterHarmStop",color=purple];
		1204 -> 1202 [label="DrifterHarmStop",color=purple];
		1204 -> 1199 [label="DrifterHarmLoss",color=purple];
		1204 -> 1200 [label="DrifterHarmLoss",color=purple];
		1204 -> 1199 [label="false",color=purple];
	1198 [label="Diese mechanische Vorrichtung, vor der wir sitzen, erweckt den Eindruck von verschleierter Unpersönlichkeit. Dass wir irgendwie vor jeglichem Schaden geschützt sind, den ein anderer uns durch seine getippten Worte zufügen könnte.",shape=box,color=blue];
		1198 -> 1205;
	1203 [label="+5 Chemistry",color=orange];
		1203 -> 1209;
	1199 [label="Es tut mir leid, wenn ich darüber nachdenke, ich kann das hier nicht. [Ende.]",shape=box,color=red];
		1199 -> 1194;
	1200 [label="[Warnung: Thema Suizid.] Ich habe selbst jemanden durch die \"Gewohnheit\" verloren und ich ...",shape=box,color=red];
		1200 -> 1206;
	1201 [label="Ich möchte dir nur helfen. Nur um sicherzugehen, dass alles in Ordnung ist.",shape=box,color=red];
		1201 -> 1207;
	1202 [label="Ich habe nur das Gefühl, dass es nicht gesund ist, dass dies etwas ist, was aufhören sollte.",shape=box,color=red];
		1202 -> 1208;
	1210 [label="Ich weiß, dass du gesagt hast, du hättest dich selbst verletzt vor dem Serum, aber ... ich kann mir nicht vorstellen, dass es besser geworden ist.",shape=box,color=red];
		1210 -> 1215;
	1205 [label="Ich würde eher das Gegenteil behaupten, dass wir ohne den Schutz, den wir in alltäglicheren sozialen Begegnungen anlegen, auch dessen beraubt sind, was uns hier schützen könnte.",shape=box,color=blue];
		1205 -> 1211;
	1209 [label="Ich ... schätze das Feingefühl, mit dem du dieses Thema angehst, Drifter. Danke. Aber ich bin daran gewöhnt, dass dies Gegenstand von Gesprächen ist. Entweder aus Sorge, Abscheu oder morbider Neugier, aber ich denke, du hast bereits bewiesen, dass es Ersteres ist.",shape=box,color=blue];
		1209 -> 1199;
		1209 -> 1200;
		1209 -> 1201;
		1209 -> 1202;
	1206 [label="Update boolean DrifterHarmLoss",color=orange];
		1206 -> 1212;
	1207 [label="Update boolean DrifterHarmHelp",color=orange];
		1207 -> 1213;
	1208 [label="Update boolean DrifterHarmStop",color=orange];
		1208 -> 1214;
	1215 [label="Nein, ist es nicht. Es hat etwas genommen, was ... notwendig war, um meinen Geist von den Visionen zu befreien, die mich geplagt haben und hat es in die Notwendigkeit verwandelt, die \"Gaben\" des Serums zu nutzen.",shape=box,color=blue];
		1215 -> 1221;
	1211 [label="Daher bin ich mir in Situationen wie dieser durchaus bewusst, dass ein Pfeil, den ich abschieße, vielleicht nicht einen kampfbereiten Soldaten vorfindet, sondern die ungeschützte Halsschlagader eines Rehs im Wald.",shape=box,color=blue];
		1211 -> 1216;
	1212 [label="Ach, mein Freund ... es gibt keine Worte, die ich hier niederschreiben könnte, die angemessen ausdrücken könnten, wie leid es mir tut, was du durchgemacht hast.",shape=box,color=blue];
		1212 -> 1217;
	1213 [label="Check boolean LyonAllRight",color=orange];
		1213 -> 1219 [label=true,color=green];
		1213 -> 1218 [label=false,color=brown];
	1214 [label="Ich glaube, du bist diverse Jahre und ein Protoframe-Serum zu spät, um diesem speziellen Zwang von mir ein Ende zu setzen, in der Tat denke ich, dass es inzwischen eine notwendige Handlung ist.",shape=box,color=blue];
		1214 -> 1220;
	1221 [label="+5 Chemistry",color=orange];
		1221 -> 1226;
	1216 [label="Daher möchte ich dich hiermit zurücklassen:",shape=box,color=blue];
		1216 -> 1222;
	1217 [label="In solchen Momenten erscheint Sprache armselig. Wir bemühen uns, sie so gut wie möglich einzusetzen, doch sie scheint uns immer im Stich zu lassen.",shape=box,color=blue];
		1217 -> 1223;
	1219 [label="Ich versuche erneut bei der Vorstellung, dass ich jemals in die Nähe von \"in Ordnung\" kommen könnte, nicht zu lachen. Aber ich weiß die Geste sehr zu schätzen, Drifter.",shape=box,color=blue];
		1219 -> 1224;
	1218 [label="Ich versuche bei der Vorstellung, dass ich jemals in die Nähe von \"in Ordnung\" kommen könnte, nicht zu lachen. Aber ich weiß die Geste sehr zu schätzen, Drifter.",shape=box,color=blue];
		1218 -> 1224;
	1220 [label="+5 Chemistry",color=orange];
		1220 -> 1225;
	1226 [label="Wenn die Möglichkeit, mich von dem Zwang zur Selbstverletzung befreien zu können, gegeben gewesen wäre, bevor ich mir das Serum gespritzt habe, hat die Verbindung mit dem Warframe \"Harrow\" dies nun unmöglich gemacht.",shape=box,color=blue];
		1226 -> 1231;
	1222 [label="Wir müssen uns daran erinnern, die Kraft zu finden, einem anderen aufzuhelfen, auch wenn wir selbst nicht die Kraft haben, zu stehen.",shape=box,color=blue];
		1222 -> 1227;
	1223 [label="Es gibt drei Dinge, die ich tun könnte, wenn du es mir erlaubst, angesichts deines Geständnisses.",shape=box,color=blue];
		1223 -> 1228;
	1224 [label="+5 Chemistry",color=orange];
		1224 -> 1229;
		1224 -> 1230;
	1225 [label="Aber ich möchte nicht so leichtfertig über etwas sprechen, das meiner Meinung nach Ausdruck der Sorge um mein körperliches und seelisches Wohlbefinden ist, bitte verzeih mir. Ich glaube einfach nicht, dass es in meiner Macht steht, damit aufzuhören.",shape=box,color=blue];
		1225 -> 1229;
		1225 -> 1230;
	1231 [label="Wenn ich ganz direkt sein darf, Drifter, ich glaube nicht, dass ich mir noch länger auf diese Weise wirklich dauerhaften Schaden zufügen kann.",shape=box,color=blue];
		1231 -> 1235;
	1227 [label="Das ist der wahre Zweck von Geschichten.",shape=box,color=blue];
		1227 -> 1232;
	1228 [label="Erstens möchte ich dir versichern, dass ich mich nicht in Gefahr befinde. Wenn du glaubst, dass ein tiefsitzender, schrecklicher Selbsthass mich dazu treibt, mir selbst Schaden zuzufügen, möchte ich diese Befürchtungen gerne ausräumen.",shape=box,color=blue];
		1228 -> 1233;
	1229 [label="Darf ich fragen, warum du es machst?",shape=box,color=red];
		1229 -> 1234;
	1230 [label="Ich mach mir nur Sorgen, dass du zuweit gehen könntest.",shape=box,color=red];
		1230 -> 1231;
	1235 [label="Während ich nicht dazu fähig bin, mich für unverwundbar zu halten, scheint eine solche Handlung ... sagen wir mal ... Teil des Plans zu sein.",shape=box,color=blue];
		1235 -> 1241;
	1232 [label="+20 Chemistry",color=orange];
		1232 -> 1236;
	1233 [label="Während ich ... durchaus melancholisch sein kann, ist es nicht das, was mich dazu bringt ein Weihrauchfass zu benutzen. (Marie würde es nie erlauben. Sie würde mir eher eins um die Ohren hauen, bevor sie je wieder in die Nähe davon lassen würde.)",shape=box,color=blue];
		1233 -> 1237;
	1234 [label="Evaluate expressions",color=orange];
		1234 -> 1240 [label="LyonBackstory3a, LyonLecture2",color=purple];
		1234 -> 1240 [label="LyonBackstory3b, LyonLecture2",color=purple];
		1234 -> 1239 [label="LyonBackstory3a",color=purple];
		1234 -> 1239 [label="LyonBackstory3b",color=purple];
		1234 -> 1238 [label="false",color=purple];
	1241 [label="+5 Chemistry",color=orange];
		1241 -> 1246;
	1236 [label="Lass es dir gut gehen, Drifter. Wir sprechen uns bald wieder.",shape=box,color=blue];
		1236 -> 1242;
	1237 [label="Aber solch tiefe Schmerzen flüstern mir des nächtens nichts ein, mein Freund. Das kann ich dir versprechen. Ich schwöre es, bei allem, was mir lieb und teuer ist.",shape=box,color=blue];
		1237 -> 1243;
	1240 [label="Ich hab die Wahrheit darüber gesprochen, das mich zu diesem Handeln antreibt, der Schmerz befreit meinen Geist von den Visionen, die mich plagen. Und die Handlung selbst ist unter den Brüdern von Lua nicht so tabu, wie vielleicht in deiner Kultur. Ich schwöre auf alles, was mir wichtig ist, ich halte kein Geheimnis zurück.",shape=box,color=blue];
		1240 -> 1245;
	1239 [label="Das ist ein kompliziertes Thema, da es nicht nur einen Grund dafür gibt, dass ich mich selbst verletze. Ich habe dir von den Visionen erzählt, die mich heimsuchen und das Schmerz meinen Geist befreit. Aber die Handlung selbst nicht so tabu, wie du vielleicht meinst.",shape=box,color=blue];
		1239 -> 1244;
	1238 [label="Das ist ein kompliziertes Thema, da es nicht nur einen Grund dafür gibt, dass ich mich selbst verletze. Ich muss damit beginnen, dass diese Angelegenheit nicht annähernd so tabu ist, wie es dir heute erscheinen mag.",shape=box,color=blue];
		1238 -> 1244;
	1246 [label="Ich glaube nicht, dass das, was ich tue, \"richtig\" ist. Ich glaube nicht, dass das, was ich tue, von anderen praktiziert werden sollte. Ich glaube nicht, dass das, was ich tue, beneidenswert ist.",shape=box,color=blue];
		1246 -> 1251;
	1242 [label="-Pater Lyon Allard",shape=box,color=blue];
		1242 -> 1247;
	1243 [label="Zweitens möchte ich dir dafür gratulieren, dass du mir diese Worte gesendet hast. Es wäre einfacher gewesen, sie zu meiden. Doch das hast du nicht getan.",shape=box,color=blue];
		1243 -> 1248;
	1245 [label="Wenn du glaubst, dass ein tiefsitzender, schrecklicher Selbsthass mich dazu treibt, mir selbst Schaden zuzufügen, möchte ich diese Befürchtungen gerne ausräumen.",shape=box,color=blue];
		1245 -> 1250;
	1244 [label="Unter den Brüdern von Lua ist die Geißelung ein uralter Brauch. Er ist selten und sogar zu  meiner Zeit wurde er als archaisch angesehen und nur von jenen praktiziert, die \"durch ihre Visionen gesegnet\" waren.",shape=box,color=blue];
		1244 -> 1249;
	1251 [label="Es ist jedoch in meinem einzigartigen und eher \"übernatürlichen\" Zustand, wenn man es mal ganz wörtlich nimmt, auch nicht gerade gefährlich für mich.",shape=box,color=blue];
		1251 -> 1256;
	1247 [label="Update boolean LyonSpeech",color=orange];
		1247 -> 1252;
	1248 [label="Drittens verstehe ich nicht den Kontext dessen, was dein Freund durchlitten hat und werde es vermutlich auch nie verstehen. Vermutlich versteht es aus ihm ohnehin niemand.",shape=box,color=blue];
		1248 -> 1253;
	1250 [label="Während ich ... durchaus melancholisch sein kann, ist es nicht das, was mich dazu bringt ein Weihrauchfass zu benutzen. Marie würde es nie erlauben.",shape=box,color=blue];
		1250 -> 1255;
	1249 [label="Einer der Pater der Kathedrale brachte es mir bei, kurz nachdem ich ankam, da er sah, dass ich ... ähnlich \"gesegnet\" war und er hielt es für angebracht, mir zu helfen.",shape=box,color=blue];
		1249 -> 1254;
	1256 [label="Tatsächlich habe ich mich oft gefragt, ob es nicht irgendein modernes Wunder der Wissenschaft gibt, das mir bei meinen Leiden helfen könnte. Wenn ich in der Lage wäre, eine solche Hilfe anzunehmen, würde ich sie in Anspruch nehmen. Ich bezweifle jedoch, dass meine Physiologie dies derzeit zulassen würde.",shape=box,color=blue];
		1256 -> 1261;
	1252 [label="Chat ends.",color=orange];
	1253 [label="Auf eine solche Weise zu leiden, die einen so vollkommen verzehrt, ist per Definition eine einsame Angelegenheit.",shape=box,color=blue];
		1253 -> 1257;
	1255 [label="Update boolean LyonSNo",color=orange];
		1255 -> 1260;
		1255 -> 1259;
		1255 -> 1258;
	1254 [label="Update boolean LyonLecture2",color=orange];
		1254 -> 1258;
		1254 -> 1259;
		1254 -> 1260;
	1261 [label="Wie dem auch sei, ich werde nicht davon sterben. Es ist eine Bürde, die ich trage, seit ich ein Kind war. Und ich hab entschieden, dass dieses Symptom besser ist, als die darunterliegende, eiternde Wunde, solange ich die Kruste nicht abkratze.",shape=box,color=blue];
		1261 -> 1264;
	1257 [label="Ich bete nur zu meinem Gott und deinem und ihrem, dass du keine Schuld im Herzen trägst. Denn wenn irgendetwas in dieser Welt oder einer anderen Welt vergeben werden kann, dann ist es die Güte, jemanden zu kennen, der so gelitten hat.",shape=box,color=blue];
		1257 -> 1262;
	1260 [label="Und du bist sicher, dass du ... es nie zu weit treiben wirst?",shape=box,color=red];
		1260 -> 1231;
	1259 [label="Manchmal bin ich erstaunt darüber, wie seltsam religiöse Praktiken sein können.",shape=box,color=red];
		1259 -> 1263;
	1258 [label="Das beruhigt mich etwas, denke ich.",shape=box,color=red];
		1258 -> 1231;
	1264 [label="Check boolean LyonSNo",color=orange];
		1264 -> 1267 [label=true,color=green];
		1264 -> 1268 [label=false,color=brown];
	1262 [label="+15 Chemistry",color=orange];
		1262 -> 1265;
	1263 [label="Es gibt keinen Grund, mit dir darüber zu streiten. Die Unterschiede bei religiösen Zeremonien faszinieren mich. Ich genieße es sehr, sämtliche Dokumente darüber zu studieren.",shape=box,color=blue];
		1263 -> 1266;
	1267 [label="+10 Chemistry",color=orange];
		1267 -> 1271;
	1268 [label="Wenn du glaubst, dass ein tiefsitzender, schrecklicher Selbsthass mich dazu treibt, mir selbst Schaden zuzufügen, möchte ich diese Befürchtungen gerne ausräumen.",shape=box,color=blue];
		1268 -> 1272;
	1265 [label="Lass es dir gut gehen, Drifter. Wir sprechen uns bald wieder.",shape=box,color=blue];
		1265 -> 1269;
	1266 [label="Religiöse Anthropologie ist mir sehr wichtig. Man kann sehr viel über eine Gesellschaft und ein Volk lernen, indem man seine Rituale studiert.",shape=box,color=blue];
		1266 -> 1270;
	1271 [label="Ich kann dir jedoch folgendes versprechen, sollte ich befürchten müssen, dass ein Moment kommt, indem ich mir selbst nicht länger trauen kann, werde ich diese Worte aussprechen.",shape=box,color=blue];
		1271 -> 1275;
	1272 [label="Während ich ... durchaus melancholisch sein kann, ist es nicht das, was mich dazu bringt ein Weihrauchfass zu benutzen. Marie würde es nie erlauben.",shape=box,color=blue];
		1272 -> 1267;
	1269 [label="-Pater Lyon Allard",shape=box,color=blue];
		1269 -> 1273;
	1270 [label="Es gibt eine Sekte der Himmlischen, weit im kalten Norden, die eine Leiche anbeten, die sie auf einem schmelzenden Gletscher gefunden haben. Sie war perfekt erhalten und keiner weiß genau, wie alt sie ist. Aber die Messingscheibe, die sie um den Hals trug, war mit einem Sonnensymbol verziert.",shape=box,color=blue];
		1270 -> 1274;
	1275 [label="Ich werde sie an Marie richten, an M. Loid, sogar an Roathe, es wird keine Rolle spielen. Ich werde sie aussprechen. Dies schwöre ich.",shape=box,color=blue];
		1275 -> 1277;
		1275 -> 1278;
	1273 [label="Chat ends.",color=orange];
	1274 [label="Sie glauben, dass der mumifizierte Körper der von Sol selbst ist. Und sie glauben, dass er eines Tages wieder zum Leben erwachen und sich erheben wird. Alle hundert Jahre bereiten sie \"Die Große Nacht\" vor und viele ihrer Anhänger trinken am Abend zuvor vergifteten Wein.",shape=box,color=blue];
		1274 -> 1276;
	1277 [label="Das ist alles, worum ich bitten kann. Danke, Lyon.",shape=box,color=red];
		1277 -> 1280;
	1278 [label="Ich vertraue dir. Ich wollte es nur mit dir zusammen durchgehen",shape=box,color=red];
		1278 -> 1280;
	1276 [label="Selbstverständlich gibt es einen triftigen Grund dafür, warum der mumifizierte Körper am nächsten Morgen nicht auferstanden ist, warum ihre Berechnungen falsch waren und das Datum um ungefähr ein weiteres Jahrhundert verschoben werden muss.",shape=box,color=blue];
		1276 -> 1279;
	1280 [label="Und ich schätze deinen Wunsch sicherzugehen, dass ich nicht aus einem ungezügelten Drang heraus handele, mich selbst zu zerstören.",shape=box,color=blue];
		1280 -> 1281;
	1279 [label="Aber ich bin vom eigentlich Thema ziemlich weit abgekommen.",shape=box,color=blue];
		1279 -> 1241;
	1281 [label="Ich bin nicht daran gewöhnt, solche Begleiter in meinem Leben zu haben.",shape=box,color=blue];
		1281 -> 1282;
	1282 [label="Lass es dir gut gehen, Drifter. Wir sprechen uns bald wieder.",shape=box,color=blue];
		1282 -> 1283;
	1283 [label="-Pater Lyon Allard",shape=box,color=blue];
		1283 -> 1284;
	1284 [label="Chat ends.",color=orange];
}