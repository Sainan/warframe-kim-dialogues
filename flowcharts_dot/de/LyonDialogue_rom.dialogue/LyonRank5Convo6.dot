	j3203510524 [label="Evaluate expressions",color=orange];
		j3203510524 -> j1463640491 [label="LoidFamilyComplete",color=purple];
		j3203510524 -> j1486748917 [label="MarieEntratiCompleteA",color=purple];
		j3203510524 -> j2455331507 [label="MarieEntratiCompleteB",color=purple];
		j3203510524 -> j2212810092 [label="MarieEntratiCompleteC",color=purple];
		j3203510524 -> "Chat ends." [label="false",color=purple];
	j1463640491 [label="Drifter. Eine Bitte, wenn ich darf?",shape=box,color=blue];
		j1463640491 -> j4230715961;
		j1463640491 -> j129698615;
	j1486748917 [label="Darf ich mir einen Moment nehmen, um dir zu etwas zu gratulieren, dass ich bisher für absolut unmöglich gehalten habe?",shape=box,color=blue];
		j1486748917 -> j2894240484;
		j1486748917 -> j579158833;
		j1486748917 -> j129698615;
	j2455331507 [label="Ich muss dir mein Beileid darüber aussprechen, wie edel und doch kurzlebig deine Bemühungen sind, wenn es um Marie und \"le Cardinal\" geht.",shape=box,color=blue];
		j2455331507 -> j579158833;
		j2455331507 -> j2894240484;
		j2455331507 -> j129698615;
	j2212810092 [label="Es tut mir leid, dass Marie und du euch nicht über \"le Cardinal\" einigen könnt. Ich bin nur froh, dass ihr euch wenigstens nicht geprügelt habt.",shape=box,color=blue];
		j2212810092 -> j579158833;
		j2212810092 -> j2894240484;
		j2212810092 -> j129698615;
	"Chat ends." [color=orange];
	j4230715961 [label="Worum geht es?",shape=box,color=red];
		j4230715961 -> j2163693479;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j2894240484 [label="Ich bin nicht wirklich stolz auf ein paar Dinge, dich ich gesagt habe, aber ...",shape=box,color=red];
		j2894240484 -> j4194469239;
	j579158833 [label="Das alles hat sie dir erzählt?",shape=box,color=red];
		j579158833 -> j1782815667;
	j2163693479 [label="Bitte bringe Marie dazu, die Nekramiten nicht mehr zur Replikation von Möbeln zu benutzen. Ich weiß jetzt schon nicht, was ich mit den ganzen Stühlen anfangen soll.",shape=box,color=blue];
		j2163693479 -> j2197070409;
	j4194469239 [label="Es gibt einen Grund, warum der Begriff \"Affekttat\" erfunden wurde. Wenn wir als Geschöpfe nicht an unseren Überzeugungen festhielten, wäre das Leben ziemlich langweilig, denke ich.",shape=box,color=blue];
		j4194469239 -> j3256675890;
	j1782815667 [label="Hat sie. Wir sprechen jeden Abend über die Ereignisse des Tages. Und nach eurem Gespräch ist sie sofort zu mir geeilt, um mir alles zu erzählen, was sie darüber dachte.",shape=box,color=blue];
		j1782815667 -> j4091972660;
		j1782815667 -> j2835772505;
	j2197070409 [label="+20 Chemistry",color=orange];
		j2197070409 -> j3769534750;
	j3256675890 [label="Auf jeden Fall ruhiger und friedlicher. Aber langweilig. Es gäbe sicherlich keine nennenswerte Kunst.",shape=box,color=blue];
		j3256675890 -> j1340599448;
	j4091972660 [label="Was hat sie dir erzählt?",shape=box,color=red];
		j4091972660 -> j3495933037;
	j2835772505 [label="... und?",shape=box,color=red];
		j2835772505 -> j3495933037;
	j3769534750 [label="Und ich weigere mich, ihre ... bunten Vorschläge anzunehmen, wo genau in Roathes Anatomie man sie lagern könnte.",shape=box,color=blue];
		j3769534750 -> "Chat ends.";
	j1340599448 [label="Aber ich schweife ab. Ich frage mich ... in meinen Gesprächen mit ihr klang es, als hätten deine Worte sie bewegt. Daher frage ich, bist du zufrieden damit, wie die Dinge zwischen euch gelaufen sind?",shape=box,color=blue];
		j1340599448 -> j1424199455;
	j3495933037 [label="Check boolean LyonDating",color=orange];
		j3495933037 -> j1637461091 [label=true,color=green];
		j3495933037 -> j3079385504 [label=false,color=brown];
	j1424199455 [label="Evaluate expressions",color=orange];
		j1424199455 -> j2123007832 [label="MarieDating, MarieFamilyFail",color=purple];
		j1424199455 -> j985528521 [label="MarieDating, MarieFamilyFail",color=purple];
		j1424199455 -> j2259131697 [label="MarieFamilyFail",color=purple];
		j1424199455 -> j2533636404 [label="MarieFamilyFail",color=purple];
		j1424199455 -> j2123007832 [label="MarieFamilySuccess",color=purple];
		j1424199455 -> j3149906332 [label="MarieEntratiCompleteA",color=purple];
		j1424199455 -> j2814895131 [label="MarieEntratiCompleteB",color=purple];
		j1424199455 -> j3931126650 [label="MarieEntratiCompleteB",color=purple];
		j1424199455 -> j2993157254 [label="MarieEntratiCompleteC",color=purple];
		j1424199455 -> j3515599759 [label="false",color=purple];
	j1637461091 [label="Ha! Als ob ich ihr Vertrauen an dich verraten würde. So wichtig du mir auch bist, mon miracle, sie ist seit vielen, vielen Jahren meine Seelenverwandte.",shape=box,color=blue];
		j1637461091 -> j897064039;
	j3079385504 [label="Ha! Als ob ich ihr Vertrauen an dich verraten würde. So wichtig du mir auch bist, mein Freund, sie ist seit vielen, vielen Jahren meine Seelenverwandte.",shape=box,color=blue];
		j3079385504 -> j897064039;
	j2123007832 [label="Das bin ich. Ich glaube, sie wird mir dabei helfen, die Dinge zwischen Loid und der Familie oben in Ordnung zu bringen. Und das ist ... großartig, Lyon. Ich glaube nicht, dass ich ausdrücken kann, wie großartig.",shape=box,color=red];
		j2123007832 -> j1289987622;
	j985528521 [label="Nein. Ehrlich gesagt denke ich, dass ich dadurch, so wie es gelaufen ist, jede Chance ruiniert habe, ihr dabei zu helfen, die Wogen zwischen Loid und der Familie oben zu glätten.",shape=box,color=red];
		j985528521 -> j209600819;
	j2259131697 [label="Nein. Ehrlich gesagt denke ich, dass ich dadurch, so wie es gelaufen ist, jede Chance ruiniert habe, ihr dabei zu helfen, die Wogen zwischen Loid und der Familie oben zu glätten.",shape=box,color=red];
		j2259131697 -> j768167566;
	j2533636404 [label="Ja, das bin ich. Sie wird mir nicht dabei helfen, die Dinge zwischen Loid und der Familie oben in Ordnung zu bringen und das ist völlig in Ordnung.",shape=box,color=red];
		j2533636404 -> j126945512;
	j3149906332 [label="Das bin ich. Ich bin froh, dass sie Entrati nicht mehr als völlig \"gut\" ansieht, aber ... naja, er ist wohl auch nicht völlig \"böse\", oder?",shape=box,color=red];
		j3149906332 -> j719505813;
	j2814895131 [label="Ich bin damit zufrieden, wie es gelaufen ist. Ehrlich gesagt bin ich, was Entrati angeht, auf ihrer Seite, je mehr ich darüber nachdenke.",shape=box,color=red];
		j2814895131 -> j126945512;
	j3931126650 [label="Wir sind bei Entrati unterschiedlicher Meinung. Ich konnte sie nicht überzeugen und ... ich wünschte einfach, ich hätte es besser machen können.",shape=box,color=red];
		j3931126650 -> j1446754445;
	j2993157254 [label="Wir haben einfach anerkannt, dass wir unterschiedlicher Meinung sind, was Entrati angeht und ich glaube, besser wird es nicht. Ich denke nicht, dass weitere Gespräche hier helfen werden.",shape=box,color=red];
		j2993157254 -> j2448907699;
	j3515599759 [label="Ganz ehrlich, es ist ok. Ich glaube an diesem Punkt kann es kaum noch besser oder schlechter werden.",shape=box,color=red];
		j3515599759 -> j2448907699;
	j897064039 [label="Nein, ich fürchte ihre Worte an mich bleiben mein Geheimnis. Aber sie haben sie trotzdem berührt. Aber ich frage mich, bist du zufrieden damit, wie die Dinge zwischen euch gelaufen sind?",shape=box,color=blue];
		j897064039 -> j1424199455;
	j1289987622 [label="Ich glaube, ich kann die Würde dessen erfassen, wenn auch nicht das ganze Ausmaß. Ich fühle mich geehrt daran teilzuhaben, wenn auch nur in kleinem Ausmaß.",shape=box,color=blue];
		j1289987622 -> j2557006628;
		j1289987622 -> j4204660457;
	j209600819 [label="Faszinierend ... Du bist jetzt ihr Geliebter, nicht wahr? Wenn es hier jemand gibt, der genug Einfluss hat, um sie zu überzeugen, dass wärst du, oder?",shape=box,color=blue];
		j209600819 -> j244231804;
	j768167566 [label="Faszinierend ... Nun, ich bin dafür bekannt, dass ich einen gewissen ... Einfluss auf sie habe, so begrenzt er auch sein mag. Du glaubst, dass es wichtig ist, die Beziehungen zwischen M. Loid und Entratis entfremdeter Familie zu reparieren?",shape=box,color=blue];
		j768167566 -> j657321870;
		j768167566 -> j4006430012;
	j126945512 [label="Ich kann nicht sagen, ob dies ein Ausdruck von Trotz, Arroganz, Ignoranz oder Apathie ist. Daher finde ich mich damit ab, dass es eine Mischung aus allen vieren ist und setze meinen Tag fort.",shape=box,color=blue];
		j126945512 -> j1881976283;
	j719505813 [label="Ja, dass sehe ich ähnlich, wie du. Ich sehe ihn weder als das eine,  noch als das andere, eher ... als eine Mischung aus beiden Motivationen.",shape=box,color=blue];
		j719505813 -> j3351628794;
	j1446754445 [label="Hm. Leider kommt ein Punkt, an dem wir die Dinge ruhen lassen müssen. Ein Teig kann überknetet werden. Ein Künstler kann zuviel in seinem Gemälde verarbeiten. Und eine Diskussion kann zu sehr in die Länge gezogen werden.",shape=box,color=blue];
		j1446754445 -> j1739002984;
	j2448907699 [label="Ja, vielleicht sollten wir uns doch neueren, interessanteren Themen zuwenden.",shape=box,color=blue];
		j2448907699 -> j3424514008;
	j2557006628 [label="Ich hätte nicht gedacht, dass du Hilfe anbieten würdest.",shape=box,color=red];
		j2557006628 -> j841208141;
	j4204660457 [label="Heißt das, du wirst mir dabei helfen, Loid zu überzeugen, nach oben zu gehen und mit ihnen zu sprechen?",shape=box,color=red];
		j4204660457 -> j886171947;
	j244231804 [label="Ich hoffe nur, du hast ihr nicht mit deinen Worten eine Art Opfer gebracht, dass du eine Priorität über die andere gestellt hast, um sie für dich zu gewinnen.",shape=box,color=blue];
		j244231804 -> j3966817507;
	j657321870 [label="Es gibt so viel Einsamkeit in dieser Welt, Lyon. So vie Trauer. Warum nicht etwas davon erleichtern, wenn wir es können?",shape=box,color=red];
		j657321870 -> j571390863;
	j4006430012 [label="Ich bin mir nicht sicher, es ist eher ein Instinkt ... ein Bauchgefühl. Ich fühle, dass Entrati euch gerade jetzt aus einem bestimmten Grund hergebracht hat.",shape=box,color=red];
		j4006430012 -> j4141193966;
	j1881976283 [label="Schade.",shape=box,color=blue];
		j1881976283 -> j3497962379;
	j3351628794 [label="Überheblichkeit war ein Teil davon. Ein Hunger nach Wissen. Und jetzt vielleicht ein Hunger nach Vergebung. Wer weiß. Vielleicht weiß er es selbst nicht einmal.",shape=box,color=blue];
		j3351628794 -> j1639898689;
	j1739002984 [label="Ich denke, ich würde mich einfach dazu entscheiden, es dabei zu belassen. Und darauf hoffen, dass sie Entrati eines Tages so sieht, wie wir ihn bereits sehen ... im besten Fall, als kompliziert.",shape=box,color=blue];
		j1739002984 -> j1639898689;
	j3424514008 [label="Ich für meinen Teil bin bereit, mich von den endlosen Gesprächen über den wunderbaren und makellosen \"le Cardinal\" zu distanzieren.",shape=box,color=blue];
		j3424514008 -> j1639898689;
	j841208141 [label="Ich bin kein leichter Umgang, aber ich bin auch kein Unmensch. Wenn du meine Hilfe in Anspruch nehmen möchtest, bin ich zur Stelle.",shape=box,color=blue];
		j841208141 -> j2800191596;
	j886171947 [label="Natürlich. Wenn du meine Hilfe in Anspruch nehmen möchtest, bin ich zur Stelle.",shape=box,color=blue];
		j886171947 -> j2800191596;
	j3966817507 [label="Dann wären die Dinge wirklich in einem traurigen Zustand.",shape=box,color=blue];
		j3966817507 -> j1306353347;
	j571390863 [label="Hm. Und was ist mit möglichen Schmerzen, die eine Wiedervereinigung verursachen könnte, wenn solche Enthüllungen gemacht werden.",shape=box,color=blue];
		j571390863 -> j4073928912;
		j571390863 -> j2681654113;
	j4141193966 [label="Und es ist normal, dass du nach Entratis Pfeife tanzt auf der Grundlage diese \"Bauchgefühls\"?",shape=box,color=blue];
		j4141193966 -> j2369516837;
		j4141193966 -> j2466571852;
	j3497962379 [label="Boolean LyonFamilyFail is now true.",color=orange];
		j3497962379 -> "Chat ends.";
	j1639898689 [label="Ich weiß nicht, wie sich die Dinge zwischen M. Loid und Entratis entfremdeter Familie entwickeln werden. Ich möchte nur sagen, wenn du meine Hilfe brauchst, bin ich zur Stelle.",shape=box,color=blue];
		j1639898689 -> j2800191596;
	j2800191596 [label="Evaluate expressions",color=orange];
		j2800191596 -> j2598121874 [label="RoatheFamilyDelay",color=purple];
		j2800191596 -> j2180755899 [label="RoatheFamilyFail",color=purple];
		j2800191596 -> j291215585 [label="false",color=purple];
	j1306353347 [label="Du hast meine Unterstützung, so wenig sie dir auch nützen mag.",shape=box,color=blue];
		j1306353347 -> j2256886096;
	j4073928912 [label="Natürlich wird es anfangs weh tun. Als würde man einen Knochen einrenken. Aber das ist der einzige Weg, wie so etwas richtig heilen kann.",shape=box,color=red];
		j4073928912 -> j2219621190;
	j2681654113 [label="Ich glaube, der Nutzen, den wir gewinnen können, wenn wir zusammen sind, ist größer als der Verlust, wenn wir getrennt bleiben.",shape=box,color=red];
		j2681654113 -> j2219621190;
	j2369516837 [label="Nein, aber ich beschütze Leute, die Schutz brauchen. Und ich kann sie und diesen Ort nicht auf ewig vor dem Raunen und dem Befall beschützen. Aber ihr beide und vielleicht sogar Roathe, könnt es.",shape=box,color=red];
		j2369516837 -> j2219621190;
	j2466571852 [label="Ich vertraue ihm nicht unbedingt, aber ich glaube immer noch nicht, dass er unser Feind ist. Es fühlt sich an, als würde ein Krieg drohen und dass wir alle da auf dem Spielfeld platziert werden, wo wir sein müssen. Und wir gehören hier hin.",shape=box,color=red];
		j2466571852 -> j1273772456;
	j2598121874 [label="Aber ich glaube, die schwerste Aufgabe hast du bereits bewältigt ... Roathe zu überzeugen.",shape=box,color=blue];
		j2598121874 -> j2573304493;
	j2180755899 [label="Aber ich muss mir erst überlegen, wie ich Roathe dazu bringe, seine Meinung zu ändern ... und ich bin mir nicht sicher, dass ich es schaffe. Ohne ihn könnte das ganze aussichtslos sein.",shape=box,color=blue];
		j2180755899 -> j2179125621;
		j2180755899 -> j3293995727;
	j291215585 [label="Der, der am schwersten zu überzeugen sein wird und ich scheue mich dies zuzugeben, wahrscheinlich der wichtigste, ist ... Roathe.",shape=box,color=blue];
		j291215585 -> j2179125621;
		j291215585 -> j3293995727;
	j2256886096 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j2256886096 -> j4280312797;
	j2219621190 [label="+20 Chemistry",color=orange];
		j2219621190 -> j1781773787;
	j1273772456 [label="Hm, vielleicht. Aber wir sind keine Schachfiguren und ich weigere mich, so behandelt zu werden. Falls Entrati so etwas vor hat, soll er gefälligst einen Brief schreiben.",shape=box,color=blue];
		j1273772456 -> j2845709272;
	j2573304493 [label="Der verdammte Kerl ist, so sehr ich auch wünschte, ich könnte einen Weg finden, ihn zum Schweigen zu bringen, nützlich.",shape=box,color=blue];
		j2573304493 -> j3941867773;
	j2179125621 [label="Ja ...",shape=box,color=red];
		j2179125621 -> j2573304493;
	j3293995727 [label="Warum ist Roathe dafür eigentlich so wichtig?",shape=box,color=red];
		j3293995727 -> j2249941065;
	j4280312797 [label="- Lyon",shape=box,color=blue];
		j4280312797 -> j1933300832;
	j1781773787 [label="In der Tat, weise Worte. Also gut. Ich werde mit ihr sprechen. Ich werde sehen, ob ich sie überzeugen kann, mit dir erneut darüber zu sprechen.",shape=box,color=blue];
		j1781773787 -> j4009327387;
		j1781773787 -> j1271269122;
	j2845709272 [label="Auf diese Weise schließe ich mich der Beschwerde von M. Loid an. Ich werde dir dabei helfen, ihn zu überzeugen, aber ich glaube nicht, dass du ohne Marie weit kommen wirst.",shape=box,color=blue];
		j2845709272 -> j425416153;
	j3941867773 [label="Check boolean RoatheDating",color=orange];
		j3941867773 -> j2714153342 [label=true,color=green];
		j3941867773 -> j902262481 [label=false,color=brown];
	j2249941065 [label="Marie und ich sind Außenseiter. Roathe, Loid, Entrati und seine Tochter sind alle Zeitgenossen. Außerdem verfügt er über Wissen, dass er dazu nutzen könnte, wie zu beschützen, sollte etwas schiefgehen.",shape=box,color=blue];
		j2249941065 -> j903402916;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j4009327387 [label="Moment ... du wirst ... sie überzeugen mir bei der Entrati Familie zu helfen?",shape=box,color=red];
		j4009327387 -> j1339652253;
	j1271269122 [label="Ich ... Du ... Das machst du?",shape=box,color=red];
		j1271269122 -> j1339652253;
	j425416153 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j425416153 -> j665698856;
	j2714153342 [label="Nichts für ungut.",shape=box,color=blue];
		j2714153342 -> j3458214785;
		j2714153342 -> j3854664548;
	j902262481 [label="Aber ich schweife schon wieder ab. Wie gesagt, wenn die Zeit reif ist. Und wo wir von Zeit sprechen, ich muss los.",shape=box,color=blue];
		j902262481 -> j3211225452;
	j903402916 [label="Ich gebe es nicht gerne zu, aber Marie und ich würden immer noch unbeholfen herumlaufen und versuchen herauszufinden, wie man die Hälfte der Geräte hier benutzt, während er sie mit Leichtigkeit handhabt.",shape=box,color=blue];
		j903402916 -> j2573304493;
	j1339652253 [label="Check boolean LyonDating",color=orange];
		j1339652253 -> j3037227076 [label=true,color=green];
		j1339652253 -> j3178855383 [label=false,color=brown];
	j665698856 [label="Viel Glück. Bis später.",shape=box,color=blue];
		j665698856 -> j3311435967;
	j3458214785 [label="Mehr für mich.",shape=box,color=red];
		j3458214785 -> j1869486201;
	j3854664548 [label="Kein Ding. Er ist nicht jedermanns Sache.",shape=box,color=red];
		j3854664548 -> j1869486201;
	j3211225452 [label="+20 Chemistry",color=orange];
		j3211225452 -> j2232360268;
	j3037227076 [label="Ich tue, was ich kann, mon miracle. Sie ist meine Schwester. Aber ich kann nur begrenzt helfen. Ich stelle sicher, dass sie erneut mit dir redet, aber danach liegt alles an dir.",shape=box,color=blue];
		j3037227076 -> j3242984836;
	j3178855383 [label="Ich tue, was ich kann, mein Freund. Sie ist meine Schwester. Aber ich kann nur begrenzt helfen. Ich stelle sicher, dass sie erneut mit dir redet, aber danach liegt alles an dir.",shape=box,color=blue];
		j3178855383 -> j3242984836;
	j3311435967 [label="- Lyon",shape=box,color=blue];
		j3311435967 -> "Chat ends.";
	j1869486201 [label="Hmmm. Wie dem auch sei, du hast meinen Beistand, wenn die Zeit reif ist. Und wo wir von Zeit sprechen, ich muss los.",shape=box,color=blue];
		j1869486201 -> j3211225452;
	j2232360268 [label="Bis später. -Lyon",shape=box,color=blue];
		j2232360268 -> j2641036676;
