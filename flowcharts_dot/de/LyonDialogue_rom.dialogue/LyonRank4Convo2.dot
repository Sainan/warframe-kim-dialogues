digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank4Convo2 begins." [color=orange];
		"LyonRank4Convo2 begins." -> j3420559302;
		"LyonRank4Convo2 begins." -> j687670884;
		"LyonRank4Convo2 begins." -> j129698615;
	j3420559302 [label="Wie ist es möglich, dass du und Marie ein Priester und eine Nonne seid, aber ... gleichzeitig Gewalttaten begeht?",shape=box,color=red];
		j3420559302 -> j2027373563;
		j3420559302 -> j2461828596;
		j3420559302 -> j2508033522;
	j687670884 [label="Kann ich dir eine etwas seltsame Frage stellen, Lyon?",shape=box,color=red];
		j687670884 -> j2131087171;
	j129698615 [label="[Ende.]",shape=box,color=red];
		j129698615 -> "Chat ends.";
	j2027373563 [label="Ich höre, wie Marie \"païens!\" schreit und sehe, wie sie sich in den Kampf stürzt ... und trotzdem fällt es mir schwer sie als jemand zu sehen, der jemanden für seine Überzeugungen verurteilen würde. Ich kann mir nicht vorstellen, dass du sehr anders bist. Immerhin hält sie sehr viel von dir.",shape=box,color=red];
		j2027373563 -> j1810574351;
	j2461828596 [label="Was würde eure Kirche davon halten, was du und Marie hier tun? Darüber ... was ihr in ihrem Namen tun sollt?",shape=box,color=red];
		j2461828596 -> j3337007941;
	j2508033522 [label="Wenn ich dich und Marie auf dem Schlachtfeld sehe und dann privat mit ihr spreche oder dich ruhig Bücher lesen sehe ... glaube ich, fällt es mir schwer, diese Individuen in meinem Kopf in Einklang zu bringen.",shape=box,color=red];
	j2131087171 [label="Wenn du unsere gegenwärtige Lage einfach nur als \"seltsam\" bezeichnen kannst, bin ich entweder von deiner inneren Kraft beeindruckt oder bestürzt über deinen begrenzten Wortschatz. Ich vermute jedoch, es ist Ersteres.",shape=box,color=blue];
		j2131087171 -> j2335132022;
	"Chat ends." [color=orange];
	j1810574351 [label="Du hast durchaus recht. Marie verurteilt niemanden dafür, dass er im Herzen einen uralten Baumgott trägt ... stattdessen würde sie wohl versuchen zu sehen, welche Überzeugungen man gemeinsam hat.",shape=box,color=blue];
		j1810574351 -> j1153132001;
	j3337007941 [label="Seinerzeit wurden viele heilige Kriege im Namen von Sol oder Lua geführt. Blutige \"Kreuzzüge\", um die \"Heiden\" zurückzudrängen oder \"heiliges Land wiederzuerlangen\" oder welche fadenscheinigen Begründung gerade beliebt war.",shape=box,color=blue];
		j3337007941 -> j2958088906;
	j2335132022 [label="+5 Chemistry",color=orange];
		j2335132022 -> j441526145;
	j1153132001 [label="Wird der Baum nicht von Sols Licht gespeist, vielleicht? Gibt es eine gemeinsame Basis, auf deren Grundlage man Brot brechen könnte? Sie ist eher bereit, zusammenzusitzen und zuzuhören, als jemandem aufgrund seines Glaubens zu schaden.",shape=box,color=blue];
		j1153132001 -> j3993613004;
	j2958088906 [label="Die Orthodoxie der Himmlischen verfügt über keine Armee und führt keine Kriege. Sie verbieten jedoch auch niemandem, selbst aktiv zu werden oder andere zu schützen.",shape=box,color=blue];
		j2958088906 -> j3733674329;
	j441526145 [label="Damit will ich sagen, ja, frag nur. Egal, worauf du neugierig bist, die Dinge können für mich nicht seltsamer werden.",shape=box,color=blue];
		j441526145 -> j2027373563;
		j441526145 -> j2461828596;
		j441526145 -> j2508033522;
	j3993613004 [label="Wenn sie sich auf dem Schlachtfeld ihren Gegnern stellt, glaube ich, ist es eins von zwei Dingen: entweder hat sie einfach Spaß und spielt eine antike Kreuzritterin, indem sie sich selbst in einer glänzenden Rüstung als Ritter Sols sieht ...",shape=box,color=blue];
		j3993613004 -> j2531118530;
	j3733674329 [label="Wenn Marie sich auf dem Schlachtfeld ihren Gegnern stellt, glaube ich, ist es eins von zwei Dingen: entweder hat sie einfach Spaß und spielt eine antike Kreuzritterin, indem sie sich selbst in einer glänzenden Rüstung als Ritter Sols sieht ...",shape=box,color=blue];
		j3733674329 -> j2531118530;
	j2531118530 [label="Vielleicht erinnert sie sich auch an Astaphor 8:23 \"Einsam sind die Seelen, die versuchen mein Haus mit Gewalt zu betreten, denn sie wurden aus dem Lichte Sols verstoßen\".",shape=box,color=blue];
		j2531118530 -> j541427404;
	j541427404 [label="In ihren Augen ist die Gewalt, die sie begeht, rechtens, im Namen der Verteidigung eines höheren Gutes ... so, wie du es auch sehen würdest und die, die an deiner Seite kämpfen, nehme ich an.",shape=box,color=blue];
		j541427404 -> j3674323061;
	j3674323061 [label="Und daher sind diejenigen, gegen die sie kämpft, ungeachtet ihrer Religion, aus Sols Licht verbannt. Selbst, wenn sie das heilige Gewand ihres eigenen Ordens tragen würden, sind sie in ihren Augen Heiden.",shape=box,color=blue];
		j3674323061 -> j2831609213;
		j3674323061 -> j4104223234;
	j2831609213 [label="Ich sehe, dass du dich selbst außen vor gelassen hast. Was stehst du zu den Kämpfen?",shape=box,color=red];
		j2831609213 -> j2732581967;
	j4104223234 [label="Das ergibt Sinn. Danke.",shape=box,color=red];
		j4104223234 -> j1631368655;
	j2732581967 [label="Ich weiche absichtlich aus, Drifter.",shape=box,color=blue];
		j2732581967 -> j515658120;
		j2732581967 -> j538145371;
	j1631368655 [label="+5 Chemistry",color=orange];
		j1631368655 -> j3607378782;
	j515658120 [label="Und ich bleibe beharrlich, Priester.",shape=box,color=red];
		j515658120 -> j2572238699;
	j538145371 [label="Auch gut. Ich nehme heute, was ich kriegen kann.",shape=box,color=red];
		j538145371 -> j1631368655;
	j3607378782 [label="Wenn man mich fragt, Marie ... hat mir gesagt, du meinst es gut. Und ich glaube ihr, auch, wenn ich mir selbst nicht glaube.",shape=box,color=blue];
		j3607378782 -> j3845373601;
	j2572238699 [label="+10 Chemistry",color=orange];
		j2572238699 -> j842501820;
	j3845373601 [label="Am Ende bleibt mit nur, dich um Geduld zu bitten. Lua weiß, dass ich an meisten Tagen selbst nicht genug davon habe.",shape=box,color=blue];
		j3845373601 -> j1599833162;
	j842501820 [label="Also gut. Wenn du dich nicht umstimmen und immer noch neugierig bist? Der Tod, den ich verursache, beunruhigt mich nicht so sehr ... wie du vielleicht erwartest.",shape=box,color=blue];
		j842501820 -> j965239987;
	j1599833162 [label="-Pater Lyon Allard",shape=box,color=blue];
		j1599833162 -> "Chat ends.";
	j965239987 [label="Oder wie es vielleicht für einen Priester und Gelehrten als \"angebracht\" betrachtet werden würde.",shape=box,color=blue];
		j965239987 -> j1257214478;
		j965239987 -> j2912862034;
	j1257214478 [label="Ich habe mehr Krieg als Frieden erlebt in meinem Leben erlebt, Lyon. Würde es mich belasten, wäre ich sicher nicht mehr hier. Aber das heißt nicht, dass es nicht eine Last mit sich bringt, einen echten Preis.",shape=box,color=red];
		j1257214478 -> j2939199733;
	j2912862034 [label="Ich bin sicher, die anderen haben dir gesagt, wer ich bin. Was ich bin. Wo ich herkomme. Der Tod, der mir folgt, der Tod, aus dem ich gemacht wurde. Der Tod, der mich prägt. Glaubst du, irgendetwas, was du fühlst, würde mich überraschen?",shape=box,color=red];
		j2912862034 -> j973624633;
	j2939199733 [label="Add 1 to Thermostat counter",color=orange];
		j2939199733 -> j1609552027;
	j973624633 [label="Add -1 to Thermostat counter",color=orange];
		j973624633 -> j4118377204;
	j1609552027 [label="Ja, das gaube ich.",shape=box,color=blue];
		j1609552027 -> j1635346946;
		j1609552027 -> j4106450718;
	j4118377204 [label="Ja, in der Tat.",shape=box,color=blue];
		j4118377204 -> j1635346946;
		j4118377204 -> j4106450718;
	j1635346946 [label="Es tut mir leid, wenn ich dich verstimmt habe. Das war nicht meine Absicht.",shape=box,color=red];
		j1635346946 -> j1209119895;
	j4106450718 [label="Möchtest du das ... erläutern?",shape=box,color=red];
		j4106450718 -> j287184662;
	j1209119895 [label="Das ist nicht deine Schuld, Drifter. Ich bin, wie deine Brüder und Schwestern aus Libertatia sagen würden \"ein harter Brocken\".",shape=box,color=blue];
		j1209119895 -> j1372007375;
	j287184662 [label="Das Grauen, das in meinem Geist widerhallt, kennt keine Grenzen. Ich sehe Ketten aus menschlichen Sehnen, die einst Purpurrot trieften und nun spröde und schwarz sind.",shape=box,color=blue];
		j287184662 -> j3462399048;
	j1372007375 [label="Ich bin nur ein belagerter Mensch. Ich halte die Stellung. Das Tor zu öffnen, hieße, die Verteidigung zu gefährden.",shape=box,color=blue];
		j1372007375 -> j2485161405;
		j1372007375 -> j2593879568;
	j3462399048 [label="Ich sehe hunderttausend Antlitze meinerselbst, ähnlich und doch fremd. Leere Hüllen, Leichen aus verdrehtem, gebrochenem Fleisch, schwebend im Schleier zwischen Leben und Tod.",shape=box,color=blue];
		j3462399048 -> j938630098;
	j2485161405 [label="Ich verstehe. Wenn du bereit bist, können wir reden.",shape=box,color=red];
		j2485161405 -> j906596929;
	j2593879568 [label="Wie meinst du das?",shape=box,color=red];
		j2593879568 -> j287184662;
	j938630098 [label="Starre Gesichtsausdrücke, wie leere Masken. Aber in den flackernden Überresten ihrer Seelen, Glutreste, die nicht verlöschen, ich höre sie schreien. Endloses Heulen nach Vergeltung. Nach Freiheit.",shape=box,color=blue];
		j938630098 -> j1665777637;
	j906596929 [label="Ich komme zu dem deutlichen Eindruck, dass ich in dieser Angelegenheit keine Wahl habe.",shape=box,color=blue];
		j906596929 -> j2099358924;
	j1665777637 [label="Nach Tod.",shape=box,color=blue];
		j1665777637 -> j2465172589;
	j2099358924 [label="+15 Chemistry",color=orange];
		j2099358924 -> j225657930;
	j2465172589 [label="Diese Visionen verfolgen mich in wachen Stunden. In meinen Träumen. Ich habe kein Albträume, denn das ist alles, was ich erlebe, alles, was ich geworden bin.",shape=box,color=blue];
		j2465172589 -> j1274675553;
	j225657930 [label="Aber wenn man mich fragt, Marie ... hat mir gesagt, du meinst es gut. Und ich glaube ihr, auch, wenn ich mir selbst nicht glaube.",shape=box,color=blue];
		j225657930 -> j3946682625;
	j1274675553 [label="Check boolean LyonPainOff",color=orange];
		j1274675553 -> j1763003355 [label=true,color=green];
		j1274675553 -> j2839808464 [label=false,color=brown];
	j3946682625 [label="Am Ende bleibt mit nur, dich um Geduld zu bitten. Lua weiß, dass ich an meisten Tagen selbst nicht genug davon habe.",shape=box,color=blue];
		j3946682625 -> j2291482422;
	j1763003355 [label="Nur, wenn ich mich dem Flüstern in meiner Seele hingebe, spiegelt sich mir eine Welt wider, die dem ähnlich ist, was dir vielleicht vertraut erscheint.",shape=box,color=blue];
		j1763003355 -> j4132300696;
	j2839808464 [label="Nur, wenn ich das Fleisch meines Körpers von mir reiße, als Opfer für das Flüstern in meiner Seele, spiegelt sich mir eine Welt wider, die dem ähnlich ist, was dir vielleicht vertraut erscheint.",shape=box,color=blue];
		j2839808464 -> j4132300696;
	j2291482422 [label="-Pater Lyon Allard",shape=box,color=blue];
		j2291482422 -> j2522325746;
	j4132300696 [label="Sei so gut und tu nicht so, als wüsstest du, was ich \"fühle\", Drifter. Ich fürchte, du hast gerade erst begonnen, zu verstehen.",shape=box,color=blue];
		j4132300696 -> j3413558619;
		j4132300696 -> j3034717755;
		j4132300696 -> j989730596;
	j2522325746 [label="Boolean LyonVisions2d is now true.",color=orange];
		j2522325746 -> "Chat ends.";
	j3413558619 [label="Es ... tut mir leid. Das wusste ich nicht.",shape=box,color=red];
		j3413558619 -> j2828119729;
	j3034717755 [label="Es gibt eine Menge Gräuel und Schmerzen, die ich erlebt habt, die du auch nicht verstehst, Lyon.",shape=box,color=red];
		j3034717755 -> j938986009;
	j989730596 [label="Es tut mir leid, wenn du denkst, ich hätte mich nicht äußern sollen. Aber ich möchte verstehen. Deine Visionen ...",shape=box,color=red];
		j989730596 -> j1688350961;
	j2828119729 [label="Ja. Ich habe all diese Jahre überstanden. Ich werde noch ein paar weitere standhaft bleiben, da bin ich sicher. Du brauchst dir keine Sorgen zu machen.",shape=box,color=blue];
		j2828119729 -> j4270520825;
	j938986009 [label="Ich bin mir sicher, dass du das hast, einiges davon spiegelt sich in den Bildern dieses Ortes wieder. Aber hältst du dich selbst für ein Paradebeispiel? Den höchsten Kenner allen Grauens und allen Leidens?",shape=box,color=blue];
		j938986009 -> j3134864284;
		j938986009 -> j2251458702;
	j1688350961 [label="Ja. Ich habe ihnen all diese Jahre getrotzt. Ich werde noch ein paar weitere standhaft bleiben, da bin ich sicher. Du brauchst dir keine Sorgen zu machen.",shape=box,color=blue];
		j1688350961 -> j4270520825;
	j4270520825 [label="Boolean LyonVisions2a is now true.",color=orange];
		j4270520825 -> j1712918300;
		j4270520825 -> j1262460468;
	j3134864284 [label="Ich sage nur, dass ich deine Situation vielleicht besser nachvollziehen kann, als du meinst.",shape=box,color=red];
		j3134864284 -> j2049656265;
	j2251458702 [label="Ich sage nur, dass ich eine Menge Tod und Grauen erlebt habe, Lyon. Daher mag ich es nicht deswegen herablassend behandelt zu werden.",shape=box,color=red];
		j2251458702 -> j1155808799;
	j1712918300 [label="Was du beschreibst, Lyon ... haben diese Visionen begonnen, bevor du ein Protoframe warst oder danach?",shape=box,color=red];
		j1712918300 -> j2756249969;
	j1262460468 [label="Können wir erneut darüber sprechen? Bitte?",shape=box,color=red];
		j1262460468 -> j986870544;
	j2049656265 [label="Boolean LyonVisions2b is now true.",color=orange];
		j2049656265 -> j473180643;
	j1155808799 [label="Boolean LyonVisions2c is now true.",color=orange];
		j1155808799 -> j3765436345;
	j2756249969 [label="Wäre diese Frage nur so einfach, wie du glaubst. Wie dem auch sei, ich bin nicht bereit, sie heute zu beantworten. Ich bekomme Kopfschmerzen.",shape=box,color=blue];
		j2756249969 -> j987394064;
	j986870544 [label="Ich komme zu dem deutlichen Eindruck, dass ich in dieser Angelegenheit keine Wahl habe.",shape=box,color=blue];
		j986870544 -> j987394064;
	j473180643 [label="Es mag dir seltsam vorkommen, dass ich nicht auf der Suche nach Sympathie bin, Drifter. Es sind Antworten, die ich suche. Gewissheit. Den Himmel, wenn doch alles Illusion und Lüge ist.",shape=box,color=blue];
		j473180643 -> j3118954169;
		j473180643 -> j1362322352;
	j3765436345 [label="Dann erlaube mir, vor dir niederzuknien. Dich für alles, was du erduldet hast, zu preisen. Und mich zu fragen, wie du nach allem, was du gesehen hast, noch bei Verstand sein kannst.",shape=box,color=blue];
		j3765436345 -> j3130991326;
	j987394064 [label="+10 Chemistry",color=orange];
		j987394064 -> j962123372;
	j3118954169 [label="Ich werde tun, was ich kann.",shape=box,color=red];
		j3118954169 -> j2009559984;
	j1362322352 [label="Dann kann ich dir vielleicht dabei helfen. Können wir erneut darüber sprechen? Bitte?",shape=box,color=red];
		j1362322352 -> j986870544;
	j3130991326 [label="Ich bewundere, wie du trotzdem seit für den Rest von uns hast, die du als so weit unter deinem erhabenen Status betrachtest.",shape=box,color=blue];
		j3130991326 -> "Chat ends.";
	j962123372 [label="Aber wenn man mich fragt, Marie ... hat mir gesagt, du meinst es gut. Und ich glaube ihr, auch, wenn ich mir selbst nicht glaube.",shape=box,color=blue];
		j962123372 -> j3845373601;
	j2009559984 [label="+5 Chemistry",color=orange];
		j2009559984 -> j693501132;
	j693501132 [label="Das ist alles, worum ich bitten kann, nicht wahr?",shape=box,color=blue];
		j693501132 -> "Chat ends.";
}