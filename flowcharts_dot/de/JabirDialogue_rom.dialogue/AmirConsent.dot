	j3897674703 [label="UUUUNDda bin ich wieder. entschuldigung, was wolltest du mir also sagen?",shape=box,color=blue];
		j3897674703 -> j2221946152;
	j2221946152 [label="Du hast ... irgendwo jemand ANDEREN? oder ... irgendwann? es ist ... nicht niemand von den Hex ... oder? ....... aaaaguughhh das wäre sooo komisch",shape=box,color=blue];
		j2221946152 -> j120005877;
	j120005877 [label="das wäre so,als ob du mit meiner cousine cayla zusammen wärst ekelekelekelekelekelekelekelekel",shape=box,color=blue];
		j120005877 -> j2194076064;
		j120005877 -> j2291832336;
	j2194076064 [label="Nein, es ist weder jemand von den Hex. Noch die Gitarre. Noch deine Cousine.",shape=box,color=red];
		j2194076064 -> j812490220;
	j2291832336 [label="Ich wusste gar nicht, dass du eine Cousine hast.",shape=box,color=red];
		j2291832336 -> j2852579566;
	j812490220 [label="OKAY ALSO WAS HAST DU ETWA NOCH EINE ANDERE BEZIEHUNG?!?!?!",shape=box,color=blue];
		j812490220 -> j1048659452;
	j2852579566 [label="ja, ich glaube, wir reden nie wirklich viel über meine familie WIR HABEN SO VIEL ANDERES ZEUG ZU BESPRECHEN WIE ZUM BEISPIEL DASS DU NOCH EINE ANDERE BEZIEHUNG HAST?!?!?",shape=box,color=blue];
		j2852579566 -> j1048659452;
	j1048659452 [label="Ich verstehe, wenn dir das unangenehm ist. Und ich möchte, dass du verstehst, dass es nicht bedeutet, dass DU mir weniger bedeutest.",shape=box,color=red];
		j1048659452 -> j457019102;
	j457019102 [label="Dieser jemand ist nicht von hier, und ich weiß nicht einmal, ob und wie ich euch vorstellen könnte, aber ... diese Person ist mir auch wichtig. Genau wie du.",shape=box,color=red];
		j457019102 -> j318542015;
	j318542015 [label="Ich weiß, dass es schwer sein kann damit umzugehen und wenn du damit nicht einverstanden bist, akzeptiere ich das absolut. Ich will nur nicht, dass du denkst, ich lüge dich an oder verheimliche dir etwas.",shape=box,color=red];
		j318542015 -> j2735965336;
	j2735965336 [label="fffffffffffffffffffffffffffffffffffffffffffffffnhghhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhijejilmmmmmmmmmmmmmmmmmmmmkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk",shape=box,color=blue];
