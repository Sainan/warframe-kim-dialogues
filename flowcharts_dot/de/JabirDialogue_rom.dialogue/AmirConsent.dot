		4527 -> 4528;
	4526 [label="ja, ich glaube, wir reden nie wirklich viel über meine familie WIR HABEN SO VIEL ANDERES ZEUG ZU BESPRECHEN WIE ZUM BEISPIEL DASS DU NOCH EINE ANDERE BEZIEHUNG HAST?!?!?",shape=box,color=blue];
		4526 -> 4528;
	4528 [label="Ich verstehe, wenn dir das unangenehm ist. Und ich möchte, dass du verstehst, dass es nicht bedeutet, dass DU mir weniger bedeutest.",shape=box,color=red];
		4528 -> 4529;
	4529 [label="Dieser jemand ist nicht von hier, und ich weiß nicht einmal, ob und wie ich euch vorstellen könnte, aber ... diese Person ist mir auch wichtig. Genau wie du.",shape=box,color=red];
		4529 -> 4530;
	4530 [label="Ich weiß, dass es schwer sein kann damit umzugehen und wenn du damit nicht einverstanden bist, akzeptiere ich das absolut. Ich will nur nicht, dass du denkst, ich lüge dich an oder verheimliche dir etwas.",shape=box,color=red];
