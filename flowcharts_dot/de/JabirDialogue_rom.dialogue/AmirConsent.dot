		j3316821453 -> "Chat ends.";
	j2323945548 [label="Ich möchte mit dir über etwas sprechen und möchte sichergehen, dass es für dich in Ordnung ist, bevor es zu weit geht.",shape=box,color=red];
		j2323945548 -> j1586337337;
	j1586337337 [label="Ich weiß, wir haben noch nie darüber gesprochen. Mir ist es wichtig, dass du nicht das Gefühl hast, ich lüge dich an oder bin dir gegenüber in irgendeiner Weise unehrlich.",shape=box,color=red];
