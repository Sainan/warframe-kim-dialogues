		4537 -> 4538 [label="false",color=purple];
	4539 [label="aber mal im ernst? ich ... vertraue dir wirklich. du bist mir so wichtig und ich bin froh, dass du mir die wahrheit gesagt hast. ich glaube hättest du mich in dieser sache angelogen wäre es ganz anders, weißt du?",shape=box,color=blue];
