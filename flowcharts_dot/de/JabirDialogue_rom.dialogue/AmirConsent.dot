		j1074303767 -> j1795926046;
	j2121264397 [label="Ich weiß, das mag seltsam klingen – aber das bedeutet nicht, dass ich weniger für dich empfinde.",shape=box,color=red];
		j2121264397 -> j1738993615;
	j1795926046 [label="Nun ja, es ist nicht die Gitarre, zum Glück ...? Hör zu, ich weiß, das mag seltsam klingen – aber das bedeutet nicht, dass ich weniger für dich empfinde.",shape=box,color=red];
		j1795926046 -> j300355091;
