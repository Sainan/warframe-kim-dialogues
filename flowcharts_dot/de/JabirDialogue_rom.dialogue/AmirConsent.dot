		4516 -> 4517;
		4516 -> 4518;
	4517 [label="Ich weiß, das mag seltsam klingen – aber das bedeutet nicht, dass ich weniger für dich empfinde.",shape=box,color=red];
		4517 -> 4519;
	4518 [label="Nun ja, es ist nicht die Gitarre, zum Glück ...? Hör zu, ich weiß, das mag seltsam klingen – aber das bedeutet nicht, dass ich weniger für dich empfinde.",shape=box,color=red];
