		4214 -> 4215;
	4215 [label="\"Das Piepsen wird lauter, gefolgt vom trappeln von Krallen auf Stein. Plötzlich wirft deine Fackel einen Schatten. Eine Ratte von der Größe einer Katze ... nein ... eines Hundes kommt auf dich zugerannt.\"",shape=box,color=blue];
		4215 -> 4216;
