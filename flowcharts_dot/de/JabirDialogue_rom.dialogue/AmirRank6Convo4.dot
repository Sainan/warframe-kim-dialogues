		4218 -> 4220;
	4219 [label="Hast du Lettie diesen Teil gezeigt?",shape=box,color=red];
		4219 -> 4221;
	4220 [label="\"Die Ratten umzingeln dich. Du stehst aufrecht da, bereit zu kämpfen, aber sie greifen nicht an. Stattdessen neigt die größte Ratte ihren Kopf vor dir. Du siehst, dass sie eine Halskette trägt. Die silberne Kette rutscht ab und landet auf dem Boden. Die Ratte schaut dich an, als wolle sie sagen: 'Das ist für dich.'\"",shape=box,color=blue];
		4220 -> 4222;
		4220 -> 4223;
	4221 [label="nein, habe ich auch nicht vor",shape=box,color=blue];
