		4123 -> 4127 [label=false,color=brown];
	4124 [label="\"Du schleichst dich vorsichtig aus der Zelle. Zu deiner Rechten ist eine große Tür, der Ausgang. Sie steht nur einen Spaltbreit offen. Auf der anderen Seite hörst du weitere Wachen der Grineer. Zu deiner Linken geht der Kerker weiter, aber es ist zu dunkel, um etwas zu sehen.\"",shape=box,color=blue];
		4124 -> 4128;
	4125 [label="schön",shape=box,color=blue];
		4125 -> 4129;
	4126 [label="\"Du durchsuchst die Leiche des Wächters erneut, findest aber nichts Wertvolles mehr. Du überlegst, den schimmeligen Keks zu essen, aber als du dessen Geruch wahrnimmst, überlegst du es dir schnell anders.\"",shape=box,color=blue];
		4126 -> 4130;
