	4226 [label="\"Die Ratte kann nicht sprechen. Es ist schließlich eine Ratte.\"",shape=box,color=blue];
		4226 -> 4227;
	4227 [label="\"Die Ratten drehen sich um und huschen davon. Wer auch immer ihnen den Schlüssel gegeben hat, wusste, dass du hier unten bist. Es gibt nur eine Person mit solcher Macht ... die Lotus.\"",shape=box,color=blue];
