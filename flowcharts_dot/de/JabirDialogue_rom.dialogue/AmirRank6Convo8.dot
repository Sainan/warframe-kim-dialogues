	j2410038230 [label="Ich glaube, wir können das hier beenden. [Ende.]",shape=box,color=red];
		j2410038230 -> j3703998490;
	j1880800077 [label="\"Du siehst Zabir an und sagst 'Ich hoffe, du kannst dieses Ding fliegen.' und Zabir sagt 'Ich nicht, aber du.'\"",shape=box,color=blue];
		j1880800077 -> j1446846280;
	j888248390 [label="\"Zabir zeigt auf die Wache auf der Rampe.\"",shape=box,color=blue];
