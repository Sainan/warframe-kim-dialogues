	j1900991050 [label="Lass uns dieses Rattenpfeifen-Ding benutzen.",shape=box,color=red];
		j1900991050 -> j29215560;
	j2186866729 [label="Ich benutze die Kontrolltafel.",shape=box,color=red];
		j2186866729 -> j4272641315;
	j2353506408 [label="Rennen wir zum Railjack.",shape=box,color=red];
		j2353506408 -> j1447680826;
	j2785082457 [label="Ich bringe Zabir dazu, die Wache auf der Rampe anzugreifen.",shape=box,color=red];
		j2785082457 -> j2884799962;
	j29215560 [label="\"Zabir nimmt die Pfeife und spielt einen langen Ton. Du hörst nichts, außer Atem. Ihr setzt euch, aber nichts passiert. Keine Ratten, nichts. Zabir zuckt mit den Achseln.\"",shape=box,color=blue];
		j29215560 -> j1779419286;
	j4272641315 [label="\"Ihr gelangt zur Kontrolltafel, aber nicht, bevor euch eine aufmerksame Wache bemerkt. Ihr versucht die Hände zu heben, um euch zu ergeben, aber sie schießen trotzdem auf euch, denn Grineer sind so fies.\"",shape=box,color=blue];
		j4272641315 -> j3909799247;
		j4272641315 -> j3925215506;
	j1447680826 [label="\"Ihr rennt zum Schiff, aber die Wache auf der Rampe sieht euch und beginnt zu schießen. Euer Tag und euer Leben enden schmerzhaft.\"",shape=box,color=blue];
		j1447680826 -> j3909799247;
		j1447680826 -> j1644010508;
	j2884799962 [label="na klar kaum bist du in gefahr schickst du amir ins rennen",shape=box,color=blue];
		j2884799962 -> j2987664664;
	j1779419286 [label="\"Dann hört ihr es, ein knirschendes Geräusch. Wie Nagegeräusche. Plötzlich stürzen Ratten aus allen Schächten überall im Hangar. Die Grineer Wachen kreischen wie Schulkinder und eröffnen das Feuer. Kugeln fliegen in jede Richtung.\"",shape=box,color=blue];
		j1779419286 -> j1140078689;
	j3909799247 [label="Ich brauche eine Pause. [Ende.]",shape=box,color=red];
		j3909799247 -> j3473197644;
	j3925215506 [label="Noch einmal.",shape=box,color=red];
		j3925215506 -> j318932394;
	j1644010508 [label="Nochmal!",shape=box,color=red];
		j1644010508 -> j1595881847;
	j2987664664 [label="ich meine zabir",shape=box,color=blue];
		j2987664664 -> j354500557;
	j1140078689 [label="\"Die Ratten haben die Wachen abgelenkt. Was jetzt?\"",shape=box,color=blue];
		j1140078689 -> j2847757415;
		j1140078689 -> j1287403462;
	j3473197644 [label="du kommst zurück",shape=box,color=blue];
		j3473197644 -> "Chat ends.";
	j318932394 [label="Boolean OneMoreTime is now true.",color=orange];
		j318932394 -> j774369477;
	j1595881847 [label="Boolean Again is now true.",color=orange];
		j1595881847 -> j774369477;
	j354500557 [label="na schön",shape=box,color=blue];
		j354500557 -> j1954779164;
	j2847757415 [label="Zabir soll die Wache auf der Rampe unter Strom setzen!",shape=box,color=red];
		j2847757415 -> j81697045;
	j1287403462 [label="Öffne die Tore mit der Kontrolltafel.",shape=box,color=red];
		j1287403462 -> j4094517596;
	j1954779164 [label="\"Du rufst 'Zabir, hol ihn dir!' während du auf die Wache auf der Rampe deutest.\"",shape=box,color=blue];
		j1954779164 -> j859955843;
	j81697045 [label="\"Zabir sprintet zur Wache und verpasst ihr einen Stromschlag. Sie sackt schlaff zusammen.\"",shape=box,color=blue];
		j81697045 -> j3028613594;
	j4094517596 [label="\"Ihr schleicht zur Kontrolltafel und versucht sie zu bedienen, während ihr gut wie möglich im Verborgenen bleibt. Ihr schafft es, die Hangartore zu öffnen.\"",shape=box,color=blue];
		j4094517596 -> j2299570435;
	j859955843 [label="\"Obwohl er es besser weiß, stürmt Zabir mutig hinein. Aber sogar er ist nicht schnell genug, um nicht bemerkt zu werden. Die Wache eröffnet das Feuer und Zabir kommt tragisch ums Leben.\"",shape=box,color=blue];
		j859955843 -> j920407666;
	j3028613594 [label="Boolean RampGuardZapped is now true.",color=orange];
		j3028613594 -> j1915017362;
	j2299570435 [label="\"Abgelenkt von den Ratten, bemerken es die Wachen nicht mal.\"",shape=box,color=blue];
		j2299570435 -> j256735146;
	j920407666 [label="game over mann",shape=box,color=blue];
		j920407666 -> j948823738;
