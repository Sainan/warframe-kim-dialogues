	j3703998490 [label="du bist mein tod",shape=box,color=blue];
		j3703998490 -> "Chat ends.";
	j1446846280 [label="\"Du startest das Schiff und gerade als du dabei bist den Knopf zu drücken, der die Rampe schließt, sagt Zabir 'Warte, wir können sie nicht zurücklassen.'\"",shape=box,color=blue];
		j1446846280 -> j3518060368;
		j1446846280 -> j98723336;
	j3518060368 [label="Du hast recht, wir müssen sie retten.",shape=box,color=red];
		j3518060368 -> j3259537112;
	j98723336 [label="Bitte nicht. Wir sollten sie wirklich hier lassen.",shape=box,color=red];
		j98723336 -> j2900713539;
	j3259537112 [label="\"Zabir hebt die Pfeile und bläst hinein.\"",shape=box,color=blue];
		j3259537112 -> j1281718451;
	j2900713539 [label="\" 'ABGELEHNT!' sagt Zabir.\"",shape=box,color=blue];
		j2900713539 -> j3259537112;
	j1281718451 [label="\"Sekunden später stürmen dutzende Ratten in das Schiff. Zabir sieht dich an und ruft 'LOS!' \"",shape=box,color=blue];
		j1281718451 -> j3278226526;
	j3278226526 [label="\"Das Schiff hebt ab. Die Grineer eröffnen das Feuer, aber ihre Kugeln prallen vom mächtigen Railjack ab, während er den Hangar verlässt.\"",shape=box,color=blue];
		j3278226526 -> j48261347;
	j48261347 [label="\"Während die Ratten über die Brücke huschen, blickst du in die Weite des Weltraums und sagst dann zuversichtlich 'RAILDRIVE, ENERGIE.' und der Railjack saust in die Ferne.\"",shape=box,color=blue];
