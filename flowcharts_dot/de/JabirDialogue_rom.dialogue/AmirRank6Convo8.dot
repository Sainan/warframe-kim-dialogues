		j948823738 -> j4118639006;
		j948823738 -> j2410038230;
	j2389852782 [label="\"Du siehst deine Chance und rennst zum Railjack.\"",shape=box,color=blue];
		j2389852782 -> j1880800077;
	j160633409 [label="\"Zabir winkt dir zu, die Hangartore zu öffnen.\"",shape=box,color=blue];
