	j1535757363 [label="würd ich dir nicht vorwerfen, er ist sehr schneidig",shape=box,color=blue];
		j1535757363 -> j533104329;
	j533104329 [label="los geht's",shape=box,color=blue];
		j533104329 -> j3373041694;
	j3373041694 [label="\"Du stehst mitten im Elektrolabor, mit dem befreiten Zabir. Er sieht dich an 'gibt keine Zeit zu verlieren, mir nach.' \"",shape=box,color=blue];
		j3373041694 -> j346668119;
	j346668119 [label="\"Er führt dich durch einen Korridor nach dem anderen. Er kennt den Asteroiden, wie seine Westentasche, jede Wache und ihre Routen.\"",shape=box,color=blue];
		j346668119 -> j1980218297;
		j346668119 -> j2046180856;
		j346668119 -> j1806509327;
	j1980218297 [label="Ich frage Zabir nach den Ratten.",shape=box,color=red];
		j1980218297 -> j2752092872;
	j2046180856 [label="Ist er auch ein Gefangener?",shape=box,color=red];
		j2046180856 -> j675440350;
	j1806509327 [label="Wohin führt Zabir mich?",shape=box,color=red];
		j1806509327 -> j2058787748;
	j2752092872 [label="\"Zabir ist schockiert. 'Die Ratten haben dich gefunden? Das ist unglaublich. Es hat funktioniert. Sieh her.' Zabir hält eine kunstvoll geprägte, goldene Pfeife in die Höhe. 'Die Rattenkönigin hat sie mir gegeben. Wir müssen sie finden.'\"",shape=box,color=blue];
		j2752092872 -> j2968155051;
	j675440350 [label="\"Du fragst Zabir, wie er herkam. 'Keine Zeit dafür', sagt er, 'wir müssen uns darauf konzentrieren, hier rauszukommen.'\"",shape=box,color=blue];
		j675440350 -> j1980218297;
		j675440350 -> j1806509327;
	j2058787748 [label="\"Zabir blickt zurück 'Ich führe dich zum Hangar. Wir stehlen ein Schiff und wir verschwinden von hier, so weit weg, wie möglich. Finde die Rattenkönigin.'\"",shape=box,color=blue];
		j2058787748 -> j2968155051;
	j2968155051 [label="RATTENKÖNIGIN?",shape=box,color=red];
		j2968155051 -> j374883191;
	j374883191 [label="\"'Sie hat mir diese Pfeife gegeben. Die Ratten hören darauf. Ich bin mit ihr befreundet. Sie ist nicht immer nett, aber sie kümmert sich.'\"",shape=box,color=blue];
		j374883191 -> j111140688;
		j374883191 -> j2825618823;
	j111140688 [label="Hast du Lettie diesen Teil schon mal gezeigt?",shape=box,color=red];
		j111140688 -> j4039311901;
	j2825618823 [label="Sie klingt auch sehr vertraut.",shape=box,color=red];
		j2825618823 -> j1113755544;
	j4039311901 [label="dafür schätze ich mein leben zu sehr",shape=box,color=blue];
		j4039311901 -> j2400392531;
	j1113755544 [label="jede ähnlichkeit mit realen oder imaginären personen ist rein zufällig",shape=box,color=blue];
		j1113755544 -> j2400392531;
	j2400392531 [label="\"Mit Zabirs Hilfe schlängelst du dich durch die Korridore des Asteroiden. Er weicht geschickt Wachen und Sicherheitskameras aus.\"",shape=box,color=blue];
		j2400392531 -> j954164589;
	j954164589 [label="\"Endlich kommt ihr zu einer großen Tür. Zabir gibt dir ein Zeichen, dich zu ducken. Duckend schleicht ihr beide in den Schiffshangar.\"",shape=box,color=blue];
		j954164589 -> j1147947135;
	j1147947135 [label="\"Ihr duckt euch in den Schatten einer Säule. Grineer Wachen reden in Hörreichweite.\"",shape=box,color=blue];
		j1147947135 -> j859194864;
	j859194864 [label="\"Was machst du?\"",shape=box,color=blue];
		j859194864 -> j614431370;
		j859194864 -> j2829488274;
	j614431370 [label="Ich greife die Wachen an.",shape=box,color=red];
		j614431370 -> j3791736850;
	j2829488274 [label="Mich umsehen.",shape=box,color=red];
		j2829488274 -> j2548893096;
	j3791736850 [label="\"Ohne einen Funken Selbsterhaltung oder Voraussicht rennst du ins Freie. Eine Gruppe Wachen auf der anderen Seite beginnt zu feuern. Du stürzt dich kopfüber in einen Kugelhagel, der dich sofort tötet. Zabir schüttelt den Kopf, über deinen Akt sturer Tapferkeit.\"",shape=box,color=blue];
		j3791736850 -> j3439285678;
	j2548893096 [label="\"You peek around the corner and survey the area.\"",shape=box,color=blue];
		j2548893096 -> j3099222458;
	j3439285678 [label="willst du es erneut versuchen und dich nicht sofort in den Tod stürzen?",shape=box,color=blue];
		j3439285678 -> j1645783330;
		j3439285678 -> j1078791804;
	j3099222458 [label="\"In der Mitte des Hangars steht ein Railjack. Die Rampe zum Inneren des Railjack wird von einer Wache versperrt. Auf der einen Seite des Hangars sind ein Dutzend Grineer laut mit einem Würfelspiel beschäftigt. Ein paar Meter entfernt ist ein Schreibtisch mit einer Kontrolltafel.\"",shape=box,color=blue];
		j3099222458 -> j3722840302;
	j1645783330 [label="Jupp.",shape=box,color=red];
		j1645783330 -> j1344899996;
	j1078791804 [label="Das reicht für heute. [Ende.]",shape=box,color=red];
		j1078791804 -> "Chat ends.";
	j3722840302 [label="\"'Um verschwinden zu können, müssen wir erst die Hangartore öffnen' fllüstert Zabir.\"",shape=box,color=blue];
		j3722840302 -> j3952278272;
	j1344899996 [label="\"Was machst du dieses Mal?\"",shape=box,color=blue];
		j1344899996 -> j197091657;
		j1344899996 -> j2829488274;
	j3952278272 [label="\"Zabir sieht dich an. 'Irgendwelche klugen Ideen?' \"",shape=box,color=blue];
		j3952278272 -> j774369477;
		j3952278272 -> j3952278272;
	j197091657 [label="... die Gegend erkunden?",shape=box,color=red];
