	j1079728742 [label="\"Eine leise Stimme in deinem Hinterkopf sagt: 'Hey, Arschloch, das ist deine letzte Chance. Du kannst dich immer noch nicht erinnern, wie du hierhergekommen bist. Hör auf, herumzueiern.‘'",shape=box,color=blue];
