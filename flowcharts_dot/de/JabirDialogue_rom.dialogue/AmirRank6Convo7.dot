	4268 [label="\"Du findest dich vor einem großen Service-Aufzug wieder. Dies ist kein einfacher Kerker?\"",shape=box,color=blue];
		4268 -> 4269;
		4268 -> 4270;
	4269 [label="Ich kehre zum Kerker zurück.",shape=box,color=red];
