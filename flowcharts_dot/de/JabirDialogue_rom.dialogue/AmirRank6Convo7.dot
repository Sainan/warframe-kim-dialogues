		4271 -> 4273;
	4272 [label="\"Du nimmst den Aufzug nach oben. Durch den offenen Käfig kannst du sehen, wie die Steinwände des Kerkers mehr und mehr durch fortschrittlichere Technologie ersetzt werden. Du fragst dich erneut 'Wo zur Hölle bin ich?' \"",shape=box,color=blue];
		4272 -> 4274;
	4273 [label="haha ... meinetwegen, ich nehm den Aufzug.",shape=box,color=red];
		4273 -> 4272;
	4274 [label="\"Der Aufzug öffnet sich in eine Halle mit gurgelnden Maschinen und riesigen Schläuchen. Ist dies eine Art Labor?\"",shape=box,color=blue];
		4274 -> 4275;
	4275 [label="Aus einem Raum am Ende des Ganges hörst du die Schmerzensschreie eines Mannes.",shape=box,color=blue];
		4275 -> 4276;
		4275 -> 4277;
	4276 [label="Ich ignoriere die Schreie und versuche, einen Ausweg zu finden.",shape=box,color=red];
		4276 -> 4278;
	4277 [label="Ich gehe zu dem schreienden Mann.",shape=box,color=red];
		4277 -> 4279;
	4278 [label="\"Du durchsuchst die Halle nach etwas Wertvollem, aber du kannst die Schreie nicht mehr ignorieren. Du wirst zu diesem Mann hingezogen und musst ihm helfen.\"",shape=box,color=blue];
		4278 -> 4279;
	4279 [label="\"Du gehst den Gang entlang zur Quelle der qualvollen Schreie. Du betrittst einen großen mechanischen Raum und siehst den Mann. Ein nicht unattraktiver Mann ist an eine Maschine angeschlossen. Blitzen tanzen aus seinen Fingern und speisen eine riesige Turbine.\"",shape=box,color=blue];
		4279 -> 4280;
		4279 -> 4281;
	4280 [label="Ich frage \"Was gibt's?\"",shape=box,color=red];
		4280 -> 4282;
	4281 [label="Ich untersuche den Mann.",shape=box,color=red];
		4281 -> 4282;
	4282 [label="\"Der Mann ist auf eine erhöhte Plattform geschnallt, mit ausgebreiteten Armen. Sonden sind an seine Fingerspitzen angeschlossen, deren Kabel sich zu einem schweren Messkabel verdrehen, dass zu der riesigen Turbine führt. Bögen aus Elektrizität tanzen über seine Hände.\"",shape=box,color=blue];
		4282 -> 4283;
	4283 [label="Zwischen Schreien und Stromschlägen bringt der Mann die Worte \"STOPP ... DIE ... TURBINEN!!\" hervor.",shape=box,color=blue];
		4283 -> 4284;
	4284 [label="Ich untersuche den Raum.",shape=box,color=red];
		4284 -> 4285;
