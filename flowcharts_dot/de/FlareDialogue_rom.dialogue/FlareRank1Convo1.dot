	7 [label="Das hängt davon ab, was sie dir gesagt haben. Aber ja, wahrscheinlich.",shape=box,color=red];
		7 -> 12;
	8 [label="Nichts Besseres zu tun, also dachtest du, du klopfst einfach mal an die Glasscheibe des Zoogeheges. Super.",shape=box,color=red];
