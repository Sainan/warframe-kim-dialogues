	j1129532648 [label="Hey, Arthur! Wie läuft es?",shape=box,color=red];
		j1129532648 -> j3223986077;
	j3189395404 [label="Was ist den Plan für heute?",shape=box,color=red];
		j3189395404 -> j1157346689;
	j3223986077 [label="Ich hatte die dumme Idee, mit Amir Ollies Crashkurs zu spielen.",shape=box,color=blue];
		j3223986077 -> j3415178348;
	j1157346689 [label="Quincy und ich gehen gleich gemeinsam auf Streife. Seine Idee, nicht meine.",shape=box,color=blue];
		j1157346689 -> j313238042;
	j3415178348 [label="Und jetzt bin ich zutiefst davon genervt, dass er ständig meinen Highscore schlägt.",shape=box,color=blue];
		j3415178348 -> j1909694831;
	j313238042 [label="Wir haben eine sehr seltsame Beziehung. Wir reden nicht viel.",shape=box,color=blue];
		j313238042 -> j628464930;
	j1909694831 [label="... in den letzten zwei Tagen habe ich sechsundzwanzig Stunden dieses Spiel gespielt.",shape=box,color=blue];
		j1909694831 -> j426820914;
	j628464930 [label="Aber wir wissen beide, dass wir füreinander sterben würden, wenn es drauf ankäme.",shape=box,color=blue];
		j628464930 -> j3617090329;
	j426820914 [label="Bitte, sag Lettie sie soll mich betäuben, wenn ich mich diesem verdammten Ding wieder nähere.",shape=box,color=blue];
		j426820914 -> "Chat ends.";
	j3617090329 [label="Ich schätze, das ist halt Familie.",shape=box,color=blue];
		j3617090329 -> "Chat ends.";
	"Chat ends." [color=orange];
