digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo4 begins." [color=orange];
		"ArthurRank6Convo4 begins." -> j2294563802;
	j2294563802 [label="Seltsame Frage. Gibt es im Weltraum Spielzeuge?",shape=box,color=blue];
		j2294563802 -> j124905303;
		j2294563802 -> j2208989381;
	j124905303 [label="Du meinst Kinderspielzeug? Natürlich.",shape=box,color=red];
		j124905303 -> j2415258493;
	j2208989381 [label="Was ... für eine Art Spielzeug?",shape=box,color=red];
		j2208989381 -> j110051141;
	j2415258493 [label="Heh. Wirklich?",shape=box,color=blue];
		j2415258493 -> j1831254826;
	j110051141 [label="OH BEI SOL. Das ist nicht was ich meine und du weißt das!",shape=box,color=blue];
		j110051141 -> j1373266074;
	j1831254826 [label="Schwer vorstellbar, dass es das in ein paar tausend Jahre in der Zukunft noch gibt.",shape=box,color=blue];
		j1831254826 -> j73407147;
	j1373266074 [label="Ich meine Kinderspielzeug. Puppen. Actionfiguren. Sowas in der Art.",shape=box,color=blue];
		j1373266074 -> j2159325526;
		j1373266074 -> j2241092975;
	j73407147 [label="Sitzen die Kinder immer noch da und spielen mit kleinen Figuren Geschichten nach und spielen sie noch \"Banditen\" oder \"Rette die Prinzessin\"?",shape=box,color=blue];
		j73407147 -> j3183257579;
		j73407147 -> j3361239917;
		j73407147 -> j630981101;
	j2159325526 [label="Wollte dich nur ein wenig ärgern. :P",shape=box,color=red];
		j2159325526 -> j1956348995;
	j2241092975 [label="Nein, gibt es nicht. [End.]",shape=box,color=red];
		j2241092975 -> "Chat ends.";
	j3183257579 [label="Wie kommst du auf das Thema?",shape=box,color=red];
		j3183257579 -> j1008006948;
	j3361239917 [label="Womit hast du als Kind gespielt?",shape=box,color=red];
		j3361239917 -> j1512230901;
	j630981101 [label="Die Namen haben sich für unsere Spiele geändert, aber wir hatten auf jeden Fall Spielzeuge.",shape=box,color=red];
		j630981101 -> j283912794;
	j1956348995 [label="Ja, klar haben wir Spielzeug.",shape=box,color=red];
		j1956348995 -> j2415258493;
	"Chat ends." [color=orange];
	j1008006948 [label="Ich hab Amir beim Spielen seiner Arcade-Spiele zugesehen.",shape=box,color=blue];
		j1008006948 -> j3411258395;
	j1512230901 [label="Es ist irgendwie schon beruhigend, dass trotz der Unterschiede in unseren Kulturen, Kinder immer noch einfach ... dasitzen und mit Spielzeug spielen.",shape=box,color=blue];
		j1512230901 -> j2645939624;
	j283912794 [label="Zum Beispiel?",shape=box,color=blue];
		j283912794 -> j2247438545;
		j283912794 -> j2232277570;
	j3411258395 [label="Und ich hab mich gefragt - was würdest du nicht dafür geben, wieder eine solch eine Art Freude in meinen Leben spüren zu können.",shape=box,color=blue];
		j3411258395 -> j1574538824;
	j2645939624 [label="Ich hatte diese Actionfigur. Action Angus. Er war ein Soldat, keine große Überraschung.",shape=box,color=blue];
		j2645939624 -> j3167725425;
	j2247438545 [label="Jede Menge Figuren, Stofftiere und Bauklötze. Typische Dinge für Kinder. ",shape=box,color=red];
		j2247438545 -> j1512230901;
	j2232277570 [label="Ich hatte diese eine - ich schätze, man könnte es Figur nennen - von diesem Dax-Kind, und, naja, ich hab ihn nach einem Charakter aus einem meiner Bücher benannt. Dominus Thrax.",shape=box,color=red];
		j2232277570 -> j1702984217;
	j1574538824 [label="Ich habe nie auf Aoi, Amir oder jetzt auch Kaya herabgesehen, weil sie Spaß an \"kindischen\" Dingen finden. Es hat mich nie gestört.",shape=box,color=blue];
		j1574538824 -> j613892555;
	j3167725425 [label="Bei einer Sonnenwendfeier haben mir ein paar ältere Jungs die Figur, zusammen mit einem Haufen meiner anderen Spielsachen, gestohlen und, naja ...",shape=box,color=blue];
		j3167725425 -> j3008654443;
	j1702984217 [label="Oh, verdammt. Ich hätte es wissen sollen. Es tut mir so leid, dass ich es angesprochen habe.",shape=box,color=blue];
		j1702984217 -> j3706363560;
		j1702984217 -> j124001456;
	j613892555 [label="Aber manchmal hab ich Angst, dass der Teil von mir, der dieses Gefühl verspüren konnte, sich vor langer Zeit zusammengerollt und gestorben ist.",shape=box,color=blue];
		j613892555 -> j1396449706;
	j3008654443 [label="Es ist eine lange Geschichte. Um es kurz zu machen, mir wurde gesagt, ich sei \"zu alt\" um noch mit Puppen zu spielen. Das war das letzte Mal, dass ich mit Spielzeug gespielt habe.",shape=box,color=blue];
		j3008654443 -> j727175889;
	j3706363560 [label="Nicht unbedingt mein liebstes Diskussionsthema, nein.",shape=box,color=red];
		j3706363560 -> j3542763379;
	j124001456 [label="Ist schon okay. Nicht deine Schuld.",shape=box,color=red];
		j124001456 -> j2022158699;
	j1396449706 [label="Irgendwie traurig, oder? Dass wir Kindern sagen, so sollen etwas lieben und dann sagen wir ihnen, sie müssen es aufgaben, weil sie \"erwachsener\" geworden sind.",shape=box,color=blue];
		j1396449706 -> j695575044;
		j1396449706 -> j3352040452;
	j727175889 [label="Neulich habe ich Amir bei einem seiner Spiele zugesehen. Man merkt, wie sehr er daran hängt. Wie viel Freude es ihm macht. Und ich war ein bisschen neidisch, dass ich so etwas nicht in meinem Leben habe.",shape=box,color=blue];
		j727175889 -> j1396449706;
	j3542763379 [label="Jetzt fühl ich mich wie ein absoluter Vollidiot.",shape=box,color=blue];
		j3542763379 -> "Chat ends.";
	j2022158699 [label="Wir hatten all die normalen Spielsachen, die man erwarten würde: Bauklötze, Stofftiere, Figuren, Puppen.",shape=box,color=red];
		j2022158699 -> j4102275456;
	j695575044 [label="Ich weiß nicht. Wir müssen alle irgendwann erwachsen werden. Wir können uns nicht immer hinter Vorstellungen und Fantasie verstecken. Ich habe es auf die harte Tour gelernt.",shape=box,color=red];
		j695575044 -> j796731406;
	j3352040452 [label="Ich denke, das Leben kann hässlich und schwer sein und so kurz. Wir sollten es mit so viel Freude und Spaß und Lachen füllen, wie nur möglich.",shape=box,color=red];
		j3352040452 -> j1588010906;
	j4102275456 [label="Meins wurde nur ein wenig problematischer nach der ganzen ... Void-Geschichte.",shape=box,color=red];
		j4102275456 -> j1512230901;
	j796731406 [label="Fairer Punkt. Ich denke, wenn es die Realität ersetzt, dann ist es ein Problem. Aber davon rede ich nicht.",shape=box,color=blue];
		j796731406 -> j1137194543;
	j1588010906 [label="Du hast Recht. Und ich hoffe, wir werden uns daran erinnern, wenn von hieraus weitergehen ... was auch immer das hier ist.",shape=box,color=blue];
		j1588010906 -> j1137194543;
	j1137194543 [label="Weißt du, ich hab Eleanor, Velimier, Aoi und Amir gefunden, wie sie mit Flare und Lizzie verstecken gespielt haben. (Quincy sagte, er durfte nicht mitmachen. Der Bastard hat geschummelt und sein Zielfernrohr dazu genutzt hat, sie durch Wände hindurch zu entdecken)",shape=box,color=blue];
		j1137194543 -> j1349126818;
	j1349126818 [label="Sie haben mich all ganz besorgt angeschaut, besorgt, dass ich sauer wäre, weil ich sie beim Herumalbern erwischt hab, obwohl sie etwas Nützliches hätten tun können.",shape=box,color=blue];
		j1349126818 -> j3815612119;
	j3815612119 [label="Ich war eher darüber enttäuscht, dass ich nicht eingeladen war. Aber ich musste wieder das Gesicht des mürrischen Anführers aufsetzen und so tun, als wäre ich verärgert, dass sie nicht auf ihren Posten waren, usw.",shape=box,color=blue];
		j3815612119 -> j1592402291;
	j1592402291 [label="Aber Amir hat seine Spiele. Aoi hat On-lyne. Selbst Kya hat ihre Sticker und Jinymon, obwohl die Welt sie viel zu früh dazu gezwungen hat, erwachsen zu werden.",shape=box,color=blue];
		j1592402291 -> j1692229646;
		j1592402291 -> j447139768;
	j1692229646 [label="Gibt es einen genauen Punkt, auf den du hinausmöchtest?",shape=box,color=red];
		j1692229646 -> j3209852628;
	j447139768 [label="Ich glaube, dass man es zurückgewinnen kann, wenn du es versuchst. Freude in Spielzeug und Spielen zu finde, meine ich.",shape=box,color=red];
		j447139768 -> j1586672644;
	j3209852628 [label="Ganz ehrlich? Ich bin mir nicht mal sicher. Nur, dass ich mich fühle, als würde mir etwas fehlen, dass ich schon lange nicht mehr in meinem Leben hatte.",shape=box,color=blue];
		j3209852628 -> j6985641;
	j1586672644 [label="Ich kann jetzt schon das Lachen hören. Aber ich schätze, das ist wirklich das, was mich zurückhält, oder? Scham.",shape=box,color=blue];
		j1586672644 -> j3784542738;
	j6985641 [label="Ich weiß nicht, ob ich es je zurückbekommen kann. Oder ob es dafür schon zu spät ist. Aber wer weiß es schon. Mit genug Zeit ist vielleicht alles möglich.",shape=box,color=blue];
		j6985641 -> "Chat ends.";
	j3784542738 [label="Ich bin mir nicht sicher, ob es möglich ist, das zurückzubekommen, selbst wenn ich den Moment der Scham überwinden könnte. Aber wer weiß es schon. Mit ausreichend Zeitschleifen ist vielleicht alles möglich.",shape=box,color=blue];
		j3784542738 -> "Chat ends.";
}