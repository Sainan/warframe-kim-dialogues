digraph {
	3360 [label="ArthurRank6Convo3 begins.",color=orange];
		3360 -> 3361;
	3361 [label="Ich hab mich dabei ertappt, wie ich letztens eine Unterhaltung mit der Gitarre hatte.",shape=box,color=blue];
		3361 -> 3362;
		3361 -> 3363;
	3362 [label="Ich persönlich bin kein großer Fan.",shape=box,color=red];
		3362 -> 3364;
	3363 [label="Lizzie? Und, wie ist es gelaufen?",shape=box,color=red];
		3363 -> 3365;
	3364 [label="Ganz ehrlich? Ich mag sie. Sobald man die ... Eigenartigkeit der ganzen Sache überwunden hat.",shape=box,color=blue];
		3364 -> 3366;
	3365 [label="Besser als ich es erwartet hatte. Ich mag sie.",shape=box,color=blue];
		3365 -> 3366;
	3366 [label="Naja,",shape=box,color=blue];
		3366 -> 3367;
	3367 [label="Da sie und Eleanor immer über Witze zu lachen scheinen, die sonst keiner hören kann",shape=box,color=blue];
		3367 -> 3368;
	3368 [label="Dachte mir, dass ich mich vernünftig vorstellen sollte.",shape=box,color=blue];
		3368 -> 3369;
	3369 [label="Sie hat viele nützliche Einblicke. Und Flare ist reizend. Ehrlich gesagt, das ganze Rudel an der Bar ist eine erfrischende Abwechslung. ",shape=box,color=blue];
		3369 -> 3370;
	3370 [label="Also. Ich meine im übertragenden Sinne.",shape=box,color=blue];
		3370 -> 3371;
		3370 -> 3372;
		3370 -> 3373;
	3371 [label="Schon die Nase voll von den Hex?",shape=box,color=red];
		3371 -> 3374;
	3372 [label="Welche Erkenntnisse hatte sie?",shape=box,color=red];
		3372 -> 3375;
	3373 [label="Freut mich, dass du Freunde findest, lol.",shape=box,color=red];
		3373 -> 3376;
	3374 [label="Was? Nein, natürlich nicht!",shape=box,color=blue];
		3374 -> 3377;
	3375 [label="Faszinierende, in Bezug auf wie viele Male sich dieses Jahr bereits wiederholt hat.",shape=box,color=blue];
		3375 -> 3378;
	3376 [label="Ich schätze, es einfach Leute zu haben, mit denen man reden kann und mit denen man noch nicht so viel durchlebt hat.",shape=box,color=blue];
		3376 -> 3379;
	3377 [label="Die Hex sind meine Familie. Mein Team. Das weißt du.",shape=box,color=blue];
		3377 -> 3376;
	3378 [label="Wie viele Male ich das Jahr bereits eventuell vergessen habe. Wie sie ... außerhalb der Zeit existiert? Und wir nicht.",shape=box,color=blue];
		3378 -> 3380;
	3379 [label="Ich weiß nicht, ob das irgendwie Sinn ergibt. Ich kenne sie. Ich vertraue ihnen, ich bin nur noch nicht mit ihnen *durch die Hölle* gegangen.",shape=box,color=blue];
		3379 -> 3381;
	3380 [label="Und bevor du was sagst, nein. Ich will es nicht wissen. Ich habe kein Recht dazu.",shape=box,color=blue];
		3380 -> 3382;
	3381 [label="Und das macht es manchmal einfach leichter, sich einfach zusammen hinzusetzen und mit ihnen zu reden.",shape=box,color=blue];
		3381 -> 3383;
		3381 -> 3384;
		3381 -> 3385;
	3382 [label="Ich schätze, ich wollte nur sagen - ob du es hast, oder nicht. Es ist okay. Und ich werde es dir nicht vorhalten.",shape=box,color=blue];
		3382 -> 3386;
	3383 [label="Ich hatte die Option nie wirklich.",shape=box,color=red];
		3383 -> 3387;
	3384 [label="Ja, das kann ich verstehen.",shape=box,color=red];
		3384 -> 3388;
	3385 [label="Und es hilft auch ein wenig, dass einige von ihnen etwas älter sind und Erfahrungen mit dem Militär haben.",shape=box,color=red];
		3385 -> 3389;
	3386 [label="Diese Situation, in der wir uns befinden? Sie ist nicht normal. Wir sind für so etwas nicht gemacht - wir Menschen, meine ich.",shape=box,color=blue];
		3386 -> 3390;
	3387 [label="Ich schätze nicht.",shape=box,color=blue];
		3387 -> 3391;
	3388 [label="Es gibt nicht so viel ... Belastung. So viel Vergangenheit zwischen uns. Amir würde es Ballast nennen.",shape=box,color=blue];
		3388 -> 3391;
	3389 [label="Bei Sol. Ja, das tut es. Ich war mir erst nicht sicher, was ich von den Libertaniern halten sollte. Aber jetzt? Jetzt bin ich ganz froh, dass sie hier sind.",shape=box,color=blue];
		3389 -> 3391;
	3390 [label="Es gibt keine Anleitung dafür. Egal, für was du dich entscheidest, ich vertraue darauf, dass du einen guten Grund dafür hattest.",shape=box,color=blue];
		3390 -> 3392;
	3391 [label="Aber das alles hat mich zum Nachdenken gebracht.",shape=box,color=blue];
		3391 -> 3393;
		3391 -> 3394;
	3392 [label="Check boolean ArthurDating",color=orange];
		3392 -> 3396 [label=true,color=green];
		3392 -> 3395 [label=false,color=brown];
	3393 [label="Oh oh.",shape=box,color=red];
		3393 -> 3397;
	3394 [label="Über was?",shape=box,color=red];
		3394 -> 3398;
	3396 [label="Ich liebe dich. Und selbst wenn ich das vergesse? Selbst, wenn du dich entscheidest, einen anderen Weg zu gehen? Das ist okay.",shape=box,color=blue];
		3396 -> 3400;
	3395 [label="Ich vertraue dir mein Leben an. Und nichts wird das ändern. Selbst wenn ich es für kurze Zeit vergesse.",shape=box,color=blue];
		3395 -> 3399;
	3397 [label="Heh. Lass mich ausreden. Aber es geht um dich.",shape=box,color=blue];
		3397 -> 3401;
	3398 [label="Dich. ",shape=box,color=blue];
		3398 -> 3401;
	3400 [label="Bevor du hergekommen bist, hätte ich das glaube ich nicht akzeptieren können. Ich hätte eine solche Angst gehabt, dich zu verlieren. Uns zu verlieren.",shape=box,color=blue];
		3400 -> 3402;
	3399 [label="Bevor du hergekommen bist, hätte ich das glaube ich nicht akzeptieren können. Ich hätte eine solche Angst gehabt, einen Teil von mir zu verlieren.",shape=box,color=blue];
		3399 -> 3402;
	3401 [label="Und diese ganze ... Zeitschleife. Und ich hab mich gefragt, an wie viele 1999er ich mich nicht erinnern kann.",shape=box,color=blue];
		3401 -> 3403;
		3401 -> 3404;
		3401 -> 3405;
	3402 [label="Ich hätte mich wie ein Schiffbrüchiger an dem Floß festgeklammert. Aber vielleicht bin ich diese Schlaufe nun oft genug durchlaufen, oder ... vielleicht liegt es einfach an dir, ich weiß es nicht.",shape=box,color=blue];
		3402 -> 3406;
	3403 [label="Was auch immer die Gitarre dir erzählt hat, ist Verleumdung, das schwöre ich.",shape=box,color=red];
		3403 -> 3407;
	3404 [label="Bin ich in Schwierigkeiten?",shape=box,color=red];
		3404 -> 3407;
	3405 [label="Ich ... glaube nicht, dass wir darauf eingehen sollten, Arthur.",shape=box,color=red];
		3405 -> 3407;
	3406 [label="Diese Zufriedenheit, die du mir jetzt gibst - dieser Frieden - ist in diesem Moment mehr wert, als zu wissen, dass es ewig währen könnte.",shape=box,color=blue];
		3406 -> 3408;
	3407 [label="Warte einfach kurz, ja? Du weißt, dass ich nicht so schnell tippe, wie du.",shape=box,color=blue];
		3407 -> 3409;
	3408 [label="Wenn ich eine Sache als Soldat gelernt habe, dann das alles vergänglich ist.",shape=box,color=blue];
		3408 -> 3410;
	3409 [label="Was ich sagen wollte, ist:",shape=box,color=blue];
		3409 -> 3411;
	3410 [label="In einem Moment da und im nächsten einfach weg. Ich schätze, ich hab es jetzt einfach akzeptiert. Ein für alle Mal.",shape=box,color=blue];
		3410 -> 3412;
	3411 [label="Ob du mich oder die anderen Hex vergangene Interaktionen hast vergessen lassen? Es ist okay.",shape=box,color=blue];
		3411 -> 3413;
	3412 [label="Also, egal ob unsere gemeinsame Zeit endet, weil du auf den Boden schlägst, oder ich alles vergesse?",shape=box,color=blue];
		3412 -> 3414;
	3413 [label="Ich nehme es dir nicht übel.",shape=box,color=blue];
		3413 -> 3386;
	3414 [label="Oder weil die Gleichgültigkeit dich eines Tages überrascht?",shape=box,color=blue];
		3414 -> 3415;
	3415 [label="Ich werde den Moment genießen, den ich hab. Hier und jetzt. Denn ist, was ich momentan habe.",shape=box,color=blue];
		3415 -> 3416;
	3416 [label="Und das ist es, worauf ich mich verlassen kann.",shape=box,color=blue];
		3416 -> 3417;
		3416 -> 3418;
		3416 -> 3419;
	3417 [label="Es ist nichts Persönliches. Es liegt hauptsächlich daran, dass ich es immer wieder vermassle, mit deiner Schwester auszugehen. :P",shape=box,color=red];
		3417 -> 3420;
	3418 [label="Danke Arthur ... Das bedeutet mir mehr, als ich vernünftig in Worte fassen könnte.",shape=box,color=red];
		3418 -> 3421;
	3419 [label="Manchmal wünschte ich, ich hätte deine Besonnenheit. <3",shape=box,color=red];
		3419 -> 3422;
	3420 [label="Ha ha. Nun, es ist gut, dass du über magische Superkräfte verfügst, mit der du die Hand entfernen kannst, die du dir so mächtig tief in den Hals steckst, oder?",shape=box,color=blue];
		3420 -> 3423;
	3421 [label="Ab und an versuche ich, mir den Stock lang genug aus dem Arsch zu ziehen, um etwas Bedeutungsvolles zu sagen.",shape=box,color=blue];
		3421 -> 3424;
	3422 [label="Das liegt mehr daran, dass ich weiß, dass ich praktische keine Wahl hab, außer die Zähne zusammenzubeißen. Das ist der britannische Weg. ",shape=box,color=blue];
		3422 -> 3425;
	3423 [label="Der Rest von uns muss einfach lernen, wie man kommuniziert. Allerdings hab ich eine Frage.",shape=box,color=blue];
		3423 -> 3426;
	3424 [label="Nun, ich denke, es ist Zeit für einen Drink. Sollen wir?",shape=box,color=blue];
		3424 -> 3427;
		3424 -> 3428;
	3425 [label="Wie das alte Sprichwort sagt: \"Ruhe bewahren und weitermachen.\"",shape=box,color=blue];
		3425 -> 3424;
	3426 [label="Senkt sie ihre Ansprüche mit jeder neuen Schleife?",shape=box,color=blue];
		3426 -> 3429;
	3427 [label="Später vielleicht.",shape=box,color=red];
		3427 -> 3430;
	3428 [label="Ich seh dich dort. :)",shape=box,color=red];
		3428 -> 3431;
	3429 [label="Chat ends.",color=orange];
	3430 [label="Wie du willst.",shape=box,color=blue];
		3430 -> 3432;
	3431 [label="Chat ends.",color=orange];
	3432 [label="Chat ends.",color=orange];
}