digraph {
	3555 [label="ArthurRank6Convo9 begins.",color=orange];
		3555 -> 3556;
	3556 [label="Ich weiß nicht, was ich von diesen ... Befallenen Waffen denken soll, die Eleanor sammelt.",shape=box,color=blue];
		3556 -> 3557;
		3556 -> 3558;
	3557 [label="Warum?",shape=box,color=red];
		3557 -> 3559;
	3558 [label="Wenigstens reden sie nicht.",shape=box,color=red];
		3558 -> 3560;
	3559 [label="Du meinst davon abgesehen, dass ich glaube, dass sie mit ihnen reden kann?",shape=box,color=blue];
		3559 -> 3561;
	3560 [label="Mit *uns*. Ich bin mir nicht sicher, ob sie nicht mit *ihr* reden.",shape=box,color=blue];
		3560 -> 3561;
	3561 [label="Ich weiß, dass sie mit der Gitarre sprechen. Worüber ich wirklich nicht genauer nachdenken möchte, als ich muss.",shape=box,color=blue];
		3561 -> 3562;
	3562 [label="Aber sollten wir uns Sorgen darüber machen, dass sie sich ... ausbreiten? Sie scheinen sich zu vermehren.",shape=box,color=blue];
		3562 -> 3563;
	3563 [label="Was ich nicht verstehe. Und ich möchte auch nicht zu genau darüber nachdenken, wo ihre Munition herkommt. Oder woraus sie überhaupt bestehen.",shape=box,color=blue];
		3563 -> 3564;
		3563 -> 3565;
	3564 [label="Immerhin sind diese Befallenen Dinger auf unserer Seite?",shape=box,color=red];
		3564 -> 3566;
	3565 [label="Vielleicht solltest du lieber bei normalen Waffen bleiben.",shape=box,color=red];
		3565 -> 3567;
	3566 [label="Klar. *Noch*.",shape=box,color=blue];
		3566 -> 3568;
	3567 [label="Ja, ich denke, dass werde ich.",shape=box,color=blue];
		3567 -> 3568;
	3568 [label="Wenigstens weiß ich, dass ich der Idiot bin, der sich mit der Sekundärwaffe in den Fuß geschossen hat.",shape=box,color=blue];
		3568 -> 3569;
	3569 [label="Und dass es nicht meine Waffe ist, die sich dazu entschlossen hat, ihre Loyalität zu hinterfragen oder von nächtlichem Heißhunger überkommen wird.",shape=box,color=blue];
		3569 -> 3570;
	3570 [label="Chat ends.",color=orange];
}