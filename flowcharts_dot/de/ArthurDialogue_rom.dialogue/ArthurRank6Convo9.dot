digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo9 begins." [color=orange];
		"ArthurRank6Convo9 begins." -> j2375262100;
	j2375262100 [label="Ich weiß nicht, was ich von diesen ... Befallenen Waffen denken soll, die Eleanor sammelt.",shape=box,color=blue];
		j2375262100 -> j1939934531;
		j2375262100 -> j831204257;
	j1939934531 [label="Warum?",shape=box,color=red];
		j1939934531 -> j598283557;
	j831204257 [label="Wenigstens reden sie nicht.",shape=box,color=red];
		j831204257 -> j3143282188;
	j598283557 [label="Du meinst davon abgesehen, dass ich glaube, dass sie mit ihnen reden kann?",shape=box,color=blue];
		j598283557 -> j2527675923;
	j3143282188 [label="Mit *uns*. Ich bin mir nicht sicher, ob sie nicht mit *ihr* reden.",shape=box,color=blue];
		j3143282188 -> j2527675923;
	j2527675923 [label="Ich weiß, dass sie mit der Gitarre sprechen. Worüber ich wirklich nicht genauer nachdenken möchte, als ich muss.",shape=box,color=blue];
		j2527675923 -> j1928310887;
	j1928310887 [label="Aber sollten wir uns Sorgen darüber machen, dass sie sich ... ausbreiten? Sie scheinen sich zu vermehren.",shape=box,color=blue];
		j1928310887 -> j4027322995;
	j4027322995 [label="Was ich nicht verstehe. Und ich möchte auch nicht zu genau darüber nachdenken, wo ihre Munition herkommt. Oder woraus sie überhaupt bestehen.",shape=box,color=blue];
		j4027322995 -> j2653392172;
		j4027322995 -> j1621703142;
	j2653392172 [label="Immerhin sind diese Befallenen Dinger auf unserer Seite?",shape=box,color=red];
		j2653392172 -> j752380618;
	j1621703142 [label="Vielleicht solltest du lieber bei normalen Waffen bleiben.",shape=box,color=red];
		j1621703142 -> j310866673;
	j752380618 [label="Klar. *Noch*.",shape=box,color=blue];
		j752380618 -> j1235590212;
	j310866673 [label="Ja, ich denke, dass werde ich.",shape=box,color=blue];
		j310866673 -> j1235590212;
	j1235590212 [label="Wenigstens weiß ich, dass ich der Idiot bin, der sich mit der Sekundärwaffe in den Fuß geschossen hat.",shape=box,color=blue];
		j1235590212 -> j2255528116;
	j2255528116 [label="Und dass es nicht meine Waffe ist, die sich dazu entschlossen hat, ihre Loyalität zu hinterfragen oder von nächtlichem Heißhunger überkommen wird.",shape=box,color=blue];
		j2255528116 -> "Chat ends.";
	"Chat ends." [color=orange];
}