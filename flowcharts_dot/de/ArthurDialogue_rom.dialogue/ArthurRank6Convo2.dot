digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo2 begins." [color=orange];
		"ArthurRank6Convo2 begins." -> j2296558676;
	j2296558676 [label="Ich hab nachgedacht. Wie viele von uns, denkst du, gibt es da draußen?",shape=box,color=blue];
		j2296558676 -> j2968958156;
		j2296558676 -> j194550865;
	j2968958156 [label="Meinst du hier in 1999 oder generell?",shape=box,color=red];
		j2968958156 -> j3360491680;
	j194550865 [label="Was meinst du mit \"uns\"?",shape=box,color=red];
		j194550865 -> j2867615492;
	j3360491680 [label="Beides, würde ich sagen. Hier, jetzt, in der Vergangenheit - in der Zukunft.",shape=box,color=blue];
		j3360491680 -> j4041284231;
	j2867615492 [label="Protoframes. Hier, oder anderswo. Oder irgend*wann*, schätze ich.",shape=box,color=blue];
		j2867615492 -> j4041284231;
	j4041284231 [label="Entrati hat uns für einen Zweck erschaffen. Mehrere Zwecke. Es ist klar, dass es über uns sechs hinausging. ",shape=box,color=blue];
		j4041284231 -> j913694857;
		j4041284231 -> j2422008648;
	j913694857 [label="Erst dachte ich, dass er mir \"Ersatz\"-Warframes erschaffen hat, für den Fall, dass meine nicht durch den Helminth mitkommen würden. Jetzt bin ich mir nicht mehr so sicher.",shape=box,color=red];
		j913694857 -> j1019256887;
	j2422008648 [label="Ich wünschte, ich wüsste, was er vorhat. Oder was seine wirklichen Gründe hinter der Erschaffung weiterer Protoframes war.",shape=box,color=red];
		j2422008648 -> j729715005;
	j1019256887 [label="Das hat Sinn gemacht, als es nur wir sechs waren.",shape=box,color=blue];
		j1019256887 -> j729715005;
	j729715005 [label="Denkst du wirklich, dass das Aufhalten der Gleichgültigkeit sein wahres Vorhaben ist?",shape=box,color=blue];
		j729715005 -> j1596947987;
	j1596947987 [label="Können wir im *wirklich* trauen?",shape=box,color=blue];
		j1596947987 -> j3818186886;
		j1596947987 -> j2721705863;
		j1596947987 -> j2869820793;
	j3818186886 [label="Ganz ehrlich, ich weiß es nicht. Es vertraue ihm, soweit ich ihn werfen kann. Und ohne einen Warframe ist mein Wurfarm echt beschissen.",shape=box,color=red];
		j3818186886 -> j1434502464;
	j2721705863 [label="Nein. Wir können seinen Motiven ebenso wenig vertrauen wie seinen Methoden.",shape=box,color=red];
		j2721705863 -> j3811023798;
		j2721705863 -> j3180659996;
	j2869820793 [label="Ja. Ich stimme seinen Methoden nicht immer zu, aber ja. Er will das Ding aufhalten.",shape=box,color=red];
		j2869820793 -> j3180659996;
		j2869820793 -> j3811023798;
	j1434502464 [label="+5 Chemistry",color=orange];
		j1434502464 -> j4116031178;
	j3811023798 [label="Er versucht, den Geist wieder in die sprichwörtliche Flasche zu bekommen, wenn das denn möglich ist. Aber es ist ein schmutziger Prozess.",shape=box,color=red];
		j3811023798 -> j3170674138;
	j3180659996 [label="Aber wir haben nicht wirklich eine Wahl, oder? Das Kind und ich, alles, was wir tun können ist ihm zu folgen und hinter ihm aufzuräumen. ",shape=box,color=red];
		j3180659996 -> j1467516526;
		j3180659996 -> j330191724;
	j4116031178 [label="Heh.",shape=box,color=blue];
		j4116031178 -> j3811023798;
		j4116031178 -> j3180659996;
	j3170674138 [label="Und wir sind also die Hausmeister, die hinter ihm den Boden schrubben. Fantastisch.",shape=box,color=blue];
		j3170674138 -> j1467516526;
		j3170674138 -> j330191724;
	j1467516526 [label="Jetzt wo Kaya ihre eigene Version der Zeitreise hinbekommen hat, wird es für mich vielleicht einfacher, hin und her zu reisen.",shape=box,color=red];
		j1467516526 -> j1334812169;
	j330191724 [label="Aber ich bleibe hier, also liegt es jetzt am Kind.",shape=box,color=red];
		j330191724 -> j161265069;
	j1334812169 [label="Das Mädel kann schon eine ziemliche Nervensäge sein, aber das weiß ich zu schätzen.",shape=box,color=blue];
		j1334812169 -> j483767437;
	j161265069 [label="Check boolean ArthurDating",color=orange];
		j161265069 -> j3703214374 [label=true,color=green];
		j161265069 -> j709648634 [label=false,color=brown];
	j483767437 [label="Es ist gut zu wissen, dass, wenn du mal wieder abhaust ... du tatsächlich, möglicherweise zurückkommst ... :/",shape=box,color=blue];
		j483767437 -> j2613732724;
	j3703214374 [label="Nah. Wir werden's sehen. Ich kenn dich gut genug, Schatz. Und ich weiß, dass du nicht weißt, wann du den Kopf einziehen solltest.",shape=box,color=blue];
		j3703214374 -> j971147098;
	j709648634 [label="Nah. Wir werden's sehen. Ich kenn dich gut genug, Drifter. Und ich weiß, dass du nicht weißt, wann du den Kopf einziehen solltest.",shape=box,color=blue];
		j709648634 -> j1040330610;
	j2613732724 [label="Check boolean ArthurDating",color=orange];
		j2613732724 -> j1268562756 [label=true,color=green];
		j2613732724 -> j2910041084 [label=false,color=brown];
		j2613732724 -> j1355310035 [label=false,color=brown];
	j971147098 [label="Das ist einer der Gründe, warum ich so sehr ihn dich vernarrt bin. ;)",shape=box,color=blue];
		j971147098 -> j1355310035;
	j1040330610 [label="Das ist einer der Gründe, warum ich dich ertrage. ;)",shape=box,color=blue];
		j1040330610 -> j2910041084;
	j1268562756 [label="Ich schulde ihr viel, dass sie mir ein gewisses Maß an Frieden geben kann. :)",shape=box,color=blue];
		j1268562756 -> j2910041084;
		j1268562756 -> j1355310035;
	j2910041084 [label="Ein Emoticon! :D",shape=box,color=red];
		j2910041084 -> j1630403535;
	j1355310035 [label="Jetzt werde bloß nicht weich.",shape=box,color=red];
		j1355310035 -> j2322732175;
	j1630403535 [label="Ja, ja. Gewöhn dich nicht daran. Es fühlt sich immer noch komisch an.",shape=box,color=blue];
		j1630403535 -> j1392255050;
	j2322732175 [label="Mhm, du kennst mich. Harte Schale, weicher Kern. Wie eine dieser abgestandenen Backwaren, von denen Amir und Velimir ständig reden.",shape=box,color=blue];
		j2322732175 -> j2601463310;
	j1392255050 [label="Nun, ich fühle mich geschmeichelt.",shape=box,color=red];
		j1392255050 -> j2275971723;
	j2601463310 [label="Tweebies?",shape=box,color=blue];
		j2601463310 -> j2275971723;
	j2275971723 [label="Also. Zurück zum Thema. Manchmal habe ich dieses ungute Gefühl, dass Entrati für uns alle noch einen weiteren, höheren Zweck geplant hat.",shape=box,color=blue];
		j2275971723 -> j413976630;
		j2275971723 -> j3886192833;
		j2275971723 -> j1169200507;
	j413976630 [label="Wie kommst du darauf?",shape=box,color=red];
		j413976630 -> j256901192;
	j3886192833 [label="Ja, da könntest du recht haben.",shape=box,color=red];
		j3886192833 -> j2745412329;
	j1169200507 [label="Könnte das nur Wunschdenken sein?",shape=box,color=red];
		j1169200507 -> j4218841788;
	j256901192 [label="Die ganze Mühe, die er sich bei unserer Erschaffung gemacht hat? Und der Fakt, dass es mehr gibt, als nur uns sechs ...",shape=box,color=blue];
		j256901192 -> j2528064725;
	j2745412329 [label="Was denkst du, ist es? Und worauf wartet er?",shape=box,color=blue];
		j2745412329 -> j39260727;
		j2745412329 -> j3702189970;
	j4218841788 [label="Wie meinst du das?",shape=box,color=blue];
		j4218841788 -> j2735862829;
		j4218841788 -> j1480976587;
	j2528064725 [label="Solche Waffen baut man nicht, wenn man nicht vorhat, sie auch einzusetzen, Kumpel.",shape=box,color=blue];
		j2528064725 -> j2107751595;
	j39260727 [label="<RETRO_EMOJI_SHRUG>",shape=box,color=red];
		j39260727 -> j691619677;
	j3702189970 [label="Ich wünschte, ich hätte eine Antwort. Auf beides.",shape=box,color=red];
		j3702189970 -> j691619677;
	j2735862829 [label="Manchmal ist es schwer zu glauben, dass man nicht mehr \"relevant\" ist.",shape=box,color=red];
		j2735862829 -> j3403016393;
	j1480976587 [label="Nun, ich meine nur ... vielleicht willst du dich nicht von ihm ... zurückgelassen fühlen.",shape=box,color=red];
		j1480976587 -> j1749090798;
	j2107751595 [label="Wenn man *weiß*, dass ein Krieg ansteht.",shape=box,color=blue];
		j2107751595 -> j1681711455;
		j2107751595 -> j3074767314;
		j2107751595 -> j303157500;
	j691619677 [label="Vielleicht braucht er eine Armee? Vielleicht versucht er \"die eine Sache\" zu finden, von der er glaubt, dass sie die Gleichgültigkeit besiegen kann. Vielleicht sucht er nach einer ganzen Reihe von Sachen.",shape=box,color=red];
		j691619677 -> j1971828380;
	j3403016393 [label="Genau ...",shape=box,color=blue];
		j3403016393 -> "Chat ends.";
	j1749090798 [label="Dass das, wofür er hier war, dass das, was er dir angetan hat, noch Bedeutung hat. Dass es noch immer valide ist. Dass es nicht gescheitert ist.",shape=box,color=red];
		j1749090798 -> j370243424;
		j1749090798 -> j734110363;
	j1681711455 [label="Dann können wir uns nur darauf vorbereiten, falls es dazu kommt.",shape=box,color=red];
		j1681711455 -> j1805115736;
	j3074767314 [label="Das ist möglich. Aber Entrati scheint auch jemand zu sein, der immer einen Plan B hat. ",shape=box,color=red];
		j3074767314 -> j2058849256;
	j303157500 [label="Ich weiß nicht. Minerva und Velimir haben mir von dem ... \"Kalten Krieg\" erzählt? Klingt so, als hätten Leute viele verrückte Waffen gebaut, ohne sie je eingesetzt zu haben.",shape=box,color=red];
		j303157500 -> j2318859777;
	j1971828380 [label="Ich komm nicht drumherum zu denken, dass wir nur Kugeln im Magazin sind. Dazu da, benutzt werden. Ausgeworfen und weggeworfen.",shape=box,color=blue];
		j1971828380 -> j2824184045;
		j1971828380 -> j305069579;
	"Chat ends." [color=orange];
	j370243424 [label="Und um das klarzustellen, du bist immer noch wichtig.",shape=box,color=red];
		j370243424 -> j2912490050;
		j370243424 -> j496229148;
		j370243424 -> j3077377028;
	j734110363 [label="Und um es klarzustellen, du bist *mir* immer noch wichtig. ",shape=box,color=red];
		j734110363 -> j2912490050;
		j734110363 -> j496229148;
		j734110363 -> j3077377028;
	j1805115736 [label="+5 Chemistry",color=orange];
		j1805115736 -> j4169580638;
	j2058849256 [label="Vielleicht.",shape=box,color=blue];
		j2058849256 -> j4043483001;
	j2318859777 [label="Ein faires Argument. Aber das geschieht zwischen Ländern und erfordert Diplomatie. Bewegliche Komponenten.",shape=box,color=blue];
		j2318859777 -> j2915145180;
	j2824184045 [label="Ich wünschte, ich könnte es dir sagen. Aber ich werde alles tun, um das zu verhindern.",shape=box,color=red];
		j2824184045 -> j1157620309;
	j305069579 [label="Du glaubst, das ist noch nicht das Ende?",shape=box,color=red];
		j305069579 -> j3985285155;
	j2912490050 [label="Aber zu glauben, dass deine Geschichte hier endet, ohne eine Rolle am tatsächlichen Ende zu spielen? Das ist scheiße.",shape=box,color=red];
		j2912490050 -> j96873230;
	j496229148 [label="Aber vielleicht tut der Gedanke weh, dass du irgendwo da draußen durch Arthur 2.0 ersetzt wurdest.",shape=box,color=red];
		j496229148 -> j1891609467;
	j3077377028 [label="Aber vielleicht willst du nur wissen, dass dein Opfer noch zählt - mehr im kosmischen Sinne?",shape=box,color=red];
		j3077377028 -> j1528024692;
	j4169580638 [label="Das stimmt.",shape=box,color=blue];
		j4169580638 -> j2421178261;
	j4043483001 [label="Ein Teil von mir hofft, dass es von uns noch mehr da draußen gibt. Aber wenn sie tatsächlich herkommen? Dann benötigen wir eventuell ein größeres Einkaufszentrum.",shape=box,color=blue];
		j4043483001 -> "Chat ends.";
	j2915145180 [label="Das hier ist eine Sache zwischen einem wortwörtlichen Gott und einem Mann, der denkt, er wäre einer.",shape=box,color=blue];
		j2915145180 -> j2574981885;
	j1157620309 [label="Das weiß ich. Und wir werden uns dieser Sache an dem Tag gemeinsam stellen. Davon bin ich überzeugt.",shape=box,color=blue];
		j1157620309 -> j2397353713;
	j3985285155 [label="Nein. Solche Waffen baut man nicht, wenn man nicht vorhat, sie auch einzusetzen, Kumpel.",shape=box,color=blue];
		j3985285155 -> j2968286746;
		j3985285155 -> j3074767314;
		j3985285155 -> j1681711455;
	j96873230 [label="Das könnte ein Teil davon sein. Wenn die Gleichgültigkeit der Grund ist, dass ich jetzt so bin? Und das durchmachen musste?",shape=box,color=blue];
		j96873230 -> j2549781878;
	j1891609467 [label="Kumpel, ich war bereit, in den Ruhestand zu gehen, bevor ich in diesen Unsinn hineingezogen wurde. Wohl kaum.",shape=box,color=blue];
		j1891609467 -> j1978568203;
	j1528024692 [label="Vielleicht. Vielleicht auch nicht. Aber bei wie vielen Menschen ist ihr Opfer letztlich ohne Bedeutung? Bei den meisten.",shape=box,color=blue];
		j1528024692 -> j2815753096;
	j2421178261 [label="Und wenn noch mehr von uns auftauchen? Ich hoffe, wir werden kein größeres Einkaufszentrum brauchen.",shape=box,color=blue];
		j2421178261 -> "Chat ends.";
	j2574981885 [label="Ich wette, dass es zu einer unvermeidlichen Kollision kommen wird. Ich glaube nicht, dass das Ego der beiden etwas anderes zulassen würde.",shape=box,color=blue];
		j2574981885 -> j2188252376;
		j2574981885 -> j3305994214;
	j2397353713 [label="+5 Chemistry",color=orange];
		j2397353713 -> j1648722223;
	j2968286746 [label="Ich weiß nicht. Minerva und Velimir haben mir von dem ... \"Kalten Krieg\" erzählt? Klingt so, als hätten Leute viele verrückte Waffen gebaut, ohne sie je eingesetzt zu haben.",shape=box,color=red];
		j2968286746 -> j4290130924;
	j2549781878 [label="Dann will ich Teil daran haben, es zu Fall zu bringen.",shape=box,color=blue];
		j2549781878 -> j678473952;
	j1978568203 [label="Ich bin immer noch erstaunt darüber, wie sehr du manchmal in ein Fettnäpfchen treten kannst.",shape=box,color=blue];
		j1978568203 -> "Chat ends.";
	j2815753096 [label="Vielleicht betrauere ich einfach die Idee, dass eine ganze Armee von uns da draußen existiert - erschaffen von einem Verrückten, ohne echte Vorstellungen. Ohne echten Plan.",shape=box,color=blue];
		j2815753096 -> j1658491730;
	j2188252376 [label="Vielleicht hast du recht.",shape=box,color=red];
		j2188252376 -> j933940143;
	j3305994214 [label="Ich hoffe sehr, dass du falsch liegst.",shape=box,color=red];
		j3305994214 -> j4138693339;
