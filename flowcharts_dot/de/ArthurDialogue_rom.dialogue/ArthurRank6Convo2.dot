		j3182156883 -> "Chat ends.";
	j1626472862 [label="Danke, Drifter.",shape=box,color=blue];
		j1626472862 -> "Chat ends.";
	j1582888361 [label="Das hier ist eine Sache zwischen einem wortwörtlichen Gott und einem Mann, der denkt, er wäre einer.",shape=box,color=blue];
		j1582888361 -> j48162551;
	j1141881164 [label="Ich will nicht als irgendeine Fußnote in Geschichtsbüchern enden. Ich will der Gleichgültigkeit mein Skana direkt in den Hintern schieben.",shape=box,color=blue];
		j1141881164 -> j1877752331;
		j1141881164 -> j3294252712;
	j1596268119 [label="Vielleicht ist das die Pille, die ich nur schwer schlucken kann, Kumpel.",shape=box,color=blue];
		j1596268119 -> "Chat ends.";
