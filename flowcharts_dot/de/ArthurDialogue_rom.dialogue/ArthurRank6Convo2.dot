		j3251512506 -> j3175022931;
	j2437280291 [label="Ganz ehrlich? Ich hoffe es auch.",shape=box,color=blue];
		j2437280291 -> j3175022931;
	j48162551 [label="Ich wette, dass es zu einer unvermeidlichen Kollision kommen wird. Ich glaube nicht, dass das Ego der beiden etwas anderes zulassen würde.",shape=box,color=blue];
		j48162551 -> j2188252376;
		j48162551 -> j3305994214;
	j1877752331 [label="Ich schau mal, was ich tun kann. ;)",shape=box,color=red];
		j1877752331 -> j3021743804;
	j3294252712 [label="Ich auch. Und vielleicht auch bei Entrati, wenn wir schon dabei sind.",shape=box,color=red];
