		j4290130924 -> j1582888361;
	j678473952 [label="+5 Chemistry",color=orange];
		j678473952 -> j1141881164;
	j1658491730 [label="Gesagt zu bekommen, dass man leiden muss und Opfer bringen muss - aber ohne klare Vorstellung vom Warum. Oder für was.",shape=box,color=blue];
		j1658491730 -> j1596268119;
	j933940143 [label="+5 Chemistry",color=orange];
		j933940143 -> j3251512506;
