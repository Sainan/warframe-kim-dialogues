	j972778441 [label="Check boolean ArthurPolyamorySuccess",color=orange];
		j972778441 -> j1569221931 [label=true,color=green];
		j972778441 -> "Chat ends." [label=false,color=brown];
	j1347602124 [label="Arthur, können wir reden? [Einwilligung für mehrerer Partner einholen.]",shape=box,color=red];
		j1347602124 -> j3943028069;
	j2874419297 [label="[Ende.]",shape=box,color=red];
		j2874419297 -> j3652224286;
	j3943028069 [label="Immer. Stimmt etwas nicht?",shape=box,color=blue];
		j3943028069 -> j495488699;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j495488699 [label="Nein, alles in Ordnung. Ich wollte nur mit dir über etwas sprechen, von dem ich hoffe, dass es für dich keine unangenehme Situation darstellt.",shape=box,color=red];
		j495488699 -> j1041544673;
	j1041544673 [label="Ich möchte dich nicht in eine Situation bringen, mit der du nicht einverstanden bist. Ich weiß, dass wir das noch nie besprochen haben. Wenn du also Nein sagst, ist das völlig in Ordnung. Das wollte ich dir nur sagen.",shape=box,color=red];
		j1041544673 -> j2470531902;
	j2470531902 [label="Was wir haben, ist mir wichtig – sehr wichtig – und es ist real. Ich möchte nicht, dass du daran zweifelst.",shape=box,color=red];
		j2470531902 -> j214276829;
	j214276829 [label="Ah, ich sehe schon, worauf das hinausläuft. Du hast also auch Gefühle für jemand anderen?",shape=box,color=blue];
		j214276829 -> j2424557273;
		j214276829 -> j3502022926;
	j2424557273 [label="So ist es. Und ich weiß, dass es vielleicht schwer zu verstehen ist, aber das bedeutet nicht, dass ich weniger für dich empfinde.",shape=box,color=red];
		j2424557273 -> j3521092311;
	j3502022926 [label="So ist es. Aber jetzt, wo ich darüber nachdenke, sollten wir es wohl besser hier beenden. [Schluss machen.]",shape=box,color=red];
		j3502022926 -> j444318192;
	j3521092311 [label="Liebling, glaubst du im Ernst, ich hätte nach so vielen Jahren beim Militär nicht so ziemlich jede Art von Beziehung kennengelernt?",shape=box,color=blue];
		j3521092311 -> j3569825554;
	j444318192 [label="Wenn das wirklich dein Wunsch ist ...",shape=box,color=blue];
		j444318192 -> j3701883258;
	j3569825554 [label="Wenn man so viel Zeit seines Lebens damit verbringt, dem Tod nahe zu sein, lernt man zu schätzen, was im Leben wichtig ist und was nicht.",shape=box,color=blue];
		j3569825554 -> j3372929834;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j3372929834 [label="Du hörst auf, klare Grenzen infrage zu stellen. Ich verstehe das absolut.",shape=box,color=blue];
		j3372929834 -> j699688117;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j699688117 [label="Die Wahrheit ist: Du bist mir wichtig. Und wenn dir die andere Person wichtig sind, dann ist sie mir auch wichtig.",shape=box,color=blue];
		j699688117 -> j1751355465;
	j1751355465 [label="Nur. Niemand. Niemand von den Hex. Okay? Ich glaube, ich könnte das nicht verkraften, wenn es sozusagen \"in der Familie\" wäre.",shape=box,color=blue];
		j1751355465 -> j3998401123;
	j3998401123 [label="Der Gedanke daran wird mir Albträume bereiten.",shape=box,color=blue];
		j3998401123 -> j576941799;
		j3998401123 -> j3278013699;
	j576941799 [label="Haha. Versprochen.",shape=box,color=red];
		j576941799 -> j324620895;
	j3278013699 [label="Ich denke, dass du die Person mögen würdest.",shape=box,color=red];
		j3278013699 -> j3503116600;
	j324620895 [label="Danke. Und ich hoffe, ich treffe sie eines Tages. Aus ... persönlichen Gründen natürlich.",shape=box,color=blue];
		j324620895 -> j3136439079;
	j3503116600 [label="Und ich hoffe, ich treffe sie eines Tages. Aus ... persönlichen Gründen natürlich.",shape=box,color=blue];
		j3503116600 -> j3136439079;
	j3136439079 [label="+20 Chemistry",color=orange];
		j3136439079 -> j2615750564;
	j2615750564 [label="Pass einfach gut auf dich auf da draußen, Schatz.",shape=box,color=blue];
		j2615750564 -> j3652224286;
}