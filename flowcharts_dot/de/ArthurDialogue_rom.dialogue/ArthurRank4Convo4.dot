	1548 [label="Egal, was passiert.",shape=box,color=blue];
		1548 -> 1549;
	1549 [label="Als ich hinter umkämpfte Linien geschickt wurde, um alle \"möglichen Feinde\" zu töten?",shape=box,color=blue];
