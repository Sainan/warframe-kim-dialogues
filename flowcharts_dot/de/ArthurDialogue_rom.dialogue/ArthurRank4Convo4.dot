	1554 [label="Genau.",shape=box,color=blue];
		1554 -> 1555;
	1555 [label="Ich weiß nicht, wie viele unschuldige Leben wir an diesem Tag ausgelöscht haben.",shape=box,color=blue];
		1555 -> 1556;
	1556 [label="Aber es waren zu viele.",shape=box,color=blue];
		1556 -> 1557;
	1557 [label="Als ich Antworten darüber forderte, warum wir Unschuldige umgebracht haben, drohten mir die Lamettaträger mit einer unehrenhaften Entlassung.",shape=box,color=blue];
		1557 -> 1558;
	1558 [label="Halt die Klappe. Mach deinen Job. Benutze deine Waffe. Töte, wie ein guter Soldat.",shape=box,color=blue];
		1558 -> 1559;
	1559 [label="Stell. Keine. Fragen.",shape=box,color=blue];
		1559 -> 1560;
	1560 [label="Sie hatten recht. Ich hätte keine Fragen stellen sollen. Ich bin lausig darin, Dingen auf den Grund zu gehen.",shape=box,color=blue];
		1560 -> 1561;
