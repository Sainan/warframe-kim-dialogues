		1537 -> 1538;
	1538 [label="Jeder geht aus anderen Gründen zur Armee. Ich, für mich was es ... Ehre. Eine Bestimmung.",shape=box,color=blue];
		1538 -> 1539;
	1536 [label="Chat ends.",color=orange];
	1539 [label="Ich wollte ein Held sein, wie ein Sol-verdammter Idiot.",shape=box,color=blue];
		1539 -> 1540;
	1540 [label="Der Punkt ist, ich hatte grandiose Ideen darüber, was es bedeutet, ein Soldat zu sein.",shape=box,color=blue];
		1540 -> 1541;
