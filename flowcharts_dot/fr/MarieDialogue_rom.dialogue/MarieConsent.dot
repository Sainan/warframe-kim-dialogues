		j1985950621 -> "Chat ends." [label=true,color=green];
		j1985950621 -> j4095098359 [label=false,color=brown];
	j1134465740 [label="Check boolean MariePolyamorySuccess",color=orange];
		j1134465740 -> j1985950621 [label=true,color=green];
		j1134465740 -> "Chat ends." [label=false,color=brown];
	j4095098359 [label="Mon cœur, pouvons-nous parler? Juste un instant. ",shape=box,color=blue];
		j4095098359 -> j2441581128;
		j4095098359 -> j857881331;
	j2441581128 [label="Salut, bien sûr. Quoi de neuf?",shape=box,color=red];
		j2441581128 -> j58047797;
	j857881331 [label="[Fin.]",shape=box,color=red];
		j857881331 -> j952339130;
	j58047797 [label="Je voulais simplement dire que... je sais que ton cœur appartient aussi à quelqu’un d’autre. Et même si je ne connais pas cette personne, mon cœur s’en réjouit.",shape=box,color=blue];
		j58047797 -> j432700682;
	j952339130 [label="Boolean MarieConsentComplete is now true.",color=orange];
		j952339130 -> "Chat ends.";
	j432700682 [label="J'ai confiance en toi et si cette personne occupe une place dans ton âme, alors je suis heureuse de la partager avec elle.",shape=box,color=blue];
		j432700682 -> j3661544183;
	j3661544183 [label="J'espère simplement avoir un jour l'occasion de la rencontrer, d'accord? Cette personne adorée par mon loup, je vais l'adorer également...",shape=box,color=blue];
		j3661544183 -> j2887663689;
	j2887663689 [label="Du moins, si tu penses qu'elle sera d'accord.",shape=box,color=blue];
		j2887663689 -> j2571103235;
		j2887663689 -> j2185460137;
		j2887663689 -> j775294857;
	j2571103235 [label="Honnêtement, tu n'es peut-être pas son genre.",shape=box,color=red];
		j2571103235 -> j2314979361;
	j2185460137 [label="C'est quelqu'un qui t'adorera, Marie. Autant que moi.",shape=box,color=red];
		j2185460137 -> j3080409310;
	j775294857 [label="Je ne pense vraiment pas qu'on puisse te résister.",shape=box,color=red];
		j775294857 -> j3080409310;
	j2314979361 [label="Pff! Tu es terrible, mon loup. Laisse-moi rêver. En attendant, je t'aurai quand je t'aurai, je suppose!",shape=box,color=blue];
		j2314979361 -> j546588702;
	j3080409310 [label="D’ici là, je t’aurai quand je t’aurai. Et je serai heureuse de te partager avec la personne qui, comme moi, prendra soin de toi.",shape=box,color=blue];
		j3080409310 -> j546588702;
	j546588702 [label="Après tout, il faut bien que quelqu'un monte la garde contre le Murmure pendant que vous vous amusez comme des fous!",shape=box,color=blue];
		j546588702 -> j1371778957;
	j1371778957 [label="Et sur ce, le devoir m'appelle. À la revoyure!",shape=box,color=blue];
		j1371778957 -> j952339130;
}