	3580 [label="Salut, bien sûr. Quoi de neuf?",shape=box,color=red];
		3580 -> 3582;
	3579 [label="[Fin.]",shape=box,color=red];
		3579 -> 3581;
	3582 [label="Je voulais simplement dire que... je sais que ton cœur appartient aussi à quelqu’un d’autre. Et même si je ne connais pas cette personne, mon cœur s’en réjouit.",shape=box,color=blue];
		3582 -> 3584;
	3581 [label="Update boolean MarieConsentComplete",color=orange];
		3581 -> 3583;
	3584 [label="J'ai confiance en toi et si cette personne occupe une place dans ton âme, alors je suis heureuse de la partager avec elle.",shape=box,color=blue];
		3584 -> 3585;
	3583 [label="Chat ends.",color=orange];
	3585 [label="J'espère simplement avoir un jour l'occasion de la rencontrer, d'accord? Cette personne adorée par mon loup, je vais l'adorer également...",shape=box,color=blue];
		3585 -> 3586;
	3586 [label="Du moins, si tu penses qu'elle sera d'accord.",shape=box,color=blue];
		3586 -> 3587;
		3586 -> 3588;
		3586 -> 3589;
	3587 [label="Honnêtement, tu n'es peut-être pas son genre.",shape=box,color=red];
		3587 -> 3590;
	3588 [label="C'est quelqu'un qui t'adorera, Marie. Autant que moi.",shape=box,color=red];
		3588 -> 3591;
	3589 [label="Je ne pense vraiment pas qu'on puisse te résister.",shape=box,color=red];
		3589 -> 3591;
	3590 [label="Pff! Tu es terrible, mon loup. Laisse-moi rêver. En attendant, je t'aurai quand je t'aurai, je suppose!",shape=box,color=blue];
		3590 -> 3592;
	3591 [label="D’ici là, je t’aurai quand je t’aurai. Et je serai heureuse de te partager avec la personne qui, comme moi, prendra soin de toi.",shape=box,color=blue];
		3591 -> 3592;
	3592 [label="Après tout, il faut bien que quelqu'un monte la garde contre le Murmure pendant que vous vous amusez comme des fous!",shape=box,color=blue];
