		3017 -> 3026;
	3011 [label="Je pense que tu as une façon de le convaincre, là où toutes les autres méthodes ont échoué, n'est-ce pas?",shape=box,color=blue];
		3011 -> 3021;
		3011 -> 3022;
	3010 [label="Je te souhaite bonne chance. Ce diable peut être obstiné et ce n'est pas peu dire. Parfois, je me dis qu'il prend juste plaisir à faire de la provocation!",shape=box,color=blue];
