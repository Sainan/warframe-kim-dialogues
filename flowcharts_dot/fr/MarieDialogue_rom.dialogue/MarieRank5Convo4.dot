	3051 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3051 -> 3064;
	3053 [label="Merci, merci, merci, mon cœur!",shape=box,color=blue];
		3053 -> 3065;
	3052 [label="Merci, merci, merci!",shape=box,color=blue];
		3052 -> 3065;
	3054 [label="Eh bien! Le moment venu, je serai prête et j'attendrai! D'ici là, merci, mon cœur.",shape=box,color=blue];
		3054 -> 3066;
	3055 [label="Eh bien! Le moment venu, je serai prête et j'attendrai! D'ici là, merci.",shape=box,color=blue];
		3055 -> 3066;
	3049 [label="Je ne voudrais jamais insinuer que, puisque le diable semble t'apprécier, il t'écoutera peut-être alors qu'il semble ignorer tout le monde.",shape=box,color=blue];
		3049 -> 3062;
	3050 [label="Je suis tout simplement heureuse de ton bonheur. Et si le diable sait où exercer ses... efforts... tant mieux, non?",shape=box,color=blue];
		3050 -> 3063;
	3045 [label="Tous ceux qui l'ont côtoyé ont essayé de le faire passer pour un monstre. Je suppose que je suis la première personne à ne pas l'avoir fait.",shape=box,color=red];
		3045 -> 3058;
	3044 [label="Il y a beaucoup de choses chez lui qu'il ne sait pas comment montrer. Ce n'est pas une carapace à proprement parler, mais il se méfie des autres et craint qu'ils ne lui fassent du mal.",shape=box,color=red];
		3044 -> 3057;
	3047 [label="Il a... connu de véritables peines de cœur au cours de sa longue vie. Il a simplement pansé ses plaies avant de les recouvrir d'épines, c'est tout.",shape=box,color=red];
		3047 -> 3060;
	3048 [label="Je crois que je peux comprendre le nombre d'années qu'il a connues. J'ai vu autant de morts que lui.",shape=box,color=red];
		3048 -> 3061;
	3043 [label="Il n'a jamais cherché qu'à faire ce qui était juste. Peut-être pas de la bonne manière, certes, mais il essayait de sauver le Système Origine des Orokins.",shape=box,color=red];
		3043 -> 3056;
	3046 [label="J'apprécie son humour pince-sans-rire. Il est intelligent, une fois qu'on a surmonté son ego.",shape=box,color=red];
		3046 -> 3059;
	3064 [label="Chat ends.",color=orange];
	3065 [label="Eh bien! Le moment venu, je serai prête et j'attendrai! À bientôt!",shape=box,color=blue];
		3065 -> 3075;
	3066 [label="Update boolean MarieFamilySuccess",color=orange];
		3066 -> 3076;
	3062 [label="Et jamais pendant les moments privés. Non. Jamais.",shape=box,color=blue];
		3062 -> 3071;
		3062 -> 3072;
	3063 [label="Et ce sera d'autant mieux pour nous tous si tu lui sers de contrepoids pour le tempérer.",shape=box,color=blue];
		3063 -> 3073;
		3063 -> 3074;
	3058 [label="Et je suppose que je suis en tête de la liste, n'est-ce pas? Je suppose que je devrais... tenter de comprendre les raisons de son comportement. La condamnation ne sauve aucune âme.",shape=box,color=blue];
		3058 -> 3067;
	3057 [label="Il y a toujours une souffrance que l'on cache à ceux qui nous entourent. Quelque chose que l'on cherche à protéger, de peur que d'autres ne s'en servent. Je suppose que je devrais m'efforcer d'être plus gentille avec lui, si ce que tu dis est vrai.",shape=box,color=blue];
		3057 -> 3067;
	3060 [label="Je n'arrive pas à imaginer la quantité d'amour et de décès qu'on doit endurer pendant toutes ces années. Cela me paraît tellement irréel, même après tout ce que j'ai vu.",shape=box,color=blue];
		3060 -> 3069;
	3061 [label="Parfois, quand je lui parle, j'oublie combien de siècles il a traversés. Cela me paraît tellement irréel, même compte tenu de tout ce que j'ai vu.",shape=box,color=blue];
		3061 -> 3070;
	3056 [label="Il y a toujours des nuances, n'est-ce pas? Toujours des raisons d'agir d'une manière ou d'une autre. Je suppose que je devrais m'efforcer d'être plus gentille avec lui, si ce que tu dis est vrai.",shape=box,color=blue];
		3056 -> 3067;
	3059 [label="Personne n'a jamais mis la malice du diable en doute.",shape=box,color=blue];
		3059 -> 3068;
	3075 [label="Update boolean MarieFamilySuccess",color=orange];
		3075 -> 3080;
	3076 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3076 -> 3081;
	3071 [label="Tu me surprends. C'est impressionnant. ",shape=box,color=red];
		3071 -> 3038;
	3072 [label="Je ne savais pas que tu avais ce côté-là.",shape=box,color=red];
		3072 -> 3038;
	3073 [label="Je ne peux rien promettre.",shape=box,color=red];
		3073 -> 3078;
	3074 [label="Qui a dit que j'essayais de le gérer?",shape=box,color=red];
		3074 -> 3079;
	3067 [label="+10 Chemistry",color=orange];
		3067 -> 3077;
	3069 [label="Oui, quels dégâts cela peut-il faire à une âme? Je comprends pourquoi tu voulais trouver quelqu'un qui te comprenne. Et pourquoi il voulait te trouver, toi.",shape=box,color=blue];
		3069 -> 3067;
	3070 [label="Avoir vécu si longtemps, avoir vu tant de morts, en avoir payé un si lourd tribut soi-même?",shape=box,color=blue];
		3070 -> 3069;
	3068 [label="+5 Chemistry",color=orange];
		3068 -> 3077;
