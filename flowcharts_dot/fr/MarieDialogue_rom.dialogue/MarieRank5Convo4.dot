	3014 [label="Je vais parler à Lyon pendant ce temps-là, mais je n'ai que très peu d'espoir.",shape=box,color=blue];
		3014 -> 3023;
	3015 [label="+20 Chemistry",color=orange];
		3015 -> 3024;
