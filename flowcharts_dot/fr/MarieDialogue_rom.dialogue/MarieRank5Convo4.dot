	3079 [label="Add -1 to Thermostat",color=orange];
		3079 -> 3083;
	3077 [label="Je suis simplement heureuse que le diable ait enfin quelqu'un à qui parler, quelqu'un qui pourrait chercher à le gérer. Un ange sur son épaule.",shape=box,color=blue];
		3077 -> 3074;
		3077 -> 3073;
	3084 [label="Chat ends.",color=orange];
	3082 [label="+10 Chemistry",color=orange];
		3082 -> 3085;
	3083 [label="+10 Chemistry",color=orange];
		3083 -> 3086;
	3085 [label="Oui, je crains qu'il y ait en lui une perversité incurable. Il y prend trop de plaisir.",shape=box,color=blue];
		3085 -> 3087;
	3086 [label="Peut-être que tu as raison... que serait un ange sans son diable? Il nous rappelle à tous ce que nous devrions nous efforcer d’éviter.",shape=box,color=blue];
		3086 -> 3087;
	3087 [label="Eh bien! Si jamais tu parviens à convaincre le diable de nous aider dans notre mission, je serai prête! À bientôt!",shape=box,color=blue];
