		2965 -> 2970;
	2962 [label="Marie, es-tu toujours partante pour... peut-être essayer de convaincre Loid de parler aux \"voisins du dessus\"? Je sais que nous sommes restés sur une note bizarre.",shape=box,color=red];
		2962 -> 2968;
