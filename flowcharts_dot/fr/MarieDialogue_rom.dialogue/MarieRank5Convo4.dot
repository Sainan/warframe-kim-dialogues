	3030 [label="+5 Chemistry",color=orange];
		3030 -> 3037;
	3031 [label="Oh! Ce n'est pas ce que je voulais dire, pardonne-moi! Simplement qu'il semble t'apprécier, donc tu as peut-être son attention alors qu'il ignore tout le monde.",shape=box,color=blue];
