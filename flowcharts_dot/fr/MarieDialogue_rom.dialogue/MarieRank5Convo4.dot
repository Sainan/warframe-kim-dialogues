	j374072022 [label="Check boolean MarieDating",color=orange];
		j374072022 -> j1533427241 [label=true,color=green];
		j374072022 -> j281274652 [label=false,color=brown];
	j3296469326 [label="Et comment sortir de cette impasse! Ce purgatoire dans lequel nous sommes prisonniers ne doit pas perdurer. Il est si inutilement douloureux.",shape=box,color=blue];
		j3296469326 -> j1850643188;
	j2768654365 [label="Boolean MarieWillDate is now true.",color=orange];
		j2768654365 -> "Chat ends.";
	j3998054746 [label="Bonjour, mon cœur! J'y ai réfléchi... et j'ai vraiment du mal à l'admettre. Cela ne me fait pas plaisir de le dire.",shape=box,color=blue];
		j3998054746 -> j1135356883;
	j433060358 [label="Bonjour! J'y ai réfléchi... et j'ai vraiment du mal à l'admettre. Cela ne me fait pas plaisir de le dire.",shape=box,color=blue];
		j433060358 -> j1135356883;
	j757676836 [label="Bonjour, mon cœur! Et que crois-tu que je ne vais pas aimer?",shape=box,color=blue];
		j757676836 -> j3886316610;
	j3242642436 [label="Bonjour! Oh? Et que crois-tu que je ne vais pas aimer?",shape=box,color=blue];
		j3242642436 -> j3886316610;
	j1533427241 [label="Bonjour, bonjour, mon cœur! J'y ai réfléchi... et j'ai vraiment du mal à l'admettre. Cela ne me fait pas plaisir de le dire.",shape=box,color=blue];
		j1533427241 -> j319652310;
	j281274652 [label="Bonjour! J'y ai réfléchi... et j'ai vraiment du mal à l'admettre. Cela ne me fait pas plaisir de le dire.",shape=box,color=blue];
		j281274652 -> j319652310;
	j1850643188 [label="Mais j'ai l'impression qu'il nous faut... une sorte de bastion, non? Aurais-tu des idées?",shape=box,color=blue];
		j1850643188 -> j595814462;
		j1850643188 -> j3886316610;
	j1135356883 [label="Mais je pense... je pense – ah, Sol, pardonne-moi – qu’il faudra peut-être faire appel au diable. Je ne crois pas que Monsieur Loid nous écoutera autrement.",shape=box,color=blue];
		j1135356883 -> j2620850601;
	j3886316610 [label="Je pense que nous aurons peut-être besoin de l'aide de Roathe pour convaincre Loid de parler à la famille Entrati. Je ne crois pas qu'il le fera autrement, sans garanties de protection pour lui et pour la famille.",shape=box,color=red];
		j3886316610 -> j325897966;
	j319652310 [label="Je crois que tu as raison. Le diable est peut-être la pièce manquante. Ah, rien que d'écrire ces mots, ça me fait mal! ",shape=box,color=blue];
		j319652310 -> j409794056;
	j595814462 [label="Je n'ai pas vraiment de bonnes idées qui n'impliquent pas de faire appel à des sources déplaisantes. Des sources qui pourraient bien nous attirer de sérieux ennuis plus tard. Notamment, Roathe.",shape=box,color=red];
		j595814462 -> j1810392289;
	j2620850601 [label="Le diable est puissant et il peut être utile si les choses tournent mal, n'est-ce pas?",shape=box,color=blue];
		j2620850601 -> j437021516;
		j2620850601 -> j2394142098;
	j325897966 [label="Je... déteste l'admettre, mais je crois que tu as raison... Sol, pardonne-moi.",shape=box,color=blue];
		j325897966 -> j409794056;
	j409794056 [label="Evaluate expressions",color=orange];
		j409794056 -> j158202588 [label="RoatheFamilyFail",color=purple];
		j409794056 -> j4064706864 [label="RoatheRedeemed & RoatheFamilyDelay
",color=purple];
		j409794056 -> j788538552 [label="RoatheVillain & RoatheFamilyDelay",color=purple];
		j409794056 -> j2393458385 [label="false",color=purple];
	j1810392289 [label="Tu penses vraiment? Si je peux mettre de côté mes différends avec le diable, tu le peux certainement aussi, non?",shape=box,color=blue];
		j1810392289 -> j1162085669;
		j1810392289 -> j4110618375;
	j437021516 [label="Tu as raison. Je ne pensais pas que tu accepterais. J'avais peur de te le demander.",shape=box,color=red];
		j437021516 -> j409794056;
	j2394142098 [label="Non, il doit y avoir une autre solution. Je refuse de lui demander son aide.",shape=box,color=red];
		j2394142098 -> j1810392289;
	j158202588 [label="Nous apportera-t-il son aide à cet égard?",shape=box,color=blue];
		j158202588 -> j3429251212;
	j4064706864 [label="Nous apportera-t-il son aide à cet égard?",shape=box,color=blue];
		j4064706864 -> j2032599083;
	j788538552 [label="Nous apportera-t-il son aide à cet égard?",shape=box,color=blue];
		j788538552 -> j1440621024;
	j2393458385 [label="Penses-tu pouvoir le convaincre de nous aider?",shape=box,color=blue];
		j2393458385 -> j1752019715;
		j2393458385 -> j668222795;
	j1162085669 [label="Très bien. Si ça ne te dérange pas, ça ne me dérange pas non plus.",shape=box,color=red];
		j1162085669 -> j3863948741;
	j4110618375 [label="Pardon, mais non. ",shape=box,color=red];
		j4110618375 -> j2003066667;
	j3429251212 [label="Non, malheureusement... Je crois que c'était une impasse. Penses-tu qu'il y ait une autre solution?",shape=box,color=red];
		j3429251212 -> j980293334;
	j2032599083 [label="Il le fera. Je l'ai convaincu de m'aider à les réunir – et tu ne vas pas le croire – afin qu'il puisse protéger la famille d'Entrati. Après tout, ils sont les seuls Orokins survivants.",shape=box,color=red];
		j2032599083 -> j1934240363;
	j1440621024 [label="Il le fera. Je l'ai convaincu de les aider à se réunir – et cela ne te surprendra pas – surtout pour embêter Albrecht en son absence.",shape=box,color=red];
		j1440621024 -> j2019548877;
	j1752019715 [label="J'y travaille encore, mais je pense que oui.",shape=box,color=red];
		j1752019715 -> j961489522;
	j668222795 [label="Rien n'est encore gagné. Il est... enfin, tu sais comment il est.",shape=box,color=red];
		j668222795 -> j3827853471;
	j3863948741 [label="Oui, je ne suis pas obligée d'y prendre plaisir, mais c'est comme un médicament qu'il faut avaler, je suppose.",shape=box,color=blue];
		j3863948741 -> j409794056;
	j2003066667 [label="+20 Chemistry",color=orange];
		j2003066667 -> j4227439994;
	j980293334 [label="Oh! C'est... malheureux. Je ne sais pas? Je ne pense pas... Aurais-tu une autre idée pour approcher le diable? Ou une façon de réessayer?",shape=box,color=blue];
		j980293334 -> j1956361153;
	j1934240363 [label="Il aide à protéger la famille de l'homme qui l'a transformé en protoframe contre son gré et l'a projeté dans le passé, le privant de ses souvenirs...",shape=box,color=blue];
		j1934240363 -> j2715074672;
	j2019548877 [label="Tu as raison, je ne suis... pas surprise.",shape=box,color=blue];
		j2019548877 -> j1398132428;
		j2019548877 -> j1082899018;
	j961489522 [label="Check boolean RoatheDating",color=orange];
		j961489522 -> j815934160 [label=true,color=green];
		j961489522 -> j2615498893 [label=false,color=brown];
	j3827853471 [label="Check boolean RoatheDating",color=orange];
		j3827853471 -> j4064311639 [label=true,color=green];
		j3827853471 -> j3164808441 [label=false,color=brown];
	j4227439994 [label="Alors, je soutiendrai également ton choix.",shape=box,color=blue];
		j4227439994 -> j1179567760;
	j1956361153 [label="Je vais parler à Lyon pendant ce temps-là, mais je n'ai que très peu d'espoir.",shape=box,color=blue];
		j1956361153 -> j3498529850;
	j2715074672 [label="+20 Chemistry",color=orange];
		j2715074672 -> j303143779;
	j1398132428 [label="Je pense que c'est juste une bonne excuse pour dissimuler ses intentions.",shape=box,color=red];
		j1398132428 -> j3651147663;
	j1082899018 [label="Au moins, il aidera. Et je veillerai à ce qu'il ne mette pas ses menaces à exécution.",shape=box,color=red];
		j1082899018 -> j2553736942;
	j815934160 [label="Je pense que tu as une façon de le convaincre, là où toutes les autres méthodes ont échoué, n'est-ce pas?",shape=box,color=blue];
		j815934160 -> j3858294031;
		j815934160 -> j1297573134;
	j2615498893 [label="Je te souhaite bonne chance. Ce diable peut être obstiné et ce n'est pas peu dire. Parfois, je me dis qu'il prend juste plaisir à faire de la provocation!",shape=box,color=blue];
		j2615498893 -> j2101463563;
		j2615498893 -> j3440376218;
	j4064311639 [label="Oui, je le sais. Je pense que tu as une façon de le convaincre, là où toutes les autres méthodes ont échoué, n'est-ce pas?",shape=box,color=blue];
		j4064311639 -> j3858294031;
		j4064311639 -> j1297573134;
	j3164808441 [label="Oui, certainement. Ce diable peut être obstiné et ce n'est pas peu dire. Parfois, je me dis qu'il prend juste plaisir à faire de la provocation!",shape=box,color=blue];
		j3164808441 -> j2101463563;
		j3164808441 -> j3440376218;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j3498529850 [label="+20 Chemistry",color=orange];
		j3498529850 -> j3223763111;
	j303143779 [label="J'ai profondément mal jugé notre diable...",shape=box,color=blue];
		j303143779 -> j22541049;
	j3651147663 [label="Oui, j'espère que tu as raison.",shape=box,color=blue];
		j3651147663 -> j70687620;
	j2553736942 [label="Oui. Au moins, tu es là pour l'empêcher de laisser libre cours à ses... instincts les plus vils.",shape=box,color=blue];
		j2553736942 -> j70687620;
	j3858294031 [label="Qu'est-ce que tu insinues, Marie?",shape=box,color=red];
		j3858294031 -> j3343654829;
	j1297573134 [label="Je ne voudrais pas utiliser ma relation avec lui comme outil de négociation.",shape=box,color=red];
		j1297573134 -> j2766453667;
	j2101463563 [label="Peut-être, mais je pense que c'est surtout pour la forme.",shape=box,color=red];
		j2101463563 -> j2789362835;
	j3440376218 [label="En fait, j'aime bien ça, aussi bizarre que cela puisse paraître. On s'entend bien.",shape=box,color=red];
		j3440376218 -> j3287999237;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j3223763111 [label="Le diable est capricieux! C'est la vie, comme on dit!",shape=box,color=blue];
		j3223763111 -> j3569999725;
	j22541049 [label="Et je ne suis pas assez naïve pour ne pas voir le rôle que tu as joué pour que tout cela se produise!",shape=box,color=blue];
		j22541049 -> j1263896752;
	j70687620 [label="Check boolean MarieDating",color=orange];
		j70687620 -> j3639147689 [label=true,color=green];
		j70687620 -> j3067429628 [label=false,color=brown];
	j3343654829 [label="+5 Chemistry",color=orange];
		j3343654829 -> j50910651;
	j2766453667 [label="Oh! Ce n'est pas ce que je voulais dire, pardonne-moi! Simplement qu'il semble t'apprécier, donc tu as peut-être son attention alors qu'il ignore tout le monde.",shape=box,color=blue];
		j2766453667 -> j801038358;
	j2789362835 [label="Oui? Qu'est-ce que tu veux dire?",shape=box,color=blue];
		j2789362835 -> j1155893159;
	j3287999237 [label="Oui, il semble bien t'apprécier. Peut-être est-ce parce que vous partagez la même époque et le même lieu, contrairement à nous? Sinon, pourquoi est-ce que ce serait le cas?",shape=box,color=blue];
		j3287999237 -> j1155893159;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j1263896752 [label="Check boolean MarieDating",color=orange];
		j1263896752 -> j2082296704 [label=true,color=green];
		j1263896752 -> j271818178 [label=false,color=brown];
	j3639147689 [label="+10 Chemistry",color=orange];
		j3639147689 -> j1815813496;
	j3067429628 [label="+10 Chemistry",color=orange];
		j3067429628 -> j3330719594;
	j50910651 [label="Je n'ai absolument aucune idée de ce que tu veux dire! Je n'insinue rien du tout. Je suis une Sœur de Sol totalement innocente.",shape=box,color=blue];
		j50910651 -> j1360005391;
	j801038358 [label="+5 Chemistry",color=orange];
		j801038358 -> j1590532714;
	j1155893159 [label="Evaluate expressions",color=orange];
		j1155893159 -> j2975156256 [label="RoatheVillain",color=purple];
		j1155893159 -> j2101628216 [label="RoatheRedeemed",color=purple];
		j1155893159 -> j1621503192 [label="RoatheUnloved3",color=purple];
		j1155893159 -> j1871859316 [label="RoatheTraitor2",color=purple];
		j1155893159 -> j1937295014 [label="RoatheExecutor2",color=purple];
		j1155893159 -> j1438453338 [label="false",color=purple];
	j2082296704 [label="Merci, merci, merci, mon cœur!",shape=box,color=blue];
		j2082296704 -> j2206511371;
	j271818178 [label="Merci, merci, merci!",shape=box,color=blue];
		j271818178 -> j2206511371;
	j1815813496 [label="Eh bien! Le moment venu, je serai prête et j'attendrai! D'ici là, merci, mon cœur.",shape=box,color=blue];
		j1815813496 -> j3569999725;
	j3330719594 [label="Eh bien! Le moment venu, je serai prête et j'attendrai! D'ici là, merci.",shape=box,color=blue];
		j3330719594 -> j3569999725;
	j1360005391 [label="Je ne voudrais jamais insinuer que, puisque le diable semble t'apprécier, il t'écoutera peut-être alors qu'il semble ignorer tout le monde.",shape=box,color=blue];
		j1360005391 -> j2951752107;
	j1590532714 [label="Je suis tout simplement heureuse de ton bonheur. Et si le diable sait où exercer ses... efforts... tant mieux, non?",shape=box,color=blue];
		j1590532714 -> j1939653877;
	j2975156256 [label="Tous ceux qui l'ont côtoyé ont essayé de le faire passer pour un monstre. Je suppose que je suis la première personne à ne pas l'avoir fait.",shape=box,color=red];
		j2975156256 -> j2486698030;
	j2101628216 [label="Il y a beaucoup de choses chez lui qu'il ne sait pas comment montrer. Ce n'est pas une carapace à proprement parler, mais il se méfie des autres et craint qu'ils ne lui fassent du mal.",shape=box,color=red];
		j2101628216 -> j2051024787;
	j1621503192 [label="Il a... connu de véritables peines de cœur au cours de sa longue vie. Il a simplement pansé ses plaies avant de les recouvrir d'épines, c'est tout.",shape=box,color=red];
		j1621503192 -> j1750703752;
	j1871859316 [label="Je crois que je peux comprendre le nombre d'années qu'il a connues. J'ai vu autant de morts que lui.",shape=box,color=red];
		j1871859316 -> j1491670577;
	j1937295014 [label="Il n'a jamais cherché qu'à faire ce qui était juste. Peut-être pas de la bonne manière, certes, mais il essayait de sauver le Système Origine des Orokins.",shape=box,color=red];
		j1937295014 -> j1158694490;
	j1438453338 [label="J'apprécie son humour pince-sans-rire. Il est intelligent, une fois qu'on a surmonté son ego.",shape=box,color=red];
		j1438453338 -> j1569208741;
	j2206511371 [label="Eh bien! Le moment venu, je serai prête et j'attendrai! À bientôt!",shape=box,color=blue];
		j2206511371 -> j3569999725;
	j2951752107 [label="Et jamais pendant les moments privés. Non. Jamais.",shape=box,color=blue];
		j2951752107 -> j3659551837;
		j2951752107 -> j4098294642;
	j1939653877 [label="Et ce sera d'autant mieux pour nous tous si tu lui sers de contrepoids pour le tempérer.",shape=box,color=blue];
		j1939653877 -> j4083508797;
		j1939653877 -> j1880750320;
	j2486698030 [label="Et je suppose que je suis en tête de la liste, n'est-ce pas? Je suppose que je devrais... tenter de comprendre les raisons de son comportement. La condamnation ne sauve aucune âme.",shape=box,color=blue];
		j2486698030 -> j657526238;
	j2051024787 [label="Il y a toujours une souffrance que l'on cache à ceux qui nous entourent. Quelque chose que l'on cherche à protéger, de peur que d'autres ne s'en servent. Je suppose que je devrais m'efforcer d'être plus gentille avec lui, si ce que tu dis est vrai.",shape=box,color=blue];
		j2051024787 -> j657526238;
	j1750703752 [label="Je n'arrive pas à imaginer la quantité d'amour et de décès qu'on doit endurer pendant toutes ces années. Cela me paraît tellement irréel, même après tout ce que j'ai vu.",shape=box,color=blue];
		j1750703752 -> j1463820445;
	j1491670577 [label="Parfois, quand je lui parle, j'oublie combien de siècles il a traversés. Cela me paraît tellement irréel, même compte tenu de tout ce que j'ai vu.",shape=box,color=blue];
		j1491670577 -> j3089502486;
	j1158694490 [label="Il y a toujours des nuances, n'est-ce pas? Toujours des raisons d'agir d'une manière ou d'une autre. Je suppose que je devrais m'efforcer d'être plus gentille avec lui, si ce que tu dis est vrai.",shape=box,color=blue];
		j1158694490 -> j657526238;
	j1569208741 [label="Personne n'a jamais mis la malice du diable en doute.",shape=box,color=blue];
		j1569208741 -> j1769565434;
	j3659551837 [label="Tu me surprends. C'est impressionnant. ",shape=box,color=red];
		j3659551837 -> j801038358;
