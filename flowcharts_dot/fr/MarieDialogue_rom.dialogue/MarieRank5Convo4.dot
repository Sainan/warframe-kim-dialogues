		3019 -> 3028;
	3020 [label="En fait, j'aime bien ça, aussi bizarre que cela puisse paraître. On s'entend bien.",shape=box,color=red];
		3020 -> 3029;
	3027 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3027 -> 3035;
	3032 [label="Le diable est capricieux! C'est la vie, comme on dit!",shape=box,color=blue];
		3032 -> 3039;
	3033 [label="Et je ne suis pas assez naïve pour ne pas voir le rôle que tu as joué pour que tout cela se produise!",shape=box,color=blue];
		3033 -> 3040;
	3034 [label="Check boolean MarieDating",color=orange];
		3034 -> 3041 [label=true,color=green];
