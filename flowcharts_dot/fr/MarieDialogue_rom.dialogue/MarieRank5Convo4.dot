	2975 [label="Bonjour, bonjour, mon cœur! J'y ai réfléchi... et j'ai vraiment du mal à l'admettre. Cela ne me fait pas plaisir de le dire.",shape=box,color=blue];
		2975 -> 2981;
	2974 [label="Bonjour! J'y ai réfléchi... et j'ai vraiment du mal à l'admettre. Cela ne me fait pas plaisir de le dire.",shape=box,color=blue];
		2974 -> 2981;
	2980 [label="Mais j'ai l'impression qu'il nous faut... une sorte de bastion, non? Aurais-tu des idées?",shape=box,color=blue];
		2980 -> 2984;
		2980 -> 2983;
	2982 [label="Mais je pense... je pense – ah, Sol, pardonne-moi – qu’il faudra peut-être faire appel au diable. Je ne crois pas que Monsieur Loid nous écoutera autrement.",shape=box,color=blue];
		2982 -> 2986;
	2983 [label="Je pense que nous aurons peut-être besoin de l'aide de Roathe pour convaincre Loid de parler à la famille Entrati. Je ne crois pas qu'il le fera autrement, sans garanties de protection pour lui et pour la famille.",shape=box,color=red];
		2983 -> 2987;
	2981 [label="Je crois que tu as raison. Le diable est peut-être la pièce manquante. Ah, rien que d'écrire ces mots, ça me fait mal! ",shape=box,color=blue];
		2981 -> 2985;
	2984 [label="Je n'ai pas vraiment de bonnes idées qui n'impliquent pas de faire appel à des sources déplaisantes. Des sources qui pourraient bien nous attirer de sérieux ennuis plus tard. Notamment, Roathe.",shape=box,color=red];
		2984 -> 2988;
	2986 [label="Le diable est puissant et il peut être utile si les choses tournent mal, n'est-ce pas?",shape=box,color=blue];
		2986 -> 2993;
		2986 -> 2994;
	2987 [label="Je... déteste l'admettre, mais je crois que tu as raison... Sol, pardonne-moi.",shape=box,color=blue];
