		3028 -> 3036;
	3029 [label="Oui, il semble bien t'apprécier. Peut-être est-ce parce que vous partagez la même époque et le même lieu, contrairement à nous? Sinon, pourquoi est-ce que ce serait le cas?",shape=box,color=blue];
		3029 -> 3036;
