	j2433435824 [label="S'il te plaît, fais cesser cela! Bientôt, je me surprendrai à rire de ses blagues. Alors, je saurai que je suis vraiment perdue!",shape=box,color=blue];
		j2433435824 -> j758933647;
	j2069001340 [label="As-tu réfléchi davantage à la façon de convaincre Loid de parler à la famille Entrati à l'étage?",shape=box,color=red];
		j2069001340 -> j3487613436;
	j2369032339 [label="J'ai réfléchi à comment convaincre Loid de monter ces escaliers pour enfin parler à la famille et... j'ai une idée, mais je ne pense pas qu'elle te plaira.",shape=box,color=red];
		j2369032339 -> j668862974;
	j1264082204 [label="Marie, es-tu toujours partante pour... peut-être essayer de convaincre Loid de parler aux \"voisins du dessus\"? Je sais que nous sommes restés sur une note bizarre.",shape=box,color=red];
		j1264082204 -> j374072022;
	j3053222685 [label="Concernant l'idée de mettre Loid et la famille Entrati en contact, je me demandais... si tu avais reconsidéré l’implication de Roathe?",shape=box,color=red];
		j3053222685 -> j374072022;
	j2800838031 [label="Je me demande pourquoi Monsieur Loid a si peur de parler à la famille du Cardinal.",shape=box,color=blue];
		j2800838031 -> j3296469326;
	j758933647 [label="Check boolean MarieNoDate",color=orange];
