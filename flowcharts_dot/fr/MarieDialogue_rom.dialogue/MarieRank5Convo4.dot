	2999 [label="Non, malheureusement... Je crois que c'était une impasse. Penses-tu qu'il y ait une autre solution?",shape=box,color=red];
		2999 -> 3006;
	3000 [label="Il le fera. Je l'ai convaincu de m'aider à les réunir – et tu ne vas pas le croire – afin qu'il puisse protéger la famille d'Entrati. Après tout, ils sont les seuls Orokins survivants.",shape=box,color=red];
		3000 -> 3007;
	3001 [label="Il le fera. Je l'ai convaincu de les aider à se réunir – et cela ne te surprendra pas – surtout pour embêter Albrecht en son absence.",shape=box,color=red];
		3001 -> 3008;
	2997 [label="J'y travaille encore, mais je pense que oui.",shape=box,color=red];
		2997 -> 3004;
	2998 [label="Rien n'est encore gagné. Il est... enfin, tu sais comment il est.",shape=box,color=red];
		2998 -> 3005;
