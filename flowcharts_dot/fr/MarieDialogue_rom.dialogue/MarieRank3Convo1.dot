		917 -> 931 [label="DrifterFaithBalance",color=purple];
		917 -> 929 [label="false",color=purple];
	918 [label="On m'a parlé de l'Infestation, j'en sais peu de choses... mais je te crois. Et si ce que je ressens est vrai, et j'espère que c'est le cas, je ne pense pas qu'elle soit piégée.",shape=box,color=blue];
		918 -> 933;
	919 [label="C'est vraiment gentil de ta part de dire ça. Si ce que je ressens est vrai, et j'espère que c'est le cas, alors oui, je pense que tu as raison. Je ne pense pas qu'elle soit piégée.",shape=box,color=blue];
		919 -> 933;
	920 [label="Si ce que je ressens est la vérité, et je prie pour que ce soit le cas, alors non, je ne pense pas qu’elle soit piégée.",shape=box,color=blue];
		920 -> 933;
	921 [label="Si ce que je ressens est vrai, et je prie pour que ce soit le cas, alors oui, tu as raison. Et ils restent pour nous aider. Je ne pense pas qu'elle soit piégée.",shape=box,color=blue];
		921 -> 933;
	922 [label="Oui, j'ai été bénie par le Cardinal... mais je sais que mon amour pour lui est pur, car il n'est pas entaché de chagrin, de haine ou de ressentiment.",shape=box,color=blue];
		922 -> 934;
	925 [label="Je sais que tu le prends pour un monstre terrible. Mais je dois te demander: qu’est-ce qui te pousse à te méfier de lui à ce point?",shape=box,color=blue];
		925 -> 937;
		925 -> 939;
		925 -> 938;
	923 [label="Je pensais que tu croyais en lui? Pourquoi ce changement d'avis soudain? ",shape=box,color=blue];
		923 -> 935;
		923 -> 936;
	924 [label="Pourquoi te méfies-tu autant de lui?",shape=box,color=blue];
		924 -> 937;
		924 -> 938;
		924 -> 939;
	928 [label="Oui, et tu changes d'avis si vite? Tu mens. À quelles fins, je l'ignore. Et je ne veux pas le savoir.",shape=box,color=blue];
		928 -> 941;
	926 [label="+5 Chemistry",color=orange];
		926 -> 940;
	927 [label="Update boolean MarieEntratiFan1",color=orange];
		927 -> 940;
	930 [label="Pour ceux d'entre nous qui suivent le chemin de Sol, nous devons toujours être la lumière qui guide ceux qui sont à la croisée des chemins, non? ",shape=box,color=blue];
		930 -> 942;
	932 [label="En tant qu'adepte de Lua, tu devrais savoir que nous enseignons que certains doivent marcher seuls dans l'ombre, oui?",shape=box,color=blue];
		932 -> 942;
	931 [label="En tant qu'adepte des Luminaires, tu devrais savoir que nous enseignons que certains marchent seuls sur les routes de l'inconnu, oui?",shape=box,color=blue];
		931 -> 942;
	929 [label="Dans ma foi, nous connaissons ceux qui parcourent les chemins de la vie et se retrouvent au carrefour où Lua et Sol se rencontrent. ",shape=box,color=blue];
		929 -> 942;
	933 [label="D'elle, je ne ressens que la chaleur du sourire de Sol. Le Cardinal a fait preuve de sagesse, je crois, dans son choix. Je suis honorée de la porter dans mes veines.",shape=box,color=blue];
		933 -> 908;
		933 -> 907;
		933 -> 905;
		933 -> 906;
	934 [label="Je lui pardonne de nous avoir quittés. Je ne pense pas que quiconque d'autre le fera...",shape=box,color=blue];
		934 -> 943;
		934 -> 944;
		934 -> 937;
		934 -> 938;
	937 [label="Il... est venu à Duviri. Il y a longtemps...",shape=box,color=red];
		937 -> 947;
	939 [label="Eh bien, pour commencer, il m’a tiré une balle dans la poitrine avant de me laisser agoniser.",shape=box,color=red];
		939 -> 948;
	938 [label="Il ne laisse derrière lui que douleur, mort et abandon.",shape=box,color=red];
		938 -> 917;
	935 [label="Je ne lui ai jamais fait confiance, je ne voulais juste pas t'effrayer.",shape=box,color=red];
		935 -> 945;
	936 [label="Je ne voulais pas te mentir, je ne savais juste pas comment aborder le sujet. Tu l'adores, visiblement...",shape=box,color=red];
		936 -> 946;
	941 [label="Update boolean MarieNoDate",color=orange];
		941 -> 950;
	940 [label="Oui, nous devons rester forts! Braves contre les ténèbres, pour toujours et à jamais!",shape=box,color=blue];
		940 -> 949;
	942 [label="Update boolean DrifterCrossroads",color=orange];
		942 -> 951;
	943 [label="Il a blessé et abandonné beaucoup de gens, tu as raison. Et je pense qu'il s'est senti obligé de le faire.",shape=box,color=red];
		943 -> 952;
	944 [label="C'est difficile quand quelqu'un qui compte tant pour toi, que tu aimes et sur qui tu comptes s'en va. Surtout si tu ne sais pas pourquoi. Ou s'il ne revient pas.",shape=box,color=red];
		944 -> 953;
	947 [label="Par Sol! Ce monde que tu as créé, invoqué à partir du livre écrit par sa fille, oui? Monsieur Loid en a parlé... Le Cardinal était là? Pourquoi? ",shape=box,color=blue];
		947 -> 956;
		947 -> 957;
		947 -> 958;
	948 [label="Et pourtant, tu es toujours en vie, n'est-ce pas? Et en bonne santé? Et prospère, si l'on en croit les récits de Monsieur Loid sur tes aventures dans le passé et le futur.",shape=box,color=blue];
		948 -> 959;
	945 [label="Ah, je vois! Je suis une idiote, c'est ça?! Juste une petite invalide venue d'un passé lointain, incapable de penser par elle-même?! Mieux vaut l'approcher comme un faon dans les bois, de peur de l'effrayer!",shape=box,color=blue];
		945 -> 954;
	946 [label="Ah, oui... Je ne t'ai pas facilité la tâche pour dire la vérité, n'est-ce pas?",shape=box,color=blue];
		946 -> 955;
	950 [label="Chat ends.",color=orange];
	949 [label="Je lui ai pardonné de nous avoir quittés. Je ne pense pas que quiconque d'autre le fera...",shape=box,color=blue];
		949 -> 943;
		949 -> 944;
	951 [label="Le Cardinal doit retrouver son chemin vers nous. Nous ne pouvons que faire notre possible pour l'aider lorsqu'il appelle et obéir aux ordres de ceux qui sont bénis comme lui.",shape=box,color=blue];
		951 -> 960;
	952 [label="+5 Chemistry",color=orange];
		952 -> 961;
	953 [label="+5 Chemistry",color=orange];
		953 -> 962;
	956 [label="Je pense qu'au début, une part de lui cherchait un peu de la fille qu'il avait laissée derrière lui. Mais au lieu de cela, il a trouvé un moyen de combattre l'Indifférence – avec les émotions dont il cherchait à se distancier.",shape=box,color=red];
		956 -> 964;
	957 [label="Ses notes racontent une histoire très odieusement flatteuse sur la façon dont il est allé étudier l'incarnation conceptuelle et en est ressorti en apprenant la valeur de la lutte contre l'Indifférence.",shape=box,color=red];
		957 -> 965;
	958 [label="Si l'on en croit ses notes, il était là pour apprendre à Duviri – et par extension à moi – comment se défendre contre l'Indifférence. Qu'est-ce que cela a apporté de bon, au final?",shape=box,color=red];
		958 -> 966;
	959 [label="Check boolean IsDating",color=orange];
		959 -> 968 [label=true,color=green];
		959 -> 967 [label=false,color=brown];
	954 [label="Va t'asseoir sur une ruche.",shape=box,color=blue];
		954 -> 963;
	955 [label="Maintenant, dis-moi la vérité, loup. Pourquoi crois-tu qu'il ne mérite pas ta confiance? Et je m'efforcerai de garder mon calme.",shape=box,color=blue];
		955 -> 944;
		955 -> 937;
		955 -> 938;
		955 -> 939;
	960 [label="Evaluate expressions",color=orange];
		960 -> 969 [label="MarieEntratiMonster1",color=purple];
		960 -> 971 [label="MarieEntratiMonster1",color=purple];
		960 -> 969 [label="MarieEntratiFan1",color=purple];
		960 -> 972 [label="MarieEntratiFan1",color=purple];
		960 -> 969 [label="false",color=purple];
		960 -> 971 [label="false",color=purple];
		960 -> 972 [label="false",color=purple];
		960 -> 970 [label="false",color=purple];
	961 [label="Oui, tu as raison. Je pense que la culpabilité le hante pour tout ce qu'il a fait. Je pense qu'il prend ses distances avec les autres de manière très intentionnelle.",shape=box,color=blue];
		961 -> 973;
	962 [label="Oui, c'est un chagrin terrible, une douleur atroce. Savoir que quelqu'un est encore en vie et semble choisir de ne pas être à tes côtés?",shape=box,color=blue];
		962 -> 973;
	964 [label="Mon cœur se brise dans la tragédie - Je ne pense pas pouvoir supporter cette tristesse... et ainsi, elle ne lui pardonnera pas ?",shape=box,color=blue];
		964 -> 975;
		964 -> 976;
	965 [label="Sais-tu pourquoi il est parti?",shape=box,color=blue];
		965 -> 975;
		965 -> 977;
	966 [label="Que veux-tu dire? ",shape=box,color=blue];
		966 -> 978;
		966 -> 979;
	968 [label="En fait, si les rumeurs qui circulent parmi les Cavias sont vraies, c'était plutôt joyeux là-bas, non?",shape=box,color=blue];
		968 -> 967;
	967 [label="Non, le Cardinal a fait bien pire à beaucoup d'autres, c'est juste un inconvénient qui te contrarie.",shape=box,color=blue];
		967 -> 917;
	963 [label="Update boolean MarieNoDate",color=orange];
		963 -> 974;
	969 [label="J'aimerais juste... que nous puissions faire en sorte que tout le monde autour d'Entrati arrête de se blâmer et de blâmer les autres pour ce qui est arrivé.",shape=box,color=red];
		969 -> 980;
	971 [label="Je ne sais pas si je le qualifierais de béni.",shape=box,color=red];
		971 -> 982;
	972 [label="Il serait beaucoup plus facile de pardonner à Entrati ses méfaits si je pouvais les comprendre.",shape=box,color=red];
		972 -> 983;
	970 [label="Je ferai ce qu'il attend de moi pour résoudre ce problème. Et ensuite, je le jugerai, une fois que tout sera réglé.",shape=box,color=red];
		970 -> 981;
	973 [label="Il inflige la douleur dans le cœur des autres, car la douleur vaut mieux que rien du tout. Car la souffrance vaut mieux que le vide, non?",shape=box,color=blue];
		973 -> 984;
	975 [label="Quand il ne s'explique pas, tout ce que nous pouvons faire, c'est inventer nos propres raisons, j'en ai peur.",shape=box,color=red];
		975 -> 985;
	976 [label="Tu n'as pas compris l'essentiel. Entrati qui me laisse là. Il a vu quelqu'un abandonné dans le Néant et il l'a laissé là.",shape=box,color=red];
		976 -> 986;
	977 [label="Non. Je sais juste qu'il a choisi de me laisser là. Il a vu quelqu'un abandonné dans le Néant et il l'a juste... laissé là.",shape=box,color=red];
		977 -> 985;
	978 [label="Il a décidé de me laisser là. Il est arrivé, à un moment que j'ignore, et a vu quelqu'un abandonné dans le Néant et... l'a laissé là.",shape=box,color=red];
		978 -> 986;
	979 [label="L'Indifférence est venue pour attaquer Duviri de toute manière. (Elle a bénéficié d'une aide inattendue, cela dit. Mais ce n'est pas le problème.)",shape=box,color=red];
		979 -> 987;
	974 [label="Chat ends.",color=orange];
	980 [label="Update boolean MarieEntratiFamily",color=orange];
		980 -> 988;
	982 [label="Nous pouvons donc continuer à être d'accord sur le fait que nous ne sommes pas d'accord, je pense.",shape=box,color=blue];
		982 -> 990;
	983 [label="Je prie pour que nous y parvenions enfin. Je prie pour que nous survivions tous assez longtemps pour le voir. Mais pour l'instant, je vois la famille autour de moi et je prie pour qu'elle trouve le pardon dans son cœur. Pour son propre bonheur.",shape=box,color=blue];
		983 -> 991;
	981 [label="+10 Chemistry",color=orange];
		981 -> 989;
	984 [label="C'est une leçon que mon cher Lyon connaît mieux que quiconque... Je suis si heureuse qu'il te parle, maintenant. Mais nous parlons du Cardinal, aujourd'hui.",shape=box,color=blue];
		984 -> 992;
	985 [label="Je ne peux que supposer que cela s'est produit avant le... meurtre à l'infini.",shape=box,color=red];
		985 -> 993;
	986 [label="Et tu ne sais pas pourquoi il a choisi de te laisser là?",shape=box,color=blue];
		986 -> 994;
		986 -> 985;
		986 -> 995;
	987 [label="Non. Attends. L'Indifférence a... un allié?",shape=box,color=blue];
		987 -> 996;
		987 -> 997;
	988 [label="Add 1 to Family",color=orange];
		988 -> 998;
	990 [label="Update boolean MarieEntratiMonster2",color=orange];
		990 -> 1000;
	991 [label="Update boolean MarieEntratiFan2",color=orange];
		991 -> 1000;
	989 [label="Oui, c'est raisonnable et assez juste, compte tenu de tout ce que tu as vu et de tout ce que tu sais. Je ne peux pas t'en demander plus.",shape=box,color=blue];
		989 -> 999;
	992 [label="Update boolean MarieLyonSuffering3",color=orange];
		992 -> 917;
	993 [label="Je dois alors te demander de ne pas imaginer le pire, car cela rendrait ton cœur amer. ",shape=box,color=blue];
		993 -> 1001;
	994 [label="J’espère seulement qu’il avait une bonne raison.",shape=box,color=red];
		994 -> 1002;
	995 [label="Non, et ça n'a pas d'importance. Il aurait pu me sauver. Et il ne l'a pas fait.",shape=box,color=red];
		995 -> 1003;
	996 [label="Elle affiche juste un autre visage.",shape=box,color=red];
		996 -> 1004;
	997 [label="Peut-être? Ou un otage. Ou juste son visage. On ne sait pas vraiment.",shape=box,color=red];
		997 -> 1004;
	998 [label="+10 Chemistry",color=orange];
		998 -> 1005;
	1000 [label="Ah, Lyon m'appelle. À la revoyure!",shape=box,color=blue];
		1000 -> 1006;
