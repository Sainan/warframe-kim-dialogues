		867 -> 871;
	870 [label="Parle-moi, loup, de celle qu'on appelle \"Wisp\" dont le sang corrompu coule en moi et qui m'a donné ce don de vol. Je sens son âme dans l'ombre de la nuit, si proche de la mienne.",shape=box,color=blue];
		870 -> 874;
		870 -> 873;
	869 [label="Parle-moi, loup, de celle qu'on appelle \"Wisp\" dont le sang corrompu coule en moi et qui m'a donné ce don de vol. Je sens son âme dans l'ombre de la nuit, si proche de la mienne.",shape=box,color=blue];
		869 -> 872;
	871 [label="Vraiment? Les archives se perdent-elles au fil du temps, ou penses-tu qu'elles n'ont tout simplement pas été jugées suffisamment importantes pour être conservées?",shape=box,color=blue];
		871 -> 875;
		871 -> 876;
		871 -> 877;
	874 [label="Nous ne savons pas grand-chose sur les personnes à l'origine des Warframes originelles, j'en ai peur.",shape=box,color=red];
		874 -> 881;
	873 [label="On ne sait pas grand-chose sur la Wisp originelle, j'en ai peur.",shape=box,color=red];
		873 -> 881;
	872 [label="Si parler des âmes ne te dérange pas; je comprendrais que cela puisse être le cas et nous pourrions nous limiter à des aspects plus pratiques. Je ne souhaite pas te mettre mal à l'aise.",shape=box,color=blue];
		872 -> 880;
		872 -> 879;
		872 -> 878;
	875 [label="Je pense qu’elles n’étaient pas assez importantes pour être conservées.",shape=box,color=red];
		875 -> 882;
	876 [label="Je pense qu'elles ont été perdues au fil du temps.",shape=box,color=red];
		876 -> 882;
	877 [label="Un peu des deux, finalement. Elles étaient... à la fois une arme et une œuvre d'art pour leur créateur principal.",shape=box,color=red];
		877 -> 883;
	881 [label="Vraiment? Car j'ai l'impression de la connaître comme si elle était ma propre sœur – et une de mon sang, pas une de la Cathédrale.",shape=box,color=blue];
		881 -> 887;
	880 [label="Très bien, nous pouvons parler des âmes.",shape=box,color=red];
		880 -> 874;
		880 -> 873;
		880 -> 886;
	879 [label="Je ne crois pas vraiment aux âmes, alors nous devrions nous en tenir aux faits concrets, si c'est possible?",shape=box,color=red];
		879 -> 885;
	878 [label="[Fin.]",shape=box,color=red];
		878 -> 884;
	882 [label="Tu vois? Ces Orokins, ce sont des diables.",shape=box,color=blue];
		882 -> 888;
		882 -> 889;
	883 [label="+5 Chemistry",color=orange];
		883 -> 890;
	887 [label="Je ne l'entends pas, pas comme Lyon entend les dieux et ses esprits protecteurs. Je ne la vois pas. Je la sens simplement là, à mes côtés.",shape=box,color=blue];
		887 -> 893;
	886 [label="[Fin.]",shape=box,color=red];
		886 -> 892;
	885 [label="Update boolean DrifterFaithStop",color=orange];
		885 -> 891;
	884 [label="Chat ends.",color=orange];
	888 [label="Les armes peuvent servir aussi bien à protéger qu'à nuire. On n'aime pas en avoir besoin, mais... on en a besoin.",shape=box,color=red];
		888 -> 894;
	889 [label="Pas tous. Mais celui-là? Oui. Il y en a quand même que je ne condamnerais pas immédiatement.",shape=box,color=red];
		889 -> 895;
	890 [label="Une horrible toile d'os peinte avec du sang... tu vois? Ces Orokins, ce sont des démons.",shape=box,color=blue];
		890 -> 888;
		890 -> 889;
	893 [label="Comme une vieille amie, peut-être. Je sais ce qu'elle aimait, je sais comment elle bougeait. Je me souviens du son de son rire porté par le vent...",shape=box,color=blue];
		893 -> 897;
	892 [label="Chat ends.",color=orange];
	891 [label="+5 Chemistry",color=orange];
		891 -> 896;
	894 [label="Add -1 to Thermostat",color=orange];
		894 -> 898;
	895 [label="Add 1 to Thermostat",color=orange];
		895 -> 899;
	897 [label="Je dois te paraître complètement folle! Pardonne-moi.",shape=box,color=blue];
		897 -> 901;
		897 -> 902;
		897 -> 903;
		897 -> 904;
	896 [label="Oui, bien sûr! Personne n'aime se faire sermonner et encore moins par une Sœur. Je comprends. Merci, je ne veux pas me ridiculiser.",shape=box,color=blue];
		896 -> 868;
		896 -> 867;
		896 -> 900;
	898 [label="Oui, c'est vrai. Je suis une arme maintenant, comme le sait le Murmure! Mais je cherche à suivre le chemin que le Cardinal m'a tracé, béni soit-il.",shape=box,color=blue];
		898 -> 905;
		898 -> 906;
	899 [label="Comme le Cardinal. Il était Orokin, non? Et ce n'est certainement pas quelqu'un que je condamnerais. Sans lui, je ne serais pas ce que je suis aujourd'hui. Quelle bénédiction!",shape=box,color=blue];
		899 -> 907;
		899 -> 908;
	901 [label="Les Warframes n'étaient pas conçues avec la plus grande gentillesse. J'espère juste qu'elle n'est pas piégée dans l'Infestation.",shape=box,color=red];
		901 -> 910;
	902 [label="Je pense que peu importe qui était Wisp, elle serait heureuse de te connaître dans tous les cas.",shape=box,color=red];
		902 -> 911;
	903 [label="J’espère que leurs âmes ont pu avancer et trouver le repos, mais je pense qu’une partie de leur mémoire demeure.",shape=box,color=red];
		903 -> 912;
	904 [label="Pas du tout. Je crois que certaines personnes transformées en warframes restent présentes un peu dans leurs schémas de base.",shape=box,color=red];
		904 -> 913;
	900 [label="[Fin.]",shape=box,color=red];
		900 -> 909;
	905 [label="Il y a beaucoup de choses sur lesquelles je pourrais discuter avec lui, mais je dirais qu'il semble avoir un bon instinct pour savoir à qui administrer quel sérum de protoframe. Même si j'ignore pourquoi il le fait.",shape=box,color=red];
		905 -> 914;
	906 [label="J'aimerais que tu ne fasses pas autant confiance à Entrati. Nous ignorons pourquoi il agit ainsi et ses motivations sont obscures.",shape=box,color=red];
		906 -> 915;
	907 [label="Il faut rester avec Entrati. Je pense qu'il faut le suivre où il va. Il est notre seule chance d'arrêter l'Indifférence.",shape=box,color=red];
		907 -> 916;
	908 [label="C'est un menteur, Marie. Il abandonne et blesse tout le monde. Il t'a déjà abandonnée, tu ne vois pas? ",shape=box,color=red];
		908 -> 917;
