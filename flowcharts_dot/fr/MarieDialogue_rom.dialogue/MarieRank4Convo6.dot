	"MarieRank4Convo6 begins." [color=orange];
		"MarieRank4Convo6 begins." -> j3345346052;
	j3345346052 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j3345346052 -> j3023286837;
	j3023286837 [label="Check boolean LyonIndifference1",color=orange];
		j3023286837 -> j1244939366 [label=true,color=green];
		j3023286837 -> "Chat ends." [label=false,color=brown];
	j1244939366 [label="Voyageur? Tu as un moment? Je dois te parler de Lyon...",shape=box,color=blue];
		j1244939366 -> j1531216646;
	"Chat ends." [color=orange];
	j1531216646 [label="Check boolean DrifterLyon",color=orange];
		j1531216646 -> j2380278582 [label=true,color=green];
		j1531216646 -> j41915468 [label=true,color=green];
		j1531216646 -> j2429168889 [label=true,color=green];
		j1531216646 -> j2380278582 [label=false,color=brown];
		j1531216646 -> j528962789 [label=false,color=brown];
		j1531216646 -> j2429168889 [label=false,color=brown];
	j2380278582 [label="C'est un adulte. Il peut décider quand il veut parler.",shape=box,color=red];
		j2380278582 -> j2457491907;
	j41915468 [label="Mon cœur se brise de le voir endurer cette souffrance. Je ne sais pas comment l'aider.",shape=box,color=red];
		j41915468 -> j353968952;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j528962789 [label="Je ne sais pas comment l'aider.",shape=box,color=red];
		j528962789 -> j385401134;
	j2457491907 [label="Lorsque tu étais dans ce monde que tu avais créé, dans ce cycle sans fin de morts, tu as eu de l’aide pour t'échapper?",shape=box,color=blue];
		j2457491907 -> j1265150811;
		j2457491907 -> j3328022458;
	j353968952 [label="Oui, et c'est affreux de le voir souffrir... Surtout maintenant que je sais combien tu lui as fait de la place dans ton cœur.",shape=box,color=blue];
		j353968952 -> j385401134;
	j385401134 [label="Il est difficile de prédire où se situent ses limites. Elles changent souvent d'un jour à l'autre.",shape=box,color=blue];
		j385401134 -> j2854180453;
	j1265150811 [label="Aucune des aides n'aurait été utile si je n'avais pas voulu recevoir de l'aide.",shape=box,color=red];
		j1265150811 -> j1038924394;
		j1265150811 -> j1089425726;
	j3328022458 [label="Oui. Des amis.",shape=box,color=red];
		j3328022458 -> j1038924394;
		j3328022458 -> j1089425726;
	j2854180453 [label="Je l'ai vu lutter contre les souffrances que les dieux lui avaient infligées. J'ai su quand me taire à ses côtés, ou quand être le mur proverbial sur lequel il pouvait frapper du poing.",shape=box,color=blue];
		j2854180453 -> j2109681124;
	j1038924394 [label="Je ne pense pas que Lyon veuille de mon aide.",shape=box,color=red];
		j1038924394 -> j1311252475;
	j1089425726 [label="J'essaie d'être là pour lui, mais il n'écoute pas.",shape=box,color=red];
		j1089425726 -> j3114641701;
	j2109681124 [label="Mais ça? Cet endroit, les paroles du diable, l'incertitude que le Cardinal a provoquée... Cela lui a infligé une telle douleur, je ne peux que prier pour qu'il puisse s'en remettre.",shape=box,color=blue];
		j2109681124 -> j708441153;
		j2109681124 -> j1858478174;
	j1311252475 [label="Alors, je suppose... qu'il n'y a plus qu'à être patients, non?",shape=box,color=blue];
		j1311252475 -> j652527721;
	j3114641701 [label="Il ne m'écoute pas non plus, c'est pourquoi je suis venue t'en parler. J'ai toujours su le consoler...",shape=box,color=blue];
		j3114641701 -> j720898163;
	j708441153 [label="Tu admets donc qu'Entrati a fait du mal à Lyon? Et qu'en penses-tu?",shape=box,color=red];
		j708441153 -> j2581708004;
	j1858478174 [label="J'ai l'impression qu'il est au bord du gouffre. Comment puis-je l'aider à se relever?",shape=box,color=red];
		j1858478174 -> j2989260900;
	j652527721 [label="Merci. Je suis désolée de t'avoir fait perdre ton temps.",shape=box,color=blue];
		j652527721 -> "Chat ends.";
	j720898163 [label="Je me retrouve décontenancée par sa rage, son désespoir... il fuit ma compagnie comme jamais auparavant.",shape=box,color=blue];
		j720898163 -> j1543871555;
	j2581708004 [label="Pas bien... Mais comment dois-je choisir entre mon amour pour mon frère et mon adoration pour le Cardinal? Comment dois-je choisir, ils sont ma famille?",shape=box,color=blue];
		j2581708004 -> j127531370;
		j2581708004 -> j182748267;
		j2581708004 -> j594843091;
		j2581708004 -> j3785016329;
	j2989260900 [label="Je ne sais pas, c'est pourquoi je suis venue t'en parler. J'ai toujours su le consoler...",shape=box,color=blue];
		j2989260900 -> j720898163;
	j1543871555 [label="Qu'est-ce qui le trouble tant? En connais-tu la cause?",shape=box,color=blue];
		j1543871555 -> j2411453274;
	j127531370 [label="Tu n'as pas à choisir, Marie. Les gens peuvent être complexes dans leur façon d'intervenir dans nos vies.",shape=box,color=red];
		j127531370 -> j2407639282;
	j182748267 [label="Je choisirais la famille qui est encore ici, pas celle qui t'a quittée.",shape=box,color=red];
		j182748267 -> j3338299860;
	j594843091 [label="Je pense vraiment qu'Entrati ne voulait pas causer ce genre de douleur à Lyon.",shape=box,color=red];
		j594843091 -> j2029346587;
	j3785016329 [label="Tu pourrais choisir une nouvelle famille. Comme moi. Et ceux qui t'entourent et qui se soucient de toi, sans Entrati.",shape=box,color=red];
		j3785016329 -> j1785069671;
	j2411453274 [label="Evaluate expressions",color=orange];
		j2411453274 -> j383771598 [label="DrifterFaithNoMITW",color=purple];
		j2411453274 -> j379567361 [label="DrifterFaithNoMITW",color=purple];
		j2411453274 -> j2320617926 [label="LyonRell3",color=purple];
		j2411453274 -> j379567361 [label="LyonRell3",color=purple];
		j2411453274 -> j2330949941 [label="LyonRoathe3",color=purple];
		j2411453274 -> j379567361 [label="LyonRoathe3",color=purple];
		j2411453274 -> j367227427 [label="LyonEntrati3",color=purple];
		j2411453274 -> j379567361 [label="LyonEntrati3",color=purple];
		j2411453274 -> j379567361 [label="LyonRell1",color=purple];
		j2411453274 -> j1218924087 [label="false",color=purple];
	j2407639282 [label="C'est le problème avec des gens comme Entrati. Ils ne sont pas seulement des forces du \"Bien\" ou du \"Mal\". Ils sont un mélange des deux.",shape=box,color=red];
		j2407639282 -> j850188780;
	j3338299860 [label="Évitons de parler du Cardinal dans cette conversation, d'accord? Je suis inquiète pour le frère de mon âme.",shape=box,color=blue];
		j3338299860 -> j720898163;
	j2029346587 [label="Je ne pense pas non plus, mais le fait demeure, n'est-ce pas? Mais j'apprécie tes paroles. Cela dit...",shape=box,color=blue];
		j2029346587 -> j3338299860;
	j1785069671 [label="Boolean DrifterMarie is now true.",color=orange];
		j1785069671 -> j3981973181;
	j383771598 [label="Lyon essaie d'accepter le fait que l'Indifférence n'est pas un vrai dieu.",shape=box,color=red];
		j383771598 -> j2054396689;
	j379567361 [label="Je ne pense pas qu'il n'y ait qu'une seule cause. Je pense que c'est un mélange de plusieurs facteurs.",shape=box,color=red];
		j379567361 -> j682050935;
	j2320617926 [label="Lyon entendait la voix d'un Tenno, un enfant nommé Rell. Rell... est mort. Je pense qu'il n'arrive pas à gérer ça.",shape=box,color=red];
		j2320617926 -> j3699709148;
	j2330949941 [label="Roathe lui murmure des mensonges à propos de l'Homme dans le Mur.",shape=box,color=red];
		j2330949941 -> j77893264;
	j367227427 [label="Je ne pense pas que le fait qu'Entrati lui murmure que les voix de ses dieux sont en fait les voix du Néant l'ait aidé.",shape=box,color=red];
		j367227427 -> j1864271713;
	j1218924087 [label="Honnêtement, non.",shape=box,color=red];
		j1218924087 -> j2737705825;
	j850188780 [label="Évitons de parler du Cardinal dans cette conversation, d'accord? Je suis inquiète pour le frère de mon âme. Mais... je sais que ce que tu dis... devient de plus en plus la vérité.",shape=box,color=blue];
		j850188780 -> j3425073370;
	j3981973181 [label="Ne crois pas que je n'ai pas vu ce que tu as fait, je te vois venir, loup.",shape=box,color=blue];
		j3981973181 -> j850188780;
	j2054396689 [label="Et tu ne lui as été d'aucune aide à ce niveau, si tu lui parles ainsi. Même si tes paroles sont vraies, il faut être prudent dans la manière dont elles sont perçues.",shape=box,color=blue];
		j2054396689 -> j751825153;
	j682050935 [label="Oui, il a été un abri de la tempête pour tant de personnes... et maintenant, il est lui-même pris dans l'une d'elles.",shape=box,color=blue];
		j682050935 -> j235552460;
	j3699709148 [label="Je l'ai entendu prononcer ce nom, Rell - et cela me brise le cœur de connaître le sort du garçon.",shape=box,color=blue];
		j3699709148 -> j1272033388;
	j77893264 [label="Ce diable a causé tant de malheurs au cours de sa longue vie! Mais je ne pense pas que ce soit la seule cause de ses conflits, non?",shape=box,color=blue];
		j77893264 -> j3012068150;
	j1864271713 [label="S'il te plaît, ne parle plus du Cardinal. Je ne nie pas que ses paroles contribuent aux conflits de Lyon, mais elles ne peuvent en être la seule cause.",shape=box,color=blue];
		j1864271713 -> j1545200998;
	j2737705825 [label="Alors, je suppose... que tout ce que nous pouvons faire est d'être patients et d'espérer découvrir ce qui le trouble.",shape=box,color=blue];
		j2737705825 -> j3838889581;
	j3425073370 [label="Boolean MarieEntrati4a is now true.",color=orange];
		j3425073370 -> j720898163;
	j751825153 [label="La chirurgie ne se pratique pas à la hache. Nous ne somme pas dans l'armée.",shape=box,color=blue];
		j751825153 -> j2427848757;
	j235552460 [label="Déchiré de toutes parts et ne sachant pas où aller...",shape=box,color=blue];
		j235552460 -> j3913172465;
		j235552460 -> j2994455886;
	j1272033388 [label="Mais je ne pense pas que ce soit la seule cause de ses conflits. Lyon suit le chemin de Lua. La mort est une compagne qui marche à ses côtés.",shape=box,color=blue];
		j1272033388 -> j2427848757;
	j3012068150 [label="Cela a accentué son incertitude... Mais accorder autant de valeur aux paroles d'un diable? Mon Lyon vaut mieux que ça. Je pense que beaucoup de choses l'accablent, désormais.",shape=box,color=blue];
		j3012068150 -> j3801788597;
		j3012068150 -> j689055470;
	j1545200998 [label="Boolean MarieEntrati4b is now true.",color=orange];
		j1545200998 -> j1520481504;
	j3838889581 [label="+15 Chemistry",color=orange];
		j3838889581 -> j2731239872;
	j2427848757 [label="Non, je pense que ce sont plusieurs choses qui pèsent désormais sur lui.",shape=box,color=blue];
		j2427848757 -> j3801788597;
		j2427848757 -> j689055470;
	j3913172465 [label="Nous devons être son refuge, alors. Un endroit où il sait qu'on ne lui fera pas de mal.",shape=box,color=red];
		j3913172465 -> j474614021;
	j2994455886 [label="Il faut donc lui montrer le chemin à suivre. Soyons sa lumière dans l'obscurité.",shape=box,color=red];
		j2994455886 -> j3241540959;
	j3801788597 [label="Je suppose... qu'il faut donc lui montrer le chemin à suivre. Soyons sa lumière dans l'obscurité.",shape=box,color=red];
		j3801788597 -> j3241540959;
	j689055470 [label="Je suppose que... nous devons être son refuge, alors. Un endroit où il sait qu'on ne lui fera pas de mal.",shape=box,color=red];
		j689055470 -> j3328972855;
	j1520481504 [label="Il n'a pas accordé suffisamment de poids aux paroles du Cardinal pour se laisser entraîner dans une telle obscurité. Je pense que de nombreux facteurs l'accablent aujourd'hui.",shape=box,color=blue];
		j1520481504 -> j689055470;
		j1520481504 -> j3801788597;
	j2731239872 [label="Merci. Je sais que tu fais de ton mieux. Et je t'en suis reconnaissante.",shape=box,color=blue];
		j2731239872 -> "Chat ends.";
	j474614021 [label="+10 Chemistry",color=orange];
		j474614021 -> j990946348;
	j3241540959 [label="Comment aider quelqu'un qui n'entend pas ton appel, qui ne voit pas ta lumière? Non, Lua l'a enveloppé de cette obscurité.",shape=box,color=blue];
		j3241540959 -> j3026917005;
	j3328972855 [label="+5 Chemistry",color=orange];
		j3328972855 -> j990946348;
	j990946348 [label="Oui, je suppose que tu as raison. Nous devons être ceux vers qui il peut se tourner quand tout le reste le déçoit.",shape=box,color=blue];
		j990946348 -> j2162300548;
	j3026917005 [label="Je ne pense pas que même la lumière de Sol puisse percer le voile.",shape=box,color=blue];
		j3026917005 -> j2162300548;
	j2162300548 [label="Là où sa foi peut vaciller, nous devons être le sol sous ses pieds. ",shape=box,color=blue];
		j2162300548 -> j1897120077;
	j1897120077 [label="Si toutes les voix invisibles sont passées de fantômes bienveillants à démons dans l'ombre qui le tourmente -",shape=box,color=blue];
		j1897120077 -> j3896721973;
	j3896721973 [label="Nous devons nous rendre d’autant plus réels, non?",shape=box,color=blue];
		j3896721973 -> j3630101650;
		j3896721973 -> j15312283;
	j3630101650 [label="Je vais continuer d'essayer.",shape=box,color=red];
		j3630101650 -> j3518432245;
	j15312283 [label="J'espère juste que cela ne le détruira pas.",shape=box,color=red];
		j15312283 -> j1160801500;
	j3518432245 [label="+10 Chemistry",color=orange];
		j3518432245 -> j3780005763;
	j1160801500 [label="+5 Chemistry",color=orange];
		j1160801500 -> j3666607917;
	j3780005763 [label="C'est tout ce que nous pouvons faire, en fin de compte.",shape=box,color=blue];
		j3780005763 -> j2980618685;
	j3666607917 [label="Oui... moi aussi. Mais tout ce que nous pouvons faire, c'est nous tenir à ses côtés et prier, non?",shape=box,color=blue];
		j3666607917 -> j2644463189;
	j2980618685 [label="Essayer. Et prier.",shape=box,color=blue];
		j2980618685 -> j290290920;
	j2644463189 [label="Et espérer qu’il ne soit pas trop tard.",shape=box,color=blue];
		j2644463189 -> j290290920;
	j290290920 [label="Merci... Je dois y aller. Je suis désolée si cette conversation n'a pas été très utile. Je suis inquiète quand je ne peux pas agir.",shape=box,color=blue];
		j290290920 -> j888176930;
		j290290920 -> j440382819;
	j888176930 [label="Pareil pour moi. Mais parfois, agir est un mauvais choix.",shape=box,color=red];
		j888176930 -> j1820955199;
	j440382819 [label="Tout ira bien. Je le sais.",shape=box,color=red];
		j440382819 -> j1820955199;
	j1820955199 [label="Je prie pour que tu aies raison. Je ne sais pas ce que je ferais sans lui.",shape=box,color=blue];
		j1820955199 -> "Chat ends.";
}