digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo3 begins." [color=orange];
		"MarieRank4Convo3 begins." -> j2738738976;
		"MarieRank4Convo3 begins." -> j2429168889;
	j2738738976 [label="Comment vas-tu aujourd'hui, Marie?",shape=box,color=red];
		j2738738976 -> j649782309;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j649782309 [label="Pas très bien. Reviens me parler demain. Je ne serais pas de bonne compagnie.",shape=box,color=blue];
		j649782309 -> j1659075231;
		j649782309 -> j1481158567;
		j649782309 -> j3751391266;
	"Chat ends." [color=orange];
	j1659075231 [label="Je m'en irai si tu veux, mais si tu préfères parler, je t'écouterai avec plaisir.",shape=box,color=red];
		j1659075231 -> j821166427;
	j1481158567 [label="Très bien, je comprends.",shape=box,color=red];
		j1481158567 -> "Chat ends.";
	j3751391266 [label="Puis-je te demander ce qui ne va pas...?",shape=box,color=red];
		j3751391266 -> j821166427;
	j821166427 [label="C'est vraiment gentil, mais c'est un vieux problème... rien qui mérite qu'on s'en préoccupe. Ça ira.",shape=box,color=blue];
		j821166427 -> j3096270068;
	j3096270068 [label="Boolean MarieChronicPain is now true.",color=orange];
		j3096270068 -> j725189493;
		j3096270068 -> j876058008;
		j3096270068 -> j4122982446;
	j725189493 [label="Si tu es sûre... mais je suis là, si tu veux en parler.",shape=box,color=red];
		j725189493 -> j2121972747;
	j876058008 [label="Je... sais ce que c'est. Avant de commencer mes \"boucles\", je me suis fait une sacrée blessure à Duviri. C'est guéri, mais ça me fait encore très mal de temps en temps. J'essaie de cacher mes grimaces quand ça se réveille.",shape=box,color=red];
		j876058008 -> j2580845675;
	j4122982446 [label="Les problèmes anciens et persistants peuvent parfois être aussi problématiques que les nouveaux. Ce n'est pas parce qu'ils vont et viennent qu'il faut les laisser perdurer ou qu'il ne faut pas en parler.",shape=box,color=red];
		j4122982446 -> j1825447642;
	j2121972747 [label="Tu es adorable, et... très bien. Je redeviens la petite Marie têtue de nouveau.",shape=box,color=blue];
		j2121972747 -> j492933941;
	j2580845675 [label="Boolean DrifterChronicPain is now true.",color=orange];
		j2580845675 -> j3338144646;
	j1825447642 [label="Oui, tu as raison. Je fais encore la petite Marie têtue.",shape=box,color=blue];
		j1825447642 -> j492933941;
	j492933941 [label="C'est difficile à expliquer, mais je vais essayer. Mes pieds, oui? Mes pieds. Le sérum m'a changée, m'a donné un nouveau souffle.",shape=box,color=blue];
		j492933941 -> j3416796642;
	j3338144646 [label="Par les Luminaires, je suis vraiment désolée. Tu comprends, alors?",shape=box,color=blue];
		j3338144646 -> j545303311;
	j3416796642 [label="Mais je les sens encore, ces choses tordues qui menaçaient de me consumer, menaçaient d'écraser tout espoir et toute joie de mon âme.",shape=box,color=blue];
		j3416796642 -> j1149047681;
	j545303311 [label="Avoir un corps qui te trahit, qui ralentit ton esprit. Même maintenant, c'est si étrange. Le sérum m'a changée, m'a donné le don de voler.",shape=box,color=blue];
		j545303311 -> j3416796642;
	j1149047681 [label="Ils me font toujours mal. Toujours. Même maintenant, assise ici, si je pense à eux, je ressens la douleur. Mais ce n'est pas toujours assez fort pour que je le remarque.",shape=box,color=blue];
		j1149047681 -> j1149564729;
	j1149564729 [label="Et pourtant, maintenant, ils me réveillent la nuit à cause de la douleur. Et je me demande, Sol, pourquoi? Pourquoi dois-je encore ressentir cette... agonie interminable?",shape=box,color=blue];
		j1149564729 -> j2676387346;
	j2676387346 [label="À quoi ça sert? Ah, mais le matin arrive et je ris, et je me dis: \"Tais-toi, Marie, tu as de la chance. Regarde tout ce que tu as, tout ce que tu peux faire.\"",shape=box,color=blue];
		j2676387346 -> j2201171530;
	j2201171530 [label="À la Cathédrale, c'était: \"Tu sais lire, tu sais écrire, tu as à manger, tu sais où dormir. Tu peux te déplacer sans problème. Tu as des yeux pour voir et une langue pour parler. Des mains pour écrire. Des gens qui prennent soin de toi.\" Et maintenant, je peux voler! Je peux protéger l'avenir du Néant lui-même. De l'Indifférence!",shape=box,color=blue];
		j2201171530 -> j537038150;
	j537038150 [label="\"Pleure maintenant, petite idiote, cette douleur constante te rendra forte contre ce qui viendra\", me dis-je. Et le jour passe à un autre, et le suivant est moins pénible.",shape=box,color=blue];
		j537038150 -> j830269311;
	j830269311 [label="Check boolean DrifterChronicPain",color=orange];
		j830269311 -> j3645220092 [label=true,color=green];
		j830269311 -> j12704738 [label=true,color=green];
		j830269311 -> j969963571 [label=false,color=brown];
		j830269311 -> j457376672 [label=false,color=brown];
	j3645220092 [label="S'il y a une chose qu'il nous a donnée, c'est une tolérance à la douleur, je suppose.",shape=box,color=red];
		j3645220092 -> j1630821225;
	j12704738 [label="Parfois... je me réveille et j'ai l'impression que ce sera le jour où je craquerai.",shape=box,color=red];
		j12704738 -> j1630821225;
	j969963571 [label="Ça... ça ne cesse jamais de faire mal? Ça me peine de l'entendre, Marie...",shape=box,color=red];
		j969963571 -> j1863049082;
	j457376672 [label="Et il n'y a pas de médicaments? Pas de traitement?",shape=box,color=red];
		j457376672 -> j1074062107;
	j1630821225 [label="Un paroissien m'a demandé un jour: \"Vous souffrez? Toujours?\" Ce à quoi j'ai répondu: \"Oui, monsieur. C'est le cas.\" Son regard était mêlé d'étonnement et d'horreur.",shape=box,color=blue];
		j1630821225 -> j75490823;
	j1863049082 [label="Parfois, je m'asseyais et je pensais à tout ce que je pourrais faire si je ne souffrais pas autant, tu comprends? Si je n'étais pas si... prisonnière d'une cage de chair qui s'acharnait à me gêner à chaque instant.",shape=box,color=blue];
		j1863049082 -> j3085961000;
	j1074062107 [label="J'aimerais bien. Mais non, il n'y en a pas. Pas à mon époque et je crains que ce ne soit toujours pas le cas aujourd'hui.",shape=box,color=blue];
		j1074062107 -> j3337482622;
	j75490823 [label="\"Comment faites-vous pour continuer?\" fut sa question suivante. Je me souviens lui avoir souri et avoir répondu: \"Que puis-je faire d'autre, Monsieur?\"",shape=box,color=blue];
		j75490823 -> j1775548416;
		j75490823 -> j853475435;
	j3085961000 [label="Que cela me rendait furieuse! Comme je devenais jalouse de ceux dont le corps ne les avait pas trahis à la naissance. Mais à quoi bon, au final, sinon rendre nos vies plus amères? Plus aigries?",shape=box,color=blue];
		j3085961000 -> j2974545531;
	j3337482622 [label="Certaines maladies échappent aux remèdes de l’homme, de la science et de la foi.",shape=box,color=blue];
		j3337482622 -> j1863049082;
	j1775548416 [label="J'ai eu cette même conversation tant de fois...",shape=box,color=red];
		j1775548416 -> j1863049082;
	j853475435 [label="Exactement. Je compatis.",shape=box,color=red];
		j853475435 -> j3603573946;
	j2974545531 [label="Non. Je suis comme je suis et je persévérerai.",shape=box,color=blue];
		j2974545531 -> j2980398560;
	j3603573946 [label="Non, je suis simplement désolée que tu aies aussi connu une telle agonie. ",shape=box,color=blue];
		j3603573946 -> j1863049082;
	j2980398560 [label="Check boolean DrifterChronicPain",color=orange];
		j2980398560 -> j2735531607 [label=true,color=green];
		j2980398560 -> j237043708 [label=false,color=brown];
	j2735531607 [label="Et toi aussi. Toi aussi. En cela, j'ai foi.",shape=box,color=blue];
		j2735531607 -> j237043708;
	j237043708 [label="+20 Chemistry",color=orange];
		j237043708 -> j2704246025;
	j2704246025 [label="Je ne peux pas exprimer avec des mots à quel point cette conversation a été importante pour moi. Alors, je dirai simplement merci, Voyageur.",shape=box,color=blue];
		j2704246025 -> j3563974437;
	j3563974437 [label="Et encore merci.",shape=box,color=blue];
		j3563974437 -> "Chat ends.";
}