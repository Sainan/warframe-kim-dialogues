digraph {
	"MarieRank3Convo6 begins." [color=orange];
		"MarieRank3Convo6 begins." -> j3677674046;
	j3677674046 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j3677674046 -> j3629074729;
	j3629074729 [label="Je dois te poser une question et je dois t'implorer de ne pas me juger pour cela, Voyageur.",shape=box,color=blue];
		j3629074729 -> j2375725584;
		j3629074729 -> j3281906533;
		j3629074729 -> j2429168889;
	j2375725584 [label="Tu te retrouves dans une situation étrange. Bien sûr, que je ne te jugerai pas.",shape=box,color=red];
		j2375725584 -> j29361836;
	j3281906533 [label="Je ferai de mon mieux.",shape=box,color=red];
		j3281906533 -> j1914102732;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j29361836 [label="C'est vraiment gentil de me faire une telle grâce sans me connaître ni savoir ce que je vais t'écrire.",shape=box,color=blue];
		j29361836 -> j3358234083;
	j1914102732 [label="+10 Chemistry",color=orange];
		j1914102732 -> j4151096265;
	"Chat ends." [color=orange];
	j3358234083 [label="Mais... est-ce que le poisson parlant à grosse tête te donne aussi mal à la tête? Fibonacci?",shape=box,color=blue];
		j3358234083 -> j3524525631;
		j3358234083 -> j2772438874;
		j3358234083 -> j1000669315;
	j4151096265 [label="J'apprécie cela, merci.",shape=box,color=blue];
		j4151096265 -> j3358234083;
	j3524525631 [label="Oui. Oui, absolument. Merci.",shape=box,color=red];
		j3524525631 -> j2426607021;
	j2772438874 [label="L’idée que tu sois agacée par Fibonacci est incroyablement charmante.",shape=box,color=red];
		j2772438874 -> j2874922317;
	j1000669315 [label="Non, en fait. Je l'adore.",shape=box,color=red];
		j1000669315 -> j88322814;
	j2426607021 [label="Alors, je suis contente de ne pas être la seule. Mais, soyons clairs, je ne veux pas l'insulter. Si ma situation actuelle me met déjà mal à l'aise, j'imagine qu'il fait de son mieux pour supporter la sienne.",shape=box,color=blue];
		j2426607021 -> j605852591;
	j2874922317 [label="Ah bon? Comment ça? J'imagine que j'en suis ravie, mais je ne comprends pas pourquoi. Mon mal de tête n'est certainement pas aussi charmant.",shape=box,color=blue];
		j2874922317 -> j1367296582;
		j2874922317 -> j189575373;
	j88322814 [label="Alors, je ne peux que te demander pardon, je ne veux pas l'insulter. Si ma situation actuelle me met mal à l'aise, j'imagine qu'il fait de son mieux pour supporter la sienne.",shape=box,color=blue];
		j88322814 -> j4230661864;
	j605852591 [label="Ses moyens pour y parvenir ne me conviennent tout simplement pas lorsque j'y suis soumise longuement, c'est tout.",shape=box,color=blue];
		j605852591 -> j2861807225;
	j1367296582 [label="Je passe le plus clair de mon temps à lutter pour ma survie. Ces petits rappels d'humanité, comme celui-ci, sont... en quelque sorte ma raison de vivre.",shape=box,color=red];
		j1367296582 -> j4203495277;
	j189575373 [label="Je suppose que de temps en temps, je dois prendre du recul et réfléchir à l'absurdité de tout cela. Un Norg et une prêtresse de Sol...",shape=box,color=red];
		j189575373 -> j2535608550;
	j4230661864 [label="Ses moyens pour y parvenir ne me conviennent tout simplement pas lorsque j'y suis soumise longuement, c'est tout.",shape=box,color=blue];
		j4230661864 -> j2861807225;
	j2861807225 [label="Bah. Je ne devrais pas me plaindre du tout. Je dois apporter le dîner à Lyon ce soir, il est encore une fois terrassé par une terrible céphalée.",shape=box,color=blue];
		j2861807225 -> j1717513976;
		j2861807225 -> j2520587580;
	j4203495277 [label="+5 Chemistry",color=orange];
		j4203495277 -> j4119258972;
	j2535608550 [label="+5 Chemistry",color=orange];
		j2535608550 -> j2672669311;
	j1717513976 [label="Est-ce que ça lui arrive souvent?",shape=box,color=red];
		j1717513976 -> j3887388017;
	j2520587580 [label="Pardonne-moi... quoi?",shape=box,color=red];
		j2520587580 -> j3726508446;
	j4119258972 [label="Ne perds jamais cette part de toi, Voyageur. Ne lâche jamais la part de toi qui recherche ces étincelles de vie.",shape=box,color=blue];
		j4119258972 -> j508069808;
	j2672669311 [label="Bon sang, vu comme ça, pas étonnant. On dirait une blague enfantine, n'est-ce pas?",shape=box,color=blue];
		j2672669311 -> j4260901156;
	j3887388017 [label="Oui, oui. Une fois toutes les deux semaines? Une fois tous les deux mois? La plus longue période sans en souffrir, c'est peut-être six mois.",shape=box,color=blue];
		j3887388017 -> j547018639;
	j3726508446 [label="Oh! Eh bien. Imagine un mal de tête, mais en beaucoup plus intense. J'ai entendu dire que certains les appelaient des maux de tête bilieux. Ils sont plus fréquents chez les femmes.",shape=box,color=blue];
		j3726508446 -> j452379339;
		j3726508446 -> j1645980517;
	j508069808 [label="Le monde est bien trop proche de devenir un endroit sombre et grave, prêt à nous infliger des souffrances à chaque instant.",shape=box,color=blue];
		j508069808 -> j3095610983;
	j4260901156 [label="Une Sœur, un Prêtre et un diable du futur sont envoyés dans le passé... puis dans le futur... et rencontrent un poisson, un cerf, un oiseau géant et un majordome...",shape=box,color=blue];
		j4260901156 -> j431491477;
	j547018639 [label="Check boolean Megrim",color=orange];
		j547018639 -> j511024636 [label=true,color=green];
		j547018639 -> j935596937 [label=true,color=green];
		j547018639 -> j3577700569 [label=true,color=green];
		j547018639 -> j511024636 [label=false,color=brown];
		j547018639 -> j935596937 [label=false,color=brown];
		j547018639 -> j237902839 [label=false,color=brown];
	j452379339 [label="Je crois qu'on les appelle plus souvent \"migraines\".",shape=box,color=red];
		j452379339 -> j2230658506;
	j1645980517 [label="Hum. Des céphalées, donc. Merci.",shape=box,color=red];
		j1645980517 -> j2678449669;
	j3095610983 [label="Nous devons rechercher toute la luminosité, toute la légèreté possible, même sous forme d’enfantillages au besoin.",shape=box,color=blue];
		j3095610983 -> j3847735714;
	j431491477 [label="C'est assez amusant, tu as tout à fait raison!",shape=box,color=blue];
		j431491477 -> j3031960249;
	j511024636 [label="Je me demande ce qui les provoque.",shape=box,color=red];
		j511024636 -> j2500217566;
	j935596937 [label="Ça a l'air horrible...",shape=box,color=red];
		j935596937 -> j1037807430;
	j3577700569 [label="J'ai aussi des céphalées. C'est horrible.",shape=box,color=red];
		j3577700569 -> j214527874;
	j237902839 [label="Moi aussi, j'ai ce genre de maux de tête. C'est terrible.",shape=box,color=red];
		j237902839 -> j214527874;
	j2230658506 [label="Je me demande quelles autres particularités linguistiques fascinantes nous allons découvrir! Passionnant. J'adore apprendre de nouvelles choses. \"Migraine\". Le voyage continue.",shape=box,color=blue];
		j2230658506 -> j4274041899;
	j2678449669 [label="Boolean Megrim is now true.",color=orange];
		j2678449669 -> j2970325151;
	j3847735714 [label="Maintenant, si seulement Lyon voyait les choses de la même manière.",shape=box,color=blue];
		j3847735714 -> j3334144156;
	j3031960249 [label="Maintenant, si seulement mon cher Lyon pouvait voir la même luminosité dans tout cela.",shape=box,color=blue];
		j3031960249 -> j3334144156;
	j2500217566 [label="Il a ses théories. ",shape=box,color=blue];
		j2500217566 -> j2090541404;
	j1037807430 [label="Si tu lui fais part de ton soutien, je suis certaine que ce sera bienvenu. Et malgré les apparences, il appréciera la compagnie.",shape=box,color=blue];
		j1037807430 -> j1204814255;
	j214527874 [label="Vraiment? Tu devrais le dire à Lyon. Il doit savoir que d'autres connaissent des souffrances identiques.",shape=box,color=blue];
		j214527874 -> j120370582;
	j4274041899 [label="Boolean Migraine is now true.",color=orange];
		j4274041899 -> j2970325151;
	j2970325151 [label="Peu importe le nom, Lyon est prostré et le restera jusqu'au matin. Le pauvre voit flou, ne sent ni ses mains ni ses pieds. Et il me dit que la douleur est intolérable.",shape=box,color=blue];
		j2970325151 -> j547018639;
	j3334144156 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j3334144156 -> j3466667332;
	j2090541404 [label="Il serait peut-être plus juste de dire qu’il avait ses théories, jusqu’à récemment.",shape=box,color=blue];
		j2090541404 -> j1456995412;
	j1204814255 [label="Même si son attitude peut te dissuader, je t'implore de tenir bon, Voyageur. Sous ses airs stoïques et impassibles se cache un homme aux besoins profonds.",shape=box,color=blue];
		j1204814255 -> j3058231751;
		j1204814255 -> j3730708787;
		j1204814255 -> j3094809141;
	j120370582 [label="+5 Chemistry",color=orange];
		j120370582 -> j3052866838;
	j3466667332 [label="Ah, à ce propos. Je suis désolée de me plaindre de maux de tête. Je dois apporter le dîner à Lyon ce soir; il est encore une fois terrassé par une terrible céphalée.",shape=box,color=blue];
		j3466667332 -> j2520587580;
		j3466667332 -> j1717513976;
	j1456995412 [label="Boolean MarieLyonFaith1 is now true.",color=orange];
		j1456995412 -> j1204814255;
	j3058231751 [label="Je suis l'incarnation de l'entêtement. Ne t'inquiète pas.",shape=box,color=red];
		j3058231751 -> j2182518378;
	j3730708787 [label="J'ai déjà un Homme dans le Mur... pourquoi pas deux?",shape=box,color=red];
		j3730708787 -> j2771988422;
	j3094809141 [label="C'est un adulte. S'il veut parler, il peut parler.",shape=box,color=red];
		j3094809141 -> j2522671906;
	j3052866838 [label="Les Luminaires savent qu'autrement, il souffrirait volontiers seul...",shape=box,color=blue];
		j3052866838 -> j3754839636;
	j2182518378 [label="+5 Chemistry",color=orange];
		j2182518378 -> j2186651395;
	j2771988422 [label="Plaisante avec moi comme ça si tu veux, mais ne lui fais pas de telles remarques. Le sujet de ton Indifférence lui est pénible.",shape=box,color=blue];
		j2771988422 -> j326753288;
	j2522671906 [label="Il est adulte, oui. C'est un homme, oui. Et je crois qu'il a envie de parler. Mais la question est de savoir s'il peut parler.",shape=box,color=blue];
		j2522671906 -> j3538638177;
	j3754839636 [label="Boolean MarieLyonSuffering2 is now true.",color=orange];
		j3754839636 -> j1204814255;
	j2186651395 [label="Tu en auras besoin avec lui, j'en ai peur. Merci, Voyageur. C'est mon ami le plus cher et un frère pour moi. Et ça me brise le cœur de le voir souffrir autant.",shape=box,color=blue];
		j2186651395 -> j367588283;
	j326753288 [label="Fais preuve de résilience. Et de patience. Et de bienveillance. Il est comme un frère pour moi et mon ami le plus cher, Voyageur. Et ça me brise le cœur de le voir souffrir autant.",shape=box,color=blue];
		j326753288 -> j367588283;
	j3538638177 [label="Nous ne sommes pas tous égaux en matière de talents ou nous ne pensons pas y avoir droit. Il souffre et croit que c'est son destin.",shape=box,color=blue];
		j3538638177 -> j3132711043;
	j367588283 [label="On se reparle bientôt. Par la grâce de Sol.",shape=box,color=blue];
		j367588283 -> "Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j3132711043 [label="Il est aussi comme un frère pour moi et mon ami le plus cher. Et mon cœur se brise pour lui. Alors, je ne peux que te demander... de faire preuve de patience. Et de bienveillance. Si tu en es capable.",shape=box,color=blue];
		j3132711043 -> j367588283;
	"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
