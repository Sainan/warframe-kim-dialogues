digraph {
	"MarieRank1Convo1 begins." [color=orange];
		"MarieRank1Convo1 begins." -> j3870579613;
	j3870579613 [label="Bonjour, bonjour, Voyageur! Comment ça va par cette belle journée? Ou soirée? Je ne sais vraiment pas quelle heure il est ici.",shape=box,color=blue];
		j3870579613 -> j1288563452;
	j1288563452 [label="Je suis certaine que l'un de ces bibelots que conserve Monsieur Loid est une horloge, mais je suis incapable de déterminer lequel.",shape=box,color=blue];
		j1288563452 -> j507599705;
	j507599705 [label="J'ai peur de toucher le moindre appareil dans cet étrange sanctuaire. Je suis convaincue que je risque autant de m'envoyer dans un lointain passé que de réchauffer ma tasse de thé.",shape=box,color=blue];
		j507599705 -> j4234436517;
		j507599705 -> j4100884502;
		j507599705 -> j2429168889;
	j4234436517 [label="Il est probablement préférable de ne pas appuyer sur des boutons si tu ne sais pas à quoi ils servent. ",shape=box,color=red];
		j4234436517 -> j2808442159;
	j4100884502 [label="Je pense que tout ira bien.",shape=box,color=red];
		j4100884502 -> j2905696638;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j2808442159 [label="Excellent conseil, en effet. J'ai entendu dire par Monsieur Loid que tu avais vécu ta propre aventure temporelle. Je me demande...",shape=box,color=blue];
		j2808442159 -> j2090498965;
	j2905696638 [label="C'est très gentil de ta part, mais... tu n'es pas la personne qui a été jetée dans un autre... ah. C'est vrai. Oui!",shape=box,color=blue];
		j2905696638 -> j1328869545;
	"Chat ends." [color=orange];
	j2090498965 [label="Était-elle aussi dangereuse que celle-ci?",shape=box,color=blue];
		j2090498965 -> j618865032;
		j2090498965 -> j3012213986;
	j1328869545 [label="Tu comprends, n'est-ce pas? Pardonne-moi. Ta propre aventure était-elle aussi dangereuse que celle-ci?",shape=box,color=blue];
		j1328869545 -> j618865032;
		j1328869545 -> j3012213986;
	j618865032 [label="La période? Ou mon séjour là-bas en particulier?",shape=box,color=red];
		j618865032 -> j2325017587;
	j3012213986 [label="C'était différent, mais je te promets que tu es en sécurité ici.",shape=box,color=red];
		j3012213986 -> j538019538;
	j2325017587 [label="+10 Chemistry",color=orange];
		j2325017587 -> j2413856239;
	j538019538 [label="J'apprécie beaucoup ta vibrante marque de confiance, mais je ne la partage pas pleinement. Surtout quand j'ai tant de mal à discerner l'heure.",shape=box,color=blue];
		j538019538 -> j1627722790;
	j2413856239 [label="C'est bien de faire la distinction. Je doute fort que ton expérience du passé ait été \"normale\" au regard des critères généraux. Je pense bien que non, à première vue.",shape=box,color=blue];
		j2413856239 -> j3516860478;
	j1627722790 [label="On pourrait s'attendre à ce qu'il y en ait une dans le coin de cet… \"écran\", mais il n'y en a pas! Mauvaise qualité, à mon avis.",shape=box,color=blue];
		j1627722790 -> j3829073233;
	j3516860478 [label="Je parlais de la \"période\" elle-même. Permets-moi de reformuler:",shape=box,color=blue];
		j3516860478 -> j9895496;
	j3829073233 [label="Quoi qu'il en soit, nous nous sommes bien éloignés de ma question!",shape=box,color=blue];
		j3829073233 -> j9895496;
	j9895496 [label="Cette époque \"passée\" dans laquelle tu as voyagé, qui est en effet bien plus proche du \"passé lointain\" dont je suis originaire, était-elle plus ou moins sournoisement dangereuse que cette époque dans laquelle nous nous trouvons actuellement?",shape=box,color=blue];
		j9895496 -> j2423219981;
	j2423219981 [label="(Bonté divine! J'adore ça, je dois dire que c'est bien plus intéressant que de dépoussiérer des plats de communion.)",shape=box,color=blue];
		j2423219981 -> j121242229;
		j2423219981 -> j74079480;
		j2423219981 -> j1162687374;
		j2423219981 -> j2941731246;
	j121242229 [label="Je pense que c'est à peu près pareil. L'armement est différent et ils ne savent peut-être pas encore à quoi ils ont affaire, mais la guerre est la guerre et la mort est la mort.",shape=box,color=red];
		j121242229 -> j2257527654;
	j74079480 [label="Je pense que cette période est moins dangereuse. Nous sommes mieux armés pour relever les défis auxquels nous sommes confrontés. Ça ne fait que commencer.",shape=box,color=red];
		j74079480 -> j2845955117;
	j1162687374 [label="Je pense qu'ici, c'est plus dangereux. Bien que nous ayons toujours les Infestés en commun, ils utilisaient alors un armement bien plus rudimentaire.",shape=box,color=red];
		j1162687374 -> j2845955117;
	j2941731246 [label="Honnêtement, j'apprécie juste de voir que tu t'amuses. Ça peut être difficile de devoir s'adapter à beaucoup de choses d'un coup.",shape=box,color=red];
		j2941731246 -> j1837358334;
	j2257527654 [label="+5 Chemistry",color=orange];
		j2257527654 -> j2643782625;
	j2845955117 [label="Tu as peut-être raison. Je vais y réfléchir. Merci.",shape=box,color=blue];
		j2845955117 -> "Chat ends.";
	j1837358334 [label="+5 Chemistry",color=orange];
		j1837358334 -> j3528228;
	j2643782625 [label="Comme toute chose, je suppose que c'est relatif, non? Le prédateur qui nous tue aujourd'hui est tout aussi mortel que celui qui nous chassait autrefois. Il n'a fait qu'aiguiser ses dents.",shape=box,color=blue];
		j2643782625 -> j1024858313;
		j2643782625 -> j378951663;
	j3528228 [label="J'y avais été préparée par le Cardinal Dimanche – ton Albrecht Entrati. Contrairement à mon cher Lyon, j'ai pris ses paroles pour argent comptant. Et contrairement à Lyon, je considère cela comme une grande aventure et non comme un fardeau.",shape=box,color=blue];
		j3528228 -> j1463726076;
	j1024858313 [label="À moins que tu ne sois Orokin et que tu aies trouvé un moyen d'éviter la mort... en théorie, sinon en pratique.",shape=box,color=red];
		j1024858313 -> j2538802934;
	j378951663 [label="C'est bien de voir que tu t'adaptes vite au futur.",shape=box,color=red];
		j378951663 -> j431040659;
	j1463726076 [label="Servir les Luminaires n'est pas forcément synonyme de souffrance. En cela, nous avons toujours été différents.",shape=box,color=blue];
		j1463726076 -> j469828863;
	j2538802934 [label="Et je crois que le diable est un parfait exemple de la raison pour laquelle la mort est le plus beau cadeau que Lua nous ait jamais offert.",shape=box,color=blue];
		j2538802934 -> j2779919826;
	j431040659 [label="+5 Chemistry",color=orange];
		j431040659 -> j440127749;
	j469828863 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j469828863 -> j2056091787;
	j2779919826 [label="Boolean MarieRoathe1 is now true.",color=orange];
		j2779919826 -> j2661961530;
	j440127749 [label="J'y avais été préparée par le Cardinal Dimanche – ton Albrecht Entrati. Contrairement à mon cher Lyon, j'ai pris ses paroles pour argent comptant. Et contrairement à Lyon, je considère cela comme une grande aventure et non comme un fardeau.",shape=box,color=blue];
		j440127749 -> j3959061516;
	j2056091787 [label="Et n'esquive pas ma question, voyons! Qu'est-ce qui te semble le plus dangereux?",shape=box,color=blue];
		j2056091787 -> j196723580;
		j2056091787 -> j4163903770;
		j2056091787 -> j4181843799;
	j2661961530 [label="Oh! Voilà le bruit d'une horloge que je reconnais, même si je n'arrive toujours pas à identifier où se trouve ce satané bidule. Quoi qu'il en soit, je crains de devoir partir. C'était génial. En attendant qu'on se \"revoie\"! \"Aux Dieux\"!",shape=box,color=blue];
		j2661961530 -> "Chat ends.";
	j3959061516 [label="Servir les Luminaires n'est pas forcément synonyme de souffrance. En cela, nous avons toujours été différents.",shape=box,color=blue];
		j3959061516 -> j388712022;
	j196723580 [label="Je crois que cette époque est plus dangereuse. Combien d'ennemis invincibles tentent de nous tuer?",shape=box,color=red];
		j196723580 -> j2845955117;
	j4163903770 [label="Je crois que notre époque est moins dangereuse. Ils découvrent simplement de nouvelles façons de s'entretuer. Nos méthodes sont peut-être un peu plus excitantes, en apparence.",shape=box,color=red];
		j4163903770 -> j2845955117;
	j4181843799 [label="Je crois que c'est probablement à peu près pareil, au final. La mort, c'est la mort, n'est-ce pas?",shape=box,color=red];
		j4181843799 -> j2716423294;
	j388712022 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j388712022 -> j2661961530;
	j2716423294 [label="+5 Chemistry",color=orange];
		j2716423294 -> j955641465;
	j955641465 [label="Comme toute chose, je suppose que c'est relatif, non? Le prédateur qui nous tue aujourd'hui est tout aussi mortel que celui qui nous chassait autrefois. Il n'a fait qu'aiguiser ses dents.",shape=box,color=blue];
		j955641465 -> j1575001694;
		j955641465 -> j1024858313;
	j1575001694 [label="En tant que personne qui essaie de se défendre contre le loup, ça m'épuise souvent.",shape=box,color=red];
		j1575001694 -> j2879564586;
	j2879564586 [label="Je pense que toi, mon cher Voyageur, tu es plutôt du genre à rejoindre la meute de loups que de rester sur tes gardes. Et je le dis en guise de compliment.",shape=box,color=blue];
		j2879564586 -> j2661961530;
}