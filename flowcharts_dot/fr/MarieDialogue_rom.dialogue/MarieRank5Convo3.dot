	2888 [label="Non, je ne vois pas... continue.",shape=box,color=red];
		2888 -> 2900;
	2892 [label="Je ne parlerai pas de foi, si ce n'est pour dire que... aussi imparfaites que soient nos formes de notre point de vue limité, nous devons… être en paix avec ce que nous sommes, n'est-ce pas? C'est tout ce que nous avons.",shape=box,color=blue];
		2892 -> 2901;
	2891 [label="Je sais que nos croyances se ressemblent, alors je dirai que... Sol a jugé bon de me créer telle que je suis et je dois avoir foi en sa sagesse, n'est-ce pas? Aussi imparfaite que puisse paraître ma situation de mon point de vue limité, je me demande si tu ne pourrais pas en faire autant à ton niveau.",shape=box,color=blue];
		2891 -> 2901;
	2893 [label="Je sais que nos croyances semblent différentes, alors j'éviterai de parler d'un sujet que je ne maîtrise pas. Je dirai simplement que Sol a jugé bon de me créer telle que je suis et je dois avoir foi en sa sagesse, n'est-ce pas? Aussi imparfaite que puisse paraître ma situation de mon point de vue limité, je me demande si tu ne pourrais pas en faire autant à ton niveau.",shape=box,color=blue];
		2893 -> 2901;
	2894 [label="Je sais que ta foi t'est personnelle et je ne m'immiscerai pas dans tes croyances. Je dirai simplement que Sol a jugé bon de me créer telle que je suis, donc je dois avoir foi en sa sagesse, n'est-ce pas? Aussi imparfaite que je puisse paraître de mon point de vue limité, je me demande si tu ne pourrais pas envisager la même chose pour toi.",shape=box,color=blue];
		2894 -> 2901;
	2898 [label="Sol a jugé bon de nous créer tels que nous sommes et nous devons avoir foi en sa sagesse, n'est-ce pas? Aussi imparfaits que nous puissions nous croire de notre point de vue limité.",shape=box,color=blue];
		2898 -> 2901;
	2889 [label="Lua a jugé bon de te créer comme tu es et Sol a jugé bon de me créer telle que je suis. Nous devons avoir foi en leur sagesse, n'est-ce pas? Aussi imparfaite que puisse paraître notre condition.",shape=box,color=blue];
		2889 -> 2901;
	2890 [label="Les Luminaires ont jugé bon de nous créer ainsi. Nous devons avoir foi en leur sagesse, n'est-ce pas? Aussi imparfaite que puisse nous paraître notre condition.",shape=box,color=blue];
		2890 -> 2901;
	2895 [label="Je sais que tu penses que nul ne peut connaître la vérité absolue sur l'univers et je respecte et admire cette position. Mais je dirai simplement que Sol a jugé bon de me créer telle que je suis et je dois avoir foi en sa sagesse, n'est-ce pas? Aussi imparfaite que je puisse paraître de mon point de vue limité.",shape=box,color=blue];
		2895 -> 2901;
	2896 [label="Je sais que tu n'as pas de croyance personnelle et je le respecte. Mais je dirai simplement que Sol a jugé bon de me créer telle que je suis et je dois avoir foi en sa sagesse, n'est-ce pas? Aussi imparfaite que je puisse paraître de mon point de vue limité.",shape=box,color=blue];
		2896 -> 2901;
