		2861 -> 2869;
		2861 -> 2870;
	2862 [label="C'est tellement... agréable de pouvoir parler de tout ça. Je n'arrive pas à trouver les mots. C'est si rare de pouvoir évoquer ce mal invisible et silencieux dont je souffre.",shape=box,color=blue];
		2862 -> 2871;
	2867 [label="Ils me font toujours mal. Toujours. Même maintenant, assise ici, si je pense à eux, je ressens la douleur. Mais ce n'est pas toujours assez fort pour que je le remarque.",shape=box,color=blue];
