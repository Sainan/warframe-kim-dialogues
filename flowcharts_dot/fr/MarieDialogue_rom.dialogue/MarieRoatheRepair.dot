		j4217867269 -> "Chat ends." [label="false",color=purple];
	j81274555 [label="Voyageur. Je suis harcelée par le diable. Il m'exaspère sans cesse avec ses petits démons! Tout cela en ton nom! Il prétend que tu souhaites simplement t'excuser à genoux.",shape=box,color=blue];
		j81274555 -> j1987332205;
		j81274555 -> j651722509;
	j3630616300 [label="Je suis harcelée par le diable. Il m'exaspère sans cesse avec ses petits démons! Tout cela en ton nom! Il prétend que tu souhaites parler de mon aide pour faire monter Monsieur Loid à l'étage ?",shape=box,color=blue];
		j3630616300 -> j3783888048;
		j3630616300 -> j651722509;
	j1386861840 [label="Je suis harcelée par le diable. Il m'exaspère sans cesse avec ses petits démons! Tout cela en ton nom! Il prétend que tu souhaites discuter une fois de plus de mon engagement envers le Cardinal ?",shape=box,color=blue];
		j1386861840 -> j3293565117;
		j1386861840 -> j651722509;
	"Chat ends." [color=orange];
	j1987332205 [label="Oui.",shape=box,color=red];
		j1987332205 -> j3321163254;
	j651722509 [label="Il a dit ça?",shape=box,color=red];
		j651722509 -> j3823196548;
	j3783888048 [label="Oui.",shape=box,color=red];
		j3783888048 -> j1614010336;
	j3293565117 [label="Oui.",shape=box,color=red];
		j3293565117 -> j1248242696;
	j3321163254 [label="Je te demande pardon. Je sais que je t'ai offensée. Ce n'était absolument pas mon intention. Crois-moi, c'était la dernière chose que je voulais faire.",shape=box,color=red];
		j3321163254 -> j694489623;
	j3823196548 [label="Je vais le tuer! Je savais que ce démon était rempli de la pire merde qui soit! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses!",shape=box,color=blue];
		j3823196548 -> "Chat ends.";
	j1614010336 [label="Je ne m'attarderai pas, car il en a déjà fait beaucoup en ton absence. Et comme le diable a coutume de le faire, il a présenté des arguments tout à fait convaincants.",shape=box,color=blue];
		j1614010336 -> j463318209;
	j1248242696 [label="Je ne m'attarderai pas, car il en a déjà fait beaucoup en ton absence. Et comme le diable a coutume de le faire, il a présenté des arguments tout à fait convaincants.",shape=box,color=blue];
		j1248242696 -> j1912742800;
	j694489623 [label="Et pourquoi cela?",shape=box,color=blue];
		j694489623 -> j437170347;
		j694489623 -> j381942321;
	j463318209 [label="Et j'avoue que je... commence à en avoir assez d'être coincée ici sans aucun recours.",shape=box,color=blue];
		j463318209 -> j2694005809;
	j1912742800 [label="Mais ce ne sont pas ses paroles, c'est plutôt son intelligence qu'il faut remercier. Il m'a fait asseoir avec Monsieur Loid.",shape=box,color=blue];
		j1912742800 -> j3472520030;
		j1912742800 -> j2092156274;
	j437170347 [label="[Avouer vos sentiments.] Parce que je tiens beaucoup à toi, Marie. Je t'adore.",shape=box,color=red];
		j437170347 -> j3020654030;
	j381942321 [label="Laisse tomber. C'était manifestement une erreur.",shape=box,color=red];
		j381942321 -> j1518299324;
	j2694005809 [label="Très bien. Je vais t'aider. Tu auras mon aide.",shape=box,color=blue];
		j2694005809 -> j3151953893;
	j3472520030 [label="Oh?",shape=box,color=red];
		j3472520030 -> j2608477162;
	j2092156274 [label="Mais Loid aime Albrecht. N'est-ce pas?",shape=box,color=red];
		j2092156274 -> j3551420561;
	j3020654030 [label="Je savais que j'allais mettre les pieds dans le plat. Et voilà, c'est arrivé.",shape=box,color=red];
		j3020654030 -> j4279370746;
	j1518299324 [label="Tu es aussi infâme que lui.",shape=box,color=blue];
		j1518299324 -> "Chat ends.";
	j3151953893 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3151953893 -> j2529015854;
	j2608477162 [label="C’est la lucidité de Loid qui m’a permis de voir au-delà de mes propres illusions. Car Loid aime le Cardinal – son Albrecht – et pourtant il connaît ses défauts.",shape=box,color=blue];
		j2608477162 -> j1796620968;
	j3551420561 [label="Oui. Il l'aime. Et pourtant, il perçoit tous ses défauts. C'est cette lucidité qui m'a permis de voir au-delà de ma propre vision obscurcie.",shape=box,color=blue];
		j3551420561 -> j1796620968;
	j4279370746 [label="Je te demande pardon d'avoir eu recours à Roathe pour attirer ton attention, mais je ne savais pas vers qui d'autre me tourner.",shape=box,color=red];
		j4279370746 -> j1634489177;
	j2529015854 [label="Boolean MarieFamilyFail is now false.",color=orange];
		j2529015854 -> "Chat ends.";
	j1796620968 [label="Car qu'est-ce qu'aimer, sinon accepter l'autre avec tout ce qu'il a de meilleur et de pire, après tout?",shape=box,color=blue];
		j1796620968 -> j3722403271;
	j1634489177 [label="Oh, Voyageur... mon pauvre Voyageur. Tu n'avais pas besoin d'aller aussi loin pour obtenir mon pardon. ",shape=box,color=blue];
		j1634489177 -> j2822081616;
	j3722403271 [label="Boolean MarieEntratiCompleteA is now true.",color=orange];
		j3722403271 -> j2737891827;
	j2822081616 [label="Je te l'aurais donné si tu me l'avais demandé. Tu as déjà une place dans mon cœur, tu sais?",shape=box,color=blue];
		j2822081616 -> j2689412341;
		j2822081616 -> j1636937613;
	j2737891827 [label="Boolean MarieEntratiCompleteB is now false.",color=orange];
		j2737891827 -> j3065315887;
	j2689412341 [label="Je... Vraiment?",shape=box,color=red];
		j2689412341 -> j4016992133;
	j1636937613 [label="Mais j'ai traversé tellement de difficultés...",shape=box,color=red];
		j1636937613 -> j1913422690;
	j3065315887 [label="Boolean MarieEntratiCompleteC is now false.",color=orange];
		j3065315887 -> "Chat ends.";
	j4016992133 [label="Oui! Et si tu souhaites être avec moi, cela me plairait bien aussi.",shape=box,color=blue];
		j4016992133 -> j4242811479;
		j4016992133 -> j1520310770;
	j1913422690 [label="Et c'est de ta faute, pas de la mienne! Mais si tu souhaites être avec moi, alors je le souhaite aussi.",shape=box,color=blue];
		j1913422690 -> j1520310770;
		j1913422690 -> j4242811479;
	j4242811479 [label="J'adorerais ça, Marie.",shape=box,color=red];
		j4242811479 -> j1751862233;
	j1520310770 [label="Après réflexion, ça ira.",shape=box,color=red];
		j1520310770 -> j488936631;
	j1751862233 [label="Ah! Je suis si heureuse!",shape=box,color=blue];
		j1751862233 -> j1309863619;
	j488936631 [label="Je vais te jeter directement dans le Néant.",shape=box,color=blue];
		j488936631 -> "Chat ends.";
