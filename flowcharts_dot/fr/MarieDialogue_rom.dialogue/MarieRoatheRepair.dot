		3816 -> 3820 [label="false",color=purple];
	3817 [label="Voyageur. Je suis harcelée par le diable. Il m'exaspère sans cesse avec ses petits démons! Tout cela en ton nom! Il prétend que tu souhaites simplement t'excuser à genoux.",shape=box,color=blue];
		3817 -> 3821;
		3817 -> 3822;
	3818 [label="Je suis harcelée par le diable. Il m'exaspère sans cesse avec ses petits démons! Tout cela en ton nom! Il prétend que tu souhaites parler de mon aide pour faire monter Monsieur Loid à l'étage ?",shape=box,color=blue];
		3818 -> 3823;
		3818 -> 3824;
	3819 [label="Je suis harcelée par le diable. Il m'exaspère sans cesse avec ses petits démons! Tout cela en ton nom! Il prétend que tu souhaites discuter une fois de plus de mon engagement envers le Cardinal ?",shape=box,color=blue];
		3819 -> 3825;
		3819 -> 3826;
	3820 [label="Chat ends.",color=orange];
	3821 [label="Oui.",shape=box,color=red];
		3821 -> 3827;
	3822 [label="Il a dit ça?",shape=box,color=red];
		3822 -> 3828;
	3823 [label="Oui.",shape=box,color=red];
		3823 -> 3829;
	3824 [label="Il a dit ça?",shape=box,color=red];
		3824 -> 3828;
	3825 [label="Oui.",shape=box,color=red];
		3825 -> 3830;
	3826 [label="Il a dit ça?",shape=box,color=red];
		3826 -> 3828;
	3827 [label="Je te demande pardon. Je sais que je t'ai offensée. Ce n'était absolument pas mon intention. Crois-moi, c'était la dernière chose que je voulais faire.",shape=box,color=red];
		3827 -> 3831;
	3828 [label="Je vais le tuer! Je savais que ce démon était rempli de la pire merde qui soit! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses!",shape=box,color=blue];
		3828 -> 3832;
	3829 [label="Je ne m'attarderai pas, car il en a déjà fait beaucoup en ton absence. Et comme le diable a coutume de le faire, il a présenté des arguments tout à fait convaincants.",shape=box,color=blue];
		3829 -> 3833;
	3830 [label="Je ne m'attarderai pas, car il en a déjà fait beaucoup en ton absence. Et comme le diable a coutume de le faire, il a présenté des arguments tout à fait convaincants.",shape=box,color=blue];
		3830 -> 3834;
	3831 [label="Et pourquoi cela?",shape=box,color=blue];
		3831 -> 3835;
		3831 -> 3836;
	3832 [label="Chat ends.",color=orange];
	3833 [label="Et j'avoue que je... commence à en avoir assez d'être coincée ici sans aucun recours.",shape=box,color=blue];
		3833 -> 3837;
	3834 [label="Mais ce ne sont pas ses paroles, c'est plutôt son intelligence qu'il faut remercier. Il m'a fait asseoir avec Monsieur Loid.",shape=box,color=blue];
		3834 -> 3838;
		3834 -> 3839;
	3835 [label="[Avouer vos sentiments.] Parce que je tiens beaucoup à toi, Marie. Je t'adore.",shape=box,color=red];
		3835 -> 3840;
	3836 [label="Laisse tomber. C'était manifestement une erreur.",shape=box,color=red];
		3836 -> 3841;
	3837 [label="Très bien. Je vais t'aider. Tu auras mon aide.",shape=box,color=blue];
		3837 -> 3842;
	3838 [label="Oh?",shape=box,color=red];
		3838 -> 3843;
	3839 [label="Mais Loid aime Albrecht. N'est-ce pas?",shape=box,color=red];
		3839 -> 3844;
	3840 [label="Je savais que j'allais mettre les pieds dans le plat. Et voilà, c'est arrivé.",shape=box,color=red];
		3840 -> 3845;
	3841 [label="Tu es aussi infâme que lui.",shape=box,color=blue];
		3841 -> 3846;
	3842 [label="Update boolean MarieFamilySuccess",color=orange];
		3842 -> 3847;
	3843 [label="C’est la lucidité de Loid qui m’a permis de voir au-delà de mes propres illusions. Car Loid aime le Cardinal – son Albrecht – et pourtant il connaît ses défauts.",shape=box,color=blue];
		3843 -> 3848;
	3844 [label="Oui. Il l'aime. Et pourtant, il perçoit tous ses défauts. C'est cette lucidité qui m'a permis de voir au-delà de ma propre vision obscurcie.",shape=box,color=blue];
		3844 -> 3848;
	3845 [label="Je te demande pardon d'avoir eu recours à Roathe pour attirer ton attention, mais je ne savais pas vers qui d'autre me tourner.",shape=box,color=red];
		3845 -> 3849;
	3846 [label="Chat ends.",color=orange];
	3847 [label="Update boolean MarieFamilyFail",color=orange];
		3847 -> 3850;
	3848 [label="Car qu'est-ce qu'aimer, sinon accepter l'autre avec tout ce qu'il a de meilleur et de pire, après tout?",shape=box,color=blue];
		3848 -> 3851;
	3849 [label="Oh, Voyageur... mon pauvre Voyageur. Tu n'avais pas besoin d'aller aussi loin pour obtenir mon pardon. ",shape=box,color=blue];
		3849 -> 3852;
	3850 [label="Chat ends.",color=orange];
	3851 [label="Update boolean MarieEntratiCompleteA",color=orange];
		3851 -> 3853;
	3852 [label="Je te l'aurais donné si tu me l'avais demandé. Tu as déjà une place dans mon cœur, tu sais?",shape=box,color=blue];
		3852 -> 3854;
		3852 -> 3855;
	3853 [label="Update boolean MarieEntratiCompleteB",color=orange];
		3853 -> 3856;
	3854 [label="Je... Vraiment?",shape=box,color=red];
		3854 -> 3857;
	3855 [label="Mais j'ai traversé tellement de difficultés...",shape=box,color=red];
		3855 -> 3858;
	3856 [label="Update boolean MarieEntratiCompleteC",color=orange];
		3856 -> 3859;
	3857 [label="Oui! Et si tu souhaites être avec moi, cela me plairait bien aussi.",shape=box,color=blue];
		3857 -> 3860;
		3857 -> 3861;
	3858 [label="Et c'est de ta faute, pas de la mienne! Mais si tu souhaites être avec moi, alors je le souhaite aussi.",shape=box,color=blue];
		3858 -> 3861;
		3858 -> 3860;
	3859 [label="Chat ends.",color=orange];
	3860 [label="J'adorerais ça, Marie.",shape=box,color=red];
		3860 -> 3862;
	3861 [label="Après réflexion, ça ira.",shape=box,color=red];
		3861 -> 3863;
	3862 [label="Ah! Je suis si heureuse!",shape=box,color=blue];
