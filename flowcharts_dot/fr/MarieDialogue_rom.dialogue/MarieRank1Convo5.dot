digraph {
	"MarieRank1Convo5 begins." [color=orange];
		"MarieRank1Convo5 begins." -> j625679092;
	j625679092 [label="Bonjour, bonjour! Tu es bien le Voyageur, n'est-ce pas? Monsieur Loid m'a tellement parlé de toi. Je suis ravie de faire ta connaissance sur cet...",shape=box,color=blue];
		j625679092 -> j2007054355;
	j2007054355 [label="Appareil cliquetant, aussi astucieux soit-il!",shape=box,color=blue];
		j2007054355 -> j2739254556;
	j2739254556 [label="Je suis Sœur Marie Leroux, mais tu peux m'appeler Marie. Je suis venue récemment avec mon frère d'âme, le Père Lyon Allard et... eh bien, je crois que Monsieur Loid a dû te mettre en garde contre le diable, n'est-ce pas?",shape=box,color=blue];
		j2739254556 -> j2238204730;
		j2739254556 -> j2502748857;
		j2739254556 -> j2429168889;
	j2238204730 [label="C'est un plaisir de faire ta connaissance. Et ne le prends pas mal, tu es la bienvenue, mais… que faites-vous tous ici?",shape=box,color=red];
		j2238204730 -> j1739611951;
	j2502748857 [label="Le diable? Tu veux dire l'Orokin?",shape=box,color=red];
		j2502748857 -> j3870435464;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j1739611951 [label="+5 Chemistry",color=orange];
		j1739611951 -> j4133840322;
	j3870435464 [label="Oui, ce monstre irritant à la peau bleue dont le Cardinal nous a confié la garde. Je crois que tu le connais sous le nom d'Albrecht Entrati? C'est à cause de lui que nous sommes ici. Mais c'est une très longue histoire, j'en ai bien peur.",shape=box,color=blue];
		j3870435464 -> j2858178998;
		j3870435464 -> j3020459435;
	"Chat ends." [color=orange];
	j4133840322 [label="Merci! Les raisons de notre présence ici sont une très longue histoire, j'en ai bien peur. Nous avons été envoyés par le Cardinal. Je crois que tu le connais sous le nom d'Albrecht Entrati? Il nous a confié ce monstre irritant à la peau bleue.",shape=box,color=blue];
		j4133840322 -> j2858178998;
		j4133840322 -> j3020459435;
	j2858178998 [label="Je ferai mon possible pour aider.",shape=box,color=red];
		j2858178998 -> j164316765;
	j3020459435 [label="\"Confié?\"",shape=box,color=red];
		j3020459435 -> j1316456201;
	j164316765 [label="+5 Chemistry",color=orange];
		j164316765 -> j3643883210;
	j1316456201 [label="Nous devons faire tout ce que nous pouvons pour guider son âme, si cela est possible. Et si cela n'est pas le cas? Nous devons au moins veiller à ce qu'il ne cause plus de tort.",shape=box,color=blue];
		j1316456201 -> j2633366142;
		j1316456201 -> j992379749;
	j3643883210 [label="Tu es exactement comme Monsieur Loid et les Cavias l'avaient dit! Je pense que nous allons bien nous entendre.",shape=box,color=blue];
		j3643883210 -> j1524162250;
	j2633366142 [label="Je vais vous aider à essayer.",shape=box,color=red];
		j2633366142 -> j164316765;
	j992379749 [label="C'est un Orokin. Le seul moyen d'y parvenir, c'est de lui loger une balle entre les deux yeux.",shape=box,color=red];
		j992379749 -> j3095643535;
	j1524162250 [label="Ah! Je dois y aller, excuse-moi. J'espère que nous nous reparlerons bientôt! À la revoyure!",shape=box,color=blue];
		j1524162250 -> "Chat ends.";
	j3095643535 [label="On croirait entendre Lyon. Je ne perdrai pas espoir. Pas encore.",shape=box,color=blue];
		j3095643535 -> j1524162250;
}