",color=purple];
		3631 -> 3636 [label="RoatheVillain, RoatheFamilySuccess",color=purple];
		3631 -> 3639 [label="false",color=purple];
	3628 [label="Tu penses vraiment? Si je peux mettre de côté mes différends avec le diable, tu le peux certainement aussi, non?",shape=box,color=blue];
		3628 -> 3632;
		3628 -> 3633;
	3634 [label="Non, il doit y avoir une autre solution. Je refuse de lui demander son aide.",shape=box,color=red];
		3634 -> 3628;
	3635 [label="Tu as raison. Je ne pensais pas que tu accepterais. J'avais peur de te le demander.",shape=box,color=red];
		3635 -> 3631;
	3638 [label="/Lotus/Language/1999Texting/MarieRomance/Marie_MarieRank6Convo3_3118 begins.",shape=box,color=blue];
		3638 -> 3644;
	3637 [label="Nous apportera-t-il son aide à cet égard?",shape=box,color=blue];
		3637 -> 3643;
	3636 [label="Nous apportera-t-il son aide à cet égard?",shape=box,color=blue];
		3636 -> 3642;
	3639 [label="Penses-tu pouvoir le convaincre de nous aider?",shape=box,color=blue];
		3639 -> 3645;
		3639 -> 3646;
	3632 [label="Pardon, mais non. ",shape=box,color=red];
		3632 -> 3640;
	3633 [label="Très bien. Si ça ne te dérange pas, ça ne me dérange pas non plus.",shape=box,color=red];
		3633 -> 3641;
	3644 [label="Non, malheureusement... Je crois que c'était une impasse. Penses-tu qu'il y ait une autre solution?",shape=box,color=red];
		3644 -> 3650;
	3643 [label="Il le fera. Je l'ai convaincu de m'aider à les réunir – et tu ne vas pas le croire – afin qu'il puisse protéger la famille d'Entrati. Après tout, ils sont les seuls Orokins survivants.",shape=box,color=red];
		3643 -> 3649;
	3642 [label="Il le fera. Je l'ai convaincu de les aider à se réunir – et cela ne te surprendra pas – surtout pour embêter Albrecht en son absence.",shape=box,color=red];
		3642 -> 3648;
	3645 [label="Rien n'est encore gagné. Il est... enfin, tu sais comment il est.",shape=box,color=red];
		3645 -> 3651;
	3646 [label="J'y travaille encore, mais je pense que oui.",shape=box,color=red];
		3646 -> 3652;
	3640 [label="+20 Chemistry",color=orange];
		3640 -> 3647;
	3641 [label="Oui, je ne suis pas obligée d'y prendre plaisir, mais c'est comme un médicament qu'il faut avaler, je suppose.",shape=box,color=blue];
		3641 -> 3631;
	3650 [label="Oh! C'est... malheureux. Je ne sais pas? Je ne pense pas... Aurais-tu une autre idée pour approcher le diable? Ou une façon de réessayer?",shape=box,color=blue];
		3650 -> 3657;
	3649 [label="Il aide à protéger la famille de l'homme qui l'a transformé en protoframe contre son gré et l'a projeté dans le passé, le privant de ses souvenirs...",shape=box,color=blue];
		3649 -> 3656;
	3648 [label="Tu as raison, je ne suis... pas surprise.",shape=box,color=blue];
		3648 -> 3654;
		3648 -> 3655;
	3651 [label="Check boolean RoatheDating",color=orange];
		3651 -> 3659 [label=true,color=green];
