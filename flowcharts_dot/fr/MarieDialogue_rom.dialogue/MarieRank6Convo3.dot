	3652 [label="Check boolean RoatheDating",color=orange];
		3652 -> 3660 [label=true,color=green];
		3652 -> 3661 [label=false,color=brown];
	3647 [label="Alors, je soutiendrai également ton choix.",shape=box,color=blue];
		3647 -> 3653;
	3657 [label="Je vais parler à Lyon pendant ce temps-là, mais je n'ai que très peu d'espoir.",shape=box,color=blue];
		3657 -> 3666;
	3656 [label="+20 Chemistry",color=orange];
		3656 -> 3665;
	3654 [label="Au moins, il aidera. Et je veillerai à ce qu'il ne mette pas ses menaces à exécution.",shape=box,color=red];
		3654 -> 3663;
	3655 [label="Je pense que c'est juste une bonne excuse pour dissimuler ses intentions.",shape=box,color=red];
		3655 -> 3664;
	3659 [label="Oui, je le sais. Je pense que tu as une façon de le convaincre, là où toutes les autres méthodes ont échoué, n'est-ce pas?",shape=box,color=blue];
		3659 -> 3669;
		3659 -> 3670;
	3658 [label="Oui, certainement. Ce diable peut être obstiné et ce n'est pas peu dire. Parfois, je me dis qu'il prend juste plaisir à faire de la provocation!",shape=box,color=blue];
		3658 -> 3667;
		3658 -> 3668;
	3660 [label="Je pense que tu as une façon de le convaincre, là où toutes les autres méthodes ont échoué, n'est-ce pas?",shape=box,color=blue];
		3660 -> 3669;
		3660 -> 3670;
	3661 [label="Je te souhaite bonne chance. Ce diable peut être obstiné et ce n'est pas peu dire. Parfois, je me dis qu'il prend juste plaisir à faire de la provocation!",shape=box,color=blue];
		3661 -> 3667;
		3661 -> 3668;
	3653 [label="Update boolean MarieFamilyFail",color=orange];
		3653 -> 3662;
	3666 [label="+20 Chemistry",color=orange];
		3666 -> 3674;
	3665 [label="J'ai profondément mal jugé notre diable...",shape=box,color=blue];
		3665 -> 3673;
	3663 [label="Oui. Au moins, tu es là pour l'empêcher de laisser libre cours à ses... instincts les plus vils.",shape=box,color=blue];
		3663 -> 3672;
	3664 [label="Oui, j'espère que tu as raison.",shape=box,color=blue];
		3664 -> 3672;
	3669 [label="Je ne voudrais pas utiliser ma relation avec lui comme outil de négociation.",shape=box,color=red];
		3669 -> 3677;
	3670 [label="Qu'est-ce que tu insinues, Marie?",shape=box,color=red];
		3670 -> 3678;
	3667 [label="En fait, j'aime bien ça, aussi bizarre que cela puisse paraître. On s'entend bien.",shape=box,color=red];
		3667 -> 3675;
	3668 [label="Peut-être, mais je pense que c'est surtout pour la forme.",shape=box,color=red];
		3668 -> 3676;
	3662 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3662 -> 3671;
	3674 [label="Le diable est capricieux! C'est la vie, comme on dit!",shape=box,color=blue];
		3674 -> 3682;
	3673 [label="Et je ne suis pas assez naïve pour ne pas voir le rôle que tu as joué pour que tout cela se produise!",shape=box,color=blue];
		3673 -> 3681;
	3672 [label="Check boolean MarieDating",color=orange];
		3672 -> 3680 [label=true,color=green];
		3672 -> 3679 [label=false,color=brown];
	3677 [label="Oh! Ce n'est pas ce que je voulais dire, pardonne-moi! Simplement qu'il semble t'apprécier, donc tu as peut-être son attention alors qu'il ignore tout le monde.",shape=box,color=blue];
		3677 -> 3684;
	3678 [label="+5 Chemistry",color=orange];
		3678 -> 3685;
	3675 [label="Oui, il semble bien t'apprécier. Peut-être est-ce parce que vous partagez la même époque et le même lieu, contrairement à nous? Sinon, pourquoi est-ce que ce serait le cas?",shape=box,color=blue];
		3675 -> 3683;
	3676 [label="Oui? Qu'est-ce que tu veux dire?",shape=box,color=blue];
		3676 -> 3683;
	3671 [label="Chat ends.",color=orange];
	3682 [label="Update boolean MarieFamilySuccess",color=orange];
		3682 -> 3690;
	3681 [label="Check boolean MarieDating",color=orange];
		3681 -> 3689 [label=true,color=green];
		3681 -> 3688 [label=false,color=brown];
	3680 [label="+10 Chemistry",color=orange];
		3680 -> 3687;
	3679 [label="+10 Chemistry",color=orange];
		3679 -> 3686;
	3684 [label="+5 Chemistry",color=orange];
		3684 -> 3697;
	3685 [label="Je n'ai absolument aucune idée de ce que tu veux dire! Je n'insinue rien du tout. Je suis une Sœur de Sol totalement innocente.",shape=box,color=blue];
		3685 -> 3698;
	3683 [label="Evaluate expressions",color=orange];
		3683 -> 3692 [label="RoatheVillain",color=purple];
