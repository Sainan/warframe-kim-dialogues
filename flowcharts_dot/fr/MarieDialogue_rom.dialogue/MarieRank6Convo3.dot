		j148501058 -> j1957086772 [label="false",color=purple];
	j1792267530 [label="J'ai réfléchi à comment convaincre Loid de monter ces escaliers pour enfin parler à la famille et... j'ai une idée, mais je ne pense pas qu'elle te plaira.",shape=box,color=red];
		j1792267530 -> j3431982611;
	j66832215 [label="As-tu réfléchi davantage à la façon de convaincre Loid de parler à la famille Entrati à l'étage?",shape=box,color=red];
		j66832215 -> j2607534784;
	j3101328045 [label="Concernant l'idée de mettre Loid et la famille Entrati en contact, je me demandais... si tu avais reconsidéré l’implication de Roathe?",shape=box,color=red];
		j3101328045 -> j1903226774;
	j1173976765 [label="Marie, es-tu toujours partante pour... peut-être essayer de convaincre Loid de parler aux \"voisins du dessus\"? Je sais que nous sommes restés sur une note bizarre.",shape=box,color=red];
		j1173976765 -> j1903226774;
	j1957086772 [label="Je me demande pourquoi Monsieur Loid a si peur de parler à la famille du Cardinal.",shape=box,color=blue];
		j1957086772 -> j3317339715;
	j3431982611 [label="Check boolean MarieDating",color=orange];
		j3431982611 -> j3378636281 [label=true,color=green];
		j3431982611 -> j6202258 [label=false,color=brown];
	j2607534784 [label="Check boolean MarieDating",color=orange];
		j2607534784 -> j938645774 [label=true,color=green];
		j2607534784 -> j938645774 [label=false,color=brown];
	j1903226774 [label="Check boolean MarieDating",color=orange];
		j1903226774 -> j1154952794 [label=true,color=green];
		j1903226774 -> j1046825223 [label=false,color=brown];
	j3317339715 [label="Et comment sortir de cette impasse! Ce purgatoire dans lequel nous sommes prisonniers ne doit pas perdurer. Il est si inutilement douloureux.",shape=box,color=blue];
		j3317339715 -> j3382615902;
	j3378636281 [label="Bonjour, mon cœur! Et que crois-tu que je ne vais pas aimer ?",shape=box,color=blue];
		j3378636281 -> j3430827154;
	j6202258 [label="Bonjour! Oh? Et que crois-tu que je ne vais pas aimer ?",shape=box,color=blue];
		j6202258 -> j3430827154;
	j938645774 [label="Bonjour, mon cœur! J'y ai réfléchi, oui... et j'ai vraiment du mal à l'admettre. Cela ne me fait pas plaisir de le dire.",shape=box,color=blue];
		j938645774 -> j3361758578;
	j1154952794 [label="Bonjour, bonjour, mon cœur! J'y ai réfléchi, oui... et j'ai vraiment du mal à l'admettre. Cela ne me fait pas plaisir de le dire.",shape=box,color=blue];
		j1154952794 -> j617180008;
	j1046825223 [label="Bonjour! J'y ai réfléchi, oui... et j'ai vraiment du mal à l'admettre. Cela ne me fait pas plaisir de le dire.",shape=box,color=blue];
		j1046825223 -> j617180008;
	j3382615902 [label="Mais j'ai l'impression qu'il nous faut... une sorte de bastion, non? Aurais-tu des idées?",shape=box,color=blue];
		j3382615902 -> j4158344088;
		j3382615902 -> j3430827154;
	j3430827154 [label="Je pense que nous aurons peut-être besoin de l'aide de Roathe pour convaincre Loid de parler à la famille Entrati. Je ne crois pas qu'il le fera autrement, sans garanties de protection pour lui et pour la famille.",shape=box,color=red];
		j3430827154 -> j1811049929;
	j3361758578 [label="Mais je pense... je pense – ah, Sol, pardonne-moi – qu’il faudra peut-être faire appel au diable. Je ne crois pas que Monsieur Loid nous écoutera autrement.",shape=box,color=blue];
		j3361758578 -> j52308363;
	j617180008 [label="Je crois que tu as raison. Le diable est peut-être la pièce manquante. Ah, rien que d'écrire ces mots, ça me fait mal! ",shape=box,color=blue];
		j617180008 -> j636489540;
	j4158344088 [label="Je n'ai pas vraiment de bonnes idées qui n'impliquent pas de faire appel à des sources déplaisantes. Des sources qui pourraient bien nous attirer de sérieux ennuis plus tard. Notamment, Roathe.",shape=box,color=red];
		j4158344088 -> j1890089629;
	j1811049929 [label="Je... déteste l'admettre, mais je crois que tu as raison... Sol, pardonne-moi.",shape=box,color=blue];
		j1811049929 -> j636489540;
	j52308363 [label="Le diable est puissant et il peut être utile si les choses tournent mal, n'est-ce pas?",shape=box,color=blue];
		j52308363 -> j1691536089;
		j52308363 -> j1529600414;
	j636489540 [label="Evaluate expressions",color=orange];
		j636489540 -> j158202588 [label="RoatheFamilyFail",color=purple];
		j636489540 -> j3544655861 [label="RoatheRedeemed, RoatheFamilyDelay
",color=purple];
		j636489540 -> j3544655861 [label="RoatheRedeemed, RoatheFamilySuccess
",color=purple];
		j636489540 -> j1825389573 [label="RoatheVillain, RoatheFamilyDelay
",color=purple];
		j636489540 -> j1825389573 [label="RoatheVillain, RoatheFamilySuccess",color=purple];
		j636489540 -> j3838963584 [label="false",color=purple];
	j1890089629 [label="Tu penses vraiment? Si je peux mettre de côté mes différends avec le diable, tu le peux certainement aussi, non?",shape=box,color=blue];
		j1890089629 -> j4110618375;
		j1890089629 -> j12705560;
	j1691536089 [label="Non, il doit y avoir une autre solution. Je refuse de lui demander son aide.",shape=box,color=red];
		j1691536089 -> j1890089629;
	j1529600414 [label="Tu as raison. Je ne pensais pas que tu accepterais. J'avais peur de te le demander.",shape=box,color=red];
		j1529600414 -> j636489540;
	j158202588 [label="Nous apportera-t-il son aide à cet égard?",shape=box,color=blue];
		j158202588 -> j3429251212;
	j3544655861 [label="Nous apportera-t-il son aide à cet égard?",shape=box,color=blue];
		j3544655861 -> j1700746221;
	j1825389573 [label="Nous apportera-t-il son aide à cet égard?",shape=box,color=blue];
		j1825389573 -> j2438919251;
	j3838963584 [label="Penses-tu pouvoir le convaincre de nous aider?",shape=box,color=blue];
		j3838963584 -> j2647317703;
		j3838963584 -> j4215391843;
	j4110618375 [label="Pardon, mais non. ",shape=box,color=red];
		j4110618375 -> j2003066667;
	j12705560 [label="Très bien. Si ça ne te dérange pas, ça ne me dérange pas non plus.",shape=box,color=red];
		j12705560 -> j2960299491;
	j3429251212 [label="Non, malheureusement... Je crois que c'était une impasse. Penses-tu qu'il y ait une autre solution?",shape=box,color=red];
		j3429251212 -> j980293334;
	j1700746221 [label="Il le fera. Je l'ai convaincu de m'aider à les réunir – et tu ne vas pas le croire – afin qu'il puisse protéger la famille d'Entrati. Après tout, ils sont les seuls Orokins survivants.",shape=box,color=red];
		j1700746221 -> j2507113524;
	j2438919251 [label="Il le fera. Je l'ai convaincu de les aider à se réunir – et cela ne te surprendra pas – surtout pour embêter Albrecht en son absence.",shape=box,color=red];
		j2438919251 -> j4137029178;
	j2647317703 [label="Rien n'est encore gagné. Il est... enfin, tu sais comment il est.",shape=box,color=red];
		j2647317703 -> j2913252443;
	j4215391843 [label="J'y travaille encore, mais je pense que oui.",shape=box,color=red];
		j4215391843 -> j1104176810;
	j2003066667 [label="+20 Chemistry",color=orange];
		j2003066667 -> j4227439994;
	j2960299491 [label="Oui, je ne suis pas obligée d'y prendre plaisir, mais c'est comme un médicament qu'il faut avaler, je suppose.",shape=box,color=blue];
		j2960299491 -> j636489540;
	j980293334 [label="Oh! C'est... malheureux. Je ne sais pas? Je ne pense pas... Aurais-tu une autre idée pour approcher le diable? Ou une façon de réessayer?",shape=box,color=blue];
		j980293334 -> j1956361153;
	j2507113524 [label="Il aide à protéger la famille de l'homme qui l'a transformé en protoframe contre son gré et l'a projeté dans le passé, le privant de ses souvenirs...",shape=box,color=blue];
		j2507113524 -> j28131746;
	j4137029178 [label="Tu as raison, je ne suis... pas surprise.",shape=box,color=blue];
		j4137029178 -> j653514791;
		j4137029178 -> j2716932046;
	j2913252443 [label="Check boolean RoatheDating",color=orange];
		j2913252443 -> j3081769716 [label=true,color=green];
		j2913252443 -> j3331206033 [label=false,color=brown];
	j1104176810 [label="Check boolean RoatheDating",color=orange];
		j1104176810 -> j3444090721 [label=true,color=green];
		j1104176810 -> j3898085205 [label=false,color=brown];
	j4227439994 [label="Alors, je soutiendrai également ton choix.",shape=box,color=blue];
		j4227439994 -> j1179567760;
	j1956361153 [label="Je vais parler à Lyon pendant ce temps-là, mais je n'ai que très peu d'espoir.",shape=box,color=blue];
		j1956361153 -> j3498529850;
	j28131746 [label="+20 Chemistry",color=orange];
		j28131746 -> j3824931742;
	j653514791 [label="Au moins, il aidera. Et je veillerai à ce qu'il ne mette pas ses menaces à exécution.",shape=box,color=red];
		j653514791 -> j4188101114;
	j2716932046 [label="Je pense que c'est juste une bonne excuse pour dissimuler ses intentions.",shape=box,color=red];
		j2716932046 -> j777144402;
	j3081769716 [label="Oui, je le sais. Je pense que tu as une façon de le convaincre, là où toutes les autres méthodes ont échoué, n'est-ce pas?",shape=box,color=blue];
		j3081769716 -> j261437516;
		j3081769716 -> j4189841586;
	j3331206033 [label="Oui, certainement. Ce diable peut être obstiné et ce n'est pas peu dire. Parfois, je me dis qu'il prend juste plaisir à faire de la provocation!",shape=box,color=blue];
		j3331206033 -> j2202713766;
		j3331206033 -> j3989304414;
	j3444090721 [label="Je pense que tu as une façon de le convaincre, là où toutes les autres méthodes ont échoué, n'est-ce pas?",shape=box,color=blue];
		j3444090721 -> j261437516;
		j3444090721 -> j4189841586;
	j3898085205 [label="Je te souhaite bonne chance. Ce diable peut être obstiné et ce n'est pas peu dire. Parfois, je me dis qu'il prend juste plaisir à faire de la provocation!",shape=box,color=blue];
		j3898085205 -> j2202713766;
		j3898085205 -> j3989304414;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j3498529850 [label="+20 Chemistry",color=orange];
		j3498529850 -> j3223763111;
	j3824931742 [label="J'ai profondément mal jugé notre diable...",shape=box,color=blue];
		j3824931742 -> j1419100809;
	j4188101114 [label="Oui. Au moins, tu es là pour l'empêcher de laisser libre cours à ses... instincts les plus vils.",shape=box,color=blue];
		j4188101114 -> j2198758823;
	j777144402 [label="Oui, j'espère que tu as raison.",shape=box,color=blue];
		j777144402 -> j2198758823;
	j261437516 [label="Je ne voudrais pas utiliser ma relation avec lui comme outil de négociation.",shape=box,color=red];
		j261437516 -> j2860655114;
	j4189841586 [label="Qu'est-ce que tu insinues, Marie?",shape=box,color=red];
		j4189841586 -> j412065380;
	j2202713766 [label="En fait, j'aime bien ça, aussi bizarre que cela puisse paraître. On s'entend bien.",shape=box,color=red];
		j2202713766 -> j1549459656;
	j3989304414 [label="Peut-être, mais je pense que c'est surtout pour la forme.",shape=box,color=red];
		j3989304414 -> j225089315;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j3223763111 [label="Le diable est capricieux! C'est la vie, comme on dit!",shape=box,color=blue];
		j3223763111 -> j3569999725;
	j1419100809 [label="Et je ne suis pas assez naïve pour ne pas voir le rôle que tu as joué pour que tout cela se produise!",shape=box,color=blue];
		j1419100809 -> j3242583483;
	j2198758823 [label="Check boolean MarieDating",color=orange];
		j2198758823 -> j3639147689 [label=true,color=green];
		j2198758823 -> j3067429628 [label=false,color=brown];
	j2860655114 [label="Oh! Ce n'est pas ce que je voulais dire, pardonne-moi! Simplement qu'il semble t'apprécier, donc tu as peut-être son attention alors qu'il ignore tout le monde.",shape=box,color=blue];
		j2860655114 -> j2633377791;
	j412065380 [label="+5 Chemistry",color=orange];
		j412065380 -> j2175417364;
	j1549459656 [label="Oui, il semble bien t'apprécier. Peut-être est-ce parce que vous partagez la même époque et le même lieu, contrairement à nous? Sinon, pourquoi est-ce que ce serait le cas?",shape=box,color=blue];
		j1549459656 -> j3822691405;
	j225089315 [label="Oui? Qu'est-ce que tu veux dire?",shape=box,color=blue];
		j225089315 -> j3822691405;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j3242583483 [label="Check boolean MarieDating",color=orange];
		j3242583483 -> j2082296704 [label=true,color=green];
		j3242583483 -> j271818178 [label=false,color=brown];
	j3639147689 [label="+10 Chemistry",color=orange];
		j3639147689 -> j1815813496;
	j3067429628 [label="+10 Chemistry",color=orange];
		j3067429628 -> j3330719594;
	j2633377791 [label="+5 Chemistry",color=orange];
		j2633377791 -> j2743707464;
	j2175417364 [label="Je n'ai absolument aucune idée de ce que tu veux dire! Je n'insinue rien du tout. Je suis une Sœur de Sol totalement innocente.",shape=box,color=blue];
		j2175417364 -> j3034199701;
	j3822691405 [label="Evaluate expressions",color=orange];
		j3822691405 -> j1200304614 [label="RoatheVillain",color=purple];
		j3822691405 -> j2900393796 [label="RoatheRedeemed",color=purple];
		j3822691405 -> j2627906576 [label="RoatheUnloved3",color=purple];
		j3822691405 -> j2023939841 [label="RoatheTraitor2",color=purple];
		j3822691405 -> j548372734 [label="RoatheExecutor2",color=purple];
		j3822691405 -> j4000398191 [label="false",color=purple];
	j2082296704 [label="Merci, merci, merci, mon cœur!",shape=box,color=blue];
		j2082296704 -> j2206511371;
	j271818178 [label="Merci, merci, merci!",shape=box,color=blue];
		j271818178 -> j2206511371;
	j1815813496 [label="Eh bien! Le moment venu, je serai prête et j'attendrai! D'ici là, merci, mon cœur.",shape=box,color=blue];
		j1815813496 -> j3569999725;
	j3330719594 [label="Eh bien! Le moment venu, je serai prête et j'attendrai! D'ici là, merci.",shape=box,color=blue];
		j3330719594 -> j3569999725;
	j2743707464 [label="Je suis tout simplement heureuse de ton bonheur. Et si le diable sait où exercer ses... efforts... tant mieux, non?",shape=box,color=blue];
		j2743707464 -> j2878958547;
	j3034199701 [label="Je ne voudrais jamais insinuer que, puisque le diable semble t'apprécier, il t'écoutera peut-être alors qu'il semble ignorer tout le monde.",shape=box,color=blue];
		j3034199701 -> j1932009921;
	j1200304614 [label="Tous ceux qui l'ont côtoyé ont essayé de le faire passer pour un monstre. Je suppose que je suis la première personne à ne pas l'avoir fait.",shape=box,color=red];
		j1200304614 -> j3433227942;
	j2900393796 [label="Il y a beaucoup de choses chez lui qu'il ne sait pas comment montrer. Ce n'est pas une carapace à proprement parler, mais il se méfie des autres et craint qu'ils ne lui fassent du mal.",shape=box,color=red];
		j2900393796 -> j2402380667;
	j2627906576 [label="Il a... connu de véritables peines de cœur au cours de sa longue vie. Il a simplement pansé ses plaies avant de les recouvrir d'épines, c'est tout.",shape=box,color=red];
		j2627906576 -> j1572064014;
	j2023939841 [label="Je crois que je peux comprendre le nombre d'années qu'il a vécues. J'ai vu autant de morts que lui.",shape=box,color=red];
		j2023939841 -> j2977107361;
	j548372734 [label="Il n'a jamais cherché qu'à faire ce qui était juste. Peut-être pas de la bonne manière, certes, mais il essayait de sauver le Système Origine des Orokins.",shape=box,color=red];
		j548372734 -> j628437317;
	j4000398191 [label="J'apprécie son humour pince-sans-rire. Il est intelligent, une fois qu'on a surmonté son ego.",shape=box,color=red];
		j4000398191 -> j1117590842;
	j2206511371 [label="Eh bien! Le moment venu, je serai prête et j'attendrai! À bientôt!",shape=box,color=blue];
		j2206511371 -> j3569999725;
	j2878958547 [label="Et ce sera d'autant mieux pour nous tous si tu lui sers de contrepoids pour le tempérer.",shape=box,color=blue];
		j2878958547 -> j1880750320;
		j2878958547 -> j4083508797;
	j1932009921 [label="Et jamais pendant les moments privés. Non. Jamais.",shape=box,color=blue];
		j1932009921 -> j957459896;
		j1932009921 -> j392595221;
	j3433227942 [label="Et je suppose que je suis en tête de la liste, n'est-ce pas? Je suppose que je devrais... tenter de comprendre les raisons de son comportement. La condamnation ne sauve aucune âme.",shape=box,color=blue];
		j3433227942 -> j2090826260;
	j2402380667 [label="Il y a toujours une souffrance que l'on cache à ceux qui nous entourent. Quelque chose que l'on cherche à protéger, de peur que d'autres ne s'en servent. Je suppose que je devrais m'efforcer d'être plus gentille avec lui, si ce que tu dis est vrai.",shape=box,color=blue];
		j2402380667 -> j2090826260;
	j1572064014 [label="Je n'arrive pas à imaginer la quantité d'amour et de décès qu'on doit endurer pendant toutes ces années. Cela me paraît tellement irréel, même après tout ce que j'ai vu.",shape=box,color=blue];
		j1572064014 -> j1140185119;
	j2977107361 [label="Parfois, quand je lui parle, j'oublie combien de siècles il a traversés. Cela me paraît tellement irréel, même compte tenu de tout ce que j'ai vu.",shape=box,color=blue];
		j2977107361 -> j1648488127;
	j628437317 [label="Il y a toujours des nuances, n'est-ce pas? Toujours des raisons d'agir d'une manière ou d'une autre. Je suppose que je devrais m'efforcer d'être plus gentille avec lui, si ce que tu dis est vrai.",shape=box,color=blue];
		j628437317 -> j2090826260;
	j1117590842 [label="Personne n'a jamais mis la malice du diable en doute.",shape=box,color=blue];
		j1117590842 -> j3363457327;
	j1880750320 [label="Qui a dit que j'essayais de le gérer?",shape=box,color=red];
		j1880750320 -> j557775222;
	j4083508797 [label="Je ne peux rien promettre.",shape=box,color=red];
		j4083508797 -> j2467118490;
	j957459896 [label="Je ne savais pas que tu avais ce côté-là.",shape=box,color=red];
		j957459896 -> j2633377791;
	j392595221 [label="Tu me surprends. C'est impressionnant. ",shape=box,color=red];
		j392595221 -> j2633377791;
	j2090826260 [label="+10 Chemistry",color=orange];
		j2090826260 -> j1365831495;
	j1140185119 [label="Oui, quels dégâts cela peut-il faire à une âme? Je comprends pourquoi tu voulais trouver quelqu'un qui te comprenne. Et pourquoi il voulait te trouver, toi.",shape=box,color=blue];
		j1140185119 -> j2090826260;
	j1648488127 [label="Avoir vécu si longtemps, avoir vu tant de morts, en avoir payé un si lourd tribut soi-même?",shape=box,color=blue];
		j1648488127 -> j1140185119;
	j3363457327 [label="+5 Chemistry",color=orange];
		j3363457327 -> j1365831495;
	j557775222 [label="Add -1 to Thermostat counter",color=orange];
		j557775222 -> j3453083492;
