	3607 [label="Chat ends.",color=orange];
	3609 [label="J'ai réfléchi à comment convaincre Loid de monter ces escaliers pour enfin parler à la famille et... j'ai une idée, mais je ne pense pas qu'elle te plaira.",shape=box,color=red];
		3609 -> 3614;
	3610 [label="As-tu réfléchi davantage à la façon de convaincre Loid de parler à la famille Entrati à l'étage?",shape=box,color=red];
		3610 -> 3615;
	3611 [label="Concernant l'idée de mettre Loid et la famille Entrati en contact, je me demandais... si tu avais reconsidéré l’implication de Roathe?",shape=box,color=red];
		3611 -> 3616;
	3612 [label="Marie, es-tu toujours partante pour... peut-être essayer de convaincre Loid de parler aux \"voisins du dessus\"? Je sais que nous sommes restés sur une note bizarre.",shape=box,color=red];
		3612 -> 3616;
	3608 [label="Je me demande pourquoi Monsieur Loid a si peur de parler à la famille du Cardinal.",shape=box,color=blue];
		3608 -> 3613;
	3614 [label="Check boolean MarieDating",color=orange];
		3614 -> 3619 [label=true,color=green];
		3614 -> 3618 [label=false,color=brown];
	3615 [label="Check boolean MarieDating",color=orange];
