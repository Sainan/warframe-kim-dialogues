	3616 [label="Check boolean MarieDating",color=orange];
		3616 -> 3623 [label=true,color=green];
		3616 -> 3622 [label=false,color=brown];
	3613 [label="Et comment sortir de cette impasse! Ce purgatoire dans lequel nous sommes prisonniers ne doit pas perdurer. Il est si inutilement douloureux.",shape=box,color=blue];
		3613 -> 3617;
	3619 [label="Bonjour, mon cœur! Et que crois-tu que je ne vais pas aimer ?",shape=box,color=blue];
		3619 -> 3625;
	3618 [label="Bonjour! Oh? Et que crois-tu que je ne vais pas aimer ?",shape=box,color=blue];
		3618 -> 3625;
	3621 [label="Bonjour, mon cœur! J'y ai réfléchi, oui... et j'ai vraiment du mal à l'admettre. Cela ne me fait pas plaisir de le dire.",shape=box,color=blue];
		3621 -> 3626;
	3620 [label="Bonjour, mon cœur! J'y ai réfléchi, oui... et j'ai vraiment du mal à l'admettre. Cela ne me fait pas plaisir de le dire.",shape=box,color=blue];
		3620 -> 3626;
	3623 [label="Bonjour, bonjour, mon cœur! J'y ai réfléchi, oui... et j'ai vraiment du mal à l'admettre. Cela ne me fait pas plaisir de le dire.",shape=box,color=blue];
		3623 -> 3627;
	3622 [label="Bonjour! J'y ai réfléchi, oui... et j'ai vraiment du mal à l'admettre. Cela ne me fait pas plaisir de le dire.",shape=box,color=blue];
		3622 -> 3627;
	3617 [label="Mais j'ai l'impression qu'il nous faut... une sorte de bastion, non? Aurais-tu des idées?",shape=box,color=blue];
		3617 -> 3624;
		3617 -> 3625;
	3625 [label="Je pense que nous aurons peut-être besoin de l'aide de Roathe pour convaincre Loid de parler à la famille Entrati. Je ne crois pas qu'il le fera autrement, sans garanties de protection pour lui et pour la famille.",shape=box,color=red];
		3625 -> 3629;
	3626 [label="Mais je pense... je pense – ah, Sol, pardonne-moi – qu’il faudra peut-être faire appel au diable. Je ne crois pas que Monsieur Loid nous écoutera autrement.",shape=box,color=blue];
		3626 -> 3630;
	3627 [label="Je crois que tu as raison. Le diable est peut-être la pièce manquante. Ah, rien que d'écrire ces mots, ça me fait mal! ",shape=box,color=blue];
		3627 -> 3631;
	3624 [label="Je n'ai pas vraiment de bonnes idées qui n'impliquent pas de faire appel à des sources déplaisantes. Des sources qui pourraient bien nous attirer de sérieux ennuis plus tard. Notamment, Roathe.",shape=box,color=red];
		3624 -> 3628;
	3629 [label="Je... déteste l'admettre, mais je crois que tu as raison... Sol, pardonne-moi.",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="Le diable est puissant et il peut être utile si les choses tournent mal, n'est-ce pas?",shape=box,color=blue];
		3630 -> 3634;
		3630 -> 3635;
	3631 [label="Evaluate expressions",color=orange];
		3631 -> 3638 [label="RoatheFamilyFail",color=purple];
		3631 -> 3637 [label="RoatheRedeemed, RoatheFamilyDelay
",color=purple];
