	3690 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3690 -> 3701;
	3689 [label="Merci, merci, merci, mon cœur!",shape=box,color=blue];
		3689 -> 3700;
	3688 [label="Merci, merci, merci!",shape=box,color=blue];
		3688 -> 3700;
	3687 [label="Eh bien! Le moment venu, je serai prête et j'attendrai! D'ici là, merci, mon cœur.",shape=box,color=blue];
		3687 -> 3699;
	3686 [label="Eh bien! Le moment venu, je serai prête et j'attendrai! D'ici là, merci.",shape=box,color=blue];
		3686 -> 3699;
	3697 [label="Je suis tout simplement heureuse de ton bonheur. Et si le diable sait où exercer ses... efforts... tant mieux, non?",shape=box,color=blue];
		3697 -> 3708;
	3698 [label="Je ne voudrais jamais insinuer que, puisque le diable semble t'apprécier, il t'écoutera peut-être alors qu'il semble ignorer tout le monde.",shape=box,color=blue];
		3698 -> 3709;
	3692 [label="Tous ceux qui l'ont côtoyé ont essayé de le faire passer pour un monstre. Je suppose que je suis la première personne à ne pas l'avoir fait.",shape=box,color=red];
		3692 -> 3703;
	3693 [label="Il y a beaucoup de choses chez lui qu'il ne sait pas comment montrer. Ce n'est pas une carapace à proprement parler, mais il se méfie des autres et craint qu'ils ne lui fassent du mal.",shape=box,color=red];
		3693 -> 3704;
	3695 [label="Il a... connu de véritables peines de cœur au cours de sa longue vie. Il a simplement pansé ses plaies avant de les recouvrir d'épines, c'est tout.",shape=box,color=red];
		3695 -> 3706;
	3696 [label="Je crois que je peux comprendre le nombre d'années qu'il a vécues. J'ai vu autant de morts que lui.",shape=box,color=red];
		3696 -> 3707;
	3694 [label="Il n'a jamais cherché qu'à faire ce qui était juste. Peut-être pas de la bonne manière, certes, mais il essayait de sauver le Système Origine des Orokins.",shape=box,color=red];
		3694 -> 3705;
	3691 [label="J'apprécie son humour pince-sans-rire. Il est intelligent, une fois qu'on a surmonté son ego.",shape=box,color=red];
		3691 -> 3702;
	3701 [label="Chat ends.",color=orange];
	3700 [label="Eh bien! Le moment venu, je serai prête et j'attendrai! À bientôt!",shape=box,color=blue];
		3700 -> 3711;
	3699 [label="Update boolean MarieFamilySuccess",color=orange];
		3699 -> 3710;
	3708 [label="Et ce sera d'autant mieux pour nous tous si tu lui sers de contrepoids pour le tempérer.",shape=box,color=blue];
		3708 -> 3716;
		3708 -> 3717;
	3709 [label="Et jamais pendant les moments privés. Non. Jamais.",shape=box,color=blue];
		3709 -> 3718;
		3709 -> 3719;
	3703 [label="Et je suppose que je suis en tête de la liste, n'est-ce pas? Je suppose que je devrais... tenter de comprendre les raisons de son comportement. La condamnation ne sauve aucune âme.",shape=box,color=blue];
		3703 -> 3713;
	3704 [label="Il y a toujours une souffrance que l'on cache à ceux qui nous entourent. Quelque chose que l'on cherche à protéger, de peur que d'autres ne s'en servent. Je suppose que je devrais m'efforcer d'être plus gentille avec lui, si ce que tu dis est vrai.",shape=box,color=blue];
		3704 -> 3713;
	3706 [label="Je n'arrive pas à imaginer la quantité d'amour et de décès qu'on doit endurer pendant toutes ces années. Cela me paraît tellement irréel, même après tout ce que j'ai vu.",shape=box,color=blue];
		3706 -> 3714;
	3707 [label="Parfois, quand je lui parle, j'oublie combien de siècles il a traversés. Cela me paraît tellement irréel, même compte tenu de tout ce que j'ai vu.",shape=box,color=blue];
		3707 -> 3715;
	3705 [label="Il y a toujours des nuances, n'est-ce pas? Toujours des raisons d'agir d'une manière ou d'une autre. Je suppose que je devrais m'efforcer d'être plus gentille avec lui, si ce que tu dis est vrai.",shape=box,color=blue];
		3705 -> 3713;
	3702 [label="Personne n'a jamais mis la malice du diable en doute.",shape=box,color=blue];
		3702 -> 3712;
	3711 [label="Update boolean MarieFamilySuccess",color=orange];
		3711 -> 3721;
	3710 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3710 -> 3720;
	3716 [label="Qui a dit que j'essayais de le gérer?",shape=box,color=red];
		3716 -> 3723;
	3717 [label="Je ne peux rien promettre.",shape=box,color=red];
		3717 -> 3724;
	3718 [label="Je ne savais pas que tu avais ce côté-là.",shape=box,color=red];
		3718 -> 3684;
	3719 [label="Tu me surprends. C'est impressionnant. ",shape=box,color=red];
		3719 -> 3684;
	3713 [label="+10 Chemistry",color=orange];
		3713 -> 3722;
	3714 [label="Oui, quels dégâts cela peut-il faire à une âme? Je comprends pourquoi tu voulais trouver quelqu'un qui te comprenne. Et pourquoi il voulait te trouver, toi.",shape=box,color=blue];
		3714 -> 3713;
	3715 [label="Avoir vécu si longtemps, avoir vu tant de morts, en avoir payé un si lourd tribut soi-même?",shape=box,color=blue];
		3715 -> 3714;
	3712 [label="+5 Chemistry",color=orange];
		3712 -> 3722;
	3721 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3721 -> 3725;
	3720 [label="Chat ends.",color=orange];
	3723 [label="Add -1 to Thermostat",color=orange];
		3723 -> 3726;
	3724 [label="Add 1 to Thermostat",color=orange];
		3724 -> 3727;
	3722 [label="Je suis simplement heureuse que le diable ait enfin quelqu'un à qui parler, quelqu'un qui pourrait chercher à le gérer. Un ange sur son épaule.",shape=box,color=blue];
		3722 -> 3716;
		3722 -> 3717;
	3725 [label="Chat ends.",color=orange];
	3726 [label="+10 Chemistry",color=orange];
		3726 -> 3728;
	3727 [label="+10 Chemistry",color=orange];
		3727 -> 3729;
	3728 [label="Peut-être que tu as raison... que serait un ange sans son diable? Il nous rappelle à tous ce que nous devrions nous efforcer d’éviter.",shape=box,color=blue];
		3728 -> 3730;
	3729 [label="Oui, je crains qu'il y ait en lui une perversité incurable. Il y prend trop de plaisir.",shape=box,color=blue];
		3729 -> 3730;
	3730 [label="Eh bien! Si jamais tu parviens à convaincre le diable de nous aider dans notre mission, je serai prête! À bientôt!",shape=box,color=blue];
		3730 -> 3731;
	3731 [label="Update boolean MarieFamilySuccess",color=orange];
		3731 -> 3732;
