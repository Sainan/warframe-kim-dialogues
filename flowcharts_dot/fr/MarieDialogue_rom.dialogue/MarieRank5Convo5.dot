	3115 [label="Oui, c'est bien vrai. Nous avons de la chance.",shape=box,color=blue];
		3115 -> 3120;
	3116 [label="C'est un homme sérieux, mais je l'ai vu sourire. Il a un sens de l'humour inattendu. Il faut juste être patient.",shape=box,color=blue];
		3116 -> 3120;
	3117 [label="Si ça peut te rassurer, pareil pour moi. Je soupçonne que le gamin ne s'en souvient pas non plus.",shape=box,color=red];
