	3099 [label="Aucun des Cavias ne connaît sa date de naissance, ce qui me paraît logique, étant donné qu'ils sont nés sans pouvoir parler ni connaître le calendrier comme nous.",shape=box,color=blue];
		3099 -> 3100;
	3100 [label="Alors, je me suis dit: quelle tragédie! Il faut remédier à cela immédiatement, n'est-ce pas?",shape=box,color=blue];
