	3109 [label="Nous avons tous la chance de connaître la bonté de Monsieur Loid. Sa générosité est sans limite.",shape=box,color=blue];
		3109 -> 3112;
		3109 -> 3113;
	3110 [label="Mais ensuite, je me suis souvenue... de mes conversations avec Monsieur Tagfer et les autres et je me suis dit... que ce n'était peut-être pas si judicieux.",shape=box,color=blue];
		3110 -> 3114;
	3111 [label="Mais ils ne semblaient pas intéressés par la recherche de documents sur leur passé. Je sais combien il peut être douloureux de penser à ses origines.",shape=box,color=blue];
