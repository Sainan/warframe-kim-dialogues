		j20182927 -> j3339548253 [label=true,color=green];
		j20182927 -> j1367677313 [label=false,color=brown];
	j3339548253 [label="Bonjour, bonjour, mon cœur! Je dois te parler d'une chose incroyable.",shape=box,color=blue];
		j3339548253 -> j2536885006;
		j3339548253 -> j2429168889;
	j1367677313 [label="Bonjour! Je dois te parler d'une chose incroyable.",shape=box,color=blue];
		j1367677313 -> j2536885006;
		j1367677313 -> j2429168889;
	j2536885006 [label="Oh Que s'est-il passé?",shape=box,color=red];
		j2536885006 -> j2770404979;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j2770404979 [label="J'ai demandé à Monsieur Oiseau Trois quelle était sa date de naissance et il ne le savait pas! Quelle tristesse!",shape=box,color=blue];
		j2770404979 -> j1052519743;
	"Chat ends." [color=orange];
	j1052519743 [label="Aucun des Cavias ne connaît sa date de naissance, ce qui me paraît logique, étant donné qu'ils sont nés sans pouvoir parler ni connaître le calendrier comme nous.",shape=box,color=blue];
		j1052519743 -> j1427034719;
	j1427034719 [label="Alors, je me suis dit: quelle tragédie! Il faut remédier à cela immédiatement, n'est-ce pas?",shape=box,color=blue];
		j1427034719 -> j619115508;
		j1427034719 -> j164934308;
		j1427034719 -> j2545761465;
	j619115508 [label="Je n'y avais jamais pensé.",shape=box,color=red];
		j619115508 -> j3194396964;
	j164934308 [label="Comment comptes-tu découvrir quand ils sont nés?",shape=box,color=red];
		j164934308 -> j3776573874;
	j2545761465 [label="Tu vas les laisser choisir leur date de naissance?",shape=box,color=red];
		j2545761465 -> j575337681;
	j3194396964 [label="Oui! Monsieur Loid non plus. Son visage, quand je l'ai découvert, exprimait une profonde tristesse...",shape=box,color=blue];
		j3194396964 -> j1385590640;
	j3776573874 [label="Au début, j'ai pensé à consulter les registres du Cardinal - peut-être qu'il y avait consigné leur date de naissance, non?",shape=box,color=blue];
		j3776573874 -> j2402114516;
	j575337681 [label="\"Laisser?\" Tu le dis comme si ça ne tenait qu'à moi! ",shape=box,color=blue];
		j575337681 -> j3776573874;
	j1385590640 [label="Ça me brise le cœur qu'il pense que c'est de sa faute de ne pas y avoir pensé en premier. Ce n'est pas sa faute, il en fait tellement pour tant de gens...",shape=box,color=blue];
		j1385590640 -> j2022933850;
	j2402114516 [label="Evaluate expressions",color=orange];
		j2402114516 -> j2483914039 [label="MarieEntratiComplete",color=purple];
		j2402114516 -> j2483914039 [label="MarieEntrati3a",color=purple];
		j2402114516 -> j4188302316 [label="false",color=purple];
	j2022933850 [label="Nous avons tous la chance de connaître la bonté de Monsieur Loid. Sa générosité est sans limite.",shape=box,color=blue];
		j2022933850 -> j228874254;
		j2022933850 -> j1167084912;
	j2483914039 [label="Mais ensuite, je me suis souvenue... de mes conversations avec Monsieur Tagfer et les autres et je me suis dit... que ce n'était peut-être pas si judicieux.",shape=box,color=blue];
		j2483914039 -> j2254757425;
	j4188302316 [label="Mais ils ne semblaient pas intéressés par la recherche de documents sur leur passé. Je sais combien il peut être douloureux de penser à ses origines.",shape=box,color=blue];
		j4188302316 -> j2254757425;
	j228874254 [label="Nous avons vraiment de la chance qu'il soit ici.",shape=box,color=red];
		j228874254 -> j3008400587;
	j1167084912 [label="J'aimerais juste qu'il soit un peu plus jovial de temps en temps.",shape=box,color=red];
		j1167084912 -> j4206787886;
	j2254757425 [label="Après tout, je ne connais même pas ma propre date de naissance. ",shape=box,color=blue];
		j2254757425 -> j2571683784;
		j2254757425 -> j2667578812;
		j2254757425 -> j4150866988;
	j3008400587 [label="Oui, c'est bien vrai. Nous avons de la chance.",shape=box,color=blue];
		j3008400587 -> j3542593548;
	j4206787886 [label="C'est un homme sérieux, mais je l'ai vu sourire. Il a un sens de l'humour inattendu. Il faut juste être patient.",shape=box,color=blue];
		j4206787886 -> j3542593548;
	j2571683784 [label="Si ça peut te rassurer, pareil pour moi. Je soupçonne que le gamin ne s'en souvient pas non plus.",shape=box,color=red];
		j2571683784 -> j3042005860;
	j2667578812 [label="Les anniversaires sont surcotés.",shape=box,color=red];
		j2667578812 -> j3141657286;
	j4150866988 [label="C'est plus amusant de choisir soi-même, de toute façon. Plus émouvant. ",shape=box,color=red];
		j4150866988 -> j3469290493;
	j3542593548 [label="Check boolean MarieDating",color=orange];
		j3542593548 -> j3514740734 [label=true,color=green];
		j3542593548 -> j4135495262 [label=false,color=brown];
	j3042005860 [label="Encore des raisons de pleurer pour toi et ta minuscule copie. Mais encore des points communs, aussi!",shape=box,color=blue];
		j3042005860 -> j3542593548;
	j3141657286 [label="Je ne trouve pas! Nous devons célébrer ceux qui sont encore parmi nous, tout comme nous célébrons ceux qui nous ont quittés.",shape=box,color=blue];
		j3141657286 -> j3542593548;
	j3469290493 [label="Émouvant? Je ne savais pas que tu connaissais ce terme! Tu l'as appris de moi?",shape=box,color=blue];
		j3469290493 -> j761935588;
		j3469290493 -> j2374276473;
	j3514740734 [label="+20 Chemistry",color=orange];
		j3514740734 -> j1067352190;
	j4135495262 [label="+20 Chemistry",color=orange];
		j4135495262 -> j3878261566;
	j761935588 [label="Je... pense que c'est universel...",shape=box,color=red];
		j761935588 -> j2611234470;
	j2374276473 [label="Je l'ai sans doute appris de toi.",shape=box,color=red];
		j2374276473 -> j1766336351;
	j1067352190 [label="Allez! Viens, mon cœur! Même si ça ne donne rien, c'est toujours l'intention qui compte! Au calendrier!",shape=box,color=blue];
		j1067352190 -> "Chat ends.";
	j3878261566 [label="Allez! Viens! Même si cela ne donne rien, c'est l'intention qui compte! Au calendrier!",shape=box,color=blue];
		j3878261566 -> "Chat ends.";
	j2611234470 [label="Pff! On me vole toujours mes mots préférés! Rien ne changera jamais!",shape=box,color=blue];
		j2611234470 -> j3542593548;
	j1766336351 [label="Alors, bien joué! C'est un mot qui sera très utile dans le futur.",shape=box,color=blue];
		j1766336351 -> j3542593548;
}