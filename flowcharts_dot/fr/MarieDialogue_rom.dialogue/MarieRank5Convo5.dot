		3103 -> 3106;
	3104 [label="Oui! Monsieur Loid non plus. Son visage, quand je l'ai découvert, exprimait une profonde tristesse...",shape=box,color=blue];
		3104 -> 3107;
	3105 [label="Au début, j'ai pensé à consulter les registres du Cardinal - peut-être qu'il y avait consigné leur date de naissance, non?",shape=box,color=blue];
		3105 -> 3108;
	3106 [label="\"Laisser?\" Tu le dis comme si ça ne tenait qu'à moi! ",shape=box,color=blue];
		3106 -> 3105;
	3107 [label="Ça me brise le cœur qu'il pense que c'est de sa faute de ne pas y avoir pensé en premier. Ce n'est pas sa faute, il en fait tellement pour tant de gens...",shape=box,color=blue];
