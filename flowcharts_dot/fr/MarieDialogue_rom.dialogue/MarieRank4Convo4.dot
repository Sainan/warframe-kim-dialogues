	"Chat ends." [color=orange];
	j2127223472 [label="Oui, même si j'ai l'impression de savoir de quoi il s'agit... Je me suis mal comportée. Qui te l'a dit?",shape=box,color=blue];
		j2127223472 -> j1750871659;
		j2127223472 -> j1158101430;
		j2127223472 -> j1782267433;
	j3753761621 [label="Bien sûr, ce salaud de diable ouvre sa bouche et te raconte tout! Il ne cherche qu'à m'embarrasser!",shape=box,color=blue];
		j3753761621 -> j2491400638;
	j1750871659 [label="Ce n'est pas important.",shape=box,color=red];
		j1750871659 -> j330335671;
	j1158101430 [label="Loid. ",shape=box,color=red];
		j1158101430 -> j2540293237;
	j1782267433 [label="Roathe.",shape=box,color=red];
		j1782267433 -> j3753761621;
	j2491400638 [label="Si je le pouvais, je prendrais ce couteau qu'il aime tant utiliser pour agacer les autres et je le fourrerais là où seule Lua pourrait le voir!",shape=box,color=blue];
		j2491400638 -> j2702619918;
	j330335671 [label="Je crois que si, mais je pense que tu cherches à me ménager. Alors, je n'insisterai pas davantage.",shape=box,color=blue];
		j330335671 -> j968468260;
	j2540293237 [label="Je pense que tu mens pour ménager mon humeur, alors je n'insisterai pas.",shape=box,color=blue];
		j2540293237 -> j968468260;
	j2702619918 [label="Pardonne-moi. C'était... déplacé. Je suis une Sœur de Sol et je ne dois pas m'emporter ni me délier la langue de cette façon.",shape=box,color=blue];
		j2702619918 -> j979080600;
	j968468260 [label="+5 Chemistry",color=orange];
		j968468260 -> j2220928755;
	j979080600 [label="+5 Chemistry",color=orange];
		j979080600 -> j1548985174;
	j2220928755 [label="Je souhaite conserver dans cette conversation un minimum de dignité.",shape=box,color=blue];
		j2220928755 -> j772642329;
	j1548985174 [label="Ma colère n'est pas dirigée contre toi. Et je te suis toujours reconnaissante de ton honnêteté.",shape=box,color=blue];
		j1548985174 -> j1433246053;
	j772642329 [label="Si tu es là pour me parler de la dispute que j'ai eue avec Monsieur Tagfer, je ne nierai pas qu'elle a eu lieu.",shape=box,color=blue];
		j772642329 -> j1433246053;
	j1433246053 [label="Je suppose que le diable t'a dit sur quoi portait la dispute?",shape=box,color=blue];
		j1433246053 -> j370765590;
	j370765590 [label="Evaluate expressions",color=orange];
		j370765590 -> j435982014 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j3104961474 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j62252484 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j435982014 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j435982014 [label="false",color=purple];
		j370765590 -> j75368817 [label="false",color=purple];
	j435982014 [label="Il n'a pas eu besoin de me le dire, j'ai deviné facilement. Entrati.",shape=box,color=red];
		j435982014 -> j2400929360;
	j3104961474 [label="Il l'a fait. Même s'il semblait plus préoccupé par toi que par autre chose.",shape=box,color=red];
		j3104961474 -> j2159646443;
	j62252484 [label="Il l'a fait. Il est préoccupé par la situation parce que je pense qu'il a de la peine pour les Cavias. ",shape=box,color=red];
		j62252484 -> j2221804435;
	j75368817 [label="Non, honnêtement. Il m'a juste dit de prendre de tes nouvelles.",shape=box,color=red];
		j75368817 -> j2385398647;
	j2400929360 [label="Oui. Monsieur Tagfer parlait du Cardinal.",shape=box,color=blue];
		j2400929360 -> j739344112;
		j2400929360 -> j3580437126;
	j2159646443 [label="Je ne sais pas pourquoi le diable voudrait te faire croire une telle chose, ni à quoi cela lui servirait.",shape=box,color=blue];
		j2159646443 -> j2794834695;
	j2221804435 [label="Le diable voit trois animaux blessés et sait qu'il peut facilement utiliser son charisme pour les amener à se prosterner devant lui.",shape=box,color=blue];
		j2221804435 -> j3179029672;
	j2385398647 [label="Je ne comprends pas pourquoi le diable voudrait que tu fasses une telle chose. Ni en quoi il pense que cela lui serait utile.",shape=box,color=blue];
		j2385398647 -> j936697710;
	j739344112 [label="Tagfer n’est pas le plus grand partisan d’Entrati, non.",shape=box,color=red];
		j739344112 -> j3029001283;
	j3580437126 [label="Je suppose que la dispute a été intense.",shape=box,color=red];
		j3580437126 -> j2983216106;
	j2794834695 [label="Tous les actes de prétendue bonté du diable à mon égard servent son objectif: me retourner contre le Cardinal. Je le sais. ",shape=box,color=blue];
		j2794834695 -> j3868390929;
	j3179029672 [label="Il fait ça pour retourner la situation contre moi. Il souhaite me retourner contre le Cardinal. Me voir lui tourner le dos. Je le sais.",shape=box,color=blue];
		j3179029672 -> j3868390929;
	j936697710 [label="Mais... ce n'est pas de cela dont tu veux discuter. La dispute concernait le Cardinal. ",shape=box,color=blue];
		j936697710 -> j739344112;
		j936697710 -> j3580437126;
	j3029001283 [label="Et c'est ça que je ne comprends pas! Regarde ce qui leur a été donné!",shape=box,color=blue];
		j3029001283 -> j2339097917;
		j3029001283 -> j3469886116;
	j2983216106 [label="Oui! Il m'a traitée d'idiote. Il m'a dit que je n'étais qu'une enfant.",shape=box,color=blue];
		j2983216106 -> j3023743465;
		j2983216106 -> j2339097917;
	j3868390929 [label="Et c'est au sujet du Cardinal que Monsieur Tagfer et moi nous nous disputions.",shape=box,color=blue];
		j3868390929 -> j739344112;
		j3868390929 -> j3580437126;
	j2339097917 [label="S'il te plaît, reprends depuis le début. Comment toute cette bagarre a-t-elle commencé?",shape=box,color=red];
		j2339097917 -> j2821195432;
	j3469886116 [label="Je commence à comprendre pourquoi cette dispute a eu lieu.",shape=box,color=red];
		j3469886116 -> j2821195432;
	j3023743465 [label="Est-ce qu'il t'a vraiment traitée d'idiote et d'enfant?",shape=box,color=red];
		j3023743465 -> j3827964018;
	j2821195432 [label="Oui. J'ai parlé du Cardinal, rien d'autre. ",shape=box,color=blue];
		j2821195432 -> j1973697996;
	j3827964018 [label="Pire encore, peut-être.",shape=box,color=blue];
		j3827964018 -> j1827877421;
	j1973697996 [label="Monsieur Tagfer a levé les yeux au ciel et reniflé. Je lui ai demandé de s'expliquer.",shape=box,color=blue];
		j1973697996 -> j1036362197;
	j1827877421 [label="\"Tu es une enfant, Marie! Innocente. Dépendante des autres toute ta vie. Blottie dans ton petit nid de foi aveugle!\"",shape=box,color=blue];
		j1827877421 -> j3490893922;
	j1036362197 [label="\"Albrecht est un sale menteur puant!\"",shape=box,color=blue];
		j1036362197 -> j3399644775;
	j3490893922 [label="\"Tu survis grâce à ce que tes aînés ont mâché et recraché dans ta bouche béante et crédule!\"",shape=box,color=blue];
		j3490893922 -> j471012429;
	j3399644775 [label="Et j'ai répondu: \"Regardez ce qui vous a été offert: les dons de la pensée et du langage!\"",shape=box,color=blue];
		j3399644775 -> j1538656764;
	j471012429 [label="Boolean MarieEntrati3 is now true.",color=orange];
		j471012429 -> j581757740;
		j471012429 -> j3334573880;
		j471012429 -> j795903138;
	j1538656764 [label="\"Vous devriez être reconnaissant envers le Cardinal pour tout ce qu'il vous a donné.\"",shape=box,color=blue];
		j1538656764 -> j657191955;
		j1538656764 -> j1419744445;
	j581757740 [label="Tagfer ne connaît que sa version des faits. Les véritables motivations et opinions d'Entrati ne lui ont pas été... clairement expliquées.",shape=box,color=red];
		j581757740 -> j2750371245;
	j3334573880 [label="Je sais ce que tu ressens à l'idée d'être \"dépendante\" des autres et je regrette qu'il t'ait dit ces choses.",shape=box,color=red];
		j3334573880 -> j877412652;
	j795903138 [label="Tagfer a de bonnes raisons de se sentir comme cela.",shape=box,color=red];
		j795903138 -> j946548047;
	j657191955 [label="Et comment a-t-il pris ça?",shape=box,color=red];
		j657191955 -> j1827877421;
	j1419744445 [label="Oh, non...",shape=box,color=red];
		j1419744445 -> j1827877421;
