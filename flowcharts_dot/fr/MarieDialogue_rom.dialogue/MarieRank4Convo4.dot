		j1639327012 -> j1485779339 [label="MarieInfestation",color=purple];
		j1639327012 -> j1445338973 [label="MarieLyonSuffering2",color=purple];
		j1639327012 -> j2808572732 [label="MarieLyonSuffering2",color=purple];
		j1639327012 -> j1445338973 [label="MarrieLyonSuffering3",color=purple];
		j1639327012 -> j1445338973 [label="false",color=purple];
	j4016109914 [label="Si tu essaies de m’inciter à sympathiser avec eux et à tourner ma colère contre toi, je suis soudainement tentée.",shape=box,color=blue];
		j4016109914 -> j3967406641;
	j3967406641 [label="Il serait peut-être préférable de nous arrêter ici, avant que la colère ne nous gagne tous.",shape=box,color=blue];
		j3967406641 -> "Chat ends.";
	j697971816 [label="Oui? Eh bien, je suis heureuse de te dire que tu as échoué.",shape=box,color=blue];
		j697971816 -> j1509439757;
	j1445338973 [label="Les Cavias ont été créés accidentellement suite à des expériences ratées. Les animaux de laboratoire n'auraient jamais dû exister. Le Néant leur a donné l'intelligence.",shape=box,color=red];
		j1445338973 -> j4035086951;
	j802329168 [label="Tu as dit toi-même: \"C'est la forme ultime de la cruauté, d'être privé d'un nom.\" Entrati n'a jamais pris la peine de les nommer, tant ils étaient inutiles.",shape=box,color=red];
		j802329168 -> j3142553447;
	j2752235127 [label="Tu m'as raconté comment tu as grandi dans la rue. Comment ta famille t'a mise à la porte parce que tu n'étais pas assez bien pour eux.",shape=box,color=red];
		j2752235127 -> j2489831524;
	j1485779339 [label="Pense à ce que tu aurais ressenti si tu avais simplement été transformée en protoframe contre ta volonté, puis abandonnée?",shape=box,color=red];
		j1485779339 -> j2099522841;
	j2808572732 [label="Imagine ce que tu ressentirais si Entrati débarquait, transformait Lyon en protoframe et l'abandonnait?",shape=box,color=red];
		j2808572732 -> j2307896913;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j4035086951 [label="Et quand Entrati a vu ce qu'il avait fait? Quand il a réalisé ce qu'il avait créé? Ces pauvres animaux, parlant la langue du Néant, malades d'y avoir été exposés?",shape=box,color=red];
		j4035086951 -> j3408360362;
	j3142553447 [label="Pour lui, ils n'étaient que des choses. Des objets à utiliser et à jeter. \"Tagfer?\" Cela signifie \"Étiqueté pour élimination\".",shape=box,color=red];
		j3142553447 -> j350294866;
	j2489831524 [label="Ta famille pensait que tu ne valais rien.",shape=box,color=red];
		j2489831524 -> j1205634693;
	j2099522841 [label="Imagine ce que cela aurait été d'avoir l'Infestation dans le sang, de souffrir, sans que personne ne soit là pour apporter un soutien?",shape=box,color=red];
		j2099522841 -> j1042978989;
	j2307896913 [label="S'il l'avait utilisé comme une expérience scientifique sans valeur, puis s'en était lavé les mains? Vous pouviez tous compter les uns sur les autres avant et après votre transformation. Les Cavias, non.",shape=box,color=red];
		j2307896913 -> j3256791917;
	j2631316640 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j2631316640 -> j1508231473;
