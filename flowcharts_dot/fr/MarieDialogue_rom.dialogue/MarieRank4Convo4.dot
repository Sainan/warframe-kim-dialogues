		j946548047 -> j4067173896 [label="MarieEntratiFan2",color=purple];
		j946548047 -> j756863646 [label="MarieEntratiNeutral",color=purple];
		j946548047 -> j4037163521 [label="false",color=purple];
	j1969619296 [label="Ça ne lui donne toujours pas le droit de réagir comme ça! Je ne sais pas s'il réalise à quel point ses mots m'ont blessée. En outre...",shape=box,color=blue];
		j1969619296 -> j946548047;
	j2275185188 [label="Merci, j'ignore s'il sait à quel point ses mots m'ont blessée.",shape=box,color=blue];
		j2275185188 -> j1159305875;
		j2275185188 -> j556436622;
		j2275185188 -> j174592288;
	j123203451 [label="Si c'est l'accueil que le Cardinal va recevoir à son retour, il n'est pas étonnant qu'il reste à l'écart!",shape=box,color=blue];
		j123203451 -> j3446571597;
		j123203451 -> j1208668395;
	j2441053417 [label="Et je suis sûre que tu prends le parti de Monsieur Tagfer dans tout ça, hein? Tu crois que le Cardinal est un monstre, tout comme la bête.",shape=box,color=blue];
		j2441053417 -> j3446571597;
		j2441053417 -> j2126207818;
	j4067173896 [label="Je suis surprise, je pensais que tu étais de mon côté! Tu n'étais pas avec moi pour défendre la cause du Cardinal il y a un instant?",shape=box,color=blue];
		j4067173896 -> j1233228185;
	j756863646 [label="Qu'importe, comme tu l'as déjà dit? Nous devons le servir dans ses projets et le juger plus tard. Cette dispute n'a aucun sens, non?",shape=box,color=blue];
		j756863646 -> j1003650248;
		j756863646 -> j1464405458;
	j4037163521 [label="Je sais qu'ils ont été créés par le Néant, des mains du Cardinal. Nous avons tous reçu du Cardinal des cadeaux qui sont une malédiction si on les regarde avec un cœur brisé!",shape=box,color=blue];
		j4037163521 -> j2882775140;
	j1159305875 [label="Et sais-tu à quel point les tiens l'ont blessé, lui? Connais-tu toute son histoire?",shape=box,color=red];
		j1159305875 -> j4037163521;
	j556436622 [label="Et ce que tu as dit lui a fait tout autant de mal.",shape=box,color=red];
		j556436622 -> j3871306472;
	j174592288 [label="Je suis honnêtement de ton côté, mais..... nous devons essayer de maintenir la paix, Marie.",shape=box,color=red];
		j174592288 -> j2593067308;
		j174592288 -> j2490265529;
	j3446571597 [label="Marie, s'il te plaît. Je ne cherche pas à me battre. J'essaie juste de te faire comprendre ce qu'ils ont vécu.",shape=box,color=red];
		j3446571597 -> j945414299;
	j1208668395 [label="Si Entrati était resté pour aider à nettoyer ses propres dégâts, il aurait peut-être plus d'amis dans ce monde.",shape=box,color=red];
		j1208668395 -> j1531616018;
	j2126207818 [label="Oui, je suis de son côté. Parce que tu n'écoutes pas la voix de la raison. Tu dois comprendre que \"le Cardinal\" n'est pas ce qu'il paraît.",shape=box,color=red];
		j2126207818 -> j945414299;
	j1233228185 [label="Est-ce que c'était une grande tromperie de ta part? As-tu joué à un jeu avec la petite Marie?",shape=box,color=blue];
		j1233228185 -> j2837095607;
		j1233228185 -> j2774711981;
	j1003650248 [label="C'est important s'il ne reste plus personne autour de nous une fois que nous serons de l'autre côté. Ils ont traversé beaucoup d'épreuves.",shape=box,color=red];
		j1003650248 -> j945414299;
	j1464405458 [label="Je pense qu'il l'oubliera. Et toi aussi.",shape=box,color=red];
		j1464405458 -> j243414516;
	j2882775140 [label="Nous avons tous été abandonnés par lui! Dis-moi, ont-ils été maltraités au point que je doive tolérer une telle haine?!",shape=box,color=blue];
		j2882775140 -> j1639327012;
	j3871306472 [label="Oui?! Alors, dis-moi pourquoi!",shape=box,color=blue];
		j3871306472 -> j4037163521;
	j2593067308 [label="La situation que les Cavias ont traversée a été... dure.",shape=box,color=red];
		j2593067308 -> j4037163521;
	j2490265529 [label="Ce sont des animaux et même s'ils sont dotés d'intelligence, ils restent des animaux. Leurs capacités sont limitées.",shape=box,color=red];
		j2490265529 -> j4016109914;
	j945414299 [label="Oui? Alors, joue le rôle de la Lumière Sacrée de Sol et chasse les ténèbres! Éclaire la petite folle de Marie!",shape=box,color=blue];
		j945414299 -> j4037163521;
	j1531616018 [label="Oui! Vraiment, ce n'est pas suffisant qu'il tente de sauver l'univers connu d'un dieu du Néant, c'est ça?!",shape=box,color=blue];
		j1531616018 -> j3967406641;
	j2837095607 [label="Non, je ne te mens pas. Je suis d'accord avec toi. Je dis juste que leur situation a été... difficile.",shape=box,color=red];
		j2837095607 -> j945414299;
	j2774711981 [label="Non, pas du tout. Entrati n'est pas digne de confiance et je ne sais pas comment te convaincre autrement qu'en faisant semblant d'être de ton côté.",shape=box,color=red];
		j2774711981 -> j697971816;
	j243414516 [label="Non! Tu as commencé cette conversation et tu la poursuivras. Explique!",shape=box,color=blue];
		j243414516 -> j4037163521;
	j1639327012 [label="Evaluate expressions",color=orange];
		j1639327012 -> j1445338973 [label="MarieFamily2",color=purple];
