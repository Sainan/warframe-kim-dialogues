		j3408360362 -> j3260014290;
	j350294866 [label="Oiseau-3? C'est un oiseau dont le nom est un numéro. Fibonacci s'est donné son nom.",shape=box,color=red];
		j350294866 -> j4103429335;
	j1205634693 [label="Voilà ce qu'étaient les Cavias pour Entrati. Des animaux de laboratoire jetables. \"Tagfer?\" Cela signifie \"Étiqueté pour élimination\".",shape=box,color=red];
		j1205634693 -> j350294866;
	j1042978989 [label="De te dire que personne ne s'inquiétait de ta souffrance? Les Cavias étaient – sont – sans valeur pour Entrati. Des animaux de laboratoire jetables. \"Tagfer?\" Cela signifie \"Étiqueté pour élimination\".",shape=box,color=red];
		j1042978989 -> j350294866;
	j3256791917 [label="Pour Entrati, les Cavias n'étaient que des animaux de laboratoire sans valeur. \"Tagfer?\" Cela signifie \"Étiqueté pour élimination\".",shape=box,color=red];
		j3256791917 -> j350294866;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j3260014290 [label="Voilà ce qu'étaient les Cavia pour Entrati. Jetables. \"Tagfer?\" Cela signifie \"Étiqueté pour élimination\".",shape=box,color=red];
		j3260014290 -> j2220522814;
	j4103429335 [label="Utilisés dans une expérience du Néant. Survivants d'une longue lignée d'animaux morts. N'ayant jamais été destinés à exister.",shape=box,color=red];
		j4103429335 -> j39572128;
	j2220522814 [label="Le dernier de son espèce. À éliminer. Sa compagne? Minn? La seule autre survivante? Morte pendant l'expérience.",shape=box,color=red];
		j2220522814 -> j2581004378;
	j39572128 [label="C'est uniquement grâce à Loid qu'ils sont encore en vie. Il les a préservés, car il ne pouvait se résoudre à les euthanasier \"conformément aux instructions d'Entrati\".",shape=box,color=red];
		j39572128 -> j1708554682;
	j2581004378 [label="C'est pour ça qu'il était en colère, Marie. C'est pour ça qu'il déteste Entrati. Et c'est probablement pour ça qu'il le détestera toujours.",shape=box,color=red];
		j2581004378 -> j2433363310;
	j1708554682 [label="Oh, et Tagfer? C'est le dernier de son espèce. Sa compagne, Minn? La seule autre survivante? Morte pendant l'expérience.",shape=box,color=red];
		j1708554682 -> j3550470529;
