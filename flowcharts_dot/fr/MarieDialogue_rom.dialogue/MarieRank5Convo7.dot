	j2270641537 [label="Lyon n'aurait jamais imaginé faire une chose pareille. Parler aux autres de cette façon. Il s'amusait.",shape=box,color=blue];
		j2270641537 -> j2691315439;
	j2691315439 [label="Et je sais que ce ne sont pas les Luminaires que je dois remercier pendant ma prière du soir pour cela. C'est toi.",shape=box,color=blue];
