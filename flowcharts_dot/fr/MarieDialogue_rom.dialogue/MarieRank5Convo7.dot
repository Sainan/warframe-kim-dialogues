		j3177095830 -> j517702979;
	j415795762 [label="Pour tout ce que tu as fait pour aider mon frère d'âme? Même si nous ne sommes pas d'accord sur d'autres points et que nous ne serons peut-être jamais d'accord du tout, ceci? Ceci, je le ferai pour toi.",shape=box,color=blue];
