		j2486207884 -> j2270641537 [label="false",color=purple];
	j2250216020 [label="Notre cher Lyon n'aurait jamais imaginé faire une chose pareille. Parler aux autres de cette façon. Il s'amusait.",shape=box,color=blue];
		j2250216020 -> j2691315439;
	j3158377787 [label="Lyon n'aurait jamais imaginé faire une chose pareille. Parler aux autres de cette façon. Il s'amusait, mon cœur.",shape=box,color=blue];
