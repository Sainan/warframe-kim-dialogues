	j4238459910 [label="+5 Chemistry",color=orange];
		j4238459910 -> j3649520946;
	j2923521658 [label="Tu en fais tellement rien qu'en l'écoutant. En étant là quand il se sent capable de parler. Il n'est pas brisé; ses failles ne sont pas assez profondes pour menacer ses fondements. Ce sont des cicatrices superficielles.",shape=box,color=blue];
		j2923521658 -> j1625366408;
	j2531154956 [label="+5 Chemistry",color=orange];
		j2531154956 -> j3775218675;
	j3649520946 [label="Oui, tu comprends. Il n'est pas brisé, ni vide. Ses fissures ne menacent pas ses fondements. Ce sont des cicatrices superficielles.",shape=box,color=blue];
		j3649520946 -> j1625366408;
	j1625366408 [label="Sais-tu qu'hier, je l'ai trouvé assis en train de lire un livre de philosophie antique à Monsieur Fibonacci?",shape=box,color=blue];
		j1625366408 -> j2343008948;
	j3775218675 [label="Oui. Tu en fais tellement rien qu'en l'écoutant. Il n'est pas un être brisé et vide. Ses failles ne menacent pas ses fondements. Ce ne sont que des cicatrices superficielles.",shape=box,color=blue];
		j3775218675 -> j1625366408;
	j2343008948 [label="Monsieur Fibonacci suppliait depuis longtemps qu'on lui lise le livre, mais tout le monde refusait! Ils ne voulaient pas lui donner des munitions, hein!",shape=box,color=blue];
		j2343008948 -> j2486207884;
	j2486207884 [label="Evaluate expressions",color=orange];
		j2486207884 -> j2250216020 [label="LyonDating",color=purple];
