		j3706025446 -> j2429168889;
	j1918909769 [label="Il dit qu'il t'en a déjà confié une partie, oui? Je suis contente qu'il commence à s'ouvrir à toi...",shape=box,color=blue];
		j1918909769 -> j34470858;
		j1918909769 -> j378778240;
		j1918909769 -> j2429168889;
	j378778240 [label="Je pense qu'il va bien, vraiment. C'est juste que... ce qu'il a vécu, c'est énorme.",shape=box,color=red];
		j378778240 -> j4238459910;
	j34470858 [label="Ça m'a brisé le cœur... J'aimerais tellement pouvoir en faire plus pour l'aider...",shape=box,color=red];
		j34470858 -> j2923521658;
	j3045818405 [label="C'est bien qu'il... m'ait enfin fait suffisamment confiance pour me raconter toute son histoire...",shape=box,color=red];
