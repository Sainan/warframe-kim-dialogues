		j1984084937 -> j539114982;
	j3668484888 [label="Je dois y aller. Beaucoup à penser, beaucoup à faire. À la revoyure.",shape=box,color=blue];
		j3668484888 -> j3419468122;
	j2221343727 [label="Je dois y aller. Beaucoup à penser, beaucoup à faire. À la revoyure.",shape=box,color=blue];
