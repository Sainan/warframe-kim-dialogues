		j2952898253 -> j2760998092 [label="false",color=purple];
	j2515192195 [label="Evaluate expressions",color=orange];
		j2515192195 -> j3171673949 [label="MarieEntrati3a",color=purple];
		j2515192195 -> j3171673949 [label="MarieEntrati3b",color=purple];
		j2515192195 -> j482145889 [label="MarieEntrati3",color=purple];
		j2515192195 -> j842274586 [label="MarieEntratiFamily",color=purple];
		j2515192195 -> j3865283355 [label="MarieEntratiMonster1",color=purple];
		j2515192195 -> j3865283355 [label="MarieEntratiMonster2",color=purple];
		j2515192195 -> j3764390873 [label="MarieEntratiFan1",color=purple];
		j2515192195 -> j3764390873 [label="MarieEntratiFan2",color=purple];
		j2515192195 -> j2270907247 [label="MarieEntratiNeutral",color=purple];
		j2515192195 -> j3819137588 [label="false",color=purple];
	j2313419129 [label="Honnêtement? J'avais la tête ailleurs.",shape=box,color=red];
		j2313419129 -> j1770211940;
	j4103252861 [label="Ça pourrait aller mieux.",shape=box,color=red];
		j4103252861 -> j1759822512;
	j298470752 [label="Je fais des progrès.",shape=box,color=red];
		j298470752 -> j2030192805;
	j452786427 [label="Sa fille, Euleria - connue sous le nom de Mère et sa famille ont pris soin de Deimos pendant tout ce temps.",shape=box,color=red];
		j452786427 -> j301563955;
	j610183959 [label="Qu'est-ce qui nous empêche de simplement déplacer tous les meubles, de les laisser tout remettre en place et puis... de recommencer? On pourrait tout vendre et faire du profit avec ces meubles étranges!",shape=box,color=blue];
		j610183959 -> j3450600042;
		j610183959 -> j2333453694;
		j610183959 -> j1471135968;
	j322525846 [label="Je suis bien consciente de nos désaccords non résolus concernant le Cardinal. Je m'efforce de maintenir un climat de courtoisie dans cette conversation.",shape=box,color=blue];
		j322525846 -> j2463095893;
	j3279741621 [label="Je comprends que tu ne souhaites pas discuter de la résolution des conflits sans profiter de l’occasion pour pointer du doigt ceux que tu considères responsables.",shape=box,color=blue];
		j3279741621 -> j2463095893;
	j1400653222 [label="Oui! Comme tu me le rappelles si souvent, tu le prends pour un monstre! Avec rien d'autre que du dépit et du vide dans son cœur!",shape=box,color=blue];
		j1400653222 -> j2463095893;
	j1692013897 [label="Je pensais que tu étais de mon côté dans cette guerre pour l'âme du Cardinal?",shape=box,color=blue];
		j1692013897 -> j598358086;
	j2612111550 [label="Je croyais que tu n'avais pas encore pris de décision concernant le Cardinal? Ou est-ce que ça a changé?",shape=box,color=blue];
		j2612111550 -> j2931647984;
		j2612111550 -> j3468902506;
	j393409465 [label="Oui. Ça, je l'apprends avec Monsieur Tagfer...",shape=box,color=blue];
		j393409465 -> j107316307;
	j482574993 [label="Ne me parle pas de plaies cicatrisées, loup. Je lèche encore les miennes depuis notre dernière discussion sur le Cardinal.",shape=box,color=blue];
		j482574993 -> j2463095893;
	j899072601 [label="Oui, mais tu l'as bien dit: nous devons tous arrêter de nous blâmer les uns les autres pour les blessures que nous subissons.",shape=box,color=blue];
		j899072601 -> j1357857079;
	j3089595645 [label="Je sais que tu crois que le Cardinal est une sorte de monstre horrible pour avoir causé de telles blessures.",shape=box,color=blue];
		j3089595645 -> j2463095893;
	j3764390873 [label="Je sais que tu es de mon côté dans cette guerre pour l'âme du Cardinal et je t'en serai éternellement reconnaissante.",shape=box,color=blue];
		j3764390873 -> j2760998092;
	j2270907247 [label="Je sais que tu te retiens de le juger, ce dont je te suis extrêmement reconnaissante.",shape=box,color=blue];
		j2270907247 -> j2760998092;
	j2760998092 [label="Et même si je sais que les autres sont prompts à le blâmer, je ne souhaite pas nous voir divisés et saigner alors que nous pouvons avancer ensemble.",shape=box,color=blue];
		j2760998092 -> j2861674213;
	j3171673949 [label="Oui, même si j'apprends - comme avec Monsieur Tagfer, que ce n'est peut-être pas tous au même degré.",shape=box,color=blue];
		j3171673949 -> j107316307;
	j482145889 [label="Et pas tous au même degré, comme tu as eu la gentillesse de me le faire remarquer, non?",shape=box,color=blue];
		j482145889 -> j2463095893;
	j842274586 [label="Oui! Même si je ne reproche pas son départ au Cardinal, car son œuvre est sacrée...",shape=box,color=blue];
		j842274586 -> j2760998092;
	j3865283355 [label="Et je sais que tu crois que le Cardinal est une sorte de monstre horrible pour avoir causé de telles blessures.",shape=box,color=blue];
		j3865283355 -> j2463095893;
	j3819137588 [label="Et tandis que les autres sont prompts à le blâmer pour leur souffrance, je ne souhaite tout simplement pas nous voir divisés et souffrir.",shape=box,color=blue];
		j3819137588 -> j2861674213;
	j1770211940 [label="Mais comment est-ce possible? Quoi de plus important que de s'asseoir et d'écouter les plaintes des mécontents?",shape=box,color=blue];
		j1770211940 -> j792530508;
	j1759822512 [label="Qu’y a-t-il de difficile à s’asseoir et à écouter les plaintes des mécontents?",shape=box,color=blue];
		j1759822512 -> j2987722481;
	j2030192805 [label="Oh, magnifique!",shape=box,color=blue];
		j2030192805 -> j2013296819;
	j301563955 [label="Ils veillent sur cet endroit et sur le cœur qui pompe l'énergie du Néant dans le Système Origine, nous gardant tous... utilisables, vraiment, depuis qu'Entrati est parti.",shape=box,color=red];
		j301563955 -> j3916832970;
	j3450600042 [label="Je ne sais pas, il n'y a pas vraiment de marché pour les chaises d'Entrati...",shape=box,color=red];
		j3450600042 -> j685605197;
	j2333453694 [label="Ne finirions-nous pas par saturer le marché? Nous serions obligés de les vendre à des prix dérisoires...",shape=box,color=red];
		j2333453694 -> j685605197;
	j1471135968 [label="Brillant. Aucun problème en vue.",shape=box,color=red];
		j1471135968 -> j3120083998;
	j2463095893 [label="Et même si je comprends que les deux sujets sont inexorablement liés, essayons de rester productifs aujourd'hui, d'accord?",shape=box,color=blue];
		j2463095893 -> j3793431589;
	j598358086 [label="Quelle est cette tromperie, loup? Ou bien la petite Marie n'est-elle qu'un jouet pour toi?",shape=box,color=blue];
		j598358086 -> j2146333710;
		j598358086 -> j3468902506;
	j2931647984 [label="Je n'ai pas encore décidé de la nécessité de ses actes. Mais son insensibilité est indéniable.",shape=box,color=red];
		j2931647984 -> j2463095893;
	j3468902506 [label="J'en ai marre de faire semblant, je m'excuse.",shape=box,color=red];
		j3468902506 -> j2914586970;
	j107316307 [label="Nous devons tous arrêter de nous blâmer les uns les autres pour les blessures que nous subissons.",shape=box,color=blue];
		j107316307 -> j1357857079;
	j1357857079 [label="Je ne suis pas non plus d’accord avec le fait de blâmer le Cardinal, mais je ne souhaite pas nous voir divisés et saigner alors que nous pouvons être ensemble.",shape=box,color=blue];
		j1357857079 -> j1924617332;
		j1357857079 -> j1794920812;
	j2861674213 [label="Nous devons tous cesser de nous blâmer les uns les autres pour les blessures que nous subissons, peu importe qui en est responsable, en fin de compte.",shape=box,color=blue];
		j2861674213 -> j1924617332;
		j2861674213 -> j1794920812;
	j792530508 [label="Je te taquine, je te taquine! Je n'arrive pas à imaginer à quel point tu as du travail, ni tous les endroits – et les moments – où l'on a besoin de toi.",shape=box,color=blue];
		j792530508 -> j2013296819;
	j2987722481 [label="Je te taquine, je te taquine! Je n'arrive pas à imaginer ce qu'ils ont enduré. Et comme il est difficile pour toi de démêler tout ça.",shape=box,color=blue];
		j2987722481 -> j2013296819;
	j2013296819 [label="Je crains simplement que, sans solution à leurs problèmes, nous ne puissions jamais espérer être accueillis à leur table. Le problème le plus grave reste entier:",shape=box,color=blue];
		j2013296819 -> j3298037765;
	j3916832970 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3916832970 -> j3732866888 [label=true,color=green];
		j3916832970 -> j3337182392 [label=false,color=brown];
	j685605197 [label="Pff! Je pense toujours que c'est une expérience intéressante. Peut-être pourrons-nous enfermer le diable dans un océan de bibliothèques!",shape=box,color=blue];
		j685605197 -> j3774077709;
	j3120083998 [label="Je vais ignorer ton sarcasme, car je pense que c'est une expérience intéressante. Peut-être pourrons-nous enfermer le diable dans un océan de bibliothèques!",shape=box,color=blue];
		j3120083998 -> j3774077709;
	j3793431589 [label="Je cherche à tous nous aider dans cette... étrange coexistence dans laquelle nous nous trouvons et non à me disputer.",shape=box,color=blue];
		j3793431589 -> j107316307;
	j2146333710 [label="Non, je ne joue pas. Mais Entrati n'est pas digne de confiance et je ne sais pas comment te convaincre autrement qu'en faisant semblant d'être de ton côté.",shape=box,color=red];
		j2146333710 -> j697971816;
	j2914586970 [label="Oui? Eh bien, je suis heureuse de te dire que ce n'est plus nécessaire.",shape=box,color=blue];
		j2914586970 -> j1509439757;
	j1924617332 [label="Ensemble, tous ensemble, nous formons... une étrange famille. Mais une famille, quand même.",shape=box,color=red];
		j1924617332 -> j1625808289;
	j1794920812 [label="Nous serions plus forts ensemble que divisés.",shape=box,color=red];
		j1794920812 -> j494560124;
		j1794920812 -> j1617439879;
	j3732866888 [label="Elle a accepté son absence et ils ont fait la paix l'un avec l'autre, mais cela n'a pas été tout seul.",shape=box,color=red];
		j3732866888 -> j90486364;
	j3337182392 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j3337182392 -> j3732866888 [label=true,color=green];
		j3337182392 -> j2467471753 [label=false,color=brown];
	j3774077709 [label="+20 Chemistry",color=orange];
		j3774077709 -> j1316470790;
	j697971816 [label="Oui? Eh bien, je suis heureuse de te dire que tu as échoué.",shape=box,color=blue];
		j697971816 -> j1509439757;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j1625808289 [label="Add +1 to Family counter",color=orange];
		j1625808289 -> j494560124;
		j1625808289 -> j1617439879;
	j494560124 [label="Et dans les moments difficiles, parfois, tout ce que nous avons vraiment, c'est de pouvoir compter les uns sur les autres. Soit ceux qu'on nous a donnés, soit ceux qu'on a trouvés.",shape=box,color=red];
		j494560124 -> j2806997210;
	j1617439879 [label="Je ne sais pas si cela va aider ou nuire à long terme. Mais ce... purgatoire, ce n'est pas une solution non plus.",shape=box,color=red];
		j1617439879 -> j955219298;
	j90486364 [label="Sachant qu'il est toujours là, quelque part, qu'il ne lui a pas dit un mot ni même envoyé une lettre... ?",shape=box,color=red];
		j90486364 -> j372397470;
	j2467471753 [label="Elle n'a pas accepté son absence et ils se font la tête.",shape=box,color=red];
		j2467471753 -> j3490076143;
	j1316470790 [label="J'ai beaucoup de choses à faire! À la revoyure!",shape=box,color=blue];
		j1316470790 -> "Chat ends.";
	j2631316640 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j2631316640 -> j1508231473;
	j2806997210 [label="Add +1 to Family counter",color=orange];
		j2806997210 -> j955219298;
	j955219298 [label="Oui, je suis d'accord. Mais je ne peux pas être celle qui nous réunit. Je ne sais pas comment faire! Je suis une inconnue pour eux, là-haut...",shape=box,color=blue];
		j955219298 -> j1040874402;
		j955219298 -> j2477102409;
	j372397470 [label="Je n'ose imaginer à quel point cela a dû être douloureux pour elle. Pour eux.",shape=box,color=red];
		j372397470 -> j687160208;
	j3490076143 [label="Sachant qu'il est toujours là, quelque part, qu'il ne lui a pas dit un mot ni même envoyé une lettre... ?",shape=box,color=red];
		j3490076143 -> j1058908422;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j1040874402 [label="Loid connaissait la famille Entrati. Ça devrait être lui. Le convaincre, cependant... c'est une autre histoire.",shape=box,color=red];
		j1040874402 -> j3990714484;
	j2477102409 [label="Roathe, peut-être? C'est un Orokin, il les connaissait tous.",shape=box,color=red];
		j2477102409 -> j1064630541;
	j687160208 [label="Bien que je puisse comprendre la logique derrière la décision de les protéger de la douleur que le Cardinal a causée par son départ nécessaire...",shape=box,color=blue];
		j687160208 -> j4175579430;
	j1058908422 [label="Cela a dû détruire la petite chance de réconciliation qu’ils pouvaient avoir.",shape=box,color=red];
		j1058908422 -> j1000657445;
	j3990714484 [label="+5 Chemistry",color=orange];
		j3990714484 -> j1087283410;
	j1064630541 [label="Non, pas le diable – n'importe qui, sauf le diable. Mais tu tiens quelque chose. Le choix évident est Monsieur Loid, non?",shape=box,color=blue];
		j1064630541 -> j1944348272;
	j4175579430 [label="Je trouve ça inutilement cruel, pas toi? Ils pourraient le croire mort. Ou pire! Et nous, ici, comme des rats d'égout?",shape=box,color=blue];
		j4175579430 -> j3141951699;
		j4175579430 -> j901175174;
		j4175579430 -> j155490605;
	j1000657445 [label="Oui... Je comprends la logique. Je travaillerais à réparer leur famille, si on peut, non? On dirait que c'est notre seul espoir de sortir d'ici. ",shape=box,color=blue];
		j1000657445 -> j1093261367;
	j1087283410 [label="Oui, oui! C'est ça! Mais comment le convaincre? Il est loyal, non?",shape=box,color=blue];
		j1087283410 -> j3469515979;
		j1087283410 -> j2978938615;
	j1944348272 [label="Mais comment le convaincre? Il est loyal, non?",shape=box,color=blue];
		j1944348272 -> j2978938615;
		j1944348272 -> j3469515979;
	j3141951699 [label="J'ai une amie qui adore les rats. Je les trouve adorables.",shape=box,color=red];
		j3141951699 -> j4081350809;
	j901175174 [label="Ce n’est pas vraiment à moi de prendre cette décision.",shape=box,color=red];
		j901175174 -> j2973967123;
	j155490605 [label="Qu'est-ce que tu suggères?",shape=box,color=red];
		j155490605 -> j2866255265;
	j1093261367 [label="J'ai peur que nous ne passions le reste de nos vies piégés ici, comme des rats d'égout. ",shape=box,color=blue];
		j1093261367 -> j3782485271;
		j1093261367 -> j1760589004;
	j3469515979 [label="Penses-tu que toi ou Lyon pourriez le convaincre?",shape=box,color=red];
		j3469515979 -> j3324472627;
	j2978938615 [label="Tu ne vas pas aimer ma réponse, Marie...",shape=box,color=red];
		j2978938615 -> j1949823164;
	j4081350809 [label="Et j'aimerais beaucoup la rencontrer un jour, mais ce n'est pas vraiment le sujet.",shape=box,color=blue];
		j4081350809 -> j2866255265;
	j2973967123 [label="Je sais. C'est à Monsieur Loid, et à tous les autres, de décider de se faire connaître.",shape=box,color=blue];
		j2973967123 -> j2866255265;
	j2866255265 [label="Je dirais que c’est un sentiment de culpabilité et non de noblesse qui nous maintient ici-bas.",shape=box,color=blue];
		j2866255265 -> j1628294870;
	j3782485271 [label="J'ai une amie qui adore les rats. Je les trouve adorables. ",shape=box,color=red];
		j3782485271 -> j4081350809;
	j1760589004 [label="Négligence de ma part. Tu as raison. Je vais me mettre au travail.",shape=box,color=red];
		j1760589004 -> j3383546346;
	j3324472627 [label="Il nous apprécie, il est gentil et doux. Mais nous sommes des étrangers pour lui, des nouveaux venus.",shape=box,color=blue];
		j3324472627 -> j1942183785;
	j1949823164 [label="Ah bon?",shape=box,color=blue];
		j1949823164 -> j3569080231;
	j1628294870 [label="Que nous cachons un grand et terrible péché.",shape=box,color=blue];
		j1628294870 -> j4291418945;
	j3383546346 [label="Merci. Je ne sais pas si tu réussiras, mais parfois, on ne peut qu'essayer.",shape=box,color=blue];
		j3383546346 -> j2866255265;
	j1942183785 [label="J'y réfléchirai. Fais pareil! Une solution sera trouvée, Sol nous a guidés jusqu'ici!",shape=box,color=blue];
		j1942183785 -> j1484519055;
	j3569080231 [label="Loid pourrait écouter Roathe. Comme il est Orokin, leur histoire commune pourrait s'avérer utile, ici.",shape=box,color=red];
		j3569080231 -> j889331940;
	j4291418945 [label="Et c’est ce péché qui doit être pardonné, ou infirmé, peut-être?",shape=box,color=blue];
		j4291418945 -> j640895046;
		j4291418945 -> j579971743;
	j1484519055 [label="+15 Chemistry",color=orange];
		j1484519055 -> j1907864101;
	j889331940 [label="Non! C'est un menteur, un manipulateur, il ne ferait ça qu'en échange de quelque chose!",shape=box,color=blue];
		j889331940 -> j477977084;
	j640895046 [label="La situation à l'étage est... fragile, même dans les meilleurs jours. Je ne veux pas les contrarier.",shape=box,color=red];
		j640895046 -> j70309333;
	j579971743 [label="Il faut juste faire attention. J’ai peur qu’une moitié considère l’autre moitié comme \"l’autre famille\".",shape=box,color=red];
		j579971743 -> j1984084937;
	j1907864101 [label="Nous trouverons un moyen de convaincre Monsieur Loid de monter ces escaliers... Je le sais.",shape=box,color=blue];
		j1907864101 -> j3668484888;
	j477977084 [label="Nous trouverons un autre moyen de convaincre Monsieur Loid de monter ces escaliers... Je le sais.",shape=box,color=blue];
		j477977084 -> j2221343727;
	j70309333 [label="La résilience de l'âme pourrait te surprendre. Et celles qui m'entourent aujourd'hui sont si vieilles, si profondément marquées par le temps.",shape=box,color=blue];
		j70309333 -> j3490711249;
