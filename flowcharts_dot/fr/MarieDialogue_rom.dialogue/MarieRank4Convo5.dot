		j1316635360 -> j515048465 [label="false",color=purple];
	j4003923442 [label="Voyageur! J'ai réfléchi.",shape=box,color=blue];
		j4003923442 -> j3789146303;
		j4003923442 -> j2429168889;
	j1654224993 [label="Voyageur! J'ai repensé à ce que tu as dit de la famille au-dessus de nous. Et à la façon dont ils pourraient nous considérer comme des intrus.",shape=box,color=blue];
		j1654224993 -> j2863423827;
	j3323404462 [label="Voyageur! J'ai repensé à ce que tu as dit de la famille au-dessus de nous. J'en ai le cœur brisé...",shape=box,color=blue];
		j3323404462 -> j1000557311;
	j515048465 [label="Pourquoi ne pouvons-nous pas monter? Pourquoi ne pouvons-nous pas parler à la famille du Cardinal?",shape=box,color=blue];
		j515048465 -> j2230410948;
		j515048465 -> j2429168889;
	j3789146303 [label="Dois-je m’inquiéter?",shape=box,color=red];
		j3789146303 -> j251630565;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j2863423827 [label="Comme une \"autre famille\" en compétition, pas vrai? Cela me trouble beaucoup.",shape=box,color=blue];
		j2863423827 -> j1000557311;
	j1000557311 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j1000557311 -> j3298037765 [label=true,color=green];
		j1000557311 -> j3642914 [label=false,color=brown];
	j2230410948 [label="Eh bien... en bref, certains membres de la famille Entrati sont à l'étage et ils ne sont pas... exactement conscients que nous sommes ici en bas.",shape=box,color=red];
		j2230410948 -> j1196530348;
	j251630565 [label="Oui! Les petits robots volants. Les necra... necra... Comment les appelle-t-on?",shape=box,color=blue];
		j251630565 -> j3032122760;
	"Chat ends." [color=orange];
	j3298037765 [label="Nous ne leur disputons pas l’amour du Cardinal, comment pouvons-nous les aider à voir cela?",shape=box,color=blue];
		j3298037765 -> j309736486;
		j3298037765 -> j2325709812;
		j3298037765 -> j1032656297;
	j3642914 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j3642914 -> j3298037765 [label=true,color=green];
		j3642914 -> j2155313399 [label=false,color=brown];
	j1196530348 [label="Boolean MarieFamily1 is now true.",color=orange];
		j1196530348 -> j2078273640;
	j3032122760 [label="Necramites?",shape=box,color=red];
		j3032122760 -> j1194865750;
	j309736486 [label="Tu as raison. On ne peut pas convoiter ce qu'une personne n'a pas à donner.",shape=box,color=red];
		j309736486 -> j380005824;
	j2325709812 [label="Ouvrir des plaies cicatrisées est dangereux. Tu pourrais guérir une infection... ou les faire saigner.",shape=box,color=red];
		j2325709812 -> j2952898253;
	j1032656297 [label="Tu – nous – avons tous un point commun: à un moment donné, Entrati nous a abandonnés.",shape=box,color=red];
		j1032656297 -> j2515192195;
	j2155313399 [label="Comment se déroule ton travail pour rétablir leurs liens familiaux?",shape=box,color=blue];
		j2155313399 -> j2313419129;
		j2155313399 -> j4103252861;
		j2155313399 -> j298470752;
		j2155313399 -> j2429168889;
	j2078273640 [label="Par les Luminaires... Tu veux dire que nous sommes tous ici en secret?! C'est pour ça qu'on n'a pas le droit de quitter cet endroit?! Mais pourquoi?!",shape=box,color=blue];
		j2078273640 -> j452786427;
	j1194865750 [label="Oui! Ha! Ils sont tellement tenaces pour changer les meubles, n'est-ce pas? Mais je remarque que si on déplace des objets... ils font la même chose.",shape=box,color=blue];
		j1194865750 -> j610183959;
	j380005824 [label="Evaluate expressions",color=orange];
		j380005824 -> j322525846 [label="MarieEntrati3a",color=purple];
