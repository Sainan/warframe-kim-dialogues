digraph {
	735 [label="MarieRank2Convo5 begins.",color=orange];
		735 -> 736;
	736 [label="Evaluate expressions",color=orange];
		736 -> 739 [label="MarieOtak1",color=purple];
		736 -> 738 [label="MarieFamily1",color=purple];
		736 -> 737 [label="false",color=purple];
	739 [label="J'ai réfléchi à ce que tu m'as dit à propos de Monsieur Otak.",shape=box,color=blue];
		739 -> 743;
	738 [label="J'ai réfléchi à ce que tu m'as dit au sujet de la famille du Cardinal.",shape=box,color=blue];
		738 -> 742;
	737 [label="J'ai encore une question concernant Monsieur \"Necraloid\", si tu me le permets?",shape=box,color=blue];
		737 -> 741;
		737 -> 740;
	743 [label="Je me demandais si cela ressemblait à une de mes histoires. Puis-je te la raconter, si tu as le temps?",shape=box,color=blue];
		743 -> 749;
		743 -> 748;
	742 [label="Je me demandais, pourrais-tu me raconter l'histoire d'Otak, le visage enfantin à l'arrière du crâne de Necraloid?",shape=box,color=blue];
		742 -> 747;
		742 -> 746;
	741 [label="Oui, bien sûr, dis-moi?",shape=box,color=red];
		741 -> 745;
	740 [label="[Fin.]",shape=box,color=red];
		740 -> 744;
	749 [label="Vas-y.",shape=box,color=red];
		749 -> 754;
	748 [label="[Fin.]",shape=box,color=red];
		748 -> 753;
	747 [label="Bien sûr.",shape=box,color=red];
		747 -> 752;
	746 [label="Peut-être plus tard. [Fin.]",shape=box,color=red];
		746 -> 751;
	745 [label="Je suis curieuse de savoir pourquoi il y a un autre visage sur son dos qui ressemble au gribouillage d'un enfant.",shape=box,color=blue];
		745 -> 750;
	744 [label="Chat ends.",color=orange];
	754 [label="Il y avait une Sœur à la Cathédrale, qui s'était un jour perdue dans les couloirs de son passé. Sœur Cécilia.",shape=box,color=blue];
		754 -> 757;
	753 [label="Chat ends.",color=orange];
	752 [label="De l’avis général, il était un génie et l’esprit derrière l’exploitation des cristaux d’argon.",shape=box,color=red];
		752 -> 756;
	751 [label="Chat ends.",color=orange];
	750 [label="J'ai interrogé Monsieur Necraloid et Monsieur Loid, mais aucun des deux n'a souhaité en parler. Ils m'ont seulement donné un nom: Otak. Et c'est avec une grande tristesse qu'ils l'ont prononcé.",shape=box,color=blue];
		750 -> 755;
	757 [label="Elle avait l'habitude de se tenir devant la grande horloge du hall et de proclamer qu'il était deux heures de l'après-midi, mais elle ne savait pas quelle heure il était.",shape=box,color=blue];
		757 -> 761;
	756 [label="Qui sont exploités à partir du Néant - ils sont la raison pour laquelle nous pouvons créer un grand nombre de puissantes warframes et d'armes.",shape=box,color=red];
		756 -> 760;
	755 [label="Alors me voici, en train de te parler, dans l’espoir que tu puisses m’aider.",shape=box,color=blue];
		755 -> 758;
		755 -> 759;
	761 [label="Nous trouvions tous les tableaux dans les couloirs tournés à l'envers et elle disait qu'ils lui murmuraient des complots terribles.",shape=box,color=blue];
		761 -> 766;
	760 [label="Il s'est spécialisé en cristallographie. Ses travaux étaient archivés ici, dans les laboratoires.",shape=box,color=red];
		760 -> 765;
	758 [label="Tu veux en savoir plus sur Otak? Ou pourquoi tu ne peux pas lui parler?",shape=box,color=red];
		758 -> 762;
	759 [label="Otak, c'est difficile à expliquer...",shape=box,color=red];
		759 -> 2919;
	766 [label="Nous avons appris qu'elle entendait simplement des conversations dans d'autres pièces et pensait que c'étaient les tableaux qui parlaient...",shape=box,color=blue];
		766 -> 770;
	765 [label="Pour une raison que j'ignore, il a été transformé en Céphalon et a reçu sa propre carapace de Necraloid.",shape=box,color=red];
		765 -> 769;
	762 [label="Les deux, je crois. En temps voulu. Mais je te laisse décider par où commencer. Après tout, je ne sais pas ce qui est le plus important.",shape=box,color=blue];
		762 -> 2919;
	2919 [label="Check boolean LoidFamilyComplete",color=orange];
		2919 -> 764 [label=true,color=green];
		2919 -> 764 [label=false,color=brown];
		2919 -> 763 [label=false,color=brown];
	770 [label="Un jour, elle a pris tous les coussins d'un salon pour des enfants et les a tous invités à prendre le thé...",shape=box,color=blue];
		770 -> 774;
	769 [label="Tous les Céphalons n'ont pas été créés en guise de châtiment. Mais les choses ont... mal tourné sur Deimos et il a été gravement endommagé.",shape=box,color=red];
		769 -> 773;
	764 [label="Otak était un Archimédien, un scientifique et savant Orokin. Ce qui lui est arrivé n'est pas vraiment une histoire heureuse.",shape=box,color=red];
		764 -> 768;
	763 [label="Eh bien... en bref, certains membres de la famille Entrati sont à l'étage et ils ne sont pas... exactement conscients que nous sommes ici en bas.",shape=box,color=red];
		763 -> 767;
	774 [label="Quand je suis entrée dans la pièce, elle a levé les yeux vers moi et m'a dit: \"Oh, Sœur Odette, vous voilà! Les enfants de l'orphelinat sont là, voulez-vous vous joindre à moi?\"",shape=box,color=blue];
		774 -> 777;
		774 -> 778;
	773 [label="+5 Chemistry",color=orange];
		773 -> 776;
	768 [label="Update boolean MarieOtak1",color=orange];
		768 -> 772;
	767 [label="Update boolean MarieFamily1",color=orange];
		767 -> 771;
	777 [label="Qu'est-ce que tu as fait?",shape=box,color=red];
		777 -> 781;
	778 [label="Qui était Sœur Odette?",shape=box,color=red];
		778 -> 782;
	776 [label="Pauvre petit...",shape=box,color=blue];
		776 -> 780;
	772 [label="Par les Luminaires... s'il te plaît, continue.",shape=box,color=blue];
		772 -> 752;
	771 [label="Par les Luminaires... Tu veux dire que nous sommes tous ici en secret?! C'est pour ça qu'on n'a pas le droit de quitter cet endroit?! Mais pourquoi?!",shape=box,color=blue];
		771 -> 775;
	781 [label="J'ai roulé avec ma chaise jusqu'à la table et j'ai pris le thé avec elle et les coussins, que pouvais-je faire d'autre?",shape=box,color=blue];
		781 -> 787;
	782 [label="Sœur Odette était morte depuis trente ans, je le crains.",shape=box,color=blue];
		782 -> 788;
	780 [label="Il a donc été transféré au necraloid principal – le seul necraloid restant – et... eh bien? C’est difficile à expliquer.",shape=box,color=red];
		780 -> 784;
		780 -> 785;
		780 -> 786;
	775 [label="Sa fille, Euleria - connue sous le nom de Mère et sa famille ont pris soin de Deimos pendant tout ce temps.",shape=box,color=red];
		775 -> 779;
	787 [label="Comme nous avons ri ensemble, tandis qu'elle me racontait des histoires de son passé. Des histoires que Sœur Cécilia n'avait jamais racontées à personne auparavant, du moins à ma connaissance.",shape=box,color=blue];
		787 -> 791;
	788 [label="J'ai roulé avec ma chaise jusqu'à la table et j'ai pris le thé avec elle et les coussins.",shape=box,color=blue];
		788 -> 787;
	784 [label="J'aimerais juste qu'on puisse le réparer, honnêtement. Ramener le véritable Otak.",shape=box,color=red];
		784 -> 754;
	785 [label="Il me fait sourire. Il est drôle, mais il cache quelque chose de tragique et de brisé.",shape=box,color=red];
		785 -> 754;
	786 [label="Malheureusement, il est irréparable. Et je pense qu'il énerve beaucoup de gens. ",shape=box,color=red];
		786 -> 754;
	779 [label="Ils veillent sur cet endroit et sur le cœur qui pompe l'énergie du Néant dans le Système Origine, nous gardant tous... utilisables, vraiment, depuis qu'Entrati est parti.",shape=box,color=red];
		779 -> 783;
	791 [label="Ses yeux étaient brillants à certains moments mais ternes à d'autres, comme ceux d'une poupée d'enfant...",shape=box,color=blue];
		791 -> 794;
		791 -> 795;
		791 -> 796;
		791 -> 797;
	783 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		783 -> 789 [label=true,color=green];
		783 -> 790 [label=false,color=brown];
	794 [label="Pourquoi t'es-tu assise avec elle?",shape=box,color=red];
		794 -> 800;
	795 [label="Qu'est-il arrivé à Sœur Cécilia?",shape=box,color=red];
		795 -> 801;
	796 [label="J'espère qu'elle appréciait ta présence.",shape=box,color=red];
		796 -> 802;
	797 [label="C'était gentil de ta part, de t'asseoir avec elle.",shape=box,color=red];
		797 -> 803;
	789 [label="Elle a accepté son absence et ils ont fait la paix l'un avec l'autre, mais cela n'a pas été tout seul.",shape=box,color=red];
		789 -> 792;
	790 [label="Elle n'a pas accepté son absence et ils se font la tête.",shape=box,color=red];
		790 -> 793;
	800 [label="+15 Chemistry",color=orange];
		800 -> 806;
	801 [label="Ce qui arrive a tous ceux qui sont dans cette situation. Elle a continué à s'estomper, tel un tableau au soleil, jusqu'à ce qu'il ne reste plus rien. ",shape=box,color=blue];
		801 -> 807;
	802 [label="+10 Chemistry",color=orange];
		802 -> 808;
	803 [label="+5 Chemistry",color=orange];
		803 -> 809;
	792 [label="Sachant qu'il est toujours là, quelque part, qu'il ne lui a pas dit un mot ni même envoyé une lettre... ?",shape=box,color=red];
		792 -> 798;
	793 [label="Sachant qu'il est toujours là, quelque part, qu'il ne lui a pas dit un mot ni même envoyé une lettre... ?",shape=box,color=red];
		793 -> 799;
	806 [label="Une question judicieuse. Une question très judicieuse. Je pense que de nombreuses raisons m'ont inspirée. J'aimerais croire que c'est la gentillesse qui m'a conduite à sa table.",shape=box,color=blue];
		806 -> 812;
	807 [label="Puis, elle nous a quittés et nous avons organisé une veillée funèbre en son honneur. J'espère qu'elle s'est souvenue, à la fin, de ceux qui ont été vraiment gentils avec elle. ",shape=box,color=blue];
		807 -> 813;
	808 [label="J'aime à croire qu'elle avait compris, quelque part au fond d'elle.",shape=box,color=blue];
		808 -> 813;
	809 [label="Était-ce de la gentillesse? Ou est-ce la culpabilité qui m'a poussée à le faire? Ah, mais au fait, tu fais simplement faire preuve de gentillesse en disant ça. ",shape=box,color=blue];
		809 -> 813;
	798 [label="Je n'ose imaginer à quel point cela a dû être douloureux pour elle. Pour eux.",shape=box,color=red];
		798 -> 804;
	799 [label="Cela a dû détruire la petite chance de réconciliation qu’ils pouvaient avoir.",shape=box,color=red];
		799 -> 805;
	812 [label="Mais je pense que c'était peut-être de la culpabilité, au fond. Si je ne le faisais pas, je la négligeais. Comme on néglige un enfant.",shape=box,color=blue];
		812 -> 813;
	813 [label="J'aimerais croire que ton Otak connaît des personnes bienveillantes et patientes avec lui. Mais bon, il n'est pas vraiment là, n'est-ce pas?",shape=box,color=blue];
		813 -> 817;
	804 [label="Bien que je puisse comprendre la logique derrière la décision de les protéger de la douleur que le Cardinal a causée par son départ nécessaire...",shape=box,color=blue];
		804 -> 810;
	805 [label="+10 Chemistry",color=orange];
		805 -> 811;
	817 [label="Je parle d'une technologie très élaborée, conçue pour ressembler à un homme, n'est-ce pas? Un phonographe, mais en bien plus complexe. Comme Necraloid, il n'a pas d'âme.",shape=box,color=blue];
		817 -> 822;
		817 -> 823;
		817 -> 824;
		817 -> 825;
		817 -> 826;
	810 [label="Je trouve ça inutilement cruel, pas toi? Ils pourraient le croire mort. Ou pire! Et nous, ici, comme des rats d'égout?",shape=box,color=blue];
		810 -> 814;
		810 -> 815;
	811 [label="Oui... Je comprends la logique. Je travaillerais à réparer leur famille, si on peut, non? On dirait que c'est notre seul espoir de sortir d'ici. ",shape=box,color=blue];
		811 -> 816;
	822 [label="Necraloid n'a peut-être pas d'âme, mais il est unique. D'autres Céphalons, comme Otak, en ont une. Leur destruction réside dans leur création.",shape=box,color=red];
		822 -> 831;
	823 [label="Tu as raison. Et puis, que veux-tu que j'y fasse?",shape=box,color=red];
		823 -> 832;
	824 [label="Tu as raison. Ils n'en ont pas. Mais ça ne veut pas dire qu'on peut les maltraiter.",shape=box,color=red];
		824 -> 833;
	825 [label="Je ne sais pas si tu as raison ou tort. Mais ils peuvent encore penser et ressentir, et on ne peut pas les traiter comme des objets.",shape=box,color=red];
		825 -> 834;
	826 [label="Necraloid a une âme. Tous les Céphalons en ont une.",shape=box,color=red];
		826 -> 835;
	814 [label="Ce n’est pas vraiment à moi de prendre cette décision.",shape=box,color=red];
		814 -> 818;
	815 [label="J'ai une amie qui adore les rats. Je les trouve adorables.",shape=box,color=red];
		815 -> 819;
	816 [label="J'ai peur que nous ne passions le reste de nos vies piégés ici, comme des rats d'égout. ",shape=box,color=blue];
		816 -> 820;
		816 -> 821;
	831 [label="Update boolean MarieCephalonSoul",color=orange];
		831 -> 839;
	832 [label="Update boolean MarieCephalonNoSoul",color=orange];
		832 -> 840;
	833 [label="Update boolean MarieCephalonNoSoul",color=orange];
		833 -> 841;
	834 [label="Update boolean MarieCephalonUnsure",color=orange];
		834 -> 842;
	835 [label="Update boolean MarieCephalonSoul",color=orange];
		835 -> 843;
	818 [label="Je sais. C'est à Monsieur Loid, et à tous les autres, de décider de se faire connaître.",shape=box,color=blue];
		818 -> 827;
	819 [label="+15 Chemistry",color=orange];
		819 -> 828;
	820 [label="Négligence de ma part. Tu as raison. Je vais me mettre au travail.",shape=box,color=red];
		820 -> 829;
	821 [label="J'ai une amie qui adore les rats. Je les trouve adorables. ",shape=box,color=red];
		821 -> 830;
	839 [label="+5 Chemistry",color=orange];
		839 -> 845;
	840 [label="Oh, ne pense pas que je te demande de les maltraiter! Non! Chéris-les, car ils sont précieux et ce n'est pas de leur faute s'ils sont comme ils sont!",shape=box,color=blue];
		840 -> 846;
	841 [label="+5 Chemistry",color=orange];
		841 -> 840;
	842 [label="+5 Chemistry",color=orange];
		842 -> 847;
	843 [label="+5 Chemistry",color=orange];
		843 -> 848;
	827 [label="Je dirais que c’est un sentiment de culpabilité et non de noblesse qui nous maintient ici-bas.",shape=box,color=blue];
		827 -> 836;
	828 [label="Et j'aimerais beaucoup la rencontrer un jour, mais ce n'est pas vraiment le sujet.",shape=box,color=blue];
		828 -> 827;
	829 [label="+5 Chemistry",color=orange];
		829 -> 837;
	830 [label="+5 Chemistry",color=orange];
		830 -> 838;
	845 [label="Une preuve supplémentaire que le diable et ses semblables devaient être condamnés. Mais peut-être as-tu raison à propos d'Otak et de ses semblables, ou peut-être que le croire t'apporte du réconfort.",shape=box,color=blue];
		845 -> 850;
	846 [label="Mon cœur se brise uniquement pour les corps brisés que les démons Orokins ont laissés derrière eux. Ils n'étaient pas des dieux, mais dévoraient ceux qui se trouvaient sur leur passage. Il suffit de regarder celui qui nous accompagne.",shape=box,color=blue];
		846 -> 851;
	847 [label="Tu as peut-être raison, mais je ne pense pas que les diables Orokins en savaient plus que nous sur le fonctionnement de l'âme. Ce n'étaient pas de grands dieux.",shape=box,color=blue];
		847 -> 852;
	848 [label="Peut-être que tu as raison, ou peut-être cela t'apaise de le croire.",shape=box,color=blue];
		848 -> 851;
	836 [label="Que nous cachons un grand et terrible péché.",shape=box,color=blue];
		836 -> 844;
	837 [label="Merci. Je ne sais pas si tu réussiras, mais parfois, on ne peut qu'essayer.",shape=box,color=blue];
		837 -> 827;
	838 [label="Et j'aimerais beaucoup la rencontrer un jour, mais ce n'est pas vraiment le sujet.",shape=box,color=blue];
		838 -> 827;
	850 [label="Quoi qu'il en soit, je choisis de croire que l'Otak qui est mort il y a longtemps te sourirait maintenant, car tu es aimable avec ce qui vit en sa mémoire.",shape=box,color=blue];
		850 -> 2920;
	851 [label="C'est tout simplement difficile pour moi de dire que Necraloid a une âme quand Loid se tient juste à côté de lui, tu comprends?",shape=box,color=blue];
		851 -> 850;
	852 [label="La technologie, peut-être – la science, oui – mais l'âme? Ils pouvaient difficilement maîtriser leur propre cœur! Regarde le diable avec qui nous voyageons si tu as besoin d'une preuve supplémentaire.",shape=box,color=blue];
		852 -> 851;
	844 [label="Et c’est ce péché qui doit être pardonné.",shape=box,color=blue];
		844 -> 849;
	2920 [label="Check boolean LoidFamilyComplete",color=orange];
		2920 -> 2921 [label=true,color=green];
		2920 -> 854 [label=false,color=brown];
	849 [label="Merci, tu m'as donné matière à réflexion. À la revoyure.",shape=box,color=blue];
		849 -> 853;
	2921 [label="Je dois y aller. Merci. J'ai beaucoup à méditer.",shape=box,color=blue];
		2921 -> 2922;
	854 [label="J'espère simplement que je pourrai rencontrer l'étrange fac-similé de vie lorsque Monsieur Necraloid remontera à l'étage, un jour.",shape=box,color=blue];
		854 -> 855;
		854 -> 856;
	853 [label="Chat ends.",color=orange];
	2922 [label="Chat ends.",color=orange];
	855 [label="Ce n'est peut-être pas sage de se mêler des affaires des autres.",shape=box,color=red];
		855 -> 857;
	856 [label="J'espère qu'un jour, nous pourrons dire la vérité à la famille Entrati. Et le plus tôt sera le mieux. ",shape=box,color=red];
		856 -> 857;
	857 [label="Check boolean MarieFamily1",color=orange];
		857 -> 858 [label=true,color=green];
		857 -> 859 [label=false,color=brown];
	858 [label="Nous verrons, je veux en savoir plus sur les raisons pour lesquelles nous devons rester.",shape=box,color=blue];
		858 -> 860;
	859 [label="Il y a une histoire que tu ne me racontes pas, je crois. Mais je pense que c'est assez pour aujourd'hui, non?",shape=box,color=blue];
		859 -> 860;
	860 [label="Nous reparlerons très bientôt de la famille Entrati.",shape=box,color=blue];
		860 -> 147;
	147 [label="Chat ends.",color=orange];
