	j882444282 [label="J'essaie de convaincre Roathe de nous aider à réunir Loid et la famille Entrati. Mais il est intraitable à propos du sérum. J'ai besoin de ton aide pour le raisonner.",shape=box,color=red];
		j882444282 -> j2535320514;
	j2237125480 [label="J'essaie de faire comprendre à Roathe qu'il a le pouvoir de changer, qu'il peut se pardonner ses erreurs passées. Et j'ai besoin de ton aide pour y parvenir.",shape=box,color=red];
		j2237125480 -> j2443988293;
	j2560913761 [label="Roathe est rongé par les remords à cause de ses actes. Sans ton aide, je crains qu'il ne continue à s'autodétruire s'il ne parvient pas à accepter qui il est.",shape=box,color=red];
		j2560913761 -> j2679306226;
	j593945240 [label="Roathe a découvert la vérité sur le sérum. Il l'a pris de son plein gré. Et ça le détruit. J'ai besoin de ton aide pour le calmer.",shape=box,color=red];
		j593945240 -> j2535320514;
	j3508396627 [label="Roathe me rend dingue. Je ne sais pas comment lui parler. Aurais-tu un conseil?",shape=box,color=red];
		j3508396627 -> j2535320514;
