digraph {
	"MarieRank2Convo1 begins." [color=orange];
		"MarieRank2Convo1 begins." -> j3903697296;
	j3903697296 [label="J'espère que tu ne me trouveras pas impolie de te le demander, mais je suis terriblement curieuse. As-tu la foi? Dans les Luminaires ou autre chose?",shape=box,color=blue];
		j3903697296 -> j638865849;
		j3903697296 -> j2477776584;
		j3903697296 -> j2429168889;
	j638865849 [label="Et si je disais que je m'intéressais davantage à toi? Serait-ce un blasphème?",shape=box,color=red];
		j638865849 -> j1615227912;
	j2477776584 [label="Non, ce ne serait pas du tout impoli.",shape=box,color=red];
		j2477776584 -> j3841782404;
		j2477776584 -> j639366577;
		j2477776584 -> j1923987444;
		j2477776584 -> j3443452265;
		j2477776584 -> j2140369749;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j1615227912 [label="Boolean DrifterMarie is now true.",color=orange];
		j1615227912 -> j3659966351;
	j3841782404 [label="C'est... compliqué. Je crois qu'il y a quelque chose, mais je n'ai pas vraiment de foi précise.",shape=box,color=red];
		j3841782404 -> j798743586;
	j639366577 [label="Oui, j'ai foi en quelque chose, mais quelque chose que tu ne connais pas.",shape=box,color=red];
		j639366577 -> j4205036503;
	j1923987444 [label="Je crois aux Luminaires, comme toi.",shape=box,color=red];
		j1923987444 -> j3011678883;
	j3443452265 [label="Non, je ne crois pas aux dieux. Juste à une science que nous ne maîtrisons pas encore.",shape=box,color=red];
		j3443452265 -> j3748888464;
	j2140369749 [label="Honnêtement, je ne sais pas. Je pense que le monde est trop compliqué pour que j'aie la réponse.",shape=box,color=red];
		j2140369749 -> j1163868208;
	"Chat ends." [color=orange];
	j3659966351 [label="Ah, oui? Qu'est-ce que c'est que ça? Quelle audace, je dois dire que tu me surprends! Je ne m'y attendais pas...",shape=box,color=blue];
		j3659966351 -> j3120072236;
	j798743586 [label="Boolean DrifterFaithPersonal is now true.",color=orange];
		j798743586 -> j376021340;
	j4205036503 [label="+5 Chemistry",color=orange];
		j4205036503 -> j1770541030;
	j3011678883 [label="+5 Chemistry",color=orange];
		j3011678883 -> j1501004171;
	j3748888464 [label="+5 Chemistry",color=orange];
		j3748888464 -> j1255224180;
	j1163868208 [label="Boolean DrifterFaithAgnostic is now true.",color=orange];
		j1163868208 -> j3034881680;
	j3120072236 [label="Mais tu essaies de me distraire! Je n'y suis pas opposée, mais il est bien trop tôt pour pareilles choses, n'est-ce pas?",shape=box,color=blue];
		j3120072236 -> j1293440408;
	j376021340 [label="+5 Chemistry",color=orange];
		j376021340 -> j2126063026;
	j1770541030 [label="Quelle que soit la foi, je la trouve belle. Dis-moi, est-elle nouvelle? Ancienne? La reconnaîtrais-je?",shape=box,color=blue];
		j1770541030 -> j2040249761;
		j1770541030 -> j780830150;
	j1501004171 [label="Vraiment! Oh, comme c'est fascinant! Penser que quelqu'un ait la foi dans un avenir aussi lointain, cela remplit mon cœur de joie. Je suis submergée de joie. Même si je pense que ton passé y est peut-être pour quelque chose, non? Ah, peu importe.",shape=box,color=blue];
		j1501004171 -> j1636326006;
	j1255224180 [label="Je respecte ta réponse. Mais je dois te demander: comment en avoir pareille certitude? N'est-ce pas une forme de foi en soi? Et qu'est-ce que cette... ton Indifférence, sinon un dieu?",shape=box,color=blue];
		j1255224180 -> j3143961851;
		j1255224180 -> j1965159934;
		j1255224180 -> j1062906831;
	j3034881680 [label="+10 Chemistry",color=orange];
		j3034881680 -> j4228014902;
	j1293440408 [label="Je... souhaiterais tout de même une réponse à ma question, s'il te plaît, si cela ne te dérange pas. Mais maintenant, tu me fais rougir!",shape=box,color=blue];
		j1293440408 -> j3841782404;
		j1293440408 -> j639366577;
		j1293440408 -> j1923987444;
		j1293440408 -> j3443452265;
		j1293440408 -> j2140369749;
	j2126063026 [label="Ah oui. Un vagabond, c'est dans ton nom. Tu as vu de nombreuses cultures, de nombreuses croyances, de nombreux mondes. Cela est très spirituel, non? Des morceaux ramassés comme des coquillages.",shape=box,color=blue];
		j2126063026 -> j905134704;
		j2126063026 -> j3161889404;
	j2040249761 [label="Je ne pense pas que tu la reconnaîtrais du tout, non.",shape=box,color=red];
		j2040249761 -> j3611875420;
	j780830150 [label="Tu en reconnaîtrais peut-être certaines parties, mais d'autres te seraient totalement inconnues.",shape=box,color=red];
		j780830150 -> j1818765015;
	j1636326006 [label="Je me demande, es-tu plus proche de l'un ou de l'autre, ou recherches-tu l'équilibre?",shape=box,color=blue];
		j1636326006 -> j1540552574;
		j1636326006 -> j1285765729;
		j1636326006 -> j482241622;
	j3143961851 [label="Qui peut être certain d'avoir raison? Personne ne peut l'être. Mais personnellement, je ne crois toujours pas aux dieux.",shape=box,color=red];
		j3143961851 -> j4203845490;
	j1965159934 [label="Je pense que la religion existe pour combler un vide dans la vie des gens, un vide laissé par la peur de la mort et de l'inconnu.",shape=box,color=red];
		j1965159934 -> j1507240969;
	j1062906831 [label="Je ne sais pas ce qu'est l'Indifférence, mais ce n'est pas un dieu. Il faut juste découvrir de quoi il s'agit. ",shape=box,color=red];
		j1062906831 -> j844175003;
	j4228014902 [label="Ah, peut-être la réponse la plus sage de toutes! Car qui sommes-nous, simples mortels – si nous pouvons encore prétendre l'être – pour prétendre déchiffrer le dessein des dieux?",shape=box,color=blue];
		j4228014902 -> j1008294042;
	j905134704 [label="Je pense qu'il y a aussi quelque chose de plus ancien, de plus vrai et de plus profond qui nous parle à tous. Une sorte de tissu conjonctif.",shape=box,color=red];
		j905134704 -> j1032064548;
	j3161889404 [label="Exactement. Je vois quelque chose de beau en chacun d'eux, même si personne n'a raison ou tort.",shape=box,color=red];
		j3161889404 -> j1032064548;
	j3611875420 [label="Boolean DrifterFaithYesForeign is now true.",color=orange];
		j3611875420 -> j632032487;
	j1818765015 [label="Boolean DrifterFaithYesSimilar is now true.",color=orange];
		j1818765015 -> j3448792673;
	j1540552574 [label="Sol m'attire davantage. ",shape=box,color=red];
		j1540552574 -> j3832340218;
	j1285765729 [label="Lua m'attire davantage.",shape=box,color=red];
		j1285765729 -> j1439494252;
	j482241622 [label="Je recherche l'équilibre. Je pense que c'est dans l'ordre naturel des choses.",shape=box,color=red];
		j482241622 -> j3737983851;
	j4203845490 [label="Boolean DrifterFaithNoMaybe is now true.",color=orange];
		j4203845490 -> j2591153041;
	j1507240969 [label="Boolean DrifterFaithNoFear is now true.",color=orange];
		j1507240969 -> j4078205137;
	j844175003 [label="Boolean DrifterFaithNoMITW is now true.",color=orange];
		j844175003 -> j924853412;
	j1008294042 [label="Souvent, je me suis assise dans le sanctuaire de ma cathédrale et j'ai parlé avec joie à des étrangers qui sont venus pour apprendre et rien de plus.",shape=box,color=blue];
		j1008294042 -> j4037724761;
	j1032064548 [label="+5 Chemistry",color=orange];
		j1032064548 -> j2057800098;
	j632032487 [label="+5 Chemistry",color=orange];
		j632032487 -> j388892865;
	j3448792673 [label="+5 Chemistry",color=orange];
		j3448792673 -> j913944241;
	j3832340218 [label="Boolean DrifterFaithSol is now true.",color=orange];
		j3832340218 -> j4114960371;
	j1439494252 [label="Boolean DrifterFaithLua is now true.",color=orange];
		j1439494252 -> j1563278498;
	j3737983851 [label="Boolean DrifterFaithBalance is now true.",color=orange];
		j3737983851 -> j4038045181;
	j2591153041 [label="Oui, je vois... Peut-être as-tu besoin de ta propre \"preuve\" pour en avoir la certitude? Rien n'est arrivé dans ta vie pour te procurer une telle émotion, comme celle que nous ressentons face à la foi et à la ferveur?",shape=box,color=blue];
		j2591153041 -> j1481343137;
		j2591153041 -> j1737244169;
	j4078205137 [label="Oui, c'est vrai. La foi répond à bien des questions pour bien des âmes. Tu ne crains pas ce qui pourrait arriver après la mort?",shape=box,color=blue];
		j4078205137 -> j762408907;
		j4078205137 -> j1934793216;
	j924853412 [label="Comme c'est fascinant... et maintenant, ils sont deux à répéter les mêmes mots... le diable a murmuré la même chose.",shape=box,color=blue];
		j924853412 -> j3909400328;
	j4037724761 [label="Si curieux de notre foi, mais réticent à dire \"oui, oui, c'est la vérité\". J'espère seulement leur avoir transmis un peu de notre joie.",shape=box,color=blue];
		j4037724761 -> j832260279;
		j4037724761 -> j2792380012;
	j2057800098 [label="Je comprends et c'est magnifique. Je me suis souvent demandé si les Luminaires ne portaient pas d'autres visages. D'autres noms.",shape=box,color=blue];
		j2057800098 -> j3247236545;
	j388892865 [label="Oh, comme c'est fascinant! J'aimerais tellement découvrir ta foi un jour. Entendre parler de vos rituels.",shape=box,color=blue];
		j388892865 -> j4074971632;
		j388892865 -> j3224022464;
	j913944241 [label="Oh, comme c'est fascinant! J'aimerais tellement savoir un jour pourquoi c'est à la fois si cohérent et si différent.",shape=box,color=blue];
		j913944241 -> j4074971632;
		j913944241 -> j3224022464;
	j4114960371 [label="+10 Chemistry",color=orange];
		j4114960371 -> j43023856;
	j1563278498 [label="+5 Chemistry",color=orange];
		j1563278498 -> j2845382912;
	j4038045181 [label="+5 Chemistry",color=orange];
		j4038045181 -> j407296737;
	j1481343137 [label="Non, je n'y crois tout simplement pas.",shape=box,color=red];
		j1481343137 -> j361221326;
	j1737244169 [label="C'est vrai. Je n'ai jamais... \"ressenti\" la foi. Ni eu besoin d'elle.",shape=box,color=red];
		j1737244169 -> j1966719661;
	j762408907 [label="Tout le monde meurt. En avoir peur est absurde. La mort nous touche tous. Ou du moins... cela devrait être le cas.",shape=box,color=red];
		j762408907 -> j997456118;
	j1934793216 [label="J'ai eu l'occasion de mourir assez souvent. Je n'ai pas peur de ce qui vient après. Je m'en réjouis.",shape=box,color=red];
		j1934793216 -> j83485183;
	j3909400328 [label="+5 Chemistry",color=orange];
		j3909400328 -> j1165334244;
	j832260279 [label="C'est un peu surprenant que tu sois ouverte aux gens qui ne partagent pas ta foi.",shape=box,color=red];
		j832260279 -> j68808521;
	j2792380012 [label="C'est exactement ça. Je ne veux pas dire que l'on a \"raison\" ou \"tort\".",shape=box,color=red];
		j2792380012 -> j809047892;
	j3247236545 [label="On sait qu'ils changent de forme pour plaire à leurs fidèles d'autres sectes. Mais telle est ma foi, pas la tienne.",shape=box,color=blue];
		j3247236545 -> j910737942;
	j4074971632 [label="J'aimerais ça.",shape=box,color=red];
		j4074971632 -> j531166020;
	j3224022464 [label="C'est surprenant que tu sois ouverte à l’idée d’autres religions. ",shape=box,color=red];
		j3224022464 -> j1419340399;
	j43023856 [label="Un vagabond qui me ressemble! Tu me fais sourire. J'espère que tu ne mens pas pour me flatter.",shape=box,color=blue];
		j43023856 -> j1554722345;
	j2845382912 [label="Ah, le vagabond suit le chemin de la nuit comme mon cher Lyon. Quand il sera prêt, tu devrais lui parler de sa voie, il sera fou de joie.",shape=box,color=blue];
		j2845382912 -> j1554722345;
	j407296737 [label="L'équilibre sans indécision. Cheminer dans la vie, savoir quand le soleil doit se lever et quand la lune doit lui répondre, sans jamais céder au doute?",shape=box,color=blue];
		j407296737 -> j1348116770;
	j361221326 [label="+5 Chemistry",color=orange];
		j361221326 -> j2958771299;
	j1966719661 [label="+5 Chemistry",color=orange];
		j1966719661 -> j3223777055;
	j997456118 [label="+5 Chemistry",color=orange];
		j997456118 -> j2192308054;
	j83485183 [label="+5 Chemistry",color=orange];
		j83485183 -> j418956590;
	j1165334244 [label="Cela me fait mal au cœur de lui accorder une quelconque crédibilité, mais là... Peut-être que tu devrais lui parler. Sois simplement sur tes gardes. Le diable joue un jeu dangereux.",shape=box,color=blue];
		j1165334244 -> j870493113;
		j1165334244 -> j1047232314;
	j68808521 [label="Je suppose que cela peut être surprenant de voir une personne qui porte l'habit et qui n'est pas stricte dans ses attentes envers les autres. Je trouve que prêcher auprès de ceux qui ne recherchent pas de réconfort ne génère pas beaucoup d'amour.",shape=box,color=blue];
		j68808521 -> j3562387498;
	j809047892 [label="+5 Chemistry",color=orange];
		j809047892 -> j775065533;
	j910737942 [label="J'espère simplement que ta foi t'apporte la paix?",shape=box,color=blue];
		j910737942 -> j1619661332;
		j910737942 -> j3792462744;
		j910737942 -> j901623519;
	j531166020 [label="Ô joie! J'aime tant apprendre. Je me suis souvent demandé si les Luminaires n'avaient pas d'autres visages. D'autres noms.",shape=box,color=blue];
		j531166020 -> j574714785;
	j1419340399 [label="Je suppose que cela peut être surprenant de voir une personne qui porte l'habit et qui n'est pas stricte dans ses attentes envers les autres. Je trouve que prêcher auprès de ceux qui ne recherchent pas de réconfort ne génère pas beaucoup d'amour.",shape=box,color=blue];
		j1419340399 -> j2073376840;
	j1554722345 [label="Je me demande simplement: notre foi t'apporte-t-elle la paix?",shape=box,color=blue];
		j1554722345 -> j1619661332;
		j1554722345 -> j3792462744;
		j1554722345 -> j901623519;
	j1348116770 [label="C'est un don rare... et j'espère que tu le maîtrises. S'attarder trop longtemps à la croisée des chemins, c'est être consumé par les conflits, j'en ai peur.",shape=box,color=blue];
		j1348116770 -> j972626134;
	j2958771299 [label="La vie doit être plus simple, alors. Ne pas vivre selon les lois des dieux et des églises. J'avoue que je suis un peu jalouse.",shape=box,color=blue];
		j2958771299 -> j3973706528;
	j3223777055 [label="Alors, je suis jalouse de toi, vagabond! Avoir vécu tant de siècles sans le besoin de connaître les dieux.",shape=box,color=blue];
		j3223777055 -> j3973706528;
	j2192308054 [label="Tu parles comme un disciple de Lua et je le dis sans offense. Oui, l'Ancienne Sage vient nous chercher tous et verse ses larmes d'argent. Mais tes mots me laissent songeuse...",shape=box,color=blue];
		j2192308054 -> j1850792124;
	j418956590 [label="Oui, ça me fait réfléchir. Je vous regarde, l'enfant, le diable, même Monsieur Loid, ou le Cardinal... tant de siècles s'étendent derrière vous tous.",shape=box,color=blue];
		j418956590 -> j336123892;
	j870493113 [label="Quel genre de jeu dangereux?",shape=box,color=red];
		j870493113 -> j3812869595;
	j1047232314 [label="Il ne pense pas non plus que l'Homme dans le Mur soit réel?",shape=box,color=red];
		j1047232314 -> j957651873;
	j3562387498 [label="+5 Chemistry",color=orange];
		j3562387498 -> j2223169258;
	j775065533 [label="Je souris face à ta sagesse et ta gentillesse envers les croyances des autres.",shape=box,color=blue];
		j775065533 -> j104098091;
	j1619661332 [label="Ce n'est pas le cas.",shape=box,color=red];
		j1619661332 -> j2731426825;
	j3792462744 [label="Honnêtement, je n'y pense pas beaucoup.",shape=box,color=red];
		j3792462744 -> j3831824089;
	j901623519 [label="C'est le cas.",shape=box,color=red];
		j901623519 -> j549629905;
	j574714785 [label="On sait qu'ils changent de forme pour plaire à leurs adeptes d'autres sectes. Mais telle est ma foi, pas la tienne. Je ne prêcherai pas auprès de ceux qui ne recherchent pas le réconfort. Je trouve que cela ne génère pas beaucoup d'amour.",shape=box,color=blue];
		j574714785 -> j2073376840;
	j2073376840 [label="Non, ma foi m'appartient et la tienne t'appartient. J'espère simplement qu'elle t'apporte la paix.",shape=box,color=blue];
		j2073376840 -> j1619661332;
		j2073376840 -> j3792462744;
		j2073376840 -> j901623519;
	j972626134 [label="En fin de compte, chacun doit choisir son chemin. Mais c'est à la croisée des chemins que nous devons tous commencer, l'équilibre étant le fondement de toute structure.",shape=box,color=blue];
		j972626134 -> j1419093168;
	j3973706528 [label="Mais je me demande... est-ce que ne croire en rien t'apporte la paix?",shape=box,color=blue];
		j3973706528 -> j1619661332;
		j3973706528 -> j3792462744;
		j3973706528 -> j901623519;
	j1850792124 [label="De qui parles-tu lorsque tu dis que \"cela devrait être le cas\" pour vous tous? Je vous regarde, l'enfant, le diable, même Monsieur Loid, ou le Cardinal… tant de siècles s'étendent derrière vous tous.",shape=box,color=blue];
		j1850792124 -> j336123892;
	j336123892 [label="Je me demande combien de siècles nous attendent avant que Lua ne vienne nous chercher. Et je me demande avec quelle ardeur je l'accueillerai quand ce jour viendra. Mais c'est ma foi, pas la tienne.",shape=box,color=blue];
		j336123892 -> j3973706528;
	j3812869595 [label="Je l'ignore encore. Il garde ses plans pour lui comme un bon diable. Mais il ne croit en aucun dieu. Sauf peut-être en lui-même.",shape=box,color=blue];
		j3812869595 -> j3973706528;
	j957651873 [label="Non, en effet. Il est comme toi, il ne croit en aucun dieu. Sauf peut-être en lui-même.",shape=box,color=blue];
		j957651873 -> j3973706528;
	j2223169258 [label="Non, quiconque vient avec un esprit ouvert sera accueilli à bras ouverts.",shape=box,color=blue];
		j2223169258 -> j104098091;
	j104098091 [label="Je me demande simplement, est-ce que cela t'apporte la paix?",shape=box,color=blue];
		j104098091 -> j1619661332;
		j104098091 -> j3792462744;
		j104098091 -> j901623519;
	j2731426825 [label="Boolean DrifterFaithNoPeace is now true.",color=orange];
		j2731426825 -> j2523816898;
	j3831824089 [label="+10 Chemistry",color=orange];
		j3831824089 -> j3746496203;
	j549629905 [label="+10 Chemistry",color=orange];
		j549629905 -> j2137145318;
	j1419093168 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j1419093168 -> j2019396087;
	j2523816898 [label="+10 Chemistry",color=orange];
		j2523816898 -> j843575113;
	j3746496203 [label="Ma jalousie est à son comble! Elle me consumerait. J'aimerais... t'en reparler, si tu le permets. Je ne souhaite ni te faire la morale, ni être indiscrète. Je ne souhaite pas te causer de chagrin.",shape=box,color=blue];
		j3746496203 -> j3961385492;
	j2137145318 [label="Alors, je sais que Sol te sourit, que tu le pries ou non, car tu as trouvé le seul chemin dont tu as besoin.",shape=box,color=blue];
		j2137145318 -> j2349954808;
	j2019396087 [label="Ah, pardon! La petite Marie prêche, c'est embarrassant! Je ne suis pas venue ici pour te faire la leçon comme une maîtresse d'école.",shape=box,color=blue];
		j2019396087 -> j1554722345;
	j843575113 [label="Je suis profondément touchée par ton honnêteté, voyageur. J'aimerais... t'en reparler, si tu le permets. Je ne souhaite ni te faire la morale, ni être indiscrète. Je ne souhaite pas te déranger.",shape=box,color=blue];
		j843575113 -> j3961385492;
	j3961385492 [label="Je suis simplement curieuse et je souhaite t'aider si je le peux. S'il te plaît, dis non et nous n'en reparlerons plus jamais.",shape=box,color=blue];
		j3961385492 -> j1384991011;
		j3961385492 -> j1683897566;
	j2349954808 [label="Je me demande si on pourrait en reparler? J'ai vraiment hâte d'en savoir plus.",shape=box,color=blue];
		j2349954808 -> j1384991011;
		j2349954808 -> j1683897566;
	j1384991011 [label="Non, merci.",shape=box,color=red];
		j1384991011 -> j240768422;
	j1683897566 [label="Bien sûr.",shape=box,color=red];
		j1683897566 -> j3894396683;
	j240768422 [label="Boolean DrifterFaithStop is now true.",color=orange];
		j240768422 -> j2428291073;
	j3894396683 [label="Merci, merci! Je valorise vraiment ce que tu viens de me donner. Je ne le gâcherai pas. À bientôt.",shape=box,color=blue];
		j3894396683 -> "Chat ends.";
	j2428291073 [label="Je comprends parfaitement et je ne suis pas vexée. Merci de m'avoir écoutée et je te suis reconnaissante pour ce que tu as partagé. Nous parlerons d'autres sujets, Sol sait que nous en avons beaucoup!",shape=box,color=blue];
		j2428291073 -> "Chat ends.";
}