		j2801885051 -> j1903202376;
		j2801885051 -> j373240886;
	j384302909 [label="Je sais que tu as dit que ta foi t'est personnelle, un peu comme une histoire que tu as écrite, mais c'est quand même une foi. Pourquoi crois-tu?",shape=box,color=blue];
		j384302909 -> j2274337357;
