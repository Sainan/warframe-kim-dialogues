		2176 -> 2189 [label=false,color=brown];
	2179 [label="Non, j'ai toujours simplement eu le sentiment d'avoir une présence dans ma vie, là pour me guider. Un bienfaiteur qui me sourit et me montre la direction quand j'arrive à un carrefour, rien de plus.",shape=box,color=blue];
