	j576310905 [label="Et toi? Pourquoi?",shape=box,color=blue];
		j576310905 -> j2274337357;
		j576310905 -> j3552285914;
		j576310905 -> j4163294720;
		j576310905 -> j1903202376;
		j576310905 -> j373240886;
	j731106238 [label="Je pourrais te poser la même question quant à Lua, non? Pourquoi crois-tu?",shape=box,color=blue];
		j731106238 -> j2274337357;
		j731106238 -> j4163294720;
		j731106238 -> j1903202376;
		j731106238 -> j373240886;
		j731106238 -> j3552285914;
	j1591907823 [label="Pourquoi Sol, en particulier? Plutôt que Lua, ou peut-être l'équilibre auquel tu adhères? Excellente question. Pourquoi y crois-tu?",shape=box,color=blue];
		j1591907823 -> j2274337357;
		j1591907823 -> j3552285914;
		j1591907823 -> j4163294720;
		j1591907823 -> j1903202376;
		j1591907823 -> j373240886;
	j1803267918 [label="Qu'est-ce qui me donne cette certitude, me demandes-tu? Où es-tu en train de me dire que nous ne pouvons pas connaître l'univers?",shape=box,color=blue];
		j1803267918 -> j3367654100;
	j3757891458 [label="Comme tu n'as aucune forme de foi, je peux comprendre pourquoi cela peut te paraître étrange, oui.",shape=box,color=blue];
		j3757891458 -> j1833248636;
	j76145532 [label="Qu'est-ce qui me donne cette certitude, te demandes-tu?",shape=box,color=blue];
		j76145532 -> j3367654100;
	j1646837204 [label="Sais-tu ce que cela signifie?!",shape=box,color=blue];
		j1646837204 -> j1847636852;
		j1646837204 -> j2650841366;
	j3305575879 [label="Oui! Je n'aime pas les fleurs coupées. Si tu souhaites m'offrir un cadeau, j'espère que ce ne sera pas des roses dans un vase.",shape=box,color=blue];
		j3305575879 -> j294429399;
		j3305575879 -> j2292817655;
	j236583780 [label="Pour toi? Bien sûr.",shape=box,color=blue];
		j236583780 -> j3134057048;
		j236583780 -> j2429168889;
	j2274337357 [label="Je... suppose que je ressens l'obligation de le faire.",shape=box,color=red];
		j2274337357 -> j3222404579;
	j3552285914 [label="Je n'étais pas totalement honnête avec toi quand je t'ai donné cette réponse.",shape=box,color=red];
		j3552285914 -> j3913854856;
	j4163294720 [label="J'ai vécu une expérience qui a changé ma vie.",shape=box,color=red];
		j4163294720 -> j980101743;
	j1903202376 [label="Il ne s'est jamais rien passé, c'est juste un ressenti. Ça me guide.",shape=box,color=red];
		j1903202376 -> j152560765;
	j373240886 [label="Je veux croire. Donc, je crois.",shape=box,color=red];
		j373240886 -> j3080931226;
	j3367654100 [label="Je crains que ma réponse ne te déçoive, loup. Il n'y a pas eu de grand miracle. Aucun rayon du ciel ne m'a éclairée.",shape=box,color=blue];
		j3367654100 -> j3820461653;
	j1833248636 [label="\"Pourquoi cette jeune femme sensée croit-elle à des choses que je ne pense pas réelles, qui me semblent idiotes\", non?",shape=box,color=blue];
		j1833248636 -> j2589889789;
		j1833248636 -> j3329938689;
	j1847636852 [label="Non?",shape=box,color=red];
		j1847636852 -> j1772571878;
	j2650841366 [label="Dois-je m’inquiéter?",shape=box,color=red];
		j2650841366 -> j3966783975;
	j294429399 [label="Comment as-tu deviné que c'était ma question? C'est incroyable.",shape=box,color=red];
		j294429399 -> j147908575;
	j2292817655 [label="Ce... n'est pas exactement ce que j'allais te demander, mais j'en tiendrai compte, merci!",shape=box,color=red];
		j2292817655 -> j1900980834;
	j3134057048 [label="Pourquoi crois-tu en Sol?",shape=box,color=red];
		j3134057048 -> j2563733639;
	j3222404579 [label="Check boolean DrifterFaithNoPeace",color=orange];
		j3222404579 -> j1979276604 [label=true,color=green];
		j3222404579 -> j966994191 [label=false,color=brown];
	j3913854856 [label="Oui? Je suis curieuse, pourquoi as-tu menti?",shape=box,color=blue];
		j3913854856 -> j1227119607;
		j3913854856 -> j4085932099;
	j980101743 [label="Alors, je suis jalouse! La plupart n'ont pas cette chance, n'est-ce pas?",shape=box,color=blue];
		j980101743 -> j2357912790;
	j152560765 [label="Ah, alors nos réponses sont identiques. Je n'ai jamais connu de miracle, sauf peut-être l'arrivée du Cardinal à la Cathédrale.",shape=box,color=blue];
		j152560765 -> j388403675;
	j3080931226 [label="Check boolean DrifterFaithNoPeace",color=orange];
		j3080931226 -> j2471178706 [label=true,color=green];
		j3080931226 -> j3541875274 [label=false,color=brown];
	j3820461653 [label="Non, j'ai toujours simplement eu le sentiment d'avoir une présence dans ma vie, là pour me guider. Un bienfaiteur qui me sourit et me montre la direction quand j'arrive à un carrefour, rien de plus.",shape=box,color=blue];
		j3820461653 -> j1169464331;
		j3820461653 -> j3060179835;
	j2589889789 [label="Honnêtement? Oui, en quelque sorte. Mais je ne voulais pas le formuler comme ça.",shape=box,color=red];
		j2589889789 -> j4199949823;
	j3329938689 [label="Je me demandais plutôt s’il y avait eu un événement, ou... un moment qui avait conduit à cela.",shape=box,color=red];
		j3329938689 -> j3367654100;
	j1772571878 [label="Moi non plus! Mais les possibilités sont désormais infinies!",shape=box,color=blue];
		j1772571878 -> j3762879159;
	j3966783975 [label="Peut-être! Parce que les possibilités sont désormais infinies!",shape=box,color=blue];
		j3966783975 -> j3762879159;
	j147908575 [label="Parce que le diable m'a dit que tu allais me le demander.",shape=box,color=blue];
		j147908575 -> j1390559408;
	j1900980834 [label="Oh! Oh, pardonne-moi! Je suis désolée. Que voulais-tu me demander? Maintenant, je suis mortifiée...",shape=box,color=blue];
		j1900980834 -> j3134057048;
		j1900980834 -> j2429168889;
	j1979276604 [label="Et tu dis que ça ne t'apporte pas beaucoup de paix... ça me brise le cœur.",shape=box,color=blue];
		j1979276604 -> j966994191;
	j966994191 [label="Je ne te dirai pas quoi faire. Et je ne te dirai pas quels chemins chercher.",shape=box,color=blue];
		j966994191 -> j3025881858;
	j1227119607 [label="Franchement, je ne sais pas trop. C'était impulsif.",shape=box,color=red];
		j1227119607 -> j748054419;
	j4085932099 [label="J'ai pensé que ce serait peut-être un moyen de mieux te connaître...",shape=box,color=red];
		j4085932099 -> j2707828563;
	j2357912790 [label="Mais ta question portait sur les raisons pour lesquelles je crois et j'ai été assez impolie en te retournant la question, je suis désolée.",shape=box,color=blue];
		j2357912790 -> j3367654100;
	j388403675 [label="Même là, c'était une action de l'homme et de la science, pas des Luminaires, non? Ce sérum qui m'a donné le don de voler...",shape=box,color=blue];
		j388403675 -> j1955855045;
	j2471178706 [label="Mais tu dis que ça ne t'apporte pas beaucoup de paix... ça me brise le cœur...",shape=box,color=blue];
		j2471178706 -> j2816816450;
	j3541875274 [label="Je pense que ta foi est peut-être la plus forte de toutes, non?",shape=box,color=blue];
		j3541875274 -> j1814290343;
	j1169464331 [label="Tu ne qualifierais pas le sérum d’Entrati de miracle?",shape=box,color=red];
		j1169464331 -> j388403675;
	j3060179835 [label="Même pas les voix de Lyon? Ni l'Indifférence?",shape=box,color=red];
		j3060179835 -> j1609572770;
	j4199949823 [label="Oh, me prendre pour une idiote parce que je crois aux Luminaires est l’une des choses les plus polies que tu puisses penser de quelqu’un ayant une foi différente.",shape=box,color=blue];
		j4199949823 -> j3805263691;
	j3762879159 [label="Le diable devrait avoir très peur! Prends garde, malin! La lumière te frappera des cieux!",shape=box,color=blue];
		j3762879159 -> j3756003759;
	j1390559408 [label="Non, non, non... Tu n'allais pas me demander ça, n'est-ce pas? Ah!! Je vais lui faire bouffer un de ces livres!",shape=box,color=blue];
		j1390559408 -> j1783185369;
	j3025881858 [label="Car je suis un pauvre abri dans cette tempête du Néant dans laquelle tu te trouves.",shape=box,color=blue];
		j3025881858 -> j494628304;
	j748054419 [label="J'ignore quel instinct a pu te pousser à me dire de telles choses. Mais je suis heureuse que tu aies dit la vérité, maintenant.",shape=box,color=blue];
		j748054419 -> j3732557714;
	j2707828563 [label="Oh... tu n'avais pas besoin de me dire de telles choses pour me connaître.",shape=box,color=blue];
		j2707828563 -> j3732557714;
	j1955855045 [label="C'est l'œuvre d'un homme. Mais je crois que c'est Sol qui a guidé nos chemins pour qu'ils ne fassent plus qu'un.",shape=box,color=blue];
		j1955855045 -> j1457342715;
	j2816816450 [label="J'ai l'impression que tu erres dans les bois, cherchant désespérément un sentier qui te mènera à destination.",shape=box,color=blue];
		j2816816450 -> j3696124658;
	j1814290343 [label="Parcourir le sentier dans les bois simplement avec l'espoir dans ton cœur pour te montrer le chemin?",shape=box,color=blue];
		j1814290343 -> j395550467;
	j1609572770 [label="C'est possible, je l'ignore. Peut-être que le diable a raison et que tout cela est le fruit d'une science que nous ne maîtrisons pas encore. Les deux ne sont pas exclusifs, non?",shape=box,color=blue];
		j1609572770 -> j1457342715;
	j3805263691 [label="Cela ne m’offense pas et je suis heureuse de ton honnêteté. ",shape=box,color=blue];
		j3805263691 -> j3367654100;
	j3756003759 [label="+20 Chemistry",color=orange];
		j3756003759 -> j4087993713;
	j1783185369 [label="Que voulais-tu me demander? Maintenant, je suis mortifiée...",shape=box,color=blue];
		j1783185369 -> j3134057048;
		j1783185369 -> j2429168889;
	j494628304 [label="Mais je me demande si tu ne te trouves pas à un carrefour, à réfléchir à la direction à prendre, non?",shape=box,color=blue];
		j494628304 -> j908117878;
	j3732557714 [label="Une âme est bien plus que la foi qu'elle porte. Je suis une Sœur de Sol, mais j'espère que tu vois plus que cela en moi, non?",shape=box,color=blue];
		j3732557714 -> j3488885704;
	j1457342715 [label="C'est pour cela que je crois. Je sens Sol à mes côtés quand j'arrive aux endroits où je suis dans le doute. Je ferme les yeux et il est là, pour me guider.",shape=box,color=blue];
		j1457342715 -> j2742869442;
		j1457342715 -> j830882409;
		j1457342715 -> j2013496897;
	j3696124658 [label="J'ignore si tu le trouveras un jour, mais je prie pour que ça arrive. Car ce que tu pourrais y découvrir serait un miracle. ",shape=box,color=blue];
		j3696124658 -> j2357912790;
	j395550467 [label="C'est beau...",shape=box,color=blue];
		j395550467 -> j2357912790;
	j4087993713 [label="Sainte Mère Sol, vous avez béni votre fille, aujourd'hui! HA-HA!!",shape=box,color=blue];
		j4087993713 -> "Chat ends.";
	j908117878 [label="L'obligation n'est pas une raison de croire. Elle n'engendre au mieux que le doute, au pire un mépris vide de sens.",shape=box,color=blue];
		j908117878 -> j587311290;
	j3488885704 [label="Il y a autant de sujets que nous pourrions choisir que d'étoiles dans le ciel!",shape=box,color=blue];
		j3488885704 -> j1008815749;
		j3488885704 -> j2521382811;
	j2742869442 [label="C'est beau.",shape=box,color=red];
		j2742869442 -> j3204009912;
	j830882409 [label="A-t-il déjà échoué à te guider?",shape=box,color=red];
		j830882409 -> j3784499711;
	j2013496897 [label="J'aimerais avoir ça...",shape=box,color=red];
		j2013496897 -> j2759510937;
	j587311290 [label="La foi devrait être un baume pour l'âme. Pas une béquille ni une excuse.",shape=box,color=blue];
		j587311290 -> j1734865800;
	j1008815749 [label="Alors, tu me pardonnes?",shape=box,color=red];
		j1008815749 -> j2845193787;
	j2521382811 [label="Je te demande pardon. C'était stupide.",shape=box,color=red];
		j2521382811 -> j455734899;
	j3204009912 [label="Oui, et je sais que j'ai de la chance. Et c'est une paix qu'il est facile de chercher à imposer aux autres, qu'ils le veuillent ou non.",shape=box,color=blue];
		j3204009912 -> j3688050721;
	j3784499711 [label="Oui, souvent. Et dans ces moments-là, je me demande pourquoi. Peut-être suis-je censée trouver ma propre voie, non? Ou peut-être que je suis une folle, après tout, hah! On n'est pas toujours censé savoir.",shape=box,color=blue];
		j3784499711 -> j3688050721;
	j2759510937 [label="Oui, et je prie pour que tu l'aies un jour. Mais ce n'est pas quelque chose qui s'apprend, c'est quelque chose qu'il faut trouver.",shape=box,color=blue];
		j2759510937 -> j4047516002;
	j1734865800 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j1734865800 -> j2357912790;
	j2845193787 [label="Oui, je te pardonne. Si tu étais comme Lyon, je te dirais que tu as gagné dix coups de fouet.",shape=box,color=blue];
		j2845193787 -> j1458515445;
	j455734899 [label="Oui, et si tu étais comme Lyon, je te dirais que tu as gagné dix coups de fouet! Mais ce n'est pas le cas. Et je te pardonne.",shape=box,color=blue];
		j455734899 -> j1458515445;
	j3688050721 [label="Mais tant que je ne fais de mal à personne avec mes croyances, je ne vois aucun mal à les conserver, n'est-ce pas?",shape=box,color=blue];
		j3688050721 -> j3349799475;
	j4047516002 [label="En soi ou à l'extérieur, l'endroit varie pour chacun de nous.",shape=box,color=blue];
