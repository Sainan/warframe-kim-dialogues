digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo7 begins." [color=orange];
		"MarieRank4Convo7 begins." -> j2946575423;
	j2946575423 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j2946575423 -> j3255816954;
	j3255816954 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j3255816954 -> j3513266685 [label="x >= 0",color=purple];
		j3255816954 -> "Chat ends." [label="x <= 0",color=purple];
		j3255816954 -> "Chat ends." [label="false",color=purple];
	j3513266685 [label="Voyageur, excuse-moi... Crois-tu honnêtement qu'il soit sage d'aider le diable?",shape=box,color=blue];
		j3513266685 -> j1993316766;
	"Chat ends." [color=orange];
	j1993316766 [label="Je ne souhaite pas ignorer ceux qui recherchent l’absolution ou de l’aide, mais... je ne pense pas que ce soit l’un ou l’autre de ces objectifs que recherche le diable.",shape=box,color=blue];
		j1993316766 -> j2237134645;
		j1993316766 -> j3063578776;
		j1993316766 -> j1876419115;
		j1993316766 -> j2429168889;
	j2237134645 [label="Et que penses-tu qu'il recherche vraiment?",shape=box,color=red];
		j2237134645 -> j1407366025;
	j3063578776 [label="Je sais que vous ne vous entendez pas bien et cela me navre. Mais je ne peux pas vraiment le flanquer dehors.",shape=box,color=red];
		j3063578776 -> j3026260987;
	j1876419115 [label="Roathe a oublié bien plus de choses sur les Orokins – littéralement – que nous n'en saurons jamais. Nous avons besoin de lui.",shape=box,color=red];
		j1876419115 -> j1587708289;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j1407366025 [label="C'est un animal sauvage. Il s'approchera peut-être si tu lui offres de la nourriture et un abri chaud, mais tout cela disparaîtra dès que tu ne lui seras plus utile.",shape=box,color=blue];
		j1407366025 -> j1963748273;
	j3026260987 [label="Add 1 to Thermostat counter",color=orange];
		j3026260987 -> j888436916;
	j1587708289 [label="Add -1 to Thermostat counter",color=orange];
		j1587708289 -> j1407366025;
	j1963748273 [label="Il veut quelque chose de toi. De nous. ",shape=box,color=blue];
		j1963748273 -> j863296879;
	j888436916 [label="Non, et je ne suggère pas que tu le fasses. Simplement, il n'est pas digne de confiance. Ni maintenant, ni jamais.",shape=box,color=blue];
		j888436916 -> j1407366025;
	j863296879 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j863296879 -> j4093421340 [label="x > 5",color=purple];
		j863296879 -> j1317799268 [label="x <= 5",color=purple];
		j863296879 -> j1317799268 [label="false",color=purple];
	j4093421340 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4093421340 -> j2637689610 [label="x >= 21",color=purple];
		j4093421340 -> j3316673896 [label="x < 21",color=purple];
		j4093421340 -> j3316673896 [label="false",color=purple];
	j1317799268 [label="Ces souvenirs perdus, ces horreurs passées de Tau... Je m'inquiète de ce qu'ils présagent.",shape=box,color=blue];
		j1317799268 -> j2746910635;
		j1317799268 -> j823049694;
	j2637689610 [label="Je sais que tu crois que nous avons découvert tout ce qu'il y a à savoir sur son esprit brisé.",shape=box,color=blue];
		j2637689610 -> j2581778000;
		j2637689610 -> j823049694;
	j3316673896 [label="Plus nous en apprenons, plus nous approfondissons son esprit brisé, plus je suis déstabilisée. Plus le danger devient évident.",shape=box,color=blue];
		j3316673896 -> j823049694;
		j3316673896 -> j2746910635;
	j2746910635 [label="Je ne pense pas qu'il va disparaître dès qu'il retrouvera la mémoire. Il y a autre chose.",shape=box,color=red];
		j2746910635 -> j1988545455;
	j823049694 [label="Il attend probablement encore autre chose. Non pas de ses souvenirs, mais de nous.",shape=box,color=red];
		j823049694 -> j336504007;
	j2581778000 [label="Je le crois quand il dit que c'est tout ce qu'on découvrira. Et si c'était le cas, pourquoi est-il encore là?",shape=box,color=red];
		j2581778000 -> j1988545455;
	j1988545455 [label="J’avoue que je m’inquiète davantage de ce qu’il compte faire de cette connaissance, que de la connaissance elle-même.",shape=box,color=blue];
		j1988545455 -> j4226400944;
	j336504007 [label="Oui! C'est exactement ce qui m'inquiète. Mais qu'est-ce que ça pourrait être? À quoi lui servons-nous, maintenant?",shape=box,color=blue];
		j336504007 -> j4226400944;
	j4226400944 [label="Quelle que soit la manière dont il entend gérer sa nouvelle existence, je crains qu'il cherche à nous impliquer. Et je souhaite simplement que nous ne nous laissions pas aveugler par l'espoir de sa bienveillance.",shape=box,color=blue];
		j4226400944 -> j1944303487;
		j4226400944 -> j1987694927;
		j4226400944 -> j1423333443;
	j1944303487 [label="Je suis avec toi. Je ne lui fais pas confiance.",shape=box,color=red];
		j1944303487 -> j3916417724;
	j1987694927 [label="Il est puissant et il possède des connaissances. C'est quelqu'un que j'aimerais beaucoup avoir à mes côtés.",shape=box,color=red];
		j1987694927 -> j3345351434;
	j1423333443 [label="Il ne sert à rien de se demander s'il va nous trahir – il ne l'a pas fait. Et je ne considère pas les gens comme coupables des péchés qu'ils n'ont pas encore commis.",shape=box,color=red];
		j1423333443 -> j14315975;
	j3916417724 [label="+20 Chemistry",color=orange];
		j3916417724 -> j1241718657;
	j3345351434 [label="Add -1 to Thermostat counter",color=orange];
		j3345351434 -> j1184700542;
	j14315975 [label="Add 1 to Thermostat counter",color=orange];
		j14315975 -> j3587074596;
	j1241718657 [label="Bien! Au moins, je serai tranquille en sachant que d'autres yeux observeront ce diable. Ça m'aidera peut-être à dormir. Merci.",shape=box,color=blue];
		j1241718657 -> j3984234322;
	j1184700542 [label="Oui, mais je me demande quel sera le prix final de cette alliance. Le résultat final risque de ne pas être celui espéré.",shape=box,color=blue];
		j1184700542 -> j420854731;
	j3587074596 [label="Oui... Je suppose que tu as raison. Nous ne pouvons pas poursuivre des ombres. Nous devons soutenir tous ceux qui souhaitent vaincre l'Indifférence.",shape=box,color=blue];
		j3587074596 -> j808986917;
	j3984234322 [label="Boolean MarieRoatheNoTrust is now true.",color=orange];
		j3984234322 -> "Chat ends.";
	j420854731 [label="Je te conseille simplement la prudence... c'est un monstre, déguisé en gentleman. Fais attention avec lui, s'il te plaît?",shape=box,color=blue];
		j420854731 -> j3254271260;
		j420854731 -> j4140171661;
	j808986917 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j808986917 -> j2449932856 [label=true,color=green];
		j808986917 -> j2921833769 [label=false,color=brown];
	j3254271260 [label="Je pense que tu es un peu injuste envers lui.",shape=box,color=red];
		j3254271260 -> j2671916;
	j4140171661 [label="Je ferai attention, promis.",shape=box,color=red];
		j4140171661 -> j2582122476;
	j2449932856 [label="Même si tu crois que la force derrière tout cela n’est pas née d’un dieu mais de notre propre esprit, cela reste une menace.",shape=box,color=blue];
		j2449932856 -> j420854731;
	j2921833769 [label="Même s'il croit que la force derrière tout cela n'est pas née d'un dieu mais de notre propre esprit, cela reste une menace.",shape=box,color=blue];
		j2921833769 -> j420854731;
	j2671916 [label="Add -1 to Thermostat counter",color=orange];
		j2671916 -> j2791209211;
	j2582122476 [label="+20 Chemistry",color=orange];
		j2582122476 -> j323210978;
	j2791209211 [label="Oui? Comment ça? Je ne dis pas ça avec cruauté, je suis vraiment curieuse.",shape=box,color=blue];
		j2791209211 -> j1603246710;
		j2791209211 -> j2873029250;
		j2791209211 -> j655248410;
		j2791209211 -> j1991653090;
	j323210978 [label="Merci. Je ne demande rien de plus.",shape=box,color=blue];
		j323210978 -> "Chat ends.";
	j1603246710 [label="Il a grandi dans une société différente, à une époque différente, avec des attentes différentes. On peut ne pas aimer ça, mais il est comme il est.",shape=box,color=red];
		j1603246710 -> j2965845657;
	j2873029250 [label="Toi et Lyon avez accepté le sérum protoframe d'Entrati. De bon gré. Lui, non. Imagine ce que ça fait?",shape=box,color=red];
		j2873029250 -> j1945593916;
		j2873029250 -> j2916701350;
		j2873029250 -> j2965845657;
	j655248410 [label="Il a traversé des siècles entiers à faire ce qu'il jugeait nécessaire. Nous ne sommes simplement pas d'accord sur ce que cela signifie.",shape=box,color=red];
		j655248410 -> j1945593916;
		j655248410 -> j3945788343;
	j1991653090 [label="Je pense que c'est surtout son comportement qui te met en colère, pas ses actions.",shape=box,color=red];
		j1991653090 -> j3945788343;
		j1991653090 -> j1945593916;
	j2965845657 [label="C'est un soldat de haut rang et une personnalité mondaine. Et ces deux qualités nécessitent parfois de prendre des décisions obscures.",shape=box,color=red];
		j2965845657 -> j681163897;
	j1945593916 [label="Je pense qu’une personne peut faire ce que nous considérons comme la \"mauvaise chose\" et le faire avec de bonnes intentions.",shape=box,color=red];
		j1945593916 -> j3016964715;
	j2916701350 [label="Il a fait tout ce qu'il a fait au nom du sauvetage de l'Empire Orokin - et en guise de remerciement, il a été jeté dans ce pétrin contre sa volonté.",shape=box,color=red];
		j2916701350 -> j681163897;
	j3945788343 [label="Je pense qu'il t'agace parce qu'il est fier de ce qu'il a fait.",shape=box,color=red];
		j3945788343 -> j3521971341;
	j681163897 [label="Check boolean MarieGrineer",color=orange];
		j681163897 -> j2222355672 [label=true,color=green];
		j681163897 -> j601276870 [label=false,color=brown];
	j3016964715 [label="Tu peux le voir comme un diable, mais dans son esprit, cela ne pourrait pas être plus éloigné de la vérité.",shape=box,color=red];
		j3016964715 -> j681163897;
	j3521971341 [label="Oui, je n'apprécie pas ceux qui se complaisent dans la mort. Et je trouve son empressement à verser le sang alarmant. Et le fait que tu ne trouves pas ça troublant l'est tout autant.",shape=box,color=blue];
		j3521971341 -> j2255631954;
	j2222355672 [label="Et je pense que ceux qui commandent ces \"Corpus\" ou \"Grineers\" que tu combats diraient la même chose. Ils ne se croient pas dans l'erreur.",shape=box,color=blue];
		j2222355672 -> j2304209498;
	j601276870 [label="Et je pense que ceux qui commandent ces \"Corpus\" ou \"Grin-ires\" que tu combats diraient la même chose. Ils ne se croient pas dans l'erreur.",shape=box,color=blue];
		j601276870 -> j2304209498;
	j2255631954 [label="Il est trop facile d’adapter la voie de l’abnégation au péché de violence, d’en rejeter l’horreur, de dire qu’elle n’a aucune importance au nom de \"ce qui compte\".",shape=box,color=blue];
		j2255631954 -> j927286883;
	j2304209498 [label="Ils croient leurs actions justes, bonnes et nécessaires. Comment peut-on cautionner un démon et pas un autre?",shape=box,color=blue];
		j2304209498 -> j3358949453;
		j2304209498 -> j3439133458;
		j2304209498 -> j2808002778;
		j2304209498 -> j3691124559;
	j927286883 [label="Se sentir fier de l'acte lui-même... c'est trop pour moi. Je ne me réjouis pas de devoir ôter la vie, mais lui, oui. Alors, de ce point de vue-là? Nous sommes bien différents.",shape=box,color=blue];
		j927286883 -> j1259701220;
	j3358949453 [label="J'essaierai de les arrêter quand ils feront des choses avec lesquelles je ne suis pas d'accord. Mais... je me battrai à leurs côtés quand il le faudra.",shape=box,color=red];
		j3358949453 -> j912211724;
	j3439133458 [label="Je ne crois pas que ces groupes soient \"bons\" ou \"mauvais\" par définition. Je le crois seulement sur base des actions qu'ils choisissent d'entreprendre.",shape=box,color=red];
		j3439133458 -> j2316338986;
	j2808002778 [label="Ce n'est pas à moi de déclarer que certaines actions sont \"bonnes\" et d'autres \"mauvaises\". Je fais ce que je fais pour protéger ceux qui ont besoin d'être protégés.",shape=box,color=red];
		j2808002778 -> j912211724;
	j3691124559 [label="Tu me demandes de juger un groupe entier de personnes sur les mêmes critères que ceux que j’utiliserais pour juger un individu.",shape=box,color=red];
		j3691124559 -> j2316338986;
	j1259701220 [label="Je ne peux que prier pour qu'il ne soit pas trop tard si le diable décide de te planter son couteau dans les côtes. Je ne souhaite pas que tes dernières pensées soient: \"Marie l'avait dit.\"",shape=box,color=blue];
		j1259701220 -> j3958212961;
		j1259701220 -> j3681323619;
	j912211724 [label="Et tu crois que le diable n'est pas une menace? Qu'il n'est pas dangereux pour ceux qui l'entourent? Il pourrait faire beaucoup de mal.",shape=box,color=blue];
		j912211724 -> j379687316;
		j912211724 -> j614160418;
	j2316338986 [label="Et que dire des actes horribles qu'il a commis? Tous ces morts, tous ces massacres? Étaient-ils justifiés à tes yeux?",shape=box,color=blue];
		j2316338986 -> j614160418;
	j3958212961 [label="Il ne le fera pas. Et s'il essaie, je l'en empêcherai.",shape=box,color=red];
		j3958212961 -> j3523901656;
	j3681323619 [label="Je te promets que ce ne seront pas mes dernières pensées.",shape=box,color=red];
		j3681323619 -> j2423574446;
	j379687316 [label="Si un moment donné il se retourne contre nous, j'agirai. En attendant, il a prouvé qu'il n'était qu'un allié. Si ce n'est qu'il est... un peu mélodramatique.",shape=box,color=red];
		j379687316 -> j4067467081;
	j614160418 [label="Je ne vois pas sa dangerosité comme un problème. C'est une arme. Et les armes peuvent servir à tuer ou à protéger.",shape=box,color=red];
		j614160418 -> j784769701;
	j3523901656 [label="Je t'admire pour ta confiance en toi, même si je regrette que tu aies confiance en lui. Alors, j'aurai confiance en toi à mon tour, je suppose.",shape=box,color=blue];
		j3523901656 -> j1311735323;
	j2423574446 [label="Je crois que tu ne le dis pas dans le sens que j'espérais, mais je ne vais pas trop y prêter attention.",shape=box,color=blue];
		j2423574446 -> j1311735323;
	j4067467081 [label="Add 1 to Thermostat counter",color=orange];
		j4067467081 -> j1259701220;
	j784769701 [label="Add -1 to Thermostat counter",color=orange];
		j784769701 -> j1259701220;
	j1311735323 [label="Je dois y aller. Mais encore une fois, je t'en prie, prudence. Pour mon bien, si ce n'est pas pour le tien, d'accord?",shape=box,color=blue];
		j1311735323 -> j367054140;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
}