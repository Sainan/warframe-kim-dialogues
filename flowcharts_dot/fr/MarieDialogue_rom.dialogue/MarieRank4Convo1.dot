	j1751438847 [label="En faire plus reviendrait à les écraser ou à les faire fuir.",shape=box,color=blue];
		j1751438847 -> j1539440762;
	j1953831990 [label="C'est tout ce que je demande. Oh, mais je suis tellement heureuse! Je dois dois faire en sorte que ce couple devienne réalité!",shape=box,color=blue];
		j1953831990 -> j1501902887;
		j1953831990 -> j3862493966;
		j1953831990 -> j1050395980;
	j3097677021 [label="Alors, parle-lui de tes inquiétudes. Il t'écoutera. Ce n'est pas un enfant. ",shape=box,color=blue];
		j3097677021 -> j3077784977;
	j4033351312 [label="+20 Chemistry",color=orange];
