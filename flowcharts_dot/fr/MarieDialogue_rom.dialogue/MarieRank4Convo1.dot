		j1789663328 -> j2767069790;
	j2070272940 [label="Il faut apprendre à lire entre les lignes, n'est-ce pas? Il parle en histoires. En paraboles. S'il se tait, écoute ses actions.",shape=box,color=blue];
		j2070272940 -> j1539440762;
	j1539440762 [label="Mais tu te soucies de lui, tu veux l'aider – et je suis sûre qu'il le sait. Ah! Voilà. Il est comme un chien errant, avec une cicatrice à la patte. Elle est guérie, mais mal guérie. Alors, ça lui fait encore mal et ça le démange.",shape=box,color=blue];
		j1539440762 -> j2613166422;
	j1501902887 [label="Attends, je ne voulais pas que tu t'en mêles!",shape=box,color=red];
		j1501902887 -> j531535760;
	j3862493966 [label="Dois-je m’inquiéter?",shape=box,color=red];
		j3862493966 -> j531535760;
	j1050395980 [label="Je ne dirais pas non à un peu d'aide.",shape=box,color=red];
		j1050395980 -> j716997773;
	j3077784977 [label="Il est comme un chien errant, avec une cicatrice à la patte. Elle est guérie, mais mal cicatrisée. Du coup, il souffre encore et il a des démangeaisons.",shape=box,color=blue];
		j3077784977 -> j2613166422;
	j599030248 [label="Merci. C'est tout ce que je peux demander. À bientôt.",shape=box,color=blue];
		j599030248 -> "Chat ends.";
