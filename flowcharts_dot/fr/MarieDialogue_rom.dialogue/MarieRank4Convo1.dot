	j3332036563 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j3332036563 -> j3563111440;
	j478775329 [label="J'ai peur qu'il ait... pris possession de mon cœur et cela me brise de savoir qu'il souffre.",shape=box,color=red];
		j478775329 -> j1305627192;
	j640367195 [label="La douleur qu'il ressent est plus profonde que celle qu'il inflige à sa chair. Ce qu'il s'inflige maintenant, il ne peut plus s'en remettre.",shape=box,color=blue];
		j640367195 -> j4102702308;
	j1819253760 [label="Oh! Je ne savais pas, je suis vraiment désolée... Les platitudes et les prières pathétiques que je pourrais t'offrir seraient vaines, j'en suis certaine,",shape=box,color=blue];
		j1819253760 -> j3255616924;
	j3563111440 [label="+20 Chemistry",color=orange];
		j3563111440 -> j955479460;
	j1305627192 [label="+20 Chemistry",color=orange];
		j1305627192 -> j696201337;
	j4102702308 [label="Cela lui éclaircit l'esprit, apaise son âme. Et maintenant, en tant que protoframe – en partie ce Harrow, ou Wisp me concernant... cela ne le tuera pas, hein? ",shape=box,color=blue];
		j4102702308 -> j1838208669;
		j4102702308 -> j3527729876;
	j3255616924 [label="- car quelles condoléances pourrait donner quelqu'un que l'on connaît à peine, qui pourraient servir de baume à une tragédie pareille?",shape=box,color=blue];
		j3255616924 -> j1398699571;
	j955479460 [label="Et pour cela, je ne peux pas t'adorer davantage. Mais l'aide peut prendre bien des formes, non?",shape=box,color=blue];
		j955479460 -> j4083236062;
	j696201337 [label="Oh!! Je viens de crier comme si j'avais vu une souris et fait sursauter Monsieur Loid! Pardon!!",shape=box,color=blue];
		j696201337 -> j3042933877;
	j1838208669 [label="Non, ça ne le tuera pas. Mais ce n'est toujours pas suffisant.",shape=box,color=red];
		j1838208669 -> j4177034005;
	j3527729876 [label="Je vois ce que tu veux dire.",shape=box,color=red];
		j3527729876 -> j2812288536;
	j1398699571 [label="Cette âme perdue dont tu parles... était-elle proche de toi?",shape=box,color=blue];
		j1398699571 -> j2893732477;
		j1398699571 -> j3819615742;
	j4083236062 [label="Aider un oisillon peut le tuer. Aider la flamme d'une bougie peut l'éteindre.",shape=box,color=blue];
		j4083236062 -> j366159499;
	j3042933877 [label="Oh, mais c'est une si merveilleuse nouvelle!",shape=box,color=blue];
		j3042933877 -> j268858616;
		j3042933877 -> j1097505428;
	j4177034005 [label="J'ai découvert qu'être à ses côtés quand il a besoin de moi... l'écouter, le tenir dans mes bras quand il pleure?",shape=box,color=blue];
