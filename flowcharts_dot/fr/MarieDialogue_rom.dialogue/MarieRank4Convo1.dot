	j3819615742 [label="Pas vraiment.",shape=box,color=red];
		j3819615742 -> j2105258132;
	j366159499 [label="J'ai découvert qu'être à ses côtés quand il a besoin de moi... l'écouter, simplement m'asseoir à ses côtés quand il pleure?",shape=box,color=blue];
		j366159499 -> j1442835569;
	j268858616 [label="Vraiment? Je ne savais pas ce que tu en penserais.",shape=box,color=red];
		j268858616 -> j315330587;
