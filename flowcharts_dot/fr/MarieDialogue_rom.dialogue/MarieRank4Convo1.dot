		j1434576721 -> j2997740681;
	j359086920 [label="Boolean LyonPainResolved is now true.",color=orange];
		j359086920 -> j2997740681;
	j3330919325 [label="Ah, c'est comme parler à une statue de marbre, non? Je comprends ce que tu ressens. Il m'est souvent arrivé de me retrouver plongée dans une histoire pendant vingt minutes avant de me rendre compte qu'il ne m'écoutait pas.",shape=box,color=blue];
		j3330919325 -> j2163450147;
	j3976493188 [label="Oui, je comprends. Mais parfois, on ne peut pas faire grand-chose, si ce n'est être là pour les autres quand et comme ils le souhaitent.",shape=box,color=blue];
		j3976493188 -> j1751438847;
	j4216152575 [label="Fais preuve de patience et de gentillesse avec lui et je t'en supplie, ne lui fais pas de mal, hein?",shape=box,color=blue];
		j4216152575 -> j1953831990;
	j1739814361 [label="Il faut apprendre à lire entre les lignes, n'est-ce pas? Il parle en histoires. En paraboles. S'il se tait, écoute ses actions.",shape=box,color=blue];
		j1739814361 -> j4216152575;
	j742415391 [label="Je ne pense toujours pas que ce soit correct.",shape=box,color=red];
		j742415391 -> j3097677021;
	j87785775 [label="Je ferai ce que je peux.",shape=box,color=red];
		j87785775 -> j4033351312;
	j2997740681 [label="Bien sûr... Puis-je te raconter l'histoire de quelqu'un que j'ai connu et qui a fait la même chose? Ou préfères-tu qu'on arrête là?",shape=box,color=blue];
		j2997740681 -> j2172670640;
		j2997740681 -> j1355973153;
