	j3099534029 [label="[Désactiver toutes les conversations sur l'automutilation. Vous ne perdrez aucun point d'alchimie avec aucun personnage.]",shape=box,color=red];
		j3099534029 -> j2128610492;
	j632421939 [label="Je ne sais pas si je préférerais que ses visions soient réelles ou fausses, honnêtement.",shape=box,color=red];
		j632421939 -> j1568765685;
	j1448988544 [label="En parlant de toutes les choses terribles qu'il voit. Les descriptions...",shape=box,color=red];
		j1448988544 -> j1568765685;
	j1232931300 [label="Qu'il puisse un jour se faire du mal au-delà du point de non-retour?",shape=box,color=red];
		j1232931300 -> j3012791207;
	j688960210 [label="Te sens-tu parfois en danger en sa présence? As-tu parfois l'impression qu'il pourrait te faire du mal sans s'en rendre compte?",shape=box,color=red];
		j688960210 -> j884134298;
	j2128610492 [label="Boolean LyonPainOff is now true.",color=orange];
		j2128610492 -> j3630095584;
	j1568765685 [label="+5 Chemistry",color=orange];
		j1568765685 -> j55623053;
	j3012791207 [label="Ah... c’est un sujet délicat, n’est-ce pas? Pardon, mais je ne sais pas trop comment en parler facilement.",shape=box,color=blue];
		j3012791207 -> j1989508950;
	j884134298 [label="Je crois que Lyon se suiciderait plutôt que de me faire du mal. Je crois fermement -.",shape=box,color=blue];
		j884134298 -> j1918681817;
	j3630095584 [label="+20 Chemistry",color=orange];
		j3630095584 -> j4024551328;
	j55623053 [label="Les cauchemars qui remplissent son esprit - Lua le guide sur un chemin difficile, non?",shape=box,color=blue];
		j55623053 -> j2585665968;
	j1989508950 [label="Mais je ferai de mon mieux. Je suppose que tu demandes ça parce que tu te soucies de lui?",shape=box,color=blue];
		j1989508950 -> j4222190272;
		j1989508950 -> j3093126751;
	j1918681817 [label="- que même ton Indifférence ne pourrait pas le conduire à lever la main sur moi.",shape=box,color=blue];
		j1918681817 -> j578141061;
	j4024551328 [label="[Cela permettra de contourner toutes les conversations concernant l’automutilation.]",shape=box,color=blue];
		j4024551328 -> "Chat ends.";
	j2585665968 [label="C'est difficile d'en parler, je le crains. Car je sais que c'est quelque chose qui ne devrait pas être, n'est-ce pas?",shape=box,color=blue];
		j2585665968 -> j3399807219;
	j4222190272 [label="La Warframe dont il a reçu le sérum est connue pour... eh bien...",shape=box,color=red];
		j4222190272 -> j3645956818;
		j4222190272 -> j559059496;
		j4222190272 -> j2997636116;
	j3093126751 [label="C'est assez évident, à le voir... sans vouloir offenser personne. Ce n'était pas difficile à deviner.",shape=box,color=red];
		j3093126751 -> j3645956818;
		j3093126751 -> j559059496;
		j3093126751 -> j2997636116;
	j578141061 [label="Je pourrais craindre qu'un papillon me dévore avant d'avoir peur du frère de mon âme.",shape=box,color=blue];
		j578141061 -> j2585665968;
	j3399807219 [label="Je voudrais l'arrêter, le protéger de son désir de se faire du mal.",shape=box,color=blue];
		j3399807219 -> j2716870820;
	j3645956818 [label="Je crains juste qu’il aille trop loin, un jour.",shape=box,color=red];
		j3645956818 -> j2585665968;
	j559059496 [label="Nous avons besoin de lui en un seul morceau.",shape=box,color=red];
		j559059496 -> j2136221875;
	j2997636116 [label="Je ne veux pas m'inquiéter d'avoir à laver son cadavre.",shape=box,color=red];
		j2997636116 -> j698283448;
	j2716870820 [label="S'il y a une chose que je sais de Lyon, c'est qu'il sera toujours là quand on aura besoin de lui.",shape=box,color=blue];
		j2716870820 -> j345394762;
	j2136221875 [label="Tu fais écho aux paroles du diable. Est-ce seulement le besoin cruel de mains expertes qui t'inspire?",shape=box,color=blue];
		j2136221875 -> j3735548262;
		j2136221875 -> j335391676;
	j698283448 [label="Dégoûtant.",shape=box,color=blue];
		j698283448 -> j1508231473;
	j345394762 [label="C'est le grand protecteur, le bouclier sacré de Lua... La lumière brillante dans l'obscurité de la nuit.",shape=box,color=blue];
		j345394762 -> j1573052119;
	j3735548262 [label="Non, je tiens beaucoup à lui. J'ai juste peur qu'il ne soit pas là quand on aura besoin de lui.",shape=box,color=red];
		j3735548262 -> j2716870820;
	j335391676 [label="J'ai juste besoin de savoir si je peux compter sur lui ou s'il est déjà trop brisé.",shape=box,color=red];
		j335391676 -> j1499622543;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j1573052119 [label="La douleur qu'il s'inflige... il le fait pour entendre ses propres pensées, pour ressentir son propre corps. ",shape=box,color=blue];
		j1573052119 -> j4191024047;
	j1499622543 [label="Je me demande qui t'aidera quand tu seras au plus bas et que tu auras besoin d'un coup de main.",shape=box,color=blue];
		j1499622543 -> j67153633;
	j4191024047 [label="Car le ciel est rempli d'étoiles et chacune d'elles lui murmure quelque chose et lui, comme Lua elle-même, se perd parmi elles.",shape=box,color=blue];
		j4191024047 -> j3002304561;
	j67153633 [label="Ou crois-tu que le temps est déjà passé et que tu es désormais au-dessus de tout reproche?",shape=box,color=blue];
		j67153633 -> j698283448;
	j3002304561 [label="Et comme Lua, il traverse ses phases. Consumé par le Néant, il brille si fort que nous pouvons tous marcher dans les ténèbres sans crainte.",shape=box,color=blue];
		j3002304561 -> j443558727;
	j443558727 [label="Mais comme toute bénédiction, cela s'accompagne d'une malédiction. Tu me suis? J'ai peur de divaguer.",shape=box,color=blue];
		j443558727 -> j2948216412;
		j443558727 -> j2425703910;
		j443558727 -> j873162115;
		j443558727 -> j4235442903;
		j443558727 -> j2900829324;
	j2948216412 [label="Je comprends parfaitement. Et j'ai... une petite confession à faire. [Avouer vos sentiments pour Lyon.]",shape=box,color=red];
		j2948216412 -> j809646096;
	j2425703910 [label="Je comprends ce que tu dis, mais je ne peux pas tolérer qu'il se fasse du mal. Il devrait arrêter.",shape=box,color=red];
		j2425703910 -> j1838206940;
	j873162115 [label="[Attention: Discussion sur le suicide.] J'ai perdu quelqu'un une fois, à cause de ce genre d'automutilation. Je ne peux pas... Je ne peux pas cautionner ça.",shape=box,color=red];
		j873162115 -> j375341272;
	j4235442903 [label="Il doit y avoir un autre moyen.",shape=box,color=red];
		j4235442903 -> j3332036563;
	j2900829324 [label="Tu as tout à fait raison. J'aimerais juste pouvoir l'aider.",shape=box,color=red];
