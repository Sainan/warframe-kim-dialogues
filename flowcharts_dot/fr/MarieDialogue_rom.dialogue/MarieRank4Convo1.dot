		j1097505428 -> j1281797756;
	j2875559136 [label="Cela l'aide plus que de lui parler de ce qu’il devrait ou ne devrait pas faire.",shape=box,color=blue];
		j2875559136 -> j3867417855;
	j3177214687 [label="Est-ce pour cela que tu veux que Lyon ne subisse pas le même sort? Ou est-ce simplement le sujet lui-même qui te contrarie?",shape=box,color=blue];
		j3177214687 -> j3813265950;
		j3177214687 -> j3027001424;
	j2105258132 [label="Et pourtant, connaître quelqu'un qui se sent piégé au point de penser qu'il n'y a qu'une seule façon de s'échapper... ",shape=box,color=blue];
		j2105258132 -> j3177214687;
	j1442835569 [label="Cela l'aide plus que de lui parler de ce qu’il devrait ou ne devrait pas faire.",shape=box,color=blue];
		j1442835569 -> j796965987;
		j1442835569 -> j3354406720;
		j1442835569 -> j2564761449;
	j315330587 [label="Oh, je suis folle de joie. Tellement ravie! Lyon a tellement besoin d'amour - Tu n'imagines pas!",shape=box,color=blue];
		j315330587 -> j1124797565;
	j1281797756 [label="Ah, c'est comme parler à une statue de marbre, non? Je comprends ce que tu ressens. Il m'est souvent arrivé de me retrouver plongée dans une histoire pendant vingt minutes avant de me rendre compte qu'il ne m'écoutait pas.",shape=box,color=blue];
		j1281797756 -> j3576569269;
	j3867417855 [label="Il faut apprendre à lire entre les lignes, n'est-ce pas? Il parle en histoires. En paraboles. S'il se tait, écoute ses actions.",shape=box,color=blue];
		j3867417855 -> j2633767376;
	j3813265950 [label="Je... préfère éviter le sujet, s’il te plaît. Je ne peux pas. ",shape=box,color=red];
		j3813265950 -> j1434576721;
	j3027001424 [label="Je veux avoir la certitude que Lyon ne souffre pas...",shape=box,color=red];
		j3027001424 -> j359086920;
	j796965987 [label="Je ferai tout mon possible pour suivre ton conseil. Je ne sais juste pas comment l'atteindre.",shape=box,color=red];
		j796965987 -> j3330919325;
	j3354406720 [label="Je ferai ce que je peux, j'aimerais juste pouvoir faire plus.",shape=box,color=red];
		j3354406720 -> j3976493188;
	j2564761449 [label="Il peut être... frustrant.",shape=box,color=red];
		j2564761449 -> j3330919325;
	j1124797565 [label="Ah, peut-être que si. Il souffre tellement, comme tu peux le constater, malgré les apparences...",shape=box,color=blue];
		j1124797565 -> j4216152575;
	j3576569269 [label="Perdu à nouveau dans les méandres de son esprit ou prêtant attention à un autre esprit dans la pièce.",shape=box,color=blue];
		j3576569269 -> j1739814361;
	j2633767376 [label="Fais preuve de patience et de gentillesse avec lui et je t'en supplie, ne lui fais pas de mal, hein?",shape=box,color=blue];
