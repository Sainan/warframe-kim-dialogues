		j2767069790 -> j4220843226 [label=true,color=green];
		j2767069790 -> j4241856109 [label=false,color=brown];
	j2613166422 [label="Il ronge sa jambe et même si cela rouvre la plaie et lui fait mal, cela lui apporte également du soulagement.",shape=box,color=blue];
		j2613166422 -> j3843411507;
	j531535760 [label="Hah! Il est trop tard pour ça, maintenant. Marie, au travail! Il y a de l'amour dans l'air!",shape=box,color=blue];
		j531535760 -> "Chat ends.";
	j716997773 [label="Oui! Et tu ne pourrais pas m'en empêcher, même si tu le voulais. Marie, au travail!",shape=box,color=blue];
		j716997773 -> "Chat ends.";
	j2405146344 [label="Oui, bien sûr. À bientôt.",shape=box,color=blue];
		j2405146344 -> "Chat ends.";
	j1411978194 [label="Oui, bien sûr.",shape=box,color=blue];
		j1411978194 -> j3077784977;
	j4220843226 [label="Tu sais comment mon histoire a commencé, mais il y a une partie que je ne t'ai pas racontée.",shape=box,color=blue];
		j4220843226 -> j2148833609;
	j4241856109 [label="Boolean MarieBackstory1 is now true.",color=orange];
		j4241856109 -> j217925990;
	j3843411507 [label="Cela lui fait du mal, mais cela fait partie de lui malgré tout. Et si tu l'approches avec colère, si tu es busque, il prendra ses distances.",shape=box,color=blue];
		j3843411507 -> j1503142056;
	j2148833609 [label="Je t'ai dit que j'étais une mendiante dans la rue quand j'étais petite. Et que je me débrouillais bien et que j'avais beaucoup d'amis.",shape=box,color=blue];
		j2148833609 -> j914225824;
	j217925990 [label="Je suis née dans une famille riche, ce qui pourrait te surprendre. La classe bourgeoise, qui se rapproche davantage des Orokins.",shape=box,color=blue];
		j217925990 -> j62770781;
	j1503142056 [label="Il faut gagner la confiance du chien errant. Laisse-le venir à toi, d'accord? Est-ce que ça a du sens?",shape=box,color=blue];
		j1503142056 -> j1008262606;
		j1503142056 -> j1894907169;
		j1503142056 -> j3928623304;
	j914225824 [label="L’un d’eux était un grand garçon plus âgé nommé Hugo.",shape=box,color=blue];
		j914225824 -> j2908609674;
	j62770781 [label="Mais quand je suis née... déformée, avec mes pieds tordus et inutilisables? Oh, ma mère ne pouvait pas supporter ça.",shape=box,color=blue];
		j62770781 -> j3812236669;
	j1008262606 [label="Oui, en effet. Merci.",shape=box,color=red];
		j1008262606 -> j960929222;
	j1894907169 [label="Plus que ce que ça ne devrait, merci.",shape=box,color=red];
		j1894907169 -> j561538179;
	j3928623304 [label="Aucun. Mais merci d'avoir essayé.",shape=box,color=red];
		j3928623304 -> j3852102697;
	j2908609674 [label="Il était un peu le chef de meute. Il veillait toujours à ce que personne ne s'en prenne à moi et que j'aie tout ce dont j'avais besoin.",shape=box,color=blue];
		j2908609674 -> j1414566995;
	j3812236669 [label="Il fallait sauver les apparences, n'est-ce pas? Des normes à respecter.",shape=box,color=blue];
		j3812236669 -> j531841940;
	j960929222 [label="Bien! J'avais peur de laisser mes métaphores m'échapper à nouveau.",shape=box,color=blue];
		j960929222 -> j698853382;
	j561538179 [label="Marie et ses métaphores. Ah, bon.",shape=box,color=blue];
		j561538179 -> j698853382;
	j3852102697 [label="Mince, alors. Je savais que j'avais encore laissé mes métaphores m'échapper.",shape=box,color=blue];
		j3852102697 -> j698853382;
	j1414566995 [label="Il m'a même aidée à construire des béquilles que je pouvais utiliser pour me traîner, avec des morceaux de bois récupérés.",shape=box,color=blue];
		j1414566995 -> j1179345684;
	j531841940 [label="Alors, que faire de la pauvre Marie malformée? On m'a emmenée à la Cité de la Lumière, où j'ai été laissée dans la rue...",shape=box,color=blue];
		j531841940 -> j1781289586;
	j698853382 [label="Hum. Il me vient à l'esprit que décrire Lyon comme un chien errant n'est peut-être pas la comparaison la plus flatteuse à faire...",shape=box,color=blue];
		j698853382 -> j3120462607;
	j1179345684 [label="Un matin, nous sommes allés le réveiller et nous l'avons trouvé -",shape=box,color=blue];
		j1179345684 -> j692321334;
	j1781289586 [label="Et abandonnée à la mort.",shape=box,color=blue];
		j1781289586 -> j422450780;
		j1781289586 -> j2517994212;
	j3120462607 [label="Évite peut-être de lui dire, oui...?",shape=box,color=blue];
		j3120462607 -> j1672678032;
	j692321334 [label="Je... Je t'épargne les détails... Je suis sûre que tu as deviné.",shape=box,color=blue];
		j692321334 -> j3524609429;
	j422450780 [label="Quel âge avais-tu?",shape=box,color=red];
		j422450780 -> j1338570055;
	j2517994212 [label="Ta famille t'a laissée pour morte?",shape=box,color=red];
		j2517994212 -> j1096966832;
	j1672678032 [label="Boolean LyonStrayDog is now true.",color=orange];
		j1672678032 -> j2661412067;
		j1672678032 -> j3167257586;
	j3524609429 [label="Mais il nous avait laissé un mot. Il était à peine lisible. Il était le seul des autres enfants à connaître ses lettres, donc j'ai dû le lire aux autres. ",shape=box,color=blue];
		j3524609429 -> j1611042940;
	j1338570055 [label="Six ans? Sept ans? À leurs yeux, ils avaient fait de leur mieux pour me soigner pendant des années. Des tuteurs pour m'apprendre à marcher. Des appareils orthopédiques. Des chaussures.",shape=box,color=blue];
		j1338570055 -> j227692394;
	j1096966832 [label="À leurs yeux, ils avaient fait de leur mieux pour me soigner pendant des années. Des tuteurs pour m'apprendre à marcher. Des appareils orthopédiques. Des chaussures.",shape=box,color=blue];
		j1096966832 -> j227692394;
	j2661412067 [label="Je pense que c'est adorable et il sera aussi de cet avis.",shape=box,color=red];
		j2661412067 -> j3764879957;
	j3167257586 [label="Ton secret est en sécurité avec moi.",shape=box,color=red];
		j3167257586 -> j2628847701;
	j1611042940 [label="Je me souviens encore de ma voix étranglée. Mais je devais rester forte. Car même à ce moment-là, je savais que j'avais un devoir envers les autres. ",shape=box,color=blue];
		j1611042940 -> j2710132034;
	j227692394 [label="Ils étaient fatigués de ce fardeau. Alors, à peine capable de lire et d'écrire mes chiffres et mes lettres, je me suis retrouvée dans la boue.",shape=box,color=blue];
		j227692394 -> j2507109264;
		j227692394 -> j666950900;
	j3764879957 [label="Quelle horrible personne! J'espère que ta chaise va se casser et que tu auras plein d'échardes dans le derrière!",shape=box,color=blue];
		j3764879957 -> "Chat ends.";
	j2628847701 [label="Merci! Quel soulagement...",shape=box,color=blue];
		j2628847701 -> "Chat ends.";
	j2710132034 [label="Hugo nous avait toujours semblé si heureux, me disaient-ils. Si heureux. Il abordait toujours la vie avec un rire ou un ricanement.",shape=box,color=blue];
		j2710132034 -> j4234886902;
	j2507109264 [label="C'est horrible.",shape=box,color=red];
		j2507109264 -> j714426695;
	j666950900 [label="Comment as-tu survécu?",shape=box,color=red];
		j666950900 -> j714426695;
	j4234886902 [label="Même quand on nous chassait ou qu'on le battait à coups de bâton pour vol ou vagabondage, cela ne semblait pas le déranger.",shape=box,color=blue];
		j4234886902 -> j1397205724;
	j714426695 [label="Check boolean MarieSecretPower",color=orange];
		j714426695 -> j1935799001 [label=true,color=green];
		j714426695 -> j414002042 [label=false,color=brown];
	j1397205724 [label="Mais on ne connaît jamais la profondeur de la douleur que les autres ressentent. Et dans cette lettre, je savais qu'il pleurait avec Lua.",shape=box,color=blue];
		j1397205724 -> j3477362557;
	j1935799001 [label="C'est comme tu l'as dit, non? Tous les inconvénients ont un pouvoir secret.",shape=box,color=blue];
		j1935799001 -> j414002042;
	j414002042 [label="Ce qui a fait de moi une indésirable pour ma mère, m'a rendue très populaire parmi les autres enfants des rues.",shape=box,color=blue];
		j414002042 -> j345625003;
	j3477362557 [label="Mais il était désormais en paix à ses côtés. Pendant un temps, je lui en ai voulu d'être parti. Car les autres comptaient sur moi pour les guider. Et je lui en ai voulu de m'avoir abandonnée.",shape=box,color=blue];
		j3477362557 -> j3739148614;
	j345625003 [label="Quoi de plus pathétique qu'un enfant sans pieds, hein? Je pouvais gagner plus en un jour, la main tendue, qu'ils ne pouvaient voler en une semaine.",shape=box,color=blue];
		j345625003 -> j2564760280;
	j3739148614 [label="Mais au fil du temps, j’ai fini par comprendre.",shape=box,color=blue];
		j3739148614 -> j3781970840;
	j2564760280 [label="Et j'avais toujours l'habitude de partager. J'avais donc beaucoup d'amis qui veillaient sur moi et prenaient soin de moi. L'un d'eux était un grand garçon nommé Hugo.",shape=box,color=blue];
		j2564760280 -> j2908609674;
	j3781970840 [label="Nous ne pouvons que nous pardonner d'être humains. Et nous pardonner la douleur de leur départ.",shape=box,color=blue];
		j3781970840 -> j960955870;
	j960955870 [label="Car c'est leur absence qui nous fait mal, et l'idée que nous n'avons pas pu en faire plus pour les aider.",shape=box,color=blue];
		j960955870 -> j291756273;
	j291756273 [label="Nous ne connaissons jamais les fardeaux que portent les autres.",shape=box,color=blue];
		j291756273 -> j4176728338;
	j4176728338 [label="Et c'est une grande tragédie. Mais c'est ce que signifie être humain.",shape=box,color=blue];
		j4176728338 -> j1165294784;
	j1165294784 [label="Je ne sais pas si cette histoire t'a été utile. Mais je ne peux que prier pour que ce soit le cas. Je dois y aller, Monsieur Loid m'appelle.",shape=box,color=blue];
		j1165294784 -> j618348595;
		j1165294784 -> j1678723274;
	j618348595 [label="Merci, Marie.",shape=box,color=red];
		j618348595 -> j1428564033;
	j1678723274 [label="[Garder le silence.]",shape=box,color=red];
		j1678723274 -> j3386425480;
	j1428564033 [label="+20 Chemistry",color=orange];
		j1428564033 -> j1176983651;
	j3386425480 [label="+20 Chemistry",color=orange];
		j3386425480 -> j1123121321;
	j1176983651 [label="Avec plaisir. À bientôt.",shape=box,color=blue];
		j1176983651 -> "Chat ends.";
	j1123121321 [label="À la revoyure.",shape=box,color=blue];
		j1123121321 -> "Chat ends.";
}