	j3450682360 [label="Marie? Ai-je fait quelque chose qui a offensé Lyon?",shape=box,color=red];
		j3450682360 -> j741884570;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j741884570 [label="Hein? Pourquoi? Oh... parce qu'il ne t'a pas encore écrit sur ce gadget?",shape=box,color=blue];
		j741884570 -> j1852723546;
		j741884570 -> j150908996;
		j741884570 -> j1886493709;
	"Chat ends." [color=orange];
	j1852723546 [label="Il ne sait pas comment faire?",shape=box,color=red];
		j1852723546 -> j1632945993;
	j150908996 [label="Est-il technophobe?",shape=box,color=red];
		j150908996 -> j3458525147;
	j1886493709 [label="Bon. Je me suis dit que si toi et Roathe étiez tous les deux ici...",shape=box,color=red];
		j1886493709 -> j1048883384;
	j1632945993 [label="Ha! Il n'y a pas plus rapide que lui pour apprendre, Voyageur! À ta place, j'éviterais de le défier à des jeux d'argent.",shape=box,color=blue];
		j1632945993 -> j1048883384;
	j3458525147 [label="Non, il excelle avec les nouveautés. Je ne serais pas surprise qu'il ait déjà étudié les machines ambulantes rôdant en bas et qu'il partagera bientôt ses propres projets.",shape=box,color=blue];
		j3458525147 -> j1048883384;
	j1048883384 [label="C'est simplement qu'il ne te connaît pas. Lyon n'est pas... sociable, même dans les meilleures circonstances. Je ne veux pas t'offenser.",shape=box,color=blue];
		j1048883384 -> j3027869271;
		j1048883384 -> j1707698285;
	j3027869271 [label="Y a-t-il quelque chose que tu puisses faire?",shape=box,color=red];
		j3027869271 -> j3726824049;
	j1707698285 [label="Ah ben, au moins, ce n'est pas de ma faute...",shape=box,color=red];
		j1707698285 -> j4166112220;
	j3726824049 [label="Lyon a... beaucoup de choses en tête. Il ne partage pas cela avec tout le monde.",shape=box,color=blue];
		j3726824049 -> j2274176491;
	j4166112220 [label="+5 Chemistry",color=orange];
		j4166112220 -> j2799381732;
	j2274176491 [label="+15 Chemistry",color=orange];
		j2274176491 -> j1327077387;
	j2799381732 [label="Non, non, non, ce n'est pas toi. Lyon a... beaucoup de choses en tête. Il ne partage pas cela avec tout le monde.",shape=box,color=blue];
		j2799381732 -> j2274176491;
	j1327077387 [label="Cela prendra du temps. Et de la patience.",shape=box,color=blue];
		j1327077387 -> j3014157251;
	j3014157251 [label="Ah! Je dois y aller. On se parle bientôt.",shape=box,color=blue];
		j3014157251 -> "Chat ends.";
}