digraph {
	57 [label="MarieRank1Convo2 begins.",color=orange];
		57 -> 59;
		57 -> 58;
	59 [label="Marie? Ai-je fait quelque chose qui a offensé Lyon?",shape=box,color=red];
		59 -> 61;
	58 [label="[Fin.]",shape=box,color=red];
		58 -> 60;
	61 [label="Hein? Pourquoi? Oh... parce qu'il ne t'a pas encore écrit sur ce gadget?",shape=box,color=blue];
		61 -> 62;
		61 -> 63;
		61 -> 64;
	60 [label="Chat ends.",color=orange];
	62 [label="Il ne sait pas comment faire?",shape=box,color=red];
		62 -> 65;
	63 [label="Est-il technophobe?",shape=box,color=red];
		63 -> 66;
	64 [label="Bon. Je me suis dit que si toi et Roathe étiez tous les deux ici...",shape=box,color=red];
		64 -> 67;
	65 [label="Ha! Il n'y a pas plus rapide que lui pour apprendre, Voyageur! À ta place, j'éviterais de le défier à des jeux d'argent.",shape=box,color=blue];
		65 -> 67;
	66 [label="Non, il excelle avec les nouveautés. Je ne serais pas surprise qu'il ait déjà étudié les machines ambulantes rôdant en bas et qu'il partagera bientôt ses propres projets.",shape=box,color=blue];
		66 -> 67;
	67 [label="C'est simplement qu'il ne te connaît pas. Lyon n'est pas... sociable, même dans les meilleures circonstances. Je ne veux pas t'offenser.",shape=box,color=blue];
		67 -> 68;
		67 -> 69;
	68 [label="Y a-t-il quelque chose que tu puisses faire?",shape=box,color=red];
		68 -> 70;
	69 [label="Ah ben, au moins, ce n'est pas de ma faute...",shape=box,color=red];
		69 -> 71;
	70 [label="Lyon a... beaucoup de choses en tête. Il ne partage pas cela avec tout le monde.",shape=box,color=blue];
		70 -> 72;
	71 [label="+5 Chemistry",color=orange];
		71 -> 73;
	72 [label="+15 Chemistry",color=orange];
		72 -> 74;
	73 [label="Non, non, non, ce n'est pas toi. Lyon a... beaucoup de choses en tête. Il ne partage pas cela avec tout le monde.",shape=box,color=blue];
		73 -> 72;
	74 [label="Cela prendra du temps. Et de la patience.",shape=box,color=blue];
		74 -> 75;
	75 [label="Ah! Je dois y aller. On se parle bientôt.",shape=box,color=blue];
		75 -> 76;
	76 [label="Chat ends.",color=orange];
}