		3555 -> 3558;
	3556 [label="Merci. Bon, je n'ai plus envie de l'être. Je vais faire quelque chose de plus joyeux! Je crois que l'aquarium de Monsieur Fibonacci a besoin d'un petit coup de chiffon.",shape=box,color=blue];
		3556 -> 3559;
	3557 [label="Ah! Merci. Voilà qui va certainement faire sécher mes larmes idiotes. Tu sais comment réconforter la petite Marie, n'est-ce pas?",shape=box,color=blue];
		3557 -> 3560;
		3557 -> 3561;
	3558 [label="Oui, tu as tout à fait raison. C'est vrai. Le monde regorge d'histoires comme celle de Monsieur Otak et bien d'autres pires encore. Je ne devrais pas m'apitoyer sur son sort. ",shape=box,color=blue];
