	3540 [label="Car si tu te trompes et qu'une âme reste enfermée dans cette cage contre son gré?",shape=box,color=blue];
		3540 -> 3543;
	3541 [label="Ou bien, s'il y a une présence quelconque là-dedans, que ce soit parce qu'il reste de son plein gré, comme une sorte de veillée solitaire.",shape=box,color=blue];
		3541 -> 3544;
	3542 [label="Penser autrement suffit à remettre en question la bonté des dieux, n'est-ce pas?",shape=box,color=blue];
		3542 -> 3545;
	3543 [label="Il y a de quoi se demander si les dieux sont réellement bienveillants, n'est-ce pas?",shape=box,color=blue];
		3543 -> 3545;
	3544 [label="Penser autrement suffit à remettre en question la bonté des dieux, n'est-ce pas?",shape=box,color=blue];
