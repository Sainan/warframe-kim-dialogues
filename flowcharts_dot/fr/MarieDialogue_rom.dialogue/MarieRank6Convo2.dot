		j3979133402 -> j1041209914 [label=true,color=green];
		j3979133402 -> j756766914 [label=false,color=brown];
	j1331824115 [label="Loup! Mon loup! J'ai rencontré Otak! Je l'ai enfin rencontré!",shape=box,color=blue];
		j1331824115 -> j29133482;
		j1331824115 -> j2819326148;
	j272942677 [label="J'ai rencontré Otak! Je l'ai enfin rencontré!",shape=box,color=blue];
		j272942677 -> j29133482;
		j272942677 -> j2819326148;
	j1041209914 [label="Loup! Mon loup! Le visage sur le dos de Monsieur Necraloid! Je l'ai enfin rencontré!",shape=box,color=blue];
		j1041209914 -> j437841105;
		j1041209914 -> j3246211643;
		j1041209914 -> j1669544776;
	j756766914 [label="Le visage au dos de Monsieur Necraloid! Je l'ai enfin rencontré!",shape=box,color=blue];
		j756766914 -> j437841105;
		j756766914 -> j3246211643;
		j756766914 -> j1669544776;
	j29133482 [label="As-tu apprécié ta conversation avec lui?",shape=box,color=red];
		j29133482 -> j2224055411;
	j2819326148 [label="Comment s'est passée ta conversation avec lui?",shape=box,color=red];
		j2819326148 -> j1882105016;
	j437841105 [label="Pauvre Otak... Comment ça s'est passé?",shape=box,color=red];
		j437841105 -> j254414918;
	j3246211643 [label="C'est chouette que vous vous soyez enfin rencontrés. Otak peut être un peu difficile à expliquer.",shape=box,color=red];
		j3246211643 -> j708563687;
	j1669544776 [label="Tu as rencontré Otak? Oh là là... Comment ça s'est passé?",shape=box,color=red];
		j1669544776 -> j2592292738;
	j2224055411 [label="Oui. Même si j'avais peut-être envie de pleurer. Car il s'est présenté à moi trois fois au cours de la même conversation, comme si nous ne nous étions jamais rencontrés.",shape=box,color=blue];
		j2224055411 -> j34076535;
	j1882105016 [label="Il... s’est présenté à moi à trois reprises au cours de la même conversation, comme si nous ne nous étions jamais rencontrés.",shape=box,color=blue];
		j1882105016 -> j34076535;
	j254414918 [label="Je l'ai trouvé adorable et charmant! Mais sous une couche d'humour, je ressentais un profond chagrin.",shape=box,color=blue];
		j254414918 -> j1819637436;
	j708563687 [label="Oui, je le pense aussi. Un gribouillage d'enfant dans le dos d'un automate. Je l'ai trouvé tout simplement adorable et charmant!",shape=box,color=blue];
		j708563687 -> j2043135347;
	j2592292738 [label="Tu n'as pas l'air d'apprécier que je l'aie rencontré?",shape=box,color=blue];
		j2592292738 -> j2414601160;
		j2592292738 -> j2148387060;
		j2592292738 -> j529902607;
	j34076535 [label="Il m’a saluée avec la même assurance et la même gaieté à chaque fois. Mais il me connaissait comme un Sœur de Sol! ",shape=box,color=blue];
		j34076535 -> j2044490891;
	j1819637436 [label="Veux-tu me raconter l'histoire du pauvre Monsieur Otak?",shape=box,color=blue];
		j1819637436 -> j859297516;
	j2043135347 [label="Mais sous cette façade humoristique se cache un profond chagrin.",shape=box,color=blue];
		j2043135347 -> j1819637436;
	j2414601160 [label="Il peut parfois m'agacer, c'est tout. ",shape=box,color=red];
		j2414601160 -> j1079479208;
	j2148387060 [label="Ce n'est pas ce que je voulais dire. Il peut être un peu... agaçant pour certaines personnes.",shape=box,color=red];
		j2148387060 -> j872051211;
	j529902607 [label="Pardon. Il peut parfois être agaçant. Ce n'est pas de sa faute.",shape=box,color=red];
		j529902607 -> j872051211;
	j2044490891 [label="En effet, il connaissait très bien les Luminaires! Nous avons longuement parlé des \"anciennes religions\", comme il les appelait, \"à l'époque précédant l'Empire Orokin\".",shape=box,color=blue];
		j2044490891 -> j85619359;
	j859297516 [label="Otak était un Archimédien, un scientifique et savant Orokin. Ce qui lui est arrivé n'est pas vraiment une histoire heureuse.",shape=box,color=red];
		j859297516 -> j3271520645;
	j1079479208 [label="J'espère que tu feras preuve de plus de bienveillance envers une personne manifestement infirme. Mais par la grâce de Sol, que ce soit le cas pour tous.",shape=box,color=blue];
		j1079479208 -> j3409577060;
	j872051211 [label="Et j'espère que tous lui témoigneront gentillesse et patience. Que la grâce de Sol nous éclaire tous.",shape=box,color=blue];
		j872051211 -> j3409577060;
	j85619359 [label="Toutefois, il a affirmé qu'une grande partie de ce savoir était désormais perdue, enfouie au plus profond des archives et formellement interdite. Il m'a fait jurer le secret.",shape=box,color=blue];
		j85619359 -> j2819600248;
	j3271520645 [label="De l’avis général, il était un génie et l’esprit derrière l’exploitation des cristaux d’argon.",shape=box,color=red];
		j3271520645 -> j2649267990;
	j3409577060 [label="Un tel sort pourrait attendre n'importe lequel d'entre nous. Même toi.",shape=box,color=blue];
		j3409577060 -> j1049324204;
		j3409577060 -> j671950163;
	j2819600248 [label="Il m'a dit qu'il craignait sérieusement que l'Exécuteur Ballas, qui qu'il soit, ne découvre ma secte d'hérétiques et ne me fasse exécuter.",shape=box,color=blue];
		j2819600248 -> j4051727386;
		j2819600248 -> j2728419882;
	j2649267990 [label="Qui sont exploités à partir du Néant - ils sont la raison pour laquelle nous pouvons créer un grand nombre de Warframes et d'armes puissantes.",shape=box,color=red];
		j2649267990 -> j3389080319;
	j1049324204 [label="Tu as raison, je m'excuse. Je ne voulais pas dire ça.",shape=box,color=red];
		j1049324204 -> j1819637436;
	j671950163 [label="Je n'ai tout simplement pas de temps à lui consacrer, je m'excuse.",shape=box,color=red];
		j671950163 -> j1257886890;
	j4051727386 [label="Ballas est mort... continue.",shape=box,color=red];
		j4051727386 -> j1732077164;
	j2728419882 [label="Ça... n'arrivera pas. Continue.",shape=box,color=red];
		j2728419882 -> j1732077164;
	j3389080319 [label="Il s'est spécialisé en cristallographie. Ses travaux étaient archivés ici, dans les laboratoires.",shape=box,color=red];
		j3389080319 -> j2222702336;
	j1257886890 [label="Je regrette donc de t'en faire perdre davantage.",shape=box,color=blue];
		j1257886890 -> j3007723528;
	j1732077164 [label="+5 Chemistry",color=orange];
		j1732077164 -> j2846970052;
	j2222702336 [label="Pour une raison que j'ignore, il a été transformé en Céphalon et a reçu sa propre carapace de Necraloid.",shape=box,color=red];
		j2222702336 -> j3160612245;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j2846970052 [label="Je m'en doutais... Enfin, il m’a demandé d’où je venais et quand je le lui ai dit, il a ri et a répondu: \"Non, c’est impossible! Et je devrais le savoir, je suis...\"",shape=box,color=blue];
		j2846970052 -> j1568605729;
	j3160612245 [label="Tous les Céphalons n'ont pas été créés en guise de châtiment. Mais les choses ont... mal tourné sur Deimos et il a été gravement endommagé.",shape=box,color=red];
		j3160612245 -> j2105349457;
	j1568605729 [label="Puis il... s’est présenté de nouveau. Et m’a demandé si je venais des plaines avec des échantillons de minéraux...",shape=box,color=blue];
		j1568605729 -> j2085649403;
		j1568605729 -> j2842501030;
	j2105349457 [label="Pauvre petit...",shape=box,color=blue];
		j2105349457 -> j253530729;
	j2085649403 [label="Ouais... c'est Otak.",shape=box,color=red];
		j2085649403 -> j1005979842;
	j2842501030 [label="Oh, Marie. Je ne sais pas quoi dire...",shape=box,color=red];
		j2842501030 -> j1005979842;
	j253530729 [label="Boolean MarieOtak1 is now true.",color=orange];
		j253530729 -> j29133482;
		j253530729 -> j2819326148;
	j1005979842 [label="L'idée qu'il n'y ait rien à faire pour lui me brise le cœur.",shape=box,color=blue];
		j1005979842 -> j457335464;
	j457335464 [label="Evaluate expressions",color=orange];
		j457335464 -> j3961348534 [label="MarieCephalonSoul",color=purple];
		j457335464 -> j140277112 [label="MarieCephalonNoSoul",color=purple];
		j457335464 -> j3617218295 [label="MarieCephalonUnsure",color=purple];
		j457335464 -> j3430408840 [label="false",color=purple];
	j3961348534 [label="Ô Luminaires, quel enfer lui avez-vous réservé pour garder son âme prisonnière de cette cage de science et de lumières vacillantes?",shape=box,color=blue];
		j3961348534 -> j1507565200;
	j140277112 [label="Je ne peux que prier les Luminaires pour que tu aies raison et qu'il ne reste rien à l'intérieur de cette coquille, si ce n'est... la science et des lumières vacillantes.",shape=box,color=blue];
		j140277112 -> j2429438978;
	j3617218295 [label="Je sais que tu ignores si les Céphalons contiennent des âmes, mais je ne peux que prier les Luminaires pour que... le pauvre Otak ne souffre pas.",shape=box,color=blue];
		j3617218295 -> j1494797829;
	j3430408840 [label="Je ne peux que prier les Luminaires pour que tout ce qui reste à l'intérieur de cette coquille ne soit rien d'autre que... de la science et des lumières vacillantes.",shape=box,color=blue];
		j3430408840 -> j1494797829;
	j1507565200 [label="Pourquoi le laisser là, brisé, à attendre la mort pour enfin trouver la paix? Je ne peux que prier... pour que, s’il y a une présence quelconque là-dedans...",shape=box,color=blue];
		j1507565200 -> j3283522678;
	j2429438978 [label="Qu'aucune âme ne soit prisonnière de cette chose brisée qui attend de mourir pour enfin trouver la paix.",shape=box,color=blue];
		j2429438978 -> j1684331575;
	j1494797829 [label="Qu'aucune âme ne soit prisonnière de cette chose brisée qui attend de mourir pour enfin trouver la paix.",shape=box,color=blue];
		j1494797829 -> j2516630026;
	j3283522678 [label="Que ce soit parce qu'il y demeure par choix comme une sorte de veilleur solitaire...",shape=box,color=blue];
		j3283522678 -> j2246253267;
	j1684331575 [label="Car si tu te trompes et qu'une âme reste enfermée dans cette cage contre son gré?",shape=box,color=blue];
		j1684331575 -> j2303984171;
	j2516630026 [label="Ou bien, s'il y a une présence quelconque là-dedans, que ce soit parce qu'il reste de son plein gré, comme une sorte de veillée solitaire.",shape=box,color=blue];
		j2516630026 -> j2246253267;
	j2246253267 [label="Penser autrement suffit à remettre en question la bonté des dieux, n'est-ce pas?",shape=box,color=blue];
		j2246253267 -> j4095397329;
	j2303984171 [label="Il y a de quoi se demander si les dieux sont réellement bienveillants, n'est-ce pas?",shape=box,color=blue];
		j2303984171 -> j4095397329;
	j4095397329 [label="Et alors, où en serais-je?",shape=box,color=blue];
		j4095397329 -> j1683074409;
	j1683074409 [label="Pardonne-moi, je suis... je suis mélancolique, aujourd'hui.",shape=box,color=blue];
		j1683074409 -> j3251038745;
	j3251038745 [label="Evaluate expressions",color=orange];
		j3251038745 -> j3266959301 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j2396404040 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j2563746225 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j180041735 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j3266959301 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j2396404040 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j2563746225 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j180041735 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j3266959301 [label="false",color=purple];
		j3251038745 -> j2396404040 [label="false",color=purple];
		j3251038745 -> j180041735 [label="false",color=purple];
	j3266959301 [label="C'est normal. Tu as parfaitement le droit de l'être.",shape=box,color=red];
		j3266959301 -> j3773155451;
	j2396404040 [label="Puis-je faire quelque chose pour te remonter le moral? On pourrait aller tourmenter Roathe.",shape=box,color=red];
		j2396404040 -> j2297753673;
	j2563746225 [label="Puis-je faire quelque chose pour te remonter le moral? Peut-être voler quelques pâtisseries?",shape=box,color=red];
		j2563746225 -> j1690328508;
	j180041735 [label="Parfois, les dieux sont cruels, Marie. C'est la vie.",shape=box,color=red];
		j180041735 -> j2732311175;
	j3773155451 [label="+20 Chemistry",color=orange];
		j3773155451 -> j2682749786;
	j2297753673 [label="+15 Chemistry",color=orange];
		j2297753673 -> j3518475428;
	j1690328508 [label="+20 Chemistry",color=orange];
		j1690328508 -> j3518475428;
	j2732311175 [label="+5 Chemistry",color=orange];
		j2732311175 -> j2777327321;
	j2682749786 [label="Merci. Bon, je n'ai plus envie de l'être. Je vais faire quelque chose de plus joyeux! Je crois que l'aquarium de Monsieur Fibonacci a besoin d'un petit coup de chiffon.",shape=box,color=blue];
		j2682749786 -> j2486340526;
	j3518475428 [label="Ah! Merci. Voilà qui va certainement faire sécher mes larmes idiotes. Tu sais comment réconforter la petite Marie, n'est-ce pas?",shape=box,color=blue];
		j3518475428 -> j1704563345;
		j3518475428 -> j3534304381;
	j2777327321 [label="Oui, tu as tout à fait raison. C'est vrai. Le monde regorge d'histoires comme celle de Monsieur Otak et bien d'autres pires encore. Je ne devrais pas m'apitoyer sur son sort. ",shape=box,color=blue];
		j2777327321 -> j1689524085;
	j2486340526 [label="Check boolean MarieDating",color=orange];
		j2486340526 -> j1154415591 [label=true,color=green];
		j2486340526 -> j3132378552 [label=false,color=brown];
	j1704563345 [label="C'est le moins que je puisse faire pour toi.",shape=box,color=red];
		j1704563345 -> j1350233930;
	j3534304381 [label="Il n'y a rien d'idiot... Je ressens la même chose.",shape=box,color=red];
		j3534304381 -> j1350233930;
	j1689524085 [label="Et pourtant, me voilà à faire exactement cela. Merci de me rappeler ma bêtise. Fi! Pauvre petite Marie. Bon... je crois que l'aquarium de Monsieur Fibonacci a besoin d'un petit coup de chiffon.",shape=box,color=blue];
		j1689524085 -> j2486340526;
	j1154415591 [label="À la revoyure, mon loup.",shape=box,color=blue];
		j1154415591 -> j3007723528;
	j3132378552 [label="À la revoyure!",shape=box,color=blue];
		j3132378552 -> j3007723528;
	j1350233930 [label="+5 Chemistry",color=orange];
		j1350233930 -> j4058209286;
	j4058209286 [label="Check boolean MarieDating",color=orange];
		j4058209286 -> j2349749218 [label=true,color=green];
		j4058209286 -> j3483308679 [label=false,color=brown];
	j2349749218 [label="Merci, merci, merci, mon loup. Allez, allons faire un mauvais coup. ",shape=box,color=blue];
		j2349749218 -> j3007723528;
	j3483308679 [label="Merci, merci, merci. Allez, allons faire un mauvais coup.",shape=box,color=blue];
