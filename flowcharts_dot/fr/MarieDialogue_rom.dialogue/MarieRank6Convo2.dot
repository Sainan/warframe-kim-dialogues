	3531 [label="Ô Luminaires, quel enfer lui avez-vous réservé pour garder son âme prisonnière de cette cage de science et de lumières vacillantes?",shape=box,color=blue];
		3531 -> 3535;
	3532 [label="Je ne peux que prier les Luminaires pour que tu aies raison et qu'il ne reste rien à l'intérieur de cette coquille, si ce n'est... la science et des lumières vacillantes.",shape=box,color=blue];
		3532 -> 3536;
	3533 [label="Je sais que tu ignores si les Céphalons contiennent des âmes, mais je ne peux que prier les Luminaires pour que... le pauvre Otak ne souffre pas.",shape=box,color=blue];
		3533 -> 3537;
	3534 [label="Je ne peux que prier les Luminaires pour que tout ce qui reste à l'intérieur de cette coquille ne soit rien d'autre que... de la science et des lumières vacillantes.",shape=box,color=blue];
		3534 -> 3538;
	3535 [label="Pourquoi le laisser là, brisé, à attendre la mort pour enfin trouver la paix? Je ne peux que prier... pour que, s’il y a une présence quelconque là-dedans...",shape=box,color=blue];
		3535 -> 3539;
	3536 [label="Qu'aucune âme ne soit prisonnière de cette chose brisée qui attend de mourir pour enfin trouver la paix.",shape=box,color=blue];
		3536 -> 3540;
	3537 [label="Qu'aucune âme ne soit prisonnière de cette chose brisée qui attend de mourir pour enfin trouver la paix.",shape=box,color=blue];
		3537 -> 3541;
	3538 [label="Qu'aucune âme ne soit prisonnière de cette chose brisée qui attend de mourir pour enfin trouver la paix.",shape=box,color=blue];
		3538 -> 3541;
	3539 [label="Que ce soit parce qu'il y demeure par choix comme une sorte de veilleur solitaire...",shape=box,color=blue];
