	3486 [label="Le visage au dos de Monsieur Necraloid! Je l'ai enfin rencontré!",shape=box,color=blue];
		3486 -> 3489;
		3486 -> 3490;
		3486 -> 3491;
	3487 [label="As-tu apprécié ta conversation avec lui?",shape=box,color=red];
		3487 -> 3492;
	3488 [label="Comment s'est passée ta conversation avec lui?",shape=box,color=red];
		3488 -> 3493;
	3489 [label="Pauvre Otak... Comment ça s'est passé?",shape=box,color=red];
		3489 -> 3494;
	3490 [label="C'est chouette que vous vous soyez enfin rencontrés. Otak peut être un peu difficile à expliquer.",shape=box,color=red];
		3490 -> 3495;
	3491 [label="Tu as rencontré Otak? Oh là là... Comment ça s'est passé?",shape=box,color=red];
		3491 -> 3496;
	3492 [label="Oui. Même si j'avais peut-être envie de pleurer. Car il s'est présenté à moi trois fois au cours de la même conversation, comme si nous ne nous étions jamais rencontrés.",shape=box,color=blue];
		3492 -> 3497;
	3493 [label="Il... s’est présenté à moi à trois reprises au cours de la même conversation, comme si nous ne nous étions jamais rencontrés.",shape=box,color=blue];
		3493 -> 3497;
	3494 [label="Je l'ai trouvé adorable et charmant! Mais sous une couche d'humour, je ressentais un profond chagrin.",shape=box,color=blue];
		3494 -> 3498;
	3495 [label="Oui, je le pense aussi. Un gribouillage d'enfant dans le dos d'un automate. Je l'ai trouvé tout simplement adorable et charmant!",shape=box,color=blue];
		3495 -> 3499;
	3496 [label="Tu n'as pas l'air d'apprécier que je l'aie rencontré?",shape=box,color=blue];
		3496 -> 3500;
		3496 -> 3501;
		3496 -> 3502;
	3497 [label="Il m’a saluée avec la même assurance et la même gaieté à chaque fois. Mais il me connaissait comme un Sœur de Sol! ",shape=box,color=blue];
		3497 -> 3503;
	3498 [label="Veux-tu me raconter l'histoire du pauvre Monsieur Otak?",shape=box,color=blue];
		3498 -> 3504;
	3499 [label="Mais sous cette façade humoristique se cache un profond chagrin.",shape=box,color=blue];
		3499 -> 3498;
	3500 [label="Il peut parfois m'agacer, c'est tout. ",shape=box,color=red];
		3500 -> 3505;
	3501 [label="Ce n'est pas ce que je voulais dire. Il peut être un peu... agaçant pour certaines personnes.",shape=box,color=red];
		3501 -> 3506;
	3502 [label="Pardon. Il peut parfois être agaçant. Ce n'est pas de sa faute.",shape=box,color=red];
		3502 -> 3506;
	3503 [label="En effet, il connaissait très bien les Luminaires! Nous avons longuement parlé des \"anciennes religions\", comme il les appelait, \"à l'époque précédant l'Empire Orokin\".",shape=box,color=blue];
		3503 -> 3507;
	3504 [label="Otak était un Archimédien, un scientifique et savant Orokin. Ce qui lui est arrivé n'est pas vraiment une histoire heureuse.",shape=box,color=red];
		3504 -> 3508;
	3505 [label="J'espère que tu feras preuve de plus de bienveillance envers une personne manifestement infirme. Mais par la grâce de Sol, que ce soit le cas pour tous.",shape=box,color=blue];
		3505 -> 3509;
	3506 [label="Et j'espère que tous lui témoigneront gentillesse et patience. Que la grâce de Sol nous éclaire tous.",shape=box,color=blue];
		3506 -> 3509;
	3507 [label="Toutefois, il a affirmé qu'une grande partie de ce savoir était désormais perdue, enfouie au plus profond des archives et formellement interdite. Il m'a fait jurer le secret.",shape=box,color=blue];
		3507 -> 3510;
	3508 [label="De l’avis général, il était un génie et l’esprit derrière l’exploitation des cristaux d’argon.",shape=box,color=red];
		3508 -> 3511;
	3509 [label="Un tel sort pourrait attendre n'importe lequel d'entre nous. Même toi.",shape=box,color=blue];
		3509 -> 3512;
		3509 -> 3513;
	3510 [label="Il m'a dit qu'il craignait sérieusement que l'Exécuteur Ballas, qui qu'il soit, ne découvre ma secte d'hérétiques et ne me fasse exécuter.",shape=box,color=blue];
		3510 -> 3514;
		3510 -> 3515;
	3511 [label="Qui sont exploités à partir du Néant - ils sont la raison pour laquelle nous pouvons créer un grand nombre de Warframes et d'armes puissantes.",shape=box,color=red];
		3511 -> 3516;
	3512 [label="Tu as raison, je m'excuse. Je ne voulais pas dire ça.",shape=box,color=red];
		3512 -> 3498;
	3513 [label="Je n'ai tout simplement pas de temps à lui consacrer, je m'excuse.",shape=box,color=red];
		3513 -> 3517;
	3514 [label="Ballas est mort... continue.",shape=box,color=red];
		3514 -> 3518;
	3515 [label="Ça... n'arrivera pas. Continue.",shape=box,color=red];
		3515 -> 3518;
	3516 [label="Il s'est spécialisé en cristallographie. Ses travaux étaient archivés ici, dans les laboratoires.",shape=box,color=red];
		3516 -> 3519;
	3517 [label="Je regrette donc de t'en faire perdre davantage.",shape=box,color=blue];
		3517 -> 3520;
	3518 [label="+5 Chemistry",color=orange];
		3518 -> 3521;
	3519 [label="Pour une raison que j'ignore, il a été transformé en Céphalon et a reçu sa propre carapace de Necraloid.",shape=box,color=red];
		3519 -> 3522;
	3520 [label="Update boolean MarieOtakComplete",color=orange];
		3520 -> 3523;
	3521 [label="Je m'en doutais... Enfin, il m’a demandé d’où je venais et quand je le lui ai dit, il a ri et a répondu: \"Non, c’est impossible! Et je devrais le savoir, je suis...\"",shape=box,color=blue];
		3521 -> 3524;
	3522 [label="Tous les Céphalons n'ont pas été créés en guise de châtiment. Mais les choses ont... mal tourné sur Deimos et il a été gravement endommagé.",shape=box,color=red];
		3522 -> 3525;
	3523 [label="Chat ends.",color=orange];
	3524 [label="Puis il... s’est présenté de nouveau. Et m’a demandé si je venais des plaines avec des échantillons de minéraux...",shape=box,color=blue];
		3524 -> 3526;
		3524 -> 3527;
