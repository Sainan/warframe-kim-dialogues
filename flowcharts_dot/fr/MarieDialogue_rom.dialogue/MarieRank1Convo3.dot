	155 [label="Cela dit, devoir me faire rouler ne me manque pas. Lyon non plus, j'imagine. Quelle liberté de voler!",shape=box,color=blue];
		155 -> 160;
		155 -> 161;
		155 -> 162;
	156 [label="Update boolean MarieInvalid",color=orange];
		156 -> 163;
	154 [label="Pour une raison que j'ignore, il a été transformé en Céphalon et a reçu sa propre coquille de Necraloid.",shape=box,color=red];
		154 -> 159;
	152 [label="Elle a accepté son absence et ils ont fait la paix l'un avec l'autre, mais cela n'a pas été tout seul.",shape=box,color=red];
		152 -> 157;
	153 [label="Elle n'a pas accepté son absence et ils se font la tête.",shape=box,color=red];
		153 -> 158;
	160 [label="J'essaie de considérer les handicaps comme des éléments qui nous transforment. Ils nous limitent certes à certains égards, mais ils peuvent aussi nous conférer des forces que d'autres n'ont pas.",shape=box,color=red];
		160 -> 167;
	161 [label="Tu n'as jamais considéré cet état comme un problème?",shape=box,color=red];
		161 -> 168;
