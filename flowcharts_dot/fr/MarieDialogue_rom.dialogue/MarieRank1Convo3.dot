		162 -> 169;
	163 [label="Chat ends.",color=orange];
	159 [label="Tous les Céphalons n'ont pas été créés en guise de châtiment. Mais les choses ont... mal tourné sur Deimos, et il a été gravement endommagé.",shape=box,color=red];
		159 -> 166;
	157 [label="Sachant qu'il est toujours là, quelque part, qu'il ne lui a pas dit un mot ni même envoyé une lettre... ?",shape=box,color=red];
		157 -> 164;
	158 [label="Sachant qu'il est toujours là, quelque part, qu'il ne lui a pas dit un mot ni même envoyé une lettre... ?",shape=box,color=red];
		158 -> 165;
	167 [label="+5 Chemistry",color=orange];
		167 -> 173;
	168 [label="Je n'ai jamais vu l'intérêt de m'en plaindre. Par contre, j'apprécie vraiment de pouvoir récupérer des objets sur des étagères en hauteur sans aide, je dois l'admettre.",shape=box,color=blue];
		168 -> 174;
	169 [label="Oui, le Cardinal nous a dit, à Lyon et moi, tout ce qui adviendrait avec ces sérums qui ont modifié notre apparence. On savait ce que ça allait nous faire.",shape=box,color=blue];
		169 -> 175;
	166 [label="+5 Chemistry",color=orange];
		166 -> 172;
	164 [label="Je n'ose imaginer à quel point cela a dû être douloureux pour elle. Pour eux.",shape=box,color=red];
		164 -> 170;
	165 [label="Cela a dû détruire la petite chance de réconciliation qu’ils pouvaient avoir.",shape=box,color=red];
		165 -> 171;
	173 [label="Update boolean MarieSecretPower",color=orange];
		173 -> 179;
	174 [label="Ce qui est fait est fait. Je ne pouvais pas prier Sol pour obtenir un miracle alors que tant de personnes autour de moi souffraient davantage, alors que tant d'autres étaient dans le besoin. Les Luminaires m'avaient déjà tant donné.",shape=box,color=blue];
		174 -> 180;
	175 [label="Mais comme toujours, j'ai pris le mien avec joie et Lyon a pris le sien... oh, je me sens comme si je le dénonçais et je ne devrais pas.",shape=box,color=blue];
		175 -> 181;
		175 -> 182;
	172 [label="Pauvre petit...",shape=box,color=blue];
		172 -> 178;
	170 [label="Bien que je puisse comprendre la logique derrière la décision de les protéger de la douleur que le Cardinal a causée par son départ nécessaire...",shape=box,color=blue];
		170 -> 176;
	171 [label="+10 Chemistry",color=orange];
		171 -> 177;
	179 [label="Oui! Tu as compris. Je connaissais le monde sous un autre angle. Mes bras étaient plus forts. Je suis plus patiente. Je sais ce que signifie savourer l'instant présent.",shape=box,color=blue];
		179 -> 190;
	180 [label="Je dois y aller. Merci pour cette merveilleuse distraction. ",shape=box,color=blue];
		180 -> 191;
	181 [label="C'est bon. Ne me dis rien de plus que ce qui te convient.",shape=box,color=red];
		181 -> 192;
	182 [label="S'il te plaît, continue. J'ai du mal à lui parler.",shape=box,color=red];
		182 -> 193;
	178 [label="Il a donc été transféré au necraloid principal – le seul necraloid restant – et... eh bien? C’est difficile à expliquer.",shape=box,color=red];
		178 -> 187;
		178 -> 188;
		178 -> 189;
	176 [label="Je trouve ça inutilement cruel, pas toi? Ils pourraient le croire mort. Ou pire! Et nous, ici, comme des rats d'égout?",shape=box,color=blue];
		176 -> 183;
		176 -> 184;
		176 -> 185;
	177 [label="Oui... Je comprends la logique. Je travaillerais à réparer leur famille, si on peut, non? On dirait que c'est notre seul espoir de sortir d'ici. ",shape=box,color=blue];
		177 -> 186;
	190 [label="Quand j'arrive à destination, je savoure le moment. Je ne me précipite pas comme un insecte aux milliards de petites pattes.",shape=box,color=blue];
		190 -> 202;
