	187 [label="J'aimerais juste qu'on puisse le réparer, honnêtement. Ramener le véritable Otak.",shape=box,color=red];
		187 -> 199;
	188 [label="Il me fait sourire. Il est drôle, mais il cache quelque chose de tragique et de brisé.",shape=box,color=red];
		188 -> 200;
	189 [label="Malheureusement, il est irréparable. Et je pense qu'il énerve beaucoup de gens. ",shape=box,color=red];
		189 -> 201;
	183 [label="Tu as raison. J'aimerais qu'on puisse faire quelque chose.",shape=box,color=red];
		183 -> 194;
	184 [label="Ce n’est pas vraiment à moi de prendre cette décision.",shape=box,color=red];
		184 -> 195;
	185 [label="J'ai une amie qui adore les rats. Je les trouve adorables.",shape=box,color=red];
		185 -> 196;
	186 [label="J'ai peur que nous ne passions le reste de nos vies piégés ici, comme des rats d'égout. ",shape=box,color=blue];
		186 -> 197;
		186 -> 198;
	202 [label="Je voudrais vraiment que mon cher Lyon puisse voir le monde comme toi. Que tous les désagréments soient une force secrète, comme tu le dis.",shape=box,color=blue];
		202 -> 213;
	203 [label="J'apprécie ta gentillesse, Voyageur. Je terminerai avec ceci, afin de ne pas abuser de ta patience -",shape=box,color=blue];
		203 -> 214;
	204 [label="Il n'y a pas que toi dans ce cas, Voyageur. Lyon est comme un membre de ma famille et parfois, je me demande encore si je le connais mieux que les statues de saints dans la cathédrale.",shape=box,color=blue];
		204 -> 215;
	199 [label="+15 Chemistry",color=orange];
		199 -> 210;
