digraph {
	77 [label="MarieRank1Convo3 begins.",color=orange];
		77 -> 78;
	78 [label="Il y a un crâne volant! Keksekça?! Il y a un crâne volant qui parle et tout le monde continue sa journée comme si de rien n'était et j'ai besoin que quelqu'un reconnaisse l'étrangeté de la chose.",shape=box,color=blue];
		78 -> 79;
		78 -> 81;
		78 -> 80;
	79 [label="C'est seulement Necraloid. Enfin, un Necraloid. C'est compliqué.",shape=box,color=red];
		79 -> 82;
	81 [label="C'est Necraloid. C'est un Céphalon, il ne te fera aucun mal.",shape=box,color=red];
		81 -> 84;
	80 [label="[Fin.]",shape=box,color=red];
		80 -> 83;
	82 [label="Pardon, c'est un nom ou un objet?",shape=box,color=blue];
		82 -> 85;
		82 -> 86;
	84 [label="Je ne le considère pas comme une menace! Il ne me fait pas peur.",shape=box,color=blue];
		84 -> 87;
	83 [label="Chat ends.",color=orange];
	85 [label="Je... ne sais pas vraiment.",shape=box,color=red];
		85 -> 88;
	86 [label="Oui.",shape=box,color=red];
		86 -> 89;
	87 [label="En fait, je le trouve parfaitement charmant, quoique un peu inflexible dans la conversation. Ce n'est pas si différent de son inspiration vivante. Mais étant donné la nature de mon compagnon de voyage préféré, cela ne me dérange pas outre mesure.",shape=box,color=blue];
		87 -> 90;
	88 [label="Premièrement, qui est à l'origine de ces \"Necraloids\"? C'est un nom et peut-être aussi une désignation?",shape=box,color=blue];
		88 -> 91;
		88 -> 92;
	89 [label="Je... ne comprends pas. Et quel est le rôle de Loid dans tout ça?",shape=box,color=blue];
		89 -> 88;
	90 [label="Non, ce que tu pourrais trouver grotesque dans son visage, je te l’assure, n’est pas le problème qui m’occupe actuellement.",shape=box,color=blue];
		90 -> 93;
		90 -> 94;
	91 [label="Ton Cardinal Dimanche. Entrati.",shape=box,color=red];
		91 -> 95;
	92 [label="C'est Entrati qui a créé celui-là. Mais le concept de ce qu'ils sont – les Céphalons – a été inventé par les Orokins.",shape=box,color=red];
		92 -> 95;
	93 [label="C'est surprenant que le crâne ne te rebute pas.",shape=box,color=red];
		93 -> 96;
	94 [label="J'avoue, sorti de son contexte, il doit être étrange. Mais qu'est-ce qui te pose vraiment un problème?",shape=box,color=red];
		94 -> 97;
	95 [label="Excuse-moi, tu veux dire que le Cardinal a fabriqué un serviteur en forme de crâne volant à l'image de son propre compagnon et qu'il l'a nommé ainsi?",shape=box,color=blue];
		95 -> 98;
	96 [label="Tu ne sais pas grand-chose sur moi et ce n'est pas de ta faute. J'ai passé une grande partie de ma vie à m'occuper des morts et de leurs lieux de repos. ",shape=box,color=blue];
		96 -> 99;
	97 [label="Je suis curieuse de savoir pourquoi il y a un autre visage sur son dos qui ressemble au gribouillage d'un enfant.",shape=box,color=blue];
		97 -> 100;
	98 [label="Pourquoi n'y en a-t-il pas plus, de ces Necraloids, alors?",shape=box,color=blue];
		98 -> 101;
		98 -> 102;
		98 -> 103;
	99 [label="J'ai passé une grande partie de ma vie avec eux, mes compagnons de voyage. Ils sont toujours à l'écoute de mes soucis du quotidien.",shape=box,color=blue];
		99 -> 104;
	100 [label="J'ai interrogé Monsieur Necraloid et Monsieur Loid, mais aucun des deux n'a souhaité en parler. Ils m'ont seulement donné un nom: Otak. Et c'est avec une grande tristesse qu'ils l'ont prononcé.",shape=box,color=blue];
		100 -> 105;
	101 [label="Peut-être qu’il a réalisé à quel point il est horrible de faire une copie numérique de son amant.",shape=box,color=red];
		101 -> 106;
	102 [label="Peut-être qu'il n'a jamais eu l'intention d'en faire d'autres.",shape=box,color=red];
		102 -> 107;
	103 [label="Je ne sais pas. Peut-être n'a-t-il jamais réussi à en faire plus?",shape=box,color=red];
		103 -> 108;
	104 [label="Update boolean MarieGraveyard1",color=orange];
		104 -> 109;
		104 -> 110;
	105 [label="Alors me voici, en train de te parler, dans l’espoir que tu puisses m’aider.",shape=box,color=blue];
		105 -> 111;
		105 -> 112;
	106 [label="Ou bien, c'est un hommage à son amour, une marque de respect, parce qu'il ne pensait pas que cet étrange laboratoire pouvait continuer à fonctionner sans Monsieur Loid.",shape=box,color=blue];
		106 -> 113;
		106 -> 114;
	107 [label="+5 Chemistry",color=orange];
		107 -> 115;
	108 [label="Imagine une école de crânes volants, le tout sans problème et parfaitement efficace!",shape=box,color=blue];
		108 -> 114;
		108 -> 116;
	109 [label="Tu aimais t'occuper des cimetières?",shape=box,color=red];
		109 -> 117;
	110 [label="Ont-ils déjà répondu?",shape=box,color=red];
		110 -> 118;
	111 [label="Tu veux en savoir plus sur Otak? Ou pourquoi tu ne peux pas lui parler?",shape=box,color=red];
		111 -> 119;
	112 [label="Otak, c'est difficile à expliquer...",shape=box,color=red];
		112 -> 2918;
	113 [label="Je dirais que c'est un geste étrangement romantique, mais ce n'est pas vraiment à moi de le dire.",shape=box,color=red];
		113 -> 122;
	114 [label="Honnêtement, ça ne me dérangerait pas d'avoir un Necraloid chez moi.",shape=box,color=red];
		114 -> 123;
	115 [label="Tragique et beau dans un sens, non? Un hommage à son amour, une marque de respect, parce qu'il ne pensait pas que cet étrange laboratoire pouvait continuer à fonctionner sans Monsieur Loid.",shape=box,color=blue];
		115 -> 124;
		115 -> 113;
	116 [label="Je pense que c'est mieux qu'il n'y en ait qu'un seul, honnêtement. Je ne crois pas que le monde serait prêt pour ça.",shape=box,color=red];
		116 -> 125;
	117 [label="Et les mausolées et les cryptes, oh oui. Mais j'avoue que je préférais les espaces extérieurs, même s'ils étaient difficiles à parcourir avec ma chaise. Comme les escaliers, j'en ai peur.",shape=box,color=blue];
		117 -> 126;
	118 [label="Ah! Non, heureusement. Jusqu'à ce que ton \"Necraloid\" au visage si morbide me réponde. Si parler aux morts fait partie des dons des Luminaires, je l'ignore.",shape=box,color=blue];
		118 -> 127;
	119 [label="Les deux, je crois. En temps voulu. Mais je te laisse décider par où commencer. Après tout, je ne sais pas ce qui est le plus important.",shape=box,color=blue];
		119 -> 2918;
	2918 [label="Check boolean LoidFamilyComplete",color=orange];
		2918 -> 121 [label=true,color=green];
		2918 -> 121 [label=false,color=brown];
		2918 -> 120 [label=false,color=brown];
	122 [label="Et maintenant, je suis intriguée, mais cela semble être une histoire pour une autre fois. Cela dit...",shape=box,color=blue];
		122 -> 97;
	123 [label="Alors, je suis certaine que tu as probablement besoin de compagnie ou d'organisation, ou des deux. Mais ce sera une autre conversation.",shape=box,color=blue];
		123 -> 97;
	124 [label="Je pense que cela avait plus à voir avec le fait de s'assurer que cet endroit ne s'effondre pas.",shape=box,color=red];
		124 -> 130;
	125 [label="Tout à fait! Moi non plus. Ce qui m'amène à ma question suivante.",shape=box,color=blue];
		125 -> 97;
	126 [label="Update boolean MarieSerum1",color=orange];
		126 -> 131;
		126 -> 132;
	127 [label="Non, entendre des esprits et des voix est bien plus du ressort de mon cher Lyon que du mien. Je me demande cependant si Monsieur Nécraloid n'est pas lui aussi hanté, à en juger par le gribouillage d'enfant à l'arrière de sa tête.",shape=box,color=blue];
		127 -> 133;
	121 [label="Otak était un Archimédien, un scientifique et savant Orokin. Ce qui lui est arrivé n'est pas vraiment une histoire heureuse.",shape=box,color=red];
		121 -> 129;
	120 [label="Eh bien... en bref, certains membres de la famille Entrati sont à l'étage, et ils ne sont pas... exactement conscients que nous sommes ici en bas.",shape=box,color=red];
		120 -> 128;
	130 [label="Et tu as peut-être raison. Cet amalgame volant semble manquer de la raison d'être et des nuances du véritable Monsieur Loid. Cela dit...",shape=box,color=blue];
		130 -> 97;
	131 [label="Je ne savais pas s'il était correct de demander si tes pieds avaient été affectés ou non par le sérum...",shape=box,color=red];
		131 -> 136;
	132 [label="Ta chaise?",shape=box,color=red];
		132 -> 137;
	133 [label="C'est d'ailleurs pour cela que je suis venue ici pour te parler, si cela ne te dérange pas.",shape=box,color=blue];
		133 -> 100;
	129 [label="Update boolean MarieOtak1",color=orange];
		129 -> 135;
	128 [label="Update boolean MarieFamily1",color=orange];
		128 -> 134;
	136 [label="+10 Chemistry",color=orange];
		136 -> 140;
	137 [label="Je ne sais pas comment tu appellerais ça? Un fauteuil roulant, ou... peut-être un terme que je déteste profondément, un fauteuil pour invalide.",shape=box,color=blue];
		137 -> 141;
	135 [label="Par les Luminaires... s'il te plaît, continue.",shape=box,color=blue];
		135 -> 139;
	134 [label="Par les Luminaires... Tu veux dire que nous sommes tous ici en secret?! C'est pour ça qu'on n'a pas le droit de quitter cet endroit?! Mais pourquoi?!",shape=box,color=blue];
		134 -> 138;
	140 [label="Oh! Oh, pauvre de toi! Là à te demander si le Cardinal m'a pris mes pieds! Non, non, non, rien de tout cela.",shape=box,color=blue];
		140 -> 144;
	141 [label="Comme ce sur quoi nous sommes maintenant, pour nous asseoir devant ces adorables petits appareils de communication. Mais avec des roues sur les côtés, pour se déplacer. Une chaise à roues, si tu préfères.",shape=box,color=blue];
		141 -> 145;
		141 -> 146;
	139 [label="De l’avis général, il était un génie et l’esprit auquel on doit l’exploitation des cristaux d’argon.",shape=box,color=red];
		139 -> 143;
	138 [label="Sa fille, Euleria - connue sous le nom de Mère et sa famille ont pris soin de Deimos pendant tout ce temps.",shape=box,color=red];
		138 -> 142;
	144 [label="Sol a jugé bon d'intégrer dans ma vie l'inconvénient d'être née avec des pieds inutilisables. Je ne pouvais pas marcher. ",shape=box,color=blue];
		144 -> 149;
	145 [label="Tu étais invalide avant de devenir une protoframe?",shape=box,color=red];
		145 -> 150;
	146 [label="Nous les appelons des fauteuils roulants, crois-le ou non.",shape=box,color=red];
		146 -> 151;
	143 [label="Qui sont exploités à partir du Néant - ils sont la raison pour laquelle nous pouvons créer un grand nombre de Warframes et d'armes puissantes.",shape=box,color=red];
		143 -> 148;
	142 [label="Ils veillent sur cet endroit et sur le cœur qui pompe l'énergie du Néant dans le Système Origine, nous gardant tous... utilisables, vraiment, depuis qu'Entrati est parti.",shape=box,color=red];
		142 -> 861;
	149 [label="Mais ce n’était rien de plus que cela, un inconvénient.",shape=box,color=blue];
		149 -> 155;
	150 [label="Non, pas du tout.",shape=box,color=blue];
		150 -> 156;
	151 [label="Ah! Oh, je suis assise là à rire de moi-même, quelle idiote. Oui, je suppose qu'on pourrait appeler ça des fauteuils roulants, vu que ce sont des chaises à roues. Quelle idiote!",shape=box,color=blue];
		151 -> 155;
	148 [label="Il s'est spécialisé en cristallographie. Ses travaux étaient archivés ici, dans les laboratoires.",shape=box,color=red];
		148 -> 154;
