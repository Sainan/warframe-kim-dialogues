	1091 [label="La situation à l'étage est... fragile, même dans les meilleurs jours. Je ne veux pas les contrarier.",shape=box,color=red];
		1091 -> 1082;
	1092 [label="Lentement. Prudemment. J'ai peur qu'une moitié considère l'autre moitié comme \"l'autre famille\".",shape=box,color=red];
