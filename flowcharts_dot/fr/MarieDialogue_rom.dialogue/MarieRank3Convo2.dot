digraph {
	"MarieRank3Convo2 begins." [color=orange];
		"MarieRank3Convo2 begins." -> j3102612293;
	j3102612293 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j3102612293 -> j369807617;
	j369807617 [label="Check boolean LoidFamilyComplete",color=orange];
		j369807617 -> j2210457509 [label=true,color=green];
		j369807617 -> j1668831657 [label=false,color=brown];
	j2210457509 [label="J'espère que tu ne me considères pas comme une infirme... mais j'ai parfois l'étrange sensation d'avoir déjà dit cela?",shape=box,color=blue];
		j2210457509 -> j2375146692;
	j1668831657 [label="Check boolean MarieFamily1",color=orange];
		j1668831657 -> j3355141404 [label=true,color=green];
		j1668831657 -> j3021031736 [label=false,color=brown];
	j2375146692 [label="J'ai eu ces conversations... rencontré ces personnes... bien que ce soit impossible, n'est-ce pas?",shape=box,color=blue];
		j2375146692 -> j3050683736;
	j3355141404 [label="Pourrais-tu m'en dire plus sur la famille du Cardinal? Je suis fascinée de connaître son passé.",shape=box,color=blue];
		j3355141404 -> j3543720230;
		j3355141404 -> j1440057619;
		j3355141404 -> j2429168889;
	j3021031736 [label="Pourrais-tu me parler de la famille du Cardinal? Je suis fascinée de connaître son passé.",shape=box,color=blue];
		j3021031736 -> j3543720230;
		j3021031736 -> j1440057619;
		j3021031736 -> j2429168889;
	j3050683736 [label="+20 Chemistry",color=orange];
		j3050683736 -> j2398756570;
	j3543720230 [label="Je vais te dire tout ce que je sais, mais j'ai peur de ne pas en savoir autant que tu pourrais le penser.",shape=box,color=red];
		j3543720230 -> j4227625862;
	j1440057619 [label="Oh. Bien sûr, mais... Loid ne serait-il pas la meilleure personne à qui parler?",shape=box,color=red];
		j1440057619 -> j2703917789;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j2398756570 [label="On appelle ça un déjà-vu. Ça doit être à cause du sérum et du voyage dans le temps. C'est la vie!",shape=box,color=blue];
		j2398756570 -> "Chat ends.";
	j4227625862 [label="Quoi que tu puisses me dire, je le chérirai. Promis!",shape=box,color=blue];
		j4227625862 -> j444328121;
	j2703917789 [label="Parler du Cardinal... semble profondément blesser Monsieur Loid. Je n'aime pas faire ça.",shape=box,color=blue];
		j2703917789 -> j444328121;
	"Chat ends." [color=orange];
	j444328121 [label="Surtout que je parle de lui avec une certaine joie, et je suis bien la seule à le faire.",shape=box,color=blue];
		j444328121 -> j3940633208;
		j444328121 -> j55192720;
	j3940633208 [label="À propos de qui veux-tu en savoir plus?",shape=box,color=red];
		j3940633208 -> j3477046602;
	j55192720 [label="Eh bien, il y a la Mère, le Père, le Fils, la Fille et la Grand-mère à l'étage.",shape=box,color=red];
		j55192720 -> j3477046602;
	j3477046602 [label="Explique d'abord une chose, veux-tu? Le diable se moque de moi à chaque fois que je le demande, comme si c'était une gaffe. Grand-mère.",shape=box,color=blue];
		j3477046602 -> j1883151075;
	j1883151075 [label="Ce n'est pas la femme du Cardinal, non?",shape=box,color=blue];
		j1883151075 -> j2200085969;
	j2200085969 [label="Non, c'est la mère du Père. La belle-mère de Mère.",shape=box,color=red];
		j2200085969 -> j1137943483;
	j1137943483 [label="Je... vois. Et... pourquoi n'utilisent-ils pas leur nom? Ne serait-ce pas plus simple?",shape=box,color=blue];
		j1137943483 -> j4003327083;
		j1137943483 -> j1403827521;
	j4003327083 [label="Tu veux la version longue?",shape=box,color=red];
		j4003327083 -> j1971757778;
	j1403827521 [label="Je vais te résumer l'essentiel.",shape=box,color=red];
		j1403827521 -> j3662796957;
	j1971757778 [label="Oui! Je n'ai nulle part où aller pendant un petit moment.",shape=box,color=blue];
		j1971757778 -> j3619582698;
	j3662796957 [label="La famille à l'étage a été piégée ici lors de l'effondrement de l'Empire Orokin. Le petit-fils d'Entrati a laissé entrer l'Infestation.",shape=box,color=red];
		j3662796957 -> j3271223028;
	j3619582698 [label="Eh bien, nous sommes sur une lune appelée Deimos. Et une bombe biologique a explosé ici, il y a longtemps, dans une tentative désespérée de repousser les Sentients.",shape=box,color=red];
		j3619582698 -> j1004070911;
	j3271223028 [label="Par Sol! Exprès?",shape=box,color=blue];
		j3271223028 -> j2060196651;
	j1004070911 [label="Ceux contre lesquels les Orokins étaient en guerre, il y a longtemps? Ceux que l'on voit dans les Ténèbres Réfractaires avec le diable, n'est-ce pas?",shape=box,color=blue];
		j1004070911 -> j448744920;
	j2060196651 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j2060196651 -> j2606331894 [label=true,color=green];
		j2060196651 -> j775939249 [label=true,color=green];
		j2060196651 -> j4255342777 [label=false,color=brown];
	j448744920 [label="Oui. Ils ont tenté d'exploiter l'Infestation pour combattre les Sentients. Mais Deimos a été envahie. Ils se sont enfermés dans le Necralisk, qui se trouve au-dessus de nous, pour s'abriter.",shape=box,color=red];
		j448744920 -> j3595829664;
	j2606331894 [label=" Non, je pense que c'était un accident. Je pense qu'il voulait bien faire.",shape=box,color=red];
		j2606331894 -> j1671474735;
	j775939249 [label="Je ne connais pas encore la vérité, donc je réserve mon jugement jusqu'à ce que j'en sache plus.",shape=box,color=red];
		j775939249 -> j1671474735;
	j4255342777 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j4255342777 -> j2606331894 [label=true,color=green];
		j4255342777 -> j775939249 [label=true,color=green];
		j4255342777 -> j775939249 [label=false,color=brown];
		j4255342777 -> j2464439110 [label=false,color=brown];
	j3595829664 [label="Le Fils, donc le petit-fils d'Entrati, était cependant déterminé à essayer de préserver et d'étudier les animaux Infestés.",shape=box,color=red];
		j3595829664 -> j3956778641;
	j1671474735 [label="+10 Chemistry",color=orange];
		j1671474735 -> j4044640605;
	j2464439110 [label="Je ne connais pas encore la vérité, mais il est arrogant, ça je peux te le dire.",shape=box,color=red];
		j2464439110 -> j3105195153;
	j3956778641 [label="Oh, par Sol... avait-il de bonnes intentions?",shape=box,color=blue];
		j3956778641 -> j616297335;
	j4044640605 [label="C'est plutôt gentil de ta part. Continue, s'il te plaît.",shape=box,color=blue];
		j4044640605 -> j868938993;
	j3105195153 [label="J'espère que ce n'est pas le cas, pour son bien et le nôtre. Continue, s'il te plaît.",shape=box,color=blue];
		j3105195153 -> j868938993;
	j616297335 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j616297335 -> j2836529108 [label=true,color=green];
		j616297335 -> j2602705808 [label=true,color=green];
		j616297335 -> j3994202825 [label=true,color=green];
		j616297335 -> j3220361227 [label=false,color=brown];
	j868938993 [label="Eh bien, piégés dans le Necralisk, consumés par le chagrin et sans empire Orokin pour les sauver, et maintenant avec l'Infestation qui s'infiltre...",shape=box,color=red];
		j868938993 -> j4178413815;
	j2836529108 [label="Oui, je crois. Je pense qu'il se soucie sincèrement des créatures.",shape=box,color=red];
		j2836529108 -> j2617887895;
	j2602705808 [label="Malheureusement, cela n’a pas d’importance, le mal était fait.",shape=box,color=red];
		j2602705808 -> j4121136605;
	j3994202825 [label="Non, c'est l'arrogance qui l'a inspiré. Même s'il prétend que c'était un accident.",shape=box,color=red];
		j3994202825 -> j3105195153;
	j3220361227 [label="Check boolean nil",color=orange];
		j3220361227 -> j2836529108 [label=true,color=green];
		j3220361227 -> j2602705808 [label=true,color=green];
		j3220361227 -> j3994202825 [label=true,color=green];
		j3220361227 -> j2836529108 [label=false,color=brown];
		j3220361227 -> j2602705808 [label=false,color=brown];
		j3220361227 -> j13285941 [label=false,color=brown];
	j4178413815 [label="Ils se sont tournés les uns contre les autres. Ils se sont déchirés de l'intérieur. Et l'Infestation a fait le reste, leur arrachant leurs noms. ",shape=box,color=red];
		j4178413815 -> j4207899410;
	j2617887895 [label="+10 Chemistry",color=orange];
		j2617887895 -> j2155027957;
	j4121136605 [label="+5 Chemistry",color=orange];
		j4121136605 -> j996182808;
	j13285941 [label="Je ne connais pas encore la vérité, mais il est arrogant, ça je peux te le dire.",shape=box,color=red];
		j13285941 -> j3105195153;
	j4207899410 [label="C'est la forme ultime de la cruauté, d'être privé d'un nom...",shape=box,color=blue];
		j4207899410 -> j482800561;
	j2155027957 [label="Je me demande ce qu'il penserait des Cavias... quel dommage qu'il ne puisse pas les rencontrer...",shape=box,color=blue];
		j2155027957 -> j23597142;
		j2155027957 -> j3107610993;
	j996182808 [label="Si seule la pureté de nos intentions comptait, le monde serait un endroit magnifique, non? C'est la vie.",shape=box,color=blue];
		j996182808 -> j2873360236;
	j482800561 [label="Boolean MarieFamily2 is now true.",color=orange];
		j482800561 -> j2978155847;
		j482800561 -> j4270886635;
		j482800561 -> j2131170877;
	j23597142 [label="L'idée me fait sourire. Mais je ne pense pas que ce serait judicieux.",shape=box,color=red];
		j23597142 -> j4174062045;
	j3107610993 [label="J'espère que ça arrivera un jour. Vraiment.",shape=box,color=red];
		j3107610993 -> j3948333923;
	j2873360236 [label="Et ensuite?",shape=box,color=blue];
		j2873360236 -> j868938993;
	j2978155847 [label="À moins que tu n'en fasses don, comme Grand-mère.",shape=box,color=red];
		j2978155847 -> j3198563937;
	j4270886635 [label="Ce n'est honnêtement pas si mal, on s'y habitue.",shape=box,color=red];
		j4270886635 -> j4067591433;
	j2131170877 [label="Les animaux n'ont pas de nom et ils semblent parfaitement heureux. Nous leur donnons des noms simplement pour notre propre plaisir.",shape=box,color=red];
		j2131170877 -> j1329816387;
	j4174062045 [label="Et pourquoi pas?",shape=box,color=blue];
		j4174062045 -> j3179501623;
		j4174062045 -> j1616997177;
	j3948333923 [label="Add 1 to Family counter",color=orange];
		j3948333923 -> j2139319721;
	j3198563937 [label="+5 Chemistry",color=orange];
		j3198563937 -> j1056749243;
	j4067591433 [label="Aaah! Quelle horreur! Je ne voulais pas! Oh, je suis mortifiée! Je suis vraiment désolée, pardonne-moi, je ne voulais pas - oh, je suis une idiote!",shape=box,color=blue];
		j4067591433 -> j951176041;
		j4067591433 -> j1048765611;
	j1329816387 [label="+5 Chemistry",color=orange];
		j1329816387 -> j4067946511;
	j3179501623 [label="J’ai peur qu’une moitié considère l’autre moitié comme \"l’autre famille\".",shape=box,color=red];
		j3179501623 -> j243463817;
	j1616997177 [label="La situation à l'étage est... fragile, même dans les meilleurs jours. Je ne veux pas les contrarier.",shape=box,color=red];
		j1616997177 -> j131435857;
	j2139319721 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j2139319721 -> j1806109479 [label=true,color=green];
		j2139319721 -> j1740816331 [label=false,color=brown];
	j1056749243 [label="Maintenant, je pense que j'adorerais rencontrer cette dame... ",shape=box,color=blue];
		j1056749243 -> j1414924475;
	j951176041 [label="Comment vas-tu te rattraper?",shape=box,color=red];
		j951176041 -> j33410859;
	j1048765611 [label="C'est bon, je plaisante. Je ne suis pas en colère.",shape=box,color=red];
		j1048765611 -> j2529344581;
	j4067946511 [label="C'est tout à fait vrai! Je n'y avais jamais pensé sous cet angle. Et si on pouvait choisir soi-même. Quelle liberté, en soi.",shape=box,color=blue];
		j4067946511 -> j1414924475;
	j243463817 [label="Add 1 to Family counter",color=orange];
		j243463817 -> j872571403;
	j131435857 [label="La résilience de l'âme pourrait te surprendre. Et celles qui m'entourent aujourd'hui sont si vieilles, si profondément marquées par le temps.",shape=box,color=blue];
		j131435857 -> j3460848486;
	j1806109479 [label="C'est possible. Plus facile, peut-être, qu'on ne le pense. Il faut juste réfléchir à la manière d'y parvenir. ",shape=box,color=blue];
		j1806109479 -> j3021405013;
		j1806109479 -> j1616997177;
	j1740816331 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j1740816331 -> j1806109479 [label=true,color=green];
		j1740816331 -> j1602333665 [label=false,color=brown];
	j1414924475 [label="Cette conversation a été formidable, mais je crains que ce soit mon tour de servir le déjeuner. Monsieur Loid m'apprend à servir le thé à sa manière!",shape=box,color=blue];
		j1414924475 -> "Chat ends.";
	j33410859 [label="Maintenant, tu parles aussi mal que le diable. Non, je ne tomberai pas dans ton piège.",shape=box,color=blue];
		j33410859 -> "Chat ends.";
	j2529344581 [label="+5 Chemistry",color=orange];
		j2529344581 -> j971369126;
	j872571403 [label="+5 Chemistry",color=orange];
		j872571403 -> j3079316897;
	j3460848486 [label="+5 Chemistry",color=orange];
		j3460848486 -> j1909958822;
	j3021405013 [label="Il faut juste faire attention. J’ai peur qu’une moitié considère l’autre moitié comme \"l’autre famille\".",shape=box,color=red];
		j3021405013 -> j243463817;
	j1602333665 [label="Oui? Et comment se passe ton travail ou celui de ta minuscule copie avec la famille au-dessus?",shape=box,color=blue];
		j1602333665 -> j1453053671;
		j1602333665 -> j1616997177;
	j971369126 [label="Oh, Sol soit loué! Mais ça soulève une question... Sais-tu d'où vient ton surnom? \"Voyageur\"?",shape=box,color=blue];
		j971369126 -> j2064444251;
		j971369126 -> j4226133188;
	j3079316897 [label="Oh... Par Sol, je pense que tu as peut-être la solution!",shape=box,color=blue];
		j3079316897 -> j3247593892;
	j1909958822 [label="Tu les as surpris à maintes reprises. Laisse-les te surprendre, cette fois.",shape=box,color=blue];
		j1909958822 -> j1551208886;
	j1453053671 [label="Lentement. Prudemment. J'ai peur qu'une moitié considère l'autre moitié comme \"l'autre famille\".",shape=box,color=red];
		j1453053671 -> j243463817;
	j2064444251 [label="J'espère que je l'ai choisi moi-même.",shape=box,color=red];
		j2064444251 -> j2273923356;
	j4226133188 [label="Je ne m'en souviens pas, honnêtement.",shape=box,color=red];
		j4226133188 -> j1419975964;
	j3247593892 [label="Boolean MarieFamilyOther is now true.",color=orange];
		j3247593892 -> j1851676202;
	j1551208886 [label="Mais s'il te plaît, s'il te plaît, continue ton histoire. Ta petite louve Marie doit connaître sa proie avant de chasser correctement, non?",shape=box,color=blue];
		j1551208886 -> j2418667573;
		j1551208886 -> j2477991082;
		j1551208886 -> j1208674697;
	j2273923356 [label="Quelle libération! De pouvoir choisir son propre nom. À la Cathédrale, je ne pouvais même pas choisir mes vêtements. Ah!",shape=box,color=blue];
		j2273923356 -> j1414924475;
	j1419975964 [label="Il y a tant de mystères avec toi! ",shape=box,color=blue];
		j1419975964 -> j1414924475;
	j1851676202 [label="Je ne tiens plus en place - je suis assise ici, tout en remuant sur ma chaise!",shape=box,color=blue];
		j1851676202 -> j1551208886;
	j2418667573 [label="J'en étais où?",shape=box,color=red];
		j2418667573 -> j3531740832;
	j2477991082 [label="C'était un peu vilain de ta part, non?",shape=box,color=red];
		j2477991082 -> j2427635158;
	j1208674697 [label="Peut-être que j'aimerais que tu me chasses...",shape=box,color=red];
		j1208674697 -> j2796661474;
	j3531740832 [label="Le Fils avait invité les animaux Infestés un peu trop près.",shape=box,color=blue];
		j3531740832 -> j868938993;
	j2427635158 [label="Peut-être! Mais où est le mal si c'est au nom du bien, hmm?",shape=box,color=blue];
		j2427635158 -> j749501616;
		j2427635158 -> j1634491002;
	j2796661474 [label="Boolean DrifterMarie is now true.",color=orange];
		j2796661474 -> j1566292387;
	j749501616 [label="Bon... Bref, revenons à l'histoire.",shape=box,color=red];
		j749501616 -> j868938993;
	j1634491002 [label="Ne le prends pas mal. J'ai apprécié.",shape=box,color=red];
		j1634491002 -> j2428572212;
	j1566292387 [label="Tu vas causer ma perte! J'ai poussé un petit cri et Monsieur Loid m'a demandé si j'allais bien. J'ai dû mentir et dire que j'avais vu une souris, mais il m'a répondu qu'il n'y avait pas de souris à cette époque!",shape=box,color=blue];
		j1566292387 -> j4114985658;
	j2428572212 [label="Ah! Je m'en doutais. Bon, assez de bêtises, revenons à ton histoire. Le Fils avait invité les animaux Infestés trop près, n'est-ce pas?",shape=box,color=blue];
		j2428572212 -> j868938993;
	j4114985658 [label="+5 Chemistry",color=orange];
		j4114985658 -> j3619209200;
	j3619209200 [label="Quelle méchanceté, tu es terrible! Je te déteste et tu me fais rougir, maintenant!",shape=box,color=blue];
		j3619209200 -> j3619303201;
		j3619209200 -> j749501616;
	j3619303201 [label="Tu es en colère contre moi?",shape=box,color=red];
		j3619303201 -> j1095590560;
	j1095590560 [label="Non! Continue simplement ton histoire!",shape=box,color=blue];
		j1095590560 -> j868938993;
}