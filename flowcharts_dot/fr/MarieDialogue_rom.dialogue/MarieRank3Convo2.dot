		1067 -> 1072;
	1068 [label="Les animaux n'ont pas de nom et ils semblent parfaitement heureux. Nous leur donnons des noms simplement pour notre propre plaisir.",shape=box,color=red];
		1068 -> 1073;
	1063 [label="L'idée me fait sourire. Mais je ne pense pas que ce serait judicieux.",shape=box,color=red];
