	2925 [label="J'ai eu ces conversations... rencontré ces personnes... bien que ce soit impossible, n'est-ce pas?",shape=box,color=blue];
		2925 -> 2926;
	1017 [label="Pourrais-tu m'en dire plus sur la famille du Cardinal? Je suis fascinée de connaître son passé.",shape=box,color=blue];
		1017 -> 1020;
		1017 -> 1021;
		1017 -> 1019;
	1018 [label="Pourrais-tu me parler de la famille du Cardinal? Je suis fascinée de connaître son passé.",shape=box,color=blue];
		1018 -> 1020;
		1018 -> 1021;
		1018 -> 1019;
	2926 [label="+20 Chemistry",color=orange];
		2926 -> 2927;
	1020 [label="Je vais te dire tout ce que je sais, mais j'ai peur de ne pas en savoir autant que tu pourrais le penser.",shape=box,color=red];
		1020 -> 1023;
	1021 [label="Oh. Bien sûr, mais... Loid ne serait-il pas la meilleure personne à qui parler?",shape=box,color=red];
		1021 -> 1024;
	1019 [label="[Fin.]",shape=box,color=red];
		1019 -> 1022;
	2927 [label="On appelle ça un déjà-vu. Ça doit être à cause du sérum et du voyage dans le temps. C'est la vie!",shape=box,color=blue];
		2927 -> 2928;
	1023 [label="Quoi que tu puisses me dire, je le chérirai. Promis!",shape=box,color=blue];
		1023 -> 1025;
	1024 [label="Parler du Cardinal... semble profondément blesser Monsieur Loid. Je n'aime pas faire ça.",shape=box,color=blue];
		1024 -> 1025;
	1022 [label="Chat ends.",color=orange];
	2928 [label="Chat ends.",color=orange];
	1025 [label="Surtout que je parle de lui avec une certaine joie, et je suis bien la seule à le faire.",shape=box,color=blue];
		1025 -> 1026;
		1025 -> 1027;
	1026 [label="À propos de qui veux-tu en savoir plus?",shape=box,color=red];
		1026 -> 1028;
	1027 [label="Eh bien, il y a la Mère, le Père, le Fils, la Fille et la Grand-mère à l'étage.",shape=box,color=red];
		1027 -> 1028;
	1028 [label="Explique d'abord une chose, veux-tu? Le diable se moque de moi à chaque fois que je le demande, comme si c'était une gaffe. Grand-mère.",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="Ce n'est pas la femme du Cardinal, non?",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="Non, c'est la mère du Père. La belle-mère de Mère.",shape=box,color=red];
		1030 -> 1031;
	1031 [label="Je... vois. Et... pourquoi n'utilisent-ils pas leur nom? Ne serait-ce pas plus simple?",shape=box,color=blue];
		1031 -> 1032;
		1031 -> 1033;
	1032 [label="Tu veux la version longue?",shape=box,color=red];
		1032 -> 1034;
	1033 [label="Je vais te résumer l'essentiel.",shape=box,color=red];
		1033 -> 1035;
	1034 [label="Oui! Je n'ai nulle part où aller pendant un petit moment.",shape=box,color=blue];
		1034 -> 1036;
	1035 [label="La famille à l'étage a été piégée ici lors de l'effondrement de l'Empire Orokin. Le petit-fils d'Entrati a laissé entrer l'Infestation.",shape=box,color=red];
		1035 -> 1037;
	1036 [label="Eh bien, nous sommes sur une lune appelée Deimos. Et une bombe biologique a explosé ici, il y a longtemps, dans une tentative désespérée de repousser les Sentients.",shape=box,color=red];
		1036 -> 1038;
	1037 [label="Par Sol! Exprès?",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="Ceux contre lesquels les Orokins étaient en guerre, il y a longtemps? Ceux que l'on voit dans les Ténèbres Réfractaires avec le diable, oui?",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1039 -> 1041 [label=true,color=green];
		1039 -> 1042 [label=true,color=green];
		1039 -> 1042 [label=false,color=brown];
		1039 -> 1043 [label=false,color=brown];
	1040 [label="Oui. Ils ont tenté d'exploiter l'Infestation pour combattre les Sentients. Mais Deimos a été envahie. Ils se sont enfermés dans le Necralisk, qui se trouve au-dessus de nous, pour s'abriter.",shape=box,color=red];
		1040 -> 1044;
	1041 [label=" Non, je pense que c'était un accident. Je pense qu'il voulait bien faire.",shape=box,color=red];
		1041 -> 1045;
	1042 [label="Je ne connais pas encore la vérité, donc je réserve mon jugement jusqu'à ce que j'en sache plus.",shape=box,color=red];
		1042 -> 1045;
	1043 [label="Je ne connais pas encore la vérité, mais il est arrogant, ça je peux te le dire.",shape=box,color=red];
		1043 -> 1046;
	1044 [label="Le Fils, donc le petit-fils d'Entrati, était cependant déterminé à essayer de préserver et d'étudier les animaux Infestés.",shape=box,color=red];
		1044 -> 1047;
	1045 [label="+10 Chemistry",color=orange];
		1045 -> 1048;
	1046 [label="J'espère que ce n'est pas le cas, pour son bien et le nôtre. Continue, s'il te plaît.",shape=box,color=blue];
		1046 -> 1049;
	1047 [label="Oh, par Sol... avait-il de bonnes intentions?",shape=box,color=blue];
		1047 -> 1076;
	1048 [label="C'est plutôt gentil de ta part. Continue, s'il te plaît.",shape=box,color=blue];
		1048 -> 1049;
	1049 [label="Eh bien, piégés dans le Necralisk, consumés par le chagrin et sans empire Orokin pour les sauver, et maintenant avec l'Infestation qui s'infiltre...",shape=box,color=red];
		1049 -> 1053;
	1076 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1076 -> 1051 [label=true,color=green];
