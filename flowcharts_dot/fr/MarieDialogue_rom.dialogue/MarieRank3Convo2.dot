		1050 -> 1083 [label=true,color=green];
		1050 -> 1084 [label=false,color=brown];
	1085 [label="Cette conversation a été formidable, mais je crains que ce soit mon tour de servir le déjeuner. Monsieur Loid m'apprend à servir le thé à sa manière!",shape=box,color=blue];
