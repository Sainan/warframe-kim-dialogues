		1076 -> 1051 [label=false,color=brown];
		1076 -> 1052 [label=false,color=brown];
		1076 -> 1054 [label=false,color=brown];
	1053 [label="Ils se sont tournés les uns contre les autres. Ils se sont déchirés de l'intérieur. Et l'Infestation a fait le reste, leur arrachant leurs noms. ",shape=box,color=red];
		1053 -> 1058;
	1051 [label="Oui, je crois. Je pense qu'il se soucie sincèrement des créatures.",shape=box,color=red];
		1051 -> 1056;
	1052 [label="Malheureusement, cela n’a pas d’importance, le mal était fait.",shape=box,color=red];
		1052 -> 1057;
	1055 [label="Non, c'est l'arrogance qui l'a inspiré. Même s'il prétend que c'était un accident.",shape=box,color=red];
		1055 -> 1059;
	1054 [label="Je ne connais pas encore la vérité, mais il est arrogant, ça je peux te le dire.",shape=box,color=red];
		1054 -> 1059;
	1058 [label="C'est la forme ultime de la cruauté, d'être privé d'un nom...",shape=box,color=blue];
