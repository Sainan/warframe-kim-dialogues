	1081 [label="Add 1 to Family",color=orange];
		1081 -> 1088;
	1082 [label="La résilience de l'âme pourrait te surprendre. Et celles qui m'entourent aujourd'hui sont si vieilles, si profondément marquées par le temps.",shape=box,color=blue];
		1082 -> 1089;
	1083 [label="C'est possible. Plus facile, peut-être, qu'on ne le pense. Il faut juste réfléchir à la manière d'y parvenir. ",shape=box,color=blue];
