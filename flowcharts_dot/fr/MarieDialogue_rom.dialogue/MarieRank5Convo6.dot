		j4190999030 -> j1188310180 [label="false",color=purple];
		j4190999030 -> j2161486414 [label="false",color=purple];
	j2964676127 [label="Puis-je faire quelque chose pour te remonter le moral? On pourrait aller tourmenter Roathe.",shape=box,color=red];
		j2964676127 -> j3785214133;
	j3558715401 [label="Puis-je faire quelque chose pour te remonter le moral? Peut-être voler quelques pâtisseries?",shape=box,color=red];
		j3558715401 -> j3195159779;
	j1188310180 [label="Parfois, les dieux sont cruels, Marie. C'est la vie.",shape=box,color=red];
		j1188310180 -> j2732339336;
	j2161486414 [label="C'est normal. Tu as parfaitement le droit de l'être.",shape=box,color=red];
		j2161486414 -> j1984170368;
	j3785214133 [label="+15 Chemistry",color=orange];
		j3785214133 -> j2497733149;
	j3195159779 [label="+20 Chemistry",color=orange];
		j3195159779 -> j2497733149;
	j2732339336 [label="+5 Chemistry",color=orange];
		j2732339336 -> j2861128896;
	j1984170368 [label="+20 Chemistry",color=orange];
		j1984170368 -> j1728369739;
	j2497733149 [label="Ah! Merci. Voilà qui va certainement faire sécher mes larmes idiotes. Tu sais comment réconforter la petite Marie, n'est-ce pas?",shape=box,color=blue];
		j2497733149 -> j4245449644;
		j2497733149 -> j4130654607;
	j2861128896 [label="Oui, tu as tout à fait raison. C'est vrai. Le monde regorge d'histoires comme celle de Monsieur Otak et bien d'autres pires encore. Je ne devrais pas m'apitoyer sur son sort. ",shape=box,color=blue];
		j2861128896 -> j3697557016;
	j1728369739 [label="Merci. Bon, je n'ai plus envie de l'être. Je vais faire quelque chose de plus joyeux! Je crois que l'aquarium de Monsieur Fibonacci a besoin d'un petit coup de chiffon.",shape=box,color=blue];
		j1728369739 -> j2425134241;
	j4245449644 [label="Il n'y a rien d'idiot... Je ressens la même chose.",shape=box,color=red];
		j4245449644 -> j2235898819;
	j4130654607 [label="C'est le moins que je puisse faire pour toi.",shape=box,color=red];
		j4130654607 -> j2235898819;
	j3697557016 [label="Et pourtant, me voilà à faire exactement cela. Merci de me rappeler ma bêtise. Fi! Pauvre petite Marie. Bon... je crois que l'aquarium de Monsieur Fibonacci a besoin d'un petit coup de chiffon.",shape=box,color=blue];
		j3697557016 -> j2425134241;
