		3216 -> 3219;
	3217 [label="Et pourtant, me voilà à faire exactement cela. Merci de me rappeler ma bêtise. Fi! Pauvre petite Marie. Bon... je crois que l'aquarium de Monsieur Fibonacci a besoin d'un petit coup de chiffon.",shape=box,color=blue];
