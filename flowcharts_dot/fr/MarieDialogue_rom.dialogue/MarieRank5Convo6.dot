		j3097375491 -> j3046480829 [label=false,color=brown];
	j3304000751 [label="Loup! Mon loup! J'ai rencontré Otak! Je l'ai enfin rencontré!",shape=box,color=blue];
		j3304000751 -> j441237113;
		j3304000751 -> j448426239;
	j2921220079 [label="J'ai rencontré Otak! Je l'ai enfin rencontré!",shape=box,color=blue];
		j2921220079 -> j441237113;
		j2921220079 -> j448426239;
	j2980485375 [label="Loup! Mon loup! Le visage sur le dos de Monsieur Necraloid! Je l'ai enfin rencontré!",shape=box,color=blue];
		j2980485375 -> j4289988967;
		j2980485375 -> j2298618259;
		j2980485375 -> j1318684349;
	j3046480829 [label="Le visage au dos de Monsieur Necraloid! Je l'ai enfin rencontré!",shape=box,color=blue];
		j3046480829 -> j4289988967;
		j3046480829 -> j2298618259;
		j3046480829 -> j1318684349;
	j441237113 [label="Comment s'est passée ta conversation avec lui?",shape=box,color=red];
		j441237113 -> j552316970;
	j448426239 [label="As-tu apprécié ta conversation avec lui?",shape=box,color=red];
		j448426239 -> j3189102580;
	j4289988967 [label="Tu as rencontré Otak? Oh là là... Comment ça s'est passé?",shape=box,color=red];
		j4289988967 -> j1246705421;
	j2298618259 [label="C'est chouette que vous vous soyez enfin rencontrés. Otak peut être un peu difficile à expliquer.",shape=box,color=red];
		j2298618259 -> j2088291113;
	j1318684349 [label="Pauvre Otak... Comment ça s'est passé?",shape=box,color=red];
		j1318684349 -> j3064178277;
	j552316970 [label="Il... s’est présenté à moi à trois reprises au cours de la même conversation, comme si nous ne nous étions jamais rencontrés.",shape=box,color=blue];
		j552316970 -> j3277160474;
	j3189102580 [label="Oui. Même si j'avais peut-être envie de pleurer. Car il s'est présenté à moi trois fois au cours de la même conversation, comme si nous ne nous étions jamais rencontrés.",shape=box,color=blue];
		j3189102580 -> j3277160474;
	j1246705421 [label="Tu n'as pas l'air d'apprécier que je l'aie rencontré?",shape=box,color=blue];
		j1246705421 -> j354662446;
		j1246705421 -> j2077892114;
		j1246705421 -> j4170143449;
	j2088291113 [label="Oui, je le pense aussi. Un gribouillage d'enfant dans le dos d'un automate. Je l'ai trouvé tout simplement adorable et charmant!",shape=box,color=blue];
		j2088291113 -> j2777336225;
	j3064178277 [label="Je l'ai trouvé adorable et charmant! Mais sous une couche d'humour, je ressentais un profond chagrin.",shape=box,color=blue];
		j3064178277 -> j340121817;
	j3277160474 [label="Il m’a saluée avec la même assurance et la même gaieté à chaque fois. Mais il me connaissait comme une Sœur de Sol! ",shape=box,color=blue];
		j3277160474 -> j1504463251;
	j354662446 [label="Pardon. Il peut parfois être agaçant. Ce n'est pas de sa faute.",shape=box,color=red];
		j354662446 -> j1723480857;
	j2077892114 [label="Ce n'est pas ce que je voulais dire. Il peut être un peu... agaçant pour certaines personnes.",shape=box,color=red];
		j2077892114 -> j1723480857;
	j4170143449 [label="Il peut parfois m'agacer, c'est tout. ",shape=box,color=red];
		j4170143449 -> j4236211720;
	j2777336225 [label="Mais sous cette façade humoristique se cache un profond chagrin.",shape=box,color=blue];
		j2777336225 -> j340121817;
	j340121817 [label="Veux-tu me raconter l'histoire du pauvre Monsieur Otak?",shape=box,color=blue];
		j340121817 -> j2958538489;
	j1504463251 [label="En effet, il connaissait très bien les Luminaires! Nous avons longuement parlé des \"anciennes religions\", comme il les appelait, \"à l'époque précédant l'Empire Orokin\".",shape=box,color=blue];
		j1504463251 -> j94909402;
	j1723480857 [label="Et j'espère que tous lui témoigneront gentillesse et patience. Que la grâce de Sol nous éclaire tous.",shape=box,color=blue];
		j1723480857 -> j1475599989;
	j4236211720 [label="J'espère que tu feras preuve de plus de bienveillance envers une personne manifestement malade. Que Sol nous éclaire tous de sa grâce.",shape=box,color=blue];
		j4236211720 -> j1475599989;
	j2958538489 [label="Otak était un Archimédien, un scientifique et savant Orokin. Ce qui lui est arrivé n'est pas vraiment une histoire heureuse.",shape=box,color=red];
		j2958538489 -> j3863087363;
	j94909402 [label="Toutefois, il a affirmé qu'une grande partie de ce savoir était désormais perdue, enfouie au plus profond des archives et formellement interdite. Il m'a fait jurer le secret.",shape=box,color=blue];
		j94909402 -> j1902898527;
	j1475599989 [label="Un tel sort pourrait attendre n'importe lequel d'entre nous. Même toi.",shape=box,color=blue];
		j1475599989 -> j671950163;
		j1475599989 -> j2702074405;
	j3863087363 [label="De l’avis général, il était un génie et l’esprit derrière l’exploitation des cristaux d’argon.",shape=box,color=red];
		j3863087363 -> j2504917741;
	j1902898527 [label="Il m'a dit qu'il craignait sérieusement que l'Exécuteur Ballas, qui qu'il soit, ne découvre ma secte d'hérétiques et ne me fasse exécuter.",shape=box,color=blue];
		j1902898527 -> j2979289105;
		j1902898527 -> j445561211;
	j671950163 [label="Je n'ai tout simplement pas de temps à lui consacrer, je m'excuse.",shape=box,color=red];
		j671950163 -> j1257886890;
	j2702074405 [label="Tu as raison, je m'excuse. Je ne voulais pas dire ça.",shape=box,color=red];
		j2702074405 -> j340121817;
	j2504917741 [label="Qui sont exploités à partir du Néant - ils sont la raison pour laquelle nous pouvons créer un grand nombre de warframes et d'armes puissantes.",shape=box,color=red];
		j2504917741 -> j2709923193;
	j2979289105 [label="Ça... n'arrivera pas. Continue.",shape=box,color=red];
		j2979289105 -> j1543229393;
	j445561211 [label="Ballas est mort... continue.",shape=box,color=red];
		j445561211 -> j1543229393;
	j1257886890 [label="Je regrette donc de t'en faire perdre davantage.",shape=box,color=blue];
		j1257886890 -> j3007723528;
	j2709923193 [label="Il s'est spécialisé en cristallographie. Ses travaux étaient archivés ici, dans les laboratoires.",shape=box,color=red];
		j2709923193 -> j17021038;
	j1543229393 [label="+5 Chemistry",color=orange];
		j1543229393 -> j2522164595;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j17021038 [label="Pour une raison que j'ignore, il a été transformé en Céphalon et a reçu sa propre carapace de Necraloid.",shape=box,color=red];
		j17021038 -> j1354167659;
	j2522164595 [label="Je m'en doutais... Enfin, il m’a demandé d’où je venais et quand je le lui ai dit, il a ri et a répondu: \"Non, c’est impossible! Et je devrais le savoir, je suis...\"",shape=box,color=blue];
		j2522164595 -> j384024486;
	j1354167659 [label="Tous les Céphalons n'ont pas été créés en guise de châtiment. Mais les choses ont... mal tourné sur Deimos et il a été gravement endommagé.",shape=box,color=red];
		j1354167659 -> j646397063;
	j384024486 [label="Puis il... s’est présenté de nouveau. Et m’a demandé si je venais des plaines avec des échantillons de minéraux...",shape=box,color=blue];
		j384024486 -> j2959415761;
		j384024486 -> j1089331814;
	j646397063 [label="Pauvre petit...",shape=box,color=blue];
		j646397063 -> j1698645168;
	j2959415761 [label="Oh, Marie. Je ne sais pas quoi dire...",shape=box,color=red];
		j2959415761 -> j2778052103;
	j1089331814 [label="Ouais... c'est Otak.",shape=box,color=red];
		j1089331814 -> j2778052103;
	j1698645168 [label="Boolean MarieOtak1 is now true.",color=orange];
		j1698645168 -> j441237113;
		j1698645168 -> j448426239;
	j2778052103 [label="L'idée qu'il n'y ait rien à faire pour lui me brise le cœur.",shape=box,color=blue];
		j2778052103 -> j1970966774;
	j1970966774 [label="Evaluate expressions",color=orange];
		j1970966774 -> j2965345600 [label="MarieCephalonSoul",color=purple];
		j1970966774 -> j3995717482 [label="MarieCephalonNoSoul",color=purple];
		j1970966774 -> j727616778 [label="MarieCephalonUnsure",color=purple];
		j1970966774 -> j3551335110 [label="false",color=purple];
	j2965345600 [label="Ô Luminaires, quel enfer lui avez-vous réservé pour garder son âme prisonnière de cette cage de science et de lumières vacillantes ?",shape=box,color=blue];
		j2965345600 -> j3195233151;
	j3995717482 [label="Je ne peux que prier les Luminaires pour que tu aies raison et qu'il ne reste rien à l'intérieur de cette coquille, si ce n'est... la science et des lumières vacillantes.",shape=box,color=blue];
		j3995717482 -> j1020239386;
	j727616778 [label="Je sais que tu ignores si les Céphalons contiennent des âmes, mais je ne peux que prier les Luminaires pour que... le pauvre Otak ne souffre pas.",shape=box,color=blue];
		j727616778 -> j3502908953;
	j3551335110 [label="Je ne peux que prier les Luminaires pour que tout ce qui reste à l'intérieur de cette coquille ne soit rien d'autre que... de la science et des lumières vacillantes.",shape=box,color=blue];
		j3551335110 -> j3502908953;
	j3195233151 [label="Pourquoi le laisser là, brisé, à attendre la mort pour enfin trouver la paix? Je ne peux que prier... pour que, s’il y a une présence quelconque là-dedans...",shape=box,color=blue];
		j3195233151 -> j1238242891;
	j1020239386 [label="Qu'aucune âme ne soit prisonnière de cette chose brisée qui attend de mourir pour enfin trouver la paix.",shape=box,color=blue];
		j1020239386 -> j2944119944;
	j3502908953 [label="Qu'aucune âme ne soit prisonnière de cette chose brisée qui attend de mourir pour enfin trouver la paix.",shape=box,color=blue];
		j3502908953 -> j4060735371;
	j1238242891 [label="Que ce soit parce qu'il y demeure par choix comme une sorte de veilleur solitaire...",shape=box,color=blue];
		j1238242891 -> j2061288554;
	j2944119944 [label="Car si tu te trompes et qu'une âme reste enfermée dans cette cage contre son gré?",shape=box,color=blue];
		j2944119944 -> j870227681;
	j4060735371 [label="Ou bien, s'il y a une présence quelconque là-dedans, que ce soit parce qu'il reste de son plein gré, comme une sorte de veillée solitaire.",shape=box,color=blue];
		j4060735371 -> j2061288554;
	j2061288554 [label="Penser autrement suffit à remettre en question la bonté des dieux, n'est-ce pas?",shape=box,color=blue];
		j2061288554 -> j3186094683;
	j870227681 [label="Il y a de quoi se demander si les dieux sont réellement bienveillants, n'est-ce pas?",shape=box,color=blue];
		j870227681 -> j3186094683;
	j3186094683 [label="Et alors, où en serais-je?",shape=box,color=blue];
		j3186094683 -> j14586932;
	j14586932 [label="Pardonne-moi, je suis... je suis mélancolique, aujourd'hui.",shape=box,color=blue];
		j14586932 -> j4190999030;
	j4190999030 [label="Evaluate expressions",color=orange];
		j4190999030 -> j2964676127 [label="MarieRoathePastry1",color=purple];
