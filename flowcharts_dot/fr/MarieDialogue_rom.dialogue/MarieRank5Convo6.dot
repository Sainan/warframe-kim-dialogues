	3190 [label="Ô Luminaires, quel enfer lui avez-vous réservé pour garder son âme prisonnière de cette cage de science et de lumières vacillantes ?",shape=box,color=blue];
		3190 -> 3194;
	3189 [label="Je ne peux que prier les Luminaires pour que tu aies raison et qu'il ne reste rien à l'intérieur de cette coquille, si ce n'est... la science et des lumières vacillantes.",shape=box,color=blue];
		3189 -> 3193;
	3188 [label="Je sais que tu ignores si les Céphalons contiennent des âmes, mais je ne peux que prier les Luminaires pour que... le pauvre Otak ne souffre pas.",shape=box,color=blue];
		3188 -> 3192;
	3187 [label="Je ne peux que prier les Luminaires pour que tout ce qui reste à l'intérieur de cette coquille ne soit rien d'autre que... de la science et des lumières vacillantes.",shape=box,color=blue];
		3187 -> 3191;
	3194 [label="Pourquoi le laisser là, brisé, à attendre la mort pour enfin trouver la paix? Je ne peux que prier... pour que, s’il y a une présence quelconque là-dedans...",shape=box,color=blue];
		3194 -> 3197;
	3193 [label="Qu'aucune âme ne soit prisonnière de cette chose brisée qui attend de mourir pour enfin trouver la paix.",shape=box,color=blue];
		3193 -> 3196;
	3192 [label="Qu'aucune âme ne soit prisonnière de cette chose brisée qui attend de mourir pour enfin trouver la paix.",shape=box,color=blue];
		3192 -> 3195;
	3191 [label="Qu'aucune âme ne soit prisonnière de cette chose brisée qui attend de mourir pour enfin trouver la paix.",shape=box,color=blue];
		3191 -> 3195;
	3197 [label="Que ce soit parce qu'il y demeure par choix comme une sorte de veilleur solitaire...",shape=box,color=blue];
		3197 -> 3200;
	3196 [label="Car si tu te trompes et qu'une âme reste enfermée dans cette cage contre son gré?",shape=box,color=blue];
		3196 -> 3199;
	3195 [label="Ou bien, s'il y a une présence quelconque là-dedans, que ce soit parce qu'il reste de son plein gré, comme une sorte de veillée solitaire.",shape=box,color=blue];
		3195 -> 3198;
	3200 [label="Penser autrement suffit à remettre en question la bonté des dieux, n'est-ce pas?",shape=box,color=blue];
