	3142 [label="Loup! Mon loup! Le visage sur le dos de Monsieur Necraloid! Je l'ai enfin rencontré!",shape=box,color=blue];
		3142 -> 3145;
		3142 -> 3146;
		3142 -> 3147;
	3141 [label="Le visage au dos de Monsieur Necraloid! Je l'ai enfin rencontré!",shape=box,color=blue];
		3141 -> 3145;
		3141 -> 3146;
		3141 -> 3147;
	3143 [label="Comment s'est passée ta conversation avec lui?",shape=box,color=red];
		3143 -> 3148;
	3144 [label="As-tu apprécié ta conversation avec lui?",shape=box,color=red];
		3144 -> 3149;
	3145 [label="Tu as rencontré Otak? Oh là là... Comment ça s'est passé?",shape=box,color=red];
		3145 -> 3150;
	3146 [label="C'est chouette que vous vous soyez enfin rencontrés. Otak peut être un peu difficile à expliquer.",shape=box,color=red];
		3146 -> 3151;
	3147 [label="Pauvre Otak... Comment ça s'est passé?",shape=box,color=red];
		3147 -> 3152;
	3148 [label="Il... s’est présenté à moi à trois reprises au cours de la même conversation, comme si nous ne nous étions jamais rencontrés.",shape=box,color=blue];
		3148 -> 3153;
	3149 [label="Oui. Même si j'avais peut-être envie de pleurer. Car il s'est présenté à moi trois fois au cours de la même conversation, comme si nous ne nous étions jamais rencontrés.",shape=box,color=blue];
		3149 -> 3153;
	3150 [label="Tu n'as pas l'air d'apprécier que je l'aie rencontré?",shape=box,color=blue];
		3150 -> 3154;
		3150 -> 3155;
		3150 -> 3156;
	3151 [label="Oui, je le pense aussi. Un gribouillage d'enfant dans le dos d'un automate. Je l'ai trouvé tout simplement adorable et charmant!",shape=box,color=blue];
		3151 -> 3157;
	3152 [label="Je l'ai trouvé adorable et charmant! Mais sous une couche d'humour, je ressentais un profond chagrin.",shape=box,color=blue];
		3152 -> 3158;
	3153 [label="Il m’a saluée avec la même assurance et la même gaieté à chaque fois. Mais il me connaissait comme une Sœur de Sol! ",shape=box,color=blue];
		3153 -> 3159;
	3154 [label="Pardon. Il peut parfois être agaçant. Ce n'est pas de sa faute.",shape=box,color=red];
		3154 -> 3160;
	3155 [label="Ce n'est pas ce que je voulais dire. Il peut être un peu... agaçant pour certaines personnes.",shape=box,color=red];
		3155 -> 3160;
	3156 [label="Il peut parfois m'agacer, c'est tout. ",shape=box,color=red];
		3156 -> 3161;
	3157 [label="Mais sous cette façade humoristique se cache un profond chagrin.",shape=box,color=blue];
		3157 -> 3158;
	3158 [label="Veux-tu me raconter l'histoire du pauvre Monsieur Otak?",shape=box,color=blue];
		3158 -> 3162;
	3159 [label="En effet, il connaissait très bien les Luminaires! Nous avons longuement parlé des \"anciennes religions\", comme il les appelait, \"à l'époque précédant l'Empire Orokin\".",shape=box,color=blue];
		3159 -> 3163;
	3160 [label="Et j'espère que tous lui témoigneront gentillesse et patience. Que la grâce de Sol nous éclaire tous.",shape=box,color=blue];
		3160 -> 3164;
	3161 [label="J'espère que tu feras preuve de plus de bienveillance envers une personne manifestement malade. Que Sol nous éclaire tous de sa grâce.",shape=box,color=blue];
		3161 -> 3164;
	3162 [label="Otak était un Archimédien, un scientifique et savant Orokin. Ce qui lui est arrivé n'est pas vraiment une histoire heureuse.",shape=box,color=red];
		3162 -> 3165;
	3163 [label="Toutefois, il a affirmé qu'une grande partie de ce savoir était désormais perdue, enfouie au plus profond des archives et formellement interdite. Il m'a fait jurer le secret.",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="Un tel sort pourrait attendre n'importe lequel d'entre nous. Même toi.",shape=box,color=blue];
		3164 -> 3167;
		3164 -> 3168;
	3165 [label="De l’avis général, il était un génie et l’esprit derrière l’exploitation des cristaux d’argon.",shape=box,color=red];
		3165 -> 3169;
	3166 [label="Il m'a dit qu'il craignait sérieusement que l'Exécuteur Ballas, qui qu'il soit, ne découvre ma secte d'hérétiques et ne me fasse exécuter.",shape=box,color=blue];
		3166 -> 3170;
		3166 -> 3171;
	3167 [label="Je n'ai tout simplement pas de temps à lui consacrer, je m'excuse.",shape=box,color=red];
		3167 -> 3172;
	3168 [label="Tu as raison, je m'excuse. Je ne voulais pas dire ça.",shape=box,color=red];
		3168 -> 3158;
	3169 [label="Qui sont exploités à partir du Néant - ils sont la raison pour laquelle nous pouvons créer un grand nombre de warframes et d'armes puissantes.",shape=box,color=red];
		3169 -> 3173;
	3170 [label="Ça... n'arrivera pas. Continue.",shape=box,color=red];
		3170 -> 3174;
	3171 [label="Ballas est mort... continue.",shape=box,color=red];
		3171 -> 3174;
	3172 [label="Je regrette donc de t'en faire perdre davantage.",shape=box,color=blue];
		3172 -> 3175;
	3173 [label="Il s'est spécialisé en cristallographie. Ses travaux étaient archivés ici, dans les laboratoires.",shape=box,color=red];
		3173 -> 3176;
	3174 [label="+5 Chemistry",color=orange];
		3174 -> 3177;
	3175 [label="Update boolean MarieOtakComplete",color=orange];
		3175 -> 3178;
	3176 [label="Pour une raison que j'ignore, il a été transformé en Céphalon et a reçu sa propre carapace de Necraloid.",shape=box,color=red];
		3176 -> 3179;
	3177 [label="Je m'en doutais... Enfin, il m’a demandé d’où je venais et quand je le lui ai dit, il a ri et a répondu: \"Non, c’est impossible! Et je devrais le savoir, je suis...\"",shape=box,color=blue];
		3177 -> 3180;
	3178 [label="Chat ends.",color=orange];
	3179 [label="Tous les Céphalons n'ont pas été créés en guise de châtiment. Mais les choses ont... mal tourné sur Deimos et il a été gravement endommagé.",shape=box,color=red];
		3179 -> 3181;
	3180 [label="Puis il... s’est présenté de nouveau. Et m’a demandé si je venais des plaines avec des échantillons de minéraux...",shape=box,color=blue];
		3180 -> 3182;
		3180 -> 3183;
