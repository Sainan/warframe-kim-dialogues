	j99355602 [label="Marie, ce n'est pas un dieu. C'est juste un homme. Il est tout aussi arrogant et tout aussi dangereux que Roathe. Il vient de la même société et souffre des mêmes problèmes.",shape=box,color=red];
		j99355602 -> j194038095;
	j4062337125 [label="Je sais qu'il était gentil avec toi. Je sais qu'il se comportait peut-être différemment avec toi qu'avec beaucoup d'autres. Il te traitait peut-être même comme sa fille... Mais s'il te plaît, prends du recul.",shape=box,color=red];
