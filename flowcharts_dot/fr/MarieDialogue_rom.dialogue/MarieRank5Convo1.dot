digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank5Convo1 begins." [color=orange];
		"MarieRank5Convo1 begins." -> j1133337764;
	j1133337764 [label="On peut parler?",shape=box,color=blue];
		j1133337764 -> j709500590;
	j709500590 [label="Evaluate expressions",color=orange];
		j709500590 -> j3110403136 [label="MarieEntrati4a",color=purple];
		j709500590 -> j1989806118 [label="MarieEntrati4b",color=purple];
		j709500590 -> j3405530999 [label="MarieEntrati3a",color=purple];
		j709500590 -> j1439149392 [label="MarieEntrati3b",color=purple];
		j709500590 -> j2294983132 [label="MarieEntrati3",color=purple];
		j709500590 -> j3409535559 [label="false",color=purple];
	j3110403136 [label="J'ai réfléchi à ce que tu as dit à propos du Cardinal. Que ses actions sont... un mélange de bienveillance et de méchanceté.",shape=box,color=blue];
		j3110403136 -> j1525549978;
	j1989806118 [label="J'ai beaucoup réfléchi à tes propos concernant le Cardinal. Que ses actions ont causé de la souffrance à Lyon.",shape=box,color=blue];
		j1989806118 -> j1525549978;
	j3405530999 [label="J'ai repensé à notre conversation concernant Monsieur Tagfer et à tes arguments convaincants expliquant pourquoi il déteste autant le Cardinal.",shape=box,color=blue];
		j3405530999 -> j1525549978;
	j1439149392 [label="J'ai repensé à ma dispute avec Monsieur Tagfer et aux raisons pour lesquelles il méprise tant le Cardinal.",shape=box,color=blue];
		j1439149392 -> j1525549978;
	j2294983132 [label="J'ai beaucoup réfléchi à ma dispute avec Monsieur Tagfer et à notre dispute à propos de cette dispute.",shape=box,color=blue];
		j2294983132 -> j1525549978;
	j3409535559 [label="J'ai le sentiment que beaucoup de choses restent tues au sujet du Cardinal. Les autres semblent marcher sur des œufs en ma présence, craignant de parler de lui.",shape=box,color=blue];
		j3409535559 -> j1525549978;
	j1525549978 [label="Je sais que d'autres aimeraient le dépeindre comme un vaurien, un fou, un traître. Mais pour moi, il n'était pas ainsi.",shape=box,color=blue];
		j1525549978 -> j2718976672;
	j2718976672 [label="Check boolean MarieBackstory1",color=orange];
		j2718976672 -> j153148245 [label=true,color=green];
		j2718976672 -> j2894471009 [label=false,color=brown];
	j153148245 [label="Peut-être parce que je suis habituée à être abandonnée. ",shape=box,color=blue];
		j153148245 -> j206275092;
	j2894471009 [label="J'ai été abandonnée par ma famille, laissée à la rue quand j'étais enfant, parce que j'étais... anormale. Brisée. Indigne de la haute société.",shape=box,color=blue];
		j2894471009 -> j206275092;
	j206275092 [label="Peut-être est-ce parce que je n'ai jamais eu de père à proprement parler que je suis si prompte à lui pardonner son absence.",shape=box,color=blue];
		j206275092 -> j4106479212;
	j4106479212 [label="Evaluate expressions",color=orange];
		j4106479212 -> j1459699873 [label="MarieEntrati4a",color=purple];
		j4106479212 -> j310917363 [label="MarieEntrati4b",color=purple];
		j4106479212 -> j4124707214 [label="MarieEntrati3a",color=purple];
		j4106479212 -> j547278876 [label="MarieEntrati3b",color=purple];
		j4106479212 -> j3629020029 [label="MarieEntrati3",color=purple];
		j4106479212 -> j1273210778 [label="false",color=purple];
	j1459699873 [label="Mais il n'en reste pas moins que je lui pardonne. Car je vois plus de valeur dans ses bonnes actions que de mal dans ses mauvaises.",shape=box,color=blue];
		j1459699873 -> j97958562;
		j1459699873 -> j2368262458;
		j1459699873 -> j1324462178;
		j1459699873 -> j3869652188;
		j1459699873 -> j2790587702;
	j310917363 [label="Je prie pour que Lyon soit fort et surmonte la crise de foi qu'il traverse, mais je ne crois pas que ce soit entièrement la faute du Cardinal.",shape=box,color=blue];
		j310917363 -> j97958562;
		j310917363 -> j2368262458;
		j310917363 -> j1324462178;
		j310917363 -> j4048679447;
		j310917363 -> j2193239471;
	j4124707214 [label="J'apprécie donc tes arguments convaincants concernant Monsieur Tagfer et ceux qui ont été lésés par le Cardinal... mais je vois toujours plus de mérite dans ses bonnes actions que de méfaits dans ses mauvaises.",shape=box,color=blue];
		j4124707214 -> j97958562;
		j4124707214 -> j2368262458;
		j4124707214 -> j1324462178;
		j4124707214 -> j2300230843;
		j4124707214 -> j691536838;
	j547278876 [label="Aussi, même si je comprends l'indignation de Monsieur Tagfer et que je partage son point de vue, il faut néanmoins trouver la force de pardonner au Cardinal. Car je vois plus de valeur dans les bonnes actions du Cardinal que de mal dans ses méfaits.",shape=box,color=blue];
		j547278876 -> j97958562;
		j547278876 -> j2368262458;
		j547278876 -> j1324462178;
		j547278876 -> j2993030974;
		j547278876 -> j4091407078;
	j3629020029 [label="Ainsi, même si j'apprécie les histoires que chacun raconte sur le Cardinal, en particulier celles de Monsieur Tagfer, j'accorde plus d'importance à ses bonnes actions qu'à ses mauvaises.",shape=box,color=blue];
		j3629020029 -> j97958562;
		j3629020029 -> j2368262458;
		j3629020029 -> j1324462178;
		j3629020029 -> j2104103162;
	j1273210778 [label="Ainsi, même si j'apprécie les histoires que chacun raconte sur le Cardinal, j'accorde plus d'importance à ses bonnes actions qu'à ses mauvaises.",shape=box,color=blue];
		j1273210778 -> j97958562;
		j1273210778 -> j2368262458;
		j1273210778 -> j1324462178;
	j97958562 [label="Je ne te reproche pas d'apprécier le bien qu'il a fait dans ta vie, de la même manière que je ne reproche pas aux autres de s'indigner du mal qu'il cause dans la leur.",shape=box,color=red];
		j97958562 -> j2668143579;
	j2368262458 [label="Je ne sais pas. Je pense que ses actes ont fait beaucoup plus de mal que de bien. J'aimerais que tu puisses le voir.",shape=box,color=red];
		j2368262458 -> j4288371264;
	j1324462178 [label="Je suis de ton côté, Marie. Je ne peux rien reprocher à Entrati pour ce qu'il a fait. Il lutte contre l'Indifférence.",shape=box,color=red];
		j1324462178 -> j3142094137;
	j3869652188 [label="Tu as raison de pardonner à Entrati. J'aimerais que d'autres suivent ton exemple.",shape=box,color=red];
		j3869652188 -> j3142094137;
	j2790587702 [label="Je ne reprocherai jamais à quelqu'un de pardonner. Mais on peut pardonner à quelqu'un tout en comprenant qu'il faut se protéger soi-même et protéger les autres.",shape=box,color=red];
		j2790587702 -> j133620488;
	j4048679447 [label="Tu penses que les souffrances de Lyon sont de sa propre faute?",shape=box,color=red];
		j4048679447 -> j2222448411;
	j2193239471 [label="Les souffrances de Lyon sont bien plus qu'une crise de foi, Marie. Et Entrati y est pour beaucoup.",shape=box,color=red];
		j2193239471 -> j4288371264;
	j2300230843 [label="Rien de ce que j'ai dit n'a contribué à rétablir l'équilibre, même pas un peu?",shape=box,color=red];
		j2300230843 -> j3335556320;
	j691536838 [label="Comment peux-tu regarder tout ce qu'Entrati a fait et y voir encore plus de bien que de mal?",shape=box,color=red];
		j691536838 -> j4288371264;
	j2993030974 [label="Je pense que tu minimises la gravité de ce qu'ont subi les Cavias et Tagfer.",shape=box,color=red];
		j2993030974 -> j4288371264;
	j4091407078 [label="Le pardon est important. Mais il est tout aussi important de reconnaître qu'Entrati est peut-être plus complexe que tu ne veux l'admettre.",shape=box,color=red];
		j4091407078 -> j3335556320;
	j2104103162 [label="Je ne crois toujours pas que tu comprennes ce que Tagfer et les Cavias ont enduré. C'est pire que ce que tu as vécu.",shape=box,color=red];
		j2104103162 -> j4288371264;
	j2668143579 [label="Mais vois-tu en quoi les deux n'ont pas la même valeur? Le ressentiment et la vénération? Je souhaite que les autres renoncent à leurs rancunes malveillantes.",shape=box,color=blue];
		j2668143579 -> j1833588818;
		j2668143579 -> j1495605108;
	j4288371264 [label="Evaluate expressions",color=orange];
		j4288371264 -> j1047457051 [label="MarieEntratiMonster1",color=purple];
		j4288371264 -> j1047457051 [label="MarieEntratiMonster2",color=purple];
		j4288371264 -> j2144592495 [label="MarieEntratiFan1",color=purple];
		j4288371264 -> j2144592495 [label="MarieEntratiFan2",color=purple];
		j4288371264 -> j1297051514 [label="false",color=purple];
	j3142094137 [label="Evaluate expressions",color=orange];
		j3142094137 -> j684101102 [label="MarieEntratiMonster1",color=purple];
		j3142094137 -> j684101102 [label="MarieEntratiMonster2",color=purple];
		j3142094137 -> j610675381 [label="MarieEntratiFan1",color=purple];
		j3142094137 -> j610675381 [label="MarieEntratiFan2",color=purple];
		j3142094137 -> j1440577826 [label="false",color=purple];
	j133620488 [label="Et qu'est-ce que tu suggères? Exclure le Cardinal? J'aurais tendance à dire qu'il l'a déjà fait lui-même, non?",shape=box,color=blue];
		j133620488 -> j501454401;
		j133620488 -> j1495605108;
	j2222448411 [label="Je pense que Lyon souffre de nombreux maux, dont beaucoup sont dus à des doutes sur lui-même et sur ses propres facultés. Le Cardinal semble avoir... seulement précipité les choses.",shape=box,color=blue];
		j2222448411 -> j3469234399;
		j2222448411 -> j1495605108;
	j3335556320 [label="Que veux-tu que je fasse? Brûler une effigie du Cardinal et le dénoncer? Le condamner au Néant, lui souhaiter du mal comme Monsieur Tagfer?",shape=box,color=blue];
		j3335556320 -> j501454401;
		j3335556320 -> j1495605108;
	j1833588818 [label="Voilà le problème, Marie. Ce que tu demandes aux autres, pas ce qu'ils te demandent à toi. Ni à Entrati.",shape=box,color=red];
		j1833588818 -> j3598461587;
	j1495605108 [label="Entrati laisse de la douleur partout où il passe. J'essaie simplement d'aider ces personnes à se reconstruire. La notion de \"bien\" ou de \"mal\" dans son cas m'importe peu.",shape=box,color=red];
		j1495605108 -> j1448923500;
	j1047457051 [label="Oui, et tu gardes une telle constance dans ta haine envers lui! Rien de ce que j'ai dit n'a-t-il réussi à adoucir tes sentiments envers Cardinal?",shape=box,color=blue];
		j1047457051 -> j3087874931;
	j2144592495 [label="N'étais-tu pas en train de me dire, il y a quelques instants, que tu soutiens Entrati, comme moi? Qu'est-ce qui t'a fait changer d'avis?",shape=box,color=blue];
		j2144592495 -> j66878179;
		j2144592495 -> j1346982113;
		j2144592495 -> j2053878819;
		j2144592495 -> j1278618285;
	j1297051514 [label="Oui, et tu sembles considérer Entrati comme un monstre! Tout pour rejeter sa gentillesse!",shape=box,color=blue];
		j1297051514 -> j3087874931;
	j684101102 [label="N'étais-tu pas en train de me parler de la monstruosité d'Entrati quelques instants auparavant? Qu'est-ce qui t'a fait changer d'avis?",shape=box,color=blue];
		j684101102 -> j66878179;
		j684101102 -> j1346982113;
		j684101102 -> j2053878819;
		j684101102 -> j1278618285;
	j610675381 [label="Merci, et tu m'accompagnes fidèlement dans cette croisade! Je crains qu'il n'y ait que nous... même Monsieur Loid éprouve un tel ressentiment...",shape=box,color=blue];
		j610675381 -> j3033461530;
	j1440577826 [label="Merci, et quel plaisir de l'apprendre! Je crains qu'il n'y ait que nous à penser de la sorte – même Monsieur Loid nourrit un tel ressentiment…",shape=box,color=blue];
		j1440577826 -> j3033461530;
	j501454401 [label="Je pense que le problème réside davantage dans ce que tu demandes aux autres et non dans ce qu'ils te demandent à toi. Ou à Entrati.",shape=box,color=red];
		j501454401 -> j3598461587;
	j3469234399 [label="Et ça ne te dérange pas?",shape=box,color=red];
		j3469234399 -> j2159116448;
	j3598461587 [label="Et qu’est-ce que je demande aux autres de si grotesque? Qu’ils acceptent le pardon dans leur cœur?",shape=box,color=blue];
		j3598461587 -> j1446854087;
		j3598461587 -> j526888052;
	j1448923500 [label="Noble, quoique fastidieux, de voyager à travers le temps et l'espace pour venir en aide à des mécontents, non? Tu dois sûrement lui en vouloir...",shape=box,color=blue];
		j1448923500 -> j3017073080;
		j1448923500 -> j190162372;
	j3087874931 [label="Cette conversation était une erreur...",shape=box,color=blue];
		j3087874931 -> j4202145990;
		j3087874931 -> j2466191896;
	j66878179 [label="J'ai vraiment eu beaucoup de mal à aborder ce sujet avec toi. C'était même pénible. Personnellement, je pense qu'il n'est ni bon ni mauvais. Un mélange des deux.",shape=box,color=red];
		j66878179 -> j3361199640;
	j1346982113 [label="J'ai changé d'avis. Je suis de son côté. Et du tien. Tu as réussi à me convaincre.",shape=box,color=red];
		j1346982113 -> j3559430519;
	j2053878819 [label="[Avouer vos sentiments.] J'ai vraiment essayé de faire de mon mieux pour... me faire bien voir, malheureusement. J'ai des sentiments pour toi. Plus que je ne le laisse paraître.",shape=box,color=red];
		j2053878819 -> j3088799751;
	j1278618285 [label="J'ai changé d'avis et j'ai décidé que c'est un monstre. Une fois pour toutes.",shape=box,color=red];
		j1278618285 -> j1378044811;
	j3033461530 [label="Ensemble, nous pourrons peut-être nous dresser contre ceux qui voudraient ternir ses bonnes actions, n'est-ce pas? Mais je me demande, pourquoi prends-tu mon parti?",shape=box,color=blue];
		j3033461530 -> j1498319439;
	j2159116448 [label="Check boolean LyonDating",color=orange];
		j2159116448 -> j3188137963 [label=true,color=green];
		j2159116448 -> j3354546594 [label=false,color=brown];
	j1446854087 [label="Tu idéalises Entrati, Marie. Et tu demandes aux autres d'en faire autant, comme s'ils étaient idiots.",shape=box,color=red];
		j1446854087 -> j3577253739;
	j526888052 [label="Je crois que tu leur demandes plus que de simplement pardonner à Entrati. Je crois que tu leur demandes de faire comme si rien de ce qu'il a fait n'était répréhensible.",shape=box,color=red];
		j526888052 -> j668314369;
	j3017073080 [label="Bien sûr. Mais je lui dois aussi certaines des relations et amitiés les plus importantes que j'aie jamais nouées.",shape=box,color=red];
		j3017073080 -> j319134003;
	j190162372 [label="Non, pas vraiment. Il faut que je le fasse, alors je le ferai. Je le jugerai une fois que tout sera fini.",shape=box,color=red];
		j190162372 -> j319134003;
	j4202145990 [label="Attends, Marie. S'il te plaît. Laisse-moi t'expliquer.",shape=box,color=red];
		j4202145990 -> j2825479710;
		j4202145990 -> j3429905754;
		j4202145990 -> j3778861971;
		j4202145990 -> j328910388;
	j2466191896 [label="J'ai clairement exprimé mon opinion sur Entrati. Pardon. Sur certains points, nous ne sommes pas d'accord.",shape=box,color=red];
		j2466191896 -> j2985717908;
	j3361199640 [label="Boolean MarieEntratiMonster1 is now false.",color=orange];
		j3361199640 -> j4260531401;
	j3559430519 [label="Boolean MarieEntratiMonster1 is now false.",color=orange];
		j3559430519 -> j262727235;
	j3088799751 [label="Boolean DrifterMarieWhoops is now true.",color=orange];
		j3088799751 -> j3935410491;
	j1378044811 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1378044811 -> j3685638222;
	j1498319439 [label="Je ne me plains pas, évidemment!",shape=box,color=blue];
		j1498319439 -> j2040162123;
		j1498319439 -> j2555065993;
		j1498319439 -> j832494073;
	j3188137963 [label="Je sais qu'il a trouvé une place dans ton cœur et j'en suis profondément reconnaissante – peut-être vais-je enfin pouvoir cesser de m'inquiéter pour lui et que toutes ces disputes deviendront bientôt vaines.",shape=box,color=blue];
		j3188137963 -> j3354546594;
	j3354546594 [label="Mais bien sûr que ça me dérange. Il est mon frère de cœur! Mon Lyon est ce que j'ai de plus cher au monde et le voir souffrir me déchire le cœur, comme si sa douleur était la mienne.",shape=box,color=blue];
		j3354546594 -> j190755856;
	j3577253739 [label="Surveille tes paroles, Voyageur.",shape=box,color=blue];
		j3577253739 -> j1083522053;
	j668314369 [label="Je ne suis pas naïve, ne me parle pas comme ça!",shape=box,color=blue];
		j668314369 -> j3033686723;
	j319134003 [label="Peut-être ne fait-il qu'injecter un poison pour que le corps puisse guérir. Peut-être que tout cela est une cruauté nécessaire.",shape=box,color=blue];
		j319134003 -> j2687034111;
		j319134003 -> j1521036821;
	j2825479710 [label="[Avouer vos sentiments.] Je tiens à toi. Plus que je ne l'ai laissé paraître. Et je... Je te demande pardon si j'ai été brusque, mais je ne peux pas le laisser te faire du mal. Pas comme il en a fait à tant d'autres.",shape=box,color=red];
		j2825479710 -> j3286076832;
	j3429905754 [label="J'ai vu Entrati détruire tous ceux qu'il aimait. Tous ceux qu'il prétendait aimer. Je ne veux pas qu'il te fasse la même chose...",shape=box,color=red];
		j3429905754 -> j40530627;
	j3778861971 [label="Je ne suis pas très diplomate et je m'en excuse. Mais il... j'ai bien peur qu'il profite de toi et de ta gentillesse pour te manipuler. C'est tout.",shape=box,color=red];
		j3778861971 -> j4287392273;
	j328910388 [label="Tu vois peut-être Entrati comme un sauveur, mais je le vois comme un vieil homme apeuré, en quête désespérée de réponses. La vérité se trouve peut-être quelque part entre les deux.",shape=box,color=red];
		j328910388 -> j3577253739;
	j2985717908 [label="Oui. On dirait.",shape=box,color=blue];
		j2985717908 -> j3051126039;
	j4260531401 [label="Boolean MarieEntratiMonster2 is now false.",color=orange];
		j4260531401 -> j3511760081;
	j262727235 [label="Boolean MarieEntratiMonster2 is now false.",color=orange];
		j262727235 -> j725879012;
	j3935410491 [label="Et tu as décidé de me tromper pour gagner mes faveurs... je vois.",shape=box,color=blue];
		j3935410491 -> j3109204812;
		j3935410491 -> j4272519895;
	j3685638222 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j3685638222 -> j2956595104;
	j2040162123 [label="[Avouer vos sentiments.] Je tiens à toi. Plus que je ne l'ai laissé paraître.",shape=box,color=red];
		j2040162123 -> j3768871575;
	j2555065993 [label="Je crois qu'il ne faut reculer devant rien dans cette guerre. Après tout, nous essayons de sauver l'univers contre l'Indifférence, n'est-ce pas?",shape=box,color=red];
		j2555065993 -> j43735650;
	j832494073 [label="Je crois en Entrati. Honnêtement. Je pense qu'il a un plan pour résoudre ce problème et que tout cela a été fait pour le bien de tous.",shape=box,color=red];
		j832494073 -> j2023054595;
	j190755856 [label="Mais la baisse de sa foi n'est pas l'œuvre du Cardinal. La fissure dans les fondements existait déjà. Il a simplement ajouté de la pression, n'est-ce pas?",shape=box,color=blue];
		j190755856 -> j319134003;
	j1083522053 [label="Boolean MarieWarning is now true.",color=orange];
		j1083522053 -> j668314369;
	j3033686723 [label="Je sais pertinemment bien que le Cardinal est à la fois Lua et Sol – lumière et ténèbres – bien et mal. Il n'est ni l'un ni l'autre et les deux à la fois, capable de bonté comme de cruauté.",shape=box,color=blue];
		j3033686723 -> j99355602;
		j3033686723 -> j4062337125;
	j2687034111 [label="Voilà pourquoi les autres s'énervent quand tu parles de lui. Tu passes sous silence tout ce qu'il leur a fait de mal et tu fais comme si de rien n'était.",shape=box,color=red];
		j2687034111 -> j3577253739;
	j1521036821 [label="Marie, arrête. Tu dois accepter qu'il n'agit pas ainsi uniquement par pure bonté d'âme. Ce n'est pas le cas. Il est bien plus complexe que cela.",shape=box,color=red];
		j1521036821 -> j668314369;
	j3286076832 [label="Boolean DrifterMarie is now true.",color=orange];
		j3286076832 -> j1021029685;
	j40530627 [label="Surveille tes paroles, Voyageur.",shape=box,color=blue];
		j40530627 -> j2154129713;
	j4287392273 [label="Je n'ai pas besoin d'être protégée! Je ne suis pas une enfant naïve!",shape=box,color=blue];
		j4287392273 -> j1217821418;
	j3051126039 [label="Boolean MarieEntrati5g is now true.",color=orange];
		j3051126039 -> "Chat ends. Next chat will be MarieEntratiDay2.";
	j3511760081 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j3511760081 -> j1929483885;
	j725879012 [label="Boolean MarieEntratiFan2 is now true.",color=orange];
		j725879012 -> j1298567224;
	j3109204812 [label="Eh bien, dit comme ça...",shape=box,color=red];
		j3109204812 -> j1073700449;
	j4272519895 [label="Seulement en partie.",shape=box,color=red];
		j4272519895 -> j1073700449;
	j2956595104 [label="Boolean MarieEntratiMonster2 is now true.",color=orange];
		j2956595104 -> j292601544;
	j3768871575 [label="Boolean DrifterMarieWhoops is now true.",color=orange];
		j3768871575 -> j3290354796;
	j43735650 [label="Oui! Exactement! Enfin quelqu'un de sensé. Ça me brise le cœur que des innocents soient blessés dans cette guerre, mais l'enjeu est trop important. ",shape=box,color=blue];
