		j840480622 -> j1930616924;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j469300747 [label="Mon cher Lyon était déjà établi depuis longtemps à la Cathédrale lorsque la Mère Supérieure m'a accueillie et que j'ai rejoint l'Église des Luminaires comme Sœur. (Je suis ravie que vous vous parliez!)",shape=box,color=blue];
		j469300747 -> j2381129906;
		j469300747 -> j3835921664;
	j1930616924 [label="Je vais te demander de définir cela avant d'aller plus loin. Et je te demanderai de le faire avec douceur, en te rappelant gentiment qu'il est le frère de mon âme.",shape=box,color=blue];
		j1930616924 -> j3351070415;
		j1930616924 -> j3520203536;
	"Chat ends." [color=orange];
	j2381129906 [label="Tu avais... besoin d'un endroit où dormir?",shape=box,color=red];
		j2381129906 -> j4073918540;
	j3835921664 [label="Puis-je poser une question indélicate?",shape=box,color=red];
		j3835921664 -> j2235670101;
	j3351070415 [label="Si cette conversation te dérange, nous pouvons passer à autre chose.",shape=box,color=red];
		j3351070415 -> j2715260357;
	j3520203536 [label="Je ne veux pas te contrarier. Je m'inquiète juste pour lui. Il a l'air stoïque, mais j'ai l'impression qu'il souffre, c'est tout.",shape=box,color=red];
		j3520203536 -> j23370157;
	j4073918540 [label="Parce que ma famille m'a abandonnée il y a bien des années, quand j'étais petite. J'ai passé de nombreuses années à mendier, vivant comme je pouvais.",shape=box,color=blue];
		j4073918540 -> j1038314482;
	j2235670101 [label="+5 Chemistry",color=orange];
		j2235670101 -> j2037210589;
	j2715260357 [label="Non, non. Ça va. Je suis simplement habituée à voir des curieux rôder autour de lui, venant taper sur les barreaux de sa cage comme s'il était une sorte de bête de cirque.",shape=box,color=blue];
		j2715260357 -> j3623287691;
		j2715260357 -> j1738669552;
		j2715260357 -> j879066763;
	j23370157 [label="+5 Chemistry",color=orange];
		j23370157 -> j1076459716;
	j1038314482 [label="Boolean MarieBeggar1 is now true.",color=orange];
		j1038314482 -> j530203942;
	j2037210589 [label="On dit que tu es un loup et avec moi, tu as de telles manières! C'est si beau à voir. Je crois savoir ce que tu veux demander. Pourquoi j'étais dans la rue?",shape=box,color=blue];
		j2037210589 -> j4073918540;
	j3623287691 [label="Comment vous êtes-vous rencontrés?",shape=box,color=red];
		j3623287691 -> j2894239461;
	j1738669552 [label="J'ai l'habitude d'être un peu une \"attraction locale\", je comprends que tu puisses être sur la défensive.",shape=box,color=red];
		j1738669552 -> j736927555;
	j879066763 [label="Tout va bien. Je m'inquiète juste pour lui.",shape=box,color=red];
		j879066763 -> j1931993905;
	j1076459716 [label="Je... suis navrée d'avoir été si brusque. Je suis simplement habituée à voir des curieux rôder autour de lui, venant taper sur les barreaux de sa cage comme s'il était une sorte de bête de cirque.",shape=box,color=blue];
		j1076459716 -> j1738669552;
		j1076459716 -> j879066763;
	j530203942 [label="Tu peux imaginer qu'il n'y avait pas beaucoup de travail ni d'endroits où aller pour quelqu'un comme moi, sans jambes pour travailler, dans la Cité de la Lumière à mon époque.",shape=box,color=blue];
		j530203942 -> j3905923965;
	j2894239461 [label="Mon cher Lyon était déjà établi depuis longtemps à la Cathédrale lorsque la Mère Supérieure m'a accueillie et que j'ai rejoint l'Église des Luminaires comme Sœur.",shape=box,color=blue];
		j2894239461 -> j1035758204;
		j2894239461 -> j895276784;
	j736927555 [label="Oui, j'imagine, une créature voyageant dans le temps, capable de créer des boucles temporelles et de fabriquer des mondes de toutes pièces! Une créature un peu magicienne, non?",shape=box,color=blue];
		j736927555 -> j2270564990;
		j736927555 -> j835731575;
	j1931993905 [label="+5 Chemistry",color=orange];
		j1931993905 -> j1582522170;
	j3905923965 [label="C'est ainsi, je suppose, que Lyon et moi sommes devenus si vite une famille. Jamais il ne m'a regardée avec pitié. Ni moi envers lui.",shape=box,color=blue];
		j3905923965 -> j2052682335;
	j1035758204 [label="Tu avais... besoin d'un endroit où dormir?",shape=box,color=red];
		j1035758204 -> j3670877158;
	j895276784 [label="Puis-je poser une question indélicate?",shape=box,color=red];
		j895276784 -> j1589464184;
	j2270564990 [label="Cela résume assez bien la situation.",shape=box,color=red];
		j2270564990 -> j1068132309;
	j835731575 [label="J’espère que les gens me voient comme... plus que ça, honnêtement.",shape=box,color=red];
		j835731575 -> j3231922858;
	j1582522170 [label="Et ça fait plaisir à entendre. Il est fort et peut résister à tout ce qui lui arrive. Mais les fardeaux sont plus faciles à porter en équipe.",shape=box,color=blue];
		j1582522170 -> j2006258299;
		j1582522170 -> j3107888331;
	j2052682335 [label="Alors que d'autres sont si prompts à tapoter curieusement les barreaux de sa cage comme s'il était une sorte de bête de cirque.",shape=box,color=blue];
		j2052682335 -> j3016155813;
	j3670877158 [label="Parce que ma famille m'a abandonnée il y a bien des années, quand j'étais petite. J'ai passé de nombreuses années à mendier, vivant comme je pouvais.",shape=box,color=blue];
		j3670877158 -> j593776952;
	j1589464184 [label="+5 Chemistry",color=orange];
		j1589464184 -> j1458452486;
	j1068132309 [label="+10 Chemistry",color=orange];
		j1068132309 -> j2792326634;
	j3231922858 [label="+15 Chemistry",color=orange];
		j3231922858 -> j161800871;
	j2006258299 [label="J'ai l'impression qu'il ne veut pas me parler.",shape=box,color=red];
		j2006258299 -> j3345907825;
	j3107888331 [label="Je veux l'aider, si je peux. Tu as des conseils?",shape=box,color=red];
		j3107888331 -> j3345907825;
	j3016155813 [label="J’espère que ce n’est pas ce que tu es en train de faire ici.",shape=box,color=blue];
		j3016155813 -> j2059691014;
		j3016155813 -> j2566658750;
	j593776952 [label="Boolean MarieBeggar1 is now true.",color=orange];
		j593776952 -> j2856270617;
	j1458452486 [label="On dit que tu es un loup et avec moi, tu as de telles manières! C'est si beau à voir. Je crois savoir ce que tu veux demander. Pourquoi j'étais dans la rue?",shape=box,color=blue];
		j1458452486 -> j3670877158;
	j2792326634 [label="Un jour, je crois qu'un livre de contes sera écrit sur toi. Quelle charmante idée! Peut-être que je l'écrirai. Mais ce serait en gaullique! Tu imagines!",shape=box,color=blue];
		j2792326634 -> j1107396668;
	j161800871 [label="Alors, tu comprends vraiment. Je suis plus que Sœur Marie, la pauvre fille sans pieds à qui on a donné le pouvoir de voler. Et Lyon est plus qu'un prêtre tragique qui porte son fardeau en silence.",shape=box,color=blue];
		j161800871 -> j571374058;
	j3345907825 [label="+10 Chemistry",color=orange];
		j3345907825 -> j2219092707;
	j2059691014 [label="J'ai l'habitude d'être un peu une \"attraction locale\", je comprends ce que vous ressentez, tous les deux. Non, ce n'est pas ça. ",shape=box,color=red];
		j2059691014 -> j1251582164;
	j2566658750 [label="Non, simple curiosité. Et honnêtement, je m'inquiète un peu pour lui. Je pense qu'il cache beaucoup sa douleur.",shape=box,color=red];
		j2566658750 -> j2851022357;
	j2856270617 [label="Tu peux imaginer qu'il n'y avait pas beaucoup de travail ni d'endroits où aller pour quelqu'un comme moi, sans jambes pour travailler, dans la Cité de la Lumière à mon époque.",shape=box,color=blue];
		j2856270617 -> j2627417957;
	j1107396668 [label="Ou peut-être, n'imagine rien de tel... ça pourrait se réaliser. Ha! Et sur cette note merveilleuse, je crains de devoir te dire adieu. Le Murmure ne cesse jamais!",shape=box,color=blue];
		j1107396668 -> "Chat ends.";
	j571374058 [label="Souviens-toi de cela et nous serons de bons amis, je pense. Et sur cette note merveilleuse, je crains de devoir te dire adieu. Le Murmure ne cesse jamais!",shape=box,color=blue];
		j571374058 -> "Chat ends.";
	j2219092707 [label="Patience. Il n'est pas... communicatif au début. Mais il viendra à toi, le moment venu. Si tes intentions sont bonnes, il le saura. Mais maintenant, je crains de devoir te dire adieu.",shape=box,color=blue];
		j2219092707 -> "Chat ends.";
	j1251582164 [label="Oui, j'imagine, une créature voyageant dans le temps, capable de créer des boucles temporelles et de fabriquer des mondes de toutes pièces! Une créature un peu magicienne, non?",shape=box,color=blue];
		j1251582164 -> j2270564990;
		j1251582164 -> j835731575;
	j2851022357 [label="+15 Chemistry",color=orange];
		j2851022357 -> j493527938;
	j2627417957 [label="C'est ainsi, je suppose, que Lyon et moi sommes devenus si vite une famille. Jamais il ne m'a regardée avec pitié. Ni moi envers lui.",shape=box,color=blue];
		j2627417957 -> j3842627341;
		j2627417957 -> j1188834403;
	j493527938 [label="Tu as raison, c'est ce qu'il fait. Mais il estime que c'est nécessaire pour protéger ceux qui l'entourent. Lorsqu'il sera prêt, il te dira ce qui le préoccupe. Patience. Il te parlera en temps voulu.",shape=box,color=blue];
		j493527938 -> j4162699688;
	j3842627341 [label="J'espère qu'il se sentira suffisamment à l'aise pour me parler, bientôt.",shape=box,color=red];
		j3842627341 -> j3345907825;
	j1188834403 [label="C'est bien que vous vous soyez rencontrés. Nous sommes tous bien plus que ce que l'on pourrait croire à première vue.",shape=box,color=red];
		j1188834403 -> j571878705;
	j4162699688 [label="Bah. Je crains de devoir te dire adieu. Le Murmure ne cesse jamais!",shape=box,color=blue];
		j4162699688 -> "Chat ends.";
	j571878705 [label="+15 Chemistry",color=orange];
		j571878705 -> j2837335715;
	j2837335715 [label="Alors, tu comprends vraiment. Je suis plus que Sœur Marie, la pauvre fille sans pieds à qui on a donné le pouvoir de voler. Et Lyon est plus qu'un prêtre tragique qui porte son fardeau en silence.",shape=box,color=blue];
		j2837335715 -> j1442735041;
	j1442735041 [label="Souviens-toi de cela et nous nous entendrons bien, je pense. Et sur cette note merveilleuse, je crains de devoir te dire adieu. Le Murmure ne cesse jamais!",shape=box,color=blue];
		j1442735041 -> "Chat ends.";
}