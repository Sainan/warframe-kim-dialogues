digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank3Convo5 begins." [color=orange];
		"MarieRank3Convo5 begins." -> j3777421692;
	j3777421692 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j3777421692 -> j1402799028;
	j1402799028 [label="Check boolean DrifterFaithSol",color=orange];
		j1402799028 -> j342744740 [label=true,color=green];
		j1402799028 -> j3499395220 [label=false,color=brown];
	j342744740 [label="Ma famille à Sol! Ma famille en Sol, comment allons-nous aujourd'hui?",shape=box,color=blue];
		j342744740 -> j2079417648;
		j342744740 -> j3262816288;
		j342744740 -> j2125560283;
		j342744740 -> j3443716218;
		j342744740 -> j2429168889;
	j3499395220 [label="Bonjour! Comment allons-nous, aujourd'hui?",shape=box,color=blue];
		j3499395220 -> j3443716218;
		j3499395220 -> j2079417648;
		j3499395220 -> j3262816288;
		j3499395220 -> j2429168889;
	j2079417648 [label="Je vais bien, et toi?",shape=box,color=red];
		j2079417648 -> j1095966374;
	j3262816288 [label="J'ai connu mieux, mais merci de demander. Comment vas-tu?",shape=box,color=red];
		j3262816288 -> j1384543515;
	j2125560283 [label="Je... devrais avouer maintenant que je mentais, je ne suis pas... vraiment adepte de Sol.",shape=box,color=red];
		j2125560283 -> j1926954896;
	j3443716218 [label="Mieux maintenant que je te parle. Tu illumines mes journées par ta simple présence.",shape=box,color=red];
		j3443716218 -> j1776035087;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j1095966374 [label="Je vais plutôt bien, je suppose. Même si, en y réfléchissant, j'ai l'impression que ce n'est pas normal.",shape=box,color=blue];
		j1095966374 -> j2243063705;
		j1095966374 -> j720463353;
	j1384543515 [label="Je vais bien, mais maintenant tu as piqué ma curiosité. Qu'y a-t-il?",shape=box,color=blue];
		j1384543515 -> j1109666523;
		j1384543515 -> j1046060695;
		j1384543515 -> j4114722824;
		j1384543515 -> j1710743428;
	j1926954896 [label="Oh! Je... vois. Pourquoi?",shape=box,color=blue];
		j1926954896 -> j523282891;
		j1926954896 -> j2301144607;
		j1926954896 -> j3836337752;
	j1776035087 [label="Loup! Tu vas me faire tomber de ma chaise!",shape=box,color=blue];
		j1776035087 -> j348964011;
		j1776035087 -> j513515060;
	"Chat ends." [color=orange];
	j2243063705 [label="Que veux-tu dire?",shape=box,color=red];
		j2243063705 -> j2082088269;
	j720463353 [label="Tu marches dans mes pas...",shape=box,color=red];
		j720463353 -> j894049683;
	j1109666523 [label="C'est... juste... difficile à expliquer.",shape=box,color=red];
		j1109666523 -> j1162938214;
	j1046060695 [label="Trop de soucis. Trop peu de temps.",shape=box,color=red];
		j1046060695 -> j2969907310;
	j4114722824 [label="Une amie à moi a un jour décrit cela comme des \"araignées\". Elles s'infiltrent de temps en temps.",shape=box,color=red];
		j4114722824 -> j3263408541;
	j1710743428 [label="Parfois, tout... me dérange. Mais ça ira.",shape=box,color=red];
		j1710743428 -> j1919576188;
	j523282891 [label="J'ai pensé que ce serait l'occasion de mieux te connaître...",shape=box,color=red];
		j523282891 -> j23935826;
	j2301144607 [label="Je pensais que ce serait drôle?",shape=box,color=red];
		j2301144607 -> j1367331309;
	j3836337752 [label="Honnêtement, je ne sais pas. C'était impulsif.",shape=box,color=red];
		j3836337752 -> j3515675750;
	j348964011 [label="Je le pense vraiment. Je te demande pardon si je te mets mal à l'aise.",shape=box,color=red];
		j348964011 -> j1427806454;
	j513515060 [label="Pardon. Je plaisantais.",shape=box,color=red];
		j513515060 -> j1427806454;
	j2082088269 [label="Je suis une Sœur de Sol. Je ne suis pas faite pour... me battre. Tuer. Les Murmures ne sont pas vivants, du moins c'est ce que me disent les Cavias – mais qu'en est-il des autres que j'affronte?",shape=box,color=blue];
		j2082088269 -> j1871986391;
	j894049683 [label="+5 Chemistry",color=orange];
		j894049683 -> j2564393224;
	j1162938214 [label="Je ne veux pas être indiscrète. Je sais qu'il est parfois difficile d'exprimer les choses avec des mots.",shape=box,color=blue];
		j1162938214 -> j2813435714;
	j2969907310 [label="Il y avait une Sœur à la Cathédrale qui était comme ça. Elle s'agitait, s'agitait, s'agitait encore. Je l'ai trouvée un jour en train de polir de l'argenterie à trois heures du matin.",shape=box,color=blue];
		j2969907310 -> j691356315;
	j3263408541 [label="Ah oui. Je crois savoir de quoi tu parles. Comme une sorte de... nuage qui se déplace en cachant le soleil.",shape=box,color=blue];
		j3263408541 -> j3931234053;
	j1919576188 [label="Comme une tasse qui se remplit d'eau, une goutte à la fois, non?",shape=box,color=blue];
		j1919576188 -> j3064091448;
	j23935826 [label="Tu n'avais pas besoin de me dire un tel mensonge pour me connaître.",shape=box,color=blue];
		j23935826 -> j3990782696;
	j1367331309 [label="Je ne comprends pas ton humour. Peut-être que dans le futur, le concept de \"drôle\" sera différent?",shape=box,color=blue];
		j1367331309 -> j2634751090;
	j3515675750 [label="Je ne sais pas quel instinct t'a poussé à me dire un tel mensonge. ",shape=box,color=blue];
		j3515675750 -> j1223670499;
	j1427806454 [label="Bon, où en étais-je?",shape=box,color=blue];
		j1427806454 -> j4244769428;
	j1871986391 [label="Combattre au nom de Sol... est-ce là ma voie? Vais-je être une tueuse en son nom? Moi, la petite Marie?",shape=box,color=blue];
		j1871986391 -> j1315117404;
		j1871986391 -> j1661613462;
	j2564393224 [label="Je sais que c'est une métaphore, mais je suis morte de rire! Je ne pense pas que je pourrai jamais marcher dans tes pas!",shape=box,color=blue];
		j2564393224 -> j3200395610;
	j2813435714 [label="Nos journées et notre esprit peuvent déraper de bien des façons. Ils peuvent trouver des trous noirs dans lesquels nous enliser, non?",shape=box,color=blue];
		j2813435714 -> j1432182603;
	j691356315 [label="Je lui ai demandé pourquoi elle faisait ça et elle m'a répondu qu'elle ne pouvait pas dormir, car elle s'inquiétait trop.",shape=box,color=blue];
		j691356315 -> j832375460;
	j3931234053 [label="Il y a un terme qui convient: l’ennui. Une lassitude et un mécontentement qui rendent tout... inutile.",shape=box,color=blue];
		j3931234053 -> j1527500157;
	j3064091448 [label="Elle se remplira et débordera. Peut-être même que son contenu se renversera. Et tout cela ressemblera à une catastrophe. ",shape=box,color=blue];
		j3064091448 -> j193365591;
	j3990782696 [label="Une âme est bien plus que la foi qu'elle porte. Je suis une Sœur de Sol, mais j'espère que tu vois plus que cela en moi, non?",shape=box,color=blue];
		j3990782696 -> j927678079;
	j2634751090 [label="Pour moi, ce n'est pas drôle.",shape=box,color=blue];
		j2634751090 -> j1097657522;
	j1223670499 [label="J'espère seulement que ce fut une blague bienveillante et non une cruelle plaisanterie à mes dépens. Je choisirai donc de suivre l'exemple de Sol...",shape=box,color=blue];
		j1223670499 -> j1250963206;
	j4244769428 [label="Check boolean DrifterFaithSol",color=orange];
		j4244769428 -> j3330831505 [label=true,color=green];
		j4244769428 -> j3554349840 [label=false,color=brown];
	j1315117404 [label="Je ne suis pas un soldat de formation. Pas comme ce gamin. Toi non plus.",shape=box,color=red];
		j1315117404 -> j769953833;
	j1661613462 [label="Je n'ai pas toujours été comme ça. Un guerrier. J'ai dû l'apprendre à mes dépens.",shape=box,color=red];
		j1661613462 -> j741195098;
	j3200395610 [label="L'image que j'en ai en tête me rend folle. Avant que je ne puisse plus respirer, dis-moi: à quoi fais-tu référence?",shape=box,color=blue];
		j3200395610 -> j1315117404;
		j3200395610 -> j1661613462;
	j1432182603 [label="Nous ne pouvons que nous efforcer d’être gentils et patients avec nous-mêmes lorsque cela se produit.",shape=box,color=blue];
		j1432182603 -> j945022589;
	j832375460 [label="Chaque fois que je la trouvais ainsi, je lui demandais si elle voulait de la compagnie. Parfois elle disait oui, parfois non.",shape=box,color=blue];
		j832375460 -> j2813435714;
	j1527500157 [label="Ou peut-être que ton désir est de te cacher, de pleurer. Est-ce plutôt du désespoir, je ne peux pas le dire.",shape=box,color=blue];
		j1527500157 -> j328691903;
	j193365591 [label="Tu nettoies le désordre, tu redresses la tasse... et ça recommence, n'est-ce pas?",shape=box,color=blue];
		j193365591 -> j2229966397;
	j927678079 [label="Il y a autant de sujets que nous pourrions choisir que d'étoiles dans le ciel!",shape=box,color=blue];
		j927678079 -> j3086720649;
		j927678079 -> j1677617809;
	j1097657522 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j1097657522 -> j1508231473;
	j1250963206 [label="- dont je suis la foi, que tu la partages ou non, et je te pardonne. Si tu étais comme Lyon, je te dirais que dix coups de fouet te reviennent.",shape=box,color=blue];
		j1250963206 -> j40516126;
	j3330831505 [label="Ma famille à Sol! Ma famille en Sol, comment allons-nous aujourd'hui?",shape=box,color=blue];
		j3330831505 -> j2079417648;
		j3330831505 -> j3262816288;
		j3330831505 -> j2125560283;
		j3330831505 -> j2429168889;
	j3554349840 [label="Bonjour! Comment allons-nous, aujourd'hui?",shape=box,color=blue];
		j3554349840 -> j2079417648;
		j3554349840 -> j3262816288;
		j3554349840 -> j2429168889;
	j769953833 [label="Oui! La minuscule copie et sa triste histoire... j'ai envie de pleurer rien que d'y penser. Être transformée en machine de guerre par ceux qu'elle prend pour sa famille?",shape=box,color=blue];
		j769953833 -> j567551968;
	j741195098 [label="Oui! J'ai entendu dire que tu as beaucoup souffert pour apprendre à te battre comme tu le fais maintenant. La mort est un mentor cruel, je ne peux pas l'imaginer...",shape=box,color=blue];
		j741195098 -> j567551968;
	j945022589 [label="Je ne sais pas si ces mots ont un sens pour toi. Ou s'ils ne sont que de simples points lumineux sur une machine vrombissante.",shape=box,color=blue];
		j945022589 -> j2610748421;
	j328691903 [label="Je ne connais pas ton amie, mais je pense que c'est une bonne chose qu'elle t'ait.",shape=box,color=blue];
		j328691903 -> j2813435714;
	j2229966397 [label="Il y avait un Père à la Chapelle dont le tempérament ressemblait beaucoup au tien, je crois. Il a tout supporté, jusqu'à ce qu'il n'y arrive plus.",shape=box,color=blue];
		j2229966397 -> j1631573509;
	j3086720649 [label="Je te demande pardon. C'était stupide.",shape=box,color=red];
		j3086720649 -> j3533209672;
	j1677617809 [label="Alors, tu me pardonnes?",shape=box,color=red];
		j1677617809 -> j399749046;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j40516126 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j40516126 -> j567417813;
	j567551968 [label="Non. Je préfère être comme je suis maintenant. J'ai choisi de prendre la main du Cardinal, le sérum qu'il m'offrait.",shape=box,color=blue];
		j567551968 -> j384742831;
	j2610748421 [label="En effet, quand on considère la réalité des choses, quand j'écris ces mots, il se pourrait très bien que cela fasse des jours ou des années que je les ai couchés, selon le moment où tu te trouves.",shape=box,color=blue];
		j2610748421 -> j1897328122;
	j1631573509 [label="Quand il était dépassé et que tout semblait être un désastre, je lui demandais s'il souhaitait ma compagnie. Des fois, oui, des fois, non.",shape=box,color=blue];
		j1631573509 -> j2813435714;
	j3533209672 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j3533209672 -> j3183869160;
	j399749046 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j399749046 -> j2115979173;
	j567417813 [label="Nous sommes tous des êtres aveugles, essayant de trouver notre chemin dans ce monde.",shape=box,color=blue];
		j567417813 -> j2390968227;
	j384742831 [label="Mais tu connais la tristesse qui m'accable, l'incertitude. De ne pas être née, ni avoir grandi, dans cette vie de guerre.",shape=box,color=blue];
		j384742831 -> j3663902639;
		j384742831 -> j2637406600;
	j1897328122 [label="Tout cela pour dire que je comprends que cela puisse paraître vide de sens lorsque j’écris que tu n'as pas à être une âme seule.",shape=box,color=blue];
		j1897328122 -> j3130572816;
	j3183869160 [label="+10 Chemistry",color=orange];
		j3183869160 -> j841329968;
	j2115979173 [label="+5 Chemistry",color=orange];
		j2115979173 -> j1484934121;
	j2390968227 [label="Mais je t'ai demandé comment tu allais. Et la question reste entière, petit mensonge ou pas.",shape=box,color=blue];
		j2390968227 -> j2323003596;
		j2390968227 -> j2799472583;
		j2390968227 -> j3452198471;
	j3663902639 [label="Parfois, je pense à tout ce que j'ai dû découvrir par moi-même et j'envie un peu l'enfant pour la véritable formation qu'il a reçue.",shape=box,color=red];
		j3663902639 -> j122986411;
	j2637406600 [label="Je pense qu'il n'y a pas de \"bonne\" façon d'en arriver à se battre. Naître, grandir, ou le choisir. En fin de compte, tout dépend de qui on est et de ce qu'on en fait.",shape=box,color=red];
		j2637406600 -> j1214344892;
	j3130572816 [label="Même si ceux qui t'entourent peuvent sembler distants, numériques ou assis patiemment en attendant que tu leur dises bonjour.",shape=box,color=blue];
		j3130572816 -> j3797395930;
	j841329968 [label="Oui, et si tu étais comme Lyon, je te dirais que dix coups de fouet te reviennent! Mais ce n'est pas le cas. Et je te pardonne.",shape=box,color=blue];
		j841329968 -> j567417813;
	j1484934121 [label="Oui, je te pardonne. Si tu étais comme Lyon, je te dirais que dix coups de fouet te reviennent.",shape=box,color=blue];
		j1484934121 -> j567417813;
	j2323003596 [label="J'ai... connu mieux, honnêtement.",shape=box,color=red];
		j2323003596 -> j2779161050;
	j2799472583 [label="Je vais bien, honnêtement. Et toi, comment vas-tu?",shape=box,color=red];
		j2799472583 -> j1095966374;
	j3452198471 [label="Ça va mieux, maintenant. Merci. J'ai entendu dire que la confession était bénéfique, non?",shape=box,color=red];
		j3452198471 -> j3650109788;
	j122986411 [label="Add -1 to Thermostat counter",color=orange];
		j122986411 -> j4188766668;
	j1214344892 [label="Add 1 to Thermostat counter",color=orange];
		j1214344892 -> j4154761014;
	j3797395930 [label="Et j'espère que ce moment passera vite pour toi.",shape=box,color=blue];
		j3797395930 -> j336580005;
	j2779161050 [label="Qu'y a-t-il? Qu'est-ce qui ne va pas?",shape=box,color=blue];
		j2779161050 -> j1109666523;
		j2779161050 -> j1046060695;
		j2779161050 -> j4114722824;
		j2779161050 -> j1710743428;
	j3650109788 [label="+5 Chemistry",color=orange];
		j3650109788 -> j3704575909;
	j4188766668 [label="+10 Chemistry",color=orange];
		j4188766668 -> j2502846450;
	j4154761014 [label="+10 Chemistry",color=orange];
		j4154761014 -> j924935970;
	j336580005 [label="Et si ce n'est pas le cas? J'ai une solution qui aide toujours!",shape=box,color=blue];
		j336580005 -> j848208416;
	j3704575909 [label="Ah! Oui, c'est vrai. Très bien, je suis contente de l'entendre.",shape=box,color=blue];
		j3704575909 -> j337345325;
	j2502846450 [label="Oui, mais alors tu ne serais pas le loup canaille qu'on connaît et qu'on aime, n'est-ce pas? Je pense que Sol a fait en sorte de te placer exactement là où tu devais être.",shape=box,color=blue];
		j2502846450 -> j3111432301;
	j924935970 [label="Oui, je suis tout à fait d'accord. Personne n'est né pour la guerre. Enfin, sauf ces \"Grin-ires\" dont on me parle, et même là...",shape=box,color=blue];
		j924935970 -> j3240220593;
	j848208416 [label="Des pâtisseries!",shape=box,color=blue];
		j848208416 -> j4132951681;
	j337345325 [label="Ah! Le déjeuner est servi. Je dois y aller. À plus tard, loup. Je suis ravie que nous ayons discuté.",shape=box,color=blue];
		j337345325 -> "Chat ends.";
	j3111432301 [label="Mais je comprends ce que tu veux dire. Tu vois la structure et les conseils que ton autre a reçus et tu ne peux t'empêcher de souhaiter les mêmes. Surtout quand tu devais supporter une telle solitude.",shape=box,color=blue];
		j3111432301 -> j475695041;
	j3240220593 [label="Je me demande s’ils ne choisiraient pas une autre route s’ils avaient vraiment le choix?",shape=box,color=blue];
		j3240220593 -> j2172736016;
		j3240220593 -> j1327505817;
	j4132951681 [label="Check boolean MarieRoathePastry1",color=orange];
		j4132951681 -> j1528033883 [label=true,color=green];
		j4132951681 -> j2116564389 [label=true,color=green];
		j4132951681 -> j412080700 [label=true,color=green];
		j4132951681 -> j2116564389 [label=false,color=brown];
		j4132951681 -> j276661671 [label=false,color=brown];
	j475695041 [label="Je ne peux m'empêcher de voir, maintenant, une copie minuscule qui est si seule... et un loup qui court avec une meute.",shape=box,color=blue];
		j475695041 -> j2987589671;
	j2172736016 [label="C'est difficile, quand on est élevé dans l'idée que c'est notre seul but, notre seule existence, de sortir de ce moule. Avoir un but est réconfortant.",shape=box,color=red];
		j2172736016 -> j1630926181;
	j1327505817 [label="Je pense qu'ils le feraient. J'en ai rencontré quelques-uns qui m'ont prouvé que les Grineers sont bien plus que la guerre et la mort.",shape=box,color=red];
		j1327505817 -> j3467514116;
	j1528033883 [label="Je devrai juste m'assurer d'apporter suffisamment de pâtisseries pour tout le monde.",shape=box,color=red];
		j1528033883 -> j909807357;
	j2116564389 [label="Merci, Marie.",shape=box,color=red];
		j2116564389 -> j2584358729;
	j412080700 [label="Je ne laisserai tout simplement pas Roathe s'en approcher.",shape=box,color=red];
		j412080700 -> j28924132;
	j276661671 [label="Tu ne peux jamais te tromper avec des pâtisseries.",shape=box,color=red];
		j276661671 -> j3732868263;
	j2987589671 [label="Je pense que la situation s'est peut-être inversée, non?",shape=box,color=blue];
		j2987589671 -> j1886917983;
		j2987589671 -> j520530919;
	j1630926181 [label="Add -1 to Thermostat counter",color=orange];
		j1630926181 -> j363116694;
	j3467514116 [label="Add 1 to Thermostat counter",color=orange];
		j3467514116 -> j3804938611;
	j909807357 [label="+20 Chemistry",color=orange];
		j909807357 -> j2790878232;
	j2584358729 [label="+20 Chemistry",color=orange];
		j2584358729 -> j1955357559;
	j28924132 [label="+20 Chemistry",color=orange];
		j28924132 -> j3485626403;
	j3732868263 [label="Ne laisse surtout pas le diable s'en approcher. Sinon, il va les voler! Il a tendance à voler des sucreries quand on ne le nourrit pas assez à son goût!",shape=box,color=blue];
		j3732868263 -> j420323306;
	j1886917983 [label="Ils sont encore en train de se remettre. Leur voyage n'est pas encore terminé.",shape=box,color=red];
		j1886917983 -> j3272441780;
	j520530919 [label="J’aimerais pouvoir en faire plus pour aider. ",shape=box,color=red];
		j520530919 -> j3272441780;
	j363116694 [label="Oui, tu as raison. Beaucoup cherchent la foi dans l'espoir qu'elle leur donnera justement cela: un but, une direction.",shape=box,color=blue];
		j363116694 -> j3292825094;
	j3804938611 [label="(C'est donc comme ça que ça s'écrit, merci!) Cela me fait tellement plaisir de savoir que même une race à qui on a appris que c'était son seul but, peut en trouver un autre.",shape=box,color=blue];
		j3804938611 -> j2761983734;
	j2790878232 [label="Voilà l'esprit! Même un diable mérite un peu de pâtisseries de temps en temps, j'imagine.",shape=box,color=blue];
		j2790878232 -> j2370563167;
	j1955357559 [label="Je t'en prie. J'espère t'avoir apporté un peu de réconfort, même un tout petit peu. Je sais que tu m'as réconfortée.",shape=box,color=blue];
		j1955357559 -> "Chat ends.";
	j3485626403 [label="Ah, je me plains, mais même le plus vil des diables mérite un peu de pâtisseries de temps en temps, n'est-ce pas?",shape=box,color=blue];
		j3485626403 -> j2370563167;
	j420323306 [label="Boolean MarieRoathePastry1 is now true.",color=orange];
		j420323306 -> j2199098842;
		j420323306 -> j92999140;
