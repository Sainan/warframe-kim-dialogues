		j2761983734 -> j3292825094;
	j2370563167 [label="Eh bien! Le déjeuner est servi et maintenant, j'ai faim. J'espère t'avoir remonté le moral, ne serait-ce qu'un peu. Je sais que toi, tu m'as remonté le moral.",shape=box,color=blue];
