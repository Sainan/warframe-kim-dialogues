digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo8 begins." [color=orange];
		"MarieRank4Convo8 begins." -> j2786051379;
	j2786051379 [label="Check boolean MarieOtak1",color=orange];
		j2786051379 -> j4248145026 [label=true,color=green];
		j2786051379 -> j1976491912 [label=false,color=brown];
	j4248145026 [label="Voyageur, plus j'en apprends de Monsieur Necraloid et de Monsieur Otak, plus cela me trouble...",shape=box,color=blue];
		j4248145026 -> j3680745373;
		j4248145026 -> j494339866;
	j1976491912 [label="Voyageur, puis-je te parler?",shape=box,color=blue];
		j1976491912 -> j4112708821;
		j1976491912 -> j2429168889;
	j3680745373 [label="Comment ça?",shape=box,color=red];
		j3680745373 -> j4215062395;
	j494339866 [label="Quel est le problème, exactement?",shape=box,color=red];
		j494339866 -> j4215062395;
	j4112708821 [label="Bien sûr. Qu'y a-t-il?",shape=box,color=red];
		j4112708821 -> j3456334157;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j4215062395 [label="J'ai demandé à Monsieur Necraloid si le crâne qui l'ornait avait appartenu à une âme vivante à un moment ou à un autre ou non.",shape=box,color=blue];
		j4215062395 -> j3119299958;
	j3456334157 [label="Je suis curieuse de savoir pourquoi il y a un autre visage sur son dos qui ressemble au gribouillage d'un enfant.",shape=box,color=blue];
		j3456334157 -> j3285324583;
	"Chat ends." [color=orange];
	j3119299958 [label="Et Monsieur Necraloid m'a dit que c'était \"son\" crâne, tout en admettant que Monsieur Loid était \"l'original\". Monsieur Loid est intervenu pour me dire que c'était une version \"répliquée\" de son propre crâne.",shape=box,color=blue];
		j3119299958 -> j3757962025;
	j3285324583 [label="J'ai interrogé Monsieur Necraloid et Monsieur Loid, mais aucun des deux n'a souhaité en parler. Ils m'ont seulement donné un nom: Otak. Et c'est avec une grande tristesse qu'ils l'ont prononcé.",shape=box,color=blue];
		j3285324583 -> j1651038033;
	j3757962025 [label="Comment est-ce possible? Et que signifie \"répliquée\"? Est-ce un vrai crâne ou bien un faux? Pourquoi Monsieur Necraloid et Monsieur Loid auraient-ils des réponses différentes?",shape=box,color=blue];
		j3757962025 -> j1557522479;
		j3757962025 -> j1543427163;
		j3757962025 -> j2211290017;
	j1651038033 [label="Alors me voici, en train de te parler, dans l’espoir que tu puisses m’aider.",shape=box,color=blue];
		j1651038033 -> j795753204;
	j1557522479 [label="Je suppose que du point de vue de Necraloid, c'est son crâne. C'est vrai. Mais du point de vue de Loid, c'est une réplique.",shape=box,color=red];
		j1557522479 -> j3322485723;
	j1543427163 [label="Honnêtement, je ne sais pas de quoi il est fait. Ça pourrait être de l'os. Ou une sorte de polymère...",shape=box,color=red];
		j1543427163 -> j2062652365;
	j2211290017 [label="Je pense que la vraie question à laquelle tu t'attaques est: \"Necraloid est-il réel?\" et non \"le crâne est-il réel?\"",shape=box,color=red];
		j2211290017 -> j2088368596;
	j795753204 [label="Veux-tu me raconter l'histoire du pauvre Monsieur Otak?",shape=box,color=blue];
		j795753204 -> j2916708889;
	j3322485723 [label="Je crois que c'est ce qui me trouble. C'est la façon dont ces deux messieurs considèrent leur origine. L'un la croit sacrée, et pour l'autre c'est une copie.",shape=box,color=blue];
		j3322485723 -> j3408858168;
	j2062652365 [label="Je ne sais pas si c'est la composition du crâne qui me trouble tant. C'est son origine. Ou peut-être la façon dont ces deux messieurs la considèrent. L'un la croit sacrée et pour l'autre, c'est une copie.",shape=box,color=blue];
		j2062652365 -> j3408858168;
	j2088368596 [label="+5 Chemistry",color=orange];
		j2088368596 -> j70891859;
	j2916708889 [label="Otak était un Archimédien, un scientifique et savant Orokin. Ce qui lui est arrivé n'est pas vraiment une histoire heureuse.",shape=box,color=red];
		j2916708889 -> j621932943;
	j3408858168 [label="Evaluate expressions",color=orange];
		j3408858168 -> j162150190 [label="MarieCephalonSoul",color=purple];
		j3408858168 -> j1171852811 [label="MarieCephalonNoSoul",color=purple];
		j3408858168 -> j3842309075 [label="MarieCephalonUnsure",color=purple];
		j3408858168 -> j465264782 [label="false",color=purple];
	j70891859 [label="Oui! Tu as raison, c'est le cœur – ou plutôt le crâne – du problème, haha. L'un se croit sacré, l'autre pense que c'est une copie.",shape=box,color=blue];
		j70891859 -> j3408858168;
	j621932943 [label="De l’avis général, il était un génie et l’esprit auquel on doit l’exploitation des cristaux d’argon.",shape=box,color=red];
		j621932943 -> j3918691403;
	j162150190 [label="Comment Monsieur Necraloid peut-il posséder une âme, alors qu'il ne possède pas ses propres os?",shape=box,color=blue];
		j162150190 -> j187468770;
		j162150190 -> j3743994456;
		j162150190 -> j2717969110;
	j1171852811 [label="Est-ce une preuve supplémentaire que Monsieur Necraloid n'a pas d'âme?",shape=box,color=blue];
		j1171852811 -> j187468770;
		j1171852811 -> j3743994456;
		j1171852811 -> j2717969110;
	j3842309075 [label="Je sais que tu doutes que Monsieur Necraloid puisse posséder une âme. Mais j'ignore comment il le pourrait, puisqu'il ne possède pas ses propres os.",shape=box,color=blue];
		j3842309075 -> j187468770;
		j3842309075 -> j3743994456;
		j3842309075 -> j2717969110;
	j465264782 [label="Je parle à une technologie très élaborée, conçue pour ressembler à un homme, n'est-ce pas? Un phonographe, mais en bien plus complexe.",shape=box,color=blue];
		j465264782 -> j3405469627;
		j465264782 -> j792746857;
		j465264782 -> j3115291150;
		j465264782 -> j3636088071;
		j465264782 -> j1208824080;
	j3918691403 [label="Qui sont exploités à partir du Néant - ils sont la raison pour laquelle nous pouvons créer un grand nombre de warframes et d'armes puissantes.",shape=box,color=red];
		j3918691403 -> j4287655810;
	j187468770 [label="Peut-être que tu as raison. Peut-être ne sont-ils que des copies d'humains. Mais je n'ai aucune certitude et de toute façon, nous devons les traiter comme s'ils étaient humains.",shape=box,color=red];
		j187468770 -> j2528354193;
	j3743994456 [label="Je pense que Necraloid est l'exception, pas la règle. Il a été créé comme une réplique d'une personne et non à partir d'une personne.",shape=box,color=red];
		j3743994456 -> j3656507584;
	j2717969110 [label="Tu as raison. C'est probablement mieux et plus humain s'ils ne sont pas des âmes prisonnières d'une science élaborée...",shape=box,color=red];
		j2717969110 -> j2016981321;
	j3405469627 [label="Necraloid n'a peut-être pas d'âme, mais il est unique. D'autres Céphalons, comme Otak, en ont une. Leur destruction réside dans leur création.",shape=box,color=red];
		j3405469627 -> j1262401678;
	j792746857 [label="Tu as raison. Et puis, que veux-tu que j'y fasse?",shape=box,color=red];
		j792746857 -> j396953184;
	j3115291150 [label="Tu as raison. Ils n'en ont pas. Mais ça ne veut pas dire qu'on peut les maltraiter.",shape=box,color=red];
		j3115291150 -> j3147634308;
	j3636088071 [label="Je ne sais pas si tu as raison ou tort. Mais ils peuvent encore penser et ressentir, et on ne peut pas les traiter comme des objets.",shape=box,color=red];
		j3636088071 -> j2545750033;
	j1208824080 [label="Necraloid a une âme. Tous les Céphalons en ont une.",shape=box,color=red];
		j1208824080 -> j2044711831;
	j4287655810 [label="Il s'est spécialisé en cristallographie. Ses travaux étaient archivés ici, dans les laboratoires.",shape=box,color=red];
		j4287655810 -> j1995434340;
	j2528354193 [label="Boolean MarieCephalonUnsure is now true.",color=orange];
		j2528354193 -> j1460870001;
	j3656507584 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j3656507584 -> j400683907;
