		j2016981321 -> j272587373;
	j1262401678 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j1262401678 -> j2931876185;
	j396953184 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j396953184 -> j922905928;
	j3147634308 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j3147634308 -> j3068677944;
	j2545750033 [label="Boolean MarieCephalonUnsure is now true.",color=orange];
		j2545750033 -> j3944123620;
	j2044711831 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j2044711831 -> j617144926;
	j1995434340 [label="Pour une raison que j'ignore, il a été transformé en Céphalon et a reçu sa propre carapace de Necraloid.",shape=box,color=red];
		j1995434340 -> j664340551;
	j1460870001 [label="Boolean MarieCephalonNoSoul is now false.",color=orange];
		j1460870001 -> j2046267944;
	j400683907 [label="Boolean MarieCephalonUnsure is now false.",color=orange];
		j400683907 -> j3015672946;
	j272587373 [label="Boolean MarieCephalonSoul is now false.",color=orange];
		j272587373 -> j1317590156;
	j2931876185 [label="+5 Chemistry",color=orange];
		j2931876185 -> j2568593263;
	j922905928 [label="Oh, ne pense pas que je te demande de les maltraiter! Non! Chéris-les, car ils sont précieux et ce n'est pas de leur faute s'ils sont comme ils sont!",shape=box,color=blue];
		j922905928 -> j973760345;
	j3068677944 [label="+5 Chemistry",color=orange];
		j3068677944 -> j922905928;
	j3944123620 [label="+5 Chemistry",color=orange];
		j3944123620 -> j1376858752;
	j617144926 [label="+5 Chemistry",color=orange];
		j617144926 -> j329012831;
	j664340551 [label="Tous les Céphalons n'ont pas été créés en guise de châtiment. Mais les choses ont... mal tourné sur Deimos et il a été gravement endommagé.",shape=box,color=red];
		j664340551 -> j3998308863;
	j2046267944 [label="Boolean MarieCephalonSoul is now false.",color=orange];
		j2046267944 -> j2786350838;
	j3015672946 [label="Boolean MarieCephalonNoSoul is now false.",color=orange];
		j3015672946 -> j2697907567;
	j1317590156 [label="Boolean MarieCephalonUnsure is now false.",color=orange];
		j1317590156 -> j2373908993;
	j2568593263 [label="Une preuve supplémentaire que le diable et ses semblables devaient être condamnés. Mais peut-être as-tu raison à propos d'Otak et de ses semblables, ou peut-être que le croire t'apporte du réconfort.",shape=box,color=blue];
		j2568593263 -> j973760345;
	j973760345 [label="Et je me trompe peut-être, en fin de compte. Il n'y a jamais de mal à faire preuve de gentillesse et de respect.",shape=box,color=blue];
		j973760345 -> j2155672540;
	j1376858752 [label="Tu as peut-être raison, mais je ne pense pas que les diables Orokins en savaient plus que nous sur le fonctionnement de l'âme. Ce n'étaient pas de grands dieux.",shape=box,color=blue];
		j1376858752 -> j973760345;
	j329012831 [label="Peut-être que tu as raison, ou peut-être cela t'apaise de le croire.",shape=box,color=blue];
		j329012831 -> j973760345;
	j3998308863 [label="Pauvre petit...",shape=box,color=blue];
		j3998308863 -> j3134774711;
	j2786350838 [label="+5 Chemistry",color=orange];
		j2786350838 -> j1905520374;
	j2697907567 [label="+5 Chemistry",color=orange];
		j2697907567 -> j3901708049;
	j2373908993 [label="+5 Chemistry",color=orange];
		j2373908993 -> j822005576;
	j2155672540 [label="Je vais retourner tresser une couronne de fleurs pour Monsieur Necraloid, quoi qu'il en soit. Il a fait des histoires, mais on ne me dit pas non!",shape=box,color=blue];
		j2155672540 -> j3753651870;
		j2155672540 -> j3034844748;
		j2155672540 -> j2018041323;
	j3134774711 [label="Boolean MarieOtak1 is now true.",color=orange];
		j3134774711 -> j3951815689;
	j1905520374 [label="Oui, c'est très sage. Je réfléchis simplement à voix haute et je me demande ce qu'ils sont. Tu as tout à fait raison, il n'y a jamais de mal à faire preuve de gentillesse et de respect.",shape=box,color=blue];
		j1905520374 -> j3877764172;
	j3901708049 [label="Peut-être que tu as raison. Et je l'espère! Quoi qu'il en soit, soyons bienveillants, car ce sont des créatures pensantes. Et ce qui peut penser, peut ressentir.",shape=box,color=blue];
		j3901708049 -> j3877764172;
	j822005576 [label="Quoi qu'il en soit, soyons bienveillants, car ce sont des créatures pensantes. Et ce qui peut penser, peut ressentir.",shape=box,color=blue];
		j822005576 -> j973760345;
	j3753651870 [label="C'est adorable.",shape=box,color=red];
		j3753651870 -> j1606543034;
	j3034844748 [label="Une couronne de fleurs?",shape=box,color=red];
		j3034844748 -> j3866518690;
	j2018041323 [label="Bon amusement.",shape=box,color=red];
		j2018041323 -> j1606543034;
	j3951815689 [label="Check boolean LoidFamilyComplete",color=orange];
		j3951815689 -> j287059160 [label=true,color=green];
		j3951815689 -> j4139720151 [label=false,color=brown];
		j3951815689 -> j287059160 [label=false,color=brown];
	j3877764172 [label="Et on se trompe peut-être, en fin de compte. Il n'y a jamais de mal à faire preuve de gentillesse et de respect. ",shape=box,color=blue];
		j3877764172 -> j2155672540;
	j1606543034 [label="+5 Chemistry",color=orange];
		j1606543034 -> j365059909;
	j3866518690 [label="+10 Chemistry",color=orange];
		j3866518690 -> j1323305038;
	j287059160 [label="Comment en est-on arrivé là?",shape=box,color=red];
		j287059160 -> j4215062395;
	j4139720151 [label="J'espère qu'un jour, tu pourras le rencontrer.",shape=box,color=red];
		j4139720151 -> j52972121;
	j365059909 [label="Merci! À la revoyure!",shape=box,color=blue];
		j365059909 -> "Chat ends.";
	j1323305038 [label="Oh! Ça relève des Directives de Lua. À l'anniversaire du décès d'une âme, on tresse une couronne ou une guirlande de fleurs et on la place sur son crâne ou sur sa tombe. ",shape=box,color=blue];
		j1323305038 -> j934789265;
	j52972121 [label="Oui. Mais ce n'est pas son silence qui me trouble, je suppose. J'ai demandé à Monsieur Necraloid si le crâne qui l'ornait appartenait à une âme vivante à un moment donné ou non.",shape=box,color=blue];
		j52972121 -> j3119299958;
	j934789265 [label="Dans les cryptes traditionnelles, les corps étaient souvent exposés, n'est-ce pas? On pouvait donc faire ça. Je pense que certaines traditions ont survécu, même aujourd'hui.",shape=box,color=blue];
		j934789265 -> j2636320428;
	j2636320428 [label="Je les vois reflétées dans certaines œuvres d’art des Orokins, avec leur amour des crânes. ",shape=box,color=blue];
		j2636320428 -> j3001529740;
		j2636320428 -> j1896569957;
		j2636320428 -> j1332045363;
	j3001529740 [label="Cela explique beaucoup de choses.",shape=box,color=red];
		j3001529740 -> j4147054398;
	j1896569957 [label="Les choses changent, hein?",shape=box,color=red];
		j1896569957 -> j4147054398;
	j1332045363 [label="Je pense que la Fille a déjà essayé de faire ça, tu vas la rendre jalouse.",shape=box,color=red];
		j1332045363 -> j3214946443;
	j4147054398 [label="Oui! Tant de temps a passé et pourtant l'influence demeure. C'est une joie de savoir que même de minuscules fragments subsistent.",shape=box,color=blue];
		j4147054398 -> j2638544741;
	j3214946443 [label="Oui? Alors, j'ai hâte de la rencontrer! Je lui dirai que je ne lui ai pas fait de quartier.",shape=box,color=blue];
		j3214946443 -> j2638544741;
	j2638544741 [label="Faux crâne ou pas, Monsieur Necraloid devrait porter une couronne. Et ça le rend si timide que je l'adore! Il rougirait s'il le pouvait, je crois. Et ça me fait sourire.",shape=box,color=blue];
		j2638544741 -> j4101990552;
	j4101990552 [label="À la revoyure !",shape=box,color=blue];
		j4101990552 -> "Chat ends.";
}