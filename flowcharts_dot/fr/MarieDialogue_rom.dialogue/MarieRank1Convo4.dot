digraph {
	237 [label="MarieRank1Convo4 begins.",color=orange];
		237 -> 238;
	238 [label="Puis-je te poser une question qui, je l'espère, n'est pas impolie? C'est vraiment le début de notre amitié et tu as connu de si nombreuses années.",shape=box,color=blue];
		238 -> 241;
		238 -> 240;
		238 -> 239;
