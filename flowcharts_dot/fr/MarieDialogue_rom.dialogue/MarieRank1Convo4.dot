		245 -> 249 [label="x > 0",color=purple];
		245 -> 248 [label="x <= 0",color=purple];
		245 -> 248 [label="false",color=purple];
	250 [label="Vraiment? Il semblerait alors qu'il n'y a que toi dans le cas. Entre l'enfant et le diable, chacun semble chercher des parts d'eux-mêmes qu'ils ont égarées.",shape=box,color=blue];
		250 -> 255;
		250 -> 256;
	251 [label="Est-ce déplacé de te demander pourquoi tu as l'air perdu? Je connais les raisons de l'enfant et du diable, mais pas les tiennes.",shape=box,color=blue];
		251 -> 255;
		251 -> 256;
	249 [label="Pourquoi as-tu accepté d'aider le diable dans ses entreprises? J'ai entendu dire que tu es responsable du massacre des siens.",shape=box,color=blue];
		249 -> 252;
		249 -> 253;
		249 -> 254;
	248 [label="As-tu l'intention d'aider le diable dans ses entreprises? J'ai entendu dire que tu es responsable du massacre des siens.",shape=box,color=blue];
		248 -> 252;
		248 -> 253;
		248 -> 254;
	255 [label="J'ai passé un nombre indéterminé d'années à mourir des mains de... eh bien? De moi-même. Ça ne me dérange pas de ne pas pouvoir me souvenir de chacune d'elles.",shape=box,color=red];
		255 -> 260;
	256 [label="Pour résumer, j'ai passé... de nombreuses années à souffrir. J'imagine que c'est une sorte de mécanisme d'autodéfense, pour oublier.",shape=box,color=red];
		256 -> 261;
	252 [label="C'était mon autre moi. Je crois qu'il faut imputer la responsabilité aux individus et non aux sociétés.",shape=box,color=red];
		252 -> 257;
	253 [label="Ce n'était pas moi, c'était le gamin. Mais je déteste les Orokins autant que lui.",shape=box,color=red];
		253 -> 258;
	254 [label="Je n'étais pas là, la Nuit des Tambours Naga, quand les Tennos ont attaqué les Orokins. C'était le gamin.",shape=box,color=red];
		254 -> 259;
	260 [label="Je ne te blâme pas. Si j'étais victime de tels abus, je serais bien décidée à tout oublier. À tout le moins, je n'irais pas les chercher.",shape=box,color=blue];
		260 -> 265;
	261 [label="Je n'en doute pas! Si j'étais soumise à de tels abus, je m'attendrais à ce que mon âme fasse la même chose: cacher tout ce qui est irréparable et qui ne sert à rien.",shape=box,color=blue];
		261 -> 265;
	257 [label="Add 1 to Thermostat",color=orange];
		257 -> 262;
