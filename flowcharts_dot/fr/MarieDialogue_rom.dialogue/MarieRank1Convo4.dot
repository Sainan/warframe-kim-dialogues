		240 -> 243;
	239 [label="[Fin.]",shape=box,color=red];
		239 -> 242;
	244 [label="Par Sol! Tes paroles me brisent le cœur. Le diable et toi, vous avez vos esprits vidés de leurs connaissances, comme un livre auquel on a retiré des chapitres, non?",shape=box,color=blue];
		244 -> 246;
		244 -> 247;
