digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo4 begins." [color=orange];
		"MarieRank1Convo4 begins." -> j1835285610;
	j1835285610 [label="Puis-je te poser une question qui, je l'espère, n'est pas impolie? C'est vraiment le début de notre amitié et tu as connu de si nombreuses années.",shape=box,color=blue];
		j1835285610 -> j2670002421;
		j1835285610 -> j1141445350;
		j1835285610 -> j2429168889;
	j2670002421 [label="Honnêtement, j'ai oublié la plupart des années que j'ai connues. ",shape=box,color=red];
		j2670002421 -> j3666691772;
	j1141445350 [label="Bien sûr, pas de problème. Vas-y.",shape=box,color=red];
		j1141445350 -> j2947588656;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j3666691772 [label="Par Sol! Tes paroles me brisent le cœur. Le diable et toi, vous avez vos esprits vidés de leurs connaissances, comme un livre auquel on a retiré des chapitres, non?",shape=box,color=blue];
		j3666691772 -> j1083210310;
		j3666691772 -> j3582537049;
	j2947588656 [label="+5 Chemistry",color=orange];
		j2947588656 -> j523704316;
	"Chat ends." [color=orange];
	j1083210310 [label="Les parties oubliées de mon passé ne me manquent pas.",shape=box,color=red];
		j1083210310 -> j4220934287;
	j3582537049 [label="Pour des raisons très différentes, oui.",shape=box,color=red];
		j3582537049 -> j3950963365;
	j523704316 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j523704316 -> j3015876688 [label="x > 0",color=purple];
		j523704316 -> j1100865672 [label="x <= 0",color=purple];
		j523704316 -> j1100865672 [label="false",color=purple];
	j4220934287 [label="Vraiment? Il semblerait alors qu'il n'y a que toi dans le cas. Entre l'enfant et le diable, chacun semble chercher des parts d'eux-mêmes qu'ils ont égarées.",shape=box,color=blue];
		j4220934287 -> j911412808;
		j4220934287 -> j3308525374;
	j3950963365 [label="Est-ce déplacé de te demander pourquoi tu as l'air perdu? Je connais les raisons de l'enfant et du diable, mais pas les tiennes.",shape=box,color=blue];
		j3950963365 -> j911412808;
		j3950963365 -> j3308525374;
	j3015876688 [label="Pourquoi as-tu accepté d'aider le diable dans ses entreprises? J'ai entendu dire que tu es responsable du massacre des siens.",shape=box,color=blue];
		j3015876688 -> j1416479920;
		j3015876688 -> j1883750938;
		j3015876688 -> j3945684056;
	j1100865672 [label="As-tu l'intention d'aider le diable dans ses entreprises? J'ai entendu dire que tu es responsable du massacre des siens.",shape=box,color=blue];
		j1100865672 -> j1416479920;
		j1100865672 -> j1883750938;
		j1100865672 -> j3945684056;
	j911412808 [label="J'ai passé un nombre indéterminé d'années à mourir des mains de... eh bien? De moi-même. Ça ne me dérange pas de ne pas pouvoir me souvenir de chacune d'elles.",shape=box,color=red];
		j911412808 -> j822786540;
	j3308525374 [label="Pour résumer, j'ai passé... de nombreuses années à souffrir. J'imagine que c'est une sorte de mécanisme d'autodéfense, pour oublier.",shape=box,color=red];
		j3308525374 -> j3805633561;
	j1416479920 [label="C'était mon autre moi. Je crois qu'il faut imputer la responsabilité aux individus et non aux sociétés.",shape=box,color=red];
		j1416479920 -> j1246146914;
	j1883750938 [label="Ce n'était pas moi, c'était le gamin. Mais je déteste les Orokins autant que lui.",shape=box,color=red];
		j1883750938 -> j1347519865;
	j3945684056 [label="Je n'étais pas là, la Nuit des Tambours Naga, quand les Tennos ont attaqué les Orokins. C'était le gamin.",shape=box,color=red];
		j3945684056 -> j3131914388;
	j822786540 [label="Je ne te blâme pas. Si j'étais victime de tels abus, je serais bien décidée à tout oublier. À tout le moins, je n'irais pas les chercher.",shape=box,color=blue];
		j822786540 -> j2567465286;
	j3805633561 [label="Je n'en doute pas! Si j'étais soumise à de tels abus, je m'attendrais à ce que mon âme fasse la même chose: cacher tout ce qui est irréparable et qui ne sert à rien.",shape=box,color=blue];
		j3805633561 -> j2567465286;
	j1246146914 [label="Add 1 to Thermostat counter",color=orange];
		j1246146914 -> j3996487582;
	j1347519865 [label="Add -1 to Thermostat counter",color=orange];
		j1347519865 -> j4163230128;
	j3131914388 [label="La Nuit des Tambours Naga. Oh, je la vois dans ma tête. Quelles couleurs magnifiques!",shape=box,color=blue];
		j3131914388 -> j2365896824;
	j2567465286 [label="+5 Chemistry",color=orange];
		j2567465286 -> j2662547423;
	j3996487582 [label="Oui, je comprends. On va vite pour brûler le bâtiment, alors que l'odeur vient des rats qui rôdent dans ses murs.",shape=box,color=blue];
		j3996487582 -> j54049563;
	j4163230128 [label="Je meurs d'envie de savoir pourquoi! Mais ce sera pour plus tard. Sinon, nous resterons ici pour toujours et Monsieur Loid m'en voudra.",shape=box,color=blue];
		j4163230128 -> j4192617946;
	j2365896824 [label="Il faudra que je parle à Monsieur Loid pour avoir plus de détails. Mais!",shape=box,color=blue];
		j2365896824 -> j4192617946;
	j2662547423 [label="Cependant, cela peut me donner un aperçu de ce dont je souhaitais te parler.",shape=box,color=blue];
		j2662547423 -> j523704316;
	j54049563 [label="Mais ce sera pour plus tard. Sinon, nous resterons ici pour toujours et Monsieur Loid m'en voudra.",shape=box,color=blue];
		j54049563 -> j4192617946;
	j4192617946 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4192617946 -> j3683050170 [label="x > 0",color=purple];
		j4192617946 -> j3659312401 [label="x <= 0",color=purple];
		j4192617946 -> j3659312401 [label="false",color=purple];
	j3683050170 [label="Pardonne-moi! Je ne te laisse pas le temps de répondre. Pourquoi prêter main-forte au diable, alors?",shape=box,color=blue];
		j3683050170 -> j4278936385;
		j3683050170 -> j716983358;
		j3683050170 -> j1212673984;
		j3683050170 -> j3804298350;
	j3659312401 [label="Pardonne-moi! Je ne te laisse pas le temps de répondre. Vas-tu finalement prêter main-forte au diable?",shape=box,color=blue];
		j3659312401 -> j3804298350;
		j3659312401 -> j1212673984;
		j3659312401 -> j716983358;
		j3659312401 -> j4278936385;
	j4278936385 [label="Il n'a rien fait pour prouver qu'il ne mérite pas d'être aidé... pour l'instant.",shape=box,color=red];
		j4278936385 -> j995344473;
	j716983358 [label="Je ne pense pas que je puisse me permettre de refuser des alliés.",shape=box,color=red];
		j716983358 -> j2918975126;
	j1212673984 [label="[Avouez votre intérêt pour Roathe.] Il y a quelque chose de fascinant en lui...",shape=box,color=red];
		j1212673984 -> j1402446308;
	j3804298350 [label="On dirait qu'il fait ce qu'il faut pour survivre. Je ne peux pas lui en vouloir.",shape=box,color=red];
		j3804298350 -> j3996288640;
	j995344473 [label="Add 1 to Thermostat counter",color=orange];
		j995344473 -> j1893783509;
	j2918975126 [label="Boolean MarieRoatheSoldier is now true.",color=orange];
		j2918975126 -> j440034090;
	j1402446308 [label="Boolean DrifterRoathe is now true.",color=orange];
		j1402446308 -> j105125982;
	j3996288640 [label="Add -1 to Thermostat counter",color=orange];
		j3996288640 -> j2759978966;
	j1893783509 [label="+5 Chemistry",color=orange];
		j1893783509 -> j105832418;
	j440034090 [label="Ah, je vois. Ton boulot consiste simplement à rassembler des soldats. Mais ce diable préférerait te planter un poignard entre les côtes plutôt que de surveiller tes arrières.",shape=box,color=blue];
		j440034090 -> j1916677131;
	j105125982 [label="Le diable séduit les cœurs les plus forts. Il joue la ruse, mais fais preuve de prudence. Assure-toi qu'il croise ton regard et rien d'autre. ",shape=box,color=blue];
		j105125982 -> j2225800895;
	j2759978966 [label="Il me semble qu'il a survécu plus longtemps que quiconque n'aurait dû. Je pense que l'enfer devrait peut-être reprendre ses droits, il semble s'être égaré.",shape=box,color=blue];
		j2759978966 -> j2225800895;
	j105832418 [label="Je loue ta compassion, elle emplit mon cœur de joie. Les Luminaires nous enseignent que chacun doit pouvoir recevoir de l'aide. Chacun peut être pardonné. Mais... seulement s'il le demande.",shape=box,color=blue];
		j105832418 -> j3166623658;
	j1916677131 [label="Ce n'est pas ton allié et il ne le sera jamais. Ce diable ne se range que du côté de ceux qui servent ses intérêts.",shape=box,color=blue];
		j1916677131 -> j510244095;
		j1916677131 -> j377230737;
		j1916677131 -> j2946421006;
	j2225800895 [label="+5 Chemistry",color=orange];
		j2225800895 -> j843508237;
	j3166623658 [label="C'est un travail sans fin d'aider ceux qui ne transpirent jamais dans le champ de leur propre rédemption, c'est la vie d’un esclave toujours corvéable.",shape=box,color=blue];
		j3166623658 -> j510244095;
		j3166623658 -> j377230737;
		j3166623658 -> j2946421006;
	j510244095 [label="J'en sais plus que toi sur l'Orokin et sa situation. Je n'ai pas besoin de ton aide.",shape=box,color=red];
		j510244095 -> j3840474405;
	j377230737 [label="J'apprécie tes avertissements. Je les garderai à l'esprit quand j'aurai affaire à lui.",shape=box,color=red];
		j377230737 -> j1024078296;
	j2946421006 [label="Merci. Mais je gère. Et, plus important encore, j'ai déjà fait face à pire que lui.",shape=box,color=red];
		j2946421006 -> j1835331340;
	j843508237 [label="Mais je suis dure… tu ne le connais pas. Tu ne le vois pas tel qu'il est. Je ne veux simplement pas que tu souffres.",shape=box,color=blue];
		j843508237 -> j510244095;
		j843508237 -> j377230737;
		j843508237 -> j2946421006;
	j3840474405 [label="Boolean MarieRoatheWarning is now true.",color=orange];
		j3840474405 -> j2093709380;
	j1024078296 [label="+10 Chemistry",color=orange];
		j1024078296 -> j1512507304;
	j1835331340 [label="+5 Chemistry",color=orange];
		j1835331340 -> j537149683;
	j2093709380 [label="Pardon. Je ne te connais pas bien, pas plus que je ne connais ta capacité à résister à la manipulation. Je m'inquiète juste, car nous te submergeons de nos malheurs.",shape=box,color=blue];
		j2093709380 -> j502957967;
	j1512507304 [label="C'est tout ce que je demande. Merci, merci, merci. Maintenant, je crains de devoir partir.",shape=box,color=blue];
		j1512507304 -> "Chat ends.";
	j537149683 [label="Oui, tu as raison. Je ne te connais pas bien, pas plus que je ne connais ta capacité à résister à la manipulation. Je m'inquiète juste, car nous te submergeons de nos malheurs.",shape=box,color=blue];
		j537149683 -> j4031826166;
	j502957967 [label="Je saurai rester à ma place.",shape=box,color=blue];
		j502957967 -> "Chat ends.";
	j4031826166 [label="Et maintenant, je crains de devoir partir.",shape=box,color=blue];
		j4031826166 -> "Chat ends.";
}