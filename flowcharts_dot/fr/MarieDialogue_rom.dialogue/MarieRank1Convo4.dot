	282 [label="+5 Chemistry",color=orange];
		282 -> 285;
	281 [label="Ah, je vois. Ton boulot consiste simplement à rassembler des soldats. Mais ce diable préférerait te planter un poignard entre les côtes plutôt que de surveiller tes arrières.",shape=box,color=blue];
		281 -> 284;
	280 [label="Le diable séduit les cœurs les plus forts. Il joue la ruse, mais fais preuve de prudence. Assure-toi qu'il croise ton regard et rien d'autre. ",shape=box,color=blue];
		280 -> 283;
	279 [label="Il me semble qu'il a survécu plus longtemps que quiconque n'aurait dû. Je pense que l'enfer devrait peut-être reprendre ses droits, il semble s'être égaré.",shape=box,color=blue];
		279 -> 283;
	285 [label="Je loue ta compassion, elle emplit mon cœur de joie. Les Luminaires nous enseignent que chacun doit pouvoir recevoir de l'aide. Chacun peut être pardonné. Mais... seulement s'il le demande.",shape=box,color=blue];
		285 -> 290;
	284 [label="Ce n'est pas ton allié et il ne le sera jamais. Ce diable ne se range que du côté de ceux qui servent ses intérêts.",shape=box,color=blue];
		284 -> 287;
		284 -> 288;
		284 -> 289;
	283 [label="+5 Chemistry",color=orange];
		283 -> 286;
	290 [label="C'est un travail sans fin d'aider ceux qui ne transpirent jamais dans le champ de leur propre rédemption, c'est la vie d’un esclave toujours corvéable.",shape=box,color=blue];
		290 -> 287;
		290 -> 288;
		290 -> 289;
	287 [label="J'en sais plus que toi sur l'Orokin et sa situation. Je n'ai pas besoin de ton aide.",shape=box,color=red];
		287 -> 291;
	288 [label="J'apprécie tes avertissements. Je les garderai à l'esprit quand j'aurai affaire à lui.",shape=box,color=red];
		288 -> 292;
	289 [label="Merci. Mais je gère. Et, plus important encore, j'ai déjà fait face à pire que lui.",shape=box,color=red];
		289 -> 293;
	286 [label="Mais je suis dure… tu ne le connais pas. Tu ne le vois pas tel qu'il est. Je ne veux simplement pas que tu souffres.",shape=box,color=blue];
