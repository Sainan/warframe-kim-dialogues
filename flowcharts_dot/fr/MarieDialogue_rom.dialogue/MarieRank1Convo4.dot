		258 -> 263;
	259 [label="La Nuit des Tambours Naga. Oh, je la vois dans ma tête. Quelles couleurs magnifiques!",shape=box,color=blue];
		259 -> 264;
	265 [label="+5 Chemistry",color=orange];
		265 -> 268;
	262 [label="Oui, je comprends. On va vite pour brûler le bâtiment, alors que l'odeur vient des rats qui rôdent dans ses murs.",shape=box,color=blue];
		262 -> 266;
	263 [label="Je meurs d'envie de savoir pourquoi! Mais ce sera pour plus tard. Sinon, nous resterons ici pour toujours et Monsieur Loid m'en voudra.",shape=box,color=blue];
		263 -> 267;
	264 [label="Il faudra que je parle à Monsieur Loid pour avoir plus de détails. Mais!",shape=box,color=blue];
