digraph {
	"MarieRank2Convo2 begins." [color=orange];
		"MarieRank2Convo2 begins." -> j1864438865;
		"MarieRank2Convo2 begins." -> j148355226;
		"MarieRank2Convo2 begins." -> j2429168889;
	j1864438865 [label="Comment as-tu rencontré Entrati?",shape=box,color=red];
		j1864438865 -> j1453873476;
	j148355226 [label="Puis-je te demander ce que tu penses d'Entrati, maintenant que tu es ici?",shape=box,color=red];
		j148355226 -> j523206787;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j1453873476 [label="Je le connaissais sous le nom de Cardinal Dimanche. Ce qui pourrait te surprendre, c'est le nombre d'années qu'il a passées dans l'Église, à prêcher à nos fidèles.",shape=box,color=blue];
		j1453873476 -> j2229382538;
		j1453873476 -> j3381388482;
	j523206787 [label="+5 Chemistry",color=orange];
		j523206787 -> j1651962496;
	"Chat ends." [color=orange];
	j2229382538 [label="Tu crois que c'était de la comédie? Ou tu penses qu'il y croyait?",shape=box,color=red];
		j2229382538 -> j1012466991;
	j3381388482 [label="Rien de surprenant. C'est un excellent menteur.",shape=box,color=red];
		j3381388482 -> j672302457;
	j1651962496 [label="Ah, une question très polie qui masque une réponse très difficile – formulée de manière assez astucieuse, je dois l’admettre.",shape=box,color=blue];
		j1651962496 -> j1386438980;
	j1012466991 [label="Il a parlé de pardon, de famille et d’empathie avec une telle ferveur et un tel dévouement que je ne sais pas comment cela pourrait être une comédie.",shape=box,color=blue];
		j1012466991 -> j845258415;
	j672302457 [label="Je comprends que tes expériences avec lui soient différentes des miennes. Mais tu dois aussi comprendre qu'il était pour moi une personne très gentille et attentionnée.",shape=box,color=blue];
		j672302457 -> j3028968923;
	j1386438980 [label="J'éprouve les mêmes sentiments que le premier jour où je l'ai vu prononcer un sermon en chaire devant nos paroissiens. Quelle bénédiction d'avoir été en sa présence.",shape=box,color=blue];
		j1386438980 -> j1167737496;
		j1386438980 -> j979027789;
		j1386438980 -> j1569751408;
	j845258415 [label="A-t-il la foi en les Luminaires? De Sol et de Lua? Je l'ignore, sachant désormais d'où et de quand il vient. Peu importe.",shape=box,color=blue];
		j845258415 -> j4019416860;
	j3028968923 [label="Tes vérités invalident-elles les miennes? Que dois-je croire? Devrais-je condamner chaque acte de miséricorde, chaque acte de douceur dont il a fait preuve durant ses années au sein de la paroisse?",shape=box,color=blue];
		j3028968923 -> j3599815912;
	j1167737496 [label="Ça fait plaisir à entendre, honnêtement. Je pense que tout le monde le condamne un peu trop vite.",shape=box,color=red];
		j1167737496 -> j635765440;
	j979027789 [label="Tu crois qu'il baladait les gens? Ou tu penses qu'il y croyait?",shape=box,color=red];
		j979027789 -> j1012466991;
	j1569751408 [label="Cela me navre que tu sois tombée dans son piège.",shape=box,color=red];
		j1569751408 -> j672302457;
	j4019416860 [label="Quelle importance a le nom des dieux que tu pries, si tu portes leur amour au plus profond de ton cœur? Aucune, je dirais.",shape=box,color=blue];
		j4019416860 -> j1004735353;
		j4019416860 -> j2554672870;
	j3599815912 [label="Non, je ne pense pas.",shape=box,color=blue];
		j3599815912 -> j1850721767;
	j635765440 [label="+10 Chemistry",color=orange];
		j635765440 -> j4078245761;
	j1004735353 [label="C'est une belle façon de voir les choses. ",shape=box,color=red];
		j1004735353 -> j1004176967;
	j2554672870 [label="Je ne suis pas d'accord. Être une bonne personne ne fait pas immédiatement de moi l'adepte d'un dieu de la bonté.",shape=box,color=red];
		j2554672870 -> j3641697256;
	j1850721767 [label="Pardonne-moi, mais je ne ferai pas de lui un monstre simplement parce que tu le dis.",shape=box,color=blue];
		j1850721767 -> j2209081154;
	j4078245761 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j4078245761 -> j228243449;
	j1004176967 [label="Je crois que le Cardinal a véritablement la foi des Luminaires dans son âme, même s'il ne croit pas qu'ils l'attendent dans l'au-delà.",shape=box,color=blue];
		j1004176967 -> j4011289830;
	j3641697256 [label="+5 Chemistry",color=orange];
		j3641697256 -> j3120552577;
	j2209081154 [label="Boolean MarieEntratiMonster1 is now true.",color=orange];
		j2209081154 -> "Chat ends.";
	j228243449 [label="Oh! Comme cela me réjouit le cœur de l'entendre. Je croyais être seule dans ce cas. Je suis entourée de gens qui ne pensent que du mal du Cardinal.",shape=box,color=blue];
		j228243449 -> j4005366275;
		j228243449 -> j3355841298;
		j228243449 -> j321095072;
	j4011289830 [label="Car quel autre homme connaît la valeur de l'empathie face aux ténèbres de l'Indifférence?",shape=box,color=blue];
		j4011289830 -> j2413258194;
	j3120552577 [label="Tu as raison, ce n'est pas le cas. Je ne te qualifierais pas de disciple de Sol simplement parce que tu suis sa voie par ignorance. Plus le monde est bon, plus le monde s'améliore, peu importe le nom qu'on lui donne.",shape=box,color=blue];
		j3120552577 -> j1221383279;
	j4005366275 [label="J'aimerais juste qu'il y ait un moyen pour qu'ils lui pardonnent tous - il fait de son mieux pour arranger les choses.",shape=box,color=red];
		j4005366275 -> j442339161;
	j3355841298 [label="Ils ont leurs raisons. Mais il est notre seule chance de stopper l'Indifférence.",shape=box,color=red];
		j3355841298 -> j1359644092;
	j321095072 [label="Entrati n'a pas non plus une très haute opinion de lui-même. ",shape=box,color=red];
		j321095072 -> j3894742627;
	j2413258194 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j2413258194 -> j1754900690 [label=true,color=green];
		j2413258194 -> j2771181403 [label=false,color=brown];
	j1221383279 [label="Et donc, je crois que le Cardinal est béni, même s'il ne donne pas vraiment à la foi le même nom que moi.",shape=box,color=blue];
		j1221383279 -> j4011289830;
	j442339161 [label="Add 1 to Thermostat counter",color=orange];
		j442339161 -> j4248046744;
	j1359644092 [label="Add -1 to Thermostat counter",color=orange];
		j1359644092 -> j2028088321;
	j3894742627 [label="Oui, et comme c'est tragique... ça me fait pleurer rien que d'y penser. Et aussi Monsieur Loid seul, leur amour à la dérive.",shape=box,color=blue];
		j3894742627 -> j1390995166;
	j1754900690 [label="Pardonne-moi, j'ai oublié... tu ne crois pas que ton Indifférence soit réelle. Simplement une hallucination. Mais tu crois à son émotion, oui?",shape=box,color=blue];
		j1754900690 -> j2195852228;
		j1754900690 -> j2616541333;
	j2771181403 [label="C'est parfait qu'il vienne prêcher ce message en contrepartie de ce qu'il a déchaîné, n'est-ce pas?",shape=box,color=blue];
		j2771181403 -> j399974816;
		j2771181403 -> j2194324820;
		j2771181403 -> j3579273927;
	j4248046744 [label="Oui et je pense que c’est la quête dans laquelle nous nous trouvons tous.",shape=box,color=blue];
		j4248046744 -> j1390995166;
	j2028088321 [label="Oui, mais la bataille contre l'Indifférence ne se gagne pas à coups d'épée et de pierre. Elle se gagne avec le cœur, ne comprends-tu pas?",shape=box,color=blue];
		j2028088321 -> j1390995166;
	j1390995166 [label="Ce n'est pas au diable Orokin qu'il veut que nous pardonnions, non? C'est au Cardinal, c'est clair. Et je pense que c'est l'amour de Monsieur Loid qui l'inspire.",shape=box,color=blue];
		j1390995166 -> j3344890356;
	j2195852228 [label="Toutes les émotions ont un but, même l’Indifférence.",shape=box,color=red];
		j2195852228 -> j3543690029;
	j2616541333 [label="Oui. J'en ai été victime à Duviri. J'ai laissé l'apathie me ronger jusqu'à ce qu'il ne me reste plus que ça.",shape=box,color=red];
		j2616541333 -> j1328881788;
	j399974816 [label="J’aimerais savoir comment l’aider à résoudre le problème.",shape=box,color=red];
		j399974816 -> j2104945180;
	j2194324820 [label="Dommage qu’il n'ait pas un meilleur plan que \"prêcher\".",shape=box,color=red];
		j2194324820 -> j757962066;
	j3579273927 [label="Eh bien, vu que c'est de sa faute si cette chose se propage... oui. C'est le moins qu'il puisse faire.",shape=box,color=red];
		j3579273927 -> j2079483483;
	j3344890356 [label="Ça me brise le cœur. Je souhaite tellement les voir réunis!",shape=box,color=blue];
		j3344890356 -> j683938085;
		j3344890356 -> j3382698817;
	j3543690029 [label="Bien sûr qu'elles ont un but, je ne le nie pas.",shape=box,color=blue];
		j3543690029 -> j2935953755;
	j1328881788 [label="+5 Chemistry",color=orange];
		j1328881788 -> j2335189181;
	j2104945180 [label="+5 Chemistry",color=orange];
		j2104945180 -> j2599332041;
	j757962066 [label="Et qui sommes-nous pour juger ses méthodes? Le Cardinal Dimanche est un génie, béni par les Luminaires. Il saura nous guider.",shape=box,color=blue];
		j757962066 -> j1934588014;
		j757962066 -> j3801230926;
	j2079483483 [label="Change de ton. Le Cardinal Dimanche est un génie, béni par les Luminaires. Il nous guidera.",shape=box,color=blue];
		j2079483483 -> j672591138;
		j2079483483 -> j1934588014;
		j2079483483 -> j3801230926;
	j683938085 [label="Je... pense qu'il y a la question de la Mère de Mère, cependant... la femme d'Entrati.",shape=box,color=red];
		j683938085 -> j3861638378;
	j3382698817 [label="Je pense que ce n'est qu'une question de temps. ",shape=box,color=red];
		j3382698817 -> j560493526;
	j2935953755 [label="Je ne te blâme pas, tu sais.",shape=box,color=blue];
		j2935953755 -> j2560048292;
		j2935953755 -> j164547866;
	j2335189181 [label="Oui, oui – J'ai entendu les autres parler de ce monde que tu as créé. Quand tu n'avais personne vers qui te tourner.",shape=box,color=blue];
		j2335189181 -> j2935953755;
	j2599332041 [label="Le Cardinal Dimanche est un génie, béni par les Luminaires. Il nous guidera.",shape=box,color=blue];
		j2599332041 -> j2701969200;
		j2599332041 -> j1934588014;
		j2599332041 -> j3801230926;
	j1934588014 [label="Entrati n'est qu'un homme, rien de plus. Et il n'est même pas Cardinal.",shape=box,color=red];
		j1934588014 -> j2518189055;
	j3801230926 [label="Penses-tu qu'il est sage d'avoir foi en lui?",shape=box,color=red];
		j3801230926 -> j1986297819;
	j672591138 [label="Pardon. Je partage ta foi en lui.",shape=box,color=red];
		j672591138 -> j605938916;
	j3861638378 [label="Savons-nous si elle est encore en vie? Ou ce qu'il est advenu d'elle?",shape=box,color=blue];
		j3861638378 -> j1089569185;
		j3861638378 -> j2468151495;
	j560493526 [label="+5 Chemistry",color=orange];
		j560493526 -> j2997200322;
	j2560048292 [label="Je suppose que c'est ton rôle, n'est-ce pas? Pardonner?",shape=box,color=red];
		j2560048292 -> j2280812889;
	j164547866 [label="Me blâmer pour quoi?",shape=box,color=red];
		j164547866 -> j3937523653;
	j2701969200 [label="Je partage ta foi en lui.",shape=box,color=red];
		j2701969200 -> j2417752706;
	j2518189055 [label="Oui. Et tu es une créature du Néant qui voyage dans le temps, capable de remonter le temps à volonté et de créer des univers entiers de toutes pièces.",shape=box,color=blue];
		j2518189055 -> j3402168218;
	j1986297819 [label="Evaluate expressions",color=orange];
		j1986297819 -> j3335728686 [label="DrifterFaithYesSimilar",color=purple];
		j1986297819 -> j3335728686 [label="DrifterFaithYesForeign",color=purple];
		j1986297819 -> j3335728686 [label="DrifterFaithPersonal",color=purple];
		j1986297819 -> j3335728686 [label="DrifterFaithSol",color=purple];
		j1986297819 -> j3335728686 [label="DrifterFaithLua",color=purple];
		j1986297819 -> j3335728686 [label="DrifterFaithBalance",color=purple];
		j1986297819 -> j4175860781 [label="false",color=purple];
	j605938916 [label="Je suis ravie de l'entendre. Car je sais que tu n'as pas vraiment de raisons de le faire. J'ai entendu les histoires des Cavias.",shape=box,color=blue];
		j605938916 -> j879010410;
	j1089569185 [label="Nous pouvons... probablement supposer qu’elle est morte, en fait.",shape=box,color=red];
		j1089569185 -> j2380565421;
	j2468151495 [label="Non, et personne ne semble vouloir parler d’elle.",shape=box,color=red];
		j2468151495 -> j2380565421;
	j2997200322 [label="Nous devons garder la foi. Car si nous perdons l'espoir que l'amour triomphera de tout, alors les ténèbres l'emporteront.",shape=box,color=blue];
		j2997200322 -> j1830939859;
	j2280812889 [label="Cela va te surprendre, je pense, de savoir à quel point cela relève peu de ma responsabilité. ",shape=box,color=blue];
		j2280812889 -> j1377849004;
	j3937523653 [label="Pour ne pas croire. À l'Indifférence. À quoi que ce soit. Si j'avais créé un monde de tissu du Néant, peut-être que je ressentirais la même chose.",shape=box,color=blue];
		j3937523653 -> j1377849004;
	j2417752706 [label="+5 Chemistry",color=orange];
		j2417752706 -> j605938916;
	j3402168218 [label="Je me tiens aux côtés d'un diable qui vit depuis des siècles. Non loin de là se trouve une femme, une machine dotée de l'âme d'une triple déesse.",shape=box,color=blue];
		j3402168218 -> j4089486918;
	j3335728686 [label="Ha! Tu devrais savoir, plus que quiconque, que la foi n'est jamais sage. Pourtant, des âmes comme la nôtre la portent malgré tout, même si cela peut nous brûler. Je suppose que tu le sais, si notre conversation précédente était sincère.",shape=box,color=blue];
		j3335728686 -> j209295640;
		j3335728686 -> j2188222066;
	j4175860781 [label="La foi n'est jamais sage. Mais ceux d'entre nous qui la portent comme un flambeau s'efforcent de la garder en toutes circonstances, même si elle peut nous brûler.",shape=box,color=blue];
		j4175860781 -> j3638575960;
	j879010410 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j879010410 -> j1185699525;
	j2380565421 [label="Et pourrais-tu considérer qu'un cœur puisse appartenir à plusieurs âmes? Qu'on puisse aimer plusieurs personnes?",shape=box,color=blue];
		j2380565421 -> j3205612791;
		j2380565421 -> j3834232394;
	j1830939859 [label="L'amour est tout ce qui nous reste au monde quand tout le reste échoue, non?",shape=box,color=blue];
		j1830939859 -> j2770203568;
	j1377849004 [label="Le pardon ultime n’est pas quelque chose à rechercher auprès des autres, ni même auprès des Luminaires.",shape=box,color=blue];
		j1377849004 -> j518139899;
		j1377849004 -> j119343387;
	j4089486918 [label="Mon frère entend les voix des morts et des dieux eux-mêmes.",shape=box,color=blue];
		j4089486918 -> j2392048359;
	j209295640 [label="Parfois, je me demande si je ne suis pas stupide de porter quelque chose qui pourrait me blesser.",shape=box,color=red];
		j209295640 -> j1451641424;
	j2188222066 [label="Parfois, je me demande pourquoi nous le portons.",shape=box,color=red];
		j2188222066 -> j907072591;
	j3638575960 [label="Alors, pourquoi le porter, je me demande?",shape=box,color=red];
		j3638575960 -> j1563026773;
	j1185699525 [label="Evaluate expressions",color=orange];
		j1185699525 -> j3246702479 [label="DrifterFaithYesSimilar",color=purple];
		j1185699525 -> j3246702479 [label="DrifterFaithYesForeign",color=purple];
		j1185699525 -> j3246702479 [label="DrifterFaithPersonal",color=purple];
		j1185699525 -> j3246702479 [label="DrifterFaithSol",color=purple];
		j1185699525 -> j3246702479 [label="DrifterFaithLua",color=purple];
		j1185699525 -> j3246702479 [label="DrifterFaithBalance",color=purple];
		j1185699525 -> j846189044 [label="DrifterFaithAgnostic",color=purple];
		j1185699525 -> j2047516370 [label="DrifterFaithNoFear",color=purple];
		j1185699525 -> j846189044 [label="DrifterFaithNoMaybe",color=purple];
		j1185699525 -> j4159280522 [label="false",color=purple];
	j3205612791 [label="Personnellement, non.",shape=box,color=red];
		j3205612791 -> j985826901;
	j3834232394 [label="Oui, si toutes les parties sont d’accord. ",shape=box,color=red];
		j3834232394 -> j485847355;
	j2770203568 [label="Ah! Mais tu es là pour une histoire! J'abuse de ton temps, alors je serai brève.",shape=box,color=blue];
		j2770203568 -> j2609684745;
	j518139899 [label="Intéressant. Pourquoi dis-tu ça?",shape=box,color=red];
		j518139899 -> j2255063402;
	j119343387 [label="Même si tu as fait du tort à quelqu'un d'autre?",shape=box,color=red];
		j119343387 -> j3882976902;
	j2392048359 [label="J'ai rompu le jeûne avec des animaux qui s'enquéraient de la qualité de mon repos.",shape=box,color=blue];
		j2392048359 -> j3357940572;
	j1451641424 [label="Add 1 to Thermostat counter",color=orange];
		j1451641424 -> j1563026773;
	j907072591 [label="Add -1 to Thermostat counter",color=orange];
		j907072591 -> j499078344;
	j1563026773 [label="Nous le portons parce que nous le devons. Parce que nous ne connaissons pas d'autre façon d'être. Peu importe ce que cela signifie, au final. Je comprends ce que tu ressens.",shape=box,color=blue];
		j1563026773 -> j1564235823;
	j3246702479 [label="Pour les âmes comme la nôtre, la foi est comme un flambeau: nous le portons toujours, même s'il peut finalement nous brûler.",shape=box,color=blue];
		j3246702479 -> j2188222066;
		j3246702479 -> j209295640;
	j846189044 [label="Je suis toutefois surprise. Tu as déjà exprimé des doutes sur la foi.",shape=box,color=blue];
		j846189044 -> j170393478;
		j846189044 -> j1932506638;
	j2047516370 [label="Je suis toutefois surprise. Tu as déjà dit que tu étais quelqu'un de peu croyant.",shape=box,color=blue];
		j2047516370 -> j170393478;
		j2047516370 -> j1932506638;
	j4159280522 [label="Pour les âmes comme la mienne, la foi est comme un flambeau: nous le portons toujours, même s'il peut finalement nous brûler.",shape=box,color=blue];
		j4159280522 -> j3638575960;
	j985826901 [label="Boolean DrifterPNo is now true.",color=orange];
		j985826901 -> j759352617;
	j485847355 [label="Boolean DrifterPYes is now true.",color=orange];
		j485847355 -> j759352617;
	j2609684745 [label="C'était un bel après-midi ensoleillé. Je me souviens de lui, debout devant l'autel, contemplant le vitrail avec un sourire aux lèvres, sans que je sache pourquoi.",shape=box,color=blue];
		j2609684745 -> j2183921667;
	j2255063402 [label="Chercher à réparer les dommages causés est important, ne te méprends pas. Dans la mesure du possible, se faire pardonner par ceux qui ont été blessés est un véritable baume.",shape=box,color=blue];
		j2255063402 -> j1548824912;
	j3882976902 [label="Oh, je ne veux pas dire qu'il n'est pas important de demander pardon à ceux que l'on a blessés! Si!",shape=box,color=blue];
		j3882976902 -> j104472100;
	j3357940572 [label="Parle-moi encore une fois de ceux qui ne sont \"que des hommes\" et je ferai de mon mieux pour ne pas rire, je t'en donne ma parole.",shape=box,color=blue];
		j3357940572 -> j90565087;
	j499078344 [label="La foi n'est pas constante. Elle est comme la marée. Elle va et vient, et c'est normal.",shape=box,color=blue];
		j499078344 -> j1564235823;
	j1564235823 [label="Mais je crains que tout cela n'ait rien à voir avec ce dont tu veux parler. Tu voulais une histoire, non?",shape=box,color=blue];
		j1564235823 -> j2609684745;
	j170393478 [label="Je peux croire aux gens et aux dieux différemment.",shape=box,color=red];
		j170393478 -> j1915107796;
	j1932506638 [label="Il y a une différence entre la foi en Dieu et la foi en l'homme. Et Entrati est tout simplement un homme.",shape=box,color=red];
		j1932506638 -> j2518189055;
	j759352617 [label="Intéressant. Je ne connais pas suffisamment les Orokins pour savoir si c'est contraire à leurs coutumes. Mais je sais que dans de nombreuses cultures anciennes, ce n'était pas mal vu.",shape=box,color=blue];
		j759352617 -> j2091585316;
	j2183921667 [label="Il s'est accroupi pour me saluer, de sorte que sa tête était en dessous de la mienne sur ma chaise.",shape=box,color=blue];
		j2183921667 -> j855846236;
	j1548824912 [label="Mais à la fin, lorsque nous faisons face à l'Ancienne Sage, lorsque Lua verse ses larmes d'argent pour nous et que la fin est proche, c'est le poids de notre propre cœur que nous devons porter.",shape=box,color=blue];
		j1548824912 -> j3651206021;
		j1548824912 -> j4098712535;
	j104472100 [label="Réparer les dommages que l'on aurait pu causer est un baume encore plus puissant pour l'âme. ",shape=box,color=blue];
		j104472100 -> j1548824912;
