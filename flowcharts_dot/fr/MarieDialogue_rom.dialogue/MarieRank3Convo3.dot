		1114 -> 1116 [label=false,color=brown];
		1114 -> 1117 [label=false,color=brown];
		1114 -> 1118 [label=false,color=brown];
	1115 [label="Pourrais-tu m'en dire plus sur la vie à la Cathédrale, avant l'arrivée d'Entrati?",shape=box,color=red];
		1115 -> 1119;
	1117 [label="Où as-tu grandi, Marie?",shape=box,color=red];
		1117 -> 2425;
	1118 [label="[Fin.]",shape=box,color=red];
		1118 -> 1122;
	1116 [label="À quoi ressemblait ta vie à la Cathédrale avant l’arrivée d’Entrati?",shape=box,color=red];
		1116 -> 1120;
	1119 [label="Je dirais que j'étais assez seule, en vérité. J'avais Lyon, mais tu sais comment il peut être, parfois. (Oh! Je suis si contente que vous vous parliez, maintenant!)",shape=box,color=blue];
		1119 -> 1123;
	2425 [label="Update boolean MarieBackstory1",color=orange];
		2425 -> 1121;
	1122 [label="Chat ends.",color=orange];
	1120 [label="Oh, je ne sais pas si ça t'intéressera vraiment, mais je te le dirai quand même si tu veux. ",shape=box,color=blue];
		1120 -> 1124;
	1123 [label="Update boolean MarieGraveyard2",color=orange];
		1123 -> 1126;
	1121 [label="J'aurais pensé que la langue me trahirait, mais ensuite je me suis souvenue que tu n'es pas de mon monde tel que je le connais, hah!",shape=box,color=blue];
		1121 -> 1125;
	1124 [label="Je passais mon temps à vaquer à mes occupations de Sœur de Sol: épousseter les vases de communion, disposer des bougies pour les paroissiens. ",shape=box,color=blue];
		1124 -> 1127;
	1126 [label="Mais ce n’est pas pour cela que je passe autant de temps à parler aux morts.",shape=box,color=blue];
		1126 -> 1129;
	1125 [label="Je viens de la Cité de la Lumière, capitale d'un pays appelé la Gaule. Sur une carte du monde, elle n'est pas très éloignée de la Höllvanie.",shape=box,color=blue];
		1125 -> 1128;
	1127 [label="Je m'occupais de la crypte et du cimetière. C'était ma tâche préférée.",shape=box,color=blue];
		1127 -> 1130;
		1127 -> 1131;
	1129 [label="Update boolean MarieGraveyard2",color=orange];
		1129 -> 1134;
	1128 [label="Je me demande si ma Cathédrale existe encore en 1999? Quelle idée intéressante!",shape=box,color=blue];
		1128 -> 1132;
		1128 -> 1133;
	1130 [label="Pourquoi était-ce ta préférée?",shape=box,color=red];
		1130 -> 1135;
	1131 [label="Pardon. C'était quoi la dernière partie?",shape=box,color=red];
		1131 -> 1136;
	1134 [label="Il y a une beauté dans ces endroits, une tranquillité. Ils sont si calmes. Paisibles.",shape=box,color=blue];
		1134 -> 1139;
	1132 [label="Tu aimes bien t'éloigner du sujet, n'est-ce pas?",shape=box,color=red];
		1132 -> 1137;
	1133 [label="Je pourrais probablement demander à deux de mes amis, ils ont beaucoup voyagé. Je crois même qu'ils ont mentionné être allés dans cette ville.",shape=box,color=red];
		1133 -> 1138;
	1135 [label="J'ai beaucoup apprécié discuter avec ceux qui reposent en paix. Ils étaient à l'écoute de mes préoccupations sans porter de jugement.",shape=box,color=blue];
		1135 -> 1140;
	1136 [label="Je devais m'occuper des morts de la Cathédrale. Je balayais la poussière du sol de la crypte et désherbais la pelouse du jardin.",shape=box,color=blue];
		1136 -> 1135;
	1139 [label="Je crois que j'aime leur parler de mes soucis et des activités des autres parce que leurs problèmes sont terminés, oui?",shape=box,color=blue];
		1139 -> 1143;
	1137 [label="+5 Chemistry",color=orange];
		1137 -> 1141;
	1138 [label="+5 Chemistry",color=orange];
		1138 -> 1142;
	1140 [label="Eh bien, ils n'ont jamais répondu un seul mot, mais cela me convenait tout à fait! Je préférais qu'ils restent silencieux.",shape=box,color=blue];
		1140 -> 1144;
	1143 [label="Tout doit leur paraître dérisoire, maintenant, et cela me réconforte.",shape=box,color=blue];
		1143 -> 1146;
		1143 -> 1147;
		1143 -> 1148;
	1141 [label="Tu as remarqué, oui? Lyon me taquine tout le temps en me disant que je suis un grain de poussière dans un rayon de soleil, dérivant au gré du vent. (Je suis si heureuse que vous vous parliez, maintenant!)",shape=box,color=blue];
		1141 -> 1145;
	1142 [label="Oh, ne les dérange pas, c'est une idée absurde. Je ne sais pas à quel point je serais triste d'apprendre qu'elle a disparu.",shape=box,color=blue];
		1142 -> 1145;
	1144 [label="+5 Chemistry",color=orange];
		1144 -> 1149;
	1146 [label="Je ne sais pas, j'ai... peur de vraiment mourir, je n'ai jamais aimé être près de la mort.",shape=box,color=red];
		1146 -> 1151;
	1147 [label="Je n'y ai jamais pensé de cette façon.",shape=box,color=red];
		1147 -> 1152;
	1148 [label="J'ai trouvé la même paix dans les cimetières. Je comprends parfaitement.",shape=box,color=red];
		1148 -> 1153;
	1145 [label="Je suis simplement curieuse, non? Je veux savoir tout ce qui existe. Je pense que c'est pour cela que le Cardinal et moi étions destinés à nous rencontrer.",shape=box,color=blue];
		1145 -> 1150;
	1149 [label="Tu imagines? Des crânes parlants, un peu comme ton Necraloid? Ha!",shape=box,color=blue];
		1149 -> 1154;
		1149 -> 1155;
	1151 [label="Je sais, petite Marie morbide! C'est tellement étrange. Mais chacun son truc, non?",shape=box,color=blue];
		1151 -> 1157;
	1152 [label="Il n'y a pas que toi dans le cas. Nous n'aimons pas passer trop de temps à penser à l'après. Du moins, pas avant d'en être proche.",shape=box,color=blue];
		1152 -> 1158;
	1153 [label="Je suis si heureuse que tu comprennes!",shape=box,color=blue];
		1153 -> 1158;
	1150 [label="Où en étais-je? Ah! Oui. Mon histoire.",shape=box,color=blue];
		1150 -> 1156;
	1154 [label="Cela n’a pas dû être la tâche la plus facile, étant donné ton fauteuil roulant.",shape=box,color=red];
		1154 -> 1159;
	1155 [label="Tu n'avais pas d'autres amis à qui parler?",shape=box,color=red];
		1155 -> 1160;
	1157 [label="Quelqu'un doit s'occuper d'eux. Et c'est une tâche dont je suis ravie de m'occuper.",shape=box,color=blue];
		1157 -> 1158;
	1158 [label="Lyon plaisante en disant que je suis proche du sol, voilà pourquoi je pense autant à la tombe.",shape=box,color=blue];
		1158 -> 1162;
	1156 [label="Je suis née dans une famille riche, ce qui pourrait te surprendre. La classe bourgeoise, qui se rapproche davantage des Orokins.",shape=box,color=blue];
		1156 -> 1161;
	1159 [label="Non, ce n'était pas facile. Mais Lyon m'aidait à monter et descendre les escaliers menant à la crypte quand il fallait et le reste, je l'ai appris avec le temps.",shape=box,color=blue];
		1159 -> 1163;
	1160 [label="Update boolean MarieGraveyard1",color=orange];
		1160 -> 1164;
	1162 [label=" Je lui dis que sa tête est vide, c'est pourquoi elle est si pleine de fantômes.",shape=box,color=blue];
		1162 -> 1166;
	1161 [label="Mais quand je suis née... déformée, avec mes pieds tordus et inutilisables? Oh, ma mère ne pouvait pas supporter ça.",shape=box,color=blue];
		1161 -> 1165;
	1163 [label="C'est impressionnant ce qu'on peut faire avec un peu de volonté, non?",shape=box,color=blue];
		1163 -> 1167;
	1164 [label="J'avais Lyon, bien sûr. Mais tu vois bien comme ça se passe bien, certains jours.",shape=box,color=blue];
		1164 -> 1129;
	1166 [label="Alors, il menace de me pousser en bas d'une colline et je menace de remplir sa soutane d'orties.",shape=box,color=blue];
		1166 -> 1169;
	1165 [label="Il fallait sauver les apparences, oui? Des normes à respecter.",shape=box,color=blue];
		1165 -> 1168;
	1167 [label="Bon. De la volonté et de la force dans le haut du corps, ha!",shape=box,color=blue];
		1167 -> 1170;
	1169 [label="La famille.",shape=box,color=blue];
		1169 -> 1172;
		1169 -> 1173;
		1169 -> 1174;
		1169 -> 3921;
	1168 [label="Alors, que faire de la pauvre Marie malformée? On m'a emmenée à la Cité de la Lumière, où j'ai été laissée dans la rue...",shape=box,color=blue];
		1168 -> 1171;
	1170 [label="Update boolean MarieGraveyard1",color=orange];
		1170 -> 1129;
	1172 [label="Quel dommage qu'Entrati soit venu chambouler ce que tu avais.",shape=box,color=red];
		1172 -> 1177;
	1173 [label="C'est chouette que vous vous soyez soutenus l'un l'autre.",shape=box,color=red];
		1173 -> 1178;
	1174 [label="Vous me faites sourire, tous les deux.",shape=box,color=red];
		1174 -> 1179;
	3921 [label="Donc, vous deux... il ne s'est rien passé entre vous?",shape=box,color=red];
		3921 -> 3922;
	1171 [label="Et abandonnée à la mort.",shape=box,color=blue];
		1171 -> 1175;
		1171 -> 1176;
	1177 [label="+10 Chemistry",color=orange];
		1177 -> 1182;
	1178 [label="+20 Chemistry",color=orange];
		1178 -> 1183;
	1179 [label="+20 Chemistry",color=orange];
		1179 -> 1184;
	3922 [label="Oh, par Sol! Non! Il est comme un frère pour moi à tous les égards, sauf le sang. Je suis complètement dégoûtée rien qu'à cette idée!",shape=box,color=blue];
		3922 -> 3923;
		3922 -> 3924;
	1175 [label="Ta famille t'a laissée pour morte?",shape=box,color=red];
		1175 -> 1180;
	1176 [label="Quel âge avais-tu?",shape=box,color=red];
		1176 -> 1181;
	1182 [label="Entrati n'a rien chamboulé. Lyon et moi sommes plus forts que jamais. Les choses ont simplement changé, non?",shape=box,color=blue];
		1182 -> 1186;
	1183 [label="Je ne serais nulle part sans lui. Sauf peut-être en bas d'une colline. Ha!",shape=box,color=blue];
		1183 -> 1187;
	1184 [label="Il me fait rire de la façon la plus étrange qui soit. Mais je trouve que toi aussi, loup. Je me sens de plus en plus heureuse d'être ici.",shape=box,color=blue];
		1184 -> 1188;
	3923 [label="Simple curiosité.",shape=box,color=red];
		3923 -> 3925;
	3924 [label="J'avoue, ça me soulage un peu de le savoir.",shape=box,color=red];
		3924 -> 3931;
	1180 [label="À leurs yeux, ils avaient fait de leur mieux pour me soigner pendant des années. Des tuteurs pour m'apprendre à marcher. Des appareils orthopédiques. Des chaussures.",shape=box,color=blue];
		1180 -> 1185;
	1181 [label="Six ans? Sept ans? À leurs yeux, ils avaient fait de leur mieux pour me soigner pendant des années. Des tuteurs pour m'apprendre à marcher. Des appareils orthopédiques. Des chaussures.",shape=box,color=blue];
		1181 -> 1185;
	1186 [label="Lua est en perpétuelle évolution. Même Sol, aussi constant soit-il, est influencé dans ses orbites.",shape=box,color=blue];
		1186 -> 1191;
	1187 [label="Il est vraiment le frère de mon âme. Je me sens de plus en plus heureuse d'être ici.",shape=box,color=blue];
		1187 -> 1188;
	1188 [label="J'espère seulement qu'il ressentira bientôt la même chose... mais le diable le hante avec ses murmures et ses mensonges.",shape=box,color=blue];
		1188 -> 1192;
	3925 [label="+10 Chemistry",color=orange];
		3925 -> 3926;
	3931 [label="Check boolean DrifterMarie",color=orange];
		3931 -> 3932 [label=true,color=green];
		3931 -> 3933 [label=false,color=brown];
	1185 [label="Ils étaient fatigués de ce fardeau. Alors, à peine capable de lire et d'écrire mes chiffres et mes lettres, je me suis retrouvée dans la boue.",shape=box,color=blue];
		1185 -> 1189;
		1185 -> 1190;
	1191 [label="Nous ne devons pas être rigides dans nos manières, sinon elles nous briseront, loup. De plus, je me sens de plus en plus heureuse d'être ici.",shape=box,color=blue];
		1191 -> 1188;
	1192 [label="Arf! Parle de lui et il appelle. Je dois y aller.",shape=box,color=blue];
		1192 -> 1194;
	3926 [label="Check boolean DrifterMarie",color=orange];
		3926 -> 3927 [label=true,color=green];
		3926 -> 3928 [label=false,color=brown];
	3932 [label="Oui, tes intentions sont claires. Je dois te prévenir que je ne l'abandonnerai pas. Je connais Lyon depuis bien plus longtemps que toi.",shape=box,color=blue];
		3932 -> 3928;
	3933 [label="Oui? Et lequel d'entre nous chasses-tu?",shape=box,color=blue];
		3933 -> 3934;
		3933 -> 3935;
	1189 [label="Comment as-tu survécu?",shape=box,color=red];
		1189 -> 1193;
	1190 [label="C'est horrible.",shape=box,color=red];
		1190 -> 1193;
	1194 [label="Chat ends.",color=orange];
	3927 [label="Oui. Simple \"curiosité\". Tu ne me trompes pas. Je dois te prévenir que je ne l'abandonnerai pas. Je connais Lyon depuis bien plus longtemps que toi.",shape=box,color=blue];
		3927 -> 3928;
	3928 [label="+20 Chemistry",color=orange];
		3928 -> 3929;
	3934 [label="Toi.",shape=box,color=red];
		3934 -> 3936;
	3935 [label="Lyon.",shape=box,color=red];
		3935 -> 3941;
	1193 [label="Check boolean MarieSecretPower",color=orange];
		1193 -> 1196 [label=true,color=green];
		1193 -> 1195 [label=false,color=brown];
	3929 [label="Je ne serais nulle part sans lui. Sauf peut-être en bas d'une colline. Ha!",shape=box,color=blue];
		3929 -> 3930;
	3936 [label="Update boolean DrifterMarie",color=orange];
		3936 -> 3937;
	3941 [label="Vraiment?!",shape=box,color=blue];
		3941 -> 3942;
	1196 [label="C'est comme tu l'as dit, non? Tous les inconvénients ont un pouvoir secret.",shape=box,color=blue];
		1196 -> 1195;
	1195 [label="Ce qui a fait de moi une indésirable pour ma mère, m'a rendue très populaire parmi les autres enfants des rues.",shape=box,color=blue];
		1195 -> 1197;
	3930 [label="Pourtant, tu m'intrigues, loup. Je me sens de plus en plus heureuse d'être ici.",shape=box,color=blue];
		3930 -> 1188;
	3937 [label="+10 Chemistry",color=orange];
		3937 -> 3938;
	3942 [label="+10 Chemistry",color=orange];
		3942 -> 3943;
	1197 [label="Quoi de plus pathétique qu'un enfant sans pieds, hein? Je pouvais gagner plus en un jour, la main tendue, qu'ils ne pouvaient voler en une semaine.",shape=box,color=blue];
		1197 -> 1198;
	3938 [label="Oh! Par Sol. Tu me prends par surprise, je dois l'avouer. Et me voilà assise ici, toute rouge, cachant mon visage à Monsieur Loid…",shape=box,color=blue];
		3938 -> 3939;
	3943 [label="Tu ne peux pas imaginer à quel point cela me fait plaisir, mais s'il te plaît, réfléchis à ce que tu dis.",shape=box,color=blue];
		3943 -> 3944;
	1198 [label="C'est ainsi que j'ai été trouvée dans la rue par les Sœurs de Sol. Elles m'ont proposé de m'accueillir.",shape=box,color=blue];
		1198 -> 1199;
		1198 -> 1200;
	3939 [label="Je dois te prévenir que je ne l'abandonnerai pas. Je connais Lyon depuis bien plus longtemps que toi.",shape=box,color=blue];
		3939 -> 3940;
	3944 [label="Update boolean DrifterLyon",color=orange];
		3944 -> 3945;
	1199 [label="Et les autres enfants?",shape=box,color=red];
		1199 -> 1201;
	1200 [label="Évidemment, tu as dit oui.",shape=box,color=red];
		1200 -> 1202;
	3940 [label="+10 Chemistry",color=orange];
		3940 -> 1188;
	3945 [label="Lyon est mon frère. Je l'aime plus que tu ne peux l'imaginer, mais c'est un homme tourmenté. Réfléchis bien avant de le courtiser, c'est compris?",shape=box,color=blue];
		3945 -> 3946;
	1201 [label="+5 Chemistry",color=orange];
		1201 -> 1203;
	1202 [label="Oui, que pouvais-je faire? Ce n'était qu'une question de temps avant que je tombe malade. Même enfant, je le savais.",shape=box,color=blue];
		1202 -> 1204;
		1202 -> 1205;
	3946 [label="Nous en reparlerons bientôt, je pense. Ne te méprends pas, je t'encourage! Je veux simplement que tu y réfléchisses bien.",shape=box,color=blue];
		3946 -> 3940;
	1203 [label="Tu as un si grand cœur. Évidemment, elles ne pouvaient pas tous les prendre... mais je n'ai pas oublié mes amis.",shape=box,color=blue];
		1203 -> 1206;
	1204 [label="Comment étaient les Sœurs?",shape=box,color=red];
		1204 -> 1207;
	1205 [label="Comment t'es-tu adaptée à la vie à la Cathédrale?",shape=box,color=red];
		1205 -> 1208;
	1206 [label="Je revenais chaque semaine avec mon salaire et les restes que je pouvais ramasser à la cuisine ou auprès des autres.",shape=box,color=blue];
		1206 -> 1209;
	1207 [label="Les Sœurs ont été si gentilles avec moi! Mais je sais pourquoi tu dois te dire le contraire, non?",shape=box,color=blue];
		1207 -> 1210;
	1208 [label="J'ai adoré! Mais je sais pourquoi tu dois penser le contraire, non?",shape=box,color=blue];
		1208 -> 1210;
	1209 [label="J'ai pris soin d'eux du mieux que j'ai pu, tant que mes amis étaient là. Beaucoup sont morts de la variole ou de la tuberculose...",shape=box,color=blue];
		1209 -> 1211;
	1210 [label="Trois repas, un lit chaud, un toit. Je n'avais pas à craindre d'être battue, volée, ou pire encore.",shape=box,color=blue];
		1210 -> 1212;
	1211 [label="Plusieurs ont déménagé, certains sont morts dans des combats ou des actes de violence. La plupart ont trouvé un travail honnête et ont grandi. Ils ont fondé leur propre famille.",shape=box,color=blue];
		1211 -> 1213;
	1212 [label="J'ai reçu une bonne éducation. On m'a enseigné les Évangiles de Sol et de Lua. On m'a dit de trouver ma voie dans la foi. J'aurais pu partir, si je l'avais voulu.",shape=box,color=blue];
		1212 -> 1214;
	1213 [label="Certains venaient même me voir à la Cathédrale. Ça me faisait chaud au cœur.",shape=box,color=blue];
		1213 -> 1214;
	1214 [label="J'ai longtemps éprouvé de la culpabilité d'avoir été sauvée de la rue alors que d'autres y étaient restés. Certains jours, c'est encore le cas.",shape=box,color=blue];
		1214 -> 1215;
		1214 -> 1216;
	1215 [label="Quand je pense à tous ceux qui sont morts autour de moi, alors que c'est moi qui ai survécu, je ressens la même chose. Mais on ne peut pas s'infliger ça. Il faut continuer à se battre pour améliorer les choses quand on le peut.",shape=box,color=red];
		1215 -> 1217;
	1216 [label="Tu as fait de ton mieux pour aider les autres avec ce que tu avais reçu. Ils t'avaient soutenue et tu as essayé de les soutenir quand tu en as eu l'occasion.",shape=box,color=red];
		1216 -> 1218;
	1217 [label="Est-ce que ce sera toujours comme ça? Un combat? Une guerre contre une marée qui cherche à nous noyer?",shape=box,color=blue];
		1217 -> 1219;
	1218 [label="Add 1 to Thermostat",color=orange];
		1218 -> 1220;
	1219 [label="Add -1 to Thermostat",color=orange];
		1219 -> 1221;
	1220 [label="+10 Chemistry",color=orange];
		1220 -> 1222;
	1221 [label="+10 Chemistry",color=orange];
		1221 -> 1223;
	1222 [label="Oui, c'est exactement ça. J'ai été secourue et maintenant, je dois le faire pour les autres. ",shape=box,color=blue];
		1222 -> 1224;
	1223 [label="Mais je comprends ce que tu veux dire. Au fond, tu dis de ne pas abandonner. Que j'ai reçu ces dons pour servir de bouclier aux autres.",shape=box,color=blue];
		1223 -> 1224;
	1224 [label="Merci. Mais pour l'instant, je dois y aller.",shape=box,color=blue];
		1224 -> 1225;
	1225 [label="Chat ends.",color=orange];
}