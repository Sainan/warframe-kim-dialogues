digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieEntratiDay2 begins." [color=orange];
		"MarieEntratiDay2 begins." -> j2753906485;
	j2753906485 [label="Voyageur. J'ai pris le temps de réfléchir et de... me calmer. Je me suis fixé une règle stricte: il est hors de question de discuter quand je suis furieuse.",shape=box,color=blue];
		j2753906485 -> j69936295;
	j69936295 [label="Evaluate expressions",color=orange];
		j69936295 -> j3696311134 [label="MarieEntrati5a",color=purple];
		j69936295 -> j2958766875 [label="MarieEntrati5b",color=purple];
		j69936295 -> j4105791983 [label="MarieEntrati5c",color=purple];
		j69936295 -> j2421338987 [label="MarieEntrati5d",color=purple];
		j69936295 -> j1816788791 [label="MarieEntrati5e",color=purple];
		j69936295 -> j3498978104 [label="MarieEntrati5f",color=purple];
		j69936295 -> j3334171721 [label="MarieEntrati5g",color=purple];
		j69936295 -> j652872531 [label="MarieEntrati5h",color=purple];
		j69936295 -> j2176829266 [label="MarieEntrati5i",color=purple];
		j69936295 -> "Chat ends." [label="false",color=purple];
	j3696311134 [label="C'était... un coup de poignard dans les côtes, que tu m'as donné hier. J'avoue avoir fui, en colère, oui, mais aussi par répulsion. Non pas contre toi, mais contre moi-même.",shape=box,color=blue];
		j3696311134 -> j3679769203;
	j2958766875 [label="Mais avant de poursuivre, je dois aborder un point: ton propre ton lorsque tu t'adresses à moi. Je sais que tu me prends pour une enfant. Tu es centenaire, voire plus.",shape=box,color=blue];
		j2958766875 -> j2828961014;
	j4105791983 [label="J'ai longuement médité sur tes paroles. Que ce n'est pas une guerre sainte et que le Cardinal a fait preuve de manipulation.",shape=box,color=blue];
		j4105791983 -> j2807627429;
	j2421338987 [label="Tu avais... bien sûr raison de me demander où, dans les écritures de Sol, il est dit que les innocents sont sacrifiables. Bien entendu, il n'existe rien de tel.",shape=box,color=blue];
		j2421338987 -> j3484703543;
	j1816788791 [label="Avant de poursuivre, je dois aborder un point: ta propension à instrumentaliser ma foi contre moi dans une discussion, alors que tu ne t'interroges pas toi-même sur la foi.",shape=box,color=blue];
		j1816788791 -> j1476886559;
	j3498978104 [label="Je suis désolée d'avoir mis fin à notre conversation, hier. C'était tout simplement insupportable. Avant de poursuivre, je dois te demander: penses-tu vraiment ce que tu as dit? Ou cherches-tu simplement à me manipuler pour éviter une dispute désagréable?",shape=box,color=blue];
		j3498978104 -> j835319391;
		j3498978104 -> j3913766553;
	j3334171721 [label="Il semble que nous soyons dans une impasse concernant le Cardinal, n'est-ce pas? Tu le considères comme un monstre et moi, comme un saint.",shape=box,color=blue];
		j3334171721 -> j1372381529;
	j652872531 [label="Je souhaite m'entretenir avec toi au sujet de ta décision de te ranger du côté d'Entrati uniquement pour t'attirer mes faveurs, si tu veux bien.",shape=box,color=blue];
		j652872531 -> j4268405054;
	j2176829266 [label="Je souhaite te parler de ton mensonge, maintenant, si tu veux bien.",shape=box,color=blue];
		j2176829266 -> j4268405054;
	"Chat ends." [color=orange];
	j3679769203 [label="Comment pourrais-je être surprise par une telle précision mortelle dans tes coups? Comparer mes paroles à celles du diable...",shape=box,color=blue];
		j3679769203 -> j3840378733;
	j2828961014 [label="Tu as voyagé à travers des dimensions inconnues, à travers le Néant lui-même. Tu as combattu des dieux et des anges. Qui suis-je pour toi, hein? Juste la petite Marie, toute naïve.",shape=box,color=blue];
		j2828961014 -> j4104299597;
	j2807627429 [label="Et je crois... oui, tu as raison. Ce n’est pas une guerre sainte. Car une telle chose n’existe pas. La guerre n’est jamais sainte, juste ou vertueuse. La souffrance ne doit jamais être notre guide.",shape=box,color=blue];
		j2807627429 -> j1702879589;
	j3484703543 [label="La guerre n'est jamais sainte, ni juste, ni vertueuse. La souffrance ne doit jamais être notre guide.",shape=box,color=blue];
		j3484703543 -> j1702879589;
	j1476886559 [label="C'était de la mauvaise foi, Voyageur. Cruelle et inefficace. C'était une tentative de \"gagner\" une conversation et ce n'est pas ainsi qu'il faut se comporter.",shape=box,color=blue];
		j1476886559 -> j2278636358;
	j835319391 [label="Je pensais ce que je disais. Pardon si mon timing était... maladroit. Je tiens beaucoup à toi, Marie...",shape=box,color=red];
		j835319391 -> j4139941343;
	j3913766553 [label="Je ne le pensais pas, j'étais juste... sous le coup de l'émotion. Je te demande pardon. C'était un moment d'égarement.",shape=box,color=red];
		j3913766553 -> j1318319230;
	j1372381529 [label="Cependant... je ne souhaite pas que les choses restent ainsi entre nous. Tu es une personne bienveillante et je ne veux pas que notre relation s'envenime.",shape=box,color=blue];
		j1372381529 -> j483300420;
	j4268405054 [label="Tenter de manipuler la situation pour contrôler mes sentiments est... malhonnête et cruel. J’avoue que j’ai envie de te haïr pour ça, Voyageur.",shape=box,color=blue];
		j4268405054 -> j2734635471;
	j3840378733 [label="Je me croyais ouverte au monde et à tous ses habitants, tant par l'esprit que par le cœur. Et toi, d'un trait de plume acéré, tu me montres le contraire.",shape=box,color=blue];
		j3840378733 -> j3993094557;
	j4104299597 [label="D'un côté, je comprends. Je compatis. Nous avons tous les deux exagéré. Mais d'un autre côté, je te demande de faire preuve de plus de bienveillance et de tact à mon égard.",shape=box,color=blue];
		j4104299597 -> j771537502;
	j1702879589 [label="Même ce que nous faisons maintenant – détruire le Murmure et combattre tous tes nombreux ennemis – n’est pas la voie des Luminaires.",shape=box,color=blue];
		j1702879589 -> j4003726964;
	j2278636358 [label="La foi n'est pas et ne devrait jamais être une arme à utiliser contre autrui. C'est un bouclier. Une lumière dans les ténèbres. Une voix pour montrer le chemin.",shape=box,color=blue];
		j2278636358 -> j4191532469;
	j4139941343 [label="Avant d'aborder... cette énormité, je dois m'expliquer au sujet du Cardinal, s'il te plaît.",shape=box,color=blue];
		j4139941343 -> j2056595171;
	j1318319230 [label="Boolean DrifterMarie is now false.",color=orange];
		j1318319230 -> j3453266879;
	j483300420 [label="Check boolean LoidFamilyComplete",color=orange];
		j483300420 -> j920107428 [label=true,color=green];
		j483300420 -> j3680420474 [label=false,color=brown];
	j2734635471 [label="Cependant... je ne souhaite pas que les choses restent ainsi entre nous. Nous avons une belle relation et je ne veux pas qu'elle s'envenime.",shape=box,color=blue];
		j2734635471 -> j3805730835;
	j3993094557 [label="Je suppose que je suis ici pour m'excuser – pour dire que je regrette profondément d'avoir si bêtement campé sur mes positions. J'espère que tu comprends.",shape=box,color=blue];
		j3993094557 -> j1196181401;
		j3993094557 -> j3581024309;
	j771537502 [label="Car j'ai vécu dans la rue. J'ai vécu chaque jour de ma vie dans une souffrance physique intense. J'ai connu le chagrin, j'ai connu l'amour, j'ai connu la peur et le rejet. J'ai connu la vie et le deuil.",shape=box,color=blue];
		j771537502 -> j658760629;
	j4003726964 [label="Même s'il est parfois nécessaire de prendre les armes pour éviter que le monde ne soit détruit, il ne faut pas pour autant les vénérer. Et cela est assurément inexcusable lorsque des innocents en subissent les conséquences.",shape=box,color=blue];
		j4003726964 -> j2502266278;
	j4191532469 [label="Et toi, tu as tenté de t'en servir contre moi pour simplement \"l'emporter\"? C'était une tactique lâche. Mais nous avons tous les deux dépassé les bornes et je te pardonnerai, si tu me pardonnes, pour les paroles prononcées sous le coup de la colère.",shape=box,color=blue];
		j4191532469 -> j2980320471;
		j4191532469 -> j1834407614;
	j2056595171 [label="Il m’est difficile, je crois, d’abandonner la défense du Cardinal... et il m’a fallu un certain temps pour comprendre pourquoi je ne pouvais pas le laisser tomber.",shape=box,color=blue];
		j2056595171 -> j3124322827;
	j3453266879 [label="Non, je comprends... Combien de meurtres ont été commis par \"passion\", n’est-ce pas? Et combien d’enfants ont été conçus dans ce même contexte?",shape=box,color=blue];
		j3453266879 -> j3365529;
	j920107428 [label="Et tu as pris de l'importance à mes yeux, en si peu de temps... J’ai trouvé nos conversations si joyeuses.",shape=box,color=blue];
		j920107428 -> j1186072069;
	j3680420474 [label="En effet, je souhaite toujours voir Monsieur Loid réuni avec ceux qui l'ont précédé. Je souhaite que la famille du Cardinal trouve du réconfort et tu es la clé de ce réconfort! ",shape=box,color=blue];
		j3680420474 -> j920107428;
	j3805730835 [label="Check boolean LoidFamilyComplete",color=orange];
		j3805730835 -> j1145151310 [label=true,color=green];
		j3805730835 -> j3524971526 [label=false,color=brown];
	j1196181401 [label="Oui. Et je te demande pardon si mes paroles t'ont blessée. Je ne savais tout simplement pas comment m'exprimer autrement.",shape=box,color=red];
		j1196181401 -> j1877123499;
	j3581024309 [label="J'apprécie de voir que mes propos ont été compris. Je commençais à perdre espoir.",shape=box,color=red];
		j3581024309 -> j273773562;
	j658760629 [label="Et si tu te crois vraiment au-dessus de nous tous, alors tu ne verras que les nuages dans lesquels tu te perds.",shape=box,color=blue];
		j658760629 -> j2980320471;
		j658760629 -> j1834407614;
	j2502266278 [label="Ainsi... je concède que le Cardinal n’a pas le droit de nuire à autrui au nom d’un \"bien commun\".",shape=box,color=blue];
		j2502266278 -> j450907136;
	j2980320471 [label="La frustration m'a fait parler ainsi, mais je ne sais pas comment te le faire comprendre autrement. Entrati n'est ni ton ami, ni ton père.",shape=box,color=red];
		j2980320471 -> j4013279920;
	j1834407614 [label="Je m'excuse. J'ai perdu mon sang-froid et j'ai dit des choses que je ne voulais pas.",shape=box,color=red];
		j1834407614 -> j2939184056;
	j3124322827 [label="Je ne voulais surtout pas que tu me méprises si je t'avouais toute la vérité. Cela paraît si insignifiant et pathétique.",shape=box,color=blue];
		j3124322827 -> j3272916019;
		j3124322827 -> j3280966093;
	j3365529 [label="Je suis... déçue. Blessée. Mais je... je te pardonne.",shape=box,color=blue];
		j3365529 -> j814912345;
	j1186072069 [label="Evaluate expressions",color=orange];
		j1186072069 -> j4037456560 [label="DrifterMarie",color=purple];
		j1186072069 -> j934616219 [label="DrifterLyon",color=purple];
		j1186072069 -> j2388544953 [label="DrifterRoathe",color=purple];
		j1186072069 -> j4180167066 [label="false",color=purple];
	j1145151310 [label="Et tu pourrais encore faire preuve de beaucoup de bonté envers mon Lyon et même envers le diable, je suppose...",shape=box,color=blue];
		j1145151310 -> j3606641414;
		j1145151310 -> j1583793414;
	j3524971526 [label="En effet, je souhaite toujours voir Monsieur Loid réuni avec ceux qui l'ont précédé. Je souhaite que la famille du Cardinal trouve du réconfort et tu es la clé de ce réconfort! ",shape=box,color=blue];
		j3524971526 -> j1145151310;
	j1877123499 [label="+10 Chemistry",color=orange];
		j1877123499 -> j1887583948;
	j273773562 [label="Il y a du mérite à faire preuve d'élégance lorsqu'on \"gagne\", tu sais.",shape=box,color=blue];
		j273773562 -> j987795065;
		j273773562 -> j3806435970;
	j450907136 [label="Quel \"bien commun\" restera-t-il, quand il ne restera sur son chemin que des vies et des cœurs brisés?",shape=box,color=blue];
		j450907136 -> j3993094557;
	j4013279920 [label="Non. Ce n'est pas mon père. Car mon père m'a abandonnée dans la rue quand j'étais enfant et le Cardinal n'a rien fait d'aussi cruel.",shape=box,color=blue];
		j4013279920 -> j786197016;
	j2939184056 [label="Bien des atrocités ont été commises sous l'emprise de la passion. Ainsi va la vie. ",shape=box,color=blue];
		j2939184056 -> j3161068103;
	j3272916019 [label="Je crois savoir déjà de quoi il s'agit. ",shape=box,color=red];
		j3272916019 -> j2990338872;
	j3280966093 [label="Je ne te jugerai pas, Marie. Je te le promets.",shape=box,color=red];
		j3280966093 -> j4068219003;
	j814912345 [label="Et pour... terminer la conversation concernant le Cardinal, si tu le permets - en mettant de côté mon chagrin -",shape=box,color=blue];
		j814912345 -> j1056643000;
	j4037456560 [label="Comment pourrais-je te repousser, alors que tu m'as avoué ce que tu ressens?",shape=box,color=blue];
		j4037456560 -> j1813866859;
	j934616219 [label="Comment pourrais-je te repousser, après tout ce que tu m'as confié sur tes sentiments pour notre cher Lyon? Tu pourrais lui apporter tant de paix... tant de réconfort...",shape=box,color=blue];
		j934616219 -> j1813866859;
	j2388544953 [label="Comment pourrais-je te repousser alors que tu n'hésites pas à affronter les pires démons? Je ne comprends pas tes goûts, mais... il semblerait que tu sois de notre côté, n’est-ce pas?",shape=box,color=blue];
		j2388544953 -> j1813866859;
	j4180167066 [label="Je ne souhaite pas te perdre comme camarade. Pourrions-nous mettre tout cela de côté et admettre que, même si nous ne sommes pas d'accord, nous pouvons continuer notre chemin?",shape=box,color=blue];
		j4180167066 -> j1963198104;
		j4180167066 -> j2404613441;
	j3606641414 [label="Marie, attends. Je t'en prie. Permets-moi de m'excuser.",shape=box,color=red];
		j3606641414 -> j1247546660;
	j1583793414 [label="Honnêtement, je ne pensais pas que ce que je te disais avait de l'importance – je ne pensais pas que ce serait si sérieux pour toi.",shape=box,color=red];
		j1583793414 -> j1247546660;
	j1887583948 [label="Je te remercie sincèrement. Vraiment, merci.",shape=box,color=blue];
		j1887583948 -> j3795115573;
	j987795065 [label="Je plaisantais.",shape=box,color=red];
		j987795065 -> j1927304553;
	j3806435970 [label="Pardon. Je ne \"gagne\" pas très souvent.",shape=box,color=red];
		j3806435970 -> j46194922;
	j786197016 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j786197016 -> j542165713;
	j3161068103 [label="+5 Chemistry",color=orange];
		j3161068103 -> j3523972383;
	j2990338872 [label="Je suppose que cela te paraît évident, non? Quelqu'un qui a aussi perdu sa famille. ",shape=box,color=blue];
		j2990338872 -> j1340138079;
	j4068219003 [label="On verra bien. Je crois qu'au final, j'ai vu en lui un peu du père qui m'a abandonnée, aussi petit et triste que cela puisse me paraître aujourd'hui.",shape=box,color=blue];
		j4068219003 -> j1340138079;
	j1056643000 [label="Il m’est difficile, je crois, d’abandonner la défense du Cardinal... et il m’a fallu un certain temps pour comprendre pourquoi je ne pouvais pas le laisser tomber.",shape=box,color=blue];
		j1056643000 -> j3146364617;
	j1813866859 [label="Pourrions-nous mettre tout cela de côté et admettre que, même si nous ne sommes pas d'accord, nous pouvons continuer notre chemin?",shape=box,color=blue];
		j1813866859 -> j1963198104;
		j1813866859 -> j2404613441;
	j1963198104 [label="Non, je n'ai pas fini d'analyser cela. Nous devons terminer cette conversation.",shape=box,color=red];
		j1963198104 -> j2551683190;
	j2404613441 [label="Je trouve ça juste. Je suis d'accord.",shape=box,color=red];
		j2404613441 -> j2173209743;
	j1247546660 [label="Je te pardonne tes mensonges, Voyageur. Nous pouvons rester amis et alliés. Mais me mentir ainsi, dans le seul but de... quoi?",shape=box,color=blue];
		j1247546660 -> j1574691804;
	j3795115573 [label="Il m’est difficile, je crois, d’abandonner la défense du Cardinal... et il m’a fallu un certain temps pour comprendre pourquoi je ne pouvais pas le laisser tomber.",shape=box,color=blue];
		j3795115573 -> j3789300350;
	j1927304553 [label="Oui, oui, bien. ",shape=box,color=blue];
		j1927304553 -> j3795115573;
	j46194922 [label="+5 Chemistry",color=orange];
		j46194922 -> j1927304553;
	j542165713 [label="Add -10 to Family counter",color=orange];
		j542165713 -> j816189513;
	j3523972383 [label="J'accepte tes excuses... car j'ai moi aussi laissé mon tempérament prendre le dessus à plusieurs reprises.",shape=box,color=blue];
		j3523972383 -> j695958941;
	j1340138079 [label="Dire... qu’après toutes ces années, je pourrais être séduite par quelqu’un qui me témoigne une telle gentillesse?",shape=box,color=blue];
		j1340138079 -> j3390626175;
	j3146364617 [label="Je ne voulais surtout pas que tu me méprises si je t'avouais toute la vérité. Cela paraît si insignifiant et pathétique.",shape=box,color=blue];
		j3146364617 -> j3751176496;
		j3146364617 -> j934405840;
	j2551683190 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j2551683190 -> j4055920456;
	j2173209743 [label="+5 Chemistry",color=orange];
		j2173209743 -> j1164451420;
	j1574691804 [label="Check boolean DrifterMarieWhoops",color=orange];
		j1574691804 -> j2533380152 [label=true,color=green];
		j1574691804 -> j1779334802 [label=false,color=brown];
	j3789300350 [label="Je ne voulais surtout pas que tu me méprises si je t'avouais toute la vérité. Cela paraît si insignifiant et pathétique.",shape=box,color=blue];
		j3789300350 -> j4119554129;
		j3789300350 -> j2737717960;
	j816189513 [label="Boolean MarieEntratiCompleteB is now true.",color=orange];
		j816189513 -> j1508231473;
	j695958941 [label="Permets-moi d'expliquer simplement, je crois, pourquoi il m'est si difficile d'abandonner la défense du Cardinal. Et pourquoi il m'a fallu du temps pour comprendre pourquoi je ne pouvais pas le laisser tomber.",shape=box,color=blue];
		j695958941 -> j3789300350;
	j3390626175 [label="Pauvre petite Marie... bien sûr, il n’était pas tout à fait ce qu’il semblait être.",shape=box,color=blue];
		j3390626175 -> j2970939338;
		j3390626175 -> j1631742859;
	j3751176496 [label="Je crois savoir déjà de quoi il s'agit. ",shape=box,color=red];
		j3751176496 -> j503852845;
	j934405840 [label="Je ne te jugerai pas, Marie. Je te le promets.",shape=box,color=red];
		j934405840 -> j3616907295;
	j4055920456 [label="Add -10 to Family counter",color=orange];
		j4055920456 -> j1128411;
	j1164451420 [label="Bien. Au moins, nous avons un accord.",shape=box,color=blue];
		j1164451420 -> j361545222;
	j2533380152 [label="Pour te mettre dans mon lit? C'est immonde.",shape=box,color=blue];
		j2533380152 -> j4030186689;
	j1779334802 [label="Pour m'utiliser? C'est ignoble.",shape=box,color=blue];
		j1779334802 -> j4030186689;
	j4119554129 [label="Je crois savoir déjà de quoi il s'agit. ",shape=box,color=red];
		j4119554129 -> j4104852280;
	j2737717960 [label="Je ne te jugerai pas, Marie. Je te le promets.",shape=box,color=red];
		j2737717960 -> j4221600325;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j2970939338 [label="Tu n'es pas une idiote, Marie. Bien au contraire. Cela me prouve surtout à quel point tu es formidable.",shape=box,color=red];
		j2970939338 -> j1989843213;
	j1631742859 [label="Tu es devenue si importante pour moi, Marie... et je m'excuse sincèrement que cette conversation ait pris cette tournure.",shape=box,color=red];
		j1631742859 -> j1989843213;
	j503852845 [label="Je suppose que cela te paraît évident, non? Quelqu'un qui a aussi perdu sa famille. ",shape=box,color=blue];
		j503852845 -> j3482203463;
	j3616907295 [label="On verra bien. Je crois qu'au final, j'ai vu en lui un peu du père qui m'a abandonnée, aussi petit et triste que cela puisse me paraître aujourd'hui.",shape=box,color=blue];
		j3616907295 -> j3482203463;
	j1128411 [label="Je ne pense pas.",shape=box,color=blue];
		j1128411 -> j3239706595;
	j361545222 [label="À la revoyure.",shape=box,color=blue];
		j361545222 -> j2853513911;
	j4030186689 [label="Je dois donc dire que je ne pourrais jamais te confier mon cœur. Je regrette ces paroles, qui, j'en suis certaine, te décevront.",shape=box,color=blue];
		j4030186689 -> j1298439799;
	j4104852280 [label="Je suppose que cela te paraît évident, non? Quelqu'un qui a aussi perdu sa famille. ",shape=box,color=blue];
		j4104852280 -> j2026551282;
	j4221600325 [label="On verra bien. Je crois qu'au final, j'ai vu en lui un peu du père qui m'a abandonnée, aussi petit et triste que cela puisse me paraître aujourd'hui.",shape=box,color=blue];
		j4221600325 -> j2026551282;
	j1989843213 [label="Mais je tenais à ce que tu comprennes qu'Entrati pouvait être complexe. Qu'il pouvait faire autant de mal. Je ne voulais pas que tu souffres davantage par la suite.",shape=box,color=red];
		j1989843213 -> j3266506228;
	j3482203463 [label="Dire... qu’après toutes ces années, je pourrais être séduite par quelqu’un qui me témoigne une telle gentillesse?",shape=box,color=blue];
		j3482203463 -> j2982341128;
	j3239706595 [label="Boolean MarieEntratiCompleteB is now true.",color=orange];
		j3239706595 -> j2768654365;
