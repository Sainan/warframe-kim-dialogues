		j287714375 -> j3762283683;
		j287714375 -> j3676398777;
	j663798777 [label="Les Archimédiens étaient-ils des Orokins? Ou pas? Le terme est utilisé avec une telle frivolité.",shape=box,color=blue];
		j663798777 -> j1694761737;
	"Chat ends." [color=orange];
	j3762283683 [label="Je crois que je ressens une certaine... jalousie.",shape=box,color=red];
		j3762283683 -> j292210868;
	j3676398777 [label="Je crois que je ressens une certaine... surprise.",shape=box,color=red];
		j3676398777 -> j1287255794;
	j1694761737 [label="Je pourrais demander au diable, je suppose. Mais je n'aime pas lui parler si je peux éviter.",shape=box,color=blue];
		j1694761737 -> j2743926305;
		j1694761737 -> j3178092592;
	j292210868 [label="De la jalousie? Pourquoi?",shape=box,color=blue];
		j292210868 -> j1121681232;
	j1287255794 [label="Pourquoi?",shape=box,color=blue];
		j1287255794 -> j3581287600;
		j1287255794 -> j790542710;
	j2743926305 [label="Non, les Archimédiens étaient d'un rang inférieur à celui des Orokins.",shape=box,color=red];
		j2743926305 -> j1797328843;
	j3178092592 [label="L'Empire Orokin s'appelle ainsi parce que les Orokins le dirigeaient, mais Orokin n'était que le nom de la classe dirigeante.",shape=box,color=red];
		j3178092592 -> j1797328843;
	j1121681232 [label="+10 Chemistry",color=orange];
		j1121681232 -> j3342831338;
	j3581287600 [label="Je trouve juste que c'est un peu bizarre que tu en saches plus sur lui que moi, désormais.",shape=box,color=red];
		j3581287600 -> j1121681232;
	j790542710 [label="Je ne sais rien du passé de Loid et je le connais depuis un certain temps.",shape=box,color=red];
		j790542710 -> j1121681232;
	j1797328843 [label="Cela arrive souvent. Tu n'es pas la seule.",shape=box,color=red];
		j1797328843 -> j2082364453;
	j3342831338 [label="Oh! Ne le prends pas personnellement, s'il te plaît!",shape=box,color=blue];
		j3342831338 -> j3700686758;
	j2082364453 [label="Les Orokins ont-ils volontairement rendu leur société confuse et obtuse?",shape=box,color=blue];
		j2082364453 -> j2247288959;
		j2082364453 -> j1325513892;
		j2082364453 -> j2526844005;
	j3700686758 [label="Monsieur Loid est, comment dire, distant?",shape=box,color=blue];
		j3700686758 -> j110387798;
		j3700686758 -> j2312421040;
	j2247288959 [label="Des milliers d'années au pouvoir et les gens finissent par... s'ennuyer. Les gens qui s'ennuient créent des systèmes compliqués.",shape=box,color=red];
		j2247288959 -> j1353541802;
	j1325513892 [label="Ils avaient un goût prononcé pour l'ornement et la complexité, qui s'étendait jusqu'à la bureaucratie.",shape=box,color=red];
		j1325513892 -> j1353541802;
	j2526844005 [label="Honnêtement? Je commence à le croire.",shape=box,color=red];
		j2526844005 -> j1353541802;
	j110387798 [label="Je ne sais rien de lui, vraiment.",shape=box,color=red];
		j110387798 -> j3467981147;
	j2312421040 [label="Il est un peu distant, oui.",shape=box,color=red];
		j2312421040 -> j3467981147;
	j1353541802 [label="+10 Chemistry",color=orange];
		j1353541802 -> j535037525;
	j3467981147 [label="Regarde avec qui je passe mon temps, hein? Apprends à déchiffrer une statue et il ne sera pas trop difficile d'en déchiffrer une autre.",shape=box,color=blue];
		j3467981147 -> j652348463;
	j535037525 [label="Je pense qu'ils l'ont fait juste pour être ennuyeux!",shape=box,color=blue];
		j535037525 -> j458268678;
	j652348463 [label="+10 Chemistry",color=orange];
		j652348463 -> j1413833117;
	j458268678 [label="Et ils se demandent pourquoi des rébellions éclatent. Vous aviez peut-être vos warframes, mais nous avions nos guillotines!",shape=box,color=blue];
		j458268678 -> j2923775295;
	j1413833117 [label="Même si j'avoue que Monsieur Loid est un peu plus... piquant que ce cher Lyon.",shape=box,color=blue];
		j1413833117 -> j1777547686;
		j1413833117 -> j1766583218;
	j2923775295 [label="Vive la révolution!",shape=box,color=blue];
		j2923775295 -> j1865919526;
		j2923775295 -> j3116692054;
		j2923775295 -> j1288594476;
	j1777547686 [label="Il a ses raisons.",shape=box,color=red];
		j1777547686 -> j21418691;
	j1766583218 [label="Bref... Quelle était ta question?",shape=box,color=red];
		j1766583218 -> j4184251324;
	j1865919526 [label="Dois-je m’inquiéter?",shape=box,color=red];
		j1865919526 -> j3127425598;
	j3116692054 [label="Vive la révolution! Je crois.",shape=box,color=red];
		j3116692054 -> j968707337;
	j1288594476 [label="Je ne sais pas vraiment ce qui vient de se passer, mais je pense que je suis d'accord?",shape=box,color=red];
		j1288594476 -> j968707337;
	j21418691 [label="Oui, certainement.",shape=box,color=blue];
		j21418691 -> j2858059694;
	j4184251324 [label="Ah! Oui.",shape=box,color=blue];
		j4184251324 -> j2858059694;
	j3127425598 [label="Ne fais pas attention, je m'amuse juste un peu. Marie la petite idiote révolutionnaire.",shape=box,color=blue];
		j3127425598 -> j1193342777;
	j968707337 [label="+10 Chemistry",color=orange];
		j968707337 -> j3127425598;
	j2858059694 [label="J'ai bien peur d'avoir complètement oublié ce que je suis venue te demander! Ah! Eh bien, ça me reviendra.",shape=box,color=blue];
		j2858059694 -> j2787573518;
	j1193342777 [label="Merci d'avoir répondu à ma question, je devrais te laisser continuer ta journée. ",shape=box,color=blue];
		j1193342777 -> j2787573518;
	j2787573518 [label="Je m'excuse d'avoir perturbé ta journée. Ou ta soirée. Ou quelle que soit l'heure, le moment et l'endroit où tu te trouves.",shape=box,color=blue];
		j2787573518 -> j4101990552;
	j4101990552 [label="À la revoyure !",shape=box,color=blue];
		j4101990552 -> "Chat ends.";
