		j2429168889 -> "Chat ends.";
	j1142712316 [label="Il me parlait de sa jeunesse. Ai-je fait quelque chose qui te vexe?",shape=box,color=blue];
		j1142712316 -> j3762283683;
		j1142712316 -> j3676398777;
