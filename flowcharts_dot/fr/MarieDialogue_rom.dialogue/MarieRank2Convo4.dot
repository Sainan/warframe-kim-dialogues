digraph {
	599 [label="MarieRank2Convo4 begins.",color=orange];
		599 -> 602;
		599 -> 601;
		599 -> 600;
	602 [label="Est-ce que je peux te parler de Roathe? Ou cela va-t-il déboucher sur une longue tirade incendiaire?",shape=box,color=red];
		602 -> 605;
	601 [label="Puis-je te poser une question sur l’éléphant dans la pièce?",shape=box,color=red];
		601 -> 604;
	600 [label="[Fin.]",shape=box,color=red];
		600 -> 603;
	605 [label="Ce diable est un imbécile qui se croit au-dessus de tout reproche! Je préfèrerais boire un pot de vernis à bois plutôt que de passer une minute de plus à l'écouter s'enorgueillir comme un chat qui se lèche le pelage!",shape=box,color=blue];
		605 -> 607;
		605 -> 608;
	604 [label="Quoi! Où ça? Un éléphant ?!",shape=box,color=blue];
		604 -> 606;
	603 [label="Chat ends.",color=orange];
	607 [label="C'était merveilleusement créatif.",shape=box,color=red];
		607 -> 610;
	608 [label="Je... vais supposer que rien de tout cela n'était aimable.",shape=box,color=red];
		608 -> 611;
	606 [label="Je ne vois qu'un poisson, un oiseau et... Monsieur Tagfer, je crois. Je vois plein de choses étranges dans ce sanctuaire, mais pas d'éléphant. Tu plaisantes ?",shape=box,color=blue];
		606 -> 609;
	610 [label="+5 Chemistry",color=orange];
		610 -> 614;
	611 [label="+5 Chemistry",color=orange];
		611 -> 615;
	609 [label="Oh! Pardon. C'est une expression que mes amis de 1999 m'ont apprise... ",shape=box,color=red];
		609 -> 612;
		609 -> 613;
	614 [label="Merci. C'était créatif, mais tu m'as posé une question et ma colère n'aurait pas dû être dirigée contre toi, pardonne-moi.",shape=box,color=blue];
		614 -> 618;
	615 [label="Ce ne l'était pas. Pardonne-moi, je n'aurais pas dû. ",shape=box,color=blue];
		615 -> 618;
	612 [label="Je ne parlais pas littéralement, j'en ai peur.",shape=box,color=red];
		612 -> 616;
	613 [label="Maintenant, je peux comprendre pourquoi ils pensaient que c'est toujours si mignon de voir ma confusion...",shape=box,color=red];
		613 -> 617;
	618 [label="Evaluate expressions",color=orange];
		618 -> 624 [label="MarieRoatheWarning",color=purple];
		618 -> 623 [label="DrifterRoathe",color=purple];
		618 -> 622 [label="MarieRoatheSoldier",color=purple];
		618 -> 621 [label="false",color=purple];
	616 [label="+5 Chemistry",color=orange];
		616 -> 619;
	617 [label="+5 Chemistry",color=orange];
		617 -> 620;
	624 [label="Je suis surprise que tu reviennes me demander mon avis. Tes paroles étaient assez claires. Tu ne souhaites pas m'entendre dire du mal de lui et de ses semblables.",shape=box,color=blue];
		624 -> 633;
		624 -> 634;
	623 [label="J'avoue que je ne sais pas vraiment comment poursuivre cette conversation, pour être honnête. Il t'attire aussi sûrement qu'une flamme attire un papillon.",shape=box,color=blue];
		623 -> 631;
		623 -> 632;
	622 [label="Tu cherches toujours à t'en faire un allié? Tu joues un jeu dangereux en l'ajoutant à ta meute, loup. Il risque de t'égorger au moment où tu t'y attendras le moins.",shape=box,color=blue];
		622 -> 629;
		622 -> 630;
	621 [label="Je suis surprise que tu viennes me voir. Il est clair que j'ai une piètre opinion de ce diable.",shape=box,color=blue];
		621 -> 627;
		621 -> 628;
	619 [label="Je ne serais pas surprise qu'il y en ait! On dirait bien qu'on a toutes sortes de choses, ici.",shape=box,color=blue];
		619 -> 625;
	620 [label="Oui, c'est charmant, n'est-ce pas? Il m'arrive souvent de dire quelque chose à Monsieur Loid et il me regarde comme si je l'avais pris au dépourvu.",shape=box,color=blue];
		620 -> 626;
	633 [label="J'ai réagi durement et je te présente mes excuses. Je ne veux pas le condamner pour ses actes prématurément; j'essaie de le comprendre sous tous ses angles.",shape=box,color=red];
		633 -> 642;
	634 [label="En effet. Il a mené une vie difficile à comprendre. Mais je voudrais savoir comment vous vous êtes rencontrés.",shape=box,color=red];
		634 -> 643;
	631 [label="J'essaie simplement de comprendre pourquoi il est comme il est. J'essaie de le comprendre.",shape=box,color=red];
		631 -> 640;
	632 [label="Si j'en savais plus sur lui, cela pourrait m'aider à comprendre comment le guider sur un chemin légèrement... plus clément.",shape=box,color=red];
		632 -> 641;
	629 [label="Je sais. Mais je ne peux pas le haïr pour avoir fait ce qu'il fallait pour servir son peuple. J'ai dû faire la même chose.",shape=box,color=red];
		629 -> 638;
	630 [label="C'est l'un des Orokins les plus dangereux que l'empire ait jamais connu. Nous serions fous de refuser une telle aide.",shape=box,color=red];
		630 -> 639;
	627 [label="Je sais, mais tu dois le connaître. J'essaie de mieux le comprendre.",shape=box,color=red];
		627 -> 636;
	628 [label="C'est pourquoi je te pose des questions à son sujet. Je veux le comprendre et sa façon de raconter sa version des faits ne me semble pas particulièrement convaincante.",shape=box,color=red];
		628 -> 637;
	625 [label="Que signifie cette expression? S'il y a un éléphant dans la pièce, pourquoi n'en parlerions-nous pas?",shape=box,color=blue];
		625 -> 635;
	626 [label="Et comme on parle d'un homme qui aurait pu être le serviteur de la Reine elle-même, j'en suis fière.",shape=box,color=blue];
		626 -> 625;
	642 [label="Add 1 to Thermostat",color=orange];
		642 -> 651;
	643 [label="Add 1 to Thermostat",color=orange];
		643 -> 652;
	640 [label="Add -1 to Thermostat",color=orange];
		640 -> 649;
	641 [label="Add 1 to Thermostat",color=orange];
		641 -> 650;
	638 [label="Add 1 to Thermostat",color=orange];
		638 -> 647;
	639 [label="Add -1 to Thermostat",color=orange];
		639 -> 648;
	636 [label="Add -1 to Thermostat",color=orange];
		636 -> 645;
	637 [label="Add 1 to Thermostat",color=orange];
		637 -> 646;
	635 [label="Je ne peux pas imaginer que pour la plupart des gens qui ne s’entourent pas de têtes volantes et d’animaux parlants, un éléphant ne soit pas un sujet de conversation.",shape=box,color=blue];
		635 -> 644;
	651 [label="+5 Chemistry",color=orange];
		651 -> 660;
	652 [label="Et tu crois que je ne comprendrais pas? Je ne suis pas idiote – je n'ai pas été prise d'hystérie, transportée comme je le suis, transfigurée comme je l'ai été.",shape=box,color=blue];
		652 -> 661;
		652 -> 662;
	649 [label="Comprendre dans quel but, voilà le problème. Mais tu n'as pas besoin que je te fasse la leçon, je ne suis pas ta mère et je ne souhaite pas gâcher cette amitié naissante...",shape=box,color=blue];
		649 -> 658;
	650 [label="+5 Chemistry",color=orange];
		650 -> 659;
	647 [label="+5 Chemistry",color=orange];
		647 -> 656;
	648 [label="Je t'invite simplement à la prudence. Il pourrait charmer Lua pour qu'elle lui offre les étoiles du ciel, je pense.",shape=box,color=blue];
		648 -> 657;
	645 [label="Comprendre à quelles fins, là est le problème. Mais tu n'as pas besoin que je te fasse la leçon.",shape=box,color=blue];
		645 -> 654;
	646 [label="+5 Chemistry",color=orange];
		646 -> 655;
	644 [label="... Je pense avoir répondu à ma propre question, n'est-ce pas?",shape=box,color=blue];
		644 -> 653;
	660 [label="J'apprécie les excuses et je les accepte, mais je considère que j'ai été à la fois transportée et transfigurée et que je me retrouve entourée par l'impossible. ",shape=box,color=blue];
		660 -> 666;
	661 [label="Peu importe. Je vais aller parler au diable lui-même.",shape=box,color=red];
		661 -> 667;
	662 [label="Pardon. Je ne voulais pas me disputer avec toi, ce n'est pas ce que je voulais dire. ",shape=box,color=red];
		662 -> 668;
		662 -> 669;
	658 [label="Je m'inquiète simplement pour toi. C'est une bête habile et manipulatrice...",shape=box,color=blue];
		658 -> 664;
	659 [label="Et je te ferais Saint de Sol pour avoir seulement tenté une telle chose.",shape=box,color=blue];
		659 -> 664;
	656 [label="Oui, la malédiction du soldat... Brûler la ville pour sauver le pays. Tuer l'homme pour sauver la famille. Mais où s'arrête l'horreur?",shape=box,color=blue];
		656 -> 665;
	657 [label="Souviens-toi de qui il est, au bout du compte... ni un dieu, ni une bête, mais un homme. Un homme qui a une trop haute opinion de lui-même.",shape=box,color=blue];
		657 -> 664;
	654 [label="Il pourrait charmer Lua pour qu'elle lui offre les étoiles du ciel, je crois. Fais attention, c'est tout ce que je peux te dire.",shape=box,color=blue];
		654 -> 664;
	655 [label="Alors, tu es sage de ne pas écouter ses paroles mielleuses. Il pourrait charmer Lua pour qu'elle lui offre les étoiles du ciel, je pense.",shape=box,color=blue];
		655 -> 664;
	653 [label="Oui. Cela signifie: \"pourrions-nous aborder le sujet que nous évitons tous, comme si nous ne parlions pas du grand éléphant dans la pièce?\"",shape=box,color=red];
		653 -> 663;
	666 [label="Quand tu crois que je ne peux pas comprendre ou que je ne peux pas ressentir de sympathie pour les histoires des autres, tu peux reconsidérer ta position, oui?",shape=box,color=blue];
		666 -> 673;
	667 [label="Ainsi soit-il.",shape=box,color=blue];
		667 -> 674;
	668 [label="C'est un soldat. Il a dû accomplir des choses terribles au nom d'un \"grand projet\". Je comprends ce que ça fait. Parfois, ce genre de vie te transforme... eh bien. Comme lui.",shape=box,color=red];
		668 -> 675;
	669 [label="Il a vécu des centaines, voire des milliers d'années. Qui sait ce que cela fait vraiment à quelqu'un? Quelle douleur, quelle souffrance? Je sais ce que ça fait.",shape=box,color=red];
		669 -> 676;
	664 [label="Mais tu voulais m'interroger sur le diable lui-même, n'est-ce pas? Que désires-tu savoir?",shape=box,color=blue];
		664 -> 670;
		664 -> 671;
		664 -> 672;
	665 [label="Nous devons voir la guerre à travers les yeux du statisticien, car si nous la regardions à travers les yeux de ceux qui sont tombés au combat, nous ne cesserions jamais de pleurer.",shape=box,color=blue];
		665 -> 664;
	663 [label="Et si je pouvais me permettre de deviner une seconde fois la nature de cet éléphant... aurait-il la peau bleue?",shape=box,color=blue];
		663 -> 618;
	673 [label="Et moi, pour ma part, je vais reconsidérer ma décision de me mêler de tes affaires en échange.",shape=box,color=blue];
		673 -> 661;
		673 -> 680;
	674 [label="Chat ends.",color=orange];
	675 [label="+5 Chemistry",color=orange];
		675 -> 681;
	676 [label="+5 Chemistry",color=orange];
		676 -> 682;
	670 [label="Pourquoi le détestes-tu autant?",shape=box,color=red];
		670 -> 677;
	671 [label="Pourquoi Entrati l'a-t-il laissé avec toi et Lyon?",shape=box,color=red];
		671 -> 678;
	672 [label="Je me demandais comment vous vous étiez rencontrés?",shape=box,color=red];
		672 -> 679;
	680 [label="D'accord.",shape=box,color=red];
		680 -> 687;
	681 [label="Ah, et maintenant je me sens vraiment idiote. Oui, bien sûr, tu sais ce que c'est que de tuer au nom d'un \"projet\", comme tu l'as dit... Bien sûr que tu chercherais à comprendre quelqu'un qui a fait la même chose.",shape=box,color=blue];
		681 -> 688;
	682 [label="Ah, et maintenant je me sens bête. Oui, bien sûr, tu sais ce que c'est que de vivre encore et encore... Bien sûr que tu chercherais à connaître quelqu'un qui a vécu la même chose.",shape=box,color=blue];
		682 -> 688;
	677 [label="N'est-ce pas évident? Son comportement est celui d'un gros chat qui insiste pour marquer son territoire et qui fait tomber des objets des étagères.",shape=box,color=blue];
		677 -> 683;
		677 -> 684;
	678 [label="Lorsque le Cardinal Dimanche – Entrati – nous a quittés pour la dernière fois, il a laissé le diable à notre porte. Brisé, ensanglanté et à peine capable de se rappeler son propre nom.",shape=box,color=blue];
		678 -> 685;
	679 [label="Il y avait tempête la nuit où le diable est venu nous voir. Un tonnerre terrible a fait trembler les murs de la Cathédrale.",shape=box,color=blue];
		679 -> 686;
	687 [label="Update boolean MarieRoatheWarning",color=orange];
		687 -> 694;
	688 [label="On va faire un marché. Quand tu crois que je ne peux pas comprendre ou que je ne peux pas ressentir de sympathie pour les histoires des autres, tu peux reconsidérer ta position, oui?",shape=box,color=blue];
		688 -> 673;
	683 [label="Personnellement, j'aime bien les chats. ",shape=box,color=red];
		683 -> 689;
	684 [label="Tu n'aimes pas les chats?",shape=box,color=red];
		684 -> 690;
	685 [label="Je sais maintenant qu'on venait juste de lui administrer le sérum et la transformation est... douloureuse.",shape=box,color=blue];
		685 -> 691;
	686 [label="Check boolean MarieLyonVisions",color=orange];
		686 -> 693 [label=true,color=green];
		686 -> 692 [label=false,color=brown];
	694 [label="Magnifique! Alors, tu voulais m'interroger sur le diable lui-même, n'est-ce pas? Que désires-tu savoir?",shape=box,color=blue];
		694 -> 670;
		694 -> 671;
		694 -> 672;
	689 [label="Les chats sont vraiment merveilleux, quand un chat est un chat! C'est un homme adulte, avec de nombreuses années de vie derrière lui!",shape=box,color=blue];
		689 -> 695;
	690 [label="Si, quand un chat est un chat! Lui, c'est un homme, un adulte, avec de nombreuses années de vie derrière lui!",shape=box,color=blue];
		690 -> 695;
	691 [label="Le Cardinal a regardé le diable et il a dit: \"Uriel, hérétique de Xata, en bannissement, réponds: les Orokins pourront-ils jamais être pardonnés?\"",shape=box,color=blue];
		691 -> 696;
	693 [label="Cette fois, si Lyon te parle de la tempête qui a secoué notre maison, il te parle de la réalité, celle que nous avons partagée.",shape=box,color=blue];
		693 -> 692;
	692 [label="C'était merveilleusement cliché, je pense, de voir un tel mal arriver dans un telle tempête.",shape=box,color=blue];
		692 -> 678;
	695 [label="Bien plus d'années que n'importe quel être humain, bleu ou autrement transfiguré au point d'être méconnaissable, ne devrait en avoir.",shape=box,color=blue];
		695 -> 697;
		695 -> 698;
		695 -> 3906;
	696 [label="Et dans un coup de tonnerre, comme si les dieux eux-mêmes l'appelaient, le Cardinal disparut tout simplement.",shape=box,color=blue];
		696 -> 699;
	697 [label="Modifier génétiquement son apparence était à la mode à l'époque des Orokins. Mais ils étaient tout aussi humains que nous. Enfin, je pense.",shape=box,color=red];
		697 -> 700;
	698 [label="À l'exception de la queue, il a honnêtement l'air... plus humain que la plupart des Orokins de l'époque.",shape=box,color=red];
		698 -> 701;
	3906 [label="Ne t'inquiète pas, je te trouve bien plus jolie que lui.",shape=box,color=red];
		3906 -> 3907;
	699 [label="Et nous sommes restés avec lui. Le diable.",shape=box,color=blue];
		699 -> 702;
	700 [label="Oui, je suppose que je ne sais plus qui je suis. Moitié Marie, moitié... \"Wisp\"... quelle que soit la créature Infestée qui partage désormais mes veines.",shape=box,color=blue];
		700 -> 703;
	701 [label="Oui, je regardais un vieux portrait du Cardinal, à l'époque où il ressemblait davantage au diable. Il m'a parlé des coutumes des Orokins, de la façon dont ils se transformaient.",shape=box,color=blue];
		701 -> 704;
	3907 [label="Check boolean DrifterMarie",color=orange];
		3907 -> 3908 [label=true,color=green];
		3907 -> 3909 [label=false,color=brown];
	702 [label="Le Cardinal nous a laissé le soin de... veiller sur son âme, peut-être? Ou du moins, de nous occuper des chaînes qui le lient. Je préférerais le renvoyer en enfer.",shape=box,color=blue];
		702 -> 705;
		702 -> 706;
	703 [label="Une conversation pour une autre fois, peut-être.",shape=box,color=blue];
		703 -> 707;
	704 [label="Comme c'est semblable et pourtant si étranger à la façon dont les dames de mon époque portaient des perruques ostentatoires qui pouvaient atteindre le ciel, ou des robes qui pouvaient abriter un orphelinat entier sans trop d'effort!",shape=box,color=blue];
		704 -> 708;
	3908 [label="Tu dois arrêter de me faire rougir! Monsieur Loid va se demander ce que je fais assise ici!",shape=box,color=blue];
		3908 -> 3911;
	3909 [label="Update boolean DrifterMarie",color=orange];
		3909 -> 3910;
	705 [label="Penses-tu que tout le monde peut être pardonné, à la fin?",shape=box,color=red];
		705 -> 709;
	706 [label="Est-ce qu'il y a quelque chose que tu apprécies chez lui? Vraiment rien?",shape=box,color=red];
		706 -> 710;
	707 [label="Update boolean MarieInfestation",color=orange];
		707 -> 711;
	708 [label="Les humains sont ce qu'ils seront toujours: malheureux dans leur forme donnée par Sol. Avides de travailler leur chair comme de l'argile. Je ne fais pas exception, j'imagine.",shape=box,color=blue];
		708 -> 712;
	3911 [label="D'ailleurs, il n'est pas si difficile d'être plus jolie que le diable, non? Ses traits sont beaux, mais le bleu... ce n'est pas pour moi.",shape=box,color=blue];
		3911 -> 3912;
	3910 [label="Ah! Tu me fais rougir! Que pensera Monsieur Loid s'il me voit assise ici comme ça?",shape=box,color=blue];
		3910 -> 3911;
	709 [label="Est-ce que je le crois? Oui. Je crois que toutes les âmes sont capables de gagner le pardon de leurs transgressions.",shape=box,color=blue];
		709 -> 713;
	710 [label="Rien. Rien du tout.",shape=box,color=blue];
		710 -> 714;
		710 -> 715;
	711 [label="Mon problème avec lui, c'est qu'il a tout l'ego meurtrier d'un félin sans la nature charmante d'un petit compagnon adorable.",shape=box,color=blue];
		711 -> 716;
	712 [label="J'étais tellement heureuse de prendre le sérum qui faisait de moi en partie Marie, en partie... \"Wisp\" et en partie... ces choses Infestées qui partagent désormais mes veines.",shape=box,color=blue];
		712 -> 703;
	3912 [label="J'accepte ton compliment, s'il est sincère. J'ai simplement été surprise. Pourrions-nous… revenir au sujet initial?",shape=box,color=blue];
		3912 -> 707;
	713 [label="La question demeure... a-t-il seulement l'impression d'avoir besoin de cela, pour commencer?",shape=box,color=blue];
		713 -> 717;
	714 [label="Eh bien, j'apprécie ton histoire. Alors, Entrati veut qu'il soit... pardonné? De quoi? Tau? Ou simplement d'être Orokin?",shape=box,color=red];
		714 -> 718;
	715 [label="Très bien, je te crois. Je ne pense pas que tu me mentirais.",shape=box,color=red];
		715 -> 719;
	716 [label="Il a une trop haute opinion de lui-même. Il prend la vie sans hésiter. Il joue avec ses ennemis comme s'ils n'étaient qu'une souris qu'il aurait acculée.",shape=box,color=blue];
		716 -> 702;
	717 [label="On ne peut pardonner à ceux qui ne pensent pas en avoir besoin. Ce serait plus facile d'apprendre à un poisson à voler.",shape=box,color=blue];
		717 -> 720;
	718 [label="Je ne sais pas. Et l'autre question demeure: ressent-il vraiment le besoin d'être pardonné?",shape=box,color=blue];
		718 -> 717;
	719 [label="Très bien. Nous avons un point commun: une terrible tentation pour les sucreries. Le diable revenait souvent à la Cathédrale après avoir volé des pâtisseries dans les magasins.",shape=box,color=blue];
		719 -> 721;
	720 [label="Mais parle-lui toi-même du sujet, si tu souhaites comprendre le défi insurmontable auquel tu fais désormais face si tu cherches à gagner cette guerre particulière.",shape=box,color=blue];
		720 -> 722;
	721 [label="J'expliquais que c'était un vol et il me faisait une longue conférence sur la façon dont les Orokins dirigeraient bientôt le système solaire, donc ce n'était pas un vol selon le grand schéma des choses...",shape=box,color=blue];
		721 -> 723;
	722 [label="Je te souhaite simplement bonne chance.",shape=box,color=blue];
		722 -> 724;
	723 [label="Je lui criais dessus, Lyon était obligé d'intervenir...",shape=box,color=blue];
		723 -> 725;
		723 -> 726;
	724 [label="+10 Chemistry",color=orange];
		724 -> 727;
	725 [label="Et les pâtisseries...?",shape=box,color=red];
		725 -> 728;
	726 [label="Ne te demandais-tu pas s’il les ramenait pour que vous puissiez tous en profiter ensemble?",shape=box,color=red];
		726 -> 729;
	727 [label="Chat ends.",color=orange];
	728 [label="On ne pouvait pas les laisser se gâter, n'est-ce pas? C'était un péché de les manger, mais c'était encore pire de les laisser moisir. Alors, on les a dégustées.",shape=box,color=blue];
		728 -> 730;
	729 [label="Si c'est vrai, il a fait une très mauvaise action. Mais... tu as peut-être raison. Quoi qu'il en soit, nous ne pouvions pas les gaspiller. C'était un péché de les manger, mais pire encore de les laisser moisir. Alors, nous les avons dégustées.",shape=box,color=blue];
		729 -> 730;
	730 [label="+10 Chemistry",color=orange];
		730 -> 731;
	731 [label="Hum. C'était peut-être une habitude chez lui, maintenant que j'y pense, de rapporter plus qu'il ne pouvait en consommer seul...",shape=box,color=blue];
		731 -> 732;
	732 [label="Update boolean MarieRoathePastry1",color=orange];
		732 -> 733;
	733 [label="J'y réfléchirai. À demain. À la revoyure.",shape=box,color=blue];
		733 -> 734;
	734 [label="Chat ends.",color=orange];
}