	j1048941247 [label="Comment ça se passe entre toi et \"le diable\" ces derniers temps?",shape=box,color=red];
		j1048941247 -> j520518461;
	j496814918 [label="[Avouer vos sentiments] Marie? On peut parler?",shape=box,color=red];
