	3777 [label="J'ignore comment tu as fait. Mais il nous a dit la vérité à propos du sérum.",shape=box,color=blue];
	3778 [label="Je m'inquiète pour lui. Je pense qu'il se fait plus de mal qu'il ne le laisse paraître, n'est-ce pas?",shape=box,color=blue];
		3778 -> 3783;
	3774 [label="Pardon si cela semble sortir de nulle part, mais je ne savais pas comment te le dire plus tôt.",shape=box,color=red];
