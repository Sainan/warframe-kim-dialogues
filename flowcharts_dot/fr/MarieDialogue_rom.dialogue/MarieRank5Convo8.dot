		j520518461 -> j2278689756 [label="RoatheFamilyDelay",color=purple];
		j520518461 -> j3403451043 [label="RoatheDating",color=purple];
		j520518461 -> j873157563 [label="RoatheRedeemed",color=purple];
		j520518461 -> j4248603483 [label="RoatheVillain",color=purple];
		j520518461 -> j3566774343 [label="false",color=purple];
	j1757927900 [label="Oui, qu'est-ce qu'il y a?",shape=box,color=blue];
		j1757927900 -> j656732708;
	"Chat ends." [color=orange];
	j2278689756 [label="Je crains de devoir l'appeler désormais \"notre\" diable, n'est-ce pas? Car il n'est pas près de partir. Ha!",shape=box,color=blue];
		j2278689756 -> j441700078;
	j3403451043 [label="J'ai l'impression que c'est plutôt à toi que je devrais poser la question, non? C'est toi qui t'amuses avec lui, en ce moment!",shape=box,color=blue];
		j3403451043 -> j416005176;
	j873157563 [label="J'ignore comment tu as fait. Mais il nous a dit la vérité à propos du sérum.",shape=box,color=blue];
		j873157563 -> j1782764987;
	j4248603483 [label="J'ignore comment tu as fait. Mais il nous a dit la vérité à propos du sérum.",shape=box,color=blue];
	j3566774343 [label="Je m'inquiète pour lui. Je pense qu'il se fait plus de mal qu'il ne le laisse paraître, n'est-ce pas?",shape=box,color=blue];
		j3566774343 -> j1768997497;
	j656732708 [label="Pardon si cela semble sortir de nulle part, mais je ne savais pas comment te le dire plus tôt.",shape=box,color=red];
		j656732708 -> j1234618945;
	j441700078 [label="Tu as bien agi en obtenant de l'aide auprès de Monsieur Loid. Je ne pensais pas cela possible.",shape=box,color=blue];
		j441700078 -> j3086907166;
	j416005176 [label="Je résiste à la tentation de te demander toutes sortes de commérages.",shape=box,color=blue];
		j416005176 -> j3086907166;
	j1782764987 [label="Sol, ça m'a brisé le cœur. Sa voix n'a pas tremblé lorsqu'il a parlé. Mais je l'ai vu dans ses yeux.",shape=box,color=blue];
		j1782764987 -> j3086907166;
	j1768997497 [label="Ça me brise le cœur. J'espère qu'il tiendra, mais je ne sais pas s'il y survivra. Je ne sais pas si l'un d'entre nous y survivra.",shape=box,color=blue];
		j1768997497 -> "Chat ends.";
	j1234618945 [label="Je t'adore. Je t'adore tout simplement.",shape=box,color=red];
		j1234618945 -> j2910325193;
	j3086907166 [label="Il y a eu un changement en lui. Subtil, certes, mais bien présent. ",shape=box,color=blue];
		j3086907166 -> j3276659981;
	j2910325193 [label="Eh bien, je me demandais... si tu aimerais, eh bien... être en couple?",shape=box,color=red];
		j2910325193 -> j2298753926;
	j3276659981 [label="+5 Chemistry",color=orange];
		j3276659981 -> j1359036615;
	j2298753926 [label="Evaluate expressions",color=orange];
		j2298753926 -> j2796905705 [label="MarieNoDate",color=purple];
		j2298753926 -> j676966307 [label="MarieWillDate",color=purple];
		j2298753926 -> j2796905705 [label="false",color=purple];
	j1359036615 [label="Pour cela, je sais que nous vous devons te remercier.",shape=box,color=blue];
		j1359036615 -> j2569262745;
	j2796905705 [label="Oh! Oh, Voyageur. Je ne sais pas comment le dire, alors je vais le dire tout simplement. ",shape=box,color=blue];
		j2796905705 -> j617350017;
	j676966307 [label="Oh, je ressens la même chose! Mais je ne savais pas comment te l'écrire, je n'ose pas dire ces choses! Je me croyais idiote de même les penser!",shape=box,color=blue];
		j676966307 -> j923960481;
	j2569262745 [label="Je ne sais pas s'il l'acceptera, mais il aura toujours mon amitié.",shape=box,color=blue];
		j2569262745 -> j2712576265;
	j617350017 [label="Non.",shape=box,color=blue];
		j617350017 -> "Chat ends.";
	j923960481 [label="Ah! Quel bonheur je ressens!",shape=box,color=blue];
		j923960481 -> j2402700619;
	j2712576265 [label="Même si je pense que je ne me lasserai jamais de lui crier dessus!",shape=box,color=blue];
		j2712576265 -> j496213286;
		j2712576265 -> j3722384346;
	j2402700619 [label="Veux-tu faire une demande plus... formelle? Si c'est le cas, oui! Oui! J'aimerais beaucoup.",shape=box,color=blue];
		j2402700619 -> j3783486283;
		j2402700619 -> j1756566964;
	j496213286 [label="Je pense qu'il prend un malin plaisir à te taquiner, de toute façon.",shape=box,color=red];
		j496213286 -> j1907747094;
	j3722384346 [label="C'est chouette que vous ayez établi une sorte de lien.",shape=box,color=red];
		j3722384346 -> j1087924065;
	j3783486283 [label="Je ne te propose certainement pas le mariage, pas encore. ",shape=box,color=red];
		j3783486283 -> j1025527982;
	j1756566964 [label="Les choses ont un peu évolué. Je ne dirais pas qu'elles sont plus \"formelles\", mais j'adorerais te les montrer.",shape=box,color=red];
		j1756566964 -> j419255049;
	j1907747094 [label="Comme un gros chat de gouttière. Je me suis habituée à lui.",shape=box,color=blue];
		j1907747094 -> j893573074;
	j1087924065 [label="Oui! Il devient un peu moins insupportable chaque jour.",shape=box,color=blue];
		j1087924065 -> j1907747094;
	j1025527982 [label="Ne t'inquiète pas, c'est moi qui plaisante. Mais de toute façon, je suis ravie! Et j'ai hâte de découvrir ces nouvelles manières... romantiques.",shape=box,color=blue];
		j1025527982 -> j3436162049;
	j419255049 [label="Ha! Je sais quand tu es canaille. Eh bien, j'ai hâte!",shape=box,color=blue];
		j419255049 -> j3436162049;
	j893573074 [label="Je crois que je serais triste s'il venait à disparaître.",shape=box,color=blue];
		j893573074 -> "Chat ends.";
	j3436162049 [label="+10 Chemistry",color=orange];
		j3436162049 -> j1541783856;
	j1541783856 [label="Eh bien? À la revoyure, mon cœur.",shape=box,color=blue];
		j1541783856 -> j1559150062;
	j1559150062 [label="Boolean MarieDating is now true.",color=orange];
		j1559150062 -> j264962945;
