	3873 [label="Mon frère d'âme m'envoie te parler. Il me supplie de reconsidérer ma décision de ne pas t'aider dans l'affaire de Monsieur Loid.",shape=box,color=blue];
		3873 -> 3875;
		3873 -> 3876;
		3873 -> 3877;
	3874 [label="Chat ends.",color=orange];
	3875 [label="J'aimerais vraiment que tu nous aides, Marie. ",shape=box,color=red];
		3875 -> 3878;
	3876 [label="Nous avons besoin de toi, Marie. Sans toi, ça ne sert à rien. S'il te plaît. Peux-tu me pardonner?",shape=box,color=red];
		3876 -> 3879;
	3877 [label="Pardon de t'avoir contrariée. Mais s'il te plaît, ne t'en prends pas à Loid. Ni à la famille du dessus.",shape=box,color=red];
		3877 -> 3880;
	3878 [label="Je suis simplement venue te dire que tu ne devrais pas utiliser la gentillesse de Lyon pour compenser tes propres échecs.",shape=box,color=blue];
		3878 -> 3881;
	3879 [label="Oui… je peux. De toute façon, ma colère envers toi à l’instant présent ne devrait pas être ressentie par les autres.",shape=box,color=blue];
		3879 -> 3882;
	3880 [label="Oui. Sur ce point, tu as raison. Ma colère actuelle envers toi ne doit pas être ressentie par les autres.",shape=box,color=blue];
		3880 -> 3883;
	3881 [label="Chat ends.",color=orange];
	3882 [label="Très bien. Je vais t'aider. Tu auras mon aide.",shape=box,color=blue];
		3882 -> 3884;
	3883 [label="Une colère que je regrette et je te pardonne.",shape=box,color=blue];
