	j3926802782 [label="J'aimerais vraiment que tu nous aides, Marie. ",shape=box,color=red];
		j3926802782 -> j2583347628;
	j1590773178 [label="Nous avons besoin de toi, Marie. Sans toi, ça ne sert à rien. S'il te plaît. Peux-tu me pardonner?",shape=box,color=red];
		j1590773178 -> j2050858147;
	j1166815351 [label="Pardon de t'avoir contrariée. Mais s'il te plaît, ne t'en prends pas à Loid. Ni à la famille du dessus.",shape=box,color=red];
		j1166815351 -> j555667472;
	j2583347628 [label="Je suis simplement venue te dire que tu ne devrais pas utiliser la gentillesse de Lyon pour compenser tes propres échecs.",shape=box,color=blue];
		j2583347628 -> "Chat ends.";
	j2050858147 [label="Oui… je peux. De toute façon, ma colère envers toi à l’instant présent ne devrait pas être ressentie par les autres.",shape=box,color=blue];
		j2050858147 -> j2694005809;
	j555667472 [label="Oui. Sur ce point, tu as raison. Ma colère actuelle envers toi ne doit pas être ressentie par les autres.",shape=box,color=blue];
		j555667472 -> j88152146;
	j2694005809 [label="Très bien. Je vais t'aider. Tu auras mon aide.",shape=box,color=blue];
		j2694005809 -> j3151953893;
	j88152146 [label="Une colère que je regrette et je te pardonne.",shape=box,color=blue];
