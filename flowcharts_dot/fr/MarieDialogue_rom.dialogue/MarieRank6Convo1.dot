		3300 -> 3313 [label="RoatheRedeemed",color=purple];
		3300 -> 3314 [label="RoatheVillain",color=purple];
		3300 -> 3315 [label="RoatheHellComplete",color=purple];
		3300 -> 3316 [label="false",color=purple];
	3298 [label="Je sais que tu m'as avoué avoir des sentiments pour moi. Et pourtant, je te vois maintenant avec quelqu'un d'autre. Je voulais simplement te dire que je suis heureuse pour toi!",shape=box,color=blue];
		3298 -> 3308;
	3297 [label="Tu m'as dit un jour que tu... oh, je ne sais même pas comment le dire. Que tu avais des sentiments pour moi. Mais je sais qu'il y a aussi quelqu'un d'autre.",shape=box,color=blue];
		3297 -> 3306;
		3297 -> 3307;
	3296 [label="Tu m'as dit un jour que tu... oh, je ne sais même pas comment le dire. Que tu avais des sentiments pour moi.",shape=box,color=blue];
		3296 -> 3305;
	3294 [label="Mais je repense à tout ce qu'il a représenté pour moi. À quel point le temps passé ensemble m'a changée, moi et aussi le cap de ma vie, comme un navire en pleine mer.",shape=box,color=blue];
