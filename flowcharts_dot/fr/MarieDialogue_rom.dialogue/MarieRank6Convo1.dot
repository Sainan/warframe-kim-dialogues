		3317 -> 3332;
	3318 [label="Mon cœur t'appartient également, Marie!",shape=box,color=red];
		3318 -> 3333;
	3336 [label="S'apporter mutuellement du plaisir quand on est amoureux. S'apporter mutuellement de la souffrance quand on est rongé par la haine. Voilà le don de l'humanité – voilà ce que l'Indifférence n'est pas.",shape=box,color=blue];
		3336 -> 3349;
