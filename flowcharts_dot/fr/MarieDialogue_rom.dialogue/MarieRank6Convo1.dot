	3288 [label="Je repense au temps que nous avons passé ensemble. Et à quel point il est court, comparé à toutes les années que tu as connues.",shape=box,color=blue];
		3288 -> 3294;
	3286 [label="Non, laisse-moi parler en premier, je vais perdre mon courage, sinon!",shape=box,color=blue];
		3286 -> 3293;
	3295 [label="Mais je repense à tout ce qu'il a représenté pour moi. À quel point le temps passé ensemble m'a changée, moi et aussi le cap de ma vie, comme un navire en pleine mer.",shape=box,color=blue];
