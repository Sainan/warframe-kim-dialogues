	3303 [label="Et je me demande: est-ce cela que l’Indifférence cherche à détruire? Est-ce cela qu’elle consume? Ce pouvoir d’influencer autrui?",shape=box,color=blue];
		3303 -> 3320;
	3302 [label="Je crains que tu ne sois sur le point de me dire des mots que tu ne pourras plus retirer. Et cela changera tout entre nous à jamais.",shape=box,color=blue];
		3302 -> 3319;
	3301 [label="Mon cœur t'appartient depuis notre première rencontre...",shape=box,color=blue];
		3301 -> 3317;
		3301 -> 3318;
	3321 [label="Le don de se faire rire. De pleurer. De se convaincre mutuellement de la vérité ou du mensonge. De se faire changer d'avis. De se réconforter dans la douleur. De se blesser par pure folie.",shape=box,color=blue];
		3321 -> 3336;
	3329 [label="Et quelle différence cela fait-il, quand on est là pour guider Lyon à travers les heures les plus sombres et le soutenir dans ses moments de douleur et d'agonie?",shape=box,color=blue];
		3329 -> 3343;
	3330 [label="Ces résultats sont sans aucun doute dus à ton intervention. Roathe est là et il protège la famille du Cardinal, grâce à toi.",shape=box,color=blue];
		3330 -> 3331;
	3331 [label="Et je sais que notre diable n'est pas notre ennemi, n'est-ce pas? C'est l'Indifférence. Et que nous enseigne l'Indifférence, sinon à nous accrocher à tout ce qu'elle rejette, à tout ce qu'elle détruit ?",shape=box,color=blue];
		3331 -> 3344;
	3327 [label="Mais... et si ",shape=box,color=red];
		3327 -> 3891;
	3328 [label="J'ai aussi des sentiments pour toi, Marie.",shape=box,color=red];
		3328 -> 3342;
	3325 [label="Oui, je comprends. Bien sûr que je comprends! Comment pourrais-je te reprocher de suivre ton instinct?",shape=box,color=blue];
