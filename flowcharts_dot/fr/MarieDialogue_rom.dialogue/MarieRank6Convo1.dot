		3293 -> 3301 [label="MarieWillDate",color=purple];
		3293 -> 3302 [label="false",color=purple];
	3304 [label="Et je me demande: est-ce cela que l’Indifférence cherche à détruire? Est-ce cela qu’elle consume? Ce pouvoir d’influencer autrui?",shape=box,color=blue];
		3304 -> 3321;
	3309 [label="Tu as apporté une telle paix à mon frère d'âme. Tu l'as convaincu que nous avons un véritable ennemi à combattre et tu lui as redonné espoir.",shape=box,color=blue];
		3309 -> 3329;
	3310 [label="Tu as apporté à mon frère de cœur du réconfort et une forme de paix là où il n'en avait aucune auparavant. Je crois que ta présence lui a été plus précieuse qu'il ne saurait l'exprimer.",shape=box,color=blue];
		3310 -> 3329;
	3311 [label="Même si nous ne connaîtrons peut-être jamais la véritable nature de l'Indifférence, nous savons que cela n'a pas d'importance. Nous devons l'affronter comme le défi qu'elle représente et qui est bien réel.",shape=box,color=blue];
		3311 -> 3329;
	3312 [label="Je ne nous pensais pas capables de convaincre notre diable d'aider Monsieur Loid et la famille du Cardinal à se réconcilier. Je sais que ses raisons sont... douteuses, peut-être, et je ne lui fais toujours pas entièrement confiance. ",shape=box,color=blue];
		3312 -> 3330;
	3313 [label="Je ne nous pensais pas capables de faire comprendre ses erreurs à notre diable. Qu'il puisse éprouver le moindre regret pour les vies innocentes qu'il a fauchées. Tu m'as prouvé le contraire.",shape=box,color=blue];
		3313 -> 3331;
	3314 [label="Quelles que soient les chaînes qui retiennent notre diable, elles le tiennent en laisse. Il semble plus… calme qu'avant. Et c'est grâce à toi.",shape=box,color=blue];
		3314 -> 3331;
	3315 [label="Les souvenirs que nous l'avons aidé à retrouver semblent l'avoir apaisé. Peut-être que le souvenir de la douleur causée par la mort de tous ceux qu'il a perdus lui a rappelé qu'il pouvait encore perdre d'autres proches.",shape=box,color=blue];
		3315 -> 3331;
	3316 [label="Peut-être est-ce son affection pour toi qui l'adoucit, je ne sais pas. Quoi qu'il en soit, je sais que c'est grâce à toi.",shape=box,color=blue];
		3316 -> 3331;
	3308 [label="Je ne te garde aucune rancune et je vous souhaite à tous les deux de la joie et rien d'autre, ça va?",shape=box,color=blue];
		3308 -> 3327;
		3308 -> 3328;
	3306 [label="Les choses ont changé et... je dois être fidèle, je m'excuse.",shape=box,color=red];
		3306 -> 3325;
	3307 [label="C'est peut-être difficile à croire, voire à accepter, je le sais. Mais je... t'aime. Et je l'aime aussi. À parts égales.",shape=box,color=red];
		3307 -> 3326;
