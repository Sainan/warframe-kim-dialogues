		3344 -> 3357;
	3891 [label="Au lieu de ça? Alors, j'ai bien peur que tu ne doives démêler les fils de ton cœur d'abord, Voyageur. Je ne peux pas le faire à ta place.",shape=box,color=blue];
		3891 -> 3892;
	3342 [label="Et c'est fort possible. Je ne suis pas jalouse de nature, mais c'est une chose de savoir que quelqu'un a conquis ton cœur, alors que je ne connais pas cette personne.",shape=box,color=blue];
