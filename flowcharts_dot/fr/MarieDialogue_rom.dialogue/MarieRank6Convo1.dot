	3291 [label="Ton amitié est si belle et si précieuse, je n'aurais jamais osé espérer pareille chose. ",shape=box,color=blue];
		3291 -> 3299;
	3292 [label="Oui, et je crois que tu préfères qu'il en soit ainsi, n'est-ce pas? Ha! Je ne veux pas me représenter le diable de cette façon – peu importe! Ce n'est pas pour cela que je suis venue te parler.",shape=box,color=blue];
		3292 -> 3300;
