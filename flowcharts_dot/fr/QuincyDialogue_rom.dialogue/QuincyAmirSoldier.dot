digraph {
	1845 [label="QuincyAmirSoldier begins.",color=orange];
		1845 -> 1846;
	1846 [label="hey",shape=box,color=blue];
		1846 -> 1847;
	1847 [label="j'ai parlé au petit geek comme tu l'as demandé",shape=box,color=blue];
		1847 -> 1850;
		1847 -> 1848;
		1847 -> 1853;
	1850 [label="Comment ça s'est passé?",shape=box,color=red];
		1850 -> 1849;
	1848 [label="Waouh, tu m'écoutes vraiment?",shape=box,color=red];
		1848 -> 1851;
	1853 [label="Pardon, je ne peux pas maintenant. [Fin.]",shape=box,color=red];
		1853 -> 1852;
	1849 [label="au début, il a cru que j'allais le cogner, mdr. mais je l'ai emmené sur le toit, on s'est assis et on a discuté",shape=box,color=blue];
		1849 -> 1854;
	1851 [label="putain, mets-la en veilleuse et laisse-moi parler, ok?",shape=box,color=blue];
		1851 -> 1849;
	1852 [label="Chat ends.",color=orange];
	1854 [label="je lui ai parlé de mon arrivée dans l'armée et de la façon dont je suis devenu tireur d'élite",shape=box,color=blue];
		1854 -> 1856;
		1854 -> 1855;
	1856 [label="Au fait, comment tu es devenu sniper?",shape=box,color=red];
		1856 -> 1857;
	1855 [label="Et?",shape=box,color=red];
		1855 -> 1858;
	1857 [label="pas important là tout de suite",shape=box,color=blue];
		1857 -> 1858;
	1858 [label="je lui ai raconté la première fois où j'ai dû tuer quelqu'un",shape=box,color=blue];
		1858 -> 1859;
	1859 [label="la première fois où j'ai dû regarder dans ce viseur et prendre une vie",shape=box,color=blue];
		1859 -> 1860;
	1860 [label="c'est une chose quand t'es dans le feu de l'action... un connard arrive sur toi avec une arme à feu ou un couteau ou quoi que ce soit...",shape=box,color=blue];
		1860 -> 1861;
	1861 [label="c'est carrément autre chose quand tu es sur un toit à 300 mètres et qu'ils savent même pas que t'es là...",shape=box,color=blue];
		1861 -> 1864;
	1864 [label="et tu as le temps de *penser* à eux. qui ils sont. pourquoi ils sont là. est-ce qu'ils ont une famille? des enfants?",shape=box,color=blue];
		1864 -> 1862;
	1862 [label="et... et puis tu appuies sur la détente. BOUM",shape=box,color=blue];
		1862 -> 1863;
	1863 [label="ça n'a plus d'importance maintenant",shape=box,color=blue];
		1863 -> 1865;
	1865 [label="ils sont morts et j'ai pris ces vies",shape=box,color=blue];
		1865 -> 1866;
	1866 [label="et ces visages vivent dans ma tête",shape=box,color=blue];
		1866 -> 1867;
	1867 [label="pareil pour tous ceux qui sont venus par la suite",shape=box,color=blue];
		1867 -> 1868;
		1867 -> 1869;
	1868 [label="Comment il a réagi...?",shape=box,color=red];
		1868 -> 1871;
	1869 [label="Ça semble... encourageant.",shape=box,color=red];
		1869 -> 1871;
	1871 [label="puis j'ai plus rien dit pendant très longtemps. on est restés assis là en silence",shape=box,color=blue];
		1871 -> 1877;
	1877 [label="ensuite il... m'a parlé des cauchemars qu'il faisait",shape=box,color=blue];
		1877 -> 1874;
	1874 [label="et comment il a l'impression de pas vraiment faire partie du groupe parce qu'il est pas un soldat",shape=box,color=blue];
		1874 -> 1872;
	1872 [label="alors je lui ai raconté à quel point c'était horrible pour moi la première fois que j'ai tué en tant que soldat",shape=box,color=blue];
		1872 -> 1873;
	1873 [label="et que j'avais l'habitude d'en faire des cauchemars, pires que ceux que je faisais quand j'étais petit",shape=box,color=blue];
		1873 -> 1875;
	1875 [label="mais je lui ai dit que j'étais désolé de l'avoir traité comme un boulet pendant tout ce temps",shape=box,color=blue];
		1875 -> 1876;
	1876 [label="et qu'il avait sa place parmi nous autant que n'importe qui d'autre. et que j'avais une façon d'être moi, comme pour lui et c'est juste qui nous sommes, tu vois?",shape=box,color=blue];
		1876 -> 1870;
	1870 [label=".... et alors, tu sais ce qu'il a dit...?",shape=box,color=blue];
		1870 -> 1878;
		1870 -> 1879;
	1878 [label="Hein?",shape=box,color=red];
		1878 -> 1882;
	1879 [label="Non?",shape=box,color=red];
		1879 -> 1882;
	1882 [label="\"t'as raison, tu es un connard\"",shape=box,color=blue];
		1882 -> 1884;
	1884 [label="mais juste au moment où j'étais sur le point de le pousser du toit?",shape=box,color=blue];
		1884 -> 1883;
	1883 [label="il m'a serré dans ses bras. putain, il m'a serré dans ses bras et m'a dit \"mais t'es aussi mon grand frère\"",shape=box,color=blue];
		1883 -> 1881;
	1881 [label="wtf",shape=box,color=blue];
		1881 -> 1880;
	1880 [label="mais... nan. c'est cool. je pense que c'était important pour lui, vraiment... et... pour moi aussi. je crois",shape=box,color=blue];
		1880 -> 1886;
