	j3120233919 [label="Les choses ont changé trop vite dans ce trou à rats. Surtout dans les recoins d'Internet où l'on parle de ce Dokteur.",shape=box,color=blue];
		j3120233919 -> j3666966846;
	j3666966846 [label="Alors, je l'ai trouvé, je l'ai surpris. Et oh mon Dieu. Grand-père Dokteur n'était pas content mais j'ai tout de suite compris.",shape=box,color=blue];
		j3666966846 -> j1653453828;
	j1653453828 [label="Je savais qu'il venait du futur. Il savait que je le savais. Il m'a donné le choix et... peu importe. Maintenant, je t'ai trouvé. ",shape=box,color=blue];
		j1653453828 -> j3253949642;
	j3253949642 [label="Et d'une certaine manière, je te donne aussi le choix: aide-moi ou tu le regretteras.",shape=box,color=blue];
