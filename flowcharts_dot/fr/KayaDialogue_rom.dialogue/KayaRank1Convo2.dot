digraph {
	"KayaRank1Convo2 begins." [color=orange];
		"KayaRank1Convo2 begins." -> j399579835;
	j399579835 [label="Bonjour. Pourquoi la configuration intertemporelle d'Entrati impliquerait-elle ce qui semble être une connexion active au réseau en ligne Kinemantik?",shape=box,color=blue];
		j399579835 -> j15569800;
	j15569800 [label="Est-ce qu'Internet est nécessaire pour voyager dans le temps?",shape=box,color=blue];
		j15569800 -> j3308116696;
		j15569800 -> j285545833;
	j3308116696 [label="Droit au but, d'accord. Non, \"Internet\" n'existant pas à mon époque, il n'est donc pas nécessaire. Ou peut-être que si. ",shape=box,color=red];
		j3308116696 -> j3533744952;
	j285545833 [label="Et bonjour à toi aussi, Kaya. ",shape=box,color=red];
		j285545833 -> j1211302532;
	j3533744952 [label="Donc, tu n'as pas besoin d'une connexion Internet pour aller et venir à ta guise? Et Entrati?",shape=box,color=blue];
		j3533744952 -> j389000470;
	j1211302532 [label="Euh. Internet? Je pourrais comprendre, étant donné les propriétés d'un réseau...",shape=box,color=blue];
		j1211302532 -> j389000470;
	j389000470 [label="Je n'ai aucune certitude. Je sais juste qu'il y avait une séquence, qu'Entrati avait un plan et qu'il impliquait ma présence ici, maintenant. Je devais venir ici, pour vous rencontrer tous.",shape=box,color=red];
		j389000470 -> j1114677727;
	j1114677727 [label="D'accord, mais pourquoi semble-t-il y avoir une connexion Internet non négociable dans certaines de ses notes?",shape=box,color=blue];
