		j1884810939 -> j1624139395;
	j4069927203 [label="Pardonne-moi de te le dire, mais je ne sais vraiment pas. ",shape=box,color=red];
		j4069927203 -> j1836248194;
	j2278360939 [label="Oh oui, absolument. Nova est connue pour avoir détruit Internet. C'est pour ça que je suis là, pour t'en empêcher.",shape=box,color=red];
		j2278360939 -> j2942475902;
	j1946726663 [label="Les gens mentent sur Internet. Ils peuvent se faire passer pour tes amis et répandre des rumeurs très rapidement. ",shape=box,color=blue];
