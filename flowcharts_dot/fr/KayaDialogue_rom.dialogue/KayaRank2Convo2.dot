digraph {
	"KayaRank2Convo2 begins." [color=orange];
		"KayaRank2Convo2 begins." -> j815588430;
	j815588430 [label="Salut. Tu peux me confirmer quelque chose? ",shape=box,color=blue];
		j815588430 -> j2671807170;
	j2671807170 [label="La clé de tes capacités de voyage dans le temps, c'est un mélange de Technocyte et de Néant, dans une certaine proportion?",shape=box,color=blue];
		j2671807170 -> j1084566025;
		j2671807170 -> j3479700454;
	j1084566025 [label="Un mélange? On fait un gâteau?",shape=box,color=red];
		j1084566025 -> j1682134822;
	j3479700454 [label="Alors, tes études avancent bien?",shape=box,color=red];
		j3479700454 -> j132140037;
	j1682134822 [label="Je n'ai jamais essayé d'en faire, mais je parie que je ferais un délice.",shape=box,color=blue];
		j1682134822 -> j639466803;
		j1682134822 -> j1255765590;
	j132140037 [label="Super bien. Je suis vraiment très proche en fait. Super proche.",shape=box,color=blue];
		j132140037 -> j1686525977;
		j132140037 -> j637007268;
	j639466803 [label="Comment le sais-tu?",shape=box,color=red];
		j639466803 -> j3059904316;
	j1255765590 [label="Quelle humilité, Nova.",shape=box,color=red];
		j1255765590 -> j3059904316;
	j1686525977 [label="Comment peux-tu en être sûre?",shape=box,color=red];
		j1686525977 -> j3988109219;
	j637007268 [label="Tu devais être une excellente étudiante.",shape=box,color=red];
		j637007268 -> j1918622741;
	j3059904316 [label="Je n'ai pas à être humble. J'ai eu la meilleure note de toute l'histoire de mon lycée ET ma première année d'université m'a valu le meilleur dossier scolaire des 100 dernières années.",shape=box,color=blue];
		j3059904316 -> j3495021083;
		j3059904316 -> j1901363588;
	j3988109219 [label="As-tu entendu parler de \"Nora Night\"?",shape=box,color=blue];
		j3988109219 -> j123353667;
		j3988109219 -> j27120560;
	j1918622741 [label="J'ai eu la meilleure note de toute l'histoire de mon lycée ET ma première année d'université m'a valu le meilleur dossier scolaire des 100 dernières années.",shape=box,color=blue];
		j1918622741 -> j2256253347;
	j3495021083 [label="Ce qui ne veut pas dire que tu pourrais faire un gâteau. À moins que tu n'aies suivi l'option pâtisserie?",shape=box,color=red];
		j3495021083 -> j1852949915;
	j1901363588 [label="Mais pas assez intelligente pour ne pas prendre le sérum d'Entrati, hein?",shape=box,color=red];
		j1901363588 -> j114808479;
	j123353667 [label="Je pense bien, mais elle, elle a certainement entendu parler de moi.",shape=box,color=red];
		j123353667 -> j924990079;
	j27120560 [label="Waouh, ouais. Elle est de mon époque",shape=box,color=red];
		j27120560 -> j924990079;
	j2256253347 [label="J'étais plus qu'une excellente étudiante. J'avais des universités qui me sollicitaient pour y aller. Ma première année aurait été parfaite...",shape=box,color=blue];
		j2256253347 -> j1021438527;
		j2256253347 -> j3632327717;
	j1852949915 [label="Boolean KayaCake is now true.",color=orange];
		j1852949915 -> j2172427966;
	j114808479 [label="MDR? Tu peux parler? Le \"chouchou du professeur Entrati\". Ouais, j'ai entendu ce que tout le monde a dit à ton sujet",shape=box,color=blue];
		j114808479 -> j2560290712;
		j114808479 -> j2400145080;
	j924990079 [label="Mmm, bien sûr. Eh bien, j'ai réussi à créer une formule d'interception temporelle qui a fini par recevoir des ondes sonores! ",shape=box,color=blue];
		j924990079 -> j3357076416;
	j1021438527 [label="S'il n'y avait pas eu... tout ça?",shape=box,color=red];
		j1021438527 -> j3322188285;
	j3632327717 [label="S'il n'y avait pas eu... Entrati?",shape=box,color=red];
		j3632327717 -> j3322188285;
	j2172427966 [label="Oh. Mon. Dieu. Tu penses sérieusement que je ne saurais pas faire un gâteau?",shape=box,color=blue];
		j2172427966 -> j2195629141;
	j2560290712 [label="Tu inventes des trucs pour te déchaîner. Pourquoi?",shape=box,color=red];
		j2560290712 -> j2210253287;
	j2400145080 [label="Essaies-tu de me blesser?",shape=box,color=red];
		j2400145080 -> j2210253287;
	j3357076416 [label="Alors, je me suis connectée ici et là. Je pense qu'on s'entendrait bien.",shape=box,color=blue];
		j3357076416 -> j2158902051;
	j3322188285 [label="S'il n'y avait pas eu cet Internet de merde. ",shape=box,color=blue];
		j3322188285 -> j2118272069;
		j3322188285 -> j4124632640;
	j2195629141 [label="Une distraction bienvenue. Bouge pas.",shape=box,color=blue];
		j2195629141 -> j2906669224;
	j2210253287 [label="Être populaire ne fait pas tout. Et si tout le monde voulait te voir échouer? Si tu es au sommet, tout le monde voudra un jour te faire tomber. ",shape=box,color=blue];
		j2210253287 -> j3432089414;
		j2210253287 -> j213071093;
	j2158902051 [label="Alors, je peux rassembler mes théories et peut-être essayer d'intercepter une forme de matière, sans vie pour plus de sécurité.",shape=box,color=blue];
		j2158902051 -> j3612096041;
	j2118272069 [label="Internet finira par mourir, ne t'inquiète pas.",shape=box,color=red];
		j2118272069 -> j2341553348;
	j4124632640 [label="Donc, tu as eu des problèmes à l'université à cause... d'Internet.",shape=box,color=red];
		j4124632640 -> j2679869285;
	j2906669224 [label="+20 Chemistry",color=orange];
		j2906669224 -> "Chat ends. Next chat will be KayaRank2Convo3.";
