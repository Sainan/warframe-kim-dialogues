		j3432089414 -> j1275403030;
	j213071093 [label="Nous ne sommes pas comme ça ici, Nova, nous avons de vraies difficultés à gérer.",shape=box,color=red];
		j213071093 -> j1275403030;
	j3612096041 [label="D'une certaine manière, tu as laissé ton propre Trou de Ver avec lequel je peux travailler, donc je suppose que tu es mon partenaire d'étude. Crédit partiel accordé.",shape=box,color=blue];
		j3612096041 -> j463613428;
		j3612096041 -> j3139915398;
	j2341553348 [label="C'est peut-être moi qui vais le tuer!",shape=box,color=blue];
