		j2679869285 -> j3070223940;
	"Chat ends. Next chat will be KayaRank2Convo3." [color=orange];
	j1275403030 [label="Faire confiance aux gens peut être dangereux. Faire confiance aux gens sur Internet? Ça te ruine la vie. ",shape=box,color=blue];
		j1275403030 -> j2906669224;
	j463613428 [label="Un 20/20 pour nous deux!",shape=box,color=red];
