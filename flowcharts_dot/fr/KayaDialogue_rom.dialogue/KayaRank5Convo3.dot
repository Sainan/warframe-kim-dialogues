	j3362722693 [label="Un choix vraiment élégant.",shape=box,color=blue];
		j3362722693 -> j1454816950;
	j1654098901 [label="Ce qui te permet de débloquer tout un système de récoltes.",shape=box,color=blue];
		j1654098901 -> j1454816950;
	j2671668287 [label="Tu peux faire évoluer Frogobogo jusqu'à atteindre le niveau DRAGON.",shape=box,color=blue];
		j2671668287 -> j1454816950;
	j1454816950 [label="En quoi consiste ce jeu, exactement...",shape=box,color=red];
		j1454816950 -> j4228564389;
	j4228564389 [label="Bon, d'accord, tu collectes des Jinymons et ils se battent pour toi et tu peux vivre des aventures.",shape=box,color=blue];
		j4228564389 -> j1343371406;
	j1343371406 [label="Mais c'est dans la version jeu vidéo. Dans la version jeu de cartes, c'est comme si tu livrais des batailles contre quelqu'un d'autre dans la vraie vie.",shape=box,color=blue];
		j1343371406 -> j3792269789;
	j3792269789 [label="C'est l'idée générale. Jinymon Jinymon Jinymon. ",shape=box,color=blue];
		j3792269789 -> j3302902049;
	j3302902049 [label="Alors, on commence ta première partie?",shape=box,color=blue];
		j3302902049 -> j1657286522;
		j3302902049 -> j2195664537;
		j3302902049 -> j1672872807;
		j3302902049 -> j3952771371;
	j1657286522 [label="Non. Pas vraiment. [Fin.]",shape=box,color=red];
		j1657286522 -> j145506587;
	j2195664537 [label="Bien sûr, pourquoi pas, la chance du débutant devrait être de mon côté.",shape=box,color=red];
		j2195664537 -> j2606390973;
	j1672872807 [label="Tu veux juste une victoire facile. Pas question.",shape=box,color=red];
		j1672872807 -> j1722863082;
	j3952771371 [label="Non, c'est pas clair. Tu n'as rien expliqué! ",shape=box,color=red];
		j3952771371 -> j1722863082;
	j2606390973 [label="Génial... il te suffit de débourser environ 10 000 höllars pour ton propre deck de départ...",shape=box,color=blue];
		j2606390973 -> j4251940888;
		j2606390973 -> j1181023774;
	j1722863082 [label="Oh allez... Je vais y aller doucement avec toi. Je laisserai même Amir t'aider! ",shape=box,color=blue];
		j1722863082 -> j1880321067;
	j4251940888 [label="Si tu le dis...",shape=box,color=red];
		j4251940888 -> j1116524407;
	j1181023774 [label="Quoi? Je n'ai pas tout cet argent.",shape=box,color=red];
		j1181023774 -> j1116524407;
	j1880321067 [label="Et si tu gagnes, je te donnerai un pack Jinymon non ouvert!",shape=box,color=blue];
		j1880321067 -> j4093653617;
		j1880321067 -> j1710379758;
		j1880321067 -> j2230424262;
	j1116524407 [label="Ce n'est pas un problème, il te suffit simplement d'entrer tes informations bancaires ici...",shape=box,color=blue];
		j1116524407 -> j2825470589;
		j1116524407 -> j2913636765;
	j4093653617 [label="Très bien, très bien. Seulement si Amir peut m'aider.",shape=box,color=red];
		j4093653617 -> j2606390973;
	j1710379758 [label="Et si on remettait ça à plus tard?",shape=box,color=red];
