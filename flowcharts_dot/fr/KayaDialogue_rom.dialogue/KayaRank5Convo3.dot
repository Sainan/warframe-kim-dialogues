		j2496722648 -> j3135009397;
	j2703887983 [label="C'est l'option la plus cool mais certainement la plus difficile pour débuter.",shape=box,color=blue];
		j2703887983 -> j3395927207;
	j1273256509 [label="Qui est prévu pour un niveau un peu plus avancé mais vraiment cool. ",shape=box,color=blue];
