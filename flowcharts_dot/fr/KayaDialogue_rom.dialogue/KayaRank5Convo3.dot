		j2751350304 -> j75549659;
	j2496722648 [label="Ce n'est pas le plus important, j'imagine. Quoi qu'il en soit, commençons par toi. Tu te vois plutôt comme un dragon, un aigle ou une panthère ?",shape=box,color=blue];
		j2496722648 -> j3564473577;
