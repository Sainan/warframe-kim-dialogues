		j75549659 -> j587596290;
	j3395927207 [label="Mais à la fin? La plus belle et la plus majestueuse des panthères est à toi.",shape=box,color=blue];
		j3395927207 -> j3362722693;
	j26115063 [label="Et Plumebert est super mignon parce que tu peux lui donner des raisins pétillants pour monter de niveau plus rapidement que tout le monde.",shape=box,color=blue];
		j26115063 -> j1654098901;
	j587596290 [label="Et tu commences avec la grenouille la plus mignonne de tous les temps, mais finalement, si tu gagnes suffisamment de batailles...",shape=box,color=blue];
