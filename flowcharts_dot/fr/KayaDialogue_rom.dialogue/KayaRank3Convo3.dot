	j3551093640 [label="Je ne sais plus si je peux encore faire confiance aux gens. Même à toi.",shape=box,color=blue];
		j3551093640 -> j2359233992;
	"Chat ends. Next chat will be KayaRank4Convo1." [color=orange];
	j4071667463 [label="Tu m'as piégée dans la pire année de ma vie. ",shape=box,color=blue];
		j4071667463 -> j2359233992;
	j2359233992 [label="C'est comme si je t'utilisais pour sortir d'ici. ",shape=box,color=blue];
		j2359233992 -> j64664225;
		j2359233992 -> j32866117;
	j64664225 [label="Quelle que soit la raison qui t'a amenée à être comme ça, cela ruine tes chances d’atteindre le véritable bonheur.",shape=box,color=red];
		j64664225 -> j386237270;
	j32866117 [label="Vas-y. Plus tôt tu seras partie, moins j'aurai à gérer ton attitude.",shape=box,color=red];
		j32866117 -> j1977275812;
	j386237270 [label="Tu ne peux pas me forcer à te détester. Tu peux m'énerver, c'est sûr, mais ce n'est pas de la haine.",shape=box,color=red];
		j386237270 -> j1468782223;
		j386237270 -> j1520904270;
	j1977275812 [label="Heureuse que nous soyons d’accord.",shape=box,color=blue];
		j1977275812 -> j1173661291;
	j1468782223 [label="Si tu dois penser que tu nous utilises, vas-y. ",shape=box,color=red];
		j1468782223 -> j3823798667;
	j1520904270 [label="Je vais t'aider, d'une manière ou d'une autre.",shape=box,color=red];
		j1520904270 -> j1000428743;
	j1173661291 [label="Boolean KayaAttitude is now true.",color=orange];
		j1173661291 -> j3588492270;
	j3823798667 [label="Quand tu le comprendras, et tu le comprendras, nous serons toujours là.",shape=box,color=red];
		j3823798667 -> j852349762;
	j1000428743 [label="J'espère juste que tu réaliseras assez tôt que nous n'essayons pas de te faire du mal.",shape=box,color=red];
		j1000428743 -> j1428106134;
	j852349762 [label="Quand tu sauras... aucun d'entre vous ne me regardera de la même façon...",shape=box,color=blue];
		j852349762 -> j3588492270;
	j1428106134 [label="Même si vous n'essayez pas, je vais finir par merder. C'est toujours comme ça.",shape=box,color=blue];
