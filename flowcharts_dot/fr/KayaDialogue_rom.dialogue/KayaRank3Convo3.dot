		j3361850875 -> j3952815305;
		j3361850875 -> j367701989;
	j1509660828 [label="Respire, va te détendre, Nova [Fin.]",shape=box,color=red];
		j1509660828 -> j3588492270;
	j3952815305 [label="Ça a été dur pour tout le monde. Tout ira bien.",shape=box,color=red];
		j3952815305 -> j116774703;
	j367701989 [label="Nous avons tous perdu quelque chose à cause de ces conneries. Regarde autour de toi.",shape=box,color=red];
