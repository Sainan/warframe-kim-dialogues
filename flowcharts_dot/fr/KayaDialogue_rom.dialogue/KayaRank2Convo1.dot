		195 -> 203;
	196 [label="Arthur et Eleanor te voient définitivement comme une petite sœur bien plus intelligente qu'eux.",shape=box,color=red];
		196 -> 204;
	198 [label="C'est toi qui dis que je suis une gamine... et s'il m'arrivait quelque chose?",shape=box,color=blue];
