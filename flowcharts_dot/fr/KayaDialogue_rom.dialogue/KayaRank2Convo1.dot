	199 [label="Bon. Tu as raison.",shape=box,color=blue];
		199 -> 207;
	201 [label="+20 Chemistry",color=orange];
		201 -> 209;
	202 [label="Et je ne fais pas d'erreurs.",shape=box,color=blue];
		202 -> 210;
	203 [label="Ce n'est pas drôle. Mets des filles comme nous dans une pièce et tout le monde s'attend à ce qu'on se tape dessus.",shape=box,color=blue];
		203 -> 211;
	204 [label="Amir et Quincy sont subjugués par ton Trou de Ver et je jure que lorsque tu ne regardes pas, ils sautent à travers.",shape=box,color=red];
