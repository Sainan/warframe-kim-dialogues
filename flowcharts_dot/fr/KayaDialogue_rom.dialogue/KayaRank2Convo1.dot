		173 -> 175;
	174 [label="OK merci, mais ne m'appelle pas Kaya sur Internet. Tu peux m'appeler comme ça en personne, mais ici: NOVA. Ok?",shape=box,color=blue];
		174 -> 176;
		174 -> 177;
	175 [label="Euh, est-ce que ça a de l'importance? C'est Internet, je préfère ne pas utiliser mon vrai nom.",shape=box,color=blue];
		175 -> 178;
		175 -> 179;
	176 [label="D'accord, mais puis-je demander pourquoi?",shape=box,color=red];
		176 -> 180;
	177 [label="D'accord. Nova. Nova. D'accord. Je voulais te demander: y a-t-il quelque chose que je puisse faire pour que les choses soient plus agréables pour toi ici?",shape=box,color=red];
		177 -> 181;
	178 [label="C'est vrai, je ne voudrais pas que les gens voient à quelle fréquence tu me poses des questions sur les voyages dans le temps.",shape=box,color=red];
		178 -> 182;
	179 [label="Oh? Je crois qu'Amir a bien protégé ce réseau, à moins que quelque chose ne m'échappe?",shape=box,color=red];
		179 -> 183;
	180 [label="T'as déjà demandé à quelqu'un s'il avait un surnom qu'il aimait? Fais avec. ",shape=box,color=blue];
		180 -> 177;
	181 [label="Je sais qu'aucun d'entre nous n'a vraiment demandé à \"être ici\" dans ce refuge de fortune, mais nous faisons de notre mieux.",shape=box,color=red];
		181 -> 184;
	182 [label="Tu rigoles? Internet est dangereux. Vraiment.",shape=box,color=blue];
		182 -> 185;
		182 -> 186;
	183 [label="C'est important pour moi. Je ne veux plus jamais qu'on trouve Kaya en ligne.",shape=box,color=blue];
		183 -> 187;
		183 -> 188;
	184 [label="Hmm. Hum. Hmm. Agréable. Personne n'a répandu de rumeurs à mon sujet, n'est-ce pas?",shape=box,color=blue];
		184 -> 189;
		184 -> 190;
	185 [label="Il t'est arrivé quelque chose?",shape=box,color=red];
		185 -> 191;
	186 [label="Et pas le voyage dans le temps, tu crois?",shape=box,color=red];
		186 -> 192;
