digraph {
	"KayaRank2Convo1 begins." [color=orange];
		"KayaRank2Convo1 begins." -> j2313594142;
	j2313594142 [label="Salut, Kaya!",shape=box,color=red];
		j2313594142 -> j3155079997;
	j3155079997 [label="Nova, je m'appelle Nova quand je suis en ligne.",shape=box,color=blue];
		j3155079997 -> j2794673812;
		j3155079997 -> j1501719873;
	j2794673812 [label="Ok, Nova alors. ",shape=box,color=red];
		j2794673812 -> j899934602;
	j1501719873 [label="Je vois. Depuis quand?",shape=box,color=red];
		j1501719873 -> j754692871;
	j899934602 [label="OK merci, mais ne m'appelle pas Kaya sur Internet. Tu peux m'appeler comme ça en personne, mais ici: NOVA. Ok?",shape=box,color=blue];
		j899934602 -> j2721538497;
		j899934602 -> j1479333445;
	j754692871 [label="Euh, est-ce que ça a de l'importance? C'est Internet, je préfère ne pas utiliser mon vrai nom.",shape=box,color=blue];
		j754692871 -> j469801069;
		j754692871 -> j1676855365;
	j2721538497 [label="D'accord, mais puis-je demander pourquoi?",shape=box,color=red];
		j2721538497 -> j3386089450;
	j1479333445 [label="D'accord. Nova. Nova. D'accord. Je voulais te demander: y a-t-il quelque chose que je puisse faire pour que les choses soient plus agréables pour toi ici?",shape=box,color=red];
		j1479333445 -> j3934040169;
	j469801069 [label="C'est vrai, je ne voudrais pas que les gens voient à quelle fréquence tu me poses des questions sur les voyages dans le temps.",shape=box,color=red];
		j469801069 -> j3799802824;
	j1676855365 [label="Oh? Je crois qu'Amir a bien protégé ce réseau, à moins que quelque chose ne m'échappe?",shape=box,color=red];
		j1676855365 -> j2014792966;
	j3386089450 [label="T'as déjà demandé à quelqu'un s'il avait un surnom qu'il aimait? Fais avec. ",shape=box,color=blue];
		j3386089450 -> j1479333445;
	j3934040169 [label="Je sais qu'aucun d'entre nous n'a vraiment demandé à \"être ici\" dans ce refuge de fortune, mais nous faisons de notre mieux.",shape=box,color=red];
		j3934040169 -> j3468114904;
	j3799802824 [label="Tu rigoles? Internet est dangereux. Vraiment.",shape=box,color=blue];
		j3799802824 -> j1080089625;
		j3799802824 -> j106629024;
	j2014792966 [label="C'est important pour moi. Je ne veux plus jamais qu'on trouve Kaya en ligne.",shape=box,color=blue];
		j2014792966 -> j3350648347;
		j2014792966 -> j2084756121;
	j3468114904 [label="Hmm. Hum. Hmm. Agréable. Personne n'a répandu de rumeurs à mon sujet, n'est-ce pas?",shape=box,color=blue];
		j3468114904 -> j2213503887;
		j3468114904 -> j4274763810;
	j1080089625 [label="Il t'est arrivé quelque chose?",shape=box,color=red];
		j1080089625 -> j960515419;
	j106629024 [label="Et pas le voyage dans le temps, tu crois?",shape=box,color=red];
		j106629024 -> j4294415938;
	j3350648347 [label="Les flics ne t'attraperont pas, je te le jure.",shape=box,color=red];
		j3350648347 -> j3332960046;
	j2084756121 [label="Tu t'es mise dans le pétrin?",shape=box,color=red];
		j2084756121 -> j2003539585;
	j2213503887 [label="Eh bien, Aoi a dit...",shape=box,color=red];
		j2213503887 -> j270330254;
	j4274763810 [label="Pas un mot. Ils sont juste contents que tu sois là.",shape=box,color=red];
		j4274763810 -> j3928461853;
	j960515419 [label="Check boolean KayaSetKid",color=orange];
		j960515419 -> j3536870649 [label=true,color=green];
		j960515419 -> j4096358861 [label=false,color=brown];
	j4294415938 [label="Check boolean KayaSetKid",color=orange];
		j4294415938 -> j220903015 [label=true,color=green];
		j4294415938 -> j63364744 [label=false,color=brown];
	j3332960046 [label="Pfff. C'est pas drôle. ",shape=box,color=blue];
		j3332960046 -> j2292283515;
	j2003539585 [label="J'ai fait une erreur stupide. Une fois. ",shape=box,color=blue];
		j2003539585 -> j1619663835;
	j270330254 [label="En fait, je ne plaisante pas.",shape=box,color=blue];
		j270330254 -> j512381037;
	j3928461853 [label="Arthur et Eleanor te voient définitivement comme une petite sœur bien plus intelligente qu'eux.",shape=box,color=red];
		j3928461853 -> j3764056972;
	j3536870649 [label="C'est toi qui dis que je suis une gamine... et s'il m'arrivait quelque chose?",shape=box,color=blue];
		j3536870649 -> j4079825624;
	j4096358861 [label="Rien que je puisse changer, maintenant.",shape=box,color=blue];
		j4096358861 -> j1070689740;
	j220903015 [label="Écoute, je sais que tu penses que je ne suis qu'une gamine.",shape=box,color=blue];
		j220903015 -> j6792077;
	j63364744 [label="Bon. Tu as raison.",shape=box,color=blue];
		j63364744 -> j3135466790;
	j2292283515 [label="+20 Chemistry",color=orange];
		j2292283515 -> "Chat ends. Next chat will be KayaRank2Convo2.";
	j1619663835 [label="Et je ne fais pas d'erreurs.",shape=box,color=blue];
		j1619663835 -> j1826628304;
	j512381037 [label="Ce n'est pas drôle. Mets des filles comme nous dans une pièce et tout le monde s'attend à ce qu'on se tape dessus.",shape=box,color=blue];
		j512381037 -> j2217732210;
	j3764056972 [label="Amir et Quincy sont subjugués par ton Trou de Ver et je jure que lorsque tu ne regardes pas, ils sautent à travers.",shape=box,color=red];
		j3764056972 -> j890091595;
	j4079825624 [label="J’espère alors que tu pourras constater, en regardant les gens qui t'entourent, que nous sommes une équipe qui s’entraide.",shape=box,color=red];
		j4079825624 -> j4002994732;
	j1070689740 [label="Eh bien, c'est pour ça que tu veux comprendre cette histoire de voyage dans le temps? Pour prouver quelque chose?",shape=box,color=red];
		j1070689740 -> j863256522;
	j6792077 [label="Mais ",shape=box,color=blue];
		j6792077 -> j2003539585;
	j3135466790 [label="C'est probablement le cas. Et c'est pour cela que je dois savoir comment agir correctement. Je ne peux pas faire d'erreurs.",shape=box,color=blue];
		j3135466790 -> j2003539585;
	"Chat ends. Next chat will be KayaRank2Convo2." [color=orange];
	j1826628304 [label="Alors donne-moi encore quelques jours, peut-être quelques semaines, et j'aurai tout compris et ce sera au revoir 1999.",shape=box,color=blue];
		j1826628304 -> j1432935478;
	j2217732210 [label="La jalousie. Les comparaisons. Pouah. J'en ai fini avec cette partie de ma vie. N'essaie pas de me monter contre les autres filles. ",shape=box,color=blue];
		j2217732210 -> j2292283515;
	j890091595 [label="Aoi et Lettie n'arrivent pas à décider si elles veulent être ta meilleure amie ou ta mère.",shape=box,color=red];
		j890091595 -> j1230226755;
	j4002994732 [label="Mmm. ",shape=box,color=blue];
		j4002994732 -> j2824909919;
	j863256522 [label="Peut-être.",shape=box,color=blue];
		j863256522 -> j366331739;
	j1432935478 [label="Tu peux compter là-dessus.",shape=box,color=blue];
		j1432935478 -> j2292283515;
	j1230226755 [label="Et bien sûr moi. Je trouve génial que quelqu'un veuille comprendre comment diable j'ai atterri ici.",shape=box,color=red];
		j1230226755 -> j1087059070;
	j2824909919 [label="Tu as raison, tu as plutôt bonne presse.",shape=box,color=blue];
		j2824909919 -> j1062176942;
	j366331739 [label="Pourquoi est-ce que ça t'intéresse, en fait?",shape=box,color=blue];
		j366331739 -> j2719524561;
		j366331739 -> j2127490321;
		j366331739 -> j2514191131;
	j1087059070 [label="Vous m'aimez vraiment bien, les gars?",shape=box,color=blue];
		j1087059070 -> j3929996647;
		j1087059070 -> j933960310;
	j1062176942 [label="Tout le monde semble te faire confiance, ou du moins c'est ce qu'ils disent.",shape=box,color=blue];
		j1062176942 -> j2514191131;
		j1062176942 -> j2127490321;
		j1062176942 -> j2719524561;
	j2719524561 [label="Faire confiance aux gens et travailler ensemble, c'est ce qui fait notre force. ",shape=box,color=red];
		j2719524561 -> j2118566256;
	j2127490321 [label="Prendre soin de mes amis est une force. C'est une motivation pour supporter toute cette merde.",shape=box,color=red];
		j2127490321 -> j2118566256;
	j2514191131 [label="Nous avons tous des problèmes à régler. C'est difficile de le faire seul.",shape=box,color=red];
		j2514191131 -> j2118566256;
	j3929996647 [label="Nous attendons simplement que tu te sentes à l'aise avec nous.",shape=box,color=red];
		j3929996647 -> j1622547034;
	j933960310 [label="Comment pourrait-il en être autrement? ",shape=box,color=red];
		j933960310 -> j1622547034;
	j2118566256 [label="MDR Ça ressemble à un slogan de sororité.",shape=box,color=blue];
		j2118566256 -> j1216761879;
		j2118566256 -> j1601686224;
	j1622547034 [label="Je... je vois.",shape=box,color=blue];
		j1622547034 -> j2292283515;
	j1216761879 [label="Qu'est-ce qu'un \"slogan de sororité\" exactement?",shape=box,color=red];
		j1216761879 -> j1832071651;
	j1601686224 [label="Une sororité? Qu'est-ce que c'est?",shape=box,color=red];
		j1601686224 -> j1832071651;
	j1832071651 [label="MDR Sérieux? Je dois vraiment aller dans le futur s'il n'y a rien de tout ça là-bas. Putain.",shape=box,color=blue];
		j1832071651 -> j1169628022;
	j1169628022 [label="Je ne suis pas...",shape=box,color=red];
		j1169628022 -> j2973788197;
	j2973788197 [label="À l'université, un groupe de filles se disent sœurs et pensent que cela signifie quelque chose. Comme un \"club\", j'imagine. ",shape=box,color=blue];
		j2973788197 -> j3821023682;
	j3821023682 [label="Oh, peut-être comme \"Les Sœurs de Parvos\"?",shape=box,color=red];
		j3821023682 -> j3712490534;
	j3712490534 [label="Ça a l'air nul. Pouah. J'espère vraiment que ce n'est pas une vraie sororité.",shape=box,color=blue];
		j3712490534 -> j3691758221;
	j3691758221 [label="Eh bien, elles essaient de me tuer. Souvent.",shape=box,color=red];
		j3691758221 -> j2724425187;
	j2724425187 [label="J'ai l'impression que les miennes ont essayé de me tuer aussi...",shape=box,color=blue];
		j2724425187 -> j2292283515;
}