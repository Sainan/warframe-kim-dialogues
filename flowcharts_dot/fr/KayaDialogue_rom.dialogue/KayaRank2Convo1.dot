	192 [label="Check boolean KayaSetKid",color=orange];
		192 -> 200 [label=true,color=green];
		192 -> 199 [label=false,color=brown];
	193 [label="Pfff. C'est pas drôle. ",shape=box,color=blue];
		193 -> 201;
	194 [label="J'ai fait une erreur stupide. Une fois. ",shape=box,color=blue];
		194 -> 202;
