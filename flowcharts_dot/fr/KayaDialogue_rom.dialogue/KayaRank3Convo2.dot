digraph {
	"KayaRank3Convo2 begins." [color=orange];
		"KayaRank3Convo2 begins." -> j4175013251;
	j4175013251 [label="Tu sembles vraiment fascinée par le \"voyage dans le temps\". En fait, tu es même obsédée par ce sujet.",shape=box,color=red];
		j4175013251 -> j1182146330;
	j1182146330 [label="J'y travaille. J'y suis presque.",shape=box,color=blue];
		j1182146330 -> j1074041124;
	j1074041124 [label="Une fois que tu auras compris le voyage dans le temps, il y aura un problème plus important: l'Éternalisme. ",shape=box,color=red];
		j1074041124 -> j1860292055;
	j1860292055 [label="Euh... quoi?",shape=box,color=blue];
		j1860292055 -> j2691640029;
		j1860292055 -> j4222851941;
	j2691640029 [label="Voyons si tu es assez intelligente pour comprendre cela. Grâce à l'éternalisme, il existe une version de cette conversation qui ne s'arrête pas là. [Fin.]",shape=box,color=red];
		j2691640029 -> j3655577789;
	j4222851941 [label="J'espère que tu n'es pas occupée, car c'est la vraie raison pour laquelle je suis ici.",shape=box,color=red];
		j4222851941 -> j1450125216;
	j3655577789 [label="Boolean KayaEternalismTest is now true.",color=orange];
		j3655577789 -> j2156753723;
	j1450125216 [label="Je ne suis pas occupée, explique-moi. Cela pourrait être incroyablement pertinent pour les dernières touches théoriques sur la manipulation temporelle.",shape=box,color=blue];
		j1450125216 -> j400743581;
	j2156753723 [label="+20 Chemistry",color=orange];
		j2156753723 -> "Chat ends. Next chat will be KayaRank3Convo3.";
	j400743581 [label="Tout cela n’est pas arrivé parce qu’un scientifique a trouvé une formule.",shape=box,color=red];
		j400743581 -> j2487063970;
	"Chat ends. Next chat will be KayaRank3Convo3." [color=orange];
	j2487063970 [label="Euh bon, je suppose que c'est comme ça que ça a commencé.",shape=box,color=red];
		j2487063970 -> j2278422475;
	j2278422475 [label="Mais tout ça maintenant? Ça va au-delà. C'est parce qu'Albrecht est allé quelque part, a réveillé quelque chose, et cela l'a suivi. Le Néant.",shape=box,color=red];
		j2278422475 -> j2196982646;
		j2278422475 -> j1137656127;
	j2196982646 [label="Le Néant est à la fois vivant et non vivant. Il est mais il n'est pas. C'est un paradoxe à la fois cause et raison de tout ce qui est arrivé à chacun d'entre nous.",shape=box,color=red];
		j2196982646 -> j1075091001;
	j1137656127 [label="Il n’existe pas de \"tableau périodique\" ni de formule pour décrire ce que c’est.",shape=box,color=red];
		j1137656127 -> j3569478049;
	j1075091001 [label="Bonjour le monde.",shape=box,color=blue];
		j1075091001 -> j3809243594;
		j1075091001 -> j2546764548;
	j3569478049 [label="La science peut l'expliquer. Elle régit tout.",shape=box,color=blue];
		j3569478049 -> j3668359530;
	j3809243594 [label="\"Au revoir Albrecht\"",shape=box,color=red];
		j3809243594 -> j2692661949;
	j2546764548 [label="Hein?",shape=box,color=red];
		j2546764548 -> j1338873390;
	j3668359530 [label="Check boolean KayaVoidTest",color=orange];
		j3668359530 -> j928759541 [label=true,color=green];
		j3668359530 -> j4277969893 [label=false,color=brown];
	j2692661949 [label="+5 Chemistry",color=orange];
		j2692661949 -> j2181666967;
	j1338873390 [label="Ce fut la première chose JAMAIS publiée sur Internet. Le premier message. Publié par le créateur d'Internet pour montrer que cela \"fonctionnait\".",shape=box,color=blue];
		j1338873390 -> j3751229263;
	j928759541 [label="Je t'ai dit d'être prudente avec le Néant. Voilà pourquoi.",shape=box,color=red];
		j928759541 -> j2132745397;
	j4277969893 [label="Et si elle ne le pouvait pas?",shape=box,color=red];
		j4277969893 -> j1579822643;
	j2181666967 [label="Ha! Si seulement, lol. Mais tu connais \"Bonjour le monde\"?",shape=box,color=blue];
		j2181666967 -> j1338873390;
	j3751229263 [label="Et à partir de là, l'enfer s'est déchaîné. Les gens ont perdu la tête. La science. La banque. La technologie. Le divertissement.",shape=box,color=blue];
		j3751229263 -> j2421354451;
	j2132745397 [label="Certaines choses ne peuvent pas être régies.",shape=box,color=red];
		j2132745397 -> j2825633423;
	j1579822643 [label="Et si tout cela était une règle stricte...",shape=box,color=red];
		j1579822643 -> j776091759;
	j2421354451 [label="Et à travers des milliards de choix, de causes et d'effets, cela m'a amenée à aller en ligne un jour et... ",shape=box,color=blue];
		j2421354451 -> j356632151;
	j2825633423 [label="Certaines choses ne peuvent pas être expliquées.",shape=box,color=red];
		j2825633423 -> j3233810935;
	j776091759 [label="Cela se serait alors produit uniquement parce que quelque chose le voulait.",shape=box,color=red];
		j776091759 -> j3233810935;
	j356632151 [label="Et ce fut la fin de Nova, ou plutôt de Kaya. Son avenir, sa carrière, ses amis, tout. À cause d'une erreur. ",shape=box,color=blue];
		j356632151 -> j705623357;
	j3233810935 [label="Donc, tu dis que la partie manquante de mes expériences, tests, recherches et hypothèses est la \"magie\".",shape=box,color=blue];
		j3233810935 -> j3218008371;
		j3233810935 -> j3052820439;
	j705623357 [label="Donc, je suppose que je fais plus confiance au Néant qu'aux autres personnes.",shape=box,color=blue];
		j705623357 -> j1586544827;
		j705623357 -> j3531658947;
		j705623357 -> j456441230;
	j3218008371 [label="Pas de la magie. Juste... le Néant. Le Néant. Une énergie venue d'ailleurs.",shape=box,color=red];
		j3218008371 -> j3428656315;
	j3052820439 [label="As-tu vu ce qu'il peut faire? ",shape=box,color=red];
		j3052820439 -> j2976060644;
	j1586544827 [label="Tu te trompes. [Fin].",shape=box,color=red];
		j1586544827 -> j2156753723;
	j3531658947 [label="Voilà qui est pessimiste, Nova.",shape=box,color=red];
		j3531658947 -> j2034729475;
	j456441230 [label="Moi aussi, je lui ai fait confiance.",shape=box,color=red];
		j456441230 -> j2034729475;
	j3428656315 [label="Je peux travailler avec ça.",shape=box,color=blue];
		j3428656315 -> j715113156;
		j3428656315 -> j4119650224;
	j2976060644 [label="Vu. Observé. Noté. Étudié. Réétudié. Mhmm. Tout peut s'expliquer. Cela a sa source dans quelque chose. La \"magie\", peut-être.",shape=box,color=blue];
		j2976060644 -> j3428656315;
	j2034729475 [label="Je suppose que tu n'as peut-être pas tout compris. ",shape=box,color=blue];
		j2034729475 -> j1103281211;
	j715113156 [label="Tenter quelque chose d’irréfléchi pourrait te coûter cher.",shape=box,color=red];
		j715113156 -> j2034729475;
	j4119650224 [label="Tu peux \"travailler avec ça\"?",shape=box,color=red];
		j4119650224 -> j2034729475;
	j1103281211 [label="Mais je partirai de 1999.",shape=box,color=blue];
		j1103281211 -> j430509749;
	j430509749 [label="Je me fiche littéralement de ce qui m'arrivera en essayant d'y parvenir.",shape=box,color=blue];
		j430509749 -> j2976958545;
	j2976958545 [label="C'est la seule chose qui occupe mon cerveau.",shape=box,color=blue];
		j2976958545 -> j3205800330;
	j3205800330 [label="Et pour moi, c'est une bonne chose. ",shape=box,color=blue];
		j3205800330 -> j2156753723;
}