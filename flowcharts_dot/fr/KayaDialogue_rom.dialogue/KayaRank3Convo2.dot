digraph {
	460 [label="KayaRank3Convo2 begins.",color=orange];
		460 -> 461;
	461 [label="Tu sembles vraiment fascinée par le \"voyage dans le temps\". En fait, tu es même obsédée par ce sujet.",shape=box,color=red];
		461 -> 462;
	462 [label="J'y travaille. J'y suis presque.",shape=box,color=blue];
		462 -> 463;
	463 [label="Une fois que tu auras compris le voyage dans le temps, il y aura un problème plus important: l'Éternalisme. ",shape=box,color=red];
		463 -> 464;
	464 [label="Euh... quoi?",shape=box,color=blue];
		464 -> 465;
		464 -> 466;
	465 [label="Voyons si tu es assez intelligente pour comprendre cela. Grâce à l'éternalisme, il existe une version de cette conversation qui ne s'arrête pas là. [Fin.]",shape=box,color=red];
		465 -> 467;
	466 [label="J'espère que tu n'es pas occupée, car c'est la vraie raison pour laquelle je suis ici.",shape=box,color=red];
		466 -> 468;
	467 [label="Update boolean KayaEternalismTest",color=orange];
		467 -> 469;
	468 [label="Je ne suis pas occupée, explique-moi. Cela pourrait être incroyablement pertinent pour les dernières touches théoriques sur la manipulation temporelle.",shape=box,color=blue];
		468 -> 470;
	469 [label="+20 Chemistry",color=orange];
		469 -> 471;
	470 [label="Tout cela n’est pas arrivé parce qu’un scientifique a trouvé une formule.",shape=box,color=red];
		470 -> 472;
	471 [label="Chat ends. Next chat will be KayaRank3Convo3.",color=orange];
	472 [label="Euh bon, je suppose que c'est comme ça que ça a commencé.",shape=box,color=red];
		472 -> 473;
	473 [label="Mais tout ça maintenant? Ça va au-delà. C'est parce qu'Albrecht est allé quelque part, a réveillé quelque chose, et cela l'a suivi. Le Néant.",shape=box,color=red];
		473 -> 474;
		473 -> 475;
	474 [label="Le Néant est à la fois vivant et non vivant. Il est mais il n'est pas. C'est un paradoxe à la fois cause et raison de tout ce qui est arrivé à chacun d'entre nous.",shape=box,color=red];
		474 -> 476;
	475 [label="Il n’existe pas de \"tableau périodique\" ni de formule pour décrire ce que c’est.",shape=box,color=red];
		475 -> 477;
	476 [label="Bonjour le monde.",shape=box,color=blue];
		476 -> 478;
		476 -> 479;
	477 [label="La science peut l'expliquer. Elle régit tout.",shape=box,color=blue];
		477 -> 480;
	478 [label="\"Au revoir Albrecht\"",shape=box,color=red];
		478 -> 481;
	479 [label="Hein?",shape=box,color=red];
		479 -> 482;
	480 [label="Check boolean KayaVoidTest",color=orange];
		480 -> 484 [label=true,color=green];
		480 -> 483 [label=false,color=brown];
	481 [label="+5 Chemistry",color=orange];
		481 -> 485;
	482 [label="Ce fut la première chose JAMAIS publiée sur Internet. Le premier message. Publié par le créateur d'Internet pour montrer que cela \"fonctionnait\".",shape=box,color=blue];
		482 -> 486;
	484 [label="Je t'ai dit d'être prudente avec le Néant. Voilà pourquoi.",shape=box,color=red];
		484 -> 488;
	483 [label="Et si elle ne le pouvait pas?",shape=box,color=red];
		483 -> 487;
	485 [label="Ha! Si seulement, lol. Mais tu connais \"Bonjour le monde\"?",shape=box,color=blue];
		485 -> 482;
	486 [label="Et à partir de là, l'enfer s'est déchaîné. Les gens ont perdu la tête. La science. La banque. La technologie. Le divertissement.",shape=box,color=blue];
		486 -> 489;
	488 [label="Certaines choses ne peuvent pas être régies.",shape=box,color=red];
		488 -> 491;
	487 [label="Et si tout cela était une règle stricte...",shape=box,color=red];
		487 -> 490;
	489 [label="Et à travers des milliards de choix, de causes et d'effets, cela m'a amenée à aller en ligne un jour et... ",shape=box,color=blue];
		489 -> 492;
	491 [label="Certaines choses ne peuvent pas être expliquées.",shape=box,color=red];
		491 -> 493;
	490 [label="Cela se serait alors produit uniquement parce que quelque chose le voulait.",shape=box,color=red];
		490 -> 493;
	492 [label="Et ce fut la fin de Nova, ou plutôt de Kaya. Son avenir, sa carrière, ses amis, tout. À cause d'une erreur. ",shape=box,color=blue];
		492 -> 494;
	493 [label="Donc, tu dis que la partie manquante de mes expériences, tests, recherches et hypothèses est la \"magie\".",shape=box,color=blue];
		493 -> 495;
		493 -> 496;
	494 [label="Donc, je suppose que je fais plus confiance au Néant qu'aux autres personnes.",shape=box,color=blue];
		494 -> 497;
		494 -> 498;
		494 -> 499;
	495 [label="Pas de la magie. Juste... le Néant. Le Néant. Une énergie venue d'ailleurs.",shape=box,color=red];
		495 -> 500;
	496 [label="As-tu vu ce qu'il peut faire? ",shape=box,color=red];
		496 -> 501;
	497 [label="Tu te trompes. [Fin].",shape=box,color=red];
		497 -> 502;
	498 [label="Voilà qui est pessimiste, Nova.",shape=box,color=red];
		498 -> 503;
	499 [label="Moi aussi, je lui ai fait confiance.",shape=box,color=red];
		499 -> 503;
	500 [label="Je peux travailler avec ça.",shape=box,color=blue];
		500 -> 504;
		500 -> 505;
	501 [label="Vu. Observé. Noté. Étudié. Réétudié. Mhmm. Tout peut s'expliquer. Cela a sa source dans quelque chose. La \"magie\", peut-être.",shape=box,color=blue];
		501 -> 506;
	502 [label="+20 Chemistry",color=orange];
		502 -> 507;
	503 [label="Je pense que tu n'as peut-être pas tout compris. ",shape=box,color=blue];
		503 -> 508;
	504 [label="Tenter quelque chose d’irréfléchi pourrait te coûter cher.",shape=box,color=red];
		504 -> 503;
	505 [label="Tu peux \"travailler avec ça\"?",shape=box,color=red];
		505 -> 503;
	506 [label="Je peux travailler avec ça.",shape=box,color=blue];
		506 -> 504;
		506 -> 505;
	507 [label="Chat ends. Next chat will be KayaRank3Convo3.",color=orange];
	508 [label="Mais je partirai de 1999.",shape=box,color=blue];
		508 -> 509;
	509 [label="Je me fiche littéralement de ce qui m'arrivera en essayant d'y parvenir.",shape=box,color=blue];
		509 -> 510;
	510 [label="C'est la seule chose qui occupe mon cerveau.",shape=box,color=blue];
		510 -> 511;
	511 [label="Et pour moi, c'est une bonne chose. ",shape=box,color=blue];
		511 -> 512;
	512 [label="+20 Chemistry",color=orange];
		512 -> 513;
	513 [label="Chat ends. Next chat will be KayaRank3Convo3.",color=orange];
