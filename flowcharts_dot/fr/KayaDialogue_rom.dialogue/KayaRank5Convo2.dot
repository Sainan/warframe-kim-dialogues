	873 [label="Être populaire, c'est vraiment important?",shape=box,color=red];
		873 -> 876;
	877 [label="Chat ends. Next chat will be KayaRank5Convo3.",color=orange];
	875 [label="Tout le monde est cruel.",shape=box,color=blue];
		875 -> 878;
	876 [label="C'était le cas... jusqu'à ce que tout cela arrive. J'ai l'impression d'être une meilleure personne après toute cette merde, comme si j'étais celle que j'aurais vraiment dû être pendant tout ce temps.",shape=box,color=blue];
		876 -> 879;
	878 [label="Tout le monde veut être l’enfant cool.",shape=box,color=blue];
		878 -> 880;
	879 [label="Je ne me soucie plus de ce que les gens pensent de moi. Je peux enfin vivre ma vie.",shape=box,color=blue];
		879 -> 881;
	880 [label="Mais maintenant, j'ai réalisé que c'était bien plus cool de ne pas se soucier d'être cool. C'est pour ça qu'on est si cool.",shape=box,color=blue];
