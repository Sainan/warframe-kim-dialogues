digraph {
	819 [label="KayaRank5Convo2 begins.",color=orange];
		819 -> 820;
	820 [label="Et si c'était moi qui te posais une question sur le voyage dans le temps, cette fois-ci?",shape=box,color=red];
		820 -> 821;
	821 [label="Non. Parlons d'autre chose, en fait! Ok?",shape=box,color=blue];
		821 -> 822;
	822 [label="Check boolean KayaPromiseRegret",color=orange];
		822 -> 824 [label=true,color=green];
		822 -> 825 [label=false,color=brown];
		822 -> 823 [label=false,color=brown];
	824 [label="Comme mon plus grand regret?",shape=box,color=red];
		824 -> 827;
	825 [label="Comme quoi? À toi de choisir.",shape=box,color=red];
		825 -> 828;
	823 [label="Que dirais-tu de... Kalymos?",shape=box,color=red];
		823 -> 826;
	827 [label="Hmm, ok, ouais, bien sûr. Qu'est-ce que c'est? ",shape=box,color=blue];
		827 -> 832;
		827 -> 833;
		827 -> 834;
	828 [label="Euh, disons... mon premier animal domestique? ",shape=box,color=blue];
		828 -> 835;
	826 [label=" Ouais, ouais, ça me va, mais je suis plutôt une fille à chien. J'en avais un. J'aimerais pouvoir le revoir.",shape=box,color=blue];
		826 -> 829;
		826 -> 830;
		826 -> 831;
	832 [label="Ne pas avoir exigé plus d'Albrecht.",shape=box,color=red];
		832 -> 838;
	833 [label="Ne pas avoir arrêté Ballas plus tôt.",shape=box,color=red];
		833 -> 839;
	834 [label="Avoir baissé les bras.",shape=box,color=red];
		834 -> 840;
	835 [label="Même si c'est généralement l'une de ces questions posées par les pirates informatiques sur Internet, alors ne le dis à personne.",shape=box,color=blue];
		835 -> 841;
	829 [label="Je compatis. Il vaut mieux s'arrêter ici [Fin.]",shape=box,color=red];
		829 -> 836;
	830 [label="Ça me fait de la peine d'entendre ça, parle-moi de lui.",shape=box,color=red];
		830 -> 837;
	831 [label="Moi aussi, j'ai perdu un animal. Comment s'appelait-il?",shape=box,color=red];
		831 -> 837;
	838 [label="Même après tout ça, je l'ai laissé filer.",shape=box,color=red];
		838 -> 844;
	839 [label="Je ne sais pas comment j'aurais pu changer les choses.",shape=box,color=red];
		839 -> 845;
	840 [label="Peu importe l'image que les autres ont de moi. Il fut un temps où personne ne me détestait plus que moi-même.",shape=box,color=red];
		840 -> 846;
	841 [label="Mais il s'appelait Zylo. On pourrait dire que c'était un Kubrow, je crois.",shape=box,color=blue];
		841 -> 847;
	836 [label="+20 Chemistry",color=orange];
		836 -> 842;
	837 [label="C'est un peu injuste en fait. Entrati peut voyager dans le temps avec son étrange félin?",shape=box,color=blue];
		837 -> 843;
	844 [label="Je sais qu'il pense m'apprendre quelque chose, mais ce connard ne réalise même pas ce qu'il m'a fait subir.",shape=box,color=red];
		844 -> 849;
	845 [label="Mais je sais que si j'avais été ne serait-ce qu'une minute plus rapide, quelqu'un aurait moins souffert.",shape=box,color=red];
		845 -> 850;
	846 [label="Je ne pouvais même pas MOURIR. Et j'aurais aimé pouvoir le faire. ",shape=box,color=red];
		846 -> 851;
	847 [label="ÉNORME, comme le plus gros chien que tu puisses imaginer. Je parie qu'il pourrait couper M. Volkov en deux d'un coup de mâchoires.",shape=box,color=blue];
		847 -> 852;
		847 -> 853;
	842 [label="Chat ends. Next chat will be KayaRank5Convo3.",color=orange];
	843 [label="Si j'avais Zylo avec moi... ce voyage serait beaucoup plus facile.",shape=box,color=blue];
		843 -> 848;
	849 [label="Et pas seulement moi. Nous tous. Et Loid, Gomaitru... c'est écœurant. Je ne sais pas si je pourrai me retenir si je le recroise.",shape=box,color=red];
		849 -> 851;
	850 [label="Ballas est tout ce que je crains. Il représente le pire du pire. ",shape=box,color=red];
		850 -> 851;
	851 [label="Quand tu le dis comme ça... J'imagine que la vie et les gens sont parfois un peu nuls, n'est-ce pas?",shape=box,color=blue];
		851 -> 855;
	852 [label="Nous avons encore de gros Kubrows, là d'où je viens! ",shape=box,color=red];
		852 -> 856;
	853 [label="Euh, je ne sais pas, M. Volkov est plutôt coriace.",shape=box,color=red];
		853 -> 857;
	848 [label="Zylo a été le premier être vivant à me voir pleurer, tu sais. ",shape=box,color=blue];
		848 -> 854;
	855 [label="Mais parfois, c'est tellement génial.",shape=box,color=blue];
		855 -> 859;
	856 [label="Oh mon Dieu... une raison de plus pour que j'y ARRIVE. Waouh!",shape=box,color=blue];
		856 -> 860;
	857 [label="En fait, tu as peut-être raison... mais bon, ce grand et effrayant Zylo... il était farouchement protecteur envers moi.",shape=box,color=blue];
		857 -> 848;
	854 [label="J’avais environ 5 ans et, aussi loin que je me souvienne, j’avais toujours refusé de pleurer.",shape=box,color=blue];
		854 -> 858;
	859 [label="Je suppose que nous ne pouvons pas nous définir par notre plus grand regret. J'ai l'impression que tu m'as aidée à surmonter le mien.",shape=box,color=blue];
		859 -> 862;
	860 [label="Mon Zylo était farouchement protecteur avec moi. ",shape=box,color=blue];
		860 -> 848;
	858 [label="Mais je suis rentrée à la maison après mon premier jour d'école en première année et Zylo était là.",shape=box,color=blue];
		858 -> 861;
	862 [label="Mais je ne changerais rien au fait que cela soit arrivé. ",shape=box,color=blue];
		862 -> 865;
	861 [label="Et il m'a suivie dans ma chambre et a gardé la porte pendant que je sanglotais.",shape=box,color=blue];
		861 -> 863;
		861 -> 864;
	865 [label="Parce que je ne déteste pas ça, finalement. Nova? C'est en quelque sorte la chose la plus cool qui soit.",shape=box,color=blue];
		865 -> 868;
	863 [label="Qu'est-ce qui t'avait mise dans cet état?",shape=box,color=red];
		863 -> 866;
	864 [label="Comment te souviens-tu de ça?",shape=box,color=red];
		864 -> 867;
	868 [label="Tu ne changerais rien?",shape=box,color=red];
		868 -> 871;
	866 [label="Quelqu'un m'a traitée de grosse.",shape=box,color=blue];
		866 -> 869;
	867 [label="Comment pourrais-je oublier?!",shape=box,color=blue];
		867 -> 870;
	871 [label="Rien du tout. Et j'espère que toi non plus.",shape=box,color=blue];
		871 -> 874;
	869 [label="C'est ce qui rendait les enfants impopulaires quand j'étais petite.",shape=box,color=blue];
		869 -> 872;
