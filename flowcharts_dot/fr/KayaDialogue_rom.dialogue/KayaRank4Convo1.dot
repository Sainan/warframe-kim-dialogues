digraph {
	"KayaRank4Convo1 begins." [color=orange];
		"KayaRank4Convo1 begins." -> j1699144641;
	j1699144641 [label="Tu veux savoir à quoi ça ressemble? Internet apparaît et nous promet tant de choses.",shape=box,color=blue];
		j1699144641 -> j1323988180;
	j1323988180 [label="Alors, imagine que tu es moi. Tu as 18 ans. Tu te connectes. Tu commences à discuter avec de nouveaux amis de PARTOUT!",shape=box,color=blue];
		j1323988180 -> j520433334;
	j520433334 [label="Et pour une soi-disant \"fille intelligente\" comme moi, tu fais la chose la plus stupide qui soit sur Internet. ",shape=box,color=blue];
		j520433334 -> j318720447;
	j318720447 [label="Tu fais confiance à la personne de l’autre côté de l'écran. ",shape=box,color=blue];
		j318720447 -> j3866935133;
	j3866935133 [label="Et toutes ces nouvelles technologies t'émerveillent et tu oublies que les gens sont toujours des gens. ",shape=box,color=blue];
		j3866935133 -> j4021711765;
	j4021711765 [label="Alors, tu envoies une photo de toi nue qui ferait rougir Lua. Tu penses avoir un lien avec quelqu'un que tu as rencontré sur Internet. Tu peux faire confiance à ton petit ami en ligne. ",shape=box,color=blue];
		j4021711765 -> j2313128970;
	j2313128970 [label="Et le lendemain, cette photo est partout. Tout le monde sur le campus l'a vue. Elle a été partagée. Elle a été envoyée à tes PROFESSEURS. Partout sur INTERNET. Dans des pays dont je ne connaissais même pas l'existence.",shape=box,color=blue];
		j2313128970 -> j3723757434;
	j3723757434 [label="J'aurais pu être la personne la plus intelligente de cette planète, mais tout le monde se souviendra de moi à cause de cette photo.",shape=box,color=blue];
		j3723757434 -> j3994445417;
	j3994445417 [label="Alors, quand je dis que je vais partir d'ici, je le pense vraiment. Je sais que cette photo ne veut RIEN dire, le futur a évolué, les gens sont passés à autre chose.",shape=box,color=blue];
		j3994445417 -> j1076392184;
	j1076392184 [label="Mais ça a ruiné ma vie. Je veux vivre dans un futur sans Internet. Je veux prouver que je peux aller de l'avant. Revenir au passé leur donne raison, je ne peux pas passer à autre chose.",shape=box,color=blue];
		j1076392184 -> j3770748059;
	j3770748059 [label="Alors, attends un peu. Tu me reverras là d'où tu viens. ",shape=box,color=blue];
		j3770748059 -> j3260975367;
	j3260975367 [label="Et nous pourrons regarder le monde et rire en pensant que mes choix ne m'ont pas détruite. Tout cela m'a simplement rendu plus intelligente. Assez intelligente pour m'en sortir.",shape=box,color=blue];
		j3260975367 -> j3258508148;
	j3258508148 [label="+20 Chemistry",color=orange];
		j3258508148 -> "Chat ends. Next chat will be KayaRank4Convo2.";
	"Chat ends. Next chat will be KayaRank4Convo2." [color=orange];
}