		j2067832833 -> j1160243279;
	j465934596 [label="+20 Chemistry",color=orange];
		j465934596 -> "Chat ends. Next chat will be KayaRank4Convo4.";
	j3616644830 [label="Euhh, repose-moi la question demain?",shape=box,color=blue];
		j3616644830 -> j546252562;
	j1160243279 [label="Je sais que nous ne sommes plus à l'école. ",shape=box,color=blue];
		j1160243279 -> j270807645;
	"Chat ends. Next chat will be KayaRank4Convo4." [color=orange];
	j546252562 [label="Je pourrais être vraiment proche, vraiment tenir quelque chose.",shape=box,color=blue];
		j546252562 -> j1096092623;
		j546252562 -> j316247369;
	j270807645 [label="Mais il n'est pas nécessaire d'être un génie pour voir que tu te soucies vraiment de nous. Et nous te respectons tous.",shape=box,color=blue];
		j270807645 -> j2308133586;
	j1096092623 [label="Tu es sur le point d'échapper à 1999?",shape=box,color=red];
		j1096092623 -> j1026888715;
	j316247369 [label="Quelle est la piste actuelle?",shape=box,color=red];
		j316247369 -> j1883911456;
	j2308133586 [label="Même Arthur. Et je dois dire qu'il me plaît beaucoup, oh mon Dieu.",shape=box,color=blue];
		j2308133586 -> j1211137507;
	j1026888715 [label="Oui! Il y a bien sûr quelques réserves. Le chemin le plus sûr est d'aller EXACTEMENT là d'où tu viens, car il y a une sorte \"d'empreinte digitale du Néant\" à cet endroit.",shape=box,color=blue];
		j1026888715 -> j3074914039;
		j1026888715 -> j2131626401;
		j1026888715 -> j1330978570;
	j1883911456 [label="Toi, bien sûr.",shape=box,color=blue];
		j1883911456 -> j615771825;
		j1883911456 -> j3715762784;
	j1211137507 [label="Check boolean ArthurDating",color=orange];
		j1211137507 -> j738516448 [label=true,color=green];
		j1211137507 -> j4215538413 [label=false,color=brown];
		j1211137507 -> j3124782539 [label=false,color=brown];
	j3074914039 [label="Alors, tu es toujours décidée?",shape=box,color=red];
		j3074914039 -> j3857519409;
	j2131626401 [label="Mon époque n'est pas vraiment meilleure, mais au moins je suis là pour aider.",shape=box,color=red];
		j2131626401 -> j823024118;
	j1330978570 [label="Hmm, le Néant prend en fait les empreintes assez au sérieux.",shape=box,color=red];
		j1330978570 -> j2734805048;
	j615771825 [label="Je dois avoir un truc spécial.",shape=box,color=red];
		j615771825 -> j1026888715;
	j3715762784 [label="Moi?",shape=box,color=red];
		j3715762784 -> j1026888715;
	j738516448 [label="Tu sais qu'il est pris, n'est-ce pas?",shape=box,color=red];
		j738516448 -> j628376262;
	j4215538413 [label="Je parlerai pour toi.",shape=box,color=red];
		j4215538413 -> j2311554896;
	j3124782539 [label="Berk.",shape=box,color=red];
		j3124782539 -> j4154101537;
	j3857519409 [label="Bien sûr. C'est un défi. Ce qui doit arriver arrivera, n'est-ce pas? Et ça me tient occupée, concentrée... ",shape=box,color=blue];
		j3857519409 -> j2078604812;
	j823024118 [label="Exactement! Brûlons les navires! Pas de retour en arrière!",shape=box,color=blue];
		j823024118 -> j465934596;
	j2734805048 [label="Hein?",shape=box,color=blue];
		j2734805048 -> j3594412569;
	j628376262 [label="Pfft je sais, pas de CHANCE! Bref",shape=box,color=blue];
		j628376262 -> j3982605944;
	j2311554896 [label="PFFT NON, s'il te plaît, ne le fais pas, je te l'ai dit comme une CONFIDENCE! Bref...",shape=box,color=blue];
		j2311554896 -> j3982605944;
	j4154101537 [label="Euh, tu es dingue? Pas berk du tout. BREF!",shape=box,color=blue];
		j4154101537 -> j3982605944;
	j2078604812 [label="Il n'y a que du positif. Soit je trouve, soit je ne trouve pas. On se voit ici, ou on se voit là-bas. Pas vrai? À plus tard!",shape=box,color=blue];
		j2078604812 -> j465934596;
	j3594412569 [label="Tout cela, tout ce qu'Entrati a fait. Sa quête du Néant, l'essence de... tout cela.",shape=box,color=red];
		j3594412569 -> j2765675377;
	j3982605944 [label="Mais d'une certaine manière, c'est comme le lycée où tout le monde t'aime.",shape=box,color=blue];
		j3982605944 -> j3110441126;
	j2765675377 [label="Cela se résume à un doigt. Un doigt.",shape=box,color=red];
		j2765675377 -> j3036881715;
	j3110441126 [label="Et cela en dit long sur quelque chose de plus profond que la simple popularité.",shape=box,color=blue];
		j3110441126 -> j87428204;
	j3036881715 [label="Tu as flingué les bières d'Arthur? Pourquoi ne l'as-tu pas mentionné plus tôt?",shape=box,color=blue];
		j3036881715 -> j3714974852;
		j3036881715 -> j78885778;
		j3036881715 -> j1801188950;
	j87428204 [label="Nous sommes tous complètement paumés.",shape=box,color=blue];
		j87428204 -> j822017509;
		j87428204 -> j3762873100;
		j87428204 -> j921767333;
	j3714974852 [label="Le Néant. Les manuels ne sont pas d'une grande utilité sur ce sujet.",shape=box,color=red];
		j3714974852 -> j826986949;
	j78885778 [label="Une bière aiderait probablement à tirer les choses au clair.",shape=box,color=red];
		j78885778 -> j826986949;
	j1801188950 [label="Ce n'est pas quelque chose qu'on \"mentionne\" simplement. C'est à la fois la fin et le début.",shape=box,color=red];
		j1801188950 -> j826986949;
	j822017509 [label="Paumés et occupés! Bienvenue dans l'équipe [Fin.]",shape=box,color=red];
		j822017509 -> j465934596;
	j3762873100 [label="Qui est le plus paumé, selon toi?",shape=box,color=red];
		j3762873100 -> j3889236073;
	j921767333 [label="C'est un compliment?",shape=box,color=red];
		j921767333 -> j2370267613;
	j826986949 [label="Mais qu'est-ce que tu veux dire par un doigt?",shape=box,color=blue];
		j826986949 -> j1274209263;
		j826986949 -> j841835550;
	j3889236073 [label="Oh là... des ragots? Après ce que je viens de dire? ",shape=box,color=blue];
		j3889236073 -> j1309820389;
	j2370267613 [label="Tout à fait. À 100 pour cent. Parce que personne ici n'est en compétition.",shape=box,color=blue];
		j2370267613 -> j4250926273;
	j1274209263 [label="Albrecht a son doigt.",shape=box,color=red];
		j1274209263 -> j2200645004;
	j841835550 [label="Il y a un doigt de... ça. De mon temps. De notre monde, je suppose.",shape=box,color=red];
		j841835550 -> j2200645004;
	j1309820389 [label="(Mais je dirais Arthur parce que je lui ai parlé et j'ai l'impression que tu lui as vraiment retourné la tête).",shape=box,color=blue];
		j1309820389 -> j2947360280;
	j4250926273 [label="C'est vraiment bizarre. On se transforme en monstre, mais c'est la sensation la plus humaine que j'ai jamais ressentie.",shape=box,color=blue];
		j4250926273 -> j909530539;
	j2200645004 [label="Ok, donc la matière est retenue, merci!",shape=box,color=blue];
		j2200645004 -> j635942710;
	j2947360280 [label="Ce qui, soit dit en passant, a confirmé une hypothèse que j'avais sur votre lien corporel en 1999.",shape=box,color=blue];
		j2947360280 -> j3734042997;
	j909530539 [label="Je peux enfin être moi-même, maintenant.",shape=box,color=blue];
		j909530539 -> j2371615459;
	j635942710 [label="C'est tout?",shape=box,color=red];
		j635942710 -> j2254026409;
	j3734042997 [label="Ce qui est pertinent parce que... ah! Test effectué. À bientôt.",shape=box,color=blue];
		j3734042997 -> j465934596;
	j2371615459 [label="Je n'ai plus peur.",shape=box,color=blue];
		j2371615459 -> j2941283468;
	j2254026409 [label="Même pas un \"qu'est-ce que c'est?\" ou \"Pourquoi ce doigt?\"",shape=box,color=red];
		j2254026409 -> j59062262;
	j2941283468 [label="Alors, merci?",shape=box,color=blue];
		j2941283468 -> j465934596;
	j59062262 [label="Tu peux t'en occuper. Les états de préservation de la matière sont plus intéressants. Merci!",shape=box,color=blue];
		j59062262 -> j465934596;
}