digraph {
	"KayaRank5Convo1 begins." [color=orange];
		"KayaRank5Convo1 begins." -> j940865426;
	j940865426 [label="Je n'arrête pas de trouver ces choses violettes, mais elles disparaissent le lendemain.",shape=box,color=blue];
		j940865426 -> j2423771205;
	j2423771205 [label="Et je pense qu’il y a quelque chose d'intéressant au niveau de leur déclin.",shape=box,color=blue];
		j2423771205 -> j1261653098;
	j1261653098 [label="Parce que la matière ne se transforme pas simplement en un état de désintégration d’un nouvel isotope.",shape=box,color=blue];
		j1261653098 -> j3109544612;
	j3109544612 [label="En fait, ça disparaît d'ICI.",shape=box,color=blue];
		j3109544612 -> j184799838;
		j3109544612 -> j3998061101;
	j184799838 [label="Tu veux dire des Cryotiques?",shape=box,color=red];
		j184799838 -> j4191335989;
	j3998061101 [label="Tu veux dire des Cristaux d'Argon? ",shape=box,color=red];
		j3998061101 -> j2857292620;
	j4191335989 [label="Mmm non, pas ça.",shape=box,color=blue];
		j4191335989 -> j3998061101;
		j4191335989 -> j2096289168;
	j2857292620 [label="Ça doit être ça!",shape=box,color=blue];
		j2857292620 -> j767290467;
	j2096289168 [label="Tu veux dire des Cellules Orokins?",shape=box,color=red];
		j2096289168 -> j1731289119;
	j767290467 [label="Est-ce que tu parviens à les garder, là d'où tu viens?",shape=box,color=blue];
		j767290467 -> j3332116524;
		j767290467 -> j2369832029;
	j1731289119 [label="Mmm non, certainement pas ça non plus.",shape=box,color=blue];
		j1731289119 -> j668889467;
		j1731289119 -> j2037625159;
	j3332116524 [label="Ils disparaissent toujours une fois qu'on les sort du Néant.",shape=box,color=red];
		j3332116524 -> j1560696387;
	j2369832029 [label="Jamais, j'ai toujours pensé qu'ils se dégradaient, tout simplement. ",shape=box,color=red];
		j2369832029 -> j1560696387;
	j668889467 [label="Tu veux dire du Rubedo?",shape=box,color=red];
		j668889467 -> j2746593616;
	j2037625159 [label="Tu veux dire des Cristaux d'Argon?",shape=box,color=red];
		j2037625159 -> j2857292620;
	j1560696387 [label="Eh bien, c'est exactement ça: dans le Néant, ils sont inertes.",shape=box,color=blue];
		j1560696387 -> j4018798574;
	j2746593616 [label="Je ne pense pas, si nous ne parvenons pas à comprendre ceci, je ne parviendrai peut-être jamais à la solution.",shape=box,color=blue];
		j2746593616 -> j705844140;
		j2746593616 -> j2037625159;
	j4018798574 [label="Et puis quand ils quittent le Néant, ils retournent toujours au Néant. Ils ne se désintègrent pas en une nouvelle matière.",shape=box,color=blue];
		j4018798574 -> j3890280394;
	j705844140 [label="Tu veux dire des Nano Spores?",shape=box,color=red];
		j705844140 -> j2298676656;
	j3890280394 [label="Ils se rematérialisent dans le Néant. Le Néant est partout, il les rappelle.",shape=box,color=blue];
		j3890280394 -> j221969447;
	j2298676656 [label="Euh non, le dernier échantillon que j'avais a disparu. Je... euh. Je dois y aller.",shape=box,color=blue];
		j2298676656 -> j2254882645;
	j221969447 [label="Boolean KayaFutureWin2 is now true.",color=orange];
		j221969447 -> j1408537488;
		j221969447 -> j2652968202;
	j2254882645 [label="Je ne pense pas que je puisse faire ça.",shape=box,color=blue];
		j2254882645 -> j4123196853;
	j1408537488 [label="Est-ce que cela te fera sortir de 1999? Tu prévois de te cacher dans le Néant? Je ne te le recommande pas.",shape=box,color=red];
		j1408537488 -> j1163607362;
	j2652968202 [label="Est-ce important pour ton objectif?",shape=box,color=red];
		j2652968202 -> j2987937717;
	j4123196853 [label="+20 Chemistry",color=orange];
		j4123196853 -> "Chat ends. Next chat will be KayaRank5Convo2.";
	j1163607362 [label="Il s'agit davantage des états de la matière et de la théorie selon laquelle le Néant n'est pas \"linéaire\" dans notre compréhension, donc je peux l'utiliser comme un trampoline pour te suivre efficacement.",shape=box,color=blue];
		j1163607362 -> j3789493824;
	j2987937717 [label="Très très très! Cela signifie que la matière a une connexion entre le NÉANT et ICI. Les atomes, la matière, ils sont COHÉRENTS dans les deux domaines. ",shape=box,color=blue];
		j2987937717 -> j3465108755;
	"Chat ends. Next chat will be KayaRank5Convo2." [color=orange];
	j3789493824 [label="Attends, me suivre? ",shape=box,color=red];
		j3789493824 -> j1746985635;
	j3465108755 [label="Le Néant n'est pas \"linéaire\" selon notre compréhension, donc je peux l'utiliser comme un trampoline pour te suivre efficacement.",shape=box,color=blue];
		j3465108755 -> j3789493824;
	j1746985635 [label="Oui, peu importe le nombre de fois que j'exécute des tests ou des équations, il me manque un \"phare\" pour ainsi dire. Le saut du trampoline doit atterrir quelque part, et si tu y es retourné même une seule fois, cela devrait suffire pour l'étalonnage. ",shape=box,color=blue];
		j1746985635 -> j1886642648;
		j1746985635 -> j2364628274;
	j1886642648 [label="J'espère que tu aimes les sauts périlleux! Un phare arrive tout de suite. ",shape=box,color=red];
		j1886642648 -> j2621937830;
	j2364628274 [label="Ouah, je ne sais pas si je suis à l'aise avec ça. Et si tu es coincée ou perdue?! ",shape=box,color=red];
		j2364628274 -> j3267691970;
	j2621937830 [label="Je ne suis pas encore tout à fait prête, bien sûr. Mesurer deux fois, vérifier une fois. Mesurer... 1 000 fois. ",shape=box,color=blue];
		j2621937830 -> j3679206713;
		j2621937830 -> j1217550712;
	j3267691970 [label="Ça n'arrivera pas.",shape=box,color=blue];
		j3267691970 -> j2359543068;
