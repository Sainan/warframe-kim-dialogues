		120 -> 127;
	123 [label="En fait, il m'a convaincue que j'avais tort dans certaines de mes hypothèses initiales, donc ça m'a aidé, mais il m'a rappelé que je peux peut-être simplement payer pour obtenir une réponse, ou au moins payer pour parler à quelqu'un d'autre du futur si tu ne m'aides pas.",shape=box,color=blue];
		123 -> 130;
