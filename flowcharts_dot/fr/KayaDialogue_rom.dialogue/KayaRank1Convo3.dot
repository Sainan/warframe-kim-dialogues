		j368315635 -> j2527394398 [label=false,color=brown];
	j1176946232 [label="Ouais, je ne te connais pas. Je sais juste ce dont tu es capable. C'est pour ça qu'on en parle. Allez, soyons sérieux.",shape=box,color=blue];
		j1176946232 -> j2245814963;
	j4286349804 [label="Une promesse faite par un inconnu sur Internet. Laisse-moi tranquille. Ha. Dis-moi juste ce que je veux savoir.",shape=box,color=blue];
		j4286349804 -> j3678016420;
	j2335926319 [label="Et je me pointe, et il a vraiment la frousse. Il ne s'attendait même pas à ce que quelqu'un arrive.",shape=box,color=blue];
		j2335926319 -> j1434463045;
		j2335926319 -> j496275884;
	j2643812303 [label="Je l'ai fait. Nous sommes d'accord sur certains principes fondamentaux, mais il ne semble pas intéressé par un théorème de voyage dans le temps concret et reproductible. ",shape=box,color=blue];
		j2643812303 -> j1383452527;
	j1406194875 [label="Eh bien, nous essayons de tirer le meilleur parti de nos outils, je suppose. As-tu parlé à Lettie? J'ai l'impression que vous vous entendriez bien.",shape=box,color=red];
		j1406194875 -> j457893253;
	j2527394398 [label="D'accord, je voulais juste dire que ce serait un peu plus facile, je suppose, si tu avais accès à plus d'outils de mon temps.",shape=box,color=red];
		j2527394398 -> j2831348978;
	j2245814963 [label="Ok, soyons sérieux.",shape=box,color=red];
		j2245814963 -> j2366680174;
		j2245814963 -> j164033998;
	j3678016420 [label="Il t'est arrivé quelque chose?",shape=box,color=red];
		j3678016420 -> j790972181;
	j1434463045 [label="Wow, c'est impressionnant.",shape=box,color=red];
		j1434463045 -> j2930570118;
	j496275884 [label="Waouh, ça va, le melon?",shape=box,color=red];
		j496275884 -> j2930570118;
	j1383452527 [label="En fait, il m'a convaincue que j'avais tort dans certaines de mes hypothèses initiales, donc ça m'a aidé, mais il m'a rappelé que je peux peut-être simplement payer pour obtenir une réponse, ou au moins payer pour parler à quelqu'un d'autre du futur si tu ne m'aides pas.",shape=box,color=blue];
		j1383452527 -> j390715388;
		j1383452527 -> j4236349192;
	j457893253 [label="On s'entend bien. Elle me rappelle une prof que j'ai eue autrefois, super sympa et qui m'a reconnue pour mon talent.",shape=box,color=blue];
		j457893253 -> j3563877260;
	j2831348978 [label="C'est une offre? À quoi puis-je avoir accès? N'importe quel truc utile, je prends.",shape=box,color=blue];
		j2831348978 -> j136681083;
	j2366680174 [label="Tu veux voyager dans le temps, mais où? Pourquoi?",shape=box,color=red];
		j2366680174 -> j1153897047;
	j164033998 [label="As-tu regardé autour de toi?",shape=box,color=red];
		j164033998 -> j142085750;
	j790972181 [label="Il nous est arrivé quelque chose à tous. Fais-moi signe si tu trouves un moyen de m'aider. ",shape=box,color=blue];
		j790972181 -> j3994434447;
	j2930570118 [label="Arf, pourquoi je te raconte ça, encore?",shape=box,color=blue];
		j2930570118 -> j844067633;
	j390715388 [label="Pour 10 höllars, je te dirai comment tu meurs.",shape=box,color=red];
		j390715388 -> j2347946497;
	j4236349192 [label="Quiconque te vend ce genre de choses ment. Je vais essayer de t'aider, je le ferai vraiment. Et gratuitement.",shape=box,color=red];
		j4236349192 -> j674234157;
	j3563877260 [label="En fait, elle est vraiment super cool. Intelligente aussi. Même si elle m'a dit de te faire vraiment confiance, alors je suppose qu'on verra.",shape=box,color=blue];
		j3563877260 -> j3085110209;
		j3563877260 -> j871708257;
	j136681083 [label="Je vais voir ce que je peux trouver pour toi, puisque tu veux tout faire à ta tête.",shape=box,color=red];
		j136681083 -> j1739523069;
	j1153897047 [label="Est-ce que tu arrives seulement à comprendre quelque chose? Pouah.",shape=box,color=blue];
		j1153897047 -> j493599008;
	j142085750 [label="Ouais. J'ai tout vu. Ce tournant miraculeux du millénaire. Des invitations à tellement de fêtes parce que les gens voulaient que \"cette fille\" soit là.",shape=box,color=blue];
		j142085750 -> j3823261031;
	j844067633 [label="Alors, dis-moi, je dois économiser ou quoi?",shape=box,color=blue];
		j844067633 -> j4132234843;
		j844067633 -> j2406497646;
	j2347946497 [label="Pouah, c'est débile.",shape=box,color=blue];
		j2347946497 -> j3994434447;
	j674234157 [label="On verra bien, n'est-ce pas?",shape=box,color=blue];
		j674234157 -> j3994434447;
	j3085110209 [label="Je ne suis pas ici pour te trahir ou quoi que ce soit, et je ne suis pas un manuel de voyage dans le temps.",shape=box,color=red];
		j3085110209 -> j2230242858;
	j871708257 [label="Je te promets que tu peux me faire confiance, je ne sais pas pourquoi tu es si hostile.",shape=box,color=red];
		j871708257 -> j1033005681;
	j1739523069 [label="Oui. Et merci.",shape=box,color=blue];
		j1739523069 -> j3994434447;
	j493599008 [label="Et qui voudrait rester ici? Genre...",shape=box,color=blue];
		j493599008 -> j2421827423;
	j3823261031 [label="Cela ne s'arrêtera jamais. Tourne-toi vers l'avenir. Fais-moi signe quand tu pourras m'aider.",shape=box,color=blue];
		j3823261031 -> j3994434447;
	j4132234843 [label="Kaya, je pense que tu es un peu trop obsédée par ce sujet. Et si tu n'arrives pas à le comprendre?",shape=box,color=red];
		j4132234843 -> j995254249;
	j2406497646 [label="Aucune idée. Je suis l'être ééééélu, Kaya. ",shape=box,color=red];
		j2406497646 -> j3288335793;
	j2230242858 [label="Arf. OK",shape=box,color=blue];
		j2230242858 -> j3994434447;
	j1033005681 [label="J'ai mes raisons",shape=box,color=blue];
		j1033005681 -> j3994434447;
