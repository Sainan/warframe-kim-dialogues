		109 -> 114 [label=false,color=brown];
	111 [label="Ouais, je ne te connais pas. Je sais juste ce dont tu es capable. C'est pour ça qu'on en parle. Allez, soyons sérieux.",shape=box,color=blue];
		111 -> 117;
	112 [label="Une promesse faite par un inconnu sur Internet. Laisse-moi tranquille. Ha. Dis-moi juste ce que je veux savoir.",shape=box,color=blue];
