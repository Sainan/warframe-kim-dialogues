	j3966324382 [label="Nova, idiote, idiote!",shape=box,color=blue];
		j3966324382 -> j553818409;
	j3991930398 [label="Hm. Eh bien, supposons que Protea ait la compréhension temporelle la plus avancée de toutes ces créations",shape=box,color=blue];
		j3991930398 -> j162336240;
	j2822853981 [label="Voici comment cela va fonctionner exactement.",shape=box,color=blue];
		j2822853981 -> j936893847;
	j553818409 [label="Les notes ne signifient rien si tes professeurs refusent de te laisser entrer en classe.",shape=box,color=blue];
		j553818409 -> j133164371;
		j553818409 -> j3837252918;
	j162336240 [label="La compréhension est-elle basée sur la théorie, la science, une capacité innée ou... hum. ",shape=box,color=blue];
		j162336240 -> j4162078976;
	j936893847 [label="Je vais voyager dans le temps, comme tu l'as fait. ",shape=box,color=blue];
