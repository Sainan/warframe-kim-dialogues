	j133164371 [label="C'est un monde différent, maintenant.",shape=box,color=red];
		j133164371 -> j144473971;
	j3837252918 [label="Si jamais tu veux en parler...",shape=box,color=red];
		j3837252918 -> j144473971;
	j4162078976 [label="Eh bien, hum. En fait. Oui, disons que le Néant a quelque chose à voir avec ça.",shape=box,color=blue];
		j4162078976 -> j3217401332;
		j4162078976 -> j1919066389;
	j2227390188 [label="Je vais aller là d'où TU viens.",shape=box,color=blue];
