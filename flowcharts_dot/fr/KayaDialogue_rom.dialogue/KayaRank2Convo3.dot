	j144473971 [label="Je sais, je saiiiiis...",shape=box,color=blue];
		j144473971 -> j1751812289;
	j3217401332 [label="Le Néant n’est pas quelque chose que tu peux simplement \"résoudre\".",shape=box,color=red];
		j3217401332 -> j2427357551;
	j1919066389 [label="Le Néant a quelque chose à voir avec... tout.",shape=box,color=red];
		j1919066389 -> j2138542085;
	j3913686452 [label="Et alors, je saurai si tu te fiches de moi ou si je peux réellement te faire confiance, je saurai ce que l'avenir me réserve.",shape=box,color=blue];
		j3913686452 -> j650041773;
	j1751812289 [label="Écoute, une fois que j'aurai compris ce truc du \"voyage dans le temps\", je t'en dirai plus. Je n'aurai rien à perdre.",shape=box,color=blue];
		j1751812289 -> j2189522063;
