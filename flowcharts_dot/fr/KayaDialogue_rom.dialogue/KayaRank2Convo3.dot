		j666043479 -> j644299066;
	j536126477 [label="Parce que pour une raison quelconque, tout ce que Nova a à faire, c'est de demander au seul voyageur temporel qu'elle connaît des informations sur les voyages dans le temps.",shape=box,color=red];
		j536126477 -> j1884261981;
