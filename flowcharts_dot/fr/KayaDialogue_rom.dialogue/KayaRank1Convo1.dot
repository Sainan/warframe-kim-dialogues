digraph {
	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j1312088059;
	j1312088059 [label="Bonjour. Est-ce que tout le monde peut voyager dans le temps, ou seulement toi?",shape=box,color=blue];
		j1312088059 -> j429825516;
		j1312088059 -> j421543831;
	j429825516 [label="Bonjour à toi aussi. Écoute gamine, ce n'est pas si simple.",shape=box,color=red];
		j429825516 -> j3588408550;
	j421543831 [label="Bonjour? Kaya? Comment se passe ta journée.",shape=box,color=red];
		j421543831 -> j2848306920;
	j3588408550 [label="J'suis pas une gamine, j'ai 19 ans.",shape=box,color=blue];
		j3588408550 -> j2020020214;
		j3588408550 -> j3213003422;
	j2848306920 [label="Super. ",shape=box,color=blue];
		j2848306920 -> j812271695;
	j2020020214 [label="D'accord. Mais la plus jeune de cette souriante équipe, donc une gamine.",shape=box,color=red];
		j2020020214 -> j4131226556;
	j3213003422 [label="Ouais, ouais, c'est bon, mais pour ce qui est du voyage dans le temps, c'est... compliqué.",shape=box,color=red];
		j3213003422 -> j3543908810;
	j812271695 [label="Alors, juste toi? Ou il y en a d'autres? Est-ce que le voyage dans le temps sera enseigné dans les écoles du futur?",shape=box,color=blue];
		j812271695 -> j1233801904;
	j4131226556 [label="Pouah. La plus jeune, bien sûr, mais aussi clairement la plus déterminée à faire quelque chose pour trouver des réponses. Essaie de garder le rythme. Donc: voyage dans le temps. Comment et qui?",shape=box,color=blue];
		j4131226556 -> j3347399665;
	j3543908810 [label="Arf. Compliqué à quel point? Des formules? Des éléments chimiques et atomiques? Je vais trouver la solution, il suffit de m'indiquer une direction.",shape=box,color=blue];
		j3543908810 -> j2037801261;
		j3543908810 -> j3030754704;
	j1233801904 [label="Disons qu'il n'y a que moi. Ça simplifie les choses.",shape=box,color=red];
		j1233801904 -> j2704234569;
	j3347399665 [label="Et pourquoi toi? Tu as un plan? ",shape=box,color=blue];
		j3347399665 -> j1853418429;
	j2037801261 [label="Je ne sais pas trop quoi te dire. Ça ne relève pas seulement du domaine de la science, ou si c'est le cas, c'est une science qu'Entrati connaît.",shape=box,color=red];
		j2037801261 -> j1188707191;
	j3030754704 [label="Voici une direction: arrête [Fin.]",shape=box,color=red];
		j3030754704 -> j2547432773;
	j2704234569 [label="En ce qui concerne les écoles, tout ce que je peux dire, c'est que je n'ai jamais étudié ça. Mais sait-on jamais? ",shape=box,color=red];
		j2704234569 -> j3411505596;
	j1853418429 [label="Et sinon, que peux-tu me conseiller pour que je puisse obtenir des sources scientifiques sur tes pouvoirs?",shape=box,color=blue];
		j1853418429 -> j2948346359;
	j1188707191 [label="Pouah, ce fumier. Je savais que j'aurais dû lui poser plus de questions. Ok. Au moins, si c'est de la science, ça veut dire que je peux le reproduire, et comme tu peux aller et venir, je peux le comprendre. Au revoir.",shape=box,color=blue];
		j1188707191 -> j2547432773;
	j2547432773 [label="+20 Chemistry",color=orange];
		j2547432773 -> "Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue";
	j3411505596 [label="Pourquoi, tu veux faire des devoirs? Le voyage dans le temps est probablement un sujet trop avancé pour l'instant...",shape=box,color=red];
		j3411505596 -> j3286757741;
	j2948346359 [label="Ça en fait des questions, gamine. Je regrette de te le dire comme ça, mais je ne sais pas. Seul Entrati a les réponses.",shape=box,color=red];
		j2948346359 -> j3700328320;
	"Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue" [label="Queue conversation HexKayaConvo1 in HexDialogue_rom.dialogue",color=orange];
		"Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue" -> "Chat ends. Next chat will be KayaRank1Convo2.";
	j3286757741 [label="Euh, sérieusement?",shape=box,color=blue];
		j3286757741 -> j3765096264;
	j3700328320 [label="Boolean KayaSetKid is now true.",color=orange];
		j3700328320 -> j3568127648;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j3765096264 [label="Est-ce que certains membres de l'Hexagone ont compris? Ont-ils des informations? ",shape=box,color=blue];
		j3765096264 -> j441775177;
		j3765096264 -> j3907495268;
	j3568127648 [label="OK.",shape=box,color=blue];
		j3568127648 -> j2547432773;
	j441775177 [label="Peut-être Amir? Il joue probablement à des jeux avec des histoires de voyage dans le temps...",shape=box,color=red];
		j441775177 -> j2388074483;
	j3907495268 [label="Je ne pense pas, gamine. Mais si tu veux apprendre quelque chose d'utile, demande à Lettie de t'enseigner comment prodiguer des soins.",shape=box,color=red];
		j3907495268 -> j3018528744;
	j2388074483 [label="Boolean KayaAmirTravel is now true.",color=orange];
		j2388074483 -> j2942023206;
	j3018528744 [label="Boolean KayaLettieHeal is now true.",color=orange];
		j3018528744 -> j1056642871;
	j2942023206 [label="Des jeux? Je veux des réponses, une piste, n'importe quoi. Je trouverai une solution. Si tu penses à quelque chose d'UTILE, contacte-moi.",shape=box,color=blue];
		j2942023206 -> j2547432773;
	j1056642871 [label="C'est pas pour moi. Laisse tomber.",shape=box,color=blue];
		j1056642871 -> j2547432773;
