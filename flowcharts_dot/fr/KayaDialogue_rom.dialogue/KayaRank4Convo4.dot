	j2536138445 [label="Est-ce qu'il y a un soleil?",shape=box,color=blue];
		j2536138445 -> j1762184013;
		j2536138445 -> j3203017388;
	j1345484540 [label="Je crois bien que oui? Je le saurais, s'il disparaissait quand je pars.",shape=box,color=red];
		j1345484540 -> j2127090542;
	j2442251 [label="Et qu'en est-il de l'éventualité où tu te perds quelque part, à un moment donné?",shape=box,color=red];
		j2442251 -> j571108202;
