		j1762433226 -> j392027042;
	j2103728141 [label="Ha, ha.",shape=box,color=blue];
		j2103728141 -> j2677771233;
	j206396864 [label="Des corps célestes?",shape=box,color=blue];
		j206396864 -> j1924714071;
		j206396864 -> j175284746;
	j2881594407 [label="Je ne pense pas que la science puisse expliquer ceci. \"Ça\", c'est la cause de tout ceci.",shape=box,color=red];
		j2881594407 -> j1819212879;
	j2325921494 [label="Cela ressemble plus à de la philosophie.",shape=box,color=red];
		j2325921494 -> j628139726;
	j2984733007 [label="Oh, et dis à Arthur que je le trouve mignon, mais seulement si je suis vraiment partie. ",shape=box,color=blue];
		j2984733007 -> j1487584150;
	j2677771233 [label="Je vais essayer.",shape=box,color=blue];
