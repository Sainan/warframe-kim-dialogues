		j3088596734 -> j3624553022;
	j4070907465 [label="C'est \"le Néant\". Il n'y a rien jusqu'à ce qu'il y ait quelque chose.",shape=box,color=red];
		j4070907465 -> j2712153618;
	j785281285 [label="Quand nous retrouverons Albrecht, nous devrons le ramener là-bas ou quelque chose comme ça. Je n'ai pas encore vraiment de plan.",shape=box,color=red];
		j785281285 -> j2712153618;
	j2599112746 [label="Eh bien, je pense que ce serait plutôt amusant de répondre à ton énigme scientifique, j'espère que tu obtiendras des réponses.",shape=box,color=blue];
