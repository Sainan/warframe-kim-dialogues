	"Chat ends. Next chat will be KayaRank5Convo1." [color=orange];
	j1762184013 [label="Si tu y penses vraiment très fort, tu le feras peut-être apparaître?",shape=box,color=red];
		j1762184013 -> j2103728141;
	j3203017388 [label="C'était une métaphore, et il n'y a pas de soleil.",shape=box,color=red];
		j3203017388 -> j206396864;
	j2127090542 [label="Tu crois? Il existe une école de science qui pourrait penser que l'observation de Duviri serait la clé de son existence.",shape=box,color=blue];
		j2127090542 -> j2881594407;
		j2127090542 -> j2325921494;
	j571108202 [label="Je ne sais pas, dis quelque chose de gentil à mon enterrement si tu ne me revois plus jamais.",shape=box,color=blue];
		j571108202 -> j2984733007;
