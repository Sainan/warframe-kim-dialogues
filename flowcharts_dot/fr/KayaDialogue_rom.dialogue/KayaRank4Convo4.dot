digraph {
	"KayaRank4Convo4 begins." [color=orange];
		"KayaRank4Convo4 begins." -> j93745768;
	j93745768 [label="Je pense que j'ai quelque chose qui peut t'aider.",shape=box,color=red];
		j93745768 -> j1938839396;
	j1938839396 [label="Il y a cet endroit que je connais, je crois que c'est de là que je viens, en fait. Duviri.",shape=box,color=red];
		j1938839396 -> j234814798;
	j234814798 [label="Et il est toujours là, même si je n'y suis plus. Dans le Néant.",shape=box,color=red];
		j234814798 -> j2747167548;
	j2747167548 [label="Et le système dans lequel se trouve l’autre enfant, c’est un endroit où j’ai été.",shape=box,color=red];
		j2747167548 -> j2955421296;
	j2955421296 [label="Mmmm, tous tes pas sont vraiment la clé pour que je te \"suive en toute sécurité\", tu sais.",shape=box,color=blue];
		j2955421296 -> j236822034;
	j236822034 [label="Boolean KayaFutureWin1 is now true.",color=orange];
		j236822034 -> j3140986952;
	j3140986952 [label="C'est comme un grand panneau \"sortie\" lumineux du Néant, lorsqu'il s'agit de particules attirées par leur prochaine forme.",shape=box,color=blue];
		j3140986952 -> j3452664155;
	j3452664155 [label="Désolée, mais qu'est-ce que \"Duviri\"? Un état de la matière? ",shape=box,color=blue];
		j3452664155 -> j1692772976;
		j3452664155 -> j2989485607;
	j1692772976 [label="C'est un endroit que j'ai créé dans le Néant.",shape=box,color=red];
		j1692772976 -> j1134678452;
	j2989485607 [label="À bien des égards, c'est ma véritable maison. Là où j'ai grandi.",shape=box,color=red];
		j2989485607 -> j1352223388;
	j1134678452 [label="Rempli d'incarnations de concepts, d'émotions.",shape=box,color=red];
		j1134678452 -> j388906618;
	j1352223388 [label="C'est dans le Néant.",shape=box,color=red];
		j1352223388 -> j3842032480;
	j388906618 [label="Il s’agit en fait d’un \"livre de contes\" devenu réalité.",shape=box,color=red];
		j388906618 -> j2171968460;
	j3842032480 [label="Cependant, nous ne recevons pas beaucoup de visiteurs, ces temps-ci.",shape=box,color=red];
		j3842032480 -> j1073052187;
	j2171968460 [label="Haha! Oh mon Dieu. Ok je vois, et c'est bien dans le Néant?",shape=box,color=blue];
		j2171968460 -> j1272789803;
	j1073052187 [label="Prépare le tapis rouge au cas où je me pointerais.",shape=box,color=blue];
		j1073052187 -> j3413308411;
		j1073052187 -> j1782506267;
		j1073052187 -> j4250965891;
	j1272789803 [label="Oui, mais lié au Zariman.",shape=box,color=red];
		j1272789803 -> j3327344216;
	j3413308411 [label="Je n'y retourne pas souvent...",shape=box,color=red];
		j3413308411 -> j3181710545;
	j1782506267 [label="Tu penses vraiment que tu vas y aller?",shape=box,color=red];
		j1782506267 -> j3602039492;
	j4250965891 [label="À vos ordres, voyageuse de l'espace! [Fin.]",shape=box,color=red];
		j4250965891 -> j392027042;
	j3327344216 [label="Comme une grande lune en métal.",shape=box,color=red];
		j3327344216 -> j2536138445;
	j3181710545 [label="Est-ce que c'est encore là? Comment le savoir?",shape=box,color=blue];
		j3181710545 -> j1345484540;
	j3602039492 [label="Il faut prévoir toutes les éventualités possibles.",shape=box,color=blue];
		j3602039492 -> j2442251;
		j3602039492 -> j4033189605;
	j392027042 [label="+20 Chemistry",color=orange];
