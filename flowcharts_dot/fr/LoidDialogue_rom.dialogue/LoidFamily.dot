	"Chat ends." [color=orange];
	j3300528903 [label="Je redoute ce que je vais devoir faire jusque dans la moelle de mes os. En vérité, c'est peut-être ce qui me sera arraché lorsque, dans un accès de rage, Gomaitru et sa famille me mettront en pièces, découvrant ce qui s'est passé sous leurs pieds depuis tout ce temps.",shape=box,color=blue];
		j3300528903 -> j706395923;
	j706395923 [label="C'est étrange de l'appeler ainsi maintenant, mais tant de choses ont changé entre nous. Et bien d'autres choses encore changeront bientôt.",shape=box,color=blue];
