digraph {
	0 [label="LoidRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Cher Voyageur, veuillez m'excuser pour cette sollicitation intempestive; je ne voulais pas vous contacter par l'intermédiaire de cet appareil. Mais la situation frôle l'urgence et je ne savais pas vers qui me tourner.",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="POM2_LAB1?",shape=box,color=red];
		2 -> 4;
	3 [label="Qui est-ce...?",shape=box,color=red];
		3 -> 4;
	4 [label="Ah oui. Les paramètres sont toujours par défaut. Ici Loid. J'aurais dû commencer par là, mais ces derniers temps, la situation est particulièrement chaotique à Sanctum Anatomica.",shape=box,color=blue];
		4 -> 5;
	5 [label="C’est pourquoi je vous contacte. J’ai besoin de votre aide. Trois Protoframes sont arrivées ici, à Sanctum, à mon époque. Et ce sont des Protoframes que nous ne connaissons pas.",shape=box,color=blue];
		5 -> 6;
	6 [label="L'une d'elles est un",shape=box,color=blue];
		6 -> 7;
	7 [label="Mes excuses",shape=box,color=blue];
		7 -> 8;
	8 [label="L'une d'elles est un Orokin, Voyageur.",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
		8 -> 11;
	9 [label="Où est le Lotus?",shape=box,color=red];
		9 -> 12;
	10 [label="Oh, non... ",shape=box,color=red];
		10 -> 13;
	11 [label="Quoi?!",shape=box,color=red];
		11 -> 13;
	12 [label="Le Lotus et l'Opérateur ont d'autres chats à fouetter, croyez-moi. Ils sont déjà suffisamment sollicités. Je ne vous demanderais pas votre aide si j'avais d'autres options.",shape=box,color=blue];
		12 -> 14;
	13 [label="Je ne vous aurais pas demandé de m'aider si j'avais d'autres options. Vous semblez être... le nouvel expert en la matière.",shape=box,color=blue];
		13 -> 15;
	14 [label="Vous semblez être... le nouvel expert en la matière.",shape=box,color=blue];
		14 -> 15;
	15 [label="Je ne sais pas comment les décrire adéquatement. Mais si vous venez à Sanctum, je pense que vous ne pourrez pas les manquer. Deux d'entre elles ont accepté de vous parler ici, sur le POM-2. Il faudra peut-être encore un peu de persuasion pour convaincre la troisième.",shape=box,color=blue];
		15 -> 16;
	16 [label="J'ai... confiance... en vous. Vous réussirez.",shape=box,color=blue];
		16 -> 29;
	29 [label="Update boolean LoidTriadAvailable",color=orange];
		29 -> 17;
	17 [label="Chat ends. Next chat will be LoidFamily.",color=orange];
}