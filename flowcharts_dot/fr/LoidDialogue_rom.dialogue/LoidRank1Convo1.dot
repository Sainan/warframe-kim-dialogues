digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LoidRank1Convo1 begins." [color=orange];
		"LoidRank1Convo1 begins." -> j2220619300;
	j2220619300 [label="Cher Voyageur, veuillez m'excuser pour cette sollicitation intempestive; je ne voulais pas vous contacter par l'intermédiaire de cet appareil. Mais la situation frôle l'urgence et je ne savais pas vers qui me tourner.",shape=box,color=blue];
		j2220619300 -> j3828188781;
		j2220619300 -> j3490232794;
	j3828188781 [label="POM2_LAB1?",shape=box,color=red];
		j3828188781 -> j169560007;
	j3490232794 [label="Qui est-ce...?",shape=box,color=red];
		j3490232794 -> j169560007;
	j169560007 [label="Ah oui. Les paramètres sont toujours par défaut. Ici Loid. J'aurais dû commencer par là, mais ces derniers temps, la situation est particulièrement chaotique à Sanctum Anatomica.",shape=box,color=blue];
		j169560007 -> j727323350;
	j727323350 [label="C'est pourquoi je vous contacte. J'ai besoin de votre aide. Trois Protoframes sont arrivées ici, à Sanctum, à mon époque. Et ce sont des Protoframes que nous ne connaissons pas.",shape=box,color=blue];
		j727323350 -> j3544229820;
	j3544229820 [label="L'une d'elles est un",shape=box,color=blue];
		j3544229820 -> j2804713131;
	j2804713131 [label="Mes excuses",shape=box,color=blue];
		j2804713131 -> j2533180893;
	j2533180893 [label="L'une d'elles est un Orokin, Voyageur.",shape=box,color=blue];
		j2533180893 -> j573333946;
		j2533180893 -> j4213496245;
		j2533180893 -> j913734243;
	j573333946 [label="Où est le Lotus?",shape=box,color=red];
		j573333946 -> j1388421673;
	j4213496245 [label="Oh, non... ",shape=box,color=red];
		j4213496245 -> j1078216059;
	j913734243 [label="Quoi?!",shape=box,color=red];
		j913734243 -> j1078216059;
	j1388421673 [label="Le Lotus et l'Opérateur ont d'autres chats à fouetter, croyez-moi. Ils sont déjà suffisamment sollicités. Je ne vous demanderais pas votre aide si j'avais d'autres options.",shape=box,color=blue];
		j1388421673 -> j704111033;
	j1078216059 [label="Je ne vous aurais pas demandé de m'aider si j'avais d'autres options. Vous semblez être... le nouvel expert en la matière.",shape=box,color=blue];
		j1078216059 -> j365220196;
	j704111033 [label="Vous semblez être... le nouvel expert en la matière.",shape=box,color=blue];
		j704111033 -> j365220196;
	j365220196 [label="Je ne sais pas comment les décrire adéquatement. Mais si vous venez à Sanctum, je pense que vous ne pourrez pas les manquer. Deux d'entre elles ont accepté de vous parler ici, sur le POM-2. Il faudra peut-être encore un peu de persuasion pour convaincre la troisième.",shape=box,color=blue];
		j365220196 -> j4245370574;
	j4245370574 [label="J'ai... confiance... en vous. Vous réussirez.",shape=box,color=blue];
		j4245370574 -> j3173882;
	j3173882 [label="Boolean LoidTriadAvailable is now true.",color=orange];
		j3173882 -> "Chat ends. Next chat will be LoidFamily.";
	"Chat ends. Next chat will be LoidFamily." [color=orange];
}