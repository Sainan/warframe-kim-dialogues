	j3957127584 [label="Aucune idée. C'était peut-être un Infesté que tu as vu me poursuivre.",shape=box,color=red];
		j3957127584 -> j4093388285;
	j681374125 [label="Un vulpaphyla? Il ressemblait à un \"renard\" ou à un \"chien\" maigre avec de grandes oreilles ornées de choses lumineuses?",shape=box,color=red];
		j681374125 -> j986402041;
	j2332709330 [label="Ça pourrait être un Kavat Smeeta? Il ressemblait à Kalymos, mais avec de grandes oreilles pointues?",shape=box,color=red];
		j2332709330 -> j2047088548;
	j1997062601 [label="Un Prédasite Vizir? Est-ce qu'il ressemblait à un... gros \"chien\" costaud avec des trucs lumineux sur la tête? De grandes oreilles de chauve-souris?",shape=box,color=red];
		j1997062601 -> j3573260966;
