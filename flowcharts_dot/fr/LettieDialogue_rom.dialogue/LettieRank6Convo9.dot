	j1714046476 [label="C'est mon Vulpaphyla Nocturne. Il vient de Deimos, la planète Infestée. C'est assez rare d'en voir un loin de Deimos :) Il est inoffensif. Enfin. Pour toi, en tout cas.",shape=box,color=red];
		j1714046476 -> j740613580;
	j1603316698 [label="C'est mon Vulpaphyla Panzer. Il vient de Deimos, la planète Infestée. Il est inoffensif. Enfin. Pour toi, en tout cas.",shape=box,color=red];
