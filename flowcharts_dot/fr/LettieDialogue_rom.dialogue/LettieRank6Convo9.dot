		j792433050 -> j4093388285;
	j531518711 [label="C'est mon Vulpaphyla Rusé. Il vient de Deimos, la planète Infestée. C'est assez rare d'en voir un loin de Deimos :) Il est inoffensif. Enfin. Pour toi, en tout cas.",shape=box,color=red];
