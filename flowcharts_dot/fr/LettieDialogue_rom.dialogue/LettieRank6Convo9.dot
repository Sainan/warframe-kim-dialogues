		j1679830412 -> j1565934264;
	j4180836459 [label="Jajaja, je vois\nOk, il y avait de grosses choses bizarres qui sortaient de sa tête",shape=box,color=blue];
		j4180836459 -> j3957127584;
		j4180836459 -> j681374125;
		j4180836459 -> j2332709330;
		j4180836459 -> j1997062601;
	j1565934264 [label="Vivante... Je pense\nMolle, donc pas en métal\nDe grosses choses étranges sortant de sa tête",shape=box,color=blue];
