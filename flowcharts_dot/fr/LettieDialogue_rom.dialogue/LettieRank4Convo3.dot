	j274168242 [label="Gracias",shape=box,color=blue];
		j274168242 -> j912426118;
	j694489597 [label="Eh, está bien \nÇa arrive, ¿no?\nLes problèmes cardiaques la rendaient de plus en plus malade \nC'était un bon entraînement pour mon avenir et une aide utile pour mi mamá",shape=box,color=blue];
		j694489597 -> j899396480;
		j694489597 -> j3069411792;
		j694489597 -> j4185520548;
	j2975570604 [label="10? 11? \nMi mamá avait besoin d'aide \nÇa ne me dérangeait pas \nC'était un bon entraînement pour mon avenir et une occasion de me rendre utile",shape=box,color=blue];
