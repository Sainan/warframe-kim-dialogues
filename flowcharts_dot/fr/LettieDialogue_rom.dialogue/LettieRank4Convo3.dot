		j3313443002 -> j2239530067;
	j874971225 [label="Mi papá était dans l'armée \nNous avons beaucoup voyagé, de base en base \nMais quand mi tía est tombée malade, elle a emménagé avec nous \nEt j'ai appris à prendre soin d'elle jusqu'à son décès",shape=box,color=blue];
		j874971225 -> j2985861959;
	"Chat ends." [color=orange];
