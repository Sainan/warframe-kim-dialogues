		j3958113619 -> j252820522;
	j3362417033 [label="Jaja, comment, c'est la partie facile, babas \nJe me suis enrôlée et j'étais nulle\nPuis, je suis me suis améliorée",shape=box,color=blue];
		j3362417033 -> j1498739770;
