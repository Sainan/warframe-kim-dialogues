		j4185520548 -> j2425613940;
	j3192134506 [label="Mi tía vient me voir chaque année, me tape sur l'épaule et me dit \"Buen trabajo, amorcito, sigue así\" \nEt ça me fait sourire, pas crier ni m'enfuir de peur",shape=box,color=blue];
