		j3705594004 -> "Chat ends.";
	j3313443002 [label="Nous célébrons nos êtres chers qui reviennent nous rendre visite \nNous les invitons à revenir nous voir une fois par an \nNous préparons notre pan de muerto, nos calaveritas de azúcar et décorons de bouquets de soucis pour les inviter à la maison",shape=box,color=blue];
