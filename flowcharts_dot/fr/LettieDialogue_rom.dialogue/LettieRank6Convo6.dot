	j3929227361 [label="Et ce Velimir me fait sourire\nJ'apprécie un homme qui sait précisément qui il est\nAlguien auténtico y fiel a sí mismo, ¿sí?\nIl a laissé Aoi lui vernir les ongles des pieds, l'autre jour jajajaja\nTout en discutant de leurs bolides Libertatiens classiques préférés\nIl en avait rien à battre",shape=box,color=blue];
