		j3143673794 -> j1989934678;
		j3143673794 -> j1702951119;
	j1989934678 [label="Mais tu as un tas de raisons d'être heureuse, non?",shape=box,color=red];
		j1989934678 -> j1734875139;
	j1702951119 [label="J'ai appris à mes dépens à Duviri que \"réparer les sentiments\" est parfois le pire choix.",shape=box,color=red];
		j1702951119 -> j3144431809;
	j1734875139 [label="Ay, sí, c'est vrai
