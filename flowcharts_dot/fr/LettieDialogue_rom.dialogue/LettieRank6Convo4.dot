	j2509569749 [label="Il se passe quelque chose?",shape=box,color=red];
		j2509569749 -> j2337774691;
	j3936335744 [label="Sólo las arañas\nElles sont de retour\nElles finiront par partir",shape=box,color=blue];
		j3936335744 -> j1788637604;
	j2337774691 [label="Non, rien de neuf\nSólo las arañas\nElles sont de retour\nElles finiront par partir",shape=box,color=blue];
		j2337774691 -> j1788637604;
	j1788637604 [label="Parfois, j'aimerais que\nCe soit aussi simple qu'un problème\nAlors, je pourrais le régler, ¿sí?\nEn parler, le gifler jajaja",shape=box,color=blue];
		j1788637604 -> j3143673794;
	j3143673794 [label="Les problèmes peuvent être résolus\nLes problèmes ont des réponses\nLos sentimientos no se arreglan\nCrois-moi, j'ai essayé",shape=box,color=blue];
		j3143673794 -> j1989934678;
		j3143673794 -> j1702951119;
	j1989934678 [label="Mais tu as un tas de raisons d'être heureuse, non?",shape=box,color=red];
		j1989934678 -> j1734875139;
	j1702951119 [label="J'ai appris à mes dépens à Duviri que \"réparer les sentiments\" est parfois le pire choix.",shape=box,color=red];
		j1702951119 -> j3144431809;
	j1734875139 [label="Ay, sí, c'est vrai\nEt je sais que je le suis\nEt j'aimerais parfois\nQue les gens comprennent cette partie de moi\nQui n'est pas facile à assimiler",shape=box,color=blue];
		j1734875139 -> j3833894069;
	j3144431809 [label="Síí...\nMême si parfois, c'est tentant jajaja\nSouhaiter juste que tout disparaisse\nMais tu m'as raconté ce qui se passe\nQuand tout devient insensible",shape=box,color=blue];
		j3144431809 -> j656352419;
	j3833894069 [label="J'aimerais être différente\nMais je suis qui je suis\nEt j'ai renoncé à m'excuser pour ça\nIl y a longtemps",shape=box,color=blue];
		j3833894069 -> "Chat ends.";
	j656352419 [label="Je ne souhaiterais ça à personne\nOk, peut-être Albrecht\nPinche güey\nMais son cœur est déjà assez froid comme ça",shape=box,color=blue];
		j656352419 -> j3300596375;
		j656352419 -> j1373168109;
	j3300596375 [label="Qu'est-ce qu'on peut faire pour te changer les idées? Ou tu préfères rester ici?",shape=box,color=red];
		j3300596375 -> j3883669521;
	j1373168109 [label="Nous ne pouvons qu’espérer qu’il joue sur le long terme.",shape=box,color=red];
		j1373168109 -> j3187470657;
	j3883669521 [label="Eeeh, bonne question\nHonnêtement, je ne suis pas sûre\nRester à la maison serait peut-être bien \nOu, on pourrait sortir et tuer des choses\n¿Te quedas? ¿o vamos a matar cosas? \nAh, les choix...",shape=box,color=blue];
		j3883669521 -> j1103467058;
		j3883669521 -> j1595116676;
	j3187470657 [label="La seule chose que j'espère lorsque ce cabrón est impliqué\nC'est un long trajet en ascenseur\nAvec moi\nEt une batte de baseball",shape=box,color=blue];
		j3187470657 -> j4237576684;
	j1103467058 [label="Je vote pour rester ici.",shape=box,color=red];
		j1103467058 -> j2761558437;
	j1595116676 [label="Je vote pour tuer des choses.",shape=box,color=red];
		j1595116676 -> j3718691998;
	j4237576684 [label="C'est une image qui me remonte le moral\nJajaja",shape=box,color=blue];
		j4237576684 -> j3819368348;
	j2761558437 [label="Bonne idée\nS'asseoir au bar avec M&V\nPeut-être une partie de cartes\nÇa pourrait me changer les idées",shape=box,color=blue];
		j2761558437 -> j3819368348;
	j3718691998 [label="Jajaja, bon choix\nEnlever la douleur de mes pensées\nEn mettant la douleur dans celles de quelqu'un d'autre",shape=box,color=blue];
