	j3825863469 [label="Dejar de hacerme mensa y hacer las cosas, jajaja\nJe suppose que je dis juste que\nNous devons nous rappeler de vivre l'instant présent",shape=box,color=blue];
		j3825863469 -> j129036921;
	j1870835191 [label="Por supuesto que sí\nJe veux juste dire que\nNous devons nous rappeler de vivre l'instant présent",shape=box,color=blue];
		j1870835191 -> j129036921;
	j129036921 [label="C'est pourquoi j'ai des rats\nLeurs vies sont courtes mais ils n'oublient jamais de les vivre\nDe trouver de la joie dans chaque miette, partout où ils peuvent\nEt de rendre chaque once d'amour qui leur a été donnée\nOn ne sait jamais quand ça se terminera",shape=box,color=blue];
