		j1373778662 -> j3796661658;
	j3700797502 [label="Eh bien... une fois l'année réinitialisée, elle reviendra, n'est-ce pas?",shape=box,color=red];
		j3700797502 -> j3171156438;
	j3796661658 [label="Oh, non... Lettie, c'est tellement triste. :(",shape=box,color=red];
		j3796661658 -> j4251188360;
	j3171156438 [label="Sí\nEn effet\nMais cela ne change pas le fait que par nature, la vie\nEst courte",shape=box,color=blue];
		j3171156438 -> j956349694;
	j4251188360 [label="Merci\nMais c'est la nature de la vie\nElle est courte",shape=box,color=blue];
		j4251188360 -> j956349694;
	j956349694 [label="Les rats vivent une courte vie pour les gens\nLes gens vivent une courte vie pour les arbres\nLes arbres vivent une courte vie pour les dieux",shape=box,color=blue];
		j956349694 -> j1874816180;
	j1874816180 [label="Et les insectes vivent une vie courte pour les rats\nTout est relatif\nEt nous continuons encore et encore en boucle, n'est-ce pas jajaja",shape=box,color=blue];
