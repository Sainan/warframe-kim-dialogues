	j1621061872 [label="Salut Lettie. Tu es occupée? [Demander le consentement pour avoir plusieurs partenaires.]",shape=box,color=red];
		j1621061872 -> j1100344704;
	j1236492152 [label="[Fin.]",shape=box,color=red];
		j1236492152 -> j3702107533;
	j1100344704 [label="Toujours\nMais pour toi?\n¿Qué?",shape=box,color=blue];
		j1100344704 -> j1686300791;
	j3702107533 [label="Boolean LettieConsentComplete is now true.",color=orange];
		j3702107533 -> "Chat ends.";
	j1686300791 [label="Je veux te parler de quelque chose et je veux m'assurer que ça ne te dérange pas.",shape=box,color=red];
		j1686300791 -> j220105609;
	j220105609 [label="Il est important pour moi que tu n'aies pas l'impression que je te mens ou que je suis malhonnête avec toi de quelque manière que ce soit.",shape=box,color=red];
		j220105609 -> j1061869186;
		j220105609 -> j487163811;
		j220105609 -> j18739677;
	j1061869186 [label="S'il te plaît, ne me fais pas de mal.",shape=box,color=red];
		j1061869186 -> j3576198233;
	j487163811 [label="S'il te plaît, ne te fâche pas.",shape=box,color=red];
		j487163811 -> j3356095260;
	j18739677 [label="J'espère que tu comprends.",shape=box,color=red];
		j18739677 -> j724793259;
	j3576198233 [label="Jajajajaj\nOn en a déjà parlé\nJe ne te fais mal que comme tu aimes\nDe quoi tu parles, là?",shape=box,color=blue];
		j3576198233 -> j2454425394;
	j3356095260 [label="¿Sí?\nEt me fâcher à propos de quoi?",shape=box,color=blue];
		j3356095260 -> j2454425394;
	j724793259 [label="¿Sí?\nEt qu'y a-t-il à comprendre?",shape=box,color=blue];
		j724793259 -> j2454425394;
	j2454425394 [label="Je ne veux pas te mettre dans une situation qui pourrait te déplaire. Je sais que nous n'en avons jamais parlé. Alors, si tu dis non, ce n'est pas grave. Je voulais juste que tu le saches.",shape=box,color=red];
		j2454425394 -> j2970402572;
	j2970402572 [label="Ce que nous avons est important pour moi, très important, et c'est réel. Je ne veux pas que tu en doutes.",shape=box,color=red];
		j2970402572 -> j356699811;
	j356699811 [label="Aah, entiendo...\nTu sais que ce n'est pas comme ça que je fonctionne d'habitude\nJe suppose que je veux juste savoir\nEst-ce que tu tiens vraiment à cette personne, solecito?\n¿Quiénes son?\nEst-ce que tu tiens vraiment à elle?",shape=box,color=blue];
		j356699811 -> j1384194885;
		j356699811 -> j2303764712;
	j1384194885 [label="Oui. Mais je tiens aussi énormément à toi.",shape=box,color=red];
		j1384194885 -> j3775503968;
	j2303764712 [label="J'aurais dû me douter que tu comprendrais rapidement.",shape=box,color=red];
		j2303764712 -> j3536056958;
	j3775503968 [label="Ay, sí\nDifficile de t'en vouloir, tu vois tant de choses\nTu voyages tellement\nMais ne me demande pas de participer\nÇa me va très bien",shape=box,color=blue];
		j3775503968 -> j2151019073;
	j3536056958 [label="J'ai triché\nEleanor m'avait prévenue\nJajaja quelle commère",shape=box,color=blue];
		j3536056958 -> j370886218;
	j2151019073 [label="Mais personne de l'Hexagone\nMi familia no, ¿por favor?\nJe devrais me frotter avec des lingettes désinfectantes pendant une semaine",shape=box,color=blue];
		j2151019073 -> j3564992420;
	j370886218 [label="Difficile de t'en vouloir, tu vois tant de choses\nTu voyages tellement\nMais ne me demande pas de participer\nÇa me va très bien",shape=box,color=blue];
		j370886218 -> j2151019073;
	j3564992420 [label="+20 Chemistry",color=orange];
		j3564992420 -> j1725019637;
	j1725019637 [label="Tu comptes énormément pour moi, solecito\nEt si cette personne fait ton bonheur?\nAlors je suis heureuse aussi\nC'est aussi simple que ça",shape=box,color=blue];
		j1725019637 -> j2523485471;
	j2523485471 [label="Oh\nEt trouve un moyen de l'inviter ici un jour\nJe veux qu'on se rencontre",shape=box,color=blue];
		j2523485471 -> j3510273739;
		j2523485471 -> j3305927903;
	j3510273739 [label="Oui madame. :)",shape=box,color=red];
		j3510273739 -> j3702107533;
	j3305927903 [label="Je vais voir ce que je peux faire.",shape=box,color=red];
		j3305927903 -> j3702107533;
}