		j3583486497 -> j2936609281;
	j3819703758 [label="Sí, jaja\nTu n'as pas tort \nJe... m'énerve quand j'ai peur, babas, et ce n'est pas de ta faute",shape=box,color=blue];
		j3819703758 -> j3583486497;
	j3072818583 [label="De quoi tu as si peur?",shape=box,color=red];
