	j705320834 [label="Los fantasmas que nous sommes devenus \nCette éternité de... ça...\nSans changement, sans mort",shape=box,color=blue];
		j705320834 -> j3425132744;
	"Chat ends." [color=orange];
	j3425132744 [label="Ça me TERRIFIE, babas \nDonc, le fait que tu puisses simplement PARTIR \nMais tu dis que tu NE LE FERAS PAS?! \nNon, c'est impossible",shape=box,color=blue];
		j3425132744 -> j1853717726;
	j1853717726 [label="Je courrais aussi loin et aussi vite que possible pour partir d'ici \nEt je ne regarderais jamais en arrière",shape=box,color=blue];
		j1853717726 -> j673197613;
		j1853717726 -> j398145324;
	j673197613 [label="Je suppose que c'est parce que j'ai déjà vécu une boucle auparavant que je n'en ai pas si peur.",shape=box,color=red];
		j673197613 -> j2455340514;
	j398145324 [label="Ouais, mais... J'ai quelque chose d'important qui me retient ici.",shape=box,color=red];
