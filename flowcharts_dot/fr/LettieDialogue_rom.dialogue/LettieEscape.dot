	j2455340514 [label="Sí, tu as de l'expérience\nMais tu t'ennuieras avec le temps \nComme Amir avec ses petits jeux",shape=box,color=blue];
		j2455340514 -> j2343479923;
	j3078940324 [label="¿Sí? \n¿Qué es?",shape=box,color=blue];
