digraph {
	"LyonRank3Convo3 begins." [color=orange];
		"LyonRank3Convo3 begins." -> j3765208945;
	j3765208945 [label="J'assistais M. Loid dans sa bibliothèque, en remettant des livres sur les étagères, même s'il insistait sur le fait que ces étranges engins volants... pouvaient le faire à ma place.",shape=box,color=blue];
		j3765208945 -> j3159611485;
	j3159611485 [label="Et je suis tombé sur un curieux ouvrage relatant des contes pour enfants, se déroulant dans un monde imaginaire et écrits par une certaine Euleria Entrati.",shape=box,color=blue];
		j3159611485 -> j2581560288;
	j2581560288 [label="Remarquant que l'auteur avait le même nom de famille que notre \"Cardinal Dimanche\", j'ai immédiatement mis l'exemplaire de côté pour moi.",shape=box,color=blue];
		j2581560288 -> j3464859845;
		j2581560288 -> j1344526052;
		j2581560288 -> j4177999804;
	j3464859845 [label="Je crois savoir de quel livre tu veux parler...",shape=box,color=red];
		j3464859845 -> j3521369408;
	j1344526052 [label="Peut-on passer l'introduction? Pose-moi les questions que tu veux.",shape=box,color=red];
		j1344526052 -> j2329568721;
	j4177999804 [label="[Ignorer.]",shape=box,color=red];
		j4177999804 -> "Chat ends.";
	j3521369408 [label="+5 Chemistry",color=orange];
		j3521369408 -> j1761855079;
	j2329568721 [label="Boolean LyonMITW1 is now true.",color=orange];
		j2329568721 -> j1027087441;
	"Chat ends." [color=orange];
	j1761855079 [label="À en juger par le regard horrifié que m'a lancé M. Loid et par son insistance à ce que je remette immédiatement le livre en place, \"de peur de te contrarier\", je suppose que tu sais effectivement quelque chose.",shape=box,color=blue];
		j1761855079 -> j3203173517;
	j1027087441 [label="Ma question porte sur la nature de \"l'incarnation conceptuelle\". Après l'avoir lu, j'ai compris que le livre visait à apprendre aux enfants à empêcher leurs émotions d'interagir avec le Néant.",shape=box,color=blue];
		j1027087441 -> j3399847609;
		j1027087441 -> j3731237173;
	j3203173517 [label="\"Les Contes de Duviri\". J'ai reçu de M. Loid une explication plutôt... lasse et pleine de souffrance concernant ce que tu avais enduré, mais il y a un point particulier sur lequel je voudrais m'enquérir.",shape=box,color=blue];
		j3203173517 -> j395271414;
	j3399847609 [label="Pour le peu de bien que ça a fait. Surtout dans mon cas.",shape=box,color=red];
		j3399847609 -> j2549286295;
	j3731237173 [label="Des émotions fortes interagissant avec le Néant peuvent causer... de sérieux problèmes.",shape=box,color=red];
		j3731237173 -> j1799798295;
	j395271414 [label="Si, bien sûr, cela ne te dérange pas trop?",shape=box,color=blue];
		j395271414 -> j1435420704;
		j395271414 -> j2076987712;
	j2549286295 [label="Quelle part de notre vie nous a été prescrite par d'autres en tant que vérité établie, pour finalement se révéler inutile une fois mise à l'épreuve?",shape=box,color=blue];
		j2549286295 -> j3785209272;
	j1799798295 [label="Il semblerait. J'ai rencontré les Cavias. On m'a parlé des Anges du Néant. J'ai vu le Murmure de mes propres yeux. ",shape=box,color=blue];
		j1799798295 -> j374643050;
	j1435420704 [label="Non. Vas-y.",shape=box,color=red];
		j1435420704 -> j2329568721;
	j2076987712 [label="Cela dépend, je suppose. Je n'ai aucune idée de ce que tu vas me demander.",shape=box,color=red];
		j2076987712 -> j172348527;
	j3785209272 [label="Boolean LyonFaith1 is now true.",color=orange];
		j3785209272 -> j3881725585;
	j374643050 [label="Telle est la nature de ma curiosité. Je me pose cette question à voix haute pour voir si tu peux m'éclairer. Quand le Néant prend forme, qu'est-ce qui s'en échappe? Est-ce \"réel\"?",shape=box,color=blue];
		j374643050 -> j1633991131;
		j374643050 -> j805620786;
		j374643050 -> j2561168663;
	j172348527 [label="+5 Chemistry",color=orange];
		j172348527 -> j110099254;
	j3881725585 [label="Je me demande souvent pourquoi ils bourrent le crâne des autres de mensonges aussi inutiles. Est-ce le pouvoir, qu'ils recherchent? L'influence? Ou penses-tu qu'ils croient sincèrement à leurs propres paroles et ignorent leurs propres contrevérités?",shape=box,color=blue];
		j3881725585 -> j1467980901;
		j3881725585 -> j3968975986;
	j1633991131 [label="Non, je crois que tout ce que le Néant crée est simplement... éphémère. Un fragment de celui ou celle qui l’a créé. Un souvenir fantomatique.",shape=box,color=red];
		j1633991131 -> j1571573037;
	j805620786 [label="Je le crois, oui. Comme une peinture réalisée par un artiste, elle peut être née de l'imagination de quelqu'un, mais elle devient réelle une fois créée.",shape=box,color=red];
		j805620786 -> j2719552306;
	j2561168663 [label="Cela dépend entièrement de ta définition de \"réel\".",shape=box,color=red];
		j2561168663 -> j2496691396;
	j110099254 [label="Oui, excuse-moi. Je ne suis pas très à l'aise pour converser de façon directe, surtout pas de cette manière si particulière. Mais je vais faire un effort.",shape=box,color=blue];
		j110099254 -> j2329568721;
	j1467980901 [label="Dans ce cas précis, je pense qu'Euleria Entrati voulait que ses écrits soient utiles. Malheureusement, ils ne m'ont pas été d'une grande aide quand j'en avais besoin.",shape=box,color=red];
		j1467980901 -> j4084460722;
	j3968975986 [label="Je ne sais pas. De quels mensonges ta tête était-elle remplie, Lyon?",shape=box,color=red];
		j3968975986 -> j3085806636;
	j1571573037 [label="Alors, les effets causés par de tels éléments du Néant ne sont-ils pas \"réels\"?",shape=box,color=blue];
		j1571573037 -> j2564696860;
	j2719552306 [label="Mais l'analogie que tu utilises n'est pas tout à fait exacte, n'est-ce pas? La matière récupérée du Néant retourne au Néant, non?",shape=box,color=blue];
		j2719552306 -> j3514577582;
	j2496691396 [label="+5 Chemistry",color=orange];
		j2496691396 -> j2819469381;
	j4084460722 [label="Pour sa défense, mon exposition au Néant a été bien plus prolongée que celle dont elle parle dans le livre.",shape=box,color=red];
		j4084460722 -> j3823588514;
	j3085806636 [label="Aucun dont je sois venu te parler.",shape=box,color=blue];
		j3085806636 -> "Chat ends.";
	j2564696860 [label="Bien des souvenirs ont poussé un homme à sombrer dans l'alcool ou l'ont incité à se suicider. Ces souvenirs ne sont-ils pas \"réels\"?",shape=box,color=blue];
		j2564696860 -> j1455880941;
	j3514577582 [label="Très bien, une pensée, alors. Un poème et une chanson existent même s'ils ne sont pas écrits.",shape=box,color=red];
		j3514577582 -> j3370499835;
	j2819469381 [label="Tu peux développer?",shape=box,color=blue];
		j2819469381 -> j2244842593;
	j3823588514 [label="+5 Chemistry",color=orange];
		j3823588514 -> j1879988846;
	j1455880941 [label="Mais alors, c'est que ce sont des forces internes qui ont agi sur lui et non des forces externes.",shape=box,color=red];
		j1455880941 -> j2996592423;
	j3370499835 [label="Mais si on l'oublie, elle cesse d'exister. Une histoire perdue dans le temps est perdue à jamais.",shape=box,color=blue];
		j3370499835 -> j271287267;
	j2244842593 [label="Comment mesure-t-on la \"réalité\" ?",shape=box,color=red];
		j2244842593 -> j3919096110;
		j2244842593 -> j3780499154;
		j2244842593 -> j493444689;
	j1879988846 [label="L'ignorance malheureuse est le meilleur espoir que l'on puisse avoir quant à la cause du mal chez autrui.",shape=box,color=blue];
		j1879988846 -> j646271219;
	j2996592423 [label="Mais quelle est la différence, telle est ma question? Si le résultat final est le même, est-ce vraiment important?",shape=box,color=blue];
		j2996592423 -> j476519723;
		j2996592423 -> j3329470754;
		j2996592423 -> j3256875898;
	j271287267 [label="Une révolution née de l'esprit de ceux qui la brandissent est une épée bien émoussée.",shape=box,color=blue];
		j271287267 -> j476519723;
		j271287267 -> j3329470754;
		j271287267 -> j3256875898;
	j3919096110 [label="Par permanence physique? Par poids et par masse? Ce qui vient du Néant n'est ici que temporairement.",shape=box,color=red];
		j3919096110 -> j2941812769;
	j3780499154 [label="Par son influence sur les événements? Ce qui est venu du Néant a changé le cours de l'histoire.",shape=box,color=red];
		j3780499154 -> j3851513380;
	j493444689 [label="Par son effet sur autrui? L'influence des \"choses\" venues du Néant a certainement eu cet effet.",shape=box,color=red];
		j493444689 -> j2777797184;
	j646271219 [label="Ma curiosité, cependant, ne porte ni sur le livre ni sur son utilité. Permets-moi cette brève digression poétique.",shape=box,color=blue];
		j646271219 -> j1537993574;
	j476519723 [label="Tu ne demandes pas si c'est \"réel\", mais si c'est \"valide\". Si elles doivent être rejetées ou non.",shape=box,color=red];
		j476519723 -> j41374003;
	j3329470754 [label="Je demanderais alors si tes Luminaires sont \"réels\" simplement parce que tu ne peux pas serrer la main de Sol ou de Lua.",shape=box,color=red];
		j3329470754 -> j4203315661;
	j3256875898 [label="Tu demandes, en quelque sorte, si toutes les \"choses\" du Néant n'existent que parce que nous les avons fait exister par notre volonté.",shape=box,color=red];
		j3256875898 -> j3448398641;
	j2941812769 [label="Tu dis donc que ce qui vient du Néant doit y retourner? Mais le Néant n'est-il pas, par définition, composé de rien?",shape=box,color=blue];
		j2941812769 -> j4088391153;
	j3851513380 [label="C'est un argument valable. Une révolution n'est pas \"réelle\" simplement parce qu'on ne peut pas la quantifier objectivement?",shape=box,color=blue];
		j3851513380 -> j2777797184;
	j2777797184 [label="Cela a certainement coûté la vie à bien des gens. Ils défendraient avec conviction cette théorie. Cependant, considère ceci:",shape=box,color=blue];
		j2777797184 -> j2611564572;
	j1537993574 [label="Je me pose cette question à voix haute pour voir si tu peux m'éclairer. Quand le Néant prend forme, qu'est-ce qui s'en échappe? Est-ce \"réel\"?",shape=box,color=blue];
		j1537993574 -> j1633991131;
		j1537993574 -> j2561168663;
		j1537993574 -> j805620786;
	j41374003 [label="+5 Chemistry",color=orange];
		j41374003 -> j4155844474;
	j4203315661 [label="Nous ne parlons pas des Luminaires. Nous parlons du Néant.",shape=box,color=blue];
		j4203315661 -> j2276026226;
		j4203315661 -> j3815507378;
		j4203315661 -> j1838593148;
		j4203315661 -> j1766197115;
	j3448398641 [label="+5 Chemistry",color=orange];
		j3448398641 -> j657608689;
	j4088391153 [label="Je suppose? Les parties du Néant avec lesquelles j'ai interagi semblent déjà marquées. Nous leur avons déjà donné une forme, une structure. Ou bien nous avons trop brouillé la frontière entre les réalités.",shape=box,color=red];
		j4088391153 -> j1735854691;
		j4088391153 -> j2621393990;
	j2611564572 [label="Une révolution n'a de légitimité que par son existence dans l'esprit de ceux qui la mettent en œuvre.",shape=box,color=blue];
		j2611564572 -> j3340344610;
	j4155844474 [label="Oui, on pourrait le formuler ainsi. Devons-nous ignorer les fantômes qui hantent nos couloirs ou, en leur prêtant la moindre attention, ne faisons-nous que les renforcer?",shape=box,color=blue];
		j4155844474 -> j2276026226;
		j4155844474 -> j3815507378;
		j4155844474 -> j1838593148;
		j4155844474 -> j1766197115;
	j2276026226 [label="Je crois que les défis auxquels nous sommes confrontés actuellement sont dangereux. Extrêmement dangereux. Et nous devons les traiter comme tels.",shape=box,color=red];
		j2276026226 -> j1020449004;
	j3815507378 [label="Les fantômes sont bien assez réels et peuvent nous faire souffrir. Mais on ne peut pas les éliminer avec une balle. En tout cas, je n'ai jamais réussi à le faire.",shape=box,color=red];
		j3815507378 -> j1812021775;
	j1838593148 [label="De quoi s'agit-il vraiment, Lyon?",shape=box,color=red];
		j1838593148 -> j270910080;
	j1766197115 [label="Je... honnêtement, je ne sais pas, Lyon. Et j'aimerais bien le savoir.",shape=box,color=red];
		j1766197115 -> j556614287;
	j657608689 [label="Oui, on pourrait le formuler ainsi, je suppose. Comment être sûrs de ne pas avoir... manifesté nos propres démons?",shape=box,color=blue];
		j657608689 -> j2276026226;
		j657608689 -> j3815507378;
		j657608689 -> j1838593148;
		j657608689 -> j1766197115;
	j1735854691 [label="Des structures entières, même Lua, ont été placées dans le Néant puis récupérées. Il ne consomme donc pas de matière par sa simple existence.",shape=box,color=red];
		j1735854691 -> j2781712526;
	j2621393990 [label="Ce que tu insinues, c'est l'existence d'un Néant \"plus profond\" où rien ne peut exister et honnêtement, je ne peux pas me prononcer à ce sujet.",shape=box,color=red];
		j2621393990 -> j1200366547;
	j3340344610 [label="Si on l'effaçait de l'esprit de tous ceux qui sont présents, elle cesserait d'exister, n'est-ce pas?",shape=box,color=blue];
		j3340344610 -> j3329470754;
		j3340344610 -> j476519723;
		j3340344610 -> j3256875898;
	j1020449004 [label="Boolean LyonReal1 is now true.",color=orange];
		j1020449004 -> j206892898;
	j1812021775 [label="Boolean LyonFake1 is now true.",color=orange];
		j1812021775 -> j1013345782;
	j270910080 [label="Boolean LyonFaith1 is now true.",color=orange];
		j270910080 -> j3429226529;
	j556614287 [label="Ton honnêteté à admettre ton ignorance est rafraîchissante. Si seulement davantage d'êtres humains possédaient ce don!",shape=box,color=blue];
		j556614287 -> j1368377940;
	j2781712526 [label="Je ne me soucie pas de la matière placée dans le Néant puis récupérée. Ce qui m'intéresse, c'est ce qui a été créé de toutes pièces à partir du Néant.",shape=box,color=blue];
		j2781712526 -> j476519723;
		j2781712526 -> j3329470754;
		j2781712526 -> j3256875898;
	j1200366547 [label="J'apprécie ta franchise. Je m'intéresse moins à ce qui ne peut exister qu'à ce qui existe déjà.",shape=box,color=blue];
		j1200366547 -> j476519723;
		j1200366547 -> j3329470754;
		j1200366547 -> j3256875898;
	j206892898 [label="Oui, je suppose que tu sais ce qui peut être détruit par la force et ce qui ne le peut pas...",shape=box,color=blue];
		j206892898 -> j3195480101;
	j1013345782 [label="C’est peut-être pour cela que tant de gens se tournent vers l’excès... pour panser une plaie béante, invisible mais douloureuse. Guérissable. Mais par la force de l’âme, non par les armes.",shape=box,color=blue];
		j1013345782 -> j3195480101;
	j3429226529 [label="J'ai manifestement mal compris. Nous en reparlerons une autre fois. Je m'excuse du dérangement.",shape=box,color=blue];
		j3429226529 -> j727687311;
	j1368377940 [label="Quoi qu'il en soit, je reste totalement indécis sur ce sujet.",shape=box,color=blue];
		j1368377940 -> j3429226529;
	j3195480101 [label="Comme toujours, je suis en proie au doute. Pardonne mon intrusion. Merci pour ton temps, Voyageur.",shape=box,color=blue];
		j3195480101 -> j727687311;
	j727687311 [label="Père Lyon Allard",shape=box,color=blue];
		j727687311 -> "Chat ends.";
}