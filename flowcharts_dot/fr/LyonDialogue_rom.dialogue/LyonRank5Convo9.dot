digraph {
	2100 [label="LyonRank5Convo9 begins.",color=orange];
		2100 -> 2101;
	2101 [label="Evaluate expressions",color=orange];
		2101 -> 2102 [label="LyonDating, LyonDatingConfession",color=purple];
		2101 -> 2103 [label="LyonDating",color=purple];
		2101 -> 2102 [label="false",color=purple];
	2102 [label="Chat ends.",color=orange];
	2103 [label="Mon miracle, je... dois m'assurer que tu as bien compris quelque chose avant de te raconter ma prochaine anecdote. ",shape=box,color=blue];
		2103 -> 2104;
	2104 [label="Il est important pour moi que tu prêtes une grande attention aux mots que je vais t'envoyer. Tu comprends?",shape=box,color=blue];
		2104 -> 2105;
		2104 -> 2106;
	2105 [label="Tu me mets mal à l'aise. Qu'y a-t-il?",shape=box,color=red];
		2105 -> 2107;
	2106 [label="Oui, je suis là. Vas-y.",shape=box,color=red];
		2106 -> 2108;
	2107 [label="Rien de mal, bien au contraire. C'est ce que tu dois vraiment comprendre: les conséquences désastreuses que je souhaite t'épargner, si jamais cela devait arriver.",shape=box,color=blue];
		2107 -> 2109;
		2107 -> 2110;
		2107 -> 2111;
	2108 [label="+5 Chemistry",color=orange];
		2108 -> 2112;
	2109 [label="J'écoute.",shape=box,color=red];
		2109 -> 2113;
	2110 [label="Tes propos ne sont pas très cohérents.",shape=box,color=red];
		2110 -> 2114;
	2111 [label="Les conséquences désastreuses de... quoi?",shape=box,color=red];
		2111 -> 2115;
	2112 [label="Merci. Avant de commencer, je tiens à t'assurer qu'il n'y a rien de mal; cependant, c'est peut-être là que résident les conséquences désastreuses que je souhaite t'épargner, si tu penses qu'elles pourraient survenir.",shape=box,color=blue];
		2112 -> 2109;
		2112 -> 2110;
		2112 -> 2111;
	2113 [label="+5 Chemistry",color=orange];
		2113 -> 2116;
	2114 [label="Oui. J'en suis parfaitement conscient.",shape=box,color=blue];
		2114 -> 2115;
	2115 [label="Permets-moi de recommencer.",shape=box,color=blue];
		2115 -> 2116;
	2116 [label="Je suis conscient que beaucoup peuvent me percevoir comme un… malade et qu'en réalité, je le suis probablement. À tout le moins, je ne suis pas tout à fait sain d'esprit.",shape=box,color=blue];
		2116 -> 2117;
	2117 [label="J'ai depuis longtemps fait la paix avec cela. Cela ne me trouble plus. Les visions qui me tourmentent, les voix, j'ai appris à vivre avec elles sans peur ni haine.",shape=box,color=blue];
		2117 -> 2118;
	2118 [label="(Ces derniers temps, je crois, un peu par dépit si je veux être honnête, mais passons.)",shape=box,color=blue];
		2118 -> 2119;
	2119 [label="Mais je souhaite que tu comprennes que si tu devais mettre un terme à ce qu'il y a entre nous, ce lien que je croyais jusqu'alors impossible entre moi et une autre personne...",shape=box,color=blue];
		2119 -> 2120;
	2120 [label="Si jamais tu laissais ton cœur s'éloigner du mien? ",shape=box,color=blue];
		2120 -> 2121;
	2121 [label="Je le supporterai, mon miracle.",shape=box,color=blue];
		2121 -> 2122;
	2122 [label="Je ne me laisserai pas consumer par ce qui m'a tourmenté. ",shape=box,color=blue];
		2122 -> 2123;
	2123 [label="Check boolean LyonAllRight",color=orange];
		2123 -> 2125 [label=true,color=green];
		2123 -> 2124 [label=false,color=brown];
	2125 [label="Pour reprendre ton expression familière, je vais bien. Je retrouverai des raisons de sourire et de rire.",shape=box,color=blue];
		2125 -> 2126;
		2125 -> 2127;
	2124 [label="Je survivrai. Je m'en sortirai. Je retrouverai des raisons de sourire et de rire.",shape=box,color=blue];
		2124 -> 2126;
		2124 -> 2127;
	2126 [label="Oh, Lyon... tu n'es pas un fardeau à mes yeux.",shape=box,color=red];
		2126 -> 2128;
	2127 [label="Tu veux dire que tu veux mettre fin à notre relation?",shape=box,color=red];
		2127 -> 2129;
	2128 [label="Je tente simplement de te libérer de toute difficulté que tu pourrais ressentir à cause de moi...",shape=box,color=blue];
		2128 -> 2130;
		2128 -> 2131;
		2128 -> 2132;
	2129 [label="Non! Pas du tout! Je tente simplement de te libérer de toute difficulté que tu pourrais ressentir à cause de moi.",shape=box,color=blue];
		2129 -> 2130;
		2129 -> 2131;
		2129 -> 2132;
	2130 [label="Ta douleur… fait écho à la mienne. Ce ne sera jamais une difficulté de t’aider à la traverser.",shape=box,color=red];
		2130 -> 2133;
	2131 [label="Je ne saurais décrire ce qui m'attire chez toi. Mais tu ne seras jamais une obligation ni un fardeau.",shape=box,color=red];
		2131 -> 2134;
	2132 [label="[Rompre.] Tout ça, c'est devenu trop dur pour moi, je regrette. Il vaut peut-être mieux en rester là.",shape=box,color=red];
		2132 -> 2135;
	2133 [label="Je ne saurais exprimer à quel point mon cœur bat pour toi. Mais je suis infiniment reconnaissant que nos âmes tourmentées se soient enfin trouvées.",shape=box,color=blue];
		2133 -> 2136;
	2134 [label="À cela, je ne saurais exprimer pleinement ma gratitude et je ne pense pas que des mots puissent jamais y parvenir.",shape=box,color=blue];
		2134 -> 2136;
	2135 [label="Oui, bien sûr. Il serait hypocrite d'accepter une autre réponse à ce stade. ",shape=box,color=blue];
		2135 -> 2137;
	2136 [label="Mais maintenant que je me suis donné beaucoup de mal pour te présenter ce qui a été un préambule des plus spectaculairement complaisant...",shape=box,color=blue];
		2136 -> 2138;
		2136 -> 2139;
		2136 -> 2140;
	2137 [label="Je comprends parfaitement. Je te souhaite tout le bonheur du monde et je garderai précieusement en mémoire tous les moments passés ensemble.",shape=box,color=blue];
		2137 -> 2141;
	2138 [label="Pour quelqu'un qui était si silencieux au début, tu es devenu sacrément bavard.",shape=box,color=red];
		2138 -> 2142;
	2139 [label="Je trouve cela attachant, ne t'inquiète pas.",shape=box,color=red];
		2139 -> 2143;
	2140 [label="Tu aurais pu simplement dire: \"Je m'en sortirai très bien, tu sais, même si jamais nos chemins se séparent.\"",shape=box,color=red];
		2140 -> 2144;
	2141 [label="Je les garderai dans mon âme, même s'ils disparaissent de ma mémoire. Adieu.",shape=box,color=blue];
		2141 -> 2145;
	2142 [label="+5 Chemistry",color=orange];
		2142 -> 2146;
	2143 [label="+5 Chemistry",color=orange];
		2143 -> 2147;
	2144 [label="+5 Chemistry",color=orange];
		2144 -> 2148;
	2145 [label="Update boolean LyonDating",color=orange];
		2145 -> 2149;
	2146 [label="Bah! Si tu ne voulais pas avoir accès aux pensées les plus intimes de mon esprit, tu n'aurais pas dû fouiller dedans. Tu en es entièrement responsable.",shape=box,color=blue];
		2146 -> 2150;
	2147 [label="Je suis ravi que mes errances te plaisent. C'est précisément pour cela que je parle si peu. Peux-tu imaginer vivre cela en personne? Marie m'aurait abattu il y a des années, comme un chien enragé.",shape=box,color=blue];
		2147 -> 2150;
	2148 [label="Tu as une dose naturelle d'irrévérence et de sarcasme que je ne saurais égaler. Je te le laisse.",shape=box,color=blue];
		2148 -> 2150;
	2149 [label="Update boolean IsDating",color=orange];
		2149 -> 2151;
	2150 [label="Néanmoins, tout cela n'était qu'un prétexte à une histoire qui paraîtra désormais assez courte comparée aux autres...",shape=box,color=blue];
		2150 -> 2152;
	2151 [label="- Lyon",shape=box,color=blue];
		2151 -> 2153;
	2152 [label="Je me suis réveillé la nuit dernière d'un cauchemar. À mon réveil, des ombres m'entouraient. Ce n'est ni nouveau ni inhabituel dans mon état d'esprit. Elles planaient au-dessus de mon lit et refusaient de se dissiper.",shape=box,color=blue];
		2152 -> 2154;
	2153 [label="Chat ends.",color=orange];
	2154 [label="Je n'avais pas peur, car je savais qu'elles ne pouvaient pas me faire de mal. Pourtant, elles restaient présentes dans mon esprit. Je ne connaissais qu'une seule personne capable de m'en débarrasser.",shape=box,color=blue];
		2154 -> 2155;
	2155 [label="Me sortant péniblement du lit, je m'habillai tant bien que mal, titubant dans le brouillard de ce cauchemar persistant. Je saisis mon encensoir et m'agenouillai au milieu de la pièce, prêt à… enfin… ",shape=box,color=blue];
		2155 -> 2156;
	2156 [label="Je me suis préparé à \"faire le vide dans ma tête\". Arrêtons-nous là.",shape=box,color=blue];
		2156 -> 2157;
	2157 [label="Mais dès que j'ai fermé les yeux, mon esprit s'est égaré. Mes pensées ont dérivé… vers toi, mon miracle…",shape=box,color=blue];
		2157 -> 2158;
	2158 [label="Le son de ta voix. Le contact de ta main sur mon épaule… ",shape=box,color=blue];
		2158 -> 2159;
	2159 [label="Et les visions… se sont enfouies. Elles ont abandonné leur poste, chassées par un fantôme plus puissant… toi.",shape=box,color=blue];
		2159 -> 2160;
	2160 [label="Je me suis... levé. J'ai posé mon encensoir sur la table de nuit et... j'ai choisi de traverser le sable de Sanctum à la place...",shape=box,color=blue];
		2160 -> 2161;
		2160 -> 2162;
	2161 [label="Je comprends maintenant pourquoi tu as ressenti le besoin de ce préambule.",shape=box,color=red];
		2161 -> 2163;
	2162 [label="Je ne sais pas quoi dire...",shape=box,color=red];
		2162 -> 2164;
	2163 [label="Oui. Enfin… Au cours de ma promenade, j’ai… instantanément pris conscience du sombre danger d’un tel moment. Que tu puisses… le considérer comme une responsabilité – me percevoir comme des chaînes qui te pèsent.",shape=box,color=blue];
		2163 -> 2165;
	2164 [label="+5 Chemistry",color=orange];
		2164 -> 2166;
	2165 [label="Je t'en supplie, je prie tout dieu, d'en haut comme d'en bas: ne le fais jamais. C'est un don que tu m'as fait et je le chérirai à chaque fois qu'il se renouvellera.",shape=box,color=blue];
		2165 -> 2167;
	2166 [label="Pas besoin de mots, mon miracle... ",shape=box,color=blue];
		2166 -> 2168;
	2167 [label="Promets-moi, mon miracle, que si le moment vient où je serai devenu pour toi une cage vide… tu seras libre de moi.",shape=box,color=blue];
		2167 -> 2169;
	2168 [label="Au cours de ma promenade, j’ai… instantanément pris conscience du sombre danger d’un tel moment. Que tu puisses… le considérer comme une responsabilité – me percevoir comme des chaînes qui te pèsent.",shape=box,color=blue];
		2168 -> 2165;
	2169 [label="Je ne serai pas une prison vide pour ceux que j'aime. Ni pour toi. Ni pour Marie.",shape=box,color=blue];
		2169 -> 2170;
		2169 -> 2171;
	2170 [label="[Rompre.] Je... je ne peux pas. Je ne peux pas te le promettre, pardon.",shape=box,color=red];
		2170 -> 2172;
	2171 [label="Je le jure. ",shape=box,color=red];
		2171 -> 2173;
	2172 [label="+10 Chemistry",color=orange];
		2172 -> 2174;
	2173 [label="+10 Chemistry",color=orange];
		2173 -> 2175;
	2174 [label="Merci. Merci, mon miracle, pour ton honnêteté. Il t'a fallu du courage à ce moment précis et je t'en félicite.",shape=box,color=blue];
		2174 -> 2176;
	2175 [label="Merci. Merci, mon miracle...",shape=box,color=blue];
		2175 -> 2177;
	2176 [label="Je chérirai tous les moments passés ensemble. Je le pense plus que tu ne peux l'imaginer.",shape=box,color=blue];
		2176 -> 2178;
	2177 [label="Je suis soudainement très fatigué, comme si… un poids énorme m’avait été enlevé des épaules. Je crains de devoir aller m’allonger.",shape=box,color=blue];
		2177 -> 2179;
	2178 [label="Je les garderai dans mon âme, même s'ils disparaissent de ma mémoire. Adieu.",shape=box,color=blue];
		2178 -> 2180;
	2179 [label="- Lyon",shape=box,color=blue];
		2179 -> 2181;
	2180 [label="Update boolean LyonDating",color=orange];
		2180 -> 2182;
	2181 [label="Update boolean LyonDatingConfession",color=orange];
		2181 -> 2183;
	2182 [label="Update boolean IsDating",color=orange];
		2182 -> 2184;
	2183 [label="Chat ends.",color=orange];
	2184 [label="- Lyon",shape=box,color=blue];
		2184 -> 2185;
	2185 [label="Chat ends.",color=orange];
}