	2232 [label="+20 Chemistry",color=orange];
		2232 -> 2231;
	1186 [label="Lyon, je parlais avec Marie à propos de tes... habitudes et je me demandais si nous pouvions en parler?",shape=box,color=red];
		1186 -> 1192;
	1183 [label="[Désactiver les conversations sur l'automutilation. Vous ne perdrez pas de points de Chimie avec Lyon ou tout autre personnage.]",shape=box,color=red];
		1183 -> 1189;
	1182 [label="[Fin.]",shape=box,color=red];
		1182 -> 1188;
	1185 [label="Lyon? Pourrions-nous parler de quelque chose qui pourrait être un peu... délicat pour toi?",shape=box,color=red];
		1185 -> 1191;
	1184 [label="Lyon, je me demandais si je pouvais te parler de la raison pour laquelle tu... euh... enfin, tu te faisais du mal, si ça ne te dérange pas?",shape=box,color=red];
		1184 -> 1190;
	2231 [label="[Conversation ignorée en raison d'un avertissement précédemment défini.]",shape=box,color=blue];
		2231 -> 1057;
	1192 [label="Elle m'a prévenu que vous aviez parlé – oui, bien sûr. Cela te surprendra peut-être de voir à quel point cela me gêne peu de parler de ce trait de caractère particulier.",shape=box,color=blue];
		1192 -> 1197;
	1189 [label="Update boolean LyonPainOff",color=orange];
		1189 -> 1194;
	1188 [label="Chat ends.",color=orange];
	1191 [label="Tu peux poser des questions, mais je me réserve le droit de ne pas poursuivre la conversation si j'estime qu'elle aborde un sujet auquel je ne souhaite plus participer. ",shape=box,color=blue];
		1191 -> 1196;
	1190 [label="Mm. Je suis sincèrement surpris que tu aies mis autant de temps à t'interroger sur ce trait de caractère particulier. C'est généralement celui qui suscite le plus facilement des remarques.",shape=box,color=blue];
		1190 -> 1195;
	1057 [label="Chat ends.",color=orange];
	1197 [label="C'est généralement ce qui suscite le plus facilement des remarques, que ce soit par inquiétude, par dégoût ou par pure curiosité morbide.",shape=box,color=blue];
		1197 -> 1204;
	1194 [label="Si tu penses avoir été lâche pour avoir fait ce choix, je t'en supplie: ne pense pas ça. Car cette douleur n’est pas la tienne. C'est la mienne. Tu n'as pas demandé à endurer ce moment.",shape=box,color=blue];
		1194 -> 1198;
	1196 [label="Il s'agit du fait que tu te fais du mal, parfois. Je voulais simplement aborder le sujet avec toi, avec précaution.",shape=box,color=red];
		1196 -> 1203;
	1195 [label="Par inquiétude, par dégoût, ou par une curiosité morbide qui pourrait pousser quelqu'un à regarder à travers les barreaux de la cage d'un fou, je me le demande. Et toi, quelle est ta motivation?",shape=box,color=blue];
		1195 -> 1199;
		1195 -> 1200;
		1195 -> 1201;
		1195 -> 1202;
	1204 [label="Evaluate expressions",color=orange];
		1204 -> 1199 [label="LyonBackstory3a",color=purple];
		1204 -> 1210 [label="LyonBackstory3a",color=purple];
