		1204 -> 1210 [label="LyonBackstory3b",color=purple];
		1204 -> 1199 [label="DrifterHarmHelp",color=purple];
		1204 -> 1201 [label="DrifterHarmHelp",color=purple];
		1204 -> 1199 [label="DrifterHarmStop",color=purple];
