		1204 -> 1200 [label="DrifterHarmLoss",color=purple];
		1204 -> 1199 [label="false",color=purple];
	1198 [label="Cet engin que nous utilisons ici crée une impression d'impersonnalité voilée. Comme si nous étions protégés de tout mal qu'autrui pourrait nous infliger par les mots qu'il pourrait y taper.",shape=box,color=blue];
		1198 -> 1205;
	1203 [label="+5 Chemistry",color=orange];
		1203 -> 1209;
	1199 [label="Pardon – après réflexion, je ne peux pas faire ça. [Fin.]",shape=box,color=red];
		1199 -> 1194;
	1200 [label="[Avertissement : ce texte aborde le sujet du suicide.] J'ai... perdu quelqu'un à cause de ce genre \"d'habitude\" et je...",shape=box,color=red];
		1200 -> 1206;
	1201 [label="Je veux juste t'aider. M'assurer que tu vas bien. C'est tout.",shape=box,color=red];
		1201 -> 1207;
	1202 [label="J'ai simplement l'impression que ce n'est pas sain, que c'est quelque chose qui devrait cesser. ",shape=box,color=red];
		1202 -> 1208;
	1210 [label="Je sais que tu as dit que tu te faisais du mal avant le sérum, mais... j'imagine mal que ça ait amélioré les choses.",shape=box,color=red];
		1210 -> 1215;
	1205 [label="Je dirais plutôt le contraire: sans l'armure que nous revêtons lors de nos interactions sociales les plus banales, nous sommes dépouillés de ce qui pourrait nous protéger.",shape=box,color=blue];
		1205 -> 1211;
	1209 [label="J'apprécie la délicatesse avec laquelle tu abordes ce sujet, Voyageur. Merci. Mais je suis assez habitué à ce que ce soit un sujet de conversation. Que ce soit par inquiétude, par dégoût ou par curiosité morbide – même si je pense que tu as déjà prouvé qu'il s'agissait de la première option.",shape=box,color=blue];
		1209 -> 1199;
		1209 -> 1200;
		1209 -> 1201;
		1209 -> 1202;
	1206 [label="Update boolean DrifterHarmLoss",color=orange];
		1206 -> 1212;
	1207 [label="Update boolean DrifterHarmHelp",color=orange];
		1207 -> 1213;
	1208 [label="Update boolean DrifterHarmStop",color=orange];
		1208 -> 1214;
	1215 [label="Non, je crains que non. Ce qui était... une condition nécessaire pour me libérer des visions qui me hantaient, est devenu une condition nécessaire pour utiliser les \"dons\" de ce sérum.",shape=box,color=blue];
		1215 -> 1221;
	1211 [label="Par conséquent, dans des situations comme celles-ci... je suis parfaitement conscient que je décoche une flèche qui pourrait atteindre non pas le soldat prêt au combat, mais la jugulaire sans méfiance d'un cerf dans les bois.",shape=box,color=blue];
		1211 -> 1216;
	1212 [label="Oh, cher Voyageur... il n'y a pas de mots pour exprimer pleinement ma compassion face à ce que tu as enduré.",shape=box,color=blue];
		1212 -> 1217;
	1213 [label="Check boolean LyonAllRight",color=orange];
		1213 -> 1219 [label=true,color=green];
		1213 -> 1218 [label=false,color=brown];
	1214 [label="Je crois que tu arrives plusieurs années et un sérum de Protoframe trop tard pour mettre fin à cette obsession particulière qui est en moi – en effet, je crains que ce ne soit désormais une action plutôt nécessaire, n'est-ce pas?",shape=box,color=blue];
		1214 -> 1220;
	1221 [label="+5 Chemistry",color=orange];
		1221 -> 1226;
	1216 [label="Je te laisse donc sur ceci:",shape=box,color=blue];
		1216 -> 1222;
	1217 [label="Les mots semblent bien dérisoires face à de tels moments. Nous nous efforçons de les manier du mieux que nous pouvons et pourtant, ils semblent toujours nous faire défaut.",shape=box,color=blue];
		1217 -> 1223;
	1219 [label="J'essaie encore de ne pas rire à l'idée que je puisse un jour me sentir \"bien\". Mais j'apprécie beaucoup l'intention, Voyageur.",shape=box,color=blue];
		1219 -> 1224;
	1218 [label="J'essaie de ne pas rire à l'idée que je puisse un jour me sentir \"bien\". Mais j'apprécie beaucoup l'intention, Voyageur.",shape=box,color=blue];
		1218 -> 1224;
	1220 [label="+5 Chemistry",color=orange];
		1220 -> 1225;
	1226 [label="Si la possibilité de guérir ma tendance à m'automutiler était à ma portée avant l'injection du sérum, je crois qu'avoir rejoint la Warframe \"Harrow\" rend désormais cela tout à fait impossible.",shape=box,color=blue];
		1226 -> 1231;
	1222 [label="Nous devons nous rappeler comment trouver la force d'aider quelqu'un à se relever, même lorsque nous n'avons pas la volonté de nous tenir debout.",shape=box,color=blue];
		1222 -> 1227;
	1223 [label="Il y a trois choses que je pourrais faire, si tu me le permets, compte tenu de cette confidence.",shape=box,color=blue];
		1223 -> 1228;
	1224 [label="+5 Chemistry",color=orange];
		1224 -> 1229;
		1224 -> 1230;
	1225 [label="Mais je ne veux pas prendre à la légère ce que je considère comme une expression d'inquiétude concernant mon bien-être physique et mental, excuse-moi. Je pense simplement qu'il m'est impossible d'y mettre fin.",shape=box,color=blue];
		1225 -> 1229;
		1225 -> 1230;
	1231 [label="Si je peux me permettre d'être aussi direct, Voyageur, je ne pense pas être capable de me causer encore des blessures permanentes de cette manière.",shape=box,color=blue];
		1231 -> 1235;
	1227 [label="Voilà le véritable but d'une histoire.",shape=box,color=blue];
		1227 -> 1232;
	1228 [label="Tout d'abord, je tiens à t'assurer que je ne suis pas en danger. Si tu penses qu'une profonde et terrible haine de moi est à l'origine de mes pulsions autodestructrices, je serais ravi de te rassurer.",shape=box,color=blue];
		1228 -> 1233;
	1229 [label="Puis-je te demander pourquoi tu fais ça?",shape=box,color=red];
		1229 -> 1234;
	1230 [label="J'ai juste peur que tu ailles trop loin.",shape=box,color=red];
		1230 -> 1231;
	1235 [label="Bien que je sois incapable de l'arrogance nécessaire pour me croire invulnérable, un tel acte semble... disons... intégré au concept.",shape=box,color=blue];
		1235 -> 1241;
	1232 [label="+20 Chemistry",color=orange];
		1232 -> 1236;
	1233 [label="Bien que je connaisse cette grande mélancolie, elle n'inspire pas mon encensoir. (Marie ne le permettrait jamais, d'ailleurs. Elle est capable de me le faire avaler avant de me laisser m'en approcher à nouveau.)",shape=box,color=blue];
		1233 -> 1237;
	1234 [label="Evaluate expressions",color=orange];
		1234 -> 1240 [label="LyonBackstory3a, LyonLecture2",color=purple];
		1234 -> 1240 [label="LyonBackstory3b, LyonLecture2",color=purple];
		1234 -> 1239 [label="LyonBackstory3a",color=purple];
		1234 -> 1239 [label="LyonBackstory3b",color=purple];
		1234 -> 1238 [label="false",color=purple];
	1241 [label="+5 Chemistry",color=orange];
		1241 -> 1246;
	1236 [label="Prends soin de toi, Voyageur. On se reparlera bientôt.",shape=box,color=blue];
		1236 -> 1242;
	1237 [label="Mais jamais de telles douleurs ne m'ont murmuré à l'oreille dans la nuit, cher Voyageur. Je te le jure. Je te le promets sur tout ce qui m'est cher.",shape=box,color=blue];
		1237 -> 1243;
	1240 [label="Je t'ai dit la vérité sur ce qui me pousse à agir: la douleur dissipe les visions qui me hantent. Et cette pratique n'est pas aussi stigmatisée chez les Frères de Lua qu'elle pourrait l'être dans ta culture. Je jure sur tout ce qui m'est cher qu'il n'y a aucun secret que je te cache.",shape=box,color=blue];
		1240 -> 1245;
	1239 [label="C'est un sujet complexe, car les raisons qui me poussent à me mutiler ne sont pas uniques. Je t'ai parlé des visions qui me hantent et du fait que la douleur me libère l'esprit. Mais l'acte lui-même n'est pas aussi tabou que tu pourrais le croire.",shape=box,color=blue];
		1239 -> 1244;
	1238 [label="C'est un sujet compliqué, car les raisons qui m'ont poussé à me mutiler ne sont pas uniques. Je dois commencer par dire que la question est loin d'être aussi taboue qu'elle peut le paraître de nos jours.",shape=box,color=blue];
		1238 -> 1244;
	1246 [label="Je ne pense pas que ce que je fais soit \"bien\". Je ne pense pas que ce que je fais devrait être imité par d'autres. Je ne pense pas que ce que je fais soit enviable.",shape=box,color=blue];
		1246 -> 1251;
	1242 [label="Père Lyon Allard",shape=box,color=blue];
		1242 -> 1247;
	1243 [label="Deuxièmement, je tiens à te féliciter pour ton courage de m'avoir adressé ces mots. Il aurait été plus facile de les éviter. Tu ne l'as pas fait.",shape=box,color=blue];
		1243 -> 1248;
	1245 [label="Si tu penses qu'une profonde et terrible haine de moi est à l'origine de mes pulsions autodestructrices, je serais ravi de te rassurer.",shape=box,color=blue];
		1245 -> 1250;
	1244 [label="Chez les Frères de Lua, il existe une pratique ancienne de flagellation. Elle est rare et même de mon temps, elle était considérée comme archaïque et réservée à ceux qui étaient \"bénis par ses visions\".",shape=box,color=blue];
		1244 -> 1249;
	1251 [label="Cependant, dans mon état incroyablement unique et plutôt \"surnaturel\" au sens le plus littéral du terme, ce n'est pas non plus strictement dangereux pour moi.",shape=box,color=blue];
		1251 -> 1256;
	1247 [label="Update boolean LyonSpeech",color=orange];
		1247 -> 1252;
	1248 [label="Troisièmement, je ne comprends pas et ne comprendrai jamais le contexte des souffrances de cette personne. Et, d'une certaine manière, personne d'autre ne le comprendra jamais.",shape=box,color=blue];
		1248 -> 1253;
	1250 [label="Bien que je... connaisse cette grande mélancolie, elle n'inspire pas mon encensoir. Marie ne le permettrait jamais, pour commencer.",shape=box,color=blue];
		1250 -> 1255;
	1249 [label="Un des pères de la cathédrale me l'a enseigné peu après mon arrivée, lorsqu'il a vu que j'étais moi aussi... \"béni\" et qu'il a jugé bon de m'aider. ",shape=box,color=blue];
		1249 -> 1254;
	1256 [label="En fait, je me suis souvent demandé s'il n'existait pas un miracle de la science moderne qui pourrait me soulager de mes maux. Si j'étais en état d'accepter une telle aide, je le ferais volontiers. Je doute cependant que ma physiologie me le permette actuellement.",shape=box,color=blue];
		1256 -> 1261;
	1252 [label="Chat ends.",color=orange];
	1253 [label="Souffrir d'une manière aussi dévorante est, par définition, une chose solitaire.",shape=box,color=blue];
		1253 -> 1257;
	1255 [label="Update boolean LyonSNo",color=orange];
		1255 -> 1260;
		1255 -> 1259;
		1255 -> 1258;
	1254 [label="Update boolean LyonLecture2",color=orange];
		1254 -> 1258;
		1254 -> 1259;
		1254 -> 1260;
	1261 [label="Quoi qu'il en soit, je te l'assure, je n'en mourrai pas. C'est un fardeau que je porte depuis l'enfance. Et c'est un symptôme que j'ai décidé de préférer à la plaie purulente sous-jacente.",shape=box,color=blue];
		1261 -> 1264;
	1257 [label="Je prie simplement mon dieu, le tien et le sien, pour que tu ne gardes pas de culpabilité dans ton cœur. Car s'il y a bien une chose à pardonner en ce monde ou ailleurs, c'est le fait d'avoir connu quelqu'un qui a tant souffert.",shape=box,color=blue];
		1257 -> 1262;
	1260 [label="Et tu es certain de ne jamais... aller trop loin?",shape=box,color=red];
		1260 -> 1231;
	1259 [label="Parfois, je n'en reviens pas de l'étrangeté des pratiques religieuses.",shape=box,color=red];
		1259 -> 1263;
	1258 [label="Ça me rassure un peu, je pense.",shape=box,color=red];
		1258 -> 1231;
	1264 [label="Check boolean LyonSNo",color=orange];
		1264 -> 1267 [label=true,color=green];
		1264 -> 1268 [label=false,color=brown];
	1262 [label="+15 Chemistry",color=orange];
		1262 -> 1265;
	1263 [label="Je ne trouverai aucune raison de te contredire sur ce point. Je suis fasciné par les différences entre les cérémonies religieuses. J'apprécie énormément l'étude de toute la documentation les concernant.",shape=box,color=blue];
		1263 -> 1266;
	1267 [label="+10 Chemistry",color=orange];
		1267 -> 1271;
	1268 [label="Si tu penses qu'une profonde et terrible haine de moi est à l'origine de mes pulsions autodestructrices, je serais ravi de te rassurer.",shape=box,color=blue];
		1268 -> 1272;
	1265 [label="Prends soin de toi, Voyageur. On se reparlera bientôt.",shape=box,color=blue];
		1265 -> 1269;
	1266 [label="L'anthropologie religieuse est un sujet qui me tient particulièrement à cœur. On peut apprendre énormément d'une société et d'un peuple en étudiant leurs rituels. ",shape=box,color=blue];
		1266 -> 1270;
	1271 [label="Je te promets cependant ceci: si jamais je crains vraiment d'en arriver à un point où je ne peux plus me faire confiance, je le dirai.",shape=box,color=blue];
		1271 -> 1275;
	1272 [label="Bien que je... connaisse cette grande mélancolie, elle n'inspire pas mon encensoir. Marie ne le permettrait jamais, pour commencer.",shape=box,color=blue];
		1272 -> 1267;
	1269 [label="Père Lyon Allard",shape=box,color=blue];
		1269 -> 1273;
	1270 [label="Dans le Grand Nord, une secte des Luminaires vénère un cadavre exhumé d'un glacier. Parfaitement conservé, son âge reste un mystère. Le disque de laiton qu'il portait autour du cou était orné d'un soleil.",shape=box,color=blue];
		1270 -> 1274;
	1275 [label="À Marie, à toi, à M. Loid, même à Roathe, peu importe. Je le dirai. Je le jure.",shape=box,color=blue];
		1275 -> 1277;
		1275 -> 1278;
	1273 [label="Chat ends.",color=orange];
	1274 [label="Ils croient que le corps momifié est celui de Sol lui-même. Et ils croient qu'un jour il reviendra à la vie. Tous les cent ans, ils se préparent pour \"La Grande Veille\" et nombre de leurs fidèles boivent du vin empoisonné la veille.",shape=box,color=blue];
		1274 -> 1276;
	1277 [label="C'est tout ce que je pouvais espérer. Merci, Lyon.",shape=box,color=red];
		1277 -> 1280;
	1278 [label="Je te fais confiance. Je voulais simplement en discuter avec toi.",shape=box,color=red];
		1278 -> 1280;
	1276 [label="Inutile de préciser que, lorsque leur corps momifié ne revient pas à la vie au matin, ils ont une raison parfaitement valable pour expliquer l'erreur de leurs calculs et la date est décalée d'un siècle environ.",shape=box,color=blue];
		1276 -> 1279;
	1280 [label="Et j'apprécie profondément ton désir de savoir que je n'agis pas sous l'effet d'une pulsion autodestructrice débridée.",shape=box,color=blue];
		1280 -> 1281;
	1279 [label="Mais je me suis beaucoup éloigné du sujet.",shape=box,color=blue];
		1279 -> 1241;
	1281 [label="Je n'ai pas l'habitude d'avoir de tels compagnons dans ma vie.",shape=box,color=blue];
		1281 -> 1282;
	1282 [label="Prends soin de toi, Voyageur. On se reparlera bientôt.",shape=box,color=blue];
		1282 -> 1283;
	1283 [label="Père Lyon Allard",shape=box,color=blue];
		1283 -> 1284;
	1284 [label="Chat ends.",color=orange];
}