	j2554915869 [label="Tu as besoin de mon aide avec Monsieur Loid, n'est-ce pas?",shape=box,color=blue];
		j2554915869 -> j2293810595;
		j2554915869 -> j2429168889;
	j2278255470 [label="Oui, enfin. Je crois que je commence à comprendre comment c'est arrivé.",shape=box,color=blue];
		j2278255470 -> "Chat ends.";
	j2638834335 [label="Si seulement tu avais pu m'entendre rire! Je ne te juge pas, je compatis sincèrement plus que tu ne le penses. Et c'est pour cette raison que je vais t'aider.",shape=box,color=blue];
		j2638834335 -> j552443324;
	j1604752194 [label="Je crois que je comprends, maintenant.",shape=box,color=blue];
