	j3374372953 [label="Il semble que le diable... traîne des pieds.",shape=box,color=blue];
		j3374372953 -> j1950794645;
	j3561838712 [label="Suis-je le seul que tu aies réussi à convaincre? Je suis… impressionné.",shape=box,color=blue];
