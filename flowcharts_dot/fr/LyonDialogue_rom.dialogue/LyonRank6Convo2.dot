	j2986551651 [label="Il semble que tu as complètement échoué avec Roathe. Je ne suis pas vraiment surpris.",shape=box,color=blue];
		j2986551651 -> j634314680;
		j2986551651 -> j469010254;
	j1772402820 [label="Je t'ai promis de t'aider avec Monsieur Loid, mais il semble que quelque chose ait mal tourné.",shape=box,color=blue];
		j1772402820 -> j3291097851;
	j3247938853 [label="Mon miracle, j'ai l'impression d'avoir été distrait. Je m'excuse.",shape=box,color=blue];
		j3247938853 -> j2554915869;
	j3940519698 [label="Camarade, j'ai l'impression d'avoir été distrait. Je m'excuse.",shape=box,color=blue];
		j3940519698 -> j2554915869;
	j494494141 [label="S'il te plaît, ne commence pas. Je n'ai pas besoin de culpabiliser, merci.",shape=box,color=red];
		j494494141 -> j2278255470;
	j807081279 [label="En fait, je pense que si l'un des rats de mon amie avait dormi sur les touches et généré des mots aléatoires, ça aurait été mieux.",shape=box,color=red];
		j807081279 -> j2638834335;
	j3128310088 [label="Elle a mal compris ce que je disais.",shape=box,color=red];
		j3128310088 -> j1604752194;
	j2696347150 [label="J'ai dit des choses que je n'aurais pas dû. J'aurais tellement aimé mieux me comporter avec elle. Je pense que j'ai mal exprimé mes intentions.",shape=box,color=red];
		j2696347150 -> j1662536181;
