	j2293810595 [label="Oui.",shape=box,color=red];
		j2293810595 -> j2277326069;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j552443324 [label="Marie est mon âme sœur et le diable me doit une faveur. Je ne dirai pas de quoi il s'agit, c'est un secret que j'emporterai dans ma tombe, alors inutile de me poser des questions.",shape=box,color=blue];
		j552443324 -> j1424745156;
	j2940880586 [label="Ou, à en croire les apparences, un travail parfaitement exécuté.",shape=box,color=blue];
		j2940880586 -> "Chat ends.";
	j1455860762 [label="Je vais lui parler. Je vais voir ce que je peux faire.",shape=box,color=blue];
