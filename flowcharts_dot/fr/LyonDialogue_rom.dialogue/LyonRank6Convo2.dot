		j2627366968 -> j317356980;
	j3771047706 [label="Il semble que le diable traîne des pieds. Mais sans Marie, tu n'iras pas bien loin non plus.",shape=box,color=blue];
		j3771047706 -> j1950794645;
	j4259331984 [label="Tu as le soutien de Roathe, mais pas celui de Marie. Un problème facile à régler. Mais je dois te demander: comment as-tu fait?",shape=box,color=blue];
