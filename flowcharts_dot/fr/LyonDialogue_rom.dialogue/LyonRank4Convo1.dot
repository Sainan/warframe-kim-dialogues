	755 [label="Comment ça?",shape=box,color=blue];
		755 -> 760;
	754 [label="Je te raconterai une autre fois l'histoire de la première éclipse à laquelle j'ai assisté. Il se fait tard ici. Ou peut-être est-il tôt. Je ne saurais dire.",shape=box,color=blue];
		754 -> 759;
	748 [label="Non.",shape=box,color=red];
		748 -> 756;
	749 [label="Oui. Ce n'était pas si impressionnant.",shape=box,color=red];
		749 -> 757;
	750 [label="Oui. C'était pas mal.",shape=box,color=red];
		750 -> 757;
	751 [label="Oui. C'était incroyable.",shape=box,color=red];
		751 -> 746;
	753 [label="Oui. Crois-le ou non, ça m'a donné une horrible céphalée. Mais c'était génial.",shape=box,color=red];
		753 -> 758;
	752 [label="Oui. Crois-le ou non, ça m'a donné une horrible migraine. Mais c'était génial.",shape=box,color=red];
		752 -> 758;
	760 [label="Cette phrase te semble-t-elle familière: \"Aux carrefours vides, cherche l'éclipse. Car quand Sol et Lua seront alignés, ceux qui sont perdus retrouveront leur chemin.\"",shape=box,color=red];
		760 -> 764;
	759 [label="Update boolean LyonFirstEclipse",color=orange];
		759 -> 762;
		759 -> 763;
	756 [label="Si tu en as l'occasion, n'hésite pas.",shape=box,color=blue];
		756 -> 746;
	757 [label="Si seulement je pouvais partager ton impassibilité face à cet événement...",shape=box,color=blue];
		757 -> 746;
	758 [label="C'était probablement dû à la présence des Luminaires qui te bénissaient. Ou peut-être voulaient-ils te châtier pour un grand péché. L'un ou l'autre. Heh.",shape=box,color=blue];
		758 -> 761;
	764 [label="Célestins 18:19, tiré du Troisième Livre Orthodoxe de Lua. Où donc, par les Luminaires, as-tu entendu cela?",shape=box,color=blue];
		764 -> 767;
		764 -> 768;
	762 [label="Dès que tu seras prêt.",shape=box,color=red];
		762 -> 765;
	763 [label="J'ai hâte. Merci d'avoir pris le temps, Lyon.",shape=box,color=red];
		763 -> 766;
	761 [label="Ainsi va la voie des dieux. Leurs signes peuvent souvent être interprétés de mille façons.",shape=box,color=blue];
		761 -> 754;
	767 [label="C'est une très longue histoire. Mais il va sans dire que je pense que certains passages de tes Écritures sont désormais empreints d'Indifférence.",shape=box,color=red];
		767 -> 770;
	768 [label="Auprès de vieux amis. Ils l'utilisaient comme les deux moitiés d'un code avec leur fille qui... enfin bref.",shape=box,color=red];
		768 -> 771;
	765 [label="+5 Chemistry",color=orange];
