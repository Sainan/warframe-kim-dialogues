	771 [label="Ça implique l'Homme dans le Mur et c'est un vrai bazar.",shape=box,color=red];
		771 -> 770;
	769 [label="Oui, enfin... Cela... commence à paraître inévitable. ",shape=box,color=blue];
		769 -> 772;
	773 [label="Je... vois. J'aimerais te poser plus de questions à ce sujet prochainement, si tu me le permets. Je ne suis tout simplement pas prêt pour cela maintenant et il se fait tard, ici. Ou peut-être est-il tôt. Je ne saurais dire.",shape=box,color=blue];
