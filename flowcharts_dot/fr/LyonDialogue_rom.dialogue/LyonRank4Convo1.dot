	700 [label="Update boolean LyonSuspicious",color=orange];
		700 -> 710;
	701 [label="Je me demande dans quelle mesure nos religions se sont influencées mutuellement, intentionnellement ou non.",shape=box,color=blue];
		701 -> 704;
	698 [label="Fascinant! En tant qu'érudit religieux, j'espère que nous aurons le temps d'apprendre l'un de l'autre en détail sur nos croyances respectives.",shape=box,color=blue];
		698 -> 704;
	695 [label="C'est une longue histoire. ",shape=box,color=red];
		695 -> 707;
	696 [label="J'ai étudié plusieurs religions, mais aucune ne me convenait vraiment. Au final, je me retrouve avec une sorte de mélange hétéroclite d'éléments de l'humanité.",shape=box,color=red];
		696 -> 708;
	697 [label="Je crois ce que je ressens. Et je n'ai besoin ni d'un bâtiment ni d'un livre pour me le dire.",shape=box,color=red];
		697 -> 709;
	690 [label="Vraiment? Je suis... surpris. Surpris, mais ravi. Alors, ta curiosité n'est pas étonnante. Nos enseignements doivent être si différents de ce que tu connais. Tant de temps s’est écoulé.",shape=box,color=blue];
		690 -> 704;
	691 [label="Je respecte cela. Il y a de l'honneur à reconnaître ce que nous ne pouvons pas savoir, à percevoir la petitesse de la condition humaine.",shape=box,color=blue];
		691 -> 704;
	692 [label="Crois-moi, je ne suis pas offensé. Dans bien des cas, tu as tout à fait raison.",shape=box,color=blue];
		692 -> 705;
		692 -> 706;
	693 [label="J'avoue être jaloux que tu ne t'inquiètes pas de ce qui nous attend au-delà du voile. Si seulement davantage de gens étaient comme toi, notre monde aurait connu plus de paix.",shape=box,color=blue];
		693 -> 704;
	694 [label="C'est un sujet que j'aimerais aborder plus longuement avec toi. Simplement pas maintenant, car je ne suis pas prêt pour une telle discussion.",shape=box,color=blue];
		694 -> 704;
	688 [label="Un excellent point de départ. Connaître une culture à travers ses fêtes, c'est en connaître l'âme. Car la manière dont un peuple célèbre est celle dont on se souvient de lui. Ces moments sont les plus précieux pour ceux qui les partagent.",shape=box,color=blue];
		688 -> 702;
	689 [label="Bien sûr. Commençons par ce que tu sais peut-être déjà: Sol et Lua, le soleil et la lune. Ce sont des divinités dont les aspects sont perpétuellement changeants.",shape=box,color=blue];
		689 -> 703;
	710 [label="Hum. Permets-moi de satisfaire ta curiosité. Afin de ne pas t'ennuyer à mourir, par où aimerais-tu commencer?",shape=box,color=blue];
		710 -> 665;
		710 -> 664;
	704 [label="Et je regrette de m'être écarté du sujet. Je crains de m'en être beaucoup éloigné.",shape=box,color=blue];
		704 -> 714;
	707 [label="+20 Chemistry",color=orange];
		707 -> 717;
	708 [label="+20 Chemistry",color=orange];
		708 -> 718;
	709 [label="+20 Chemistry",color=orange];
		709 -> 719;
	705 [label="Cela ne veut pas dire pour autant que la connaissance ne m'intéresse pas.",shape=box,color=red];
		705 -> 715;
	706 [label="Et dans ton cas?",shape=box,color=red];
		706 -> 716;
	702 [label="Nos principales fêtes, les plus courantes, sont les Solstices d'hiver et d'été qui marquent le jour le plus court et le jour le plus long de l'année.",shape=box,color=blue];
		702 -> 711;
	703 [label="Apparaissant sous de nombreuses formes au fil des siècles à de nombreux croyants. Tantôt masculines, tantôt féminines. Mais toujours comme Sol, le Soleil et Lua, la Lune.",shape=box,color=blue];
		703 -> 712;
		703 -> 713;
	714 [label="Tu souhaitais en savoir plus sur l'Orthodoxie des Luminaires, n'est-ce pas? Afin de ne pas t'ennuyer à mourir, par où aimerais-tu commencer?",shape=box,color=blue];
		714 -> 665;
		714 -> 664;
	717 [label="Mm. Et c'est le genre de chose qu'il vaut mieux confier à un ami proche. Je comprends parfaitement. D'ailleurs, c'est toi qui me demandes des informations et non l'inverse.",shape=box,color=blue];
		717 -> 704;
	718 [label="Un vitrail de l'âme. Inutile lorsqu'il est laissé en pièces, mais quelle belle image il dessine une fois assemblé.",shape=box,color=blue];
		718 -> 704;
	719 [label="Le monde serait un meilleur endroit si cette foi était plus répandue.",shape=box,color=blue];
		719 -> 704;
	715 [label="Et pour cela, je salue ta curiosité et ton esprit d'érudition. ",shape=box,color=blue];
		715 -> 704;
	716 [label="Mon cas est... complexe. Mais je ne mentirai pas et ne dirai pas qu'il a été exempt de peur. Bien que la religion ait balayé de nombreuses peurs dans ma vie, elle ne les a jamais fait disparaître.",shape=box,color=blue];
		716 -> 704;
	711 [label="Ces deux fêtes sont marquées par de grands festins, qui diffèrent toutefois selon les personnes avec lesquelles on les partage. Le Solstice d'hiver se célèbre en famille et entre amis proches, tandis que le Solstice d'été se partage avec des inconnus.",shape=box,color=blue];
		711 -> 720;
		711 -> 721;
	712 [label="Ah, ça a beaucoup plus de sens maintenant.",shape=box,color=red];
		712 -> 722;
	713 [label="[Le laisser continuer.]",shape=box,color=red];
		713 -> 723;
	720 [label="Vraiment? Parle-moi davantage du Solstice d'été.",shape=box,color=red];
		720 -> 724;
	721 [label="Parle-moi davantage du Solstice d'hiver.",shape=box,color=red];
		721 -> 725;
	722 [label="Oui, certaines sectes peuvent être un peu strictes dans leur choix d'iconographie, déclarant que Sol \"doit\" être d'une certaine manière ou \"doit\" être d'une autre, mais l'Orthodoxie ne reconnaît pas cela comme un fait.",shape=box,color=blue];
		722 -> 726;
	723 [label="Chacun des Luminaires renferme de multiples aspects. Chaque aspect peut être perçu comme une fonction de l'ensemble. Lua, par exemple, est à la fois la mère, la jeune fille et la vieille femme.",shape=box,color=blue];
		723 -> 731;
	724 [label="Le Solstice d'été est un moment de partage et de rencontre, une occasion de réunir des inconnus. On se rassemble dans un champ, chacun apportant nourriture et produits faits maison, peu importe leur nature.",shape=box,color=blue];
		724 -> 728;
	725 [label="Le Solstice d'hiver est l'occasion de se préparer au froid et de chérir ceux qui nous réconfortent dans les moments les plus sombres. On décore un arbre de bougies, une pour chacun de ceux qui nous ont quittés et qui, tels les étoiles dans le ciel, nous guident.",shape=box,color=blue];
		725 -> 729;
	726 [label="Je suppose que tout ce qui a survécu jusqu'à ce lointain futur a fini par être... quelque peu confus en ce qui concerne la documentation de ma religion.",shape=box,color=blue];
		726 -> 730;
	731 [label="Mais Lua peut aussi être Celui qui guide les âmes le long du fleuve des larmes vers la nuit éternelle. La Mort elle-même. Le héraut et le messager.",shape=box,color=blue];
		731 -> 734;
	728 [label="Des bougies, du pain, des vêtements, des tableaux. Des recueils de poésie. Des couronnes de fleurs. Même venir les mains vides, mais porteur de bonnes nouvelles, est perçu comme une bénédiction.",shape=box,color=blue];
		728 -> 732;
	729 [label="Et au sommet, Sol lui-même, souffrant sur l'arbre stellaire dans les ténèbres. Son ombre s'estompe, mais il n'est pas oublié. Car voici venu le temps de Lua. Et nous la célébrons en ces temps d'ombre.",shape=box,color=blue];
		729 -> 733;
	730 [label="Je suis devenu une relique archéologique vivante. Quelle tristesse! Mais je m'égare.",shape=box,color=blue];
		730 -> 723;
	734 [label="Dans d'autres courants, la Mort est une vieille femme voilée. La représentation diffère, certes, mais elle renvoie au même esprit qui tend la main à chacun d'entre nous: la main d'argent qui souhaite nous guider à l'instant fatidique.",shape=box,color=blue];
		734 -> 737;
	732 [label="Une célébration de la vie – rires, musique, partage de toutes ces choses – commençait durant ce qui serait le plus long jour de Sol. ",shape=box,color=blue];
		732 -> 735;
	733 [label="Et tandis que nous nous rassemblons et que nous nous régalons d'une volaille rôtie, de légumes racines et de tout ce qui ne pousse pas frais dans la terre gelée, nous serrons dans nos bras ceux que nous aimons. Et nous racontons des histoires de ceux qui nous ont quittés.",shape=box,color=blue];
		733 -> 736;
	737 [label="La lune qui glisse sur le soleil pendant l'éclipse, nous guidant à travers le carrefour, en ce moment où tout est perdu.",shape=box,color=blue];
		737 -> 739;
	735 [label="Chacun était invité à se faire de nouveaux amis parmi des inconnus et à emporter chez soi ce dont il avait besoin.",shape=box,color=blue];
		735 -> 738;
	736 [label="Nous nous souvenons en cette nuit la plus longue de Lua qu'elle nous guidera, nous et notre famille, jusqu'à la fin.",shape=box,color=blue];
		736 -> 738;
	739 [label="Update boolean DrifterEclipse",color=orange];
		739 -> 741;
	738 [label="Mais la fête la plus sacrée pour les Luminaires est le Summum Bonum. C'est un événement rare, lorsque Sol et Lua s'alignent en une éclipse parfaite.",shape=box,color=blue];
		738 -> 740;
	741 [label="Check boolean VelimirEclipse",color=orange];
		741 -> 744 [label=true,color=green];
		741 -> 743 [label=false,color=brown];
	740 [label="C'est un moment merveilleux et sacré, où toute la nature réagit. As-tu eu la chance d'en être témoin?",shape=box,color=blue];
		740 -> 742;
	744 [label="Attends...",shape=box,color=red];
		744 -> 747;
	743 [label="As-tu déjà vu une éclipse?",shape=box,color=red];
		743 -> 746;
	742 [label="Update boolean DrifterEclipse",color=orange];
		742 -> 745;
	747 [label="Ça me semble... très familier.",shape=box,color=red];
		747 -> 755;
	746 [label="J'ai eu la chance d'en être témoin à deux reprises. Et à chaque fois, j'ai trouvé cela... transformateur. Si je pouvais rester suspendu à cet instant fugace pour toujours, je le ferais.",shape=box,color=blue];
		746 -> 754;
