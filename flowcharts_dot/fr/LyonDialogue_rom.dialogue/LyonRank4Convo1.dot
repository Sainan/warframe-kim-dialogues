	662 [label="C'est un sujet dont je parlerais volontiers longuement et avec joie. J'espère simplement ne pas t'ennuyer à mourir. Par où commencer?",shape=box,color=blue];
		662 -> 664;
		662 -> 665;
	675 [label="Non, c'est surtout de la curiosité.",shape=box,color=red];
		675 -> 686;
	676 [label="J'ai une religion. Similaire à la tienne, même si tu ne la reconnaîtrais pas.",shape=box,color=red];
		676 -> 687;
	674 [label="Je crois. Tu ne reconnaîtrais cependant aucune de nos pratiques.",shape=box,color=red];
		674 -> 685;
	673 [label="Je suis une personne religieuse. C'est une sorte de croyance personnelle, qui n'a pas vraiment de nom.",shape=box,color=red];
		673 -> 684;
	672 [label="Je suis la voie de Sol, comme Marie.",shape=box,color=red];
		672 -> 679;
	671 [label="Je suis comme toi, je suis la voie de Lua.",shape=box,color=red];
		671 -> 679;
	666 [label="Je suis les Luminaires, mais j'essaie de garder un chemin équilibré.",shape=box,color=red];
		666 -> 679;
	667 [label="Je crois qu'il y a quelque chose, mais je ne pense pas que les gens puissent vraiment connaître les réponses au final.",shape=box,color=red];
		667 -> 680;
	668 [label="Je ne suis pas une personne religieuse. J'ai tendance à penser que la religion est une béquille pour les peureux – sans vouloir offenser personne.",shape=box,color=red];
		668 -> 681;
	669 [label="Je ne suis pas une personne religieuse. Je ne dis pas qu'il ne pourrait pas y avoir quelque chose, mais ce n'est pas quelque chose qui m'inquiète.",shape=box,color=red];
		669 -> 682;
	670 [label="Je ne suis pas une personne religieuse. Je pense que tous les dieux, même l'Indifférence, sont le fruit de notre imagination. Sans vouloir offenser personne.",shape=box,color=red];
		670 -> 683;
	664 [label="Pourrais-tu me parler de vos fêtes?",shape=box,color=red];
