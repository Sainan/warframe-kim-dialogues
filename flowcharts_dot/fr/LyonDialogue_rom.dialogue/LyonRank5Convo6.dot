		1825 -> 1827 [label="false",color=purple];
	1826 [label="Voyageur. Une requête, si je peux me permettre?",shape=box,color=blue];
		1826 -> 1832;
		1826 -> 1831;
	1830 [label="Puis-je prendre un instant pour te féliciter pour quelque chose que je croyais jusqu'alors impossible?",shape=box,color=blue];
		1830 -> 1834;
		1830 -> 1833;
		1830 -> 1835;
	1829 [label="Je dois te présenter mes condoléances pour tes nobles efforts tragiquement éphémères concernant Marie et l'affaire du \"Cardinal\".",shape=box,color=blue];
		1829 -> 1833;
		1829 -> 1834;
		1829 -> 1835;
	1828 [label="Je suis désolé que Marie et toi n'ayez pas réussi à vous entendre au sujet du \"Cardinal\". Mais je suis au moins heureux que cela n'ait pas dégénéré en bagarre.",shape=box,color=blue];
		1828 -> 1833;
		1828 -> 1834;
		1828 -> 1835;
	1827 [label="Chat ends.",color=orange];
	1832 [label="Qu'est-ce que c'est?",shape=box,color=red];
		1832 -> 1837;
	1831 [label="[Fin.]",shape=box,color=red];
		1831 -> 1836;
	1834 [label="Je regrette certaines choses que j'ai dites, mais... ",shape=box,color=red];
		1834 -> 1839;
	1833 [label="Elle t'a tout raconté, n'est-ce pas?",shape=box,color=red];
		1833 -> 1838;
	1835 [label="[Fin.]",shape=box,color=red];
		1835 -> 1840;
	1837 [label="Essaie de convaincre Marie d'arrêter d'utiliser les necramites pour reproduire des meubles. Je ne sais déjà plus quoi faire de toutes ces chaises.",shape=box,color=blue];
		1837 -> 1841;
	1836 [label="Chat ends.",color=orange];
	1839 [label="Ce n'est pas par hasard que l'expression \"crime passionnel\" a été inventée. Si, en tant qu'êtres humains, nous n'étions pas attachés à nos convictions, la vie serait terriblement ennuyeuse, je crois.",shape=box,color=blue];
		1839 -> 1844;
	1838 [label="Oui. Nous parlons tous les soirs de ce qui s'est passé dans la journée. Et après votre conversation, elle s'est empressée de venir à mes côtés pour me faire part de ton opinion.",shape=box,color=blue];
		1838 -> 1842;
		1838 -> 1843;
	1840 [label="Chat ends.",color=orange];
	1841 [label="+20 Chemistry",color=orange];
		1841 -> 1845;
	1844 [label="Certes, plus calme. Plus paisible. Mais ennuyeuse. Il n'y aurait certainement pas d'art à proprement parler.",shape=box,color=blue];
		1844 -> 1847;
	1842 [label="Que t'a-t-elle dit?",shape=box,color=red];
		1842 -> 1846;
	1843 [label="... Et?",shape=box,color=red];
		1843 -> 1846;
	1845 [label="Et je refuse de suivre ses... suggestions créatives quant à l'endroit où Roathe devrait se les mettre.",shape=box,color=blue];
		1845 -> 1848;
	1847 [label="Mais je m'égare. Je me demande - d'après mes conversations avec elle, tes paroles l'ont touchée. Je dois te demander: étiez-vous d'accord sur la façon dont vous avez laissé les choses entre vous?",shape=box,color=blue];
		1847 -> 1851;
	1846 [label="Check boolean LyonDating",color=orange];
		1846 -> 1850 [label=true,color=green];
		1846 -> 1849 [label=false,color=brown];
	1848 [label="Chat ends.",color=orange];
	1851 [label="Evaluate expressions",color=orange];
		1851 -> 1853 [label="MarieDating, MarieFamilyFail",color=purple];
		1851 -> 1854 [label="MarieDating, MarieFamilyFail",color=purple];
		1851 -> 1858 [label="MarieFamilyFail",color=purple];
		1851 -> 1859 [label="MarieFamilyFail",color=purple];
		1851 -> 1853 [label="MarieFamilySuccess",color=purple];
		1851 -> 1860 [label="MarieEntratiCompleteA",color=purple];
		1851 -> 1855 [label="MarieEntratiCompleteB",color=purple];
		1851 -> 1856 [label="MarieEntratiCompleteB",color=purple];
		1851 -> 1857 [label="MarieEntratiCompleteC",color=purple];
		1851 -> 1861 [label="false",color=purple];
	1850 [label="Ha! Comme si j'allais te révéler ses confidences! Même si je t'apprécie énormément, mon miracle, elle est ma sœur d'âme depuis de très longues années.",shape=box,color=blue];
		1850 -> 1852;
	1849 [label="Ha! Comme si j'allais te révéler ses confidences! Même si je t'apprécie énormément, cher Voyageur, elle est ma sœur d'âme depuis de très longues années.",shape=box,color=blue];
		1849 -> 1852;
	1853 [label="Oui. Je pense qu'elle va m'aider à apaiser les tensions entre Loid et la famille du dessus. Et c'est… énorme, Lyon. Je ne crois pas pouvoir exprimer à quel point c'est énorme.",shape=box,color=red];
		1853 -> 1862;
	1854 [label="Non – honnêtement, vu la façon dont les choses se sont terminées entre nous, j'ai ruiné toutes mes chances qu'elle m'aide à arranger les histoires entre Loid et la famille du dessus.",shape=box,color=red];
		1854 -> 1863;
	1858 [label="Non – honnêtement, vu la façon dont les choses se sont terminées entre nous, j'ai ruiné toutes mes chances qu'elle m'aide à arranger les histoires entre Loid et la famille du dessus.",shape=box,color=red];
		1858 -> 1866;
	1859 [label="Oui. Elle ne m'aidera pas à arranger les choses avec Loid et sa famille, et ça me va très bien.",shape=box,color=red];
		1859 -> 1867;
	1860 [label="Oui. C'est bien qu'elle ait compris qu'Entrati n'est peut-être pas purement \"bon\" et… eh bien, il n'est pas purement \"mauvais\" non plus, n'est-ce pas?",shape=box,color=red];
		1860 -> 1868;
	1855 [label="Ce fut satisfaisant. Honnêtement, plus j'y réfléchis, plus je suis de son côté concernant Entrati.",shape=box,color=red];
		1855 -> 1867;
	1856 [label="Nous n'étions pas d'accord au sujet d'Entrati. Je n'ai pas réussi à la convaincre et... je regrette de ne pas avoir fait mieux.",shape=box,color=red];
		1856 -> 1864;
	1857 [label="Nous sommes \"d'accord sur le fait que nous ne sommes pas d'accord\" au sujet d'Entrati et je pense que c'est le mieux que nous puissions faire. Je ne crois pas que d'autres discussions puissent arranger les choses.",shape=box,color=red];
		1857 -> 1865;
	1861 [label="Honnêtement, ça va. Je ne pense pas que ça va s'améliorer ou empirer à ce stade.",shape=box,color=red];
		1861 -> 1865;
	1852 [label="Non, je crains que ses paroles ne doivent rester secrètes. Mais elle a été très touchée. Je me demande cependant si vous étiez d'accord sur la façon dont vous avez réglé les choses?",shape=box,color=blue];
		1852 -> 1851;
	1862 [label="Je crois pouvoir en saisir la grandeur, sinon l'ampleur. Je suis… très honoré d'y participer, même modestement.",shape=box,color=blue];
		1862 -> 1869;
		1862 -> 1870;
	1863 [label="Fascinant… Eh bien, vous êtes en couple maintenant, n’est-ce pas? Si quelqu’un ici avait le pouvoir de la convaincre, ce serait toi, n’est-ce pas?",shape=box,color=blue];
		1863 -> 1871;
	1866 [label="Fascinant… Eh bien, il m’arrive d’avoir une certaine… influence sur elle, aussi limitée soit-elle. Tu penses que cette réconciliation entre M. Loid et la famille éloignée d’Entrati est importante?",shape=box,color=blue];
		1866 -> 1874;
		1866 -> 1875;
	1867 [label="Je ne saurais dire si ce ton relève de la mauvaise humeur, de l'arrogance, de l'ignorance ou de l'apathie. Je vais donc opter pour un mélange des quatre et poursuivre ma journée.",shape=box,color=blue];
		1867 -> 1876;
	1868 [label="En effet. Je partage ton avis. Je ne le vois pas clairement d'un côté ou de l'autre, mais plutôt comme une personne aux motivations complexes.",shape=box,color=blue];
		1868 -> 1877;
	1864 [label="Hum. Eh bien, malheureusement, il arrive un moment où il faut savoir s'arrêter. On peut trop travailler une pâte. Un artiste peut en faire trop avec sa peinture. Et une dispute peut certainement dégénérer.",shape=box,color=blue];
		1864 -> 1872;
	1865 [label="Oui, il serait peut-être préférable de passer à d'autres sujets.",shape=box,color=blue];
		1865 -> 1873;
	1869 [label="Je ne pensais pas que tu proposerais ton aide.",shape=box,color=red];
		1869 -> 1878;
	1870 [label="Cela signifie-t-il que tu vas m'aider à convaincre Loid de monter à l'étage et de leur parler?",shape=box,color=red];
		1870 -> 1879;
	1871 [label="J'espère simplement que tu n'as pas fait de compromis dans tes paroles à son égard, en privilégiant une chose plutôt qu'une autre pour tenter de la séduire.",shape=box,color=blue];
		1871 -> 1880;
	1874 [label="Il y a tant de solitude dans ce monde, Lyon. Tant de tristesse. Pourquoi ne pas améliorer les choses quand on le peut? ",shape=box,color=red];
		1874 -> 1882;
	1875 [label="Je ne sais pas trop, c'est un instinct, une intuition. J'ai le sentiment que vous trois avez été amenés ici par Entrati à ce moment précis pour une raison bien précise.",shape=box,color=red];
		1875 -> 1883;
	1876 [label="Dommage.",shape=box,color=blue];
		1876 -> 1884;
	1877 [label="L'orgueil le motivait. La soif de connaissances. À présent, peut-être, la soif de pardon. Qui sait? Je me demande même s'il le sait lui-même.",shape=box,color=blue];
		1877 -> 1881;
	1872 [label="Je suppose que je préférerais laisser tomber. Et espérer qu'un jour elle aura l'occasion de voir Entrati tel qu'on le connaît: au mieux, quelqu'un de complexe.",shape=box,color=blue];
		1872 -> 1881;
	1873 [label="Pour ma part, je suis prêt à éviter des conversations interminables concernant le merveilleux et irréprochable \"Cardinal\".",shape=box,color=blue];
		1873 -> 1881;
	1878 [label="Je sais que je ne suis pas très affable, mais je ne suis pas un monstre non plus. Si tu souhaites mon aide, je te l'offrirai.",shape=box,color=blue];
		1878 -> 1885;
	1879 [label="Bien sûr. Si tu souhaites mon aide, je te l'offrirai.",shape=box,color=blue];
		1879 -> 1885;
	1880 [label="Ce serait une situation déplorable.",shape=box,color=blue];
		1880 -> 1886;
	1882 [label="Hum. Et qu'en est-il de la douleur que pourrait engendrer une nouvelle rencontre entre les parties concernées lorsque de telles révélations sont faites?",shape=box,color=blue];
		1882 -> 1887;
		1882 -> 1888;
	1883 [label="Et donc, tu suivrais les ordres d'Entrati en te fiant à ton \"intuition\"?",shape=box,color=blue];
		1883 -> 1889;
		1883 -> 1890;
	1884 [label="Update boolean LyonFamilyFail",color=orange];
		1884 -> 1891;
	1881 [label="J'ignore comment les choses évolueront entre M. Loid et la famille d'Entrati avec laquelle il est brouillé. Je tenais simplement à te dire que si tu as besoin de mon aide, tu l'auras.",shape=box,color=blue];
		1881 -> 1885;
	1885 [label="Evaluate expressions",color=orange];
		1885 -> 1893 [label="RoatheFamilyDelay",color=purple];
		1885 -> 1894 [label="RoatheFamilyFail",color=purple];
		1885 -> 1892 [label="false",color=purple];
	1886 [label="Tu auras mon aide, aussi insignifiante soit-elle.",shape=box,color=blue];
		1886 -> 1895;
	1887 [label="Ça va faire mal au début, c'est certain. Comme si on remettait un os cassé en place. Mais c'est la seule façon pour que ça guérisse correctement.",shape=box,color=red];
		1887 -> 1896;
	1888 [label="Je pense que ce que nous avons tous à gagner en étant ensemble est supérieur à ce que nous avons à perdre en étant séparés.",shape=box,color=red];
		1888 -> 1896;
	1889 [label="Non, mais j'ai l'habitude de protéger ceux qui en ont besoin. Et je ne peux pas les défendre, ou ce lieu, du Murmure et de l'Infestation éternellement. Mais vous deux, et peut-être même Roathe, le pouvez.",shape=box,color=red];
		1889 -> 1896;
	1890 [label="Je ne lui fais pas forcément confiance, mais je ne pense pas pour autant qu'il soit notre ennemi. J'ai le sentiment qu'une guerre se prépare et que chacun est positionné à la place qui lui incombe. C'est là que nous devons être.",shape=box,color=red];
		1890 -> 1897;
	1891 [label="Chat ends.",color=orange];
	1893 [label="Je crois cependant que tu as déjà accompli la tâche la plus ardue: convaincre Roathe.",shape=box,color=blue];
		1893 -> 1900;
	1894 [label="Je vais devoir réfléchir sérieusement à la manière de convaincre Roathe de changer d'avis… et je me demande si je vais y arriver. Et sans lui, c'est peut-être peine perdue.",shape=box,color=blue];
		1894 -> 1898;
		1894 -> 1899;
	1892 [label="Mais le plus difficile à convaincre et j'appréhende de le penser, sans doute le plus important, c'est Roathe.",shape=box,color=blue];
		1892 -> 1898;
		1892 -> 1899;
	1895 [label="Update boolean LyonFamilySuccess",color=orange];
		1895 -> 1901;
	1896 [label="+20 Chemistry",color=orange];
		1896 -> 1902;
	1897 [label="Hum. Peut-être. Mais nous ne sommes pas des pions sur un échiquier et je refuse d'être traité comme tel. Si Entrati souhaite lancer un appel de cette façon, qu'il soit plus clair.",shape=box,color=blue];
		1897 -> 1903;
	1900 [label="Ce foutu salaud est – même si je souhaiterais ardemment trouver un moyen de lui faire fermer sa bouche – utile.",shape=box,color=blue];
		1900 -> 1905;
	1898 [label="Ouais...",shape=box,color=red];
		1898 -> 1900;
	1899 [label="Pourquoi Roathe est-il si important dans toute cette histoire?",shape=box,color=red];
		1899 -> 1904;
	1901 [label="- Lyon",shape=box,color=blue];
		1901 -> 1906;
	1902 [label="En effet. Sages paroles. Très bien. Je vais lui parler. Je vais essayer de la convaincre de te reparler à ce sujet.",shape=box,color=blue];
		1902 -> 1907;
		1902 -> 1908;
	1903 [label="De ce fait, je crains de me ranger du côté des griefs de M. Loid. Je peux t'aider à le convaincre, mais je ne pense pas que tu iras bien loin sans Marie.",shape=box,color=blue];
		1903 -> 1909;
	1905 [label="Check boolean RoatheDating",color=orange];
		1905 -> 1912 [label=true,color=green];
		1905 -> 1911 [label=false,color=brown];
	1904 [label="Marie et moi sommes des étrangers. Roathe, Loid, Entrati et la fille d'Entrati sont tous contemporains. Sans compter qu'il possède des connaissances qu'il pourrait utiliser pour les protéger, si jamais les choses tournaient mal.",shape=box,color=blue];
		1904 -> 1910;
	1906 [label="+10 Chemistry",color=orange];
		1906 -> 1913;
	1907 [label="Attends… tu vas… la convaincre de m’aider avec la famille Entrati?",shape=box,color=red];
		1907 -> 1914;
	1908 [label="Je. Tu. Tu le feras?",shape=box,color=red];
		1908 -> 1914;
	1909 [label="Update boolean LyonFamilySuccess",color=orange];
		1909 -> 1915;
	1912 [label="Sans vouloir t'offenser.",shape=box,color=blue];
		1912 -> 1917;
		1912 -> 1918;
	1911 [label="Je m'égare encore. Comme je l'ai dit, le moment venu. Et justement, il est temps pour moi de te laisser.",shape=box,color=blue];
		1911 -> 1916;
	1910 [label="Même si je déteste l’admettre, Marie et moi sommes encore bien embêtés à essayer de comprendre comment utiliser la moitié des équipements de ce bâtiment alors que lui, il les maîtrise avec une facilité déconcertante.",shape=box,color=blue];
		1910 -> 1900;
	1913 [label="Chat ends.",color=orange];
	1914 [label="Check boolean LyonDating",color=orange];
		1914 -> 1920 [label=true,color=green];
		1914 -> 1919 [label=false,color=brown];
	1915 [label="Je te souhaite bonne chance. Au revoir.",shape=box,color=blue];
		1915 -> 1921;
	1917 [label="Pas de problème.",shape=box,color=red];
		1917 -> 1923;
	1918 [label="Pas de problème. Je sais qu'il ne plaît pas à tout le monde.",shape=box,color=red];
		1918 -> 1923;
	1916 [label="+20 Chemistry",color=orange];
		1916 -> 1922;
	1920 [label="Je ferai tout mon possible, mon miracle. C'est ma sœur. Mais mes moyens sont limités. Je ferai en sorte qu'elle te reparle, mais après, ce sera à toi de te débrouiller.",shape=box,color=blue];
		1920 -> 1924;
	1919 [label="Je ferai tout mon possible, cher Voyageur. C'est ma sœur. Mais mes moyens sont limités. Je ferai en sorte qu'elle te reparle, mais après, ce sera à toi de te débrouiller.",shape=box,color=blue];
		1919 -> 1924;
