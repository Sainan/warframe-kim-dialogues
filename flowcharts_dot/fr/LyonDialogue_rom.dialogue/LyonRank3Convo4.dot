		344 -> 357;
	345 [label="Je crois que l'Indifférence cherche à devenir \"humaine\". Elle a toujours été quelque chose de plus grand, de différent. Elle apprend donc à exister comme quelque chose de plus petit, nous.",shape=box,color=red];
		345 -> 358;
	346 [label="Parfois, je me demande si l'Indifférence n'a jamais vraiment eu de corps propre avant que nous n'interagissions avec elle. Alors, elle apprend à exister.",shape=box,color=red];
