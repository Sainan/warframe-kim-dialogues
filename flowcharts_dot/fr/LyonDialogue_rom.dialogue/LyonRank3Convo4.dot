		340 -> 350;
		340 -> 351;
	339 [label="Intriguant. Ai-je bien compris que ta foi a été ébranlée, ces derniers temps? Ou bien n’en as-tu jamais eu dans ton Indifférence?",shape=box,color=blue];
		339 -> 350;
		339 -> 351;
	337 [label="Je ne sais pas avec certitude si l'Indifférence était réelle avant que nous ne la rendions réelle. Je pense que nous l'avons invoquée de la même manière que j'ai invoqué Duviri.",shape=box,color=red];
