	341 [label="Hum. Oui. Marie m'en a parlé. Tu ne crois pas à l'action des forces invisibles dans notre monde, y compris celle de l'Indifférence. C'est bien ça?",shape=box,color=blue];
		341 -> 352;
		341 -> 353;
