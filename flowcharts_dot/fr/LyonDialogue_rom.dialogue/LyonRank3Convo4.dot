		342 -> 354;
	343 [label="Excuse-moi, mais je commence à m'inquiéter lorsqu'une personne se sent \"en droit\" dans un contexte quelconque, surtout lorsqu'il s'agit de prédire les motivations des autres.",shape=box,color=blue];
		343 -> 355;
