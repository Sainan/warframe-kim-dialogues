		517 -> 523;
	518 [label="Ne t'inquiète pas, je ne me laisserai pas séduire par son charme.",shape=box,color=red];
		518 -> 524;
	519 [label="C’est pourquoi je les ai interprétées comme les enseignements de Lua, comme si j’avais été choisi par les Luminaires pour porter un tel fardeau. Du moins, c’est ce que je croyais à l’époque. C’est ainsi que j’ai cherché à entrer dans les ordres.",shape=box,color=blue];
		519 -> 525;
		519 -> 526;
		519 -> 527;
	520 [label="Que Lua ait pitié de ton âme.",shape=box,color=blue];
		520 -> 528;
	521 [label="Selon nos Écritures, on ne négocie pas avec les diables; on les chasse. Mais elles ne nous ont pas préparés à cette situation particulière.",shape=box,color=blue];
		521 -> 529;
	522 [label="Peut-être. Je ne suis pas encore certain qu'il n'y ait aucun doute dans le cœur de cette créature.",shape=box,color=blue];
		522 -> 529;
	523 [label="Add -1 to Thermostat",color=orange];
		523 -> 530;
	524 [label="Add 1 to Thermostat",color=orange];
		524 -> 531;
	525 [label="Tu pensais que ces visions provenaient de Lua? Et plus maintenant?",shape=box,color=red];
		525 -> 532;
	526 [label="Quel genre d'horreurs...?",shape=box,color=red];
		526 -> 533;
	527 [label="Et maintenant, que penses-tu?",shape=box,color=red];
		527 -> 534;
	528 [label="Père Lyon Allard",shape=box,color=blue];
		528 -> 535;
	529 [label="Nous verrons bien quel chemin ce diable-là choisira d'emprunter en temps voulu, n'est-ce pas?",shape=box,color=blue];
		529 -> 536;
	530 [label="Et c'est ce qui me trouble. Le diable sourit et dit des choses sensées quand tous les autres profèrent des inepties. ",shape=box,color=blue];
		530 -> 537;
	531 [label="+20 Chemistry",color=orange];
		531 -> 538;
	532 [label="Ce que je crois est devenu... compliqué, ces derniers temps, suite à l'introduction de nouvelles informations.",shape=box,color=blue];
		532 -> 534;
	533 [label="Nous commençons à peine à aborder ces sujets, Voyageur. Ce n'est pas que je doute que tu aies été témoin, de tes propres yeux, des pires souffrances, ni que je pense que tu aies besoin que je te protège des maigres descriptions que je pourrais bien en faire.",shape=box,color=blue];
		533 -> 539;
	534 [label="Pour être tout à fait honnête, Voyageur, je ne sais plus ce que je dois croire.",shape=box,color=blue];
		534 -> 540;
	535 [label="Chat ends.",color=orange];
	536 [label="Père Lyon Allard",shape=box,color=blue];
		536 -> 541;
	537 [label="Il nous surprend au moment où nous sommes le plus ignorants, quand nous sommes vulnérables, faibles, quand nous avons besoin de réponses.",shape=box,color=blue];
		537 -> 542;
		537 -> 543;
	538 [label="Bien. Fais bien attention à ce que ça n'arrive pas. Je n'aimerais pas avoir à te remettre les idées en place. Tu as l'air d'être du genre à riposter.",shape=box,color=blue];
		538 -> 544;
	539 [label="Cela m'épuise de parler de telles choses à une personne que je viens à peine de rencontrer, pour ensuite la voir disparaître à jamais. Je préférerais éviter que cela ne se reproduise, surtout si nous sommes contraints de travailler ensemble, ne serait-ce que temporairement.",shape=box,color=blue];
