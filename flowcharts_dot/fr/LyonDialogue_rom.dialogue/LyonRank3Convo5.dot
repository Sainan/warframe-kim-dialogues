digraph {
	445 [label="LyonRank3Convo5 begins.",color=orange];
		445 -> 446;
	446 [label="Il y a eu un orage la nuit où le \"Cardinal Dimanche\" est arrivé chez nous. Il se tenait dans le sanctuaire de l'église, insensible à la tempête qui faisait rage dehors.",shape=box,color=blue];
		446 -> 447;
	447 [label="Cela aurait dû être ma première source d'inquiétude. Au lieu de cela, je me suis incliné devant lui et je l'ai salué comme j'aurais salué n'importe quel nouvel envoyé de la Sainte Mère.",shape=box,color=blue];
		447 -> 448;
	448 [label="Nous attendions un nouveau Cardinal, car le précédent était décédé des suites d'une maladie plusieurs mois auparavant.",shape=box,color=blue];
		448 -> 449;
	449 [label="Dimanche m'a accueilli avec un sourire chaleureux et une poignée de main ferme. Je lui ai demandé si son voyage avait été long. Je n'oublierai jamais sa réponse.",shape=box,color=blue];
		449 -> 450;
	450 [label="\"Ce fut difficile... mais pas long.\"",shape=box,color=blue];
		450 -> 451;
	451 [label="Cela m'avait intrigué à l'époque, tout comme le fait que son manteau était parfaitement sec. Mais j'ai laissé tomber, comme on a tous tendance à le faire dans ces circonstances.",shape=box,color=blue];
		451 -> 452;
	452 [label="Et je n'eus pas le temps d'y réfléchir car Marie, dans son empressement, arriva un instant plus tard.",shape=box,color=blue];
		452 -> 453;
	453 [label="Il s'agenouilla pour la saluer à sa hauteur, sur sa chaise, et prit ses mains dans les siennes. J'aurais dû me douter qu'il s'agissait de manipulation.",shape=box,color=blue];
		453 -> 454;
	454 [label="Après tout, il n'était pas le seul diable à avoir frappé à notre porte en pleine tempête.",shape=box,color=blue];
		454 -> 455;
	455 [label="Update boolean LyonEntrati1",color=orange];
		455 -> 456;
	456 [label="Check boolean MarieEntrati1",color=orange];
		456 -> 457 [label=true,color=green];
		456 -> 459 [label=true,color=green];
		456 -> 460 [label=true,color=green];
		456 -> 458 [label=false,color=brown];
		456 -> 457 [label=false,color=brown];
	457 [label="L'autre diable, c'était Roathe?",shape=box,color=red];
		457 -> 461;
	459 [label="Elle raconte cette histoire d'une manière très différente.",shape=box,color=red];
		459 -> 463;
	460 [label="Elle croit encore en ses bonnes intentions. Et toi?",shape=box,color=red];
		460 -> 464;
	458 [label="Je comprends que tu n'es pas un allié d'Entrati?",shape=box,color=red];
		458 -> 462;
	461 [label="Oui. Mais ça, c'est une autre histoire. Si je commence à parler de lui, ma mauvaise humeur va devenir... ",shape=box,color=blue];
		461 -> 465;
	463 [label="Oui. En effet.",shape=box,color=blue];
		463 -> 467;
		463 -> 468;
	464 [label="+5 Chemistry",color=orange];
		464 -> 469;
	462 [label="Après avoir enduré ses mensonges et sa trahison et alors qu'il continue de manipuler Marie, tu voudrais que je le sois? Non, certainement pas.",shape=box,color=blue];
		462 -> 466;
	465 [label="ingérable. Si cela ne te dérange pas, je préférerais de loin concentrer mon humeur actuelle sur les méfaits d’Entrati.",shape=box,color=blue];
		465 -> 470;
	467 [label="Elle me dit que parfois, tu vois des choses que les autres ne voient pas.",shape=box,color=red];
		467 -> 472;
	468 [label="Et? ",shape=box,color=red];
		468 -> 473;
	469 [label="Marie croit au meilleur qu'il y a dans chaque âme. C'est une qualité qu'elle a cultivée, perfectionnée et polie comme un bouclier contre le monde qui l'entoure.",shape=box,color=blue];
		469 -> 474;
		469 -> 475;
	466 [label="+5 Chemistry",color=orange];
		466 -> 471;
	470 [label="Check boolean RoatheSerum1",color=orange];
		470 -> 476 [label=true,color=green];
		470 -> 477 [label=true,color=green];
		470 -> 476 [label=false,color=brown];
		470 -> 478 [label=false,color=brown];
	472 [label="Et qu'en penserais-tu si cela s'avérait vrai, Voyageur?",shape=box,color=blue];
		472 -> 480;
	473 [label="\"Et...\" Rien du tout. Je t'ai raconté comment j’ai été témoin de l’événement, tel que je l’ai vécu. Rien de plus.",shape=box,color=blue];
		473 -> 469;
	474 [label="Marie ignore tout de ce dont Entrati est vraiment capable et des horreurs qu'il a commises au nom du \"progrès\" et maintenant, de la \"rédemption\".",shape=box,color=red];
		474 -> 481;
	475 [label="Marie est une adulte. J'admire ton désir de la protéger, mais elle est libre de choisir ce qu'elle veut croire et en qui elle a confiance.",shape=box,color=red];
		475 -> 482;
	471 [label="Souiller nos corps, détruire notre avenir, corrompre notre passé – tout cela, peut-être pourrais-je le pardonner.",shape=box,color=blue];
		471 -> 479;
	476 [label="Entrati n'a peut-être pas les meilleures manières, mais il essaie de sauver l'univers.",shape=box,color=red];
		476 -> 471;
	477 [label="Est-ce qu'il t'a forcé à devenir une Protoframe, comme Roathe?",shape=box,color=red];
		477 -> 483;
	478 [label="Bien sûr. Pourquoi es-tu contrarié par Entrati?",shape=box,color=red];
		478 -> 484;
