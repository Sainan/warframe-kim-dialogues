		480 -> 488 [label=false,color=brown];
	481 [label="La confiance est comme un vitrail. Délicate à créer. Magnifique dans sa splendeur. Tragique lorsqu'elle se brise. Et dangereuse une fois détruite.",shape=box,color=blue];
		481 -> 496;
	482 [label="La confiance est comme un vitrail. Délicate à créer. Magnifique dans sa splendeur. Tragique lorsqu'elle se brise. Et dangereuse une fois détruite.",shape=box,color=blue];
		482 -> 491;
	479 [label="Mais voir comment il a perverti Marie... comment il a utilisé sa foi en la bonté des autres à ses propres fins?",shape=box,color=blue];
		479 -> 485;
	483 [label="Non. J'avais mes raisons d'accepter l'élixir. Je savais quelle créature monstrueuse il ferait de moi. Marie aussi.",shape=box,color=blue];
		483 -> 492;
	484 [label="+5 Chemistry",color=orange];
		484 -> 471;
	486 [label="Je pense que ça m'est égal, en fin de compte?",shape=box,color=red];
		486 -> 493;
	488 [label="Ma seule question est: si tu as des hallucinations, est-ce que ces visions te dérangent?",shape=box,color=red];
		488 -> 495;
	489 [label="Ce que tu as dit l'autre jour... je me demandais si tu allais bien, c'est tout.",shape=box,color=red];
		489 -> 494;
	487 [label="Je me demandais juste si tu allais bien, c'est tout.",shape=box,color=red];
		487 -> 494;
	496 [label="+15 Chemistry",color=orange];
		496 -> 502;
	491 [label="Dans la douce lumière de Sol, elle se prélasse, aveugle aux failles qui se forment à sa surface. Incapable d'entendre les fissures qui s'approfondissent.",shape=box,color=blue];
		491 -> 497;
	485 [label="Cela, je ne le pardonnerai jamais. Cela, je veux l'extirper de sa chair avec mon encensoir jusqu'à ce qu'il implore mon salut.",shape=box,color=blue];
		485 -> 474;
		485 -> 475;
	492 [label="Nous n'avons pas été... brisés de force, comme le diable. J'ai une profonde compassion pour Roathe et tout ce qu'il a enduré.",shape=box,color=blue];
		492 -> 498;
	493 [label="Je ne vois donc pas l'intérêt de poursuivre cette conversation.",shape=box,color=blue];
		493 -> 499;
	495 [label="Pour être tout à fait franc, je ne sais pas comment répondre à cette question, Voyageur.",shape=box,color=blue];
		495 -> 501;
	494 [label="Update boolean LyonAllRight",color=orange];
		494 -> 500;
	502 [label="Si seulement je pouvais la libérer de la corruption qu'il a semée dans son esprit! Je ne peux que prier pour que tu réussisses là où j'ai échoué.",shape=box,color=blue];
		502 -> 507;
	497 [label="Ignorant le fait que les fragments de son propre chef-d'œuvre se retourneront bientôt contre elle, elle choisit de se voiler la face, face à l'inévitable conséquence.",shape=box,color=blue];
		497 -> 503;
	498 [label="Puis il ouvre la bouche pour parler.",shape=box,color=blue];
		498 -> 504;
		498 -> 505;
	499 [label="Chat ends.",color=orange];
	501 [label="Durant toute ma vie, j'ai vu des horreurs qui auraient conduit d'autres personnes à l'asile. Plus tragiquement encore, de temps à autre, mes visions se réalisaient.",shape=box,color=blue];
		501 -> 506;
	500 [label="Est-ce que je \"vais bien\"? Pour être tout à fait franc, je ne sais pas comment répondre à cette question, Voyageur.",shape=box,color=blue];
		500 -> 501;
	507 [label="Père Lyon Allard",shape=box,color=blue];
		507 -> 513;
	503 [label="Si seulement je pouvais endurer cette souffrance à sa place, je la ferais graver dans mon âme avec tant de joie. Mais ceci est pour elle et pour elle seule.",shape=box,color=blue];
		503 -> 508;
	504 [label="Il faut se rappeler comment il a été élevé. L'environnement dans lequel il a dû apprendre à survivre. Il était – et est toujours – Orokin.",shape=box,color=red];
		504 -> 509;
		504 -> 510;
	505 [label="Honnêtement, je ne le trouve pas si terrible. Je commence même à l'apprécier.",shape=box,color=red];
		505 -> 511;
	506 [label="Update boolean LyonVisions1",color=orange];
		506 -> 512;
	513 [label="Chat ends.",color=orange];
	508 [label="Je vais donc chercher à prévenir cette douleur, Voyageur. ",shape=box,color=blue];
		508 -> 514;
	509 [label="Cela ne justifie pas la situation, mais cela pourrait t'aider à faire des compromis.",shape=box,color=red];
		509 -> 515;
	510 [label="Il fait ce qu'il pense devoir faire.",shape=box,color=red];
		510 -> 516;
	511 [label="Je consulterais M. Loid pour obtenir une pommade contre ce mal. De peur qu'il ne se propage.",shape=box,color=blue];
