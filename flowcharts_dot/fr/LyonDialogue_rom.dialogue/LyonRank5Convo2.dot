		1486 -> 1491 [label="LyonBackstory3a",color=purple];
		1486 -> 1490 [label="LyonBackstory3b",color=purple];
		1486 -> 1489 [label="LyonBackstory2",color=purple];
		1486 -> 1489 [label="LyonBackstory1",color=purple];
		1486 -> 1488 [label="false",color=purple];
	1487 [label="+20 Chemistry",color=orange];
		1487 -> 490;
	1491 [label="Cher Voyageur, tu as fait preuve de patience et d'une grande bonté envers moi. Je sais que tu t'interroges après cette partie de mon histoire, la nuit où Lua était au plus sombre.",shape=box,color=blue];
		1491 -> 1493;
	1490 [label="Cher Voyageur, tu as fait preuve de patience avec moi. Je sais que tu t'interroges après cette partie de mon histoire, la nuit où Lua était au plus sombre.",shape=box,color=blue];
		1490 -> 1493;
	1489 [label="Cher Voyageur, tu m'as interrogé sur mon passé. Et je sais que tu veux aussi connaître ce passage de mon histoire: la nuit où Lua était la plus sombre.",shape=box,color=blue];
		1489 -> 1493;
	1488 [label="Cher Voyageur, je sais que tu as dû te poser des questions après mon récit et notamment à propos de la nuit où Lua était au plus sombre.",shape=box,color=blue];
		1488 -> 1493;
	490 [label="[Conversation ignorée en raison d'un avertissement précédemment défini.]",shape=box,color=blue];
		490 -> 1492;
	1493 [label="C'est une histoire que j'avais juré de ne jamais raconter. Seule Marie la connaît, car elle l'a lue dans mon journal. Et maintenant, je vais te la confier.",shape=box,color=blue];
		1493 -> 1495;
	1492 [label="Update boolean LyonConfession1",color=orange];
		1492 -> 1494;
	1495 [label="Une fois que j'aurai commencé, je ne pourrai plus m'arrêter, car il me sera impossible de recommencer. Tu devras donc me pardonner si je ne réponds pas à tes questions.",shape=box,color=blue];
		1495 -> 1499;
		1495 -> 1498;
		1495 -> 1497;
		1495 -> 1496;
	1494 [label="Chat ends.",color=orange];
	1499 [label="Bien sûr.",shape=box,color=red];
		1499 -> 1503;
	1498 [label="[Le laisser continuer.]",shape=box,color=red];
		1498 -> 1502;
	1497 [label="[Avertissement : ce texte aborde les thèmes de l’automutilation et de la maltraitance infantile. Cliquez ici pour terminer. Vous ne perdrez pas de points de Chimie avec Lyon.]",shape=box,color=red];
		1497 -> 1501;
	1496 [label="[Fin.]",shape=box,color=red];
		1496 -> 1500;
	1503 [label="Merci.",shape=box,color=blue];
		1503 -> 1507;
	1502 [label="+5 Chemistry",color=orange];
		1502 -> 1503;
	1501 [label="Check boolean LyonSpeech",color=orange];
		1501 -> 1505 [label=true,color=green];
		1501 -> 1506 [label=false,color=brown];
	1500 [label="Update boolean LyonConfessionFail",color=orange];
		1500 -> 1504;
	1507 [label="Evaluate expressions",color=orange];
		1507 -> 1511 [label="LyonBackstory3a",color=purple];
		1507 -> 1511 [label="LyonBackstory3b",color=purple];
		1507 -> 1510 [label="false",color=purple];
	1505 [label="+20 Chemistry",color=orange];
		1505 -> 1508;
	1506 [label="Si tu penses avoir été lâche pour avoir fait ce choix, je t'en supplie: ne pense pas ça. Car cette douleur n’est pas la tienne. C'est la mienne. Tu n'as pas demandé à endurer ce moment.",shape=box,color=blue];
		1506 -> 1509;
	1504 [label="Chat ends.",color=orange];
	1511 [label="Nous avons parlé de ma famille. De mon enfance à la ferme. Des visions qui m'ont hanté et poussé à la violence.",shape=box,color=blue];
		1511 -> 1515;
	1510 [label="Je sais que je ne t'ai pas beaucoup parlé de ceux qui m'ont élevé. Et je crains que ce ne soit pas sans raison.",shape=box,color=blue];
		1510 -> 1514;
	1508 [label="Update boolean LyonConfession1",color=orange];
		1508 -> 1512;
	1509 [label="Cet engin que nous utilisons ici crée une impression d'impersonnalité voilée. Comme si nous étions protégés de tout mal qu'autrui pourrait nous infliger par les mots qu'il pourrait y taper.",shape=box,color=blue];
		1509 -> 1513;
	1515 [label="Je t'ai parlé des voix que j'entendais, qui chuchotaient, qui m'appelaient depuis les autres pièces. Parfois, on aurait dit qu'elles prononçaient mon nom.",shape=box,color=blue];
		1515 -> 1518;
	1514 [label="Ma mère... interprétait mes visions comme l’œuvre du diable. Et elle cherchait à les faire disparaître à coups de baguette. Souvent jusqu’à ce que je ne puisse plus tenir debout.",shape=box,color=blue];
		1514 -> 1517;
	1512 [label="Chat ends.",color=orange];
	1513 [label="Je dirais plutôt le contraire: sans l'armure que nous revêtons lors de nos interactions sociales les plus banales, nous sommes dépouillés de ce qui pourrait nous protéger.",shape=box,color=blue];
		1513 -> 1516;
	1518 [label="Parfois, ça ne ressemblait à rien. Un charabia incompréhensible, un langage diabolique.",shape=box,color=blue];
		1518 -> 1521;
	1517 [label="Et mon père? Eh bien... Malgré toute la cruauté de ma mère, mon père était pire. Je t'épargne les détails.",shape=box,color=blue];
		1517 -> 1520;
	1516 [label="Par conséquent, dans des situations comme celles-ci... je suis parfaitement conscient que je décoche une flèche qui pourrait atteindre non pas le soldat prêt au combat, mais la jugulaire sans méfiance d'un cerf dans les bois.",shape=box,color=blue];
		1516 -> 1519;
	1521 [label="Au début, les divagations incohérentes de ces mots m'ont terrifié. Je les suppliais de les comprendre. J'ai prié Lua pour que ses esprits me révèlent leurs souhaits à mon égard.",shape=box,color=blue];
		1521 -> 1524;
	1520 [label="Mais leur violence ne doit pas occulter la mienne. Mes visions me rendaient souvent difficile à gérer, surtout une fois adulte, plus grand et plus fort physiquement que mon père lui-même.",shape=box,color=blue];
		1520 -> 1523;
	1519 [label="Je te laisse donc sur ceci:",shape=box,color=blue];
		1519 -> 1522;
	1524 [label="Mais lorsque j'ai commencé à déchiffrer ce qu'elles désiraient, j'ai regretté ce pour quoi j'avais tant prié. Car désormais, je connaissais les actes qu'elles exigeaient que j'accomplisse en leur nom.",shape=box,color=blue];
		1524 -> 1526;
	1523 [label="Et ces visions prenaient souvent la forme de voix. Parfois, elles semblaient m'appeler par mon nom.",shape=box,color=blue];
		1523 -> 1518;
	1522 [label="Nous devons nous rappeler comment trouver la force d'aider quelqu'un à se relever, même lorsque nous n'avons pas la volonté de nous tenir debout.",shape=box,color=blue];
		1522 -> 1525;
	1526 [label="Et que le prix à payer était horrible!",shape=box,color=blue];
		1526 -> 1528;
	1525 [label="Voilà le véritable but d'une histoire.",shape=box,color=blue];
		1525 -> 1527;
	1528 [label="Ne te méprends pas. Je n'ai jamais aimé ni mon père ni ma mère. La moindre loyauté familiale que j'aurais pu éprouver pour eux avait depuis longtemps disparu sous une litanie de bleus et de cicatrices.",shape=box,color=blue];
		1528 -> 1530;
	1527 [label="+20 Chemistry",color=orange];
		1527 -> 1529;
	1530 [label="Mais que me demandaient-elles de faire pour elles? Et que m'ont-elles contraint à faire, dans cette nuit si sombre?",shape=box,color=blue];
		1530 -> 1532;
	1529 [label="Prends soin de toi, Voyageur. On se reparlera bientôt.",shape=box,color=blue];
		1529 -> 1531;
	1532 [label="J'étais à peine plus qu'un garçon, pas vraiment un homme. J'avais peut-être seize ans? Dix-huit? Au début, je pensais que c'était encore un terrible cauchemar, un rêve déformé.",shape=box,color=blue];
		1532 -> 1534;
	1531 [label="Père Lyon Allard",shape=box,color=blue];
		1531 -> 1533;
	1534 [label="Des silhouettes se tenaient autour de moi, des manifestations décharnées et difformes, faites uniquement de malice et d'ombre.",shape=box,color=blue];
		1534 -> 1536;
	1533 [label="Update boolean LyonConfession1",color=orange];
		1533 -> 1535;
	1536 [label="Elles me narguaient, exigeaient que je fasse ce qui devait être fait – que si ceux qui prétendaient m’aimer voulaient ma chair... alors moi aussi, je devais avoir la leur...",shape=box,color=blue];
		1536 -> 1537;
	1535 [label="Chat ends.",color=orange];
	1537 [label="Quand je me suis réveillé de ce cauchemar, ou peut-être étais-je toujours éveillé, je ne sais plus vraiment, j'avais un couteau de chasse en main. Et je me tenais devant la porte de la chambre de mes parents.",shape=box,color=blue];
		1537 -> 1538;
	1538 [label="La lune était nouvelle. Et les nuages étaient épais. Il n'y avait pas la moindre lueur pour y voir. L'obscurité était totale. ",shape=box,color=blue];
		1538 -> 1539;
	1539 [label="Lua m'avait abandonné.",shape=box,color=blue];
		1539 -> 1540;
	1540 [label="Je n'ai pas pu répondre à l'appel des voix. Je n'ai pas pu leur livrer les âmes de ma mère et de mon père.",shape=box,color=blue];
		1540 -> 1541;
	1541 [label="Je me suis enfui dans la nuit. Dans les bois profonds, les branches lacérant ma peau nue, mais la douleur m'était totalement indifférente.",shape=box,color=blue];
		1541 -> 1542;
	1542 [label="J'ai couru jusqu'à ce que mes jambes me lâchent, incapables d'aller plus loin. J'ai peut-être pleuré, je ne sais pas.",shape=box,color=blue];
		1542 -> 1543;
	1543 [label="Mais les manifestations m'avaient suivi. Et elles murmuraient toujours pour obtenir du sang.",shape=box,color=blue];
		1543 -> 1544;
	1544 [label="J'espérais que si je ne les voyais plus, elles finiraient par disparaître... quand je me suis enfoncé ce couteau dans l'orbite...",shape=box,color=blue];
		1544 -> 1545;
	1545 [label="Quel dommage que j'aie perdu connaissance et que je n'aie pas pu terminer ma tâche. Maintenant, je ne le saurai jamais.",shape=box,color=blue];
		1545 -> 1546;
	1546 [label="À mon réveil, je me trouvais dans la paroisse de Lua. Un frère m'avait trouvé et avait pansé mes plaies. Il m'a demandé ce que j'avais fui.",shape=box,color=blue];
		1546 -> 1547;
	1547 [label="J'étais bouleversé. Je ne pouvais pas lui mentir. J'ai tout avoué: les visions, ce qu'elles m'avaient ordonné de faire. Je m'attendais à être condamné.",shape=box,color=blue];
		1547 -> 1548;
	1548 [label="Quand j'eus terminé, il se contenta de sourire avec une tristesse empreinte de compréhension et déposa une amulette de Lua dans ma paume. \"Elle est à la fois une bénédiction et une malédiction, mon fils.\"",shape=box,color=blue];
		1548 -> 1549;
	1549 [label="Il m'a envoyé à la cathédrale de la Cité de la Lumière. Et j'y suis resté jusqu'à ce qu'Entrati me retrouve...",shape=box,color=blue];
		1549 -> 1550;
	1550 [label="Voilà...",shape=box,color=blue];
		1550 -> 1551;
	1551 [label="Et maintenant, je dois y aller.",shape=box,color=blue];
		1551 -> 1552;
	1552 [label="Update boolean LyonConfession1",color=orange];
		1552 -> 1553;
	1553 [label="+20 Chemistry",color=orange];
		1553 -> 1554;
	1554 [label="- Lyon",shape=box,color=blue];
		1554 -> 1555;
	1555 [label="Chat ends.",color=orange];
}