	2063 [label="Update boolean IsDating",color=orange];
		2063 -> 2065;
	2064 [label="Néanmoins, tout cela n'était qu'un prétexte à une histoire qui paraîtra désormais assez courte comparée aux autres...",shape=box,color=blue];
		2064 -> 2066;
	2065 [label="- Lyon",shape=box,color=blue];
		2065 -> 2067;
	2066 [label="Je me suis réveillé la nuit dernière d'un cauchemar. À mon réveil, des ombres m'entouraient. Ce n'est ni nouveau ni inhabituel dans mon état d'esprit. Elles planaient au-dessus de mon lit et refusaient de se dissiper.",shape=box,color=blue];
		2066 -> 2068;
	2067 [label="Chat ends.",color=orange];
	2068 [label="Je n'avais pas peur, car je savais qu'elles ne pouvaient pas me faire de mal. Pourtant, elles restaient présentes dans mon esprit. Je ne connaissais qu'une seule personne capable de m'en débarrasser.",shape=box,color=blue];
		2068 -> 2069;
	2069 [label="Me sortant péniblement du lit, je m'habillai tant bien que mal, titubant dans le brouillard de ce cauchemar persistant. Je saisis mon encensoir et m'agenouillai au milieu de la pièce, prêt à… enfin… ",shape=box,color=blue];
		2069 -> 2070;
	2070 [label="Je me suis préparé à \"faire le vide dans ma tête\". Arrêtons-nous là.",shape=box,color=blue];
