	2060 [label="Bah! Si tu ne voulais pas avoir accès aux pensées les plus intimes de mon esprit, tu n'aurais pas dû fouiller dedans. Tu en es entièrement responsable.",shape=box,color=blue];
		2060 -> 2064;
	2061 [label="Je suis ravi que mes errances te plaisent. C'est précisément pour cela que je parle si peu. Peux-tu imaginer vivre cela en personne? Marie m'aurait abattu il y a des années, comme un chien enragé.",shape=box,color=blue];
		2061 -> 2064;
