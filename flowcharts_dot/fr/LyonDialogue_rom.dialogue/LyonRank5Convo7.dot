		2076 -> 2078;
	2077 [label="Oui. Enfin… Au cours de ma promenade, j’ai… instantanément pris conscience du sombre danger d’un tel moment. Que tu puisses… le considérer comme une responsabilité – me percevoir comme des chaînes qui te pèsent.",shape=box,color=blue];
