	2078 [label="+5 Chemistry",color=orange];
		2078 -> 2080;
	2079 [label="Je t'en supplie, je prie tout dieu, d'en haut comme d'en bas: ne le fais jamais. C'est un don que tu m'as fait et je le chérirai à chaque fois qu'il se renouvellera.",shape=box,color=blue];
		2079 -> 2081;
	2080 [label="Pas besoin de mots, mon miracle... ",shape=box,color=blue];
		2080 -> 2082;
	2081 [label="Promets-moi, mon miracle, que si le moment vient où je serai devenu pour toi une cage vide… tu seras libre de moi.",shape=box,color=blue];
		2081 -> 2083;
	2082 [label="Au cours de ma promenade, j’ai… instantanément pris conscience du sombre danger d’un tel moment. Que tu puisses… le considérer comme une responsabilité – me percevoir comme des chaînes qui te pèsent.",shape=box,color=blue];
		2082 -> 2079;
