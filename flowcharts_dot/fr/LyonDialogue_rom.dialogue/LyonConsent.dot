	2215 [label="Chat ends.",color=orange];
	2216 [label="Si tu me le permets, j'aimerais aborder brièvement un point qui, je pense, nous rassurera tous les deux, mon miracle.",shape=box,color=blue];
		2216 -> 2217;
		2216 -> 2218;
	2214 [label="Chat ends.",color=orange];
	2217 [label="[Fin.]",shape=box,color=red];
		2217 -> 2219;
	2218 [label="Quelque chose ne va pas, Lyon?",shape=box,color=red];
		2218 -> 2220;
	2219 [label="Update boolean LyonConsentComplete",color=orange];
		2219 -> 2221;
	2220 [label="Non, il n'y a rien de grave. Je voulais simplement te dire que je sais que tu passes du temps avec quelqu'un d'autre, de façon… amoureuse, quand tu n'es pas avec moi.",shape=box,color=blue];
		2220 -> 2222;
	2221 [label="Chat ends.",color=orange];
	2222 [label="Je tenais simplement à t'assurer que cela ne me cause ni inquiétude, ni malaise. Ta présence dans ma vie ne m'a apporté que paix et joie.",shape=box,color=blue];
		2222 -> 2223;
	2223 [label="Et comment pourrais-je refuser un tel cadeau à autrui?",shape=box,color=blue];
		2223 -> 2224;
		2223 -> 2225;
	2224 [label="Je pense que cette personne t'adorerait, je dois dire.",shape=box,color=red];
		2224 -> 2226;
	2225 [label="Merci. Cela me touche beaucoup.",shape=box,color=red];
		2225 -> 2227;
	2226 [label="Rien que d'y penser, ça me fait sourire. Et qui sait, peut-être que dans une autre vie, ou un autre jour, nous nous rencontrerons. ",shape=box,color=blue];
		2226 -> 2228;
	2227 [label="Comme nous sommes, comme je suis, avec tout ce que tu m'as apporté, tout ce que nous représentons… je suis comblé. Non, je suis… heureux. Pour la première fois depuis très, très longtemps.",shape=box,color=blue];
		2227 -> 2229;
	2228 [label="Mais dans cette situation, je suis content de ce que nous sommes. Non, je suis… heureux. Pour la première fois depuis très, très longtemps.",shape=box,color=blue];
		2228 -> 2229;
	2229 [label="Et c'est grâce à toi. Pour l'instant, je te laisse.",shape=box,color=blue];
		2229 -> 2230;
	2230 [label="- Lyon",shape=box,color=blue];
		2230 -> 1193;
	1193 [label="Update boolean LyonConsentComplete",color=orange];
