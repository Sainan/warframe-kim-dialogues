	"Chat ends." [color=orange];
	j1181132753 [label="Check boolean LyonConsentComplete",color=orange];
		j1181132753 -> "Chat ends." [label=true,color=green];
		j1181132753 -> j1077862033 [label=false,color=brown];
	j1316396836 [label="Check boolean LyonPolyamorySuccess",color=orange];
		j1316396836 -> j1181132753 [label=true,color=green];
		j1316396836 -> "Chat ends." [label=false,color=brown];
	j1077862033 [label="Si tu me le permets, j'aimerais aborder brièvement un point qui, je pense, nous rassurera tous les deux, mon miracle.",shape=box,color=blue];
		j1077862033 -> j1227094533;
		j1077862033 -> j1427560933;
	j1227094533 [label="[Fin.]",shape=box,color=red];
		j1227094533 -> j3944516755;
	j1427560933 [label="Quelque chose ne va pas, Lyon?",shape=box,color=red];
		j1427560933 -> j4065303876;
	j3944516755 [label="Boolean LyonConsentComplete is now true.",color=orange];
		j3944516755 -> "Chat ends.";
	j4065303876 [label="Non, il n'y a rien de grave. Je voulais simplement te dire que je sais que tu passes du temps avec quelqu'un d'autre, de façon… amoureuse, quand tu n'es pas avec moi.",shape=box,color=blue];
		j4065303876 -> j2156570649;
	j2156570649 [label="Je tenais simplement à t'assurer que cela ne me cause ni inquiétude, ni malaise. Ta présence dans ma vie ne m'a apporté que paix et joie.",shape=box,color=blue];
		j2156570649 -> j754753249;
	j754753249 [label="Et comment pourrais-je refuser un tel cadeau à autrui?",shape=box,color=blue];
		j754753249 -> j2017097411;
		j754753249 -> j3692469724;
	j2017097411 [label="Je pense que cette personne t'adorerait, je dois dire.",shape=box,color=red];
		j2017097411 -> j3904642065;
	j3692469724 [label="Merci. Cela me touche beaucoup.",shape=box,color=red];
		j3692469724 -> j1758075714;
	j3904642065 [label="Rien que d'y penser, ça me fait sourire. Et qui sait, peut-être que dans une autre vie, ou un autre jour, nous nous rencontrerons. ",shape=box,color=blue];
		j3904642065 -> j1870409216;
	j1758075714 [label="Comme nous sommes, comme je suis, avec tout ce que tu m'as apporté, tout ce que nous représentons… je suis comblé. Non, je suis… heureux. Pour la première fois depuis très, très longtemps.",shape=box,color=blue];
		j1758075714 -> j868668372;
	j1870409216 [label="Mais dans cette situation, je suis content de ce que nous sommes. Non, je suis… heureux. Pour la première fois depuis très, très longtemps.",shape=box,color=blue];
		j1870409216 -> j868668372;
	j868668372 [label="Et c'est grâce à toi. Pour l'instant, je te laisse.",shape=box,color=blue];
		j868668372 -> j698039068;
	j698039068 [label="- Lyon",shape=box,color=blue];
		j698039068 -> j3944516755;
}