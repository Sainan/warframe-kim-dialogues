		924 -> 934;
	918 [label="Ce qui se cache sous cette surface de verre fracturé, c'est...",shape=box,color=blue];
		918 -> 925;
		918 -> 926;
	919 [label="En effet. Je suppose que je ne devrais pas m'offusquer des aspects positifs qui pourraient émerger des ténèbres et des destructions de la guerre.",shape=box,color=blue];
		919 -> 927;
		919 -> 928;
