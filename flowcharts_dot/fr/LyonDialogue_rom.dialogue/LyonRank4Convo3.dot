	875 [label="J'éprouve un grand plaisir à écouter leurs plaisanteries même si, comme tu peux l'imaginer, je n'y participe pas moi-même. Je n'ai pas grand-chose à ajouter à leur conversation.",shape=box,color=blue];
		875 -> 878;
	876 [label="Je le trouve très agréable. En effet, parmi mes nouveaux... collègues, c'est celui dont la compagnie me plaît le plus.",shape=box,color=blue];
		876 -> 879;
	877 [label="Chat ends.",color=orange];
	878 [label="Cela m'inquiète toutefois de voir Roathe discuter longuement avec Oiseau-3. Je ne sais pas ce qu'il cherche en agissant ainsi.",shape=box,color=blue];
		878 -> 880;
	879 [label="Cela ne surprendra sans doute personne, j'imagine. À première vue, nous avons un comportement très similaire.",shape=box,color=blue];
