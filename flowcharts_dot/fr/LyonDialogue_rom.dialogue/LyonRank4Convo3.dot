		933 -> 942;
	934 [label="Je ne sais pas si c'est facile à comprendre pour toi, ou si cela te paraît au contraire insensé, mais – pour moi, je... peux avoir des sentiments pour plusieurs personnes à la fois.",shape=box,color=red];
