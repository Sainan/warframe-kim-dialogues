	917 [label="[Avouer ses sentiments.] Honnêtement, j'essayais de trouver comment aborder ce sujet avec toi à un moment donné.",shape=box,color=red];
		917 -> 924;
	912 [label="C'est ainsi que je suis et je ne sais comment changer. En vérité, je ne crois pas être capable de réparer les dégâts que les damnés venus me hanter ont infligés à mon âme.",shape=box,color=blue];
		912 -> 918;
