		914 -> 920;
	921 [label="Attends. Tu te méprends. Je ne t'ai pas induit en erreur. Les choses sont juste... compliquées.",shape=box,color=red];
		921 -> 931;
	922 [label="J'ai pensé que je ne t'intéressais pas.",shape=box,color=red];
		922 -> 932;
	923 [label="Mes grands-parents se sont rencontrés pendant la Révolution Gaullique. La guerre et la mort ont toujours été assez étrangement liées dans une danse passionnée et amoureuse.",shape=box,color=blue];
		923 -> 907;
	924 [label="Et maintenant, je suis profondément nerveux... Oserai-je demander pourquoi?",shape=box,color=blue];
