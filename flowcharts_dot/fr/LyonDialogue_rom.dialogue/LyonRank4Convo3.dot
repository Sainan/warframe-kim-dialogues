	892 [label="Ce que la guerre détruit me brise le cœur. Ce qu'elle peut engendrer me semble encore plus étrange.",shape=box,color=blue];
		892 -> 895;
	894 [label="Hum. C'est comme ça qu'on appelle ça maintenant? Un \"précédent\"? Quel goût exquis! Entrati a visiblement fait des siennes, mais je suis content que tu aies trouvé... de quoi te divertir.",shape=box,color=blue];
		894 -> 898;
		894 -> 899;
		894 -> 900;
	893 [label="M. Loid m'a parlé de ta \"mésaventure\" en Höllvanie dans ton passé, notre futur. Entrati a vraiment tout gâché.",shape=box,color=blue];
		893 -> 896;
		893 -> 897;
