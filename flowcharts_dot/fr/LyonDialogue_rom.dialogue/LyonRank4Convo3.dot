	901 [label="Et je suis certain que tout cela faisait partie du plan grandiose et magistral d'Entrati. Confier le destin du futur à... toi et à une bande de marginaux.",shape=box,color=blue];
		901 -> 906;
	902 [label="Mes grands-parents se sont rencontrés pendant la Révolution Gaullique. La guerre et la mort ont toujours été d'étanges compagnes, parfois même intimes.",shape=box,color=blue];
		902 -> 907;
	908 [label="Excuse-moi. Il me semble seulement que lors de notre dernière conversation, tu... ",shape=box,color=blue];
		908 -> 915;
	909 [label="Pardonne-moi. Je ne connais ni ton cœur ni celui des autres. Ce que tu fais en privé avec autrui ne regarde que toi.",shape=box,color=blue];
		909 -> 916;
		909 -> 917;
	910 [label="Excuse-moi. Non, tu as raison. Je ne veux pas paraître jaloux ni me prendre pour un provocateur. Ce que tu fais avec les autres pendant ton temps libre ne regarde que toi.",shape=box,color=blue];
		910 -> 916;
		910 -> 917;
	911 [label="Bien sûr. Pardonne-moi. Je ne connais ni ton cœur ni celui des autres. Ce que tu fais en privé avec autrui ne regarde que toi.",shape=box,color=blue];
		911 -> 916;
		911 -> 917;
	906 [label="Je... Voyageur, je sais que je ne suis pas la personne la plus... affable avec laquelle tu dois interagir et je continue de m'en excuser.",shape=box,color=blue];
