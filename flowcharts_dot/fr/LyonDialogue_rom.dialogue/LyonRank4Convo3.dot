		880 -> 882;
		880 -> 883;
	881 [label="C'est le jeune Opérateur que je trouve le plus étrange... et celle qu'ils appellent Lotus. Et la façon dont on nous tient à distance d'eux.",shape=box,color=blue];
		881 -> 884;
	882 [label="Hum. Je vais lui poser la question.",shape=box,color=red];
		882 -> 885;
	883 [label="Pourquoi cherche-t-il à obtenir quelque chose, selon toi?",shape=box,color=red];
		883 -> 886;
	884 [label="Nous avons le droit d'interagir, bien sûr. Mais pas comme ça. Pas ici. Pourquoi?",shape=box,color=blue];
		884 -> 887;
		884 -> 888;
	885 [label="C'est peut-être judicieux. Je serais navré de le voir manipuler ces créatures pour en faire des objets encore plus utiles.",shape=box,color=blue];
		885 -> 881;
	886 [label="Roathe a toujours une idée derrière la tête lorsqu'il parle à quelqu'un. Je ne voudrais surtout pas le voir manipuler ces créatures pour en faire des objets encore plus utiles.",shape=box,color=blue];
		886 -> 889;
	887 [label="L'enfant... a ses propres problèmes à gérer. On ne peut pas lui en demander davantage. Ce ne serait pas juste.",shape=box,color=red];
		887 -> 890;
	888 [label="Je... suppose que c'est parce que j'ai déjà eu un \"précédent\" avec des Protoframes?",shape=box,color=red];
		888 -> 891;
	889 [label="Cela vaut peut-être la peine d'enquêter, si tu as le temps. Mais la décision t'appartient.",shape=box,color=blue];
		889 -> 881;
	890 [label="Oui. J'ai entendu des rumeurs sur ce qu'il a été contraint d'endurer. Des récits de guerre et... d'amitiés brisées, déchirées.",shape=box,color=blue];
