		931 -> 933;
		931 -> 934;
	932 [label="Avec tout le respect que je te dois, je ne te connais pas. Et vu tout ce qu'il m'arrive, une aventure amoureuse avec une personne inconnue n'est vraiment pas ma priorité.",shape=box,color=blue];
		932 -> 941;
