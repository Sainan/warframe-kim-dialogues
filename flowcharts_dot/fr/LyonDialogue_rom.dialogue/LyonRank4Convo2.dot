digraph {
	781 [label="LyonRank4Convo2 begins.",color=orange];
		781 -> 782;
		781 -> 783;
		781 -> 784;
	782 [label="Comment est-il possible que Marie et toi puissiez concilier le fait d'être prêtre et religieuse, mais aussi... de commettre des actes de violence?",shape=box,color=red];
		782 -> 785;
		782 -> 786;
		782 -> 787;
	783 [label="Puis-je te poser une question un peu étrange, Lyon?",shape=box,color=red];
		783 -> 788;
	784 [label="[Fin.]",shape=box,color=red];
		784 -> 789;
	785 [label="J'entends Marie crier \"païens!\" et se jeter dans la mêlée et... pourtant, j'ai du mal à l'imaginer condamner quelqu'un pour des convictions différentes. J'imagine que tu ne dois pas être très différent non plus. Elle a visiblement une très haute opinion de toi.",shape=box,color=red];
		785 -> 790;
	786 [label="Que penserait votre église de ce que toi et Marie faites ici? De... ce qu’on vous demande de faire en son nom?",shape=box,color=red];
		786 -> 791;
	787 [label="Je vous observe, toi et Marie, sur le champ de bataille, puis je lui parle en privé et je te vois lire tranquillement des livres... et j’avoue avoir du mal à faire coïncider ces personnes dans mon esprit.",shape=box,color=red];
	788 [label="Si tu trouves notre situation actuelle simplement \"étrange\", je suis soit impressionné par ton courage, soit consterné par ton manque de vocabulaire. Je soupçonne toutefois qu'il s'agit de la première option.",shape=box,color=blue];
		788 -> 793;
	789 [label="Chat ends.",color=orange];
	790 [label="Tu as tout à fait raison. Marie n'est pas du genre à condamner quelqu'un pour avoir en son cœur un ancien dieu des arbres; au contraire, elle chercherait à découvrir les croyances qu'elle partage avec cette personne.",shape=box,color=blue];
		790 -> 794;
	791 [label="Nombreuses furent les guerres saintes menées en son temps au nom de Sol ou de Lua. De sanglantes \"croisades\" pour repousser les \"païens\", pour \"conquérir la terre sainte\" ou pour tout autre prétexte fallacieux en vogue à l'époque.",shape=box,color=blue];
		791 -> 795;
	793 [label="+5 Chemistry",color=orange];
		793 -> 797;
	794 [label="L'arbre ne se nourrit-il pas de la lumière de Sol, peut-être? N'y a-t-il pas un terrain d'entente entre eux, un point grâce auquel elle pourrait vouloir partager un repas? Elle est plus encline à s'asseoir et à écouter leurs histoires qu'à leur nuire à cause de leur foi.",shape=box,color=blue];
		794 -> 798;
	795 [label="L'Orthodoxie Luminaire n'a pas d'armée et ne fait pas de guerres. Mais elle n'interdit pas à ses membres d'agir ou de protéger autrui.",shape=box,color=blue];
		795 -> 727;
	797 [label="Autrement dit, oui, vas-y. Tu ne peux pas rendre la situation plus étrange pour moi en me posant la question qui t'intrigue tant.",shape=box,color=blue];
		797 -> 785;
		797 -> 786;
		797 -> 787;
	798 [label="Lorsque Marie affronte ses ennemis sur le champ de bataille, je crois que c'est pour l'une de ces deux raisons: soit elle s'amuse un peu, en jouant à la \"croisée\" de l'Antiquité, s'imaginant dans l'armure étincelante d'un chevalier de Sol;",shape=box,color=blue];
		798 -> 796;
	727 [label="Lorsque Marie affronte ses ennemis sur le champ de bataille, je crois que c'est pour l'une de ces deux raisons: soit elle s'amuse un peu, en jouant à la \"croisée\" de l'Antiquité, s'imaginant dans l'armure étincelante d'un chevalier de Sol;",shape=box,color=blue];
		727 -> 796;
	796 [label="Ou, plus probablement, elle se souvient d'Astaphor 8:23: \"Solitaires sont les âmes qui cherchent à entrer par la violence dans ma maison, car ce sont celles qui sont chassées de la lumière de Sol.\"",shape=box,color=blue];
		796 -> 799;
	799 [label="À ses yeux, la violence qu'elle commet est justifiée au nom de la défense d'un bien supérieur – comme tu le ferais aussi, comme ceux à tes côtés, je suppose. ",shape=box,color=blue];
		799 -> 800;
	800 [label="Et par conséquent, ceux qu'elle combat, quelle que soit leur religion, sont bannis par Sol. Même s'ils portaient l'habit sacré de son ordre, ils resteraient à ses yeux des païens.",shape=box,color=blue];
		800 -> 801;
		800 -> 802;
	801 [label="Je remarque que tu ne parles pas de toi dans tout ça. Que penses-tu de toutes ces batailles?",shape=box,color=red];
		801 -> 803;
	802 [label="C'est logique. Merci.",shape=box,color=red];
		802 -> 804;
	803 [label="Je reste volontairement évasif, Voyageur.",shape=box,color=blue];
		803 -> 805;
		803 -> 806;
	804 [label="+5 Chemistry",color=orange];
		804 -> 807;
	805 [label="Et je persiste avec insistance, Prêtre.",shape=box,color=red];
		805 -> 808;
	806 [label="Très bien. Je me contenterai de ce que je peux avoir aujourd'hui.",shape=box,color=red];
		806 -> 804;
	807 [label="Pour ce que ça vaut, Marie m'a dit que tu avais de bonnes intentions. Et je la crois elle, même quand je ne crois pas moi-même.",shape=box,color=blue];
		807 -> 809;
	808 [label="+10 Chemistry",color=orange];
		808 -> 810;
	809 [label="Tout ce que je peux faire, c'est te demander de faire preuve de patience. Lua sait que j'en manque moi-même la plupart du temps.",shape=box,color=blue];
		809 -> 811;
	810 [label="Très bien. Si tu persistes dans ta curiosité et que je ne peux pas t'en dissuader... Je ne suis pas aussi troublé par la mort que je provoque que... tu pourrais peut-être le penser.",shape=box,color=blue];
		810 -> 812;
	811 [label="Père Lyon Allard",shape=box,color=blue];
		811 -> 813;
	812 [label="Loin de ce que l'on pourrait estimer \"convenable\" pour un homme d'Église et un érudit comme moi.",shape=box,color=blue];
		812 -> 814;
		812 -> 815;
	813 [label="Chat ends.",color=orange];
	814 [label="J'ai connu plus de guerre que de paix dans ma vie, Lyon. Si je laissais cela m'affecter, je ne serais probablement plus là. Mais cela ne veut pas dire que ce n'est pas un véritable fardeau, un véritable prix à payer.",shape=box,color=red];
		814 -> 816;
	815 [label="Je pense que les autres t'ont dit qui je suis. Ce que je suis. D'où je viens. La mort qui me poursuit – la mort dont je reviens. La mort qui me définit. Penses-tu que quoi que ce soit que tu ressentes puisse me surprendre?",shape=box,color=red];
		815 -> 817;
	816 [label="Add 1 to Thermostat",color=orange];
		816 -> 818;
	817 [label="Add -1 to Thermostat",color=orange];
		817 -> 819;
	818 [label="Oui, en effet.",shape=box,color=blue];
		818 -> 820;
		818 -> 821;
	819 [label="Oui, je le crois.",shape=box,color=blue];
		819 -> 820;
		819 -> 821;
	820 [label="Je m'excuse. J'ai l'impression de t'avoir contrarié. Ce n'était pas mon intention.",shape=box,color=red];
		820 -> 822;
	821 [label="Tu veux bien... développer?",shape=box,color=red];
		821 -> 823;
	822 [label="Ce n'est pas de ta faute, Voyageur. Je suis, comme diraient nos frères et sœurs de Libertatia, \"coriace\".",shape=box,color=blue];
		822 -> 824;
	823 [label="Les horreurs qui résonnent dans mon esprit semblent sans limites. Je vois des chaînes de tendons humains qui, jadis dégoulinantes d'un sang frais, sont devenues cassantes et noircies.",shape=box,color=blue];
		823 -> 825;
	824 [label="Je ne suis qu'un individu assiégé. Je tiens le mur. Ouvrir la porte, c'est menacer l'intégrité des défenses.",shape=box,color=blue];
		824 -> 826;
		824 -> 827;
	825 [label="Je vois cent mille visages de moi-même, semblables mais étrangers. Des cercueils évidés, des cadavres de chair humaine tordue et brisée, suspendus dans le voile entre la vie et la mort.",shape=box,color=blue];
		825 -> 828;
	826 [label="Je comprends. Quand tu sera prêt, nous pourrons en parler.",shape=box,color=red];
		826 -> 829;
	827 [label="Que veux-tu dire?",shape=box,color=red];
		827 -> 823;
	828 [label="Leurs visages figés dans un masque de mort. Mais dans les braises vacillantes qui persistent et ne s'éteignent jamais, je les entends hurler. Hurler sans cesse vengeance. Pour la liberté.",shape=box,color=blue];
		828 -> 830;
	829 [label="Je commence à avoir l'impression très nette que je n'ai pas le choix dans cette affaire.",shape=box,color=blue];
		829 -> 831;
	830 [label="Pour la mort.",shape=box,color=blue];
		830 -> 832;
	831 [label="+15 Chemistry",color=orange];
		831 -> 833;
	832 [label="Ces visions hantent mes journées. Mes rêves. Je ne fais pas de cauchemars, car c'est tout ce que je vis – tout ce que je suis devenu.",shape=box,color=blue];
		832 -> 834;
	833 [label="Mais, pour ce que ça vaut, Marie m'a dit que tu avais de bonnes intentions. Et je la crois elle, même quand je ne crois pas moi-même.",shape=box,color=blue];
		833 -> 835;
	834 [label="Check boolean LyonPainOff",color=orange];
		834 -> 836 [label=true,color=green];
		834 -> 837 [label=false,color=brown];
	835 [label="Tout ce que je peux faire, c'est te demander de faire preuve de patience. Lua sait que j'en manque moi-même la plupart du temps.",shape=box,color=blue];
		835 -> 838;
	836 [label="Lorsque je me soumets aux murmures qui résonnent au fond de mon âme, le monde me paraît alors semblable à celui qui doit t'être familier.",shape=box,color=blue];
		836 -> 839;
	837 [label="Ce n'est que lorsque j'arrache la chair de mon corps en sacrifice aux murmures qui résonnent au fond de mon âme que le monde me paraît semblable à celui qui t'est peut-être familier.",shape=box,color=blue];
		837 -> 839;
	838 [label="Père Lyon Allard",shape=box,color=blue];
		838 -> 840;
	839 [label="Ne prétends surtout pas savoir ce que je \"ressens\", Voyageur. Tu commences à peine à comprendre, je le crains.",shape=box,color=blue];
		839 -> 841;
		839 -> 842;
		839 -> 843;
	840 [label="Update boolean LyonVisions2d",color=orange];
		840 -> 844;
	841 [label="Je regrette. Non, je ne savais pas.",shape=box,color=red];
		841 -> 845;
	842 [label="Et j'ai vu beaucoup d'horreurs et de souffrances que tu ne comprends pas non plus, Lyon.",shape=box,color=red];
		842 -> 846;
	843 [label="Je m'excuse si tu as eu l'impression que j'ai parlé à tort et à travers. Mais je souhaite comprendre. Ces visions que tu as...",shape=box,color=red];
		843 -> 847;
	844 [label="Chat ends.",color=orange];
	845 [label="Oui. Eh bien. J'ai survécu à toutes ces années. Je tiendrai encore quelques années, j'en suis certain. Tu n'as pas grand-chose à craindre.",shape=box,color=blue];
		845 -> 848;
	846 [label="J'en suis certain, j'en vois des reflets dans l'imagerie de ce lieu. Mais te crois-tu au-dessus du lot? L'Être Suprême de Toutes les Horreurs et de Toutes les Souffrances?",shape=box,color=blue];
		846 -> 849;
		846 -> 850;
	847 [label="Oui. Eh bien, j'y ai résisté toute ma vie. Je tiendrai encore quelques années, j'en suis certain. Tu n'as pas grand-chose à craindre.",shape=box,color=blue];
		847 -> 848;
	848 [label="Update boolean LyonVisions2a",color=orange];
		848 -> 851;
		848 -> 852;
	849 [label="Je veux dire que je suis peut-être capable de mieux comprendre ce que tu vis que tu ne le penses.",shape=box,color=red];
		849 -> 853;
	850 [label="Je dis simplement que j'ai fait face à beaucoup de morts et d'horreurs, Lyon. Alors, je n'apprécie pas qu'on me prenne de haut à ce sujet.",shape=box,color=red];
		850 -> 854;
	851 [label="Ce que tu décris, Lyon... cette vision a-t-elle commencé avant ou après que tu es devenu une Protoframe?",shape=box,color=red];
		851 -> 855;
	852 [label="Peut-on en reparler? S'il te plaît?",shape=box,color=red];
		852 -> 856;
	853 [label="Update boolean LyonVisions2b",color=orange];
		853 -> 857;
	854 [label="Update boolean LyonVisions2c",color=orange];
		854 -> 858;
	855 [label="Si seulement c'était une question aussi simple que tu le penses... Quoi qu'il en soit, je ne suis pas disposé à y répondre aujourd'hui. J'ai mal à la tête.",shape=box,color=blue];
		855 -> 859;
	856 [label="Je commence à avoir l'impression très nette que je n'ai pas le choix dans cette affaire.",shape=box,color=blue];
		856 -> 859;
	857 [label="Cela peut te paraître étrange, Voyageur, que je ne cherche pas la pitié. Ce sont des réponses que je cherche. La certitude. Le firmament, quand tout n'est qu'illusion et mensonge.",shape=box,color=blue];
		857 -> 860;
		857 -> 861;
	858 [label="Permets-moi donc de m'incliner. Je te loue pour tout ce que tu as enduré. Je m'étonne que tu aies gardé toute ta raison après avoir vu tout cela.",shape=box,color=blue];
		858 -> 862;
	859 [label="+10 Chemistry",color=orange];
		859 -> 863;
	860 [label="Je ferai ce que je peux.",shape=box,color=red];
		860 -> 864;
	861 [label="Alors, je peux peut-être t'aider. Pourrions-nous en reparler? S’il te plaît?",shape=box,color=red];
		861 -> 856;
	862 [label="Et je m'étonne que tu trouves encore du temps pour nous tous, simples citoyens que tu considères comme bien en dessous de ton statut privilégié.",shape=box,color=blue];
		862 -> 865;
	863 [label="Mais, pour ce que ça vaut, Marie m'a dit que tu avais de bonnes intentions. Et je la crois elle, même quand je ne crois pas moi-même.",shape=box,color=blue];
		863 -> 866;
	864 [label="+5 Chemistry",color=orange];
		864 -> 867;
	865 [label="Chat ends.",color=orange];
	866 [label="Tout ce que je peux faire, c'est te demander de faire preuve de patience. Lua sait que j'en manque moi-même la plupart du temps.",shape=box,color=blue];
		866 -> 868;
	867 [label="C'est tout ce qu'on peut demander, n'est-ce pas?",shape=box,color=blue];
		867 -> 869;
	868 [label="Père Lyon Allard",shape=box,color=blue];
		868 -> 870;
	869 [label="Chat ends.",color=orange];
	870 [label="Chat ends.",color=orange];
}