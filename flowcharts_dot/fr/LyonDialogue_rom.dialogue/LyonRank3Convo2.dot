digraph {
	32 [label="LyonRank3Convo2 begins.",color=orange];
		32 -> 33;
	33 [label="Si tu me le permets, j'aimerais te raconter l'histoire d'un chat errant qui venait souvent derrière l'église.",shape=box,color=blue];
		33 -> 36;
		33 -> 35;
		33 -> 34;
	36 [label="Continue.",shape=box,color=red];
		36 -> 39;
	35 [label="Pourquoi?",shape=box,color=red];
		35 -> 38;
	34 [label="[Ignorer.]",shape=box,color=red];
		34 -> 37;
	39 [label="Merci.",shape=box,color=blue];
		39 -> 41;
	38 [label="Je crains que l'explication ne demande des efforts qui n'en valent pas la peine.",shape=box,color=blue];
		38 -> 40;
	37 [label="Chat ends.",color=orange];
	41 [label="Bien que je soupçonne que cette histoire ne soit pas propre à ce vieux greffier hirsute, mes interactions avec lui semblent apparemment dignes d'intérêt et l'histoire mérite donc d'être racontée.",shape=box,color=blue];
		41 -> 43;
	40 [label="Peu importe.",shape=box,color=blue];
		40 -> 42;
	43 [label="Chaque jour, il venait quémander des maigres restes et les marques d'affection qu'il pouvait obtenir de moi ou des autres frères et sœurs qui le chérissaient.",shape=box,color=blue];
		43 -> 44;
	42 [label="Chat ends.",color=orange];
	44 [label="Il était en piteux état, boitait bas et il lui manquait un morceau d'oreille. ",shape=box,color=blue];
		44 -> 45;
	45 [label="Quand il ne venait pas pendant quelques jours, Marie était folle d'inquiétude. Mais que faire pour un vieux chat de gouttière qui a trouvé la mort, sinon adresser une prière à Lua?",shape=box,color=blue];
		45 -> 46;
	46 [label="Update boolean LyonStray",color=orange];
		46 -> 47;
		46 -> 48;
		46 -> 49;
	47 [label="[Le laisser continuer.]",shape=box,color=red];
		47 -> 50;
	48 [label="Est-ce autorisé par ta religion? Je veux dire, prier pour les animaux.",shape=box,color=red];
		48 -> 51;
	49 [label="Tu prierais pour l'âme d'un chat de gouttière décédé?",shape=box,color=red];
		49 -> 52;
	50 [label="Imagine donc ma surprise, alors que j'allais chercher du pain au marché, quand j'ai aperçu le vieux chat assis à côté du propriétaire de l'étal.",shape=box,color=blue];
		50 -> 53;
	51 [label="+10 Chemistry",color=orange];
		51 -> 54;
	52 [label="Bien sûr. Certaines des âmes les plus pures et les plus lumineuses que j'ai rencontrées étaient enfermées dans une chair animale. Il ne m'appartient pas de juger comment les Luminaires les ont guidées sur leur chemin.",shape=box,color=blue];
		52 -> 55;
	53 [label="Il m'a salué d'un miaulement rauque, comme à son habitude et a sauté à terre pour se frotter contre ma jambe.",shape=box,color=blue];
		53 -> 56;
	54 [label="Bonne question. Dans certaines sectes, non. Ce serait considéré comme une hérésie. Mais dans notre religion, oui. Nous reconnaissons que les animaux ont une âme.",shape=box,color=blue];
		54 -> 55;
	55 [label="Sainte Élisabeth la Sage était connue pour sa charité envers les animaux, bien que de nombreuses traditions ne reconnaissent pas les saints comme des apôtres des Luminaires.",shape=box,color=blue];
		55 -> 57;
	56 [label="Et je tiens à préciser, Voyageur, qu'il l'a fait sans boiter.",shape=box,color=blue];
		56 -> 58;
	57 [label="Je me demande si l'influence de notre ordre a subsisté aussi longtemps... mais ce n'était pas vraiment le sujet de la conversation.",shape=box,color=blue];
		57 -> 59;
	58 [label="\"Ah, une des victimes du vieux César, je vois.\" rigola l'homme en emballant mon pain.",shape=box,color=blue];
		58 -> 60;
	59 [label="Update boolean LyonLecture1",color=orange];
		59 -> 50;
	60 [label="Il s'avère que le vieux chat se jouait de nous, ainsi que de plusieurs autres voisins. Il n'était ni affamé, ni malade, ni négligé d'aucune façon.",shape=box,color=blue];
		60 -> 61;
	61 [label="En effet, si l'on en croit les dires de cet homme, c'était un véritable monstre meurtrier envers la population locale d'oiseaux.",shape=box,color=blue];
		61 -> 62;
		61 -> 63;
		61 -> 64;
	62 [label="As-tu cessé de nourrir le vieux César lorsqu'il est revenu dans tes parages?",shape=box,color=red];
		62 -> 65;
	63 [label="Tu essaies de me mettre en garde contre Roathe?",shape=box,color=red];
		63 -> 66;
	64 [label="Es-tu le chat de gouttière dans cette histoire?",shape=box,color=red];
		64 -> 67;
	65 [label="+10 Chemistry",color=orange];
		65 -> 68;
	66 [label="Il y a bien des choses qui devraient te mettre en garde contre le diable que le \"Cardinal Dimanche\" a déposé devant notre porte. Peut-être en est-ce une. Peut-être pas.",shape=box,color=blue];
		66 -> 69;
	67 [label="Les Luminaires savent que j'ai été particulièrement éprouvé ces derniers temps. Mais est-ce un avertissement à mon sujet? Peut-être. Peut-être pas.",shape=box,color=blue];
		67 -> 69;
	68 [label="Non, pas du tout. Au contraire, Marie l'a accueilli avec encore plus d'affection, le taquinant en l'appelant \"son petit diablotin\".",shape=box,color=blue];
		68 -> 70;
	69 [label="C'est simplement une histoire pour dire que parfois, lorsqu'une créature semble être dans le besoin -",shape=box,color=blue];
		69 -> 71;
	70 [label="Mais nous ne nous inquiétions plus pour lui. Nous savions que le vieux César pouvait très bien se débrouiller seul. Il n'avait pas besoin de nous.",shape=box,color=blue];
		70 -> 72;
		70 -> 73;
	71 [label="+15 Chemistry",color=orange];
		71 -> 74;
	72 [label="Sais-tu ce qui est arrivé au vieux César?",shape=box,color=red];
		72 -> 75;
	73 [label="À ton avis, qu'est-ce qui poussait le vieux César à vous rendre visite, si ce n'était pas le besoin?",shape=box,color=red];
		73 -> 76;
	74 [label="- vérifie à quel point ses griffes sont acérées.",shape=box,color=blue];
		74 -> 77;
	75 [label="Sa disparition suivante, deux ans plus tard, devint définitive.",shape=box,color=blue];
		75 -> 78;
		75 -> 79;
	76 [label="La réponse cynique que je te donnerais serait: \"la cupidité\". Car si l’on peut s’offrir un festin, pourquoi pas deux? Pourquoi pas dix?",shape=box,color=blue];
		76 -> 80;
		76 -> 81;
	77 [label="Chat ends.",color=orange];
	78 [label="Tu as prié pour lui?",shape=box,color=red];
		78 -> 82;
	79 [label="J'espère qu'il a quitté ce monde paisiblement et aimé.",shape=box,color=red];
		79 -> 83;
	80 [label="Quelle serait la réponse non cynique?",shape=box,color=red];
		80 -> 84;
	81 [label="Cela reste-t-il pareil s'il ne cherchait que de l'affection?",shape=box,color=red];
		81 -> 85;
	82 [label="J'ai allumé une bougie pour lui la nuit où j'ai appris sa mort et j'ai prié Lua de guider son âme... là où elle guiderait un petit diablotin comme lui.",shape=box,color=blue];
		82 -> 86;
	83 [label="Puis-je te demander pourquoi?",shape=box,color=blue];
		83 -> 87;
		83 -> 88;
	84 [label="+10 Chemistry",color=orange];
		84 -> 89;
	85 [label="Un désir avide d'affection reste de la gourmandise, même s'il ne s'agit pas d'une faim apaisée par la viande et le vin. Et la rechercher sous de tels prétextes fallacieux?",shape=box,color=blue];
		85 -> 90;
		85 -> 91;
	86 [label="Et j'ai remercié le vieux César pour toute la joie qu'il avait apportée à Marie en échange de tous ces précieux morceaux de cartilage de poulet et de ces gratouilles sur la tête.",shape=box,color=blue];
		86 -> 92;
	87 [label="C'était un animal. Il cherchait simplement à satisfaire ses besoins essentiels: nourriture, abri, amour. Ses motivations n'étaient pas les mêmes que celles des humains. Il ne \"mentait\" pas, il chassait avec des moyens différents.",shape=box,color=red];
		87 -> 93;
	88 [label="J'ai vu beaucoup de violence, Lyon. J'en ai même causé une bonne partie. J'espère désormais que chacun, quelles que soient son identité et ses actions, puisse mourir en paix, entouré de ceux qui l'aiment.",shape=box,color=red];
		88 -> 94;
	89 [label="Je me suis surpris à éprouver un étrange... respect pour le chat, pour la place qu'il avait trouvée dans le monde.",shape=box,color=blue];
		89 -> 95;
	90 [label="C'était un chat, Lyon. Il ne savait pas vraiment ce qu'il faisait.",shape=box,color=red];
		90 -> 96;
	91 [label="Nous parlons toujours d'un chat, n'est-ce pas?",shape=box,color=red];
		91 -> 97;
	92 [label="Merci. Je ne te dérangerai plus dans ta journée.",shape=box,color=blue];
		92 -> 98;
	93 [label="En vous bernant, il ne privait personne de rien. Au contraire... vous semblez tous avoir été enrichis par ses visites.",shape=box,color=red];
		93 -> 99;
	94 [label="Fascinant. Je m'attendrais à ce que tu méprises tes ennemis. Mais c'est là ma propre erreur: croire savoir comment quiconque se comporte de nos jours.",shape=box,color=blue];
		94 -> 100;
	95 [label="C'était une créature qui avait appris à utiliser sa condition, son apparence, son âge, ses cicatrices, comme une arme contre \"les naïfs\" qui l’entouraient et qui ne voyaient pas clair dans son jeu.",shape=box,color=blue];
		95 -> 101;
	96 [label="Il savait parfaitement faire semblant de boiter. ",shape=box,color=blue];
		96 -> 84;
	97 [label="Tires-en les conclusions que tu souhaites, Voyageur.",shape=box,color=blue];
		97 -> 84;
	98 [label="Père Lyon Allard",shape=box,color=blue];
		98 -> 102;
	99 [label="Add -1 to Thermostat",color=orange];
		99 -> 103;
	100 [label="Add 1 to Thermostat",color=orange];
		100 -> 104;
	101 [label="Un vrai petit diablotin au pelage emmêlé. Pourtant, je me surprenais à le caresser quand il venait me rendre visite.",shape=box,color=blue];
		101 -> 105;
	102 [label="Chat ends.",color=orange];
	103 [label="Oui, je suppose que c'est vrai. Et nous ne manquions pas de morceaux de cartilage et de restes de poulet.",shape=box,color=blue];
		103 -> 106;
	104 [label="Surtout quelqu'un ayant eu une éducation aussi fascinante que la tienne. ",shape=box,color=blue];
		104 -> 107;
	105 [label="J'ai été tout aussi dévasté lorsque, deux ans plus tard, sa disparition fut définitive.",shape=box,color=blue];
		105 -> 78;
		105 -> 79;
	106 [label="C’est peut-être pour cela que j’ai allumé une bougie pour lui et prié Lua de prendre son âme et de la guider... là où elle emmènerait un petit diablotin comme lui.",shape=box,color=blue];
		106 -> 108;
	107 [label="+5 Chemistry",color=orange];
		107 -> 109;
	108 [label="+5 Chemistry",color=orange];
		108 -> 110;
	109 [label="Merci. Je ne te dérangerai plus longtemps. Cette conversation a été très intéressante. À la prochaine fois.",shape=box,color=blue];
		109 -> 111;
	110 [label="Et c’est pourquoi j’ai remercié le vieux César dans mes prières ce soir-là, pour toute la joie qu’il avait apportée à Marie.",shape=box,color=blue];
		110 -> 112;
	111 [label="Père Lyon Allard",shape=box,color=blue];
		111 -> 113;
	112 [label="Peut-être que ses petits méfaits avaient, d'une manière détournée, un certain effet positif.",shape=box,color=blue];
		112 -> 109;
	113 [label="Chat ends.",color=orange];
}