digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank5Convo3 begins." [color=orange];
		"LyonRank5Convo3 begins." -> j410090499;
	j410090499 [label="Evaluate expressions",color=orange];
		j410090499 -> j2163443066 [label="LyonDating",color=purple];
		j410090499 -> j404637496 [label="LyonConvession1",color=purple];
		j410090499 -> j404637496 [label="LyonRell2a",color=purple];
		j410090499 -> j404637496 [label="LyonRell2b",color=purple];
		j410090499 -> j404637496 [label="LyonRell1",color=purple];
		j410090499 -> "Chat ends." [label="false",color=purple];
	j2163443066 [label="Je n'en suis pas fier, mais j'ai bu une bouteille de vin entière et je suis maintenant prêt à te raconter tout le reste de ce que j'essayais désespérément de ne pas te dire, mon miracle...",shape=box,color=blue];
		j2163443066 -> j2140093150;
	j404637496 [label="Je n'en suis pas fier, mais j'ai bu une bouteille de vin entière et je suis maintenant prêt à te raconter tout le reste de ce que j'essayais désespérément de ne pas te dire...",shape=box,color=blue];
		j404637496 -> j2140093150;
	"Chat ends." [color=orange];
	j2140093150 [label="Si ce que contenait cette bouteille était bien du vin, car l'étiquette n'est pas précise – et M. Loid n'était pas tout à fait sûr que ce que nous avions à mon époque et ce qu'il appelle vin aujourd'hui soient la même chose.",shape=box,color=blue];
		j2140093150 -> j2833245939;
	j2833245939 [label="Pour ma défense, je n'avais pas l'intention de boire toute la bouteille... mais j'essayais de déterminer s'il s'agissait bien de la même substance et puis elle a disparu...",shape=box,color=blue];
		j2833245939 -> j2272758580;
		j2833245939 -> j1800594926;
		j2833245939 -> j1919295343;
	j2272758580 [label="Non. Sans moi.",shape=box,color=red];
		j2272758580 -> j1508818086;
	j1800594926 [label="Le goût est-il le même?",shape=box,color=red];
		j1800594926 -> j3138670237;
	j1919295343 [label="Tu es ivre?",shape=box,color=red];
		j1919295343 -> j1604474334;
	j1508818086 [label="Si seulement je pouvais m'échapper aussi facilement. Je ne t'en veux pas.",shape=box,color=blue];
		j1508818086 -> j3856020424;
	j3138670237 [label="Je ne sais pas! C'était le plus frustrant dans toute cette histoire! Mais là n'est pas la question. Le but était de me saouler. Et je ne sais même pas si j'y suis arrivé. En tout cas, je ne suis pas sobre.",shape=box,color=blue];
		j3138670237 -> j1646637293;
	j1604474334 [label="C'est possible. Je suis loin d'être ce qu'on considérerait comme sobre.",shape=box,color=blue];
		j1604474334 -> j188126786;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j1646637293 [label="J'imagine donc que ça devra suffire.",shape=box,color=blue];
		j1646637293 -> j3964790579;
		j1646637293 -> j1480023051;
	j188126786 [label="C'était d'ailleurs le but recherché. J'imagine donc que cela suffira.",shape=box,color=blue];
		j188126786 -> j3964790579;
		j188126786 -> j1480023051;
	j3964790579 [label="Qu'est-ce qui est si terrible pour que tu aies besoin d'être ivre pour m'en parler?",shape=box,color=red];
		j3964790579 -> j3375269506;
	j1480023051 [label="Bon, quand tu veux...",shape=box,color=red];
		j1480023051 -> j3375269506;
	j3375269506 [label="Rap... tap... tap...",shape=box,color=blue];
		j3375269506 -> j1482358704;
		j3375269506 -> j2028078878;
	j1482358704 [label="... Oh.",shape=box,color=red];
		j1482358704 -> j833776605;
	j2028078878 [label="Ça suffira.",shape=box,color=red];
		j2028078878 -> j833776605;
	j833776605 [label="Je sais avec certitude qu'ils n'ont jamais fait partie de mon esprit. Le Tenno connu sous le nom de Rell et son gardien Harrow. Il est impossible qu'ils aient été dans la maison de mon enfance.",shape=box,color=blue];
		j833776605 -> j881037904;
	j881037904 [label="Il est impossible qu'ils aient résonné dans mon esprit, mêlés aux voix murmurées et indistinctes de mes visions, durant toutes ces années. Pourtant, je les vois et je les entends ici, comme dans dans mes souvenirs.",shape=box,color=blue];
		j881037904 -> j252073137;
	j252073137 [label="Check boolean LyonTime1",color=orange];
		j252073137 -> j2935953548 [label=true,color=green];
		j252073137 -> j89784824 [label=false,color=brown];
	j2935953548 [label="J'ai compris, d'un point de vue philosophique, tout ce qu'Entrati disait sur la possibilité pour l'énergie d'exister simultanément en plusieurs endroits dans le temps. Mais je ne l'ai compris émotionnellement qu'après avoir... reçu l'injection du sérum.",shape=box,color=blue];
		j2935953548 -> j425794016;
	j89784824 [label="C'est comme si, au moment où j'ai injecté le sérum, tout ne faisait plus qu'un. Quand Entrati s'est révélé, et toute la vérité de son existence… ",shape=box,color=blue];
		j89784824 -> j1184134080;
	j425794016 [label="Parfois, je vois en pensée un grand lac peu profond et immobile qui s'étend à perte de vue. Noir et lisse, comme un miroir d'onyx.",shape=box,color=blue];
		j425794016 -> j2646942395;
	j1184134080 [label="Il m'a exposé tout ce qu'il savait sur \"l'intrication quantique\", la \"superposition\", \"l'éternalisme\" et autres choses du même genre.",shape=box,color=blue];
		j1184134080 -> j4249159667;
	j2646942395 [label="Un immense lac noir qui s'étend à l'infini. Impossible à concevoir.",shape=box,color=blue];
		j2646942395 -> j613658018;
	j4249159667 [label="J'ai tout compris d'un point de vue scientifique, voire philosophique. Mais je ne l'ai compris émotionnellement qu'après l'injection du sérum.",shape=box,color=blue];
		j4249159667 -> j425794016;
	j613658018 [label="Et c'est là que je les trouvais. C'est là que nous nous rencontrions. Et c'est là que je les sentais aussi...",shape=box,color=blue];
		j613658018 -> j1909010830;
	j1909010830 [label="Qui?",shape=box,color=red];
		j1909010830 -> j1352815383;
	j1352815383 [label="Les autres Harrows… Des statues vides, des échos d’échos d’échos… Elles s’étendent à l’infini, dans toutes les directions…",shape=box,color=blue];
		j1352815383 -> j2367974568;
	j2367974568 [label="Rell s'est introduit dans l'un d'eux. Il s'y est perdu. Et ce faisant, il s'est perdu dans tous...",shape=box,color=blue];
		j2367974568 -> j849286646;
	j849286646 [label="Moi y compris. Et aussi le Harrow qui se trouvait dans le sérum qui m'a créé.",shape=box,color=blue];
		j849286646 -> j3651732111;
		j849286646 -> j1067819938;
	j3651732111 [label="Par le Néant, je n'avais pas réalisé...",shape=box,color=red];
		j3651732111 -> j3466622330;
	j1067819938 [label="Oh non -",shape=box,color=red];
		j1067819938 -> j3466622330;
	j3466622330 [label="Ils étaient là, avec moi, dans mon esprit – Rell et son Harrow, si semblables à moi et pourtant si différents.",shape=box,color=blue];
		j3466622330 -> j1647023277;
	j1647023277 [label="Il n'avait pas peur. Il était si sûr de lui. Deux choses qui ne me caractérisaient absolument pas.",shape=box,color=blue];
		j1647023277 -> j1021069967;
	j1021069967 [label="Il résista fermement à l'Indifférence, sans se soucier de ce qu'elle était ou n'était pas. Il savait simplement ce qu'il fallait faire.",shape=box,color=blue];
		j1021069967 -> j4234325153;
	j4234325153 [label="Même après toutes les cruautés qu'il a subies. Pendant toutes ces années, dans le \"maintenant\" et le \"alors\" de cette éternité, au moment où j'ai injecté le sérum… de \"l'avant\" et de \"l'après\", il était là.",shape=box,color=blue];
		j4234325153 -> j1603147893;
	j1603147893 [label="C'était mon ami. C'était mon frère.",shape=box,color=blue];
		j1603147893 -> j177968203;
	j177968203 [label="Alors? Aujourd'hui?",shape=box,color=blue];
		j177968203 -> j2762578210;
	j2762578210 [label="Je ne le sens plus.",shape=box,color=blue];
		j2762578210 -> j3639334784;
		j2762578210 -> j1917600770;
	j3639334784 [label="Il... il repose en paix, maintenant, Lyon... il est en paix.",shape=box,color=red];
		j3639334784 -> j2553111039;
	j1917600770 [label="Oh, Lyon...",shape=box,color=red];
		j1917600770 -> j2039254531;
	j2553111039 [label="Je sais. Je l'ai ressenti quand il est parti. Et j'ai pleuré. Il me manque terriblement. Je sais que sa présence résonne encore, d'une manière ou d'une autre, même si je ne comprends pas tout à fait comment.",shape=box,color=blue];
		j2553111039 -> j2237838115;
		j2553111039 -> j1008907576;
	j2039254531 [label="Il me manque terriblement. Je sais que sa voix résonne encore en moi, d'une manière ou d'une autre, même si je ne comprends pas tout à fait comment.",shape=box,color=blue];
		j2039254531 -> j2237838115;
		j2039254531 -> j1008907576;
	j2237838115 [label="Rell était le plus fort d'entre nous. C'est bien que tu aies eu la chance de le connaître.",shape=box,color=red];
		j2237838115 -> j4269573820;
	j1008907576 [label="Rell a été mis au ban de la société à cause de l'ignorance et de la cruauté des enfants... il ne méritait pas ce qui lui est arrivé.",shape=box,color=red];
		j1008907576 -> j3687480380;
	j4269573820 [label="Je suis heureux de l'avoir connu. Quant à sa force? Peut-être, peut-être pas. Au final, il savait simplement ce qu'il fallait faire et il était assez fort pour y parvenir.",shape=box,color=blue];
		j4269573820 -> j3084830673;
	j3687480380 [label="Peut-être. Mais au final, il a fait ce qu'il fallait. Et il a eu la force d'aller jusqu'au bout.",shape=box,color=blue];
		j3687480380 -> j3084830673;
	j3084830673 [label="Dans des moments comme ceux-ci, je crois que tout ce que nous pouvons espérer, c'est d'être \"assez forts\".",shape=box,color=blue];
		j3084830673 -> j1856695932;
	j1856695932 [label="Ce qui, malheureusement, ne peut être dit de ce vin… qui était très fort, mais dont les effets tardaient à se manifester.",shape=box,color=blue];
		j1856695932 -> j338658859;
	j338658859 [label="Je devrais y aller...",shape=box,color=blue];
		j338658859 -> j3813182247;
	j3813182247 [label="Je dois y aller.",shape=box,color=blue];
		j3813182247 -> j111445917;
	j111445917 [label="Check boolean LyonDating",color=orange];
		j111445917 -> j2657367820 [label=true,color=green];
		j111445917 -> j2364640304 [label=false,color=brown];
	j2657367820 [label="+20 Chemistry",color=orange];
		j2657367820 -> j1785093694;
	j2364640304 [label="+20 Chemistry",color=orange];
		j2364640304 -> j3385666131;
	j1785093694 [label="Merci, mon amour.",shape=box,color=blue];
		j1785093694 -> j2781486963;
	j3385666131 [label="Merci, camarade.",shape=box,color=blue];
		j3385666131 -> j2781486963;
	j2781486963 [label="- Lyon",shape=box,color=blue];
		j2781486963 -> j561186479;
	j561186479 [label="Boolean LyonConfession2 is now true.",color=orange];
		j561186479 -> j4275890424;
	j4275890424 [label="Boolean LyonWillDate is now true.",color=orange];
		j4275890424 -> "Chat ends.";
}