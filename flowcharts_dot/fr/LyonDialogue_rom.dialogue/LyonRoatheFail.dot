		2269 -> 2270 [label="RoatheFailUnloved",color=purple];
	2273 [label="Roathe a dû faire face à la vérité concernant sa… enfin… sa prise du sérum. Et je ne sais pas comment, mais je crois que je l'ai mal accompagné dans cette épreuve.",shape=box,color=red];
		2273 -> 2277;
	2272 [label="Je ne sais pas trop. Je crois que j'ai dit quelque chose que je n'aurais pas dû.",shape=box,color=red];
		2272 -> 2276;
	2271 [label="Il m'a dit de ne pas fouiller davantage dans ses souvenirs. Alors, je ne l'ai pas fait. Et maintenant, on dirait… qu'on est dans une impasse?",shape=box,color=red];
		2271 -> 2275;
	2270 [label="Je lui ai dit que ce n'était pas une relation sérieuse et même s'il n'avait pas l'air d'y voir un problème, j'ai maintenant l'impression que nous avons régressé.",shape=box,color=red];
		2270 -> 2274;
	2277 [label="Je comprends. Il peut être difficile de faire la paix avec ses actes passés lorsqu'ils sont présentés sous un jour nouveau. Je maudis Entrati de l'avoir entraîné, lui et nous d'ailleurs, dans cette situation déplorable.",shape=box,color=blue];
		2277 -> 2280;
	2276 [label="Je comprends. Je crains de devoir t'annoncer que je ne peux pas y faire grand-chose, car tu récoltes ce que tu as semés.",shape=box,color=blue];
		2276 -> 2278;
	2275 [label="Je vois. Parfois, agir selon les souhaits de quelqu'un ne signifie pas suivre ses volontés à la lettre.",shape=box,color=blue];
		2275 -> 2279;
	2274 [label="Je comprends. Je crains de devoir t'annoncer que je ne peux pas y faire grand-chose, car tu récoltes ce que tu as semés.",shape=box,color=blue];
		2274 -> 2278;
	2280 [label="Je ferai tout mon possible pour le convaincre de t'écouter. Mais je te conseille vivement de préparer des arguments plus convaincants afin qu'il commence à considérer ses actions autrement que comme des faits de lâcheté.",shape=box,color=blue];
		2280 -> 2282;
	2278 [label="Agir avec un tel mépris et un tel dédain ne peut que provoquer une réaction tout aussi violente. Surtout lorsqu'on a affaire à quelqu'un comme Roathe.",shape=box,color=blue];
		2278 -> 2281;
	2279 [label="C'est une action terrible que de devoir désobéir aux volontés de quelqu'un, surtout en fouillant dans ses souvenirs et ses pensées les plus intimes.",shape=box,color=blue];
		2279 -> 2341;
	2282 [label="Car je sais que c'est cela qui le ronge de l'intérieur.",shape=box,color=blue];
		2282 -> 2284;
	2281 [label="J'ignore quels recours tu as pour rectifier la situation. Mais je ne crois pas que Marie et moi pourrons t'aider, pardon.",shape=box,color=blue];
		2281 -> 2283;
	2341 [label="Je maudis Entrati de l'avoir mis, tout comme nous, dans une position aussi méprisable.",shape=box,color=blue];
		2341 -> 2342;
	2284 [label="Je sais que nous aurons également besoin de l'aide de Marie dans cette affaire. Elle sera peut-être plus difficile à convaincre car, comme tu le sais, ils ne s'apprécient guère.",shape=box,color=blue];
		2284 -> 2286;
	2283 [label="Il serait peut-être préférable d'envisager d'autres options à ce stade.",shape=box,color=blue];
		2283 -> 2285;
	2342 [label="Mais il me semble malheureusement que le seul moyen de l'aider est de faire exactement cela. Et de continuer à explorer La Descendia jusqu'à ce qu'il ne reste plus aucun souvenir à découvrir.",shape=box,color=blue];
		2342 -> 2343;
	2286 [label="Update boolean LyonRoatheFailFix",color=orange];
