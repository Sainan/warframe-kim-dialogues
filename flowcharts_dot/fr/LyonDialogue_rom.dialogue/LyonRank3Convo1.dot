digraph {
	0 [label="LyonRank3Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Bonjour, Voyageur.",shape=box,color=blue];
		1 -> 2;
	2 [label="J'ai appris que tu souhaitais me parler.",shape=box,color=blue];
		2 -> 3;
		2 -> 4;
		2 -> 5;
	3 [label="C'est un plaisir de m'entretenir avec toi ici, Lyon - merci.",shape=box,color=red];
		3 -> 6;
	4 [label="Marie a-t-elle fini par te convaincre que je ne représentais pas une menace?",shape=box,color=red];
		4 -> 7;
	5 [label="Oh! Bonjour, Lyon. Franchement, je ne pensais pas que tu serais convaincu. C'est chouette que tu aies changé d'avis.",shape=box,color=red];
		5 -> 8;
	6 [label="Tu le regretteras peut-être en fin de compte, mais très bien. De rien.",shape=box,color=blue];
		6 -> 9;
		6 -> 10;
	7 [label="Ne m'incite pas à trouver si rapidement des raisons de changer d'avis.",shape=box,color=blue];
		7 -> 11;
	8 [label="Oui, enfin...Ton enthousiasme ne durera peut-être pas.",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
	9 [label="J'ai compris grâce aux autres que tu voulais parler de certaines choses. Puis-je t'aider?",shape=box,color=red];
		9 -> 12;
	10 [label="Quelque chose ne va pas?",shape=box,color=red];
		10 -> 13;
	11 [label="+10 Chemistry",color=orange];
		11 -> 14;
	12 [label="Peut-être, en temps voulu. Mais nous ne faisons que commencer notre discussion. Je suis simplement venu ici pour... te dire que j'ai cédé à l'insistance de Marie qui assure qu'on peut te faire confiance, du moins en ce qui concerne une conversation.",shape=box,color=blue];
		12 -> 15;
	13 [label="Quelle question presque risiblement peu pertinente! Je ne tenterai même pas d'y répondre, car notre conversation ne fait que commencer. Je suis simplement venu te dire que j'ai cédé à l'insistance de Marie qui assure qu'on peut te faire confiance, du moins en ce qui concerne une conversation.",shape=box,color=blue];
		13 -> 15;
	14 [label="Chat ends.",color=orange];
	15 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		15 -> 16 [label="x > 0",color=purple];
		15 -> 17 [label="x <= 0",color=purple];
		15 -> 17 [label="false",color=purple];
	16 [label="Puisque nous sommes désormais partenaires dans cette entreprise que Roathe est déterminé à mener à bien, il semble judicieux que nous fassions plus ample connaissance. Il semblerait que ce soit le moyen que tu préfères. Donc, me voici.",shape=box,color=blue];
		16 -> 18;
		16 -> 19;
	17 [label="Et puisque nous pourrions être associés indéfiniment, ou pas, dans cette entreprise que Roathe est déterminé à mener à bien, il semble judicieux que nous fassions plus ample connaissance. C'est le moyen que tu préfères. Donc, me voici.",shape=box,color=blue];
		17 -> 18;
		17 -> 19;
	18 [label="J'ai l'impression d'avoir déjà mal commencé, d'une manière ou d'une autre.",shape=box,color=red];
		18 -> 20;
	19 [label="Y a-t-il... une autre option que tu préfères?",shape=box,color=red];
		19 -> 21;
	20 [label="Non. Aucunement. Je ne suis tout simplement pas le genre de personne avec laquelle tu as l'habitude de converser. Jusqu'à présent, tu as eu de la chance, même si les aliénés de ma trempe sont rares.",shape=box,color=blue];
		20 -> 22;
	21 [label="Non. Cela me convient parfaitement. En effet, cela me permet de prendre le temps de structurer mes idées comme je le souhaite. Je comprends l'attrait de cet appareil.",shape=box,color=blue];
		21 -> 23;
	22 [label="Je m'égare. Je crains de ne pas être venu ici pour passer beaucoup de temps à \"taper\", ce qui te décevra sans doute. Je souhaitais simplement t'informer de ma reddition.",shape=box,color=blue];
		22 -> 24;
		22 -> 25;
	23 [label="Toutefois, je crains de ne pas être venu ici pour passer beaucoup de temps à \"taper\", ce qui te décevra sans doute. Je souhaitais simplement t'informer de ma reddition.",shape=box,color=blue];
		23 -> 25;
		23 -> 24;
	24 [label="Marie est plus coriace qu'elle n'en a l'air, n'est-ce pas?",shape=box,color=red];
		24 -> 26;
	25 [label="Encore une fois, je te remercie.",shape=box,color=red];
		25 -> 27;
	26 [label="+20 Chemistry",color=orange];
		26 -> 28;
	27 [label="+15 Chemistry",color=orange];
		27 -> 29;
	28 [label="Tu commences à peine à soupçonner la profondeur de ces eaux.",shape=box,color=blue];
		28 -> 30;
	29 [label="Et, pour ce que cela vaut, je t'en prie.",shape=box,color=blue];
		29 -> 30;
	30 [label="Père Lyon Allard",shape=box,color=blue];
		30 -> 31;
	31 [label="Chat ends.",color=orange];
}