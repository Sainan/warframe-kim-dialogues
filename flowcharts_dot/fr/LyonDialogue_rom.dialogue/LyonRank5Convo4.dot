		1623 -> 1625 [label="LyonConfession1, LyonConfession2",color=purple];
		1623 -> 1626 [label="false",color=purple];
	2346 [label="[Conversation ignorée en raison d'un avertissement précédemment défini.]",shape=box,color=blue];
		2346 -> 2348;
	1624 [label="Je ne crois pas pouvoir te décrire adéquatement à quel point ce fut un moment étrange que celui de l'injection du sérum, mon miracle.",shape=box,color=blue];
		1624 -> 1628;
		1624 -> 1629;
		1624 -> 1630;
		1624 -> 1627;
	1625 [label="Je ne crois pas pouvoir te décrire adéquatement à quel point ce fut un moment étrange que celui de l'injection du sérum, camarade.",shape=box,color=blue];
		1625 -> 1628;
		1625 -> 1629;
		1625 -> 1630;
		1625 -> 1627;
	1626 [label="Chat ends.",color=orange];
	2348 [label="Update boolean LyonRell3",color=orange];
		2348 -> 2350;
	1628 [label="J'ai entendu dire que c'était incroyablement douloureux.",shape=box,color=red];
		1628 -> 1632;
	1629 [label="Je ne peux absolument pas l'imaginer. ",shape=box,color=red];
		1629 -> 1633;
	1630 [label="[Avertissement : ce texte aborde birèvement les thèmes de l’automutilation et de la maltraitance infantile. Cliquez ici pour terminer. Vous ne perdrez pas de points de Chimie avec Lyon.]",shape=box,color=red];
		1630 -> 1634;
	1627 [label="[Fin.]",shape=box,color=red];
		1627 -> 1631;
	2350 [label="Update boolean LyonWillDate",color=orange];
		2350 -> 2351;
	1632 [label="Je suppose que oui. Bien que je pense avoir des années d'expérience en la matière et que, par conséquent, les avertissements d'Entrati ont rendu la chose bien plus impressionnante qu'elle ne l'était en réalité.",shape=box,color=blue];
		1632 -> 1633;
	1633 [label="Marie et moi avions décidé de faire nos injections en privé. Je lui ai demandé de me laisser y aller en premier, de ressentir le changement, puis de l'aider à faire la sienne – mais elle a, bien sûr, catégoriquement refusé.",shape=box,color=blue];
		1633 -> 1636;
	1634 [label="+20 Chemistry",color=orange];
		1634 -> 1637;
	1631 [label="Update boolean LyonConfessionFail",color=orange];
		1631 -> 1635;
	2351 [label="Chat ends. Next chat will be Lyon5FaithDay2.",color=orange];
	1636 [label="Se moquant de la simple idée que j'irais quelque part ou ferais quoi que ce soit sans qu'elle ne soit fermement à mes côtés, elle se dirigea vers ses appartements.",shape=box,color=blue];
		1636 -> 1638;
	1637 [label="Update boolean LyonFamilySuccess",color=orange];
		1637 -> 1639;
	1635 [label="Chat ends.",color=orange];
	1638 [label="J'ai verrouillé ma porte, je me suis déshabillé et je me suis assis au milieu de ma chambre, aussi loin que possible de tout objet, avant de m'enfoncer l'aiguille dans le flanc.",shape=box,color=blue];
		1638 -> 1640;
	1639 [label="Update boolean LyonRell3",color=orange];
		1639 -> 1641;
	1640 [label="J'avais vu ce que l'Infestation avait fait à Roathe, tordant sa chair avec ce qu'il portait à ce moment-là – je ne souhaitais pas subir le même sort.",shape=box,color=blue];
		1640 -> 1642;
	1641 [label="Update boolean LyonFaith3Unknown",color=orange];
		1641 -> 1643;
	1642 [label="Quand la souffrance fut terminée, ma vision, déjà altérée, était… floue. Dédoublée, oui, comme si je voyais en double.",shape=box,color=blue];
		1642 -> 1644;
	1643 [label="Chat ends. Next chat will be Lyon5FaithDay2.",color=orange];
	1644 [label="Je suis assez fier de ma résilience, cependant, d'avoir réussi à enfiler mon pantalon avant de vomir et de perdre connaissance.",shape=box,color=blue];
		1644 -> 1645;
	1645 [label="À mon réveil, je n'étais pas seul. Je n'étais cependant pas non plus allongé sur le sol de ma chambre. J'étais assis dans la chambre de mon enfance, sur le vieux plancher grinçant que je connaissais si bien.",shape=box,color=blue];
		1645 -> 1646;
	1646 [label="Assis à côté de moi se trouvait un jeune homme. À ses côtés se tenait une silhouette que je connais aujourd'hui sous le nom de Harrow. Le jeune homme tenait entre ses mains une petite figurine en bois. Articulée, elle avait perdu toute sa peinture, sauf peut-être dans les plis et les fissures. Elle avait appartenu à mon père. C'était une figurine de soldat.",shape=box,color=blue];
		1646 -> 1647;
	1647 [label="C'était le seul jouet que j'avais pu considérer comme le mien, quand j'étais enfant.",shape=box,color=blue];
		1647 -> 1648;
		1647 -> 1649;
	1648 [label="J'avais une figurine similaire quand j'étais enfant. C'était l'un de mes jouets préférés.",shape=box,color=red];
		1648 -> 1650;
	1649 [label="Rell?",shape=box,color=red];
		1649 -> 1651;
	1650 [label="C'est ce que j'ai entendu dire. Je crois que dans mon cas, ce fut finalement plus facile.",shape=box,color=blue];
		1650 -> 1652;
		1650 -> 1653;
		1650 -> 1654;
	1651 [label="En effet.",shape=box,color=blue];
		1651 -> 1655;
	1652 [label="Thrax est un sujet complexe. Je préfère ne pas l'aborder ici.",shape=box,color=red];
		1652 -> 1656;
	1653 [label="Ce n'était pas vraiment de sa faute. Il était simplement celui dont j'avais besoin à ce moment-là.",shape=box,color=red];
		1653 -> 1657;
	1654 [label="Ça va. Il progresse. Lentement. D'une manière ou d'une autre. L'impossible peut changer.",shape=box,color=red];
		1654 -> 1658;
	1655 [label="Le jeune homme et son gardien silencieux qui me rendaient visite dans mon rêve, dans mon esprit, m'étaient à la fois étrangers et pourtant familiers, comme si nous avions grandi ensemble comme des frères et sœurs.",shape=box,color=blue];
		1655 -> 1659;
	1656 [label="Tout à fait. On pourrait passer des heures à débattre des implications morales et théologiques de Duviri.",shape=box,color=blue];
		1656 -> 1655;
	1657 [label="Quand j'envisage ne serait-ce que la plus infime notion de ce que j'aurais pu inventer à ta place, je suis saisi d'horreur. Mais nous pourrions passer des heures à discuter de choses pareilles.",shape=box,color=blue];
		1657 -> 1655;
	1658 [label="S'il montre des signes de changement et qu'il est influencé par tes émotions, cela pourrait indiquer autre chose. Mais ce sera peut-être le sujet d'un autre débat.",shape=box,color=blue];
		1658 -> 1655;
	1659 [label="Pardonne-moi cette métaphore un peu lourde, mais c'était comme si nous étions trois arbres dont les racines étaient si intimement liées qu'elles devenaient indissociables les unes des autres,",shape=box,color=blue];
		1659 -> 1660;
	1660 [label="comme si elles avaient surgi de nulle part, dans un tel état. Je me souvenais de ma vie sans Rell et Harrow. Et pourtant, ils étaient là. À chaque instant, à chaque fois, à mes côtés.",shape=box,color=blue];
		1660 -> 1661;
	1661 [label="Au passage, j'aurais aimé pouvoir en parler à Entrati; je suis désespéré de savoir quel genre de science est à l'origine de tout cela – sans rire – mais lorsque nous nous sommes enfin remis de ce changement, Entrati avait disparu.",shape=box,color=blue];
		1661 -> 1662;
	1662 [label="Check boolean LoidFamilyComplete",color=orange];
		1662 -> 1664 [label=true,color=green];
		1662 -> 1663 [label=false,color=brown];
		1662 -> 1664 [label=false,color=brown];
	1664 [label="D'après le peu que je sais de l'Infestation et de son fonctionnement, il semblerait que ce soit... peut-être... je ne sais pas, intemporel?",shape=box,color=red];
		1664 -> 1666;
	1663 [label="La fille d'Entrati est à l'étage. Elle a étudié et travaillé avec lui. Elle pourrait peut-être t'aider.",shape=box,color=red];
		1663 -> 1665;
	1666 [label="Il y a une... guitare... c'est très difficile à expliquer et nous avons tous deux voyagé dans le temps via le Helminth...",shape=box,color=red];
		1666 -> 1668;
	1665 [label="Update boolean LyonFamilySuccess",color=orange];
		1665 -> 1667;
	1668 [label="Ce processus, je crois, hantera longtemps mes cauchemars. Quoi qu'il en soit, je ne sais pas exactement comment Rell, Harrow et moi avons tissé des liens aussi profonds, à un niveau si… moléculaire et spirituel.",shape=box,color=blue];
		1668 -> 1670;
	1667 [label="Add 1 to Family",color=orange];
		1667 -> 1669;
	1670 [label="Mais c'était réciproque. Là où ils étaient dans ma vie, j'étais dans la leur. J'ai vu l'Indifférence. J'ai compris ce contre quoi ils se dressaient. J'ai aperçu Harrow et l'homme qu'il avait été.",shape=box,color=blue];
		1670 -> 1672;
	1669 [label="Si seulement nous pouvions lui parler… Je soupçonne que des plans sont déjà en cours. Si tel est le cas, tu peux compter sur moi pour… aider. Je sais me montrer convaincant quand il le faut.",shape=box,color=blue];
		1669 -> 1671;
	1672 [label="Mais la pression de l'Indifférence m'envahit. Je la sentais là, je l'entendais, comme eux, tapotant contre les murs. Rap... tap... tap...",shape=box,color=blue];
		1672 -> 1673;
	1671 [label="Quoi qu'il en soit, je ne sais pas exactement comment Rell, Harrow et moi avons tissé des liens aussi profonds, à un niveau si… moléculaire et spirituel.",shape=box,color=blue];
		1671 -> 1670;
	1673 [label="Toutes les visions de ma jeunesse, toutes les horreurs que j'avais vues – n'étaient-elles que l'Indifférence? Étais-je en train de mal me souvenir? Ou avais-je réellement été \"béni\" par Lua?",shape=box,color=blue];
		1673 -> 1674;
	1674 [label="Ma foi intérieure… elle s’est effondrée. Réduite en miettes. Plus rien qu’un morceau de papier brûlé, réduit en poussière. Et oh, comme je me déteste pour ma faiblesse…",shape=box,color=blue];
		1674 -> 1675;
	1675 [label="Evaluate expressions",color=orange];
		1675 -> 1681 [label="LyonDating",color=purple];
		1675 -> 1682 [label="DrifterFaithYesSimilar",color=purple];
		1675 -> 1682 [label="DrifterFaithYesForeign",color=purple];
		1675 -> 1682 [label="DrifterFaithPersonal",color=purple];
		1675 -> 1680 [label="DrifterFaithSol",color=purple];
		1675 -> 1680 [label="DrifterFaithLua",color=purple];
		1675 -> 1680 [label="DrifterFaithBalance",color=purple];
		1675 -> 1679 [label="DrifterFaithAgnostic",color=purple];
		1675 -> 1678 [label="DrifterFaithNoFear",color=purple];
		1675 -> 1677 [label="DrifterFaithNoMITW",color=purple];
		1675 -> 1678 [label="DrifterFaithNoMaybe",color=purple];
		1675 -> 1676 [label="false",color=purple];
	1681 [label="Oh, Lyon… tu as tellement souffert. Le doute n’est pas un signe de faiblesse, il est le fruit de la douleur.",shape=box,color=red];
		1681 -> 1683;
		1681 -> 1684;
		1681 -> 1685;
		1681 -> 1686;
		1681 -> 1687;
	1682 [label="La foi n'a pas besoin d'être constante. Combien d'histoires parlent de personnes qui perdent la foi pour ensuite la retrouver ?",shape=box,color=red];
		1682 -> 1683;
		1682 -> 1684;
		1682 -> 1685;
	1680 [label="Tu as consacré ta vie à nos Luminaires, Lyon. Crois-tu qu'ils te tourneraient le dos pour une chose pareille?",shape=box,color=red];
		1680 -> 1683;
		1680 -> 1684;
		1680 -> 1685;
	1679 [label="Je ne sais pas si les dieux existent, Lyon – je ne pense pas que nous puissions jamais vraiment le savoir. Mais ce que je sais, c'est que tu as traversé bien des épreuves.",shape=box,color=red];
		1679 -> 1683;
		1679 -> 1685;
		1679 -> 1686;
	1678 [label="Bien que je ne croie pas personnellement en l'existence de dieux sur cette terre, je sais combien cela est important pour toi. Je ne veux en aucun cas minimiser cela.",shape=box,color=red];
		1678 -> 1685;
		1678 -> 1687;
	1677 [label="L'Indifférence, c'est nous qui l'avons créée – ce n'est pas un dieu, Lyon. Ne laisse pas l'erreur d'Entrati te détruire. Et ta foi?",shape=box,color=red];
		1677 -> 1685;
		1677 -> 1687;
	1676 [label="Ça me fait mal au cœur de te voir comme ça, pris au milieu de toutes ces folies. Tu ne méritais pas ça.",shape=box,color=red];
		1676 -> 1683;
		1676 -> 1684;
		1676 -> 1685;
		1676 -> 1686;
		1676 -> 1687;
	1683 [label="Je ne dis pas que tu dois retrouver la foi. Je dis que si tu le souhaites, si tu en ressens le besoin, ce n'est pas quelque chose de perdu à jamais.",shape=box,color=red];
		1683 -> 1688;
	1684 [label="Lua peut certainement voir ce que tu as enduré. Ce que tu as subi en son nom. ",shape=box,color=red];
		1684 -> 1689;
	1685 [label="Je pense que ce sur quoi tu dois te concentrer, c'est trouver une forme de paix intérieure, quelle que soit la manière.",shape=box,color=red];
		1685 -> 1690;
	1686 [label="Si un dieu existe, si ta Lua existe bel et bien, elle peut certainement voir ce que tu as vécu. Ce que tu as enduré en son nom. Cela doit avoir une signification pour elle.",shape=box,color=red];
		1686 -> 1691;
	1687 [label="Je pense que tu dois abandonner toute idée de l'existence ou non des dieux et te concentrer d'abord sur ta propre guérison.",shape=box,color=red];
		1687 -> 1692;
	1688 [label="Update boolean LyonFaith3Maybe",color=orange];
		1688 -> 1693;
	1689 [label="Update boolean LyonFaith3Yes",color=orange];
		1689 -> 1693;
	1690 [label="Update boolean LyonFaith3Maybe",color=orange];
		1690 -> 1693;
	1691 [label="Update boolean LyonFaith3Yes",color=orange];
		1691 -> 1693;
	1692 [label="Update boolean LyonFaith3No",color=orange];
		1692 -> 1693;
	1693 [label="Tu as peut-être raison… Et mon triste récit de doute n'était pas vraiment le sujet. Mais je vais réfléchir à tes paroles. Nous en discuterons plus en détail demain.",shape=box,color=blue];
		1693 -> 1694;
	1694 [label="J'ai vu la vie de Rell à bord du Zariman Ten Zero et tout ce qu'il a enduré ensuite. J'ai vu la vie de Harrow comme soldat, effacée par l'Infestation. Tout comme ils ont vu ma vie en Gaule et toutes mes souffrances.",shape=box,color=blue];
		1694 -> 1695;
	1695 [label="Cela te semblera peut-être étrange, mais nous n'avons jamais échangé un seul mot. Nous n'en avons jamais ressenti le besoin. Il y avait simplement entre nous une… compréhension.",shape=box,color=blue];
		1695 -> 1696;
		1695 -> 1697;
	1696 [label="Vraiment? Jamais?",shape=box,color=red];
		1696 -> 1698;
	1697 [label="Oui... je vois ça.",shape=box,color=red];
		1697 -> 1699;
	1698 [label="J'entendais leurs voix – je connaissais tous les mots qu'ils avaient prononcés dans leur vie. Mais ils ne m'étaient jamais adressés.",shape=box,color=blue];
		1698 -> 1699;
	1699 [label="Un sourire a-t-il besoin d'un discours? Et un froncement de sourcils? Faut-il entendre un enfant pleurer pour savoir qu'il souffre ou qu'il a peur? Non, nous savions simplement ce qui se transmettait entre nous.",shape=box,color=blue];
		1699 -> 1700;
	1700 [label="Jusqu'à ce que... jusqu'à ce que ce ne fût plus le cas.",shape=box,color=blue];
		1700 -> 1701;
	1701 [label="Check boolean LyonDating",color=orange];
		1701 -> 1703 [label=true,color=green];
		1701 -> 1702 [label=false,color=brown];
	1703 [label="Ils ne sont pas partis, mon miracle... seulement morts.",shape=box,color=blue];
		1703 -> 1704;
	1702 [label="Ils ne sont pas partis, Voyageur... seulement morts.",shape=box,color=blue];
		1702 -> 1704;
	1704 [label="Je n'entends plus les parties d'eux qui étaient indéterminées. À présent, je crois que je n'entends plus que celles qui l'étaient.",shape=box,color=blue];
		1704 -> 1705;
		1704 -> 1706;
	1705 [label="Attends, déterminées?",shape=box,color=red];
		1705 -> 1707;
	1706 [label="Quand as-tu… cessé de l’entendre?",shape=box,color=red];
		1706 -> 1708;
	1707 [label="Je ne peux l'expliquer davantage que je ne l'ai déjà fait. Je ne sais pas comment. Pardonne-moi.",shape=box,color=blue];
		1707 -> 1708;
	1708 [label="Le moment où nous avons traversé le Helminth avec Roathe et où nous sommes arrivés ici, au Sanctuaire. Je ne sais pas... pourquoi. Ni comment.",shape=box,color=blue];
		1708 -> 1709;
	1709 [label="Mais en traversant ce voile du temps, mes amis, mes frères… les arbres dont les racines s’entremêlaient si étroitement à mon âme… se sont desséchés et sont morts à mes côtés.",shape=box,color=blue];
		1709 -> 1710;
	1710 [label="Maintenant, il y a un vide. Une désolation. Leur souvenir m'affecte toujours. Mais je ne l'abandonnerais pour rien au monde, même si j'en avais l'occasion...",shape=box,color=blue];
		1710 -> 1711;
		1710 -> 1712;
	1711 [label="Oh?",shape=box,color=red];
		1711 -> 1713;
	1712 [label="Pourquoi pas?",shape=box,color=red];
		1712 -> 1713;
	1713 [label="Je me souviens parfaitement de la première fois où ma mère m'a frappé. Je m'en souviens de deux façons, aussi clairement que la lumière la plus éclatante de Sol et je sais que les deux versions sont vraies.",shape=box,color=blue];
		1713 -> 1714;
	1714 [label="Dans l'une… je pleure seul dans l'obscurité de ma chambre. Dans une autre, deux silhouettes se tiennent à mes côtés dans l'ombre.",shape=box,color=blue];
		1714 -> 1715;
	1715 [label="Je me souviens deux fois de la première fois où je me suis tailladé la peau pour faire taire les voix dans ma tête. Dans l'une d'elles, la pièce est vide.",shape=box,color=blue];
		1715 -> 1716;
	1716 [label="Dans l'autre, j'entends un bourdonnement derrière moi. Je ressens la présence silencieuse d'un gardien stoïque.",shape=box,color=blue];
		1716 -> 1717;
	1717 [label="Si j'ai perdu la foi en ma déesse Lua et que j'ai obtenu en retour leurs conseils... c'est peut-être un échange que je serais prêt à faire.",shape=box,color=blue];
		1717 -> 1718;
	1718 [label="Evaluate expressions",color=orange];
		1718 -> 1719 [label="LyonDating",color=purple];
		1718 -> 1724 [label="LyonDating",color=purple];
		1718 -> 1719 [label="DrifterFaithYesSimilar",color=purple];
		1718 -> 1723 [label="DrifterFaithYesSimilar",color=purple];
		1718 -> 1719 [label="DrifterFaithYesForeign",color=purple];
		1718 -> 1723 [label="DrifterFaithYesForeign",color=purple];
		1718 -> 1719 [label="DrifterFaithPersonal",color=purple];
		1718 -> 1723 [label="DrifterFaithPersonal",color=purple];
		1718 -> 1719 [label="DrifterFaithSol",color=purple];
		1718 -> 1722 [label="DrifterFaithSol",color=purple];
		1718 -> 1719 [label="DrifterFaithLua",color=purple];
		1718 -> 1722 [label="DrifterFaithLua",color=purple];
		1718 -> 1719 [label="DrifterFaithBalance",color=purple];
		1718 -> 1722 [label="DrifterFaithBalance",color=purple];
		1718 -> 1719 [label="DrifterFaithAgnostic",color=purple];
		1718 -> 1721 [label="DrifterFaithAgnostic",color=purple];
		1718 -> 1719 [label="DrifterFaithNoFear",color=purple];
		1718 -> 1720 [label="DrifterFaithNoFear",color=purple];
		1718 -> 1719 [label="DrifterFaithNoMITW",color=purple];
		1718 -> 1720 [label="DrifterFaithNoMITW",color=purple];
		1718 -> 1719 [label="DrifterFaithNoMaybe",color=purple];
		1718 -> 1720 [label="DrifterFaithNoMaybe",color=purple];
		1718 -> 1719 [label="false",color=purple];
		1718 -> 1720 [label="false",color=purple];
	1719 [label="Je compatis avec ce que vous avez tous les deux dû traverser.",shape=box,color=red];
		1719 -> 1725;
	1724 [label="J'apprécie tellement que Rell et Harrow aient pu être là avec toi, Lyon… même si ce n’était que par le biais de souvenirs.",shape=box,color=red];
		1724 -> 1728;
	1723 [label="Pourrais-tu envisager la possibilité que… tout cela soit l’œuvre d'un dieu ou de dieux? Pour te réconforter?",shape=box,color=red];
		1723 -> 1727;
	1722 [label="Pourrais-tu envisager la possibilité que… tout cela soit l’œuvre de Lua? Pour te réconforter?",shape=box,color=red];
		1722 -> 1727;
	1721 [label="Je ne comprends pas, car les deux sont forcément incompatibles, mais… je ne sais pas. Je ne sais pas si nous le saurons jamais.",shape=box,color=red];
		1721 -> 1726;
	1720 [label="J'apprécie tellement que Rell et Harrow aient pu être là avec toi, Lyon… même si ce n’était que par le biais de souvenirs.",shape=box,color=red];
		1720 -> 1725;
	1725 [label="Merci. Leur présence me manque. Mais j'apprends qu'ici, il y a plus de gens qui comprennent ma douleur que l'inverse.",shape=box,color=blue];
		1725 -> 1729;
	1728 [label="Merci. Leur présence me manque. Mais je ne suis plus seul, n'est-ce pas, mon miracle?",shape=box,color=blue];
		1728 -> 1729;
	1727 [label="Oui. Ne va pas croire que je n'y ai pas pensé. Je ne sais pas si ma foi se rétablira facilement, mais… c'est tout de même réconfortant d'y réfléchir.",shape=box,color=blue];
		1727 -> 1729;
	1726 [label="En effet. Ne va pas croire que je n'ai pas envisagé la possibilité que Rell et Harrow aient été envoyés par les Luminaires pour me réconforter. Mais comme tu l'as dit, cela nous dépasse.",shape=box,color=blue];
		1726 -> 1729;
	1729 [label="+20 Chemistry",color=orange];
		1729 -> 1730;
	1730 [label="Je suis tellement soulagé d'avoir enfin pu te parler de tout cela. C'est un poids énorme qui m'a été enlevé et je ne saurais t'exprimer toute ma gratitude.",shape=box,color=blue];
		1730 -> 1731;
	1731 [label="Check boolean LyonDating",color=orange];
		1731 -> 1733 [label=true,color=green];
		1731 -> 1732 [label=false,color=brown];
	1733 [label="Pour l'instant, je dois y aller, mon miracle.",shape=box,color=blue];
		1733 -> 1734;
	1732 [label="Pour l'instant, je dois y aller, cher Voyageur.",shape=box,color=blue];
		1732 -> 1734;
