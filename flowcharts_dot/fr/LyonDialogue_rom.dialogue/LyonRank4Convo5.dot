digraph {
	"LyonRank4Convo5 begins." [color=orange];
		"LyonRank4Convo5 begins." -> j3425926750;
	j3425926750 [label="Check boolean LyonSerum1",color=orange];
		j3425926750 -> j3339073330 [label=true,color=green];
		j3425926750 -> j2429168889 [label=true,color=green];
		j3425926750 -> j1637454916 [label=false,color=brown];
		j3425926750 -> j2429168889 [label=false,color=brown];
	j3339073330 [label="Lyon, je me demandais si je pouvais entendre le reste du récit de la façon dont Roathe est arrivé à la Cathédrale avec toi et Marie?",shape=box,color=red];
		j3339073330 -> j1946416332;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j1637454916 [label="Lyon, je me demandais si je pouvais entendre le récit de la façon dont Roathe est arrivé à la Cathédrale avec toi et Marie?",shape=box,color=red];
		j1637454916 -> j4014799937;
	j1946416332 [label="Comme tu veux. Ce n'est toutefois pas une histoire très agréable. Il a été déposé sur le pas de notre porte comme un chat sauvage blessé.",shape=box,color=blue];
		j1946416332 -> j3769319211;
	"Chat ends." [color=orange];
	j4014799937 [label="Comme tu veux. Il a été abandonné sur le pas de notre porte, tel un chat errant blessé. L'histoire n'est pas très réjouissante.",shape=box,color=blue];
		j4014799937 -> j3769319211;
	j3769319211 [label="Evaluate expressions",color=orange];
		j3769319211 -> j3369336891 [label="LyonStray",color=purple];
		j3769319211 -> j912721203 [label="RoatheSerum1",color=purple];
		j3769319211 -> j1672035211 [label="false",color=purple];
	j3369336891 [label="J'avais vu juste, cette histoire parlait de Roathe.",shape=box,color=red];
		j3369336891 -> j3258033189;
	j912721203 [label="À l'en croire, il avait toutes les raisons d'être un peu... sauvage, lorsqu'il est arrivé.",shape=box,color=red];
		j912721203 -> j3342220422;
	j1672035211 [label="Très bien, continue.",shape=box,color=red];
		j1672035211 -> j2266356665;
	j3258033189 [label="C'était l'histoire d'un chat errant qui venait souvent à la cathédrale. À toi d'en tirer tes propres conclusions, ou de comprendre pourquoi je te la raconte. Après tout, je suis prêtre, n'est-ce pas?",shape=box,color=blue];
		j3258033189 -> j2266356665;
	j3342220422 [label="Il serait normal qu'une personne de son rang et de sa personnalité se sente lésée par les agissements d'Entrati à son égard. Franchement, je serais bien plus surpris s'il gérait la situation avec élégance.",shape=box,color=blue];
		j3342220422 -> j2266356665;
	j2266356665 [label="Evaluate expressions",color=orange];
		j2266356665 -> j4001337403 [label="LyonSerum1",color=purple];
		j2266356665 -> j4169891111 [label="false",color=purple];
	j4001337403 [label="Je crois que là où je m'étais arrêté, Entrati venait de revenir avec Roathe, tel que nous le voyons maintenant, déjà transformé. Entrati nous a révélé tous les mensonges qu'il avait proférés pendant plus de trois ans.",shape=box,color=blue];
		j4001337403 -> j1840721708;
	j4169891111 [label="Je vais tenter de résumer les événements qui ont conduit à ce moment, sinon cela risque de paraître... insensé.",shape=box,color=blue];
		j4169891111 -> j3603564558;
	j1840721708 [label="Il nous a offert les \"sérums de Protoframe\" qui ont fait de nous ce que nous sommes aujourd'hui et une fois que nous les avons acceptés... il nous a immédiatement abandonnés une fois de plus.",shape=box,color=blue];
		j1840721708 -> j2990935924;
	j3603564558 [label="Pendant trois ans, deux mois et onze jours, il a été le Cardinal Dimanche dans notre cathédrale. Et pendant tout ce temps, Marie et moi l'avons servi sans nous douter de ce qu'il nous réservait.",shape=box,color=blue];
		j3603564558 -> j1837949658;
	j2990935924 [label="Et nous sommes restés là, tels des amalgames nouvellement orphelins, avec des corps et des âmes refaçonnés en des créations que nous pouvions à peine comprendre et encore moins maîtriser.",shape=box,color=blue];
		j2990935924 -> j3549024442;
	j1837949658 [label="Je connais tes questions avant même que tu ne les poses. Que tramait-il? A-t-il infecté la ville, comme il l’a fait, paraît-il, en Höllvanie? Quels étaient ses plans? Ses découvertes?",shape=box,color=blue];
		j1837949658 -> j2854857907;
	j3549024442 [label="Nous étions bloqués dans une ville qui était notre foyer, mais où nous n'étions plus les bienvenus. Nous étions... contraints de nous cacher.",shape=box,color=blue];
		j3549024442 -> j281611880;
		j3549024442 -> j425218258;
	j2854857907 [label="Là, attends-toi à une déception. Il prêchait. Il étudiait. Il se reposait. Et il priait. Puis, une nuit, il disparut au milieu d'une terrible tempête. Comme celle lors de laquelle il était apparu.",shape=box,color=blue];
		j2854857907 -> j2575044127;
	j281611880 [label="À cause de votre apparence?",shape=box,color=red];
		j281611880 -> j1453062538;
	j425218258 [label="La cathédrale vous a-t-elle rejetés?",shape=box,color=red];
		j425218258 -> j235973123;
	j2575044127 [label="Check boolean MarieLyonVisions",color=orange];
		j2575044127 -> j483609258 [label=true,color=green];
		j2575044127 -> j3887577835 [label=false,color=brown];
	j1453062538 [label="Je ne sais pas si tu l'as remarqué, mais Marie peut voler et Roathe est... bleu, entre autres choses.",shape=box,color=blue];
		j1453062538 -> j268156384;
	j235973123 [label="Pas... exactement. Nous avons été écartés de la vie publique. Mais nos frères et sœurs ne nous ont pas bannis, ni brûlés sur le bûcher. Le \"Cardinal Dimanche\" les a convaincus que nos changements étaient... l’œuvre des Luminaires.",shape=box,color=blue];
		j235973123 -> j3247316048;
	j483609258 [label="Bien que je sois parfaitement conscient que les autres n'ont pas ressenti cette tempête, je l'ai perçue très nettement.",shape=box,color=blue];
		j483609258 -> j3887577835;
	j3887577835 [label="Un an jour pour jour après cela, il réapparut une dernière fois, avec... Roathe, tel que tu le vois maintenant, effondré et inconscient à ses pieds.",shape=box,color=blue];
		j3887577835 -> j3278550207;
	j268156384 [label="Je sais que tu passes tes journées avec des animaux et des crânes qui parlent, ou à méditer sur la question du Néant cosmique, mais ce n'est pas le lot de la plupart des humains.",shape=box,color=blue];
		j268156384 -> j1403143807;
	j3247316048 [label="Nous étions cachés dans les cryptes et tenus à l'écart. Nos anciens frères, bien que terrifiés par nous, nous apportaient des provisions.",shape=box,color=blue];
		j3247316048 -> j1545359778;
	j3278550207 [label="Un diable en chair et en os, du moins en apparence. C'est alors qu'Entrati nous révéla sa véritable identité – lorsqu'il nous salua – et la mission qu'il nous avait confiée. Il nous avait choisis tous deux pour une mission des plus \"sacrées\".",shape=box,color=blue];
		j3278550207 -> j1842078425;
	j1403143807 [label="En fait, je suis celui des trois qui pourrait peut-être se fondre dans la foule si je parvenais à bien me dissimuler. ",shape=box,color=blue];
		j1403143807 -> j705177566;
		j1403143807 -> j3519543493;
	j1545359778 [label="Ils... insistaient pour n'interagir qu'avec Marie, malgré ses apparitions fantomatiques et soudaines sur les marches pour les accueillir. ",shape=box,color=blue];
		j1545359778 -> j2712512161;
		j1545359778 -> j3508225202;
	j1842078425 [label="Marie a accepté le sérum sans hésiter. Évidemment. Comment aurait-elle pu faire autrement? Et comment aurais-je pu ne pas la suivre? Comment aurais-je pu ne pas chercher la vérité, où qu'elle me mène?",shape=box,color=blue];
		j1842078425 -> j249472217;
	j705177566 [label="Où êtes-vous allés?",shape=box,color=red];
		j705177566 -> j2609993561;
	j3519543493 [label="Comment vous êtes-vous tous retrouvés ici?",shape=box,color=red];
		j3519543493 -> j2755201012;
	j2712512161 [label="Je comprends qu'ils évitaient Roathe, mais... Ils préféreraient ça plutôt que de te parler?",shape=box,color=red];
		j2712512161 -> j681904852;
	j3508225202 [label="Elle est très gentille...",shape=box,color=red];
		j3508225202 -> j4216268376;
	j249472217 [label="Boolean LyonSerum1 is now true.",color=orange];
		j249472217 -> j4285309963;
		j249472217 -> j4178757386;
		j249472217 -> j1114254023;
	j2609993561 [label="Nos frères et sœurs ne nous ont pas bannis, ni brûlés sur le bûcher. Le \"Cardinal Dimanche\" les a convaincus que nos changements étaient... l’œuvre des Luminaires.",shape=box,color=blue];
		j2609993561 -> j4244582981;
	j2755201012 [label="Roathe connaîtra les détails précis du \"comment\", mais après... de nombreuses années de travail, il a créé un \"Helminth\" à partir d'échantillons de notre sang.",shape=box,color=blue];
		j2755201012 -> j2876553168;
	j681904852 [label="Je crois bien que nous nous sommes déjà rencontrés, n'est-ce pas?",shape=box,color=blue];
		j681904852 -> j486923011;
	j4216268376 [label="Précisément.",shape=box,color=blue];
		j4216268376 -> j169457197;
	j4285309963 [label="Je pense qu'elle vénère encore un peu trop Entrati.",shape=box,color=red];
		j4285309963 -> j1675759304;
	j4178757386 [label="Il s'est passé quoi ensuite?",shape=box,color=red];
		j4178757386 -> j2397982026;
	j1114254023 [label="Tu regrettes?",shape=box,color=red];
		j1114254023 -> j3130982127;
	j4244582981 [label="Nous étions cachés dans les cryptes et tenus à l'écart. Nos anciens frères, bien que terrifiés par nous, nous apportaient des provisions.",shape=box,color=blue];
		j4244582981 -> j1874531882;
	j2876553168 [label="Je crois que l'Infestation est liée à elle-même à travers... le temps... d'une manière ou d'une autre... même si les détails m'échappent complètement.",shape=box,color=blue];
		j2876553168 -> j3482017083;
		j2876553168 -> j2893907521;
	j486923011 [label="Combien de temps êtes-vous restés coincés là-dessous?",shape=box,color=red];
		j486923011 -> j2364354503;
	j169457197 [label="Donc... ils vous ont tous gardés au sous-sol?",shape=box,color=red];
		j169457197 -> j3710111105;
	j1675759304 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j1675759304 -> j1576059838;
	j2397982026 [label="Roathe s'est réveillé. Au début, il avait du mal à se souvenir de son nom. Entrati adressa une dernière phrase au bougre: \"Uriel, hérétique de Xata, en exil, réponds: les Orokin peuvent-ils jamais être pardonnés?\"",shape=box,color=blue];
		j2397982026 -> j1170094966;
	j3130982127 [label="Je regrette tout, Voyageur. Oui, bien sûr. Mais est-ce que je le referais? Oui, bien sûr. Je ne peux pas laisser Marie seule.",shape=box,color=blue];
		j3130982127 -> j1120525622;
	j1874531882 [label="Ils... insistaient pour n'interagir qu'avec Marie, malgré ses apparitions fantomatiques et soudaines sur les marches pour les accueillir. ",shape=box,color=blue];
		j1874531882 -> j1901195992;
		j1874531882 -> j1528524668;
	j3482017083 [label="Il a créé un Helminth par rétro-ingénierie?! Combien de temps ça a pris?!",shape=box,color=red];
		j3482017083 -> j989123185;
	j2893907521 [label="Je ne pense pas que quiconque le comprenne. C'est une découverte récente.",shape=box,color=red];
		j2893907521 -> j1022219671;
	j2364354503 [label="Je ne suis peut-être pas la personne la plus indiquée pour te dire combien d'années se sont écoulées depuis que nous sommes devenus des amalgames Infestés. Ma perception du temps qui passe depuis lors est... compliquée.",shape=box,color=blue];
		j2364354503 -> j3759888595;
		j2364354503 -> j544418008;
	j3710111105 [label="Cela paraît peut-être plus dur que ce n'était. Il n'y avait nulle part ailleurs où nous mettre. Le clocher était trop ouvert, trop exposé aux intempéries. La crypte était sûre et chaude.",shape=box,color=blue];
		j3710111105 -> j1397398145;
	j1576059838 [label="Sur ce point, nous sommes d'accord. Mais je ne peux pas la blâmer pour autant. Laisse-lui du temps. Elle finira par comprendre. Elle est d'une intelligence remarquable, Voyageur. Ne la prends pas pour une idiote.",shape=box,color=blue];
		j1576059838 -> j1120525622;
	j1170094966 [label="Entrati partit alors pour la dernière fois. Et il laissa Roathe, désormais transformé en ce que tu vois aujourd'hui – avec nous, mieux à même de gérer ce diable capricieux.",shape=box,color=blue];
		j1170094966 -> j2990935924;
	j1120525622 [label="Pour continuer l'histoire... Entrati partit alors pour la dernière fois. Et il laissa Roathe, désormais transformé en ce que tu vois aujourd'hui – avec nous, mieux à même de gérer ce diable capricieux.",shape=box,color=blue];
		j1120525622 -> j2990935924;
	j1901195992 [label="Je comprends qu'ils évitaient Roathe, mais... Ils préféreraient ça plutôt que de te parler?",shape=box,color=red];
		j1901195992 -> j4064247979;
	j1528524668 [label="Elle est très gentille...",shape=box,color=red];
		j1528524668 -> j1757021613;
	j989123185 [label="Boolean LyonRoatheHelminth is now true.",color=orange];
		j989123185 -> j3659614987;
	j1022219671 [label="Je ne sais pas si c'est réconfortant ou inquiétant, mais merci. C'est déjà assez étrange de savoir que l'Infestation peut parler.",shape=box,color=blue];
		j1022219671 -> j931784569;
		j1022219671 -> j3494033936;
	j3759888595 [label="Compliquée, comment?",shape=box,color=red];
		j3759888595 -> j3713613701;
	j544418008 [label="Je ne sais pas si je devrais te dire que l'Infestation peut aussi parler...",shape=box,color=red];
		j544418008 -> j2370751437;
	j1397398145 [label="Et malheureusement, nous avons découvert qu'il y avait des sorties que Roathe pouvait utiliser pour... vagabonder.",shape=box,color=blue];
		j1397398145 -> j845860967;
	j4064247979 [label="Je crois bien que nous nous sommes déjà rencontrés, n'est-ce pas?",shape=box,color=blue];
		j4064247979 -> j486923011;
		j4064247979 -> j169457197;
	j1757021613 [label="Précisément.",shape=box,color=blue];
		j1757021613 -> j169457197;
		j1757021613 -> j486923011;
	j3659614987 [label="Je ne suis peut-être pas la personne à qui tu devrais t'adresser. Ma perception du temps qui passe depuis lors est devenue... compliquée. Ou plutôt, \"plus compliquée\". Comme si cela ne pouvait pas être plus horrible...",shape=box,color=blue];
		j3659614987 -> j3759888595;
		j3659614987 -> j544418008;
	j931784569 [label="Pas tous les objets. Les chaises peuvent parfois être... enfin... peu importe, continue.",shape=box,color=red];
		j931784569 -> j2842025738;
	j3494033936 [label="Je t'épargnerai la conversation avec la guitare.",shape=box,color=red];
		j3494033936 -> j4075291240;
	j3713613701 [label="Boolean LyonTime1 is now true.",color=orange];
		j3713613701 -> j797673516;
	j2370751437 [label="Crois-moi, je sais. Et c'est déconcertant, merci. On dirait que chaque objet du quotidien, même le plus anodin, a une voix.",shape=box,color=blue];
		j2370751437 -> j931784569;
		j2370751437 -> j3494033936;
	j845860967 [label="Evaluate expressions",color=orange];
		j845860967 -> j2322243819 [label="MarieRoathePastry1",color=purple];
		j845860967 -> j2322243819 [label="RoatheMariePastry1",color=purple];
		j845860967 -> j4181435332 [label="false",color=purple];
	j2842025738 [label="Si le mot que tu allais dire était \"habitées\", je l'ai vu aussi, Voyageur. Celle-là murmurait. Celui dans le mur. J'ai entendu des coups...",shape=box,color=blue];
		j2842025738 -> j1230916736;
	j4075291240 [label="Si, je t'en prie. En fait, je trouverais bien plus réconfortant, je crois, qu'un instrument de musique soit une sorte de demi-dieu éphémère plutôt que... quoi que ce soit d'autre qui hante et abandonne mon esprit. Est-ce étrange que... depuis qu'il...",shape=box,color=blue];
		j4075291240 -> j2032346604;
	j797673516 [label="Je ne sais pas si c'est simplement dû à ma sensibilité particulière à ce sujet, ou à... des circonstances personnelles que j'ai créées, ou... à lui.",shape=box,color=blue];
		j797673516 -> j651364409;
	j2322243819 [label="C'est ce que j'ai entendu dire.",shape=box,color=red];
		j2322243819 -> j1121228955;
	j4181435332 [label="Oh?",shape=box,color=red];
		j4181435332 -> j1664988381;
	j1230916736 [label="Il y a une voix qui m'a guidé, une voix que je sais ne pas avoir entendue de toute ma vie et pourtant, elle s'étend jusqu'à mon passé et loin dans mon avenir...",shape=box,color=blue];
		j1230916736 -> j419973232;
	j2032346604 [label="Il?",shape=box,color=red];
		j2032346604 -> j1230916736;
	j651364409 [label="Et je sais que tu vas me prendre pour un fou furieux quand je dirai ça, mais je ne perçois pas le temps de façon... purement... linéaire.",shape=box,color=blue];
		j651364409 -> j1836262051;
		j651364409 -> j2743321139;
	j1121228955 [label="Je pense que c'est l'une de ses rares qualités. Non pas le vol en lui-même, mais plutôt ses motivations. Selon moi, il s'est procuré les objets illicites pour inciter Marie à lui parler.",shape=box,color=blue];
		j1121228955 -> j3350779366;
	j1664988381 [label="Ce n'est ni ici ni là.",shape=box,color=blue];
		j1664988381 -> j316719513;
		j1664988381 -> j2252365599;
	j419973232 [label="Il est impossible que cela ait toujours été là. Pourtant, je m'en souviens maintenant, aussi clairement que la lumière argentée de Lua elle-même, derrière le mur de la maison de mon enfance. La voix d'un jeune homme. La présence d'une autre personne à ses côtés... \"Rap tap tap...\"",shape=box,color=blue];
		j419973232 -> j2862518333;
	j1836262051 [label="Qui?",shape=box,color=red];
		j1836262051 -> j1230916736;
	j2743321139 [label="J'ai perçu le temps pendant un nombre incalculable de siècles comme des spirales en boucle, Lyon.",shape=box,color=red];
		j2743321139 -> j2664886413;
	j3350779366 [label="Et peut-être aussi parce qu'il la faisait sourire, quand elle pensait qu'il ne la regardait pas. Un jour, il m'a dit: \"C'est un grand coup du sort qu'elle ait été si peu favorisée par la vie.\"",shape=box,color=blue];
		j3350779366 -> j3733610902;
	j316719513 [label="Combien de temps vous a-t-il fallu pour revenir à... enfin, maintenant?",shape=box,color=red];
		j316719513 -> j3942075747;
	j2252365599 [label="Il s'est passé quoi ensuite?",shape=box,color=red];
		j2252365599 -> j2755201012;
	j2862518333 [label="Je... pardonne-moi. Je dois y aller. Je ne peux pas encore en parler. Je suis... je suis désolé. Ne m’en parle plus.",shape=box,color=blue];
		j2862518333 -> j4289747768;
	j2664886413 [label="Que dis-tu alors, quand je te parle d'une voix qui m'a alerté au-delà de ma propre raison? Je sais que je ne l'ai pas entendue de toute ma vie. Il est impossible qu'elle ait toujours été là.",shape=box,color=blue];
		j2664886413 -> j2221272698;
	j3733610902 [label="Boolean LyonRoathePastry is now true.",color=orange];
		j3733610902 -> j3143464103;
		j3733610902 -> j316719513;
	j3942075747 [label="Je ne suis peut-être pas la personne la plus indiquée pour te dire combien d'années se sont écoulées depuis que nous sommes devenus des amalgames Infestés. Ma perception du temps qui passe depuis lors est... compliquée.",shape=box,color=blue];
		j3942075747 -> j544418008;
		j3942075747 -> j3759888595;
	j4289747768 [label="Lyon, attends!",shape=box,color=red];
		j4289747768 -> j777162605;
	j2221272698 [label="Pourtant, je m'en souviens maintenant, aussi clairement que la lumière argentée de Lua elle-même, derrière le mur de la maison de mon enfance. La voix d'un jeune homme... \"Rap tap tap...\"",shape=box,color=blue];
		j2221272698 -> j2862518333;
	j3143464103 [label="C'est presque adorable de sa part, tu as raison. Que s'est-il passé ensuite?",shape=box,color=red];
		j3143464103 -> j2755201012;
	j777162605 [label="Boolean LyonRell1 is now true.",color=orange];
		j777162605 -> j367054140;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
}