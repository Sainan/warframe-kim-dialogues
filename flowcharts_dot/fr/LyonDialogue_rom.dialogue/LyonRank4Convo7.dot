digraph {
	1285 [label="LyonRank4Convo7 begins.",color=orange];
		1285 -> 1286;
	1286 [label="Voyageur? Puis-je te présenter mes excuses?",shape=box,color=blue];
		1286 -> 1287;
		1286 -> 1288;
		1286 -> 1289;
	1287 [label="Oui? Pourquoi?",shape=box,color=red];
		1287 -> 1290;
	1288 [label="Il n'y a pas besoin, Lyon. Tu n'as rien fait de mal.",shape=box,color=red];
		1288 -> 1291;
	1289 [label="[Fin.]",shape=box,color=red];
		1289 -> 1292;
	1290 [label="+5 Chemistry",color=orange];
		1290 -> 1293;
	1291 [label="J'apprécie tes paroles, mais j'estime néanmoins que tu mérites une réponse. Je ferai de mon mieux pour être bref et ne pas m'encombrer de détails inutiles.",shape=box,color=blue];
		1291 -> 1294;
	1292 [label="Chat ends.",color=orange];
	1293 [label="Merci. Je ferai de mon mieux pour être bref et ne pas m'encombrer d'érudition inutile.",shape=box,color=blue];
		1293 -> 1294;
	1294 [label="Les conversations sont difficiles pour moi. Bien plus difficiles lors d'échanges intimes que lors de ces conversations impersonnelles et mécaniques ou par courrier.",shape=box,color=blue];
		1294 -> 1295;
	1295 [label="Je ne sais pas comment le décrire, si ce n'est que c'est... comme si j'essayais d'attraper quelque chose, pour ne voir que des grains de poussière m'échapper entre les doigts. ",shape=box,color=blue];
		1295 -> 1296;
	1296 [label="J'ai souvent l'impression d'être un morceau de toile vierge, étalant de la peinture à l'huile sur sa surface, tentant vainement de créer l'ombre d'une image que je vois dans mon esprit.",shape=box,color=blue];
		1296 -> 1297;
	1297 [label="Pourtant, plus j'y travaille, plus la situation me paraît désespérée.",shape=box,color=blue];
		1297 -> 1298;
	1298 [label="Plus j'essaie, plus cela m'échappe. Alors, j'ai tout simplement appris... à ne même pas essayer.",shape=box,color=blue];
		1298 -> 1299;
	1299 [label="Voilà pourquoi je t'évitais, au début. Et pourquoi je suis encore... sujet à des accès de solitude. Les mots me manquent.",shape=box,color=blue];
		1299 -> 1300;
		1299 -> 1301;
		1299 -> 1302;
	1300 [label="Ce sera toujours un plaisir de t'avoir à mes côtés en silence.",shape=box,color=red];
		1300 -> 1303;
	1301 [label="J'ai tendance à faire pareil, parfois. Ce n'est pas grave.",shape=box,color=red];
		1301 -> 1304;
	1302 [label="Excuses acceptées.",shape=box,color=red];
		1302 -> 1305;
	1303 [label="+15 Chemistry",color=orange];
		1303 -> 1306;
	1304 [label="+15 Chemistry",color=orange];
		1304 -> 1307;
	1305 [label="+10 Chemistry",color=orange];
		1305 -> 1308;
	1306 [label="Je... m'en souviendrai. Merci, Voyageur.",shape=box,color=blue];
		1306 -> 1309;
	1307 [label="Je ne m'en étais pas rendu compte. Je me souviendrai de ne pas me croire si seul au monde... Merci, Voyageur.",shape=box,color=blue];
		1307 -> 1309;
	1308 [label="Bien sûr. Merci, Voyageur.",shape=box,color=blue];
		1308 -> 1309;
	1309 [label="Père Lyon Allard",shape=box,color=blue];
		1309 -> 1310;
	1310 [label="Chat ends.",color=orange];
}