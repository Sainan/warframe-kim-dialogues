digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank4Convo7 begins." [color=orange];
		"LyonRank4Convo7 begins." -> j3284668974;
	j3284668974 [label="Voyageur? Puis-je te présenter mes excuses?",shape=box,color=blue];
		j3284668974 -> j3603246005;
		j3284668974 -> j4142083280;
		j3284668974 -> j2429168889;
	j3603246005 [label="Oui? Pourquoi?",shape=box,color=red];
		j3603246005 -> j3516013161;
	j4142083280 [label="Il n'y a pas besoin, Lyon. Tu n'as rien fait de mal.",shape=box,color=red];
		j4142083280 -> j3646216021;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j3516013161 [label="+5 Chemistry",color=orange];
		j3516013161 -> j2307439281;
	j3646216021 [label="J'apprécie tes paroles, mais j'estime néanmoins que tu mérites une réponse. Je ferai de mon mieux pour être bref et ne pas m'encombrer de détails inutiles.",shape=box,color=blue];
		j3646216021 -> j2248710103;
	"Chat ends." [color=orange];
	j2307439281 [label="Merci. Je ferai de mon mieux pour être bref et ne pas m'encombrer d'érudition inutile.",shape=box,color=blue];
		j2307439281 -> j2248710103;
	j2248710103 [label="Les conversations sont difficiles pour moi. Bien plus difficiles lors d'échanges intimes que lors de ces conversations impersonnelles et mécaniques ou par courrier.",shape=box,color=blue];
		j2248710103 -> j299957882;
	j299957882 [label="Je ne sais pas comment le décrire, si ce n'est que c'est... comme si j'essayais d'attraper quelque chose, pour ne voir que des grains de poussière m'échapper entre les doigts. ",shape=box,color=blue];
		j299957882 -> j1652669762;
	j1652669762 [label="J'ai souvent l'impression d'être un morceau de toile vierge, étalant de la peinture à l'huile sur sa surface, tentant vainement de créer l'ombre d'une image que je vois dans mon esprit.",shape=box,color=blue];
		j1652669762 -> j1279061106;
	j1279061106 [label="Pourtant, plus j'y travaille, plus la situation me paraît désespérée.",shape=box,color=blue];
		j1279061106 -> j1515475661;
	j1515475661 [label="Plus j'essaie, plus cela m'échappe. Alors, j'ai tout simplement appris... à ne même pas essayer.",shape=box,color=blue];
		j1515475661 -> j499998495;
	j499998495 [label="Voilà pourquoi je t'évitais, au début. Et pourquoi je suis encore... sujet à des accès de solitude. Les mots me manquent.",shape=box,color=blue];
		j499998495 -> j1164219429;
		j499998495 -> j3766770908;
		j499998495 -> j2470038380;
	j1164219429 [label="Ce sera toujours un plaisir de t'avoir à mes côtés en silence.",shape=box,color=red];
		j1164219429 -> j634610557;
	j3766770908 [label="J'ai tendance à faire pareil, parfois. Ce n'est pas grave.",shape=box,color=red];
		j3766770908 -> j2686359013;
	j2470038380 [label="Excuses acceptées.",shape=box,color=red];
		j2470038380 -> j2830059770;
	j634610557 [label="+15 Chemistry",color=orange];
		j634610557 -> j2178688114;
	j2686359013 [label="+15 Chemistry",color=orange];
		j2686359013 -> j3070627336;
	j2830059770 [label="+10 Chemistry",color=orange];
		j2830059770 -> j633316631;
	j2178688114 [label="Je... m'en souviendrai. Merci, Voyageur.",shape=box,color=blue];
		j2178688114 -> j727687311;
	j3070627336 [label="Je ne m'en étais pas rendu compte. Je me souviendrai de ne pas me croire si seul au monde... Merci, Voyageur.",shape=box,color=blue];
		j3070627336 -> j727687311;
	j633316631 [label="Bien sûr. Merci, Voyageur.",shape=box,color=blue];
		j633316631 -> j727687311;
	j727687311 [label="Père Lyon Allard",shape=box,color=blue];
		j727687311 -> "Chat ends.";
}