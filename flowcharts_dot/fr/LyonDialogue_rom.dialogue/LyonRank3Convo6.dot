digraph {
	568 [label="LyonRank3Convo6 begins.",color=orange];
		568 -> 570;
		568 -> 569;
	570 [label="Combien de temps Entrati est-il resté à la cathédrale avec toi avant l'arrivée de Roathe?",shape=box,color=red];
		570 -> 572;
	569 [label="[Fin.]",shape=box,color=red];
		569 -> 571;
	572 [label="Pourquoi me poses-tu cette question?",shape=box,color=blue];
		572 -> 573;
	571 [label="Chat ends.",color=orange];
	573 [label="Evaluate expressions",color=orange];
		573 -> 577 [label="MarieLyonVisions",color=purple];
		573 -> 574 [label="MarieLyonVisions",color=purple];
		573 -> 575 [label="MarieLyonVisions",color=purple];
		573 -> 576 [label="MarieLyonVisions",color=purple];
		573 -> 574 [label="LyonVisions1",color=purple];
		573 -> 575 [label="LyonVisions1",color=purple];
		573 -> 576 [label="LyonVisions1",color=purple];
		573 -> 577 [label="LyonVisions1",color=purple];
		573 -> 574 [label="false",color=purple];
		573 -> 575 [label="false",color=purple];
	577 [label="On m'a dit que tu pourrais ne pas voir les choses comme nous. Mais cela ne me dérange pas. Ce qui m'intéresse, c'est ce que tu sais.",shape=box,color=red];
		577 -> 581;
	574 [label="Marie semble obsédée par \"le Cardinal\". Et Roathe le déteste, c'est évident. Je cherche une personne neutre. Tu es ce qui s'en rapproche le plus.",shape=box,color=red];
		574 -> 578;
	575 [label="Je... ne sais pas quoi te demander d'autre?",shape=box,color=red];
		575 -> 579;
	576 [label="On m'a dit que tu pourrais ne pas voir les choses comme nous. Mais je crois que tu pourrais percevoir la vérité là où d'autres ne la voient pas.",shape=box,color=red];
		576 -> 580;
	581 [label="Hum. Cela ne te dérange-t-il pas de te rabaisser avec des fous et des aliénés? Curieux. Bien que tu sembles fréquenter des animaux qui parlent et... des créatures d’un autre temps. Je suppose que je ne suis ni plus ni moins extravagant que le reste de ta collection.",shape=box,color=blue];
		581 -> 582;
	578 [label="Tu te retrouves face à un choix cornélien, avec un aliéné comme seule source d'avis \"neutre\". Je ne comprends pas pourquoi tu te donnes la peine de me parler.",shape=box,color=blue];
		578 -> 582;
	579 [label="Pourquoi insistes-tu pour me parler? Il n'y a pas besoin, tu le sais bien. Si tu souhaites te lier d'amitié avec Marie, voire la courtiser, je ne suis ni son tuteur, ni son père. Et quelles que soient tes intentions envers ce salaud de Roathe, je me soucie peu de lui, hormis les réponses qu'il me doit.",shape=box,color=blue];
		579 -> 582;
	580 [label="La \"Vérité.\" J’aimerais que tu comprennes à quel point cela me fait rire ces derniers temps. Cela ne te dérange-t-il pas de te rabaisser avec des fous et des aliénés? Curieux. Bien que tu sembles fréquenter des animaux qui parlent et... des créatures d’un autre temps. Je suppose que je ne suis ni plus ni moins extravagant que le reste de ta collection.",shape=box,color=blue];
		580 -> 582;
	582 [label="Evaluate expressions",color=orange];
		582 -> 585 [label="LyonFirstFlirt",color=purple];
		582 -> 585 [label="DrifterLyon",color=purple];
		582 -> 584 [label="LyonOffer",color=purple];
		582 -> 583 [label="false",color=purple];
	585 [label="Et s'il te plaît, épargne-nous un autre moment... gênant, veux-tu? Je sais que les raisons que tu as évoquées pour me parler sont flatteuses, mais aussi terriblement hypocrites.",shape=box,color=blue];
		585 -> 586;
		585 -> 587;
		585 -> 588;
	584 [label="Et s'il te plaît, épargne-nous à tous les deux un autre discours sur la façon dont tu souhaites \"m'aider\", veux-tu? Je suis certain que tes intentions sont bonnes, mais c'est agaçant, cette hypocrisie ridicule.",shape=box,color=blue];
		584 -> 586;
		584 -> 587;
		584 -> 588;
	583 [label="Et s'il te plaît, épargne-nous à tous les deux un long discours sur la façon dont tu souhaites \"m'aider\" ou \"m'offrir ton amitié\". Je suis certain que tes intentions sont bonnes, mais c'est agaçant, cette hypocrisie ridicule.",shape=box,color=blue];
		583 -> 586;
		583 -> 587;
		583 -> 588;
	586 [label="Hypocrisie parce que tu crois que je ne pense pas ce que je dis, ou parce que tu crois que je ne peux pas penser ça à ton sujet?",shape=box,color=red];
		586 -> 589;
	587 [label="Prêtre, je voulais juste savoir combien de temps Entrati a pu se faire passer pour un Cardinal. C'est tout.",shape=box,color=red];
		587 -> 590;
	588 [label="Que veux-tu dire par \"hypocrite\"? Tu m'accuses de te mentir?",shape=box,color=red];
		588 -> 591;
	589 [label="Ni l'un ni l'autre. Tes paroles sont une charité dont je n'ai ni besoin, ni envie.",shape=box,color=blue];
		589 -> 592;
		589 -> 593;
	590 [label="Très bien. Pendant trois ans, deux mois et onze jours, il a été le Cardinal Dimanche dans notre cathédrale. Et pendant tout ce temps, Marie et moi l'avons servi sans nous douter de ce qu'il nous réservait.",shape=box,color=blue];
		590 -> 594;
	591 [label="Evaluate expressions",color=orange];
		591 -> 597 [label="DrifterLiar",color=purple];
		591 -> 596 [label="LyonSuspicious",color=purple];
		591 -> 595 [label="false",color=purple];
	592 [label="Comment Marie fait-elle pour supporter ça...?",shape=box,color=red];
		592 -> 598;
	593 [label="Tu penses que quiconque choisit de passer du temps avec toi accomplit un acte de charité?",shape=box,color=red];
		593 -> 599;
	594 [label="Je connais tes questions avant même que tu ne les poses. Que tramait-il? A-t-il infecté la ville, comme il l’a fait, paraît-il, en Höllvanie? Quels étaient ses plans? Ses découvertes?",shape=box,color=blue];
		594 -> 600;
	597 [label="As-tu quelque chose à confesser, Voyageur? Y a-t-il une pénitence que tu souhaites faire?",shape=box,color=blue];
		597 -> 601;
	596 [label="Hum. Non. Pas encore, peut-être.",shape=box,color=blue];
		596 -> 595;
	595 [label="Ton hypocrisie n'est pas un mensonge. Elle se veut charitable. Une charité dont je n'ai ni besoin, ni envie. ",shape=box,color=blue];
		595 -> 592;
		595 -> 593;
	598 [label="Le mieux serait de lui poser la question toi-même. Je me la suis souvent posée.",shape=box,color=blue];
		598 -> 602;
	599 [label="Simplement? Oui.",shape=box,color=blue];
		599 -> 603;
	600 [label="Alors, je dirai: attends-toi à une déception. Pendant ces trois ans, deux mois et onze jours? Il a prêché. Il a étudié. Il s’est reposé. Et il a prié.",shape=box,color=blue];
		600 -> 604;
		600 -> 605;
		600 -> 606;
	601 [label="Cela n'a aucune importance. Tu n'es pas là pour demander pardon et tes mensonges passés ne sont pas comparables à ton hypocrisie actuelle.",shape=box,color=blue];
		601 -> 607;
	602 [label="Chat ends.",color=orange];
	603 [label="Update boolean LyonHate1",color=orange];
		603 -> 608;
		603 -> 609;
		603 -> 610;
	604 [label="Quand vous a-t-il transformés en Protoframes?",shape=box,color=red];
		604 -> 611;
	605 [label="J'ai beaucoup de mal à imaginer Entrati en train de prier.",shape=box,color=red];
		605 -> 612;
	606 [label="Il était donc... en congé sabbatique?!",shape=box,color=red];
		606 -> 613;
	607 [label="Ce que tu dis maintenant relève de la simple charité. Une charité qui ne répond ni à mon besoin ni à mon désir.",shape=box,color=blue];
		607 -> 592;
		607 -> 593;
	608 [label="Voilà un sujet à approfondir un autre jour – je sens qu'on tourne en rond.",shape=box,color=red];
		608 -> 614;
	609 [label="Et Marie... ?",shape=box,color=red];
		609 -> 615;
	610 [label="Tu dois avoir une piètre opinion de toi-même.",shape=box,color=red];
		610 -> 616;
	611 [label="Après ces trois années et quelques jours, il disparut au milieu d'une terrible tempête. Comme celle au cours de laquelle il était apparu.",shape=box,color=blue];
		611 -> 617;
	612 [label="Il est impossible de sonder les pensées d'autrui. Il était agenouillé devant l'autel, la tête baissée. Était-il en prière? Ou était-il simplement perdu dans ses pensées? Je l'ignore.",shape=box,color=blue];
		612 -> 611;
	613 [label="+5 Chemistry",color=orange];
		613 -> 618;
	614 [label="+5 Chemistry",color=orange];
		614 -> 619;
	615 [label="Marie bercerait un ours enragé sur ses genoux et le laisserait lui arracher la gorge si elle pensait que cela apporterait à l'animal un instant de paix.",shape=box,color=blue];
		615 -> 620;
	616 [label="Je dirais plutôt un attachement indéfectible au pragmatisme, mais définis-cela comme tu le souhaites.",shape=box,color=blue];
		616 -> 621;
	617 [label="Evaluate expressions",color=orange];
		617 -> 622 [label="MarieLyonVisions",color=purple];
		617 -> 622 [label="LyonVisions1",color=purple];
		617 -> 623 [label="false",color=purple];
	618 [label="Hum. Je n'y avais pas pensé, mais oui, c'est possible. Quelle frustration pour vous tous! Cela semble correspondre au peu que nous savons de sa véritable nature.",shape=box,color=blue];
		618 -> 611;
	619 [label="C'est sans doute une sage décision. Ta question portait sur le Cardinal Dimanche et son mandat à la cathédrale.",shape=box,color=blue];
		619 -> 624;
	620 [label="Elle possède une âme d'une beauté singulière, que je protégerai jusqu'à mon dernier souffle.",shape=box,color=blue];
		620 -> 621;
	621 [label="+5 Chemistry",color=orange];
		621 -> 625;
	622 [label="Bien que je sois parfaitement conscient que les autres n'ont pas ressenti cette tempête, je l'ai perçue très nettement.",shape=box,color=blue];
		622 -> 623;
	623 [label="Un an jour pour jour après cela, il réapparut une dernière fois, avec... Roathe, tel que tu le vois maintenant, effondré et inconscient à ses pieds.",shape=box,color=blue];
		623 -> 626;
	624 [label="Pendant trois ans, deux mois et onze jours, il a été le Cardinal Dimanche dans notre cathédrale. Et pendant tout ce temps, Marie et moi l'avons servi sans nous douter de ce qu'il nous réservait.",shape=box,color=blue];
		624 -> 594;
	625 [label="Mais c'est à cela qu'il faut s'attendre: poser une simple question à un aliéné est souvent une entreprise vaine. Permets-moi de revenir à ton sujet initial et de nous éloigner du mien.",shape=box,color=blue];
		625 -> 624;
	626 [label="Un diable en chair et en os, du moins en apparence. C'est alors qu'Entrati nous révéla sa véritable identité – lorsqu'il nous salua – et la mission qu'il nous avait confiée.",shape=box,color=blue];
		626 -> 627;
	627 [label="Il nous avait choisis tous les deux pour une mission des plus \"sacrées\".",shape=box,color=blue];
		627 -> 628;
		627 -> 629;
	628 [label="Pourquoi les guillemets?",shape=box,color=red];
		628 -> 630;
	629 [label="On dirait que tu ne le crois pas.",shape=box,color=red];
		629 -> 630;
	630 [label="J'ai appris beaucoup de choses qui me font remettre en question l'adhésion d'Entrati à quoi que ce soit de sacré, à la nature ou à quelque dieu que ce soit... si tant est que cela existe...",shape=box,color=blue];
		630 -> 631;
		630 -> 632;
	631 [label="Si une telle chose existe? Lyon, que veux-tu dire?",shape=box,color=red];
		631 -> 633;
	632 [label="Continue.",shape=box,color=red];
		632 -> 634;
	633 [label="Update boolean LyonFaith2",color=orange];
		633 -> 635;
	634 [label="Marie a accepté le sérum sans hésiter. Évidemment. Comment aurait-elle pu faire autrement? Et comment aurais-je pu ne pas la suivre? Comment aurais-je pu ne pas chercher la vérité, où qu'elle me mène?",shape=box,color=blue];
		634 -> 636;
	635 [label="Une question à aborder une autre fois, s'il te plaît.",shape=box,color=blue];
		635 -> 634;
	636 [label="Update boolean LyonSerum1",color=orange];
		636 -> 637;
		636 -> 638;
		636 -> 639;
	637 [label="Je pense qu'elle vénère encore un peu trop Entrati.",shape=box,color=red];
		637 -> 640;
	638 [label="Il s'est passé quoi ensuite?",shape=box,color=red];
		638 -> 641;
	639 [label="Tu regrettes?",shape=box,color=red];
		639 -> 642;
	640 [label="Update boolean LyonMarieEntrati",color=orange];
		640 -> 643;
	641 [label="Roathe s'est réveillé. Au début, il avait du mal à se souvenir de son nom. Entrati adressa une dernière phrase au bougre: \"Uriel, hérétique de Xata, en exil, réponds: les Orokin peuvent-ils jamais être pardonnés?\"",shape=box,color=blue];
		641 -> 644;
	642 [label="Je regrette tout, Voyageur. Oui, bien sûr. Mais est-ce que je le referais? Oui, certainement. Je ne peux pas laisser Marie seule.",shape=box,color=blue];
		642 -> 645;
	643 [label="Sur ce point, nous sommes d'accord. Mais je ne peux pas la blâmer pour autant. Laisse-lui du temps. Elle finira par comprendre. Elle est d'une intelligence remarquable, Voyageur. Ne la prends pas pour une idiote.",shape=box,color=blue];
		643 -> 645;
	644 [label="Entrati partit alors pour la dernière fois. Et il laissa Roathe, désormais transformé en ce que tu vois aujourd'hui – avec nous, mieux à même de gérer ce diable capricieux.",shape=box,color=blue];
		644 -> 646;
	645 [label="Pour terminer l'histoire... Entrati partit alors pour la dernière fois. Et il laissa Roathe, désormais transformé en ce que tu vois aujourd'hui – avec nous, mieux à même de gérer ce diable capricieux.",shape=box,color=blue];
		645 -> 646;
	646 [label="Le reste, je le crains, devra attendre. M. Loid a besoin du POM-2 et je suis impatient de le lui rendre. J'espère que cela répond à certaines de tes questions.",shape=box,color=blue];
		646 -> 647;
		646 -> 648;
	647 [label="Oui, mais j'ai deux fois plus de nouvelles questions.",shape=box,color=red];
		647 -> 649;
	648 [label="Oui, merci.",shape=box,color=red];
		648 -> 650;
	649 [label="+15 Chemistry",color=orange];
		649 -> 651;
	650 [label="+10 Chemistry",color=orange];
		650 -> 652;
	651 [label="J'ai donc accompli mon devoir de prêtre. Je te souhaite une bonne nuit.",shape=box,color=blue];
		651 -> 653;
	652 [label="Alors, je te souhaite une bonne nuit.",shape=box,color=blue];
		652 -> 653;
	653 [label="Père Lyon Allard",shape=box,color=blue];
		653 -> 654;
	654 [label="Chat ends.",color=orange];
}