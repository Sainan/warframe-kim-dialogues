	1453 [label="Update boolean LyonWillDate",color=orange];
		1453 -> 1457;
	1454 [label="C’est précisément ce que je lui avais demandé à l’époque. Il m’a expliqué les concepts \"d’intrication quantique\", de \"superposition\" et \"d’éternalisme\".",shape=box,color=blue];
		1454 -> 1458;
	1455 [label="Il est venu avec la preuve de ses impossibilités. Je savais qu'il était Albrecht Entrati et non le Cardinal Dimanche. Mais affirmer que tout ce que j'étais – tout ce en quoi je croyais – était l'œuvre de l'Indifférence?",shape=box,color=blue];
		1455 -> 1459;
	1456 [label="Au début, je ne savais plus quoi croire. Il venait avec la preuve de ses impossibilités. Je savais qu'il était Albrecht Entrati et non le Cardinal Dimanche. Mais affirmer que tout ce que j'étais – tout ce en quoi je croyais – était l'œuvre de l'Indifférence?",shape=box,color=blue];
		1456 -> 1459;
	1457 [label="Update boolean LyonDating",color=orange];
		1457 -> 1460;
	1458 [label="Et même si tout cela me paraissait logique d'un point de vue superficiel et scientifique, je ne le comprenais pas vraiment.",shape=box,color=blue];
		1458 -> 1461;
		1458 -> 1462;
	1459 [label="Que j'avais prié un faux dieu pendant toutes ces années?",shape=box,color=blue];
