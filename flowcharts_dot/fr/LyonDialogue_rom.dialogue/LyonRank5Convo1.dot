		1396 -> 1400 [label=true,color=green];
		1396 -> 1401 [label=false,color=brown];
	1395 [label="Merci... mais je me demande combien de temps cela durera avant que le chagrin ne devienne simplement un fardeau de plus, plus facile à supporter avec le temps?",shape=box,color=blue];
		1395 -> 1390;
	1397 [label="Evaluate expressions",color=orange];
