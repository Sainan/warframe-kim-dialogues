		1312 -> 1313 [label="false",color=purple];
	1315 [label="Tu as mentionné plus tôt que tu voulais parler du fait que je ne crois pas vraiment que l'Indifférence soit un \"vrai dieu\". Est-ce le bon moment?",shape=box,color=red];
		1315 -> 1320;
	1313 [label="[Fin.]",shape=box,color=red];
		1313 -> 1318;
	1314 [label="L'autre jour, tu me posais des questions sur l'incarnation conceptuelle et sur l'Indifférence. Quelque chose te tracasse?",shape=box,color=red];
		1314 -> 1319;
	1317 [label="Roathe est convaincu que l'Homme dans le Mur n'est pas un dieu réel, mais le produit d'une \"incarnation conceptuelle\". Qu'en penses-tu?",shape=box,color=red];
		1317 -> 1322;
	1316 [label="Lyon, que se passe-t-il entre Roathe et toi? Je n'ai glané que des bribes.",shape=box,color=red];
		1316 -> 1321;
	1320 [label="Je ne sais pas s'il existe un \"bon\" moment pour discuter du problème concret que cela m'a causé, Voyageur.",shape=box,color=blue];
		1320 -> 1324;
	1318 [label="Chat ends.",color=orange];
	1319 [label="Il y a beaucoup de choses qui me tracassent, Voyageur. Le sujet de l'Indifférence et de l'incarnation conceptuelle, je le crains, n'en est qu'un parmi tant d'autres.",shape=box,color=blue];
		1319 -> 1323;
	1322 [label="Le problème, Voyageur, c'est que je ne sais pas. Si je connaissais la réponse, je ne me tourmenterais pas ainsi avec un tel débat intérieur.",shape=box,color=blue];
		1322 -> 1326;
	1321 [label="Je vais résumer, même si je suis surpris que tu aies pu éviter ses diatribes sur le sujet. Il est vraiment trop prompt à les partager à la moindre occasion.",shape=box,color=blue];
		1321 -> 1325;
	1324 [label="Mais de ce fait, le moment présent est aussi opportun que n'importe quel autre. J'ai été intrigué par ton apparente conviction, partagée par Roathe, que l'Indifférence n'était pas un véritable dieu.",shape=box,color=blue];
		1324 -> 1326;
	1323 [label="Voire deux, selon l'interprétation que l'on fait de la situation. C'est là, je suppose, le cœur de mon dilemme.",shape=box,color=blue];
		1323 -> 1326;
	1326 [label="Cependant, je devrais... commencer par le début. Tu ne comprendras pas précisément pourquoi ce sujet est si important pour moi si tu n’as pas un minimum de contexte...",shape=box,color=blue];
		1326 -> 1328;
	1325 [label="Il estime que l'Indifférence n'est pas un dieu du Néant, au sens propre du terme, et qu'elle a en réalité été créée par Entrati et tous ceux qui ont interagi avec elle par la suite.",shape=box,color=blue];
		1325 -> 1327;
	1328 [label="Je suis un Frère de Lua. J'ai consacré ma vie à son culte. J'ai toujours cru en cela.",shape=box,color=blue];
		1328 -> 1330;
	1327 [label="— créée à partir du Néant via ce que tu appelles \"incarnation conceptuelle\". ",shape=box,color=blue];
		1327 -> 1329;
	1330 [label="Et durant toutes ces années depuis mon arrivée à l'église, je suis resté fidèle à ma foi, à cette certitude que mes souffrances, mes douleurs et mes visions...",shape=box,color=blue];
		1330 -> 1331;
	1329 [label="De la même manière que tu as créé Duviri, je crois.",shape=box,color=blue];
		1329 -> 1326;
	1331 [label="- ont été à son service. Ont existé en son nom. Et œuvré à son dessein.",shape=box,color=blue];
		1331 -> 1332;
	1332 [label="C’était le cas... jusqu’à ce que le \"Cardinal Dimanche\" se révèle être Albrecht Entrati.",shape=box,color=blue];
		1332 -> 1333;
	1333 [label="Et il nous a révélé la vérité sur qui il était, le récit de ses méfaits avec le Néant et toutes les conséquences qui en ont découlé. Plus précisément... tout ce qui en a découlé.",shape=box,color=blue];
		1333 -> 1334;
		1333 -> 1335;
	1334 [label="L'Indifférence.",shape=box,color=red];
		1334 -> 1336;
	1335 [label="Et?",shape=box,color=red];
		1335 -> 1337;
	1336 [label="Exact. Il nous a parlé de l'affreuse chose qui l'a accueilli, des doigts qu'il a récupérés dans cet endroit qui ressemblait à son laboratoire.",shape=box,color=blue];
		1336 -> 1338;
	1337 [label="Il nous a raconté sa descente dans la cloche de sériglas vers le vide. Vers ce lieu qui ressemblait à son laboratoire. ",shape=box,color=blue];
		1337 -> 1338;
	1338 [label="De plus, il nous a fait part de la grande terreur qu'il ressentait, sachant qu'il avait libéré une chose qui pouvait le suivre non seulement dans l'espace, mais aussi dans le temps.",shape=box,color=blue];
		1338 -> 1339;
	1339 [label="Un dieu de néant. Une chose qu'il fallait contenir. Une créature dont il possédait des morceaux, qui griffait les murs pour se libérer.",shape=box,color=blue];
		1339 -> 1340;
	1340 [label="Un dieu terrible et dévorant qui était, sans l'être, déjà libre.",shape=box,color=blue];
		1340 -> 1341;
		1340 -> 1342;
	1341 [label="Que veux-tu dire?",shape=box,color=red];
		1341 -> 1343;
	1342 [label="\"Était\" et \"sans être\" déjà libre?",shape=box,color=red];
		1342 -> 1343;
	1343 [label="Check boolean LyonRell1",color=orange];
		1343 -> 1345 [label=true,color=green];
		1343 -> 1344 [label=false,color=brown];
	1345 [label="Le temps est... complexe, pour quelqu’un comme moi, dans l’état où je me trouve actuellement. C’est difficile à décrire. J’ai déjà tenté, maladroitement, de l’expliquer et j’ai lamentablement échoué.",shape=box,color=blue];
		1345 -> 1346;
	1344 [label="Le temps est... complexe, pour quelqu’un comme moi, dans l’état où je me trouve actuellement. C’est difficile à décrire et je m’y prends très mal.",shape=box,color=blue];
		1344 -> 1346;
	1346 [label="Je préférerais expliquer les détails une autre fois, car ce n'est pas le point essentiel que j'essaie de souligner aujourd'hui.",shape=box,color=blue];
		1346 -> 1347;
	1347 [label="Check boolean LyonRell1",color=orange];
		1347 -> 1348 [label=true,color=green];
		1347 -> 1349 [label=true,color=green];
		1347 -> 1350 [label=true,color=green];
		1347 -> 1349 [label=false,color=brown];
		1347 -> 1350 [label=false,color=brown];
	1348 [label="Mais si tu entends – ou as entendu – Rell... je veux en parler.",shape=box,color=red];
		1348 -> 1351;
	1349 [label="D'accord. À toi de décider.",shape=box,color=red];
		1349 -> 1352;
	1350 [label="J'aimerais vraiment aborder ce sujet...",shape=box,color=red];
		1350 -> 1353;
	1351 [label="Je sais. Et j'ai lamentablement évité le sujet. Son seul nom,",shape=box,color=blue];
		1351 -> 1354;
	1352 [label="Je sais que j'ai lamentablement évité le sujet et je m'en excuse. Mais il risque de me plonger dans une vision dont je ne suis pas sûr de pouvoir me remettre facilement.",shape=box,color=blue];
		1352 -> 1355;
	1353 [label="Je te l'assure, nous le ferons. Je sais que j'ai lamentablement évité le sujet et je m'en excuse. Mais il risque de me plonger dans une vision dont je ne suis pas sûr de pouvoir me remettre facilement.",shape=box,color=blue];
		1353 -> 1355;
	1354 [label="il menace de",shape=box,color=blue];
		1354 -> 1356;
	1355 [label="Je ne souhaite pas avoir à interrompre une fois de plus cette conversation parce que je suis incapable de continuer en raison de mes propres infirmités.",shape=box,color=blue];
		1355 -> 1357;
		1355 -> 1358;
		1355 -> 1359;
	1356 [label="il évoque l'image d'un homme enchaîné",shape=box,color=blue];
		1356 -> 1360;
	1357 [label="Je ne pense pas que je qualifierais \"d'infirme\" quiconque a dû endurer ce que tu as enduré, Lyon.",shape=box,color=red];
		1357 -> 1361;
	1358 [label="\"Infirme\" est une façon terrible de dire \"affligé de visions qu'il n'a pas demandées\". Mais fais comme tu veux.",shape=box,color=red];
		1358 -> 1361;
	1359 [label="Tu connais tes limites, alors je te suis.",shape=box,color=red];
		1359 -> 1362;
	1360 [label="ensanglanté",shape=box,color=blue];
		1360 -> 1363;
	1361 [label="J'apprécie l'intention. Mais je sais que, même dans un bon jour, je ne suis qu'un vitrail brisé. Je reste là, à me demander où sont passés la plupart des morceaux.",shape=box,color=blue];
		1361 -> 1364;
	1362 [label="Merci. Ta patience m'émerveille. Je sais que, même dans un bon jour, je ne suis qu'un vitrail brisé. Je reste là, à me demander où sont passés tous ces morceaux.",shape=box,color=blue];
		1362 -> 1364;
	1363 [label="meurtri dans les tendons et la chair",shape=box,color=blue];
		1363 -> 1365;
	1364 [label="Chaque fois que j'en retrouve un que j'avais perdu, je risque plus de me couper que de me faire du bien en le remettant en place.",shape=box,color=blue];
		1364 -> 1366;
	1365 [label="fais cesser cela",shape=box,color=blue];
		1365 -> 1367;
	1366 [label="Parfois, je me demande s'il ne vaudrait pas mieux devenir l'un de ces Harrows aux yeux véritablement vides que je vois dans mon imagination, s'étendant aussi loin que mes cauchemars me le permettent.",shape=box,color=blue];
		1366 -> 1368;
	1367 [label="leurs visages
des milliers innombrables
vides et brisés
figés dans le silence
à jamais dans une prière brisée
ce que je deviendrai",shape=box,color=blue];
		1367 -> 1369;
		1367 -> 1370;
	1368 [label="Evaluate expressions",color=orange];
		1368 -> 1372 [label="MarieDating",color=purple];
		1368 -> 1371 [label="MarieDating",color=purple];
