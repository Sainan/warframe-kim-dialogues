	j2802095464 [label="C’est précisément ce que je lui avais demandé à l’époque. Il m’a expliqué les concepts \"d’intrication quantique\", de \"superposition\" et \"d’éternalisme\".",shape=box,color=blue];
		j2802095464 -> j392236397;
	j3524987788 [label="Il est venu avec la preuve de ses impossibilités. Je savais qu'il était Albrecht Entrati et non le Cardinal Dimanche. Mais affirmer que tout ce que j'étais – tout ce en quoi je croyais – était l'œuvre de l'Indifférence?",shape=box,color=blue];
		j3524987788 -> j1613098759;
	j185408041 [label="Au début, je ne savais plus quoi croire. Il venait avec la preuve de ses impossibilités. Je savais qu'il était Albrecht Entrati et non le Cardinal Dimanche. Mais affirmer que tout ce que j'étais – tout ce en quoi je croyais – était l'œuvre de l'Indifférence?",shape=box,color=blue];
		j185408041 -> j1613098759;
	j3518121159 [label="J'ai bien peur que mon esprit soit assez complexe pour vous imaginer vous deux, toi et cet homme que je connais si bien. Peut-être suis-je démodé sur ce point. Je suis une vieille antiquité, semble-t-il. Je te prie de m'en excuser.",shape=box,color=blue];
		j3518121159 -> j2455004409;
	j2628571456 [label="Peut-être suis-je vieux jeu sur ce point. Elle est comme une membre de ma famille et nous sommes trop proches. Je suis un peu un vestige du passé, semble-t-il. Pour cela, tu dois me pardonner.",shape=box,color=blue];
		j2628571456 -> j4156019968;
