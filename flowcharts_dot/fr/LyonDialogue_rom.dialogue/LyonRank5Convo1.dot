		1397 -> 1404 [label="false",color=purple];
	1398 [label="Chat ends.",color=orange];
	1399 [label="Je te prie de m'excuser. Il m'arrive de perdre la raison et je déteste que d'autres en soient témoins.",shape=box,color=blue];
		1399 -> 1405;
	1400 [label="Il serait si facile de capituler. D'abandonner. De déposer mon agonie sur l'autel de la souffrance et de ne plus rien dire.",shape=box,color=blue];
		1400 -> 1406;
	1401 [label="Il serait si facile de capituler. D'abandonner. De déposer mon agonie sur l'autel de la souffrance et de ne plus rien dire. Ou de faire bien pire: faire ce que beaucoup craignent que je ne commette, avec une lame dans l'obscurité de la nuit.",shape=box,color=blue];
		1401 -> 1406;
	1403 [label="Il y a... juste un problème, Voyageur. Comment pourrais-je te croire sur parole alors que je sais que tu as déjà proféré des mensonges?",shape=box,color=blue];
		1403 -> 1408;
	1402 [label="Bien que flatté, je crains que ma réponse ne soit tout simplement et sans équivoque non.",shape=box,color=blue];
		1402 -> 1407;
	1404 [label="Je suis sans voix.",shape=box,color=blue];
		1404 -> 1409;
	1405 [label="Evaluate expressions",color=orange];
		1405 -> 1410 [label="MarieDating",color=purple];
		1405 -> 1412 [label="MarieDating",color=purple];
		1405 -> 1410 [label="RoatheDating",color=purple];
		1405 -> 1412 [label="RoatheDating",color=purple];
		1405 -> 1410 [label="false",color=purple];
		1405 -> 1411 [label="false",color=purple];
		1405 -> 1412 [label="false",color=purple];
	1406 [label="Mais... ce n'est pas ce que je suis. Et je ne serai jamais ainsi. Je resterai ce rempart brisé, ce bouclier en ruine...",shape=box,color=blue];
		1406 -> 1413;
	1408 [label="Tu as déjà été en flagrant délit de mensonge. Bien que j'ignore le but de celui-ci, je crains que tu n'aies déjà brisé ma confiance en toi.",shape=box,color=blue];
		1408 -> 1414;
	1407 [label="Chat ends.",color=orange];
	1409 [label="Ce qui, je le sais, n'est pas tout à fait inhabituel de ma part; cependant, j'ai le sentiment que je devrais répondre à cela d'une certaine manière.",shape=box,color=blue];
		1409 -> 1415;
	1410 [label="Veux-tu qu'on s'arrête ici? Ou peux-tu continuer? Je comprendrai dans un cas comme dans l'autre.",shape=box,color=red];
		1410 -> 1416;
	1412 [label="Tout va bien. Je suis là pour toi. Ça va aller?",shape=box,color=red];
		1412 -> 1418;
	1411 [label="[Avouer ses sentiments.] Lyon, je... je tiens à toi. Je veux être là pour toi dans ces moments-là, si tu me le permets.",shape=box,color=red];
		1411 -> 1417;
	1413 [label="Toujours à saigner, sans jamais mourir...",shape=box,color=blue];
		1413 -> 1419;
	1414 [label="Aussi, bien que je sois profondément flatté, je crains que ma réponse ne soit tout simplement et sans équivoque:",shape=box,color=blue];
		1414 -> 1420;
	1415 [label="d'une manière astucieuse ou du moins d'une manière qui semblerait appropriée à la situation et ne pas -",shape=box,color=blue];
		1415 -> 1421;
	1416 [label="Je peux continuer, merci. C'est passé, comme toujours. Ces... visions sont comme des nuages qui passent au-dessus de Lua. Elles peuvent être totalement obscures, mais elles sont souvent brèves.",shape=box,color=blue];
		1416 -> 1422;
	1418 [label="Oui, merci. C'est passé, comme toujours. Ces... visions sont comme des nuages qui passent au-dessus de Lua. Elles peuvent être totalement obscures, mais elles sont souvent brèves.",shape=box,color=blue];
		1418 -> 1422;
	1417 [label="Tu plaisantes, n'est-ce pas? Tu ne peux pas penser ce que tu dis après ce dont tu as été témoin? Soit tu as perdu la raison, soit ta compassion a pris le dessus sur ton bon sens.",shape=box,color=blue];
		1417 -> 1423;
		1417 -> 1424;
	1419 [label="C'est la vie, hein?",shape=box,color=blue];
		1419 -> 1425;
	1420 [label="Non.",shape=box,color=blue];
		1420 -> 1426;
	1421 [label="- et ne pas te donner l'impression que ce n'est pas réciproque, car ce n'est absolument pas le cas -",shape=box,color=blue];
		1421 -> 1427;
		1421 -> 1428;
	1422 [label="+10 Chemistry",color=orange];
		1422 -> 1429;
	1423 [label="Non, Lyon. Je le pense vraiment. Tu comptes énormément pour moi et tout ce que je souhaite, c'est pouvoir te le faire réaliser.",shape=box,color=red];
		1423 -> 1391;
	1424 [label="Je... peut-être que tu as raison. Ce n'est peut-être pas le bon moment.",shape=box,color=red];
		1424 -> 1430;
	1425 [label="Nous nous sommes bien éloignés du sujet de cette conversation, n'est-ce pas? Je suis vraiment désolé. Tu n'as pas besoin de supporter de tels discours pompeux et pleurnichards.",shape=box,color=blue];
		1425 -> 1431;
		1425 -> 1432;
	1426 [label="Chat ends.",color=orange];
