		1368 -> 1373 [label="false",color=purple];
	1369 [label="Respire, Lyon. Respire. Ils ne sont pas vraiment là.",shape=box,color=red];
		1369 -> 1374;
	1370 [label="Je... je regrette, Lyon. Concentre-toi sur l'écran. Je suis là.",shape=box,color=red];
		1370 -> 1375;
	1372 [label="Je sais que c'est un fardeau terrible qu'on te demande de porter. Et peut-être que ce n'est pas juste. Mais je ne vois pas d'issue.",shape=box,color=red];
		1372 -> 1377;
	1371 [label="Tu représentes tout pour Marie. Tu es devenu un ami très cher à mes yeux. Je pense que même Roathe te regretterait, même s'il ne l'avouera jamais.",shape=box,color=red];
		1371 -> 1376;
	1373 [label="[Avouer ses sentiments.] Ça me briserait le cœur si tu laissais ça t'arriver, Lyon. Je... je tiens à toi.",shape=box,color=red];
		1373 -> 1378;
	1374 [label="c'est là que tu te trompes
ils sont là
et ils ne me quitteront jamais
plus jamais
entrati s'en est assuré
pardonne-moi",shape=box,color=blue];
		1374 -> 1379;
	1375 [label="déchirant ma chair
la détachant de mes os
pourquoi? dans quel but?
la faim de qui cela apaise-t-il?",shape=box,color=blue];
		1375 -> 1380;
		1375 -> 1381;
	1377 [label="Non sans recourir à... l’impensable. Ou à cela.",shape=box,color=red];
		1377 -> 1383;
	1376 [label="Tu es apprécié. Tu es aimé. Tu as une famille et des amis. Même si tu n'en as pas toujours l'impression.",shape=box,color=red];
		1376 -> 1382;
	1378 [label="Je... Tu plaisantes, j’espère. Tu ne peux pas penser ce que tu dis après ce dont tu as été témoin? Soit tu as perdu la raison, soit ta compassion a pris le dessus sur ton bon sens.",shape=box,color=blue];
		1378 -> 1384;
		1378 -> 1385;
	1379 [label="+10 Chemistry",color=orange];
		1379 -> 1386;
	1380 [label="Il n'y a personne. Tu n'as plus besoin de souffrir ainsi. Laisse aller.",shape=box,color=red];
		1380 -> 1387;
	1381 [label="Je sais. Je sais que ça fait mal. Je compatis. Vraiment. Sors de la pièce.",shape=box,color=red];
		1381 -> 1388;
	1383 [label="+10 Chemistry",color=orange];
		1383 -> 1390;
	1382 [label="Tu n'es pas seul, Lyon. Et tu nous manquerais.",shape=box,color=red];
		1382 -> 1389;
	1384 [label="Non, Lyon. Je le pense vraiment. Tu comptes énormément pour moi et tout ce que je souhaite, c'est pouvoir te le faire réaliser.",shape=box,color=red];
		1384 -> 1391;
	1385 [label="Je... peut-être que tu as raison. Ce n'est peut-être pas le bon moment.",shape=box,color=red];
		1385 -> 1392;
	1386 [label="Update boolean LyonRell2b",color=orange];
		1386 -> 1393;
	1387 [label="si seulement c'était aussi simple
