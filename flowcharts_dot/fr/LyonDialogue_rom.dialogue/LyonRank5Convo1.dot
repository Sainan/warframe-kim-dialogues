		1427 -> 1433;
	1428 [label="Lyon?",shape=box,color=red];
		1428 -> 1434;
	1429 [label="Par Lua... où en étais-je?",shape=box,color=blue];
		1429 -> 1435;
	1430 [label="Bien. Je suis ravi que tu aies repris tes esprits. C'est sans doute contagieux. Peut-être devrions-nous faire une pause avec cet appareil, car je crains qu'il n'ait commencé à te ramollir le cerveau.",shape=box,color=blue];
		1430 -> 1436;
	1431 [label="Tu as tout à fait raison de te défouler de temps en temps. Je me réjouis que tu te sentes à l'aise de me parler.",shape=box,color=red];
		1431 -> 1437;
	1432 [label="Il n'y a rien là de pleurnichard. Pour l'autre truc, je vais devoir vérifier.",shape=box,color=red];
		1432 -> 1438;
	1433 [label="S'il te plaît.",shape=box,color=blue];
		1433 -> 1439;
		1433 -> 1440;
	1434 [label="Oui?",shape=box,color=blue];
		1434 -> 1439;
		1434 -> 1440;
	1435 [label="Tu parlais de l'Indifférence et d'Entrati. Et de la façon dont le temps est devenu moins... linéaire pour toi, maintenant.",shape=box,color=red];
		1435 -> 1441;
	1436 [label="Chat ends.",color=orange];
	1437 [label="Merci. J'essaie, autant que possible, de ne pas faire peser mes soucis sur les autres. Mais j'ai apprécié cette opportunité.",shape=box,color=blue];
		1437 -> 1429;
	1438 [label="+5 Chemistry",color=orange];
