plus longtemps que le langage
plus longtemps que mon propre nom
pardonne-moi",shape=box,color=blue];
		1387 -> 1379;
	1388 [label="Fais demi-tour et sors mentalement de cette pièce.",shape=box,color=red];
		1388 -> 1394;
	1390 [label="Je vois M. Necraloid et j'entends parler de M. Ordis, ou de M. Otak. Je pense aux Warframes vides, leurs pensées arrachées de leur crâne.",shape=box,color=blue];
		1390 -> 1396;
	1389 [label="+10 Chemistry",color=orange];
		1389 -> 1395;
	1391 [label="Je.",shape=box,color=blue];
		1391 -> 1397;
