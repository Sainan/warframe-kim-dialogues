		1439 -> 1443;
	1440 [label="Aimerais-tu sortir avec moi? Je ne sais pas trop comment on appelait ça à ton époque. Faire la cour, j'imagine.",shape=box,color=red];
		1440 -> 1444;
	1441 [label="Tout à fait. Oui. Et pour éviter que la discussion ne devienne circulaire, nous allons passer à la suite, s'il te plaît.",shape=box,color=blue];
