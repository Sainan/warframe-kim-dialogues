	1466 [label="Tu vois le problème auquel je fais face.",shape=box,color=blue];
		1466 -> 1465;
	1467 [label="La situation a empiré considérablement avec l'arrivée de Roathe. Ma crise de foi s'est complexifiée davantage encore lorsque j'ai appris que l'Indifférence n'est pas un dieu du tout,",shape=box,color=blue];
		1467 -> 1470;
