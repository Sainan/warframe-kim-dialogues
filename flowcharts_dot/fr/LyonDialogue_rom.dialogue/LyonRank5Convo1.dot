	"LyonRank5Convo1 begins." [color=orange];
		"LyonRank5Convo1 begins." -> j3626627435;
	j3626627435 [label="Evaluate expressions",color=orange];
		j3626627435 -> j3066066359 [label="LyonMITW2",color=purple];
		j3626627435 -> j2429168889 [label="LyonMITW2",color=purple];
		j3626627435 -> j2150631791 [label="LyonMITW1",color=purple];
		j3626627435 -> j2429168889 [label="LyonMITW1",color=purple];
		j3626627435 -> j20237311 [label="RoatheMITW3",color=purple];
		j3626627435 -> j2429168889 [label="RoatheMITW3",color=purple];
		j3626627435 -> j20237311 [label="RoatheMITW2",color=purple];
		j3626627435 -> j2429168889 [label="RoatheMITW2",color=purple];
		j3626627435 -> j20237311 [label="RoatheMITW1",color=purple];
		j3626627435 -> j2429168889 [label="RoatheMITW1",color=purple];
		j3626627435 -> j1294152113 [label="false",color=purple];
		j3626627435 -> j2429168889 [label="false",color=purple];
	j3066066359 [label="Tu as mentionné plus tôt que tu voulais parler du fait que je ne crois pas vraiment que l'Indifférence soit un \"vrai dieu\". Est-ce le bon moment?",shape=box,color=red];
		j3066066359 -> j3368345186;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j2150631791 [label="L'autre jour, tu me posais des questions sur l'incarnation conceptuelle et sur l'Indifférence. Quelque chose te tracasse?",shape=box,color=red];
		j2150631791 -> j2205947773;
	j20237311 [label="Roathe est convaincu que l'Homme dans le Mur n'est pas un dieu réel, mais le produit d'une \"incarnation conceptuelle\". Qu'en penses-tu?",shape=box,color=red];
		j20237311 -> j4175573092;
	j1294152113 [label="Lyon, que se passe-t-il entre Roathe et toi? Je n'ai glané que des bribes.",shape=box,color=red];
		j1294152113 -> j4040448396;
	j3368345186 [label="Je ne sais pas s'il existe un \"bon\" moment pour discuter du problème concret que cela m'a causé, Voyageur.",shape=box,color=blue];
		j3368345186 -> j3273837759;
	"Chat ends." [color=orange];
	j2205947773 [label="Il y a beaucoup de choses qui me tracassent, Voyageur. Le sujet de l'Indifférence et de l'incarnation conceptuelle, je le crains, n'en est qu'un parmi tant d'autres.",shape=box,color=blue];
		j2205947773 -> j3305003667;
	j4175573092 [label="Le problème, Voyageur, c'est que je ne sais pas. Si je connaissais la réponse, je ne me tourmenterais pas ainsi avec un tel débat intérieur.",shape=box,color=blue];
		j4175573092 -> j3628205532;
	j4040448396 [label="Je vais résumer, même si je suis surpris que tu aies pu éviter ses diatribes sur le sujet. Il est vraiment trop prompt à les partager à la moindre occasion.",shape=box,color=blue];
		j4040448396 -> j2186391401;
	j3273837759 [label="Mais de ce fait, le moment présent est aussi opportun que n'importe quel autre. J'ai été intrigué par ton apparente conviction, partagée par Roathe, que l'Indifférence n'était pas un véritable dieu.",shape=box,color=blue];
		j3273837759 -> j3628205532;
	j3305003667 [label="Voire deux, selon l'interprétation que l'on fait de la situation. C'est là, je suppose, le cœur de mon dilemme.",shape=box,color=blue];
		j3305003667 -> j3628205532;
	j3628205532 [label="Cependant, je devrais... commencer par le début. Tu ne comprendras pas précisément pourquoi ce sujet est si important pour moi si tu n’as pas un minimum de contexte...",shape=box,color=blue];
		j3628205532 -> j2656350475;
	j2186391401 [label="Il estime que l'Indifférence n'est pas un dieu du Néant, au sens propre du terme, et qu'elle a en réalité été créée par Entrati et tous ceux qui ont interagi avec elle par la suite.",shape=box,color=blue];
		j2186391401 -> j3539897836;
	j2656350475 [label="Je suis un Frère de Lua. J'ai consacré ma vie à son culte. J'ai toujours cru en cela.",shape=box,color=blue];
		j2656350475 -> j3339990001;
	j3539897836 [label="— créée à partir du Néant via ce que tu appelles \"incarnation conceptuelle\". ",shape=box,color=blue];
		j3539897836 -> j3349073259;
	j3339990001 [label="Et durant toutes ces années depuis mon arrivée à l'église, je suis resté fidèle à ma foi, à cette certitude que mes souffrances, mes douleurs et mes visions...",shape=box,color=blue];
		j3339990001 -> j1395943315;
	j3349073259 [label="De la même manière que tu as créé Duviri, je crois.",shape=box,color=blue];
		j3349073259 -> j3628205532;
	j1395943315 [label="- ont été à son service. Ont existé en son nom. Et œuvré à son dessein.",shape=box,color=blue];
		j1395943315 -> j33662347;
	j33662347 [label="C’était le cas... jusqu’à ce que le \"Cardinal Dimanche\" se révèle être Albrecht Entrati.",shape=box,color=blue];
		j33662347 -> j10285754;
	j10285754 [label="Et il nous a révélé la vérité sur qui il était, le récit de ses méfaits avec le Néant et toutes les conséquences qui en ont découlé. Plus précisément... tout ce qui en a découlé.",shape=box,color=blue];
		j10285754 -> j1396007039;
		j10285754 -> j1972068721;
	j1396007039 [label="L'Indifférence.",shape=box,color=red];
		j1396007039 -> j334899373;
	j1972068721 [label="Et?",shape=box,color=red];
		j1972068721 -> j2705251487;
	j334899373 [label="Exact. Il nous a parlé de l'affreuse chose qui l'a accueilli, des doigts qu'il a récupérés dans cet endroit qui ressemblait à son laboratoire.",shape=box,color=blue];
		j334899373 -> j2286511485;
	j2705251487 [label="Il nous a raconté sa descente dans la cloche de sériglas vers le vide. Vers ce lieu qui ressemblait à son laboratoire. ",shape=box,color=blue];
		j2705251487 -> j2286511485;
	j2286511485 [label="De plus, il nous a fait part de la grande terreur qu'il ressentait, sachant qu'il avait libéré une chose qui pouvait le suivre non seulement dans l'espace, mais aussi dans le temps.",shape=box,color=blue];
		j2286511485 -> j1296999258;
	j1296999258 [label="Un dieu de néant. Une chose qu'il fallait contenir. Une créature dont il possédait des morceaux, qui griffait les murs pour se libérer.",shape=box,color=blue];
		j1296999258 -> j31927973;
	j31927973 [label="Un dieu terrible et dévorant qui était, sans l'être, déjà libre.",shape=box,color=blue];
		j31927973 -> j173426333;
		j31927973 -> j1361476232;
	j173426333 [label="Que veux-tu dire?",shape=box,color=red];
		j173426333 -> j3826452011;
	j1361476232 [label="\"Était\" et \"sans être\" déjà libre?",shape=box,color=red];
		j1361476232 -> j3826452011;
	j3826452011 [label="Check boolean LyonRell1",color=orange];
		j3826452011 -> j3473794575 [label=true,color=green];
		j3826452011 -> j1042768107 [label=false,color=brown];
	j3473794575 [label="Le temps est... complexe, pour quelqu’un comme moi, dans l’état où je me trouve actuellement. C’est difficile à décrire. J’ai déjà tenté, maladroitement, de l’expliquer et j’ai lamentablement échoué.",shape=box,color=blue];
		j3473794575 -> j2185822527;
	j1042768107 [label="Le temps est... complexe, pour quelqu’un comme moi, dans l’état où je me trouve actuellement. C’est difficile à décrire et je m’y prends très mal.",shape=box,color=blue];
		j1042768107 -> j2185822527;
	j2185822527 [label="Je préférerais expliquer les détails une autre fois, car ce n'est pas le point essentiel que j'essaie de souligner aujourd'hui.",shape=box,color=blue];
		j2185822527 -> j366078008;
	j366078008 [label="Check boolean LyonRell1",color=orange];
		j366078008 -> j436692220 [label=true,color=green];
		j366078008 -> j2786826759 [label=true,color=green];
		j366078008 -> j2172478560 [label=true,color=green];
		j366078008 -> j2786826759 [label=false,color=brown];
		j366078008 -> j2172478560 [label=false,color=brown];
	j436692220 [label="Mais si tu entends – ou as entendu – Rell... je veux en parler.",shape=box,color=red];
		j436692220 -> j2004566145;
	j2786826759 [label="D'accord. À toi de décider.",shape=box,color=red];
		j2786826759 -> j825293322;
	j2172478560 [label="J'aimerais vraiment aborder ce sujet...",shape=box,color=red];
		j2172478560 -> j1613044912;
	j2004566145 [label="Je sais. Et j'ai lamentablement évité le sujet. Son seul nom,",shape=box,color=blue];
		j2004566145 -> j4121070632;
	j825293322 [label="Je sais que j'ai lamentablement évité le sujet et je m'en excuse. Mais il risque de me plonger dans une vision dont je ne suis pas sûr de pouvoir me remettre facilement.",shape=box,color=blue];
		j825293322 -> j1376620064;
	j1613044912 [label="Je te l'assure, nous le ferons. Je sais que j'ai lamentablement évité le sujet et je m'en excuse. Mais il risque de me plonger dans une vision dont je ne suis pas sûr de pouvoir me remettre facilement.",shape=box,color=blue];
		j1613044912 -> j1376620064;
	j4121070632 [label="il menace de",shape=box,color=blue];
		j4121070632 -> j3279005202;
	j1376620064 [label="Je ne souhaite pas avoir à interrompre une fois de plus cette conversation parce que je suis incapable de continuer en raison de mes propres infirmités.",shape=box,color=blue];
		j1376620064 -> j2488305099;
		j1376620064 -> j1732826261;
		j1376620064 -> j4027791717;
	j3279005202 [label="il évoque l'image d'un homme enchaîné",shape=box,color=blue];
		j3279005202 -> j4219652171;
	j2488305099 [label="Je ne pense pas que je qualifierais \"d'infirme\" quiconque a dû endurer ce que tu as enduré, Lyon.",shape=box,color=red];
		j2488305099 -> j3247277592;
	j1732826261 [label="\"Infirme\" est une façon terrible de dire \"affligé de visions qu'il n'a pas demandées\". Mais fais comme tu veux.",shape=box,color=red];
		j1732826261 -> j3247277592;
	j4027791717 [label="Tu connais tes limites, alors je te suis.",shape=box,color=red];
		j4027791717 -> j3976342277;
	j4219652171 [label="ensanglanté",shape=box,color=blue];
		j4219652171 -> j695505560;
	j3247277592 [label="J'apprécie l'intention. Mais je sais que, même dans un bon jour, je ne suis qu'un vitrail brisé. Je reste là, à me demander où sont passés la plupart des morceaux.",shape=box,color=blue];
		j3247277592 -> j2607812919;
	j3976342277 [label="Merci. Ta patience m'émerveille. Je sais que, même dans un bon jour, je ne suis qu'un vitrail brisé. Je reste là, à me demander où sont passés tous ces morceaux.",shape=box,color=blue];
		j3976342277 -> j2607812919;
	j695505560 [label="meurtri dans les tendons et la chair",shape=box,color=blue];
		j695505560 -> j3594768655;
	j2607812919 [label="Chaque fois que j'en retrouve un que j'avais perdu, je risque plus de me couper que de me faire du bien en le remettant en place.",shape=box,color=blue];
		j2607812919 -> j304419410;
	j3594768655 [label="fais cesser cela",shape=box,color=blue];
		j3594768655 -> j3268403318;
	j304419410 [label="Parfois, je me demande s'il ne vaudrait pas mieux devenir l'un de ces Harrows aux yeux véritablement vides que je vois dans mon imagination, s'étendant aussi loin que mes cauchemars me le permettent.",shape=box,color=blue];
		j304419410 -> j3090338735;
	j3268403318 [label="leurs visages\ndes milliers innombrables\nvides et brisés\nfigés dans le silence\nà jamais dans une prière brisée\nce que je deviendrai",shape=box,color=blue];
		j3268403318 -> j47570094;
		j3268403318 -> j1773529325;
	j3090338735 [label="Evaluate expressions",color=orange];
		j3090338735 -> j1876521078 [label="MarieDating",color=purple];
		j3090338735 -> j142465033 [label="MarieDating",color=purple];
		j3090338735 -> j142465033 [label="RoatheDating",color=purple];
		j3090338735 -> j1876521078 [label="RoatheDating",color=purple];
		j3090338735 -> j142465033 [label="false",color=purple];
		j3090338735 -> j1876521078 [label="false",color=purple];
		j3090338735 -> j3794450059 [label="false",color=purple];
	j47570094 [label="Respire, Lyon. Respire. Ils ne sont pas vraiment là.",shape=box,color=red];
		j47570094 -> j1292652207;
	j1773529325 [label="Je... je regrette, Lyon. Concentre-toi sur l'écran. Je suis là.",shape=box,color=red];
		j1773529325 -> j4233210138;
	j1876521078 [label="Je sais que c'est un fardeau terrible qu'on te demande de porter. Et peut-être que ce n'est pas juste. Mais je ne vois pas d'issue.",shape=box,color=red];
		j1876521078 -> j319870000;
	j142465033 [label="Tu représentes tout pour Marie. Tu es devenu un ami très cher à mes yeux. Je pense que même Roathe te regretterait, même s'il ne l'avouera jamais.",shape=box,color=red];
		j142465033 -> j2491225892;
	j3794450059 [label="[Avouer ses sentiments.] Ça me briserait le cœur si tu laissais ça t'arriver, Lyon. Je... je tiens à toi.",shape=box,color=red];
		j3794450059 -> j1126970819;
	j1292652207 [label="c'est là que tu te trompes\nils sont là\net ils ne me quitteront jamais\nplus jamais\nentrati s'en est assuré\npardonne-moi",shape=box,color=blue];
		j1292652207 -> j2862131335;
	j4233210138 [label="déchirant ma chair\nla détachant de mes os\npourquoi? dans quel but?\nla faim de qui cela apaise-t-il?",shape=box,color=blue];
		j4233210138 -> j3544659054;
		j4233210138 -> j2147511879;
	j319870000 [label="Non sans recourir à... l’impensable. Ou à cela.",shape=box,color=red];
		j319870000 -> j1238701254;
	j2491225892 [label="Tu es apprécié. Tu es aimé. Tu as une famille et des amis. Même si tu n'en as pas toujours l'impression.",shape=box,color=red];
		j2491225892 -> j310329213;
	j1126970819 [label="Je... Tu plaisantes, j’espère. Tu ne peux pas penser ce que tu dis après ce dont tu as été témoin? Soit tu as perdu la raison, soit ta compassion a pris le dessus sur ton bon sens.",shape=box,color=blue];
		j1126970819 -> j2795909283;
		j1126970819 -> j3739289737;
	j2862131335 [label="+10 Chemistry",color=orange];
		j2862131335 -> j4006363057;
	j3544659054 [label="Il n'y a personne. Tu n'as plus besoin de souffrir ainsi. Laisse aller.",shape=box,color=red];
		j3544659054 -> j1937538391;
	j2147511879 [label="Je sais. Je sais que ça fait mal. Je compatis. Vraiment. Sors de la pièce.",shape=box,color=red];
		j2147511879 -> j1096366266;
	j1238701254 [label="+10 Chemistry",color=orange];
		j1238701254 -> j4280945240;
	j310329213 [label="Tu n'es pas seul, Lyon. Et tu nous manquerais.",shape=box,color=red];
		j310329213 -> j3227938210;
	j2795909283 [label="Non, Lyon. Je le pense vraiment. Tu comptes énormément pour moi et tout ce que je souhaite, c'est pouvoir te le faire réaliser.",shape=box,color=red];
		j2795909283 -> j1692991938;
	j3739289737 [label="Je... peut-être que tu as raison. Ce n'est peut-être pas le bon moment.",shape=box,color=red];
		j3739289737 -> j2002309265;
	j4006363057 [label="Boolean LyonRell2b is now true.",color=orange];
		j4006363057 -> "Chat ends.";
	j1937538391 [label="si seulement c'était aussi simple\nces chaînes sont miennes depuis si longtemps\nplus longtemps que le langage\nplus longtemps que mon propre nom\npardonne-moi",shape=box,color=blue];
		j1937538391 -> j2862131335;
	j1096366266 [label="Fais demi-tour et sors mentalement de cette pièce.",shape=box,color=red];
		j1096366266 -> j2818957916;
	j4280945240 [label="Je vois M. Necraloid et j'entends parler de M. Ordis, ou de M. Otak. Je pense aux Warframes vides, leurs pensées arrachées de leur crâne.",shape=box,color=blue];
		j4280945240 -> j798816541;
	j3227938210 [label="+10 Chemistry",color=orange];
		j3227938210 -> j2750090820;
	j1692991938 [label="Je.",shape=box,color=blue];
		j1692991938 -> j2228720352;
	j2002309265 [label="Bien. Je suis ravi que tu aies repris tes esprits. C'est sans doute contagieux. Peut-être devrions-nous faire une pause avec cet appareil, car je crains qu'il n'ait commencé à te ramollir le cerveau.",shape=box,color=blue];
		j2002309265 -> "Chat ends.";
	j2818957916 [label="oui,\nils seront là une autre fois\ncette chambre de sang et de chaînes\nl'attente\nune attente éternelle",shape=box,color=blue];
		j2818957916 -> j2463784685;
	j798816541 [label="Check boolean LyonPainOff",color=orange];
		j798816541 -> j1872579127 [label=true,color=green];
		j798816541 -> j3276485836 [label=false,color=brown];
	j2750090820 [label="Merci... mais je me demande combien de temps cela durera avant que le chagrin ne devienne simplement un fardeau de plus, plus facile à supporter avec le temps?",shape=box,color=blue];
		j2750090820 -> j4280945240;
	j2228720352 [label="Evaluate expressions",color=orange];
		j2228720352 -> j95134772 [label="DrifterLiar",color=purple];
		j2228720352 -> j3199750194 [label="LyonNoDate",color=purple];
		j2228720352 -> j2711906242 [label="false",color=purple];
	j2463784685 [label="Je te prie de m'excuser. Il m'arrive de perdre la raison et je déteste que d'autres en soient témoins.",shape=box,color=blue];
		j2463784685 -> j1242024200;
	j1872579127 [label="Il serait si facile de capituler. D'abandonner. De déposer mon agonie sur l'autel de la souffrance et de ne plus rien dire.",shape=box,color=blue];
		j1872579127 -> j199401647;
	j3276485836 [label="Il serait si facile de capituler. D'abandonner. De déposer mon agonie sur l'autel de la souffrance et de ne plus rien dire. Ou de faire bien pire: faire ce que beaucoup craignent que je ne commette, avec une lame dans l'obscurité de la nuit.",shape=box,color=blue];
		j3276485836 -> j199401647;
	j95134772 [label="Il y a... juste un problème, Voyageur. Comment pourrais-je te croire sur parole alors que je sais que tu as déjà proféré des mensonges?",shape=box,color=blue];
		j95134772 -> j2500357288;
	j3199750194 [label="Bien que flatté, je crains que ma réponse ne soit tout simplement et sans équivoque non.",shape=box,color=blue];
		j3199750194 -> "Chat ends.";
	j2711906242 [label="Je suis sans voix.",shape=box,color=blue];
		j2711906242 -> j2949228268;
	j1242024200 [label="Evaluate expressions",color=orange];
		j1242024200 -> j2430754661 [label="MarieDating",color=purple];
		j1242024200 -> j1965838051 [label="MarieDating",color=purple];
		j1242024200 -> j2430754661 [label="RoatheDating",color=purple];
		j1242024200 -> j1965838051 [label="RoatheDating",color=purple];
		j1242024200 -> j2430754661 [label="false",color=purple];
		j1242024200 -> j3323787544 [label="false",color=purple];
		j1242024200 -> j1965838051 [label="false",color=purple];
	j199401647 [label="Mais... ce n'est pas ce que je suis. Et je ne serai jamais ainsi. Je resterai ce rempart brisé, ce bouclier en ruine...",shape=box,color=blue];
		j199401647 -> j1351589164;
	j2500357288 [label="Tu as déjà été en flagrant délit de mensonge. Bien que j'ignore le but de celui-ci, je crains que tu n'aies déjà brisé ma confiance en toi.",shape=box,color=blue];
		j2500357288 -> j2548246037;
	j2949228268 [label="Ce qui, je le sais, n'est pas tout à fait inhabituel de ma part; cependant, j'ai le sentiment que je devrais répondre à cela d'une certaine manière.",shape=box,color=blue];
		j2949228268 -> j595650896;
	j2430754661 [label="Veux-tu qu'on s'arrête ici? Ou peux-tu continuer? Je comprendrai dans un cas comme dans l'autre.",shape=box,color=red];
		j2430754661 -> j3861127284;
	j1965838051 [label="Tout va bien. Je suis là pour toi. Ça va aller?",shape=box,color=red];
		j1965838051 -> j3175506857;
	j3323787544 [label="[Avouer ses sentiments.] Lyon, je... je tiens à toi. Je veux être là pour toi dans ces moments-là, si tu me le permets.",shape=box,color=red];
		j3323787544 -> j2621610093;
	j1351589164 [label="Toujours à saigner, sans jamais mourir...",shape=box,color=blue];
		j1351589164 -> j3487863417;
	j2548246037 [label="Aussi, bien que je sois profondément flatté, je crains que ma réponse ne soit tout simplement et sans équivoque:",shape=box,color=blue];
		j2548246037 -> j617350017;
	j595650896 [label="d'une manière astucieuse ou du moins d'une manière qui semblerait appropriée à la situation et ne pas -",shape=box,color=blue];
		j595650896 -> j2516224515;
	j3861127284 [label="Je peux continuer, merci. C'est passé, comme toujours. Ces... visions sont comme des nuages qui passent au-dessus de Lua. Elles peuvent être totalement obscures, mais elles sont souvent brèves.",shape=box,color=blue];
		j3861127284 -> j3122765629;
	j3175506857 [label="Oui, merci. C'est passé, comme toujours. Ces... visions sont comme des nuages qui passent au-dessus de Lua. Elles peuvent être totalement obscures, mais elles sont souvent brèves.",shape=box,color=blue];
		j3175506857 -> j3122765629;
	j2621610093 [label="Tu plaisantes, n'est-ce pas? Tu ne peux pas penser ce que tu dis après ce dont tu as été témoin? Soit tu as perdu la raison, soit ta compassion a pris le dessus sur ton bon sens.",shape=box,color=blue];
		j2621610093 -> j2795909283;
		j2621610093 -> j3739289737;
	j3487863417 [label="C'est la vie, hein?",shape=box,color=blue];
		j3487863417 -> j1198833156;
	j617350017 [label="Non.",shape=box,color=blue];
