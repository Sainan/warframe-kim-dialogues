		j8348369 -> "Chat ends." [label="false",color=purple];
	j1652594176 [label="Étais-tu vraiment à ce point à court d'options que tu as supplié Roathe de me harceler pour... accepter des excuses?",shape=box,color=blue];
		j1652594176 -> j2414094987;
	j4046753424 [label="Étais-tu vraiment à ce point à court d'options que tu as supplié Roathe de me harceler pour envoyer M. Loid à l'étage?",shape=box,color=blue];
		j4046753424 -> j557278366;
	j1929594150 [label="Étais-tu vraiment à ce point à court d'options que tu as supplié Roathe de me harceler en ton nom?",shape=box,color=blue];
		j1929594150 -> j1795968142;
	"Chat ends." [color=orange];
	j2414094987 [label="Tu te rends compte à quel point cela est absurde, n'est-ce pas?",shape=box,color=blue];
		j2414094987 -> j3925950806;
		j2414094987 -> j4220255487;
	j557278366 [label="Je ne souhaite pas perdre plus de temps que je n'en ai déjà perdu à écouter son argumentation. Je dirai simplement: très bien.",shape=box,color=blue];
		j557278366 -> j2169173578;
	j1795968142 [label="Le problème, si je ne me trompe pas, était que tu ne souhaitais pas fouiller dans mon passé. Tu sembles avoir changé d'avis, maintenant?",shape=box,color=blue];
		j1795968142 -> j2789956012;
	j3925950806 [label="Je ne savais pas qu'il avait dit que je m'excuserais.",shape=box,color=red];
		j3925950806 -> j4165849243;
	j4220255487 [label="Je ne savais plus quoi faire. Je sais que c'est ridicule avec le recul.",shape=box,color=red];
		j4220255487 -> j872466294;
	j2169173578 [label="Check boolean MarieFamilyFail",color=orange];
		j2169173578 -> j4160893059 [label=true,color=green];
		j2169173578 -> j2750549942 [label=false,color=brown];
	j2789956012 [label="Je ne comprends pas. On ne peut pas revenir en arrière. Ces eaux ne peuvent être retraversées.",shape=box,color=blue];
		j2789956012 -> j868912611;
		j2789956012 -> j386299499;
	j4165849243 [label="Je vois.",shape=box,color=blue];
		j4165849243 -> "Chat ends.";
	j872466294 [label="J'avoue que le côté comique de la situation est en partie ce qui m'a poussé à venir enquêter. Ton désespoir est-il vraiment si grand? Je ne peux imaginer que mon absence dans ta vie te soit si pénible.",shape=box,color=blue];
		j872466294 -> j4294369552;
	j4160893059 [label="Je t'apporterai mon aide comme tu le demandes. Je crains ce que ton diable fera ensuite à Marie.",shape=box,color=blue];
		j4160893059 -> j92487004;
	j2750549942 [label="Je t'apporterai mon aide comme tu le demandes. Maintenant, je t'en prie, rappelle ton diable.",shape=box,color=blue];
		j2750549942 -> j770168571;
	j868912611 [label="Ah. Eh bien, c'était donc une énorme perte de temps, n'est-ce pas?",shape=box,color=red];
		j868912611 -> "Chat ends.";
	j386299499 [label="Je suppose que... je vais simplement m'excuser, alors. Pour ne pas t'avoir écouté.",shape=box,color=red];
		j386299499 -> j1106060041;
	j4294369552 [label="Oui, Lyon. Je tiens à toi. Énormément. Et je sais que j'ai commis une grave erreur à ton égard.",shape=box,color=red];
		j4294369552 -> j1237024749;
	j92487004 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j92487004 -> j547953661;
	j770168571 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j770168571 -> j3711686580;
	j1106060041 [label="Puis-je te demander pourquoi tu ne l'as pas fait? Le sujet te faisait-il peur? Ou t'ennuyait-il, peut-être? Ou pensais-tu ne pas être capable d'y faire face?",shape=box,color=blue];
		j1106060041 -> j3883633866;
		j1106060041 -> j3454313963;
		j1106060041 -> j356120298;
	j1237024749 [label="Et je regrette vraiment beaucoup.",shape=box,color=red];
		j1237024749 -> j2441566578;
	j547953661 [label="Boolean LyonFamilyFail is now false.",color=orange];
		j547953661 -> "Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j3711686580 [label="Boolean LyonFamilyFail is now false.",color=orange];
		j3711686580 -> "Chat ends.";
	j3883633866 [label="J'avais peur.",shape=box,color=red];
		j3883633866 -> j4152090937;
	j3454313963 [label="Je n'en avais pas la force.",shape=box,color=red];
		j3454313963 -> j4152090937;
	j356120298 [label="À l'époque, ça m'était égal. Mais plus maintenant.",shape=box,color=red];
		j356120298 -> j3709770592;
	j2441566578 [label="Je ne savais plus quoi faire d'autre que de me tourner vers Roathe pour obtenir de l'aide.",shape=box,color=red];
		j2441566578 -> j4128243551;
	"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
	j4152090937 [label="Je n'ai donc d'autre choix que de te pardonner. ",shape=box,color=blue];
		j4152090937 -> j106665696;
	j3709770592 [label="Et qu'est-ce qui a changé pour que cela t'importe soudainement, alors qu'auparavant cela n'était pas le cas?",shape=box,color=blue];
		j3709770592 -> j394499857;
		j3709770592 -> j1794186051;
	j4128243551 [label="Je n'ai d'autre choix que de te pardonner, bien sûr. Je ne comprends pas pourquoi tu voudrais qu'une chose aussi imparfaite que moi encombre ton espace.",shape=box,color=blue];
		j4128243551 -> j3239447493;
	j106665696 [label="Boolean LyonConfessionFail is now false.",color=orange];
		j106665696 -> "Chat ends.";
	j394499857 [label="J'ai changé d'avis à ton sujet.",shape=box,color=red];
		j394499857 -> j4152090937;
	j1794186051 [label="J'ai le sentiment que des progrès pourraient être réalisés par le simple fait d'entendre tes histoires.",shape=box,color=red];
		j1794186051 -> j1148584983;
	j3239447493 [label="Mais je constate que mon agacement face à tes paroles s'estompe maintenant que je vois les extrémités absolument bizarres auxquelles tu peux aller pour m'avoir à tes côtés.",shape=box,color=blue];
		j3239447493 -> j2398113586;
	j1148584983 [label="Un moyen d'atteindre un but.",shape=box,color=blue];
		j1148584983 -> "Chat ends.";
