	2306 [label="Je vois.",shape=box,color=blue];
		2306 -> 2312;
	2307 [label="J'avoue que le côté comique de la situation est en partie ce qui m'a poussé à venir enquêter. Ton désespoir est-il vraiment si grand? Je ne peux imaginer que mon absence dans ta vie te soit si pénible.",shape=box,color=blue];
