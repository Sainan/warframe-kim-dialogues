		989 -> 994;
		989 -> 995;
	990 [label="+5 Chemistry",color=orange];
		990 -> 996;
	986 [label="Je ne sais pas toujours comment réagir correctement dans des situations comme celle-ci face à une simple curiosité concernant mon histoire personnelle, ou même à de simples marques d'amitié.",shape=box,color=blue];
		986 -> 992;
	993 [label="+5 Chemistry",color=orange];
		993 -> 983;
	997 [label="Oui et c'est ce sentiment qui, je dois l'avouer, me rend de plus en plus anxieux. Pour ma tranquillité d'esprit, pourrais-tu simplement me confirmer que tu penses bien ce que je crains de plus en plus?",shape=box,color=blue];
		997 -> 1000;
		997 -> 1001;
	994 [label="Je regrette de t'avoir ignoré tout à l'heure...",shape=box,color=red];
		994 -> 999;
	995 [label="Que veux-tu dire...?",shape=box,color=red];
		995 -> 999;
	996 [label="Je dois avouer que ton choix de mots m'inquiète. Je ne sais pas si tu veux dire ce que je pense.",shape=box,color=blue];
		996 -> 1000;
		996 -> 1001;
	992 [label="Quoi qu'il en soit, tu avais des questions sur mon passé, n'est-ce pas?",shape=box,color=blue];
		992 -> 998;
	1000 [label="Je vais te rassurer: je n'ai pas de sentiments pour toi.",shape=box,color=red];
		1000 -> 1005;
	1001 [label="Est-ce si difficile pour toi de croire que je pourrais avoir des sentiments pour toi, Lyon?",shape=box,color=red];
		1001 -> 1006;
	999 [label="Tu as abandonné cette poursuite avec autant de ferveur que tu l'avais entreprise. J'ai supposé que tu avais, à juste titre, conclu que c'était une mauvaise décision.",shape=box,color=blue];
		999 -> 1003;
		999 -> 1004;
	998 [label="Tu as probablement déjà remarqué que j'ai des visions. Cela fait partie de ma vie depuis ma plus tendre enfance.",shape=box,color=blue];
		998 -> 1002;
	1005 [label="Je ne voulais pas t'offenser, mais il est bon de savoir où nous en sommes. Je m'excuse de la façon dont je gère tout cela.",shape=box,color=blue];
		1005 -> 986;
	1006 [label="Update boolean DrifterLyon",color=orange];
