		985 -> 990 [label="false",color=purple];
	983 [label="Non, pardonne-moi. Je... suis désolé de la façon dont je gère tout cela.",shape=box,color=blue];
		983 -> 986;
	987 [label="Lyon, si tu préfères que je m'en aille, dis-le-moi.",shape=box,color=red];
