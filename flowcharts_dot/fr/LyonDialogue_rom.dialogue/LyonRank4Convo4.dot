		1004 -> 1011;
	1002 [label="Ces visions n'ont pas souvent été agréables, c'est le moins qu'on puisse dire.",shape=box,color=blue];
		1002 -> 1007;
		1002 -> 1008;
		1002 -> 1009;
	1012 [label="En résumé? Eh bien, oui. Je... ne cherche pas à repousser tes avances. Je suis simplement... peu habitué... à l’affection, Voyageur. En général.",shape=box,color=blue];
		1012 -> 1017;
	1010 [label="Je m'en doutais. Je te souhaite donc simplement une bonne fin de journée.",shape=box,color=blue];
