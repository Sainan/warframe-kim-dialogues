	973 [label="+20 Chemistry",color=orange];
		973 -> 975;
	979 [label="Je crains que ce ne soit pas une histoire très agréable à raconter. Je t'ai parlé des visions qui m'ont conduit à la cathédrale pour vénérer les Luminaires et de mes grands-parents qui se sont rencontrés pendant la Révolution Gaullique. Veux-tu vraiment perdre ton temps avec de telles choses?",shape=box,color=blue];
		979 -> 981;
		979 -> 982;
		979 -> 980;
	978 [label="Je crains que ce ne soit pas une histoire très agréable à raconter. Je t'ai parlé des visions qui m'ont conduit à la cathédrale pour vénérer les Luminaires. Veux-tu vraiment perdre ton temps avec de telles choses?",shape=box,color=blue];
		978 -> 981;
