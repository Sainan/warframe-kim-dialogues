	981 [label="Pourquoi penses-tu que c'est une perte de temps?",shape=box,color=red];
		981 -> 984;
	982 [label="Pour moi, ce n'est pas une perte de temps, Lyon. J'aimerais vraiment mieux te connaître.",shape=box,color=red];
		982 -> 985;
	980 [label="Pas de problème si tu préfères ne pas en parler.",shape=box,color=red];
		980 -> 983;
	984 [label="Je pense simplement qu'il y a de meilleures façons d'utiliser ton énergie. Par exemple, défendre un bastion contre une invasion ennemie, découvrir des connaissances nouvelles... ou trier des vêtements.",shape=box,color=blue];
		984 -> 987;
		984 -> 988;
