	1009 [label="Elles t'ont fait peur?",shape=box,color=red];
		1009 -> 1014;
	1017 [label="Si tu veux vraiment suivre cette voie, je ne t'en dissuaderai pas et moi... je la trouve troublante et... étrangère à tout ce que je connais?",shape=box,color=blue];
		1017 -> 1021;
	1015 [label="Chat ends.",color=orange];
	1016 [label="Elles ne sont pas... indésirables à proprement parler? Elles sont simplement... déconcertantes, de par leur existence même.",shape=box,color=blue];
		1016 -> 1020;
		1016 -> 1001;
	1013 [label="Une fois, je me suis réveillé en pleine nuit et j'ai aperçu le visage d'une vieille femme assise au pied de mon lit.",shape=box,color=blue];
		1013 -> 1018;
	1014 [label="Une fois, je me suis réveillé en pleine nuit et j'ai aperçu le visage d'une vieille femme assise au pied de mon lit.",shape=box,color=blue];
		1014 -> 1019;
	1021 [label="+5 Chemistry",color=orange];
		1021 -> 1025;
	1020 [label="Tu préfères que j'arrête?",shape=box,color=red];
		1020 -> 1024;
	1018 [label="Si maigre et si fragile qu'on aurait pu croire qu'elle était morte et enterrée depuis des années; sa peau collait si fort à ses os que je pouvais voir les espaces entre eux.",shape=box,color=blue];
		1018 -> 1022;
	1019 [label="Si maigre et si fragile qu'on aurait pu croire qu'elle était morte et enterrée depuis des années; sa peau collait si fort à ses os que je pouvais voir les espaces entre eux.",shape=box,color=blue];
		1019 -> 1023;
	1025 [label="Je suis... peut-être prudemment optimiste quant à la direction que prendra ce nouveau chemin. Cependant, tu avais des questions sur mon passé, n'est-ce pas?",shape=box,color=blue];
		1025 -> 1028;
	1024 [label="Non. Je... ne cherche pas à repousser tes avances. Je suis simplement... peu habitué... à l’affection, Voyageur. En général.",shape=box,color=blue];
		1024 -> 1017;
	1022 [label="Ses cheveux n'étaient guère plus que quelques mèches blanches qui pendaient mollement de sa tête. Mais ce sont ses yeux que je n'oublierai jamais. ",shape=box,color=blue];
		1022 -> 1026;
	1023 [label="Ses cheveux n'étaient guère plus que quelques mèches blanches qui pendaient mollement de sa tête. Mais ce sont ses yeux que je n'oublierai jamais. ",shape=box,color=blue];
		1023 -> 1027;
	1028 [label="Update boolean LyonFlirt2",color=orange];
		1028 -> 998;
	1026 [label="Car elle n'en avait pas.",shape=box,color=blue];
		1026 -> 1029;
	1027 [label="Car elle n'en avait pas.",shape=box,color=blue];
		1027 -> 1030;
	1029 [label="Trois mois plus tard, une femme du village a été retrouvée morte chez elle. Ses yeux dévorés par les rats.",shape=box,color=blue];
		1029 -> 1031;
	1030 [label="Trois mois plus tard, une femme du village a été retrouvée morte chez elle. Ses yeux dévorés par les rats.",shape=box,color=blue];
		1030 -> 1032;
	1031 [label="J'ai parlé à ma mère de ce que j'avais vu, la nuit où la vision m'avait réveillé. Elle se souvenait de ce que j'avais vu, tout comme moi.",shape=box,color=blue];
		1031 -> 1033;
		1031 -> 1034;
	1032 [label="Oui, Voyageur. Ces visions m'ont effrayé.",shape=box,color=blue];
		1032 -> 1031;
	1033 [label="Qu'est-ce qu'elle a fait?",shape=box,color=red];
		1033 -> 1035;
	1034 [label="A-t-elle pensé qu'il s'agissait d'une coïncidence ou d'un signe?",shape=box,color=red];
		1034 -> 1036;
	1035 [label="Elle m'a battu avec une baguette jusqu'à ce que je ne puisse plus tenir debout. Mon dos saignait tellement que j'ai dû dormir sur le ventre. Je me souviens encore de ses cris lorsqu'elle me frappait. \"Rabouin! Sorcier!\"",shape=box,color=blue];
		1035 -> 1037;
		1035 -> 1038;
		1035 -> 1039;
		1035 -> 1040;
	1036 [label="Je ne sais pas. Tout ce que je sais, c'est qu'elle m'a battu avec une baguette jusqu'à ce que je ne puisse plus tenir debout. Mon dos saignait tellement que j'ai dû dormir sur le ventre. Je me souviens encore de ses cris lorsqu'elle me frappait. \"Rabouin! Sorcier!\"",shape=box,color=blue];
		1036 -> 1037;
		1036 -> 1038;
		1036 -> 1039;
		1036 -> 1040;
	1037 [label="Quel âge avais-tu?",shape=box,color=red];
		1037 -> 1041;
	1038 [label="Oh, Lyon... Ça me fait de la peine...",shape=box,color=red];
		1038 -> 1042;
	1039 [label="C'est affreux...",shape=box,color=red];
		1039 -> 1042;
	1040 [label="Elle était ignorante. Elle ne savait pas comment réagir.",shape=box,color=red];
		1040 -> 1042;
	1041 [label="Quatre ans, peut-être. Six, au plus. Je ne sais pas. Nous ne comptions pas les années avec la même ferveur que vous le faites maintenant.",shape=box,color=blue];
		1041 -> 1043;
	1042 [label="+5 Chemistry",color=orange];
		1042 -> 1044;
	1043 [label="Check boolean LyonPainOff",color=orange];
		1043 -> 1046 [label=true,color=green];
		1043 -> 1045 [label=false,color=brown];
		1043 -> 1046 [label=false,color=brown];
	1044 [label="Ma mère était morte depuis longtemps quand nous sommes partis pour venir ici. Et maintenant, elle n'est plus que poussière. Elle a vécu une vie de misère... et une misère qu'elle était condamnée à répandre.",shape=box,color=blue];
		1044 -> 1047;
	1046 [label="Faire du mal à un enfant... C’est impardonnable.",shape=box,color=red];
		1046 -> 1042;
	1045 [label="C'est pour ça que tu...?",shape=box,color=red];
		1045 -> 1048;
	1047 [label="Elle était effrayée. Quel que soit mon mal, fardeau des dieux, folie, malédiction, elle était bien mal préparée pour y faire face.",shape=box,color=blue];
		1047 -> 1049;
	1048 [label="Check boolean LyonLecture2",color=orange];
		1048 -> 1050 [label=true,color=green];
		1048 -> 1051 [label=false,color=brown];
	1049 [label="Quoi qu'il en soit, aussi cruelle que fût ma mère, mon père était pire. Je t'épargne les détails.",shape=box,color=blue];
		1049 -> 1052;
	1050 [label="Peut-être. Je me suis souvent demandé si cela ne faisait pas partie de cette compulsion. Mais comme je te l'ai déjà dit, c'est aussi une méthode de Lua.",shape=box,color=blue];
		1050 -> 1053;
	1051 [label="Peut-être. Je me suis souvent demandé si cela ne faisait pas partie de cette compulsion. Mais c'est une méthode de Lua, des Luminaires. Je ne suis pas le seul à la pratiquer.",shape=box,color=blue];
		1051 -> 1054;
	1052 [label="En grandissant, les visions se sont muées en voix. Des murmures qui me parvenaient à toute heure, éveillé ou endormi. Mon travail à la ferme en a souffert et j'en ai pâti à mon tour.",shape=box,color=blue];
		1052 -> 1055;
		1052 -> 1056;
	1053 [label="+5 Chemistry",color=orange];
		1053 -> 2233;
	1054 [label="+5 Chemistry",color=orange];
		1054 -> 1058;
	1055 [label="Qu'est-ce qui t'a amené à l'église?",shape=box,color=red];
		1055 -> 1059;
	1056 [label="Certaines personnes ne méritent pas d'être parents.",shape=box,color=red];
		1056 -> 1060;
	2233 [label="J'insiste, cela m'apporte un minimum de paix, même si je sais que cela doit encore te paraître étrange.",shape=box,color=blue];
		2233 -> 1049;
	1058 [label="Un autre père de la cathédrale me l'a enseigné pour m'aider à apaiser mon esprit. Ceux que Lua choisit sont souvent \"bénis\" par des \"visions\".",shape=box,color=blue];
		1058 -> 1061;
	1059 [label="Check boolean LyonPainOff",color=orange];
		1059 -> 1063 [label=true,color=green];
		1059 -> 1062 [label=false,color=brown];
	1060 [label="J'apprécie tes paroles, mais je ne saurais trop insister sur le fait que j'étais un enfant difficile à gérer, surtout une fois que j'ai grandi et que je suis devenu plus grand et plus fort qu'eux.",shape=box,color=blue];
		1060 -> 1059;
	1061 [label="Update boolean LyonLecture2",color=orange];
		1061 -> 1049;
	1063 [label="Mes visions et les voix me plongeaient souvent dans des accès de violence, Voyageur. Me torturer était souvent le seul moyen de me réveiller de ce que je voyais.",shape=box,color=blue];
		1063 -> 1064;
	1062 [label="Mes visions et les voix me plongeaient souvent dans des accès de violence, Voyageur. Il m'arrivait de prendre un couteau et de me lacérer la chair, car seule la douleur parvenait à m'en arracher.",shape=box,color=blue];
		1062 -> 1064;
	1064 [label="Mais c'était lorsque les voix me l'ordonnaient.",shape=box,color=blue];
		1064 -> 1065;
	1065 [label="Je... je ne peux pas. Je ne peux tout simplement pas. Pardonne-moi. Mes mains tremblent en écrivant ces lignes. Je dois m'arrêter pour l'instant.",shape=box,color=blue];
		1065 -> 1066;
		1065 -> 1067;
	1066 [label="Bien sûr. Pas de souci. Il n'y a pas d'urgence. Je suis là, dès que tu seras prêt.",shape=box,color=red];
		1066 -> 1068;
	1067 [label="Je comprends, ça fait déjà beaucoup. Repose-toi, d'accord? Et... merci. Ça me touche beaucoup.",shape=box,color=red];
		1067 -> 1069;
	1068 [label="+10 Chemistry",color=orange];
		1068 -> 1070;
	1069 [label="+15 Chemistry",color=orange];
		1069 -> 1071;
	1070 [label="Merci. Je te reparlerai bientôt.",shape=box,color=blue];
		1070 -> 1072;
	1071 [label="Moi aussi. Plus que tu ne peux l'imaginer, je crois. Merci à toi en retour pour ton amitié. À bientôt.",shape=box,color=blue];
		1071 -> 1073;
	1072 [label="Update boolean LyonBackstory3b",color=orange];
		1072 -> 1074;
