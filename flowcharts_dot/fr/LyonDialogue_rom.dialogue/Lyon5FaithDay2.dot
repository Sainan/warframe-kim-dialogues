	1742 [label="J'ai réfléchi à la nature de notre conversation d'hier. Et à ce que signifie la présence indissociable de Rell et Harrow dans ma vie.",shape=box,color=blue];
		1742 -> 1747;
	1741 [label="J'ai réfléchi à la nature de notre conversation d'hier. Et à ce que signifie la présence indissociable de Rell et Harrow dans ma vie.",shape=box,color=blue];
		1741 -> 1746;
	1740 [label="J'ai réfléchi à la nature de notre conversation d'hier. Et à ce que signifie la présence indissociable de Rell et Harrow dans ma vie.",shape=box,color=blue];
		1740 -> 1745;
	1739 [label="Il y a quelque chose que je voulais aborder avec toi et je n'en ai l'occasion que maintenant. Quand… Rell, Harrow et moi nous sommes retrouvés mêlés à cette histoire – les détails importent peu –",shape=box,color=blue];
		1739 -> 1744;
	1743 [label="Chat ends.",color=orange];
	1747 [label="Pour ensuite voir leur présence effacée de mon âme une fois de plus, pour n'y garder qu'un souvenir. Et cela peut être un don de Lua…",shape=box,color=blue];
		1747 -> 1751;
	1746 [label="Pour ensuite voir leur présence effacée de mon âme une fois de plus, pour n'y garder qu'un souvenir. Et tu as raison. Cela signifie peut-être qu'il n'y a pas de dieux en ce monde.",shape=box,color=blue];
		1746 -> 1750;
	1745 [label="Pour ensuite voir leur présence effacée de mon âme une fois de plus, pour n'y garder qu'un souvenir. Et je ne sais pas si cela signifie que des dieux existent en ce monde.",shape=box,color=blue];
		1745 -> 1749;
	1744 [label="Je me suis retrouvé mêlé à leur passé, tout comme ils se sont retrouvés mêlés au mien. J'ai vu le Zariman Ten Zero, des bribes de l'Ancienne Guerre et de la même manière, ils ont vu tout mon passé.",shape=box,color=blue];
		1744 -> 1748;
	1751 [label="J'ai compris que notre Dame d'argent accordait une bénédiction bien tragique. Elle ne souhaitait pas effacer le souvenir de la douleur, comme ce fut le cas pour Roathe.",shape=box,color=blue];
		1751 -> 1754;
	1750 [label="Mais cela ne change rien, je pense, aux années que j'ai passées au service d'une organisation qui, au fond, avait pour vocation de faire le bien dans ce monde.",shape=box,color=blue];
		1750 -> 1753;
	1749 [label="Comme tu l'as dit, nous ne le saurons peut-être jamais. Et il se peut même que ce ne soit pas à nous de le savoir. Ainsi va la vie. Mais cela ne change rien, je pense, aux années que j'ai passées au service d'une organisation qui, au fond, avait pour vocation de faire le bien dans le monde.",shape=box,color=blue];
		1749 -> 1753;
	1748 [label="Cela a remis en question beaucoup de choses pour moi, notamment ma foi. Elle s'est effondrée, comme du papier brûlé, réduite en poussière. Je me déteste pour cette faiblesse…",shape=box,color=blue];
		1748 -> 1752;
	1754 [label="Elle n'a pas non plus effacé la douleur du fouet sur ma chair. Ce n'est certainement pas sa façon de me protéger du chagrin causé par sa disparition.",shape=box,color=blue];
		1754 -> 1763;
	1753 [label="Pour aider ceux qui souhaitaient soulager la douleur de leur vie aux moments où elle menaçait de les submerger.",shape=box,color=blue];
		1753 -> 1762;
	1752 [label="Evaluate expressions",color=orange];
		1752 -> 1760 [label="LyonDating",color=purple];
		1752 -> 1761 [label="DrifterFaithYesSimilar",color=purple];
		1752 -> 1761 [label="DrifterFaithYesForeign",color=purple];
		1752 -> 1761 [label="DrifterFaithPersonal",color=purple];
		1752 -> 1759 [label="DrifterFaithSol",color=purple];
		1752 -> 1759 [label="DrifterFaithLua",color=purple];
		1752 -> 1759 [label="DrifterFaithBalance",color=purple];
		1752 -> 1758 [label="DrifterFaithAgnostic",color=purple];
		1752 -> 1757 [label="DrifterFaithNoFear",color=purple];
		1752 -> 1756 [label="DrifterFaithNoMITW",color=purple];
		1752 -> 1757 [label="DrifterFaithNoMaybe",color=purple];
		1752 -> 1755 [label="false",color=purple];
	1763 [label="Là où Sol aurait dissipé la douleur comme un couteau chauffé à blanc cautérise une plaie, Lua m'aurait fait embrasser la chaleur de la douleur que son absence pouvait engendrer.",shape=box,color=blue];
		1763 -> 1770;
	1762 [label="Et je sais que, si je pouvais encore trouver la présence de Rell et de Harrow, ils ne voudraient pas que je souffre de leur disparition. Ils reposent en paix.",shape=box,color=blue];
		1762 -> 1769;
	1760 [label="Oh, Lyon… tu as tellement souffert. Le doute n’est pas un signe de faiblesse, il est le fruit de la douleur.",shape=box,color=red];
		1760 -> 1764;
		1760 -> 1765;
		1760 -> 1766;
		1760 -> 1767;
		1760 -> 1768;
	1761 [label="La foi n'a pas besoin d'être constante. Combien d'histoires parlent de personnes qui perdent la foi pour ensuite la retrouver ?",shape=box,color=red];
		1761 -> 1764;
		1761 -> 1765;
		1761 -> 1766;
	1759 [label="Tu as consacré ta vie à nos Luminaires, Lyon. Crois-tu qu'ils te tourneraient le dos pour une chose pareille?",shape=box,color=red];
		1759 -> 1764;
		1759 -> 1765;
		1759 -> 1766;
	1758 [label="Je ne sais pas si les dieux existent, Lyon – je ne pense pas que nous puissions jamais vraiment le savoir. Mais ce que je sais, c'est que tu as traversé bien des épreuves.",shape=box,color=red];
		1758 -> 1764;
		1758 -> 1766;
		1758 -> 1767;
	1757 [label="Bien que je ne croie pas personnellement en l'existence de dieux sur cette terre, je sais combien cela est important pour toi. Je ne veux en aucun cas minimiser cela.",shape=box,color=red];
		1757 -> 1766;
		1757 -> 1768;
	1756 [label="L'Indifférence, c'est nous qui l'avons créée – ce n'est pas un dieu, Lyon. Ne laisse pas l'erreur d'Entrati te détruire. Et ta foi?",shape=box,color=red];
		1756 -> 1766;
		1756 -> 1768;
	1755 [label="Ça me fait mal au cœur de te voir comme ça, pris au milieu de toutes ces folies. Tu ne méritais pas ça.",shape=box,color=red];
		1755 -> 1764;
		1755 -> 1765;
		1755 -> 1766;
		1755 -> 1767;
		1755 -> 1768;
	1770 [label="Car c'est l'absence de douleur qui menace de nous détruire, tout comme son abondance pourrait nous noyer.",shape=box,color=blue];
		1770 -> 1778;
		1770 -> 1779;
		1770 -> 1777;
	1769 [label="Je ne crois pas non plus que toutes mes souffrances aient été vaines. Cela n'invalide pas tout ce que j'ai enduré.",shape=box,color=blue];
		1769 -> 1776;
	1764 [label="Je ne dis pas que tu dois retrouver la foi. Je dis que si tu le souhaites, si tu en ressens le besoin, ce n'est pas quelque chose de perdu à jamais.",shape=box,color=red];
		1764 -> 1771;
	1765 [label="Lua peut certainement voir ce que tu as enduré. Ce que tu as subi en son nom. ",shape=box,color=red];
		1765 -> 1772;
	1766 [label="Je pense que ce sur quoi tu dois te concentrer, c'est trouver une forme de paix intérieure, quelle que soit la manière.",shape=box,color=red];
		1766 -> 1773;
	1767 [label="Si un dieu existe, si ta Lua existe bel et bien, elle peut certainement voir ce que tu as vécu. Ce que tu as enduré en son nom. Cela doit avoir une signification pour elle.",shape=box,color=red];
		1767 -> 1774;
	1768 [label="Je pense que tu dois abandonner toute idée de l'existence ou non des dieux et te concentrer d'abord sur ta propre guérison.",shape=box,color=red];
		1768 -> 1775;
	1778 [label="Crois-moi... je sais à quel point l'apathie peut être dangereuse.",shape=box,color=red];
		1778 -> 1785;
	1779 [label="Cela signifie-t-il que tu as retrouvé la foi?",shape=box,color=red];
		1779 -> 1786;
	1777 [label="[Fin.]",shape=box,color=red];
		1777 -> 1784;
	1776 [label="Car c'est l'absence de douleur qui menace de nous détruire, tout comme son abondance pourrait nous noyer.",shape=box,color=blue];
		1776 -> 1778;
		1776 -> 1783;
		1776 -> 1777;
	1771 [label="Update boolean LyonFaith3Maybe",color=orange];
		1771 -> 1780;
	1772 [label="Update boolean LyonFaith3Yes",color=orange];
		1772 -> 1781;
	1773 [label="Update boolean LyonFaith3Maybe",color=orange];
