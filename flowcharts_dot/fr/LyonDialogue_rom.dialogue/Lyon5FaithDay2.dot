	1774 [label="Update boolean LyonFaith3Yes",color=orange];
		1774 -> 1781;
	1775 [label="Update boolean LyonFaith3No",color=orange];
		1775 -> 1782;
	1785 [label="Il semblerait. ",shape=box,color=blue];
		1785 -> 1791;
	1786 [label="Difficile à dire. Je ne sais pas, car c'est quelque chose qu'on ne \"trouve\" ni ne \"perd\" jamais vraiment, mais qu'on cherche sans cesse. On est toujours en quête de réponses.",shape=box,color=blue];
		1786 -> 1792;
	1784 [label="Update boolean LyonConfessionFail",color=orange];
		1784 -> 1790;
	1783 [label="Cela signifie-t-il que tu as renoncé à ta foi?",shape=box,color=red];
		1783 -> 1786;
	1780 [label="Je réfléchis à ce que signifie avoir Rell et Harrow si inexorablement présents dans ma vie.",shape=box,color=blue];
		1780 -> 1787;
	1781 [label="Je repense aux années que j'ai passées au service d'une organisation qui, au fond, avait pour vocation de faire le bien dans ce monde… à ce que signifie la présence indélébile de Rell et Harrow dans ma vie.",shape=box,color=blue];
		1781 -> 1788;
	1782 [label="Je réfléchis à ce que signifie avoir Rell et Harrow si inexorablement présents dans ma vie.",shape=box,color=blue];
		1782 -> 1789;
	1791 [label="Je ne sais pas, car la foi est quelque chose qu'on ne \"trouve\" ni ne \"perd\" jamais vraiment, mais qu'on cherche sans cesse. On est toujours en quête de réponses.",shape=box,color=blue];
		1791 -> 1792;
	1792 [label="Mais je pense que, comme pour la douleur, il faut trouver un équilibre pour éviter de s'y noyer ou de s'y endurcir au point d'être immunisé et insensible.",shape=box,color=blue];
		1792 -> 1796;
	1790 [label="Chat ends.",color=orange];
	1787 [label="Pour ensuite voir leur présence effacée de mon âme une fois de plus, pour n'y garder qu'un souvenir. Et je ne sais pas si cela signifie que des dieux existent en ce monde.",shape=box,color=blue];
		1787 -> 1793;
	1788 [label="Pour ensuite voir leur présence effacée de mon âme une fois de plus, pour n'y garder qu'un souvenir. Et cela peut être un don de Lua…",shape=box,color=blue];
		1788 -> 1794;
	1789 [label="Pour ensuite voir leur présence effacée de mon âme une fois de plus, pour n'y garder qu'un souvenir. Et tu as raison. Cela signifie peut-être qu'il n'y a pas de dieux en ce monde.",shape=box,color=blue];
		1789 -> 1795;
	1796 [label="Check boolean DrifterFaithNoMITW",color=orange];
		1796 -> 1797 [label=true,color=green];
		1796 -> 1799 [label=true,color=green];
		1796 -> 1798 [label=false,color=brown];
		1796 -> 1799 [label=false,color=brown];
	1793 [label="Comme tu l'as dit, nous ne le saurons peut-être jamais. Et il se peut même que ce ne soit pas à nous de le savoir. Ainsi va la vie. Mais cela ne change rien, je pense, aux années que j'ai passées au service d'une organisation qui, au fond, avait pour vocation de faire le bien dans le monde.",shape=box,color=blue];
		1793 -> 1753;
	1794 [label="Tu as peut-être raison. Peut-être que notre Dame d'argent a décidé de m'octroyer une bénédiction aussi tragique. Elle ne souhaitait pas effacer le souvenir de la douleur, comme ce fut le cas pour Roathe.",shape=box,color=blue];
		1794 -> 1754;
	1795 [label="Mais cela ne change rien, je pense, aux années que j'ai passées au service d'une organisation qui, au fond, avait pour vocation de faire le bien dans ce monde.",shape=box,color=blue];
		1795 -> 1753;
	1797 [label="Es-tu d'accord avec Roathe et moi sur le fait que l'Homme dans le Mur n'est pas un vrai dieu?",shape=box,color=red];
		1797 -> 1800;
	1799 [label="À ton avis, où se situe l'Indifférence dans tout cela?",shape=box,color=red];
		1799 -> 1801;
	1798 [label="Tu rejoins Roathe lorsqu'il pense que l'Indifférence est un vrai dieu ou pas?",shape=box,color=red];
		1798 -> 1800;
	1800 [label="Je ne sais pas trop quoi penser de tout ça. Je n'ai pas assez d'éléments pour me décider. Mais au fond, cela ne change pas grand-chose, non?",shape=box,color=blue];
		1800 -> 1802;
		1800 -> 1803;
	1801 [label="Que l'Indifférence soit un dieu ou non, je n'ai pas d'avis tranché. Je n'ai pas assez d'éléments pour me décider. Mais au fond, cela ne change pas grand-chose, n'est-ce pas?",shape=box,color=blue];
		1801 -> 1802;
		1801 -> 1803;
	1802 [label="Je pense que cela change tout, au contraire. Si ce n'est pas un dieu réel, c'est une création humaine. Cela signifie qu'elle peut être vaincue par les hommes.",shape=box,color=red];
		1802 -> 1804;
	1803 [label="Que veux-tu dire?",shape=box,color=red];
		1803 -> 1805;
	1804 [label="Si tu n'avais aucun espoir de la vaincre, pourquoi t'es-tu donné la peine de t'y opposer dès le départ? Vraiment, tu es une créature déconcertante.",shape=box,color=blue];
		1804 -> 1806;
	1805 [label="La manière dont il est arrivé dans notre univers ne change rien aux méthodes grâce auxquelles nous pourrions le vaincre.",shape=box,color=blue];
		1805 -> 1807;
	1806 [label="Tu ne penses pas ce que tu dis. Tu te contentes donc de suivre le mouvement? Tu la combats, faute de mieux occuper tes journées?",shape=box,color=blue];
		1806 -> 1808;
	1807 [label="Voici: un dieu de notre création, composé du tissu de notre propre vacuité.",shape=box,color=blue];
		1807 -> 1809;
	1808 [label="Tu pourrais sûrement trouver un meilleur passe-temps.",shape=box,color=blue];
		1808 -> 1810;
		1808 -> 1811;
	1809 [label="Une poupée de chiffon que l'on pourrait remplir à l'excès de tristesse, de notre chagrin, de notre douleur, de notre colère, de notre agonie, jusqu'à ce que les coutures menacent d'éclater.",shape=box,color=blue];
		1809 -> 1812;
	1810 [label="Non, je ne pensais pas que c'était sans espoir - ce n'est pas ce que je voulais dire.",shape=box,color=red];
		1810 -> 1813;
	1811 [label="Ce que je voulais dire, c'est que cela change notre façon d'envisager son élimination. De la comprendre.",shape=box,color=red];
		1811 -> 1814;
	1812 [label="Tu me pardonneras si je trouve que cela m'inspire bien plus d'effroi que si c'était un dieu qui existait avant notre arrivée. ",shape=box,color=blue];
		1812 -> 1815;
	1813 [label="Réfléchir avant de parler n'est pas une condition préalable. Il en va de même pour les balles. ",shape=box,color=blue];
		1813 -> 1807;
	1814 [label="Je ne crois pas que ce soit vrai. J'ajouterais que nous comprenons tout aussi peu ses motivations aujourd'hui que s'il s'agissait d'un \"dieu grand et insondable\".",shape=box,color=blue];
		1814 -> 1807;
	1815 [label="Oui, en fait, je crois que je préfère ça.",shape=box,color=blue];
		1815 -> 1816;
	1816 [label="Il y a peut-être un espoir qu'elle soit plus intelligente que l'humanité dans son ensemble.",shape=box,color=blue];
		1816 -> 1817;
	1817 [label="Sur cette pensée... profondément sombre, je crois que je vais te laisser pour aujourd'hui.",shape=box,color=blue];
		1817 -> 1818;
	1818 [label="Check boolean LyonDating",color=orange];
		1818 -> 1820 [label=true,color=green];
		1818 -> 1819 [label=false,color=brown];
	1820 [label="+20 Chemistry",color=orange];
		1820 -> 1822;
	1819 [label="+20 Chemistry",color=orange];
		1819 -> 1821;
	1822 [label="Nous nous reparlerons bientôt, mon miracle. Merci.",shape=box,color=blue];
		1822 -> 1823;
	1821 [label="Nous nous reparlerons bientôt, cher Voyageur. Merci.",shape=box,color=blue];
		1821 -> 1823;
