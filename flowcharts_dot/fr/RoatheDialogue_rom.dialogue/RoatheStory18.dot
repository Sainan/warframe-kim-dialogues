	2292 [label="Transcription: \"La paix?\"",shape=box,color=blue];
		2292 -> 5717;
	5717 [label="Her voice was broken glass grinding in my ears.",shape=box,color=blue];
		5717 -> 5718;
	5718 [label="Executor Nitokh was displeased. She had expected a glorious escalation, battle after battle, ending in the climactic ecstasy of the Orokin’s demise.",shape=box,color=blue];
		5718 -> 5719;
	5719 [label="After which she would emerge from hiding and… well, there I am left to speculate. Perhaps she expected to be invited into the Sentients’ confidence.",shape=box,color=blue];
		5719 -> 2291;
	2291 [label="Ou peut-être pensait-elle qu'ils abandonneraient les vestiges calcinés et pollués du Système Origine et la laisseraient fonder son propre royaume.",shape=box,color=blue];
		2291 -> 2297;
	2297 [label="Quoi qu'il en soit, la paix était inacceptable. Nous nous sommes donc attelés à la saper.",shape=box,color=blue];
