	j2175403894 [label="MV: TRAHISON",shape=box,color=blue];
		j2175403894 -> j2401583294;
	j2401583294 [label="Transcription: \"La paix?\"",shape=box,color=blue];
		j2401583294 -> j3596548433;
	j3596548433 [label="Sa voix me vrillait les oreilles comme du verre brisé.",shape=box,color=blue];
		j3596548433 -> j2358048633;
	j2358048633 [label="L’Exécutrice Nitokh était mécontente. Elle s’attendait à une escalade glorieuse, bataille après bataille, culminant dans l’extase finale de la chute des Orokins.",shape=box,color=blue];
		j2358048633 -> j888823071;
	j888823071 [label="Après quoi elle sortit de sa cachette et… eh bien, je ne peux que spéculer. Peut-être s'attendait-elle à être admise dans le cercle intime des Sentients.",shape=box,color=blue];
		j888823071 -> j3786723392;
	j3786723392 [label="Ou peut-être pensait-elle qu'ils abandonneraient les vestiges calcinés et pollués du Système Origine et la laisseraient fonder son propre royaume.",shape=box,color=blue];
		j3786723392 -> j4182000859;
	j4182000859 [label="Quoi qu'il en soit, la paix était inacceptable. Nous nous sommes donc attelés à la saper.",shape=box,color=blue];
		j4182000859 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
