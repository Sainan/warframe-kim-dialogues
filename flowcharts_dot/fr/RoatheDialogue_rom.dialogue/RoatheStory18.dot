	j345366997 [label="VM: TREASON",shape=box,color=blue];
		j345366997 -> j180329062;
	j180329062 [label="Transcription: \"La paix?\"",shape=box,color=blue];
		j180329062 -> j230115181;
	j230115181 [label="Her voice was broken glass grinding in my ears.",shape=box,color=blue];
		j230115181 -> j2631471959;
	j2631471959 [label="Executor Nitokh was displeased. She had expected a glorious escalation, battle after battle, ending in the climactic ecstasy of the Orokin’s demise.",shape=box,color=blue];
		j2631471959 -> j1483832734;
	j1483832734 [label="After which she would emerge from hiding and… well, there I am left to speculate. Perhaps she expected to be invited into the Sentients’ confidence.",shape=box,color=blue];
		j1483832734 -> j3786723392;
	j3786723392 [label="Ou peut-être pensait-elle qu'ils abandonneraient les vestiges calcinés et pollués du Système Origine et la laisseraient fonder son propre royaume.",shape=box,color=blue];
		j3786723392 -> j4182000859;
	j4182000859 [label="Quoi qu'il en soit, la paix était inacceptable. Nous nous sommes donc attelés à la saper.",shape=box,color=blue];
		j4182000859 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}