	j995345345 [label="MV: FEU",shape=box,color=blue];
		j995345345 -> j2575815571;
	j2575815571 [label="Transcription: la monstruosité et l’excès nous avaient admirablement servis par le passé. On attendait de moi que je les utilise comme tactiques de guerre.",shape=box,color=blue];
		j2575815571 -> j603961585;
	j603961585 [label="Comment avions-nous dompté l’Infestation du temps de nos ancêtres? En arrachant le cœur de l’atome comme un bouton de rose, bien sûr!",shape=box,color=blue];
		j603961585 -> j836810137;
	j836810137 [label="D'une seule voix, les Sept m'ont ordonné de devenir un Diable armé d'un trident de têtes nucléaires, un semeur porteur d'une cargaison de radiations dévastatrices.",shape=box,color=blue];
		j836810137 -> j3965954314;
	j3965954314 [label="Ce jour-là, nous avons appris que les Sentients étaient non seulement capables de neutraliser notre technologie, mais aussi de s'en emparer.",shape=box,color=blue];
		j3965954314 -> j1624363823;
	j1624363823 [label="Les nuées de vilains petits drones niveleurs que nous avions envoyés sont revenus en volant joyeusement, toujours chargés de bombes, gloussant des syllabes inconnues, explosant au milieu même des vaisseaux amiraux qui les avaient envoyés.",shape=box,color=blue];
		j1624363823 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}