digraph {
	"RoatheRank4Convo3 begins." [color=orange];
		"RoatheRank4Convo3 begins." -> j371357809;
	j371357809 [label="Résous cette énigme, Usurpateur: si la situation l'exigeait, penses-tu pouvoir vaincre ton homologue Tenno dans un combat à mort?",shape=box,color=blue];
		j371357809 -> j2752981388;
		j371357809 -> j3401703968;
		j371357809 -> j2429168889;
	j2752981388 [label="Quoi? Pourquoi...?",shape=box,color=red];
		j2752981388 -> j3219740671;
	j3401703968 [label="Je ne souhaite pas avoir cette conversation.",shape=box,color=red];
		j3401703968 -> j1482985016;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j3219740671 [label="Car je ne sais pas si tu l'as remarqué, mais \"le Lotus\" n'est pas seulement un Sentient, responsable d'avoir envoyé Lua dans le Néant, je tiens à le préciser, mais elle a aussi, de manière quantifiable, perdu le contrôle de ses circuits.",shape=box,color=blue];
		j3219740671 -> j1767965402;
		j3219740671 -> j1521319941;
		j3219740671 -> j1161678574;
		j3219740671 -> j3144212795;
		j3219740671 -> j4199559113;
	j1482985016 [label="Je ne cherche pas à être grossier. Je suis tout à fait sérieux, vois-tu. Il s'agit d'une conversation purement pragmatique. ",shape=box,color=blue];
		j1482985016 -> j3219740671;
	"Chat ends." [color=orange];
	j1767965402 [label="Elle va bien. Tu ne sais pas de quoi tu parles.",shape=box,color=red];
		j1767965402 -> j600340719;
	j1521319941 [label="Elle a perdu le contrôle de ses circuits? Que veux-tu dire?",shape=box,color=red];
		j1521319941 -> j667722061;
	j1161678574 [label="Non. Sans moi. Lotus m'a sauvé la vie. Elle a sauvé la vie des Tennos d'innombrables fois. Nous lui devons tout.",shape=box,color=red];
		j1161678574 -> j3704978530;
	j3144212795 [label="Tais-toi Roathe, je ne joue pas à ça. [Fin.]",shape=box,color=red];
		j3144212795 -> j3662701763;
	j4199559113 [label="Je sais, je m'inquiète aussi. Mais elle en a tellement fait pour nous, je ne peux pas l'abandonner. Je dois la soutenir.",shape=box,color=red];
		j4199559113 -> j1564866129;
	j600340719 [label="Ah non? Fais attention! Regarde autour de toi! Combien de temps a-t-elle passé au bord d'une falaise, un vieux bipeur à la main, à fredonner? Le regard perdu dans le Néant?",shape=box,color=blue];
		j600340719 -> j4152745426;
	j667722061 [label="Combien de temps a-t-elle passé au bord d'une falaise, un vieux bipeur à la main, à fredonner? Le regard perdu dans le Néant?",shape=box,color=blue];
		j667722061 -> j4152745426;
	j3704978530 [label="Je ne suis pas insensible. Je comprends ce que tu ressens. Tu lui dois beaucoup. Je ne te dis pas de la tuer, je te dis de ne plus la laisser influencer ton entourage.",shape=box,color=blue];
		j3704978530 -> j667722061;
	j3662701763 [label="Comme tu veux. Mais quand tout s'effondrera autour de toi? Ne viens pas mendier mon aide.",shape=box,color=blue];
		j3662701763 -> "Chat ends.";
	j1564866129 [label="+5 Chemistry",color=orange];
		j1564866129 -> j1923125476;
	j4152745426 [label="Et maintenant, elle est juste… là, tapie dans l’ombre? Elle te plonge toujours plus profondément dans tes souvenirs d’enfant, pour quoi faire? Pour rentrer à la maison, simplement parce qu’Albrecht a claqué des doigts et murmuré le mot magique?",shape=box,color=blue];
		j4152745426 -> j165479452;
	j1923125476 [label="Je ne suis pas insensible. Je comprends ce que tu ressens. Tu lui dois beaucoup. Je ne te dis pas de la tuer, je te dis de ne plus la laisser influencer ton entourage.",shape=box,color=blue];
		j1923125476 -> j758912939;
	j165479452 [label="Cela ne te paraît-il pas suspect? Cela ne te paraît-il pas dangereux? C’est un piège. Elle est manipulée. Soit par Albrecht, soit par cette soi-disant \"Indifférence\". Elle est un programme défaillant. Ses préceptes dysfonctionnent.",shape=box,color=blue];
		j165479452 -> j665230673;
	j758912939 [label="Quand elle était là, au bord de la falaise, un vieux bipeur à la main, fredonnant pour elle-même? Le regard perdu dans le Néant? N’as-tu pas pensé qu’elle allait sauter?",shape=box,color=blue];
		j758912939 -> j4152745426;
	j665230673 [label="Je ne pense pas qu'elle veuille te faire du mal. Je pense qu'elle se fait simplement manipuler. Mais le moment venu, tu devras peut-être te défendre. Ou peut-être devras-tu la neutraliser.",shape=box,color=blue];
		j665230673 -> j3040008191;
	j3040008191 [label="Et même s'il est (espérons-le) probable que tu comprennes l'intérêt d'éviter une seconde vague de problèmes liés au Lotus, son armée d'enfants sauvages, elle, ne le comprendra pas. Je repose donc la question:",shape=box,color=blue];
		j3040008191 -> j2938034956;
	j2938034956 [label="Qui selon toi l'emporterait si ce jour terrible arrivait et que tu devais combattre avec toutes vos ressources? Toi et tout ce que tu as, contre tous les Tennos et le Lotus?",shape=box,color=blue];
		j2938034956 -> j1055362159;
		j2938034956 -> j2983875223;
		j2938034956 -> j1615123436;
	j1055362159 [label="C'est absurde. Non.",shape=box,color=red];
		j1055362159 -> j568734888;
	j2983875223 [label="Ils sont... je ne sais pas, une centaine. Face à... juste moi, Roathe.",shape=box,color=red];
		j2983875223 -> j2812776803;
	j1615123436 [label="Je ne sais même pas par où commencer.",shape=box,color=red];
		j1615123436 -> j492700366;
	j568734888 [label="Considère cela comme un jeu idiot, s'il le faut! Un jeu théorique d'enfants. ",shape=box,color=blue];
		j568734888 -> j2069986862;
		j568734888 -> j3502154303;
	j2812776803 [label="+5 Chemistry",color=orange];
		j2812776803 -> j2009585000;
	j492700366 [label="Alors, c'est une excellente chose que tu sois en train de parler au \"Diable de Tau\". Ce n'est pas par hasard que je suis reconnu comme stratège. Commençons par le commencement: les chiffres. Ils jouent clairement contre toi. ",shape=box,color=blue];
		j492700366 -> j4181059854;
	j2069986862 [label="Ce n'est pas un jeu.",shape=box,color=red];
		j2069986862 -> j2626031833;
	j3502154303 [label="Pour la dernière fois. Non. [Fin.]",shape=box,color=red];
		j3502154303 -> "Chat ends.";
	j2009585000 [label="Parfait. Nous avons établi la toute première règle de l'aménagement du champ de bataille: le nombre. De toute évidence, ils te surclassent largement.",shape=box,color=blue];
		j2009585000 -> j4181059854;
	j4181059854 [label="Check boolean IsDating",color=orange];
		j4181059854 -> j402715160 [label=true,color=green];
		j4181059854 -> j3120704970 [label=false,color=brown];
	j2626031833 [label="Tu as raison. Ce n'est pas un jeu. Et cela pourrait un jour être une question de vie ou de mort. Toi contre ta petite... version miniature. Et sa meute de compagnons sauvages.",shape=box,color=blue];
		j2626031833 -> j1187479075;
	j402715160 [label="Cependant, si l'on pouvait exploiter les rumeurs concernant tes \"activités personnelles\" et ta liaison avec une protoframe dans d'autres lignes temporelles, il serait peut-être possible de mobiliser ces ressources d'une manière ou d'une autre. Plusieurs Helminths devraient être spécifiquement recherchés et élevés à cette fin…",shape=box,color=blue];
		j402715160 -> j3397861005;
	j3120704970 [label="J'ai entendu parler de tes interactions avec d'autres protoframes dans d'autres lignes temporelles. Peut-être serait-il possible d'exploiter ces ressources d'une manière ou d'une autre. Plusieurs Helminths devraient être spécifiquement recherchés et élevés à cette fin…",shape=box,color=blue];
		j3120704970 -> j3397861005;
	j1187479075 [label="Des compagnons sauvages qui, soit dit en passant, se sont déjà révélés violents et indisciplinés. De plus, ils sont connus pour exclure cruellement les leurs parce qu'ils s'écartent trop de leur propre conception de la normalité.",shape=box,color=blue];
		j1187479075 -> j1417434070;
		j1187479075 -> j1157352897;
		j1187479075 -> j3253056529;
	j3397861005 [label="Je ne sais même pas si c'est possible, mais cela nous a permis d'arriver jusqu'ici, alors je ne vois pas pourquoi pas...",shape=box,color=blue];
		j3397861005 -> j2674315432;
		j3397861005 -> j1991014742;
		j3397861005 -> j853104358;
	j1417434070 [label="Tu insinues que les Tennos sont mauvais, c'est ça?",shape=box,color=red];
		j1417434070 -> j3815472882;
	j1157352897 [label="Qu'est-ce que tu dis?",shape=box,color=red];
		j1157352897 -> j2778305711;
	j3253056529 [label="Non. J'ai terminé. [Fin.]",shape=box,color=red];
		j3253056529 -> j2098172102;
	j2674315432 [label="Roathe? Va en enfer.",shape=box,color=red];
		j2674315432 -> j1868567281;
	j1991014742 [label="Je ne vais pas les impliquer dans ce foutoir.",shape=box,color=red];
		j1991014742 -> j2091595569;
	j853104358 [label="Je m'inquiète de voir à quel point tu as réfléchi à cela.",shape=box,color=red];
		j853104358 -> j1180312568;
	j3815472882 [label="Non, pas mauvais. Je ne crois pas au \"mal\", Usurpateur. Je n'y ai jamais cru et n'y croirai jamais. Je crois que les Tennos sont merveilleusement et magnifiquement humains, comme tout le monde. Simplement humains. Et de plus, ce sont des enfants.",shape=box,color=blue];
		j3815472882 -> j3547642065;
	j2778305711 [label="Que le moment viendra, un jour terrible, où tu devras peut-être faire l'impensable.",shape=box,color=blue];
		j2778305711 -> j3889928439;
	j2098172102 [label="Fuis la conversation si tu veux, mais tu sais que tout ce qui a été dit est vrai. Tu refuses simplement de l'accepter.",shape=box,color=blue];
		j2098172102 -> "Chat ends.";
	j1868567281 [label="+5 Chemistry",color=orange];
		j1868567281 -> j521306352;
	j2091595569 [label="Ah! Tu admets donc qu'il y a un problème. C'est un progrès. Puis-je au moins exposer mon point de vue?",shape=box,color=blue];
		j2091595569 -> j2892303404;
		j2091595569 -> j749788098;
	j1180312568 [label="Et je m'inquiète de l'ampleur de ton ignorance. Puis-je au moins exposer mon point de vue?",shape=box,color=blue];
		j1180312568 -> j2892303404;
		j1180312568 -> j749788098;
	j3547642065 [label="Des enfants chargés d'affronter des horreurs et de commettre des atrocités telles que celles dont j'en ai été témoin. Ils ont brisé des guerriers Orokins endurcis dont l'histoire s'étend sur des centaines d'années.",shape=box,color=blue];
		j3547642065 -> j286661893;
	j3889928439 [label="Les Tennos sont merveilleusement et magnifiquement humains, comme tout le monde. Simplement humains. Et de plus, ce sont des enfants.",shape=box,color=blue];
		j3889928439 -> j3547642065;
	j521306352 [label="J'y suis déjà, Usurpateur. J'y suis déjà.",shape=box,color=blue];
		j521306352 -> j155006797;
	j2892303404 [label="D'accord. Bien sûr. Vas-y. Je t'écoute.",shape=box,color=red];
		j2892303404 -> j3337965876;
	j749788098 [label="Non. J'en ai terminé.",shape=box,color=red];
		j749788098 -> j3384685775;
	j286661893 [label="J'ai vu des Dax, et je parle des Dax dorés, des Dax d'élite! laisser tomber leurs épées sacrées et dorées et fuir le champ de bataille où les Tennos s'étaient engagés avec leurs Warframes.",shape=box,color=blue];
		j286661893 -> j2090294289;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j3337965876 [label="+5 Chemistry",color=orange];
		j3337965876 -> j2009020642;
	j3384685775 [label="Et moi aussi.",shape=box,color=blue];
		j3384685775 -> "Chat ends.";
	j2090294289 [label="Leur cocon illusoire de refuge Infesté protégeait leurs corps, mais pas leurs esprits. Ils ne sont pas responsables de leur état.",shape=box,color=blue];
		j2090294289 -> j2633613457;
	j2009020642 [label="Merci. Le moment viendra, un jour terrible, où tu devras peut-être faire l'impensable.",shape=box,color=blue];
		j2009020642 -> j3889928439;
	j2633613457 [label="Tourmentés par le Néant… contraints de tuer ou d’assister à la mort de leurs propres parents… soumis à la guerre… privés de leurs souvenirs… plongés dans un sommeil cryogénique pendant des siècles…",shape=box,color=blue];
		j2633613457 -> j973490623;
	j973490623 [label="Qu'ils ne soient pas complètement fous furieux relève du miracle, Usurpateur. Je ne dis pas que cela va mal tourner. Je dis simplement que c'est possible. Et que tu dois absolument prévoir un plan de secours au cas où.",shape=box,color=blue];
		j973490623 -> j1112920256;
	j1112920256 [label="Il n'y a aucun mal à se préparer au pire. Ne pas le faire est extrêmement préjudiciable.",shape=box,color=blue];
		j1112920256 -> j1570539852;
		j1112920256 -> j1325912454;
		j1112920256 -> j3888114092;
		j1112920256 -> j2025962186;
	j1570539852 [label="Je vais… garder un œil sur la situation. D’accord? Mais je ne vais trahir personne.",shape=box,color=red];
		j1570539852 -> j159401311;
	j1325912454 [label="Je déteste vraiment être en quelque sorte d'accord avec toi sur ce point.",shape=box,color=red];
		j1325912454 -> j475738395;
	j3888114092 [label="Tu te rends compte que j'ai autant souffert que les Tennos, n'est-ce pas?",shape=box,color=red];
		j3888114092 -> j4226810211;
	j2025962186 [label="Je ne trahis pas leur confiance.",shape=box,color=red];
		j2025962186 -> j146610678;
	j159401311 [label="+5 Chemistry",color=orange];
		j159401311 -> j2186037370;
	j475738395 [label="+5 Chemistry",color=orange];
		j475738395 -> j1793068932;
	j4226810211 [label="Et qui peut dire que je n'ai pas les mêmes conversations avec eux, hein?",shape=box,color=blue];
		j4226810211 -> j803108080;
	j146610678 [label="Je ne te suggérais pas non plus de le faire.",shape=box,color=blue];
		j146610678 -> j346357367;
	j2186037370 [label="Bien sûr! C'est tout ce qu'un diable pouvait te demander, merci.",shape=box,color=blue];
		j2186037370 -> j346357367;
	j1793068932 [label="Mm. C'est simplement la sensation de retrouver tes esprits après toutes ces années. Tu t'y habitueras.",shape=box,color=blue];
		j1793068932 -> j321621700;
	j803108080 [label="Dors bien, Usurpateur. ",shape=box,color=blue];
		j803108080 -> j321621700;
	j346357367 [label="Add 1 to Thermostat counter",color=orange];
		j346357367 -> "Chat ends.";
	j321621700 [label="Add -1 to Thermostat counter",color=orange];
		j321621700 -> "Chat ends.";
}