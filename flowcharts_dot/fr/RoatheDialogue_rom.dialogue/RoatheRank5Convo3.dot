		j3317309044 -> j2969296509;
	j694488908 [label="Je suis contractuellement tenu de te pardonner, mais rien ne m'oblige à laisser ta tête en place. Je te conseille donc de peser tes mots à l'avenir.",shape=box,color=blue];
