	j4136927630 [label="Ah.",shape=box,color=blue];
		j4136927630 -> j161948280;
	j1444686916 [label="C'est naturel. Plus je suis contraint de passer du temps en leur présence, moins je les déteste. C'est exaspérant.",shape=box,color=blue];
		j1444686916 -> j513893962;
	j2117621827 [label="Pas vraiment! Je t'applaudirais si nous étions assis dans la même pièce, cher Voyageur. Tu as simplement tiré le meilleur parti de ta situation.",shape=box,color=blue];
		j2117621827 -> j2308059977;
	j537407509 [label="Oh? Et tu insinues que tu passes ce temps avec moi par… quoi? Par pure compassion? Ne me fais pas rire.",shape=box,color=blue];
