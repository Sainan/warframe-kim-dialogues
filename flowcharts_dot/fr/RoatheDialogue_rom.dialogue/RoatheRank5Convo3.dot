		j539253136 -> j3523265053;
	j1862308176 [label="En secret, tu es \"l'Indifférence\" et tu l'as toujours été?",shape=box,color=blue];
		j1862308176 -> j788096935;
	j279433626 [label="Tu accomplis ses desseins, réparant les familles brisées et les cœurs vides partout où tu vas. Si j'ignorais tes véritables sentiments, je croirais que tu te fais payer en chair. Ma chair, précisément.",shape=box,color=blue];
		j279433626 -> j3638201479;
	j1760774323 [label="Tu accomplis ses desseins, réparant les familles brisées et les cœurs vides partout où tu vas. Mais tu paies aussi de ta personne, n'est-ce pas? En chair. Ma chair.",shape=box,color=blue];
