	j3587237461 [label="Albrecht et son maigre petit majordome ont jugé bon de te confier une collection de jouets cassés. Des jouets cassés très attrayants.",shape=box,color=blue];
		j3587237461 -> j2532976414;
	j3141846034 [label="Savoir qu'ils peuvent t'avoir, mais que leur convoitise et leur égoïsme m'empêchent de goûter à la douceur d'une telle bonté?!",shape=box,color=blue];
