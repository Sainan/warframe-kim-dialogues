	j1585884216 [label="Je ne te blâme pas, cependant. J'ai des yeux. Même si je ne pense pas pouvoir sortir avec quelqu'un d'aussi fou que lui. J'apprécie pourtant le côté dangereux.",shape=box,color=blue];
		j1585884216 -> j79955214;
	j726083608 [label="Au début, si. ",shape=box,color=blue];
