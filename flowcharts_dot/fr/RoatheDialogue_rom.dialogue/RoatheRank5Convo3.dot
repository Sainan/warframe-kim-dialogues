		j1902988123 -> j2263344421;
	j421367490 [label="Oui. Je m'en rends compte, maintenant. Tu as vendu ton âme au diable en personne parce que… il tenait déjà ton cœur brisé entre ses mains sans le savoir.",shape=box,color=blue];
