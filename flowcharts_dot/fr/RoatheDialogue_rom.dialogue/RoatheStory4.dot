	j2211308165 [label="MV: ORGUEIL",shape=box,color=blue];
		j2211308165 -> j1308809853;
	j1308809853 [label="Transcription: nous ne nous attendions pas à perdre.",shape=box,color=blue];
		j1308809853 -> j2737644007;
	j2737644007 [label="Après le premier raid expéditionnaire des Sentients, nous avions préparé une contre-attaque punitive.",shape=box,color=blue];
		j2737644007 -> j3510900179;
	j3510900179 [label="L'Enchanteresse Verredoré émergea des brumes de Cérès sur des ailes mortelles, tel un galion chargé de drones et de myrmidons en armure d'argent.",shape=box,color=blue];
		j3510900179 -> j3097852839;
	j3097852839 [label="Des circuits, fins comme la brume, dessinaient une délicate dentelle sous leur blindage translucide.",shape=box,color=blue];
		j3097852839 -> j1833147755;
	j1833147755 [label="Elle était si immense qu'elle frôlait les bords du Rail Solaire.",shape=box,color=blue];
		j1833147755 -> j1089916846;
	j1089916846 [label="Les Sentients s'assurèrent d'avoir notre attention. Ils chantèrent et notre technologie faillit. Nos guerriers luttèrent et suffoquèrent dans leurs armures étincelantes.",shape=box,color=blue];
		j1089916846 -> j2523513582;
	j2523513582 [label="L'équipage de l'Enchanteresse Verredoré périt brûlé vif alors qu'elle plongeait sans moteur dans le ciel de Tau, un feu d'artifice complexe et coûteux.",shape=box,color=blue];
		j2523513582 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}