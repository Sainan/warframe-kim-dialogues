		j2445789688 -> j2417126828;
	j2417126828 [label="Vous savez à quel point elle peut être flagorneuse envers \"le Cardinal\". Je ne suis pas surpris que cela ait finalement dégénéré avec Tagfer.",shape=box,color=blue];
