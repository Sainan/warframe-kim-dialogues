	"Chat ends." [color=orange];
	j401196665 [label="Eh bien, je ne connais pas les détails précis. Je sais seulement que j'ai été appelé pour séparer Marie et Tagfer qui se disputaient violemment. ",shape=box,color=blue];
		j401196665 -> j1289088740;
	j1289088740 [label="Oiseau-3 était inconsolable et refusait de me dire la nature de la conversation, et Loid n'en fut pas témoin. Seul Fibonacci accepta de me dire que cela avait \"quelque chose à voir avec Entrati\".",shape=box,color=blue];
