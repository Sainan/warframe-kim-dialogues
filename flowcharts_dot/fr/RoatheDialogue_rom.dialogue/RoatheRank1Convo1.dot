	3 [label="Je dois vraiment te féliciter pour ton audace! Franchement, ne serais-tu pas un Orokin déguisé? Peut-être caches-tu ton aspect céruléen pour ne pas alerter les autres?!",shape=box,color=blue];
		3 -> 8;
		3 -> 9;
		3 -> 10;
	2349 [label="Update boolean RoatheResetEdgeCase",color=orange];
		2349 -> 2;
	2 [label="L'anomalie née du Néant. Le \"Voyageur\". L'Usurpateur. Enfin, nous parlons. Viens. Le Diable a une proposition à te faire...",shape=box,color=blue];
		2 -> 4;
		2 -> 5;
		2 -> 6;
		2 -> 7;
	8 [label="Bonjour, Roathe.",shape=box,color=red];
		8 -> 15;
	9 [label="De quoi m'accuses-tu, exactement?",shape=box,color=red];
		9 -> 16;
	10 [label="Pardon?",shape=box,color=red];
		10 -> 16;
	4 [label="Usurpateur?",shape=box,color=red];
		4 -> 11;
	5 [label="Quel genre de proposition?",shape=box,color=red];
		5 -> 12;
	6 [label="Quel genre de proposition le \"Diable de Tau\" pourrait-il bien me faire?",shape=box,color=red];
		6 -> 13;
	7 [label="Bonjour, Roathe.",shape=box,color=red];
		7 -> 14;
	15 [label="Ah, parfait! Tu connais donc mon nom! J'étais certain que tu l'avais oublié; tu avais l'air trop occupé à me massacrer à répétition!",shape=box,color=blue];
		15 -> 21;
	16 [label="N'as-tu vraiment rien de plus productif à faire?! Ou bien jouer sans cesse à \"Colle la corne sur le Yaznak\" est-il vraiment la meilleure façon d'utiliser ton temps?!",shape=box,color=blue];
		16 -> 21;
	11 [label="Update boolean RoatheUsurper",color=orange];
		11 -> 17;
	12 [label="Hum, pas de quoi s'inquiéter… ni se réjouir. Pas encore. Il s'agit simplement d'un accord professionnel entre deux personnes qui ont tout à gagner l'une de l'autre.",shape=box,color=blue];
		12 -> 14;
	13 [label="+5 Chemistry",color=orange];
		13 -> 18;
	14 [label="Écoute attentivement. Ces deux fanatiques ont été d'une platitude et d'une minutie insupportables dans leurs injures répétées à mon égard. J'attends de toi un comportement plus digne.",shape=box,color=blue];
		14 -> 19;
		14 -> 20;
	21 [label="J'ai beaucoup de mal à croire que tout cela – toute cette injustice que j'ai subie de ta part, toute cette destruction de mon psychisme – n'ait pas été purement motivée par la vengeance, à ta demande!",shape=box,color=blue];
		21 -> 26;
		21 -> 27;
		21 -> 28;
	17 [label="+5 Chemistry",color=orange];
		17 -> 22;
	18 [label="Je vois que ma réputation me précède. Tant mieux. Cela nous fera gagner du temps.",shape=box,color=blue];
		18 -> 23;
	19 [label="Tu n'as pas d'ordres à me donner.",shape=box,color=red];
		19 -> 24;
	20 [label="Je vais voir ce que je peux faire.",shape=box,color=red];
		20 -> 25;
	26 [label="Cela ne semblait pas être une priorité?",shape=box,color=red];
		26 -> 34;
	27 [label="Je... je n'ai tout simplement pas eu le temps de m'en occuper plus tôt.",shape=box,color=red];
		27 -> 35;
	28 [label="Tu ne t'en souviens pas... mais nous avons déjà vécu cela.",shape=box,color=red];
		28 -> 36;
	22 [label="Ah! C'est ce que tu es, non? Les Tennos ont volé le Système Origine aux Orokins. Et toi, tel un petit imposteur dans son nid, tu as réussi à t'infiltrer dans ce monde loin du tien.",shape=box,color=blue];
		22 -> 29;
	23 [label="Et il n'y a pas de quoi s'inquiéter… ni se réjouir. Pas encore. Il s'agit simplement d'un accord commercial entre deux personnes qui ont tout à gagner l'une de l'autre.",shape=box,color=blue];
		23 -> 14;
	24 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		24 -> 30 [label="x >= 21",color=purple];
		24 -> 31 [label="x >= 1",color=purple];
		24 -> 32 [label="x <= 0",color=purple];
		24 -> 32 [label="false",color=purple];
	25 [label="Veille à le faire.",shape=box,color=blue];
		25 -> 33;
	34 [label="Cela ne semblait pas...",shape=box,color=blue];
		34 -> 38;
	35 [label="Oh! Je suis vraiment désolé du dérangement, je n'avais pas réalisé que les créneaux horaires sur ton carnet de bal étaient déjà réservés!",shape=box,color=blue];
		35 -> 39;
	36 [label="+5 Chemistry",color=orange];
		36 -> 40;
	29 [label="Et cela fait de toi, à mes yeux, un usurpateur à au moins deux égards. (Et peut-être un troisième, si l'on tient compte de ce que le majordome m'a dit à propos de Duviri, mais c'est un débat pour une autre fois.)",shape=box,color=blue];
		29 -> 14;
	30 [label="Tu l'as dit à maintes reprises et de façon brutale, merci.",shape=box,color=blue];
		30 -> 33;
	31 [label="Tu l'as très clairement indiqué.",shape=box,color=blue];
		31 -> 33;
	32 [label="Nous verrons.",shape=box,color=blue];
		32 -> 33;
	33 [label="Alors voilà, l'affaire est simple, mon charmant, lubrique et vaporeux nouvel \"ami\".",shape=box,color=blue];
		33 -> 37;
	38 [label="Cela ne semblait pas être une priorité?!",shape=box,color=blue];
		38 -> 44;
	39 [label="Vraiment? Je suis stupéfait. Tes manières sont absolument abominables, Voyageur.",shape=box,color=blue];
		39 -> 45;
	40 [label="Pardon? Et comment se fait-il précisément que j’aie oublié que tu fouilles dans mes pensées comme dans un bol de Malium lors d’une fête de Naberus!",shape=box,color=blue];
		40 -> 46;
		40 -> 47;
	37 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		37 -> 41 [label="x >= 21",color=purple];
		37 -> 42 [label="x >= 1",color=purple];
		37 -> 43 [label="x <= 0",color=purple];
		37 -> 43 [label="false",color=purple];
	44 [label="As-tu l'habitude de te mêler des souvenirs des autres, de détruire leurs représentations, sans prendre la peine de les connaître d'abord?!",shape=box,color=blue];
		44 -> 50;
	45 [label="Mais je suppose qu'il n'y a plus rien à faire. Tu connais la vérité. Je me dévoile à toi, dans toute mon abjecte lâcheté.",shape=box,color=blue];
		45 -> 51;
	46 [label="En résumé, il y a... l'Infestation qui semble s'étendre aux sérums de Protoframe...",shape=box,color=red];
		46 -> 52;
	47 [label="Ah. Bon. Donc. J'ai la capacité de remonter le temps.",shape=box,color=red];
		47 -> 52;
	41 [label="Puisque tu as déjà semé le chaos dans mon esprit comme un ivrogne dans l'atelier d'un verrier, j'ai besoin de ton aide pour tenter de décrypter ce que tout cela signifie.",shape=box,color=blue];
		41 -> 48;
	42 [label="Ces deux fanatiques et toi avez déjà commencé à fouiner dans mon esprit comme un ivrogne dans l'atelier d'un verrier. J'ai besoin de ton aide pour décrypter tout cela.",shape=box,color=blue];
		42 -> 48;
	43 [label="Quand Albrecht m'a enfoncé la seringue dans le cou et m'a transformé en cette… chose, il a fait autre chose aussi. Les jeux entre Orokins, c'est une chose. Ça? C'est autre chose.",shape=box,color=blue];
		43 -> 49;
	50 [label="Tes manières sont absolument immondes!",shape=box,color=blue];
		50 -> 45;
	51 [label="Je suppose que tu es ici uniquement pour te moquer de moi. Je te prie de bien vouloir le faire maintenant afin que nous puissions passer à autre chose sans interruption.",shape=box,color=blue];
		51 -> 57;
	52 [label="Et je pensais que cela fonctionnait sur les Protoframes de 1999 grâce à la boucle de l'année elle-même, mais ce n'est pas le cas. ",shape=box,color=red];
		52 -> 58;
	48 [label="Non seulement j'ai besoin de ton aide pour retrouver la mémoire mais, pour couronner le tout, il semble que je sois incapable de trouver par moi-même les moyens d'en discerner la vérité!",shape=box,color=blue];
		48 -> 53;
		48 -> 54;
	49 [label="Il m'a volé une grande partie de mes souvenirs. Je vois cette petite chose... cette version de toi, courant partout avec ses amis Tennos traumatisés. Je vois ce que le Lotus l'aide à retrouver.",shape=box,color=blue];
		49 -> 55;
		49 -> 56;
	57 [label="Je préférerais ne pas avoir à supporter constamment cette chose dans mes pieds, comme un kubrow de cérémonie élevé par une diva.",shape=box,color=blue];
		57 -> 63;
		57 -> 64;
	58 [label="Je pense que c'est… plutôt lié à l'Infestation elle-même? Il y a une guitare qui parle et qui y a fait allusion. Et tu es arrivé ici via un Helminth, n'est-ce pas?",shape=box,color=red];
		58 -> 65;
	53 [label="Donc, tu dis que tu... as juste besoin de parler à quelqu'un?",shape=box,color=red];
		53 -> 59;
	54 [label="Je vais t'aider avec joie si je le peux, mais je ne sais pas vraiment comment.",shape=box,color=red];
		54 -> 60;
	55 [label="Alors… pourquoi ne vas-tu pas t'aventurer seul dans les Ténèbres Réfractaires?",shape=box,color=red];
		55 -> 61;
	56 [label="L'enfant n'est pas une \"chose\".",shape=box,color=red];
		56 -> 62;
	63 [label="Tu as fui. Mais beaucoup de gens fuient. Il s'agit d'affronter ce qui s'est passé.",shape=box,color=red];
		63 -> 69;
	64 [label="Je ne vais pas me moquer de toi. Tu as choisi de te battre un autre jour.",shape=box,color=red];
		64 -> 70;
	65 [label="Tu sembles étrangement hésiter au sujet de toute cette conversation, Voyageur. Surtout en ce qui concerne le contenu de mon crâne.",shape=box,color=blue];
		65 -> 71;
	59 [label="Oh, ne fais pas comme si j'avais simplement besoin de m'allonger sur un canapé et de parler de mes \"sentiments\".",shape=box,color=blue];
		59 -> 60;
	60 [label="J'ai besoin de quelqu'un pour faire fonctionner la machine à ma demande, car je suis actuellement incapable de le faire moi-même. ",shape=box,color=blue];
		60 -> 66;
	61 [label="Je le ferais moi-même, crois-moi, mais je ne peux pas! Ce satané sérum de Protoframe avec lequel Albrecht m'a empoisonné m'a privé de toute capacité à faire fonctionner cette maudite machine par moi-même!",shape=box,color=blue];
		61 -> 67;
	62 [label="Si, si, c'est exactement ça.",shape=box,color=blue];
		62 -> 68;
	69 [label="Add 1 to Thermostat",color=orange];
		69 -> 73;
	70 [label="Add -1 to Thermostat",color=orange];
		70 -> 74;
	71 [label="Et oui. Je suis bien arrivé ici grâce à un Helminth. Que j'ai créé et élevé moi-même, merci. Maintenant. Tu veux dire que tu as… effacé mes souvenirs?! De quoi? De nos conversations?! ",shape=box,color=blue];
		71 -> 75;
	66 [label="J'aurais également besoin de quelqu'un pour m'aider à consigner mes souvenirs et à les harmoniser. Une sorte d'assistant temporaire.",shape=box,color=blue];
		66 -> 72;
	67 [label="De plus, non seulement j'ai besoin de ton aide pour retrouver la mémoire mais, pour couronner le tout, il semble que je sois incapable de trouver par moi-même les moyens d'en discerner la vérité!",shape=box,color=blue];
		67 -> 53;
		67 -> 54;
	68 [label="Et je le ferais moi-même, crois-moi, mais je ne peux pas! Ce satané sérum de Protoframe avec lequel Albrecht m'a empoisonné m'a privé de toute capacité à faire fonctionner cette maudite machine par moi-même!",shape=box,color=blue];
		68 -> 67;
	73 [label="Fantastique. Encore une petite voix morose qui va me tourner autour des oreilles pour me dire que j'ai besoin d'introspection et de repentir?",shape=box,color=blue];
		73 -> 77;
	74 [label="+5 Chemistry",color=orange];
		74 -> 78;
	75 [label="Parce que j'ai, assurément, de très \"bons\" souvenirs de toi me réduisant en charpie pour ton propre divertissement sanglant. Quel est le sens de tout ça?",shape=box,color=blue];
		75 -> 79;
		75 -> 80;
	72 [label="En échange, je te promets solennellement de rester ici… paisiblement. Je ne représenterai aucune menace pour personne et je t'assure que j’en suis parfaitement capable. Je ne ferai aucun mal aux fanatiques, ni au majordome, ni aux animaux d’Albrecht corrompus par le Néant.",shape=box,color=blue];
		72 -> 76;
	77 [label="J'en ai de la chance.",shape=box,color=blue];
		77 -> 84;
	78 [label="Actuellement, j'ai l'impression de \"pourrir dans une crypte avec deux fanatiques idiots et de distribuer des babioles à des enfants traumatisés par la guerre\".",shape=box,color=blue];
		78 -> 85;
	79 [label="Je ne sais pas et je ne suis pas là pour continuer à me faire insulter par toi, Roathe. Je n'ai pas fait de boucle avec tout le monde juste pour me faire critiquer par toi.",shape=box,color=red];
		79 -> 5634;
	80 [label="Si je devine juste? Nos conversations ne sont pas profondes. Ce ne sont que des souvenirs superficiels. Ce que nous avons découvert dans ton passé faisait plutôt partie de tes souvenirs les plus fondamentaux, je suppose?",shape=box,color=red];
		80 -> 86;
	76 [label="Et plus important encore, je ne ferai aucun mal à la famille givrée d'Albrecht qui règne au-dessus de nous comme une flore mutante, sans se rendre compte de notre présence même.",shape=box,color=blue];
		76 -> 81;
		76 -> 82;
		76 -> 83;
	84 [label="Je compte bien continuer à m'occuper de mes affaires, Voyageur, mais le fait est que tu en sais trop sur mon passé et sur ce que j'ai fait. Et nous devrons simplement… coexister dans cet état.",shape=box,color=blue];
		84 -> 90;
	85 [label="Mais j'imagine que c'est ainsi que l'on appelle ça, maintenant.",shape=box,color=blue];
		85 -> 84;
	5634 [label="Yes. I could hazard a guess as to why you have summoned your Void-gifts to wipe our minds of recent events. How perfectly predictable.",shape=box,color=blue];
		5634 -> 91;
	86 [label="Fantastique. Absolument merveilleux. Je suis désormais entre les mains d'une personne complètement démente et capable d'effacer ma mémoire sur un simple caprice! C'est adorable.",shape=box,color=blue];
		86 -> 91;
	81 [label="Je croyais que c'était une proposition. Maintenant, tu me menaces?",shape=box,color=red];
		81 -> 87;
	82 [label="Roathe? Arrête et écoute une seconde.",shape=box,color=red];
		82 -> 88;
	83 [label="Que dois-je faire?",shape=box,color=red];
		83 -> 89;
	90 [label="Essaie de ne pas me mettre trop mal à l'aise et je te promets que j'essaierai d'en faire autant pour toi.",shape=box,color=blue];
		90 -> 97;
		90 -> 98;
	91 [label="Bon. Si ce que tu dis est vrai, et je suppose que cette histoire est suffisamment folle pour être réelle, je tenterai de ne pas t'en vouloir de connaître cette vérité profonde et terrible qui me concerne.",shape=box,color=blue];
		91 -> 99;
	87 [label="Tu n'as pas fait attention? Franchement, la compréhension écrite, de nos jours… Je ne te menaçais pas, Usurpateur. Je ne menaçais personne d'autre non plus.",shape=box,color=blue];
		87 -> 92;
	88 [label="Ça promet d'être grandiose. Vas-y, fais-toi plaisir; le théâtre est à toi.",shape=box,color=blue];
		88 -> 93;
		88 -> 94;
		88 -> 95;
	89 [label="Tu n'as pas fait attention? Franchement, la compréhension écrite, de nos jours… J'essaie de négocier avec toi, Usurpateur. J'ai du mal à croire que tu ne comprennes pas.",shape=box,color=blue];
		89 -> 96;
	97 [label="Non.",shape=box,color=red];
		97 -> 104;
	98 [label="Je pense que c'est juste.",shape=box,color=red];
		98 -> 105;
	99 [label="Je te prie toutefois – si tu me le permets – de bien vouloir te moquer une bonne fois pour toute, afin que nous puissions passer à autre chose sans interruption.",shape=box,color=blue];
		99 -> 57;
	92 [label="Je disais simplement que si nous arrivions à un point où je ne parviens pas à atteindre mes objectifs, je n'aurais plus aucune raison de rester silencieux.",shape=box,color=blue];
		92 -> 96;
	93 [label="C'est à cause de moi que Ballas est mort. Ne me force pas à libérer mon emploi du temps.",shape=box,color=red];
		93 -> 100;
	94 [label="Si tu veux mon aide, ce n'est pas la meilleure façon de l'obtenir.",shape=box,color=red];
		94 -> 101;
	95 [label="Je sais que nous n'avons pas beaucoup d'expérience l'un avec l'autre. Mais je suis là pour t'aider.",shape=box,color=red];
		95 -> 102;
	96 [label="Si ma proposition ne répond pas à tes attentes, puis-je l'améliorer un peu?",shape=box,color=blue];
		96 -> 103;
	104 [label="+5 Chemistry",color=orange];
		104 -> 108;
	105 [label="+15 Chemistry",color=orange];
		105 -> 109;
	100 [label="+5 Chemistry",color=orange];
		100 -> 106;
	101 [label="Et si tu veux la mienne, alors je suggère – comme je l'ai dit – que nous trouvions un accord.",shape=box,color=blue];
		101 -> 96;
	102 [label="Et alors? Ah, je vois. tu t'offusques de mon \"ton\", c'est bien ça? Je suis vraiment désolé. Je ne savais pas que tu étais si susceptible.",shape=box,color=blue];
		102 -> 96;
	103 [label="J'ai appris qu'il existe de nombreux sujets concernant Deimos pour lesquels mon aide pourrait être considérée non seulement possible, mais surtout, si j'ose dire, cruciale.",shape=box,color=blue];
		103 -> 107;
	108 [label="Ha! Je dois au moins respecter ton honnêteté.",shape=box,color=blue];
		108 -> 112;
	109 [label="Formidable. C'est bon de savoir qu'au moins, tu es... diplomate.",shape=box,color=blue];
		109 -> 112;
	106 [label="Si seulement tu avais pu m'entendre rire! Merci, Voyageur, d'être si agréable!",shape=box,color=blue];
		106 -> 110;
	107 [label="Y compris, mais sans s'y limiter, la réconciliation d'un majordome épris et de ladite famille éloignée qui vit à l'étage.",shape=box,color=blue];
		107 -> 111;
	112 [label="Update boolean RoatheKnowsReset",color=orange];
		112 -> 117;
	110 [label="Add -1 to Thermostat",color=orange];
		110 -> 113;
	111 [label="Une famille qui, comme je l'ai dit, ignore totalement notre présence ici-bas. Et qui ignore tout de la vie d'Albrecht, n'est-ce pas?",shape=box,color=blue];
		111 -> 114;
		111 -> 115;
		111 -> 116;
	117 [label="Au moins, ça sera intéressant.",shape=box,color=blue];
		117 -> 122;
	113 [label="Quel plaisir! Je pense que nous allons très bien nous entendre. C'était vraiment merveilleux.",shape=box,color=blue];
		113 -> 118;
	114 [label="Tu proposes d'aider à convaincre Loid de... parler à la famille Entrati?",shape=box,color=red];
		114 -> 119;
	115 [label="Je n'arrive pas à convaincre Loid d'intervenir. Il prétend que ce serait trop douloureux pour lui.",shape=box,color=red];
		115 -> 120;
	116 [label="Ils ignorent qu'Albrecht Entrati est toujours vivant, en effet.",shape=box,color=red];
		116 -> 121;
	122 [label="Chat ends.",color=orange];
	118 [label="Je pense que, pour cela, je vais te récompenser. Et rendre ce marché encore plus agréable pour toi. Une telle audace est rare.",shape=box,color=blue];
		118 -> 103;
	119 [label="Pas gratuitement, mon Usurpateur imprégné de Néant.",shape=box,color=blue];
		119 -> 123;
	120 [label="Tu ne peux pas. Mais je te le promets... moi, je peux.",shape=box,color=blue];
		120 -> 123;
	121 [label="Et tu n'as pas réussi à convaincre ce pauvre serviteur désespéré? Je te le promets... moi, je peux le faire.",shape=box,color=blue];
		121 -> 123;
	123 [label="Nous en arrivons donc enfin à ma proposition: aide-moi à démêler le problème de mes souvenirs manquants et à aller au fond des choses.",shape=box,color=blue];
		123 -> 124;
	124 [label="Et je veillerai à ce que notre pauvre serviteur, le cœur brisé, monte ces marches. Pendant ce temps, je resterai tranquillement assis… sans représenter aucun danger pour personne. Qu'en dis-tu? Marché conclu?",shape=box,color=blue];
		124 -> 125;
		124 -> 126;
	125 [label="Pas d'accord.",shape=box,color=red];
		125 -> 127;
	126 [label="D'accord.",shape=box,color=red];
		126 -> 128;
	127 [label="Comme tu veux. Mais attention:",shape=box,color=blue];
		127 -> 129;
	128 [label="+5 Chemistry",color=orange];
		128 -> 130;
	129 [label="Update boolean RoatheNoDeal",color=orange];
		129 -> 131;
	130 [label="Bien! Content de voir que tu n'es pas complètement imbécile. Comme on dit:",shape=box,color=blue];
		130 -> 132;
	131 [label="S'opposer au diable est pire que de composer avec lui.",shape=box,color=blue];
		131 -> 133;
	132 [label="Update boolean RoatheDeal",color=orange];
		132 -> 131;
	133 [label="Tu auras des regrets dans les deux cas, mais tu ne tireras profit que d'un seul.",shape=box,color=blue];
		133 -> 134;
	134 [label="Chat ends.",color=orange];
}