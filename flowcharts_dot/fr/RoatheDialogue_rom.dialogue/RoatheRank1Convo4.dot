digraph {
	"RoatheRank1Convo4 begins." [color=orange];
		"RoatheRank1Convo4 begins." -> j86368880;
	j86368880 [label="Check boolean LoidFamilyComplete",color=orange];
		j86368880 -> j1654913481 [label=true,color=green];
		j86368880 -> j273988873 [label=false,color=brown];
	j1654913481 [label="Le sort d'Euleria et de Petros est presque tragique. Nous n'avons jamais été amis, certes. Mais ils étaient tout de même Orokins. Et maintenant, nous ne sommes plus que quelques-uns. Je suppose que je devrais faire attention à mes paroles – qui sait ce que je pourrais devenir, avec le temps?",shape=box,color=blue];
		j1654913481 -> j3389642988;
	j273988873 [label="Je trouve ça assez hilarant qu'Euleria et Petros n'aient absolument aucune idée de notre présence ici. Comme des rats qui se faufilent sous leurs pieds. Comment avez-vous fait, toi et les enfants, pour garder le secret aussi longtemps?",shape=box,color=blue];
		j273988873 -> j348115237;
	j3389642988 [label="Celle dont la survie me surprend le moins, c'est \"Grand-mère\". (Imagine, se défaire d'un prénom aussi parfait que Dagath!)",shape=box,color=blue];
		j3389642988 -> j395408007;
		j3389642988 -> j2478427805;
	j348115237 [label="Evaluate expressions on HellStory counter",color=orange];
		j348115237 -> j2567131494 [label="x >= 21",color=purple];
		j348115237 -> j2441749455 [label="x < 21",color=purple];
		j348115237 -> j2441749455 [label="false",color=purple];
	j395408007 [label="Petros?",shape=box,color=red];
		j395408007 -> j3507265666;
	j2478427805 [label="Que penses-tu des enfants?",shape=box,color=red];
		j2478427805 -> j3356122633;
	j2567131494 [label="Honnêtement, je suis bien plus surpris que \"Grand-mère\" n'ait rien découvert. (Imagine, se défaire d'un nom aussi parfait que Dagath!) Je la croyais plus futée.",shape=box,color=blue];
		j2567131494 -> j2952799914;
	j2441749455 [label="Honnêtement, je suis bien plus surpris que \"Grand-mère\" n'ait rien découvert. (Imagine, se défaire d'un nom aussi parfait que Dagath!) Je la croyais plus futée.",shape=box,color=blue];
		j2441749455 -> j2164440474;
		j2441749455 -> j2853854440;
	j3507265666 [label="Hm? Ah. Le necraloid m'a informé que toi ou le gamin les avez aidés à se fabriquer de faux noms, vu qu'ils avaient oublié les leurs. Tu le connais sous le nom de \"Vilcor\".",shape=box,color=blue];
		j3507265666 -> j3527678934;
	j3356122633 [label="Ce garçon est capricieux, agaçant et égocentrique. Un Orokin typique. \"Kaelli\", comme elle préfère désormais qu’on l’appelle, est remarquablement intelligente et sa présence est presque supportable.",shape=box,color=blue];
		j3356122633 -> j3669779071;
	j2952799914 [label="C'est absurde. Je sais que nous avons déjà abordé ce sujet. Nous en avons déjà parlé. Ce qui me préoccupe encore profondément.",shape=box,color=blue];
		j2952799914 -> j2782860910;
	j2164440474 [label="Ils ont leurs propres... problèmes à régler.",shape=box,color=red];
		j2164440474 -> j1185426142;
	j2853854440 [label="Petros?",shape=box,color=red];
		j2853854440 -> j3688976473;
	j3527678934 [label="Mais je le connaissais sous le nom de Petros Vorten. Fier inventeur de la flotte Necramech. C'est étrange de penser au temps qui a passé pour lui et au peu de temps qui s'est écoulé – toutes proportions gardées – pour moi.",shape=box,color=blue];
		j3527678934 -> j3669779071;
	j3669779071 [label="Mais comment se fait-il que tu l'ignores? Tu te moques de moi, Usurpateur? Nous ne faisons certainement que… ressasser de vieilles histoires, en quelque sorte?",shape=box,color=blue];
		j3669779071 -> j139011919;
	j2782860910 [label="Evaluate expressions",color=orange];
		j2782860910 -> j3660589069 [label="RoatheDatingDeal",color=purple];
		j2782860910 -> j3660589069 [label="RoatheMarieDatingDeal",color=purple];
		j2782860910 -> j3660589069 [label="RoatheLyonDatingDeal",color=purple];
		j2782860910 -> j3660589069 [label="RoatheSerumDeal",color=purple];
		j2782860910 -> j433404292 [label="RoatheFamilyDeal",color=purple];
		j2782860910 -> j3660589069 [label="RoatheMarieEntratiDeal",color=purple];
		j2782860910 -> j3660589069 [label="RoatheLyonConfessionDeal",color=purple];
		j2782860910 -> j2904722141 [label="false",color=purple];
	j1185426142 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j1185426142 -> j1799339476 [label=true,color=green];
		j1185426142 -> j1194664916 [label=false,color=brown];
	j3688976473 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3688976473 -> j2287944717 [label=true,color=green];
		j3688976473 -> j3824864723 [label=false,color=brown];
	j139011919 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j139011919 -> j2426126099;
		j139011919 -> j2611341406;
		j139011919 -> j3597203161;
	j3660589069 [label="Me voilà, prêt à me lancer dans une digression sur la société Orokin, pensant que cela pourrait vaguement t'intéresser. Et puis je me souviens: ce n'est pas pour ça que tu es là, n'est-ce pas, Voyageur? Tu joues un autre jeu…",shape=box,color=blue];
		j3660589069 -> j139011919;
	j433404292 [label="Me voilà donc prêt à me lancer dans une digression sur la société Orokin, pensant que cela pourrait vaguement t'intéresser. Et puis je me souviens: tu as probablement déjà entendu tout cela, n'est-ce pas?",shape=box,color=blue];
		j433404292 -> j139011919;
	j2904722141 [label="Préfères-tu que je me prête au jeu? Ou… poursuis-tu un objectif précis en agissant ainsi? Je suis pour le moins perplexe quant à ce que tu espères obtenir en jouant à ce jeu cruel.",shape=box,color=blue];
		j2904722141 -> j2827449408;
	j1799339476 [label="Oui, j'ai eu des nouvelles par necraloid. Il semblerait qu'ils soient moins nombreux depuis que toi ou l'enfant avez tenté de les résoudre. Au moins, ils ne s'autodétruisent plus, au sens propre du terme.",shape=box,color=blue];
		j1799339476 -> j3572873736;
	j1194664916 [label="Check boolean RoatheSyndicateMaxRank",color=orange];
		j1194664916 -> j1799339476 [label=true,color=green];
		j1194664916 -> j3851192847 [label=false,color=brown];
	j2287944717 [label="Hm? Ah. Le necraloid m'a informé que toi ou l'enfant les avez aidés à se fabriquer de faux noms, vu qu'ils avaient oublié les leurs. Tu le connais sous le nom de \"Vilcor\". Mais moi, je le connaissais sous le nom de Petros Vorten. Fier concepteur de la flotte Necramech.",shape=box,color=blue];
		j2287944717 -> j3572873736;
	j3824864723 [label="Check boolean RoatheSyndicateMaxRank",color=orange];
		j3824864723 -> j2287944717 [label=true,color=green];
		j3824864723 -> j1649719486 [label=false,color=brown];
	j2426126099 [label="Non, je n'ai jamais entendu parler de ça. Je t'en prie, continue.",shape=box,color=red];
		j2426126099 -> j3003892737;
	j2611341406 [label="Je te parle, Roathe… parce que j’ai envie de te parler.",shape=box,color=red];
		j2611341406 -> j862518501;
	j3597203161 [label="Je l'ai déjà entendu parler de ça, oui. Mais s'il te plaît, raconte-moi quand même.",shape=box,color=red];
		j3597203161 -> j3569847119;
	j2827449408 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j2827449408 -> j2477186848;
	j3572873736 [label="Evaluate expressions",color=orange];
		j3572873736 -> j2459845403 [label="RoatheDeal",color=purple];
		j3572873736 -> j961101375 [label="RoatheNoDeal",color=purple];
		j3572873736 -> j961101375 [label="false",color=purple];
	j3851192847 [label="Oui, c'est ce que j'ai entendu. Il semblerait qu'ils soient toujours déterminés à s'autodétruire.",shape=box,color=blue];
		j3851192847 -> j3930011928;
	j1649719486 [label="Hum? Ah. Je le connaissais sous le nom de Petros Vorten. Fier inventeur de la flotte Necramech. Mais le necraloid m'a informé qu'ils avaient oublié leurs noms. Tu ne le connais peut-être encore que sous le nom de \"Père\".",shape=box,color=blue];
		j1649719486 -> j3930011928;
	j3003892737 [label="+5 Chemistry",color=orange];
		j3003892737 -> j3781921974;
	j862518501 [label="Check boolean DrifterRoathe",color=orange];
		j862518501 -> j3977679128 [label=true,color=green];
		j862518501 -> j515318291 [label=false,color=brown];
	j3569847119 [label="Tu admets donc que tu me fais perdre mon temps. Formidable! Je ne suis pas un vieux gâteux sénile, racontant une saga de guerre unique parce qu'il ne se souvient d'aucune autre.",shape=box,color=blue];
		j3569847119 -> j2299073868;
	j2477186848 [label="Me voilà donc prêt à me lancer dans une digression sur la société Orokin, pensant que cela pourrait vaguement t'intéresser. Et puis je me souviens: tu as probablement déjà entendu tout cela, n'est-ce pas?",shape=box,color=blue];
		j2477186848 -> j2426126099;
		j2477186848 -> j2611341406;
		j2477186848 -> j3597203161;
	j2459845403 [label="C'est tant mieux, car nous n'aurions guère avancé sans que toi ou l'enfant n'ayez franchi cette étape en premier. Le majordome aurait fini en pièces dès que nous l'aurions envoyé en haut.",shape=box,color=blue];
		j2459845403 -> j1831419187;
	j961101375 [label="Au fait, as-tu reconsidéré ma proposition? Que je me tienne tranquille, en échange de mon aide pour réconcilier le majordome et les Orokins abandonnés et Infestés qui vivent à l’étage?",shape=box,color=blue];
		j961101375 -> j3074333072;
		j961101375 -> j3718181457;
	j3930011928 [label="Evaluate expressions",color=orange];
		j3930011928 -> j3390119568 [label="RoatheDeal",color=purple];
		j3930011928 -> j196576620 [label="RoatheNoDeal",color=purple];
		j3930011928 -> j196576620 [label="false",color=purple];
	j3781921974 [label="Tu as donné la parole à un Orokin. Tu ne sais pas ce que tu as fait. Tu resteras ici une heure si tu n'y prends pas garde.",shape=box,color=blue];
		j3781921974 -> j3473092836;
	j3977679128 [label="+5 Chemistry",color=orange];
		j3977679128 -> j2820397207;
	j515318291 [label="Ah bon? Et dis-moi, pourquoi donc?",shape=box,color=blue];
		j515318291 -> j1042101613;
		j515318291 -> j3204758096;
		j515318291 -> j3445832259;
		j515318291 -> j3200242611;
	j2299073868 [label="La raison pour laquelle je ne me souviens pas de cette conversation se trouve dans ton maudit miroir!",shape=box,color=blue];
		j2299073868 -> "Chat ends.";
	j1831419187 [label="Il faut bien comprendre que le majordome et la famille Entrati, aussi éloignés soient-ils, restent des Orokins. Ils sont nés et ont été élevés au sein de cette société, avec ses... nombreux défauts.",shape=box,color=blue];
		j1831419187 -> j996870976;
	j3074333072 [label="Non, je ne change pas d'avis, Roathe. Ce n'est pas si important.",shape=box,color=red];
		j3074333072 -> j3692598188;
	j3718181457 [label="Oui. Je... suis d'accord.",shape=box,color=red];
		j3718181457 -> j1894736964;
	j3390119568 [label="Il serait peut-être judicieux de régler ce problème avant d'envisager d'envoyer le majordome en haut. De peur qu'il ne finisse en charpie.",shape=box,color=blue];
		j3390119568 -> j1831419187;
	j196576620 [label="Au fait, as-tu reconsidéré ma proposition? Que je me tienne tranquille, en échange de mon aide pour réconcilier le majordome et les Orokins abandonnés et Infestés qui vivent à l’étage? Réconcilier la famille serait un premier pas, mais…",shape=box,color=blue];
		j196576620 -> j3074333072;
		j196576620 -> j3718181457;
	j3473092836 [label="J'imagine que tu n'as pas eu beaucoup d'occasions d'interagir avec les Orokins, n'est-ce pas, Voyageur? L'enfant a vécu une vie bien différente.",shape=box,color=blue];
		j3473092836 -> j1720275338;
	j2820397207 [label="Mm. C'est exact. Et nous savons tous les deux pourquoi, n'est-ce pas? Mais tu vas faire preuve de patience.",shape=box,color=blue];
		j2820397207 -> j3109828640;
	j1042101613 [label="[Avouer vos sentiments.] Je pense que tu le sais.",shape=box,color=red];
		j1042101613 -> j2291531283;
	j3204758096 [label="Je te trouve intrigant.",shape=box,color=red];
		j3204758096 -> j4038553391;
	j3445832259 [label="Je n'ai jamais eu beaucoup d'occasions d'interagir avec un Orokin. Du moins, quand je ne les combattais pas. Tu es fascinant.",shape=box,color=red];
		j3445832259 -> j3990926326;
	j3200242611 [label="Laisse tomber. [Fin.]",shape=box,color=red];
		j3200242611 -> j2928117130;
	"Chat ends." [color=orange];
	j996870976 [label="Et malgré tous ses graves péchés, la hiérarchie et l'ordre n'ont jamais été remis en question. Ni au sein de l'armée, ni au sein de la société. Les Archimédiens obéissaient aux Orokins. Les Orokins obéissaient aux Exécuteurs. Les Exécuteurs obéissaient aux Empereurs… du moins en théorie.",shape=box,color=blue];
		j996870976 -> j4219831014;
	j3692598188 [label="Comme tu veux. Mais la porte ne restera pas longtemps ouverte.",shape=box,color=blue];
		j3692598188 -> "Chat ends.";
	j1894736964 [label="Boolean RoatheNoDeal is now false.",color=orange];
		j1894736964 -> j1878922150;
	j1720275338 [label="D'après ce que j'ai entendu, tu as changé de cap au moment de la tragédie du Zariman Ten Zero.",shape=box,color=blue];
		j1720275338 -> j3721952752;
		j1720275338 -> j1535509130;
		j1720275338 -> j4233192426;
	j3109828640 [label="En attendant, si tu souhaites \"écouter\", je me ferai un plaisir de te répondre. Sache simplement ceci: tu as demandé à un Orokin de parler.",shape=box,color=blue];
		j3109828640 -> j3066864962;
	j2291531283 [label="+5 Chemistry",color=orange];
		j2291531283 -> j2150981944;
	j4038553391 [label="+5 Chemistry",color=orange];
		j4038553391 -> j1518673544;
	j3990926326 [label="Connaître son ennemi, donc? Ou peut-être simplement la curiosité de se retrouver face à l'impossible? ",shape=box,color=blue];
		j3990926326 -> j2306362566;
	j2928117130 [label="Tu peux te tortiller autant que tu veux, petit poisson. Tu as nagé jusqu'à moi.",shape=box,color=blue];
		j2928117130 -> "Chat ends.";
	j4219831014 [label="Et même si tu doutes qu'après tout ce temps, les traditions puissent inciter Loid à m'écouter, considère que je peux être… profondément convaincant. Après tout, j'étais le bras droit du pire des Exécuteurs.",shape=box,color=blue];
		j4219831014 -> j2600694735;
		j4219831014 -> j2391661770;
		j4219831014 -> j2721637012;
	j1878922150 [label="Boolean RoatheDeal is now true.",color=orange];
		j1878922150 -> j3116209699;
	j3721952752 [label="Non. Je n'ai jamais vraiment eu affaire aux Orokins avant le Zariman – et après, eh bien… tu connais la suite, sans aucun doute.",shape=box,color=red];
		j3721952752 -> j409489413;
	j1535509130 [label="J'ai eu suffisamment affaire aux Orokins pour savoir qu'il ne faut absolument pas leur faire confiance.",shape=box,color=red];
		j1535509130 -> j1053415501;
	j4233192426 [label="Je n'ai pas plus d'amour pour les gens comme toi que le gamin, je regrette de te le dire.",shape=box,color=red];
		j4233192426 -> j1053415501;
	j3066864962 [label="Tu ne sais pas ce que tu as fait. Tu resteras ici une heure si tu n'y prends pas garde.",shape=box,color=blue];
		j3066864962 -> j3473092836;
	j2150981944 [label="Oui, en effet. Et dire que je croyais que tu allais me faire l'honneur de me l'écrire! Bon, tant pis…",shape=box,color=blue];
		j2150981944 -> j1806930714;
	j1518673544 [label="Ah bon? Hum. On verra combien de temps je pourrai garder ce poisson au bout du harpon, alors.",shape=box,color=blue];
		j1518673544 -> j3109828640;
	j2306362566 [label="+5 Chemistry",color=orange];
		j2306362566 -> j1246501752;
	j2600694735 [label="Le pire des Exécuteurs était Ballas.",shape=box,color=red];
		j2600694735 -> j871309368;
	j2391661770 [label="Lequel as-tu servi?",shape=box,color=red];
		j2391661770 -> j3317686772;
	j2721637012 [label="Comment ça?",shape=box,color=red];
		j2721637012 -> j380424667;
	j3116209699 [label="+5 Chemistry",color=orange];
		j3116209699 -> j3073029664;
	j409489413 [label="En effet. Ah, Ballas. Je vais peut-être te surprendre, mais il n'était pas le pire d'entre eux.",shape=box,color=blue];
		j409489413 -> j2159451290;
		j409489413 -> j302147155;
	j1053415501 [label="Je ne t'en veux pas non plus. Je pensais qu'on pouvait les sauver. Les fondre, en quelque sorte, les reformer, comme de l'or.",shape=box,color=blue];
		j1053415501 -> j3653187452;
	j1806930714 [label="Une autre fois, peut-être. Car toi aussi, Usurpateur, tu dois apprendre à savourer ces moments.",shape=box,color=blue];
		j1806930714 -> j90529070;
	j1246501752 [label="Respectable. Sage, même. Si j'avais eu l'occasion d'interroger et peut-être même de me lier d'amitié avec un Sentient, j'aurais fait de même. ",shape=box,color=blue];
		j1246501752 -> j3277529850;
	j871309368 [label="Je respecte ton opinion et je ne te la reproche pas. Ballas était un crétin et un champion parmi les dépravés, je ne te contredirai pas sur ce point.",shape=box,color=blue];
		j871309368 -> j676663162;
	j3317686772 [label="Evaluate expressions on HellStory counter",color=orange];
		j3317686772 -> j3886413640 [label="x >= 1",color=purple];
		j3317686772 -> j1887539396 [label="x <= 1",color=purple];
		j3317686772 -> j1887539396 [label="false",color=purple];
	j380424667 [label="Je comprends que tu as eu des relations personnelles avec Ballas et je ne te blâme pas de le considérer comme le pire des Sept Seigneurs Dorés. Il était un champion parmi les dépravés, je ne le contesterai pas.",shape=box,color=blue];
		j380424667 -> j3976376923;
	j3073029664 [label="Formidable! Je suis ravi que tu aies enfin compris. Nous pouvons enfin avancer.",shape=box,color=blue];
		j3073029664 -> j1831419187;
	j2159451290 [label="Vraiment?",shape=box,color=red];
		j2159451290 -> j3527465101;
	j302147155 [label="Tu auras bien du mal à me faire croire ça.",shape=box,color=red];
		j302147155 -> j3527465101;
	j3653187452 [label="Bon. À part les Exécuteurs. C'était une cause perdue. Je vais peut-être te surprendre, mais Ballas n'était pas le pire d'entre eux.",shape=box,color=blue];
		j3653187452 -> j302147155;
		j3653187452 -> j2159451290;
	j90529070 [label="Boolean DrifterRoathe is now true.",color=orange];
		j90529070 -> j3109828640;
	j3277529850 [label="Cela procure un avantage psychologique si jamais tu en croises un – ou même ton ancien allié – sur le champ de bataille.",shape=box,color=blue];
		j3277529850 -> j3578386444;
	j676663162 [label="Et, en réalité, je n'ai pas été témoin de l'horreur de cette affaire \"Narmer\" dont j'ai entendu parler par le majordome et dont j'ai pu glaner les enregistrements sur cette machine POM-2.",shape=box,color=blue];
		j676663162 -> j2933634687;
	j3886413640 [label="Tu m'as déjà entendu parler d'elle. Et, plus important encore, tu as eu un aperçu de nos projets. Mais ceci est une autre histoire. L'Exécutrice Nitokh. La Grande Régente Exécutrice Nitokh, pour être précis. Commandant de toutes nos forces militaires, la plus féroce et la plus impitoyable des Sept Seigneurs Dorés.",shape=box,color=blue];
		j3886413640 -> j2178188004;
	j1887539396 [label="L'Exécutrice Nitokh. La Grande Régente Exécutrice Nitokh, pour être précis. Commandant de toutes les forces militaires de l'Empire Orokin. Et la plus cruelle et la plus redoutable des Sept Seigneurs Dorés.",shape=box,color=blue];
		j1887539396 -> j2178188004;
	j3976376923 [label="Il est même tout à fait possible qu'il ait devancé les Exécuteurs d'antan pendant cette... affaire \"Narmer\" dont j'ai entendu parler par le majordome et dont j'ai pu lire les informations sur ce POM-2.",shape=box,color=blue];
		j3976376923 -> j2933634687;
	j3527465101 [label="Je ne dis pas que c'était un saint. Je dis simplement que le pire des démons était légèrement surpassé par ses pairs. Je ne fais que pinailler, Usurpateur.",shape=box,color=blue];
		j3527465101 -> j2886206165;
	j3578386444 [label="Bien, si tu souhaites \"écouter\", je me ferai un plaisir de te répondre. Sache simplement ceci: tu as demandé à un Orokin de parler.",shape=box,color=blue];
		j3578386444 -> j3066864962;
	j2933634687 [label="Cependant, je suggérerais également que cette impression est due à ta proximité très personnelle avec Ballas et à tes interactions très limitées avec les six autres Seigneurs Dorés.",shape=box,color=blue];
		j2933634687 -> j2178188004;
	j2178188004 [label="Les Sept Dorés. Bah. Tu sais ce qu'il y a de mieux avec l'or, Voyageur? On peut le fondre à l'infini et le transformer en quelque chose de mieux.",shape=box,color=blue];
		j2178188004 -> j3303664873;
	j2886206165 [label="Mais Ballas était-il le pire? À tes yeux, peut-être. Et peut-être même que ses crimes à cette époque ont surpassé ceux des anciens Exécuteurs.",shape=box,color=blue];
		j2886206165 -> j2984294719;
	j3303664873 [label="Je croyais – et d'une certaine manière, je le crois encore – que les Orokins auraient pu être sauvés. Que nous aurions pu redresser l'Empire. Mais les Exécuteurs? Non. Il fallait les arrêter. Ils représentaient ce que l'humanité avait de pire à offrir, à des degrés divers.",shape=box,color=blue];
		j3303664873 -> j72128866;
	j2984294719 [label="Mais si tu avais contemplé les lacs rouges et les champs de cadavres courbés et démembrés, comme autant de jouets abandonnés -",shape=box,color=blue];
		j2984294719 -> j2357938469;
	j72128866 [label="Et c'est moi, Usurpateur, qui te le dis. Tu me permettras donc à moi, le Diable de Tau en personne, de t'assurer – en tant que connaisseur – que Ballas n'était pas le pire d'entre eux.",shape=box,color=blue];
		j72128866 -> j581353866;
	j2357938469 [label="Si tu avais vu la pure dévastation que Nitokh pouvait causer en un instant... ",shape=box,color=blue];
		j2357938469 -> j2371276142;
	j581353866 [label="Check boolean RoatheUsurper",color=orange];
		j581353866 -> j3827435906 [label=true,color=green];
		j581353866 -> j1334193229 [label=true,color=green];
		j581353866 -> j75655870 [label=false,color=brown];
		j581353866 -> j3827435906 [label=false,color=brown];
		j581353866 -> j1334193229 [label=false,color=brown];
	j2371276142 [label="Mais de telles horreurs sont difficiles à ressentir quand on n'en est pas témoin. Une telle tragédie ne se mesure pas en chiffres. Je pourrais m'étendre longuement sur ce que j'ai vu, mais pour toi, ce ne seront que des histoires.",shape=box,color=blue];
		j2371276142 -> j4098237070;
	j3827435906 [label="Tu auras bien du mal à me faire croire ça.",shape=box,color=red];
		j3827435906 -> j3180293832;
	j1334193229 [label="Vraiment?",shape=box,color=red];
		j1334193229 -> j3180293832;
	j75655870 [label="Pourquoi m'appelles-tu \"Usurpateur\"?",shape=box,color=red];
		j75655870 -> j61140433;
	j4098237070 [label="Pour toi, Ballas restera toujours le scélérat le plus présent et le plus terrifiant. Et c'est tout à fait normal.",shape=box,color=blue];
		j4098237070 -> j3176313101;
	j3180293832 [label="Si tu avais contemplé les lacs rouges et les champs de cadavres courbés et démembrés, comme autant de jouets abandonnés -",shape=box,color=blue];
		j3180293832 -> j2357938469;
	j61140433 [label="Ah! C'est ce que tu es, non? Les Tennos ont volé le Système Origine aux Orokins. Et toi, tel un petit imposteur dans son nid, tu as réussi à t'infiltrer dans ce monde loin du tien.",shape=box,color=blue];
		j61140433 -> j3496388014;
	j3176313101 [label="Mais tu ignores beaucoup de choses à son sujet. On a déjà beaucoup parlé de ce crétin. Et il reste encore beaucoup à dire, je le crains.",shape=box,color=blue];
		j3176313101 -> j3472701481;
		j3176313101 -> j2738479610;
	j3496388014 [label="Et cela fait de toi, à mes yeux, un usurpateur à au moins deux égards. (Et peut-être un troisième, si l'on tient compte de ce que le majordome m'a dit à propos de Duviri, mais c'est un débat pour une autre fois.)",shape=box,color=blue];
		j3496388014 -> j670745195;
	j3472701481 [label="Comme quoi?",shape=box,color=red];
		j3472701481 -> j2734867793;
	j2738479610 [label="La vie de Ballas ne m'intéresse pas.",shape=box,color=red];
		j2738479610 -> j3029878817;
	j670745195 [label="Ne me distrais pas, Usurpateur. Je comprends que tu as du mal à me croire, mais si tu avais contemplé les lacs rouges et les champs de cadavres courbés et démembrés, comme autant de jouets abandonnés -",shape=box,color=blue];
		j670745195 -> j1932251135;
	j2734867793 [label="Boolean RoatheBallas1 is now true.",color=orange];
		j2734867793 -> j1858822547;
	j3029878817 [label="Mm, oui. Bon, je suppose que tu vas devoir te contenter d'écouter les récits de ma vie. Que c'est drôle!",shape=box,color=blue];
		j3029878817 -> j3729401473;
	j1932251135 [label="Boolean RoatheUsurper is now true.",color=orange];
		j1932251135 -> j2357938469;
	j1858822547 [label="C'est une… très longue histoire. Une histoire que je n'ai pas le temps de raconter pour le moment. Le majordome rôde. Et je déteste être surveillé de la sorte.",shape=box,color=blue];
		j1858822547 -> j1154975307;
	j3729401473 [label="+5 Chemistry",color=orange];
		j3729401473 -> j3609953677;
	j1154975307 [label="C'est très impoli.",shape=box,color=blue];
		j1154975307 -> j594665947;
	j3609953677 [label="Nous nous reparlerons bientôt.",shape=box,color=blue];
		j3609953677 -> "Chat ends.";
	j594665947 [label="+15 Chemistry",color=orange];
		j594665947 -> j3609953677;
