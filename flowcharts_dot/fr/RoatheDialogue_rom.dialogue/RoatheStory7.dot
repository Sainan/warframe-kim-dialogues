		j343012003 -> j93836790;
	j93836790 [label="Transcription: parmi les Sept, j’étais, du moins c’est ce qu’on m’a dit, considéré comme le jouet et le concubin de Nitokh.",shape=box,color=blue];
		j93836790 -> j535608624;
	j535608624 [label="Au début de la guerre, on me nomma Vice-Régent Grand Carnus pour la provoquer, une sorte de plaisanterie.",shape=box,color=blue];
		j535608624 -> j4112179904;
	j4112179904 [label="Leurs rires se muèrent vite en applaudissements solennels lorsque je rapportai la nouvelle d'une victoire après l'autre.",shape=box,color=blue];
		j4112179904 -> j2759535206;
	j2759535206 [label="Le sang d'hommes si valeureux me maculait comme des médailles. En secret, j'amassais des armes pour Nitokh.",shape=box,color=blue];
		j2759535206 -> j279559708;
	j279559708 [label="C'était facile. J'étais une figure trop glorieuse pour être soupçonnée.",shape=box,color=blue];
		j279559708 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
