	j2534766786 [label="MV: OROKIN",shape=box,color=blue];
		j2534766786 -> j1739987729;
	j1739987729 [label="Transcription: pendant si longtemps, l’Empire Orokin n’eut aucun ennemi. Son armée n’existait que pour régler de mesquines querelles, maison contre maison, Exécuteur contre Exécuteur.",shape=box,color=blue];
		j1739987729 -> j2902132630;
	j2902132630 [label="Lorsque les Sentients attaquèrent, nous fûmes unis, une unité qui nous avait longtemps fait défaut. Les Dax dégainèrent leurs épées contre autre chose qu'un paysan insolent ou un marchand malhonnête.",shape=box,color=blue];
		j2902132630 -> j2081738578;
	j2081738578 [label="Les Empereurs, les souverains immortels de l'Empire dont le pouvoir était dévolu aux Exécuteurs, s'éveillèrent en titubant sur leurs trônes dorés poussiéreux.",shape=box,color=blue];
		j2081738578 -> j3466327555;
	j3466327555 [label="La guerre, la magnifique guerre! Enfin, l'Empire avait un sens. Confrontés à une extinction plus imminente que la mort du soleil, nous avons goûté à la source même de la vie.",shape=box,color=blue];
		j3466327555 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}