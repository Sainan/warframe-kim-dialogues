	2150 [label="Transcription: pendant si longtemps, l’Empire Orokin n’eut aucun ennemi. Son armée n’existait que pour régler de mesquines querelles, maison contre maison, Exécuteur contre Exécuteur.",shape=box,color=blue];
		2150 -> 2153;
	2153 [label="Lorsque les Sentients attaquèrent, nous fûmes unis, une unité qui nous avait longtemps fait défaut. Les Dax dégainèrent leurs épées contre autre chose qu'un paysan insolent ou un marchand malhonnête.",shape=box,color=blue];
		2153 -> 2154;
	2154 [label="Les Empereurs, les souverains immortels de l'Empire dont le pouvoir était dévolu aux Exécuteurs, s'éveillèrent en titubant sur leurs trônes dorés poussiéreux.",shape=box,color=blue];
		2154 -> 5683;
	5683 [label="La guerre, la magnifique guerre! Enfin, l'Empire avait un sens. Confrontés à une extinction plus imminente que la mort du soleil, nous avons goûté à la source même de la vie.",shape=box,color=blue];
