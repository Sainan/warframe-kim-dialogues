digraph {
	1781 [label="RoatheRank3Convo3 begins.",color=orange];
		1781 -> 1782;
	1782 [label="Evaluate expressions on HellStory",color=orange];
		1782 -> 1786 [label="x >= 21",color=purple];
		1782 -> 1785 [label="x >= 13",color=purple];
		1782 -> 1784 [label="x < 13 && x > 1",color=purple];
		1782 -> 1783 [label="x == 0",color=purple];
		1782 -> 1783 [label="false",color=purple];
	1786 [label="Cela me tourmente jour et nuit. Cette sensation lancinante que non seulement je t'ai confié tous mes secrets les plus intimes, mais que tu as trahi cette confiance et tout pris et que maintenant, je ne me souviens plus pourquoi…",shape=box,color=blue];
		1786 -> 1793;
	1785 [label="Nous progressons bien pour lever ces blocages dans mon esprit. Albrecht m'a joué un sacré tour en m'injectant ce sérum.",shape=box,color=blue];
		1785 -> 1791;
		1785 -> 1792;
		1785 -> 1790;
	1784 [label="Tes progrès pour m'aider à retrouver mes souvenirs sont insuffisants. Si tu souhaites tenir ton engagement, je m'attends à ce que tu poursuives ton travail dans La Descendia.",shape=box,color=blue];
		1784 -> 1789;
		1784 -> 1787;
		1784 -> 1788;
		1784 -> 1790;
	1783 [label="Tu n'as encore fait aucun progrès dans La Descendia pour découvrir mes souvenirs. Si tu veux que je tienne ma promesse, tu devras t'efforcer de tenir la tienne.",shape=box,color=blue];
		1783 -> 1787;
		1783 -> 1788;
		1783 -> 1789;
		1783 -> 1790;
	1793 [label="Check boolean RoatheResetForgiven",color=orange];
		1793 -> 1801 [label=true,color=green];
		1793 -> 1800 [label=false,color=brown];
	1791 [label="Ces souvenirs n'ont pas l'air agréables. ",shape=box,color=red];
		1791 -> 1798;
	1792 [label="Ces souvenirs n'ont pas l'air agréables. Tu es sûr que nous devrions continuer?",shape=box,color=red];
		1792 -> 1799;
	1790 [label="[Fin.]",shape=box,color=red];
		1790 -> 1797;
	1789 [label="Honnêtement, j'ai un peu de mal... Je n'arrête pas de mourir, peu importe mes efforts.",shape=box,color=red];
		1789 -> 1796;
	1787 [label="Tu n'as pas d'ordres à me donner, Roathe.",shape=box,color=red];
		1787 -> 1794;
	1788 [label="J'avais à faire. Je m'en occuperai.",shape=box,color=red];
		1788 -> 1795;
	1801 [label="Non seulement je t'ai pardonné de m'avoir volé ces souvenirs...",shape=box,color=blue];
		1801 -> 1807;
	1800 [label="Non seulement je commence à te pardonner de m'avoir volé ces souvenirs...",shape=box,color=blue];
		1800 -> 1807;
	1798 [label="Non. Certes. Qu'attends-tu du \"Diable de Tau\", des souvenirs d'un après-midi ensoleillé au parc, allongé sur une couverture à manger des raisins sur un plateau?",shape=box,color=blue];
		1798 -> 1805;
	1799 [label="Je ne saurai ce qu'il m'a pris que lorsque je les aurai récupérés. Bien sûr, qu'il faut continuer! Ces souvenirs sont à moi, Voyageur. Ils définissent qui je suis, qui j'étais. Ils sont l'essence même de mon être.",shape=box,color=blue];
		1799 -> 1806;
	1797 [label="Chat ends.",color=orange];
	1796 [label="Update boolean RoatheStrugglebus",color=orange];
		1796 -> 1804;
	1794 [label="Non, en effet. Et ce que tu fais de ta journée ne me regarde pas. Je dis simplement que si tu veux que ce pauvre petit majordome maigrelet monte ces escaliers, tu as du travail à faire.",shape=box,color=blue];
		1794 -> 1802;
	1795 [label="Veilles-y. Ce que tu fais de ta journée ne me regarde pas. Je dis simplement que si tu veux que ce pauvre petit majordome maigrelet monte ces escaliers, tu as du travail à faire.",shape=box,color=blue];
		1795 -> 1803;
	1807 [label="Mais je commence à avoir envie de te faire confiance à nouveau. Encore une fois! Sachant parfaitement ce que tu as fait. Sachant que tu es capable de me trahir une fois de plus!",shape=box,color=blue];
		1807 -> 1815;
	1805 [label="Mon pauvre Usurpateur, je crains que ce que nous allons trouver enfoui dans les annales de mon esprit ne soit que sang, carnage et échec.",shape=box,color=blue];
		1805 -> 1811;
		1805 -> 1812;
	1806 [label="D'après ce que j'ai compris des autres concernant ton séjour à Duviri, tu en as souffert toi aussi, n'est-ce pas?",shape=box,color=blue];
		1806 -> 1813;
		1806 -> 1814;
	1804 [label="Je n'entends parler que de tes victoires contre les Narmers, de tes triomphes sur des hordes de soldats Grineers, de tes succès sur des vagues de Murmures à tout bout de champ. Et pourtant, je réussis à te poser problème?",shape=box,color=blue];
		1804 -> 1810;
	1802 [label="Si ça ne t'intéresse pas, alors ça ne m'intéresse pas non plus. J'ai mes propres affaires à régler.",shape=box,color=blue];
		1802 -> 1808;
	1803 [label="Si ça ne t'intéresse pas, alors ça ne m'intéresse pas non plus. J'ai mes propres affaires à régler.",shape=box,color=blue];
		1803 -> 1809;
	1815 [label="Mais je me retrouve assis dans cette crypte, je me lève de ma chaise et je me dis: \"Je me demande si le Voyageur est dans les parages et souhaite parler.\"",shape=box,color=blue];
		1815 -> 1822;
	1811 [label="Tu es aux commandes de ce vaisseau. Si tu veux continuer à le précipiter dans le trou noir, fonce à toute vitesse!",shape=box,color=red];
		1811 -> 1818;
	1812 [label="Tu es sûr de vouloir continuer, alors?",shape=box,color=red];
		1812 -> 1819;
	1813 [label="Nous sommes des personnes très différentes, Roathe.",shape=box,color=red];
		1813 -> 1820;
	1814 [label="Oui. Souvenirs et apathie. Je ne me souviens toujours pas… de périodes entières, là-bas.",shape=box,color=red];
		1814 -> 1821;
	1810 [label="+20 Chemistry",color=orange];
		1810 -> 1817;
	1808 [label="Chat ends.",color=orange];
	1809 [label="+10 Chemistry",color=orange];
		1809 -> 1816;
	1822 [label="N'est-ce pas tout simplement pathétique? À quel point suis-je tombé bas? Moi?! Un Orokin?! Roathe! Le Diable de Tau! Tellement agité, tellement en manque d'inspiration, tellement désespéré de trouver la moindre stimulation que j'en suis réduit à te parler!",shape=box,color=blue];
		1822 -> 1831;
		1822 -> 1830;
		1822 -> 1829;
		1822 -> 1828;
	1818 [label="+10 Chemistry",color=orange];
		1818 -> 1824;
	1819 [label="Je ne saurai ce qu'il m'a pris que lorsque je les aurai récupérés. Bien sûr, qu'il faut continuer! Ces souvenirs sont à moi, Voyageur. Ils définissent qui je suis, qui j'étais. Ils sont l'essence même de mon être.",shape=box,color=blue];
		1819 -> 1825;
		1819 -> 1826;
	1820 [label="C'est possible, mais ce n'était pas vraiment mon propos. Ce que tu refuses d'admettre. Soit. Si, en théorie, tu avais perdu la mémoire, chercherais-tu à la retrouver si tu le pouvais?",shape=box,color=blue];
		1820 -> 1825;
		1820 -> 1826;
	1821 [label="Si tu avais la possibilité de retrouver tes souvenirs perdus, le ferais-tu?",shape=box,color=blue];
		1821 -> 1827;
		1821 -> 1825;
		1821 -> 1826;
	1817 [label="Si tu ne me mens pas, j'avoue que c'est plutôt flatteur. Adorable. Extrêmement triste. Mais flatteur.",shape=box,color=blue];
		1817 -> 1823;
	1816 [label="Chat ends.",color=orange];
	1831 [label="J'aime nos conversations, que ce soit le cas pour toi ou pas.",shape=box,color=red];
		1831 -> 1838;
	1830 [label="Je vais essayer de ne pas le prendre personnellement.",shape=box,color=red];
		1830 -> 1837;
	1829 [label="Ou alors, tu aimes simplement discuter avec moi?",shape=box,color=red];
		1829 -> 1836;
	1828 [label="[Fin.]",shape=box,color=red];
		1828 -> 1835;
	1824 [label="Bien dit, Voyageur. Je ne réaliserai l'ampleur de ce qui m'a été enlevé que lorsque je l'aurai retrouvé. Ces souvenirs constituent ce que je suis, ce que j'étais. Ils sont l'essence même de mon être.",shape=box,color=blue];
		1824 -> 1827;
		1824 -> 1825;
		1824 -> 1826;
	1825 [label="Je pense qu'il vaut mieux savoir que de ne pas savoir, mais... nous devons nous y préparer.",shape=box,color=red];
		1825 -> 1832;
	1826 [label="Parfois, je me dis que certaines choses devraient rester enterrées pour une bonne raison.",shape=box,color=red];
		1826 -> 1833;
	1827 [label="Ils sont à toi. Il est temps d'aller les chercher. Qu'est-ce que ça peut faire de mal? Tu es un Orokin, tu as fait bien pire, c'est certain.",shape=box,color=red];
		1827 -> 1834;
	1823 [label="Chat ends.",color=orange];
	1838 [label="Alors, je suis terriblement content de ne pas avoir été réduit à l'état d'idiot baveux quand tu as fouillé mon crâne avec une fourchette.",shape=box,color=blue];
		1838 -> 1842;
	1837 [label="Peut-être que tu le devrais. Après tout, c'est toi qui as fouillé dans mon crâne avec une fourchette.",shape=box,color=blue];
		1837 -> 1842;
	1836 [label="Peut-être que ce serait le cas, si je ne savais pas que tu as fouillé dans mon crâne avec une fourchette.",shape=box,color=blue];
		1836 -> 1842;
	1835 [label="Chat ends.",color=orange];
	1832 [label="Préparés, précisément, comment? Crois-tu que je vais m'effondrer comme un fragile château de cartes une fois que j'aurai appris l'horrible vérité sur quelque crime de guerre grotesque?",shape=box,color=blue];
		1832 -> 1839;
	1833 [label="Ne sommes-nous pas alors condamnés à répéter nos erreurs passées? À ne jamais apprendre, à ne jamais évoluer, à vivre à jamais dans une ignorance béate de ce que nous étions?",shape=box,color=blue];
		1833 -> 1840;
	1834 [label="+10 Chemistry",color=orange];
		1834 -> 1841;
	1842 [label="Check boolean RoatheResetForgiven",color=orange];
		1842 -> 1846 [label=true,color=green];
		1842 -> 1847 [label=false,color=brown];
	1839 [label="Crois-moi, je peux imaginer tout ce que j'ai pu faire aux Sentients, aux Orokins, ou à toute combinaison des deux et il y a peu de choses qui pourraient me choquer ou m'horrifier.",shape=box,color=blue];
		1839 -> 1843;
	1840 [label="Hum. Je me rends compte que pour la plupart des gens, j'ai probablement contredit mon propre raisonnement.",shape=box,color=blue];
		1840 -> 1844;
	1841 [label="Voilà! Je ne m'effondrerai certainement pas comme un fragile château de cartes une fois que j'aurai appris la terrible vérité sur quelque crime de guerre grotesque.",shape=box,color=blue];
		1841 -> 1845;
	1846 [label="Je t'ai dit que je te pardonnais. Et je m'efforce de tenir ma parole. Simplement, les mots ne suffisent pas toujours à faire la vérité. Et dire qu'on pardonne à quelqu'un, c'est bien beau en théorie, mais parfois les émotions ont du mal à suivre les mots.",shape=box,color=blue];
		1846 -> 1851;
		1846 -> 1852;
	1847 [label="Franchement, tout ça est assez irritant. J'ai envie de discuter avec toi. Mais j'ai aussi envie de t'étrangler pour avoir perverti mon esprit.",shape=box,color=blue];
		1847 -> 1853;
		1847 -> 1854;
	1843 [label="Add 1 to Thermostat",color=orange];
		1843 -> 1848;
	1844 [label="Add -1 to Thermostat",color=orange];
		1844 -> 1849;
	1845 [label="Add -2 to Thermostat",color=orange];
		1845 -> 1850;
	1851 [label="Je comprends. C'est difficile à accepter. Tu le souhaites peut-être, mais tu ne peux pas.",shape=box,color=red];
		1851 -> 1857;
	1852 [label="Alors, tu... ne me pardonnes pas?",shape=box,color=red];
		1852 -> 1857;
	1853 [label="Tu vas devoir accepter ce qui s'est passé et tourner la page, Roathe.",shape=box,color=red];
		1853 -> 1858;
	1854 [label="Penses-tu pouvoir me pardonner un jour?",shape=box,color=red];
		1854 -> 1859;
	1848 [label="Je me souviens suffisamment pour savoir que je pourrais demander \"pardon\" à l'autel des Luminaires pendant les deux mille prochaines années et ne jamais l'obtenir. ",shape=box,color=blue];
		1848 -> 1855;
	1849 [label="Je préférerais connaître tous les faits moi-même et juger la situation à partir de là.",shape=box,color=blue];
		1849 -> 1855;
	1850 [label="Je peux imaginer tout ce que j'ai pu faire aux Sentients, aux Orokins, ou à toute combinaison des deux et il y a peu de choses qui pourraient me choquer ou m'horrifier.",shape=box,color=blue];
		1850 -> 1856;
	1857 [label="Je fais de mon mieux, vraiment, Usurpateur. Car il y a quelque chose en toi qui a captivé mon attention. Tu as quelque chose de fascinant. Et c'est rare, dans mon monde.",shape=box,color=blue];
		1857 -> 1862;
	1858 [label="Mmhm.",shape=box,color=blue];
		1858 -> 1863;
	1859 [label="Update boolean RoatheResetForgiven",color=orange];
		1859 -> 1857;
	1855 [label="Non, ce qui m'attend au fond de mon esprit ne me fait pas peur. Je souhaite simplement récupérer ce qui m'a été pris injustement.",shape=box,color=blue];
		1855 -> 1860;
	1856 [label="Non, ce qui m'attend au fond de mon esprit ne me fait pas peur. Je souhaite simplement récupérer ce qui m'a été pris injustement.",shape=box,color=blue];
		1856 -> 1861;
	1862 [label="Alors, aie de la patience avec moi, si c'est possible, pendant que j'essaie de concilier tout cela.",shape=box,color=blue];
		1862 -> 1866;
