digraph {
	2564 [label="RoatheRank4Convo4 begins.",color=orange];
		2564 -> 2565;
	2565 [label="J'ai une question philosophique à te poser, Usurpateur. Et avant de tirer des conclusions hâtives sur l'identité de la personne à laquelle je fais référence, moi-même, Ballas, ou que Dieu nous en préserve Albrecht, il s'agit d'une simple expérience de pensée. On joue?",shape=box,color=blue];
		2565 -> 2566;
		2565 -> 2567;
		2565 -> 2568;
	2566 [label="Maintenant, tu m'intrigues.",shape=box,color=red];
		2566 -> 2569;
	2567 [label="Bien sûr. Vas-y.",shape=box,color=red];
		2567 -> 2570;
	2568 [label="Je ne suis pas d'humeur. [Fin.]",shape=box,color=red];
		2568 -> 2571;
	2569 [label="+5 Chemistry",color=orange];
		2569 -> 2572;
	2570 [label="La question est simple, mais vaste: crois-tu que tout le monde mérite d'être aimé?",shape=box,color=blue];
		2570 -> 2573;
	2571 [label="Dommage.",shape=box,color=blue];
		2571 -> 2574;
	2572 [label="Bien! La question est simple, mais vaste: crois-tu que tout le monde mérite d'être aimé?",shape=box,color=blue];
		2572 -> 2573;
	2573 [label="Evaluate expressions",color=orange];
		2573 -> 2575 [label="RoatheMargulis1",color=purple];
		2573 -> 2578 [label="RoatheMargulis1",color=purple];
		2573 -> 2579 [label="RoatheMargulis1",color=purple];
		2573 -> 2576 [label="RoatheUnloved1",color=purple];
		2573 -> 2578 [label="RoatheUnloved1",color=purple];
		2573 -> 2579 [label="RoatheUnloved1",color=purple];
		2573 -> 2577 [label="RoatheExecutor1",color=purple];
		2573 -> 2577 [label="RoatheTraitor1",color=purple];
		2573 -> 2578 [label="RoatheTraitor1",color=purple];
		2573 -> 2579 [label="RoatheTraitor1",color=purple];
		2573 -> 2578 [label="false",color=purple];
		2573 -> 2579 [label="false",color=purple];
		2573 -> 2580 [label="false",color=purple];
	2574 [label="Chat ends.",color=orange];
	2575 [label="Tu me poses cette question après m'avoir raconté l'histoire de Ballas et Margulis et ça ne parle pas de lui?",shape=box,color=red];
		2575 -> 2581;
	2578 [label="Après ce qu'Albrecht t'a fait et toute cette histoire de \"un Orokin peut-il être pardonné?\" et ça n'a rien à voir avec lui?",shape=box,color=red];
		2578 -> 2581;
	2579 [label="D'accord, je vais jouer le jeu. Est-ce que je crois que \"tout le monde mérite d'être aimé\"? Il s'agit clairement d'une question de morale et de valeurs.",shape=box,color=red];
		2579 -> 2582;
	2576 [label="L'Orokin qui m'a dit n'avoir jamais connu l'amour me pose justement cette question et ça ne le concerne pas?",shape=box,color=red];
		2576 -> 2581;
	2577 [label="L'Orokin qui servait une Exécutrice qui était aussi concubine, mais qui a ensuite comploté pour la trahir me pose cette question et ce n'est pas à propos de lui?",shape=box,color=red];
		2577 -> 2581;
	2580 [label="Tu t'attends vraiment à ce que je croie qu'il s'agit simplement d'une question philosophique?",shape=box,color=red];
		2580 -> 2581;
	2581 [label="Je ne veux pas m'enliser dans les détails. Cela ne fait que compliquer les choses. \"Voyez-vous, cette personne a fait ceci et cette autre personne a fait cela, ce qui réfute ceci\", et nous voilà tous plantés là, incapables d'avancer.",shape=box,color=blue];
		2581 -> 2583;
		2581 -> 2584;
	2582 [label="+5 Chemistry",color=orange];
		2582 -> 2585;
	2583 [label="Soit tu parles franchement, soit tu te tais. Si tu ne me dis pas de qui il s'agit réellement, je ne perdrai pas mon temps avec toi.",shape=box,color=red];
		2583 -> 2586;
	2584 [label="Très bien. Nous allons jouer à ton petit jeu.",shape=box,color=red];
		2584 -> 2587;
	2585 [label="Merci infiniment! Le fait d'omettre les noms dans ce court exercice le rend beaucoup plus facile à comprendre. Sans cela, on se perd dans les détails et on n'arrive plus à avancer.",shape=box,color=blue];
		2585 -> 2588;
	2586 [label="Et moi non plus, c'est aussi simple que ça.",shape=box,color=blue];
		2586 -> 2589;
	2587 [label="Bien. La question est telle que je l'ai posée: tout le monde mérite-t-il d'être aimé?",shape=box,color=blue];
		2587 -> 2590;
	2588 [label="Et oui, précisément. Personne ne remet en question le droit du héros vertueux à aimer et à être aimé. Ce sujet n'est jamais abordé dans nos grandes fables, n'est-ce pas?",shape=box,color=blue];
		2588 -> 2591;
	2589 [label="Update boolean RoatheNoDate",color=orange];
		2589 -> 2592;
	2590 [label="Personne ne remet en question le droit du héros vertueux à aimer et à être aimé. Ce sujet n'est jamais abordé dans nos grandes fables, n'est-ce pas?",shape=box,color=blue];
		2590 -> 2591;
	2591 [label="Seul le chien. Le méchant. Le monstre. Le destructeur de mondes dénué de toute moralité.",shape=box,color=blue];
		2591 -> 2593;
		2591 -> 2594;
	2592 [label="Chat ends.",color=orange];
	2593 [label="[Le laisser continuer.]",shape=box,color=red];
		2593 -> 2595;
	2594 [label="Le diable?",shape=box,color=red];
		2594 -> 2596;
	2595 [label="Add 1 to Thermostat",color=orange];
		2595 -> 2597;
	2596 [label="Joue le jeu, Usurpateur.",shape=box,color=blue];
		2596 -> 2598;
	2597 [label="Je propose l'affirmation suivante: la seule chose qui rend ces créatures moralement marginalisées, c'est qu'il y a d'autres personnes qui les marginalisent moralement.",shape=box,color=blue];
		2597 -> 2599;
	2598 [label="Add -1 to Thermostat",color=orange];
		2598 -> 2600;
		2598 -> 2601;
	2599 [label="Si un individu commettait des \"actes mauvais\" en vase clos, seul, sans personne pour le juger, personne ne le jugerait mauvais, n'est-ce pas?",shape=box,color=blue];
		2599 -> 2602;
	2600 [label="Je voulais dire...",shape=box,color=red];
		2600 -> 2603;
	2601 [label="Pardon.",shape=box,color=red];
		2601 -> 2603;
	2602 [label="Si un salaud incendie une forêt et que personne n'est là pour l'entendre, cela fait-il du bruit? Les seuls critères dont nous disposons pour juger les \"bonnes\" et les \"mauvaises\" actions, ce sont les actions des autres.",shape=box,color=blue];
		2602 -> 2604;
		2602 -> 2605;
		2602 -> 2606;
	2603 [label="Mais oui, puisque tu insistes pour en parler, le Diable! Le mal absolu!",shape=box,color=blue];
		2603 -> 2597;
	2604 [label="Un acte mauvais en soi doit bien exister.",shape=box,color=red];
		2604 -> 2607;
	2605 [label="Tu insinues qu'une personne a besoin d'une deuxième personne pour être \"mauvaise\"?",shape=box,color=red];
		2605 -> 2608;
	2606 [label="Je ne sais pas si je suis d'accord avec ça.",shape=box,color=red];
		2606 -> 2607;
	2607 [label="Les actes les plus horribles qu'une personne puisse commettre requièrent au moins l'implication d'une autre. Une personne seule, isolée du monde, ne peut rien faire de condamnable. Détruire une planète inhabitée? Quel malheur!",shape=box,color=blue];
		2607 -> 2609;
	2608 [label="Oui. Penses-y. Les actes les plus horribles qu'une personne puisse commettre requièrent au moins l'implication d'une autre. Une personne seule, isolée du monde, ne peut rien faire de condamnable. Détruire une planète inhabitée? Quel malheur!",shape=box,color=blue];
		2608 -> 2609;
	2609 [label="Et sans une société pour les réprimander et leur dire \"vous n'auriez pas dû commettre cet acte terrible\", comment aurions-nous su que cet acte était si horrible, pour commencer? Nous ne l'aurions pas su.",shape=box,color=blue];
		2609 -> 2610;
	2610 [label="Comme je l'ai dit, il s'agit simplement d'une mesure utilisée par la société pour juger tes actions par rapport à celles des autres.",shape=box,color=blue];
		2610 -> 2611;
		2610 -> 2612;
	2611 [label="Admettons que tu aies raison. Admettons que tu m'aies convaincu et que le bien et le mal ne soient que… des constructions sociales. Que se passe-t-il ensuite?",shape=box,color=red];
		2611 -> 2613;
	2612 [label="Je pense que les actions peuvent être bonnes ou mauvaises en dehors de leur contexte social. Sinon, pourquoi tant d'entre elles seraient considérées comme telles dans des sociétés si différentes?",shape=box,color=red];
		2612 -> 2614;
	2613 [label="Add -1 to Thermostat",color=orange];
		2613 -> 2615;
	2614 [label="Add 1 to Thermostat",color=orange];
		2614 -> 2616;
		2614 -> 2617;
	2615 [label="+5 Chemistry",color=orange];
		2615 -> 2618;
	2616 [label="Mais pour les besoins de la démonstration, continuons. ",shape=box,color=red];
		2616 -> 2615;
	2617 [label="Il vaut probablement mieux s'arrêter là. Je ne vois pas comment cela pourrait bien se terminer. [Fin.]",shape=box,color=red];
		2617 -> 2619;
	2618 [label="Très bien. Si l'on considère le \"mal\" non comme un état mais comme une construction sociale, alors on peut admettre que tous les récits de grandes méchancetés sont, à leur tour, des constructions sociales. Des fables.",shape=box,color=blue];
		2618 -> 2620;
	2619 [label="Comme tu veux.",shape=box,color=blue];
		2619 -> 2621;
	2620 [label="Pourquoi, alors, dans toutes les grandes fables, ceux qui commettent les pires atrocités sont-ils abandonnés à leur propre sort?",shape=box,color=blue];
		2620 -> 2622;
		2620 -> 2623;
		2620 -> 2624;
		2620 -> 2625;
	2621 [label="Chat ends.",color=orange];
	2622 [label="Parce qu'ils sont incapables d'aimer?",shape=box,color=red];
		2622 -> 2626;
	2623 [label="Parce qu'ils n'ont pas de place dans leur cœur pour l'amour?",shape=box,color=red];
		2623 -> 2627;
	2624 [label="Parce qu'ils ne méritent pas d'être aimés?",shape=box,color=red];
		2624 -> 2628;
	2625 [label="Parce que nous essayons de leur donner une leçon?",shape=box,color=red];
		2625 -> 2629;
	2626 [label="Parfois, oui, il existe un mal inhumain, incapable d'amour. Mais pourquoi? Je dirais que toutes les grandes fables ont pour but de nous enseigner une leçon, n'est-ce pas?",shape=box,color=blue];
		2626 -> 2630;
	2627 [label="Parfois, oui, ils sont tellement absorbés par leur grand mal qu'ils en oublient de s'abaisser à de telles \"futilités\". Mais pourquoi? Toutes les grandes fables n'ont-elles pas pour but de nous enseigner une leçon?",shape=box,color=blue];
		2627 -> 2630;
	2628 [label="Hum, tu ne fais que répéter mes propres paroles, Usurpateur. Nous avons déjà convenu que le \"mérite\" est relatif. Réfléchis. Toutes les grandes fables servent à enseigner une leçon, n'est-ce pas?",shape=box,color=blue];
		2628 -> 2630;
	2629 [label="+5 Chemistry",color=orange];
		2629 -> 2631;
	2630 [label="Et si l'on montrait l'incarnation du Grand Mal vivant paisiblement, heureux, merveilleusement amoureux… eh bien… quelle leçon cela nous enseignerait-il?",shape=box,color=blue];
		2630 -> 2632;
		2630 -> 2633;
		2630 -> 2634;
	2631 [label="Telle est ma théorie, oui! Toutes les grandes fables existent pour nous enseigner une leçon, n'est-ce pas?",shape=box,color=blue];
		2631 -> 2630;
	2632 [label="Il est difficile de concilier le fait qu'une personne puisse être \"mauvaise\" et aussi capable d'aimer.",shape=box,color=red];
		2632 -> 2635;
	2633 [label="Peut-être que leurs \"mauvaises actions\" peuvent encore être rachetées par l'amour?",shape=box,color=red];
		2633 -> 2636;
	2634 [label="Que ceux qui font des \"mauvaises actions\" peuvent tout de même avoir de la valeur pour quelqu'un d'autre dans ce monde, et ne sont donc pas \"le mal à l'état pur\"?",shape=box,color=red];
		2634 -> 2637;
	2635 [label="Check boolean RoatheMargulis1",color=orange];
		2635 -> 2638 [label=true,color=green];
		2635 -> 2639 [label=false,color=brown];
	2636 [label="Add 1 to Thermostat",color=orange];
		2636 -> 2640;
	2637 [label="Add -1 to Thermostat",color=orange];
		2637 -> 2641;
	2638 [label="+5 Chemistry",color=orange];
		2638 -> 2642;
	2639 [label="+5 Chemistry",color=orange];
		2639 -> 2643;
	2640 [label="Tu parles comme les culs de bénitier. \"Rédemption!\" Mais tu touches à la vérité. Car tu sous-entends que l'amour et le mal ne peuvent coexister dans notre monde, et c'est vrai, n'est-ce pas? L'amour et le mal ne peuvent coexister en société.",shape=box,color=blue];
		2640 -> 2644;
	2641 [label="Tu n'es pas loin, mais ce n'est pas encore tout à fait ça. Oui, mais allons plus loin. Que signifierait le fait qu'une personne capable de commettre des actes maléfiques soit encore aimée par une autre? Quel impact cela aurait-il sur la société?",shape=box,color=blue];
		2641 -> 2644;
	2642 [label="Exactement! Ces deux choses ne veulent pas coexister dans notre esprit, n'est-ce pas? Quand je t'ai raconté l'histoire de Ballas et Margulis, il était difficile de croire que leur amour ait été réel, n'est-ce pas?",shape=box,color=blue];
		2642 -> 2645;
	2643 [label="Exactement! Ces deux choses ne veulent pas coexister dans notre esprit, n'est-ce pas? Si je te disais que Ballas et Margulis étaient autrefois très amoureux avant que tout ne bascule, me croirais-tu?",shape=box,color=blue];
		2643 -> 2645;
	2644 [label="Check boolean RoatheMargulis1",color=orange];
		2644 -> 2646 [label=true,color=green];
		2644 -> 2647 [label=false,color=brown];
	2645 [label="Sans entrer dans les détails et sans trop m'éloigner de ma propre règle de rester purement philosophique, il s'agit d'un point de référence commun pour nous deux.",shape=box,color=blue];
		2645 -> 2648;
	2646 [label="Quand je t'ai raconté l'histoire de Ballas et Margulis, il était difficile de croire que leur amour ait été réel, n'est-ce pas?",shape=box,color=blue];
		2646 -> 2645;
	2647 [label="Si je te disais que Ballas et Margulis étaient autrefois très amoureux avant que tout ne bascule, me croirais-tu?",shape=box,color=blue];
		2647 -> 2645;
	2648 [label="Il est indéniable que Ballas était capable des formes de cruauté les plus abjectes que l'humanité ait jamais connues. Et pourtant, il connaissait l'amour. L'amour réciproque. ",shape=box,color=blue];
		2648 -> 2649;
	2649 [label="C'est un fait, même si tu préfères le nier, que Ballas et Margulis s'aimaient profondément. Malheureusement, leur histoire a mal tourné.",shape=box,color=blue];
		2649 -> 2650;
	2650 [label="Update boolean RoatheMargulis1",color=orange];
		2650 -> 2651;
	2651 [label="Mais nous devons effacer toute trace de leur amour de cette histoire. Nous devons affirmer qu'il n'a jamais existé. Nous devons dire qu'il n'était pas réel, qu'il s'agissait d'une illusion. Pourquoi?",shape=box,color=blue];
		2651 -> 2652;
		2651 -> 2653;
		2651 -> 2654;
	2652 [label="Je sais pas.",shape=box,color=red];
		2652 -> 2655;
	2653 [label="Car l'amour est l'émotion humaine ultime et si nous nous autorisons à penser que quelqu'un peut être aimé, cela l'humanise.",shape=box,color=red];
		2653 -> 2656;
	2654 [label="Car le mal doit se regarder en face et s'efforcer de changer. Il doit être puni. Et aimer et être aimé est la récompense suprême.",shape=box,color=red];
		2654 -> 2657;
	2655 [label="Et j'ai fait tout ce travail pour rien. Quel dommage.",shape=box,color=blue];
		2655 -> 2658;
	2656 [label="Add -2 to Thermostat",color=orange];
		2656 -> 2659;
	2657 [label="Add 2 to Thermostat",color=orange];
		2657 -> 2660;
	2658 [label="Chat ends.",color=orange];
	2659 [label="Très bien, Usurpateur. Très bien. Exactement. Le Grand Mal doit toujours rester \"autre\" et nous ne devons jamais, au grand jamais, éprouver de la sympathie pour lui. Si nous lui permettions d'aimer et d'être aimé? Je crois que le monde entier s'écroulerait autour de nous.",shape=box,color=blue];
		2659 -> 2661;
	2660 [label="Très bien, Usurpateur. Très bien. Exactement. Nous devons demander des comptes au Grand Mal. Et si nous lui permettions d'aimer et d'être aimé? Je crois que le monde entier pourrait s'écrouler autour de nous.",shape=box,color=blue];
		2660 -> 2661;
	2661 [label="Update boolean RoatheUnloved3",color=orange];
		2661 -> 2662;
	2662 [label="Et où serions-nous alors?",shape=box,color=blue];
		2662 -> 2663;
	2663 [label="Chat ends.",color=orange];
}