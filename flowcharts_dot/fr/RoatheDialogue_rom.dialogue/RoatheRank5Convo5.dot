		j2343711710 -> j3265467117;
	j2890771700 [label="À quoi cela nous sert-il? À tout le bien du monde! Bien sûr, tu as toujours combattu sans personne à tes côtés. Tu n'as jamais connu les tactiques d'une armée.",shape=box,color=blue];
