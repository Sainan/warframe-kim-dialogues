	j3334505280 [label="En effet.",shape=box,color=blue];
		j3334505280 -> "Chat ends.";
	j1987576280 [label="Un être suprême. Quelque chose qui possède une autorité ou un pouvoir total et incontestable. ",shape=box,color=red];
		j1987576280 -> j4235247499;
