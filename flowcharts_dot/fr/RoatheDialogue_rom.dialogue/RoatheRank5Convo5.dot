		j1836252827 -> j582559491;
		j1836252827 -> j1341895530;
		j1836252827 -> j2271459386;
	j421257246 [label="Oui. Je pense que ce qu'Entrati a libéré du Néant était un dieu informe qui était présent avant notre arrivée.",shape=box,color=red];
		j421257246 -> j89058604;
	j582559491 [label="Oui. Je pense que tu racontes n'importe quoi.",shape=box,color=red];
		j582559491 -> j4099310853;
	j1341895530 [label="Oui. Je crois que tu as raison. Je ne pense pas que cela existait avant qu'Entrati n'interagisse avec. Il cherchait un dieu… alors le Néant a craché quelque chose qui prétend en être un.",shape=box,color=red];
		j1341895530 -> j2504093006;
	j2271459386 [label="Oui. Je pense que la réponse se situe quelque part entre les deux. Ce n'était peut-être pas un dieu auparavant, mais ça l'est maintenant. Je crois qu'Entrati l'a fait apparaître d'un claquement de doigts au moment où il a ouvert le Néant.",shape=box,color=red];
		j2271459386 -> j3747307679;
	j89058604 [label="Il est tout simplement incapable de comprendre ce que nous sommes. ",shape=box,color=red];
		j89058604 -> j2854029460;
