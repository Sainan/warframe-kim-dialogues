		j4099310853 -> j2111529454 [label=true,color=green];
		j4099310853 -> j3366544905 [label=false,color=brown];
	j2504093006 [label="Et depuis, nous n'avons cessé de l'alimenter avec nos peurs.",shape=box,color=red];
		j2504093006 -> j3540746028;
	j3747307679 [label="De même que Rell existe et n'existe pas, l'Indifférence n'a jamais été un dieu et pourtant, elle l'a toujours été.",shape=box,color=red];
		j3747307679 -> j3450909493;
	j2854029460 [label="Puis-je te convaincre de reconsidérer mon point de vue? Ou bien tes opinions sur ce sujet sont-elles immuables?",shape=box,color=blue];
		j2854029460 -> j3168642422;
		j2854029460 -> j3300641219;
	j2111529454 [label="Je ne m'attendais pas à ce que tu aies la détente aussi sensible, mon cher Voyageur. Mais comme disent les fanatiques, \"c'est la vie\".",shape=box,color=blue];
		j2111529454 -> j650387292;
	j3366544905 [label="Pour reprendre les termes des fanatiques, \"c'est la vie\".",shape=box,color=blue];
		j3366544905 -> "Chat ends.";
	j3540746028 [label="Boolean DrifterMITWNotGod is now true.",color=orange];
		j3540746028 -> j4234011005;
	j3450909493 [label="Je déteste les Éternalistes. Vous vous en servez comme excuse pour tout. Dès qu'un Archimédien pense avoir compris, c'est parti.",shape=box,color=blue];
		j3450909493 -> j3752368398;
	j3168642422 [label="Tu peux essayer.",shape=box,color=red];
		j3168642422 -> j3309477743;
