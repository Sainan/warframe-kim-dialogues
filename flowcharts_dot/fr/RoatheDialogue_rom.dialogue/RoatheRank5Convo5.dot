		j2130550968 -> j3647651544;
	j3525989159 [label="Je n'avais aucun doute que tu finirais par changer d'avis, mon cher Voyageur. Tu avais déjà prouvé que tu as des goûts raffinés.",shape=box,color=blue];
		j3525989159 -> j3095474877;
	j1660081381 [label="Je n'avais aucun doute que tu finirais par changer d'avis, Voyageur. Je suis plutôt convaincant. ",shape=box,color=blue];
		j1660081381 -> j3095474877;
	j435731389 [label="Je vois. Albrecht l'a façonnée en un \"dieu\" à partir du Néant. Et maintenant, nous avons un \"dieu\" en liberté. Charmant!",shape=box,color=blue];
