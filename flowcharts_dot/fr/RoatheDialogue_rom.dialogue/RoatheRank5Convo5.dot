		j4093884915 -> j3331048891;
	j3298892015 [label="Aaaah, je vois. C'est là que le bât blesse. Oui, nos définitions ne correspondaient pas. Dans la mesure où cette \"Indifférence\" est une entité telle que tu la décris? Oui. Nous sommes d'accord.",shape=box,color=blue];
