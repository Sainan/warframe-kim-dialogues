	j3706654642 [label="MV: SENTIENTS",shape=box,color=blue];
		j3706654642 -> j11687865;
	j11687865 [label="Transcription: nous ne considérions pas les Sentients comme \"eux\", mais plutôt comme une entité. \"Ça\".",shape=box,color=blue];
		j11687865 -> j2472603079;
	j2472603079 [label="Nous faisions face à des légions lancées sur nous sans plus de considération pour leurs vies individuelles que pour celles de particules.",shape=box,color=blue];
		j2472603079 -> j1774621039;
	j1774621039 [label="Ils étaient des cellules au sein d’une masse tentaculaire et malveillante.",shape=box,color=blue];
		j1774621039 -> j1149331016;
	j1149331016 [label="Nous étions, je crois, trop conditionnés par notre expérience de l'Infestation – une conscience collective d'un tout autre ordre.",shape=box,color=blue];
		j1149331016 -> j4154051410;
	j4154051410 [label="Les Sentients avaient reçu pour mission d'évoluer et nous étions leur seul modèle concernant l'aboutissement de cette évolution.",shape=box,color=blue];
		j4154051410 -> j800167726;
	j800167726 [label="Ils retournaient au Système Origine non seulement pour anéantir les Orokins, mais aussi pour les remplacer et finalement, les… perfectionner.",shape=box,color=blue];
		j800167726 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}