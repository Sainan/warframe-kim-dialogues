	j2059796782 [label="MV: OUBLI",shape=box,color=blue];
		j2059796782 -> j965011492;
	j965011492 [label="Transcription: Lâche.",shape=box,color=blue];
		j965011492 -> j3766262445;
	j3766262445 [label="C’est comme ça qu’ils m’appelaient, n’est-ce pas? J’ai lu les livres d’histoire éparpillés dans ce hall poussiéreux. Un mensonge. Ils ignoraient la vérité. Que j’ai été arraché à mon époque avant d’avoir pu achever mon œuvre.",shape=box,color=blue];
		j3766262445 -> j3395343924;
	j3395343924 [label="Lâche.",shape=box,color=blue];
		j3395343924 -> j1429255380;
	j1429255380 [label="Je me souviens, maintenant. Il s'est approché de moi, dans les Salles Dorées. Son visage m'était inconnu. Mais ce n'est pas si inhabituel chez nous. Je connaissais sa voix. Je connaissais sa démarche.",shape=box,color=blue];
		j1429255380 -> j495946540;
	j495946540 [label="Lâche!",shape=box,color=blue];
		j495946540 -> j3751503632;
	j3751503632 [label="Il m'a posé une seule question. Croyais-je vraiment qu'on me pardonnerait d'avoir tout réduit en cendres?",shape=box,color=blue];
		j3751503632 -> j3677280563;
	j3677280563 [label="LÂCHE!",shape=box,color=blue];
		j3677280563 -> j2858025212;
	j2858025212 [label="Dans cette main pâle tendue… une seringue. Scintillante de liberté… d'une autre chance… d'une autre vie.",shape=box,color=blue];
		j2858025212 -> j915263848;
	j915263848 [label="Je l'ai prise.",shape=box,color=blue];
		j915263848 -> j4120836150;
	j4120836150 [label="LÂCHE!",shape=box,color=blue];
		j4120836150 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}