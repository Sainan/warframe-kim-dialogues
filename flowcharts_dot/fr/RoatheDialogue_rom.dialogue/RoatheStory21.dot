	"Chat ends." [color=orange];
	j3362931225 [label="VM: OBLIVION",shape=box,color=blue];
		j3362931225 -> j4037590877;
	j4037590877 [label="Transcription: Lâche.",shape=box,color=blue];
		j4037590877 -> j2005006398;
	j2005006398 [label="That is what they called me, isn’t it? I’ve read the history books scattered about this dusty hall. A lie. They did not know the truth. That I was ripped away from my time before I could complete my work.",shape=box,color=blue];
		j2005006398 -> j3355289128;
	j3355289128 [label="Coward.",shape=box,color=blue];
		j3355289128 -> j4184269597;
	j4184269597 [label="I remember now. He approached me, in the Golden Halls. He wore a face I did not know. But that is not so very unusual for our kind. I knew his voice. I knew the way he moved.",shape=box,color=blue];
		j4184269597 -> j1106158360;
	j1106158360 [label="Coward!",shape=box,color=blue];
		j1106158360 -> j2261620817;
	j2261620817 [label="He asked me a single question. Did I truly believe that I could ever be forgiven for burning it all to ash?",shape=box,color=blue];
		j2261620817 -> j4284107100;
	j4284107100 [label="COWARD!",shape=box,color=blue];
		j4284107100 -> j1433317508;
	j1433317508 [label="Dans cette main pâle tendue… une seringue. Scintillante de liberté… d'une autre chance… d'une autre vie.",shape=box,color=blue];
		j1433317508 -> j2943436701;
	j2943436701 [label="Je l'ai prise.",shape=box,color=blue];
		j2943436701 -> j2066040554;
	j2066040554 [label="COWARD!",shape=box,color=blue];
		j2066040554 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}