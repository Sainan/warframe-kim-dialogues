		j2688688654 -> "Chat ends." [label="false",color=purple];
	j3888214512 [label="Ça suffit! Ça suffit! Je capitule! Rappelle tes fanatiques! Ils sont pires que des kubrodons enragés! Ces satanées créatures me suivent partout. Je n'arrive même plus à dormir!",shape=box,color=blue];
		j3888214512 -> j3108007073;
	"Chat ends." [color=orange];
	j3108007073 [label="Quoi?! Qu'est-ce que tu veux?!",shape=box,color=blue];
		j3108007073 -> j1961065720;
		j3108007073 -> j1647397346;
		j3108007073 -> j3940067756;
	j1961065720 [label="Une autre occasion de te parler du sérum. Roathe, il est temps d'arrêter de fuir. ",shape=box,color=red];
		j1961065720 -> j1979205857;
	j1647397346 [label="Roathe. Prendre le sérum ne fait pas de toi un lâche. Cela fait de toi le seul Orokin encore debout. Accepte-le.",shape=box,color=red];
		j1647397346 -> j1420398166;
	j3940067756 [label="Roathe. Prendre le sérum ne fait pas de toi un lâche. Cela t'offre une nouvelle chance de vivre. De changer les choses.",shape=box,color=red];
		j3940067756 -> j62611055;
	j1979205857 [label="Evaluate expressions on Thermostat counter",color=orange];
		j1979205857 -> j4062043485 [label="x >= 5",color=purple];
		j1979205857 -> j2196867053 [label="x <= 0",color=purple];
		j1979205857 -> j2810466207 [label="x > 0 && x < 5",color=purple];
		j1979205857 -> j2810466207 [label="false",color=purple];
	j1420398166 [label="Add -5 to Thermostat counter",color=orange];
		j1420398166 -> j1979205857;
	j62611055 [label="Add 5 to Thermostat counter",color=orange];
		j62611055 -> j1979205857;
	j4062043485 [label="Tu laisses cette colère te ronger de l'intérieur. Tu pourrais t'en servir pour combattre ceux qui continuent de détruire ce monde aujourd'hui. Ici. Et maintenant.",shape=box,color=red];
		j4062043485 -> j1519574294;
	j2196867053 [label="Tu te retournes contre toi-même. Tu devrais plutôt t'en prendre au monde qui te reproche d'avoir fait de ton mieux pour le sauver de l'Empire Orokin.",shape=box,color=red];
		j2196867053 -> j3691976203;
	j2810466207 [label="C'est pour ça que tu les as convaincus de me harceler jour et nuit? Pour ça? Une dernière tentative désespérée pour me faire écouter ton argument pathétique?",shape=box,color=blue];
		j2810466207 -> j3134719285;
	j1519574294 [label="Tu n'es pas défini par ton passé, Roathe, seulement par ton futur. Et tu en as un, contrairement à tous les Orokins qui sont morts la nuit des Tambours Nagas.",shape=box,color=red];
		j1519574294 -> j1031557983;
	j3691976203 [label="Tu n'es pas défini par l'opinion de ceux qui t'entourent, ni par ce qu'ils pensent de tes actions. Uniquement par ce que tu crois de toi-même et de tes choix.",shape=box,color=red];
		j3691976203 -> j4030648281;
	j3134719285 [label="Non.",shape=box,color=blue];
		j3134719285 -> j1737709912;
	j1031557983 [label="C'est la seule chose qui te définit, maintenant. Tu peux changer. Et tu peux changer le monde qui t'entoure. Ma seule question est: est-ce que tu vas au moins essayer?",shape=box,color=red];
		j1031557983 -> j1169656413;
	j4030648281 [label="Et ce qui est important au final? Tu es l'un des rares Orokins que nous connaissons qui a survécu à la Nuit des Tambours Naga. Pour moi, ça ressemble à une retraite stratégique.",shape=box,color=red];
		j4030648281 -> j1491616407;
	j1737709912 [label="Ton échec est pitoyable. Non pas une fois, mais deux fois maintenant.",shape=box,color=blue];
		j1737709912 -> j3459295853;
	j1169656413 [label="Essayer de te pardonner et d'avancer?",shape=box,color=red];
		j1169656413 -> j3056234347;
	j1491616407 [label="Rien de plus. Rien de moins.",shape=box,color=red];
		j1491616407 -> j1688698123;
	j3459295853 [label="Je ne te recommande pas de te présenter aux élections.",shape=box,color=blue];
		j3459295853 -> "Chat ends.";
	j3056234347 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j3056234347 -> j2146183540;
	j1688698123 [label="Boolean RoatheVillain is now true.",color=orange];
		j1688698123 -> j1958201276;
	j2146183540 [label="+20 Chemistry",color=orange];
		j2146183540 -> j576405184;
	j1958201276 [label="+20 Chemistry",color=orange];
		j1958201276 -> j2621141558;
	j576405184 [label="Me pardonner ce que j'ai fait? Et aller de l'avant? Hum.",shape=box,color=blue];
		j576405184 -> j1714600893;
	j2621141558 [label="Une retraite pour gagner la guerre. Hum. ",shape=box,color=blue];
		j2621141558 -> j3464030628;
	j1714600893 [label="Bien que je sois quelque peu sceptique quant à ton interprétation de la situation, je suis… trop tenté par ce nouvel avenir et par ce qu’il pourrait signifier pour moi pour y résister, mon Voyageur.",shape=box,color=blue];
		j1714600893 -> j3204477623;
	j3464030628 [label="Bien que je sois... légèrement sceptique quant à ton interprétation des événements comme étant une retraite tactique, j'avoue que j'y suis... favorable malgré tout, mon cher Voyageur.",shape=box,color=blue];
		j3464030628 -> j997842508;
	j3204477623 [label="Ce \"nouveau départ\" dans ma vie. Très bien. J'admets ton argument et je l'accepte. Même s'il arrive tard, il n'en reste pas moins efficace.",shape=box,color=blue];
		j3204477623 -> j1342491133;
	j997842508 [label="Très bien. J'admets ton argument et je l'accepte. Même s'il arrive tard, il n'en reste pas moins efficace.",shape=box,color=blue];
		j997842508 -> j1342491133;
	j1342491133 [label="Je t'en suis reconnaissant. Plus que tu ne peux l'imaginer.",shape=box,color=blue];
