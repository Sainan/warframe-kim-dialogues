	j1918933927 [label="MV: MENSONGES",shape=box,color=blue];
		j1918933927 -> j3562429618;
	j3562429618 [label="Transcription: je maîtrisais sans effort nombre de nos armes, mais j’excellais dans l’une d’entre elles: le mensonge.",shape=box,color=blue];
		j3562429618 -> j2300799060;
	j2300799060 [label="Je l’utilisais le plus souvent contre mes propres troupes. Je les ai torturées jusqu’à l’os avec des mensonges sur le devoir et la discipline.",shape=box,color=blue];
		j2300799060 -> j2713203219;
	j2713203219 [label="Je les ai étouffés avec le mensonge de la victoire. Je les ai transpercés du mensonge de la haute estime que je leur portais.",shape=box,color=blue];
		j2713203219 -> j2530837986;
	j2530837986 [label="Seul, en secret, j'ai retourné cette arme contre moi. Oh, comme j'ai saigné!",shape=box,color=blue];
		j2530837986 -> j1648694156;
