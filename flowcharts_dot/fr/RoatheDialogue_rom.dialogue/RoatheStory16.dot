	2275 [label="Transcription: Traivon. Je t’ai vu précipiter ton Railjack dans la gueule du Praghasa. Distrait, se repaissant avidement de toi et de tes hommes, il n’a même pas remarqué mon vaisseau s’éloigner à toute vitesse.",shape=box,color=blue];
		2275 -> 5713;
	5713 [label="You laid down your life for your superior officer. I felt your selflessness like a slap in the face.",shape=box,color=blue];
		5713 -> 5714;
	5714 [label="Maryna. You gave me your body. Together, in that trench, we drank Kuva. My hands shook and my gashed throat leaked, but I kept enough drops down for it to take.",shape=box,color=blue];
		5714 -> 2278;
	2278 [label="I remember your last salute. The fading. Then I blinked open the eyes that had been yours, and saw my gutted corpse dead in the mud.",shape=box,color=blue];
		2278 -> 2272;
	2272 [label="Rostig. \"Il y a eu un problème lors du clonage\", ont-ils dit. Qu'est-ce qui pourrait bien pousser un Grineer à rester dans sa tourelle tout en brûlant vif? Même un rat a l'instinct de survie!",shape=box,color=blue];
		2272 -> 2279;
	2279 [label="Non. Ton \"défaut\" t'a placé au-dessus d'eux.",shape=box,color=blue];
		2279 -> 2271;
	2271 [label="Add 1 to HellStory",color=orange];
		2271 -> 2343;
	2343 [label="{\"Id\":2343,\"Incoming\":[2271],\"Outgoing\":[2270],\"GraphPos\":[4809,-5333],\"CompletionType\":1}",color=orange];
		2343 -> 2270;
	2270 [label="Chat ends.",color=orange];
}