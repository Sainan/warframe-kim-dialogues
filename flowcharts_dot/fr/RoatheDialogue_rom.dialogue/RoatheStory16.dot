	j4002458098 [label="VM: SACRIFICE",shape=box,color=blue];
		j4002458098 -> j2403142124;
	j2403142124 [label="Transcription: Traivon. Je t’ai vu précipiter ton Railjack dans la gueule du Praghasa. Distrait, se repaissant avidement de toi et de tes hommes, il n’a même pas remarqué mon vaisseau s’éloigner à toute vitesse.",shape=box,color=blue];
		j2403142124 -> j14400189;
	j14400189 [label="You laid down your life for your superior officer. I felt your selflessness like a slap in the face.",shape=box,color=blue];
		j14400189 -> j3709488338;
	j3709488338 [label="Maryna. You gave me your body. Together, in that trench, we drank Kuva. My hands shook and my gashed throat leaked, but I kept enough drops down for it to take.",shape=box,color=blue];
		j3709488338 -> j645900795;
	j645900795 [label="I remember your last salute. The fading. Then I blinked open the eyes that had been yours, and saw my gutted corpse dead in the mud.",shape=box,color=blue];
		j645900795 -> j1849701633;
	j1849701633 [label="Rostig. \"Il y a eu un problème lors du clonage\", ont-ils dit. Qu'est-ce qui pourrait bien pousser un Grineer à rester dans sa tourelle tout en brûlant vif? Même un rat a l'instinct de survie!",shape=box,color=blue];
		j1849701633 -> j450008031;
	j450008031 [label="Non. Ton \"défaut\" t'a placé au-dessus d'eux.",shape=box,color=blue];
		j450008031 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}