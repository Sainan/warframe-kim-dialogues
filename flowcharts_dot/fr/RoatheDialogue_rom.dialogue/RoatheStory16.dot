	"Chat ends." [color=orange];
	j3541127395 [label="MV: SACRIFICE",shape=box,color=blue];
		j3541127395 -> j1958972865;
	j1958972865 [label="Transcription: Traivon. Je t’ai vu précipiter ton Railjack dans la gueule du Praghasa. Distrait, se repaissant avidement de toi et de tes hommes, il n’a même pas remarqué mon vaisseau s’éloigner à toute vitesse.",shape=box,color=blue];
		j1958972865 -> j3297432922;
	j3297432922 [label="Tu as donné ta vie pour ton supérieur. J'ai ressenti ton altruisme comme une gifle.",shape=box,color=blue];
		j3297432922 -> j1582305589;
	j1582305589 [label="Maryna. Tu m'as offert ton corps. Ensemble, dans cette tranchée, nous avons bu du Kuva. Mes mains tremblaient et ma gorge, lacérée, saignait, mais j'ai réussi à garder suffisamment de gouttes pour survivre.",shape=box,color=blue];
		j1582305589 -> j2323523293;
	j2323523293 [label="Je me souviens de ton dernier salut. La fin. Puis j'ai ouvert les yeux qui avaient été les tiens et j'ai vu mon cadavre éventré, gisant dans la boue.",shape=box,color=blue];
		j2323523293 -> j1849701633;
	j1849701633 [label="Rostig. \"Il y a eu un problème lors du clonage\", ont-ils dit. Qu'est-ce qui pourrait bien pousser un Grineer à rester dans sa tourelle tout en brûlant vif? Même un rat a l'instinct de survie!",shape=box,color=blue];
		j1849701633 -> j450008031;
	j450008031 [label="Non. Ton \"défaut\" t'a placé au-dessus d'eux.",shape=box,color=blue];
		j450008031 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}