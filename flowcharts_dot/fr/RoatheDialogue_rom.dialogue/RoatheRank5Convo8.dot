		j4125803273 -> j1758133089 [label=true,color=green];
		j4125803273 -> "Chat ends." [label=false,color=brown];
	j1758133089 [label="Evaluate expressions on HellStory counter",color=orange];
		j1758133089 -> j3857063354 [label="x >= 21",color=purple];
		j1758133089 -> "Chat ends." [label="x <= 21",color=purple];
		j1758133089 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j3857063354 [label="Imbécile! Qu'as-tu fait?! Pourquoi, pourquoi t'aventurer dans des cavernes où ta présence n'est pas souhaitée?!",shape=box,color=blue];
		j3857063354 -> j2903978309;
	j2903978309 [label="Je t'ordonne de régler ce problème. C'est ta faute. Je le sens, ça me griffe, ça me déchire. Comme une bête féroce.",shape=box,color=blue];
		j2903978309 -> j214710249;
	j214710249 [label="Débarrasse-moi de ça. Débarrasse-moi de ce fléau. Efface ces souvenirs de mon esprit. Je sais que tu en es capable. Utilise ce don que tu possèdes et mets fin à tout cela. Maintenant.",shape=box,color=blue];
		j214710249 -> j2192765368;
		j214710249 -> j2577534484;
		j214710249 -> j898162652;
	j2192765368 [label="Tu en es certain? Mais… tu es intelligent, j’ai l’impression que tu vas te rendre compte qu’il y a anguille sous roche.",shape=box,color=red];
		j2192765368 -> j131932203;
	j2577534484 [label="Ce sont des souvenirs d'une autre nature, Roathe. Ça ne marchera pas avec ceux-là. Ils sont enfouis plus profondément dans ta psyché.",shape=box,color=red];
		j2577534484 -> j239379697;
	j898162652 [label="Fuir et se cacher de la vérité ne servira à rien. On finira simplement par se retrouver au point de départ.",shape=box,color=red];
		j898162652 -> j2491878842;
	j131932203 [label="Très probablement. Je vais en déduire que tu as fait quelque chose que je ne t'avais pas demandé et t'en juger coupable. Je suis sûr que tu surmonteras cette épreuve.",shape=box,color=blue];
		j131932203 -> j3351494611;
	j239379697 [label="C'est possible. Tu as sans doute raison. Mais je n'ai pas d'autre choix, n'est-ce pas? Ça vaut le coup d'essayer.",shape=box,color=blue];
		j239379697 -> j3351494611;
	j2491878842 [label="Et si tel est le cas, tu peux tout simplement recommencer. C'est comme si tu possédais un don sans fin, non?",shape=box,color=blue];
		j2491878842 -> j3351494611;
	j3351494611 [label="Je sais que je serai furieux contre toi quand je réaliserai que tu as altéré mes souvenirs, bien sûr. Et je te conseille de ne surtout pas me dire que c'était à ma demande, mon cher Voyageur.",shape=box,color=blue];
		j3351494611 -> j3607556847;
	j3607556847 [label="Je dirai simplement que tu mens et cela risque fort de nuire irrémédiablement à l'opinion que j'ai de toi.",shape=box,color=blue];
		j3607556847 -> j91532291;
		j3607556847 -> j1235073252;
	j91532291 [label="Non. Je ne peux pas faire ça et je ne le ferai pas. On doit faire face ensemble à cette situation. Est-ce qu'on peut en parler tout simplement?",shape=box,color=red];
		j91532291 -> j3188779614;
	j1235073252 [label="Je... il n'y a vraiment pas d'autre solution?",shape=box,color=red];
		j1235073252 -> j3188779614;
	j3188779614 [label="Non. Si tu veux que le majordome monte les escaliers? Efface tout ça, comme je l’ai demandé. Si cela t'est égal, fais comme bon te semble. Peu m'importe.",shape=box,color=blue];
		j3188779614 -> j2593689675;
	j2593689675 [label="Ceci et notre amitié personnelle, bien sûr, sont les seuls moyens de pression dont je dispose dans cette situation. C'est aussi simple que cela.",shape=box,color=blue];
		j2593689675 -> j2668353678;
	j2668353678 [label="Qu'en dis-tu?",shape=box,color=blue];
		j2668353678 -> j1522094171;
		j2668353678 -> j833962510;
	j1522094171 [label="D'accord. Je... je le ferai. J'effacerai ta mémoire. Même si cela doit emporter celle de Marie et de Lyon avec.",shape=box,color=red];
		j1522094171 -> j1472181676;
	j833962510 [label="Non. Je refuse. Je trouverai un autre moyen de te convaincre d'aller de l'avant.",shape=box,color=red];
		j833962510 -> j2677581401;
	j1472181676 [label="+10 Chemistry",color=orange];
		j1472181676 -> j681730605;
	j2677581401 [label="Je te souhaite la meilleure des chances.",shape=box,color=blue];
		j2677581401 -> "Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j681730605 [label="Bien. Au travail. ",shape=box,color=blue];
		j681730605 -> j4072107213;
	"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j302033967 [label="Boolean RoatheWillReset is now true.",color=orange];
		j302033967 -> "Chat ends.";
}