	j1830055178 [label="Evaluate expressions",color=orange];
		j1830055178 -> j413150497 [label="RoatheForgivenessShortcut",color=purple];
		j1830055178 -> j2024567305 [label="RoatheVillainyShortcut",color=purple];
		j1830055178 -> j2318547072 [label="false",color=purple];
	j3980423563 [label="Oui, je pense que tu t'y connais \"un peu\" en la matière, non? Continue.",shape=box,color=blue];
		j3980423563 -> j3442198685;
		j3980423563 -> j759129708;
	j413150497 [label="Être en colère ne résoudra rien, Roathe. Tu es en colère parce que tu as peur de faire face à ce que tu as fait. Ce que tu es devenu.",shape=box,color=red];
		j413150497 -> j3917401499;
	j2024567305 [label="Très bien. Sois en colère. Mais utilise-la à bon escient. Sers-t'en pour te débarrasser de toute cette haine qui t'habite et que tu diriges dans la mauvaise direction.",shape=box,color=red];
		j2024567305 -> j580984276;
	j2318547072 [label="Evaluate expressions on Thermostat counter",color=orange];
		j2318547072 -> j413150497 [label="x >= 5",color=purple];
		j2318547072 -> j2024567305 [label="x <= 0",color=purple];
		j2318547072 -> j467000455 [label="x > 0 && x < 5",color=purple];
		j2318547072 -> j467000455 [label="false",color=purple];
	j3442198685 [label="Si tu veux obtenir mon pardon, fais-le. Mais tu dois le vouloir. Tu dois choisir cette voie. Personne d'autre ne le peut.",shape=box,color=red];
		j3442198685 -> j1691803183;
	j759129708 [label="Si tu veux tracer ta propre voie toi-même? N'hésite pas. Fais-le. Ne t'excuse pas. Mais c'est ta voie et celle de personne d'autre.",shape=box,color=red];
		j759129708 -> j3254353260;
	j3917401499 [label="Tu laisses cette colère te ronger de l'intérieur. Tu pourrais t'en servir pour combattre ceux qui continuent de détruire ce monde aujourd'hui. Ici. Et maintenant.",shape=box,color=red];
		j3917401499 -> j761261539;
	j580984276 [label="Tu te retournes contre toi-même. Tu devrais plutôt t'en prendre au monde qui te reproche d'avoir fait de ton mieux pour le sauver de l'Empire Orokin.",shape=box,color=red];
		j580984276 -> j3356035685;
	j467000455 [label="J'aimerais tellement savoir comment t'aider. J'aimerais tellement savoir quoi dire. On dirait que tu es tiraillé entre deux directions. Laquelle veux-tu prendre?",shape=box,color=red];
		j467000455 -> j1144863590;
	j1691803183 [label="Tu n'es pas défini par ton passé, Roathe, seulement par ton futur. Et tu en as un, contrairement à tous les Orokins qui sont morts la nuit des Tambours Nagas.",shape=box,color=red];
		j1691803183 -> j3725992243;
	j3254353260 [label="Tu n'es pas défini par l'opinion de ceux qui t'entourent, ni par ce qu'ils pensent de tes actions. Uniquement par ce que tu crois de toi-même et de tes choix.",shape=box,color=red];
		j3254353260 -> j900393825;
	j761261539 [label="Tu laisses cette colère te ronger de l'intérieur. Tu pourrais t'en servir pour combattre ceux qui continuent de détruire ce monde aujourd'hui. Ici. Et maintenant.",shape=box,color=red];
		j761261539 -> j2684406673;
	j3356035685 [label="Tu n'es pas défini par l'opinion de ceux qui t'entourent, ni par ce qu'ils pensent de tes actions. Uniquement par ce que tu crois de toi-même et de tes choix.",shape=box,color=red];
		j3356035685 -> j381456321;
	j1144863590 [label="Boolean RoatheFail is now true.",color=orange];
		j1144863590 -> j1733159359;
	j3725992243 [label="C'est la seule chose qui te définit, maintenant. Tu peux changer. Et tu peux changer le monde qui t'entoure. Ma seule question est: est-ce que tu vas au moins essayer?",shape=box,color=red];
		j3725992243 -> j2339082267;
	j900393825 [label="Et ce qui est important au final? Tu es l'un des rares Orokins que nous connaissons qui a survécu à la Nuit des Tambours Naga. Pour moi, ça ressemble à une retraite stratégique.",shape=box,color=red];
		j900393825 -> j2409188660;
	j2684406673 [label="C'est la seule chose qui te définit, maintenant. Tu peux changer. Et tu peux changer le monde qui t'entoure. Ma seule question est: est-ce que tu vas au moins essayer?",shape=box,color=red];
		j2684406673 -> j453255040;
	j381456321 [label="Et ce qui est important au final? Tu es l'un des rares Orokins que nous connaissons qui a survécu à la Nuit des Tambours Naga. Pour moi, ça ressemble à une retraite stratégique.",shape=box,color=red];
		j381456321 -> j2042884838;
	j1733159359 [label="Je ne sais pas, Usurpateur. Et c'est bien là le plus grand des problèmes.",shape=box,color=blue];
		j1733159359 -> j1592141339;
	j2339082267 [label="Essayer de te pardonner et d'avancer?",shape=box,color=red];
		j2339082267 -> j584601664;
	j2409188660 [label="Rien de plus. Rien de moins.",shape=box,color=red];
		j2409188660 -> j2672339707;
	j453255040 [label="Essayer de te pardonner et d'avancer?",shape=box,color=red];
		j453255040 -> j2367355240;
	j2042884838 [label="Rien de plus. Rien de moins.",shape=box,color=red];
		j2042884838 -> j2908558720;
	j1592141339 [label="En moi gronde un véritable ouragan, celui d'une bête enragée qui me ronge la cage thoracique de l'intérieur.",shape=box,color=blue];
		j1592141339 -> j2668779079;
	j584601664 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j584601664 -> j2079559745;
	j2672339707 [label="Boolean RoatheVillain is now true.",color=orange];
		j2672339707 -> j2079559745;
	j2367355240 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j2367355240 -> j3654047768;
	j2908558720 [label="Boolean RoatheVillain is now true.",color=orange];
		j2908558720 -> j1022203150;
	j2668779079 [label="Et je ne sais pas comment l'apaiser. Je ne sais même pas si je le peux. J'avais espéré que ces conversations m'auraient ouvert une voie, mais je vois maintenant que c'est peine perdue.",shape=box,color=blue];
		j2668779079 -> j3738931147;
	j2079559745 [label="+20 Chemistry",color=orange];
		j2079559745 -> j2216165709;
	j3654047768 [label="+20 Chemistry",color=orange];
		j3654047768 -> j3880379830;
	j1022203150 [label="+20 Chemistry",color=orange];
		j1022203150 -> j2254558286;
	j3738931147 [label="Il existe pourtant une solution, n'est-ce pas? Tu peux y mettre fin… à cette terrible souffrance qui me ronge l'esprit.",shape=box,color=blue];
		j3738931147 -> j3194739979;
	j2216165709 [label="Très bien. J'admets et j'accepte ton argument. Merci, Voyageur, de m'avoir… dissuadé de prendre ce risque.",shape=box,color=blue];
		j2216165709 -> j2019000994;
	j3880379830 [label="Me pardonner ce que j'ai fait? Et aller de l'avant? Hum.",shape=box,color=blue];
		j3880379830 -> j84461291;
	j2254558286 [label="Une retraite pour gagner la guerre. Hum.",shape=box,color=blue];
		j2254558286 -> j536653055;
	j3194739979 [label="Usurpateur. Voyageur. Je t'en supplie. C'est la seule façon, à mon avis, d'avancer, non? C'est aussi dans ton propre intérêt.",shape=box,color=blue];
		j3194739979 -> j4194078171;
	j2019000994 [label="Je t'en suis reconnaissant. Plus que tu ne peux l'imaginer.",shape=box,color=blue];
		j2019000994 -> j524641694;
	j84461291 [label="Bien que je sois quelque peu sceptique quant à ton interprétation de la situation, je suis… trop tenté par ce nouvel avenir et par ce qu’il pourrait signifier pour moi pour y résister, Usurpateur. Voyageur.",shape=box,color=blue];
		j84461291 -> j77007510;
	j536653055 [label="Bien que je sois... légèrement sceptique quant à ton interprétation des événements comme étant une retraite tactique, j'avoue que j'y suis... favorable malgré tout, Usurpateur. Voyageur.",shape=box,color=blue];
		j536653055 -> j2216165709;
	j4194078171 [label="Si tu veux vraiment qu'un jour le majordome monte se réconcilier avec la famille Entrati, tu devras faire ce que je te dis. Tu le devras.",shape=box,color=blue];
		j4194078171 -> j465149008;
		j4194078171 -> j2498822866;
	j524641694 [label="Je dois y aller. Je me sens d'humeur à boire un sacré volume d'alcool et à fixer le vide d'un air pensif.",shape=box,color=blue];
		j524641694 -> "Chat ends. Next chat will be Roathe5Day2.";
	j77007510 [label="Ce \"nouveau départ\". Très bien. J'admets et j'accepte ton argument. Merci, Voyageur, de m'avoir… dissuadé de prendre ce risque.",shape=box,color=blue];
		j77007510 -> j2019000994;
	j465149008 [label="C'est-à-dire?",shape=box,color=red];
		j465149008 -> j3719308573;
	j2498822866 [label="Non. Je sais ce que tu vas demander et la réponse est déjà non.",shape=box,color=red];
		j2498822866 -> j2106115646;
	"Chat ends. Next chat will be Roathe5Day2." [color=orange];
	j3719308573 [label="Tu as un don. Celui de pouvoir remonter le temps. De le faire tourbillonner, voire d'en faire une boucle. Et cela a… un effet intéressant sur l’esprit des Protoframes, de par le lien avec l’Infestation et le temps.",shape=box,color=blue];
		j3719308573 -> j3989179656;
	j2106115646 [label="Si tu me dis que tu n'as jamais utilisé tes dons pour manipuler l'esprit des Protoframes que tu appelles amis et amants, et si tu le dis en jurant sur ton âme?",shape=box,color=blue];
		j2106115646 -> j3179989838;
	j3989179656 [label="Et donc, notre attachement au temps. Je te le demande maintenant. Non, je t'en supplie, utilise-le pour moi. Libère-moi de ces pensées. Libère-moi de ces souvenirs.",shape=box,color=blue];
		j3989179656 -> j1775518802;
	j3179989838 [label="Très bien. Qu'il en soit ainsi. Je ne te demanderai pas cela maintenant. Mais si tu ne l'as jamais fait par simple amusement, par curiosité ou pour tenter de corriger des erreurs commises dans tes relations avec d'autres?!",shape=box,color=blue];
