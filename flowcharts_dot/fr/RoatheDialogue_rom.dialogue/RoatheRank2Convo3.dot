	j3438455715 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3438455715 -> j1861555603 [label=true,color=green];
		j3438455715 -> j1312260507 [label=false,color=brown];
	"Chat ends." [color=orange];
	j1861555603 [label="Je sais que tu as probablement déjà entendu ça et aujourd'hui je m'en fiche – je n'ai pas la patience.",shape=box,color=blue];
		j1861555603 -> j1312260507;
	j1312260507 [label="Je pense que la chute de l'Empire Orokin est due à la superposition de trop de couches de verre.",shape=box,color=blue];
		j1312260507 -> j1120410531;
		j1312260507 -> j12981176;
		j1312260507 -> j2429168889;
	j1120410531 [label="Comment ça?",shape=box,color=red];
		j1120410531 -> j1163271154;
	j12981176 [label="Trop impersonnel?",shape=box,color=red];
		j12981176 -> j2674175722;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j1163271154 [label="Imagine une société fondée sur la certitude que vous êtes, en principe, à jamais en sécurité. Protégés. Même du spectre de la mort.",shape=box,color=blue];
		j1163271154 -> j4220819574;
	j2674175722 [label="+5 Chemistry",color=orange];
		j2674175722 -> j1818165429;
	j4220819574 [label="Là où rien ne peut vous nuire.",shape=box,color=blue];
		j4220819574 -> j984565777;
	j1818165429 [label="Exactement. Trop déconnecté du danger et de la réalité des choses.",shape=box,color=blue];
		j1818165429 -> j1163271154;
	j984565777 [label="Cela engendre une sorte d'ennui qui, à son tour, commence à engendrer son propre danger, Usurpateur. Politique. Intrigues de pouvoir. Ainsi, nous inventions de nouvelles façons magistrales de nous mettre en danger, puisque nous avions remplacé les anciennes.",shape=box,color=blue];
		j984565777 -> j3421718254;
		j984565777 -> j1466074652;
	j3421718254 [label="Pourquoi me parles-tu de cela?",shape=box,color=red];
		j3421718254 -> j2424733195;
	j1466074652 [label="Qu'est-ce qui est pire? Se faire tirer dessus ou devoir constamment surveiller ses arrières?",shape=box,color=red];
		j1466074652 -> j3100028471;
	j2424733195 [label="Mon séjour forcé en \"Gaule\" n'a pas offert beaucoup d'aspects intéressants ou agréables. La nourriture par contre... Ensuite, il y avait... les tempêtes.",shape=box,color=blue];
		j2424733195 -> j3993126509;
	j3100028471 [label="Ah! Je n'ai pas vraiment de préférence, étant parfaitement à l'aise dans les deux domaines, je le crains. Et toi, quelle est ta préférence?",shape=box,color=blue];
		j3100028471 -> j1430108046;
		j3100028471 -> j2593112233;
	j3993126509 [label="Des orages d'une violence inouïe, comme je n'en avais jamais vu pendant mes années chez les Orokins. Ils faisaient trembler la terre, vibrer les vitres. Je les entendais même dans la crypte poussiéreuse où ils nous consignaient.",shape=box,color=blue];
		j3993126509 -> j2698866144;
	j1430108046 [label="J'aime savoir qui sont mes ennemis, clairement et simplement. Qu'ils viennent me défier, armes au poing.",shape=box,color=red];
		j1430108046 -> j2967737658;
	j2593112233 [label="Me faire tirer dessus. Je préfère agir pour arriver à mes fins. Je peux prendre mon temps.",shape=box,color=red];
		j2593112233 -> j2396403105;
	j2698866144 [label="Lorsqu'ils surplombaient la ville, je grimpais au clocher pour m'approcher au plus près. Je voulais sentir la tension dans l'air, la pluie qui crépitait sur ma peau.",shape=box,color=blue];
		j2698866144 -> j2299889008;
		j2698866144 -> j2751062615;
		j2698866144 -> j439460370;
	j2967737658 [label="Add 1 to Thermostat counter",color=orange];
		j2967737658 -> j3978909005;
	j2396403105 [label="Add -1 to Thermostat counter",color=orange];
		j2396403105 -> j2329187939;
	j2299889008 [label="N'était-ce pas un peu dangereux?",shape=box,color=red];
		j2299889008 -> j1040652173;
	j2751062615 [label="Ça semble fantastique.",shape=box,color=red];
		j2751062615 -> j1373500794;
	j439460370 [label="Comment Marie et Lyon réagissaient-ils quand tu filais en douce?",shape=box,color=red];
		j439460370 -> j1464021243;
	j3978909005 [label="Je comprends ton point de vue et je dois admettre qu'il y a une certaine simplicité à apprécier là-dedans. Difficile de confondre un ennemi avec autre chose quand il te braque une arme dessus.",shape=box,color=blue];
		j3978909005 -> j3217456974;
	j2329187939 [label="Mmm, délicieux, n'est-ce pas? Un plan minutieux, savamment élaboré, qui porte ses fruits? Voir toutes les pièces du puzzle s'assembler… c'est vraiment amusant.",shape=box,color=blue];
		j2329187939 -> j3217456974;
	j1040652173 [label="C’était précisément le but de cette entreprise! Je ne peux décrire ce que j’ai ressenti face à une telle puissance brute. Non, c’était bien plus que cela; c’était une puissance véritable. J’ai levé les yeux vers ces nuages sombres et tourbillonnants, zébrés d’éclairs furieux et j’ai compris ce que mes ancêtres avaient si désespérément cherché à maîtriser.",shape=box,color=blue];
		j1040652173 -> j1513089236;
	j1373500794 [label="+5 Chemistry",color=orange];
		j1373500794 -> j4137267321;
	j1464021243 [label="Tu écris cela comme si je leur avais accordé la moindre pensée. Ils ne m'ont pas suivi, si c'est bien ce que tu demandes. Le prêtre se souciait peu que je me fasse foudroyer, j'en suis certain. Quant à Marie? Elle était sans doute trop occupée à vénérer ses faux dieux. Sol ou Albrecht, à toi de choisir.",shape=box,color=blue];
		j1464021243 -> j3823054771;
	j3217456974 [label="+5 Chemistry",color=orange];
		j3217456974 -> j4236030285;
	j1513089236 [label="De plus, je savais que ma présence là-bas pouvait aussi me tuer et qu'aucun Kuva ne serait à proximité pour me ranimer. Qui plus est, je savais que le Kuva sacré serait inefficace sur mon corps difforme et tordu. ",shape=box,color=blue];
		j1513089236 -> j1218249910;
	j4137267321 [label="Ça l'était! Je ne peux décrire ce que j’ai ressenti face à une telle puissance brute. Non, c’était bien plus que cela; c’était une puissance véritable. J’ai levé les yeux vers ces nuages sombres et tourbillonnants, zébrés d’éclairs furieux et j’ai compris ce que mes ancêtres avaient si désespérément cherché à maîtriser.",shape=box,color=blue];
		j4137267321 -> j1513089236;
	j3823054771 [label="Mais une telle puissance brute? Non, c’était bien plus que cela; c’était une puissance véritable. J’ai levé les yeux vers ces nuages sombres et tourbillonnants, zébrés d’éclairs furieux et j’ai compris ce que mes ancêtres avaient si désespérément cherché à maîtriser.",shape=box,color=blue];
		j3823054771 -> j1513089236;
	j4236030285 [label="Je constate cependant que, comme pour tout dans la vie, la modération et un juste équilibre entre les deux sont la clé du succès. L'excès dans un domaine risque d'entraîner l'abandon de l'autre.",shape=box,color=blue];
		j4236030285 -> j2640609086;
	j1218249910 [label="Cela me terrifiait. J'ai ressenti de la peur, Voyageur. De la peur. Pour la première fois depuis… des siècles, peut-être?",shape=box,color=blue];
		j1218249910 -> j2589692495;
		j1218249910 -> j3059947695;
	j2640609086 [label="C’est ainsi que nous créons des créatures comme Ballas et Nitokh, je le crains. Le Manipulateur et la Reine de Sang. Bah.",shape=box,color=blue];
		j2640609086 -> j1764928085;
	j2589692495 [label="Tu as peur de mourir?",shape=box,color=red];
		j2589692495 -> j71319051;
	j3059947695 [label="Qu'est-ce que tu as fait?",shape=box,color=red];
		j3059947695 -> j2206113327;
	j1764928085 [label="Mais je suis venu ici pour parler des tempêtes.",shape=box,color=blue];
		j1764928085 -> j2424733195;
	j71319051 [label="Oui, on dirait bien! Et même très nettement. Ce fut une révélation pour moi à cet instant précis. Je ne crains pas ce qu'il y a après la mort, Voyageur. Je ne souhaite tout simplement pas que ma vie prenne fin pour le moment. Je n'ai pas fini de la vivre.",shape=box,color=blue];
		j71319051 -> j3747316861;
	j2206113327 [label="Je suis monté sur la balustrade de pierre, près de la gargouille, j'ai écarté les bras et… j'ai ri. J'ai ri face à la tempête.",shape=box,color=blue];
		j2206113327 -> j1832357702;
	j3747316861 [label="Ce qui fut une révélation en soi. Je suis monté sur la balustrade de pierre, près de la gargouille, j'ai écarté les bras et… j'ai ri. J'ai ri face à la tempête.",shape=box,color=blue];
		j3747316861 -> j309055284;
	j1832357702 [label="Car soudain, j'ai compris que je ne craignais pas ce qu'il y a après la mort, Voyageur. Je ne souhaite tout simplement pas que ma vie prenne fin pour le moment. Je n'ai pas fini de la vivre.",shape=box,color=blue];
		j1832357702 -> j309055284;
	j309055284 [label="Malgré tout. Malgré la désolation de Tau. Malgré la destruction de l'Empire Orokin que je savais désormais inévitable. Malgré la perversion de mon corps en… ce désastre. Malgré le fait d'avoir été projeté dans le passé et abandonné à mon sort.",shape=box,color=blue];
		j309055284 -> j3482367132;
	j3482367132 [label="Je savais que je trouverais un moyen de revenir ici. À cette époque. À cet endroit. Là où Albrecht avait laissé tous ses biens les plus précieux.",shape=box,color=blue];
		j3482367132 -> j573756443;
	j573756443 [label="+5 Chemistry",color=orange];
		j573756443 -> j4133888951;
	j4133888951 [label="Car je n'ai pas fini de vivre ma vie. Mais par le Néant, je vais m'assurer qu'il finisse de vivre la sienne.",shape=box,color=blue];
		j4133888951 -> j3359792563;
	j3359792563 [label="Boolean RoatheEntrati1 is now true.",color=orange];
		j3359792563 -> "Chat ends.";
}