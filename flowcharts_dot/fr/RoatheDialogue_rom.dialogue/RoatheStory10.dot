	"Chat ends." [color=orange];
	j3805587122 [label="MV: PUNITION",shape=box,color=blue];
		j3805587122 -> j4029852788;
	j4029852788 [label="Transcription : c’est Scarne, irritable, cérébral et acerbe, qui avait évoqué le plan pour la première fois avant la guerre. \"Il faut quitter le nid, car le nid est en feu.\"",shape=box,color=blue];
		j4029852788 -> j314873438;
	j314873438 [label="Par la surexploitation et des expériences inconsidérées, nous avions souillé le Système au point qu'il ne puisse plus se régénérer.",shape=box,color=blue];
		j314873438 -> j1738134667;
	j1738134667 [label="L'expansion vers de nouveaux horizons était désormais notre seule option.",shape=box,color=blue];
		j1738134667 -> j3636656822;
	j3636656822 [label="Lui aussi inaugura les lâches Tours dans le Néant.",shape=box,color=blue];
		j3636656822 -> j2892808917;
	j2892808917 [label="La crainte d'un retour des Sentients était si forte en lui qu'il ne pouvait envisager qu'une retraite dans des îles au sein de la Mer du Néant.",shape=box,color=blue];
		j2892808917 -> j3746666140;
	j3746666140 [label="Nous avons si peu reconnu le courage des Sentients.",shape=box,color=blue];
		j3746666140 -> j3429034468;
	j3429034468 [label="Ils ont volontairement enduré le feu brûlant du Néant uniquement pour avoir la chance de nous punir.",shape=box,color=blue];
		j3429034468 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}