	2218 [label="Transcription : c’est Scarne, irritable, cérébral et acerbe, qui avait évoqué le plan pour la première fois avant la guerre. \"Il faut quitter le nid, car le nid est en feu.\"",shape=box,color=blue];
		2218 -> 2221;
	2221 [label="Par la surexploitation et des expériences inconsidérées, nous avions souillé le Système au point qu'il ne puisse plus se régénérer.",shape=box,color=blue];
		2221 -> 2216;
	2216 [label="L'expansion vers de nouveaux horizons était désormais notre seule option.",shape=box,color=blue];
		2216 -> 5733;
	5733 [label="He, too, inaugurated the cowardly Towers in the Void.",shape=box,color=blue];
		5733 -> 2222;
	2222 [label="La crainte d'un retour des Sentients était si forte en lui qu'il ne pouvait envisager qu'une retraite dans des îles au sein de la Mer du Néant.",shape=box,color=blue];
		2222 -> 5700;
	5700 [label="How little credit we gave the Sentients for courage.",shape=box,color=blue];
