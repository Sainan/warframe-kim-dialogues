	j4277771569 [label="VM: PUNISHMENT",shape=box,color=blue];
		j4277771569 -> j4000820995;
	j4000820995 [label="Transcription : c’est Scarne, irritable, cérébral et acerbe, qui avait évoqué le plan pour la première fois avant la guerre. \"Il faut quitter le nid, car le nid est en feu.\"",shape=box,color=blue];
		j4000820995 -> j367037719;
	j367037719 [label="Par la surexploitation et des expériences inconsidérées, nous avions souillé le Système au point qu'il ne puisse plus se régénérer.",shape=box,color=blue];
		j367037719 -> j355308053;
	j355308053 [label="L'expansion vers de nouveaux horizons était désormais notre seule option.",shape=box,color=blue];
		j355308053 -> j2832157087;
	j2832157087 [label="He, too, inaugurated the cowardly Towers in the Void.",shape=box,color=blue];
		j2832157087 -> j4109826312;
	j4109826312 [label="La crainte d'un retour des Sentients était si forte en lui qu'il ne pouvait envisager qu'une retraite dans des îles au sein de la Mer du Néant.",shape=box,color=blue];
		j4109826312 -> j1078327309;
	j1078327309 [label="How little credit we gave the Sentients for courage.",shape=box,color=blue];
		j1078327309 -> j1060071859;
	j1060071859 [label="They willingly endured the Void’s scalding fire purely for the chance to punish us.",shape=box,color=blue];
		j1060071859 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
