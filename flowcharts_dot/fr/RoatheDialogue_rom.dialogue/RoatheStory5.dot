	j3123326497 [label="MV: INVENTION",shape=box,color=blue];
		j3123326497 -> j3202882661;
	j3202882661 [label="Transcription: je me souviens que les développements de l’Archimédée martiale étaient, au début, présentés comme des divertissements.",shape=box,color=blue];
		j3202882661 -> j3690914629;
	j3690914629 [label="Comme des débauchés regardant des criminels mis à mort dans l'arène d'un cirque tragique.",shape=box,color=blue];
		j3690914629 -> j3420197130;
	j3420197130 [label="Nous pensions avoir trouvé des moyens nouveaux et captivants de vaincre un ennemi bien inférieur.",shape=box,color=blue];
		j3420197130 -> j370889999;
	j370889999 [label="Nous nous bercions d'illusions. En réalité, nous innovions désespérément, conscients de notre infériorité numérique face à nos ennemis protéiformes.",shape=box,color=blue];
		j370889999 -> j178323077;
	j178323077 [label="Ils nous ont anéantis comme une nuée d'enfants dévorant leur mère bouffie.",shape=box,color=blue];
		j178323077 -> j3435676106;
	j3435676106 [label="Desséchés, écrasés entre les pages du temps, nous avions tout simplement été dépassés par l'évolution.",shape=box,color=blue];
		j3435676106 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
