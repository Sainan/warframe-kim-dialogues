		j4258163200 -> j88821745;
	j88821745 [label="Laisse ton cœur te guider, Voyageur. S'il y a une chose que je regrette peut-être dans toutes ces années, c'est de n'avoir jamais partagé le mien avec personne.",shape=box,color=blue];
