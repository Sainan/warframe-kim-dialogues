		j118998107 -> j2382628417;
	j3258147242 [label="Crois-tu être la première personne que je rencontre à vouloir \"danser avec le diable de Tau\"? Certainement pas. Il reste à voir si ton intérêt est sincère ou s'il s'éteindra après une ou deux nuits passées à assouvir ta curiosité.",shape=box,color=blue];
		j3258147242 -> j3731120950;
	j3981884614 [label="Je suppose que je n'ai plus qu'à me résigner et laisser la situation se dégrader d'elle-même. Ou alors, tu réussiras et l'un d'eux se laisseras distraire de sa cause apparemment inflexible: me harceler.",shape=box,color=blue];
