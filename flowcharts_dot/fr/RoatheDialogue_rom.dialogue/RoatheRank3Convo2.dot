		j2126792214 -> j839823173;
	j3865995011 [label="Et avant que tu ne te mettes à rédiger une réponse furieuse et à dénoncer avec colère ma personne pour avoir encouragé toute forme d'infidélité de ta part, laisse-moi un instant pour m'expliquer.",shape=box,color=blue];
