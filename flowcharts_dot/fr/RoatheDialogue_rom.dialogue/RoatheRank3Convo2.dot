	j3720655375 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3720655375 -> j944642456 [label=true,color=green];
		j3720655375 -> j78597545 [label=false,color=brown];
	"Chat ends." [color=orange];
	j944642456 [label="Pourquoi me poses-tu cette question? Qu’essaies-tu d’apprendre, Voyageur? Tu ne cherches certainement pas à savoir où se trouvent les munitions.",shape=box,color=blue];
		j944642456 -> j2443537168;
	j78597545 [label="Pourquoi? Envie de remonter le temps et de battre le record de ton jeune toi? Besoin de conseils pour renverser un gouvernement totalitaire? À la recherche de munitions enfouies capables de détruire des planètes entières?",shape=box,color=blue];
		j78597545 -> j401783813;
	j2443537168 [label="Pourquoi te ferais-je confiance? Pourquoi t'ai-je fait confiance?!",shape=box,color=blue];
		j2443537168 -> j2310817378;
	j401783813 [label="Ou es-tu en train de parler pour ne rien dire?",shape=box,color=blue];
		j401783813 -> j819568948;
		j401783813 -> j2014776142;
		j401783813 -> j2060235164;
	j2310817378 [label="Check boolean RoatheResetForgiven",color=orange];
		j2310817378 -> j2293785925 [label=true,color=green];
		j2310817378 -> j2774819481 [label=false,color=brown];
	j819568948 [label="Je me demande si tu regrettes quoi que ce soit, sincèrement. Si tu voudrais revenir en arrière et changer quoi que ce soit à tes plans.",shape=box,color=red];
		j819568948 -> j3595598857;
	j2014776142 [label="L'idée de ce que cela a été de concevoir un plan pareil me fascine. Ça a dû être un chef-d'œuvre.",shape=box,color=red];
		j2014776142 -> j4045530053;
	j2060235164 [label="Il serait honnêtement bon de savoir si tu as caché des armes quelque part où elles sont encore accessibles.",shape=box,color=red];
		j2060235164 -> j2959843894;
	j2293785925 [label="Je t'ai pardonné ce que tu as fait. Je regrette seulement de ne plus savoir pourquoi… pourquoi? Pourquoi toi, entre tous?!",shape=box,color=blue];
		j2293785925 -> j1402560954;
		j2293785925 -> j1936041890;
	j2774819481 [label="Pourquoi! Pourquoi toi, de toutes les personnes?!",shape=box,color=blue];
		j2774819481 -> j1936041890;
		j2774819481 -> j4277103782;
	j3595598857 [label="Add 1 to Thermostat counter",color=orange];
		j3595598857 -> j1174850100;
	j4045530053 [label="Add -1 to Thermostat counter",color=orange];
		j4045530053 -> j436764730;
	j2959843894 [label="+5 Chemistry",color=orange];
		j2959843894 -> j745114239;
	j1402560954 [label="Je sais. Et je regrette vraiment.",shape=box,color=red];
		j1402560954 -> j179823271;
	j1936041890 [label="J'essaie de t'amener à un point où tu comprendras pourquoi.",shape=box,color=red];
		j1936041890 -> j633317707;
	j4277103782 [label="Je regrette encore d'avoir trahi ta confiance, Roathe. Crois-le ou non, ce n'était pas mon intention.",shape=box,color=red];
		j4277103782 -> j3573615778;
	j1174850100 [label="Je regrette seulement que cela n'ait jamais abouti. Je regrette le temps perdu.",shape=box,color=blue];
		j1174850100 -> j3967850119;
	j436764730 [label="Et quel chef-d'œuvre, Usurpateur!",shape=box,color=blue];
		j436764730 -> j3967850119;
	j745114239 [label="Pratique. Mais la plupart des endroits où j'avais \"caché\" mes provisions ont probablement… disparu au fil des nombreuses années qui se sont écoulées.",shape=box,color=blue];
		j745114239 -> j3808705493;
	j179823271 [label="Oui, oui. Je suppose que nous devrions poursuivre cette conversation absurde où nous revenons encore une fois nos discussions précédentes.",shape=box,color=blue];
		j179823271 -> j386277906;
	j633317707 [label="+5 Chemistry",color=orange];
		j633317707 -> j1330505023;
	j3573615778 [label="Oui, tu pensais sans doute que tes actes resteraient impunis. Quoi qu'il en soit, poursuivons cette conversation futile sur nos anciens nous et puis, passons à autre chose.",shape=box,color=blue];
		j3573615778 -> j386277906;
	j3967850119 [label="+5 Chemistry",color=orange];
		j3967850119 -> j2114546345;
	j3808705493 [label="Et nombre de ces lieux étaient secrets, même pour moi. Le plan était d'une complexité extrême. Des facettes, beaucoup de facettes encore plus profondes.",shape=box,color=blue];
		j3808705493 -> j538371376;
	j386277906 [label="Quelle était ta question, déjà? Ah! Oui. \"Comment comptais-je renverser les Exécuteurs?\" ",shape=box,color=blue];
		j386277906 -> j3183231749;
	j1330505023 [label="En ressassant les mêmes conversations stériles sur les raisons pour lesquelles je voulais assassiner des gens morts et réduits en poussière depuis longtemps? Au moins, c'est une approche pragmatique.",shape=box,color=blue];
		j1330505023 -> j386277906;
	j2114546345 [label="Le plan était d'une complexité extrême. Il comportait de multiples facettes. Des assassins chargés d'éliminer les assassins d'autres assassins si le premier venait à échouer.",shape=box,color=blue];
		j2114546345 -> j3644543001;
	j538371376 [label="Des assassins chargés de tuer les assassins d'autres assassins si le premier assassin échouait.",shape=box,color=blue];
		j538371376 -> j3644543001;
	j3183231749 [label="Pourquoi?",shape=box,color=blue];
		j3183231749 -> j819568948;
		j3183231749 -> j2014776142;
		j3183231749 -> j2060235164;
	j3644543001 [label="Des bombes dissimulées dans de nombreux bâtiments, des vaisseaux et une lune entière piégés avec des explosifs volés. Un rail solaire prêt à quitter son orbite.",shape=box,color=blue];
		j3644543001 -> j1139409747;
	j1139409747 [label="Et tout cela réalisé de façon machiavélique pour faire croire à une \"Grande Catastrophe Sentient\" le moment venu. Nitokh et moi aurions déclaré l'état d'urgence dans l'Empire une fois les Exécuteurs et les Empereurs… neutralisés.",shape=box,color=blue];
		j1139409747 -> j1742364006;
	j1742364006 [label="Boolean RoatheTraitor2 is now true.",color=orange];
		j1742364006 -> j285070892;
	j285070892 [label="Check boolean RoatheExecutor1",color=orange];
		j285070892 -> j723331388 [label=true,color=green];
		j285070892 -> j3172473053 [label=true,color=green];
		j285070892 -> j3445939757 [label=true,color=green];
		j285070892 -> j723331388 [label=false,color=brown];
		j285070892 -> j3172473053 [label=false,color=brown];
	j723331388 [label="Et si ton plan n'avait pas fonctionné?",shape=box,color=red];
		j723331388 -> j1411456197;
	j3172473053 [label="Et qu'allais-tu faire ensuite?",shape=box,color=red];
		j3172473053 -> j1963464565;
	j3445939757 [label="Qu'avais-tu prévu de faire concernant Nitokh?",shape=box,color=red];
		j3445939757 -> j1932713100;
	j1411456197 [label="C'était l'un des milliers de résultats possibles pour lesquels j'avais un plan. ",shape=box,color=blue];
		j1411456197 -> j630469469;
	j1963464565 [label="Il existait mille issues possibles à ce que nous avions prévu. Pour chaque variable en jeu, une variante possible du chemin à suivre a été créée. ",shape=box,color=blue];
		j1963464565 -> j2116288428;
	j1932713100 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1932713100 -> j423180715 [label=true,color=green];
		j1932713100 -> j2095432529 [label=false,color=brown];
	j630469469 [label="Si nous avions échoué de façon spectaculaire, j'aurais simplement mis un Lex dans ma bouche et j'en aurais fini là.",shape=box,color=blue];
		j630469469 -> j598648896;
	j2116288428 [label="Et pour chacune, j'avais défini un résultat. Et pour chacune, je savais ce que j'avais l'intention de faire. Beaucoup se ressemblaient dans les grandes lignes, mais différaient dans les détails.",shape=box,color=blue];
		j2116288428 -> j3812619255;
	j423180715 [label="Qu'est-ce que je t'ai déjà dit à ce sujet? Parce que je me rends compte que je ne te fais pas encore suffisamment confiance pour te le dire ouvertement.",shape=box,color=blue];
		j423180715 -> j1364230308;
		j423180715 -> j4150196174;
	j2095432529 [label="Il s'agissait d'une affaire complexe qui a nécessité de longues négociations entre nous.",shape=box,color=blue];
		j2095432529 -> j3140620858;
		j2095432529 -> j308043726;
	j598648896 [label="Inutile de pleurer sur le Kuva renversé, tout ça tout ça.",shape=box,color=blue];
		j598648896 -> j2372277469;
		j598648896 -> j867149096;
	j3812619255 [label="Si nous avions échoué de façon spectaculaire, j'aurais simplement mis un Lex dans ma bouche et j'en aurais fini là.",shape=box,color=blue];
		j3812619255 -> j2472497966;
	j1364230308 [label="Tu m'as tout dit.",shape=box,color=red];
		j1364230308 -> j2583822397;
	j4150196174 [label="Alors, je ne te forcerai pas à m'en dire plus que tu ne le souhaites.",shape=box,color=red];
		j4150196174 -> j1168141564;
	j3140620858 [label="Cette phrase recèle bien des choses.",shape=box,color=red];
		j3140620858 -> j1457105193;
	j308043726 [label="Quel genre de négociations?",shape=box,color=red];
		j308043726 -> j1225898745;
	j2372277469 [label="Personnellement, j'aurais choisi la fuite.",shape=box,color=red];
		j2372277469 -> j2220971040;
	j867149096 [label="Tu aurais simplement accepté la mort?",shape=box,color=red];
		j867149096 -> j1634719916;
	j2472497966 [label="En cas de succès mitigé, ce qui était fort probable, il aurait fallu faire le ménage pour s'assurer que tous les détails soient réglés. Bien entendu, j'étais l'un de ces détails. Et j'avais pris des mesures pour garantir que je resterais suffisamment précieux à court terme pour ne pas être éliminé avec les autres.",shape=box,color=blue];
		j2472497966 -> j2748219194;
	j2583822397 [label="Alors, inutile que je me répète, n'est-ce pas? En réalité, cette conversation n'a guère d'intérêt. Passe une excellente fin de journée.",shape=box,color=blue];
		j2583822397 -> "Chat ends.";
	j1168141564 [label="+5 Chemistry",color=orange];
		j1168141564 -> j2186479392;
	j1457105193 [label="+5 Chemistry",color=orange];
		j1457105193 -> j1874914634;
	j1225898745 [label="Tout ce que tu peux imaginer.",shape=box,color=blue];
		j1225898745 -> j1861383400;
	j2220971040 [label="Et où donc, Usurpateur? Nous n'avons pas tous des dimensions de poche où nous réfugier en cas de panique.",shape=box,color=blue];
		j2220971040 -> j635246167;
	j1634719916 [label="Je n'aurais guère eu d'autre choix, n'est-ce pas? Nulle part où aller, nulle part où se cacher.",shape=box,color=blue];
		j1634719916 -> j635246167;
	j2748219194 [label="En cas de succès retentissant, j'aurais poursuivi avec la deuxième phase du plan.",shape=box,color=blue];
		j2748219194 -> j422107717;
		j2748219194 -> j691236860;
	j2186479392 [label="Bien. Je dirais que c'était une affaire complexe qui a nécessité d'importantes négociations entre nous.",shape=box,color=blue];
		j2186479392 -> j3140620858;
		j2186479392 -> j308043726;
	j1874914634 [label="Des siècles sous le sable.",shape=box,color=blue];
		j1874914634 -> j1861383400;
	j1861383400 [label="Boolean RoatheExecutor2 is now true.",color=orange];
		j1861383400 -> j1717274806;
	j635246167 [label="Nitokh avait clairement fait comprendre que si nous échouions, je serais sacrifié publiquement.",shape=box,color=blue];
		j635246167 -> j1972128164;
		j635246167 -> j1488761334;
	j422107717 [label="Quelle était la deuxième phase?",shape=box,color=red];
		j422107717 -> j66505485;
	j691236860 [label="Tuer Nitokh?",shape=box,color=red];
		j691236860 -> j596495675;
	j1717274806 [label="Evaluate expressions on HellStory counter",color=orange];
		j1717274806 -> j713698025 [label="x >= 7",color=purple];
		j1717274806 -> j2472164711 [label="x < 7",color=purple];
		j1717274806 -> j2472164711 [label="false",color=purple];
	j1972128164 [label="Et cela te convenait?",shape=box,color=red];
		j1972128164 -> j220640606;
	j1488761334 [label="Te menacer n'était pas une très bonne idée si elle voulait ta loyauté.",shape=box,color=red];
		j1488761334 -> j600615221;
	j66505485 [label="L'assassinat de Nitokh, bien sûr. Rien de surprenant. Elle savait elle-même que cela risquait d'arriver et me taquinait régulièrement.",shape=box,color=blue];
		j66505485 -> j461194216;
		j66505485 -> j2948023945;
	j596495675 [label="+5 Chemistry",color=orange];
		j596495675 -> j1275536292;
	j713698025 [label="Comme tu le sais, j'étais l'un de ses nombreux jouets.",shape=box,color=blue];
		j713698025 -> j2979567824;
	j2472164711 [label="J'étais l'un de ses nombreux partenaires, tu comprends.",shape=box,color=blue];
		j2472164711 -> j875972078;
		j2472164711 -> j670654933;
	j220640606 [label="+5 Chemistry",color=orange];
		j220640606 -> j1523386279;
	j600615221 [label="Une chose que tu dois comprendre à propos des Orokins, c'est que nous avons toujours comploté les uns contre les autres. ",shape=box,color=blue];
		j600615221 -> j2966146167;
	j461194216 [label="Et elle acceptait ça?",shape=box,color=red];
		j461194216 -> j1671679416;
	j2948023945 [label="Vous saviez tous les deux que vous alliez vous entretuer?",shape=box,color=red];
		j2948023945 -> j2140428587;
	j1275536292 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1275536292 -> j1055317861 [label=true,color=green];
		j1275536292 -> j4219933494 [label=false,color=brown];
	j2979567824 [label="J'ai longtemps cru que nous étions partenaires. En politique, dans les intrigues, au lit…",shape=box,color=blue];
		j2979567824 -> j944891884;
	j875972078 [label="Partenaires d'affaires?",shape=box,color=red];
		j875972078 -> j921604625;
	j670654933 [label="Partenaires, comment?",shape=box,color=red];
		j670654933 -> j262520498;
	j1523386279 [label="Pas vraiment. Mis une chose que tu dois comprendre à propos des Orokins, c'est que nous avons toujours comploté les uns contre les autres. ",shape=box,color=blue];
		j1523386279 -> j2966146167;
	j2966146167 [label="Je savais que Nitokh me tuerait sans hésiter à n'importe quel moment si cela pouvait ne serait-ce qu'un peu l'aider à atteindre ses objectifs.",shape=box,color=blue];
		j2966146167 -> j2555082197;
	j1671679416 [label="Je crois qu'elle appréciait le défi, Usurpateur. Le sentiment de danger. Le frisson de savoir qu'elle couchait avec quelqu'un qui voulait sa mort.",shape=box,color=blue];
		j1671679416 -> j919209041;
	j2140428587 [label="J'aimerais dire que nous étions les premiers Orokins à nous retrouver dans une telle situation, mais ce n'était même pas rare, en fait.",shape=box,color=blue];
		j2140428587 -> j919209041;
	j1055317861 [label="Exactement! On dirait que tu as déjà entendu ça. Mais ce n'est guère surprenant. Elle me taquinait régulièrement.",shape=box,color=blue];
		j1055317861 -> j461194216;
		j1055317861 -> j2948023945;
	j4219933494 [label="Exactement! Mais il n'y avait rien de surprenant. Elle l'avait vu venir et me taquinait régulièrement.",shape=box,color=blue];
		j4219933494 -> j461194216;
		j4219933494 -> j2948023945;
	j944891884 [label="Je ne nous considérais évidemment pas comme égaux. Elle était Exécutrice. La Grande Nitokh. Mais je me voyais comme le premier de ses subordonnés.",shape=box,color=blue];
		j944891884 -> j100741480;
	j921604625 [label="Tu es adorable. Oui, en quelque sorte, nous étions associés en affaires. Mais nous étions aussi associés à bien d'autres égards, bien plus importants.",shape=box,color=blue];
		j921604625 -> j262520498;
	j262520498 [label="À la guerre. En politique. Dans les intrigues. Au lit.",shape=box,color=blue];
		j262520498 -> j869137144;
	j2555082197 [label="Toutefois, elle savait que j'affûtais mes couteaux dans son dos et que j'attendais avec impatience le moment où je lui trancherais la tête.",shape=box,color=blue];
		j2555082197 -> j3690346670;
	j919209041 [label="Plus je vieillis, plus je me rends compte que nous ne sommes peut-être pas une espèce faite pour l'immortalité.",shape=box,color=blue];
		j919209041 -> j3044848909;
	j100741480 [label="Quel imbécile j'ai été...",shape=box,color=blue];
		j100741480 -> j2257847681;
		j100741480 -> j3157418712;
		j100741480 -> j1687332243;
		j100741480 -> j3406602832;
		j100741480 -> j935317125;
	j869137144 [label="Mais je me demande si mes souvenirs sont exacts. Je me demande si le terme \"partenaire\" n’est pas exagéré pour décrire ce que nous étions réellement. ",shape=box,color=blue];
		j869137144 -> j1653143792;
	j3690346670 [label="On pourrait dire que nous avions une relation... complexe.",shape=box,color=blue];
		j3690346670 -> j935317125;
		j3690346670 -> j3406602832;
		j3690346670 -> j1687332243;
		j3690346670 -> j2257847681;
		j3690346670 -> j3157418712;
	j3044848909 [label="Mais oui. On pourrait dire que Nitokh et moi avions une relation... complexe.",shape=box,color=blue];
		j3044848909 -> j935317125;
		j3044848909 -> j3406602832;
		j3044848909 -> j1687332243;
		j3044848909 -> j2257847681;
		j3044848909 -> j3157418712;
	j2257847681 [label="Est-ce que tu tenais à elle?",shape=box,color=red];
		j2257847681 -> j1217812715;
	j3157418712 [label="Est-ce que tu l'aimais?",shape=box,color=red];
		j3157418712 -> j2582030143;
	j1687332243 [label="Est-ce que tu lui faisais confiance?",shape=box,color=red];
		j1687332243 -> j47620304;
	j3406602832 [label="Ne regrette pas ce que tu as fait. Tu as fait tes choix. On ne peut pas revenir en arrière. Il faut aller de l'avant.",shape=box,color=red];
		j3406602832 -> j2600789078;
	j935317125 [label="La seule chose que nous puissions faire pour réparer nos erreurs passées, c'est regarder devant nous avec lucidité.",shape=box,color=red];
		j935317125 -> j3869114999;
	j1653143792 [label="Elle était après tout la Grande Nitokh. Une Exécutrice.",shape=box,color=blue];
		j1653143792 -> j100741480;
	j1217812715 [label="Par le Néant, non! Si elle s'était égarée dans un sas, en état d'ivresse, cela aurait résolu une grande partie de mes satanés problèmes.",shape=box,color=blue];
		j1217812715 -> j750080271;
	j2582030143 [label="+5 Chemistry",color=orange];
		j2582030143 -> j806052133;
	j47620304 [label="Par le Néant, non! Ne fais jamais confiance à un Orokin, Voyageur. Moi y compris. Surtout pas à moi! Aime-nous, déteste-nous, adore-nous, méprise-nous – mais ne nous fais jamais confiance.",shape=box,color=blue];
		j47620304 -> j2852132937;
	j2600789078 [label="Add -1 to Thermostat counter",color=orange];
		j2600789078 -> j1398344785;
	j3869114999 [label="Add 1 to Thermostat counter",color=orange];
		j3869114999 -> j571946532;
	j750080271 [label="Je la détestais totalement, sincèrement et je n'aurais rien aimé de plus que de lui arracher lentement, soigneusement, délicatement sa peau bleue à mains nues.",shape=box,color=blue];
		j750080271 -> j3672894206;
		j750080271 -> j1317794072;
	j806052133 [label="Quelle question impertinente! Je crois que je t'adore de l'avoir posée. Tu sais, je crois que je l'aimais, un tout petit peu. Franchement, je n'y avais même pas pensé jusqu'à maintenant.",shape=box,color=blue];
		j806052133 -> j450615174;
	j2852132937 [label="Nous sommes sujets à des accès d'impatience.",shape=box,color=blue];
		j2852132937 -> j3713702031;
		j2852132937 -> j3782951879;
	j1398344785 [label="+10 Chemistry",color=orange];
		j1398344785 -> j1834936155;
	j571946532 [label="+10 Chemistry",color=orange];
		j571946532 -> j2613960517;
	j3672894206 [label="C'était... précis.",shape=box,color=red];
		j3672894206 -> j3870569666;
	j1317794072 [label="Et pourtant, tu couchais avec elle?",shape=box,color=red];
		j1317794072 -> j2663761183;
	j450615174 [label="Oui, je crois que j'étais un tout petit peu amoureux d'elle. Quelle drôle de constatation…",shape=box,color=blue];
		j450615174 -> j1586733951;
	j3713702031 [label="C'est noté.",shape=box,color=red];
		j3713702031 -> j3607220764;
	j3782951879 [label="Cela ne posera pas de problème.",shape=box,color=red];
		j3782951879 -> j2603810366;
	j1834936155 [label="Tu as peut-être raison. Vivre dans le passé est dangereux, car on s'accable de regrets et de honte, et rien d'autre. ",shape=box,color=blue];
		j1834936155 -> j357343815;
	j2613960517 [label="Tu as peut-être raison. Vivre dans le passé est dangereux, car on s'accable de regrets et de honte, et rien d'autre. ",shape=box,color=blue];
		j2613960517 -> j1627815923;
	j3870569666 [label="Le simple fait de me le représenter mentalement était la seule chose qui me permettait de supporter nombre de mes... soirées obligatoires dans son lit. Je m'excuse.",shape=box,color=blue];
		j3870569666 -> j3463604243;
		j3870569666 -> j1689354809;
	j2663761183 [label="Le fait que tu penses que ces deux choses sont incompatibles est absolument adorable. J'espère que tu auras un jour l'occasion de passer une soirée avec une telle \"connaissance\", c'est vraiment magique.",shape=box,color=blue];
		j2663761183 -> j1131195290;
	j1586733951 [label="Tu dois comprendre que ce sentiment était aussi teinté d'une violence inouïe. Je la méprisais profondément et je n'aurais rien désiré plus que de lui arracher lentement, délicatement, sa peau bleue à mains nues.",shape=box,color=blue];
		j1586733951 -> j4062113999;
		j1586733951 -> j2260050520;
	j3607220764 [label="Evaluate expressions",color=orange];
		j3607220764 -> j22125109 [label="RoatheDatingDeal",color=purple];
