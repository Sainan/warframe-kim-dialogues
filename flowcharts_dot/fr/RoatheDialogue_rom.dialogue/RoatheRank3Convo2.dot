		j3115859521 -> j2936623290;
	j4172057149 [label="Mais fais comme tu veux. N'hésite pas à me dire si je peux t'être utile. Je trouve très amusant de vous voir, toi et ce cul de bénitier, vous embourber dans toutes sortes d'intrigues émotionnelles inutiles.",shape=box,color=blue];
