		j720612177 -> j80123134;
	j2188814060 [label="Le fait que tu n'aies jamais vécu une telle chose est une chance, Usurpateur. Je te déconseille fortement de te retrouver dans une telle situation; elle se termine généralement par un meurtre, pour l'un ou l'autre, voire les deux.",shape=box,color=blue];
