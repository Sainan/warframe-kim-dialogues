		j2906871533 -> j2879259330;
	j2879259330 [label="Maintenant, si tu parles de sentiments à sens unique? Oh, très certainement. Mais ce n’est pas une histoire d’amour, n’est-ce pas? C’est une tragédie.",shape=box,color=blue];
