	j222968731 [label="Ce n'est pas assez clair? Très bien. Je n'ai jamais été amoureux.",shape=box,color=blue];
		j222968731 -> j2879259330;
	j1996174760 [label="Malgré tous nos progrès, malgré tout le travail accompli pour sauver l'humanité, nous n'avons jamais résolu le plus grand problème qui nous rongeait. Le plus grand défaut qui nous consumait l'âme comme un cancer atroce.",shape=box,color=blue];
		j1996174760 -> j1820723781;
	j2310237450 [label="Fais-en bon usage. Tu sembles faire de ton mieux pour mener une bonne vie, Voyageur. Pour être une \"bonne\" personne. Je détesterais te voir finir comme les Orokins. Nous étions définis par nos excès.",shape=box,color=blue];
		j2310237450 -> j1206902850;
	j3189424444 [label="Mais je t'en prie. Tu sembles faire de ton mieux pour mener une bonne vie, Voyageur. Pour être une \"bonne\" personne. Je détesterais te voir finir comme les Orokins. Nous étions définis par nos excès.",shape=box,color=blue];
		j3189424444 -> j1206902850;
	j3788359156 [label="Je me suis toujours lancé que dans des relations purement physiques, Voyageur. Je n'ai jamais eu de relations affectives. Du moins, aucune qui fût réciproque.",shape=box,color=blue];
		j3788359156 -> j2633103291;
		j3788359156 -> j2428462392;
	j18228641 [label="Pathétique, n'est-ce pas? Malgré tous les progrès de l'univers, nous n'avons toujours pas réussi à nous organiser sans perdre des heures de notre vie à discuter sans s'écouter.",shape=box,color=blue];
		j18228641 -> j1996174760;
