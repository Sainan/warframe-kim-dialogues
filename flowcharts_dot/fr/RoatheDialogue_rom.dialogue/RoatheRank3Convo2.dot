		j3607220764 -> j2438926351 [label="DrifterLyon",color=purple];
		j3607220764 -> j2717026342 [label="false",color=purple];
	j2603810366 [label="Mm, oui. J'ai l'impression que je ne parviens pas vraiment à te séduire avec mon \"charme diabolique\", n'est-ce pas?",shape=box,color=blue];
		j2603810366 -> j3481312453;
		j2603810366 -> j61537200;
	j357343815 [label="À quoi bon ressasser nos actes passés, nos échecs et nos regrets? Nous ne pouvons les changer – même avec ce don du voyage dans le temps, tenter de \"refaire\" ce qui a été \"fait\" est une voie qui mène à la folie.",shape=box,color=blue];
		j357343815 -> j1460314823;
	j1627815923 [label="Mais nous ne pouvons pas non plus oublier les méfaits de notre ancien moi, car nous risquons de devenir des fous et des despotes, des créatures belliqueuses qui ne voient aucun défaut en elles-mêmes et seulement chez les autres.",shape=box,color=blue];
		j1627815923 -> j800571232;
	j3463604243 [label="As-tu ce genre de pensées à propos de tous tes partenaires? Ou seulement d'elle?",shape=box,color=red];
		j3463604243 -> j4185135142;
	j1689354809 [label="Pas besoin de t'excuser. Je suis simplement encore sous le choc de voir à quel point tu détestais ton propre peuple.",shape=box,color=red];
		j1689354809 -> j3153084126;
	j1131195290 [label="Je te recommande simplement de ne pas faire de telles relations une situation permanente. Cela devient extrêmement malsain pour les deux personnes. Cela se termine généralement par un meurtre, pour l'un ou les deux.",shape=box,color=blue];
		j1131195290 -> j3463604243;
		j1131195290 -> j707551986;
		j1131195290 -> j720612177;
	j4062113999 [label="Comment ces deux affirmations peuvent-elles être vraies en même temps?",shape=box,color=red];
		j4062113999 -> j2188814060;
	j2260050520 [label="C'était... précis.",shape=box,color=red];
		j2260050520 -> j927303875;
	j22125109 [label="Je pensais simplement qu'il était de mon devoir de te prévenir, vu que nous avons notre petit... arrangement.",shape=box,color=blue];
		j22125109 -> j987917146;
	j3297955907 [label="Hum, mais ça ne te posera jamais de problème, n'est-ce pas? Tu as les yeux rivés sur Marie, d'où notre petit \"arrangement\".",shape=box,color=blue];
		j3297955907 -> j2809339000;
	j2438926351 [label="Hum, mais ça ne te posera jamais de problème, n'est-ce pas? Tu as les yeux rivés sur ce prêtre cinglé, pas vrai?",shape=box,color=blue];
		j2438926351 -> j1554723813;
	j2061054214 [label="Je pensais simplement qu'il était de mon devoir de t'avertir, étant donné que tu as fait connaître tes... intérêts.",shape=box,color=blue];
		j2061054214 -> j987917146;
	j1367323282 [label="Hum, mais ça ne te posera jamais de problème, n'est-ce pas? Tu as les yeux rivés sur Marie, pas vrai?",shape=box,color=blue];
		j1367323282 -> j2809339000;
	j2717026342 [label="+5 Chemistry",color=orange];
		j2717026342 -> j3208765523;
	j3481312453 [label="Non. Je regrette. Tu n'es pas mon genre.",shape=box,color=red];
		j3481312453 -> j801921165;
	j61537200 [label="Si. Mais je ne te fais pas confiance.",shape=box,color=red];
		j61537200 -> j4137689758;
	j1460314823 [label="Non. Je suis ce que je suis. Je suis qui je suis. Je suis le chemin que j'ai choisi et je n'ai plus besoin de m'excuser. Je ne changerai pas pour plaire aux autres.",shape=box,color=blue];
		j1460314823 -> j3974694888;
	j800571232 [label="J'observais ce trait chez nombre des plus misérables Exécuteurs et Empereurs: une foi aveugle en leur propre personne, qu'ils estimaient irréprochable et innocente. Je les méprisais pour cela et jurais de ne jamais partager un tel orgueil démesuré.",shape=box,color=blue];
		j800571232 -> j3974694888;
	j4185135142 [label="Je me suis toujours lancé que dans des relations purement physiques, Voyageur. Je n'ai jamais eu de relations affectives. Du moins, aucune qui fût réciproque.",shape=box,color=blue];
		j4185135142 -> j2633103291;
		j4185135142 -> j2428462392;
