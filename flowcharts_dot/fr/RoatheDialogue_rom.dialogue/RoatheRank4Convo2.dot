		j36104292 -> j187174552 [label="RoatheBirdThree",color=purple];
		j36104292 -> j3459589970 [label="false",color=purple];
	j3615898718 [label="Son nom est unique pour toi.",shape=box,color=blue];
		j3615898718 -> j4055527250;
	j3415867222 [label="Ne pousse pas ta chance, Usurpateur. \"Apprécier\" est un euphémisme. Disons plutôt que vous commencez à me plaire. Comme de la moisissure.",shape=box,color=blue];
		j3415867222 -> j1328807703;
	j548185179 [label="\"Apprécier\"? C’est l'idée? Je ne me croyais pas aussi masochiste. Hum. Ou est-ce simplement la sensation de mon corps qui se décompose et le sentiment que vous tous \"commencez à me plaire\"?",shape=box,color=blue];
		j548185179 -> j964828007;
	j187174552 [label="C'est plutôt agréable d'avoir quelqu'un à qui parler. Même si, comme tu l'as dit, vous êtes parfois agaçants.",shape=box,color=blue];
		j187174552 -> j97244113;
	j3459589970 [label="La solitude? Pfff. La seule chose que tu combats, c'est le retour timide de la raison dans ma vie. Si tu insinues que vous commencez à me plaire, sais-tu à quoi cela s'applique aussi?",shape=box,color=blue];
		j3459589970 -> j2195660567;
	j4055527250 [label="Mais pas pour les étoiles.",shape=box,color=blue];
		j4055527250 -> j2428434723;
	j1328807703 [label="+5 Chemistry",color=orange];
		j1328807703 -> j689414758;
	j964828007 [label="Comme de la moisissure.",shape=box,color=blue];
		j964828007 -> j689414758;
	j97244113 [label="+5 Chemistry",color=orange];
		j97244113 -> j3425524258;
	j2195660567 [label="La moisissure.",shape=box,color=blue];
		j2195660567 -> j689414758;
	j2428434723 [label="Peignez les miens de pourpre autant que vous le souhaitez. Faites fondre l'or Orokin et traitez-nous de monstres. Nous méritons toute la haine que vous pourrez nous témoigner.",shape=box,color=blue];
		j2428434723 -> j3166828683;
	j689414758 [label="Boolean RoatheAlone2 is now true.",color=orange];
		j689414758 -> j1654361623;
	j3425524258 [label="Je dois l'avouer, tu commences à me plaire. Comme de la moisissure.",shape=box,color=blue];
		j3425524258 -> j689414758;
	j3166828683 [label="Mais n'allez surtout pas croire une seule seconde que c'était tout ce dont nous étions capables.",shape=box,color=blue];
		j3166828683 -> j2304932350;
	j1654361623 [label="Check boolean LoidFamilyComplete",color=orange];
		j1654361623 -> j1933300832 [label=true,color=green];
		j1654361623 -> j4007542382 [label=false,color=brown];
	j2304932350 [label="Si tu souhaites exterminer tous les Orokins, monte les escaliers. Il te reste quelques survivants qui ne pourront échapper à ta colère. Commence par \"Grand-Mère\".",shape=box,color=blue];
		j2304932350 -> j122526125;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j4007542382 [label="Il y a une autre raison pour laquelle je ne me suis pas lancé dans une fureur meurtrière, Usurpateur.",shape=box,color=blue];
		j4007542382 -> j1855221966;
	j122526125 [label="Après tout, elle en a vu beaucoup.",shape=box,color=blue];
		j122526125 -> j155006797;
	j1855221966 [label="Je n'ai pas encore vu le dénouement de cette petite intrigue entre notre cher majordome et la famille d'Albrecht, avec laquelle il est brouillé, à l'étage.",shape=box,color=blue];
		j1855221966 -> j3882056411;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j3882056411 [label="N'oublie pas que j'ai un intérêt personnel dans tout cela, qu'il y ait un accord ou non. Je compte m'assurer que lorsqu'Albrecht remettra les pieds à Sanctum, le premier visage qu'il verra...",shape=box,color=blue];
		j3882056411 -> j480092857;
	j480092857 [label="Ce sera le mien.",shape=box,color=blue];
		j480092857 -> j3356876802;
	j3356876802 [label="Je n'arrive tout simplement pas encore à me décider si je serai entouré des cadavres de ses proches ou non lorsqu'il mourra.",shape=box,color=blue];
		j3356876802 -> j777642805;
	j777642805 [label="Ah, les décisions...",shape=box,color=blue];
		j777642805 -> j1933300832;
