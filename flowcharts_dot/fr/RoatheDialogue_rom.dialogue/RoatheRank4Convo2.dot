		2445 -> 2449 [label="RoatheAlone1",color=purple];
		2445 -> 2449 [label="RoatheBirdThree",color=purple];
		2445 -> 2450 [label="false",color=purple];
	2446 [label="Son nom est unique pour toi.",shape=box,color=blue];
		2446 -> 2451;
	2448 [label="Ne pousse pas ta chance, Usurpateur. \"Apprécier\" est un euphémisme. Disons plutôt que vous commencez à me plaire. Comme de la moisissure.",shape=box,color=blue];
		2448 -> 2453;
	2447 [label="\"Apprécier\"? C’est l'idée? Je ne me croyais pas aussi masochiste. Hum. Ou est-ce simplement la sensation de mon corps qui se décompose et le sentiment que vous tous \"commencez à me plaire\"?",shape=box,color=blue];
		2447 -> 2452;
	2449 [label="C'est plutôt agréable d'avoir quelqu'un à qui parler. Même si, comme tu l'as dit, vous êtes parfois agaçants.",shape=box,color=blue];
		2449 -> 2454;
	2450 [label="La solitude? Pfff. La seule chose que tu combats, c'est le retour timide de la raison dans ma vie. Si tu insinues que vous commencez à me plaire, sais-tu à quoi cela s'applique aussi?",shape=box,color=blue];
		2450 -> 2455;
	2451 [label="Mais pas pour les étoiles.",shape=box,color=blue];
		2451 -> 2456;
	2453 [label="+5 Chemistry",color=orange];
		2453 -> 2457;
	2452 [label="Comme de la moisissure.",shape=box,color=blue];
		2452 -> 2457;
	2454 [label="+5 Chemistry",color=orange];
		2454 -> 2458;
	2455 [label="La moisissure.",shape=box,color=blue];
		2455 -> 2457;
	2456 [label="Peignez les miens de pourpre autant que vous le souhaitez. Faites fondre l'or Orokin et traitez-nous de monstres. Nous méritons toute la haine que vous pourrez nous témoigner.",shape=box,color=blue];
		2456 -> 2459;
	2457 [label="Update boolean RoatheAlone2",color=orange];
		2457 -> 2460;
	2458 [label="Je dois l'avouer, tu commences à me plaire. Comme de la moisissure.",shape=box,color=blue];
		2458 -> 2457;
	2459 [label="Mais n'allez surtout pas croire une seule seconde que c'était tout ce dont nous étions capables.",shape=box,color=blue];
		2459 -> 2461;
	2460 [label="Check boolean LoidFamilyComplete",color=orange];
		2460 -> 2462 [label=true,color=green];
		2460 -> 2463 [label=false,color=brown];
	2461 [label="Si tu souhaites exterminer tous les Orokins, monte les escaliers. Il te reste quelques survivants qui ne pourront échapper à ta colère. Commence par \"Grand-Mère\".",shape=box,color=blue];
		2461 -> 2464;
	2462 [label="+10 Chemistry",color=orange];
		2462 -> 2465;
	2463 [label="Il y a une autre raison pour laquelle je ne me suis pas lancé dans une fureur meurtrière, Usurpateur.",shape=box,color=blue];
		2463 -> 2466;
	2464 [label="Après tout, elle en a vu beaucoup.",shape=box,color=blue];
		2464 -> 2467;
	2465 [label="Chat ends.",color=orange];
	2466 [label="Je n'ai pas encore vu le dénouement de cette petite intrigue entre notre cher majordome et la famille d'Albrecht, avec laquelle il est brouillé, à l'étage.",shape=box,color=blue];
		2466 -> 2468;
	2467 [label="Update boolean RoatheNoDate",color=orange];
		2467 -> 2469;
	2468 [label="N'oublie pas que j'ai un intérêt personnel dans tout cela, qu'il y ait un accord ou non. Je compte m'assurer que lorsqu'Albrecht remettra les pieds à Sanctum, le premier visage qu'il verra...",shape=box,color=blue];
		2468 -> 2470;
	2469 [label="Chat ends.",color=orange];
	2470 [label="Ce sera le mien.",shape=box,color=blue];
		2470 -> 2471;
	2471 [label="Je n'arrive tout simplement pas encore à me décider si je serai entouré des cadavres de ses proches ou non lorsqu'il mourra.",shape=box,color=blue];
		2471 -> 2472;
	2472 [label="Ah, les décisions...",shape=box,color=blue];
		2472 -> 2473;
	2473 [label="+10 Chemistry",color=orange];
		2473 -> 2474;
