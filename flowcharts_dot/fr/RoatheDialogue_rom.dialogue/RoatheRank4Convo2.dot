	j3866247454 [label="Tu en as les moyens. Tu en as la force. Tu as suffisamment exprimé ton mécontentement face à ta situation.",shape=box,color=red];
		j3866247454 -> j4275009050;
	j1340421847 [label="Je ne comprends simplement pas pourquoi \"le Diable de Tau\" se contente de rester dans une crypte à se tourner les pouces. Même avec notre accord.",shape=box,color=red];
		j1340421847 -> j2206556128;
	j2024873642 [label="Tu es Orokin. Tu détestes clairement tout le monde autour de toi. Qu'est-ce qui t'en empêche?",shape=box,color=red];
		j2024873642 -> j873899058;
	j1740260032 [label="Je ne comprends simplement pas pourquoi \"le Diable de Tau\" se contente de rester assis dans une crypte à se tourner les pouces. Surtout qu'on n'a conclu aucun accord.",shape=box,color=red];
		j1740260032 -> j3657429577;
	j4275009050 [label="+5 Chemistry",color=orange];
		j4275009050 -> j3105651342;
	j2206556128 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2206556128 -> j3600688142 [label=true,color=green];
		j2206556128 -> j3688068016 [label=false,color=brown];
	j873899058 [label="Excuse-moi pendant que je prends un instant pour rassembler mes idées avant d'entamer cette conversation dans un endroit qui n'est que rage et rancune.",shape=box,color=blue];
		j873899058 -> j1241708440;
	j3657429577 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3657429577 -> j3600688142 [label=true,color=green];
		j3657429577 -> j2657047321 [label=false,color=brown];
	j3105651342 [label="Et je suis ravi que tu reconnaisses que je suis tout à fait capable de transformer cet endroit en abattoir.",shape=box,color=blue];
		j3105651342 -> j899567627;
	j3600688142 [label="Car il reste encore le mystère de savoir pourquoi je t'ai fait suffisamment confiance pour te confier tant de choses, pour ensuite te voir trahir cette confiance, Usurpateur.",shape=box,color=blue];
		j3600688142 -> j282096204;
	j3688068016 [label="Il reste encore du travail à faire, Usurpateur. Je ne peux pas vraiment compter sur ton aide pour recouvrer la mémoire si je me mets à massacrer tous ceux qui m'entourent, n'est-ce pas?",shape=box,color=blue];
		j3688068016 -> j2194471954;
	j1241708440 [label="Tandis que je m'efforce de ne pas te donner immédiatement raison.",shape=box,color=blue];
		j1241708440 -> j3766402300;
	j2657047321 [label="J'espère peut-être que tu finiras par comprendre et changer d'avis. Et les chances que cela se produise diminuent considérablement si je me mets à massacrer tous ceux qui se trouvent aux alentours, n'est-ce pas?",shape=box,color=blue];
		j2657047321 -> j2194471954;
	j899567627 [label="Mais cela ne servirait à rien, n'est-ce pas? S'il y a une chose que l'on ne peut apprendre de la guerre, c'est que le meurtre, au final, n'est pas très productif.",shape=box,color=blue];
		j899567627 -> j2262869476;
	j282096204 [label="Et les chances que cela se produise diminuent considérablement si je massacre tous ceux qui se trouvent aux alentours, n'est-ce pas? S'il y a une seule chose que l'on apprend de la guerre, c'est que le meurtre est finalement peu productif.",shape=box,color=blue];
		j282096204 -> j4086794866;
	j2194471954 [label="D'ailleurs, cela ne servirait à rien, n'est-ce pas? S'il y a une chose que l'on ne peut apprendre de la guerre, c'est que le meurtre, au final, n'est pas très productif.",shape=box,color=blue];
		j2194471954 -> j4086794866;
	j3766402300 [label="Je comprends ta haine envers les Orokins. Crois-moi, la plupart des Orokins méprisaient les Orokins. Je n'ignore rien de nos crimes. Des atrocités que nous avons commises. ",shape=box,color=blue];
		j3766402300 -> j3690093545;
	j2262869476 [label="Aussi agréable que puisse être le désir de s'y adonner un peu de temps en temps.",shape=box,color=blue];
		j2262869476 -> j2152995135;
		j2262869476 -> j1406213140;
		j2262869476 -> j1205405146;
	j4086794866 [label="Aussi agréable que puisse être le désir de s'y adonner un peu de temps en temps.",shape=box,color=blue];
		j4086794866 -> j1205405146;
		j4086794866 -> j1406213140;
		j4086794866 -> j2152995135;
	j3690093545 [label="Le théâtre Yuvan à lui seul justifierait de raser notre société. Mais tu condamnes tout un peuple... dont tu proviens toi-même, soit dit en passant, Usurpateur.",shape=box,color=blue];
		j3690093545 -> j3151203593;
	j2152995135 [label="Donc, la seule raison pour laquelle tu laisses tout le monde en vie, c'est que ça n'aurait aucune utilité de les tuer?",shape=box,color=red];
		j2152995135 -> j1257170145;
	j1406213140 [label="Il n'y a pas d'autre raison pour laquelle tu laisses tout le monde en vie?",shape=box,color=red];
		j1406213140 -> j2011595750;
	j1205405146 [label="Même Marie et Lyon?",shape=box,color=red];
		j1205405146 -> j1665807075;
	j3151203593 [label="Tu ignores tout de toutes ces âmes charitables qui ont peiné et péri entre ces murs dorés. Les sagas écrites sur ces vies à jamais perdues dans les méandres du temps.",shape=box,color=blue];
		j3151203593 -> j2519719440;
	j1257170145 [label="Les tuer serait inutile. Non? Essaies-tu de me convaincre du contraire? Usurpateur, je suis impressionné; je ne pensais pas que tu étais un monstre aussi rusé!",shape=box,color=blue];
		j1257170145 -> j3619131691;
		j1257170145 -> j3181568421;
	j2011595750 [label="Si tu comptes faire des insinuations, Usurpateur, vas-y franchement.",shape=box,color=blue];
		j2011595750 -> j3619131691;
		j2011595750 -> j3181568421;
	j1665807075 [label="Je suis presque certain que si tu descendais dans la crypte et que tu y trouvais des traces de sang là où se tenaient les fanatiques, je me ferais sérieusement ramasser, n'est-ce pas?",shape=box,color=blue];
		j1665807075 -> j3592878797;
	j2519719440 [label="Les rivières de larmes versées pour les tragédies qui resteront à jamais oubliées, simplement parce qu'elles te sont inconnues.",shape=box,color=blue];
		j2519719440 -> j1579051177;
	j3619131691 [label="Il n'y a pas de mal à admettre que tu apprécies la compagnie. Les gens peuvent faire bien plus que simplement remplir une fonction utilitaire.",shape=box,color=red];
		j3619131691 -> j796436421;
	j3181568421 [label="Il n'y a pas de mal à admettre que nous cherchons à combattre la solitude, même si nous t'agaçons.",shape=box,color=red];
		j3181568421 -> j134072315;
	j3592878797 [label="Par toi, ou le majordome, ou le Tenno, ou de la terrifiante \"Mère\" des Tennos. Beurk. Celle-là. Celle-là m'inquiète. On en reparlera.",shape=box,color=blue];
		j3592878797 -> j3181568421;
		j3592878797 -> j3619131691;
	j1579051177 [label="J'entends ton petit double pleurer le nom d'Adis. ",shape=box,color=blue];
		j1579051177 -> j942537826;
	j796436421 [label="Add 1 to Thermostat counter",color=orange];
		j796436421 -> j3607629830;
	j134072315 [label="Add -1 to Thermostat counter",color=orange];
		j134072315 -> j36104292;
	j942537826 [label="Adis était un parmi des millions.",shape=box,color=blue];
		j942537826 -> j3615898718;
	j3607629830 [label="Evaluate expressions",color=orange];
		j3607629830 -> j3415867222 [label="RoatheUnloved2",color=purple];
