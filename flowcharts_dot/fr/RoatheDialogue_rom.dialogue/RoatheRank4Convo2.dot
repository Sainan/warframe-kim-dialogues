		2407 -> 2411 [label="false",color=purple];
	2409 [label="Tu en as les moyens. Tu en as la force. Tu as suffisamment exprimé ton mécontentement face à ta situation.",shape=box,color=red];
		2409 -> 2413;
	2410 [label="Je ne comprends simplement pas pourquoi \"le Diable de Tau\" se contente de rester dans une crypte à se tourner les pouces. Même avec notre accord.",shape=box,color=red];
		2410 -> 2414;
	2411 [label="Tu es Orokin. Tu détestes clairement tout le monde autour de toi. Qu'est-ce qui t'en empêche?",shape=box,color=red];
		2411 -> 2415;
	2408 [label="Je ne comprends simplement pas pourquoi \"le Diable de Tau\" se contente de rester assis dans une crypte à se tourner les pouces. Surtout qu'on n'a conclu aucun accord.",shape=box,color=red];
		2408 -> 2412;
	2413 [label="+5 Chemistry",color=orange];
		2413 -> 2418;
	2414 [label="Check boolean RoatheKnowsReset2",color=orange];
		2414 -> 2420 [label=true,color=green];
		2414 -> 2419 [label=false,color=brown];
	2415 [label="Excuse-moi pendant que je prends un instant pour rassembler mes idées avant d'entamer cette conversation dans un endroit qui n'est que rage et rancune.",shape=box,color=blue];
		2415 -> 2421;
	2412 [label="Check boolean RoatheKnowsReset2",color=orange];
		2412 -> 2417 [label=true,color=green];
		2412 -> 2416 [label=false,color=brown];
	2418 [label="Et je suis ravi que tu reconnaisses que je suis tout à fait capable de transformer cet endroit en abattoir.",shape=box,color=blue];
		2418 -> 2424;
	2420 [label="Car il reste encore le mystère de savoir pourquoi je t'ai fait suffisamment confiance pour te confier tant de choses, pour ensuite te voir trahir cette confiance, Usurpateur.",shape=box,color=blue];
		2420 -> 2423;
	2419 [label="Il reste encore du travail à faire, Usurpateur. Je ne peux pas vraiment compter sur ton aide pour recouvrer la mémoire si je me mets à massacrer tous ceux qui m'entourent, n'est-ce pas?",shape=box,color=blue];
		2419 -> 2422;
	2421 [label="Tandis que je m'efforce de ne pas te donner immédiatement raison.",shape=box,color=blue];
		2421 -> 2425;
	2417 [label="Car il reste encore le mystère de savoir pourquoi je t'ai fait suffisamment confiance pour te confier tant de choses, pour ensuite te voir trahir cette confiance, Usurpateur.",shape=box,color=blue];
		2417 -> 2423;
	2416 [label="J'espère peut-être que tu finiras par comprendre et changer d'avis. Et les chances que cela se produise diminuent considérablement si je me mets à massacrer tous ceux qui se trouvent aux alentours, n'est-ce pas?",shape=box,color=blue];
		2416 -> 2422;
	2424 [label="Mais cela ne servirait à rien, n'est-ce pas? S'il y a une chose que l'on ne peut apprendre de la guerre, c'est que le meurtre, au final, n'est pas très productif.",shape=box,color=blue];
		2424 -> 2427;
	2423 [label="Et les chances que cela se produise diminuent considérablement si je massacre tous ceux qui se trouvent aux alentours, n'est-ce pas? S'il y a une seule chose que l'on apprend de la guerre, c'est que le meurtre est finalement peu productif.",shape=box,color=blue];
		2423 -> 2426;
	2422 [label="D'ailleurs, cela ne servirait à rien, n'est-ce pas? S'il y a une chose que l'on ne peut apprendre de la guerre, c'est que le meurtre, au final, n'est pas très productif.",shape=box,color=blue];
		2422 -> 2426;
	2425 [label="Je comprends ta haine envers les Orokins. Crois-moi, la plupart des Orokins méprisaient les Orokins. Je n'ignore rien de nos crimes. Des atrocités que nous avons commises. ",shape=box,color=blue];
		2425 -> 2428;
	2427 [label="Aussi agréable que puisse être le désir de s'y adonner un peu de temps en temps.",shape=box,color=blue];
		2427 -> 2431;
		2427 -> 2430;
		2427 -> 2429;
	2426 [label="Aussi agréable que puisse être le désir de s'y adonner un peu de temps en temps.",shape=box,color=blue];
		2426 -> 2429;
		2426 -> 2430;
		2426 -> 2431;
	2428 [label="Le théâtre Yuvan à lui seul justifierait de raser notre société. Mais tu condamnes tout un peuple... dont tu proviens toi-même, soit dit en passant, Usurpateur.",shape=box,color=blue];
		2428 -> 2432;
	2431 [label="Donc, la seule raison pour laquelle tu laisses tout le monde en vie, c'est que ça n'aurait aucune utilité de les tuer?",shape=box,color=red];
		2431 -> 2435;
	2430 [label="Il n'y a pas d'autre raison pour laquelle tu laisses tout le monde en vie?",shape=box,color=red];
		2430 -> 2434;
	2429 [label="Même Marie et Lyon?",shape=box,color=red];
		2429 -> 2433;
	2432 [label="Tu ignores tout de toutes ces âmes charitables qui ont peiné et péri entre ces murs dorés. Les sagas écrites sur ces vies à jamais perdues dans les méandres du temps.",shape=box,color=blue];
		2432 -> 2436;
	2435 [label="Les tuer serait inutile. Non? Essaies-tu de me convaincre du contraire? Usurpateur, je suis impressionné; je ne pensais pas que tu étais un monstre aussi rusé!",shape=box,color=blue];
		2435 -> 2438;
		2435 -> 2439;
	2434 [label="Si tu comptes faire des insinuations, Usurpateur, vas-y franchement.",shape=box,color=blue];
		2434 -> 2438;
		2434 -> 2439;
	2433 [label="Je suis presque certain que si tu descendais dans la crypte et que tu y trouvais des traces de sang là où se tenaient les fanatiques, je me ferais sérieusement ramasser, n'est-ce pas?",shape=box,color=blue];
		2433 -> 2437;
	2436 [label="Les rivières de larmes versées pour les tragédies qui resteront à jamais oubliées, simplement parce qu'elles te sont inconnues.",shape=box,color=blue];
		2436 -> 2440;
	2438 [label="Il n'y a pas de mal à admettre que tu apprécies la compagnie. Les gens peuvent faire bien plus que simplement remplir une fonction utilitaire.",shape=box,color=red];
		2438 -> 2441;
	2439 [label="Il n'y a pas de mal à admettre que nous cherchons à combattre la solitude, même si nous t'agaçons.",shape=box,color=red];
		2439 -> 2442;
	2437 [label="Par toi, ou le majordome, ou le Tenno, ou de la terrifiante \"Mère\" des Tennos. Beurk. Celle-là. Celle-là m'inquiète. On en reparlera.",shape=box,color=blue];
		2437 -> 2439;
		2437 -> 2438;
	2440 [label="J'entends ton petit double pleurer le nom d'Adis. ",shape=box,color=blue];
		2440 -> 2443;
	2441 [label="Add 1 to Thermostat",color=orange];
		2441 -> 2444;
	2442 [label="Add -1 to Thermostat",color=orange];
		2442 -> 2445;
	2443 [label="Adis était un parmi des millions.",shape=box,color=blue];
		2443 -> 2446;
