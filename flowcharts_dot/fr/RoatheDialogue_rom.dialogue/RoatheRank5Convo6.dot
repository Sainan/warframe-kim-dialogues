		j205127126 -> j865960487;
		j205127126 -> j3397559716;
	j2358997291 [label="Je m'attendais à ce qu'ils accueillent ma honte avec des moqueries, des railleries du genre \"enfin, le diable est vaincu!\". Rien de tout cela. Ils n'en ont quasiment pas parlé.",shape=box,color=blue];
		j2358997291 -> j1918748110;
	j2350258543 [label="Pas du tout comme je m'y attendais. Un soir, alors que je lisais en silence, quelques jours plus tard, il s'est approché de lui-même.",shape=box,color=blue];
		j2350258543 -> j2600763981;
	j865960487 [label="Est-ce que quelque chose a changé à cause de cela?",shape=box,color=red];
		j865960487 -> j1366017263;
	j3397559716 [label="Comment Marie a-t-elle réagi?",shape=box,color=red];
		j3397559716 -> j3246970955;
	j1918748110 [label="Lyon en particulier. Je pense qu'il comprend la difficulté de faire face au passé et aux décisions que nous avons prises. Un rapport avec le cache-œil, si je peux me le permettre.",shape=box,color=blue];
		j1918748110 -> j32725969;
	j2600763981 [label="Il s'est assis à côté de moi et m'a raconté comment, depuis qu'Entrati lui avait donné le sérum, il avait douté de sa foi. Combien il avait honte de ses doutes. Combien il regrettait d'avoir pris le sérum.",shape=box,color=blue];
		j2600763981 -> j565976306;
	j1366017263 [label="Je m'attendais à ce qu'ils accueillent ma honte avec des moqueries, des railleries du genre \"enfin, le diable est vaincu!\". Rien de tout cela. Ils n'en ont quasiment pas parlé.",shape=box,color=blue];
		j1366017263 -> j2896671794;
	j3246970955 [label="Pas du tout comme je m'y attendais. Elle n'a rien dit. Au lieu de cela, elle m'a simplement... pris dans ses bras. ",shape=box,color=blue];
		j3246970955 -> j598317519;
	j32725969 [label="Check boolean LyonConfession2",color=orange];
		j32725969 -> j3073691180 [label=true,color=green];
		j32725969 -> j685457638 [label=true,color=green];
		j32725969 -> j685457638 [label=false,color=brown];
	j565976306 [label="Surtout, il aurait tellement voulu pouvoir tout oublier. Et peut-être, au fond, que nous n'étions pas tous les trois pareils.",shape=box,color=blue];
		j565976306 -> j1014560228;
		j565976306 -> j16025815;
	j2896671794 [label="Surtout Marie. Je pense qu'elle comprend que me confronter sans cesse à propos de choses du passé ne servira à rien.",shape=box,color=blue];
		j2896671794 -> j3137425038;
	j598317519 [label="Evaluate expressions",color=orange];
		j598317519 -> j3338658429 [label="RoatheRedeemed",color=purple];
		j598317519 -> j1889646686 [label="RoatheVillain",color=purple];
		j598317519 -> j1124166842 [label="false",color=purple];
	j3073691180 [label="Je pense qu'il comprend aussi ce que c'est que d'être un produit de votre société et de votre contexte. Il pourrait être plus sensible à ton passé que tu ne le penses.",shape=box,color=red];
		j3073691180 -> j2417963863;
	j685457638 [label="Je me réjouis simplement que vous ayez trouvé une forme d'amitié, même minime. Ne serait-ce qu'une trêve. ",shape=box,color=red];
		j685457638 -> j217578190;
	j1014560228 [label="Qu'est-ce que tu as fait?",shape=box,color=red];
		j1014560228 -> j7185601;
	j16025815 [label="Et Marie?",shape=box,color=red];
		j16025815 -> j1996170497;
	j3137425038 [label="Check boolean MarieEntratiCompleteA",color=orange];
		j3137425038 -> j3265154040 [label=true,color=green];
		j3137425038 -> j3150853709 [label=true,color=green];
		j3137425038 -> j3150853709 [label=false,color=brown];
	j3338658429 [label="Le Roathe d'antan aurait profité de l'occasion pour lui retirer les reins, mais je me suis aperçu que je n'en avais plus envie. ",shape=box,color=blue];
		j3338658429 -> j354073829;
	j1889646686 [label="Il m'a fallu toute ma volonté pour ne pas lui retirer les reins. Mais elle voulait simplement me réconforter.",shape=box,color=blue];
		j1889646686 -> j1461380819;
	j1124166842 [label="Elle voulait simplement m'offrir un peu de réconfort.",shape=box,color=blue];
		j1124166842 -> j627230142;
		j1124166842 -> j34609132;
	j2417963863 [label="+10 Chemistry",color=orange];
		j2417963863 -> j3384448839;
	j217578190 [label="+5 Chemistry",color=orange];
		j217578190 -> j2942415644;
	j7185601 [label="Je lui ai serré la main. Et je l'ai remercié comme un ami. Je suis un Orokin, mais je ne suis pas un monstre.",shape=box,color=blue];
		j7185601 -> j3803766439;
	j1996170497 [label="Quand je lui ai révélé la vérité que nous avions découverte, elle n'a rien dit. Au lieu de cela, elle m'a simplement... pris dans ses bras.",shape=box,color=blue];
		j1996170497 -> j1093047434;
	j3265154040 [label="Surtout après tout ce qu'elle a appris sur Entrati. Elle sait que les gens sont plus complexes que de simples êtres noirs ou blancs.",shape=box,color=red];
		j3265154040 -> j3391510386;
	j3150853709 [label="Je me réjouis simplement que vous ayez trouvé une forme d'amitié, même minime. Ne serait-ce qu'une trêve.",shape=box,color=red];
		j3150853709 -> j1869204288;
	j354073829 [label="Pour une fois dans ma misérable vie, j'ai accepté cette simple offre de réconfort pour ce qu'elle était.",shape=box,color=blue];
		j354073829 -> j1461380819;
	j1461380819 [label="C'était une façon simple de me dire qu'elle ne s'en souciait peut-être pas autant que moi. Et qu'elle était désolée pour toute la souffrance que je m'étais infligée à cause de ça.",shape=box,color=blue];
		j1461380819 -> j627230142;
		j1461380819 -> j34609132;
	j627230142 [label="Et Lyon?",shape=box,color=red];
		j627230142 -> j241101987;
	j34609132 [label="Qu'est-ce que tu as fait?",shape=box,color=red];
		j34609132 -> j2326942529;
	j3384448839 [label="Je crains que tu n'aies raison. Le destin s'est acharné sur lui et il a fait tout son possible pour y résister.",shape=box,color=blue];
		j3384448839 -> j2200367141;
	j2942415644 [label="Je pense qu'au final, ce sera bien plus que cela. Même si je déteste cette idée. Après tout, je ne peux m'empêcher d'être piégé avec eux.",shape=box,color=blue];
		j2942415644 -> j2200367141;
	j3803766439 [label="Et depuis lors?",shape=box,color=blue];
		j3803766439 -> j538254072;
	j1093047434 [label="Evaluate expressions",color=orange];
		j1093047434 -> j2165989776 [label="RoatheRedeemed",color=purple];
		j1093047434 -> j432903633 [label="RoatheVillain",color=purple];
		j1093047434 -> j3455347031 [label="false",color=purple];
	j3391510386 [label="+10 Chemistry",color=orange];
		j3391510386 -> j1544567526;
	j1869204288 [label="+5 Chemistry",color=orange];
		j1869204288 -> j331494414;
	j241101987 [label="Un soir, alors que je lisais en silence, quelques jours plus tard, il s'est approché de lui-même.",shape=box,color=blue];
		j241101987 -> j2377982574;
	j2326942529 [label="Je l'ai bien sûr enlacée en retour. Je suis un Orokin, mais je ne suis pas un monstre.",shape=box,color=blue];
		j2326942529 -> j201037725;
	j2200367141 [label="Ce prêtre. Si je devais conclure sur une seule note, ce serait celle-ci: sa résilience est en quelque sorte aussi infinie que le temps lui-même. ",shape=box,color=blue];
		j2200367141 -> j1133644810;
	j538254072 [label="Il n'en a quasiment pas parlé et je lui en suis profondément reconnaissant. Je m'attendais à des railleries et des moqueries: \"Enfin, le diable est vaincu!\" Pas du tout! Ils ont continué comme si de rien n'était.",shape=box,color=blue];
		j538254072 -> j1918748110;
	j2165989776 [label="Le Roathe d'antan aurait profité de l'occasion pour lui retirer les reins, mais je me suis aperçu que je n'en avais plus envie. ",shape=box,color=blue];
		j2165989776 -> j2019780866;
	j432903633 [label="Il m'a fallu toute ma volonté pour ne pas lui retirer les reins. Mais elle voulait simplement me réconforter.",shape=box,color=blue];
		j432903633 -> j3006556438;
	j3455347031 [label="Elle voulait simplement m'offrir un peu de réconfort.",shape=box,color=blue];
		j3455347031 -> j438853647;
	j1544567526 [label="En effet. Et je dois te remercier pour cela, n'est-ce pas?",shape=box,color=blue];
		j1544567526 -> j717898252;
	j331494414 [label="Je pense qu'au final, ce sera bien plus que cela. Même si je déteste cette idée. Après tout, je ne peux m'empêcher d'être piégé avec eux.",shape=box,color=blue];
		j331494414 -> j717898252;
	j2377982574 [label="Il s'est assis à côté de moi et m'a raconté comment, depuis qu'Entrati lui avait donné le sérum, il avait douté de sa foi. Combien il avait honte de ses doutes. Combien il regrettait d'avoir pris le sérum.",shape=box,color=blue];
		j2377982574 -> j1581755832;
	j201037725 [label="Et depuis lors?",shape=box,color=blue];
		j201037725 -> j2961308483;
	j1133644810 [label="Pour un homme qui s'est brisé, il ne s'est pas encore effondré.",shape=box,color=blue];
		j1133644810 -> j1622505995;
	j2019780866 [label="Pour une fois dans ma misérable vie, j'ai accepté cette simple offre de réconfort pour ce qu'elle était.",shape=box,color=blue];
		j2019780866 -> j3006556438;
	j3006556438 [label="C'était une façon simple de me dire qu'elle ne s'en souciait peut-être pas autant que moi. Et qu'elle était désolée pour toute la souffrance que je m'étais infligée à cause de ça.",shape=box,color=blue];
		j3006556438 -> j438853647;
	j438853647 [label="Et depuis lors?",shape=box,color=blue];
		j438853647 -> j933820623;
	j717898252 [label="Cette Sœur de Sol. Si je devais conclure sur une seule note, ce serait celle-ci: sa bonté est en quelque sorte aussi infinie que le temps lui-même.",shape=box,color=blue];
		j717898252 -> j1218291667;
	j1581755832 [label="Surtout, il aurait tellement voulu pouvoir tout oublier. Et peut-être, au fond, que nous n'étions pas tous les trois pareils.",shape=box,color=blue];
		j1581755832 -> j201037725;
	j2961308483 [label="Ils n'en ont quasiment pas parlé et je leur en suis profondément reconnaissant. Je m'attendais à des railleries et des moqueries: \"Enfin, le diable est vaincu!\" Pas du tout! Ils ont continué comme si de rien n'était.",shape=box,color=blue];
		j2961308483 -> j2896671794;
