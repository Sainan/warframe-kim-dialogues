		j2773949255 -> j1903910519;
	j423592938 [label="Hum. Je vais peut-être essayer de reproduire la recette ici. Quoi qu'il en soit, je ferai de mon mieux pour maintenir la paix. Enfin, la plupart du temps.",shape=box,color=blue];
		j423592938 -> j1177479755;
	j3621194133 [label="+10 Chemistry",color=orange];
		j3621194133 -> j1869305589;
	j390677698 [label="Je leur ai dit, Voyageur d'amour.",shape=box,color=blue];
		j390677698 -> j4131114853;
	j1392535471 [label="Je n'ai jamais prétendu que tu l'avais fait, mon cher Voyageur. Je leur ai dit.",shape=box,color=blue];
		j1392535471 -> j4131114853;
	j1263032036 [label="C'est une chose de plus que je dois réparer. Ils finiraient par apprendre la vérité, de toute façon. Autant qu'ils l'entendent de ma propre bouche.",shape=box,color=blue];
		j1263032036 -> j2748657352;
		j1263032036 -> j633412710;
	j1566577920 [label="Je n'ai pas à avoir honte. Le cacher n'avait aucun sens. Ils allaient bien finir par découvrir la vérité. Autant qu'ils l'apprennent de ma propre bouche.",shape=box,color=blue];
		j1566577920 -> j2748657352;
		j1566577920 -> j633412710;
