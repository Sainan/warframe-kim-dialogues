		j1177479755 -> j1799823483;
	j1869305589 [label="Je ferai de mon mieux pour ne pas tout gâcher pour toi, hein? Enfin… Rien d'irréparable en tout cas. Je ne veux pas que tes journées soient trop monotones, tu risques de devenir aussi dingue que le prêtre.",shape=box,color=blue];
		j1869305589 -> "Chat ends.";
