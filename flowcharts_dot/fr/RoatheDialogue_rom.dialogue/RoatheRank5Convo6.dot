		j1172864870 -> j749255274 [label="false",color=purple];
	j2813753334 [label="Evaluate expressions",color=orange];
		j2813753334 -> j3491991883 [label="RoatheVillain",color=purple];
		j2813753334 -> j3561558783 [label="RoatheRedeemed",color=purple];
		j2813753334 -> j556372054 [label="false",color=purple];
	j1937882309 [label="Ce que je pense de Marie? À part essayer de te convaincre de la laisser passer une nuit ou deux avec nous, cher Voyageur? (Je plaisante. Je plaisante.)",shape=box,color=blue];
		j1937882309 -> j3276667561;
	j2491170426 [label="Ce que je pense de Marie? À part essayer de te convaincre de me laisser me joindre à vous pour une nuit ou deux? (Je plaisante. Je plaisante.)",shape=box,color=blue];
		j2491170426 -> j274541864;
	j4149082043 [label="Comment as-tu réussi à la convaincre de changer d'avis concernant Albrecht? Tu fais des miracles! Peut-être devraient-ils te vénérer toi plutôt que Sol et Lua.",shape=box,color=blue];
		j4149082043 -> j2385641764;
	j231651327 [label="Je n'avais jamais su qu'elle souffrait encore au quotidien. Elle le cache comme si de rien n'était. Elle n'en a parlé qu'à toi. Tu as en quelque sorte comblé un fossé entre nous.",shape=box,color=blue];
		j231651327 -> j2718016605;
	j2738581004 [label="Je n'ai appris son histoire que récemment. Elle ne me l'avait jamais racontée avant de te la confier. Tu as en quelque sorte comblé un fossé entre nous.",shape=box,color=blue];
		j2738581004 -> j2834002598;
	j3158677280 [label="Rien de nouveau. Je passe chaque instant à me retenir de m'arracher le visage à coups de griffes, tant je désire ardemment la faire taire.",shape=box,color=blue];
		j3158677280 -> "Chat ends.";
	j2049824027 [label="C'est mieux maintenant que j'ai quelqu'un avec qui partager mes frustrations. Plus sérieusement, les tensions entre nous se sont nettement apaisées.",shape=box,color=blue];
		j2049824027 -> j1903910519;
	j3951035222 [label="Ce n'est pas moi qui \"m'entends bien\" avec Lyon, n'est-ce pas? Ha! Excuse-moi pour cette blague minable. Je n'ai pas pu m'en empêcher et tu m'as facilité les choses.",shape=box,color=blue];
		j3951035222 -> j2045251124;
	j3121566824 [label="Mieux que tu ne t'en sors avec lui, dirait-on. Comment as-tu pu tout gâcher avec lui? Il avait juste besoin de quelqu'un pour l'écouter. ",shape=box,color=blue];
		j3121566824 -> j2220606999;
	j358474514 [label="Les tensions entre nous se sont beaucoup apaisées, surtout depuis que tu lui as donné la confiance nécessaire pour parler de ce qui le tracassait.",shape=box,color=blue];
		j358474514 -> j1141338221;
	j1679593009 [label="Les tensions entre nous se sont beaucoup apaisées, surtout depuis que tu lui as donné la confiance nécessaire pour parler de ce qui le tracassait.",shape=box,color=blue];
		j1679593009 -> j631082436;
	j749255274 [label="Rien de nouveau. Je passe chaque instant à me retenir de m'arracher le visage à coups de griffes, tant je désire ardemment le faire taire.",shape=box,color=blue];
		j749255274 -> "Chat ends.";
	j3491991883 [label="J'avoue que je les trouve, petit à petit, un peu plus supportables. Je pense que c'est surtout parce que, petit à petit, ils me laissent tranquille.",shape=box,color=blue];
		j3491991883 -> j835370394;
	j3561558783 [label="J'avoue que je les trouve, petit à petit, un peu plus supportables. Je pense que mes récentes révélations y sont pour quelque chose.",shape=box,color=blue];
		j3561558783 -> j546145412;
	j556372054 [label="Je me surprends de plus en plus à me demander si, bien que je ne puisse pas utiliser les Ténèbres Réfractaires pour récupérer mes souvenirs puisque je suis désormais une Protoframe...",shape=box,color=blue];
		j556372054 -> j2419433523;
	j3276667561 [label="Je me demande si elle se rend compte que mes provocations sont passées d'une véritable contrariété à des taquineries bon enfant?",shape=box,color=blue];
		j3276667561 -> j2534790324;
	j274541864 [label="Je dois avouer que je ne t'en veux absolument pas. Et pas seulement parce qu'elle est magnifique. J'ai des yeux. Cette femme a une compassion que je n'aurais jamais cru possible pour une personne de son âge.",shape=box,color=blue];
		j274541864 -> j3276667561;
	j2385641764 [label="Bah. C'est ce genre de langage qui a permis l'ascension de l'Empire Orokin. Ce Système ne doit plus jamais commettre une telle erreur.",shape=box,color=blue];
		j2385641764 -> j3276667561;
	j2718016605 [label="J'avoue faire partie de ces imbéciles dont elle parle, incapables de concevoir de vivre ainsi, jour après jour.",shape=box,color=blue];
		j2718016605 -> j2861203232;
	j2834002598 [label="Dire que sa famille l'a jetée à la rue! Elle. Marie. Cette Marie-là. Celle qui avait en elle une compassion insoupçonnée!",shape=box,color=blue];
		j2834002598 -> j1297735036;
	j1903910519 [label="Ils connaissent mon... secret. La vérité sur le sérum que j'ai pris de mon plein gré.",shape=box,color=blue];
		j1903910519 -> j306549466;
		j1903910519 -> j2742080852;
	j2045251124 [label="Je te félicite d'avoir osé t'approcher de ce pauvre fou. Il a besoin de compagnie. Et de compassion.",shape=box,color=blue];
		j2045251124 -> j305974491;
	j2220606999 [label="Et pourtant, tu l'as rejeté. Honte à toi.",shape=box,color=blue];
		j2220606999 -> "Chat ends.";
	j1141338221 [label="Il m'a parlé de l'enfant Tenno qu'il entendait. Et expliqué qu'il ne l'entend plus.",shape=box,color=blue];
		j1141338221 -> j3014307961;
	j631082436 [label="J'ignorais presque tout de ce qui lui était arrivé. Ce n'est que lorsqu'il te l'a dit qu'il a daigné me le raconter. ",shape=box,color=blue];
		j631082436 -> j2745340500;
	j835370394 [label="Je plaisante. Je commence étrangement à m'attacher à eux, malgré ma volonté renouvelée de faire taire leurs critiques sur mes choix de vie.",shape=box,color=blue];
		j835370394 -> j1732163324;
		j835370394 -> j3851248123;
	j546145412 [label="Je m'attendais à ce qu'ils accueillent ma repentance avec des moqueries, des railleries du genre \"enfin, il a compris\" ou \"on te l'avait bien dit\". Rien de tout cela. Ils n'en ont quasiment pas parlé.",shape=box,color=blue];
		j546145412 -> j796072892;
	j2419433523 [label="…si cela ne m’empêche pas de m’y noyer complètement.",shape=box,color=blue];
		j2419433523 -> "Chat ends.";
	j2534790324 [label="Je l'espère. C'est tellement amusant de l'embêter. La voir se mettre en colère et me crier dessus dans sa langue maternelle est devenu mon sport préféré.",shape=box,color=blue];
		j2534790324 -> j3462670400;
	j2861203232 [label="Comment peut-elle garder un tel sang-froid? Et surtout tant de compassion? Je crois que j'aurais perdu la raison comme le prêtre, à sa place.",shape=box,color=blue];
		j2861203232 -> j3276667561;
	j1297735036 [label="Je ne saurais te décrire mon désir d'utiliser un Helminth pour remonter le temps et assassiner toute sa famille. Lentement. Mais elle s'y opposerait sans doute. ",shape=box,color=blue];
		j1297735036 -> j560395683;
	j306549466 [label="Je ne leur ai rien dit.",shape=box,color=red];
		j306549466 -> j571803048;
	j2742080852 [label="Comment l'ont-ils découvert?",shape=box,color=red];
		j2742080852 -> j3403354434;
	j305974491 [label="Mais plus sérieusement, les tensions entre nous se sont beaucoup améliorées.",shape=box,color=blue];
		j305974491 -> j1903910519;
	j3014307961 [label="Je m'attends à ce que cette voix le hante malgré tout dans ses cauchemars éveillés. Ce pauvre homme s'interrogera toujours sur la frontière entre réalité et fiction.",shape=box,color=blue];
		j3014307961 -> j1898255111;
	j2745340500 [label="Je ne saurais te décrire mon désir d'utiliser un Helminth pour remonter le temps et assassiner ses parents. Lentement. Mais je crains qu'il ne s'y oppose.",shape=box,color=blue];
		j2745340500 -> j2066447305;
	j1732163324 [label="De toute façon, vous êtes tous les trois coincés ensemble. Entrati s'en est chargé. Alors, autant faire pour un mieux.",shape=box,color=red];
		j1732163324 -> j4060307207;
	j3851248123 [label="C'est bien. Je pense qu'ils tiennent vraiment à toi.",shape=box,color=red];
		j3851248123 -> j1115355223;
	j796072892 [label="Je suis content qu'ils ne l'aient pas fait. Je ne veux pas qu'on me mette le nez dedans comme un chiot qui a sali le tapis. J'ai déjà assez de soucis comme ça.",shape=box,color=blue];
		j796072892 -> j1732163324;
		j796072892 -> j3851248123;
	j3462670400 [label="Une autre raison pour laquelle les choses se sont améliorées entre nous? Ils connaissent mon secret. La vérité. J’ai pris le sérum de mon plein gré.",shape=box,color=blue];
		j3462670400 -> j791308454;
		j3462670400 -> j1151224547;
	j560395683 [label="Les meurtres de vengeance sont probablement mal vus par Sol, etc., etc. ",shape=box,color=blue];
		j560395683 -> j3276667561;
	j571803048 [label="Je n'ai jamais prétendu que tu l'avais fait, mon cher Voyageur. Je leur ai dit.",shape=box,color=blue];
		j571803048 -> j1806500125;
	j3403354434 [label="Je leur ai dit, cher Voyageur.",shape=box,color=blue];
		j3403354434 -> j1806500125;
	j1898255111 [label="Une autre raison pour laquelle les choses se sont améliorées entre nous?",shape=box,color=blue];
		j1898255111 -> j1903910519;
	j2066447305 [label="Les meurtres de vengeance sont probablement mal vus par Lua, etc., etc. ",shape=box,color=blue];
		j2066447305 -> j2773949255;
	j4060307207 [label="Exactement. Inutile de se mettre ses nouveaux colocataires à dos. C'est précisément pour ça que je piquais des pâtisseries pour eux, en Gaule.",shape=box,color=blue];
		j4060307207 -> j423592938;
	j1115355223 [label="Malgré tous mes efforts, oui. Et c'est incompréhensible. Pourtant, nous en sommes bien là.",shape=box,color=blue];
		j1115355223 -> j3621194133;
