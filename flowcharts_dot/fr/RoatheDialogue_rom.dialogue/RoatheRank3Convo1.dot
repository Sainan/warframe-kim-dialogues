digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank3Convo1 begins." [color=orange];
		"RoatheRank3Convo1 begins." -> j846990257;
	j846990257 [label="As-tu enfin réussi à parler à notre cher Lyon? Ou te fait-il toujours la tête? Franchement, tu ferais peut-être mieux de garder tes distances.",shape=box,color=blue];
		j846990257 -> j4059345682;
		j846990257 -> j1979320359;
		j846990257 -> j2429168889;
	j4059345682 [label="Tu ne t'entends pas bien avec lui?",shape=box,color=red];
		j4059345682 -> j278125596;
	j1979320359 [label="Si tu étais un peu plus gentil avec Marie et Lyon, ils seraient peut-être plus gentils avec toi.",shape=box,color=red];
		j1979320359 -> j858521058;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j278125596 [label="Je m'entendrais mieux avec lui s'il s'efforçait de mieux comprendre qui je suis et d'où je viens. Je suis ce que je suis et ce depuis des siècles. Je ne compte pas changer simplement parce qu'on me le demande maintenant.",shape=box,color=blue];
		j278125596 -> j3060654953;
	j858521058 [label="Et que dire de leur bienveillance à mon égard, Usurpateur? Je suis ce que je suis. Et ce depuis des siècles. Je ne compte pas changer simplement parce qu'ils l'exigent maintenant.",shape=box,color=blue];
		j858521058 -> j3060654953;
	"Chat ends." [color=orange];
	j3060654953 [label="Evaluate expressions on HellStory counter",color=orange];
		j3060654953 -> j3058237148 [label="x >= 21",color=purple];
		j3060654953 -> j1704603117 [label="x < 21",color=purple];
		j3060654953 -> j1704603117 [label="false",color=purple];
	j3058237148 [label="J'ai peut-être pris ce sérum de mon plein gré, mais je sais que je n'ai pas signé pour être harangué à toute heure par ces deux ingrats.  ",shape=box,color=blue];
		j3058237148 -> j3854266504;
	j1704603117 [label="C'est la faute d'Albrecht si je suis comme ça! C'est sa faute si je suis coincé ici avec eux, pas la mienne! Je n'ai rien à voir avec cet horrible arrangement!",shape=box,color=blue];
		j1704603117 -> j3854266504;
	j3854266504 [label="Qu'ils aillent se plaindre à leur précieux \"Cardinal\", pas à moi.",shape=box,color=blue];
		j3854266504 -> j2438767290;
		j3854266504 -> j3862505983;
		j3854266504 -> j2198140227;
	j2438767290 [label="Ils sont bien intentionnés, même s'ils ne s'y prennent pas de la meilleure façon.",shape=box,color=red];
		j2438767290 -> j373939139;
	j3862505983 [label="N'as-tu pas l'impression d'avoir besoin d'être pardonné pour ce que tu as fait?",shape=box,color=red];
		j3862505983 -> j1745007267;
	j2198140227 [label="Ils essaient simplement de t'aider.",shape=box,color=red];
		j2198140227 -> j2902182735;
	j373939139 [label="Add -1 to Thermostat counter",color=orange];
		j373939139 -> j791026664;
	j1745007267 [label="Add 1 to Thermostat counter",color=orange];
		j1745007267 -> j399051872;
	j2902182735 [label="\"Aider.\" Oui. \"Aider.\" Excuse-moi de trouver leur façon \"d’aider\" profondément \"inutile\".",shape=box,color=blue];
		j2902182735 -> j3446083651;
	j791026664 [label="Oui, c'est bien là toute la tragédie. Ils croient sincèrement qu'ils essaient de faire le \"bien\".",shape=box,color=blue];
		j791026664 -> j1642802751;
	j399051872 [label="Pardonné par qui? Par toi? Par eux? Par le majordome? Par Albrecht? Ou par les \"dieux\"?",shape=box,color=blue];
		j399051872 -> j3341084545;
		j399051872 -> j1058478716;
		j399051872 -> j659735730;
	j3446083651 [label="En fait, je trouverais plus \"utile\" qu'ils échangent mon vin contre un astringent caustique, Usurpateur.",shape=box,color=blue];
		j3446083651 -> j4139245300;
	j1642802751 [label="Et toi, qu'en penses-tu? Crois-tu que j'aie besoin d'une \"grande rédemption\"? Du \"pardon divin\"?",shape=box,color=blue];
		j1642802751 -> j937239071;
	j3341084545 [label="Tu oublies un point important sur cette liste.",shape=box,color=red];
		j3341084545 -> j781817673;
	j1058478716 [label="Tu es un Orokin. Tu as commis des atrocités pendant la guerre et de par la nature même de ta société. Tu as beaucoup à expier.",shape=box,color=red];
		j1058478716 -> j887276293;
	j659735730 [label="Ne reconnais-tu pas au moins que tu as fait des choses terribles dans ta vie?",shape=box,color=red];
		j659735730 -> j3845458600;
	j4139245300 [label="Ce serait au moins plus efficace.",shape=box,color=blue];
		j4139245300 -> j1170931759;
	j937239071 [label="Evaluate expressions",color=orange];
		j937239071 -> j824408817 [label="RoatheTraitor2",color=purple];
		j937239071 -> j483314430 [label="RoatheTraitor2",color=purple];
		j937239071 -> j1578359967 [label="RoatheTraitor2",color=purple];
		j937239071 -> j3018708353 [label="RoatheTraitor2",color=purple];
		j937239071 -> j824408817 [label="RoatheTraitor1",color=purple];
		j937239071 -> j483314430 [label="RoatheTraitor1",color=purple];
		j937239071 -> j1578359967 [label="RoatheTraitor1",color=purple];
		j937239071 -> j3018708353 [label="RoatheTraitor1",color=purple];
		j937239071 -> j824408817 [label="RoatheExecutor2",color=purple];
		j937239071 -> j483314430 [label="RoatheExecutor2",color=purple];
		j937239071 -> j1578359967 [label="RoatheExecutor2",color=purple];
		j937239071 -> j3018708353 [label="RoatheExecutor2",color=purple];
		j937239071 -> j824408817 [label="false",color=purple];
		j937239071 -> j483314430 [label="false",color=purple];
		j937239071 -> j1578359967 [label="false",color=purple];
	j781817673 [label="Dis-moi. ",shape=box,color=blue];
		j781817673 -> j3839483597;
		j781817673 -> j133912831;
		j781817673 -> j2901012624;
	j887276293 [label="Je ne m'excuserai pas pour la société Orokin, car je n'en suis pas le créateur. Je n'en suis qu'un habitant. Et si tu blâmes tous ceux qui participent à un système dans lequel ils sont nés, tu condamneras des milliards de personnes avec ton arrogance et ta suffisance. Et le reste?",shape=box,color=blue];
		j887276293 -> j2293296188;
	j3845458600 [label="Et quand bien même? Je ne peux plus rien y changer. À quoi bon culpabiliser?",shape=box,color=blue];
		j3845458600 -> j198796719;
		j3845458600 -> j144887010;
	j1170931759 [label="Entre les deux, je préfère quand même le prêtre, je dois l'avouer. Il est à l'écoute de la raison. Il finira peut-être par admettre que l'Indifférence n'est pas un dieu réel.",shape=box,color=blue];
		j1170931759 -> j259125908;
	j824408817 [label="Je pense qu'il est important de réfléchir à nos actes qui ont nui à autrui et d'essayer de comprendre comment les réparer. Mais je ne crois pas du tout que ces deux-là s'y prennent de la bonne manière.",shape=box,color=red];
		j824408817 -> j3939438974;
	j483314430 [label="Au final, je ne crois pas qu'il faille pardonner à qui que ce soit d'autre qu'à soi-même. Si tu es en paix avec tes actions, tant mieux.",shape=box,color=red];
		j483314430 -> j2813668570;
	j1578359967 [label="Tu es né dans cette société, donc les nombreux comportements Orokins étaient tout simplement… normaux. Attendus. Tu ne les considérais pas comme \"mauvais\". Je ne dis pas que cela les justifie, juste qu'ils sont compréhensibles.",shape=box,color=red];
		j1578359967 -> j1544008201;
	j3018708353 [label="Tu avais l'intention de renverser les Orokins. Tu savais qu'ils étaient corrompus et tu essayais de corriger la situation.",shape=box,color=red];
		j3018708353 -> j1176328185;
	j3839483597 [label="Toi-même.",shape=box,color=red];
		j3839483597 -> j959970570;
	j133912831 [label="Ton propre peuple, que tu étais sur le point de trahir.",shape=box,color=red];
		j133912831 -> j3821146734;
	j2901012624 [label="Les Sentients que tu as massacrés.",shape=box,color=red];
		j2901012624 -> j2293296188;
	j2293296188 [label="C'était la guerre. Et à la guerre, par définition, tu massacres autant d'ennemis que possible. Pleures-tu les Grineers ou les Corpus que tu as tués?",shape=box,color=blue];
		j2293296188 -> j4160739330;
		j2293296188 -> j1043684290;
		j2293296188 -> j875307077;
	j198796719 [label="Le pardon des autres est important.",shape=box,color=red];
		j198796719 -> j923098158;
	j144887010 [label="Tu peux changer ton comportement futur.",shape=box,color=red];
		j144887010 -> j3544352854;
	j259125908 [label="En fait, je pourrais même le convaincre de détricoter toute sa religion – oh, oui! Un homme qui voit des hallucinations aussi extravagantes que sanglantes, mais aussi du bon sens et de la logique. Quelle rareté!",shape=box,color=blue];
		j259125908 -> j456526691;
		j259125908 -> j1145860211;
	j3939438974 [label="Mm. Je vois. Ce n'est pas l'action, mais la méthode qui te pose problème. Je retire donc mon approbation précédente et la remplace par de la consternation.",shape=box,color=blue];
		j3939438974 -> "Chat ends.";
	j2813668570 [label="Boolean RoatheVillainSelf is now true.",color=orange];
		j2813668570 -> j3207812781;
	j1544008201 [label="Boolean RoatheVillainOrokin is now true.",color=orange];
		j1544008201 -> j3207812781;
	j1176328185 [label="Donc je pense que même si tu avais prévu de remodeler l'empire à ton image, tu savais qu'il devait changer.",shape=box,color=red];
		j1176328185 -> j356687052;
		j1176328185 -> j3371887405;
	j959970570 [label="Check boolean RoatheKnowsReset2",color=orange];
		j959970570 -> j97123279 [label=true,color=green];
		j959970570 -> j2065575522 [label=false,color=brown];
	j3821146734 [label="Je n'ai jamais perdu une seule nuit de sommeil à cause de la culpabilité d'avoir trahi mon propre peuple, Usurpateur. Crois-moi.",shape=box,color=blue];
		j3821146734 -> j3742901753;
	j4160739330 [label="Non. Mais les Sentients, c'est une autre histoire.",shape=box,color=red];
		j4160739330 -> j1785851215;
	j1043684290 [label="Oui.",shape=box,color=red];
		j1043684290 -> j2993183367;
	j875307077 [label="Ce que je ressens face aux vies que je dois ôter ne te regarde pas. On parle de toi.",shape=box,color=red];
		j875307077 -> j1617594528;
	j923098158 [label="Pourquoi? Pour qu'on me laisse tranquille? Pour ne pas devenir une sorte de... d'anathème? Un paria social? ",shape=box,color=blue];
		j923098158 -> j2780033382;
	j3544352854 [label="Apprendre de ses erreurs est essentiel, certes. Mais il n'est pas nécessaire de se sentir coupable pour comprendre l'échec.",shape=box,color=blue];
		j3544352854 -> j3269053981;
	j456526691 [label="Lyon semble avoir déjà bien assez de problèmes à gérer, tu ne trouves pas?",shape=box,color=red];
		j456526691 -> j1802127686;
	j1145860211 [label="Pardon? Tu veux faire quoi?",shape=box,color=red];
		j1145860211 -> j3814941388;
	j3207812781 [label="Ton contexte était différent du nôtre. Et ce que nous considérons comme cruel et terrible, tu as été élevé de façon à le percevoir comme une simple réalité du monde.",shape=box,color=red];
		j3207812781 -> j2664166210;
	j356687052 [label="Cela n'excuse en rien tout ce que tu as fait – les tragédies restent des tragédies et les horreurs restent des horreurs. Mais tu as essayé.",shape=box,color=red];
		j356687052 -> j2025694458;
	j3371887405 [label="De mon point de vue, tu étais en guerre et tu tentais de survivre dans une société de sociopathes tout en préparant son renversement. Et pour cela, on t'a traité de diable. Je trouve ça injuste.",shape=box,color=red];
		j3371887405 -> j2034211967;
	j97123279 [label="Pour avoir fui.",shape=box,color=red];
		j97123279 -> j2340587127;
	j2065575522 [label="Pour avoir échoué.",shape=box,color=red];
		j2065575522 -> j2340587127;
	j3742901753 [label="Je ne m'excuserai pas pour l'Empire Orokin, car je n'en étais pas le créateur, mais simplement un de ses habitants. Et je n'endosserai aucune responsabilité pour avoir planifié sa destruction. Nous méritions ce qui nous est arrivé et pire encore.",shape=box,color=blue];
		j3742901753 -> j3085482665;
	j1785851215 [label="Mais c'est systématiquement \"une autre histoire\", Usurpateur. Le contexte est toujours primordial. Et toi, tu ne fais que contempler \"l'Ancienne Guerre\" avec du recul.",shape=box,color=blue];
		j1785851215 -> j1633532011;
	j2993183367 [label="Alors, Usurpateur, j'éprouve une immense pitié pour toi et je te suggère soit d'accepter la tâche qui t'incombe, soit de te retirer de cette vie et de te consacrer à l'agriculture.",shape=box,color=blue];
		j2993183367 -> j3266062424;
	j1617594528 [label="Mmm. J'adore quand tu montres si clairement que j'ai vu juste, c'est délicieusement jouissif. Tu détournes mal la conversation.",shape=box,color=blue];
		j1617594528 -> j905980788;
	j2780033382 [label="Regarde-moi, Usurpateur. Vois qui je suis. Un Orokin, chassé de son empire.",shape=box,color=blue];
		j2780033382 -> j1494189373;
	j3269053981 [label="Et à quoi sert le pardon, au final? De qui dois-je chercher à être pardonné? Des autres? Pour ne pas devenir une sorte d'anathème?",shape=box,color=blue];
		j3269053981 -> j2780033382;
	j1802127686 [label="Et c'est précisément pour ça que je voulais l'aider! J'essaie simplement de l'aider à dissiper certaines de ses incertitudes concernant l'Indifférence et ce qu'Entrati lui a dit.",shape=box,color=blue];
		j1802127686 -> j2701940265;
	j3814941388 [label="Absolument rien de mal, quoi qu'en dise cette agaçante cécidomyie. J'essaie simplement de l'aider à dissiper ses doutes quant à l'Indifférence et aux propos d'Entrati.",shape=box,color=blue];
		j3814941388 -> j2701940265;
	j2664166210 [label="+10 Chemistry",color=orange];
		j2664166210 -> j533553067;
	j2025694458 [label="Boolean RoatheVillainOrokin is now true.",color=orange];
		j2025694458 -> j2664166210;
	j2034211967 [label="Boolean RoatheVillainShortcut is now true.",color=orange];
		j2034211967 -> j1649079345;
	j2340587127 [label="Boolean RoatheForgivenessShortcut is now true.",color=orange];
		j2340587127 -> j1933300832;
	j3085482665 [label="S'il y a bien une chose qui me fait culpabiliser, c'est que ce sont les Tennos qui ont finalement tout réduit en cendres et non moi.",shape=box,color=blue];
		j3085482665 -> j533316691;
	j1633532011 [label="Si tu veux juger les actions passées de tous les peuples à l'aune de toutes les informations dont tu disposes dans le futur, tu te feras sans cesse du mal.",shape=box,color=blue];
		j1633532011 -> j1874119998;
	j3266062424 [label="Cependant, ce serait dommage. C'est un vrai régal de te regarder travailler. Pas d'une efficacité redoutable, mais d'un panache incroyable.",shape=box,color=blue];
		j3266062424 -> j1530823343;
	j905980788 [label="J'imagine cependant que passer des siècles dans l'isolement, sans personne à qui parler si ce n'est les créations imaginaires de son esprit, limite forcément les possibilités d'affûter ses compétences sociales.",shape=box,color=blue];
		j905980788 -> j1462473034;
	j1494189373 [label="J'étais \"le diable de Tau\" à mon époque. Et ici, je suis déjà \"le diable\" pour tous ceux qui me rencontrent.",shape=box,color=blue];
		j1494189373 -> j2309340795;
	j2701940265 [label="Entrati lui a dit que ses \"visions\" n'étaient pas le fait de Lua, mais de l'Indifférence. Cela le plonge dans une sorte de \"crise de foi\".",shape=box,color=blue];
		j2701940265 -> j1166372816;
	j533553067 [label="Quel plaisir de constater que la nuance et la subtilité ne sont finalement pas mortes! Oui, tu as tout à fait raison. Je suis un produit d'une autre époque, d'une autre société.",shape=box,color=blue];
		j533553067 -> j2258781637;
	j1649079345 [label="+20 Chemistry",color=orange];
		j1649079345 -> j1757093352;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j533316691 [label="Boolean RoatheForgivenessNoGuilt is now true.",color=orange];
		j533316691 -> j1933300832;
	j1874119998 [label="Accepte le passé et passe à autre chose.",shape=box,color=blue];
		j1874119998 -> j961316679;
	j1530823343 [label="Au moins, tu rends le champ de bataille \"amusant\". ",shape=box,color=blue];
		j1530823343 -> j961316679;
	j1462473034 [label="File t'entraîner avec le prêtre, vous avez tous les deux besoin de pratique. ",shape=box,color=blue];
		j1462473034 -> j4081414586;
	j2309340795 [label="Albrecht a jugé bon de s'assurer que ce surnom devienne permanent. ",shape=box,color=blue];
		j2309340795 -> j961316679;
	j1166372816 [label="Cependant, j'essaie de le convaincre que ce n'est pas le cas et qu'aucun \"dieu\" ne les a envoyées, car les \"dieux\" n'existent pas. Il est simplement malade.",shape=box,color=blue];
		j1166372816 -> j3390572218;
		j1166372816 -> j2371347294;
	j2258781637 [label="Je pouvais cependant reconnaître la cruauté et les atrocités commises par mon peuple pour ce qu'elles étaient. Il y avait des horreurs que beaucoup des miens ont perpétrées et que même moi, je ne pouvais supporter.",shape=box,color=blue];
		j2258781637 -> j3528180736;
	j1757093352 [label="Je savais bien que je t'aimais pour une raison, Usurpateur. Enfin! Quelqu'un qui m'apprécie! Il aura fallu… combien de siècles?!",shape=box,color=blue];
		j1757093352 -> j1409874131;
	j961316679 [label="Voici mon conseil: éradique toute culpabilité de ton cœur, comme je l’ai fait. Frappe-la d'un coup de lame et continue jusqu’à ce qu’elle soit morte.",shape=box,color=blue];
		j961316679 -> j2971461132;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j3390572218 [label="Est-ce que Lyon souhaite ton aide?",shape=box,color=red];
		j3390572218 -> j95107661;
	j2371347294 [label="Et tu penses que cela améliore sa situation?",shape=box,color=red];
		j2371347294 -> j2684386514;
	j3528180736 [label="Mais ces questions sont… complexes. Et je suis content que tu le comprennes. Bah. Le majordome me lance un regard. Je dois mettre fin à cette conversation. À bientôt.",shape=box,color=blue];
		j3528180736 -> "Chat ends.";
	j1409874131 [label="Bah. Le majordome me lance un regard. Je dois mettre fin à cette conversation. Nous nous reparlerons bientôt.",shape=box,color=blue];
		j1409874131 -> "Chat ends.";
	j2971461132 [label="La culpabilité n'est qu'un traître tapi dans l'ombre qui te dépouille de tout ce qui t'est cher. Elle ne t'apporte que du mal.",shape=box,color=blue];
		j2971461132 -> j533316691;
	j95107661 [label="Il n'a pas refusé d'écouter. Il ne m'a pas dit de me taire. Je le ferais s'il me le demandait.",shape=box,color=blue];
		j95107661 -> j1239853941;
	j2684386514 [label="Est-il préférable de laisser les personnes à tendance religieuse le manipuler simplement parce qu'elles le peuvent? Pointer du doigt ses hallucinations et les qualifier de \"visions\" au lieu de l'aider?",shape=box,color=blue];
		j2684386514 -> j1805785368;
	j1239853941 [label="Cela me met en colère de voir l'entourage de Lyon l'utiliser et le manipuler, qu'ils en soient conscients ou non. Tout cela au nom de la \"religion\" et des \"croyances\".",shape=box,color=blue];
		j1239853941 -> j1805785368;
	j1805785368 [label="J'ai lu les récits de ce qui s'est passé. Ce \"Voile Rouge\" aurait pu tenter de récupérer ce Tenno prisonnier de son Harrow pendant tous ces siècles. Mais ils ne l'ont pas fait. Ils l'ont laissé dépérir et mourir.",shape=box,color=blue];
		j1805785368 -> j4006921942;
	j4006921942 [label="Pourquoi? Au nom de la protection contre un... hypothétique \"Dieu du Néant\".",shape=box,color=blue];
		j4006921942 -> j3899755974;
		j4006921942 -> j2814920377;
	j3899755974 [label="Tu penses que le sacrifice de Rell n'a servi à rien?",shape=box,color=red];
		j3899755974 -> j2424670752;
	j2814920377 [label="Rell a été le seul obstacle à cette chose, pendant toutes ces années.",shape=box,color=red];
		j2814920377 -> j3657833442;
	j2424670752 [label="Non. Il protégeait de quelque chose. Mais qui sait à quel point il a aggravé la situation? Qui sait à quel point il a alimenté cette chose avec sa propre peur et son angoisse, pendant tous ces siècles?",shape=box,color=blue];
		j2424670752 -> j3268328774;
	j3657833442 [label="Ou alors, il était le seul à l'alimenter, pendant toutes ces années.",shape=box,color=blue];
		j3657833442 -> j3268328774;
	j3268328774 [label="L'Incarnation Conceptuelle ne manifeste que ce qu'on lui donne. Et le Néant ne peut travailler qu'avec la matière qu'on lui offre.",shape=box,color=blue];
		j3268328774 -> j3204311739;
	j3204311739 [label="Je me demande combien ce Tenno a investi dans son existence à lui seul? Il était un véritable festin d'agonie, de douleur, de trahison, de tristesse... de solitude...",shape=box,color=blue];
		j3204311739 -> j4162409387;
	j4162409387 [label="Et l'engourdissement qui doit accompagner les milliers d'années passées dans la solitude en ce lieu, à parler dans le Néant. Qu'en résulte-t-il, sinon l'Indifférence?",shape=box,color=blue];
		j4162409387 -> j37079621;
		j4162409387 -> j2300187735;
	j37079621 [label="Il est possible que ce que tu dis soit vrai. Je... je n'en sais rien. Et je ne sais pas non plus si ce n'est pas vrai.",shape=box,color=red];
		j37079621 -> j3138880740;
	j2300187735 [label="Elle était puissante avant même d'atteindre Rell. Il ne se serait pas sacrifié ainsi sans une bonne raison.",shape=box,color=red];
		j2300187735 -> j212778718;
	j3138880740 [label="+10 Chemistry",color=orange];
		j3138880740 -> j687469169;
	j212778718 [label="Il en va de même des cauchemars d'enfants. Pour un enfant de six ans, ce sont les créatures les plus puissantes de l'univers. Mais pour un adulte, ce n'est qu'un nuage de poussière coincé dans une bouche d'aération, dérivant trop près de la lumière.",shape=box,color=blue];
		j212778718 -> j3406506596;
	j687469169 [label="Je ne crois pas pouvoir te demander plus que d'admettre simplement que tu ne sais pas avec certitude ce que nous affrontons.",shape=box,color=blue];
		j687469169 -> j932039684;
	j3406506596 [label="Nous nous faisons des montagnes de grains de poussière simplement parce que nous avons besoin d'une raison d'être malheureux et de nous autodétruire.",shape=box,color=blue];
		j3406506596 -> j3729685206;
	j932039684 [label="Voilà un point de départ formidable. Et une qualité admirable chez toute personne: la simple capacité de dire… \"Je ne sais pas.\"",shape=box,color=blue];
		j932039684 -> j41624837;
	j3729685206 [label="L'humanité en un coup d'œil.",shape=box,color=blue];
		j3729685206 -> j3208040028;
	j41624837 [label="Si nous, les Orokins, avions pu faire preuve d'une telle force de temps en temps, nous aurions peut-être survécu.",shape=box,color=blue];
		j41624837 -> j3208040028;
