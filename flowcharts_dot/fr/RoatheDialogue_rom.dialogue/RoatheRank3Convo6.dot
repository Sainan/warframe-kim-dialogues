digraph {
	2049 [label="RoatheRank3Convo6 begins.",color=orange];
		2049 -> 2052;
		2049 -> 2050;
		2049 -> 2051;
	2052 [label="Pourquoi passes-tu autant de temps avec les Cavias, Roathe?",shape=box,color=red];
		2052 -> 2055;
	2050 [label="Garde tes distances avec les Cavias, Roathe. Ça me plaît moyennement.",shape=box,color=red];
		2050 -> 2053;
	2051 [label="[Fin.]",shape=box,color=red];
		2051 -> 2054;
	2055 [label="Hm? Eh bien, je les trouve parmi les créations du Néant les plus tristes et pathétiques que j'aie jamais rencontrées dans tout le Système Origine. ",shape=box,color=blue];
		2055 -> 2057;
	2053 [label="Afin d'éviter tout malentendu possible dans cette situation, je vais oublier ma verbosité habituelle et dire simplement ceci: ",shape=box,color=blue];
		2053 -> 2056;
	2054 [label="Chat ends.",color=orange];
	2057 [label="Des animaux de laboratoire. Des animaux de laboratoire, Albrecht! Tu as jeté des animaux dans le Néant et quand ils sont revenus en jacassant dans ta langue d'enfants inventée, tu as ordonné à ton majordome de les euthanasier?!",shape=box,color=blue];
		2057 -> 2059;
	2056 [label="Non.",shape=box,color=blue];
		2056 -> 2058;
	2059 [label="Il laisse toujours les autres faire le sale boulot. Mais je m'égare. Tu me demandes pourquoi je parle avec eux. Surtout à l'oiseau. C'est simple. Mais j'aimerais bien que tu devines. Je veux voir si tu trouves la réponse.",shape=box,color=blue];
		2059 -> 2060;
		2059 -> 2061;
		2059 -> 2062;
		2059 -> 2063;
		2059 -> 2064;
	2058 [label="Chat ends.",color=orange];
	2060 [label="Il ne sait pas qui tu es.",shape=box,color=red];
		2060 -> 2065;
	2061 [label="Oiseau-3 aime tout le monde.",shape=box,color=red];
		2061 -> 2066;
	2062 [label="Tu aimes t'entourer de personnes qui te font sentir intelligent.",shape=box,color=red];
		2062 -> 2067;
	2063 [label="Il a un sens aigu de l'observation concernant les gens qui l'entourent.",shape=box,color=red];
		2063 -> 2068;
	2064 [label="Il est facile à manipuler.",shape=box,color=red];
		2064 -> 2069;
	2065 [label="Oui. En un sens, c'est exactement ça. Il ne sait pas qui je suis. Il ne sait rien du \"Diable de Tau\". Et… qui plus est, il s'en moque éperdument.",shape=box,color=blue];
		2065 -> 2070;
	2066 [label="Oui, il est charmant avec son innocence un peu naïve. Mais ce que tu veux dire, d'une manière aimable et un peu détournée, c'est que personne d'autre ne pourrait m'aimer, c'est bien ça?",shape=box,color=blue];
		2066 -> 2071;
	2067 [label="J'aimerais que tu comprennes à quel point tu te trompes. À quel point ta flèche vole loin de la cible… mais il y en a d'autres qui pensent cela de moi.",shape=box,color=blue];
		2067 -> 2072;
	2068 [label="En effet. Et ses observations sont fort utiles, mais rien que je n'aurais pu déduire moi-même en quelques instants.",shape=box,color=blue];
		2068 -> 2073;
	2069 [label="J'aimerais que tu comprennes à quel point tu te trompes. À quel point ta flèche vole loin de la cible… mais il y en a d'autres qui pensent cela de moi.",shape=box,color=blue];
		2069 -> 2074;
	2070 [label="+10 Chemistry",color=orange];
		2070 -> 2075;
	2071 [label="Je dois donc me contenter de cet oiseau idiot pour me tenir compagnie? Mais tu n’es pas loin de la vérité, je suppose. Je t'accorde donc… une note passable.",shape=box,color=blue];
		2071 -> 2075;
	2072 [label="Il y en a pas mal.",shape=box,color=blue];
		2072 -> 2076;
	2073 [label="Si je comprends bien, en d'autres termes, tu penses que j'utilise ce grand oiseau qui parle à mes propres fins? C'est bien ça?",shape=box,color=blue];
		2073 -> 2077;
	2074 [label="Il y en a pas mal.",shape=box,color=blue];
		2074 -> 2078;
	2075 [label="Pour lui, je ne suis pas Roathe. Je ne suis pas Orokin. Je ne suis ni un criminel, ni un traître, ni un lâche. Je peux simplement être… moi-même.",shape=box,color=blue];
		2075 -> 2079;
	2076 [label="Update boolean RoatheAlone1",color=orange];
		2076 -> 2080;
	2077 [label="Non. Mais il y en a d'autres qui pensent cela de moi. Il y en a pas mal.",shape=box,color=blue];
		2077 -> 2078;
	2078 [label="Update boolean RoatheAlone1",color=orange];
		2078 -> 2081;
	2079 [label="Je ne crois pas pouvoir te décrire à quel point cela me fait...",shape=box,color=blue];
		2079 -> 2082;
		2079 -> 2083;
		2079 -> 2084;
	2080 [label="+5 Chemistry",color=orange];
		2080 -> 2085;
	2081 [label="+5 Chemistry",color=orange];
		2081 -> 2086;
	2082 [label="Tu peux lâcher prise, tu sais. Tu peux changer. Même ici, même maintenant.",shape=box,color=red];
		2082 -> 2087;
	2083 [label="Ce doit être un fardeau terrible. Devoir gérer les attentes liées à ta réputation où que tu ailles, même ici.",shape=box,color=red];
		2083 -> 2088;
	2084 [label="Tu insinues que le reste est une sorte de spectacle que tu as mis en scène?",shape=box,color=red];
		2084 -> 2089;
	2085 [label="Chat ends.",color=orange];
	2086 [label="Chat ends.",color=orange];
	2087 [label="Add 2 to Thermostat",color=orange];
		2087 -> 2090;
	2088 [label="Add -1 to Thermostat",color=orange];
		2088 -> 2091;
	2089 [label="Si seulement c'était aussi simple et que tout cela n'était qu'une grande façade que je pouvais changer comme on retire un masque de bal! Non, Usurpateur. C'est qui je suis, jusqu'à la moelle de mes os pourris.",shape=box,color=blue];
		2089 -> 2092;
	2090 [label="Si seulement c'était aussi simple, Usurpateur. Tu rends tout cela si tentant. Puis-je? Peut-être… Peut-être n'est-il pas trop tard, même pour un pauvre diable tragique comme moi.",shape=box,color=blue];
		2090 -> 2093;
	2091 [label="+10 Chemistry",color=orange];
		2091 -> 2094;
	2092 [label="Mais cela ne veut pas dire que je ne savoure pas l'occasion de lâcher prise pendant une heure et de simplement profiter d'une conversation avec quelqu'un qui n'est au courant de rien concernant tous les crimes terribles que j'ai commis dans ma vie.",shape=box,color=blue];
		2092 -> 2095;
	2093 [label="+10 Chemistry",color=orange];
		2093 -> 2096;
	2094 [label="C'est épuisant, Usurpateur. Et si seulement je pouvais abandonner ce personnage comme un masque que l'on retire pour ne jamais le remettre. Mais c'est ce que je suis, jusqu'à la moelle de mes os pourris.",shape=box,color=blue];
		2094 -> 2092;
	2095 [label="Update boolean RoatheBirdThree",color=orange];
		2095 -> 2097;
		2095 -> 2098;
	2096 [label="N'est-ce qu'une simple façade? Ou bien est-ce profondément enfoui jusqu'à la moelle de mon être? Je ne le sais pas encore. Tout ce que je peux dire, c'est que j'apprécie toujours l'occasion de lâcher prise pendant une heure, quand j'en ai l'opportunité.",shape=box,color=blue];
		2096 -> 2099;
	2097 [label="Excuse-moi si cela paraît indélicat, mais… on dirait que tu as eu une vie solitaire.",shape=box,color=red];
		2097 -> 2100;
	2098 [label="Tu n'as pas l'habitude d'avoir beaucoup d'amis, n'est-ce pas?",shape=box,color=red];
		2098 -> 2101;
	2099 [label="Je laisse de côté ce fardeau et je m'assieds auprès de quelqu'un qui ignore tout de mes terribles crimes. Je discute avec le grand oiseau, charmant et un peu niais et je me retrouve… en paix. Pour la première fois depuis longtemps.",shape=box,color=blue];
		2099 -> 2102;
	2100 [label="Evaluate expressions",color=orange];
		2100 -> 2106 [label="RoatheUnloved1, RoatheKnowsReset2",color=purple];
		2100 -> 2105 [label="RoatheKnowsReset2",color=purple];
		2100 -> 2104 [label="RoatheUnloved1",color=purple];
		2100 -> 2103 [label="false",color=purple];
	2101 [label="Check boolean RoatheKnowsReset2",color=orange];
		2101 -> 2108 [label=true,color=green];
		2101 -> 2107 [label=false,color=brown];
	2102 [label="Il y a peut-être de l'espoir dans ce que tu dis. Ou peut-être que je me berce d'illusions. Et que ce n'est qu'un répit passager.",shape=box,color=blue];
		2102 -> 2109;
	2106 [label="Oui, en effet. Du moins, d'après mes souvenirs. Ou bien est-ce cela que tu m'as volé, Usurpateur? Que nous étions amants, que je t'ai avoué mon amour et que tu ne partageais pas mes sentiments?",shape=box,color=blue];
		2106 -> 2113;
	2105 [label="Je l'admets. Du moins, d'après mes souvenirs. Vais-je te surprendre en te disant que je n'ai jamais été amoureux, pas réciproquement, en tout cas? Peut-être pas. Après tout, nous avons probablement déjà vécu tout cela.",shape=box,color=blue];
		2105 -> 2112;
	2104 [label="Elle l'a été. Longue et solitaire. Mais c'est entièrement de ma faute, Usurpateur. Je ne suis pas là pour quémander ta sympathie ou ta pitié.",shape=box,color=blue];
		2104 -> 2111;
	2103 [label="Je l'admets. Du moins, d'après mes souvenirs. Vais-je te surprendre en te disant que je n'ai jamais été amoureux? Mais c'est entièrement de ma faute, Usurpateur. Je ne suis pas là pour quémander ta sympathie ni ta pitié.",shape=box,color=blue];
		2103 -> 2110;
	2108 [label="Qui sait? Peut-être que j'avais des amis et que je ne m'en souviens tout simplement pas parce que nous étions amis avant que tu ne mettes fin à tout ça, hein?",shape=box,color=blue];
		2108 -> 2114;
	2107 [label="Qui sait? Peut-être que j'avais des amis et que je ne m'en souviens tout simplement pas parce qu'Entrati a trifouillé dans ma tête et effacé mes souvenirs d'eux.",shape=box,color=blue];
		2107 -> 2114;
	2109 [label="Update boolean RoatheBirdThree",color=orange];
		2109 -> 2097;
		2109 -> 2098;
	2113 [label="Ou était-ce l'inverse? Tu avais des sentiments pour le Diable en personne, mais son cœur est resté froid. En désespoir de cause, tu l'as alors torturé mentalement!",shape=box,color=blue];
		2113 -> 2118;
	2112 [label="Update boolean RoatheUnloved1",color=orange];
		2112 -> 2117;
	2111 [label="Update boolean RoatheAlone1",color=orange];
		2111 -> 2116;
	2110 [label="Update boolean RoatheUnloved1",color=orange];
		2110 -> 2115;
	2114 [label="Pour tout le bien que cela semble m'avoir apporté...",shape=box,color=blue];
		2114 -> 2119;
	2118 [label="Evaluate expressions",color=orange];
		2118 -> 2124 [label="RoatheDatingDeal",color=purple];
		2118 -> 2123 [label="RoatheMarieDatingDeal",color=purple];
		2118 -> 2123 [label="RoatheLyonDatingDeal",color=purple];
		2118 -> 2122 [label="RoatheSerumDeal",color=purple];
		2118 -> 2122 [label="RoatheFamilyDeal",color=purple];
		2118 -> 2122 [label="RoatheMarieEntratiDeal",color=purple];
		2118 -> 2122 [label="RoatheLyonConfessionDeal",color=purple];
		2118 -> 2124 [label="RoatheDatingDealNo",color=purple];
		2118 -> 2123 [label="RoatheMarieDatingDealNo",color=purple];
		2118 -> 2123 [label="RoatheLyonDatingDealNo",color=purple];
		2118 -> 2122 [label="RoatheSerumDealNo",color=purple];
		2118 -> 2122 [label="RoatheFamilyDealNo",color=purple];
		2118 -> 2122 [label="RoatheMarieEntratiDealNo",color=purple];
		2118 -> 2122 [label="RoatheLyonConfessionDealNo",color=purple];
		2118 -> 2121 [label="false",color=purple];
	2117 [label="Je me demande, est-ce cela que tu m'as pris, Usurpateur? Que nous étions amants, que je t'aie avoué mon amour et que tu n'as pas ressenti la même chose?",shape=box,color=blue];
		2117 -> 2113;
	2116 [label="Quelles que soient les mauvaises opinions que tu as à mon sujet, je les mérite. Et il n'y a pas que toi. Loin de là.",shape=box,color=blue];
		2116 -> 2120;
	2115 [label="Update boolean RoatheAlone1",color=orange];
		2115 -> 2116;
	2119 [label="Chat ends.",color=orange];
	2124 [label="C'est vraiment tragique… J'aimerais presque connaître les détails, mais j'ai l'impression que ce serait comme passer directement à la fin du livre.",shape=box,color=blue];
		2124 -> 2125;
	2123 [label="Mais à qui je veux faire croire ça?! On sait tous pourquoi tu as fait ça, pas vrai? Et ce n'était pas par amour pour moi, mais par amour pour quelqu'un d'autre. Je me laisse aller à quelques rêveries.",shape=box,color=blue];
		2123 -> 2125;
	2122 [label="Mais à qui je veux faire croire ça?! On sait tous pourquoi tu as fait ça, pas vrai? Et ce n'était pas par amour pour moi. Pas du tout. Je me laisse aller à quelques rêveries.",shape=box,color=blue];
		2122 -> 2125;
	2121 [label="Bah. Mais à quoi bon rester assis ici à divaguer avec des considérations poétiques?",shape=box,color=blue];
		2121 -> 2125;
	2120 [label="Chat ends.",color=orange];
	2125 [label="Mais je ne suis pas là pour quémander ta sympathie ou ta pitié. Tout cela est de ma propre faute. Les mauvaises opinions que tu as à mon sujet, je les mérite. Et il n'y a pas que toi à penser ça de moi. ",shape=box,color=blue];
		2125 -> 2126;
	2126 [label="Update boolean RoatheAlone1",color=orange];
		2126 -> 2127;
	2127 [label="Loin s'en faut.",shape=box,color=blue];
		2127 -> 2128;
	2128 [label="Chat ends.",color=orange];
}