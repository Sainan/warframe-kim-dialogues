	j2025250598 [label="J'aime tout ce que tu es. J'aime ce que tu peux devenir. J'aime ce que tu choisis d'être. Ce que tu as été. Tout ce dont tu es capable. Je t'aime, Roathe.",shape=box,color=red];
		j2025250598 -> j2299942464;
