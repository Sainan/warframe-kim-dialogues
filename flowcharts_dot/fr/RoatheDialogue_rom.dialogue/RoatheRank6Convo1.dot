		j1860617847 -> j3104375818;
	j1294507445 [label="Soudain, c'est moi qui suis envahi par une terrible angoisse. Tu as vraiment le don de renverser la situation à l'improviste, cher Voyageur. Qu'est-ce qu'il y a?",shape=box,color=blue];
		j1294507445 -> j4058259201;
		j1294507445 -> j3798791957;
	j3345495633 [label="Avec moi. Oui. Des compagnons. Je n'ai pas l'habitude.",shape=box,color=blue];
		j3345495633 -> j1737158385;
	j442251712 [label="Soudain, c'est moi qui suis envahi par une terrible angoisse. Attention, cher Voyageur. Tu joues un jeu dangereux. Qu'y a-t-il?",shape=box,color=blue];
		j442251712 -> j3408037275;
		j442251712 -> j4036937739;
	j2975447051 [label="Et j'adore les faire! C'est pourquoi nous nous entendons si bien. Et c'est précisément ce que je voulais dire en quelques mots.",shape=box,color=blue];
		j2975447051 -> j3821155330;
	j3286722987 [label="Des amis. Oui. Je suppose que c'est ce que nous sommes maintenant, n'est-ce pas? Quelle drôle d'idée.",shape=box,color=blue];
		j3286722987 -> j2534748994;
	j1551466655 [label="Pour m'avoir aidé à la fois à retrouver mes souvenirs et à les harmoniser, bien sûr. Quoi d'autre? Ce n'est pas comme si tu t'étais affairé à plier mon linge.",shape=box,color=blue];
		j1551466655 -> j2572883920;
	j2153760755 [label="Faut-il vraiment que je te le dise clairement? Très bien. Mais n'attends pas de moi des éloges dithyrambiques. Tu reçois assez de compliments de la part des autres. Je n'en rajouterai pas.",shape=box,color=blue];
		j2153760755 -> j2966056457;
