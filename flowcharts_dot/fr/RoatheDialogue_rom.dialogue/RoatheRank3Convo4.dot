digraph {
	"RoatheRank3Convo4 begins." [color=orange];
		"RoatheRank3Convo4 begins." -> j3467246414;
	j3467246414 [label="Usurpateur, pourrais-tu répondre à une question qui me taraude depuis quelque temps?",shape=box,color=blue];
		j3467246414 -> j2593197265;
		j3467246414 -> j2731479401;
		j3467246414 -> j2429168889;
	j2593197265 [label="Demande.",shape=box,color=red];
		j2593197265 -> j3899904624;
	j2731479401 [label="Qu'est-ce qui pourrait bien te tracasser?",shape=box,color=red];
		j2731479401 -> j1138496216;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j3899904624 [label="Pourquoi fais-tu tout cela?",shape=box,color=blue];
		j3899904624 -> j3524964328;
	j1138496216 [label="Je pourrais énumérer tous les points de ma liste, mais je crains que nous y passions l'après-midi. Non, mes questions portent sur un point précis. Du moins, aujourd'hui.",shape=box,color=blue];
		j1138496216 -> j3899904624;
	"Chat ends." [color=orange];
	j3524964328 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3524964328 -> j3078869325 [label=true,color=green];
		j3524964328 -> j2768280751 [label=false,color=brown];
	j3078869325 [label="Et je ne parle pas de la manipulation de mes souvenirs. Je parle de \"tout ça\" au sens large.",shape=box,color=blue];
		j3078869325 -> j2768280751;
	j2768280751 [label="Check boolean LoidFamilyComplete",color=orange];
		j2768280751 -> j2301330049 [label=true,color=green];
		j2768280751 -> j3322868201 [label=false,color=brown];
	j2301330049 [label="Tu sembles obstinément vouloir courir après Albrecht à travers l'univers, un torchon à la main. Il suffit de te voir avec son son majordome. ",shape=box,color=blue];
		j2301330049 -> j2476974658;
	j3322868201 [label="Tu sembles obstinément vouloir courir après Albrecht à travers l'univers, un torchon à la main.",shape=box,color=blue];
		j3322868201 -> j2476974658;
	j2476974658 [label="Check boolean IsDating",color=orange];
		j2476974658 -> j3838415000 [label=true,color=green];
		j2476974658 -> j1733451634 [label=false,color=brown];
	j3838415000 [label="Il semble que tu aies tes propres préoccupations – et je t'en félicite, je ne te juge absolument pas. Je trouve simplement étrange que quelqu'un d'aussi… merveilleusement et follement imprévisible soit si obéissant par ailleurs. ",shape=box,color=blue];
		j3838415000 -> j1407524250;
		j3838415000 -> j3857660885;
		j3838415000 -> j4158150683;
	j1733451634 [label="Ce que je trouve étrange, c'est que quelqu'un d'habitude si... excentrique et imprévisible puisse se montrer si docile à d'autres égards.",shape=box,color=blue];
		j1733451634 -> j1407524250;
		j1733451634 -> j3857660885;
		j1733451634 -> j4158150683;
	j1407524250 [label="Laisser l'Indifférence détruire le Système Origine, ou n'importe quoi d'autre, n'aide personne.",shape=box,color=red];
		j1407524250 -> j1046348713;
	j3857660885 [label="Je n'obéis pas à Entrati.",shape=box,color=red];
		j3857660885 -> j3033606543;
	j4158150683 [label="J'ai mes propres raisons. Et je les garde pour moi.",shape=box,color=red];
		j4158150683 -> j3354846444;
	j1046348713 [label="Ah, je vois. Un service temporaire que tu fournis en attendant que la situation avec \"l'Indifférence\" soit réglée. Et que comptes-tu faire ensuite?",shape=box,color=blue];
		j1046348713 -> j658352191;
		j1046348713 -> j1549018232;
		j1046348713 -> j74533823;
		j1046348713 -> j4241534544;
		j1046348713 -> j2922229136;
	j3033606543 [label="Vraiment? C'est l'impression que j'ai. Il claque des doigts et tu te prosternes à ses pieds comme un kubrow dressé. Il murmure \"Tau\" et tu te démènes pour te rappeler le moindre détail de l'endroit.",shape=box,color=blue];
		j3033606543 -> j3935154442;
		j3033606543 -> j1449018363;
	j3354846444 [label="Si énigmatique, si insondable! Et quel ramassis de conneries! Si tu ne veux pas admettre que tu es à sa merci, qu'il en soit ainsi.",shape=box,color=blue];
		j3354846444 -> j1248735474;
	j658352191 [label="Pourquoi parles-tu de ça ? Qu'essaies-tu vraiment de me demander?",shape=box,color=red];
		j658352191 -> j63221778;
	j1549018232 [label="Honnêtement, je n'ai pas vraiment pensé si loin.",shape=box,color=red];
		j1549018232 -> j2609057796;
	j74533823 [label="Je compte bien lui faire payer le désastre. Il a beaucoup à se faire pardonner. ",shape=box,color=red];
		j74533823 -> j2223520209;
	j4241534544 [label="En supposant que je survive, tu veux dire?",shape=box,color=red];
		j4241534544 -> j1673944974;
	j2922229136 [label="Je vais là où on a besoin de moi, comme toujours. Les problèmes ont tendance à me trouver.",shape=box,color=red];
		j2922229136 -> j2090725216;
	j3935154442 [label="Pourquoi t'efforces-tu tant de me mettre en colère?",shape=box,color=red];
		j3935154442 -> j1540125279;
	j1449018363 [label="Je fais simplement ce que je peux pour aider les gens à sortir des situations misérables dans lesquelles ils se trouvent.",shape=box,color=red];
		j1449018363 -> j3403186347;
	j1248735474 [label="Parce que c'est l'impression que j'ai. Il claque des doigts et tu te prosternes à ses pieds comme un kubrow dressé. Il murmure \"Tau\" et tu te démènes pour te rappeler le moindre détail de l'endroit.",shape=box,color=blue];
		j1248735474 -> j3935154442;
		j1248735474 -> j1449018363;
	j63221778 [label="+5 Chemistry",color=orange];
		j63221778 -> j3333214826;
	j2609057796 [label="Ah! Tu admets donc être complètement débile! Quel soulagement! J'adore quand les imbéciles affichent leur bêtise au grand jour, ça me facilite grandement la tâche pour les manipuler.",shape=box,color=blue];
		j2609057796 -> j1682298781;
	j2223520209 [label="Ah! C'est donc une vengeance primitive et vile que tu recherches! Glorieux. Une bête enragée, prête à ronger les os de ceux qui lui ont fait du tort.",shape=box,color=blue];
		j2223520209 -> j1020979142;
	j1673944974 [label="+5 Chemistry",color=orange];
		j1673944974 -> j3920734544;
	j2090725216 [label="Ah, je vois. De la léthargie masquée par de la noblesse. Tu ne sais pas où est ta place, où tu devrais rester, alors tu te drapes dans ce vernis de \"sacrifice vertueux\" et tu obéis aux ordres des autres?",shape=box,color=blue];
		j2090725216 -> j2094111086;
	j1540125279 [label="Parce que je ne peux absolument pas comprendre pourquoi toi, une entité qui, d'après ce que je peux en déduire, provient d'une toute autre version de la réalité, tu t'acharnes à semer le chaos à travers le temps et l'espace en \"jouant au docteur\".",shape=box,color=blue];
		j1540125279 -> j3157888994;
	j3403186347 [label="Oui, c'est bien là le nœud du problème! Pourquoi t'obstines-tu à errer dans le temps et l'espace en \"jouant au docteur\"? Toi qui es une entité qui, d'après ce que je comprends, vient d'une réalité totalement différente… ",shape=box,color=blue];
		j3403186347 -> j3157888994;
	j3333214826 [label="Astucieux. Oui, très bien, je vais aborder le cœur du problème plus directement. J'essayais de te provoquer pour voir si cela susciterait une réponse plus honnête.",shape=box,color=blue];
		j3333214826 -> j1348114466;
	j1682298781 [label="Tu es comme un kubrow qui vient d'attraper un kaithe. Tu ne sais plus quoi faire, maintenant que tu as les dents plantées dans sa patte.",shape=box,color=blue];
		j1682298781 -> j1449018363;
		j1682298781 -> j3935154442;
	j1020979142 [label="L'une des motivations humaines les plus simples et les plus anciennes. Et par conséquent, l'une des plus faciles à comprendre.",shape=box,color=blue];
		j1020979142 -> j1449018363;
	j3920734544 [label="Tu n'as jamais officiellement été soldat et pourtant j'entends dans ta voix la lassitude des plus aguerris de tous.",shape=box,color=blue];
		j3920734544 -> j3098708696;
	j2094111086 [label="Quelle tragédie!",shape=box,color=blue];
		j2094111086 -> j2953185822;
		j2094111086 -> j3504573807;
	j3157888994 [label="À ta place, je retournerais à Duviri pour tenter de découvrir quelles autres brèches dans le tissu du Néant je pourrais percer! Imagine les possibilités! Imagine les mondes qui ne demandent qu'à être conquis!",shape=box,color=blue];
		j3157888994 -> j4093886653;
		j3157888994 -> j1127677428;
	j1348114466 [label="Mais je suppose que ça fera l'affaire.",shape=box,color=blue];
		j1348114466 -> j3218247257;
	j3098708696 [label="Très bien. Par respect pour toi, je vais aborder plus directement le cœur du problème. Je cherchais à te provoquer pour voir si cela susciterait une réponse plus sincère.",shape=box,color=blue];
		j3098708696 -> j3218247257;
	j2953185822 [label="Il y a un endroit où j'ai ma place.",shape=box,color=red];
		j2953185822 -> j863769661;
	j3504573807 [label="Tu ne sais pas de quoi tu parles.",shape=box,color=red];
		j3504573807 -> j56785594;
	j4093886653 [label="Tu n'es pas différent d'Albrecht. Il voyage dans le temps et cause tous ces problèmes. Et tu veux faire la même chose à des dimensions entières?!",shape=box,color=red];
		j4093886653 -> j1942120877;
	j1127677428 [label="Voilà ton problème, Orokin. Tu crois que des mondes entiers t'appartiennent et que tu peux en faire ce que bon te semble. ",shape=box,color=red];
		j1127677428 -> j2184703446;
	j3218247257 [label="+5 Chemistry",color=orange];
		j3218247257 -> j2957890716;
	j863769661 [label="Dis-moi tout! Est-ce la Höllvanie? Ou peut-être Duviri? Ou encore ton vaisseau spatial qui s'est écrasé sur ce qui reste de la Terre?",shape=box,color=blue];
		j863769661 -> j1449018363;
		j863769661 -> j3935154442;
	j56785594 [label="Alors, parle-moi de ton foyer! Est-ce la Höllvanie? Ou peut-être Duviri? Ou encore ton vaisseau spatial qui s'est écrasé sur ce qui reste de la Terre?",shape=box,color=blue];
		j56785594 -> j1449018363;
		j56785594 -> j3935154442;
	j1942120877 [label="Et pourquoi pas? Nous sommes des créations supérieures, n'est-ce pas? Albrecht fait ce qu'il veut et tu n'as aucun problème à nettoyer après lui! Pourquoi n'aurais-je pas le droit d'en faire autant? Qu'est-ce qui justifie sa quête et pas la mienne?",shape=box,color=blue];
		j1942120877 -> j331645427;
	j2184703446 [label="Et pourquoi pas? Nous sommes les créations supérieures, n'est-ce pas? Albrecht fait ce qu'il veut, semant la terreur à travers le temps, infectant les masses avec une maladie qu'il comprend à peine, le tout au nom du \"combat contre un soi-disant dieu\".",shape=box,color=blue];
		j2184703446 -> j331645427;
	j2957890716 [label="Je ne peux absolument pas comprendre pourquoi toi, une entité qui, d'après ce que je peux en déduire, provient d'une toute autre version de la réalité, tu t'acharnes à semer le chaos à travers le temps et l'espace en \"jouant au docteur\".",shape=box,color=blue];
		j2957890716 -> j3956801596;
	j331645427 [label="Mais regarde-toi! ",shape=box,color=blue];
		j331645427 -> j965779903;
	j3956801596 [label="Check boolean IsDating",color=orange];
		j3956801596 -> j526418456 [label=true,color=green];
		j3956801596 -> j2867760806 [label=false,color=brown];
	j965779903 [label="Check boolean IsDating",color=orange];
		j965779903 -> j1327718813 [label=true,color=green];
		j965779903 -> j3090164009 [label=false,color=brown];
	j526418456 [label="Toi, qui possèdes des pouvoirs dont je n'ai jamais entendu parler chez un autre être? Maîtriser le temps lui-même. Créer des dimensions parallèles. Et pourtant, tu es là… à réparer les relations (et à en tisser quelques-unes).",shape=box,color=blue];
		j526418456 -> j3400876846;
	j2867760806 [label="Toi, qui possèdes des pouvoirs dont je n'ai jamais entendu parler chez un autre être? Maîtriser le temps lui-même. Créer des dimensions parallèles. Et pourtant, tu es là… à réparer les relations.",shape=box,color=blue];
		j2867760806 -> j3400876846;
	j1327718813 [label="Toi, qui possèdes des pouvoirs dont je n'ai jamais entendu parler chez un autre être? Maîtriser le temps lui-même. Créer des dimensions parallèles. Et pourtant, tu es là… à réparer les relations (et à en tisser quelques-unes).",shape=box,color=blue];
		j1327718813 -> j1164110801;
	j3090164009 [label="Toi, qui possèdes des pouvoirs dont je n'ai jamais entendu parler chez un autre être? Maîtriser le temps lui-même. Créer des dimensions parallèles. Et pourtant, tu es là… à réparer les relations.",shape=box,color=blue];
		j3090164009 -> j1164110801;
	j3400876846 [label="Je suis tout simplement sidéré. Je n'arrive pas à comprendre. Pourquoi? Pourquoi, alors que tu pourrais très bien régner sur un univers quelque part?",shape=box,color=blue];
		j3400876846 -> j200180770;
		j3400876846 -> j1161324394;
		j3400876846 -> j2254066673;
	j1164110801 [label="Je suis tout simplement sidéré. Je n'arrive pas à comprendre. Pourquoi? Pourquoi, alors que tu pourrais très bien régner sur un univers quelque part?",shape=box,color=blue];
		j1164110801 -> j3116916699;
		j1164110801 -> j41705971;
		j1164110801 -> j1775803118;
	j200180770 [label="Ce que je fais me convient. J'aide les gens et j'aime ça.",shape=box,color=red];
		j200180770 -> j3853674165;
	j1161324394 [label="Je ne sais pas si tu arriveras à comprendre, mais essaie: je ne veux pas régner sur un univers.",shape=box,color=red];
		j1161324394 -> j1726550155;
	j2254066673 [label="Alors, je ne vaudrais pas mieux qu'Albrecht. Ni qu'un Orokin. À tout saccager puis à remodeler le monde à mon image. Ça ne m'intéresse pas.",shape=box,color=red];
		j2254066673 -> j1726550155;
	j3116916699 [label="Ce que je fais me convient. J'aide les gens et j'aime ça.",shape=box,color=red];
		j3116916699 -> j3853674165;
	j41705971 [label="Je ne sais pas si tu arriveras à comprendre, mais essaie: je ne veux pas régner sur un univers.",shape=box,color=red];
		j41705971 -> j594385227;
	j1775803118 [label="Alors, je ne vaudrais pas mieux qu'Albrecht. Ni qu'un Orokin. À tout saccager puis à remodeler le monde à mon image. Ça ne m'intéresse pas.",shape=box,color=red];
		j1775803118 -> j594385227;
	j3853674165 [label="Mais pourquoi? C'est ce que je ne comprends pas.",shape=box,color=blue];
		j3853674165 -> j1990388149;
	j1726550155 [label="Tu préfères donc être… quoi? Dérisoire?",shape=box,color=blue];
		j1726550155 -> j1531231508;
		j1726550155 -> j455621354;
	j594385227 [label="Tu préfères donc être… quoi? Dérisoire?",shape=box,color=blue];
		j594385227 -> j455621354;
		j594385227 -> j1531231508;
	j1990388149 [label="Check boolean RoatheUnloved1",color=orange];
		j1990388149 -> j3200347826 [label=true,color=green];
		j1990388149 -> j784800017 [label=true,color=green];
		j1990388149 -> j3995576912 [label=true,color=green];
		j1990388149 -> j3200347826 [label=false,color=brown];
		j1990388149 -> j784800017 [label=false,color=brown];
		j1990388149 -> j1227361704 [label=false,color=brown];
	j1531231508 [label="Si tu penses que ce que je fais est dérisoire, libre à toi. C'est ton opinion. Ce que j'ai accompli a réécrit l'histoire.",shape=box,color=red];
		j1531231508 -> j1889385905;
	j455621354 [label="Pas dérisoire. Invisible. Que les autres s'agitent pour attirer l'attention. Je resterai dans l'ombre.",shape=box,color=red];
		j455621354 -> j237585412;
	j3200347826 [label="Car c'est en aidant les gens quand ils en ont besoin que nous allons finalement nous sortir de ce pétrin.",shape=box,color=red];
		j3200347826 -> j1200790986;
	j784800017 [label="Parce que je fais ce qu'il faut faire. Ni plus, ni moins.",shape=box,color=red];
		j784800017 -> j158880426;
	j3995576912 [label="Tu as dit ne pas savoir ce que c'est que d'être aimé. Je ne pense pas que tu puisses comprendre à quel point cela peut transformer le monde qui t'entoure.",shape=box,color=red];
		j3995576912 -> j697609442;
	j1227361704 [label="As-tu déjà été amoureux, Roathe? Ou aimé quelqu'un au point de pouvoir détruire l'univers pour cette personne?",shape=box,color=red];
		j1227361704 -> j2386151054;
	j1889385905 [label="C'est exactement ce que je voulais dire! Alors, allons réécrire l'histoire! Au lieu de rester là à essayer de convaincre tout le monde de se tenir la main et de chanter ensemble!",shape=box,color=blue];
		j1889385905 -> j2499878262;
		j1889385905 -> j33089063;
		j1889385905 -> j3929416160;
	j237585412 [label="Ah, je vois, tu préfères être l'assassin discret qui agit dans l'ombre, n'est-ce pas? Frapper quand on s'y attend le moins? Non. Je ne crois pas. Je pense que tu perds ton temps.",shape=box,color=blue];
		j237585412 -> j2343861763;
	j1200790986 [label="Mmhm. Rendre service à des inconnus jusqu'à ce qu'ils te vénèrent comme un héros local? Ou les convaincre de se tenir la main et de chanter ensemble? Excuse-moi, je vais vomir dans l'aquarium de Fibonacci.",shape=box,color=blue];
		j1200790986 -> j1375755060;
		j1200790986 -> j1596551428;
	j158880426 [label="Et ce que tu \"fais\", c'est apparemment courir partout pour convaincre tout le monde de se tenir la main et de chanter ensemble entre deux scènes d'une violence inouïe. La violence, elle, se justifie. Le reste est écœurant. ",shape=box,color=blue];
		j158880426 -> j1375755060;
		j158880426 -> j1596551428;
	j697609442 [label="Si tu persistes à croire que nous allons sauver l'univers de cette \"Indifférence\" en nous tenant la main et en chantant des chansons, excuse-moi pendant que je vais vomir dans l'aquarium de Fibonacci.",shape=box,color=blue];
		j697609442 -> j2059367134;
		j697609442 -> j1375755060;
		j697609442 -> j1596551428;
	j2386151054 [label="Boolean RoatheUnloved1 is now true.",color=orange];
		j2386151054 -> j221791492;
	j2499878262 [label="Sois patient. Il nous faut d'abord régler le problème de l'Indifférence.",shape=box,color=red];
		j2499878262 -> j2522852414;
	j33089063 [label="Peut-être, une fois que tout cela sera réglé. Mais pas maintenant.",shape=box,color=red];
		j33089063 -> j366173274;
	j3929416160 [label="Et tu crois que je te choisirais pour le faire avec moi? Ne me fais pas rire.",shape=box,color=red];
		j3929416160 -> j1911611197;
	j2343861763 [label="Tu ne sais ni ce que tu fais ni pourquoi tu le fais, tu obéis simplement aux ordres. Imbécile utile d'un Orokin prétentieux. Quelle honte.",shape=box,color=blue];
		j2343861763 -> "Chat ends.";
	j1375755060 [label="Je dis simplement que l'idée que les gens ne soient plus malheureux semble te mettre vraiment en colère. Et tu sembles le prendre très personnellement.",shape=box,color=red];
		j1375755060 -> j2846760976;
	j1596551428 [label="Ce que j'essayais d'expliquer, c'est simplement que si \"l'Indifférence\" se nourrit d'un manque d'émotions, en éprouver pourrait être la clé pour la vaincre.",shape=box,color=red];
		j1596551428 -> j4274237467;
	j2059367134 [label="Penses-tu qu'il soit impossible que quelqu'un t'aime? Ou penses-tu être incapable d'aimer quelqu'un d'autre? Ou penses-tu simplement que cela ne s'est pas encore produit?",shape=box,color=red];
		j2059367134 -> j5221485;
	j221791492 [label="Non, jamais. Et si tu persistes à croire que nous allons sauver l'univers de cette \"Indifférence\" en nous tenant la main et en chantant des chansons, excuse-moi pendant que je vais vomir dans l'aquarium de Fibonacci.",shape=box,color=blue];
		j221791492 -> j2059367134;
		j221791492 -> j1375755060;
		j221791492 -> j1596551428;
	j2522852414 [label="+5 Chemistry",color=orange];
		j2522852414 -> j366173274;
	j366173274 [label="Très bien! Très bien! Je vais patienter, comme tu dis. Jouer à ces... jeux stupides.",shape=box,color=blue];
		j366173274 -> j586579750;
	j1911611197 [label="Boolean RoatheInsulted is now true.",color=orange];
		j1911611197 -> j4034961687;
	j2846760976 [label="Parce que le malheur aime la compagnie? Peut-être. Ou bien, tout simplement parce que je suis perplexe de te voir perdre ton temps alors qu’il y a du vrai travail à faire.",shape=box,color=blue];
		j2846760976 -> j573118331;
	j4274237467 [label="Encore une preuve que tout cela n'est que le fruit de ton imagination! Quel genre de dieu ou \"d'anti-dieu\" pourrait être vaincu par la \"bonté des émotions humaines\"! Ha! ",shape=box,color=blue];
		j4274237467 -> j353588060;
	j5221485 [label="Boolean RoatheUnloved2 is now true.",color=orange];
		j5221485 -> j3228606934;
	j586579750 [label="Je suppose que nous avons encore du travail à faire, comme tu dis. Je ne peux tout simplement pas concevoir que de telles choses... puériles puissent avoir un sens. Mais, d'un autre côté, je suis perdu ici et toi, tu détiens les clés de l'univers.",shape=box,color=blue];
		j586579750 -> j379958683;
	j4034961687 [label="C'est juste. Pourquoi choisir un personnage aussi détestable que le Diable de Tau?",shape=box,color=blue];
		j4034961687 -> "Chat ends.";
	j573118331 [label="Mais maintenant, je suis convaincu que tu ne sais ni ce que tu fais ni pourquoi tu le fais et que tu obéis simplement aux ordres. Imbécile utile d'un Orokin prétentieux. Quelle honte.",shape=box,color=blue];
		j573118331 -> "Chat ends.";
