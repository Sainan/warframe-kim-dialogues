		622 -> 627 [label="false",color=purple];
	623 [label="Je vais donc continuer, faute de mieux. \"Au fait, comment va notre petite flagorneuse flottante? J'imagine que le prêtre ne t'adresse toujours pas la parole.\" Bah! Quelle farce!",shape=box,color=blue];
