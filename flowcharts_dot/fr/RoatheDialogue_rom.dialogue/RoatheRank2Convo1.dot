	644 [label="\"Jusqu’ici.\" Intrigant. Et nous ne faisons vraiment que refaire le même chemin, tels des courtisans répétant les mouvements d’une danse? Encore et encore, condamnés à nous répéter?",shape=box,color=blue];
		644 -> 668;
		644 -> 669;
	645 [label="Je suppose que tu le sais, n'est-ce pas? C'est curieux que ce soit si prévisible. C'est rassurant de savoir que même quelqu'un d'aussi brisé peut encore être fiable de temps en temps.",shape=box,color=blue];
		645 -> 670;
	646 [label="Ne le sais-tu pas déjà? Hum. Peut-être que tu n'as pas été jusque-là. Ou peut-être n'as-tu pas pensé à poser la question, ni la première ni la millième fois au cours de cette petite escapade.",shape=box,color=blue];
		646 -> 670;
	647 [label="Oh. Et une dernière chose, avant que j'oublie?",shape=box,color=blue];
		647 -> 671;
	649 [label="Comment as-tu pu vendre ton âme au diable à deux reprises… en faisant un marché pour que je te prenne dans mon lit? Ou bien convoites-tu mon cœur, Usurpateur? Hum. Nous verrons bien. Mais cela viendra.",shape=box,color=blue];
		649 -> 672;
	650 [label="Le moment venu, je veillerai à ce que tu puisses facilement séduire notre petite flagorneuse flottante, Usurpateur. L'affaire est pliée.",shape=box,color=blue];
		650 -> 673;
	651 [label="Le moment venu, je veillerai à ce que tu puisses facilement séduire notre pauvre prêtre brisé, Usurpateur. L'affaire est pliée.",shape=box,color=blue];
		651 -> 674;
	652 [label="Le moment venu, je m'en souviendrai. Si jamais nous avons un autre désaccord concernant mes souvenirs, nous ne répéterons pas tes erreurs passées.",shape=box,color=blue];
		652 -> 675;
	655 [label="Le moment venu, je veillerai à ce que ce petit majordome monte les escaliers. C'est réglé.",shape=box,color=blue];
		655 -> 678;
	654 [label="Considère que ton problème avec Marie et son adoration servile d'Entrati est réglé. Le moment venu, je m'en occuperai.",shape=box,color=blue];
		654 -> 677;
	653 [label="Considère que ton problème avec Lyon et ses horreurs est réglé, Usurpateur. Le moment venu, je m'en occuperai.",shape=box,color=blue];
		653 -> 676;
	648 [label="J'ai… apparemment oublié ce que tu voulais. C'est de ta faute puisque tu as manipulé mes souvenirs. C'était quoi, déjà?",shape=box,color=blue];
		648 -> 626;
	656 [label="Je te conseillerais plutôt la patience, mais… loin de moi l’idée de te dire d’utiliser un burin quand un outil de précision laser est à ta disposition.",shape=box,color=blue];
		656 -> 679;
	657 [label="Hum. Je vois. Une noble entreprise, à vrai dire. Une entreprise que j'ai moi-même tentée à maintes reprises. Et qui a également échoué.",shape=box,color=blue];
