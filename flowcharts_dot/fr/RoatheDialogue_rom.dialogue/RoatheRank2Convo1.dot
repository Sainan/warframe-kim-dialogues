	628 [label="Où en es-tu avec notre petite flagorneuse flottante? J'imagine que le prêtre ne t'adresse toujours pas la parole.",shape=box,color=blue];
		628 -> 641;
		628 -> 642;
		628 -> 643;
	627 [label="Dis-moi, as-tu changé d'avis concernant mon offre? Ce sera ta dernière chance, Usurpateur. Je suis patient, certes, mais je n'aime pas rester là à tenir les portes comme un imbécile.",shape=box,color=blue];
		627 -> 639;
