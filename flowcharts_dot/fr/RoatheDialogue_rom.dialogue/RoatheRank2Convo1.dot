	609 [label="Je trouve terriblement fascinant que tu aies comploté avec moi pour… tracer ma propre voie. Le diable fait affaire avec sa propre chair, en quelque sorte.",shape=box,color=blue];
		609 -> 619;
	608 [label="Où en sont les progrès de ton côté, mon Usurpateur? Je m'active pour tirer les ficelles et les leviers en ta faveur, même si mon influence reste jusqu'ici invisible et imperceptible.",shape=box,color=blue];
		608 -> 619;
	610 [label="Dis-moi que tu as changé d'avis concernant ma proposition. Là où j'aurais pu faire obstacle auparavant, compte tenu de tes… objectifs romantiques? Désormais, je serai aussi docile qu'un terrik des neiges. Hmm. À moins que ce ne soit pas ce que tu désires. C'est à toi d'en décider.",shape=box,color=blue];
		610 -> 620;
	611 [label="Dis-moi que tu as changé d'avis concernant mon offre. Je peux t'aider à régler ce problème avec Marie. Tu pourrais ainsi atteindre tes objectifs romantiques en toute sérénité.",shape=box,color=blue];
		611 -> 620;
	612 [label="Dis-moi que tu as changé d'avis concernant mon offre. Je peux t'aider à régler ce problème avec Lyon. Tu pourrais ainsi atteindre tes objectifs romantiques en toute sérénité.",shape=box,color=blue];
		612 -> 620;
	613 [label="Dis-moi que tu as changé d'avis concernant mon offre. Là où j'aurais pu opposer une résistance auparavant, concernant ma… prise du sérum? Je me montrerai aussi docile qu'un terrisk des neiges.",shape=box,color=blue];
		613 -> 620;
	614 [label="Dis-moi que tu as changé d'avis concernant mon offre. Là où j'aurais pu opposer une résistance auparavant, concernant les retrouvailles du majordome et de sa famille? Je me montrerai aussi docile qu'un terrisk des neiges.",shape=box,color=blue];
		614 -> 620;
	615 [label="Dis-moi que tu as changé d'avis concernant mon offre; je peux régler ce problème avec Marie. Veiller à ce que tes conversations avec elle se déroulent sans accroc.",shape=box,color=blue];
		615 -> 620;
	616 [label="Dis-moi que tu as changé d'avis concernant mon offre; je peux régler ce problème avec Lyon. Veiller à ce que tes conversations avec lui se déroulent sans accroc.",shape=box,color=blue];
		616 -> 620;
	617 [label="Je ne peux m'empêcher de penser que si tu poursuis nos conversations, c'est pour une bonne raison, Usurpateur. Et que je pourrais peut-être t'être utile.",shape=box,color=blue];
		617 -> 621;
	618 [label="Evaluate expressions on HellStory",color=orange];
		618 -> 606 [label="x >= 21",color=purple];
		618 -> 622 [label="x < 21",color=purple];
		618 -> 622 [label="false",color=purple];
	619 [label="C'est un défi étrange de mon point de vue que de n'avoir qu'une partie de mes souvenirs intacte tout en sachant que l'autre moitié du jeu est entre tes mains.",shape=box,color=blue];
		619 -> 623;
	620 [label="Mais tout ce bavardage, c'est du temps perdu. Alors, vas-y. Dis-le. Et ton problème sera résolu.",shape=box,color=blue];
		620 -> 624;
		620 -> 625;
	621 [label="Dis-moi ce que tu veux et trouvons un accord. Tout ce bavardage n'est qu'une perte de temps.",shape=box,color=blue];
		621 -> 626;
	622 [label="Evaluate expressions",color=orange];
