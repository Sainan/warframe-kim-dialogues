		635 -> 657;
	636 [label="Eh bien, tu vois, il y a toute cette histoire... sur les raisons pour lesquelles vous avez pris le sérum et moi... j'ai dit des choses inappropriées au mauvais moment.",shape=box,color=red];
		636 -> 658;
