		662 -> 685;
	665 [label="Quand il prend la parole, ses propos se divisent généralement en deux catégories: soit ils sont horriblement insipides, soit ils sont horriblement insensés.",shape=box,color=blue];
		665 -> 688;
	666 [label="Hm? Tu as réussi à y échapper jusqu'ici? Je t'envie terriblement. Mais tu ne tarderas pas à être pris dans la zone d'impact, alors mieux vaut être prévenu à temps.",shape=box,color=blue];
		666 -> 689;
	667 [label="Mon pauvre Voyageur. As-tu oublié à quel point nous, les Orokins, rejetions catégoriquement toute forme de divinité? Nous ne vénérions que nous-mêmes.",shape=box,color=blue];
		667 -> 690;
	663 [label="Comme tu veux. Je te préviens, cette décision aura des conséquences.",shape=box,color=blue];
		663 -> 686;
	664 [label="Tu te tiens à carreau et tu m'aides à convaincre Loid de monter se réconcilier avec sa famille? En échange, je t'aiderai avec tes souvenirs.",shape=box,color=red];
		664 -> 687;
	668 [label="Cela ne signifie pas que tu es incapable d'agir. Cela signifie simplement que certaines choses peuvent nécessiter plusieurs tentatives.",shape=box,color=red];
		668 -> 691;
