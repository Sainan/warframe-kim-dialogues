		862 -> 864;
	863 [label="Et je sais que tu pilles les vaisseaux que tu abordes et que tu prends tout ce dont tu as besoin ou envie – ne me regarde pas avec tes yeux innocents, Usurpateur.",shape=box,color=blue];
		863 -> 865;
		863 -> 866;
