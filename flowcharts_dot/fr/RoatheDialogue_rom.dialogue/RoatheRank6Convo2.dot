	j1203946473 [label="Quelle drôle de petite créature tu es! Délicieuse, mais étrange, cher Voyageur.",shape=box,color=blue];
		j1203946473 -> j3445755936;
	j3445755936 [label="Je dois toutefois te poser la question. Pourquoi? Pourquoi conclure un accord aussi grotesque? Est-ce la curiosité de goûter à la chair Orokin après tant de siècles?",shape=box,color=blue];
		j3445755936 -> j3857720484;
