	j2106109587 [label="Je déteste paraître vulgaire, mais… tu t'es regardé dans le miroir, récemment?",shape=box,color=red];
		j2106109587 -> j1438910720;
	j3732465063 [label="Roathe. Tu ne me croiras peut-être pas, mais... je t'aime.",shape=box,color=red];
		j3732465063 -> j3492816548;
	j833848454 [label="Tu ne me croiras peut-être pas, mais je tiens à toi.",shape=box,color=red];
		j833848454 -> j1068932765;
	j1438910720 [label="+10 Chemistry",color=orange];
		j1438910720 -> j1743853026;
	j3492816548 [label="Pardon?",shape=box,color=blue];
		j3492816548 -> j3979937397;
	j1068932765 [label="Je suis certain qu'il y a une part de vérité dans ce que tu dis. Ou du moins, je crois que tu ne te rends pas compte de ton propre aveuglement.",shape=box,color=blue];
		j1068932765 -> j1442875506;
	j1743853026 [label="L'honnêteté est une chose merveilleuse, cher Voyageur. Crois-tu que je te jugerais parce que tu t'amuses? Certainement pas.",shape=box,color=blue];
		j1743853026 -> j3737000540;
	j3979937397 [label="Non. Tu plaisantes?",shape=box,color=blue];
		j3979937397 -> j120374242;
	j1442875506 [label="Je crois que le plus grand succès de l'Empire Orokin a été sa capacité à convaincre ceux qui le composaient de croire à leurs propres illusions.",shape=box,color=blue];
		j1442875506 -> j554548423;
	j3737000540 [label="À une relation de satisfaction mutuelle.",shape=box,color=blue];
		j3737000540 -> j3921499284;
	j120374242 [label="Mais pourquoi alors conclure un tel accord, à moins que...?",shape=box,color=blue];
		j120374242 -> j3411780622;
		j120374242 -> j3888617558;
	j554548423 [label="En réalité, c'est peut-être là le véritable tissu conjonctif de l'humanité: notre capacité magistrale à nous regarder dans le miroir et à nous tromper nous-mêmes.",shape=box,color=blue];
		j554548423 -> j2268739800;
	j3921499284 [label="Boolean RoatheUnloved4 is now true.",color=orange];
		j3921499284 -> j2965571546;
	j3411780622 [label="J'ai tout gâché la dernière fois. Je ne pouvais pas prendre ce risque à nouveau.",shape=box,color=red];
		j3411780622 -> j590590902;
	j3888617558 [label="J'ai conclu cet accord parce que je tenais absolument à ce que cela fonctionne. ",shape=box,color=red];
		j3888617558 -> j590590902;
	j2268739800 [label="Tout cela pour éviter la terrible honte d'admettre que nous avons besoin de changer.",shape=box,color=blue];
