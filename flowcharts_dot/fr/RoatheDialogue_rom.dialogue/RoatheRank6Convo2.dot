	j2112031733 [label="Tu as vendu ton âme au diable en personne parce que… il tenait déjà ton cœur brisé entre ses mains sans le savoir.",shape=box,color=blue];
		j2112031733 -> j2560703481;
	j2647982700 [label="Non pas que je connaisse quoi que ce soit sur le sujet.",shape=box,color=blue];
		j2647982700 -> j4081414586;
	j481142418 [label="Comme tu le sais, je suis un peu expert en la matière.",shape=box,color=blue];
		j481142418 -> j4081414586;
	j2560703481 [label="Voyageur... mon pauvre, doux, Voyageur...",shape=box,color=blue];
		j2560703481 -> j1724922588;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j1724922588 [label="Pardonne-moi. Je t'en prie, pardonne-moi. Je ne savais pas.",shape=box,color=blue];
		j1724922588 -> j772780804;
	j772780804 [label="Tu dois aussi comprendre que, jusqu'à présent, mon amour était une denrée que personne n'avait cherché à s'approprier. Du moins, pas de manière significative.",shape=box,color=blue];
		j772780804 -> j1085791240;
	j1085791240 [label="Tu semblais donc vouloir vendre ton âme pour pas grand-chose. Tu imagines ma confusion. J'étais perplexe.",shape=box,color=blue];
		j1085791240 -> j3777588696;
