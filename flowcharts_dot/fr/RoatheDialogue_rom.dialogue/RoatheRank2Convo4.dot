digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank2Convo4 begins." [color=orange];
		"RoatheRank2Convo4 begins." -> j1115193858;
	j1115193858 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		j1115193858 -> j1437250236 [label=true,color=green];
		j1115193858 -> "Chat ends." [label=false,color=brown];
	j1437250236 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1437250236 -> j348688340 [label=true,color=green];
		j1437250236 -> j1692949551 [label=false,color=brown];
	"Chat ends." [color=orange];
	j348688340 [label="Hum. Dis-moi. Ai-je réussi à te convaincre la dernière fois que ton \"Indifférence\" n'est qu'un assemblage de jouets disparates, ou crois-tu encore qu'il s'agit d'une \"grande entité mystérieuse venue du Néant\"?",shape=box,color=blue];
		j348688340 -> j3329557192;
	j1692949551 [label="Check boolean RoatheMITW1",color=orange];
		j1692949551 -> j829169506 [label=true,color=green];
		j1692949551 -> j3330689785 [label=false,color=brown];
	j3329557192 [label="S'il y a bien une chose que je déteste, c'est d'être comme un serpent qui se mord la queue. Et cette métaphore était bien plus proverbiale autrefois qu'aujourd'hui, comme je viens de m'en rendre compte.",shape=box,color=blue];
		j3329557192 -> j2163468950;
		j3329557192 -> j4144426754;
		j3329557192 -> j995235307;
	j829169506 [label="Avant de poursuivre, je voudrais m'assurer d'avoir bien compris. Tu crois que l'Indifférence est une entité horrible et mystérieuse venue du Néant, qui s'infiltre dans notre réalité à cause des erreurs d'Albrecht?",shape=box,color=blue];
		j829169506 -> j800974975;
	j3330689785 [label="Tous ceux à qui je parle dans cette maison de fous sont absolument convaincus que cet \"Homme dans le Mur\" est une sorte de dieu littéral et ridicule. Un vrai dieu. Même ces deux fanatiques semblent y croire!",shape=box,color=blue];
		j3330689785 -> j2992657323;
		j3330689785 -> j470734398;
		j3330689785 -> j3478114586;
	j2163468950 [label="Non. Je regrette. ",shape=box,color=red];
		j2163468950 -> j1448654986;
	j4144426754 [label="En fait, oui.",shape=box,color=red];
		j4144426754 -> j2344282195;
	j995235307 [label="Nous ne nous sommes jamais vraiment rangés d'un côté ou de l'autre.",shape=box,color=red];
		j995235307 -> j2575506022;
	j800974975 [label="Permets-moi de reformuler ma question ainsi, avant que nous ne tournions en rond et que nous ne nous retrouvions à nous mordre le queue. Ce qui… est une métaphore qui était autrefois bien plus proverbiale qu’elle ne l’est aujourd’hui, mais je m’égare.",shape=box,color=blue];
		j800974975 -> j1630473752;
	j2992657323 [label="Tu ne penses pas qu'il soit réel?",shape=box,color=red];
		j2992657323 -> j3112633724;
	j470734398 [label="Et si tu ne penses pas qu'il soit un dieu, alors qu'est-ce que tu crois qu'il est?",shape=box,color=red];
		j470734398 -> j2191482082;
	j3478114586 [label="Et pas toi?",shape=box,color=red];
		j3478114586 -> j356028379;
	j1448654986 [label="Boolean RoatheMITWSkip is now true.",color=orange];
		j1448654986 -> j1829103763;
	j2344282195 [label="Boolean RoatheMITWSkip is now true.",color=orange];
		j2344282195 -> j282861176;
	j2575506022 [label="Ah! Eh bien, il semblerait donc que j'aie encore du travail.",shape=box,color=blue];
		j2575506022 -> j301558976;
	j1630473752 [label="Crois-tu que l'entité que tu appelles aujourd'hui l'Indifférence existait avant qu'Albrecht n'entre en contact avec elle? Ou crois-tu qu'il l'a créée lors de sa première interaction avec le Néant?",shape=box,color=blue];
		j1630473752 -> j2806658837;
		j1630473752 -> j1017955255;
		j1630473752 -> j3552379571;
		j1630473752 -> j839481261;
	j3112633724 [label="Ai-je vraiment prononcé ces mots? Ne me fais pas dire ce que je n’ai pas dit, ô Usurpateur Éphémère. Je ne nie pas que l'Indifférence soit \"réelle\". Je dis qu'elle n'est pas un dieu.",shape=box,color=blue];
		j3112633724 -> j18821783;
		j3112633724 -> j1562081909;
	j2191482082 [label="Je peux démasquer cette fausse divinité pour toi en deux mots simples que tu devrais bien connaître et comprendre:",shape=box,color=blue];
		j2191482082 -> j4160830869;
	j356028379 [label="Absolument pas! Premièrement, il n'y a pas de dieu ou de dieux, l'idée est absurde. Deuxièmement, penser qu'Albrecht aurait libéré un dieu du Néant? C'est encore plus risible!",shape=box,color=blue];
		j356028379 -> j2527849095;
	j1829103763 [label="Boolean RoatheMITW5Real is now true.",color=orange];
		j1829103763 -> j1306715842;
	j282861176 [label="Boolean RoatheMITW5Fake is now true.",color=orange];
		j282861176 -> j3983726696;
	j301558976 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j301558976 -> j1253085418;
	j2806658837 [label="Je ne sais pas. Et je ne pense pas que tu puisses le savoir non plus.",shape=box,color=red];
		j2806658837 -> j2703052793;
	j1017955255 [label="Je pense qu'il s'agissait d'une entité qui existait avant qu'Entrati n'interagisse avec elle. Il lui a simplement donné forme et apparence par le biais de l'Incarnation Conceptuelle.",shape=box,color=red];
		j1017955255 -> j3886816954;
	j3552379571 [label="Honnêtement... je ne sais pas.",shape=box,color=red];
		j3552379571 -> j3119402142;
	j839481261 [label="Tu crois vraiment qu'Entrati a inventé de toutes pièces un dieu du Néant maléfique?",shape=box,color=red];
		j839481261 -> j2384139117;
	j18821783 [label="Cette chose est plus puissante que tout ce que j'ai jamais affronté.",shape=box,color=red];
		j18821783 -> j1727848366;
	j1562081909 [label="Alors, à ton avis, qu'est-ce qu'il est?",shape=box,color=red];
		j1562081909 -> j2191482082;
	j4160830869 [label="Incarnation Conceptuelle.",shape=box,color=blue];
		j4160830869 -> j3597495855;
		j4160830869 -> j3192297989;
		j4160830869 -> j1150448058;
	j2527849095 [label="Il n'y a rien dans le Néant. C'est pourquoi on l'appelle le Néant! ",shape=box,color=blue];
		j2527849095 -> j3825714003;
		j2527849095 -> j2949320197;
	j1306715842 [label="+10 Chemistry",color=orange];
		j1306715842 -> j37019639;
	j3983726696 [label="+20 Chemistry",color=orange];
		j3983726696 -> j3887853158;
	j1253085418 [label="Mais avant de poursuivre, je voudrais m'assurer d'avoir bien compris. Tu crois que l'Indifférence est une entité horrible et mystérieuse venue du Néant, qui s'infiltre dans notre réalité à cause des erreurs d'Albrecht?",shape=box,color=blue];
		j1253085418 -> j800974975;
	j2703052793 [label="Si! Je le sais! C'est tellement évident et tellement risible, que vous vous êtes tous persuadés qu'une bête féroce gratte à la fenêtre, alors qu'il ne s'agit que d'une branche d'arbre emportée par le vent.",shape=box,color=blue];
		j2703052793 -> j3180727805;
	j3886816954 [label="Ah non, pas toi aussi. J'avais pourtant bon espoir. C'est tellement évident et tellement risible, que vous vous êtes tous persuadés qu'une bête féroce gratte à la fenêtre, alors qu'il ne s'agit que d'une branche d'arbre emportée par le vent.",shape=box,color=blue];
		j3886816954 -> j3180727805;
	j3119402142 [label="C'est tellement évident et tellement risible, que vous vous êtes tous persuadés qu'une bête féroce gratte à la fenêtre, alors qu'il ne s'agit que d'une branche d'arbre emportée par le vent.",shape=box,color=blue];
		j3119402142 -> j3180727805;
	j2384139117 [label="Si! Je le pense! C'est tellement évident et tellement risible, et vous vous êtes tous persuadés qu'une bête féroce gratte à la fenêtre, alors qu'il ne s'agit que d'une branche d'arbre emportée par le vent.",shape=box,color=blue];
		j2384139117 -> j3180727805;
	j1727848366 [label="Et quand ai-je nié cela, d'ailleurs? En effet, il semble que vous ayez tous réussi à vous créer une situation hystérique et inutilement scandaleuse.",shape=box,color=blue];
		j1727848366 -> j2003801980;
		j1727848366 -> j2426891697;
	j3597495855 [label="Le Néant et ce que nous pouvons en faire est dangereux et puissant – crois-moi, je le sais. Mais il a ses limites. Penses-tu vraiment qu'il soit capable de manifester quelque chose comme ça? De créer des langues entières, des doigts capables d'alimenter des vaisseaux qui voyagent à travers le Néant?",shape=box,color=red];
		j3597495855 -> j1889103885;
	j3192297989 [label="C'est… très tentant de croire que ce n'est qu'un monstre sous notre lit, Roathe. Mais je l'ai vu, face à face et je ne comprends pas comment une chose pareille peut surgir de notre imagination.",shape=box,color=red];
		j3192297989 -> j1267503147;
	j1150448058 [label="L'Incarnation Conceptuelle ne peut accomplir ce dont l'Homme dans le Mur est capable. Bien qu'Entrati ait pu manifester cette chose et qu'il soit responsable de son apparition ici, je ne crois pas qu'il en soit la source originelle.",shape=box,color=red];
		j1150448058 -> j3746700895;
	j3825714003 [label="Je... ",shape=box,color=red];
		j3825714003 -> j1352970910;
	j2949320197 [label="Non. J'ai vu des choses qui viennent du Néant. Des anges. Des chants. Des fantômes.",shape=box,color=red];
		j2949320197 -> j1352970910;
	j37019639 [label="Bien que je sois déçu par ta position inflexible, je trouve ta franchise extrêmement rafraîchissante. Et je suis ravi de ne plus perdre de temps avec toi. Je suis certain que nous trouverons d'autres façons de nous divertir.",shape=box,color=blue];
		j37019639 -> j1582589110;
	j3887853158 [label="Fantastique. Je suis ravi que mon ancien moi ait été si convaincant. Et j'espère que tu es sincère et que tu ne me mens pas pour me faire taire. Mais je n'ai d'autre choix que de te croire.",shape=box,color=blue];
		j3887853158 -> j187370509;
	j3180727805 [label="Seulement, maintenant, sous l’influence du Néant, vous l'avez tous nourrie de tant de peur et de pouvoir que, comme dans un cercle vicieux, cela s’est cristallisé en cette… chose. Cet Homme dans le Mur.",shape=box,color=blue];
		j3180727805 -> j1678138473;
	j2003801980 [label="Qu'est-ce que tu dis?",shape=box,color=red];
		j2003801980 -> j3804821404;
	j2426891697 [label="Attends. En quoi sommes-nous responsables de cela? C'est Albrecht qui est responsable, c'est lui qui l'a lâché.",shape=box,color=red];
		j2426891697 -> j3058999394;
	j1889103885 [label="L'humanité est assurément d'une créativité sans bornes dans l'ampleur et la complexité des nouvelles formes de souffrance qu'elle s'inflige, n'est-ce pas? Tu as toi-même été témoin de nombreuses cruautés dont personne n'aurait osé imaginer la possibilité à l'époque de nos chers fanatiques.",shape=box,color=blue];
		j1889103885 -> j3815133521;
	j1267503147 [label="Ah, tu es si près de la vérité et pourtant si prompt à la rejeter. Tu penses qu'il est \"tentant\" de croire qu'il s'agit d'une création de ton propre esprit, car il serait plus facile de la rejeter si tel était le cas? Non, je pense qu'il est bien plus dangereux d'affronter une création de notre propre fait qu'un dieu.",shape=box,color=blue];
		j1267503147 -> j1826978552;
	j3746700895 [label="J'apprécie ton humilité, mais je conteste ta compréhension limitée du potentiel créatif humain, notamment en ce qui concerne sa capacité à engendrer de nouvelles formes de souffrance. N'es-tu pas, en réalité, l'unique responsable de la création ex nihilo de ton propre univers?",shape=box,color=blue];
		j3746700895 -> j3883024452;
	j1352970910 [label="Le Néant ne produit que ce que nous y plaçons et ce qui nous en revient. Il transforme la matière et l'énergie, mais ne peut les créer.",shape=box,color=blue];
		j1352970910 -> j4285314038;
	j1582589110 [label="Pour ma part, je suis reconnaissant d'être épargné d'une seconde série de débats décousus et stériles sur les subtilités de l'Incarnation Conceptuelle.",shape=box,color=blue];
		j1582589110 -> j187632432;
	j187370509 [label="De toute façon, je suis certain que nous trouverons d'autres façons de nous divertir que de nous perdre dans des débats décousus et circulaires sur les subtilités de l'Incarnation Conceptuelle.",shape=box,color=blue];
		j187370509 -> j804824790;
	j1678138473 [label="Albrecht a peut-être déclenché cette absurdité, mais vous êtes tous responsables d'avoir attisé le feu jusqu'à ce qu'il devienne un véritable brasier. L'Indifférence n'a jamais existé. Jusqu'à ce que, soudain, elle apparaisse. ",shape=box,color=blue];
		j1678138473 -> j3310699443;
	j3804821404 [label="Ce que je veux dire, c'est qu'Albrecht est peut-être celui qui, à l'origine, a vu sa propre arrogance lui renvoyer l'image d'un dieu de la destruction souriant, oui.",shape=box,color=blue];
		j3804821404 -> j1653840936;
	j3058999394 [label="Albrecht est peut-être celui qui, à l'origine, a vu sa propre arrogance lui renvoyer l'image d'un dieu de la destruction souriant, oui.",shape=box,color=blue];
		j3058999394 -> j1653840936;
	j3815133521 [label="+5 Chemistry",color=orange];
		j3815133521 -> j3138058346;
	j1826978552 [label="Un ennemi extérieur peut être compris, manipulé, vaincu. On peut même négocier avec, si nécessaire. Il a des faiblesses exploitables. Mais un ennemi intérieur? Un ennemi que nous avons nous-mêmes créé? C’est bien plus insidieux.",shape=box,color=blue];
		j1826978552 -> j2798743105;
	j3883024452 [label="Tu as toi-même été témoin de nombreuses formes de cruauté et je suis sûr que personne n'aurait pu imaginer qu'elles fussent possibles à l'époque de nos chers zélotes. ",shape=box,color=blue];
		j3883024452 -> j3815133521;
	j4285314038 [label="Réfléchis, Voyageur. Ces \"Anges du Néant\" dont tu parles. Ces fantômes. Étaient-ils faits de ceux déjà perdus dans le Néant?",shape=box,color=blue];
		j4285314038 -> j1338438029;
	j187632432 [label="Même si cela veut dire plus de temps pour me faire sermonner par les fanatiques… bah. Ah, les choix…",shape=box,color=blue];
		j187632432 -> "Chat ends.";
	j804824790 [label="Pour ma part, je suis reconnaissant d'être épargné d'une seconde série.",shape=box,color=blue];
		j804824790 -> j187632432;
	j3310699443 [label="Et vous en êtes tous responsables.",shape=box,color=blue];
		j3310699443 -> j4117206988;
		j3310699443 -> j3138374429;
		j3310699443 -> j1925100465;
	j1653840936 [label="Mais vous êtes tous tout aussi coupables d'avoir continué à faire rouler cette crotte de punaise sur la pente pendant si longtemps, la faisant grossir à chaque déjection qu'elle ramassait en chemin !",shape=box,color=blue];
		j1653840936 -> j3522777726;
	j3138058346 [label="En tant qu'espèce, nous sommes assez extraordinaires dans notre capacité à nourrir nos peurs de nouvelles façons de nous autodétruire.",shape=box,color=blue];
		j3138058346 -> j1801055520;
	j2798743105 [label="+5 Chemistry",color=orange];
		j2798743105 -> j1527354441;
	j1338438029 [label="Ce n'étaient que des échos d'énergie régurgitée, comme un kutak coloré qui nourrit ses petits.",shape=box,color=blue];
		j1338438029 -> j3522777726;
	j4117206988 [label="On ne peut pas créer des choses comme ça, Roathe, je te l'ai dit. L'Incarnation Conceptuelle a ses limites.",shape=box,color=red];
		j4117206988 -> j2588061067;
	j3138374429 [label="Ne nous tiens pas responsables. Nous ne sommes pas coupables des dégâts causés par cette chose.",shape=box,color=red];
		j3138374429 -> j3776110926;
	j1925100465 [label="Explique-moi ton raisonnement sur la façon dont cela fonctionnerait. La plupart des choses créées par Incarnation Conceptuelle à partir du Néant ne peuvent pas le quitter, du moins pas longtemps.",shape=box,color=red];
		j1925100465 -> j3729199766;
	j3522777726 [label="Permets-moi de simplifier la discussion. Je peux démasquer cette fausse divinité pour toi en deux mots simples que tu devrais bien connaître et comprendre:",shape=box,color=blue];
		j3522777726 -> j4160830869;
	j1801055520 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j1801055520 -> j800974975;
	j1527354441 [label="Car alors, nous devons combattre ou apprivoiser nos démons. Et l'humanité… ne gagne jamais de telles guerres, n'est-ce pas?",shape=box,color=blue];
		j1527354441 -> j1801055520;
	j2588061067 [label="Tu oses dire cela après avoir créé une dimension parallèle complète? Voyons, Voyageur… fais appel à ton imagination comme tu le faisais autrefois.",shape=box,color=blue];
		j2588061067 -> j3729199766;
	j3776110926 [label="Je ne vous réprimande pas! Ce projet était déjà en préparation bien avant votre arrivée. Albrecht s'en est chargé.",shape=box,color=blue];
		j3776110926 -> j3819976392;
	j3729199766 [label="L'Incarnation Conceptuelle fonctionne ainsi: lors d'interactions avec le Néant, ou à proximité du Néant, des émotions et des pensées puissantes peuvent se manifester physiquement. Nous le savons tous les deux.",shape=box,color=blue];
		j3729199766 -> j4055101036;
		j3729199766 -> j3283226137;
		j3729199766 -> j3841777155;
	j3819976392 [label="Il a vu son reflet et il a connu la peur authentique. Ainsi jaillit la première étincelle qui alluma l'incendie menaçant de tout réduire en cendres. Vous ne faites que l'attiser.",shape=box,color=blue];
		j3819976392 -> j3729199766;
	j4055101036 [label="Exactement. Tout comme Duviri, elle partage un lien avec ce monde via le Zariman. ",shape=box,color=red];
		j4055101036 -> j2342443672;
	j3283226137 [label="Comme le Zariman, les Irréductibles et les Anges du Néant. Le Néant est omniprésent sur ce vaisseau.",shape=box,color=red];
		j3283226137 -> j2342443672;
	j3841777155 [label="Oui. Et?",shape=box,color=red];
		j3841777155 -> j3594855567;
	j2342443672 [label="Exactement. Là où va le Néant, l'Incarnation Conceptuelle peut suivre. Et seulement là.",shape=box,color=blue];
		j2342443672 -> j3759471175;
		j2342443672 -> j1017585578;
	j3594855567 [label="Là où va le Néant, l'Incarnation Conceptuelle peut suivre. Et seulement là.",shape=box,color=blue];
		j3594855567 -> j3759471175;
		j3594855567 -> j1017585578;
	j3759471175 [label="Mais elle a été jusqu'en 1999. Elle a suivi Albrecht partout. Et moi, aussi.",shape=box,color=red];
		j3759471175 -> j1205812852;
	j1017585578 [label="Attends...",shape=box,color=red];
		j1017585578 -> j2137162524;
	j1205812852 [label="Les fichus doigts. Nous avons pris ces doigts maudits, dans une tentative désespérée et folle d'atteindre Tau et nous autres Orokins avons trouvé un moyen de les reproduire, n'est-ce pas?",shape=box,color=blue];
		j1205812852 -> j95736067;
	j2137162524 [label="Oui. Tu comprends, maintenant. Les fichus doigts. Nous avons pris ces doigts maudits, dans une tentative désespérée et folle d'atteindre Tau et nous autres Orokins avons trouvé un moyen de les reproduire, n'est-ce pas?",shape=box,color=blue];
		j2137162524 -> j95736067;
	j95736067 [label="Des bribes du Néant, partout où tu vas… Un réseau de tranchées et de tunnels par lequel cette chose surgit où bon lui semble. Et pire encore?",shape=box,color=blue];
		j95736067 -> j1151519880;
	j1151519880 [label="Le Tenno. Et vous. Vous tous, touchés par le Néant. Et vous tous, hantés par cette chose, car où que vous alliez, elle peut vous suivre.",shape=box,color=blue];
		j1151519880 -> j2430207744;
	j2430207744 [label="Et probablement tous ceux qui ont eu un contact prolongé avec ce lieu. Entrati. Son majordome. Les Cavias. Moi-même, les fanatiques, de par notre proximité avec Sanctum. La liste est longue.",shape=box,color=blue];
		j2430207744 -> j157601585;
		j2430207744 -> j2934672535;
	j157601585 [label="Tu soutiens donc que toute personne suffisamment exposée au Néant – ou toute personne qui est une \"batterie\" – devient une autre fenêtre par laquelle l'Homme dans le Mur peut observer?",shape=box,color=red];
		j157601585 -> j1063273519;
	j2934672535 [label="Et dans le cas de Rusalka, je me demande?",shape=box,color=red];
		j2934672535 -> j1477330669;
	j1063273519 [label="Précisément. ",shape=box,color=blue];
		j1063273519 -> j2619214706;
	j1477330669 [label="Qui?",shape=box,color=blue];
		j1477330669 -> j2834136074;
		j1477330669 -> j84785035;
	j2619214706 [label="Ce qui expliquerait pourquoi cette chose ne peut pas porter son propre visage, n'est-ce pas? Elle ne peut apparaître qu'à travers les traits de ceux qu'elle tourmente, à ceux qu'elle tente de tourmenter.",shape=box,color=blue];
		j2619214706 -> j4141298617;
	j2834136074 [label="Le Major Neci Rusalka. Elle était à la tête de l'unité militaire connue sous le nom de Scaldra en 1999, en Höllvanie.",shape=box,color=red];
		j2834136074 -> j690451858;
	j84785035 [label="En résumé, je ne devrais jamais, au grand jamais, vous permettre de vous rencontrer.",shape=box,color=red];
		j84785035 -> j351570001;
	j4141298617 [label="En réalité, elle ne semble prendre cette apparence d'architecture que lorsqu'elle est incapable de se présenter comme quelque chose de plus grand et de différent. Lorsqu'elle tente désespérément de transmettre un sentiment de grandeur et de divinité.",shape=box,color=blue];
		j4141298617 -> j211910196;
		j4141298617 -> j189187336;
	j690451858 [label="Elle était, ou est encore, possédée par l'Indifférence. Celle-ci prend possession de son esprit, la manipule comme une marionnette. Ou bien elle l'a laissée entrer. Nous l'ignorons. Nous ignorons également si elle a réellement repris le contrôle.",shape=box,color=red];
		j690451858 -> j2886870955;
	j351570001 [label="Tu n'es vraiment pas drôle, Usurpateur. Mais qu'a-t-elle à voir avec notre... Indifférence, précisément?",shape=box,color=blue];
		j351570001 -> j690451858;
	j211910196 [label="Tu penses donc qu'elle prend l'apparence de toutes les personnes avec lesquelles elle entre en contact... parce qu'elle n'a pas de visage propre?",shape=box,color=red];
		j211910196 -> j4241448944;
	j189187336 [label="Je crois que l'Homme dans le Mur choisit de porter nos visages parce qu'il ne peut comprendre ce que c'est que d'être humain. Il est trop \"grand\", sinon.",shape=box,color=red];
		j189187336 -> j137465627;
	j2886870955 [label="Elle semble être une personne délicieusement formidable. Un vrai régal. Mais passons. Tu dis que l'Indifférence la contrôle? Et tout cela a commencé pendant ta petite escapade dans le passé?",shape=box,color=blue];
		j2886870955 -> j2373921354;
	j4241448944 [label="Non, ne sois pas ridicule. Car il ne fait qu'imiter ce qui l'a créé. Ce n'est pas une entité complète; ce n'est qu'un jouet fait de fragments disparates, fruits des peurs, des angoisses et des souffrances dont il a été nourri. ",shape=box,color=blue];
		j4241448944 -> j3499264258;
	j137465627 [label="Non, ne sois pas ridicule. Il ne fait qu'imiter ce qui l'a créé. Ce n'est pas une entité complète; ce n'est qu'un jouet fait de fragments disparates, fruits des peurs, des angoisses et des souffrances dont il a été nourri.",shape=box,color=blue];
		j137465627 -> j3499264258;
	j2373921354 [label="Eh bien, si ce que nous savons du Néant est exact, alors deux choses peuvent s'être produites: soit elle s'est retrouvée par hasard dans une instance du Néant en 1999, de son propre chef (ce que je trouve profondément improbable, mais pas impossible), soit…",shape=box,color=blue];
		j2373921354 -> j2792336992;
	j3499264258 [label="Bah. Je vois que je n'avancerai pas aujourd'hui. Tant pis, tu as profondément assimilé cette propagande dont on vous a nourris. Albrecht est un gourou de secte terriblement convaincant, je le crains.",shape=box,color=blue];
		j3499264258 -> j3138049155;
	j2792336992 [label="Notre cher Albrecht s'en est encore mêlé.",shape=box,color=blue];
		j2792336992 -> j3834898740;
		j2792336992 -> j1575806728;
		j2792336992 -> j3741517381;
	j3138049155 [label="+10 Chemistry",color=orange];
		j3138049155 -> j3743754168;
	j3834898740 [label="Insinues-tu qu'Albrecht a fait de Neci la marionnette de l'Indifférence intentionnellement?",shape=box,color=red];
		j3834898740 -> j3059186625;
	j1575806728 [label="Nous ignorons si tout cela est vrai. Ce ne sont que des spéculations. Tout cela pourrait être de purs mensonges.",shape=box,color=red];
		j1575806728 -> j1351402964;
	j3741517381 [label="S'il a ouvert une brèche vers le Néant en 1999 et l'a laissée entrer intentionnellement... cela expliquerait pourquoi les Warframes fonctionnaient là-bas dès le départ... même chose pour ton époque - sans le Cœur de Deimos, bien sûr.",shape=box,color=red];
		j3741517381 -> j3316501189;
	j3743754168 [label="Boolean RoatheMITW2 is now true.",color=orange];
		j3743754168 -> j167552169;
	j3059186625 [label="Je ne fais que lire dans le marc de café du mieux que je peux, Usurpateur. Loin de moi l'idée d'insinuer qu'Albrecht ait délibérément ouvert une brèche dans le Néant en Höllvanie pour y laisser entrer l'Indifférence et lui donner un avatar…",shape=box,color=blue];
		j3059186625 -> j1413093158;
	j1351402964 [label="Bien sûr! Je ne fais que lire dans le marc de café du mieux que je peux, Usurpateur. Loin de moi l'idée d'insinuer qu'Albrecht ait délibérément ouvert une brèche dans le Néant en Höllvanie pour y laisser entrer l'Indifférence et lui donner un avatar…",shape=box,color=blue];
		j1351402964 -> j1413093158;
	j3316501189 [label="Tu vois? Il ne faut jamais faire confiance à un scientifique. Ils sont capables de tout pour inventer quelque chose. Mais bon, moi, je ne fais que lire dans le marc de café, Usurpateur. Ce ne sont que des conjectures.",shape=box,color=blue];
		j3316501189 -> j479345061;
	j167552169 [label="J'espère t'avoir au moins donné matière à réflexion. Pour l'instant, je dois y aller.",shape=box,color=blue];
		j167552169 -> "Chat ends.";
	j1413093158 [label="Il me semble, en tant que tacticien et homme habitué à élaborer des stratégies de guerre...",shape=box,color=blue];
		j1413093158 -> j3686928285;
	j479345061 [label="Loin de moi l'idée d'insinuer qu'Albrecht ait délibérément ouvert une brèche dans le Néant en Höllvanie pour y laisser entrer l'Indifférence et lui donner un avatar! Il me semble simplement, en tant que tacticien et homme habitué aux stratégies de guerre…",shape=box,color=blue];
		j479345061 -> j3686928285;
	j3686928285 [label="Que la première étape pour vaincre un adversaire invisible, capable d'être n'importe où, n'importe qui et n'importe quand, consiste à réduire au minimum les options possibles...",shape=box,color=blue];
		j3686928285 -> j1628248501;
	j1628248501 [label="+20 Chemistry",color=orange];
