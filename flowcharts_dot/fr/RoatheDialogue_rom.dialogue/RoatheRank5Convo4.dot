		j3026861982 -> j156480986;
	j2968484668 [label="Comme tu veux. Mais souviens-toi: la seule chose plus dangereuse qu'un diable... c'est un diable qui a des amis comme toi, avec des dettes.",shape=box,color=blue];
		j2968484668 -> "Chat ends.";
	j1267884227 [label="Boolean RoatheLyonConfessionDeal is now false.",color=orange];
		j1267884227 -> j1335357599;
	j556179476 [label="J'espère que cela ne provoquera pas de la jalousie de ta part. Ce n'est pas mon intention. J'essaie simplement d'expliquer à quel point elle m'a fait du mal.",shape=box,color=blue];
		j556179476 -> j3886002902;
	j3665217863 [label="Sans elle, je ne serais pas ce que je suis. J'ai tout appris d'elle. Elle prenait de l'argile brute et la façonnait.",shape=box,color=blue];
		j3665217863 -> j683996044;
		j3665217863 -> j1749693384;
		j3665217863 -> j2362773796;
	j156480986 [label="+5 Chemistry",color=orange];
		j156480986 -> j3999224523;
	j1335357599 [label="+5 Chemistry",color=orange];
		j1335357599 -> j3922182699;
	j3886002902 [label="Et pourtant, je lui dois énormément. Sans elle, je ne serais pas ce que je suis. J'ai tout appris d'elle. Elle prenait de l'argile brute et la façonnait.",shape=box,color=blue];
		j3886002902 -> j683996044;
		j3886002902 -> j429568160;
		j3886002902 -> j1479768460;
	j683996044 [label="Je comprends. J'ai vécu une relation similaire, autrefois.",shape=box,color=red];
		j683996044 -> j4005251479;
	j1749693384 [label="On dirait que tu n'as pas encore tout à fait surmonté tes sentiments pour elle.",shape=box,color=red];
		j1749693384 -> j2518555389;
	j2362773796 [label="Penses-tu qu'elle est encore en vie? Ou penses-tu qu'elle est morte?",shape=box,color=red];
		j2362773796 -> j3889389859;
	j3999224523 [label="C'est comme si c'était fait. Mais souviens-toi: la seule chose plus dangereuse qu'un diable... c'est un diable qui a des amis comme toi, avec des dettes.",shape=box,color=blue];
		j3999224523 -> "Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j3922182699 [label="C'est comme si c'était fait. Mais souviens-toi: la seule chose plus dangereuse qu'un diable... c'est un diable qui a des amis comme toi, avec des dettes.",shape=box,color=blue];
		j3922182699 -> "Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j429568160 [label="Je comprends. Ça va.",shape=box,color=red];
		j429568160 -> j2826041540;
	j1479768460 [label="Je préférerais que tu ne parles pas d'elle.",shape=box,color=red];
		j1479768460 -> j2602936962;
	j4005251479 [label="+5 Chemistry",color=orange];
		j4005251479 -> j4019700540;
	j2518555389 [label="Ce n'est pas tout à fait exact. Je ne l'aime plus. Je me fiche désormais qu'elle meure de façon brutale de ma propre main. Mais je suis irrésistiblement curieux de savoir comment son histoire s'est terminée.",shape=box,color=blue];
		j2518555389 -> j686698991;
	j3889389859 [label="Il est difficile d'imaginer que quelqu'un ayant un tel goût pour le sang et la mort soit resté aussi silencieuse pendant tous ces siècles.",shape=box,color=blue];
		j3889389859 -> j3029839077;
	"Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
	"Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j2826041540 [label="C’est par souci du passé que je suis curieux de savoir ce qu’elle est devenue. Simplement parce que je veux savoir comment son histoire s’est terminée. Si tant est qu’elle ait eu une fin.",shape=box,color=blue];
		j2826041540 -> j686698991;
	j2602936962 [label="Excuse-moi, c'est toi qui en as parlé. Tu as un côté déroutant, cher Voyageur.",shape=box,color=blue];
		j2602936962 -> "Chat ends.";
	j4019700540 [label="Tu comprendras alors ma curiosité quant à son sort. Tout simplement parce que je souhaite connaître la fin de son histoire. Si tant est qu'elle ait une fin.",shape=box,color=blue];
		j4019700540 -> j686698991;
	j686698991 [label="Il est difficile de se débarrasser de ceux qui ont joué un rôle si déterminant dans notre propre histoire. Aussi venimeux soient-ils.",shape=box,color=blue];
		j686698991 -> j3889389859;
	j3029839077 [label="Si elle est encore en vie, ce n'est pas par choix qu'elle garde le silence.",shape=box,color=blue];
		j3029839077 -> j370514231;
	j370514231 [label="Je dirai toutefois ceci: si elle est encore en vie?",shape=box,color=blue];
		j370514231 -> j775351689;
	j775351689 [label="+5 Chemistry",color=orange];
		j775351689 -> j1630355084;
	j1630355084 [label="Tu pourrais bien prier pour le retour de Ballas.",shape=box,color=blue];
		j1630355084 -> "Chat ends.";
