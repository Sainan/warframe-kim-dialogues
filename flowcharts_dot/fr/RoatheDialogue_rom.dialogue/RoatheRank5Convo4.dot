		j1369030645 -> j322678358;
	j3076887827 [label="Mais je pense à elle plus souvent maintenant que tous mes souvenirs me sont revenus.",shape=box,color=blue];
		j3076887827 -> j4254018165;
	j3202184036 [label="Qu'est-ce que c'est, exactement? Tu n'as jamais dit ce que tu voulais.",shape=box,color=red];
		j3202184036 -> j1254070521;
	j1250988796 [label="Je crois que tu bluffes. Je ne pense même pas que tu aies un plan pour ce que tu veux. ",shape=box,color=red];
