	j4177741810 [label="Quelle question déroutante! Je me la suis posée moi-même à maintes reprises depuis ma transformation en cet amalgame Infesté.",shape=box,color=blue];
		j4177741810 -> j3076887827;
	j1669402582 [label="Je viendrai chercher ce qui me revient de droit, que j'aie dû ou non remplir ma part de l'accord.",shape=box,color=blue];
		j1669402582 -> j3202184036;
		j1669402582 -> j1250988796;
	j1606068075 [label="Je n'ai pas réussi à la faire céder...",shape=box,color=red];
		j1606068075 -> j809949801;
	j374914680 [label="Il n'y a pas de problème à laisser les choses comme elles sont. Je n'ai pas besoin de ton aide.",shape=box,color=red];
		j374914680 -> j1352342443;
	j3875576592 [label="Non, j'ai l'impression d'avoir échoué.",shape=box,color=red];
		j3875576592 -> j992560280;
