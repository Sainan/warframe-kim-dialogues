digraph {
	135 [label="RoatheRank1Convo2 begins.",color=orange];
		135 -> 136;
	136 [label="Tu te rends bien compte que ta soi-disant \"Indifférence\" n'est pas un véritable \"dieu\", n'est-ce pas?",shape=box,color=blue];
		136 -> 139;
		136 -> 138;
		136 -> 137;
	139 [label="Elle s'en rapproche assez.",shape=box,color=red];
		139 -> 142;
	138 [label="Et qu'est-ce qui te rend si sûr de toi?",shape=box,color=red];
		138 -> 141;
	137 [label="[Fin.]",shape=box,color=red];
		137 -> 140;
	142 [label="Tous ceux à qui je parle dans cette maison de fous sont absolument convaincus que cet \"Homme dans le Mur\" est une sorte de dieu littéral et ridicule. Un vrai dieu. Même ces deux fanatiques semblent y croire!",shape=box,color=blue];
		142 -> 144;
		142 -> 145;
		142 -> 146;
	141 [label="Bon, abstraction faite de la dure réalité selon laquelle toute croyance en un dieu ou des dieux provient d'idiots qui s'accrochent à: premièrement, un besoin impérieux de serrer contre soi un animal en peluche lorsqu'on est confronté à l'horreur brutale de la finalité de son âme au moment de la mort.",shape=box,color=blue];
		141 -> 143;
	140 [label="Chat ends.",color=orange];
	144 [label="Tu ne penses pas qu'il soit réel?",shape=box,color=red];
		144 -> 148;
	145 [label="Et si tu ne penses pas qu'il soit un dieu, alors qu'est-ce que tu crois qu'il est?",shape=box,color=red];
		145 -> 149;
	146 [label="Et pas toi?",shape=box,color=red];
		146 -> 150;
	143 [label="Deuxièmement, l'anxiété que l'on ressent lorsqu'on réalise qu'il n'existe pas de \"Puissance supérieure\" qui trace notre chemin dans nos vies et que, par conséquent, nous sommes simplement responsables de nos propres actions et donc, par extension...",shape=box,color=blue];
		143 -> 147;
	148 [label="Ai-je vraiment prononcé ces mots? Ne me fais pas dire ce que je n’ai pas dit, ô Usurpateur Éphémère. Je ne nie pas que l'Indifférence soit \"réelle\". Je dis qu'elle n'est pas un dieu.",shape=box,color=blue];
		148 -> 152;
		148 -> 153;
	149 [label="Je peux démasquer cette fausse divinité pour toi en deux mots simples que tu devrais bien connaître et comprendre:",shape=box,color=blue];
		149 -> 154;
	150 [label="Absolument pas! Premièrement, il n'y a pas de dieu ou de dieux, l'idée est absurde. Deuxièmement, penser qu'Albrecht aurait libéré un dieu du Néant? C'est encore plus risible!",shape=box,color=blue];
		150 -> 155;
	147 [label="Troisièmement, la juste colère qui accompagne l'angoisse et l'horreur, lorsque tout cela conduit à la révélation qu'il n'y a pas \"d'Enfer\" pour les démons, ni de \"Paradis\" pour les anges.",shape=box,color=blue];
		147 -> 151;
	152 [label="Cette chose est plus puissante que tout ce que j'ai jamais affronté.",shape=box,color=red];
		152 -> 156;
	153 [label="Alors, à ton avis, qu'est-ce qu'il est?",shape=box,color=red];
		153 -> 149;
	154 [label="Incarnation Conceptuelle.",shape=box,color=blue];
		154 -> 157;
		154 -> 158;
		154 -> 159;
	155 [label="Il n'y a rien dans le Néant. C'est pourquoi on l'appelle le Néant! ",shape=box,color=blue];
		155 -> 160;
		155 -> 161;
	151 [label="Je pars du principe que tu n'es pas du genre fanatique enragé, prisonnier de la colère, de l'horreur ou de l'angoisse. Partant de ce postulat, je vais maintenant te présenter le second argument que je souhaite soumettre pour dépouiller \"l'Indifférence\" de son statut de divinité:",shape=box,color=blue];
		151 -> 154;
	156 [label="Et quand ai-je nié cela, d'ailleurs? En effet, il semble que vous ayez tous réussi à vous créer une situation hystérique et inutilement scandaleuse.",shape=box,color=blue];
		156 -> 162;
		156 -> 163;
	157 [label="Le Néant et ce que nous pouvons en faire est dangereux et puissant – crois-moi, je le sais. Mais il a ses limites. Penses-tu vraiment qu'il soit capable de manifester quelque chose comme ça? De créer des langues entières, des doigts capables d'alimenter des vaisseaux qui voyagent à travers le Néant?",shape=box,color=red];
		157 -> 164;
	158 [label="C'est… très tentant de croire que ce n'est qu'un monstre sous notre lit, Roathe. Mais je l'ai vu, face à face et je ne comprends pas comment une chose pareille peut surgir de notre imagination.",shape=box,color=red];
		158 -> 165;
	159 [label="L'Incarnation Conceptuelle ne peut accomplir ce dont l'Homme dans le Mur est capable. Bien qu'Entrati ait pu manifester cette chose et qu'il soit responsable de son apparition ici, je ne crois pas qu'il en soit la source originelle.",shape=box,color=red];
		159 -> 166;
	160 [label="Non. J'ai vu des choses qui viennent du Néant. Des anges. Des chants. Des fantômes.",shape=box,color=red];
		160 -> 167;
	161 [label="Je... ",shape=box,color=red];
		161 -> 167;
	162 [label="Qu'est-ce que tu dis?",shape=box,color=red];
		162 -> 168;
	163 [label="Attends. En quoi sommes-nous responsables de cela? C'est Albrecht qui est responsable, c'est lui qui l'a lâché.",shape=box,color=red];
		163 -> 169;
	164 [label="L'humanité est assurément d'une créativité sans bornes dans l'ampleur et la complexité des nouvelles formes de souffrance qu'elle s'inflige, n'est-ce pas? Tu as toi-même été témoin de nombreuses cruautés dont personne n'aurait osé imaginer la possibilité à l'époque de nos chers fanatiques.",shape=box,color=blue];
		164 -> 170;
	165 [label="Ah, tu es si près de la vérité et pourtant si prompt à la rejeter. Tu penses qu'il est \"tentant\" de croire qu'il s'agit d'une création de ton propre esprit, car il serait plus facile de la rejeter si tel était le cas? Non, je pense qu'il est bien plus dangereux d'affronter une création de notre propre fait qu'un dieu.",shape=box,color=blue];
		165 -> 171;
	166 [label="J'apprécie ton humilité, mais je conteste ta compréhension limitée du potentiel créatif humain, notamment en ce qui concerne sa capacité à engendrer de nouvelles formes de souffrance. N'es-tu pas, en réalité, le seul responsable de la création ex nihilo de ton propre univers?",shape=box,color=blue];
		166 -> 172;
	167 [label="Le Néant ne produit que ce que nous y plaçons et ce qui nous en revient. Il transforme la matière et l'énergie, mais ne peut les créer.",shape=box,color=blue];
		167 -> 173;
	168 [label="Ce que je veux dire, c'est qu'Albrecht est peut-être celui qui, à l'origine, a vu sa propre arrogance lui renvoyer l'image d'un dieu de la destruction souriant, oui.",shape=box,color=blue];
		168 -> 174;
	169 [label="Albrecht est peut-être celui qui, à l'origine, a vu sa propre arrogance lui renvoyer l'image d'un dieu de la destruction souriant, oui.",shape=box,color=blue];
		169 -> 174;
	170 [label="+15 Chemistry",color=orange];
		170 -> 175;
	171 [label="Un ennemi extérieur peut être compris, manipulé, vaincu. On peut même négocier avec, si nécessaire. Il a des faiblesses exploitables. Mais un ennemi intérieur? Un ennemi que nous avons nous-mêmes créé? C’est bien plus insidieux.",shape=box,color=blue];
		171 -> 176;
	172 [label="Tu as toi-même été témoin de nombreuses formes de cruauté et je suis sûr que personne n'aurait pu imaginer qu'elles fussent possibles à l'époque de nos chers zélotes. ",shape=box,color=blue];
		172 -> 177;
	173 [label="Réfléchis, Voyageur. Ces \"Anges du Néant\" dont tu parles. Ces fantômes. Étaient-ils faits de ceux déjà perdus dans le Néant?",shape=box,color=blue];
		173 -> 178;
	174 [label="Mais vous êtes tous tout aussi coupables d'avoir continué à faire rouler cette crotte de punaise sur la pente pendant si longtemps, la faisant grossir à chaque déjection qu'elle ramassait en chemin !",shape=box,color=blue];
		174 -> 179;
	175 [label="En tant qu'espèce, nous sommes assez extraordinaires dans notre capacité à nourrir nos peurs de nouvelles façons de nous autodétruire.",shape=box,color=blue];
		175 -> 180;
	176 [label="+20 Chemistry",color=orange];
		176 -> 181;
	177 [label="+10 Chemistry",color=orange];
		177 -> 175;
	178 [label="Ce n'étaient que des échos d'énergie régurgitée, comme un kutak coloré qui nourrit ses petits.",shape=box,color=blue];
		178 -> 179;
	179 [label="Permets-moi de simplifier la discussion. Je peux démasquer cette fausse divinité pour toi en deux mots simples que tu devrais bien connaître et comprendre:",shape=box,color=blue];
		179 -> 154;
	180 [label="Hum. Je crains de devoir partir. Je te laisse méditer un moment sur mes paroles.",shape=box,color=blue];
		180 -> 182;
		180 -> 183;
	181 [label="Car alors, nous devons combattre ou apprivoiser nos démons. Et l'humanité… ne gagne jamais de telles guerres, n'est-ce pas?",shape=box,color=blue];
		181 -> 180;
	182 [label="Je vais le faire. Merci.",shape=box,color=red];
		182 -> 184;
	183 [label="Réfléchis aux miennes, tu pourrais finir par vouloir y croire lorsque tu seras confronté à un anti-dieu.",shape=box,color=red];
		183 -> 184;
	184 [label="Update boolean RoatheMITW1",color=orange];
		184 -> 185;
	185 [label="Chat ends.",color=orange];
}