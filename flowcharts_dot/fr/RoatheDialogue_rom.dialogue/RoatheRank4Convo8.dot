digraph {
	3120 [label="RoatheRank4Convo8 begins.",color=orange];
		3120 -> 3121;
		3120 -> 3122;
	3121 [label="À quoi ressemblait ton enfance, Roathe?",shape=box,color=red];
		3121 -> 3123;
	3122 [label="[Fin.]",shape=box,color=red];
		3122 -> 3124;
	3123 [label="Hum? Question intéressante. C'était \"comment\"? Honnêtement, je ne m'en souviens pas très bien. Et les étoiles et les sculptures qui renfermaient ces souvenirs sont probablement réduites en poussière ou transformées en Endo depuis longtemps, j'imagine.",shape=box,color=blue];
		3123 -> 3125;
	3124 [label="Chat ends.",color=orange];
	3125 [label="Je crains de ne pouvoir me souvenir que de vagues images, tant cela remonte à loin. Je me demande si je ne l'ai pas imaginé, comme dans un rêve, ou si je n'attribue pas des images aux événements que j'ai lus dans un livre d'histoire.",shape=box,color=blue];
		3125 -> 3126;
	3126 [label="Par conséquent, ce dont je me souviens est probablement très peu fiable, je l'admets. Pourquoi cette question?",shape=box,color=blue];
		3126 -> 3127;
		3126 -> 3128;
		3126 -> 3129;
	3127 [label="Même si ces histoires sont fausses, elles restent le récit que tu te fais de tes années de formation. Elles méritent d'être connues.",shape=box,color=red];
		3127 -> 3130;
	3128 [label="J'aimerais savoir ce que c'était que de grandir dans la noblesse Orokin.",shape=box,color=red];
		3128 -> 3131;
	3129 [label="Je me demande ce qui a fait de toi ce que tu es. Comment tu as pu devenir comme ça.",shape=box,color=red];
		3129 -> 3132;
	3130 [label="+5 Chemistry",color=orange];
		3130 -> 3133;
	3131 [label="J'ai été envoyé très jeune dans ce que les fanatiques appelleraient un \"internat\", comme tous les jeunes Orokins destinés à un grand destin. Là, j'ai été mis à l'épreuve et entraîné pour déceler mes inclinations et mes aptitudes.",shape=box,color=blue];
		3131 -> 3134;
		3131 -> 3135;
	3132 [label="+5 Chemistry",color=orange];
		3132 -> 3136;
	3133 [label="Je suis d'accord, les mensonges que l'on se raconte sont souvent plus importants que la vérité. Une observation pertinente, Usurpateur.",shape=box,color=blue];
		3133 -> 3137;
	3134 [label="Tes parents t'ont simplement laissé partir? Combien de temps?",shape=box,color=red];
		3134 -> 3138;
	3135 [label="Comment c'était, là-bas?",shape=box,color=red];
		3135 -> 3139;
	3136 [label="Tu essaies de deviner où j'ai \"dévié\"? Je vois! C'est amusant. Je ne sais pas, mais tu trouveras dans mon enfance de quoi répondre à tes questions.",shape=box,color=blue];
		3136 -> 3140;
	3137 [label="Add -1 to Thermostat",color=orange];
		3137 -> 3131;
	3138 [label="Toute ma jeunesse. Je ne crois pas avoir revu mes géniteurs. Peut-être lors de la cérémonie où j'ai été premier de ma promotion?",shape=box,color=blue];
		3138 -> 3141;
	3139 [label="Je pense que l'opinion varierait énormément selon la personne à qui l'on s'adresserait. À mon arrivée, les corrections que me donnaient les plus grands étaient rapides et les leçons d'une efficacité brutale.",shape=box,color=blue];
		3139 -> 3142;
	3140 [label="Add 1 to Thermostat",color=orange];
		3140 -> 3131;
	3141 [label="Je crois que c'était la première fois qu'ils jugeaient bon de s'annoncer comme mes parents. Je n'y prête pas beaucoup d'attention.",shape=box,color=blue];
		3141 -> 3143;
	3142 [label="Mais j'apprends vite, en toutes choses. Et j'ai compris que si je voulais exceller dans ce domaine particulier de l'apprentissage des Archimédiens, je devais employer des techniques créatives pour ne pas me retrouver parmi les médiocres.",shape=box,color=blue];
		3142 -> 3144;
		3142 -> 3145;
	3143 [label="Je ne me souviens pas de grand-chose de mes parents. Si certains Orokins tenaient à élever leurs propres enfants, les miens, eux, n'en avaient aucune envie. Ils étaient surtout pressés de se débarrasser de moi et de continuer leur petit chemin dans la vie.",shape=box,color=blue];
		3143 -> 3146;
		3143 -> 3147;
	3144 [label="Les Archimédiens laissaient passer ça?",shape=box,color=red];
		3144 -> 3148;
	3145 [label="C'est... horrible.",shape=box,color=red];
		3145 -> 3149;
	3146 [label="Cela ne semblait pas t'avoir freiné dans la vie.",shape=box,color=red];
		3146 -> 3150;
	3147 [label="Pardon. C'est une triste façon d'être.",shape=box,color=red];
		3147 -> 3150;
	3148 [label="Usurpateur, c'est le Directeur lui-même qui a apporté une bouteille de Kuva et un des jeunes serviteurs lorsque les choses ont dégénéré avec un des nouveaux initiés un soir.",shape=box,color=blue];
		3148 -> 3151;
	3149 [label="La tradition est un outil puissant, Usurpateur. Un outil puissant et dangereux qui peut servir à enfermer bien des hommes sains d'esprit dans des modes de pensée insensés.",shape=box,color=blue];
		3149 -> 3152;
	3150 [label="Tout au contraire. Du fait de mon absence d'attaches familiales, j'avais davantage de temps à consacrer aux stratégies militaristes qui paraissaient archaïques et dépassées par mes pairs. ",shape=box,color=blue];
		3150 -> 3153;
	3151 [label="La tradition est un outil puissant. Un outil puissant et dangereux qui peut servir à enfermer bien des hommes sains d'esprit dans des modes de pensée insensés.",shape=box,color=blue];
		3151 -> 3154;
		3151 -> 3155;
	3152 [label="C'est le Directeur lui-même qui a apporté une bouteille de Kuva et un des jeunes serviteurs lorsque les choses ont dégénéré avec un des nouveaux initiés un soir.",shape=box,color=blue];
		3152 -> 3154;
		3152 -> 3155;
	3153 [label="Ils étaient loin de se douter à quel point cela me serait utile par la suite.",shape=box,color=blue];
		3153 -> 3156;
		3153 -> 3157;
	3154 [label="Et tes parents?",shape=box,color=red];
		3154 -> 3143;
	3155 [label="Tu avais des amis là-bas?",shape=box,color=red];
		3155 -> 3158;
	3156 [label="Cela en valait-il la peine?",shape=box,color=red];
		3156 -> 3159;
	3157 [label="Il me semble pourtant que tu as mené une vie assez solitaire.",shape=box,color=red];
		3157 -> 3160;
	3158 [label="Non. Je restais à l'écart. J'ai appris que la peur est facile à susciter et à manipuler chez les autres, mais que c'est une glace fragile et délicate qui fond au moindre contact avec la lumière.",shape=box,color=blue];
		3158 -> 3161;
	3159 [label="Mes camarades étaient loin de se douter à quel point ces études me seraient utiles par la suite. Mais tu te demandes en termes de bénéfices directs?",shape=box,color=blue];
		3159 -> 3162;
	3160 [label="Oui, je l'avoue. Mais c'est le lot de ceux qui mènent une vie de débauche, n'est-ce pas? Même alors, j'étais perçu soit comme une victime impuissante et le concubin, soit comme le seigneur de guerre sanguinaire et un monstre déchaîné.",shape=box,color=blue];
		3160 -> 3163;
	3161 [label="Les monstres doivent rester dans l'ombre. Et si je voulais conserver une aura de danger autour de moi, je devais rester seul.",shape=box,color=blue];
		3161 -> 3146;
		3161 -> 3147;
	3162 [label="Hum. Je ne sais pas.",shape=box,color=blue];
		3162 -> 3164;
		3162 -> 3165;
	3163 [label="Je n'ai jamais été le bienvenu ni parmi ceux qui étaient d'un rang supérieur au mien, ni parmi ceux de rang inférieur. Et je n'avais pratiquement aucun pair.",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="Tu as une autre chance de réparer tes erreurs. Eux, non. ",shape=box,color=red];
		3164 -> 3167;
	3165 [label="Eh bien, ils sont morts et pas toi. Alors, j'imagine que ça compte comme une victoire.",shape=box,color=red];
		3165 -> 3168;
	3166 [label="Update boolean RoatheUnloved2",color=orange];
		3166 -> 3169;
		3166 -> 3170;
	3167 [label="Add 1 to Thermostat",color=orange];
		3167 -> 3171;
	3168 [label="Add -1 to Thermostat",color=orange];
		3168 -> 3171;
	3169 [label="Tu as une autre chance de réparer tes erreurs. Eux, non.",shape=box,color=red];
		3169 -> 3172;
	3170 [label="Au moins, tu as tout l'avenir devant toi pour décider comment mener ta vie. Eux, non.",shape=box,color=red];
		3170 -> 3173;
	3171 [label="+5 Chemistry",color=orange];
		3171 -> 3174;
	3172 [label="Add 1 to Thermostat",color=orange];
		3172 -> 3171;
	3173 [label="Add -1 to Thermostat",color=orange];
		3173 -> 3171;
	3174 [label="On verra bien. N'est-ce pas?",shape=box,color=blue];
		3174 -> 3175;
	3175 [label="Chat ends.",color=orange];
}