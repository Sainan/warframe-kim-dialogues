	j2893523983 [label="Et ne te donne pas la peine d'importuner les fanatiques en espérant qu'ils vont me convaincre de te faire grâce. Cela ne fonctionnera pas.",shape=box,color=blue];
		j2893523983 -> "Chat ends.";
