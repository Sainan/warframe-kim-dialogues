		j1970788413 -> j338572888;
		j1970788413 -> j3606821564;
	j3936741680 [label="Ce serait malvenu de ne pas reconnaître que cela est dû en grande partie à ton aide, Usurpateur.",shape=box,color=blue];
		j3936741680 -> j3510345494;
		j3936741680 -> j1155269343;
	j2692935391 [label="Mm. Très bien. Je suis patient comme pas deux, mais crois-moi, cette source peut finir par s'épuiser.",shape=box,color=blue];
		j2692935391 -> "Chat ends.";
	j244916927 [label="Je vois. C'est aussi simple que ça, n'est-ce pas?",shape=box,color=blue];
		j244916927 -> j431793363;
	j1337468995 [label="Mm. Veilles-y. Je suis patient comme pas deux, mais crois-moi, cette source peut finir par s'épuiser.",shape=box,color=blue];
		j1337468995 -> "Chat ends.";
	j2204848593 [label="Même si cela signifie que nous resterons à jamais prisonniers de cette impasse? Pauvre usurpateur… soit. Le purgatoire est un moindre mal pour un diable, n'est-ce pas?",shape=box,color=blue];
		j2204848593 -> j3400495809;
	j222944588 [label="Bien. Au travail. J'en ai marre de vivre avec ça en tête.",shape=box,color=blue];
		j222944588 -> j378811769;
	j2349834731 [label="Mais qu'est-ce que ça peut te faire? Mon cadavre vide est à ta disposition. Mes côtes sont nues et blanchies.",shape=box,color=blue];
		j2349834731 -> j1776100240;
	j2501061531 [label="Tragique, n'est-ce pas? Savoir que la lie de la famille Entrati ne saura jamais que le majordome se décompose ici-bas, se tordant les mains de chagrin? Tout seul?",shape=box,color=blue];
		j2501061531 -> j1776100240;
	j1027561249 [label="C'est la seule solution si tu veux avancer. Si ça t'est égal, ça m'est égal aussi. Fais ce que tu veux.",shape=box,color=blue];
		j1027561249 -> j2893523983;
	j4115521805 [label="Débarrasse-moi de ça. Débarrasse-moi de ce fléau. Efface ces souvenirs de mon esprit. Je sais que tu en es capable. Utilise ce don que tu possèdes et mets fin à tout cela. Maintenant.",shape=box,color=blue];
		j4115521805 -> j1086051174;
		j4115521805 -> j3730862158;
		j4115521805 -> j3797055110;
