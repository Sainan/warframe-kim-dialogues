	j567952179 [label="Boolean RoatheWillReset is now true.",color=orange];
		j567952179 -> j2989953447;
	j1095996358 [label="Tu peux également dire adieu à notre autre contrat.",shape=box,color=blue];
		j1095996358 -> j585807614;
		j1095996358 -> j2169914179;
	j1732912296 [label="J'avais hâte de le voir trembler de terreur et de honte en gravissant ces escaliers.",shape=box,color=blue];
		j1732912296 -> j2424132098;
		j1732912296 -> j1146250288;
	j3169019017 [label="Mais qu'est-ce que ça peut bien te faire?",shape=box,color=blue];
		j3169019017 -> j3875907638;
	j1946311795 [label="C'est possible. Tu as sans doute raison. Mais je n'ai pas d'autre choix, n'est-ce pas? Ça vaut le coup d'essayer.",shape=box,color=blue];
		j1946311795 -> j4154341339;
	j487881167 [label="Et si tel est le cas, tu peux tout simplement recommencer. C'est comme si tu possédais un don sans fin, non?",shape=box,color=blue];
		j487881167 -> j4154341339;
	j3343960256 [label="Très probablement. Je vais en déduire que tu as fait quelque chose que je ne t'avais pas demandé et t'en juger coupable. Je suis sûr que tu surmonteras cette épreuve.",shape=box,color=blue];
		j3343960256 -> j4154341339;
	j3216040292 [label="Mm, oui, enfin. Je sais combien tu apprécies ma \"queue pointue\". ",shape=box,color=blue];
		j3216040292 -> j2665556245;
	j4088277342 [label="Je souhaitais simplement exprimer ma gratitude. Sans m'y attarder.",shape=box,color=blue];
		j4088277342 -> j4081414586;
	j1487509060 [label="Maintenant que c'est fait, je crois que nous avons autre chose à discuter, n'est-ce pas?",shape=box,color=blue];
		j1487509060 -> j1466456391;
	j1311246052 [label="Check boolean RoatheDating",color=orange];
		j1311246052 -> j2648057934 [label=true,color=green];
		j1311246052 -> j47328154 [label=false,color=brown];
	j2989953447 [label="Boolean RoatheFailStall is now false.",color=orange];
		j2989953447 -> "Chat ends.";
	j585807614 [label="Typique.",shape=box,color=red];
		j585807614 -> j3794968685;
	j2169914179 [label="Attends. Quoi?!",shape=box,color=red];
		j2169914179 -> j4198524217;
	j2424132098 [label="Tu as dit que tu m'aiderais si je t'aidais à retrouver la mémoire. Et je l'ai fait. C'était notre contrat!",shape=box,color=red];
		j2424132098 -> j3338331896;
	j1146250288 [label="Attends. Pourquoi ne veux-tu pas m'aider?",shape=box,color=red];
		j1146250288 -> j3338331896;
	j3875907638 [label="Rien du tout.",shape=box,color=blue];
		j3875907638 -> "Chat ends.";
	j4154341339 [label="Je sais que je serai furieux contre toi quand je réaliserai que tu as altéré mes souvenirs, bien sûr. Et je te conseille de ne surtout pas me dire que c'était à ma demande, mon amour.",shape=box,color=blue];
		j4154341339 -> j498894246;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j1466456391 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1466456391 -> j139443342 [label=true,color=green];
		j1466456391 -> j3421938588 [label=false,color=brown];
	j2648057934 [label="Boolean IsDating is now false.",color=orange];
		j2648057934 -> j192239519;
	j3794968685 [label="Ne sois pas si amer simplement parce que tu réalises maintenant que tu viens de te faire rouler dans la farine. Je t'ai proposé les termes du contrat sans jamais détailler mes propres conditions. Ou bien n'as-tu pas compris?",shape=box,color=blue];
		j3794968685 -> j3086165596;
	j4198524217 [label="Je t'ai proposé les termes du contrat sans jamais préciser mes propres conditions. Tu ne l'avais pas remarqué?",shape=box,color=blue];
		j4198524217 -> j3086165596;
	j3338331896 [label="\"J'aurais besoin de quelqu'un pour m'aider à consigner mes souvenirs et à les harmoniser. Une sorte d'assistant temporaire.\"",shape=box,color=blue];
		j3338331896 -> j210883023;
	j498894246 [label="Je dirai simplement que tu mens et cela risque fort de nuire irrémédiablement à l'opinion que j'ai de toi.",shape=box,color=blue];
		j498894246 -> j3314293295;
		j498894246 -> j915591807;
	j139443342 [label="À chaque fois que nous parlons, je ne peux m'empêcher de me demander si les rivages que nous foulons te sont familiers ou étrangers. Si je ne fais que me répéter, ou si je te réserve une nouvelle surprise.",shape=box,color=blue];
		j139443342 -> j1641056106;
	j3421938588 [label="Tu as respecté ta part du marché. Nous en sommes maintenant à l'avant-dernière étape: définir précisément les modalités de notre stratégie d'attaque.",shape=box,color=blue];
		j3421938588 -> j1763097088;
	j192239519 [label="Boolean RoatheDating is now false.",color=orange];
		j192239519 -> j2484678488;
	j3086165596 [label="Je t'ai simplement indiqué ce que tu obtiendrais de cet accord. Je ne t'ai jamais dit ce que tu devais faire, ni pourquoi, pour y arriver. Et tu as accepté sans réfléchir.",shape=box,color=blue];
		j3086165596 -> j3728309322;
	j210883023 [label="Si tu as rempli le premier critère, \"consigner mes souvenirs\", tu as lamentablement échoué pour ce qui est du second, \"m’aider à les harmoniser\".",shape=box,color=blue];
		j210883023 -> j2261187360;
	j3314293295 [label="Non. Je ne peux pas faire ça et je ne le ferai pas. On doit faire face ensemble à cette situation. Est-ce qu'on peut en parler tout simplement?",shape=box,color=red];
		j3314293295 -> j2452979486;
	j915591807 [label="Je... il n'y a vraiment pas d'autre solution?",shape=box,color=red];
		j915591807 -> j2452979486;
	j1641056106 [label="De toute façon, je préférerais que tu ne me le dises pas. Je déteste être trop prévisible. Quoi qu'il en soit, tu m'as aidé à résoudre un problème qui me tient particulièrement à cœur. ",shape=box,color=blue];
		j1641056106 -> j223830397;
	j1763097088 [label="Cette bataille doit être menée sur trois fronts. Tous doivent œuvrer de concert pour remporter cette guerre.",shape=box,color=blue];
		j1763097088 -> j3740473246;
		j1763097088 -> j775052436;
	j2484678488 [label="Eh bien, quoi que tu attendes de moi, tu ne l'auras pas maintenant. Autant en finir et effacer de ma mémoire toute cette mascarade, \"cher Voyageur\".",shape=box,color=blue];
		j2484678488 -> j1027561249;
	j3728309322 [label="C'est ce qu'on appelait autrefois un \"chèque en blanc\", je crois? Et tu l'as signé de ton plein gré.",shape=box,color=blue];
		j3728309322 -> j2482964260;
		j3728309322 -> j726069736;
	j2261187360 [label="Je ne dirais pas qu'ils sont harmonisés et toi?",shape=box,color=blue];
		j2261187360 -> j2299101597;
	j2452979486 [label="Non. Si tu veux que le majordome monte les escaliers? Efface tout ça, comme je l’ai demandé. Si cela t'est égal, fais comme bon te semble. Peu m'importe.",shape=box,color=blue];
		j2452979486 -> j3515383696;
	j223830397 [label="J'ai mieux dormi la nuit dernière que depuis très longtemps. Je dirais même \"je ne me souviens pas avoir jamais si bien dormi\", mais ce serait une plaisanterie de très mauvais goût.",shape=box,color=blue];
		j223830397 -> j1711690719;
	j3740473246 [label="Pardon?",shape=box,color=red];
		j3740473246 -> j2615723671;
	j775052436 [label="On parle de Loid?",shape=box,color=red];
		j775052436 -> j570019891;
	j2482964260 [label="Y a-t-il un moyen de te faire changer d'avis?",shape=box,color=red];
		j2482964260 -> j3980188776;
	j726069736 [label="Comment puis-je me sortir de là?",shape=box,color=red];
		j726069736 -> j2251582566;
	j2299101597 [label="Tu n'as pas respecté ta part du marché, donc je ne respecterai pas la mienne.",shape=box,color=blue];
		j2299101597 -> j2482964260;
		j2299101597 -> j719265559;
	j3515383696 [label="Cela et bien sûr, notre amitié personnelle sont les seuls moyens de pression dont je dispose dans cette situation. C'est aussi simple que cela.",shape=box,color=blue];
		j3515383696 -> j2050455090;
