		j2304643196 -> j1805349174 [label="false",color=purple];
	j4255531857 [label="Et nous voilà à nous tourner les pouces. Soit tu n'as vraiment rien de mieux à faire, Usurpateur, soit tu as obtenu tout ce que tu voulais de moi. Alors, qu'en est-il?",shape=box,color=blue];
		j4255531857 -> j371304943;
		j4255531857 -> j1125291846;
		j4255531857 -> j3529638550;
	j617454213 [label="Evaluate expressions on HellStory counter",color=orange];
		j617454213 -> j2831773034 [label="x >= 21",color=purple];
		j617454213 -> "Chat ends." [label="x <= 21",color=purple];
		j617454213 -> "Chat ends." [label="false",color=purple];
	j1407254219 [label="Un nouveau jour se lève et pour la première fois depuis longtemps, je me surprends à envisager l'avenir. Je réfléchis à la manière dont je pourrais transformer le monde qui m'entoure, à la façon dont je pourrais mettre à profit mes connaissances, ce que je suis et comment en faire un meilleur usage.",shape=box,color=blue];
		j1407254219 -> j3984658869;
	j2556072051 [label="Un nouveau jour se lève et pour la première fois depuis… longtemps, je me surprends à planifier l’avenir. Je réfléchis à ce que cela signifie pour moi, à ce que je désire, à la manière dont je souhaite façonner mon environnement à ma guise.",shape=box,color=blue];
		j2556072051 -> j2558396776;
	j245092048 [label="Puis-je te demander précisément ce que tu attends? Je me souviens parfaitement des événements. Tu m’as donné ta parole que tu les effacerais de ma mémoire.",shape=box,color=blue];
		j245092048 -> j2572015372;
		j245092048 -> j3979147261;
		j245092048 -> j924955856;
	j290694450 [label="As-tu enfin pris ta décision? Je suis patient, certes, mais j’ai mes limites. Vas-tu effacer ces souvenirs de ma mémoire, ou préfères-tu les y laisser?",shape=box,color=blue];
		j290694450 -> j3670748953;
		j290694450 -> j2553505312;
	j1805349174 [label="Nous y sommes et nous y resterons. Dans ce purgatoire. J'espère que tu y trouveras ton compte, car je ne pense pas que nous irons jamais plus loin.",shape=box,color=blue];
		j1805349174 -> j2171950327;
	j371304943 [label="Que veux-tu dire?",shape=box,color=red];
		j371304943 -> j2868924750;
	j1125291846 [label="Un peu des deux?",shape=box,color=red];
		j1125291846 -> j47328154;
	j3529638550 [label="Rien de cela ne te concerne, Roathe. Ça n'a jamais été le cas.",shape=box,color=red];
		j3529638550 -> j1782343296;
	j2831773034 [label="Imbécile! Qu'as-tu fait?! Pourquoi, pourquoi s'aventurer dans des cavernes où ta présence n'est pas souhaitée?!",shape=box,color=blue];
		j2831773034 -> j1402578252;
	"Chat ends." [color=orange];
	j3984658869 [label="Check boolean RoatheDating",color=orange];
		j3984658869 -> j2449178538 [label=true,color=green];
		j3984658869 -> j3864199070 [label=false,color=brown];
	j2558396776 [label="Check boolean RoatheDating",color=orange];
		j2558396776 -> j1970788413 [label=true,color=green];
		j2558396776 -> j3936741680 [label=false,color=brown];
	j2572015372 [label="Je sais. Mais ces choses prennent du temps et nous devons attendre.",shape=box,color=red];
		j2572015372 -> j2692935391;
	j3979147261 [label="J'ai changé d'avis. Je regrette.",shape=box,color=red];
		j3979147261 -> j244916927;
	j924955856 [label="Je le ferai. Je vais y arriver. Je te le promets.",shape=box,color=red];
		j924955856 -> j1337468995;
	j3670748953 [label="Non. Je ne peux pas faire ça. Je regrette. Je ne peux pas te faire ça.",shape=box,color=red];
		j3670748953 -> j2204848593;
	j2553505312 [label="Très bien. Je cède. Je ferai ce que tu veux.",shape=box,color=red];
		j2553505312 -> j222944588;
	j2171950327 [label="Check boolean LoidFamilyComplete",color=orange];
		j2171950327 -> j2349834731 [label=true,color=green];
		j2171950327 -> j2501061531 [label=false,color=brown];
	j2868924750 [label="Quoi que tu attendes de moi, tu ne l'auras pas maintenant. Autant en finir et effacer de ma mémoire toute cette mascarade.",shape=box,color=blue];
		j2868924750 -> j1027561249;
	j47328154 [label="Eh bien, quoi que tu attendes de moi, tu ne l'auras pas maintenant. Autant en finir et effacer de ma mémoire toute cette mascarade.",shape=box,color=blue];
		j47328154 -> j1027561249;
	j1782343296 [label="C'est tout à fait clair, tu n'as pas à t'inquiéter.",shape=box,color=blue];
		j1782343296 -> "Chat ends.";
	j1402578252 [label="Je t'ordonne de régler ce problème. C'est ta faute. Je le sens, ça me griffe, ça me déchire. Comme une bête féroce.",shape=box,color=blue];
		j1402578252 -> j4115521805;
	j2449178538 [label="Ce serait malvenu de ne pas reconnaître que cela est dû à ton aide, mon amour. Merci.",shape=box,color=blue];
		j2449178538 -> j1461269462;
		j2449178538 -> j747693235;
	j3864199070 [label="Ce serait malvenu de ne pas reconnaître que cela est dû à ton aide, Usurpateur. Merci.",shape=box,color=blue];
