digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank3Convo5 begins." [color=orange];
		"RoatheRank3Convo5 begins." -> j1076603839;
	j1076603839 [label="Albrecht a toujours été un problème, dès le début. Lui et toute cette histoire avec le Néant. Je pense qu'on lui a donné Gerivaine dans l'espoir qu'une famille puisse l'apaiser.",shape=box,color=blue];
		j1076603839 -> j2390876261;
	j2390876261 [label="Je pense au contraire que cela n'a fait qu'empirer les choses. Une fois qu'il a eu des enfants, il les considérait comme une aide supplémentaire, des complices de ses expériences insensées.",shape=box,color=blue];
		j2390876261 -> j3124868021;
	j3124868021 [label="Sacrifiables. Comme tout dans sa vie.",shape=box,color=blue];
		j3124868021 -> j3774743628;
		j3124868021 -> j3975711406;
		j3124868021 -> j2429168889;
	j3774743628 [label="Gerivaine?",shape=box,color=red];
		j3774743628 -> j4015980775;
	j3975711406 [label="Il considère les gens comme bien plus que de simples êtres sacrifiables.",shape=box,color=red];
		j3975711406 -> j3561786535;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j4015980775 [label="Un nom peut-être tombé dans l'oubli… L'épouse d'Albrecht Entrati, Usurpateur. La mère de ses enfants.",shape=box,color=blue];
		j4015980775 -> j4103666644;
	j3561786535 [label="Très bien, j'admets qu'il tuera quiconque ou quoi que ce soit sur son passage avec la froideur d'un Exécuteur. Mais il ne le fera pas sans raison.",shape=box,color=blue];
		j3561786535 -> j4212144720;
	"Chat ends." [color=orange];
	j4103666644 [label="Check boolean LoidFamilyComplete",color=orange];
		j4103666644 -> j3084132295 [label=true,color=green];
		j4103666644 -> j353649393 [label=false,color=brown];
	j4212144720 [label="Tu sais, maintenant que j'y pense, c'est son détachement qui le rendait si dangereux à notre époque. Il était capable de tout sacrifier pour atteindre ses objectifs. Absolument tout.",shape=box,color=blue];
		j4212144720 -> j1452946533;
		j4212144720 -> j1739485058;
	j3084132295 [label="Mais voilà, tu te joues encore de moi, probablement, car il y a de fortes chances que tu connaisses déjà cette information, maintenant que le majordome est de nouveau en contact avec eux.",shape=box,color=blue];
		j3084132295 -> j2000610360;
	j353649393 [label="Ceux qui, dans ce Sanctum en ruine, ignorent si paisiblement notre existence. Ce que je trouve toujours aussi comique.",shape=box,color=blue];
		j353649393 -> j4212144720;
	j1452946533 [label="Je pensais que les Orokins n'hésitaient pas à sacrifier ce qui leur était cher. Vous sembliez tous extrêmement impitoyables les uns envers les autres.",shape=box,color=red];
		j1452946533 -> j1845412555;
	j1739485058 [label="Comment le sais-tu?",shape=box,color=red];
		j1739485058 -> j516169760;
	j2000610360 [label="Mais je ne vais pas me lancer dans une autre dispute à ce sujet avec toi. Je n'en ai pas envie.",shape=box,color=blue];
		j2000610360 -> j4212144720;
	j1845412555 [label="Tu vas vite pour supposer beaucoup de choses alors que tu ne sais rien, Voyageur.",shape=box,color=blue];
		j1845412555 -> j1036390848;
	j516169760 [label="+10 Chemistry",color=orange];
		j516169760 -> j98171296;
	j1036390848 [label="Ou bien ta peau présente-t-elle une légère teinte bleutée que je n'aurais pas remarquée? Étais-tu Orokin? Si tel est le cas, je te présente mes excuses les plus profondes et les plus sincères! ",shape=box,color=blue];
		j1036390848 -> j2156268949;
		j1036390848 -> j1523785738;
	j98171296 [label="On pourrait croire, à tort, que nous Orokins, ne faisions que nous poignarder dans le dos et nous entretuer. Certes, cela arrivait souvent, ne te méprends pas. Nous étions quasiment immortels, nous n'avions guère d'autres choses à faire.",shape=box,color=blue];
		j98171296 -> j1240272442;
	j2156268949 [label="Pardon. Je ne voulais pas t'offenser. Honnêtement, je ne me souviens pas de grand-chose de la société Orokin moi-même; j’étais à l’extérieur, je l’observais.",shape=box,color=red];
		j2156268949 -> j2160750149;
	j1523785738 [label="Je m'excuse si mes souvenirs de la société Orokin ne sont pas parfaits. Il s'agissait surtout de déclarations enregistrées, d'ordres hurlés par des haut-parleurs. C'était avant que je ne me retrouve dans le Néant…",shape=box,color=red];
		j1523785738 -> j3953335948;
	j1240272442 [label="Mais nous étions aussi un peuple profondément passionné. Personne ne créait d'art comme les Orokins. Personne ne composait de musique, de théâtre ou de poésie comme nous.",shape=box,color=blue];
		j1240272442 -> j2680986053;
	j2160750149 [label="Excuses acceptées. Pour cette fois. J'en ai assez de ce genre d'irrespect de la part des autres. Même si tu me fascines, je ne suis pas ton objet de curiosité. J'ai mieux à faire de mon temps.",shape=box,color=blue];
		j2160750149 -> j3237881926;
	j3953335948 [label="Boolean RoatheInsulted is now true.",color=orange];
		j3953335948 -> j1221551366;
	j2680986053 [label="Et personne n'a jamais aimé aussi profondément que nous, lorsque nos cœurs sont épris d'une autre personne.",shape=box,color=blue];
		j2680986053 -> j2491135958;
	j3237881926 [label="Où en étais-je? Ah oui. Notre impassible Entrati.",shape=box,color=blue];
		j3237881926 -> j98171296;
	j1221551366 [label="Un avertissement. J'en ai assez de ce genre d'irrespect de la part des autres. Même si tu me fascines, je ne suis pas ton objet de curiosité. J'ai mieux à faire de mon temps.",shape=box,color=blue];
		j1221551366 -> j3237881926;
	j2491135958 [label="Tous, sauf Albrecht. Tout ce qu'il faisait, chaque personne avec qui il interagissait, c'était comme s'il la regardait à travers un fragment de son précieux vitrail.",shape=box,color=blue];
		j2491135958 -> j117157745;
	j117157745 [label="Distant. Indifférent. Désintéressé. Insensible. Même après la mort de Gerivaine, lorsqu'il s'est retrouvé seul à élever sa fille.",shape=box,color=blue];
		j117157745 -> j1969269467;
	j1969269467 [label="Check boolean LoidFamilyComplete",color=orange];
		j1969269467 -> j1392546521 [label=true,color=green];
		j1969269467 -> j625001242 [label=false,color=brown];
	j1392546521 [label="Qui, en toute logique, aurait sans doute accompli bien plus que lui. Si seulement elle n'avait pas fini par être Infestée et enracinée sur place. Quel dommage.",shape=box,color=blue];
		j1392546521 -> j3388461959;
		j1392546521 -> j2391583594;
	j625001242 [label="Qui, en toute logique, aurait sans doute été destinée à accomplir bien plus qu'il ne l'a jamais fait. J'ai hâte de voir ce qu'il est advenu d'elle et des autres membres de sa famille. Dans toute leur... gloire Infestée.",shape=box,color=blue];
		j625001242 -> j2536749360;
		j625001242 -> j518207253;
	j3388461959 [label="C'est heureux que nous ayons réussi à convaincre Loid de monter à l'étage.",shape=box,color=red];
		j3388461959 -> j1998181815;
	j2391583594 [label="Je sais que tu ne te souviens plus pourquoi on a fait ça, mais c'était une bonne chose qu'on ait réussi à faire monter Loid à l'étage.",shape=box,color=red];
		j2391583594 -> j979019691;
	j2536749360 [label="Je me demande encore si c'est une bonne idée...",shape=box,color=red];
		j2536749360 -> j577126628;
	j518207253 [label="Si nous parvenons à convaincre Loid de monter à l'étage, que comptes-tu faire ensuite?",shape=box,color=red];
		j518207253 -> j4247118996;
	j1998181815 [label="C'est ce que tu dis. Et pourtant, je reste là comme un idiot, à les surveiller, à les écouter parler des retrouvailles comme si je m'en souvenais. Tu imagines à quel point c'est gênant?!",shape=box,color=blue];
		j1998181815 -> j2741976273;
	j979019691 [label="Tu imagines à quel point c'est gênant de devoir rester là et faire semblant de me souvenir de ces retrouvailles?! Alors que je suis absolument incapable de me rappeler de quoi que ce soit?!",shape=box,color=blue];
		j979019691 -> j2741976273;
	j577126628 [label="Hum, probablement pas. Par curiosité, aurais-tu par hasard la nouvelle adresse d'Albrecht?",shape=box,color=blue];
		j577126628 -> j2330420905;
	j4247118996 [label="Je n'ai pas encore pris de décision. Peut-être commencerai-je par leur couper les membres et les conserver dans du liquide. Par hasard, tu n'aurais pas la nouvelle adresse d'Albrecht?",shape=box,color=blue];
		j4247118996 -> j3579614083;
	j2741976273 [label="C'est comme se trouver à un gala lorsqu'une personne s'approche de toi et sait manifestement qui tu es, alors que tu n'as absolument aucun souvenir d'elle, mais que tu dois poursuivre la conversation comme si de rien n'était!",shape=box,color=blue];
		j2741976273 -> j2217210965;
	j2330420905 [label="Non, pourquoi?",shape=box,color=red];
		j2330420905 -> j389095015;
	j3579614083 [label="Quoi?!",shape=box,color=red];
		j3579614083 -> j1866977585;
	j2217210965 [label="Te rends-tu compte, ne serait-ce qu'un peu, de l'enfer que tu me fais vivre?! Un tout petit peu?! C'est une véritable souffrance et c'est entièrement de ta faute! ",shape=box,color=blue];
		j2217210965 -> j899890809;
	j389095015 [label="Je me disais qu'une fois en haut, je commencerais à couper les membres de sa famille et à les lui envoyer par la poste dans des bocaux, un par un.",shape=box,color=blue];
		j389095015 -> j3579614083;
	j1866977585 [label="+10 Chemistry",color=orange];
		j1866977585 -> j27713776;
	j899890809 [label="Bon, ça suffit. J'ai besoin d'un verre.",shape=box,color=blue];
		j899890809 -> j1933300832;
	j27713776 [label="Du calme! Personne ici n'a d'humour?",shape=box,color=blue];
		j27713776 -> j2258104338;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j2258104338 [label="Et sinon, pour l'adresse?",shape=box,color=blue];
		j2258104338 -> "Chat ends.";
}