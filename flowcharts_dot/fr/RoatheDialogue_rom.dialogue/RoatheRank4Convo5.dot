digraph {
	2664 [label="RoatheRank4Convo5 begins.",color=orange];
		2664 -> 2665;
	2665 [label="De quoi te souviens-tu de ton séjour dans l'Empire, Usurpateur? Mes souvenirs sont pour le moins fragmentaires. Mais je ne suis pas en position de juger.",shape=box,color=blue];
		2665 -> 2668;
		2665 -> 2666;
		2665 -> 2667;
		2665 -> 2669;
	2668 [label="Assez pour savoir que vous méritiez tous de brûler.",shape=box,color=red];
		2668 -> 2671;
	2666 [label="Quelques bribes. Pourquoi?",shape=box,color=red];
		2666 -> 2670;
	2667 [label="J'étais assez jeune quand on nous a embarqués à bord du Zariman. Et après ça... eh bien.",shape=box,color=red];
		2667 -> 2670;
	2669 [label="[Fin.]",shape=box,color=red];
		2669 -> 2672;
	2671 [label="C'est tout à fait juste. Cependant, tu ignores des pans entiers de notre histoire et de notre patrimoine culturel. Je sais que nous avons été peu appréciés après la chute, mais…",shape=box,color=blue];
		2671 -> 2674;
	2670 [label="Hum. Je trouve étrange qu'il existe si peu de documents complets sur notre société et notre culture. Je sais que nous avons été peu appréciés après la chute, mais…",shape=box,color=blue];
		2670 -> 2673;
	2672 [label="Chat ends.",color=orange];
	2674 [label="Pas même un mot sur ce qui est arrivé aux Cryoleums?",shape=box,color=blue];
		2674 -> 2677;
		2674 -> 2678;
	2673 [label="Pas même un mot sur ce qui est arrivé aux Cryoleums?",shape=box,color=blue];
		2673 -> 2675;
		2673 -> 2676;
	2677 [label="Est-ce que c'est une terrible forme de torture Orokin?",shape=box,color=red];
		2677 -> 2680;
	2678 [label="J'ai l'impression que je me souviendrais de ce mot si je l'avais déjà entendu.",shape=box,color=red];
		2678 -> 2681;
	2675 [label="Les... quoi?",shape=box,color=red];
		2675 -> 2679;
	2676 [label="J'ai l'impression que je me souviendrais de ce mot si je l'avais déjà entendu.",shape=box,color=red];
		2676 -> 2679;
	2680 [label="Étonnamment... Non. Peut-être est-ce parce que j'ai passé... bien trop d'années ces derniers temps enfermé dans une crypte avec ces deux fanatiques, mais je suis choqué qu'aucun document sur la façon dont les Orokins traitaient leurs morts n'ait survécu à travers les millénaires.",shape=box,color=blue];
		2680 -> 2684;
		2680 -> 2685;
	2681 [label="Peut-être est-ce parce que j'ai passé... bien trop d'années ces derniers temps enfermé dans une crypte avec ces deux fanatiques, mais je suis choqué qu'aucun document sur la façon dont les Orokins traitaient leurs morts n'ait survécu à travers les millénaires.",shape=box,color=blue];
		2681 -> 2686;
		2681 -> 2687;
	2679 [label="Peut-être est-ce parce que j'ai passé... bien trop d'années ces derniers temps enfermé dans une crypte avec ces deux fanatiques, mais je suis choqué qu'aucun document sur la façon dont les Orokins traitaient leurs morts n'ait survécu à travers les millénaires.",shape=box,color=blue];
		2679 -> 2682;
		2679 -> 2683;
	2684 [label="Je ne savais pas que tu étais mort. Tu ne faisais que voler de nouveaux corps au théâtre Yuvan.",shape=box,color=red];
		2684 -> 2690;
	2685 [label="Je croyais que vous aviez volé des humains pour résoudre ce problème. Vous n'avez fait que vous moquer de la mort.",shape=box,color=red];
		2685 -> 2691;
	2686 [label="Je ne savais pas que tu étais mort. Tu ne faisais que voler de nouveaux corps au théâtre Yuvan.",shape=box,color=red];
		2686 -> 2692;
	2687 [label="Continue.",shape=box,color=red];
		2687 -> 2693;
	2682 [label="Je ne savais pas que tu étais mort. Tu ne faisais que voler de nouveaux corps au théâtre Yuvan.",shape=box,color=red];
		2682 -> 2688;
	2683 [label="Continue.",shape=box,color=red];
		2683 -> 2689;
	2690 [label="Oui, mais qu'en est-il de tous les autres, ceux qui étaient \"proches\" mais \"pas tout à fait assez importants\"? Les Archimédiens? Ou les Orokins de rang inférieur? Il y a toujours eu des hiérarchies imbriquées. Même si les plafonds étaient de verre, ils existaient. Crois-moi.",shape=box,color=blue];
		2690 -> 2695;
	2691 [label="En effet. À chaque occasion. Mais tous n'ont pas été sauvés, n'est-ce pas? Qu'en est-il de ceux qui étaient \"proches\", mais \"pas assez importants\"? Les Archimédiens? Les Orokins de rang inférieur?",shape=box,color=blue];
		2691 -> 2696;
	2692 [label="Oui, mais qu'en est-il de tous les autres, ceux qui étaient \"proches\", mais \"pas tout à fait assez importants\"? Les Archimédiens? Ou les Orokins de rang inférieur? Il y a toujours eu des hiérarchies imbriquées. Même si les plafonds étaient de verre, ils existaient. Crois-moi.",shape=box,color=blue];
		2692 -> 2695;
	2693 [label="Pense à tous ceux qui étaient \"proches\", mais \"pas tout à fait assez importants\". Les Archimédiens. Les Orokins de rang inférieur. Il y a toujours eu des hiérarchies imbriquées. Même si les plafonds étaient de verre, ils existaient. Crois-moi.",shape=box,color=blue];
		2693 -> 2695;
	2688 [label="Oui, mais qu'en est-il de tous les autres, ceux qui étaient \"proches\" mais \"pas tout à fait assez importants\"? Les Archimédiens? Ou les Orokins de rang inférieur? Il y a toujours eu des hiérarchies imbriquées. Même si les plafonds étaient de verre, ils existaient. Crois-moi.",shape=box,color=blue];
		2688 -> 2694;
	2689 [label="Pense à tous ceux qui étaient \"proches\" mais \"pas tout à fait assez importants\". Les Archimédiens. Les Orokins de rang inférieur. Il y a toujours eu des hiérarchies imbriquées. Même si les plafonds étaient de verre, ils existaient. Crois-moi.",shape=box,color=blue];
		2689 -> 2694;
	2695 [label="Tous n'ont pas eu la chance de se voir offrir une chair nouvelle à chaque fois que leur ancienne forme se consumait. Mais je suis certain que tu considères le Théâtre Yuvan comme une pratique répugnante, n'est-ce pas?",shape=box,color=blue];
		2695 -> 2699;
		2695 -> 2700;
	2696 [label="Tous n'ont pas eu la chance de se voir offrir une chair nouvelle à chaque fois que leur ancienne forme se consumait. De toute évidence, tu considères le Théâtre Yuvan comme une pratique répugnante.",shape=box,color=blue];
		2696 -> 2701;
		2696 -> 2700;
	2694 [label="Tous n'ont pas eu la chance de se voir offrir une chair nouvelle à chaque fois que leur ancienne forme se consumait. Mais je suis certain que tu considères le Théâtre Yuvan comme une pratique répugnante, n'est-ce pas?",shape=box,color=blue];
		2694 -> 2697;
		2694 -> 2698;
	2699 [label="Je ne connais pas suffisamment cette pratique pour porter un jugement.",shape=box,color=red];
		2699 -> 2704;
	2700 [label="Oui. Je trouve répugnant ce que vous avez fait. Tout ce qui a été écrit sur le Théâtre Yuvan dit que vous avez volé des enfants et effacé leur mémoire.",shape=box,color=red];
		2700 -> 2705;
	2701 [label="Comment pourrait-il en être autrement? Vous avez enlevé des enfants de chez eux et effacé leur mémoire pour la remplacer par la vôtre!",shape=box,color=red];
		2701 -> 2706;
	2697 [label="Je ne connais pas suffisamment cette pratique pour porter un jugement.",shape=box,color=red];
		2697 -> 2702;
	2698 [label="Oui. Je trouve répugnant ce que vous avez fait. Tout ce qui a été écrit sur le Théâtre Yuvan dit que vous avez volé des enfants et effacé leur mémoire.",shape=box,color=red];
		2698 -> 2703;
	2704 [label="+5 Chemistry",color=orange];
		2704 -> 2709;
	2705 [label="\"Tout ce qui a été écrit sur le Théâtre Yuvan le dit.\" Où sont consignés tous ces écrits? Et surtout, qui les a rédigés?",shape=box,color=blue];
		2705 -> 2708;
	2706 [label="Et comment sais-tu tout cela? As-tu assisté toi-même à une cérémonie du Théâtre Yuvan?",shape=box,color=blue];
		2706 -> 2710;
		2706 -> 2711;
		2706 -> 2712;
	2702 [label="+5 Chemistry",color=orange];
		2702 -> 2707;
	2703 [label="Tu viens pourtant de dire qu'il ne reste que des fragments de notre histoire et de notre patrimoine culturel. Où sont consignés tous ces éléments? Et surtout, qui les a écrits?",shape=box,color=blue];
		2703 -> 2708;
	2709 [label="Tu attends d'avoir toutes les informations avant de porter un jugement? Mon Dieu, Usurpateur! Tu ne sembles pas manquer d'intelligence! Quelle rareté!",shape=box,color=blue];
		2709 -> 2713;
	2708 [label="Ce sont des récits racontés par ceux qui ont un intérêt particulier à présenter chaque aspect des Orokins sous un jour aussi désastreux et maléfique que possible.",shape=box,color=blue];
		2708 -> 2714;
	2710 [label="Non.",shape=box,color=red];
		2710 -> 2715;
	2711 [label="Oui.",shape=box,color=red];
		2711 -> 2716;
	2712 [label="Peu importe que j'y aie assisté ou pas, les faits sont clairs.",shape=box,color=red];
		2712 -> 2717;
	2707 [label="Tu attends d'avoir toutes les informations avant de porter un jugement? Mon Dieu, Usurpateur! Tu ne sembles pas manquer d'intelligence! Quelle rareté!",shape=box,color=blue];
		2707 -> 2713;
	2713 [label="Permets-moi donc de te proposer une autre perspective historique. Réfléchis à l'origine des récits concernant le Théâtre Yuvan que tu as pu entendre.",shape=box,color=blue];
		2713 -> 2708;
	2714 [label="Ceux qui détruisent toutes les structures de soutien de la société même du Système Origine et la plongent dans un chaos total doivent donner à ceux qui dépendent de cette société une bonne raison d'agir ainsi.",shape=box,color=blue];
		2714 -> 2718;
	2715 [label="Tu te bases donc sur des témoignages indirects. Réfléchis au lieu où ces récits ont été écrits. Plus important encore, renseigne-toi sur leurs auteurs.",shape=box,color=blue];
		2715 -> 2708;
	2716 [label="Ha! Mensonge.",shape=box,color=blue];
		2716 -> 2719;
	2717 [label="Vraiment? Examine où ces textes ont été rédigés. Plus important encore, demande-toi qui les a rédigés.",shape=box,color=blue];
		2717 -> 2708;
	2718 [label="Imagine la vie d'un humain ordinaire dans un relais, Usurpateur. Un humain loin des épreuves et des tribulations des Tennos. Un humain qui se fichait éperdument de la Grande Guerre.",shape=box,color=blue];
		2718 -> 2720;
	2719 [label="Tu te bases sur des témoignages indirects. Réfléchis au lieu où ces récits ont été écrits. Plus important encore, renseigne-toi sur leurs auteurs.",shape=box,color=blue];
		2719 -> 2708;
	2720 [label="Après la chute des Orokins, leur existence bascula dans un véritable enfer, plongés dans l'absence de pouvoir qui s'ensuivit. Il fallut inventer des explications. Il fallut fabriquer et brûler des effigies. Il fallut faire de nous les monstres de l'ombre.",shape=box,color=blue];
		2720 -> 2721;
		2720 -> 2722;
	2721 [label="Tu es en train de me dire que vous n'avez pas enlevé d'enfants contre leur gré pour le Théâtre Yuvan?",shape=box,color=red];
		2721 -> 2723;
	2722 [label="Alors, que s'est-il réellement passé au Théâtre Yuvan?",shape=box,color=red];
		2722 -> 2724;
	2723 [label="Non, c'est tout à fait exact.",shape=box,color=blue];
		2723 -> 2725;
	2724 [label="+5 Chemistry",color=orange];
		2724 -> 2726;
	2725 [label="Je veux simplement que tu tiennes compte de tes sources, c'est tout.",shape=box,color=blue];
		2725 -> 2727;
	2726 [label="Affirmer que nous n'avons pas sacrifié des gens contre leur gré est inexact. Nous l'avons fait. Mais ce n'est pas toute la vérité. Les choses sont rarement aussi simples et jamais aussi tranchées.",shape=box,color=blue];
		2726 -> 2728;
	2727 [label="Car ce n'est pas toute la vérité. Les choses sont rarement aussi simples, jamais aussi tranchées. Le monde est gris, Usurpateur. Les frontières ne se tracent pas si facilement. ",shape=box,color=blue];
		2727 -> 2729;
	2728 [label="Le monde est gris, Usurpateur. Les frontières ne se tracent pas si facilement.",shape=box,color=blue];
		2728 -> 2729;
	2729 [label="Cette pratique n'a pas débuté de façon aussi honteuse. Elle était perçue, au départ, comme le plus grand honneur: se sacrifier pour que l'Empire demeure inébranlable, sans faille, pour que notre œuvre puisse se poursuivre.",shape=box,color=blue];
		2729 -> 2730;
	2730 [label="Cela n'a pas commencé avec les jeunes. Cela a commencé avec ceux qui avaient simplement plus d'années à vivre. Mais ensuite, ceux qui se sont offerts sont devenus… de plus en plus jeunes. Le dévouement est une drogue puissante.",shape=box,color=blue];
		2730 -> 2731;
	2731 [label="J'ai observé un phénomène similaire chez ceux qui s'engageaient pour la guerre. Ils mentaient sur leur âge sur les documents officiels pour \"participer au juste combat\". Ils étaient loin de se douter qu'ils créaient un dangereux précédent pour ceux qui les rejoindraient malgré eux.",shape=box,color=blue];
		2731 -> 2732;
	2732 [label="À un moment donné, un Exécuteur a compris que cela pouvait servir de mesure punitive. Que certaines villes, voire des planètes entières, pouvaient être maintenues sous contrôle si la menace du Théâtre Yuvan était brandie. Si la collecte de sacrifices était utilisée avec une brutalité particulière.",shape=box,color=blue];
		2732 -> 2733;
		2732 -> 2734;
	2733 [label="Et toi, qu'est-ce que tu en penses?",shape=box,color=red];
		2733 -> 2735;
	2734 [label="As-tu déjà participé à un sacrifice involontaire?",shape=box,color=red];
		2734 -> 2736;
	2735 [label="+5 Chemistry",color=orange];
		2735 -> 2737;
	2736 [label="Je ne te mentirai pas. Je l'ai fait. Et tu peux me prendre pour un monstre si tu veux. Mais quand toute une société repose sur des siècles de normalisation d'une chose, il est très difficile de lui tourner le dos.",shape=box,color=blue];
		2736 -> 2738;
	2737 [label="Hum. C'est mitigé. D'un côté, j'ai moi-même fréquenté le Théâtre à de nombreuses reprises. Je serais d'une hypocrisie sans bornes si je le condamnais. Quand toute une société repose sur des siècles de normalisation d'une pratique, il est très difficile de la renier.",shape=box,color=blue];
		2737 -> 2739;
	2738 [label="Même avec le recul ou dans un moment de lucidité, c'est tellement évident.",shape=box,color=blue];
		2738 -> 2740;
	2739 [label="En revanche, prise isolément ou rétrospectivement, l'horreur de l'acte apparaît clairement.",shape=box,color=blue];
		2739 -> 2740;
	2740 [label="+5 Chemistry",color=orange];
		2740 -> 2741;
	2741 [label="Nul ne devrait vivre éternellement, Usurpateur. Et le Théâtre en est la preuve.",shape=box,color=blue];
		2741 -> 2742;
	2742 [label="Chat ends.",color=orange];
}