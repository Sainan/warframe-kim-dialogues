	"Chat ends." [color=orange];
	j3008714362 [label="MV: ADAPTATION",shape=box,color=blue];
		j3008714362 -> j2136626519;
	j2136626519 [label="Transcription: nombre de Sentients évoluaient entre les rencontres, si bien que nous ne pouvions jamais être certains d’affronter deux fois le même ennemi. Mais d’autres conservaient une forme constante, comme s’ils avaient atteint un palier depuis longtemps.",shape=box,color=blue];
		j2136626519 -> j1045449918;
	j1045449918 [label="Tueurs redoutables, ils inspiraient la même terreur glaciale que des requins.",shape=box,color=blue];
		j1045449918 -> j2985112867;
	j2985112867 [label="C'était de la folie. Comment aurais-je pu élaborer une stratégie face au comportement des vaisseaux Sentients, alors qu'à peine mes tactiques étaient-elles au point que ces vaisseaux-crabes étaient remplacés par des vaisseaux-vers?",shape=box,color=blue];
		j2985112867 -> j729667787;
	j729667787 [label="Et combien de temps avant que ces vaisseaux ne soient eux-mêmes remplacés par quelque nouvelle monstruosité?",shape=box,color=blue];
		j729667787 -> j2662946119;
	j2662946119 [label="Nous ne pouvions que régresser. Le progrès nous avait été fatal. Les vieilles traditions, les voies ancestrales de l’honneur et de la discipline méritaient leur place.",shape=box,color=blue];
		j2662946119 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}