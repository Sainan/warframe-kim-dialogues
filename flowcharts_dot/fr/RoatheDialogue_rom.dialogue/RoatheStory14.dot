		2257 -> 2259;
	2260 [label="Chat ends.",color=orange];
	2259 [label="Transcription: nombre de Sentients évoluaient entre les rencontres, si bien que nous ne pouvions jamais être certains d’affronter deux fois le même ennemi. Mais d’autres conservaient une forme constante, comme s’ils avaient atteint un palier depuis longtemps.",shape=box,color=blue];
		2259 -> 5709;
	5709 [label="Perfected killers, they brought the same cold horror that a shark does.",shape=box,color=blue];
		5709 -> 2256;
	2256 [label="C'était de la folie. Comment aurais-je pu élaborer une stratégie face au comportement des vaisseaux Sentients, alors qu'à peine mes tactiques étaient-elles au point que ces vaisseaux-crabes étaient remplacés par des vaisseaux-vers?",shape=box,color=blue];
		2256 -> 2253;
	2253 [label="Et combien de temps avant que ces vaisseaux ne soient eux-mêmes remplacés par quelque nouvelle monstruosité?",shape=box,color=blue];
		2253 -> 5710;
	5710 [label="All we could do was go backward. Progress had been fatal. Old traditions, time-hallowed paths of honor and discipline, were owed their due.",shape=box,color=blue];
		5710 -> 2255;
	2255 [label="Add 1 to HellStory",color=orange];
		2255 -> 2341;
