	2360 [label="Update boolean RoatheTraitor1",color=orange];
		2360 -> 2353;
		2360 -> 2366;
	2358 [label="Tu n'arrêtes pas de m'appeler \"Usurpateur\". Est-ce censé être une insulte?",shape=box,color=red];
		2358 -> 2364;
	2359 [label="[Fin.]",shape=box,color=red];
		2359 -> 2365;
	2361 [label="Update boolean RoatheUsurper",color=orange];
		2361 -> 2367;
	2362 [label="Je dis simplement que c'est un peu gonflé venant de toi, alors que tu es coupable de la même chose.",shape=box,color=red];
		2362 -> 2368;
	2363 [label="J'essaie juste de comprendre pourquoi tu continues à l'utiliser comme titre pour moi.",shape=box,color=red];
		2363 -> 2369;
	2366 [label="[Fin.]",shape=box,color=red];
		2366 -> 2371;
	2364 [label="Ha! À peine! Tu ne manques pas de patience si tu penses que je t'insulte tranquillement depuis des jours. ",shape=box,color=blue];
		2364 -> 2370;
	2365 [label="Chat ends.",color=orange];
	2367 [label="Eh bien, c'est ce que tu es, non? Les Tennos ont volé le Système Origine aux Orokins. Et toi, tel un petit imposteur dans son nid, tu as réussi à t'infiltrer dans ce monde loin du tien.",shape=box,color=blue];
		2367 -> 2372;
	2368 [label="Ha! Une insulte? Tu ne manques pas de patience si tu penses que je me fiche tranquillement de toi depuis des jours.",shape=box,color=blue];
		2368 -> 2373;
	2369 [label="+5 Chemistry",color=orange];
		2369 -> 2374;
	2371 [label="Chat ends.",color=orange];
	2370 [label="Check boolean RoatheKnowsReset2",color=orange];
		2370 -> 2375 [label=true,color=green];
		2370 -> 2376 [label=false,color=brown];
	2372 [label="Et cela fait de toi, à mes yeux, un usurpateur à au moins deux égards. (Et peut-être un troisième, si l'on tient compte de ce que le majordome m'a dit à propos de Duviri, mais c'est un débat pour une autre fois.)",shape=box,color=blue];
		2372 -> 2377;
		2372 -> 2378;
	2373 [label="Check boolean RoatheKnowsReset2",color=orange];
		2373 -> 2380 [label=true,color=green];
		2373 -> 2379 [label=false,color=brown];
	2374 [label="C'est précisément de cela qu'il s'agit: un titre. Une distinction honorifique. Tu as accompli ce à quoi j'aspirais. ",shape=box,color=blue];
		2374 -> 2381;
	2375 [label="Surtout quand il est si évident que tu as un pouvoir considérable dans cette situation qui est loin d'être unilatérale, n'est-ce pas?",shape=box,color=blue];
		2375 -> 2382;
	2376 [label="Surtout quand je sais que tu pourrais simplement utiliser tes pouvoirs du Néant pour traverser un mur et me loger quelques balles dans la nuque à tout moment.",shape=box,color=blue];
		2376 -> 2382;
	2377 [label="Donc... tu m'insultes.",shape=box,color=red];
		2377 -> 2368;
	2378 [label="D'accord. Alors pourquoi continuer à utiliser cela comme un titre?",shape=box,color=red];
		2378 -> 2383;
	2380 [label="Surtout quand il est si évident que tu as un pouvoir considérable dans cette situation qui est loin d'être unilatérale, n'est-ce pas?",shape=box,color=blue];
		2380 -> 2384;
	2379 [label="Surtout quand je sais que tu pourrais simplement utiliser tes pouvoirs du Néant pour traverser un mur et me loger quelques balles dans la nuque à tout moment.",shape=box,color=blue];
		2379 -> 2384;
	2381 [label="Ce titre n'est que l'expression d'une certaine admiration de ma part. Même s'il n'est pas dénué d'un sarcasme qui n'est pas pour me déplaire, je te l'accorde.",shape=box,color=blue];
		2381 -> 2385;
		2381 -> 2386;
		2381 -> 2387;
		2381 -> 2388;
	2382 [label="Je n'ai aucune envie que tu deviennes mon ennemi, Usurpateur. Non, ce n'est pas une insulte. C'est uniquement par manque de diligence de ta part que tu n'as pas réalisé à quel point une grande partie de mon passé est similaire au tien.",shape=box,color=blue];
		2382 -> 2389;
	2383 [label="+5 Chemistry",color=orange];
		2383 -> 2374;
	2384 [label="Je n'ai aucune envie que tu deviennes mon ennemi, Usurpateur. Non. C'est tout au plus un honneur. Tu as accompli ce à quoi j'aspirais. Rien de plus.",shape=box,color=blue];
		2384 -> 2381;
	2385 [label="Tous les Orokins étaient-ils comme toi?",shape=box,color=red];
		2385 -> 2390;
	2386 [label="Si je te demandais gentiment de m'appeler autrement, tu le ferais?",shape=box,color=red];
		2386 -> 2391;
	2387 [label="Je ferai avec.",shape=box,color=red];
		2387 -> 2392;
	2388 [label="Arrête de m'appeler Usurpateur.",shape=box,color=red];
		2388 -> 2393;
	2389 [label="J'étais déterminé à renverser les Orokins, tout comme ton double Tenno et ses semblables. J'ai simplement été arrêté avant d'avoir pu le faire.",shape=box,color=blue];
		2389 -> 2394;
	2390 [label="+10 Chemistry",color=orange];
