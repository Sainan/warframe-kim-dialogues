	j1681226875 [label="Tu n'arrêtes pas de m'appeler \"Usurpateur\". Est-ce censé être une insulte?",shape=box,color=red];
		j1681226875 -> j888437827;
	j4274379766 [label="Boolean RoatheUsurper is now true.",color=orange];
		j4274379766 -> j3235784175;
	j1648754094 [label="Je dis simplement que c'est un peu gonflé venant de toi, alors que tu es coupable de la même chose.",shape=box,color=red];
		j1648754094 -> j1501250984;
	j161206724 [label="J'essaie juste de comprendre pourquoi tu continues à l'utiliser comme titre pour moi.",shape=box,color=red];
		j161206724 -> j48733959;
	j888437827 [label="Ha! À peine! Tu ne manques pas de patience si tu penses que je t'insulte tranquillement depuis des jours. ",shape=box,color=blue];
		j888437827 -> j2389195802;
	j3235784175 [label="Eh bien, c'est ce que tu es, non? Les Tennos ont volé le Système Origine aux Orokins. Et toi, tel un petit imposteur dans son nid, tu as réussi à t'infiltrer dans ce monde loin du tien.",shape=box,color=blue];
		j3235784175 -> j3608068887;
	j1501250984 [label="Ha! Une insulte? Tu ne manques pas de patience si tu penses que je me fiche tranquillement de toi depuis des jours.",shape=box,color=blue];
		j1501250984 -> j1583718725;
	j48733959 [label="+5 Chemistry",color=orange];
		j48733959 -> j3221225099;
	j2389195802 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2389195802 -> j1649153013 [label=true,color=green];
		j2389195802 -> j1307610231 [label=false,color=brown];
	j3608068887 [label="Et cela fait de toi, à mes yeux, un usurpateur à au moins deux égards. (Et peut-être un troisième, si l'on tient compte de ce que le majordome m'a dit à propos de Duviri, mais c'est un débat pour une autre fois.)",shape=box,color=blue];
		j3608068887 -> j3338942550;
		j3608068887 -> j557421139;
	j1583718725 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1583718725 -> j3019529074 [label=true,color=green];
		j1583718725 -> j996251576 [label=false,color=brown];
	j3221225099 [label="C'est précisément de cela qu'il s'agit: un titre. Une distinction honorifique. Tu as accompli ce à quoi j'aspirais. ",shape=box,color=blue];
		j3221225099 -> j614942158;
	j1649153013 [label="Surtout quand il est si évident que tu as un pouvoir considérable dans cette situation qui est loin d'être unilatérale, n'est-ce pas?",shape=box,color=blue];
		j1649153013 -> j2630353687;
	j1307610231 [label="Surtout quand je sais que tu pourrais simplement utiliser tes pouvoirs du Néant pour traverser un mur et me loger quelques balles dans la nuque à tout moment.",shape=box,color=blue];
		j1307610231 -> j2630353687;
	j3338942550 [label="Donc... tu m'insultes.",shape=box,color=red];
		j3338942550 -> j1501250984;
	j557421139 [label="D'accord. Alors pourquoi continuer à utiliser cela comme un titre?",shape=box,color=red];
		j557421139 -> j48733959;
	j3019529074 [label="Surtout quand il est si évident que tu as un pouvoir considérable dans cette situation qui est loin d'être unilatérale, n'est-ce pas?",shape=box,color=blue];
		j3019529074 -> j1542458108;
	j996251576 [label="Surtout quand je sais que tu pourrais simplement utiliser tes pouvoirs du Néant pour traverser un mur et me loger quelques balles dans la nuque à tout moment.",shape=box,color=blue];
		j996251576 -> j1542458108;
	j614942158 [label="Ce titre n'est que l'expression d'une certaine admiration de ma part. Même s'il n'est pas dénué d'un sarcasme qui n'est pas pour me déplaire, je te l'accorde.",shape=box,color=blue];
		j614942158 -> j4001893502;
		j614942158 -> j2502299502;
		j614942158 -> j3317997910;
		j614942158 -> j1605654539;
	j2630353687 [label="Je n'ai aucune envie que tu deviennes mon ennemi, Usurpateur. Non, ce n'est pas une insulte. C'est uniquement par manque de diligence de ta part que tu n'as pas réalisé à quel point une grande partie de mon passé est similaire au tien.",shape=box,color=blue];
		j2630353687 -> j2038545117;
	j1542458108 [label="Je n'ai aucune envie que tu deviennes mon ennemi, Usurpateur. Non. C'est tout au plus un honneur. Tu as accompli ce à quoi j'aspirais. Rien de plus.",shape=box,color=blue];
		j1542458108 -> j614942158;
	j4001893502 [label="Tous les Orokins étaient-ils comme toi?",shape=box,color=red];
		j4001893502 -> j505402545;
	j2502299502 [label="Si je te demandais gentiment de m'appeler autrement, tu le ferais?",shape=box,color=red];
		j2502299502 -> j3829665802;
	j3317997910 [label="Je ferai avec.",shape=box,color=red];
		j3317997910 -> j4029311737;
	j1605654539 [label="Arrête de m'appeler Usurpateur.",shape=box,color=red];
		j1605654539 -> j3538479904;
	j2038545117 [label="J'étais déterminé à renverser les Orokins, tout comme ton double Tenno et ses semblables. J'ai simplement été arrêté avant d'avoir pu le faire.",shape=box,color=blue];
		j2038545117 -> j1323366906;
	j505402545 [label="+10 Chemistry",color=orange];
		j505402545 -> j3026802186;
	j3829665802 [label="+5 Chemistry",color=orange];
		j3829665802 -> j1340421910;
	j4029311737 [label="+5 Chemistry",color=orange];
		j4029311737 -> j2141593465;
	j3538479904 [label="Hum...",shape=box,color=blue];
		j3538479904 -> j3811228384;
	j1323366906 [label="Boolean RoatheTraitor1 is now true.",color=orange];
		j1323366906 -> j614942158;
	j3026802186 [label="Ah! J'entends presque le soupir de Sanctum. Étaient-ils tous comme moi? Non. Ils étaient largement inférieurs. Et bien plus exaspérants, je le crains.",shape=box,color=blue];
		j3026802186 -> j3639074565;
	j1340421910 [label="Hum... non. Mais j'apprécie ta démonstration de bonnes manières. Tu dois gagner tes titres auprès de moi, Usurpateur. Tu le sais.",shape=box,color=blue];
		j1340421910 -> j3639074565;
	j2141593465 [label="Bien. De toute façon, tu n'as pas le choix. ",shape=box,color=blue];
		j2141593465 -> j3639074565;
	j3811228384 [label="Non.",shape=box,color=blue];
		j3811228384 -> j3639074565;
	j3639074565 [label="+5 Chemistry",color=orange];
		j3639074565 -> j1876526902;
	j1876526902 [label="Vraiment, tu rends ça trop drôle.",shape=box,color=blue];
