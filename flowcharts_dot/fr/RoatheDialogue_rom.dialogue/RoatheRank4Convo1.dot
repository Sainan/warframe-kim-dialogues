	2393 [label="Hum...",shape=box,color=blue];
		2393 -> 2398;
	2394 [label="Update boolean RoatheTraitor1",color=orange];
		2394 -> 2381;
	2395 [label="Ah! J'entends presque le soupir de Sanctum. Étaient-ils tous comme moi? Non. Ils étaient largement inférieurs. Et bien plus exaspérants, je le crains.",shape=box,color=blue];
		2395 -> 2399;
	2396 [label="Hum... non. Mais j'apprécie ta démonstration de bonnes manières. Tu dois gagner tes titres auprès de moi, Usurpateur. Tu le sais.",shape=box,color=blue];
		2396 -> 2399;
	2397 [label="Bien. De toute façon, tu n'as pas le choix. ",shape=box,color=blue];
