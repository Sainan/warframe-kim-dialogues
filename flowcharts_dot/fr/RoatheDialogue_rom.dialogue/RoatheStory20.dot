	2312 [label="VM: SUBMISSION",shape=box,color=blue];
		2312 -> 2311;
	2315 [label="Chat ends.",color=orange];
	2311 [label="Transcription: j’ai compris dès le début, sur le champ de bataille comme dans la chambre à coucher, que la victoire passe par une soumission feinte.",shape=box,color=blue];
		2311 -> 5722;
	5722 [label="Where the enemy finds you yielding, there you can be sure he will push; and so you may easily trip him.",shape=box,color=blue];
		5722 -> 5723;
	5723 [label="“Lackey,” they called me. “Lapdog.” Nitokh thought herself in control. How subtly I guided her. ",shape=box,color=blue];
		5723 -> 2310;
	2310 [label="Roathe aux mains ensanglantées. Roathe l’ogre engraissé des corps de ses hommes. Sacrificateur de vies.",shape=box,color=blue];
		2310 -> 2314;
	2314 [label="Comme si je combattais uniquement pour le plaisir de combattre! Non. L'Empire Orokin doit disparaître.",shape=box,color=blue];
		2314 -> 5724;
	5724 [label="For that to happen, the war must continue. Only defeat, absolute and irrevocable, would topple those seven golden gargoyles.",shape=box,color=blue];
		5724 -> 2316;
	2316 [label="Nitokh elle-même ignorait mes véritables intentions. Elle pensait que j'aspirais à régner à ses côtés.",shape=box,color=blue];
		2316 -> 2309;
	2309 [label="Add 1 to HellStory",color=orange];
		2309 -> 2347;
	2347 [label="{\"Id\":2347,\"Incoming\":[2309],\"Outgoing\":[2313],\"GraphPos\":[4758,-3705],\"CompletionType\":1}",color=orange];
		2347 -> 2313;
	2313 [label="Chat ends.",color=orange];
