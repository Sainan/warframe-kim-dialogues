	"Chat ends." [color=orange];
	j2978105991 [label="VM: SUBMISSION",shape=box,color=blue];
		j2978105991 -> j3251993744;
	j3251993744 [label="Transcription: j’ai compris dès le début, sur le champ de bataille comme dans la chambre à coucher, que la victoire passe par une soumission feinte.",shape=box,color=blue];
		j3251993744 -> j1351788407;
	j1351788407 [label="Where the enemy finds you yielding, there you can be sure he will push; and so you may easily trip him.",shape=box,color=blue];
		j1351788407 -> j367098676;
	j367098676 [label="“Lackey,” they called me. “Lapdog.” Nitokh thought herself in control. How subtly I guided her. ",shape=box,color=blue];
		j367098676 -> j3395599068;
	j3395599068 [label="Roathe aux mains ensanglantées. Roathe l’ogre engraissé des corps de ses hommes. Sacrificateur de vies.",shape=box,color=blue];
		j3395599068 -> j2561854100;
	j2561854100 [label="Comme si je combattais uniquement pour le plaisir de combattre! Non. L'Empire Orokin doit disparaître.",shape=box,color=blue];
		j2561854100 -> j4225166975;
	j4225166975 [label="For that to happen, the war must continue. Only defeat, absolute and irrevocable, would topple those seven golden gargoyles.",shape=box,color=blue];
		j4225166975 -> j3477905048;
	j3477905048 [label="Nitokh elle-même ignorait mes véritables intentions. Elle pensait que j'aspirais à régner à ses côtés.",shape=box,color=blue];
		j3477905048 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}