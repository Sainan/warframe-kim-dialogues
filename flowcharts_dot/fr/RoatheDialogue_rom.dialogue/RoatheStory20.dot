	"Chat ends." [color=orange];
	j3207918580 [label="MV: SOUMISSION",shape=box,color=blue];
		j3207918580 -> j2152221833;
	j2152221833 [label="Transcription: j’ai compris dès le début, sur le champ de bataille comme dans la chambre à coucher, que la victoire passe par une soumission feinte.",shape=box,color=blue];
		j2152221833 -> j2189049727;
	j2189049727 [label="Là où l’ennemi vous surprend à céder, soyez certain qu’il insistera; et ainsi, vous pourrez facilement le faire trébucher",shape=box,color=blue];
		j2189049727 -> j1607768429;
	j1607768429 [label="\"Larbin\", m’appelaient-ils. \"Petit toutou\". Nitokh se croyait maîtresse de la situation. Comme je l’ai manipulée subtilement.",shape=box,color=blue];
		j1607768429 -> j1459356140;
	j1459356140 [label="Roathe aux mains ensanglantées. Roathe l’ogre engraissé des corps de ses hommes. Sacrificateur de vies.",shape=box,color=blue];
		j1459356140 -> j2718855615;
	j2718855615 [label="Comme si je combattais uniquement pour le plaisir de combattre! Non. L'Empire Orokin doit disparaître.",shape=box,color=blue];
		j2718855615 -> j2608481615;
	j2608481615 [label="Pour cela, la guerre doit continuer. Seule une défaite, absolue et irrévocable, pourra nous débarrasser de ces sept gargouilles dorées.",shape=box,color=blue];
		j2608481615 -> j3477905048;
	j3477905048 [label="Nitokh elle-même ignorait mes véritables intentions. Elle pensait que j'aspirais à régner à ses côtés.",shape=box,color=blue];
		j3477905048 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}