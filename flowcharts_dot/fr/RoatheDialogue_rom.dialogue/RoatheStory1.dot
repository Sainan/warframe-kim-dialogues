	2132 [label="Transcription: sa folie était séduisante car elle était manifeste.",shape=box,color=blue];
		2132 -> 5636;
	5636 [label="On savait toujours à quoi s’attendre avec elle, au bord du gouffre de ses insondables abysses.",shape=box,color=blue];
		5636 -> 5635;
	5635 [label="\"Plonge!\", me disaient ses yeux, pétillants de la joie d’une farce cosmique colossale.",shape=box,color=blue];
		5635 -> 5637;
	5637 [label="À travers ses visions démentes, j'échappais à la longue et morne stagnation de l'existence Orokin.",shape=box,color=blue];
		5637 -> 2136;
	2136 [label="Tous nos sens étaient engourdis depuis des siècles. Pourtant, elle restait, à sa manière, fraîche.",shape=box,color=blue];
		2136 -> 5638;
	5638 [label="Éternelle. Insatiable dans sa soif. Un soir, elle me convoqua alors qu'elle prenait son bain. Je traversai les flaques d'eau parfumée et de sang et me mis au garde-à-vous, docile.",shape=box,color=blue];
		5638 -> 5639;
	5639 [label="\"Je m'ennuie, Roathe. Tuons tous les autres Orokins et prenons le pouvoir.\"",shape=box,color=blue];
