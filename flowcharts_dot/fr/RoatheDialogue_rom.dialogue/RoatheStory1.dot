	j3252374139 [label="MV: NITOKH",shape=box,color=blue];
		j3252374139 -> j1425330516;
	j1425330516 [label="Transcription: sa folie était séduisante car elle était manifeste.",shape=box,color=blue];
		j1425330516 -> j2865903115;
	j2865903115 [label="On savait toujours à quoi s’attendre avec elle, au bord du gouffre de ses insondables abysses.",shape=box,color=blue];
		j2865903115 -> j2007915740;
	j2007915740 [label="\"Plonge!\", me disaient ses yeux, pétillants de la joie d’une farce cosmique colossale.",shape=box,color=blue];
		j2007915740 -> j115921661;
	j115921661 [label="À travers ses visions démentes, j'échappais à la longue et morne stagnation de l'existence Orokin.",shape=box,color=blue];
		j115921661 -> j4112178138;
	j4112178138 [label="Tous nos sens étaient engourdis depuis des siècles. Pourtant, elle restait, à sa manière, fraîche.",shape=box,color=blue];
		j4112178138 -> j1824642048;
	j1824642048 [label="Éternelle. Insatiable dans sa soif. Un soir, elle me convoqua alors qu'elle prenait son bain. Je traversai les flaques d'eau parfumée et de sang et me mis au garde-à-vous, docile.",shape=box,color=blue];
		j1824642048 -> j2344396531;
	j2344396531 [label="\"Je m'ennuie, Roathe. Tuons tous les autres Orokins et prenons le pouvoir.\"",shape=box,color=blue];
		j2344396531 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}