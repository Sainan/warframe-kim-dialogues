	j3512713914 [label="MV: DIVISION",shape=box,color=blue];
		j3512713914 -> j304035994;
	j304035994 [label="Transcription: après la première invasion du Système par les Sentients et la riposte désastreuse des Orokins, un silence étrange régnait.",shape=box,color=blue];
		j304035994 -> j2517562392;
	j2517562392 [label="Nous n'avions aucune nouvelle de nos compatriotes bloqués sur Tau et aucun moyen de savoir si leurs signaux étaient brouillés ou s'ils avaient été entièrement anéantis.",shape=box,color=blue];
		j2517562392 -> j2488811695;
	j2488811695 [label="Je me suis retrouvé à devoir solliciter des avis. En tant que stratège, je devais comprendre l'ennemi.",shape=box,color=blue];
		j2488811695 -> j2434806456;
	j2434806456 [label="Les Sentients auraient pu détruire le terminus du Rail Solaire au-dessus de Tau à tout moment et pourtant, le Rail était toujours opérationnel.",shape=box,color=blue];
		j2434806456 -> j3961779914;
	j3961779914 [label="Why? What did they gain from leaving the gate open?",shape=box,color=blue];
		j3961779914 -> j3273990187;
	j3273990187 [label="Were they united in their aggression, or did some yet hope for peaceful coexistence?",shape=box,color=blue];
