	j1642773019 [label="MV: DIVISION",shape=box,color=blue];
		j1642773019 -> j4213773643;
	j4213773643 [label="Transcription: après la première invasion du Système par les Sentients et la riposte désastreuse des Orokins, un silence étrange régnait.",shape=box,color=blue];
		j4213773643 -> j690723914;
	j690723914 [label="Nous n'avions aucune nouvelle de nos compatriotes bloqués sur Tau et aucun moyen de savoir si leurs signaux étaient brouillés ou s'ils avaient été entièrement anéantis.",shape=box,color=blue];
		j690723914 -> j4232300073;
	j4232300073 [label="Je me suis retrouvé à devoir solliciter des avis. En tant que stratège, je devais comprendre l'ennemi.",shape=box,color=blue];
		j4232300073 -> j4014198470;
	j4014198470 [label="Les Sentients auraient pu détruire le terminus du Rail Solaire au-dessus de Tau à tout moment et pourtant, le Rail était toujours opérationnel.",shape=box,color=blue];
		j4014198470 -> j3923438098;
	j3923438098 [label="Pourquoi? Qu’avaient-ils à gagner à laisser la porte ouverte? ",shape=box,color=blue];
		j3923438098 -> j1783565732;
	j1783565732 [label="Étaient-ils unis dans leur agression, ou certains espéraient-ils encore une coexistence pacifique?",shape=box,color=blue];
		j1783565732 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
