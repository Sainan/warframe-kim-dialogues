		j882460340 -> j2067010210;
	j2067010210 [label="Transcription: lorsque les Sentients achevèrent la construction du Rail Solaire vers Tau, aucune grande cérémonie ne fut organisée. Il commença simplement à fonctionner.",shape=box,color=blue];
		j2067010210 -> j1184118741;
	j1184118741 [label="Bien sûr, une cérémonie fut improvisée à la hâte, car aucun Orokin digne de ce nom ne saurait se moucher sans un minimum de faste et de solennité.",shape=box,color=blue];
		j1184118741 -> j3624631232;
	j3624631232 [label="On a fait tout un plat du premier transport à effectuer la Traversée.",shape=box,color=blue];
		j3624631232 -> j1544786376;
	j1544786376 [label="Il s'agissait du majestueux croiseur de l'Exécuteur Tormis et le choix de Tormis comme responsable expéditionnaire pouvait être interprété comme une réprimande collective à l'encontre de l'Exécuteur Tuvul, pour le grotesque accident du Zariman Ten Zero. ",shape=box,color=blue];
		j1544786376 -> j2725897583;
	j2725897583 [label="Tormis partit et revint avec de merveilleux souvenirs d'un nouveau Système et de nouveaux mondes à coloniser.",shape=box,color=blue];
		j2725897583 -> j724650764;
	j724650764 [label="En quelques jours, une flottille de vaisseaux colonisateurs appareilla, impatiente de poser le pied sur ce rivage vierge.",shape=box,color=blue];
