	j698538248 [label="+5 Chemistry",color=orange];
		j698538248 -> j1071637224;
	j1011575868 [label="+5 Chemistry",color=orange];
		j1011575868 -> j4207553893;
	j1117204947 [label="Je pourrais te châtier pour ce que tu as fait afin d'obtenir ce que tu voulais, mais force est de constater que les Orokins sont connus pour avoir fait bien pire, si ce n'est de manière plus créative.",shape=box,color=blue];
		j1117204947 -> j168341688;
	j1780208266 [label="Toi, bien sûr. Ou plutôt, les enfants. Les Tennos. Parfois, je me demande si ce qui s'est passé était inévitable. Ou s'il aurait été possible de le faire changer de cap.",shape=box,color=blue];
		j1780208266 -> j3208882664;
	j1219462911 [label="Peut-être as-tu raison. Ou peut-être sommes-nous tous, au final, des joyaux bruts. Nous avons nos défauts, nos particularités. Des veines ici, des imperfections là.",shape=box,color=blue];
		j1219462911 -> j1073264591;
	j3679150995 [label="Et donc, je commence à comprendre comment tu as pu \"tout gâcher\", Usurpateur. J'ai du mal à croire que tu aies agi au nom de \"l'amour\".",shape=box,color=blue];
		j3679150995 -> j3260574914;
	j1950004131 [label="+5 Chemistry",color=orange];
		j1950004131 -> j3961272898;
	j413666778 [label="+5 Chemistry",color=orange];
		j413666778 -> j4148667444;
	j3260574914 [label="Mais les Orokins ont toujours eu une façon étrange d'exprimer leurs émotions, je suppose.",shape=box,color=blue];
		j3260574914 -> j168341688;
	j3468716569 [label="Je pourrais te châtier pour ce que tu as fait au nom de \"l'amour\", mais force est de constater que les Orokins sont connus pour avoir fait bien pire, si ce n'est de manière plus créative.",shape=box,color=blue];
		j3468716569 -> j168341688;
	j1071637224 [label="Personnellement, je te conseillerais de garder le silence face à tes erreurs et d'accepter la défaite telle qu'elle est, mais cela ferait de moi un sacré hypocrite, n'est-ce pas?",shape=box,color=blue];
		j1071637224 -> j1847224620;
	j4207553893 [label="Personnellement, je te conseillerais de garder le silence face à tes erreurs et d'accepter la défaite telle qu'elle est. Mais je ne possède pas le don du Néant permettant de voyager dans le temps et d'effacer les esprits.",shape=box,color=blue];
		j4207553893 -> j3093449121;
	j168341688 [label="T'ai-je raconté l'histoire de Ballas et Margulis? Je compte sur ton honnêteté, car je n'ai absolument aucun moyen de connaître la vérité autrement.",shape=box,color=blue];
		j168341688 -> j3126771442;
	j3208882664 [label="J'aime à croire que nous sommes tous, au final, des joyaux bruts. Nous avons nos défauts, nos particularités. Des veines ici, des imperfections là.",shape=box,color=blue];
		j3208882664 -> j1073264591;
	j1073264591 [label="Et nous pouvons être façonnés de certaines manières, soit pour capter la lumière et être intégrés à des œuvres d'art élaborées... soit pour être aiguisés en armes... soit pour être réduits en poussière.",shape=box,color=blue];
		j1073264591 -> j1478720161;
	j3961272898 [label="Personnellement, je te conseillerais de garder le silence face à tes erreurs et d'accepter la défaite telle qu'elle est, mais cela ferait de moi un sacré hypocrite, n'est-ce pas?",shape=box,color=blue];
		j3961272898 -> j2222181950;
	j4148667444 [label="Personnellement, je te conseillerais de garder le silence face à tes erreurs et d'accepter la défaite telle qu'elle est. Mais je ne possède pas le don du Néant permettant de voyager dans le temps et d'effacer les esprits.",shape=box,color=blue];
		j4148667444 -> j1463681124;
	j1847224620 [label="Et qui peut dire que je n'aurais pas fait bon usage de ce don du Néant que représente la possibilité de jouer avec les poches temporelles et d'effacer les esprits?",shape=box,color=blue];
		j1847224620 -> j3093449121;
	j3093449121 [label="Comment... est-ce que ça fonctionne, exactement?",shape=box,color=blue];
		j3093449121 -> j1480674139;
		j3093449121 -> j1443665186;
		j3093449121 -> j2429168889;
	j3126771442 [label="Et crois-moi, je déteste ça.",shape=box,color=blue];
		j3126771442 -> j1109016783;
		j3126771442 -> j3442548328;
		j3126771442 -> j3963838308;
		j3126771442 -> j3715847372;
	j1478720161 [label="Peut-être que c'est une croyance naïve et que nous sommes tous, finalement, immuables. Tu en sais plus que moi, paraît-il.",shape=box,color=blue];
		j1478720161 -> j1635961329;
	j2222181950 [label="Et qui peut dire que je n'aurais pas fait bon usage de ce don du Néant que représente la possibilité de jouer avec les poches temporelles et d'effacer les esprits?",shape=box,color=blue];
