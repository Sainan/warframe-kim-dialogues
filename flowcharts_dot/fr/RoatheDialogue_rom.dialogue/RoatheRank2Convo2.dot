	j1855271114 [label="Tu sais qu'ils ont été amoureux, autrefois.",shape=box,color=blue];
		j1855271114 -> j1855486192;
		j1855271114 -> j4267007025;
		j1855271114 -> j2429168889;
	j1983863724 [label="Manipuler nos esprits… tout ça par simple désir? Par amour? Qu’est-ce que c’est? Comment appelles-tu ça? Je me demande simplement si ça en valait la peine. Peut-être ne le sais-tu pas encore, puisque tu n’en as pas encore tiré profit.",shape=box,color=blue];
		j1983863724 -> j2787206288;
	j3077861562 [label="Manipuler nos esprits… quel est le but de tout cela? Cocher une liste de tâches invisible? Ou est-ce fait au nom de la victoire sur ce soi-disant \"dieu\" invoqué?",shape=box,color=blue];
		j3077861562 -> j1223121582;
	j1855486192 [label="Qui?",shape=box,color=red];
		j1855486192 -> j1851210280;
	j4267007025 [label="J'ai beaucoup de mal à le croire.",shape=box,color=red];
		j4267007025 -> j2987566667;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j2787206288 [label="J'imagine que c'est étrangement romantique, peut-être aussi un peu dystopique, de déployer autant d'efforts pour conquérir le cœur (et/ou le corps) de l'être aimé.",shape=box,color=blue];
		j2787206288 -> j3697889841;
	j1223121582 [label="Ou pire encore, peut-être avais-tu la curiosité de voir ce qui se passerait? Et donc tu passes ton temps à arracher les pattes des insectes? Nous avons établi le \"quoi\" de tes actions. Je vais maintenant tenter de comprendre le \"pourquoi\".",shape=box,color=blue];
		j1223121582 -> j3362610447;
	j1851210280 [label="Ballas et Margulis.",shape=box,color=blue];
		j1851210280 -> j3263984957;
	j2987566667 [label="C'est vrai! Je t'entends presque ricaner depuis Sanctum. Mais Ballas et Margulis étaient profondément amoureux.",shape=box,color=blue];
		j2987566667 -> j299307737;
	j3697889841 [label="Ou pire, peut-être avais-tu la curiosité de voir ce qui se passerait? Et donc tu passes ton temps à arracher les pattes des insectes? Nous avons établi le \"quoi\" de tes actions. Je vais maintenant tenter de comprendre le \"pourquoi\".",shape=box,color=blue];
