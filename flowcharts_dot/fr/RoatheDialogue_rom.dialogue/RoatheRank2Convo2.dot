	j1480674139 [label="Tu es désormais Infesté. Et tu as un lien avec les souches Infestées qui ont servi à créer tous les lots de sérum de Protoframe.",shape=box,color=red];
		j1480674139 -> j3181141220;
	j1443665186 [label="Une guitare parlante me doit quelques faveurs.",shape=box,color=red];
		j1443665186 -> j2353934678;
	j1109016783 [label="Je l'ai entendue.",shape=box,color=red];
		j1109016783 -> j2708472897;
	j3442548328 [label="Je l'ai entendue, mais je t'en prie, continue.",shape=box,color=red];
		j3442548328 -> j3358227357;
	j3963838308 [label="En fait, je ne l'ai pas entendue.",shape=box,color=red];
		j3963838308 -> j2428443410;
	j3715847372 [label="Non, je n'ai pas entendu cette histoire et c'est justement en partie pour cela que nous sommes ici. Je sais que j'ai raté des occasions la première fois.",shape=box,color=red];
		j3715847372 -> j1826591232;
	j1635961329 [label="Mais tu me fais raconter tout cela dans le désordre. Permets-moi de commencer correctement.",shape=box,color=blue];
		j1635961329 -> j439750781;
	j3496163681 [label="Tu es désormais Infesté. Et tu as un lien avec les souches Infestées qui ont servi à créer tous les lots de sérum de Protoframe.",shape=box,color=red];
		j3496163681 -> j3435494182;
	j2326824237 [label="Une guitare parlante me doit quelques faveurs.",shape=box,color=red];
		j2326824237 -> j2459122588;
	j3181141220 [label="D'après ce qu'on m'a dit, et elle n'est pas tout à fait fiable, alors prends ça avec des pincettes, les souches d'Infestation pour chaque lot de Protoframes peuvent être influencées individuellement.",shape=box,color=red];
		j3181141220 -> j1800569133;
	j2353934678 [label="Je... je vois.",shape=box,color=blue];
		j2353934678 -> j2611743560;
	j2708472897 [label="+10 Chemistry",color=orange];
		j2708472897 -> j2781599264;
	j3358227357 [label="Soit tu essaies de flatter mon ego et je t'en félicite, soit tu passes tout simplement une journée extrêmement ennuyeuse. Ce que je comprends presque, ayant moi aussi connu d'innombrables cycles de vie.",shape=box,color=blue];
		j3358227357 -> j2830662309;
	j2428443410 [label="Fascinant. Soit tu mens, soit j'ai encore des réponses que tu n'as pas trouvées. C'est peut-être pour cela que tu es de retour, à relire des idées déjà explorées.",shape=box,color=blue];
		j2428443410 -> j438388626;
	j1826591232 [label="Mm, petit à petit, tu es presque en train de me convaincre de te pardonner ce désastre que tu as causé.",shape=box,color=blue];
		j1826591232 -> j3165916619;
	j439750781 [label="Bien avant le lancement du Zariman Ten Zero et même avant que les Tennos ne soient apparus, l'Archimédienne Margulis et Ballas se rencontrèrent lors de l'inauguration d'un nouveau conservatoire.",shape=box,color=blue];
		j439750781 -> j3171007316;
	j3435494182 [label="D'après ce qu'on m'a dit, et elle n'est pas tout à fait fiable, alors prends ça avec des pincettes, les souches d'Infestation pour chaque lot de Protoframes peuvent être influencées individuellement.",shape=box,color=red];
		j3435494182 -> j1841112523;
	j2459122588 [label="Je... je vois.",shape=box,color=blue];
		j2459122588 -> j3263917355;
	j1800569133 [label="Chacune vit en quelque sorte dans sa propre \"continuité\" ou son propre temps. Toutes les souches d'Infestation sont liées, mais elles vivent pour ainsi dire dans des… nodules. C'est très compliqué.",shape=box,color=red];
		j1800569133 -> j2480286450;
	j2611743560 [label="L'univers est vraiment devenu plus étrange depuis que je l'ai quitté...",shape=box,color=blue];
		j2611743560 -> j1010958308;
		j2611743560 -> j1357348207;
	j2781599264 [label="Je ne te lasserai donc pas en te racontant une fois de plus cette saga et je te laisserai trouver d'autres distractions pour le reste de ta journée.",shape=box,color=blue];
		j2781599264 -> j2888030837;
	j2830662309 [label="Si je n'étais pas l'objet de ton amusement.",shape=box,color=blue];
		j2830662309 -> j438388626;
	j438388626 [label="Mais? Quoi qu'il en soit... ",shape=box,color=blue];
