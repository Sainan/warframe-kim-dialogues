	j175311166 [label="Tu as mentionné plus tôt que tu avais \"tout gâché\", ou que toute cette histoire avec les fanatiques était tellement compliquée qu'il était impossible de s'y retrouver. Tu pensais donc vraiment que c'était la meilleure solution?",shape=box,color=blue];
