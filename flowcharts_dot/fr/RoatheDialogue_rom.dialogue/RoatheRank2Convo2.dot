		j3917534279 -> j3507478244;
		j3917534279 -> j2607711960;
	j2990827495 [label="Je pourrais te châtier pour ce que tu as fait pour obtenir ce que tu voulais, mais je suis forcé de constater que les Orokins sont connus pour avoir fait bien pire, voire plus créatif.",shape=box,color=blue];
		j2990827495 -> j168341688;
	j636748696 [label="Ce n'était pas qu'une question de désir, car il pouvait avoir qui il voulait – et il le faisait, assez souvent. S'il la voulait, il aurait pu simplement l'avoir et en finir une fois pour toutes.",shape=box,color=blue];
		j636748696 -> j777333391;
	j3805109593 [label="Et \"elle\" est?",shape=box,color=blue];
		j3805109593 -> j1810530503;
		j3805109593 -> j1210270399;
	j1655899808 [label="Quoi qu'il en soit. Tout cela, au nom de \"l'amour\"?",shape=box,color=blue];
		j1655899808 -> j3468716569;
	j3507478244 [label="Lizzie. Elle t'adorerait.",shape=box,color=red];
		j3507478244 -> j2353934678;
	j2607711960 [label="Une guitare qui parle.",shape=box,color=red];
		j2607711960 -> j2353934678;
	j777333391 [label="Il était Exécuteur. L'un des plus puissants des Sept, en réalité. Il aurait pu la faire venir dans ses appartements et elle aurait obéi sans hésiter.",shape=box,color=blue];
		j777333391 -> j2212562200;
	j1810530503 [label="Lizzie. Elle t'adorerait.",shape=box,color=red];
		j1810530503 -> j2459122588;
	j1210270399 [label="Une guitare qui parle.",shape=box,color=red];
		j1210270399 -> j2459122588;
	j2212562200 [label="Mais il ne fit pas cela. Ballas la regarda une seule fois ce soir-là et… il fut troublé, Voyageur. Complètement et totalement secoué.",shape=box,color=blue];
		j2212562200 -> j169123837;
	j169123837 [label="Je n'avais jamais rien vu de tel. C'était comme si personne d'autre n'existait dans la pièce, à l'exception de Margulis. Il semblait même… trop timide pour lui adresser la parole. Lui! Ballas!",shape=box,color=blue];
		j169123837 -> j1294574206;
		j169123837 -> j3904590731;
	j1294574206 [label="Vraiment?",shape=box,color=red];
		j1294574206 -> j3824795314;
	j3904590731 [label="Tu inventes tout ça.",shape=box,color=red];
		j3904590731 -> j3498685749;
	j3824795314 [label="Je le jure sur ce qui me reste d'honneur! Et quelle raison aurais-je de mentir? Que m'importe ton opinion sur la validité de leur relation?",shape=box,color=blue];
		j3824795314 -> j2101142915;
	j3498685749 [label="Je te jure sur ce qui me reste d'honneur que ce n'est pas le cas! Et quelle raison aurais-je de mentir? Que m'importe ton opinion sur la validité de leur relation?",shape=box,color=blue];
		j3498685749 -> j2101142915;
	j2101142915 [label="Cela me désole tout simplement que vous tous simplifiiez si rapidement quelque chose qui est nettement plus compliqué que vous ne le pensez.",shape=box,color=blue];
		j2101142915 -> j2933339037;
	j2933339037 [label="Ils étaient amoureux, que tu le croies ou non. Ballas a bravé toutes les règles de classe et de traditions pour prendre comme maîtresse son unique amour, une Archimédienne. ",shape=box,color=blue];
		j2933339037 -> j2265186;
	j2265186 [label="Seul le véritable amour aurait pu rendre un homme aussi fou de façon aussi spectaculaire et quand tout a si mal tourné...",shape=box,color=blue];
		j2265186 -> j3442540822;
		j2265186 -> j1181395817;
	j3442540822 [label="Comment arrives-tu à cette conclusion? N'était-il pas responsable de sa mort?",shape=box,color=red];
		j3442540822 -> j1569401423;
	j1181395817 [label="C'est Ballas qui l'a fait exécuter.",shape=box,color=red];
		j1181395817 -> j1569401423;
	j1569401423 [label="Partons du principe que tout ce que tu sais est exact et que ses actions étaient vraiment voulues. Supposons également qu'il n'y ait eu aucune autre manœuvre politique, aucun chantage ni aucune autre ingérence en coulisses qui aurait pu le contraindre à agir ainsi.",shape=box,color=blue];
		j1569401423 -> j4262102131;
	j4262102131 [label="Même si c'était bien le cas et que Ballas avait ordonné son exécution en toute indépendance, il était déjà trop tard. La trahison qu'il ressentait l'avait déjà déchiré en deux.",shape=box,color=blue];
		j4262102131 -> j1322895456;
	j1322895456 [label="Son cœur et son âme étaient déjà brisés.",shape=box,color=blue];
		j1322895456 -> j2761302384;
		j1322895456 -> j783429908;
	j2761302384 [label="Je ne vais pas commencer à le plaindre, si c'est ce que tu me demandes.",shape=box,color=red];
		j2761302384 -> j4050040917;
	j783429908 [label="À cause des Tennos? Ou à cause de ce qu'ils lui ont fait?",shape=box,color=red];
		j783429908 -> j2636740117;
	j4050040917 [label="Je ne te demande rien de tel! Ballas ne mérite qu'une chose: qu'on aille pisser sur sa tombe – s'il a bien une tombe.",shape=box,color=blue];
		j4050040917 -> j4027021003;
	j2636740117 [label="D'une certaine manière, les deux. Et d'une autre, aucun des deux. Il a sombré dans la folie ce jour-là, lorsqu'il a réclamé son exécution. En fait, je ne serais pas surpris qu'une partie de lui ne se souvienne pas précisément de l'acte commis.",shape=box,color=blue];
		j2636740117 -> j669513796;
	j4027021003 [label="Je dis simplement que le jour où il a ordonné son exécution, il était fou. Je ne serais pas surpris qu'après coup, une partie de lui ne se soit plus exactement souvenue de ce qu'il avait fait.",shape=box,color=blue];
		j4027021003 -> j669513796;
	j669513796 [label="Ballas aimait Margulis. De tout son être, il lui était entièrement dévoué. Il aurait tout sacrifié pour elle. Son âme, son corps, l'Empire Orokin. Tout ce qu'on peut imaginer.",shape=box,color=blue];
		j669513796 -> j3830900234;
	j3830900234 [label="Aucun prix n'était trop élevé. Aucune morale ne valait la peine d'être préservée. Si tu lui avais tendu un nouveau-né en lui disant que Margulis souhaitait que son cerveau soit fracassé sur les rochers, il serait mort avant même que tu aies fini ta phrase.",shape=box,color=blue];
		j3830900234 -> j3539059427;
	j3539059427 [label="Il aurait réduit le Système Origine en cendres et l'aurait reconstruit à son image, Usurpateur... mais c'est là que réside la tragédie.",shape=box,color=blue];
		j3539059427 -> j3890077923;
	j3890077923 [label="Margulis? Ah, Margulis. Cette chère, douce, adorable Margulis… elle avait encore une conscience.",shape=box,color=blue];
		j3890077923 -> j623645435;
	j623645435 [label="Et quand elle vit les pauvres Tennos, les pauvres enfants déchirés par le Néant... ",shape=box,color=blue];
		j623645435 -> j1466939947;
	j1466939947 [label="Il y avait quelque chose dans sa vie qui comptait plus que Ballas. Il y avait quelque chose dans sa vie pour lequel elle était prête à tout sacrifier… et ce n’était pas lui.",shape=box,color=blue];
		j1466939947 -> j239296245;
	j239296245 [label="Ce n'était pas l'amour qu'elle lui vouait.",shape=box,color=blue];
		j239296245 -> j3391007153;
	j3391007153 [label="Et il le savait, Voyageur. Il le savait depuis l'instant où elle les avait vus. Et cela lui a été confirmé lorsque ses \"bêtes enragées\" ont fait en sorte qu'elles furent les dernières choses qu'elle vit. Du moins, c'est ce que les rumeurs couraient parmi nous, les Orokins.",shape=box,color=blue];
		j3391007153 -> j459182374;
	j459182374 [label="Peux-tu imaginer la joie des Orokins? Voir la précieuse Archimédienne de Ballas déchirée par le Néant, ces morveux enragés lui brûlant les yeux?",shape=box,color=blue];
		j459182374 -> j131125898;
	j131125898 [label="Mais je pense que c'est avant cela, au moment précis où Margulis s'est battue pour sauver les Tennos, que le cœur de Ballas s'est brisé en mille morceaux et qu'il ne s'en est jamais remis.",shape=box,color=blue];
		j131125898 -> j1495046879;
	j1495046879 [label="Parce qu'il savait qu'il avait perdu la place qu'il occupait dans son cœur au profit de quelqu'un d'autre.",shape=box,color=blue];
		j1495046879 -> j3011302009;
	j3011302009 [label="C’est sans doute pour cela que j’ai eu pitié de lui. Mais la suite? Une histoire d’amour légendaire… et elle s’est terminée en une tragédie si bouleversante. ",shape=box,color=blue];
		j3011302009 -> j1498885089;
	j1498885089 [label="J'aurais aimé que tu puisses voir comment ils se souriaient...",shape=box,color=blue];
		j1498885089 -> j169127706;
		j1498885089 -> j3363746852;
	j169127706 [label="Tu peux idéaliser leur relation, mais cela n'excuse en rien qui il était. Ballas est impardonnable pour tout ce qu'il a fait.",shape=box,color=red];
		j169127706 -> j3440955432;
	j3363746852 [label="J'apprécie que leur amour ait été réel. Qu'il ait été… compliqué à l'époque. Et que Margulis n'ait pas été manipulée du début à la fin.",shape=box,color=red];
		j3363746852 -> j220105680;
	j3440955432 [label="Add 1 to Thermostat counter",color=orange];
		j3440955432 -> j3686142722;
	j220105680 [label="Add -1 to Thermostat counter",color=orange];
		j220105680 -> j268941182;
	j3686142722 [label="+10 Chemistry",color=orange];
		j3686142722 -> j398531325;
	j268941182 [label="+10 Chemistry",color=orange];
		j268941182 -> j1707308035;
	j398531325 [label="Je ne cherchais pas à établir un parallèle entre les deux, Usurpateur. J'ai simplement dit qu'un homme peut être aimé, mais qu'il est aussi capable d'actes terribles. Eh bien… Il n'y a plus aucun espoir pour nous, pauvres fous corrompus…",shape=box,color=blue];
		j398531325 -> j1973137558;
	j1707308035 [label="En effet. Parfois, cela me réconforte de penser que si même ce seigneur de la dépravation peut trouver l'amour, il y a de l'espoir pour nous autres, n'est-ce pas? Ha!",shape=box,color=blue];
		j1707308035 -> j1973137558;
	j1973137558 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j1973137558 -> j471521530;
	j471521530 [label="Mais j'ai assez pris de ton temps pour aujourd'hui. File, maintenant. ",shape=box,color=blue];
		j471521530 -> "Chat ends.";
}