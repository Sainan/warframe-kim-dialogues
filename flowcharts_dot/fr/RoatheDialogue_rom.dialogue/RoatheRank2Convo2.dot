	j813160563 [label="Je ne savais pas quoi faire d'autre. Je n'avais pas d'autres options.",shape=box,color=red];
		j813160563 -> j3772047713;
	j3226973558 [label="Oui. Je ne pensais pas que tu te... retrouverais dans cet état, avec des souvenirs à moitié effacés. Je te demande pardon.",shape=box,color=red];
		j3226973558 -> j2042186431;
