	j1264653433 [label="Pas aujourd'hui. Pas demain.",shape=box,color=blue];
		j1264653433 -> j2033666391;
	j2288579661 [label="Pourquoi?",shape=box,color=blue];
		j2288579661 -> j4187071255;
	j2187880054 [label="Pourquoi?",shape=box,color=blue];
		j2187880054 -> j3015192942;
	j1918760769 [label="Mais nous en reparlerons. J'ai une proposition à te faire, une proposition qui, je crois, t'intéressera bien davantage.",shape=box,color=blue];
		j1918760769 -> j3792173140;
	j498094459 [label="Mais tu auras une dette envers le diable.",shape=box,color=blue];
		j498094459 -> j10591881;
	j325217442 [label="Si j'avais été conscient au moment où il a dit ça, je lui aurais ri au nez. Car ce n'est pas moi qui cherche ouvertement le pardon, n'est-ce pas?",shape=box,color=blue];
		j325217442 -> j243036013;
	j2602664168 [label="J'avais raison. Même si le processus de création fut… laborieux et fastidieux, c'est le moins qu'on puisse dire! J'ai utilisé des échantillons de mon propre sang pour reconstituer un Helminth, via des essais et des erreurs!",shape=box,color=blue];
		j2602664168 -> j2445966453;
	j2518895284 [label="Mais j'ai des flashs. Des fragments d'un couloir doré. Une voix que je reconnais, mais pas de visage. C'était Albrecht, mais pas celui que je connaissais.",shape=box,color=blue];
		j2518895284 -> j2362579743;
	j800007095 [label="Et, plus important encore, je ferai en sorte que tu atteignes ton objectif de soutenir Lyon dans sa souffrance, quoi qu'il arrive, cette fois-ci.",shape=box,color=blue];
		j800007095 -> j1002077644;
