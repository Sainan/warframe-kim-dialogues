	j3144175772 [label="Je me demande… Combien de combats aurais-je pu remporter sur le champ de bataille et recommencer, si j’avais eu un tel pouvoir?",shape=box,color=blue];
		j3144175772 -> j1952911784;
	j3188022609 [label="Boolean DrifterLyon is now true.",color=orange];
		j3188022609 -> j986466688;
	j2665728912 [label="Boolean DrifterMarie is now true.",color=orange];
		j2665728912 -> j3446172214;
	j2220157938 [label="Boolean DrifterRoathe is now true.",color=orange];
		j2220157938 -> j3946570611;
	j3308079382 [label="Combien d'esprits aurais-je profanés si j'avais eu tes talents à ma disposition?",shape=box,color=blue];
		j3308079382 -> j1600262655;
	j676580727 [label="Attends… Je suis perplexe. Comment et quand Entrati t'a-t-il transformé en Protoframe?",shape=box,color=red];
		j676580727 -> j2341648991;
	j896516330 [label="Euh. Attends. Tu as fait quoi?!",shape=box,color=red];
		j896516330 -> j2686848325;
	j3163937551 [label="Il a tellement de... choses à gérer. Et je ne sais pas comment faire.",shape=box,color=red];
		j3163937551 -> j2039764932;
	j654571957 [label="J'ai des sentiments pour lui...",shape=box,color=red];
		j654571957 -> j3188022609;
	j2373725495 [label="Elle ne verra jamais Entrati pour ce qu'il est vraiment. Et je n'arrive pas à lui faire comprendre la vérité, quoi que je fasse.",shape=box,color=red];
		j2373725495 -> j1044324222;
	j2713144375 [label="J'ai des sentiments pour elle...",shape=box,color=red];
		j2713144375 -> j2665728912;
	j420983419 [label="Eh bien, vois-tu, il y a toute cette histoire sur les raisons pour lesquelles tu as pris le sérum et moi... j'ai un peu tout gâché...",shape=box,color=red];
		j420983419 -> j2603162139;
	j3000389012 [label="[Avouer vos sentiments.] C'est... c'est vraiment embarrassant, mais je...",shape=box,color=red];
		j3000389012 -> j2220157938;
	j1952911784 [label="Combien d'esprits aurais-je profanés si j'avais eu tes talents à ma disposition?",shape=box,color=blue];
		j1952911784 -> j2180139398;
	j986466688 [label="+5 Chemistry",color=orange];
		j986466688 -> j3379747210;
	j3446172214 [label="+5 Chemistry",color=orange];
		j3446172214 -> j1649835376;
	j3946570611 [label="+5 Chemistry",color=orange];
		j3946570611 -> j249766214;
	j1600262655 [label="Ensuite, je suis frappé par la fureur et la colère immédiates que je ressens en réalisant que mon esprit a été manipulé non pas une, mais deux fois récemment. Mais une autre émotion vient apaiser cette colère. Une émotion que je ne comprends pas encore tout à fait.",shape=box,color=blue];
		j1600262655 -> j1600459739;
	j2341648991 [label="Je ne connais pas les détails, car ces souvenirs, ainsi que beaucoup d'autres, ont disparu de ma mémoire à cause de la transformation qu'il m'a imposée.",shape=box,color=blue];
		j2341648991 -> j3092946348;
	j2686848325 [label="Oui! Exactement! Avec des échantillons de mon propre sang, rien de moins! Je n'ai pas commencé l'année où nous sommes partis, je peux te le dire! Par le Néant, je vais lui arracher la chair avec mes nouvelles griffes dès que je verrai sa stupide gueule suffisante.",shape=box,color=blue];
		j2686848325 -> j4021277398;
	j2039764932 [label="Je te conseillerais plutôt la patience, mais… loin de moi l’idée de te dire d’utiliser un burin quand un outil de précision laser est à ta disposition.",shape=box,color=blue];
		j2039764932 -> j3090195918;
	j1044324222 [label="+5 Chemistry",color=orange];
		j1044324222 -> j248847784;
	j2180139398 [label="Ensuite, je suis frappé par la fureur et la colère immédiates que je ressens en réalisant que mon esprit a été manipulé non pas une, mais deux fois récemment. Mais une autre émotion vient apaiser cette colère. Une émotion que je ne comprends pas encore tout à fait.",shape=box,color=blue];
		j2180139398 -> j1080292855;
	j3379747210 [label="Premièrement: je suis impressionné! Tu as effacé tous nos souvenirs pour pouvoir tenter une nouvelle fois de gagner son affection?!",shape=box,color=blue];
		j3379747210 -> j882970735;
	j1649835376 [label="Premièrement: je suis impressionné! Tu as effacé tous nos souvenirs pour pouvoir tenter une nouvelle fois de gagner son affection?!",shape=box,color=blue];
		j1649835376 -> j1823978298;
	j249766214 [label="Oh, c'est vraiment fantastique! Tu as effacé tous nos souvenirs pour tenter de conquérir mon cœur?!",shape=box,color=blue];
		j249766214 -> j4019541726;
	j1600459739 [label="La trahison.",shape=box,color=blue];
		j1600459739 -> j26312625;
	j3092946348 [label="Mais j'ai des flashs. Des fragments d'un couloir doré. Une voix que je reconnais, mais pas de visage. C'était Albrecht, mais pas celui que je connaissais.",shape=box,color=blue];
		j3092946348 -> j1433444111;
	j4021277398 [label="Accorde-moi un instant pour me calmer.",shape=box,color=blue];
		j4021277398 -> j2372789662;
	j3090195918 [label="Je suis assis ici et deux choses me frappent immédiatement:",shape=box,color=blue];
		j3090195918 -> j2976042593;
	j248847784 [label="Hum. Je vois. Une noble entreprise, à vrai dire. Une entreprise que j'ai moi-même tentée à maintes reprises. Et qui a également échoué.",shape=box,color=blue];
		j248847784 -> j903581039;
	j1080292855 [label="La trahison.",shape=box,color=blue];
		j1080292855 -> j6893307;
	j882970735 [label="C'est très Orokin de ta part.",shape=box,color=blue];
		j882970735 -> j2393959431;
	j1823978298 [label="C'est très Orokin de ta part.",shape=box,color=blue];
		j1823978298 -> j3800131890;
	j4019541726 [label="C'est très Orokin de ta part.",shape=box,color=blue];
		j4019541726 -> j1579046872;
	j26312625 [label="Pourquoi?",shape=box,color=blue];
		j26312625 -> j2301972799;
	j1433444111 [label="Une douleur brûlante, lancinante. Comme je n'en avais jamais connu. Et pourtant, mon ancien corps, Voyageur, avait perdu un bras et une jambe dans une explosion durant la guerre. J'ai été couvert de brûlures si graves que je n'aurais pu m'en remettre sans Kuva. J'ai connu l'agonie.",shape=box,color=blue];
		j1433444111 -> j2713759069;
	j2372789662 [label="Merci. Nous pouvons continuer.",shape=box,color=blue];
		j2372789662 -> j4143302399;
	j2976042593 [label="Je me demande… Combien de combats aurais-je pu remporter sur le champ de bataille et recommencer, si j’avais eu un tel pouvoir?",shape=box,color=blue];
		j2976042593 -> j1811515024;
	j903581039 [label="Je suis assis ici et deux choses me frappent immédiatement:",shape=box,color=blue];
		j903581039 -> j3579444867;
	j6893307 [label="Pourquoi?",shape=box,color=blue];
		j6893307 -> j385117932;
	j2393959431 [label="Deuxièmement: ton incompétence est-elle sans limite?! Je suis presque certain que si tu prends simplement la peine de nourrir et d’abreuver le prêtre une fois par jour, tu auras son amour et son adoration éternels.",shape=box,color=blue];
		j2393959431 -> j192191469;
	j3800131890 [label="Deuxièmement: as-tu essayé de boiter devant elle? De simuler une maladie? De faire les yeux doux? De simplement lui dire qu’elle est jolie? Elle ne semble pas si difficile à séduire.",shape=box,color=blue];
		j3800131890 -> j1699117622;
	j1579046872 [label="Je suis assis ici et deux choses me frappent immédiatement:",shape=box,color=blue];
		j1579046872 -> j1075390562;
	j2301972799 [label="Mais nous en reparlerons. J'ai une proposition à te faire, une proposition qui, je crois, t'intéressera bien davantage.",shape=box,color=blue];
		j2301972799 -> j4184103696;
	j2713759069 [label="Mon corps a été déchiré et reconstruit. Par la force. Je n'ai rien choisi. J'ignore si c'était la même chose pour les autres.",shape=box,color=blue];
		j2713759069 -> j2406558721;
	j4143302399 [label="J'ai utilisé des échantillons de mon propre sang pour tenter de reconstituer un Helminth via rétro-ingénierie, par tâtonnements. Ce n'était pas une mince affaire, sans accès à aucun équipement Orokin. Ni à aucun autre équipement, d'ailleurs, à part ce que j'ai pu dérober aux...",shape=box,color=blue];
		j4143302399 -> j3089434185;
	j1811515024 [label="Combien d'esprits aurais-je profanés si j'avais eu tes talents à ma disposition?",shape=box,color=blue];
		j1811515024 -> j4021313147;
	j3579444867 [label="Je me demande… Combien de combats aurais-je pu remporter sur le champ de bataille et recommencer, si j’avais eu un tel pouvoir?",shape=box,color=blue];
		j3579444867 -> j2533068952;
	j385117932 [label="Mais nous en reparlerons. J'ai une proposition à te faire, une proposition qui, je crois, t'intéressera bien davantage.",shape=box,color=blue];
		j385117932 -> j2751015403;
	j192191469 [label="Ne te méprends pas! Je suis même plutôt impressionné de voir à quel point tu es perfide. ",shape=box,color=blue];
		j192191469 -> j660533135;
	j1699117622 [label="Troisièmement: je suis assis ici et je suis soudainement submergé par une prise de conscience suite à la confirmation de mes soupçons: ",shape=box,color=blue];
		j1699117622 -> j1606345706;
	j1075390562 [label="Je me demande… Combien de combats aurais-je pu remporter sur le champ de bataille et recommencer, si j’avais eu un tel pouvoir?",shape=box,color=blue];
		j1075390562 -> j2113852420;
	j4184103696 [label="Je ferai semblant de ne rien savoir devant les fanatiques...",shape=box,color=blue];
		j4184103696 -> j2032617910;
	j2406558721 [label="Je me souviens des marches froides sous mes pieds, là où l'on m'a laissé tomber. Les marches de cathédrale, je le sais maintenant, car Lyon et Marie m'ont raconté l'histoire d'après leurs souvenirs.",shape=box,color=blue];
		j2406558721 -> j3484168164;
	j3089434185 [label="Je ne leur ferai pas la faveur de les qualifier d'hôpitaux \"rudimentaires\". Albrecht avait utilisé un Helminth pour nous transporter dans le passé. Comment il a pu grandir, je l'ignore, puisqu'il devait déjà être là pour que nous arrivions. Il s'est desséché et est mort durant le voyage – je suppose qu'un autre pourrait servir pour le retour.",shape=box,color=blue];
		j3089434185 -> j827949778;
	j4021313147 [label="Ensuite, je suis frappé par la fureur et la colère immédiates que je ressens en réalisant que mon esprit a été manipulé non pas une, mais deux fois récemment. Mais une autre émotion vient apaiser cette colère. Une émotion que je ne comprends pas encore tout à fait.",shape=box,color=blue];
		j4021313147 -> j3773472738;
	j2533068952 [label="Combien d'esprits aurais-je profanés si j'avais eu tes talents à ma disposition?",shape=box,color=blue];
		j2533068952 -> j2391869992;
	j2751015403 [label="Je ferai semblant de ne rien savoir devant les fanatiques...",shape=box,color=blue];
		j2751015403 -> j4146540984;
	j660533135 [label="Franchement, je ne crois pas que je puisse te juger. Combien de combats aurais-je pu remporter sur le champ de bataille et recommencer, si j’avais eu un tel pouvoir?",shape=box,color=blue];
		j660533135 -> j2982795991;
	j1606345706 [label="Je me demande… Combien de combats aurais-je pu remporter sur le champ de bataille et recommencer, si j’avais eu un tel pouvoir?",shape=box,color=blue];
