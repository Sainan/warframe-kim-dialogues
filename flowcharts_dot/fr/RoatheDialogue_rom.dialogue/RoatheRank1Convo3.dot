	j3015192942 [label="Mais nous en reparlerons. J'ai une proposition à te faire, une proposition qui, je crois, t'intéressera bien davantage.",shape=box,color=blue];
		j3015192942 -> j1549462055;
	j3792173140 [label="Je ferai semblant de ne rien savoir devant les fanatiques...",shape=box,color=blue];
		j3792173140 -> j570250691;
	j10591881 [label="Sommes-nous d'accord?",shape=box,color=blue];
		j10591881 -> j2136035801;
		j10591881 -> j2655678940;
	j243036013 [label="C'est lui qui fuit sa famille, son amant, le combat qu'il a déclenché contre ce faux dieu! Je ne suis pas le lâche damné, ici!",shape=box,color=blue];
		j243036013 -> j2316497707;
	j2445966453 [label="Boolean RoatheHelminth1 is now true.",color=orange];
		j2445966453 -> j2555727097;
	j2362579743 [label="Une douleur brûlante, lancinante. Comme je n'en avais jamais connu. Et pourtant, mon ancien corps, Voyageur, avait perdu un bras et une jambe dans une explosion durant la guerre. J'ai été couvert de brûlures si graves que je n'aurais pu m'en remettre sans Kuva. J'ai connu l'agonie.",shape=box,color=blue];
		j2362579743 -> j1881466544;
	j1002077644 [label="Mais souviens-toi de mes paroles, Voyageur.",shape=box,color=blue];
		j1002077644 -> j2761299659;
	j2522451042 [label="Et, plus important encore, je ferai en sorte que tu atteignes ton objectif de faire comprendre à Marie qui est Entrati, quoi qu'il arrive, cette fois-ci.",shape=box,color=blue];
		j2522451042 -> j3800613254;
