	j1068191445 [label="Pas aujourd'hui. Pas demain.",shape=box,color=blue];
		j1068191445 -> j498094459;
	j124576082 [label="Je sais ce qu'il a dit aux deux fanatiques, pour ce que ça vaut. \"Uriel, hérétique de Xata, en exil, réponds: les Orokins pourront-ils jamais être pardonnés?\"",shape=box,color=blue];
		j124576082 -> j325217442;
	j2529528425 [label="Un Helminth. Comment il a pu grandir, je l'ignore, puisqu'il devait déjà être là pour que nous arrivions. Il s'est desséché et est mort durant le voyage – je suppose qu'un autre pourrait servir pour le retour.",shape=box,color=blue];
		j2529528425 -> j2602664168;
	j3881929143 [label="Je ne connais pas les détails, car ces souvenirs, ainsi que beaucoup d'autres, ont disparu de ma mémoire à cause de la transformation qu'il m'a imposée.",shape=box,color=blue];
		j3881929143 -> j2518895284;
	j1390387580 [label="Je ferai semblant de ne rien savoir devant les fanatiques...",shape=box,color=blue];
		j1390387580 -> j800007095;
	j694827116 [label="Mais nous en reparlerons. J'ai une proposition à te faire, une proposition qui, je crois, t'intéressera bien davantage.",shape=box,color=blue];
