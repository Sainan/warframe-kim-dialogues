digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank1Convo3 begins." [color=orange];
		"RoatheRank1Convo3 begins." -> j2047367144;
		"RoatheRank1Convo3 begins." -> j2429168889;
	j2047367144 [label="Puis-je te demander comment tu es arrivé ici? De... quelle époque, exactement?",shape=box,color=red];
		j2047367144 -> j1782054338;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j1782054338 [label="Evaluate expressions on HellStory counter",color=orange];
		j1782054338 -> j1114566280 [label="x >= 21",color=purple];
		j1782054338 -> j155352447 [label="x < 21",color=purple];
		j1782054338 -> j155352447 [label="false",color=purple];
	"Chat ends." [color=orange];
	j1114566280 [label="Pourquoi ai-je le sentiment que tu connais déjà très bien la réponse à cette question, mon Usurpateur? À quel jeu joues-tu en me posant des questions aussi triviales, si tu as déjà sondé les fragments de mon esprit?",shape=box,color=blue];
		j1114566280 -> j4011668186;
	j155352447 [label="Oui, tu peux le demander! Cela me donne l'occasion de louer ma propre intelligence et de déplorer l'incroyable capacité d'Albrecht à être à la fois d'une bêtise crasse et d'une lâcheté suprême!",shape=box,color=blue];
		j155352447 -> j4070589250;
	j4011668186 [label="Check boolean RoatheKnowsReset",color=orange];
		j4011668186 -> j416645200 [label=true,color=green];
		j4011668186 -> j851449952 [label=false,color=brown];
	j4070589250 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4070589250 -> j2474990736 [label="x >= 1",color=purple];
		j4070589250 -> j3993493813 [label="x <= 0",color=purple];
		j4070589250 -> j3993493813 [label="false",color=purple];
	j416645200 [label="Tu es tout aussi ignoble qu'Albrecht, tu manipules les esprits de ceux qui t'entourent, tu les considères comme des jouets! Alors, dis-moi. Pourquoi poser la question si tu as déjà les réponses, hein?",shape=box,color=blue];
		j416645200 -> j1363805908;
		j416645200 -> j4056599501;
	j851449952 [label="Dis-moi. Ai-je raison de penser que tu as déjà les réponses que tu cherches? Tu sais déjà comment je suis revenu ici avec les fanatiques et d'où nous venions précisément. Et probablement bien plus encore, n'est-ce pas?",shape=box,color=blue];
		j851449952 -> j3309663614;
		j851449952 -> j2485362806;
	j2474990736 [label="J'ai compris qu'Albrecht ne t'avait pas envoyé là par choix.",shape=box,color=red];
		j2474990736 -> j426424447;
	j3993493813 [label="Ah. Donc, tu n'as pas été envoyé dans le passé par choix.",shape=box,color=red];
		j3993493813 -> j426424447;
	j1363805908 [label="J'essaie de te guider tout au long de ce processus et j'ai tout foutu en l'air la dernière fois. Je recommence. \"En partant de zéro\", pour ainsi dire.",shape=box,color=red];
		j1363805908 -> j2335358357;
	j4056599501 [label="Je ne sais pas vraiment comment expliquer ça. Je n'ai pas demandé ce pouvoir d'effacer vos mémoires et j'essaie de le maîtriser du mieux que je peux.",shape=box,color=red];
		j4056599501 -> j2035673300;
	j3309663614 [label="Non. Pas du tout.",shape=box,color=red];
		j3309663614 -> j483334982;
	j2485362806 [label="Je... l'admets, oui.",shape=box,color=red];
		j2485362806 -> j2912235731;
	j426424447 [label="Non. Absolument pas. Il y a une chose que tu dois comprendre à propos des Orokins: nous jouons – enfin… plus exactement, jouions – fréquemment entre nous. Des jeux de toutes sortes: politiques, psychologiques, sexuels. Peu importe.",shape=box,color=blue];
		j426424447 -> j2848736092;
	j2335358357 [label="+5 Chemistry",color=orange];
		j2335358357 -> j2985158497;
	j2035673300 [label="Tu t'en sors donc plutôt mal, mon cher Voyageur perpétuel. Quels objectifs cherches-tu à atteindre que tu n'as pas déjà atteints auparavant?",shape=box,color=blue];
		j2035673300 -> j4269406562;
	j483334982 [label="Ha! Et maintenant je sais que tu mens autant que tu voles les souvenirs, Usurpateur.",shape=box,color=blue];
		j483334982 -> "Chat ends.";
	j2912235731 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j2912235731 -> j4211245401;
	j2848736092 [label="Grâce au Kuva et au Théâtre Yuvan, nous étions fondamentalement et fonctionnellement immortels. Peux-tu imaginer à quel point cela devient épuisant?",shape=box,color=blue];
		j2848736092 -> j201970915;
		j2848736092 -> j41756078;
	j2985158497 [label="Boolean RoatheResetScrewedUp is now true.",color=orange];
		j2985158497 -> j4233959641;
	j4269406562 [label="Check boolean LoidFamilyComplete",color=orange];
		j4269406562 -> j653876603 [label=true,color=green];
		j4269406562 -> j2280461 [label=true,color=green];
		j4269406562 -> j1460956514 [label=false,color=brown];
		j4269406562 -> j653876603 [label=false,color=brown];
		j4269406562 -> j2280461 [label=false,color=brown];
	j4211245401 [label="Alors, pourquoi venir me poser des questions si tu connais déjà les réponses?",shape=box,color=blue];
		j4211245401 -> j1363805908;
		j4211245401 -> j4056599501;
	j201970915 [label="Crois-le ou non, j'ai une certaine expérience en la matière.",shape=box,color=red];
		j201970915 -> j2348395453;
	j41756078 [label="Je peux, en effet. Mais je t'en prie, continue.",shape=box,color=red];
		j41756078 -> j340202545;
	j4233959641 [label="Là, je trouve ça fascinant… est-ce que tu as \"tout foutu en l'air\" avec moi, ou était-ce avec Lyon ou Marie?",shape=box,color=blue];
		j4233959641 -> j2927632597;
		j4233959641 -> j2336562642;
		j4233959641 -> j1820601123;
	j653876603 [label="Eh bien, tu vois, il y a toute cette histoire... sur les raisons pour lesquelles vous avez pris le sérum et moi... j'ai dit des choses inappropriées au mauvais moment.",shape=box,color=red];
		j653876603 -> j2603162139;
	j2280461 [label="J'essaie de conquérir le cœur de l'un d'entre vous et j'ai vraiment tout gâché...",shape=box,color=red];
		j2280461 -> j2012769292;
	j1460956514 [label="J'essaie de vous convaincre, toi et les autres, de m'aider à réunir Loid avec sa famille à l'étage et... je... j'ai échoué...",shape=box,color=red];
		j1460956514 -> j2961315707;
	j2348395453 [label="Si j'ai bien compris, tu as fait l'expérience d'une éternité de morts. Ce qui est bien plus intéressant – et pourtant, tu as fini par trouver des raisons de t'en lasser.",shape=box,color=blue];
		j2348395453 -> j340202545;
	j340202545 [label="Mon propos était donc le suivant: je suis habitué, même très habitué, aux machinations et aux stratagèmes que nous, Orokins, nous jouons les uns aux autres pour nous amuser. C'est tout simplement notre façon de passer le temps.",shape=box,color=blue];
		j340202545 -> j1411249948;
	j2927632597 [label="Lyon...",shape=box,color=red];
		j2927632597 -> j4003513280;
	j2336562642 [label="Marie...",shape=box,color=red];
		j2336562642 -> j485627812;
	j1820601123 [label="Avec toi...",shape=box,color=red];
		j1820601123 -> j2532221960;
	j2603162139 [label="+5 Chemistry",color=orange];
		j2603162139 -> j3864403887;
	j2012769292 [label="+5 Chemistry",color=orange];
		j2012769292 -> j3418809946;
	j2961315707 [label="Hum. Je vois. Nous avions un accord et tu n'as pas pu respecter ta part du marché, donc ta récompense a disparu.",shape=box,color=blue];
		j2961315707 -> j553230123;
	j1411249948 [label="Mais il y a des limites à ne pas franchir. Des actes à ne pas commettre. Je pourrais m'étendre sur le sujet, mais je ne le ferai pas. Je résumerai simplement en disant qu'Albrecht les a toutes transgressées.",shape=box,color=blue];
		j1411249948 -> j3994855101;
	j4003513280 [label="Vraiment? As-tu essayé de simplement le nourrir et de l'arroser une fois par jour pour voir si cela suffit? Très bien…",shape=box,color=blue];
		j4003513280 -> j3495306657;
	j485627812 [label="Et tu n'as pas réussi à convaincre ce petit grain de pureté de te suivre? J'espère… que tu ne te lanceras pas dans une carrière de diplomate, mon cher Voyageur perpétuel.",shape=box,color=blue];
		j485627812 -> j2484850022;
	j2532221960 [label="+5 Chemistry",color=orange];
		j2532221960 -> j3625184363;
	j3864403887 [label="Hum.",shape=box,color=blue];
		j3864403887 -> j738571875;
	j3418809946 [label="Ah! C'est génial! Tu as toute mon attention, maintenant… lequel d'entre nous? Hum? Dis-moi… n'aie pas peur. Peut-être pourrions-nous trouver un… arrangement.",shape=box,color=blue];
		j3418809946 -> j544237987;
		j3418809946 -> j3847337393;
		j3418809946 -> j2605773150;
	j553230123 [label="Je suis assis ici et deux choses me frappent immédiatement:",shape=box,color=blue];
		j553230123 -> j1123215011;
	j3994855101 [label="Il m'a abandonné là, dans une époque immémoriale, dans un trou perdu au fin fond du Système Origine! Sais-tu que cette \"Cathédrale\" oubliée du Néant n'avait même pas encore l'électricité?! L'électricité!",shape=box,color=blue];
		j3994855101 -> j3346358032;
	j3495306657 [label="Qu'est-ce qui t'a posé problème avec lui? Peut-être pourrions-nous trouver un arrangement?",shape=box,color=blue];
		j3495306657 -> j1302134513;
	j2484850022 [label="Mais dis-moi, qu'est-ce qui t'a tant posé problème avec elle? Peut-être pourrions-nous trouver un… arrangement?",shape=box,color=blue];
		j2484850022 -> j256724246;
	j3625184363 [label="Ah! C'est génial! Tu as toute mon attention, maintenant… de quelle manière? Hum? Dis-moi… n'aie pas peur. Peut-être pourrions-nous trouver un… arrangement.",shape=box,color=blue];
		j3625184363 -> j2004525054;
	j738571875 [label="Je suis assis ici et deux choses me frappent immédiatement:",shape=box,color=blue];
		j738571875 -> j3144175772;
	j544237987 [label="Lyon...",shape=box,color=red];
		j544237987 -> j3188022609;
	j3847337393 [label="Marie...",shape=box,color=red];
		j3847337393 -> j2665728912;
	j2605773150 [label="Toi...",shape=box,color=red];
		j2605773150 -> j2220157938;
	j1123215011 [label="Je me demande… Combien de combats aurais-je pu remporter sur le champ de bataille et recommencer, si j’avais eu un tel pouvoir?",shape=box,color=blue];
		j1123215011 -> j3308079382;
	j3346358032 [label="As-tu la moindre idée de la difficulté que représentait la rétro-ingénierie d'un Helminth sans électricité?!",shape=box,color=blue];
		j3346358032 -> j676580727;
		j3346358032 -> j896516330;
