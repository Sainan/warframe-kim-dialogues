		j1549462055 -> j123878238;
	j570250691 [label="Et, plus important encore, je ferai en sorte que tu atteignes ton objectif de nous unir, le moment venu… et je m’en réjouis d'avance…",shape=box,color=blue];
		j570250691 -> j2990566666;
	j2136035801 [label="Non. Non, absolument pas!",shape=box,color=red];
		j2136035801 -> j1154141753;
	j2655678940 [label="Je... ne vais pas échouer? Loid va retrouver sa famille? Quoi qu'il arrive?",shape=box,color=red];
		j2655678940 -> j1312820418;
	j2316497707 [label="Boolean RoatheXata1 is now true.",color=orange];
		j2316497707 -> j546608728;
	j2555727097 [label="Disons simplement que je n'ai pas entamé le processus l'année même de mon départ, hein? Eh bien, nous y voilà. Albrecht, malgré tous ses efforts, n'a pas réussi à m'abandonner dans cet enfer.",shape=box,color=blue];
		j2555727097 -> j871912119;
