	j2113852420 [label="Combien d'esprits aurais-je profanés si j'avais eu tes talents à ma disposition?",shape=box,color=blue];
		j2113852420 -> j96824022;
	j2032617910 [label="Et, plus important encore, je ferai en sorte que tu réussisses, cette fois-ci, à réunir le majordome d'Albrecht et sa famille, quoi qu'il arrive.",shape=box,color=blue];
		j2032617910 -> j1496035626;
