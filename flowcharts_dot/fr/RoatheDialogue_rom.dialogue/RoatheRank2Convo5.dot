digraph {
	1224 [label="RoatheRank2Convo5 begins.",color=orange];
		1224 -> 1225;
	1225 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1225 -> 1226 [label=true,color=green];
		1225 -> 1227 [label=false,color=brown];
	1226 [label="Check boolean RoatheKnowsReset2",color=orange];
		1226 -> 1229 [label=true,color=green];
		1226 -> 1228 [label=false,color=brown];
	1227 [label="Chat ends.",color=orange];
	1229 [label="Que t'a révélé le Roathe du passé sur ses relations avec l'Exécutrice Nitokh? Pff. J'essaie de comprendre: que mon ancien moi t'ait confié des informations aussi personnelles… pour que tu les effaces complètement de ma mémoire?",shape=box,color=blue];
		1229 -> 1232;
	1228 [label="Evaluate expressions on HellStory",color=orange];
		1228 -> 1231 [label="x >= 1",color=purple];
		1228 -> 1230 [label="x <= 1",color=purple];
		1228 -> 1230 [label="false",color=purple];
	1232 [label="Cela me fait terriblement mal. Que j'aie pu tout te dire, absolument tout te dévoiler, jusqu'au plus profond de mon âme et que tu… aies tout effacé. Comme si je n'étais rien de plus pour toi qu'un jouet.",shape=box,color=blue];
		1232 -> 1234;
	1231 [label="Tu m'as déjà entendu parler de l'Exécutrice Nitokh. Et de mes... relations avec elle. Tu dois comprendre que l'Empire Orokin n'était pas entièrement mauvais.",shape=box,color=blue];
		1231 -> 1233;
	1230 [label="Chat ends.",color=orange];
	1234 [label="C'est bien normal, je suppose. C'est ainsi que nous, les Orokins, traitions l'humanité, n'est-ce pas? Le Théâtre Yuvan? Faire parader de belles chairs et choisir nos nouveaux corps à notre guise, nous torturer les uns les autres avec des jeux malsains, selon notre bon vouloir…",shape=box,color=blue];
		1234 -> 1236;
	1233 [label="Cela me brise le cœur que sa dévastation et sa dépravation soient les seuls souvenirs qu'on en garde. Oui, il y en avait à foison, je ne le conteste pas. ",shape=box,color=blue];
		1233 -> 1235;
	1236 [label="Je déteste ça. Je déteste tellement ça.",shape=box,color=blue];
		1236 -> 1239;
		1236 -> 1240;
		1236 -> 1238;
	1235 [label="Mais il était aussi capable d'une telle beauté, d'une telle joie, d'un tel amour, de tels progrès scientifiques et artistiques. Regarde ce que nous étions capables d'accomplir! ",shape=box,color=blue];
		1235 -> 1237;
	1239 [label="Même si je n'avais pas l'intention de te blesser ainsi et que je regrette de l'avoir fait, si cela t'a appris ce que c'était que d'être de l'autre côté de l'Empire Orokin, c'est une leçon précieuse.",shape=box,color=red];
		1239 -> 1245;
	1240 [label="Je n'ai jamais voulu te blesser à ce point-là. Tu n'as pas à t'excuser pour le fonctionnement de la société Orokin; tu ne l'as pas créée. Tu essayais simplement de la sauver.",shape=box,color=red];
		1240 -> 1246;
	1238 [label="[Fin.]",shape=box,color=red];
		1238 -> 1244;
	1237 [label="Alors, quand Nitokh m'a convoqué et m'a annoncé son intention d'exterminer tous les Orokins, j'ai immédiatement accepté. Je voulais trancher la tête du serpent venimeux. Je voulais tout remplacer par un système plus clément. Un dirigeant plus clément.",shape=box,color=blue];
		1237 -> 1241;
		1237 -> 1242;
		1237 -> 1243;
	1245 [label="Add 3 to Thermostat",color=orange];
		1245 -> 1250;
	1246 [label="Add -3 to Thermostat",color=orange];
		1246 -> 1251;
	1244 [label="Chat ends.",color=orange];
	1241 [label="Tu voulais remplacer les Empereurs et les Exécuteurs par toi-même, c'est ça?",shape=box,color=red];
		1241 -> 1247;
	1242 [label="Et qui devait être ce dirigeant?",shape=box,color=red];
		1242 -> 1248;
	1243 [label="[Fin.]",shape=box,color=red];
		1243 -> 1249;
	1250 [label="L'Empire Orokin n'était pas entièrement mauvais. Cela me brise le cœur que sa dévastation et sa dépravation soient les seuls souvenirs qu'on en garde. Oui, cela a existé, je ne le conteste pas. ",shape=box,color=blue];
		1250 -> 1253;
	1251 [label="Si seulement les autres avaient pu le voir ainsi. Si seulement Nitokh l'avait vu ainsi. ",shape=box,color=blue];
		1251 -> 1254;
	1247 [label="Mais oui, bien sûr!",shape=box,color=blue];
		1247 -> 1252;
	1248 [label="Moi, bien sûr.",shape=box,color=blue];
		1248 -> 1252;
	1249 [label="Chat ends.",color=orange];
	1253 [label="Mais il était aussi capable d'une telle beauté, d'une telle joie, d'un tel amour, de tels progrès scientifiques et artistiques. Regarde ce que nous étions capables d'accomplir! ",shape=box,color=blue];
		1253 -> 1256;
	1254 [label="L'Empire Orokin n'était pas entièrement mauvais. Cela me brise le cœur que sa dévastation et sa dépravation soient les seuls souvenirs qu'on en garde. Oui, cela a existé, je ne le conteste pas. ",shape=box,color=blue];
		1254 -> 1253;
	1252 [label="Je veillerais à ce que tous les Exécuteurs et les Empereurs soient... destitués, et je prendrais la relève en tant qu'Exécuteur intérimaire jusqu'à ce qu'un nouveau système puisse être mis en place.",shape=box,color=blue];
		1252 -> 1255;
	1256 [label="Alors, quand Nitokh m'a convoqué et m'a annoncé son intention d'exterminer tous les Orokins, j'ai immédiatement accepté. Je voulais trancher la tête du serpent venimeux. Je voulais tout remplacer par un système plus clément. Un dirigeant plus clément.",shape=box,color=blue];
		1256 -> 1260;
		1256 -> 1261;
	1255 [label="Je ne sais pas combien de temps cela prendrait, mais ce serait mieux que ce qui a suivi la Grande Guerre, n'est-ce pas?",shape=box,color=blue];
		1255 -> 1257;
		1255 -> 1258;
		1255 -> 1259;
	1260 [label="Tu voulais remplacer les Empereurs et les Exécuteurs par toi-même, c'est ça?",shape=box,color=red];
		1260 -> 1265;
	1261 [label="Et qui devait être ce dirigeant?",shape=box,color=red];
		1261 -> 1266;
	1257 [label="Grande Guerre?",shape=box,color=red];
		1257 -> 1262;
	1258 [label="Sois honnête avec toi-même, penses-tu que tu aurais jamais renoncé au pouvoir?",shape=box,color=red];
		1258 -> 1263;
	1259 [label="Je ne pense pas que tu aurais jamais renoncé au pouvoir, Roathe.",shape=box,color=red];
		1259 -> 1264;
	1265 [label="Mais oui, bien sûr! Et ne fais pas semblant de ne jamais avoir entendu ça, je suis certain du contraire. ",shape=box,color=blue];
		1265 -> 1270;
	1266 [label="Moi, bien sûr. Et ne fais pas semblant de ne jamais avoir entendu ça, je suis certain du contraire.",shape=box,color=blue];
		1266 -> 1270;
	1262 [label="Vous l'appelez maintenant \"l'Ancienne Guerre\". Pour moi, elle n'est guère \"ancienne\", elle ne date que d'il y a quelques années, si je ne me trompe pas.",shape=box,color=blue];
		1262 -> 1267;
	1263 [label="Mm. Je ne sais pas. Cela n'a plus vraiment d'importance, n'est-ce pas? Mais à l'époque, j'en étais absolument convaincu.",shape=box,color=blue];
		1263 -> 1268;
	1264 [label="+5 Chemistry",color=orange];
		1264 -> 1269;
	1270 [label="Je veillerais à ce que tous les Exécuteurs et les Empereurs soient... destitués et je prendrais la relève en tant qu'Exécuteur intérimaire jusqu'à ce qu'un nouveau système puisse être mis en place.",shape=box,color=blue];
		1270 -> 1274;
	1267 [label="Les voyages dans le temps, c'est bizarre.",shape=box,color=blue];
		1267 -> 1271;
	1268 [label="J'ai tout fait pour revenir ici, pour finalement réaliser que… mon peuple est mort. J'aurais été exécuté avec eux.",shape=box,color=blue];
		1268 -> 1272;
	1269 [label="Silence, toi.",shape=box,color=blue];
		1269 -> 1273;
	1274 [label="Je ne sais pas combien de temps cela prendrait, mais ce serait mieux que ce qui a suivi la Grande Guerre, n'est-ce pas?",shape=box,color=blue];
		1274 -> 1258;
		1274 -> 1259;
		1274 -> 1257;
	1271 [label="En quelques années seulement, selon mon ressenti, des milliers de personnes sont décédées dans la \"réalité\", là où l'Empire s'est effondré et où mon peuple a péri. ",shape=box,color=blue];
		1271 -> 5775;
	1272 [label="Les Tennos m'auraient massacré avec tous les autres, la nuit des Tambours Naga. J'aurais probablement péri en tentant de sauver Nitokh.",shape=box,color=blue];
		1272 -> 1275;
	1273 [label="À l'époque, j'en étais absolument convaincu. Mais maintenant, cela n'a plus vraiment d'importance, n'est-ce pas?",shape=box,color=blue];
		1273 -> 1268;
	5775 [label="I have come to realize that it does not matter if I would have surrendered power or not, though in the time I was convinced I would.",shape=box,color=blue];
		5775 -> 1272;
	1275 [label="Je me demande ce qu'elle est devenue? Les archives ne mentionnent même pas son nom… toutes les horreurs commises en son nom, toutes les morts, toutes les tragédies… et je suis peut-être le seul à les connaître.",shape=box,color=blue];
		1275 -> 1276;
	1276 [label="Bon. Sans parler de tout ce qui pourrait être débloqué à l'avenir grâce à la tête du Tenno et à ces Ténèbres Réfractaires. Mais ce n'est pas vraiment mon problème.",shape=box,color=blue];
		1276 -> 1277;
		1276 -> 1278;
		1276 -> 1279;
	1277 [label="Tu sembles avoir un peu peur de l'enfant.",shape=box,color=red];
		1277 -> 1280;
	1278 [label="Que s'est-il passé entre Nitokh et toi?",shape=box,color=red];
		1278 -> 1281;
	1279 [label="Tu avais donc l'intention de trahir les Orokins?",shape=box,color=red];
		1279 -> 1282;
	1280 [label="J'ai vu une bande d'écoliers, ravagés par le Néant, piloter des machines de guerre Infestées qui avaient été des soldats et qui étaient maintenant transformées en œuvres d'art grotesques, belles et meurtrières pour détruire des bataillons entiers de soldats. ",shape=box,color=blue];
		1280 -> 1283;
	1281 [label="Tout.",shape=box,color=blue];
		1281 -> 1284;
	1282 [label="Oui. Nous l'avions prévu tous les deux. Je crois que Nitokh voulait me trahir et je comptais aussi la trahir. Tu sais comment ça se passe chez les Orokins.",shape=box,color=blue];
		1282 -> 1285;
	1283 [label="Je les ai vus détruire mon empire. Un empire qui dominait tout le Système Origine. Et qui était sur le point d'anéantir la rébellion sur Tau.",shape=box,color=blue];
		1283 -> 1286;
	1284 [label="Il s'est passé tout entre Nitokh et moi.",shape=box,color=blue];
		1284 -> 1287;
	1285 [label="Tout le monde complote toujours contre tout le monde. C'est le train-train quotidien, en somme.",shape=box,color=blue];
		1285 -> 1288;
	1286 [label="Et ils l'ont fait en une nuit.",shape=box,color=blue];
		1286 -> 1289;
	1287 [label="Tout et plus encore.",shape=box,color=blue];
		1287 -> 1290;
	1288 [label="Les trahisons entre Orokins étaient monnaie courante. Mais trahir l'Empire tout entier? Un tel acte de trahison méritait non seulement une exécution par Lumière de Jade, mais aussi un passage assuré au Programme Céphalon.",shape=box,color=blue];
		1288 -> 1291;
	1289 [label="Et toi, tu n'aurais pas peur?!",shape=box,color=blue];
		1289 -> 1292;
	1290 [label="Et c'est tout ce que je souhaite dire à ce sujet pour le moment.",shape=box,color=blue];
		1290 -> 1293;
	1291 [label="Update boolean RoatheTraitor1",color=orange];
		1291 -> 1294;
		1291 -> 1295;
	1292 [label="Je ne saurais exprimer ce que nous risquions en tentant d'assassiner les Exécuteurs, sans parler de tous les Orokins, Usurpateur.",shape=box,color=blue];
		1292 -> 1288;
	1293 [label="Update boolean RoatheExecutor1",color=orange];
		1293 -> 1292;
	1294 [label="Lequel était le pire?",shape=box,color=red];
		1294 -> 1296;
	1295 [label="Ce genre de stratagème n'était donc pas normal?",shape=box,color=red];
		1295 -> 1297;
	1296 [label="Le programme Céphalon de Nihil, et de loin. Les créations du Chagall sont…",shape=box,color=blue];
		1296 -> 1298;
	1297 [label="L'existence de l'Empire Orokin ne tenait qu'à un fil, Usurpateur. Il vacillait constamment au bord du gouffre. Une seule chose le maintenait en vie:",shape=box,color=blue];
		1297 -> 1299;
	1298 [label="La Lumière de Jade terrasse rapidement ceux qui n'ont ni armure ni bouclier. C'est une mort miséricordieuse.",shape=box,color=blue];
		1298 -> 1300;
	1299 [label="Les normes sociétales.",shape=box,color=blue];
		1299 -> 1301;
	1300 [label="Les Céphalons, lorsqu'ils sont créés à partir d'un sujet consentant, ne souffrent pas. Cependant… lorsqu'ils sont créés à des fins punitives?",shape=box,color=blue];
		1300 -> 1302;
	1301 [label="On ne peut pas se soulever pour massacrer les Orokins! C'est tout simplement impensable, Voyageur! Impensable! Absolument ridicule!",shape=box,color=blue];
		1301 -> 1303;
	1302 [label="Pour les Orokins, Voyageur, les souvenirs sont sacrés. Ils sont tout ce que nous sommes, au final. Nos corps sont éphémères. Nos visages, nos voix, notre sang, tout est malléable. Tout peut être changé facilement.",shape=box,color=blue];
		1302 -> 1304;
	1303 [label="Ce qui, au final, a rendu la chose ridiculement facile. Comme ton double Tenno l'a sans doute appris à ses dépens. ",shape=box,color=blue];
		1303 -> 1305;
		1303 -> 1306;
	1304 [label="Check boolean RoatheKnowsReset2",color=orange];
		1304 -> 1307 [label=true,color=green];
		1304 -> 1305 [label=false,color=brown];
		1304 -> 1306 [label=false,color=brown];
	1305 [label="Mais tu n'es visiblement jamais allé assez loin pour tenter ta chance.",shape=box,color=red];
		1305 -> 1308;
	1306 [label="Qu'est-il advenu de ton plan?",shape=box,color=red];
		1306 -> 1309;
	1307 [label="Ce qui, soit dit en passant, explique probablement pourquoi je suis si profondément et absolument irrité que tu joues avec eux.",shape=box,color=blue];
		1307 -> 1305;
		1307 -> 1306;
	1308 [label="Evaluate expressions on HellStory",color=orange];
		1308 -> 1310 [label="x >= 21",color=purple];
		1308 -> 1311 [label="x < 21",color=purple];
		1308 -> 1311 [label="false",color=purple];
	1309 [label="Evaluate expressions on HellStory",color=orange];
		1309 -> 1312 [label="x >= 21",color=purple];
		1309 -> 5777 [label="x < 21",color=purple];
		1309 -> 5777 [label="false",color=purple];
	1310 [label="Tu as tout à fait raison! Albrecht m'a croisé dans ce couloir avant même que Nitokh et moi ayons eu le temps de tendre notre piège aux Exécuteurs.",shape=box,color=blue];
		1310 -> 1313;
	1311 [label="Non, clairement pas. J'ai été transformé de force en cette... chose par Albrecht avant que Nitokh et moi ayons eu le temps de tendre notre piège aux Exécuteurs.",shape=box,color=blue];
		1311 -> 1314;
	1312 [label="Tu sais très bien ce qui est arrivé à notre plan, n'est-ce pas?! Albrecht m'a croisé dans ce couloir avant même que Nitokh et moi ayons eu le temps de tendre notre piège aux Exécuteurs.",shape=box,color=blue];
		1312 -> 1315;
	5777 [label="I was forcibly turned into this... thing by Albrecht before Nitokh and I had time to spring our trap for the Executors.",shape=box,color=blue];
		5777 -> 1314;
	1313 [label="Et il m'a proposé le sérum de Protoframe. Et... eh bien... nous savons tous les deux ce qu'il s'est passé ensuite.",shape=box,color=blue];
		1313 -> 1316;
	1314 [label="Un instant, je me souviens que je me tenais dans un grand couloir doré et l'instant d'après, je hurlais de douleur dans un trou perdu de la Gaule.",shape=box,color=blue];
		1314 -> 1317;
	1315 [label="Il m'a proposé le sérum de Protoframe et nous savons tous les deux ce qu'il s'est passé ensuite!",shape=box,color=blue];
		1315 -> 1316;
	1316 [label="Une affaire qui me rend encore furieux. Furieux. Contre moi-même. Pourquoi?! Pourquoi t'ai-je avoué ça?! Comment sais-tu ça?! ",shape=box,color=blue];
		1316 -> 1318;
	1317 [label="Nitokh a dû abandonner son plan une fois que j'ai disparu. Sans doute m'a-t-elle fait porter le chapeau pour toute cette affaire de trahison, me désignant comme bouc émissaire.",shape=box,color=blue];
		1317 -> 1319;
	1318 [label="Bah! Non. Laisse tomber. Je m'en vais maintenant, avant de casser ce satané ordinateur dans un accès de rage.",shape=box,color=blue];
		1318 -> 1320;
	1319 [label="Cela explique tous les documents que je trouve me traitant de \"lâche\". Bien sûr qu'ils me prennent pour un lâche! Ils croient que j'ai fui! Pfff.",shape=box,color=blue];
		1319 -> 1321;
	1320 [label="+10 Chemistry",color=orange];
		1320 -> 1322;
	1321 [label="+10 Chemistry",color=orange];
		1321 -> 1323;
	1322 [label="Chat ends.",color=orange];
	1323 [label="C'est agréable de savoir que j'étais si important pour ce plan qu'il a dû être entièrement abandonné une fois que je suis parti.",shape=box,color=blue];
		1323 -> 1324;
		1323 -> 1325;
	1324 [label="Est-ce vraiment le principal enseignement à tirer de tout cela?",shape=box,color=red];
		1324 -> 1326;
	1325 [label="C'est agréable de se sentir utile.",shape=box,color=red];
		1325 -> 1327;
	1326 [label="Add 1 to Thermostat",color=orange];
		1326 -> 1328;
	1327 [label="+5 Chemistry",color=orange];
		1327 -> 1329;
	1328 [label="Trouve ta valeur où tu veux, Voyageur, et laisse-moi trouver la mienne.",shape=box,color=blue];
		1328 -> 1330;
	1329 [label="Add -1 to Thermostat",color=orange];
		1329 -> 1331;
	1330 [label="Chat ends.",color=orange];
	1331 [label="Tu vois? Tu comprends.",shape=box,color=blue];
		1331 -> 1332;
	1332 [label="Chat ends.",color=orange];
}