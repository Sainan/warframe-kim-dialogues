	j3645397232 [label="Usurpateur, j'ai le plaisir de t'annoncer que ton travail dans les Ténèbres Réfractaires est terminé et que tu peux cesser de déterrer mes souvenirs.",shape=box,color=blue];
		j3645397232 -> j754259176;
	j1568308109 [label="Usurpateur, bien qu'il reste encore du travail à accomplir dans les Ténèbres Réfractaires pour recouvrer mes souvenirs, je suis heureux d'annoncer que je pense en avoir fini avec toute cette satanée affaire.",shape=box,color=blue];
		j1568308109 -> j754259176;
	j2729147528 [label="Usurpateur, même si tu as honnêtement fait preuve de... négligence en ne commençant aucun travail lié aux Ténèbres Réfractaires, je suis heureux d'annoncer que je pense en avoir fini avec toute cette satanée affaire.",shape=box,color=blue];
		j2729147528 -> j3025695493;
	j3361259845 [label="Même si tu penses mériter des remerciements et des excuses pour ce qui s'est passé, le fait que je te demande d'effacer mes souvenirs et de recommencer à zéro nous met simplement à égalité pour toute la douleur que j'ai subie.",shape=box,color=blue];
		j3361259845 -> j4190449046;
		j3361259845 -> j4278671341;
	j3057128279 [label="Toute cette course effrénée est d'une telle vacuité. Je suppose que tu peux comprendre. Bon. Allons jusqu'au bout, d'accord?",shape=box,color=blue];
		j3057128279 -> j4190449046;
		j3057128279 -> j3088076197;
	j3564944586 [label="Usurpateur, j'ai une requête difficile à te soumettre. Une requête qui ne me procure aucun plaisir. Je sais, à tout le moins, que tu me désires et j'espère qu'une place dans ton cœur s'est réchauffée à mon égard...",shape=box,color=blue];
		j3564944586 -> j3989210287;
		j3564944586 -> j2077749156;
		j3564944586 -> j1751925664;
	j2543147015 [label="Usurpateur, j'ai une requête difficile à te soumettre. Une requête qui ne me procure aucun plaisir. Mais d'abord, je te demanderai… sommes-nous devenus amis? Y a-t-il dans ton cœur une place qui me soit réservée?",shape=box,color=blue];
		j2543147015 -> j3768635820;
		j2543147015 -> j1830396213;
		j2543147015 -> j1969373809;
	j754259176 [label="Nous pouvons en finir avec ces excursions dans mon esprit et cette flagellation virtuelle, n'est-ce pas? (Même si le prêtre y prend plaisir.)",shape=box,color=blue];
		j754259176 -> j1253567582;
	j3025695493 [label="Tu peux oublier tout ça, maintenant. Je suis certain que tu as mieux à faire de ta journée que de t'adonner à une telle flagellation fictive, n'est-ce pas? (Même si le prêtre y prend plaisir.)",shape=box,color=blue];
		j3025695493 -> j3077456970;
	j4190449046 [label="Nous y arriverons.",shape=box,color=red];
		j4190449046 -> j2263538772;
	j4278671341 [label="Je ne l'ai fait que parce que tu me l'as demandé, Roathe. Tu avais prévenu que tu serais en colère. ",shape=box,color=red];
		j4278671341 -> j3472593102;
	j3088076197 [label="Nous y sommes presque, comme tu l'as dit.",shape=box,color=red];
		j3088076197 -> j3667465297;
	j3989210287 [label="Je tiens à toi, Roathe. La question de savoir si j'ai raison de le penser reste ouverte.",shape=box,color=red];
		j3989210287 -> j1906251416;
	j2077749156 [label="J'ai changé d'avis sur tout ça après avoir appris à mieux te connaître. Je ne peux pas te supporter.",shape=box,color=red];
		j2077749156 -> j1770913902;
	j1751925664 [label="Je tiens beaucoup à toi, Roathe. Vraiment. Je ne sais pas si je devrais, mais… je crois que tu as réussi à me séduire.",shape=box,color=red];
		j1751925664 -> j2224941866;
	j3768635820 [label="C'est... un peu plus que ça. [Avouer vos sentiments.]",shape=box,color=red];
		j3768635820 -> j3869851785;
	j1830396213 [label="J'aimerais croire que nous sommes amis. Du moins, de mon point de vue.",shape=box,color=red];
		j1830396213 -> j1997810785;
	j1969373809 [label="Franchement, Roathe? Je ne peux pas te supporter.",shape=box,color=red];
		j1969373809 -> j1400765187;
