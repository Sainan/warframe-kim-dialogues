	j2536080955 [label="Quoi?! Calme-toi. Discutons-en.",shape=box,color=red];
		j2536080955 -> j3792900207;
	j1560055659 [label="Je jure que je n'en savais rien! Et même si ce n'était pas le cas, ça ne changerait rien à ce que je ressens pour toi, Roathe.",shape=box,color=red];
		j1560055659 -> j1753643966;
	j512095839 [label="Déteste-moi si tu veux. Mais je ne ferai rien tant que ce problème ne sera pas résolu.",shape=box,color=red];
