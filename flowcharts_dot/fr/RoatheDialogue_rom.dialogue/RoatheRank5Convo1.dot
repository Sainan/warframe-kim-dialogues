	j4271755533 [label="Et cette définition de moi-même a été entièrement réécrite récemment. Elle s'est imprimée dans ma psyché à l'encre indélébile.",shape=box,color=blue];
		j4271755533 -> j3213828919;
	j729613739 [label="J'ai l'impression que toute ma compréhension de moi-même, les fondements mêmes de mon être, ont été brisés et déchirés comme cette maudite Lua! Réécrits avec une encre qui coule. Lâche!",shape=box,color=blue];
		j729613739 -> j3635848624;
	j1037540051 [label="Tu peux me haïr autant que tu veux, Roathe. Mais j'ai agi de la sorte parce que c'était nécessaire. Tu ne pouvais plus te cacher de la vérité.",shape=box,color=red];
		j1037540051 -> j2331901621;
	j707002345 [label="Pense ce que tu veux de moi. Mais je sais reconnaître une spirale quand j'en vois une.",shape=box,color=red];
