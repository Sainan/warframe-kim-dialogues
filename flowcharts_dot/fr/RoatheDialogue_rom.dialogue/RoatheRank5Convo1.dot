		j1927289224 -> j3954529622;
	j759129708 [label="Si tu veux tracer ta propre voie toi-même? N'hésite pas. Fais-le. Ne t'excuse pas. Mais c'est ta voie et celle de personne d'autre.",shape=box,color=red];
		j759129708 -> j3254353260;
	j3442198685 [label="Si tu veux obtenir mon pardon, fais-le. Mais tu dois le vouloir. Tu dois choisir cette voie. Personne d'autre ne le peut.",shape=box,color=red];
		j3442198685 -> j1691803183;
	j3497274665 [label="Qui suis-je...?",shape=box,color=blue];
		j3497274665 -> j3382199802;
	j2663270846 [label="Qui suis-je...?",shape=box,color=blue];
		j2663270846 -> j4148371791;
	j2915730692 [label="Et donc, notre attachement au temps. Je te le demande maintenant. Non, je t'en supplie, utilise-le pour moi. Libère-moi de ces pensées. Libère-moi de ces souvenirs.",shape=box,color=blue];
		j2915730692 -> j1074110842;
	j3121067300 [label="Très bien. Qu'il en soit ainsi. Je ne te demanderai pas cela maintenant. Mais si tu ne l'as jamais fait par simple amusement, par curiosité ou pour tenter de corriger des erreurs commises dans tes relations avec d'autres?!",shape=box,color=blue];
		j3121067300 -> j1074110842;
	j1031221984 [label="C'est donc ma décision de consacrer le reste de mes jours à réparer tous les torts que mon misérable peuple a jugé bon de causer à ce système depuis la nuit des temps. ",shape=box,color=blue];
		j1031221984 -> j1202501508;
	j808623939 [label="Mes plans et mes desseins pour le pouvoir m'appartiennent entièrement. Et toi, Voyageur, tu les dirigeras… si tu le souhaites.",shape=box,color=blue];
		j808623939 -> j2932798263;
