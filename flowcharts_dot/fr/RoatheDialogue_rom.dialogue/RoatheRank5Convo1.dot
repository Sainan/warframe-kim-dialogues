	j4287982041 [label="Toi.",shape=box,color=blue];
		j4287982041 -> j536222722;
	j3552899723 [label="Ce n'était pas...",shape=box,color=blue];
		j3552899723 -> j4057027559;
	j13191563 [label="Ah oui, le classique \"affronte-le\". Comme je l'ai fait quand j'ai pris le sérum d'Entrati et que j'ai fui mon destin comme un lâche?!",shape=box,color=blue];
		j13191563 -> j4145763526;
		j13191563 -> j1420856683;
	j4093515227 [label="Excuse-moi si j'ai beaucoup de mal à le croire. Nous sommes définis par certains moments de notre vie. Nous ne sommes qu'une suite de souvenirs qui nous mènent au suivant. C'est pourquoi les souvenirs sont - étaient - si sacrés pour les Orokins.",shape=box,color=blue];
		j4093515227 -> j4271755533;
	j2593184215 [label="Tu oses – tu oses me parler de \"rester calme\"! Tu ne crois pas que j'ai absolument tous les droits de me sentir déchiré en deux?!",shape=box,color=blue];
		j2593184215 -> j729613739;
	j3530050147 [label="Fascinant. Fascinant et inattendu. Explique-toi.",shape=box,color=blue];
		j3530050147 -> j1037540051;
		j3530050147 -> j707002345;
	j3967945101 [label="Je ne sais plus qui je suis, maintenant...",shape=box,color=blue];
