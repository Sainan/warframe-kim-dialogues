		j1481767005 -> j2663270846;
	j3195451756 [label="Tu as un don. Celui de pouvoir remonter le temps. De le faire tourbillonner, voire d'en faire une boucle. Et cela a… un effet intéressant sur l’esprit des Protoframes, de par le lien avec l’Infestation et le temps. ",shape=box,color=blue];
		j3195451756 -> j2915730692;
	j2837752990 [label="Si tu me dis que tu n'as jamais utilisé tes dons pour manipuler l'esprit des Protoframes que tu appelles amis et amants, et si tu le dis en jurant sur ton âme?",shape=box,color=blue];
		j2837752990 -> j3121067300;
	j3236110721 [label="Je suis le dernier des Orokins. Je règne en maître parmi eux jusqu'à ce que quiconque ose me défier. Et je serai maître de mes propres affaires jusqu'à mon dernier souffle.",shape=box,color=blue];
		j3236110721 -> j1031221984;
	j2876287301 [label="Je suis le dernier des Orokins. Je règne en maître parmi eux jusqu'à ce que quiconque ose me défier. Et je serai maître de mes propres affaires jusqu'à mon dernier souffle.",shape=box,color=blue];
