	j67957372 [label="Tu m'as donné ta parole. Ta parole! Mais maintenant, je découvre que tu n'es que mensonges!",shape=box,color=blue];
		j67957372 -> j602215237;
		j67957372 -> j61742939;
	j1967574981 [label="J'aurais dû m'en douter. J'aurais dû me méfier de toi, anomalie née du Néant! Savais-tu ce qui m'attendait là-bas?! Connaissais-tu la vérité alors que je l'ignorais?!",shape=box,color=blue];
		j1967574981 -> j1164811319;
		j1967574981 -> j790732541;
	j1202553128 [label="Et nous voilà au point de départ. En train de piétiner une fois de plus les corps de notre passé. Pas plus avancés qu'avant.",shape=box,color=blue];
		j1202553128 -> j2021281987;
	j3691270665 [label="Pour des raisons qui ne sont absolument pas de mon fait, semble-t-il! Pourtant, je me souviens encore de l'angoisse que m'a procuré la décision de prendre ce sérum.",shape=box,color=blue];
		j3691270665 -> j2021281987;
	j2816634577 [label="Et nous voilà au point de départ. En train de piétiner une fois de plus les corps de notre passé. Pas plus avancés qu'avant.",shape=box,color=blue];
		j2816634577 -> j1739839331;
	j3231393004 [label="Pour des raisons qui ne sont absolument pas de mon fait, semble-t-il! Pourtant, je me souviens encore de l'angoisse que m'a procuré la décision de prendre ce sérum.",shape=box,color=blue];
		j3231393004 -> j1739839331;
	j2878800392 [label="Tu m'as dit des mots que je ne croyais pas possibles. Dis-moi encore une fois qu'ils étaient vrais. Répète-les-moi. Je t'en prie. J'en ai besoin maintenant. Plus que jamais.",shape=box,color=blue];
		j2878800392 -> j3224342910;
		j2878800392 -> j2494092804;
	j2848895007 [label="Tu m'as donné ta parole. Ta parole! Si joliment enrobée de mots doux. Mais maintenant, je découvre que tu n'es que mensonges!",shape=box,color=blue];
		j2848895007 -> j3554376471;
		j2848895007 -> j548482537;
	j2712550503 [label="Tu le savais?! Tu le savais?! Et as-tu trouvé ton chemin jusqu'à mes côtés, murmurant des mots tendres, espérant adoucir le coup qui allait suivre?",shape=box,color=blue];
		j2712550503 -> j1068801326;
