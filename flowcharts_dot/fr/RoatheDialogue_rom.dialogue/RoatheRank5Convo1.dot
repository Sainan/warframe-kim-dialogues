	j1983007972 [label="J'ai deux mots à te dire que tu n'oublieras peut-être pas, car j'ai entendu dire qu'ils te sont assez familiers!",shape=box,color=blue];
		j1983007972 -> j2082392920;
	j3832685309 [label="Permets-moi de te simplifier les choses, alors!",shape=box,color=blue];
		j3832685309 -> j1983007972;
	j2868516070 [label="Est-ce cela dont je souhaitais me libérer, chaque fois que j'avais une envie irrésistible de griffer ma propre peau et de la déchirer?! ",shape=box,color=blue];
		j2868516070 -> j1596650655;
