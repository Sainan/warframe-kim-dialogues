	j3785320134 [label="Oui! Je le veux! S'il te plaît ! Tu l'as déjà fait une fois, pourquoi ne pas recommencer? Ce n'était pas si difficile la première fois, non?",shape=box,color=blue];
		j3785320134 -> j3217487501;
	j3217487501 [label="Tu veux connaître la vérité, Voyageur? La triste et pathétique vérité remplie de vacuité de tout cela?",shape=box,color=blue];
