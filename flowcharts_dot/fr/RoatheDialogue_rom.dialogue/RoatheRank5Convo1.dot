		j2908872284 -> j1047351752;
	j1709655130 [label="Mais ce n'était pas Uriel, n'est-ce pas? Ce n'était pas Uriel qui me donnait la chair de poule et me donnait envie de m'arracher le visage du crâne.",shape=box,color=blue];
