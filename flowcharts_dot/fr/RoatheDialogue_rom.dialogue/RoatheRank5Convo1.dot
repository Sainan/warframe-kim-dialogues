		j1934009866 -> j1944246372 [label="false",color=purple];
	j625909106 [label="Infâme, incompris, anathème. Banni du ciel et abandonné à son sort. Des âmes sœurs, en effet!",shape=box,color=blue];
		j625909106 -> j74336800;
	j3332784297 [label="Je sais que ce n'est pas la première fois que nous traversons cette épreuve. Je me souviens d'y être déjà passé. Et je sais que ce ne sera peut-être pas la dernière. Je te demande sans cesse de t'arrêter ici et de recommencer et cela compte énormément pour moi que tu le fasses.",shape=box,color=blue];
		j3332784297 -> j1132347717;
	j3960730814 [label="Je sais que ce n'est pas la première fois que nous traversons cette épreuve. Je me souviens d'y être déjà passé. Et je sais que ce ne sera peut-être pas la dernière. Je te demande sans cesse de t'arrêter ici et de recommencer et cela compte énormément pour moi que tu le fasses.",shape=box,color=blue];
		j3960730814 -> j2071025981;
	j4165114971 [label="Je sais que ce n'est pas la première fois que nous traversons cette épreuve. Je me souviens d'y être déjà passé. Et je sais que ce ne sera peut-être pas la dernière. Je te demande sans cesse de t'arrêter ici et de recommencer et cela compte énormément pour moi que tu le fasses.",shape=box,color=blue];
		j4165114971 -> j2827232135;
	j164091657 [label="Je dois te féliciter, Usurpateur, d'avoir obéi à ma demande et de ne pas être allé plus loin dans les Ténèbres Réfractaires et mes souvenirs de Descendia. Malgré l'absence de promesse entre nous.",shape=box,color=blue];
		j164091657 -> j3488377731;
	j1930103362 [label="Mon amour, je te félicite d'avoir tenu parole et de ne pas aller plus loin dans la Descendia et les Ténèbres Réfractaires pour récupérer mes derniers souvenirs. Cela compte énormément pour moi.",shape=box,color=blue];
		j1930103362 -> j3343841707;
	j529949691 [label="Mon amour, je te félicite d'avoir obéi à ma demande et de ne pas aller plus loin dans les Ténèbres Réfractaires et mes souvenirs de la Descendia. Cela compte énormément pour moi.",shape=box,color=blue];
		j529949691 -> j3343841707;
	j184822654 [label="Je te félicite d'avoir tenu parole, Usurpateur, et de ne pas aller plus loin dans la Descendia et les Ténèbres Réfractaires pour récupérer mes derniers souvenirs.",shape=box,color=blue];
		j184822654 -> j3731754510;
	j1944246372 [label="Je me dois de te féliciter, Usurpateur, d'avoir obéi à ma demande et de ne pas aller plus loin dans les Ténèbres Réfractaires et mes souvenirs de Descendia. Malgré l'absence de promesse entre nous.",shape=box,color=blue];
		j1944246372 -> j3731754510;
	j74336800 [label="Quand les conscrits arrivèrent, trois énergies s'entremêlèrent en moi, la quatrième ne fut plus si surprenante. Cette chose terrible qui aspirait à me briser comme la croûte des planètes pour se déverser.",shape=box,color=blue];
		j74336800 -> j2057618028;
	j1132347717 [label="Je me souviens de ta promesse. Que j'aie trouvé une place si importante dans ton cœur que tu me maintiennes dans un tel état de purgatoire? Merci, ma petite chose. Merci.",shape=box,color=blue];
		j1132347717 -> j3343841707;
	j2071025981 [label="Que j'aie trouvé une place si importante dans ton cœur que tu me maintiennes dans un tel état de purgatoire? Merci, ma petite chose. Merci.",shape=box,color=blue];
		j2071025981 -> j3343841707;
	j2827232135 [label="Je me souviens de ta promesse. Et que j'aie trouvé en toi une telle amitié, au point de me maintenir dans un tel état de purgatoire? Merci.",shape=box,color=blue];
		j2827232135 -> j3731754510;
	j3488377731 [label="Et que j'aie trouvé en toi une telle amitié, au point de me maintenir dans un tel état de purgatoire? Merci.",shape=box,color=blue];
		j3488377731 -> j3731754510;
	j3343841707 [label="Même si cette idée me taraude encore un peu, c'est comme un kubrow qui aboie au bout de sa laisse. Gérable. Domptable.",shape=box,color=blue];
		j3343841707 -> j3301388421;
	j3731754510 [label="Même si cette idée me taraude encore un peu, c'est comme un kubrow qui aboie au bout de sa laisse. Gérable. Domptable.",shape=box,color=blue];
		j3731754510 -> j2908872284;
