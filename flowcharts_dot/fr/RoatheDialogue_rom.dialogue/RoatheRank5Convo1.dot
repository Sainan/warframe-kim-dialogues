		j2105702422 -> j2462133455;
	j128460324 [label="Très bien. Sois en colère. Mais utilise-la à bon escient. Sers-t'en pour te débarrasser de toute cette haine qui t'habite et que tu diriges dans la mauvaise direction.",shape=box,color=red];
