		j3728327397 -> j1370084335;
	j2222295984 [label="Voyageur, je t'en supplie. Si jamais tu as tenu à moi, si jamais tu as cru à la sincérité de tes paroles, alors je te demande une dernière chose. Et cette requête est dans ton propre intérêt.",shape=box,color=blue];
