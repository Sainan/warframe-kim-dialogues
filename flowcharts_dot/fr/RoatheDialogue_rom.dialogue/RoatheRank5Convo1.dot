		j2412929341 -> j2895595693;
	j3092257967 [label="Je t'avais dit de mettre fin à tes incursions dans mon esprit avant qu'il ne soit trop tard! Je t'avais dit d'arrêter tes agissements et pourtant… et pourtant!",shape=box,color=blue];
		j3092257967 -> j4217693596;
	j3439462494 [label="Tu me l'as caché pour me le révéler seulement maintenant? Tout ça n'était qu'un jeu malsain pour toi?! Nourrir ce qui se cachait en moi, sachant ce qui m'attendait?!",shape=box,color=blue];
		j3439462494 -> j2085840759;
	j513895462 [label="Et maintenant, mon amour? Et maintenant…? Je suis au bout du rouleau. Au moins, avant, j'avais le refuge de mon indignité!",shape=box,color=blue];
		j513895462 -> j421881264;
	j3310765677 [label="Et maintenant, Usurpateur? Et maintenant…? Je suis au bout du rouleau. Au moins, avant, j'avais le refuge de mon indignité!",shape=box,color=blue];
		j3310765677 -> j1335974040;
	j1861171933 [label="Je comprends. Bien mieux que toi, crois-moi. Je comprends.",shape=box,color=blue];
		j1861171933 -> j2256355380;
	j3653055838 [label="Je t'aime, sincèrement. Quelle que soit la forme que tu prennes. Qui que tu choisisses d'être. Je t'aime.",shape=box,color=red];
		j3653055838 -> j3152565738;
	j3457766447 [label="Je t'avais dit de mettre fin à tes incursions dans mon esprit avant qu'il ne soit trop tard! Je t'avais dit d'arrêter tes agissements et pourtant… et pourtant!",shape=box,color=blue];
