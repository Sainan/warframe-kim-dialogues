	j205646454 [label="Je ne voulais pas te mentir, je ne pensais simplement pas que c'était si grave.",shape=box,color=red];
		j205646454 -> j2107903159;
	j3357461834 [label="Je sais que je n'ai pas tenu ma promesse. Je m'en excuse. Mais on peut affronter ça ensemble.",shape=box,color=red];
