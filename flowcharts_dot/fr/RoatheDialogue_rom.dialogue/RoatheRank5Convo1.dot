	j2252222971 [label="Je crois que je porterai ce masque très longtemps. Même si je ne l'apprécie guère. Mais… tu as tout à fait raison.",shape=box,color=blue];
		j2252222971 -> j2611878154;
	j3485697387 [label="Mais devenir la personne que j'ai toujours su pouvoir devenir, libre de toutes contraintes? Oui. Oui, en cela, je trouverais une grande joie.",shape=box,color=blue];
		j3485697387 -> j1494230535;
	j3915182635 [label="Je t'accorde donc une autre chance de me convaincre. En fait, je te permets de choisir le chemin qu'on devra prendre. Ma part du marché est remplie. N'oublie pas, cela dit, que tu as une dette envers le diable. Et je récupérerai mon dû.",shape=box,color=blue];
