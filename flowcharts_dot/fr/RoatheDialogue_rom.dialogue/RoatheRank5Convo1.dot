	j4040628301 [label="Je sais ce que c'est que de toujours tenter d'échapper à quelque chose dont on a l'impression de ne jamais pouvoir se libérer. D'essayer de fuir quelque chose qui te poursuivra toujours, peu importe où tu vas.",shape=box,color=red];
