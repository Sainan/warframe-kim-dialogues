	"Chat ends." [color=orange];
	j2588166052 [label="Et maintenant, je me souviens, mon cher Voyageur. Je me souviens combien j'ai supplié d'être libéré d'eux. Et comment tu as juré que tu le ferais. Et tu l'as fait.",shape=box,color=blue];
		j2588166052 -> j1202553128;
	j273295478 [label="Et maintenant, je me souviens, mon amour de Voyageur. Maintenant, je me souviens de ce que je t'ai demandé et de ce que tu as refusé de faire. Je t'ai demandé d'effacer ces pensées de mon esprit et tu as dit non. Et pourtant, nous y voilà. N'est-ce pas?",shape=box,color=blue];
		j273295478 -> j3691270665;
