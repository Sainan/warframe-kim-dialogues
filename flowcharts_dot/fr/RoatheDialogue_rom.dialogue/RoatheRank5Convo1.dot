		j4148371791 -> j451385303;
	j1074110842 [label="Je dois oublier le sérum d'Entrati. Ajoute à ça la douleur de tes paroles d'amour non tenues? J'ai tant de souffrances que je voudrais oublier… Je t'en prie.",shape=box,color=blue];
