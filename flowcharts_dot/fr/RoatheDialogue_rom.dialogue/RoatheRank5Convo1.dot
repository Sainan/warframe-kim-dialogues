	j516896999 [label="Mais nous avions un accord, n'est-ce pas? Que lorsque ce moment arriverait, tu irais jusqu'au bout. Et nous y voilà.",shape=box,color=blue];
		j516896999 -> j1450794803;
	j3124417227 [label="Et si j'étais capable de le faire moi-même, crois-tu que je serais encore en train de perdre mon temps avec toi?! Et ce, à deux reprises?!",shape=box,color=blue];
		j3124417227 -> j253787411;
	j3827165860 [label="Non. Si tu veux que le majordome monte les escaliers? Efface tout ça, comme je l’ai demandé. Si cela t'est égal, fais comme bon te semble. Peu m'importe.",shape=box,color=blue];
