digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank4Convo6 begins." [color=orange];
		"RoatheRank4Convo6 begins." -> j3580474852;
	j3580474852 [label="Quelle est ta méthode préférée pour tuer, Usurpateur?",shape=box,color=blue];
		j3580474852 -> j2387975902;
		j3580474852 -> j2259317334;
		j3580474852 -> j2429168889;
	j2387975902 [label="Excuse-moi?",shape=box,color=red];
		j2387975902 -> j2223562364;
	j2259317334 [label="Tu veux vraiment le découvrir?",shape=box,color=red];
		j2259317334 -> j1778403655;
	j2429168889 [label="[Fin.]",shape=box,color=red];
		j2429168889 -> "Chat ends.";
	j2223562364 [label="Je me surprends à philosopher ces derniers temps et je suis tout simplement curieux.",shape=box,color=blue];
		j2223562364 -> j2862102830;
	j1778403655 [label="Ha! Pas vraiment. Bien que… quelques échanges avec toi seraient plutôt amusants. Non, je me surprends à philosopher ces derniers temps et je suis simplement curieux.",shape=box,color=blue];
		j1778403655 -> j2862102830;
	"Chat ends." [color=orange];
	j2862102830 [label="En termes de chiffres, on est probablement à égalité. Quant à la létalité, eh bien… je ne parierais pas et je ne suis pas particulièrement intéressé par une comparaison, même proverbiale, entre deux épées.",shape=box,color=blue];
		j2862102830 -> j3747226594;
	j3747226594 [label="D'un tueur à l'autre. Que préfères-tu? Un affrontement rapproché et personnel? La discrétion ou le chaos du champ de bataille?",shape=box,color=blue];
		j3747226594 -> j4259703597;
		j3747226594 -> j1772243041;
		j3747226594 -> j2904301398;
		j3747226594 -> j2948720933;
	j4259703597 [label="Je préfère le chaos. Les explosions. Les coups de feu. Le bruit. Plus on est de fous, plus on rit.",shape=box,color=red];
		j4259703597 -> j1754887200;
	j1772243041 [label="La furtivité. Je préfère éliminer mon ennemi avant même qu'il ne se rende compte de ma présence. Si je le pouvais, je le ferais là où il dort.",shape=box,color=red];
		j1772243041 -> j1250948255;
	j2904301398 [label="Je déteste me battre. J'aurais préféré ne jamais avoir à le faire.",shape=box,color=red];
		j2904301398 -> j2549140634;
	j2948720933 [label="C'est une conversation malsaine.",shape=box,color=red];
		j2948720933 -> j1609412167;
	j1754887200 [label="Boolean RoatheSoldier is now true.",color=orange];
		j1754887200 -> j4270650251;
	j1250948255 [label="Boolean RoatheAssassin is now true.",color=orange];
		j1250948255 -> j1953572444;
	j2549140634 [label="Oh pauvre, pauvre Usurpateur, si seulement tu avais pu m'entendre rire...",shape=box,color=blue];
		j2549140634 -> j3615910316;
	j1609412167 [label="Alors, n'en parlons plus.",shape=box,color=blue];
		j1609412167 -> "Chat ends.";
	j4270650251 [label="Un vieux soldat comme moi. Vu ton passé, je ne suis pas surpris. Le sang coule toujours à flots derrière toi. D'abord Duviri, puis \"Narmer\" et puis la Höllvanie. Et maintenant, cette affaire.",shape=box,color=blue];
		j4270650251 -> j2245708413;
	j1953572444 [label="Ah, un assassin parmi nous! Si utile et pourtant si sous-estimé. J'ai toujours comparé les assassins à des majordomes de talent.",shape=box,color=blue];
		j1953572444 -> j1250805721;
	j3615910316 [label="Misérable créature démunie, j'espère pour toi que tu me mens.",shape=box,color=blue];
		j3615910316 -> j1333363078;
	j2245708413 [label="Qui sait ce qu'il s'est passé depuis, ou ce que tu as oublié entre-temps? La mort est ton art et tu y peins des mondes.",shape=box,color=blue];
		j2245708413 -> j1576908793;
	j1250805721 [label="Lorsqu'ils font leur travail exceptionnellement bien, ils passent toujours inaperçus.",shape=box,color=blue];
		j1250805721 -> j3915249392;
	j1333363078 [label="+20 Chemistry",color=orange];
		j1333363078 -> j1236204385;
	j1576908793 [label="Alors! Quel est ton pinceau préféré? Voyons cela de plus près.",shape=box,color=blue];
		j1576908793 -> j273718370;
		j1576908793 -> j3952754492;
		j1576908793 -> j924569374;
		j1576908793 -> j2351713726;
	j3915249392 [label="Alors. Dague? Poison? Arc?",shape=box,color=blue];
		j3915249392 -> j2118270517;
		j3915249392 -> j2838531015;
		j3915249392 -> j381151622;
		j3915249392 -> j996159917;
		j3915249392 -> j561469071;
	j1236204385 [label="Sinon, ce serait peut-être la chose la plus triste que j'aie entendue de toute ma vie.",shape=box,color=blue];
		j1236204385 -> j2927459171;
	j273718370 [label="Je me débrouille avec les moyens du bord, honnêtement. J'aime bien improviser.",shape=box,color=red];
		j273718370 -> j2077575195;
	j3952754492 [label="Un arc. Gracieux et mortel.",shape=box,color=red];
		j3952754492 -> j2779881030;
	j924569374 [label="Une lame. J'aime m'approcher au plus près.",shape=box,color=red];
		j924569374 -> j3997902113;
	j2351713726 [label="Fusils et armes à feu. Bruyants, mais efficaces.",shape=box,color=red];
		j2351713726 -> j4158257008;
	j2118270517 [label="Je me débrouille avec les moyens du bord, honnêtement. J'aime bien improviser.",shape=box,color=red];
		j2118270517 -> j2174280549;
	j2838531015 [label="Un arc. Gracieux et mortel.",shape=box,color=red];
		j2838531015 -> j2002433426;
	j381151622 [label="Fusil de précision. Un coup? Un mort.",shape=box,color=red];
		j381151622 -> j3831715220;
	j996159917 [label="Le poison. Je suis déjà ailleurs quand ils réalisent qu'ils sont morts.",shape=box,color=red];
		j996159917 -> j2723069904;
	j561469071 [label="La dague. J'aime son côté intime.",shape=box,color=red];
		j561469071 -> j2214048774;
	j2927459171 [label="Boolean RoatheWeaponNone is now true.",color=orange];
		j2927459171 -> "Chat ends.";
	j2077575195 [label="Je t'imagine dévastant le champ de bataille avec un brancard. Déchiquetant les soldats avec un pneu attaché à un morceau de tuyau tordu.",shape=box,color=blue];
		j2077575195 -> j1397516307;
	j2779881030 [label="Manier un arc au cœur de la bataille exige une détermination et une lucidité que peu possèdent. Et, bien entendu, une main sûre.",shape=box,color=blue];
		j2779881030 -> j2585932116;
	j3997902113 [label="Hum, doucement. Ne m'excite pas trop, Usurpateur. Comme j'aimerais te voir danser sur le champ de bataille, armes à la main, des gerbes de sang comme les pétales d'une fleur épanouie…",shape=box,color=blue];
		j3997902113 -> j1527754519;
	j4158257008 [label="Depuis leur invention, elles ont été les instruments de toutes les guerres, Usurpateur, et ce à juste titre. Cependant, il est indéniable qu'une fois qu'elles touchent leur cible, elles ont accompli leur mission.",shape=box,color=blue];
		j4158257008 -> j3946692362;
	j2174280549 [label="Je t'imagine en train d'assassiner quelqu'un avec un couvert ou un pied de chaise. D'ôter la vie à quelqu'un avec l'embrasse d'un rideau.",shape=box,color=blue];
		j2174280549 -> j490798077;
	j2002433426 [label="La voie du chasseur. Sans prétention, mais élégante dans sa simplicité. Parfois, les méthodes les plus simples et les plus anciennes sont, au fond, les plus efficaces.",shape=box,color=blue];
		j2002433426 -> j1408804098;
	j3831715220 [label="Un peu impersonnel et clinique à mon goût, mais je ne peux pas juger de son efficacité. Il faut reconnaître que le calme a du bon.",shape=box,color=blue];
		j3831715220 -> j287763637;
	j2723069904 [label="Genre sinistre apothicaire, hein? Préparant des teintures et versant des fioles dans les verres des personnes sans méfiance? Ou enduisant ses couteaux et ses balles de venin pour que le moindre coup porté sur le champ de bataille devienne fatal?",shape=box,color=blue];
		j2723069904 -> j4075835239;
	j2214048774 [label="Hum, doucement. Ne m'excite pas trop, Usurpateur. Quelle image intrigante de me réveiller une nuit et de t'apercevoir dans l'ombre, un poignard à la main, sur le point de frapper…",shape=box,color=blue];
		j2214048774 -> j11183523;
	j1397516307 [label="+10 Chemistry",color=orange];
		j1397516307 -> j2243626542;
	j2585932116 [label="Il faut apprécier ce silence. Le bruit de l'encochage d'une flèche, la tension de la corde, l'attente du décochage… puis la douce, la douce mort lorsqu'elle atteint sa cible?",shape=box,color=blue];
		j2585932116 -> j955924270;
	j1527754519 [label="Je comprends ce besoin de contact humain. Voir les membres de ta victime flancher tandis que tu mets fin à ses jours. Voir son corps sans vie s'effondrer devant toi. Savoir que c'est toi et personne d'autre qui l'as fait.",shape=box,color=blue];
		j1527754519 -> j3549543257;
	j3946692362 [label="Désordonné, bruyant, excessivement cher. Mais tellement, tellement efficace pour tuer.",shape=box,color=blue];
		j3946692362 -> j178724137;
	j490798077 [label="+10 Chemistry",color=orange];
		j490798077 -> j855368069;
	j1408804098 [label="Il faut apprécier ce silence. Le bruit de l'encochage d'une flèche, la tension de la corde, l'attente du décochage… puis la douce, la douce mort lorsqu'elle atteint sa cible?",shape=box,color=blue];
		j1408804098 -> j1432549323;
	j287763637 [label="Dans le vacarme apparemment implacable du champ de bataille, le tireur d'élite doit maîtriser son souffle comme la marée de l'océan. Inspirer, expirer et ôter une vie.",shape=box,color=blue];
		j287763637 -> j3860577778;
	j4075835239 [label="J'ai vu des bataillons entiers réduits en bouillie par une simple coupure au bras d'un seul soldat. Une toxine qui se propage du sang aux poumons, puis aux poumons d'un autre et ainsi de suite.",shape=box,color=blue];
		j4075835239 -> j1861975006;
	j11183523 [label="J'apprécie ce besoin de contact humain. Plonger son regard dans les yeux d'autrui et les voir se voiler, s'éteindre, tandis que la lumière décline et que la chaleur quitte son corps.",shape=box,color=blue];
		j11183523 -> j2125697462;
	j2243626542 [label="Je... je n'arrive pas à me décider; est-ce que cela te rend plus ou moins effroyable, Usurpateur? Je crois que je vais opter pour \"plus\". Quoi qu'il en soit, je trouve cela amusant et saisissant en soi.",shape=box,color=blue];
		j2243626542 -> j777855750;
	j955924270 [label="+10 Chemistry",color=orange];
		j955924270 -> j2567311246;
	j3549543257 [label="+10 Chemistry",color=orange];
		j3549543257 -> j894008548;
	j178724137 [label="+10 Chemistry",color=orange];
		j178724137 -> j3679022000;
	j855368069 [label="Je... je n'arrive pas à me décider; est-ce que cela te rend plus ou moins effroyable, Usurpateur? Je crois que je vais opter pour \"plus\". Quoi qu'il en soit, je trouve cela amusant et saisissant en soi.",shape=box,color=blue];
		j855368069 -> j777855750;
	j1432549323 [label="+10 Chemistry",color=orange];
		j1432549323 -> j2733712228;
	j3860577778 [label="+10 Chemistry",color=orange];
		j3860577778 -> j122424966;
	j1861975006 [label="+10 Chemistry",color=orange];
		j1861975006 -> j778724007;
	j2125697462 [label="+10 Chemistry",color=orange];
		j2125697462 -> j2329716749;
	j777855750 [label="Boolean RoatheWeaponImprov is now true.",color=orange];
		j777855750 -> j4076810780;
		j777855750 -> j2657293109;
		j777855750 -> j3757342749;
	j2567311246 [label="Magnifique.",shape=box,color=blue];
		j2567311246 -> j2888608214;
	j894008548 [label="Quel beau moment.",shape=box,color=blue];
		j894008548 -> j918012326;
	j3679022000 [label="Il y a là une certaine forme de beauté.",shape=box,color=blue];
		j3679022000 -> j4290874667;
	j2733712228 [label="Magnifique.",shape=box,color=blue];
		j2733712228 -> j2888608214;
	j122424966 [label="Il y a de la beauté là-dedans.",shape=box,color=blue];
		j122424966 -> j4290874667;
	j778724007 [label="La mort à une telle échelle? Il y a de la beauté là-dedans.",shape=box,color=blue];
		j778724007 -> j3609398078;
	j2329716749 [label="Quel beau moment.",shape=box,color=blue];
		j2329716749 -> j918012326;
	j4076810780 [label="Tu présentes ça comme si c'était une sorte de... une forme d'art.",shape=box,color=red];
		j4076810780 -> j3584172267;
	j2657293109 [label="Je n'aime pas avoir à tuer des gens, Roathe. ",shape=box,color=red];
		j2657293109 -> j2735210475;
	j3757342749 [label="Et toi, qu'est-ce que tu préfères?",shape=box,color=red];
		j3757342749 -> j2405138187;
	j2888608214 [label="Boolean RoatheWeaponBow is now true.",color=orange];
		j2888608214 -> j4076810780;
		j2888608214 -> j2657293109;
		j2888608214 -> j3757342749;
	j918012326 [label="Boolean RoatheWeaponDagger is now true.",color=orange];
		j918012326 -> j4076810780;
		j918012326 -> j2657293109;
		j918012326 -> j3757342749;
	j4290874667 [label="Boolean RoatheWeaponSniper is now true.",color=orange];
		j4290874667 -> j4076810780;
		j4290874667 -> j2657293109;
		j4290874667 -> j3757342749;
	j3609398078 [label="Boolean RoatheWeaponPoison is now true.",color=orange];
		j3609398078 -> j4076810780;
		j3609398078 -> j2657293109;
		j3609398078 -> j3757342749;
	j3584172267 [label="Parce que c'est le cas. Et tu le sais. En fait, la moitié de ton existence repose littéralement sur le concept du meurtre comme forme d'art!",shape=box,color=blue];
		j3584172267 -> j3616953915;
	j2735210475 [label="Ah bon? Vraiment? Prenons un instant pour examiner cela.",shape=box,color=blue];
		j2735210475 -> j921612418;
	j2405138187 [label="Cela a changé récemment. Et cela me dérange énormément.",shape=box,color=blue];
		j2405138187 -> j1623859390;
		j2405138187 -> j500094008;
	j3616953915 [label="Je vois bien ces \"écoles\" que les Tennos utilisent et que tu empruntes par procuration. Sans parler des enseignements des Dax. Ils n'arrêtaient pas de parler sur les canaux de communication, même après qu'on leur ait répété plusieurs fois qu'il s'agissait d'un canal restreint.",shape=box,color=blue];
		j3616953915 -> j1579932565;
	j921612418 [label="Dis-moi quelque chose et réponds-moi honnêtement, s'il te plaît. Car mentir en ce moment nous desservirait tous les deux, mais surtout toi-même.",shape=box,color=blue];
		j921612418 -> j3982775833;
	j1623859390 [label="Changé, comment?",shape=box,color=red];
		j1623859390 -> j986322453;
	j500094008 [label="À cause d'Uriel?",shape=box,color=red];
		j500094008 -> j430352077;
	j1579932565 [label="Si je n'entends plus jamais l'un d'eux me dire \"Je suis une lame\" et \"J'existe pour frapper\", je mourrai heureux, Usurpateur.",shape=box,color=blue];
		j1579932565 -> j4039253410;
	j3982775833 [label="As-tu déjà cherché à t'équiper d'une arme ou d'une Warframe personnalisée selon tes goûts personnels? Peut-être avec une peinture unique, ou un style qui correspond mieux à ton humeur?",shape=box,color=blue];
		j3982775833 -> j901474984;
		j3982775833 -> j708671749;
		j3982775833 -> j1651159628;
	j986322453 [label="J'avais une préférence pour l'épée. Élégante. Rapide. Je pouvais me déplacer sur le champ de bataille et tailler mes ennemis en pièces à bout portant. Le pourpre sur la lame argentée, elle scintillait sous la lueur d'une étoile bleue.",shape=box,color=blue];
		j986322453 -> j2548093740;
	j430352077 [label="Je suppose. Ou peut-être est-ce dû à mes trous de mémoire. Je ne vois pas d'autres raisons possibles.",shape=box,color=blue];
		j430352077 -> j986322453;
	j4039253410 [label="L'humanité a toujours considéré le meurtre comme un péché, mais le fait de tuer comme un art. Cela ne t'a-t-il jamais paru étrange? Manier une lame et terrasser un ennemi au combat revient à être perçu comme un être quasi transcendant.",shape=box,color=blue];
		j4039253410 -> j1306169374;
	j901474984 [label=" J'ai... qu'est-ce que ça a à voir là-dedans?",shape=box,color=red];
		j901474984 -> j931500186;
	j708671749 [label="Non. Jamais.",shape=box,color=red];
		j708671749 -> j3620647090;
	j1651159628 [label="Je ne joue pas à ce jeu-là. [Fin.]",shape=box,color=red];
		j1651159628 -> j2823604950;
	j2548093740 [label="Mais maintenant? Maintenant, je veux goûter le sang sur mes dents. Le sentir jaillir sous mes griffes. Je veux enfoncer mes doigts dans la chair et les os et les déchirer en morceaux.",shape=box,color=blue];
		j2548093740 -> j476041899;
	j1306169374 [label="Tuer un homme avec un morceau de métal aiguisé dans une ruelle, c'est être un lâche et un dégénéré. ",shape=box,color=blue];
		j1306169374 -> j3971963806;
	j931500186 [label="J'apprécie ton honnêteté. Je ne contesterai pas que tu prennes probablement peu de plaisir à commettre un meurtre de sang-froid et que prendre une vie innocente ne soit pas quelque chose qui te réjouisse (bien que peut-être ce soit le cas et que ta déclaration précédente soit un mensonge; quel délice ce serait de le révéler! Mais ce n'est pas le sujet de notre discussion).",shape=box,color=blue];
		j931500186 -> j3839389790;
	j3620647090 [label="Je te demanderai de prendre un long moment de réflexion. J'ai vu tes amis Tennos semer la pagaille dans ce lieu, tels des monstres multicolores sortis d'une arène de cirque cauchemardesque. Comme une bête sauvage tombée dans les pots de pigments d'un artiste. ",shape=box,color=blue];
		j3620647090 -> j912267578;
	j2823604950 [label="Très bien.",shape=box,color=blue];
		j2823604950 -> "Chat ends.";
	j476041899 [label="Je veux boire à pleines gorgées l'ichor tandis que je brise les tendons et que je sens le corps se déchirer sous moi, ne laissant place qu'à des éclats sanglants. L'éplucher comme un fruit sucré, tandis que la moelle s'écoule.",shape=box,color=blue];
		j476041899 -> j649400006;
		j476041899 -> j2803483038;
	j3971963806 [label="Quelle est la différence? \"L’honneur\"? Qui décide de ce qui est honorable et de ce qui ne l’est pas? Le perdant? Le gagnant? Ou est-ce simplement l’existence d’une tradition suffisamment ancrée pour définir ce qui est honorable et ce qui ne l’est pas?",shape=box,color=blue];
		j3971963806 -> j1546226721;
		j3971963806 -> j2586454692;
		j3971963806 -> j558376619;
	j3839389790 [label="À supposer toutefois que ce ne soit pas le cas et que tu tues simplement parce que \"tu dois\", comme tu l'as dit, alors pourquoi, je te prie, passerais-tu du temps à personnaliser tes armes?",shape=box,color=blue];
		j3839389790 -> j3091745658;
	j912267578 [label="Tu n'as jamais ressenti le besoin d'en faire autant? Pas une seule fois? Je te jure que je ne t'en tiendrai pas rigueur pour l'avoir admis.",shape=box,color=blue];
		j912267578 -> j3201239406;
		j912267578 -> j2546199149;
	j649400006 [label="Roathe?",shape=box,color=red];
		j649400006 -> j2454289386;
	j2803483038 [label="Et ce… n’est pas normal pour toi?",shape=box,color=red];
		j2803483038 -> j2667413581;
	j1546226721 [label="Je comprends ton point de vue. La limite est floue. ",shape=box,color=red];
		j1546226721 -> j2043957631;
	j2586454692 [label="Dans un cas, il faut de la pratique et du dévouement. Dans l'autre, c'est juste… de la brutalité.",shape=box,color=red];
		j2586454692 -> j140056226;
	j558376619 [label="Cette conversation ne m'intéresse pas. [Fin.]",shape=box,color=red];
		j558376619 -> j2823604950;
	j3091745658 [label="Pourquoi se soucier de l'apparence que l'on peut avoir sur le champ de bataille? Certainement pas pour que l'on puisse identifier ton cadavre. On ne peut te confondre nulle part. Non, car si tu dois tuer, mon cher Usurpateur, je parie que tu souhaites le faire avec panache.",shape=box,color=blue];
		j3091745658 -> j2381731692;
	j3201239406 [label="Non.",shape=box,color=red];
		j3201239406 -> j2823604950;
	j2546199149 [label="Très bien. Si. Pourquoi?",shape=box,color=red];
		j2546199149 -> j931500186;
	j2454289386 [label="Oui, je sais! Je sais. Je ne ferai rien de tout cela, attention. Je ne vais pas non plus réduire cet endroit en cendres, même si j'en meurs d'envie.",shape=box,color=blue];
		j2454289386 -> j3158218735;
	j2667413581 [label="Non! Non, ce ne l'est pas! Et il n'est pas normal non plus que je salive à l'idée de réduire cet endroit en cendres!",shape=box,color=blue];
		j2667413581 -> j3158218735;
	j2043957631 [label="Toutes ces limites sont arbitraires. Et plus vite nous le comprendrons, plus vite nous pourrons nous entendre sur les combats qui sont importants et ceux qui ne le sont pas.",shape=box,color=blue];
		j2043957631 -> j2951783446;
	j140056226 [label="Très bien, suivons ce raisonnement jusqu'au bout. Tuer avec de l'entraînement rendrait-il l'acte honorable? Donc, si je suis un Dax et que j'enrobe mon meurtre de suffisamment de faste et de cérémonies, cela en fait de l'art?",shape=box,color=blue];
		j140056226 -> j2337221455;
	j2381731692 [label="Et qu'est-ce que c'est, sinon la jouissance de l'acte, je te le demande?",shape=box,color=blue];
		j2381731692 -> j3073101606;
	j3158218735 [label="C'est forcément la faute d'Uriel. J'avoue avoir déjà eu des pensées aussi destructrices et sanguinaires, mais elles n'étaient jamais aussi catastrophiques.",shape=box,color=blue];
		j3158218735 -> j3649182209;
	j2951783446 [label="Déterminer si un meurtre a été commis honorablement revient à essayer de déterminer ce qui est pire: mourir brûlé vif ou mourir noyé. Les deux sont des morts atroces.",shape=box,color=blue];
		j2951783446 -> j3700294492;
	j2337221455 [label="Nous nous approchons maintenant de la limite entre rituel et religion.",shape=box,color=blue];
		j2337221455 -> j4111442749;
	j3073101606 [label="Ne te méprends pas! Je ne te juge pas. Tu fais de ton mieux dans cette situation! La mort a fait de toi son partenaire dans cette grande mascarade qu'est la vie et tu n'as d'autre choix que de répondre à son appel.",shape=box,color=blue];
		j3073101606 -> j4087610840;
	j3649182209 [label="Et certainement pas... apocalyptiques.",shape=box,color=blue];
		j3649182209 -> "Chat ends.";
	j3700294492 [label="Et tous les chemins mènent à la tombe, alors à quoi bon chipoter? Nous avons des problèmes bien plus importants à résoudre.",shape=box,color=blue];
		j3700294492 -> "Chat ends.";
	j4111442749 [label="Au moins, il y a de l'honnêteté dans la mort simple et brutale par un coup de couteau dans le dos. Il n'y a rien de pieux là-dedans. Rien d'ostentatoire ni de pesant. C'est fait.",shape=box,color=blue];
		j4111442749 -> j3365981421;
	j4087610840 [label="Et si tu avais baissé tes armes? Combien d’autres seraient morts à tes côtés, je me le demande? Non, pourquoi ne pas avoir plus de fierté de ton travail? Un peu de plaisir dans l’art de le faire? Quelle est l’alternative, je te le demande? La folie? L’oubli?",shape=box,color=blue];
		j4087610840 -> j2924286000;
	j3365981421 [label="N'y a-t-il pas de l'art là-dedans?",shape=box,color=blue];
		j3365981421 -> "Chat ends.";
	j2924286000 [label="J'en ai vu trop emprunter cette voie et à la fin, la potence les attendait. Non. Je dis: fais ce que tu veux, Usurpateur. Car la vie t'a assurément imposé sa volonté.",shape=box,color=blue];
		j2924286000 -> "Chat ends.";
}