	"Chat ends." [color=orange];
	j2925631696 [label="MV: COMMANDANTS",shape=box,color=blue];
		j2925631696 -> j1069888452;
	j1069888452 [label="Transcription: je les revois, maintenant. Des groupes de jeunes Orokins rieurs.",shape=box,color=blue];
		j1069888452 -> j3033784849;
	j3033784849 [label="Des nobles vêtus des habits de commandement encore intacts.",shape=box,color=blue];
		j3033784849 -> j2988796737;
	j2988796737 [label="Des amis d'enfance désormais à la tête de légions de Dax, de Grineers, de cellules de matière nulle, de carcinateurs autoréplicateurs, d'araignées biodrones primitives, de conteneurs de troupes rudimentaires.",shape=box,color=blue];
		j2988796737 -> j1166043801;
	j1166043801 [label="Des jeunes gens dorés, des démons affamés à leurs ordres.",shape=box,color=blue];
		j1166043801 -> j2994165730;
	j2994165730 [label="Leur arrogance s'insinue dans mon esprit comme une sueur brûlante. Ils buvaient et chantaient, se vantant des temps à venir.",shape=box,color=blue];
		j2994165730 -> j3605593690;
	j3605593690 [label="Ils se feraient un nom. Ils élèveraient l'honneur de leurs familles.",shape=box,color=blue];
		j3605593690 -> j1445273485;
	j1445273485 [label="Tant d'entre eux sont tombés. Leurs corps n'ont même pas été retrouvés.",shape=box,color=blue];
		j1445273485 -> j3149370072;
	j3149370072 [label="Pour empêcher l'ennemi de s'emparer de nos secrets, ils ont été soumis à une décharge de Kuva qui les a liquéfiés à leur mort.",shape=box,color=blue];
		j3149370072 -> j2642070488;
	j2642070488 [label="L'espoir d'une génération s'est transformé en une flaque huileuse, piétinée par les bottes Grineers.",shape=box,color=blue];
		j2642070488 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}