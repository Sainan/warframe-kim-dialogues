	2208 [label="Transcription: je les revois, maintenant. Des groupes de jeunes Orokins rieurs.",shape=box,color=blue];
		2208 -> 2212;
	2212 [label="Des nobles vêtus des habits de commandement encore intacts.",shape=box,color=blue];
		2212 -> 2205;
	2205 [label="Des amis d'enfance désormais à la tête de légions de Dax, de Grineers, de cellules de matière nulle, de carcinateurs autoréplicateurs, d'araignées biodrones primitives, de conteneurs de troupes rudimentaires.",shape=box,color=blue];
		2205 -> 2213;
	2213 [label="Des jeunes gens dorés, des démons affamés à leurs ordres.",shape=box,color=blue];
		2213 -> 2215;
	2215 [label="Leur arrogance s'insinue dans mon esprit comme une sueur brûlante. Ils buvaient et chantaient, se vantant des temps à venir.",shape=box,color=blue];
		2215 -> 5696;
	5696 [label="Ils se feraient un nom. Ils élèveraient l'honneur de leurs familles.",shape=box,color=blue];
		5696 -> 5697;
	5697 [label="Tant d'entre eux sont tombés. Leurs corps n'ont même pas été retrouvés.",shape=box,color=blue];
		5697 -> 5698;
	5698 [label="Pour empêcher l'ennemi de s'emparer de nos secrets, ils ont été soumis à une décharge de Kuva qui les a liquéfiés à leur mort.",shape=box,color=blue];
		5698 -> 5699;
	5699 [label="L'espoir d'une génération s'est transformé en une flaque huileuse, piétinée par les bottes Grineers.",shape=box,color=blue];
