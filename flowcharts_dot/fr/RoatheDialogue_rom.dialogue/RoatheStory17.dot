	2286 [label="Transcription: au départ, les Warframes semblaient davantage relever d’une démarche artistique que d’une véritable arme.",shape=box,color=blue];
		2286 -> 2285;
	2285 [label="La guerre était pratiquement perdue; les Sentients étaient invincibles; créons donc ces guerriers étranges et surréalistes et équipons-les d'armes d'une lignée ancestrale.",shape=box,color=blue];
		2285 -> 2282;
	2282 [label="Au moins, notre défaite sera belle. Mémorable.",shape=box,color=blue];
		2282 -> 2283;
	2283 [label="Mais contre toute attente, ils triomphèrent. Bientôt, des récits d'un héroïsme invraisemblable parvinrent du front.",shape=box,color=blue];
		2283 -> 5715;
	5715 [label="Warframes had appeared from the sky, angel-like, liberating captives and devastating Sentient strongholds. Even alone they were miracles; in groups, they were gods.",shape=box,color=blue];
		5715 -> 5716;
	5716 [label="Little wonder, then, that they were seen as mere propaganda.",shape=box,color=blue];
