	"Chat ends." [color=orange];
	j111920823 [label="MV: WARFRAMES",shape=box,color=blue];
		j111920823 -> j2142295036;
	j2142295036 [label="Transcription: au départ, les Warframes semblaient davantage relever d’une démarche artistique que d’une véritable arme.",shape=box,color=blue];
		j2142295036 -> j3818135729;
	j3818135729 [label="La guerre était pratiquement perdue; les Sentients étaient invincibles; créons donc ces guerriers étranges et surréalistes et équipons-les d'armes d'une lignée ancestrale.",shape=box,color=blue];
		j3818135729 -> j493871081;
	j493871081 [label="Au moins, notre défaite sera belle. Mémorable.",shape=box,color=blue];
		j493871081 -> j4002707280;
	j4002707280 [label="Mais contre toute attente, ils triomphèrent. Bientôt, des récits d'un héroïsme invraisemblable parvinrent du front.",shape=box,color=blue];
		j4002707280 -> j2489403589;
	j2489403589 [label="Les Warframes étaient apparues dans le ciel, telles des anges, libérant les captifs et dévastant les forteresses Sentients. Même seules, elles étaient des miracles; en groupe, elles étaient des dieux.",shape=box,color=blue];
		j2489403589 -> j4035979711;
	j4035979711 [label="Rien d’étonnant, dès lors, à ce qu’elles aient été perçues comme de la simple propagande.",shape=box,color=blue];
		j4035979711 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}