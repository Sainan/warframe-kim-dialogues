	"Chat ends." [color=orange];
	j2421349340 [label="MV: STANDARD",shape=box,color=blue];
		j2421349340 -> j3687494157;
	j3687494157 [label="Transcription: rien n’illustre aussi bien la suffisance avec laquelle nous traitons le carnage de la guerre que les porte-étendards.",shape=box,color=blue];
		j3687494157 -> j2916203594;
	j2916203594 [label="Ceux qu’il faut protéger à tout prix – et suivre aveuglément.",shape=box,color=blue];
		j2916203594 -> j3127811579;
	j3127811579 [label="Et ceux qui pourraient être contraints, j'ajouterais, d'obéir à des ordres qu'aucun soldat sain d'esprit n'exécuterait, de peur de subir un sort encore plus terrible.",shape=box,color=blue];
		j3127811579 -> j3536604436;
	j3536604436 [label="C'est aussi risible que ça.",shape=box,color=blue];
		j3536604436 -> j36923031;
	j36923031 [label="Parmi tous les autres, ce sont toujours leurs silhouettes qui attiraient mon regard, même si leurs corps mutilés ne différaient en rien des autres. ",shape=box,color=blue];
		j36923031 -> j1092430223;
	j1092430223 [label="C'était toujours l'étendard qu'ils arboraient, scintillant d'or Orokin et moucheté de pourpre.",shape=box,color=blue];
		j1092430223 -> j212072095;
	j212072095 [label="Je veillais toujours à ce qu'il trône fièrement sur le champ de bataille avant de partir.",shape=box,color=blue];
		j212072095 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}