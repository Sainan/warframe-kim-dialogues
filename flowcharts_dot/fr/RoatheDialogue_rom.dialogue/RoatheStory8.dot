	2198 [label="Transcription: rien n’illustre aussi bien la suffisance avec laquelle nous traitons le carnage de la guerre que les porte-étendards.",shape=box,color=blue];
		2198 -> 5694;
	5694 [label="Ceux qu’il faut protéger à tout prix – et suivre aveuglément.",shape=box,color=blue];
		5694 -> 5695;
	5695 [label="Et ceux qui pourraient être contraints, j'ajouterais, d'obéir à des ordres qu'aucun soldat sain d'esprit n'exécuterait, de peur de subir un sort encore plus terrible.",shape=box,color=blue];
		5695 -> 2203;
	2203 [label="C'est aussi risible que ça.",shape=box,color=blue];
		2203 -> 5731;
	5731 [label="Parmi tous les autres, ce sont toujours leurs silhouettes qui attiraient mon regard, même si leurs corps mutilés ne différaient en rien des autres. ",shape=box,color=blue];
		5731 -> 2195;
	2195 [label="C'était toujours l'étendard qu'ils arboraient, scintillant d'or Orokin et moucheté de pourpre.",shape=box,color=blue];
		2195 -> 2204;
	2204 [label="Je veillais toujours à ce qu'il trône fièrement sur le champ de bataille avant de partir.",shape=box,color=blue];
