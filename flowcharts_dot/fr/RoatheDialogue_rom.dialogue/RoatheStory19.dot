	j739594512 [label="MV: DIPLOMATIE",shape=box,color=blue];
		j739594512 -> j406820405;
	j406820405 [label="Transcription: Parmi les sept Exécuteurs, Ballas s’était positionné comme le premier parmi ses pairs.",shape=box,color=blue];
		j406820405 -> j3259909428;
	j3259909428 [label="Diplomate infaillible, orateur à la voix suave, il aplanissait les différends et les querelles des autres.",shape=box,color=blue];
		j3259909428 -> j718495948;
	j718495948 [label="À ma plus grande joie, je constatai qu'il était désormais comme une rose prise entre deux épines.",shape=box,color=blue];
		j718495948 -> j2035239283;
	j2035239283 [label="La faction belliciste, menée par Nitokh, tirait d'un côté. Les pacifistes, sous la houlette de Scarne, tiraient de l'autre.",shape=box,color=blue];
		j2035239283 -> j4135374270;
	j4135374270 [label="Ballas se devait de choisir, sous peine de s'attirer l'hostilité farouche du groupe qu'il ne soutiendrait pas.",shape=box,color=blue];
		j4135374270 -> j1465248788;
	j1465248788 [label="Pour des raisons qui m'échappent, il opta pour la paix; le vote fut de quatre contre trois et les Sentients affamés devinrent soudain des alliés et des amis.",shape=box,color=blue];
		j1465248788 -> j3405427807;
	j3405427807 [label="\"D’une manière ou d’une autre, il finira par se rallier à nous\", promit Nitokh, alors même que j’étais envoyé à la recherche de mécontents parmi les Dax en garnison.",shape=box,color=blue];
		j3405427807 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}