	5720 [label="Transcript: Among the Seven Executors, Ballas had styled himself first among equals. ",shape=box,color=blue];
		5720 -> 5721;
	5721 [label="Ever the diplomat, ever the honey-voiced persuader, he resolved the grudges and disputes of the others.",shape=box,color=blue];
		5721 -> 2301;
	2301 [label="À ma plus grande joie, je constatai qu'il était désormais comme une rose prise entre deux épines.",shape=box,color=blue];
		2301 -> 5734;
	5734 [label="The warmonger faction, headed by Nitokh, pulled one way. The pacifists, under Scarne, pulled another.",shape=box,color=blue];
		5734 -> 2300;
	2300 [label="Ballas se devait de choisir, sous peine de s'attirer l'hostilité farouche du groupe qu'il ne soutiendrait pas.",shape=box,color=blue];
		2300 -> 2305;
	2305 [label="Pour des raisons qui m'échappent, il opta pour la paix; le vote fut de quatre contre trois et les Sentients affamés devinrent soudain des alliés et des amis.",shape=box,color=blue];
		2305 -> 2308;
	2308 [label="\"D’une manière ou d’une autre, il finira par se rallier à nous\", promit Nitokh, alors même que j’étais envoyé à la recherche de mécontents parmi les Dax en garnison.",shape=box,color=blue];
