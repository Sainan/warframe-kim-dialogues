	j1544082751 [label="VM: DIPLOMACY",shape=box,color=blue];
		j1544082751 -> j2921070298;
	j2921070298 [label="Transcript: Among the Seven Executors, Ballas had styled himself first among equals. ",shape=box,color=blue];
		j2921070298 -> j2588479372;
	j2588479372 [label="Ever the diplomat, ever the honey-voiced persuader, he resolved the grudges and disputes of the others.",shape=box,color=blue];
		j2588479372 -> j3434052737;
	j3434052737 [label="À ma plus grande joie, je constatai qu'il était désormais comme une rose prise entre deux épines.",shape=box,color=blue];
		j3434052737 -> j2224877435;
	j2224877435 [label="The warmonger faction, headed by Nitokh, pulled one way. The pacifists, under Scarne, pulled another.",shape=box,color=blue];
		j2224877435 -> j4135374270;
	j4135374270 [label="Ballas se devait de choisir, sous peine de s'attirer l'hostilité farouche du groupe qu'il ne soutiendrait pas.",shape=box,color=blue];
		j4135374270 -> j1465248788;
	j1465248788 [label="Pour des raisons qui m'échappent, il opta pour la paix; le vote fut de quatre contre trois et les Sentients affamés devinrent soudain des alliés et des amis.",shape=box,color=blue];
		j1465248788 -> j3405427807;
	j3405427807 [label="\"D’une manière ou d’une autre, il finira par se rallier à nous\", promit Nitokh, alors même que j’étais envoyé à la recherche de mécontents parmi les Dax en garnison.",shape=box,color=blue];
		j3405427807 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}