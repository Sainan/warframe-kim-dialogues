	j2511034968 [label="La famille aura besoin de protection. Et ils sont tous un peu \"cloués sur place\", pour ainsi dire, n'est-ce pas?",shape=box,color=blue];
		j2511034968 -> j2179998195;
	j1376586162 [label="Mais le risque en vaut la peine. Elle n'a aucun autre moyen de protéger Deimos. Ni sa famille.",shape=box,color=blue];
