		j4082858284 -> "Chat ends." [label=false,color=brown];
	j3522247526 [label="Hé, Roathe? Tu as une seconde? [Demander le consentement pour avoir plusieurs partenaires.]",shape=box,color=red];
		j3522247526 -> j1398321627;
	j875475551 [label="[Fin.]",shape=box,color=red];
		j875475551 -> j604242687;
	j1398321627 [label="Hm? Qu'y a-t-il, mon cœur?",shape=box,color=blue];
		j1398321627 -> j1039414657;
	j604242687 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j604242687 -> "Chat ends.";
	j1039414657 [label="Je veux te parler de quelque chose et je veux m'assurer que ça te dérange pas.",shape=box,color=red];
		j1039414657 -> j3200470172;
	j3200470172 [label="Il est important pour moi que tu n'aies pas l'impression que je te mens ou que je suis malhonnête avec toi.",shape=box,color=red];
		j3200470172 -> j1263453562;
	j1263453562 [label="Vas-y. Cela semble prometteur.",shape=box,color=blue];
		j1263453562 -> j2285709355;
	j2285709355 [label="Je veux pas te mettre dans une situation qui pourrait te déplaire. Si tu dis non, c'est pas grave Je voulais juste que tu le saches.",shape=box,color=red];
		j2285709355 -> j3758661842;
	j3758661842 [label="On a un truc important ensemble, très important et c'est réel. Je veux pas que t'en doutes.",shape=box,color=red];
		j3758661842 -> j3836799171;
	j3836799171 [label="Attends. Par le Néant, tu essaies de m'annoncer que tu as un autre partenaire?",shape=box,color=blue];
		j3836799171 -> j2309458209;
	j2309458209 [label="Pour qui me prends-tu? Je le sais déjà, Voyageur adoré!",shape=box,color=blue];
		j2309458209 -> j2257325273;
		j2309458209 -> j1453009685;
	j2257325273 [label="Je suppose que cela ne te dérange pas, alors?",shape=box,color=red];
		j2257325273 -> j1951803029;
	j1453009685 [label="Tu... le sais?",shape=box,color=red];
		j1453009685 -> j3883989531;
	j1951803029 [label="Si seulement tu pouvais m'entendre rire à Sanctum en ce moment. Voyageur, mon amour. Mon doux Voyageur. Je suis un Orokin. Bien sûr que non.",shape=box,color=blue];
		j1951803029 -> j790569691;
	j3883989531 [label="Si seulement tu pouvais m'entendre rire à Sanctum en ce moment. Voyageur, mon amour. Mon doux Voyageur.",shape=box,color=blue];
		j3883989531 -> j128075569;
	j790569691 [label="Quoi que tu penses de ma société et de notre penchant pour apprécier la compagnie des autres d'une manière que tu pourrais considérer comme méprisante et dévalorisante, nous savions aussi ce que signifiait aimer.",shape=box,color=blue];
		j790569691 -> j175311318;
	j128075569 [label="Je l'ai su dès que c'est arrivé. J'ai mes méthodes. Et non, cela ne me dérange absolument pas. Je suis Orokin.",shape=box,color=blue];
		j128075569 -> j790569691;
	j175311318 [label="Personne ne comprenait l'amour comme les Orokins. Et nous savions qu'on pouvait avoir de la place dans son cœur pour plus d'un être. ",shape=box,color=blue];
		j175311318 -> j1037303155;
	j1037303155 [label="Je suis simplement déçu que les fanatiques soient probablement trop fermés d'esprit pour se joindre à la fête.",shape=box,color=blue];
		j1037303155 -> j2697684816;
	j2697684816 [label="Pff. À bien y réfléchir, c'est sans doute mieux ainsi. Imagine un peu le bazar que ça engendrerait!",shape=box,color=blue];
		j2697684816 -> j2404433682;
	j2404433682 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j2404433682 -> j2067415285;
	j2067415285 [label="Bon, peu importe. Si ça te fait plaisir, alors profites-en. Mais sache que quand tu es avec moi...",shape=box,color=blue];
		j2067415285 -> j3605083573;
	j3605083573 [label="+5 Chemistry",color=orange];
		j3605083573 -> j1323493403;
	j1323493403 [label="Tu es à moi et à moi seul.",shape=box,color=blue];
		j1323493403 -> "Chat ends.";
}