		1896 -> 1897;
	1897 [label="Neci... s'est emparée du trône. Le Murmure - \"l'armée de l'Indifférence\", pour ainsi dire, a envahi et elle a pris le pouvoir.",shape=box,color=red];
		1897 -> 1898;
