	"Chat ends." [color=orange];
	j927941538 [label="Hé... les gars?",shape=box,color=red];
		j927941538 -> j2815417732;
	j2815417732 [label="MomToxicated: Oui?",shape=box,color=blue];
		j2815417732 -> j3240546140;
	j3240546140 [label="PapaPolar: qu'est-ce qu'il se passe mon petit?",shape=box,color=blue];
		j3240546140 -> j126571871;
		j3240546140 -> j1461787254;
		j3240546140 -> j4020817318;
	j126571871 [label="J'ai une bonne et une mauvaise nouvelle. Concernant Neci.",shape=box,color=red];
		j126571871 -> j318886464;
	j1461787254 [label="Je veux que vous ne vous fassiez pas d'illusions. J'ai des nouvelles de Neci, mais elles sont... mitigées. Et peu concluantes.",shape=box,color=red];
		j1461787254 -> j4097494374;
	j4020817318 [label="Mmm... En fait non, rien. [Fin]",shape=box,color=red];
		j4020817318 -> "Chat ends.";
	j318886464 [label="PapaPolar: vas-y, comme un adulte. les mauvaises nouvelles d'abord.",shape=box,color=blue];
		j318886464 -> j842875887;
	j4097494374 [label="+5 Chemistry",color=orange];
		j4097494374 -> j970160085;
	j842875887 [label="MomToxicated: Je suis d'accord. Les mauvaises nouvelles arrivent toujours en premier.",shape=box,color=blue];
		j842875887 -> j2440605088;
	j970160085 [label="MomToxicated: Comme tout dans la vie au final. Mais merci pour l'avertissement.",shape=box,color=blue];
		j970160085 -> j1866072773;
	j2440605088 [label="Du coup. L'Indifférence est allée à Duviri. Et... a embarqué Neci avec.",shape=box,color=red];
		j2440605088 -> j3172092812;
	j1866072773 [label="+5 Chemistry",color=orange];
		j1866072773 -> j4034106899;
	j3172092812 [label="PapaPolar: atta atta atta. la dimension de ce bouquin de contes de fées?",shape=box,color=blue];
		j3172092812 -> j4096332321;
	j4034106899 [label="PapaPolar: je me prépare pour la nouvelle, mais on dirait qu'au moins... elle est toujours en vie?",shape=box,color=blue];
		j4034106899 -> j236849959;
	j4096332321 [label="MomToxicated: Celui avec l'enfant dictateur qui n'arrêtait pas de te tuer sans cesse?",shape=box,color=blue];
		j4096332321 -> j1096193510;
		j4096332321 -> j3218478961;
	j236849959 [label="Je... ne sais pas. Je pense que oui. Mais laissez-moi juste vous dire ce que je sais, et vous en serez les juges.",shape=box,color=red];
		j236849959 -> j2440605088;
	j1096193510 [label="Il s'avère que c'était un moment qui lui a permis de grandir un peu? Bref...",shape=box,color=red];
		j1096193510 -> j1740312261;
	j3218478961 [label="Lui-même.",shape=box,color=red];
		j3218478961 -> j1740312261;
	j1740312261 [label="Neci... s'est emparée du trône. Le Murmure - \"l'armée de l'Indifférence\", pour ainsi dire, a envahi et elle a pris le pouvoir.",shape=box,color=red];
		j1740312261 -> j3482674367;
	j3482674367 [label="MomToxicated: Heh. C'est ma fille toute crachée.",shape=box,color=blue];
		j3482674367 -> j3978114293;
	j3978114293 [label="PapaPolar: mais était-ce vraiment *elle* ? ou juste cette chose qui portait son visage?",shape=box,color=blue];
		j3978114293 -> j1621121947;
		j3978114293 -> j719057467;
	j1621121947 [label="Je ne sais pas.",shape=box,color=red];
		j1621121947 -> j4198098789;
	j719057467 [label="C'est de ça dont je voulais vous parler.",shape=box,color=red];
		j719057467 -> j4198098789;
	j4198098789 [label="J'ai trouvé ces documents. Au début, ils étaient disparates. Mais quand je les ai rassemblés, j'ai... reçu ce message.",shape=box,color=red];
		j4198098789 -> j667036741;
	j667036741 [label="Je me demandais si ça avait du sens pour vous.",shape=box,color=red];
		j667036741 -> j2412078704;
	j2412078704 [label="MomToxicated: Des énigmes et des messages étranges? C'est notre spécialité.",shape=box,color=blue];
		j2412078704 -> j1733547226;
	j1733547226 [label="PapaPolar: #3615espion, t'es au bon endroit",shape=box,color=blue];
		j1733547226 -> j3987628764;
	j3987628764 [label="\"Car quand Sol et Lua seront alignés, ceux qui sont perdus retrouveront leur chemin.\"",shape=box,color=red];
		j3987628764 -> j1298866307;
	j1298866307 [label="PapaPolar: ...merde. MERDE.",shape=box,color=blue];
		j1298866307 -> j1496923885;
	j1496923885 [label="MomToxicated: Ne tombe pas dans le panneau. Si cette chose est dans sa tête, elle sait ce qu'elle sait.",shape=box,color=blue];
		j1496923885 -> j534198559;
		j1496923885 -> j2303428843;
	j534198559 [label="Quoi? Qu'est-ce que ça veut dire?",shape=box,color=red];
		j534198559 -> j1340579299;
	j2303428843 [label="C'est l'autre moitié, c'est ça?",shape=box,color=red];
		j2303428843 -> j2773660955;
	j1340579299 [label="PapaPolar: \"Aux carrefours vides, cherche l'éclipse.\"",shape=box,color=blue];
		j1340579299 -> j2920069663;
	j2773660955 [label="+5 Chemistry",color=orange];
		j2773660955 -> j2983829447;
	j2920069663 [label="PapaPolar: ce que je t'ai dit de dire à notre petite fille si tu la revoyais.",shape=box,color=blue];
		j2920069663 -> j3293673322;
	j2983829447 [label="PapaPolar: tu as tout compris...",shape=box,color=blue];
		j2983829447 -> j4007797680;
	j3293673322 [label="PapaPolar: c'était notre moitié d'une phrase codée. on commençait avec ça à chaque appel téléphonique pour s'assurer de bien être sur une ligne sécurisée et que tout était bon",shape=box,color=blue];
		j3293673322 -> j3654885716;
	j4007797680 [label="PapaPolar: nous avions une phrase de code. C'était ainsi que nous commencions chaque appel téléphonique afin de s'assurer que nous étions bien sur une ligne sécurisée et que tout était bon",shape=box,color=blue];
		j4007797680 -> j3654885716;
	j3654885716 [label="MomToxicated: Et qu'on était bien... nous-mêmes.",shape=box,color=blue];
		j3654885716 -> j1784282513;
	j1784282513 [label="PapaPolar: \"Aux carrefours vides, cherche l'éclipse\", c'était notre moitié de la phrase.",shape=box,color=blue];
		j1784282513 -> j1589439558;
	j1589439558 [label="MomToxicated: \"Car quand Sol et Lua seront alignés, ceux qui sont perdus retrouveront leur chemin.\" était la réponse.",shape=box,color=blue];
		j1589439558 -> j286857857;
	j286857857 [label="MomToxicated: *Sa* réponse.",shape=box,color=blue];
		j286857857 -> j634810069;
		j286857857 -> j2231291905;
	j634810069 [label="Mais on ne peut pas être sûr que c'était elle, comme tu l'as dit, Minerva. L'Indifférence sait ce qu'elle sait.",shape=box,color=red];
		j634810069 -> j3390563930;
	j2231291905 [label="Je ne sais pas pourquoi l'Indifférence vous dirait ça...",shape=box,color=red];
		j2231291905 -> j3204087557;
	j3390563930 [label="MomToxicated: Mais pourquoi chercherait-il à nous donner un sentiment d'espoir? À moins qu'il ne cherche simplement à nous blesser.",shape=box,color=blue];
		j3390563930 -> j2995507465;
	j3204087557 [label="MomToxicated: Pour nous donner de faux espoirs, peut-être? Pour nous faire souffrir?",shape=box,color=blue];
		j3204087557 -> j3678696560;
	j2995507465 [label="PapaPolar: est-ce douloureux?",shape=box,color=blue];
		j2995507465 -> j3929627796;
	j3678696560 [label="PapaPolar: est-ce vraiment faux? est-ce que c'est douloureux?",shape=box,color=blue];
		j3678696560 -> j3929627796;
	j3929627796 [label="PapaPolar: ou est-ce une sorte de paix, de savoir que notre petite fille est toujours en vie, quelque part?",shape=box,color=blue];
		j3929627796 -> j2767323904;
	j2767323904 [label="PapaPolar: que malgré tout, elle continue de botter des culs?",shape=box,color=blue];
		j2767323904 -> j957621578;
	j957621578 [label="PapaPolar: même si c'est pas avec nous?",shape=box,color=blue];
		j957621578 -> j698270553;
	j698270553 [label="PapaPolar: ça réchauffe mon grand cœur stupide, je sais pas pour vous.",shape=box,color=blue];
		j698270553 -> j4061962175;
	j4061962175 [label="PapaPolar: et que'que chose me dit que c'est pas le business de cette soi-disante Indifférence.",shape=box,color=blue];
		j4061962175 -> j1212536759;
	j1212536759 [label="MomToxicated: Tu as tout à fait raison. Entendre cette phrase, penser qu'elle *pourrait* encore être là, ce n'est pas douloureux.",shape=box,color=blue];
		j1212536759 -> j3984925526;
	j3984925526 [label="MomToxicated: Je suis fière d'elle.",shape=box,color=blue];
		j3984925526 -> j1364330050;
		j3984925526 -> j2064689832;
		j3984925526 -> j1120566965;
	j1364330050 [label="Même si elle est toujours retenue en otage par l'Indifférence?",shape=box,color=red];
		j1364330050 -> j1570110311;
	j2064689832 [label="Même si c'est un tour de l'Indifférence?",shape=box,color=red];
		j2064689832 -> j201159362;
	j1120566965 [label="Elle pourrait travailler volontairement avec l'Indifférence.",shape=box,color=red];
		j1120566965 -> j3763567877;
	j1570110311 [label="PapaPolar: elle est aussi résistante qu'un sac de clous de charpente dans un gros bloc de titane moulé",shape=box,color=blue];
		j1570110311 -> j568497874;
	j201159362 [label="MomToxicated: Pourquoi? À quoi bon? Qu'a-t-il à gagner avec nous deux?",shape=box,color=blue];
		j201159362 -> j286675837;
	j3763567877 [label="MomToxicated: Elle a alors l'un des alliés les plus puissants de l'univers. Elle a choisi son camp. Nous aussi.",shape=box,color=blue];
		j3763567877 -> j3640904161;
	j568497874 [label="PapaPolar: et je parie que ton homme dans le mur\" le savait aussi et c'est pour ça qu'il l'a emmenée en premier lieu",shape=box,color=blue];
		j568497874 -> j2701548034;
	j286675837 [label="PapaPolar: on est que des petits poissons par rapport à cette chose. et je le dis de la meilleure façon possible",shape=box,color=blue];
		j286675837 -> j2370968341;
	j3640904161 [label="MomToxicated: Espérons que nous n'aurons jamais à nous braquer les uns sur les autres. Et si c'est le cas? Nous y ferons face.",shape=box,color=blue];
		j3640904161 -> j4115679513;
	j2701548034 [label="PapaPolar: nah, elle s'en sortira. soit elle est déjà plus là depuis longtemps, soit ils ont un arrangement mutuel, soit elle le prend en otage. lol",shape=box,color=blue];
		j2701548034 -> j2370968341;
	j2370968341 [label="MomToxicated: Non, je pense que le message était réel. Et je pense qu'il venait de notre petite fille. Elle nous disait... qu'elle est toujours là.",shape=box,color=blue];
		j2370968341 -> j2027714410;
	j4115679513 [label="PapaPolar: mais elle peut prendre soin d'elle-même. C'est comme ça qu'on l'a élevée.",shape=box,color=blue];
		j4115679513 -> j2370968341;
	j2027714410 [label="MomToxicated: Elle nous dit, à sa manière, qu'elle va \"bien\".",shape=box,color=blue];
		j2027714410 -> j518969935;
	j518969935 [label="MomToxicated: Et que nous pouvons arrêter de nous inquiéter pour elle.",shape=box,color=blue];
		j518969935 -> j2801487013;
	j2801487013 [label="PapaPolar: heh. comme si on pouvait",shape=box,color=blue];
		j2801487013 -> j2562720367;
	j2562720367 [label="MomToxicated: La malédiction et la bénédiction d’être parent.",shape=box,color=blue];
		j2562720367 -> j191243601;
	j191243601 [label="PapaPolar: tu as déjà voulu avoir des enfants, Voyageur? eeeh, réponds pas. probablement encore une absurdité du Néant dont je veux rien savoir.",shape=box,color=blue];
		j191243601 -> j4285187645;
		j191243601 -> j766346286;
		j191243601 -> j1054953941;
	j4285187645 [label="On se prend un verre? On va se prendre un verre.",shape=box,color=red];
		j4285187645 -> j2048167479;
	j766346286 [label="Sage décision.",shape=box,color=red];
		j766346286 -> j1227665500;
	j1054953941 [label="<RETRO_EMOJI_OHNO>",shape=box,color=red];
		j1054953941 -> j201929735;
	j2048167479 [label="+5 Chemistry",color=orange];
		j2048167479 -> j2838228218;
	j1227665500 [label="PapaPolar: eh bien, c'est pas un sourire joyeux. c'est un sourire mélancolique et joyeux? mais",shape=box,color=blue];
		j1227665500 -> j2742836761;
	j201929735 [label="MomToxicated: C'est une réponse valide, je suis d'accord. Héhé. Que diriez-vous de quelques verres?",shape=box,color=blue];
		j201929735 -> j2829086527;
	j2838228218 [label="MomToxicated: Ah, maintenant, ça nous parle!",shape=box,color=blue];
		j2838228218 -> j2742836761;
	j2742836761 [label="PapaPolar: j'aimerais revenir quelques temps en arrière et raconter de belles histoires sur notre petite fille",shape=box,color=blue];
		j2742836761 -> j1656272274;
	j2829086527 [label="PapaPolar: là, on parle.",shape=box,color=blue];
		j2829086527 -> j2742836761;
	j1656272274 [label="MomToxicated: Et... Voyageur? Merci. Encore une fois. Pour tout ce que tu fais.",shape=box,color=blue];
		j1656272274 -> j3912778918;
	j3912778918 [label="PapaPolar: Ouais. sérieusement. je sais pas comment on pourra te rendre la pareille. mais si l'occasion se présente? compte sur nous.",shape=box,color=blue];
		j3912778918 -> j1197211913;
	j1197211913 [label="PapaPolar: tu fais partie de la famille, maintenant, que tu le veuilles ou non. 8-)",shape=box,color=blue];
		j1197211913 -> "Chat ends.";
}