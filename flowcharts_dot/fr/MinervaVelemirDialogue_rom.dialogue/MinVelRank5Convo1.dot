	j2854088019 [label="MomToxicated: Elle était perspicace. Plus que la plupart des gens. Plus que ce pour quoi nous l'avions entraînée.",shape=box,color=blue];
		j2854088019 -> j1381381010;
	"Chat ends. Next chat will be MinVelRank5Convo2." [color=orange];
	j1381381010 [label="PapaPolar: la dernière fois que nous lui avons parlé, c'était sur une ligne sécurisée. ",shape=box,color=blue];
		j1381381010 -> j484425349;
	j484425349 [label="PapaPolar: et sa sale petite belette à l'allure étrange écoutait probablement",shape=box,color=blue];
		j484425349 -> j2961726276;
	j2961726276 [label="PapaPolar: à ce moment-là, nous étions encore *techniquement* ensemble, mais les choses se détérioraient, et vite...",shape=box,color=blue];
		j2961726276 -> j3356081946;
	j3356081946 [label="MomToxicated: Je parie qu'elle le savait. Elle pouvait le sentir. Même si nous ne le savions pas encore à l'époque.",shape=box,color=blue];
		j3356081946 -> j1417931254;
		j3356081946 -> j2856716227;
	j1417931254 [label="Pourriez-vous dire si elle était déjà... vous savez. Sous \"son\" emprise?",shape=box,color=red];
		j1417931254 -> j2800716623;
	j2856716227 [label="De quoi aviez-vous parlé, tous les trois?",shape=box,color=red];
		j2856716227 -> j638353749;
	j2800716623 [label="PapaPolar: elle parlait comme notre petite fille, si c'est ce que tu demandes. elle savait quoi dire et comment le dire.",shape=box,color=blue];
		j2800716623 -> j253373043;
	j638353749 [label="MomToxicated: Au début, c'était une conversation de travail. Comment elle gérait le commandement. Elle ne pouvait pas nous donner de chiffres, ni de détails, bien sûr.",shape=box,color=blue];
		j638353749 -> j373949121;
	j253373043 [label="MomToxicated: Mais tous les bons preneurs d’otages savent faire chanter leurs oiseaux captifs sur commande.",shape=box,color=blue];
		j253373043 -> j1565249891;
	j373949121 [label="MomToxicated: Nous ne faisions pas partie de la Scaldra. Nous n'étions rien de plus que des civils, pour les gens à l'autre bout du fil. Elle ne pouvait donc pas nous donner des informations confidentielles.",shape=box,color=blue];
		j373949121 -> j4219128410;
	j1565249891 [label="MomToxicated: Cela ne nous dit rien sur le moment ou la manière dont cette \"Indifférence\" l’a emportée.",shape=box,color=blue];
		j1565249891 -> j1355785229;
	j4219128410 [label="PapaPolar: mais elle semblait... stressée. on pouvait l'entendre.",shape=box,color=blue];
		j4219128410 -> j3225073751;
		j4219128410 -> j4157338747;
	j1355785229 [label="MomToxicated: Ou qui pilotait son corps quand nous lui avons parlé ce jour-là.",shape=box,color=blue];
		j1355785229 -> j2483030046;
	j3225073751 [label="Elle? Stressée? Difficile à imaginer.",shape=box,color=red];
		j3225073751 -> j332076091;
	j4157338747 [label="Stressée à propos de quoi?",shape=box,color=red];
		j4157338747 -> j2983307233;
	j2483030046 [label="PapaPolar: je ne sais pas comment on trouve un dieu ni comment on lui met un coup de poing dans sa gueule de [SUPPRIMÉ], mais [SUPPRIMÉ], je vais essayer",shape=box,color=blue];
		j2483030046 -> j4219128410;
	j332076091 [label="MomToxicated: Heh. Ça arrive aux meilleurs d'entre nous. Surtout quand on poursuit un \"fugitif\".",shape=box,color=blue];
		j332076091 -> j47947710;
	j2983307233 [label="MomToxicated: Un \"fugitif\".",shape=box,color=blue];
		j2983307233 -> j47947710;
	j47947710 [label="MomToxicated: Entrati. À l'époque, je pensais que c'était \"juste\" un baron de la drogue local ou un chef de la résistance.",shape=box,color=blue];
		j47947710 -> j3960313523;
	j3960313523 [label="PapaPolar: elle a à peine mentionné les foutues télés zombies. on aurait pu penser qu'elle en parlerait plus.",shape=box,color=blue];
		j3960313523 -> j1196970913;
	j1196970913 [label="MomToxicated: Je me demande si elle avait déjà perdu son bras à ce moment-là. Impossible de le savoir, j'imagine.",shape=box,color=blue];
		j1196970913 -> j1912796392;
		j1196970913 -> j1572034592;
	j1912796392 [label="Comment est-ce que ça c'est terminé?",shape=box,color=red];
		j1912796392 -> j2539127627;
	j1572034592 [label="Vous lui aviez dit que vous veniez en Höllvanie?",shape=box,color=red];
		j1572034592 -> j3320434468;
	j2539127627 [label="MomToxicated: À la manière dont les espions mettent fin à leurs conversations téléphoniques. En se mentant mutuellement.",shape=box,color=blue];
		j2539127627 -> j793084354;
	j3320434468 [label="PapaPolar: mdr. bien sûr que non. la ville était bouclée, tu te souviens? c'était une opération totalement secrète, on s'est faufilés en douce.",shape=box,color=blue];
		j3320434468 -> j452569286;
	j793084354 [label="MomToxicated: Nous lui avons dit que nous partions en mission ailleurs, alors que nous avions prévu de nous déployer dans sa ville bouclée.",shape=box,color=blue];
		j793084354 -> j1717707290;
	j452569286 [label="MomToxicated: Nous avons mis fin à l'appel comme les espions mettent toujours fin à leurs conversations téléphoniques. En mentant.",shape=box,color=blue];
		j452569286 -> j793084354;
	j1717707290 [label="PapaPolar: et puis, nous avons dit un très gros mensonge.",shape=box,color=blue];
		j1717707290 -> j297783600;
	j297783600 [label="PapaPolar: nous avons dit: \"Ne t'inquiète pas, tout ira bien.\"",shape=box,color=blue];
		j297783600 -> j2913492587;
	j2913492587 [label="MomToxicated: Au moins, nous lui avons dit une dernière chose honnête avant de raccrocher.",shape=box,color=blue];
		j2913492587 -> j2814812434;
	j2814812434 [label="PapaPolar: ouais, c'est bien vrai.",shape=box,color=blue];
		j2814812434 -> j416564505;
		j2814812434 -> j3986532970;
	j416564505 [label="Oh?",shape=box,color=red];
		j416564505 -> j99656812;
	j3986532970 [label="Et c'était?",shape=box,color=red];
		j3986532970 -> j99656812;
	j99656812 [label="PapaPolar: \"Tu es notre petite fille. Et rien ne changera jamais ça.\"",shape=box,color=blue];
		j99656812 -> j1759283182;
	j1759283182 [label="MomToxicated: \"Nous t'aimerons toujours, peu importe où tu iras.\"",shape=box,color=blue];
		j1759283182 -> j3356518675;
		j1759283182 -> j1102483766;
