		1494 -> 1496;
	1495 [label="Chat ends. Next chat will be MinVelRank5Convo2.",color=orange];
	1496 [label="PapaPolar: et sa sale petite belette à l'allure étrange écoutait probablement",shape=box,color=blue];
		1496 -> 1497;
	1497 [label="PapaPolar: à ce moment-là, nous étions encore *techniquement* ensemble, mais les choses se détérioraient, et vite...",shape=box,color=blue];
		1497 -> 1498;
	1498 [label="MomToxicated: Je parie qu'elle le savait. Elle pouvait le sentir. Même si nous ne le savions pas encore à l'époque.",shape=box,color=blue];
		1498 -> 1499;
		1498 -> 1500;
	1499 [label="Pourriez-vous dire si elle était déjà... vous savez. Sous \"son\" emprise?",shape=box,color=red];
		1499 -> 1501;
	1500 [label="De quoi aviez-vous parlé, tous les trois?",shape=box,color=red];
		1500 -> 1502;
	1501 [label="PapaPolar: elle parlait comme notre petite fille, si c'est ce que tu demandes. elle savait quoi dire et comment le dire.",shape=box,color=blue];
		1501 -> 1503;
	1502 [label="MomToxicated: Au début, c'était une conversation de travail. Comment elle gérait le commandement. Elle ne pouvait pas nous donner de chiffres, ni de détails, bien sûr.",shape=box,color=blue];
		1502 -> 1504;
	1503 [label="MomToxicated: Mais tous les bons preneurs d’otages savent faire chanter leurs oiseaux captifs sur commande.",shape=box,color=blue];
		1503 -> 1505;
	1504 [label="MomToxicated: Nous ne faisions pas partie de la Scaldra. Nous n'étions rien de plus que des civils, pour les gens à l'autre bout du fil. Elle ne pouvait donc pas nous donner des informations confidentielles.",shape=box,color=blue];
		1504 -> 1506;
	1505 [label="MomToxicated: Cela ne nous dit rien sur le moment ou la manière dont cette \"Indifférence\" l’a emportée.",shape=box,color=blue];
		1505 -> 1507;
	1506 [label="PapaPolar: mais elle semblait... stressée. on pouvait l'entendre.",shape=box,color=blue];
		1506 -> 1508;
		1506 -> 1509;
	1507 [label="MomToxicated: Ou qui pilotait son corps quand nous lui avons parlé ce jour-là.",shape=box,color=blue];
		1507 -> 1510;
	1508 [label="Elle? Stressée? Difficile à imaginer.",shape=box,color=red];
		1508 -> 1511;
	1509 [label="Stressée à propos de quoi?",shape=box,color=red];
		1509 -> 1512;
	1510 [label="PapaPolar: je ne sais pas comment on trouve un dieu ni comment on lui met un coup de poing dans sa gueule de [SUPPRIMÉ], mais [SUPPRIMÉ], je vais essayer",shape=box,color=blue];
		1510 -> 1506;
	1511 [label="MomToxicated: Heh. Ça arrive aux meilleurs d'entre nous. Surtout quand on poursuit un \"fugitif\".",shape=box,color=blue];
		1511 -> 1513;
	1512 [label="MomToxicated: Un \"fugitif\".",shape=box,color=blue];
		1512 -> 1513;
	1513 [label="MomToxicated: Entrati. À l'époque, je pensais que c'était \"juste\" un baron de la drogue local ou un chef de la résistance.",shape=box,color=blue];
		1513 -> 1514;
	1514 [label="PapaPolar: elle a à peine mentionné les foutues télés zombies. on aurait pu penser qu'elle en parlerait plus.",shape=box,color=blue];
		1514 -> 1515;
	1515 [label="MomToxicated: Je me demande si elle avait déjà perdu son bras à ce moment-là. Impossible de le savoir, j'imagine.",shape=box,color=blue];
		1515 -> 1516;
		1515 -> 1517;
	1516 [label="Comment est-ce que ça c'est terminé?",shape=box,color=red];
		1516 -> 1518;
	1517 [label="Vous lui aviez dit que vous veniez en Höllvanie?",shape=box,color=red];
		1517 -> 1519;
	1518 [label="MomToxicated: À la manière dont les espions mettent fin à leurs conversations téléphoniques. En se mentant mutuellement.",shape=box,color=blue];
		1518 -> 1520;
	1519 [label="PapaPolar: mdr. bien sûr que non. la ville était bouclée, tu te souviens? c'était une opération totalement secrète, on s'est faufilés en douce.",shape=box,color=blue];
		1519 -> 1521;
	1520 [label="MomToxicated: Nous lui avons dit que nous partions en mission ailleurs, alors que nous avions prévu de nous déployer dans sa ville bouclée.",shape=box,color=blue];
		1520 -> 1522;
	1521 [label="MomToxicated: Nous avons mis fin à l'appel comme les espions mettent toujours fin à leurs conversations téléphoniques. En mentant.",shape=box,color=blue];
		1521 -> 1520;
	1522 [label="PapaPolar: et puis, nous avons dit un très gros mensonge.",shape=box,color=blue];
		1522 -> 1523;
	1523 [label="PapaPolar: nous avons dit: \"Ne t'inquiète pas, tout ira bien.\"",shape=box,color=blue];
		1523 -> 1524;
	1524 [label="MomToxicated: Au moins, nous lui avons dit une dernière chose honnête avant de raccrocher.",shape=box,color=blue];
		1524 -> 1525;
	1525 [label="PapaPolar: ouais, c'est bien vrai.",shape=box,color=blue];
		1525 -> 1526;
		1525 -> 1527;
	1526 [label="Oh?",shape=box,color=red];
		1526 -> 1528;
	1527 [label="Et c'était?",shape=box,color=red];
		1527 -> 1528;
	1528 [label="PapaPolar: \"Tu es notre petite fille. Et rien ne changera jamais ça.\"",shape=box,color=blue];
		1528 -> 1529;
	1529 [label="MomToxicated: \"Nous t'aimerons toujours, peu importe où tu iras.\"",shape=box,color=blue];
		1529 -> 1530;
