		j274269721 -> j2404062362;
	j468998992 [label="PapaPolar: elle se souciait des gens sous son commandement comme s'ils étaient SES enfants. SA famille. chacun d'entre eux. je n'ai jamais vu auparavant quelqu'un pleurer sur un cadet arrivé deux jours plus tôt qui s'est fait arracher la main en essayant de désamorcer un engin explosif improvisé.",shape=box,color=blue];
		j468998992 -> j3585047478;
	j31635 [label="MomToxicated: Souriante, ma Neci leur fit signe de s'asseoir à la table et, dans leur langue, impeccablement, leur dit qu'ils avaient énormément de points communs. Plus qu'elle n'en avait vu nulle part ailleurs. Qu'ils étaient frères. Et parfois, les frères se battaient. Mais les frères ne devraient jamais s'entretuer.",shape=box,color=blue];
		j31635 -> j650143364;
	j532154910 [label="MomToxicated: Pourquoi? C'est plus amusant ainsi.",shape=box,color=blue];
		j532154910 -> j3798270694;
	j4254003874 [label="PapaPolar: je ne parlais pas au sens propre. mais il y en a qui vont regretter que ce ne soit pas le cas quand j'en aurai fini avec eux.",shape=box,color=blue];
		j4254003874 -> j1530644912;
	j2404062362 [label="PapaPolar: t'as pas idée.",shape=box,color=blue];
		j2404062362 -> j4168213111;
	j3585047478 [label="PapaPolar: mais elle était là, assise à côté de lui, lui parlant, lui disant que tout irait bien. ce n'était pas le cas. le gosse est mort un mois plus tard lors d'une attaque. mais bon sang, le gamin croyait vraiment que tout serait arc-en-ciel et soleil pour toujours",shape=box,color=blue];
		j3585047478 -> j3125051494;
	j650143364 [label="MomToxicated: Ils ont alors réglé leur conflit territorial en une heure. Ces deux hommes sont partis en amis.",shape=box,color=blue];
		j650143364 -> j3679313336;
	j1530644912 [label="MomToxicated: Soupir.",shape=box,color=blue];
		j1530644912 -> j549991337;
	j3125051494 [label="PapaPolar: parce qu'elle leur a fait croire en ce qu'elle croyait. et elle était là, se battant avec eux. POUR eux. COMME eux.",shape=box,color=blue];
		j3125051494 -> j3277722508;
	j3679313336 [label="MomToxicated: Alors, je ne sais pas ce que tu as rencontré. Mais c'est ma Neci. Celle que j'ai élevée. Pour être plus intelligente que le monde ne le croira jamais - et pour savoir exactement comment utiliser cette intelligence contre eux tous.",shape=box,color=blue];
