		j2971870580 -> j3554789850;
	j3157931849 [label="PapaPolar: neci avait le plus grand cœur que j'aie jamais vu. toujours là pour les gens qui l'entouraient, si tu peux croire ça. il y avait des pays partout dans le monde qui se battaient pour qu'elle aille travailler pour eux.",shape=box,color=blue];
		j3157931849 -> j1128982030;
	j95254677 [label="MomToxicated: Elle a délibérément dit au deuxième seigneur de guerre que le premier lui avait appris une phrase dans sa langue maternelle. Elle a dit que cela signifiait \"Je suis honorée de vous rencontrer\". En réalité, elle a dit \"Vous êtes un gros connard puant\".",shape=box,color=blue];
		j95254677 -> j4038665575;
