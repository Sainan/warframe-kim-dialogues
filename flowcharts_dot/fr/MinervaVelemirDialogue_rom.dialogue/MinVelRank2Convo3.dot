		j513558770 -> j2585871455;
	j1407701178 [label="MomToxicated: Je contesterais ton attribution du terme fanatique même si je comprends ton point de vue, compte tenu de tes interactions avec elle.",shape=box,color=blue];
		j1407701178 -> j3270512044;
	j3591620856 [label="MomToxicated: Je l'ai élevée pour qu'elle puisse exploiter tout son potentiel. Qu'est-ce que tu insinues?",shape=box,color=blue];
		j3591620856 -> j637808842;
	j13949638 [label="PapaPolar: tu as *rencontré* sa mère?",shape=box,color=blue];
		j13949638 -> j1544981344;
	j2585871455 [label="PapaPolar: ouf.",shape=box,color=blue];
		j2585871455 -> j1947897844;
	j3270512044 [label="MomToxicated: Je crois que pour Neci, à l'époque où elle a rejoint la Scaldra, c'était un moyen d'arriver à ses fins. Elle croyait aux gens qui l'entouraient, sans avoir une ferme adhésion à leurs principes. Pas comme Vodyanoi.",shape=box,color=blue];
		j3270512044 -> j1709556059;
	j637808842 [label="PapaPolar: je pense que c'est assez clair, M",shape=box,color=blue];
		j637808842 -> j471356800;
	j1544981344 [label="MomToxicated: Ahem. Dit l'homme qui lui a transmis cette addiction au tabac.",shape=box,color=blue];
		j1544981344 -> j2374385963;
	j1947897844 [label="PapaPolar: écoute. je ne suis même pas sûr qu'elle était vraiment intéressée par tout ce... truc de fanatisme de Sol-Lua",shape=box,color=blue];
		j1947897844 -> j2134514820;
	j1709556059 [label="MomToxicated: Elle a toujours été une femme ambitieuse. Une ambition que j'ai encouragée, nourrie et alimentée. Contrairement à quelqu'un qui souhaitait la geler et la maintenir dans un état d'enfance perpétuelle.",shape=box,color=blue];
		j1709556059 -> j307867486;
	j471356800 [label="PapaPolar: les pommes ne tombent pas loin de l'ampliforme emblématique, ma chère",shape=box,color=blue];
		j471356800 -> j1065655867;
	j2374385963 [label="PapaPolar: ouais, et moi je dis que les pommes ne tombent pas loin de l'ampliforme emblématique, ma chère",shape=box,color=blue];
		j2374385963 -> j3905424141;
	j2134514820 [label="PapaPolar: du moins, pas autant que le reste des Scaldras. pour elle, je pense que c'était simplement un moyen de parvenir à ses fins. ",shape=box,color=blue];
		j2134514820 -> j1267390476;
	j307867486 [label="PapaPolar: c'est moi qui ai dit qu'elle pouvait y aller, non?!",shape=box,color=blue];
		j307867486 -> j1707411454;
	j1065655867 [label="MomToxicated: C'est très drôle. Tu es si spirituel. Permets-moi de saluer ton esprit débordant. Au moins, je ne lui ai pas donné de foutue addiction au tabac.",shape=box,color=blue];
		j1065655867 -> j1376923623;
	j3905424141 [label="PapaPolar: elle a appris ce qu'elle a appris parce que ça marche, mais elle l'a bien appris de quelque part. et tu ne peux pas dire que ce n'est pas vrai.",shape=box,color=blue];
		j3905424141 -> j613110678;
	j1267390476 [label="PapaPolar: dans l'esprit de certaines personnes, toute échelle à gravir vaut la peine d'être gravie.",shape=box,color=blue];
		j1267390476 -> j2280994704;
	j1707411454 [label="MomToxicated: Oh, oui. La seule fois où tu la laisses s'exprimer sans tes lamentations insupportables, c'est la seule fois où tu choisis de ne pas m'écouter, de ne pas me croire et de la laisser partir. Et regarde ce qu'il s'est passé!",shape=box,color=blue];
		j1707411454 -> j155199168;
	j1376923623 [label="MomToxicated: Ce sur quoi Velimir fait des blagues grossières - assez maladroitement - c'est que parfois, en tant que femme, on a des options limitées quant à la façon d'aborder une situation.",shape=box,color=blue];
		j1376923623 -> j3675620941;
	j613110678 [label="PapaPolar: écoute, quand tu es dans l'armée, parfois c'est juste... parfois tu exploites tes talents, non?",shape=box,color=blue];
