		j1993900710 -> j3834466387;
	j487867277 [label="MomToxicated: Elle savait aussi que parfois, la meilleure façon de se sortir d'une situation délicate était de ne pas tirer une seule balle. Elle a un jour désamorcé un conflit armé entre deux seigneurs de guerre juste au sud-est d'ici -",shape=box,color=blue];
		j487867277 -> j95254677;
