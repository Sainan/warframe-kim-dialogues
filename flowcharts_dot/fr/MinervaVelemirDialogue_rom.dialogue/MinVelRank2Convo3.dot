	j1128982030 [label="PapaPolar: pas seulement parce qu'elle était une sacrée bonne espionne. pas parce qu'elle était une sacrée bonne négociatrice. mais parce qu'elle était une véritable meneuse. parce qu'elle avait des idéaux. parce qu'elle se souciait des gens qui se battaient pour elle.",shape=box,color=blue];
		j1128982030 -> j468998992;
	j4038665575 [label="MomToxicated: Cela s'est bien sûr transformé en une dispute entre les deux seigneurs de guerre, jusqu'à ce qu'ils réalisent, au cours de leur dispute, qu'elle n'avait jamais parlé au premier seigneur de guerre. Elle l'avait dit de son propre chef.",shape=box,color=blue];
		j4038665575 -> j31635;
	j664591897 [label="PapaPolar: tu parles de moi. dis-le, tout simplement.",shape=box,color=blue];
		j664591897 -> j532154910;
