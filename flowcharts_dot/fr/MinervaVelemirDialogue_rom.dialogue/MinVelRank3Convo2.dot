		j1230424484 -> j2143451875;
	j1965469043 [label="PapaPolar: merde. ouais. la famille. les amis. ça m'a vraiment manqué, ces derniers temps.",shape=box,color=blue];
		j1965469043 -> j394324488;
	j3882757263 [label="PapaPolar: je te ferai un vrai barbecue libertatien, je te montrerai à quoi ressemble la vraie nourriture. ... aucune idée d'où nous allons trouver des bovins pour faire de la poitrine de bœuf, mais on verra mdr",shape=box,color=blue];
