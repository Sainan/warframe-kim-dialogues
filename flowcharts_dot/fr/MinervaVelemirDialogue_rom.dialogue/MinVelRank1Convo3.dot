digraph {
	"MinVelRank1Convo3 begins." [color=orange];
		"MinVelRank1Convo3 begins." -> j3244786184;
	j3244786184 [label="MomToxicated: Voyageur. On peut parler?",shape=box,color=blue];
		j3244786184 -> j41772839;
		j3244786184 -> j2689436933;
		j3244786184 -> j4260441804;
		j3244786184 -> j4214606425;
	j41772839 [label="Bonjour, Minerva. Si c'est ton vrai nom.",shape=box,color=red];
		j41772839 -> j109970758;
	j2689436933 [label="Nous avons laissé tomber les \"guillemets\", je vois.",shape=box,color=red];
		j2689436933 -> j2615509817;
	j4260441804 [label="Tu demandes, maintenant?",shape=box,color=red];
		j4260441804 -> j2615509817;
	j4214606425 [label="Ouais?",shape=box,color=red];
		j4214606425 -> j2140005091;
	j109970758 [label="+5 Chemistry",color=orange];
		j109970758 -> j451310367;
	j2615509817 [label="MomToxicated: On m'a sermonnée sur mes manières.",shape=box,color=blue];
		j2615509817 -> j4238672510;
	j2140005091 [label="+5 Chemistry",color=orange];
		j2140005091 -> j3886259656;
	j451310367 [label="MomToxicated: Crois-le ou non, mais c'est le cas.",shape=box,color=blue];
		j451310367 -> j3291922194;
	j4238672510 [label="MomToxicated: Ce qui est complètement hystérique, tout bien considéré.",shape=box,color=blue];
		j4238672510 -> j3302343605;
	j3886259656 [label="MomToxicated: Droit au but. Bien.",shape=box,color=blue];
		j3886259656 -> j3302343605;
	j3291922194 [label="MomToxicated: Mais ce n’est pas le sujet.",shape=box,color=blue];
		j3291922194 -> j3302343605;
	j3302343605 [label="MomToxicated: Nous sommes ici en Höllvanie avec un problème à résoudre. Et tu peux m'aider à résoudre ce problème.",shape=box,color=blue];
		j3302343605 -> j1381306058;
	j1381306058 [label="MomToxicated: J'ai donc besoin, et je le demande poliment, de ton aide.",shape=box,color=blue];
		j1381306058 -> j1665254101;
		j1381306058 -> j2006891931;
		j1381306058 -> j2930024411;
	j1665254101 [label="Quel est le problème que je peux selon toi résoudre?",shape=box,color=red];
		j1665254101 -> j2011407724;
	j2006891931 [label="Pourquoi devrais-je t'aider?",shape=box,color=red];
		j2006891931 -> j2011407724;
	j2930024411 [label="Et qu'est-ce que cela a à voir avec Rusalka?",shape=box,color=red];
		j2930024411 -> j2011407724;
	j2011407724 [label="MomToxicated: C'est une très bonne question.",shape=box,color=blue];
		j2011407724 -> j123577835;
	j123577835 [label="MomToxicated: Tu n'as pas à vouloir m'aider pour me faire plaisir. Nous avons un ennemi commun. Cet \"Homme dans le Mur\".",shape=box,color=blue];
		j123577835 -> j1674428265;
	j1674428265 [label="MomToxicated: D'après ce que je peux comprendre, nous sommes tous intéressés par l'endroit où il est allé, ce qu'il recherche et pourquoi il a ciblé Rusalka en premier lieu.",shape=box,color=blue];
		j1674428265 -> j1606846335;
	j1606846335 [label="MomToxicated: C'est bien exact?",shape=box,color=blue];
		j1606846335 -> j3534610185;
		j1606846335 -> j1159191208;
		j1606846335 -> j3552732890;
	j3534610185 [label="Peux-tu prendre un instant pour m'expliquer pourquoi tu tiens tant à Rusalka?",shape=box,color=red];
		j3534610185 -> j1918959348;
	j1159191208 [label="Pour les deux premiers points, oui. Par contre, je me fiche complètement de la raison pour laquelle il s'en est pris à Rusalka.",shape=box,color=red];
		j1159191208 -> j526358858;
	j3552732890 [label="Bien sûr. Ouais. C'est exact.",shape=box,color=red];
		j3552732890 -> j1649464727;
	j1918959348 [label="MomToxicated: Le pourquoi n'est pas important.",shape=box,color=blue];
		j1918959348 -> j275572486;
	j526358858 [label="MomToxicated: Si tu n'en as vraiment rien à faire d'elle, pourquoi avoir épargné sa vie? Nous savons que tu l'as fait. Nous avons entendu l'histoire.",shape=box,color=blue];
		j526358858 -> j2914569611;
		j526358858 -> j3827232149;
		j526358858 -> j3374362462;
	j1649464727 [label="Je déteste avoir à te le dire, mais nous sommes probablement obligés d'attendre la prochaine action de l'Homme dans le Mur.",shape=box,color=red];
		j1649464727 -> j443681426;
	j275572486 [label="PapaPolar: au contraire. et notre camarade l'a probablement déjà compris, de toute façon. ce n'est pas comme si nous étions vraiment subtils",shape=box,color=blue];
		j275572486 -> j2324144904;
	j2914569611 [label="Parce qu'alors, qu'est-ce qui me différencierait de l'Indifférence. De la Scaldra. D'Entrati. Je ne me promène pas en tuant des gens sans raison.",shape=box,color=red];
		j2914569611 -> j1501704287;
	j3827232149 [label="Parce que ce ne sont pas vraiment ses choix qui l'ont amenée là. Ce n'est pas parce que je ne l'ai pas tuée sur le moment que je me soucie suffisamment d'elle pour faire des efforts pour la sauver.",shape=box,color=red];
		j3827232149 -> j2356198800;
	j3374362462 [label="Parce que je n'avais pas l'intention de faire le sale boulot d'Entrati à sa place. S'il voulait tuer la nouvelle marionnette de l'Indifférence, il pouvait le faire lui-même.",shape=box,color=red];
		j3374362462 -> j3477309147;
	j443681426 [label="MomToxicated: Et pourquoi? Tu n'as aucun moyen de le traquer? Lui? Quoi que ce soit? Ou tu ne sais pas ce qu'il cherche vraiment?",shape=box,color=blue];
		j443681426 -> j4045280121;
		j443681426 -> j1606788173;
	j2324144904 [label="PapaPolar: et peut-être, *juste peut-être* que si tu faisais confiance à notre camarade en lui donnant un peu d'informations, tu lui donnerais un peu plus envie de *NOUS AIDER*",shape=box,color=blue];
		j2324144904 -> j3295985167;
	j1501704287 [label="Cela voudrait dire que je tue délibérément des gens. Ce que je ne fais pas. Je veux dire, je tue des gens, mais c'est différent. Tu vois ce que je veux dire.",shape=box,color=red];
		j1501704287 -> j3668487790;
	j2356198800 [label="Je ne la *connaissais* pas.",shape=box,color=red];
		j2356198800 -> j240175903;
	j3477309147 [label="Mais comme je le pensais, le vieux fumier n'aime tirer sur les gens que quand il sait qu'ils se relèveront.",shape=box,color=red];
		j3477309147 -> j472338930;
	j4045280121 [label="On ne peut pas vraiment placer une balise de suivi sur une chose style demi-dieu, non.",shape=box,color=red];
		j4045280121 -> j3934984294;
	j1606788173 [label="Ses motivations nous échappent un peu pour le moment, oui. Mais ce n'est rien de bon.",shape=box,color=red];
		j1606788173 -> j3934984294;
	j3295985167 [label="PapaPolar: c'est comme ça que les gens fonctionnent, parfois. ",shape=box,color=blue];
		j3295985167 -> j224291326;
	j3668487790 [label="+5 Chemistry",color=orange];
		j3668487790 -> j3082067212;
	j240175903 [label="PapaPolar: et nous ne te donnons pas vraiment de raison de t'en soucier. n'est-ce pas, M?",shape=box,color=blue];
		j240175903 -> j2550701631;
	j472338930 [label="PapaPolar: voilà une affirmation très étrange, mais ok",shape=box,color=blue];
		j472338930 -> j1377143222;
		j472338930 -> j3205968491;
	j3934984294 [label="MomToxicated: Alors, tu proposes qu'on s'assoie. Et qu'on attende. Qu'il... ou que ça... lève la tête? Et on se branle en attendant?!",shape=box,color=blue];
		j3934984294 -> j3623579868;
	j224291326 [label="MomToxicated: À quoi cela servirait-il?",shape=box,color=blue];
		j224291326 -> j3162179287;
	j3082067212 [label="PapaPolar: tu parles à deux anciens agents des forces spéciales, on comprend. mdr",shape=box,color=blue];
		j3082067212 -> j3249831394;
	j2550701631 [label="MomToxicated: La ferme, Velimir.",shape=box,color=blue];
		j2550701631 -> j1918959348;
	j1377143222 [label="C'est bon. Je meurs souvent. On s'y habitue.",shape=box,color=red];
		j1377143222 -> j188857763;
	j3205968491 [label="Cela n'a pas vraiment d'importance.",shape=box,color=red];
		j3205968491 -> j1649464727;
		j3205968491 -> j2663026361;
	j3623579868 [label="PapaPolar: au moins, cet endroit offre de la bonne compagnie et un bar sympa?",shape=box,color=blue];
		j3623579868 -> j1464528095;
	j3162179287 [label="PapaPolar: ça ne fait pas de mal d'avoir des amis dans ce monde, M.",shape=box,color=blue];
		j3162179287 -> j1729336241;
	j3249831394 [label="PapaPolar: ce que nous devons faire au nom du \"bien commun\" est parfois assez flou",shape=box,color=blue];
		j3249831394 -> j1574911396;
	j188857763 [label="PapaPolar: ouais ok, ok... bien sûr, camarade... bien sûr...",shape=box,color=blue];
		j188857763 -> j1112888618;
	j2663026361 [label="Pourquoi voulez-vous tellement savoir ce qui est arrivé à Rusalka?",shape=box,color=red];
		j2663026361 -> j1918959348;
	j1464528095 [label="PapaPolar: la musique est plutôt bonne. ce type, Arthur, semble être mon genre de copain de bar",shape=box,color=blue];
		j1464528095 -> j135786134;
	j1729336241 [label="MomToxicated: Pourquoi avons-nous besoin \"d'amis\"?! Nous partirons d'ici dès que nous saurons où nous devons aller pour sauver Neci.",shape=box,color=blue];
		j1729336241 -> j3634755662;
	j1574911396 [label="PapaPolar: c'est pourquoi, lorsque nous pouvons faire quelque chose qui compte, nous le faisons. c'est pourquoi nous sommes ici, pour essayer de sauver Neci",shape=box,color=blue];
		j1574911396 -> j1649464727;
		j1574911396 -> j2663026361;
	j1112888618 [label="PapaPolar: bref...",shape=box,color=blue];
		j1112888618 -> j1649464727;
		j1112888618 -> j2663026361;
	j135786134 [label="MomToxicated: Et quoi, on continue comme ça sans savoir ce qui lui est vraiment arrivé?! Ou si elle va bien?! Ou si elle est vraiment toujours elle-même?!",shape=box,color=blue];
		j135786134 -> j4126420199;
	j3634755662 [label="PapaPolar: je ne sais pas trop. on dirait que ça va être difficile de prédire les mouvements d'un monstre du néant demi-dieu... ou tout machin que ce soit. n'est-ce pas, camarade?",shape=box,color=blue];
		j3634755662 -> j1606788173;
		j3634755662 -> j4045280121;
	j4126420199 [label="MomToxicated: Comment peux-tu rester assis là et accepter ça, Velimir?!",shape=box,color=blue];
		j4126420199 -> j1416965867;
	j1416965867 [label="PapaPolar: je n'ai jamais dit que j'acceptais ça, M! je comprends juste que parfois on doit s'asseoir et attendre le bon moment!",shape=box,color=blue];
		j1416965867 -> j3584307814;
	j3584307814 [label="MomToxicated: J'ai parlé à Eleanor. Elle m'a dit ce qu'elle a ressenti quand elle est entrée en contact avec l'esprit de Neci. Ou ce qu'il en restait.",shape=box,color=blue];
		j3584307814 -> j1883504464;
	j1883504464 [label="MomToxicated: La femme que nous avons élevée. La femme que nous aimions.",shape=box,color=blue];
		j1883504464 -> j2188983027;
	j2188983027 [label="MomToxicated: Qui sait ce que- ",shape=box,color=blue];
		j2188983027 -> j2610097554;
	j2610097554 [label="MomToxicated: Et tu veux parler picole avec Arthur.",shape=box,color=blue];
		j2610097554 -> j2587386453;
	j2587386453 [label="MomToxicated: Du-te dracu, Velimir.",shape=box,color=blue];
		j2587386453 -> j2848022021;
	j2848022021 [label="PapaPolar: eeeeet elle est partie...",shape=box,color=blue];
		j2848022021 -> j4165189794;
		j2848022021 -> j3923599912;
	j4165189794 [label="Elle a dit quoi...?",shape=box,color=red];
		j4165189794 -> j4109494579;
	j3923599912 [label="Je suppose que c'était une grossièreté.",shape=box,color=red];
		j3923599912 -> j1533361838;
	j4109494579 [label="PapaPolar: la joie d'avoir participé à tant d'opérations à l'étranger. pouvoir insulter dans 100 langues différentes",shape=box,color=blue];
		j4109494579 -> j1057258407;
		j4109494579 -> j1387150962;
	j1533361838 [label="PapaPolar: ouais. la joie d'avoir participé à tant d'opérations à l'étranger. pouvoir insulter dans 100 langues différentes",shape=box,color=blue];
		j1533361838 -> j1057258407;
		j1533361838 -> j1387150962;
	j1057258407 [label="Vous êtes... mariés?",shape=box,color=red];
		j1057258407 -> j20196092;
	j1387150962 [label="Vous... vous avez élevé... Rusalka?",shape=box,color=red];
		j1387150962 -> j817723799;
	j20196092 [label="Boolean MinervaVelimir1 is now true.",color=orange];
		j20196092 -> j1106249301;
	j817723799 [label="Boolean MinervaNeci3a is now true.",color=orange];
		j817723799 -> j3412673428;
	j1106249301 [label="PapaPolar: mmm. en quelque sorte. plus vraiment, maintenant. sur le papier seulement. quelque part. dans un pays qui a cessé d'exister vers 1982?",shape=box,color=blue];
		j1106249301 -> j3576983161;
	j3412673428 [label="PapaPolar: plus ou moins. nous étions déployés dans une petite ville à quelques pays au sud d'ici. l'endroit a été ravagé. je l'ai trouvée là-bas, dans un bâtiment, avec ses cheveux roux et sa colère noire.",shape=box,color=blue];
		j3412673428 -> j560386011;
	j3576983161 [label="PapaPolar: est-ce que ça compte?",shape=box,color=blue];
		j3576983161 -> j2629367224;
		j3576983161 -> j857634259;
	j560386011 [label="PapaPolar: elle a essayé de me poignarder six fois avec une cuillère. bahahaha, la petite chose la plus mignonne que tu aies jamais vue.",shape=box,color=blue];
		j560386011 -> j3880310041;
	j2629367224 [label="Ouais, on dirait que vous n'êtes plus vraiment ensemble.",shape=box,color=red];
		j2629367224 -> j3059937781;
	j857634259 [label="Cela explique les disputes, j'imagine.",shape=box,color=red];
		j857634259 -> j1628614307;
	j3880310041 [label="PapaPolar: elle avait ce petit lapin en peluche auquel elle s'accrochait. M lui a dit qu'elle le protégerait au péril de sa vie et qu'elle le garderait en sécurité.",shape=box,color=blue];
		j3880310041 -> j595416348;
	j3059937781 [label="PapaPolar: ça se voit tant que ça?",shape=box,color=blue];
		j3059937781 -> j1628614307;
	j1628614307 [label="PapaPolar: quand Neci est partie pour rejoindre la Scaldra... les choses n'ont plus jamais été comme avant entre nous. c'était la goutte d'eau qui a fait déborder le vase, je suppose.",shape=box,color=blue];
		j1628614307 -> j637584330;
	j595416348 [label="PapaPolar: cela a gagné la confiance de Neci très rapidement. elle a couru vers M et l'a prise dans ses bras. nous avons alors quitté l'armée. et, eh bien, officiellement, nous sommes devenus des \"consultants\".",shape=box,color=blue];
		j595416348 -> j3282640941;
	j637584330 [label="PapaPolar: soupir.",shape=box,color=blue];
		j637584330 -> j1591497506;
	j3282640941 [label="PapaPolar: alors... ouais. on peut dire que c'est nous qui l'avons élevée.",shape=box,color=blue];
		j3282640941 -> j1591497506;
	j1591497506 [label="PapaPolar: très bien, je vais faire ce que je fais le mieux.",shape=box,color=blue];
		j1591497506 -> j1556124108;
	j1556124108 [label="PapaPolar: faire comme si je savais ce que j'ai dit de mal et me convaincre que je ne ferai plus jamais une telle erreur à l'avenir.",shape=box,color=blue];
		j1556124108 -> j2017522426;
	j2017522426 [label="+20 Chemistry",color=orange];
