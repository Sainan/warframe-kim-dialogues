		j3987311211 -> j863196408;
	j3134952852 [label="PapaPolar: HAH. c'est vrai. il t'aimait tellement. une femme qui peut boire des coups de vodka comme lui ET réparer un camion par temps glacial?! VENDU.",shape=box,color=blue];
		j3134952852 -> j3998721767;
	j863196408 [label="PapaPolar: j'ai donné à papa une boîte de cigares à la place. il semblait tout aussi satisfait.",shape=box,color=blue];
		j863196408 -> j149698804;
	j3998721767 [label="PapaPolar: dommage que nous n'ayons jamais réussi à sortir cet appareil photo de là pour lui. cela aurait fait un excellent cadeau d'anniversaire. tant pis.",shape=box,color=blue];
