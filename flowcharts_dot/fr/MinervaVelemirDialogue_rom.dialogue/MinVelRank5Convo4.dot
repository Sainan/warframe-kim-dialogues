		j3690627048 -> j2113104451;
	j149506362 [label="PapaPolar: ouais, alors. mon père, Velimir Volkov I",shape=box,color=blue];
		j149506362 -> j3272658602;
	j2418998891 [label="MomToxicated: Les dieux de l'ancien kémitisme. Bastet, Osiris, Râ, Thot. ",shape=box,color=blue];
		j2418998891 -> j4140949371;
	j2113104451 [label="+20 Chemistry",color=orange];
		j2113104451 -> "Chat ends. Next chat will be MinVelRank6Convo1.";
	j3272658602 [label="PapaPolar: il espionnait pour la Russie pendant la guerre froide, c'est-à-dire à une époque où la Russie et Libertatia étaient extrêmement hostiles l'une envers l'autre",shape=box,color=blue];
		j3272658602 -> j1913648484;
	j4140949371 [label="MomToxicated: Je pouvais voir les rouages de ses méninges fonctionner dans sa tête. \"Peut-être que je rejoindrai un culte.\"",shape=box,color=blue];
		j4140949371 -> j375134803;
	"Chat ends. Next chat will be MinVelRank6Convo1." [color=orange];
	j1913648484 [label="PapaPolar: mais il n'y a pas eu de véritable guerre. juste des menaces, de la propagande, de l'espionnage, des sabotages, des assassinats, des choses comme ça",shape=box,color=blue];
		j1913648484 -> j2329902360;
	j375134803 [label="PapaPolar: j'aurais dû voir toute cette merde avec la scaldra venir, maintenant que j'y pense avec le recul.",shape=box,color=blue];
		j375134803 -> j2479904336;
	j2329902360 [label="PapaPolar: mais papa est passé à l'ouest, à Libertatia. et me voici. ",shape=box,color=blue];
		j2329902360 -> j1413932870;
		j2329902360 -> j3751985968;
	j2479904336 [label="PapaPolar: um. M?",shape=box,color=blue];
		j2479904336 -> j3993428902;
	j1413932870 [label="Pourquoi exactement cherchiez-vous sa caméra dentaire?",shape=box,color=red];
		j1413932870 -> j2908558989;
	j3751985968 [label="Je coince toujours sur l'affaire de la \"caméra dentaire\".",shape=box,color=red];
		j3751985968 -> j3943724073;
	j3993428902 [label="MomToxicated: Oui?",shape=box,color=blue];
		j3993428902 -> j3928977939;
	j2908558989 [label="PapaPolar: papa voulait la récupérer.",shape=box,color=blue];
		j2908558989 -> j1816608499;
	j3943724073 [label="PapaPolar: d'accord, alors disons que tu es un espion et que tu espionnes.",shape=box,color=blue];
		j3943724073 -> j3589949297;
	j3928977939 [label="PapaPolar: je sais que c'est bien trop peu et que c'est bien trop tard, mais je veux le dire en personne et je le dirai encore mille fois...",shape=box,color=blue];
		j3928977939 -> j174930224;
	j1816608499 [label="PapaPolar: j'ai pensé que ce serait un cadeau d'anniversaire sympa.",shape=box,color=blue];
		j1816608499 -> j1292740402;
		j1816608499 -> j191290537;
	j3589949297 [label="PapaPolar: et tu te fais prendre. avec une caméra. pas bon pour toi.",shape=box,color=blue];
		j3589949297 -> j1312360311;
	j174930224 [label="PapaPolar: je suis désolé de ne pas t'avoir fait confiance, de ne pas avoir cru tes informations sur la scaldra quand j'aurais dû. je savais que neci attendait mon approbation pour partir, et...",shape=box,color=blue];
		j174930224 -> j170796044;
	j1292740402 [label="... OK, alors.",shape=box,color=red];
		j1292740402 -> j2549025049;
	j191290537 [label="Vous êtes entrés par effraction dans un grand musée pour voler sa dent... et pour la lui offrir en cadeau d'anniversaire?",shape=box,color=red];
		j191290537 -> j2549025049;
	j1312360311 [label="PapaPolar: alors ils sont devenus vraiment créatifs quant à l'endroit où ils pouvaient placer les appareils d'enregistrement. ",shape=box,color=blue];
		j1312360311 -> j1370549037;
	j170796044 [label="PapaPolar: mon père n'a jamais vraiment approuvé ce que je faisais, quoi que ce soit. je ne voulais pas être comme ça avec elle. je voulais lui laisser faire ses propres choix.",shape=box,color=blue];
		j170796044 -> j3433649384;
	j2549025049 [label="PapaPolar: pourquoi? c'est pas comme ça qu'on fait, dans le futur?",shape=box,color=blue];
		j2549025049 -> j2986230296;
	j1370549037 [label="PapaPolar: et papa avait cette grosse incisive en or, alors ils ont mis une toute petite caméra dedans",shape=box,color=blue];
		j1370549037 -> j1123617112;
	j3433649384 [label="PapaPolar: mais j'aurais dû t'écouter. alors. je suis désolé.",shape=box,color=blue];
		j3433649384 -> j2840600386;
	j2986230296 [label="MomToxicated: Nous sommes une famille étrange, Velimir chéri.",shape=box,color=blue];
		j2986230296 -> j37130963;
	j1123617112 [label="PapaPolar: donc, tout est relatif, mais c'était toujours un appareil photo. dans une dent",shape=box,color=blue];
		j1123617112 -> j37130963;
	j2840600386 [label="MomToxicated: Mais tu as raison. C'était son choix. Et je n'aurais pas dû te le reprocher.",shape=box,color=blue];
		j2840600386 -> j1193679013;
