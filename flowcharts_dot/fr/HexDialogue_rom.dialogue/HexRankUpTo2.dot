	51 [label="H16h V0l7463: AMIR di$count à ton service pour toute réparation, mais faut payer en pièces, s'il te plaît.",shape=box,color=blue];
		51 -> 52;
	52 [label="xX GLIMMER Xx: allô? le nourrir? la question? je sais pas trop comment les choses du futur... fonctionnent...",shape=box,color=blue];
