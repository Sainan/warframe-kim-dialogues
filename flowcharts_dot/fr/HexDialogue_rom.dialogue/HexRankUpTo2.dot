		63 -> 64;
	64 [label="Broadsword: Nous avons beaucoup de nourriture. J'ai fait l'inventaire. Et j'ai remarqué les routines du déjeuner: Quincy mange en premier, seul. Puis Lettie, seule également, les rats ne comptent pas. Amir, mangeur rapide, seul. Aoi et moi mangeons toujours après Amir, mais généralement elle avant moi. Eleanor mange toujours en dernier. Seule.",shape=box,color=blue];
		64 -> 65;
