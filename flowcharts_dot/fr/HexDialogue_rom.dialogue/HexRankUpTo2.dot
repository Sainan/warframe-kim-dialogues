	69 [label="H16h V0l7463: J'adooooore manger, je mangerais avec tout le monde, 6 portions pour Amir! mdr",shape=box,color=blue];
		69 -> 70;
	70 [label="Soldja1Shot1kil: et bien, si Arthur dit que nous avons assez de bouffe, nous devons nourrir ce petit garçon en pleine croissance",shape=box,color=blue];
		70 -> 71;
	71 [label="H16h V0l7463: HÉ, je pense que je suis en fait plus grand que toi, alors pourquoi tu dis ça? Et je pourrais devenir PLUS GRAND encore! Ha!",shape=box,color=blue];
