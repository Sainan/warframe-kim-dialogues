	68 [label="xX GLIMMER Xx: peut-être que tu pourrais te joindre à moi, la prochaine fois? Tout le monde est le bienvenu pour déjeuner avec moi... Je pensais juste que tout le monde voulait passer du temps seul...",shape=box,color=blue];
