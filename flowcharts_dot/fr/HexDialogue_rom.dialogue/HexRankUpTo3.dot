		196 -> 109;
	109 [label="H16h V0l7463: hmm, sans vouloir plomber l'ambiance, j'ai le sentiment que nous inviterions plus de gens à la fête de la déception.",shape=box,color=blue];
		109 -> 110;
	110 [label="Salem: Mais ne devrions-nous pas faire pencher la balance du destin? Même un petit chatouillement sur la balance pourrait s'avérer très intéressant.",shape=box,color=blue];
