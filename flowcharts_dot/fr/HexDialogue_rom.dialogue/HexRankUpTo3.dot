		102 -> 103;
	103 [label="Soldja1Shot1kil: plus de bouches à nourrir... même si Sa Majesté pense qu'on est à l'aise? pas une bonne idée",shape=box,color=blue];
		103 -> 104;
	104 [label="Salem: Je pourrais les repousser. Il suffirait d'une pensée...",shape=box,color=blue];
		104 -> 105;
	105 [label="xX GLIMMER Xx: Je ne peux pas m'empêcher de penser que... même si on fait de notre mieux, pourquoi donner aux gens un faux espoir en leur disant qu'on peut en sauver certains? Ça finira mal pour tout le monde.",shape=box,color=blue];
