	1225 [label="cours... cours... cours...",shape=box,color=blue];
		1225 -> 1229;
	1226 [label="Je ne pense pas que Flare veuille un jour renoncer à son identité personnelle, Lizzie. Mais je ne vois pas non plus l'intérêt d'essayer de te tuer ou de te détruire.",shape=box,color=red];
		1226 -> 1230;
