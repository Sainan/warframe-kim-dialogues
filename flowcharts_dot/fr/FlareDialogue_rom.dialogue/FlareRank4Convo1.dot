	1107 [label="je parle de duviri",shape=box,color=blue];
		1107 -> 1108;
		1107 -> 1109;
		1107 -> 1110;
	1108 [label="J'imagine que cela *donnerait* une bonne leçon à Thrax...",shape=box,color=red];
		1108 -> 1111;
	1109 [label="QUOI. NON! Hors de question!",shape=box,color=red];
