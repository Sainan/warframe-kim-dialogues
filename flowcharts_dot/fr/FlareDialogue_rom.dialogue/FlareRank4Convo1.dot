	1114 [label="Peut-être. Peut-être pas.",shape=box,color=red];
		1114 -> 1117;
		1114 -> 1118;
		1114 -> 1119;
	1115 [label="tu simplifies à outrance la situation. Duviri était – et est – bien plus qu'un simple \"lieu\".",shape=box,color=red];
		1115 -> 1117;
		1115 -> 1118;
		1115 -> 1119;
	1116 [label="et ils m'ont tout raconté sur le petit monde étrange et sauvage dans lequel tu vivais",shape=box,color=blue];
		1116 -> 1111;
	1117 [label="Tu n'as jamais été là. Tu n'y as pas passé des siècles. Tu n'y as pas vécu et tu n'y es pas perdu la vie.",shape=box,color=red];
		1117 -> 1120;
		1117 -> 1121;
		1117 -> 1122;
	1118 [label="Pour aller droit au but, Flare, cet endroit est... autant un reflet de moi-même qu'un conte de fées sur lequel il est basé.",shape=box,color=red];
		1118 -> 1120;
		1118 -> 1121;
		1118 -> 1122;
	1119 [label="Même si mes sentiments à ce sujet ne sont pas vraiment... roses... je ne peux pas simplement y jeter l'Infestation et me tailler.",shape=box,color=red];
