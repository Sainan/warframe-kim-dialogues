		j3295485466 -> j2878102564;
		j3295485466 -> j3031030341;
	j2878102564 [label="Cela semble probable?",shape=box,color=red];
		j2878102564 -> j3906389808;
	j3031030341 [label="Aucune idée.",shape=box,color=red];
		j3031030341 -> j3474523537;
	j3906389808 [label="super",shape=box,color=blue];
		j3906389808 -> j2720101812;
	j3474523537 [label="supposons que ce soit le cas",shape=box,color=blue];
		j3474523537 -> j2720101812;
	j2720101812 [label="mais d'après ce que j'ai pu comprendre en parlant à mes charmants semblables...",shape=box,color=blue];
		j2720101812 -> j83731127;
	j83731127 [label="il y a un endroit où l'Infestation *n'existe pas*",shape=box,color=blue];
		j83731127 -> j1471386182;
	j1471386182 [label="quelque part où nous pourrions l'emprisonner et d'où elle ne *pourrait pas* revenir...",shape=box,color=blue];
		j1471386182 -> j1183568575;
		j1471386182 -> j2810921158;
	j1183568575 [label="Je n'aime vraiment, mais vraiment pas la tournure que ça prend, Flare... de quoi tu parles?",shape=box,color=red];
		j1183568575 -> j3811770572;
	j2810921158 [label="Si tu parles de la jeter dans le Néant... la réponse est non.",shape=box,color=red];
		j2810921158 -> j2510607949;
	j3811770572 [label="je ne parle pas du Néant",shape=box,color=blue];
		j3811770572 -> j325249736;
	j2510607949 [label="Je ne sais pas quel genre de présence l'Infestation a dans le Néant et je ne vais pas aggraver les choses.",shape=box,color=red];
		j2510607949 -> j3811770572;
	j325249736 [label="je parle de duviri",shape=box,color=blue];
		j325249736 -> j2614846020;
		j325249736 -> j1991318385;
		j325249736 -> j947704981;
	j2614846020 [label="J'imagine que cela *donnerait* une bonne leçon à Thrax...",shape=box,color=red];
		j2614846020 -> j98881658;
	j1991318385 [label="QUOI. NON! Hors de question!",shape=box,color=red];
		j1991318385 -> j98881658;
	j947704981 [label="Mais - comment connais-tu Duviri?!",shape=box,color=red];
		j947704981 -> j1508078667;
	j98881658 [label="on dirait que tu ne leur dois aucune faveur après ce qu'ils t'ont fait",shape=box,color=blue];
		j98881658 -> j391058168;
		j98881658 -> j3431576912;
		j98881658 -> j4113564089;
	j1508078667 [label="je peux *parler* aux autres protoframes, tu sais",shape=box,color=blue];
		j1508078667 -> j3593323355;
	j391058168 [label="Qu'est-ce qui te donne le droit de me dire que je devrais l'envoyer directement en enfer?",shape=box,color=red];
		j391058168 -> j3394386008;
		j391058168 -> j2200367252;
		j391058168 -> j2227342387;
	j3431576912 [label="Peut-être. Peut-être pas.",shape=box,color=red];
		j3431576912 -> j3394386008;
		j3431576912 -> j2200367252;
		j3431576912 -> j2227342387;
	j4113564089 [label="tu simplifies à outrance la situation. Duviri était – et est – bien plus qu'un simple \"lieu\".",shape=box,color=red];
		j4113564089 -> j3394386008;
		j4113564089 -> j2200367252;
		j4113564089 -> j2227342387;
	j3593323355 [label="et ils m'ont tout raconté sur le petit monde étrange et sauvage dans lequel tu vivais",shape=box,color=blue];
		j3593323355 -> j98881658;
	j3394386008 [label="Tu n'as jamais été là. Tu n'y as pas passé des siècles. Tu n'y as pas vécu et tu n'y es pas perdu la vie.",shape=box,color=red];
		j3394386008 -> j1829813258;
		j3394386008 -> j3644783348;
		j3394386008 -> j2010113334;
	j2200367252 [label="Pour aller droit au but, Flare, cet endroit est... autant un reflet de moi-même qu'un conte de fées sur lequel il est basé.",shape=box,color=red];
		j2200367252 -> j1829813258;
		j2200367252 -> j3644783348;
		j2200367252 -> j2010113334;
	j2227342387 [label="Même si mes sentiments à ce sujet ne sont pas vraiment... roses... je ne peux pas simplement y jeter l'Infestation et me tailler.",shape=box,color=red];
		j2227342387 -> j1829813258;
		j2227342387 -> j2010113334;
		j2227342387 -> j3644783348;
	j1829813258 [label="Et même si parfois j'aime y retourner et frapper les gens à plusieurs reprises... Ce n'est pas mon vide-ordures.",shape=box,color=red];
		j1829813258 -> j3424029131;
	j3644783348 [label="Que cela me plaise ou non... je suis en quelque sorte, bêtement, la personne responsable de cet endroit.",shape=box,color=red];
		j3644783348 -> j4088286860;
	j2010113334 [label="J’en ai autant de souvenirs agréables que de souvenirs douloureux.",shape=box,color=red];
		j2010113334 -> j75866190;
	j3424029131 [label="Ce n’est donc pas le tien non plus.",shape=box,color=red];
		j3424029131 -> j1657359063;
		j3424029131 -> j3003945200;
		j3424029131 -> j764519056;
	j4088286860 [label="Je dois donc être là pour le protéger quand il est en danger.",shape=box,color=red];
		j4088286860 -> j764519056;
		j4088286860 -> j3003945200;
		j4088286860 -> j1657359063;
	j75866190 [label="Et juste parce que je voulais m'en libérer, cela ne veut pas dire que je veux que tout l'endroit en souffre.",shape=box,color=red];
		j75866190 -> j764519056;
		j75866190 -> j1657359063;
