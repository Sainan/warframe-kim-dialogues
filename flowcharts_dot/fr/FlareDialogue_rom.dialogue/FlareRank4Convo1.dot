	j3478967588 [label="non, non, reste avec moi",shape=box,color=blue];
		j3478967588 -> j2368858602;
	j822068750 [label="donc",shape=box,color=blue];
		j822068750 -> j2368858602;
	j2368858602 [label="lizzie dit qu'elle vient de \"partout et de tout moment\" alors...",shape=box,color=blue];
		j2368858602 -> j2907521513;
	j2907521513 [label="te demander de la traîner dans un futur lointain n'aidera pas, elle reviendra simplement ici",shape=box,color=blue];
		j2907521513 -> j3295485466;
