		j1649141625 -> j3226527239;
	j1771428184 [label="Parfois, je me réveille et j'ai l'impression qu'il y a un autre moi qui vit dans la peau d'un étranger. Que je ne correspond pas à ce qu'il y a en surface. Comme si j'étais un mensonge.",shape=box,color=red];
		j1771428184 -> j608726271;
	j2365776885 [label="Certains jours, je me réveille et j'ai tellement mal que j'ai envie de me cacher dans un trou et de souhaiter que la journée passe. Essayer à nouveau le lendemain. Mais je sais que ça reviendra toujours.",shape=box,color=red];
