	677 [label="Parfois, je me réveille et j'ai l'impression qu'il y a un autre moi qui vit dans la peau d'un étranger. Que je ne correspond pas à ce qu'il y a en surface. Comme si j'étais un mensonge.",shape=box,color=red];
