		693 -> 684;
	694 [label="maintenant que mon... secret est sorti, pour ainsi dire, j'aimerais recommencer à zéro. bonjour. je suis flare. et j'ai désespérément besoin de ton aide pour me débarrasser de la chose qui essaie de me détruire",shape=box,color=blue];
