	j1275739907 [label="Pas sans son consentement.",shape=box,color=red];
		j1275739907 -> j599232363;
	j1151734967 [label="Je... Je ne peux pas. Pardon. Je ne peux pas te laisser \"avoir\" Flare.",shape=box,color=red];
		j1151734967 -> j1049447869;
	j3438798261 [label="Nooooon!! Bien sur que non!!! On ne peut pas lui faire une chose pareille. Pas avec la façon dont le Dokteur a fait les choses",shape=box,color=blue];
		j3438798261 -> j1433758946;
	j599232363 [label="Alors, tu dois lui parler. Lui expliquer que nous ne lui voulons aucun mal!",shape=box,color=blue];
