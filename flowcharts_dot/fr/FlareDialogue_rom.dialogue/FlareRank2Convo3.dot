		j1788160204 -> j3271057574;
	j2111900616 [label="Comment ça?",shape=box,color=red];
		j2111900616 -> j2369399087;
	j3013888274 [label="Vraiment? Les hordes de Techrot et d'Infestés qui essaient toujours de me tuer disent le contraire.",shape=box,color=red];
		j3013888274 -> j2907691260;
	j2369399087 [label="Nous respirons pour toi. Nous saignons pour toi. Nous Nous nourrissons pour toi. Ce démon est-il content?",shape=box,color=blue];
		j2369399087 -> j2001604045;
		j2369399087 -> j4116210302;
	j2907691260 [label="Et tes globules blancs ne t'attaquent-ils pas quand tu es malade?!",shape=box,color=blue];
		j2907691260 -> j3068470451;
	j2001604045 [label="Juste au moment où je pensais que cela ne pouvait pas devenir plus étrange...",shape=box,color=red];
		j2001604045 -> j1567360572;
	j4116210302 [label="Tu es le Helminth?!",shape=box,color=red];
		j4116210302 -> j1027650280;
	j3068470451 [label="Nous sommes Nombreux. Nous sommes l'Éternité. Nous sommes Intemporels. Nous sommes le Tout. Pardonne-nous la minorité que nous ne voyons pas.",shape=box,color=blue];
		j3068470451 -> j2369399087;
	j1567360572 [label="Mmmmhehehehe... pauvre Démon... fait de doigts volés et de jouets Infestés...",shape=box,color=blue];
		j1567360572 -> j959756345;
	j1027650280 [label="Nous sommes TOUT et nous sommes UN",shape=box,color=blue];
		j1027650280 -> j3194070259;
	j959756345 [label="une fois Seul, plus jamais Seul",shape=box,color=blue];
		j959756345 -> j4049564315;
	j3194070259 [label="mais n'aie pas peur",shape=box,color=blue];
		j3194070259 -> j918519733;
	j4049564315 [label="Nous Nous réjouissons",shape=box,color=blue];
		j4049564315 -> j3974792119;
	j918519733 [label="Nous. t'aimons. depuis. toujours.",shape=box,color=blue];
		j918519733 -> j3974792119;
