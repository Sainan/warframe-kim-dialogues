		j3840006572 -> j3196375224;
		j3840006572 -> j3831016412;
	j1644274330 [label="alors là, *j'adorerais* savoir comment tu peux penser que ça pourrait être pire que ça",shape=box,color=blue];
		j1644274330 -> j1367831663;
	j2916682446 [label="c'est de ça que je voulais te parler, en fait...",shape=box,color=blue];
