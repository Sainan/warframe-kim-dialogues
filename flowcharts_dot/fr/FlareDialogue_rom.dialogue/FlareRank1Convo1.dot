		42 -> 47;
	43 [label="je... m'excuse. ce n'est généralement pas comme ça que j'aime agir. cependant, je suis dans une situation qui est... très difficile à décrire",shape=box,color=blue];
		43 -> 48;
	44 [label="il ne s'agit pas de moi qui veux des réponses, cher voyageur de l'espace. il s'agit de moi qui *ai besoin* de réponses",shape=box,color=blue];
		44 -> 49;
	45 [label="je ne pense pas pouvoir exprimer avec des mots à quel point je ne vais pas bien du tout.",shape=box,color=blue];
		45 -> 48;
	46 [label="et le seul homme qui pouvait me donner des réponses à ce sujet - le seul homme qui pouvait me l'expliquer ou se débarrasser d'elle est *parti*",shape=box,color=blue];
		46 -> 50;
	47 [label="alors j'aimerais savoir tout ce que tu sais sur lui, si ça ne te dérange pas",shape=box,color=blue];
		47 -> 51;
	48 [label="et je te rappelle que c'est littéralement mon travail de transposer mes sentiments en mots",shape=box,color=blue];
