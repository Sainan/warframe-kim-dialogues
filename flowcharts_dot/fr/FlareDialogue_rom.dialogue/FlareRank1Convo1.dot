		5 -> 8;
		5 -> 9;
		5 -> 10;
	6 [label="Je dirais que je ne peux pas imaginer qu'il y ait deux versions de moi ici, mais... Bon. Longue histoire. Bref.",shape=box,color=red];
		6 -> 11;
	7 [label="Cela dépend de ce qu'ils ont dit. Mais probablement.",shape=box,color=red];
		7 -> 12;
	8 [label="Rien de mieux à faire, alors tu as décidé de venir faire un tour au zoo. Sympa.",shape=box,color=red];
		8 -> 13;
	9 [label="Vraiment? Rien de mieux à faire? Voilà qui est flatteur. lol.",shape=box,color=red];
		9 -> 14;
	10 [label="Si tu veux me poser des questions, je suis là. N'hésite pas.",shape=box,color=red];
