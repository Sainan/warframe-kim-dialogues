digraph {
	"FlareRank1Convo1 begins." [color=orange];
		"FlareRank1Convo1 begins." -> j2797195155;
	j2797195155 [label="Salut, voyageur de l'espace",shape=box,color=blue];
		j2797195155 -> j1794477531;
		j2797195155 -> j696722716;
	j1794477531 [label="Oh, salut. Flare, c'est ça?",shape=box,color=red];
		j1794477531 -> j1571757171;
	j696722716 [label="Salut! Comment ça va?",shape=box,color=red];
		j696722716 -> j3346222235;
	j1571757171 [label="c'est bien de toi dont les autres expériences scientifiques m'ont parlé, hein?",shape=box,color=blue];
		j1571757171 -> j4018608467;
		j1571757171 -> j2862405991;
	j3346222235 [label="juste ici sans rien de mieux à faire. j'ai un tas de questions à te poser, si tu as le temps",shape=box,color=blue];
		j3346222235 -> j1077441356;
		j3346222235 -> j809040226;
		j3346222235 -> j125495640;
	j4018608467 [label="Je dirais que je ne peux pas imaginer qu'il y ait deux versions de moi ici, mais... Bon. Longue histoire. Bref.",shape=box,color=red];
		j4018608467 -> j599581388;
	j2862405991 [label="Cela dépend de ce qu'ils ont dit. Mais probablement.",shape=box,color=red];
		j2862405991 -> j2799802423;
	j1077441356 [label="Rien de mieux à faire, alors tu as décidé de venir faire un tour au zoo. Sympa.",shape=box,color=red];
		j1077441356 -> j466268806;
	j809040226 [label="Vraiment? Rien de mieux à faire? Voilà qui est flatteur. lol.",shape=box,color=red];
		j809040226 -> j1162311430;
	j125495640 [label="Si tu veux me poser des questions, je suis là. N'hésite pas.",shape=box,color=red];
		j125495640 -> j3275181427;
	j599581388 [label="d'accord. eh bien. ils m'ont expliqué en gros, quoi.",shape=box,color=blue];
		j599581388 -> j3322234454;
	j2799802423 [label="ok...",shape=box,color=blue];
		j2799802423 -> j1117214751;
		j2799802423 -> j3145096451;
	j466268806 [label="+5 Chemistry",color=orange];
		j466268806 -> j1440774916;
	j1162311430 [label="arf, pardon. je voulais pas dire ça comme ça.",shape=box,color=blue];
		j1162311430 -> j3944162469;
	j3275181427 [label="super",shape=box,color=blue];
		j3275181427 -> j3944162469;
	j3322234454 [label="Amir avait... des détails à communiquer, disons. assez rapidement.",shape=box,color=blue];
		j3322234454 -> j1242136502;
	j1117214751 [label="Tu viens pour faire le tour du zoo ou quoi?",shape=box,color=red];
		j1117214751 -> j952070964;
	j3145096451 [label="Comment puis-je t'aider?",shape=box,color=red];
		j3145096451 -> j3944162469;
	j1440774916 [label="oh, par sol, jamais. pardon de donner cette impression. mais je suppose que tu as raison. nous, les protoframes, ne sommes pas les seules expériences scientifiques en ville, n'est-ce pas?",shape=box,color=blue];
		j1440774916 -> j3068565248;
		j1440774916 -> j3196375224;
		j1440774916 -> j3831016412;
	j3944162469 [label="l'infestation. cette pourriture. cette chose qui empoisonne mon sang. j'ai besoin de savoir tout ce que tu sais",shape=box,color=blue];
		j3944162469 -> j3710361186;
	j1242136502 [label="très... très rapidement...",shape=box,color=blue];
		j1242136502 -> j2850897917;
	j952070964 [label="+5 Chemistry",color=orange];
		j952070964 -> j3840006572;
	j3068565248 [label="Ça pourrait être pire.",shape=box,color=red];
		j3068565248 -> j1644274330;
	j3196375224 [label="C'est juste un truc avec lequel on apprend à vivre avec le temps, je suppose.",shape=box,color=red];
		j3196375224 -> j2916682446;
	j3831016412 [label="Non.",shape=box,color=red];
		j3831016412 -> j3223879537;
	j3710361186 [label="en commençant par le début. et si c'est possible. s'il te plaît. *maintenant.*",shape=box,color=blue];
