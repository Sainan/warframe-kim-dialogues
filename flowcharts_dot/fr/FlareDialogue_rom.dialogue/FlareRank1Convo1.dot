		15 -> 20;
	16 [label="Amir avait... des détails à communiquer, disons. assez rapidement.",shape=box,color=blue];
		16 -> 21;
	17 [label="Tu viens pour faire le tour du zoo ou quoi?",shape=box,color=red];
		17 -> 22;
	18 [label="Comment puis-je t'aider?",shape=box,color=red];
		18 -> 20;
	19 [label="oh, par sol, jamais. pardon de donner cette impression. mais je suppose que tu as raison. nous, les protoframes, ne sommes pas les seules expériences scientifiques en ville, n'est-ce pas?",shape=box,color=blue];
		19 -> 23;
		19 -> 24;
		19 -> 25;
