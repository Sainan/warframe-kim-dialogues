	j2719925701 [label="et l'autre avait quelque chose à dire sur un \"guedin de l'espace\", je crois?",shape=box,color=blue];
		j2719925701 -> j3252866707;
		j2719925701 -> j2904530031;
	j3252866707 [label="Mdr. Bon, au moins on peut passer les présentations.",shape=box,color=red];
		j3252866707 -> j1117214751;
		j3252866707 -> j3145096451;
	j1367831663 [label="éclaire-moi",shape=box,color=blue];
		j1367831663 -> j1009301908;
	j3691967630 [label="où est-il allé? entrati? les autres prétendent qu'ils ne savent pas. que toi non plus",shape=box,color=blue];
		j3691967630 -> j1877754314;
	j2766786206 [label="J'ai... pas trop l'impression d'aimer ton attitude.",shape=box,color=red];
		j2766786206 -> j631040601;
	j3151029901 [label="Euh... Cela va prendre du temps, et je ne pense pas que cela te donnera les réponses que tu veux.",shape=box,color=red];
		j3151029901 -> j3928714481;
	j1388155863 [label="Oh, minute. Doucement. Est-ce que ça va?",shape=box,color=red];
		j1388155863 -> j3705248275;
	j2904530031 [label="Ouais. Ça doit être Quincy.",shape=box,color=red];
		j2904530031 -> j1117214751;
		j2904530031 -> j3145096451;
	j1009301908 [label="parce que, pour ce que j'en sais, j'ai un poison dans mon sang qui me fait lentement perdre la tête et qui corrompt mon corps",shape=box,color=blue];
		j1009301908 -> j115896695;
	j1877754314 [label="je dis que c'est des conneries",shape=box,color=blue];
		j1877754314 -> j1310107592;
	j631040601 [label="je... m'excuse. ce n'est généralement pas comme ça que j'aime agir. cependant, je suis dans une situation qui est... très difficile à décrire",shape=box,color=blue];
		j631040601 -> j1334866818;
	j3928714481 [label="il ne s'agit pas de moi qui veux des réponses, cher voyageur de l'espace. il s'agit de moi qui *ai besoin* de réponses",shape=box,color=blue];
		j3928714481 -> j354973874;
	j3705248275 [label="je ne pense pas pouvoir exprimer avec des mots à quel point je ne vais pas bien du tout.",shape=box,color=blue];
		j3705248275 -> j1334866818;
	j115896695 [label="et le seul homme qui pouvait me donner des réponses à ce sujet - le seul homme qui pouvait me l'expliquer ou se débarrasser d'elle est *parti*",shape=box,color=blue];
		j115896695 -> j1702964281;
	j1310107592 [label="alors j'aimerais savoir tout ce que tu sais sur lui, si ça ne te dérange pas",shape=box,color=blue];
		j1310107592 -> j3954902512;
	j1334866818 [label="et je te rappelle que c'est littéralement mon travail de transposer mes sentiments en mots",shape=box,color=blue];
		j1334866818 -> j1456144442;
	j354973874 [label="et je ne pense pas pouvoir exprimer avec des mots à quel point ma situation est différente de celle des autres et à quel point je *dois* de me débarrasser d'elle *immédiatement*",shape=box,color=blue];
		j354973874 -> j173581607;
		j354973874 -> j4054152042;
		j354973874 -> j1353870404;
