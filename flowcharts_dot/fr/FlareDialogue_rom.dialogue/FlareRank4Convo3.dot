	j2350526563 [label="un spécimen absolument parfait dans des vêtements impeccables et une veste moulante. tu aurais pu lancer une pièce d'étain sur son cul et récupérer deux pièces d'argent et une d'or",shape=box,color=blue];
		j2350526563 -> j1062114257;
	j1062114257 [label="chaque centimètre carré de sa personne dégoulinait de classe. le statut. la confiance. l'argent. sa montre coûtait probablement plus cher que ce que je gagne en un an",shape=box,color=blue];
