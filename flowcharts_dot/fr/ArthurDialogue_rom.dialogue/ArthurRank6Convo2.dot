		j3114534350 -> "Chat ends.";
	j3291798491 [label="Ici, ça se joue entre un dieu au sens propre et un homme qui pense en être un.",shape=box,color=blue];
		j3291798491 -> j2690758905;
	j2088695406 [label="Je ne veux pas être relégué au second plan de l'histoire. Je veux lui mettre ce Skana directement dans le cul.",shape=box,color=blue];
		j2088695406 -> j1047754578;
		j2088695406 -> j920655445;
	j3184028115 [label="C'est peut-être la pilule que j'ai du mal à avaler, camarade.",shape=box,color=blue];
		j3184028115 -> "Chat ends.";
	j3204655265 [label="Pour ce que ça vaut? J'espère que non.",shape=box,color=blue];
		j3204655265 -> j3979730784;
	j3847318570 [label="Pour ce que ça vaut? Je l'espère aussi.",shape=box,color=blue];
		j3847318570 -> j3979730784;
	j2690758905 [label="Je parie sur une collision inévitable. Je ne pense pas que leur ego permettrait un autre dénouement.",shape=box,color=blue];
		j2690758905 -> j2393683795;
		j2690758905 -> j636180555;
	j1047754578 [label="Je vais voir ce que je peux faire. ;)",shape=box,color=red];
		j1047754578 -> j1977055833;
	j920655445 [label="Toi et moi, ensemble. Et peut-être Entrati, tant qu'on y est.",shape=box,color=red];
		j920655445 -> j3177554268;
	j3979730784 [label="Il n'y a pas de vainqueurs à la guerre. Seulement des survivants.",shape=box,color=blue];
