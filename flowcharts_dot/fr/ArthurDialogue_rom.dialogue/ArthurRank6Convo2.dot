		3300 -> 3308;
		3300 -> 3309;
		3300 -> 3310;
	3301 [label="C'est peut-être en partie ça. Si l'Indifférence est une des raisons pour lesquelles je suis comme ça? Et que j'ai dû traverser tout ça?",shape=box,color=blue];
		3301 -> 3311;
	3302 [label="Camarade, j'étais prêt à prendre ma retraite avant de me laisser entraîner dans ces conneries. De justesse.",shape=box,color=blue];
		3302 -> 3312;
	3303 [label="Peut-être. Peut-être pas. Mais combien de sacrifices ne servent à rien, dans la vie? La plupart.",shape=box,color=blue];
