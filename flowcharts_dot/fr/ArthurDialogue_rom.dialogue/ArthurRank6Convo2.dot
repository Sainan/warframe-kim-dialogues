		j1648722223 -> j2719538405 [label=true,color=green];
		j1648722223 -> j3114534350 [label=false,color=brown];
	j3737440803 [label="C'est un argument valable. Mais c'était une affaire entre pays, ça impliquait de la diplomatie. Des éléments mobiles.",shape=box,color=blue];
		j3737440803 -> j3291798491;
	j2278019319 [label="+5 Chemistry",color=orange];
		j2278019319 -> j2088695406;
	j563403590 [label="Me faire dire de souffrir et de me sacrifier, sans vraiment savoir pourquoi. Ni dans quel but.",shape=box,color=blue];
		j563403590 -> j3184028115;
	j3136199770 [label="+5 Chemistry",color=orange];
		j3136199770 -> j3204655265;
	j3780121090 [label="+5 Chemistry",color=orange];
		j3780121090 -> j3847318570;
