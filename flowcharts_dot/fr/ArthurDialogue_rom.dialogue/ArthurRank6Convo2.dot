digraph {
	"ArthurRank6Convo2 begins." [color=orange];
		"ArthurRank6Convo2 begins." -> j3897417692;
	j3897417692 [label="J'ai pensé à quelque chose. Combien d'entre nous y a-t-il encore, à ton avis?",shape=box,color=blue];
		j3897417692 -> j1823891516;
		j3897417692 -> j962847502;
	j1823891516 [label="Tu veux dire ici, en 1999, ou dans un sens plus large?",shape=box,color=red];
		j1823891516 -> j1140486179;
	j962847502 [label="\"Nous\", tu veux dire quoi?",shape=box,color=red];
		j962847502 -> j3001282824;
	j1140486179 [label="Les deux, je suppose. Ici, maintenant, dans le passé... et dans le futur.",shape=box,color=blue];
		j1140486179 -> j646447708;
	j3001282824 [label="Des Protoframes. Ici, ou n'importe où. Ou n'importe quand, j'imagine.",shape=box,color=blue];
		j3001282824 -> j646447708;
	j646447708 [label="Entrati nous a créés dans un but précis. Avec des objectifs multiples. Il est clair que cela allait au-delà de nous six. ",shape=box,color=blue];
		j646447708 -> j1871424982;
		j646447708 -> j2015148909;
	j1871424982 [label="Au début, je pensais qu'il fabriquait des Warframes \"de rechange\" au cas où la mienne ne passerait pas par le Helminth. Maintenant, je ne sais plus trop.",shape=box,color=red];
		j1871424982 -> j548950187;
	j2015148909 [label="J'aimerais vraiment savoir ce qu'il manigançait. Ou quelles étaient ses véritables motivations pour créer davantage de Protoframes.",shape=box,color=red];
		j2015148909 -> j1290792888;
	j548950187 [label="Cela avait du sens quand nous n’étions que six.",shape=box,color=blue];
		j548950187 -> j1290792888;
	j1290792888 [label="Tu crois honnêtement que sa véritable motivation est de mettre fin à l’Indifférence?",shape=box,color=blue];
		j1290792888 -> j687896320;
	j687896320 [label="Pouvons-nous *réellement* lui faire confiance?",shape=box,color=blue];
		j687896320 -> j330020663;
		j687896320 -> j2525210556;
		j687896320 -> j4266538203;
	j330020663 [label="Honnêtement, je ne sais pas. Ma confiance en lui ne va pas plus loin que la distance à laquelle je pourrais le lancer. Et sans Warframe, je ne lance pas bien loin.",shape=box,color=red];
		j330020663 -> j2629986148;
	j2525210556 [label="Non. Nous ne pouvons pas avoir confiance en ses motivations, pas plus qu’en ses méthodes.",shape=box,color=red];
		j2525210556 -> j1861007979;
		j2525210556 -> j2625703668;
	j4266538203 [label="Mouais. Je ne suis pas toujours d'accord avec ses méthodes. Mais oui, il veut arrêter ça.",shape=box,color=red];
		j4266538203 -> j2625703668;
		j4266538203 -> j1861007979;
	j2629986148 [label="+5 Chemistry",color=orange];
		j2629986148 -> j3606749468;
	j1861007979 [label="Il essaie de remettre le génie dans la bouteille, si c'est possible. Et c'est un processus compliqué.",shape=box,color=red];
		j1861007979 -> j387846565;
	j2625703668 [label="Mais on n'a pas vraiment le choix, n'est-ce pas? Tout ce que le gamin et moi pouvons faire, c'est le suivre et nettoyer son merdier.",shape=box,color=red];
		j2625703668 -> j3728551303;
		j2625703668 -> j4283997856;
	j3606749468 [label="Hé.",shape=box,color=blue];
		j3606749468 -> j1861007979;
		j3606749468 -> j2625703668;
	j387846565 [label="Et nous sommes les bonniches, qui récurons le sol après son passage. C'est adorable.",shape=box,color=blue];
		j387846565 -> j3728551303;
		j387846565 -> j4283997856;
	j3728551303 [label="Maintenant que Kaya a sa propre idée concernant le voyage dans le temps, il me sera peut-être plus facile d'aller et venir.",shape=box,color=red];
		j3728551303 -> j852367038;
	j4283997856 [label="Mais je reste ici, donc c'est au gamin de jouer, maintenant.",shape=box,color=red];
		j4283997856 -> j161265069;
	j852367038 [label="La petite est parfois pénible, mais j'apprécie son aide.",shape=box,color=blue];
		j852367038 -> j515787435;
	j161265069 [label="Check boolean ArthurDating",color=orange];
		j161265069 -> j703141328 [label=true,color=green];
		j161265069 -> j1964189917 [label=false,color=brown];
	j515787435 [label="C'est agréable de savoir que lorsque tu vas faire un tour au magasin... tu pourrais bien revenir... :/",shape=box,color=blue];
		j515787435 -> j2613732724;
	j703141328 [label="Eh. On verra. Je te connais bien, mon amour. Et je sais que tu ne sais pas quand garder la tête baissée.",shape=box,color=blue];
		j703141328 -> j1923100648;
	j1964189917 [label="Eh. On verra. Je te connais bien, Voyageur. Et je sais que tu ne sais pas quand garder la tête baissée.",shape=box,color=blue];
		j1964189917 -> j1965259297;
	j2613732724 [label="Check boolean ArthurDating",color=orange];
		j2613732724 -> j1668163564 [label=true,color=green];
		j2613732724 -> j723675233 [label=false,color=brown];
		j2613732724 -> j1330550923 [label=false,color=brown];
	j1923100648 [label="C'est l'une des raisons pour lesquelles je t'adore autant ;)",shape=box,color=blue];
		j1923100648 -> j1330550923;
	j1965259297 [label="C'est l'une des raisons pour lesquelles je supporte ta présence ;)",shape=box,color=blue];
		j1965259297 -> j723675233;
	j1668163564 [label="Je lui dois beaucoup, elle qui me donne un semblant de tranquillité d'esprit :)",shape=box,color=blue];
		j1668163564 -> j723675233;
		j1668163564 -> j1330550923;
	j723675233 [label="Une émoticône! :D",shape=box,color=red];
		j723675233 -> j3483138265;
	j1330550923 [label="Attention à ne pas te noyer dans l'eau de rose... ",shape=box,color=red];
		j1330550923 -> j1486369420;
	j3483138265 [label="Ouais, ouais. Ne t'y habitue pas. Ça me semble toujours bizarre.",shape=box,color=blue];
		j3483138265 -> j1626527634;
	j1486369420 [label="Mm, tu me connais. Croustillant à l'extérieur, moelleux au centre. Comme un cousin rassis de ces horribles pâtisseries dont Amir et Velimir ne cessent de parler.",shape=box,color=blue];
		j1486369420 -> j1765929575;
	j1626527634 [label="Eh bien, c'est flatteur.",shape=box,color=red];
		j1626527634 -> j4033975216;
	j1765929575 [label="Des Tweebies?",shape=box,color=blue];
		j1765929575 -> j4033975216;
	j4033975216 [label="Bref. Revenons au sujet. Parfois, j'ai le sentiment désagréable qu'Entrati a un objectif plus important pour nous tous.",shape=box,color=blue];
		j4033975216 -> j3180659687;
		j4033975216 -> j2784054934;
		j4033975216 -> j2316792277;
	j3180659687 [label="Qu'est-ce qui te fait dire ça?",shape=box,color=red];
		j3180659687 -> j2885727796;
	j2784054934 [label="Ouais, tu as peut-être raison.",shape=box,color=red];
		j2784054934 -> j349200702;
	j2316792277 [label="Serait-ce juste un vœu pieux?",shape=box,color=red];
		j2316792277 -> j2641708624;
	j2885727796 [label="Tous les efforts qu'il a déployés pour nous créer? Et le fait qu'il n'y a pas que nous six...",shape=box,color=blue];
		j2885727796 -> j3200571073;
	j349200702 [label="Qu'est-ce que tu crois que c'est? Et qu'attend-il?",shape=box,color=blue];
		j349200702 -> j1066658043;
		j349200702 -> j3196322429;
	j2641708624 [label="Que veux-tu dire?",shape=box,color=blue];
		j2641708624 -> j2261079646;
		j2641708624 -> j912791032;
	j3200571073 [label="Tu ne construis pas des armes pareilles à moins de savoir que tu vas les utiliser, camarade.",shape=box,color=blue];
		j3200571073 -> j1505963977;
	j1066658043 [label="<RETRO_EMOJI_SHRUG>",shape=box,color=red];
		j1066658043 -> j4097573429;
	j3196322429 [label="J’aimerais avoir réponse à ces deux questions.",shape=box,color=red];
		j3196322429 -> j4097573429;
	j2261079646 [label="Parfois, il est difficile de penser qu'on n'est plus \"important\".",shape=box,color=red];
		j2261079646 -> j222354514;
	j912791032 [label="Eh bien, je dis juste que... peut-être que tu ne veux pas te sentir abandonné par lui.",shape=box,color=red];
		j912791032 -> j3270461711;
	j1505963977 [label="À moins que tu ne *saches* qu'il va y avoir une guerre.",shape=box,color=blue];
		j1505963977 -> j1898595695;
		j1505963977 -> j910723369;
		j1505963977 -> j3773238408;
	j4097573429 [label="Peut-être qu'il a besoin d'une armée? Peut-être qu'il cherche \"la seule chose\" qui, selon lui, puisse vaincre l'Indifférence. Peut-être... beaucoup de choses.",shape=box,color=red];
		j4097573429 -> j1948361313;
	j222354514 [label="Ok...",shape=box,color=blue];
		j222354514 -> "Chat ends.";
	j3270461711 [label="Que ce pour quoi il était là, ce qu'il t'a fait, ça compte toujours. C'est toujours valable. Ça n'a pas échoué.",shape=box,color=red];
		j3270461711 -> j3114335122;
		j3270461711 -> j982865615;
	j1898595695 [label="Alors, tout ce que nous pouvons faire, c’est être prêts si cela se produit.",shape=box,color=red];
		j1898595695 -> j415671942;
	j910723369 [label="C'est possible. Mais Entrati semble aussi être du genre à avoir des plans de secours. ",shape=box,color=red];
		j910723369 -> j1136304149;
	j3773238408 [label="Je ne sais pas. Minerva et Velimir me parlaient de la... \"Guerre froide\"? On dirait que les gens ont fabriqué des armes folles et ne les ont jamais utilisées.",shape=box,color=red];
		j3773238408 -> j4169311289;
	j1948361313 [label="Je ne peux m'empêcher de penser que nous sommes des balles dans un fusil. Conçues pour être utilisées. Et jetées.",shape=box,color=blue];
		j1948361313 -> j3904348610;
		j1948361313 -> j3705461300;
	"Chat ends." [color=orange];
	j3114335122 [label="Et pour être clair, tu comptes toujours.",shape=box,color=red];
		j3114335122 -> j2008468299;
		j3114335122 -> j1672764707;
		j3114335122 -> j252922772;
	j982865615 [label="Et pour être clair, tu comptes toujours pour *moi*. ",shape=box,color=red];
		j982865615 -> j2008468299;
		j982865615 -> j1672764707;
		j982865615 -> j252922772;
	j415671942 [label="+5 Chemistry",color=orange];
		j415671942 -> j3107931750;
	j1136304149 [label="Peut-être.",shape=box,color=blue];
		j1136304149 -> j2261642751;
	j4169311289 [label="C'est un argument valable. Mais c'était une affaire entre pays, ça impliquait de la diplomatie. Des éléments mobiles.",shape=box,color=blue];
		j4169311289 -> j3581731291;
	j3904348610 [label="J'aimerais pouvoir te le dire. Mais je ferai tout mon possible pour éviter que cela n'arrive.",shape=box,color=red];
		j3904348610 -> j1031383790;
	j3705461300 [label="Tu ne penses pas que c'est terminé?",shape=box,color=red];
		j3705461300 -> j613297139;
	j2008468299 [label="Mais penser que ton histoire s'arrête là, sans avoir joué un rôle dans son dénouement? C'est nul.",shape=box,color=red];
		j2008468299 -> j3907345306;
	j1672764707 [label="Mais peut-être que ça fait mal de penser que tu as été remplacé par un Arthur 2.0 quelque part.",shape=box,color=red];
		j1672764707 -> j4096525701;
	j252922772 [label="Mais peut-être que tu veux simplement que tes sacrifices comptent toujours dans un sens plus cosmique de la chose?",shape=box,color=red];
		j252922772 -> j4259692109;
	j3107931750 [label="D'accord.",shape=box,color=blue];
		j3107931750 -> j1680344939;
	j2261642751 [label="Une partie de moi espère qu'il y en a d'autres comme nous. Mais s'ils finissent par venir ici, on aura peut-être besoin d'un centre commercial plus grand.",shape=box,color=blue];
		j2261642751 -> "Chat ends.";
	j3581731291 [label="Ici, ça se joue entre un dieu au sens propre et un homme qui pense en être un.",shape=box,color=blue];
		j3581731291 -> j2351357383;
	j1031383790 [label="Je sais que tu le feras. Et nous affronterons ce jour ensemble, j'en suis convaincu.",shape=box,color=blue];
		j1031383790 -> j2397353713;
	j613297139 [label="Non. Tu ne construis pas des armes pareilles à moins de savoir que tu vas les utiliser, camarade.",shape=box,color=blue];
		j613297139 -> j667021188;
		j613297139 -> j910723369;
		j613297139 -> j1898595695;
	j3907345306 [label="C'est peut-être en partie ça. Si l'Indifférence est une des raisons pour lesquelles je suis comme ça? Et que j'ai dû traverser tout ça?",shape=box,color=blue];
		j3907345306 -> j3430282083;
	j4096525701 [label="Camarade, j'étais prêt à prendre ma retraite avant de me laisser entraîner dans ces conneries. De justesse.",shape=box,color=blue];
		j4096525701 -> j3679993647;
	j4259692109 [label="Peut-être. Peut-être pas. Mais combien de sacrifices ne servent à rien, dans la vie? La plupart.",shape=box,color=blue];
		j4259692109 -> j2013639072;
	j1680344939 [label="Et j'espère que si d'autres comme nous viennent ici, nous n'aurons pas besoin d'un centre commercial plus grand.",shape=box,color=blue];
		j1680344939 -> "Chat ends.";
	j2351357383 [label="Je parie sur une collision inévitable. Je ne pense pas que leur ego permettrait un autre dénouement.",shape=box,color=blue];
		j2351357383 -> j2393683795;
		j2351357383 -> j636180555;
	j2397353713 [label="+5 Chemistry",color=orange];
		j2397353713 -> j1648722223;
	j667021188 [label="Je ne sais pas. Minerva et Velimir me parlaient de la... \"Guerre froide\"? On dirait que les gens ont fabriqué des armes folles et ne les ont jamais utilisées.",shape=box,color=red];
		j667021188 -> j3737440803;
	j3430282083 [label="Je veux être là pour l'achever.",shape=box,color=blue];
		j3430282083 -> j2278019319;
	j3679993647 [label="Je suis toujours étonné par ton talent à mettre les pieds dans le plat, parfois.",shape=box,color=blue];
		j3679993647 -> "Chat ends.";
	j2013639072 [label="Peut-être que je pleure simplement l'idée que nous soyons toute une armée créée par un fou sans savoir vraiment pourquoi. Ni dans quel but.",shape=box,color=blue];
		j2013639072 -> j563403590;
	j2393683795 [label="Tu as peut-être raison.",shape=box,color=red];
		j2393683795 -> j3136199770;
	j636180555 [label="J'espère vraiment que tu as tort.",shape=box,color=red];
		j636180555 -> j3780121090;
