digraph {
	3229 [label="ArthurRank6Convo2 begins.",color=orange];
		3229 -> 3230;
	3230 [label="J'ai pensé à quelque chose. Combien d'entre nous y a-t-il encore, à ton avis?",shape=box,color=blue];
		3230 -> 3231;
		3230 -> 3232;
	3231 [label="Tu veux dire ici, en 1999, ou dans un sens plus large?",shape=box,color=red];
		3231 -> 3233;
	3232 [label="\"Nous\", tu veux dire quoi?",shape=box,color=red];
		3232 -> 3234;
	3233 [label="Les deux, je suppose. Ici, maintenant, dans le passé... et dans le futur.",shape=box,color=blue];
		3233 -> 3235;
	3234 [label="Des Protoframes. Ici, ou n'importe où. Ou n'importe quand, j'imagine.",shape=box,color=blue];
		3234 -> 3235;
	3235 [label="Entrati nous a créés dans un but précis. Avec des objectifs multiples. Il est clair que cela allait au-delà de nous six. ",shape=box,color=blue];
		3235 -> 3236;
		3235 -> 3237;
	3236 [label="Au début, je pensais qu'il fabriquait des Warframes \"de rechange\" au cas où la mienne ne passerait pas par le Helminth. Maintenant, je ne sais plus trop.",shape=box,color=red];
		3236 -> 3238;
	3237 [label="J'aimerais vraiment savoir ce qu'il manigançait. Ou quelles étaient ses véritables motivations pour créer davantage de Protoframes.",shape=box,color=red];
		3237 -> 3239;
	3238 [label="Cela avait du sens quand nous n’étions que six.",shape=box,color=blue];
		3238 -> 3239;
	3239 [label="Tu crois honnêtement que sa véritable motivation est de mettre fin à l’Indifférence?",shape=box,color=blue];
		3239 -> 3240;
	3240 [label="Pouvons-nous *réellement* lui faire confiance?",shape=box,color=blue];
		3240 -> 3241;
		3240 -> 3242;
		3240 -> 3243;
	3241 [label="Honnêtement, je ne sais pas. Ma confiance en lui ne va pas plus loin que la distance à laquelle je pourrais le lancer. Et sans Warframe, je ne lance pas bien loin.",shape=box,color=red];
		3241 -> 3244;
	3242 [label="Non. Nous ne pouvons pas avoir confiance en ses motivations, pas plus qu’en ses méthodes.",shape=box,color=red];
		3242 -> 3245;
		3242 -> 3246;
	3243 [label="Mouais. Je ne suis pas toujours d'accord avec ses méthodes. Mais oui, il veut arrêter ça.",shape=box,color=red];
		3243 -> 3246;
		3243 -> 3245;
	3244 [label="+5 Chemistry",color=orange];
		3244 -> 3247;
	3245 [label="Il essaie de remettre le génie dans la bouteille, si c'est possible. Et c'est un processus compliqué.",shape=box,color=red];
		3245 -> 3248;
	3246 [label="Mais on n'a pas vraiment le choix, n'est-ce pas? Tout ce que le gamin et moi pouvons faire, c'est le suivre et nettoyer son merdier.",shape=box,color=red];
		3246 -> 3249;
		3246 -> 3250;
	3247 [label="Hé.",shape=box,color=blue];
		3247 -> 3245;
		3247 -> 3246;
	3248 [label="Et nous sommes les bonniches, qui récurons le sol après son passage. C'est adorable.",shape=box,color=blue];
		3248 -> 3249;
		3248 -> 3250;
	3249 [label="Maintenant que Kaya a sa propre idée concernant le voyage dans le temps, il me sera peut-être plus facile d'aller et venir.",shape=box,color=red];
		3249 -> 3251;
	3250 [label="Mais je reste ici, donc c'est au gamin de jouer, maintenant.",shape=box,color=red];
		3250 -> 3254;
	3251 [label="La petite est parfois pénible, mais j'apprécie son aide.",shape=box,color=blue];
		3251 -> 3253;
	3254 [label="Check boolean ArthurDating",color=orange];
		3254 -> 3603 [label=true,color=green];
		3254 -> 3252 [label=false,color=brown];
	3253 [label="C'est agréable de savoir que lorsque tu vas faire un tour au magasin... tu pourrais bien revenir... :/",shape=box,color=blue];
		3253 -> 3255;
	3603 [label="Eh. On verra. Je te connais bien, mon amour. Et je sais que tu ne sais pas quand garder la tête baissée.",shape=box,color=blue];
		3603 -> 3257;
	3252 [label="Eh. On verra. Je te connais bien, Voyageur. Et je sais que tu ne sais pas quand garder la tête baissée.",shape=box,color=blue];
		3252 -> 3256;
	3255 [label="Check boolean ArthurDating",color=orange];
		3255 -> 3260 [label=true,color=green];
		3255 -> 3258 [label=false,color=brown];
		3255 -> 3259 [label=false,color=brown];
	3257 [label="C'est l'une des raisons pour lesquelles je t'adore autant ;)",shape=box,color=blue];
		3257 -> 3259;
	3256 [label="C'est l'une des raisons pour lesquelles je supporte ta présence ;)",shape=box,color=blue];
		3256 -> 3258;
	3260 [label="Je lui dois beaucoup, elle qui me donne un semblant de tranquillité d'esprit :)",shape=box,color=blue];
		3260 -> 3258;
		3260 -> 3259;
	3258 [label="Une émoticône! :D",shape=box,color=red];
		3258 -> 3261;
	3259 [label="Attention à ne pas te noyer dans l'eau de rose... ",shape=box,color=red];
		3259 -> 3262;
	3261 [label="Ouais, ouais. Ne t'y habitue pas. Ça me semble toujours bizarre.",shape=box,color=blue];
		3261 -> 3263;
	3262 [label="Mm, tu me connais. Croustillant à l'extérieur, moelleux au centre. Comme un cousin rassis de ces horribles pâtisseries dont Amir et Velimir ne cessent de parler.",shape=box,color=blue];
		3262 -> 3264;
	3263 [label="Eh bien, c'est flatteur.",shape=box,color=red];
		3263 -> 3265;
	3264 [label="Des Tweebies?",shape=box,color=blue];
		3264 -> 3265;
	3265 [label="Bref. Revenons au sujet. Parfois, j'ai le sentiment désagréable qu'Entrati a un objectif plus important pour nous tous.",shape=box,color=blue];
		3265 -> 3266;
		3265 -> 3267;
		3265 -> 3268;
	3266 [label="Qu'est-ce qui te fait dire ça?",shape=box,color=red];
		3266 -> 3269;
	3267 [label="Ouais, tu as peut-être raison.",shape=box,color=red];
		3267 -> 3270;
	3268 [label="Serait-ce juste un vœu pieux?",shape=box,color=red];
		3268 -> 3271;
	3269 [label="Tous les efforts qu'il a déployés pour nous créer? Et le fait qu'il n'y a pas que nous six...",shape=box,color=blue];
		3269 -> 3272;
	3270 [label="Qu'est-ce que tu crois que c'est? Et qu'attend-il?",shape=box,color=blue];
		3270 -> 3273;
		3270 -> 3274;
	3271 [label="Que veux-tu dire?",shape=box,color=blue];
		3271 -> 3275;
		3271 -> 3276;
	3272 [label="Tu ne construis pas des armes pareilles à moins de savoir que tu vas les utiliser, camarade.",shape=box,color=blue];
		3272 -> 3277;
	3273 [label="<RETRO_EMOJI_SHRUG>",shape=box,color=red];
		3273 -> 3278;
	3274 [label="J’aimerais avoir réponse à ces deux questions.",shape=box,color=red];
		3274 -> 3278;
	3275 [label="Parfois, il est difficile de penser qu'on n'est plus \"important\".",shape=box,color=red];
		3275 -> 3279;
	3276 [label="Eh bien, je dis juste que... peut-être que tu ne veux pas te sentir abandonné par lui.",shape=box,color=red];
		3276 -> 3280;
	3277 [label="À moins que tu ne *saches* qu'il va y avoir une guerre.",shape=box,color=blue];
		3277 -> 3281;
		3277 -> 3282;
		3277 -> 3283;
	3278 [label="Peut-être qu'il a besoin d'une armée? Peut-être qu'il cherche \"la seule chose\" qui, selon lui, puisse vaincre l'Indifférence. Peut-être... beaucoup de choses.",shape=box,color=red];
		3278 -> 3284;
	3279 [label="Ok...",shape=box,color=blue];
		3279 -> 3285;
	3280 [label="Que ce pour quoi il était là, ce qu'il t'a fait, ça compte toujours. C'est toujours valable. Ça n'a pas échoué.",shape=box,color=red];
		3280 -> 3286;
		3280 -> 3287;
	3281 [label="Alors, tout ce que nous pouvons faire, c’est être prêts si cela se produit.",shape=box,color=red];
		3281 -> 3288;
	3282 [label="C'est possible. Mais Entrati semble aussi être du genre à avoir des plans de secours. ",shape=box,color=red];
		3282 -> 3289;
	3283 [label="Je ne sais pas. Minerva et Velimir me parlaient de la... \"Guerre froide\"? On dirait que les gens ont fabriqué des armes folles et ne les ont jamais utilisées.",shape=box,color=red];
		3283 -> 3290;
	3284 [label="Je ne peux m'empêcher de penser que nous sommes des balles dans un fusil. Conçues pour être utilisées. Et jetées.",shape=box,color=blue];
		3284 -> 3291;
		3284 -> 3292;
	3285 [label="Chat ends.",color=orange];
	3286 [label="Et pour être clair, tu comptes toujours.",shape=box,color=red];
		3286 -> 3293;
		3286 -> 3294;
		3286 -> 3295;
	3287 [label="Et pour être clair, tu comptes toujours pour *moi*. ",shape=box,color=red];
		3287 -> 3293;
		3287 -> 3294;
		3287 -> 3295;
	3288 [label="+5 Chemistry",color=orange];
		3288 -> 3296;
	3289 [label="Peut-être.",shape=box,color=blue];
		3289 -> 3297;
	3290 [label="C'est un argument valable. Mais c'était une affaire entre pays, ça impliquait de la diplomatie. Des éléments mobiles.",shape=box,color=blue];
		3290 -> 3298;
	3291 [label="J'aimerais pouvoir te le dire. Mais je ferai tout mon possible pour éviter que cela n'arrive.",shape=box,color=red];
		3291 -> 3299;
	3292 [label="Tu ne penses pas que c'est terminé?",shape=box,color=red];
		3292 -> 3300;
	3293 [label="Mais penser que ton histoire s'arrête là, sans avoir joué un rôle dans son dénouement? C'est nul.",shape=box,color=red];
		3293 -> 3301;
	3294 [label="Mais peut-être que ça fait mal de penser que tu as été remplacé par un Arthur 2.0 quelque part.",shape=box,color=red];
		3294 -> 3302;
	3295 [label="Mais peut-être que tu veux simplement que tes sacrifices comptent toujours dans un sens plus cosmique de la chose?",shape=box,color=red];
		3295 -> 3303;
	3296 [label="D'accord.",shape=box,color=blue];
		3296 -> 3304;
	3297 [label="Une partie de moi espère qu'il y en a d'autres comme nous. Mais s'ils finissent par venir ici, on aura peut-être besoin d'un centre commercial plus grand.",shape=box,color=blue];
		3297 -> 3305;
	3298 [label="Ici, ça se joue entre un dieu au sens propre et un homme qui pense en être un.",shape=box,color=blue];
