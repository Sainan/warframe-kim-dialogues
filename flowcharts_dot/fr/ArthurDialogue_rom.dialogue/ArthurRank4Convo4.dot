		3144 -> 1565;
	1565 [label="L'accord était donc simple. Je partais en retraite anticipée ou tout était déballé. J'étais pas assez important pour qu'ils s'en soucient. Ils m'ont laissé partir sans faire d'histoires, après ça.",shape=box,color=blue];
