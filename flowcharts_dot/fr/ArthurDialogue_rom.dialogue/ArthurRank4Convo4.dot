	1548 [label="Quels qu'ils soient.",shape=box,color=blue];
		1548 -> 1549;
	1549 [label="Alors, quand j'ai été envoyé derrière des lignes et qu'on m'a dit de tuer tous les \"combattants ennemis potentiels\"?",shape=box,color=blue];
