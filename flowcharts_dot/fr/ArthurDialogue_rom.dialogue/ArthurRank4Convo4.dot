	1537 [label="Absolument.",shape=box,color=blue];
		1537 -> 1538;
	1538 [label="Tout le monde s'engage dans l'armée pour une raison différente. Pour ma part, je me suis engagé pour... l'honneur. Pour avoir un but.",shape=box,color=blue];
		1538 -> 1539;
	1536 [label="Chat ends.",color=orange];
	1539 [label="Je voulais être un héros, comme un idiot.",shape=box,color=blue];
