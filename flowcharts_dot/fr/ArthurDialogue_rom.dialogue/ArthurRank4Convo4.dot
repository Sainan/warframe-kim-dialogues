	1554 [label="Ouais.",shape=box,color=blue];
		1554 -> 1555;
	1555 [label="Je sais pas combien de vies innocentes on a enterrées ce jour-là.",shape=box,color=blue];
		1555 -> 1556;
	1556 [label="Mais c'était trop.",shape=box,color=blue];
		1556 -> 1557;
	1557 [label="Quand j'ai demandé pourquoi on venait de massacrer des innocents, les officiers m'ont menacé de renvoi déshonorant.",shape=box,color=blue];
		1557 -> 1558;
	1558 [label="Tais-toi. Fais ton travail. Tire avec ton arme. Tue comme un bon soldat.",shape=box,color=blue];
