digraph {
	3555 [label="ArthurRank6Convo9 begins.",color=orange];
		3555 -> 3556;
	3556 [label="Je ne suis pas sûr de ces... armes Infestées qu'Eleanor collectionne.",shape=box,color=blue];
		3556 -> 3557;
		3556 -> 3558;
	3557 [label="Pourquoi?",shape=box,color=red];
		3557 -> 3559;
	3558 [label="Au moins, elles ne parlent pas.",shape=box,color=red];
		3558 -> 3560;
	3559 [label="Outre le fait que je pense qu'elle peut leur parler?",shape=box,color=blue];
		3559 -> 3561;
	3560 [label="À *nous*. Je ne suis pas entièrement certain qu'elles ne *lui* parlent pas.",shape=box,color=blue];
		3560 -> 3561;
	3561 [label="Je sais qu'elles parlent à la guitare. Je ne veux vraiment pas y penser plus que nécessaire.",shape=box,color=blue];
		3561 -> 3562;
	3562 [label="Mais devrions-nous nous inquiéter de leur propagation? Elles semblent effectivement se multiplier.",shape=box,color=blue];
		3562 -> 3563;
	3563 [label="Ce que je ne comprends pas. Je ne veux pas non plus trop réfléchir à la provenance de leurs munitions, ni à leur composition.",shape=box,color=blue];
		3563 -> 3564;
		3563 -> 3565;
	3564 [label="Au moins, ces choses Infestées sont de notre côté?",shape=box,color=red];
		3564 -> 3566;
	3565 [label="Tu devrais peut-être t'en tenir aux armes normales, alors.",shape=box,color=red];
		3565 -> 3567;
	3566 [label="Bien sûr. Pour *l'instant*.",shape=box,color=blue];
		3566 -> 3568;
	3567 [label="Je pense que c'est ce que je vais faire.",shape=box,color=blue];
		3567 -> 3568;
	3568 [label="Au moins, si mon arme de poing me fait un trou dans le pied, je sais que je suis l'idiot responsable.",shape=box,color=blue];
		3568 -> 3569;
	3569 [label="Et pas parce que mon arme a décidé de revoir son allégeance ou a eu une crise de fringale nocturne.",shape=box,color=blue];
		3569 -> 3570;
	3570 [label="Chat ends.",color=orange];
}