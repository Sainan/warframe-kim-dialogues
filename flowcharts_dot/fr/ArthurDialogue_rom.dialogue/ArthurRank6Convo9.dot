digraph {
	"ArthurRank6Convo9 begins." [color=orange];
		"ArthurRank6Convo9 begins." -> j2907806463;
	j2907806463 [label="Je ne suis pas sûr de ces... armes Infestées qu'Eleanor collectionne.",shape=box,color=blue];
		j2907806463 -> j1667549615;
		j2907806463 -> j2729426592;
	j1667549615 [label="Pourquoi?",shape=box,color=red];
		j1667549615 -> j608748604;
	j2729426592 [label="Au moins, elles ne parlent pas.",shape=box,color=red];
		j2729426592 -> j224472343;
	j608748604 [label="Outre le fait que je pense qu'elle peut leur parler?",shape=box,color=blue];
		j608748604 -> j3286665110;
	j224472343 [label="À *nous*. Je ne suis pas entièrement certain qu'elles ne *lui* parlent pas.",shape=box,color=blue];
		j224472343 -> j3286665110;
	j3286665110 [label="Je sais qu'elles parlent à la guitare. Je ne veux vraiment pas y penser plus que nécessaire.",shape=box,color=blue];
		j3286665110 -> j526927764;
	j526927764 [label="Mais devrions-nous nous inquiéter de leur propagation? Elles semblent effectivement se multiplier.",shape=box,color=blue];
		j526927764 -> j1225571118;
	j1225571118 [label="Ce que je ne comprends pas. Je ne veux pas non plus trop réfléchir à la provenance de leurs munitions, ni à leur composition.",shape=box,color=blue];
		j1225571118 -> j2781262975;
		j1225571118 -> j4195255713;
	j2781262975 [label="Au moins, ces choses Infestées sont de notre côté?",shape=box,color=red];
		j2781262975 -> j1169133459;
	j4195255713 [label="Tu devrais peut-être t'en tenir aux armes normales, alors.",shape=box,color=red];
		j4195255713 -> j579795218;
	j1169133459 [label="Bien sûr. Pour *l'instant*.",shape=box,color=blue];
		j1169133459 -> j4014346123;
	j579795218 [label="Je pense que c'est ce que je vais faire.",shape=box,color=blue];
		j579795218 -> j4014346123;
	j4014346123 [label="Au moins, si mon arme de poing me fait un trou dans le pied, je sais que je suis l'idiot responsable.",shape=box,color=blue];
		j4014346123 -> j3947152723;
	j3947152723 [label="Et pas parce que mon arme a décidé de revoir son allégeance ou a eu une crise de fringale nocturne.",shape=box,color=blue];
		j3947152723 -> "Chat ends.";
	"Chat ends." [color=orange];
}