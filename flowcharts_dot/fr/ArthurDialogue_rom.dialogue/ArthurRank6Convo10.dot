	j3242728274 [label="Qu'est-ce que tu fais aujourd'hui?",shape=box,color=red];
		j3242728274 -> j3161492600;
	j1014365763 [label="J'ai pris la décision stupide d'affronter Amir dans Ollie's Crash Course.",shape=box,color=blue];
		j1014365763 -> j1257336465;
	j3161492600 [label="Quincy et moi allons partir en reconnaissance. C'est son idée, pas la mienne.",shape=box,color=blue];
		j3161492600 -> j3300364461;
	j1257336465 [label="Et maintenant, je suis profondément contrarié qu'il ait battu mon meilleur score.",shape=box,color=blue];
		j1257336465 -> j3836645144;
	j3300364461 [label="C'est étrange, notre relation. On ne se parle pas beaucoup.",shape=box,color=blue];
		j3300364461 -> j781747931;
	j3836645144 [label="... J'ai passé vingt-six heures au cours des deux derniers jours à jouer à ce jeu.",shape=box,color=blue];
		j3836645144 -> j1791395995;
	j781747931 [label="Mais nous savons tous les deux que nous mourrions l'un pour l'autre si cela devait arriver.",shape=box,color=blue];
		j781747931 -> j2859762976;
	j1791395995 [label="S'il te plaît, demande à Lettie de me tranquilliser si je m'approche à nouveau de cette satanée machine.",shape=box,color=blue];
		j1791395995 -> "Chat ends.";
	j2859762976 [label="Je suppose que parfois, c'est ça la famille, n'est-ce pas?",shape=box,color=blue];
