	2937 [label="...Rien du tout.",shape=box,color=red];
		2937 -> 2939;
	2938 [label="Amir s'ennuie encore. Regarde ton nom d'utilisateur.",shape=box,color=red];
		2938 -> 2941;
	2939 [label="br00dsw0rd: Je ne te crois pas, je-",shape=box,color=blue];
		2939 -> 2940;
	2941 [label="br00dsw0rd: LE PRINCE DES CUVÉES?!",shape=box,color=blue];
		2941 -> 2942;
