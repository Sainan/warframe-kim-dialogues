		2940 -> 2941;
	2942 [label="br00dsw0rd: Je ne picole PAS!",shape=box,color=blue];
		2942 -> 2943;
		2942 -> 2944;
		2942 -> 2945;
	2943 [label=":| Mon pote. Cette icône dit le contraire.",shape=box,color=red];
		2943 -> 2946;
	2944 [label="Ben... On dirait bien.",shape=box,color=red];
		2944 -> 2947;
	2945 [label="Eh, il te taquine juste. Tu sais qu'il t'adore. mdr",shape=box,color=red];
		2945 -> 2947;
	2946 [label="br00dsw0rd: ... Très bien. Très bien. Une petite pinte par ci, un canon par là, après tout.",shape=box,color=blue];
