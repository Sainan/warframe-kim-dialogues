	2933 [label="Et l'équipe sportive locale, ça donne quoi?",shape=box,color=red];
		2933 -> 2935;
	2928 [label="br00dsw0rd: Camarade, on a parlé il y a une heure à peine de-",shape=box,color=blue];
		2928 -> 2936;
	2934 [label="br00dsw0rd: Cela devient un peu moins intéressant quand c'est toujours la même chose.",shape=box,color=blue];
		2934 -> 2936;
	2935 [label="br00dsw0rd: Quelle équipe sportive?",shape=box,color=blue];
		2935 -> 2936;
	2936 [label="br00dsw0rd: Que se passe-t-il? Tu agis bizarrement.",shape=box,color=blue];
		2936 -> 2937;
