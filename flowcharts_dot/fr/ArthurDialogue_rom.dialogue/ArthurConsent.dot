	j1569221931 [label="Check boolean ArthurConsentComplete",color=orange];
		j1569221931 -> "Chat ends." [label=true,color=green];
		j1569221931 -> j2136519388 [label=false,color=brown];
		j1569221931 -> j1807364272 [label=false,color=brown];
	j972778441 [label="Check boolean ArthurPolyamorySuccess",color=orange];
		j972778441 -> j1569221931 [label=true,color=green];
		j972778441 -> "Chat ends." [label=false,color=brown];
	j2136519388 [label="Arthur, on peut parler? [Demander le consentement pour avoir plusieurs partenaires.]",shape=box,color=red];
		j2136519388 -> j3658429000;
	j1807364272 [label="[Fin.]",shape=box,color=red];
		j1807364272 -> j3652224286;
	j3658429000 [label="Toujours. Quelque chose ne va pas?",shape=box,color=blue];
		j3658429000 -> j1001518528;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j1001518528 [label="Non, tout va bien. Je voulais juste te parler de quelque chose qui, je l'espère, ne te mettra pas mal à l'aise.",shape=box,color=red];
		j1001518528 -> j2722860418;
	j2722860418 [label="Je ne veux pas te mettre dans une situation qui pourrait te déplaire. Je sais que nous n'en avons jamais parlé. Alors, si tu dis non, ce n'est pas grave. Je voulais juste que tu le saches.",shape=box,color=red];
		j2722860418 -> j3787240710;
	j3787240710 [label="Ce que nous avons est important pour moi, très important, et c'est réel. Je ne veux pas que tu en doutes.",shape=box,color=red];
		j3787240710 -> j1828655167;
	j1828655167 [label="Ah. Je vois où tu veux en venir. Tu as des sentiments pour quelqu'un d'autre?",shape=box,color=blue];
		j1828655167 -> j3267681491;
		j1828655167 -> j3742379563;
	j3267681491 [label="Oui. Et je sais que cela peut être difficile à comprendre, mais cela ne signifie pas que mes sentiments pour toi diminuent.",shape=box,color=red];
		j3267681491 -> j3733793482;
	j3742379563 [label="Oui. Mais maintenant que j'y pense, je crois qu'on devrait en rester là. [Rompre.]",shape=box,color=red];
		j3742379563 -> j4046296634;
	j3733793482 [label="Mon cœur, tu crois vraiment que j'ai passé tant d'années dans l'armée et que je n'ai pas vu à peu près tous les types de relations qui existent?",shape=box,color=blue];
		j3733793482 -> j851636542;
	j4046296634 [label="Si c'est vraiment ce que tu veux, alors...",shape=box,color=blue];
		j4046296634 -> j3701883258;
	j851636542 [label="Quand on passe une si grande partie de sa vie à frôler la mort, on apprend à apprécier ce qui compte dans la vie et à ne pas se tracasser de ce qui n'a pas d'importance.",shape=box,color=blue];
		j851636542 -> j3396662616;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j3396662616 [label="Tu ne veux pas respecter des limites arbitraires. Je comprends parfaitement.",shape=box,color=blue];
		j3396662616 -> j2965919186;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j2965919186 [label="En vérité, tu comptes pour moi. Et si cette personne compte pour toi, alors elle compte pour moi.",shape=box,color=blue];
		j2965919186 -> j2409217342;
	j2409217342 [label="Juste une chose. Personne de l'Hexagone. Compris? Je ne crois pas que je pourrais le supporter si c'était quelqu'un de la famille.",shape=box,color=blue];
		j2409217342 -> j1140325820;
	j1140325820 [label="D'y penser, ça va me donner des cauchemars.",shape=box,color=blue];
		j1140325820 -> j987148173;
		j1140325820 -> j503618620;
	j987148173 [label="Lol. Promis.",shape=box,color=red];
		j987148173 -> j203294963;
	j503618620 [label="À mon avis, je crois que tu l'apprécieras vraiment.",shape=box,color=red];
		j503618620 -> j2857591628;
	j203294963 [label="Merci. Et j'espère rencontrer cette personne un jour. Pour des raisons… personnelles, bien sûr.",shape=box,color=blue];
		j203294963 -> j2214259949;
	j2857591628 [label="Et j'espère rencontrer cette personne un jour. Pour des raisons… personnelles, bien sûr.",shape=box,color=blue];
		j2857591628 -> j2214259949;
	j2214259949 [label="+20 Chemistry",color=orange];
		j2214259949 -> j3019446558;
	j3019446558 [label="Prends soin de toi, mon cœur.",shape=box,color=blue];
		j3019446558 -> j3652224286;
}