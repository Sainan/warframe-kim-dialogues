	3612 [label="Chat ends.",color=orange];
	3613 [label="Arthur, on peut parler? [Demander le consentement pour avoir plusieurs partenaires.]",shape=box,color=red];
		3613 -> 3615;
	3611 [label="[Fin.]",shape=box,color=red];
		3611 -> 3614;
	3610 [label="Chat ends.",color=orange];
	3615 [label="Toujours. Quelque chose ne va pas?",shape=box,color=blue];
		3615 -> 3617;
	3614 [label="Update boolean ArthurConsentComplete",color=orange];
		3614 -> 3616;
	3617 [label="Non, tout va bien. Je voulais juste te parler de quelque chose qui, je l'espère, ne te mettra pas mal à l'aise.",shape=box,color=red];
		3617 -> 3618;
	3616 [label="Chat ends.",color=orange];
	3618 [label="Je ne veux pas te mettre dans une situation qui pourrait te déplaire. Je sais que nous n'en avons jamais parlé. Alors, si tu dis non, ce n'est pas grave. Je voulais juste que tu le saches.",shape=box,color=red];
		3618 -> 3619;
	3619 [label="Ce que nous avons est important pour moi, très important, et c'est réel. Je ne veux pas que tu en doutes.",shape=box,color=red];
		3619 -> 3620;
	3620 [label="Ah. Je vois où tu veux en venir. Tu as des sentiments pour quelqu'un d'autre?",shape=box,color=blue];
		3620 -> 3621;
		3620 -> 3622;
	3621 [label="Oui. Et je sais que cela peut être difficile à comprendre, mais cela ne signifie pas que mes sentiments pour toi diminuent.",shape=box,color=red];
		3621 -> 3623;
	3622 [label="Oui. Mais maintenant que j'y pense, je crois qu'on devrait en rester là. [Rompre.]",shape=box,color=red];
		3622 -> 3624;
	3623 [label="Mon cœur, tu crois vraiment que j'ai passé tant d'années dans l'armée et que je n'ai pas vu à peu près tous les types de relations qui existent?",shape=box,color=blue];
		3623 -> 3625;
	3624 [label="Si c'est vraiment ce que tu veux, alors...",shape=box,color=blue];
		3624 -> 3626;
	3625 [label="Quand on passe une si grande partie de sa vie à frôler la mort, on apprend à apprécier ce qui compte dans la vie et à ne pas se tracasser de ce qui n'a pas d'importance.",shape=box,color=blue];
		3625 -> 3627;
	3626 [label="Update boolean IsDating",color=orange];
		3626 -> 3628;
	3627 [label="Tu ne veux pas respecter des limites arbitraires. Je comprends parfaitement.",shape=box,color=blue];
		3627 -> 3629;
	3628 [label="Update boolean ArthurDating",color=orange];
		3628 -> 3630;
	3629 [label="En vérité, tu comptes pour moi. Et si cette personne compte pour toi, alors elle compte pour moi.",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="Chat ends.",color=orange];
	3631 [label="Juste une chose. Personne de l'Hexagone. Compris? Je ne crois pas que je pourrais le supporter si c'était quelqu'un de la famille.",shape=box,color=blue];
		3631 -> 3632;
	3632 [label="D'y penser, ça va me donner des cauchemars.",shape=box,color=blue];
		3632 -> 3634;
		3632 -> 3633;
	3634 [label="Lol. Promis.",shape=box,color=red];
		3634 -> 3636;
	3633 [label="À mon avis, je crois que tu l'apprécieras vraiment.",shape=box,color=red];
		3633 -> 3635;
	3636 [label="Merci. Et j'espère rencontrer cette personne un jour. Pour des raisons… personnelles, bien sûr.",shape=box,color=blue];
		3636 -> 3637;
	3635 [label="Et j'espère rencontrer cette personne un jour. Pour des raisons… personnelles, bien sûr.",shape=box,color=blue];
		3635 -> 3637;
	3637 [label="+20 Chemistry",color=orange];
		3637 -> 3638;
	3638 [label="Prends soin de toi, mon cœur.",shape=box,color=blue];
		3638 -> 3639;
	3639 [label="Update boolean ArthurConsentComplete",color=orange];
		3639 -> 3640;
	3640 [label="Chat ends.",color=orange];
