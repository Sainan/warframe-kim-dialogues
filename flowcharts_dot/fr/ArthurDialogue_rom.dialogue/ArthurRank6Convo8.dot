digraph {
	3541 [label="ArthurRank6Convo8 begins.",color=orange];
		3541 -> 3542;
	3542 [label="Tu sais, je viens de réaliser quelque chose ce matin, et je n'ai pas pu arrêter de rire.",shape=box,color=blue];
		3542 -> 3543;
		3542 -> 3544;
	3543 [label="Raconte.",shape=box,color=red];
		3543 -> 3545;
	3544 [label="Oh? Quoi?",shape=box,color=red];
		3544 -> 3545;
	3545 [label="Vodyanoi n’a aucune idée de la façon dont fonctionne la transférence. ",shape=box,color=blue];
		3545 -> 3546;
	3546 [label="Tu es comme Kent Clarke et Megabloke, il n'a jamais vu deux de tes warframes au même endroit.",shape=box,color=blue];
		3546 -> 3547;
	3547 [label="Dans sa tête, il y a une sorte d'armée de super-soldats psychotiques qui se déchaînent avec l'Hexagone!",shape=box,color=blue];
		3547 -> 3548;
		3547 -> 3549;
	3548 [label="Ce qu'il ignore *peut* lui faire du mal, n'est-ce pas? <RETRO_EMOJI_COOLARMSUP>",shape=box,color=red];
		3548 -> 3550;
	3549 [label="MDR!! Je n'y avais jamais pensé.",shape=box,color=red];
		3549 -> 3551;
	3550 [label="Exactement. Et ce n'est pas moi qui le corrigerai.",shape=box,color=blue];
		3550 -> 3552;
	3551 [label="Ce n'est pas moi qui le corrigerai. Mais je n'arrive même pas à imaginer ce qu'il pense.",shape=box,color=blue];
		3551 -> 3552;
	3552 [label="Pas étonnant qu'il soit si parano à notre sujet. Ah! J'ai presque pitié de ce pauvre petit connard.",shape=box,color=blue];
		3552 -> 3553;
	3553 [label="Presque.",shape=box,color=blue];
		3553 -> 3554;
	3554 [label="Chat ends.",color=orange];
}