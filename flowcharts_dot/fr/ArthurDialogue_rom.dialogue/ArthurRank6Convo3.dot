digraph {
	3360 [label="ArthurRank6Convo3 begins.",color=orange];
		3360 -> 3361;
	3361 [label="L’autre jour, je me suis retrouvé à avoir une conversation avec la guitare.",shape=box,color=blue];
		3361 -> 3362;
		3361 -> 3363;
	3362 [label="Personnellement, je ne suis pas vraiment fan.",shape=box,color=red];
		3362 -> 3364;
	3363 [label="Lizzie? Comment ça s'est passé?",shape=box,color=red];
		3363 -> 3365;
	3364 [label="Honnêtement, je l'aime bien. Une fois qu'on fait fi de son côté... bizarre...",shape=box,color=blue];
		3364 -> 3366;
	3365 [label="Mieux que je ne l'aurais cru. Je l'aime plutôt bien.",shape=box,color=blue];
		3365 -> 3366;
	3366 [label="En plus,",shape=box,color=blue];
		3366 -> 3367;
	3367 [label="Puisqu'elle et Eleanor semblent toujours rire de blagues que personne d'autre ne peut entendre.",shape=box,color=blue];
		3367 -> 3368;
	3368 [label="J'ai pensé que je devais aller me présenter correctement.",shape=box,color=blue];
		3368 -> 3369;
	3369 [label="Elle a plein d'idées utiles. Et Flare est adorable. Franchement, tout ce monde dans le bar est une bouffée d'air frais. ",shape=box,color=blue];
		3369 -> 3370;
	3370 [label="Franchement.",shape=box,color=blue];
		3370 -> 3371;
		3370 -> 3372;
		3370 -> 3373;
	3371 [label="Déjà marre de l'Hexagone?",shape=box,color=red];
		3371 -> 3374;
	3372 [label="Quelles étaient ses idées?",shape=box,color=red];
		3372 -> 3375;
	3373 [label="C'est super que tu te fasses des amis. mdr. ",shape=box,color=red];
		3373 -> 3376;
	3374 [label="Quoi? Non! Bien sûr que non.",shape=box,color=blue];
		3374 -> 3377;
	3375 [label="Des idées fascinantes, concernant le nombre de fois où l'année a passé en boucle.",shape=box,color=blue];
		3375 -> 3378;
	3376 [label="J'imagine que c'est juste agréable d'avoir des gens avec qui parler et avec qui je n'ai pas vécu tant de choses.",shape=box,color=blue];
		3376 -> 3379;
	3377 [label="L'Hexagone est ma famille. Mon équipe. Tu le sais.",shape=box,color=blue];
		3377 -> 3376;
	3378 [label="Combien de fois j'ai pu oublier, ou non, les années passées. Comment elle vit... hors du temps? Et comment nous, non.",shape=box,color=blue];
		3378 -> 3380;
	3379 [label="Je ne suis pas sûr que ça ait du sens. Je les connais, je leur fais confiance, c'est juste que je n'ai pas vécu l'enfer avec eux.",shape=box,color=blue];
		3379 -> 3381;
	3380 [label="Et avant que tu ne dises quoi que ce soit, non. Je ne veux pas savoir. Je n'ai pas le droit de savoir.",shape=box,color=blue];
		3380 -> 3382;
	3381 [label="Il est donc parfois plus facile de simplement s’asseoir et trinquer avec eux.",shape=box,color=blue];
		3381 -> 3383;
		3381 -> 3384;
		3381 -> 3385;
	3382 [label="Je veux juste dire: que tu veuilles le faire ou pas? C'est bon. Je ne t'en tiendrai pas rigueur.",shape=box,color=blue];
		3382 -> 3386;
	3383 [label="Je n’ai jamais vraiment eu cette option.",shape=box,color=red];
		3383 -> 3387;
	3384 [label="Ouais, je comprends.",shape=box,color=red];
		3384 -> 3388;
	3385 [label="Il est également utile que certains d’entre eux soient un peu plus âgés et aient une expérience militaire.",shape=box,color=red];
		3385 -> 3389;
	3386 [label="Cette situation dans laquelle nous nous trouvons n'est pas normale. Nous ne sommes pas faits pour ce genre de choses – les humains, je veux dire.",shape=box,color=blue];
		3386 -> 3390;
	3387 [label="Je suppose que non.",shape=box,color=blue];
		3387 -> 3391;
	3388 [label="Il n'y a pas tant de... poids. Tant de passé. Amir appellerait ça \"bagage\".",shape=box,color=blue];
		3388 -> 3391;
	3389 [label="Par Sol. Exactement. Au début, je ne savais pas trop quoi penser des Libertatiens. Mais maintenant? Je suis content qu'ils soient là.",shape=box,color=blue];
		3389 -> 3391;
	3390 [label="Il n'existe pas de manuel pour cela. Quel que soit ton choix, je suis sûr que tu auras de bonnes raisons de le faire.",shape=box,color=blue];
		3390 -> 3392;
	3391 [label="Mais tout cela m’a fait réfléchir.",shape=box,color=blue];
		3391 -> 3393;
		3391 -> 3394;
	3392 [label="Check boolean ArthurDating",color=orange];
		3392 -> 3396 [label=true,color=green];
		3392 -> 3395 [label=false,color=brown];
	3393 [label="Oh oh.",shape=box,color=red];
		3393 -> 3397;
	3394 [label="À propos de quoi?",shape=box,color=red];
		3394 -> 3398;
	3396 [label="Je t'aime. Et même si je l'oublie? Même si tu choisis un autre chemin? Ce n'est pas grave.",shape=box,color=blue];
		3396 -> 3400;
	3395 [label="Je te confierais ma vie. Et rien ne changera ça. Même si je l'oublie parfois un instant.",shape=box,color=blue];
		3395 -> 3399;
	3397 [label="Hé. Écoute-moi bien. C'est de toi qu'il s'agit.",shape=box,color=blue];
		3397 -> 3401;
	3398 [label="Toi. ",shape=box,color=blue];
		3398 -> 3401;
	3400 [label="Avant ton arrivée, je ne pense pas que j'aurais pu accepter ça. J'aurais eu trop peur de te perdre. De perdre une partie de ce qu'on a là.",shape=box,color=blue];
		3400 -> 3402;
	3399 [label="Avant ton arrivée, je ne pense pas que j'aurais pu accepter ça. J'aurais eu trop peur de perdre une partie de moi-même.",shape=box,color=blue];
		3399 -> 3402;
	3401 [label="Et toute cette... boucle temporelle. Et ça me fait penser à tous les 1999 dont je ne me souviens peut-être pas.",shape=box,color=blue];
		3401 -> 3403;
		3401 -> 3404;
		3401 -> 3405;
	3402 [label="Je m'y serais accroché comme un homme désespéré s'accrochant à un canot en mer. Mais peut-être que j'ai été dans cette boucle assez de fois maintenant, ou... peut-être que c'est juste toi, je ne sais pas.",shape=box,color=blue];
		3402 -> 3406;
	3403 [label="Tout ce que la guitare t'a dit est du vent, je le jure.",shape=box,color=red];
		3403 -> 3407;
	3404 [label="J'ai du souci à me faire?",shape=box,color=red];
		3404 -> 3407;
	3405 [label="Je... ne pense pas que nous devrions nous lancer là-dedans, Arthur.",shape=box,color=red];
		3405 -> 3407;
	3406 [label="Ce bonheur que tu m'as donné maintenant - cette paix - vaut plus à cet instant que de savoir qu'il pourrait durer éternellement.",shape=box,color=blue];
		3406 -> 3408;
	3407 [label="Attends une seconde, tu veux bien? Tu sais que j'écris plus lentement que toi.",shape=box,color=blue];
		3407 -> 3409;
	3408 [label="S'il y a une chose dans la vie que l'on apprend en tant que soldat, c'est que tout est éphémère.",shape=box,color=blue];
		3408 -> 3410;
	3409 [label="Ce que j'essaie de dire, c'est ceci:",shape=box,color=blue];
		3409 -> 3411;
	3410 [label="Ici une seconde, disparu la seconde suivante. Je crois que j'ai fini par l'accepter. Une bonne fois pour toutes.",shape=box,color=blue];
		3410 -> 3412;
	3411 [label="Que tu aies réussi ou non à nous faire oublier, à moi ou au reste de l'Hexagone, nos interactions passées? Ce n'est pas grave.",shape=box,color=blue];
		3411 -> 3413;
	3412 [label="Alors, si notre temps ensemble se termine parce que tu frappes le sol et que j'oublie tout?",shape=box,color=blue];
		3412 -> 3414;
	3413 [label="Je ne t'en tiendrai pas rigueur.",shape=box,color=blue];
		3413 -> 3386;
	3414 [label="Ou parce que l'Indifférence te prend au dépourvu un jour?",shape=box,color=blue];
		3414 -> 3415;
	3415 [label="Je vais profiter du moment présent. Ici et maintenant. Parce que c'est ce que j'ai.",shape=box,color=blue];
		3415 -> 3416;
	3416 [label="Et c'est ce dont je peux être sûr.",shape=box,color=blue];
		3416 -> 3417;
		3416 -> 3418;
		3416 -> 3419;
	3417 [label="Ce n'est rien de personnel. C'est surtout parce que je foire tout le temps en essayant de sortir avec ta sœur. :P",shape=box,color=red];
		3417 -> 3420;
	3418 [label="Merci, Arthur... cela compte plus pour moi que je ne pense pouvoir vraiment l'exprimer.",shape=box,color=red];
		3418 -> 3421;
	3419 [label="J'aimerais avoir ton genre de sang-froid, parfois. <3",shape=box,color=red];
		3419 -> 3422;
	3420 [label="Har har. Heureusement que tu as un super pouvoir magique qui te permet de retirer ton pied de l'endroit où tu l'as logé si spectaculairement dans ta trachée, n'est-ce pas?",shape=box,color=blue];
		3420 -> 3423;
	3421 [label="De temps en temps, j'essaie de sortir le bâton de mon cul assez longtemps pour dire quelque chose de significatif.",shape=box,color=blue];
		3421 -> 3424;
	3422 [label="C'est surtout parce que je sais que je n'ai pas d'autre choix que de garder la tête froide. C'est la façon britannique de faire. ",shape=box,color=blue];
		3422 -> 3425;
	3423 [label="Le reste d'entre nous doit simplement apprendre à communiquer. Une question, cependant.",shape=box,color=blue];
		3423 -> 3426;
	3424 [label="Bon, je crois qu'il est temps de boire un verre. On y va?",shape=box,color=blue];
		3424 -> 3427;
		3424 -> 3428;
	3425 [label="Comme le dit le vieil adage: \"Restez calmes et avancez.\"",shape=box,color=blue];
		3425 -> 3424;
	3426 [label="Est-ce qu'elle baisse ses critères à chaque réinitialisation?",shape=box,color=blue];
		3426 -> 3429;
	3427 [label="Peut-être plus tard.",shape=box,color=red];
		3427 -> 3430;
	3428 [label="On se retrouve là-bas :)",shape=box,color=red];
