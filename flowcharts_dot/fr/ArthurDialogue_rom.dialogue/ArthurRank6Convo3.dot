digraph {
	"ArthurRank6Convo3 begins." [color=orange];
		"ArthurRank6Convo3 begins." -> j717096144;
	j717096144 [label="L’autre jour, je me suis retrouvé à avoir une conversation avec la guitare.",shape=box,color=blue];
		j717096144 -> j4259115378;
		j717096144 -> j167883718;
	j4259115378 [label="Personnellement, je ne suis pas vraiment fan.",shape=box,color=red];
		j4259115378 -> j3451672031;
	j167883718 [label="Lizzie? Comment ça s'est passé?",shape=box,color=red];
		j167883718 -> j510251911;
	j3451672031 [label="Honnêtement, je l'aime bien. Une fois qu'on fait fi de son côté... bizarre...",shape=box,color=blue];
		j3451672031 -> j1119469438;
	j510251911 [label="Mieux que je ne l'aurais cru. Je l'aime plutôt bien.",shape=box,color=blue];
		j510251911 -> j1119469438;
	j1119469438 [label="En plus,",shape=box,color=blue];
		j1119469438 -> j1842192659;
	j1842192659 [label="Puisqu'elle et Eleanor semblent toujours rire de blagues que personne d'autre ne peut entendre.",shape=box,color=blue];
		j1842192659 -> j1140362365;
	j1140362365 [label="J'ai pensé que je devais aller me présenter correctement.",shape=box,color=blue];
		j1140362365 -> j2512867868;
	j2512867868 [label="Elle a plein d'idées utiles. Et Flare est adorable. Franchement, tout ce monde dans le bar est une bouffée d'air frais. ",shape=box,color=blue];
		j2512867868 -> j365060350;
	j365060350 [label="Franchement.",shape=box,color=blue];
		j365060350 -> j1242975874;
		j365060350 -> j1761770600;
		j365060350 -> j4110616826;
	j1242975874 [label="Déjà marre de l'Hexagone?",shape=box,color=red];
		j1242975874 -> j2426664431;
	j1761770600 [label="Quelles étaient ses idées?",shape=box,color=red];
		j1761770600 -> j3732903862;
	j4110616826 [label="C'est super que tu te fasses des amis. mdr. ",shape=box,color=red];
		j4110616826 -> j3635494672;
	j2426664431 [label="Quoi? Non! Bien sûr que non.",shape=box,color=blue];
		j2426664431 -> j3861265445;
	j3732903862 [label="Des idées fascinantes, concernant le nombre de fois où l'année a passé en boucle.",shape=box,color=blue];
		j3732903862 -> j3102305513;
	j3635494672 [label="J'imagine que c'est juste agréable d'avoir des gens avec qui parler et avec qui je n'ai pas vécu tant de choses.",shape=box,color=blue];
		j3635494672 -> j2981874104;
	j3861265445 [label="L'Hexagone est ma famille. Mon équipe. Tu le sais.",shape=box,color=blue];
		j3861265445 -> j3635494672;
	j3102305513 [label="Combien de fois j'ai pu oublier, ou non, les années passées. Comment elle vit... hors du temps? Et comment nous, non.",shape=box,color=blue];
		j3102305513 -> j3994839853;
	j2981874104 [label="Je ne suis pas sûr que ça ait du sens. Je les connais, je leur fais confiance, c'est juste que je n'ai pas vécu l'enfer avec eux.",shape=box,color=blue];
		j2981874104 -> j1122268982;
	j3994839853 [label="Et avant que tu ne dises quoi que ce soit, non. Je ne veux pas savoir. Je n'ai pas le droit de savoir.",shape=box,color=blue];
		j3994839853 -> j1659117138;
	j1122268982 [label="Il est donc parfois plus facile de simplement s’asseoir et trinquer avec eux.",shape=box,color=blue];
		j1122268982 -> j2241337878;
		j1122268982 -> j2598264316;
		j1122268982 -> j11120846;
	j1659117138 [label="Je veux juste dire: que tu veuilles le faire ou pas? C'est bon. Je ne t'en tiendrai pas rigueur.",shape=box,color=blue];
		j1659117138 -> j1252484876;
	j2241337878 [label="Je n’ai jamais vraiment eu cette option.",shape=box,color=red];
		j2241337878 -> j1290476676;
	j2598264316 [label="Ouais, je comprends.",shape=box,color=red];
		j2598264316 -> j3808409728;
	j11120846 [label="Il est également utile que certains d’entre eux soient un peu plus âgés et aient une expérience militaire.",shape=box,color=red];
		j11120846 -> j2452660425;
	j1252484876 [label="Cette situation dans laquelle nous nous trouvons n'est pas normale. Nous ne sommes pas faits pour ce genre de choses – les humains, je veux dire.",shape=box,color=blue];
		j1252484876 -> j1674850786;
	j1290476676 [label="Je suppose que non.",shape=box,color=blue];
		j1290476676 -> j2397613688;
	j3808409728 [label="Il n'y a pas tant de... poids. Tant de passé. Amir appellerait ça \"bagage\".",shape=box,color=blue];
		j3808409728 -> j2397613688;
	j2452660425 [label="Par Sol. Exactement. Au début, je ne savais pas trop quoi penser des Libertatiens. Mais maintenant? Je suis content qu'ils soient là.",shape=box,color=blue];
		j2452660425 -> j2397613688;
	j1674850786 [label="Il n'existe pas de manuel pour cela. Quel que soit ton choix, je suis sûr que tu auras de bonnes raisons de le faire.",shape=box,color=blue];
		j1674850786 -> j2674809731;
	j2397613688 [label="Mais tout cela m’a fait réfléchir.",shape=box,color=blue];
		j2397613688 -> j956325185;
		j2397613688 -> j2620759441;
	j2674809731 [label="Check boolean ArthurDating",color=orange];
		j2674809731 -> j2742501116 [label=true,color=green];
		j2674809731 -> j187405561 [label=false,color=brown];
	j956325185 [label="Oh oh.",shape=box,color=red];
		j956325185 -> j1780315528;
	j2620759441 [label="À propos de quoi?",shape=box,color=red];
		j2620759441 -> j3025552723;
	j2742501116 [label="Je t'aime. Et même si je l'oublie? Même si tu choisis un autre chemin? Ce n'est pas grave.",shape=box,color=blue];
		j2742501116 -> j738517645;
	j187405561 [label="Je te confierais ma vie. Et rien ne changera ça. Même si je l'oublie parfois un instant.",shape=box,color=blue];
		j187405561 -> j2689054826;
	j1780315528 [label="Hé. Écoute-moi bien. C'est de toi qu'il s'agit.",shape=box,color=blue];
		j1780315528 -> j808467432;
	j3025552723 [label="Toi. ",shape=box,color=blue];
		j3025552723 -> j808467432;
	j738517645 [label="Avant ton arrivée, je ne pense pas que j'aurais pu accepter ça. J'aurais eu trop peur de te perdre. De perdre une partie de ce qu'on a là.",shape=box,color=blue];
		j738517645 -> j112363560;
	j2689054826 [label="Avant ton arrivée, je ne pense pas que j'aurais pu accepter ça. J'aurais eu trop peur de perdre une partie de moi-même.",shape=box,color=blue];
		j2689054826 -> j112363560;
	j808467432 [label="Et toute cette... boucle temporelle. Et ça me fait penser à tous les 1999 dont je ne me souviens peut-être pas.",shape=box,color=blue];
		j808467432 -> j863511830;
		j808467432 -> j3786274237;
		j808467432 -> j2721894748;
	j112363560 [label="Je m'y serais accroché comme un homme désespéré s'accrochant à un canot en mer. Mais peut-être que j'ai été dans cette boucle assez de fois maintenant, ou... peut-être que c'est juste toi, je ne sais pas.",shape=box,color=blue];
		j112363560 -> j4085371650;
	j863511830 [label="Tout ce que la guitare t'a dit est du vent, je le jure.",shape=box,color=red];
		j863511830 -> j1707320647;
	j3786274237 [label="J'ai du souci à me faire?",shape=box,color=red];
		j3786274237 -> j1707320647;
	j2721894748 [label="Je... ne pense pas que nous devrions nous lancer là-dedans, Arthur.",shape=box,color=red];
		j2721894748 -> j1707320647;
	j4085371650 [label="Ce bonheur que tu m'as donné maintenant - cette paix - vaut plus à cet instant que de savoir qu'il pourrait durer éternellement.",shape=box,color=blue];
		j4085371650 -> j140440263;
	j1707320647 [label="Attends une seconde, tu veux bien? Tu sais que j'écris plus lentement que toi.",shape=box,color=blue];
		j1707320647 -> j3204186228;
	j140440263 [label="S'il y a une chose dans la vie que l'on apprend en tant que soldat, c'est que tout est éphémère.",shape=box,color=blue];
		j140440263 -> j1895226949;
	j3204186228 [label="Ce que j'essaie de dire, c'est ceci:",shape=box,color=blue];
		j3204186228 -> j4165937066;
	j1895226949 [label="Ici une seconde, disparu la seconde suivante. Je crois que j'ai fini par l'accepter. Une bonne fois pour toutes.",shape=box,color=blue];
		j1895226949 -> j3904736286;
	j4165937066 [label="Que tu aies réussi ou non à nous faire oublier, à moi ou au reste de l'Hexagone, nos interactions passées? Ce n'est pas grave.",shape=box,color=blue];
		j4165937066 -> j2475941459;
	j3904736286 [label="Alors, si notre temps ensemble se termine parce que tu frappes le sol et que j'oublie tout?",shape=box,color=blue];
		j3904736286 -> j1485339729;
	j2475941459 [label="Je ne t'en tiendrai pas rigueur.",shape=box,color=blue];
		j2475941459 -> j1252484876;
	j1485339729 [label="Ou parce que l'Indifférence te prend au dépourvu un jour?",shape=box,color=blue];
		j1485339729 -> j721141773;
	j721141773 [label="Je vais profiter du moment présent. Ici et maintenant. Parce que c'est ce que j'ai.",shape=box,color=blue];
		j721141773 -> j2701295722;
	j2701295722 [label="Et c'est ce dont je peux être sûr.",shape=box,color=blue];
		j2701295722 -> j1868539840;
		j2701295722 -> j833060075;
		j2701295722 -> j682472273;
	j1868539840 [label="Ce n'est rien de personnel. C'est surtout parce que je foire tout le temps en essayant de sortir avec ta sœur. :P",shape=box,color=red];
		j1868539840 -> j2020888458;
	j833060075 [label="Merci, Arthur... cela compte plus pour moi que je ne pense pouvoir vraiment l'exprimer.",shape=box,color=red];
		j833060075 -> j3760800486;
	j682472273 [label="J'aimerais avoir ton genre de sang-froid, parfois. <3",shape=box,color=red];
		j682472273 -> j512550707;
	j2020888458 [label="Har har. Heureusement que tu as un super pouvoir magique qui te permet de retirer ton pied de l'endroit où tu l'as logé si spectaculairement dans ta trachée, n'est-ce pas?",shape=box,color=blue];
		j2020888458 -> j728876801;
	j3760800486 [label="De temps en temps, j'essaie de sortir le bâton de mon cul assez longtemps pour dire quelque chose de significatif.",shape=box,color=blue];
		j3760800486 -> j3144254589;
	j512550707 [label="C'est surtout parce que je sais que je n'ai pas d'autre choix que de garder la tête froide. C'est la façon britannique de faire. ",shape=box,color=blue];
		j512550707 -> j858540154;
	j728876801 [label="Le reste d'entre nous doit simplement apprendre à communiquer. Une question, cependant.",shape=box,color=blue];
		j728876801 -> j2393790063;
	j3144254589 [label="Bon, je crois qu'il est temps de boire un verre. On y va?",shape=box,color=blue];
		j3144254589 -> j1294296525;
		j3144254589 -> j585258066;
	j858540154 [label="Comme le dit le vieil adage: \"Restez calmes et avancez.\"",shape=box,color=blue];
		j858540154 -> j3144254589;
	j2393790063 [label="Est-ce qu'elle baisse ses critères à chaque réinitialisation?",shape=box,color=blue];
		j2393790063 -> "Chat ends.";
	j1294296525 [label="Peut-être plus tard.",shape=box,color=red];
		j1294296525 -> j2714069586;
	j585258066 [label="On se retrouve là-bas :)",shape=box,color=red];
		j585258066 -> "Chat ends.";
	"Chat ends." [color=orange];
	j2714069586 [label="Comme tu veux.",shape=box,color=blue];
		j2714069586 -> "Chat ends.";
}