digraph {
	3433 [label="ArthurRank6Convo4 begins.",color=orange];
		3433 -> 3434;
	3434 [label="J'ai une question étrange. Y a-t-il des jouets, dans l'espace?",shape=box,color=blue];
		3434 -> 3435;
		3434 -> 3436;
	3435 [label="Genre, des jouets pour enfants? Bien sûr.",shape=box,color=red];
		3435 -> 3437;
	3436 [label="Quel... genre de jouets?",shape=box,color=red];
		3436 -> 3438;
	3437 [label="Heh. Vraiment?",shape=box,color=blue];
		3437 -> 3439;
	3438 [label="Oh, PAR SOL. Ce n'est pas ce que je voulais dire, et tu le sais!",shape=box,color=blue];
		3438 -> 3440;
	3439 [label="Difficile de se projeter quelques milliers d'années dans le futur,",shape=box,color=blue];
		3439 -> 3441;
	3440 [label="Je veux dire, des jouets pour enfants. Des poupées. Des petits soldats. Des choses comme ça.",shape=box,color=blue];
		3440 -> 3442;
		3440 -> 3448;
	3441 [label="Des enfants toujours assis à imaginer des histoires avec de petites figurines et à jouer aux \"bandits\" ou à \"sauver la princesse\".",shape=box,color=blue];
		3441 -> 3444;
		3441 -> 3445;
		3441 -> 3446;
	3442 [label="Je voulais juste t'embêter. :P",shape=box,color=red];
		3442 -> 3447;
	3448 [label="Non, il n'y en a pas. [Fin.]",shape=box,color=red];
		3448 -> 3452;
	3444 [label="Pourquoi tu voulais demander ça?",shape=box,color=red];
		3444 -> 3449;
	3445 [label="À quoi jouais-tu quand tu étais petit?",shape=box,color=red];
		3445 -> 3450;
	3446 [label="Nos jeux avaient des noms différents, mais j'avais effectivement des jouets.",shape=box,color=red];
		3446 -> 3451;
	3447 [label="Oui, bien sûr que oui. ",shape=box,color=red];
		3447 -> 3437;
	3452 [label="Chat ends.",color=orange];
	3449 [label="En fait, je regardais Amir jouer à l'un de ses jeux d'arcade. ",shape=box,color=blue];
		3449 -> 3453;
	3450 [label="C'est plutôt réconfortant de penser que malgré toutes les différences entre nos cultures, les enfants continuent à s'asseoir et à jouer avec des jouets.",shape=box,color=blue];
		3450 -> 3454;
	3451 [label="Comme quoi?",shape=box,color=blue];
		3451 -> 3455;
		3451 -> 3456;
	3453 [label="Et je me suis dit: qu'est-ce que je ne donnerais pas pour retrouver ce genre de joie dans ma vie?",shape=box,color=blue];
		3453 -> 3457;
	3454 [label="J'avais cette figurine d'action. John Rambeau. C'était un soldat, sans surprise.",shape=box,color=blue];
		3454 -> 3458;
	3455 [label="Toutes sortes de figurines, d'animaux en peluche et de cubes. Des trucs typiques pour les enfants. ",shape=box,color=red];
		3455 -> 3450;
	3456 [label="J'avais cette – je suppose qu'on pourrait l'appeler une figurine – de cet enfant Dax, que, eh bien, j'ai nommé d'après un personnage d'un livre que j'avais: Dominus Thrax.",shape=box,color=red];
		3456 -> 3459;
	3457 [label="Je n'ai jamais méprisé Aoi, ni Amir, ni même Kaya, qui trouvaient amusantes des choses \"enfantines\". Ça ne m'a jamais dérangé.",shape=box,color=blue];
		3457 -> 3460;
	3458 [label="Lors d'une célébration du solstice, des garçons plus âgés me l'ont volée avec un tas de mes autres jouets et, eh bien...",shape=box,color=blue];
		3458 -> 3461;
	3459 [label="Oh, merde. J'aurais dû m'en douter. Je suis vraiment désolé d'avoir soulevé ce sujet.",shape=box,color=blue];
		3459 -> 3462;
		3459 -> 3463;
	3460 [label="Mais parfois, j'ai peur que la partie de moi qui est capable de ressentir ce plaisir se soit recroquevillée et soit morte il y a longtemps.",shape=box,color=blue];
		3460 -> 3464;
	3461 [label="C'est une longue histoire. En bref? J'étais \"trop vieux\", disaient-ils, pour jouer avec des poupées. C'est la dernière fois que j'ai joué avec des jouets.",shape=box,color=blue];
		3461 -> 3465;
	3462 [label="Ce n’est pas le meilleur sujet de discussion pour moi, en effet.",shape=box,color=red];
		3462 -> 3466;
	3463 [label="Ce n'est pas grave. Ce n'est pas ta faute.",shape=box,color=red];
		3463 -> 3467;
	3464 [label="C'est un peu triste, non? On dit aux enfants d'aimer quelque chose, puis on leur dit d'y renoncer une fois qu'ils ont \"mûri\".",shape=box,color=blue];
		3464 -> 3468;
		3464 -> 3469;
	3465 [label="L'autre jour, je regardais Amir jouer à l'un de ses jeux. On voit à quel point il y est attaché. Le bonheur qu'ils lui procurent. Et j'étais un peu jaloux de ne rien avoir de tel dans ma vie.",shape=box,color=blue];
		3465 -> 3464;
	3466 [label="Maintenant, je me sens comme un vrai débile.",shape=box,color=blue];
		3466 -> 3470;
	3467 [label="Nous avions tous les jouets habituels, je suppose: des cubes, des peluches, des figurines, des poupées.",shape=box,color=red];
		3467 -> 3471;
	3468 [label="Je ne sais pas. On doit tous grandir un jour ou l'autre. On ne peut pas se cacher derrière des illusions. Je l'ai appris à mes dépens.",shape=box,color=red];
		3468 -> 3472;
	3469 [label="Je pense que la vie peut être laide, douloureuse et courte. Et nous devrions la remplir de plaisir, de rires et d'amour autant que possible.",shape=box,color=red];
		3469 -> 3473;
	3470 [label="Chat ends.",color=orange];
	3471 [label="La mienne est devenue un peu plus problématique à cause de toute cette histoire de... Néant.",shape=box,color=red];
		3471 -> 3450;
	3472 [label="C'est juste. Je pense que lorsque cela remplace la réalité, cela pose problème. Ce n'est pas ce que je veux dire.",shape=box,color=blue];
		3472 -> 3474;
	3473 [label="Tu as raison. Et j'espère que nous nous en souviendrons, tandis que nous avancerons ensemble dans... quelle que soit la situation dans laquelle nous nous trouvons.",shape=box,color=blue];
		3473 -> 3474;
	3474 [label="Tu sais, j'ai trouvé Eleanor, Velimir, Aoi et Amir, en train de jouer à cache-cache avec Flare et Lizzie. (Quincy a dit qu'il n'avait pas le droit de jouer parce que ce salaud trichait et utilisait sa lunette pour voir à travers les murs.)",shape=box,color=blue];
		3474 -> 3475;
	3475 [label="Ils me regardaient tous, inquiets que je sois contrarié de les avoir surpris en train de faire des bêtises alors qu'ils auraient dû faire quelque chose d'utile.",shape=box,color=blue];
		3475 -> 3476;
	3476 [label="J'étais surtout contrarié de ne pas avoir été invité. Héhé. Mais j'ai dû faire semblant d'être un chef grincheux et faire semblant que j'étais contrarié que les gens n'étaient pas à leur poste, etc.",shape=box,color=blue];
		3476 -> 3477;
	3477 [label="Mais Amir a ses jeux. Aoi a On-lyne. Même Kaya a ses autocollants et son Jinymon, même si le monde l'a forcée à devenir adulte trop tôt.",shape=box,color=blue];
		3477 -> 3478;
		3477 -> 3479;
	3478 [label="Tu essaies de démontrer quelque chose?",shape=box,color=red];
		3478 -> 3480;
	3479 [label="Je pense que c'est quelque chose que tu pourrais retrouver, si tu essayais. Trouver du plaisir dans les jouets et les jeux, je veux dire.",shape=box,color=red];
		3479 -> 3481;
	3480 [label="Honnêtement? Je n'en suis même pas sûr. J'ai juste l'impression qu'il me manque quelque chose qui a disparu de ma vie depuis très longtemps.",shape=box,color=blue];
		3480 -> 3482;
	3481 [label="J'entends encore les rires. Mais c'est sans doute ce qui me retient, non? La honte.",shape=box,color=blue];
		3481 -> 3483;
	3482 [label="Je ne sais pas si je pourrai un jour récupérer ça. Ou si c'est trop tard. Mais qui sait? Avec le temps, tout est peut-être possible.",shape=box,color=blue];
		3482 -> 3484;
	3483 [label="Je ne suis pas sûr qu'il soit possible de retrouver ça, même si je parvenais à surmonter la honte momentanée. Mais qui sait? Avec suffisamment de boucles, peut-être que tout est possible.",shape=box,color=blue];
		3483 -> 3485;
	3484 [label="Chat ends.",color=orange];
	3485 [label="Chat ends.",color=orange];
}