digraph {
	"ArthurRank6Convo4 begins." [color=orange];
		"ArthurRank6Convo4 begins." -> j456320303;
	j456320303 [label="J'ai une question étrange. Y a-t-il des jouets, dans l'espace?",shape=box,color=blue];
		j456320303 -> j49577899;
		j456320303 -> j456441932;
	j49577899 [label="Genre, des jouets pour enfants? Bien sûr.",shape=box,color=red];
		j49577899 -> j1760494073;
	j456441932 [label="Quel... genre de jouets?",shape=box,color=red];
		j456441932 -> j1830016154;
	j1760494073 [label="Heh. Vraiment?",shape=box,color=blue];
		j1760494073 -> j579850961;
	j1830016154 [label="Oh, PAR SOL. Ce n'est pas ce que je voulais dire, et tu le sais!",shape=box,color=blue];
		j1830016154 -> j2045639760;
	j579850961 [label="Difficile de se projeter quelques milliers d'années dans le futur,",shape=box,color=blue];
		j579850961 -> j2305558737;
	j2045639760 [label="Je veux dire, des jouets pour enfants. Des poupées. Des petits soldats. Des choses comme ça.",shape=box,color=blue];
		j2045639760 -> j1366109508;
		j2045639760 -> j3884025443;
	j2305558737 [label="Des enfants toujours assis à imaginer des histoires avec de petites figurines et à jouer aux \"bandits\" ou à \"sauver la princesse\".",shape=box,color=blue];
		j2305558737 -> j1136317431;
		j2305558737 -> j638942569;
		j2305558737 -> j2721554801;
	j1366109508 [label="Je voulais juste t'embêter. :P",shape=box,color=red];
		j1366109508 -> j2993797266;
	j3884025443 [label="Non, il n'y en a pas. [Fin.]",shape=box,color=red];
		j3884025443 -> "Chat ends.";
	j1136317431 [label="Pourquoi tu voulais demander ça?",shape=box,color=red];
		j1136317431 -> j1182606957;
	j638942569 [label="À quoi jouais-tu quand tu étais petit?",shape=box,color=red];
		j638942569 -> j3720716088;
	j2721554801 [label="Nos jeux avaient des noms différents, mais j'avais effectivement des jouets.",shape=box,color=red];
		j2721554801 -> j1702463452;
	j2993797266 [label="Oui, bien sûr que oui. ",shape=box,color=red];
		j2993797266 -> j1760494073;
	"Chat ends." [color=orange];
	j1182606957 [label="En fait, je regardais Amir jouer à l'un de ses jeux d'arcade. ",shape=box,color=blue];
		j1182606957 -> j809981664;
	j3720716088 [label="C'est plutôt réconfortant de penser que malgré toutes les différences entre nos cultures, les enfants continuent à s'asseoir et à jouer avec des jouets.",shape=box,color=blue];
		j3720716088 -> j2544382536;
	j1702463452 [label="Comme quoi?",shape=box,color=blue];
		j1702463452 -> j3033678908;
		j1702463452 -> j1869954822;
	j809981664 [label="Et je me suis dit: qu'est-ce que je ne donnerais pas pour retrouver ce genre de joie dans ma vie?",shape=box,color=blue];
		j809981664 -> j3585508467;
	j2544382536 [label="J'avais cette figurine d'action. John Rambeau. C'était un soldat, sans surprise.",shape=box,color=blue];
		j2544382536 -> j3646070600;
	j3033678908 [label="Toutes sortes de figurines, d'animaux en peluche et de cubes. Des trucs typiques pour les enfants. ",shape=box,color=red];
		j3033678908 -> j3720716088;
	j1869954822 [label="J'avais cette – je suppose qu'on pourrait l'appeler une figurine – de cet enfant Dax, que, eh bien, j'ai nommé d'après un personnage d'un livre que j'avais: Dominus Thrax.",shape=box,color=red];
		j1869954822 -> j3765786076;
	j3585508467 [label="Je n'ai jamais méprisé Aoi, ni Amir, ni même Kaya, qui trouvaient amusantes des choses \"enfantines\". Ça ne m'a jamais dérangé.",shape=box,color=blue];
		j3585508467 -> j2353498323;
	j3646070600 [label="Lors d'une célébration du solstice, des garçons plus âgés me l'ont volée avec un tas de mes autres jouets et, eh bien...",shape=box,color=blue];
		j3646070600 -> j1466526794;
	j3765786076 [label="Oh, merde. J'aurais dû m'en douter. Je suis vraiment désolé d'avoir soulevé ce sujet.",shape=box,color=blue];
		j3765786076 -> j4056370598;
		j3765786076 -> j195761754;
	j2353498323 [label="Mais parfois, j'ai peur que la partie de moi qui est capable de ressentir ce plaisir se soit recroquevillée et soit morte il y a longtemps.",shape=box,color=blue];
		j2353498323 -> j1080805920;
	j1466526794 [label="C'est une longue histoire. En bref? J'étais \"trop vieux\", disaient-ils, pour jouer avec des poupées. C'est la dernière fois que j'ai joué avec des jouets.",shape=box,color=blue];
		j1466526794 -> j683492578;
	j4056370598 [label="Ce n’est pas le meilleur sujet de discussion pour moi, en effet.",shape=box,color=red];
		j4056370598 -> j2842133827;
	j195761754 [label="Ce n'est pas grave. Ce n'est pas ta faute.",shape=box,color=red];
		j195761754 -> j316642391;
	j1080805920 [label="C'est un peu triste, non? On dit aux enfants d'aimer quelque chose, puis on leur dit d'y renoncer une fois qu'ils ont \"mûri\".",shape=box,color=blue];
		j1080805920 -> j1836184101;
		j1080805920 -> j2009035726;
	j683492578 [label="L'autre jour, je regardais Amir jouer à l'un de ses jeux. On voit à quel point il y est attaché. Le bonheur qu'ils lui procurent. Et j'étais un peu jaloux de ne rien avoir de tel dans ma vie.",shape=box,color=blue];
		j683492578 -> j1080805920;
	j2842133827 [label="Maintenant, je me sens comme un vrai débile.",shape=box,color=blue];
		j2842133827 -> "Chat ends.";
	j316642391 [label="Nous avions tous les jouets habituels, je suppose: des cubes, des peluches, des figurines, des poupées.",shape=box,color=red];
		j316642391 -> j3701818629;
	j1836184101 [label="Je ne sais pas. On doit tous grandir un jour ou l'autre. On ne peut pas se cacher derrière des illusions. Je l'ai appris à mes dépens.",shape=box,color=red];
		j1836184101 -> j1506531516;
	j2009035726 [label="Je pense que la vie peut être laide, douloureuse et courte. Et nous devrions la remplir de plaisir, de rires et d'amour autant que possible.",shape=box,color=red];
		j2009035726 -> j187666559;
	j3701818629 [label="La mienne est devenue un peu plus problématique à cause de toute cette histoire de... Néant.",shape=box,color=red];
		j3701818629 -> j3720716088;
	j1506531516 [label="C'est juste. Je pense que lorsque cela remplace la réalité, cela pose problème. Ce n'est pas ce que je veux dire.",shape=box,color=blue];
		j1506531516 -> j975543412;
	j187666559 [label="Tu as raison. Et j'espère que nous nous en souviendrons, tandis que nous avancerons ensemble dans... quelle que soit la situation dans laquelle nous nous trouvons.",shape=box,color=blue];
		j187666559 -> j975543412;
	j975543412 [label="Tu sais, j'ai trouvé Eleanor, Velimir, Aoi et Amir, en train de jouer à cache-cache avec Flare et Lizzie. (Quincy a dit qu'il n'avait pas le droit de jouer parce que ce salaud trichait et utilisait sa lunette pour voir à travers les murs.)",shape=box,color=blue];
		j975543412 -> j4148402611;
	j4148402611 [label="Ils me regardaient tous, inquiets que je sois contrarié de les avoir surpris en train de faire des bêtises alors qu'ils auraient dû faire quelque chose d'utile.",shape=box,color=blue];
		j4148402611 -> j2371815604;
	j2371815604 [label="J'étais surtout contrarié de ne pas avoir été invité. Héhé. Mais j'ai dû faire semblant d'être un chef grincheux et faire semblant que j'étais contrarié que les gens n'étaient pas à leur poste, etc.",shape=box,color=blue];
		j2371815604 -> j2271349400;
	j2271349400 [label="Mais Amir a ses jeux. Aoi a On-lyne. Même Kaya a ses autocollants et son Jinymon, même si le monde l'a forcée à devenir adulte trop tôt.",shape=box,color=blue];
		j2271349400 -> j173650529;
		j2271349400 -> j1355131128;
	j173650529 [label="Tu essaies de démontrer quelque chose?",shape=box,color=red];
		j173650529 -> j16562670;
	j1355131128 [label="Je pense que c'est quelque chose que tu pourrais retrouver, si tu essayais. Trouver du plaisir dans les jouets et les jeux, je veux dire.",shape=box,color=red];
		j1355131128 -> j4164515596;
	j16562670 [label="Honnêtement? Je n'en suis même pas sûr. J'ai juste l'impression qu'il me manque quelque chose qui a disparu de ma vie depuis très longtemps.",shape=box,color=blue];
		j16562670 -> j2292022735;
	j4164515596 [label="J'entends encore les rires. Mais c'est sans doute ce qui me retient, non? La honte.",shape=box,color=blue];
		j4164515596 -> j4134214423;
	j2292022735 [label="Je ne sais pas si je pourrai un jour récupérer ça. Ou si c'est trop tard. Mais qui sait? Avec le temps, tout est peut-être possible.",shape=box,color=blue];
		j2292022735 -> "Chat ends.";
	j4134214423 [label="Je ne suis pas sûr qu'il soit possible de retrouver ça, même si je parvenais à surmonter la honte momentanée. Mais qui sait? Avec suffisamment de boucles, peut-être que tout est possible.",shape=box,color=blue];
		j4134214423 -> "Chat ends.";
}