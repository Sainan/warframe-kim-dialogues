	3318 [label="Chat ends.",color=orange];
	3319 [label="Le seul aspect un tant soit peu agaçant, je crois, c'est que j'ai découvert ces pensées dans ton esprit en premier.",shape=box,color=blue];
		3319 -> 3320;
	3317 [label="Chat ends.",color=orange];
	3320 [label="Non pas que j'ignore que tu allais venir me demander poliment la permission. Bonjour.",shape=box,color=blue];
		3320 -> 3321;
	3321 [label="La réponse est un \"oui bien sûr\" boudeur et les bras croisés, tandis que je reste assise ici sans penser à toi en train de t'ébattre avec cette très belle chose que j'ai entrevue dans tes fantasmes.",shape=box,color=blue];
		3321 -> 3322;
	3322 [label="Ce sont donc maintenant MES fantasmes, alors que je suis coincée ici, à cette époque et à cet endroit, merci bien!",shape=box,color=blue];
		3322 -> 3323;
	3323 [label="Pardon. Je venais vraiment te demander ton consentement. Je sais que nous n'en avons jamais parlé auparavant. Je voulais m'assurer que tout ça te convenait.",shape=box,color=red];
		3323 -> 3324;
	3324 [label="Bien sûr que oui! Je vois qui c'est dans ton esprit. Et si tu lui fais confiance, alors je lui fais confiance aussi.",shape=box,color=blue];
		3324 -> 3325;
	3325 [label="Je suis juste triste de ne pas pouvoir faire partie de l'aventure.",shape=box,color=blue];
		3325 -> 3326;
	3326 [label="+20 Chemistry",color=orange];
		3326 -> 3327;
	3327 [label="Mais peut-être puis-je le faire par procuration à travers toi. Voilà une idée!",shape=box,color=blue];
		3327 -> 3328;
	3328 [label="Update boolean EleanorConsentComplete",color=orange];
		3328 -> 3329;
