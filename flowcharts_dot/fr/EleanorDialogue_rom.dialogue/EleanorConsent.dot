	"Chat ends." [color=orange];
	j3364311394 [label="Check boolean EleanorConsentComplete",color=orange];
		j3364311394 -> "Chat ends." [label=true,color=green];
		j3364311394 -> j334816020 [label=false,color=brown];
	j3528729371 [label="Check boolean EleanorPolyamorySuccess",color=orange];
		j3528729371 -> j3364311394 [label=true,color=green];
		j3528729371 -> "Chat ends." [label=false,color=brown];
	j334816020 [label="Le seul aspect un tant soit peu agaçant, je crois, c'est que j'ai découvert ces pensées dans ton esprit en premier.",shape=box,color=blue];
		j334816020 -> j1540949908;
	j1540949908 [label="Non pas que j'ignore que tu allais venir me demander poliment la permission. Bonjour.",shape=box,color=blue];
		j1540949908 -> j3927018287;
	j3927018287 [label="La réponse est un \"oui bien sûr\" boudeur et les bras croisés, tandis que je reste assise ici sans penser à toi en train de t'ébattre avec cette très belle chose que j'ai entrevue dans tes fantasmes.",shape=box,color=blue];
		j3927018287 -> j45070035;
	j45070035 [label="Ce sont donc maintenant MES fantasmes, alors que je suis coincée ici, à cette époque et à cet endroit, merci bien!",shape=box,color=blue];
		j45070035 -> j3064132798;
	j3064132798 [label="Pardon. Je venais vraiment te demander ton consentement. Je sais que nous n'en avons jamais parlé auparavant. Je voulais m'assurer que tout ça te convenait.",shape=box,color=red];
		j3064132798 -> j3097272276;
	j3097272276 [label="Bien sûr que oui! Je vois qui c'est dans ton esprit. Et si tu lui fais confiance, alors je lui fais confiance aussi.",shape=box,color=blue];
		j3097272276 -> j301384630;
	j301384630 [label="Je suis juste triste de ne pas pouvoir faire partie de l'aventure.",shape=box,color=blue];
		j301384630 -> j2327019471;
	j2327019471 [label="+20 Chemistry",color=orange];
		j2327019471 -> j3916388866;
	j3916388866 [label="Mais peut-être puis-je le faire par procuration à travers toi. Voilà une idée!",shape=box,color=blue];
		j3916388866 -> j298331240;
	j298331240 [label="Boolean EleanorConsentComplete is now true.",color=orange];
		j298331240 -> "Chat ends.";
}