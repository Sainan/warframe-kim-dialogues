digraph {
	1123 [label="EleanorRank3Convo4 begins.",color=orange];
		1123 -> 1124;
	1124 [label="Alors, arrête-moi si je me trompe:",shape=box,color=blue];
		1124 -> 1125;
	1125 [label="Tu as un autre toi qui se promène. Cet autre toi est et n'est pas toi à la fois. C'est comme une version enfant de toi issue d'une autre version de la réalité.",shape=box,color=blue];
		1125 -> 1126;
		1125 -> 1127;
	1126 [label="Pas tout à fait. C'est sa version de la réalité. Je suis la personne étrangère, ici.",shape=box,color=red];
		1126 -> 1128;
	1127 [label="C'est plutôt comme une séparation à un moment donné; j'ai pris à gauche, l'autre à droite.",shape=box,color=red];
		1127 -> 1129;
	1128 [label="Wouah quand même. Attends. Laisse-moi intégrer ça.",shape=box,color=blue];
		1128 -> 1130;
	1129 [label="Et je suppose que nous sommes dans SA réalité, pas la tienne. Laisse-moi... digérer cela.",shape=box,color=blue];
		1129 -> 1130;
	1130 [label="Alors... tu es comme une guest star d'un épisode particulier qui débarque dans la série?",shape=box,color=blue];
		1130 -> 1131;
	1131 [label="À peu près.",shape=box,color=red];
		1131 -> 1132;
	1132 [label="J'en ai la tête qui tourne. Alors, qu'est-il arrivé à ta version de la réalité? Où est-elle passée?",shape=box,color=blue];
		1132 -> 1133;
		1132 -> 1134;
		1132 -> 1135;
	1133 [label="Je pense que la seule chose qui en reste est le vaisseau fantôme Zariman qui bouche un trou entre les dimensions...?",shape=box,color=red];
		1133 -> 1136;
	1134 [label="Je pense que tout ce qu'il en restait est allé à Duviri avec moi. Pour le meilleur ou pour le pire.",shape=box,color=red];
		1134 -> 1137;
	1135 [label="Je ne m'attarde pas trop là-dessus. Je suppose que c'est perdu.",shape=box,color=red];
		1135 -> 1138;
	1136 [label="Check boolean EleanorHoldfasts1",color=orange];
		1136 -> 1139 [label=true,color=green];
		1136 -> 1140 [label=false,color=brown];
	1137 [label="Alors, dans un certain sens, elle continue à exister.",shape=box,color=blue];
		1137 -> 1145;
	1138 [label="On ne peut pas simplement PERDRE tout un cosmos. C'est insensé. Il doit bien exister quelque part.",shape=box,color=blue];
		1138 -> 1146;
	1139 [label="Ah! Le repaire de tes gentils fantômes. Les Irréductibles.",shape=box,color=blue];
		1139 -> 1141;
	1140 [label="Je suis désolée, cela semble fascinant mais je n'ai aucune idée de quoi tu parles.",shape=box,color=blue];
		1140 -> 1142;
	1145 [label="Je ne sais pas si cela te réconforte vraiment.",shape=box,color=blue];
		1145 -> 1147;
	1146 [label="C'est peut-être possible. Comme je l'ai dit, ce n'est pas ma principale préoccupation.",shape=box,color=red];
		1146 -> 1148;
	1141 [label="Je ne peux pas imaginer que ce soit le genre d’endroit où tu voudrais revenir pour une promenade nostalgique.",shape=box,color=blue];
		1141 -> 1143;
	1142 [label="Un vaisseau fantôme?",shape=box,color=blue];
		1142 -> 1144;
	1147 [label="J'ai appris que la maison et la famille dépendent davantage de ce que tu fais du \"où\" et du \"qui\" qui t'entourent.",shape=box,color=red];
		1147 -> 1149;
	1148 [label="Mais c'est CHEZ TOI. Tu ne veux pas y retourner?",shape=box,color=blue];
		1148 -> 1150;
	1143 [label="Je ne peux pas imaginer ce que tu as perdu.",shape=box,color=blue];
		1143 -> 1151;
	1144 [label="Un trou entre les dimensions?",shape=box,color=blue];
		1144 -> 1152;
	1149 [label="Et non le lieu et les circonstances de ta naissance.",shape=box,color=red];
		1149 -> 1157;
	1150 [label="Ce n'est plus vraiment le cas. Je n'ai pas exactement de chez-moi.",shape=box,color=red];
		1150 -> 1158;
	1151 [label="Je ne vois pas les choses de cette façon.",shape=box,color=red];
		1151 -> 1153;
	1152 [label="Le Zariman était le vaisseau de colonisation sur lequel je me trouvais. Il se dirigeait vers Tau. Il n'y est jamais parvenu.",shape=box,color=red];
		1152 -> 1154;
	1157 [label="Je ne me concentre pas sur ce qui a été perdu. Je me concentre sur ce qu'il me reste. Comme cet endroit. Comme vous tous. Parce que...",shape=box,color=red];
		1157 -> 1159;
	1158 [label="Le surnom de \"Voyageur\" m'est resté pour une raison, tu sais.",shape=box,color=red];
		1158 -> 1159;
	1153 [label="J'ai réussi à m'en sortir. J'ai survécu. Quelle chance incroyable, non?",shape=box,color=red];
		1153 -> 1155;
	1154 [label="Il s'est retrouvé dans le Néant, et quelque chose qui existait là-bas a décidé de transformer le vaisseau en une vision de l'enfer.",shape=box,color=red];
		1154 -> 1156;
	1159 [label="De tous les endroits que j'ai visités, c'est celui-ci qui me semble être celui auquel j'appartiens le plus.",shape=box,color=red];
		1159 -> 1171;
	1155 [label="Honnêtement, les chances que l'un d'entre nous existe réellement sont si minces que c'est juste un miracle de plus pour moi.",shape=box,color=red];
		1155 -> 1160;
	1156 [label="Il a fait des allers-retours entre le Néant et la réalité, et maintenant il est coincé entre les deux.",shape=box,color=red];
		1156 -> 1161;
	1171 [label="Huh. J'en suis étrangement fière.",shape=box,color=blue];
		1171 -> 1172;
	1160 [label="Ne nous concentrons pas sur ce que nous avons perdu. Chérissons ce que nous avons.",shape=box,color=red];
		1160 -> 1170;
	1161 [label="Ce n'est pas vraiment un seul vaisseau non plus. C'est comme... beaucoup de versions différentes à la fois.",shape=box,color=red];
		1161 -> 1162;
	1172 [label="Peut-être avais-tu simplement besoin d'un groupe de bio-commandos urbains au style mortel avec lesquels t'associer.",shape=box,color=blue];
		1172 -> 1173;
	1170 [label="Par exemple? J'ai cet endroit, maintenant. Et vous tous. C'est le premier endroit où je me sens vraiment chez moi.",shape=box,color=red];
		1170 -> 1171;
	1162 [label="Update boolean EleanorHoldfasts1",color=orange];
		1162 -> 1163;
	1173 [label="Des marginaux et des tordus comme moi?",shape=box,color=red];
