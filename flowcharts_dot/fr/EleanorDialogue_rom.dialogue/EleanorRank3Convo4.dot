	1183 [label="Je me demande si elle me laisserait en faire partie? Est-ce que je pourrais devenir une Tenno?",shape=box,color=blue];
		1183 -> 1184;
	1186 [label="L'enfant a des milliards d'années, mais il a passé la majeure partie de son temps dans un congélateur, donc c'est toujours un enfant, n'est-ce pas?",shape=box,color=blue];
		1186 -> 1187;
		1186 -> 1188;
	1184 [label="Non, je ne pense pas que ce serait possible, n'est-ce pas? Je suis trop vieille, pour commencer.",shape=box,color=blue];
		1184 -> 1185;
	1187 [label="Quelque chose comme ça.",shape=box,color=red];
		1187 -> 1189;
	1188 [label="Je ne pense pas qu'il s'agisse vraiment d'un \"enfant\" alors qu'il a été entraîné à tuer.",shape=box,color=red];
