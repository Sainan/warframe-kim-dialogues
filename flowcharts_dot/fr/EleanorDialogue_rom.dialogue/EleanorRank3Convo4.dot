	1179 [label="Étant donné tout ce que vous avez en commun, tu pourrais être un peu plus sympa.",shape=box,color=blue];
		1179 -> 1185;
	1169 [label="Ne nous concentrons pas sur ce que nous avons perdu. Chérissons ce que nous avons.",shape=box,color=red];
