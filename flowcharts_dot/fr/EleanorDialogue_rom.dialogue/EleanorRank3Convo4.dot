		1251 -> 1252;
		1251 -> 1253;
	1249 [label="En fait, en apprenant l'existence de ta version alternative, je me suis convaincue qu'il doit y avoir une autre moi, quelque part, qui a décidé de devenir religieuse. Une apôtre de Lua, la tête rasée, des prières régulières, tout ça.",shape=box,color=blue];
