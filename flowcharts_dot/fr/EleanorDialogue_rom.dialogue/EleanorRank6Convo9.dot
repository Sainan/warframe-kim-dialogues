digraph {
	3255 [label="EleanorRank6Convo9 begins.",color=orange];
		3255 -> 3256;
	3256 [label="Alors, maintenant que j'y pense, qu'est-ce qu'un \"Mara Lohk\"?",shape=box,color=blue];
		3256 -> 3257;
		3256 -> 3258;
	3257 [label="C'est ainsi que l'Indifférence m'appelle.",shape=box,color=red];
		3257 -> 3259;
	3258 [label="Je ne sais pas. C'est en langue du Néant.",shape=box,color=red];
		3258 -> 3259;
	3259 [label="Ah. Parce que j'entends parfois ça dans ma tête, très faiblement, quand je te regarde.",shape=box,color=blue];
		3259 -> 3260;
	3260 [label="Check boolean EleanorDating",color=orange];
		3260 -> 3262 [label=true,color=green];
		3260 -> 3261 [label=false,color=brown];
	3262 [label="(Avec d'autres choses comme \"ohhhpfiouuu\", \"bordel de merde\" et \"c'est MON Voyageur, ça\".)",shape=box,color=blue];
		3262 -> 3263;
	3261 [label="(Avec d'autres choses comme \"putain, cette personne est cool quand même\" et \"c'est une bonne âme\".)",shape=box,color=blue];
		3261 -> 3263;
	3263 [label="Y a-t-il des mots dans cette langue que tu connais?",shape=box,color=blue];
		3263 -> 3264;
	3264 [label="Quelques-uns. ",shape=box,color=red];
		3264 -> 3265;
	3265 [label="Netra signifie \"Décadence\", Xata signifie \"Vérité\", Ris signifie \"Lumière\"...",shape=box,color=red];
		3265 -> 3266;
	3266 [label="Lohk signifie \"Néant\", Oull signifie \"possibilité\", Khra signifie \"temps\"...",shape=box,color=red];
		3266 -> 3267;
	3267 [label="Bonne chance pour écrire un poème avec ça.",shape=box,color=blue];
		3267 -> 3268;
	3268 [label="Attends. Si \"Lohk\", c'est Néant, alors un Mara Lohk est un Quelque Chose du Néant. Ou en rapport avec le Néant.",shape=box,color=blue];
		3268 -> 3269;
	3269 [label="Mare du Néant? Cauchemar? Diable du Néant?",shape=box,color=blue];
		3269 -> 3270;
		3269 -> 3271;
	3270 [label="Sois prudente. C'est plus qu'une simple langue.",shape=box,color=red];
		3270 -> 3272;
	3271 [label="Bof, j'ai entendu pire.",shape=box,color=red];
		3271 -> 3273;
	3272 [label="Est-ce le moment où je regarde par-dessus mon épaule et vois une Eleanor aux yeux noirs me sourire en retour?",shape=box,color=blue];
		3272 -> 3274;
	3273 [label="Attends-toi à ce que je revienne et que je te harcèle encore à ce sujet.",shape=box,color=blue];
		3273 -> 3275;
	3274 [label="Je pense que je vais jeter un petit coup d'oeil juste pour être sûre...",shape=box,color=blue];
		3274 -> 3276;
	3275 [label="+5 Chemistry",color=orange];
		3275 -> 3277;
	3276 [label="OH MERDE",shape=box,color=blue];
		3276 -> 3278;
	3277 [label="Je ne peux pas m'empêcher de fouiner. C'est la journaliste en moi.",shape=box,color=blue];
		3277 -> 3279;
	3278 [label="Quoi?",shape=box,color=red];
		3278 -> 3280;
	3279 [label="Chat ends.",color=orange];
