digraph {
	2968 [label="EleanorRank6Convo4 begins.",color=orange];
		2968 -> 2969;
	2969 [label="As-tu déjà eu cette sensation où, pendant que tu prends une douche, tu entends soudain une étrange petite voix te poser une question à laquelle tu n'avais jamais vraiment pensé auparavant?",shape=box,color=blue];
		2969 -> 2970;
		2969 -> 2971;
		2969 -> 2972;
	2970 [label="Pas vraiment, non. [Fin.]",shape=box,color=red];
		2970 -> 2973;
	2971 [label="Comme \"Qu'ont pensé les gens sur Terre lorsque Lua est soudainement réapparue dans le ciel ?\"",shape=box,color=red];
		2971 -> 2974;
	2972 [label="Tu veux dire, genre \"Opérateur! Pourriez-vous envisager de faire empailler votre Kubrow?\"",shape=box,color=red];
		2972 -> 2975;
	2973 [label="Chat ends.",color=orange];
	2974 [label="Oui, exactement.",shape=box,color=blue];
		2974 -> 2976;
	2975 [label="C'est Ordis. Il dit des choses comme ça.",shape=box,color=red];
		2975 -> 2977;
	2976 [label="attends",shape=box,color=blue];
		2976 -> 2978;
	2977 [label="Que les Dieux le bénissent. Non, je parle d'une voix intérieure.",shape=box,color=blue];
		2977 -> 2979;
	2978 [label="Lua a disparu?",shape=box,color=blue];
		2978 -> 2980;
	2979 [label="Un peu comme si ton cerveau s'occupait pendant que tu te consacres à l'importante tâche de l'hygiène personnelle.",shape=box,color=blue];
		2979 -> 2981;
	2980 [label="Pendant combien de temps? Où est-elle allée? Qu'est-il arrivé aux marées?",shape=box,color=blue];
		2980 -> 2982;
		2980 -> 2983;
	2981 [label="Ça m'arrive tout le temps. Étrangement, aléatoirement. À tel point ces derniers temps que je me demande si elles viennent vraiment de ma propre tête. ",shape=box,color=blue];
		2981 -> 2984;
	2982 [label="Dans l'ordre: je ne sais pas, le Néant, je ne sais pas.",shape=box,color=red];
		2982 -> 2985;
	2983 [label="Le Lotus l'a envoyée dans le Néant à la fin de l'Ancienne Guerre. Le gamin l'a ramenée récemment.",shape=box,color=red];
		2983 -> 2986;
	2984 [label="J'en ai transformé certaines en peintures.",shape=box,color=blue];
		2984 -> 2985;
	2985 [label="peu importe, on pourra y revenir.",shape=box,color=blue];
		2985 -> 2987;
	2986 [label="Aucune idée concernant les marées.",shape=box,color=red];
		2986 -> 2988;
	2987 [label="Alors, question pensées aléatoires sous la douche. J'ai été frappée par une vraie bombe ce matin.",shape=box,color=blue];
		2987 -> 2989;
	2988 [label="Comment le Lotus a-t-elle déplacé une LUNE entière?",shape=box,color=blue];
		2988 -> 2985;
	2989 [label="Ça disait: \"Hé, et si les Dieux étaient réels?\"",shape=box,color=blue];
		2989 -> 2990;
	2990 [label="J'ai eu un moment de vertige. J'ai dû me faire couler un peu d'eau froide sur le visage pour me ressaisir.",shape=box,color=blue];
		2990 -> 2991;
		2990 -> 2992;
		2990 -> 2993;
	2991 [label="Qu'est-ce qu'il y a de bizarre là-dedans? Ça me semble une question assez basique.",shape=box,color=red];
		2991 -> 2994;
	2992 [label="… Les gens ne croient-ils pas que les dieux existent? Je parie que Lettie le pense.",shape=box,color=red];
		2992 -> 2995;
	2993 [label="Ouais, c'est une pensée horrible.",shape=box,color=red];
		2993 -> 2996;
	2994 [label="Ah, c'est pour ça que j'adore te parler de ces choses",shape=box,color=blue];
		2994 -> 2997;
	2995 [label="Oh, allez. Personne ne croit vraiment que les Dieux existent. Pas comme, je ne sais pas, les tables et les chaises.",shape=box,color=blue];
		2995 -> 2998;
	2996 [label="N'est-ce pas? Et si chaque fois que tu penses que l'univers t'envoie un message, c'est effectivement le cas?",shape=box,color=blue];
		2996 -> 2999;
	2997 [label="Ta vie est si fantastiquement absurde que la réalité des Dieux est pour toi une spéculation aussi naturelle que les mérites relatifs des garnitures de pizza.",shape=box,color=blue];
		2997 -> 3000;
	2998 [label="Les vrais Dieux sont comme les puits de village et les toilettes extérieures. C'est quelque chose que les gens avaient AUTREFOIS. ",shape=box,color=blue];
		2998 -> 3001;
	2999 [label="Imagine que tout soit entre les mains de ces petits salauds immortels qui sont aux commandes simplement parce que c'est comme ça que les choses sont, et non parce qu'ils le méritent.",shape=box,color=blue];
		2999 -> 3002;
	3000 [label="Tu as peut-être même rencontré un Dieu. Si c'est ce qu'est l'Indifférence.",shape=box,color=blue];
		3000 -> 3003;
	3001 [label="De nos jours, ce ne sont plus que des symboles, des métaphores ou des conneries comme ça.",shape=box,color=blue];
		3001 -> 3004;
		3001 -> 3005;
	3002 [label="Et le plus fou, c'est que c'est ainsi que les gens vivaient. C'était leur réalité, chaque jour de leur vie.",shape=box,color=blue];
		3002 -> 3006;
	3003 [label="Tu viens de me rappeler quelque chose, sur le Zariman. La première fois que j'ai rencontré l'Indifférence.",shape=box,color=red];
		3003 -> 3007;
	3004 [label="Peut-être que les gens ont simplement moins peur?",shape=box,color=red];
		3004 -> 3008;
	3005 [label="Je pensais que Sol et Lua étaient tes Dieux.",shape=box,color=red];
		3005 -> 3009;
	3006 [label="Pour eux, les Dieux étaient aussi réels que le temps et ils se souciaient vraiment d'eux.",shape=box,color=blue];
		3006 -> 3010;
	3007 [label="Je ne savais pas ce que c'était à l'époque, bien sûr. Mais je me souviens de ses paroles.",shape=box,color=red];
		3007 -> 3011;
	3008 [label="Je pense que c'est ça, ouais. ",shape=box,color=blue];
		3008 -> 3012;
	3009 [label="Eh bien oui, c'est vrai. Mais ce ne sont que des corps célestes. ",shape=box,color=blue];
		3009 -> 3013;
	3010 [label="Cela ne semble pas si différent de la vie sous les Orokins, honnêtement.",shape=box,color=red];
		3010 -> 3014;
	3011 [label="J'ai dit qu'il pouvait prendre ma lumière, puis il m'a souri et il m'a dit : \"Merci, gamin. J'y compte bien.\"",shape=box,color=red];
		3011 -> 3015;
	3012 [label="Je pense que je sais pourquoi aussi.",shape=box,color=blue];
		3012 -> 3016;
	3013 [label="Tout comme Britannia est un pays, avec un nom, une identité, etc., mais c'est aussi un amas de terre et de rochers. Elle peut être les deux à la fois.",shape=box,color=blue];
		3013 -> 3017;
	3014 [label="Immortels, mesquins, responsables parce qu'ils étaient responsables...",shape=box,color=red];
		3014 -> 3018;
	3015 [label="Oh merde, tu me donnes des frissons",shape=box,color=blue];
		3015 -> 3019;
	3016 [label="C'est une question de lumière.",shape=box,color=blue];
		3016 -> 3020;
	3017 [label="Tu peux sortir par une belle journée ensoleillée, te sentir reconnaissant, lever les yeux vers Sol et dire \"Merci!\" Tu le penses vraiment. C'est humain.",shape=box,color=blue];
		3017 -> 3021;
	3018 [label="C'est vrai. Vous AVIEZ des Dieux vivants. Mais vous les avez tous tués.",shape=box,color=blue];
		3018 -> 3022;
	3019 [label="Le diable se cache dans les détails, il aime jouer avec l’esprit, comme dans les vieux contes de fées.",shape=box,color=blue];
		3019 -> 3023;
	3020 [label="Que sont Sol et Lua, après tout? Avant que quiconque ne pense à eux comme à des Dieux? C'étaient des LUMIÈRES.",shape=box,color=blue];
		3020 -> 3024;
		3020 -> 3025;
	3021 [label="Mais personne aujourd'hui ne pense que Sol ou Lua ont littéralement mis enceinte une femme humaine ou ont materné l'enfant d'un homme humain et que c'est de là que vient le Roi.",shape=box,color=blue];
		3021 -> 3026;
	3022 [label="(Ne te méprends pas, j'approuve totalement.)",shape=box,color=blue];
		3022 -> 3027;
	3023 [label="Tu penses qu'il croit que tu lui as fait une promesse? Ta \"lumière\"?",shape=box,color=blue];
		3023 -> 3028;
		3023 -> 3029;
	3024 [label="C'est vrai. La lumière symbolise le bien, où que tu ailles.",shape=box,color=red];
		3024 -> 3030;
	3025 [label="Les seules lumières que l'humanité ait eu, pendant très, très longtemps.",shape=box,color=red];
		3025 -> 3030;
	3026 [label="Avant, on croyait à ces histoires. Maintenant, on sait que ce n'étaient que des légendes. On les a dépassées.",shape=box,color=blue];
		3026 -> 3031;
		3026 -> 3032;
	3027 [label="Tu me confonds avec le gamin. Je n'ai jamais participé à la grande insurrection Tenno.",shape=box,color=red];
		3027 -> 3033;
	3028 [label="Il dit qu'on a conclu un \"marché\". Donc, je suppose qu'il pense que je lui dois... quelque chose.",shape=box,color=red];
		3028 -> 3034;
	3029 [label="Je parlais du globe lumineux que je portais, mais qui sait ce que cela signifiait.",shape=box,color=red];
		3029 -> 3034;
	3030 [label="OUI.",shape=box,color=blue];
		3030 -> 3035;
	3031 [label="Les dieux et les humains... ensemble?",shape=box,color=red];
		3031 -> 3036;
	3032 [label="Des rois avec des dieux pour parents? Et dire que je pensais que les Orokins étaient des fumiers.",shape=box,color=red];
		3032 -> 3036;
	3033 [label="Je n'ai jamais pu faire partie du programme de Margulis pour les enfants très spéciaux, je n'ai jamais eu de Warframe, je n'ai jamais combattu dans l'Ancienne Guerre.",shape=box,color=red];
		3033 -> 3037;
	3034 [label="Je sais au moins une chose à son sujet: il aime jouer.",shape=box,color=red];
		3034 -> 3038;
	3035 [label="Mais ensuite, un petit malin des cavernes qui était probablement harcelé par toutes les filles des cavernes plus âgées a frappé un rocher contre un autre et bingo.",shape=box,color=blue];
		3035 -> 3039;
	3036 [label="Oh, c'est arrivé souvent. Partout dans le monde.",shape=box,color=blue];
		3036 -> 3040;
	3037 [label="... tu aurais aimé?",shape=box,color=blue];
		3037 -> 3041;
		3037 -> 3042;
		3037 -> 3043;
	3038 [label="+20 Chemistry",color=orange];
		3038 -> 3044;
	3039 [label="La lumière à la demande! L'indépendance face aux lumières du ciel!",shape=box,color=blue];
		3039 -> 3045;
	3040 [label="Imagine que tu es un prêtre arrogant qui part au-delà des mers pour apporter l'évangile de Sol aux \"sauvages\" du nouveau monde, pour découvrir qu'ils savent non seulement déjà tout sur Sol, mais qu'ils ont le fils de Sol qui règne sur eux.",shape=box,color=blue];
		3040 -> 3046;
	3041 [label="Je ne sais vraiment pas.",shape=box,color=red];
		3041 -> 3047;
	3042 [label="Honnêtement, non.",shape=box,color=red];
		3042 -> 3048;
	3043 [label="Ouais, vraiment.",shape=box,color=red];
		3043 -> 3049;
	3044 [label="Ok. Quoi que tu fasses aujourd'hui, avec qui que tu sois, que ce soit moi, Arthur ou l'un d'entre nous... reste en sécurité.",shape=box,color=blue];
		3044 -> 3050;
	3045 [label="Regarde-nous, maintenant. La lumière est partout. Nous l'avons dépréciée.",shape=box,color=blue];
		3045 -> 3003;
	3046 [label="Tu rentrerais chez toi la queue entre les jambes ou tu te convertirais sur-le-champ.",shape=box,color=blue];
		3046 -> 3051;
		3046 -> 3052;
	3047 [label="Je comprends. Je respecte ça.",shape=box,color=blue];
		3047 -> 3057;
	3048 [label="Je suis contente. Si tu penses que ta vie aurait pu être pire, j'imagine qu'on a quelque chose à fêter?",shape=box,color=blue];
		3048 -> 3057;
	3049 [label="Je comprends, je crois. Tu as raté un moment important, n'est-ce pas?",shape=box,color=blue];
