		j4129181419 -> "Chat ends.";
	j1455155399 [label="... Je veux seulement que tu saches que pour moi, ce sera toujours sa voix de John Rambeau.",shape=box,color=blue];
		j1455155399 -> j4268047268;
	j2805573569 [label="C'est comme écouter quelqu'un te préparer un milkshake à la testostérone préparé dans une bétonnière.",shape=box,color=blue];
		j2805573569 -> j3369678971;
	"Chat ends." [color=orange];
	j4268047268 [label="\"RESTEZ CALME ET LAISSEZ LES PROFESSIONNELS GÉRER ÇA\" grogne Arthur, 8 ans, alors que John Rambeau et le SAS en plastique sauvent une de mes poupées Sandie de l'armée des dinosaures",shape=box,color=blue];
