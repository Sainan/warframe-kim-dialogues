	j2284947836 [label="Je veux dire, ce n'est pas MAL",shape=box,color=blue];
		j2284947836 -> j1476773941;
	j4074303452 [label="J'ai l'impression que tu DOIS savoir ce que je veux dire, mais je vais considérer que tu réponds en toute bonne foi.",shape=box,color=blue];
		j4074303452 -> j1740391523;
	j2931127628 [label="Merveilleux. Un cas évident d'immunité naturelle!",shape=box,color=blue];
		j2931127628 -> j4129181419;
	j3305939235 [label="il y en a certainement d'autres dans ce cas, d'après ce que j'ai compris",shape=box,color=blue];
		j3305939235 -> j1455155399;
	j1476773941 [label="Mais je ne peux pas vraiment le prendre au sérieux. Il y a des raisons.",shape=box,color=blue];
		j1476773941 -> j1455155399;
	j1740391523 [label="La plupart du temps, Arthur parle comme un être humain assez normal, mais il y a des moments où il fait la Voix.",shape=box,color=blue];
		j1740391523 -> j2805573569;
