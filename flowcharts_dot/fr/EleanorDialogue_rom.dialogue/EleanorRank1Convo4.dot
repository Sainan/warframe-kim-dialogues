	252 [label="Oh par les dieux, je m'en souviens maintenant. Éris. Les géants. La surface de Deimos.",shape=box,color=blue];
		252 -> 253;
	253 [label="J'oublie toujours qu'on ne gagne pas contre le Techrot.",shape=box,color=blue];
		253 -> 258;
	250 [label="Je suppose que non. Et je n'ai pas vraiment le droit de spéculer.",shape=box,color=blue];
		250 -> 251;
