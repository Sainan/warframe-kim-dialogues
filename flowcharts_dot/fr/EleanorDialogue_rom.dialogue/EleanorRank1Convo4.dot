digraph {
	220 [label="EleanorRank1Convo4 begins.",color=orange];
		220 -> 221;
	221 [label="Comment est-ce? Avoir la liberté de te promener dans une ville infectée par une peste et savoir que tu n'auras jamais à te soucier de l'attraper?",shape=box,color=blue];
		221 -> 222;
		221 -> 223;
		221 -> 224;
	222 [label="\"Me promener\" n'est pas juste, Eleanor.",shape=box,color=red];
		222 -> 225;
