	259 [label="Sol. Je m'apitoie sur moi-même parce que je suis une victime de ce fléau, et je m'en prends à toi parce que tu as ton immunité, et que tu as vu des mondes entiers se faire dévorer par la même crasse infecte.",shape=box,color=blue];
		259 -> 268;
	254 [label="Ignore-moi. Laisser paraître ses défaut est déjà hideux. L'apitoiement sur soi-même est encore plus laid.",shape=box,color=blue];
