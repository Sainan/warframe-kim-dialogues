		255 -> 257 [label=false,color=brown];
	232 [label="...",shape=box,color=blue];
		232 -> 233;
	229 [label="Chat ends.",color=orange];
	231 [label="Je ne pense pas qu'on puisse te tuer. Pas pour toujours. Et je sais à quel point les gens ont essayé de toutes leurs forces.",shape=box,color=blue];
		231 -> 236;
	256 [label="On se demande pourquoi il n'a jamais été infecté. Sa famille, elle, l'a été.",shape=box,color=blue];
		256 -> 263;
	257 [label="Il a au moins réussi à se protéger de la mort. Peut-être qu'il te ressemble plus que tu ne le penses.",shape=box,color=blue];
		257 -> 263;
	233 [label="Très bien. Tu m'as eue. Désolée.",shape=box,color=blue];
		233 -> 234;
	236 [label="Tu ne sembles pas avoir peur du Techrot. Pourquoi serait-ce le cas? Tu n'as aucune raison d'avoir peur.",shape=box,color=blue];
		236 -> 237;
	263 [label="La Höllvanie a connu tout un tas de sauveurs en devenir.",shape=box,color=blue];
		263 -> 264;
	234 [label="Eleanor est comme un citron amer aujourd'hui.",shape=box,color=blue];
		234 -> 235;
	237 [label="Tu ne l'attraperas pas.",shape=box,color=blue];
		237 -> 245;
		237 -> 246;
		237 -> 247;
	264 [label="La princesse, autrefois. Puis Entrati. Viktor. Mon frère, bien sûr. Et maintenant, toi.",shape=box,color=blue];
		264 -> 265;
	235 [label="Sol, le goût des citrons me manque.",shape=box,color=blue];
		235 -> 238;
		235 -> 239;
	245 [label="Tu ne connais pas cette chose aussi bien que moi. Elle évolue. Elle mute. Elle apprend. Les Orokins pensaient pouvoir la vaincre. Ils n'y sont jamais parvenus.",shape=box,color=red];
		245 -> 249;
	246 [label="Peut-être que tu as raison. Mais nous ne le SAVONS pas.",shape=box,color=red];
