		271 -> 281;
	272 [label="Oui. En effet.",shape=box,color=red];
		272 -> 276;
	273 [label="Non. Pas du tout.",shape=box,color=red];
		273 -> 280;
	274 [label="Je ne crois pas aux héros.",shape=box,color=red];
		274 -> 279;
	240 [label="Rien que je serais fière d’admettre.",shape=box,color=blue];
