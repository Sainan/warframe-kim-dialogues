digraph {
	"EleanorRank6Convo2 begins." [color=orange];
		"EleanorRank6Convo2 begins." -> j1958694482;
	j1958694482 [label="Salut. Je voudrais te faire part de quelques idées.",shape=box,color=blue];
		j1958694482 -> j1940193248;
	j1940193248 [label="Je pensais à Fiendsnight. Je ne me suis pas déguisée depuis des années, mais en feuilletant une BD d'Amir, je me suis dit: \"Tiens, je pourrais être la Contessa!\" J'ai les crocs pour ça et tout!",shape=box,color=blue];
		j1940193248 -> j2960155612;
	j2960155612 [label="Mais est-ce trop évident? Devrais-je plutôt choisir Dandy Damage?",shape=box,color=blue];
		j2960155612 -> j3026845401;
		j2960155612 -> j1528730703;
		j2960155612 -> j2751019651;
	j3026845401 [label="Qui c'est, Dandy Damage?",shape=box,color=red];
		j3026845401 -> j3569541215;
	j1528730703 [label="Tu pourrais toujours te déguiser en Lotus, si tu veux embrouiller les gens.",shape=box,color=red];
		j1528730703 -> j2523704319;
	j2751019651 [label="… tu vas devoir m'expliquer ce qu'est Fiendsnight.",shape=box,color=red];
		j2751019651 -> j3127725727;
	j3569541215 [label="Oh là. ",shape=box,color=blue];
		j3569541215 -> j1329461977;
	j2523704319 [label="Oh mon Dieu, non. Je l'ai vue dans ta tête. Je ne pourrais jamais lui rendre justice.",shape=box,color=blue];
		j2523704319 -> j308223812;
	j3127725727 [label="Mmm. J'oublie parfois que tu viens de si loin. ",shape=box,color=blue];
		j3127725727 -> j2598445774;
	j1329461977 [label="Dandy Damage a posé les fondations sur lesquelles Temple and the Rippers se sont construits. Il était le cauchemar de toutes les mères et le rêve de tous les ados.",shape=box,color=blue];
		j1329461977 -> j2438918484;
	j308223812 [label="Et ce casque. Est-ce un casque? Est-ce qu'il fait partie d'elle? Comment voit-elle à travers?",shape=box,color=blue];
		j308223812 -> j3689127398;
	j2598445774 [label="Fiendsnight célèbre la disparition de l'influence de Sol sur le monde.",shape=box,color=blue];
		j2598445774 -> j2300650736;
	j2438918484 [label="Il était bâti comme un phasme, maquillé comme une reine du cinéma muet. Des lèvres comme des bonbons. Des rayures, du cuir et un collier de chien. Ses joues sont comme les hanches d'un squelette.",shape=box,color=blue];
		j2438918484 -> j1591577405;
		j2438918484 -> j2094328715;
	j3689127398 [label="Bref, il y en a trois dans un seul corps. Je ne pourrais jamais en choisir une plutôt qu'une autre.",shape=box,color=blue];
		j3689127398 -> j1591577405;
		j3689127398 -> j2094328715;
	j2300650736 [label="Ce qui, à première vue, n'a pas beaucoup de sens. Pourquoi célébrer la montée des ténèbres? Pourquoi se réjouir de l'anarchie et du chaos?",shape=box,color=blue];
		j2300650736 -> j1145264162;
	j1591577405 [label="Se déguiser? Faire la fête? Dans une zone de guerre? Tu crois vraiment que ça va arriver?",shape=box,color=red];
		j1591577405 -> j3194836783;
	j2094328715 [label="Tu sais, Fiendsnight ressemble beaucoup à Naberus. Les gens aiment se déguiser pour ça aussi.",shape=box,color=red];
		j2094328715 -> j3194836783;
	j1145264162 [label="Je pense que c'est comme une vaccination, en quelque sorte. Un tout petit peu de ce que nous craignons, pour nous renforcer. Ou peut-être est-ce juste une excuse pour revêtir le masque du diable et semer le chaos.",shape=box,color=blue];
		j1145264162 -> j1591577405;
		j1145264162 -> j2094328715;
	j3194836783 [label="... Je suis probablement juste ridicule. Puérile. N'est-ce pas?",shape=box,color=blue];
		j3194836783 -> j4049391242;
	j4049391242 [label="Oh, à quoi donc est-ce que je pense.",shape=box,color=blue];
		j4049391242 -> j3018540049;
	j3018540049 [label="Je n'ai pas besoin de me déguiser, n'est-ce pas? Je suis déjà un monstre. Pour toujours et à jamais.",shape=box,color=blue];
		j3018540049 -> j2436064064;
	j2436064064 [label="Check boolean EleanorDating",color=orange];
		j2436064064 -> j59934119 [label=true,color=green];
		j2436064064 -> j982301592 [label=true,color=green];
		j2436064064 -> j3272646766 [label=true,color=green];
		j2436064064 -> j982301592 [label=false,color=brown];
		j2436064064 -> j3272646766 [label=false,color=brown];
	j59934119 [label="Tu es le monstre que j'aime, Eleanor. Je ne regrette rien.",shape=box,color=red];
		j59934119 -> j3851052090;
	j982301592 [label="Je commence à penser que tu aimes dire ça de toi.",shape=box,color=red];
		j982301592 -> j2606070121;
	j3272646766 [label="Non. Les vrais monstres ne se soucient pas des gens. Tu es tout le contraire.",shape=box,color=red];
		j3272646766 -> j3362371977;
	j3851052090 [label="+5 Chemistry",color=orange];
		j3851052090 -> j1360738078;
	j2606070121 [label="Si c'est ce que tu crois vraiment être, alors Fiendsnight est l'occasion idéale de le célébrer.",shape=box,color=red];
		j2606070121 -> j2775418745;
		j2606070121 -> j3362371977;
	j3362371977 [label="Je sais que tu as peur de ce que tu pourrais devenir. Mais en ce MOMENT, tu n'es pas ça.",shape=box,color=red];
		j3362371977 -> j424691660;
	j1360738078 [label="Oh oui! Suis-je bête! J'avais oublié que le monstre connaissait une fin heureuse dans notre petite histoire.",shape=box,color=blue];
		j1360738078 -> j1535712293;
	j2775418745 [label="SOIS le monstre. Assume-le. Pour cette nuit unique de l'année, porte fièrement ce titre.",shape=box,color=red];
		j2775418745 -> j3488831326;
	j424691660 [label="Alors, déguise-toi. Amuse-toi. Le Néant sait que l'Hexagone en a bien besoin.",shape=box,color=red];
		j424691660 -> j2340869297;
	j1535712293 [label="Pardonne-moi. J'ai encore du mal à croire que c'est ce que tu VEUX vraiment. J'ai peut-être juste besoin d'un peu plus de conviction.",shape=box,color=blue];
		j1535712293 -> j3008867324;
	j3488831326 [label="Oh, il y a tellement de raisons pour lesquelles c'est une très MAUVAISE IDÉE",shape=box,color=blue];
		j3488831326 -> j1934167440;
	j2340869297 [label="Je note. Et merci. Encore. x",shape=box,color=blue];
		j2340869297 -> "Chat ends.";
	j3008867324 [label="On se dévorera les uns les autres plus tard. xxx",shape=box,color=blue];
		j3008867324 -> "Chat ends.";
	j1934167440 [label="TELLEMENT.",shape=box,color=blue];
		j1934167440 -> j4020199403;
	"Chat ends." [color=orange];
	j4020199403 [label="(Je n'en vois aucune en ce moment, mais je suis sûre qu'il y en a des dizaines)",shape=box,color=blue];
		j4020199403 -> j4099290715;
	j4099290715 [label="... merde.",shape=box,color=blue];
		j4099290715 -> j1015716071;
	j1015716071 [label="Tu as réussi à retourner mes arguments contre moi. Bon sang. Bien joué. x",shape=box,color=blue];
		j1015716071 -> "Chat ends.";
}