		3215 -> 3216;
	3216 [label="Suis-je un champ de mines?",shape=box,color=blue];
		3216 -> 3217;
	3217 [label="Parce que Kaya dit que je le suis. Et j'ai eu un de ces moments de \"oh merde\" où l'on repense à toutes les conversations qu'on a eues avec quelqu'un et où l'on se voit soudain sous un nouveau jour.",shape=box,color=blue];
		3217 -> 3218;
		3217 -> 3219;
		3217 -> 3220;
	3218 [label="Non, tu n’es pas un champ de mines.",shape=box,color=red];
		3218 -> 3221;
	3219 [label="Je crois comprendre ce qu'elle voulait dire, oui. Pardon, mais elle a raison.",shape=box,color=red];
		3219 -> 3222;
	3220 [label="Attends, Kaya a dit ça?",shape=box,color=red];
		3220 -> 3223;
	3221 [label="+5 Chemistry",color=orange];
		3221 -> 3224;
	3222 [label="oh.",shape=box,color=blue];
		3222 -> 3225;
		3222 -> 3226;
	3223 [label="Oui. Elle l'a juste lâché au milieu d'une conversation. \"Tu es cool, mais tu es un champ de mines. Je ne sais jamais comment tu vas réagir.\"",shape=box,color=blue];
		3223 -> 3218;
		3223 -> 3219;
	3224 [label="Ravie de l'entendre. Merci.",shape=box,color=blue];
		3224 -> 3227;
	3225 [label="C'est une bonne chose que Kaya t'ait interpellée. J'ai dit des choses que je croyais inoffensives ici, et tu as réagi comme si je t'avais mis le feu aux cheveux.",shape=box,color=red];
		3225 -> 3228;
		3225 -> 3229;
	3226 [label="Tu as parfois des réactions vraiment extrêmes, disproportionnées par rapport à ce que je t'ai dit.",shape=box,color=red];
		3226 -> 3229;
		3226 -> 3228;
	3227 [label="Les ados, hein? ",shape=box,color=blue];
		3227 -> 3230;
	3228 [label="C'est comme si tu sautais directement à la pire interprétation possible de ce que j'aurais pu vouloir dire.",shape=box,color=red];
		3228 -> 3231;
	3229 [label="Parfois, tu quittes complètement la conversation et je n'ai même pas la chance de m'expliquer.",shape=box,color=red];
		3229 -> 3231;
	3230 [label="Chat ends.",color=orange];
	3231 [label="Eh bien.",shape=box,color=blue];
		3231 -> 3232;
	3232 [label="Là, j'ai juste envie de me déconnecter et de ne plus jamais utiliser KIM.",shape=box,color=blue];
		3232 -> 3233;
		3232 -> 3234;
	3233 [label="Peut-être que tu devrais réfléchir à ce que tu viens de dire?",shape=box,color=red];
		3233 -> 3235;
	3234 [label="Et voilà. Boum. Champ de mines.",shape=box,color=red];
		3234 -> 3236;
		3234 -> 3235;
	3235 [label="Tu ne t'en rends pas compte?",shape=box,color=red];
		3235 -> 3237;
	3236 [label="Je pense que tu as besoin de temps pour y réfléchir. [FIN.]",shape=box,color=red];
		3236 -> 3238;
	3237 [label="Ok. Ok. Écoute-moi.",shape=box,color=blue];
		3237 -> 3239;
	3238 [label="Chat ends.",color=orange];
	3239 [label="S'il te plaît.",shape=box,color=blue];
		3239 -> 3240;
	3240 [label="Garde ceci à l’esprit:",shape=box,color=blue];
		3240 -> 3241;
	3241 [label="Je suis télépathe. Je n'ai pas demandé à l'être. Mais je le suis. Je capte les pensées.",shape=box,color=blue];
		3241 -> 3242;
	3242 [label="Si nous parlons face à face, j'ai toutes sortes d'indices qui me disent ce que tu ressens.",shape=box,color=blue];
		3242 -> 3243;
	3243 [label="L'expression, le langage corporel, et parfois une véritable PENSÉE parce que, comme je l'ai dit, je suis TÉLÉPATHE",shape=box,color=blue];
		3243 -> 3244;
	3244 [label="mais ici, sur KIM, je dois deviner et il n'y a aucun indice",shape=box,color=blue];
		3244 -> 3245;
	3245 [label="et donc oui, je réagis parfois de manière irréfléchie.",shape=box,color=blue];
		3245 -> 3246;
		3245 -> 3247;
	3246 [label="Sérieux.",shape=box,color=red];
		3246 -> 3248;
	3247 [label="Oui. En effet.",shape=box,color=red];
		3247 -> 3248;
	3248 [label="Alors. Donc...",shape=box,color=blue];
		3248 -> 3249;
	3249 [label="(inspire profondément, tiens-toi droite, reprends-toi, Eleanor)",shape=box,color=blue];
		3249 -> 3250;
	3250 [label="Je ferai de mon mieux pour ne plus être un champ de mines à l’avenir.",shape=box,color=blue];
		3250 -> 3251;
	3251 [label="Et je vais jeter un œil à nos anciennes discussions et y réfléchir longuement.",shape=box,color=blue];
		3251 -> 3252;
	3252 [label="Je te dois bien ça. Champ de mines ou pas, tu es toujours là. Tu restes à mes côtés. x",shape=box,color=blue];
		3252 -> 3253;
	3253 [label="Update boolean EleanorNoDate",color=orange];
		3253 -> 3254;
	3254 [label="Chat ends.",color=orange];
