		j1152270578 -> j1196118376;
	"Chat ends." [color=orange];
	j66718956 [label="Merci, camarade.",shape=box,color=blue];
		j66718956 -> j3750738635;
	j1196118376 [label="Merci, mon amour.",shape=box,color=blue];
		j1196118376 -> j3750738635;
	j3750738635 [label="Suis-je un champ de mines?",shape=box,color=blue];
		j3750738635 -> j2530099466;
	j2530099466 [label="Parce que Kaya dit que je le suis. Et j'ai eu un de ces moments de \"oh merde\" où l'on repense à toutes les conversations qu'on a eues avec quelqu'un et où l'on se voit soudain sous un nouveau jour.",shape=box,color=blue];
		j2530099466 -> j3437090834;
		j2530099466 -> j1835779208;
		j2530099466 -> j3050960497;
	j3437090834 [label="Non, tu n’es pas un champ de mines.",shape=box,color=red];
		j3437090834 -> j1498849961;
	j1835779208 [label="Je crois comprendre ce qu'elle voulait dire, oui. Pardon, mais elle a raison.",shape=box,color=red];
		j1835779208 -> j2700699045;
	j3050960497 [label="Attends, Kaya a dit ça?",shape=box,color=red];
		j3050960497 -> j3810783146;
	j1498849961 [label="+5 Chemistry",color=orange];
		j1498849961 -> j211064959;
	j2700699045 [label="oh.",shape=box,color=blue];
		j2700699045 -> j2598347537;
		j2700699045 -> j2962518314;
	j3810783146 [label="Oui. Elle l'a juste lâché au milieu d'une conversation. \"Tu es cool, mais tu es un champ de mines. Je ne sais jamais comment tu vas réagir.\"",shape=box,color=blue];
		j3810783146 -> j3437090834;
		j3810783146 -> j1835779208;
	j211064959 [label="Ravie de l'entendre. Merci.",shape=box,color=blue];
		j211064959 -> j2630063525;
	j2598347537 [label="C'est une bonne chose que Kaya t'ait interpellée. J'ai dit des choses que je croyais inoffensives ici, et tu as réagi comme si je t'avais mis le feu aux cheveux.",shape=box,color=red];
		j2598347537 -> j3847012765;
		j2598347537 -> j1309789672;
	j2962518314 [label="Tu as parfois des réactions vraiment extrêmes, disproportionnées par rapport à ce que je t'ai dit.",shape=box,color=red];
		j2962518314 -> j1309789672;
		j2962518314 -> j3847012765;
	j2630063525 [label="Les ados, hein? ",shape=box,color=blue];
		j2630063525 -> "Chat ends.";
	j3847012765 [label="C'est comme si tu sautais directement à la pire interprétation possible de ce que j'aurais pu vouloir dire.",shape=box,color=red];
		j3847012765 -> j2409657987;
	j1309789672 [label="Parfois, tu quittes complètement la conversation et je n'ai même pas la chance de m'expliquer.",shape=box,color=red];
		j1309789672 -> j2409657987;
	j2409657987 [label="Eh bien.",shape=box,color=blue];
		j2409657987 -> j3622103555;
	j3622103555 [label="Là, j'ai juste envie de me déconnecter et de ne plus jamais utiliser KIM.",shape=box,color=blue];
		j3622103555 -> j827774602;
		j3622103555 -> j1243357522;
	j827774602 [label="Peut-être que tu devrais réfléchir à ce que tu viens de dire?",shape=box,color=red];
		j827774602 -> j4156035324;
	j1243357522 [label="Et voilà. Boum. Champ de mines.",shape=box,color=red];
		j1243357522 -> j1348321370;
		j1243357522 -> j4156035324;
	j4156035324 [label="Tu ne t'en rends pas compte?",shape=box,color=red];
		j4156035324 -> j4116175940;
	j1348321370 [label="Je pense que tu as besoin de temps pour y réfléchir. [FIN.]",shape=box,color=red];
		j1348321370 -> "Chat ends.";
	j4116175940 [label="Ok. Ok. Écoute-moi.",shape=box,color=blue];
		j4116175940 -> j738700564;
	j738700564 [label="S'il te plaît.",shape=box,color=blue];
		j738700564 -> j2029161066;
	j2029161066 [label="Garde ceci à l’esprit:",shape=box,color=blue];
		j2029161066 -> j1922064166;
	j1922064166 [label="Je suis télépathe. Je n'ai pas demandé à l'être. Mais je le suis. Je capte les pensées.",shape=box,color=blue];
		j1922064166 -> j2020294543;
	j2020294543 [label="Si nous parlons face à face, j'ai toutes sortes d'indices qui me disent ce que tu ressens.",shape=box,color=blue];
		j2020294543 -> j1041631284;
	j1041631284 [label="L'expression, le langage corporel, et parfois une véritable PENSÉE parce que, comme je l'ai dit, je suis TÉLÉPATHE",shape=box,color=blue];
		j1041631284 -> j4159200529;
	j4159200529 [label="mais ici, sur KIM, je dois deviner et il n'y a aucun indice",shape=box,color=blue];
		j4159200529 -> j116057469;
	j116057469 [label="et donc oui, je réagis parfois de manière irréfléchie.",shape=box,color=blue];
		j116057469 -> j3343299823;
		j116057469 -> j988627556;
	j3343299823 [label="Sérieux.",shape=box,color=red];
		j3343299823 -> j3484596945;
	j988627556 [label="Oui. En effet.",shape=box,color=red];
		j988627556 -> j3484596945;
	j3484596945 [label="Alors. Donc...",shape=box,color=blue];
		j3484596945 -> j1724334867;
	j1724334867 [label="(inspire profondément, tiens-toi droite, reprends-toi, Eleanor)",shape=box,color=blue];
		j1724334867 -> j219933982;
	j219933982 [label="Je ferai de mon mieux pour ne plus être un champ de mines à l’avenir.",shape=box,color=blue];
		j219933982 -> j1515073068;
	j1515073068 [label="Et je vais jeter un œil à nos anciennes discussions et y réfléchir longuement.",shape=box,color=blue];
		j1515073068 -> j941916262;
	j941916262 [label="Je te dois bien ça. Champ de mines ou pas, tu es toujours là. Tu restes à mes côtés. x",shape=box,color=blue];
		j941916262 -> j4122200191;
	j4122200191 [label="Boolean EleanorNoDate is now false.",color=orange];
		j4122200191 -> "Chat ends.";
}