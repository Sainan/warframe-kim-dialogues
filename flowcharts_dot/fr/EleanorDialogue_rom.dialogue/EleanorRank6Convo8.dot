digraph {
	"EleanorRank6Convo8 begins." [color=orange];
		"EleanorRank6Convo8 begins." -> j4154951659;
	j4154951659 [label="Tu as un moment? Je suis un peu contrariée et j'aurais besoin d'une oreille attentive. Ou peut-être d'une petite réprimande. Je ne sais pas encore.",shape=box,color=blue];
