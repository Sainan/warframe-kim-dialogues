digraph {
	3207 [label="EleanorRank6Convo8 begins.",color=orange];
		3207 -> 3208;
	3208 [label="Tu as un moment? Je suis un peu contrariée et j'aurais besoin d'une oreille attentive. Ou peut-être d'une petite réprimande. Je ne sais pas encore.",shape=box,color=blue];
