		3211 -> 3214;
	3212 [label="Pour toi, toujours.",shape=box,color=red];
		3212 -> 3215;
	3213 [label="Chat ends.",color=orange];
	3214 [label="Merci, camarade.",shape=box,color=blue];
		3214 -> 3216;
