digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"EleanorRank6Convo3 begins." [color=orange];
		"EleanorRank6Convo3 begins." -> j388067902;
	j388067902 [label="Je ne sais pas si tu l'as remarqué, mais quelque chose de vraiment fantastique s'est produit.",shape=box,color=blue];
		j388067902 -> j352022008;
	j352022008 [label="Arthur chante à nouveau. Dieu merci.",shape=box,color=blue];
		j352022008 -> j2026830409;
		j352022008 -> j583689697;
		j352022008 -> j1918979208;
	j2026830409 [label="Pourquoi avait-il arrêté?",shape=box,color=red];
		j2026830409 -> j3913147291;
	j583689697 [label="Je ne suis pas vraiment fan, mais si ça le rend heureux...",shape=box,color=red];
		j583689697 -> j1392179322;
	j1918979208 [label="C'est une bonne chose. Il est doué.",shape=box,color=red];
		j1918979208 -> j4152810143;
	j3913147291 [label="Le trac des artistes. C'est aussi simple que ça.",shape=box,color=blue];
		j3913147291 -> j2830857682;
	j1392179322 [label="Merci d'avoir exprimé cela avec autant de délicatesse.",shape=box,color=blue];
		j1392179322 -> j2873314890;
	j4152810143 [label="N'est-ce pas?",shape=box,color=blue];
		j4152810143 -> j3061844139;
	j2830857682 [label="Difficile de croire que quelqu'un d'aussi courageux qu'Arthur puisse être effrayé à ce point.",shape=box,color=red];
		j2830857682 -> j2728360299;
	j2873314890 [label="Cela me fait quelque chose que tu t’en soucies.",shape=box,color=blue];
		j2873314890 -> j510054955;
	j3061844139 [label="Quand je pense à l'effort qu'il a dû faire pour se lever devant une foule de gens et chanter...",shape=box,color=blue];
		j3061844139 -> j3673963360;
	j2728360299 [label="Quelle est la faille dans son armure?",shape=box,color=red];
		j2728360299 -> j2201641942;
	j510054955 [label="D'autant plus qu'il y a des raisons pour lesquelles il a arrêté de chanter, des raisons que tu ne pouvais pas connaître.",shape=box,color=blue];
		j510054955 -> j493100978;
		j510054955 -> j3525172079;
	j3673963360 [label="... la première fois il a vraiment perdu son sang-froid.",shape=box,color=blue];
		j3673963360 -> j2297577704;
	j2201641942 [label="C'est son nom. C'est ça le problème.",shape=box,color=blue];
		j2201641942 -> j907636002;
	j493100978 [label="Pas assez de soutien moral?",shape=box,color=red];
		j493100978 -> j902950030;
	j3525172079 [label="Trop de foules difficiles?",shape=box,color=red];
		j3525172079 -> j902950030;
	j2297577704 [label="Le concert de chants du solstice dans les années 80. Imaginez notre petit bonhomme en short interpréter \"Étoile des Neiges\" en solo.",shape=box,color=blue];
		j2297577704 -> j4000578052;
		j2297577704 -> j2434131898;
	j907636002 [label="\"Oh, ton nom veut dire rossignol, ha ha ha, chante-nous une chanson, alors\"",shape=box,color=blue];
		j907636002 -> j4167218287;
	j902950030 [label="Entendre la même blague encore et encore, plutôt.",shape=box,color=blue];
		j902950030 -> j2201641942;
	j4000578052 [label="Je peux imaginer.",shape=box,color=red];
		j4000578052 -> j2991276851;
	j2434131898 [label="Je ne connais pas.",shape=box,color=red];
		j2434131898 -> j1674496785;
	j4167218287 [label="Différents branleurs, même blague débile, tout au long de notre vie. Maintenant, on a Viktor. ",shape=box,color=blue];
		j4167218287 -> j2486098675;
	j2991276851 [label="Il a pris ça très au sérieux. Des semaines et des semaines de répétitions, et puis, le grand soir, il a tout laissé tomber. Il s'est caché dans les coulisses et a refusé de sortir.",shape=box,color=blue];
		j2991276851 -> j498949195;
		j2991276851 -> j2830857682;
	j1674496785 [label="Eh bien, je te la chanterais bien, mais je ne suis pas sûre du genre de bruit que je ferais si j'essayais.",shape=box,color=blue];
		j1674496785 -> j896370569;
	j2486098675 [label="+5 Chemistry",color=orange];
		j2486098675 -> j4253116623;
	j498949195 [label="Comment l'as-tu convaincu?",shape=box,color=red];
		j498949195 -> j1400983929;
	j896370569 [label="Saloperie de Techrot. J'ai essayé de chanter \"Joyeux anniversaire\" à Aoi, et ça ressemblait à une grenouille-taureau coincée dans une déchiqueteuse.",shape=box,color=blue];
		j896370569 -> j3172450617;
	j4253116623 [label="Honnêtement, je suis fière qu'Arthur ait eu le courage de chanter.",shape=box,color=blue];
		j4253116623 -> "Chat ends.";
	j1400983929 [label="Je lui ai littéralement botté le cul. Je n'en suis pas fière. Mais il fallait le faire.",shape=box,color=blue];
		j1400983929 -> j67838486;
	j3172450617 [label="C'est moche. Ça doit être dur de ne plus pouvoir chanter.",shape=box,color=red];
		j3172450617 -> j4227321773;
	"Chat ends." [color=orange];
	j67838486 [label="L'important, c'est qu'il n'a pas fait tout ça pour nos parents ni pour faire plaisir à Mme Henshaw. ",shape=box,color=blue];
		j67838486 -> j1885737424;
	j4227321773 [label="Oh, ce n'est pas une grande perte. De toute façon, je ne savais pas chanter.",shape=box,color=blue];
		j4227321773 -> j2268508559;
	j1885737424 [label="Il chantait parce qu'il aimait ça. Mais quand les projecteurs étaient braqués sur lui, il se fermait.",shape=box,color=blue];
		j1885737424 -> j2088556852;
		j1885737424 -> j2728360299;
	j2268508559 [label="Le mieux que j'ai fait, ça a été de crier les paroles des Shag Cannons dans ma chambre parce que je voulais faire partie du groupe de Mandy Jellicoe parce qu'elle me plaisait. ",shape=box,color=blue];
		j2268508559 -> j3065331825;
	j2088556852 [label="Peut-être qu’il avait juste besoin de se rappeler à quel point il aimait chanter.",shape=box,color=red];
		j2088556852 -> j3236376761;
	j3065331825 [label="Mon père a frappé à la porte et a menacé de me laver la bouche avec du phénol s'il entendait encore ces horreurs.",shape=box,color=blue];
		j3065331825 -> j835007705;
	j3236376761 [label="Arthur est au plus haut de son bonheur lorsqu'il peut oublier Arthur. Lorsqu'il peut laisser son fantôme se reposer et simplement ÊTRE lui-même.",shape=box,color=blue];
		j3236376761 -> j1373894761;
	j835007705 [label="(Je ne sais pas si vous avez du \"punk\" là d’où tu viens, mais ne pas savoir chanter est plus une exigence qu’un obstacle.)",shape=box,color=blue];
		j835007705 -> j3573002407;
		j835007705 -> j2181203945;
	j1373894761 [label="La bière aide.",shape=box,color=blue];
		j1373894761 -> j1948120828;
	j3573002407 [label="Nous n'avons pas de punk, mais nous avons du Skeg.",shape=box,color=red];
		j3573002407 -> j3597402937;
	j2181203945 [label="Qu'est-il arrivé au groupe?",shape=box,color=red];
		j2181203945 -> j497108038;
	j1948120828 [label="Et cela ne fait sûrement pas de mal que Velimir agisse comme le père qu'Arthur aurait choisi, s'il avait pu en choisir un dans un catalogue.",shape=box,color=blue];
		j1948120828 -> j2643979322;
		j1948120828 -> j1097986061;
	j3597402937 [label="N'essaie même pas de balancer quelque chose comme ça dans le tchat sans donner plus de détails.",shape=box,color=blue];
		j3597402937 -> j3382532245;
	j497108038 [label="Ils n'ont même pas atteint l'étape du \"concert charitable au pub local\".",shape=box,color=blue];
		j497108038 -> j892428591;
	j2643979322 [label="Je ne le blâme pas.",shape=box,color=red];
		j2643979322 -> j1023587861;
	j1097986061 [label="Je me disais que Velimir et Minerva ressemblaient peut-être un peu trop à tes vrais parents.",shape=box,color=red];
		j1097986061 -> j2174260359;
	j3382532245 [label="J'exige que tu me dises ce qu'est le Skeg.",shape=box,color=blue];
		j3382532245 -> j659865845;
	j892428591 [label="La rumeur s'est répandue que Mandy prévoyait de cracher sur le public, et voilà, terminé. Dommage.",shape=box,color=blue];
		j892428591 -> j4022594649;
		j892428591 -> j3532916173;
	j1023587861 [label="Arthur trimballe cet ours en peluche depuis des mois. Et voilà que Velimir débarque. C'est comme si le destin avait senti un trou en forme d'ours dans la vie d'Arthur...",shape=box,color=blue];
		j1023587861 -> j4064503562;
	j2174260359 [label="Ouais, eh bien. Peut-être que les disputes lui rappellent la maison. ",shape=box,color=blue];
		j2174260359 -> j3262567972;
	j659865845 [label="Parce que cela ressemble à quelque chose vendu dans de petits sacs en plastique dans un domaine de Ludston.",shape=box,color=blue];
		j659865845 -> j1570036486;
		j659865845 -> j869866825;
	j4022594649 [label="Qui a peur d'un peu de crachat?",shape=box,color=red];
		j4022594649 -> j3736636902;
	j3532916173 [label="Cracher? Ça ressemble à une idée de fête de Technocyte Coda.",shape=box,color=red];
		j3532916173 -> j3890612640;
	j4064503562 [label="+5 Chemistry",color=orange];
		j4064503562 -> j3372031436;
	j3262567972 [label="+5 Chemistry",color=orange];
		j3262567972 -> j220081433;
	j1570036486 [label="C'est de la musique, sauf qu'on la crée en frappant sur des tuyaux. Et des bouches d'aération. Et des casques Corpus. Et tout ce qu'on peut trouver pour frapper dessus, en fait. ",shape=box,color=red];
		j1570036486 -> j2958253779;
	j869866825 [label="C'est juste du bruit inutile. Seuls les Orphelins des Conduits aiment ça.",shape=box,color=red];
		j869866825 -> j3087987433;
	j3736636902 [label="+5 Chemistry",color=orange];
		j3736636902 -> j3827801475;
	j3890612640 [label="C'était une autre époque. À l'époque où le punk était vraiment punk. ",shape=box,color=blue];
		j3890612640 -> j247372025;
	j3372031436 [label="… désolée. Je n'ai pas à spéculer. Je suis juste contente qu'il soit heureux.",shape=box,color=blue];
		j3372031436 -> "Chat ends.";
	j220081433 [label="C'est bizarre, ce qui peut donner le mal du pays, n'est-ce pas?",shape=box,color=blue];
		j220081433 -> "Chat ends.";
	j2958253779 [label="C'est un truc d'Orphelins des Conduits.",shape=box,color=red];
		j2958253779 -> j583458088;
	j3087987433 [label="Hum. \"Du bruit inutile\". J'ai déjà entendu ça.",shape=box,color=blue];
		j3087987433 -> j3063798848;
	j3827801475 [label="Certainement pas moi, je peux te le dire.",shape=box,color=blue];
		j3827801475 -> j247372025;
	j247372025 [label="... Je me suis dit: \"J'aimerais qu'elle me voie maintenant.\" Je pense qu'elle aimerait cette version de moi.",shape=box,color=blue];
		j247372025 -> j946287152;
	j583458088 [label="+5 Chemistry",color=orange];
		j583458088 -> j3190839616;
	j3063798848 [label="Je ne pense pas qu’il y ait quelque chose qui ne puisse être la musique de l’enfance de quelqu’un.",shape=box,color=blue];
		j3063798848 -> j182491257;
	j946287152 [label="Dieux, regarde-moi, je suis devenue mièvre et nostalgique.",shape=box,color=blue];
		j946287152 -> j3716862219;
	j3190839616 [label="Hmm. On dirait de la musique de survivant. J'aimerais bien écouter si tu as l'occasion de me la faire découvrir.",shape=box,color=blue];
		j3190839616 -> j3584440930;
	j182491257 [label="Je ferais mieux d'arrêter. Je deviens sentimentale.",shape=box,color=blue];
		j182491257 -> "Chat ends.";
	j3716862219 [label="+5 Chemistry",color=orange];
		j3716862219 -> j3587102642;
	j3584440930 [label="Pas sur les haut-parleurs du centre commercial, cela dit.",shape=box,color=blue];
		j3584440930 -> "Chat ends.";
	j3587102642 [label="Je ferais mieux de m'y remettre. Merci pour ton attention.",shape=box,color=blue];
		j3587102642 -> "Chat ends.";
}