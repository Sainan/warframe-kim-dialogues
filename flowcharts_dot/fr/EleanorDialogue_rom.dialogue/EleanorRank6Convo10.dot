	j2884271664 [label="Alors, je me suis dit: l'année va se réinitialiser à la fin du mois de décembre comme toujours et même si cela ressemblera à une toute nouvelle année, ce ne sera pas VRAIMENT le cas",shape=box,color=blue];
		j2884271664 -> j2930713725;
	j2930713725 [label="et même si je PENSE savoir combien de fois cela s'est produit auparavant, en fait, je ne le sais pas, parce que JE NE M'EN SOUVIENS PEUT-ÊTRE PAS",shape=box,color=blue];
		j2930713725 -> j2832061137;
	j2832061137 [label="Et si ce dont je me souviens comme étant la Boucle Un était en fait la Boucle Quinze Mille Quarante-Deux?",shape=box,color=blue];
		j2832061137 -> j2226119670;
	j2226119670 [label="et puis, je me suis dit, bon, tant pis, autant devenir complètement folle et faire tout ce que je veux parce que tu peux toujours frapper le sol à nouveau et tout réinitialiser",shape=box,color=blue];
		j2226119670 -> j495569782;
	j495569782 [label="Mais ensuite, je me suis dit: \"Non, attends, et si c'était celle-là la dernière?\" Où l'on passerait enfin de 1999 à 2000?",shape=box,color=blue];
		j495569782 -> j591890695;
	j591890695 [label="Je ne veux pas me ridiculiser complètement dans la boucle qui s'avère être la boucle décisive de 1999. Je ne serais jamais capable de la revivre.",shape=box,color=blue];
		j591890695 -> j1572972031;
	j1572972031 [label="Un jour, ce sera le solstice et non plus seulement l'hiver sans fin, pour reprendre la vieille analogie fatiguée.",shape=box,color=blue];
