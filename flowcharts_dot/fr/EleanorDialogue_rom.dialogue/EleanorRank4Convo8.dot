digraph {
	2040 [label="EleanorRank4Convo8 begins.",color=orange];
		2040 -> 1976;
	1976 [label="Check boolean AmirRPGEleanor",color=orange];
		1976 -> 1977 [label=true,color=green];
		1976 -> 2041 [label=false,color=brown];
	1977 [label="Chat ends.",color=orange];
	2041 [label="Check boolean AmirRPG",color=orange];
		2041 -> 2043 [label=true,color=green];
		2041 -> 2042 [label=false,color=brown];
	2043 [label="Check boolean AmirRPGEleanorAsked",color=orange];
		2043 -> 2045 [label=true,color=green];
		2043 -> 2046 [label=false,color=brown];
		2043 -> 2047 [label=false,color=brown];
	2042 [label="Chat ends.",color=orange];
	2045 [label="Hé, Eleanor? Tu te souviens du jeu de société qu'Amir est en train d'organiser? Fables & Frontières?",shape=box,color=red];
		2045 -> 2044;
	2046 [label="Hé, Eleanor? Amir et toi, vous êtes amis, n'est-ce pas?",shape=box,color=red];
		2046 -> 2048;
	2047 [label="Tu aimes les jeux de société, n'est-ce pas?",shape=box,color=red];
		2047 -> 2049;
	2044 [label="Oui. Celui dont tu as dit que ce serait une perte de temps, et que tu jouerais seulement par pitié pour lui, c'est bien celui-là, n'est-ce pas?",shape=box,color=blue];
		2044 -> 2050;
		2044 -> 2052;
		2044 -> 2053;
	2048 [label="C'est un charmant petit lutin. Pourquoi demandes-tu ça?",shape=box,color=blue];
		2048 -> 2055;
		2048 -> 2056;
	2049 [label="Autant que n'importe qui, je suppose. Pourquoi cette question?",shape=box,color=blue];
		2049 -> 2055;
		2049 -> 2056;
	2050 [label="Ouf. Ok. Tu es toujours en colère. C'est noté.",shape=box,color=red];
		2050 -> 2051;
	2052 [label="À ce moment-là, je pensais que tu étais \"trop cool pour ça\", et j'essayais juste de faire semblant de l'être aussi. Maintenant, je comprends mieux.",shape=box,color=red];
		2052 -> 2054;
	2053 [label="Ouais, je... je voulais juste m'excuser pour ça, je... je ne pensais pas ce que j'ai dit à ce sujet. J'avais juste peur que tu dises non.",shape=box,color=red];
		2053 -> 2062;
	2055 [label="Amir essaie de réunir l'équipe pour jouer à une partie de Fables & Frontières, et j'ai dit que je l'aiderais.",shape=box,color=red];
		2055 -> 2057;
	2056 [label="Amir veut vraiment jouer à Fables & Frontières avec tout le monde. Tu es partante?",shape=box,color=red];
		2056 -> 2057;
	2051 [label="Chat ends.",color=orange];
	2054 [label="Qui d'entre nous n'est plus \"trop cool\" pour ce jeu, exactement? Toi ou moi?",shape=box,color=blue];
		2054 -> 2058;
		2054 -> 2059;
		2054 -> 2060;
	2062 [label="Nous avons tous connu cela à un moment de notre vie... essayer de porter un masque pour impressionner quelqu'un et nous planter parce que nous ne voyions pas où nous allions. Et toi et moi, on venait de se rencontrer quand tu me l'as demandé. Très bien. Pardon accordé.",shape=box,color=blue];
		2062 -> 2067;
	2057 [label="Ah, je vois. Tu es le héraut envoyé par le Roi Tonnerre pour enrôler la belle Dame Eleanor. Nul doute que toutes sortes de vilenies m'attendent. Des histoires fantastiques et ainsi de suite.",shape=box,color=blue];
		2057 -> 2063;
		2057 -> 2064;
	2058 [label="Toi. Je pense toujours que c'est un jeu ringard, mais peu importe.",shape=box,color=red];
		2058 -> 2061;
	2059 [label="Moi. Certainement moi. Tu es encore trop cool pour le jeu. Mais \"to bete\", du moins c'est ce que dit Quincy.",shape=box,color=red];
		2059 -> 2062;
	2060 [label="... Les deux?",shape=box,color=red];
		2060 -> 2062;
	2067 [label="Honnêtement, prendre une voix idiote et jouer un rôle pendant quelques heures me semble idéal. Je suis partante.",shape=box,color=blue];
		2067 -> 2068;
	2063 [label="Je pense que ce sera amusant, honnêtement. Et c'est très important pour lui.",shape=box,color=red];
		2063 -> 2067;
	2064 [label="Ouais, je pense que ça va être une perte de temps totale, mais j'essaie d'être aimable.",shape=box,color=red];
		2064 -> 2065;
	2061 [label="Chat ends.",color=orange];
	2068 [label="Oh! J'aimerais être une magicienne. Ou peut-être une barde. Ou peut-être les deux? On peut être les deux?",shape=box,color=blue];
		2068 -> 2069;
	2065 [label="Je vais te faire une faveur et ne PAS lui rapporter tes paroles. Un conseil avisé: traite-le avec plus de respect à l'avenir en ma présence.",shape=box,color=blue];
		2065 -> 2066;
	2069 [label="Ou alors, je pourrais être une sorcière des marais! Du moment que je peux porter un corsage moulant, attention. Mère Spumositéton mangera tes os, petit nain.",shape=box,color=blue];
		2069 -> 2077;
	2066 [label="Chat ends.",color=orange];
	2077 [label="+20 Chemistry",color=orange];
		2077 -> 2070;
	2070 [label="Update boolean AmirRPGEleanor",color=orange];
		2070 -> 2071;
	2071 [label="Check boolean AmirRPGQuincy",color=orange];
		2071 -> 2072 [label=true,color=green];
		2071 -> 2076 [label=false,color=brown];
	2072 [label="Check boolean AmirRPGArthur",color=orange];
		2072 -> 2073 [label=true,color=green];
		2072 -> 2076 [label=false,color=brown];
	2076 [label="Update boolean AmirRPGAny",color=orange];
		2076 -> 2080;
	2073 [label="Check boolean AmirRPGAoi",color=orange];
		2073 -> 2074 [label=true,color=green];
		2073 -> 2076 [label=false,color=brown];
	2080 [label="Chat ends.",color=orange];
	2074 [label="Check boolean AmirRPGLettie",color=orange];
