digraph {
	3068 [label="EleanorRank6Convo5 begins.",color=orange];
		3068 -> 3069;
	3069 [label="Je me demandais, comme je le fais si souvent...",shape=box,color=blue];
		3069 -> 3070;
	3070 [label="Une fois cette boucle enfin bouclée, quelle que soit la manière dont cela se passe, quelle sera la prochaine étape pour la Terre?",shape=box,color=blue];
		3070 -> 3071;
	3071 [label="Je sais que l'an 2000 est assez loin dans ton passé, mais peux-tu me dire QUELQUE CHOSE sur ce qui attend notre petite planète?",shape=box,color=blue];
		3071 -> 3072;
		3071 -> 3074;
	3072 [label="Rien de bon, j'en ai peur.",shape=box,color=red];
		3072 -> 3073;
	3074 [label="Je ne pense pas que je devrais, honnêtement.",shape=box,color=red];
		3074 -> 3076;
	3073 [label="D'après ce que j'en sais, Techrot devient un problème mondial. On le résout avec des armes nucléaires – ou du moins, on essaie.",shape=box,color=red];
		3073 -> 3075;
	3076 [label="Si vous êtes prévenus de ce qui va arriver, vous pourriez essayer de le changer, et cela pourrait signifier que je n'existerai jamais.",shape=box,color=red];
		3076 -> 3078;
	3075 [label="C'est ainsi que commence la première des \"guerres des radiations\".",shape=box,color=red];
		3075 -> 3077;
	3078 [label="Dis-moi que je suis égoïste, mais j’aime exister.",shape=box,color=red];
		3078 -> 3080;
	3077 [label="... et finalement, la planète devient tellement dévastée que les Orokins veulent s'enfuir et aller vivre ailleurs, n'est-ce pas?",shape=box,color=blue];
		3077 -> 3079;
	3080 [label="Oh, comme si tout ce que tu as fait n'avait PAS changé le futur?",shape=box,color=blue];
		3080 -> 3082;
	3079 [label="... ce qui nous amène à toute l'affaire du Zariman, et c'est là que TU interviens.",shape=box,color=blue];
		3079 -> 3081;
	3082 [label="Tu as peut-être modifié de petits détails, mais le plus important est resté à peu près pareil.",shape=box,color=blue];
		3082 -> 3085;
	3081 [label="C'est étrange de penser que tout commence ici, dans cette ville.",shape=box,color=blue];
		3081 -> 3083;
		3081 -> 3084;
	3085 [label="Je pense que l'Univers sait ce qu'il fait.",shape=box,color=blue];
		3085 -> 3088;
	3083 [label="C’est peut-être en partie pour cela que cette année est si importante.",shape=box,color=red];
		3083 -> 3086;
	3084 [label="Ouais. De la Höllvanie au Zariman Ten-Zero. C'est un fil conducteur.",shape=box,color=red];
		3084 -> 3087;
	3088 [label="Il y a bien plus que de simples particules aveugles qui s'agitent.",shape=box,color=blue];
		3088 -> 3091;
		3088 -> 3092;
	3086 [label="+5 Chemistry",color=orange];
		3086 -> 3089;
	3087 [label="attends...",shape=box,color=blue];
		3087 -> 3090;
	3091 [label="Je ne partage pas ton point de vue. L'Univers est dépourvu d'esprit.",shape=box,color=red];
		3091 -> 3095;
	3092 [label="Je suis d'accord. Si quelque chose d'aussi humain que l'émotion peut façonner le Néant...",shape=box,color=red];
		3092 -> 3096;
	3089 [label="C'est logique. Si la bombe nucléaire d'Albrecht avait explosé, alors il n'y aurait pas eu de Techrot, donc pas de Terre détruite, pas besoin de s'échapper, pas de premier voyage dans le Néant et pas d'Indifférence?",shape=box,color=blue];
		3089 -> 3093;
	3090 [label="Si ton Zariman était le Ten-Zero, qu'est-il arrivé aux neuf autres Zarimans?",shape=box,color=blue];
		3090 -> 3094;
	3095 [label="Peut-être au niveau du très grand ou du très petit, mais pas au niveau où toi et moi existons.",shape=box,color=blue];
		3095 -> 3099;
	3096 [label="+5 Chemistry",color=orange];
		3096 -> 3100;
	3093 [label="... Je vais voir si Lettie a du café à emporter. ",shape=box,color=blue];
		3093 -> 3097;
	3094 [label="Des drones sans pilote, si je me souviens bien. ",shape=box,color=red];
		3094 -> 3098;
	3099 [label="Si nous pouvons créer du sens et que nous faisons partie de l’Univers, alors l’Univers est par définition capable d'en faire autant.",shape=box,color=blue];
		3099 -> 3102;
	3100 [label="Exactement. Le sens que nous donnons à tout n'est pas une simple illusion confortable.",shape=box,color=blue];
		3100 -> 3103;
	3097 [label="Chat ends.",color=orange];
	3098 [label="Ou des capsules de terraformation pilotées par des Céphalons. Ils ont BEAUCOUP expérimenté.",shape=box,color=red];
		3098 -> 3101;
	3102 [label="+5 Chemistry",color=orange];
		3102 -> 3105;
	3103 [label="Mais il y a toujours cette voix qui murmure et insiste sur le fait que rien de tout cela n'a d'importance.",shape=box,color=blue];
		3103 -> 3106;
	3101 [label="Ils appelaient ça \"Le Projet\". ",shape=box,color=red];
		3101 -> 3104;
	3105 [label="Notre existence n'est pas moins vraie ni moins valable que celle des quarks ou des supernovas. Nous sommes importants, qu'on le veuille ou non.",shape=box,color=blue];
		3105 -> 3108;
	3106 [label="Peut-être que le grand affrontement cosmique ne se joue pas entre le Bien et le Mal, mais entre le sens et le vide de sens?",shape=box,color=blue];
		3106 -> 3109;
	3104 [label="+5 Chemistry",color=orange];
		3104 -> 3107;
	3108 [label="Chat ends.",color=orange];
	3109 [label="Chat ends.",color=orange];
	3107 [label="Cela sonne mieux que \"Opération: amenez nos culs irresponsables sur une nouvelle planète où nous pourrons bien merder\".",shape=box,color=blue];
		3107 -> 3110;
	3110 [label="Chat ends.",color=orange];
}