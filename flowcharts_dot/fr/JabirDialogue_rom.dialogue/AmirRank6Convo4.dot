		4168 -> 4174;
	4171 [label="\"Tu essaies d'éclairer avec ta torche à travers les fissures. Un courant d'air fait vaciller la flamme. Tu entends le bruit de l'eau qui goutte.\"",shape=box,color=blue];
		4171 -> 4166;
	4172 [label="\"Mobilisant toutes tes forces, tu arraches les planches pour révéler ce qui reste de quelques barres de fer rouillées. Il y a de la place pour se faufiler. Au-delà s'étend un tunnel bas et étroit.\"",shape=box,color=blue];
