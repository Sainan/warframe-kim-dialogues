	4114 [label="ouais, ouais",shape=box,color=blue];
		4114 -> 4117;
	4115 [label="\"Tu es dans une cellule, au-dessus du corps d'un Grineer que tu viens de tuer. Tu ne peux pas t'empêcher de penser à ses derniers mots: \"Tu ne trouveras jamais le Lotus.\"",shape=box,color=blue];
		4115 -> 4118;
