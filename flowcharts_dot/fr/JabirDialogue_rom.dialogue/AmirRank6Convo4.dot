	4123 [label="Check boolean FlintTaken",color=orange];
		4123 -> 4126 [label=true,color=green];
		4123 -> 4127 [label=false,color=brown];
	4124 [label="\"Tu te faufiles prudemment hors de la cellule. À ta droite se trouve une grande porte, la sortie. Elle est entrouverte. Tu entends d'autres gardiens Grineers de l'autre côté. À ta gauche, le couloir du donjon continue, mais il fait trop sombre pour y voir clair.\"",shape=box,color=blue];
		4124 -> 4128;
	4125 [label="bon",shape=box,color=blue];
		4125 -> 4129;
	4126 [label="\"Tu fouilles le corps du gardien, mais tu ne trouves rien de valeur, juste un biscuit. Tu songes à manger le biscuit moisi jusqu'à ce que tu en renifles l'odeur et tu reconsidères rapidement ta décision.\"",shape=box,color=blue];
		4126 -> 4130;
	4127 [label="\"Tu fouilles le corps du gardien à la recherche de tout objet utile. Il n'y a rien d'autre qu'un silex et un biscuit moisi. Tu prends le silex.\"",shape=box,color=blue];
		4127 -> 4131;
	4128 [label="Check boolean TorchTaken",color=orange];
		4128 -> 4133 [label=true,color=green];
		4128 -> 4132 [label=false,color=brown];
	4129 [label="\"Tu fermes la porte et attends de l'aide, mais personne n'arrive. Les gardiens arrivent et ils sont furieux parce que tu as tué leur camarade. Alors, ils te font toutes sortes de choses horribles et cruelles jusqu'à ce que tu meures de manière ignoble et absurde.\"",shape=box,color=blue];
		4129 -> 4134;
