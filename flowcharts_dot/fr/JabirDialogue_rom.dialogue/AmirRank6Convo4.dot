	4214 [label="je voulais dire...",shape=box,color=blue];
		4214 -> 4215;
	4215 [label="\"Le couinement s'intensifie, suivi d'un bruit de griffes sur la pierre. Soudain, ta torche projette une ombre. Un rat de la taille d'un chat... non... d'un chien fonce sur toi.\"",shape=box,color=blue];
		4215 -> 4216;
	4216 [label="\"Mais il n'est pas seul, ils arrivent de partout.\"",shape=box,color=blue];
		4216 -> 4217;
		4216 -> 4218;
		4216 -> 4219;
	4217 [label="Je leur botte le cul.",shape=box,color=red];
		4217 -> 4220;
	4218 [label="J'agite ma torche vers eux.",shape=box,color=red];
		4218 -> 4220;
	4219 [label="As-tu montré cette partie à Lettie?",shape=box,color=red];
		4219 -> 4221;
	4220 [label="\"Les rats t'encerclent. Tu te prépares à te battre, mais ils n'attaquent pas. Le plus gros d'entre eux courbe le cou devant toi. Tu réalises qu'il porte un collier. La chaîne en argent glisse et atterrit au sol. Le rat semble dire: c'est pour toi.\"",shape=box,color=blue];
		4220 -> 4222;
		4220 -> 4223;
	4221 [label="non et j'ai pas l'intention de le faire",shape=box,color=blue];
		4221 -> 4224;
	4222 [label="Je ramasse le collier.",shape=box,color=red];
		4222 -> 4225;
	4223 [label="Je demande au rat qui lui a donné le collier?",shape=box,color=red];
		4223 -> 4226;
	4224 [label="les rats viennent vers toi, quel est ton plan?",shape=box,color=blue];
		4224 -> 4217;
		4224 -> 4218;
	4225 [label="\"Tu prends le collier. Sur sa chaîne se trouve la clé.\"",shape=box,color=blue];
		4225 -> 4227;
	4226 [label="\"Le rat ne parle pas. C'est un rat, après tout.\"",shape=box,color=blue];
		4226 -> 4227;
	4227 [label="\"Les rats se retournent et s'enfuient. Celui qui leur a donné cette clé savait que tu étais ici. Il n'y a qu'une seule personne avec un tel pouvoir... Le Lotus.\"",shape=box,color=blue];
		4227 -> 4228;
	4228 [label="Une clé? Elle ouvre la porte?",shape=box,color=red];
		4228 -> 4229;
	4229 [label="\"Tu insères la clé dans la porte, elle fonctionne. Tu plisses les yeux, douloureusement, tandis que la lumière vive venant de l'autre côté t'illumine. Tu n'en crois pas tes yeux...\"",shape=box,color=blue];
		4229 -> 4230;
	4230 [label="et...",shape=box,color=blue];
		4230 -> 4231;
