	4154 [label="Update boolean FlintLoop3",color=orange];
		4154 -> 4118;
	4156 [label="\"Alors que tu te diriges prudemment vers le fond du couloir, la lumière de ta torche commence à révéler un gouffre de ténèbres devant toi. Tu te trouves au-dessus d'une citerne. En regardant en bas, tu ne peux pas en voir le fond. Sans la torche, tu aurais certainement trébuché à ta perte.\"",shape=box,color=blue];
