		4209 -> 4210;
	4210 [label="\"Tu remarques un léger bruit. Est-ce un couinement?\"",shape=box,color=blue];
		4210 -> 4211;
		4210 -> 4212;
	4211 [label="Ne me dis pas que ce sont des rats.",shape=box,color=red];
