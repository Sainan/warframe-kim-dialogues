	4187 [label="allez, c'est pour la ventilation, même les grineers du moyen-âge ont besoin d'air frais",shape=box,color=blue];
		4187 -> 4194;
	4191 [label="\"Il y a des éclaboussures de sang partout. De toute évidence, d'anciens prisonniers ont essayé des méthodes moins… efficaces. Alors, de leurs essais ratés et erreurs fatales, tu peux déduire ce qu'il faut faire!\"",shape=box,color=blue];
