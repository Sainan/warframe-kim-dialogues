		4117 -> 4115;
	4118 [label="\"Tu jettes un coup d'œil à la porte ouverte de la cellule. Que vas-tu faire ensuite?\"",shape=box,color=blue];
		4118 -> 4119;
		4118 -> 4120;
		4118 -> 4121;
	4116 [label="là, j'ai juste besoin de quelqu'un pour tester le chapitre suivant",shape=box,color=blue];
		4116 -> 4115;
	4119 [label="Je ferme la porte et j'attends de l'aide pendant que je termine mon inventaire. [Fin.]",shape=box,color=red];
		4119 -> 4122;
	4120 [label="Puis-je fouiller le corps du gardien?",shape=box,color=red];
