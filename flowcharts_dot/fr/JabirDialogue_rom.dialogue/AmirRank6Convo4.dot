	4147 [label="\"Une petite voix au fond de toi murmure: \"Hé, andouille, c'est ta dernière chance. Le gardien n'a toujours rien d'utile sur lui. Arrête de déconner.\"",shape=box,color=blue];
		4147 -> 4154;
	4149 [label="\"Tu prends la torche, en espérant que la flamme ne s'éteigne pas. Tu longes le couloir. Tu passes devant des cellules vides, toutes aussi nues les unes que les autres.\"",shape=box,color=blue];
		4149 -> 4156;
	4148 [label="\"Tu tâtonnes dans l'obscurité à la recherche de... quelque chose... à chaque pas, tu sembles t'égarer davantage. Soudain, tu trébuches sur un rebord.\"",shape=box,color=blue];
		4148 -> 4155;
