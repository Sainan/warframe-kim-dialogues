		j277241591 -> j2382283214;
	j2295625356 [label="Eeeeeeeeeet me revoilà. Désolé, qu'est-ce que t'essayais de me dire?",shape=box,color=blue];
		j2295625356 -> j4067993133;
	j4067993133 [label="tu... as quelqu'un d'autre quelque part? ou... à un autre moment? c'est... personne de l'hexagone... n'est-ce pas? ....... aaaah, ce serait tellement zarbiiiii",shape=box,color=blue];
		j4067993133 -> j3811874491;
	j3811874491 [label="ce serait comme si tu sortais avec ma cousine layla. beurkbeurkbeurkbeurk",shape=box,color=blue];
