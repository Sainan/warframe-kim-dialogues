		j1997256207 -> j1295315746;
	j506923781 [label="OK, ALORS, TU AS UNE AUTRE RELATION?!?!?!",shape=box,color=blue];
		j506923781 -> j1289522896;
	j1295315746 [label="ouais on parle jamais vraiment de ma famille. ON A TELLEMENT D'AUTRES TRUCS À SE DIRE, COMME... QUOI? TU AS UNE AUTRE RELATION?!?!",shape=box,color=blue];
		j1295315746 -> j1289522896;
	j1289522896 [label="Je comprends que ça te mette mal à l'aise. Et je tiens à ce que tu comprennes que tu comptes toujours autant pour moi.",shape=box,color=red];
		j1289522896 -> j532613550;
	j532613550 [label="C'est pas quelqu'un d'ici et je sais même pas si je pourrai vous présenter, mais… c'est quelqu'un qui compte beaucoup pour moi aussi. Tout comme toi.",shape=box,color=red];
		j532613550 -> j1549740163;
	j1549740163 [label="Je sais que ça peut être difficile à accepter et si ça ne te convient pas, je le comprends parfaitement. Je ne voulais simplement pas que tu penses que je te mentais ou que je te cachais quelque chose.",shape=box,color=red];
		j1549740163 -> j3391674043;
	j3391674043 [label="fffffffffffffffffffffffffffffffffffffffffffffffnhghhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhijejilmmmmmmmmmmmmmmmmmmmmkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk",shape=box,color=blue];
		j3391674043 -> j2237710887;
	j2237710887 [label="(c'est le bruit de mon court-circuit, au fait.)",shape=box,color=blue];
		j2237710887 -> j1002885100;
	j1002885100 [label="tu comptes énormément pour moi. vraiment beaucoup beaucoup. et je ne veux pas perdre ça. et si c'est quelqu'un d'important pour toi, alors… ce sera quelqu'un d'important pour moi aussi.",shape=box,color=blue];
		j1002885100 -> j1775576254;
