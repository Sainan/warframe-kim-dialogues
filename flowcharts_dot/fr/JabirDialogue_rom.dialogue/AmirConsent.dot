		j3316821453 -> "Chat ends.";
	j1650186247 [label="Je veux te parler de quelque chose et je veux m'assurer que ça te dérange pas avant que ça n'aille trop loin.",shape=box,color=red];
		j1650186247 -> j488284999;
	j488284999 [label="Je sais qu'on en a jamais parlé auparavant. C'est important pour moi que t'aies pas l'impression que je te mens ou que je suis malhonnête avec toi, peu importe la façon.",shape=box,color=red];
		j488284999 -> j3993555795;
	j3993555795 [label="Euh… questcequisepassequestcequisestpassétuastuéquelquunquiestmort? Attends, c'est plus bizarre que ça? çadoitêtreplusbizarrequeçatusorsaveclaguitareO-M-G?????",shape=box,color=blue];
		j3993555795 -> j3967878078;
		j3993555795 -> j1683073876;
	j3967878078 [label="Je sais que ça peut paraître étrange, mais ça veut pas dire que j'ai moins de sentiments pour toi.",shape=box,color=red];
		j3967878078 -> j2382283214;
	j1683073876 [label="Bon, c'est pas la guitare, au moins…? Je sais que ça peut paraître étrange, mais cela ne signifie pas que j'ai moins de sentiments pour toi.",shape=box,color=red];
