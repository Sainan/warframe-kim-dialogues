		j572503223 -> j161663496 [label=true,color=green];
		j572503223 -> j2027887558 [label=false,color=brown];
	j3645218558 [label="\"L'homme semble soulagé. Sortez-moi d'ici, dit-il.\"",shape=box,color=blue];
		j3645218558 -> j2292900015;
	j3964343381 [label="AHEM",shape=box,color=blue];
		j3964343381 -> j2295738639;
	j2774624317 [label="\"Les pinces coupantes coupent rapidement les câbles attachés à l'homme. Les bras libres, il peut retirer ses entraves.\"",shape=box,color=blue];
		j2774624317 -> j826870611;
	j2593767518 [label="\"Tu places la lame de la pince coupante sur les fils électriques et tu le regrettes immédiatement. Le courant traverse la pince coupante et pénètre dans ton corps, te projetant en arrière.\"",shape=box,color=blue];
		j2593767518 -> j1779991000;
	j161663496 [label="\"Ça n’a pas très bien fonctionné la dernière fois.\"",shape=box,color=blue];
		j161663496 -> j4190543046;
		j161663496 -> j3140623892;
	j2027887558 [label="\"Alors que tu détruis le panneau de commande, l'homme coincé semble te crier dessus. Il n'a pas apprécié ton geste.\"",shape=box,color=blue];
		j2027887558 -> j1502386489;
	j2292900015 [label="Boolean TurbineStopped is now true.",color=orange];
		j2292900015 -> j2139926005;
	j2295738639 [label="::S'ÉCLAIRCIT LA GORGE::",shape=box,color=blue];
		j2295738639 -> j242195017;
	j826870611 [label="\"Enlevant ses lunettes de soleil rondes, l'homme regarde longuement son sauveur.\"",shape=box,color=blue];
		j826870611 -> j3499241272;
	j1779991000 [label="\"Tu te réveilles par terre. L'homme souffre encore et tes cheveux sont maintenant dressés sur ta tête.\"",shape=box,color=blue];
		j1779991000 -> j970257374;
	j1502386489 [label="Boolean PanelSmashed is now true.",color=orange];
