		j1502386489 -> j3140623892;
	j242195017 [label="\"Miraculeusement, d'une manière ou d'une autre, la turbine EXPLOSE sous la force de la puissance pure de l'homme!\"",shape=box,color=blue];
		j242195017 -> j180739354;
