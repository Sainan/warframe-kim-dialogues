	j779002903 [label="tu reviendras, je le sais",shape=box,color=blue];
		j779002903 -> "Chat ends.";
	j2279112726 [label="\"Alors que tu tournes la clé qui t'a été donnée par une bande de rats surdimensionnés étonnamment cordiaux, tu pries pour que ce qui se trouve derrière la porte soit plus sûr que le donjon qui se trouve derrière toi.\"",shape=box,color=blue];
		j2279112726 -> j3736085774;
	"Chat ends. Next chat will be AmirRank6Convo3." [color=orange];
	"Chat ends. Next chat will be AmirRank6Convo2." [color=orange];
	j3736085774 [label="\"Tu te trouves devant un grand ascenseur de service. Ce n'est donc pas un simple donjon?\"",shape=box,color=blue];
		j3736085774 -> j560095395;
		j3736085774 -> j430789753;
	j560095395 [label="Je retourne au donjon.",shape=box,color=red];
		j560095395 -> j891124009;
	j430789753 [label="Je prends l'ascenseur.",shape=box,color=red];
		j430789753 -> j4035155627;
	j891124009 [label="\"Tu te retournes et regardes le donjon, en te disant qu'y retourner serait une idée stupide.\"",shape=box,color=blue];
		j891124009 -> j3119897689;
	j4035155627 [label="\"Tu montes dans l'ascenseur. À travers sa cage ouverte, tu vois les murs de pierre du donjon remplacés par une technologie de plus en plus avancée. Tu te demandes encore: \"Où diable suis-je donc?\"\"",shape=box,color=blue];
		j4035155627 -> j1765038537;
	j3119897689 [label="Haha... Très bien, je prends cet ascenseur.",shape=box,color=red];
		j3119897689 -> j4035155627;
	j1765038537 [label="\"L'ascenseur débouche sur un couloir rempli de machines vrombissantes et de tubes géants. Est-ce une sorte de laboratoire?\"",shape=box,color=blue];
		j1765038537 -> j3154687554;
	j3154687554 [label="\"Depuis une pièce au bout du couloir, tu entends un homme crier de douleur.\"",shape=box,color=blue];
		j3154687554 -> j2278172879;
		j3154687554 -> j1883352417;
	j2278172879 [label="J'ignore les cris, je cherche une issue.",shape=box,color=red];
		j2278172879 -> j1386310658;
	j1883352417 [label="Je vais vers cet homme.",shape=box,color=red];
		j1883352417 -> j1158318367;
	j1386310658 [label="\"Tu fouilles le couloir à la recherche d'objets utiles, mais les cris deviennent impossibles à ignorer. Cet homme t'attire, tu sens que tu dois l'aider.\"",shape=box,color=blue];
		j1386310658 -> j1158318367;
	j1158318367 [label="\"Tu longes le couloir en suivant la source des cris d'agonie. Tu entres dans une grande salle mécanique et tu vois un homme. Un homme plutôt séduisant, attaché à une machine. Des décharges électriques jaillissent de ses doigts, alimentant une turbine géante.\"",shape=box,color=blue];
		j1158318367 -> j1203494887;
		j1158318367 -> j2737297746;
	j1203494887 [label="Je dis: \"Hé, ça va?\"",shape=box,color=red];
		j1203494887 -> j1419002666;
	j2737297746 [label="J'examine l'homme.",shape=box,color=red];
		j2737297746 -> j1419002666;
	j1419002666 [label="\"L'homme est attaché à une plateforme surélevée, les bras écartés. Au bout de ses doigts sont fixées des sondes qui se tressent pour former un câble épais relié à une turbine géante. Des arcs électriques jaillissent de ses mains.\"",shape=box,color=blue];
		j1419002666 -> j3704610608;
	j3704610608 [label="\"Entre les cris et les décharges électriques, l'homme parvient à dire: \"ARRÊTE... LES... TURBINES!!\"",shape=box,color=blue];
		j3704610608 -> j3675769672;
	j3675769672 [label="J'examine la pièce.",shape=box,color=red];
		j3675769672 -> j1366961504;
	j1366961504 [label="\"Tu regardes autour de toi, à la recherche d'un objet utile. Tu vois un établi avec des outils. Un pied-de-biche. Une pince coupante géante. Un panneau de contrôle.\"",shape=box,color=blue];
		j1366961504 -> j1571667540;
