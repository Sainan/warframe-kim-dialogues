		j180739354 -> j714251981;
	j1852783493 [label="\"Son regard est perçant.\"",shape=box,color=blue];
		j1852783493 -> j2353822847;
	j1584242454 [label="Des lunettes rondes, comment s'appelle-t-il?",shape=box,color=red];
		j1584242454 -> j1991176466;
	j714251981 [label="arf je voulais dire",shape=box,color=blue];
		j714251981 -> j2174490382;
	j2353822847 [label="\"Tu remarques ses mains puissantes, ses avant-bras et ses jambes musclées. \"Conçu pour la vitesse\", penses-tu en haussant les sourcils.\"",shape=box,color=blue];
		j2353822847 -> j1011582086;
	j1991176466 [label="\"Je m'appelle Zabir, dit-il avec assurance.\"",shape=box,color=blue];
		j1991176466 -> j641465;
	j2174490382 [label="\"Enlevant ses lunettes rondes, l'homme regarde longuement la personne qui essayait de le sauver.\"",shape=box,color=blue];
		j2174490382 -> j3499241272;
	j1011582086 [label="Calme-toi, mon grand. Comment s'appelle ce bel homme?",shape=box,color=red];
		j1011582086 -> j1991176466;
	j641465 [label="Ça me dit quelque chose. Qu'est-ce qu'ils te faisaient?",shape=box,color=red];
		j641465 -> j2306068297;
	j2306068297 [label="\"Ils récoltent mon énergie. Je suis très électrique, mais vous l'avez probablement déjà remarqué, dit Zabir\"",shape=box,color=blue];
		j2306068297 -> j2008551626;
	j2008551626 [label="Ok, Zabir, comment allons-nous sauver le Lotus?",shape=box,color=red];
		j2008551626 -> j1556428489;
	j1556428489 [label="Zabir est sous le choc. \"Sauver le Lotus? C'est elle qui m'a mis ici! Il faut qu'on quitte cet astéroïde!\"",shape=box,color=blue];
		j1556428489 -> j2645020295;
		j1556428489 -> j1467251721;
	j2645020295 [label="Amir, quoi?",shape=box,color=red];
