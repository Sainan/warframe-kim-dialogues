		j3136528501 -> j3196822835 [label=false,color=brown];
	j1015619559 [label="\"L'outil est de qualité industrielle et semble pouvoir couper à peu près n'importe quoi.\"",shape=box,color=blue];
		j1015619559 -> j2139926005;
	j791100240 [label="J'utilise le pied-de-biche pour fracasser le panneau de contrôle.",shape=box,color=red];
		j791100240 -> j1110728012;
	j3140623892 [label="Je lance le pied-de-biche dans les pales de la turbine.",shape=box,color=red];
		j3140623892 -> j3578776935;
	j4190543046 [label="Je continue à chercher",shape=box,color=red];
		j4190543046 -> j1571667540;
	j3460316228 [label="soit t'abuses, soit t'es VRAIMENT une quiche",shape=box,color=blue];
		j3460316228 -> j2952980541;
	j524721085 [label="\"Tu ne veux probablement pas jouer à nouveau avec ça.\"",shape=box,color=blue];
		j524721085 -> j4186227793;
		j524721085 -> j2355604518;
	j3196822835 [label="\"Tu essaies d'utiliser le panneau de contrôle, mais il est verrouillé par un protocole de sécurité que même toi tu ne peux pirater. Tu réalises que tu vas devoir le faire manuellement.\"",shape=box,color=blue];
		j3196822835 -> j4186227793;
		j3196822835 -> j2355604518;
	j2139926005 [label="Je coupe les fils.",shape=box,color=red];
		j2139926005 -> j995680227;
	j1110728012 [label="Boolean ControlPanel is now true.",color=orange];
		j1110728012 -> j572503223;
	j3578776935 [label="\"De toutes tes forces, tu lances le pied-de-biche dans la turbine. Un vacarme massif d'engrenages et de pistons grinçants emplit la pièce. La turbine ralentit alors considérablement.\"",shape=box,color=blue];
		j3578776935 -> j3645218558;
	j2952980541 [label="alors on va passer à la suite",shape=box,color=blue];
		j2952980541 -> j3964343381;
