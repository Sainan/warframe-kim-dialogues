		j256735146 -> j1087431613;
	j1290462025 [label="encore un essai? tu gardes zabir en vie cette fois?",shape=box,color=blue];
		j1290462025 -> j2799900155;
		j1290462025 -> j1543789771;
	j2902866756 [label="\"Tu saisis ta chance et tu sprintes vers le Railjack.\"",shape=box,color=blue];
		j2902866756 -> j360573576;
	j366526384 [label="\"Zabir te fait signe d'ouvrir les portes du hangar.\"",shape=box,color=blue];
		j366526384 -> j626538632;
	j1087431613 [label="Check boolean RampGuardZapped",color=orange];
		j1087431613 -> j2902866756 [label=true,color=green];
		j1087431613 -> j3674411207 [label=false,color=brown];
	j2799900155 [label="Je promets de ne pas te tuer, cette fois.",shape=box,color=red];
		j2799900155 -> j769413847;
	j1543789771 [label="Je pense que nous pouvons nous arrêter ici. [Fin.]",shape=box,color=red];
		j1543789771 -> j613668901;
	j360573576 [label="\"Tu regardes Zabir et tu dis: j'espère que tu sais piloter cet engin, et Zabir répond: je ne sais pas, mais toi, si.\"",shape=box,color=blue];
		j360573576 -> j356226217;
	j3674411207 [label="\"Zabir pointe le garde de la rampe du doigt.\"",shape=box,color=blue];
		j3674411207 -> j900783396;
	j769413847 [label="Boolean KeepZabirAlive is now true.",color=orange];
		j769413847 -> j774369477;
	j613668901 [label="tu me tues",shape=box,color=blue];
		j613668901 -> "Chat ends.";
	j356226217 [label="\"Tu démarres le vaisseau et, juste au moment où tu t'apprêtes à appuyer sur le bouton pour remonter la rampe et fermer la porte, Zabir dit: Attends! On ne peut pas les laisser.\"",shape=box,color=blue];
		j356226217 -> j1134653942;
		j356226217 -> j3802109524;
	j1134653942 [label="Tu as raison, nous devons les sauver.",shape=box,color=red];
		j1134653942 -> j2464256449;
	j3802109524 [label="S'il te plaît, non. On devrait vraiment les laisser.",shape=box,color=red];
		j3802109524 -> j3638552022;
	j2464256449 [label="\"Zabir lève le sifflet et souffle.\"",shape=box,color=blue];
		j2464256449 -> j2617744361;
	j3638552022 [label="\"Rejeté!\" dit Zabir.",shape=box,color=blue];
		j3638552022 -> j2464256449;
	j2617744361 [label="\"Quelques secondes plus tard, des dizaines de rats affluent sur le vaisseau. Zabir te regarde et crie: Décolle!\"",shape=box,color=blue];
		j2617744361 -> j2778911454;
	j2778911454 [label="\"Le vaisseau décolle. Les Grineers ouvrent le feu, mais leurs balles rebondissent sur le puissant Railjack à sa sortie du hangar.\"",shape=box,color=blue];
		j2778911454 -> j2630692776;
	j2630692776 [label="\"Tandis que les rats s'agitent sur la passerelle, tu contemples l'immensité de l'espace, puis tu dis avec assurance: \"ENTRÉE DANS L'HYPERESPACE\" et le Railjack disparaît en un éclair.\"",shape=box,color=blue];
		j2630692776 -> j1041786733;
	j1041786733 [label="\"FIN.\"",shape=box,color=blue];
		j1041786733 -> j3114165233;
	j3114165233 [label="Waouh.",shape=box,color=red];
		j3114165233 -> j1836815444;
	j1836815444 [label="alors, tu penses quoi de la fin? c'était trop ouf?",shape=box,color=blue];
		j1836815444 -> j1197372657;
		j1836815444 -> j1747723800;
	j1197372657 [label="Je suis sans voix.",shape=box,color=red];
		j1197372657 -> j2209926151;
	j1747723800 [label="Oui, et j'ai adoré.",shape=box,color=red];
		j1747723800 -> j1496519756;
	j2209926151 [label="j'ai déjà eu des retours pires que ça",shape=box,color=blue];
		j2209926151 -> j3915723010;
	j1496519756 [label="ouf, j'avais peur d'avoir un peu exagéré, là",shape=box,color=blue];
		j1496519756 -> j3915723010;
	j3915723010 [label="Alors, à propos de cet inventaire.",shape=box,color=red];
		j3915723010 -> j732383813;
