	j2939756469 [label="Utilisons ce sifflet à rat.",shape=box,color=red];
		j2939756469 -> j2219926875;
	j2844774565 [label="J'utilise le panneau de contrôle.",shape=box,color=red];
		j2844774565 -> j2595279065;
	j1674642591 [label="Je fonce vers le Railjack.",shape=box,color=red];
		j1674642591 -> j1328927821;
	j2599190449 [label="Je demande à Zabir d'attaquer le garde de la rampe.",shape=box,color=red];
		j2599190449 -> j2825801503;
	j2219926875 [label="\"Zabir prend le sifflet et joue une longue note. On n'entend rien d'autre qu'un souffle. Vous attendez, assis, mais rien ne se passe. Pas de rats, rien. Zabir hausse les épaules.\"",shape=box,color=blue];
		j2219926875 -> j2479214606;
	j2595279065 [label="\"Tu arrives au panneau de contrôle, mais pas avant qu'un garde attentif ne te remarque. Tu essaies de lever les mains pour te rendre, mais il te tire dessus quand même, parce que les Grineers sont méchants comme ça.\"",shape=box,color=blue];
		j2595279065 -> j969943149;
		j2595279065 -> j3236889432;
	j1328927821 [label="\"Tu te précipites vers le vaisseau, mais le garde de la rampe te repère et ouvre le feu. Ta journée, et ta vie, se terminent douloureusement.\"",shape=box,color=blue];
		j1328927821 -> j969943149;
		j1328927821 -> j2238030915;
	j2825801503 [label="oh bien sûr quand il y a un danger tu sacrifies amir",shape=box,color=blue];
		j2825801503 -> j1966589031;
	j2479214606 [label="\"Puis, vous entendez quelque chose. Comme un bruit de mastication. Soudain, des rats jaillissent des bouches d'aération tout autour du hangar. Les gardes Grineers hurlent comme des écoliers et ouvrent le feu. Les balles fusent de toutes parts.\"",shape=box,color=blue];
		j2479214606 -> j3469831148;
	j969943149 [label="J'ai besoin d'une pause. [Fin.]",shape=box,color=red];
		j969943149 -> j4199124064;
	j3236889432 [label="J'essaie encore.",shape=box,color=red];
		j3236889432 -> j318932394;
	j2238030915 [label="Encore!",shape=box,color=red];
		j2238030915 -> j1595881847;
	j1966589031 [label="je veux dire zabir",shape=box,color=blue];
		j1966589031 -> j2694394792;
	j3469831148 [label="\"Les rats ont distrait les gardes. Que faire, maintenant?\"",shape=box,color=blue];
		j3469831148 -> j900783396;
		j3469831148 -> j626538632;
	j4199124064 [label="tu reviendras",shape=box,color=blue];
		j4199124064 -> "Chat ends.";
	j318932394 [label="Boolean OneMoreTime is now true.",color=orange];
		j318932394 -> j774369477;
	j1595881847 [label="Boolean Again is now true.",color=orange];
		j1595881847 -> j774369477;
	j2694394792 [label="bon",shape=box,color=blue];
		j2694394792 -> j117842855;
	j900783396 [label="Je demande à Zabir de tuer le garde de la rampe!",shape=box,color=red];
		j900783396 -> j4016287444;
	j626538632 [label="J'ouvre les portes depuis le panneau de commande.",shape=box,color=red];
		j626538632 -> j1563046003;
	j117842855 [label="\"Tu cries: \"Zabir, charge-toi de lui!\" tout en pointant du doigt le garde de la rampe.\"",shape=box,color=blue];
		j117842855 -> j2924401485;
	j4016287444 [label="\"Zabir se précipite sur le garde et l'électrocute. Il tombe, raide mort.\"",shape=box,color=blue];
		j4016287444 -> j3028613594;
	j1563046003 [label="\"Tu te faufiles jusqu'au pupitre de commande et tentes d'utiliser la console discrètement. Tu parviens à déclencher l'ouverture des portes du hangar.\"",shape=box,color=blue];
		j1563046003 -> j3168483917;
	j2924401485 [label="\"Malgré lui, Zabir s'élance courageusement. Mais même lui n'est pas assez rapide pour passer inaperçu. Les gardes ouvrent le feu et Zabir est tragiquement tué.\"",shape=box,color=blue];
		j2924401485 -> j1117225311;
	j3028613594 [label="Boolean RampGuardZapped is now true.",color=orange];
		j3028613594 -> j1915017362;
	j3168483917 [label="\"Distraits par les rats, les gardes ne s'en aperçoivent même pas.\"",shape=box,color=blue];
		j3168483917 -> j256735146;
	j1117225311 [label="game over",shape=box,color=blue];
		j1117225311 -> j1290462025;
