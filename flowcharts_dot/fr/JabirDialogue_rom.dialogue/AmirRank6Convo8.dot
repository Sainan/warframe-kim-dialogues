	j3733643360 [label="tant pis pour toi",shape=box,color=blue];
		j3733643360 -> "Chat ends.";
	j603310178 [label="+5 Chemistry",color=orange];
		j603310178 -> j2838895179;
	j2780436055 [label="+5 Chemistry",color=orange];
		j2780436055 -> j3002736866;
	j2838895179 [label="oh... c'est prêt",shape=box,color=blue];
		j2838895179 -> j2465324615;
	j3002736866 [label="je ne te blâmerais pas, il est plutôt fringant",shape=box,color=blue];
		j3002736866 -> j2465324615;
	j2465324615 [label="c'est parti",shape=box,color=blue];
		j2465324615 -> j697961422;
	j697961422 [label="\"Tu te tiens au milieu du laboratoire électrique avec Zabir, désormais libre. Il te regarde: pas de temps à perdre, suis-moi.\"",shape=box,color=blue];
		j697961422 -> j456840914;
	j456840914 [label="\"Il te guide couloir après couloir. Il connaît cet astéroïde comme sa poche, chaque gardien et leurs mouvements.\"",shape=box,color=blue];
		j456840914 -> j2689106733;
		j456840914 -> j3631511991;
		j456840914 -> j3741437385;
	j2689106733 [label="J'interroge Zabir à propos des rats.",shape=box,color=red];
		j2689106733 -> j1462778231;
	j3631511991 [label="Est-il aussi prisonnier?",shape=box,color=red];
		j3631511991 -> j2517526910;
	j3741437385 [label="Où est-ce que Zabir m'emmène?",shape=box,color=red];
		j3741437385 -> j524997031;
	j1462778231 [label="\"Zabir est surpris. “Les rats ont réussi à te trouver? C'est incroyable. Ça a marché. Regarde.” Zabir brandit un sifflet en or finement gravé. “La Reine des Rats me l'a donné. Il faut qu'on la retrouve.”\"",shape=box,color=blue];
		j1462778231 -> j2324742675;
	j2517526910 [label="\"Tu demandes à Zabir comment il est arrivé ici, il te répond: Pas le temps pour ça, nous devons nous concentrer pour sortir d'ici.\"",shape=box,color=blue];
		j2517526910 -> j2689106733;
		j2517526910 -> j3741437385;
	j524997031 [label="\"Zabir se retourne et dit: Je t'emmène au hangar. On vole un vaisseau et on s'éloigne le plus possible d'ici. On doit trouver la Reine des Rats.\"",shape=box,color=blue];
		j524997031 -> j2324742675;
	j2324742675 [label="LA REINE DES RATS?",shape=box,color=red];
		j2324742675 -> j3411209066;
	j3411209066 [label="\"Elle m'a donné ce sifflet. Les rats l'écoutent. C'est mon amie. Elle n'est pas toujours sympa, mais elle se soucie de moi.\"",shape=box,color=blue];
		j3411209066 -> j39485795;
		j3411209066 -> j1256677240;
	j39485795 [label="As-tu montré ça à Lettie, par hasard?",shape=box,color=red];
		j39485795 -> j2967690349;
	j1256677240 [label="Elle me rappelle quelqu'un, tiens.",shape=box,color=red];
		j1256677240 -> j800051168;
	j2967690349 [label="j'accorde trop d'importance à ma vie pour prendre ce risque",shape=box,color=blue];
		j2967690349 -> j2940869210;
	j800051168 [label="toute ressemblance avec des personnes réelles ou imaginaires n'est qu'une coïncidence",shape=box,color=blue];
		j800051168 -> j2940869210;
	j2940869210 [label="\"Avec l'aide de Zabir, tu zigzagues à travers les couloirs de l'astéroïde. Il esquive habilement les gardes et les caméras de sécurité.\"",shape=box,color=blue];
		j2940869210 -> j831280917;
	j831280917 [label="\"Finalement, vous arrivez devant une grande porte. Zabir te fait signe de te baisser. Vous vous accroupissez tous les deux et vous vous faufilez dans le hangar du vaisseau.\"",shape=box,color=blue];
		j831280917 -> j1729930848;
	j1729930848 [label="\"Vous vous accroupissez à l'ombre d'un pilier. On entend les gardes Grineers à proximité.\"",shape=box,color=blue];
		j1729930848 -> j4205041299;
	j4205041299 [label="\"Que fais-tu?\"",shape=box,color=blue];
		j4205041299 -> j976399152;
		j4205041299 -> j3092590969;
	j976399152 [label="J'attaque les gardes.",shape=box,color=red];
		j976399152 -> j1713796089;
	j3092590969 [label="Je jette un coup d'œil.",shape=box,color=red];
		j3092590969 -> j4030315316;
	j1713796089 [label="\"Sans une once de bon sens, tu te précipites à découvert. Un groupe de gardes de l'autre côté commence à tirer. Tu charges tête baissée sous une pluie de balles qui te tuent sur le coup. Zabir secoue la tête devant ton acte de bravoure insensé.\"",shape=box,color=blue];
		j1713796089 -> j3241913076;
	j4030315316 [label="\"Tu jettes un coup d’œil et tu examines la zone.\"",shape=box,color=blue];
		j4030315316 -> j877750043;
	j3241913076 [label="tu veux réessayer et éviter de te faire tuer si facilement cette fois?",shape=box,color=blue];
		j3241913076 -> j1825267275;
		j3241913076 -> j688636894;
	j877750043 [label="\"Un Railjack est posé au centre du hangar. La rampe d'accès est bloquée par un garde. D'un côté du hangar, une douzaine de Grineers disputent une partie de dés animée. Quelques mètres devant vous se trouve un bureau avec un panneau de contrôle.\"",shape=box,color=blue];
		j877750043 -> j3558338059;
	j1825267275 [label="Ouais.",shape=box,color=red];
		j1825267275 -> j1372696387;
	j688636894 [label="Ça suffit pour aujourd'hui. [Fin.]",shape=box,color=red];
		j688636894 -> "Chat ends.";
	j3558338059 [label="\"Pour sortir, nous devons d'abord ouvrir les portes du hangar, murmure Zabir.\"",shape=box,color=blue];
		j3558338059 -> j3041706410;
	j1372696387 [label="\"Que fais-tu cette fois?\"",shape=box,color=blue];
		j1372696387 -> j2311520994;
		j1372696387 -> j3092590969;
	j3041706410 [label="\"Zabir te regarde: tu as une idée géniale?\"",shape=box,color=blue];
		j3041706410 -> j774369477;
		j3041706410 -> j3041706410;
	j2311520994 [label="... J'inspecte la zone?",shape=box,color=red];
		j2311520994 -> j4030315316;
