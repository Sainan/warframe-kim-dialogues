	3493 [label="Hé Amir, t'es là?",shape=box,color=red];
		3493 -> 3494;
	3495 [label="[Ignorer.]",shape=box,color=red];
		3495 -> 3496;
	3494 [label="qu'est-ce qu'il se passe dans l'espace?",shape=box,color=blue];
		3494 -> 3497;
		3494 -> 3498;
	3496 [label="Chat ends.",color=orange];
	3497 [label="Robots.",shape=box,color=red];
		3497 -> 3499;
	3498 [label="Alors... Quincy te fait une farce, et je suis le leurre.",shape=box,color=red];
		3498 -> 3500;
	3499 [label="ROBOTSROBOTSROBOTSROBOTSROBOTSROBOTSROBOTSROBOTSROBOTSROBOTSROBOTSROBOTS",shape=box,color=blue];
		3499 -> 3501;
	3500 [label="Hein?!?!? une farce? genre... quel genre de farce....?",shape=box,color=blue];
		3500 -> 3502;
		3500 -> 3503;
	3501 [label="::cough:: je veux dire... ouaissssss?? Et ces robots dont tu paaaarles?",shape=box,color=blue];
		3501 -> 3504;
		3501 -> 3505;
	3502 [label="Il remplit ta chambre de cacahuètes.",shape=box,color=red];
		3502 -> 3506;
	3503 [label="Honnêtement? Je pense que c'est sa façon de montrer qu'il se soucie des autres.",shape=box,color=red];
		3503 -> 3507;
	3504 [label="Je t'ai parlé des robots araignées géants sur Vénus?",shape=box,color=red];
		3504 -> 3508;
	3505 [label="Alors, je t'ai parlé des chiens robotisés?",shape=box,color=red];
		3505 -> 3509;
	3506 [label="d'awwwwwwwuhhh!! Personne a jamais pris la peine de remplir ma chambre de cacahuètes avant!!!",shape=box,color=blue];
		3506 -> 3510;
	3507 [label="... d'aaaaawwwww... c'est tellement mignon!!! Personne m'a autant aimé pour faire ça avant!",shape=box,color=blue];
		3507 -> 3510;
	3508 [label="JE CROIS AVOIR VU CE FILM UNE FOIS",shape=box,color=blue];
		3508 -> 3511;
	3509 [label="tu. as. des. CHIENS. ROBOTISÉS?!",shape=box,color=blue];
		3509 -> 3512;
	3510 [label="Eeeeeh bien, je dirai pas que tu m'as dit ce qu'il faisait, je vais juste m'asseoir ici et faire semblant d'être super occupé à coder mon jeu mdr",shape=box,color=blue];
		3510 -> 3524;
	3511 [label="mais c'était pas un film de science-fiction, c'était un western. Et d'accord, c'était assez nul dans l'ensemble, mais honnêtement, je l'ai plutôt aimé?",shape=box,color=blue];
		3511 -> 3513;
	3512 [label="je réalise soudainement que j'ai une nouvelle mission dans la vie. Posséder un chien robot. Je dois l'appeler Fido. Ou Scrap. Ou Chip. CHIP!! CHIP C'EST LE MEILLEUR NOM POUR UN CHIEN ROBOT",shape=box,color=blue];
		3512 -> 3514;
	3524 [label="+20 Chemistry",color=orange];
		3524 -> 3526;
	3513 [label="je veux dire, le film savait ce qu'il essayait d'être. Il ne se prenait pas trop au sérieux, tu vois? Rien ne me reste plus en travers de la gorge qu'un film de cow-boys avec une araignée steampunk géante qui essaie de se faire passer pour du grand art mdr",shape=box,color=blue];
		3513 -> 3515;
	3514 [label="ET JE VAIS ME BATTRE SI TU DIS LE CONTRAIRE",shape=box,color=blue];
		3514 -> 3516;
	3526 [label="heheeeeee mais j'espère qu'il se rend compte, bien sûr... que. ÇA! veut dire... la BAGARRRE!!!",shape=box,color=blue];
		3526 -> 3592;
	3515 [label="c'est pas ce que ce film a fait, remarque, c'est exactement ce que je dis. Ce film ne l'a pas fait. Mais il y avait totalement une araignée robot géante. Même si je suis sûr que celles dont tu parles sont très high-tech",shape=box,color=blue];
		3515 -> 3517;
	3516 [label="tu comprends \"chip\" lol chien robot c'est parce que les ordinateurs ont des puces à l'intérieur, comme... une puce d'ordi, tu comprends? ... est-ce que les ordinateurs de ton époque ont encore des puces?",shape=box,color=blue];
		3516 -> 3518;
	3592 [label="{\"Id\":3592,\"Incoming\":[3526],\"Outgoing\":[3525],\"GraphPos\":[-11528,45678],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/QuincyDialogue_rom.dialogue\",\"Tag\":\"QuincyAmirTrick2\",\"Value\":0}]}",color=orange];
		3592 -> 3525;
	3517 [label="je suis désolé. tu disais?",shape=box,color=blue];
		3517 -> 3519;
	3518 [label="ou ils sont tous basés sur des trucs bizarres, organiques et à base de proto-viande-néant-machin",shape=box,color=blue];
		3518 -> 3519;
