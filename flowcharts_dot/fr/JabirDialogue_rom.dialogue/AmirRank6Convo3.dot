		j3258181895 -> j2653539027;
	j2912107090 [label="\"Tu te réveilles dans une cellule sombre et humide, au fond d'un donjon. Dans le couloir, derrière les barreaux, un garde ronfle. Apnée du sommeil? Il devrait probablement se faire examiner. Tu ne te souviens plus de grand-chose, mais tu sais qu'il faut que tu sortes.\"",shape=box,color=blue];
