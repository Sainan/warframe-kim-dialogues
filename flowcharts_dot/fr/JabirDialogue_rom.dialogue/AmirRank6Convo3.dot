	j2826764734 [label="\"Le mur ouvert de la cellule est barré de vieux barreaux de fer, et la porte est verrouillée par une vieille serrure rouillée. Les ronflements du gardien se font plus forts, plus rauques.\"",shape=box,color=blue];
