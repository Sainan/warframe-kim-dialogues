	j1510737396 [label="\"Sec comme un objet posé là depuis des décennies. Quand tu le ramasses, les chaînes s'écrasent au sol et se brisent. Parmi les morceaux se trouve un éclat de métal déchiqueté.\"",shape=box,color=blue];
