		j3841079422 -> j227449153;
	j3334525224 [label="Probablement.",shape=box,color=red];
		j3334525224 -> j3513721614;
	j1412870814 [label="premièrement: c'est une histoire incroyable...",shape=box,color=blue];
		j1412870814 -> j4172117331;
	j227449153 [label="oh...",shape=box,color=blue];
		j227449153 -> j3513721614;
	j3513721614 [label="tu ne peux pas simplement les rendre?!",shape=box,color=blue];
		j3513721614 -> j1008229290;
		j3513721614 -> j891241975;
	j4172117331 [label="deuxièmement",shape=box,color=blue];
		j4172117331 -> j3009217624;
	j1008229290 [label="Je... ne sais pas où ils sont.",shape=box,color=red];
		j1008229290 -> j3449672641;
	j891241975 [label="Je ne sais pas si c'est une bonne idée?",shape=box,color=red];
		j891241975 -> j3449672641;
