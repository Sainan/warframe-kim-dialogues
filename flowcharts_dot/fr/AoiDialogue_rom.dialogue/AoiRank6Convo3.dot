	j13902147 [label="oui, il le dira, d'une manière ou d'une autre",shape=box,color=blue];
		j13902147 -> j728738548;
	j3258933205 [label="Même si c'est pour réparer ses erreurs, d'une certaine manière, c'est précisément pour apporter à l'univers cette empathie dont tu parles.",shape=box,color=red];
		j3258933205 -> j239343553;
