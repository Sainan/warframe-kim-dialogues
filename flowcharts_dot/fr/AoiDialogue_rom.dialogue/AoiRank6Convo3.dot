		j893851715 -> j2626648395;
	j3549175698 [label="Le grand vaisseau, le Railjack, utilise une chose appelée Engin Reliquaire - il contient une réplique du doigt coupé de l'Indifférence.",shape=box,color=red];
		j3549175698 -> j3444060442;
	j2626648395 [label="Il l'utilise pour puiser dans le Néant et franchir les grandes distances entre les planètes. Il traverse le Néant.",shape=box,color=red];
