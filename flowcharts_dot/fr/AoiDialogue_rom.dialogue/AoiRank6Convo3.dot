		j341038888 -> j1742919260;
	j2917183499 [label="TL - IAR: Albrecht est entré dans le Néant, a paniqué et a fini par voler quelques doigts de l'Indifférence.",shape=box,color=red];
		j2917183499 -> j2713084862;
	j1742919260 [label="Bon. D'accord. Albrecht... était le premier à \"découvrir\" comment entrer dans le Néant.",shape=box,color=red];
		j1742919260 -> j2427970662;
	j2713084862 [label="déjà... TL - IAR?",shape=box,color=blue];
		j2713084862 -> j1163713440;
	j2427970662 [label="C'était une sorte de cloche de plongée. Fabriquée en sériglas. Ça a ouvert la membrane entre les mondes.",shape=box,color=red];
		j2427970662 -> j1772056436;
	j1163713440 [label="Trop long, impossible à résumer. Quincy me l'a appris.",shape=box,color=red];
		j1163713440 -> j3609008417;
	j1772056436 [label="Les choses ont mal tourné, pour le dire gentiment. Il a paniqué, a titubé, l'objet a basculé et a heurté le bord tranchant de la membrane.",shape=box,color=red];
		j1772056436 -> j323044768;
	j3609008417 [label="huh...",shape=box,color=blue];
		j3609008417 -> j2847622506;
	j323044768 [label="La cloche en verre se brisa et il tomba dans le Néant.",shape=box,color=red];
		j323044768 -> j2891922535;
	j2847622506 [label="ensuite",shape=box,color=blue];
		j2847622506 -> j3009217624;
	j2891922535 [label="Et quand il a repris ses esprits, il était de retour dans son laboratoire, sauf que ce n'était plus son laboratoire. Et il se regardait. Sauf que ce n'était plus lui. Et \"il\" s'appelait d'un nom que seule sa mère connaissait.",shape=box,color=red];
		j2891922535 -> j3647779686;
	j3009217624 [label="****TU AS SES DOIGTS?!?!?!****",shape=box,color=blue];
		j3009217624 -> j3720075511;
	j3647779686 [label="Alors, Albrecht s'est enfui pour sauver sa vie. Il s'est tailladé sur le sériglas brisé et a écrit de son sang pour que sa fille referme la membrane derrière lui -",shape=box,color=red];
		j3647779686 -> j639403660;
	j3720075511 [label="ET TU L'UTILISES POUR ALIMENTER TON RAILJACK?!?!",shape=box,color=blue];
		j3720075511 -> j1782175637;
	j639403660 [label="- parce qu'il sentait que \"l'homme\" tendait la main vers lui.",shape=box,color=red];
		j639403660 -> j3081690173;
	j1782175637 [label="<RETRO_EMOJI_HORRIFIED>",shape=box,color=blue];
		j1782175637 -> j702692372;
	j3081690173 [label="Elle l'a fait. Et quand la membrane s'est fermée? Eh bien... les doigts étaient coupés, gisant sur le sol.",shape=box,color=red];
		j3081690173 -> j2583079684;
	j702692372 [label="c'est peut-être pour ça que c'est fou!!!",shape=box,color=blue];
		j702692372 -> j3841079422;
		j702692372 -> j3334525224;
	j2583079684 [label="....ouah...",shape=box,color=blue];
		j2583079684 -> j1412870814;
