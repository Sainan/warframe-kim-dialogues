		j3449672641 -> j2522681198;
		j3449672641 -> j3410061545;
	j2522681198 [label="Même si nous savions où ils étaient, je ne sais pas si nous *devrions* les rendre.",shape=box,color=red];
		j2522681198 -> j2374021;
	j3410061545 [label="Je sais. Je n'aime pas ça non plus.",shape=box,color=red];
		j3410061545 -> j853169970;
	j2374021 [label="comment ça?",shape=box,color=blue];
		j2374021 -> j4143773967;
		j2374021 -> j3498345938;
	j853169970 [label="Mais malheureusement, le mal est fait. Albrecht a pris les doigts. Et maintenant, il n'y a plus de retour en arrière possible.",shape=box,color=red];
		j853169970 -> j2374021;
	j4143773967 [label="Il y a quelque chose à propos des \"Segments de Khra\". C'est super compliqué. Quelque chose... Je ne sais pas?",shape=box,color=red];
		j4143773967 -> j1101773371;
	j3498345938 [label="Je ne sais pas si les rendre servirait à quelque chose. Je ne pense pas que ça le ferait changer d'avis.",shape=box,color=red];
		j3498345938 -> j1134295752;
	j1101773371 [label="Le maintenir ici? Le garder sur notre terrain? Nous avons ses doigts, alors il est obligé de jouer selon nos règles.",shape=box,color=red];
		j1101773371 -> j3825787938;
	j1134295752 [label="Je pense que le mal est fait. ",shape=box,color=red];
		j1134295752 -> j3825787938;
	j3825787938 [label=".... je n'aime rien de tout ça",shape=box,color=blue];
		j3825787938 -> j2320013250;
	j2320013250 [label="les voyages dans l'espace étaient censés être... amusants, cool, pleins d'exploration et de rencontres avec de nouvelles espèces",shape=box,color=blue];
		j2320013250 -> j4070129348;
	j4070129348 [label="aller bravement quelque part, je sais pas, amir a un discours entier tiré d'une de ses émissions",shape=box,color=blue];
		j4070129348 -> j2404690959;
	j2404690959 [label="mais c'était censé être à propos de... l'humanité, l'empathie, l'apprentissage et l'aventure",shape=box,color=blue];
		j2404690959 -> j356470271;
	j356470271 [label="pas... ça",shape=box,color=blue];
		j356470271 -> j317751587;
		j356470271 -> j2877658892;
	j317751587 [label="On ne sait jamais, j'imagine. Seul le temps nous le dira.",shape=box,color=red];
		j317751587 -> j467267519;
	j2877658892 [label="Parfois, je me demande si ce n'est pas ce qu'Entrati voulait faire en me renvoyant ici. Avec vous tous.",shape=box,color=red];
		j2877658892 -> j1427724268;
	j467267519 [label="<RETRO_EMOJI_GIVELOVE>",shape=box,color=blue];
		j467267519 -> j13902147;
