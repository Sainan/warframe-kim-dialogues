	j3126058743 [label="Eh bien, cela dépend s'il s'agit du grand ou du petit vaisseau, mais tous deux utilisent le Néant pour franchir les grandes distances. Ils traversent le Néant.",shape=box,color=red];
		j3126058743 -> j3549175698;
