digraph {
	2825 [label="AoiRank4Convo6 begins.",color=orange];
		2825 -> 2826;
	2826 [label="tu m'as raconté tellement d'histoires horribles sur les Orokins... y a-t-il déjà eu quelqu'un qui a tourné le dos à son mode de vie?",shape=box,color=blue];
		2826 -> 2827;
		2826 -> 2828;
	2827 [label="Crois-le ou non, le docteur Albrecht Entrati.",shape=box,color=red];
		2827 -> 2829;
	2828 [label="La plupart d'entre eux ont fini exécutés. Mais Albrecht Entrati, l'a fait, à sa manière.",shape=box,color=red];
		2828 -> 2830;
	2829 [label="beurk.",shape=box,color=blue];
		2829 -> 2831;
	2830 [label="euh, ce type, toujours en train de glisser entre les mains de la mort.",shape=box,color=blue];
		2830 -> 2831;
	2831 [label="et j'espérais que ce serait quelqu'un de... plus cool.",shape=box,color=blue];
		2831 -> 2835;
		2831 -> 2834;
	2835 [label="Pardon pour la déception. C'est ton homme. Il a refusé le Kuva, qui leur permettait d'être immortels. Il n'a pas opté pour le bras long à la mode. Rien de tout ça.",shape=box,color=red];
		2835 -> 2833;
	2834 [label="Ouais, euh... Je vais penser à un Orokin cool. Donne-moi une minute.",shape=box,color=red];
		2834 -> 2832;
	2833 [label="juste pour courir après ceux qui lui sont le plus utiles, j'en suis certaine.",shape=box,color=blue];
		2833 -> 2836;
		2833 -> 2837;
	2832 [label="et bien, il y a toi, je suppose ^_^",shape=box,color=blue];
		2832 -> 2836;
		2832 -> 2837;
		2832 -> 2838;
	2836 [label="As-tu jamais respecté Entrati?",shape=box,color=red];
		2836 -> 2839;
	2837 [label="Qu'est-ce que tu penses vraiment d’Entrati? Au-delà du verdict \"pas cool\".",shape=box,color=red];
		2837 -> 2840;
	2838 [label="Hah. Je ne suis pas un Orokin. Je viens juste de leur empire. C'est très différent.",shape=box,color=red];
		2838 -> 2841;
	2839 [label="mmmh. on sort les grandes questions maintenant, hein? tu l'as mérité je pense.",shape=box,color=blue];
		2839 -> 2843;
	2840 [label="j'ai plus du tout de respect pour ce gars ^_^",shape=box,color=blue];
		2840 -> 2843;
	2841 [label="Ooooh. ça prête à confusion",shape=box,color=blue];
		2841 -> 2842;
	2843 [label="les gens comme lui ne font semblant d'être charmants que lorsque ça les arrange",shape=box,color=blue];
		2843 -> 2844;
		2843 -> 2845;
	2842 [label="j'ai jamais vraiment aimé Entrati, cela dit. les gens comme lui ne font semblant d'être charmants que lorsque ça les arrange",shape=box,color=blue];
		2842 -> 2844;
		2842 -> 2845;
	2844 [label="Tu penses qu'il recherche quoi exactement?",shape=box,color=red];
		2844 -> 2846;
	2845 [label="Du coup ça veut dire que tu l'as trouvé charmant à un moment donné.",shape=box,color=red];
		2845 -> 2847;
	2846 [label="le contrôle. une domination complète.",shape=box,color=blue];
		2846 -> 2848;
	2847 [label="j'irais pas aussi loin. c'était plutôt une inclinaison à le respecter.",shape=box,color=blue];
		2847 -> 2849;
	2848 [label="et pas dans le style amusant d'une tournée mondiale de pop star.",shape=box,color=blue];
		2848 -> 2850;
	2849 [label="mais il a tout flanqué par terre.",shape=box,color=blue];
		2849 -> 2850;
	2850 [label="il dévore tout ce qu'il touche. même l'univers entier ne lui suffirait pas.",shape=box,color=blue];
		2850 -> 2851;
		2850 -> 2852;
		2850 -> 2853;
	2851 [label="Et tu le savais depuis le début? Tu es la plus intuitive de tout l'Hexagone. Si quelqu'un a eu ce pressentiment, ce ne peut être que toi.",shape=box,color=red];
		2851 -> 2854;
	2852 [label="Je suis plutôt d'accord avec toi.",shape=box,color=red];
		2852 -> 2854;
	2853 [label="Je ne sais pas. Il y a énormément d'univers là-bas :P",shape=box,color=red];
		2853 -> 2856;
	2854 [label="+5 Chemistry",color=orange];
		2854 -> 2855;
	2856 [label="mais il essaierait et c'est ça le problème",shape=box,color=blue];
		2856 -> 2857;
	2855 [label="merci ^_^",shape=box,color=blue];
		2855 -> 2857;
	2857 [label="pas tout de suite, mais assez tôt, j'ai eu ce sentiment désagréable que quelque chose de mal était sur le point de se produire à chaque fois qu'il était gentil",shape=box,color=blue];
		2857 -> 2858;
	2858 [label="et à l'époque, je n'avais pas les mots pour le décrire, mais j'avais toujours l'impression qu'il serait celui qui serait derrière tout ce qui n'allait pas.",shape=box,color=blue];
		2858 -> 2859;
	2859 [label="mais quand il a trompé tout le monde autour de toi, qu'est-ce tu peux vraiment faire au final?",shape=box,color=blue];
		2859 -> 2860;
		2859 -> 2861;
	2860 [label="Tu penses qu'il a réussi à tromper tout le monde?",shape=box,color=red];
		2860 -> 2862;
	2861 [label="J'imagine que tu attends qu'ils le voient par eux-mêmes.",shape=box,color=red];
		2861 -> 2863;
	2862 [label="Eh bien, peut-être pas",shape=box,color=blue];
		2862 -> 2864;
	2863 [label="ouais",shape=box,color=blue];
		2863 -> 2865;
	2864 [label="c'était juste que tout le monde avait trop peur pour le défier",shape=box,color=blue];
		2864 -> 2866;
	2865 [label="c'est un peu ma malédiction, je suis instinctivement gentille",shape=box,color=blue];
		2865 -> 2867;
	2866 [label="ce qui m'agace au plus haut point.",shape=box,color=blue];
		2866 -> 2868;
		2866 -> 2869;
	2867 [label="peut-être que si j'avais dit quelque chose, plus de gens l'auraient vu plus tôt.",shape=box,color=blue];
		2867 -> 2868;
		2867 -> 2869;
	2868 [label="Si cela peut te réconforter, il a également eu le même effet là d’où je viens.",shape=box,color=red];
		2868 -> 2870;
	2869 [label="Tu n'es pas la seule. Il a laissé sa marque sur tout le monde.",shape=box,color=red];
		2869 -> 2871;
	2870 [label="c'est... doux-amer, je suppose.",shape=box,color=blue];
		2870 -> 2872;
		2870 -> 2873;
	2871 [label="arf, même le futur n'est pas à l'abri de ce type.",shape=box,color=blue];
		2871 -> 2872;
		2871 -> 2873;
	2872 [label="Il a laissé derrière lui une fille qui essaie encore de réparer les morceaux qu'il a brisés. Même si elle est en colère, j'ai l'impression qu'elle ne peut s'empêcher de croire en lui.",shape=box,color=red];
		2872 -> 2874;
	2873 [label="Ouais. Il a laissé derrière lui son amant pour réparer les dégâts qu'il a causés à d'innombrables personnes... et animaux.",shape=box,color=red];
		2873 -> 2874;
	2874 [label="c'est bien lui. c'est ce qu'il fait.",shape=box,color=blue];
		2874 -> 2875;
	2875 [label="c'est le seul être vraiment vide que j'ai jamais connu.",shape=box,color=blue];
		2875 -> 2876;
	2876 [label="quand il trouve quelque chose qu'il veut, il le consomme entièrement, puis le jette une fois utilisé, toujours de la manière la plus insensible et la plus égoïste.",shape=box,color=blue];
		2876 -> 2877;
		2876 -> 2879;
		2876 -> 2882;
	2877 [label="Ouais, \"pas cool\" semble ressembler à un euphémisme là.",shape=box,color=red];
		2877 -> 2883;
	2879 [label="Bon sang. Hé, ne te retiens pas.",shape=box,color=red];
		2879 -> 2880;
	2882 [label="Je doute que même les gens qui l’aiment puissent nier tout ça.",shape=box,color=red];
		2882 -> 2881;
	2883 [label="+5 Chemistry",color=orange];
		2883 -> 2878;
	2880 [label="je ne peux pas nier que le simple fait d'y penser m'énerve assez...",shape=box,color=blue];
		2880 -> 2884;
		2880 -> 2885;
		2880 -> 2886;
	2881 [label="transmets mes salutations à tous ceux qu'il a blessés dans le futur.",shape=box,color=blue];
		2881 -> 2884;
		2881 -> 2885;
		2881 -> 2886;
	2878 [label="LOL j'ai jamais rencontré quelqu'un de moins cool que lui!",shape=box,color=blue];
		2878 -> 2884;
		2878 -> 2885;
		2878 -> 2886;
	2884 [label="Pardon si j'ai fait remonter quelques souvenirs sombres.",shape=box,color=red];
		2884 -> 2887;
	2885 [label="On a plus besoin de parler de lui.",shape=box,color=red];
		2885 -> 2887;
	2886 [label="Tu sais que c'est sérieux quand Aoi commence à utiliser des points et arrête d'utiliser des émoticônes.",shape=box,color=red];
		2886 -> 2888;
	2887 [label="non, c'est bon...",shape=box,color=blue];
		2887 -> 2889;
	2888 [label="lol tu me connais tellement bien que c'est effrayant",shape=box,color=blue];
		2888 -> 2889;
	2889 [label="regarde, quand je pense au docteur, je me souviens de la première fois où j'ai vu la peur dans les yeux d'Arthur",shape=box,color=blue];
		2889 -> 2890;
	2890 [label="Je pense à Amir en panique totale, à Eleanor incapable de parler, à Quincy endurcissant son cœur et à Lettie trop bouleversée pour sauver les gens autour d'elle.",shape=box,color=blue];
		2890 -> 2891;
	2891 [label="et je sais que le dokteur sourirait en entendant ça...",shape=box,color=blue];
		2891 -> 2892;
	2892 [label="mais il y a aussi de bonnes choses",shape=box,color=blue];
		2892 -> 2893;
		2892 -> 2894;
	2893 [label="Après une liste comme celle-là, il est difficile d’imaginer quelles pourraient être ces bonnes choses.",shape=box,color=red];
		2893 -> 2896;
	2894 [label="Est-ce que tu comptes vos pouvoirs parmi ces bonnes choses?",shape=box,color=red];
		2894 -> 2895;
	2896 [label="j'ai une collection de grues en métal qui pourraient un jour exaucer mon souhait",shape=box,color=blue];
		2896 -> 2897;
	2895 [label="tu sais quoi? je pense que oui.",shape=box,color=blue];
		2895 -> 2896;
	2897 [label="et chaque jour, je vois de petits actes de défi dans un vieux centre commercial oublié de Höllvanie qui me rappellent que l'esprit humain ne peut pas être brisé",shape=box,color=blue];
		2897 -> 2898;
	2898 [label="et bien sûr, notre rencontre",shape=box,color=blue];
		2898 -> 2899;
		2898 -> 2900;
		2898 -> 2901;
	2899 [label="Hmm. Au moins ton point de vue à lui seul prouve que l'esprit humain ne peut vraiment pas être brisé.",shape=box,color=red];
		2899 -> 2902;
	2900 [label="Tu as raison, ce sont de bonnes choses.",shape=box,color=red];
		2900 -> 2904;
	2901 [label="Cette liste semble assez faible comparée à celle d’Albrecht Entrati, Dévoreur des Mondes.",shape=box,color=red];
		2901 -> 2904;
	2902 [label="+5 Chemistry",color=orange];
		2902 -> 2903;
	2904 [label="tant qu'il y aura des gens qui se soucient les uns des autres, les gens comme Entrati ne dévoreront pas tout",shape=box,color=blue];
