		2271 -> 2273;
	2343 [label="Une version de moi de cette chronologie qui n'a pas vieilli parce qu'ils étaient coincés dans une capsule de stase sur Lua, que le Lotus, qui me sauvera plus tard, a mise dans le Néant pendant un moment, pour garder tout le monde en sécurité--",shape=box,color=red];
		2343 -> 2345;
	2344 [label="Oh, je vois. Ouais. Donc, techniquement, je viens d'une chronologie alternative. L'autre version de moi n'a pas autant vieilli, parce que... tu sais? C'est une longue histoire.",shape=box,color=red];
		2344 -> 3059;
	2365 [label="Quand j'étais à Duviri, j'étais... dans un piège. Celui de l'apathie. J'avais oublié qui j'étais. Pourquoi j'étais là.",shape=box,color=red];
		2365 -> 2367;
	2366 [label="Parfois, lorsque t'as atteint le fond dans ta vie... t'as juste besoin d'un coup de main.",shape=box,color=red];
		2366 -> 2368;
	2285 [label="Tu sais comment je peux utiliser la Transférence pour te guider? Je peux aussi utiliser ça sur un Orowyrm. C'est *vraiment* bizarre.",shape=box,color=red];
		2285 -> 2287;
	2286 [label="Ils peuvent l'être, quand ils n'essaient pas de te tuer.",shape=box,color=red];
