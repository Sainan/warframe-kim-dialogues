		2340 -> 2342;
	2267 [label="Heh. Bon, eh bien, tu te souviens de ces vrais dragons dont je t'ai parlé? C'est là qu'ils étaient.",shape=box,color=red];
		2267 -> 2270;
	2269 [label="Duviri peut être magnifique mais également.. dangereux, comme tous les mondes de contes de fées. Rempli de monstres et de leçons à apprendre.",shape=box,color=red];
		2269 -> 2272;
