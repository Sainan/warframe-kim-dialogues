		917 -> 929 [label="false",color=purple];
	918 [label="Mi è stato solo detto dell'Infestazione, ne so poco... ma ti credo. E se quello che sento è la verità, e prego che lo sia, non credo che lei sia intrappolata.",shape=box,color=blue];
		918 -> 933;
	919 [label="È molto carino da parte tua dirlo. Se quello che sento è la verità, e prego che lo sia, allora oui, penso che tu abbia ragione. Non credo che sia intrappolata.",shape=box,color=blue];
		919 -> 933;
	920 [label="Se ciò che sento è la verità, e prego che lo sia, allora no, non credo che lei sia intrappolata.",shape=box,color=blue];
		920 -> 933;
	921 [label="Se quello che sento è la verità, e prego che lo sia, allora sì, hai ragione. E loro restano per aiutarci. Non credo che sia intrappolata.",shape=box,color=blue];
		921 -> 933;
	922 [label="Oui, sono stata benedetta da le Cardinal... ma so che il mio amore per lui è quasi unico, perché non è macchiato dal dolore, dall'odio o dal risentimento.",shape=box,color=blue];
		922 -> 934;
	925 [label="So che pensi che sia una specie di mostro terribile. Ma devo chiederti: cosa ti ha portato a diffidare così tanto di lui ?",shape=box,color=blue];
		925 -> 937;
		925 -> 939;
		925 -> 938;
	923 [label="Pensavo gli credessi ? Perché questo improvviso cambiamento di cuore ? Sei così volubile ? ",shape=box,color=blue];
		923 -> 935;
		923 -> 936;
	924 [label="Perché non ti fidi di lui ?",shape=box,color=blue];
		924 -> 937;
		924 -> 938;
		924 -> 939;
	928 [label="Oui, e cambi idea così in fretta ? Menti. A quale scopo, non lo so. Et je ne veux pas le savoir.",shape=box,color=blue];
