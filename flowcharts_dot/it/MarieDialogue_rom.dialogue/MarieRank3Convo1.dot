		897 -> 902;
		897 -> 903;
		897 -> 904;
	896 [label="Oui, bien sûr ! Nessuno vuole essere rimproverato, men che meno da una Suora. Capisco. Merci, non avrei voluto fare la figura della sciocca.",shape=box,color=blue];
		896 -> 868;
		896 -> 867;
		896 -> 900;
	898 [label="Sì, è vero. Ora sono un'arma, come ben sanno i Murmure! Ma cerco di seguire il cammino che le Cardinal mi ha indicato, per quanto benedetto sia.",shape=box,color=blue];
		898 -> 905;
		898 -> 906;
	899 [label="Come le Carinal. Era Orokin, non ? E di certo non è uno che condannerei. Senza di lui, non sarei come sono ora. Benedetta.",shape=box,color=blue];
		899 -> 907;
		899 -> 908;
	901 [label="I Warframe... non sono stati creati con la gentilezza più assoluta. Spero solo che non sia intrappollata nell'Infestazione.",shape=box,color=red];
		901 -> 910;
	902 [label="Penso che chiunque fosse Wisp, sarebbe felice di conoscerti.",shape=box,color=red];
		902 -> 911;
	903 [label="Spero che le loro anime siano riuscite ad andare avanti e a trovare pace, ma credo che una parte della loro memoria rimanga.",shape=box,color=red];
		903 -> 912;
	904 [label="Assolutamente no. Credo che una parte delle persone trasformate in Warframe rimangano all'interno dei loro schemi base.",shape=box,color=red];
		904 -> 913;
	900 [label="[Fine.]",shape=box,color=red];
		900 -> 909;
	905 [label="Ci sono molte cose su cui potrei discutere con lui, ma devo dire che sembra avere un buon istinto nel decidere a chi somministrare il siero protoframe. Anche se non so perché lo faccia.",shape=box,color=red];
		905 -> 914;
	906 [label="Vorrei che non ti fidassi di Entrati così tanto. Non sappiamo perché sceglie di fare quello che fa, e le sue motivazioni non sono chiare.",shape=box,color=red];
		906 -> 915;
	907 [label="Dobbiamo rimanere con Entrati. Credo che dobbiamo semplicemente seguirlo ovunque vada. È la nostra unica possibilità di fermare l'Indifferenza.",shape=box,color=red];
		907 -> 916;
