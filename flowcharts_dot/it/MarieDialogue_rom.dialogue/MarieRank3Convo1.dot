		876 -> 882;
	877 [label="Un po' entrambe le cose. Erano... in parte armi, in parte opere d'arte, per il loro creatore principale.",shape=box,color=red];
		877 -> 883;
	881 [label="Vraiment? Perché ho la sensazione di conoscerla come se fosse mia sorella - una del mio stesso sangue, non una della Cathédrale.",shape=box,color=blue];
