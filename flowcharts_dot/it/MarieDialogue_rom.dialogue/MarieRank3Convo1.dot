		960 -> 972 [label="false",color=purple];
		960 -> 970 [label="false",color=purple];
	961 [label="Oui, hai ragione. Credo che il senso di colpa lo perseguiti per tutto quello che ha fatto. Credo che prenda le distanza dagli altri in modo molto intenzionale.",shape=box,color=blue];
		961 -> 973;
	962 [label="Oui, è una sofferenza terribile, un dolore atroce. Sapere che qualcuno è... ancora vivo, e apparentemente sceglie di non starti accanto ?",shape=box,color=blue];
		962 -> 973;
	964 [label="Mon cœur se brise dans la tragédie - Non credo di poter sopportare la tristezza di ciò... e anche così, lei non lo perdona ?",shape=box,color=blue];
		964 -> 975;
		964 -> 976;
	965 [label="Sai perché se n'è andato ?",shape=box,color=blue];
		965 -> 975;
		965 -> 977;
	966 [label="Cosa intendi ? ",shape=box,color=blue];
		966 -> 978;
		966 -> 979;
	968 [label="Infatti se le voci tra i Cavia sono vere, vous y avez vraiment trouvé beaucoup de joie, non ?",shape=box,color=blue];
		968 -> 967;
	967 [label="Non, le Cardinal ha fatto di peggio a molti altri, sei semplicemente arrabbiato per l'inconveniente che ti ha causato.",shape=box,color=blue];
		967 -> 917;
	963 [label="Update boolean MarieNoDate",color=orange];
		963 -> 974;
	969 [label="Vorrei solo... che riuscissimo a far sì che tutti quelli che circondano Entrati smettessero di incolpare se stessi e gli altri per quello che è successo.",shape=box,color=red];
		969 -> 980;
	971 [label="Non so se lo definirei mai benedetto.",shape=box,color=red];
		971 -> 982;
	972 [label="Sarebbe molto più facile perdonare Entrati per le sue malefatte se potessi capirle.",shape=box,color=red];
		972 -> 983;
	970 [label="Farò ciò di cui ha bisogno per risolvere questo problema. E poi lo giudicherò, quando tutto sarà detto e fatto.",shape=box,color=red];
		970 -> 981;
	973 [label="Il inflige la douleur dans le cœur des autres, car la douleur vaut mieux que rien du tout. Perché la sofferenza è meglio del vuoto, non ?",shape=box,color=blue];
		973 -> 984;
	975 [label="Quando non si spiega, temo che tutto ciò che possiamo fare è inventarci le nostre ragioni.",shape=box,color=red];
		975 -> 985;
	976 [label="Non hai colto il punto. Mi ha lasciato lì. Ha visto qualcuno abbandonato nel Void, e mi ha lasciato lì.",shape=box,color=red];
		976 -> 986;
	977 [label="No. So solo che mi ha lasciato lì. Ha visto qualcuno abbandonato nel Void e... mi ha lasciato lì.",shape=box,color=red];
		977 -> 985;
	978 [label="Mi ha lasciato lì. È arrivato, a un certo punto non lo so - e visto qualcuno abbandonato nel Void, e... mi ha lasciato lì.",shape=box,color=red];
		978 -> 986;
	979 [label="Alla fine, l'Indifferenza è arrivata comunque per attaccare Duviri. (Sebbene abbia ricevuto un aiuto inaspettato. Ma questo non centra.)",shape=box,color=red];
		979 -> 987;
	974 [label="Chat ends.",color=orange];
	980 [label="Update boolean MarieEntratiFamily",color=orange];
		980 -> 988;
	982 [label="Allora potremmo continuare a concordare sul non essere d'accordo, credo.",shape=box,color=blue];
		982 -> 990;
	983 [label="Prego che alla fine lo faremo. Prego che alla fine sopravvivremo tutti. Ma per ora, vedo la famille intorno a me e prego che trovino il perdono nei loro cuori. Per la loro felicità.",shape=box,color=blue];
		983 -> 991;
	981 [label="+10 Chemistry",color=orange];
		981 -> 989;
	984 [label="Questa è una lezione che il mio carissimo Lyon conosce meglio di chiunque altro... Sono così felice che abbia cominciato a parlarti. Ma oggi parliamo de le Cardinal.",shape=box,color=blue];
		984 -> 992;
	985 [label="Posso solo supporre che ciò sia accaduto prima... dell'omicidio ad infinitum.",shape=box,color=red];
		985 -> 993;
	986 [label="E non sai perché ti ha lasciato lì ?",shape=box,color=blue];
		986 -> 994;
		986 -> 985;
		986 -> 995;
	987 [label="Non. Aspetta. L'Indifférence ha... un alleato ?",shape=box,color=blue];
		987 -> 996;
		987 -> 997;
	988 [label="Add 1 to Family",color=orange];
		988 -> 998;
	990 [label="Update boolean MarieEntratiMonster2",color=orange];
		990 -> 1000;
	991 [label="Update boolean MarieEntratiFan2",color=orange];
		991 -> 1000;
	989 [label="Oui, c'est raisonnable, e del tutto giusto, considerando tutto ciò che hai visto e sai. Non posso chiederti di più.",shape=box,color=blue];
		989 -> 999;
	992 [label="Update boolean MarieLyonSuffering3",color=orange];
		992 -> 917;
	993 [label="Allora devo chiederti di non aspettarti il peggio da lui, perché questo ti potrebbe amareggiare il cuore. ",shape=box,color=blue];
		993 -> 1001;
	994 [label="Posso solo sperare che avesse una buona ragione.",shape=box,color=red];
		994 -> 1002;
	995 [label="No, e non importa. Avrebbe potuto salvarmi. E non l'ha fatto.",shape=box,color=red];
		995 -> 1003;
	996 [label="Ha solo un'altra faccia.",shape=box,color=red];
		996 -> 1004;
	997 [label="Forse? O un ostaggio. O semplicemente indossa la sua faccia. Non lo sappiamo con certezza.",shape=box,color=red];
		997 -> 1004;
	998 [label="+10 Chemistry",color=orange];
		998 -> 1005;
	1000 [label="Ah, mi sta chiamando Lyon. À la revoyure !",shape=box,color=blue];
		1000 -> 1006;
	999 [label="Update boolean MarieEntratiNeutral",color=orange];
		999 -> 1000;
	1001 [label="Forse non desideravi ancora abbandonare Duviri. Forse la situazione non era ancora peggiorata per te. Forse non eri disposto a lasciare i tuoi amici ?",shape=box,color=blue];
		1001 -> 1007;
	1002 [label="+5 Chemistry",color=orange];
		1002 -> 1008;
	1003 [label="Puoi dire che non c'è modo, in nessun ambito, di trovare una ragione per cui lui potrebbe averti lasciato ? ",shape=box,color=blue];
		1003 -> 1001;
