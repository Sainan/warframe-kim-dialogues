		927 -> 940;
	930 [label="Per coloro che seguono il cammino di Sol, dobbiamo sempre essere la luce guida per coloro che devono scegliere il cammino, non ? ",shape=box,color=blue];
		930 -> 942;
	932 [label="Tu sei un seguace di Lua, dovresti sapere che insegniamo che alcuni camminano da soli nell'ombra, oui ?",shape=box,color=blue];
		932 -> 942;
	931 [label="Tu sei un seguace dei Luminari, dovresti sapere che insegniamo che alcuni percorrono da soli le strade sconosciute, oui ?",shape=box,color=blue];
		931 -> 942;
	929 [label="Nella mia fede, conosciamo coloro che percorrono le strade della vita e si ritrovano al bivio in cui Lua e Sol si incontrano. ",shape=box,color=blue];
		929 -> 942;
	933 [label="Di lei, sento solo il calore del sorriso di Sol. Le Cardinal è stato saggio, credo, nella sua scelta. Sono onorata di portarla nelle mie vene.",shape=box,color=blue];
		933 -> 908;
		933 -> 907;
		933 -> 905;
		933 -> 906;
	934 [label="Lo perdono per averci abbandonati. Non credo che lo faccia nessun altro...",shape=box,color=blue];
		934 -> 943;
		934 -> 944;
		934 -> 937;
		934 -> 938;
	937 [label="Lui... è venuto a Duviri. Molto tempo fa...",shape=box,color=red];
		937 -> 947;
	939 [label="Beh, per cominciare, mi ha sparato al petto e mi ha lasciato morire.",shape=box,color=red];
		939 -> 948;
	938 [label="Non lascia altro che dolore, morte, e abbandono al suo passaggio.",shape=box,color=red];
		938 -> 917;
	935 [label="Non mi sono mai fidato di lui, semplicemente non volevo spaventarti.",shape=box,color=red];
		935 -> 945;
	936 [label="Non volevo mentire prima, semplicemente non sapevo come affrontare l'argomento. È chiavo che lo adori...",shape=box,color=red];
		936 -> 946;
	941 [label="Update boolean MarieNoDate",color=orange];
		941 -> 950;
	940 [label="Sì, dobbiamo rimanere forti ! Braves contre les ténèbres, pour toujours et à jamais !",shape=box,color=blue];
		940 -> 949;
	942 [label="Update boolean DrifterCrossroads",color=orange];
		942 -> 951;
	943 [label="Ha ferito e abbandonato molte persone, hai ragione. E credo che si senta in dovere di farlo.",shape=box,color=red];
		943 -> 952;
	944 [label="È dura quando qualcuno che significa così tanto per te, che ami e su cui fai affidamento, se ne va. Soprattutto se non sai perché. O se non torna.",shape=box,color=red];
		944 -> 953;
	947 [label="Sol ! Questo mondo che hai creato, evocato dal libro scritto da sua figlia, oui ? Monsieur Loid ne ha parlato... Le Cardinale era lì ? Perché ? ",shape=box,color=blue];
		947 -> 956;
		947 -> 957;
		947 -> 958;
	948 [label="Et pourtant, vous êtes toujours en vie ! Sei vivo, non è vero ? E stai bene? Stai prosperando, se dobbiamo credere ai racconti di Monsieur Loid sulle tue avventure nel passato e nel futuro.",shape=box,color=blue];
		948 -> 959;
	945 [label="Ah, je vois ! Je suis une idiote, c'est ça ?! Juste une petite invalide venue d'un passé lointain, incapable de penser par elle-même ?! Mieux vaut l'approcher comme un faon dans les bois, de peur de l'effrayer !",shape=box,color=blue];
		945 -> 954;
	946 [label="Ah, oui... Non ti ho resto facile la verità, n'est-ce pas ?",shape=box,color=blue];
		946 -> 955;
	950 [label="Chat ends.",color=orange];
	949 [label="L'ho perdonato per averci abbandonati. Non credo che lo faccia nessun altro...",shape=box,color=blue];
		949 -> 943;
		949 -> 944;
	951 [label="Le Cardinal deve ritrovare la strada per tornare da noi. Possiamo solo fare il possibile per aiutarlo quando ci chiamerà, e fare ciò che ci viene ordinato da coloro che sono benedetti come lui.",shape=box,color=blue];
		951 -> 960;
	952 [label="+5 Chemistry",color=orange];
		952 -> 961;
	953 [label="+5 Chemistry",color=orange];
		953 -> 962;
	956 [label="Penso che all'inizio una parte di lui cercasse un po' della figlia che si era lasciato alle spalle. Ma invece, trovò un modo per combattere l'Indifferenza - con le emozioni da cui cercava di prendere le distanze.",shape=box,color=red];
		956 -> 964;
	957 [label="I suoi appunti raccontano una storia molto odiosa e centrata sull'auto-adulazione su come abbia iniziato a studiare l'incarnazione concettuale e invece ne sia uscito imparando il valore di combattere l'Indifferenza.",shape=box,color=red];
		957 -> 965;
	958 [label="Se dobbiamo credere ai suoi appunti, era lì per insegnare a Duviri - e per estensione a me, come difendersi dall'Indifferenza. Per quello che alla fine ha portato di buono.",shape=box,color=red];
		958 -> 966;
