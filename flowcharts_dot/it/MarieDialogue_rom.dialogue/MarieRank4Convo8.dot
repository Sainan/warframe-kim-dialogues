	1596 [label="Update boolean MarieOtak1",color=orange];
		1596 -> 2945;
	1603 [label="Oui, molto saggio. Sto solo pensando ad alta voce e ti chiedo cosa siano. Hai perfettamente ragione, non c'è mai niente di male nel mostrare gentilezza e rispetto.",shape=box,color=blue];
		1603 -> 1610;
	1604 [label="Forse hai ragione. E spero proprio di sì ! Qualunque sia la situazione, dobbiamo essere gentili - perché sono creature pensanti. E ciò che può pensare, può sentire.",shape=box,color=blue];
