		j1450120723 -> j656217081;
	j3879013949 [label="Boolean MarieCephalonUnsure is now false.",color=orange];
		j3879013949 -> j2909954738;
	j809801362 [label="Un'ulteriore prova che il diavolo e i suoi simili avevano ragione a essere condannati. Ma forse hai ragione riguardo a Otak e ai suoi simili, o forse crederci ti dà pace.",shape=box,color=blue];
		j809801362 -> j2844895213;
	j2844895213 [label="E potrei sbagliarmi alla fine. Non c'è mai niente di male nel mostrare gentilezza e rispetto.",shape=box,color=blue];
		j2844895213 -> j3167649564;
	j3493454453 [label="Forse hai ragione, ma non credo che i diavoli Orokin conoscessero il funzionamento dell'anima meglio di noi. Non erano grandi dei.",shape=box,color=blue];
		j3493454453 -> j2844895213;
	j309327393 [label="Forse hai ragione, o forse crederci ti dà pace.",shape=box,color=blue];
		j309327393 -> j2844895213;
	j3998308863 [label="Pauvre petit...",shape=box,color=blue];
		j3998308863 -> j3134774711;
	j324988185 [label="+5 Chemistry",color=orange];
		j324988185 -> j3773874425;
	j656217081 [label="+5 Chemistry",color=orange];
		j656217081 -> j1245632966;
	j2909954738 [label="+5 Chemistry",color=orange];
		j2909954738 -> j2508358053;
	j3167649564 [label="Tornerò a intrecciare una corona di fiori per Monsieur Necraloid. Lui si è lamentato, ma non voglio che mi venga detto non !",shape=box,color=blue];
		j3167649564 -> j1290225402;
		j3167649564 -> j3422115383;
		j3167649564 -> j1179040262;
	j3134774711 [label="Boolean MarieOtak1 is now true.",color=orange];
		j3134774711 -> j3951815689;
	j3773874425 [label="Oui, molto saggio. Sto solo pensando ad alta voce e ti chiedo cosa siano. Hai perfettamente ragione, non c'è mai niente di male nel mostrare gentilezza e rispetto.",shape=box,color=blue];
		j3773874425 -> j551586266;
	j1245632966 [label="Forse hai ragione. E spero proprio di sì ! Qualunque sia la situazione, dobbiamo essere gentili - perché sono creature pensanti. E ciò che può pensare, può sentire.",shape=box,color=blue];
		j1245632966 -> j551586266;
	j2508358053 [label="Qualunque sia la situazione, dobbiamo essere gentili - perché sono creature pensanti. E ciò che può pensare, può sentire.",shape=box,color=blue];
		j2508358053 -> j2844895213;
	j1290225402 [label="Adorabile.",shape=box,color=red];
		j1290225402 -> j366938164;
