	1592 [label="Un'ulteriore prova che il diavolo e i suoi simili avevano ragione a essere condannati. Ma forse hai ragione riguardo a Otak e ai suoi simili, o forse crederci ti dà pace.",shape=box,color=blue];
		1592 -> 1593;
	1593 [label="E potrei sbagliarmi alla fine. Non c'è mai niente di male nel mostrare gentilezza e rispetto.",shape=box,color=blue];
		1593 -> 1600;
