		j3601198746 -> j3879013949;
	j1513697185 [label="+5 Chemistry",color=orange];
		j1513697185 -> j809801362;
	j213737293 [label="Oh, non pensare che io voglia che tu sia crudele ! Non ! Fanne tesoro, perché sono preziosi e non è per colpa loro che sono come sono !",shape=box,color=blue];
		j213737293 -> j2844895213;
	j1605397646 [label="+5 Chemistry",color=orange];
		j1605397646 -> j213737293;
	j1336365766 [label="+5 Chemistry",color=orange];
		j1336365766 -> j3493454453;
	j3588696929 [label="+5 Chemistry",color=orange];
		j3588696929 -> j309327393;
	j2088578733 [label="Non tutti i Cephalon furono creati per punizione. Ma le cose andarono... male qui su Deimos, e subì gravi danni.",shape=box,color=red];
		j2088578733 -> j3998308863;
	j2048725112 [label="Boolean MarieCephalonSoul is now false.",color=orange];
		j2048725112 -> j324988185;
