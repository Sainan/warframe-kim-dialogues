		1602 -> 1609;
	1614 [label="Merci ! À la revoyure !",shape=box,color=blue];
		1614 -> 1617;
	1615 [label="Oh ! È uno dei Diritti di Lua. Nell'anniversario della scomparsa di un'anima, si intreccia una corona o una ghirlanda di fiori e la si pone sul suo cranio o sulla sua tomba. ",shape=box,color=blue];
		1615 -> 1618;
	1616 [label="Merci, lo farò ! À la revoyure !",shape=box,color=blue];
		1616 -> 1617;
	1609 [label="Oui. Ma non è il suo silenzio a turbarmi, credo. Ho chiesto a Monsieur Necraloid se il teschio che lo adornava fosse appartenuto in qualche momento a un'anima vivente oppure no.",shape=box,color=blue];
		1609 -> 1936;
	1617 [label="Chat ends.",color=orange];
	1618 [label="Nelle cripte tradizionali per i defunti, spesso i corpi erano esposti, oui ? Quindi si poteva fare così. Credo che qualcosa sia sopravvissuto, ancora oggi.",shape=box,color=blue];
		1618 -> 1619;
	1619 [label="Lo vedo riflesso in alcune delle opere d'arte degli Orokin, con il loro amore per i teschi. ",shape=box,color=blue];
		1619 -> 1620;
		1619 -> 1621;
		1619 -> 1622;
	1620 [label="Questo spiega molte cose.",shape=box,color=red];
		1620 -> 1623;
	1621 [label="Le cose cambiano, eh?",shape=box,color=red];
		1621 -> 1623;
	1622 [label="Penso che Figlia ci abbia già provato, la farai ingelosire.",shape=box,color=red];
		1622 -> 1624;
	1623 [label="Oui ! È passato così tanto tempo, eppure l'influenza rimane. Mi rende felice sapere che anche piccoli frammenti sono rimasti.",shape=box,color=blue];
		1623 -> 1625;
	1624 [label="Oui ? Allora non vedo l'ora che arrivi il giorno in cui potrò incontrarla ! Le dirò che non gli ho dato tregua.",shape=box,color=blue];
		1624 -> 1625;
	1625 [label="Teschio finto o no, Monsieur Necraloid dovrebbe avere una corona. E si vergogna così tanto quando lo ammiro ! Credo che arrossirebbe se potesse. E questo mi fa sorridere.",shape=box,color=blue];
		1625 -> 1626;
	1626 [label="À la revoyure !",shape=box,color=blue];
