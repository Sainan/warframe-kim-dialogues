		1948 -> 1560 [label="false",color=purple];
	1949 [label="Oui ! Hai ragione, quello è il cuore della cosa - o il suo teschio - ah. Uno lo ritiene sacro, l'altro una copia.",shape=box,color=blue];
		1949 -> 1948;
	1947 [label="A detta di tutti era un genio e la mente dietro lo sfruttamento dei cristalli di argon.",shape=box,color=red];
		1947 -> 1556;
	1558 [label="Come può Monsieur Necraloid possedere un'anima, se non possiede le sue ossa ?",shape=box,color=blue];
		1558 -> 1562;
		1558 -> 1563;
		1558 -> 1564;
	1557 [label="Questa è un'ulteriore prova che Monsieur Necraloid non ha anima ?",shape=box,color=blue];
		1557 -> 1562;
		1557 -> 1563;
		1557 -> 1564;
	1559 [label="So che non sei sicuro che Monsieur Necraloid possa possedere un'anima. Ma non so come potrebbe, visto che non possiede le sue ossa.",shape=box,color=blue];
		1559 -> 1562;
		1559 -> 1563;
		1559 -> 1564;
	1560 [label="Sto parlando di un elaborato strumento tecnologico, fatto per assomigliare a un uomo, non ? Un fonografo, molto, molto più complesso.",shape=box,color=blue];
		1560 -> 1565;
		1560 -> 1566;
		1560 -> 1567;
		1560 -> 1568;
		1560 -> 1569;
	1556 [label="Che vengono sfruttati dal Void - sono il motivo per cui possiamo creare molti dei potenti warframe e armi che realizziamo.",shape=box,color=red];
		1556 -> 1561;
	1562 [label="Forse hai ragione. Forse sono solo copie di persone. Ma non ne sono sicuro, e comunque dobbiamo trattarli come se lo fossero umani.",shape=box,color=red];
		1562 -> 1571;
	1563 [label="Penso che Necraloid sia l'eccezione, non la regola. È stato creato come replica di una persona, non da una persona.",shape=box,color=red];
		1563 -> 1572;
	1564 [label="Hai ragione. Probabilmente sarebbe meglio, e più umano, se non fossero in realtà anime intrappolate in una scienza elaborata...",shape=box,color=red];
		1564 -> 1573;
	1565 [label="Necraloid potrebbe non avere un'anima, ma è unico. Altri Cephalon, come Otak, invece ce l'hanno. Sono stati distrutti nel modo in cui sono stati creati.",shape=box,color=red];
		1565 -> 1574;
	1566 [label="Hai ragione. Quindi cosa vorresti che facessi al riguardo?",shape=box,color=red];
		1566 -> 1575;
	1567 [label="Tu hai ragione. Loro no. Ma questo non significa che possiamo trattarli male.",shape=box,color=red];
		1567 -> 1576;
	1568 [label="Non so se hai ragione o no. Ma possono ancora pensare e provare sentimenti, e non possiamo trattarli come cose.",shape=box,color=red];
		1568 -> 1577;
	1569 [label="Necraloid ha un'anima. Tutti i Cephalon ce l'hanno.",shape=box,color=red];
		1569 -> 1578;
	1561 [label="Si specializzò in cristallografia. E i suoi lavori furono archiviati qui, nei laboratori.",shape=box,color=red];
		1561 -> 1570;
