		1925 -> 1926 [label=false,color=brown];
	1927 [label="Drifter, più mi trovo a convivere con la conoscenza di Monsieur Necraloid e Monsieur Otak, più mi sento turbata...",shape=box,color=blue];
		1927 -> 1930;
		1927 -> 1931;
	1926 [label="Drifter, posso parlarti ?",shape=box,color=blue];
		1926 -> 1928;
