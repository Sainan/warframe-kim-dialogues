	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo8 begins." [color=orange];
		"MarieRank4Convo8 begins." -> j2786051379;
	j2786051379 [label="Check boolean MarieOtak1",color=orange];
		j2786051379 -> j1936062085 [label=true,color=green];
		j2786051379 -> j3979466356 [label=false,color=brown];
	j1936062085 [label="Drifter, più mi trovo a convivere con la conoscenza di Monsieur Necraloid e Monsieur Otak, più mi sento turbata...",shape=box,color=blue];
		j1936062085 -> j3950478635;
		j1936062085 -> j1877230481;
	j3979466356 [label="Drifter, posso parlarti ?",shape=box,color=blue];
		j3979466356 -> j294962395;
		j3979466356 -> j4115718638;
	j3950478635 [label="Come mai?",shape=box,color=red];
		j3950478635 -> j2698360337;
	j1877230481 [label="Qual è il problema, esattamente?",shape=box,color=red];
		j1877230481 -> j2698360337;
	j294962395 [label="Certo. Dimmi.",shape=box,color=red];
		j294962395 -> j136031232;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j2698360337 [label="Ho chiesto a Monsieur Necraloid se il teschio che lo adornava fosse appartenuto in qualche momento a un'anima vivente oppure no.",shape=box,color=blue];
		j2698360337 -> j146773776;
	j136031232 [label="Mi incuriosisce il motivo per cui sulla sua schiena c'è un altro volto che assomiglia allo scarabocchio di un bambino.",shape=box,color=blue];
		j136031232 -> j3336614863;
	"Chat ends." [color=orange];
	j146773776 [label="E Monsieur Necraloid mi ha detto che era il \"suo\" cranio, pur ammettendo che Monsieur Loid era ''l'originale\". Monsieur Loid è intervenuto per dirmi che si trattava di una versione \"replicata\" del suo cranio.",shape=box,color=blue];
		j146773776 -> j2360561406;
	j3336614863 [label="Ho chiesto informazioni sia a Monsieur Necraloid che a Monsieur Loid, ma nessuno dei due ha voluto parlarne, mi hanno solo detto un nome: Otak. E lo hanno pronunciato con grande tristezza.",shape=box,color=blue];
		j3336614863 -> j108343737;
	j2360561406 [label="Come è possibile ? E cosa significa \"replicato\" ? È un teschio vero o è un falso ? Perché Monsieur Necraloid e Monsieur Loid avrebbero dato risposte diverse ?",shape=box,color=blue];
		j2360561406 -> j3529668140;
		j2360561406 -> j2585546320;
		j2360561406 -> j769587274;
	j108343737 [label="Quindi eccomi qui, a parlare con te, nella speranza che tu possa aiutarmi.",shape=box,color=blue];
		j108343737 -> j2096698251;
	j3529668140 [label="Immagino che dal punto di vista di Necraloid sia il suo teschio. È vero. Ma che dal punto di vista di Loid sia una replica.",shape=box,color=red];
		j3529668140 -> j1480396290;
	j2585546320 [label="Onestamente non so di cosa sia fatto. Potrebbe essere osso. O qualche tipo di polimero...",shape=box,color=red];
		j2585546320 -> j1859664140;
	j769587274 [label="Penso che la vera domanda sia: \"Necraloid è reale?\" e non \"il teschio è reale?\".",shape=box,color=red];
		j769587274 -> j4168357828;
	j2096698251 [label="Mi racconteresti la storia del povero Monsieur Otak ?",shape=box,color=blue];
		j2096698251 -> j1112636531;
	j1480396290 [label="Credo che sia questo a preoccuparmi. È il modo in cui i due signori ne considerano l'origine. Uno la ritiene sacra, l'altro una copia.",shape=box,color=blue];
		j1480396290 -> j3408858168;
	j1859664140 [label="Non so se è il materiale di cui è fatto il teschio a turbarmi così tanto. È la sua origine. O forse il modo in cui i due signori lo considerano. Uno lo ritiene sacro, l'altro una copia.",shape=box,color=blue];
		j1859664140 -> j3408858168;
	j4168357828 [label="+5 Chemistry",color=orange];
		j4168357828 -> j1057668977;
	j1112636531 [label="Otak era un Archimedeo, uno scienziato e accademico Orokin. Quello che gli è successo non è esattamente una storia felice.",shape=box,color=red];
		j1112636531 -> j464592865;
	j3408858168 [label="Evaluate expressions",color=orange];
		j3408858168 -> j1505424268 [label="MarieCephalonSoul",color=purple];
		j3408858168 -> j577410763 [label="MarieCephalonNoSoul",color=purple];
		j3408858168 -> j341906560 [label="MarieCephalonUnsure",color=purple];
		j3408858168 -> j2694965648 [label="false",color=purple];
	j1057668977 [label="Oui ! Hai ragione, quello è il cuore della cosa - o il suo teschio - ah. Uno lo ritiene sacro, l'altro una copia.",shape=box,color=blue];
		j1057668977 -> j3408858168;
	j464592865 [label="A detta di tutti era un genio e la mente dietro lo sfruttamento dei cristalli di argon.",shape=box,color=red];
		j464592865 -> j3583476993;
	j1505424268 [label="Come può Monsieur Necraloid possedere un'anima, se non possiede le sue ossa ?",shape=box,color=blue];
		j1505424268 -> j3713660262;
		j1505424268 -> j1748187995;
		j1505424268 -> j2023306907;
	j577410763 [label="Questa è un'ulteriore prova che Monsieur Necraloid non ha anima ?",shape=box,color=blue];
		j577410763 -> j3713660262;
		j577410763 -> j1748187995;
		j577410763 -> j2023306907;
	j341906560 [label="So che non sei sicuro che Monsieur Necraloid possa possedere un'anima. Ma non so come potrebbe, visto che non possiede le sue ossa.",shape=box,color=blue];
		j341906560 -> j3713660262;
		j341906560 -> j1748187995;
		j341906560 -> j2023306907;
	j2694965648 [label="Sto parlando di un elaborato strumento tecnologico, fatto per assomigliare a un uomo, non ? Un fonografo, molto, molto più complesso.",shape=box,color=blue];
		j2694965648 -> j715216045;
		j2694965648 -> j1269446798;
		j2694965648 -> j261506707;
		j2694965648 -> j2130579871;
		j2694965648 -> j2711300406;
	j3583476993 [label="Che vengono sfruttati dal Void - sono il motivo per cui possiamo creare molti dei potenti Warframe e armi che abbiamo.",shape=box,color=red];
		j3583476993 -> j2474027025;
	j3713660262 [label="Forse hai ragione. Forse sono solo copie di persone. Ma non ne sono sicuro, e comunque dobbiamo trattarli come se lo fossero umani.",shape=box,color=red];
		j3713660262 -> j3472411092;
	j1748187995 [label="Penso che Necraloid sia l'eccezione, non la regola. È stato creato come replica di una persona, non da una persona.",shape=box,color=red];
		j1748187995 -> j2390315715;
	j2023306907 [label="Hai ragione. Probabilmente sarebbe meglio, e più umano, se non fossero in realtà anime intrappolate in una scienza elaborata...",shape=box,color=red];
		j2023306907 -> j1896310204;
	j715216045 [label="Necraloid potrebbe non avere un'anima, ma è unico. Altri Cephalon, come Otak, invece ce l'hanno. Sono stati distrutti nel modo in cui sono stati creati.",shape=box,color=red];
		j715216045 -> j3306479729;
	j1269446798 [label="Hai ragione. Quindi cosa vorresti che facessi al riguardo?",shape=box,color=red];
		j1269446798 -> j2489181412;
	j261506707 [label="Tu hai ragione. Loro no. Ma questo non significa che possiamo trattarli male.",shape=box,color=red];
		j261506707 -> j2465018984;
	j2130579871 [label="Non so se hai ragione o no. Ma possono ancora pensare e provare sentimenti, e non possiamo trattarli come cose.",shape=box,color=red];
		j2130579871 -> j3384562659;
	j2711300406 [label="Necraloid ha un'anima. Tutti i Cephalon ce l'hanno.",shape=box,color=red];
		j2711300406 -> j4159821022;
	j2474027025 [label="Si specializzò in cristallografia. E i suoi lavori furono archiviati qui, nei laboratori.",shape=box,color=red];
		j2474027025 -> j504800472;
	j3472411092 [label="Boolean MarieCephalonUnsure is now true.",color=orange];
