		j4159821022 -> j3588696929;
	j504800472 [label="Per qualche ragione, non so perché, fu trasformato in un Cephalon e gli fu dato il suo guscio necraloid.",shape=box,color=red];
		j504800472 -> j2088578733;
	j2152058554 [label="Boolean MarieCephalonNoSoul is now false.",color=orange];
		j2152058554 -> j2048725112;
