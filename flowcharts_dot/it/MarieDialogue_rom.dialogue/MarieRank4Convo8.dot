	1934 [label="Ho chiesto a Monsieur Necraloid se il teschio che lo adornava fosse appartenuto in qualche momento a un'anima vivente oppure no.",shape=box,color=blue];
		1934 -> 1936;
	1932 [label="Mi incuriosisce il motivo per cui sulla sua schiena c'è un altro volto che assomiglia allo scarabocchio di un bambino.",shape=box,color=blue];
		1932 -> 1935;
	1933 [label="Chat ends.",color=orange];
	1936 [label="E Monsieur Necraloid mi ha detto che era il \"suo\" cranio, pur ammettendo che Monsieur Loid era ''l'originale\". Monsieur Loid è intervenuto per dirmi che si trattava di una versione \"replicata\" del suo cranio.",shape=box,color=blue];
		1936 -> 1938;
	1935 [label="Ho chiesto informazioni sia a Monsieur Necraloid che a Monsieur Loid, ma nessuno dei due ha voluto parlarne, mi hanno solo detto un nome: Otak. E lo hanno pronunciato con grande tristezza.",shape=box,color=blue];
		1935 -> 1937;
	1938 [label="Come è possibile ? E cosa significa \"replicato\" ? È un teschio vero o è un falso ? Perché Monsieur Necraloid e Monsieur Loid avrebbero dato risposte diverse ?",shape=box,color=blue];
		1938 -> 1940;
		1938 -> 1941;
		1938 -> 1942;
	1937 [label="Quindi eccomi qui, a parlare con te, nella speranza che tu possa aiutarmi.",shape=box,color=blue];
		1937 -> 1939;
	1940 [label="Immagino che dal punto di vista di Necraloid sia il suo teschio. È vero. Ma che dal punto di vista di Loid sia una replica.",shape=box,color=red];
		1940 -> 1944;
	1941 [label="Onestamente non so di cosa sia fatto. Potrebbe essere osso. O qualche tipo di polimero...",shape=box,color=red];
		1941 -> 1945;
	1942 [label="Penso che la vera domanda sia: \"Necraloid è reale?\" e non \"il teschio è reale?\".",shape=box,color=red];
		1942 -> 1946;
	1939 [label="Mi racconteresti la storia del povero Monsieur Otak ?",shape=box,color=blue];
		1939 -> 1943;
	1944 [label="Credo che sia questo a preoccuparmi. È il modo in cui i due signori ne considerano l'origine. Uno la ritiene sacra, l'altro una copia.",shape=box,color=blue];
		1944 -> 1948;
	1945 [label="Non so se è il materiale di cui è fatto il teschio a turbarmi così tanto. È la sua origine. O forse il modo in cui i due signori lo considerano. Uno lo ritiene sacro, l'altro una copia.",shape=box,color=blue];
		1945 -> 1948;
	1946 [label="+5 Chemistry",color=orange];
		1946 -> 1949;
	1943 [label="Otak era un Archimedeo, uno scienziato e accademico Orokin. Quello che gli è successo non è esattamente una storia felice.",shape=box,color=red];
		1943 -> 1947;
	1948 [label="Evaluate expressions",color=orange];
