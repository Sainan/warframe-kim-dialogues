	j366938164 [label="+5 Chemistry",color=orange];
		j366938164 -> j2511082154;
	j3794341728 [label="+10 Chemistry",color=orange];
		j3794341728 -> j1656176417;
	j135369818 [label="+5 Chemistry",color=orange];
		j135369818 -> j2848388362;
	j2546691368 [label="Come siete arrivati a questo?",shape=box,color=red];
		j2546691368 -> j2698360337;
	j849488776 [label="Spero che un giorno tu possa incontrarlo.",shape=box,color=red];
		j849488776 -> j2949107086;
	j2511082154 [label="Merci ! À la revoyure !",shape=box,color=blue];
		j2511082154 -> "Chat ends.";
	j1656176417 [label="Oh ! È uno dei Riti di Lua. Nell'anniversario della scomparsa di un'anima, si intreccia una corona o una ghirlanda di fiori e la si pone sul suo cranio o sulla sua tomba. ",shape=box,color=blue];
		j1656176417 -> j3376369644;
	j2848388362 [label="Merci, lo farò ! À la revoyure !",shape=box,color=blue];
		j2848388362 -> "Chat ends.";
	j2949107086 [label="Oui. Ma non è il suo silenzio a turbarmi, credo. Ho chiesto a Monsieur Necraloid se il teschio che lo adornava fosse appartenuto in qualche momento a un'anima vivente oppure no.",shape=box,color=blue];
		j2949107086 -> j146773776;
	j3376369644 [label="Nelle cripte tradizionali per i defunti, spesso i corpi erano esposti, oui ? Quindi si poteva fare così. Credo che qualcosa sia sopravvissuto, ancora oggi.",shape=box,color=blue];
		j3376369644 -> j2701281293;
	j2701281293 [label="Lo vedo riflesso in alcune delle opere d'arte degli Orokin, con il loro amore per i teschi. ",shape=box,color=blue];
		j2701281293 -> j811648966;
		j2701281293 -> j1990227256;
		j2701281293 -> j2426711727;
	j811648966 [label="Questo spiega molte cose.",shape=box,color=red];
		j811648966 -> j2861286718;
	j1990227256 [label="Le cose cambiano, eh?",shape=box,color=red];
		j1990227256 -> j2861286718;
	j2426711727 [label="Penso che Figlia ci abbia già provato, la farai ingelosire.",shape=box,color=red];
		j2426711727 -> j2923243375;
	j2861286718 [label="Oui ! È passato così tanto tempo, eppure l'influenza rimane. Mi rende felice sapere che anche piccoli frammenti sono rimasti.",shape=box,color=blue];
		j2861286718 -> j418548037;
	j2923243375 [label="Oui ? Allora non vedo l'ora che arrivi il giorno in cui potrò incontrarla ! Le dirò che non gli ho dato tregua.",shape=box,color=blue];
		j2923243375 -> j418548037;
	j418548037 [label="Teschio finto o no, Monsieur Necraloid dovrebbe avere una corona. E si vergogna così tanto quando lo ammiro ! Credo che arrossirebbe se potesse. E questo mi fa sorridere.",shape=box,color=blue];
		j418548037 -> j4101990552;
	j4101990552 [label="À la revoyure !",shape=box,color=blue];
		j4101990552 -> "Chat ends.";
