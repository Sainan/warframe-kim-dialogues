		j2411453274 -> j806665092 [label="false",color=purple];
	j172374465 [label="Questo è il problema con persone come Entrati. Non sono solo forze del \"Bene\" o del \"Male\". Sono un misto.",shape=box,color=red];
		j172374465 -> j3618649068;
	j2514708714 [label="Teniamo fuori da questa conversazione il discorso riguardante le Cardinal, oui ? Sono preoccupata per il fratello della mia anima.",shape=box,color=blue];
		j2514708714 -> j1133603070;
	j1676124519 [label="Non credo che l'abbia fatto, ma il fatto rimane, oui ? Apprezzo comunque le tue parole. Cela dit...",shape=box,color=blue];
		j1676124519 -> j2514708714;
	j241570874 [label="Boolean DrifterMarie is now true.",color=orange];
		j241570874 -> j2923968326;
	j2884257354 [label="Lyon sta cercando di accettare il fatto che l'Indifferenza non sia una vera divinità.",shape=box,color=red];
		j2884257354 -> j1856505673;
	j4062426380 [label="Non credo che sia una sola cosa. Credo che sia il risultato di essere intrappolati tra molti fattori.",shape=box,color=red];
		j4062426380 -> j2602852855;
	j3005381679 [label="Lyon sentiva la voce di uno dei Tenno, un ragazzino di nome Rell. Rell... è morto. Non credo che stia affrontando bene la situazione.",shape=box,color=red];
		j3005381679 -> j3387175986;
	j682796569 [label="Roathe gli sussurra bugie sull'Uomo nel Muro.",shape=box,color=red];
		j682796569 -> j3962059550;
	j604429360 [label="Non credo che il fatto che Entrati gli sussurri che le voci dei suoi dei sono in realtà le voci del Void gli sia d'aiuto.",shape=box,color=red];
		j604429360 -> j2763722603;
	j806665092 [label="Sinceramente no.",shape=box,color=red];
		j806665092 -> j864189524;
	j3618649068 [label="Teniamo fuori da questa conversazione il discorso riguardante le Cardinal, oui ? Sono preoccupata per il fratello della mia anima. Ma... so che quello che dici sta... diventando sempre di più la verità.",shape=box,color=blue];
		j3618649068 -> j3493908240;
	j2923968326 [label="Non pensare che non abbia capito cosa hai fatto intrufolandoti lì per primo, lupo.",shape=box,color=blue];
		j2923968326 -> j3618649068;
	j1856505673 [label="E non gli sei stato di alcun aiuto in queste questioni, se gli hai parlato in questo modo. Anche se queste parole sono la verità, bisogna stare attenti a come vengono pronunciate.",shape=box,color=blue];
		j1856505673 -> j224119136;
	j2602852855 [label="Oui, è stato un rifugio nella tempesta per così tante persone... e ora è lui stesso intrappolato in una tempesta.",shape=box,color=blue];
		j2602852855 -> j1018678690;
	j3387175986 [label="L'ho sentito pronunciare quel nome, Rell - e mi spezza il cuore sapere cosa è successo al ragazzino.",shape=box,color=blue];
		j3387175986 -> j2779014084;
	j3962059550 [label="Quel diavolo ha causato più sofferenze nella sua lunga vita di tanti altri ! Ma non credo che sia l'unica causa dei suoi conflitti, non ?",shape=box,color=blue];
		j3962059550 -> j1807559260;
	j2763722603 [label="S'il te plaît, basta parlare de le Cardinal. Non nego che le sue parole aggiungano tensione a Lyon, ma non possono esserne l'unica causa.",shape=box,color=blue];
		j2763722603 -> j2610410308;
	j864189524 [label="Allora suppongo che... tutto ciò che possiamo fare è essere pazienti e sperare di scoprire cosa lo turba.",shape=box,color=blue];
		j864189524 -> j2015656394;
	j3493908240 [label="Boolean MarieEntrati4a is now true.",color=orange];
		j3493908240 -> j1133603070;
	j224119136 [label="Un intervento chirurgico non è meglio se eseguito con un'ascia. Questa non è la Marina Britannica.",shape=box,color=blue];
		j224119136 -> j898729112;
	j1018678690 [label="Dilaniato e senza sapere che direzione prendere...",shape=box,color=blue];
		j1018678690 -> j4231928897;
		j1018678690 -> j2173348769;
	j2779014084 [label="Ma non penso che sia l'unica causa del suo conflitto, non ? Lyon segue il cammino di Lua. La mort est une compagne qui marche à ses côtés",shape=box,color=blue];
		j2779014084 -> j898729112;
	j1807559260 [label="Ha contribuito alla sua incertezza... Ma dare tanto valore alle parole di un diavolo ? Il mio Lyon è meglio di così. Credo che siano molte le cose che ora lo opprimono.",shape=box,color=blue];
		j1807559260 -> j2891806458;
		j1807559260 -> j3585882774;
	j2610410308 [label="Boolean MarieEntrati4b is now true.",color=orange];
		j2610410308 -> j245651680;
	j2015656394 [label="+15 Chemistry",color=orange];
		j2015656394 -> j1194438157;
	j898729112 [label="No, credo che siano molte le cose che ora lo opprimono.",shape=box,color=blue];
		j898729112 -> j2891806458;
		j898729112 -> j3585882774;
	j4231928897 [label="Allora dobbiamo essere il suo rifugio. Un posto che sa che non gli farà del male.",shape=box,color=red];
		j4231928897 -> j4013843438;
	j2173348769 [label="Dobbiamo mostrargli la via per tornare in salvo, allora. Essere la luce nell'oscurità.",shape=box,color=red];
		j2173348769 -> j706255923;
	j2891806458 [label="Immagino allora... che dovremo mostrargli la via per tornare in salvo. Essere la luce nell'oscurità.",shape=box,color=red];
		j2891806458 -> j706255923;
	j3585882774 [label="Immagino allora... che noi dobbiamo essere il suo rifugio. Un posto che sa che non gli farà del male.",shape=box,color=red];
		j3585882774 -> j771034160;
	j245651680 [label="Non ha dato abbastanza peso alle parole de le Cardinal da lasciarsi trascinare in tale oscurità. Credo che siano molte le cose che ora lo opprimono.",shape=box,color=blue];
		j245651680 -> j3585882774;
		j245651680 -> j2891806458;
	j1194438157 [label="Merci. So che stai facendo del tuo meglio. E per questo ti sono grata.",shape=box,color=blue];
		j1194438157 -> "Chat ends.";
	j4013843438 [label="+10 Chemistry",color=orange];
		j4013843438 -> j2812222801;
	j706255923 [label="Come puoi aiutare qualcuno che non riesce a sentire la tua chiamata, non riesce a vedere la tua luce ? Non, Lua lo ha avvolto in questa oscurità.",shape=box,color=blue];
		j706255923 -> j2787084409;
	j771034160 [label="+5 Chemistry",color=orange];
		j771034160 -> j2812222801;
	j2812222801 [label="Oui, suppongo che tu abbia ragione. Dobbiamo essere noi coloro a cui può rivolgersi quando tutto il resto lo abbandona.",shape=box,color=blue];
		j2812222801 -> j1335723509;
	j2787084409 [label="Non credo nemmeno che la luce di Sol possa attraversare il velo.",shape=box,color=blue];
		j2787084409 -> j1335723509;
	j1335723509 [label="Laddove la sua fede può essere debole, noi dobbiamo essere la terra sotto i suoi piedi. ",shape=box,color=blue];
		j1335723509 -> j443889819;
	j443889819 [label="Se tutte le voci invisibili si sono trasformate da fantômes a démons nelle ombre che lo tormentano -",shape=box,color=blue];
		j443889819 -> j3944588432;
	j3944588432 [label="Dobbiamo renderci ancora più reali, non ?",shape=box,color=blue];
		j3944588432 -> j1693317569;
		j3944588432 -> j2247429089;
	j1693317569 [label="Continuerò a provarci.",shape=box,color=red];
		j1693317569 -> j893392528;
	j2247429089 [label="Spero solo che questo non lo faccia a pezzi.",shape=box,color=red];
		j2247429089 -> j3564828881;
	j893392528 [label="+10 Chemistry",color=orange];
		j893392528 -> j3317257903;
	j3564828881 [label="+5 Chemistry",color=orange];
		j3564828881 -> j4253599564;
	j3317257903 [label="Alla fine, è tutto ciò che possiamo fare.",shape=box,color=blue];
		j3317257903 -> j4235070471;
	j4253599564 [label="Oui... anche io. Ma tutto ciò che possiamo fare è stare accanto a lui e pregare, non ?",shape=box,color=blue];
		j4253599564 -> j365750206;
	j4235070471 [label="Provare. E pregare.",shape=box,color=blue];
		j4235070471 -> j1687172131;
	j365750206 [label="E sperare che non sia troppo tardi.",shape=box,color=blue];
		j365750206 -> j1687172131;
	j1687172131 [label="Merci... devo andare. Mi dispiace se questa conversazione non è stata di grande aiuto. Mi agito quando non riesco ad agire.",shape=box,color=blue];
		j1687172131 -> j956856116;
		j1687172131 -> j447242447;
