	1805 [label="Quel diavolo ha causato più sofferenze nella sua lunga vita di tanti altri ! Ma non credo che sia l'unica causa dei suoi conflitti, non ?",shape=box,color=blue];
		1805 -> 1812;
	1801 [label="S'il te plaît, basta parlare de le Cardinal. Non nego che le sue parole aggiungano tensione a Lyon, ma non possono esserne l'unica causa.",shape=box,color=blue];
