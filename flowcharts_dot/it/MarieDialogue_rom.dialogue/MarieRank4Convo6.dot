		1809 -> 1815;
		1809 -> 1816;
	1811 [label="Ma non penso che sia l'unica causa del suo conflitto, non ? Lyon segue il cammino di Lua. La mort est une compagne qui marche à ses côtés",shape=box,color=blue];
		1811 -> 1813;
	1812 [label="Ha contribuito alla sua incertezza... Ma dare tanto valore alle parole di un diavolo ? Il mio Lyon è meglio di così. Credo che siano molte le cose che ora lo opprimono.",shape=box,color=blue];
