		1771 -> 1773;
		1771 -> 1774;
	1772 [label="L'ho visto lottare contro i tormenti che gli dei hanno riversato sulle sue spalle. Ho saputo quando restare in silenzio al suo fianco, o quando essere il proverbiale muro contro cui sbattere i pugni.",shape=box,color=blue];
