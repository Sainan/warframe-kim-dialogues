		1780 -> 1784;
	1781 [label="Mi ritrovo spiazzata dalla sua rabbia, dal suo désespoir... evita la mia compagnia in un modo che non aveva mai fatto prima.",shape=box,color=blue];
		1781 -> 1785;
	1782 [label="Pas bien... Ma come posso scegliere tra l'amore per mio fratello e la mia adorazione per le Cardinal ? Come posso scegliere tra la mia famille ?",shape=box,color=blue];
