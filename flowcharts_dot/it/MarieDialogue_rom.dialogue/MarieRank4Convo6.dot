		j1531216646 -> j4115718638 [label=false,color=brown];
	j902275236 [label="È un adulto. Può decidere quando vuole parlare.",shape=box,color=red];
		j902275236 -> j1369058775;
	j774100431 [label="Mi si spezza il cuore nel vederlo affrontare questo dolore. Non so come aiutarlo.",shape=box,color=red];
		j774100431 -> j1252953315;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j197907766 [label="Non so come aiutarlo.",shape=box,color=red];
		j197907766 -> j3906194158;
	j1369058775 [label="Quando eri intrappolato in questo mondo creato da te, intrappolato in un ciclo infinito di morte, hai ricevuto aiuto per fuggire ?",shape=box,color=blue];
		j1369058775 -> j1679352735;
		j1369058775 -> j1874597549;
	j1252953315 [label="Sì, ed è doloroso vederlo soffrire... Sopratutto ora sapendo come gli hai fatto spazio nel tuo cuore.",shape=box,color=blue];
		j1252953315 -> j3906194158;
	j3906194158 [label="È difficile prevedere dove saranno i suoi limiti. Spesso cambiano di giorno in giorno.",shape=box,color=blue];
		j3906194158 -> j1162301302;
	j1679352735 [label="Nessuno dei loro aiuti sarebbe servito se non avessi voluto ricevere aiuto.",shape=box,color=red];
		j1679352735 -> j6021005;
		j1679352735 -> j3892767559;
	j1874597549 [label="Certo, dagli amici.",shape=box,color=red];
		j1874597549 -> j6021005;
		j1874597549 -> j3892767559;
	j1162301302 [label="L'ho visto lottare contro i tormenti che gli dei hanno riversato sulle sue spalle. Ho saputo quando restare in silenzio al suo fianco, o quando essere il proverbiale muro contro cui sbattere i pugni.",shape=box,color=blue];
		j1162301302 -> j3091752026;
	j6021005 [label="Non credo che Lyon voglia il mio aiuto.",shape=box,color=red];
		j6021005 -> j2988301978;
	j3892767559 [label="Sto cercando di stargli vicino, ma lui non mi ascolta.",shape=box,color=red];
		j3892767559 -> j1561506328;
	j3091752026 [label="Mais ça ? Questo ? Questo posto, le parole del diavolo, l'incertezza che le Cardinal ha causato... Questo gli ha portato un dolore dal quale prego che possa tornare.",shape=box,color=blue];
		j3091752026 -> j1670611083;
		j3091752026 -> j2397581301;
	j2988301978 [label="Allora suppongo... non ci sia altro da fare che avere pazienza, non ?",shape=box,color=blue];
		j2988301978 -> j447834358;
	j1561506328 [label="Nemmeno a me, ed è per questo che sono venuta a parlarne con te. Sono sempre riuscita a consolarlo -",shape=box,color=blue];
		j1561506328 -> j1133603070;
	j1670611083 [label="Quindi ammetti che Entrati ha danneggiato Lyon? E come l'hai presa?",shape=box,color=red];
		j1670611083 -> j692928438;
	j2397581301 [label="Ho la sensazione che sia sull'orlo del baratro. Come posso aiutarlo a tornare indietro?",shape=box,color=red];
		j2397581301 -> j2088716018;
	j447834358 [label="Merci. Mi dispiace farti perdere tempo.",shape=box,color=blue];
		j447834358 -> "Chat ends.";
	j1133603070 [label="Mi ritrovo spiazzata dalla sua rabbia, dal suo désespoir... evita la mia compagnia in un modo che non aveva mai fatto prima.",shape=box,color=blue];
		j1133603070 -> j709983518;
	j692928438 [label="Pas bien... Ma come posso scegliere tra l'amore per mio fratello e la mia adorazione per le Cardinal ? Come posso scegliere tra la mia famille ?",shape=box,color=blue];
		j692928438 -> j4096450455;
		j692928438 -> j3731515513;
		j692928438 -> j734290226;
		j692928438 -> j192280105;
	j2088716018 [label="Non lo so, ed è per questo che sono venuta a parlare con te. Sono sempre riuscita a consolarlo - ",shape=box,color=blue];
		j2088716018 -> j1133603070;
	j709983518 [label="Cosa lo ha turbato così tanto ? Ne conosci la causa ?",shape=box,color=blue];
		j709983518 -> j2411453274;
	j4096450455 [label="Non devi scegliere, Marie. Le persone possono essere complicate nel modo in cui si inseriscono nelle nostre vite.",shape=box,color=red];
		j4096450455 -> j172374465;
	j3731515513 [label="Sceglierei la famiglia che è ancora qui. Non quella che ti ha lasciata.",shape=box,color=red];
		j3731515513 -> j2514708714;
	j734290226 [label="Sono sicuro che Entrati non volesse causare a Lyon questo tipo di dolore.",shape=box,color=red];
		j734290226 -> j1676124519;
	j192280105 [label="Potresti scegliere una nuova famiglia. Come me. E quelli intorno a te a cui importa, senza Entrati.",shape=box,color=red];
		j192280105 -> j241570874;
	j2411453274 [label="Evaluate expressions",color=orange];
