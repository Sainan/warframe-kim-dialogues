		j1903226774 -> j3336843496 [label=true,color=green];
		j1903226774 -> j4243619751 [label=false,color=brown];
	j3862885154 [label="E come possiamo uscire da questo impasse. Questo purgatoire in cui siamo intrappolati non può continuare. Sembra inutilmente doloroso.",shape=box,color=blue];
		j3862885154 -> j2414740208;
	j3405377050 [label="Bonjour, mon cœur ! E cosa hai paura che non mi piaccia ?",shape=box,color=blue];
		j3405377050 -> j2733590204;
	j347976287 [label="Bonjour ! Oh ? E cosa hai paura che non mi piaccia ?",shape=box,color=blue];
		j347976287 -> j2733590204;
	j419069857 [label="Bonjour mon cœur ! Ci ho pensato un po', oui... e mi dispiace davvero ammetterlo. Non mi fa piacere dirlo.",shape=box,color=blue];
		j419069857 -> j4042213686;
	j3336843496 [label="Bonjour, bonjour, mon cœur ! Ci ho pensato, oui... e mi dispiace davvero ammetterlo. Non mi fa piacere dirlo.",shape=box,color=blue];
		j3336843496 -> j271861074;
	j4243619751 [label="Bonjour - Ci ho pensato un po', oui... e mi dispiace davvero ammetterlo. Non mi fa piacere dirlo.",shape=box,color=blue];
		j4243619751 -> j271861074;
	j2414740208 [label="Ma ho la sensazione che abbiamo bisogno... di una specie di bastione, non ? Hai qualche idea ?",shape=box,color=blue];
		j2414740208 -> j3389891715;
		j2414740208 -> j2733590204;
	j2733590204 [label="Penso che potremmo aver bisogno dell'aiuto di Roathe per convincere Loid a parlare con la famiglia Entrati. Non credo che lo farebbe altrimenti. Senza la garanzia che lui e la famiglia saranno protetti.",shape=box,color=red];
		j2733590204 -> j4215272576;
	j4042213686 [label="Ma penso... penso - ah, che Sol mi perdoni - che potrebbe essere necessario l'aiuto del diavolo. Altrimenti non credo che Monsieur Loid ci ascolterà.",shape=box,color=blue];
		j4042213686 -> j2937799949;
	j271861074 [label="Credo che tu possa avere ragione. Il diavolo potrebbe essere il tassello mancante di cui abbiamo bisogno. Ah, mi fa male anche solo digitare queste parole ! ",shape=box,color=blue];
		j271861074 -> j636489540;
	j3389891715 [label="Non ho davvero buone idee che non implichino l'aiuto di fonti pessime. Fonti che potrebbero solo metterci nei guai più avanti. Vale a dire, Roathe.",shape=box,color=red];
		j3389891715 -> j1982083562;
	j4215272576 [label="Io... odio ammetterlo, ma penso che tu possa avere ragione... Sol perdonami.",shape=box,color=blue];
		j4215272576 -> j636489540;
	j2937799949 [label="Il diavolo è potente e promette di darci forza nel caso in cui le cose dovessero andare male, non ?",shape=box,color=blue];
		j2937799949 -> j979406070;
		j2937799949 -> j2245952276;
