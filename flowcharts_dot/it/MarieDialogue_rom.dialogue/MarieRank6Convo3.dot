		3723 -> 3726;
	3724 [label="Add 1 to Thermostat",color=orange];
		3724 -> 3727;
	3722 [label="Sono semplicemente felice che il diavolo abbia qualcuno con cui parlare e che potrebbe cercare di temprarlo. Un ange custode.",shape=box,color=blue];
		3722 -> 3716;
		3722 -> 3717;
	3725 [label="Chat ends.",color=orange];
	3726 [label="+10 Chemistry",color=orange];
		3726 -> 3728;
	3727 [label="+10 Chemistry",color=orange];
		3727 -> 3729;
	3728 [label="Forse hai ragione... cos'è un ange senza un il suo diable ? Ci ricorda a tutti ciò che dovremmo cercare di evitare.",shape=box,color=blue];
		3728 -> 3730;
	3729 [label="Oui, temo che ci sia una cattiveria in lui che non può essere veramente curata. Gli piace troppo.",shape=box,color=blue];
		3729 -> 3730;
	3730 [label="Bene ! Se e quando convincerai il diavolo ad aiutarci nella nostra missione, io sarò pronta ! Fino ad allora !",shape=box,color=blue];
