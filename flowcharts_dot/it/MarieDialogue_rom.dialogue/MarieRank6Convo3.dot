		3631 -> 3639 [label="false",color=purple];
	3628 [label="Ne sei così sicuro ? Se io posso mettere da parte le mie divergenze con il diavolo, certamente puoi farlo anche tu, non ?",shape=box,color=blue];
		3628 -> 3632;
		3628 -> 3633;
	3634 [label="No, ci deve essere un altro modo. Mi rifiuto di chiedergli aiuto.",shape=box,color=red];
		3634 -> 3628;
	3635 [label="Hai ragione. Non pensavo che avresti accettato. Avevo paura di chiedertelo.",shape=box,color=red];
		3635 -> 3631;
	3638 [label="/Lotus/Language/1999Texting/MarieRomance/Marie_MarieRank6Convo3_3118 begins.",shape=box,color=blue];
		3638 -> 3644;
	3637 [label="Ci darà il suo aiuto a questo proposito ?",shape=box,color=blue];
		3637 -> 3643;
	3636 [label="Ci darà il suo aiuto a questo proposito ?",shape=box,color=blue];
		3636 -> 3642;
	3639 [label="Pensi di poterlo convincere ad aiutarci?",shape=box,color=blue];
		3639 -> 3645;
		3639 -> 3646;
	3632 [label="No, mi dispiace. ",shape=box,color=red];
		3632 -> 3640;
	3633 [label="Va bene. Se tu sei d'accordo, per me va bene.",shape=box,color=red];
		3633 -> 3641;
	3644 [label="No, purtroppo... Penso che sia stato un vicolo cieco. Pensi che ci sia un'altra soluzione?",shape=box,color=red];
		3644 -> 3650;
	3643 [label="Lo farà. L'ho convinto ad aiutarmi a riunirli - e non ci crederai - credo lo faccia per proteggere la famiglia di Entrati. Dopotutto, sono tutto ciò che rimane degli Orokin.",shape=box,color=red];
		3643 -> 3649;
