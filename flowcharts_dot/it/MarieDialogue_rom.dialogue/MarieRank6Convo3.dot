	3686 [label="Bene ! Quando arriverà il momento, sarò pronta ! Fino ad allora, merci.",shape=box,color=blue];
		3686 -> 3699;
	3697 [label="Sono semplicemente felice che tu sia felice. E se il diavolo ha un posto dove spendere i suoi... sforzi... tanto meglio, non ?",shape=box,color=blue];
		3697 -> 3708;
	3698 [label="Non insinuerei mai che, poiché il diavolo sembra favorirti, forse ti ascolterebbe mentre ignorerebbe tutti gli altri.",shape=box,color=blue];
		3698 -> 3709;
	3692 [label="Tutti nella sua vita hanno cercato di farlo passare per una specie di mostro. Immagino di essere la prima persona a non averlo fatto.",shape=box,color=red];
		3692 -> 3703;
	3693 [label="Ci sono molte cose in lui che non sa come mostrare. Non è un'armatura in sé - ma non si fida che la gente non gli faccia del male.",shape=box,color=red];
		3693 -> 3704;
	3695 [label="Lui... ha avuto il cuore spezzato nel corso della sua vita. Gli sono solo rimaste le cicatrici, tutto qui.",shape=box,color=red];
		3695 -> 3706;
	3696 [label="Credo di poter capire quanti anni ha vissuto. Ho visto la stessa quantità di morti che ha visto lui.",shape=box,color=red];
		3696 -> 3707;
	3694 [label="Ha sempre cercato di fare solo ciò che era giusto. Forse nel modo sbagliato, certo - ma stava cercando di salvare il Sistema Origin dagli Orokin.",shape=box,color=red];
		3694 -> 3705;
	3691 [label="Mi piace il suo umorismo pungente. È intelligente, se riesci a superare il suo ego.",shape=box,color=red];
		3691 -> 3702;
	3701 [label="Chat ends.",color=orange];
	3700 [label="Bene ! Quando arriverà il momento, sarò pronta ! Fino ad allora !",shape=box,color=blue];
		3700 -> 3711;
	3699 [label="Update boolean MarieFamilySuccess",color=orange];
		3699 -> 3710;
	3708 [label="Ancor di più se gli fai da ange custode per calmarlo.",shape=box,color=blue];
		3708 -> 3716;
		3708 -> 3717;
	3709 [label="E mai nei momenti privati. Non. Jamais.",shape=box,color=blue];
		3709 -> 3718;
		3709 -> 3719;
	3703 [label="E suppongo di essere in cima a quella lista ultimamente, non ? Suppongo che dovrei... considerare le sue ragioni, il motivo per cui è come è. La condanna non salva anime.",shape=box,color=blue];
		3703 -> 3713;
	3704 [label="C'è sempre un dolore che nascondiamo a chi ci circonda. Qualcosa che cerchiamo di nascondere, per paura che altri possano appropriarsene. Immagino che dovrei sforzarmi di essere più gentile con lui, se quello che dici è vero.",shape=box,color=blue];
		3704 -> 3713;
	3706 [label="Non riesco a immaginare la quantità di amore e perdita che si può soffrire in tutti quegli anni. Sembra così irreale, anche considerando tutto quello che ho visto.",shape=box,color=blue];
		3706 -> 3714;
	3707 [label="A volte, quando gli parlo, dimentico quanti secoli ha vissuto. Sembra così irreale, nonostante tutto quello che ho visto.",shape=box,color=blue];
		3707 -> 3715;
	3705 [label="Ci sono sempre... nuances, oui? Ci sono sempre delle ragioni per agire in un modo o nell'altro. Suppongo che dovrei sforzarmi di essere più gentile con lui, se quello che dici è vero.",shape=box,color=blue];
		3705 -> 3713;
	3702 [label="Nessuno ha mai negato al diavolo il suo ingegno.",shape=box,color=blue];
		3702 -> 3712;
	3711 [label="Update boolean MarieFamilySuccess",color=orange];
		3711 -> 3721;
	3710 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3710 -> 3720;
	3716 [label="Chi ha detto che sto cercando di calmarlo?",shape=box,color=red];
		3716 -> 3723;
	3717 [label="Non posso fare promesse.",shape=box,color=red];
		3717 -> 3724;
	3718 [label="Non sapevo che avessi questo lato.",shape=box,color=red];
		3718 -> 3684;
	3719 [label="Mi sorprendi. Sono impressionato. ",shape=box,color=red];
		3719 -> 3684;
	3713 [label="+10 Chemistry",color=orange];
		3713 -> 3722;
	3714 [label="Oui, che danno potrebbe causare a un'anima ? Capisco perché volevi incontrare un altro che capisse. E lui, te.",shape=box,color=blue];
		3714 -> 3713;
	3715 [label="Aver vissuto così a lungo, aver visto così tanta morte - aver pagato così tanto ?",shape=box,color=blue];
		3715 -> 3714;
	3712 [label="+5 Chemistry",color=orange];
		3712 -> 3722;
