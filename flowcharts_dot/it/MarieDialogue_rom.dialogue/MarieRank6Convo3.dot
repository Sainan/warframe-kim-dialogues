	3623 [label="Bonjour, bonjour, mon cœur ! Ci ho pensato, oui... e mi dispiace davvero ammetterlo. Non mi fa piacere dirlo.",shape=box,color=blue];
		3623 -> 3627;
	3622 [label="Bonjour - Ci ho pensato un po', oui... e mi dispiace davvero ammetterlo. Non mi fa piacere dirlo.",shape=box,color=blue];
		3622 -> 3627;
	3617 [label="Ma ho la sensazione che abbiamo bisogno... di una specie di bastione, non ? Hai qualche idea ?",shape=box,color=blue];
		3617 -> 3624;
		3617 -> 3625;
	3625 [label="Penso che potremmo aver bisogno dell'aiuto di Roathe per convincere Loid a parlare con la famiglia Entrati. Non credo che lo farebbe altrimenti. Senza la garanzia che lui e la famiglia saranno protetti.",shape=box,color=red];
		3625 -> 3629;
	3626 [label="Ma penso... penso - ah, che Sol mi perdoni - che potrebbe essere necessario l'aiuto del diavolo. Altrimenti non credo che Monsieur Loid ci ascolterà.",shape=box,color=blue];
		3626 -> 3630;
	3627 [label="Credo che tu possa avere ragione. Il diavolo potrebbe essere il tassello mancante di cui abbiamo bisogno. Ah, mi fa male anche solo digitare queste parole ! ",shape=box,color=blue];
		3627 -> 3631;
	3624 [label="Non ho davvero buone idee che non implichino l'aiuto di fonti pessime. Fonti che potrebbero solo metterci nei guai più avanti. Vale a dire, Roathe.",shape=box,color=red];
		3624 -> 3628;
	3629 [label="Io... odio ammetterlo, ma penso che tu possa avere ragione... Sol perdonami.",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="Il diavolo è potente e promette di darci forza nel caso in cui le cose dovessero andare male, non ?",shape=box,color=blue];
		3630 -> 3634;
		3630 -> 3635;
