	j12921055 [label="Stavo pensando a come convincere Loid a salire quelle scale per parlare finalmente con la famiglia, e... ho un'idea, ma non credo che ti piacerà.",shape=box,color=red];
		j12921055 -> j3431982611;
	j525247886 [label="Hai pensato ancora a come convincere Loid a parlare con la famiglia Entrati al piano di sopra?",shape=box,color=red];
		j525247886 -> j2607534784;
	j582219989 [label="A proposito del tentativo di far parlare Loid e la famiglia Entrati, mi chiedevo... hai riconsiderato il coinvolgimento di Roathe?",shape=box,color=red];
		j582219989 -> j1903226774;
	j2153844895 [label="Marie, sei ancora disposta a... provare a convincere Loid a parlare con i \"vicini del piano di sopra\"? So che abbiamo lasciato l'argomento su una nota un po' 'bizzarra'.",shape=box,color=red];
		j2153844895 -> j1903226774;
	j3630115603 [label="Ho pensato a quanto Monsieur Loid abbia paura di parlare con la famiglia de le Cardinal.",shape=box,color=blue];
		j3630115603 -> j3862885154;
	j3431982611 [label="Check boolean MarieDating",color=orange];
		j3431982611 -> j3405377050 [label=true,color=green];
