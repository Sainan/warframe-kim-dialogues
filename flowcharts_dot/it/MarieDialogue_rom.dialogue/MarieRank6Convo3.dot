		3611 -> 3616;
	3612 [label="Marie, sei ancora disposta a... provare a convincere Loid a parlare con i \"vicini del piano di sopra\"? So che abbiamo lasciato l'argomento su una nota un po' 'bizzarra'.",shape=box,color=red];
