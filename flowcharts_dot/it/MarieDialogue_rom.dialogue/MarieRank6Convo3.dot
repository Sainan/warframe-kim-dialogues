		j1104176810 -> j2336587113 [label=true,color=green];
		j1104176810 -> j433111579 [label=false,color=brown];
	j695603763 [label="Allora sosterrò anche io la tua scelta.",shape=box,color=blue];
		j695603763 -> j1179567760;
	j1676603611 [label="Nel frattempo parlerò con Lyon, ma le mie speranze sono estremamente basse.",shape=box,color=blue];
		j1676603611 -> j548547155;
	j4095359292 [label="+20 Chemistry",color=orange];
		j4095359292 -> j1677769169;
	j2154905500 [label="Ma almeno mi aiuterà. E mi assicurerò che non dia seguito alle sue minacce.",shape=box,color=red];
		j2154905500 -> j922139935;
	j1042705737 [label="Penso che sia solo una scusa per nascondere le sue vere intenzioni.",shape=box,color=red];
		j1042705737 -> j2325629982;
	j3572480752 [label="Oui, certo. Penso che tu abbia le capacità per convincerlo, dove tutti gli altri hanno fallito, non ?",shape=box,color=blue];
		j3572480752 -> j3359134431;
		j3572480752 -> j3414329104;
	j2326051477 [label="Oui, certo che sì. Quel diavolo sa essere ostinato anche nei suoi momenti migliori. A volte, penso che gli piaccia semplicemente essere contrario !",shape=box,color=blue];
		j2326051477 -> j720383403;
		j2326051477 -> j4178570801;
	j2336587113 [label="Penso che tu abbia le capacità per convincerlo, dove tutti gli altri hanno fallito, non ?",shape=box,color=blue];
		j2336587113 -> j3359134431;
		j2336587113 -> j3414329104;
	j433111579 [label="Ti auguro buona fortuna. Quel diavolo sa essere ostinato anche nei suoi momenti migliori. A volte, penso che gli piaccia semplicemente essere polemico !",shape=box,color=blue];
		j433111579 -> j720383403;
		j433111579 -> j4178570801;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j548547155 [label="+20 Chemistry",color=orange];
		j548547155 -> j1007261212;
	j1677769169 [label="Ho profondamente sottovalutato questo nostro diavolo...",shape=box,color=blue];
		j1677769169 -> j1589777455;
	j922139935 [label="Oui. Almeno sei qui per assicurarti che gli impediamo di seguire i suoi... istinti base.",shape=box,color=blue];
		j922139935 -> j2198758823;
	j2325629982 [label="Oui, spero tu abbia ragione.",shape=box,color=blue];
		j2325629982 -> j2198758823;
	j3359134431 [label="Non vorrei usare il mio rapporto con lui come strumento di negoziazione.",shape=box,color=red];
		j3359134431 -> j2371945587;
	j3414329104 [label="Cosa stai insinuando, Marie?",shape=box,color=red];
		j3414329104 -> j3522311028;
	j720383403 [label="In realtà mi piace, anche se può sembrare strano. Andiamo d'accordo.",shape=box,color=red];
		j720383403 -> j843815059;
	j4178570801 [label="Potrebbe esserlo, ma credo che molto di ciò sia solo finzione.",shape=box,color=red];
		j4178570801 -> j1876823615;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j1007261212 [label="Il diavolo è volubile! C'est la vie, come si suol dire!",shape=box,color=blue];
		j1007261212 -> j3569999725;
	j1589777455 [label="E non sono una stupida che non vede il ruolo che hai avuto nel garantire che tutto questo accadesse !",shape=box,color=blue];
		j1589777455 -> j3242583483;
	j2198758823 [label="Check boolean MarieDating",color=orange];
		j2198758823 -> j1015480169 [label=true,color=green];
		j2198758823 -> j4270089074 [label=false,color=brown];
	j2371945587 [label="Oh ! Non è questo che intendevo, pardonne-moi ! Semplicemente è che sembra favorirti, potresti avere il suo orecchio mentre potrebbe ignorare tutti gli altri.",shape=box,color=blue];
		j2371945587 -> j499204381;
	j3522311028 [label="+5 Chemistry",color=orange];
		j3522311028 -> j496353059;
	j843815059 [label="Sì, sembra proprio che ti preferisca. Forse è perché condividete un tempo e un luogo, cosa che noi non facciamo ? Altrimenti perché dovrebbe ?",shape=box,color=blue];
		j843815059 -> j3822691405;
	j1876823615 [label="Oui ? Cosa intendi ?",shape=box,color=blue];
		j1876823615 -> j3822691405;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j3242583483 [label="Check boolean MarieDating",color=orange];
		j3242583483 -> j1538475415 [label=true,color=green];
		j3242583483 -> j2304611052 [label=false,color=brown];
	j1015480169 [label="+10 Chemistry",color=orange];
		j1015480169 -> j2350828126;
	j4270089074 [label="+10 Chemistry",color=orange];
		j4270089074 -> j4020360784;
	j499204381 [label="+5 Chemistry",color=orange];
		j499204381 -> j3499858696;
	j496353059 [label="Non ho proprio idea di cosa intendi ! Non sto insinuando nulla. Sono une Sœur de Sol puramente innocente.",shape=box,color=blue];
		j496353059 -> j1433645351;
	j3822691405 [label="Evaluate expressions",color=orange];
		j3822691405 -> j1923170863 [label="RoatheVillain",color=purple];
		j3822691405 -> j745819416 [label="RoatheRedeemed",color=purple];
		j3822691405 -> j4207097473 [label="RoatheUnloved3",color=purple];
		j3822691405 -> j1658081858 [label="RoatheTraitor2",color=purple];
		j3822691405 -> j2904746679 [label="RoatheExecutor2",color=purple];
		j3822691405 -> j276045006 [label="false",color=purple];
	j1538475415 [label="Merci, merci, merci, mon cœur !",shape=box,color=blue];
		j1538475415 -> j3656633921;
	j2304611052 [label="Merci, merci, merci !",shape=box,color=blue];
		j2304611052 -> j3656633921;
	j2350828126 [label="Bene ! Quando arriverà il momento, sarò pronta ! Fino ad allora, merci, mon cœur.",shape=box,color=blue];
		j2350828126 -> j3569999725;
	j4020360784 [label="Bene ! Quando arriverà il momento, sarò pronta ! Fino ad allora, merci.",shape=box,color=blue];
		j4020360784 -> j3569999725;
	j3499858696 [label="Sono semplicemente felice che tu sia felice. E se il diavolo ha un posto dove spendere i suoi... sforzi... tanto meglio, non ?",shape=box,color=blue];
		j3499858696 -> j2469724762;
	j1433645351 [label="Non insinuerei mai che, poiché il diavolo sembra favorirti, forse ti ascolterebbe mentre ignorerebbe tutti gli altri.",shape=box,color=blue];
		j1433645351 -> j1124858086;
	j1923170863 [label="Tutti nella sua vita hanno cercato di farlo passare per una specie di mostro. Immagino di essere la prima persona a non averlo fatto.",shape=box,color=red];
		j1923170863 -> j1254049741;
	j745819416 [label="Ci sono molte cose in lui che non sa come mostrare. Non è un'armatura in sé - ma non si fida che la gente non gli faccia del male.",shape=box,color=red];
		j745819416 -> j1535861248;
	j4207097473 [label="Lui... ha avuto il cuore spezzato nel corso della sua vita. Gli sono solo rimaste le cicatrici, tutto qui.",shape=box,color=red];
		j4207097473 -> j731971206;
	j1658081858 [label="Credo di poter capire quanti anni ha vissuto. Ho visto la stessa quantità di morti che ha visto lui.",shape=box,color=red];
		j1658081858 -> j3413379923;
	j2904746679 [label="Ha sempre cercato di fare solo ciò che era giusto. Forse nel modo sbagliato, certo - ma stava cercando di salvare il Sistema Origin dagli Orokin.",shape=box,color=red];
		j2904746679 -> j1279170871;
	j276045006 [label="Mi piace il suo umorismo pungente. È intelligente, se riesci a superare il suo ego.",shape=box,color=red];
		j276045006 -> j541849044;
	j3656633921 [label="Bene ! Quando arriverà il momento, sarò pronta ! Fino ad allora !",shape=box,color=blue];
		j3656633921 -> j3569999725;
	j2469724762 [label="Ancor di più se gli fai da ange custode per calmarlo.",shape=box,color=blue];
		j2469724762 -> j3761777176;
		j2469724762 -> j28782989;
	j1124858086 [label="E mai nei momenti privati. Non. Jamais.",shape=box,color=blue];
		j1124858086 -> j3533306865;
		j1124858086 -> j1370574460;
	j1254049741 [label="E suppongo di essere in cima a quella lista ultimamente, non ? Suppongo che dovrei... considerare le sue ragioni, il motivo per cui è come è. La condanna non salva anime.",shape=box,color=blue];
		j1254049741 -> j2256694786;
	j1535861248 [label="C'è sempre un dolore che nascondiamo a chi ci circonda. Qualcosa che cerchiamo di nascondere, per paura che altri possano appropriarsene. Immagino che dovrei sforzarmi di essere più gentile con lui, se quello che dici è vero.",shape=box,color=blue];
		j1535861248 -> j2256694786;
	j731971206 [label="Non riesco a immaginare la quantità di amore e perdita che si può soffrire in tutti quegli anni. Sembra così irreale, anche considerando tutto quello che ho visto.",shape=box,color=blue];
		j731971206 -> j818259926;
	j3413379923 [label="A volte, quando gli parlo, dimentico quanti secoli ha vissuto. Sembra così irreale, nonostante tutto quello che ho visto.",shape=box,color=blue];
		j3413379923 -> j2758687163;
	j1279170871 [label="Ci sono sempre... nuances, oui? Ci sono sempre delle ragioni per agire in un modo o nell'altro. Suppongo che dovrei sforzarmi di essere più gentile con lui, se quello che dici è vero.",shape=box,color=blue];
		j1279170871 -> j2256694786;
	j541849044 [label="Nessuno ha mai negato al diavolo il suo ingegno.",shape=box,color=blue];
		j541849044 -> j1959759061;
	j3761777176 [label="Chi ha detto che sto cercando di calmarlo?",shape=box,color=red];
		j3761777176 -> j1014410439;
	j28782989 [label="Non posso fare promesse.",shape=box,color=red];
		j28782989 -> j4108758147;
	j3533306865 [label="Non sapevo che avessi questo lato.",shape=box,color=red];
		j3533306865 -> j499204381;
	j1370574460 [label="Mi sorprendi. Sono impressionato. ",shape=box,color=red];
		j1370574460 -> j499204381;
	j2256694786 [label="+10 Chemistry",color=orange];
		j2256694786 -> j3269369481;
	j818259926 [label="Oui, che danno potrebbe causare a un'anima ? Capisco perché volevi incontrare un altro che capisse. E lui, te.",shape=box,color=blue];
		j818259926 -> j2256694786;
	j2758687163 [label="Aver vissuto così a lungo, aver visto così tanta morte - aver pagato così tanto ?",shape=box,color=blue];
		j2758687163 -> j818259926;
	j1959759061 [label="+5 Chemistry",color=orange];
		j1959759061 -> j3269369481;
	j1014410439 [label="Add -1 to Thermostat counter",color=orange];
		j1014410439 -> j2829202191;
	j4108758147 [label="Add 1 to Thermostat counter",color=orange];
		j4108758147 -> j3403850640;
	j3269369481 [label="Sono semplicemente felice che il diavolo abbia qualcuno con cui parlare e che potrebbe cercare di temprarlo. Un ange custode.",shape=box,color=blue];
		j3269369481 -> j3761777176;
		j3269369481 -> j28782989;
	j2829202191 [label="+10 Chemistry",color=orange];
		j2829202191 -> j381602296;
	j3403850640 [label="+10 Chemistry",color=orange];
		j3403850640 -> j2015055996;
	j381602296 [label="Forse hai ragione... cos'è un ange senza un il suo diable ? Ci ricorda a tutti ciò che dovremmo cercare di evitare.",shape=box,color=blue];
