	3613 [label="E come possiamo uscire da questo impasse. Questo purgatoire in cui siamo intrappolati non può continuare. Sembra inutilmente doloroso.",shape=box,color=blue];
		3613 -> 3617;
	3619 [label="Bonjour, mon cœur ! E cosa hai paura che non mi piaccia ?",shape=box,color=blue];
		3619 -> 3625;
	3618 [label="Bonjour ! Oh ? E cosa hai paura che non mi piaccia ?",shape=box,color=blue];
		3618 -> 3625;
	3621 [label="Bonjour mon cœur ! Ci ho pensato un po', oui... e mi dispiace davvero ammetterlo. Non mi fa piacere dirlo.",shape=box,color=blue];
		3621 -> 3626;
