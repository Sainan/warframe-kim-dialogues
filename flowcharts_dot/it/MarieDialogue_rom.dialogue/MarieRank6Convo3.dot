	3665 [label="Ho profondamente sottovalutato questo nostro diavolo...",shape=box,color=blue];
		3665 -> 3673;
	3663 [label="Oui. Almeno sei qui per assicurarti che gli impediamo di seguire i suoi... istinti base.",shape=box,color=blue];
