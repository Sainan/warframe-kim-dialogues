	3609 [label="Stavo pensando a come convincere Loid a salire quelle scale per parlare finalmente con la famiglia, e... ho un'idea, ma non credo che ti piacerà.",shape=box,color=red];
		3609 -> 3614;
	3610 [label="Hai pensato ancora a come convincere Loid a parlare con la famiglia Entrati al piano di sopra?",shape=box,color=red];
		3610 -> 3615;
