		j636489540 -> j2416121674 [label="false",color=purple];
	j1982083562 [label="Ne sei così sicuro ? Se io posso mettere da parte le mie divergenze con il diavolo, certamente puoi farlo anche tu, non ?",shape=box,color=blue];
		j1982083562 -> j683399766;
		j1982083562 -> j1095259672;
	j979406070 [label="No, ci deve essere un altro modo. Mi rifiuto di chiedergli aiuto.",shape=box,color=red];
		j979406070 -> j1982083562;
	j2245952276 [label="Hai ragione. Non pensavo che avresti accettato. Avevo paura di chiedertelo.",shape=box,color=red];
		j2245952276 -> j636489540;
	j4097859153 [label="Ci darà il suo aiuto a questo proposito ?",shape=box,color=blue];
		j4097859153 -> j3443009862;
	j2330686361 [label="Ci darà il suo aiuto a questo proposito ?",shape=box,color=blue];
		j2330686361 -> j2130864825;
	j905601441 [label="Ci darà il suo aiuto a questo proposito ?",shape=box,color=blue];
		j905601441 -> j1593768952;
	j2416121674 [label="Pensi di poterlo convincere ad aiutarci?",shape=box,color=blue];
		j2416121674 -> j3096104141;
		j2416121674 -> j3993710755;
	j683399766 [label="No, mi dispiace. ",shape=box,color=red];
		j683399766 -> j3672513205;
	j1095259672 [label="Va bene. Se tu sei d'accordo, per me va bene.",shape=box,color=red];
		j1095259672 -> j1487145862;
	j3443009862 [label="No, purtroppo... Penso che sia stato un vicolo cieco. Pensi che ci sia un'altra soluzione?",shape=box,color=red];
		j3443009862 -> j2319593958;
	j2130864825 [label="Lo farà. L'ho convinto ad aiutarmi a riunirli - e non ci crederai - credo lo faccia per proteggere la famiglia di Entrati. Dopotutto, sono tutto ciò che rimane degli Orokin.",shape=box,color=red];
		j2130864825 -> j1349792792;
	j1593768952 [label="Lo farà. L'ho convinto ad aiutarmi a riunirli - e non ti sorprenderai - credo lo faccia soprattutto per fare dispetto ad Albrecht in sua assenza.",shape=box,color=red];
		j1593768952 -> j1473936658;
	j3096104141 [label="Niente è stato deciso. Lui è... beh, sai com'è.",shape=box,color=red];
		j3096104141 -> j2913252443;
	j3993710755 [label="Ci sto ancora lavorando, ma credo di sì.",shape=box,color=red];
		j3993710755 -> j1104176810;
	j3672513205 [label="+20 Chemistry",color=orange];
		j3672513205 -> j695603763;
	j1487145862 [label="Oui, non sono obbligata a farmelo andare bene, ma è un medicinale che dobbiamo ingoiare, suppongo.",shape=box,color=blue];
		j1487145862 -> j636489540;
	j2319593958 [label="Oh ! Che peccato. Non lo so ? Non credo... Ti viene in mente un altro approccio con il diavolo ? O un modo per riprovare ?",shape=box,color=blue];
		j2319593958 -> j1676603611;
	j1349792792 [label="Sta aiutando a proteggere la famiglia dell'uomo che lo ha trasformato in protoframe contro la sua volontà e lo ha catapultato nel passato, privandolo dei suoi ricordi...",shape=box,color=blue];
		j1349792792 -> j4095359292;
	j1473936658 [label="Hai ragione, non sono... sorpresa.",shape=box,color=blue];
		j1473936658 -> j2154905500;
		j1473936658 -> j1042705737;
