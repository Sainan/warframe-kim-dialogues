		j3274936057 -> j1777960541;
	j1499238862 [label="Ha ! È uno degli studenti più veloci nell'apprendimento che abbia mai incontrato, Drifter! Se fossi in te, eviterei nello sfidarlo a risolvere enigmi che prevedano scommesse in denaro.",shape=box,color=blue];
		j1499238862 -> j1777960541;
	j1050759891 [label="Non, se la cava molto bene con le novità. Non escluderei che abbia studiato le macchine ambulanti che gironzolano di sotto e che abbia già iniziato ad elaborare dei design propri.",shape=box,color=blue];
		j1050759891 -> j1777960541;
	j1777960541 [label="Semplicemente non ti conosce. Lyon non è... socievole, neanche nei suoi momenti migliori. Non è mia intenzione offenderti.",shape=box,color=blue];
