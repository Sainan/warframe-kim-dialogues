digraph {
	"MarieRank2Convo1 begins." [color=orange];
		"MarieRank2Convo1 begins." -> j3056866730;
	j3056866730 [label="Spero che non mi considererai maleducata per averlo chiesto, ma sono terribilmente curiosa. Hai una fede ? Nei Luminari o in altro.",shape=box,color=blue];
		j3056866730 -> j4014359870;
		j3056866730 -> j2055151246;
		j3056866730 -> j4115718638;
	j4014359870 [label="E se ti dicessi che sono più interessato a te? Sarebbe una blasfemia?",shape=box,color=red];
		j4014359870 -> j1779893685;
	j2055151246 [label="No, non sarebbe affatto maleducato.",shape=box,color=red];
		j2055151246 -> j3254549651;
		j2055151246 -> j1879165567;
		j2055151246 -> j4143889754;
		j2055151246 -> j1974742307;
		j2055151246 -> j2792866312;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j1779893685 [label="Boolean DrifterMarie is now true.",color=orange];
		j1779893685 -> j2491852513;
	j3254549651 [label="È... complicato. Credo che ci sia qualcosa là fuori, ma non ho una vera e propria fede.",shape=box,color=red];
		j3254549651 -> j3727795352;
	j1879165567 [label="Si, certo. Ho una fede in cui credo, ma non è una fede che conosci.",shape=box,color=red];
		j1879165567 -> j3882190635;
	j4143889754 [label="Credo nei Luminari, come te.",shape=box,color=red];
		j4143889754 -> j2077989384;
	j1974742307 [label="No, non credo. Non credo negli dei. Credo solo nella scienza che ancora non comprendiamo.",shape=box,color=red];
		j1974742307 -> j1152652141;
	j2792866312 [label="Sinceramente non lo so. Penso che il mondo sia troppo complicato per avere la risposta.",shape=box,color=red];
		j2792866312 -> j2801554055;
	"Chat ends." [color=orange];
	j2491852513 [label="Ah, oui ? Cos'è questo ? Quelle audace, devo dire che sono sorpresa da te ! Non me l'aspettavo...",shape=box,color=blue];
		j2491852513 -> j4236820551;
	j3727795352 [label="Boolean DrifterFaithPersonal is now true.",color=orange];
		j3727795352 -> j2963177648;
	j3882190635 [label="+5 Chemistry",color=orange];
		j3882190635 -> j2923147951;
	j2077989384 [label="+5 Chemistry",color=orange];
		j2077989384 -> j2606157285;
	j1152652141 [label="+5 Chemistry",color=orange];
		j1152652141 -> j1335019020;
	j2801554055 [label="Boolean DrifterFaithAgnostic is now true.",color=orange];
		j2801554055 -> j3567566442;
	j4236820551 [label="Ma stai cercando di distrarmi ! Anche se non sono contraria, è decisamente troppo presto per queste cose, n'est-ce pas ?",shape=box,color=blue];
		j4236820551 -> j98111623;
	j2963177648 [label="+5 Chemistry",color=orange];
		j2963177648 -> j299337644;
	j2923147951 [label="Trovo bellezza nella fede, in qualsiasi nome la si chiami. Dimmi, è nuova ? Vecchia ? La riconoscerei ?",shape=box,color=blue];
		j2923147951 -> j3202889274;
		j2923147951 -> j1627963371;
	j2606157285 [label="Davvero ! Oh, comme c'est fascinant ! Pensare che qualcuno mantenga la fede così lontano nel futuro, cela remplit mon cœur de joie. Sono sopraffatta dalla gioia. Anche se penso che il tuo tempo passato possa aver avuto qualcosa a che fare con questo, no ? Ah, non importa.",shape=box,color=blue];
		j2606157285 -> j1614425295;
	j1335019020 [label="Rispetto la tua risposta. Ma devo chiederti, come fai ad esserne così certo ? Non è forse questa una sorta di fede in sé ? E cos'è questa tua... Indifférence, se non una divinità ?",shape=box,color=blue];
		j1335019020 -> j2796268434;
		j1335019020 -> j1613189504;
		j1335019020 -> j2224512244;
	j3567566442 [label="+10 Chemistry",color=orange];
		j3567566442 -> j861646011;
	j98111623 [label="Vorrei comunque una risposta alla mia domanda, s'il vous plait, se non ti dispiace. Anche se ora mi fai arrossire !",shape=box,color=blue];
		j98111623 -> j3254549651;
		j98111623 -> j1879165567;
		j98111623 -> j4143889754;
		j98111623 -> j1974742307;
		j98111623 -> j2792866312;
	j299337644 [label="Ah, oui. Un vagabondo, è nel tuo nome. Hai visto molte culture, molte fedi e molti mondi. Cela est très spirituel, non ? Ne ho raccolte parti come conchiglie.",shape=box,color=blue];
		j299337644 -> j216852559;
		j299337644 -> j2784715861;
	j3202889274 [label="Non credo che la riconosceresti, no.",shape=box,color=red];
		j3202889274 -> j1228813487;
	j1627963371 [label="Potresti riconoscerne alcune parti. Ma altre ti sarebbero totalmente sconosciute.",shape=box,color=red];
		j1627963371 -> j3978479021;
	j1614425295 [label="Mi chiedo, sei devoto all'uno o all'altro ? O cerchi l'equilibrio ?",shape=box,color=blue];
		j1614425295 -> j3291029364;
		j1614425295 -> j754074134;
		j1614425295 -> j3810242875;
	j2796268434 [label="Non so se ho ragione, nessuno può averla. Ma personalmente non credo comunque negli dei.",shape=box,color=red];
		j2796268434 -> j4053597630;
	j1613189504 [label="Penso che la religione esista per colmare il vuoto lasciato nella vita delle persone dalla paura della morte e dell'ignoto.",shape=box,color=red];
		j1613189504 -> j1038281949;
	j2224512244 [label="Non so cosa sia l'Indifferenza, ma non è una divinità. Dobbiamo solo arrivare al fondo della questione. ",shape=box,color=red];
		j2224512244 -> j2214220370;
	j861646011 [label="Aah, forse la risposta più saggia di tutte! Chi siamo noi semplici mortali - se possiamo ancora affermare di esserlo - per pretendere di decifrare il design degli Dei ?",shape=box,color=blue];
		j861646011 -> j1875793949;
	j216852559 [label="Credo che ci sia anche qualcosa di più antico, vero, e profondo che parla a tutti noi. Una sorta di tessuto connettivo.",shape=box,color=red];
		j216852559 -> j3408457654;
	j2784715861 [label="Esatto. Vedo qualcosa di bello in tutti loro, non so se qualcuno ha ragione o torto.",shape=box,color=red];
		j2784715861 -> j3408457654;
	j1228813487 [label="Boolean DrifterFaithYesForeign is now true.",color=orange];
		j1228813487 -> j3599881103;
	j3978479021 [label="Boolean DrifterFaithYesSimilar is now true.",color=orange];
		j3978479021 -> j1783903031;
	j3291029364 [label="Mi sento più vicino a Sol. ",shape=box,color=red];
		j3291029364 -> j1860033414;
	j754074134 [label="Mi sento più vicino a Lua.",shape=box,color=red];
		j754074134 -> j3184449105;
	j3810242875 [label="Cerco l'equilibrio. Credo che sia l'ordine naturale delle cose.",shape=box,color=red];
		j3810242875 -> j612833934;
	j4053597630 [label="Boolean DrifterFaithNoMaybe is now true.",color=orange];
		j4053597630 -> j3927720711;
	j1038281949 [label="Boolean DrifterFaithNoFear is now true.",color=orange];
		j1038281949 -> j1810909637;
	j2214220370 [label="Boolean DrifterFaithNoMITW is now true.",color=orange];
		j2214220370 -> j3616848666;
	j1875793949 [label="Spesso mi sedevo nel santuario della mia Cathédrale e parlavo allegramente con degli sconosciuti venuti per imparare e nient'altro.",shape=box,color=blue];
		j1875793949 -> j3174188519;
	j3408457654 [label="+5 Chemistry",color=orange];
		j3408457654 -> j1026391366;
	j3599881103 [label="+5 Chemistry",color=orange];
		j3599881103 -> j347208736;
	j1783903031 [label="+5 Chemistry",color=orange];
		j1783903031 -> j3554931893;
	j1860033414 [label="Boolean DrifterFaithSol is now true.",color=orange];
		j1860033414 -> j2524727045;
	j3184449105 [label="Boolean DrifterFaithLua is now true.",color=orange];
		j3184449105 -> j1491975059;
	j612833934 [label="Boolean DrifterFaithBalance is now true.",color=orange];
		j612833934 -> j2460672976;
	j3927720711 [label="Oui, je vois... Forse hai bisogno di una ''prova'' per esserne certo? Non è successo nulla nella tua vita che ti abbia dato un'emozione simile a quella che proviamo noi, fatta di fede e fervore ?",shape=box,color=blue];
		j3927720711 -> j4043132673;
		j3927720711 -> j2409295996;
	j1810909637 [label="Oui, c'est vrai - è vero. La fede risponde a molte domande per molte anime. Non hai paura di ciò che può accadere dopo la morte ?",shape=box,color=blue];
		j1810909637 -> j1905109938;
		j1810909637 -> j1509556711;
	j3616848666 [label="Comme c'est fascinant... e ora ce ne sono due, che ripetono le stesse parole... il diavolo ha sussurrato la stessa cosa.",shape=box,color=blue];
		j3616848666 -> j2577669738;
	j3174188519 [label="Così curiosi riguardo la nostra fede, ma senza dire ''sì, sì, questa è la verità''. Spero solo di aver trasmesso un po' della nostra gioia.",shape=box,color=blue];
		j3174188519 -> j4072116274;
		j3174188519 -> j1642529696;
	j1026391366 [label="Je comprends et c'est magnifique. Mi sono spesso chiesta se i Luminari non avessero altri volti. Altri nomi.",shape=box,color=blue];
		j1026391366 -> j3398646860;
	j347208736 [label="Oh, comme c'est fascinant ! Quanto mi piacerebbe conoscere la tua fede un giorno. Sentire parlare dei tuoi rituali.",shape=box,color=blue];
		j347208736 -> j2690391567;
		j347208736 -> j1093004352;
	j3554931893 [label="Oh, comme c'est fascinant ! Quanto mi piacerebbe sapere un giorno perché è così simile e tuttavia così diversa.",shape=box,color=blue];
		j3554931893 -> j2690391567;
		j3554931893 -> j1093004352;
	j2524727045 [label="+10 Chemistry",color=orange];
		j2524727045 -> j3718743012;
	j1491975059 [label="+5 Chemistry",color=orange];
		j1491975059 -> j333368508;
	j2460672976 [label="+5 Chemistry",color=orange];
		j2460672976 -> j1769601323;
	j4043132673 [label="No, semplicemente non ci credo.",shape=box,color=red];
		j4043132673 -> j2791532015;
	j2409295996 [label="Giusto. Non ho mai... ''sentito'' la fede. Non ne ho mai avuto bisogno.",shape=box,color=red];
		j2409295996 -> j3398276577;
	j1905109938 [label="Tutti muoiono. Temerlo è sciocco. La morte arriva per tutti. O almeno... dovrebbe.",shape=box,color=red];
		j1905109938 -> j1236755439;
	j1509556711 [label="Sono morto abbastanza volte. Non temo ciò che verrà. Lo desidero ardentemente.",shape=box,color=red];
		j1509556711 -> j32971395;
	j2577669738 [label="+5 Chemistry",color=orange];
		j2577669738 -> j1515490866;
	j4072116274 [label="Sono un po' sorpreso che tu sia aperta nei confronti delle persone che non credono nella tua fede.",shape=box,color=red];
		j4072116274 -> j60490453;
	j1642529696 [label="Esatto. Non voglio dire se è ''giusto'' o ''sbagliato''.",shape=box,color=red];
		j1642529696 -> j3405109643;
	j3398646860 [label="Si sa che cambiano aspetto per compiacere i seguaci di altre sette. Ma questa è la mia fede, non la tua.",shape=box,color=blue];
		j3398646860 -> j1868959023;
	j2690391567 [label="Mi piacerebbe.",shape=box,color=red];
		j2690391567 -> j678530101;
	j1093004352 [label="Mi sorprende che tu sia aperta all'idea di altre religioni. ",shape=box,color=red];
		j1093004352 -> j992448758;
	j3718743012 [label="Un vagabondo con cui mi identifico ! Mi fai sorridere. Spero che tu non stia mentendo per adularmi.",shape=box,color=blue];
		j3718743012 -> j3200108456;
	j333368508 [label="Ah, il vagabondo segue il sentiero della notte come il mio caro Lyon. Quando sarà pronto, dovresti parlargli della sua oscura dama, ne sarà felicissimo.",shape=box,color=blue];
		j333368508 -> j3200108456;
	j1769601323 [label="Equilibrio senza indecisione. Viaggiare attraverso la propria vita, sapendo quando il sole deve sorgere e la luna deve rispondere, ma senza mai cadere preda del dubbio ?",shape=box,color=blue];
		j1769601323 -> j1858222300;
	j2791532015 [label="+5 Chemistry",color=orange];
		j2791532015 -> j2711241192;
	j3398276577 [label="+5 Chemistry",color=orange];
		j3398276577 -> j3868677419;
	j1236755439 [label="+5 Chemistry",color=orange];
		j1236755439 -> j4042740603;
	j32971395 [label="+5 Chemistry",color=orange];
		j32971395 -> j4209530817;
	j1515490866 [label="Mi addolora dargli credito, ma in questo caso... Forse dovresti parlargli. Sii semplicemente cauto. Il diavolo gioca un gioco pericoloso.",shape=box,color=blue];
		j1515490866 -> j303462924;
		j1515490866 -> j1680715069;
	j60490453 [label="Immagino che possa sorprendere scoprire che qualcuno che indossa la tonaca non è severo nelle aspettative verso gli altri. Trovo che predicare a chi non cerca conforto non ottiene molto amore.",shape=box,color=blue];
		j60490453 -> j4034911900;
	j3405109643 [label="+5 Chemistry",color=orange];
		j3405109643 -> j3313053058;
	j1868959023 [label="Spero semplicemente che la tua fede ti porti pace.",shape=box,color=blue];
		j1868959023 -> j1611490418;
		j1868959023 -> j254995397;
		j1868959023 -> j1614892723;
	j678530101 [label="Ô joie ! Adoro imparare. Mi sono spesso chiesta se i Luminari non avessero altri volti. Altri nomi.",shape=box,color=blue];
		j678530101 -> j1164759203;
	j992448758 [label="Immagino che possa sorprendere scoprire che qualcuno che indossa la tonaca non è severo nelle aspettative verso gli altri. Trovo che predicare a chi non cerca conforto non ottiene molto amore.",shape=box,color=blue];
		j992448758 -> j3658292683;
	j3200108456 [label="Mi chiedo semplicemente, la nostra fede ti porta pace ?",shape=box,color=blue];
		j3200108456 -> j1611490418;
		j3200108456 -> j254995397;
		j3200108456 -> j1614892723;
	j1858222300 [label="Questo è un dono raro... e spero che tu lo sappia utilizzare. Temo che soffermarsi troppo a lungo ad un bivio significhi essere consumati dal conflitto.",shape=box,color=blue];
		j1858222300 -> j3961224525;
	j2711241192 [label="Dev'essere una vita più semplice, allora. Non vivere secondo le regole degli dei e delle chiese. Ammetto di essere un po' invidiosa.",shape=box,color=blue];
		j2711241192 -> j351898173;
	j3868677419 [label="Allora sono gelosa di te, vagabondo ! Vivere così tanti secoli, senza il bisogno di conoscere gli dei.",shape=box,color=blue];
		j3868677419 -> j351898173;
	j4042740603 [label="Sembri un discepolo di Lua, e lo dico senza offesa. Sì, l'Anziana viene a prenderci tutti e piange le sue lacrime d'argento. Ma le tue parole mi fanno pensare...",shape=box,color=blue];
		j4042740603 -> j4154062729;
	j4209530817 [label="Oui, mi chiedo. Guardo te, il ragazzino, il diavolo, persino Monsieur Loid, o le Cardinal... dietro di voi si estendono tanti secoli.",shape=box,color=blue];
		j4209530817 -> j963596401;
	j303462924 [label="Che tipo di gioco pericoloso?",shape=box,color=red];
		j303462924 -> j1251922401;
	j1680715069 [label="Anche lui non pensa che l'Uomo nel Muro sia reale?",shape=box,color=red];
		j1680715069 -> j1896062623;
	j4034911900 [label="+5 Chemistry",color=orange];
		j4034911900 -> j1263728670;
	j3313053058 [label="Sorrido per la tua saggezza e gentilezza verso le convinzioni degli altri.",shape=box,color=blue];
		j3313053058 -> j2031688072;
	j1611490418 [label="No.",shape=box,color=red];
		j1611490418 -> j2990043609;
	j254995397 [label="Sinceramente non ci penso molto.",shape=box,color=red];
		j254995397 -> j2281755746;
	j1614892723 [label="Sì.",shape=box,color=red];
		j1614892723 -> j53149498;
	j1164759203 [label="Si sa che cambiano aspetto per compiacere i seguaci di altre sette. Ma questa è la mia fede, non la tua. Non predicherò a chi non cerca conforto. Trovo che non ottenga molto amore.",shape=box,color=blue];
		j1164759203 -> j3658292683;
	j3658292683 [label="No, la mia fede è mia e la tua è solo tua. Spero semplicemente che ti porti pace.",shape=box,color=blue];
		j3658292683 -> j1611490418;
		j3658292683 -> j254995397;
		j3658292683 -> j1614892723;
	j3961224525 [label="Alla fine, tutti devono scegliere un percorso da seguire. Ma il bivio è il punto da cui tutti dobbiamo partire, l'equilibrio è il fondamento di tutte le strutture.",shape=box,color=blue];
		j3961224525 -> j128475864;
	j351898173 [label="Ma mi chiedo... questo non credere, ti porta pace ?",shape=box,color=blue];
		j351898173 -> j1611490418;
		j351898173 -> j254995397;
		j351898173 -> j1614892723;
	j4154062729 [label="Di chi parli quando dici che ''dovrebbe'' toccare a tutti ? Guardo te, il ragazzino, il diavolo, persino Monsieur Loid, o le Cardinal... dietro di voi si estendono tanti secoli.",shape=box,color=blue];
		j4154062729 -> j963596401;
	j963596401 [label="Mi chiedo quanti secoli ci separano ora, prima che Lua venga a prenderci. E mi chiedo con quanto entusiasmo la abbraccerò quando quel giorno arriverà. Ma questa è la mia fede, non la tua.",shape=box,color=blue];
		j963596401 -> j351898173;
	j1251922401 [label="Non lo so ancora. Tiene per sé i suoi piani come un buon diavolo. Ma non crede in nessun dio. Tranne, forse, se stesso.",shape=box,color=blue];
		j1251922401 -> j351898173;
	j1896062623 [label="Non, non ci crede. È molto simile a te, non crede in nessun dio. Tranne, forse, se stesso.",shape=box,color=blue];
		j1896062623 -> j351898173;
	j1263728670 [label="Non, chiunque venga con una mente aperta verrà accolto a braccia aperte.",shape=box,color=blue];
		j1263728670 -> j2031688072;
	j2031688072 [label="Mi chiedo semplicemente, questo ti porta pace?",shape=box,color=blue];
		j2031688072 -> j1611490418;
		j2031688072 -> j254995397;
		j2031688072 -> j1614892723;
	j2990043609 [label="Boolean DrifterFaithNoPeace is now true.",color=orange];
		j2990043609 -> j930405531;
	j2281755746 [label="+10 Chemistry",color=orange];
		j2281755746 -> j2517865643;
	j53149498 [label="+10 Chemistry",color=orange];
		j53149498 -> j1953451782;
	j128475864 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j128475864 -> j2866370471;
	j930405531 [label="+10 Chemistry",color=orange];
		j930405531 -> j3829057214;
	j2517865643 [label="La mia gelosia è immensa! Mi consumerebbe. Mi... piacerebbe parlarti di nuovo di questo, se me lo permettessi. Non voglio fare prediche o essere indiscreta. Non voglio disturbarti.",shape=box,color=blue];
		j2517865643 -> j2731697231;
	j1953451782 [label="Allora so che il mio Sol ti sorride, che tu lo preghi o no, perché hai trovato l'unica strada di cui hai bisogno.",shape=box,color=blue];
		j1953451782 -> j2821211253;
	j2866370471 [label="Ah, perdonne-moi ! La piccola Marie sta predicando, che imbarazzo ! Non sono venuta qui per farti la predica come una maestra di scuola.",shape=box,color=blue];
		j2866370471 -> j3200108456;
	j3829057214 [label="Mi commuove profondamente la tua onestà, vagabondo. Sarei... ansiosa di parlarti di nuovo di questo, se me lo permettessi. Non voglio fare prediche o essere indiscreta. Non voglio disturbarti.",shape=box,color=blue];
		j3829057214 -> j2731697231;
	j2731697231 [label="Sono solo curiosa e vorrei aiutarti se posso. Dimmi di no e non ne parleremo mai più.",shape=box,color=blue];
		j2731697231 -> j3391214330;
		j2731697231 -> j862638126;
	j2821211253 [label="Mi chiedo, possiamo parlarne di nuovo ? Sono davvero curiosa di saperne di più.",shape=box,color=blue];
		j2821211253 -> j3391214330;
		j2821211253 -> j862638126;
	j3391214330 [label="No, grazie.",shape=box,color=red];
		j3391214330 -> j580119765;
	j862638126 [label="Certamente.",shape=box,color=red];
		j862638126 -> j3648575662;
	j580119765 [label="Boolean DrifterFaithStop is now true.",color=orange];
		j580119765 -> j2755927653;
	j3648575662 [label="Merci, merci ! Ho molta fiducia in ciò che mi hai appena donato. Non lo sprecherò. Fino ad allora.",shape=box,color=blue];
		j3648575662 -> "Chat ends.";
	j2755927653 [label="Capisco perfettamente e non mi offendo. Grazie per avermi ascoltata e ti sono grata per ciò che hai condiviso. Parleremo di altri argomenti, solo Sol sa quanti ne abbiamo !",shape=box,color=blue];
		j2755927653 -> "Chat ends.";
}