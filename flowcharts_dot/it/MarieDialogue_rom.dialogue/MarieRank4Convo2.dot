		j1303499029 -> j3022154951;
	j2106179358 [label="Oui, e se fossi come Lyon, ti direi che la tua penitenza sono dieci frustate ! Ma non lo sei. E sei perdonato.",shape=box,color=blue];
		j2106179358 -> j3022154951;
	j131696694 [label="Ma finché non faccio del male a nessuno con le mie convinzioni, non vedo nulla di male nel mantenerle, oui ?",shape=box,color=blue];
		j131696694 -> j3398377773;
