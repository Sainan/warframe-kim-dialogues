	j1793786821 [label="Cosa mi dà questa certezza, ti chiedi ? Quando dici che non possiamo conoscere l'universo ?",shape=box,color=blue];
		j1793786821 -> j1803469494;
	j1609594937 [label="Non avendo alcuna fede, capisco perché questo possa sembrare strano, oui.",shape=box,color=blue];
