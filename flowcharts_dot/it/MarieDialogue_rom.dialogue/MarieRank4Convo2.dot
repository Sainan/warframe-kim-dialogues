		j105595523 -> j2079140404;
	j2271681090 [label="Allora sono invidiosa ! La maggior parte delle persone non è così fortunata da avere un evento a cui poter fare riferimento, oui ?",shape=box,color=blue];
		j2271681090 -> j1369515324;
	j4202504783 [label="Ah, allora le nostre risposte sono le stesse. Non ho mai visto un miracolo, salvo forse l'arrivo de le Cardinal alla Cathédrale.",shape=box,color=blue];
		j4202504783 -> j1246278122;
