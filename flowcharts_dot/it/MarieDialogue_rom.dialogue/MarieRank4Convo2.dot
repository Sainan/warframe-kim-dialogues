		j3080931226 -> j1656274931 [label=true,color=green];
		j3080931226 -> j1033496217 [label=false,color=brown];
	j1762279332 [label="Non, ho sempre semplicemente sentito come se ci fosse una presenza nella mia vita lì per guidarmi. Un benefattore che sorride e mi indica la strada quando arrivo a un bivio, niente di più.",shape=box,color=blue];
		j1762279332 -> j4224889927;
		j1762279332 -> j1463139772;
	j33841018 [label="Onestamente? Sì, più o meno. Non volevo però esprimermi in questo modo.",shape=box,color=red];
		j33841018 -> j2503259969;
	j1035128793 [label="Mi chiedevo piuttosto se ci fosse stato un evento o... un momento che ti avesse portata a questo.",shape=box,color=red];
		j1035128793 -> j1803469494;
	j1503626577 [label="Neanch'io ! Ma le possibilità ora sono infinite !",shape=box,color=blue];
		j1503626577 -> j3505455709;
	j3813428460 [label="Peut-être ! Perché le possibilità ora sono infinite !",shape=box,color=blue];
		j3813428460 -> j3505455709;
	j2282264415 [label="Perché il diavolo mi aveva detto che lo avresti fatto.",shape=box,color=blue];
		j2282264415 -> j3893403043;
	j1406384918 [label="Oh ! Oh, perdonami ! Mi dispiace. Cosa volevi chiedermi ? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		j1406384918 -> j3388389049;
		j1406384918 -> j4115718638;
	j3546496576 [label="E tu dici che non ti porta molta pace... questo mi spezza il cuore.",shape=box,color=blue];
		j3546496576 -> j2003147658;
	j2003147658 [label="Non ti dirò cosa fare. E non ti dirò quali strade cercare.",shape=box,color=blue];
		j2003147658 -> j1972784193;
	j1750056226 [label="Non ne sono sicuro, ad essere onesto. È stato impulsivo.",shape=box,color=red];
		j1750056226 -> j2563738126;
	j2079140404 [label="Ho pensato che potesse essere un modo per conoscerti meglio...",shape=box,color=red];
		j2079140404 -> j1260972024;
	j1369515324 [label="Ma la tua domanda riguardava il motivo per cui credo, e sono stata piuttosto maleducata, je m'excuse.",shape=box,color=blue];
		j1369515324 -> j1803469494;
	j1246278122 [label="Anche allora, quello fu un atto dell'uomo e della scienza, non dei Luminari, non ? Questo sérum che mi ha dato il dono del volo -",shape=box,color=blue];
		j1246278122 -> j3788614726;
	j1656274931 [label="Ma dici che non ti porta molta pace ? Questo mi spezza il cuore...",shape=box,color=blue];
		j1656274931 -> j4079313263;
	j1033496217 [label="Penso che la tua fede sia la più forte di tutte, non ?",shape=box,color=blue];
		j1033496217 -> j3251533930;
	j4224889927 [label="Non definiresti miracoloso il siero di Entrati?",shape=box,color=red];
		j4224889927 -> j1246278122;
	j1463139772 [label="Nemmeno le voci di Lyon? O l'Indifferenza?",shape=box,color=red];
		j1463139772 -> j477438573;
	j2503259969 [label="Oh, mi sento sciocca perché pensavo che credere nei Luminari sia una delle cose più gentili che si possa pensare di qualcuno che ha una fede diversa.",shape=box,color=blue];
		j2503259969 -> j3221891739;
	j3505455709 [label="Il diavolo dovrebbe avere molta paura ! Attento, maligno ! La luce ti colpirà dall'alto !",shape=box,color=blue];
		j3505455709 -> j2718912295;
	j3893403043 [label="Non, non, non... Non mi volevi chiedere quello, vero ? Ah !! Je vais lui faire bouffer un de ces livres!",shape=box,color=blue];
		j3893403043 -> j1031908488;
	j1972784193 [label="Perché io sono un piccolo rifugio in questa tempesta Void in cui ti sei ritrovato.",shape=box,color=blue];
		j1972784193 -> j3895047835;
	j2563738126 [label="Non so quale istinto ti abbia spinto a dirmi queste cose. Ma sono contenta che tu ora abbia detto la verità.",shape=box,color=blue];
		j2563738126 -> j784996917;
	j1260972024 [label="Oh... non c'era bisogno che mi dicessi queste cose per conoscermi.",shape=box,color=blue];
		j1260972024 -> j784996917;
	j3788614726 [label="È il prodotto di un uomo. Ma credo che sia stato Sol a guidare le nostre strade affinché si unissero.",shape=box,color=blue];
		j3788614726 -> j635990532;
	j4079313263 [label="Mi sembra che tu stia vagando nei boschi, cercando disperatamente un sentiero.",shape=box,color=blue];
		j4079313263 -> j1961614658;
	j3251533930 [label="Percorrere il sentiero nel bosco semplicemente con la speranza che il cuore ti indichi la strada ?",shape=box,color=blue];
		j3251533930 -> j1493746300;
	j477438573 [label="Potrebbe essere, non lo so. Forse il diavolo ha ragione, ed è tutto frutto di una scienza che ancora non comprendiamo. Le due cose non si escludono, non ?",shape=box,color=blue];
		j477438573 -> j635990532;
	j3221891739 [label="Non mi offende per niente e sono contenta della tua onestà, sempre. ",shape=box,color=blue];
		j3221891739 -> j1803469494;
	j2718912295 [label="+20 Chemistry",color=orange];
		j2718912295 -> j3199134152;
	j1031908488 [label="Cos'è che volevi chiedermi ? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		j1031908488 -> j3388389049;
		j1031908488 -> j4115718638;
	j3895047835 [label="Ma mi chiedo se non ti trovi a un bivio e vorresti riflettere su quale strada prendere, non ?",shape=box,color=blue];
		j3895047835 -> j3486004159;
	j784996917 [label="Un'anima è più della fede che indossa. Io sono une Sœur de Sol, ma spero che tu veda in me qualcosa in più, non ?",shape=box,color=blue];
		j784996917 -> j3112204153;
	j635990532 [label="Ecco perché credo. Sento Sol accanto a me quando arrivo nei luoghi in cui sono più insicura. Chiudo gli occhi e lui è lì, a guidarmi.",shape=box,color=blue];
		j635990532 -> j452557450;
		j635990532 -> j2122359596;
		j635990532 -> j2974582309;
	j1961614658 [label="Non so se lo troverai mai, ma prego che tu ci riesca. Perché quello che potresti scoprire lì sarebbe un miracolo. ",shape=box,color=blue];
		j1961614658 -> j1369515324;
	j1493746300 [label="È bellissimo...",shape=box,color=blue];
		j1493746300 -> j1369515324;
	j3199134152 [label="Sainte Mère Sol, vous avez béni votre fille aujourd'hui ! HA-HA !!",shape=box,color=blue];
		j3199134152 -> "Chat ends.";
	j3486004159 [label="L'obbligo non è una ragione per credere. Nella migliore delle ipotesi, genera solo dubbi e, nella peggiore, vuoto disprezzo.",shape=box,color=blue];
		j3486004159 -> j1284563625;
	j3112204153 [label="Gli argomenti che potremmo scegliere sono tanti quante sono le stelle nel cielo !",shape=box,color=blue];
		j3112204153 -> j1565373720;
		j3112204153 -> j1515493199;
	j452557450 [label="Meraviglioso.",shape=box,color=red];
		j452557450 -> j488410356;
	j2122359596 [label="Ti è mai capitato che non ti guidasse?",shape=box,color=red];
