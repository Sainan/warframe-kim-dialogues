	j3109948977 [label="Dovrei preoccuparmi?",shape=box,color=red];
		j3109948977 -> j3813428460;
	j93168966 [label="Come hai fatto a indovinare che era proprio quello che volevo chiederti? È incredibile.",shape=box,color=red];
