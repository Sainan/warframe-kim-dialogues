		j752401725 -> j1989079078;
		j752401725 -> j3109948977;
	j1243846859 [label="Oui ! Non amo i fiori recisi. Se vuoi farmi un regalo, spero che non sia rose in un vaso.",shape=box,color=blue];
		j1243846859 -> j93168966;
		j1243846859 -> j774013985;
	j3648719684 [label="Pour toi ? Bien sûr.",shape=box,color=blue];
		j3648719684 -> j3388389049;
		j3648719684 -> j4115718638;
	j1453680490 [label="Io... suppongo di sentirmi obbligato a farlo.",shape=box,color=red];
		j1453680490 -> j3222404579;
	j3852841804 [label="Non sono stato molto onesto con te quando ti ho dato quella risposta.",shape=box,color=red];
		j3852841804 -> j105595523;
	j1989520292 [label="Ho avuto un'esperienza che mi ha cambiato la vita.",shape=box,color=red];
		j1989520292 -> j2271681090;
	j2533009979 [label="Non è mai successo niente, è solo qualcosa che ho sentito. Mi ha guidato.",shape=box,color=red];
		j2533009979 -> j4202504783;
	j3348575358 [label="Voglio credere. Quindi, ci credo.",shape=box,color=red];
		j3348575358 -> j3080931226;
	j1803469494 [label="Temo che la mia risposta possa deluderti, lupo. Non c'è stato nessun grande miracolo. Nessun raggio dal cielo che abbia brillato su di me.",shape=box,color=blue];
		j1803469494 -> j1762279332;
	j3586141584 [label="\"Perché questa giovane sensibile donna crede in cose che io non ritengo reali, che mi sembrano sciocchezze,\" non ?",shape=box,color=blue];
		j3586141584 -> j33841018;
