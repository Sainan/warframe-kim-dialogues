	j2974582309 [label="Vorrei avere lo stesso...",shape=box,color=red];
		j2974582309 -> j3217181834;
	j1284563625 [label="La fede dovrebbe essere un toccasana per l'anima. Non una stampella o una scusa.",shape=box,color=blue];
		j1284563625 -> j4060376250;
	j1565373720 [label="Mi perdoni allora?",shape=box,color=red];
		j1565373720 -> j1303499029;
	j1515493199 [label="Scusa. È stata una cosa sciocca.",shape=box,color=red];
		j1515493199 -> j2106179358;
	j488410356 [label="Oui, e so di essere fortunata. Ed è una pace che è facile cercare di imporre agli altri, che la vogliano o no.",shape=box,color=blue];
		j488410356 -> j131696694;
	j2853574604 [label="Oui, molte volte. E in quei momenti, rifletto sul perché. Forse sono destinata a trovare semplicemente la mia strada, non ? Ou peut-être que je suis une folle après tout, hah ! Non siamo sempre destinati a saperlo.",shape=box,color=blue];
		j2853574604 -> j131696694;
	j3217181834 [label="Oui, e prego che un giorno tu possa averla. Ma non è qualcosa che può essere dato o insegnato, è qualcosa che deve essere trovato.",shape=box,color=blue];
		j3217181834 -> j1120431579;
	j4060376250 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j4060376250 -> j1369515324;
