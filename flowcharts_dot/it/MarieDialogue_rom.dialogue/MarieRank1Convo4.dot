	"MarieRank1Convo4 begins." [color=orange];
		"MarieRank1Convo4 begins." -> j3710238377;
	j3710238377 [label="Posso farti una domanda che spero non risulti scortese ? Siamo ancora agli inizi della nostra amicizia, soprattutto con te che, a quanto pare, ci conosciamo da così tanti anni.",shape=box,color=blue];
		j3710238377 -> j283025208;
		j3710238377 -> j920651226;
		j3710238377 -> j4115718638;
	j283025208 [label="Onestamente, ho dimenticato la maggior parte degli anni che ho conosciuto. ",shape=box,color=red];
		j283025208 -> j1037455796;
	j920651226 [label="Certo che puoi. Spara.",shape=box,color=red];
		j920651226 -> j2947588656;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j1037455796 [label="Sol ! Mi spezzi il cuore con le tue parole. Tu e il diavolo avete le menti prive di conoscenza come un libro a cui sono stati tolti dei capitoli, non ?",shape=box,color=blue];
		j1037455796 -> j1792580151;
		j1037455796 -> j1339859489;
	j2947588656 [label="+5 Chemistry",color=orange];
		j2947588656 -> j523704316;
	"Chat ends." [color=orange];
	j1792580151 [label="Non sento la mancanza del passato che non ricordo.",shape=box,color=red];
		j1792580151 -> j4066070367;
	j1339859489 [label="Anche se per ragioni molto diverse, sì.",shape=box,color=red];
		j1339859489 -> j413771721;
	j523704316 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j523704316 -> j3384590385 [label="x > 0",color=purple];
		j523704316 -> j4209758706 [label="x <= 0",color=purple];
		j523704316 -> j4209758706 [label="false",color=purple];
	j4066070367 [label="Davvero ? Sembra che tu sia l'unico però. Tra il ragazzino e il diavolo, sembra che tutti stiano cercando parti di sé che hanno smarrito.",shape=box,color=blue];
		j4066070367 -> j2530649749;
		j4066070367 -> j3535534498;
	j413771721 [label="È troppo da parte mia chiederti perché sembri così perso ? Conosco le ragioni del ragazzino e del diavolo, ma non le tue.",shape=box,color=blue];
		j413771721 -> j2530649749;
		j413771721 -> j3535534498;
	j3384590385 [label="Perché hai accettato di aiutare il diavolo nei suoi intenti ? Ho sentito dire che sei responsabile del massacro della sua stirpe.",shape=box,color=blue];
		j3384590385 -> j1236611671;
		j3384590385 -> j3978775219;
		j3384590385 -> j1174993613;
	j4209758706 [label="Hai intenzione di aiutare il diavolo nei suoi intenti ? Ho sentito dire che sei responsabile del massacro della sua stirpe.",shape=box,color=blue];
		j4209758706 -> j1236611671;
		j4209758706 -> j3978775219;
		j4209758706 -> j1174993613;
	j2530649749 [label="Ho trascorso un numero imprecisato di anni morendo per mano di... beh? Me stesso. Non mi dispiace non riuscire a ricordarli tutti.",shape=box,color=red];
		j2530649749 -> j4122875133;
	j3535534498 [label="Per riassumere, ho passato... molti anni a soffrire. Immagino che sia una sorta di meccanismo di autodifesa, dimenticare.",shape=box,color=red];
		j3535534498 -> j3239764963;
	j1236611671 [label="Quello era il mio altro io. Credo che la colpa debba essere attribuita agli individui, non alla società.",shape=box,color=red];
		j1236611671 -> j1931453681;
	j3978775219 [label="Non ero io, era il ragazzino. Ma odio gli Orokin in egual misura.",shape=box,color=red];
		j3978775219 -> j2941901519;
	j1174993613 [label="Non c'ero, la Notte dei Tamburi Naga, quando i Tenno si rivoltarono contro gli Orokin. Quello era il ragazzino.",shape=box,color=red];
		j1174993613 -> j237923514;
	j4122875133 [label="Né ti biasimo. Se fossi vittima di questo tipo di abuso, sarei abbastanza ansiosa di nascondere tutto. Come minimo, non andrei a cercarlo.",shape=box,color=blue];
		j4122875133 -> j3018786318;
	j3239764963 [label="Non ne ho dubbi ! Se fossi soggetta a questo tipo di abuso, mi aspetterei che la mia anima facesse qualcosa di simile. Nascondere tutto ciò che non può essere riparato e che non serve a nulla.",shape=box,color=blue];
		j3239764963 -> j3018786318;
	j1931453681 [label="Add 1 to Thermostat counter",color=orange];
		j1931453681 -> j3755300693;
	j2941901519 [label="Add -1 to Thermostat counter",color=orange];
		j2941901519 -> j3753117005;
	j237923514 [label="La Notte dei Tamburi Naga. Oh, riesco a vederla nella mia mente. Quelles couleurs magnifiques !",shape=box,color=blue];
		j237923514 -> j2954412962;
	j3018786318 [label="+5 Chemistry",color=orange];
		j3018786318 -> j3432347886;
	j3755300693 [label="Oui, je comprends. Siamo così veloci a bruciare l'edificio, quando la puzza è colpa dei topi che vivono tra le sue mura.",shape=box,color=blue];
		j3755300693 -> j2549033159;
	j3753117005 [label="Je meurs d'envie de savoir pourquoi! Ma questa è una conversazione per un altro giorno, altrimenti restiamo qui a parlare e Monsieur Loid si arrabbia con me.",shape=box,color=blue];
		j3753117005 -> j4192617946;
	j2954412962 [label="Dovrò parlare con Monsieur Loid per ulteriori dettagli. Ma !",shape=box,color=blue];
		j2954412962 -> j4192617946;
	j3432347886 [label="Tuttavia, questo potrebbe darmi qualche spunto su ciò di cui volevo parlarti.",shape=box,color=blue];
		j3432347886 -> j523704316;
	j2549033159 [label="Ma questa è una conversazione per un altro giorno, altrimenti restiamo qui a parlare e Monsieur Loid si arrabbia con me.",shape=box,color=blue];
		j2549033159 -> j4192617946;
	j4192617946 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4192617946 -> j1646072512 [label="x > 0",color=purple];
		j4192617946 -> j19283436 [label="x <= 0",color=purple];
		j4192617946 -> j19283436 [label="false",color=purple];
	j1646072512 [label="Pardonnez-moi! Non ti sto dando la possibilità di rispondere. Perché aiuterai il diavolo allora?",shape=box,color=blue];
		j1646072512 -> j893833606;
		j1646072512 -> j3926809127;
		j1646072512 -> j1659730683;
		j1646072512 -> j195210035;
	j19283436 [label="Pardonnez-moi! Non ti sto dando la possibilità di rispondere. Aiuterai il diavolo allora?",shape=box,color=blue];
		j19283436 -> j195210035;
		j19283436 -> j1659730683;
		j19283436 -> j3926809127;
		j19283436 -> j893833606;
	j893833606 [label="Non ha fatto nulla per non meritarsi di essere aiutato... almeno per il momento.",shape=box,color=red];
		j893833606 -> j1999131031;
	j3926809127 [label="Non credo di potermi permettere di rifiutare gli alleati.",shape=box,color=red];
		j3926809127 -> j1307636064;
	j1659730683 [label="[Confessa di provare interesse per Roathe.] C'è qualcosa di irresistibile in lui...",shape=box,color=red];
		j1659730683 -> j2214286617;
	j195210035 [label="Sembra che stia facendo tutto il necessario per sopravvivere. Non posso biasimarlo per questo.",shape=box,color=red];
		j195210035 -> j4159845081;
	j1999131031 [label="Add 1 to Thermostat counter",color=orange];
		j1999131031 -> j4086190436;
	j1307636064 [label="Boolean MarieRoatheSoldier is now true.",color=orange];
		j1307636064 -> j2333678463;
	j2214286617 [label="Boolean DrifterRoathe is now true.",color=orange];
		j2214286617 -> j3137951243;
	j4159845081 [label="Add -1 to Thermostat counter",color=orange];
		j4159845081 -> j1455640159;
	j4086190436 [label="+5 Chemistry",color=orange];
		j4086190436 -> j4050077060;
	j2333678463 [label="Ah, capisco. Il tuo unico scopo è collezionare soldati. Ma quel diavolo preferirebbe conficcarti un pugnale tra le costole piuttosto che guardarti le spalle.",shape=box,color=blue];
		j2333678463 -> j2609414373;
	j3137951243 [label="Le diable séduit les cœurs les plus forts. Gioca con l'astuzia, ma fai attenzione. Assicurati che sia lui a incrociare il tuo sguardo e nient'altro. ",shape=box,color=blue];
		j3137951243 -> j1005489278;
	j1455640159 [label="Mi sembra che sia sopravvissuto più a lungo di quanto chiunque dovrebbe. Penso che forse l'inferno dovrebbe venire e reclamare ciò che gli appartiene, visto quanto tempo è passato.",shape=box,color=blue];
		j1455640159 -> j1005489278;
	j4050077060 [label="Lodo la tua compassione, mi riempie il cuore di gioia. I Luminari ci insegnano che si può aiutare tutti. E perdonare tutti. Ma... solo se lo domandano.",shape=box,color=blue];
		j4050077060 -> j107405752;
	j2609414373 [label="Non è un tuo alleato, e non lo sarà mai. Quel diavolo si schiera solo con chi serve i suoi bisogni.",shape=box,color=blue];
		j2609414373 -> j220181357;
		j2609414373 -> j2911506882;
		j2609414373 -> j1041432898;
	j1005489278 [label="+5 Chemistry",color=orange];
		j1005489278 -> j2988756123;
	j107405752 [label="La fatica senza fine di aiutare coloro che non sudano mai nel campo della propria redenzione è la vita di uno schiavo lasciato nel bisogno.",shape=box,color=blue];
		j107405752 -> j220181357;
		j107405752 -> j2911506882;
		j107405752 -> j1041432898;
	j220181357 [label="Ne so più di te sugli Orokin e sulla loro situazione. Non ho bisogno del tuo aiuto.",shape=box,color=red];
		j220181357 -> j3154457380;
	j2911506882 [label="Apprezzo i tuoi avvertimenti. Li terrò a mente quando avrò a che fare con lui.",shape=box,color=red];
		j2911506882 -> j2954452651;
	j1041432898 [label="Grazie. Ma so cavarmela da solo. E, cosa ancora più importante? Ne ho passate di peggio.",shape=box,color=red];
		j1041432898 -> j1150376826;
	j2988756123 [label="Ma sono un po' scortese... tu non lo conosci. Non lo vedi per quello che è. Semplicemente non voglio che tu ti faccia male.",shape=box,color=blue];
		j2988756123 -> j220181357;
		j2988756123 -> j2911506882;
		j2988756123 -> j1041432898;
	j3154457380 [label="Boolean MarieRoatheWarning is now true.",color=orange];
		j3154457380 -> j86824133;
	j2954452651 [label="+10 Chemistry",color=orange];
		j2954452651 -> j3268883392;
	j1150376826 [label="+5 Chemistry",color=orange];
		j1150376826 -> j2876383455;
	j86824133 [label="Pardon. Non conosco bene né te né la tua capacità di resistere alle manipolazioni. Sono solo preoccupata, perché abbiamo riversato su di te i nostri guai.",shape=box,color=blue];
		j86824133 -> j2225147541;
	j3268883392 [label="Questo è tutto ciò che chiedevo. Merci, merci, merci. Ora temo di dover andare.",shape=box,color=blue];
		j3268883392 -> "Chat ends.";
	j2876383455 [label="Oui, vous avez raison. Non conosco bene né te né la tua capacità di resistere alle manipolazioni. Sono solo preoccupata, perché abbiamo riversato su di te i nostri guai.",shape=box,color=blue];
		j2876383455 -> j463903639;
	j2225147541 [label="Non oltrepasserò più i limiti.",shape=box,color=blue];
		j2225147541 -> "Chat ends.";
	j463903639 [label="E ora, temo di dover andare.",shape=box,color=blue];
		j463903639 -> "Chat ends.";
}