	248 [label="Hai intenzione di aiutare il diavolo nei suoi intenti ? Ho sentito dire che sei responsabile del massacro della sua stirpe.",shape=box,color=blue];
		248 -> 252;
		248 -> 253;
		248 -> 254;
	255 [label="Ho trascorso un numero imprecisato di anni morendo per mano di... beh? Me stesso. Non mi dispiace non riuscire a ricordarli tutti.",shape=box,color=red];
		255 -> 260;
	256 [label="Per riassumere, ho passato... molti anni a soffrire. Immagino che sia una sorta di meccanismo di autodifesa, dimenticare.",shape=box,color=red];
		256 -> 261;
	252 [label="Quello era il mio altro io. Credo che la colpa debba essere attribuita agli individui, non alla società.",shape=box,color=red];
		252 -> 257;
	253 [label="Non ero io, era il ragazzino. Ma odio gli Orokin in egual misura.",shape=box,color=red];
		253 -> 258;
	254 [label="Non c'ero, la Notte dei Tamburi Naga, quando i Tenno si rivoltarono contro gli Orokin. Quello era il ragazzino.",shape=box,color=red];
		254 -> 259;
	260 [label="Né ti biasimo. Se fossi vittima di questo tipo di abuso, sarei abbastanza ansiosa di nascondere tutto. Come minimo, non andrei a cercarlo.",shape=box,color=blue];
		260 -> 265;
	261 [label="Non ne ho dubbi ! Se fossi soggetta a questo tipo di abuso, mi aspetterei che la mia anima facesse qualcosa di simile. Nascondere tutto ciò che non può essere riparato e che non serve a nulla.",shape=box,color=blue];
		261 -> 265;
