		237 -> 238;
	238 [label="Posso farti una domanda che spero non risulti scortese ? Siamo ancora agli inizi della nostra amicizia, soprattutto con te che, a quanto pare, ci conosciamo da così tanti anni.",shape=box,color=blue];
