	250 [label="Davvero ? Sembra che tu sia l'unico però. Tra il ragazzino e il diavolo, sembra che tutti stiano cercando parti di sé che hanno smarrito.",shape=box,color=blue];
		250 -> 255;
		250 -> 256;
	251 [label="È troppo da parte mia chiederti perché sembri così perso ? Conosco le ragioni del ragazzino e del diavolo, ma non le tue.",shape=box,color=blue];
		251 -> 255;
		251 -> 256;
	249 [label="Perché hai accettato di aiutare il diavolo nei suoi intenti ? Ho sentito dire che sei responsabile del massacro della sua stirpe.",shape=box,color=blue];
		249 -> 252;
