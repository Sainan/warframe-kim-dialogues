	281 [label="Ah, capisco. Il tuo unico scopo è collezionare soldati. Ma quel diavolo preferirebbe conficcarti un pugnale tra le costole piuttosto che guardarti le spalle.",shape=box,color=blue];
		281 -> 284;
	280 [label="Le diable séduit les cœurs les plus forts. Gioca con l'astuzia, ma fai attenzione. Assicurati che sia lui a incrociare il tuo sguardo e nient'altro. ",shape=box,color=blue];
		280 -> 283;
	279 [label="Mi sembra che sia sopravvissuto più a lungo di quanto avrebbe dovuto chiunque altro. Penso che forse l'inferno dovrebbe tornare e reclamare ciò che gli appartiene, visto che sembra essersi allontanato.",shape=box,color=blue];
		279 -> 283;
	285 [label="Lodo la tua compassione, mi riempie il cuore di gioia. I Luminari ci insegnano che si può aiutare tutti. E perdonare tutti. Ma... solo se lo domandano.",shape=box,color=blue];
		285 -> 290;
