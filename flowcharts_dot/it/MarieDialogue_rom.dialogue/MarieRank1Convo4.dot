	259 [label="La Notte dei Tamburi Naga. Oh, riesco a vederla nella mia mente. Quelles couleurs magnifiques !",shape=box,color=blue];
		259 -> 264;
	265 [label="+5 Chemistry",color=orange];
		265 -> 268;
	262 [label="Oui, je comprends. Siamo così veloci a bruciare l'edificio, quando la puzza è colpa dei topi che vivono tra le sue mura.",shape=box,color=blue];
		262 -> 266;
	263 [label="Je meurs d'envie de savoir pourquoi! Ma questa è una conversazione per un altro giorno, altrimenti restiamo qui a parlare e Monsieur Loid si arrabbia con me.",shape=box,color=blue];
