		j1660217190 -> j3724288615;
	j2728527911 [label="Per cortesia... ti prego di non pensare male del mio caro Lyon. Non è infirme, te lo prometto. Ciò che lo affligge non è une maladie de l'esprit.",shape=box,color=blue];
		j2728527911 -> j3499811920;
	j4172995403 [label="Posso solo rispettare la tua convinzione, anche se non sono d'accordo.",shape=box,color=blue];
		j4172995403 -> j2401693945;
	j739940036 [label="Oui, esatto. Se entri nell'aldilà con il cuore pesante, la tua anima non può volare.",shape=box,color=blue];
