		j1472230597 -> j2771344332;
	j3335832636 [label="Penso che sia solo questione di quando. ",shape=box,color=red];
		j3335832636 -> j3821871294;
	j1238334361 [label="Sai, non te ne faccio una colpa.",shape=box,color=blue];
		j1238334361 -> j4119432801;
		j1238334361 -> j891895498;
	j2469715025 [label="Oui, oui - Ho sentito gli altri parlare di questo mondo che hai creato. Quando eri completamente solo e non avevi nessun altro.",shape=box,color=blue];
		j2469715025 -> j1238334361;
	j2677843216 [label="Cardinal Dimanche è un genio, benedetto dai Luminari. Ci guiderà.",shape=box,color=blue];
