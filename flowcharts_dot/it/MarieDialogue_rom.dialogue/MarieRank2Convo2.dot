		j1038421430 -> j1015334398;
	j2101891486 [label="Era un pomeriggio splendido e soleggiato. Lo ricordo in piedi davanti all'altare, con lo sguardo rivolto verso la vetrata e un sorriso stampato in volto, anche se non ne capivo il motivo.",shape=box,color=blue];
		j2101891486 -> j2804788337;
	j1396155017 [label="Cercare di riparare il danno causato è importante, non fraintendermi. Quando possibile, essere perdonati da chi è stato ferito è un toccasana.",shape=box,color=blue];
		j1396155017 -> j3595539799;
	j1788725917 [label="Oh, non voglio dire che non sia importante chiedere perdono a coloro a cui abbiamo fatto del male ! Lo è !",shape=box,color=blue];
		j1788725917 -> j2049676050;
	j2330050192 [label="Parlami ancora una volta di coloro che sono ''semplicemente uomini'' e farò del mio meglio per non ridere, ti do la mia parola.",shape=box,color=blue];
		j2330050192 -> j2069966767;
	j2928289647 [label="La fede non è una costante. È come la marea. Va e viene, e va bene così.",shape=box,color=blue];
		j2928289647 -> j1423925935;
	j1423925935 [label="Ma, temo che tutto questo non riguardi ciò di cui sei venuto a parlarmi. Volevi una storia, non ?",shape=box,color=blue];
		j1423925935 -> j2101891486;
	j3695710233 [label="Posso credere nelle persone e negli dei in modo diverso.",shape=box,color=red];
		j3695710233 -> j3381008726;
