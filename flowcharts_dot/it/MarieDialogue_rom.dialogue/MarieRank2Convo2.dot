	j2563527179 [label="Certo, sì, se tutti fossero d'accordo. ",shape=box,color=red];
		j2563527179 -> j1038421430;
	j3184944388 [label="Ah ! Ma sei qui per una storia ! Ti ho rubato così tanto tempo, sarò breve.",shape=box,color=blue];
		j3184944388 -> j2101891486;
	j284373082 [label="Interessante. Perché dici questo?",shape=box,color=red];
		j284373082 -> j1396155017;
	j1912644162 [label="Anche se hai fatto un torto a qualcun altro?",shape=box,color=red];
		j1912644162 -> j1788725917;
	j3070769369 [label="Ho rotto il digiuno con gli animali che mi hanno chiesto informazioni sulla qualità del mio riposo.",shape=box,color=blue];
		j3070769369 -> j2330050192;
	j3336962238 [label="Add 1 to Thermostat counter",color=orange];
		j3336962238 -> j3514627686;
	j2382908919 [label="Add -1 to Thermostat counter",color=orange];
		j2382908919 -> j2928289647;
	j3514627686 [label="La portiamo perchè dobbiamo. Perché non conosciamo altro modo di essere. Non importa cosa significhi alla fine. So come ti senti.",shape=box,color=blue];
		j3514627686 -> j1423925935;
	j3198658656 [label="Per anime come la nostra, la fede è come una torcia - la portiamo sempre con noi, anche se alla fine potrebbe bruciarci.",shape=box,color=blue];
		j3198658656 -> j4245116441;
		j3198658656 -> j4212287411;
	j2781735218 [label="Anche se mi sorprende, in precedenza hai espresso dubbi sulla fede.",shape=box,color=blue];
		j2781735218 -> j3695710233;
		j2781735218 -> j2379017166;
	j2156817715 [label="Anche se mi sorprende. Prima hai detto di essere una creatura di poca fede.",shape=box,color=blue];
		j2156817715 -> j3695710233;
		j2156817715 -> j2379017166;
	j1648992792 [label="Per anime come la mia, la fede è come una torcia - la portiamo sempre con noi, anche se alla fine potrebbe bruciarci.",shape=box,color=blue];
