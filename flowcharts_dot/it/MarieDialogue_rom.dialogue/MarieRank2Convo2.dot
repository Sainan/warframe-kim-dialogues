		430 -> 435;
	428 [label="Mi sento come il primo giorno in cui l'ho visto pronunciare un sermone dal pulpito ai nostri parrocchiani. Sono stata fortunata ad essere stata in sua présence.",shape=box,color=blue];
		428 -> 431;
		428 -> 432;
