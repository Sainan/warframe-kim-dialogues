		j2379017166 -> j1707165029;
	j1015334398 [label="Interessante. Non conosco abbastanza bene le usanze degli Orokin per sapere se fosse un comportamento contrario alle loro usanze. Ma so che in molte antiche culture non era mal visto.",shape=box,color=blue];
		j1015334398 -> j3335811313;
	j2804788337 [label="Si è abbassato per salutarmi, in modo che la sua testa fosse più bassa della mia.",shape=box,color=blue];
		j2804788337 -> j855846236;
	j3595539799 [label="Ma alla fine, quando affrontiamo l'Anziana, quando Lua riversa le sue lacrime argentate per noi, la morte è vicina, è il peso del nostro cuore che dobbiamo portare.",shape=box,color=blue];
		j3595539799 -> j32504547;
		j3595539799 -> j3211345889;
	j2049676050 [label="Riparare il danno causato, è un toccasana ancora più potente per l'anima. ",shape=box,color=blue];
		j2049676050 -> j3595539799;
	j2069966767 [label="Fino ad allora, ti consiglio di riconsiderare cosa significhi essere benedetti. Arrivederci.",shape=box,color=blue];
		j2069966767 -> "Chat ends.";
	j3381008726 [label="Oui, uno è tangibile. Presente. L'altro richiede che tu chiuda gli occhi e creda. ",shape=box,color=blue];
		j3381008726 -> j1423925935;
	j3335811313 [label="Ma non spetta a noi deciderlo... in questo caso, non sono qui per giudicare le professioni d'amore de le Cardinal per Monsieur Loid né le parole d'amore di M. Loid.",shape=box,color=blue];
