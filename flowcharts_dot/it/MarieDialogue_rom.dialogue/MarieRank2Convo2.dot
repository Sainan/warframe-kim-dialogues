	j1560697189 [label="Come hai conosciuto Entrati?",shape=box,color=red];
		j1560697189 -> j1103800334;
	j1492317168 [label="Posso chiederti cosa ne pensi di Entrati, ora che sei qui?",shape=box,color=red];
		j1492317168 -> j3498513117;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j1103800334 [label="Lo conoscevo come Cardinal Dimanche. Forse ti sorprenderà sapere quanti anni ha trascorso in chiesa, predicando ai nostri fedeli.",shape=box,color=blue];
		j1103800334 -> j7306403;
		j1103800334 -> j2521276514;
	j3498513117 [label="+5 Chemistry",color=orange];
		j3498513117 -> j762825942;
	"Chat ends." [color=orange];
	j7306403 [label="Pensi che fosse tutta una bugia? O pensi che lui ci credesse davvero?",shape=box,color=red];
		j7306403 -> j3595151793;
	j2521276514 [label="Non lo sono. È un bravo bugiardo.",shape=box,color=red];
		j2521276514 -> j205002884;
	j762825942 [label="Ah, una domanda molto cortese che nasconde una risposta molto provocatoria - formulata in modo abbastanza intelligente, devo ammetterlo.",shape=box,color=blue];
		j762825942 -> j2095806104;
	j3595151793 [label="Ha parlato di perdono, di famiglia, e di empatia con tale fervore e dedizione che non so come possa essere una bugia.",shape=box,color=blue];
		j3595151793 -> j3920282985;
	j205002884 [label="Mi rendo conto che le tue esperienze con lui non sono le stesse che ho avuto io. Ma devi anche capire che con me è stato solo gentile e premuroso.",shape=box,color=blue];
		j205002884 -> j958491386;
	j2095806104 [label="Mi sento come il primo giorno in cui l'ho visto pronunciare un sermone dal pulpito ai nostri parrocchiani. Sono stata fortunata ad essere stata in sua présence.",shape=box,color=blue];
		j2095806104 -> j2884237002;
		j2095806104 -> j1709462186;
		j2095806104 -> j2309968080;
	j3920282985 [label="Ha fede nei Luminari ? In Sol e Lua ? Considerando i recenti avvenimenti, non lo so più. Peu importe.",shape=box,color=blue];
		j3920282985 -> j3947278006;
	j958491386 [label="Le tue verità invalidano le mie, o a chi dovrei credere ? Dovrei condannare ogni atto di misericordia, ogni atto di gentilezza, che ha mostrato nei suoi anni trascorsi nella parrocchia ?",shape=box,color=blue];
		j958491386 -> j3712932967;
	j2884237002 [label="Sono felice di sentirlo, sinceramente. Penso che tutti siano troppo frettolosi nel condannarlo.",shape=box,color=red];
		j2884237002 -> j2819947006;
	j1709462186 [label="Pensi che stesse ingannando la gente? O pensi che ci credesse davvero?",shape=box,color=red];
		j1709462186 -> j3595151793;
	j2309968080 [label="Mi... mi dispiace che tu sia caduta nei suoi trucchi.",shape=box,color=red];
		j2309968080 -> j205002884;
	j3947278006 [label="Che importanza ha il nome degli dei che preghi, se ne porti l'amore nel cuore ? Assolutamente nessuna.",shape=box,color=blue];
		j3947278006 -> j2029905903;
		j3947278006 -> j1984925666;
	j3712932967 [label="Non. Non credo.",shape=box,color=blue];
		j3712932967 -> j1048278063;
	j2819947006 [label="+10 Chemistry",color=orange];
		j2819947006 -> j2281280487;
	j2029905903 [label="È un bel modo di vedere la cosa. ",shape=box,color=red];
		j2029905903 -> j1720959293;
	j1984925666 [label="Non sono d'accordo. Essere una persona gentile non mi rende immediatamente un seguace di un dio della gentilezza.",shape=box,color=red];
		j1984925666 -> j3141214525;
	j1048278063 [label="Perdonami, non farò di lui un mostro solo perché lo dici tu.",shape=box,color=blue];
		j1048278063 -> j2209081154;
	j2281280487 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j2281280487 -> j2789439877;
	j1720959293 [label="Credo che le Cardinal pratichi davvero la fede dei Luminari nella sua anima, anche se non crede che lo aspettino nell'aldilà.",shape=box,color=blue];
		j1720959293 -> j983329199;
	j3141214525 [label="+5 Chemistry",color=orange];
		j3141214525 -> j2088857103;
	j2209081154 [label="Boolean MarieEntratiMonster1 is now true.",color=orange];
		j2209081154 -> "Chat ends.";
	j2789439877 [label="Oh ! Come mi rallegra il cuore sentirlo. Pensavo di essere la sola a pensarlo. Sono circordata da persone che pensano solo male de le Cardinal.",shape=box,color=blue];
		j2789439877 -> j2767135312;
		j2789439877 -> j1121707590;
		j2789439877 -> j3575395228;
	j983329199 [label="Quale altro uomo conosce il valore dell'empatia contro l'oscurità dell'Indifférence, non ?",shape=box,color=blue];
		j983329199 -> j2413258194;
	j2088857103 [label="Hai ragione, non è così. Non ti definirei un Seguace di Sol solo perché segui la Sua Via per ignoranza. Più bene c'è nel mondo, migliore è il mondo, non mi interessa che nome porti.",shape=box,color=blue];
		j2088857103 -> j128071878;
	j2767135312 [label="Vorrei solo che ci fosse un modo per far sì che tutti lo perdonassero - sta facendo del suo meglio per sistemare le cose.",shape=box,color=red];
		j2767135312 -> j1586547271;
	j1121707590 [label="Hanno le loro ragioni. Ma lui è la nostra unica possibilità di fermare l'Indifferenza.",shape=box,color=red];
		j1121707590 -> j1548017838;
	j3575395228 [label="Anche Entrati non ha una grande opinione di sé. ",shape=box,color=red];
		j3575395228 -> j3794257319;
