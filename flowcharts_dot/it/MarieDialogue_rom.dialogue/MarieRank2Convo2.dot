		434 -> 437;
	435 [label="Le tue verità invalidano le mie, o a chi dovrei credere ? Dovrei condannare ogni atto di misericordia, ogni atto di gentilezza, che ha mostrato nei suoi anni trascorsi nella parrocchia ?",shape=box,color=blue];
		435 -> 438;
