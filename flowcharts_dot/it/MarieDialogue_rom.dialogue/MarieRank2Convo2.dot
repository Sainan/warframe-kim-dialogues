	j2286599701 [label="Mi fa piacere sentirlo. Perché so che hai poche ragioni per farlo. Ho sentito le storie dei Cavia.",shape=box,color=blue];
		j2286599701 -> j879010410;
	j826355440 [label="Possiamo... probabilmente supporre che sia morta.",shape=box,color=red];
		j826355440 -> j2103069460;
	j869083518 [label="No, e nessuno sembra voler parlare di lei.",shape=box,color=red];
		j869083518 -> j2103069460;
	j185994524 [label="Dobbiamo mantenere la fede. Perché se perdiamo la speranza che l'amore prevalga su tutto, allora vincerà l'oscurità.",shape=box,color=blue];
		j185994524 -> j411979059;
	j3468244471 [label="Penso che rimarresti sorpreso nello scoprire quanto poco sia mia responsabilità. ",shape=box,color=blue];
		j3468244471 -> j598974166;
	j2875474838 [label="Per non credere. Nell'Indifférence. In qualsiasi cosa. Se avessi creato un mondo du tissu du Néant - dal tessuto del Void - forse proverei le stesse sensazioni.",shape=box,color=blue];
		j2875474838 -> j598974166;
	j3734298338 [label="+5 Chemistry",color=orange];
		j3734298338 -> j2286599701;
	j2981125053 [label="Sono accanto a un diavolo che ha vissuto per innumerevoli secoli. Non lontano da me c'è una donna che è una macchina con le anime di una triplice dea.",shape=box,color=blue];
		j2981125053 -> j2379891067;
	j936338673 [label="Aha! Tu più di tutti dovresti sapere che la fede non è mai saggia. Eppure anime come la nostra la portano con sé comunque, anche se può bruciarci. Immagino che tu lo sappia, se nella nostra conversazione di prima fossi stato sincero.",shape=box,color=blue];
		j936338673 -> j4212287411;
		j936338673 -> j4245116441;
	j1588578651 [label="La fede non è mai saggia. Ma noi che la portiamo come una torcia, cerchiamo di portarla sempre con noi - anche se può bruciarci.",shape=box,color=blue];
		j1588578651 -> j433068632;
	j879010410 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j879010410 -> j1185699525;
	j2103069460 [label="E avresti mai pensato che il cuore di una persona potesse appartenere a più di un'anima ? Che si potesse amare più di una persona ?",shape=box,color=blue];
		j2103069460 -> j516941318;
		j2103069460 -> j2563527179;
	j411979059 [label="L'amore è tutto ciò che ci resta al mondo quando tutto il resto manca, non ?",shape=box,color=blue];
		j411979059 -> j3184944388;
	j598974166 [label="Il perdono definitivo non è qualcosa che si può chiedere gli altri, e nemmeno ai Luminari.",shape=box,color=blue];
		j598974166 -> j284373082;
		j598974166 -> j1912644162;
	j2379891067 [label="Mio fratello sente le voci dei morti e degli dei stessi.",shape=box,color=blue];
		j2379891067 -> j3070769369;
