		j3724288615 -> j1704443655;
	j3499811920 [label="A volte vede semplicemente le cose, o le ricorda, come le ha sentite o come gli spiriti hanno detto che avrebbero dovuto essere. Non forse come erano.",shape=box,color=blue];
		j3499811920 -> j3422846878;
	j2401693945 [label="Penso che le Cardinal abbia capito che non si può entrare nell'aldilà con il cuore pesante, ed è per questo che è venuto da noi.",shape=box,color=blue];
