		j2413258194 -> j2873439393 [label=true,color=green];
		j2413258194 -> j2249494613 [label=false,color=brown];
	j128071878 [label="E quindi credo che le Cardinal sia benedetto, anche se non crede veramente nella fede con lo stesso nome che gli darei.",shape=box,color=blue];
		j128071878 -> j983329199;
	j1586547271 [label="Add 1 to Thermostat counter",color=orange];
		j1586547271 -> j2947958117;
	j1548017838 [label="Add -1 to Thermostat counter",color=orange];
		j1548017838 -> j2949040077;
	j3794257319 [label="Oui, et comme c'est tragique... mi viene da piangere a pensarci. E del Monsieur Loid, il loro amore alla deriva.",shape=box,color=blue];
		j3794257319 -> j3892874;
	j2873439393 [label="Perdonami, dimenticavo... non credi che la tua Indifférence sia reale. Solo un'allucinazione. Ma credi nell'emozione che suscita, oui ?",shape=box,color=blue];
		j2873439393 -> j2812718213;
		j2873439393 -> j2805909777;
	j2249494613 [label="È perfetto il fatto che venga a predicare il messaggio in contrapposizione a quello che ha scatenato, n'est-ce pas ?",shape=box,color=blue];
		j2249494613 -> j200558189;
		j2249494613 -> j1870395070;
		j2249494613 -> j566600818;
	j2947958117 [label="Oui, e credo che questa sia la missione a cui tutti siamo stati indirizzati.",shape=box,color=blue];
		j2947958117 -> j3892874;
	j2949040077 [label="Oui, ma la battaglia contro l'Indifférence non si vince con le spade e le pietre. Si vince con il cuore, non lo capisci ?",shape=box,color=blue];
		j2949040077 -> j3892874;
	j3892874 [label="Non è il diavolo Orokin che vuole che perdoniamo, non? È le Cardinal, questo è chiaro. E credo che sia l'amore per Monsieur Loid a ispirarlo.",shape=box,color=blue];
		j3892874 -> j965499766;
	j2812718213 [label="Tutte le emozioni hanno uno scopo, anche l'indifferenza.",shape=box,color=red];
		j2812718213 -> j1990461349;
	j2805909777 [label="Sì, lo so. Ne sono caduto vittima a Duviri. Ho lasciato che l'apatia mi divorasse finché non è rimasto altro.",shape=box,color=red];
		j2805909777 -> j3800635067;
	j200558189 [label="Vorrei sapere come aiutarlo a risolvere il problema.",shape=box,color=red];
		j200558189 -> j2922426680;
	j1870395070 [label="Vorrei che avesse un piano migliore di \"predicare\".",shape=box,color=red];
		j1870395070 -> j695034225;
	j566600818 [label="Beh, visto che è colpa sua se quella cosa sta dilagando... sì. È il minimo che possa fare.",shape=box,color=red];
		j566600818 -> j488167044;
	j965499766 [label="Mi spezza il cuore. Non desidero altro che vederli riuniti !",shape=box,color=blue];
		j965499766 -> j1472230597;
		j965499766 -> j3335832636;
	j1990461349 [label="Naturalmente ha uno scopo. Je ne le nie pas.",shape=box,color=blue];
