	j3470333215 [label="Evaluate expressions",color=orange];
		j3470333215 -> j842358562 [label="LoidFamilyComplete",color=purple];
		j3470333215 -> j2648444450 [label="RoatheRedeemed",color=purple];
		j3470333215 -> j92008148 [label="RoatheVillain",color=purple];
		j3470333215 -> j533179816 [label="RoatheHellComplete",color=purple];
		j3470333215 -> j2173409849 [label="false",color=purple];
	j986233242 [label="So che una volta hai detto di provare qualcosa per me. Eppure, ora sei con un altro. Volevo solo dirti che sono felice per te !",shape=box,color=blue];
		j986233242 -> j3789965074;
	j642890254 [label="Una volta mi hai detto che... oh, non so nemmeno come dirlo. Che provavi dei sentimenti per me. Eppure so che ne provi anche per altri.",shape=box,color=blue];
		j642890254 -> j482584546;
		j642890254 -> j1633562089;
