		j718158934 -> j2468067913;
	j4044849376 [label="Prego semplicemente che tu non fuorvii Lyon o non lo ferisca inutilmente. È una creatura delicata, sotto quell'aspetto di pietra.",shape=box,color=blue];
		j4044849376 -> j1466024242;
	j3817892800 [label="Non auguro a Roathe di soffrire, nonostante lo stuzzichi e gli faccia la predica. Non causargli dolore, se puoi evitarlo.",shape=box,color=blue];
		j3817892800 -> j1466024242;
