	3304 [label="E mi chiedo, è questo che l'Indifferenza vuole distruggere ? È questo che l'Indifferenza consuma ? Il potere di influenzare gli altri ?",shape=box,color=blue];
		3304 -> 3321;
	3309 [label="Hai portato tanta pace al fratello della mia anima. Lo hai convinto che abbiamo un vero nemico da combattere - e gli hai dato speranza.",shape=box,color=blue];
		3309 -> 3329;
	3310 [label="Hai portato al fratello della mia anima conforto e un po' di pace dove prima non ne aveva. Credo che la tua compagnia abbia significato per lui più di quanto riesca ad esprimere.",shape=box,color=blue];
		3310 -> 3329;
	3311 [label="Anche se non sapremo mai cosa sia veramente l'Indifferenza, sappiamo che non ha importanza. Dobbiamo affrontarla come la sfida che pone - reale.",shape=box,color=blue];
		3311 -> 3329;
	3312 [label="Non pensavo che il nostro diavolo potesse lasciarsi convincere ad aiutare Monsieur Loid e la famiglia de le Cardinal a riallacciare i rapporti. So che le sue ragioni sono... forse dubbie, e ancora non mi fido completamente di lui. ",shape=box,color=blue];
		3312 -> 3330;
	3313 [label="Non pensavo che il nostro diavolo potesse capire i suoi errori. Che potesse provare rimorso per le vite innocenti che ha sprecato. Mi hai dimostrato che mi sbagliavo.",shape=box,color=blue];
		3313 -> 3331;
	3314 [label="Qualunque siano le catene a cui tieni legato il nostro diavolo, lo tengono al guinzaglio. Sembra più... calmo di prima. E devi ringraziare te stesso per questo.",shape=box,color=blue];
		3314 -> 3331;
	3315 [label="I ricordi che lo abbiamo aiutato a recuperare sembrano averlo calmato. Forse ricordare il dolore per tutti coloro che ha perso gli ha ricordato coloro che potrebbe ancora perdere.",shape=box,color=blue];
		3315 -> 3331;
	3316 [label="Forse è il suo affetto per te a calmarlo, non lo so. Qualunque sia la ragione, so che devi ringraziare te stesso per questo.",shape=box,color=blue];
		3316 -> 3331;
	3308 [label="Non nutro alcun rancore nei vostri confronti e provo solo gioia per entrambi, oui ?",shape=box,color=blue];
		3308 -> 3327;
		3308 -> 3328;
	3306 [label="Le cose sono cambiate e... devo restare loro fedele, mi dispiace.",shape=box,color=red];
		3306 -> 3325;
	3307 [label="Forse è difficile da credere, o forse anche da accettare, lo so. Ma io... amo te. E amo loro. In egual misura.",shape=box,color=red];
