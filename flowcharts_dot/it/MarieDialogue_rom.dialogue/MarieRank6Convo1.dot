	j4005894665 [label="E mi chiedo, è questo che l'Indifferenza vuole distruggere ? È questo che l'Indifferenza consuma ? Il potere di influenzare gli altri ?",shape=box,color=blue];
		j4005894665 -> j1916813739;
	j1338714549 [label="Temo che tu stia per dirmi parole che non potrai più rimangiarti. E questo cambierà le cose tra noi per sempre.",shape=box,color=blue];
		j1338714549 -> j3897380723;
	j2314777629 [label="Mon cœur t'appartient depuis notre première rencontre...",shape=box,color=blue];
		j2314777629 -> j3439580966;
		j2314777629 -> j2579645419;
	j2774122046 [label="Il dono di far ridere l'altro. Di far piangere. Di convincersi a vicenda della verità o della menzogna. Di cambiare idea a vicenda. Di incoraggiarsi a vicenda quando si è nel dolore. Di ferirsi a vincenda nella follia.",shape=box,color=blue];
		j2774122046 -> j2921523061;
	j1120680770 [label="E qual è la differenza quando sei presente per guidare Lyon attraverso i momenti più bui e per sostenerlo nei suoi momenti di dolore e agonia ?",shape=box,color=blue];
		j1120680770 -> j3843880068;
	j4094363216 [label="I risultati sono senza dubbio merito tuo. Roathe è qui e sta proteggendo la famiglia de le Cardinal, grazie a te.",shape=box,color=blue];
		j4094363216 -> j1397025760;
	j1397025760 [label="E so che il nostro diavolo non è nostro nemico, oui ? L'Indifferenza è il nemico. E cosa ci insegna l'Indifferenza, se non ad aggrapparci a tutto ciò che rifiuta, a tutto ciò che distrugge ?",shape=box,color=blue];
		j1397025760 -> j905695287;
	j1885352514 [label="Ma... e se ",shape=box,color=red];
		j1885352514 -> j2262939187;
	j3380601960 [label="Anch'io provo dei sentimenti per te, Marie.",shape=box,color=red];
		j3380601960 -> j762179232;
	j951530051 [label="Oui, capisco. Certo che capisco ! Come potrei biasimarti per aver seguito la tua anima ?",shape=box,color=blue];
		j951530051 -> j786339168;
	j3734127592 [label="Evaluate expressions",color=orange];
		j3734127592 -> j1187838458 [label="MarieNoDate",color=purple];
		j3734127592 -> j2389452321 [label="MarieWillDate",color=purple];
		j3734127592 -> j1187838458 [label="false",color=purple];
	j1187838458 [label="Non so come dirlo senza essere crudele, quindi... lo dirò semplicemente.",shape=box,color=blue];
		j1187838458 -> j336250891;
	j2610809127 [label="Sì. Io... non credo che tu la pensi allo stesso modo?",shape=box,color=red];
		j2610809127 -> j636571432;
	j2697138671 [label="Le cose sono cambiate e... mi dispiace.",shape=box,color=red];
		j2697138671 -> j3615020358;
	j1916813739 [label="Il dono di far ridere l'altro. Di far piangere. Di convincersi a vicenda della verità o della menzogna. Di cambiare idea a vicenda. Di incoraggiarsi a vicenda quando si è nel dolore. Di ferirsi a vincenda nella follia.",shape=box,color=blue];
		j1916813739 -> j3950979325;
	j3897380723 [label="E mi addolora, oh, quanto mi addolora fermarti prima che tu lo faccia.",shape=box,color=blue];
		j3897380723 -> j1014580207;
	j3439580966 [label="Io... non so cosa significhi, Marie.",shape=box,color=red];
		j3439580966 -> j3307708209;
	j2579645419 [label="Mon cœur t'appartient également, Marie !",shape=box,color=red];
		j2579645419 -> j1322509309;
	j2921523061 [label="Aiutarsi a vicenda quando si è innamorati. Darsi agonia quando si è persi nell'odio. Questo è il dono dell'humanité - questo è ciò che l'Indifferenza non è.",shape=box,color=blue];
		j2921523061 -> j1976325594;
	j3843880068 [label="Cosa ci insegna l'Indifferenza, qualunque sia la sua origine, se non a trattenere tutto ciò che rifiuta, tutto ciò che distrugge ?",shape=box,color=blue];
		j3843880068 -> j982131315;
