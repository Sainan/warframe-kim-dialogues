	j1639713141 [label="Ma penso a quanto abbiano significato per me. A quanto abbiano cambiato me e il corso della mia vita, come una nave in mare.",shape=box,color=blue];
		j1639713141 -> j4005894665;
	j1471879296 [label="Evaluate expressions",color=orange];
		j1471879296 -> j1338714549 [label="MarieNoDate",color=purple];
		j1471879296 -> j2314777629 [label="MarieWillDate",color=purple];
		j1471879296 -> j1338714549 [label="false",color=purple];
	j371088400 [label="E mi chiedo, è questo che l'Indifferenza vuole distruggere ? È questo che l'Indifferenza consuma ? Il potere di influenzare gli altri ?",shape=box,color=blue];
		j371088400 -> j2774122046;
	j1885257492 [label="Hai portato tanta pace al fratello della mia anima. Lo hai convinto che abbiamo un vero nemico da combattere - e gli hai dato speranza.",shape=box,color=blue];
		j1885257492 -> j1120680770;
	j3619693470 [label="Hai portato al fratello della mia anima conforto e un po' di pace dove prima non ne aveva. Credo che la tua compagnia abbia significato per lui più di quanto riesca ad esprimere.",shape=box,color=blue];
		j3619693470 -> j1120680770;
	j2083483797 [label="Anche se non sapremo mai cosa sia veramente l'Indifferenza, sappiamo che non ha importanza. Dobbiamo affrontarla come la sfida che pone - reale.",shape=box,color=blue];
		j2083483797 -> j1120680770;
	j842358562 [label="Non pensavo che il nostro diavolo potesse lasciarsi convincere ad aiutare Monsieur Loid e la famiglia de le Cardinal a riallacciare i rapporti. So che le sue ragioni sono... forse dubbie, e ancora non mi fido completamente di lui. ",shape=box,color=blue];
		j842358562 -> j4094363216;
	j2648444450 [label="Non pensavo che il nostro diavolo potesse capire i suoi errori. Che potesse provare rimorso per le vite innocenti che ha sprecato. Mi hai dimostrato che mi sbagliavo.",shape=box,color=blue];
		j2648444450 -> j1397025760;
	j92008148 [label="Qualunque siano le catene a cui tieni legato il nostro diavolo, lo tengono al guinzaglio. Sembra più... calmo di prima. E devi ringraziare te stesso per questo.",shape=box,color=blue];
		j92008148 -> j1397025760;
	j533179816 [label="I ricordi che lo abbiamo aiutato a recuperare sembrano averlo calmato. Forse ricordare il dolore per tutti coloro che ha perso gli ha ricordato coloro che potrebbe ancora perdere.",shape=box,color=blue];
		j533179816 -> j1397025760;
	j2173409849 [label="Forse è il suo affetto per te a calmarlo, non lo so. Qualunque sia la ragione, so che devi ringraziare te stesso per questo.",shape=box,color=blue];
		j2173409849 -> j1397025760;
	j3789965074 [label="Non nutro alcun rancore nei vostri confronti e provo solo gioia per entrambi, oui ?",shape=box,color=blue];
		j3789965074 -> j1885352514;
		j3789965074 -> j3380601960;
	j482584546 [label="Le cose sono cambiate e... devo restare loro fedele, mi dispiace.",shape=box,color=red];
		j482584546 -> j951530051;
	j1633562089 [label="Forse è difficile da credere, o forse anche da accettare, lo so. Ma io... amo te. E amo loro. In egual misura.",shape=box,color=red];
		j1633562089 -> j3734127592;
	j1928846357 [label="Evaluate expressions",color=orange];
