	j4154557080 [label="Come vi siete conosciuti tu e Lyon?",shape=box,color=red];
		j4154557080 -> j2979006357;
	j268720096 [label="Lyon... sta bene?",shape=box,color=red];
		j268720096 -> j3929074120;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j2979006357 [label="Il mio caro Lyon era già da tempo residente alla Cathédrale quando la Mère Supérieure mi accolse e mi unii alla Chiesa dei Luminari come Suora. (Mi emoziona che finalmente stiate parlando !)",shape=box,color=blue];
		j2979006357 -> j1896262886;
		j2979006357 -> j3970702472;
	j3929074120 [label="Ti chiederò di definirlo prima di procedere. E ti chiederò di farlo con delicatezza, ricordandoti che lui è il fratello della mia anima.",shape=box,color=blue];
		j3929074120 -> j2362434083;
		j3929074120 -> j2909059313;
	"Chat ends." [color=orange];
	j1896262886 [label="Avevi... bisogno di un posto dove stare?",shape=box,color=red];
		j1896262886 -> j1542827948;
	j3970702472 [label="Posso farti una domanda indelicata?",shape=box,color=red];
		j3970702472 -> j2805241301;
	j2362434083 [label="Se questa conversazione ti disturba, possiamo passare ad altro.",shape=box,color=red];
		j2362434083 -> j1931305274;
	j2909059313 [label="Non voglio affatto turbarti. Sono solo preoccupato per lui. Ha un aspetto stoico, ma ho la sensazione che stia soffrendo, tutto qui.",shape=box,color=red];
		j2909059313 -> j2223291976;
	j1542827948 [label="Perché sono stata lasciata lì dalla mia famiglia molti anni prima, quando ero una bambina. Ho passato molti anni mendicando, vivendo come potevo.",shape=box,color=blue];
		j1542827948 -> j3264235317;
	j2805241301 [label="+5 Chemistry",color=orange];
		j2805241301 -> j3597036838;
	j1931305274 [label="No, no. Nessun problema. Sono semplicemente abituata agli spettatori curiosi che si aggirano furtivamente, bussando alle sbarre della sua gabbia come se fosse una specia di monstre de cirque.",shape=box,color=blue];
		j1931305274 -> j3484767175;
		j1931305274 -> j2397667479;
		j1931305274 -> j1244420448;
	j2223291976 [label="+5 Chemistry",color=orange];
		j2223291976 -> j939262861;
	j3264235317 [label="Boolean MarieBeggar1 is now true.",color=orange];
		j3264235317 -> j3677396099;
	j3597036838 [label="A quanto pare, dicono tu sia un un lupo, ma con me hai delle buone maniere ! È così dolce. Credo di sapere cosa vuoi chiedermi. Perché ero in strada?",shape=box,color=blue];
		j3597036838 -> j1542827948;
	j3484767175 [label="Come vi siete conosciuti?",shape=box,color=red];
		j3484767175 -> j2967588562;
	j2397667479 [label="Sono abituato a essere un po' un'\"attrazione locale\", quindi capisco perché potresti essere sulla difensiva.",shape=box,color=red];
		j2397667479 -> j1383749868;
	j1244420448 [label="Nessun problema. Sono solo preoccupato per lui.",shape=box,color=red];
		j1244420448 -> j2426483704;
	j939262861 [label="Mi... mi scuso per la mia bruschezza. Sono semplicemente abituata agli spettatori curiosi che si aggirano furtivamente, bussando alle sbarre della sua gabbia come se fosse una specia di monstre de cirque.",shape=box,color=blue];
		j939262861 -> j2397667479;
		j939262861 -> j1244420448;
	j3677396099 [label="Puoi immaginare che non ci fosse molto lavoro o posti dove andare per una persona come me, senza gambe funzionanti, dans la Cité de la Lumiére.",shape=box,color=blue];
		j3677396099 -> j2690746313;
	j2967588562 [label="Il mio caro Lyon era già da tempo residente alla Cathédrale quando la Mère Supérieure mi accolse e mi unii alla Chiesa dei Luminari come Suora.",shape=box,color=blue];
		j2967588562 -> j100494981;
		j2967588562 -> j639512024;
	j1383749868 [label="Oui, immagino che tu lo sia, una creatura che viaggia nel tempo, che può far rivivere il tempo ed evocare mondi dal nulla ! Un po' un mago, non ?",shape=box,color=blue];
		j1383749868 -> j712046970;
		j1383749868 -> j2014151952;
	j2426483704 [label="+5 Chemistry",color=orange];
		j2426483704 -> j1011285833;
	j2690746313 [label="Ecco perché Lyon e io siamo diventati come una famiglia così velocemente. Non mi ha mai guardata con pietà. Né io a lui.",shape=box,color=blue];
		j2690746313 -> j3377506836;
	j100494981 [label="Avevi... bisogno di un posto dove stare?",shape=box,color=red];
		j100494981 -> j4238820666;
	j639512024 [label="Posso farti una domanda indelicata?",shape=box,color=red];
		j639512024 -> j4196522396;
	j712046970 [label="Questo riassume il tutto in modo abbastanza chiaro.",shape=box,color=red];
		j712046970 -> j3965948786;
	j2014151952 [label="Sinceramente, spero che la gente mi veda come qualcosa di più.",shape=box,color=red];
		j2014151952 -> j3391363194;
	j1011285833 [label="E adoro il fatto che tu lo sia. Lui è forte e può sopportare ciò che gli è stato imposto. Ma tutti i pesi sono più leggeri se condivisi.",shape=box,color=blue];
		j1011285833 -> j855147572;
		j1011285833 -> j917461981;
	j3377506836 [label="Mentre altri sono così veloci a bussare con curiosità alle sbarre della sua gabbia, come se fosse una specie di monstre de cirque.",shape=box,color=blue];
		j3377506836 -> j1535113502;
	j4238820666 [label="Perché sono stata lasciata lì dalla mia famiglia molti anni prima, quando ero una bambina. Ho passato molti anni mendicando, vivendo come potevo.",shape=box,color=blue];
		j4238820666 -> j1043419996;
	j4196522396 [label="+5 Chemistry",color=orange];
		j4196522396 -> j517621143;
	j3965948786 [label="+10 Chemistry",color=orange];
		j3965948786 -> j3837565832;
	j3391363194 [label="+15 Chemistry",color=orange];
		j3391363194 -> j587711796;
	j855147572 [label="Ho la sensazione che non mi parlerà.",shape=box,color=red];
		j855147572 -> j2500823054;
	j917461981 [label="Vorrei aiutarlo, se posso. Hai qualche consiglio?",shape=box,color=red];
		j917461981 -> j2500823054;
	j1535113502 [label="Spero che non sia questo il motivo per cui ti trovi qui.",shape=box,color=blue];
		j1535113502 -> j4242075415;
		j1535113502 -> j1311586612;
	j1043419996 [label="Boolean MarieBeggar1 is now true.",color=orange];
		j1043419996 -> j2376231508;
	j517621143 [label="A quanto pare, dicono tu sia un un lupo, e con me hai delle buone maniere ! È così dolce. Credo di sapere cosa vuoi chiedermi. Perché ero in strada?",shape=box,color=blue];
		j517621143 -> j4238820666;
	j3837565832 [label="Un giorno, credo che verrà scritto un libro di fiabe su di te. Che pensiero affascinante. Forse lo scriverò io. Anche se sarà in Gaullique! Imaginez cela !",shape=box,color=blue];
		j3837565832 -> j1027130405;
	j587711796 [label="Allora capisci davvero. Sono più di Suor Marie, la povera ragazza senza piedi a cui è stato dato il potere di volare. E Lyon è più di un tragico prete che porta i suoi fardelli in silenzio.",shape=box,color=blue];
		j587711796 -> j716108429;
	j2500823054 [label="+10 Chemistry",color=orange];
		j2500823054 -> j2609441570;
	j4242075415 [label="Sono abituata a essere un po' un'\"attrazione locale\", so come la pensate entrambi. No, non è così. ",shape=box,color=red];
		j4242075415 -> j4192570450;
	j1311586612 [label="No, ero solo curioso. E onestamente, un po' preoccupato per lui. Credo che nasconda molto del suo dolore.",shape=box,color=red];
		j1311586612 -> j1678715531;
	j2376231508 [label="Puoi immaginare che non ci fosse molto lavoro o posti dove andare per una persona come me, senza gambe funzionanti, dans la Cité de la Lumiére.",shape=box,color=blue];
		j2376231508 -> j3370727186;
	j1027130405 [label="O forse non ti immaginare nulla del genere, potrebbe avverarsi. Aha! E su questa meravigliosa nota, temo di doverti dire adieu. I Murmur non cessano mai !",shape=box,color=blue];
		j1027130405 -> "Chat ends.";
	j716108429 [label="Ricordatelo, e credo che saremo buoni amici. E su questa nota meravigliosa, temo di dovervi dire adieu. I Murmur non cessano mai !",shape=box,color=blue];
		j716108429 -> "Chat ends.";
	j2609441570 [label="Sii paziente. Lui... non è molto aperto, all'inizio. Ma verrà da te, quando sarà il momento giusto. Se le tue intenzioni sono buone, lui lo saprà. Ma ora, temo di doverti dire adieu.",shape=box,color=blue];
		j2609441570 -> "Chat ends.";
	j4192570450 [label="Oui, immagino che tu lo sia, una creatura che viaggia nel tempo, che può far rivivere il tempo ed evocare mondi dal nulla ! Un po' un mago, non ?",shape=box,color=blue];
		j4192570450 -> j712046970;
		j4192570450 -> j2014151952;
	j1678715531 [label="+15 Chemistry",color=orange];
		j1678715531 -> j3621716919;
	j3370727186 [label="Ecco perché Lyon e io siamo diventati come una famiglia così velocemente. Non mi ha mai guardata con pietà. Né io a lui.",shape=box,color=blue];
		j3370727186 -> j3466335766;
		j3370727186 -> j3509428660;
	j3621716919 [label="Hai ragione, lo fa. Ma sente che è necessario farlo, per proteggere chi gli sta intorno. Quando sentirà che non hai più bisogno di queste cose, ti dirà cosa lo turba. Sii paziente. Te ne parlerà a tempo debito.",shape=box,color=blue];
		j3621716919 -> j2058213918;
	j3466335766 [label="Spero che si senta abbastanza a suo agio da parlare con me, presto.",shape=box,color=red];
		j3466335766 -> j2500823054;
	j3509428660 [label="Sono felice che vi siate trovati. Siamo tutti molto più di quanto potremmo sembrare a prima vista.",shape=box,color=red];
		j3509428660 -> j3274628985;
	j2058213918 [label="Bah. Temo di doverti dire adieu. I Murmur non cessano mai !",shape=box,color=blue];
		j2058213918 -> "Chat ends.";
	j3274628985 [label="+15 Chemistry",color=orange];
		j3274628985 -> j730024236;
	j730024236 [label="Allora capisci davvero. Sono più di Suor Marie, la povera ragazza senza piedi a cui è stato dato il potere di volare. E Lyon è più di un tragico prete che porta i suoi fardelli in silenzio.",shape=box,color=blue];
		j730024236 -> j3803140442;
	j3803140442 [label="Ricordatelo, e credo che saremo buoni amici. E su questa nota meravigliosa, temo di dovervi dire adieu. I Murmur non cessano mai!",shape=box,color=blue];
		j3803140442 -> "Chat ends.";
}