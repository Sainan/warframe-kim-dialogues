	1491 [label="Come vi siete conosciuti tu e Lyon?",shape=box,color=red];
		1491 -> 1494;
	1490 [label="Lyon... sta bene?",shape=box,color=red];
		1490 -> 1493;
	1489 [label="[Fine.]",shape=box,color=red];
		1489 -> 1492;
	1494 [label="Il mio caro Lyon era già da tempo residente alla Cathédrale quando la Mère Supérieure mi accolse e mi unii alla Chiesa dei Luminari come Suora. (Mi emoziona che finalmente stiate parlando !)",shape=box,color=blue];
		1494 -> 1497;
		1494 -> 1498;
	1493 [label="Ti chiederò di definirlo prima di procedere. E ti chiederò di farlo con delicatezza, ricordandoti che lui è il fratello della mia anima.",shape=box,color=blue];
		1493 -> 1495;
		1493 -> 1496;
	1492 [label="Chat ends.",color=orange];
	1497 [label="Avevi... bisogno di un posto dove stare?",shape=box,color=red];
		1497 -> 1501;
	1498 [label="Posso farti una domanda indelicata?",shape=box,color=red];
		1498 -> 1502;
	1495 [label="Se questa conversazione ti disturba, possiamo passare ad altro.",shape=box,color=red];
		1495 -> 1499;
	1496 [label="Non voglio affatto turbarti. Sono solo preoccupato per lui. Ha un aspetto stoico, ma ho la sensazione che stia soffrendo, tutto qui.",shape=box,color=red];
		1496 -> 1500;
	1501 [label="Perché sono stata lasciata lì dalla mia famiglia molti anni prima, quando ero una bambina. Ho passato molti anni mendicando, vivendo come potevo.",shape=box,color=blue];
		1501 -> 1507;
	1502 [label="+5 Chemistry",color=orange];
		1502 -> 1508;
	1499 [label="No, no. Nessun problema. Sono semplicemente abituata agli spettatori curiosi che si aggirano furtivamente, bussando alle sbarre della sua gabbia come se fosse una specia di monstre de cirque.",shape=box,color=blue];
		1499 -> 1503;
		1499 -> 1504;
		1499 -> 1505;
	1500 [label="+5 Chemistry",color=orange];
		1500 -> 1506;
	1507 [label="Update boolean MarieBeggar1",color=orange];
		1507 -> 1512;
	1508 [label="A quanto pare, dicono tu sia un un lupo, ma con me hai delle buone maniere ! È così dolce. Credo di sapere cosa vuoi chiedermi. Perché ero in strada?",shape=box,color=blue];
		1508 -> 1501;
	1503 [label="Come vi siete conosciuti?",shape=box,color=red];
		1503 -> 1509;
	1504 [label="Sono abituato a essere un po' un'\"attrazione locale\", quindi capisco perché potresti essere sulla difensiva.",shape=box,color=red];
		1504 -> 1510;
	1505 [label="Nessun problema. Sono solo preoccupato per lui.",shape=box,color=red];
		1505 -> 1511;
	1506 [label="Mi... mi scuso per la mia bruschezza. Sono semplicemente abituata agli spettatori curiosi che si aggirano furtivamente, bussando alle sbarre della sua gabbia come se fosse una specia di monstre de cirque.",shape=box,color=blue];
		1506 -> 1504;
		1506 -> 1505;
	1512 [label="Puoi immaginare che non ci fosse molto lavoro o posti dove andare per una persona come me, senza gambe funzionanti, dans la Cité de la Lumiére.",shape=box,color=blue];
		1512 -> 1518;
	1509 [label="Il mio caro Lyon era già da tempo residente alla Cathédrale quando la Mère Supérieure mi accolse e mi unii alla Chiesa dei Luminari come Suora.",shape=box,color=blue];
		1509 -> 1513;
		1509 -> 1514;
	1510 [label="Oui, immagino che tu lo sia, una creatura che viaggia nel tempo, che può far rivivere il tempo ed evocare mondi dal nulla ! Un po' un mago, non ?",shape=box,color=blue];
		1510 -> 1515;
		1510 -> 1516;
	1511 [label="+5 Chemistry",color=orange];
		1511 -> 1517;
	1518 [label="Ecco perché Lyon e io siamo diventati come una famiglia così velocemente. Non mi ha mai guardata con pietà. Né io a lui.",shape=box,color=blue];
		1518 -> 1525;
	1513 [label="Avevi... bisogno di un posto dove stare?",shape=box,color=red];
		1513 -> 1519;
	1514 [label="Posso farti una domanda indelicata?",shape=box,color=red];
		1514 -> 1520;
	1515 [label="Questo riassume il tutto in modo abbastanza chiaro.",shape=box,color=red];
		1515 -> 1521;
	1516 [label="Sinceramente, spero che la gente mi veda come qualcosa di più.",shape=box,color=red];
		1516 -> 1522;
	1517 [label="E adoro il fatto che tu lo sia. Lui è forte e può sopportare ciò che gli è stato imposto. Ma tutti i pesi sono più leggeri se condivisi.",shape=box,color=blue];
		1517 -> 1523;
		1517 -> 1524;
	1525 [label="Mentre altri sono così veloci a bussare con curiosità alle sbarre della sua gabbia, come se fosse una specie di monstre de cirque.",shape=box,color=blue];
		1525 -> 1531;
	1519 [label="Perché sono stata lasciata lì dalla mia famiglia molti anni prima, quando ero una bambina. Ho passato molti anni mendicando, vivendo come potevo.",shape=box,color=blue];
		1519 -> 1526;
	1520 [label="+5 Chemistry",color=orange];
		1520 -> 1527;
	1521 [label="+10 Chemistry",color=orange];
		1521 -> 1528;
	1522 [label="+15 Chemistry",color=orange];
		1522 -> 1529;
	1523 [label="Ho la sensazione che non mi parlerà.",shape=box,color=red];
		1523 -> 1530;
	1524 [label="Vorrei aiutarlo, se posso. Hai qualche consiglio?",shape=box,color=red];
		1524 -> 1530;
	1531 [label="Spero che non sia questo il motivo per cui ti trovi qui.",shape=box,color=blue];
		1531 -> 1536;
		1531 -> 1537;
	1526 [label="Update boolean MarieBeggar1",color=orange];
		1526 -> 1532;
	1527 [label="A quanto pare, dicono tu sia un un lupo, e con me hai delle buone maniere ! È così dolce. Credo di sapere cosa vuoi chiedermi. Perché ero in strada?",shape=box,color=blue];
		1527 -> 1519;
	1528 [label="Un giorno, credo che verrà scritto un libro di fiabe su di te. Che pensiero affascinante. Forse lo scriverò io. Anche se sarà in Gaullique! Imaginez cela !",shape=box,color=blue];
		1528 -> 1533;
	1529 [label="Allora capisci davvero. Sono più di Suor Marie, la povera ragazza senza piedi a cui è stato dato il potere di volare. E Lyon è più di un tragico prete che porta i suoi fardelli in silenzio.",shape=box,color=blue];
		1529 -> 1534;
	1530 [label="+10 Chemistry",color=orange];
		1530 -> 1535;
	1536 [label="Sono abituata a essere un po' un'\"attrazione locale\", so come la pensate entrambi. No, non è così. ",shape=box,color=red];
		1536 -> 1541;
	1537 [label="No, ero solo curioso. E onestamente, un po' preoccupato per lui. Credo che nasconda molto del suo dolore.",shape=box,color=red];
		1537 -> 1542;
	1532 [label="Puoi immaginare che non ci fosse molto lavoro o posti dove andare per una persona come me, senza gambe funzionanti, dans la Cité de la Lumiére.",shape=box,color=blue];
		1532 -> 1538;
	1533 [label="O forse non ti immaginare nulla del genere, potrebbe avverarsi. Aha! E su questa meravigliosa nota, temo di doverti dire adieu. I Murmur non cessano mai !",shape=box,color=blue];
		1533 -> 1539;
	1534 [label="Ricordatelo, e credo che saremo buoni amici. E su questa nota meravigliosa, temo di dovervi dire adieu. I Murmur non cessano mai !",shape=box,color=blue];
		1534 -> 1540;
	1535 [label="Sii paziente. Lui... non è molto aperto, all'inizio. Ma verrà da te, quando sarà il momento giusto. Se le tue intenzioni sono buone, lui lo saprà. Ma ora, temo di doverti dire adieu.",shape=box,color=blue];
		1535 -> 2424;
	1541 [label="Oui, immagino che tu lo sia, una creatura che viaggia nel tempo, che può far rivivere il tempo ed evocare mondi dal nulla ! Un po' un mago, non ?",shape=box,color=blue];
		1541 -> 1545;
		1541 -> 1546;
	1542 [label="+15 Chemistry",color=orange];
		1542 -> 1547;
	1538 [label="Ecco perché Lyon e io siamo diventati come una famiglia così velocemente. Non mi ha mai guardata con pietà. Né io a lui.",shape=box,color=blue];
		1538 -> 1543;
		1538 -> 1544;
	1539 [label="Chat ends.",color=orange];
	1540 [label="Chat ends.",color=orange];
	2424 [label="Chat ends.",color=orange];
	1545 [label="Questo riassume il tutto in modo abbastanza chiaro.",shape=box,color=red];
		1545 -> 1521;
	1546 [label="Sinceramente, spero che la gente mi veda come qualcosa di più.",shape=box,color=red];
		1546 -> 1522;
	1547 [label="Hai ragione, lo fa. Ma sente che è necessario farlo, per proteggere chi gli sta intorno. Quando sentirà che non hai più bisogno di queste cose, ti dirà cosa lo turba. Sii paziente. Te ne parlerà a tempo debito.",shape=box,color=blue];
		1547 -> 1550;
	1543 [label="Spero che si senta abbastanza a suo agio da parlare con me, presto.",shape=box,color=red];
		1543 -> 1548;
	1544 [label="Sono felice che vi siate trovati. Siamo tutti molto più di quanto potremmo sembrare a prima vista.",shape=box,color=red];
		1544 -> 1549;
	1550 [label="Bah. Temo di doverti dire adieu. I Murmur non cessano mai !",shape=box,color=blue];
		1550 -> 1553;
	1548 [label="+10 Chemistry",color=orange];
		1548 -> 1551;
	1549 [label="+15 Chemistry",color=orange];
		1549 -> 1552;
