digraph {
	3815 [label="MarieRoatheRepair begins.",color=orange];
		3815 -> 3816;
	3816 [label="Evaluate expressions",color=orange];
		3816 -> 3817 [label="RoatheMarieDatingDeal, MarieNoDate",color=purple];
		3816 -> 3818 [label="RoatheFamilyDeal, MarieFamilyFail",color=purple];
		3816 -> 3818 [label="MarieFamilyFail",color=purple];
		3816 -> 3819 [label="RoatheMarieEntratiDeal, MarieEntratiCompleteB",color=purple];
		3816 -> 3819 [label="RoatheMarieEntratiDeal, MarieEntratiCompleteC",color=purple];
		3816 -> 3820 [label="false",color=purple];
	3817 [label="Drifter. Sono perseguitata dal diavolo. Mi infastidisce senza mai fermarsi con quei suoi piccoli diavoletti ! Tutto in tuo nome ! Dice che vuoi solo scusarti in ginocchio.",shape=box,color=blue];
		3817 -> 3821;
		3817 -> 3822;
	3818 [label="Sono perseguitata dal diavolo. Mi infastidisce senza mai fermarsi con quei suoi piccoli diavoletti ! Tutto in tuo nome ! Dice che vuoi parlarmi dell'opportunità di aiutarvi a far andare di sopra Monsieur Loid ?",shape=box,color=blue];
		3818 -> 3823;
		3818 -> 3824;
	3819 [label="Sono perseguitata dal diavolo. Mi infastidisce senza mai fermarsi con quei suoi piccoli diavoletti ! Tutto in tuo nome ! Dice che vuoi parlarmi ancora una volta del mio impegno con le Cardinal ?",shape=box,color=blue];
		3819 -> 3825;
		3819 -> 3826;
	3820 [label="Chat ends.",color=orange];
	3821 [label="Certo.",shape=box,color=red];
		3821 -> 3827;
	3822 [label="Sì?",shape=box,color=red];
		3822 -> 3828;
	3823 [label="Certo.",shape=box,color=red];
		3823 -> 3829;
	3824 [label="Sì?",shape=box,color=red];
		3824 -> 3828;
	3825 [label="Certo.",shape=box,color=red];
		3825 -> 3830;
	3826 [label="Sì?",shape=box,color=red];
		3826 -> 3828;
	3827 [label="Mi dispiace davvero tanto. So di averti offesa. E non volevo. Era l'ultima cosa che volevo che succedesse, credimi.",shape=box,color=red];
		3827 -> 3831;
	3828 [label="Je vais le tuer ! Je savais que ce démon était rempli de la pire merde qui soit ! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses !",shape=box,color=blue];
		3828 -> 3832;
	3829 [label="Non mi dilungherò, perché lui ha già fatto molto per convincermi in tua assenza. E come è solito fare il diavolo, ha dimostrato di avere ottime agioni per farlo.",shape=box,color=blue];
		3829 -> 3833;
	3830 [label="Non mi dilungherò, perché lui ha già fatto molto per convincermi in tua assenza. E come è solito fare il diavolo, ha dimostrato di avere ottime agioni per farlo.",shape=box,color=blue];
		3830 -> 3834;
	3831 [label="E perché ?",shape=box,color=blue];
		3831 -> 3835;
		3831 -> 3836;
	3832 [label="Chat ends.",color=orange];
	3833 [label="E ammetto che... mi sto veramente stancando di essere intrappolata qui sotto sans recours.",shape=box,color=blue];
		3833 -> 3837;
	3834 [label="Ma non furono le sue parole, bensì è la sua intelligenza che dovresti ringraziare. Mi ha messa a tavolino con Monsieur Loid.",shape=box,color=blue];
		3834 -> 3838;
		3834 -> 3839;
	3835 [label="[Confessa i tuoi sentimenti.] Perché mi importa profondamente di te, Marie. Ti adoro.",shape=box,color=red];
		3835 -> 3840;
	3836 [label="Non importa. È stato chiaramente un errore.",shape=box,color=red];
		3836 -> 3841;
	3837 [label="Quindi, direi, molto bene. Vi aiuterò. Avrete il mio aiuto.",shape=box,color=blue];
		3837 -> 3842;
	3838 [label="Oh?",shape=box,color=red];
		3838 -> 3843;
	3839 [label="Ma Loid ama Albrecht. No?",shape=box,color=red];
		3839 -> 3844;
	3840 [label="Sapevo che avrei fatto una gaffe. E guarda caso, eccoci.",shape=box,color=red];
		3840 -> 3845;
	3841 [label="Sei cattivo tanto quanto lui.",shape=box,color=blue];
		3841 -> 3846;
	3842 [label="Update boolean MarieFamilySuccess",color=orange];
		3842 -> 3847;
	3843 [label="È stata la chiarezza di visione di Loid a permettermi di vedere attraverso la mia vista annebbiata. Loid ama le Cardinal - il suo Albrecht - eppure lo vede comunque con tutti i suoi difetti.",shape=box,color=blue];
		3843 -> 3848;
	3844 [label="Sì. Certo. Eppure riesce a vederlo con tutti i suoi difetti. Ed è stata quella chiarezza di visione che mi ha permesso di vedere attraverso la mia vista annebbiata.",shape=box,color=blue];
		3844 -> 3848;
	3845 [label="Mi dispiace tanto di essermi rivolto a Roahte per attirare la tua attenzione, ma non sapevo a chi altro rivolgermi.",shape=box,color=red];
		3845 -> 3849;
	3846 [label="Chat ends.",color=orange];
	3847 [label="Update boolean MarieFamilyFail",color=orange];
		3847 -> 3850;
	3848 [label="Perché cosa significa amare un altro se non accettarlo per tutto il bene e il male che è, après tout ?",shape=box,color=blue];
		3848 -> 3851;
	3849 [label="Oh, Drifter... mio povero Drifter. Non dovevi fare tutto questo per ottenere il mio perdono. ",shape=box,color=blue];
		3849 -> 3852;
	3850 [label="Chat ends.",color=orange];
	3851 [label="Update boolean MarieEntratiCompleteA",color=orange];
		3851 -> 3853;
	3852 [label="Te l'avrei dato se me l'avessi chiesto. Hai già un posto nel mio cuore, lo sai ?",shape=box,color=blue];
		3852 -> 3854;
		3852 -> 3855;
	3853 [label="Update boolean MarieEntratiCompleteB",color=orange];
		3853 -> 3856;
	3854 [label="Veramente?",shape=box,color=red];
		3854 -> 3857;
	3855 [label="Ma ho dovuto affrontare così tanti problemi...",shape=box,color=red];
		3855 -> 3858;
	3856 [label="Update boolean MarieEntratiCompleteC",color=orange];
		3856 -> 3859;
	3857 [label="Oui ! E se vuoi stare con me, mi farebbe piacere.",shape=box,color=blue];
		3857 -> 3860;
		3857 -> 3861;
	3858 [label="E la colpa è tua, non mia ! Ma se vuoi stare con me, allora mi farebbe piacere.",shape=box,color=blue];
		3858 -> 3861;
		3858 -> 3860;
	3859 [label="Chat ends.",color=orange];
	3860 [label="Mi piacerebbe, Marie.",shape=box,color=red];
		3860 -> 3862;
	3861 [label="Ripensandoci, non importa.",shape=box,color=red];
		3861 -> 3863;
	3862 [label="Ah ! Mi hai resa così felice !",shape=box,color=blue];
		3862 -> 3864;
	3863 [label="Je vais te jeter directement dans le Néant.",shape=box,color=blue];
		3863 -> 3865;
	3864 [label="Update boolean MarieDating",color=orange];
