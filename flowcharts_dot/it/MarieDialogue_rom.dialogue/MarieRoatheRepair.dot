	j2029280404 [label="Drifter. Sono perseguitata dal diavolo. Mi infastidisce senza mai fermarsi con quei suoi piccoli diavoletti ! Tutto in tuo nome ! Dice che vuoi solo scusarti in ginocchio.",shape=box,color=blue];
