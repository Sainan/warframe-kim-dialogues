	j1620143590 [label="Sono perseguitata dal diavolo. Mi infastidisce senza mai fermarsi con quei suoi piccoli diavoletti ! Tutto in tuo nome ! Dice che vuoi parlarmi dell'opportunità di aiutarvi a far andare di sopra Monsieur Loid ?",shape=box,color=blue];
		j1620143590 -> j1286770139;
		j1620143590 -> j3493474227;
	j2606955387 [label="Sono perseguitata dal diavolo. Mi infastidisce senza mai fermarsi con quei suoi piccoli diavoletti ! Tutto in tuo nome ! Dice che vuoi parlarmi ancora una volta del mio impegno con le Cardinal ?",shape=box,color=blue];
		j2606955387 -> j3249163577;
