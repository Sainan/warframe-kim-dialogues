	"Chat ends." [color=orange];
	j2097789593 [label="Certo.",shape=box,color=red];
		j2097789593 -> j617667292;
	j3493474227 [label="Sì?",shape=box,color=red];
		j3493474227 -> j4177712951;
	j1286770139 [label="Certo.",shape=box,color=red];
		j1286770139 -> j3425742176;
	j3249163577 [label="Certo.",shape=box,color=red];
		j3249163577 -> j469734658;
	j617667292 [label="Mi dispiace davvero tanto. So di averti offesa. E non volevo. Era l'ultima cosa che volevo che succedesse, credimi.",shape=box,color=red];
		j617667292 -> j3541886653;
	j4177712951 [label="Je vais le tuer ! Je savais que ce démon était rempli de la pire merde qui soit ! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses !",shape=box,color=blue];
		j4177712951 -> "Chat ends.";
	j3425742176 [label="Non mi dilungherò, perché lui ha già fatto molto per convincermi in tua assenza. E come è solito fare il diavolo, ha dimostrato di avere ottime agioni per farlo.",shape=box,color=blue];
		j3425742176 -> j4226338411;
	j469734658 [label="Non mi dilungherò, perché lui ha già fatto molto per convincermi in tua assenza. E come è solito fare il diavolo, ha dimostrato di avere ottime agioni per farlo.",shape=box,color=blue];
		j469734658 -> j1526379962;
	j3541886653 [label="E perché ?",shape=box,color=blue];
		j3541886653 -> j519228242;
		j3541886653 -> j768201372;
	j4226338411 [label="E ammetto che... mi sto veramente stancando di essere intrappolata qui sotto sans recours.",shape=box,color=blue];
		j4226338411 -> j3883401375;
	j1526379962 [label="Ma non furono le sue parole, bensì è la sua intelligenza che dovresti ringraziare. Mi ha messa a tavolino con Monsieur Loid.",shape=box,color=blue];
		j1526379962 -> j3795630036;
		j1526379962 -> j3188865958;
	j519228242 [label="[Confessa i tuoi sentimenti.] Perché mi importa profondamente di te, Marie. Ti adoro.",shape=box,color=red];
		j519228242 -> j249560357;
	j768201372 [label="Non importa. È stato chiaramente un errore.",shape=box,color=red];
		j768201372 -> j4234035739;
	j3883401375 [label="Quindi, direi, molto bene. Vi aiuterò. Avrete il mio aiuto.",shape=box,color=blue];
		j3883401375 -> j3151953893;
	j3795630036 [label="Oh?",shape=box,color=red];
		j3795630036 -> j1593426795;
	j3188865958 [label="Ma Loid ama Albrecht. No?",shape=box,color=red];
		j3188865958 -> j2027829217;
	j249560357 [label="Sapevo che avrei fatto una gaffe. E guarda caso, eccoci.",shape=box,color=red];
		j249560357 -> j299498304;
	j4234035739 [label="Sei cattivo tanto quanto lui.",shape=box,color=blue];
		j4234035739 -> "Chat ends.";
	j3151953893 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3151953893 -> j2529015854;
	j1593426795 [label="È stata la chiarezza di visione di Loid a permettermi di vedere attraverso la mia vista annebbiata. Loid ama le Cardinal - il suo Albrecht - eppure lo vede comunque con tutti i suoi difetti.",shape=box,color=blue];
		j1593426795 -> j1387937899;
	j2027829217 [label="Sì. Certo. Eppure riesce a vederlo con tutti i suoi difetti. Ed è stata quella chiarezza di visione che mi ha permesso di vedere attraverso la mia vista annebbiata.",shape=box,color=blue];
		j2027829217 -> j1387937899;
	j299498304 [label="Mi dispiace tanto di essermi rivolto a Roahte per attirare la tua attenzione, ma non sapevo a chi altro rivolgermi.",shape=box,color=red];
		j299498304 -> j1130754573;
	j2529015854 [label="Boolean MarieFamilyFail is now false.",color=orange];
		j2529015854 -> "Chat ends.";
	j1387937899 [label="Perché cosa significa amare un altro se non accettarlo per tutto il bene e il male che è, après tout ?",shape=box,color=blue];
		j1387937899 -> j3722403271;
	j1130754573 [label="Oh, Drifter... mio povero Drifter. Non dovevi fare tutto questo per ottenere il mio perdono. ",shape=box,color=blue];
		j1130754573 -> j1104155357;
	j3722403271 [label="Boolean MarieEntratiCompleteA is now true.",color=orange];
		j3722403271 -> j2737891827;
	j1104155357 [label="Te l'avrei dato se me l'avessi chiesto. Hai già un posto nel mio cuore, lo sai ?",shape=box,color=blue];
		j1104155357 -> j4274183368;
		j1104155357 -> j2597201099;
	j2737891827 [label="Boolean MarieEntratiCompleteB is now false.",color=orange];
		j2737891827 -> j3065315887;
	j4274183368 [label="Veramente?",shape=box,color=red];
		j4274183368 -> j2886802222;
	j2597201099 [label="Ma ho dovuto affrontare così tanti problemi...",shape=box,color=red];
		j2597201099 -> j2084977833;
	j3065315887 [label="Boolean MarieEntratiCompleteC is now false.",color=orange];
		j3065315887 -> "Chat ends.";
	j2886802222 [label="Oui ! E se vuoi stare con me, mi farebbe piacere.",shape=box,color=blue];
		j2886802222 -> j2423093088;
		j2886802222 -> j1146604520;
	j2084977833 [label="E la colpa è tua, non mia ! Ma se vuoi stare con me, allora mi farebbe piacere.",shape=box,color=blue];
		j2084977833 -> j1146604520;
		j2084977833 -> j2423093088;
