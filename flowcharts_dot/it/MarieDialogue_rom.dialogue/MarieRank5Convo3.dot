		j4093698957 -> j587450359;
	j3386103928 [label="Ah, mi rende felice sapere che qualcuno qui capisce cosa significa. È così raro. Questa piaga silenziosa e invisibile di cui soffriamo.",shape=box,color=blue];
		j3386103928 -> j403553606;
	j2148462599 [label="Cosa c'è di sbagliato in questo?",shape=box,color=red];
