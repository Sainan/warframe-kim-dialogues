	j2969955895 [label="No, non capisco... continua.",shape=box,color=red];
		j2969955895 -> j134134145;
	j3241229077 [label="Non parlerò di fede se non per dire che... per quanto imperfette possiamo pensare alle nostre forme da questa visione limitata, dobbiamo... essere in pace con ciò che siamo, non ? È tutto ciò che abbiamo.",shape=box,color=blue];
		j3241229077 -> j2548984291;
	j1168867123 [label="So che le nostre fedi sono simili nella forma, quindi dirò che... Sol ha ritenuto opportuno crearmi come sono, e io devo avere fede nel suo disegno, non ? Per quanto possa sembrare imperfetto dal mio punto di vista limitato, mi chiedo se non potresti considerare lo stesso anche per te.",shape=box,color=blue];
		j1168867123 -> j2548984291;
	j1058694287 [label="So che le nostre fedi sono di forma diversa, quindi non parlerò di cose di cui non sono a conoscenza. Ma dirò semplicemente che Sol ha ritenuto opportuno crearmi come sono, e devo avere fede nel suo disegno, non per questo meno imperfetto. Per quanto possa sembrarlo dal mio punto di vista limitato, mi chiedo se non potresti fare lo stesso anche tu.",shape=box,color=blue];
		j1058694287 -> j2548984291;
	j43397503 [label="So che la tua fede è una questione personale, quindi non voglio intromettermi. Ma dirò semplicemente che Sol ha ritenuto opportuno crearmi come sono, e devo avere fede nel suo progetto, non ? Per quanto possa sembrare imperfetto dal mio punto di vista limitato, mi chiedo se tu non possa fare lo stesso.",shape=box,color=blue];
		j43397503 -> j2548984291;
	j4226056818 [label="Sol ha ritenuto opportuno farci entrambi come siamo, e noi dobbiamo avere fede nel suo progetto, non ? Per quanto imperfetto possiamo pensarlo dal nostro punto di vista limitato.",shape=box,color=blue];
		j4226056818 -> j2548984291;
	j336513610 [label="Lua ha ritenuto opportuno renderti come sei, e Sol ha ritenuto opportuno rendermi come sono. Dobbiamo avere fede nel loro progetto, non ? Non importa quanto possa sembrare imperfetto dal nostro punto di vista limitato.",shape=box,color=blue];
		j336513610 -> j2548984291;
	j1301533502 [label="I Luminari hanno ritenuto opportuno crearci come siamo. Dobbiamo avere fede nel loro progetto, non ? Non importa quanto possa sembrare imperfetto dal nostro punto di vista limitato.",shape=box,color=blue];
		j1301533502 -> j2548984291;
	j3113548214 [label="So che sei convinto che nessuno di noi possa conoscere la vera risposta all'universo, e lo lodo e lo rispetto. Ma dirò semplicemente che Sol ha ritenuto opportuno crearmi come sono, e devo avere fede nel suo progetto, non ? Non per questo è meno imperfetto, dal mio punto di vista limitato.",shape=box,color=blue];
		j3113548214 -> j2548984291;
	j2011599209 [label="So che non hai alcuna fede, e lo rispetto. Ma dirò semplicemente che Sol ha ritenuto opportuno crearmi come sono, e devo avere fede nel suo progetto, non? Non importa quanto possa sembrare imperfetto dal mio punto di vista limitato.",shape=box,color=blue];
		j2011599209 -> j2548984291;
	j1735217618 [label="Dirò semplicemente che Sol ha ritenuto opportuno crearmi come sono, e devo avere fede nel suo progetto, non ? Per quanto possa sembrarlo imperfetto dal mio punto di vista limitato.",shape=box,color=blue];
		j1735217618 -> j2548984291;
