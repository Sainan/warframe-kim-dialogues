		j587450359 -> j4216625834;
		j587450359 -> j4017098483;
	j403553606 [label="Come una piccola abeille che si posa su di noi e ci punge ogni giorno. Non abbastanza da distruggerci, ma abbastanza da infastidirci.",shape=box,color=blue];
		j403553606 -> j1226760277;
		j403553606 -> j1882253846;
