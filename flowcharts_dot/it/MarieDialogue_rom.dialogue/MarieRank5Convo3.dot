		j1048213634 -> j3994478196;
	j3379146656 [label="Sono entusiasta di essere così mobile, di poter raggiungere qualsiasi cosa desideri, non fraintendetemi. Ma è comunque così estenuante !",shape=box,color=blue];
		j3379146656 -> j3406863621;
	j2186655840 [label="E non è colpa loro, perché stavano facendo un atto di gentilezza - avevo bisogno di aiuto. E non è colpa loro se ne avevo bisogno. Ma quanto è frustrante aver bisogno di quell'assistenza.",shape=box,color=blue];
		j2186655840 -> j2250348962;
		j2186655840 -> j3070253328;
	j3406863621 [label="È così... bello poter parlare di tutto questo. Non riesco a esprimerlo a parole. È così raro poter parlare di questo tipo di piaga invisibile e silenziosa di cui soffro.",shape=box,color=blue];
		j3406863621 -> j25949692;
	j2890568058 [label="Mi fanno sempre male. Sempre. Anche ora, seduta qui, se ci penso, provo dolore. Ma non sempre è abbastanza da notarlo.",shape=box,color=blue];
