		j3938292889 -> j1849110820;
	j1849110820 [label="Conteneva una conoscenza che interessava a me e a nessun altro, quindi perché mi veniva negata ? E poi arrivava qualche anima gentile che, per pietà, la strappava dal suo posto per me...",shape=box,color=blue];
		j1849110820 -> j2186655840;
