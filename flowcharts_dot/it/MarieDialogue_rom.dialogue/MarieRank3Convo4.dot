		1239 -> 1243;
	1240 [label="L'Impero Orokin è chiamato così perché era governato dagli Orokin, ma Orokin era anche semplicemente il nome della classe dominante.",shape=box,color=red];
		1240 -> 1243;
	1244 [label="+10 Chemistry",color=orange];
		1244 -> 1248;
	1245 [label="Sono solo un po' sorpreso che tu ora ne sappia più di me su di lui.",shape=box,color=red];
