	j1010099276 [label="Pourquoi ?",shape=box,color=blue];
		j1010099276 -> j458941465;
		j1010099276 -> j4101375370;
	j4147404032 [label="No, gli Archimedei erano di rango inferiore agli Orokin.",shape=box,color=red];
		j4147404032 -> j2187339840;
	j4050835307 [label="L'Impero Orokin è chiamato così perché era governato dagli Orokin, ma Orokin era anche semplicemente il nome della classe dominante.",shape=box,color=red];
		j4050835307 -> j2187339840;
	j124703102 [label="+10 Chemistry",color=orange];
		j124703102 -> j3743861331;
	j458941465 [label="Sono solo un po' sorpreso che tu ora ne sappia più di me su di lui.",shape=box,color=red];
		j458941465 -> j124703102;
	j4101375370 [label="Non so nulla del passato di Loid, e lo conosco da un po'.",shape=box,color=red];
		j4101375370 -> j124703102;
	j2187339840 [label="Succede spesso. Non sei la sola.",shape=box,color=red];
		j2187339840 -> j312339123;
	j3743861331 [label="Oh ! Non prenderla sul personale, s'il vous plaît !",shape=box,color=blue];
		j3743861331 -> j2419561601;
	j312339123 [label="Gli Orokin hanno deliberatamente reso la loro società confusa e ottusa ?",shape=box,color=blue];
		j312339123 -> j376815586;
		j312339123 -> j3852444433;
		j312339123 -> j1027357887;
	j2419561601 [label="Monsieur Loid è, come si dice, distante ?",shape=box,color=blue];
		j2419561601 -> j3514979921;
		j2419561601 -> j3100545562;
	j376815586 [label="Migliaia di anni di potere, e la gente si... annoia. Le persone annoiate creano sistemi complicati.",shape=box,color=red];
		j376815586 -> j1436324537;
	j3852444433 [label="Avevano un gusto per l'ornato e l'intricato, che si estendeva anche alla burocrazia.",shape=box,color=red];
		j3852444433 -> j1436324537;
	j1027357887 [label="Onestamente? Comincio a pensarlo.",shape=box,color=red];
		j1027357887 -> j1436324537;
	j3514979921 [label="In realtà, non so nulla di lui.",shape=box,color=red];
		j3514979921 -> j1210561433;
	j3100545562 [label="È un po' distaccato, sì.",shape=box,color=red];
		j3100545562 -> j1210561433;
	j1436324537 [label="+10 Chemistry",color=orange];
		j1436324537 -> j2415220763;
	j1210561433 [label="Guarda con chi passo il mio tempo, oui ? Impara a leggere una statua e non sarà troppo difficile imparare a leggerne un'altra.",shape=box,color=blue];
		j1210561433 -> j2682250135;
	j2415220763 [label="Penso l'abbiano fatto solo per dare fastidio !",shape=box,color=blue];
		j2415220763 -> j1451255618;
	j2682250135 [label="+10 Chemistry",color=orange];
		j2682250135 -> j2571985211;
	j1451255618 [label="Et ils se demandent pourquoi des rébellions éclatent. Vous aviez peut-être vos warframes, mais nous avions nos guillotines !",shape=box,color=blue];
		j1451255618 -> j3566713005;
	j2571985211 [label="Anche se ammetto che Monsieur Loid è un po' più... piquant del caro Lyon.",shape=box,color=blue];
		j2571985211 -> j1065907652;
		j2571985211 -> j2211348109;
	j3566713005 [label="Vive la révolution !",shape=box,color=blue];
		j3566713005 -> j963893578;
		j3566713005 -> j2182367326;
		j3566713005 -> j3207033723;
	j1065907652 [label="Ha le sue ragioni.",shape=box,color=red];
		j1065907652 -> j3726795809;
	j2211348109 [label="Comunque... qual era la tua domanda?",shape=box,color=red];
		j2211348109 -> j2743192347;
