	j3726795809 [label="Sì, certamente.",shape=box,color=blue];
		j3726795809 -> j2186374148;
	j2743192347 [label="Ah ! Sì.",shape=box,color=blue];
		j2743192347 -> j2186374148;
	j443837882 [label="Non fare caso a me, mi sto solo divertendo un po'. Sciocchina Marie la révolutionnaire.",shape=box,color=blue];
		j443837882 -> j3935389025;
	j62719997 [label="+10 Chemistry",color=orange];
		j62719997 -> j443837882;
	j2186374148 [label="Temo di essermi completamente dimenticata cosa sono venuta a chiederti! Ha! Vabbè. Mi verrà in mente.",shape=box,color=blue];
		j2186374148 -> j2852664562;
	j3935389025 [label="Grazie per aver risposto alla mia domanda, dovrei lasciarti andare. ",shape=box,color=blue];
		j3935389025 -> j2852664562;
