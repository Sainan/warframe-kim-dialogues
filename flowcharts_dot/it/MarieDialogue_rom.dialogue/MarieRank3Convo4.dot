	1252 [label="Monsieur Loid è, come si dice, distante ?",shape=box,color=blue];
		1252 -> 1254;
		1252 -> 1255;
	1249 [label="Migliaia di anni di potere, e la gente si... annoia. Le persone annoiate creano sistemi complicati.",shape=box,color=red];
		1249 -> 1253;
	1250 [label="Avevano un gusto per l'ornato e l'intricato, che si estendeva anche alla burocrazia.",shape=box,color=red];
