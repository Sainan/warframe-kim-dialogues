		1255 -> 1257;
	1253 [label="+10 Chemistry",color=orange];
		1253 -> 1256;
	1257 [label="Guarda con chi passo il mio tempo, oui ? Impara a leggere una statua e non sarà troppo difficile imparare a leggerne un'altra.",shape=box,color=blue];
