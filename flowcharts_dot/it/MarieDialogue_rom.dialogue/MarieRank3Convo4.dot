		j3827320772 -> j1010099276;
	j4258294029 [label="Potrei chiedere al diavolo, suppongo. Non mi piace parlargli, se posso evitarlo.",shape=box,color=blue];
		j4258294029 -> j4147404032;
		j4258294029 -> j4050835307;
	j1476564812 [label="De la jalousie ? Pourquoi ?",shape=box,color=blue];
