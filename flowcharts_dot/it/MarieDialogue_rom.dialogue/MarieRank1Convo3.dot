	167 [label="+5 Chemistry",color=orange];
		167 -> 173;
	168 [label="Non ho mai sentito il bisogno di lamentarmi. Ti dico però, che adoro la possibilità di prendere oggetti dagli scaffali alti senza un aiuto.",shape=box,color=blue];
		168 -> 174;
	169 [label="Oui, le Cardinal raccontò a Lyon e a me tutto ciò che sarebbe successo con i sérums che ci hanno cambiato forma. Sapevamo cosa avrebbero fatto.",shape=box,color=blue];
		169 -> 175;
	166 [label="+5 Chemistry",color=orange];
