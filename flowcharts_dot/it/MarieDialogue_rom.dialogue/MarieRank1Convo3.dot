	136 [label="+10 Chemistry",color=orange];
		136 -> 140;
	137 [label="Non so come la chiameresti ? Un fauteuil roulant, o... forse un termine che detesto profondamente, un fauteuil pour invalide.",shape=box,color=blue];
		137 -> 141;
	135 [label="Par les Luminaires... continua.",shape=box,color=blue];
		135 -> 139;
	134 [label="Par les Luminaires... Vuoi dire che siamo tutti qui in segreto ?! È per questo che non ci è permesso lasciare questo posto ?! Mais pourquoi ?!",shape=box,color=blue];
		134 -> 138;
	140 [label="Oh ! Oh, poverino. Immaginati, seduto lì, a chiederti se le Cardinal mi ha portato via i mes pieds! Non, non, non - niente del genere.",shape=box,color=blue];
		140 -> 144;
	141 [label="Come quella che stiamo utilizzando ora, per sederci e utilizzare questi adorabili dispositivi per comunicare. Ma con le ruote ai lati, per spostarsi. Una sedia con le ruote, se preferisci.",shape=box,color=blue];
		141 -> 145;
		141 -> 146;
	139 [label="A detta di tutti era un genio e la mente dietro lo sfruttamento dei cristalli di argon.",shape=box,color=red];
		139 -> 143;
	138 [label="Sua figlia, Euleria - detta Madre, e la sua famiglia, si sono presi cura di Deimos per tutto questo tempo.",shape=box,color=red];
		138 -> 142;
	144 [label="Sol ritenne opportuno inserire nella mia vita l'inconveniente di essere nata con piedi inutilizzabili. Non potevo camminare. ",shape=box,color=blue];
		144 -> 149;
	145 [label="Eri invalida prima di diventare un protoframe?",shape=box,color=red];
		145 -> 150;
	146 [label="Ce tu ci creda o no, le chiamiamo sedie a rotelle.",shape=box,color=red];
		146 -> 151;
	143 [label="Che vengono sfruttati dal Void - sono il motivo per cui possiamo creare molti dei potenti warframe e armi che realizziamo.",shape=box,color=red];
		143 -> 148;
	142 [label="Vegliando su questo posto e sul cuore che pompa l'energia del Void nel Sistema Origin, mantenendoci tutti... utilizzabili, in realtà, da quando Entrati se n'è andato.",shape=box,color=red];
		142 -> 861;
	149 [label="Ma era semplicemente questo: un incoveniente.",shape=box,color=blue];
		149 -> 155;
	150 [label="Non. Non lo ero per niente.",shape=box,color=blue];
		150 -> 156;
	151 [label="Aha ! Oh, sto ridendo di me stessa per essere stata così sciocca. Sì, suppongo che le chiameresti sedie a rotelle, visto che sono sedie con le ruote. Che sciocca che sono.",shape=box,color=blue];
		151 -> 155;
	148 [label="Si specializzò in cristallografia. E i suoi lavori furono archiviati qui, nei laboratori.",shape=box,color=red];
		148 -> 154;
