		165 -> 171;
	173 [label="Update boolean MarieSecretPower",color=orange];
		173 -> 179;
	174 [label="Ce qui est fait est fait. Non potevo pregare Sol per un miracolo, quando così tante persone soffrivano intorno a me, quando così tante persone avevano più bisogno. I Luminari mi avevano già dato così tanto.",shape=box,color=blue];
		174 -> 180;
	175 [label="Ma come tutte le cose, ho preso la mia con gioia, e Lyon ha preso la sua... oh, temo di aver detto troppo, e non avrei dovuto.",shape=box,color=blue];
		175 -> 181;
		175 -> 182;
	172 [label="Pauvre petit...",shape=box,color=blue];
		172 -> 178;
	170 [label="Anche se capisco la logica dietro la decisione di proteggerli dal dolore che le Cardinal ha causato con la sua necessaria dipartita...",shape=box,color=blue];
		170 -> 176;
	171 [label="+10 Chemistry",color=orange];
		171 -> 177;
	179 [label="Oui ! Hai capito. Conoscevo il mondo da un altro punto di vista. Le mie braccia erano più forti. Sono più paziente. So cosa significa godersi il momento.",shape=box,color=blue];
		179 -> 190;
	180 [label="Devo andare. Ti ringrazio per questa meravigliosa distrazione. ",shape=box,color=blue];
		180 -> 191;
	181 [label="Nessun problema. Non dirmi niente di più di quello che ti fa sentire a tuo agio.",shape=box,color=red];
		181 -> 192;
	182 [label="Per favore, continua. Sto facendo fatica a comunicare con lui.",shape=box,color=red];
		182 -> 193;
	178 [label="Quindi, è stato trasferito nel necraloid principale - l'unico Necraloid rimasto - ed è... beh? È difficile da spiegare.",shape=box,color=red];
		178 -> 187;
		178 -> 188;
		178 -> 189;
	176 [label="Penso che sia inutilmente crudele, non credi ? Potrebbero crederlo morto. O peggio ! E noi, viviamo qui, comme des rats d'égout ?",shape=box,color=blue];
		176 -> 183;
		176 -> 184;
		176 -> 185;
	177 [label="Oui... capisco la logica. Allora, mi impegnerei a rimettere insieme la loro famiglia, se puoi, non ? Sembra essere l'unica speranza che abbiamo per uscire da questo posto. ",shape=box,color=blue];
		177 -> 186;
	190 [label="Quando arrivo a destinazione, mi godo l'eleganza del viaggio. Non mi muovo come uno scarafaggio con un miliardo di zampette.",shape=box,color=blue];
