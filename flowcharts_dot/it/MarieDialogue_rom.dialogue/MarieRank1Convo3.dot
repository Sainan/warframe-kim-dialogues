	202 [label="Vorrei semplicemente che il mio caro Lyon potesse vedere il mondo come lo vedi tu. Che tutte le 'inconvenienze' fossero un potere segreto, come dici tu.",shape=box,color=blue];
		202 -> 213;
	203 [label="Apprezzo la tua gentilezza, Drifter. Mi limiterò a dire questo, per non oltrepassare eventuali imposizioni che potrei farti- ",shape=box,color=blue];
		203 -> 214;
	204 [label="Non sei il solo, Drifter. Lyon è come una famiglia per me, e a volte mi chiedo ancora se lo conosco più delle statue dei santi nella cattedrale.",shape=box,color=blue];
