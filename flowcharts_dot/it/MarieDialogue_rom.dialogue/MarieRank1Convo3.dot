digraph {
	77 [label="MarieRank1Convo3 begins.",color=orange];
		77 -> 78;
	78 [label="Il y a un crâne volant ! Keksekça ?! C'è un teschio parlante volante e tutti fanno finta di niente, ho bisogno che qualcuno riconosca la stanezza della sua intera esistenza.",shape=box,color=blue];
		78 -> 79;
		78 -> 81;
		78 -> 80;
	79 [label="Quello è solo Necraloid. Beh, un necraloid. È complicato.",shape=box,color=red];
		79 -> 82;
	81 [label="Quello è Necraloid. È un Cephalon, non ti farà del male.",shape=box,color=red];
		81 -> 84;
	80 [label="[Fine.]",shape=box,color=red];
		80 -> 83;
	82 [label="Pardon, è un nome o un oggetto ?",shape=box,color=blue];
		82 -> 85;
		82 -> 86;
	84 [label="Non lo considero una minaccia ! Non mi spaventa.",shape=box,color=blue];
		84 -> 87;
	83 [label="Chat ends.",color=orange];
	85 [label="Non... lo so con certezza.",shape=box,color=red];
		85 -> 88;
	86 [label="Sì.",shape=box,color=red];
		86 -> 89;
	87 [label="In effetti, lo trovo assolutamente affascinante, anche se un po' inflessibile nella conversazione. Non molto diverso dalla sua ispirazione vivente. Ma data la natura del mio compagno di viaggio preferito, puoi capire che questo non mi disturba più di tanto.",shape=box,color=blue];
		87 -> 90;
	88 [label="Innanzitutto, di chi è il design di questi \"Necraloid\" ? Di cui sono un nome e forse anche una designazione ?",shape=box,color=blue];
		88 -> 91;
		88 -> 92;
	89 [label="Io... non capisco. E che ruolo ha Loid in tutto questo ?",shape=box,color=blue];
		89 -> 88;
	90 [label="No, quello che potresti trovare di grottesco nel suo volto, te lo assicuro, non è il problema che sto affrontando in questo momento.",shape=box,color=blue];
		90 -> 93;
		90 -> 94;
	91 [label="Il tuo Cardinal Dimanche. Entrati.",shape=box,color=red];
		91 -> 95;
	92 [label="Quello è stato inventato da Entrati. Ma il concetto di ciò che sono - Cephalon - è stato inventato dagli Orokin.",shape=box,color=red];
		92 -> 95;
	93 [label="Mi sorprende che il teschio non ti dia fastidio.",shape=box,color=red];
		93 -> 96;
	94 [label="Lo ammetto, decontestualizzato, dev'essere strano. Ma qual'è veramente il problema?",shape=box,color=red];
		94 -> 97;
	95 [label="Excusez-moi, vuoi forse dire che le Cardinal ha creato un servo teschio volante a somiglianza del suo compagno e gli ha dato questo nome ?",shape=box,color=blue];
		95 -> 98;
	96 [label="Sai poco di me, e non è colpa tua. Ho trascorso gran parte della mia vita a prendermi cura dei morti e dei luoghi in cui riposano. ",shape=box,color=blue];
		96 -> 99;
	97 [label="Mi incuriosisce il motivo per cui sulla sua schiena c'è un altro volto che assomiglia allo scarabocchio di un bambino.",shape=box,color=blue];
		97 -> 100;
	98 [label="Perché allora non ce ne sono di più, di questi necraloid ?",shape=box,color=blue];
		98 -> 101;
		98 -> 102;
		98 -> 103;
	99 [label="Ho trascorso gran parte della mia vita con loro, come se fossero i miei compagni di viaggio. Sono sempre ansiosi di ascoltare i miei problemi quotidiani.",shape=box,color=blue];
		99 -> 104;
	100 [label="Ho chiesto informazioni sia a Monsieur Necraloid che a Monsieur Loid, ma nessuno dei due ha voluto parlarne, mi hanno solo detto un nome: Otak. E lo hanno pronunciato con grande tristezza.",shape=box,color=blue];
		100 -> 105;
	101 [label="Forse si è reso conto di quanto sia orribile crearsi una copia digitale del proprio amante.",shape=box,color=red];
		101 -> 106;
	102 [label="Forse aveva solo intenzione di fare quello.",shape=box,color=red];
		102 -> 107;
	103 [label="Non ne sono sicuro. Forse non ha mai avuto il tempo di farne altri?",shape=box,color=red];
		103 -> 108;
	104 [label="Update boolean MarieGraveyard1",color=orange];
		104 -> 109;
		104 -> 110;
	105 [label="Quindi eccomi qui, a parlare con te, nella speranza che tu possa aiutarmi.",shape=box,color=blue];
		105 -> 111;
		105 -> 112;
	106 [label="Ou bien, un tributo al suo amore e al suo rispetto, perché non pensava che questo strano laboratorio potesse continuare a funzionare senza Monsieur Loid.",shape=box,color=blue];
		106 -> 113;
		106 -> 114;
	107 [label="+5 Chemistry",color=orange];
		107 -> 115;
	108 [label="Immagina, un banco di teschi volanti, disinvolti e perfettamente efficienti !",shape=box,color=blue];
		108 -> 114;
		108 -> 116;
	109 [label="Ti piaceva prenderti cura dei cimiteri?",shape=box,color=red];
		109 -> 117;
	110 [label="Hanno mai risposto?",shape=box,color=red];
		110 -> 118;
	111 [label="Vuoi sapere di Otak? O del perché non puoi parlargli?",shape=box,color=red];
		111 -> 119;
	112 [label="Otak è difficile da spiegare...",shape=box,color=red];
		112 -> 2918;
	113 [label="Direi che è uno strano gesto romantico, ma non sono la persona migliore per parlare di questo.",shape=box,color=red];
		113 -> 122;
	114 [label="Sinceramente non mi dispiacerebbe che un necraloid ronzasse intorno a casa mia.",shape=box,color=red];
		114 -> 123;
	115 [label="Tragico e bello, a suo modo, non è un tributo al suo amore e al suo rispetto, perché non pensava che questo strano laboratorio potesse continuare a funzionare senza Monsieur Loid.",shape=box,color=blue];
		115 -> 124;
		115 -> 113;
	116 [label="Sinceramente, sono contento che ce ne sia solo uno. Non credo che il mondo sarebbe pronto per una cosa del genere.",shape=box,color=red];
		116 -> 125;
	117 [label="E mausolei e cripte, oh sì. Ma ammetto che preferivo gli spazi esterni, anche se per la mia sedia erano impegnativi da percorrere. Non più delle scale, ma comunque.",shape=box,color=blue];
		117 -> 126;
	118 [label="Ah ! No, per fortuna. Non finché il tuo \"Necraloid\" con un volto così macabro mi ha risposto. Non saprei dirti se parlare con i morti rientra nei doni dei Luminari.",shape=box,color=blue];
		118 -> 127;
	119 [label="Credo che col tempo mi piacerebbe sapere entrambe le cose, ma lascerò che sia tu a decidere da dove cominciare. Non so cosa sia più importante, après tout.",shape=box,color=blue];
		119 -> 2918;
	2918 [label="Check boolean LoidFamilyComplete",color=orange];
		2918 -> 121 [label=true,color=green];
		2918 -> 121 [label=false,color=brown];
		2918 -> 120 [label=false,color=brown];
	122 [label="E ora sono incuriosita, ma questa sembra una storia per un'altra volta. Cela dit...",shape=box,color=blue];
		122 -> 97;
	123 [label="Allora sono assolutamente certa che tu abbia probabilmente bisogno di compagnia o di un'organizzazione, o di entrambe. Ma questo è un discorso che affronteremo un'altra volta.",shape=box,color=blue];
		123 -> 97;
	124 [label="Penso che il motivo fosse più che altro quello di garantire che questo posto non andasse in rovina.",shape=box,color=red];
		124 -> 130;
	125 [label="Esatto ! Anch'io. Il che mi porta alla mia prossima domanda.",shape=box,color=blue];
		125 -> 97;
	126 [label="Update boolean MarieSerum1",color=orange];
		126 -> 131;
		126 -> 132;
	127 [label="No, sentire spiriti e voci rientra molto più nelle competenze del mio caro Lyon che nelle mie. Anche se mi chiedo se anche Monsieur Necraloid venga tormentato, a giudicare dallo scarabocchio sulla nuca.",shape=box,color=blue];
		127 -> 133;
	121 [label="Otak era un Archimedeo, uno scienziato e accademico Orokin. Quello che gli è successo non è esattamente una storia felice.",shape=box,color=red];
		121 -> 129;
	120 [label="Beh... in breve, di sopra ci sono alcuni membri della famiglia Entrati, e non sono... esattamente consapevoli che siamo qui sotto.",shape=box,color=red];
		120 -> 128;
	130 [label="E potresti benissimo avere ragione. L'amalgam volante sembra perdere grand parte della vera raison d'être e nuance del Monsieur Loid. Cela dit...",shape=box,color=blue];
		130 -> 97;
	131 [label="Non sapevo se fosse opportuno chiederti se il siero avesse modificato i tuoi piedi...",shape=box,color=red];
		131 -> 136;
	132 [label="La tua sedia?",shape=box,color=red];
		132 -> 137;
	133 [label="In realtà è di questo che volevo parlarti, se non ti dispiace.",shape=box,color=blue];
		133 -> 100;
	129 [label="Update boolean MarieOtak1",color=orange];
		129 -> 135;
