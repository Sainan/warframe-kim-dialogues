	3098 [label="Chat ends.",color=orange];
	3099 [label="Nessuno dei Cavia conosce la propria data di nascita, il che immagino abbia senso, dato che sono nati senza la capacità di parlare o di conoscere il calendrier come noi.",shape=box,color=blue];
		3099 -> 3100;
	3100 [label="Allora ho pensato, che tragédie ! Dobbiamo rimediare subito, non ?",shape=box,color=blue];
		3100 -> 3101;
		3100 -> 3102;
		3100 -> 3103;
	3101 [label="Non ci avevo mai pensato.",shape=box,color=red];
		3101 -> 3104;
	3102 [label="Come scoprirai quando sono nati?",shape=box,color=red];
		3102 -> 3105;
	3103 [label="Lascerai che siano loro a scegliere la data del loro compleanno?",shape=box,color=red];
		3103 -> 3106;
	3104 [label="Oui ! Nemmeno Monsieur Loid. L'espressione sul suo viso quando lo abbiamo scoperto era di puro dolore...",shape=box,color=blue];
		3104 -> 3107;
	3105 [label="All'inizio ho pensato di controllare i registri de le Cardinal - forse aveva registrato la loro data di nascita, oui ?",shape=box,color=blue];
		3105 -> 3108;
	3106 [label="''Lasciare ?'' Lo dici come se dipendesse da me ! ",shape=box,color=blue];
		3106 -> 3105;
	3107 [label="Mi spezza il cuore che lui pensi che sia colpa sua per non averci pensato prima. Non è colpa sua, fa così tanto per così tanti...",shape=box,color=blue];
		3107 -> 3109;
	3108 [label="Evaluate expressions",color=orange];
