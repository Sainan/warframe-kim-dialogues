		3108 -> 3111 [label="false",color=purple];
	3109 [label="Siamo tutti fortunati a conoscere la gentilezza di Monsieur Loid. La profondità del pozzo da cui attinge non conosce fine.",shape=box,color=blue];
		3109 -> 3112;
		3109 -> 3113;
	3110 [label="Ma poi mi sono ricordata... delle mie conversazioni con M'sieur Tagfer, e gli altri, e ho pensato... che forse non sarebbe stato poi così saggio.",shape=box,color=blue];
		3110 -> 3114;
	3111 [label="Ma sembravano disinteressati a trovare testimonianze del loro passato. So quanto possa essere doloroso pensare alle proprie origini.",shape=box,color=blue];
		3111 -> 3114;
	3112 [label="Siamo davvero fortunati che sia qui.",shape=box,color=red];
		3112 -> 3115;
	3113 [label="Vorrei solo che ogni tanto si tirasse un po' su.",shape=box,color=red];
		3113 -> 3116;
	3114 [label="Dopotutto, non conosco il mio giorno di nascita. ",shape=box,color=blue];
		3114 -> 3117;
		3114 -> 3118;
		3114 -> 3119;
	3115 [label="Oui, lo siamo. Lo siamo tutti.",shape=box,color=blue];
		3115 -> 3120;
	3116 [label="È un uomo serio, ma l'ho visto sorridere. C'è umorismo in lui, anche quando meno te lo aspetti. Bisogna solo avere pazienza.",shape=box,color=blue];
		3116 -> 3120;
	3117 [label="Se ti fa sentire meglio, neanche io lo so. Ho il sospetto che nemmeno il ragazzino se lo ricordi.",shape=box,color=red];
		3117 -> 3121;
	3118 [label="I compleanni sono sopravvalutati.",shape=box,color=red];
		3118 -> 3122;
	3119 [label="Comunque, è più divertente sceglierne uno da soli. È più poignant. ",shape=box,color=red];
		3119 -> 3123;
	3120 [label="Check boolean MarieDating",color=orange];
		3120 -> 3125 [label=true,color=green];
		3120 -> 3124 [label=false,color=brown];
	3121 [label="Altri motivi per piangere per te e la tua minuscola copia. Ancora più cose che abbiamo in comune !",shape=box,color=blue];
		3121 -> 3120;
	3122 [label="Non credo che siano affatto sopravvalutati ! Dobbiamo celebrare coloro che sono ancora con noi, così come celebriamo coloro che non ci sono più.",shape=box,color=blue];
		3122 -> 3120;
	3123 [label="Poignant ? Non sapevo che parlassi il Gaullique ! L'hai imparato da me ?",shape=box,color=blue];
		3123 -> 3126;
		3123 -> 3127;
	3125 [label="+20 Chemistry",color=orange];
