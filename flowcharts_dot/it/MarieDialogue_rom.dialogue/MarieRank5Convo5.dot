		3127 -> 3131;
	3129 [label="Ora ! Forza, mon cœur ! Anche se non ne verrà fuori nulla, è il pensiero che conta ! Au calendrier !",shape=box,color=blue];
		3129 -> 3132;
	3128 [label="Ora ! Forza ! Anche se non ne verrà fuori nulla, è il pensiero che conta ! Au calendrier !",shape=box,color=blue];
