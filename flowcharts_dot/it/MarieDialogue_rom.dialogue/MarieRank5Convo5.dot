		j20182927 -> j647088499 [label=true,color=green];
		j20182927 -> j3357340177 [label=false,color=brown];
	j647088499 [label="Bonjour, bonjour, mon cœur ! Devo raccontarti una sciocchezza.",shape=box,color=blue];
		j647088499 -> j803232928;
		j647088499 -> j4115718638;
	j3357340177 [label="Bonjour ! Devo raccontarti una sciocchezza.",shape=box,color=blue];
		j3357340177 -> j803232928;
		j3357340177 -> j4115718638;
	j803232928 [label="Oh? Cosa è successo?",shape=box,color=red];
		j803232928 -> j906956275;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j906956275 [label="Ho chiesto a Monsieur Bird Trois quando fosse il suo compleanno, ma non lo sapeva ! Che tristezza !",shape=box,color=blue];
		j906956275 -> j458394321;
	"Chat ends." [color=orange];
	j458394321 [label="Nessuno dei Cavia conosce la propria data di nascita, il che immagino abbia senso, dato che sono nati senza la capacità di parlare o di conoscere il calendrier come noi.",shape=box,color=blue];
		j458394321 -> j3955927123;
	j3955927123 [label="Allora ho pensato, che tragédie ! Dobbiamo rimediare subito, non ?",shape=box,color=blue];
		j3955927123 -> j4179984715;
		j3955927123 -> j1922353531;
		j3955927123 -> j3712622590;
	j4179984715 [label="Non ci avevo mai pensato.",shape=box,color=red];
		j4179984715 -> j2084454695;
	j1922353531 [label="Come scoprirai quando sono nati?",shape=box,color=red];
		j1922353531 -> j719227828;
	j3712622590 [label="Lascerai che siano loro a scegliere la data del loro compleanno?",shape=box,color=red];
		j3712622590 -> j4044206020;
	j2084454695 [label="Oui ! Nemmeno Monsieur Loid. L'espressione sul suo viso quando lo abbiamo scoperto era di puro dolore...",shape=box,color=blue];
		j2084454695 -> j529418423;
	j719227828 [label="All'inizio ho pensato di controllare i registri de le Cardinal - forse aveva registrato la loro data di nascita, oui ?",shape=box,color=blue];
		j719227828 -> j2402114516;
	j4044206020 [label="''Lasciare ?'' Lo dici come se dipendesse da me ! ",shape=box,color=blue];
		j4044206020 -> j719227828;
	j529418423 [label="Mi spezza il cuore che lui pensi che sia colpa sua per non averci pensato prima. Non è colpa sua, fa così tanto per così tanti...",shape=box,color=blue];
		j529418423 -> j3406546656;
	j2402114516 [label="Evaluate expressions",color=orange];
		j2402114516 -> j2621815839 [label="MarieEntratiComplete",color=purple];
		j2402114516 -> j2621815839 [label="MarieEntrati3a",color=purple];
		j2402114516 -> j362733751 [label="false",color=purple];
	j3406546656 [label="Siamo tutti fortunati a conoscere la gentilezza di Monsieur Loid. La profondità del pozzo da cui attinge non conosce fine.",shape=box,color=blue];
		j3406546656 -> j4008679114;
		j3406546656 -> j2082085808;
	j2621815839 [label="Ma poi mi sono ricordata... delle mie conversazioni con M'sieur Tagfer, e gli altri, e ho pensato... che forse non sarebbe stato poi così saggio.",shape=box,color=blue];
		j2621815839 -> j430153124;
	j362733751 [label="Ma sembravano disinteressati a trovare testimonianze del loro passato. So quanto possa essere doloroso pensare alle proprie origini.",shape=box,color=blue];
		j362733751 -> j430153124;
	j4008679114 [label="Siamo davvero fortunati che sia qui.",shape=box,color=red];
		j4008679114 -> j1981204352;
	j2082085808 [label="Vorrei solo che ogni tanto si tirasse un po' su.",shape=box,color=red];
		j2082085808 -> j4075254408;
	j430153124 [label="Dopotutto, non conosco il mio giorno di nascita. ",shape=box,color=blue];
		j430153124 -> j1248832254;
		j430153124 -> j1533186161;
		j430153124 -> j3707721883;
	j1981204352 [label="Oui, lo siamo. Lo siamo tutti.",shape=box,color=blue];
		j1981204352 -> j3542593548;
	j4075254408 [label="È un uomo serio, ma l'ho visto sorridere. C'è umorismo in lui, anche quando meno te lo aspetti. Bisogna solo avere pazienza.",shape=box,color=blue];
		j4075254408 -> j3542593548;
	j1248832254 [label="Se ti fa sentire meglio, neanche io lo so. Ho il sospetto che nemmeno il ragazzino se lo ricordi.",shape=box,color=red];
		j1248832254 -> j3852910400;
	j1533186161 [label="I compleanni sono sopravvalutati.",shape=box,color=red];
		j1533186161 -> j1044116009;
	j3707721883 [label="Comunque, è più divertente sceglierne uno da soli. È più poignant. ",shape=box,color=red];
		j3707721883 -> j3002046105;
	j3542593548 [label="Check boolean MarieDating",color=orange];
		j3542593548 -> j2257614666 [label=true,color=green];
		j3542593548 -> j4238446941 [label=false,color=brown];
	j3852910400 [label="Altri motivi per piangere per te e la tua minuscola copia. Ancora più cose che abbiamo in comune !",shape=box,color=blue];
		j3852910400 -> j3542593548;
	j1044116009 [label="Non credo che siano affatto sopravvalutati ! Dobbiamo celebrare coloro che sono ancora con noi, così come celebriamo coloro che non ci sono più.",shape=box,color=blue];
		j1044116009 -> j3542593548;
	j3002046105 [label="Poignant ? Non sapevo che parlassi il Gaullique ! L'hai imparato da me ?",shape=box,color=blue];
		j3002046105 -> j745356374;
		j3002046105 -> j589704543;
	j2257614666 [label="+20 Chemistry",color=orange];
		j2257614666 -> j3166526500;
	j4238446941 [label="+20 Chemistry",color=orange];
		j4238446941 -> j2735324758;
	j745356374 [label="Io... penso che sia universale...",shape=box,color=red];
		j745356374 -> j3718388041;
	j589704543 [label="Devo averlo imparato da te.",shape=box,color=red];
		j589704543 -> j2166037928;
	j3166526500 [label="Ora ! Forza, mon cœur ! Anche se non ne verrà fuori nulla, è il pensiero che conta ! Au calendrier !",shape=box,color=blue];
		j3166526500 -> "Chat ends.";
	j2735324758 [label="Ora ! Forza ! Anche se non ne verrà fuori nulla, è il pensiero che conta ! Au calendrier !",shape=box,color=blue];
		j2735324758 -> "Chat ends.";
	j3718388041 [label="Pff ! Tutte le altre lingue rubano sempre il meglio del Gaullique ! I tempi non cambieranno mai !",shape=box,color=blue];
		j3718388041 -> j3542593548;
	j2166037928 [label="Allora sei intelligente ! Il Gaullique è una delle lingue più belle che siano mai esistite e sono felice di portarla nel futuro.",shape=box,color=blue];
		j2166037928 -> j3542593548;
}