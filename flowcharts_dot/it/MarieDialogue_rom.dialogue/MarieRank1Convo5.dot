digraph {
	"MarieRank1Convo5 begins." [color=orange];
		"MarieRank1Convo5 begins." -> j59701789;
	j59701789 [label="Bonjour, bonjour! Tu devi essere il Drifter, oui ? Monsieur Loid mi ha parlato tanto di te. Sono davvero felice di \"incontrarti\" in questo...",shape=box,color=blue];
		j59701789 -> j4071783264;
	j4071783264 [label="Appareil cliquetant, per quanto intelligente sia !",shape=box,color=blue];
		j4071783264 -> j1380571409;
	j1380571409 [label="Sono Sœur Marie Leroux, ma puoi chiamarmi Marie. Sono arrivata di recente con il fratello della mia anima, Padre Lyon Allard e... beh, credo che Monsieur Loid ti abbia messo in guardia dal diavolo, n'est-ce pas ?",shape=box,color=blue];
		j1380571409 -> j2092240878;
		j1380571409 -> j3073407659;
		j1380571409 -> j4115718638;
	j2092240878 [label="È un piacere conoscerti. E non fraintendermi, siete i benvenuti, ma... cosa ci fate qui?",shape=box,color=red];
		j2092240878 -> j2106552108;
	j3073407659 [label="Il diavolo? Intendi l'Orokin?",shape=box,color=red];
		j3073407659 -> j313042017;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j2106552108 [label="+5 Chemistry",color=orange];
		j2106552108 -> j2515653162;
	j313042017 [label="Oui, ce monstre irritant à la peau bleue che ci è stato affidato dal Cardinale. Credo che lo conosci come Albrecht Entrati? È il motivo per cui siamo qui. Ma questa è una storia molto lunga, j'en ai bien peur.",shape=box,color=blue];
		j313042017 -> j4104179245;
		j313042017 -> j3074423280;
	"Chat ends." [color=orange];
	j2515653162 [label="Merci ! The what and the how of our being here is a very long story, j'en ai bien peur. We were sent here by le Cardinal. I believe you know him as Albrecht Entrati ? He entrusted us with that blue-skinned monstre irritant.",shape=box,color=blue];
		j2515653162 -> j4104179245;
		j2515653162 -> j3074423280;
	j4104179245 [label="Farò tutto il possibile per aiutare.",shape=box,color=red];
		j4104179245 -> j1610808253;
	j3074423280 [label="'Affidato?'",shape=box,color=red];
		j3074423280 -> j3560146493;
	j1610808253 [label="+5 Chemistry",color=orange];
		j1610808253 -> j2342252093;
	j3560146493 [label="Dobbiamo fare tutto il possibile per guidare la sua anima, si c'est possibile. Et si ce n'est pas le cas ? Allora dobbiamo assicurarci almeno che non causi più alcun danno.",shape=box,color=blue];
		j3560146493 -> j4012300998;
		j3560146493 -> j19678308;
	j2342252093 [label="Sei proprio come Monsieur Loid e i Cavia hanno descritto ! Penso che diventeremo buoni amici.",shape=box,color=blue];
		j2342252093 -> j2767514377;
	j4012300998 [label="Sono disposto ad aiutarti.",shape=box,color=red];
		j4012300998 -> j1610808253;
	j19678308 [label="È un Orokin. L'unico modo per riuscirci è piantargli un proiettile tra gli occhi.",shape=box,color=red];
		j19678308 -> j1041484988;
	j2767514377 [label="Ah ! Devo andare, perdonami. Spero che ci risentiremo presto! À la revoyure!",shape=box,color=blue];
		j2767514377 -> "Chat ends.";
	j1041484988 [label="Sembra di sentir parlare Lyon. Non perderò la speranza. Non ancora.",shape=box,color=blue];
		j1041484988 -> j2767514377;
}