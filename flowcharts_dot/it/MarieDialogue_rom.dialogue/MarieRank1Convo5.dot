digraph {
	3964 [label="MarieRank1Convo5 begins.",color=orange];
		3964 -> 3965;
	3965 [label="Bonjour, bonjour! Tu devi essere il Drifter, oui ? Monsieur Loid mi ha parlato tanto di te. Sono davvero felice di \"incontrarti\" in questo...",shape=box,color=blue];
		3965 -> 3966;
	3966 [label="Appareil cliquetant, per quanto intelligente sia !",shape=box,color=blue];
		3966 -> 3967;
	3967 [label="Sono Sœur Marie Leroux, ma puoi chiamarmi Marie. Sono arrivata di recente con il fratello della mia anima, Padre Lyon Allard e... beh, credo che Monsieur Loid ti abbia messo in guardia dal diavolo, n'est-ce pas ?",shape=box,color=blue];
		3967 -> 3968;
		3967 -> 3969;
		3967 -> 3970;
	3968 [label="È un piacere conoscerti. E non fraintendermi, siete i benvenuti, ma... cosa ci fate qui?",shape=box,color=red];
		3968 -> 3972;
	3969 [label="Il diavolo? Intendi l'Orokin?",shape=box,color=red];
		3969 -> 3974;
	3970 [label="[Fine.]",shape=box,color=red];
		3970 -> 3971;
	3972 [label="+5 Chemistry",color=orange];
		3972 -> 3973;
	3974 [label="Oui, ce monstre irritant à la peau bleue che ci è stato affidato dal Cardinale. Credo che lo conosci come Albrecht Entrati? È il motivo per cui siamo qui. Ma questa è una storia molto lunga, j'en ai bien peur.",shape=box,color=blue];
		3974 -> 3975;
		3974 -> 3976;
	3971 [label="Chat ends.",color=orange];
	3973 [label="Merci ! Il cosa e il come della nostra presenza qui è una storia molto lunga, j'en ai bien peur. Siamo stati mandati qui da le Cardinal. Credo che lo conosci come Albrecht Entrati? Ci ha affidato quel mostro irritante dalla pelle blu.",shape=box,color=blue];
		3973 -> 3975;
		3973 -> 3976;
	3975 [label="Farò tutto il possibile per aiutare.",shape=box,color=red];
		3975 -> 3980;
	3976 [label="'Affidato?'",shape=box,color=red];
		3976 -> 3977;
	3980 [label="+5 Chemistry",color=orange];
		3980 -> 3981;
	3977 [label="Dobbiamo fare tutto il possibile per guidare la sua anima, si c'est possibile. Et si ce n'est pas le cas ? Allora dobbiamo assicurarci almeno che non causi più alcun danno.",shape=box,color=blue];
		3977 -> 3978;
		3977 -> 3979;
	3981 [label="Sei proprio come Monsieur Loid e i Cavia hanno descritto ! Penso che diventeremo buoni amici.",shape=box,color=blue];
		3981 -> 3983;
	3978 [label="Sono disposto ad aiutarti.",shape=box,color=red];
		3978 -> 3980;
	3979 [label="È un Orokin. L'unico modo per riuscirci è piantargli un proiettile tra gli occhi.",shape=box,color=red];
		3979 -> 3982;
	3983 [label="Ah ! Devo andare, perdonami. Spero che ci risentiremo presto! À la revoyure!",shape=box,color=blue];
		3983 -> 3984;
	3982 [label="Sembra di sentir parlare Lyon. Non perderò la speranza. Non ancora.",shape=box,color=blue];
		3982 -> 3983;
	3984 [label="Chat ends.",color=orange];
}