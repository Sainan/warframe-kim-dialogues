	2562 [label="Ta gueule !",shape=box,color=blue];
		2562 -> 2571;
	2563 [label="Io... non è questo che intendevo. Questa non è una guerra santa, è qualcosa di completamente...",shape=box,color=blue];
		2563 -> 2572;
	2564 [label="Oui ! Précisément. E sono certa che tutti cambieranno idea col tempo. Sono semplicemente felice di avere un amico al mio fianco in questa faccenda.",shape=box,color=blue];
		2564 -> 2573;
	2565 [label="Credimi, no, non lo sei. Innumerevoli persone hanno perso la vita per questo. E potrei snocciolare una lista di nomi di persone a cui lui ha rovinato la vita. Ma nessuno ha dimenticato l'Indifferenza.",shape=box,color=red];
		2565 -> 2574;
	2566 [label="Sono sicura che se la incontrassi, lo scoprirei subito ! Tutti qui sono così veloci a raccontarmi di tutte le loro sofferenze per mano sua ! Non c'è da stupirsi che le Cardinal non ritorni. Non passerei un solo istante qui se fossi in lui -",shape=box,color=blue];
		2566 -> 2575;
	2567 [label="Non credo che lo allontanerebbe ! Credi che le Cardinal tornerebbe in questo nido di vipères ?! Non ! Non passerei un solo istante qui se fossi in lui - ",shape=box,color=blue];
		2567 -> 2575;
