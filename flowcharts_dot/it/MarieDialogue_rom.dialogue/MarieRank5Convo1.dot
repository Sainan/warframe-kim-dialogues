	2574 [label="Ne sei così sicuro ? Tutti qui sono così veloci a raccontarmi delle loro sofferenze per mano sua ! Ma mai a quale causa siano servite !",shape=box,color=blue];
		2574 -> 2582;
	2575 [label="Dove perfino Monsieur Loid, che afferma di amarlo, non può fare a meno di lamentarsi della sua crudeltà in ogni occasione !",shape=box,color=blue];
		2575 -> 2583;
	2577 [label="Update boolean MarieEntrati5f",color=orange];
		2577 -> 2584;
	2576 [label="Sono ben consapevole che le Cardinal è sia Lua che Sol - luce e oscurità - buono e malvagio. Non è né l'uno né l'altro, ed è capace di gentilezza e crudeltà.",shape=box,color=blue];
		2576 -> 2531;
