digraph {
	2427 [label="MarieRank5Convo1 begins.",color=orange];
		2427 -> 2428;
	2428 [label="Possiamo parlare ?",shape=box,color=blue];
		2428 -> 2429;
	2429 [label="Evaluate expressions",color=orange];
		2429 -> 2430 [label="MarieEntrati4a",color=purple];
		2429 -> 2431 [label="MarieEntrati4b",color=purple];
		2429 -> 2432 [label="MarieEntrati3a",color=purple];
		2429 -> 2433 [label="MarieEntrati3b",color=purple];
		2429 -> 2434 [label="MarieEntrati3",color=purple];
		2429 -> 2435 [label="false",color=purple];
	2430 [label="Ho riflettuto su quello che hai detto de le Cardinal. Che le sue azioni sono... un \"mix\" di bevolenza e malvagità.",shape=box,color=blue];
		2430 -> 2436;
	2431 [label="Ho riflettuto sulle tue parole su le Cardinal. Le sue azioni hanno portato dolore a Lyon.",shape=box,color=blue];
		2431 -> 2436;
	2432 [label="Ho riflettuto molto sulla nostra conversazione riguardante M'sieur Tagfer e sulle tue convincenti argomentazioni sul perché disprezzi così tanto le Cardinal.",shape=box,color=blue];
		2432 -> 2436;
	2433 [label="Ho riflettuto molto sulla mia discussione con M'sieur Tagfer e sulle sue ragioni per disprezzare così tanto le Cardinal.",shape=box,color=blue];
		2433 -> 2436;
	2434 [label="Ho riflettuto molto sulla mia discussione con Monsieur Tagfer. E sulla nostra discussione su quell'argomento.",shape=box,color=blue];
		2434 -> 2436;
	2435 [label="Ho la sensazione che molto sia stato lasciato in sospeso riguardo a le Cardinal. Gli altri sembrano camminare sulle uova intorno a me, hanno paura di parlare di lui.",shape=box,color=blue];
		2435 -> 2436;
	2436 [label="So che altri vorrebbero dipingerlo come un bastardo, un pazzo, un traditore. Ma per me non era tutto questo.",shape=box,color=blue];
		2436 -> 2437;
	2437 [label="Check boolean MarieBackstory1",color=orange];
		2437 -> 2439 [label=true,color=green];
		2437 -> 2438 [label=false,color=brown];
	2439 [label="Forse è perché sono abituata a essere abbandonata. ",shape=box,color=blue];
		2439 -> 2440;
	2438 [label="Sono stata abbandonata dalla mia famiglia, abbandonata per strada quando ero bambina, perché ero... anormale. Difettosa. Inadatta all'alta società.",shape=box,color=blue];
		2438 -> 2440;
	2440 [label="Forse è proprio perché non ho mai avuto un padre di cui parlare che sono così disposta a perdonargli la sua assenza.",shape=box,color=blue];
		2440 -> 2441;
	2441 [label="Evaluate expressions",color=orange];
		2441 -> 2442 [label="MarieEntrati4a",color=purple];
		2441 -> 2443 [label="MarieEntrati4b",color=purple];
		2441 -> 2444 [label="MarieEntrati3a",color=purple];
		2441 -> 2445 [label="MarieEntrati3b",color=purple];
		2441 -> 2446 [label="MarieEntrati3",color=purple];
		2441 -> 2447 [label="false",color=purple];
	2442 [label="Ma resta il fatto che lo perdono. Perché vedo più valore nelle sue buone azioni che danno in quelle cattive.",shape=box,color=blue];
		2442 -> 2448;
		2442 -> 2449;
		2442 -> 2450;
		2442 -> 2451;
		2442 -> 2452;
	2443 [label="Prego che Lyon sia forte e sopravviva alla crisi di fede che sta attraversando, ma non credo che sia interamente colpa de le Cardinal.",shape=box,color=blue];
		2443 -> 2448;
		2443 -> 2449;
		2443 -> 2450;
		2443 -> 2453;
		2443 -> 2454;
	2444 [label="Quindi, pur apprezzando le tue convincenti argomentazioni riguardo a M'sieur Tagfer e a coloro che sono stati feriti da lui... continuo a vedere più valore nelle sue buone azioni che danno in quelle cattive.",shape=box,color=blue];
		2444 -> 2448;
		2444 -> 2449;
		2444 -> 2450;
		2444 -> 2455;
		2444 -> 2456;
	2445 [label="Quindi, pur comprendendo l'ira di M'sieur Tagfer e potendo simpatizzare con le sue affermazioni, deve trovare lo spazio nel suo cuore per perdonare le Cardinal. Perché vedo più valore nelle buone azioni de le Cardinal che danno nelle sue cattive azioni.",shape=box,color=blue];
		2445 -> 2448;
		2445 -> 2449;
		2445 -> 2450;
		2445 -> 2457;
		2445 -> 2458;
	2446 [label="Quindi, pur apprezzando i rapporti di tutti con le Cardinal, in particolare con M'Sieur Tagfer, continuo ad attribuire più valore alle sue buone azioni che danno in quelle cattive.",shape=box,color=blue];
		2446 -> 2448;
		2446 -> 2449;
		2446 -> 2450;
		2446 -> 2459;
	2447 [label="Quindi, pur apprezzando i rapporti di tutti con le Cardinal, continuo ad attribuire più valore alle sue buone azioni che danno in quelle cattive.",shape=box,color=blue];
		2447 -> 2448;
		2447 -> 2449;
		2447 -> 2450;
	2448 [label="Non ti biasimo per aver apprezzato il bene che ha fatto nella tua vita, così come non biasimo le altre persone per aver provato risentimento per il male che sta causando nella loro.",shape=box,color=red];
		2448 -> 2460;
	2449 [label="Non lo so. Credo che le sue azioni abbiano causato più danni che benefici. Vorrei che tu potessi capirlo.",shape=box,color=red];
		2449 -> 2461;
	2450 [label="Sono dalla tua parte, Marie. Non posso biasimare Entrati per nulla di ciò che ha fatto. Sta combattendo l'Indifferenza.",shape=box,color=red];
		2450 -> 2462;
	2451 [label="Hai ragione a perdonare Entrati. Vorrei che più persone seguissero il tuo esempio.",shape=box,color=red];
		2451 -> 2462;
	2452 [label="Non biasimerò mai nessuno per il loro perdono. Ma puoi perdonare qualcuno pur sapendo che devi proteggere te stesso e gli altri da quella persona.",shape=box,color=red];
		2452 -> 2463;
	2453 [label="Pensi che la sofferenza di Lyon sia colpa sua?",shape=box,color=red];
		2453 -> 2464;
	2454 [label="Lyon sta soffrendo molto più di una semplice crisi di fede, Marie. E molto di questo ha a che fare con Entrati.",shape=box,color=red];
		2454 -> 2461;
	2455 [label="Niente di ciò che ho detto ha contribuito a ristabilire l'equilibrio?",shape=box,color=red];
		2455 -> 2465;
	2456 [label="Come puoi guardare tutto ciò che riguarda Entrati e vedere più cose positive che negative?",shape=box,color=red];
		2456 -> 2461;
	2457 [label="Penso che tu stia minimizzando la gravità di ciò che hanno sofferto i Cavia e Tagfer.",shape=box,color=red];
		2457 -> 2461;
	2458 [label="Perdonare è importante. Ma anche riconoscere che Entrati potrebbe essere più complicanto di quanto si sia disposti ad accettare lo è.",shape=box,color=red];
		2458 -> 2465;
	2459 [label="Credo ancora che tu non abbia capito cosa hanno passato Tagfer e i Cavia. È peggio di quello che hai passato tu.",shape=box,color=red];
		2459 -> 2461;
	2460 [label="Ma vedi come le due cose non hanno lo stesso valore ? Risentimento e venerazione ? Vorrei che gli altri rinunciassero ai loro rancori maligni.",shape=box,color=blue];
		2460 -> 2466;
		2460 -> 2467;
	2461 [label="Evaluate expressions",color=orange];
		2461 -> 2469 [label="MarieEntratiMonster1",color=purple];
		2461 -> 2469 [label="MarieEntratiMonster2",color=purple];
		2461 -> 2468 [label="MarieEntratiFan1",color=purple];
		2461 -> 2468 [label="MarieEntratiFan2",color=purple];
		2461 -> 2470 [label="false",color=purple];
	2462 [label="Evaluate expressions",color=orange];
		2462 -> 2473 [label="MarieEntratiMonster1",color=purple];
		2462 -> 2473 [label="MarieEntratiMonster2",color=purple];
		2462 -> 2471 [label="MarieEntratiFan1",color=purple];
		2462 -> 2471 [label="MarieEntratiFan2",color=purple];
		2462 -> 2472 [label="false",color=purple];
	2463 [label="Ed è questo che suggerisci di fare ? Escludere le Cardinal ? Direi che sembra essere quello che sta facendo lui stesso, non ?",shape=box,color=blue];
		2463 -> 2474;
		2463 -> 2467;
	2464 [label="Penso che Lyon soffra di molti disturbi, molti dei quali dovuti a dubbi su se stesso e sulla propria mente. Le Cardinal sembra aver... solo accelerato le cose.",shape=box,color=blue];
		2464 -> 2475;
		2464 -> 2467;
	2465 [label="Cosa vorresti che facessi ? Bruciare un fantoccio de le Cardinal e denunciarlo ? Condannarlo al Void, augurargli del male come M'sieur Tagfer ?",shape=box,color=blue];
		2465 -> 2474;
		2465 -> 2467;
	2466 [label="Questo è il problema, Marie. Cosa chiedi agli altri. Non cosa loro chiedono a te. O a Entrati.",shape=box,color=red];
		2466 -> 2476;
	2467 [label="Entrati lascia solo dolore al suo passaggio. Tutto ciò che sto cercando di fare è aiutare le persone che ferisce a rimettere tutto a posto. Nel suo caso, non mi interessa molto il ''bene'' o il ''male''.",shape=box,color=red];
		2467 -> 2477;
	2469 [label="Oui, e sei così coerente nel tuo odio per lui ! Niente di ciò che ho detto è riuscito ad addolcire i tuoi sentimenti per le Cardinal ?",shape=box,color=blue];
		2469 -> 2482;
	2468 [label="Non mi stavi parlando di come favorivi Entrati, come me, non più di qualche istante fa ? Cosa ti ha fatto cambiare idea ?",shape=box,color=blue];
		2468 -> 2478;
		2468 -> 2479;
		2468 -> 2480;
		2468 -> 2481;
	2470 [label="Oui, e sembra che pensi che Entrati sia un mostro ! Sei così veloce a respingere la sua gentilezza !",shape=box,color=blue];
		2470 -> 2482;
	2473 [label="Non mi stavi parlando della mostruosità di Entrati, pochi istanti fa ? Cosa ti ha fatto cambiare idea ?",shape=box,color=blue];
		2473 -> 2478;
		2473 -> 2479;
		2473 -> 2480;
		2473 -> 2481;
	2471 [label="Merci, e tu sei stato il mio fedele compagno in questa crociata! Temo che siamo soli in questo senso: persino Monsieur Loid nutre tale risentimento...",shape=box,color=blue];
		2471 -> 2483;
	2472 [label="Merci, e quanto sono felice di sentirlo ! Temo che siamo soli in questo senso: perfino Monsieur Loid nutre tale risentimento...",shape=box,color=blue];
		2472 -> 2483;
	2474 [label="Penso che il problema sia più quello che chiedi agli altri, non quello che loro chiedono a te. O a Entrati.",shape=box,color=red];
		2474 -> 2476;
	2475 [label="E non ti dà fastidio?",shape=box,color=red];
		2475 -> 2484;
	2476 [label="E cosa chiedo agli altri di così grottesco ? Di accettare il perdono nei loro cuori ?",shape=box,color=blue];
		2476 -> 2485;
		2476 -> 2486;
	2477 [label="Nobile, seppur noioso, viaggiare nel tempo e nello spazio, aiutando i suoi mécontents, non ? Sicuramente devi provargli risentimento per questo...",shape=box,color=blue];
		2477 -> 2487;
		2477 -> 2488;
	2482 [label="Questa conversazione è stata un errore...",shape=box,color=blue];
		2482 -> 2493;
		2482 -> 2494;
	2478 [label="Sinceramente, ho faticato molto a parlare di questo argomento con te. Doloroso. Personalmente, penso che lui... non sia né buono né cattivo. Ma un mix.",shape=box,color=red];
		2478 -> 2489;
	2479 [label="Ho cambiato idea. Sono dalla sua parte. E dalla tua. Mi hai convinto.",shape=box,color=red];
		2479 -> 2490;
	2480 [label="[Confessa i tuoi sentimenti.] Ho solo cercato di fare del mio meglio per... farmi benvolere da te, temo. Provo dei sentimenti per te. Più di quanti lasci trasparire.",shape=box,color=red];
		2480 -> 2491;
	2481 [label="Ho cambiato idea e ho deciso che è un mostro. Una volta per tutte.",shape=box,color=red];
		2481 -> 2492;
	2483 [label="Insieme, forse possiamo difenderci da coloro che vorrebbero macchiare le sue buone azioni, oui ? Ma mi chiedo, contro tutto ciò che ti circonda... perché schierarti dalla mia parte ?",shape=box,color=blue];
		2483 -> 2495;
	2484 [label="Check boolean LyonDating",color=orange];
		2484 -> 2496 [label=true,color=green];
		2484 -> 2497 [label=false,color=brown];
	2485 [label="Hai messo Entrati su un piedistallo, Marie. E chiedi agli altri di fare lo stesso, come degli idioti.",shape=box,color=red];
		2485 -> 2498;
	2486 [label="Penso che tu stia chiedendo loro di fare di più che limitarsi a perdonare Entrati. Penso che tu stia chiedendo loro di fingere che non abbia mai fatto nulla di sbagliato.",shape=box,color=red];
		2486 -> 2499;
	2487 [label="Certo. Ma devo anche \"ringraziarlo\" per alcune delle relazioni e amicizie più importanti che abbia mai stretto.",shape=box,color=red];
		2487 -> 2500;
	2488 [label="No, non proprio. Ha bisogno che lo faccia io, quindi lo farò. Lo giudicherò quando tutto sarà detto e fatto.",shape=box,color=red];
		2488 -> 2500;
	2493 [label="Aspetta, Marie. Per favore. Lascia che ti spieghi.",shape=box,color=red];
		2493 -> 2505;
		2493 -> 2506;
		2493 -> 2507;
		2493 -> 2508;
	2494 [label="Ho già chiarito cosa penso di Entrati. Mi dispiace. Su alcune cose non siamo d'accordo.",shape=box,color=red];
		2494 -> 2509;
	2489 [label="Update boolean MarieEntratiMonster1",color=orange];
		2489 -> 2501;
	2490 [label="Update boolean MarieEntratiMonster1",color=orange];
		2490 -> 2502;
	2491 [label="Update boolean DrifterMarieWhoops",color=orange];
		2491 -> 2503;
	2492 [label="Update boolean MarieEntratiFan1",color=orange];
		2492 -> 2504;
	2495 [label="Non che mi lamenti, intendiamoci !",shape=box,color=blue];
		2495 -> 2510;
		2495 -> 2511;
		2495 -> 2512;
	2496 [label="So che ha trovato un posto nel tuo cuore, e per questo sono davvero grata - forse finalmente potrò smettere di preoccuparmi per lui, e tutti questi litigi saranno presto inutili -",shape=box,color=blue];
		2496 -> 2497;
	2497 [label="Ma certo che mi dà fastidio. È il fratello della mia anima! Il mio Lyon è la cosa più cara al mondo per me, e vederlo soffrire mi provoca una fitta al petto, come se la sua agonia fosse la mia.",shape=box,color=blue];
		2497 -> 2513;
	2498 [label="Fai attenzione a ciò che dici, Drifter.",shape=box,color=blue];
		2498 -> 2514;
	2499 [label="Je ne suis pas naïve, non parlarmi come se lo fossi !",shape=box,color=blue];
		2499 -> 2515;
	2500 [label="Forse sta solo iniettando un veleno affinché il corpo possa guarire, e questa è solo una crudeltà necessaria.",shape=box,color=blue];
		2500 -> 2516;
		2500 -> 2517;
	2505 [label="[Confessa i tuoi sentimenti.] Ci tengo a te. Più di quanto abbia lasciato trasparire. E... mi dispiace di essere stato duro, ma non posso permettergli di ferirti. Non che abbia ferito tante altre persone.",shape=box,color=red];
		2505 -> 2523;
	2506 [label="Ho visto Entrati non fare altro che bruciare tutti quelli a cui teneva. Tutti quelli che presumibilmente amava. Non voglio vederlo fare lo stesso con te...",shape=box,color=red];
		2506 -> 2524;
	2507 [label="Non sono bravo ad esprimermi, e mi dispiace. Ma lui... temo che ti stia usando, e che stia usando la tua gentilezza per manipolarti. Tutto qui.",shape=box,color=red];
		2507 -> 2525;
	2508 [label="Potrai anche vedere Entrati come un salvatore, ma io lo vedo come un vecchio spaventato che cerca risposte. Forse la risposta sta nel mezzo.",shape=box,color=red];
		2508 -> 2498;
	2509 [label="Oui. Sembra di sì.",shape=box,color=blue];
		2509 -> 2526;
	2501 [label="Update boolean MarieEntratiMonster2",color=orange];
		2501 -> 2518;
	2502 [label="Update boolean MarieEntratiMonster2",color=orange];
		2502 -> 2519;
	2503 [label="E hai deciso di ingannarmi per entrare nelle mie grazie... je vois.",shape=box,color=blue];
		2503 -> 2520;
		2503 -> 2521;
	2504 [label="Update boolean MarieEntratiFan2",color=orange];
		2504 -> 2522;
	2510 [label="[Confessa i tuoi sentimenti.] Mi importa di te. Più di quanto abbia lasciato trasparire.",shape=box,color=red];
		2510 -> 2527;
	2511 [label="Credo che in questa guerra tutto sia necessario. Dopotutto, stiamo cercando di salvare l'universo dall'Indifferenza, non è vero?",shape=box,color=red];
		2511 -> 2528;
	2512 [label="Credo in Entrati. Onestamente. Credo che abbia un piano per risolvere questa situazione, e che tutto questo sia stato fatto per il bene ultimo.",shape=box,color=red];
		2512 -> 2529;
	2513 [label="Ma la sua caduta dalla fede non è opera de le Cardinal. Le crepe nelle fondamenta erano lì. È stata semplicemente aggiunta ulteriore pressione, oui ?",shape=box,color=blue];
		2513 -> 2500;
	2514 [label="Update boolean MarieWarning",color=orange];
		2514 -> 2499;
	2515 [label="Sono ben consapevole che le Cardinal è sia Lua che Sol - luce e oscurità - buono e malvagio. Non è né l'uno né l'altro, ed è capace di gentilezza e crudeltà.",shape=box,color=blue];
		2515 -> 2530;
		2515 -> 2531;
	2516 [label="Ecco perché gli altri si arrabbiano quando parli di lui. Tralasci tutto ciò che ha fatto che li ha feriti e fai finta che non sia successo niente.",shape=box,color=red];
		2516 -> 2498;
	2517 [label="Marie, fermati. Devi accettare che non sta facendo tutto questo solo perché è una brava persona. Non lo è. È una cosa più complicata di così.",shape=box,color=red];
		2517 -> 2499;
	2523 [label="Update boolean DrifterMarie",color=orange];
		2523 -> 2536;
	2524 [label="Fai attenzione a ciò che dici, Drifter.",shape=box,color=blue];
		2524 -> 2537;
	2525 [label="Non ho bisogno di essere protetta ! Je ne suis pas une enfant naïve !",shape=box,color=blue];
		2525 -> 2538;
	2526 [label="Update boolean MarieEntrati5g",color=orange];
		2526 -> 2539;
	2518 [label="Update boolean MarieEntratiFan1",color=orange];
		2518 -> 2532;
	2519 [label="Update boolean MarieEntratiFan2",color=orange];
		2519 -> 2533;
	2520 [label="Beh, quando lo dici così... ",shape=box,color=red];
		2520 -> 2534;
	2521 [label="Solo parzialmente.",shape=box,color=red];
		2521 -> 2534;
	2522 [label="Update boolean MarieEntratiMonster2",color=orange];
		2522 -> 2535;
	2527 [label="Update boolean DrifterMarieWhoops",color=orange];
		2527 -> 2540;
	2528 [label="Oui ! Esatto ! Finalmente qualcuno che ha un po' di buon senso. Mi spezza il cuore pensare che in questa guerra si debba fare del male a degli innocenti, ma tutto è in gioco. ",shape=box,color=blue];
		2528 -> 2541;
	2529 [label="Update boolean MarieWillDate",color=orange];
		2529 -> 2542;
	2530 [label="Marie, non è un dio. È solo un uomo. È arrogante e pericoloso quanto Roathe. Proviene dalla stessa società e soffre degli stessi problemi.",shape=box,color=red];
		2530 -> 2543;
	2531 [label="So che è stato gentile con te. So che forse era diverso con te da come lo è stato con molte altre persone. Forse ti ha persino trattata come una figlia... Ma guarda il quadro generale, per favore.",shape=box,color=red];
		2531 -> 2544;
	2536 [label="Io... io non so come gestire questa notizia, vista... vista la nostra attuale conversazione. Sono colta... piuttosto alla sprovvista da tutto questo. ",shape=box,color=blue];
		2536 -> 2549;
	2537 [label="Update boolean MarieWarning",color=orange];
		2537 -> 2525;
	2538 [label="Sono ben consapevole che le Cardinal è sia Lua che Sol - luce e oscurità - buono e malvagio. Non è né l'uno né l'altro, ed è capace di gentilezza e crudeltà.",shape=box,color=blue];
		2538 -> 2531;
		2538 -> 2530;
	2539 [label="Chat ends. Next chat will be MarieEntratiDay2.",color=orange];
	2532 [label="Update boolean MarieEntratiFan2",color=orange];
		2532 -> 2545;
	2533 [label="Oui ? Sono... fiduciosa, ma non convinta. Scegli le parole con più attenzione, Drifter...",shape=box,color=blue];
		2533 -> 2546;
	2534 [label="Update boolean MarieNoDate",color=orange];
		2534 -> 2547;
	2535 [label="Oui ? Mi consideri una bambina o una sciocca ? Scegli le parole con più attenzione, Drifter...",shape=box,color=blue];
		2535 -> 2548;
	2540 [label="E tu ti sei schierato dalla parte de le Cardinal per entrare nelle mie grazie... je vois.",shape=box,color=blue];
		2540 -> 2550;
		2540 -> 2551;
	2541 [label="E in guerra si sprecano vite innocenti. È triste, ma è un dato di fatto, non ?",shape=box,color=blue];
		2541 -> 2552;
		2541 -> 2553;
	2542 [label="Update boolean MarieFamilyFail",color=orange];
		2542 -> 2554;
	2543 [label="È un uomo che ha evocato - o forse addirittura creato - una divinità ! E ora è l'unico che si frappone tra lui e la distruzione del nostro universo !",shape=box,color=blue];
		2543 -> 2555;
	2544 [label="Credi che non sappia che non sono stata l'unica \"figlia\" che ha abbandonato ?! Sono semplicemente l'unica che perdona !",shape=box,color=blue];
		2544 -> 2556;
		2544 -> 2557;
	2549 [label="Davvero intendi farlo adesso ?! Così ?! Qui ?! Vraiment ?!",shape=box,color=blue];
		2549 -> 2560;
	2545 [label="Oui ? Ti perdonerò questa bugia, ma considerati avvisato. Scegli le parole con più attenzione, Drifter...",shape=box,color=blue];
		2545 -> 2558;
	2546 [label="Update boolean MarieWarning",color=orange];
		2546 -> 2483;
	2547 [label="Update boolean MarieEntrati5i",color=orange];
		2547 -> 2559;
	2548 [label="Update boolean MarieWarning",color=orange];
		2548 -> 2482;
	2550 [label="Beh, quando lo dici così... ",shape=box,color=red];
		2550 -> 2561;
	2551 [label="Solo in parte. Credo sinceramente in Entrati.",shape=box,color=red];
		2551 -> 2561;
	2552 [label="Esatto. Roathe sarebbe così orgoglioso di te.",shape=box,color=red];
		2552 -> 2562;
	2553 [label="Quante guerre sante sono state commesse in nome di Sol? Una in più una in meno, cosa cambia no?",shape=box,color=red];
		2553 -> 2563;
	2554 [label="Add -10 to Family",color=orange];
		2554 -> 2564;
	2555 [label="Sembra che io sia l'unica a ricordare cosa c'è in gioco qui !",shape=box,color=blue];
		2555 -> 2565;
		2555 -> 2557;
	2556 [label="Ora stai facendo delle supposizioni. Non lo sai. Non l'hai mai incontrata e non hai idea di cosa abbia passato. O di cosa abbia dovuto sopportare.",shape=box,color=red];
		2556 -> 2566;
	2557 [label="E pensi che questo lo farà amare di più, se lo fai? Pensi che lo farà tornare da te, se sei tu a rimanergli fedele?",shape=box,color=red];
		2557 -> 2567;
	2560 [label="Io... io non posso. Non posso continuare. Perdonami. Ne riparleremo domani, devo raccogliere i miei pensieri.",shape=box,color=blue];
		2560 -> 2569;
