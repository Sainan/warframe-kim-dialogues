	1091 [label="La situazione al piano di sopra è... fragile anche nei giorni migliori. Non voglio turbarli.",shape=box,color=red];
		1091 -> 1082;
	1092 [label="Lentamente. Con cautela. Temo che una metà considererà l'altra come ''l'altra famiglia.''",shape=box,color=red];
