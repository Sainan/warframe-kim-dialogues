	1062 [label="Update boolean MarieFamily2",color=orange];
		1062 -> 1066;
		1062 -> 1067;
		1062 -> 1068;
	1060 [label="Chissà cosa penserebbe dei Cavia... è un vero peccato che non possa incontrarli...",shape=box,color=blue];
		1060 -> 1063;
		1060 -> 1064;
	1061 [label="Se solo la purezza delle intenzioni fosse tutto ciò che conta, il mondo sarebbe un posto meraviglioso, non ? C'est la vie.",shape=box,color=blue];
		1061 -> 1065;
	1066 [label="A meno che non ci rinunci, come Nonna.",shape=box,color=red];
		1066 -> 1071;
	1067 [label="Sinceramente non è poi così male, ci si fa l'abitudine.",shape=box,color=red];
		1067 -> 1072;
	1068 [label="Gli animali non hanno un nome e sembrano essere perfettamente felici. Diamo loro un nome semplicemente per il nostro bene.",shape=box,color=red];
		1068 -> 1073;
	1063 [label="Sorrido all'idea. Ma non credo che sarebbe saggio.",shape=box,color=red];
		1063 -> 1069;
	1064 [label="Spero che un giorno ciò accada. Lo spero davvero.",shape=box,color=red];
		1064 -> 1070;
	1065 [label="Et ensuite ?",shape=box,color=blue];
		1065 -> 1049;
	1071 [label="+5 Chemistry",color=orange];
		1071 -> 1077;
	1072 [label="Aaah ! Quelle horreur ! Non volevo ! Oh, sono mortificata ! Mi dispiace tanto, perdonami, non volevo - oh, che sciocca !",shape=box,color=blue];
		1072 -> 1078;
