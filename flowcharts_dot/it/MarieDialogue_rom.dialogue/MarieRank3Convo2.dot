		1111 -> 1112;
	3913 [label="Mi rovinerai ! Ho appena squittito in modo udibile e Monsieur Loid mi ha chiesto se stavo bene. Ho dovuto mentire e dire di aver visto un topo, solo per sentirmi dire che non abbiamo topi in questo tempo !",shape=box,color=blue];
		3913 -> 3916;
	1112 [label="Aha ! Lo sapevo. Ora, basta con le sciocchezze e torniamo alla tua storia. Figlio aveva invitato gli Animaux Infestés ad avvicinarsi troppo, oui ?",shape=box,color=blue];
