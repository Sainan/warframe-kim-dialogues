	1016 [label="Check boolean MarieFamily1",color=orange];
		1016 -> 1017 [label=true,color=green];
		1016 -> 1018 [label=false,color=brown];
	2925 [label="Ho avuto queste conversazioni... ho incontrato queste persone... anche se è impossibile, non ?",shape=box,color=blue];
		2925 -> 2926;
	1017 [label="Mi parleresti ancora un po' della famiglia de le Cardinal ? Sono affascinata dal suo passato.",shape=box,color=blue];
		1017 -> 1020;
		1017 -> 1021;
		1017 -> 1019;
	1018 [label="Mi parleresti della famiglia de le Cardinal ? Sono affascinata dal suo passato.",shape=box,color=blue];
		1018 -> 1020;
		1018 -> 1021;
		1018 -> 1019;
	2926 [label="+20 Chemistry",color=orange];
		2926 -> 2927;
	1020 [label="Ti dirò tutto quello che so, ma temo di non sapere tutto quello che potresti pensare.",shape=box,color=red];
		1020 -> 1023;
	1021 [label="Oh. Certo, ma... Loid non sarebbe la persona migliore con cui parlare?",shape=box,color=red];
		1021 -> 1024;
	1019 [label="[Fine.]",shape=box,color=red];
		1019 -> 1022;
	2927 [label="Lo chiamiamo déjà vu. Dev'essere a causa del sérum e del viaggio nel tempo. C'est la vie !",shape=box,color=blue];
		2927 -> 2928;
	1023 [label="Qualunque cosa tu possa dirmi, la terrò cara. Promis !",shape=box,color=blue];
		1023 -> 1025;
	1024 [label="Parlare de le Cardinal... sembra che ferisca profondamente Monsieur Loid. Non mi piace farlo troppo spesso.",shape=box,color=blue];
		1024 -> 1025;
	1022 [label="Chat ends.",color=orange];
	2928 [label="Chat ends.",color=orange];
	1025 [label="Soprattutto perché lo faccio avec une certaine joie, cosa che nessun altro sembra fare.",shape=box,color=blue];
		1025 -> 1026;
		1025 -> 1027;
	1026 [label="Di chi vuoi parlare?",shape=box,color=red];
		1026 -> 1028;
	1027 [label="Beh, al piano di sopra ci sono Madre, Padre, Figlio, Figlia e Nonna.",shape=box,color=red];
		1027 -> 1028;
	1028 [label="Prima di tutto, chiarisci una cosa. Il diavolo ride di me ogni volta che lo chiedo, come se fosse uno scherzo interno. Grand-mère. Nonna.",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="Non è la moglie de le Caridnal, non ?",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="No, è la madre di Padre. La suocera di Madre.",shape=box,color=red];
		1030 -> 1031;
	1031 [label="Je... vois. E... perché non utilizzano i loro nomi ? Ne serait-ce pas plus simple ?",shape=box,color=blue];
		1031 -> 1032;
		1031 -> 1033;
	1032 [label="Vuoi la versione lunga?",shape=box,color=red];
		1032 -> 1034;
	1033 [label="Ti racconto l'essenziale.",shape=box,color=red];
		1033 -> 1035;
	1034 [label="Oui ! Non devo andare da nessuna parte.",shape=box,color=blue];
		1034 -> 1036;
	1035 [label="La famiglia al piano di sopra rimase intrappolata qui quando l'Impero Orokin crollò. Figlio, il nipote di Entrati, lasciò entrare l'Infestazione.",shape=box,color=red];
		1035 -> 1037;
	1036 [label="Beh, ci troviamo in una luna chiamata Deimos. E una bomba biologica è stata fatta esplodere qui, molto tempo fa, nel disperato tentativo di respingere i Sentient.",shape=box,color=red];
		1036 -> 1038;
	1037 [label="Par Sol ! Di proposito ?",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="Quelli con cui gli Orokin erano in guerra tanto tempo fa ? Quelli che vediamo nel Refrattario Oscuro con il diavolo, oui ?",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1039 -> 1041 [label=true,color=green];
		1039 -> 1042 [label=true,color=green];
		1039 -> 1042 [label=false,color=brown];
		1039 -> 1043 [label=false,color=brown];
	1040 [label="Sì. Hanno cercato di sfruttare l'Infestazione per combattere i Sentient. Ma Deimos è stata invasa. Si sono rinchiusi nel Necralisk, che si trova sopra di noi - per trovare rifugio.",shape=box,color=red];
		1040 -> 1044;
	1041 [label=" No, credo che sia stato un incidente. Credo che le sue intenzioni siano buone.",shape=box,color=red];
		1041 -> 1045;
	1042 [label="Non conosco ancora la verità, ma mi riservo di esprimere un giudizio finché non ne saprò di più.",shape=box,color=red];
		1042 -> 1045;
	1043 [label="Non so ancora la verità, ma è arrogante, questo posso dirtelo.",shape=box,color=red];
		1043 -> 1046;
	1044 [label="Figlio, il nipote di Entrati, era invece intenzionato a cercare di preservare e studiare gli animali infested.",shape=box,color=red];
		1044 -> 1047;
	1045 [label="+10 Chemistry",color=orange];
		1045 -> 1048;
	1046 [label="Vergogna. Spero che non sia vero, per il suo bene e per il nostro. Per favore, continua.",shape=box,color=blue];
		1046 -> 1049;
	1047 [label="Oh, Sol... aveva buone intenzioni ?",shape=box,color=blue];
		1047 -> 1076;
	1048 [label="Molto gentile da parte tua. Continua, s'il vous plaît.",shape=box,color=blue];
		1048 -> 1049;
	1049 [label="Beh, intrappolati nel Necralisk, consumati dal dolore e senza un Impero Orokin a salvarli, e ora con l'Infestazione che si infiltrava...",shape=box,color=red];
		1049 -> 1053;
	1076 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1076 -> 1051 [label=true,color=green];
		1076 -> 1052 [label=true,color=green];
		1076 -> 1055 [label=true,color=green];
		1076 -> 1051 [label=false,color=brown];
		1076 -> 1052 [label=false,color=brown];
		1076 -> 1054 [label=false,color=brown];
	1053 [label="Si rivoltarono l'uno contro l'altro. Si fecero a pezzi a vicenda dall'interno. E l'Infestazione fece il resto. Prendendo i loro stessi nomi. ",shape=box,color=red];
		1053 -> 1058;
	1051 [label="Sì, credo di sì. Credo che lui si preoccupi sinceramente per quelle creature.",shape=box,color=red];
		1051 -> 1056;
	1052 [label="Purtroppo, non ha avuto importanza, il danno era ormai fatto.",shape=box,color=red];
		1052 -> 1057;
	1055 [label="No, è stata l'arroganza a ispirarlo. Anche se sostiene che sia stato un incidente.",shape=box,color=red];
		1055 -> 1059;
	1054 [label="Non so ancora la verità, ma è arrogante, questo posso dirtelo.",shape=box,color=red];
		1054 -> 1059;
	1058 [label="Essere privi di nome è la forma più estrema di crudeltà...",shape=box,color=blue];
		1058 -> 1062;
	1056 [label="+10 Chemistry",color=orange];
		1056 -> 1060;
	1057 [label="+5 Chemistry",color=orange];
		1057 -> 1061;
	1059 [label="Vergogna. Spero che non sia vero, per il suo bene e per il nostro. Per favore, continua.",shape=box,color=blue];
