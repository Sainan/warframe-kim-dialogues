		1087 -> 1096;
	1081 [label="Add 1 to Family",color=orange];
		1081 -> 1088;
	1082 [label="Potrebbe sorprenderti quanto sia resiliente l'anima. E coloro che mi circondano ora sono così vecchi, così temprati dal tempo.",shape=box,color=blue];
		1082 -> 1089;
	1083 [label="Si può fare. Forse è più facile di quanto pensi. Dobbiamo solo pensare a come. ",shape=box,color=blue];
		1083 -> 1090;
		1083 -> 1091;
	1084 [label="Oui ? E come va il tuo lavoro o quello della tua minuscola copia con la famiglia di sopra ?",shape=box,color=blue];
		1084 -> 1092;
		1084 -> 1093;
	1094 [label="Chat ends.",color=orange];
	1095 [label="Chat ends.",color=orange];
	1096 [label="Oh, loué soit Sol ! Ma con questo mi domando... Sai come hai ricevuto il tuo soprannome ? \"Le Drifter ?\"",shape=box,color=blue];
		1096 -> 1099;
