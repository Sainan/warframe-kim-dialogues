	1100 [label="Non ricordo, sinceramente.",shape=box,color=red];
		1100 -> 1104;
	1097 [label="Oh... Par Sol, credo che tu lo abbia risolto !",shape=box,color=blue];
		1097 -> 1101;
	1098 [label="Li hai sorpresi molte volte. Lascia che siano loro a soprenderti questa volta.",shape=box,color=blue];
		1098 -> 1102;
	1103 [label="Quanto sarebbe liberatorio ! Scegliere il proprio nome. Nella Cathédrale, non potevo nemmeno scegliere i miei vestiti. Aha !",shape=box,color=blue];
		1103 -> 1085;
	1104 [label="Quanti mystères porti con te ! ",shape=box,color=blue];
		1104 -> 1085;
	1101 [label="Update boolean MarieFamilyOther",color=orange];
		1101 -> 1105;
	1102 [label="Ma per favore, per favore, s'il vous plaît, continua con la tua storia. La tua piccola lupa Marie deve conoscere la sua preda prima di poter cacciare come si deve, non ?",shape=box,color=blue];
		1102 -> 1106;
		1102 -> 1107;
		1102 -> 3914;
	1105 [label="Sono fuori di me dall'eccitazione - je suis assise ici, remuant sur ma chaise !",shape=box,color=blue];
		1105 -> 1102;
	1106 [label="A che punto ero?",shape=box,color=red];
		1106 -> 1108;
	1107 [label="È stato cattivello da parte tua, no?",shape=box,color=red];
		1107 -> 1109;
	3914 [label="Forse vorrei che mi dessi la caccia...",shape=box,color=red];
		3914 -> 3915;
	1108 [label="Figlio aveva invitato gli Animaux Infestés ad avvicinarsi troppo.",shape=box,color=blue];
		1108 -> 1049;
	1109 [label="Peut-être ! Ma che male c'è in un po' di cattiveria in nome del bene, hm ?",shape=box,color=blue];
