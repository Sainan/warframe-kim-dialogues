		2923 -> 2924 [label=true,color=green];
		2923 -> 1016 [label=false,color=brown];
	2924 [label="Spero che tu non mi considererai infirme... ma a volte ho la strana sensazione di aver già fatto tutto questo prima ?",shape=box,color=blue];
