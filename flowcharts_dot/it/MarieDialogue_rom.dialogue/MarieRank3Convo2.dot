	1070 [label="Add 1 to Family",color=orange];
		1070 -> 1050;
	1077 [label="Ora sembra proprio qualcuno che mi piacerebbe tanto incontrare... ",shape=box,color=blue];
		1077 -> 1085;
	1078 [label="Come rimedierai?",shape=box,color=red];
		1078 -> 1086;
	1079 [label="Va tutto bene, sto solo scherzando. Non sono arrabbiato.",shape=box,color=red];
		1079 -> 1087;
	1080 [label="È proprio vero ! Non ci avevo mai pensato. E poi potresti scegliere il tuo. Che liberazione, in un certo senso.",shape=box,color=blue];
		1080 -> 1085;
	1074 [label="Temo che una metà considererà l'altra come ''l'altra famiglia.''",shape=box,color=red];
		1074 -> 1081;
	1075 [label="La situazione al piano di sopra è... fragile anche nei giorni migliori. Non voglio turbarli.",shape=box,color=red];
		1075 -> 1082;
	1050 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1050 -> 1083 [label=true,color=green];
		1050 -> 1084 [label=false,color=brown];
	1085 [label="È stata una conversazione meravigliosa, ma temo che sia arrivato il mio turno di servire il pranzo. Monsieur Loid mi sta insegnando come servire il tè a modo suo !",shape=box,color=blue];
		1085 -> 1094;
	1086 [label="Maintenant, vous parlez aussi mal que le diable. No, non cadrò nei tuoi trucchi.",shape=box,color=blue];
