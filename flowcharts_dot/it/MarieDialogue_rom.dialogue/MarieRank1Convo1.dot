digraph {
	0 [label="MarieRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Bonjour, bonjour, Drifter ! Come stai in questa bella giornata ? O pomeriggio. Non so proprio che ore siano.",shape=box,color=blue];
		1 -> 2;
	2 [label="Sono certa che uno di questi bibelots che Monsieur Loid ha sia un orologio, ma non riesco proprio a capire quale.",shape=box,color=blue];
		2 -> 3;
	3 [label="Ho paura di toccare qualsiasi dispositivo in questo strano santuario. Credo fermamente che potrei o precipitare in un tempo remoto o scaldare una tazza di tè.",shape=box,color=blue];
		3 -> 5;
		3 -> 6;
		3 -> 4;
	5 [label="Probabilmente è meglio non premere alcun pulsante di cui non sei sicura, no. ",shape=box,color=red];
		5 -> 8;
	6 [label="Sono sicuro che non succederà niente.",shape=box,color=red];
		6 -> 9;
	4 [label="[Fine.]",shape=box,color=red];
		4 -> 7;
	8 [label="Veramente un ottimo consiglio. Ho sentito dal Monsieur Loid che anche tu hai avuto la tua aventure temporelle. Mi chiedo -",shape=box,color=blue];
		8 -> 10;
	9 [label="C'est très gentil de votre part, ma... non sei tu quello che è stato gettato in un altro... ah. Giusto. Sì !",shape=box,color=blue];
		9 -> 11;
	7 [label="Chat ends.",color=orange];
	10 [label="Era pericolosa come questa?",shape=box,color=blue];
		10 -> 12;
		10 -> 13;
	11 [label="Tu capisci, non è vero? Perdonami. La tua avventura personale è stata pericolosa quanto questa ?",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="Il periodo? O il mio soggiorno in particolare?",shape=box,color=red];
		12 -> 14;
	13 [label="Era diversa, ma ti prometto che qui sei al sicuro.",shape=box,color=red];
		13 -> 15;
	14 [label="+10 Chemistry",color=orange];
		14 -> 16;
	15 [label="Apprezzo molto il tuo caloroso voto di fiducia, ma non lo condivido appieno. Soprattutto quando ho così tanta difficoltà a capire l'ora.",shape=box,color=blue];
		15 -> 17;
	16 [label="È giusto fare questa distinzione. Dubito che la tua esperienza con il passato sia stata \"normale\" secondo gli standard generali. Anche perché, sembra proprio di no.",shape=box,color=blue];
		16 -> 18;
	17 [label="Ci si aspetterebbe che fosse scritta nell'angolo di questo... \"schermo\", ma non c'è ! Mauvaise qualité, se chiedi a me.",shape=box,color=blue];
		17 -> 19;
	18 [label="Intendevo il \"periodo\" in sé. Permettimi di riformulare -",shape=box,color=blue];
		18 -> 20;
	19 [label="Comunque, ci siamo allontanati parecchio dalla mia domanda!",shape=box,color=blue];
		19 -> 20;
	20 [label="Quest'epoca \"passata\" in cui hai viaggiato, che è in effetti molto più vicina al \"passato lontano\" da cui provengo, era più o meno latentemente pericolosa di questo tempo in cui ci troviamo attualmente?",shape=box,color=blue];
		20 -> 21;
	21 [label="(Caspita ! Mi piace un sacco, devo dire che è molto più interessante che spolverare gli strumenti per la comunione.)",shape=box,color=blue];
		21 -> 22;
		21 -> 23;
		21 -> 24;
		21 -> 25;
	22 [label="Penso che siano più o meno simili. Gli armamenti sono diversi e forse non sanno ancora cosa li aspetta, ma la guerra è guerra e la morte è morte.",shape=box,color=red];
		22 -> 26;
	23 [label="Penso che in questo periodo il pericolo sia minore. Abbiamo più capacità di affrontare le sfide che ci attendono. Sono solo all'inizio.",shape=box,color=red];
		23 -> 27;
	24 [label="Penso che questo periodo sia più pericoloso. Anche se abbiamo ancora gli Infested in comune, loro avevano a che fare con armi molto più rudimentali.",shape=box,color=red];
		24 -> 27;
	25 [label="Sinceramente, sono solo felice che ti stia divertendo. Può essere difficile adattarsi a tutto.",shape=box,color=red];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="Potresti avere ragione. Ci penserò. Grazie.",shape=box,color=blue];
		27 -> 30;
	28 [label="+5 Chemistry",color=orange];
		28 -> 31;
	29 [label="Come tutte le cose, suppongo che sia relativo, non ? Il predatore che ci uccide oggi è letale quanto quello che ci dava la caccia allora. Si è affilato semplicemente i denti.",shape=box,color=blue];
		29 -> 32;
		29 -> 33;
	30 [label="Chat ends.",color=orange];
	31 [label="Sono stata preparata a questo da le Cardinal Dimanche - il vostro Albrecht Entrati. A differenza del mio caro Lyon, ho creduto alle sue parole come fossero fatti. E a differenza di Lyon, vedo questa come la nostra grande avventura, non come un peso.",shape=box,color=blue];
		31 -> 34;
	32 [label="A meno che tu non sia Orokin, e che tu abbia trovato un modo per evitare la morte... in teoria, se non in pratica.",shape=box,color=red];
		32 -> 35;
	33 [label="Anche io sono felice che ti stia adattando bene al futuro.",shape=box,color=red];
		33 -> 36;
	34 [label="Il servizio ai Luminari non deve essere necessariamente un atto di sofferenza. In questo, siamo sempre stati diversi.",shape=box,color=blue];
		34 -> 37;
	35 [label="E credo che il diavolo sia un esempio perfetto del perché la morte sia il dono più grande che Lua ci abbia mai fatto.",shape=box,color=blue];
		35 -> 38;
	36 [label="+5 Chemistry",color=orange];
		36 -> 39;
	37 [label="Update boolean MarieLyonSuffering1",color=orange];
		37 -> 40;
	38 [label="Update boolean MarieRoathe1",color=orange];
		38 -> 41;
	39 [label="Sono stata preparata a questo da le Cardinal Dimanche - il vostro Albrecht Entrati. A differenza del mio caro Lyon, ho creduto alle sue parole come fossero fatti. E a differenza di Lyon, vedo questa come la nostra grande avventura, non come un peso.",shape=box,color=blue];
		39 -> 42;
	40 [label="E non evitare la mia domanda, sciocco ! Quale pensi sia più pericoloso ?",shape=box,color=blue];
		40 -> 43;
		40 -> 44;
		40 -> 45;
	41 [label="Oh ! Ecco, questo sì che è il suono di un orologio che riconosco, anche se non riesco ancora a identificare dove si trovi quella dannata cosa. Comunque, temo di dover andare. È stato piacevole. Al prossimo \"incontro\" ! Aux Dieux !",shape=box,color=blue];
		41 -> 46;
	42 [label="Il servizio ai Luminari non deve essere necessariamente un atto di sofferenza. In questo, siamo sempre stati diversi.",shape=box,color=blue];
		42 -> 47;
	43 [label="Credo che questo periodo sia più letale. Quanti nemici impossibili abbiamo che cercano di ucciderci?",shape=box,color=red];
		43 -> 48;
	44 [label="Credo che la nostra epoca sia meno pericolosa. Stanno solo scoprendo nuovi modi per uccidersi a vicenda. I nostri metodi sono solo un po' più eccitanti, forse.",shape=box,color=red];
		44 -> 48;
	45 [label="Credo che alla fine sia può o meno uguale. La morte è morte, non è vero?",shape=box,color=red];
		45 -> 49;
	46 [label="Chat ends.",color=orange];
	47 [label="Update boolean MarieLyonSuffering1",color=orange];
		47 -> 41;
	48 [label="Potresti avere ragione. Ci penserò. Grazie.",shape=box,color=blue];
		48 -> 50;
	49 [label="+5 Chemistry",color=orange];
		49 -> 51;
	50 [label="Chat ends.",color=orange];
	51 [label="Come tutte le cose, suppongo che sia relativo, no ? Il predatore che ci uccide oggi è letale quanto quello che ci dava la caccia allora. Si è affilato semplicemente i denti.",shape=box,color=blue];
		51 -> 52;
		51 -> 53;
	52 [label="Come qualcuno che cerca di difendersi dal lupo, spesso questo mi esaurisce.",shape=box,color=red];
		52 -> 54;
	53 [label="A meno che tu non sia Orokin, e che tu abbia trovato un modo per evitare la morte... in teoria, se non in pratica.",shape=box,color=red];
		53 -> 55;
	54 [label="Penso che tu, mio caro Drifter, sia più propenso a scappare e a unirti al branco di lupi piuttosto che a lottare contro di loro. E lo intendo come un complimento.",shape=box,color=blue];
		54 -> 41;
	55 [label="E credo che il diavolo sia un esempio perfetto del perché la morte sia il dono più grande che Lua ci abbia mai fatto.",shape=box,color=blue];
		55 -> 56;
	56 [label="Update boolean MarieRoathe1",color=orange];
		56 -> 41;
}