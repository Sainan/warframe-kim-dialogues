digraph {
	"MarieRank1Convo1 begins." [color=orange];
		"MarieRank1Convo1 begins." -> j1700677261;
	j1700677261 [label="Bonjour, bonjour, Drifter ! Come stai in questa bella giornata ? O pomeriggio. Non so proprio che ore siano.",shape=box,color=blue];
		j1700677261 -> j1849842026;
	j1849842026 [label="Sono certa che uno di questi bibelots che Monsieur Loid ha sia un orologio, ma non riesco proprio a capire quale.",shape=box,color=blue];
		j1849842026 -> j2524737289;
	j2524737289 [label="Ho paura di toccare qualsiasi dispositivo in questo strano santuario. Credo fermamente che potrei o precipitare in un tempo remoto o scaldare una tazza di tè.",shape=box,color=blue];
		j2524737289 -> j2468730505;
		j2524737289 -> j2911686052;
		j2524737289 -> j4115718638;
	j2468730505 [label="Probabilmente è meglio non premere alcun pulsante di cui non sei sicura, no. ",shape=box,color=red];
		j2468730505 -> j3639064438;
	j2911686052 [label="Sono sicuro che non succederà niente.",shape=box,color=red];
		j2911686052 -> j2161548535;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j3639064438 [label="Veramente un ottimo consiglio. Ho sentito dal Monsieur Loid che anche tu hai avuto la tua aventure temporelle. Mi chiedo -",shape=box,color=blue];
		j3639064438 -> j436334502;
	j2161548535 [label="C'est très gentil de votre part, ma... non sei tu quello che è stato gettato in un altro... ah. Giusto. Sì !",shape=box,color=blue];
		j2161548535 -> j3874041281;
	"Chat ends." [color=orange];
	j436334502 [label="Era pericolosa come questa?",shape=box,color=blue];
		j436334502 -> j1098642620;
		j436334502 -> j2585383866;
	j3874041281 [label="Tu capisci, non è vero? Perdonami. La tua avventura personale è stata pericolosa quanto questa ?",shape=box,color=blue];
		j3874041281 -> j1098642620;
		j3874041281 -> j2585383866;
	j1098642620 [label="Il periodo? O il mio soggiorno in particolare?",shape=box,color=red];
		j1098642620 -> j109765192;
	j2585383866 [label="Era diversa, ma ti prometto che qui sei al sicuro.",shape=box,color=red];
		j2585383866 -> j3897476149;
	j109765192 [label="+10 Chemistry",color=orange];
		j109765192 -> j455188870;
	j3897476149 [label="Apprezzo molto il tuo caloroso voto di fiducia, ma non lo condivido appieno. Soprattutto quando ho così tanta difficoltà a capire l'ora.",shape=box,color=blue];
		j3897476149 -> j3193176362;
	j455188870 [label="È giusto fare questa distinzione. Dubito che la tua esperienza con il passato sia stata \"normale\" secondo gli standard generali. Anche perché, sembra proprio di no.",shape=box,color=blue];
		j455188870 -> j2268455641;
	j3193176362 [label="Ci si aspetterebbe che fosse scritta nell'angolo di questo... \"schermo\", ma non c'è ! Mauvaise qualité, se chiedi a me.",shape=box,color=blue];
		j3193176362 -> j324415608;
	j2268455641 [label="Intendevo il \"periodo\" in sé. Permettimi di riformulare -",shape=box,color=blue];
		j2268455641 -> j4068315127;
	j324415608 [label="Comunque, ci siamo allontanati parecchio dalla mia domanda!",shape=box,color=blue];
		j324415608 -> j4068315127;
	j4068315127 [label="Quest'epoca \"passata\" in cui hai viaggiato, che è in effetti molto più vicina al \"passato lontano\" da cui provengo, era più o meno latentemente pericolosa di questo tempo in cui ci troviamo attualmente?",shape=box,color=blue];
		j4068315127 -> j1243019415;
	j1243019415 [label="(Caspita ! Mi piace un sacco, devo dire che è molto più interessante che spolverare gli strumenti per la comunione.)",shape=box,color=blue];
		j1243019415 -> j3640188400;
		j1243019415 -> j2331032614;
		j1243019415 -> j2562916742;
		j1243019415 -> j4063580437;
	j3640188400 [label="Penso che siano più o meno simili. Gli armamenti sono diversi e forse non sanno ancora cosa li aspetta, ma la guerra è guerra e la morte è morte.",shape=box,color=red];
		j3640188400 -> j103459445;
	j2331032614 [label="Penso che in questo periodo il pericolo sia minore. Abbiamo più capacità di affrontare le sfide che ci attendono. Sono solo all'inizio.",shape=box,color=red];
		j2331032614 -> j2754491801;
	j2562916742 [label="Penso che questo periodo sia più pericoloso. Anche se abbiamo ancora gli Infested in comune, loro avevano a che fare con armi molto più rudimentali.",shape=box,color=red];
		j2562916742 -> j2754491801;
	j4063580437 [label="Sinceramente, sono solo felice che ti stia divertendo. Può essere difficile adattarsi a tutto.",shape=box,color=red];
		j4063580437 -> j1425818778;
	j103459445 [label="+5 Chemistry",color=orange];
		j103459445 -> j3801781310;
	j2754491801 [label="Potresti avere ragione. Ci penserò. Grazie.",shape=box,color=blue];
		j2754491801 -> "Chat ends.";
	j1425818778 [label="+5 Chemistry",color=orange];
		j1425818778 -> j1269558301;
	j3801781310 [label="Come tutte le cose, suppongo che sia relativo, non ? Il predatore che ci uccide oggi è letale quanto quello che ci dava la caccia allora. Si è affilato semplicemente i denti.",shape=box,color=blue];
		j3801781310 -> j18229857;
		j3801781310 -> j1935077675;
	j1269558301 [label="Sono stata preparata a questo da le Cardinal Dimanche - il vostro Albrecht Entrati. A differenza del mio caro Lyon, ho creduto alle sue parole come fossero fatti. E a differenza di Lyon, vedo questa come la nostra grande avventura, non come un peso.",shape=box,color=blue];
		j1269558301 -> j818349928;
	j18229857 [label="A meno che tu non sia Orokin, e che tu abbia trovato un modo per evitare la morte... in teoria, se non in pratica.",shape=box,color=red];
		j18229857 -> j367108693;
	j1935077675 [label="Anche io sono felice che ti stia adattando bene al futuro.",shape=box,color=red];
		j1935077675 -> j3078481983;
	j818349928 [label="Il servizio ai Luminari non deve essere necessariamente un atto di sofferenza. In questo, siamo sempre stati diversi.",shape=box,color=blue];
		j818349928 -> j872940047;
	j367108693 [label="E credo che il diavolo sia un esempio perfetto del perché la morte sia il dono più grande che Lua ci abbia mai fatto.",shape=box,color=blue];
		j367108693 -> j448608891;
	j3078481983 [label="+5 Chemistry",color=orange];
		j3078481983 -> j1245399304;
	j872940047 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j872940047 -> j1649081792;
	j448608891 [label="Boolean MarieRoathe1 is now true.",color=orange];
		j448608891 -> j746778320;
	j1245399304 [label="Sono stata preparata a questo da le Cardinal Dimanche - il vostro Albrecht Entrati. A differenza del mio caro Lyon, ho creduto alle sue parole come fossero fatti. E a differenza di Lyon, vedo questa come la nostra grande avventura, non come un peso.",shape=box,color=blue];
		j1245399304 -> j505832699;
	j1649081792 [label="E non evitare la mia domanda, sciocco ! Quale pensi sia più pericoloso ?",shape=box,color=blue];
		j1649081792 -> j1178382815;
		j1649081792 -> j2848760875;
		j1649081792 -> j2610433785;
	j746778320 [label="Oh ! Ecco, questo sì che è il suono di un orologio che riconosco, anche se non riesco ancora a identificare dove si trovi quella dannata cosa. Comunque, temo di dover andare. È stato piacevole. Al prossimo \"incontro\" ! Aux Dieux !",shape=box,color=blue];
		j746778320 -> "Chat ends.";
	j505832699 [label="Il servizio ai Luminari non deve essere necessariamente un atto di sofferenza. In questo, siamo sempre stati diversi.",shape=box,color=blue];
		j505832699 -> j3571184693;
	j1178382815 [label="Credo che questo periodo sia più letale. Quanti nemici impossibili abbiamo che cercano di ucciderci?",shape=box,color=red];
		j1178382815 -> j2754491801;
	j2848760875 [label="Credo che la nostra epoca sia meno pericolosa. Stanno solo scoprendo nuovi modi per uccidersi a vicenda. I nostri metodi sono solo un po' più eccitanti, forse.",shape=box,color=red];
		j2848760875 -> j2754491801;
	j2610433785 [label="Credo che alla fine sia può o meno uguale. La morte è morte, non è vero?",shape=box,color=red];
		j2610433785 -> j3613504382;
	j3571184693 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j3571184693 -> j746778320;
	j3613504382 [label="+5 Chemistry",color=orange];
		j3613504382 -> j299450749;
	j299450749 [label="Come tutte le cose, suppongo che sia relativo, no ? Il predatore che ci uccide oggi è letale quanto quello che ci dava la caccia allora. Si è affilato semplicemente i denti.",shape=box,color=blue];
		j299450749 -> j1458500873;
		j299450749 -> j18229857;
	j1458500873 [label="Come qualcuno che cerca di difendersi dal lupo, spesso questo mi esaurisce.",shape=box,color=red];
		j1458500873 -> j803418185;
	j803418185 [label="Penso che tu, mio caro Drifter, sia più propenso a scappare e a unirti al branco di lupi piuttosto che a lottare contro di loro. E lo intendo come un complimento.",shape=box,color=blue];
		j803418185 -> j746778320;
}