		j1134465740 -> j1985950621 [label=true,color=green];
		j1134465740 -> "Chat ends." [label=false,color=brown];
	j3661012667 [label="Mon cœur, possiamo parlare ? Solo per un momento. ",shape=box,color=blue];
		j3661012667 -> j1399128309;
		j3661012667 -> j405560839;
	j1399128309 [label="Ciao, certo. Che succede?",shape=box,color=red];
		j1399128309 -> j2028779808;
	j405560839 [label="[Fine.]",shape=box,color=red];
		j405560839 -> j952339130;
	j2028779808 [label="Volevo semplicemente dire che... so che anche il tuo cuore appartiene a un altro. E anche se non lo conosco, il mio cuore ne gioisce.",shape=box,color=blue];
		j2028779808 -> j75826200;
	j952339130 [label="Boolean MarieConsentComplete is now true.",color=orange];
		j952339130 -> "Chat ends.";
	j75826200 [label="Mi fido di te e se hanno un posto nella tua anima, allora sono felice di condividerlo con loro.",shape=box,color=blue];
		j75826200 -> j895607030;
	j895607030 [label="Spero semplicemente che un giorno avrò la possibilità di incontrarli, oui ? L'amante del mio amante deve quindi essere anche il mio...",shape=box,color=blue];
		j895607030 -> j39022618;
	j39022618 [label="Sempre che pensi che ne sarebbero così inclini.",shape=box,color=blue];
		j39022618 -> j39380172;
		j39022618 -> j1269104843;
		j39022618 -> j2620440728;
	j39380172 [label="Onestamente, potresti non essere il loro tipo.",shape=box,color=red];
		j39380172 -> j1648910188;
	j1269104843 [label="Ti adorerebbero, Marie. Come lo faccio io.",shape=box,color=red];
		j1269104843 -> j2140192364;
	j2620440728 [label="Non credo che potrebbero resistere.",shape=box,color=red];
		j2620440728 -> j2140192364;
	j1648910188 [label="Pff ! Sei terribile, mio lupo. Lasciami i miei sogni. Fino al allora, ti avrò quando ti avrò, suppongo !",shape=box,color=blue];
		j1648910188 -> j3351285883;
	j2140192364 [label="Fino ad allora, ti avrò quando ti avrò. E sarò felice di condividerti con coloro che si sono presi cura di te come ho fatto io.",shape=box,color=blue];
		j2140192364 -> j3351285883;
	j3351285883 [label="Dopotutto, qualcuno deve stare di guardia contro i Murmur mentre tu te ne vai a divertirti !",shape=box,color=blue];
		j3351285883 -> j1354864431;
	j1354864431 [label="E a questo proposito, il dovere chiama. À la revoyure !",shape=box,color=blue];
		j1354864431 -> j952339130;
}