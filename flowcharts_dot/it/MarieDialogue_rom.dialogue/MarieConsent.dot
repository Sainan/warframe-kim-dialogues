	3580 [label="Ciao, certo. Che succede?",shape=box,color=red];
		3580 -> 3582;
	3579 [label="[Fine.]",shape=box,color=red];
		3579 -> 3581;
	3582 [label="Volevo semplicemente dire che... so che anche il tuo cuore appartiene a un altro. E anche se non lo conosco, il mio cuore ne gioisce.",shape=box,color=blue];
		3582 -> 3584;
	3581 [label="Update boolean MarieConsentComplete",color=orange];
		3581 -> 3583;
	3584 [label="Mi fido di te e se hanno un posto nella tua anima, allora sono felice di condividerlo con loro.",shape=box,color=blue];
		3584 -> 3585;
	3583 [label="Chat ends.",color=orange];
	3585 [label="Spero semplicemente che un giorno avrò la possibilità di incontrarli, oui ? L'amante del mio amante deve quindi essere anche il mio...",shape=box,color=blue];
		3585 -> 3586;
	3586 [label="Sempre che pensi che ne sarebbero così inclini.",shape=box,color=blue];
		3586 -> 3587;
		3586 -> 3588;
		3586 -> 3589;
	3587 [label="Onestamente, potresti non essere il loro tipo.",shape=box,color=red];
		3587 -> 3590;
	3588 [label="Ti adorerebbero, Marie. Come lo faccio io.",shape=box,color=red];
		3588 -> 3591;
	3589 [label="Non credo che potrebbero resistere.",shape=box,color=red];
		3589 -> 3591;
	3590 [label="Pff ! Sei terribile, mio lupo. Lasciami i miei sogni. Fino al allora, ti avrò quando ti avrò, suppongo !",shape=box,color=blue];
		3590 -> 3592;
	3591 [label="Fino ad allora, ti avrò quando ti avrò. E sarò felice di condividerti con coloro che si sono presi cura di te come ho fatto io.",shape=box,color=blue];
		3591 -> 3592;
	3592 [label="Dopotutto, qualcuno deve stare di guardia contro i Murmur mentre tu te ne vai a divertirti !",shape=box,color=blue];
