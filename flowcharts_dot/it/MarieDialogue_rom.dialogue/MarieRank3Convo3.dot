	"MarieRank3Convo3 begins." [color=orange];
		"MarieRank3Convo3 begins." -> j336195646;
	j336195646 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j336195646 -> j971302504;
	j971302504 [label="Check boolean MarieGraveyard1",color=orange];
		j971302504 -> j3776248181 [label=true,color=green];
		j971302504 -> j1028512326 [label=true,color=green];
		j971302504 -> j4115718638 [label=true,color=green];
		j971302504 -> j1153860263 [label=false,color=brown];
		j971302504 -> j1028512326 [label=false,color=brown];
		j971302504 -> j4115718638 [label=false,color=brown];
	j3776248181 [label="Potresti raccontarmi di più su com'era vivere nella Cattedrale? Prima dell'arrivo di Entrati?",shape=box,color=red];
		j3776248181 -> j3055833286;
	j1028512326 [label="Dove sei cresciuta, Marie?",shape=box,color=red];
		j1028512326 -> j3641788179;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j1153860263 [label="Com'era la tua vita alla Cattedrale prima che arrivasse Entrati?",shape=box,color=red];
		j1153860263 -> j3591694097;
	j3055833286 [label="In verità, solitaria, suppongo. Avevo Lyon, ma sai come può essere a volte. (Oh ! Sono così felice che tu e lui stiate parlando !)",shape=box,color=blue];
		j3055833286 -> j1093781352;
	j3641788179 [label="Boolean MarieBackstory1 is now true.",color=orange];
		j3641788179 -> j1026305288;
	"Chat ends." [color=orange];
	j3591694097 [label="Oh, non so se ti interesserebbe molto, ma te lo dirò comunque se sei così curioso. ",shape=box,color=blue];
		j3591694097 -> j4124813963;
	j1093781352 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j1093781352 -> j3485430413;
	j1026305288 [label="Pensavo che la lingua mi avesse tradita, ma poi mi sono ricordata che non fai parte del mio mondo, come lo conosco io, aha !",shape=box,color=blue];
		j1026305288 -> j3063878839;
	j4124813963 [label="L'ho trascorsa svolgendo i miei doveri di Suora dell'Ordine di Sol. Lucidavo il vasellame per la comunione e preparavo i votivi per i parrocchiani. ",shape=box,color=blue];
		j4124813963 -> j196790911;
	j3485430413 [label="Ma non è per questo che passo così tanto tempo a parlare con i morti.",shape=box,color=blue];
		j3485430413 -> j4209535906;
	j3063878839 [label="Vengo da la Cité de la Lumière, la capitale di un paese chiamato Gaule. Nel grande schema del mondo, non è poi così lontana da Höllvania sulla mappa.",shape=box,color=blue];
		j3063878839 -> j576854426;
	j196790911 [label="Prendendomi cura della cripta e del cimitero. Era il mio compito preferito.",shape=box,color=blue];
		j196790911 -> j4075074276;
		j196790911 -> j3594414862;
	j4209535906 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j4209535906 -> j3306440879;
	j576854426 [label="Chissà se la mia Cathédrale esiste ancora nel 1999 ? Che pensiero interessante !",shape=box,color=blue];
		j576854426 -> j1692754280;
		j576854426 -> j3049291675;
	j4075074276 [label="Perché era il tuo preferito?",shape=box,color=red];
		j4075074276 -> j836923643;
	j3594414862 [label="Mi dispiace. Parlami dell'ultima parte.",shape=box,color=red];
		j3594414862 -> j988329397;
	j3306440879 [label="C'è una bellezza in quei luoghi, una tranquillité. Sono così silenziosi. Pacifici.",shape=box,color=blue];
		j3306440879 -> j2677659532;
	j1692754280 [label="Ti piace divagare, non è vero?",shape=box,color=red];
		j1692754280 -> j555884678;
	j3049291675 [label="Potrei chiedere a due miei amici, sono piuttosto esperti. Credo che abbiano persino detto di essere stati in quella città.",shape=box,color=red];
		j3049291675 -> j2211571902;
	j836923643 [label="Mi piaceva molto parlare con coloro che riposavano in pace. Ascoltavano le mie preoccupazioni senza mai esprimere giudizi.",shape=box,color=blue];
		j836923643 -> j879200414;
	j988329397 [label="Era mio dovere prendermi cura dei defunti della Cathédrale. Spazzavo la polvere dal pavimento della cripta e diserbavo il giardino.",shape=box,color=blue];
		j988329397 -> j836923643;
	j2677659532 [label="Penso che mi piaccia raccontare loro dei miei problemi et les activités des autres perché le loro preoccupazioni sono finite, oui ?",shape=box,color=blue];
		j2677659532 -> j2370371666;
	j555884678 [label="+5 Chemistry",color=orange];
		j555884678 -> j3091867542;
	j2211571902 [label="+5 Chemistry",color=orange];
		j2211571902 -> j1580768473;
	j879200414 [label="Beh, non avevano una sola parola in risposta, mais cela me convenait tout à fait ! Preferisco di gran lunga che siano rimasti in silenzio.",shape=box,color=blue];
		j879200414 -> j3213518537;
	j2370371666 [label="Ora tutto deve sembrare piccolo per loro, e questo mi conforta.",shape=box,color=blue];
		j2370371666 -> j3050440442;
		j2370371666 -> j1452004457;
		j2370371666 -> j303946302;
	j3091867542 [label="Lo hai notato, oui ? Lyon mi prende sempre in giro dicendomi che sono un granello di polvere in un raggio di sole, spinto alla deriva dalla brezza. (Sono così felice che tu e lui stiate parlando!)",shape=box,color=blue];
		j3091867542 -> j3653440330;
	j1580768473 [label="Oh, non disturbarli, è semplicemente un'idea sciocca. Non so quanto mi dispiacerebbe pensare che non ci sia più.",shape=box,color=blue];
		j1580768473 -> j3653440330;
	j3213518537 [label="+5 Chemistry",color=orange];
		j3213518537 -> j2889686324;
	j3050440442 [label="Non so, ho... paura di morire veramente, non mi è mai piaciuto stare nelle vicinanze della morte.",shape=box,color=red];
		j3050440442 -> j3492716190;
	j1452004457 [label="Non ci avevo mai pensato.",shape=box,color=red];
		j1452004457 -> j2165424118;
	j303946302 [label="Ho trovato lo stesso tipo di pace nei cimiteri. Capisco perfettamente.",shape=box,color=red];
		j303946302 -> j1206202577;
	j3653440330 [label="Sono semplicemente curiosa, non ? Voglio sapere tout ce qui existe - tutto ciò che c'è - da sapere. Credo che sia per questo che le Cardinal e io eravamo destinati a incontrarci.",shape=box,color=blue];
		j3653440330 -> j2225472018;
	j2889686324 [label="Te lo immagini ? Teschi parlanti, proprio come il tuo necraloid ? Ha !",shape=box,color=blue];
		j2889686324 -> j2306682816;
		j2889686324 -> j2145399086;
	j3492716190 [label="Lo so, piccola morbosa Marie ! Così strana. Ma ognuno ha i suoi gusti, non ?",shape=box,color=blue];
		j3492716190 -> j4036032715;
	j2165424118 [label="Non sei solo. Non ci piace passare troppo tempo a pensare a cosa verrà dopo. Non finché il momento non si avvicina.",shape=box,color=blue];
		j2165424118 -> j1819125294;
	j1206202577 [label="Sono così felice che tu abbia capito !",shape=box,color=blue];
		j1206202577 -> j1819125294;
	j2225472018 [label="Où en étais-je ? Ah ! Oui. La mia storia.",shape=box,color=blue];
		j2225472018 -> j3455295273;
	j2306682816 [label="Non dev'essere stato un compito facile, data la tua sedia a rotelle.",shape=box,color=red];
		j2306682816 -> j2814403712;
	j2145399086 [label="Non avevi altri amici con cui parlare?",shape=box,color=red];
		j2145399086 -> j3515722659;
	j4036032715 [label="Qualcuno deve prendersi cura di loro. E io ne sono più che felice.",shape=box,color=blue];
		j4036032715 -> j1819125294;
	j1819125294 [label="Lyon scherza dicendo che sono più vicina al suolo, ed è per questo che penso così tanto alla tomba.",shape=box,color=blue];
		j1819125294 -> j2794067130;
	j3455295273 [label="Sono nata in una famiglia ricca, il che potrebbe sorprenderti. La classe bourgeois più vicina agli Orokin.",shape=box,color=blue];
		j3455295273 -> j623101447;
	j2814403712 [label="Non, non lo era. Ma Lyon mi aiutava a salire e scendere le scale per entrare nella cripta quando era il momento, e il resto l'ho imparato con il tempo.",shape=box,color=blue];
		j2814403712 -> j1685529465;
	j3515722659 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j3515722659 -> j19283525;
	j2794067130 [label=" Gli ho domandato se la sua testa fosse vuota e ed è per quello che è così piena di fantasmi.",shape=box,color=blue];
		j2794067130 -> j212428267;
	j623101447 [label="Ma quando naqui... deforme, con i mes pieds tordus et inutilisables ? Oh, ma mère non poteva permetterselo.",shape=box,color=blue];
		j623101447 -> j1312193144;
	j1685529465 [label="È impressionante ciò che si può fare con la testardaggine, oui ?",shape=box,color=blue];
		j1685529465 -> j3190950633;
	j19283525 [label="Avevo Lyon, ovviamente. Ma puoi vedere com'è, certi giorni.",shape=box,color=blue];
		j19283525 -> j4209535906;
	j212428267 [label="Poi lui minacciava di spingermi giù da una collina, e io minacciavo di riempirgli la tonaca di ortiche.",shape=box,color=blue];
		j212428267 -> j1118776134;
	j1312193144 [label="C'erano delle apparenze da mantenere, oui ? Degli standard.",shape=box,color=blue];
		j1312193144 -> j2985627196;
	j3190950633 [label="Beh. Testardaggine e forza nella parte superiore del corpo, ha !",shape=box,color=blue];
		j3190950633 -> j2598505382;
	j1118776134 [label="La famille.",shape=box,color=blue];
		j1118776134 -> j2564344941;
		j1118776134 -> j4478087;
		j1118776134 -> j842212831;
		j1118776134 -> j3501958751;
	j2985627196 [label="Quindi, cosa fare della povera deforme Marie ? Mi portarono alla Cité de la Lumière, dove mi lasciarono a vagare per le strade...",shape=box,color=blue];
		j2985627196 -> j1144892026;
	j2598505382 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j2598505382 -> j4209535906;
	j2564344941 [label="Mi dispiace che Entrati abbia sconvolto quello che avevi.",shape=box,color=red];
		j2564344941 -> j2784735736;
	j4478087 [label="Sono così felice che vi siate sostenuti a vicenda.",shape=box,color=red];
		j4478087 -> j855868704;
	j842212831 [label="Voi due mi fate sorridere.",shape=box,color=red];
		j842212831 -> j4097873323;
	j3501958751 [label="Quindi tu e lui... non è mai successo niente tra di voi?",shape=box,color=red];
		j3501958751 -> j1601884908;
	j1144892026 [label="E mi abbandonarono alla morte.",shape=box,color=blue];
		j1144892026 -> j41176515;
		j1144892026 -> j2389691955;
	j2784735736 [label="+10 Chemistry",color=orange];
		j2784735736 -> j3421138283;
	j855868704 [label="+20 Chemistry",color=orange];
		j855868704 -> j1819820578;
	j4097873323 [label="+20 Chemistry",color=orange];
		j4097873323 -> j983312081;
	j1601884908 [label="Oh, Sol ! Non ! È come un fratello per me in tutto e per tutto, tranne che di sangue. Mi ritrovo completamente dégoûtée solo da questa idea!",shape=box,color=blue];
		j1601884908 -> j3377687275;
		j1601884908 -> j1782018904;
	j41176515 [label="La tua famiglia ti ha lasciata alla morte?",shape=box,color=red];
		j41176515 -> j969172782;
	j2389691955 [label="Quanti anni avevi?",shape=box,color=red];
		j2389691955 -> j1699584271;
	j3421138283 [label="Entrati non ha sconvolto nulla. Lyon e io siamo forti come non mai. Le cose sono semplicemente cambiate, non ?",shape=box,color=blue];
		j3421138283 -> j2571044264;
	j1819820578 [label="Non sarei nulla senza di lui. Tranne, forse, ai piedi di una collina. Aha !",shape=box,color=blue];
		j1819820578 -> j2991805761;
	j983312081 [label="Mi fa ridere nei modi più strani. Ma trovo che anche tu, lupo, lo faccia. Mi sento sempre più felice di essere qui.",shape=box,color=blue];
		j983312081 -> j1885129778;
	j3377687275 [label="Ero solo curioso.",shape=box,color=red];
		j3377687275 -> j3385888755;
	j1782018904 [label="Lo ammetto, sono un po' sollevato.",shape=box,color=red];
		j1782018904 -> j1335227973;
	j969172782 [label="Ai loro occhi, avevano fatto del loro meglio per guarirmi. Tutori per insegnarmi a camminare. Apparecchi ortopedici. Calzature.",shape=box,color=blue];
		j969172782 -> j188609135;
	j1699584271 [label="Sei ? Sette ? Ai loro occhi, avevano fatto del loro meglio per guarirmi. Tutori per insegnarmi a camminare. Apparecchi ortopedici. Calzature.",shape=box,color=blue];
		j1699584271 -> j188609135;
	j2571044264 [label="Lua è in continua evoluzione. Persino Sol, per quanto costante, è influenzato nelle sue orbite.",shape=box,color=blue];
		j2571044264 -> j1202800537;
	j2991805761 [label="Lui è davvero il fratello della mia anima. Mi sento sempre più felice di essere qui.",shape=box,color=blue];
		j2991805761 -> j1885129778;
	j1885129778 [label="Spero solo che presto scopra la stessa cosa... ma il diavolo lo perseguita con i suoi sussurri e le sue bugie.",shape=box,color=blue];
		j1885129778 -> j839588077;
	j3385888755 [label="+10 Chemistry",color=orange];
		j3385888755 -> j1930259134;
	j1335227973 [label="Check boolean DrifterMarie",color=orange];
		j1335227973 -> j3884375224 [label=true,color=green];
		j1335227973 -> j2766224662 [label=false,color=brown];
	j188609135 [label="Erano stanchi di quel peso. Così, a malapena in grado di leggere e scrivere numeri e lettere, mi ritrovai nella sporcizia.",shape=box,color=blue];
		j188609135 -> j3385226401;
		j188609135 -> j1496918679;
	j1202800537 [label="Non dobbiamo essere rigidi nei nostri modi, altrimenti ci distruggerebbero, lupo. Inoltre, mi sento sempre più felice di essere qui.",shape=box,color=blue];
		j1202800537 -> j1885129778;
	j839588077 [label="Bah ! Si parla di lui e lui chiama. Devo andare.",shape=box,color=blue];
		j839588077 -> "Chat ends.";
	j1930259134 [label="Check boolean DrifterMarie",color=orange];
		j1930259134 -> j1592916064 [label=true,color=green];
		j1930259134 -> j849360795 [label=false,color=brown];
	j3884375224 [label="Oui, hai reso note le tue intenzioni. Devo avvertirti che non lo abbandonerò. Conosco Lyon da molto più tempo di te.",shape=box,color=blue];
		j3884375224 -> j849360795;
	j2766224662 [label="Oui ? E a chi di noi... dai la caccia ?",shape=box,color=blue];
		j2766224662 -> j2516553494;
		j2766224662 -> j3618494511;
	j3385226401 [label="Come sei sopravvissuta?",shape=box,color=red];
		j3385226401 -> j251854413;
	j1496918679 [label="È orribile.",shape=box,color=red];
		j1496918679 -> j251854413;
	j1592916064 [label="Oui. Semplicemente 'curioso'. Non mi inganni. Devo avvertirti che non lo abbandonerò. Conosco Lyon da molto più tempo di te.",shape=box,color=blue];
		j1592916064 -> j849360795;
	j849360795 [label="+20 Chemistry",color=orange];
		j849360795 -> j1775872429;
	j2516553494 [label="A te.",shape=box,color=red];
		j2516553494 -> j4040951889;
	j3618494511 [label="A Lyon.",shape=box,color=red];
		j3618494511 -> j2652703754;
	j251854413 [label="Check boolean MarieSecretPower",color=orange];
		j251854413 -> j560876494 [label=true,color=green];
		j251854413 -> j4286636928 [label=false,color=brown];
	j1775872429 [label="Non sarei nulla senza di lui. Tranne, forse, ai piedi di una collina. Aha !",shape=box,color=blue];
		j1775872429 -> j1602425278;
	j4040951889 [label="Boolean DrifterMarie is now true.",color=orange];
		j4040951889 -> j3894321167;
	j2652703754 [label="Vraiment ?!",shape=box,color=blue];
		j2652703754 -> j3760187363;
	j560876494 [label="Era come hai detto, non ? Tutte le 'inconvenienze' hanno un potere segreto.",shape=box,color=blue];
		j560876494 -> j4286636928;
	j4286636928 [label="Ciò che mi rendeva une indésirable pour ma mère, mi rendeva molto popolare tra gli altri bambini di strada.",shape=box,color=blue];
		j4286636928 -> j644033389;
	j1602425278 [label="Eppure mi incuriosisci, lupo. Mi sento sempre più felice di essere qui.",shape=box,color=blue];
		j1602425278 -> j1885129778;
	j3894321167 [label="+10 Chemistry",color=orange];
		j3894321167 -> j3832033134;
	j3760187363 [label="+10 Chemistry",color=orange];
		j3760187363 -> j3167549136;
	j644033389 [label="Cosa c'è di più pathétique di una bambina senza pieds, oui ? Potevo guadagnare di più in un giorno, a mani tese, di quanto loro potevano rubare in una settimana.",shape=box,color=blue];
		j644033389 -> j3743485046;
	j3832033134 [label="Oh ! Par Sol. Mi cogli di sorpresa, lo ammetto. E ora sono qui seduta ad arrossire, nascondendo il mio viso a Monsieur Loid...",shape=box,color=blue];
		j3832033134 -> j62797847;
	j3167549136 [label="Non sai quanto questo mi renda felice, ma ti prego, rifletti su ciò che dici.",shape=box,color=blue];
		j3167549136 -> j111335736;
	j3743485046 [label="Fu questo che mi portò a essere trovata per strada da una de les Sœurs de Sol. Si offrirono di ospitarmi.",shape=box,color=blue];
		j3743485046 -> j1423115612;
		j3743485046 -> j2269673710;
	j62797847 [label="Devo avvertirti che non lo abbandonerò. Conosco Lyon da molto più tempo di te.",shape=box,color=blue];
		j62797847 -> j3269620941;
	j111335736 [label="Boolean DrifterLyon is now true.",color=orange];
		j111335736 -> j2737891065;
	j1423115612 [label="E gli altri bambini?",shape=box,color=red];
		j1423115612 -> j2470983792;
	j2269673710 [label="Ovviamente, hai detto di sì.",shape=box,color=red];
		j2269673710 -> j768993310;
	j3269620941 [label="+10 Chemistry",color=orange];
		j3269620941 -> j1885129778;
	j2737891065 [label="Lyon è mio fratello. Lo amo più di quanto tu possa immaginare, ma è un uomo tormentato. Rifletti attentamente sulle tue parole prima di inseguirlo, n'est-ce pas ?",shape=box,color=blue];
		j2737891065 -> j476373637;
	j2470983792 [label="+5 Chemistry",color=orange];
		j2470983792 -> j2846506425;
	j768993310 [label="Oui, cosa potevo fare ? Era solo questione di tempo prima che mi ammalassi. Lo sapevo già da enfant.",shape=box,color=blue];
		j768993310 -> j907608044;
		j768993310 -> j1367687061;
	j476373637 [label="Penso che ne riparleremo presto. Non fraintendermi, ti sto incoraggiando! Voglio solo che ci pensi bene.",shape=box,color=blue];
		j476373637 -> j3269620941;
	j2846506425 [label="Hai un cuore così buono. Ovviamente, non potevano accoglierci tutti... ma non ho dimenticato i miei amici.",shape=box,color=blue];
		j2846506425 -> j2268000611;
	j907608044 [label="Come erano le suore?",shape=box,color=red];
		j907608044 -> j1641638858;
	j1367687061 [label="Come ti sei adattata alla vita nella Cattedrale?",shape=box,color=red];
		j1367687061 -> j3436596773;
	j2268000611 [label="Ogni settimana tornavo con il mio stipendio e con gli scarti che riuscivo a raccogliere in cucina o dagli altri.",shape=box,color=blue];
		j2268000611 -> j2357066790;
	j1641638858 [label="Les Sœurs erano gentili con me ! Anche se so perché pensi che sia il contrario, non ?",shape=box,color=blue];
		j1641638858 -> j1057864728;
	j3436596773 [label="Quanto l'ho adorato ! Anche se so perché pensi che sia il contrario, non ?",shape=box,color=blue];
		j3436596773 -> j1057864728;
	j2357066790 [label="Mi sono presa cura di loro il più possibile, finché sono rimasti. Molti sono morti di varicella o tubercolosi...",shape=box,color=blue];
		j2357066790 -> j2887448085;
	j1057864728 [label="Tre pasti, un letto caldo, un tetto sopra la testa. Non dovevo preoccuparmi di essere picchiata, derubata o peggio ?",shape=box,color=blue];
		j1057864728 -> j1954757119;
	j2887448085 [label="Molti se ne andarono, alcuni morirono combattendo o per violenza. La maggior parte trovò un lavoro onesto e crebbe. Crescendo, si crearono una famiglia tutta loro.",shape=box,color=blue];
		j2887448085 -> j4176334739;
	j1954757119 [label="Ho ricevuto un'istruzione adeguata. Mi hanno insegnato la dottrina di Sol e Lua. Mi hanno detto di trovare la mia strada nella fede. Avrei potuto andarmene, se avessi voluto.",shape=box,color=blue];
		j1954757119 -> j1225172692;
	j4176334739 [label="Alcuni si fermavano persino alla Cathédrale per vedermi. Mi scaldava il cuore.",shape=box,color=blue];
		j4176334739 -> j1225172692;
	j1225172692 [label="Per molto tempo mi sono sentita in colpa perché sono stata portata via dalla strada. A volte ci penso ancora.",shape=box,color=blue];
		j1225172692 -> j1395817826;
		j1225172692 -> j3718073475;
	j1395817826 [label="Quando penso a tutti quelli che sono morti intorno a me, quando sono io quello sopravvissuto? Provo la stessa cosa. Ma non possiamo farlo a noi stessi. Dobbiamo continuare a lottare per migliorare le cose quando possiamo.",shape=box,color=red];
		j1395817826 -> j636301964;
	j3718073475 [label="Hai fatto del tuo meglio per aiutare gli altri con ciò che ti è stato dato. Altri ti hanno sostenuto e ora che ti è stata data questa opportunità, stai cercando di sostenere gli altri.",shape=box,color=red];
		j3718073475 -> j2212638511;
	j636301964 [label="Sarà sempre così ? Una lotta ? Una guerra contro una marea che cerca di affogarci ?",shape=box,color=blue];
