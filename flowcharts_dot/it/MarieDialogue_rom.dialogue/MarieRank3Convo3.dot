digraph {
	1113 [label="MarieRank3Convo3 begins.",color=orange];
		1113 -> 3737;
	3737 [label="Update boolean MarieLyonAvailable",color=orange];
		3737 -> 1114;
	1114 [label="Check boolean MarieGraveyard1",color=orange];
		1114 -> 1115 [label=true,color=green];
		1114 -> 1117 [label=true,color=green];
		1114 -> 1118 [label=true,color=green];
		1114 -> 1116 [label=false,color=brown];
		1114 -> 1117 [label=false,color=brown];
		1114 -> 1118 [label=false,color=brown];
	1115 [label="Potresti raccontarmi di più su com'era vivere nella Cattedrale? Prima dell'arrivo di Entrati?",shape=box,color=red];
		1115 -> 1119;
	1117 [label="Dove sei cresciuta, Marie?",shape=box,color=red];
		1117 -> 2425;
	1118 [label="[Fine.]",shape=box,color=red];
		1118 -> 1122;
	1116 [label="Com'era la tua vita alla Cattedrale prima che arrivasse Entrati?",shape=box,color=red];
		1116 -> 1120;
	1119 [label="In verità, solitaria, suppongo. Avevo Lyon, ma sai come può essere a volte. (Oh ! Sono così felice che tu e lui stiate parlando !)",shape=box,color=blue];
		1119 -> 1123;
	2425 [label="Update boolean MarieBackstory1",color=orange];
		2425 -> 1121;
	1122 [label="Chat ends.",color=orange];
	1120 [label="Oh, non so se ti interesserebbe molto, ma te lo dirò comunque se sei così curioso. ",shape=box,color=blue];
		1120 -> 1124;
	1123 [label="Update boolean MarieGraveyard2",color=orange];
		1123 -> 1126;
	1121 [label="Pensavo che la lingua mi avesse tradita, ma poi mi sono ricordata che non fai parte del mio mondo, come lo conosco io, aha !",shape=box,color=blue];
		1121 -> 1125;
	1124 [label="L'ho trascorsa svolgendo i miei doveri di Suora dell'Ordine di Sol. Lucidavo il vasellame per la comunione e preparavo i votivi per i parrocchiani. ",shape=box,color=blue];
		1124 -> 1127;
	1126 [label="Ma non è per questo che passo così tanto tempo a parlare con i morti.",shape=box,color=blue];
		1126 -> 1129;
	1125 [label="Vengo da la Cité de la Lumière, la capitale di un paese chiamato Gaule. Nel grande schema del mondo, non è poi così lontana da Höllvania sulla mappa.",shape=box,color=blue];
		1125 -> 1128;
	1127 [label="Prendendomi cura della cripta e del cimitero. Era il mio compito preferito.",shape=box,color=blue];
		1127 -> 1130;
		1127 -> 1131;
	1129 [label="Update boolean MarieGraveyard2",color=orange];
		1129 -> 1134;
	1128 [label="Chissà se la mia Cathédrale esiste ancora nel 1999 ? Che pensiero interessante !",shape=box,color=blue];
		1128 -> 1132;
		1128 -> 1133;
	1130 [label="Perché era il tuo preferito?",shape=box,color=red];
		1130 -> 1135;
	1131 [label="Mi dispiace. Parlami dell'ultima parte.",shape=box,color=red];
		1131 -> 1136;
	1134 [label="C'è una bellezza in quei luoghi, una tranquillité. Sono così silenziosi. Pacifici.",shape=box,color=blue];
		1134 -> 1139;
	1132 [label="Ti piace divagare, non è vero?",shape=box,color=red];
		1132 -> 1137;
	1133 [label="Potrei chiedere a due miei amici, sono piuttosto esperti. Credo che abbiano persino detto di essere stati in quella città.",shape=box,color=red];
		1133 -> 1138;
	1135 [label="Mi piaceva molto parlare con coloro che riposavano in pace. Ascoltavano le mie preoccupazioni senza mai esprimere giudizi.",shape=box,color=blue];
		1135 -> 1140;
	1136 [label="Era mio dovere prendermi cura dei defunti della Cathédrale. Spazzavo la polvere dal pavimento della cripta e diserbavo il giardino.",shape=box,color=blue];
		1136 -> 1135;
	1139 [label="Penso che mi piaccia raccontare loro dei miei problemi et les activités des autres perché le loro preoccupazioni sono finite, oui ?",shape=box,color=blue];
		1139 -> 1143;
	1137 [label="+5 Chemistry",color=orange];
		1137 -> 1141;
	1138 [label="+5 Chemistry",color=orange];
		1138 -> 1142;
	1140 [label="Beh, non avevano una sola parola in risposta, mais cela me convenait tout à fait ! Preferisco di gran lunga che siano rimasti in silenzio.",shape=box,color=blue];
		1140 -> 1144;
	1143 [label="Ora tutto deve sembrare piccolo per loro, e questo mi conforta.",shape=box,color=blue];
		1143 -> 1146;
		1143 -> 1147;
		1143 -> 1148;
	1141 [label="Lo hai notato, oui ? Lyon mi prende sempre in giro dicendomi che sono un granello di polvere in un raggio di sole, spinto alla deriva dalla brezza. (Sono così felice che tu e lui stiate parlando!)",shape=box,color=blue];
		1141 -> 1145;
	1142 [label="Oh, non disturbarli, è semplicemente un'idea sciocca. Non so quanto mi dispiacerebbe pensare che non ci sia più.",shape=box,color=blue];
		1142 -> 1145;
	1144 [label="+5 Chemistry",color=orange];
		1144 -> 1149;
	1146 [label="Non so, ho... paura di morire veramente, non mi è mai piaciuto stare nelle vicinanze della morte.",shape=box,color=red];
		1146 -> 1151;
	1147 [label="Non ci avevo mai pensato.",shape=box,color=red];
		1147 -> 1152;
	1148 [label="Ho trovato lo stesso tipo di pace nei cimiteri. Capisco perfettamente.",shape=box,color=red];
		1148 -> 1153;
	1145 [label="Sono semplicemente curiosa, non ? Voglio sapere tout ce qui existe - tutto ciò che c'è - da sapere. Credo che sia per questo che le Cardinal e io eravamo destinati a incontrarci.",shape=box,color=blue];
		1145 -> 1150;
	1149 [label="Te lo immagini ? Teschi parlanti, proprio come il tuo necraloid ? Ha !",shape=box,color=blue];
		1149 -> 1154;
		1149 -> 1155;
	1151 [label="Lo so, piccola morbosa Marie ! Così strana. Ma ognuno ha i suoi gusti, non ?",shape=box,color=blue];
		1151 -> 1157;
	1152 [label="Non sei solo. Non ci piace passare troppo tempo a pensare a cosa verrà dopo. Non finché il momento non si avvicina.",shape=box,color=blue];
		1152 -> 1158;
	1153 [label="Sono così felice che tu abbia capito !",shape=box,color=blue];
		1153 -> 1158;
	1150 [label="Où en étais-je ? Ah ! Oui. La mia storia.",shape=box,color=blue];
		1150 -> 1156;
	1154 [label="Non dev'essere stato un compito facile, data la tua sedia a rotelle.",shape=box,color=red];
		1154 -> 1159;
	1155 [label="Non avevi altri amici con cui parlare?",shape=box,color=red];
		1155 -> 1160;
	1157 [label="Qualcuno deve prendersi cura di loro. E io ne sono più che felice.",shape=box,color=blue];
		1157 -> 1158;
	1158 [label="Lyon scherza dicendo che sono più vicina al suolo, ed è per questo che penso così tanto alla tomba.",shape=box,color=blue];
		1158 -> 1162;
	1156 [label="Sono nata in una famiglia ricca, il che potrebbe sorprenderti. La classe bourgeois più vicina agli Orokin.",shape=box,color=blue];
		1156 -> 1161;
	1159 [label="Non, non lo era. Ma Lyon mi aiutava a salire e scendere le scale per entrare nella cripta quando era il momento, e il resto l'ho imparato con il tempo.",shape=box,color=blue];
		1159 -> 1163;
	1160 [label="Update boolean MarieGraveyard1",color=orange];
		1160 -> 1164;
	1162 [label=" Gli ho domandato se la sua testa fosse vuota e ed è per quello che è così piena di fantasmi.",shape=box,color=blue];
		1162 -> 1166;
	1161 [label="Ma quando naqui... deforme, con i mes pieds tordus et inutilisables ? Oh, ma mère non poteva permetterselo.",shape=box,color=blue];
		1161 -> 1165;
	1163 [label="È impressionante ciò che si può fare con la testardaggine, oui ?",shape=box,color=blue];
		1163 -> 1167;
	1164 [label="Avevo Lyon, ovviamente. Ma puoi vedere com'è, certi giorni.",shape=box,color=blue];
		1164 -> 1129;
	1166 [label="Poi lui minacciava di spingermi giù da una collina, e io minacciavo di riempirgli la tonaca di ortiche.",shape=box,color=blue];
		1166 -> 1169;
	1165 [label="C'erano delle apparenze da mantenere, oui ? Degli standard.",shape=box,color=blue];
		1165 -> 1168;
	1167 [label="Beh. Testardaggine e forza nella parte superiore del corpo, ha !",shape=box,color=blue];
		1167 -> 1170;
	1169 [label="La famille.",shape=box,color=blue];
		1169 -> 1172;
		1169 -> 1173;
		1169 -> 1174;
		1169 -> 3921;
	1168 [label="Quindi, cosa fare della povera deforme Marie ? Mi portarono alla Cité de la Lumière, dove mi lasciarono a vagare per le strade...",shape=box,color=blue];
		1168 -> 1171;
	1170 [label="Update boolean MarieGraveyard1",color=orange];
		1170 -> 1129;
	1172 [label="Mi dispiace che Entrati abbia sconvolto quello che avevi.",shape=box,color=red];
		1172 -> 1177;
	1173 [label="Sono così felice che vi siate sostenuti a vicenda.",shape=box,color=red];
		1173 -> 1178;
	1174 [label="Voi due mi fate sorridere.",shape=box,color=red];
		1174 -> 1179;
	3921 [label="Quindi tu e lui... non è mai successo niente tra di voi?",shape=box,color=red];
		3921 -> 3922;
	1171 [label="E mi abbandonarono alla morte.",shape=box,color=blue];
		1171 -> 1175;
		1171 -> 1176;
	1177 [label="+10 Chemistry",color=orange];
		1177 -> 1182;
	1178 [label="+20 Chemistry",color=orange];
		1178 -> 1183;
	1179 [label="+20 Chemistry",color=orange];
		1179 -> 1184;
	3922 [label="Oh, Sol ! Non ! È come un fratello per me in tutto e per tutto, tranne che di sangue. Mi ritrovo completamente dégoûtée solo da questa idea!",shape=box,color=blue];
		3922 -> 3923;
		3922 -> 3924;
	1175 [label="La tua famiglia ti ha lasciata alla morte?",shape=box,color=red];
		1175 -> 1180;
	1176 [label="Quanti anni avevi?",shape=box,color=red];
		1176 -> 1181;
	1182 [label="Entrati non ha sconvolto nulla. Lyon e io siamo forti come non mai. Le cose sono semplicemente cambiate, non ?",shape=box,color=blue];
		1182 -> 1186;
	1183 [label="Non sarei nulla senza di lui. Tranne, forse, ai piedi di una collina. Aha !",shape=box,color=blue];
		1183 -> 1187;
	1184 [label="Mi fa ridere nei modi più strani. Ma trovo che anche tu, lupo, lo faccia. Mi sento sempre più felice di essere qui.",shape=box,color=blue];
		1184 -> 1188;
	3923 [label="Ero solo curioso.",shape=box,color=red];
		3923 -> 3925;
	3924 [label="Lo ammetto, sono un po' sollevato.",shape=box,color=red];
		3924 -> 3931;
	1180 [label="Ai loro occhi, avevano fatto del loro meglio per guarirmi. Tutori per insegnarmi a camminare. Apparecchi ortopedici. Calzature.",shape=box,color=blue];
		1180 -> 1185;
	1181 [label="Sei ? Sette ? Ai loro occhi, avevano fatto del loro meglio per guarirmi. Tutori per insegnarmi a camminare. Apparecchi ortopedici. Calzature.",shape=box,color=blue];
		1181 -> 1185;
	1186 [label="Lua è in continua evoluzione. Persino Sol, per quanto costante, è influenzato nelle sue orbite.",shape=box,color=blue];
		1186 -> 1191;
	1187 [label="Lui è davvero il fratello della mia anima. Mi sento sempre più felice di essere qui.",shape=box,color=blue];
		1187 -> 1188;
	1188 [label="Spero solo che presto scopra la stessa cosa... ma il diavolo lo perseguita con i suoi sussurri e le sue bugie.",shape=box,color=blue];
		1188 -> 1192;
	3925 [label="+10 Chemistry",color=orange];
		3925 -> 3926;
	3931 [label="Check boolean DrifterMarie",color=orange];
		3931 -> 3932 [label=true,color=green];
		3931 -> 3933 [label=false,color=brown];
	1185 [label="Erano stanchi di quel peso. Così, a malapena in grado di leggere e scrivere numeri e lettere, mi ritrovai nella sporcizia.",shape=box,color=blue];
		1185 -> 1189;
		1185 -> 1190;
	1191 [label="Non dobbiamo essere rigidi nei nostri modi, altrimenti ci distruggerebbero, lupo. Inoltre, mi sento sempre più felice di essere qui.",shape=box,color=blue];
		1191 -> 1188;
	1192 [label="Bah ! Si parla di lui e lui chiama. Devo andare.",shape=box,color=blue];
		1192 -> 1194;
	3926 [label="Check boolean DrifterMarie",color=orange];
		3926 -> 3927 [label=true,color=green];
		3926 -> 3928 [label=false,color=brown];
	3932 [label="Oui, hai reso note le tue intenzioni. Devo avvertirti che non lo abbandonerò. Conosco Lyon da molto più tempo di te.",shape=box,color=blue];
		3932 -> 3928;
	3933 [label="Oui ? E a chi di noi... dai la caccia ?",shape=box,color=blue];
		3933 -> 3934;
		3933 -> 3935;
	1189 [label="Come sei sopravvissuta?",shape=box,color=red];
		1189 -> 1193;
	1190 [label="È orribile.",shape=box,color=red];
		1190 -> 1193;
	1194 [label="Chat ends.",color=orange];
	3927 [label="Oui. Semplicemente 'curioso'. Non mi inganni. Devo avvertirti che non lo abbandonerò. Conosco Lyon da molto più tempo di te.",shape=box,color=blue];
		3927 -> 3928;
	3928 [label="+20 Chemistry",color=orange];
		3928 -> 3929;
	3934 [label="A te.",shape=box,color=red];
		3934 -> 3936;
	3935 [label="A Lyon.",shape=box,color=red];
		3935 -> 3941;
	1193 [label="Check boolean MarieSecretPower",color=orange];
		1193 -> 1196 [label=true,color=green];
		1193 -> 1195 [label=false,color=brown];
	3929 [label="Non sarei nulla senza di lui. Tranne, forse, ai piedi di una collina. Aha !",shape=box,color=blue];
		3929 -> 3930;
	3936 [label="Update boolean DrifterMarie",color=orange];
		3936 -> 3937;
	3941 [label="Vraiment ?!",shape=box,color=blue];
		3941 -> 3942;
	1196 [label="Era come hai detto, non ? Tutte le 'inconvenienze' hanno un potere segreto.",shape=box,color=blue];
		1196 -> 1195;
	1195 [label="Ciò che mi rendeva une indésirable pour ma mère, mi rendeva molto popolare tra gli altri bambini di strada.",shape=box,color=blue];
		1195 -> 1197;
	3930 [label="Eppure mi incuriosisci, lupo. Mi sento sempre più felice di essere qui.",shape=box,color=blue];
		3930 -> 1188;
	3937 [label="+10 Chemistry",color=orange];
		3937 -> 3938;
	3942 [label="+10 Chemistry",color=orange];
		3942 -> 3943;
	1197 [label="Cosa c'è di più pathétique di una bambina senza pieds, oui ? Potevo guadagnare di più in un giorno, a mani tese, di quanto loro potevano rubare in una settimana.",shape=box,color=blue];
		1197 -> 1198;
	3938 [label="Oh ! Par Sol. Mi cogli di sorpresa, lo ammetto. E ora sono qui seduta ad arrossire, nascondendo il mio viso a Monsieur Loid...",shape=box,color=blue];
		3938 -> 3939;
	3943 [label="Non sai quanto questo mi renda felice, ma ti prego, rifletti su ciò che dici.",shape=box,color=blue];
		3943 -> 3944;
	1198 [label="Fu questo che mi portò a essere trovata per strada da una de les Sœurs de Sol. Si offrirono di ospitarmi.",shape=box,color=blue];
		1198 -> 1199;
		1198 -> 1200;
	3939 [label="Devo avvertirti che non lo abbandonerò. Conosco Lyon da molto più tempo di te.",shape=box,color=blue];
		3939 -> 3940;
	3944 [label="Update boolean DrifterLyon",color=orange];
		3944 -> 3945;
	1199 [label="E gli altri bambini?",shape=box,color=red];
		1199 -> 1201;
	1200 [label="Ovviamente, hai detto di sì.",shape=box,color=red];
		1200 -> 1202;
	3940 [label="+10 Chemistry",color=orange];
		3940 -> 1188;
	3945 [label="Lyon è mio fratello. Lo amo più di quanto tu possa immaginare, ma è un uomo tormentato. Rifletti attentamente sulle tue parole prima di inseguirlo, n'est-ce pas ?",shape=box,color=blue];
		3945 -> 3946;
	1201 [label="+5 Chemistry",color=orange];
		1201 -> 1203;
	1202 [label="Oui, cosa potevo fare ? Era solo questione di tempo prima che mi ammalassi. Lo sapevo già da enfant.",shape=box,color=blue];
		1202 -> 1204;
		1202 -> 1205;
	3946 [label="Penso che ne riparleremo presto. Non fraintendermi, ti sto incoraggiando! Voglio solo che ci pensi bene.",shape=box,color=blue];
		3946 -> 3940;
	1203 [label="Hai un cuore così buono. Ovviamente, non potevano accoglierci tutti... ma non ho dimenticato i miei amici.",shape=box,color=blue];
		1203 -> 1206;
	1204 [label="Come erano le suore?",shape=box,color=red];
		1204 -> 1207;
	1205 [label="Come ti sei adattata alla vita nella Cattedrale?",shape=box,color=red];
		1205 -> 1208;
	1206 [label="Ogni settimana tornavo con il mio stipendio e con gli scarti che riuscivo a raccogliere in cucina o dagli altri.",shape=box,color=blue];
		1206 -> 1209;
	1207 [label="Les Sœurs erano gentili con me ! Anche se so perché pensi che sia il contrario, non ?",shape=box,color=blue];
		1207 -> 1210;
	1208 [label="Quanto l'ho adorato ! Anche se so perché pensi che sia il contrario, non ?",shape=box,color=blue];
		1208 -> 1210;
	1209 [label="Mi sono presa cura di loro il più possibile, finché sono rimasti. Molti sono morti di varicella o tubercolosi...",shape=box,color=blue];
		1209 -> 1211;
	1210 [label="Tre pasti, un letto caldo, un tetto sopra la testa. Non dovevo preoccuparmi di essere picchiata, derubata o peggio ?",shape=box,color=blue];
		1210 -> 1212;
	1211 [label="Molti se ne andarono, alcuni morirono combattendo o per violenza. La maggior parte trovò un lavoro onesto e crebbe. Crescendo, si crearono una famiglia tutta loro.",shape=box,color=blue];
		1211 -> 1213;
	1212 [label="Ho ricevuto un'istruzione adeguata. Mi hanno insegnato la dottrina di Sol e Lua. Mi hanno detto di trovare la mia strada nella fede. Avrei potuto andarmene, se avessi voluto.",shape=box,color=blue];
		1212 -> 1214;
	1213 [label="Alcuni si fermavano persino alla Cathédrale per vedermi. Mi scaldava il cuore.",shape=box,color=blue];
		1213 -> 1214;
	1214 [label="Per molto tempo mi sono sentita in colpa perché sono stata portata via dalla strada. A volte ci penso ancora.",shape=box,color=blue];
		1214 -> 1215;
		1214 -> 1216;
	1215 [label="Quando penso a tutti quelli che sono morti intorno a me, quando sono io quello sopravvissuto? Provo la stessa cosa. Ma non possiamo farlo a noi stessi. Dobbiamo continuare a lottare per migliorare le cose quando possiamo.",shape=box,color=red];
		1215 -> 1217;
	1216 [label="Hai fatto del tuo meglio per aiutare gli altri con ciò che ti è stato dato. Altri ti hanno sostenuto e ora che ti è stata data questa opportunità, stai cercando di sostenere gli altri.",shape=box,color=red];
		1216 -> 1218;
	1217 [label="Sarà sempre così ? Una lotta ? Una guerra contro una marea che cerca di affogarci ?",shape=box,color=blue];
		1217 -> 1219;
	1218 [label="Add 1 to Thermostat",color=orange];
		1218 -> 1220;
	1219 [label="Add -1 to Thermostat",color=orange];
		1219 -> 1221;
	1220 [label="+10 Chemistry",color=orange];
		1220 -> 1222;
	1221 [label="+10 Chemistry",color=orange];
		1221 -> 1223;
	1222 [label="Oui, è proprio così. Mi hanno salvata e ora è il mio turno. ",shape=box,color=blue];
		1222 -> 1224;
	1223 [label="Ma capisco cosa intendi. In fondo, dici di non arrendersi. Che mi sono stati dati questi doni affinché io possa fungere da scudo per gli altri.",shape=box,color=blue];
		1223 -> 1224;
	1224 [label="Merci. Ma per ora devo andare.",shape=box,color=blue];
		1224 -> 1225;
	1225 [label="Chat ends.",color=orange];
}