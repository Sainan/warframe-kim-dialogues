digraph {
	"MarieRank3Convo6 begins." [color=orange];
		"MarieRank3Convo6 begins." -> j2388370614;
	j2388370614 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j2388370614 -> j916122447;
	j916122447 [label="Devo farti un domanda, e devo implorarti di non giudicarmi, Drifter.",shape=box,color=blue];
		j916122447 -> j1690349330;
		j916122447 -> j2299676627;
		j916122447 -> j4115718638;
	j1690349330 [label="Ti sei trovata in una situazione assurda. Ovviamente non ti giudicherò.",shape=box,color=red];
		j1690349330 -> j896900662;
	j2299676627 [label="Farò del mio meglio.",shape=box,color=red];
		j2299676627 -> j916927436;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j896900662 [label="Vraiment gentil da parte tua farmi una tale grazia senza sapere chi fossi o cosa stessi per scriverti.",shape=box,color=blue];
		j896900662 -> j4164345554;
	j916927436 [label="+10 Chemistry",color=orange];
		j916927436 -> j3207077300;
	"Chat ends." [color=orange];
	j4164345554 [label="Ma... anche a te il pesce parlante dalla testa grande fa venire mal di testa ? Fibonacci ?",shape=box,color=blue];
		j4164345554 -> j140692433;
		j4164345554 -> j2843674338;
		j4164345554 -> j1177507946;
	j3207077300 [label="Lo apprezzo molto, grazie.",shape=box,color=blue];
		j3207077300 -> j4164345554;
	j140692433 [label="Sì. Sì, assolutamente. Grazie.",shape=box,color=red];
		j140692433 -> j1888634518;
	j2843674338 [label="L'idea che tu sia infastidita da Fibonacci è incredibilmente adorabile.",shape=box,color=red];
		j2843674338 -> j531399750;
	j1177507946 [label="No, in realtà lo adoro.",shape=box,color=red];
		j1177507946 -> j2749620430;
	j1888634518 [label="Allora sono felice di non essere la sola. Ma, per essere chiari, non intendo offenderlo. Se mi sento giù per via della mia attuale situazione, immagino che anche lui resista come meglio può.",shape=box,color=blue];
		j1888634518 -> j1976420472;
	j531399750 [label="Oh ? Come mai ? Immagino di esserne felice, ma sono semplicemente confusa sul perché. Il mio mal di testa non è certo così adorabile.",shape=box,color=blue];
		j531399750 -> j2191788009;
		j531399750 -> j3289041565;
	j2749620430 [label="Allora non posso far altro che chiederti perdono, non intendo offenderlo. Se mi sento a disagio per la natura della mia attuale situazione, immagino che anche lui resista come meglio può.",shape=box,color=blue];
		j2749620430 -> j1770631484;
	j1976420472 [label="Il suo modo di fare semplicemente non va d'accordo con me quando mi trovo a doverlo subire per molto tempo, tutto qui.",shape=box,color=blue];
		j1976420472 -> j2403189196;
	j2191788009 [label="Passo la maggior parte del mio tempo a lottare per la mia vita. Piccoli ricordi di umanità come questi sono... in un certo senso ciò per cui vivo.",shape=box,color=red];
		j2191788009 -> j3721369847;
	j3289041565 [label="Suppogo che ogni tanto io debba fare un passo indietro e riflettere sull'assurdità di tutto. Un Norg e una sacerdotessa di Sol...",shape=box,color=red];
		j3289041565 -> j178235544;
	j1770631484 [label="Il suo modo di fare semplicemente non va d'accordo con me quando mi trovo a doverlo subire per molto tempo, tutto qui.",shape=box,color=blue];
		j1770631484 -> j2403189196;
	j2403189196 [label="Bah. Non dovrei lamentarmi. Devo portare la cena a Lyon stasera, è di nuovo a letto con una terribile cefalea.",shape=box,color=blue];
		j2403189196 -> j3089963265;
		j2403189196 -> j3726777982;
	j3721369847 [label="+5 Chemistry",color=orange];
		j3721369847 -> j481359565;
	j178235544 [label="+5 Chemistry",color=orange];
		j178235544 -> j1313151039;
	j3089963265 [label="Gli capitano spesso?",shape=box,color=red];
		j3089963265 -> j2183940677;
	j3726777982 [label="Scusami... una cosa?",shape=box,color=red];
		j3726777982 -> j3312410839;
	j481359565 [label="Non perdere mai quella parte di te, Drifter. Non lasciar mai andare quella parte di te che cerca quelle scintille di vita.",shape=box,color=blue];
		j481359565 -> j1387771286;
	j1313151039 [label="Oddio, se la metti così, non c'è da stupirsi. Sembra proprio una di quelle barzellette infantili, n'est-ce pas ?",shape=box,color=blue];
		j1313151039 -> j361477463;
	j2183940677 [label="Oui, oui. Una volta ogni due settimane ? Un volta ogni due mesi ? Il periodo più lungo in cui l'ho visto stare senza è stato di circa sei mesi.",shape=box,color=blue];
		j2183940677 -> j547018639;
	j3312410839 [label="Oh ! Tesoro. Hm. Pensa a un mal di testa, ma molto più intenso. Ho sentito altri chiamarlo mal di testa bilioso. È più comune nelle donne.",shape=box,color=blue];
		j3312410839 -> j564032849;
		j3312410839 -> j470313754;
	j1387771286 [label="Il mondo è troppo ansioso di diventare un posto buio e serio. Troppo pronto a infliggerci sofferenza a ogni passo.",shape=box,color=blue];
		j1387771286 -> j2712705596;
	j361477463 [label="Una Suora, un Prete e un Diavolo dal futuro vengono mandati nel passato... e poi nel futur... e incontrano un pesce, una creatura-cervo, un uccello gigante e un maggiordomo...",shape=box,color=blue];
		j361477463 -> j2639110563;
	j547018639 [label="Check boolean Megrim",color=orange];
		j547018639 -> j1023973637 [label=true,color=green];
		j547018639 -> j3937168434 [label=true,color=green];
		j547018639 -> j3578525591 [label=true,color=green];
		j547018639 -> j1023973637 [label=false,color=brown];
		j547018639 -> j3937168434 [label=false,color=brown];
		j547018639 -> j3113099273 [label=false,color=brown];
	j564032849 [label="Credo che ora le chiamiamo ''emicranie''.",shape=box,color=red];
		j564032849 -> j4030409165;
	j470313754 [label="Huh. Cefalee. Grazie.",shape=box,color=red];
		j470313754 -> j1843946086;
	j2712705596 [label="Dobbiamo cercare tutta la luminosità, tutta la leggerezza possibile, anche sotto forma di immaturità, se necessario.",shape=box,color=blue];
		j2712705596 -> j3720196419;
	j2639110563 [label="È davvero divertente, hai proprio ragione !",shape=box,color=blue];
		j2639110563 -> j955168959;
	j1023973637 [label="Mi chiedo cosa le causi.",shape=box,color=red];
		j1023973637 -> j380935233;
	j3937168434 [label="Sembra orribile...",shape=box,color=red];
		j3937168434 -> j1818189053;
	j3578525591 [label="Anch'io soffro di cefalee. Sono terribili.",shape=box,color=red];
		j3578525591 -> j3613972611;
	j3113099273 [label="Anche a me viene questo tipo di mal di testa. È terribile.",shape=box,color=red];
		j3113099273 -> j3613972611;
	j4030409165 [label="Chissà quali altre affascinanti particolarità storiche scopriremo! Emozionante. Adoro imparare cose nuove. ''Emicrania.'' Il viaggio continua.",shape=box,color=blue];
		j4030409165 -> j2882643356;
	j1843946086 [label="Boolean Megrim is now true.",color=orange];
		j1843946086 -> j2435000177;
	j3720196419 [label="Ora, se solo Lyon vedesse le cose allo stesso modo.",shape=box,color=blue];
		j3720196419 -> j575027338;
	j955168959 [label="Ora, se solo il mio caro Lyon ne vedesse la luminosità allo stesso modo.",shape=box,color=blue];
		j955168959 -> j575027338;
	j380935233 [label="Ha le sue teorie. ",shape=box,color=blue];
		j380935233 -> j741777660;
	j1818189053 [label="Se esprimessi le tue condoglianze, sono certa che sarebbero ben accette. E, nonostante quanto possa sembrare, apprezzerebbe la compagnia.",shape=box,color=blue];
		j1818189053 -> j1917063636;
	j3613972611 [label="Davvero ? Dovresti dirlo a Lyon. Ha bisogno di sapere che anche altri sono capaci di soffrire in modo simile.",shape=box,color=blue];
		j3613972611 -> j2931004851;
	j2882643356 [label="Boolean Migraine is now true.",color=orange];
		j2882643356 -> j2435000177;
	j2435000177 [label="Non importa il nome, Lyon è prostrato da una e lo sarà fino a domattina. Il pover'uomo non riesce a vedere altro che una macchia confusa, né a sentire mani o piedi. E mi dice che il dolore è insopportabile.",shape=box,color=blue];
		j2435000177 -> j547018639;
	j575027338 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j575027338 -> j320840372;
	j741777660 [label="Anche se forse sarebbe più corretto dire che aveva le sue teorie, fino a poco tempo fa.",shape=box,color=blue];
		j741777660 -> j2246331036;
	j1917063636 [label="Anche se il suo atteggiamento potrebbe cercare di dissuaderti, ti imploro di tenere duro, Drifter. C'è un uomo con un grande bisogno nascosto sotto quella che sembra un'apparenza stoica e di pietra.",shape=box,color=blue];
		j1917063636 -> j3013973783;
		j1917063636 -> j2331355846;
		j1917063636 -> j3646260415;
	j2931004851 [label="+5 Chemistry",color=orange];
		j2931004851 -> j2152187593;
	j320840372 [label="Ah, a proposito. Mi sento malissimo a lamentarmi dei mal di testa. Devo portare la cena a Lyon stasera, è di nuovo a letto con una terribile cefalea.",shape=box,color=blue];
		j320840372 -> j3726777982;
		j320840372 -> j3089963265;
	j2246331036 [label="Boolean MarieLyonFaith1 is now true.",color=orange];
		j2246331036 -> j1917063636;
	j3013973783 [label="Posso essere estremamente testardo. Non preoccuparti.",shape=box,color=red];
		j3013973783 -> j2145237039;
	j2331355846 [label="Ho già un Uomo nel Muro... perché non due?",shape=box,color=red];
		j2331355846 -> j728229464;
	j3646260415 [label="È un adulto. Se vuole parlare, può farlo.",shape=box,color=red];
		j3646260415 -> j3232732700;
	j2152187593 [label="I Luminari sanno che altrimenti soffrirebbe volentieri da solo...",shape=box,color=blue];
		j2152187593 -> j2621816282;
	j2145237039 [label="+5 Chemistry",color=orange];
		j2145237039 -> j181262987;
	j728229464 [label="Scherza pure con me in questo modo, ma non fare simili commenti a lui. L'argomento della tua Indifférence è un argomento doloroso per lui.",shape=box,color=blue];
		j728229464 -> j3123395008;
	j3232732700 [label="È cresciuto, sì. È un uomo, sì. E credo che voglia parlare. Ma ti sfido a chiederti se può parlare.",shape=box,color=blue];
		j3232732700 -> j2233871350;
	j2621816282 [label="Boolean MarieLyonSuffering2 is now true.",color=orange];
		j2621816282 -> j1917063636;
	j181262987 [label="Temo che ne avrai bisogno con lui. Grazie, Drifter. È il mio più caro amico, un fratello per me. E mi spezza il cuore vederlo soffrire così tanto.",shape=box,color=blue];
		j181262987 -> j2484245750;
	j3123395008 [label="Sii resiliente. E paziente. E gentile. È come un fratello per me ed è il mio più caro amico, Drifter. E mi spezza il cuore vederlo soffrire così tanto.",shape=box,color=blue];
		j3123395008 -> j2484245750;
	j2233871350 [label="Non tutti siamo ugualmente dotati o pensiamo di aver diritto a queste cose. Lui soffre e crede che sia il suo destino soffrire.",shape=box,color=blue];
		j2233871350 -> j3679761156;
	j2484245750 [label="Ci risentiamo presto. Par la grâce de Sol.",shape=box,color=blue];
		j2484245750 -> "Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j3679761156 [label="È anche come un fratello per me ed è il mio più caro amico. E il mio cuore si spezza per lui. Quindi posso solo chiederti di... essere paziente. E gentile. Se ne sei capace.",shape=box,color=blue];
		j3679761156 -> j2484245750;
	"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
