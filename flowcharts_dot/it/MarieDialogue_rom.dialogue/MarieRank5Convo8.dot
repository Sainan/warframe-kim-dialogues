	j1749563290 [label="Oui, qu'est-ce qu'il y a ?",shape=box,color=blue];
		j1749563290 -> j2499379772;
	"Chat ends." [color=orange];
	j1076958955 [label="Temo che ora dovrò chiamarlo il 'nostro' diavolo, non ? Perché non se ne andrà tanto presto. Ah !",shape=box,color=blue];
		j1076958955 -> j2841123398;
	j3752819722 [label="Dovrei farti io questa domanda, non ? Sei tu quello che ora se la spassa con lui !",shape=box,color=blue];
		j3752819722 -> j4290027225;
	j2159536263 [label="Non so come ci sei riuscito. Ma lui ci ha detto la verità sull'assunzione del siero.",shape=box,color=blue];
		j2159536263 -> j2221525565;
	j494439086 [label="Non so come ci sei riuscito. Ma lui ci ha detto la verità sull'assunzione del sérum.",shape=box,color=blue];
	j1422745359 [label="Mi preoccupo per lui. Credo che si faccia più male di quanto lasci trasparire, n'est-ce pas?",shape=box,color=blue];
		j1422745359 -> j265806105;
	j2499379772 [label="Mi dispiace se sembra che tutto questo arrivi dal nulla, ma non sapevo come dirtelo.",shape=box,color=red];
		j2499379772 -> j2749278060;
	j2841123398 [label="Hai fatto bene a chiedergli aiuto per il Monsieur Loid. Non pensavo che fosse possibile riuscirci.",shape=box,color=blue];
		j2841123398 -> j3065311737;
	j4290027225 [label="Sto resistendo alla tentazione di chiederti toutes sortes de commérages.",shape=box,color=blue];
		j4290027225 -> j3065311737;
	j2221525565 [label="Sol, mi ha spezzato il cuore. La sua voce non ha vacillato quando ha parlato. Mais je l'ai vu dans ses yeux.",shape=box,color=blue];
		j2221525565 -> j3065311737;
	j265806105 [label="Mi spezza il cuore. Spero che un giorno non gli si spezzi nel petto. Non so se sopravviverà. Non so se noi ci riusciremo.",shape=box,color=blue];
		j265806105 -> "Chat ends.";
	j2749278060 [label="Ti adoro. Semplicemente ti adoro.",shape=box,color=red];
		j2749278060 -> j123300629;
	j3065311737 [label="C'è stato un cambiamento in lui. Leggero, ma c'è stato. ",shape=box,color=blue];
		j3065311737 -> j2586282755;
	j123300629 [label="Beh, mi chiedevo... se ti piacerebbe, beh... diventare una coppia?",shape=box,color=red];
		j123300629 -> j2298753926;
	j2586282755 [label="+5 Chemistry",color=orange];
		j2586282755 -> j4266470876;
	j2298753926 [label="Evaluate expressions",color=orange];
		j2298753926 -> j3282775883 [label="MarieNoDate",color=purple];
		j2298753926 -> j1663499071 [label="MarieWillDate",color=purple];
		j2298753926 -> j3282775883 [label="false",color=purple];
	j4266470876 [label="Per questo so che dobbiamo ringraziare te.",shape=box,color=blue];
		j4266470876 -> j4213256383;
	j3282775883 [label="Oh ! Oh, Drifter. Non so come dirlo, quindi lo dirò senza mezzi termini. ",shape=box,color=blue];
		j3282775883 -> j617350017;
	j1663499071 [label="Oh, i miei sentimenti sono gli stessi ! Mais je ne sais pas comment te l'écrire, je n'ose pas taper les mots ! Mi sono considerata una pazza anche solo a pensarle !",shape=box,color=blue];
		j1663499071 -> j1540242540;
	j4213256383 [label="Non so se lo accoglierà con favore, ma avrà sempre l'amicizia.",shape=box,color=blue];
		j4213256383 -> j2267053310;
	j617350017 [label="Non.",shape=box,color=blue];
		j617350017 -> "Chat ends.";
	j1540242540 [label="Ah ! Mi hai resa così felice !",shape=box,color=blue];
		j1540242540 -> j3810712973;
	j2267053310 [label="Anche se penso che non mi stancherò mai di urlargli contro !",shape=box,color=blue];
		j2267053310 -> j659834236;
		j2267053310 -> j4234516779;
	j3810712973 [label="Se stai chiedendo un corteggiamento più... formale, allora oui ! Oui ! Mi piacerebbe.",shape=box,color=blue];
		j3810712973 -> j2028721482;
		j3810712973 -> j1835850689;
	j659834236 [label="E comunque, penso che si diverta troppo a farti impazzire.",shape=box,color=red];
		j659834236 -> j3861871347;
	j4234516779 [label="Sono felice che abbiate trovato una sorta di affinità.",shape=box,color=red];
		j4234516779 -> j4265900488;
	j2028721482 [label="Sicuramente non propongo il matrimonio, non ancora. ",shape=box,color=red];
		j2028721482 -> j1515674573;
	j1835850689 [label="Le cose si sono decisamente evolute un po'. Non direi che sono più \"formali\", ma sono sicuramente felice di... mostrarti come.",shape=box,color=red];
		j1835850689 -> j1244905382;
	j3861871347 [label="Comme un gros chat de gouttière. Mi sono abituata a lui.",shape=box,color=blue];
		j3861871347 -> j1377068616;
	j4265900488 [label="Oui ! Anche io. Diventa ogni giorno un po' meno insopportabile.",shape=box,color=blue];
		j4265900488 -> j3861871347;
	j1515674573 [label="Ora sono io a stuzzicarti, non preoccuparti. Ma, in ogni caso, je suis ravie ! E non vedo l'ora di imparare queste nuove... usanze romantiques.",shape=box,color=blue];
		j1515674573 -> j1935526046;
	j1244905382 [label="Aha ! So quando sei cattivello. Beh, non vedo l'ora.",shape=box,color=blue];
		j1244905382 -> j1935526046;
	j1377068616 [label="Penso che sarei triste se se ne andasse.",shape=box,color=blue];
		j1377068616 -> "Chat ends.";
