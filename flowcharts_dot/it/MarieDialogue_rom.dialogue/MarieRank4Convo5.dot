	j1591513074 [label="+15 Chemistry",color=orange];
		j1591513074 -> j3971196767;
	j2475096651 [label="Non ! È un bugiardo, un manipolatore, lo farebbe solo in cambio di una bella ricompensa !",shape=box,color=blue];
		j2475096651 -> j1755546164;
	j2191746985 [label="La situazione al piano di sopra è... fragile anche nei giorni migliori. Non voglio turbarli.",shape=box,color=red];
