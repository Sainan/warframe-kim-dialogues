		j2515192195 -> j839416426 [label="MarieEntratiNeutral",color=purple];
		j2515192195 -> j867447733 [label="false",color=purple];
	j3623815134 [label="E con cosa potresti mai esserti distratto ? Cosa potrebbe essere più importante che sedersi e analizzare le lamentele di mécontents ?",shape=box,color=blue];
		j3623815134 -> j703311738;
	j1085361465 [label="Cosa potrebbe esserci di difficile nel sedersi e analizzare le lamentele di mécontents ?",shape=box,color=blue];
		j1085361465 -> j3721639332;
	j195998749 [label="Oh, magnifique !",shape=box,color=blue];
		j195998749 -> j1502660544;
	j2627305383 [label="Sua figlia, Euleria - detta Madre, e la sua famiglia, si sono presi cura di Deimos per tutto questo tempo.",shape=box,color=red];
		j2627305383 -> j2676513953;
	j3984081955 [label="Cosa ci impedisce di spostare semplicemente tutti i mobili, lasciare che li sostituiscano tutti e poi... ricominciare da capo ? Potremmo vendere tutto e guadagnare de ce mobilier étrange !",shape=box,color=blue];
		j3984081955 -> j609950349;
		j3984081955 -> j151856084;
		j3984081955 -> j4076477456;
	j1461240193 [label="Sono ben consapevole dei nostri disaccordi irrisolti riguardo le Cardinal. Cerco di mantenere questa conversazione civilisée.",shape=box,color=blue];
		j1461240193 -> j673498197;
	j1313665677 [label="Capisco che tu non voglia discutere di come riparare le fratture senza trovare l'occasione per puntare il dito contro coloro che ritieni siano i colpevoli.",shape=box,color=blue];
		j1313665677 -> j673498197;
	j2186513853 [label="Oui ! Come spesso mi ricordi, lo ritieni un monstre ! Con nient'altro che rancore e vuoto nel cuore !",shape=box,color=blue];
		j2186513853 -> j673498197;
	j683486812 [label="Pensavo fossi dalla mia parte in questa guerra per l'anima de le Cardinal ?",shape=box,color=blue];
		j683486812 -> j3130368827;
	j514860130 [label="Pensavo che non avessi ancora preso una decisione su le Cardinal. Oppure ora le cose sono cambiate ?",shape=box,color=blue];
		j514860130 -> j3282004173;
		j514860130 -> j1328007489;
	j2503882868 [label="Sì. Questo lo sto imparando con M'sieur Tagfer...",shape=box,color=blue];
		j2503882868 -> j58204267;
	j993190931 [label="Non parlarmi di ferite aperte, lupo. Mi sto ancora leccando le mie dall'ultima discussione su le Cardinal.",shape=box,color=blue];
		j993190931 -> j673498197;
	j2826021453 [label="Oui, ma l'hai già detto prima - dobbiamo smettere di incolparci a vicenda per le ferite che subiamo.",shape=box,color=blue];
		j2826021453 -> j18623015;
	j1628646904 [label="So che credi che le Cardinal sia una specie di mostro orribile per aver causato simili ferite.",shape=box,color=blue];
		j1628646904 -> j673498197;
	j351688554 [label="So che sei dalla mia parte in questa guerra per l'anima de le Cardinal, e te ne sarò per sempre grata.",shape=box,color=blue];
		j351688554 -> j1362050109;
	j839416426 [label="So che non vuoi esprimere alcun giudizio su di lui, e per questo ti sono immensamente grata.",shape=box,color=blue];
		j839416426 -> j1362050109;
	j1362050109 [label="E anche se so che gli altri sono pronti a dargli la colpa, non voglio vederci divisi e sanguinanti quando potremmo essere uniti.",shape=box,color=blue];
		j1362050109 -> j885446860;
	j2605730051 [label="Oui, anche se sto imparando - come nel caso di M'sieur Tagfer - che forse non tutti lo fanno nella stessa misura.",shape=box,color=blue];
		j2605730051 -> j58204267;
	j2354402899 [label="E sto imparando che non è tutto nella stessa misura, come sei stato così \"gentile\" da farmi notare, non ?",shape=box,color=blue];
		j2354402899 -> j673498197;
	j2980510171 [label="Oui, sì ! Anche se non biasimo le Cardinal per essersene andato, perché il suo lavoro è sacro -",shape=box,color=blue];
		j2980510171 -> j1362050109;
	j2968781852 [label="E so che credi che le Cardinal sia una specie di mostro orribile per aver causato simili ferite.",shape=box,color=blue];
		j2968781852 -> j673498197;
	j867447733 [label="E mentre gli altri sono pronti a incolparlo per il loro dolore, io semplicemente non voglio vederci divisi e sofferenti.",shape=box,color=blue];
		j867447733 -> j885446860;
	j703311738 [label="Ti prendo in giro, ti prendo in giro! Non riesco a immaginare quanto tu sia impegnato e in quanti posti e momenti sei necessario.",shape=box,color=blue];
		j703311738 -> j1502660544;
	j3721639332 [label="Ti prendo in giro, ti prendo in giro! Non posso capire cosa abbiano sopportato. E quanto sia difficile per te risolverlo.",shape=box,color=blue];
		j3721639332 -> j1502660544;
	j1502660544 [label="Mi preoccupa semplicemente il fatto che, senza la soluzione dei loro problemi, non potremmo mai sperare di essere i benvenuti alla loro tavola. Il problema più grande rimane irrisolto -",shape=box,color=blue];
		j1502660544 -> j3174700332;
	j2676513953 [label="Vegliando su questo posto e sul cuore che pompa l'energia del Void nel Sistema Origin, mantenendoci tutti... utilizzabili, in realtà, da quando Entrati se n'è andato.",shape=box,color=red];
		j2676513953 -> j865644957;
	j609950349 [label="Non so se c'è un grande mercato per le sedie di Entrati...",shape=box,color=red];
		j609950349 -> j2008082595;
	j151856084 [label="Non finiremmo per saturare eventualmente il mercato? Dovremmo venderli a un prezzo piuttosto basso...",shape=box,color=red];
		j151856084 -> j2008082595;
	j4076477456 [label="Superlativo. Non vedo alcun problema in questo.",shape=box,color=red];
		j4076477456 -> j1212957198;
	j673498197 [label="E anche se capisco che i due argomenti sono inesorabilmente collegati, ti chiederei di essere produttivo oggi, oui ?",shape=box,color=blue];
		j673498197 -> j2318969431;
	j3130368827 [label="Qual è questo tuo inganno, lupo ? O la piccola Marie è solo un gioco per te ?",shape=box,color=blue];
		j3130368827 -> j2615569543;
		j3130368827 -> j1328007489;
	j3282004173 [label="Non ho ancora deciso se le sue azioni siano necessarie. Ma la sua natura insensibile non può essere messa in discussione.",shape=box,color=red];
		j3282004173 -> j673498197;
	j1328007489 [label="Sono stanco di fingere, mi dispiace.",shape=box,color=red];
		j1328007489 -> j4174581872;
	j58204267 [label="Dobbiamo smettere di incolparci a vicenda per le ferite che subiamo.",shape=box,color=blue];
		j58204267 -> j18623015;
	j18623015 [label="Non sono d'accordo nemmeno nel dare la colpa a le Cardinal, sia chiaro, ma non vorrei vederci divisi e sanguinanti quando potremmo essere uniti.",shape=box,color=blue];
		j18623015 -> j2143957007;
		j18623015 -> j2133257282;
	j885446860 [label="Dobbiamo smettere di incolparci a vicenda per le ferite che subiamo, indipendentemente da chi sia in ultima analisi il colpevole.",shape=box,color=blue];
		j885446860 -> j2143957007;
		j885446860 -> j2133257282;
	j865644957 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j865644957 -> j1520045797 [label=true,color=green];
		j865644957 -> j2772467325 [label=false,color=brown];
	j2008082595 [label="Pff ! Penso comunque che questo sia un esperimento degno di nota. Forse possiamo isolare il diavolo in un mare di librerie !",shape=box,color=blue];
		j2008082595 -> j1429538983;
	j1212957198 [label="Ignorerò diligentemente il tuo sarcasmo, perché penso che questo sia un esperimento degno di nota. Forse possiamo isolare il diavolo in un mare di librerie !",shape=box,color=blue];
		j1212957198 -> j1429538983;
	j2318969431 [label="Cerco di aiutarci tutti in questa... strana convivenza in cui ci siamo trovati, non di discutere.",shape=box,color=blue];
		j2318969431 -> j58204267;
	j2615569543 [label="No, non sei un gioco. Ma di Entrati non ci si può fidare, e non so in quale altro modo convincerti se non fingendo di essere dalla tua parte.",shape=box,color=red];
		j2615569543 -> j3543687579;
	j4174581872 [label="Oui ? Beh, sono lieta di dirti, che non è più necessario.",shape=box,color=blue];
		j4174581872 -> j1509439757;
	j2143957007 [label="Insieme, tutti come una cosa sola, siamo... una strana famiglia. Ma pur sempre una famiglia.",shape=box,color=red];
		j2143957007 -> j1625808289;
	j2133257282 [label="Insieme saremmo più forti che separati.",shape=box,color=red];
		j2133257282 -> j2651065267;
		j2133257282 -> j213103911;
	j1520045797 [label="Lei ha accettato la sua assenza e hanno fatto pace, ma è stato veramente difficile arrivare a questa conclusione.",shape=box,color=red];
		j1520045797 -> j3262002702;
	j2772467325 [label="Lei non ha ancora accettato la sua assenza, e continuano a litigare.",shape=box,color=red];
		j2772467325 -> j1381657014;
	j1429538983 [label="+20 Chemistry",color=orange];
		j1429538983 -> j504270276;
	j3543687579 [label="Oui ? Bene, sono lieta di dirti che hai fallito.",shape=box,color=blue];
		j3543687579 -> j1509439757;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j1625808289 [label="Add +1 to Family counter",color=orange];
		j1625808289 -> j2651065267;
		j1625808289 -> j213103911;
	j2651065267 [label="E nei momenti in cui soffriamo, a volte tutto ciò che abbiamo veramente è l'un l'altro. O quello che ci è stato dato, o quello che abbiamo trovato.",shape=box,color=red];
		j2651065267 -> j2376057331;
	j213103911 [label="Non so se a lungo termine potrebbe aiutare o danneggiare. Ma anche questo... purgatorio non va bene.",shape=box,color=red];
		j213103911 -> j537169954;
	j3262002702 [label="Sapere che lui è ancora là fuori, da qualche parte, e che non le ha detto una parola, né le ha mandato una lettera...?",shape=box,color=red];
		j3262002702 -> j1760706207;
	j1381657014 [label="Sapere che lui è ancora là fuori, da qualche parte, e che non le ha detto una parola, né le ha mandato una lettera...?",shape=box,color=red];
		j1381657014 -> j1241701042;
	j504270276 [label="Ho molto da fare ! À la revoyure !",shape=box,color=blue];
		j504270276 -> "Chat ends.";
	j2631316640 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j2631316640 -> j1508231473;
	j2376057331 [label="Add +1 to Family counter",color=orange];
		j2376057331 -> j537169954;
	j537169954 [label="Oui, sono d'accordo. Ma non posso essere io a colmare il divario tra noi. Non so come fare ! Per loro lassù sono un'estranea...",shape=box,color=blue];
		j537169954 -> j4175668775;
		j537169954 -> j1369306818;
	j1760706207 [label="Non riesco a immaginare quanto doloroso posse essere per lei. Per loro.",shape=box,color=red];
		j1760706207 -> j3535685419;
	j1241701042 [label="Ciò distruggerebbe le poche possibilità di riconciliazione che potrebbero avere.",shape=box,color=red];
		j1241701042 -> j3094929708;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j4175668775 [label="Loid conosceva la famiglia Entrati. Dovrebbe essere lui. Convincerlo, però... è un'altra questione.",shape=box,color=red];
		j4175668775 -> j1796774619;
	j1369306818 [label="Forse, Roathe? È Orokin, li conosceva tutti.",shape=box,color=red];
		j1369306818 -> j1750365967;
	j3535685419 [label="Anche se capisco la logica dietro la decisione di proteggerli dal dolore che le Cardinal ha causato con la sua necessaria dipartita...",shape=box,color=blue];
		j3535685419 -> j3282719324;
	j3094929708 [label="Oui... capisco la logica. Allora, mi impegnerei a rimettere insieme la loro famiglia, se puoi, non ? Sembra essere l'unica speranza che abbiamo per uscire da questo posto. ",shape=box,color=blue];
		j3094929708 -> j1529609924;
	j1796774619 [label="+5 Chemistry",color=orange];
		j1796774619 -> j1269445841;
	j1750365967 [label="No, non il diavolo - chiunque tranne il diavolo. Ma hai ragione. La scelta naturale è Monsieur Loid, non ?",shape=box,color=blue];
		j1750365967 -> j2565029531;
	j3282719324 [label="Penso che sia inutilmente crudele, non credi ? Potrebbero crederlo morto. O peggio ! E noi, viviamo qui, comme des rats d'égout ?",shape=box,color=blue];
		j3282719324 -> j1361973091;
		j3282719324 -> j592781501;
		j3282719324 -> j57377297;
	j1529609924 [label="Per non passare il resto della nostra vita intrappolati qui, comme des rats d'égout. ",shape=box,color=blue];
		j1529609924 -> j2209065159;
		j1529609924 -> j3331110039;
	j1269445841 [label="Oui, oui ! C'est ça ! Ma come lo convinciamo ? È abbastanza convinto della sua posizione, non ?",shape=box,color=blue];
		j1269445841 -> j1321881275;
		j1269445841 -> j857151011;
	j2565029531 [label="Ma come lo convinciamo ? È abbastanza convinto della sua posizione, non ?",shape=box,color=blue];
		j2565029531 -> j857151011;
		j2565029531 -> j1321881275;
	j1361973091 [label="In realtà ho un'amica che adora i ratti. Li trovo adorabili.",shape=box,color=red];
		j1361973091 -> j4206510917;
	j592781501 [label="Non spetta a me prendere questa decisione.",shape=box,color=red];
		j592781501 -> j1579344446;
	j57377297 [label="Cosa mi suggerisci di fare?",shape=box,color=red];
		j57377297 -> j1400365783;
	j2209065159 [label="In realtà ho un'amica che adora i ratti. Li trovo adorabili. ",shape=box,color=red];
		j2209065159 -> j4206510917;
	j3331110039 [label="Sono stato negligente. Hai ragione. Mi metterò al lavoro.",shape=box,color=red];
		j3331110039 -> j121914084;
	j1321881275 [label="Pensi che tu o Lyon potreste convincerlo?",shape=box,color=red];
		j1321881275 -> j3883154580;
	j857151011 [label="Non ti piacerà la mia risposta, Marie...",shape=box,color=red];
		j857151011 -> j4229824912;
	j4206510917 [label="E mi piacerebbe tanto incontrarli un giorno, ma non è questo il punto, sciocco lupo.",shape=box,color=blue];
		j4206510917 -> j1400365783;
	j1579344446 [label="Lo so. Manifestarsi a loro è una decisione del Monsieur Loid, e di tutti gli altri.",shape=box,color=blue];
		j1579344446 -> j1400365783;
	j1400365783 [label="Direi che è un senso di colpa, non di nobiltà, a trattenerci qui.",shape=box,color=blue];
		j1400365783 -> j1731521675;
	j121914084 [label="Grazie. Non so se ci riuscirai, ma a volte, l'unica cosa che possiamo fare è provare.",shape=box,color=blue];
		j121914084 -> j1400365783;
	j3883154580 [label="Gli piacciamo abbastanza, è gentile e delicato. Ma per lui siamo degli estranei, dei nuovi arrivati.",shape=box,color=blue];
		j3883154580 -> j3350857763;
	j4229824912 [label="Ah bon ?",shape=box,color=blue];
		j4229824912 -> j1974998780;
	j1731521675 [label="Che nascondiamo qualche grande e terribile peccato.",shape=box,color=blue];
		j1731521675 -> j2176264088;
	j3350857763 [label="Ci penserò. E tu fai lo stesso ! Troveremo una soluzione, Sol ci ha guidato fin qui !",shape=box,color=blue];
		j3350857763 -> j1591513074;
	j1974998780 [label="Loid potrebbe dare ascolto a Roathe. Il fatto che lui sia Orokin - ovvero che abbiano una storia in comune - potrebbe tornare utile in questo caso.",shape=box,color=red];
		j1974998780 -> j2475096651;
	j2176264088 [label="Ed è proprio questo peccato che deve essere perdonato o, forse, dimostrato falso ?",shape=box,color=blue];
