	1647 [label="[Fine.]",shape=box,color=red];
		1647 -> 1655;
	1648 [label="Par les Luminaires... Vuoi dire che siamo tutti qui in segreto ?! È per questo che non ci è permesso lasciare questo posto ?! Mais pourquoi ?!",shape=box,color=blue];
		1648 -> 1656;
	2936 [label="Oui ! Ha ! Sono molto insistenti nel sostituire i mobili, non ? Ma ho scoperto che se sposti le cose... fanno la stessa cosa.",shape=box,color=blue];
