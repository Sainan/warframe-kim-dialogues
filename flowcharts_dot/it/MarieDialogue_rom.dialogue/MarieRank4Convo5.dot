		1654 -> 1678;
	1655 [label="Chat ends.",color=orange];
	1656 [label="Sua figlia, Euleria - detta Madre, e la sua famiglia, si sono presi cura di Deimos per tutto questo tempo.",shape=box,color=red];
		1656 -> 1679;
	2937 [label="Cosa ci impedisce di spostare semplicemente tutti i mobili, lasciare che li sostituiscano tutti e poi... ricominciare da capo ? Potremmo vendere tutto e guadagnare de ce mobilier étrange !",shape=box,color=blue];
		2937 -> 2938;
		2937 -> 2939;
		2937 -> 2940;
	1658 [label="Sono ben consapevole dei nostri disaccordi irrisolti riguardo le Cardinal. Cerco di mantenere questa conversazione civilisée.",shape=box,color=blue];
		1658 -> 1680;
	1661 [label="Capisco che tu non voglia discutere di come riparare le fratture senza trovare l'occasione per puntare il dito contro coloro che ritieni siano i colpevoli.",shape=box,color=blue];
		1661 -> 1680;
	1657 [label="Oui ! Come spesso mi ricordi, lo ritieni un monstre ! Con nient'altro che rancore e vuoto nel cuore !",shape=box,color=blue];
		1657 -> 1680;
	1659 [label="Pensavo fossi dalla mia parte in questa guerra per l'anima de le Cardinal ?",shape=box,color=blue];
		1659 -> 1681;
	1660 [label="Pensavo che non avessi ancora preso una decisione su le Cardinal. Oppure ora le cose sono cambiate ?",shape=box,color=blue];
		1660 -> 1682;
		1660 -> 1683;
	1668 [label="Sì. Questo lo sto imparando con M'sieur Tagfer...",shape=box,color=blue];
		1668 -> 1686;
	1662 [label="Non parlarmi di ferite aperte, lupo. Mi sto ancora leccando le mie dall'ultima discussione su le Cardinal.",shape=box,color=blue];
		1662 -> 1680;
	1663 [label="Oui, ma l'hai già detto prima - dobbiamo smettere di incolparci a vicenda per le ferite che subiamo.",shape=box,color=blue];
		1663 -> 1684;
	1664 [label="So che credi che le Cardinal sia una specie di mostro orribile per aver causato simili ferite.",shape=box,color=blue];
		1664 -> 1680;
	1665 [label="So che sei dalla mia parte in questa guerra per l'anima de le Cardinal, e te ne sarò per sempre grata.",shape=box,color=blue];
		1665 -> 1666;
	1667 [label="So che non vuoi esprimere alcun giudizio su di lui, e per questo ti sono immensamente grata.",shape=box,color=blue];
		1667 -> 1666;
	1666 [label="E anche se so che gli altri sono pronti a dargli la colpa, non voglio vederci divisi e sanguinanti quando potremmo essere uniti.",shape=box,color=blue];
		1666 -> 1685;
	1675 [label="Oui, anche se sto imparando - come nel caso di M'sieur Tagfer - che forse non tutti lo fanno nella stessa misura.",shape=box,color=blue];
		1675 -> 1686;
	1669 [label="E sto imparando che non è tutto nella stessa misura, come sei stato così \"gentile\" da farmi notare, non ?",shape=box,color=blue];
		1669 -> 1680;
	1670 [label="Oui, sì ! Anche se non biasimo le Cardinal per essersene andato, perché il suo lavoro è sacro -",shape=box,color=blue];
		1670 -> 1666;
	1671 [label="E so che credi che le Cardinal sia una specie di mostro orribile per aver causato simili ferite.",shape=box,color=blue];
		1671 -> 1680;
	1672 [label="So che sei dalla mia parte in questa guerra per l'anima de le Cardinal, e te ne sarò per sempre grata.",shape=box,color=blue];
		1672 -> 1666;
	1673 [label="So che non vuoi esprimere alcun giudizio su di lui, e per questo ti sono immensamente grata.",shape=box,color=blue];
		1673 -> 1666;
	1674 [label="E mentre gli altri sono pronti a incolparlo per il loro dolore, io semplicemente non voglio vederci divisi e sofferenti.",shape=box,color=blue];
		1674 -> 1685;
	1676 [label="Ti prendo in giro, ti prendo in giro! Non riesco a immaginare quanto tu sia impegnato e in quanti posti e momenti sei necessario.",shape=box,color=blue];
		1676 -> 1678;
	1677 [label="Ti prendo in giro, ti prendo in giro! Non posso capire cosa abbiano sopportato. E quanto sia difficile per te risolverlo.",shape=box,color=blue];
		1677 -> 1678;
	1678 [label="Mi preoccupa semplicemente il fatto che, senza la soluzione dei loro problemi, non potremmo mai sperare di essere i benvenuti alla loro tavola. Il problema più grande rimane irrisolto -",shape=box,color=blue];
		1678 -> 1637;
	1679 [label="Vegliando su questo posto e sul cuore che pompa l'energia del Void nel Sistema Origin, mantenendoci tutti... utilizzabili, in realtà, da quando Entrati se n'è andato.",shape=box,color=red];
		1679 -> 1687;
	2938 [label="Non so se c'è un grande mercato per le sedie di Entrati...",shape=box,color=red];
		2938 -> 2942;
	2939 [label="Non finiremmo per saturare eventualmente il mercato? Dovremmo venderli a un prezzo piuttosto basso...",shape=box,color=red];
		2939 -> 2942;
	2940 [label="Superlativo. Non vedo alcun problema in questo.",shape=box,color=red];
		2940 -> 2941;
	1680 [label="E anche se capisco che i due argomenti sono inesorabilmente collegati, ti chiederei di essere produttivo oggi, oui ?",shape=box,color=blue];
		1680 -> 1688;
	1681 [label="Qual è questo tuo inganno, lupo ? O la piccola Marie è solo un gioco per te ?",shape=box,color=blue];
		1681 -> 1689;
		1681 -> 1683;
	1682 [label="Non ho ancora deciso se le sue azioni siano necessarie. Ma la sua natura insensibile non può essere messa in discussione.",shape=box,color=red];
		1682 -> 1680;
	1683 [label="Sono stanco di fingere, mi dispiace.",shape=box,color=red];
		1683 -> 1690;
	1686 [label="Dobbiamo smettere di incolparci a vicenda per le ferite che subiamo.",shape=box,color=blue];
		1686 -> 1684;
	1684 [label="Non sono d'accordo nemmeno nel dare la colpa a le Cardinal, sia chiaro, ma non vorrei vederci divisi e sanguinanti quando potremmo essere uniti.",shape=box,color=blue];
		1684 -> 1691;
		1684 -> 1692;
	1685 [label="Dobbiamo smettere di incolparci a vicenda per le ferite che subiamo, indipendentemente da chi sia in ultima analisi il colpevole.",shape=box,color=blue];
