	1641 [label="Hai ragione. Non puoi competere per qualcosa che una persona non è tenuta a dare.",shape=box,color=red];
		1641 -> 1649;
	1642 [label="Aprire ferite è pericoloso. Potresti liberarti di un'infezione... o potresti dissanguarti nel farlo.",shape=box,color=red];
		1642 -> 1650;
	1643 [label="Voi - noi - abbiamo tutti una cosa in comune. A un certo punto, siamo stati abbandonati da Entrati.",shape=box,color=red];
		1643 -> 1651;
	1644 [label="Onestamente? Mi sono distratto.",shape=box,color=red];
		1644 -> 1652;
	1645 [label="Potrebbe andare meglio.",shape=box,color=red];
