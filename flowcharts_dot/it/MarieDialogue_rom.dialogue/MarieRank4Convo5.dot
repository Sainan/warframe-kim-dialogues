		j1996382955 -> j3174700332 [label=true,color=green];
		j1996382955 -> j3525180761 [label=false,color=brown];
	j1636646580 [label="Beh... in breve, di sopra ci sono alcuni membri della famiglia Entrati, e non sono... esattamente consapevoli che siamo qui sotto.",shape=box,color=red];
		j1636646580 -> j2841047592;
	j1316002010 [label="Oui ! I piccoli robot volanti. I necra... necra... Come li chiami ?",shape=box,color=blue];
		j1316002010 -> j1322237896;
	"Chat ends." [color=orange];
	j3174700332 [label="Non competiamo per l'amore de le Cardinal, come possiamo aiutarli a capirlo ?",shape=box,color=blue];
		j3174700332 -> j2669957625;
		j3174700332 -> j1616472006;
		j3174700332 -> j3906365192;
	j3525180761 [label="Come procede il tuo lavoro nel risolvere i loro conflitti interiori ?",shape=box,color=blue];
		j3525180761 -> j2254306767;
		j3525180761 -> j1704172769;
		j3525180761 -> j4038719187;
		j3525180761 -> j4115718638;
	j2841047592 [label="Boolean MarieFamily1 is now true.",color=orange];
		j2841047592 -> j1221602717;
	j1322237896 [label="Necramite?",shape=box,color=red];
		j1322237896 -> j4189211803;
	j2669957625 [label="Hai ragione. Non puoi competere per qualcosa che una persona non è tenuta a dare.",shape=box,color=red];
		j2669957625 -> j380005824;
	j1616472006 [label="Aprire ferite è pericoloso. Potresti liberarti di un'infezione... o potresti dissanguarti nel farlo.",shape=box,color=red];
		j1616472006 -> j2952898253;
	j3906365192 [label="Voi - noi - abbiamo tutti una cosa in comune. A un certo punto, siamo stati abbandonati da Entrati.",shape=box,color=red];
		j3906365192 -> j2515192195;
	j2254306767 [label="Onestamente? Mi sono distratto.",shape=box,color=red];
		j2254306767 -> j3623815134;
	j1704172769 [label="Potrebbe andare meglio.",shape=box,color=red];
		j1704172769 -> j1085361465;
	j4038719187 [label="Sto facendo progressi.",shape=box,color=red];
		j4038719187 -> j195998749;
	j1221602717 [label="Par les Luminaires... Vuoi dire che siamo tutti qui in segreto ?! È per questo che non ci è permesso lasciare questo posto ?! Mais pourquoi ?!",shape=box,color=blue];
		j1221602717 -> j2627305383;
	j4189211803 [label="Oui ! Ha ! Sono molto insistenti nel sostituire i mobili, non ? Ma ho scoperto che se sposti le cose... fanno la stessa cosa.",shape=box,color=blue];
		j4189211803 -> j3984081955;
