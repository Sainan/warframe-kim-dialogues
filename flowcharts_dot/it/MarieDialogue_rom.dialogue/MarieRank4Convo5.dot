	1652 [label="E con cosa potresti mai esserti distratto ? Cosa potrebbe essere più importante che sedersi e analizzare le lamentele di mécontents ?",shape=box,color=blue];
		1652 -> 1676;
	1653 [label="Cosa potrebbe esserci di difficile nel sedersi e analizzare le lamentele di mécontents ?",shape=box,color=blue];
