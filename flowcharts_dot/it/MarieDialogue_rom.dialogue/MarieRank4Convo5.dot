		1685 -> 1692;
	1687 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1687 -> 1693 [label=true,color=green];
		1687 -> 1694 [label=false,color=brown];
	2942 [label="Pff ! Penso comunque che questo sia un esperimento degno di nota. Forse possiamo isolare il diavolo in un mare di librerie !",shape=box,color=blue];
		2942 -> 2943;
	2941 [label="Ignorerò diligentemente il tuo sarcasmo, perché penso che questo sia un esperimento degno di nota. Forse possiamo isolare il diavolo in un mare di librerie !",shape=box,color=blue];
		2941 -> 2943;
	1688 [label="Cerco di aiutarci tutti in questa... strana convivenza in cui ci siamo trovati, non di discutere.",shape=box,color=blue];
		1688 -> 1686;
	1689 [label="No, non sei un gioco. Ma di Entrati non ci si può fidare, e non so in quale altro modo convincerti se non fingendo di essere dalla tua parte.",shape=box,color=red];
		1689 -> 1695;
	1690 [label="Oui ? Beh, sono lieta di dirti, che non è più necessario.",shape=box,color=blue];
		1690 -> 1696;
	1691 [label="Insieme, tutti come una cosa sola, siamo... una strana famiglia. Ma pur sempre una famiglia.",shape=box,color=red];
		1691 -> 1697;
	1692 [label="Insieme saremmo più forti che separati.",shape=box,color=red];
		1692 -> 1698;
		1692 -> 1699;
	1693 [label="Lei ha accettato la sua assenza e hanno fatto pace, ma è stato veramente difficile arrivare a questa conclusione.",shape=box,color=red];
		1693 -> 1700;
	1694 [label="Lei non ha ancora accettato la sua assenza, e continuano a litigare.",shape=box,color=red];
		1694 -> 1701;
	2943 [label="+20 Chemistry",color=orange];
		2943 -> 2944;
	1695 [label="Oui ? Bene, sono lieta di dirti che hai fallito.",shape=box,color=blue];
		1695 -> 1696;
	1696 [label="Update boolean MarieEntratiFan1",color=orange];
		1696 -> 1702;
	1697 [label="Add +1 to Family",color=orange];
		1697 -> 1698;
		1697 -> 1699;
	1698 [label="E nei momenti in cui soffriamo, a volte tutto ciò che abbiamo veramente è l'un l'altro. O quello che ci è stato dato, o quello che abbiamo trovato.",shape=box,color=red];
		1698 -> 1703;
	1699 [label="Non so se a lungo termine potrebbe aiutare o danneggiare. Ma anche questo... purgatorio non va bene.",shape=box,color=red];
		1699 -> 1704;
	1700 [label="Sapere che lui è ancora là fuori, da qualche parte, e che non le ha detto una parola, né le ha mandato una lettera...?",shape=box,color=red];
		1700 -> 1705;
	1701 [label="Sapere che lui è ancora là fuori, da qualche parte, e che non le ha detto una parola, né le ha mandato una lettera...?",shape=box,color=red];
		1701 -> 1706;
	2944 [label="Ho molto da fare ! À la revoyure !",shape=box,color=blue];
		2944 -> 2929;
	1702 [label="Update boolean MarieEntratiFan2",color=orange];
		1702 -> 1707;
	1703 [label="Add +1 to Family",color=orange];
		1703 -> 1704;
	1704 [label="Oui, sono d'accordo. Ma non posso essere io a colmare il divario tra noi. Non so come fare ! Per loro lassù sono un'estranea...",shape=box,color=blue];
		1704 -> 1708;
		1704 -> 1709;
	1705 [label="Non riesco a immaginare quanto doloroso posse essere per lei. Per loro.",shape=box,color=red];
		1705 -> 1710;
	1706 [label="Ciò distruggerebbe le poche possibilità di riconciliazione che potrebbero avere.",shape=box,color=red];
		1706 -> 1711;
	2929 [label="Chat ends.",color=orange];
	1707 [label="Update boolean MarieNoDate",color=orange];
		1707 -> 1712;
	1708 [label="Loid conosceva la famiglia Entrati. Dovrebbe essere lui. Convincerlo, però... è un'altra questione.",shape=box,color=red];
		1708 -> 1713;
	1709 [label="Forse, Roathe? È Orokin, li conosceva tutti.",shape=box,color=red];
		1709 -> 1714;
	1710 [label="Anche se capisco la logica dietro la decisione di proteggerli dal dolore che le Cardinal ha causato con la sua necessaria dipartita...",shape=box,color=blue];
		1710 -> 1715;
	1711 [label="Oui... capisco la logica. Allora, mi impegnerei a rimettere insieme la loro famiglia, se puoi, non ? Sembra essere l'unica speranza che abbiamo per uscire da questo posto. ",shape=box,color=blue];
		1711 -> 1716;
	1712 [label="Chat ends.",color=orange];
	1713 [label="+5 Chemistry",color=orange];
		1713 -> 1717;
	1714 [label="No, non il diavolo - chiunque tranne il diavolo. Ma hai ragione. La scelta naturale è Monsieur Loid, non ?",shape=box,color=blue];
		1714 -> 1718;
	1715 [label="Penso che sia inutilmente crudele, non credi ? Potrebbero crederlo morto. O peggio ! E noi, viviamo qui, comme des rats d'égout ?",shape=box,color=blue];
		1715 -> 1719;
		1715 -> 1720;
		1715 -> 1721;
	1716 [label="Per non passare il resto della nostra vita intrappolati qui, comme des rats d'égout. ",shape=box,color=blue];
		1716 -> 1722;
		1716 -> 1723;
	1717 [label="Oui, oui ! C'est ça ! Ma come lo convinciamo ? È abbastanza convinto della sua posizione, non ?",shape=box,color=blue];
		1717 -> 1724;
		1717 -> 1725;
	1718 [label="Ma come lo convinciamo ? È abbastanza convinto della sua posizione, non ?",shape=box,color=blue];
		1718 -> 1725;
		1718 -> 1724;
	1719 [label="In realtà ho un'amica che adora i ratti. Li trovo adorabili.",shape=box,color=red];
		1719 -> 1726;
	1720 [label="Non spetta a me prendere questa decisione.",shape=box,color=red];
		1720 -> 1727;
	1721 [label="Cosa mi suggerisci di fare?",shape=box,color=red];
		1721 -> 1728;
	1722 [label="In realtà ho un'amica che adora i ratti. Li trovo adorabili. ",shape=box,color=red];
		1722 -> 1729;
	1723 [label="Sono stato negligente. Hai ragione. Mi metterò al lavoro.",shape=box,color=red];
		1723 -> 1730;
	1724 [label="Pensi che tu o Lyon potreste convincerlo?",shape=box,color=red];
		1724 -> 1731;
	1725 [label="Non ti piacerà la mia risposta, Marie...",shape=box,color=red];
		1725 -> 1732;
	1726 [label="E mi piacerebbe tanto incontrarli un giorno, ma non è questo il punto, sciocco lupo.",shape=box,color=blue];
		1726 -> 1728;
	1727 [label="Lo so. Manifestarsi a loro è una decisione del Monsieur Loid, e di tutti gli altri.",shape=box,color=blue];
		1727 -> 1728;
	1728 [label="Direi che è un senso di colpa, non di nobiltà, a trattenerci qui.",shape=box,color=blue];
		1728 -> 1733;
	1729 [label="E mi piacerebbe tanto incontrarli un giorno, ma non è questo il punto, sciocco lupo.",shape=box,color=blue];
		1729 -> 1728;
	1730 [label="Grazie. Non so se ci riuscirai, ma a volte, l'unica cosa che possiamo fare è provare.",shape=box,color=blue];
		1730 -> 1728;
	1731 [label="Gli piacciamo abbastanza, è gentile e delicato. Ma per lui siamo degli estranei, dei nuovi arrivati.",shape=box,color=blue];
		1731 -> 1734;
	1732 [label="Ah bon ?",shape=box,color=blue];
		1732 -> 1735;
	1733 [label="Che nascondiamo qualche grande e terribile peccato.",shape=box,color=blue];
		1733 -> 1736;
	1734 [label="Ci penserò. E tu fai lo stesso ! Troveremo una soluzione, Sol ci ha guidato fin qui !",shape=box,color=blue];
		1734 -> 1737;
	1735 [label="Loid potrebbe dare ascolto a Roathe. Il fatto che lui sia Orokin - ovvero che abbiano una storia in comune - potrebbe tornare utile in questo caso.",shape=box,color=red];
		1735 -> 1738;
	1736 [label="Ed è proprio questo peccato che deve essere perdonato o, forse, dimostrato falso ?",shape=box,color=blue];
		1736 -> 1739;
		1736 -> 1740;
	1737 [label="+15 Chemistry",color=orange];
		1737 -> 1741;
	1738 [label="Non ! È un bugiardo, un manipolatore, lo farebbe solo in cambio di una bella ricompensa !",shape=box,color=blue];
		1738 -> 1742;
	1739 [label="La situazione al piano di sopra è... fragile anche nei giorni migliori. Non voglio turbarli.",shape=box,color=red];
		1739 -> 1743;
	1740 [label="Dobbiamo solo stare attenti. Temo che una metà considererà l'altra come ''l'altra famiglia.''",shape=box,color=red];
		1740 -> 1744;
	1741 [label="Troveremo un modo per convincere Monsieur Loid a salire quelle scale... Lo so.",shape=box,color=blue];
		1741 -> 1745;
	1742 [label="Troveremo un altro modo per convincere Monsieur Loid a salire quelle scale... Lo so.",shape=box,color=blue];
		1742 -> 1746;
	1743 [label="Potrebbe sorprenderti quanto sia resiliente l'anima. E coloro che mi circondano ora sono così vecchi, così temprati dal tempo.",shape=box,color=blue];
		1743 -> 1747;
	1744 [label="Add +1 to Family",color=orange];
		1744 -> 1748;
	1745 [label="Vado. Ho molto a cui pensare, molto da fare. À la revoyure.",shape=box,color=blue];
		1745 -> 1749;
	1746 [label="Vado. Ho molto a cui pensare, molto da fare. À la revoyure.",shape=box,color=blue];
		1746 -> 1750;
	1747 [label="Li hai sorpresi molte volte. Lascia che siano loro a soprenderti questa volta.",shape=box,color=blue];
		1747 -> 1751;
	1748 [label="Oh Sol, credo che tu lo abbia risolto !",shape=box,color=blue];
		1748 -> 1752;
