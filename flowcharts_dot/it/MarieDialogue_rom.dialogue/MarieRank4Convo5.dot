	j15258073 [label="Drifter ! Ho riflettuto.",shape=box,color=blue];
		j15258073 -> j3996147003;
		j15258073 -> j4115718638;
	j4112539726 [label="Drifter ! Ho pensato a quello che hai detto della famiglia sopra di noi. E a come potrebbero vederci come degli intrusi.",shape=box,color=blue];
		j4112539726 -> j319369727;
	j3886595592 [label="Drifter ! Ho ripensato a quello che hai detto della famiglia sopra di noi. Mi si spezza il cuore per loro...",shape=box,color=blue];
		j3886595592 -> j1996382955;
	j3154473801 [label="Perché non possiamo andare di sopra ? Perché non possiamo parlare con coloro che hanno chiamato le Cardinal famille ?",shape=box,color=blue];
		j3154473801 -> j1636646580;
		j3154473801 -> j4115718638;
	j3996147003 [label="Mi devo preoccupare?",shape=box,color=red];
		j3996147003 -> j1316002010;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j319369727 [label="Tipo l'''altra famiglia'' in compétition, oui ? Mi turba molto.",shape=box,color=blue];
		j319369727 -> j1996382955;
