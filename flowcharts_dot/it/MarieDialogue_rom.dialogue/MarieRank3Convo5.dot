		1302 -> 1311;
	1297 [label="Allora non mi intrometterò. So che a volte è difficile esprimere le cose a parole.",shape=box,color=blue];
		1297 -> 1306;
	1298 [label="C'era una Suora alla Cathédrale molto simile. Si agitava, si agitava e agitava. Una volta l'ho trovata a lucidare l'argento alle tre del mattino.",shape=box,color=blue];
		1298 -> 1307;
	1299 [label="Ah, oui. Credo di sapere di cosa stai parlando. Una specie di... nuvola, che copre il sole.",shape=box,color=blue];
		1299 -> 1308;
	1300 [label="Come una tazza che si riempie d'acqua, una goccia alla volta, non ?",shape=box,color=blue];
		1300 -> 1309;
	1303 [label="Non c'era bisogno che mi dicessi una cosa del genere per conoscermi.",shape=box,color=blue];
		1303 -> 1312;
	1304 [label="Je ne comprende pas votre humour. Forse nel futuro \"divertente\" ha un significato diverso ?",shape=box,color=blue];
		1304 -> 1313;
	1305 [label="Non so quale istinto ti abbia spinto a dirmi una cosa del genere. ",shape=box,color=blue];
		1305 -> 1314;
	3951 [label="Bon, où en étais-je ?",shape=box,color=blue];
		3951 -> 1278;
	1310 [label="Combattere nel nome di Sol... è questa la mia strada ? Devo diventare un'assassina nel suo nome ? Moi, petite Marie ?",shape=box,color=blue];
		1310 -> 1319;
		1310 -> 1320;
	1311 [label="So che stai usando una metafora, ma sto ululando dalle risate ! ",shape=box,color=blue];
		1311 -> 1321;
	1306 [label="Ci sono così tanti modi in cui le nostre giornate e la nostra mente possono andare storte. Possono trovare buchi neri in cui impantanarci, non ?",shape=box,color=blue];
		1306 -> 1315;
	1307 [label="Le ho chiesto perché lo facesse e mi disse di non riuscire a dormire perché si agitava troppo.",shape=box,color=blue];
		1307 -> 1316;
	1308 [label="Abbiamo una parola per questo, ennui. Una stanchezza e un malcontento che fanno sembrare tutto... inutile.",shape=box,color=blue];
		1308 -> 1317;
	1309 [label="Si riempirà e fuoriuscirà. Forse rovescerà persino il suo contenuto. E tutto sembrerà una catastrofe. ",shape=box,color=blue];
		1309 -> 1318;
	1312 [label="Un'anima è più della fede che indossa. Io sono une Sœur de Sol, ma spero che tu veda in me qualcosa in più, non ?",shape=box,color=blue];
		1312 -> 1322;
	1313 [label="Per me, non lo è.",shape=box,color=blue];
		1313 -> 1323;
	1314 [label="Posso solo sperare che sia stato in buona fede e non uno scherzo crudele a mie spese. Quindi, sceglierò di seguire l'esempio di Sol -",shape=box,color=blue];
		1314 -> 1324;
	1319 [label="Non sono stato addestrato per fare il soldato. Non come il ragazzino. E nemmeno tu.",shape=box,color=red];
		1319 -> 1328;
	1320 [label="Non sono... sempre stato così. Sono sempre stato un combattente. Ho dovuto imparare a mie spese.",shape=box,color=red];
		1320 -> 1329;
	1321 [label="L'immagine che ho in testa mi fa venire una crisi. Prima che mi manchi il respiro, dimmi - a cosa ti riferisci ?",shape=box,color=blue];
		1321 -> 1319;
		1321 -> 1320;
	1315 [label="Quando ciò accade, possiamo solo sforzarci di essere gentili e pazienti con noi stessi.",shape=box,color=blue];
		1315 -> 1325;
	1316 [label="Ogni volta che la incontravo così, le chiedevo se voleva compagnia. A volte diceva di sì, a volte no.",shape=box,color=blue];
		1316 -> 1306;
	1317 [label="O forse il tuo è un desiderio di nasconderti, di piangere, è più simile alla disperazione, non saprei.",shape=box,color=blue];
		1317 -> 1335;
	1318 [label="Pulisci il pasticcio, raddrizzi il bicchiere... e ricomincia da capo, oui ?",shape=box,color=blue];
		1318 -> 1327;
	1322 [label="Gli argomenti che potremmo scegliere sono tanti quante sono le stelle nel cielo !",shape=box,color=blue];
