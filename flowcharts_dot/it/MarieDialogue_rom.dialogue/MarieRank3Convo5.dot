		1348 -> 1356;
	1349 [label="Penso che non ci sia un modo \"giusto\" per finire in una vita in guerra. Nascere, crescere, o sceglierlo. Alla fine, tutto dipende da chi sei e da cosa ne fai.",shape=box,color=red];
