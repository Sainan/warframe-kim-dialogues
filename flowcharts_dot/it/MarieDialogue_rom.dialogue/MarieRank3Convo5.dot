	j3353762353 [label="Ma famille à Sol ! Mia famiglia in Sol, come stiamo oggi ?",shape=box,color=blue];
		j3353762353 -> j1666313469;
		j3353762353 -> j3343681884;
		j3353762353 -> j2476222311;
		j3353762353 -> j2245042557;
		j3353762353 -> j4115718638;
	j2437978915 [label="Bonjour ! Come va oggi?",shape=box,color=blue];
		j2437978915 -> j1666313469;
		j2437978915 -> j2476222311;
		j2437978915 -> j2245042557;
		j2437978915 -> j4115718638;
		j2437978915 -> j3343681884;
	j1666313469 [label="Sto bene, tu come stai?",shape=box,color=red];
		j1666313469 -> j1288543847;
	j3343681884 [label="Sono stato meglio, ma grazie per avermelo chiesto. Tu come stai?",shape=box,color=red];
		j3343681884 -> j1598089151;
	j2476222311 [label="Dovrei... dovrei confessare che ho mentito, non sono... veramente un seguace di Sol.",shape=box,color=red];
		j2476222311 -> j2591192732;
	j2245042557 [label="Meglio ora che sto parlando con te. Ma tu rendi tutti i miei giorni più luminosi con la tua presenza.",shape=box,color=red];
		j2245042557 -> j2124195036;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j1288543847 [label="Sto bene, suppongo. Anche se, riflettendoci, mi sento come se non dovessi stare bene.",shape=box,color=blue];
		j1288543847 -> j4078068703;
		j1288543847 -> j660110213;
	j1598089151 [label="Sto bene, ma ora mi hai incuriosita. Qu'y a-t-il?",shape=box,color=blue];
		j1598089151 -> j1631602237;
		j1598089151 -> j384274437;
		j1598089151 -> j954028716;
		j1598089151 -> j635392334;
	j2591192732 [label="Oh ! Capisco. Pourquoi ?",shape=box,color=blue];
		j2591192732 -> j3230116378;
		j2591192732 -> j3353419928;
		j2591192732 -> j436757711;
	j2124195036 [label="Lupo ! Mi farai cadere dalla sedia !",shape=box,color=blue];
		j2124195036 -> j1935232199;
		j2124195036 -> j1268106112;
	"Chat ends." [color=orange];
	j4078068703 [label="Cosa intendi?",shape=box,color=red];
		j4078068703 -> j3177771784;
	j660110213 [label="Una volta mi trovavo nei tuoi panni.",shape=box,color=red];
		j660110213 -> j2490881711;
	j1631602237 [label="È... solo... difficile da spiegare.",shape=box,color=red];
		j1631602237 -> j250561285;
	j384274437 [label="Troppe cose di cui preoccuparsi. Troppo poco tempo.",shape=box,color=red];
		j384274437 -> j388619621;
	j954028716 [label="Un'amica una volta li ha descritti come ''ragni.'' Di tanto in tanto si insinuano.",shape=box,color=red];
		j954028716 -> j4092749853;
	j635392334 [label="A volte, tutto... mi disturba. Ma andrà tutto bene.",shape=box,color=red];
		j635392334 -> j1058527508;
	j3230116378 [label="Pensavo sarebbe stata un'opportunità per conoscerti meglio...",shape=box,color=red];
		j3230116378 -> j3906133207;
	j3353419928 [label="Pensavo sarebbe stato divertente?",shape=box,color=red];
		j3353419928 -> j4030708382;
	j436757711 [label="Sinceramente non lo so. È stato solo impulsivo.",shape=box,color=red];
		j436757711 -> j1470365241;
	j1935232199 [label="Dico sul serio. Mi dispiace se ti ho messa a disagio.",shape=box,color=red];
		j1935232199 -> j1180282791;
	j1268106112 [label="Scusami. Stavo solo scherzando.",shape=box,color=red];
		j1268106112 -> j1180282791;
	j3177771784 [label="Sono una Sœur de Sol. Non sono destinata a... combattere. Uccidere. I Murmure non sono vivi, o almeno così mi dicono i Cavia - ma che dire degli altri che affronto ?",shape=box,color=blue];
		j3177771784 -> j3080388666;
	j2490881711 [label="+5 Chemistry",color=orange];
		j2490881711 -> j449075292;
	j250561285 [label="Allora non mi intrometterò. So che a volte è difficile esprimere le cose a parole.",shape=box,color=blue];
		j250561285 -> j2928876107;
	j388619621 [label="C'era una Suora alla Cathédrale molto simile. Si agitava, si agitava e agitava. Una volta l'ho trovata a lucidare l'argento alle tre del mattino.",shape=box,color=blue];
		j388619621 -> j2785407715;
	j4092749853 [label="Ah, oui. Credo di sapere di cosa stai parlando. Una specie di... nuvola, che copre il sole.",shape=box,color=blue];
		j4092749853 -> j1141939366;
	j1058527508 [label="Come una tazza che si riempie d'acqua, una goccia alla volta, non ?",shape=box,color=blue];
		j1058527508 -> j2416624951;
	j3906133207 [label="Non c'era bisogno che mi dicessi una cosa del genere per conoscermi.",shape=box,color=blue];
		j3906133207 -> j708177508;
	j4030708382 [label="Je ne comprende pas votre humour. Forse nel futuro \"divertente\" ha un significato diverso ?",shape=box,color=blue];
		j4030708382 -> j2165731454;
	j1470365241 [label="Non so quale istinto ti abbia spinto a dirmi una cosa del genere. ",shape=box,color=blue];
		j1470365241 -> j3972537041;
	j1180282791 [label="Bon, où en étais-je ?",shape=box,color=blue];
		j1180282791 -> j4244769428;
	j3080388666 [label="Combattere nel nome di Sol... è questa la mia strada ? Devo diventare un'assassina nel suo nome ? Moi, petite Marie ?",shape=box,color=blue];
		j3080388666 -> j2842747548;
		j3080388666 -> j1109933439;
	j449075292 [label="So che stai usando una metafora, ma sto ululando dalle risate ! ",shape=box,color=blue];
		j449075292 -> j2214977999;
	j2928876107 [label="Ci sono così tanti modi in cui le nostre giornate e la nostra mente possono andare storte. Possono trovare buchi neri in cui impantanarci, non ?",shape=box,color=blue];
		j2928876107 -> j168486305;
	j2785407715 [label="Le ho chiesto perché lo facesse e mi disse di non riuscire a dormire perché si agitava troppo.",shape=box,color=blue];
		j2785407715 -> j2045876041;
	j1141939366 [label="Abbiamo una parola per questo, ennui. Una stanchezza e un malcontento che fanno sembrare tutto... inutile.",shape=box,color=blue];
		j1141939366 -> j3962233387;
	j2416624951 [label="Si riempirà e fuoriuscirà. Forse rovescerà persino il suo contenuto. E tutto sembrerà una catastrofe. ",shape=box,color=blue];
		j2416624951 -> j2372775309;
	j708177508 [label="Un'anima è più della fede che indossa. Io sono une Sœur de Sol, ma spero che tu veda in me qualcosa in più, non ?",shape=box,color=blue];
		j708177508 -> j170878215;
	j2165731454 [label="Per me, non lo è.",shape=box,color=blue];
		j2165731454 -> j1097657522;
	j3972537041 [label="Posso solo sperare che sia stato in buona fede e non uno scherzo crudele a mie spese. Quindi, sceglierò di seguire l'esempio di Sol -",shape=box,color=blue];
		j3972537041 -> j3287375064;
	j4244769428 [label="Check boolean DrifterFaithSol",color=orange];
		j4244769428 -> j2017890960 [label=true,color=green];
		j4244769428 -> j1543293861 [label=false,color=brown];
	j2842747548 [label="Non sono stato addestrato per fare il soldato. Non come il ragazzino. E nemmeno tu.",shape=box,color=red];
		j2842747548 -> j348871003;
	j1109933439 [label="Non sono... sempre stato così. Sono sempre stato un combattente. Ho dovuto imparare a mie spese.",shape=box,color=red];
		j1109933439 -> j898408628;
	j2214977999 [label="L'immagine che ho in testa mi fa venire una crisi. Prima che mi manchi il respiro, dimmi - a cosa ti riferisci ?",shape=box,color=blue];
		j2214977999 -> j2842747548;
		j2214977999 -> j1109933439;
	j168486305 [label="Quando ciò accade, possiamo solo sforzarci di essere gentili e pazienti con noi stessi.",shape=box,color=blue];
		j168486305 -> j3080032794;
	j2045876041 [label="Ogni volta che la incontravo così, le chiedevo se voleva compagnia. A volte diceva di sì, a volte no.",shape=box,color=blue];
		j2045876041 -> j2928876107;
	j3962233387 [label="O forse il tuo è un desiderio di nasconderti, di piangere, è più simile alla disperazione, non saprei.",shape=box,color=blue];
		j3962233387 -> j3900612436;
	j2372775309 [label="Pulisci il pasticcio, raddrizzi il bicchiere... e ricomincia da capo, oui ?",shape=box,color=blue];
		j2372775309 -> j2654370361;
	j170878215 [label="Gli argomenti che potremmo scegliere sono tanti quante sono le stelle nel cielo !",shape=box,color=blue];
		j170878215 -> j3948067536;
		j170878215 -> j2700491405;
	j1097657522 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j1097657522 -> j1508231473;
	j3287375064 [label="- la cui fede seguo, che tu condivida o no, e ti perdono. Se fossi come Lyon, ti direi che dieci frustate sono la tua penitenza.",shape=box,color=blue];
		j3287375064 -> j885842400;
	j2017890960 [label="Ma famille à Sol ! My family in Sol, how are we this day ?",shape=box,color=blue];
		j2017890960 -> j1666313469;
		j2017890960 -> j3343681884;
		j2017890960 -> j2476222311;
		j2017890960 -> j4115718638;
	j1543293861 [label="Bonjour ! How are we this day?",shape=box,color=blue];
		j1543293861 -> j1666313469;
		j1543293861 -> j3343681884;
		j1543293861 -> j2476222311;
		j1543293861 -> j4115718638;
	j348871003 [label="Oui ! La minuscola copia e la sua triste storia... mi viene da piangere a pensarci. Trasformati in una macchina da guerra da coloro che consideravano famille ?",shape=box,color=blue];
		j348871003 -> j2330300461;
	j898408628 [label="Oui ! Ho sentito dire che hai sofferto molto per imparare a combattere come fai ora. La morte è una maestra crudele, non riesco a immaginarlo...",shape=box,color=blue];
		j898408628 -> j2330300461;
	j3080032794 [label="Non so se queste parole ti interesseranno. O se sono solo tanti puntini luminosi in un macchinario ronzante.",shape=box,color=blue];
		j3080032794 -> j4275168905;
	j3900612436 [label="Non conosco questa tua amica, ma penso che - sia una loro fortuna conoscerti.",shape=box,color=blue];
		j3900612436 -> j2928876107;
	j2654370361 [label="C'era un Padre nella Cappella con un temperamento molto simile al tuo, credo. Poteva resistere a tutto - finché non ce l'ha più fatta.",shape=box,color=blue];
		j2654370361 -> j612444249;
	j3948067536 [label="Scusa. È stata una cosa sciocca.",shape=box,color=red];
		j3948067536 -> j1716633934;
	j2700491405 [label="Mi perdoni allora?",shape=box,color=red];
		j2700491405 -> j1877972688;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j885842400 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j885842400 -> j187979086;
	j2330300461 [label="Non. Preferirei essere come sono ora. Ho scelto di prendere la mano de le Cardinal, il sérum che mi ha offerto.",shape=box,color=blue];
		j2330300461 -> j1903266156;
	j4275168905 [label="In effetti, se si considera la realtà dei fatti, quando scrivo queste parole, potrebbero essere passati giorni o anni da quando le ho scritte, a seconda di dove (quando) ti trovi.",shape=box,color=blue];
		j4275168905 -> j3780685117;
	j612444249 [label="Quando si sentiva sopraffatto e tutto sembrava un disastro, gli chiedevo se voleva la mia companie. Des fois, oui, des fois, non.",shape=box,color=blue];
		j612444249 -> j2928876107;
	j1716633934 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j1716633934 -> j3446832783;
	j1877972688 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j1877972688 -> j3177182726;
	j187979086 [label="Siamo tutti esseri ciechi che cercano di trovare la propria strada in questo mondo.",shape=box,color=blue];
		j187979086 -> j3240912036;
	j1903266156 [label="Ma tu conosci la tristezza che mi tormenta, l'incertezza. Di non nascere, o crescere, in questa vita di guerra.",shape=box,color=blue];
		j1903266156 -> j20861003;
		j1903266156 -> j390955118;
	j3780685117 [label="Tutto questo per dire che capisco che possa sembrare superfluo quando scrivo che non sei solo.",shape=box,color=blue];
		j3780685117 -> j4253093602;
	j3446832783 [label="+10 Chemistry",color=orange];
		j3446832783 -> j1603569023;
	j3177182726 [label="+5 Chemistry",color=orange];
		j3177182726 -> j2252259165;
	j3240912036 [label="Ma ti ho chiesto come stavi. E la domanda rimane, petit mensonge ou non.",shape=box,color=blue];
		j3240912036 -> j1807642270;
		j3240912036 -> j1294307991;
		j3240912036 -> j1030609247;
	j20861003 [label="A volte penso a quanto ho dovuto scoprire da solo e provo un po' di invidia nei confronti del ragazzino per la vera formazione che ha ricevuto.",shape=box,color=red];
		j20861003 -> j3877441431;
	j390955118 [label="Penso che non ci sia un modo \"giusto\" per finire in una vita in guerra. Nascere, crescere, o sceglierlo. Alla fine, tutto dipende da chi sei e da cosa ne fai.",shape=box,color=red];
		j390955118 -> j1792633372;
	j4253093602 [label="Anche se le persone intorno a te possono sembrare distanti, virtuali sedute pazientemente in attesa del tuo saluto.",shape=box,color=blue];
		j4253093602 -> j1723727822;
	j1603569023 [label="Oui, e se fossi come Lyon, ti direi che la tua penitenza sono dieci frustate ! Ma non lo sei. E sei perdonato.",shape=box,color=blue];
		j1603569023 -> j187979086;
	j2252259165 [label="Oui, ti perdono. Se fossi come Lyon, ti direi che dieci frustate sono la tua penitenza.",shape=box,color=blue];
		j2252259165 -> j187979086;
	j1807642270 [label="Sono... stato meglio, sinceramente.",shape=box,color=red];
		j1807642270 -> j1619210487;
	j1294307991 [label="Sinceramente, sto bene. E tu, invece?",shape=box,color=red];
		j1294307991 -> j1288543847;
	j1030609247 [label="Meglio ora. Grazie. Ho sentito dire che la confessione fa bene alle persone, giusto?",shape=box,color=red];
		j1030609247 -> j886249901;
	j3877441431 [label="Add -1 to Thermostat counter",color=orange];
		j3877441431 -> j3824302625;
	j1792633372 [label="Add 1 to Thermostat counter",color=orange];
		j1792633372 -> j930652545;
	j1723727822 [label="E spero che questo momento passi presto.",shape=box,color=blue];
		j1723727822 -> j1705681436;
	j1619210487 [label="Qu'y a-t-il ? Cosa c'è che non va ?",shape=box,color=blue];
		j1619210487 -> j1631602237;
		j1619210487 -> j384274437;
		j1619210487 -> j954028716;
		j1619210487 -> j635392334;
	j886249901 [label="+5 Chemistry",color=orange];
		j886249901 -> j2763924221;
	j3824302625 [label="+10 Chemistry",color=orange];
		j3824302625 -> j354816226;
	j930652545 [label="+10 Chemistry",color=orange];
		j930652545 -> j3805268590;
	j1705681436 [label="E se non passa ? Ho una soluzione che ti aiuterà !",shape=box,color=blue];
		j1705681436 -> j2741842295;
	j2763924221 [label="Hah ! Oui, proprio così. Très bien, sono felice di sentirlo.",shape=box,color=blue];
		j2763924221 -> j2962495216;
	j354816226 [label="Oui, ma allora non saresti il lupo scapestrato che conosciamo e amiamo, giusto ? Penso che Sol ti abbia messo proprio dove dovevi essere.",shape=box,color=blue];
		j354816226 -> j438771735;
	j3805268590 [label="Oui, sono pienamente d'accordo. Nessuno è nato per la guerra. Beh, a parte questi \"Grin-ire\" di cui mi hanno parlato, e anche in quel caso...",shape=box,color=blue];
		j3805268590 -> j2196750884;
	j2741842295 [label="Des pâtisseries !",shape=box,color=blue];
		j2741842295 -> j4132951681;
	j2962495216 [label="Ah! Il pranzo è servito. Devo andare. A dopo, lupo. Sono molto contenta che abbiamo parlato.",shape=box,color=blue];
		j2962495216 -> "Chat ends.";
	j438771735 [label="Ma capisco cosa intendi. Vedi la struttura e la guida che ha ricevuto il tuo altro, e non puoi fare a meno di desiderare di avere le stesse cose. Soprattutto quando eri così solo.",shape=box,color=blue];
		j438771735 -> j3010873591;
	j2196750884 [label="Mi chiedo se avrebbe scelto un'altra strada se ne avesse avuta la possibilità ?",shape=box,color=blue];
		j2196750884 -> j3541118191;
		j2196750884 -> j1955082975;
	j4132951681 [label="Check boolean MarieRoathePastry1",color=orange];
		j4132951681 -> j3620603988 [label=true,color=green];
		j4132951681 -> j2222997971 [label=true,color=green];
		j4132951681 -> j949533587 [label=true,color=green];
		j4132951681 -> j2222997971 [label=false,color=brown];
		j4132951681 -> j2372887288 [label=false,color=brown];
	j3010873591 [label="Non posso fare a meno di vedere, ora, una minuscola copia che è così sola... e un lupo che corre con un branco.",shape=box,color=blue];
		j3010873591 -> j337256550;
	j3541118191 [label="È difficile, quando vieni cresciuto pensando che quello sia il tuo unico scopo, la tua unica esistenza, uscire da quello schema. Uno scopo dà conforto alle persone.",shape=box,color=red];
		j3541118191 -> j2964769331;
	j1955082975 [label="Penso di sì. Ho incontrato alcuni che mi hanno dimostrato che i Grineer sono molto più di semplice guerra e morte.",shape=box,color=red];
		j1955082975 -> j2980632331;
	j3620603988 [label="Dovrò solo assicurarmi di portare abbastanza pasticcini per tutti.",shape=box,color=red];
		j3620603988 -> j2907111399;
	j2222997971 [label="Grazie, Marie.",shape=box,color=red];
		j2222997971 -> j590581851;
	j949533587 [label="Non permetterò a Roathe di avvicinarsi.",shape=box,color=red];
		j949533587 -> j4294895180;
	j2372887288 [label="Con i dolci non si sbaglia mai.",shape=box,color=red];
		j2372887288 -> j895506797;
	j337256550 [label="Penso che forse la situazione si sia invertita, non ?",shape=box,color=blue];
		j337256550 -> j3755698221;
		j337256550 -> j1292793105;
	j2964769331 [label="Add -1 to Thermostat counter",color=orange];
		j2964769331 -> j882140087;
	j2980632331 [label="Add 1 to Thermostat counter",color=orange];
		j2980632331 -> j2109664283;
	j2907111399 [label="+20 Chemistry",color=orange];
		j2907111399 -> j1508454907;
	j590581851 [label="+20 Chemistry",color=orange];
		j590581851 -> j3109971755;
	j4294895180 [label="+20 Chemistry",color=orange];
		j4294895180 -> j4153472821;
	j895506797 [label="Ma non lasciare che il diavolo si avvicini. Sinon, il va les voler ! È solito rubare i dolci quando non gli viene dato abbastanza !",shape=box,color=blue];
		j895506797 -> j420323306;
	j3755698221 [label="Sta ancora guarendo. Il suo viaggio non è ancora finito.",shape=box,color=red];
		j3755698221 -> j221092087;
	j1292793105 [label="Vorrei poter fare di più per aiutare. ",shape=box,color=red];
		j1292793105 -> j221092087;
	j882140087 [label="Oui, hai ragione. Molti cercano la fede nella speranza che dia loro proprio questo - uno scopo. Una direzione.",shape=box,color=blue];
		j882140087 -> j3596573278;
	j2109664283 [label="(Quindi è così che si scrive, merci !) Mi rende così felice sapere che anche qualcuno a cui è stato insegnato che questo è il suo unico scopo, può trovarne un altro.",shape=box,color=blue];
		j2109664283 -> j1246521395;
	j1508454907 [label="Ecco, questo sì che è lo spirito giusto ! Immagino che anche un diavolo meriti un po' di pasticcini ogni tanto.",shape=box,color=blue];
		j1508454907 -> j3982382918;
	j3109971755 [label="Je vous en prie. Spero di averti tirato su il morale, almeno un pochino. Di certo, so che lo hai tirato su a me.",shape=box,color=blue];
		j3109971755 -> "Chat ends.";
	j4153472821 [label="Ah, mi lamento, ma anche il diavolo più vile merita un po' di pasticcini ogni tanto, oui ?",shape=box,color=blue];
		j4153472821 -> j3982382918;
	j420323306 [label="Boolean MarieRoathePastry1 is now true.",color=orange];
		j420323306 -> j3334729039;
		j420323306 -> j1591555724;
	j221092087 [label="E penso che tu stia facendo tutto il possibile. Verrà da te quando ne avrà bisogno.",shape=box,color=blue];
		j221092087 -> j3596573278;
	j3596573278 [label="Molti trovano una strada da percorrere nella speranza che li conduca a delle risposte.",shape=box,color=blue];
		j3596573278 -> j2771016143;
		j3596573278 -> j2419417044;
