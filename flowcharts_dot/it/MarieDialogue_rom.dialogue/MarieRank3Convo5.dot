		1324 -> 1333;
	1328 [label="Oui ! La minuscola copia e la sua triste storia... mi viene da piangere a pensarci. Trasformati in una macchina da guerra da coloro che consideravano famille ?",shape=box,color=blue];
		1328 -> 1337;
	1329 [label="Oui ! Ho sentito dire che hai sofferto molto per imparare a combattere come fai ora. La morte è una maestra crudele, non riesco a immaginarlo...",shape=box,color=blue];
		1329 -> 1337;
	1325 [label="Non so se queste parole ti interesseranno. O se sono solo tanti puntini luminosi in un macchinario ronzante.",shape=box,color=blue];
		1325 -> 1334;
	1335 [label="Non conosco questa tua amica, ma penso che - sia una loro fortuna conoscerti.",shape=box,color=blue];
		1335 -> 1306;
	1327 [label="C'era un Padre nella Cappella con un temperamento molto simile al tuo, credo. Poteva resistere a tutto - finché non ce l'ha più fatta.",shape=box,color=blue];
