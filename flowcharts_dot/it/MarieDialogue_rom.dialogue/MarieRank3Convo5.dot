		3950 -> 3951;
	1301 [label="Sono una Sœur de Sol. Non sono destinata a... combattere. Uccidere. I Murmure non sono vivi, o almeno così mi dicono i Cavia - ma che dire degli altri che affronto ?",shape=box,color=blue];
		1301 -> 1310;
