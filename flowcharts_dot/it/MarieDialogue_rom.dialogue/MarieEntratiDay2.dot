		2699 -> 2709;
		2699 -> 2710;
	2700 [label="Update boolean MarieEntratiCompleteB",color=orange];
		2700 -> 2711;
	2701 [label="Permettimi di spiegare semplicemente... perché è così difficile per me abbandonare la mia difesa de le Cardinal. E perché mi ci è voluto un po' di tempo per capire perché non potevo lasciarlo andare.",shape=box,color=blue];
		2701 -> 2699;
