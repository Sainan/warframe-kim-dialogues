	2692 [label="Add -10 to Family",color=orange];
		2692 -> 2700;
	2693 [label="Accetto le tue scuse... anche se in diversi momenti ho lasciato che il mio temperamento prendesse il sopravvento.",shape=box,color=blue];
		2693 -> 2701;
	2694 [label="Pensare... che dopo tutti questi anni, sono riuscita a farmi convincere da qualcuno che mi ha offerto tanta gentilezza ?",shape=box,color=blue];
		2694 -> 2702;
