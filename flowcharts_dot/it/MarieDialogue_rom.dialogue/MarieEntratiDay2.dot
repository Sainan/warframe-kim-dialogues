		2738 -> 2744;
	2739 [label="[Confessa i tuoi sentimenti.] Non sei una sciocca, Marie. Sei tutt'altro. Se non altro, questo mi dimostra quanto sei meravigliosa.",shape=box,color=red];
		2739 -> 2745;
	2740 [label="E mi dici questo mentre confessi il tuo amore al fratello della mia anima ?! Pensi forse di prenderci in giro entrambi ?!",shape=box,color=blue];
		2740 -> 2746;
	2741 [label="E mi dici questo mentre te la spassi con il diavolo ?! Pensi di prenderci entrambi in giro ?!",shape=box,color=blue];
		2741 -> 2746;
	2742 [label="Io... Oh, mon cœur. Mon cœur ! Oh, come provo la stessa cosa ! Ma non ho osato pronunciare quelle parole, non ho osato scrivertele, perché mi sono ritenuta una sciocca.",shape=box,color=blue];
		2742 -> 2747;
	2743 [label="Oui, come hai detto, e ora lo vedo chiaramente. Non mi resta che ringraziarti ancora una volta per la tua pazienza.",shape=box,color=blue];
		2743 -> 2748;
