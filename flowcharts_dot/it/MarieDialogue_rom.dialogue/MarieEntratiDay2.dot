	2711 [label="Update boolean MarieNoDate",color=orange];
		2711 -> 2721;
	2712 [label="Non sei una sciocca, Marie. Sei tutt'altro. Se non altro, questo mi dimostra quanto sei meravigliosa.",shape=box,color=red];
		2712 -> 2722;
	2713 [label="Sei diventata così importante per me, Marie... e mi dispiace tanto che questa conversazione sia andata in questo modo.",shape=box,color=red];
		2713 -> 2722;
	2714 [label="Immagino che per te sarebbe ovvio, non ? Qualcuno che ha perso anche la propria famiglia. ",shape=box,color=blue];
		2714 -> 2723;
	2715 [label="Vedremo. Credo che alla fine ho visto in lui un po' del padre che mi aveva abbandonata, per quanto piccolo e triste mi sembri ora.",shape=box,color=blue];
		2715 -> 2723;
	2716 [label="Je ne pense pas.",shape=box,color=blue];
		2716 -> 2724;
	2717 [label="À la revoyure.",shape=box,color=blue];
		2717 -> 2725;
	2718 [label="Quindi, non potrei mai fidarmi di te e del mio cuore. Vorrei dire che mi dispiace per queste parole, che sono certa ti deluderanno -",shape=box,color=blue];
		2718 -> 2726;
	2719 [label="Immagino che per te sarebbe ovvio, non ? Qualcuno che ha perso anche la propria famiglia. ",shape=box,color=blue];
		2719 -> 2727;
	2720 [label="Vedremo. Credo che alla fine ho visto in lui un po' del padre che mi aveva abbandonata, per quanto piccolo e triste mi sembri ora.",shape=box,color=blue];
		2720 -> 2727;
	2721 [label="Chat ends.",color=orange];
	2722 [label="Ma avevo bisogno che tu capissi che Entrati poteva essere complicato. Che poteva causare danni in egual misura. Non volevo che venissi ferita, in seguito.",shape=box,color=red];
		2722 -> 2728;
	2723 [label="Pensare... che dopo tutti questi anni, sono riuscita a farmi convincere da qualcuno che mi ha offerto tanta gentilezza ?",shape=box,color=blue];
		2723 -> 2729;
