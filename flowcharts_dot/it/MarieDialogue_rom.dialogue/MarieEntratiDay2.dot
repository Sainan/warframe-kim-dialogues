digraph {
	2615 [label="MarieEntratiDay2 begins.",color=orange];
		2615 -> 2616;
	2616 [label="Drifter. Mi sono presa un po' di tempo per pensare... per calmarmi. Ho una regola ferrea riguardo al conversare quando sono furiosa.",shape=box,color=blue];
		2616 -> 2617;
	2617 [label="Evaluate expressions",color=orange];
		2617 -> 2618 [label="MarieEntrati5a",color=purple];
		2617 -> 2619 [label="MarieEntrati5b",color=purple];
		2617 -> 2620 [label="MarieEntrati5c",color=purple];
		2617 -> 2621 [label="MarieEntrati5d",color=purple];
		2617 -> 2622 [label="MarieEntrati5e",color=purple];
		2617 -> 2623 [label="MarieEntrati5f",color=purple];
		2617 -> 2624 [label="MarieEntrati5g",color=purple];
		2617 -> 2625 [label="MarieEntrati5h",color=purple];
		2617 -> 2626 [label="MarieEntrati5i",color=purple];
		2617 -> 2627 [label="false",color=purple];
	2618 [label="È stato... un pugnale tra le costole quello che mi hai dato ieri. Ammetto di essere fuggita con rabbia, sì, ma anche con disgusto. Non verso di te, ma verso me stessa.",shape=box,color=blue];
		2618 -> 2628;
	2619 [label="Ma prima di continuare, devo affrontare una questione - il tono con cui mi parli. So che mi consideri una bambina. Sei centenario, se non più vecchio.",shape=box,color=blue];
		2619 -> 2629;
	2620 [label="Ho riflettuto a lungo sulle tue parole. Che questa non è una guerra santa e che le Cardinal ha agito in modo manipolativo.",shape=box,color=blue];
		2620 -> 2630;
	2621 [label="Avevi... ovviamente ragione quando mi chiedevi dove nelle scritture di Sol si afferma che gli innocenti sono sacrificabili. Non è così.",shape=box,color=blue];
		2621 -> 2631;
	2622 [label="Prima di continuare, devo affrontare una questione - la tua disponibilità a usare la mia fede contro di me in una discussione, quando tu stesso non ti impegni con la fede.",shape=box,color=blue];
		2622 -> 2632;
	2623 [label="Mi dispiace... di essermi sottratta alla nostra conversazione di ieri. Era semplicemente troppo. Devo chiederti, però, prima di continuare: intendevi davvero quello che dicevi ? O stavi solo cercando di manipolare i miei sentimenti per risparmiarti una discussione scomoda ?",shape=box,color=blue];
		2623 -> 2633;
		2623 -> 2634;
	2624 [label="Sembra che siamo giunti a un punto morto per quanto riguarda le Cardinal, oui ? Tu lo consideri un mostro, e io un santo.",shape=box,color=blue];
		2624 -> 2635;
	2625 [label="Vorrei parlarti della tua decisione di schierarti dalla parte di Entrati solo per entrare nelle mie grazie, se sei d'accordo.",shape=box,color=blue];
		2625 -> 2636;
	2626 [label="Vorrei parlarti della tua bugia ora, se per te va bene.",shape=box,color=blue];
		2626 -> 2636;
	2627 [label="Chat ends.",color=orange];
	2628 [label="Come potrei sorprendermi che tu fossi così mortalmente preciso nella mira ? Paragonare le mie parole a quelle del diavolo...",shape=box,color=blue];
		2628 -> 2637;
	2629 [label="Hai viaggiato attraverso dimensioni sconosciute, attraverso il Void stesso. Hai combattuto contro dei e angeli. Chi sono io per te, oui ? Solo la sciocca piccola Marie.",shape=box,color=blue];
		2629 -> 2638;
	2630 [label="E credo... oui, hai ragione. Questa non è una guerra santa. Assolutamente. La guerra non è mai santa, giusta o virtuosa. Il dolore non dovrebbe mai essere la luce guida.",shape=box,color=blue];
		2630 -> 2639;
	2631 [label="La guerra non è mai santa, giusta o virtuosa. Il dolore non dovrebbe mai essere la luce guida.",shape=box,color=blue];
		2631 -> 2639;
	2632 [label="Questo è stato disonesto, Drifter. Crudele e inefficace. Era un tentativo di \"vincere\" una conversazione, e non era il modo in cui ci si dovrebbe comportare.",shape=box,color=blue];
		2632 -> 2640;
	2633 [label="Pensavo davvero quello che dicevo. Mi dispiace se il mio tempismo è stato... sbagliato. Ci tengo a te, Marie...",shape=box,color=red];
		2633 -> 2641;
	2634 [label="Non le pensavo, sono stato solo... preso dal momento. Mi dispiace tanto, tanto. La passione del momento.",shape=box,color=red];
		2634 -> 2642;
	2635 [label="Tuttavia... non voglio che le cose tra noi restino così. Sei un'anima gentile e ci sono molte cose tra noi che non voglio che si rovinino.",shape=box,color=blue];
		2635 -> 2946;
	2636 [label="Cercare di manipolare la situazione per controllare i miei sentimenti è... disonesto e crudele. Ammetto che vorrei odiarti per questo, Drifter.",shape=box,color=blue];
		2636 -> 2644;
	2637 [label="Mi considererei una persona con la mente e il cuore aperti al mondo e a tutti coloro che lo abitano. E tu, in modo sintetico e con una sola freccia uncinata, mi hai dimostrato che mi sbagliavo.",shape=box,color=blue];
		2637 -> 2645;
	2638 [label="Da un lato, capisco. Ti capisco. Entrambi eravamo irritati. Ma dall'altro, ti chiedo di trattarmi con più grazia e tatto di quanto tu abbia fatto finora.",shape=box,color=blue];
		2638 -> 2646;
	2639 [label="Anche quello che facciamo ora, ovvero distruggere i Murmur e combattere contro i tuoi numerosi nemici - non è la via dei Luminari.",shape=box,color=blue];
		2639 -> 2647;
	2640 [label="La fede non è, né dovrebbe mai essere, un'arma da usare contro gli altri. È uno scudo. Una luce nell'oscurità. Una voce che guida il cammino.",shape=box,color=blue];
		2640 -> 2648;
	2641 [label="Prima di affrontare l'enormità di tutto ciò, devo spiegarmi riguardo le Cardinal, s'il vous plaît.",shape=box,color=blue];
		2641 -> 2649;
	2642 [label="Update boolean DrifterMarie",color=orange];
		2642 -> 2650;
	2946 [label="Check boolean LoidFamilyComplete",color=orange];
		2946 -> 2651 [label=true,color=green];
		2946 -> 2643 [label=false,color=brown];
	2644 [label="Tuttavia... non voglio che le cose tra noi restino così. Ci sono molte cose che non voglio che restino inasprite.",shape=box,color=blue];
		2644 -> 1395;
	2645 [label="Immagino di essere qui pour m'excuser - per dire che mi dispiace profondamente per essermi trincerata in modo così stupido. Spero che tu capisca.",shape=box,color=blue];
		2645 -> 2653;
		2645 -> 2654;
	2646 [label="Perché ho vissuto per strada. Ho vissuto ogni giorno della mia vita in agonia fisica. Ho conosciuto il dolore, ho conosciuto l'amore, ho conosciuto la paura e il rifiuto. Ho conosciuto la vita e la perdita.",shape=box,color=blue];
		2646 -> 2655;
	2647 [label="Per quanto necessario possa essere impugnare la spada, per evitare che il mondo venga travolto da simili, non è una cosa da venerare. E non è certamente scusabile quando degli innocenti vengono feriti al suo passaggio.",shape=box,color=blue];
		2647 -> 2656;
	2648 [label="E che tu abbia tentato di usarlo contro di me semplicemente per \"sconfiggermi\"? È stata una tattica codarda. Ma entrambi eravamo su di giri, e io... ti perdonerò, se tu perdonerai me, per le parole dette con rabbia.",shape=box,color=blue];
		2648 -> 2657;
		2648 -> 2658;
	2649 [label="Penso che per me sia difficile abbandonare la mia difesa de le Cardinal... e mi ci è voluto un po' di tempo per capire perché non potevo lasciarlo andare.",shape=box,color=blue];
		2649 -> 2659;
	2650 [label="Non, capisco... Quanti omicidi sono stati commessi come \"crimini passionali\", oui ? Di sicuro altrettanti bambini sono stati creati in momenti simili.",shape=box,color=blue];
		2650 -> 2660;
	2651 [label="E sei diventato importante per me, in così poco tempo... Ho trovato le nostre conversazioni così gioiose.",shape=box,color=blue];
		2651 -> 2661;
	2643 [label="In effetti, desidero ancora vedere Monsieur Loid unito a coloro che sono lassù. Desidero vedere conforto portato alla famiglia rimasta de le Cardinal, e tu sei la strada per raggiungere questo obiettivo! ",shape=box,color=blue];
		2643 -> 2651;
	1395 [label="Check boolean LoidFamilyComplete",color=orange];
		1395 -> 2662 [label=true,color=green];
		1395 -> 2652 [label=false,color=brown];
	2653 [label="Sì, certo. E mi dispiace se le mie parole ti hanno ferita. Non sapevo in quale altro modo esprimermi.",shape=box,color=red];
		2653 -> 2663;
	2654 [label="Sono felice che le mie parole ti siano arrivate. Stavo iniziando a perdere la speranza.",shape=box,color=red];
		2654 -> 2664;
	2655 [label="E se davvero credi di essere così al di sopra di tutti noi, allora non vedrai altro che le nuvole in cui sei perso.",shape=box,color=blue];
		2655 -> 2657;
		2655 -> 2658;
	2656 [label="Quindi... ammetterò che le Cardinal non è giustificato nel danneggiare gli altri in nome di un \"bene superiore\".",shape=box,color=blue];
		2656 -> 2665;
	2657 [label="Mi sono innervosito, ma non so come altro farti ragionare. Entrati non è tuo amico. Né tuo padre.",shape=box,color=red];
		2657 -> 2666;
	2658 [label="Mi dispiace. Ho lasciato che la rabbia prendesse il sopravvento e ho detto cose che non pensavo.",shape=box,color=red];
		2658 -> 2667;
	2659 [label="Semplicemente non vorrei che tu mi stimassi meno se ti confessassi la verità. Sembra così insignificante e patetico.",shape=box,color=blue];
		2659 -> 2668;
		2659 -> 2669;
	2660 [label="Sono... delusa. Ferita. Ma... ti perdono.",shape=box,color=blue];
		2660 -> 2670;
	2661 [label="Evaluate expressions",color=orange];
		2661 -> 2671 [label="DrifterMarie",color=purple];
		2661 -> 2672 [label="DrifterLyon",color=purple];
		2661 -> 2673 [label="DrifterRoathe",color=purple];
		2661 -> 2674 [label="false",color=purple];
	2662 [label="E suppongo che potresti mostrare tanta gentilezza al mio Lyon e persino al diavolo...",shape=box,color=blue];
		2662 -> 2675;
		2662 -> 2676;
	2652 [label="In effetti, desidero ancora vedere Monsieur Loid unito a coloro che sono lassù. Desidero vedere conforto portato alla famiglia rimasta de le Cardinal, e tu sei la strada per raggiungere questo obiettivo! ",shape=box,color=blue];
		2652 -> 2662;
	2663 [label="+10 Chemistry",color=orange];
		2663 -> 2677;
	2664 [label="C'è qualcosa da dire sull'essere cortesi quando si \"vince\", lo sai.",shape=box,color=blue];
		2664 -> 2678;
		2664 -> 2679;
	2665 [label="Quale \"bene più grande\" rimarrà, quando sul suo cammino non resteranno altro che vite e cuori distrutti ?",shape=box,color=blue];
		2665 -> 2645;
	2666 [label="Non. Non è mio padre. Perché mio padre mi ha abbandonata per strada quando ero bambina, e le Cardinal non ha fatto nulla di altrettanto crudele.",shape=box,color=blue];
		2666 -> 2680;
	2667 [label="Molte atrocità sono state commesse nel fervore della passione. Così vanno le cose. ",shape=box,color=blue];
		2667 -> 2681;
	2668 [label="Penso di sapere già di cosa si tratta. ",shape=box,color=red];
		2668 -> 2682;
	2669 [label="Non avrò una cattiva opinione di te, Marie. Te lo prometto.",shape=box,color=red];
		2669 -> 2683;
	2670 [label="Per... concludere la conversazione riguardante le Cardinal, se ci è consentito - lasciando da parte il mio dolore, s'il te plaît ?",shape=box,color=blue];
		2670 -> 2684;
	2671 [label="In effetti, come posso respingerti, quando mi hai confessato ciò che provi ?",shape=box,color=blue];
		2671 -> 2685;
	2672 [label="In effetti, come posso respingerti, quando mi hai confessato cosa provi per il nostro caro Lyon ? Potresti portargli tanta pace... tanto conforto...",shape=box,color=blue];
		2672 -> 2685;
	2673 [label="In effetti, come posso respingerti, quando sembri invischiato con il diavolo ? Non capisco i tuoi gusti, ma... sembra che tu debba stare al nostro fianco, oui ?",shape=box,color=blue];
		2673 -> 2685;
	2674 [label="Non vorrei perdere la tua compagnia. Possiamo mettere da parte tutto questo e dire che, anche se non siamo d'accordo, possiamo comunque andare avanti ?",shape=box,color=blue];
		2674 -> 2686;
		2674 -> 2687;
	2675 [label="Marie, aspetta. Per favore. Lascia che ti chieda scusa.",shape=box,color=red];
		2675 -> 2688;
	2676 [label="Sinceramente non pensavo che quello che ti ho detto avesse importanza, non pensavo sarebbe stato così importante per te.",shape=box,color=red];
		2676 -> 2688;
	2677 [label="Lo apprezzo più di quanto tu possa immaginare, grazie.",shape=box,color=blue];
		2677 -> 2689;
	2678 [label="Stavo solo scherzando.",shape=box,color=red];
		2678 -> 2690;
	2679 [label="Scusa. Non \"vinco\" molto spesso.",shape=box,color=red];
		2679 -> 2691;
	2680 [label="Update boolean MarieFamilyFail",color=orange];
		2680 -> 2692;
	2681 [label="+5 Chemistry",color=orange];
		2681 -> 2693;
	2682 [label="Immagino che per te sarebbe ovvio, non ? Qualcuno che ha perso anche la propria famiglia. ",shape=box,color=blue];
		2682 -> 2694;
	2683 [label="Vedremo. Credo che alla fine ho visto in lui un po' del padre che mi aveva abbandonata, per quanto piccolo e triste mi sembri ora.",shape=box,color=blue];
		2683 -> 2694;
	2684 [label="Penso che per me sia difficile abbandonare la mia difesa de le Cardinal... e mi ci è voluto un po' di tempo per capire perché non potevo lasciarlo andare.",shape=box,color=blue];
		2684 -> 2695;
	2685 [label="Possiamo mettere da parte tutto questo e dire che, anche se non siamo d'accordo, possiamo comunque andare avanti ?",shape=box,color=blue];
		2685 -> 2686;
		2685 -> 2687;
	2686 [label="No, non ho ancora finito con la questione. Dobbiamo concludere questa conversazione.",shape=box,color=red];
		2686 -> 2696;
	2687 [label="Penso che sia giusto. Sono d'accordo.",shape=box,color=red];
		2687 -> 2697;
	2688 [label="Ti perdono per le tue bugie, Drifter. Possiamo continuare a essere amici e alleati. Ma mentirmi come hai fatto, solo nel tentativo di... cosa ?",shape=box,color=blue];
		2688 -> 2698;
	2689 [label="Penso che per me sia difficile abbandonare la mia défense de le Cardinal... e mi ci è voluto un po' di tempo per capire perché non potevo lasciarlo andare.",shape=box,color=blue];
		2689 -> 2699;
	2690 [label="Oui, sì, beh. ",shape=box,color=blue];
