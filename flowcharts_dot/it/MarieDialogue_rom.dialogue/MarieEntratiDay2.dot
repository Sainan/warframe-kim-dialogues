		2725 -> 2731;
	2726 [label="Ma temo di no. Spero che questo non sia una sorpresa.",shape=box,color=blue];
		2726 -> 2732;
	2727 [label="Pensare... che dopo tutti questi anni, sono riuscita a farmi convincere da qualcuno che mi ha offerto tanta gentilezza ?",shape=box,color=blue];
