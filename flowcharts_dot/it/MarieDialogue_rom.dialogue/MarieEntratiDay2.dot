	2731 [label="Update boolean MarieWillDate",color=orange];
		2731 -> 2737;
	2732 [label="Per quanto riguarda la questione de le Cardinal ? Immagino che rimarremo separati sull'argomento. Come rimarremo separati nei nostri affetti.",shape=box,color=blue];
		2732 -> 2738;
	2733 [label="Piccola e sciocca Marie... ovviamente non era tutto ciò che sembrava.",shape=box,color=blue];
