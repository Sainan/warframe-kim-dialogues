	3067 [label="+10 Chemistry",color=orange];
		3067 -> 3077;
	3069 [label="Oui, che danno potrebbe causare a un'anima ? Capisco perché volevi incontrare un altro che capisse. E lui, te.",shape=box,color=blue];
		3069 -> 3067;
	3070 [label="Aver vissuto così a lungo, aver visto così tanta morte - aver pagato così tanto ?",shape=box,color=blue];
