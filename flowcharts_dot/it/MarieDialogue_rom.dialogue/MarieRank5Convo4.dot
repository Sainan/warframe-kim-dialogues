	2974 [label="Bonjour - Ci ho pensato un po'... e mi dispiace davvero ammetterlo. Non mi fa piacere dirlo.",shape=box,color=blue];
		2974 -> 2981;
	2980 [label="Ma ho la sensazione che abbiamo bisogno... di una specie di bastione, non ? Hai qualche idea ?",shape=box,color=blue];
		2980 -> 2984;
		2980 -> 2983;
	2982 [label="Ma penso... penso - ah, che Sol mi perdoni - che potrebbe essere necessario l'aiuto del diavolo. Altrimenti non credo che Monsieur Loid ci ascolterà.",shape=box,color=blue];
		2982 -> 2986;
	2983 [label="Penso che potremmo aver bisogno dell'aiuto di Roathe per convincere Loid a parlare con la famiglia Entrati. Non credo che lo farebbe altrimenti. Senza la garanzia che lui e la famiglia saranno protetti.",shape=box,color=red];
		2983 -> 2987;
	2981 [label="Credo che tu possa avere ragione. Il diavolo potrebbe essere il tassello mancante di cui abbiamo bisogno. Ah, mi fa male anche solo digitare queste parole ! ",shape=box,color=blue];
		2981 -> 2985;
