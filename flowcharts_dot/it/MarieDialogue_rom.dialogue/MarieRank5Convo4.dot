	3066 [label="Update boolean MarieFamilySuccess",color=orange];
		3066 -> 3076;
	3062 [label="E mai nei momenti privati. Non. Jamais.",shape=box,color=blue];
		3062 -> 3071;
		3062 -> 3072;
	3063 [label="Ancor di più se gli fai da ange custode per calmarlo.",shape=box,color=blue];
		3063 -> 3073;
		3063 -> 3074;
	3058 [label="E suppongo di essere in cima a quella lista ultimamente, non ? Suppongo che dovrei... considerare le sue ragioni, il motivo per cui è come è. La condanna non salva anime.",shape=box,color=blue];
		3058 -> 3067;
	3057 [label="C'è sempre un dolore che nascondiamo a chi ci circonda. Qualcosa che cerchiamo di nascondere, per paura che altri possano appropriarsene. Immagino che dovrei sforzarmi di essere più gentile con lui, se quello che dici è vero.",shape=box,color=blue];
		3057 -> 3067;
	3060 [label="Non riesco a immaginare la quantità di amore e perdita che si può soffrire in tutti quegli anni. Sembra così irreale, anche considerando tutto quello che ho visto.",shape=box,color=blue];
		3060 -> 3069;
	3061 [label="A volte, quando gli parlo, dimentico quanti secoli ha vissuto. Sembra così irreale, nonostante tutto quello che ho visto.",shape=box,color=blue];
		3061 -> 3070;
	3056 [label="Ci sono sempre... nuances, oui? Ci sono sempre delle ragioni per agire in un modo o nell'altro. Suppongo che dovrei sforzarmi di essere più gentile con lui, se quello che dici è vero.",shape=box,color=blue];
		3056 -> 3067;
	3059 [label="Nessuno ha mai negato al diavolo il suo ingegno.",shape=box,color=blue];
		3059 -> 3068;
