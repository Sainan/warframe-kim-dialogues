	j695603763 [label="Allora sosterrò anche io la tua scelta.",shape=box,color=blue];
		j695603763 -> j1179567760;
	j1676603611 [label="Nel frattempo parlerò con Lyon, ma le mie speranze sono estremamente basse.",shape=box,color=blue];
		j1676603611 -> j548547155;
	j287858159 [label="+20 Chemistry",color=orange];
		j287858159 -> j50064336;
	j2391005609 [label="Penso che sia solo una scusa per nascondere le sue vere intenzioni.",shape=box,color=red];
		j2391005609 -> j2147703031;
	j3615377500 [label="Ma almeno mi aiuterà. E mi assicurerò che non dia seguito alle sue minacce.",shape=box,color=red];
		j3615377500 -> j2867174072;
	j610253093 [label="Penso che tu abbia le capacità per convincerlo, dove tutti gli altri hanno fallito, non ?",shape=box,color=blue];
		j610253093 -> j3782772100;
		j610253093 -> j3694446993;
	j2815820438 [label="Ti auguro buona fortuna. Quel diavolo sa essere ostinato anche nei suoi momenti migliori. A volte, penso che gli piaccia semplicemente essere polemico !",shape=box,color=blue];
		j2815820438 -> j3906894561;
		j2815820438 -> j3702230242;
	j1051375123 [label="Oui, certo. Penso che tu abbia le capacità per convincerlo, dove tutti gli altri hanno fallito, non ?",shape=box,color=blue];
		j1051375123 -> j3782772100;
		j1051375123 -> j3694446993;
	j1683411077 [label="Oui, certo che sì. Quel diavolo sa essere ostinato anche nei suoi momenti migliori. A volte, penso che gli piaccia semplicemente essere contrario !",shape=box,color=blue];
		j1683411077 -> j3906894561;
		j1683411077 -> j3702230242;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j548547155 [label="+20 Chemistry",color=orange];
		j548547155 -> j1007261212;
	j50064336 [label="Ho profondamente sottovalutato questo nostro diavolo...",shape=box,color=blue];
		j50064336 -> j2867542703;
	j2147703031 [label="Oui, spero tu abbia ragione.",shape=box,color=blue];
		j2147703031 -> j70687620;
	j2867174072 [label="Oui. Almeno sei qui per assicurarti che gli impediamo di seguire i suoi... istinti base.",shape=box,color=blue];
		j2867174072 -> j70687620;
	j3782772100 [label="Cosa stai insinuando, Marie?",shape=box,color=red];
		j3782772100 -> j641750028;
	j3694446993 [label="Non vorrei usare il mio rapporto con lui come strumento di negoziazione.",shape=box,color=red];
		j3694446993 -> j2474147649;
	j3906894561 [label="Potrebbe esserlo, ma credo che molto di ciò sia solo finzione.",shape=box,color=red];
		j3906894561 -> j3933844858;
	j3702230242 [label="In realtà mi piace, anche se può sembrare strano. Andiamo d'accordo.",shape=box,color=red];
		j3702230242 -> j2928355837;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j1007261212 [label="Il diavolo è volubile! C'est la vie, come si suol dire!",shape=box,color=blue];
		j1007261212 -> j3569999725;
	j2867542703 [label="E non sono una stupida che non vede il ruolo che hai avuto nel garantire che tutto questo accadesse !",shape=box,color=blue];
		j2867542703 -> j1263896752;
	j70687620 [label="Check boolean MarieDating",color=orange];
		j70687620 -> j1015480169 [label=true,color=green];
		j70687620 -> j4270089074 [label=false,color=brown];
	j641750028 [label="+5 Chemistry",color=orange];
		j641750028 -> j1206291526;
	j2474147649 [label="Oh ! Non è questo che intendevo, pardonne-moi ! Semplicemente è che sembra favorirti, potresti avere il suo orecchio mentre potrebbe ignorare tutti gli altri.",shape=box,color=blue];
		j2474147649 -> j2605734019;
	j3933844858 [label="Oui ? Cosa intendi ?",shape=box,color=blue];
		j3933844858 -> j1155893159;
	j2928355837 [label="Sì, sembra proprio che ti preferisca. Forse è perché condividete un tempo e un luogo, cosa che noi non facciamo ? Altrimenti perché dovrebbe ?",shape=box,color=blue];
		j2928355837 -> j1155893159;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j1263896752 [label="Check boolean MarieDating",color=orange];
		j1263896752 -> j1538475415 [label=true,color=green];
		j1263896752 -> j2304611052 [label=false,color=brown];
	j1015480169 [label="+10 Chemistry",color=orange];
		j1015480169 -> j2350828126;
	j4270089074 [label="+10 Chemistry",color=orange];
		j4270089074 -> j4020360784;
	j1206291526 [label="Non ho proprio idea di cosa intendi ! Non sto insinuando nulla. Sono une Sœur de Sol puramente innocente.",shape=box,color=blue];
		j1206291526 -> j358296563;
	j2605734019 [label="+5 Chemistry",color=orange];
		j2605734019 -> j226531935;
	j1155893159 [label="Evaluate expressions",color=orange];
		j1155893159 -> j4264674816 [label="RoatheVillain",color=purple];
		j1155893159 -> j2715082405 [label="RoatheRedeemed",color=purple];
		j1155893159 -> j1855851133 [label="RoatheUnloved3",color=purple];
		j1155893159 -> j3532674687 [label="RoatheTraitor2",color=purple];
		j1155893159 -> j3906969315 [label="RoatheExecutor2",color=purple];
		j1155893159 -> j2636442628 [label="false",color=purple];
	j1538475415 [label="Merci, merci, merci, mon cœur !",shape=box,color=blue];
		j1538475415 -> j3656633921;
	j2304611052 [label="Merci, merci, merci !",shape=box,color=blue];
		j2304611052 -> j3656633921;
	j2350828126 [label="Bene ! Quando arriverà il momento, sarò pronta ! Fino ad allora, merci, mon cœur.",shape=box,color=blue];
		j2350828126 -> j3569999725;
	j4020360784 [label="Bene ! Quando arriverà il momento, sarò pronta ! Fino ad allora, merci.",shape=box,color=blue];
		j4020360784 -> j3569999725;
	j358296563 [label="Non insinuerei mai che, poiché il diavolo sembra favorirti, forse ti ascolterebbe mentre ignorerebbe tutti gli altri.",shape=box,color=blue];
		j358296563 -> j2095849933;
	j226531935 [label="Sono semplicemente felice che tu sia felice. E se il diavolo ha un posto dove spendere i suoi... sforzi... tanto meglio, non ?",shape=box,color=blue];
		j226531935 -> j919549181;
	j4264674816 [label="Tutti nella sua vita hanno cercato di farlo passare per una specie di mostro. Immagino di essere la prima persona a non averlo fatto.",shape=box,color=red];
		j4264674816 -> j2766710235;
	j2715082405 [label="Ci sono molte cose in lui che non sa come mostrare. Non è un'armatura in sé - ma non si fida che la gente non gli faccia del male.",shape=box,color=red];
		j2715082405 -> j3781120717;
	j1855851133 [label="Lui... ha avuto il cuore spezzato nel corso della sua vita. Gli sono solo rimaste le cicatrici, tutto qui.",shape=box,color=red];
		j1855851133 -> j1895950083;
	j3532674687 [label="Credo di poter capire quanti anni ha vissuto. Ho visto la stessa quantità di morti che ha visto lui.",shape=box,color=red];
		j3532674687 -> j2767576688;
	j3906969315 [label="Ha sempre cercato di fare solo ciò che era giusto. Forse nel modo sbagliato, certo - ma stava cercando di salvare il Sistema Origin dagli Orokin.",shape=box,color=red];
		j3906969315 -> j2788863933;
	j2636442628 [label="Mi piace il suo umorismo pungente. È intelligente, se riesci a superare il suo ego.",shape=box,color=red];
		j2636442628 -> j76141246;
	j3656633921 [label="Bene ! Quando arriverà il momento, sarò pronta ! Fino ad allora !",shape=box,color=blue];
		j3656633921 -> j3569999725;
	j2095849933 [label="E mai nei momenti privati. Non. Jamais.",shape=box,color=blue];
		j2095849933 -> j4272341478;
		j2095849933 -> j1242316062;
	j919549181 [label="Ancor di più se gli fai da ange custode per calmarlo.",shape=box,color=blue];
		j919549181 -> j28782989;
		j919549181 -> j3761777176;
	j2766710235 [label="E suppongo di essere in cima a quella lista ultimamente, non ? Suppongo che dovrei... considerare le sue ragioni, il motivo per cui è come è. La condanna non salva anime.",shape=box,color=blue];
		j2766710235 -> j2357088908;
	j3781120717 [label="C'è sempre un dolore che nascondiamo a chi ci circonda. Qualcosa che cerchiamo di nascondere, per paura che altri possano appropriarsene. Immagino che dovrei sforzarmi di essere più gentile con lui, se quello che dici è vero.",shape=box,color=blue];
		j3781120717 -> j2357088908;
	j1895950083 [label="Non riesco a immaginare la quantità di amore e perdita che si può soffrire in tutti quegli anni. Sembra così irreale, anche considerando tutto quello che ho visto.",shape=box,color=blue];
		j1895950083 -> j2091848337;
	j2767576688 [label="A volte, quando gli parlo, dimentico quanti secoli ha vissuto. Sembra così irreale, nonostante tutto quello che ho visto.",shape=box,color=blue];
		j2767576688 -> j3573045500;
	j2788863933 [label="Ci sono sempre... nuances, oui? Ci sono sempre delle ragioni per agire in un modo o nell'altro. Suppongo che dovrei sforzarmi di essere più gentile con lui, se quello che dici è vero.",shape=box,color=blue];
		j2788863933 -> j2357088908;
	j76141246 [label="Nessuno ha mai negato al diavolo il suo ingegno.",shape=box,color=blue];
		j76141246 -> j3192216870;
	j4272341478 [label="Mi sorprendi. Sono impressionato. ",shape=box,color=red];
		j4272341478 -> j2605734019;
	j1242316062 [label="Non sapevo che avessi questo lato.",shape=box,color=red];
		j1242316062 -> j2605734019;
	j28782989 [label="Non posso fare promesse.",shape=box,color=red];
		j28782989 -> j4108758147;
	j3761777176 [label="Chi ha detto che sto cercando di calmarlo?",shape=box,color=red];
		j3761777176 -> j1014410439;
	j2357088908 [label="+10 Chemistry",color=orange];
		j2357088908 -> j3478910303;
	j2091848337 [label="Oui, che danno potrebbe causare a un'anima ? Capisco perché volevi incontrare un altro che capisse. E lui, te.",shape=box,color=blue];
		j2091848337 -> j2357088908;
