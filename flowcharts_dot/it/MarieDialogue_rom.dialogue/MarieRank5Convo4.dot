	j3381737428 [label="Ne sei così sicuro ? Se io posso mettere da parte le mie divergenze con il diavolo, certamente puoi farlo anche tu, non ?",shape=box,color=blue];
		j3381737428 -> j1145971651;
		j3381737428 -> j683399766;
	j1041842266 [label="Hai ragione. Non pensavo che avresti accettato. Avevo paura di chiedertelo.",shape=box,color=red];
		j1041842266 -> j409794056;
	j191921816 [label="No, ci deve essere un altro modo. Mi rifiuto di chiedergli aiuto.",shape=box,color=red];
		j191921816 -> j3381737428;
	j4097859153 [label="Ci darà il suo aiuto a questo proposito ?",shape=box,color=blue];
		j4097859153 -> j3443009862;
