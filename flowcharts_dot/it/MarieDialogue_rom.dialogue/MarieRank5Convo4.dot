		j2704401703 -> j4153148246;
	j1810730257 [label="Ma ho la sensazione che abbiamo bisogno... di una specie di bastione, non ? Hai qualche idea ?",shape=box,color=blue];
		j1810730257 -> j4209925789;
		j1810730257 -> j405797627;
	j4178291883 [label="Ma penso... penso - ah, che Sol mi perdoni - che potrebbe essere necessario l'aiuto del diavolo. Altrimenti non credo che Monsieur Loid ci ascolterà.",shape=box,color=blue];
		j4178291883 -> j752212229;
	j405797627 [label="Penso che potremmo aver bisogno dell'aiuto di Roathe per convincere Loid a parlare con la famiglia Entrati. Non credo che lo farebbe altrimenti. Senza la garanzia che lui e la famiglia saranno protetti.",shape=box,color=red];
		j405797627 -> j699705287;
	j4153148246 [label="Credo che tu possa avere ragione. Il diavolo potrebbe essere il tassello mancante di cui abbiamo bisogno. Ah, mi fa male anche solo digitare queste parole ! ",shape=box,color=blue];
		j4153148246 -> j409794056;
	j4209925789 [label="Non ho davvero buone idee che non implichino l'aiuto di fonti pessime. Fonti che potrebbero solo metterci nei guai più avanti. Vale a dire, Roathe.",shape=box,color=red];
		j4209925789 -> j3381737428;
	j752212229 [label="Il diavolo è potente e promette di darci forza nel caso in cui le cose dovessero andare male, non ?",shape=box,color=blue];
		j752212229 -> j1041842266;
		j752212229 -> j191921816;
	j699705287 [label="Io... odio ammetterlo, ma penso che tu possa avere ragione... Sol perdonami.",shape=box,color=blue];
