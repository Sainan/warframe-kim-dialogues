	3049 [label="Non insinuerei mai che, poiché il diavolo sembra favorirti, forse ti ascolterebbe mentre ignorerebbe tutti gli altri.",shape=box,color=blue];
		3049 -> 3062;
	3050 [label="Sono semplicemente felice che tu sia felice. E se il diavolo ha un posto dove spendere i suoi... sforzi... tanto meglio, non ?",shape=box,color=blue];
		3050 -> 3063;
	3045 [label="Tutti nella sua vita hanno cercato di farlo passare per una specie di mostro. Immagino di essere la prima persona a non averlo fatto.",shape=box,color=red];
		3045 -> 3058;
	3044 [label="Ci sono molte cose in lui che non sa come mostrare. Non è un'armatura in sé - ma non si fida che la gente non gli faccia del male.",shape=box,color=red];
		3044 -> 3057;
	3047 [label="Lui... ha avuto il cuore spezzato nel corso della sua vita. Gli sono solo rimaste le cicatrici, tutto qui.",shape=box,color=red];
		3047 -> 3060;
	3048 [label="Credo di poter capire quanti anni ha vissuto. Ho visto la stessa quantità di morti che ha visto lui.",shape=box,color=red];
		3048 -> 3061;
	3043 [label="Ha sempre cercato di fare solo ciò che era giusto. Forse nel modo sbagliato, certo - ma stava cercando di salvare il Sistema Origin dagli Orokin.",shape=box,color=red];
		3043 -> 3056;
	3046 [label="Mi piace il suo umorismo pungente. È intelligente, se riesci a superare il suo ego.",shape=box,color=red];
		3046 -> 3059;
	3064 [label="Chat ends.",color=orange];
	3065 [label="Bene ! Quando arriverà il momento, sarò pronta ! Fino ad allora !",shape=box,color=blue];
