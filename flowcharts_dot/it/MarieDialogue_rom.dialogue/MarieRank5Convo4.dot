		j3770141296 -> j1165820443;
	j3386605909 [label="Pensi di poterlo convincere ad aiutarci?",shape=box,color=blue];
		j3386605909 -> j2747513708;
		j3386605909 -> j1591232283;
	j1145971651 [label="Va bene. Se tu sei d'accordo, per me va bene.",shape=box,color=red];
		j1145971651 -> j127231999;
	j683399766 [label="No, mi dispiace. ",shape=box,color=red];
		j683399766 -> j3672513205;
	j3443009862 [label="No, purtroppo... Penso che sia stato un vicolo cieco. Pensi che ci sia un'altra soluzione?",shape=box,color=red];
		j3443009862 -> j2319593958;
	j162699176 [label="Lo farà. L'ho convinto ad aiutarmi a riunirli - e non ci crederai - credo lo faccia per proteggere la famiglia di Entrati. Dopotutto, sono tutto ciò che rimane degli Orokin.",shape=box,color=red];
		j162699176 -> j4053431874;
	j1165820443 [label="Lo farà. L'ho convinto ad aiutarmi a riunirli - e non ti sorprenderai - credo lo faccia soprattutto per fare dispetto ad Albrecht in sua assenza.",shape=box,color=red];
		j1165820443 -> j681921808;
	j2747513708 [label="Ci sto ancora lavorando, ma credo di sì.",shape=box,color=red];
		j2747513708 -> j961489522;
	j1591232283 [label="Niente è stato deciso. Lui è... beh, sai com'è.",shape=box,color=red];
		j1591232283 -> j3827853471;
	j127231999 [label="Oui, non sono obbligata a farmelo andare bene, ma è un medicinale che dobbiamo ingoiare, suppongo.",shape=box,color=blue];
		j127231999 -> j409794056;
	j3672513205 [label="+20 Chemistry",color=orange];
		j3672513205 -> j695603763;
	j2319593958 [label="Oh ! Che peccato. Non lo so ? Non credo... Ti viene in mente un altro approccio con il diavolo ? O un modo per riprovare ?",shape=box,color=blue];
		j2319593958 -> j1676603611;
	j4053431874 [label="Sta aiutando a proteggere la famiglia dell'uomo che lo ha trasformato in protoframe contro la sua volontà e lo ha catapultato nel passato, privandolo dei suoi ricordi...",shape=box,color=blue];
		j4053431874 -> j287858159;
