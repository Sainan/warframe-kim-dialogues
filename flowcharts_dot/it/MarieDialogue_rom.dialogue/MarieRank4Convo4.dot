	2292 [label="Oui, anche se penso di sapere di cosa si tratta... mi sono comportata male. Chi te l'ha detto ?",shape=box,color=blue];
		2292 -> 2295;
		2292 -> 2296;
		2292 -> 2297;
	2293 [label="Bien sûr, ce salaud de diable ouvre sa bouche et vous raconte tout ! Il ne cherche qu'à m'embarrasser !",shape=box,color=blue];
