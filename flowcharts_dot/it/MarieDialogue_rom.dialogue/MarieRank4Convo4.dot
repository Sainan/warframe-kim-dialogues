		j3465789796 -> j2095541547;
	j2881078968 [label="Roathe.",shape=box,color=red];
		j2881078968 -> j2815078440;
	j2447770036 [label="Si je le pouvais, je prendrais ce couteau qu'il aime tant utiliser pour agacer les autres et je le fourrerais là où seule Lua peut le voir !",shape=box,color=blue];
		j2447770036 -> j4070387160;
	j2000631793 [label="Penso che lo sia, ma credo che tu non voglia rovinarmi la giornata. Quindi... non insisterò per saperne di più.",shape=box,color=blue];
		j2000631793 -> j1368598903;
	j2095541547 [label="Penso che tu stia mentendo per non rovinarmi la giornata, quindi... non insisterò per saperne di più.",shape=box,color=blue];
		j2095541547 -> j1368598903;
	j4070387160 [label="Perdonami. Questo è... inappropriato. Sono une Sœur de Sol, e non devo perdere la pazienza e lasciare andare la lingua in questo modo.",shape=box,color=blue];
		j4070387160 -> j4187669951;
	j1368598903 [label="+5 Chemistry",color=orange];
		j1368598903 -> j1075951470;
	j4187669951 [label="+5 Chemistry",color=orange];
		j4187669951 -> j3495424346;
	j1075951470 [label="Vorrei mantenere quel poco di dignità che mi è concessa in questa conversazione.",shape=box,color=blue];
		j1075951470 -> j1656918953;
	j3495424346 [label="La mia rabbia non è rivolta a te. E ti sarò sempre grata per la tua onestà.",shape=box,color=blue];
		j3495424346 -> j643309349;
	j1656918953 [label="Se sei venuto a parlarmi della lite che ho avuto con il M'sieur Tagfer, non negherò che sia avvenuta.",shape=box,color=blue];
		j1656918953 -> j643309349;
	j643309349 [label="Immagino che il diavolo ti abbia detto di cosa si trattava?",shape=box,color=blue];
		j643309349 -> j370765590;
	j370765590 [label="Evaluate expressions",color=orange];
		j370765590 -> j4237762117 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j2780509490 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j118193290 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j4237762117 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j4237762117 [label="false",color=purple];
		j370765590 -> j1595994713 [label="false",color=purple];
	j4237762117 [label="Non c'era bisogno che me lo dicesse, me lo sono immaginato. Entrati.",shape=box,color=red];
		j4237762117 -> j803621102;
	j2780509490 [label="Lo ha fatto. Anche se sembrava più preoccupato per te che per qualsiasi altra cosa.",shape=box,color=red];
		j2780509490 -> j1540715524;
	j118193290 [label="Certo. È preoccupato per la situazione perché credo che provi pena per i Cavia. ",shape=box,color=red];
		j118193290 -> j1942451127;
	j1595994713 [label="No, in realtà. Ha solo detto che avrei dovuto vedere come stavi.",shape=box,color=red];
		j1595994713 -> j3602203549;
	j803621102 [label="Oui. M'sieur Tagfer stava discutendo sull'argomento de le Cardinal.",shape=box,color=blue];
		j803621102 -> j77739641;
		j803621102 -> j1538758164;
	j1540715524 [label="Non so perché il diavolo vorrebbe farti credere una cosa del genere. O a quale scopo.",shape=box,color=blue];
		j1540715524 -> j90453996;
	j1942451127 [label="Il diavolo vede tre animali feriti e sa che può facilmente utilizzare il suo carisma per farsi adulare.",shape=box,color=blue];
		j1942451127 -> j2809365230;
	j3602203549 [label="Non so perché il diavolo ti abbia detto di fare una cosa del genere. O a quale scopo.",shape=box,color=blue];
		j3602203549 -> j1313387972;
	j77739641 [label="Tagfer non è il più grande sostenitore di Entrati, no.",shape=box,color=red];
		j77739641 -> j3983334348;
	j1538758164 [label="Immagino fosse una discussione molto accesa.",shape=box,color=red];
		j1538758164 -> j2391977185;
	j90453996 [label="Tutti gli atti di presunta gentilezza nei miei confronti da parte del diavolo sono al servizio del suo scopo - mettermi contro le Cardinal. Lo so. ",shape=box,color=blue];
		j90453996 -> j2593213379;
	j2809365230 [label="Lo fa per volgere le sorti della marea contro di me. Vuole corrompermi contro le Cardinal. Per vedermi voltargli le spalle. Lo so.",shape=box,color=blue];
		j2809365230 -> j2593213379;
	j1313387972 [label="Ma... non è di questo che volevo discutere. La lite riguardava le Cardinal. ",shape=box,color=blue];
		j1313387972 -> j77739641;
		j1313387972 -> j1538758164;
	j3983334348 [label="Ed è questo che non capisco ! Guarda cosa gli è stato dato !",shape=box,color=blue];
		j3983334348 -> j956613108;
		j3983334348 -> j2082089736;
	j2391977185 [label="Oui ! Mi ha chiamata sciocca. Mi ha detto che non sono altro che una bambina.",shape=box,color=blue];
		j2391977185 -> j1178477748;
		j2391977185 -> j956613108;
	j2593213379 [label="Ed era proprio sull'argomento le Cardinal che io e il M'sieur Tagfer stavamo discutendo.",shape=box,color=blue];
		j2593213379 -> j77739641;
		j2593213379 -> j1538758164;
	j956613108 [label="Per cortesia, cominciamo dall'inizio. Come è iniziata la lite?",shape=box,color=red];
		j956613108 -> j2273146549;
	j2082089736 [label="Posso iniziare a capire perché è avvenuta questa lite.",shape=box,color=red];
		j2082089736 -> j2273146549;
	j1178477748 [label="Ti ha davvero chiamata sciocca e bambina?",shape=box,color=red];
		j1178477748 -> j3696682499;
	j2273146549 [label="Sì. Ho menzionato le Cardinal e basta. ",shape=box,color=blue];
		j2273146549 -> j1470159104;
	j3696682499 [label="Forse, peggio.",shape=box,color=blue];
		j3696682499 -> j601826561;
	j1470159104 [label="M'sieur Tagfer ha alzato gli occhi al cielo e ha sbuffato. Gli ho chiesto di spiegare la sua derisione.",shape=box,color=blue];
		j1470159104 -> j34105251;
	j601826561 [label="\"Sei una bambina, Marie! Innocente. Sarai dipendente dagli altri per tutta la vita. Rannicchiata nel tuo piccolo nido di fede cieca !\"",shape=box,color=blue];
		j601826561 -> j1038683535;
	j34105251 [label="\"Albrecht è uno sporco e puzzolente bugiardo !\"",shape=box,color=blue];
		j34105251 -> j3463559740;
	j1038683535 [label="\"Sopravvivere con ciò che gli adulti hanno masticato e sputato nella tua spalancata bocca credulona!\"",shape=box,color=blue];
		j1038683535 -> j471012429;
	j3463559740 [label="Et j'ai répondu: \"Guarda i doni che ti sono stati dati: i doni del pensiero, del linguaggio, del Sé!\"",shape=box,color=blue];
		j3463559740 -> j67749484;
	j471012429 [label="Boolean MarieEntrati3 is now true.",color=orange];
		j471012429 -> j819617626;
		j471012429 -> j3118015872;
		j471012429 -> j1771612969;
	j67749484 [label="\"Dovresti essere grato a le Cardinal per tutto ciò di cui ti ha benedetto.\"",shape=box,color=blue];
		j67749484 -> j3015227405;
		j67749484 -> j716498963;
	j819617626 [label="Tagfer conosce solo la sua versione dei fatti. Le vere motivazioni o opinioni di Entrati non sono state... spiegate chiaramente.",shape=box,color=red];
		j819617626 -> j789324263;
	j3118015872 [label="So cosa provi all'idea di essere \"dipendente\" dagli altri e mi dispiace che ti abbia detto quelle cose.",shape=box,color=red];
		j3118015872 -> j4088624599;
	j1771612969 [label="Tagfer ha buone ragioni per pensarla così.",shape=box,color=red];
		j1771612969 -> j946548047;
	j3015227405 [label="E come l'ha presa?",shape=box,color=red];
		j3015227405 -> j601826561;
	j716498963 [label="Oh, no...",shape=box,color=red];
		j716498963 -> j601826561;
