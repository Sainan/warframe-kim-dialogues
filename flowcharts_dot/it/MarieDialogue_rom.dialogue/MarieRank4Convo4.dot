	2297 [label="Roathe.",shape=box,color=red];
		2297 -> 2293;
	2298 [label="Si je le pouvais, je prendrais ce couteau qu'il aime tant utiliser pour agacer les autres et je le fourrerais là où seule Lua peut le voir !",shape=box,color=blue];
		2298 -> 2301;
	2299 [label="Penso che lo sia, ma credo che tu non voglia rovinarmi la giornata. Quindi... non insisterò per saperne di più.",shape=box,color=blue];
		2299 -> 2302;
	2300 [label="Penso che tu stia mentendo per non rovinarmi la giornata, quindi... non insisterò per saperne di più.",shape=box,color=blue];
		2300 -> 2302;
	2301 [label="Perdonami. Questo è... inappropriato. Sono une Sœur de Sol, e non devo perdere la pazienza e lasciare andare la lingua in questo modo.",shape=box,color=blue];
		2301 -> 2303;
	2302 [label="+5 Chemistry",color=orange];
		2302 -> 2304;
	2303 [label="+5 Chemistry",color=orange];
		2303 -> 2305;
	2304 [label="Vorrei mantenere quel poco di dignità che mi è concessa in questa conversazione.",shape=box,color=blue];
		2304 -> 2306;
	2305 [label="La mia rabbia non è rivolta a te. E ti sarò sempre grata per la tua onestà.",shape=box,color=blue];
		2305 -> 2307;
	2306 [label="Se sei venuto a parlarmi della lite che ho avuto con il M'sieur Tagfer, non negherò che sia avvenuta.",shape=box,color=blue];
		2306 -> 2307;
	2307 [label="Immagino che il diavolo ti abbia detto di cosa si trattava?",shape=box,color=blue];
		2307 -> 2308;
	2308 [label="Evaluate expressions",color=orange];
		2308 -> 2310 [label="MarieTagferFight2a",color=purple];
		2308 -> 2311 [label="MarieTagferFight2a",color=purple];
		2308 -> 2309 [label="MarieTagferFight2b",color=purple];
		2308 -> 2310 [label="MarieTagferFight2b",color=purple];
		2308 -> 2310 [label="false",color=purple];
		2308 -> 2312 [label="false",color=purple];
	2310 [label="Non c'era bisogno che me lo dicesse, me lo sono immaginato. Entrati.",shape=box,color=red];
		2310 -> 2314;
	2311 [label="Lo ha fatto. Anche se sembrava più preoccupato per te che per qualsiasi altra cosa.",shape=box,color=red];
		2311 -> 2315;
	2309 [label="Certo. È preoccupato per la situazione perché credo che provi pena per i Cavia. ",shape=box,color=red];
		2309 -> 2313;
	2312 [label="No, in realtà. Ha solo detto che avrei dovuto vedere come stavi.",shape=box,color=red];
		2312 -> 2316;
	2314 [label="Oui. M'sieur Tagfer stava discutendo sull'argomento de le Cardinal.",shape=box,color=blue];
		2314 -> 2318;
		2314 -> 2319;
	2315 [label="Non so perché il diavolo vorrebbe farti credere una cosa del genere. O a quale scopo.",shape=box,color=blue];
		2315 -> 2320;
	2313 [label="Il diavolo vede tre animali feriti e sa che può facilmente utilizzare il suo carisma per farsi adulare.",shape=box,color=blue];
		2313 -> 2317;
	2316 [label="Non so perché il diavolo ti abbia detto di fare una cosa del genere. O a quale scopo.",shape=box,color=blue];
		2316 -> 2321;
	2318 [label="Tagfer non è il più grande sostenitore di Entrati, no.",shape=box,color=red];
		2318 -> 2323;
	2319 [label="Immagino fosse una discussione molto accesa.",shape=box,color=red];
		2319 -> 2324;
	2320 [label="Tutti gli atti di presunta gentilezza nei miei confronti da parte del diavolo sono al servizio del suo scopo - mettermi contro le Cardinal. Lo so. ",shape=box,color=blue];
		2320 -> 2322;
	2317 [label="Lo fa per volgere le sorti della marea contro di me. Vuole corrompermi contro le Cardinal. Per vedermi voltargli le spalle. Lo so.",shape=box,color=blue];
		2317 -> 2322;
	2321 [label="Ma... non è di questo che volevo discutere. La lite riguardava le Cardinal. ",shape=box,color=blue];
		2321 -> 2318;
		2321 -> 2319;
	2323 [label="Ed è questo che non capisco ! Guarda cosa gli è stato dato !",shape=box,color=blue];
		2323 -> 2325;
		2323 -> 2326;
	2324 [label="Oui ! Mi ha chiamata sciocca. Mi ha detto che non sono altro che una bambina.",shape=box,color=blue];
		2324 -> 2327;
		2324 -> 2325;
	2322 [label="Ed era proprio sull'argomento le Cardinal che io e il M'sieur Tagfer stavamo discutendo.",shape=box,color=blue];
		2322 -> 2318;
		2322 -> 2319;
	2325 [label="Per cortesia, cominciamo dall'inizio. Come è iniziata la lite?",shape=box,color=red];
		2325 -> 2328;
	2326 [label="Posso iniziare a capire perché è avvenuta questa lite.",shape=box,color=red];
		2326 -> 2328;
	2327 [label="Ti ha davvero chiamata sciocca e bambina?",shape=box,color=red];
		2327 -> 2329;
	2328 [label="Sì. Ho menzionato le Cardinal e basta. ",shape=box,color=blue];
		2328 -> 2330;
	2329 [label="Forse, peggio.",shape=box,color=blue];
		2329 -> 2331;
	2330 [label="M'sieur Tagfer ha alzato gli occhi al cielo e ha sbuffato. Gli ho chiesto di spiegare la sua derisione.",shape=box,color=blue];
		2330 -> 2332;
	2331 [label="\"Sei una bambina, Marie! Innocente. Sarai dipendente dagli altri per tutta la vita. Rannicchiata nel tuo piccolo nido di fede cieca !\"",shape=box,color=blue];
		2331 -> 2333;
	2332 [label="\"Albrecht è uno sporco e puzzolente bugiardo !\"",shape=box,color=blue];
		2332 -> 2334;
	2333 [label="\"Sopravvivere con ciò che gli adulti hanno masticato e sputato nella tua spalancata bocca credulona!\"",shape=box,color=blue];
		2333 -> 2335;
	2334 [label="Et j'ai répondu: \"Guarda i doni che ti sono stati dati: i doni del pensiero, del linguaggio, del Sé!\"",shape=box,color=blue];
		2334 -> 2336;
	2335 [label="Update boolean MarieEntrati3",color=orange];
		2335 -> 2337;
		2335 -> 2338;
		2335 -> 2339;
	2336 [label="\"Dovresti essere grato a le Cardinal per tutto ciò di cui ti ha benedetto.\"",shape=box,color=blue];
		2336 -> 2340;
		2336 -> 2341;
	2337 [label="Tagfer conosce solo la sua versione dei fatti. Le vere motivazioni o opinioni di Entrati non sono state... spiegate chiaramente.",shape=box,color=red];
		2337 -> 2342;
	2338 [label="So cosa provi all'idea di essere \"dipendente\" dagli altri e mi dispiace che ti abbia detto quelle cose.",shape=box,color=red];
