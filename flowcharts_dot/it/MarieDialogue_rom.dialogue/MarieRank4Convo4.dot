		2397 -> 2400;
	2398 [label="Chat ends.",color=orange];
	2399 [label="L'ultimo della sua specie. Etichettato per lo smaltimento. La sua compagna? Minn? L'unica altra rimasta? Morta nell'esperimento.",shape=box,color=red];
		2399 -> 2401;
