		j946548047 -> j2687770740 [label="MarieEntratiMonster2",color=purple];
		j946548047 -> j2437516404 [label="MarieEntratiFan1",color=purple];
		j946548047 -> j2437516404 [label="MarieEntratiFan2",color=purple];
		j946548047 -> j3984543430 [label="MarieEntratiNeutral",color=purple];
		j946548047 -> j1098483434 [label="false",color=purple];
	j1884873048 [label="Non gliene dà comunque il diritto ! Non so se si rende conto di quanto profondamente mi abbiano ferita le sue parole. En outre -",shape=box,color=blue];
		j1884873048 -> j946548047;
	j3157706324 [label="Merci, non so se lui sa quanto profondamente mi ha ferita con le sue parole.",shape=box,color=blue];
		j3157706324 -> j267509185;
		j3157706324 -> j3728206943;
		j3157706324 -> j2318339368;
	j3068278131 [label="Se questo è il benvenuto che le Cardinal attende con ansia al suo ritorno, non c'è da stupirsi che rimanga lontano !",shape=box,color=blue];
		j3068278131 -> j3289710581;
		j3068278131 -> j825393499;
	j2687770740 [label="E sono certa che in tutto questo tu sia dalla parte del M'sieur Tagfer, non ? Credi che le Cardinal sia un mostro, proprio come la bestia.",shape=box,color=blue];
		j2687770740 -> j3289710581;
		j2687770740 -> j1145517456;
	j2437516404 [label="Sono sorpresa, je pensais que tu étais de mon côté ! Non stavi difendendo la causa de le Cardinal insieme a me solo un momento fa ?",shape=box,color=blue];
		j2437516404 -> j3578340904;
	j3984543430 [label="Cosa importa, come hai detto prima ? Dobbiamo servirlo nelle sue azioni e giudicarlo in seguito. Questa lotta è inutile, non ?",shape=box,color=blue];
		j3984543430 -> j1042595412;
		j3984543430 -> j1924930236;
	j1098483434 [label="So che sono stati creati dal Void per mano de le Cardinal. A tutti noi è stato dato un dono da le Cardinal che è una maledizione se visto con il cuore spezzato !",shape=box,color=blue];
		j1098483434 -> j3658767220;
	j267509185 [label="E sai quanto profondamente lo hanno fatto i tuoi? Conosci tutta la loro storia?",shape=box,color=red];
		j267509185 -> j1098483434;
	j3728206943 [label="E quello che hai detto lo ha altrettanto ferito.",shape=box,color=red];
		j3728206943 -> j2668878111;
	j2318339368 [label="Sinceramente sono dalla tua parte, ma... dobbiamo cercare di mantenere la pace, Marie.",shape=box,color=red];
		j2318339368 -> j3039766485;
		j2318339368 -> j179016508;
	j3289710581 [label="Marie, ti prego. Non sto cercando di litigare. Sto solo cercando di farti capire cosa hanno passato.",shape=box,color=red];
		j3289710581 -> j2996376550;
	j825393499 [label="Se Entrati fosse rimasto ad aiutare a ripulire i suoi pasticci, forse avrebbe più amici in questo mondo.",shape=box,color=red];
		j825393499 -> j3028947083;
	j1145517456 [label="Sì, sto dalla sua parte. Perché non stai ascoltando la ragione. Devi capire che \"le Cardinal\" non è quello che sembra.",shape=box,color=red];
		j1145517456 -> j2996376550;
	j3578340904 [label="Si è trattato di un grande inganno da parte tua ? Hai giocato a un jeu con la piccola Marie ?",shape=box,color=blue];
		j3578340904 -> j3657776593;
		j3578340904 -> j76679358;
	j1042595412 [label="È importante se non ci sarà più nessuno intorno a noi quando saremo dall'altra parte. Hanno sopportato tanto.",shape=box,color=red];
		j1042595412 -> j2996376550;
	j1924930236 [label="Sono sicuro che se ne dimenticherà. E anche tu.",shape=box,color=red];
		j1924930236 -> j371794509;
	j3658767220 [label="Siamo stati tutti abbandonati da lui ! Dimmi, come sono stati così tanto ingiustamente danneggiati, che io debba tollerare un tale odio ?!",shape=box,color=blue];
		j3658767220 -> j1639327012;
	j2668878111 [label="Oui ?! Allora dimmi perché !",shape=box,color=blue];
		j2668878111 -> j1098483434;
	j3039766485 [label="La situazione che i Cavia hanno vissuto è stata... dura.",shape=box,color=red];
		j3039766485 -> j1098483434;
	j179016508 [label="Sono animali, anche se dotati di intelligenza, sono pur sempre animali. Le loro capacità sono limitate.",shape=box,color=red];
		j179016508 -> j706457059;
	j2996376550 [label="Oui ? Allora interpreta il ruolo de La Lumière Sacrée de Sol e scaccia l'oscurità ! Illumina la piccola sciocca Marie!",shape=box,color=blue];
		j2996376550 -> j1098483434;
	j3028947083 [label="Oui ! Sì, non è sufficiente che lui stia tentando di salvare l'universo conosciuto da una divinità del Void, non ?!",shape=box,color=blue];
		j3028947083 -> j4098712457;
	j3657776593 [label="No, non sto mentendo. Sono d'accordo con te. Dico solo che la loro situazione è stata... difficile.",shape=box,color=red];
		j3657776593 -> j2996376550;
	j76679358 [label="No, non è un gioco...? Di Entrati non ci si può fidare, e non so in quale altro modo convincerti se non fingendo di essere dalla tua parte.",shape=box,color=red];
		j76679358 -> j206780859;
	j371794509 [label="Non ! Hai iniziato questa conversazione e la continuerai. Explique !",shape=box,color=blue];
		j371794509 -> j1098483434;
	j1639327012 [label="Evaluate expressions",color=orange];
