		2344 -> 2350 [label="false",color=purple];
	2345 [label="Non gliene dà comunque il diritto ! Non so se si rende conto di quanto profondamente mi abbiano ferita le sue parole. En outre -",shape=box,color=blue];
		2345 -> 2344;
	2346 [label="Merci, non so se lui sa quanto profondamente mi ha ferita con le sue parole.",shape=box,color=blue];
		2346 -> 2352;
		2346 -> 2353;
		2346 -> 2354;
	2347 [label="Se questo è il benvenuto che le Cardinal attende con ansia al suo ritorno, non c'è da stupirsi che rimanga lontano !",shape=box,color=blue];
		2347 -> 2355;
		2347 -> 2356;
	2348 [label="E sono certa che in tutto questo tu sia dalla parte del M'sieur Tagfer, non ? Credi che le Cardinal sia un mostro, proprio come la bestia.",shape=box,color=blue];
		2348 -> 2357;
		2348 -> 2358;
	2349 [label="Sono sorpresa, je pensais que tu étais de mon côté ! Non stavi difendendo la causa de le Cardinal insieme a me solo un momento fa ?",shape=box,color=blue];
		2349 -> 2359;
	2351 [label="Cosa importa, come hai detto prima ? Dobbiamo servirlo nelle sue azioni e giudicarlo in seguito. Questa lotta è inutile, non ?",shape=box,color=blue];
		2351 -> 2361;
		2351 -> 2362;
	2350 [label="So che sono stati creati dal Void per mano de le Cardinal. A tutti noi è stato dato un dono da le Cardinal che è una maledizione se visto con il cuore spezzato !",shape=box,color=blue];
		2350 -> 2360;
	2352 [label="E sai quanto profondamente lo hanno fatto i tuoi? Conosci tutta la loro storia?",shape=box,color=red];
		2352 -> 2350;
	2353 [label="E quello che hai detto lo ha altrettanto ferito.",shape=box,color=red];
		2353 -> 2363;
	2354 [label="Sinceramente sono dalla tua parte, ma... dobbiamo cercare di mantenere la pace, Marie.",shape=box,color=red];
		2354 -> 2364;
		2354 -> 2365;
	2355 [label="Marie, ti prego. Non sto cercando di litigare. Sto solo cercando di farti capire cosa hanno passato.",shape=box,color=red];
		2355 -> 2366;
	2356 [label="Se Entrati fosse rimasto ad aiutare a ripulire i suoi pasticci, forse avrebbe più amici in questo mondo.",shape=box,color=red];
		2356 -> 2367;
	2357 [label="Marie, ti prego. Non sto cercando di litigare. Sto solo cercando di farti capire cosa hanno passato.",shape=box,color=red];
		2357 -> 2366;
	2358 [label="Sì, sto dalla sua parte. Perché non stai ascoltando la ragione. Devi capire che \"le Cardinal\" non è quello che sembra.",shape=box,color=red];
		2358 -> 2366;
	2359 [label="Si è trattato di un grande inganno da parte tua ? Hai giocato a un jeu con la piccola Marie ?",shape=box,color=blue];
		2359 -> 2368;
		2359 -> 2369;
	2361 [label="È importante se non ci sarà più nessuno intorno a noi quando saremo dall'altra parte. Hanno sopportato tanto.",shape=box,color=red];
		2361 -> 2366;
	2362 [label="Sono sicuro che se ne dimenticherà. E anche tu.",shape=box,color=red];
		2362 -> 2371;
	2360 [label="Siamo stati tutti abbandonati da lui ! Dimmi, come sono stati così tanto ingiustamente danneggiati, che io debba tollerare un tale odio ?!",shape=box,color=blue];
		2360 -> 2370;
	2363 [label="Oui ?! Allora dimmi perché !",shape=box,color=blue];
		2363 -> 2350;
	2364 [label="La situazione che i Cavia hanno vissuto è stata... dura.",shape=box,color=red];
		2364 -> 2350;
	2365 [label="Sono animali, anche se dotati di intelligenza, sono pur sempre animali. Le loro capacità sono limitate.",shape=box,color=red];
		2365 -> 2372;
	2366 [label="Oui ? Allora interpreta il ruolo de La Lumière Sacrée de Sol e scaccia l'oscurità ! Illumina la piccola sciocca Marie!",shape=box,color=blue];
		2366 -> 2350;
	2367 [label="Oui ! Sì, non è sufficiente che lui stia tentando di salvare l'universo conosciuto da una divinità del Void, non ?!",shape=box,color=blue];
		2367 -> 2373;
	2368 [label="No, non sto mentendo. Sono d'accordo con te. Dico solo che la loro situazione è stata... difficile.",shape=box,color=red];
		2368 -> 2366;
	2369 [label="No, non è un gioco...? Di Entrati non ci si può fidare, e non so in quale altro modo convincerti se non fingendo di essere dalla tua parte.",shape=box,color=red];
		2369 -> 2374;
	2371 [label="Non ! Hai iniziato questa conversazione e la continuerai. Explique !",shape=box,color=blue];
