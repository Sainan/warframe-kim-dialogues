		j3807926190 -> j3265963186;
	j2913582585 [label="Bird 3? È un uccello con un numero come nome. Fibonacci si è dato il suo nome.",shape=box,color=red];
		j2913582585 -> j3969527284;
	j3400176093 [label="Ecco cosa erano i Cavia per Entrati. Animali da laboratorio usa e getta. \"Tagfer?\" Significa \"Etichettato per lo smaltimento\".",shape=box,color=red];
		j3400176093 -> j2913582585;
	j3316644436 [label="Che la tua sofferenza avesse importanza? I Cavia erano - e sono - inutili per Entrati. Animali da laboratorio usa e getta. \"Tagfer?\" Significa \"Etichettato per lo smaltimento\".",shape=box,color=red];
		j3316644436 -> j2913582585;
	j1159178103 [label="Per Entrati, i Cavia erano solo animali da laboratorio usa e getta. Senza valore. ''Tagfer?'' Significa ''Etichettato per lo smaltimento.''",shape=box,color=red];
		j1159178103 -> j2913582585;
