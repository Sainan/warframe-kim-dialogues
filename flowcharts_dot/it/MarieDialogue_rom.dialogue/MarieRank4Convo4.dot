		j1639327012 -> j443570023 [label="MarrieLyonSuffering3",color=purple];
		j1639327012 -> j443570023 [label="false",color=purple];
	j706457059 [label="Se stai cercando di ispirarmi a simpatizzare con loro e a rivolgere la mia ira contro di te, sono improvvisamente tentata.",shape=box,color=blue];
		j706457059 -> j4098712457;
	j4098712457 [label="Forse è meglio finirla qui, prima che gli animi prendano il sopravvento.",shape=box,color=blue];
		j4098712457 -> "Chat ends.";
	j206780859 [label="Oui ? Beh, sono lieta di dirti che hai fallito.",shape=box,color=blue];
		j206780859 -> j1509439757;
	j443570023 [label="I Cavia erano incidenti creati da esperimenti. Animali da laboratorio che non avrebbero mai dovuto esistere. Il Void ha dato loro l'intelligenza.",shape=box,color=red];
		j443570023 -> j3037047368;
	j2650494098 [label="Tu stessa hai detto ''Essere privi di nome è la forma più estrema di crudeltà.'' Entrati non si è mai preoccupato di dar loro un nome, tanto erano inutili.",shape=box,color=red];
		j2650494098 -> j4188737834;
	j2932686152 [label="Mi hai raccontato la storia di come sei cresciuta per strada. Di come la tua famiglia ti ha cacciata di casa perché non eri abbastanza per loro.",shape=box,color=red];
		j2932686152 -> j244909786;
	j384367700 [label="Pensa a come ti sentiresti se fossi stata semplicemente trasformata in un protoframe contro la tua volontà e poi abbandonata?",shape=box,color=red];
		j384367700 -> j3782338740;
	j4030603530 [label="Immagina come ti sentiresti se Entrati si presentasse all'improvviso, trasformasse Lyon in un protoframe e lo abbandonasse?",shape=box,color=red];
		j4030603530 -> j110291802;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j3037047368 [label="E quando Entrati vide cosa aveva fatto? Quando si rese conto di cosa aveva creato? Questi poveri animali, che parlavano la lingua del Void, malati dall'esposizione?",shape=box,color=red];
		j3037047368 -> j3807926190;
	j4188737834 [label="Per lui erano solo cose. Cose da usare e buttare via. \"Tagfer?\" Significa \"Etichettato per lo smaltimento\".",shape=box,color=red];
		j4188737834 -> j2913582585;
	j244909786 [label="La tua famiglia pensava che tu non valessi niente.",shape=box,color=red];
		j244909786 -> j3400176093;
	j3782338740 [label="Immagina cosa avrebbe significato avere l'Infestazione nel sangue, soffrire, senza che importasse a nessuno?",shape=box,color=red];
		j3782338740 -> j3316644436;
	j110291802 [label="Usato come un esperimento scientifico a buon mercato, per poi lavarsene le mani? Avete potuto contare l'uno sull'altra prima e dopo il cambiamento. I Cavia no.",shape=box,color=red];
		j110291802 -> j1159178103;
