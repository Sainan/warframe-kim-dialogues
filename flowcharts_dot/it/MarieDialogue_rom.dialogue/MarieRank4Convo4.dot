		j3969527284 -> j1036188795;
	j298316876 [label="L'ultimo della sua specie. Etichettato per lo smaltimento. La sua compagna? Minn? L'unica altra rimasta? Morta nell'esperimento.",shape=box,color=red];
		j298316876 -> j1330252098;
	j1036188795 [label="È solo grazie a Loid che sono ancora vivi. Li ha preservati perché non è riuscito a sopprimerli \"secondo le istruzioni di Entrati\".",shape=box,color=red];
		j1036188795 -> j1670433775;
