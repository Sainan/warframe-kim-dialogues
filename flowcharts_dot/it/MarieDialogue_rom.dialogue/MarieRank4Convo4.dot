	"Chat ends." [color=orange];
	j2800846738 [label="Oui, anche se penso di sapere di cosa si tratta... mi sono comportata male. Chi te l'ha detto ?",shape=box,color=blue];
		j2800846738 -> j2564509369;
		j2800846738 -> j3465789796;
		j2800846738 -> j2881078968;
	j2815078440 [label="Bien sûr, ce salaud de diable ouvre sa bouche et vous raconte tout ! Il ne cherche qu'à m'embarrasser !",shape=box,color=blue];
		j2815078440 -> j2447770036;
	j2564509369 [label="Non è importante.",shape=box,color=red];
		j2564509369 -> j2000631793;
