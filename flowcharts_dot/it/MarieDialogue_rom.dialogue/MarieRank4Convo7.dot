		1873 -> 1876;
	1874 [label="Bien ! Almeno sarò tranquilla sapendo che ci sono altri occhi che osservano quel diavolo. Potrebbe aiutarmi a dormire. Merci.",shape=box,color=blue];
		1874 -> 1877;
	1875 [label="Oui, ma mi chiedo quale sarà il vero costo di quell'alleanza alla fine. Potresti non essere contento di averla pagata.",shape=box,color=blue];
		1875 -> 1878;
	1876 [label="Oui... suppongo che tu abbia ragione. Non possiamo spaventarci senza ragione. Dobbiamo schierarci fianco a fianco con chiunque voglia vedere l'Indifferenza sconfitta.",shape=box,color=blue];
		1876 -> 1879;
	1877 [label="Update boolean MarieRoatheNoTrust",color=orange];
		1877 -> 1880;
	1878 [label="Vorrei solo consigliarti di essere cauto... è un mostro, che indossa la pelle di un gentiluomo. Stai attento con lui, s'il te plaît ?",shape=box,color=blue];
