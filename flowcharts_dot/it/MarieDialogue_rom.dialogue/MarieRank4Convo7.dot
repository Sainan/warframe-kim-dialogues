		1919 -> 1910;
	1920 [label="Add -1 to Thermostat",color=orange];
		1920 -> 1910;
	1921 [label="Devo andare. Ma te lo dico ancora una volta - fai attenzione. Per il mio bene, non per il tuo, d'accord ?",shape=box,color=blue];
		1921 -> 1922;
