	1899 [label="Potresti pensare che sia un diavolo, ma nella sua mente non potrebbe essere più lontano dalla verità.",shape=box,color=red];
		1899 -> 1898;
	1900 [label="Oui, non amo coloro che si crogiolano nella morte. E trovo allarmante la sua smania di spargere sangue. E altrettanto inquietante è il fatto che tu non lo veda così.",shape=box,color=blue];
		1900 -> 1903;
	1902 [label="E credo che coloro che comandano uno qualsiasi di questi \"Corpus\" o \"Grineer\" contro cui combatti direbbero lo stesso. Non pensano di avere torto.",shape=box,color=blue];
		1902 -> 1904;
	1901 [label="E credo che coloro che comandano uno qualsiasi di questi \"Corpus\" o \"Grin-ire\" contro cui combatti direbbero lo stesso. Non pensano di avere torto.",shape=box,color=blue];
		1901 -> 1904;
	1903 [label="È troppo facile adattare la via dell'abnegazione al peccato della violenza, rifiutarne l'orrore, dire che non ha senso in nome di ''ciò che conta''.",shape=box,color=blue];
		1903 -> 1905;
	1904 [label="Credono che le loro azioni siano giuste, buone e necessarie. Come si può tollerare un diavolo ma non un altro ?",shape=box,color=blue];
		1904 -> 1906;
		1904 -> 1907;
		1904 -> 1908;
		1904 -> 1909;
	1905 [label="Andare fieri dell'atto in sé... è troppo per me. Non provo piacere quando devo togliere una vita, lui sì. Quindi in questo senso ? Siamo molto diversi.",shape=box,color=blue];
		1905 -> 1910;
	1906 [label="Cercherò di fermarlo quando farà cose con cui non sono d'accordo. Ma... combatterò al suo fianco quando sarà necessario.",shape=box,color=red];
		1906 -> 1911;
	1907 [label="Non credo che questi gruppi siano ''buoni'' o ''cattivi'' per definizione. Lo sono solo per le azioni che scelgono di intraprendere.",shape=box,color=red];
		1907 -> 1912;
	1908 [label="Non spetta a me affermare che alcune azioni sono ''buone'' e altre ''cattive''. Faccio quello che faccio per proteggere le persone che hanno bisogno di protezione.",shape=box,color=red];
		1908 -> 1911;
	1909 [label="Mi stai chiedendo di giudicare un intero gruppo di persone in base agli stessi meriti che userei per giudicare un individuo.",shape=box,color=red];
		1909 -> 1912;
	1910 [label="Posso solo pregare che non sia troppo tardi se il diavolo decide di piantarmi quel coltello nelle costole. Non vorrei che i tuoi ultimi pensieri fossero ''Marie mi aveva avvertito''.",shape=box,color=blue];
		1910 -> 1913;
		1910 -> 1914;
	1911 [label="E credi che il diavolo non sia una minaccia ? Che non sia pericoloso per chi lo circonda ? Potrebbe recare molto danno.",shape=box,color=blue];
		1911 -> 1915;
		1911 -> 1916;
	1912 [label="E che dire degli atti orribili che ha commesso ? Tutte le morti, i massacri ? Erano azioni giustificate nella tua mente ?",shape=box,color=blue];
		1912 -> 1916;
	1913 [label="Non lo farà. E se ci prova, lo fermerò.",shape=box,color=red];
		1913 -> 1917;
	1914 [label="Ti prometto che non saranno questi i miei ultimi pensieri.",shape=box,color=red];
		1914 -> 1918;
	1915 [label="Se arriverà il momento in cui si rivolterà contro di noi, agirò. Fino ad allora, ha dimostrato di essere solo un alleato. Anche se... un po' melodrammatico.",shape=box,color=red];
		1915 -> 1919;
	1916 [label="Non vedo la sua pericolosità come un problema. È un'arma. E le armi possono essere utilizzare per uccidere o per proteggere.",shape=box,color=red];
		1916 -> 1920;
	1917 [label="Ti adoro per la fiducia che hai in te stesso, anche se mi rammarrico che tu abbia fiducia in lui. Quindi a mia volta, suppongo che avrò fiducia in te.",shape=box,color=blue];
		1917 -> 1921;
	1918 [label="Credo che tu non intenda queste parole nel senso che speravo, ma non voglio trarne troppo vantaggio.",shape=box,color=blue];
