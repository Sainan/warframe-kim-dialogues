	1894 [label="È un soldato di alto rango e un personaggio dell'alta società. Ed entrambe queste cose richiedono a volte di prendere decisioni un po' oscure.",shape=box,color=red];
		1894 -> 1898;
	1895 [label="Penso che una persona possa fare ciò che ritiene essere la ''cosa sbagliata'' e farlo con buone intenzioni.",shape=box,color=red];
		1895 -> 1899;
	1896 [label="Ha fatto tutto quello che ha fatto in nome della salvezza dell'Impero Orokin - e il suo ringraziamento è stato quello di essere gettato in questo pasticcio contro la sua volontà.",shape=box,color=red];
		1896 -> 1898;
