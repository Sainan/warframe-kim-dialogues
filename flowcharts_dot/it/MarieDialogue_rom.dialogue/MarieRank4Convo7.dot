		1888 -> 1893;
	1889 [label="È cresciuto in una società diversa, in un'epoca diversa, con aspettative diverse. Forse non ci piace, ma lui è quello che è.",shape=box,color=red];
		1889 -> 1894;
	1890 [label="Tu e Lyon avete accettato il siero protoframe da Entrati. Di vostra volontà. Lui no. Riesci a immaginare cosa significhi?",shape=box,color=red];
		1890 -> 1895;
		1890 -> 1896;
