	1858 [label="Questi suoi ricordi perduti, questi orrori passati di Tau... Mi preoccupo di ciò che presagiscono.",shape=box,color=blue];
		1858 -> 1860;
		1858 -> 1861;
	1863 [label="So che pensi che abbiamo scoperto tutto ciò che c'è da sapere riguardo la sua mente distrutta.",shape=box,color=blue];
		1863 -> 1866;
