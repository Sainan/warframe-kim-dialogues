	j3255816954 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j3255816954 -> j3456862860 [label="x >= 0",color=purple];
		j3255816954 -> "Chat ends." [label="x <= 0",color=purple];
		j3255816954 -> "Chat ends." [label="false",color=purple];
	j3456862860 [label="Drifter, excusez-moi... Credi davvero che sia saggio aiutare il diavolo ?",shape=box,color=blue];
		j3456862860 -> j978474643;
	"Chat ends." [color=orange];
	j978474643 [label="Non voglio respingere coloro che cercano l'assoluzione o aiuto, ma... non credo che nessuna delle due cose sia ciò che il diavolo cerca.",shape=box,color=blue];
		j978474643 -> j4106957474;
		j978474643 -> j2241309587;
		j978474643 -> j2417565631;
		j978474643 -> j4115718638;
	j4106957474 [label="E cosa pensi che stia realmente cercando?",shape=box,color=red];
		j4106957474 -> j474052919;
	j2241309587 [label="So che voi due non andate d'accordo e mi dispiace. Ma non posso certo cacciarlo via.",shape=box,color=red];
		j2241309587 -> j4000641500;
	j2417565631 [label="Roathe ha dimenticato più cose degli Orokin - letteralmente - di quante ne sapremo mai. Abbiamo bisogno di lui.",shape=box,color=red];
		j2417565631 -> j2278887726;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j474052919 [label="È un animale selvatico. Si avvicina quando gli offri del cibo e un posto caldo dove stare, ma tutto questo svanirà nel momento in cui non gli sarai più utile.",shape=box,color=blue];
		j474052919 -> j1785741175;
	j4000641500 [label="Add 1 to Thermostat counter",color=orange];
		j4000641500 -> j290112109;
	j2278887726 [label="Add -1 to Thermostat counter",color=orange];
		j2278887726 -> j474052919;
	j1785741175 [label="Ha bisogno di qualcosa da te. Da noi. ",shape=box,color=blue];
		j1785741175 -> j863296879;
	j290112109 [label="Non, e non sto nemmeno suggerendo che tu lo faccia. Semplicemente, di lui... non ci si può fidare. Ora e mai più.",shape=box,color=blue];
		j290112109 -> j474052919;
	j863296879 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j863296879 -> j4093421340 [label="x > 5",color=purple];
		j863296879 -> j31050844 [label="x <= 5",color=purple];
		j863296879 -> j31050844 [label="false",color=purple];
	j4093421340 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4093421340 -> j946374799 [label="x >= 21",color=purple];
		j4093421340 -> j991352632 [label="x < 21",color=purple];
		j4093421340 -> j991352632 [label="false",color=purple];
	j31050844 [label="Questi suoi ricordi perduti, questi orrori passati di Tau... Mi preoccupo di ciò che presagiscono.",shape=box,color=blue];
		j31050844 -> j350496086;
		j31050844 -> j2948613658;
	j946374799 [label="So che pensi che abbiamo scoperto tutto ciò che c'è da sapere riguardo la sua mente distrutta.",shape=box,color=blue];
		j946374799 -> j1497024026;
		j946374799 -> j2948613658;
	j991352632 [label="Più impariamo, più ci addentriamo nella sua mente sconvolta, più mi innervosisco, più il pericolo diventa chiaro.",shape=box,color=blue];
		j991352632 -> j2948613658;
		j991352632 -> j350496086;
	j350496086 [label="Non credo che scomparirà nel momento in cui ritroverà la memoria. C'è molto di più.",shape=box,color=red];
		j350496086 -> j3298362050;
	j2948613658 [label="Probabilmente c'è ancora molto che sta cercando. Non nei suoi ricordi, ma in noi.",shape=box,color=red];
		j2948613658 -> j2840796537;
	j1497024026 [label="Gli credo quando dice che è tutto ciò che scopriremo da questa storia. E se così fosse, perché è ancora qui?",shape=box,color=red];
		j1497024026 -> j3298362050;
	j3298362050 [label="Ammetto che mi preoccupa di più cosa intende fare con questa conoscenza, che la conoscenza in sé.",shape=box,color=blue];
		j3298362050 -> j1900118548;
	j2840796537 [label="Oui ! Questa è esattamente la mia preoccupazione. Ma cosa potrebbe essere ? A cosa gli serviamo ora ?",shape=box,color=blue];
		j2840796537 -> j1900118548;
	j1900118548 [label="In qualunque modo intenda gestire questa sua nuova esistenza, temo che voglia coinvolgerci. E vorrei solo che non ci lasciassimo accecare dalla speranza che sia in qualche modo benevolo.",shape=box,color=blue];
		j1900118548 -> j2326401075;
		j1900118548 -> j4260003158;
		j1900118548 -> j1560161567;
	j2326401075 [label="Sono con te. Non mi fido di lui.",shape=box,color=red];
		j2326401075 -> j2943332065;
	j4260003158 [label="È una persona potente e competente. Preferirei di gran lunga che fosse dalla mia parte.",shape=box,color=red];
		j4260003158 -> j3949386399;
	j1560161567 [label="Non serve a nulla chiedersi se ci tradirà - non l'ha fatto. E non chiamo le persone colpevoli per peccati che non hanno ancora commesso.",shape=box,color=red];
		j1560161567 -> j2989568760;
	j2943332065 [label="+20 Chemistry",color=orange];
		j2943332065 -> j588333322;
	j3949386399 [label="Add -1 to Thermostat counter",color=orange];
		j3949386399 -> j3144407355;
	j2989568760 [label="Add 1 to Thermostat counter",color=orange];
		j2989568760 -> j1284181347;
	j588333322 [label="Bien ! Almeno sarò tranquilla sapendo che ci sono altri occhi che osservano quel diavolo. Potrebbe aiutarmi a dormire. Merci.",shape=box,color=blue];
		j588333322 -> j3984234322;
	j3144407355 [label="Oui, ma mi chiedo quale sarà il vero costo di quell'alleanza alla fine. Potresti non essere contento di averla pagata.",shape=box,color=blue];
		j3144407355 -> j1136022715;
	j1284181347 [label="Oui... suppongo che tu abbia ragione. Non possiamo spaventarci senza ragione. Dobbiamo schierarci fianco a fianco con chiunque voglia vedere l'Indifferenza sconfitta.",shape=box,color=blue];
		j1284181347 -> j808986917;
	j3984234322 [label="Boolean MarieRoatheNoTrust is now true.",color=orange];
		j3984234322 -> "Chat ends.";
	j1136022715 [label="Vorrei solo consigliarti di essere cauto... è un mostro, che indossa la pelle di un gentiluomo. Stai attento con lui, s'il te plaît ?",shape=box,color=blue];
		j1136022715 -> j1989676700;
		j1136022715 -> j2838064528;
	j808986917 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j808986917 -> j609073598 [label=true,color=green];
		j808986917 -> j4116090124 [label=false,color=brown];
	j1989676700 [label="Penso che tu sia un po' ingiusto nei suoi confronti.",shape=box,color=red];
		j1989676700 -> j3369129191;
	j2838064528 [label="Starò attento. Lo prometto.",shape=box,color=red];
		j2838064528 -> j2572947342;
	j609073598 [label="Anche se credi che la forza che sta dietro a tutto questo non provenga da un dio ma dalla nostra mente, resta comunque una minaccia.",shape=box,color=blue];
		j609073598 -> j1136022715;
	j4116090124 [label="Anche se crede che la forza che sta dietro a tutto questo non provenga da un dio ma dalla nostra mente, resta comunque una minaccia.",shape=box,color=blue];
		j4116090124 -> j1136022715;
	j3369129191 [label="Add -1 to Thermostat counter",color=orange];
		j3369129191 -> j2746538806;
	j2572947342 [label="+20 Chemistry",color=orange];
		j2572947342 -> j3829502761;
	j2746538806 [label="Oui ? Come mai ? Non lo dico con crudeltà, sono davvero curiosa.",shape=box,color=blue];
		j2746538806 -> j278075152;
		j2746538806 -> j1625974686;
		j2746538806 -> j2367194125;
		j2746538806 -> j648213123;
	j3829502761 [label="Merci. È tutto quello che posso chiedere.",shape=box,color=blue];
		j3829502761 -> "Chat ends.";
	j278075152 [label="È cresciuto in una società diversa, in un'epoca diversa, con aspettative diverse. Forse non ci piace, ma lui è quello che è.",shape=box,color=red];
		j278075152 -> j2940108731;
	j1625974686 [label="Tu e Lyon avete accettato il siero protoframe da Entrati. Di vostra volontà. Lui no. Riesci a immaginare cosa significhi?",shape=box,color=red];
		j1625974686 -> j334439669;
		j1625974686 -> j1839669156;
		j1625974686 -> j2940108731;
	j2367194125 [label="Ha trascorso interi secoli di vita facendo ciò che riteneva necessario. Siamo semplicemente in disaccordo su cosa sia.",shape=box,color=red];
		j2367194125 -> j334439669;
		j2367194125 -> j614470988;
	j648213123 [label="Penso che sia il suo... comportamento a farti scattare. Non le sue azioni.",shape=box,color=red];
		j648213123 -> j614470988;
		j648213123 -> j334439669;
	j2940108731 [label="È un soldato di alto rango e un personaggio dell'alta società. Ed entrambe queste cose richiedono a volte di prendere decisioni un po' oscure.",shape=box,color=red];
		j2940108731 -> j681163897;
	j334439669 [label="Penso che una persona possa fare ciò che ritiene essere la ''cosa sbagliata'' e farlo con buone intenzioni.",shape=box,color=red];
		j334439669 -> j2963669104;
	j1839669156 [label="Ha fatto tutto quello che ha fatto in nome della salvezza dell'Impero Orokin - e il suo ringraziamento è stato quello di essere gettato in questo pasticcio contro la sua volontà.",shape=box,color=red];
		j1839669156 -> j681163897;
	j614470988 [label="Penso che ti dia fastidio perché è orgoglioso di ciò che ha fatto.",shape=box,color=red];
		j614470988 -> j2472047478;
	j681163897 [label="Check boolean MarieGrineer",color=orange];
		j681163897 -> j1344190631 [label=true,color=green];
		j681163897 -> j2152240625 [label=false,color=brown];
	j2963669104 [label="Potresti pensare che sia un diavolo, ma nella sua mente non potrebbe essere più lontano dalla verità.",shape=box,color=red];
		j2963669104 -> j681163897;
	j2472047478 [label="Oui, non amo coloro che si crogiolano nella morte. E trovo allarmante la sua smania di spargere sangue. E altrettanto inquietante è il fatto che tu non lo veda così.",shape=box,color=blue];
		j2472047478 -> j158458028;
	j1344190631 [label="E credo che coloro che comandano uno qualsiasi di questi \"Corpus\" o \"Grineer\" contro cui combatti direbbero lo stesso. Non pensano di avere torto.",shape=box,color=blue];
		j1344190631 -> j2171887609;
	j2152240625 [label="E credo che coloro che comandano uno qualsiasi di questi \"Corpus\" o \"Grin-ire\" contro cui combatti direbbero lo stesso. Non pensano di avere torto.",shape=box,color=blue];
		j2152240625 -> j2171887609;
	j158458028 [label="È troppo facile adattare la via dell'abnegazione al peccato della violenza, rifiutarne l'orrore, dire che non ha senso in nome di ''ciò che conta''.",shape=box,color=blue];
		j158458028 -> j992735694;
	j2171887609 [label="Credono che le loro azioni siano giuste, buone e necessarie. Come si può tollerare un diavolo ma non un altro ?",shape=box,color=blue];
		j2171887609 -> j3276450560;
		j2171887609 -> j3112039272;
		j2171887609 -> j1534265073;
		j2171887609 -> j3693062637;
	j992735694 [label="Andare fieri dell'atto in sé... è troppo per me. Non provo piacere quando devo togliere una vita, lui sì. Quindi in questo senso ? Siamo molto diversi.",shape=box,color=blue];
		j992735694 -> j1543232190;
	j3276450560 [label="Cercherò di fermarlo quando farà cose con cui non sono d'accordo. Ma... combatterò al suo fianco quando sarà necessario.",shape=box,color=red];
		j3276450560 -> j2906375409;
	j3112039272 [label="Non credo che questi gruppi siano ''buoni'' o ''cattivi'' per definizione. Lo sono solo per le azioni che scelgono di intraprendere.",shape=box,color=red];
		j3112039272 -> j1692262569;
	j1534265073 [label="Non spetta a me affermare che alcune azioni sono ''buone'' e altre ''cattive''. Faccio quello che faccio per proteggere le persone che hanno bisogno di protezione.",shape=box,color=red];
		j1534265073 -> j2906375409;
	j3693062637 [label="Mi stai chiedendo di giudicare un intero gruppo di persone in base agli stessi meriti che userei per giudicare un individuo.",shape=box,color=red];
		j3693062637 -> j1692262569;
	j1543232190 [label="Posso solo pregare che non sia troppo tardi se il diavolo decide di piantarmi quel coltello nelle costole. Non vorrei che i tuoi ultimi pensieri fossero ''Marie mi aveva avvertito''.",shape=box,color=blue];
		j1543232190 -> j796909773;
		j1543232190 -> j1712405461;
	j2906375409 [label="E credi che il diavolo non sia una minaccia ? Che non sia pericoloso per chi lo circonda ? Potrebbe recare molto danno.",shape=box,color=blue];
		j2906375409 -> j2452151365;
		j2906375409 -> j1674246030;
	j1692262569 [label="E che dire degli atti orribili che ha commesso ? Tutte le morti, i massacri ? Erano azioni giustificate nella tua mente ?",shape=box,color=blue];
		j1692262569 -> j1674246030;
	j796909773 [label="Non lo farà. E se ci prova, lo fermerò.",shape=box,color=red];
		j796909773 -> j947716151;
	j1712405461 [label="Ti prometto che non saranno questi i miei ultimi pensieri.",shape=box,color=red];
		j1712405461 -> j2260654366;
	j2452151365 [label="Se arriverà il momento in cui si rivolterà contro di noi, agirò. Fino ad allora, ha dimostrato di essere solo un alleato. Anche se... un po' melodrammatico.",shape=box,color=red];
		j2452151365 -> j579334722;
	j1674246030 [label="Non vedo la sua pericolosità come un problema. È un'arma. E le armi possono essere utilizzare per uccidere o per proteggere.",shape=box,color=red];
		j1674246030 -> j147522285;
	j947716151 [label="Ti adoro per la fiducia che hai in te stesso, anche se mi rammarrico che tu abbia fiducia in lui. Quindi a mia volta, suppongo che avrò fiducia in te.",shape=box,color=blue];
		j947716151 -> j3522304649;
	j2260654366 [label="Credo che tu non intenda queste parole nel senso che speravo, ma non voglio trarne troppo vantaggio.",shape=box,color=blue];
		j2260654366 -> j3522304649;
	j579334722 [label="Add 1 to Thermostat counter",color=orange];
		j579334722 -> j1543232190;
	j147522285 [label="Add -1 to Thermostat counter",color=orange];
		j147522285 -> j1543232190;
	j3522304649 [label="Devo andare. Ma te lo dico ancora una volta - fai attenzione. Per il mio bene, non per il tuo, d'accord ?",shape=box,color=blue];
		j3522304649 -> j367054140;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
}