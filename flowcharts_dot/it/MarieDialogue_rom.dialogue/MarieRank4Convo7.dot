		1882 -> 1886;
	1883 [label="Anche se credi che la forza che sta dietro a tutto questo non provenga da un dio ma dalla nostra mente, resta comunque una minaccia.",shape=box,color=blue];
		1883 -> 1878;
	1884 [label="Anche se crede che la forza che sta dietro a tutto questo non provenga da un dio ma dalla nostra mente, resta comunque una minaccia.",shape=box,color=blue];
