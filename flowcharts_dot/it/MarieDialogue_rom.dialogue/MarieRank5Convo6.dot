	j3788394223 [label="Lupo ! Mio lupo ! Ho incontrato Otak ! Finalmente l'ho incontrato !",shape=box,color=blue];
		j3788394223 -> j1321788099;
		j3788394223 -> j2195589690;
	j1893751631 [label="Ho incontrato Otak ! Finalmente l'ho incontrato !",shape=box,color=blue];
		j1893751631 -> j1321788099;
		j1893751631 -> j2195589690;
	j3501097736 [label="Lupo ! Mio lupo ! Il volto sulla schiena di Monsieur Necraloid ! Finalmente l'ho incontrato !",shape=box,color=blue];
		j3501097736 -> j2403230022;
		j3501097736 -> j1749599538;
		j3501097736 -> j838901048;
	j1270262176 [label="Il volto sulla schiena di Monsieur Necraloid ! Finalmente l'ho incontrato !",shape=box,color=blue];
		j1270262176 -> j2403230022;
		j1270262176 -> j1749599538;
		j1270262176 -> j838901048;
	j1321788099 [label="Come è andata la conversazione con lui?",shape=box,color=red];
		j1321788099 -> j50782883;
	j2195589690 [label="Ti è piaciuto parlare con lui?",shape=box,color=red];
		j2195589690 -> j2443258198;
	j2403230022 [label="Hai incontrato Otak? Oddio... Com'è andata?",shape=box,color=red];
		j2403230022 -> j3043885084;
	j1749599538 [label="Sono felice che finalmente vi siate incontrati. Otak può essere un po' difficile da spiegare.",shape=box,color=red];
		j1749599538 -> j3957895642;
	j838901048 [label="Povero Otak... Come è andata?",shape=box,color=red];
		j838901048 -> j3553422179;
	j50782883 [label="Lui... si è presentato a me tre volte nella stessa conversazione, come se non ci fossimo mai presentati.",shape=box,color=blue];
		j50782883 -> j1452696264;
	j2443258198 [label="Oui. Anche se forse avrei voluto piangere. Si è presentato a me tre volte nella stessa conversazione, come se non ci fossimo mai presentati.",shape=box,color=blue];
		j2443258198 -> j1452696264;
	j3043885084 [label="Perché non sembri molto contento che l'abbia incontrato ?",shape=box,color=blue];
		j3043885084 -> j1223076775;
		j3043885084 -> j617746601;
		j3043885084 -> j3650174096;
	j3957895642 [label="Sì, credo proprio di sì. Uno scarabocchio infantile sul dorso di un automa. L'ho trovato semplicemente dolce e affascinante !",shape=box,color=blue];
		j3957895642 -> j416728602;
	j3553422179 [label="L'ho trovato semplicemente dolce e affascinante ! Ma sotto uno strato di umorismo, ho provato un profondo dolore.",shape=box,color=blue];
		j3553422179 -> j3383211205;
	j1452696264 [label="Mi ha accolta con lo stesso atteggiamento risoluto e allegro delle volte precedenti. Ma lui mi conosceva come una Sœur de Sol ! ",shape=box,color=blue];
		j1452696264 -> j4051217883;
	j1223076775 [label="Mi dispiace. A volte può dare sui nervi alla gente. Non è colpa sua.",shape=box,color=red];
		j1223076775 -> j2688105433;
	j617746601 [label="Non volevo. Può essere un po'... sgradevole per alcune persone.",shape=box,color=red];
		j617746601 -> j2688105433;
	j3650174096 [label="A volte riesce a darmi sui nervi, tutto qui. ",shape=box,color=red];
		j3650174096 -> j1585586576;
	j416728602 [label="Ma sotto il suo umorismo si nasconde un grande dolore.",shape=box,color=blue];
		j416728602 -> j3383211205;
	j3383211205 [label="Mi racconteresti la storia del povero Monsieur Otak ?",shape=box,color=blue];
		j3383211205 -> j3190369051;
	j4051217883 [label="In effetti, conosceva molto bene i Luminari ! Abbiamo parlato a lungo delle \"Antiche Religioni\", come le ha chiamate lui, \"dei giorni precedenti all'Impero Orokin\".",shape=box,color=blue];
		j4051217883 -> j3352320388;
	j2688105433 [label="E spero che gli dimostrino gentilezza e pazienza. Mais par la grâce de Sol, che ci illumini tutti.",shape=box,color=blue];
		j2688105433 -> j1948843810;
	j1585586576 [label="Spero che cercherai di essere più gentile con qualcuno che è chiaramente infirme. Ma che la grazia di Sol ci illumini tutti.",shape=box,color=blue];
		j1585586576 -> j1948843810;
	j3190369051 [label="Otak era un Archimedeo, uno scienziato e accademico Orokin. Quello che gli è successo non è esattamente una storia felice.",shape=box,color=red];
		j3190369051 -> j979106308;
	j3352320388 [label="Sebbene affermasse che gran parte di quella conoscenza fosse ormai perduta, nascosta negli archivi e severamente proibita. Mi fece giurare di mantenere il segreto.",shape=box,color=blue];
		j3352320388 -> j2568828058;
	j1948843810 [label="Un destino simile potrebbe attendere chiunque di noi. Anche te.",shape=box,color=blue];
		j1948843810 -> j458388634;
		j1948843810 -> j3408212261;
	j979106308 [label="A detta di tutti era un genio e la mente dietro lo sfruttamento dei cristalli di argon.",shape=box,color=red];
		j979106308 -> j3763728079;
	j2568828058 [label="Mi ha detto che è profondamente preoccupato che l'Esecutore Ballas - chiunque egli sia - possa scoprire la mia setta di eretici e farmi giustiziare.",shape=box,color=blue];
		j2568828058 -> j1537285847;
		j2568828058 -> j161417549;
	j458388634 [label="Mi dispiace, non ho tempo da dedicargli.",shape=box,color=red];
		j458388634 -> j3424960910;
	j3408212261 [label="Hai ragione, mi dispiace. Non intendevo questo.",shape=box,color=red];
		j3408212261 -> j3383211205;
	j3763728079 [label="Che vengono sfruttati dal Void - sono il motivo per cui possiamo creare molti dei potenti warframe e armi che realizziamo.",shape=box,color=red];
		j3763728079 -> j2006773400;
	j1537285847 [label="Questo... non accadrà. Continua a parlare.",shape=box,color=red];
		j1537285847 -> j2090440538;
	j161417549 [label="Ballas è morto... continua.",shape=box,color=red];
		j161417549 -> j2090440538;
	j3424960910 [label="Allora mi dispiace di averne sprecato ancora.",shape=box,color=blue];
		j3424960910 -> j3007723528;
	j2006773400 [label="Si specializzò in cristallografia. E i suoi lavori furono archiviati qui, nei laboratori.",shape=box,color=red];
		j2006773400 -> j3338029748;
	j2090440538 [label="+5 Chemistry",color=orange];
		j2090440538 -> j2647396992;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j3338029748 [label="Per qualche ragione, non so perché, fu trasformato in un Cephalon e gli fu dato il suo guscio necraloid.",shape=box,color=red];
		j3338029748 -> j4112681476;
	j2647396992 [label="Lo sospettavo... Beh, mi ha chiesto da dove venissi e quando gliel'ho detto, ha riso e ha detto \"no, è impossibile! E dovrei saperlo, io sono-\"",shape=box,color=blue];
		j2647396992 -> j2991681781;
	j4112681476 [label="Non tutti i Cephalon furono creati per punizione. Ma le cose andarono... male qui su Deimos, e subì gravi danni.",shape=box,color=red];
		j4112681476 -> j646397063;
	j2991681781 [label="E poi... si è presentato di nuovo. E mi ha chiesto se venivo dalle piane con dei campioni di minerale...",shape=box,color=blue];
		j2991681781 -> j2585617436;
		j2991681781 -> j3886109980;
	j646397063 [label="Pauvre petit...",shape=box,color=blue];
		j646397063 -> j1698645168;
	j2585617436 [label="Oh, Marie. Mi dispiace tanto...",shape=box,color=red];
		j2585617436 -> j3711214229;
	j3886109980 [label="Sì... così è Otak.",shape=box,color=red];
		j3886109980 -> j3711214229;
	j1698645168 [label="Boolean MarieOtak1 is now true.",color=orange];
		j1698645168 -> j1321788099;
		j1698645168 -> j2195589690;
	j3711214229 [label="Mi distrugge in mille pezzi pensare che non ci sia niente che possiamo fare per lui.",shape=box,color=blue];
		j3711214229 -> j1970966774;
	j1970966774 [label="Evaluate expressions",color=orange];
		j1970966774 -> j2602933992 [label="MarieCephalonSoul",color=purple];
		j1970966774 -> j4036819185 [label="MarieCephalonNoSoul",color=purple];
		j1970966774 -> j109700074 [label="MarieCephalonUnsure",color=purple];
		j1970966774 -> j97477654 [label="false",color=purple];
	j2602933992 [label="Oh, Luminari - che razza di inferno avete creato per lui, per tenere la sua anima intrappolata in quella gabbia di scienza e luci tremolanti ?",shape=box,color=blue];
		j2602933992 -> j1995954969;
	j4036819185 [label="Posso solo pregare i Luminari che tu abbia ragione e che dentro quel guscio non rimanga altro che... scienza e luci tremolanti.",shape=box,color=blue];
		j4036819185 -> j2771573517;
	j109700074 [label="So che non sei sicuro che i Cephalon abbiano un'anima - ma posso solo pregare i Luminari affinché... quel povero Otak non soffra.",shape=box,color=blue];
		j109700074 -> j185705471;
	j97477654 [label="Posso solo pregare i Luminari che tutto ciò che rimane dentro quel guscio non sia altro che... scienza e luci tremolanti.",shape=box,color=blue];
		j97477654 -> j262947914;
	j1995954969 [label="Perché lasciarlo lì, distrutto, ad aspettare che gli venga concesso di morire per ricevere pace? Posso solo pregare... che nel caso ci sia una qualche presenza lì -",shape=box,color=blue];
		j1995954969 -> j324414193;
	j2771573517 [label="E che nessuna anima sia intrappolata in quella distruzione, in attesa che le venga finalmente concessa la morte per poter trovare pace.",shape=box,color=blue];
		j2771573517 -> j1612527050;
	j185705471 [label="Che nessuna anima sia intrappolata in quella cosa distrutta, in attesa che le venga finalmente concessa la morte per ottenere la pace.",shape=box,color=blue];
		j185705471 -> j713078856;
	j262947914 [label="E che nessuna anima sia intrappolata in quella distruzione, in attesa che le venga finalmente concessa la morte per poter trovare pace.",shape=box,color=blue];
		j262947914 -> j713078856;
	j324414193 [label="Che lui rimanga per scelta come una specie di veglia solitaria...",shape=box,color=blue];
		j324414193 -> j1731095093;
	j1612527050 [label="Perché se ti sbagliassi e un'anima rimane in quella gabbia contro la sua volontà ?",shape=box,color=blue];
		j1612527050 -> j1801060456;
	j713078856 [label="Oppure, nel caso ci sia una qualche presenza lì, è perché lui rimane per scelta, come una sorta di veglia solitaria.",shape=box,color=blue];
		j713078856 -> j1731095093;
	j1731095093 [label="Pensare il contrario è sufficiente per farti dubitare della bontà degli dei, non ?",shape=box,color=blue];
		j1731095093 -> j2767266866;
	j1801060456 [label="Basta per mettere in dubbio la bontà degli dei, non ?",shape=box,color=blue];
		j1801060456 -> j2767266866;
	j2767266866 [label="E poi chi sarei ?",shape=box,color=blue];
		j2767266866 -> j4045979945;
	j4045979945 [label="Perdonami... je suis mélancolique aujourd'hui.",shape=box,color=blue];
		j4045979945 -> j4190999030;
	j4190999030 [label="Evaluate expressions",color=orange];
