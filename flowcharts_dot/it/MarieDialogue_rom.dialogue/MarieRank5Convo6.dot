	3212 [label="Ah ! Merci. Questo fermerà sicuramente queste mie insensate lacrime. Sai come rallegrare la piccola sciocca Marie, non ?",shape=box,color=blue];
		3212 -> 3215;
		3212 -> 3216;
	3213 [label="Oui. Hai perfettamente ragione. Lo sono. Il mondo è pieno di storie come quella di Monsieur Otak, e molte ben peggiori della sua. Non piangerei per nessuna di esse. ",shape=box,color=blue];
		3213 -> 3217;
	3214 [label="Merci. Beh, non ho più voglia di esserlo. Vado a fare qualcosa di più allegro ! Credo che il carro armato di M'sieur Fibonacci abbia bisogno di una bella pulitina.",shape=box,color=blue];
