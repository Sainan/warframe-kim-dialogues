		3186 -> 3187 [label="false",color=purple];
	3190 [label="Oh, Luminari - che razza di inferno avete creato per lui, per tenere la sua anima intrappolata in quella gabbia di scienza e luci tremolanti ?",shape=box,color=blue];
		3190 -> 3194;
	3189 [label="Posso solo pregare i Luminari che tu abbia ragione e che dentro quel guscio non rimanga altro che... scienza e luci tremolanti.",shape=box,color=blue];
		3189 -> 3193;
	3188 [label="So che non sei sicuro che i Cephalon abbiano un'anima - ma posso solo pregare i Luminari affinché... quel povero Otak non soffra.",shape=box,color=blue];
		3188 -> 3192;
	3187 [label="Posso solo pregare i Luminari che tutto ciò che rimane dentro quel guscio non sia altro che... scienza e luci tremolanti.",shape=box,color=blue];
		3187 -> 3191;
	3194 [label="Perché lasciarlo lì, distrutto, ad aspettare che gli venga concesso di morire per ricevere pace? Posso solo pregare... che nel caso ci sia una qualche presenza lì -",shape=box,color=blue];
		3194 -> 3197;
	3193 [label="E che nessuna anima sia intrappolata in quella distruzione, in attesa che le venga finalmente concessa la morte per poter trovare pace.",shape=box,color=blue];
		3193 -> 3196;
	3192 [label="Che nessuna anima sia intrappolata in quella cosa distrutta, in attesa che le venga finalmente concessa la morte per ottenere la pace.",shape=box,color=blue];
		3192 -> 3195;
	3191 [label="E che nessuna anima sia intrappolata in quella distruzione, in attesa che le venga finalmente concessa la morte per poter trovare pace.",shape=box,color=blue];
		3191 -> 3195;
	3197 [label="Che lui rimanga per scelta come una specie di veglia solitaria...",shape=box,color=blue];
