	3140 [label="Ho incontrato Otak ! Finalmente l'ho incontrato !",shape=box,color=blue];
		3140 -> 3143;
		3140 -> 3144;
	3142 [label="Lupo ! Mio lupo ! Il volto sulla schiena di Monsieur Necraloid ! Finalmente l'ho incontrato !",shape=box,color=blue];
		3142 -> 3145;
		3142 -> 3146;
		3142 -> 3147;
	3141 [label="Il volto sulla schiena di Monsieur Necraloid ! Finalmente l'ho incontrato !",shape=box,color=blue];
		3141 -> 3145;
		3141 -> 3146;
		3141 -> 3147;
	3143 [label="Come è andata la conversazione con lui?",shape=box,color=red];
		3143 -> 3148;
	3144 [label="Ti è piaciuto parlare con lui?",shape=box,color=red];
		3144 -> 3149;
	3145 [label="Hai incontrato Otak? Oddio... Com'è andata?",shape=box,color=red];
		3145 -> 3150;
	3146 [label="Sono felice che finalmente vi siate incontrati. Otak può essere un po' difficile da spiegare.",shape=box,color=red];
		3146 -> 3151;
	3147 [label="Povero Otak... Come è andata?",shape=box,color=red];
		3147 -> 3152;
	3148 [label="Lui... si è presentato a me tre volte nella stessa conversazione, come se non ci fossimo mai presentati.",shape=box,color=blue];
		3148 -> 3153;
	3149 [label="Oui. Anche se forse avrei voluto piangere. Si è presentato a me tre volte nella stessa conversazione, come se non ci fossimo mai presentati.",shape=box,color=blue];
		3149 -> 3153;
	3150 [label="Perché non sembri molto contento che l'abbia incontrato ?",shape=box,color=blue];
		3150 -> 3154;
		3150 -> 3155;
		3150 -> 3156;
	3151 [label="Sì, credo proprio di sì. Uno scarabocchio infantile sul dorso di un automa. L'ho trovato semplicemente dolce e affascinante !",shape=box,color=blue];
		3151 -> 3157;
	3152 [label="L'ho trovato semplicemente dolce e affascinante ! Ma sotto uno strato di umorismo, ho provato un profondo dolore.",shape=box,color=blue];
		3152 -> 3158;
	3153 [label="Mi ha accolta con lo stesso atteggiamento risoluto e allegro delle volte precedenti. Ma lui mi conosceva come una Sœur de Sol ! ",shape=box,color=blue];
		3153 -> 3159;
	3154 [label="Mi dispiace. A volte può dare sui nervi alla gente. Non è colpa sua.",shape=box,color=red];
		3154 -> 3160;
	3155 [label="Non volevo. Può essere un po'... sgradevole per alcune persone.",shape=box,color=red];
		3155 -> 3160;
	3156 [label="A volte riesce a darmi sui nervi, tutto qui. ",shape=box,color=red];
		3156 -> 3161;
	3157 [label="Ma sotto il suo umorismo si nasconde un grande dolore.",shape=box,color=blue];
		3157 -> 3158;
	3158 [label="Mi racconteresti la storia del povero Monsieur Otak ?",shape=box,color=blue];
		3158 -> 3162;
	3159 [label="In effetti, conosceva molto bene i Luminari ! Abbiamo parlato a lungo delle \"Antiche Religioni\", come le ha chiamate lui, \"dei giorni precedenti all'Impero Orokin\".",shape=box,color=blue];
		3159 -> 3163;
	3160 [label="E spero che gli dimostrino gentilezza e pazienza. Mais par la grâce de Sol, che ci illumini tutti.",shape=box,color=blue];
		3160 -> 3164;
	3161 [label="Spero che cercherai di essere più gentile con qualcuno che è chiaramente infirme. Ma che la grazia di Sol ci illumini tutti.",shape=box,color=blue];
		3161 -> 3164;
	3162 [label="Otak era un Archimedeo, uno scienziato e accademico Orokin. Quello che gli è successo non è esattamente una storia felice.",shape=box,color=red];
		3162 -> 3165;
	3163 [label="Sebbene affermasse che gran parte di quella conoscenza fosse ormai perduta, nascosta negli archivi e severamente proibita. Mi fece giurare di mantenere il segreto.",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="Un destino simile potrebbe attendere chiunque di noi. Anche te.",shape=box,color=blue];
		3164 -> 3167;
		3164 -> 3168;
	3165 [label="A detta di tutti era un genio e la mente dietro lo sfruttamento dei cristalli di argon.",shape=box,color=red];
		3165 -> 3169;
	3166 [label="Mi ha detto che è profondamente preoccupato che l'Esecutore Ballas - chiunque egli sia - possa scoprire la mia setta di eretici e farmi giustiziare.",shape=box,color=blue];
		3166 -> 3170;
		3166 -> 3171;
	3167 [label="Mi dispiace, non ho tempo da dedicargli.",shape=box,color=red];
		3167 -> 3172;
	3168 [label="Hai ragione, mi dispiace. Non intendevo questo.",shape=box,color=red];
		3168 -> 3158;
	3169 [label="Che vengono sfruttati dal Void - sono il motivo per cui possiamo creare molti dei potenti warframe e armi che realizziamo.",shape=box,color=red];
		3169 -> 3173;
	3170 [label="Questo... non accadrà. Continua a parlare.",shape=box,color=red];
		3170 -> 3174;
	3171 [label="Ballas è morto... continua.",shape=box,color=red];
		3171 -> 3174;
	3172 [label="Allora mi dispiace di averne sprecato ancora.",shape=box,color=blue];
		3172 -> 3175;
	3173 [label="Si specializzò in cristallografia. E i suoi lavori furono archiviati qui, nei laboratori.",shape=box,color=red];
		3173 -> 3176;
	3174 [label="+5 Chemistry",color=orange];
		3174 -> 3177;
	3175 [label="Update boolean MarieOtakComplete",color=orange];
		3175 -> 3178;
	3176 [label="Per qualche ragione, non so perché, fu trasformato in un Cephalon e gli fu dato il suo guscio necraloid.",shape=box,color=red];
		3176 -> 3179;
	3177 [label="Lo sospettavo... Beh, mi ha chiesto da dove venissi e quando gliel'ho detto, ha riso e ha detto \"no, è impossibile! E dovrei saperlo, io sono-\"",shape=box,color=blue];
		3177 -> 3180;
	3178 [label="Chat ends.",color=orange];
	3179 [label="Non tutti i Cephalon furono creati per punizione. Ma le cose andarono... male qui su Deimos, e subì gravi danni.",shape=box,color=red];
		3179 -> 3181;
	3180 [label="E poi... si è presentato di nuovo. E mi ha chiesto se venivo dalle piane con dei campioni di minerale...",shape=box,color=blue];
		3180 -> 3182;
		3180 -> 3183;
	3181 [label="Pauvre petit...",shape=box,color=blue];
		3181 -> 3184;
	3182 [label="Oh, Marie. Mi dispiace tanto...",shape=box,color=red];
		3182 -> 3185;
	3183 [label="Sì... così è Otak.",shape=box,color=red];
		3183 -> 3185;
