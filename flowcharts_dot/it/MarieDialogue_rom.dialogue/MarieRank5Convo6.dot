		j4190999030 -> j588255411 [label="false",color=purple];
		j4190999030 -> j2940254570 [label="false",color=purple];
	j507094518 [label="C'è qualcosa che posso fare per tirarti su il morale? Potremmo andare a tormentare Roathe.",shape=box,color=red];
		j507094518 -> j1491251819;
	j4270779413 [label="Posso fare qualcosa per tirarti su il morale? Forse rubare un paio di pasticcini?",shape=box,color=red];
		j4270779413 -> j2290648933;
	j588255411 [label="A volte gli dei sono crudeli, Marie. È la vita.",shape=box,color=red];
		j588255411 -> j2831387458;
	j2940254570 [label="È normale. Hai tutto il diritto di esserlo.",shape=box,color=red];
		j2940254570 -> j3319478926;
	j1491251819 [label="+15 Chemistry",color=orange];
		j1491251819 -> j869735095;
	j2290648933 [label="+20 Chemistry",color=orange];
		j2290648933 -> j869735095;
	j2831387458 [label="+5 Chemistry",color=orange];
		j2831387458 -> j2699523615;
	j3319478926 [label="+20 Chemistry",color=orange];
		j3319478926 -> j489219299;
	j869735095 [label="Ah ! Merci. Questo fermerà sicuramente queste mie insensate lacrime. Sai come rallegrare la piccola sciocca Marie, non ?",shape=box,color=blue];
		j869735095 -> j2493558344;
		j869735095 -> j2972562089;
	j2699523615 [label="Oui. Hai perfettamente ragione. Lo sono. Il mondo è pieno di storie come quella di Monsieur Otak, e molte ben peggiori della sua. Non piangerei per nessuna di esse. ",shape=box,color=blue];
		j2699523615 -> j1982889433;
	j489219299 [label="Merci. Beh, non ho più voglia di esserlo. Vado a fare qualcosa di più allegro ! Credo che il carro armato di M'sieur Fibonacci abbia bisogno di una bella pulitina.",shape=box,color=blue];
		j489219299 -> j2425134241;
	j2493558344 [label="Non sei affatto sciocca. La penso allo stesso modo.",shape=box,color=red];
		j2493558344 -> j2235898819;
	j2972562089 [label="È il minimo che possa fare per te.",shape=box,color=red];
		j2972562089 -> j2235898819;
	j1982889433 [label="Eppure, eccomi qui, seduta, a fare proprio questo. Grazie per avermi ricordato la mia stupidità. Fie ! Piccola sciocca Marie. Beh... penso che l'acquario di M'sieur Fibonacci abbia bisogno di una bella pulitina.",shape=box,color=blue];
		j1982889433 -> j2425134241;
	j2425134241 [label="Check boolean MarieDating",color=orange];
		j2425134241 -> j378832368 [label=true,color=green];
