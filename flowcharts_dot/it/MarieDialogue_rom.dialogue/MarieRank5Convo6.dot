		3196 -> 3199;
	3195 [label="Oppure, nel caso ci sia una qualche presenza lì, è perché lui rimane per scelta, come una sorta di veglia solitaria.",shape=box,color=blue];
		3195 -> 3198;
	3200 [label="Pensare il contrario è sufficiente per farti dubitare della bontà degli dei, non ?",shape=box,color=blue];
