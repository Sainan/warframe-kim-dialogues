digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo3 begins." [color=orange];
		"MarieRank4Convo3 begins." -> j1608671930;
	j1608671930 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j1608671930 -> j663411230;
		j1608671930 -> j4115718638;
	j663411230 [label="Come stai oggi, Marie?",shape=box,color=red];
		j663411230 -> j386416738;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j386416738 [label="Non sono così bene. Forse preferiresti tornare a parlarmi domani. Non sarò la migliore delle compagnie.",shape=box,color=blue];
		j386416738 -> j31539870;
		j386416738 -> j2750915816;
		j386416738 -> j95486512;
	"Chat ends." [color=orange];
	j31539870 [label="Se vuoi, me ne vado, ma se vuoi parlare, sarò felice di ascoltarti.",shape=box,color=red];
		j31539870 -> j3272090150;
	j2750915816 [label="Va bene, capisco.",shape=box,color=red];
		j2750915816 -> "Chat ends.";
	j95486512 [label="Posso chiederti cosa c'è che non va...?",shape=box,color=red];
		j95486512 -> j3272090150;
	j3272090150 [label="C'est vraiment gentil, ma è un vecchio problema... non vale la pena preoccuparsene. Starò bene.",shape=box,color=blue];
		j3272090150 -> j3096270068;
	j3096270068 [label="Boolean MarieChronicPain is now true.",color=orange];
		j3096270068 -> j3859752940;
		j3096270068 -> j2794666611;
		j3096270068 -> j2371471869;
	j3859752940 [label="Se ne sei certa, ma io sono qui, se vuoi parlarne.",shape=box,color=red];
		j3859752940 -> j144754669;
	j2794666611 [label="Io... so cosa si prova. Prima di cominciare con i \"cicli\", mi sono fatto parecchio male a Duviri. Sono guarito, ma ogni tanto mi fa ancora un male terribile. Cerco di nascondere il mio sussulto quando succede.",shape=box,color=red];
		j2794666611 -> j791344315;
	j2371471869 [label="I vecchi problemi persistenti a volte possono essere problematici quanto quelli nuovi. Solo perché vanno e vengono, e possono rimanere con noi, non significa che non valga la pena parlarne.",shape=box,color=red];
		j2371471869 -> j3322926510;
	j144754669 [label="Sei davvero molto gentile e... va bene. Mi sto comportando di nuovo come la piccola testarda Marie.",shape=box,color=blue];
		j144754669 -> j3281791160;
	j791344315 [label="Boolean DrifterChronicPain is now true.",color=orange];
		j791344315 -> j1775849770;
	j3322926510 [label="Oui, tu as raison. Sono di nuovo la piccola testarda Marie.",shape=box,color=blue];
		j3322926510 -> j3281791160;
	j3281791160 [label="È difficile da spiegare, ma ci proverò. Mes pieds, oui ? I miei piedi. Il siero mi ha cambiata, mi ha donato il volo -",shape=box,color=blue];
		j3281791160 -> j1069071005;
	j1775849770 [label="Par les Luminaires, mi dispiace tanto. Capisci allora com'è, oui ?",shape=box,color=blue];
		j1775849770 -> j1233260421;
	j1069071005 [label="Ma continuo a sentirle, quelle cose contorte che minacciavano di consumarmi, minacciavano di distruggere ogni speranza e gioia dalla mia anima.",shape=box,color=blue];
		j1069071005 -> j2294975549;
	j1233260421 [label="Avere un corpo che ti tradisce, che rallenta il tuo spirito. Anche ora, è così strano. Il sérum mi ha cambiata, mi ha donato il volo -",shape=box,color=blue];
		j1233260421 -> j1069071005;
	j2294975549 [label="Mi fanno sempre male. Sempre. Anche ora, seduta qui, se ci penso, provo dolore. Ma non sempre è abbastanza da notarlo.",shape=box,color=blue];
		j2294975549 -> j3209002806;
	j3209002806 [label="Eppure, ancora oggi, mi sveglio di notte per il dolore. E mi chiedo: Sol, pourquoi ? Perché devo ancora provare questa... agonie interminable ?",shape=box,color=blue];
		j3209002806 -> j255786838;
	j255786838 [label="A cosa serve ? Ah, ma poi arriva il mattino, e io rido, e mi dico: \"Zitta, Marie, sei fortunata. Guarda tutto quello che hai, tutto quello che puoi fare\".",shape=box,color=blue];
		j255786838 -> j1785346762;
	j1785346762 [label="Alla Cathédrale era \"Sai leggere, sai scrivere, sai mangiare, sai dormire. Sai muoverti abbastanza bene. Hai occhi per vedere e una lingua per parlare. Mani con cui scrivere. Chi si prende cura di te\". E ora, posso volare! Posso proteggere il futuro dal Void stesso. Dall'Indifférence !",shape=box,color=blue];
		j1785346762 -> j3270858720;
	j3270858720 [label="\"Piangi ora, sciocca, questo dolore costante ti renderà forte contro ciò che verrà\", mi dico. E il giorno passa a un altro e non è così male quando arriva il successivo.",shape=box,color=blue];
		j3270858720 -> j830269311;
	j830269311 [label="Check boolean DrifterChronicPain",color=orange];
		j830269311 -> j3570269718 [label=true,color=green];
		j830269311 -> j3348027404 [label=true,color=green];
		j830269311 -> j3920609627 [label=false,color=brown];
		j830269311 -> j395589672 [label=false,color=brown];
	j3570269718 [label="Se c'è una cosa che ci ha dato, suppongo, è la tolleranza al dolore.",shape=box,color=red];
		j3570269718 -> j1246868821;
	j3348027404 [label="A volte però... mi sveglio e mi sento crollare.",shape=box,color=red];
		j3348027404 -> j1246868821;
	j3920609627 [label="Non... smette mai di fare male? Mi dispiace tanto, Marie...",shape=box,color=red];
		j3920609627 -> j2883839126;
	j395589672 [label="E non ci sono farmaci? Cure?",shape=box,color=red];
		j395589672 -> j2623568292;
	j1246868821 [label="Una volta un parrocchiano mi chiese: \"Soffri? Sempre?\". Al che risposi: \"Oui, monsieur. Je le suis\". Il suo sguardo era misto a stupore e orrore.",shape=box,color=blue];
		j1246868821 -> j2316973221;
	j2883839126 [label="A volte mi sedevo e pensavo a quanto avrei potuto fare se non fossi stata in così grande agonia, oui ? Se non fossi così... intrappolata in una gabbia di carne che era così determinata a ostacolarmi a ogni passo.",shape=box,color=blue];
		j2883839126 -> j461002020;
	j2623568292 [label="Vorrei tanto che ci fosse. Ma non c'è. Non nel mio tempo, e temo neanche in questo.",shape=box,color=blue];
		j2623568292 -> j2930672867;
	j2316973221 [label="\"Come fai?\" fu la sua domanda successiva. E ricordo di avergli sorriso e di avergli risposto: \"Quale altra scelta ho, Monsieur...?\"",shape=box,color=blue];
		j2316973221 -> j3329346787;
		j2316973221 -> j179221958;
	j461002020 [label="Quanto mi infuriavo ! Quanto diventavo gelosa di coloro i cui corpi non erano nati per tradirli. Ma a cosa serviva alla fine, à part rendre nos vies plus amères ? Più astiose ?",shape=box,color=blue];
		j461002020 -> j3145143892;
	j2930672867 [label="Alcune malattie sono al di là delle cure dell'uomo, della scienza e della fede.",shape=box,color=blue];
		j2930672867 -> j2883839126;
	j3329346787 [label="Ho avuto la stessa conversazione così tante volte...",shape=box,color=red];
		j3329346787 -> j2883839126;
	j179221958 [label="Esatto. Mi dispiace tanto.",shape=box,color=red];
		j179221958 -> j348858986;
	j3145143892 [label="Aucun. Sono come sono e persevererò.",shape=box,color=blue];
		j3145143892 -> j2980398560;
	j348858986 [label="Non, mi dispiace semplicemente che tu condivida un'agonia così simile. ",shape=box,color=blue];
		j348858986 -> j2883839126;
	j2980398560 [label="Check boolean DrifterChronicPain",color=orange];
		j2980398560 -> j132121510 [label=true,color=green];
		j2980398560 -> j3568176683 [label=false,color=brown];
	j132121510 [label="E così farai anche tu. Anche tu. In questo, ho fede.",shape=box,color=blue];
		j132121510 -> j3568176683;
	j3568176683 [label="+20 Chemistry",color=orange];
		j3568176683 -> j1958650347;
	j1958650347 [label="Non riesco a esprimere a parole quanto questa conversazione abbia significato per me. Quindi dirò semplicemente merci, Drifter.",shape=box,color=blue];
		j1958650347 -> j3563974437;
	j3563974437 [label="Et encore merci.",shape=box,color=blue];
		j3563974437 -> "Chat ends.";
}