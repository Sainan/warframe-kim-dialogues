digraph {
	2239 [label="MarieRank4Convo3 begins.",color=orange];
		2239 -> 2240;
		2239 -> 2241;
	2240 [label="Come stai oggi, Marie?",shape=box,color=red];
		2240 -> 2242;
	2241 [label="[Fine.]",shape=box,color=red];
		2241 -> 2243;
	2242 [label="Non sono così bene. Forse preferiresti tornare a parlarmi domani. Non sarò la migliore delle compagnie.",shape=box,color=blue];
		2242 -> 2244;
		2242 -> 2245;
		2242 -> 2246;
	2243 [label="Chat ends.",color=orange];
	2244 [label="Se vuoi, me ne vado, ma se vuoi parlare, sarò felice di ascoltarti.",shape=box,color=red];
		2244 -> 2247;
	2245 [label="Va bene, capisco.",shape=box,color=red];
		2245 -> 2248;
	2246 [label="Posso chiederti cosa c'è che non va...?",shape=box,color=red];
		2246 -> 2247;
	2247 [label="C'est vraiment gentil, ma è un vecchio problema... non vale la pena preoccuparsene. Starò bene.",shape=box,color=blue];
		2247 -> 2249;
	2248 [label="Chat ends.",color=orange];
	2249 [label="Update boolean MarieChronicPain",color=orange];
		2249 -> 2250;
		2249 -> 2251;
		2249 -> 2252;
	2250 [label="Se ne sei certa, ma io sono qui, se vuoi parlarne.",shape=box,color=red];
		2250 -> 2253;
	2251 [label="Io... so cosa si prova. Prima di cominciare con i \"cicli\", mi sono fatto parecchio male a Duviri. Sono guarito, ma ogni tanto mi fa ancora un male terribile. Cerco di nascondere il mio sussulto quando succede.",shape=box,color=red];
		2251 -> 2254;
	2252 [label="I vecchi problemi persistenti a volte possono essere problematici quanto quelli nuovi. Solo perché vanno e vengono, e possono rimanere con noi, non significa che non valga la pena parlarne.",shape=box,color=red];
		2252 -> 2255;
	2253 [label="Sei davvero molto gentile e... va bene. Mi sto comportando di nuovo come la piccola testarda Marie.",shape=box,color=blue];
		2253 -> 2256;
	2254 [label="Update boolean DrifterChronicPain",color=orange];
		2254 -> 2257;
	2255 [label="Oui, tu as raison. Sono di nuovo la piccola testarda Marie.",shape=box,color=blue];
		2255 -> 2256;
	2256 [label="È difficile da spiegare, ma ci proverò. Mes pieds, oui ? I miei piedi. Il siero mi ha cambiata, mi ha donato il volo -",shape=box,color=blue];
		2256 -> 2258;
	2257 [label="Par les Luminaires, mi dispiace tanto. Capisci allora com'è, oui ?",shape=box,color=blue];
		2257 -> 2259;
	2258 [label="Ma continuo a sentirle, quelle cose contorte che minacciavano di consumarmi, minacciavano di distruggere ogni speranza e gioia dalla mia anima.",shape=box,color=blue];
		2258 -> 2260;
	2259 [label="Avere un corpo che ti tradisce, che rallenta il tuo spirito. Anche ora, è così strano. Il sérum mi ha cambiata, mi ha donato il volo -",shape=box,color=blue];
		2259 -> 2258;
	2260 [label="Mi fanno sempre male. Sempre. Anche ora, seduta qui, se ci penso, provo dolore. Ma non sempre è abbastanza da notarlo.",shape=box,color=blue];
		2260 -> 2261;
	2261 [label="Eppure, ancora oggi, mi sveglio di notte per il dolore. E mi chiedo: Sol, pourquoi ? Perché devo ancora provare questa... agonie interminable ?",shape=box,color=blue];
		2261 -> 2262;
	2262 [label="A cosa serve ? Ah, ma poi arriva il mattino, e io rido, e mi dico: \"Zitta, Marie, sei fortunata. Guarda tutto quello che hai, tutto quello che puoi fare\".",shape=box,color=blue];
		2262 -> 2263;
	2263 [label="Alla Cathédrale era \"Sai leggere, sai scrivere, sai mangiare, sai dormire. Sai muoverti abbastanza bene. Hai occhi per vedere e una lingua per parlare. Mani con cui scrivere. Chi si prende cura di te\". E ora, posso volare! Posso proteggere il futuro dal Void stesso. Dall'Indifférence !",shape=box,color=blue];
		2263 -> 2264;
	2264 [label="\"Piangi ora, sciocca, questo dolore costante ti renderà forte contro ciò che verrà\", mi dico. E il giorno passa a un altro e non è così male quando arriva il successivo.",shape=box,color=blue];
		2264 -> 2265;
	2265 [label="Check boolean DrifterChronicPain",color=orange];
		2265 -> 2266 [label=true,color=green];
		2265 -> 2269 [label=true,color=green];
		2265 -> 2267 [label=false,color=brown];
		2265 -> 2268 [label=false,color=brown];
	2266 [label="Se c'è una cosa che ci ha dato, suppongo, è la tolleranza al dolore.",shape=box,color=red];
		2266 -> 2270;
	2269 [label="A volte però... mi sveglio e mi sento crollare.",shape=box,color=red];
		2269 -> 2270;
	2267 [label="Non... smette mai di fare male? Mi dispiace tanto, Marie...",shape=box,color=red];
		2267 -> 2271;
	2268 [label="E non ci sono farmaci? Cure?",shape=box,color=red];
		2268 -> 2272;
	2270 [label="Una volta un parrocchiano mi chiese: \"Soffri? Sempre?\". Al che risposi: \"Oui, monsieur. Je le suis\". Il suo sguardo era misto a stupore e orrore.",shape=box,color=blue];
		2270 -> 2273;
	2271 [label="A volte mi sedevo e pensavo a quanto avrei potuto fare se non fossi stata in così grande agonia, oui ? Se non fossi così... intrappolata in una gabbia di carne che era così determinata a ostacolarmi a ogni passo.",shape=box,color=blue];
		2271 -> 2274;
	2272 [label="Vorrei tanto che ci fosse. Ma non c'è. Non nel mio tempo, e temo neanche in questo.",shape=box,color=blue];
		2272 -> 2275;
	2273 [label="\"Come fai?\" fu la sua domanda successiva. E ricordo di avergli sorriso e di avergli risposto: \"Quale altra scelta ho, Monsieur...?\"",shape=box,color=blue];
		2273 -> 2276;
		2273 -> 2277;
	2274 [label="Quanto mi infuriavo ! Quanto diventavo gelosa di coloro i cui corpi non erano nati per tradirli. Ma a cosa serviva alla fine, à part rendre nos vies plus amères ? Più astiose ?",shape=box,color=blue];
		2274 -> 2278;
	2275 [label="Alcune malattie sono al di là delle cure dell'uomo, della scienza e della fede.",shape=box,color=blue];
		2275 -> 2271;
	2276 [label="Ho avuto la stessa conversazione così tante volte...",shape=box,color=red];
		2276 -> 2271;
	2277 [label="Esatto. Mi dispiace tanto.",shape=box,color=red];
		2277 -> 2279;
	2278 [label="Aucun. Sono come sono e persevererò.",shape=box,color=blue];
		2278 -> 2280;
	2279 [label="Non, mi dispiace semplicemente che tu condivida un'agonia così simile. ",shape=box,color=blue];
		2279 -> 2271;
	2280 [label="Check boolean DrifterChronicPain",color=orange];
		2280 -> 2281 [label=true,color=green];
		2280 -> 2282 [label=false,color=brown];
	2281 [label="E così farai anche tu. Anche tu. In questo, ho fede.",shape=box,color=blue];
		2281 -> 2282;
	2282 [label="+20 Chemistry",color=orange];
		2282 -> 2283;
	2283 [label="Non riesco a esprimere a parole quanto questa conversazione abbia significato per me. Quindi dirò semplicemente merci, Drifter.",shape=box,color=blue];
		2283 -> 2284;
	2284 [label="Et encore merci.",shape=box,color=blue];
		2284 -> 2285;
	2285 [label="Chat ends.",color=orange];
}