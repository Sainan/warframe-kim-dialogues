		j4034291797 -> j1984729933;
	j319650681 [label="Temo che lui... si sia impossessato del mio cuore, e mi distrugge sapere che sta soffrendo.",shape=box,color=red];
		j319650681 -> j2929490893;
	j4000813342 [label="Il dolore che prova è più profondo di quello che infligge alla sua carne. Ciò che ora si fa non può più evitarlo.",shape=box,color=blue];
		j4000813342 -> j2727505070;
	j2125031750 [label="Oh ! Non lo sapevo, mi dispiace veramente, veramente tanto... Sono certa che qualsiasi patetica serie di banalità e preghiere potessi offrirti ti farebbe sentire vuoto -",shape=box,color=blue];
