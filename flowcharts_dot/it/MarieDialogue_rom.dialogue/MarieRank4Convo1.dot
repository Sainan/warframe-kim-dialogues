		j2478899930 -> j1904382949;
		j2478899930 -> j1434860196;
	j3096230885 [label="Aiutare un uccellino può significare ucciderlo. Aiutare la fiamma di una candela può significare spegnerla nella propria exubérance.",shape=box,color=blue];
		j3096230885 -> j2800372580;
