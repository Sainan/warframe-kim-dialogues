	2070 [label="Oui, certo.",shape=box,color=blue];
		2070 -> 2060;
	2071 [label="Sai come inizia la mia storia, ma c'è una parte che non ti ho raccontato.",shape=box,color=blue];
		2071 -> 2077;
	2072 [label="Update boolean MarieBackstory1",color=orange];
		2072 -> 2078;
	2073 [label="Gli fa male, ma è una parte di lui. E se ti avvicini avec colère, se sei duro, sussulterà al tuo tocco.",shape=box,color=blue];
		2073 -> 2079;
	2074 [label="Chat ends.",color=orange];
	2075 [label="Chat ends.",color=orange];
	2076 [label="Chat ends.",color=orange];
	2077 [label="Ti ho detto che ero una mendicante per strada, quando ero una jeune fille. E che me la cavavo bene e che avevo molti amici.",shape=box,color=blue];
		2077 -> 2080;
	2078 [label="Sono nata in una famiglia ricca, il che potrebbe sorprenderti. La classe bourgeois più vicina agli Orokin.",shape=box,color=blue];
		2078 -> 2081;
	2079 [label="Devi guadagnarti la fiducia del randagio. Lascia che venga da te, non ? Ha senso ?",shape=box,color=blue];
		2079 -> 2082;
		2079 -> 2083;
		2079 -> 2084;
	2080 [label="Uno di loro era un ragazzone più grande di nome Hugo.",shape=box,color=blue];
		2080 -> 2085;
	2081 [label="Ma quando naqui... deforme, con i mes pieds tordus et inutilisables ? Oh, ma mère non poteva permetterselo.",shape=box,color=blue];
		2081 -> 2086;
	2082 [label="Si. Grazie.",shape=box,color=red];
		2082 -> 2087;
	2083 [label="Più del dovuto, grazie.",shape=box,color=red];
		2083 -> 2088;
	2084 [label="Nessuno. Ma grazie per averci provato.",shape=box,color=red];
		2084 -> 2089;
	2085 [label="Era un po' il capobranco. E si assicurava sempre che nessuno mi prendesse in giro e che avessi tutto ciò di cui avevo bisogno.",shape=box,color=blue];
		2085 -> 2090;
	2086 [label="C'erano delle apparenze da mantenere, oui ? Degli standard.",shape=box,color=blue];
		2086 -> 2091;
	2087 [label="Bien ! Avevo paura di lasciarmi sfuggire di nuovo di mano le metafore.",shape=box,color=blue];
		2087 -> 2092;
	2088 [label="Marie e le sue metafore. Ah, bon.",shape=box,color=blue];
		2088 -> 2092;
	2089 [label="Mince alors. Sapevo di aver lasciato che le mie metafore mi sfuggissero di nuovo di mano.",shape=box,color=blue];
		2089 -> 2092;
	2090 [label="Mi ha persino aiutata a costruire des béquilles - potremmo chiamarle... eh... stampelle ? Che potevo utilizzare per trascinarmi in giro, con i pezzi di legno che recuperavamo.",shape=box,color=blue];
		2090 -> 2093;
	2091 [label="Quindi, cosa fare della povera deforme Marie ? Mi portarono alla Cité de la Lumière, dove mi lasciarono a vagare per le strade...",shape=box,color=blue];
		2091 -> 2094;
	2092 [label="Hm. Mi sono resa conto che forse descrivere Lyon come un cane randagio non è il paragone più lusinghiero da fare...",shape=box,color=blue];
		2092 -> 2095;
	2093 [label="Una mattina andammo a svegliarlo e lo trovammo -",shape=box,color=blue];
		2093 -> 2096;
	2094 [label="E mi abbandonarono alla morte.",shape=box,color=blue];
		2094 -> 2097;
		2094 -> 2098;
	2095 [label="Forse non dirglelo, oui...?",shape=box,color=blue];
		2095 -> 2099;
	2096 [label="Je... ti risparmierò i dettagli... sono certa che lo puoi capire.",shape=box,color=blue];
		2096 -> 2100;
	2097 [label="Quanti anni avevi?",shape=box,color=red];
		2097 -> 2101;
