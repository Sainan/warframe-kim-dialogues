	j3150923810 [label="+10 Chemistry",color=orange];
		j3150923810 -> j2800372580;
	j1904382949 [label="Sì.",shape=box,color=red];
		j1904382949 -> j2597087994;
	j1434860196 [label="Non molto.",shape=box,color=red];
		j1434860196 -> j3507698547;
	j2800372580 [label="Ho scoperto che stargli accanto quando ha bisogno di me... ascoltarlo, semplicemente sedermi accanto a lui quando piange...",shape=box,color=blue];
		j2800372580 -> j2748551252;
	j2606519835 [label="Davvero? Non sapevo come avresti reagito.",shape=box,color=red];
