		j287270009 -> j1114381852;
	j1114381852 [label="Ma a te importa, vuoi aiutarlo - e sono certa che lui lo sa. Ah ! Eccolo. È come un cane randagio, con una cicatrice sulla gamba. È guarita, ma non molto bene. Quindi gli fa ancora male e gli prude.",shape=box,color=blue];
