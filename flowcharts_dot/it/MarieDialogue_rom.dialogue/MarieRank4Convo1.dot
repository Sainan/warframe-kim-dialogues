		j111484187 -> j2397480297;
	j1931324630 [label="Capisco cosa intendi, ma non posso tollerare che si faccia del male. Dovrebbe smetterla.",shape=box,color=red];
		j1931324630 -> j4291601193;
	j1447324388 [label="[Attenzione: Discussione sul suicidio.] Una volta ho perso qualcuno, a causa di quel tipo di autolesionismo. Non posso... non posso tollerarlo.",shape=box,color=red];
