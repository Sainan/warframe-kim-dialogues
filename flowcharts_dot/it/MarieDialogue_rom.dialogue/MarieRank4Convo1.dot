		j3965652827 -> j3381019886;
	j2597087994 [label="È per questo che cerchi di evitare che Lyon subisca la stessa sorte ? O è semplicemente l'argomento in sé che ti turba ?",shape=box,color=blue];
		j2597087994 -> j1387589015;
		j2597087994 -> j3775998974;
	j3507698547 [label="Eppure, avere qualcuno vicino ti fa sentire così intrappolato nel suo contesto che c'è solo un modo per fuggire... ",shape=box,color=blue];
		j3507698547 -> j2597087994;
	j2748551252 [label="Lo aiuta di più che parlare di ciò che dovrebbe e non dovrebbe fare.",shape=box,color=blue];
		j2748551252 -> j4277590676;
		j2748551252 -> j136741515;
		j2748551252 -> j812680839;
	j94453861 [label="Oh, come sono felice. Tellement ravie ! Lyon ha così tanto bisogno d'amore - neanche te lo immagini !",shape=box,color=blue];
		j94453861 -> j1300762014;
	j4107774642 [label="Ah, come parlare con una statue de marbre, non ? So come ti senti. Mi è capitato spesso di ritrovarmi immersa per venti minuti in una storia solo per rendermi conto che lui non mi stava ascoltando.",shape=box,color=blue];
		j4107774642 -> j171790767;
