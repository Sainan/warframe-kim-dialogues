		j822152982 -> j1114381852;
	j3435365506 [label="Questo è tutto ciò che chiedo. Oh, ma sono così felice ! Devo impegnarmi per far sì che questa coppia diventi realtà !",shape=box,color=blue];
		j3435365506 -> j2504727586;
		j3435365506 -> j3250257472;
		j3435365506 -> j3276311181;
	j643890919 [label="Allora parlagli delle tue preoccupazioni. Ti ascolterà. Non è un bambino. ",shape=box,color=blue];
