		j2929490893 -> j2206326424;
	j2727505070 [label="Gli schiarisce la mente, gli dà stabilità all'anima. E ora, come protoframe - in parte questo... Harrow, come io sono in parte Wisp, non lo ucciderà, oui ? ",shape=box,color=blue];
		j2727505070 -> j3449955802;
		j2727505070 -> j3111171670;
	j50260881 [label="- quali condoléances potrebbe fare qualcuno che conosci appena, che possano servire da toccasana a una tragédie come quella ?",shape=box,color=blue];
		j50260881 -> j2478899930;
	j1037378510 [label="E per questo non potrei adorarti di più. Ma l'aiuto può assumere molte forme, non ?",shape=box,color=blue];
		j1037378510 -> j3096230885;
	j2206326424 [label="Oh !! Ho appena urlato come se avessi visto un topo e ho spaventato Monsieur Loid ! Pardon !!",shape=box,color=blue];
		j2206326424 -> j2794594361;
	j3449955802 [label="No, non lo ucciderà. Ma non va comunque bene.",shape=box,color=red];
