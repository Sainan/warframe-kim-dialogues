		j923153001 -> j1425498830;
		j923153001 -> j709022489;
	j453773066 [label="Uno di loro era un ragazzone più grande di nome Hugo.",shape=box,color=blue];
		j453773066 -> j169554393;
	j1698421788 [label="Ma quando naqui... deforme, con i mes pieds tordus et inutilisables ? Oh, ma mère non poteva permetterselo.",shape=box,color=blue];
		j1698421788 -> j1953982359;
	j1417491337 [label="Sì. Grazie.",shape=box,color=red];
		j1417491337 -> j70766275;
	j1425498830 [label="Più del dovuto, grazie.",shape=box,color=red];
		j1425498830 -> j3972094578;
	j709022489 [label="Nessuno. Ma grazie per averci provato.",shape=box,color=red];
		j709022489 -> j2164871847;
	j169554393 [label="Era un po' il capobranco. E si assicurava sempre che nessuno mi prendesse in giro e che avessi tutto ciò di cui avevo bisogno.",shape=box,color=blue];
		j169554393 -> j596777256;
	j1953982359 [label="C'erano delle apparenze da mantenere, oui ? Degli standard.",shape=box,color=blue];
		j1953982359 -> j3690104133;
	j70766275 [label="Bien ! Avevo paura di lasciarmi sfuggire di nuovo di mano le metafore.",shape=box,color=blue];
		j70766275 -> j4130856160;
	j3972094578 [label="Marie e le sue metafore. Ah, bon.",shape=box,color=blue];
		j3972094578 -> j4130856160;
	j2164871847 [label="Mince alors. Sapevo di aver lasciato che le mie metafore mi sfuggissero di nuovo di mano.",shape=box,color=blue];
		j2164871847 -> j4130856160;
	j596777256 [label="Mi ha persino aiutata a costruire des béquilles - potremmo chiamarle... eh... stampelle ? Che potevo utilizzare per trascinarmi in giro, con i pezzi di legno che recuperavamo.",shape=box,color=blue];
		j596777256 -> j303171805;
	j3690104133 [label="Quindi, cosa fare della povera deforme Marie ? Mi portarono alla Cité de la Lumière, dove certamente sarei morta per strada...",shape=box,color=blue];
		j3690104133 -> j2102609412;
	j4130856160 [label="Hm. Mi sono resa conto che forse descrivere Lyon come un cane randagio non è il paragone più lusinghiero da fare...",shape=box,color=blue];
		j4130856160 -> j746979080;
	j303171805 [label="Una mattina andammo a svegliarlo e lo trovammo -",shape=box,color=blue];
		j303171805 -> j1247406918;
	j2102609412 [label="E mi abbandonarono alla morte.",shape=box,color=blue];
		j2102609412 -> j1791433805;
		j2102609412 -> j1461119328;
	j746979080 [label="Forse non dirglelo, oui...?",shape=box,color=blue];
		j746979080 -> j1672678032;
	j1247406918 [label="Je... ti risparmierò i dettagli... sono certa che lo puoi capire.",shape=box,color=blue];
		j1247406918 -> j925590728;
	j1791433805 [label="Quanti anni avevi?",shape=box,color=red];
		j1791433805 -> j1669618631;
	j1461119328 [label="La tua famiglia ti ha lasciata alla morte?",shape=box,color=red];
		j1461119328 -> j2605755167;
	j1672678032 [label="Boolean LyonStrayDog is now true.",color=orange];
		j1672678032 -> j2588699107;
		j1672678032 -> j3409971817;
	j925590728 [label="Ma ci lasciò un biglietto. Era a malapena leggibile. Era l'unico degli altri bambini a conoscere le lettere, e dovetti leggerlo agli altri. ",shape=box,color=blue];
		j925590728 -> j3467644742;
	j1669618631 [label="Sei ? Sette ? Ai loro occhi, avevano fatto del loro meglio per guarirmi. Tutori per insegnarmi a camminare. Apparecchi ortopedici. Calzature.",shape=box,color=blue];
		j1669618631 -> j698176758;
	j2605755167 [label="Ai loro occhi, avevano fatto del loro meglio per guarirmi. Tutori per insegnarmi a camminare. Apparecchi ortopedici. Calzature.",shape=box,color=blue];
		j2605755167 -> j698176758;
	j2588699107 [label="Penso che sia adorabile, e lo troverà adorabile anche lui.",shape=box,color=red];
		j2588699107 -> j758510050;
	j3409971817 [label="Il tuo segreto è al sicuro con me.",shape=box,color=red];
		j3409971817 -> j1292194963;
	j3467644742 [label="Ricordo ancora come mi si strozzò la voce. Ma dovevo rimanere forte. Perché anche allora sapevo di avere un dovere verso gli altri. ",shape=box,color=blue];
		j3467644742 -> j3431635942;
	j698176758 [label="Erano stanchi di quel peso. Così, a malapena in grado di leggere e scrivere numeri e lettere, mi ritrovai nella sporcizia.",shape=box,color=blue];
		j698176758 -> j3755305078;
		j698176758 -> j3911842836;
	j758510050 [label="Quelle horrible personne ! J'espère que votre chaise va s'effondrer et vous donner plein d'échardes douloureuses !",shape=box,color=blue];
		j758510050 -> "Chat ends.";
	j1292194963 [label="Merci ! Che sollievo...",shape=box,color=blue];
		j1292194963 -> "Chat ends.";
	j3431635942 [label="Hugo ci era sempre sembrato così felice, mi dicevano. Si joyeux. Affrontava sempre la vita con una risata e un sogghigno.",shape=box,color=blue];
		j3431635942 -> j3534443526;
	j3755305078 [label="È orribile.",shape=box,color=red];
		j3755305078 -> j714426695;
	j3911842836 [label="Come sei sopravvissuta?",shape=box,color=red];
		j3911842836 -> j714426695;
	j3534443526 [label="Anche quando venivamo cacciati via o lui veniva picchiato con un bastone per furto o per vagabondaggio, la cosa non sembrava dargli alcun fastidio.",shape=box,color=blue];
		j3534443526 -> j113419268;
	j714426695 [label="Check boolean MarieSecretPower",color=orange];
		j714426695 -> j29397853 [label=true,color=green];
		j714426695 -> j2234782238 [label=false,color=brown];
	j113419268 [label="Ma non conosciamo mai la profondità del dolore che gli altri provano nel loro cuore. E in quella lettera, sapevo che piangeva con Lua.",shape=box,color=blue];
		j113419268 -> j1100394578;
	j29397853 [label="Era come hai detto, non ? Tutte le 'inconvenienze' hanno un potere segreto.",shape=box,color=blue];
		j29397853 -> j2234782238;
	j2234782238 [label="Ciò che mi rendeva indésirable pour ma mère, mi rendeva molto popolare tra gli altri bambini di strada.",shape=box,color=blue];
		j2234782238 -> j2622446705;
	j1100394578 [label="Ma ora lui era in pace al suo fianco. Per un po', gli ho provato risentimento per avermi lasciata. Perché gli altri si rivolgevano a me per avere una guida. E gli ho provato risentimento per avermi abbandonata.",shape=box,color=blue];
		j1100394578 -> j1452401323;
	j2622446705 [label="Cosa c'è di più pathétique di una bambina senza pieds, oui ? Potevo guadagnare di più in un giorno, a mani tese, di quanto loro potevano rubare in una settimana.",shape=box,color=blue];
		j2622446705 -> j1462002775;
	j1452401323 [label="Ma col tempo ho capito la verità.",shape=box,color=blue];
		j1452401323 -> j3777866538;
	j1462002775 [label="Ed ero sempre incline a condividere. Quindi avevo molti amici che si prendevano cura di me. Uno di loro era un ragazzone più grande di nome Hugo.",shape=box,color=blue];
		j1462002775 -> j169554393;
	j3777866538 [label="Possiamo solo perdonarci per essere umani. E perdonarci il dolore della loro dipartita.",shape=box,color=blue];
		j3777866538 -> j1123798193;
	j1123798193 [label="Perché è la loro assenza che ci ferisce. E il pensiero di non aver fatto di più per aiutarli.",shape=box,color=blue];
		j1123798193 -> j2453387283;
	j2453387283 [label="Non conosciamo mai i fardelli che gli altri portano.",shape=box,color=blue];
		j2453387283 -> j4143198015;
	j4143198015 [label="E questa è una grande tragédie. Ma è ciò che significa essere umani.",shape=box,color=blue];
		j4143198015 -> j2347563456;
	j2347563456 [label="Non so se questa storia ti sia stata d'aiuto. Ma posso solo pregare che lo sia stata. Devo andare, Monsieur Loid mi sta chiamando.",shape=box,color=blue];
		j2347563456 -> j979811696;
		j2347563456 -> j2405435936;
	j979811696 [label="Grazie, Marie.",shape=box,color=red];
		j979811696 -> j2938241339;
	j2405435936 [label="[Rimani in silenzio.]",shape=box,color=red];
		j2405435936 -> j3386425480;
	j2938241339 [label="+20 Chemistry",color=orange];
		j2938241339 -> j2200965137;
	j3386425480 [label="+20 Chemistry",color=orange];
		j3386425480 -> j1123121321;
	j2200965137 [label="Di niente. À bientôt.",shape=box,color=blue];
		j2200965137 -> "Chat ends.";
	j1123121321 [label="À la revoyure.",shape=box,color=blue];
		j1123121321 -> "Chat ends.";
}