	2065 [label="Si mordicchia la gamba e, sebbene ciò gli apra la ferita e gli provochi dolore, gli procura anche sollievo.",shape=box,color=blue];
		2065 -> 2073;
	2066 [label="Aha ! Adesso è troppo tardi per quello. Marie, au travail ! Il y a de l'amour dans l'air !",shape=box,color=blue];
		2066 -> 2074;
	2067 [label="Oui ! E non potresti fermarmi, nemmeno se volessi. Marie, al lavoro !",shape=box,color=blue];
