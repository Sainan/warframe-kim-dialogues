		2098 -> 2102;
	2099 [label="Update boolean LyonStrayDog",color=orange];
		2099 -> 2103;
		2099 -> 2104;
	2100 [label="Ma ci lasciò un biglietto. Era a malapena leggibile. Era l'unico degli altri bambini a conoscere le lettere, e dovetti leggerlo agli altri. ",shape=box,color=blue];
		2100 -> 2105;
	2101 [label="Sei ? Sette ? Ai loro occhi, avevano fatto del loro meglio per guarirmi. Tutori per insegnarmi a camminare. Apparecchi ortopedici. Calzature.",shape=box,color=blue];
		2101 -> 2106;
	2102 [label="Ai loro occhi, avevano fatto del loro meglio per guarirmi. Tutori per insegnarmi a camminare. Apparecchi ortopedici. Calzature.",shape=box,color=blue];
		2102 -> 2106;
	2103 [label="Penso che sia adorabile, e lo troverà adorabile anche lui.",shape=box,color=red];
		2103 -> 2107;
	2104 [label="Il tuo segreto è al sicuro con me.",shape=box,color=red];
		2104 -> 2108;
	2105 [label="Ricordo ancora come mi si strozzò la voce. Ma dovevo rimanere forte. Perché anche allora sapevo di avere un dovere verso gli altri. ",shape=box,color=blue];
		2105 -> 2109;
	2106 [label="Erano stanchi di quel peso. Così, a malapena in grado di leggere e scrivere numeri e lettere, mi ritrovai nella sporcizia.",shape=box,color=blue];
		2106 -> 2110;
		2106 -> 2111;
	2107 [label="Quelle horrible personne ! J'espère que votre chaise va s'effondrer et vous donner plein d'échardes douloureuses !",shape=box,color=blue];
		2107 -> 2112;
	2108 [label="Merci ! Che sollievo...",shape=box,color=blue];
		2108 -> 2113;
	2109 [label="Hugo ci era sempre sembrato così felice, mi dicevano. Si joyeux. Affrontava sempre la vita con una risata e un sogghigno.",shape=box,color=blue];
		2109 -> 2114;
	2110 [label="È orribile.",shape=box,color=red];
		2110 -> 2115;
	2111 [label="Come sei sopravvissuta?",shape=box,color=red];
		2111 -> 2115;
	2112 [label="Chat ends.",color=orange];
	2113 [label="Chat ends.",color=orange];
	2114 [label="Anche quando venivamo cacciati via o lui veniva picchiato con un bastone per furto o per vagabondaggio, la cosa non sembrava dargli alcun fastidio.",shape=box,color=blue];
		2114 -> 2116;
	2115 [label="Check boolean MarieSecretPower",color=orange];
		2115 -> 2117 [label=true,color=green];
		2115 -> 2118 [label=false,color=brown];
	2116 [label="Ma non conosciamo mai la profondità del dolore che gli altri provano nel loro cuore. E in quella lettera, sapevo che piangeva con Lua.",shape=box,color=blue];
		2116 -> 2119;
	2117 [label="Era come hai detto, non ? Tutte le 'inconvenienze' hanno un potere segreto.",shape=box,color=blue];
		2117 -> 2118;
	2118 [label="Ciò che mi rendeva indésirable pour ma mère, mi rendeva molto popolare tra gli altri bambini di strada.",shape=box,color=blue];
		2118 -> 2120;
	2119 [label="Ma ora lui era in pace al suo fianco. Per un po', gli ho provato risentimento per avermi lasciata. Perché gli altri si rivolgevano a me per avere una guida. E gli ho provato risentimento per avermi abbandonata.",shape=box,color=blue];
		2119 -> 2121;
	2120 [label="Cosa c'è di più pathétique di una bambina senza pieds, oui ? Potevo guadagnare di più in un giorno, a mani tese, di quanto loro potevano rubare in una settimana.",shape=box,color=blue];
		2120 -> 2122;
	2121 [label="Ma col tempo ho capito la verità.",shape=box,color=blue];
		2121 -> 2123;
	2122 [label="Ed ero sempre incline a condividere. Quindi avevo molti amici che si prendevano cura di me. Uno di loro era un ragazzone più grande di nome Hugo.",shape=box,color=blue];
		2122 -> 2085;
	2123 [label="Possiamo solo perdonarci per essere umani. E perdonarci il dolore della loro dipartita.",shape=box,color=blue];
		2123 -> 2124;
	2124 [label="Perché è la loro assenza che ci ferisce. E il pensiero di non aver fatto di più per aiutarli.",shape=box,color=blue];
		2124 -> 2125;
	2125 [label="Non conosciamo mai i fardelli che gli altri portano.",shape=box,color=blue];
		2125 -> 2126;
	2126 [label="E questa è una grande tragédie. Ma è ciò che significa essere umani.",shape=box,color=blue];
		2126 -> 2127;
	2127 [label="Non so se questa storia ti sia stata d'aiuto. Ma posso solo pregare che lo sia stata. Devo andare, Monsieur Loid mi sta chiamando.",shape=box,color=blue];
		2127 -> 2128;
		2127 -> 2129;
	2128 [label="Grazie, Marie.",shape=box,color=red];
		2128 -> 2130;
	2129 [label="[Rimani in silenzio.]",shape=box,color=red];
		2129 -> 2131;
	2130 [label="+20 Chemistry",color=orange];
		2130 -> 2132;
	2131 [label="+20 Chemistry",color=orange];
		2131 -> 2133;
	2132 [label="Di niente. À bientôt.",shape=box,color=blue];
		2132 -> 2134;
	2133 [label="À la revoyure.",shape=box,color=blue];
		2133 -> 2135;
