	j136741515 [label="Farò quello che posso, vorrei solo poter fare di più.",shape=box,color=red];
		j136741515 -> j1953112424;
	j812680839 [label="Può essere... frustrante.",shape=box,color=red];
		j812680839 -> j282325225;
