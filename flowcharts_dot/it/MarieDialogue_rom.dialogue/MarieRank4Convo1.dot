		j3892560722 -> j923153001;
	j3608736808 [label="Ti ho detto che ero una mendicante per strada, quando ero una jeune fille. E che me la cavavo bene e che avevo molti amici.",shape=box,color=blue];
		j3608736808 -> j453773066;
