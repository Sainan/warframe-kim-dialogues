		j251923294 -> j2366800270;
		j251923294 -> j3060400127;
	j2333470109 [label="Potrei temere di più che una farfalla mi divori completamente, prima di temere il fratello della mia anima.",shape=box,color=blue];
		j2333470109 -> j778149165;
	j4121446250 [label="Dovrei volerlo fermare. Proteggerlo da questo suo desiderio di farsi del male.",shape=box,color=blue];
		j4121446250 -> j2611823999;
	j3008166345 [label="Ho solo paura che un giorno possa esagerare.",shape=box,color=red];
		j3008166345 -> j778149165;
	j2366800270 [label="Abbiamo bisogno che sia intero.",shape=box,color=red];
		j2366800270 -> j840190157;
	j3060400127 [label="Non voglio dovermi preoccupare di dover ripulire il suo cadavere.",shape=box,color=red];
		j3060400127 -> j698283448;
	j2611823999 [label="Se c'è una cosa di cui sono certa riguardo Lyon, è che ci sarà sempre quando sarà necessario.",shape=box,color=blue];
		j2611823999 -> j3526407950;
	j840190157 [label="Tu fai eco alle parole del diavolo. È solo l'insensibile bisogno di mani capaci che ti ispira ?",shape=box,color=blue];
		j840190157 -> j1010233388;
		j840190157 -> j3771147225;
	j698283448 [label="Dégoûtant.",shape=box,color=blue];
		j698283448 -> j1508231473;
	j3526407950 [label="Lui è il grande protettore, le bouclier sacré de Lua... La luce splendente nell'oscurità della notte.",shape=box,color=blue];
		j3526407950 -> j121995087;
	j1010233388 [label="No, ci tengo moltissimo a lui. Ho solo paura che quando avremo bisogno di lui, lui non ci sarà.",shape=box,color=red];
		j1010233388 -> j2611823999;
	j3771147225 [label="Ho solo bisogno di sapere se posso contare su di lui oppure no, o se è già troppo danneggiato.",shape=box,color=red];
		j3771147225 -> j1225592378;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j121995087 [label="Il dolore che si infligge... lo prova per ascoltare i propri pensieri. Per sentire il proprio corpo. ",shape=box,color=blue];
		j121995087 -> j3099525042;
	j1225592378 [label="Mi chiedo chi ti aiuterà quando sarai a terra e avrai bisogno di una mano.",shape=box,color=blue];
		j1225592378 -> j4197998767;
	j3099525042 [label="Perché il cielo è pieno di stelle e ognuna di esse gli sussurra qualcosa, e lui, come Lua stessa, si perderebbe tra loro.",shape=box,color=blue];
		j3099525042 -> j1238905003;
	j4197998767 [label="Oppure credi che il tempo sia già passato e che ora tu sia al di sopra di ogni rimprovero ?",shape=box,color=blue];
		j4197998767 -> j698283448;
	j1238905003 [label="E come Lua, attraversa le sue fasi. Viene consumato dal Void solo per poi risplendere così intensamente che tutti noi possiamo camminare nell'oscurità senza paura.",shape=box,color=blue];
		j1238905003 -> j1045731115;
	j1045731115 [label="Ma come tutte le benedizioni, porta con sé una maledizione. Mi segui ? Temo di stare solo divagando.",shape=box,color=blue];
