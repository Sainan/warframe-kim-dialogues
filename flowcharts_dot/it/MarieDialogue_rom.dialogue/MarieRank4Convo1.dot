		j3553964190 -> j2803475853;
	j282325225 [label="Ah, come parlare con una statue de marbre, non ? So come ti senti. Mi è capitato spesso di ritrovarmi immersa per venti minuti in una storia solo per rendermi conto che lui non mi stava ascoltando.",shape=box,color=blue];
