		834 -> 842;
	835 [label="Update boolean MarieCephalonSoul",color=orange];
		835 -> 843;
	818 [label="Lo so. Manifestarsi a loro è una decisione del Monsieur Loid, e di tutti gli altri.",shape=box,color=blue];
		818 -> 827;
	819 [label="+15 Chemistry",color=orange];
		819 -> 828;
	820 [label="Sono stato negligente. Hai ragione. Mi metterò al lavoro.",shape=box,color=red];
		820 -> 829;
	821 [label="In realtà ho un'amica che adora i ratti. Li trovo adorabili. ",shape=box,color=red];
		821 -> 830;
	839 [label="+5 Chemistry",color=orange];
		839 -> 845;
	840 [label="Oh, non pensare che io voglia che tu sia crudele ! Non ! Fanne tesoro, perché sono preziosi e non è per colpa loro che sono come sono !",shape=box,color=blue];
		840 -> 846;
	841 [label="+5 Chemistry",color=orange];
		841 -> 840;
	842 [label="+5 Chemistry",color=orange];
		842 -> 847;
	843 [label="+5 Chemistry",color=orange];
		843 -> 848;
	827 [label="Direi che è un senso di colpa, non di nobiltà, a trattenerci qui.",shape=box,color=blue];
		827 -> 836;
	828 [label="E mi piacerebbe tanto incontrarli un giorno, ma non è questo il punto, sciocco lupo.",shape=box,color=blue];
		828 -> 827;
	829 [label="+5 Chemistry",color=orange];
		829 -> 837;
	830 [label="+5 Chemistry",color=orange];
		830 -> 838;
	845 [label="Un'ulteriore prova che il diavolo e i suoi simili avevano ragione a essere condannati. Ma forse hai ragione riguardo a Otak e ai suoi simili, o forse crederci ti dà pace.",shape=box,color=blue];
		845 -> 850;
	846 [label="Il mio cuore si spezza solo per i corpi distrutti che i diavoli Orokin si sono lasciati alle spalle. Non erano dei, ma divoratori di tutto ciò che incontravano. Basta guardare quello con cui viaggiavamo per averne la prova.",shape=box,color=blue];
		846 -> 851;
	847 [label="Forse hai ragione, ma non credo che i diavoli Orokin conoscessero il funzionamento dell'anima meglio di noi. Non erano grandi dei.",shape=box,color=blue];
		847 -> 852;
	848 [label="Forse hai ragione, o forse crederci ti dà pace.",shape=box,color=blue];
		848 -> 851;
	836 [label="Che nascondiamo qualche grande e terribile peccato.",shape=box,color=blue];
		836 -> 844;
	837 [label="Grazie. Non so se ci riuscirai, ma a volte, l'unica cosa che possiamo fare è provare.",shape=box,color=blue];
		837 -> 827;
	838 [label="E mi piacerebbe tanto incontrarli un giorno, ma non è questo il punto, sciocco lupo.",shape=box,color=blue];
		838 -> 827;
	850 [label="In ogni caso, scelgo di credere che l'Otak morto tanto tempo fa ti sorriderebbe ora, se fossi gentile con tutto ciò che vive ancora nella sua memoria.",shape=box,color=blue];
		850 -> 2920;
	851 [label="Per me è semplicemente difficile dire che Necraloid ha un'anima quando Loid è proprio accanto a lui, oui ?",shape=box,color=blue];
		851 -> 850;
	852 [label="Tecnologia, forse - scienza, sì - ma l'anima ? Difficilmente potrebbero dominare il loro cuore ! Guarda il diavolo con cui viaggiamo se hai bisogno di altre prove.",shape=box,color=blue];
		852 -> 851;
	844 [label="Ed è quel peccato che deve essere perdonato.",shape=box,color=blue];
		844 -> 849;
	2920 [label="Check boolean LoidFamilyComplete",color=orange];
		2920 -> 2921 [label=true,color=green];
		2920 -> 854 [label=false,color=brown];
	849 [label="Grazie, mi hai dato molto su cui riflettere. À la revoyure.",shape=box,color=blue];
		849 -> 853;
	2921 [label="Devo andare. Ma, merci. Ho molto su cui riflettere.",shape=box,color=blue];
		2921 -> 2922;
	854 [label="Spero semplicemente di incontrare qualche strano fac-similé ancora in vita quando un giorno Monsieur Necraloid tornerà a salire le scale.",shape=box,color=blue];
		854 -> 855;
		854 -> 856;
	853 [label="Chat ends.",color=orange];
	2922 [label="Chat ends.",color=orange];
	855 [label="Non so se sia saggio intromettersi negli affari altrui.",shape=box,color=red];
		855 -> 857;
	856 [label="Spero che un giorno potremo dire la verità alla Famiglia Entrati. E spero quel giorno arrivi il prima possibile. ",shape=box,color=red];
		856 -> 857;
	857 [label="Check boolean MarieFamily1",color=orange];
		857 -> 858 [label=true,color=green];
		857 -> 859 [label=false,color=brown];
	858 [label="Vedremo, vorrei sapere da te più nel dettaglio perché dobbiamo restare.",shape=box,color=blue];
		858 -> 860;
	859 [label="C'è una storia che credo tu non mi stia raccontando. Ma credo che per oggi sia abbastanza, oui ?",shape=box,color=blue];
		859 -> 860;
	860 [label="Torneremo presto a parlare della famiglia Entrati.",shape=box,color=blue];
		860 -> 147;
