digraph {
	"MarieRank2Convo5 begins." [color=orange];
		"MarieRank2Convo5 begins." -> j1631090094;
	j1631090094 [label="Evaluate expressions",color=orange];
		j1631090094 -> j3003776751 [label="MarieOtak1",color=purple];
		j1631090094 -> j1811277256 [label="MarieFamily1",color=purple];
		j1631090094 -> j360560346 [label="false",color=purple];
	j3003776751 [label="Ho riflettuto su quello che mi hai detto riguardo Monsieur Otak.",shape=box,color=blue];
		j3003776751 -> j1472362721;
	j1811277256 [label="Ho riflettuto su quello che mi hai detto riguardo la famiglia de le Cardinal.",shape=box,color=blue];
		j1811277256 -> j1551629626;
	j360560346 [label="Vorrei domandarti nuovamente del Monsieur \"Necraloid\", posso?",shape=box,color=blue];
		j360560346 -> j462307916;
		j360560346 -> j4115718638;
	j1472362721 [label="Mi chiedevo se fosse simile a una mia storia. Potrei raccontartela, se hai tempo.",shape=box,color=blue];
		j1472362721 -> j988212477;
		j1472362721 -> j4115718638;
	j1551629626 [label="Mi chiedevo, potresti raccontarmi la storia di Otak, il volto infantile sul retro del cranio del Necraloid?",shape=box,color=blue];
		j1551629626 -> j1829782769;
		j1551629626 -> j900174415;
	j462307916 [label="Certo, di cosa si tratta?",shape=box,color=red];
		j462307916 -> j4173095742;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j988212477 [label="Fai pure.",shape=box,color=red];
		j988212477 -> j2840356655;
	j1829782769 [label="Certo.",shape=box,color=red];
		j1829782769 -> j1612964387;
	j900174415 [label="Forse più tardi. [Fine.]",shape=box,color=red];
		j900174415 -> "Chat ends.";
	j4173095742 [label="Mi incuriosisce il motivo per cui sulla sua schiena c'è un altro volto che assomiglia allo scarabocchio di un bambino.",shape=box,color=blue];
		j4173095742 -> j3713180765;
	"Chat ends." [color=orange];
	j2840356655 [label="C'era una suora alla Cathédrale, che una volta si perse nei corridoi del suo passato. Suor Cécilia.",shape=box,color=blue];
		j2840356655 -> j3930883066;
	j1612964387 [label="A detta di tutti era un genio e la mente dietro lo sfruttamento dei cristalli di argon.",shape=box,color=red];
		j1612964387 -> j519014663;
	j3713180765 [label="Ho chiesto informazioni sia a Monsieur Necraloid che a Monsieur Loid, ma nessuno dei due ha voluto parlarne, mi hanno solo detto un nome: Otak. E lo hanno pronunciato con grande tristezza.",shape=box,color=blue];
		j3713180765 -> j1339369428;
	j3930883066 [label="Era solita fermarsi davanti al grande orologio dell'atrio e proclamare che erano le due del pomeriggio, ma non sapeva che ora fosse veramente.",shape=box,color=blue];
		j3930883066 -> j2541294360;
	j519014663 [label="Che vengono sfruttati dal Void - sono il motivo per cui possiamo creare molti dei potenti warframe e armi che realizziamo.",shape=box,color=red];
		j519014663 -> j3481270153;
	j1339369428 [label="Quindi eccomi qui, a parlare con te, nella speranza che tu possa aiutarmi.",shape=box,color=blue];
		j1339369428 -> j574355849;
		j1339369428 -> j1448761943;
	j2541294360 [label="Trovavamo tutti i dipinti nei corridoi girati nel verso sbagliato e lei diceva che le sussurravano terribili complotti.",shape=box,color=blue];
		j2541294360 -> j109474087;
	j3481270153 [label="Si specializzò in cristallografia. E i suoi lavori furono archiviati qui, nei laboratori.",shape=box,color=red];
		j3481270153 -> j67926153;
	j574355849 [label="Vuoi sapere di Otak? O del perché non puoi parlargli?",shape=box,color=red];
		j574355849 -> j330445305;
	j1448761943 [label="Otak è difficile da spiegare...",shape=box,color=red];
		j1448761943 -> j2100059297;
	j109474087 [label="Abbiamo scoperto che stava semplicemente ascoltando le conversazioni da altre stanze, e pensava che fossero i dipinti a parlare...",shape=box,color=blue];
		j109474087 -> j2107607202;
	j67926153 [label="Per qualche ragione, non so perché, fu trasformato in un Cephalon e gli fu dato il suo guscio necraloid.",shape=box,color=red];
		j67926153 -> j2934927610;
	j330445305 [label="Credo che col tempo mi piacerebbe sapere entrambe le cose, ma lascerò che sia tu a decidere da dove cominciare. Non so cosa sia più importante, après tout.",shape=box,color=blue];
		j330445305 -> j2100059297;
	j2100059297 [label="Check boolean LoidFamilyComplete",color=orange];
		j2100059297 -> j271699056 [label=true,color=green];
		j2100059297 -> j271699056 [label=false,color=brown];
		j2100059297 -> j299791641 [label=false,color=brown];
	j2107607202 [label="Una volta scambiò tutti i cuscini di un salottino per bambini e li invitò tutti a prendere il tè...",shape=box,color=blue];
		j2107607202 -> j2150264607;
	j2934927610 [label="Non tutti i Cephalon furono creati per punizione. Ma le cose andarono... male qui su Deimos, e subì gravi danni.",shape=box,color=red];
		j2934927610 -> j4293580096;
	j271699056 [label="Otak era un Archimedeo, uno scienziato e accademico Orokin. Quello che gli è successo non è esattamente una storia felice.",shape=box,color=red];
		j271699056 -> j1100016821;
	j299791641 [label="Beh... in breve, di sopra ci sono alcuni membri della famiglia Entrati, e non sono... esattamente consapevoli che siamo qui sotto.",shape=box,color=red];
		j299791641 -> j4277418345;
	j2150264607 [label="Quando entrai nella stanza, lei mi guardò e disse: \"Oh, Suor Odette, eccola! Ci sono i bambini dell'orfanotrofio, vuole unirsi a me?\"",shape=box,color=blue];
		j2150264607 -> j1210765137;
		j2150264607 -> j2675173567;
	j4293580096 [label="+5 Chemistry",color=orange];
		j4293580096 -> j2445469752;
	j1100016821 [label="Boolean MarieOtak1 is now true.",color=orange];
		j1100016821 -> j3791839537;
	j4277418345 [label="Boolean MarieFamily1 is now true.",color=orange];
		j4277418345 -> j93871699;
	j1210765137 [label="Che cosa hai fatto?",shape=box,color=red];
		j1210765137 -> j3691496428;
	j2675173567 [label="Chi era Suor Odette?",shape=box,color=red];
		j2675173567 -> j4180076745;
	j2445469752 [label="Pauvre petit...",shape=box,color=blue];
		j2445469752 -> j1337482464;
	j3791839537 [label="Par les Luminaires... continua.",shape=box,color=blue];
		j3791839537 -> j1612964387;
	j93871699 [label="Par les Luminaires... Vuoi dire che siamo tutti qui in segreto ?! È per questo che non ci è permesso lasciare questo posto ?! Mais pourquoi ?!",shape=box,color=blue];
		j93871699 -> j2148595994;
	j3691496428 [label="Ho spinto la mia sedia a un posto libero e ho preso il te con lei e i cuscini, cos'altro potevo fare ?",shape=box,color=blue];
		j3691496428 -> j1088839575;
	j4180076745 [label="Suor Odette era morta da trent'anni, temo.",shape=box,color=blue];
		j4180076745 -> j610172487;
	j1337482464 [label="Quindi, è stato trasferito nel necraloid principale - l'unico Necraloid rimasto - ed è... beh? È difficile da spiegare.",shape=box,color=red];
		j1337482464 -> j1684557565;
		j1337482464 -> j999517241;
		j1337482464 -> j1796400878;
	j2148595994 [label="Sua figlia, Euleria - detta Madre, e la sua famiglia, si sono presi cura di Deimos per tutto questo tempo.",shape=box,color=red];
		j2148595994 -> j4036959629;
	j1088839575 [label="Quanto abbiamo riso insieme, mentre mi raccontava storie del suo passato. Storie che Suor Cécilia non aveva mai raccontato a nessuno, almeno per quanto ne so.",shape=box,color=blue];
		j1088839575 -> j2862848923;
	j610172487 [label="Ho spinto la mia sedia a un posto libero e ho preso il te con lei e i cuscini.",shape=box,color=blue];
		j610172487 -> j1088839575;
	j1684557565 [label="Vorrei solo che potessimo ripararlo, sinceramente. Riportare indietro il vero Otak.",shape=box,color=red];
		j1684557565 -> j2840356655;
	j999517241 [label="Mi fa sorridere. È diverente, ma nasconde qualcosa di tragico.",shape=box,color=red];
		j999517241 -> j2840356655;
	j1796400878 [label="Purtroppo, non è possibile ripararlo. E credo che sia parecchio fastidioso. ",shape=box,color=red];
		j1796400878 -> j2840356655;
	j4036959629 [label="Vegliando su questo posto e sul cuore che pompa l'energia del Void nel Sistema Origin, mantenendoci tutti... utilizzabili, in realtà, da quando Entrati se n'è andato.",shape=box,color=red];
		j4036959629 -> j3850907693;
	j2862848923 [label="I suoi occhi erano luminosi in certi momenti, ma spenti in altri, come quelli di una bambola...",shape=box,color=blue];
		j2862848923 -> j161958783;
		j2862848923 -> j2527642995;
		j2862848923 -> j1348690447;
		j2862848923 -> j76592750;
	j3850907693 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j3850907693 -> j570571527 [label=true,color=green];
		j3850907693 -> j3305608163 [label=false,color=brown];
	j161958783 [label="Perché ti sei seduta con lei?",shape=box,color=red];
		j161958783 -> j404062383;
	j2527642995 [label="Cosa è successo a Suor Cécilia?",shape=box,color=red];
		j2527642995 -> j3885643419;
	j1348690447 [label="Spero che per lei la tua presenza abbia significato qualcosa.",shape=box,color=red];
		j1348690447 -> j2648843962;
	j76592750 [label="È stato gentile da parte tua sederti con lei.",shape=box,color=red];
		j76592750 -> j3869073688;
	j570571527 [label="Lei ha accettato la sua assenza e hanno fatto pace, ma è stato veramente difficile arrivare a questa conclusione.",shape=box,color=red];
		j570571527 -> j2026304535;
	j3305608163 [label="Lei non ha ancora accettato la sua assenza, e continuano a litigare tra di loro.",shape=box,color=red];
		j3305608163 -> j2170971946;
	j404062383 [label="+15 Chemistry",color=orange];
		j404062383 -> j3403097230;
	j3885643419 [label="Quello che succede a chiunque nelle sue condizioni. Continuò a svanire, come un dipinto al sole, finché non rimase più nulla. ",shape=box,color=blue];
		j3885643419 -> j1778299809;
	j2648843962 [label="+10 Chemistry",color=orange];
		j2648843962 -> j2962961077;
	j3869073688 [label="+5 Chemistry",color=orange];
		j3869073688 -> j2768539951;
	j2026304535 [label="Sapere che lui è ancora là fuori, da qualche parte, e che non le ha detto una parola, né le ha mandato una lettera...?",shape=box,color=red];
		j2026304535 -> j3436858554;
	j2170971946 [label="Sapere che lui è ancora là fuori, da qualche parte, e che non le ha detto una parola, né le ha mandato una lettera...?",shape=box,color=red];
		j2170971946 -> j173544120;
	j3403097230 [label="Una domanda saggia. Una domanda molto saggia. Credo che ci siano stati molti motivi che mi hanno ispirata. Mi piace pensare che sia stata la gentilezza a spingermi al suo tavolo.",shape=box,color=blue];
		j3403097230 -> j1622281260;
	j1778299809 [label="E ci poi ci ha lasciati, e abbiamo organizzato una veglia per lei. Spero che, alla fine, riesca a ricordare coloro che sono stavi veramente gentili con lei. ",shape=box,color=blue];
		j1778299809 -> j3105563972;
	j2962961077 [label="Mi piacerebbe credere che abbia capito, da qualche parte sotto la superficie.",shape=box,color=blue];
		j2962961077 -> j3105563972;
	j2768539951 [label="Ma è stata gentilezza ? O è stato il senso di colpa a spingermi a farlo ? Ah, ma sei solo gentile con te stesso, dicendo così. ",shape=box,color=blue];
		j2768539951 -> j3105563972;
	j3436858554 [label="Non riesco a immaginare quanto doloroso posse essere per lei. Per loro.",shape=box,color=red];
		j3436858554 -> j3444301286;
	j173544120 [label="Ciò distruggerebbe le poche possibilità di riconciliazione che potrebbero avere.",shape=box,color=red];
		j173544120 -> j108287135;
	j1622281260 [label="Ma credo che fosse senso di colpa, forse, nel profondo. Che se non l'avessi fatto, l'avrei trascurata. Come si trascura un figlio.",shape=box,color=blue];
		j1622281260 -> j3105563972;
	j3105563972 [label="Mi piacerebbe credere che il tuo Otak conosca persone gentili e pazienti con lui. Ma, d'altronde, non è veramente lì, no ?",shape=box,color=blue];
		j3105563972 -> j3551409111;
	j3444301286 [label="Anche se capisco la logica dietro la decisione di proteggerli dal dolore che le Cardinal ha causato con la sua necessaria dipartita...",shape=box,color=blue];
		j3444301286 -> j1097143267;
	j108287135 [label="+10 Chemistry",color=orange];
		j108287135 -> j2138002211;
	j3551409111 [label="Sto parlando di un elaborato strumento tecnologico, fatto per assomigliare a un uomo, non è vero ? Un fonografo, molto, molto più complesso. Come Necraloid, non ha anima.",shape=box,color=blue];
		j3551409111 -> j2264165358;
		j3551409111 -> j2435451930;
		j3551409111 -> j3904556183;
		j3551409111 -> j1295010834;
		j3551409111 -> j981377794;
	j1097143267 [label="Penso che sia inutilmente crudele, non credi ? Potrebbero crederlo morto. O peggio ! E noi, viviamo qui, comme des rats d'égout ?",shape=box,color=blue];
		j1097143267 -> j3523479880;
		j1097143267 -> j1215294227;
	j2138002211 [label="Oui... capisco la logica. Allora, mi impegnerei a rimettere insieme la loro famiglia, se puoi, non ? Sembra essere l'unica speranza che abbiamo per uscire da questo posto. ",shape=box,color=blue];
		j2138002211 -> j2951901439;
	j2264165358 [label="Necraloid potrebbe non avere un'anima, ma è unico. Altri Cephalon, come Otak, invece ce l'hanno. Sono stati distrutti nel modo in cui sono stati creati.",shape=box,color=red];
		j2264165358 -> j3660903240;
	j2435451930 [label="Hai ragione. Quindi cosa vorresti che facessi al riguardo?",shape=box,color=red];
		j2435451930 -> j1644823984;
	j3904556183 [label="Tu hai ragione. Loro no. Ma questo non significa che possiamo trattarli male.",shape=box,color=red];
		j3904556183 -> j335539129;
	j1295010834 [label="Non so se hai ragione o no. Ma possono ancora pensare e provare sentimenti, e non possiamo trattarli come cose.",shape=box,color=red];
		j1295010834 -> j3888994247;
	j981377794 [label="Necraloid ha un'anima. Tutti i Cephalon ce l'hanno.",shape=box,color=red];
		j981377794 -> j1785879729;
	j3523479880 [label="Non spetta a me prendere questa decisione.",shape=box,color=red];
		j3523479880 -> j612472319;
	j1215294227 [label="In realtà ho un'amica che adora i ratti. Li trovo adorabili.",shape=box,color=red];
		j1215294227 -> j3567601009;
	j2951901439 [label="Per non passare il resto della nostra vita intrappolati qui, comme des rats d'égout. ",shape=box,color=blue];
		j2951901439 -> j3204066158;
		j2951901439 -> j639241539;
	j3660903240 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j3660903240 -> j3507489189;
	j1644823984 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j1644823984 -> j980262553;
	j335539129 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j335539129 -> j3273910702;
	j3888994247 [label="Boolean MarieCephalonUnsure is now true.",color=orange];
		j3888994247 -> j3724260729;
	j1785879729 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j1785879729 -> j29579386;
	j612472319 [label="Lo so. Manifestarsi a loro è una decisione del Monsieur Loid, e di tutti gli altri.",shape=box,color=blue];
		j612472319 -> j3834270441;
	j3567601009 [label="+15 Chemistry",color=orange];
		j3567601009 -> j3878709829;
	j3204066158 [label="Sono stato negligente. Hai ragione. Mi metterò al lavoro.",shape=box,color=red];
		j3204066158 -> j2748351554;
	j639241539 [label="In realtà ho un'amica che adora i ratti. Li trovo adorabili. ",shape=box,color=red];
		j639241539 -> j186964643;
	j3507489189 [label="+5 Chemistry",color=orange];
		j3507489189 -> j3319189598;
	j980262553 [label="Oh, non pensare che io voglia che tu sia crudele ! Non ! Fanne tesoro, perché sono preziosi e non è per colpa loro che sono come sono !",shape=box,color=blue];
		j980262553 -> j3668802077;
	j3273910702 [label="+5 Chemistry",color=orange];
		j3273910702 -> j980262553;
	j3724260729 [label="+5 Chemistry",color=orange];
		j3724260729 -> j985409261;
	j29579386 [label="+5 Chemistry",color=orange];
		j29579386 -> j4255414053;
	j3834270441 [label="Direi che è un senso di colpa, non di nobiltà, a trattenerci qui.",shape=box,color=blue];
		j3834270441 -> j564597406;
	j3878709829 [label="E mi piacerebbe tanto incontrarli un giorno, ma non è questo il punto, sciocco lupo.",shape=box,color=blue];
		j3878709829 -> j3834270441;
	j2748351554 [label="+5 Chemistry",color=orange];
		j2748351554 -> j3900104729;
	j186964643 [label="+5 Chemistry",color=orange];
		j186964643 -> j3878709829;
	j3319189598 [label="Un'ulteriore prova che il diavolo e i suoi simili avevano ragione a essere condannati. Ma forse hai ragione riguardo a Otak e ai suoi simili, o forse crederci ti dà pace.",shape=box,color=blue];
		j3319189598 -> j3175926099;
	j3668802077 [label="Il mio cuore si spezza solo per i corpi distrutti che i diavoli Orokin si sono lasciati alle spalle. Non erano dei, ma divoratori di tutto ciò che incontravano. Basta guardare quello con cui viaggiavamo per averne la prova.",shape=box,color=blue];
		j3668802077 -> j187895658;
	j985409261 [label="Forse hai ragione, ma non credo che i diavoli Orokin conoscessero il funzionamento dell'anima meglio di noi. Non erano grandi dei.",shape=box,color=blue];
		j985409261 -> j937675349;
	j4255414053 [label="Forse hai ragione, o forse crederci ti dà pace.",shape=box,color=blue];
		j4255414053 -> j187895658;
	j564597406 [label="Che nascondiamo qualche grande e terribile peccato.",shape=box,color=blue];
		j564597406 -> j3591758629;
	j3900104729 [label="Grazie. Non so se ci riuscirai, ma a volte, l'unica cosa che possiamo fare è provare.",shape=box,color=blue];
		j3900104729 -> j3834270441;
	j3175926099 [label="In ogni caso, scelgo di credere che l'Otak morto tanto tempo fa ti sorriderebbe ora, se fossi gentile con tutto ciò che vive ancora nella sua memoria.",shape=box,color=blue];
		j3175926099 -> j1531393501;
	j187895658 [label="Per me è semplicemente difficile dire che Necraloid ha un'anima quando Loid è proprio accanto a lui, oui ?",shape=box,color=blue];
		j187895658 -> j3175926099;
	j937675349 [label="Tecnologia, forse - scienza, sì - ma l'anima ? Difficilmente potrebbero dominare il loro cuore ! Guarda il diavolo con cui viaggiamo se hai bisogno di altre prove.",shape=box,color=blue];
		j937675349 -> j187895658;
	j3591758629 [label="Ed è quel peccato che deve essere perdonato.",shape=box,color=blue];
		j3591758629 -> j3025813830;
	j1531393501 [label="Check boolean LoidFamilyComplete",color=orange];
		j1531393501 -> j1670422161 [label=true,color=green];
		j1531393501 -> j2885762591 [label=false,color=brown];
	j3025813830 [label="Grazie, mi hai dato molto su cui riflettere. À la revoyure.",shape=box,color=blue];
		j3025813830 -> "Chat ends.";
	j1670422161 [label="Devo andare. Ma, merci. Ho molto su cui riflettere.",shape=box,color=blue];
		j1670422161 -> "Chat ends.";
	j2885762591 [label="Spero semplicemente di incontrare qualche strano fac-similé ancora in vita quando un giorno Monsieur Necraloid tornerà a salire le scale.",shape=box,color=blue];
		j2885762591 -> j663464319;
		j2885762591 -> j3521385323;
	j663464319 [label="Non so se sia saggio intromettersi negli affari altrui.",shape=box,color=red];
		j663464319 -> j3351551251;
	j3521385323 [label="Spero che un giorno potremo dire la verità alla Famiglia Entrati. E spero quel giorno arrivi il prima possibile. ",shape=box,color=red];
		j3521385323 -> j3351551251;
	j3351551251 [label="Check boolean MarieFamily1",color=orange];
		j3351551251 -> j3600011923 [label=true,color=green];
		j3351551251 -> j766490364 [label=false,color=brown];
	j3600011923 [label="Vedremo, vorrei sapere da te più nel dettaglio perché dobbiamo restare.",shape=box,color=blue];
		j3600011923 -> j916473100;
	j766490364 [label="C'è una storia che credo tu non mi stia raccontando. Ma credo che per oggi sia abbastanza, oui ?",shape=box,color=blue];
		j766490364 -> j916473100;
	j916473100 [label="Torneremo presto a parlare della famiglia Entrati.",shape=box,color=blue];
		j916473100 -> "Chat ends.";
}