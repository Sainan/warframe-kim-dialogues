digraph {
	735 [label="MarieRank2Convo5 begins.",color=orange];
		735 -> 736;
	736 [label="Evaluate expressions",color=orange];
		736 -> 739 [label="MarieOtak1",color=purple];
		736 -> 738 [label="MarieFamily1",color=purple];
		736 -> 737 [label="false",color=purple];
	739 [label="Ho riflettuto su quello che mi hai detto riguardo Monsieur Otak.",shape=box,color=blue];
		739 -> 743;
	738 [label="Ho riflettuto su quello che mi hai detto riguardo la famiglia de le Cardinal.",shape=box,color=blue];
		738 -> 742;
	737 [label="Vorrei domandarti nuovamente del Monsieur \"Necraloid\", posso?",shape=box,color=blue];
		737 -> 741;
		737 -> 740;
	743 [label="Mi chiedevo se fosse simile a una mia storia. Potrei raccontartela, se hai tempo.",shape=box,color=blue];
		743 -> 749;
		743 -> 748;
	742 [label="Mi chiedevo, potresti raccontarmi la storia di Otak, il volto infantile sul retro del cranio del Necraloid?",shape=box,color=blue];
		742 -> 747;
		742 -> 746;
	741 [label="Certo, di cosa si tratta?",shape=box,color=red];
		741 -> 745;
	740 [label="[Fine.]",shape=box,color=red];
		740 -> 744;
	749 [label="Fai pure.",shape=box,color=red];
		749 -> 754;
	748 [label="[Fine.]",shape=box,color=red];
		748 -> 753;
	747 [label="Certo.",shape=box,color=red];
		747 -> 752;
	746 [label="Forse più tardi. [Fine.]",shape=box,color=red];
		746 -> 751;
	745 [label="Mi incuriosisce il motivo per cui sulla sua schiena c'è un altro volto che assomiglia allo scarabocchio di un bambino.",shape=box,color=blue];
		745 -> 750;
	744 [label="Chat ends.",color=orange];
	754 [label="C'era una suora alla Cathédrale, che una volta si perse nei corridoi del suo passato. Suor Cécilia.",shape=box,color=blue];
		754 -> 757;
	753 [label="Chat ends.",color=orange];
	752 [label="A detta di tutti era un genio e la mente dietro lo sfruttamento dei cristalli di argon.",shape=box,color=red];
		752 -> 756;
	751 [label="Chat ends.",color=orange];
	750 [label="Ho chiesto informazioni sia a Monsieur Necraloid che a Monsieur Loid, ma nessuno dei due ha voluto parlarne, mi hanno solo detto un nome: Otak. E lo hanno pronunciato con grande tristezza.",shape=box,color=blue];
		750 -> 755;
	757 [label="Era solita fermarsi davanti al grande orologio dell'atrio e proclamare che erano le due del pomeriggio, ma non sapeva che ora fosse veramente.",shape=box,color=blue];
		757 -> 761;
	756 [label="Che vengono sfruttati dal Void - sono il motivo per cui possiamo creare molti dei potenti warframe e armi che realizziamo.",shape=box,color=red];
		756 -> 760;
	755 [label="Quindi eccomi qui, a parlare con te, nella speranza che tu possa aiutarmi.",shape=box,color=blue];
		755 -> 758;
		755 -> 759;
	761 [label="Trovavamo tutti i dipinti nei corridoi girati nel verso sbagliato e lei diceva che le sussurravano terribili complotti.",shape=box,color=blue];
		761 -> 766;
	760 [label="Si specializzò in cristallografia. E i suoi lavori furono archiviati qui, nei laboratori.",shape=box,color=red];
		760 -> 765;
	758 [label="Vuoi sapere di Otak? O del perché non puoi parlargli?",shape=box,color=red];
		758 -> 762;
	759 [label="Otak è difficile da spiegare...",shape=box,color=red];
		759 -> 2919;
	766 [label="Abbiamo scoperto che stava semplicemente ascoltando le conversazioni da altre stanze, e pensava che fossero i dipinti a parlare...",shape=box,color=blue];
		766 -> 770;
	765 [label="Per qualche ragione, non so perché, fu trasformato in un Cephalon e gli fu dato il suo guscio necraloid.",shape=box,color=red];
		765 -> 769;
	762 [label="Credo che col tempo mi piacerebbe sapere entrambe le cose, ma lascerò che sia tu a decidere da dove cominciare. Non so cosa sia più importante, après tout.",shape=box,color=blue];
		762 -> 2919;
	2919 [label="Check boolean LoidFamilyComplete",color=orange];
		2919 -> 764 [label=true,color=green];
		2919 -> 764 [label=false,color=brown];
		2919 -> 763 [label=false,color=brown];
	770 [label="Una volta scambiò tutti i cuscini di un salottino per bambini e li invitò tutti a prendere il tè...",shape=box,color=blue];
		770 -> 774;
	769 [label="Non tutti i Cephalon furono creati per punizione. Ma le cose andarono... male qui su Deimos, e subì gravi danni.",shape=box,color=red];
		769 -> 773;
	764 [label="Otak era un Archimedeo, uno scienziato e accademico Orokin. Quello che gli è successo non è esattamente una storia felice.",shape=box,color=red];
		764 -> 768;
	763 [label="Beh... in breve, di sopra ci sono alcuni membri della famiglia Entrati, e non sono... esattamente consapevoli che siamo qui sotto.",shape=box,color=red];
		763 -> 767;
	774 [label="Quando entrai nella stanza, lei mi guardò e disse: \"Oh, Suor Odette, eccola! Ci sono i bambini dell'orfanotrofio, vuole unirsi a me?\"",shape=box,color=blue];
		774 -> 777;
		774 -> 778;
	773 [label="+5 Chemistry",color=orange];
		773 -> 776;
	768 [label="Update boolean MarieOtak1",color=orange];
		768 -> 772;
	767 [label="Update boolean MarieFamily1",color=orange];
		767 -> 771;
	777 [label="Che cosa hai fatto?",shape=box,color=red];
		777 -> 781;
	778 [label="Chi era Suor Odette?",shape=box,color=red];
		778 -> 782;
	776 [label="Pauvre petit...",shape=box,color=blue];
		776 -> 780;
	772 [label="Par les Luminaires... continua.",shape=box,color=blue];
		772 -> 752;
	771 [label="Par les Luminaires... Vuoi dire che siamo tutti qui in segreto ?! È per questo che non ci è permesso lasciare questo posto ?! Mais pourquoi ?!",shape=box,color=blue];
		771 -> 775;
	781 [label="Ho spinto la mia sedia a un posto libero e ho preso il te con lei e i cuscini, cos'altro potevo fare ?",shape=box,color=blue];
		781 -> 787;
	782 [label="Suor Odette era morta da trent'anni, temo.",shape=box,color=blue];
		782 -> 788;
	780 [label="Quindi, è stato trasferito nel necraloid principale - l'unico Necraloid rimasto - ed è... beh? È difficile da spiegare.",shape=box,color=red];
		780 -> 784;
		780 -> 785;
		780 -> 786;
	775 [label="Sua figlia, Euleria - detta Madre, e la sua famiglia, si sono presi cura di Deimos per tutto questo tempo.",shape=box,color=red];
		775 -> 779;
	787 [label="Quanto abbiamo riso insieme, mentre mi raccontava storie del suo passato. Storie che Suor Cécilia non aveva mai raccontato a nessuno, almeno per quanto ne so.",shape=box,color=blue];
		787 -> 791;
	788 [label="Ho spinto la mia sedia a un posto libero e ho preso il te con lei e i cuscini.",shape=box,color=blue];
		788 -> 787;
	784 [label="Vorrei solo che potessimo ripararlo, sinceramente. Riportare indietro il vero Otak.",shape=box,color=red];
		784 -> 754;
	785 [label="Mi fa sorridere. È diverente, ma nasconde qualcosa di tragico.",shape=box,color=red];
		785 -> 754;
	786 [label="Purtroppo, non è possibile ripararlo. E credo che sia parecchio fastidioso. ",shape=box,color=red];
		786 -> 754;
	779 [label="Vegliando su questo posto e sul cuore che pompa l'energia del Void nel Sistema Origin, mantenendoci tutti... utilizzabili, in realtà, da quando Entrati se n'è andato.",shape=box,color=red];
		779 -> 783;
	791 [label="I suoi occhi erano luminosi in certi momenti, ma spenti in altri, come quelli di una bambola...",shape=box,color=blue];
		791 -> 794;
		791 -> 795;
		791 -> 796;
		791 -> 797;
	783 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		783 -> 789 [label=true,color=green];
		783 -> 790 [label=false,color=brown];
	794 [label="Perché ti sei seduta con lei?",shape=box,color=red];
		794 -> 800;
	795 [label="Cosa è successo a Suor Cécilia?",shape=box,color=red];
		795 -> 801;
	796 [label="Spero che per lei la tua presenza abbia significato qualcosa.",shape=box,color=red];
		796 -> 802;
	797 [label="È stato gentile da parte tua sederti con lei.",shape=box,color=red];
		797 -> 803;
	789 [label="Lei ha accettato la sua assenza e hanno fatto pace, ma è stato veramente difficile arrivare a questa conclusione.",shape=box,color=red];
		789 -> 792;
	790 [label="Lei non ha ancora accettato la sua assenza, e continuano a litigare tra di loro.",shape=box,color=red];
		790 -> 793;
	800 [label="+15 Chemistry",color=orange];
		800 -> 806;
	801 [label="Quello che succede a chiunque nelle sue condizioni. Continuò a svanire, come un dipinto al sole, finché non rimase più nulla. ",shape=box,color=blue];
		801 -> 807;
	802 [label="+10 Chemistry",color=orange];
		802 -> 808;
	803 [label="+5 Chemistry",color=orange];
		803 -> 809;
	792 [label="Sapere che lui è ancora là fuori, da qualche parte, e che non le ha detto una parola, né le ha mandato una lettera...?",shape=box,color=red];
		792 -> 798;
	793 [label="Sapere che lui è ancora là fuori, da qualche parte, e che non le ha detto una parola, né le ha mandato una lettera...?",shape=box,color=red];
		793 -> 799;
	806 [label="Una domanda saggia. Una domanda molto saggia. Credo che ci siano stati molti motivi che mi hanno ispirata. Mi piace pensare che sia stata la gentilezza a spingermi al suo tavolo.",shape=box,color=blue];
		806 -> 812;
	807 [label="E ci poi ci ha lasciati, e abbiamo organizzato una veglia per lei. Spero che, alla fine, riesca a ricordare coloro che sono stavi veramente gentili con lei. ",shape=box,color=blue];
		807 -> 813;
	808 [label="Mi piacerebbe credere che abbia capito, da qualche parte sotto la superficie.",shape=box,color=blue];
		808 -> 813;
	809 [label="Ma è stata gentilezza ? O è stato il senso di colpa a spingermi a farlo ? Ah, ma sei solo gentile con te stesso, dicendo così. ",shape=box,color=blue];
		809 -> 813;
	798 [label="Non riesco a immaginare quanto doloroso posse essere per lei. Per loro.",shape=box,color=red];
		798 -> 804;
	799 [label="Ciò distruggerebbe le poche possibilità di riconciliazione che potrebbero avere.",shape=box,color=red];
		799 -> 805;
	812 [label="Ma credo che fosse senso di colpa, forse, nel profondo. Che se non l'avessi fatto, l'avrei trascurata. Come si trascura un figlio.",shape=box,color=blue];
		812 -> 813;
	813 [label="Mi piacerebbe credere che il tuo Otak conosca persone gentili e pazienti con lui. Ma, d'altronde, non è veramente lì, no ?",shape=box,color=blue];
		813 -> 817;
	804 [label="Anche se capisco la logica dietro la decisione di proteggerli dal dolore che le Cardinal ha causato con la sua necessaria dipartita...",shape=box,color=blue];
		804 -> 810;
	805 [label="+10 Chemistry",color=orange];
		805 -> 811;
	817 [label="Sto parlando di un elaborato strumento tecnologico, fatto per assomigliare a un uomo, non è vero ? Un fonografo, molto, molto più complesso. Come Necraloid, non ha anima.",shape=box,color=blue];
		817 -> 822;
		817 -> 823;
		817 -> 824;
		817 -> 825;
		817 -> 826;
	810 [label="Penso che sia inutilmente crudele, non credi ? Potrebbero crederlo morto. O peggio ! E noi, viviamo qui, comme des rats d'égout ?",shape=box,color=blue];
		810 -> 814;
		810 -> 815;
	811 [label="Oui... capisco la logica. Allora, mi impegnerei a rimettere insieme la loro famiglia, se puoi, non ? Sembra essere l'unica speranza che abbiamo per uscire da questo posto. ",shape=box,color=blue];
		811 -> 816;
	822 [label="Necraloid potrebbe non avere un'anima, ma è unico. Altri Cephalon, come Otak, invece ce l'hanno. Sono stati distrutti nel modo in cui sono stati creati.",shape=box,color=red];
		822 -> 831;
	823 [label="Hai ragione. Quindi cosa vorresti che facessi al riguardo?",shape=box,color=red];
		823 -> 832;
	824 [label="Tu hai ragione. Loro no. Ma questo non significa che possiamo trattarli male.",shape=box,color=red];
		824 -> 833;
	825 [label="Non so se hai ragione o no. Ma possono ancora pensare e provare sentimenti, e non possiamo trattarli come cose.",shape=box,color=red];
		825 -> 834;
	826 [label="Necraloid ha un'anima. Tutti i Cephalon ce l'hanno.",shape=box,color=red];
		826 -> 835;
	814 [label="Non spetta a me prendere questa decisione.",shape=box,color=red];
		814 -> 818;
	815 [label="In realtà ho un'amica che adora i ratti. Li trovo adorabili.",shape=box,color=red];
		815 -> 819;
	816 [label="Per non passare il resto della nostra vita intrappolati qui, comme des rats d'égout. ",shape=box,color=blue];
		816 -> 820;
		816 -> 821;
	831 [label="Update boolean MarieCephalonSoul",color=orange];
		831 -> 839;
	832 [label="Update boolean MarieCephalonNoSoul",color=orange];
		832 -> 840;
	833 [label="Update boolean MarieCephalonNoSoul",color=orange];
		833 -> 841;
