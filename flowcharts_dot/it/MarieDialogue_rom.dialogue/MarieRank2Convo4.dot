		"MarieRank2Convo4 begins." -> j916297443;
		"MarieRank2Convo4 begins." -> j4115718638;
	j3784781199 [label="Posso chiederti di Roathe? O ti darebbe fastidio?",shape=box,color=red];
		j3784781199 -> j3046238341;
	j916297443 [label="Posso chiederti dell'elefante nella stanza?",shape=box,color=red];
		j916297443 -> j3412249997;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j3046238341 [label="Ce diable est un imbécile qui se croit au-dessus de tout reproche ! Je préfèrerais boire un pot de vernis à bois plutôt que de passer une minute de plus à l'écouter s'enorgueillir comme un chat qui se lèche le pelage !",shape=box,color=blue];
		j3046238341 -> j2400306083;
		j3046238341 -> j676102683;
	j3412249997 [label="Quoi! Où ça? Un éléphant ?!",shape=box,color=blue];
		j3412249997 -> j616421377;
	"Chat ends." [color=orange];
	j2400306083 [label="È stato meravigliosamente creativo.",shape=box,color=red];
		j2400306083 -> j4043312811;
	j676102683 [label="Io... suppongo che niente di tutto ciò sia stato gentile.",shape=box,color=red];
		j676102683 -> j1248409343;
	j616421377 [label="Vedo solo un pesce, un uccello e... qualunque cosa sia M'sieur Tagfer. Vedo molte cose strane in questo Santuario, ma nessun éléphant - è una battuta ?",shape=box,color=blue];
		j616421377 -> j2936201209;
	j4043312811 [label="+5 Chemistry",color=orange];
		j4043312811 -> j2212358051;
	j1248409343 [label="+5 Chemistry",color=orange];
		j1248409343 -> j483388145;
	j2936201209 [label="Oh! Scusa. È un modo di dire che mi hanno insegnato i miei amici del 1999... ",shape=box,color=red];
		j2936201209 -> j257371861;
		j2936201209 -> j2722015146;
	j2212358051 [label="Merci. È stato creativo, ma mi hai fatto una domanda e la mia ira non avrebbe dovuto essere rivolta a te, perdonami.",shape=box,color=blue];
		j2212358051 -> j3218359144;
	j483388145 [label="Non lo era. Perdonami, non avrei dovuto fartelo notare. ",shape=box,color=blue];
		j483388145 -> j3218359144;
	j257371861 [label="Non intendevo letteralmente.",shape=box,color=red];
		j257371861 -> j3467344238;
	j2722015146 [label="Ora capisco perché pensano che sia sempre così carino quando sono confuso...",shape=box,color=red];
		j2722015146 -> j2263365606;
	j3218359144 [label="Evaluate expressions",color=orange];
		j3218359144 -> j4001894524 [label="MarieRoatheWarning",color=purple];
		j3218359144 -> j729447969 [label="DrifterRoathe",color=purple];
		j3218359144 -> j978085345 [label="MarieRoatheSoldier",color=purple];
		j3218359144 -> j4028230960 [label="false",color=purple];
	j3467344238 [label="+5 Chemistry",color=orange];
		j3467344238 -> j3032511348;
	j2263365606 [label="+5 Chemistry",color=orange];
		j2263365606 -> j3636008105;
	j4001894524 [label="Anche se mi sorprende che tu sia tornato a chiedermi cosa ne penso. Sei stato abbastanza chiaro nel tuo avvertimento prima. Non vuoi sentirmi parlare male di lui e dei suoi simili.",shape=box,color=blue];
		j4001894524 -> j1649208470;
		j4001894524 -> j2741139321;
	j729447969 [label="Lo ammetto, non so come dovrei continuare questa conversazione, veramente. Sembri attratto da lui comme un papillon vers une flamme.",shape=box,color=blue];
		j729447969 -> j1985472337;
		j729447969 -> j2042990845;
	j978085345 [label="Lo vuoi ancora come alleato ? Stai giocando un gioco pericoloso, aggiungendolo al tuo branco, lupo. Potrebbe strapparti la gola quando meno te lo aspetti.",shape=box,color=blue];
		j978085345 -> j1675101123;
		j978085345 -> j195250575;
	j4028230960 [label="Mi sorprende che tu venga da me. È chiaro che ho una pessima opinione di quel diavolo.",shape=box,color=blue];
		j4028230960 -> j2190416878;
		j4028230960 -> j667013535;
	j3032511348 [label="Non mi sorprenderebbe se ci fosse ! Sembra che qui ci siano tutti gli altri tipi di cose.",shape=box,color=blue];
		j3032511348 -> j3337405396;
	j3636008105 [label="Oui, è davvero affascinante, non è vero ? Mi trovo spesso a dire qualcosa a Monsieur Loid e lui mi guarda come se lo avessi colto completamente impreparato.",shape=box,color=blue];
		j3636008105 -> j2912066468;
	j1649208470 [label="Ho risposto duramente e me ne scuso. Non voglio condannarlo già per le sue azioni - sto cercando di capirlo da tutti i punti di vista.",shape=box,color=red];
		j1649208470 -> j3462429991;
	j2741139321 [label="Non lo so. Ha condotto una vita difficile da comprendere. Ma ero curioso di sapere se mi raccontavi la storia di come vi siete conosciuti.",shape=box,color=red];
		j2741139321 -> j2201545776;
	j1985472337 [label="Sto semplicemente cercando di trovare la spiegazione del perché è come è. Sto cercando di capirlo.",shape=box,color=red];
		j1985472337 -> j3341825684;
	j2042990845 [label="Se ne sapessi di più su di lui, potrei capire come indirizzarlo verso un percorso un po'... più benevolo.",shape=box,color=red];
		j2042990845 -> j3409267599;
	j1675101123 [label="Lo so. Ma non posso odiarlo per aver fatto ciò che doveva fare per servire il suo popolo. Ho dovuto fare la stessa cosa.",shape=box,color=red];
		j1675101123 -> j2484027407;
	j195250575 [label="È uno degli Orokin più pericolosi che l'impero abbia mai conosciuto. Saremmo degli sciocchi a rifiutare un simile aiuto.",shape=box,color=red];
		j195250575 -> j4063593754;
	j2190416878 [label="Lo so, ma devi avere una visione più chiara di lui. Sto cercando di capirlo meglio.",shape=box,color=red];
		j2190416878 -> j2468302478;
	j667013535 [label="Ecco perché ti chiedo di lui. Voglio capirlo, e non mi fido molto di come racconta la sua versione dei fatti.",shape=box,color=red];
		j667013535 -> j3642982337;
	j3337405396 [label="Cosa significa ? Se c'è un elefante nella stanza, perché non dovremmo parlarne?",shape=box,color=blue];
		j3337405396 -> j1445899068;
	j2912066468 [label="E per un uomo che avrebbe potuto essere il servitore della Regina stessa, ne vado fiera.",shape=box,color=blue];
		j2912066468 -> j3337405396;
