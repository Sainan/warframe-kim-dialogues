	616 [label="+5 Chemistry",color=orange];
		616 -> 619;
	617 [label="+5 Chemistry",color=orange];
		617 -> 620;
	624 [label="Anche se mi sorprende che tu sia tornato a chiedermi cosa ne penso. Sei stato abbastanza chiaro nel tuo avvertimento prima. Non vuoi sentirmi parlare male di lui e dei suoi simili.",shape=box,color=blue];
		624 -> 633;
		624 -> 634;
	623 [label="Lo ammetto, non so come dovrei continuare questa conversazione, veramente. Sembri attratto da lui comme un papillon vers une flamme.",shape=box,color=blue];
		623 -> 631;
		623 -> 632;
	622 [label="Lo vuoi ancora come alleato ? Stai giocando un gioco pericoloso, aggiungendolo al tuo branco, lupo. Potrebbe strapparti la gola quando meno te lo aspetti.",shape=box,color=blue];
		622 -> 629;
		622 -> 630;
	621 [label="Mi sorprende che tu venga da me. È chiaro che ho una pessima opinione di quel diavolo.",shape=box,color=blue];
		621 -> 627;
		621 -> 628;
	619 [label="Non mi sorprenderebbe se ci fosse ! Sembra che qui ci siano tutti gli altri tipi di cose.",shape=box,color=blue];
		619 -> 625;
	620 [label="Oui, è davvero affascinante, non è vero ? Mi trovo spesso a dire qualcosa a Monsieur Loid e lui mi guarda come se lo avessi colto completamente impreparato.",shape=box,color=blue];
		620 -> 626;
	633 [label="Ho risposto duramente e me ne scuso. Non voglio condannarlo già per le sue azioni - sto cercando di capirlo da tutti i punti di vista.",shape=box,color=red];
		633 -> 642;
	634 [label="Non lo so. Ha condotto una vita difficile da comprendere. Ma ero curioso di sapere se mi raccontavi la storia di come vi siete conosciuti.",shape=box,color=red];
		634 -> 643;
	631 [label="Sto semplicemente cercando di trovare la spiegazione del perché è come è. Sto cercando di capirlo.",shape=box,color=red];
		631 -> 640;
	632 [label="Se ne sapessi di più su di lui, potrei capire come indirizzarlo verso un percorso un po'... più benevolo.",shape=box,color=red];
		632 -> 641;
	629 [label="Lo so. Ma non posso odiarlo per aver fatto ciò che doveva fare per servire il suo popolo. Ho dovuto fare la stessa cosa.",shape=box,color=red];
		629 -> 638;
	630 [label="È uno degli Orokin più pericolosi che l'impero abbia mai conosciuto. Saremmo degli sciocchi a rifiutare un simile aiuto.",shape=box,color=red];
		630 -> 639;
	627 [label="Lo so, ma devi avere una visione più chiara di lui. Sto cercando di capirlo meglio.",shape=box,color=red];
		627 -> 636;
	628 [label="Ecco perché ti chiedo di lui. Voglio capirlo, e non mi fido molto di come racconta la sua versione dei fatti.",shape=box,color=red];
		628 -> 637;
	625 [label="Cosa significa ? Se c'è un elefante nella stanza, perché non dovremmo parlarne?",shape=box,color=blue];
		625 -> 635;
	626 [label="E per un uomo che avrebbe potuto essere il servitore della Regina stessa, ne vado fiera.",shape=box,color=blue];
		626 -> 625;
	642 [label="Add 1 to Thermostat",color=orange];
		642 -> 651;
