		j2468302478 -> j167477007;
	j3642982337 [label="Add 1 to Thermostat counter",color=orange];
		j3642982337 -> j3493170726;
	j1445899068 [label="Non riesco a immaginare che la maggior parte delle persone, che non si circondano di teste volanti e animali parlanti, non possa avere come argomento di conversazione un elefante.",shape=box,color=blue];
		j1445899068 -> j2911047870;
	j3672558373 [label="+5 Chemistry",color=orange];
		j3672558373 -> j1829452466;
	j300823201 [label="E tu pensi che io non capirei ? Non sono una stupida - non sono isterica, anche se sono stata trasportata e trasfigurata.",shape=box,color=blue];
		j300823201 -> j3078676798;
		j300823201 -> j273317429;
	j1302785830 [label="Capire fino a che punto, è la mia preoccupazione. Ma non hai bisogno che ti faccia la pratica, non sono tua madre, né desidero rovinare questa amicizia fin dai suoi primi giorni...",shape=box,color=blue];
		j1302785830 -> j4289794628;
	j3468863470 [label="+5 Chemistry",color=orange];
		j3468863470 -> j2298580092;
	j820153972 [label="+5 Chemistry",color=orange];
		j820153972 -> j4244276922;
	j1096425748 [label="Consiglio semplicemente cautela. Credo che potrebbe convincere Lua a dargli le stelle del cielo.",shape=box,color=blue];
		j1096425748 -> j3069483650;
	j167477007 [label="Capire fino a che punto, è la mia preoccupazione. Ma non c'è bisogno che ti faccia la predica.",shape=box,color=blue];
		j167477007 -> j1643412399;
	j3493170726 [label="+5 Chemistry",color=orange];
		j3493170726 -> j1786172574;
	j2911047870 [label="... credo di aver risposto alla mia stessa domanda, non è vero ?",shape=box,color=blue];
		j2911047870 -> j1051768042;
	j1829452466 [label="Apprezzo le scuse e le accetto, ma considera che sono stata trasportata e trasfigurata e mi ritrovo circondata dall'impossible. ",shape=box,color=blue];
		j1829452466 -> j1905380454;
	j3078676798 [label="Non importa. Andrò a parlare con il diavolo in persona.",shape=box,color=red];
		j3078676798 -> j4014689105;
	j273317429 [label="Mi dispiace. Non volevo discutere con te, non era questo che intendevo. ",shape=box,color=red];
		j273317429 -> j1427862571;
		j273317429 -> j2275961415;
	j4289794628 [label="Mi preoccupo solo per te. È una bestia abile e manipolatrice... ",shape=box,color=blue];
		j4289794628 -> j3529857456;
	j2298580092 [label="E ti dichiarerei Santo di Sol anche solo per aver tentato una cosa del genere.",shape=box,color=blue];
		j2298580092 -> j3529857456;
	j4244276922 [label="Oui, la maledizione del soldato... Bruciare la città per salvare il paese. Uccidere l'uomo per salvare la famiglia. Ma dove finisce l'orrore ?",shape=box,color=blue];
		j4244276922 -> j3647200210;
	j3069483650 [label="Ricordati chi e cosa è, in fin dei conti... non un dio, e nemmeno una bestia, ma un uomo. Un uomo che ha un'opinione troppo alta di sé.",shape=box,color=blue];
		j3069483650 -> j3529857456;
	j1643412399 [label="Potrebbe incantare Lua per farsi dare le stelle dal cielo. Fai attenzione, è tutto quello che dirò.",shape=box,color=blue];
		j1643412399 -> j3529857456;
	j1786172574 [label="Allora sei saggio a non ascoltare le sue parole dolci. Potrebbe convincere Lua a dargli le stelle del cielo.",shape=box,color=blue];
		j1786172574 -> j3529857456;
	j1051768042 [label="Sì. Significa ''possiamo parlare dell'argomento che stiamo tutti evitando, come se non stessimo parlando dell'elefante gigante nella stanza.''",shape=box,color=red];
		j1051768042 -> j2876112845;
	j1905380454 [label="Se credi che io non riesca a comprendere o non riesca a provare compassione per le storie degli altri, ti prego di riconsiderare la tua opinione, oui ?",shape=box,color=blue];
		j1905380454 -> j2602779077;
	j4014689105 [label="Qu'il en soit ainsi.",shape=box,color=blue];
		j4014689105 -> "Chat ends.";
	j1427862571 [label="È un soldato. Ha dovuto fare cose terribili in nome di uno ''scopo superiore''. So cosa si prova. A volte, quel tipo di vita ti trasforma in... beh. Lui.",shape=box,color=red];
		j1427862571 -> j2736638015;
	j2275961415 [label="Ha vissuto per centinaia, se non migliaia di anni. Chissà cosa significa davvero per una persona? Quanto dolore, quanta sofferenza? So cosa si prova.",shape=box,color=red];
		j2275961415 -> j2554725868;
	j3529857456 [label="Ma avresti voluto chiedermi del diavolo in persona, non è vero ? Cosa vorresti sapere ?",shape=box,color=blue];
		j3529857456 -> j1450646504;
		j3529857456 -> j2718965406;
		j3529857456 -> j149708205;
	j3647200210 [label="Dobbiamo vedere la guerra attraverso gli occhi dello statistico, perché se la vedessimo attraverso gli occhi dei caduti, non smetteremmo mai di piangere.",shape=box,color=blue];
		j3647200210 -> j3529857456;
	j2876112845 [label="E se mi è concesso di fare una seconda ipotesi sulla natura di questo éléphant... ha per caso la pelle blu ?",shape=box,color=blue];
		j2876112845 -> j3218359144;
	j2602779077 [label="E io, da parte mia, ci penserò due volte prima di dirti quello che devi fare.",shape=box,color=blue];
		j2602779077 -> j3078676798;
		j2602779077 -> j737651993;
	j2736638015 [label="+5 Chemistry",color=orange];
		j2736638015 -> j3020036646;
	j2554725868 [label="+5 Chemistry",color=orange];
		j2554725868 -> j1023695104;
	j1450646504 [label="Perché lo detesti così tanto?",shape=box,color=red];
		j1450646504 -> j526683418;
	j2718965406 [label="Perché Entrati lo ha lasciato con te e Lyon?",shape=box,color=red];
		j2718965406 -> j1879569534;
	j149708205 [label="Ero curioso di sapere come vi siete conosciuti?",shape=box,color=red];
		j149708205 -> j3483774294;
	j737651993 [label="Sono d'accordo.",shape=box,color=red];
		j737651993 -> j4215340319;
	j3020036646 [label="Ah, e ora mi sento davvero sciocca. Sì, certo, tu sai cosa significa uccidere in nome di uno ''scopo'', come hai detto... È ovvio che cercheresti di capire qualcuno che ha fatto lo stesso.",shape=box,color=blue];
		j3020036646 -> j2284081877;
	j1023695104 [label="Ah, e ora mi sento davvero una sciocca. Sì, certo, tu sai cosa significa vivere ancora e ancora... È ovvio che cercheresti di conoscere qualcuno che ha datto lo stesso.",shape=box,color=blue];
		j1023695104 -> j2284081877;
	j526683418 [label="Non è ovvio ? Il suo comportamento è come quello di un grosso felino che insiste nel marcare il territorio e nel buttare giù gli oggetti dagli scaffali.",shape=box,color=blue];
		j526683418 -> j2529991317;
		j526683418 -> j3768742648;
	j1879569534 [label="Quando il Cardinale Dimanche - Entrati - se ne andò per l'ultima volta, lasciò il diavolo sulla soglia di casa nostra. Affranto, sanguinante e a malapena in grado di ricordare il suo nome.",shape=box,color=blue];
		j1879569534 -> j2756821830;
	j3483774294 [label="C'era un temporale la notte in cui il diavolo arrivò. Un terribile tuono fece tremare le mura delle Cathédrale.",shape=box,color=blue];
		j3483774294 -> j4132570505;
	j4215340319 [label="Boolean MarieRoatheWarning is now false.",color=orange];
		j4215340319 -> j484911613;
	j2284081877 [label="Raggiungiamo un accordo. Se credi che io non riesca a comprendere o non riesca a provare compassione per le storie degli altri, ti prego di riconsiderare la tua opinione, oui ?",shape=box,color=blue];
		j2284081877 -> j2602779077;
	j2529991317 [label="Personalmente, mi piacciono molto i gatti. ",shape=box,color=red];
		j2529991317 -> j2402582486;
	j3768742648 [label="Non ti piacciono i gatti?",shape=box,color=red];
		j3768742648 -> j586796016;
	j2756821830 [label="Ora so che gli era appena stato somministrato il sérum, e che la trasformazione, seppur involontaria, è... dolorosa.",shape=box,color=blue];
		j2756821830 -> j2724016157;
	j4132570505 [label="Check boolean MarieLyonVisions",color=orange];
		j4132570505 -> j3452518497 [label=true,color=green];
		j4132570505 -> j3764291717 [label=false,color=brown];
	j484911613 [label="Magnifique ! Ora, avresti voluto chiedermi del diavolo in persona, non è vero ? Cosa vorresti sapere ?",shape=box,color=blue];
		j484911613 -> j1450646504;
		j484911613 -> j2718965406;
		j484911613 -> j149708205;
	j2402582486 [label="I gatti sono davvero meravigliosi, quando un gatto è un gatto ! È un uomo adulto, con molti anni di vita alle spalle !",shape=box,color=blue];
		j2402582486 -> j4035986230;
	j586796016 [label=" Sì, quando un gatto è un gatto ! È un uomo, un uomo adulto, con molti anni di vita alle spalle !",shape=box,color=blue];
		j586796016 -> j4035986230;
	j2724016157 [label="Le Cardinal guardò il diavolo dall'alto in basso e disse: \"Uriel, Eretico di Xata, in esilio, rispondi - gli Orokin potranno mai essere perdonati ?\"",shape=box,color=blue];
		j2724016157 -> j454711673;
	j3452518497 [label="Questa volta, se Lyon ti racconta della tempesta che ha scosso la nostra casa, ti parlerà della realtà di essa, quella che abbiamo condiviso.",shape=box,color=blue];
		j3452518497 -> j3764291717;
	j3764291717 [label="Penso che fosse meravigliosamente cliché che un male così malvagio arrivasse durante una tempesta simile.",shape=box,color=blue];
		j3764291717 -> j1879569534;
	j4035986230 [label="Molti più anni di quanti ne avrebbe dovuti avere qualsiasi essere umano, blu o trasfigurato fino a renderlo irriconoscibile come vorrebbe essere.",shape=box,color=blue];
		j4035986230 -> j186091205;
		j4035986230 -> j3600652424;
		j4035986230 -> j3114299446;
	j454711673 [label="E con un fragore di tuono, come se gli dei stessi lo stessero chiamando, le Cardinal semplicemente scomparve.",shape=box,color=blue];
		j454711673 -> j3772809316;
	j186091205 [label="Alterare geneticamente la propria forma era una moda ai tempi degli Orokin. Ma umani tanto quanto noi. O almeno lo erano, suppongo.",shape=box,color=red];
		j186091205 -> j1948161594;
	j3600652424 [label="A parte la coda, sembra davvero... più umano di molti Orokin di un tempo.",shape=box,color=red];
		j3600652424 -> j3365116000;
	j3114299446 [label="Non preoccuparti, penso che tu sia molto molto più carina di lui.",shape=box,color=red];
		j3114299446 -> j2617491924;
	j3772809316 [label="E siamo rimasti con... lui. Il diavolo.",shape=box,color=blue];
		j3772809316 -> j814747741;
	j1948161594 [label="Sì, credo di non sapere più cosa sono. Marie... ''Wisp''... e chissà quali Cose Infested che ora condividono le mie vene.",shape=box,color=blue];
		j1948161594 -> j1950859580;
	j3365116000 [label="Sì, stavo guardando un vecchio ritratto de le Cardinal, quando assomigliava più al diavolo. Mi ha parlato delle usanze degli Orokin, di come un tempo si trasformavano.",shape=box,color=blue];
		j3365116000 -> j3598796165;
	j2617491924 [label="Check boolean DrifterMarie",color=orange];
		j2617491924 -> j2478170124 [label=true,color=green];
		j2617491924 -> j4233376531 [label=false,color=brown];
	j814747741 [label="Le Cardinal ha lasciato a noi il compito di... occuparci della sua anima, forse ? O almeno di badare alle catene che lo legano. Je préférerais le renvoyer en enfer.",shape=box,color=blue];
		j814747741 -> j1415161671;
		j814747741 -> j2105311929;
	j1950859580 [label="Magari è una conversazione per un'altra volta.",shape=box,color=blue];
		j1950859580 -> j1107039087;
	j3598796165 [label="Quanto è simile e tuttavia così estraneo al modo in cui le donne dei miei tempi indossavano parrucche vistose che potevano raggiungere il cielo, o abiti che avrebbero potuto ospitare un intero orfanotrofio senza molto sforzo !",shape=box,color=blue];
		j3598796165 -> j773621932;
	j2478170124 [label="Smettila di farmi arrossire ! Monsieur Loid si chiederà cosa faccio qui seduta !",shape=box,color=blue];
		j2478170124 -> j3448981957;
	j4233376531 [label="Boolean DrifterMarie is now true.",color=orange];
		j4233376531 -> j2449726235;
	j1415161671 [label="Pensi che alla fine tutti possano essere perdonati?",shape=box,color=red];
		j1415161671 -> j875851542;
	j2105311929 [label="C'è qualcosa di lui che ti piace? Qualunque cosa.",shape=box,color=red];
		j2105311929 -> j1012281215;
	j1107039087 [label="Boolean MarieInfestation is now true.",color=orange];
		j1107039087 -> j153980571;
	j773621932 [label="Gli essere umani sono ciò che saranno sempre - infelici nella forma data loro da Sol. Ansiosi di lavorare la propria carne come fosse argilla. Io non faccio eccezione, suppongo.",shape=box,color=blue];
		j773621932 -> j1540689366;
	j3448981957 [label="D'altronde non è poi così difficile essere più belli del diavolo, non ? I suoi lineamenti sono belli, ma il blu... ce n'est pas pour moi.",shape=box,color=blue];
		j3448981957 -> j1219424408;
	j2449726235 [label="Ah ! Mi fai arrossire ! Cosa penserà Monsieur Loid se mi vede seduta qui, così ?",shape=box,color=blue];
		j2449726235 -> j3448981957;
	j875851542 [label="Oui. Sì. Credo che tutte le anime siano capaci di guadagnarsi il perdono con le proprie trasgressioni.",shape=box,color=blue];
		j875851542 -> j3361141876;
	j1012281215 [label="Niente. Niente, mai.",shape=box,color=blue];
		j1012281215 -> j3013451640;
		j1012281215 -> j2641613583;
	j153980571 [label="Il problema con lui è che ha tutto l'ego omicida di un felino, ma non ha nulla dell'affascinante natura di un piccolo e adorabile compagno.",shape=box,color=blue];
		j153980571 -> j168119765;
	j1540689366 [label="Ero fin troppo felice di prendere il siero che mi rendesse in parte Marie, in parte... \"Wisp\" e in parte... qualunque Cosa Infestata che ora condivide le mie vene.",shape=box,color=blue];
		j1540689366 -> j1950859580;
	j1219424408 [label="Accetto il tuo complimento, se era sincero. Sono rimasta semplicemente sorpresa. Possiamo... tornare all'argomento in questione ?",shape=box,color=blue];
		j1219424408 -> j1107039087;
	j3361141876 [label="La domanda rimane... sente davvero di aver bisogno di una cosa del genere ?",shape=box,color=blue];
		j3361141876 -> j1836881399;
	j3013451640 [label="Beh, apprezzo la tua storia. Quindi Entrati vuole che lui venga... perdonato? Per cosa? Tau? O semplicemente per essere Orokin?",shape=box,color=red];
		j3013451640 -> j2816732975;
	j2641613583 [label="Va bene, ti credo. Non credo che mi mentiresti.",shape=box,color=red];
		j2641613583 -> j2366018394;
	j168119765 [label="Ha un'opinione troppo alta di sé. Accetta la vita senza esitazione. Gioca con i suoi nemici come se fossero topi che ha messo alle strette.",shape=box,color=blue];
		j168119765 -> j814747741;
	j1836881399 [label="Non si può perdonare chi non ritiene di averne bisogno. Sarebbe più facile insegnare a volare a un pesce.",shape=box,color=blue];
		j1836881399 -> j724155230;
	j2816732975 [label="Non lo so. E l'altra domanda rimane: tanto per cominciare, sente davvero di aver bisogno di qualcosa come il perdono ?",shape=box,color=blue];
		j2816732975 -> j1836881399;
	j2366018394 [label="Fie ! Benissimo. C'è una cosa che abbiamo in comune... una tentazione malvagia per i dolci. Il diavolo era solito tornare alla Cathédrale dopo aver rubato i dolci dai negozi senza pagarli.",shape=box,color=blue];
		j2366018394 -> j305860629;
	j724155230 [label="Ma parlagli personalmente di questo argomento, se vuoi comprendere la sfida insormontabile che ti trovi ad affrontare se vuoi vincere quella particolare guerra.",shape=box,color=blue];
		j724155230 -> j2097034936;
	j305860629 [label="Gli ho spiegato che si trattava di furto e lui si è lanciato in una lunga lezione su come gli Orokin avrebbero presto governato il sistema solare, quindi non si trattava di furto nel grande schema delle cose...",shape=box,color=blue];
		j305860629 -> j3962721008;
	j2097034936 [label="Ti auguro solo buona fortuna.",shape=box,color=blue];
		j2097034936 -> j1933300832;
	j3962721008 [label="Io gli avrei urlato contro, Lyon sarebbe stato costretto a intervenire...",shape=box,color=blue];
		j3962721008 -> j4011670670;
		j3962721008 -> j1082004480;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j4011670670 [label="E i dolci...?",shape=box,color=red];
		j4011670670 -> j1388729972;
	j1082004480 [label="Ti sei mai chiesta se lui lo facesse perché così potevate goderveli tutti insieme?",shape=box,color=red];
		j1082004480 -> j4111527528;
	j1388729972 [label="Non potevamo certo sprecarli, no? Era un peccato mangiarli, ma era un peccato ancora più grave lasciarli marcire. Quindi ce li siamo goduti.",shape=box,color=blue];
		j1388729972 -> j2057934373;
	j4111527528 [label="Se è vero, ha fatto una pessima figura. Ma... potresti avere ragione. In ogni caso, non potevamo sprecarli. Era un peccato mangiarli, ma un peccato ancora peggiore lasciarli marcire. Quindi, ce li siamo goduti.",shape=box,color=blue];
		j4111527528 -> j2057934373;
	j2057934373 [label="+10 Chemistry",color=orange];
		j2057934373 -> j1211318514;
	j1211318514 [label="Hm. Forse era un po' una sua abitudine, ora che ci penso, di riportare a casa più di quanto potesse consumare da solo...",shape=box,color=blue];
		j1211318514 -> j2337051984;
