digraph {
	599 [label="MarieRank2Convo4 begins.",color=orange];
		599 -> 602;
		599 -> 601;
		599 -> 600;
	602 [label="Posso chiederti di Roathe? O ti darebbe fastidio?",shape=box,color=red];
		602 -> 605;
	601 [label="Posso chiederti dell'elefante nella stanza?",shape=box,color=red];
		601 -> 604;
	600 [label="[Fine.]",shape=box,color=red];
		600 -> 603;
	605 [label="Ce diable est un imbécile qui se croit au-dessus de tout reproche ! Je préfèrerais boire un pot de vernis à bois plutôt que de passer une minute de plus à l'écouter s'enorgueillir comme un chat qui se lèche le pelage !",shape=box,color=blue];
		605 -> 607;
		605 -> 608;
	604 [label="Quoi! Où ça? Un éléphant ?!",shape=box,color=blue];
		604 -> 606;
	603 [label="Chat ends.",color=orange];
	607 [label="È stato meravigliosamente creativo.",shape=box,color=red];
		607 -> 610;
	608 [label="Io... suppongo che niente di tutto ciò sia stato gentile.",shape=box,color=red];
		608 -> 611;
	606 [label="Vedo solo un pesce, un uccello e... qualunque cosa sia M'sieur Tagfer. Vedo molte cose strane in questo Santuario, ma nessun éléphant - è una battuta ?",shape=box,color=blue];
		606 -> 609;
	610 [label="+5 Chemistry",color=orange];
		610 -> 614;
	611 [label="+5 Chemistry",color=orange];
		611 -> 615;
	609 [label="Oh! Scusa. È un modo di dire che mi hanno insegnato i miei amici del 1999... ",shape=box,color=red];
		609 -> 612;
		609 -> 613;
	614 [label="Merci. È stato creativo, ma mi hai fatto una domanda e la mia ira non avrebbe dovuto essere rivolta a te, perdonami.",shape=box,color=blue];
		614 -> 618;
	615 [label="Non lo era. Perdonami, non avrei dovuto fartelo notare. ",shape=box,color=blue];
		615 -> 618;
	612 [label="Non intendevo letteralmente.",shape=box,color=red];
		612 -> 616;
	613 [label="Ora capisco perché pensano che sia sempre così carino quando sono confuso...",shape=box,color=red];
		613 -> 617;
	618 [label="Evaluate expressions",color=orange];
		618 -> 624 [label="MarieRoatheWarning",color=purple];
