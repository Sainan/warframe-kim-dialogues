		636 -> 645;
	637 [label="Add 1 to Thermostat",color=orange];
		637 -> 646;
	635 [label="Non riesco a immaginare che la maggior parte delle persone, che non si circondano di teste volanti e animali parlanti, non possa avere come argomento di conversazione un elefante.",shape=box,color=blue];
		635 -> 644;
	651 [label="+5 Chemistry",color=orange];
		651 -> 660;
	652 [label="E tu pensi che io non capirei ? Non sono una stupida - non sono isterica, anche se sono stata trasportata e trasfigurata.",shape=box,color=blue];
		652 -> 661;
		652 -> 662;
	649 [label="Capire fino a che punto, è la mia preoccupazione. Ma non hai bisogno che ti faccia la pratica, non sono tua madre, né desidero rovinare questa amicizia fin dai suoi primi giorni...",shape=box,color=blue];
		649 -> 658;
	650 [label="+5 Chemistry",color=orange];
		650 -> 659;
	647 [label="+5 Chemistry",color=orange];
		647 -> 656;
	648 [label="Consiglio semplicemente cautela. Credo che potrebbe convincere Lua a dargli le stelle del cielo.",shape=box,color=blue];
		648 -> 657;
	645 [label="Capire fino a che punto, è la mia preoccupazione. Ma non c'è bisogno che ti faccia la predica.",shape=box,color=blue];
		645 -> 654;
	646 [label="+5 Chemistry",color=orange];
		646 -> 655;
	644 [label="... credo di aver risposto alla mia stessa domanda, non è vero ?",shape=box,color=blue];
		644 -> 653;
	660 [label="Apprezzo le scuse e le accetto, ma considera che sono stata trasportata e trasfigurata e mi ritrovo circondata dall'impossible. ",shape=box,color=blue];
		660 -> 666;
	661 [label="Non importa. Andrò a parlare con il diavolo in persona.",shape=box,color=red];
		661 -> 667;
	662 [label="Mi dispiace. Non volevo discutere con te, non era questo che intendevo. ",shape=box,color=red];
		662 -> 668;
		662 -> 669;
	658 [label="Mi preoccupo solo per te. È una bestia abile e manipolatrice... ",shape=box,color=blue];
		658 -> 664;
	659 [label="E ti dichiarerei Santo di Sol anche solo per aver tentato una cosa del genere.",shape=box,color=blue];
		659 -> 664;
	656 [label="Oui, la maledizione del soldato... Bruciare la città per salvare il paese. Uccidere l'uomo per salvare la famiglia. Ma dove finisce l'orrore ?",shape=box,color=blue];
		656 -> 665;
	657 [label="Ricordati chi e cosa è, in fin dei conti... non un dio, e nemmeno una bestia, ma un uomo. Un uomo che ha un'opinione troppo alta di sé.",shape=box,color=blue];
		657 -> 664;
	654 [label="Potrebbe incantare Lua per farsi dare le stelle dal cielo. Fai attenzione, è tutto quello che dirò.",shape=box,color=blue];
		654 -> 664;
	655 [label="Allora sei saggio a non ascoltare le sue parole dolci. Potrebbe convincere Lua a dargli le stelle del cielo.",shape=box,color=blue];
		655 -> 664;
	653 [label="Sì. Significa ''possiamo parlare dell'argomento che stiamo tutti evitando, come se non stessimo parlando dell'elefante gigante nella stanza.''",shape=box,color=red];
		653 -> 663;
	666 [label="Se credi che io non riesca a comprendere o non riesca a provare compassione per le storie degli altri, ti prego di riconsiderare la tua opinione, oui ?",shape=box,color=blue];
		666 -> 673;
	667 [label="Qu'il en soit ainsi.",shape=box,color=blue];
		667 -> 674;
	668 [label="È un soldato. Ha dovuto fare cose terribili in nome di uno ''scopo superiore''. So cosa si prova. A volte, quel tipo di vita ti trasforma in... beh. Lui.",shape=box,color=red];
		668 -> 675;
	669 [label="Ha vissuto per centinaia, se non migliaia di anni. Chissà cosa significa davvero per una persona? Quanto dolore, quanta sofferenza? So cosa si prova.",shape=box,color=red];
		669 -> 676;
	664 [label="Ma avresti voluto chiedermi del diavolo in persona, non è vero ? Cosa vorresti sapere ?",shape=box,color=blue];
		664 -> 670;
		664 -> 671;
		664 -> 672;
	665 [label="Dobbiamo vedere la guerra attraverso gli occhi dello statistico, perché se la vedessimo attraverso gli occhi dei caduti, non smetteremmo mai di piangere.",shape=box,color=blue];
		665 -> 664;
	663 [label="E se mi è concesso di fare una seconda ipotesi sulla natura di questo éléphant... ha per caso la pelle blu ?",shape=box,color=blue];
		663 -> 618;
	673 [label="E io, da parte mia, ci penserò due volte prima di dirti quello che devi fare.",shape=box,color=blue];
		673 -> 661;
		673 -> 680;
	674 [label="Chat ends.",color=orange];
	675 [label="+5 Chemistry",color=orange];
		675 -> 681;
	676 [label="+5 Chemistry",color=orange];
		676 -> 682;
	670 [label="Perché lo detesti così tanto?",shape=box,color=red];
		670 -> 677;
	671 [label="Perché Entrati lo ha lasciato con te e Lyon?",shape=box,color=red];
		671 -> 678;
	672 [label="Ero curioso di sapere come vi siete conosciuti?",shape=box,color=red];
		672 -> 679;
	680 [label="Sono d'accordo.",shape=box,color=red];
		680 -> 687;
	681 [label="Ah, e ora mi sento davvero sciocca. Sì, certo, tu sai cosa significa uccidere in nome di uno ''scopo'', come hai detto... È ovvio che cercheresti di capire qualcuno che ha fatto lo stesso.",shape=box,color=blue];
		681 -> 688;
	682 [label="Ah, e ora mi sento davvero una sciocca. Sì, certo, tu sai cosa significa vivere ancora e ancora... È ovvio che cercheresti di conoscere qualcuno che ha datto lo stesso.",shape=box,color=blue];
		682 -> 688;
	677 [label="Non è ovvio ? Il suo comportamento è come quello di un grosso felino che insiste nel marcare il territorio e nel buttare giù gli oggetti dagli scaffali.",shape=box,color=blue];
		677 -> 683;
		677 -> 684;
	678 [label="Quando il Cardinale Dimanche - Entrati - se ne andò per l'ultima volta, lasciò il diavolo sulla soglia di casa nostra. Affranto, sanguinante e a malapena in grado di ricordare il suo nome.",shape=box,color=blue];
		678 -> 685;
	679 [label="C'era un temporale la notte in cui il diavolo arrivò. Un terribile tuono fece tremare le mura delle Cathédrale.",shape=box,color=blue];
		679 -> 686;
	687 [label="Update boolean MarieRoatheWarning",color=orange];
		687 -> 694;
	688 [label="Raggiungiamo un accordo. Se credi che io non riesca a comprendere o non riesca a provare compassione per le storie degli altri, ti prego di riconsiderare la tua opinione, oui ?",shape=box,color=blue];
		688 -> 673;
	683 [label="Personalmente, mi piacciono molto i gatti. ",shape=box,color=red];
		683 -> 689;
	684 [label="Non ti piacciono i gatti?",shape=box,color=red];
		684 -> 690;
	685 [label="Ora so che gli era appena stato somministrato il sérum, e che la trasformazione, seppur involontaria, è... dolorosa.",shape=box,color=blue];
		685 -> 691;
	686 [label="Check boolean MarieLyonVisions",color=orange];
		686 -> 693 [label=true,color=green];
		686 -> 692 [label=false,color=brown];
	694 [label="Magnifique ! Ora, avresti voluto chiedermi del diavolo in persona, non è vero ? Cosa vorresti sapere ?",shape=box,color=blue];
		694 -> 670;
		694 -> 671;
		694 -> 672;
	689 [label="I gatti sono davvero meravigliosi, quando un gatto è un gatto ! È un uomo adulto, con molti anni di vita alle spalle !",shape=box,color=blue];
		689 -> 695;
	690 [label=" Sì, quando un gatto è un gatto ! È un uomo, un uomo adulto, con molti anni di vita alle spalle !",shape=box,color=blue];
		690 -> 695;
	691 [label="Le Cardinal guardò il diavolo dall'alto in basso e disse: \"Uriel, Eretico di Xata, in esilio, rispondi - gli Orokin potranno mai essere perdonati ?\"",shape=box,color=blue];
		691 -> 696;
	693 [label="Questa volta, se Lyon ti racconta della tempesta che ha scosso la nostra casa, ti parlerà della realtà di essa, quella che abbiamo condiviso.",shape=box,color=blue];
		693 -> 692;
	692 [label="Penso che fosse meravigliosamente cliché che un male così malvagio arrivasse durante una tempesta simile.",shape=box,color=blue];
		692 -> 678;
	695 [label="Molti più anni di quanti ne avrebbe dovuti avere qualsiasi essere umano, blu o trasfigurato fino a renderlo irriconoscibile come vorrebbe essere.",shape=box,color=blue];
		695 -> 697;
		695 -> 698;
		695 -> 3906;
	696 [label="E con un fragore di tuono, come se gli dei stessi lo stessero chiamando, le Cardinal semplicemente scomparve.",shape=box,color=blue];
		696 -> 699;
	697 [label="Alterare geneticamente la propria forma era una moda ai tempi degli Orokin. Ma umani tanto quanto noi. O almeno lo erano, suppongo.",shape=box,color=red];
		697 -> 700;
	698 [label="A parte la coda, sembra davvero... più umano di molti Orokin di un tempo.",shape=box,color=red];
		698 -> 701;
	3906 [label="Non preoccuparti, penso che tu sia molto molto più carina di lui.",shape=box,color=red];
		3906 -> 3907;
	699 [label="E siamo rimasti con... lui. Il diavolo.",shape=box,color=blue];
		699 -> 702;
	700 [label="Sì, credo di non sapere più cosa sono. Marie... ''Wisp''... e chissà quali Cose Infested che ora condividono le mie vene.",shape=box,color=blue];
		700 -> 703;
	701 [label="Sì, stavo guardando un vecchio ritratto de le Cardinal, quando assomigliava più al diavolo. Mi ha parlato delle usanze degli Orokin, di come un tempo si trasformavano.",shape=box,color=blue];
		701 -> 704;
	3907 [label="Check boolean DrifterMarie",color=orange];
		3907 -> 3908 [label=true,color=green];
		3907 -> 3909 [label=false,color=brown];
	702 [label="Le Cardinal ha lasciato a noi il compito di... occuparci della sua anima, forse ? O almeno di badare alle catene che lo legano. Je préférerais le renvoyer en enfer.",shape=box,color=blue];
		702 -> 705;
		702 -> 706;
	703 [label="Magari è una conversazione per un'altra volta.",shape=box,color=blue];
		703 -> 707;
	704 [label="Quanto è simile e tuttavia così estraneo al modo in cui le donne dei miei tempi indossavano parrucche vistose che potevano raggiungere il cielo, o abiti che avrebbero potuto ospitare un intero orfanotrofio senza molto sforzo !",shape=box,color=blue];
		704 -> 708;
	3908 [label="Smettila di farmi arrossire ! Monsieur Loid si chiederà cosa faccio qui seduta !",shape=box,color=blue];
		3908 -> 3911;
	3909 [label="Update boolean DrifterMarie",color=orange];
		3909 -> 3910;
	705 [label="Pensi che alla fine tutti possano essere perdonati?",shape=box,color=red];
		705 -> 709;
	706 [label="C'è qualcosa di lui che ti piace? Qualunque cosa.",shape=box,color=red];
		706 -> 710;
	707 [label="Update boolean MarieInfestation",color=orange];
		707 -> 711;
	708 [label="Gli essere umani sono ciò che saranno sempre - infelici nella forma data loro da Sol. Ansiosi di lavorare la propria carne come fosse argilla. Io non faccio eccezione, suppongo.",shape=box,color=blue];
		708 -> 712;
	3911 [label="D'altronde non è poi così difficile essere più belli del diavolo, non ? I suoi lineamenti sono belli, ma il blu... ce n'est pas pour moi.",shape=box,color=blue];
		3911 -> 3912;
	3910 [label="Ah ! Mi fai arrossire ! Cosa penserà Monsieur Loid se mi vede seduta qui, così ?",shape=box,color=blue];
		3910 -> 3911;
	709 [label="Oui. Sì. Credo che tutte le anime siano capaci di guadagnarsi il perdono con le proprie trasgressioni.",shape=box,color=blue];
		709 -> 713;
	710 [label="Niente. Niente, mai.",shape=box,color=blue];
		710 -> 714;
		710 -> 715;
	711 [label="Il problema con lui è che ha tutto l'ego omicida di un felino, ma non ha nulla dell'affascinante natura di un piccolo e adorabile compagno.",shape=box,color=blue];
		711 -> 716;
	712 [label="Ero fin troppo felice di prendere il siero che mi rendesse in parte Marie, in parte... \"Wisp\" e in parte... qualunque Cosa Infestata che ora condivide le mie vene.",shape=box,color=blue];
		712 -> 703;
	3912 [label="Accetto il tuo complimento, se era sincero. Sono rimasta semplicemente sorpresa. Possiamo... tornare all'argomento in questione ?",shape=box,color=blue];
		3912 -> 707;
	713 [label="La domanda rimane... sente davvero di aver bisogno di una cosa del genere ?",shape=box,color=blue];
		713 -> 717;
	714 [label="Beh, apprezzo la tua storia. Quindi Entrati vuole che lui venga... perdonato? Per cosa? Tau? O semplicemente per essere Orokin?",shape=box,color=red];
		714 -> 718;
	715 [label="Va bene, ti credo. Non credo che mi mentiresti.",shape=box,color=red];
		715 -> 719;
	716 [label="Ha un'opinione troppo alta di sé. Accetta la vita senza esitazione. Gioca con i suoi nemici come se fossero topi che ha messo alle strette.",shape=box,color=blue];
		716 -> 702;
	717 [label="Non si può perdonare chi non ritiene di averne bisogno. Sarebbe più facile insegnare a volare a un pesce.",shape=box,color=blue];
		717 -> 720;
	718 [label="Non lo so. E l'altra domanda rimane: tanto per cominciare, sente davvero di aver bisogno di qualcosa come il perdono ?",shape=box,color=blue];
		718 -> 717;
	719 [label="Fie ! Benissimo. C'è una cosa che abbiamo in comune... una tentazione malvagia per i dolci. Il diavolo era solito tornare alla Cathédrale dopo aver rubato i dolci dai negozi senza pagarli.",shape=box,color=blue];
		719 -> 721;
	720 [label="Ma parlagli personalmente di questo argomento, se vuoi comprendere la sfida insormontabile che ti trovi ad affrontare se vuoi vincere quella particolare guerra.",shape=box,color=blue];
		720 -> 722;
	721 [label="Gli ho spiegato che si trattava di furto e lui si è lanciato in una lunga lezione su come gli Orokin avrebbero presto governato il sistema solare, quindi non si trattava di furto nel grande schema delle cose...",shape=box,color=blue];
		721 -> 723;
	722 [label="Ti auguro solo buona fortuna.",shape=box,color=blue];
		722 -> 724;
	723 [label="Io gli avrei urlato contro, Lyon sarebbe stato costretto a intervenire...",shape=box,color=blue];
		723 -> 725;
		723 -> 726;
	724 [label="+10 Chemistry",color=orange];
		724 -> 727;
	725 [label="E i dolci...?",shape=box,color=red];
		725 -> 728;
	726 [label="Ti sei mai chiesta se lui lo facesse perché così potevate goderveli tutti insieme?",shape=box,color=red];
		726 -> 729;
	727 [label="Chat ends.",color=orange];
	728 [label="Non potevamo certo sprecarli, no? Era un peccato mangiarli, ma era un peccato ancora più grave lasciarli marcire. Quindi ce li siamo goduti.",shape=box,color=blue];
		728 -> 730;
	729 [label="Se è vero, ha fatto una pessima figura. Ma... potresti avere ragione. In ogni caso, non potevamo sprecarli. Era un peccato mangiarli, ma un peccato ancora peggiore lasciarli marcire. Quindi, ce li siamo goduti.",shape=box,color=blue];
		729 -> 730;
	730 [label="+10 Chemistry",color=orange];
		730 -> 731;
	731 [label="Hm. Forse era un po' una sua abitudine, ora che ci penso, di riportare a casa più di quanto potesse consumare da solo...",shape=box,color=blue];
		731 -> 732;
	732 [label="Update boolean MarieRoathePastry1",color=orange];
		732 -> 733;
	733 [label="Ci penserò. A domani. À la revoyure.",shape=box,color=blue];
		733 -> 734;
