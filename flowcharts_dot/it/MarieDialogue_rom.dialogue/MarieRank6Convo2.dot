		3530 -> 3534 [label="false",color=purple];
	3531 [label="Oh, Luminari - che razza di inferno avete creato per lui, per tenere la sua anima intrappolata in quella gabbia di scienza e luci tremolanti?",shape=box,color=blue];
		3531 -> 3535;
	3532 [label="Posso solo pregare i Luminari che tu abbia ragione e che dentro quel guscio non rimanga altro che... scienza e luci tremolanti.",shape=box,color=blue];
		3532 -> 3536;
	3533 [label="So che non sei sicuro che i Cephalon abbiano un'anima - ma posso solo pregare i Luminari affinché... quel povero Otak non soffra.",shape=box,color=blue];
		3533 -> 3537;
	3534 [label="Posso solo pregare i Luminari che tutto ciò che rimane dentro quel guscio non sia altro che... scienza e luci tremolanti.",shape=box,color=blue];
		3534 -> 3538;
	3535 [label="Perché lasciarlo lì, distrutto, ad aspettare che gli venga concesso di morire per ricevere pace? Posso solo pregare... che nel caso ci sia una qualche presenza lì -",shape=box,color=blue];
		3535 -> 3539;
	3536 [label="E che nessuna anima sia intrappolata in quella distruzione, in attesa che le venga finalmente concessa la morte per poter trovare pace.",shape=box,color=blue];
		3536 -> 3540;
	3537 [label="Che nessuna anima sia intrappolata in quella cosa distrutta, in attesa che le venga finalmente concessa la morte per ottenere la pace.",shape=box,color=blue];
		3537 -> 3541;
	3538 [label="E che nessuna anima sia intrappolata in quella distruzione, in attesa che le venga finalmente concessa la morte per poter trovare pace.",shape=box,color=blue];
		3538 -> 3541;
	3539 [label="Che lui rimanga per scelta come una specie di veglia solitaria...",shape=box,color=blue];
