		3486 -> 3490;
		3486 -> 3491;
	3487 [label="Ti è piaciuto parlare con lui?",shape=box,color=red];
		3487 -> 3492;
	3488 [label="Come è andata la conversazione con lui?",shape=box,color=red];
		3488 -> 3493;
	3489 [label="Povero Otak... Come è andata?",shape=box,color=red];
		3489 -> 3494;
	3490 [label="Sono felice che finalmente vi siate incontrati. Otak può essere un po' difficile da spiegare.",shape=box,color=red];
		3490 -> 3495;
	3491 [label="Hai incontrato Otak? Oddio... Com'è andata?",shape=box,color=red];
		3491 -> 3496;
	3492 [label="Oui. Anche se forse avrei voluto piangere. Si è presentato a me tre volte nella stessa conversazione, come se non ci fossimo mai presentati.",shape=box,color=blue];
		3492 -> 3497;
	3493 [label="Lui... si è presentato a me tre volte nella stessa conversazione, come se non ci fossimo mai presentati.",shape=box,color=blue];
		3493 -> 3497;
	3494 [label="L'ho trovato semplicemente dolce e affascinante ! Ma sotto uno strato di umorismo, ho provato un profondo dolore.",shape=box,color=blue];
		3494 -> 3498;
	3495 [label="Sì, credo proprio di sì. Uno scarabocchio infantile sul dorso di un automa. L'ho trovato semplicemente dolce e affascinante !",shape=box,color=blue];
		3495 -> 3499;
	3496 [label="Perché non sembri molto contento che l'abbia incontrato ?",shape=box,color=blue];
		3496 -> 3500;
		3496 -> 3501;
		3496 -> 3502;
	3497 [label="Mi ha accolta con lo stesso atteggiamento risoluto e allegro delle volte precedenti. Ma lui mi conosceva come una Sœur de Sol ! ",shape=box,color=blue];
		3497 -> 3503;
	3498 [label="Mi racconteresti la storia del povero Monsieur Otak ?",shape=box,color=blue];
		3498 -> 3504;
	3499 [label="Ma sotto il suo umorismo si nasconde un grande dolore.",shape=box,color=blue];
		3499 -> 3498;
	3500 [label="A volte riesce a darmi sui nervi, tutto qui. ",shape=box,color=red];
		3500 -> 3505;
	3501 [label="Non volevo. Può essere un po'... sgradevole per alcune persone.",shape=box,color=red];
		3501 -> 3506;
	3502 [label="Mi dispiace. A volte può dare sui nervi alla gente. Non è colpa sua.",shape=box,color=red];
		3502 -> 3506;
	3503 [label="In effetti, conosceva molto bene i Luminari ! Abbiamo parlato a lungo delle \"Antiche Religioni\", come le ha chiamate lui, \"dei giorni precedenti all'Impero Orokin\".",shape=box,color=blue];
		3503 -> 3507;
	3504 [label="Otak era un Archimedeo, uno scienziato e accademico Orokin. Quello che gli è successo non è esattamente una storia felice.",shape=box,color=red];
		3504 -> 3508;
	3505 [label="Spero che cercherai di essere più gentile con qualcuno che è chiaramente infirme. Mais par la grâce de Sol, che ci illumini tutti.",shape=box,color=blue];
		3505 -> 3509;
	3506 [label="E spero che gli dimostrino gentilezza e pazienza. Mais par la grâce de Sol, che ci illumini tutti.",shape=box,color=blue];
		3506 -> 3509;
	3507 [label="Sebbene affermasse che gran parte di quella conoscenza fosse ormai perduta, nascosta negli archivi e severamente proibita. Mi fece giurare di mantenere il segreto.",shape=box,color=blue];
		3507 -> 3510;
	3508 [label="A detta di tutti era un genio e la mente dietro lo sfruttamento dei cristalli di argon.",shape=box,color=red];
		3508 -> 3511;
	3509 [label="Un destino simile potrebbe attendere chiunque di noi. Anche te.",shape=box,color=blue];
		3509 -> 3512;
		3509 -> 3513;
	3510 [label="Mi ha detto che è profondamente preoccupato che l'Esecutore Ballas - chiunque egli sia - possa scoprire la mia setta di eretici e farmi giustiziare.",shape=box,color=blue];
		3510 -> 3514;
		3510 -> 3515;
	3511 [label="Che vengono sfruttati dal Void - sono il motivo per cui possiamo creare molti dei potenti warframe e armi che realizziamo.",shape=box,color=red];
		3511 -> 3516;
	3512 [label="Hai ragione, mi dispiace. Non intendevo questo.",shape=box,color=red];
		3512 -> 3498;
	3513 [label="Mi dispiace, non ho tempo da dedicargli.",shape=box,color=red];
		3513 -> 3517;
	3514 [label="Ballas è morto... continua.",shape=box,color=red];
		3514 -> 3518;
	3515 [label="Questo... non accadrà. Continua a parlare.",shape=box,color=red];
		3515 -> 3518;
	3516 [label="Si specializzò in cristallografia. E i suoi lavori furono archiviati qui, nei laboratori.",shape=box,color=red];
		3516 -> 3519;
	3517 [label="Allora mi dispiace di averne sprecato ancora.",shape=box,color=blue];
		3517 -> 3520;
	3518 [label="+5 Chemistry",color=orange];
		3518 -> 3521;
	3519 [label="Per qualche ragione, non so perché, fu trasformato in un Cephalon e gli fu dato il suo guscio necraloid.",shape=box,color=red];
		3519 -> 3522;
	3520 [label="Update boolean MarieOtakComplete",color=orange];
		3520 -> 3523;
	3521 [label="Lo sospettavo... Beh, mi ha chiesto da dove venissi e quando gliel'ho detto, ha riso e ha detto \"no, è impossibile! E dovrei saperlo, io sono-\"",shape=box,color=blue];
		3521 -> 3524;
	3522 [label="Non tutti i Cephalon furono creati per punizione. Ma le cose andarono... male qui su Deimos, e subì gravi danni.",shape=box,color=red];
		3522 -> 3525;
	3523 [label="Chat ends.",color=orange];
	3524 [label="E poi... si è presentato di nuovo. E mi ha chiesto se venivo dalle piane con dei campioni di minerale...",shape=box,color=blue];
		3524 -> 3526;
		3524 -> 3527;
	3525 [label="Pauvre petit...",shape=box,color=blue];
		3525 -> 3528;
	3526 [label="Sì... così è Otak.",shape=box,color=red];
