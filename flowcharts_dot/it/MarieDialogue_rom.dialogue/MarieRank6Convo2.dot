	3556 [label="Merci. Beh, non ho più voglia di esserlo. Vado a fare qualcosa di più allegro ! Credo che il carro armato di M'sieur Fibonacci abbia bisogno di una bella pulitina.",shape=box,color=blue];
		3556 -> 3559;
	3557 [label="Ah ! Merci. Questo fermerà sicuramente queste mie insensate lacrime. Sai come rallegrare la piccola sciocca Marie, non ?",shape=box,color=blue];
		3557 -> 3560;
		3557 -> 3561;
	3558 [label="Oui. Hai perfettamente ragione. Lo sono. Il mondo è pieno di storie come quella di Monsieur Otak, e molte ben peggiori della sua. Non piangerei per nessuna di esse. ",shape=box,color=blue];
