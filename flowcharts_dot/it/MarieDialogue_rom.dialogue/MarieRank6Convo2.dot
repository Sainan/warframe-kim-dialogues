	3540 [label="Perché se ti sbagliassi e un'anima rimane in quella gabbia contro la sua volontà ?",shape=box,color=blue];
		3540 -> 3543;
	3541 [label="Oppure, nel caso ci sia una qualche presenza lì, è perché lui rimane per scelta, come una sorta di veglia solitaria.",shape=box,color=blue];
		3541 -> 3544;
	3542 [label="Pensare il contrario è sufficiente per farti dubitare della bontà degli dei, non ?",shape=box,color=blue];
