	j3914921838 [label="Lupo ! Mio lupo ! Ho incontrato Otak ! Finalmente l'ho incontrato !",shape=box,color=blue];
		j3914921838 -> j1700159402;
		j3914921838 -> j184008109;
	j3127731756 [label="Ho incontrato Otak ! Finalmente l'ho incontrato !",shape=box,color=blue];
		j3127731756 -> j1700159402;
		j3127731756 -> j184008109;
	j2708821763 [label="Lupo ! Mio lupo ! Il volto sulla schiena di Monsieur Necraloid ! Finalmente l'ho incontrato !",shape=box,color=blue];
		j2708821763 -> j1769359893;
		j2708821763 -> j1375195582;
		j2708821763 -> j1846079608;
	j2136411039 [label="Il volto sulla schiena di Monsieur Necraloid ! Finalmente l'ho incontrato !",shape=box,color=blue];
		j2136411039 -> j1769359893;
		j2136411039 -> j1375195582;
		j2136411039 -> j1846079608;
	j1700159402 [label="Ti è piaciuto parlare con lui?",shape=box,color=red];
		j1700159402 -> j880652080;
	j184008109 [label="Come è andata la conversazione con lui?",shape=box,color=red];
		j184008109 -> j572591914;
	j1769359893 [label="Povero Otak... Come è andata?",shape=box,color=red];
		j1769359893 -> j1738708176;
	j1375195582 [label="Sono felice che finalmente vi siate incontrati. Otak può essere un po' difficile da spiegare.",shape=box,color=red];
		j1375195582 -> j2987132251;
	j1846079608 [label="Hai incontrato Otak? Oddio... Com'è andata?",shape=box,color=red];
		j1846079608 -> j1220127480;
	j880652080 [label="Oui. Anche se forse avrei voluto piangere. Si è presentato a me tre volte nella stessa conversazione, come se non ci fossimo mai presentati.",shape=box,color=blue];
		j880652080 -> j4031644470;
	j572591914 [label="Lui... si è presentato a me tre volte nella stessa conversazione, come se non ci fossimo mai presentati.",shape=box,color=blue];
		j572591914 -> j4031644470;
	j1738708176 [label="L'ho trovato semplicemente dolce e affascinante ! Ma sotto uno strato di umorismo, ho provato un profondo dolore.",shape=box,color=blue];
		j1738708176 -> j1520750118;
	j2987132251 [label="Sì, credo proprio di sì. Uno scarabocchio infantile sul dorso di un automa. L'ho trovato semplicemente dolce e affascinante !",shape=box,color=blue];
		j2987132251 -> j3282207095;
	j1220127480 [label="Perché non sembri molto contento che l'abbia incontrato ?",shape=box,color=blue];
		j1220127480 -> j661484340;
		j1220127480 -> j1271830006;
		j1220127480 -> j4205622434;
	j4031644470 [label="Mi ha accolta con lo stesso atteggiamento risoluto e allegro delle volte precedenti. Ma lui mi conosceva come una Sœur de Sol ! ",shape=box,color=blue];
		j4031644470 -> j2988987224;
	j1520750118 [label="Mi racconteresti la storia del povero Monsieur Otak ?",shape=box,color=blue];
		j1520750118 -> j4206848200;
	j3282207095 [label="Ma sotto il suo umorismo si nasconde un grande dolore.",shape=box,color=blue];
		j3282207095 -> j1520750118;
	j661484340 [label="A volte riesce a darmi sui nervi, tutto qui. ",shape=box,color=red];
		j661484340 -> j3664077317;
	j1271830006 [label="Non volevo. Può essere un po'... sgradevole per alcune persone.",shape=box,color=red];
		j1271830006 -> j2407992292;
	j4205622434 [label="Mi dispiace. A volte può dare sui nervi alla gente. Non è colpa sua.",shape=box,color=red];
		j4205622434 -> j2407992292;
	j2988987224 [label="In effetti, conosceva molto bene i Luminari ! Abbiamo parlato a lungo delle \"Antiche Religioni\", come le ha chiamate lui, \"dei giorni precedenti all'Impero Orokin\".",shape=box,color=blue];
		j2988987224 -> j253892203;
	j4206848200 [label="Otak era un Archimedeo, uno scienziato e accademico Orokin. Quello che gli è successo non è esattamente una storia felice.",shape=box,color=red];
		j4206848200 -> j149482831;
	j3664077317 [label="Spero che cercherai di essere più gentile con qualcuno che è chiaramente infirme. Mais par la grâce de Sol, che ci illumini tutti.",shape=box,color=blue];
		j3664077317 -> j216943917;
	j2407992292 [label="E spero che gli dimostrino gentilezza e pazienza. Mais par la grâce de Sol, che ci illumini tutti.",shape=box,color=blue];
		j2407992292 -> j216943917;
	j253892203 [label="Sebbene affermasse che gran parte di quella conoscenza fosse ormai perduta, nascosta negli archivi e severamente proibita. Mi fece giurare di mantenere il segreto.",shape=box,color=blue];
		j253892203 -> j2988113003;
	j149482831 [label="A detta di tutti era un genio e la mente dietro lo sfruttamento dei cristalli di argon.",shape=box,color=red];
		j149482831 -> j495996227;
	j216943917 [label="Un destino simile potrebbe attendere chiunque di noi. Anche te.",shape=box,color=blue];
		j216943917 -> j1344769128;
		j216943917 -> j458388634;
	j2988113003 [label="Mi ha detto che è profondamente preoccupato che l'Esecutore Ballas - chiunque egli sia - possa scoprire la mia setta di eretici e farmi giustiziare.",shape=box,color=blue];
		j2988113003 -> j3351993898;
		j2988113003 -> j668318827;
	j495996227 [label="Che vengono sfruttati dal Void - sono il motivo per cui possiamo creare molti dei potenti Warframe e armi che abbiamo.",shape=box,color=red];
		j495996227 -> j1968411449;
	j1344769128 [label="Hai ragione, mi dispiace. Non intendevo questo.",shape=box,color=red];
		j1344769128 -> j1520750118;
	j458388634 [label="Mi dispiace, non ho tempo da dedicargli.",shape=box,color=red];
		j458388634 -> j3424960910;
	j3351993898 [label="Ballas è morto... continua.",shape=box,color=red];
		j3351993898 -> j2428982659;
	j668318827 [label="Questo... non accadrà. Continua a parlare.",shape=box,color=red];
		j668318827 -> j2428982659;
	j1968411449 [label="Si specializzò in cristallografia. E i suoi lavori furono archiviati qui, nei laboratori.",shape=box,color=red];
		j1968411449 -> j536660651;
	j3424960910 [label="Allora mi dispiace di averne sprecato ancora.",shape=box,color=blue];
		j3424960910 -> j3007723528;
	j2428982659 [label="+5 Chemistry",color=orange];
		j2428982659 -> j1032599892;
	j536660651 [label="Per qualche ragione, non so perché, fu trasformato in un Cephalon e gli fu dato il suo guscio necraloid.",shape=box,color=red];
		j536660651 -> j3580931817;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j1032599892 [label="Lo sospettavo... Beh, mi ha chiesto da dove venissi e quando gliel'ho detto, ha riso e ha detto \"no, è impossibile! E dovrei saperlo, io sono-\"",shape=box,color=blue];
		j1032599892 -> j1645010626;
	j3580931817 [label="Non tutti i Cephalon furono creati per punizione. Ma le cose andarono... male qui su Deimos, e subì gravi danni.",shape=box,color=red];
		j3580931817 -> j2105349457;
	j1645010626 [label="E poi... si è presentato di nuovo. E mi ha chiesto se venivo dalle piane con dei campioni di minerale...",shape=box,color=blue];
		j1645010626 -> j2721006416;
		j1645010626 -> j178125172;
	j2105349457 [label="Pauvre petit...",shape=box,color=blue];
		j2105349457 -> j253530729;
	j2721006416 [label="Sì... così è Otak.",shape=box,color=red];
		j2721006416 -> j2723195245;
	j178125172 [label="Oh, Marie. Mi dispiace tanto...",shape=box,color=red];
		j178125172 -> j2723195245;
	j253530729 [label="Boolean MarieOtak1 is now true.",color=orange];
		j253530729 -> j1700159402;
		j253530729 -> j184008109;
	j2723195245 [label="Mi distrugge in mille pezzi pensare che non ci sia niente che possiamo fare per lui.",shape=box,color=blue];
		j2723195245 -> j457335464;
	j457335464 [label="Evaluate expressions",color=orange];
		j457335464 -> j4165341067 [label="MarieCephalonSoul",color=purple];
		j457335464 -> j1559782123 [label="MarieCephalonNoSoul",color=purple];
		j457335464 -> j3526417731 [label="MarieCephalonUnsure",color=purple];
		j457335464 -> j3273444225 [label="false",color=purple];
	j4165341067 [label="Oh, Luminari - che razza di inferno avete creato per lui, per tenere la sua anima intrappolata in quella gabbia di scienza e luci tremolanti?",shape=box,color=blue];
		j4165341067 -> j3068759256;
	j1559782123 [label="Posso solo pregare i Luminari che tu abbia ragione e che dentro quel guscio non rimanga altro che... scienza e luci tremolanti.",shape=box,color=blue];
		j1559782123 -> j763444991;
	j3526417731 [label="So che non sei sicuro che i Cephalon abbiano un'anima - ma posso solo pregare i Luminari affinché... quel povero Otak non soffra.",shape=box,color=blue];
		j3526417731 -> j1690734882;
	j3273444225 [label="Posso solo pregare i Luminari che tutto ciò che rimane dentro quel guscio non sia altro che... scienza e luci tremolanti.",shape=box,color=blue];
		j3273444225 -> j3205994642;
	j3068759256 [label="Perché lasciarlo lì, distrutto, ad aspettare che gli venga concesso di morire per ricevere pace? Posso solo pregare... che nel caso ci sia una qualche presenza lì -",shape=box,color=blue];
		j3068759256 -> j3146217244;
	j763444991 [label="E che nessuna anima sia intrappolata in quella distruzione, in attesa che le venga finalmente concessa la morte per poter trovare pace.",shape=box,color=blue];
		j763444991 -> j3580750283;
	j1690734882 [label="Che nessuna anima sia intrappolata in quella cosa distrutta, in attesa che le venga finalmente concessa la morte per ottenere la pace.",shape=box,color=blue];
		j1690734882 -> j1852111432;
	j3205994642 [label="E che nessuna anima sia intrappolata in quella distruzione, in attesa che le venga finalmente concessa la morte per poter trovare pace.",shape=box,color=blue];
		j3205994642 -> j1852111432;
	j3146217244 [label="Che lui rimanga per scelta come una specie di veglia solitaria...",shape=box,color=blue];
		j3146217244 -> j2789003899;
	j3580750283 [label="Perché se ti sbagliassi e un'anima rimane in quella gabbia contro la sua volontà ?",shape=box,color=blue];
		j3580750283 -> j2002360925;
	j1852111432 [label="Oppure, nel caso ci sia una qualche presenza lì, è perché lui rimane per scelta, come una sorta di veglia solitaria.",shape=box,color=blue];
		j1852111432 -> j2789003899;
	j2789003899 [label="Pensare il contrario è sufficiente per farti dubitare della bontà degli dei, non ?",shape=box,color=blue];
		j2789003899 -> j3112624043;
	j2002360925 [label="Basta per mettere in dubbio la bontà degli dei, non ?",shape=box,color=blue];
		j2002360925 -> j3112624043;
	j3112624043 [label="E poi chi sarei ?",shape=box,color=blue];
		j3112624043 -> j3982298173;
	j3982298173 [label="Perdonami, sono... sono malinconica oggi. ",shape=box,color=blue];
		j3982298173 -> j3251038745;
	j3251038745 [label="Evaluate expressions",color=orange];
		j3251038745 -> j3325128030 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j159043910 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j2798295788 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j2824195726 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j3325128030 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j159043910 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j2798295788 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j2824195726 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j3325128030 [label="false",color=purple];
		j3251038745 -> j159043910 [label="false",color=purple];
		j3251038745 -> j2824195726 [label="false",color=purple];
	j3325128030 [label="È normale. Hai tutto il diritto di esserlo.",shape=box,color=red];
		j3325128030 -> j1482983077;
	j159043910 [label="C'è qualcosa che posso fare per tirarti su il morale? Potremmo andare a tormentare Roathe.",shape=box,color=red];
		j159043910 -> j4064391649;
	j2798295788 [label="Posso fare qualcosa per tirarti su il morale? Forse rubare un paio di pasticcini?",shape=box,color=red];
		j2798295788 -> j2189684348;
	j2824195726 [label="A volte gli dei sono crudeli, Marie. È la vita.",shape=box,color=red];
		j2824195726 -> j2738113056;
	j1482983077 [label="+20 Chemistry",color=orange];
		j1482983077 -> j4265179961;
	j4064391649 [label="+15 Chemistry",color=orange];
		j4064391649 -> j4134856741;
	j2189684348 [label="+20 Chemistry",color=orange];
		j2189684348 -> j4134856741;
	j2738113056 [label="+5 Chemistry",color=orange];
		j2738113056 -> j1015797788;
	j4265179961 [label="Merci. Beh, non ho più voglia di esserlo. Vado a fare qualcosa di più allegro ! Credo che il carro armato di M'sieur Fibonacci abbia bisogno di una bella pulitina.",shape=box,color=blue];
		j4265179961 -> j2486340526;
	j4134856741 [label="Ah ! Merci. Questo fermerà sicuramente queste mie insensate lacrime. Sai come rallegrare la piccola sciocca Marie, non ?",shape=box,color=blue];
		j4134856741 -> j2542900611;
		j4134856741 -> j1263958324;
	j1015797788 [label="Oui. Hai perfettamente ragione. Lo sono. Il mondo è pieno di storie come quella di Monsieur Otak, e molte ben peggiori della sua. Non piangerei per nessuna di esse. ",shape=box,color=blue];
		j1015797788 -> j825917260;
	j2486340526 [label="Check boolean MarieDating",color=orange];
		j2486340526 -> j378832368 [label=true,color=green];
		j2486340526 -> j1783435543 [label=false,color=brown];
	j2542900611 [label="È il minimo che possa fare per te.",shape=box,color=red];
		j2542900611 -> j1350233930;
	j1263958324 [label="Non sei affatto sciocca. La penso allo stesso modo.",shape=box,color=red];
		j1263958324 -> j1350233930;
	j825917260 [label="Eppure, eccomi qui, seduta, a fare proprio questo. Grazie per avermi ricordato la mia stupidità. Fie! Piccola sciocca Marie. Beh... penso che l'acquario di M'sieur Fibonacci abbia bisogno di una bella pulitina.",shape=box,color=blue];
		j825917260 -> j2486340526;
	j378832368 [label="À la revoyure, mio lupo.",shape=box,color=blue];
		j378832368 -> j3007723528;
	j1783435543 [label="À la revoyure !",shape=box,color=blue];
		j1783435543 -> j3007723528;
	j1350233930 [label="+5 Chemistry",color=orange];
		j1350233930 -> j4058209286;
	j4058209286 [label="Check boolean MarieDating",color=orange];
		j4058209286 -> j4229488338 [label=true,color=green];
		j4058209286 -> j869007526 [label=false,color=brown];
	j4229488338 [label="Merci, merci, merci, mio lupo. Andiamo a combinare guai. ",shape=box,color=blue];
		j4229488338 -> j3007723528;
	j869007526 [label="Merci, merci, merci. Andiamo a combinare guai.",shape=box,color=blue];
