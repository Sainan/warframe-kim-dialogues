digraph {
	3229 [label="ArthurRank6Convo2 begins.",color=orange];
		3229 -> 3230;
	3230 [label="Stavo pensando, quanti altri di noi pensi ci siano là fuori?",shape=box,color=blue];
		3230 -> 3231;
		3230 -> 3232;
	3231 [label="Ti riferisci a qui nel 1999 o in un senso più ampio?",shape=box,color=red];
		3231 -> 3233;
	3232 [label="Cosa intendi per ''noi''?",shape=box,color=red];
		3232 -> 3234;
	3233 [label="Entrambi, suppongo. Qui, ora, nel passato - nel futuro.",shape=box,color=blue];
		3233 -> 3235;
	3234 [label="Protoframe. Qui, o altrove. O in qualunque *tempo* suppongo.",shape=box,color=blue];
		3234 -> 3235;
	3235 [label="Entrati ci ha creati con uno scopo. Con molteplici scopi. È chiaro che non si limitò a noi sei. ",shape=box,color=blue];
		3235 -> 3236;
		3235 -> 3237;
	3236 [label="All'inizio, pensavo che mi stesse preparando dei Warframe ''di riserva'' nel caso in cui i miei non fossero arrivati tramite Helminth. Ora, non ne sono più così sicuro.",shape=box,color=red];
		3236 -> 3238;
	3237 [label="Avrei solo voluto sapere cosa stesse combinando. O quali fossero le vere motivazioni dietro la creazione di altri protoframe.",shape=box,color=red];
		3237 -> 3239;
	3238 [label="Aveva senso quando eravamo solo noi sei.",shape=box,color=blue];
		3238 -> 3239;
	3239 [label="Credi veramente che la sua vera motivazione sia quella di porre fine all'Indifferenza?",shape=box,color=blue];
		3239 -> 3240;
	3240 [label="Possiamo *davvero* fidarci di lui?",shape=box,color=blue];
		3240 -> 3241;
		3240 -> 3242;
		3240 -> 3243;
	3241 [label="Onestamente non lo so. La mia fiducia in lui arriva solo fino a dove riesco a lanciarlo. E senza un Warframe, non riesco a lanciare molto lontano.",shape=box,color=red];
		3241 -> 3244;
	3242 [label="No. Non possiamo fidarci delle sue motivazioni così come non possiamo fidarci dei suoi metodi.",shape=box,color=red];
		3242 -> 3245;
		3242 -> 3246;
	3243 [label="Sì. Non sono sempre d'accordo con i suoi metodi. Ma sì. Vuole fermare quella cosa.",shape=box,color=red];
		3243 -> 3246;
		3243 -> 3245;
	3244 [label="+5 Chemistry",color=orange];
		3244 -> 3247;
	3245 [label="Sta cercando di rimettere il genio nella proverbiale lampada, sempre se sia possibile. Ed è un processo complicato.",shape=box,color=red];
		3245 -> 3248;
	3246 [label="Ma non abbiamo scelta, no? Tutto quello che io e la ragazzina possiamo fare è seguirlo e ripulire i suoi pasticci. ",shape=box,color=red];
		3246 -> 3249;
		3246 -> 3250;
	3247 [label="Heh.",shape=box,color=blue];
		3247 -> 3245;
		3247 -> 3246;
	3248 [label="E noi siamo i custodi della scuola, che laviamo i pavimenti dopo che è passato lui. Adorabile.",shape=box,color=blue];
		3248 -> 3249;
		3248 -> 3250;
	3249 [label="Ora che Kaya ha la sua versione del viaggio nel tempo, potrebbe diventare più facile per me andare avanti e indietro.",shape=box,color=red];
		3249 -> 3251;
	3250 [label="Ma io rimango qui, quindi ora tocca alla ragazzina.",shape=box,color=red];
		3250 -> 3254;
	3251 [label="Quella ragazzina a volte è una spina nel fianco, ma apprezzo il suo aiuto.",shape=box,color=blue];
		3251 -> 3253;
	3254 [label="Check boolean ArthurDating",color=orange];
		3254 -> 3603 [label=true,color=green];
		3254 -> 3252 [label=false,color=brown];
	3253 [label="È bello sapere che quando fai un salto a fare compere... potresti anche tornare... :/",shape=box,color=blue];
		3253 -> 3255;
	3603 [label="Eh. Vedremo. Ti conosco abbastanza bene, amore. E so che non sai quando tenere la testa bassa.",shape=box,color=blue];
		3603 -> 3257;
	3252 [label="Eh. Vedremo. Ti conosco abbastanza bene, Drifter. E so che non sai quando tenere la testa bassa.",shape=box,color=blue];
		3252 -> 3256;
	3255 [label="Check boolean ArthurDating",color=orange];
		3255 -> 3260 [label=true,color=green];
		3255 -> 3258 [label=false,color=brown];
		3255 -> 3259 [label=false,color=brown];
	3257 [label="È uno dei motivi per cui ti adoro così tanto. ;)",shape=box,color=blue];
		3257 -> 3259;
	3256 [label="È uno dei motivi per cui sopporto la tua presenza. ;)",shape=box,color=blue];
		3256 -> 3258;
	3260 [label="Le devo molto, mi ha dato un po' di serenità. :)",shape=box,color=blue];
		3260 -> 3258;
