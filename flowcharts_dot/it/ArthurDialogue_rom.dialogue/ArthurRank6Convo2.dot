		3277 -> 3281;
		3277 -> 3282;
		3277 -> 3283;
	3278 [label="Forse ha bisogno di un esercito? Forse sta cercando ''l'unica cosa'' che, secondo lui, può sconfiggere l'Indifferenza. Forse tante cose.",shape=box,color=red];
		3278 -> 3284;
	3279 [label="Giusto...",shape=box,color=blue];
		3279 -> 3285;
	3280 [label="Che qualunque fosse il motivo per cui è stato qui, che qualsiasi cosa ti abbia fatto, sia ancora importante. È ancora valido. Che non ha fallito.",shape=box,color=red];
		3280 -> 3286;
		3280 -> 3287;
	3281 [label="Allora tutto quello che possiamo fare è essere preparati se ciò dovesse accadere.",shape=box,color=red];
