	"ArthurRank6Convo2 begins." [color=orange];
		"ArthurRank6Convo2 begins." -> j1024993136;
	j1024993136 [label="Stavo pensando, quanti altri di noi pensi ci siano là fuori?",shape=box,color=blue];
		j1024993136 -> j2114562146;
		j1024993136 -> j183302915;
	j2114562146 [label="Ti riferisci a qui nel 1999 o in un senso più ampio?",shape=box,color=red];
		j2114562146 -> j326088941;
	j183302915 [label="Cosa intendi per ''noi''?",shape=box,color=red];
		j183302915 -> j2669928100;
	j326088941 [label="Entrambi, suppongo. Qui, ora, nel passato - nel futuro.",shape=box,color=blue];
		j326088941 -> j473487;
	j2669928100 [label="Protoframe. Qui, o altrove. O in qualunque *tempo* suppongo.",shape=box,color=blue];
		j2669928100 -> j473487;
	j473487 [label="Entrati ci ha creati con uno scopo. Con molteplici scopi. È chiaro che non si limitò a noi sei. ",shape=box,color=blue];
		j473487 -> j753208084;
		j473487 -> j2551340330;
	j753208084 [label="All'inizio, pensavo che mi stesse preparando dei Warframe ''di riserva'' nel caso in cui i miei non fossero arrivati tramite Helminth. Ora, non ne sono più così sicuro.",shape=box,color=red];
		j753208084 -> j402292274;
	j2551340330 [label="Avrei solo voluto sapere cosa stesse combinando. O quali fossero le vere motivazioni dietro la creazione di altri protoframe.",shape=box,color=red];
		j2551340330 -> j3482740189;
	j402292274 [label="Aveva senso quando eravamo solo noi sei.",shape=box,color=blue];
		j402292274 -> j3482740189;
	j3482740189 [label="Credi veramente che la sua vera motivazione sia quella di porre fine all'Indifferenza?",shape=box,color=blue];
		j3482740189 -> j2990095507;
	j2990095507 [label="Possiamo *davvero* fidarci di lui?",shape=box,color=blue];
		j2990095507 -> j1343477686;
		j2990095507 -> j1572418093;
		j2990095507 -> j3843057938;
	j1343477686 [label="Onestamente non lo so. La mia fiducia in lui arriva solo fino a dove riesco a lanciarlo. E senza un Warframe, non riesco a lanciare molto lontano.",shape=box,color=red];
		j1343477686 -> j1434502464;
	j1572418093 [label="No. Non possiamo fidarci delle sue motivazioni così come non possiamo fidarci dei suoi metodi.",shape=box,color=red];
		j1572418093 -> j3976432995;
		j1572418093 -> j3305603880;
	j3843057938 [label="Sì. Non sono sempre d'accordo con i suoi metodi. Ma sì. Vuole fermare quella cosa.",shape=box,color=red];
		j3843057938 -> j3305603880;
		j3843057938 -> j3976432995;
	j1434502464 [label="+5 Chemistry",color=orange];
		j1434502464 -> j4116031178;
	j3976432995 [label="Sta cercando di rimettere il genio nella proverbiale lampada, sempre se sia possibile. Ed è un processo complicato.",shape=box,color=red];
		j3976432995 -> j3313994615;
	j3305603880 [label="Ma non abbiamo scelta, no? Tutto quello che io e la ragazzina possiamo fare è seguirlo e ripulire i suoi pasticci. ",shape=box,color=red];
		j3305603880 -> j3704596074;
		j3305603880 -> j1647547957;
	j4116031178 [label="Heh.",shape=box,color=blue];
		j4116031178 -> j3976432995;
		j4116031178 -> j3305603880;
	j3313994615 [label="E noi siamo i custodi della scuola, che laviamo i pavimenti dopo che è passato lui. Adorabile.",shape=box,color=blue];
		j3313994615 -> j3704596074;
		j3313994615 -> j1647547957;
	j3704596074 [label="Ora che Kaya ha la sua versione del viaggio nel tempo, potrebbe diventare più facile per me andare avanti e indietro.",shape=box,color=red];
		j3704596074 -> j2473444524;
	j1647547957 [label="Ma io rimango qui, quindi ora tocca alla ragazzina.",shape=box,color=red];
		j1647547957 -> j161265069;
	j2473444524 [label="Quella ragazzina a volte è una spina nel fianco, ma apprezzo il suo aiuto.",shape=box,color=blue];
		j2473444524 -> j1511872010;
	j161265069 [label="Check boolean ArthurDating",color=orange];
		j161265069 -> j2564007477 [label=true,color=green];
		j161265069 -> j2754374315 [label=false,color=brown];
	j1511872010 [label="È bello sapere che quando fai un salto a fare compere... potresti anche tornare... :/",shape=box,color=blue];
		j1511872010 -> j2613732724;
	j2564007477 [label="Eh. Vedremo. Ti conosco abbastanza bene, amore. E so che non sai quando tenere la testa bassa.",shape=box,color=blue];
		j2564007477 -> j3317392640;
	j2754374315 [label="Eh. Vedremo. Ti conosco abbastanza bene, Drifter. E so che non sai quando tenere la testa bassa.",shape=box,color=blue];
		j2754374315 -> j2050574893;
	j2613732724 [label="Check boolean ArthurDating",color=orange];
		j2613732724 -> j565612532 [label=true,color=green];
		j2613732724 -> j85397862 [label=false,color=brown];
		j2613732724 -> j3457362402 [label=false,color=brown];
	j3317392640 [label="È uno dei motivi per cui ti adoro così tanto. ;)",shape=box,color=blue];
		j3317392640 -> j3457362402;
	j2050574893 [label="È uno dei motivi per cui sopporto la tua presenza. ;)",shape=box,color=blue];
		j2050574893 -> j85397862;
	j565612532 [label="Le devo molto, mi ha dato un po' di serenità. :)",shape=box,color=blue];
		j565612532 -> j85397862;
		j565612532 -> j3457362402;
	j85397862 [label="Un'emoticon! :D",shape=box,color=red];
		j85397862 -> j1014477779;
	j3457362402 [label="Non fare lo sdolcinato con me. ",shape=box,color=red];
		j3457362402 -> j3083985927;
	j1014477779 [label="Sì, sì. Non ti ci abituare. È ancora strano.",shape=box,color=blue];
		j1014477779 -> j873960233;
	j3083985927 [label="Mm, mi conosci. Croccante all'esterno, molliccio all'interno. Come una versione stantia di quei pasticcini orribili di cui Amir e Velimir continuano a parlare.",shape=box,color=blue];
		j3083985927 -> j534933995;
	j873960233 [label="Beh, sono lusingato.",shape=box,color=red];
		j873960233 -> j3892716940;
	j534933995 [label="I Tweebies?",shape=box,color=blue];
		j534933995 -> j3892716940;
	j3892716940 [label="Comunque, torniamo a noi. A volte ho la netta sensazione che Entrati abbia uno scopo più grande per tutti noi.",shape=box,color=blue];
		j3892716940 -> j1533280703;
		j3892716940 -> j2809068607;
		j3892716940 -> j2672274976;
	j1533280703 [label="Cosa te lo fa pensare?",shape=box,color=red];
		j1533280703 -> j97231962;
	j2809068607 [label="Sì, potresti avere ragione.",shape=box,color=red];
		j2809068607 -> j1231574272;
	j2672274976 [label="Potrebbe essere semplicemente un'illusione?",shape=box,color=red];
		j2672274976 -> j687632805;
	j97231962 [label="Da quanto impegno ha messo nel crearci? E il fatto che non siamo solo in sei...",shape=box,color=blue];
		j97231962 -> j4244292168;
	j1231574272 [label="Quale pensi che sia? E cosa sta aspettando?",shape=box,color=blue];
		j1231574272 -> j4139528425;
		j1231574272 -> j2113283382;
	j687632805 [label="Cosa intendi?",shape=box,color=blue];
		j687632805 -> j3635640047;
		j687632805 -> j1028093787;
	j4244292168 [label="Non costruisci armi come queste se non sai con certezza che le userai, amico.",shape=box,color=blue];
		j4244292168 -> j3515875647;
	j4139528425 [label="<RETRO_EMOJI_SHRUG>",shape=box,color=red];
		j4139528425 -> j3206884589;
	j2113283382 [label="\"Vorrei saperlo anche io\" è la risposta a entrambe le domande.",shape=box,color=red];
		j2113283382 -> j3206884589;
	j3635640047 [label="A volte è difficile pensare di non essere più ''importante''.",shape=box,color=red];
		j3635640047 -> j2703702006;
	j1028093787 [label="Beh, quello che voglio dire è... che forse non vuoi sentirti abbandonato da lui.",shape=box,color=red];
		j1028093787 -> j1304052111;
	j3515875647 [label="A meno che tu non *sappia* che ci sarà una guerra.",shape=box,color=blue];
		j3515875647 -> j893937657;
		j3515875647 -> j2306379176;
		j3515875647 -> j3211080866;
	j3206884589 [label="Forse ha bisogno di un esercito? Forse sta cercando ''l'unica cosa'' che, secondo lui, può sconfiggere l'Indifferenza. Forse tante cose.",shape=box,color=red];
		j3206884589 -> j864261249;
	j2703702006 [label="Giusto...",shape=box,color=blue];
		j2703702006 -> "Chat ends.";
	j1304052111 [label="Che qualunque fosse il motivo per cui è stato qui, che qualsiasi cosa ti abbia fatto, sia ancora importante. È ancora valido. Che non ha fallito.",shape=box,color=red];
		j1304052111 -> j2270969988;
		j1304052111 -> j1538687677;
	j893937657 [label="Allora tutto quello che possiamo fare è essere preparati se ciò dovesse accadere.",shape=box,color=red];
		j893937657 -> j3784274352;
	j2306379176 [label="È possibile. Ma Entrati sembra anche essere il tipo di persona che ha piani di emergenza. ",shape=box,color=red];
		j2306379176 -> j3027031594;
	j3211080866 [label="Non lo so. Minerva e Velimir mi parlavano della... \"Guerra Fredda?\" Sembra che la gente abbia costruito un sacco di armi assurde e poi non le abbia mai usate.",shape=box,color=red];
		j3211080866 -> j1785326965;
	j864261249 [label="Non posso fare a meno di pensare che siamo solo proiettili in una pistola. Destinati a essere usati. E buttati.",shape=box,color=blue];
		j864261249 -> j2472736332;
		j864261249 -> j4060879005;
	"Chat ends." [color=orange];
