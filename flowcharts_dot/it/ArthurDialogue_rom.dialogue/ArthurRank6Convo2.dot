		3259 -> 3262;
	3261 [label="Sì, sì. Non ti ci abituare. È ancora strano.",shape=box,color=blue];
		3261 -> 3263;
	3262 [label="Mm, mi conosci. Croccante all'esterno, molliccio all'interno. Come una versione stantia di quei pasticcini orribili di cui Amir e Velimir continuano a parlare.",shape=box,color=blue];
		3262 -> 3264;
	3263 [label="Beh, sono lusingato.",shape=box,color=red];
		3263 -> 3265;
	3264 [label="I Tweebies?",shape=box,color=blue];
		3264 -> 3265;
	3265 [label="Comunque, torniamo a noi. A volte ho la netta sensazione che Entrati abbia uno scopo più grande per tutti noi.",shape=box,color=blue];
		3265 -> 3266;
		3265 -> 3267;
		3265 -> 3268;
	3266 [label="Cosa te lo fa pensare?",shape=box,color=red];
