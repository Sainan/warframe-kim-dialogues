	3272 [label="Non costruisci armi come queste se non sai con certezza che le userai, amico.",shape=box,color=blue];
		3272 -> 3277;
	3273 [label="<RETRO_EMOJI_SHRUG>",shape=box,color=red];
		3273 -> 3278;
	3274 [label="\"Vorrei saperlo anche io\" è la risposta a entrambe le domande.",shape=box,color=red];
		3274 -> 3278;
	3275 [label="A volte è difficile pensare di non essere più ''importante''.",shape=box,color=red];
		3275 -> 3279;
	3276 [label="Beh, quello che voglio dire è... che forse non vuoi sentirti abbandonato da lui.",shape=box,color=red];
		3276 -> 3280;
