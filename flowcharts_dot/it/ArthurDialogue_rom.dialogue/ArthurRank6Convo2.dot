	j3784274352 [label="+5 Chemistry",color=orange];
		j3784274352 -> j840193224;
	j3027031594 [label="Forse.",shape=box,color=blue];
		j3027031594 -> j1410545881;
	j1785326965 [label="Una giusta contro argomentazione. Ma si tratta di una questione tra paesi, che coinvolge la diplomazia. Elementi in continua evoluzione.",shape=box,color=blue];
		j1785326965 -> j824992266;
	j2472736332 [label="Vorrei potertelo dire. Ma farò tutto il possibile per impedire che accada.",shape=box,color=red];
		j2472736332 -> j2307483378;
	j4060879005 [label="Non credi che sia finita?",shape=box,color=red];
		j4060879005 -> j2804088239;
	j4218627800 [label="Ma pensare che la tua storia finisca qui, senza avere un ruolo nel finale? Fa schifo.",shape=box,color=red];
		j4218627800 -> j1835939409;
	j2385547520 [label="Ma forse fa male pensare che da qualche parte là fuori sei stato sostituito da Arthur 2.0.",shape=box,color=red];
		j2385547520 -> j357041783;
	j2700019956 [label="Ma forse vuoi solo che i tuoi sacrifici continuino a contare in un senso più cosmico?",shape=box,color=red];
		j2700019956 -> j2854832080;
	j840193224 [label="Sono d'accordo.",shape=box,color=blue];
		j840193224 -> j892494251;
	j1410545881 [label="Una parte di me spera che ce ne siano altri là fuori. Ma se venissero tutti qui? Potremmo finire per aver bisogno di un centro commerciale più grande.",shape=box,color=blue];
		j1410545881 -> "Chat ends.";
	j824992266 [label="Si tratta di una questione tra un letterale dio e un uomo che crede di esserlo.",shape=box,color=blue];
		j824992266 -> j1699318692;
	j2307483378 [label="So che lo farai. E affronteremo quel giorno insieme, ne sono sicuro.",shape=box,color=blue];
		j2307483378 -> j2397353713;
	j2804088239 [label="No. Non costruisci armi come queste se non sai con certezza che le userai, amico.",shape=box,color=blue];
		j2804088239 -> j3259971156;
		j2804088239 -> j2306379176;
		j2804088239 -> j893937657;
	j1835939409 [label="Potrebbe essere una parte del problema. E se l'Indifferenza fosse una delle ragioni per cui sono così come sono? E se avessi dovuto affrontare tutto questo?",shape=box,color=blue];
		j1835939409 -> j1327981733;
	j357041783 [label="Amico, ero pronto ad andare in pensione prima di essere invischiato in questa assurdità. Per niente.",shape=box,color=blue];
		j357041783 -> j3380069018;
	j2854832080 [label="Forse. Forse no. Ma quanti sacrifici umani non contano nulla, nella vita? La maggior parte.",shape=box,color=blue];
		j2854832080 -> j4074395040;
	j892494251 [label="E se altri come noi finiranno qui spero non avremo bisogno di un centro commerciale più grande.",shape=box,color=blue];
		j892494251 -> "Chat ends.";
