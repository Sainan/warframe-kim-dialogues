	3374 [label="Cosa? No! Certo che no.",shape=box,color=blue];
		3374 -> 3377;
	3375 [label="Idee affascinanti su quante volte quest'anno sia stato ripetuto.",shape=box,color=blue];
		3375 -> 3378;
	3376 [label="Immagino che sia bello avere intorno delle persone con cui parlare e con cui non ho avuto a che fare così tanto.",shape=box,color=blue];
		3376 -> 3379;
	3377 [label="Gli Hex sono la mia famiglia. La mia squadra. Lo sai.",shape=box,color=blue];
		3377 -> 3376;
	3378 [label="Quante volte potrei aver dimenticato, o forse no, gli anni passati. Come lei vive... fuori dal tempo? Mentre noi no.",shape=box,color=blue];
		3378 -> 3380;
	3379 [label="Non so se abbia alcun senso. Li conosco, mi fido, solo che non ho mai *passato l'inferno* con loro.",shape=box,color=blue];
		3379 -> 3381;
	3380 [label="E prima che tu dica qualcosa, no. Non voglio saperlo. Non è mio diritto saperlo.",shape=box,color=blue];
		3380 -> 3382;
	3381 [label="Quindi a volte è più facile semplicemente sedersi e bere insieme a loro.",shape=box,color=blue];
		3381 -> 3383;
		3381 -> 3384;
		3381 -> 3385;
	3382 [label="Credo di voler solo dire: che tu l'abbia fatto o no? Va bene. Non te lo rinfaccerò.",shape=box,color=blue];
		3382 -> 3386;
	3383 [label="Non ho mai avuto realmente questa possibilità.",shape=box,color=red];
		3383 -> 3387;
	3384 [label="Sì. Capisco.",shape=box,color=red];
		3384 -> 3388;
	3385 [label="È anche un vantaggio il fatto che alcuni di loro siano un po' più grandi e abbiano esperienza militare.",shape=box,color=red];
		3385 -> 3389;
	3386 [label="Questa situazione in cui ci troviamo? Non è normale. Non siamo fatti per cose del genere, noi umani, intendo.",shape=box,color=blue];
		3386 -> 3390;
	3387 [label="Suppongo di no.",shape=box,color=blue];
		3387 -> 3391;
	3388 [label="Non c'è tanto... peso. Tanto passato. Amir lo chiamerebbe bagaglio.",shape=box,color=blue];
		3388 -> 3391;
	3389 [label="Per Sol. Esattamente. All'inizio non sapevo cosa pensare dei Libertatiani. Ma ora? Sono molto contento che siano qui.",shape=box,color=blue];
		3389 -> 3391;
	3390 [label="Non esistono manuali per questa roba. Qualunque cosa tu scelga di fare, confido che tu abbia buone ragioni per farla.",shape=box,color=blue];
		3390 -> 3392;
	3391 [label="Ma tutto questo mi ha fatto riflettere.",shape=box,color=blue];
