	3398 [label="Te. ",shape=box,color=blue];
		3398 -> 3401;
	3400 [label="Prima che tu venissi qui, non credo avrei potuto accettarlo. Avrei avuto troppa paura di perdere te. Quello che siamo.",shape=box,color=blue];
		3400 -> 3402;
	3399 [label="Prima che tu venissi qui, non credo avrei potuto accettarlo. Avrei avuto troppa paura di perdere una parte di me stesso.",shape=box,color=blue];
		3399 -> 3402;
	3401 [label="E tutta questa... linea temporale che si ripete. E mi ha fatto pensare a quanti 1999 potrei non ricordare.",shape=box,color=blue];
		3401 -> 3403;
		3401 -> 3404;
		3401 -> 3405;
	3402 [label="Mi ci sarei aggrappato come un disperato a una zattera in mare. Ma forse sono già stato in questo ciclo temporale abbastanza volte, o... forse solo tu, non lo so.",shape=box,color=blue];
		3402 -> 3406;
	3403 [label="Tutto ciò che ti ha detto la chitarra è una calunnia, lo giuro.",shape=box,color=red];
