		3393 -> 3397;
	3394 [label="Riguardo a cosa?",shape=box,color=red];
		3394 -> 3398;
	3396 [label="Ti amo. E anche se me ne dimenticassi? Anche se scegliessi un'altra persona? Mi sta bene.",shape=box,color=blue];
		3396 -> 3400;
	3395 [label="Mi fido totalmente di te. E niente cambierà questo fatto. Anche se me ne dimenticassi per un po'.",shape=box,color=blue];
