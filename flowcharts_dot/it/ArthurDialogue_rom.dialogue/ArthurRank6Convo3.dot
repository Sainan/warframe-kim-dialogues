	"ArthurRank6Convo3 begins." [color=orange];
		"ArthurRank6Convo3 begins." -> j1530993023;
	j1530993023 [label="L'altro giorno mi sono ritrovato a conversare con la chitarra.",shape=box,color=blue];
		j1530993023 -> j18989501;
		j1530993023 -> j3960364766;
	j18989501 [label="Personalmente non ne sono un grande fan.",shape=box,color=red];
		j18989501 -> j3393022395;
	j3960364766 [label="Lizzie? Com'è andata?",shape=box,color=red];
		j3960364766 -> j3499528732;
	j3393022395 [label="Onestamente, non mi è dispiaciuto. Una volta superata la... stranezza?",shape=box,color=blue];
		j3393022395 -> j722551278;
	j3499528732 [label="Meglio di quanto avrei pensato. Mi piace.",shape=box,color=blue];
		j3499528732 -> j722551278;
	j722551278 [label="E poi,",shape=box,color=blue];
		j722551278 -> j961208407;
	j961208407 [label="Dal momento che lei ed Eleanor sembrano sempre ridere a battute che nessun altro riesce a sentire.",shape=box,color=blue];
		j961208407 -> j1671249589;
	j1671249589 [label="Ho pensato che fosse il caso di presentarmi in modo appropriato.",shape=box,color=blue];
		j1671249589 -> j2886094113;
	j2886094113 [label="Fornisce un sacco di spunti utili. E Flare è adorabile. Sinceramente, tutti quelli che siedono al bar sono una ventata di aria fresca. ",shape=box,color=blue];
		j2886094113 -> j1259185220;
	j1259185220 [label="Beh. Proverbialmente.",shape=box,color=blue];
		j1259185220 -> j154913543;
		j1259185220 -> j3979622411;
		j1259185220 -> j1676982934;
	j154913543 [label="Ti sei già stancato degli Hex?",shape=box,color=red];
		j154913543 -> j1296192292;
	j3979622411 [label="Quali sarebbero questi spunti?",shape=box,color=red];
		j3979622411 -> j2886527855;
	j1676982934 [label="Sono felice che ti stia facendo degli amici. lol. ",shape=box,color=red];
		j1676982934 -> j1627725256;
	j1296192292 [label="Cosa? No! Certo che no.",shape=box,color=blue];
		j1296192292 -> j2490181242;
	j2886527855 [label="Idee affascinanti su quante volte quest'anno sia stato ripetuto.",shape=box,color=blue];
		j2886527855 -> j1864676933;
	j1627725256 [label="Immagino che sia bello avere intorno delle persone con cui parlare e con cui non ho avuto a che fare così tanto.",shape=box,color=blue];
		j1627725256 -> j2736949081;
	j2490181242 [label="Gli Hex sono la mia famiglia. La mia squadra. Lo sai.",shape=box,color=blue];
		j2490181242 -> j1627725256;
	j1864676933 [label="Quante volte potrei aver dimenticato, o forse no, gli anni passati. Come lei vive... fuori dal tempo? Mentre noi no.",shape=box,color=blue];
		j1864676933 -> j2330821556;
	j2736949081 [label="Non so se abbia alcun senso. Li conosco, mi fido, solo che non ho mai *passato l'inferno* con loro.",shape=box,color=blue];
		j2736949081 -> j2770246785;
	j2330821556 [label="E prima che tu dica qualcosa, no. Non voglio saperlo. Non è mio diritto saperlo.",shape=box,color=blue];
		j2330821556 -> j4162413704;
	j2770246785 [label="Quindi a volte è più facile semplicemente sedersi e bere insieme a loro.",shape=box,color=blue];
		j2770246785 -> j3501891041;
		j2770246785 -> j3849245273;
		j2770246785 -> j43605705;
	j4162413704 [label="Credo di voler solo dire: che tu l'abbia fatto o no? Va bene. Non te lo rinfaccerò.",shape=box,color=blue];
		j4162413704 -> j4006108296;
	j3501891041 [label="Non ho mai avuto realmente questa possibilità.",shape=box,color=red];
		j3501891041 -> j1489138495;
	j3849245273 [label="Sì. Capisco.",shape=box,color=red];
		j3849245273 -> j3634153291;
	j43605705 [label="È anche un vantaggio il fatto che alcuni di loro siano un po' più grandi e abbiano esperienza militare.",shape=box,color=red];
		j43605705 -> j3302394383;
	j4006108296 [label="Questa situazione in cui ci troviamo? Non è normale. Non siamo fatti per cose del genere, noi umani, intendo.",shape=box,color=blue];
		j4006108296 -> j4103707542;
	j1489138495 [label="Suppongo di no.",shape=box,color=blue];
		j1489138495 -> j1442653904;
	j3634153291 [label="Non c'è tanto... peso. Tanto passato. Amir lo chiamerebbe bagaglio.",shape=box,color=blue];
		j3634153291 -> j1442653904;
	j3302394383 [label="Per Sol. Esattamente. All'inizio non sapevo cosa pensare dei Libertatiani. Ma ora? Sono molto contento che siano qui.",shape=box,color=blue];
		j3302394383 -> j1442653904;
	j4103707542 [label="Non esistono manuali per questa roba. Qualunque cosa tu scelga di fare, confido che tu abbia buone ragioni per farla.",shape=box,color=blue];
		j4103707542 -> j2674809731;
	j1442653904 [label="Ma tutto questo mi ha fatto riflettere.",shape=box,color=blue];
		j1442653904 -> j2389337299;
		j1442653904 -> j4669624;
	j2674809731 [label="Check boolean ArthurDating",color=orange];
		j2674809731 -> j1263703520 [label=true,color=green];
		j2674809731 -> j3040887413 [label=false,color=brown];
	j2389337299 [label="Uh oh.",shape=box,color=red];
		j2389337299 -> j1380808229;
	j4669624 [label="Riguardo a cosa?",shape=box,color=red];
		j4669624 -> j2402049728;
	j1263703520 [label="Ti amo. E anche se me ne dimenticassi? Anche se scegliessi un'altra persona? Mi sta bene.",shape=box,color=blue];
		j1263703520 -> j2992554303;
	j3040887413 [label="Mi fido totalmente di te. E niente cambierà questo fatto. Anche se me ne dimenticassi per un po'.",shape=box,color=blue];
		j3040887413 -> j494508213;
	j1380808229 [label="Heh. Ascoltami. Si tratta di te, però.",shape=box,color=blue];
		j1380808229 -> j2947246031;
	j2402049728 [label="Te. ",shape=box,color=blue];
		j2402049728 -> j2947246031;
	j2992554303 [label="Prima che tu venissi qui, non credo avrei potuto accettarlo. Avrei avuto troppa paura di perdere te. Quello che siamo.",shape=box,color=blue];
		j2992554303 -> j3460519297;
	j494508213 [label="Prima che tu venissi qui, non credo avrei potuto accettarlo. Avrei avuto troppa paura di perdere una parte di me stesso.",shape=box,color=blue];
		j494508213 -> j3460519297;
	j2947246031 [label="E tutta questa... linea temporale che si ripete. E mi ha fatto pensare a quanti 1999 potrei non ricordare.",shape=box,color=blue];
		j2947246031 -> j693201886;
		j2947246031 -> j889657976;
		j2947246031 -> j2042526706;
	j3460519297 [label="Mi ci sarei aggrappato come un disperato a una zattera in mare. Ma forse sono già stato in questo ciclo temporale abbastanza volte, o... forse solo tu, non lo so.",shape=box,color=blue];
		j3460519297 -> j2023489624;
	j693201886 [label="Tutto ciò che ti ha detto la chitarra è una calunnia, lo giuro.",shape=box,color=red];
		j693201886 -> j3691994741;
	j889657976 [label="Sono nei guai?",shape=box,color=red];
		j889657976 -> j3691994741;
	j2042526706 [label="Io... non credo che dovremmo addentrarci in questo argomento, Arthur.",shape=box,color=red];
		j2042526706 -> j3691994741;
	j2023489624 [label="Questa felicità che mi hai dato ora, questa pace, vale di più in questo istante che sapere che potrebbe durare per sempre.",shape=box,color=blue];
		j2023489624 -> j2695486519;
	j3691994741 [label="Puoi aspettare un attimo, per favore? Sai che scrivo più lentamente di te.",shape=box,color=blue];
		j3691994741 -> j3816550051;
	j2695486519 [label="Se c'è una cosa che impari nella vita da soldato, è che tutto è fugace.",shape=box,color=blue];
		j2695486519 -> j2277100487;
	j3816550051 [label="Quello che sto cercando di dire è questo:",shape=box,color=blue];
		j3816550051 -> j198815133;
	j2277100487 [label="L'attimo prima sono qui, quello dopo non ci sono più. Credo di averlo accettato. Una volta per tutte.",shape=box,color=blue];
		j2277100487 -> j2750915313;
	j198815133 [label="Che tu abbia o non abbia fatto dimenticare a me o al resto dell'Hex le nostre interazioni passate? Va bene.",shape=box,color=blue];
		j198815133 -> j501179935;
	j2750915313 [label="Il nostro tempo insieme finisce perché tu dai un pugno al pavimento e io dimentico tutto?",shape=box,color=blue];
		j2750915313 -> j3178788618;
	j501179935 [label="Non te lo rinfaccerò.",shape=box,color=blue];
		j501179935 -> j4006108296;
	j3178788618 [label="Oppure perché un giorno l'Indifferenza ti coglie di sorpresa?",shape=box,color=blue];
		j3178788618 -> j1010298852;
	j1010298852 [label="Voglio godermi il presente. Qui e ora. Perché è quello che ho.",shape=box,color=blue];
		j1010298852 -> j1419939742;
	j1419939742 [label="E questo è ciò di cui posso essere certo.",shape=box,color=blue];
		j1419939742 -> j2805289853;
		j1419939742 -> j2897675534;
		j1419939742 -> j262792433;
	j2805289853 [label="Niente di personale. È soprattutto perché continuo a sbagliare cercando di uscire con tua sorella. :P",shape=box,color=red];
		j2805289853 -> j1302674755;
	j2897675534 [label="Grazie, Arthur... questo significa per me più di quanto riesca a esprimere.",shape=box,color=red];
		j2897675534 -> j974711040;
	j262792433 [label="A volte vorrei avere la tua stessa lucidità. <3",shape=box,color=red];
		j262792433 -> j1542526109;
	j1302674755 [label="Har har. Beh, è un bene che tu abbia un superpotere magico che ti permetta di togliere il piede dal punto nella tua trachea in cui l'hai spettacolarmente infilato, no?",shape=box,color=blue];
		j1302674755 -> j3196712499;
	j974711040 [label="Di tanto in tanto, cerco di tirarmi fuori il bastone dal culo abbastanza a lungo da dire qualcosa di significativo.",shape=box,color=blue];
		j974711040 -> j2712580700;
	j1542526109 [label="Più che altro è perché so di non avere altra scelta se non quella di mantenere un atteggiamento rigido. È il modo di fare britannico. ",shape=box,color=blue];
		j1542526109 -> j1134948586;
	j3196712499 [label="Il resto di noi deve solo imparare a comunicare. Ho una domanda, però.",shape=box,color=blue];
		j3196712499 -> j3760020863;
	j2712580700 [label="Bene, credo sia ora di bere qualcosa. Che ne dici?",shape=box,color=blue];
		j2712580700 -> j650260503;
		j2712580700 -> j174103260;
	j1134948586 [label="Come dice il vecchio proverbio: \"Chi va piano va sano e va lontano\".",shape=box,color=blue];
		j1134948586 -> j2712580700;
	j3760020863 [label="Abbassa i suoi standard a ogni reset?",shape=box,color=blue];
		j3760020863 -> "Chat ends.";
	j650260503 [label="Forse dopo.",shape=box,color=red];
		j650260503 -> j213406607;
	j174103260 [label="Ci vediamo lì. :)",shape=box,color=red];
		j174103260 -> "Chat ends.";
	"Chat ends." [color=orange];
	j213406607 [label="Come preferisci.",shape=box,color=blue];
		j213406607 -> "Chat ends.";
}