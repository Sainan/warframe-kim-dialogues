		3404 -> 3407;
	3405 [label="Io... non credo che dovremmo addentrarci in questo argomento, Arthur.",shape=box,color=red];
		3405 -> 3407;
	3406 [label="Questa felicità che mi hai dato ora, questa pace, vale di più in questo istante che sapere che potrebbe durare per sempre.",shape=box,color=blue];
