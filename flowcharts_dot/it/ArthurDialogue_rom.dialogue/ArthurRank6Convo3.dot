	3407 [label="Puoi aspettare un attimo, per favore? Sai che scrivo più lentamente di te.",shape=box,color=blue];
		3407 -> 3409;
	3408 [label="Se c'è una cosa che impari nella vita da soldato, è che tutto è fugace.",shape=box,color=blue];
