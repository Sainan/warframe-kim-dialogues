digraph {
	3433 [label="ArthurRank6Convo4 begins.",color=orange];
		3433 -> 3434;
	3434 [label="Domanda strana. Hanno i giochi nello spazio?",shape=box,color=blue];
		3434 -> 3435;
		3434 -> 3436;
	3435 [label="Intendi, giocattoli per bambini? Certo.",shape=box,color=red];
		3435 -> 3437;
	3436 [label="Che... tipo di giochi?",shape=box,color=red];
		3436 -> 3438;
	3437 [label="Heh. Davvero?",shape=box,color=blue];
		3437 -> 3439;
	3438 [label="OH, SOL. Non intendevo questo, e lo sai!",shape=box,color=blue];
		3438 -> 3440;
	3439 [label="È difficile immaginare che tra millemila anni nel futuro,",shape=box,color=blue];
		3439 -> 3441;
	3440 [label="Voglio dire, giocattoli per bambini. Bambole. Statuette. Cose del genere.",shape=box,color=blue];
		3440 -> 3442;
		3440 -> 3448;
	3441 [label="I bambini siano ancora seduti a rievocare storie con delle statuette e a giocare ai “banditi” o a “salva la principessa”.",shape=box,color=blue];
		3441 -> 3444;
		3441 -> 3445;
		3441 -> 3446;
	3442 [label="Ti volevo solo dare fastidio. :P",shape=box,color=red];
		3442 -> 3447;
	3448 [label="No, non ne abbiamo. [Fine]",shape=box,color=red];
		3448 -> 3452;
	3444 [label="Come sei arrivato a questa domanda?",shape=box,color=red];
		3444 -> 3449;
	3445 [label="Con cosa giocavi da piccolo?",shape=box,color=red];
		3445 -> 3450;
	3446 [label="Abbiamo nomi diversi per i giochi che giochiamo, ma avevo definitivamente dei giocattoli.",shape=box,color=red];
		3446 -> 3451;
	3447 [label="Sì, certo che sì. ",shape=box,color=red];
		3447 -> 3437;
	3452 [label="Chat ends.",color=orange];
	3449 [label="Stavo giusto guardando Amir giocare a uno dei suoi giochi arcade. ",shape=box,color=blue];
		3449 -> 3453;
	3450 [label="È piuttosto confortante pensare che, nonostante tutte le differenze tra le nostre culture, i bambini si limitano ancora a... sedersi e a giocare con i giocattoli.",shape=box,color=blue];
		3450 -> 3454;
	3451 [label="Tipo cosa?",shape=box,color=blue];
		3451 -> 3455;
		3451 -> 3456;
	3453 [label="E pensavo tra me e me: cosa non darei per riavere di nuovo quel tipo di gioia nella mia vita.",shape=box,color=blue];
		3453 -> 3457;
	3454 [label="Avevo questa statuetta snodabile. Action Angus. Era un soldato, banalmente.",shape=box,color=blue];
		3454 -> 3458;
	3455 [label="Ogni genere di statuette, animali peluche e mattoncini. Tipica roba da bambini. ",shape=box,color=red];
		3455 -> 3450;
	3456 [label="Avevo una (penso di poterla chiamare così) statuetta di questo bambino Dax a cui, beh, ho dato il nome di un personaggio di un mio libro. Dominus Thrax.",shape=box,color=red];
		3456 -> 3459;
	3457 [label="Non ho mai disprezzato Aoi, Amir e nemmeno Kaya per il fatto che si divertano con cose \"infantili\". Non mi ha mai dato fastidio.",shape=box,color=blue];
		3457 -> 3460;
	3458 [label="Durante la festa del sostizio, un gruppo di ragazzi più grandi me lo rubarono insieme a tanti altri giocattoli e, beh...",shape=box,color=blue];
		3458 -> 3461;
	3459 [label="Oh, cavolo. Avrei dovuto saperlo. Mi dispiace tanto di aver tirato fuori questo argomento.",shape=box,color=blue];
		3459 -> 3462;
		3459 -> 3463;
	3460 [label="Ma a volte ho paura che la parte di me capace di provare quella sensazione si sia rannicchiata e sia morta molto tempo fa.",shape=box,color=blue];
		3460 -> 3464;
	3461 [label="È una lunga storia. In breve? Dicevano che ero ''troppo grande'' per giocare con le bambole. Quella è stata l'ultima volta che ho giocato con dei giocattoli.",shape=box,color=blue];
		3461 -> 3465;
	3462 [label="No, non è l'argomento migliore da discutere.",shape=box,color=red];
		3462 -> 3466;
	3463 [label="Nessun problema. Non è colpa tua.",shape=box,color=red];
		3463 -> 3467;
	3464 [label="È un po' triste, non credi? Dire ai bambini di amare qualcosa, e poi dire loro di rinunciarvi quando ''maturano''.",shape=box,color=blue];
		3464 -> 3468;
		3464 -> 3469;
	3465 [label="L'altro giorno guardavo Amir giocare a uno dei suoi giochi. Era chiaro quanto ci fosse affezionato. Quanta felicità gli portasse. Ed ero un po' geloso di non avere niente del genere nella mia vita.",shape=box,color=blue];
		3465 -> 3464;
	3466 [label="Adesso mi sento un completo idiota.",shape=box,color=blue];
		3466 -> 3470;
	3467 [label="Avevamo tutti i normali giocattoli che ti aspetteresti, suppongo. Mattoncini, animali peluche, statuette, bambole.",shape=box,color=red];
		3467 -> 3471;
	3468 [label="Non lo so. Tutti dobbiamo crescere prima o poi. Non possiamo nasconderci nella finzione. L'ho imparato a mie spese.",shape=box,color=red];
		3468 -> 3472;
	3469 [label="Penso che la vita possa essere brutta, dolorosa, breve. E dovremmo riempirla di tutto il divertimento, le risate e l'amore che riusciamo a trovare.",shape=box,color=red];
		3469 -> 3473;
	3470 [label="Chat ends.",color=orange];
	3471 [label="La mia è diventata solo un po' più problematica a causa di tutta la... questione Void.",shape=box,color=red];
		3471 -> 3450;
	3472 [label="Hai ragione. Credo che quando diventa un sostituto della realtà, sia un problema. Non sto dicendo quello.",shape=box,color=blue];
		3472 -> 3474;
	3473 [label="Hai ragione. E spero che sia qualcosa che ricorderemo, mentre avanziamo assieme in... qualunque cosa sia questa situazione in cui ci troviamo.",shape=box,color=blue];
		3473 -> 3474;
	3474 [label="Sai, ho trovato Eleanor, Velimir, Aoi e Amir che giocavano a nascondino con Flare e Lizzie. (Quincy ha detto che non gli era permesso giocare perché quel bastardo stava barando, usava il suo mirino per vedere attraverso i muri.)",shape=box,color=blue];
		3474 -> 3475;
	3475 [label="Mi guardavano tutti, preoccupati che mi sarei arrabbiato per averli sorpresi a cazzeggiare quando avrebbero dovuto fare qualcosa di utile.",shape=box,color=blue];
		3475 -> 3476;
	3476 [label="Ero più arrabbiato perché non ero stato invitato. Heh. Ma ho dovuto fare la faccia da leader scontroso e fingere di essere arrabbiato per il fatto che le postazioni erano state lasciate incustodite, eccetera.",shape=box,color=blue];
		3476 -> 3477;
	3477 [label="Ma Amir ha i suoi giochi. Aoi ha gli On-lyne. Persino Kaya ha i suoi adesivi e il suo Jinymon, nonostante il mondo l'abbia costretta a diventare adulta troppo presto.",shape=box,color=blue];
		3477 -> 3478;
		3477 -> 3479;
	3478 [label="C'è un punto a cui stai cercando di arrivare?",shape=box,color=red];
		3478 -> 3480;
	3479 [label="Penso che sia qualcosa che potresti recuperare, se ci provassi. Trovare gioia nei giocattoli e nei giochi, intendo.",shape=box,color=red];
		3479 -> 3481;
	3480 [label="Onestamente? Non ne sono sicuro. Sento solo che mi manca qualcosa che è scomparso dalla mia vita da molto tempo.",shape=box,color=blue];
		3480 -> 3482;
	3481 [label="Riesco già a sentire le risate. Ma immagino che sia proprio questo a frenarmi, non è vero? L'imbarazzo.",shape=box,color=blue];
		3481 -> 3483;
	3482 [label="Non so se potrò mai recuperarlo. O se è troppo tardi. Ma chi lo sa. Con il tempo, forse tutto è possibile.",shape=box,color=blue];
		3482 -> 3484;
	3483 [label="Non sono sicuro che sia possibile recuperarlo, anche se riuscissi a superare la vergogna momentanea. Ma chissà. Con abbastanza cicli temporali, forse tutto è possibile.",shape=box,color=blue];
		3483 -> 3485;
	3484 [label="Chat ends.",color=orange];
	3485 [label="Chat ends.",color=orange];
}