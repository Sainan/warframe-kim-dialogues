digraph {
	"ArthurRank6Convo4 begins." [color=orange];
		"ArthurRank6Convo4 begins." -> j1066343992;
	j1066343992 [label="Domanda strana. Hanno i giochi nello spazio?",shape=box,color=blue];
		j1066343992 -> j3728246198;
		j1066343992 -> j2639982040;
	j3728246198 [label="Intendi, giocattoli per bambini? Certo.",shape=box,color=red];
		j3728246198 -> j194595881;
	j2639982040 [label="Che... tipo di giochi?",shape=box,color=red];
		j2639982040 -> j630599462;
	j194595881 [label="Heh. Davvero?",shape=box,color=blue];
		j194595881 -> j727730242;
	j630599462 [label="OH, SOL. Non intendevo questo, e lo sai!",shape=box,color=blue];
		j630599462 -> j1806152180;
	j727730242 [label="È difficile immaginare che tra millemila anni nel futuro,",shape=box,color=blue];
		j727730242 -> j1624763738;
	j1806152180 [label="Voglio dire, giocattoli per bambini. Bambole. Statuette. Cose del genere.",shape=box,color=blue];
		j1806152180 -> j728516095;
		j1806152180 -> j1023315079;
	j1624763738 [label="I bambini siano ancora seduti a rievocare storie con delle statuette e a giocare ai “banditi” o a “salva la principessa”.",shape=box,color=blue];
		j1624763738 -> j1717878075;
		j1624763738 -> j2625748467;
		j1624763738 -> j2997837240;
	j728516095 [label="Ti volevo solo dare fastidio. :P",shape=box,color=red];
		j728516095 -> j608067380;
	j1023315079 [label="No, non ne abbiamo. [Fine]",shape=box,color=red];
		j1023315079 -> "Chat ends.";
	j1717878075 [label="Come sei arrivato a questa domanda?",shape=box,color=red];
		j1717878075 -> j2450380443;
	j2625748467 [label="Con cosa giocavi da piccolo?",shape=box,color=red];
		j2625748467 -> j550055361;
	j2997837240 [label="Abbiamo nomi diversi per i giochi che giochiamo, ma avevo definitivamente dei giocattoli.",shape=box,color=red];
		j2997837240 -> j521931634;
	j608067380 [label="Sì, certo che sì. ",shape=box,color=red];
		j608067380 -> j194595881;
	"Chat ends." [color=orange];
	j2450380443 [label="Stavo giusto guardando Amir giocare a uno dei suoi giochi arcade. ",shape=box,color=blue];
		j2450380443 -> j3054215548;
	j550055361 [label="È piuttosto confortante pensare che, nonostante tutte le differenze tra le nostre culture, i bambini si limitano ancora a... sedersi e a giocare con i giocattoli.",shape=box,color=blue];
		j550055361 -> j4285104018;
	j521931634 [label="Tipo cosa?",shape=box,color=blue];
		j521931634 -> j2360854778;
		j521931634 -> j857909731;
	j3054215548 [label="E pensavo tra me e me: cosa non darei per riavere di nuovo quel tipo di gioia nella mia vita.",shape=box,color=blue];
		j3054215548 -> j1432821798;
	j4285104018 [label="Avevo questa statuetta snodabile. Action Angus. Era un soldato, banalmente.",shape=box,color=blue];
		j4285104018 -> j1746271677;
	j2360854778 [label="Ogni genere di statuette, animali peluche e mattoncini. Tipica roba da bambini. ",shape=box,color=red];
		j2360854778 -> j550055361;
	j857909731 [label="Avevo una (penso di poterla chiamare così) statuetta di questo bambino Dax a cui, beh, ho dato il nome di un personaggio di un mio libro. Dominus Thrax.",shape=box,color=red];
		j857909731 -> j1263141142;
	j1432821798 [label="Non ho mai disprezzato Aoi, Amir e nemmeno Kaya per il fatto che si divertano con cose \"infantili\". Non mi ha mai dato fastidio.",shape=box,color=blue];
		j1432821798 -> j3524569861;
	j1746271677 [label="Durante la festa del sostizio, un gruppo di ragazzi più grandi me lo rubarono insieme a tanti altri giocattoli e, beh...",shape=box,color=blue];
		j1746271677 -> j199194967;
	j1263141142 [label="Oh, cavolo. Avrei dovuto saperlo. Mi dispiace tanto di aver tirato fuori questo argomento.",shape=box,color=blue];
		j1263141142 -> j4292170354;
		j1263141142 -> j463468541;
	j3524569861 [label="Ma a volte ho paura che la parte di me capace di provare quella sensazione si sia rannicchiata e sia morta molto tempo fa.",shape=box,color=blue];
		j3524569861 -> j505255101;
	j199194967 [label="È una lunga storia. In breve? Dicevano che ero ''troppo grande'' per giocare con le bambole. Quella è stata l'ultima volta che ho giocato con dei giocattoli.",shape=box,color=blue];
		j199194967 -> j3409451463;
	j4292170354 [label="No, non è l'argomento migliore da discutere.",shape=box,color=red];
		j4292170354 -> j1714486238;
	j463468541 [label="Nessun problema. Non è colpa tua.",shape=box,color=red];
		j463468541 -> j38210883;
	j505255101 [label="È un po' triste, non credi? Dire ai bambini di amare qualcosa, e poi dire loro di rinunciarvi quando ''maturano''.",shape=box,color=blue];
		j505255101 -> j177994007;
		j505255101 -> j4032609660;
	j3409451463 [label="L'altro giorno guardavo Amir giocare a uno dei suoi giochi. Era chiaro quanto ci fosse affezionato. Quanta felicità gli portasse. Ed ero un po' geloso di non avere niente del genere nella mia vita.",shape=box,color=blue];
		j3409451463 -> j505255101;
	j1714486238 [label="Adesso mi sento un completo idiota.",shape=box,color=blue];
		j1714486238 -> "Chat ends.";
	j38210883 [label="Avevamo tutti i normali giocattoli che ti aspetteresti, suppongo. Mattoncini, animali peluche, statuette, bambole.",shape=box,color=red];
		j38210883 -> j1006591785;
	j177994007 [label="Non lo so. Tutti dobbiamo crescere prima o poi. Non possiamo nasconderci nella finzione. L'ho imparato a mie spese.",shape=box,color=red];
		j177994007 -> j2784850055;
	j4032609660 [label="Penso che la vita possa essere brutta, dolorosa, breve. E dovremmo riempirla di tutto il divertimento, le risate e l'amore che riusciamo a trovare.",shape=box,color=red];
		j4032609660 -> j2878978579;
	j1006591785 [label="La mia è diventata solo un po' più problematica a causa di tutta la... questione Void.",shape=box,color=red];
		j1006591785 -> j550055361;
	j2784850055 [label="Hai ragione. Credo che quando diventa un sostituto della realtà, sia un problema. Non sto dicendo quello.",shape=box,color=blue];
		j2784850055 -> j1741189857;
	j2878978579 [label="Hai ragione. E spero che sia qualcosa che ricorderemo, mentre avanziamo assieme in... qualunque cosa sia questa situazione in cui ci troviamo.",shape=box,color=blue];
		j2878978579 -> j1741189857;
	j1741189857 [label="Sai, ho trovato Eleanor, Velimir, Aoi e Amir che giocavano a nascondino con Flare e Lizzie. (Quincy ha detto che non gli era permesso giocare perché quel bastardo stava barando, usava il suo mirino per vedere attraverso i muri.)",shape=box,color=blue];
		j1741189857 -> j1618729486;
	j1618729486 [label="Mi guardavano tutti, preoccupati che mi sarei arrabbiato per averli sorpresi a cazzeggiare quando avrebbero dovuto fare qualcosa di utile.",shape=box,color=blue];
		j1618729486 -> j207825338;
	j207825338 [label="Ero più arrabbiato perché non ero stato invitato. Heh. Ma ho dovuto fare la faccia da leader scontroso e fingere di essere arrabbiato per il fatto che le postazioni erano state lasciate incustodite, eccetera.",shape=box,color=blue];
		j207825338 -> j2945534074;
	j2945534074 [label="Ma Amir ha i suoi giochi. Aoi ha gli On-lyne. Persino Kaya ha i suoi adesivi e il suo Jinymon, nonostante il mondo l'abbia costretta a diventare adulta troppo presto.",shape=box,color=blue];
		j2945534074 -> j1698983527;
		j2945534074 -> j3499917290;
	j1698983527 [label="C'è un punto a cui stai cercando di arrivare?",shape=box,color=red];
		j1698983527 -> j258057972;
	j3499917290 [label="Penso che sia qualcosa che potresti recuperare, se ci provassi. Trovare gioia nei giocattoli e nei giochi, intendo.",shape=box,color=red];
		j3499917290 -> j3780584444;
	j258057972 [label="Onestamente? Non ne sono sicuro. Sento solo che mi manca qualcosa che è scomparso dalla mia vita da molto tempo.",shape=box,color=blue];
		j258057972 -> j3626562118;
	j3780584444 [label="Riesco già a sentire le risate. Ma immagino che sia proprio questo a frenarmi, non è vero? L'imbarazzo.",shape=box,color=blue];
		j3780584444 -> j1218251567;
	j3626562118 [label="Non so se potrò mai recuperarlo. O se è troppo tardi. Ma chi lo sa. Con il tempo, forse tutto è possibile.",shape=box,color=blue];
		j3626562118 -> "Chat ends.";
	j1218251567 [label="Non sono sicuro che sia possibile recuperarlo, anche se riuscissi a superare la vergogna momentanea. Ma chissà. Con abbastanza cicli temporali, forse tutto è possibile.",shape=box,color=blue];
		j1218251567 -> "Chat ends.";
}