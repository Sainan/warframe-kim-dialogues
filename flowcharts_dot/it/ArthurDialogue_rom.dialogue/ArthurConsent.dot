	j972778441 [label="Check boolean ArthurPolyamorySuccess",color=orange];
		j972778441 -> j1569221931 [label=true,color=green];
		j972778441 -> "Chat ends." [label=false,color=brown];
	j425813142 [label="Arthur, possiamo parlare? [Chiedi il consenso per avere più partner.]",shape=box,color=red];
		j425813142 -> j2071933867;
	j424648354 [label="[Fine.]",shape=box,color=red];
		j424648354 -> j3652224286;
	j2071933867 [label="Sempre. C'è qualcosa che non va?",shape=box,color=blue];
		j2071933867 -> j1811583857;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j1811583857 [label="No, non esattamente. Volevo solo parlarti di una situazione che spero non ti crei disagio.",shape=box,color=red];
		j1811583857 -> j3125611659;
	j3125611659 [label="Non voglio metterti in una situazione che ti crea disagio. So che non ne abbiamo parlato. Quindi se non sarai d'accordo, va bene. Voglio che tu lo sappia.",shape=box,color=red];
		j3125611659 -> j590473987;
	j590473987 [label="Ciò che abbiamo è importante per me - molto importante - ed è reale. Non voglio che ne dubiti.",shape=box,color=red];
		j590473987 -> j2438631012;
	j2438631012 [label="Ah. Ho capito dove vuoi arrivare. Provi dei sentimenti anche per qualcun altro?",shape=box,color=blue];
		j2438631012 -> j2215608983;
		j2438631012 -> j3185444977;
	j2215608983 [label="Sì. E so che potrebbe essere difficile da capire, ma non significa che i miei sentimenti per te siano diminuiti.",shape=box,color=red];
		j2215608983 -> j2903730617;
	j3185444977 [label="Sì. Ma ora che ci penso, credo che dovremmo chiudere qui. [Lascia Arthur.]",shape=box,color=red];
		j3185444977 -> j3595763292;
	j2903730617 [label="Tesoro, pensi davvero che io abbia trascorso così tanti anni nell'esercito e non abbia visto praticamente ogni tipo di relazione esistente?",shape=box,color=blue];
		j2903730617 -> j38932304;
	j3595763292 [label="Se è questo che vuoi veramente, allora...",shape=box,color=blue];
		j3595763292 -> j3701883258;
	j38932304 [label="Quando passi gran parte della tua vita quasi in punto di morte, impari ad apprezzare ciò che conta nella vita e ciò che non ha importanza.",shape=box,color=blue];
		j38932304 -> j3977855403;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j3977855403 [label="Smettila di mettere in discussione le linee tracciate sulla sabbia. Ti capisco perfettamente.",shape=box,color=blue];
		j3977855403 -> j1233583613;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j1233583613 [label="La verità è, che tu per me sei importante. E se questa persona è importante per te, allora è importante anche per me.",shape=box,color=blue];
		j1233583613 -> j802178963;
	j802178963 [label="Solo. Che non sia un Hex. Va bene? Non credo che potrei sopportarlo se fosse 'in famiglia', giusto per dire.",shape=box,color=blue];
		j802178963 -> j1896021955;
	j1896021955 [label="Solo il pensiero mi farà venire gli incubi.",shape=box,color=blue];
		j1896021955 -> j2482055086;
		j1896021955 -> j340291423;
	j2482055086 [label="Lol. Lo prometto.",shape=box,color=red];
		j2482055086 -> j3422773710;
	j340291423 [label="Per quel che vale, penso proprio che ti piacerebbe.",shape=box,color=red];
		j340291423 -> j1729494154;
	j3422773710 [label="Grazie. E spero di fare la sua conoscenza un giorno. Per... motivi personali, ovviamente.",shape=box,color=blue];
		j3422773710 -> j3188848974;
	j1729494154 [label="E spero di incontrare questa persona un giorno. Per... motivi personali, ovviamente.",shape=box,color=blue];
		j1729494154 -> j3188848974;
	j3188848974 [label="+20 Chemistry",color=orange];
		j3188848974 -> j1853158127;
	j1853158127 [label="Prenditi cura di te, amore.",shape=box,color=blue];
		j1853158127 -> j3652224286;
}