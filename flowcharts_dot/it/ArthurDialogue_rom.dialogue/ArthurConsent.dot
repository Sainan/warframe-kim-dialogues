	j972778441 [label="Check boolean ArthurPolyamorySuccess",color=orange];
		j972778441 -> j1569221931 [label=true,color=green];
		j972778441 -> "Chat ends." [label=false,color=brown];
	j3806992724 [label="Arthur, possiamo parlare? [Chiedi il consenso per avere più partner.]",shape=box,color=red];
		j3806992724 -> j4282221085;
	j424648354 [label="[Fine.]",shape=box,color=red];
		j424648354 -> j3652224286;
	j4282221085 [label="Sempre. C'è qualcosa che non va?",shape=box,color=blue];
		j4282221085 -> j2395657802;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j2395657802 [label="No, non esattamente. Volevo solo parlarti di una situazione che spero non ti crei disagio.",shape=box,color=red];
		j2395657802 -> j3264490010;
	j3264490010 [label="Non voglio metterti in una situazione che ti crea disagio. So che non ne abbiamo parlato. Quindi se non sarai d'accordo, va bene. Voglio che tu lo sappia.",shape=box,color=red];
		j3264490010 -> j113647956;
	j113647956 [label="Ciò che abbiamo è importante per me - molto importante - ed è reale. Non voglio che ne dubiti.",shape=box,color=red];
		j113647956 -> j936931651;
	j936931651 [label="Ah. Ho capito dove vuoi arrivare. Provi dei... sentimenti anche per qualcun altro, vero?",shape=box,color=blue];
		j936931651 -> j3528220712;
		j936931651 -> j3185444977;
	j3528220712 [label="Sì. E so che potrebbe essere difficile da capire, ma non significa che i miei sentimenti per te siano diminuiti.",shape=box,color=red];
		j3528220712 -> j3898426258;
	j3185444977 [label="Sì. Ma ora che ci penso, credo che dovremmo chiudere qui. [Lascia Arthur.]",shape=box,color=red];
		j3185444977 -> j3595763292;
	j3898426258 [label="Tesoro, pensi davvero che io abbia trascorso così tanti anni nell'esercito e non abbia visto praticamente ogni tipo di relazione esistente?",shape=box,color=blue];
		j3898426258 -> j3791704060;
	j3595763292 [label="Se è questo che vuoi veramente, allora...",shape=box,color=blue];
		j3595763292 -> j3701883258;
	j3791704060 [label="Quando passi gran parte della tua vita quasi in punto di morte, impari ad apprezzare ciò che conta nella vita e ciò che non ha importanza.",shape=box,color=blue];
		j3791704060 -> j1171020728;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j1171020728 [label="Non so come andrà a finire. Ma per me sei così importante che sono disposto a provarci.",shape=box,color=blue];
		j1171020728 -> j19377091;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j19377091 [label="Ci tengo a te. E se tu tieni a questa persona, allora ci tengo anche io.",shape=box,color=blue];
		j19377091 -> j2803097117;
	j2803097117 [label="Basta che, non sia del centro commerciale. Va bene?",shape=box,color=blue];
		j2803097117 -> j2152151621;
	j2152151621 [label="Le cose sono già abbastanza confuse.",shape=box,color=blue];
		j2152151621 -> j2482055086;
		j2152151621 -> j340291423;
	j2482055086 [label="Lol. Lo prometto.",shape=box,color=red];
		j2482055086 -> j3422773710;
	j340291423 [label="Per quel che vale, penso proprio che ti piacerebbe.",shape=box,color=red];
		j340291423 -> j1729494154;
	j3422773710 [label="Grazie. E spero di fare la sua conoscenza un giorno. Per... motivi personali, ovviamente.",shape=box,color=blue];
		j3422773710 -> j3188848974;
	j1729494154 [label="E spero di incontrare questa persona un giorno. Per... motivi personali, ovviamente.",shape=box,color=blue];
		j1729494154 -> j3188848974;
	j3188848974 [label="+20 Chemistry",color=orange];
		j3188848974 -> j1853158127;
	j1853158127 [label="Prenditi cura di te, amore.",shape=box,color=blue];
		j1853158127 -> j3652224286;
}