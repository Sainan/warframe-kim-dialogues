	3612 [label="Chat ends.",color=orange];
	3613 [label="Arthur, possiamo parlare? [Chiedi il consenso per avere più partner.]",shape=box,color=red];
		3613 -> 3615;
	3611 [label="[Fine.]",shape=box,color=red];
		3611 -> 3614;
	3610 [label="Chat ends.",color=orange];
	3615 [label="Sempre. C'è qualcosa che non va?",shape=box,color=blue];
		3615 -> 3617;
	3614 [label="Update boolean ArthurConsentComplete",color=orange];
		3614 -> 3616;
	3617 [label="No, non esattamente. Volevo solo parlarti di una situazione che spero non ti crei disagio.",shape=box,color=red];
		3617 -> 3618;
	3616 [label="Chat ends.",color=orange];
	3618 [label="Non voglio metterti in una situazione che ti crea disagio. So che non ne abbiamo parlato. Quindi se non sarai d'accordo, va bene. Voglio che tu lo sappia.",shape=box,color=red];
		3618 -> 3619;
	3619 [label="Ciò che abbiamo è importante per me - molto importante - ed è reale. Non voglio che ne dubiti.",shape=box,color=red];
		3619 -> 3620;
	3620 [label="Ah. Ho capito dove vuoi arrivare. Provi dei sentimenti anche per qualcun altro?",shape=box,color=blue];
		3620 -> 3621;
		3620 -> 3622;
	3621 [label="Sì. E so che potrebbe essere difficile da capire, ma non significa che i miei sentimenti per te siano diminuiti.",shape=box,color=red];
		3621 -> 3623;
	3622 [label="Sì. Ma ora che ci penso, credo che dovremmo chiudere qui. [Lascia Arthur.]",shape=box,color=red];
		3622 -> 3624;
	3623 [label="Tesoro, pensi davvero che io abbia trascorso così tanti anni nell'esercito e non abbia visto praticamente ogni tipo di relazione esistente?",shape=box,color=blue];
		3623 -> 3625;
	3624 [label="Se è questo che vuoi veramente, allora...",shape=box,color=blue];
		3624 -> 3626;
	3625 [label="Quando passi gran parte della tua vita quasi in punto di morte, impari ad apprezzare ciò che conta nella vita e ciò che non ha importanza.",shape=box,color=blue];
		3625 -> 3627;
	3626 [label="Update boolean IsDating",color=orange];
		3626 -> 3628;
	3627 [label="Smettila di mettere in discussione le linee tracciate sulla sabbia. Ti capisco perfettamente.",shape=box,color=blue];
		3627 -> 3629;
	3628 [label="Update boolean ArthurDating",color=orange];
		3628 -> 3630;
	3629 [label="La verità è, che tu per me sei importante. E se questa persona è importante per te, allora è importante anche per me.",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="Chat ends.",color=orange];
	3631 [label="Solo. Che non sia un Hex. Va bene? Non credo che potrei sopportarlo se fosse 'in famiglia', giusto per dire.",shape=box,color=blue];
		3631 -> 3632;
	3632 [label="Solo il pensiero mi farà venire gli incubi.",shape=box,color=blue];
		3632 -> 3634;
		3632 -> 3633;
	3634 [label="Lol. Lo prometto.",shape=box,color=red];
		3634 -> 3636;
	3633 [label="Per quel che vale, penso proprio che ti piacerebbe.",shape=box,color=red];
		3633 -> 3635;
	3636 [label="Grazie. E spero di fare la sua conoscenza un giorno. Per... motivi personali, ovviamente.",shape=box,color=blue];
		3636 -> 3637;
	3635 [label="E spero di incontrare questa persona un giorno. Per... motivi personali, ovviamente.",shape=box,color=blue];
		3635 -> 3637;
	3637 [label="+20 Chemistry",color=orange];
