digraph {
	"ArthurRank6Convo9 begins." [color=orange];
		"ArthurRank6Convo9 begins." -> j3013931954;
	j3013931954 [label="Non sono molto convinto di... queste armi Infested che Eleanor sta collezionando.",shape=box,color=blue];
		j3013931954 -> j2861467024;
		j3013931954 -> j1127583015;
	j2861467024 [label="Perché?",shape=box,color=red];
		j2861467024 -> j88429517;
	j1127583015 [label="Almeno non parlano.",shape=box,color=red];
		j1127583015 -> j4208828421;
	j88429517 [label="Oltre al fatto che penso che lei possa comunicarci?",shape=box,color=blue];
		j88429517 -> j3446992929;
	j4208828421 [label="A *noi*. Non sono del tutto sicuro che non parlino con *lei*.",shape=box,color=blue];
		j4208828421 -> j3446992929;
	j3446992929 [label="So che parlano alla chitarra. E non voglio pensare a questo fatto più del necessario.",shape=box,color=blue];
		j3446992929 -> j1873100746;
	j1873100746 [label="Ma dovremmo preoccuparci della loro... diffusione? Sembrano effettivamente in grado di moltiplicarsi.",shape=box,color=blue];
		j1873100746 -> j4145236107;
	j4145236107 [label="Cosa che non comprendo. Né voglio soffermarmi troppo sulla provenienza delle loro munizioni. O da cosa siano composte in primo luogo.",shape=box,color=blue];
		j4145236107 -> j1062545277;
		j4145236107 -> j1671120152;
	j1062545277 [label="Almeno queste cose Infested sono dalla nostra parte?",shape=box,color=red];
		j1062545277 -> j2256249182;
	j1671120152 [label="Forse sarebbe meglio che ti limitassi alle armi normali.",shape=box,color=red];
		j1671120152 -> j4028431965;
	j2256249182 [label="Certo. Per *ora.*",shape=box,color=blue];
		j2256249182 -> j4201414785;
	j4028431965 [label="Penso proprio che lo farò.",shape=box,color=blue];
		j4028431965 -> j4201414785;
	j4201414785 [label="Almeno sono sicuro che se l'arma mi fa un buco nel piede è perché l'idiota sono io.",shape=box,color=blue];
		j4201414785 -> j2309341308;
	j2309341308 [label="E non perché la mia pistola ha deciso di riconsiderare la sua lealtà o è stata colta da un attacco di fame notturna.",shape=box,color=blue];
		j2309341308 -> "Chat ends.";
	"Chat ends." [color=orange];
}