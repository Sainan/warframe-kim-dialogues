digraph {
	3555 [label="ArthurRank6Convo9 begins.",color=orange];
		3555 -> 3556;
	3556 [label="Non sono molto convinto di... queste armi Infested che Eleanor sta collezionando.",shape=box,color=blue];
		3556 -> 3557;
		3556 -> 3558;
	3557 [label="Perché?",shape=box,color=red];
		3557 -> 3559;
	3558 [label="Almeno non parlano.",shape=box,color=red];
		3558 -> 3560;
	3559 [label="Oltre al fatto che penso che lei possa comunicarci?",shape=box,color=blue];
		3559 -> 3561;
	3560 [label="A *noi*. Non sono del tutto sicuro che non parlino con *lei*.",shape=box,color=blue];
		3560 -> 3561;
	3561 [label="So che parlano alla chitarra. E non voglio pensare a questo fatto più del necessario.",shape=box,color=blue];
		3561 -> 3562;
	3562 [label="Ma dovremmo preoccuparci della loro... diffusione? Sembrano effettivamente in grado di moltiplicarsi.",shape=box,color=blue];
		3562 -> 3563;
	3563 [label="Cosa che non comprendo. Né voglio soffermarmi troppo sulla provenienza delle loro munizioni. O da cosa siano composte in primo luogo.",shape=box,color=blue];
		3563 -> 3564;
		3563 -> 3565;
	3564 [label="Almeno queste cose Infested sono dalla nostra parte?",shape=box,color=red];
		3564 -> 3566;
	3565 [label="Forse sarebbe meglio che ti limitassi alle armi normali.",shape=box,color=red];
		3565 -> 3567;
	3566 [label="Certo. Per *ora.*",shape=box,color=blue];
		3566 -> 3568;
	3567 [label="Penso proprio che lo farò.",shape=box,color=blue];
		3567 -> 3568;
	3568 [label="Almeno sono sicuro che se l'arma mi fa un buco nel piede è perché l'idiota sono io.",shape=box,color=blue];
		3568 -> 3569;
	3569 [label="E non perché la mia pistola ha deciso di riconsiderare la sua lealtà o è stata colta da un attacco di fame notturna.",shape=box,color=blue];
		3569 -> 3570;
	3570 [label="Chat ends.",color=orange];
}