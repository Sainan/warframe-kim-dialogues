		"ArthurRank6Convo10 begins." -> j1744835921;
	j4189105860 [label="Ehi Arthur. Come va?",shape=box,color=red];
		j4189105860 -> j576947393;
	j1744835921 [label="Che piani hai per oggi?",shape=box,color=red];
		j1744835921 -> j1316961894;
	j576947393 [label="Ho preso la folle decisione di giocare contro Amir in Ollie's Crash Course.",shape=box,color=blue];
		j576947393 -> j3871891874;
	j1316961894 [label="Io e Quincy stiamo per andare in ricognizione insieme. Un'idea sua, non mia.",shape=box,color=blue];
		j1316961894 -> j4150939406;
	j3871891874 [label="E ora sono profondamente infastidito dal fatto che continui a battere il mio punteggio migliore.",shape=box,color=blue];
		j3871891874 -> j2223349826;
	j4150939406 [label="È strano, il nostro rapporto dico. Non parliamo molto.",shape=box,color=blue];
		j4150939406 -> j3300744385;
	j2223349826 [label="... Ho trascorso ventisei ore negli ultimi due giorni a giocare a questo gioco.",shape=box,color=blue];
		j2223349826 -> j4083378356;
	j3300744385 [label="Ma sappiamo entrambi che moriremmo l'uno per l'altro se fosse necessario.",shape=box,color=blue];
		j3300744385 -> j3030359490;
	j4083378356 [label="Per favore, dì a Lettie di darmi un tranquillizzante se mi dovessi avvicinare di nuovo a quella dannata cosa.",shape=box,color=blue];
		j4083378356 -> "Chat ends.";
	j3030359490 [label="Penso che a volte la famiglia sia proprio questo, no?",shape=box,color=blue];
		j3030359490 -> "Chat ends.";
	"Chat ends." [color=orange];
}