		j2698026875 -> j424839991;
	j2731811130 [label="Non mi stupirebbe sapere che ci sono due versioni di me qui in giro, ma... Beh. Comunque. Lunga storia.",shape=box,color=red];
		j2731811130 -> j1361235690;
	j3142478978 [label="Dipende da cosa hanno detto. Ma probabilmente.",shape=box,color=red];
		j3142478978 -> j2979078817;
