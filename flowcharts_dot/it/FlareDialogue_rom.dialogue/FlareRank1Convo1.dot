	j799679285 [label="ehi, viaggiatore spaziale",shape=box,color=blue];
		j799679285 -> j2259347218;
		j799679285 -> j3517771737;
	j2259347218 [label="Oh, ciao. Flare, giusto?",shape=box,color=red];
