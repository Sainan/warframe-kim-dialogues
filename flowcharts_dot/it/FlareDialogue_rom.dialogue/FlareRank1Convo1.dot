		j2614348175 -> j2430073212;
	j3326181396 [label="mi... mi scuso. di solito non mi piace comportarmi in questo modo. tuttavia, mi trovo in una situazione che è... molto difficile da descrivere",shape=box,color=blue];
		j3326181396 -> j3051764735;
	j427077496 [label="non si tratta del fatto di voler delle risposte, caro viaggiatore spaziale. si tratta del fatto di aver *bisogno* di risposte",shape=box,color=blue];
		j427077496 -> j179047236;
