	j282704996 [label="supponiamo che sia possibile per questa discussione",shape=box,color=blue];
		j282704996 -> j52047021;
	j52047021 [label="ma da quello che ho potuto capire dagli altri affascinanti fenomeni...",shape=box,color=blue];
		j52047021 -> j207179193;
	j207179193 [label="c'è un posto in cui l'Infestazione *non c'è*",shape=box,color=blue];
		j207179193 -> j3905909999;
	j3905909999 [label="un luogo dove potremmo imprigionarla e da dove *non potrebbe* più tornare indietro...",shape=box,color=blue];
		j3905909999 -> j1985331490;
		j3905909999 -> j3913287803;
	j1985331490 [label="Non mi piace proprio dove stai andando a parare, Flare... di cosa stai parlando?",shape=box,color=red];
		j1985331490 -> j2426042524;
	j3913287803 [label="Se parliamo di gettarla nel Void... la risposta è no.",shape=box,color=red];
		j3913287803 -> j2747212345;
	j2426042524 [label="non sto parlando del void",shape=box,color=blue];
		j2426042524 -> j2202631196;
	j2747212345 [label="Non so che tipo di presenza abbia l'Infestazione nel Void, e non ho intenzione di peggiorare la situazione.",shape=box,color=red];
		j2747212345 -> j2426042524;
	j2202631196 [label="sto parlando di duviri",shape=box,color=blue];
		j2202631196 -> j4186116017;
		j2202631196 -> j2730575338;
		j2202631196 -> j2445299128;
	j4186116017 [label="Immagino che questo *potrebbe* dare una lezione a Thrax...",shape=box,color=red];
