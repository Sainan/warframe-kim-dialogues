		j725352307 -> j2335927607;
		j725352307 -> j849755952;
	j1515981581 [label="Forse. Forse no.",shape=box,color=red];
		j1515981581 -> j740343702;
		j1515981581 -> j2335927607;
		j1515981581 -> j849755952;
	j3429095198 [label="Stai semplificando troppo la situazione. Duviri era - ed *è* - molto più di un semplice \"luogo\".",shape=box,color=red];
		j3429095198 -> j740343702;
		j3429095198 -> j2335927607;
		j3429095198 -> j849755952;
	j3069604766 [label="e mi hanno raccontato tutto del piccolo, strano mondo selvaggio in cui vivevi",shape=box,color=blue];
		j3069604766 -> j1149117906;
	j740343702 [label="Non l'hai mai visto. Non ci hai trascorso secoli. Non ci hai vissuto e non ci hai trovato la morte.",shape=box,color=red];
		j740343702 -> j2295019855;
		j740343702 -> j532691357;
		j740343702 -> j2118100852;
	j2335927607 [label="Arrivi al dunque, Flare? Quel posto è... tanto un riflesso di me, quanto lo è il libro di fiabe su cui è basato.",shape=box,color=red];
		j2335927607 -> j2295019855;
		j2335927607 -> j532691357;
		j2335927607 -> j2118100852;
	j849755952 [label="Anche se i miei sentimenti a riguardo non sono esattamente... rosei... non posso certo buttarci dentro l'Infestazione e andarmene.",shape=box,color=red];
		j849755952 -> j2295019855;
		j849755952 -> j2118100852;
		j849755952 -> j532691357;
	j2295019855 [label="E per quanto a volte mi piaccia tornare lì e prendere ripetutamente a pugni in faccia la gente... Non è il mio tritarifiuti.",shape=box,color=red];
		j2295019855 -> j118090667;
	j532691357 [label="Che mi piaccia o no... In qualche modo, stupidamente, sono la persona responsabile per quel luogo.",shape=box,color=red];
		j532691357 -> j2860801097;
	j2118100852 [label="Ne conservo tanti ricordi piacevoli quanti dolorosi.",shape=box,color=red];
		j2118100852 -> j4164866419;
	j118090667 [label="Quindi non è nemmeno il tuo tritarifiuti.",shape=box,color=red];
		j118090667 -> j3860616999;
		j118090667 -> j2128542871;
		j118090667 -> j4243545395;
	j2860801097 [label="Quindi devo essere lì per proteggerlo quando è in pericolo.",shape=box,color=red];
		j2860801097 -> j4243545395;
		j2860801097 -> j2128542871;
		j2860801097 -> j3860616999;
	j4164866419 [label="E solo perché volevo liberarmene, non significa che voglio che soffra.",shape=box,color=red];
