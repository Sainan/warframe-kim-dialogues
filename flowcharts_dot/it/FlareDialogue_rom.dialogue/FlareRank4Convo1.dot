	j2730575338 [label="COSA. NO! Assolutamente no!",shape=box,color=red];
		j2730575338 -> j1149117906;
	j2445299128 [label="Io - come fai a sapere di Duviri?!",shape=box,color=red];
		j2445299128 -> j2808627154;
	j1149117906 [label="sembra che non gli devi alcun favore dopo quello che ti ha fatto",shape=box,color=blue];
		j1149117906 -> j725352307;
		j1149117906 -> j1515981581;
		j1149117906 -> j3429095198;
	j2808627154 [label="posso *parlare* con gli altri protoframe, sai",shape=box,color=blue];
		j2808627154 -> j3069604766;
	j725352307 [label="Chi ti dà il diritto di dirmi che dovrei mandare tutto al diavolo?",shape=box,color=red];
