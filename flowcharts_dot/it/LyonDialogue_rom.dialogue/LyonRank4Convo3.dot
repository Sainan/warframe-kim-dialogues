	950 [label="Un concetto del genere non mi è poi così estraneo come potresti pensare. In effetti, non è tanto il concetto di sé a farmi dubitare, quanto le parti coinvolte - senza offesa.",shape=box,color=blue];
		950 -> 955;
	944 [label="Update boolean LyonVisions3",color=orange];
		944 -> 951;
	945 [label="È troppo da sopportare per la maggior parte delle persone. E ti ringrazio per continuare a impegnarti in questo senso. Questo è tutto.",shape=box,color=blue];
		945 -> 952;
