		929 -> 939;
	930 [label="Certo. Quando sarai pronto, Lyon.",shape=box,color=red];
		930 -> 940;
	941 [label="Sono certo che ci sono altri che troverebbero sollievo tra le braccia impazienti di un altro in circostanze come queste, ma io non sono una di quelle fortunate anime.",shape=box,color=blue];
		941 -> 948;
	942 [label="+20 Chemistry",color=orange];
		942 -> 949;
	943 [label="Provo dei sentimenti per te. Ma provo anche dei sentimenti per loro. E per me, sono entrambi veri.",shape=box,color=red];
