		"LyonRank4Convo3 begins." -> j809990421;
		"LyonRank4Convo3 begins." -> j4115718638;
	j1026175428 [label="Come ti trovi con i Cavia?",shape=box,color=red];
		j1026175428 -> j3562249214;
	j809990421 [label="Cosa pensi di Loid?",shape=box,color=red];
		j809990421 -> j768254570;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j3562249214 [label="Mi piace molto ascoltare le loro chiacchere, anche se, come puoi immaginare, non vi prendo parte. Ho poco da aggiungere al loro discorso.",shape=box,color=blue];
		j3562249214 -> j2471395694;
	j768254570 [label="Lo trovo molto gradevole. Anzi, tra i miei nuovi... compagni, è quello che mi attrae di più in compagnia.",shape=box,color=blue];
		j768254570 -> j1769067782;
	"Chat ends." [color=orange];
	j2471395694 [label="Mi preoccupa però quando trovo Roathe in piedi a conversare a lungo con Bird 3. Non capisco cosa intenda ottenere con questo gesto.",shape=box,color=blue];
		j2471395694 -> j2507757158;
	j1769067782 [label="Anche se probabilmente non sorprenderà nessuno, immagino. A prima vista, abbiamo un carattere molto simile.",shape=box,color=blue];
		j1769067782 -> j402585854;
	j2507757158 [label="Boolean LyonRoatheCavia1 is now true.",color=orange];
		j2507757158 -> j217743801;
		j2507757158 -> j61063342;
	j402585854 [label="È il giovane Operatore che trovo più strano... e quella che chiamano Lotus. E come veniamo tenuti a distanza da loro.",shape=box,color=blue];
		j402585854 -> j3378333323;
	j217743801 [label="Mh. Glielo chiederò.",shape=box,color=red];
		j217743801 -> j465944118;
	j61063342 [label="Perché pensi stia cercando qualcosa?",shape=box,color=red];
		j61063342 -> j391491562;
	j3378333323 [label="Ci è permesso interagire, certo. Ma non in questo modo. Non qui. Perché?",shape=box,color=blue];
		j3378333323 -> j2639476616;
		j3378333323 -> j1699718199;
	j465944118 [label="Forse è saggio. Non vorrei vederlo manipolare quelle creature per trasformale in oggetti d'uso più di quanto non lo siano già.",shape=box,color=blue];
		j465944118 -> j402585854;
	j391491562 [label="Roathe ha sempre un motivo in mente quando conversa con qualcuno. Non vorrei vederlo manipolare quelle creature per trasformarle in oggetti d'uso più di quanto non lo siano già.",shape=box,color=blue];
		j391491562 -> j4157580599;
	j2639476616 [label="Il ragazzino... sta attraversando delle assurdità. Non possiamo chiedergli di più. Non è giusto.",shape=box,color=red];
		j2639476616 -> j4226657036;
	j1699718199 [label="Io... immagino sia perché ho \"esperienza precedente\" con i protoframe?",shape=box,color=red];
		j1699718199 -> j3260070664;
	j4157580599 [label="Potrebbe valere la pena di indagare, se hai tempo. Anche se questa è una tua prerogativa.",shape=box,color=blue];
		j4157580599 -> j402585854;
	j4226657036 [label="Sì. Ho sentito sussurri di ciò che sono stati costretti a sopportare. Storie di guerra e... amicizie apezzate, dilaniate.",shape=box,color=blue];
		j4226657036 -> j4124678800;
	j3260070664 [label="Check boolean IsDating",color=orange];
		j3260070664 -> j95537859 [label=true,color=green];
		j3260070664 -> j3271496463 [label=false,color=brown];
	j4124678800 [label="Mi strazia il cuore vedere cosa viene disturtto in un atto di guerra. Ancora più estraneo, mi è ciò che può essere creato.",shape=box,color=blue];
		j4124678800 -> j3271496463;
	j95537859 [label="Mh. È così che lo chiamano adesso? \"Esperienza precedente?\" Davvero di buon gusto. Anche se Entrati sembra aver combinato un bel pasticcio, sono contento che tu abbia... trovato un modo per divertirti.",shape=box,color=blue];
		j95537859 -> j3845173445;
		j95537859 -> j363441273;
		j95537859 -> j2951098278;
	j3271496463 [label="M. Loid mi ha raccontato della vostra \"disavventura\" nell'Höllvania del vostro passato, del nostro futuro. Entrati ha sicuramente combinato un bel pasticcio.",shape=box,color=blue];
		j3271496463 -> j396566624;
		j3271496463 -> j2895202418;
	j3845173445 [label="Ho fatto qualcosa di sbagliato?",shape=box,color=red];
		j3845173445 -> j3487893497;
	j363441273 [label="Fai attenzione, o potrei pensare che ti stai chiedendo se l'erba del vicino non sia un po' più verde, Sacerdote.",shape=box,color=red];
		j363441273 -> j619519124;
	j2951098278 [label="Sembra che sia solo una scappatella, Lyon. Non insultarmi in questo modo.",shape=box,color=red];
		j2951098278 -> j1331458418;
	j396566624 [label="Credimi, poteva andare molto peggio.",shape=box,color=red];
		j396566624 -> j468358547;
	j2895202418 [label="Sono miei cari amici, quei protoframe. Sono diventati come una famiglia per me.",shape=box,color=red];
		j2895202418 -> j1325398836;
	j3487893497 [label="Check boolean LyonFirstFlirt",color=orange];
		j3487893497 -> j4168305312 [label=true,color=green];
		j3487893497 -> j2601999073 [label=false,color=brown];
	j619519124 [label="Check boolean LyonFirstFlirt",color=orange];
		j619519124 -> j4168305312 [label=true,color=green];
		j619519124 -> j1187391435 [label=false,color=brown];
	j1331458418 [label="Check boolean LyonFirstFlirt",color=orange];
		j1331458418 -> j4168305312 [label=true,color=green];
		j1331458418 -> j3902839132 [label=false,color=brown];
	j468358547 [label="E sono certo che tutto questo sia frutto del grandioso e magistrale piano di Entrati. Affidare il destino del futuro a te e a una banda di disadattati.",shape=box,color=blue];
		j468358547 -> j3649478645;
	j1325398836 [label="I miei nonni si sono conosciuti durante la Rivoluzione Gaullique. Guerra e morte sono sempre stati alleati che hanno dato vita a una danza di cameratismo nei modi più strani.",shape=box,color=blue];
		j1325398836 -> j3628502303;
	j4168305312 [label="Perdonami. Mi sembra solo che l'ultima volta che abbiamo discusso di questa questione, tu... ",shape=box,color=blue];
		j4168305312 -> j59916300;
	j2601999073 [label="Perdonami. Non conosco il tuo cuore né quello degli altri. Ciò che fai nel tuo tempo libero con gli altri sono affari tuoi.",shape=box,color=blue];
		j2601999073 -> j3652806699;
		j2601999073 -> j3932014346;
	j1187391435 [label="Perdonami. No, hai ragione. Non voglio sembrare geloso o come se mi atteggiassi a provocatore. Quello che fai nel tuo tempo libero con gli altri sono affari tuoi.",shape=box,color=blue];
		j1187391435 -> j3652806699;
		j1187391435 -> j3932014346;
	j3902839132 [label="Certo. Perdonami. Non conosco il tuo cuore né quello degli altri. Ciò che fai nel tuo tempo libero con gli altri sono affari tuoi.",shape=box,color=blue];
		j3902839132 -> j3652806699;
		j3902839132 -> j3932014346;
	j3649478645 [label="Io... Drifter - So di non essere la persona più... affabile con cui sei costretto a interagire, e per questo continuo a scusarmi.",shape=box,color=blue];
		j3649478645 -> j3082927046;
	j3628502303 [label="Boolean LyonBackstory2 is now true.",color=orange];
		j3628502303 -> j2621265208;
		j3628502303 -> j571602495;
	j59916300 [label="Non importa... non dovrei soprendermi quando i cuori sono volubili e mutevoli. Soprattutto quando ci sono coinvolto io.",shape=box,color=blue];
		j59916300 -> j2985848586;
		j59916300 -> j399905831;
	j3652806699 [label="Ne abbiamo passate... tante con loro. Tende a unire le persone.",shape=box,color=red];
		j3652806699 -> j1592100266;
	j3932014346 [label="[Confessa i tuoi Sentimenti.] Onestamente, ho cercato di capire come affrontare questo argomento con te a un certo punto.",shape=box,color=red];
		j3932014346 -> j1626530140;
	j3082927046 [label="Sono semplicemente fatto così, e non so come cambiare. In effetti, non credo di essere in grado di riparare il danno inflitto alla mia anima dai dannati che sono venuti a perseguitarmi.",shape=box,color=blue];
		j3082927046 -> j1093040610;
	j2621265208 [label="Sembra proprio che sia così, ovunque nel corso della storia.",shape=box,color=red];
		j2621265208 -> j3383854795;
	j571602495 [label="Mi piacerebbe sapere di più sulla tua famiglia.",shape=box,color=red];
		j571602495 -> j2793823056;
	j2985848586 [label="Aspetta. Ti stai facendo un'idea sbagliata. Non ti ho ingannato. Le cose sono solo - beh, complicate.",shape=box,color=red];
		j2985848586 -> j3738818715;
	j399905831 [label="Ho pensato che non fossi interessato a me.",shape=box,color=red];
		j399905831 -> j2239933613;
	j1592100266 [label="I miei nonni si sono conosciuti durante la Rivoluzione Gaullique. Guerra e morte sono sempre compagni in una danza che porta alla passione e all'amore nei modi più strani.",shape=box,color=blue];
		j1592100266 -> j3628502303;
	j1626530140 [label="E ora sono profondamente nervoso... Oserei chiedere perché?",shape=box,color=blue];
		j1626530140 -> j2885199744;
		j1626530140 -> j2596642526;
	j1093040610 [label="Ciò che si nasconde sotto questa superficie di vetro fratturato è...",shape=box,color=blue];
		j1093040610 -> j2132671005;
		j1093040610 -> j2505364768;
	j3383854795 [label="In effetti. Immagino che non dovrei provare risentimento per gli aspetti positivi che potrebbero derivare dall'oscurità e delle distruzioni della guerra.",shape=box,color=blue];
		j3383854795 -> j3715446652;
		j3383854795 -> j253609154;
	j2793823056 [label="Non è una storia che mi piace raccontare. A nessuno. Quindi mi perdonerai se non sono troppo ansioso di condividerla. Magari un'altra volta.",shape=box,color=blue];
		j2793823056 -> j397735550;
		j2793823056 -> j2747898535;
	j3738818715 [label="Per favore continua.",shape=box,color=blue];
		j3738818715 -> j2885199744;
		j3738818715 -> j2596642526;
	j2239933613 [label="Con tutto il rispetto, non ti conosco. E con tutto il resto che mi sono caricato addosso, un'avventura romantica con uno sconosciuto di certo non è la mia priorità.",shape=box,color=blue];
		j2239933613 -> j2307405020;
	j2885199744 [label="Io - ci riproveremo un'altra volta, mi dispiace. ",shape=box,color=red];
		j2885199744 -> j1933110400;
	j2596642526 [label="Non so se per te è facile capirlo o se ti sembra una follia, ma io... riesco a provare questa forte sensazione per più di una persona contemporaneamente.",shape=box,color=red];
		j2596642526 -> j1017581863;
	j2132671005 [label="Va tutto bene Lyon. Ci arriveremo. Non ho fretta, credimi.",shape=box,color=red];
		j2132671005 -> j3145788101;
	j2505364768 [label="È cosa?",shape=box,color=red];
		j2505364768 -> j2410485910;
	j3715446652 [label="Cosa intendi?",shape=box,color=red];
		j3715446652 -> j2876431593;
	j253609154 [label="Ne risenti?",shape=box,color=red];
		j253609154 -> j2733430205;
	j397735550 [label="Sarò qui.",shape=box,color=red];
		j397735550 -> j1874104637;
	j2747898535 [label="Certo. Quando sarai pronto, Lyon.",shape=box,color=red];
		j2747898535 -> j2640283320;
	j2307405020 [label="Sono certo che ci sono altri che troverebbero sollievo tra le braccia impazienti di un altro in circostanze come queste, ma io non sono una di quelle fortunate anime.",shape=box,color=blue];
		j2307405020 -> j3697893578;
	j1933110400 [label="+20 Chemistry",color=orange];
		j1933110400 -> j1814800337;
	j1017581863 [label="Provo dei sentimenti per te. Ma provo anche dei sentimenti per loro. E per me, sono entrambi veri.",shape=box,color=red];
		j1017581863 -> j3723213886;
	j3145788101 [label="+20 Chemistry",color=orange];
		j3145788101 -> j1193718515;
	j2410485910 [label="+10 Chemistry",color=orange];
		j2410485910 -> j2610104439;
	j2876431593 [label="Perdonami. Non è una storia che mi piace raccontare. A nessuno. Quindi mi perdonerai se non sono troppo ansioso di condividerla. Magari un'altra volta.",shape=box,color=blue];
		j2876431593 -> j397735550;
		j2876431593 -> j2747898535;
	j2733430205 [label="Non l'esistenza dell'amore - forse la sua assenza nella mia vita familiare. Perdonami. Non è una storia che mi piace raccontare. A nessuno. Quindi mi perdonerai se non sono troppo ansioso di condividerla. Magari un'altra volta.",shape=box,color=blue];
		j2733430205 -> j397735550;
		j2733430205 -> j2747898535;
	j1874104637 [label="+15 Chemistry",color=orange];
		j1874104637 -> j2656517763;
	j2640283320 [label="+20 Chemistry",color=orange];
		j2640283320 -> j3559525791;
	j3697893578 [label="Forse potresti cercarne uno. Buona giornata.",shape=box,color=blue];
		j3697893578 -> j2895678923;
	j1814800337 [label="Molto bene. Potremmo parlarne un'altra volta, se preferisci. Nel frattempo, tornerò ai miei doveri.",shape=box,color=blue];
		j1814800337 -> j2895678923;
	j3723213886 [label="Un concetto del genere non mi è poi così estraneo come potresti pensare. In effetti, non è tanto il concetto di sé a farmi dubitare, quanto le parti coinvolte - senza offesa.",shape=box,color=blue];
		j3723213886 -> j2885951667;
	j1193718515 [label="Boolean LyonVisions3 is now true.",color=orange];
		j1193718515 -> j3893203414;
	j2610104439 [label="È troppo da sopportare per la maggior parte delle persone. E ti ringrazio per continuare a impegnarti in questo senso. Questo è tutto.",shape=box,color=blue];
		j2610104439 -> j2895678923;
	j2656517763 [label="Sì, sto arrivando a questa inevitabile conclusione. Buona giornata.",shape=box,color=blue];
		j2656517763 -> j2895678923;
	j3559525791 [label="Grazie. A presto, ti auguro una buona giornata.",shape=box,color=blue];
		j3559525791 -> j2895678923;
	j2895678923 [label="-P. Lyon Allard",shape=box,color=blue];
		j2895678923 -> "Chat ends.";
	j2885951667 [label="E forse quanto vicina alla nostra nuova \"casa\" vuole volare la tua freccia.",shape=box,color=blue];
		j2885951667 -> j426937810;
		j2885951667 -> j3401570134;
	j3893203414 [label="Grazie...",shape=box,color=blue];
		j3893203414 -> j2895678923;
	j426937810 [label="Per essere onesti, non intendevo \"ora\". Mi stavo solo spiegando.",shape=box,color=red];
		j426937810 -> j3489246600;
	j3401570134 [label="Quindi... quello che stai dicendo è... che c'è una possibilità?",shape=box,color=red];
		j3401570134 -> j2972262060;
	j3489246600 [label="+20 Chemistry",color=orange];
		j3489246600 -> j1654611720;
	j2972262060 [label="+20 Chemistry",color=orange];
		j2972262060 -> j1009743273;
	j1654611720 [label="Sì, beh... Se a quel punto avrò deciso che non ti detesto più, forse allora riapriremo la discussione.",shape=box,color=blue];
		j1654611720 -> j2835740024;
	j1009743273 [label="Sì... forse. Se avrò deciso che non ti detesto più quando arriveremo a quel punto. E questo resta davvero da vedere, Drifter.",shape=box,color=blue];
		j1009743273 -> j2835740024;
	j2835740024 [label="Fino ad allora, devo riprendere i miei doveri per oggi. Apprezzo questa... conversazione interessante. Credo.",shape=box,color=blue];
		j2835740024 -> j482579815;
	j482579815 [label="Boolean DrifterLyon is now true.",color=orange];
		j482579815 -> j971726948;
