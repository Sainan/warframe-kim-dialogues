	937 [label="Perdonami. Non è una storia che mi piace raccontare. A nessuno. Quindi mi perdonerai se non sono troppo ansioso di condividerla. Magari un'altra volta.",shape=box,color=blue];
		937 -> 929;
		937 -> 930;
	938 [label="Non l'esistenza dell'amore - forse la sua assenza nella mia vita familiare. Perdonami. Non è una storia che mi piace raccontare. A nessuno. Quindi mi perdonerai se non sono troppo ansioso di condividerla. Magari un'altra volta.",shape=box,color=blue];
		938 -> 929;
