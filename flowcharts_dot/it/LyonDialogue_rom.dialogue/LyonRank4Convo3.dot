		905 -> 911 [label=false,color=brown];
	901 [label="E sono certo che tutto questo sia frutto del grandioso e magistrale piano di Entrati. Affidare il destino del futuro a te e a una banda di disadattati.",shape=box,color=blue];
		901 -> 906;
	902 [label="I miei nonni si sono conosciuti durante la Rivoluzione Gaullique. Guerra e morte sono sempre stati alleati che hanno dato vita a una danza di cameratismo nei modi più strani.",shape=box,color=blue];
		902 -> 907;
	908 [label="Perdonami. Mi sembra solo che l'ultima volta che abbiamo discusso di questa questione, tu... ",shape=box,color=blue];
		908 -> 915;
	909 [label="Perdonami. Non conosco il tuo cuore né quello degli altri. Ciò che fai nel tuo tempo libero con gli altri sono affari tuoi.",shape=box,color=blue];
		909 -> 916;
		909 -> 917;
	910 [label="Perdonami. No, hai ragione. Non voglio sembrare geloso o come se mi atteggiassi a provocatore. Quello che fai nel tuo tempo libero con gli altri sono affari tuoi.",shape=box,color=blue];
		910 -> 916;
		910 -> 917;
	911 [label="Certo. Perdonami. Non conosco il tuo cuore né quello degli altri. Ciò che fai nel tuo tempo libero con gli altri sono affari tuoi.",shape=box,color=blue];
		911 -> 916;
		911 -> 917;
	906 [label="Io... Drifter - So di non essere la persona più... affabile con cui sei costretto a interagire, e per questo continuo a scusarmi.",shape=box,color=blue];
		906 -> 912;
	907 [label="Update boolean LyonBackstory2",color=orange];
		907 -> 913;
		907 -> 914;
	915 [label="Non importa... non dovrei soprendermi quando i cuori sono volubili e mutevoli. Soprattutto quando ci sono coinvolto io.",shape=box,color=blue];
		915 -> 921;
		915 -> 922;
	916 [label="Ne abbiamo passate... tante con loro. Tende a unire le persone.",shape=box,color=red];
		916 -> 923;
	917 [label="[Confessa i tuoi Sentimenti.] Onestamente, ho cercato di capire come affrontare questo argomento con te a un certo punto.",shape=box,color=red];
		917 -> 924;
	912 [label="Sono semplicemente fatto così, e non so come cambiare. In effetti, non credo di essere in grado di riparare il danno inflitto alla mia anima dai dannati che sono venuti a perseguitarmi.",shape=box,color=blue];
		912 -> 918;
	913 [label="Sembra proprio che sia così, ovunque nel corso della storia.",shape=box,color=red];
		913 -> 919;
	914 [label="Mi piacerebbe sapere di più sulla tua famiglia.",shape=box,color=red];
		914 -> 920;
	921 [label="Aspetta. Ti stai facendo un'idea sbagliata. Non ti ho ingannato. Le cose sono solo - beh, complicate.",shape=box,color=red];
		921 -> 931;
	922 [label="Ho pensato che non fossi interessato a me.",shape=box,color=red];
		922 -> 932;
	923 [label="I miei nonni si sono conosciuti durante la Rivoluzione Gaullique. Guerra e morte sono sempre compagni in una danza che porta alla passione e all'amore nei modi più strani.",shape=box,color=blue];
		923 -> 907;
	924 [label="E ora sono profondamente nervoso... Oserei chiedere perché?",shape=box,color=blue];
		924 -> 933;
		924 -> 934;
	918 [label="Ciò che si nasconde sotto questa superficie di vetro fratturato è...",shape=box,color=blue];
		918 -> 925;
		918 -> 926;
	919 [label="In effetti. Immagino che non dovrei provare risentimento per gli aspetti positivi che potrebbero derivare dall'oscurità e delle distruzioni della guerra.",shape=box,color=blue];
		919 -> 927;
		919 -> 928;
	920 [label="Non è una storia che mi piace raccontare. A nessuno. Quindi mi perdonerai se non sono troppo ansioso di condividerla. Magari un'altra volta.",shape=box,color=blue];
		920 -> 929;
		920 -> 930;
	931 [label="Per favore continua.",shape=box,color=blue];
		931 -> 933;
		931 -> 934;
	932 [label="Con tutto il rispetto, non ti conosco. E con tutto il resto che mi sono caricato addosso, un'avventura romantica con uno sconosciuto di certo non è la mia priorità.",shape=box,color=blue];
		932 -> 941;
	933 [label="Io - ci riproveremo un'altra volta, mi dispiace. ",shape=box,color=red];
		933 -> 942;
	934 [label="Non so se per te è facile capirlo o se ti sembra una follia, ma io... riesco a provare questa forte sensazione per più di una persona contemporaneamente.",shape=box,color=red];
		934 -> 943;
	925 [label="Va tutto bene Lyon. Ci arriveremo. Non ho fretta, credimi.",shape=box,color=red];
