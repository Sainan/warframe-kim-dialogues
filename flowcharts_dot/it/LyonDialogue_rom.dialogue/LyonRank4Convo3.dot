	874 [label="[Fine.]",shape=box,color=red];
		874 -> 877;
	875 [label="Mi piace molto ascoltare le loro chiacchere, anche se, come puoi immaginare, non vi prendo parte. Ho poco da aggiungere al loro discorso.",shape=box,color=blue];
		875 -> 878;
	876 [label="Lo trovo molto gradevole. Anzi, tra i miei nuovi... compagni, è quello che mi attrae di più in compagnia.",shape=box,color=blue];
		876 -> 879;
	877 [label="Chat ends.",color=orange];
	878 [label="Mi preoccupa però quando trovo Roathe in piedi a conversare a lungo con Bird 3. Non capisco cosa intenda ottenere con questo gesto.",shape=box,color=blue];
		878 -> 880;
	879 [label="Anche se probabilmente non sorprenderà nessuno, immagino. A prima vista, abbiamo un carattere molto simile.",shape=box,color=blue];
		879 -> 881;
	880 [label="Update boolean LyonRoatheCavia1",color=orange];
		880 -> 882;
		880 -> 883;
	881 [label="È il giovane Operatore che trovo più strano... e quella che chiamano Lotus. E come veniamo tenuti a distanza da loro.",shape=box,color=blue];
		881 -> 884;
	882 [label="Mh. Glielo chiederò.",shape=box,color=red];
		882 -> 885;
	883 [label="Perché pensi stia cercando qualcosa?",shape=box,color=red];
		883 -> 886;
	884 [label="Ci è permesso interagire, certo. Ma non in questo modo. Non qui. Perché?",shape=box,color=blue];
		884 -> 887;
		884 -> 888;
	885 [label="Forse è saggio. Non vorrei vederlo manipolare quelle creature per trasformale in oggetti d'uso più di quanto non lo siano già.",shape=box,color=blue];
		885 -> 881;
	886 [label="Roathe ha sempre un motivo in mente quando conversa con qualcuno. Non vorrei vederlo manipolare quelle creature per trasformarle in oggetti d'uso più di quanto non lo siano già.",shape=box,color=blue];
		886 -> 889;
	887 [label="Il ragazzino... sta attraversando delle assurdità. Non possiamo chiedergli di più. Non è giusto.",shape=box,color=red];
		887 -> 890;
	888 [label="Io... immagino sia perché ho \"esperienza precedente\" con i protoframe?",shape=box,color=red];
		888 -> 891;
	889 [label="Potrebbe valere la pena di indagare, se hai tempo. Anche se questa è una tua prerogativa.",shape=box,color=blue];
		889 -> 881;
	890 [label="Sì. Ho sentito sussurri di ciò che sono stati costretti a sopportare. Storie di guerra e... amicizie apezzate, dilaniate.",shape=box,color=blue];
		890 -> 892;
	891 [label="Check boolean IsDating",color=orange];
		891 -> 894 [label=true,color=green];
		891 -> 893 [label=false,color=brown];
	892 [label="Mi strazia il cuore vedere cosa viene disturtto in un atto di guerra. Ancora più estraneo, mi è ciò che può essere creato.",shape=box,color=blue];
		892 -> 895;
	894 [label="Mh. È così che lo chiamano adesso? \"Esperienza precedente?\" Davvero di buon gusto. Anche se Entrati sembra aver combinato un bel pasticcio, sono contento che tu abbia... trovato un modo per divertirti.",shape=box,color=blue];
		894 -> 898;
		894 -> 899;
		894 -> 900;
	893 [label="M. Loid mi ha raccontato della vostra \"disavventura\" nell'Höllvania del vostro passato, del nostro futuro. Entrati ha sicuramente combinato un bel pasticcio.",shape=box,color=blue];
		893 -> 896;
		893 -> 897;
	895 [label="M. Loid mi ha raccontato della vostra \"disavventura\" nell'Höllvania del vostro passato, del nostro futuro. Entrati ha sicuramente combinato un bel pasticcio.",shape=box,color=blue];
		895 -> 896;
		895 -> 897;
	898 [label="Ho fatto qualcosa di sbagliato?",shape=box,color=red];
		898 -> 903;
	899 [label="Fai attenzione, o potrei pensare che ti stai chiedendo se l'erba del vicino non sia un po' più verde, Sacerdote.",shape=box,color=red];
		899 -> 904;
	900 [label="Sembra che sia solo una scappatella, Lyon. Non insultarmi in questo modo.",shape=box,color=red];
		900 -> 905;
	896 [label="Credimi, poteva andare molto peggio.",shape=box,color=red];
		896 -> 901;
	897 [label="Sono miei cari amici, quei protoframe. Sono diventati come una famiglia per me.",shape=box,color=red];
