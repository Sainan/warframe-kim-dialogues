digraph {
	"LyonRank3Convo3 begins." [color=orange];
		"LyonRank3Convo3 begins." -> j1338340562;
	j1338340562 [label="Stavo aiutando M. Loid nella sua biblioteca, rimettendo a posto i libri sugli scaffali, anche se lui insisteva che... avrebbero potuto farlo quegli strani congegni volanti -",shape=box,color=blue];
		j1338340562 -> j1398344368;
	j1398344368 [label="E mi sono imbattuto in un curioso volume che raccontava storie per bambini, ambientate in un mondo immaginario, scritte da una certa Euleria Entrati.",shape=box,color=blue];
		j1398344368 -> j3757704511;
	j3757704511 [label="Notando che l'autore condivideva il cognome con il vero nome del nostro 'Cardinal Dimanche', ho subito messo da parte la copia.",shape=box,color=blue];
		j3757704511 -> j1945960973;
		j3757704511 -> j2180898670;
		j3757704511 -> j4060732423;
	j1945960973 [label="Credo di sapere a quale libro stai facendo riferimento...",shape=box,color=red];
		j1945960973 -> j3787001017;
	j2180898670 [label="Possiamo saltare il preambolo, per cortesia? Chiedimi quello che vuoi sapere.",shape=box,color=red];
		j2180898670 -> j48864931;
	j4060732423 [label="[Ignora.]",shape=box,color=red];
		j4060732423 -> "Chat ends.";
	j3787001017 [label="+5 Chemistry",color=orange];
		j3787001017 -> j601737673;
	j48864931 [label="Boolean LyonMITW1 is now true.",color=orange];
		j48864931 -> j2637590795;
	"Chat ends." [color=orange];
	j601737673 [label="A giudicare dall'espressione inorridita che mi ha rivolto M. Loid e dalla sua insistenza nel farmi sostituire immediatamente il libro, 'per non farti arrabbiare', sospetto che tu ne sappia qualcosa, sì.",shape=box,color=blue];
		j601737673 -> j4099549514;
	j2637590795 [label="La mia domanda riguarda la natura dell'Incarnazione Concettuale. Dopo averlo letto, ho capito che il libro aveva lo scopo di insegnare ai bambini a impedire alle proprie emozioni di interagire con il Void.",shape=box,color=blue];
		j2637590795 -> j2789630769;
		j2637590795 -> j3941477113;
	j4099549514 [label="'Le Leggende di Duviri.' Sebbene abbia ricevuto una spiegazione piuttosto... esauriente e sofferta da M. Loid riguardo a ciò che hai sopportato, c'è una questione in particolare su cui vorrei informarmi.",shape=box,color=blue];
		j4099549514 -> j2740860904;
	j2789630769 [label="Per quel poco che ha fatto. Soprattutto nel mio caso.",shape=box,color=red];
		j2789630769 -> j670376251;
	j3941477113 [label="Le emozioni forti che interagiscono con il Void possono causare... seri problemi.",shape=box,color=red];
		j3941477113 -> j3676039908;
	j2740860904 [label="Se, naturalmente, non è troppo problematico farlo?",shape=box,color=blue];
		j2740860904 -> j3679418108;
		j2740860904 -> j2922873877;
	j670376251 [label="Quanta parte della nostra vita ci è stata prescritta da altri come un fatto, solo per poi rivelarsi inutile una volta messa alla prova?",shape=box,color=blue];
		j670376251 -> j1693475017;
	j3676039908 [label="Così sembra. Ho incontrato i Cavia. Mi hanno parlato degli Angeli del Void. Ho visto i Murmur in prima persona. ",shape=box,color=blue];
		j3676039908 -> j518639979;
	j3679418108 [label="No. Procedi.",shape=box,color=red];
		j3679418108 -> j48864931;
	j2922873877 [label="Dipende tutto dai dettagli, suppongo. Non ho idea di cosa stai per chiedermi.",shape=box,color=red];
		j2922873877 -> j2000006004;
	j1693475017 [label="Boolean LyonFaith1 is now true.",color=orange];
		j1693475017 -> j3230115526;
	j518639979 [label="Ed è proprio questa la natura della mia curiosità. Sono arrivato a pormi questa domanda per vedere se potessi spiegarmelo meglio. Quando il Void prende forma, ciò che ne esce - è 'reale'?",shape=box,color=blue];
		j518639979 -> j2494632623;
		j518639979 -> j3103793599;
		j518639979 -> j581367128;
	j2000006004 [label="+5 Chemistry",color=orange];
		j2000006004 -> j185141142;
	j3230115526 [label="Mi chiedo spesso, perché riempire la testa degli altri con bugie così inutili? È forse il potere che cercano? L'influenza? O pensi che credano sinceramente alle loro stesse parole e siamo ignari delle loro stesse falsità?",shape=box,color=blue];
		j3230115526 -> j2319038004;
		j3230115526 -> j158983365;
	j2494632623 [label="No, credo che tutto ciò che è stato creato dal Void sia semplicemente... temporaneo. Un frammento di chiunque o qualunque cosa l'abbia creato. Il fantasma di un ricordo.",shape=box,color=red];
		j2494632623 -> j3154008195;
	j3103793599 [label="Credo di sì. Come un dipinto realizzato da un artista, potrebbe essere uscito dalla mente di qualcuno, ma è reale una volta creato.",shape=box,color=red];
		j3103793599 -> j256392136;
	j581367128 [label="Dipende interamente dalla tua definizione di 'reale'.",shape=box,color=red];
		j581367128 -> j3825565395;
	j185141142 [label="Sì, perdonami. Non sono molto bravo a... essere diretto. Specialmente con un metodo così strano. Ma mi ci impegnerò.",shape=box,color=blue];
		j185141142 -> j48864931;
	j2319038004 [label="In questo caso, credo che Euleria Entrati intendesse scrivere qualcosa di utile. Semplicemente non mi è stato d'aiuto quando ne avevo bisogno.",shape=box,color=red];
		j2319038004 -> j4153394956;
	j158983365 [label="Non lo so. Di quali bugie ti hanno riempito la testa, Lyon?",shape=box,color=red];
		j158983365 -> j1062944328;
	j3154008195 [label="Allora gli effetti causati da tali elementi del Void non sono 'reali'?",shape=box,color=blue];
		j3154008195 -> j154551047;
	j256392136 [label="Ma l'analogia che utilizzi è del tutto accurata, vero? La materia recuperata dal Void ritorna al Void, non è vero?",shape=box,color=blue];
		j256392136 -> j3744443428;
	j3825565395 [label="+5 Chemistry",color=orange];
		j3825565395 -> j4238212252;
	j4153394956 [label="A sua discolpa, devo dire che la mia esposizione al Void, è stata molto più prolungata di quanto lei intendesse utilizzare il libro come guida.",shape=box,color=red];
		j4153394956 -> j2610408763;
	j1062944328 [label="Nessuna di quelle per cui sono venuto a parlarti.",shape=box,color=blue];
		j1062944328 -> "Chat ends.";
	j154551047 [label="Molti ricordi hanno spinto un uomo a bere o a togliersi la vita. Non sono forse 'reali' quei ricordi?",shape=box,color=blue];
		j154551047 -> j1774670904;
	j3744443428 [label="Molto bene, un pensiero, allora. Una poesia o una canzone esistono anche se non sono scritte.",shape=box,color=red];
		j3744443428 -> j745324012;
	j4238212252 [label="Potresti approfondire?",shape=box,color=blue];
		j4238212252 -> j3814300591;
	j2610408763 [label="+5 Chemistry",color=orange];
		j2610408763 -> j2176600546;
	j1774670904 [label="Ma quello che voglio dire è che quelle erano forze interne a cui l'uomo aveva lasciato agire su di sé. Non esterne.",shape=box,color=red];
		j1774670904 -> j4244334205;
	j745324012 [label="Ma se vengono dimenticate, cessano di esistere. Una storia persa nel tempo è persa per sempre.",shape=box,color=blue];
		j745324012 -> j1831735371;
	j3814300591 [label="Come si misura la 'realtà'?",shape=box,color=red];
		j3814300591 -> j1849218945;
		j3814300591 -> j2341690125;
		j3814300591 -> j3814140572;
	j2176600546 [label="La sfortunata ignoranza è la cosa migliore che chiunque di noi possa sperare possa causare la malignità degli altri.",shape=box,color=blue];
		j2176600546 -> j1639299029;
	j4244334205 [label="Ma qual è la differenza, è questa la mia domanda? Se il risultato finale è lo stesso, ha importanza?",shape=box,color=blue];
		j4244334205 -> j1557445781;
		j4244334205 -> j955754879;
		j4244334205 -> j2184313415;
	j1831735371 [label="Una rivoluzione scaturita dalle menti di coloro che la brandiscono è davvero una spada non affilata.",shape=box,color=blue];
		j1831735371 -> j1557445781;
		j1831735371 -> j955754879;
		j1831735371 -> j2184313415;
	j1849218945 [label="Per permanenza fisica? Peso e massa? Ciò che proviene dal Void è qui solo temporaneamente.",shape=box,color=red];
		j1849218945 -> j3317825751;
	j2341690125 [label="Per il suo effetti sugli eventi? Ciò che viene dal Void ha cambiato il corso della storia.",shape=box,color=red];
		j2341690125 -> j297755995;
	j3814140572 [label="Con il suo effetto sugli altri? L'influenza delle 'cose' provenienti dal Void ne ha certamente avuto uno.",shape=box,color=red];
		j3814140572 -> j242095761;
	j1639299029 [label="Una mia curiosità, tuttavia, non riguarda né il libro né la sua utilità. Perdonami se mi lascio andare per un attimo alla poesia.",shape=box,color=blue];
		j1639299029 -> j2160138813;
	j1557445781 [label="Non stai chiedendo se sono 'reali', stai chiedendo se sono 'validi'. Se devono essere respinti o meno.",shape=box,color=red];
		j1557445781 -> j2757223993;
	j955754879 [label="Vorrei anche chiederti se i tuoi Luminari sono 'reali' semplicemente perché non puoi stringere la mano a Sol o Lua.",shape=box,color=red];
		j955754879 -> j351732087;
	j2184313415 [label="Stai chiedendo, in modo indiretto, se tutte le 'cose' provenienti dal Void siano qui solo perché le abbiamo create con la nostrà volontà.",shape=box,color=red];
		j2184313415 -> j4095892663;
	j3317825751 [label="Ciò che proviene dal Void deve ritornarci, è questo che stai dicendo? Ma il Void, per definizione, non è forse composto dal nulla?",shape=box,color=blue];
		j3317825751 -> j2857059668;
	j297755995 [label="Un'osservazione valida. Una rivoluzione non è forse 'reale' semplicemente perché non puoi metterla in un cestino e pesarla?",shape=box,color=blue];
		j297755995 -> j242095761;
	j242095761 [label="Certamente costò la vita a molti. Difenderebbero la sua validità con convinzione. Tuttavia, considera questo:",shape=box,color=blue];
		j242095761 -> j924235616;
	j2160138813 [label="Sono arrivato a pormi questa domanda per vedere se potessi spiegarmelo meglio. Quando il Void prende forma, ciò che ne esce - è 'reale'?",shape=box,color=blue];
		j2160138813 -> j2494632623;
		j2160138813 -> j581367128;
		j2160138813 -> j3103793599;
	j2757223993 [label="+5 Chemistry",color=orange];
		j2757223993 -> j3786559408;
	j351732087 [label="Non stiamo parlando dei Luminari. Stiamo parlando del Void.",shape=box,color=blue];
		j351732087 -> j3306039140;
		j351732087 -> j3551328394;
		j351732087 -> j1948114392;
		j351732087 -> j2833932827;
	j4095892663 [label="+5 Chemistry",color=orange];
		j4095892663 -> j1185078040;
	j2857059668 [label="Suppongo? Le parti del Void con cui ho interagito tendono ad avere già un'impronta. Gli abbiamo già dato una forma o un'immagine. Oppure abbiamo sfumato troppo il confine tra le realtà.",shape=box,color=red];
		j2857059668 -> j188599569;
		j2857059668 -> j4029823569;
	j924235616 [label="Una rivoluzione è valida solo perché esiste nelle menti di coloro che la mettono in atto.",shape=box,color=blue];
		j924235616 -> j3373081183;
	j3786559408 [label="Sì, suppongo si possa dire così. Dovremmo ignorare i fantasmi che infestano i nostri corridoi, o se, prestando loro attenzione, non facciamo altro che renderli più forti?",shape=box,color=blue];
		j3786559408 -> j3306039140;
		j3786559408 -> j3551328394;
		j3786559408 -> j1948114392;
		j3786559408 -> j2833932827;
	j3306039140 [label="Credo che le sfide che ci troviamo ad affrontare in questo momento siano pericolose. Estremamente pericolose. E dovremmo trattarle come tali.",shape=box,color=red];
		j3306039140 -> j2309897492;
	j3551328394 [label="I fantasmi sono abbastanza reali da causarci dolore. Ma non possono essere eliminati con un proiettile. Almeno, non con uno che conosco.",shape=box,color=red];
		j3551328394 -> j1860757519;
	j1948114392 [label="Di cosa si tratta, Lyon? Veramente?",shape=box,color=red];
		j1948114392 -> j1418028670;
	j2833932827 [label="Io... sinceramente non lo so, Lyon. E vorrei veramente saperlo.",shape=box,color=red];
		j2833932827 -> j3318887485;
	j1185078040 [label="Sì, suppongo che si possa dire così. Come possiamo essere certi di non aver... manifestato i nostri propri demoni?",shape=box,color=blue];
		j1185078040 -> j3306039140;
		j1185078040 -> j3551328394;
		j1185078040 -> j1948114392;
		j1185078040 -> j2833932827;
	j188599569 [label="Intere strutture, e persino Lua stessa, sono state collocate nel Void e recuperate. Quindi non consuma la materia che esiste semplicemente al suo interno.",shape=box,color=red];
		j188599569 -> j1388051760;
	j4029823569 [label="Ciò che stai insinuando è l'esistenza di un Void 'più profondo' in cui non può esistere nulla, e onestamente non posso esprimermi in merito.",shape=box,color=red];
		j4029823569 -> j4174501831;
	j3373081183 [label="Se venisse cancellato dai pensieri di tutti coloro che lo circondano, cesserebbe di esistere, non è vero?",shape=box,color=blue];
		j3373081183 -> j955754879;
		j3373081183 -> j1557445781;
		j3373081183 -> j2184313415;
	j2309897492 [label="Boolean LyonReal1 is now true.",color=orange];
		j2309897492 -> j859894834;
	j1860757519 [label="Boolean LyonFake1 is now true.",color=orange];
		j1860757519 -> j2086596097;
	j1418028670 [label="Boolean LyonFaith1 is now true.",color=orange];
		j1418028670 -> j1479301851;
	j3318887485 [label="La tua onestà nell'ammettere ciò che non sai è rinfrescante. Vorrei che più persone avessero un dono simile.",shape=box,color=blue];
		j3318887485 -> j1045742189;
	j1388051760 [label="Non mi interessa la materia depositata nel Void e poi recuperata. Mi interessa ciò che è stato inventato dal Void, dal nulla.",shape=box,color=blue];
		j1388051760 -> j1557445781;
		j1388051760 -> j955754879;
		j1388051760 -> j2184313415;
	j4174501831 [label="Apprezzo la franchezza. Immagino di essere meno interessato a ciò che non può esistere e a ciò che esiste.",shape=box,color=blue];
		j4174501831 -> j1557445781;
		j4174501831 -> j955754879;
		j4174501831 -> j2184313415;
	j859894834 [label="Sì, immagino sapresti cosa può essere distrutto con la forza del Void e cosa no...",shape=box,color=blue];
		j859894834 -> j1783096087;
	j2086596097 [label="Forse è per questo che così tanti si abbandonano agli eccessi... per tamponare una ferita sanguinante, invisibile ma dolorosa. Curabile. Ma con la forza dell'anima, non delle armi.",shape=box,color=blue];
		j2086596097 -> j1783096087;
	j1479301851 [label="Ho chiaramente sbagliato tutto. Ne parleremo un'altra volta. Perdona la mia intrusione.",shape=box,color=blue];
		j1479301851 -> j2895678923;
	j1045742189 [label="Comunque, trovo che i miei pensieri sulla questione siano ancora del tutto incerti.",shape=box,color=blue];
		j1045742189 -> j1479301851;
	j1783096087 [label="Anche se, come sempre, mi ritrovo nel dubbio. Perdona la mia intrusione. Ti ringrazio per il tuo tempo, Drifter.",shape=box,color=blue];
		j1783096087 -> j2895678923;
	j2895678923 [label="-P. Lyon Allard",shape=box,color=blue];
		j2895678923 -> "Chat ends.";
}