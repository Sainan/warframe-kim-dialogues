digraph {
	114 [label="LyonRank3Convo3 begins.",color=orange];
		114 -> 115;
	115 [label="Stavo aiutando M. Loid nella sua biblioteca, rimettendo a posto i libri sugli scaffali, anche se lui insisteva che... avrebbero potuto farlo quegli strani congegni volanti -",shape=box,color=blue];
		115 -> 116;
	116 [label="E mi sono imbattuto in un curioso volume che raccontava storie per bambini, ambientate in un mondo immaginario, scritte da una certa Euleria Entrati.",shape=box,color=blue];
		116 -> 117;
	117 [label="Notando che l'autore condivideva il cognome con il vero nome del nostro 'Cardinal Dimanche', ho subito messo da parte la copia.",shape=box,color=blue];
		117 -> 120;
		117 -> 119;
		117 -> 118;
	120 [label="Credo di sapere a quale libro stai facendo riferimento...",shape=box,color=red];
		120 -> 123;
	119 [label="Possiamo saltare il preambolo, per cortesia? Chiedimi quello che vuoi sapere.",shape=box,color=red];
		119 -> 122;
	118 [label="[Ignora.]",shape=box,color=red];
		118 -> 121;
	123 [label="+5 Chemistry",color=orange];
		123 -> 125;
	122 [label="Update boolean LyonMITW1",color=orange];
		122 -> 124;
	121 [label="Chat ends.",color=orange];
	125 [label="A giudicare dall'espressione inorridita che mi ha rivolto M. Loid e dalla sua insistenza nel farmi sostituire immediatamente il libro, 'per non farti arrabbiare', sospetto che tu ne sappia qualcosa, sì.",shape=box,color=blue];
		125 -> 128;
	124 [label="La mia domanda riguarda la natura dell'Incarnazione Concettuale. Dopo averlo letto, ho capito che il libro aveva lo scopo di insegnare ai bambini a impedire alle proprie emozioni di interagire con il Void.",shape=box,color=blue];
		124 -> 126;
		124 -> 127;
	128 [label="'Le Leggende di Duviri.' Sebbene abbia ricevuto una spiegazione piuttosto... esauriente e sofferta da M. Loid riguardo a ciò che hai sopportato, c'è una questione in particolare su cui vorrei informarmi.",shape=box,color=blue];
		128 -> 131;
	126 [label="Per quel poco che ha fatto. Soprattutto nel mio caso.",shape=box,color=red];
		126 -> 129;
	127 [label="Le emozioni forti che interagiscono con il Void possono causare... seri problemi.",shape=box,color=red];
		127 -> 130;
	131 [label="Se, naturalmente, non è troppo problematico farlo?",shape=box,color=blue];
		131 -> 134;
		131 -> 135;
	129 [label="Quanta parte della nostra vita ci è stata prescritta da altri come un fatto, solo per poi rivelarsi inutile una volta messa alla prova?",shape=box,color=blue];
		129 -> 132;
	130 [label="A quanto pare. Ho incontrato i Cavia. Mi hanno parlato degli Angeli del Void. Ho visto i murmur in prima persona. ",shape=box,color=blue];
		130 -> 133;
	134 [label="No. Procedi.",shape=box,color=red];
		134 -> 122;
	135 [label="Dipende tutto dai dettagli, suppongo. Non ho idea di cosa stai per chiedermi.",shape=box,color=red];
		135 -> 140;
	132 [label="Update boolean LyonFaith1",color=orange];
		132 -> 136;
	133 [label="Ed è proprio questa la natura della mia curiosità. Sono arrivato a pormi questa domanda per vedere se potessi spiegarmelo meglio. Quando il Void prende forma, ciò che ne esce - è 'reale'?",shape=box,color=blue];
		133 -> 137;
		133 -> 138;
		133 -> 139;
	140 [label="+5 Chemistry",color=orange];
		140 -> 146;
	136 [label="Mi chiedo spesso, perché riempire la testa degli altri con bugie così inutili? È forse il potere che cercano? L'influenza? O pensi che credano sinceramente alle loro stesse parole e siamo ignari delle loro stesse falsità?",shape=box,color=blue];
		136 -> 142;
		136 -> 141;
	137 [label="No, credo che tutto ciò che è stato creato dal Void sia semplicemente... temporaneo. Un frammento di chiunque o qualunque cosa l'abbia creato. Il fantasma di un ricordo.",shape=box,color=red];
		137 -> 143;
	138 [label="Credo di sì. Come un dipinto realizzato da un artista, potrebbe essere uscito dalla mente di qualcuno, ma è reale una volta creato.",shape=box,color=red];
		138 -> 144;
	139 [label="Dipende interamente dalla tua definizione di 'reale'.",shape=box,color=red];
		139 -> 145;
	146 [label="Sì, perdonami. Non sono molto bravo a... essere diretto. Specialmente con un metodo così strano. Ma mi ci impegnerò.",shape=box,color=blue];
		146 -> 122;
	142 [label="In questo caso, credo che Euleria Entrati intendesse scrivere qualcosa di utile. Semplicemente non mi è stato d'aiuto quando ne avevo bisogno.",shape=box,color=red];
		142 -> 148;
	141 [label="Non lo so. Di quali bugie ti hanno riempito la testa, Lyon?",shape=box,color=red];
		141 -> 147;
	143 [label="Allora gli effetti causati da tali elementi del Void non sono 'reali'?",shape=box,color=blue];
		143 -> 149;
	144 [label="Ma l'analogia che utilizzi è del tutto accurata, vero? La materia recuperata dal Void ritorna al Void, non è vero?",shape=box,color=blue];
		144 -> 150;
	145 [label="+5 Chemistry",color=orange];
		145 -> 151;
	148 [label="A sua discolpa, devo dire che la mia esposizione al Void, è stata molto più prolungata di quanto lei intendesse utilizzare il libro come guida.",shape=box,color=red];
		148 -> 153;
	147 [label="Nessuna di quelle per cui sono venuto a parlarti.",shape=box,color=blue];
		147 -> 152;
	149 [label="Molti ricordi hanno spinto un uomo a bere o a togliersi la vita. Non sono forse 'reali' quei ricordi?",shape=box,color=blue];
		149 -> 154;
	150 [label="Molto bene, un pensiero, allora. Una poesia o una canzone esistono anche se non sono scritte.",shape=box,color=red];
		150 -> 155;
	151 [label="Potresti approfondire?",shape=box,color=blue];
		151 -> 156;
	153 [label="+5 Chemistry",color=orange];
		153 -> 157;
	152 [label="Chat ends.",color=orange];
	154 [label="Ma quello che voglio dire è che quelle erano forze interne a cui l'uomo aveva lasciato agire su di sé. Non esterne.",shape=box,color=red];
		154 -> 158;
	155 [label="Ma se vengono dimenticate, cessano di esistere. Una storia persa nel tempo è persa per sempre.",shape=box,color=blue];
		155 -> 159;
	156 [label="Come si misura la 'realtà'?",shape=box,color=red];
		156 -> 160;
		156 -> 161;
		156 -> 162;
	157 [label="La sfortunata ignoranza è la cosa migliore che chiunque di noi possa sperare possa causare la malignità degli altri.",shape=box,color=blue];
		157 -> 163;
	158 [label="Ma qual è la differenza, è questa la mia domanda? Se il risultato finale è lo stesso, ha importanza?",shape=box,color=blue];
		158 -> 164;
		158 -> 165;
		158 -> 166;
	159 [label="Una rivoluzione scaturita dalle menti di coloro che la brandiscono è davvero una spada non affilata.",shape=box,color=blue];
		159 -> 164;
		159 -> 165;
		159 -> 166;
	160 [label="Per permanenza fisica? Peso e massa? Ciò che proviene dal Void è qui solo temporaneamente.",shape=box,color=red];
		160 -> 167;
	161 [label="Per il suo effetti sugli eventi? Ciò che viene dal Void ha cambiato il corso della storia.",shape=box,color=red];
		161 -> 168;
	162 [label="Con il suo effetto sugli altri? L'influenza delle 'cose' provenienti dal Void ne ha certamente avuto uno.",shape=box,color=red];
		162 -> 169;
	163 [label="Una mia curiosità, tuttavia, non riguarda né il libro né la sua utilità. Perdonami se mi lascio andare per un attimo alla poesia.",shape=box,color=blue];
		163 -> 170;
	164 [label="Non stai chiedendo se sono 'reali', stai chiedendo se sono 'validi'. Se devono essere respinti o meno.",shape=box,color=red];
		164 -> 171;
	165 [label="Vorrei anche chiederti se i tuoi Luminari sono 'reali' semplicemente perché non puoi stringere la mano a Sol o Lua.",shape=box,color=red];
		165 -> 172;
	166 [label="Stai chiedendo, in modo indiretto, se tutte le 'cose' provenienti dal Void siano qui solo perché le abbiamo create con la nostrà volontà.",shape=box,color=red];
		166 -> 173;
	167 [label="Ciò che proviene dal Void deve ritornarci, è questo che stai dicendo? Ma il Void, per definizione, non è forse composto dal nulla?",shape=box,color=blue];
		167 -> 174;
	168 [label="Un'osservazione valida. Una rivoluzione non è forse 'reale' semplicemente perché non puoi metterla in un cestino e pesarla?",shape=box,color=blue];
		168 -> 169;
	169 [label="Certamente costò la vita a molti. Difenderebbero la sua validità con convinzione. Tuttavia, considera questo:",shape=box,color=blue];
		169 -> 175;
	170 [label="Sono arrivato a pormi questa domanda per vedere se potessi spiegarmelo meglio. Quando il Void prende forma, ciò che ne esce - è 'reale'?",shape=box,color=blue];
		170 -> 137;
		170 -> 139;
		170 -> 138;
	171 [label="+5 Chemistry",color=orange];
		171 -> 176;
	172 [label="Non stiamo parlando dei Luminari. Stiamo parlando del Void.",shape=box,color=blue];
		172 -> 177;
		172 -> 178;
		172 -> 179;
		172 -> 180;
	173 [label="+5 Chemistry",color=orange];
		173 -> 181;
	174 [label="Suppongo? Le parti del Void con cui ho interagito tendono ad avere già un'impronta. Gli abbiamo già dato una forma o un'immagine. Oppure abbiamo sfumato troppo il confine tra le realtà.",shape=box,color=red];
		174 -> 182;
		174 -> 183;
	175 [label="Una rivoluzione è valida solo perché esiste nelle menti di coloro che la mettono in atto.",shape=box,color=blue];
		175 -> 184;
	176 [label="Sì, suppongo si possa dire così. Dovremmo ignorare i fantasmi che infestano i nostri corridoi, o se, prestando loro attenzione, non facciamo altro che renderli più forti?",shape=box,color=blue];
		176 -> 177;
		176 -> 178;
		176 -> 179;
		176 -> 180;
	177 [label="Credo che le sfide che ci troviamo ad affrontare in questo momento siano pericolose. Estremamente pericolose. E dovremmo trattarle come tali.",shape=box,color=red];
		177 -> 185;
	178 [label="I fantasmi sono abbastanza reali da causarci dolore. Ma non possono essere eliminati con un proiettile. Almeno, non con uno che conosco.",shape=box,color=red];
		178 -> 186;
	179 [label="Di cosa si tratta, Lyon? Veramente?",shape=box,color=red];
		179 -> 187;
	180 [label="Io... sinceramente non lo so, Lyon. E vorrei veramente saperlo.",shape=box,color=red];
		180 -> 188;
	181 [label="Sì, suppongo che si possa dire così. Come possiamo essere certi di non aver... manifestato i nostri propri demoni?",shape=box,color=blue];
		181 -> 177;
		181 -> 178;
		181 -> 179;
		181 -> 180;
	182 [label="Intere strutture, e persino Lua stessa, sono state collocate nel Void e recuperate. Quindi non consuma la materia che esiste semplicemente al suo interno.",shape=box,color=red];
		182 -> 189;
	183 [label="Ciò che stai insinuando è l'esistenza di un Void 'più profondo' in cui non può esistere nulla, e onestamente non posso esprimermi in merito.",shape=box,color=red];
		183 -> 190;
	184 [label="Se venisse cancellato dai pensieri di tutti coloro che lo circondano, cesserebbe di esistere, non è vero?",shape=box,color=blue];
		184 -> 165;
		184 -> 164;
		184 -> 166;
	185 [label="Update boolean LyonReal1",color=orange];
		185 -> 191;
	186 [label="Update boolean LyonFake1",color=orange];
		186 -> 192;
	187 [label="Update boolean LyonFaith1",color=orange];
		187 -> 193;
	188 [label="La tua onestà nell'ammettere ciò che non sai è rinfrescante. Vorrei che più persone avessero un dono simile.",shape=box,color=blue];
		188 -> 194;
	189 [label="Non mi interessa la materia depositata nel Void e poi recuperata. Mi interessa ciò che è stato inventato dal Void, dal nulla.",shape=box,color=blue];
		189 -> 164;
		189 -> 165;
		189 -> 166;
	190 [label="Apprezzo la franchezza. Immagino di essere meno interessato a ciò che non può esistere e a ciò che esiste.",shape=box,color=blue];
		190 -> 164;
		190 -> 165;
		190 -> 166;
	191 [label="Sì, immagino sapresti cosa può essere distrutto con la forza del Void e cosa no...",shape=box,color=blue];
		191 -> 195;
	192 [label="Forse è per questo che così tanti si abbandonano agli eccessi... per tamponare una ferita sanguinante, invisibile ma dolorosa. Curabile. Ma con la forza dell'anima, non delle armi.",shape=box,color=blue];
		192 -> 195;
	193 [label="Ho chiaramente sbagliato tutto. Ne parleremo un'altra volta. Perdona la mia intrusione.",shape=box,color=blue];
		193 -> 196;
	194 [label="Comunque, trovo che i miei pensieri sulla questione siano ancora del tutto incerti.",shape=box,color=blue];
		194 -> 193;
	195 [label="Anche se, come sempre, mi ritrovo nel dubbio. Perdona la mia intrusione. Ti ringrazio per il tuo tempo, Drifter.",shape=box,color=blue];
		195 -> 196;
	196 [label="-P. Lyon Allard",shape=box,color=blue];
		196 -> 197;
	197 [label="Chat ends.",color=orange];
}