digraph {
	32 [label="LyonRank3Convo2 begins.",color=orange];
		32 -> 33;
	33 [label="Se mi è concesso, vorrei raccontarti la storia di un gatto randagio che era solito aggirarsi nel retro della chiesa.",shape=box,color=blue];
		33 -> 36;
		33 -> 35;
		33 -> 34;
	36 [label="Procedi.",shape=box,color=red];
		36 -> 39;
	35 [label="Perché?",shape=box,color=red];
		35 -> 38;
	34 [label="[Ignora.]",shape=box,color=red];
		34 -> 37;
	39 [label="Grazie.",shape=box,color=blue];
		39 -> 41;
	38 [label="Temo che spiegarlo richiederebbe più sforzo di quanto ne varrebbe la pena.",shape=box,color=blue];
		38 -> 40;
	37 [label="Chat ends.",color=orange];
	41 [label="Anche se sospetto che questa storia non sia esclusiva di questo vecchio gatto spelacchiato, e che le mie interazioni con lui sembravano essere degne di menzione, vale comunque la pena raccontarla.",shape=box,color=blue];
		41 -> 43;
	40 [label="Non importa.",shape=box,color=blue];
		40 -> 42;
	43 [label="Ogni giorno veniva a chiedere qualche avanzo e tutte le carezze che riusciva ad ottenere da me o dagli altri che lo adoravano.",shape=box,color=blue];
		43 -> 44;
	42 [label="Chat ends.",color=orange];
	44 [label="Era un essere cencioso, zoppicava e gli mancava parte di un orecchio. ",shape=box,color=blue];
		44 -> 45;
	45 [label="Quando non si fece vedere per qualche giorno, Marie era fuori di sé dalla preoccupazione. Ma cosa si può fare per un randagio che ha trovato la morte, se non rivolgere una preghiera a Lua?",shape=box,color=blue];
		45 -> 46;
	46 [label="Update boolean LyonStray",color=orange];
		46 -> 47;
		46 -> 48;
		46 -> 49;
	47 [label="[Lascialo continuare.]",shape=box,color=red];
		47 -> 50;
	48 [label="È permesso nella tua religione? Pregare per gli animali, intendo.",shape=box,color=red];
		48 -> 51;
	49 [label="Pregheresti per l'anima di un gatto randagio deceduto?",shape=box,color=red];
		49 -> 52;
	50 [label="Comunque, immagina la mia sorpresa quando, mentre camminavo per andare a prendere il pane al mercato, ho visto il vecchio gatto seduto accando al proprietario del banco.",shape=box,color=blue];
		50 -> 53;
	51 [label="+10 Chemistry",color=orange];
		51 -> 54;
	52 [label="Certo. Alcune delle anime più pure e luminose che abbia mai incontrato erano racchiuse nella carne di una bestia. Non sta a me giudicare come i Luminari le abbiano guidate sul loro cammino.",shape=box,color=blue];
		52 -> 55;
	53 [label="Mi salutò con un miagolio rauco, come faceva sempre, e saltò giù per strusciarsi contro la mia gamba.",shape=box,color=blue];
		53 -> 56;
	54 [label="Bella domanda. In alcune sette, no. Sarebbe considerato un'eresia. Ma nella nostra, sì. Riconosciamo che gli animale hanno un'anima.",shape=box,color=blue];
		54 -> 55;
	55 [label="Santa Elisabeth la Saggia era nota per la sua carità verso gli animali, anche se molte tradizioni non riconoscono i Santi come apostoli dei Luminari.",shape=box,color=blue];
		55 -> 57;
	56 [label="E vorrei far notare, Drifter, che lo fece senza zoppicare.",shape=box,color=blue];
		56 -> 58;
	57 [label="Mi chiedo se l'influenza del nostro ordine sia sopravvissuta così a lungo... ma non è questo il punto della conversazione.",shape=box,color=blue];
		57 -> 59;
	58 [label="'Ah, vedo che è uno degli sciocchi del Vecchio Devereaux.' L'uomo rise mentre insacchettava il mio pane.",shape=box,color=blue];
		58 -> 60;
	59 [label="Update boolean LyonLecture1",color=orange];
		59 -> 50;
	60 [label="A quanto pare, il vecchio gatto stava prendendo in giro noi e molti altri del quartiere. Non stava morendo di fame, non era malato e non era in alcun modo trascurato.",shape=box,color=blue];
		60 -> 61;
	61 [label="In effetti, se si dovesse credere alle parole dell'uomo, si trattava di un vero e proprio assassino nei confronti della popolazione locale di uccelli.",shape=box,color=blue];
		61 -> 62;
		61 -> 63;
		61 -> 64;
	62 [label="Hai smesso di dare da mangiare al Vecchio Devereaux quando è tornato?",shape=box,color=red];
		62 -> 65;
	63 [label="Stai cercando di mettermi in guardia da Roathe?",shape=box,color=red];
		63 -> 66;
	64 [label="Sei il gatto randagio in questa storia?",shape=box,color=red];
		64 -> 67;
	65 [label="+10 Chemistry",color=orange];
		65 -> 68;
	66 [label="Ci sono moltissime che cose che potrebbero metterti in guardia dal diavolo che il ''Cardinal Dimanche'' ha messo alla nostra porta. Forse questa è una di queste. O forse non lo è.",shape=box,color=blue];
		66 -> 69;
	67 [label="I Luminari sanno che ultimamente sono stato consumato. Ma questo dovrebbe essere un avvertimento nei miei riguardi? Forse. O forse no.",shape=box,color=blue];
		67 -> 69;
	68 [label="No. Anzi, Marie lo accolse con ancora più affetto, prendendolo in giro per essere 'il suo piccolo diavoletto'.",shape=box,color=blue];
		68 -> 70;
	69 [label="È semplicemente una storia per dire che a volte, quando una creatura sembra essere nel bisogno -",shape=box,color=blue];
		69 -> 71;
	70 [label="Ma non ci preoccupavamo più per lui. Sapevamo che il Vecchio Devereaux sapeva badare a se stesso senza problemi. Non aveva bisogno di noi.",shape=box,color=blue];
		70 -> 72;
		70 -> 73;
	71 [label="+15 Chemistry",color=orange];
		71 -> 74;
	72 [label="Che fine ha fatto il Vecchio Devereaux, lo sai?",shape=box,color=red];
		72 -> 75;
	73 [label="Cosa pensi che abbia spinto il Vecchio Devereaux a farti visita, se non era necessario?",shape=box,color=red];
		73 -> 76;
	74 [label="- controlla quanto sono affilati i suoi artigli.",shape=box,color=blue];
		74 -> 77;
	75 [label="La sua successiva scomparsa, avvenuta due anni dopo, divenne definitiva.",shape=box,color=blue];
		75 -> 78;
		75 -> 79;
	76 [label="La risposta cinica che ti darei sarebbe 'avidità'. Perché se si può fare un banchetto, perché non due? Perché non dieci?",shape=box,color=blue];
		76 -> 80;
		76 -> 81;
	77 [label="Chat ends.",color=orange];
	78 [label="Hai pregato per lui?",shape=box,color=red];
		78 -> 82;
	79 [label="Spero che abbia lasciato questo mondo agiato e amato.",shape=box,color=red];
		79 -> 83;
	80 [label="Quale sarebbe la risposta non cinica?",shape=box,color=red];
		80 -> 84;
	81 [label="Rimarebbe uguale se cercasse solo affetto?",shape=box,color=red];
		81 -> 85;
	82 [label="Ho acceso una candela per lui la notte in cui ho saputo della sua morte e ho pregato Lua di guidare la sua anima... ovunque lei avrebbe guidato un piccolo diavoletto come lui.",shape=box,color=blue];
		82 -> 86;
	83 [label="Posso chiedere perché?",shape=box,color=blue];
		83 -> 87;
		83 -> 88;
	84 [label="+10 Chemistry",color=orange];
		84 -> 89;
	85 [label="Un desiderio avido di affetto è pur sempre gola, anche se non è una fame alimentata da carne e vino. E cercarlo con pretesti così falsi?",shape=box,color=blue];
		85 -> 90;
		85 -> 91;
	86 [label="E ho ringraziato il Vecchio Devereaux per tutta la gioia che aveva portato a Marie in cambio di tutti quei tanto ambiti pezzetti di cartilagine di pollo e grattini in testa.",shape=box,color=blue];
		86 -> 92;
	87 [label="Era un animale. Cercava solo la realizzazione - cibo, riparo, amore - non era ispirato dalle stesse motivazioni delle persone. Non stava 'mentendo', stava solo cacciando con strumenti diversi.",shape=box,color=red];
		87 -> 93;
	88 [label="Ho visto molta violenza, Lyon. Molta di essa l'ho causata io. Sono giunto alla speranza che tutti, non importa chi siano o cosa abbiano fatto, possano morire serenamente, circordati da coloro che li amano.",shape=box,color=red];
		88 -> 94;
	89 [label="Mi sono trovano... stranamente... a rispettarlo, per il posto che si era trovato nel mondo.",shape=box,color=blue];
		89 -> 95;
	90 [label="Era un gatto, Lyon. Non sapeva cosa stava facendo.",shape=box,color=red];
		90 -> 96;
	91 [label="Stiamo sempre parlando di un gatto, vero?",shape=box,color=red];
		91 -> 97;
	92 [label="Grazie. Non ostacolerò più la tua giornata.",shape=box,color=blue];
		92 -> 98;
	93 [label="Non negava nulla agli altri rendendovi tutti degli ''sciocchi''. Anzi... sembra che siate stati tutti arricchiti dalle sue visite.",shape=box,color=red];
		93 -> 99;
	94 [label="Affascinante. Mi aspetterei che disprezzassi i tuoi nemici. Ma questa è la mia follia - presumere di sapere come si comporterebbe chiunque al giorno d'oggi.",shape=box,color=blue];
		94 -> 100;
	95 [label="Ecco una creatura che aveva imparato a utilizzare la sua condizione - il suo aspetto, la sua età, le sue cicatrici - come un'arma contro 'gli sciocchi' che lo circondavano e che non avevano capito il suo stratagemma.",shape=box,color=blue];
		95 -> 101;
	96 [label="Sapeva benissimo come fingere di zoppicare. ",shape=box,color=blue];
		96 -> 84;
	97 [label="Trai da questa conversazione ciò che vuoi, Drifter.",shape=box,color=blue];
		97 -> 84;
	98 [label="-P. Lyon Allard",shape=box,color=blue];
		98 -> 102;
	99 [label="Add -1 to Thermostat",color=orange];
		99 -> 103;
	100 [label="Add 1 to Thermostat",color=orange];
		100 -> 104;
	101 [label="Era davvero un diavoletto con la pelliccia arruffata. Eppure mi ritrovavo ad accarezzarlo lo stesso quando veniva a trovarmi.",shape=box,color=blue];
		101 -> 105;
	102 [label="Chat ends.",color=orange];
	103 [label="Sì. Immagino di sì. E non ci mancavano certo pezzi di cartilagine di pollo e grattini.",shape=box,color=blue];
		103 -> 106;
	104 [label="Per non parlare di qualcuno con la tua educazione particolarmente affascinante. ",shape=box,color=blue];
		104 -> 107;
	105 [label="E altrettanto straziante quando, due anni dopo, la sua successiva scomparsa fu definitiva.",shape=box,color=blue];
		105 -> 78;
		105 -> 79;
	106 [label="Forse è per questo che ho acceso una candela per lui e ho pregato Lua di prendere la sua anima e di guidarla... ovunque lei avrebbe portato un diavoletto come lui.",shape=box,color=blue];
		106 -> 108;
	107 [label="+5 Chemistry",color=orange];
		107 -> 109;
	108 [label="+5 Chemistry",color=orange];
		108 -> 110;
	109 [label="Grazie. Non ostacolerò più la tua giornata. È stata una conversazione molto interessante. A presto.",shape=box,color=blue];
		109 -> 111;
	110 [label="Ed è per questo che quella sera ho ringraziato il Vecchio Devereaux nelle mie preghiere per tutta la gioia che aveva portato a Marie.",shape=box,color=blue];
		110 -> 112;
	111 [label="-P. Lyon Allard",shape=box,color=blue];
		111 -> 113;
	112 [label="Forse la sua piccola cattiveria, in un certo senso, ha avuto un effetto positivo.",shape=box,color=blue];
		112 -> 109;
	113 [label="Chat ends.",color=orange];
}