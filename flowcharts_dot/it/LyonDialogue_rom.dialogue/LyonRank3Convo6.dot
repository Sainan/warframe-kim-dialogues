digraph {
	568 [label="LyonRank3Convo6 begins.",color=orange];
		568 -> 570;
		568 -> 569;
	570 [label="Per quanto tempo Entrati è rimasto con te nella cattedrale, prima dell'arrivo di Roathe?",shape=box,color=red];
		570 -> 572;
	569 [label="[Fine.]",shape=box,color=red];
		569 -> 571;
	572 [label="Perché mi fai questa domanda?",shape=box,color=blue];
		572 -> 573;
	571 [label="Chat ends.",color=orange];
	573 [label="Evaluate expressions",color=orange];
		573 -> 577 [label="MarieLyonVisions",color=purple];
		573 -> 574 [label="MarieLyonVisions",color=purple];
		573 -> 575 [label="MarieLyonVisions",color=purple];
		573 -> 576 [label="MarieLyonVisions",color=purple];
		573 -> 574 [label="LyonVisions1",color=purple];
		573 -> 575 [label="LyonVisions1",color=purple];
		573 -> 576 [label="LyonVisions1",color=purple];
		573 -> 577 [label="LyonVisions1",color=purple];
		573 -> 574 [label="false",color=purple];
		573 -> 575 [label="false",color=purple];
	577 [label="Mi avevano avvertito che forse era probabile che tu non la vedessi come noi. Ma questo non mi preoccupa. Mi interessa quello che sai.",shape=box,color=red];
		577 -> 581;
	574 [label="Marie sembra ossessionata da 'le Cardinal'. E Roathe chiaramente lo detesta. Cerco una controparte neutrale. Tu sei ciò che si avvicina di più.",shape=box,color=red];
		574 -> 578;
	575 [label="Non... so cos'altro chiederti?",shape=box,color=red];
		575 -> 579;
	576 [label="Mi avevano avvertito che forse era probabile che tu non la vedessi come noi. Ma credo che potresti vedere la verità dove altri non la vedono.",shape=box,color=red];
		576 -> 580;
	581 [label="Hm. Non ti dà fastidio frequentare pazzi e lunatici? Curioso. Anche se sembra che tu frequenti animali parlanti e... creature fuori dal tempo. Suppongo di non essere né più né meno stravagante di chiunque altro nella tua collezione.",shape=box,color=blue];
		581 -> 582;
	578 [label="Quanta scarsità di opzioni sensate ti sei trovato davanti, quando un pazzo e un lunatico sono la tua unica fonte di opinione 'neutrale'. Non riesco a capire perché ti preoccupi di parlare con me.",shape=box,color=blue];
		578 -> 582;
	579 [label="Perché insisti a parlare con me? Non ne hai bisogno, te ne rendi contro? Se desideri fare amicizia con Marie - o corteggiare - Marie, non sono il suo custode, né suo padre. E qualunque siano le tue intenzioni con quel bastardo di Roathe, mi interessa poco, a parte le risposte che mi deve.",shape=box,color=blue];
		579 -> 582;
	580 [label="'Verità.' Vorrei che capissi quanto mi abbia fatto ridere. Non ti dà fastidio frequentare pazzi e lunatici? Curioso. Anche se sembra che tu frequenti animali parlanti e... creature fuori dal tempo. Suppongo di non essere né più né meno stravagante di chiunque altro nella tua collezione.",shape=box,color=blue];
		580 -> 582;
	582 [label="Evaluate expressions",color=orange];
		582 -> 585 [label="LyonFirstFlirt",color=purple];
		582 -> 585 [label="DrifterLyon",color=purple];
		582 -> 584 [label="LyonOffer",color=purple];
		582 -> 583 [label="false",color=purple];
	585 [label="E per favore, risparmiaci un altro... momento imbarazzante, per favore? So che quello che hai detto è il motivo per cui mi hai parlato. E anche se lo trovo lusinghiero, lo trovo anche ridicolmente insincero.",shape=box,color=blue];
		585 -> 586;
		585 -> 587;
		585 -> 588;
	584 [label="E per favore, risparmiaci un altro sermone su come vorresti \"aiutarmi\", per favore? Sono certo che sia per gentilezza, ma è irritante per la sua ridicola insincerità.",shape=box,color=blue];
		584 -> 586;
		584 -> 587;
		584 -> 588;
	583 [label="E per favore, risparmiaci a entrambi una lunga predica su come desideri \"aiutarmi\" o su come \"desideri essere mio amico\". Sono certo che sia per gentilezza, ma è irritante per la sua ridicola insincerità.",shape=box,color=blue];
		583 -> 586;
		583 -> 587;
		583 -> 588;
	586 [label="Insincero perché pensi che non intenda quello che dico, o insincero perché pensi che non possa dirlo sul serio nei tuoi confronti?",shape=box,color=red];
		586 -> 589;
	587 [label="Sacerdote, tutto quello che volevo era la storia di quanto a lungo Entrati si è finto Cardinale. Tutto qui.",shape=box,color=red];
		587 -> 590;
	588 [label="Cosa intenti con 'insincero'? Mi stai dando del bugiardo?",shape=box,color=red];
		588 -> 591;
	589 [label="Nessuna delle due. Le tue parole sono una carità di cui non ho né bisogno né desidero.",shape=box,color=blue];
		589 -> 592;
		589 -> 593;
	590 [label="Esatto. Per tre anni, due mesi e undici giorni, ha ricoperto il ruolo di Cardinal Dimanche nella nostra Cattedrale. E per tutto quel tempo, Marie e io lo abbiamo servito senza sapere il suo piano per noi.",shape=box,color=blue];
		590 -> 594;
	591 [label="Evaluate expressions",color=orange];
		591 -> 597 [label="DrifterLiar",color=purple];
		591 -> 596 [label="LyonSuspicious",color=purple];
		591 -> 595 [label="false",color=purple];
	592 [label="Come fa Marie a sopportare tutto questo...?",shape=box,color=red];
		592 -> 598;
	593 [label="Pensi che chiunque scelga di socializzare con te stia compiendo un atto di carità?",shape=box,color=red];
		593 -> 599;
	594 [label="Conosco le tue domande prima che tu le ponga. Cosa stava tramando? Ha infettato la città, come ho sentito dire che ha fatto con Höllvania? Quali erano i suoi piani? Le sue scoperte?",shape=box,color=blue];
		594 -> 600;
	597 [label="C'è qualcosa che vuoi confessare, Drifter? C'è una penitenza che vuoi pagare?",shape=box,color=blue];
		597 -> 601;
	596 [label="Mh. No. Forse non ancora.",shape=box,color=blue];
		596 -> 595;
	595 [label="La tua insincerità non è una menzogna. È intesa come carità. Carità che non voglio e di cui non ho bisogno. ",shape=box,color=blue];
		595 -> 592;
		595 -> 593;
	598 [label="Meglio chiederglielo tu stesso. Me lo sono chiesto spesso anch'io.",shape=box,color=blue];
		598 -> 602;
	599 [label="Semplicemente? Sì.",shape=box,color=blue];
		599 -> 603;
	600 [label="A questi dico, rimarrete delusi. Per quei tre anni, due mesi e undici giorni? Predicò. Studiò. Si riposò. E pregò.",shape=box,color=blue];
		600 -> 604;
		600 -> 605;
		600 -> 606;
	601 [label="Non è né qui né lì. Non sei venuto in cerca di perdono, né le tue vecchie bugie sono la stessa cosa delle tue attuali insincerità.",shape=box,color=blue];
		601 -> 607;
	602 [label="Chat ends.",color=orange];
	603 [label="Update boolean LyonHate1",color=orange];
		603 -> 608;
		603 -> 609;
		603 -> 610;
	604 [label="Quando vi ha trasformati in protoframe?",shape=box,color=red];
		604 -> 611;
	605 [label="Mi riesce molto difficile immaginare Entranti che prega.",shape=box,color=red];
		605 -> 612;
	606 [label="Quindi era in un... anno sabbatico?!",shape=box,color=red];
		606 -> 613;
	607 [label="Ciò che dici ora è semplicemente carità. La carità non è né bisogno né desiderio.",shape=box,color=blue];
		607 -> 592;
		607 -> 593;
	608 [label="Qualcosa su cui riflettere un altro giorno - sento che questa conversazione ci sta sfuggendo di mano.",shape=box,color=red];
		608 -> 614;
	609 [label="E Marie...?",shape=box,color=red];
		609 -> 615;
	610 [label="Devi avere una pessima opinione di te stesso.",shape=box,color=red];
		610 -> 616;
	611 [label="Dopo tre anni e qualche giorno, scomparve nel mezzo di una terribile tempesta. Uguale a quella in cui è apparso.",shape=box,color=blue];
		611 -> 617;
	612 [label="È impossibile conoscere i meccanismi interni della mente di un altro. Si inginocchiò all'altare e tenne la testa china. Stava pregando? O era semplicemente perso nei suoi pensieri? Io non lo posso sapere.",shape=box,color=blue];
		612 -> 611;
	613 [label="+5 Chemistry",color=orange];
		613 -> 618;
	614 [label="+5 Chemistry",color=orange];
		614 -> 619;
	615 [label="Marie avrebbe cullato un orso rabbioso e gli avrebbe lasciato strapparle la gola se avesse pensato che ciò avrebbe potuto dargli un momento di pace.",shape=box,color=blue];
		615 -> 620;
	616 [label="Io lo considererei un impegno costante al pragmatismo, ma definiscilo come preferisci.",shape=box,color=blue];
		616 -> 621;
	617 [label="Evaluate expressions",color=orange];
		617 -> 622 [label="MarieLyonVisions",color=purple];
		617 -> 622 [label="LyonVisions1",color=purple];
		617 -> 623 [label="false",color=purple];
	618 [label="Ehe. Non ci avevo pensato, ma sì - è possibile. Che esasperazione per tutti voi. Sembra in linea con quel poco che sappiamo del suo vero io.",shape=box,color=blue];
		618 -> 611;
	619 [label="Probabilmente è una decisione saggia. Mi chiedevi del 'Cardinal Dimanche' e il suo mandato alla Cattedrale.",shape=box,color=blue];
		619 -> 624;
	620 [label="Possiede un'anima singolarmente bella, che proteggerò fino al mio ultimo respiro.",shape=box,color=blue];
		620 -> 621;
	621 [label="+5 Chemistry",color=orange];
		621 -> 625;
	622 [label="Sebbene sappia che la tempesta non sia capitata ad altri, per me è stata piuttosto vivida.",shape=box,color=blue];
		622 -> 623;
	623 [label="Esattamente un anno dopo, riapparve un'ultima volta, con... Roathe, come lo vedi ora, accasciato e privo di sensi ai suoi piedi.",shape=box,color=blue];
		623 -> 626;
	624 [label="Per tre anni, due mesi e undici giorni, ha ricoperto il ruolo di Cardinal Dimanche nella nostra Cattedrale. E per tutto quel tempo, Marie e io lo abbiamo servito senza sapere il suo piano per noi.",shape=box,color=blue];
		624 -> 594;
	625 [label="Ma questo è ciò che devi aspettarti: porre una semplice domanda a un pazzo è spesso un percorso dispersivo. Permettimi di riportarci al tuo argomento originale, piuttosto che al mio.",shape=box,color=blue];
		625 -> 624;
	626 [label="Un diavolo in carne e ossa, o almeno così sembrava. Fu allora che Entrati ci raccontò la verità su chi era - quando ci salutò - e il vero compito che aveva per noi.",shape=box,color=blue];
		626 -> 627;
	627 [label="Che ci aveva scelti entrambi per una 'missione sacra'.",shape=box,color=blue];
		627 -> 628;
		627 -> 629;
	628 [label="Perché le virgolette?",shape=box,color=red];
		628 -> 630;
	629 [label="Sembra che tu non gli creda.",shape=box,color=red];
		629 -> 630;
	630 [label="Ho imparato molto che mi fa dubitare dell'adesione di Entrati a qualcosa di sacrosanto, a qualsiasi natura o a un dio di qualsiasi tipo... se una cosa del genere esiste...",shape=box,color=blue];
		630 -> 631;
		630 -> 632;
	631 [label="Se una cosa del genere esiste? Lyon, cosa intendi?",shape=box,color=red];
		631 -> 633;
	632 [label="Procedi.",shape=box,color=red];
		632 -> 634;
	633 [label="Update boolean LyonFaith2",color=orange];
		633 -> 635;
	634 [label="Marie accettò il siero con prontezza. Ovviamente. Come non avrebbe potuto farlo? E come avrei potuto non seguirla? Come avrei potuto non cercare la verità, ovunque mi avrebbe condotto?",shape=box,color=blue];
		634 -> 636;
	635 [label="Una questione che affronteremo un'altra volta, grazie.",shape=box,color=blue];
		635 -> 634;
	636 [label="Update boolean LyonSerum1",color=orange];
		636 -> 637;
		636 -> 638;
		636 -> 639;
	637 [label="Penso che lei ancora veneri un po' troppo Entrati.",shape=box,color=red];
		637 -> 640;
	638 [label="Cosa accadde dopo?",shape=box,color=red];
		638 -> 641;
	639 [label="Te ne sei pentito?",shape=box,color=red];
		639 -> 642;
	640 [label="Update boolean LyonMarieEntrati",color=orange];
		640 -> 643;
	641 [label="Roathe si risvegliò. All'inizio, riusciva a mala pena a ricordare il suo nome. Entrati disse una sola frase di commianto al bastardo. \"Uriel, Eretico di Xata, in esilio. rispondi - gli Orokin potranno mai essere perdonati?\"",shape=box,color=blue];
		641 -> 644;
	642 [label="Mi pento di tutto, Drifter. Sì, certo che me ne pento. Ma lo rifarei? Sì, certo che lo rifarei. Non potrei lasciare Marie da sola.",shape=box,color=blue];
		642 -> 645;
	643 [label="Su questo siamo d'accordo. Ma non posso biasimarla. Dalle tempo. Capirà. È incredibilmente intelligente, Drifter. Non trattarla come una sciocca.",shape=box,color=blue];
		643 -> 645;
	644 [label="Entrati se ne andò per l'ultima volta. E abbandonò Roathe con noi, ora trasformato in ciò che vedi - in grado di affontare un diavolo capriccioso.",shape=box,color=blue];
		644 -> 646;
	645 [label="Per concludere il racconto... Entrati se ne andò per l'ultima volta. E abbandonò Roathe con noi, ora trasformato in ciò che vedi - in grado di affontare un diavolo capriccioso.",shape=box,color=blue];
		645 -> 646;
	646 [label="Il resto, temo, sia una storia che dovrà aspettare. M. Loid richiede l'utilizzo del POM-2 e non vedo l'ora di rinunciarvi. Spero che questo abbia contribuito a rispondere almeno ad alcune delle tue domande.",shape=box,color=blue];
		646 -> 647;
		646 -> 648;
	647 [label="E ne ho il doppio adesso.",shape=box,color=red];
		647 -> 649;
	648 [label="Sì, grazie.",shape=box,color=red];
		648 -> 650;
	649 [label="+15 Chemistry",color=orange];
		649 -> 651;
	650 [label="+10 Chemistry",color=orange];
		650 -> 652;
	651 [label="Allora ho fatto il mio dovere di sacerdote. Ti auguro buonanotte.",shape=box,color=blue];
		651 -> 653;
	652 [label="Allora ti auguro buonanotte.",shape=box,color=blue];
		652 -> 653;
	653 [label="-P. Lyon Allard",shape=box,color=blue];
		653 -> 654;
	654 [label="Chat ends.",color=orange];
}