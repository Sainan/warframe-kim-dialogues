		"LyonRank3Convo6 begins." -> j4115718638;
	j200671771 [label="Per quanto tempo Entrati è rimasto con te nella cattedrale, prima dell'arrivo di Roathe?",shape=box,color=red];
		j200671771 -> j890610727;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j890610727 [label="Perché mi fai questa domanda?",shape=box,color=blue];
		j890610727 -> j4196769031;
	"Chat ends." [color=orange];
	j4196769031 [label="Evaluate expressions",color=orange];
		j4196769031 -> j2190656890 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j3896545782 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j2352073313 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j3599862851 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j3896545782 [label="LyonVisions1",color=purple];
		j4196769031 -> j2352073313 [label="LyonVisions1",color=purple];
		j4196769031 -> j3599862851 [label="LyonVisions1",color=purple];
		j4196769031 -> j2190656890 [label="LyonVisions1",color=purple];
		j4196769031 -> j3896545782 [label="false",color=purple];
		j4196769031 -> j2352073313 [label="false",color=purple];
	j2190656890 [label="Mi avevano avvertito che forse era probabile che tu non la vedessi come noi. Ma questo non mi preoccupa. Mi interessa quello che sai.",shape=box,color=red];
		j2190656890 -> j3390179612;
	j3896545782 [label="Marie sembra ossessionata da 'le Cardinal'. E Roathe chiaramente lo detesta. Cerco una controparte neutrale. Tu sei ciò che si avvicina di più.",shape=box,color=red];
		j3896545782 -> j3355013436;
	j2352073313 [label="Non... so cos'altro chiederti?",shape=box,color=red];
		j2352073313 -> j2350969561;
	j3599862851 [label="Mi avevano avvertito che forse era probabile che tu non la vedessi come noi. Ma credo che potresti vedere la verità dove altri non la vedono.",shape=box,color=red];
		j3599862851 -> j296831498;
	j3390179612 [label="Hm. Non ti dà fastidio frequentare pazzi e lunatici? Curioso. Anche se sembra che tu frequenti animali parlanti e... creature fuori dal tempo. Suppongo di non essere né più né meno stravagante di chiunque altro nella tua collezione.",shape=box,color=blue];
		j3390179612 -> j2845885253;
	j3355013436 [label="Quanta scarsità di opzioni sensate ti sei trovato davanti, quando un pazzo e un lunatico sono la tua unica fonte di opinione 'neutrale'. Non riesco a capire perché ti preoccupi di parlare con me.",shape=box,color=blue];
		j3355013436 -> j2845885253;
	j2350969561 [label="Perché insisti a parlare con me? Non ne hai bisogno, te ne rendi contro? Se desideri fare amicizia con Marie - o corteggiare - Marie, non sono il suo custode, né suo padre. E qualunque siano le tue intenzioni con quel bastardo di Roathe, mi interessa poco, a parte le risposte che mi deve.",shape=box,color=blue];
		j2350969561 -> j2845885253;
	j296831498 [label="'Verità.' Vorrei che capissi quanto mi abbia fatto ridere. Non ti dà fastidio frequentare pazzi e lunatici? Curioso. Anche se sembra che tu frequenti animali parlanti e... creature fuori dal tempo. Suppongo di non essere né più né meno stravagante di chiunque altro nella tua collezione.",shape=box,color=blue];
		j296831498 -> j2845885253;
	j2845885253 [label="Evaluate expressions",color=orange];
		j2845885253 -> j2715828894 [label="LyonFirstFlirt",color=purple];
		j2845885253 -> j2715828894 [label="DrifterLyon",color=purple];
		j2845885253 -> j2726697052 [label="LyonOffer",color=purple];
		j2845885253 -> j4077001003 [label="false",color=purple];
	j2715828894 [label="E per favore, risparmiaci un altro... momento imbarazzante, per favore? So che quello che hai detto è il motivo per cui mi hai parlato. E anche se lo trovo lusinghiero, lo trovo anche ridicolmente insincero.",shape=box,color=blue];
		j2715828894 -> j403958997;
		j2715828894 -> j2552783834;
		j2715828894 -> j2006126503;
	j2726697052 [label="E per favore, risparmiaci un altro sermone su come vorresti \"aiutarmi\", per favore? Sono certo che sia per gentilezza, ma è irritante per la sua ridicola insincerità.",shape=box,color=blue];
		j2726697052 -> j403958997;
		j2726697052 -> j2552783834;
		j2726697052 -> j2006126503;
	j4077001003 [label="E per favore, risparmiaci a entrambi una lunga predica su come desideri \"aiutarmi\" o su come \"desideri essere mio amico\". Sono certo che sia per gentilezza, ma è irritante per la sua ridicola insincerità.",shape=box,color=blue];
		j4077001003 -> j403958997;
		j4077001003 -> j2552783834;
		j4077001003 -> j2006126503;
	j403958997 [label="Insincero perché pensi che non intenda quello che dico, o insincero perché pensi che non possa dirlo sul serio nei tuoi confronti?",shape=box,color=red];
		j403958997 -> j3763831149;
	j2552783834 [label="Sacerdote, tutto quello che volevo era la storia di quanto a lungo Entrati si è finto Cardinale. Tutto qui.",shape=box,color=red];
		j2552783834 -> j1554252531;
	j2006126503 [label="Cosa intenti con 'insincero'? Mi stai dando del bugiardo?",shape=box,color=red];
		j2006126503 -> j5625625;
	j3763831149 [label="Nessuna delle due. Le tue parole sono una carità di cui non ho né bisogno né desidero.",shape=box,color=blue];
		j3763831149 -> j529170101;
		j3763831149 -> j3732581111;
	j1554252531 [label="Esatto. Per tre anni, due mesi e undici giorni, ha ricoperto il ruolo di Cardinal Dimanche nella nostra Cattedrale. E per tutto quel tempo, Marie e io lo abbiamo servito senza sapere il suo piano per noi.",shape=box,color=blue];
		j1554252531 -> j3048521443;
	j5625625 [label="Evaluate expressions",color=orange];
		j5625625 -> j3836038585 [label="DrifterLiar",color=purple];
		j5625625 -> j3053030943 [label="LyonSuspicious",color=purple];
		j5625625 -> j2914687477 [label="false",color=purple];
	j529170101 [label="Come fa Marie a sopportare tutto questo...?",shape=box,color=red];
		j529170101 -> j1820486891;
	j3732581111 [label="Pensi che chiunque scelga di socializzare con te stia compiendo un atto di carità?",shape=box,color=red];
		j3732581111 -> j4237068280;
	j3048521443 [label="Conosco le tue domande prima che tu le ponga. Cosa stava tramando? Ha infettato la città, come ho sentito dire che ha fatto con Höllvania? Quali erano i suoi piani? Le sue scoperte?",shape=box,color=blue];
		j3048521443 -> j1978270795;
	j3836038585 [label="C'è qualcosa che vuoi confessare, Drifter? C'è una penitenza che vuoi pagare?",shape=box,color=blue];
		j3836038585 -> j2926242462;
	j3053030943 [label="Mh. No. Forse non ancora.",shape=box,color=blue];
		j3053030943 -> j2914687477;
	j2914687477 [label="La tua insincerità non è una menzogna. È intesa come carità. Carità che non voglio e di cui non ho bisogno. ",shape=box,color=blue];
		j2914687477 -> j529170101;
		j2914687477 -> j3732581111;
	j1820486891 [label="Meglio chiederglielo tu stesso. Me lo sono chiesto spesso anch'io.",shape=box,color=blue];
		j1820486891 -> "Chat ends.";
	j4237068280 [label="Semplicemente? Sì.",shape=box,color=blue];
		j4237068280 -> j3994772085;
	j1978270795 [label="A questi dico, rimarrete delusi. Per quei tre anni, due mesi e undici giorni? Predicò. Studiò. Si riposò. E pregò.",shape=box,color=blue];
		j1978270795 -> j971173018;
		j1978270795 -> j1234584211;
		j1978270795 -> j1614202271;
	j2926242462 [label="Non è né qui né lì. Non sei venuto in cerca di perdono, né le tue vecchie bugie sono la stessa cosa delle tue attuali insincerità.",shape=box,color=blue];
		j2926242462 -> j839721478;
	j3994772085 [label="Boolean LyonHate1 is now true.",color=orange];
		j3994772085 -> j1012912455;
		j3994772085 -> j2978683268;
		j3994772085 -> j3198385895;
	j971173018 [label="Quando vi ha trasformati in protoframe?",shape=box,color=red];
		j971173018 -> j1313411409;
	j1234584211 [label="Mi riesce molto difficile immaginare Entranti che prega.",shape=box,color=red];
		j1234584211 -> j1635368673;
	j1614202271 [label="Quindi era in un... anno sabbatico?!",shape=box,color=red];
		j1614202271 -> j117458635;
	j839721478 [label="Ciò che dici ora è semplicemente carità. La carità non è né bisogno né desiderio.",shape=box,color=blue];
		j839721478 -> j529170101;
		j839721478 -> j3732581111;
	j1012912455 [label="Qualcosa su cui riflettere un altro giorno - sento che questa conversazione ci sta sfuggendo di mano.",shape=box,color=red];
		j1012912455 -> j3277239622;
	j2978683268 [label="E Marie...?",shape=box,color=red];
		j2978683268 -> j3402034883;
	j3198385895 [label="Devi avere una pessima opinione di te stesso.",shape=box,color=red];
		j3198385895 -> j779255709;
	j1313411409 [label="Dopo tre anni e qualche giorno, scomparve nel mezzo di una terribile tempesta. Uguale a quella in cui è apparso.",shape=box,color=blue];
		j1313411409 -> j3307858394;
	j1635368673 [label="È impossibile conoscere i meccanismi interni della mente di un altro. Si inginocchiò all'altare e tenne la testa china. Stava pregando? O era semplicemente perso nei suoi pensieri? Io non lo posso sapere.",shape=box,color=blue];
		j1635368673 -> j1313411409;
	j117458635 [label="+5 Chemistry",color=orange];
		j117458635 -> j1717400373;
	j3277239622 [label="+5 Chemistry",color=orange];
		j3277239622 -> j627557194;
	j3402034883 [label="Marie avrebbe cullato un orso rabbioso e gli avrebbe lasciato strapparle la gola se avesse pensato che ciò avrebbe potuto dargli un momento di pace.",shape=box,color=blue];
		j3402034883 -> j2441962973;
	j779255709 [label="Io lo considererei un impegno costante al pragmatismo, ma definiscilo come preferisci.",shape=box,color=blue];
		j779255709 -> j186938637;
	j3307858394 [label="Evaluate expressions",color=orange];
		j3307858394 -> j3608025804 [label="MarieLyonVisions",color=purple];
		j3307858394 -> j3608025804 [label="LyonVisions1",color=purple];
		j3307858394 -> j4063027643 [label="false",color=purple];
	j1717400373 [label="Ehe. Non ci avevo pensato, ma sì - è possibile. Che esasperazione per tutti voi. Sembra in linea con quel poco che sappiamo del suo vero io.",shape=box,color=blue];
		j1717400373 -> j1313411409;
	j627557194 [label="Probabilmente è una decisione saggia. Mi chiedevi del 'Cardinal Dimanche' e il suo mandato alla Cattedrale.",shape=box,color=blue];
		j627557194 -> j2329692313;
	j2441962973 [label="Possiede un'anima singolarmente bella, che proteggerò fino al mio ultimo respiro.",shape=box,color=blue];
		j2441962973 -> j186938637;
	j186938637 [label="+5 Chemistry",color=orange];
		j186938637 -> j3748532776;
	j3608025804 [label="Sebbene sappia che la tempesta non sia capitata ad altri, per me è stata piuttosto vivida.",shape=box,color=blue];
		j3608025804 -> j4063027643;
	j4063027643 [label="Esattamente un anno dopo, riapparve un'ultima volta, con... Roathe, come lo vedi ora, accasciato e privo di sensi ai suoi piedi.",shape=box,color=blue];
		j4063027643 -> j1810205821;
	j2329692313 [label="Per tre anni, due mesi e undici giorni, ha ricoperto il ruolo di Cardinal Dimanche nella nostra Cattedrale. E per tutto quel tempo, Marie e io lo abbiamo servito senza sapere il suo piano per noi.",shape=box,color=blue];
		j2329692313 -> j3048521443;
	j3748532776 [label="Ma questo è ciò che devi aspettarti: porre una semplice domanda a un pazzo è spesso un percorso dispersivo. Permettimi di riportarci al tuo argomento originale, piuttosto che al mio.",shape=box,color=blue];
		j3748532776 -> j2329692313;
	j1810205821 [label="Un diavolo in carne e ossa, o almeno così sembrava. Fu allora che Entrati ci raccontò la verità su chi era - quando ci salutò - e il vero compito che aveva per noi.",shape=box,color=blue];
		j1810205821 -> j1086529282;
	j1086529282 [label="Che ci aveva scelti entrambi per una 'missione sacra'.",shape=box,color=blue];
		j1086529282 -> j1579649859;
		j1086529282 -> j1288270998;
	j1579649859 [label="Perché le virgolette?",shape=box,color=red];
		j1579649859 -> j47225206;
	j1288270998 [label="Sembra che tu non gli creda.",shape=box,color=red];
		j1288270998 -> j47225206;
	j47225206 [label="Ho imparato molto che mi fa dubitare dell'adesione di Entrati a qualcosa di sacrosanto, a qualsiasi natura o a un dio di qualsiasi tipo... se una cosa del genere esiste...",shape=box,color=blue];
		j47225206 -> j636419755;
		j47225206 -> j1871164945;
	j636419755 [label="Se una cosa del genere esiste? Lyon, cosa intendi?",shape=box,color=red];
		j636419755 -> j1778591535;
	j1871164945 [label="Procedi.",shape=box,color=red];
		j1871164945 -> j636131802;
	j1778591535 [label="Boolean LyonFaith2 is now true.",color=orange];
		j1778591535 -> j1901567261;
	j636131802 [label="Marie accettò il siero con prontezza. Ovviamente. Come non avrebbe potuto farlo? E come avrei potuto non seguirla? Come avrei potuto non cercare la verità, ovunque mi avrebbe condotto?",shape=box,color=blue];
		j636131802 -> j1813802388;
	j1901567261 [label="Una questione che affronteremo un'altra volta, grazie.",shape=box,color=blue];
		j1901567261 -> j636131802;
	j1813802388 [label="Boolean LyonSerum1 is now true.",color=orange];
		j1813802388 -> j2914686279;
		j1813802388 -> j1605557705;
		j1813802388 -> j1914502305;
	j2914686279 [label="Penso che lei ancora veneri un po' troppo Entrati.",shape=box,color=red];
		j2914686279 -> j1831106509;
	j1605557705 [label="Cosa accadde dopo?",shape=box,color=red];
		j1605557705 -> j3568454017;
	j1914502305 [label="Te ne sei pentito?",shape=box,color=red];
		j1914502305 -> j2461266542;
	j1831106509 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j1831106509 -> j2455683594;
	j3568454017 [label="Roathe si risvegliò. All'inizio, riusciva a mala pena a ricordare il suo nome. Entrati disse una sola frase di commianto al bastardo. \"Uriel, Eretico di Xata, in esilio. rispondi - gli Orokin potranno mai essere perdonati?\"",shape=box,color=blue];
		j3568454017 -> j1664427138;
	j2461266542 [label="Mi pento di tutto, Drifter. Sì, certo che me ne pento. Ma lo rifarei? Sì, certo che lo rifarei. Non potrei lasciare Marie da sola.",shape=box,color=blue];
		j2461266542 -> j1727813850;
	j2455683594 [label="Su questo siamo d'accordo. Ma non posso biasimarla. Dalle tempo. Capirà. È incredibilmente intelligente, Drifter. Non trattarla come una sciocca.",shape=box,color=blue];
		j2455683594 -> j1727813850;
	j1664427138 [label="Entrati se ne andò per l'ultima volta. E abbandonò Roathe con noi, ora trasformato in ciò che vedi - in grado di affontare un diavolo capriccioso.",shape=box,color=blue];
		j1664427138 -> j3824485779;
	j1727813850 [label="Per concludere il racconto... Entrati se ne andò per l'ultima volta. E abbandonò Roathe con noi, ora trasformato in ciò che vedi - in grado di affontare un diavolo capriccioso.",shape=box,color=blue];
		j1727813850 -> j3824485779;
	j3824485779 [label="Il resto, temo, sia una storia che dovrà aspettare. M. Loid richiede l'utilizzo del POM-2 e non vedo l'ora di rinunciarvi. Spero che questo abbia contribuito a rispondere almeno ad alcune delle tue domande.",shape=box,color=blue];
		j3824485779 -> j542033076;
		j3824485779 -> j2342304727;
	j542033076 [label="E ne ho il doppio adesso.",shape=box,color=red];
		j542033076 -> j1413043824;
	j2342304727 [label="Sì, grazie.",shape=box,color=red];
		j2342304727 -> j2432319360;
	j1413043824 [label="+15 Chemistry",color=orange];
		j1413043824 -> j2395928712;
	j2432319360 [label="+10 Chemistry",color=orange];
		j2432319360 -> j556200443;
	j2395928712 [label="Allora ho fatto il mio dovere di sacerdote. Ti auguro buonanotte.",shape=box,color=blue];
		j2395928712 -> j2895678923;
	j556200443 [label="Allora ti auguro buonanotte.",shape=box,color=blue];
		j556200443 -> j2895678923;
	j2895678923 [label="-P. Lyon Allard",shape=box,color=blue];
		j2895678923 -> "Chat ends.";
}