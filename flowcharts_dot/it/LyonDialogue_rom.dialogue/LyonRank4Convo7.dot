		1298 -> 1299;
	1299 [label="Ecco perché all'inizio ti ho evitato. Ed ecco perché sono ancora... propenso a periodi di solitudine. Non riesco a trovare le parole.",shape=box,color=blue];
		1299 -> 1300;
		1299 -> 1301;
