	j1727290908 [label="+5 Chemistry",color=orange];
		j1727290908 -> j1492730854;
	j11656141 [label="Pur apprezzandolo, ritengo comunque di dovermi scusare. Farò del mio meglio per essere breve e non appesantirmi con inutile erudizione.",shape=box,color=blue];
		j11656141 -> j1704530042;
	"Chat ends." [color=orange];
	j1492730854 [label="Grazie. Farò del mio meglio per essere breve e non appesantirmi con inutile erudizione.",shape=box,color=blue];
		j1492730854 -> j1704530042;
	j1704530042 [label="Le conversazioni sono difficili per me. Molto più difficili nei rapporti intimi che in quelli impersonali, meccanici o per corrispondenza.",shape=box,color=blue];
		j1704530042 -> j1010313644;
	j1010313644 [label="Non so come descriverlo - se non dicendo che è... come se cercassi di afferrare qualcosa, ma vedessi solo granelli di polvere scivolare tra le mie dita. ",shape=box,color=blue];
		j1010313644 -> j1279537013;
	j1279537013 [label="Mi sembra spesso di essere un pezzo di tela vuoto, su cui spalmo colori a olio - tentando invano di creare l'ombra di un'immagine che vedo nella mia mente.",shape=box,color=blue];
		j1279537013 -> j413138433;
	j413138433 [label="Eppure più lavoro, più la situazione diventa disperata.",shape=box,color=blue];
		j413138433 -> j1698937444;
	j1698937444 [label="Più ci provo, più mi sfugge. Quindi ho semplicemente imparato... a non provarci affatto.",shape=box,color=blue];
		j1698937444 -> j3456789340;
	j3456789340 [label="Ecco perché all'inizio ti ho evitato. Ed ecco perché sono ancora... propenso a periodi di solitudine. Non riesco a trovare le parole.",shape=box,color=blue];
		j3456789340 -> j257257276;
		j3456789340 -> j2280999068;
		j3456789340 -> j2643249469;
	j257257276 [label="Sarò sempre felice di averti accanto a me in silenzio.",shape=box,color=red];
		j257257276 -> j3543186615;
	j2280999068 [label="A volte tendo anch'io a essere così. Niente di grave.",shape=box,color=red];
		j2280999068 -> j4104861363;
	j2643249469 [label="Scuse accettate.",shape=box,color=red];
		j2643249469 -> j4181144688;
	j3543186615 [label="+15 Chemistry",color=orange];
