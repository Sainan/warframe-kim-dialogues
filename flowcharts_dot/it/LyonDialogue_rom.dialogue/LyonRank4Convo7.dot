	j1892826889 [label="Me... lo ricorderò. Grazie, Drifter.",shape=box,color=blue];
		j1892826889 -> j2895678923;
	j964178477 [label="Non me ne sono reso conto. Ricorderò di non dare per scontato di essere così solo al mondo... Grazie, Drifter.",shape=box,color=blue];
