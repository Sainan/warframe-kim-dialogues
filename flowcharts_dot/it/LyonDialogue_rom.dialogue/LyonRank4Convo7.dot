	1293 [label="Grazie. Farò del mio meglio per essere breve e non appesantirmi con inutile erudizione.",shape=box,color=blue];
		1293 -> 1294;
	1294 [label="Le conversazioni sono difficili per me. Molto più difficili nei rapporti intimi che in quelli impersonali, meccanici o per corrispondenza.",shape=box,color=blue];
		1294 -> 1295;
	1295 [label="Non so come descriverlo - se non dicendo che è... come se cercassi di afferrare qualcosa, ma vedessi solo granelli di polvere scivolare tra le mie dita. ",shape=box,color=blue];
		1295 -> 1296;
	1296 [label="Mi sembra spesso di essere un pezzo di tela vuoto, su cui spalmo colori a olio - tentando invano di creare l'ombra di un'immagine che vedo nella mia mente.",shape=box,color=blue];
		1296 -> 1297;
	1297 [label="Eppure più lavoro, più la situazione diventa disperata.",shape=box,color=blue];
		1297 -> 1298;
