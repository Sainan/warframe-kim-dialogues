		1752 -> 1759 [label="DrifterFaithSol",color=purple];
		1752 -> 1759 [label="DrifterFaithLua",color=purple];
		1752 -> 1759 [label="DrifterFaithBalance",color=purple];
		1752 -> 1758 [label="DrifterFaithAgnostic",color=purple];
		1752 -> 1757 [label="DrifterFaithNoFear",color=purple];
		1752 -> 1756 [label="DrifterFaithNoMITW",color=purple];
		1752 -> 1757 [label="DrifterFaithNoMaybe",color=purple];
		1752 -> 1755 [label="false",color=purple];
	1763 [label="Mentre Sol avrebbe bruciato il dolore come un coltello caldo cauterizza una ferita - Lua mi avrebbe lasciato abbracciare il calore del dolore che la sua assenza avrebbe potuto portare.",shape=box,color=blue];
		1763 -> 1770;
	1762 [label="E so che, se riuscissi ancora a trovare la presenza di Rell e del suo Harrow, non vorrebbero che io soffra per la loro perdita. Loro sono in pace.",shape=box,color=blue];
		1762 -> 1769;
	1760 [label="Oh, Lyon... hai sofferto così tanto. Il dubbio non è frutto di debolezza - è frutto del dolore.",shape=box,color=red];
		1760 -> 1764;
		1760 -> 1765;
		1760 -> 1766;
		1760 -> 1767;
		1760 -> 1768;
	1761 [label="La fede non deve essere costante - né ci si aspetta che lo sia. Quante storie si raccontano di persone che perdono la fede, solo per poi ritrovarla?",shape=box,color=red];
		1761 -> 1764;
		1761 -> 1765;
		1761 -> 1766;
	1759 [label="Hai dedicato la tua vita ai nostri Luminari, Lyon. Pensi che ti volterebbero le spalle per una cosa del genere?",shape=box,color=red];
		1759 -> 1764;
		1759 -> 1765;
		1759 -> 1766;
	1758 [label="Non so se gli dei esistano o no, Lyon - non credo che potremo mai saperlo veramente. Ma quello che so è che hai passato momenti difficili.",shape=box,color=red];
		1758 -> 1764;
		1758 -> 1766;
		1758 -> 1767;
	1757 [label="Anche se personalmente non credo che ci siano dei in questo mondo, so quanto questo sia stato importante per te nella tua vita. Non voglio sminuirlo.",shape=box,color=red];
		1757 -> 1766;
		1757 -> 1768;
	1756 [label="L'Indifferenza è stata creata da noi - non è una divinità, Lyon. Non lasciare che l'errore di Entrati ti distrugga. E la tua fede?",shape=box,color=red];
		1756 -> 1766;
		1756 -> 1768;
	1755 [label="Odio vederti così, intrappolato nel mezzo delle sciocchezze di tutti. Non te lo meriti.",shape=box,color=red];
		1755 -> 1764;
		1755 -> 1765;
		1755 -> 1766;
		1755 -> 1767;
		1755 -> 1768;
	1770 [label="Perché è l'assenza di dolore che minaccia di distruggerci, così come la sua abbondanza potrebbe annegarci.",shape=box,color=blue];
		1770 -> 1778;
		1770 -> 1779;
		1770 -> 1777;
	1769 [label="Né credo che tutta la mia sofferenza sia stata inutile. Ciò non invalida tutto ciò che ho sopportato.",shape=box,color=blue];
		1769 -> 1776;
	1764 [label="Non sto dicendo che devi ritrovare la fede. Sto dicendo che se lo vuoi - se senti di doverlo fare - non è qualcosa che si perde per sempre.",shape=box,color=red];
		1764 -> 1771;
	1765 [label="Di sicuro, Lua può vedere cosa hai dovuto passare. Cosa hai sopportato in suo nome. ",shape=box,color=red];
		1765 -> 1772;
	1766 [label="Penso che ciò su cui dovresti concentrarti sia trovare una sorta di pace dentro di te - qualunque sia il modo in cui devi trovarla.",shape=box,color=red];
		1766 -> 1773;
	1767 [label="Se esiste un dio, se Lua esiste davvero - sicuramente può vedere cosa hai passato. Cosa hai sopportato in suo nome. Deve significare qualcosa per lei.",shape=box,color=red];
		1767 -> 1774;
	1768 [label="Penso che dovresti abbandonare qualsiasi idea sull'esistenza o meno degli dei e concentrarti prima di tutto sulla guarigione di te stesso.",shape=box,color=red];
		1768 -> 1775;
	1778 [label="Fidati... so quanto può essere pericolosa l'apatia.",shape=box,color=red];
		1778 -> 1785;
	1779 [label="Ciò significa che hai ritrovato la fede?",shape=box,color=red];
		1779 -> 1786;
	1777 [label="[Fine.]",shape=box,color=red];
