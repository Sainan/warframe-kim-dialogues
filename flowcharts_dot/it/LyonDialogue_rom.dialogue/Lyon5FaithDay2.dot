		1775 -> 1782;
	1785 [label="Così sembra. ",shape=box,color=blue];
		1785 -> 1791;
	1786 [label="È difficile dirlo. Non so se una cosa del genere sia qualcosa che qualcuno come me abbia mai 'trovato' o 'perso', ma qualcosa che si è sempre alla ricerca. Sempre a porsi domande, sempre alla ricerca di risposte.",shape=box,color=blue];
		1786 -> 1792;
	1784 [label="Update boolean LyonConfessionFail",color=orange];
		1784 -> 1790;
	1783 [label="Ciò significa che hai rinunciato alla tua fede?",shape=box,color=red];
		1783 -> 1786;
	1780 [label="Penso a cosa significhi avere Rell e Harrow così inesorabilmente nella mia vita -",shape=box,color=blue];
		1780 -> 1787;
	1781 [label="Penso agli anni trascorsi al servizio di un'organizzazione che in fondo, aveva come scopo quello di fare del bene in questo mondo... cosa significa avere la presenza di Rell e Harrow così inesorabilmente nella mia vita -",shape=box,color=blue];
		1781 -> 1788;
	1782 [label="Penso a cosa significhi avere Rell e Harrow così inesorabilmente nella mia vita -",shape=box,color=blue];
		1782 -> 1789;
	1791 [label="Non so se la fede sia qualcosa che qualcuno come me abbia mai 'trovato' o 'perso', ma che invece cerchi per sempre. Sempre a porsi domande - sempre alla ricerca di risposte.",shape=box,color=blue];
		1791 -> 1792;
	1792 [label="Ma credo che, come per il dolore, ci sia un equilibrio da trovare per garantire che non ci si anneghi né che ci si faccia l'abitudine a tal punto da diventarne immuni e insensibili.",shape=box,color=blue];
		1792 -> 1796;
	1790 [label="Chat ends.",color=orange];
	1787 [label="Solo per vedere la loro presenza cancellata dalla mia anima ancora una volta, solo per rimanere un ricordo. E non so se questo significhi che ci sono degli dei in questo mondo oppure no.",shape=box,color=blue];
		1787 -> 1793;
	1788 [label="Solo per vedere la loro presenza cancellata dalla mia anima ancora una volta, solo per rimanere un ricordo. E come questo potrebbe essere stato un dono di Lua...",shape=box,color=blue];
		1788 -> 1794;
	1789 [label="Solo per vedere la loro presenza cancellata dalla mia anima ancora una volta, solo per rimanere un ricordo. E hai ragione. Potrebbe significare che non ci sono dei in questo mondo.",shape=box,color=blue];
		1789 -> 1795;
