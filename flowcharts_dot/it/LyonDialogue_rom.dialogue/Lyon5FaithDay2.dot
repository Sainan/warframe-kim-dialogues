	1742 [label="Ho riflettuto sulla natura della nostra conversazione di ieri. E su cosa significhi avere la presenza di Rell e Harrow così inesorabilmente nella mia vita -",shape=box,color=blue];
		1742 -> 1747;
	1741 [label="Ho riflettuto sulla natura della nostra conversazione di ieri. E su cosa significhi avere la presenza di Rell e Harrow così inesorabilmente nella mia vita -",shape=box,color=blue];
		1741 -> 1746;
	1740 [label="Ho riflettuto sulla natura della nostra conversazione di ieri. E su cosa significhi avere la presenza di Rell e Harrow così inesorabilmente nella mia vita -",shape=box,color=blue];
		1740 -> 1745;
	1739 [label="C'è qualcosa che volevo dirti da tempo, e solo ora ho l'opportunità di farlo. Quando... Rell, Harrow, e io ci siamo collegati - il come e il perché non sono importanti -",shape=box,color=blue];
		1739 -> 1744;
	1743 [label="Chat ends.",color=orange];
	1747 [label="Solo per vedere la loro presenza cancellata dalla mia anima ancora una volta, solo per rimanere un ricordo. E come questo potrebbe essere stato un dono di Lua...",shape=box,color=blue];
		1747 -> 1751;
	1746 [label="Solo per vedere la loro presenza cancellata dalla mia anima ancora una volta, solo per rimanere un ricordo. E hai ragione. Potrebbe significare che non ci sono dei in questo mondo.",shape=box,color=blue];
		1746 -> 1750;
	1745 [label="Solo per vedere la loro presenza cancellata dalla mia anima ancora una volta, solo per rimanere un ricordo. E non so se questo significhi che ci sono degli dei in questo mondo oppure no.",shape=box,color=blue];
		1745 -> 1749;
	1744 [label="Mi sono lasciato coinvolgere dal loro passato nello stesso modo in cui loro ci sono lasciati coinvolgere dal mio. Ho visto la Zariman Ten Zero, sprazzi della Vecchia Guerra, e allo stesso modo, loro hanno visto il mio passato.",shape=box,color=blue];
		1744 -> 1748;
	1751 [label="Ho capito che la nostra dama d'argento avrebbe potuto concedere una benedizione così tragica. Non avrebbe voluto cancellare il ricordo del dolore, come nel caso di Roathe.",shape=box,color=blue];
		1751 -> 1754;
	1750 [label="Ma non cambia, credo, gli anni che ho trascorso al servizio di un'organizzazione che, in fondo, intendeva compiere buone azioni in questo mondo.",shape=box,color=blue];
		1750 -> 1753;
	1749 [label="Come hai detto, potremmo... non saperlo mai. E forse non spetta a noi saperlo. Così vanno le cose. Ma non cambia, credo, gli anni che ho trascorso al servizio di un'organizzazione che, in fondo, intendeva compiere buone azioni in questo mondo.",shape=box,color=blue];
		1749 -> 1753;
	1748 [label="Ha... messo in discussione molte cose per me, in particolare... la mia fede. Si è accartocciata, come carta carbonizzata, trasformandosi in polvere. Mi detesto per questa debolezza...",shape=box,color=blue];
		1748 -> 1752;
	1754 [label="Nè avrebbe potuto cancellare il dolore della frusta dalla mia carne. Non è certo il suo modo di proteggermi dal dolore della sua scomparsa.",shape=box,color=blue];
		1754 -> 1763;
	1753 [label="Per aiutare coloro che desideravano alleviare il dolore della propria vita nei momenti in cui questa li avrebbe sopraffatti.",shape=box,color=blue];
		1753 -> 1762;
	1752 [label="Evaluate expressions",color=orange];
		1752 -> 1760 [label="LyonDating",color=purple];
		1752 -> 1761 [label="DrifterFaithYesSimilar",color=purple];
		1752 -> 1761 [label="DrifterFaithYesForeign",color=purple];
