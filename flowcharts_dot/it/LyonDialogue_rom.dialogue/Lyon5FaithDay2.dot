	j1047017030 [label="Ho riflettuto sulla natura della nostra conversazione di ieri. E su cosa significhi avere la presenza di Rell e Harrow così inesorabilmente nella mia vita -",shape=box,color=blue];
		j1047017030 -> j3087262263;
	j2642957931 [label="Ho riflettuto sulla natura della nostra conversazione di ieri. E su cosa significhi avere la presenza di Rell e Harrow così inesorabilmente nella mia vita -",shape=box,color=blue];
		j2642957931 -> j2334705082;
	j3309437450 [label="Ho riflettuto sulla natura della nostra conversazione di ieri. E su cosa significhi avere la presenza di Rell e Harrow così inesorabilmente nella mia vita -",shape=box,color=blue];
		j3309437450 -> j2569952613;
	j209838725 [label="C'è qualcosa che volevo dirti da tempo, e solo ora ho l'opportunità di farlo. Quando... Rell, Harrow, e io ci siamo collegati - il come e il perché non sono importanti -",shape=box,color=blue];
		j209838725 -> j2070330390;
	"Chat ends." [color=orange];
	j3087262263 [label="Solo per vedere la loro presenza cancellata dalla mia anima ancora una volta, solo per rimanere un ricordo. E come questo potrebbe essere stato un dono di Lua...",shape=box,color=blue];
		j3087262263 -> j579487762;
	j2334705082 [label="Solo per vedere la loro presenza cancellata dalla mia anima ancora una volta, solo per rimanere un ricordo. E hai ragione. Potrebbe significare che non ci sono dei in questo mondo.",shape=box,color=blue];
		j2334705082 -> j2784208426;
	j2569952613 [label="Solo per vedere la loro presenza cancellata dalla mia anima ancora una volta, solo per rimanere un ricordo. E non so se questo significhi che ci sono degli dei in questo mondo oppure no.",shape=box,color=blue];
		j2569952613 -> j2928182458;
	j2070330390 [label="Mi sono lasciato coinvolgere dal loro passato nello stesso modo in cui loro ci sono lasciati coinvolgere dal mio. Ho visto la Zariman Ten Zero, sprazzi della Vecchia Guerra, e allo stesso modo, loro hanno visto il mio passato.",shape=box,color=blue];
		j2070330390 -> j704079166;
	j579487762 [label="Ho capito che la nostra dama d'argento avrebbe potuto concedere una benedizione così tragica. Non avrebbe voluto cancellare il ricordo del dolore, come nel caso di Roathe.",shape=box,color=blue];
		j579487762 -> j758164947;
	j2784208426 [label="Ma non cambia, credo, gli anni che ho trascorso al servizio di un'organizzazione che, in fondo, intendeva compiere buone azioni in questo mondo.",shape=box,color=blue];
		j2784208426 -> j3687279975;
	j2928182458 [label="Come hai detto, potremmo... non saperlo mai. E forse non spetta a noi saperlo. Così vanno le cose. Ma non cambia, credo, gli anni che ho trascorso al servizio di un'organizzazione che, in fondo, intendeva compiere buone azioni in questo mondo.",shape=box,color=blue];
		j2928182458 -> j3687279975;
	j704079166 [label="Ha... messo in discussione molte cose per me, in particolare... la mia fede. Si è accartocciata, come carta carbonizzata, trasformandosi in polvere. Mi detesto per questa debolezza...",shape=box,color=blue];
		j704079166 -> j3287457751;
	j758164947 [label="Nè avrebbe potuto cancellare il dolore della frusta dalla mia carne. Non è certo il suo modo di proteggermi dal dolore della sua scomparsa.",shape=box,color=blue];
		j758164947 -> j2960748986;
	j3687279975 [label="Per aiutare coloro che desideravano alleviare il dolore della propria vita nei momenti in cui questa li avrebbe sopraffatti.",shape=box,color=blue];
		j3687279975 -> j2850303154;
	j3287457751 [label="Evaluate expressions",color=orange];
		j3287457751 -> j48441609 [label="LyonDating",color=purple];
		j3287457751 -> j3794974304 [label="DrifterFaithYesSimilar",color=purple];
