		j1284398036 -> j778856099;
	j3871305291 [label="Boolean LyonFaith3No is now true.",color=orange];
		j3871305291 -> j106553792;
	j1093366908 [label="Così sembra. ",shape=box,color=blue];
		j1093366908 -> j2944242323;
	j410368257 [label="È difficile dirlo. Non so se una cosa del genere sia qualcosa che qualcuno come me abbia mai 'trovato' o 'perso', ma qualcosa che si è sempre alla ricerca. Sempre a porsi domande, sempre alla ricerca di risposte.",shape=box,color=blue];
		j410368257 -> j1356450451;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j2425212003 [label="Ciò significa che hai rinunciato alla tua fede?",shape=box,color=red];
		j2425212003 -> j410368257;
	j2804354620 [label="Penso a cosa significhi avere Rell e Harrow così inesorabilmente nella mia vita -",shape=box,color=blue];
		j2804354620 -> j2206772918;
	j778856099 [label="Penso agli anni trascorsi al servizio di un'organizzazione che in fondo, aveva come scopo quello di fare del bene in questo mondo... cosa significa avere la presenza di Rell e Harrow così inesorabilmente nella mia vita -",shape=box,color=blue];
		j778856099 -> j2480477710;
	j106553792 [label="Penso a cosa significhi avere Rell e Harrow così inesorabilmente nella mia vita -",shape=box,color=blue];
		j106553792 -> j1085621309;
	j2944242323 [label="Non so se la fede sia qualcosa che qualcuno come me abbia mai 'trovato' o 'perso', ma che invece cerchi per sempre. Sempre a porsi domande - sempre alla ricerca di risposte.",shape=box,color=blue];
		j2944242323 -> j1356450451;
	j1356450451 [label="Ma credo che, come per il dolore, ci sia un equilibrio da trovare per garantire che non ci si anneghi né che ci si faccia l'abitudine a tal punto da diventarne immuni e insensibili.",shape=box,color=blue];
		j1356450451 -> j1286686499;
	j2206772918 [label="Solo per vedere la loro presenza cancellata dalla mia anima ancora una volta, solo per rimanere un ricordo. E non so se questo significhi che ci sono degli dei in questo mondo oppure no.",shape=box,color=blue];
		j2206772918 -> j2928182458;
	j2480477710 [label="Solo per vedere la loro presenza cancellata dalla mia anima ancora una volta, solo per rimanere un ricordo. E come questo potrebbe essere stato un dono di Lua...",shape=box,color=blue];
		j2480477710 -> j761356464;
	j1085621309 [label="Solo per vedere la loro presenza cancellata dalla mia anima ancora una volta, solo per rimanere un ricordo. E hai ragione. Potrebbe significare che non ci sono dei in questo mondo.",shape=box,color=blue];
		j1085621309 -> j2784208426;
	j1286686499 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j1286686499 -> j4216337761 [label=true,color=green];
		j1286686499 -> j4028774105 [label=true,color=green];
		j1286686499 -> j1399896911 [label=false,color=brown];
		j1286686499 -> j4028774105 [label=false,color=brown];
	j761356464 [label="Forse hai ragione. Forse la nostra dama d'argento avrebbe potuto concedere una benedizione così tragica. Non avrebbe voluto cancellare il ricordo del dolore, come ne caso di Roathe.",shape=box,color=blue];
		j761356464 -> j758164947;
	j4216337761 [label="Sei d'accordo con Roathe e me sul fatto che l'Uomo nel Muro non sia un vero dio?",shape=box,color=red];
		j4216337761 -> j1221261461;
	j4028774105 [label="Secondo te, dove si colloca l'Indifferenza in tutto questo?",shape=box,color=red];
		j4028774105 -> j3517181625;
	j1399896911 [label="Sei d'accordo con Roathe nel pensare che l'Indifferenza sia una vera divinità oppure no?",shape=box,color=red];
		j1399896911 -> j1221261461;
	j1221261461 [label="Non so bene che posizione prendere sulla questione. Non ho prove sufficienti per prendere una decisione in un senso o nell'altro. Ma immagino non cambi molto no?",shape=box,color=blue];
		j1221261461 -> j3314262221;
		j1221261461 -> j451539396;
	j3517181625 [label="Che l'Indifferenza sia o meno una divinità, non so bene che posizione prendere sulla questione. Non ho prove sufficienti per prendere una decisione in un senso o nell'altro. Ma immagino non cambi molto no?",shape=box,color=blue];
		j3517181625 -> j3314262221;
		j3517181625 -> j451539396;
	j3314262221 [label="Pensi che cambi molto. Se non è una vera divinità - è stata creata dalle persone. Ciò significa che può essere sconfitta dalle persone.",shape=box,color=red];
		j3314262221 -> j340223397;
	j451539396 [label="Cosa intendi?",shape=box,color=red];
		j451539396 -> j3144790382;
	j340223397 [label="Se non avessi alcuna speranza che potesse essere sconfitta dai nostri sforzi, perché mai ti saresti preso la briga di opporti? Sei davvero una creatura sconcertante.",shape=box,color=blue];
		j340223397 -> j1524871820;
	j3144790382 [label="Il metodo del suo arrivo nel nostro universo non cambia i metodi con cui sconfiggere questa divinità.",shape=box,color=blue];
		j3144790382 -> j453458094;
	j1524871820 [label="Non puoi dire sul serio queste parole. Stai semplicemente 'assecondando' le azioni degli altri, quindi? Stai lottando per mancanza di qualcosa di meglio da fare nel tuo tempo libero?",shape=box,color=blue];
		j1524871820 -> j3578314219;
	j453458094 [label="Ecco: una divinità da noi creata, composta dal tessuno del nostro vuoto.",shape=box,color=blue];
		j453458094 -> j1588193860;
	j3578314219 [label="Sicuramente potresti pensare a un passatempo migliore.",shape=box,color=blue];
		j3578314219 -> j3535186345;
		j3578314219 -> j2844867802;
	j1588193860 [label="Una bambola di stoffa che potremmo riempire eccessivamente di tristezza, del nostro dolore, della nostra sofferenza, della nostra rabbia, della nostra agonia, fino a quando i punti non minacciano di scoppiare.",shape=box,color=blue];
		j1588193860 -> j66862668;
	j3535186345 [label="No, non penso che sia una situazione senza speranza - non è questo che intendevo.",shape=box,color=red];
		j3535186345 -> j3136470304;
	j2844867802 [label="Ciò che intendevo dire è che questo cambia il modo in cui possiamo pensare di sconfiggerla. Capirla.",shape=box,color=red];
		j2844867802 -> j3315311541;
	j66862668 [label="Mi perdonerai se ciò mi riempie di molto più timore di quanto mi avrebbe riempito se si fosse trattato di una divinità esistente prima del nostro arrivo. ",shape=box,color=blue];
		j66862668 -> j2308742756;
	j3136470304 [label="Pensare prima di parlare non è un prerequisito. Nemmeno per i proiettili. ",shape=box,color=blue];
		j3136470304 -> j453458094;
	j3315311541 [label="Non credo che sia vero. Direi che oggi comprendiamo altrettanto poco le sue motivazioni di quanto ne capiremmo se si trattasse di una 'divinità grande e inconoscibile'.",shape=box,color=blue];
		j3315311541 -> j453458094;
	j2308742756 [label="Sì, in effetti credo che lo preferirei.",shape=box,color=blue];
		j2308742756 -> j1145366986;
	j1145366986 [label="Potrebbe esserci qualche speranza che possa essere più intelligente dell'umanità nel suo complesso.",shape=box,color=blue];
		j1145366986 -> j875655795;
	j875655795 [label="Con questo... pensiero completamente desolante, credo che ti lascerò alla tua giornata.",shape=box,color=blue];
		j875655795 -> j742749064;
	j742749064 [label="Check boolean LyonDating",color=orange];
