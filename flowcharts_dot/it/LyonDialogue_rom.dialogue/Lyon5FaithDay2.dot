		1796 -> 1797 [label=true,color=green];
		1796 -> 1799 [label=true,color=green];
		1796 -> 1798 [label=false,color=brown];
		1796 -> 1799 [label=false,color=brown];
	1793 [label="Come hai detto, potremmo... non saperlo mai. E forse non spetta a noi saperlo. Così vanno le cose. Ma non cambia, credo, gli anni che ho trascorso al servizio di un'organizzazione che, in fondo, intendeva compiere buone azioni in questo mondo.",shape=box,color=blue];
		1793 -> 1753;
	1794 [label="Forse hai ragione. Forse la nostra dama d'argento avrebbe potuto concedere una benedizione così tragica. Non avrebbe voluto cancellare il ricordo del dolore, come ne caso di Roathe.",shape=box,color=blue];
		1794 -> 1754;
	1795 [label="Ma non cambia, credo, gli anni che ho trascorso al servizio di un'organizzazione che, in fondo, intendeva compiere buone azioni in questo mondo.",shape=box,color=blue];
		1795 -> 1753;
	1797 [label="Sei d'accordo con Roathe e me sul fatto che l'Uomo nel Muro non sia un vero dio?",shape=box,color=red];
		1797 -> 1800;
	1799 [label="Secondo te, dove si colloca l'Indifferenza in tutto questo?",shape=box,color=red];
		1799 -> 1801;
	1798 [label="Sei d'accordo con Roathe nel pensare che l'Indifferenza sia una vera divinità oppure no?",shape=box,color=red];
		1798 -> 1800;
	1800 [label="Non so bene che posizione prendere sulla questione. Non ho prove sufficienti per prendere una decisione in un senso o nell'altro. Ma immagino non cambi molto no?",shape=box,color=blue];
		1800 -> 1802;
		1800 -> 1803;
	1801 [label="Che l'Indifferenza sia o meno una divinità, non so bene che posizione prendere sulla questione. Non ho prove sufficienti per prendere una decisione in un senso o nell'altro. Ma immagino non cambi molto no?",shape=box,color=blue];
		1801 -> 1802;
		1801 -> 1803;
	1802 [label="Pensi che cambi molto. Se non è una vera divinità - è stata creata dalle persone. Ciò significa che può essere sconfitta dalle persone.",shape=box,color=red];
		1802 -> 1804;
	1803 [label="Cosa intendi?",shape=box,color=red];
		1803 -> 1805;
	1804 [label="Se non avessi alcuna speranza che potesse essere sconfitta dai nostri sforzi, perché mai ti saresti preso la briga di opporti? Sei davvero una creatura sconcertante.",shape=box,color=blue];
		1804 -> 1806;
	1805 [label="Il metodo del suo arrivo nel nostro universo non cambia i metodi con cui sconfiggere questa divinità.",shape=box,color=blue];
		1805 -> 1807;
	1806 [label="Non puoi dire sul serio queste parole. Stai semplicemente 'assecondando' le azioni degli altri, quindi? Stai lottando per mancanza di qualcosa di meglio da fare nel tuo tempo libero?",shape=box,color=blue];
		1806 -> 1808;
	1807 [label="Ecco: una divinità da noi creata, composta dal tessuno del nostro vuoto.",shape=box,color=blue];
		1807 -> 1809;
	1808 [label="Sicuramente potresti pensare a un passatempo migliore.",shape=box,color=blue];
		1808 -> 1810;
		1808 -> 1811;
	1809 [label="Una bambola di stoffa che potremmo riempire eccessivamente di tristezza, del nostro dolore, della nostra sofferenza, della nostra rabbia, della nostra agonia, fino a quando i punti non minacciano di scoppiare.",shape=box,color=blue];
		1809 -> 1812;
	1810 [label="No, non penso che sia una situazione senza speranza - non è questo che intendevo.",shape=box,color=red];
		1810 -> 1813;
	1811 [label="Ciò che intendevo dire è che questo cambia il modo in cui possiamo pensare di sconfiggerla. Capirla.",shape=box,color=red];
		1811 -> 1814;
	1812 [label="Mi perdonerai se ciò mi riempie di molto più timore di quanto mi avrebbe riempito se si fosse trattato di una divinità esistente prima del nostro arrivo. ",shape=box,color=blue];
		1812 -> 1815;
	1813 [label="Pensare prima di parlare non è un prerequisito. Nemmeno per i proiettili. ",shape=box,color=blue];
		1813 -> 1807;
	1814 [label="Non credo che sia vero. Direi che oggi comprendiamo altrettanto poco le sue motivazioni di quanto ne capiremmo se si trattasse di una 'divinità grande e inconoscibile'.",shape=box,color=blue];
		1814 -> 1807;
	1815 [label="Sì, in effetti credo che lo preferirei.",shape=box,color=blue];
		1815 -> 1816;
	1816 [label="Potrebbe esserci qualche speranza che possa essere più intelligente dell'umanità nel suo complesso.",shape=box,color=blue];
		1816 -> 1817;
	1817 [label="Con questo... pensiero completamente desolante, credo che ti lascerò alla tua giornata.",shape=box,color=blue];
		1817 -> 1818;
	1818 [label="Check boolean LyonDating",color=orange];
		1818 -> 1820 [label=true,color=green];
		1818 -> 1819 [label=false,color=brown];
	1820 [label="+20 Chemistry",color=orange];
		1820 -> 1822;
