		j3287457751 -> j2399994124 [label="DrifterFaithNoMITW",color=purple];
		j3287457751 -> j3936279884 [label="DrifterFaithNoMaybe",color=purple];
		j3287457751 -> j2553191400 [label="false",color=purple];
	j2960748986 [label="Mentre Sol avrebbe bruciato il dolore come un coltello caldo cauterizza una ferita - Lua mi avrebbe lasciato abbracciare il calore del dolore che la sua assenza avrebbe potuto portare.",shape=box,color=blue];
		j2960748986 -> j3795708625;
	j2850303154 [label="E so che, se riuscissi ancora a trovare la presenza di Rell e del suo Harrow, non vorrebbero che io soffra per la loro perdita. Loro sono in pace.",shape=box,color=blue];
		j2850303154 -> j285807123;
	j48441609 [label="Oh, Lyon... hai sofferto così tanto. Il dubbio non è frutto di debolezza - è frutto del dolore.",shape=box,color=red];
		j48441609 -> j197800824;
		j48441609 -> j928179209;
		j48441609 -> j2576511067;
		j48441609 -> j3353404011;
		j48441609 -> j726152985;
	j3794974304 [label="La fede non deve essere costante - né ci si aspetta che lo sia. Quante storie si raccontano di persone che perdono la fede, solo per poi ritrovarla?",shape=box,color=red];
		j3794974304 -> j197800824;
		j3794974304 -> j928179209;
		j3794974304 -> j2576511067;
	j3133773648 [label="Hai dedicato la tua vita ai nostri Luminari, Lyon. Pensi che ti volterebbero le spalle per una cosa del genere?",shape=box,color=red];
		j3133773648 -> j197800824;
		j3133773648 -> j928179209;
		j3133773648 -> j2576511067;
	j1200341783 [label="Non so se gli dei esistano o no, Lyon - non credo che potremo mai saperlo veramente. Ma quello che so è che hai passato momenti difficili.",shape=box,color=red];
		j1200341783 -> j197800824;
		j1200341783 -> j2576511067;
		j1200341783 -> j3353404011;
	j3936279884 [label="Anche se personalmente non credo che ci siano dei in questo mondo, so quanto questo sia stato importante per te nella tua vita. Non voglio sminuirlo.",shape=box,color=red];
		j3936279884 -> j2576511067;
		j3936279884 -> j726152985;
	j2399994124 [label="L'Indifferenza è stata creata da noi - non è una divinità, Lyon. Non lasciare che l'errore di Entrati ti distrugga. E la tua fede?",shape=box,color=red];
		j2399994124 -> j2576511067;
		j2399994124 -> j726152985;
	j2553191400 [label="Odio vederti così, intrappolato nel mezzo delle sciocchezze di tutti. Non te lo meriti.",shape=box,color=red];
		j2553191400 -> j197800824;
		j2553191400 -> j928179209;
		j2553191400 -> j2576511067;
		j2553191400 -> j3353404011;
		j2553191400 -> j726152985;
	j3795708625 [label="Perché è l'assenza di dolore che minaccia di distruggerci, così come la sua abbondanza potrebbe annegarci.",shape=box,color=blue];
		j3795708625 -> j884533908;
		j3795708625 -> j285568019;
		j3795708625 -> j167953520;
	j285807123 [label="Né credo che tutta la mia sofferenza sia stata inutile. Ciò non invalida tutto ciò che ho sopportato.",shape=box,color=blue];
		j285807123 -> j3240689467;
	j197800824 [label="Non sto dicendo che devi ritrovare la fede. Sto dicendo che se lo vuoi - se senti di doverlo fare - non è qualcosa che si perde per sempre.",shape=box,color=red];
		j197800824 -> j3196894425;
	j928179209 [label="Di sicuro, Lua può vedere cosa hai dovuto passare. Cosa hai sopportato in suo nome. ",shape=box,color=red];
		j928179209 -> j1284398036;
	j2576511067 [label="Penso che ciò su cui dovresti concentrarti sia trovare una sorta di pace dentro di te - qualunque sia il modo in cui devi trovarla.",shape=box,color=red];
		j2576511067 -> j3196894425;
	j3353404011 [label="Se esiste un dio, se Lua esiste davvero - sicuramente può vedere cosa hai passato. Cosa hai sopportato in suo nome. Deve significare qualcosa per lei.",shape=box,color=red];
		j3353404011 -> j1284398036;
	j726152985 [label="Penso che dovresti abbandonare qualsiasi idea sull'esistenza o meno degli dei e concentrarti prima di tutto sulla guarigione di te stesso.",shape=box,color=red];
		j726152985 -> j3871305291;
	j884533908 [label="Fidati... so quanto può essere pericolosa l'apatia.",shape=box,color=red];
		j884533908 -> j1093366908;
	j285568019 [label="Ciò significa che hai ritrovato la fede?",shape=box,color=red];
		j285568019 -> j410368257;
	j167953520 [label="[Fine.]",shape=box,color=red];
		j167953520 -> j3856020424;
	j3240689467 [label="Perché è l'assenza di dolore che minaccia di distruggerci, così come la sua abbondanza potrebbe annegarci.",shape=box,color=blue];
		j3240689467 -> j884533908;
