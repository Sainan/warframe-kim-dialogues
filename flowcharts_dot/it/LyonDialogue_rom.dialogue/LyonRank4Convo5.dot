digraph {
	1076 [label="LyonRank4Convo5 begins.",color=orange];
		1076 -> 1077;
	1077 [label="Check boolean LyonSerum1",color=orange];
		1077 -> 1079 [label=true,color=green];
		1077 -> 1080 [label=true,color=green];
		1077 -> 1078 [label=false,color=brown];
		1077 -> 1080 [label=false,color=brown];
	1079 [label="Lyon, mi chiedevo se potessi sentire il resto della storia di come Roathe arrivò alla Cattedrale con te e Marie?",shape=box,color=red];
		1079 -> 1082;
	1080 [label="[Fine.]",shape=box,color=red];
		1080 -> 1083;
	1078 [label="Lyon, mi chiedevo se potessi sentire la storia di come Roathe arrivò alla Cattedrale con te e Marie?",shape=box,color=red];
		1078 -> 1081;
	1082 [label="Come desideri. Tuttavia, non è una storia particolarmente piacevole. È stato abbandonato sulla soglia di casa nostra come un gatto randagio ferito.",shape=box,color=blue];
		1082 -> 1084;
	1083 [label="Chat ends.",color=orange];
	1081 [label="Come desideri. È stato abbandonato sulla soglia di casa nostra come un gatto randagio ferito. La storia non è delle più piacevoli.",shape=box,color=blue];
		1081 -> 1084;
	1084 [label="Evaluate expressions",color=orange];
		1084 -> 1087 [label="LyonStray",color=purple];
		1084 -> 1086 [label="RoatheSerum1",color=purple];
		1084 -> 1085 [label="false",color=purple];
	1087 [label="Avevo ragione, quella storia doveva riguardare Roathe.",shape=box,color=red];
		1087 -> 1090;
	1086 [label="Da come lo racconta, aveva tutte le ragione per essere un po'... selvaggio, quando si è presentato.",shape=box,color=red];
		1086 -> 1089;
	1085 [label="Va bene, continua.",shape=box,color=red];
		1085 -> 1088;
	1090 [label="Era la storia di una gatto randagio che era solito visitare la Cattedrale. Ciò che ne trarrai dal significato, o il motivo per cui te lo racconto, è interamente responsabilità tua. Sono un sacerdote, no?",shape=box,color=blue];
		1090 -> 1088;
	1089 [label="Mi aspetterei che una persona del suo status e della sua indole si sentisse offesa dalle azioni intraprese da Entrati nei sui confronti. Onestamente, sarei molto più sorpreso se avesse gestito la situazione con grazia.",shape=box,color=blue];
		1089 -> 1088;
	1088 [label="Evaluate expressions",color=orange];
		1088 -> 1092 [label="LyonSerum1",color=purple];
		1088 -> 1091 [label="false",color=purple];
	1092 [label="Credo che, dove ci evaramo lasciati, Entrati fosse da poco tornato dalla sua scomparsa, con Roathe, come lo vediamo ora, già cambiato. Entrati ci ha rivelato tutte le bugie che aveva detto per oltre tre anni.",shape=box,color=blue];
		1092 -> 1094;
	1091 [label="Cercherò di riassumere gli eventi che hanno portato a quel momento, altrimenti potrebbe sembrare... nella migliore delle ipotesi... insensato.",shape=box,color=blue];
		1091 -> 1093;
	1094 [label="Ci ha offerto i \"sieri protoframe\" che ci hanno reso ciò che siamo ora e, una volta che li abbiamo accettati... ci ha immediatamente abbandonati di nuovo.",shape=box,color=blue];
		1094 -> 1096;
	1093 [label="Per tre anni, due mesi e undici giorni, ha ricoperto il ruolo di Cardinal Dimanche nella nostra Cattedrale. E per tutto quel tempo, Marie e io lo abbiamo servito senza sapere il suo piano per noi.",shape=box,color=blue];
		1093 -> 1095;
	1096 [label="E lì siamo rimasti, come amalgame appena orfane, con corpi e anime trasformati in creazioni che riuscivamo a malapena a comprendere, per non parlare di rivendicare il controllo.",shape=box,color=blue];
		1096 -> 1098;
	1095 [label="Conosco le tue domande prima che tu le ponga. Cosa stava tramando? Ha infettato la città, come ho sentito dire che ha fatto con Höllvania? Quali erano i suoi piani? Le sue scoperte?",shape=box,color=blue];
		1095 -> 1097;
	1098 [label="Bloccati in una città che era la nostra casa, ma non più amica, siamo stati... costretti a nasconderci.",shape=box,color=blue];
		1098 -> 1100;
		1098 -> 1101;
	1097 [label="A queste dirò, rimarrai deluso. Predicava. Studiava. Si riposava. E pregava. Poi, una notte, scomparve nel mezzo di una terribile tempesta. La stessa in cui era apparso.",shape=box,color=blue];
		1097 -> 1099;
	1100 [label="Per il tuo aspetto?",shape=box,color=red];
		1100 -> 1104;
	1101 [label="La Cattedrale ti ha respinto?",shape=box,color=red];
		1101 -> 1105;
	1099 [label="Check boolean MarieLyonVisions",color=orange];
		1099 -> 1103 [label=true,color=green];
		1099 -> 1102 [label=false,color=brown];
	1104 [label="Non so se ti è sfuggito, ma Marie sa volare e Roathe è... blu, tra le altre cose.",shape=box,color=blue];
		1104 -> 1107;
	1105 [label="Non... precisamente. Siamo stati costretti ad abbandonare la vita pubblica. Ma i nostri Fratelli e Sorelle non ci hanno esiliato in piazza, né bruciato sul rogo. Il \"Cardinal Dimanche\" li ha convinti che i nostri cambiamenti erano... opera dei Luminari.",shape=box,color=blue];
		1105 -> 1108;
	1103 [label="Sebbene sappia che la tempesta non sia capitata ad altri, per me è stata piuttosto vivida.",shape=box,color=blue];
		1103 -> 1102;
	1102 [label="Esattamente un anno dopo, riapparve un'ultima volta, con... Roathe, come lo vedi ora, accasciato e privo di sensi ai suoi piedi.",shape=box,color=blue];
		1102 -> 1106;
	1107 [label="So che passi le tue giornate a divertirti con animali parlanti e teschi e a riflettere sulla questione del Void cosmico, ma per la maggior parte degli esseri umani questo non è un problema comune.",shape=box,color=blue];
		1107 -> 1110;
	1108 [label="Eravamo nascosti nelle cripte e tenuti fuori dalla vista. I nostri ex confratelli, sebbene terrorizzati da noi, ci portavano provviste.",shape=box,color=blue];
		1108 -> 1111;
	1106 [label="Un diavolo in carne e ossa, o almeno così sembrava. Fu allora che Entrati ci raccontò la verità su chi era - quando ci salutò - e il vero compito che aveva per noi. Che ci aveva scelti entrambi per una \"missione sacra\".",shape=box,color=blue];
		1106 -> 1109;
	1110 [label="In effetti, io sono uno dei tre che potrebbe forse aggirarsi tra la folla se mi nascondessi abbastanza bene. ",shape=box,color=blue];
		1110 -> 1113;
		1110 -> 1114;
	1111 [label="Loro... insistevano per interagire solo con Marie, nonostante le sue improvvise apparizioni spettrali sulle scale per salutarli. ",shape=box,color=blue];
		1111 -> 1115;
		1111 -> 1116;
	1109 [label="Marie accettò il siero con prontezza. Ovviamente. Come non avrebbe potuto farlo? E come avrei potuto non seguirla? Come avrei potuto non cercare la verità, ovunque mi avrebbe condotto?",shape=box,color=blue];
		1109 -> 1112;
	1113 [label="Dove stavate?",shape=box,color=red];
		1113 -> 1120;
	1114 [label="Come siete finiti qui?",shape=box,color=red];
		1114 -> 1121;
	1115 [label="Posso capire evitare Roathe, ma... preferirebbero questo piuttosto che parlare con te?",shape=box,color=red];
		1115 -> 1122;
	1116 [label="Lei è molto dolce...",shape=box,color=red];
		1116 -> 1123;
	1112 [label="Update boolean LyonSerum1",color=orange];
		1112 -> 1117;
		1112 -> 1118;
		1112 -> 1119;
	1120 [label="I nostri Fratelli e Sorelle non ci hanno esiliato in piazza, né bruciato sul rogo. Il \"Cardinal Dimanche\" li ha convinti che i nostri cambiamenti erano... opera dei Luminari.",shape=box,color=blue];
		1120 -> 1127;
	1121 [label="Roathe conoscerà i dettagli del \"come\" esattamente, ma dopo... molti anni di lavoro, ha creato un \"Helminth\" da campioni del nostro sangue.",shape=box,color=blue];
		1121 -> 1128;
	1122 [label="Credo che ci siamo già incontrati, non è vero?",shape=box,color=blue];
		1122 -> 1129;
	1123 [label="Precisamente.",shape=box,color=blue];
		1123 -> 1130;
	1117 [label="Penso che lei ancora veneri un po' troppo Entrati.",shape=box,color=red];
		1117 -> 1124;
	1118 [label="Cosa accadde dopo?",shape=box,color=red];
		1118 -> 1125;
	1119 [label="Te ne sei pentito?",shape=box,color=red];
		1119 -> 1126;
	1127 [label="Eravamo nascosti nelle cripte e tenuti fuori dalla vista. I nostri ex confratelli, sebbene terrorizzati da noi, ci portavano provviste.",shape=box,color=blue];
		1127 -> 1134;
	1128 [label="Credo che l'Infestazione sia collegate a se stessa attraverso.. il tempo... in qualche modo... anche se i dettagli mi sfuggono.",shape=box,color=blue];
		1128 -> 1135;
		1128 -> 1136;
	1129 [label="Per quanto tempo siete rimasti intrappolati laggiù?",shape=box,color=red];
		1129 -> 1137;
	1130 [label="Quindi... vi hanno tenuti tutti in cantina?",shape=box,color=red];
		1130 -> 1138;
	1124 [label="Update boolean LyonMarieEntrati",color=orange];
		1124 -> 1131;
	1125 [label="Roathe si risvegliò. All'inizio, riusciva a mala pena a ricordare il suo nome. Entrati dice una sola frase di commianto al bastardo. \"Uriel, Eretico di Xata, in esilio. rispondi - gli Orokin potranno mai essere perdonati?\"",shape=box,color=blue];
		1125 -> 1132;
	1126 [label="Mi pento di tutto, Drifter. Sì, certo che me ne pento. Ma lo rifarei? Sì, certo che lo rifarei. Non potrei lasciare Marie da sola.",shape=box,color=blue];
		1126 -> 1133;
	1134 [label="Loro... insistevano per interagire solo con Marie, nonostante le sue improvvise apparizioni spettrali sulle scale per salutarli. ",shape=box,color=blue];
		1134 -> 1139;
		1134 -> 1140;
	1135 [label="Ha fatto un'operazione di ingegneria inversa su un Helminth?! Quando tempo ci è voluto?!",shape=box,color=red];
		1135 -> 1141;
	1136 [label="Non credo che nessuno lo capisca. È una nuova scoperta.",shape=box,color=red];
		1136 -> 1142;
	1137 [label="Forse non sono io la persona a cui dovresti chiedere quanti anni sono passati da quando siamo diventati amalgame parlanti Infested. La mia comprensione del passare del tempo da allora è stata... contorta.",shape=box,color=blue];
		1137 -> 1143;
		1137 -> 1144;
	1138 [label="Sembra forse più duro di quanto sembri. Non c'era nessun altro posto dove metterci. Il campanile era troppo aperto, troppo esposto alle intemperie. La cripta era riparata e calda.",shape=box,color=blue];
		1138 -> 1145;
	1131 [label="Su questo siamo d'accordo. Ma non posso biasimarla. Dalle tempo. Capirà. È incredibilmente intelligente, Drifter. Non trattarla come una sciocca.",shape=box,color=blue];
		1131 -> 1133;
	1132 [label="Entrati se ne andò per l'ultima volta. E abbandonò Roathe con noi, ora trasformato in ciò che vedi - in grado di affontare un diavolo capriccioso.",shape=box,color=blue];
		1132 -> 1096;
	1133 [label="Per continuare il raccondo... Entrati se ne andò per l'ultima volta. E abbandonò Roathe con noi, ora trasformato in ciò che vedi - in grado di affontare un diavolo capriccioso.",shape=box,color=blue];
		1133 -> 1096;
	1139 [label="Posso capire evitare Roathe, ma... preferirebbero questo piuttosto che parlare con te?",shape=box,color=red];
		1139 -> 1146;
	1140 [label="Lei è molto dolce...",shape=box,color=red];
		1140 -> 1147;
	1141 [label="Update boolean LyonRoatheHelminth",color=orange];
		1141 -> 1148;
	1142 [label="Non so se sia confortante o sconfortate saperlo, grazie. È abbastanza strano sapere ora che l'Infestazione può parlare.",shape=box,color=blue];
		1142 -> 1149;
		1142 -> 1150;
	1143 [label="In che senso è contorta?",shape=box,color=red];
		1143 -> 1151;
	1144 [label="Non so se dovrei dirti che l'Infestazione può anche parlare...",shape=box,color=red];
		1144 -> 1152;
	1145 [label="E sfortunatamente, abbiamo scoperto che c'erano delle uscite che Roathe poteva usare per... vagare.",shape=box,color=blue];
		1145 -> 1153;
	1146 [label="Credo che ci siamo già incontrati, non è vero?",shape=box,color=blue];
		1146 -> 1129;
		1146 -> 1130;
	1147 [label="Precisamente.",shape=box,color=blue];
		1147 -> 1130;
		1147 -> 1129;
	1148 [label="Forse non sono io la persona giusta a cui chiedere. Da allora, la mia comprensione del passare del tempo è diventata... contorta. Anche se forse sarebbe più corretto dire \"più contorta\". Come se la situazione non potesse diventare più terrificante...",shape=box,color=blue];
		1148 -> 1143;
		1148 -> 1144;
	1149 [label="Non tutti gli oggetti domestici. Le sedie a volte possono essere... beh... non importa, procedi pure.",shape=box,color=red];
		1149 -> 1154;
	1150 [label="Ti risparmierò la conversazione sulla chitarra.",shape=box,color=red];
		1150 -> 1155;
	1151 [label="Update boolean LyonTime1",color=orange];
		1151 -> 1156;
	1152 [label="Credimi, lo so. Ed è sconcertante, grazie. Anche se sembra che ogni oggetto domestico in questo posto possa parlare.",shape=box,color=blue];
		1152 -> 1149;
		1152 -> 1150;
	1153 [label="Evaluate expressions",color=orange];
		1153 -> 1157 [label="MarieRoathePastry1",color=purple];
		1153 -> 1157 [label="RoatheMariePastry1",color=purple];
		1153 -> 1158 [label="false",color=purple];
	1154 [label="Se la parola che stavi per dire era \"occupate\", l'ho vista anch'io, Drifter. Quella che sussurrava. Quella dentro il muro. Ho sentito il bussare...",shape=box,color=blue];
		1154 -> 1159;
	1155 [label="Fallo. Anche se, credo, troverai molto più confortante avere uno strumento musicale come un semidio transitorio piuttosto che... qualsiasi altra cosa sia venuta a tormentare e abbandonare la mia mente. È strano che io... da quando lui...",shape=box,color=blue];
		1155 -> 1160;
	1156 [label="Non so se ciò sia dovuto semplicemente alla mia particolare sensibilità verso la questione... o alle circostanza individuali della mia creazione... o lui -",shape=box,color=blue];
		1156 -> 1161;
	1157 [label="Così ho sentito dire.",shape=box,color=red];
		1157 -> 1162;
	1158 [label="Oh?",shape=box,color=red];
		1158 -> 1163;
	1159 [label="C'è una voce che mi ha fatto udire e che so di non aver mai sentito per tutta la vita, ma che si estende nel mio passato e nel mio futuro...",shape=box,color=blue];
		1159 -> 1164;
	1160 [label="Lui?",shape=box,color=red];
		1160 -> 1159;
	1161 [label="E so che mi considererete un vero pazzo quando dico questo, ma non percepisco il tempo in modo... puramente... lineare.",shape=box,color=blue];
		1161 -> 1165;
		1161 -> 1166;
	1162 [label="Penso che sia una delle sue poche qualità positive. Non il furto, intendiamoci. Il ragionamento che c'è dietro. La mia teoria è che si sia procurato la merce illecita per indurre Marie a parlare con lui.",shape=box,color=blue];
		1162 -> 1167;
	1163 [label="Non è né qui né là.",shape=box,color=blue];
		1163 -> 1168;
		1163 -> 1169;
	1164 [label="Non è possibile che sia sempre stato lì. Eppure ora lo ricordo, nitido come la luce argentea di Lua stessa, dietro il muro della mia casa d'infanzia. La voce di un giovane. La presenza di un altro in piedi accanto a lui... \"Rap tap tap...\"",shape=box,color=blue];
		1164 -> 1170;
	1165 [label="\"Lui?\" Chi è \"lui\"?",shape=box,color=red];
		1165 -> 1159;
	1166 [label="Per un numero incalcolabile di secoli ho vissuto il tempo come una spirale che si avvolge, Lyon.",shape=box,color=red];
		1166 -> 1171;
	1167 [label="E, forse, perché la facevano ridere, quando pensava che lui non la stesse guardando. Una volta mi disse \"È una grande colpa del destino che le sia stata tolta la vita.\"",shape=box,color=blue];
		1167 -> 1172;
	1168 [label="Quanto tempo ci avete messo per tornare tutti... beh, ad adesso?",shape=box,color=red];
		1168 -> 1173;
	1169 [label="Cosa accadde dopo?",shape=box,color=red];
		1169 -> 1121;
	1170 [label="Per... perdonami. Devo andare. Non riesco ancora a parlarne. Mi... mi dispiace. Non chiedermelo più.",shape=box,color=blue];
		1170 -> 1174;
	1171 [label="Cosa intendi allora, quando parlo di una voce che mi ha guidato al di là della mia mente razionale? So di non averla sentita per tutta la vita. Non è possibile che sia sempre stata lì.",shape=box,color=blue];
		1171 -> 1175;
	1172 [label="Update boolean LyonRoathePastry",color=orange];
		1172 -> 1176;
		1172 -> 1168;
	1173 [label="Forse non sono io la persona a cui dovresti chiedere quanti anni sono passati da quando siamo diventati amalgame parlanti Infested. La mia comprensione del passare del tempo da allora è stata... contorta.",shape=box,color=blue];
		1173 -> 1144;
		1173 -> 1143;
	1174 [label="Lyon, aspetta!",shape=box,color=red];
		1174 -> 1177;
	1175 [label="Eppure ora lo ricordo, nitido come la luce argentea di Lua stessa, dietro il muro della mia casa d'infanzia. La voce di un giovane... \"Rap tap tap...\"",shape=box,color=blue];
		1175 -> 1170;
	1176 [label="Per lui è quasi adorabile hai ragione. Cosa accadde dopo?",shape=box,color=red];
		1176 -> 1121;
	1177 [label="Update boolean LyonRell1",color=orange];
		1177 -> 1178;
	1178 [label="+20 Chemistry",color=orange];
		1178 -> 1179;
	1179 [label="Chat ends.",color=orange];
}