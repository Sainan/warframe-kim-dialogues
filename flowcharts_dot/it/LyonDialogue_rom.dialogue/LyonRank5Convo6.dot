	j3436192592 [label="Drifter. Una richiesta, se posso?",shape=box,color=blue];
		j3436192592 -> j1192600429;
		j3436192592 -> j4115718638;
	j2270517238 [label="Posso prendermi un momento per complimentarmi con te per qualcosa che finora ritenevo impossibile?",shape=box,color=blue];
		j2270517238 -> j3898938099;
		j2270517238 -> j1617130249;
		j2270517238 -> j4115718638;
	j647344327 [label="Devo porgerle le mie condoglianze per i suoi nobili ma tragicamente brevi sforzi per quanto riguarda Marie e la questione de 'le Cardinal'.",shape=box,color=blue];
		j647344327 -> j1617130249;
		j647344327 -> j3898938099;
		j647344327 -> j4115718638;
	j4259858257 [label="Mi dispiace che tu e Marie non abbiate trovato un accordo sulle questioni riguardanti 'le Cardinal'. Ma sono felice che la situazione non sia degenerata.",shape=box,color=blue];
		j4259858257 -> j1617130249;
		j4259858257 -> j3898938099;
		j4259858257 -> j4115718638;
	"Chat ends." [color=orange];
	j1192600429 [label="Di cosa si tratta?",shape=box,color=red];
		j1192600429 -> j2760484161;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j3898938099 [label="Non sono esattamente orgoglioso di alcune delle cose che ho detto, ma... ",shape=box,color=red];
		j3898938099 -> j2296470124;
	j1617130249 [label="Ti ha raccontato tutto, non è vero?",shape=box,color=red];
		j1617130249 -> j2643607640;
	j2760484161 [label="Per favore, convinci Marie a smettere di utilizzare i necramite per replicare i mobili. Non so proprio cosa fare con tutte queste sedie.",shape=box,color=blue];
		j2760484161 -> j1415854123;
	j2296470124 [label="Dopotutto, c'è un motivo per cui è stato inventato il termine 'crimine passionale'. Se noi, come creature, non fossimo fedeli alle nostre convinzioni, la vita sarebbe terribilmente noiosa, credo.",shape=box,color=blue];
		j2296470124 -> j4254636147;
	j2643607640 [label="Lo ha fatto. Parliamo ogni sera di quello che è successo durante il giorno. E dopo la vostra conversazione, è corsa subito da me per raccontarmi tutto.",shape=box,color=blue];
		j2643607640 -> j1228756771;
		j2643607640 -> j173595572;
	j1415854123 [label="+20 Chemistry",color=orange];
		j1415854123 -> j265617492;
	j4254636147 [label="Certamente più tranquilla. Più pacifica. Ma noiosa. Di certo non ci sarebbe arte di cui parlare.",shape=box,color=blue];
		j4254636147 -> j1175780930;
	j1228756771 [label="Cosa ti ha detto?",shape=box,color=red];
		j1228756771 -> j3495933037;
	j173595572 [label="... E?",shape=box,color=red];
		j173595572 -> j3495933037;
	j265617492 [label="E mi rifiuto di accettare i suoi... coloriti suggerimenti su dove all'interno dell'anatomia di Roathe dovrebbero essere immagazzinate.",shape=box,color=blue];
		j265617492 -> "Chat ends.";
	j1175780930 [label="Ma sto divagando. Mi chiedo - nelle mie conversazioni con lei, sembra che le tue parole siano state commoventi. Devo chiederti - sei soddisfatto di come hai risolto le cose tra voi?",shape=box,color=blue];
		j1175780930 -> j1424199455;
	j3495933037 [label="Check boolean LyonDating",color=orange];
		j3495933037 -> j1696390046 [label=true,color=green];
		j3495933037 -> j2652396405 [label=false,color=brown];
	j1424199455 [label="Evaluate expressions",color=orange];
		j1424199455 -> j1854226823 [label="MarieDating, MarieFamilyFail",color=purple];
		j1424199455 -> j4135441047 [label="MarieDating, MarieFamilyFail",color=purple];
		j1424199455 -> j1802341620 [label="MarieFamilyFail",color=purple];
		j1424199455 -> j1671554454 [label="MarieFamilyFail",color=purple];
		j1424199455 -> j1854226823 [label="MarieFamilySuccess",color=purple];
		j1424199455 -> j3629971437 [label="MarieEntratiCompleteA",color=purple];
		j1424199455 -> j2871147528 [label="MarieEntratiCompleteB",color=purple];
		j1424199455 -> j2638964865 [label="MarieEntratiCompleteB",color=purple];
		j1424199455 -> j983259808 [label="MarieEntratiCompleteC",color=purple];
		j1424199455 -> j1585323749 [label="false",color=purple];
	j1696390046 [label="Ah! Come se volessi tradire la sua fiducia nei tuoi confronti. Per quanto tu sia prezioso per me, mon miracle - lei è stata la sorella della mia anima per molti, molti anni.",shape=box,color=blue];
		j1696390046 -> j2753989910;
	j2652396405 [label="Ah! Come se volessi tradire la sua fiducia nei tuoi confronti. Per quanto tu sia prezioso per me, amico mio - lei è stata la sorella della mia anima per molti, molti anni.",shape=box,color=blue];
		j2652396405 -> j2753989910;
	j1854226823 [label="Sì. Credo che avremo il suo aiuto per riparare le cose tra Loid e la famiglia al piano di sopra. E questa è... una notizia stupenda, Lyon. Non credo di riuscire a spiegare quanto sia stupenda.",shape=box,color=red];
		j1854226823 -> j1775020439;
	j4135441047 [label="No - Sinceramente, per come sono andate le cose tra noi, ho rovinato ogni possibilità che lei aiutasse a sistemare le cose tra Loid e la famiglia al piano di sopra.",shape=box,color=red];
		j4135441047 -> j2170887763;
	j1802341620 [label="No - Sinceramente, per come sono andate le cose tra noi, ho rovinato ogni possibilità che lei aiutasse a sistemare le cose tra Loid e la famiglia al piano di sopra.",shape=box,color=red];
		j1802341620 -> j759567315;
	j1671554454 [label="Lo sono. Lei non mi aiuterà a sistemare le cose tra Loid e la famiglia al piano di sopra, e per me va bene così.",shape=box,color=red];
		j1671554454 -> j1339629754;
	j3629971437 [label="Lo sono. Sono contento che abbia capito che Entrati potrebbe non essere 'buono' e... beh, che comunque non è nemmeno 'malvagio', no?",shape=box,color=red];
		j3629971437 -> j1055624047;
	j2871147528 [label="Sono contento di come ho lasciato le cose. Onestamente, più ci penso, più sono dalla sua parte per quanto riguarda Entrati.",shape=box,color=red];
		j2871147528 -> j1339629754;
	j2638964865 [label="Non eravamo d'accordo su Entrati. Non sono riuscito a convincerla e... vorrei solo aver potuto fare di meglio.",shape=box,color=red];
		j2638964865 -> j1817140570;
	j983259808 [label="Abbiamo 'concordato di non essere d'accordo' su Entrati, e credo che questo sia il massimo che potremo mai ottenere sull'argomento. Non credo che ulteriori discussioni possano migliorare la situazione.",shape=box,color=red];
		j983259808 -> j2735031350;
	j1585323749 [label="Onestamente, va bene così. Non credo che a questo punto la situazione migliorerà o peggiorerà.",shape=box,color=red];
		j1585323749 -> j2735031350;
	j2753989910 [label="No, temo che le sue parole rimarranno segrete. Ma per lei erano comunque commoventi. Mi chiedo però se sei soddisfatto di come hai risolto le cose tra voi due?",shape=box,color=blue];
		j2753989910 -> j1424199455;
	j1775020439 [label="Credo di poterne comprendere la grandiosità, se non la portata. Sono... molto onorato di farne parte, anche se in piccola parte.",shape=box,color=blue];
		j1775020439 -> j2975833402;
		j1775020439 -> j528325063;
	j2170887763 [label="Affascinante... Beh, ora sei il suo amante, non è vero? Se qualcuno in questo posto avesse l'influenza necessaria per convincerla - saresti proprio tu, no?",shape=box,color=blue];
		j2170887763 -> j3666481167;
	j759567315 [label="Affascinante... Beh, è risaputo che ho una certa... influenza su di lei, per quanto limitata possa essere. Credi che questo ricucire i rapporti tra M. Loid e la famiglia di Entrati sia così importante?",shape=box,color=blue];
		j759567315 -> j1868149062;
		j759567315 -> j1615202915;
	j1339629754 [label="Non so se si tratti di irrascibilità, arroganza, ignoranza o apatia. Quindi opterò per un mix di tutti e quattro e andrò avanti con la mia giornata.",shape=box,color=blue];
		j1339629754 -> j633318722;
	j1055624047 [label="Esatto. La penso come te. Non credo che lui la pensi in un modo o nell'altro, per ora... le sue motivazioni sono contrastanti.",shape=box,color=blue];
		j1055624047 -> j543460984;
	j1817140570 [label="Mh. Beh, sfortunatamente, arriva un momento in cui tutto deve essere messo a tacere. Un impasto può essere lavorato troppo. Un artista può aggiungere troppi particolari al suo dipinto. E una discussione può certamente essere troppo elaborata.",shape=box,color=blue];
		j1817140570 -> j3105450420;
	j2735031350 [label="Sì, forse sarebbe meglio passare ad altri argomenti.",shape=box,color=blue];
		j2735031350 -> j3374917316;
	j2975833402 [label="Non pensavo che ti saresti offerto di aiutarmi.",shape=box,color=red];
		j2975833402 -> j1651479034;
	j528325063 [label="Questo significa che mi aiuterai a convincere Loid ad andare di sopra e a parlare con loro?",shape=box,color=red];
		j528325063 -> j475481549;
	j3666481167 [label="Spero semplicemente che tu non abbia fatto alcun sacrificio nelle tue parole nei suoi confronti - dando priorità a una cosa piuttosto che a un'altra nel tentativo di corteggiarla.",shape=box,color=blue];
		j3666481167 -> j4169402417;
	j1868149062 [label="C'è così tanta solitudine in questo mondo, Lyon. Così tanta tristezza. Perché non porvi fine se è possibile farlo? ",shape=box,color=red];
		j1868149062 -> j1240217240;
	j1615202915 [label="Non ne sono sicuro, è un istinto - una sensazione viscerale. Ho la sensazione che Entrati vi abbia portato qui in questo momento per un motivo.",shape=box,color=red];
		j1615202915 -> j2704522403;
	j633318722 [label="Vergogna.",shape=box,color=blue];
		j633318722 -> j3497962379;
	j543460984 [label="L'arroganza lo spingeva. Un'avidità di conoscenza. Ora, forse, un'avidità di perdono. Chi può dirlo? Mi chiedo se lui stesso lo sappia.",shape=box,color=blue];
		j543460984 -> j1128596256;
	j3105450420 [label="Immagino che sceglierei semplicemente di lasciar perdere. E sperare che un giorno lei possa avere la possibilità di vedere Entrati per quello che sappiamo essere - nella migliore delle ipotesi, complicato.",shape=box,color=blue];
		j3105450420 -> j1128596256;
	j3374917316 [label="Personalmente, sono pronto alle loro infinite conversazioni riguardanti il meraviglioso e impeccabile 'Cardinal.'",shape=box,color=blue];
		j3374917316 -> j1128596256;
	j1651479034 [label="So di non essere particolarmente affabile, ma non sono nemmeno un demone. Se desideri il mio aiuto, lo avrai.",shape=box,color=blue];
		j1651479034 -> j2800191596;
	j475481549 [label="Certo. Se desideri il mio aiuto, lo avrai.",shape=box,color=blue];
		j475481549 -> j2800191596;
	j4169402417 [label="Che situazione triste sarebbe.",shape=box,color=blue];
		j4169402417 -> j481627138;
	j1240217240 [label="Mh. E che dire del possibile dolore che una reintroduzione potrebbe causare tra le parti coinvolte quando verranno fatte tali rivelazioni?",shape=box,color=blue];
		j1240217240 -> j2159623443;
		j1240217240 -> j4170216723;
	j2704522403 [label="Ed è forse compito tuo eseguire gli ordini di Entrati, guidato da un 'istinto'?",shape=box,color=blue];
		j2704522403 -> j2089782455;
		j2704522403 -> j797664957;
	j3497962379 [label="Boolean LyonFamilyFail is now true.",color=orange];
		j3497962379 -> "Chat ends.";
	j1128596256 [label="Non so come andranno a finire le cose tra il M. Loid e la famiglia Entrati. Voglio solo offrire il mio aiuto.",shape=box,color=blue];
		j1128596256 -> j2800191596;
	j2800191596 [label="Evaluate expressions",color=orange];
		j2800191596 -> j2248456111 [label="RoatheFamilyDelay",color=purple];
		j2800191596 -> j10772370 [label="RoatheFamilyFail",color=purple];
		j2800191596 -> j4120040114 [label="false",color=purple];
	j481627138 [label="Avrai il mio aiuto, per quel poco che ti servirà.",shape=box,color=blue];
		j481627138 -> j2256886096;
	j2159623443 [label="All'inizio di sicuro farà male. Come risistemare un osso rotto. Ma è l'unico modo in cui una cosa del genere può guarire correttamente.",shape=box,color=red];
		j2159623443 -> j3797908114;
	j4170216723 [label="Penso che ciò che tutti noi possiamo guadagnare stando insieme sia maggiore di ciò che possiamo perdere stando separati.",shape=box,color=red];
		j4170216723 -> j3797908114;
	j2089782455 [label="No, ma il mio compito è proteggere le persone che ne hanno bisogno. E non posso proteggere loro, e questo posto, dai Murmur e dall'Infestazione per sempre. Ma voi due - e forse anche Roathe - potete.",shape=box,color=red];
		j2089782455 -> j3797908114;
	j797664957 [label="Non mi fido esattamente di lui - ma non credo comunque che sia nostro nemico. Sembra che una guerra stia arrivando, e che tutti noi saremo nel posto giusto al momento giusto. Ed è qui che apparteniamo.",shape=box,color=red];
		j797664957 -> j3526416127;
	j2248456111 [label="Anche se credo che tu abbia già portato a termine quello che era il compito più oneroso - convincere Roathe.",shape=box,color=blue];
		j2248456111 -> j3251109885;
	j10772370 [label="Anche se dovrò riflettere su come convincere Roathe a cambiare idea... cosa che non sono sicuro di riuscire a fare. E senza di lui, potrebbe essere una causa persa.",shape=box,color=blue];
		j10772370 -> j1534316717;
		j10772370 -> j2221714430;
	j4120040114 [label="Anche se la persona più difficile da convincere è, temo di dirlo, probabilmente la più importante - Roathe.",shape=box,color=blue];
		j4120040114 -> j1534316717;
		j4120040114 -> j2221714430;
	j2256886096 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j2256886096 -> j4280312797;
	j3797908114 [label="+20 Chemistry",color=orange];
		j3797908114 -> j4100386274;
	j3526416127 [label="Mm. Forse. Ma non siamo pedine degli scacchi, e mi rifiuto di essere trattato come tale. Se Entrati desidera fare un simile appello, può inviare una maledetta lettera.",shape=box,color=blue];
		j3526416127 -> j1858308264;
	j3251109885 [label="Quel maledetto bastardo è - per quanto io desideri ardentemente trovare un metodo per assicurarmi che la sua bocca rimanga chiusa - utile.",shape=box,color=blue];
		j3251109885 -> j3941867773;
	j1534316717 [label="Sì...",shape=box,color=red];
		j1534316717 -> j3251109885;
	j2221714430 [label="Perché Roathe è così importante in tutta questa faccenda?",shape=box,color=red];
		j2221714430 -> j82409262;
	j4280312797 [label="- Lyon",shape=box,color=blue];
		j4280312797 -> j1933300832;
	j4100386274 [label="Davvero. Parole sagge. Molto bene. Le parlerò. Vedrò se riesco a convincerla a parlarne di nuovo con te.",shape=box,color=blue];
		j4100386274 -> j279678975;
		j4100386274 -> j2826703547;
	j1858308264 [label="In questo modo, temo di essere d'accordo con le lamentele di M. Loid. Potresti avere il mio aiuto per convincerlo, ma non credo che andresti lontano senza Marie.",shape=box,color=blue];
		j1858308264 -> j871582147;
	j3941867773 [label="Check boolean RoatheDating",color=orange];
		j3941867773 -> j3918145904 [label=true,color=green];
		j3941867773 -> j150106893 [label=false,color=brown];
	j82409262 [label="Marie e io siamo gli intrusi. Roathe, Loid, Entrati e la figlia di Entrati sono tutti contemporanei. Per non parlare del fatto che lui ha conoscenze che potrebbe usare per proteggerli, se le cose dovessero andare male.",shape=box,color=blue];
		j82409262 -> j1972996212;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j279678975 [label="Aspetta... la... convincerai ad aiutarmi con la famiglia Entrati?",shape=box,color=red];
		j279678975 -> j1339652253;
	j2826703547 [label="Io. Tu. Lo farai?",shape=box,color=red];
		j2826703547 -> j1339652253;
	j871582147 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j871582147 -> j3047711766;
	j3918145904 [label="Senza offesa.",shape=box,color=blue];
		j3918145904 -> j885732406;
		j3918145904 -> j1673122121;
	j150106893 [label="Ancora una volta, sto divagando. Come ho detto, quando arriverà il momento. E, a proposito di tempo, mi tocca lasciarti.",shape=box,color=blue];
		j150106893 -> j747514995;
	j1972996212 [label="Anche se detesto ammetterlo, Marie e io contineremmo a scervellarci nel tentativo di capire come utilizzare metà dell'attrezzatura presente in questo edificio, mentre lui la managgerebbe con facilità.",shape=box,color=blue];
		j1972996212 -> j3251109885;
	j1339652253 [label="Check boolean LyonDating",color=orange];
		j1339652253 -> j2064439224 [label=true,color=green];
		j1339652253 -> j661048813 [label=false,color=brown];
	j3047711766 [label="Ti auguro buona fortuna. Per ora, arrivederci.",shape=box,color=blue];
		j3047711766 -> j3311435967;
	j885732406 [label="Più per me.",shape=box,color=red];
		j885732406 -> j701703033;
	j1673122121 [label="Nono. So che non è per tutti.",shape=box,color=red];
		j1673122121 -> j701703033;
	j747514995 [label="+20 Chemistry",color=orange];
		j747514995 -> j2858859854;
	j2064439224 [label="Farò quello che posso, mon miracle. È mia sorella. Ma non posso fare molto. Mi assicurerò che ti parli di nuovo, ma dovrai occuparti del resto.",shape=box,color=blue];
		j2064439224 -> j3811427386;
	j661048813 [label="Farò quello che posso, amico mio. È mia sorella. Ma non posso fare molto. Mi assicurerò che ti parli di nuovo, ma dovrai occuparti del resto.",shape=box,color=blue];
		j661048813 -> j3811427386;
