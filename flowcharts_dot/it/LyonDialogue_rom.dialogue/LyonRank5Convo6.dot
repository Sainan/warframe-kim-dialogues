		1825 -> 1827 [label="false",color=purple];
	1826 [label="Drifter. Una richiesta, se posso?",shape=box,color=blue];
		1826 -> 1832;
		1826 -> 1831;
	1830 [label="Posso prendermi un momento per complimentarmi con te per qualcosa che finora ritenevo impossibile?",shape=box,color=blue];
		1830 -> 1834;
		1830 -> 1833;
		1830 -> 1835;
	1829 [label="Devo porgerle le mie condoglianze per i suoi nobili ma tragicamente brevi sforzi per quanto riguarda Marie e la questione de 'le Cardinal'.",shape=box,color=blue];
		1829 -> 1833;
		1829 -> 1834;
		1829 -> 1835;
	1828 [label="Mi dispiace che tu e Marie non abbiate trovato un accordo sulle questioni riguardanti 'le Cardinal'. Ma sono felice che la situazione non sia degenerata.",shape=box,color=blue];
		1828 -> 1833;
		1828 -> 1834;
		1828 -> 1835;
	1827 [label="Chat ends.",color=orange];
	1832 [label="Di cosa si tratta?",shape=box,color=red];
		1832 -> 1837;
	1831 [label="[Fine.]",shape=box,color=red];
		1831 -> 1836;
	1834 [label="Non sono esattamente orgoglioso di alcune delle cose che ho detto, ma... ",shape=box,color=red];
		1834 -> 1839;
	1833 [label="Ti ha raccontato tutto, non è vero?",shape=box,color=red];
		1833 -> 1838;
	1835 [label="[Fine.]",shape=box,color=red];
		1835 -> 1840;
	1837 [label="Per favore, convinci Marie a smettere di utilizzare i necramite per replicare i mobili. Non so proprio cosa fare con tutte queste sedie.",shape=box,color=blue];
		1837 -> 1841;
	1836 [label="Chat ends.",color=orange];
	1839 [label="Dopotutto, c'è un motivo per cui è stato inventato il termine 'crimine passionale'. Se noi, come creature, non fossimo fedeli alle nostre convinzioni, la vita sarebbe terribilmente noiosa, credo.",shape=box,color=blue];
		1839 -> 1844;
	1838 [label="Lo ha fatto. Parliamo ogni sera di quello che è successo durante il giorno. E dopo la vostra conversazione, è corsa subito da me per raccontarmi tutto.",shape=box,color=blue];
		1838 -> 1842;
		1838 -> 1843;
	1840 [label="Chat ends.",color=orange];
	1841 [label="+20 Chemistry",color=orange];
		1841 -> 1845;
	1844 [label="Certamente più tranquilla. Più pacifica. Ma noiosa. Di certo non ci sarebbe arte di cui parlare.",shape=box,color=blue];
		1844 -> 1847;
	1842 [label="Cosa ti ha detto?",shape=box,color=red];
		1842 -> 1846;
	1843 [label="... E?",shape=box,color=red];
		1843 -> 1846;
	1845 [label="E mi rifiuto di accettare i suoi... coloriti suggerimenti su dove all'interno dell'anatomia di Roathe dovrebbero essere immagazzinate.",shape=box,color=blue];
		1845 -> 1848;
	1847 [label="Ma sto divagando. Mi chiedo - nelle mie conversazioni con lei, sembra che le tue parole siano state commoventi. Devo chiederti - sei soddisfatto di come hai risolto le cose tra voi?",shape=box,color=blue];
		1847 -> 1851;
	1846 [label="Check boolean LyonDating",color=orange];
		1846 -> 1850 [label=true,color=green];
		1846 -> 1849 [label=false,color=brown];
	1848 [label="Chat ends.",color=orange];
	1851 [label="Evaluate expressions",color=orange];
		1851 -> 1853 [label="MarieDating, MarieFamilyFail",color=purple];
		1851 -> 1854 [label="MarieDating, MarieFamilyFail",color=purple];
		1851 -> 1858 [label="MarieFamilyFail",color=purple];
		1851 -> 1859 [label="MarieFamilyFail",color=purple];
		1851 -> 1853 [label="MarieFamilySuccess",color=purple];
		1851 -> 1860 [label="MarieEntratiCompleteA",color=purple];
		1851 -> 1855 [label="MarieEntratiCompleteB",color=purple];
		1851 -> 1856 [label="MarieEntratiCompleteB",color=purple];
		1851 -> 1857 [label="MarieEntratiCompleteC",color=purple];
		1851 -> 1861 [label="false",color=purple];
	1850 [label="Ah! Come se volessi tradire la sua fiducia nei tuoi confronti. Per quanto tu sia prezioso per me, mon miracle - lei è stata la sorella della mia anima per molti, molti anni.",shape=box,color=blue];
		1850 -> 1852;
	1849 [label="Ah! Come se volessi tradire la sua fiducia nei tuoi confronti. Per quanto tu sia prezioso per me, amico mio - lei è stata la sorella della mia anima per molti, molti anni.",shape=box,color=blue];
		1849 -> 1852;
	1853 [label="Sì. Credo che avremo il suo aiuto per riparare le cose tra Loid e la famiglia al piano di sopra. E questa è... una notizia stupenda, Lyon. Non credo di riuscire a spiegare quanto sia stupenda.",shape=box,color=red];
		1853 -> 1862;
	1854 [label="No - Sinceramente, per come sono andate le cose tra noi, ho rovinato ogni possibilità che lei aiutasse a sistemare le cose tra Loid e la famiglia al piano di sopra.",shape=box,color=red];
		1854 -> 1863;
	1858 [label="No - Sinceramente, per come sono andate le cose tra noi, ho rovinato ogni possibilità che lei aiutasse a sistemare le cose tra Loid e la famiglia al piano di sopra.",shape=box,color=red];
		1858 -> 1866;
	1859 [label="Lo sono. Lei non mi aiuterà a sistemare le cose tra Loid e la famiglia al piano di sopra, e per me va bene così.",shape=box,color=red];
		1859 -> 1867;
	1860 [label="Lo sono. Sono contento che abbia capito che Entrati potrebbe non essere 'buono' e... beh, che comunque non è nemmeno 'malvagio', no?",shape=box,color=red];
		1860 -> 1868;
	1855 [label="Sono contento di come ho lasciato le cose. Onestamente, più ci penso, più sono dalla sua parte per quanto riguarda Entrati.",shape=box,color=red];
		1855 -> 1867;
	1856 [label="Non eravamo d'accordo su Entrati. Non sono riuscito a convincerla e... vorrei solo aver potuto fare di meglio.",shape=box,color=red];
		1856 -> 1864;
	1857 [label="Abbiamo 'concordato di non essere d'accordo' su Entrati, e credo che questo sia il massimo che potremo mai ottenere sull'argomento. Non credo che ulteriori discussioni possano migliorare la situazione.",shape=box,color=red];
		1857 -> 1865;
	1861 [label="Onestamente, va bene così. Non credo che a questo punto la situazione migliorerà o peggiorerà.",shape=box,color=red];
		1861 -> 1865;
	1852 [label="No, temo che le sue parole rimarranno segrete. Ma per lei erano comunque commoventi. Mi chiedo però se sei soddisfatto di come hai risolto le cose tra voi due?",shape=box,color=blue];
		1852 -> 1851;
	1862 [label="Credo di poterne comprendere la grandiosità, se non la portata. Sono... molto onorato di farne parte, anche se in piccola parte.",shape=box,color=blue];
		1862 -> 1869;
		1862 -> 1870;
	1863 [label="Affascinante... Beh, ora sei il suo amante, non è vero? Se qualcuno in questo posto avesse l'influenza necessaria per convincerla - saresti proprio tu, no?",shape=box,color=blue];
		1863 -> 1871;
	1866 [label="Affascinante... Beh, è risaputo che ho una certa... influenza su di lei, per quanto limitata possa essere. Credi che questo ricucire i rapporti tra M. Loid e la famiglia di Entrati sia così importante?",shape=box,color=blue];
		1866 -> 1874;
		1866 -> 1875;
	1867 [label="Non so se si tratti di irrascibilità, arroganza, ignoranza o apatia. Quindi opterò per un mix di tutti e quattro e andrò avanti con la mia giornata.",shape=box,color=blue];
		1867 -> 1876;
	1868 [label="Esatto. La penso come te. Non credo che lui la pensi in un modo o nell'altro, per ora... le sue motivazioni sono contrastanti.",shape=box,color=blue];
		1868 -> 1877;
	1864 [label="Mh. Beh, sfortunatamente, arriva un momento in cui tutto deve essere messo a tacere. Un impasto può essere lavorato troppo. Un artista può aggiungere troppi particolari al suo dipinto. E una discussione può certamente essere troppo elaborata.",shape=box,color=blue];
		1864 -> 1872;
	1865 [label="Sì, forse sarebbe meglio passare ad altri argomenti.",shape=box,color=blue];
		1865 -> 1873;
	1869 [label="Non pensavo che ti saresti offerto di aiutarmi.",shape=box,color=red];
		1869 -> 1878;
	1870 [label="Questo significa che mi aiuterai a convincere Loid ad andare di sopra e a parlare con loro?",shape=box,color=red];
		1870 -> 1879;
	1871 [label="Spero semplicemente che tu non abbia fatto alcun sacrificio nelle tue parole nei suoi confronti - dando priorità a una cosa piuttosto che a un'altra nel tentativo di corteggiarla.",shape=box,color=blue];
		1871 -> 1880;
	1874 [label="C'è così tanta solitudine in questo mondo, Lyon. Così tanta tristezza. Perché non porvi fine se è possibile farlo? ",shape=box,color=red];
		1874 -> 1882;
	1875 [label="Non ne sono sicuro, è un istinto - una sensazione viscerale. Ho la sensazione che Entrati vi abbia portato qui in questo momento per un motivo.",shape=box,color=red];
		1875 -> 1883;
	1876 [label="Vergogna.",shape=box,color=blue];
		1876 -> 1884;
	1877 [label="L'arroganza lo spingeva. Un'avidità di conoscenza. Ora, forse, un'avidità di perdono. Chi può dirlo? Mi chiedo se lui stesso lo sappia.",shape=box,color=blue];
		1877 -> 1881;
	1872 [label="Immagino che sceglierei semplicemente di lasciar perdere. E sperare che un giorno lei possa avere la possibilità di vedere Entrati per quello che sappiamo essere - nella migliore delle ipotesi, complicato.",shape=box,color=blue];
		1872 -> 1881;
	1873 [label="Personalmente, sono pronto alle loro infinite conversazioni riguardanti il meraviglioso e impeccabile 'Cardinal.'",shape=box,color=blue];
		1873 -> 1881;
	1878 [label="So di non essere particolarmente affabile, ma non sono nemmeno un demone. Se desideri il mio aiuto, lo avrai.",shape=box,color=blue];
		1878 -> 1885;
	1879 [label="Certo. Se desideri il mio aiuto, lo avrai.",shape=box,color=blue];
		1879 -> 1885;
	1880 [label="Che situazione triste sarebbe.",shape=box,color=blue];
		1880 -> 1886;
	1882 [label="Mh. E che dire del possibile dolore che una reintroduzione potrebbe causare tra le parti coinvolte quando verranno fatte tali rivelazioni?",shape=box,color=blue];
		1882 -> 1887;
		1882 -> 1888;
	1883 [label="Ed è forse compito tuo eseguire gli ordini di Entrati, guidato da un 'istinto'?",shape=box,color=blue];
		1883 -> 1889;
		1883 -> 1890;
	1884 [label="Update boolean LyonFamilyFail",color=orange];
		1884 -> 1891;
	1881 [label="Non so come andranno a finire le cose tra il M. Loid e la famiglia Entrati. Voglio solo offrire il mio aiuto.",shape=box,color=blue];
		1881 -> 1885;
	1885 [label="Evaluate expressions",color=orange];
		1885 -> 1893 [label="RoatheFamilyDelay",color=purple];
		1885 -> 1894 [label="RoatheFamilyFail",color=purple];
		1885 -> 1892 [label="false",color=purple];
	1886 [label="Avrai il mio aiuto, per quel poco che ti servirà.",shape=box,color=blue];
		1886 -> 1895;
	1887 [label="All'inizio di sicuro farà male. Come risistemare un osso rotto. Ma è l'unico modo in cui una cosa del genere può guarire correttamente.",shape=box,color=red];
		1887 -> 1896;
	1888 [label="Penso che ciò che tutti noi possiamo guadagnare stando insieme sia maggiore di ciò che possiamo perdere stando separati.",shape=box,color=red];
		1888 -> 1896;
	1889 [label="No, ma il mio compito è proteggere le persone che ne hanno bisogno. E non posso proteggere loro, e questo posto, dai Murmur e dall'Infestazione per sempre. Ma voi due - e forse anche Roathe - potete.",shape=box,color=red];
		1889 -> 1896;
	1890 [label="Non mi fido esattamente di lui - ma non credo comunque che sia nostro nemico. Sembra che una guerra stia arrivando, e che tutti noi saremo nel posto giusto al momento giusto. Ed è qui che apparteniamo.",shape=box,color=red];
		1890 -> 1897;
	1891 [label="Chat ends.",color=orange];
	1893 [label="Anche se credo che tu abbia già portato a termine quello che era il compito più oneroso - convincere Roathe.",shape=box,color=blue];
		1893 -> 1900;
	1894 [label="Anche se dovrò riflettere su come convincere Roathe a cambiare idea... cosa che non sono sicuro di riuscire a fare. E senza di lui, potrebbe essere una causa persa.",shape=box,color=blue];
		1894 -> 1898;
		1894 -> 1899;
	1892 [label="Anche se la persona più difficile da convincere è, temo di dirlo, probabilmente la più importante - Roathe.",shape=box,color=blue];
		1892 -> 1898;
		1892 -> 1899;
	1895 [label="Update boolean LyonFamilySuccess",color=orange];
		1895 -> 1901;
	1896 [label="+20 Chemistry",color=orange];
		1896 -> 1902;
	1897 [label="Mm. Forse. Ma non siamo pedine degli scacchi, e mi rifiuto di essere trattato come tale. Se Entrati desidera fare un simile appello, può inviare una maledetta lettera.",shape=box,color=blue];
		1897 -> 1903;
	1900 [label="Quel maledetto bastardo è - per quanto io desideri ardentemente trovare un metodo per assicurarmi che la sua bocca rimanga chiusa - utile.",shape=box,color=blue];
		1900 -> 1905;
	1898 [label="Sì...",shape=box,color=red];
		1898 -> 1900;
	1899 [label="Perché Roathe è così importante in tutta questa faccenda?",shape=box,color=red];
		1899 -> 1904;
	1901 [label="- Lyon",shape=box,color=blue];
		1901 -> 1906;
	1902 [label="Davvero. Parole sagge. Molto bene. Le parlerò. Vedrò se riesco a convincerla a parlarne di nuovo con te.",shape=box,color=blue];
		1902 -> 1907;
		1902 -> 1908;
	1903 [label="In questo modo, temo di essere d'accordo con le lamentele di M. Loid. Potresti avere il mio aiuto per convincerlo, ma non credo che andresti lontano senza Marie.",shape=box,color=blue];
		1903 -> 1909;
	1905 [label="Check boolean RoatheDating",color=orange];
		1905 -> 1912 [label=true,color=green];
		1905 -> 1911 [label=false,color=brown];
	1904 [label="Marie e io siamo gli intrusi. Roathe, Loid, Entrati e la figlia di Entrati sono tutti contemporanei. Per non parlare del fatto che lui ha conoscenze che potrebbe usare per proteggerli, se le cose dovessero andare male.",shape=box,color=blue];
		1904 -> 1910;
	1906 [label="+10 Chemistry",color=orange];
		1906 -> 1913;
	1907 [label="Aspetta... la... convincerai ad aiutarmi con la famiglia Entrati?",shape=box,color=red];
		1907 -> 1914;
	1908 [label="Io. Tu. Lo farai?",shape=box,color=red];
		1908 -> 1914;
	1909 [label="Update boolean LyonFamilySuccess",color=orange];
		1909 -> 1915;
	1912 [label="Senza offesa.",shape=box,color=blue];
		1912 -> 1917;
		1912 -> 1918;
	1911 [label="Ancora una volta, sto divagando. Come ho detto, quando arriverà il momento. E, a proposito di tempo, mi tocca lasciarti.",shape=box,color=blue];
		1911 -> 1916;
	1910 [label="Anche se detesto ammetterlo, Marie e io contineremmo a scervellarci nel tentativo di capire come utilizzare metà dell'attrezzatura presente in questo edificio, mentre lui la managgerebbe con facilità.",shape=box,color=blue];
		1910 -> 1900;
	1913 [label="Chat ends.",color=orange];
	1914 [label="Check boolean LyonDating",color=orange];
		1914 -> 1920 [label=true,color=green];
		1914 -> 1919 [label=false,color=brown];
	1915 [label="Ti auguro buona fortuna. Per ora, arrivederci.",shape=box,color=blue];
		1915 -> 1921;
	1917 [label="Più per me.",shape=box,color=red];
		1917 -> 1923;
	1918 [label="Nono. So che non è per tutti.",shape=box,color=red];
		1918 -> 1923;
	1916 [label="+20 Chemistry",color=orange];
		1916 -> 1922;
	1920 [label="Farò quello che posso, mon miracle. È mia sorella. Ma non posso fare molto. Mi assicurerò che ti parli di nuovo, ma dovrai occuparti del resto.",shape=box,color=blue];
		1920 -> 1924;
	1919 [label="Farò quello che posso, amico mio. È mia sorella. Ma non posso fare molto. Mi assicurerò che ti parli di nuovo, ma dovrai occuparti del resto.",shape=box,color=blue];
		1919 -> 1924;
