	662 [label="Temo che ci siano molti argomenti di cui potrei parlare a lungo. Ma non fraintendermi, lo farei volentieri, semplicemente non voglio annoiarti a morte. Da dove vorresti cominciare?",shape=box,color=blue];
		662 -> 664;
		662 -> 665;
	675 [label="No, sono più curioso che altro.",shape=box,color=red];
		675 -> 686;
	676 [label="Sono religioso. È simile alla tua, anche se non la riconosceresti.",shape=box,color=red];
		676 -> 687;
	674 [label="Sono religioso. Tuttavia, non riconosceresti nessuna delle nostre pratiche.",shape=box,color=red];
		674 -> 685;
	673 [label="Sono religioso. È una convinzione che mi appartiene personalmente, non ha un nome preciso.",shape=box,color=red];
		673 -> 684;
	672 [label="Seguo il cammino di Sol, come Marie.",shape=box,color=red];
		672 -> 679;
	671 [label="Sono come te, seguo il cammino di Lua.",shape=box,color=red];
		671 -> 679;
	666 [label="Seguo i Luminari, ma cerco di mantenere un percorso equilibrato.",shape=box,color=red];
		666 -> 679;
	667 [label="Credo che ci sia qualcosa là fuori, ma non credo che alla fine la gente possa davvero conoscere le risposte.",shape=box,color=red];
		667 -> 680;
	668 [label="Non sono religioso. Tendo a pensare che la religione sia un sostegno per i paurosi - senza offesa.",shape=box,color=red];
		668 -> 681;
	669 [label="Non sono religioso. Non dico che non ci possa essere qualcosa là fuori, ma non è qualcosa di cui mi proccupo.",shape=box,color=red];
		669 -> 682;
	670 [label="Non sono religioso. Credo che tutti gli dei - persino l'Indifferenza - sia frutto della nostra immaginazione. Senza offesa.",shape=box,color=red];
		670 -> 683;
	664 [label="Potresti raccontarmi delle tue festività?",shape=box,color=red];
		664 -> 677;
	665 [label="Potresti raccontarmi di Sol e Lua?",shape=box,color=red];
		665 -> 678;
