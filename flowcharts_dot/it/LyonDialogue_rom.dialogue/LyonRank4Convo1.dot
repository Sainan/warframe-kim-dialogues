	699 [label="Update boolean DrifterLiar",color=orange];
		699 -> 710;
	700 [label="Update boolean LyonSuspicious",color=orange];
		700 -> 710;
	701 [label="Mi chiedo quanto le nostre fedi si siano influenzate a vicenza, intenzionalmente o meno, a seconda dei casi.",shape=box,color=blue];
		701 -> 704;
	698 [label="Affascinante! Come studioso del rito, spero che avremo il tempo di imparare gli uni dagli altri riguardo le nostre rispettive convizioni.",shape=box,color=blue];
		698 -> 704;
	695 [label="È una lunga storia. ",shape=box,color=red];
		695 -> 707;
	696 [label="Ho studiato un sacco di rilegioni diverse, e nessuna di queste mi si addiceva davvero. Mi sono ritrovato con una specie di strana collezione di umanità.",shape=box,color=red];
		696 -> 708;
	697 [label="Credo a ciò che sento. E non ho bisogno di un edificio o di di un libro per dirmi cosa sia.",shape=box,color=red];
		697 -> 709;
	690 [label="Davvero? Sono... sorpreso. Sorpreso, ma compiaciuto. E non c'è da stupirsi che tu sia curioso, allora. I nostri insegnamenti devono essere così diversi a ciò che conosci. È passato così tanto tempo.",shape=box,color=blue];
		690 -> 704;
	691 [label="Lo rispetto. C'è un onore nel riconoscere ciò che non possiamo sapere, nel vedere la piccolezze della condizione umana.",shape=box,color=blue];
		691 -> 704;
	692 [label="Credimi, non mi offendo. In molti casi, hai perfettamente ragione.",shape=box,color=blue];
		692 -> 705;
		692 -> 706;
	693 [label="Ammetto di essere invidioso del fatto che tu non trovi motivo di preoccuparti per ciò che potrebbe aspettarci oltre il velo. Se più persone lo facessero, il nostro mondo avrebbe conosciuto più pace ai suoi tempi.",shape=box,color=blue];
		693 -> 704;
	694 [label="Questo è un argomento di cui vorrei discutere a lungo con te. Ma non ora, in un momento in cui non sono preparato a una discussione del genere.",shape=box,color=blue];
		694 -> 704;
	688 [label="Un buon punto di partenza. Conoscere una cultura attraverso le sue festività significa conoscerne il cuore. Perché il modo in cui un popolo festeggia è il modo in cui verrà ricordato. Perché quei momenti sono quelli più cari a chi li condivide.",shape=box,color=blue];
		688 -> 702;
	689 [label="Certo. Cominciamo con ciò che forse già sai: Sol e Lua, il sole e la luna. Sono divinità estremamente trasmutabili nei loro aspetti.",shape=box,color=blue];
		689 -> 703;
	710 [label="Mh. Permettimi di rispondere alla tua curiosità. Per evitare di annoiarti a morte, da dove vorresti iniziare?",shape=box,color=blue];
		710 -> 665;
		710 -> 664;
	704 [label="E sono negligente nel non rimanere in tema. Temo di essermi allontanato troppo dal tema.",shape=box,color=blue];
		704 -> 714;
	707 [label="+20 Chemistry",color=orange];
		707 -> 717;
	708 [label="+20 Chemistry",color=orange];
		708 -> 718;
	709 [label="+20 Chemistry",color=orange];
		709 -> 719;
	705 [label="Tuttavia, ciò non significa che non mi interessi imparare.",shape=box,color=red];
		705 -> 715;
	706 [label="E nel tuo caso?",shape=box,color=red];
		706 -> 716;
	702 [label="Le nostre festività principali e più comuni sono i Solstizi d'Inverno e d'Estate, che segnano i giorni più corti e più lunghi dell'anno.",shape=box,color=blue];
		702 -> 711;
	703 [label="Apparso in molte forme nel corso dei secoli a molti credenti. A volte maschile, a volte femminile. Ma sempre come Sol, il Sole, e Lua, la Luna.",shape=box,color=blue];
		703 -> 712;
		703 -> 713;
	714 [label="Volevi saperne di più sull'Ortodossia Luminare, no? Per evitare di annoiarti a morte, da dove vorresti cominciare?",shape=box,color=blue];
		714 -> 665;
		714 -> 664;
	717 [label="Mm. E una cosa è meglio raccontarla a un amico fidato. Capisco perfettamente. Inoltre, sei venuto da me per avere informazioni, non il contrario.",shape=box,color=blue];
		717 -> 704;
	718 [label="Una vetrata dell'anima. Si rompe quando viene lasciata da parte, ma che bella immagine dipinge quando viene ricomposta.",shape=box,color=blue];
		718 -> 704;
	719 [label="Il mondo sarebbe un posto migliore se condividesse la tua fede.",shape=box,color=blue];
		719 -> 704;
	715 [label="E per questo lodo la tua curiosità e la tua natura accademica. ",shape=box,color=blue];
		715 -> 704;
	716 [label="Il mio caso è... complesso. Ma non mentirò dicendo che non è stato privo di paura. Anche se la religione ne ha portata un'ondata nella mia vita, e non l'ha mai eliminata.",shape=box,color=blue];
		716 -> 704;
	711 [label="Entrambe le festività sono caratterizzate da grandi festeggiamenti, anche se la loro importanza è determinata dalle persone con cui si condividono i festeggiamenti. Mentre il Solstizio d'Inverno è da condividere con la famiglia e gli amici più cari, il Solstizio d'Estate è per gli sconosciuti.",shape=box,color=blue];
		711 -> 720;
		711 -> 721;
	712 [label="Oh, ora tutto ha molto più senso.",shape=box,color=red];
		712 -> 722;
	713 [label="[Lascialo continuare.]",shape=box,color=red];
		713 -> 723;
	720 [label="Davvero? Raccontami di più sul Solstizio d'Estate.",shape=box,color=red];
		720 -> 724;
	721 [label="Raccontami di più sul Sostizio d'Inverno.",shape=box,color=red];
		721 -> 725;
	722 [label="Sì, alcune sette possono essere un po' rigide nella scelta dell'iconografia, dichiarando che Sol \"Deve\" essere in un modo o \"Deve\" essere in un altro, ma l'Ortodossia non riconosce questo fatto.",shape=box,color=blue];
		722 -> 726;
	723 [label="Ciascuno dei Luminari racchiude in sé molteplici aspetti. Ogni aspetto può essere visto come una funzione del tutto. Lua, ad esempio, è la madre, la fanciulla, la vecchia.",shape=box,color=blue];
		723 -> 731;
	724 [label="Il Solstizio d'Estate è il momento ideale per condividere grandi doni e riunire sconosciuti che non si sono mai incontrati. Ci si riuniva in un campo, portando cibo e oggetti di propria produzione, non importa cosa.",shape=box,color=blue];
		724 -> 728;
	725 [label="Il Solsitizio d'Inverno è il momento per prepararsi al freddo e per celebrare coloro che ci riscaldano nei momenti più bui. Si decora un albero con candele, una luce per ciascuno di coloro che ci ha preceduto e che ci guida nel cammino come le stelle nel cielo.",shape=box,color=blue];
		725 -> 729;
	726 [label="Immagino che tutto ciò che è sopravvissuto a questo futuro lontano sia finito per essere... un po' confuso nella sua documentazione della mia religione.",shape=box,color=blue];
		726 -> 730;
	731 [label="Ma Lua può anche essere Colui che guida le anime lungo il fiume di lacrime verso la notte senza fine. La morte stessa. Il messaggero e l'araldo.",shape=box,color=blue];
		731 -> 734;
	728 [label="Candele, pane, vestiti, quadri. O libri di poesia. O corone di fiori. Anche presentarsi a mani vuote, ma con \"una lieta novella\", è da considerarsi una benedizione.",shape=box,color=blue];
		728 -> 732;
	729 [label="E in cima, Sol stesso, che soffre in cima all'albero delle stelle nell'oscurità. Offuscato, ma non dimenticato. Perché questo è il tempo di Lua. E noi la celebriamo in questo tempo d'ombra.",shape=box,color=blue];
		729 -> 733;
	730 [label="Mi ritrovo a essere una reliquia archeologica vivente. Che tristezza. Ma sto divagando.",shape=box,color=blue];
		730 -> 723;
	734 [label="E in altre sette, la Morte è una vecchia donna velata. È diversa. Ma parla allo stesso spirito che si rivolge a tutti noi. La mano argentata che desidera guidarci in quell'ultimo momento.",shape=box,color=blue];
		734 -> 737;
	732 [label="Una celebrazione della vita - delle risate - della musica - e della condivisione di tutte queste cose, avrebbe avuto inizio durante quello che sarebbe stato il più lungo dei giorni di Sol. ",shape=box,color=blue];
		732 -> 735;
	733 [label="E mentre ci avviciniamo e ci nutriamo di un uccello arrosto, di tuberi e di tutto ciò che non cresce fresco nella terra ghiacciata, stringiamo coloro che amiamo. E raccontiamo storie di coloro che se ne sono andati.",shape=box,color=blue];
		733 -> 736;
	737 [label="La luna che scivola sopra il sole durante l'eclissi, guidadonci attraverso il bivio in quel momento in cui tutto è perduto.",shape=box,color=blue];
		737 -> 739;
	735 [label="Tutti erano invitati a fare nuove amicizie con gli sconosciuti e a portare a casa ciò di cui avevano bisogno.",shape=box,color=blue];
		735 -> 738;
	736 [label="Ricordiamo, nella notte più lunga di Lua, che lei guiderà noi e la nostra famiglia fino alla fine.",shape=box,color=blue];
		736 -> 738;
	739 [label="Update boolean DrifterEclipse",color=orange];
		739 -> 741;
	738 [label="Ma la festività più sacra per i Luminari è il Summum Bonim. È un evento raro, quando Sol e Lua si allineano in un'eclissi perfetta.",shape=box,color=blue];
		738 -> 740;
	741 [label="Check boolean VelimirEclipse",color=orange];
		741 -> 744 [label=true,color=green];
		741 -> 743 [label=false,color=brown];
	740 [label="È un'occasione meravigliosa e sacra, in cui tutta la natura risponde. Hai avuto la fortuna di assistervi in persona?",shape=box,color=blue];
		740 -> 742;
	744 [label="Aspetta...",shape=box,color=red];
		744 -> 747;
	743 [label="Hai mai visto un'eclissi?",shape=box,color=red];
		743 -> 746;
	742 [label="Update boolean DrifterEclipse",color=orange];
		742 -> 745;
	747 [label="Mi sembra... davvero familiare.",shape=box,color=red];
		747 -> 755;
	746 [label="Ho avuto la fortuna di assistervi due volte. Ed entrambe le volte l'ho trovato... trasformativo. Se potessi restare in quel breve instante, sospeso lì per sempre, lo farei.",shape=box,color=blue];
		746 -> 754;
