	755 [label="In che modo?",shape=box,color=blue];
		755 -> 760;
	754 [label="Ti racconterò la storia della prima eclissi a cui ho assistito un'altra volta. Si è fatto tardi. O forse preso. Non saprei con certezza.",shape=box,color=blue];
		754 -> 759;
	748 [label="No.",shape=box,color=red];
		748 -> 756;
	749 [label="Sì. Non è stato poi così impressionante.",shape=box,color=red];
		749 -> 757;
	750 [label="Sì. Non era male.",shape=box,color=red];
		750 -> 757;
	751 [label="Sì. È stato fantastico.",shape=box,color=red];
		751 -> 746;
	753 [label="Sì. Mi ha provocato una cefalea oculare orribile, che tu ci creda o no. Ma è stato fantastico.",shape=box,color=red];
		753 -> 758;
	752 [label="Sì. Mi ha provocato un'emicrania oculare orribile, che tu ci creda o no. Ma è stato fantastico.",shape=box,color=red];
		752 -> 758;
	760 [label="Questa frase ti suona familiare: \"Agli incroci deserti, cerca l'eclissi - perché quando Sol e Lua si allineano, i perduti troveranno la strada di casa.\"",shape=box,color=red];
		760 -> 764;
	759 [label="Update boolean LyonFirstEclipse",color=orange];
		759 -> 762;
		759 -> 763;
	756 [label="Se mai ne avrai l'opportunità, fallo.",shape=box,color=blue];
		756 -> 746;
	757 [label="Vorrei poter condividere la tua impassabilità di fronte all'evento...",shape=box,color=blue];
		757 -> 746;
	758 [label="Devi essere stato toccato dai Luminari, e la loro presenza ti ha sopraffatto. O forse volevano punirti per qualche grave peccato. Una delle due. Ehe.",shape=box,color=blue];
		758 -> 761;
	764 [label="Celestini 18:19, dal Terzo Libro Ordodosso di Lua. Dove, nel nome dei Luminari, l'hai sentito?",shape=box,color=blue];
		764 -> 767;
		764 -> 768;
	762 [label="Quando sei pronto.",shape=box,color=red];
		762 -> 765;
	763 [label="Non vedo l'ora. Grazie per il tempo che mi hai dedicato, Lyon.",shape=box,color=red];
		763 -> 766;
	761 [label="Questa è la via degli dei. I loro segni possono spesso essere interpretati in qualsiasi modo.",shape=box,color=blue];
		761 -> 754;
	767 [label="È una storia molto lunga. Ma inutile dire che credo che alcune delle tue scritture stiano ora circolando con l'indifferenza.",shape=box,color=red];
		767 -> 770;
	768 [label="Da alcuni vecchi amici. Lo usavano come due metà di una frase in codice con la loro figlia che... non importa in realtà.",shape=box,color=red];
		768 -> 771;
