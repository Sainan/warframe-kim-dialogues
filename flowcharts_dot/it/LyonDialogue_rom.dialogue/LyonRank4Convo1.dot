	771 [label="Coinvolge l'Uomo nel Muro ed è tutto molto caotico.",shape=box,color=red];
		771 -> 770;
	769 [label="Sì, beh. Sta iniziando a sembrare inevitabile. ",shape=box,color=blue];
		769 -> 772;
	773 [label="Lo... capisco. Vorrei chiederti di più a riguardo presto, se posso. Semplicemente non sono preparato per questo ora, e qui si è fatto tardi. O forse è presto. Non saprei dirlo con certezza.",shape=box,color=blue];
