digraph {
	"LyonRank4Convo2 begins." [color=orange];
		"LyonRank4Convo2 begins." -> j329832579;
		"LyonRank4Convo2 begins." -> j3848306020;
		"LyonRank4Convo2 begins." -> j4115718638;
	j329832579 [label="Come fate tu e Marie a conciliare il fatto di essere sacerdote e suora, ma anche di commettere atti di violenza?",shape=box,color=red];
		j329832579 -> j2283695802;
		j329832579 -> j3512218989;
		j329832579 -> j556237241;
	j3848306020 [label="Posso farti una domanda un po' strana, Lyon?",shape=box,color=red];
		j3848306020 -> j2567725920;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j2283695802 [label="Sento Marie gridare \"païens!\" e lanciarsi nella mischia, eppure... faccio fatica a pensare che sia il tipo di persona che condanna qualcuno per le sue convinzioni. Non riesco a immaginare che anche tu debba essere molto diverso. È chiaro che ha un'alta opinione di te.",shape=box,color=red];
		j2283695802 -> j3723764739;
	j3512218989 [label="Come reagirebbe la tua chiesa a ciò che tu e Marie state facendo qui? Riguardo... a ciò che vi viene chiesto di fare in loro nome?",shape=box,color=red];
		j3512218989 -> j1110176594;
	j556237241 [label="Osservo te e Marie, sul campo di battaglia, poi le parlo in privato e ti vedo leggere libri in silenzio... e immagino che mi risulti difficile far combaciare questi individui nella mia mente.",shape=box,color=red];
	j2567725920 [label="Se ritieni che la capacità di descrivere la nostra situazione attuale sia semplicemente \"strana\", o sono impressionato dalla tua forza d'animo o costernato dalla tua mancanza di vocabolario. Immagino, tuttavia, che sia la prima ipotesi.",shape=box,color=blue];
		j2567725920 -> j984890867;
	"Chat ends." [color=orange];
	j3723764739 [label="Hai perfettamente ragione. Marie non è il tipo che condanna qualcuno perché nutre nel cuore un antico dio degli alberi - cercherebbe piuttosto di scoprire quali credenze ha in comune con lui.",shape=box,color=blue];
		j3723764739 -> j3439017215;
	j1110176594 [label="Molte guerre sante furono combattute ai suoi tempi in nome di Sol e Lua. Le sanguinose \"crociate\" per respingere i \"pagani\" o per \"impadronirsi della terra senta\" o qualsiasi altro ragionamento artificioso erano le preferite del tempo.",shape=box,color=blue];
		j1110176594 -> j2036075340;
	j984890867 [label="+5 Chemistry",color=orange];
		j984890867 -> j2033338462;
	j3439017215 [label="L'albero non è forse nutrito dalla luce di Sol? Non c'è forse un terreno comune su cui potrebbe condividere il pane con loro? È più propensa a sedersi e ad ascoltare le loro storie, piuttosto che cercare di far loro del male per la loro fede.",shape=box,color=blue];
		j3439017215 -> j3540168327;
	j2036075340 [label="L'Ortodossia Luminaria non ha eserciti e non combatte guerre. Non impedisce ai suoi membri di agire e di proteggere gli altri.",shape=box,color=blue];
		j2036075340 -> j3918829034;
	j2033338462 [label="Cioè, procedi. Non puoi rendere la cosa ancora più \"strana\" per me chiedendomi qualunque cosa ti incuriosisca.",shape=box,color=blue];
		j2033338462 -> j2283695802;
		j2033338462 -> j3512218989;
		j2033338462 -> j556237241;
	j3540168327 [label="Quando lei affronta il suo nemico sul campo di battaglia, credo che ci siano due possibilità: o si sta divertendo un po', recitando la parte di un antico crociato e immaginandosi di indossare la scintillante armatura di un Cavaliere di Sol -",shape=box,color=blue];
		j3540168327 -> j1580533190;
	j3918829034 [label="Quando Marie affronta i suoi nemici sul campo di battaglia, credo che ci siano due possibilità: o si sta divertendo un po', recitando la parte di un antico crociato e immaginandosi di indossare la scintillante armatura di un Cavaliere di Sol -",shape=box,color=blue];
		j3918829034 -> j1580533190;
	j1580533190 [label="Oppure, più probabilmente, sta ricordando Astaphor 8:23 \"Sole sono le anime che cercano di entrare nella mia casa con la violenza, perché sono quelle scacciate dalla luce di Sol.\"",shape=box,color=blue];
		j1580533190 -> j1896912703;
	j1896912703 [label="Ai suoi occhi, la violenza che commette è giusta in nome della difesa di un bene superiore - come quella che faresti tu, e quelli che combattono al tuo fianco, suppongo. ",shape=box,color=blue];
		j1896912703 -> j574859186;
	j574859186 [label="E, pertanto, coloro che combatte - indipendentemente dalla loro religione - vengono espulsi da Sol. Anche se indossassero il sacro drappo del suo ordine, ai suoi occhi sarebbero dei pagani.",shape=box,color=blue];
		j574859186 -> j2059643830;
		j574859186 -> j1527165411;
	j2059643830 [label="Ho notato che ti sei lasciato fuori da questa storia. Cosa ne pensi di tutti questi litigi?",shape=box,color=red];
		j2059643830 -> j2820097822;
	j1527165411 [label="Ha senso. Grazie.",shape=box,color=red];
		j1527165411 -> j904200710;
	j2820097822 [label="Sono volutamente sfuggente, Drifter.",shape=box,color=blue];
		j2820097822 -> j2011686138;
		j2820097822 -> j1758891764;
	j904200710 [label="+5 Chemistry",color=orange];
		j904200710 -> j2773504386;
	j2011686138 [label="E la mia ostinazione è evidente, Sacerdote.",shape=box,color=red];
		j2011686138 -> j722510948;
	j1758891764 [label="Giusto. Oggi mi accontenterò.",shape=box,color=red];
		j1758891764 -> j904200710;
	j2773504386 [label="Per quel che vale, Marie... mi ha detto che hai buone intenzioni. E io le credo, anche quando non ci credo io stesso.",shape=box,color=blue];
		j2773504386 -> j2215658953;
	j722510948 [label="+10 Chemistry",color=orange];
		j722510948 -> j2584944230;
	j2215658953 [label="Alla fine, tutto quello che posso fare è implorare la tua pazienza. Lua sa che la maggior parte delle volte mi manca.",shape=box,color=blue];
		j2215658953 -> j2895678923;
	j2584944230 [label="Molto bene. Se non ti lasci dissuadere, e sei così curioso? Non sono così turbato dalla morte che causo come... forse potresti aspettarti.",shape=box,color=blue];
		j2584944230 -> j4163906360;
	j2895678923 [label="-P. Lyon Allard",shape=box,color=blue];
		j2895678923 -> "Chat ends.";
	j4163906360 [label="Oppure che si potrebbe ritenere \"appropriato\" per un uomo di chiesa e uno studioso come me.",shape=box,color=blue];
		j4163906360 -> j2398875551;
		j4163906360 -> j4253238801;
	j2398875551 [label="Ho conosciuto più guerra che pace nella vita, Lyon. Se mi lasciassi turbare, non credo che sarei ancora qui. Ma questo non significa che non comporti comunque un vero fardello - un vero costo.",shape=box,color=red];
		j2398875551 -> j2056883631;
	j4253238801 [label="Sono sicuro che gli altri ti abbiano detto chi sono. Cosa sono. Da dove vengo. La morte che mi segue - la morte da cui provengo. La morte che mi definisce. Pensi che qualcosa di ciò che provi possa sorprendermi?",shape=box,color=red];
		j4253238801 -> j3544530892;
	j2056883631 [label="Add 1 to Thermostat counter",color=orange];
		j2056883631 -> j626169034;
	j3544530892 [label="Add -1 to Thermostat counter",color=orange];
		j3544530892 -> j1262632324;
	j626169034 [label="Sì, in effetti.",shape=box,color=blue];
		j626169034 -> j2683695061;
		j626169034 -> j504846679;
	j1262632324 [label="Sì, lo penso.",shape=box,color=blue];
		j1262632324 -> j2683695061;
		j1262632324 -> j504846679;
	j2683695061 [label="Mi dispiace. Sento di averti fatto arrabbiare. Non era mia intenzione.",shape=box,color=red];
		j2683695061 -> j520821121;
	j504846679 [label="Potresti... approfondire?",shape=box,color=red];
		j504846679 -> j2756463045;
	j520821121 [label="Non hai colpa, Drifter. Io sono, come direbbero i nostri fratelli e sorelle di Libertatia, un \"osso duro\".",shape=box,color=blue];
		j520821121 -> j3812483308;
	j2756463045 [label="Gli orrori che riecheggiano nella mia mente sembrano non conoscere confini. Osservo catene di tendini umani che un tempo trasudavano un fresco color cremisi, ora sono diventati fragili e anneriti.",shape=box,color=blue];
		j2756463045 -> j2817390339;
	j3812483308 [label="Sono solo un individuo assediato. Difendo un muro. Aprire il cancello significa minacciare l'integrità delle difese.",shape=box,color=blue];
		j3812483308 -> j933447879;
		j3812483308 -> j4009892161;
	j2817390339 [label="Vedo centomila volti di me stesso, simili ma estranei. Bare vuote, cadaveri di carne umana contorta e spezzata, sospesi nel velo tra la vita e la morte.",shape=box,color=blue];
		j2817390339 -> j2627759482;
	j933447879 [label="Capisco. Quando sarai pronto, potremo parlare.",shape=box,color=red];
		j933447879 -> j2393606547;
	j4009892161 [label="Cosa intendi?",shape=box,color=red];
		j4009892161 -> j2756463045;
	j2627759482 [label="Espressioni chiuse in una maschera di vuoto riposo. Ma nei resti tremolanti delle loro anime, braci che persistono e non muoiono, le sento urlare. Ululare senza fine per ottenere vendetta. Per la libertà.",shape=box,color=blue];
		j2627759482 -> j4164415124;
	j2393606547 [label="Comincio ad avere l'impressione di non avere scelta in questa faccenda.",shape=box,color=blue];
		j2393606547 -> j540852337;
	j4164415124 [label="Per la morte.",shape=box,color=blue];
		j4164415124 -> j1256927807;
	j540852337 [label="+15 Chemistry",color=orange];
		j540852337 -> j1075197098;
	j1256927807 [label="Queste visioni infestano le mie ore di veglia. I miei sogni. Non ho incubi, perché questo è tutto ciò che vivo - tutto ciò che sono diventato.",shape=box,color=blue];
		j1256927807 -> j1274675553;
	j1075197098 [label="Ma, per quel che vale, Marie... mi ha detto che hai buone intenzioni. E io le credo, anche quando non ci credo io stesso.",shape=box,color=blue];
		j1075197098 -> j2895170641;
	j1274675553 [label="Check boolean LyonPainOff",color=orange];
		j1274675553 -> j3784842424 [label=true,color=green];
		j1274675553 -> j4055638769 [label=false,color=brown];
	j2895170641 [label="Alla fine, tutto quello che posso fare è implorare la tua pazienza. Lua sa che la maggior parte delle volte mi manca.",shape=box,color=blue];
		j2895170641 -> j3684390025;
	j3784842424 [label="Solo quando sacrifico i sussurri che riecheggiano nella mia anima, il mondo mi si riflette in un modo simile a quello che potresti trovare familiare.",shape=box,color=blue];
		j3784842424 -> j839507627;
	j4055638769 [label="Solo quando strappo la carne dal mio corpo mentre sacrifico i sussurri che riecheggiano nella mia anima, il mondo mi si riflette in un modo simile a quello che potresti trovare familiare.",shape=box,color=blue];
		j4055638769 -> j839507627;
	j3684390025 [label="-P. Lyon Allard",shape=box,color=blue];
		j3684390025 -> j2522325746;
	j839507627 [label="Per favore, non fingere di sapere cosa \"sento\", Drifter. Temo che tu abbia appena iniziato a capire.",shape=box,color=blue];
		j839507627 -> j3302861478;
		j839507627 -> j3042549981;
		j839507627 -> j3550199785;
	j2522325746 [label="Boolean LyonVisions2d is now true.",color=orange];
		j2522325746 -> "Chat ends.";
	j3302861478 [label="Mi - mi dispiace. No, non lo sapevo.",shape=box,color=red];
		j3302861478 -> j892539305;
	j3042549981 [label="E ho visto tanto orrore e dolore che nemmeno tu puoi capire, Lyon.",shape=box,color=red];
		j3042549981 -> j2468690691;
	j3550199785 [label="Mi dispiace se pensi che io sia stato fuori luogo. Ma voglio capire. Queste tue visioni...",shape=box,color=red];
		j3550199785 -> j1240403917;
	j892539305 [label="Sì. Beh. Sono sopravvissuto a questi lunghi anni. Ne sopporterò altri ancora, ne sono certo. Non devi preoccuparti troppo.",shape=box,color=blue];
		j892539305 -> j4270520825;
	j2468690691 [label="Sono quasi certo che sì, vedendone un po' riflessa nelle immagini di questo luogo. Ma ti consideri davvero superiore? Supremo Conoscitore di Tutti gli Orrori e di Tutte le Sofferenze?",shape=box,color=blue];
		j2468690691 -> j3779753836;
		j2468690691 -> j1534664230;
	j1240403917 [label="Sì. Beh. Ho resistito per tutti questi anni. Ne sopporterò altri ancora, ne sono certo. Non devi preoccuparti troppo.",shape=box,color=blue];
		j1240403917 -> j4270520825;
	j4270520825 [label="Boolean LyonVisions2a is now true.",color=orange];
		j4270520825 -> j158690719;
		j4270520825 -> j2980504935;
	j3779753836 [label="Voglio dire che potrei comprendere ciò che stai vivendo meglio di quanto tu possa pensare.",shape=box,color=red];
		j3779753836 -> j3648148585;
	j1534664230 [label="Voglio dire che ho vissuto un sacco di morti e orrori, Lyon. Quindi non mi piace che mi si parli con sufficienza per questo.",shape=box,color=red];
		j1534664230 -> j519902998;
	j158690719 [label="Ciò che stai descrivendo, Lyon... quella visione è iniziata prima o dopo che eri un protoframe?",shape=box,color=red];
		j158690719 -> j2542248624;
	j2980504935 [label="Possiamo parlarne di nuovo? Per favore?",shape=box,color=red];
		j2980504935 -> j1597718297;
	j3648148585 [label="Boolean LyonVisions2b is now true.",color=orange];
		j3648148585 -> j4090651118;
	j519902998 [label="Boolean LyonVisions2c is now true.",color=orange];
		j519902998 -> j1247870120;
	j2542248624 [label="Fosse una domanda semplice come credi. Comunque, non è una domanda a cui sono disposto a rispondere oggi. Sento che mi sta venendo il mal di testa.",shape=box,color=blue];
		j2542248624 -> j734323566;
	j1597718297 [label="Comincio ad avere l'impressione di non avere scelta in questa faccenda.",shape=box,color=blue];
		j1597718297 -> j734323566;
	j4090651118 [label="Forse ti sembrerà strano che io sia alla ricerca di compassione, Drifter. Le risposte sono ciò che cerco. Certezza. Firmamento, quando tutto è illusione e menzogna.",shape=box,color=blue];
		j4090651118 -> j2883342358;
		j4090651118 -> j3448860381;
	j1247870120 [label="Allora permettimi di inchinarmi ai tuoi piedi. Lodarti per tutto ciò che hai sopportato. Mi chiedo come tu possa essere ancora sano di mente nonostante tutto ciò a cui hai assistito.",shape=box,color=blue];
		j1247870120 -> j1161499838;
	j734323566 [label="+10 Chemistry",color=orange];
		j734323566 -> j912408914;
	j2883342358 [label="Farò quello che posso.",shape=box,color=red];
		j2883342358 -> j765727491;
	j3448860381 [label="Allora forse posso aiutarti. Possiamo parlarne di nuovo? Per piacere?",shape=box,color=red];
		j3448860381 -> j1597718297;
	j1161499838 [label="E mi meraviglio di come riesci ancora a dedicare del tempo a tutti noi, che consideri così al di sotto del tuo status elevato.",shape=box,color=blue];
		j1161499838 -> "Chat ends.";
	j912408914 [label="Ma, per quel che vale, Marie... mi ha detto che hai buone intenzioni. E io le credo, anche quando non ci credo io stesso.",shape=box,color=blue];
		j912408914 -> j2215658953;
	j765727491 [label="+5 Chemistry",color=orange];
		j765727491 -> j3861907450;
	j3861907450 [label="Questo è tutto ciò che si può chiedere, no?",shape=box,color=blue];
		j3861907450 -> "Chat ends.";
}