digraph {
	781 [label="LyonRank4Convo2 begins.",color=orange];
		781 -> 782;
		781 -> 783;
		781 -> 784;
	782 [label="Come fate tu e Marie a conciliare il fatto di essere sacerdote e suora, ma anche di commettere atti di violenza?",shape=box,color=red];
		782 -> 785;
		782 -> 786;
		782 -> 787;
	783 [label="Posso farti una domanda un po' strana, Lyon?",shape=box,color=red];
		783 -> 788;
	784 [label="[Fine.]",shape=box,color=red];
		784 -> 789;
	785 [label="Sento Marie gridare \"païens!\" e lanciarsi nella mischia, eppure... faccio fatica a pensare che sia il tipo di persona che condanna qualcuno per le sue convinzioni. Non riesco a immaginare che anche tu debba essere molto diverso. È chiaro che ha un'alta opinione di te.",shape=box,color=red];
		785 -> 790;
	786 [label="Come reagirebbe la tua chiesa a ciò che tu e Marie state facendo qui? Riguardo... a ciò che vi viene chiesto di fare in loro nome?",shape=box,color=red];
		786 -> 791;
	787 [label="Osservo te e Marie, sul campo di battaglia, poi le parlo in privato e ti vedo leggere libri in silenzio... e immagino che mi risulti difficile far combaciare questi individui nella mia mente.",shape=box,color=red];
	788 [label="Se ritieni che la capacità di descrivere la nostra situazione attuale sia semplicemente \"strana\", o sono impressionato dalla tua forza d'animo o costernato dalla tua mancanza di vocabolario. Immagino, tuttavia, che sia la prima ipotesi.",shape=box,color=blue];
		788 -> 793;
	789 [label="Chat ends.",color=orange];
	790 [label="Hai perfettamente ragione. Marie non è il tipo che condanna qualcuno perché nutre nel cuore un antico dio degli alberi - cercherebbe piuttosto di scoprire quali credenze ha in comune con lui.",shape=box,color=blue];
		790 -> 794;
	791 [label="Molte guerre sante furono combattute ai suoi tempi in nome di Sol e Lua. Le sanguinose \"crociate\" per respingere i \"pagani\" o per \"impadronirsi della terra senta\" o qualsiasi altro ragionamento artificioso erano le preferite del tempo.",shape=box,color=blue];
		791 -> 795;
	793 [label="+5 Chemistry",color=orange];
		793 -> 797;
	794 [label="L'albero non è forse nutrito dalla luce di Sol? Non c'è forse un terreno comune su cui potrebbe condividere il pane con loro? È più propensa a sedersi e ad ascoltare le loro storie, piuttosto che cercare di far loro del male per la loro fede.",shape=box,color=blue];
		794 -> 798;
	795 [label="L'Ortodossia Luminaria non ha eserciti e non combatte guerre. Non impedisce ai suoi membri di agire e di proteggere gli altri.",shape=box,color=blue];
		795 -> 727;
	797 [label="Cioè, procedi. Non puoi rendere la cosa ancora più \"strana\" per me chiedendomi qualunque cosa ti incuriosisca.",shape=box,color=blue];
		797 -> 785;
		797 -> 786;
		797 -> 787;
	798 [label="Quando lei affronta il suo nemico sul campo di battaglia, credo che ci siano due possibilità: o si sta divertendo un po', recitando la parte di un antico crociato e immaginandosi di indossare la scintillante armatura di un Cavaliere di Sol -",shape=box,color=blue];
		798 -> 796;
	727 [label="Quando Marie affronta i suoi nemici sul campo di battaglia, credo che ci siano due possibilità: o si sta divertendo un po', recitando la parte di un antico crociato e immaginandosi di indossare la scintillante armatura di un Cavaliere di Sol -",shape=box,color=blue];
		727 -> 796;
	796 [label="Oppure, più probabilmente, sta ricordando Astaphor 8:23 \"Sole sono le anime che cercano di entrare nella mia casa con la violenza, perché sono quelle scacciate dalla luce di Sol.\"",shape=box,color=blue];
		796 -> 799;
	799 [label="Ai suoi occhi, la violenza che commette è giusta in nome della difesa di un bene superiore - come quella che faresti tu, e quelli che combattono al tuo fianco, suppongo. ",shape=box,color=blue];
		799 -> 800;
	800 [label="E, pertanto, coloro che combatte - indipendentemente dalla loro religione - vengono espulsi da Sol. Anche se indossassero il sacro drappo del suo ordine, ai suoi occhi sarebbero dei pagani.",shape=box,color=blue];
		800 -> 801;
		800 -> 802;
	801 [label="Ho notato che ti sei lasciato fuori da questa storia. Cosa ne pensi di tutti questi litigi?",shape=box,color=red];
		801 -> 803;
	802 [label="Ha senso. Grazie.",shape=box,color=red];
		802 -> 804;
	803 [label="Sono volutamente sfuggente, Drifter.",shape=box,color=blue];
		803 -> 805;
		803 -> 806;
	804 [label="+5 Chemistry",color=orange];
		804 -> 807;
	805 [label="E la mia ostinazione è evidente, Sacerdote.",shape=box,color=red];
		805 -> 808;
	806 [label="Giusto. Oggi mi accontenterò.",shape=box,color=red];
		806 -> 804;
	807 [label="Per quel che vale, Marie... mi ha detto che hai buone intenzioni. E io le credo, anche quando non ci credo io stesso.",shape=box,color=blue];
		807 -> 809;
	808 [label="+10 Chemistry",color=orange];
		808 -> 810;
	809 [label="Alla fine, tutto quello che posso fare è implorare la tua pazienza. Lua sa che la maggior parte delle volte mi manca.",shape=box,color=blue];
		809 -> 811;
	810 [label="Molto bene. Se non ti lasci dissuadere, e sei così curioso? Non sono così turbato dalla morte che causo come... forse potresti aspettarti.",shape=box,color=blue];
		810 -> 812;
	811 [label="-P. Lyon Allard",shape=box,color=blue];
		811 -> 813;
	812 [label="Oppure che si potrebbe ritenere \"appropriato\" per un uomo di chiesa e uno studioso come me.",shape=box,color=blue];
		812 -> 814;
		812 -> 815;
	813 [label="Chat ends.",color=orange];
	814 [label="Ho conosciuto più guerra che pace nella vita, Lyon. Se mi lasciassi turbare, non credo che sarei ancora qui. Ma questo non significa che non comporti comunque un vero fardello - un vero costo.",shape=box,color=red];
		814 -> 816;
	815 [label="Sono sicuro che gli altri ti abbiano detto chi sono. Cosa sono. Da dove vengo. La morte che mi segue - la morte da cui provengo. La morte che mi definisce. Pensi che qualcosa di ciò che provi possa sorprendermi?",shape=box,color=red];
		815 -> 817;
	816 [label="Add 1 to Thermostat",color=orange];
		816 -> 818;
	817 [label="Add -1 to Thermostat",color=orange];
		817 -> 819;
	818 [label="Sì, in effetti.",shape=box,color=blue];
		818 -> 820;
		818 -> 821;
	819 [label="Sì, lo penso.",shape=box,color=blue];
		819 -> 820;
		819 -> 821;
	820 [label="Mi dispiace. Sento di averti fatto arrabbiare. Non era mia intenzione.",shape=box,color=red];
		820 -> 822;
	821 [label="Potresti... approfondire?",shape=box,color=red];
		821 -> 823;
	822 [label="Non hai colpa, Drifter. Io sono, come direbbero i nostri fratelli e sorelle di Libertatia, un \"osso duro\".",shape=box,color=blue];
		822 -> 824;
	823 [label="Gli orrori che riecheggiano nella mia mente sembrano non conoscere confini. Osservo catene di tendini umani che un tempo trasudavano un fresco color cremisi, ora sono diventati fragili e anneriti.",shape=box,color=blue];
		823 -> 825;
	824 [label="Sono solo un individuo assediato. Difendo un muro. Aprire il cancello significa minacciare l'integrità delle difese.",shape=box,color=blue];
		824 -> 826;
		824 -> 827;
	825 [label="Vedo centomila volti di me stesso, simili ma estranei. Bare vuote, cadaveri di carne umana contorta e spezzata, sospesi nel velo tra la vita e la morte.",shape=box,color=blue];
		825 -> 828;
	826 [label="Capisco. Quando sarai pronto, potremo parlare.",shape=box,color=red];
		826 -> 829;
	827 [label="Cosa intendi?",shape=box,color=red];
		827 -> 823;
	828 [label="Espressioni chiuse in una maschera di vuoto riposo. Ma nei resti tremolanti delle loro anime, braci che persistono e non muoiono, le sento urlare. Ululare senza fine per ottenere vendetta. Per la libertà.",shape=box,color=blue];
		828 -> 830;
	829 [label="Comincio ad avere l'impressione di non avere scelta in questa faccenda.",shape=box,color=blue];
		829 -> 831;
	830 [label="Per la morte.",shape=box,color=blue];
		830 -> 832;
	831 [label="+15 Chemistry",color=orange];
		831 -> 833;
	832 [label="Queste visioni infestano le mie ore di veglia. I miei sogni. Non ho incubi, perché questo è tutto ciò che vivo - tutto ciò che sono diventato.",shape=box,color=blue];
		832 -> 834;
	833 [label="Ma, per quel che vale, Marie... mi ha detto che hai buone intenzioni. E io le credo, anche quando non ci credo io stesso.",shape=box,color=blue];
		833 -> 835;
	834 [label="Check boolean LyonPainOff",color=orange];
		834 -> 836 [label=true,color=green];
		834 -> 837 [label=false,color=brown];
	835 [label="Alla fine, tutto quello che posso fare è implorare la tua pazienza. Lua sa che la maggior parte delle volte mi manca.",shape=box,color=blue];
		835 -> 838;
	836 [label="Solo quando sacrifico i sussurri che riecheggiano nella mia anima, il mondo mi si riflette in un modo simile a quello che potresti trovare familiare.",shape=box,color=blue];
		836 -> 839;
	837 [label="Solo quando strappo la carne dal mio corpo mentre sacrifico i sussurri che riecheggiano nella mia anima, il mondo mi si riflette in un modo simile a quello che potresti trovare familiare.",shape=box,color=blue];
		837 -> 839;
	838 [label="-P. Lyon Allard",shape=box,color=blue];
		838 -> 840;
	839 [label="Per favore, non fingere di sapere cosa \"sento\", Drifter. Temo che tu abbia appena iniziato a capire.",shape=box,color=blue];
		839 -> 841;
		839 -> 842;
		839 -> 843;
	840 [label="Update boolean LyonVisions2d",color=orange];
		840 -> 844;
	841 [label="Mi - mi dispiace. No, non lo sapevo.",shape=box,color=red];
		841 -> 845;
	842 [label="E ho visto tanto orrore e dolore che nemmeno tu puoi capire, Lyon.",shape=box,color=red];
		842 -> 846;
	843 [label="Mi dispiace se pensi che io sia stato fuori luogo. Ma voglio capire. Queste tue visioni...",shape=box,color=red];
		843 -> 847;
	844 [label="Chat ends.",color=orange];
	845 [label="Sì. Beh. Sono sopravvissuto a questi lunghi anni. Ne sopporterò altri ancora, ne sono certo. Non devi preoccuparti troppo.",shape=box,color=blue];
		845 -> 848;
	846 [label="Sono quasi certo che sì, vedendone un po' riflessa nelle immagini di questo luogo. Ma ti consideri davvero superiore? Supremo Conoscitore di Tutti gli Orrori e di Tutte le Sofferenze?",shape=box,color=blue];
		846 -> 849;
		846 -> 850;
	847 [label="Sì. Beh. Ho resistito per tutti questi anni. Ne sopporterò altri ancora, ne sono certo. Non devi preoccuparti troppo.",shape=box,color=blue];
		847 -> 848;
	848 [label="Update boolean LyonVisions2a",color=orange];
		848 -> 851;
		848 -> 852;
	849 [label="Voglio dire che potrei comprendere ciò che stai vivendo meglio di quanto tu possa pensare.",shape=box,color=red];
		849 -> 853;
	850 [label="Voglio dire che ho vissuto un sacco di morti e orrori, Lyon. Quindi non mi piace che mi si parli con sufficienza per questo.",shape=box,color=red];
		850 -> 854;
	851 [label="Ciò che stai descrivendo, Lyon... quella visione è iniziata prima o dopo che eri un protoframe?",shape=box,color=red];
		851 -> 855;
	852 [label="Possiamo parlarne di nuovo? Per favore?",shape=box,color=red];
		852 -> 856;
	853 [label="Update boolean LyonVisions2b",color=orange];
		853 -> 857;
	854 [label="Update boolean LyonVisions2c",color=orange];
		854 -> 858;
	855 [label="Fosse una domanda semplice come credi. Comunque, non è una domanda a cui sono disposto a rispondere oggi. Sento che mi sta venendo il mal di testa.",shape=box,color=blue];
		855 -> 859;
	856 [label="Comincio ad avere l'impressione di non avere scelta in questa faccenda.",shape=box,color=blue];
		856 -> 859;
	857 [label="Forse ti sembrerà strano che io sia alla ricerca di compassione, Drifter. Le risposte sono ciò che cerco. Certezza. Firmamento, quando tutto è illusione e menzogna.",shape=box,color=blue];
		857 -> 860;
		857 -> 861;
	858 [label="Allora permettimi di inchinarmi ai tuoi piedi. Lodarti per tutto ciò che hai sopportato. Mi chiedo come tu possa essere ancora sano di mente nonostante tutto ciò a cui hai assistito.",shape=box,color=blue];
		858 -> 862;
	859 [label="+10 Chemistry",color=orange];
		859 -> 863;
	860 [label="Farò quello che posso.",shape=box,color=red];
		860 -> 864;
	861 [label="Allora forse posso aiutarti. Possiamo parlarne di nuovo? Per piacere?",shape=box,color=red];
		861 -> 856;
	862 [label="E mi meraviglio di come riesci ancora a dedicare del tempo a tutti noi, che consideri così al di sotto del tuo status elevato.",shape=box,color=blue];
		862 -> 865;
	863 [label="Ma, per quel che vale, Marie... mi ha detto che hai buone intenzioni. E io le credo, anche quando non ci credo io stesso.",shape=box,color=blue];
		863 -> 866;
	864 [label="+5 Chemistry",color=orange];
		864 -> 867;
	865 [label="Chat ends.",color=orange];
	866 [label="Alla fine, tutto quello che posso fare è implorare la tua pazienza. Lua sa che la maggior parte delle volte mi manca.",shape=box,color=blue];
		866 -> 868;
	867 [label="Questo è tutto ciò che si può chiedere, no?",shape=box,color=blue];
		867 -> 869;
	868 [label="-P. Lyon Allard",shape=box,color=blue];
		868 -> 870;
	869 [label="Chat ends.",color=orange];
	870 [label="Chat ends.",color=orange];
}