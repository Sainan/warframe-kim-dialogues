		j2183298434 -> j368294903 [label=false,color=brown];
		j2183298434 -> j672834351 [label=false,color=brown];
	j2813659659 [label="Sono felice che ci sia qualcuno che riesca a trovare la forza di andare oltre le ortiche della personalità di Roathe per vedere la distruzione che giace dentro di lui.",shape=box,color=blue];
		j2813659659 -> j242598700;
	j3781117769 [label="Posso chiederti quella che temo sia una domanda indelicata, amico mio?",shape=box,color=blue];
		j3781117769 -> j1211910367;
		j3781117769 -> j4187733387;
	j3230485215 [label="Che domanda meravigliosamente positiva e deliziosamente banale. Non mi viene posta spesso.",shape=box,color=blue];
		j3230485215 -> j4285170051;
	j1462315026 [label="Sì, dimmi. C'è qualcosa che non va?",shape=box,color=blue];
		j1462315026 -> j391655716;
		j1462315026 -> j2902560312;
	j2052928057 [label="Mi stai rendendo nervoso. Cosa c'è che non va?",shape=box,color=red];
		j2052928057 -> j2633223404;
	j3792827421 [label="Ci sono. Procedi.",shape=box,color=red];
		j3792827421 -> j505873533;
	j4014167547 [label="Non sapevo come avresti reagito, visto che...",shape=box,color=red];
		j4014167547 -> j1743002946;
	j368294903 [label="Sono in una sorta di... ammirazione.",shape=box,color=red];
		j368294903 -> j1887253235;
	j672834351 [label="Questa è la conversazione dove finirai per minacciarmi? O?",shape=box,color=red];
		j672834351 -> j2997925910;
	j242598700 [label="So, anche se lo nega con veemenza, che si crede un codardo. Non lo etichetterei mai come tale.",shape=box,color=blue];
		j242598700 -> j1604138714;
	j1211910367 [label="Certo. Io te ne ho chieste tante.",shape=box,color=red];
		j1211910367 -> j3705980861;
	j4187733387 [label="Perché sto uscendo con Roathe?",shape=box,color=red];
		j4187733387 -> j3627813601;
	j4285170051 [label="Sto... abbastanza bene, grazie.",shape=box,color=blue];
		j4285170051 -> j283933596;
	j391655716 [label="Non importa. Scusa. In realtà, ho dimenticato cosa stavo per dire.",shape=box,color=red];
		j391655716 -> j134218048;
	j2902560312 [label="Non so come esprimerlo al meglio, quindi te lo dirò senza mezzi termini - provo dei sentimenti per te.",shape=box,color=red];
		j2902560312 -> j1252012262;
	j2633223404 [label="Non c'è niente che non va - anzi, è proprio questo che è fondamentale che tu comprenda - le terribili conseguenze da cui desidero liberarti, qualora tu dessi per scontato che potrebbero derivarne.",shape=box,color=blue];
		j2633223404 -> j2481853229;
		j2633223404 -> j1941701738;
		j2633223404 -> j353280530;
	j505873533 [label="+5 Chemistry",color=orange];
		j505873533 -> j2026029530;
	j1743002946 [label="Ah. Pensi che mi sorprenda? Io sto all'ombra della sua luce e lo sono sempre stato. No, amico mio - non sono né amareggiato né geloso per questo, te lo prometto.",shape=box,color=blue];
		j1743002946 -> j3917102249;
	j1887253235 [label="Come tutti noi. La sorella della mia anima non smette mai di stupirmi. Sono felice per voi due oltre ogni limite espressivo.",shape=box,color=blue];
		j1887253235 -> j63694536;
	j2997925910 [label="Mh? No. Non sarei così presuntioso da andarmene in giro e fingere di essere il suo guardiano. È capace di romperti le ossa dovesse decidere che fosse necessario.",shape=box,color=blue];
		j2997925910 -> j1625587475;
	j1604138714 [label="Entrati gli disse che sarebbe stato necessario per salvare un futuro che non conosceva. Un futuro su cui non aveva alcun potere, nessun popolo che si prostrasse ai suoi piedi, nessun servitore che lo adorasse.",shape=box,color=blue];
		j1604138714 -> j1512765679;
	j3705980861 [label="Cosa... vedi in Roathe che vi a spinti a... corteggiarvi?",shape=box,color=blue];
		j3705980861 -> j3252158339;
		j3705980861 -> j2661068488;
		j3705980861 -> j2331140309;
	j3627813601 [label="Vedo che o ti sei già trovato di fronte a questo tipo di domanda, o te lo aspettavi. Sì. Proprio così. Cosa... vedi in lui?",shape=box,color=blue];
		j3627813601 -> j3252158339;
		j3627813601 -> j2661068488;
		j3627813601 -> j2331140309;
	j283933596 [label="+20 Chemistry",color=orange];
		j283933596 -> j4036746172;
	j134218048 [label="Mi capita spesso. Spesso quando passo dalle porte. Spesso mi sono chiesto perché.",shape=box,color=blue];
		j134218048 -> j968281869;
	j1252012262 [label="Io... ne sei... certo? Stai bene? Non hai sbattuto di recente la testa, vero?",shape=box,color=blue];
		j1252012262 -> j1446918470;
		j1252012262 -> j873589617;
	j2481853229 [label="Sto ascoltando.",shape=box,color=red];
		j2481853229 -> j2705510894;
	j1941701738 [label="Non ha molto senso.",shape=box,color=red];
		j1941701738 -> j2826418691;
	j353280530 [label="Terribili conseguenze di... cosa?",shape=box,color=red];
		j353280530 -> j3209415727;
	j2026029530 [label="Grazie. Prima di iniziare, vorrei assicurarti che non c'è nulla che non va - ma è proprio in questo che risiedono forse le terribili conseguenze delle quali vorrei liberarti, qualora tu dessi per scontato che potrebbero derivarne.",shape=box,color=blue];
		j2026029530 -> j2481853229;
		j2026029530 -> j1941701738;
		j2026029530 -> j353280530;
	j3917102249 [label="Non provo alcun risentimento per ciò che è successo tra noi, riesco solo a esprimere la mia gratitudine per il tempo che abbiamo trascorso insieme.",shape=box,color=blue];
		j3917102249 -> j866186442;
	j63694536 [label="C'è tanta gioia nei suoi occhi nei momenti dove parla di te. È euforica ogni volta che pensa che potresti passare a trovarla.",shape=box,color=blue];
		j63694536 -> j2176622066;
	j1625587475 [label="Volevo solo dirti che la sua felicità è contagiosa - e anche a me viene da sorridere a pensarci. Quindi, per questo, devo ringraziarti.",shape=box,color=blue];
		j1625587475 -> j3311435967;
	j1512765679 [label="Potrebbe pensare che sia un atto di paura - un topo che fugge da una nave che affonda - assumere il siero e dimenticare le azioni che lo hanno portato a farlo. ",shape=box,color=blue];
		j1512765679 -> j1276034874;
	j3252158339 [label="Per dirla senza mezzi termini? L'hai visto?",shape=box,color=red];
		j3252158339 -> j1628618092;
	j2661068488 [label="Penso che ci sia del dolore in lui, da qualche parte sotto tutto quell'... umorismo e personalità.",shape=box,color=red];
		j2661068488 -> j2608657955;
	j2331140309 [label="Io... non posso farci niente. C'è un'oscurità e un pericolo in lui che trovo allettanti. Mi attrae.",shape=box,color=red];
		j2331140309 -> j754576607;
	j4036746172 [label="Sì, credo di stare davvero bene oggi.",shape=box,color=blue];
		j4036746172 -> j971819460;
	j968281869 [label="+5 Chemistry",color=orange];
		j968281869 -> j971819460;
	j1446918470 [label="Perché è così difficile crederci?",shape=box,color=red];
		j1446918470 -> j1500174837;
	j873589617 [label="Ne sono sicuro, Lyon. Non ho sbattuto la testa.",shape=box,color=red];
		j873589617 -> j1500174837;
	j2705510894 [label="+5 Chemistry",color=orange];
		j2705510894 -> j2389972529;
	j2826418691 [label="Sì. Ne sono dolorosamente consapevole.",shape=box,color=blue];
		j2826418691 -> j3209415727;
	j3209415727 [label="Permettimi di ricominciare.",shape=box,color=blue];
		j3209415727 -> j2389972529;
	j866186442 [label="+10 Chemistry",color=orange];
		j866186442 -> j985067695;
	j2176622066 [label="+10 Chemistry",color=orange];
		j2176622066 -> j1625587475;
	j3311435967 [label="- Lyon",shape=box,color=blue];
		j3311435967 -> "Chat ends.";
	j1276034874 [label="Lo vedo come un uomo che ha visto i calcoli del campo di battaglia e ha saputo abbandonare una nave già perduta. Anche se la guerra non era ancora finita.",shape=box,color=blue];
		j1276034874 -> j1494212890;
	j1628618092 [label="Lungi da me condannarti.",shape=box,color=blue];
		j1628618092 -> j3461401973;
	j2608657955 [label="+5 Chemistry",color=orange];
		j2608657955 -> j3015250028;
	j754576607 [label="Posso capirne l'attrazione. Non negherò di non vederla. Tuttavia, spero per il tuo bene che non ti lascerai consumare da essa.",shape=box,color=blue];
		j754576607 -> j147179086;
	j971819460 [label="Ti auguro una splendida giornata. - Lyon",shape=box,color=blue];
		j971819460 -> "Chat ends.";
	j1500174837 [label="Beh, per essere schietti - quando hai così tante altre opzioni davanti a te... Marie o Roathe o... chiunque altro nell'universo...",shape=box,color=blue];
		j1500174837 -> j3508058318;
	j2389972529 [label="Sono consapevole che molti potrebbero interpretarmi come... malato, e in effetti potrei benissimo esserlo. Come minimo, non ho del tutto la mente sana.",shape=box,color=blue];
		j2389972529 -> j3115994775;
	j985067695 [label="Ora, sono felice che tu lo trascorra con lei. Ti porterà gioia, dove io potrei solo portarti tristezza. Sii felice con lei. Hai tutte le mie benedizioni.",shape=box,color=blue];
		j985067695 -> j3311435967;
	j1494212890 [label="Evaluate expressions",color=orange];
		j1494212890 -> j1704750740 [label="RoatheVillian",color=purple];
		j1494212890 -> j1953578166 [label="RoatheVillian",color=purple];
		j1494212890 -> j1022794129 [label="RoatheVillian",color=purple];
		j1494212890 -> j1704750740 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j1953578166 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j542295984 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j1022794129 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j1704750740 [label="false",color=purple];
		j1494212890 -> j1953578166 [label="false",color=purple];
	j3461401973 [label="Tuttavia, per il tuo bene, spero che questa mania passi in fretta e non diventi una dipendenza. Ho visto cose del genere distruggere altre persone.",shape=box,color=blue];
		j3461401973 -> j1244573773;
	j3015250028 [label="Sì, l'ho visto con i miei occhi. Sepolti in profondità, certo. Ma potrebbe non gradire i tuoi tentativi d'intrusione. Credo che gli piaccia ciò che è diventato.",shape=box,color=blue];
		j3015250028 -> j1244573773;
	j147179086 [label="Tali accordi dovrebbero basarsi su qualcosa di più della semplice... oscurità. Tuttavia, non ti farò la predica.",shape=box,color=blue];
		j147179086 -> j1244573773;
	j3508058318 [label="Faccio fatica a credere che tu possa scegliere di intrattenerti con una vetrata rotta come me... se non perché stai veramente male.",shape=box,color=blue];
		j3508058318 -> j1654323968;
		j3508058318 -> j1170424025;
	j3115994775 [label="Da tempo ho fatto pace con tutto questo. Non mi turba più. Le visioni che mi tormentano - le voci - ho trovato il modo di conviverci senza paura o odio.",shape=box,color=blue];
		j3115994775 -> j3712802489;
	j1704750740 [label="Sono semplicemente felice di esserci per lui, in qualsiasi modo possibile.",shape=box,color=red];
		j1704750740 -> j16805893;
	j1953578166 [label="Quello che gli è successo è... complicato. Credo che ci vorrà un bel po' di tempo per elaborarlo.",shape=box,color=red];
		j1953578166 -> j16805893;
	j1022794129 [label="Esatto. Lo ha fatto per vincere la guerra, e a volte questo significa perdere qualche battaglia.",shape=box,color=red];
		j1022794129 -> j16805893;
	j542295984 [label="Col tempo se lo perdonerà. Ma non credo che il suo involucro esterno cambierà mai del tutto.",shape=box,color=red];
		j542295984 -> j16805893;
	j1244573773 [label="Conosci la tua mente e i tuoi limiti. Vi auguro il meglio a entrambi.",shape=box,color=blue];
		j1244573773 -> j4130748422;
	j1654323968 [label="Lyon? Provo qualcosa per te. Mi importa di te. Vorrei stare con te, se tu vuoi stare con me.",shape=box,color=red];
		j1654323968 -> j946061896;
	j1170424025 [label="Se stai dicendo che non è reciproco...",shape=box,color=red];
		j1170424025 -> j67070548;
	j3712802489 [label="(Ultimamente, penso, un po' per dispetto, se devo essere sincero, ma non è questo il punto.)",shape=box,color=blue];
		j3712802489 -> j457682597;
	j16805893 [label="+10 Chemistry",color=orange];
		j16805893 -> j713099769;
	j4130748422 [label="+10 Chemistry",color=orange];
		j4130748422 -> j91451766;
	j946061896 [label="Perdonami, ti prego perdonami - io semplicemente - pensavo fosse impossibile, questo è... qualcosa che non avrei... potuto... immaginare...",shape=box,color=blue];
		j946061896 -> j961180182;
	j67070548 [label="Per niente! Non è questo che intendevo dire! Tutt'altro - anzi, io semplicemente - pensavo fosse impossibile, questa non è... una cosa che... avrei... potuto... immaginare...",shape=box,color=blue];
		j67070548 -> j961180182;
	j457682597 [label="Ma vorrei che tu capissi che se tu dovessi porre fine a questo tra noi - a questo legame che prima pensavo fosse impossibile tra me e un'altra persona -",shape=box,color=blue];
		j457682597 -> j3343490842;
	j713099769 [label="Vi auguro a entrambi la migliore fortuna possibile.",shape=box,color=blue];
		j713099769 -> j91451766;
	j91451766 [label="Inoltre, ora che sembra avere un desiderio da soddisfare, ha smesso di provocare Marie.",shape=box,color=blue];
		j91451766 -> j2132162296;
	j961180182 [label="+20 Chemistry",color=orange];
		j961180182 -> j3367528885;
	j3343490842 [label="Se mai lasciassi che il tuo cuore si allontanasse dal mio? ",shape=box,color=blue];
		j3343490842 -> j3701604984;
	j2132162296 [label="Beh. O almeno non lo fa più così spesso. Arrivederci per ora.",shape=box,color=blue];
		j2132162296 -> j3311435967;
	j3367528885 [label="Sei davvero il mon miracle...",shape=box,color=blue];
		j3367528885 -> j1374158912;
	j3701604984 [label="Saprei come resistere, mon miracle.",shape=box,color=blue];
		j3701604984 -> j2418155792;
	j1374158912 [label="Boolean LyonDating is now true.",color=orange];
		j1374158912 -> j4115967391;
	j2418155792 [label="Non mi lascerei consumare da ciò che mi ha tormentato. ",shape=box,color=blue];
		j2418155792 -> j1697539566;
	j4115967391 [label="Boolean IsDating is now true.",color=orange];
		j4115967391 -> j3642226382;
	j1697539566 [label="Check boolean LyonAllRight",color=orange];
		j1697539566 -> j3188449030 [label=true,color=green];
		j1697539566 -> j1205565899 [label=false,color=brown];
	j3642226382 [label="Boolean LyonHasDated is now true.",color=orange];
		j3642226382 -> "Chat ends.";
	j3188449030 [label="Per usare una tua familiare espressione, starò bene. Troverò motivo di sorridere e ridere ancora una volta.",shape=box,color=blue];
		j3188449030 -> j1078346298;
		j3188449030 -> j4125903480;
	j1205565899 [label="Sopravviverei. Starei bene. Troverei motivo di sorridere e ridere ancora una volta.",shape=box,color=blue];
		j1205565899 -> j1078346298;
		j1205565899 -> j4125903480;
	j1078346298 [label="Oh, Lyon... non sei un peso per me.",shape=box,color=red];
		j1078346298 -> j1720732208;
	j4125903480 [label="Mi stai dicendo... che vuoi mettere un punto alla nostra storia?",shape=box,color=red];
		j4125903480 -> j2223777492;
	j1720732208 [label="Sto semplicemente cercando di liberarti da qualsiasi difficoltà tu possa percepire nei miei confronti...",shape=box,color=blue];
		j1720732208 -> j2214300933;
		j1720732208 -> j3096244347;
		j1720732208 -> j3878108370;
	j2223777492 [label="No! Niente del genere! Sto semplicemente cercando di liberarti da qualsiasi difficoltà tu possa percepire nei miei confronti.",shape=box,color=blue];
		j2223777492 -> j2214300933;
		j2223777492 -> j3096244347;
		j2223777492 -> j3878108370;
	j2214300933 [label="Il tuo dolore... rispecchia in parte il mio. Non sarebbe mai un problema aiutarti a superarlo.",shape=box,color=red];
		j2214300933 -> j4013483866;
	j3096244347 [label="Non riesco a descrivere cosa mi attrae di te. Ma non sarai mai un dovere o un peso.",shape=box,color=red];
		j3096244347 -> j3356902177;
	j3878108370 [label="[Lascia Lyon.] Tutto questo è troppo per me, mi dispiace. Forse è meglio chiuderla qui.",shape=box,color=red];
		j3878108370 -> j467734062;
	j4013483866 [label="Non posso esprimere quanto il mio cuore si spezzi per te. Ma sono eternamente grato che i nostri solitari fantasmi di dolore si siano ritrovati.",shape=box,color=blue];
		j4013483866 -> j988816530;
	j3356902177 [label="Non riesco a esprimere adeguatamente la mia gratitudine, e credo che le parole non ci riusciranno mai.",shape=box,color=blue];
		j3356902177 -> j988816530;
	j467734062 [label="Sì. Certo. Sarebbe... ipocrita accettare qualsiasi altra risposta in questo momento... ",shape=box,color=blue];
		j467734062 -> j2191331750;
	j988816530 [label="Ma ora che mi sono sforzato molto per affrontare quello che è stato uno spettacolarmente autoindulgente preambolo...",shape=box,color=blue];
		j988816530 -> j2503295683;
		j988816530 -> j2441831647;
		j988816530 -> j1841984262;
	j2191331750 [label="Capisco perfettamente. E non ti auguro altro che il meglio. Custodirò gelosamente tutti i momenti che abbiamo trascorso insieme.",shape=box,color=blue];
		j2191331750 -> j1689630923;
	j2503295683 [label="Per uno che ha iniziato con il silenzio, sei diventato veramente prolisso.",shape=box,color=red];
		j2503295683 -> j2648493353;
	j2441831647 [label="L'ho trovato accattivante, non preoccuparti.",shape=box,color=red];
		j2441831647 -> j3528115581;
	j1841984262 [label="Avresti potuto semplicemente dire 'Sai, starò bene se mai dovessimo prendere strade diverse.'",shape=box,color=red];
		j1841984262 -> j2920090570;
	j1689630923 [label="Lì ricorderò nella mia anima, anche se svaniranno nella mia mente. Arrivederci.",shape=box,color=blue];
		j1689630923 -> j3994460333;
	j2648493353 [label="+5 Chemistry",color=orange];
		j2648493353 -> j2576054875;
	j3528115581 [label="+5 Chemistry",color=orange];
		j3528115581 -> j644178362;
	j2920090570 [label="+5 Chemistry",color=orange];
		j2920090570 -> j3434243213;
	j3994460333 [label="Boolean LyonDating is now false.",color=orange];
		j3994460333 -> j4254443866;
	j2576054875 [label="Bah! Se non volevi essere a conoscenza dei meccanismi più intimi della mia mente, non avresti dovuto curiosarci dentro. La colpa è solo tua.",shape=box,color=blue];
		j2576054875 -> j881457012;
	j644178362 [label="Sono molto contento che apprezzi i miei erratismi. È proprio per questo che scelgo di parlare così poco. Riesci a immaginare cosa significhi supportare tutto questo? Marie mi avrebbe liquidato anni fa come un cane rabbioso.",shape=box,color=blue];
		j644178362 -> j881457012;
	j3434243213 [label="C'è una certa dose di irriverenza e sarcasmo in cui sei naturalmente portato, a cui non potrei mai sperare di arrivare. Lo lascerò per te.",shape=box,color=blue];
		j3434243213 -> j881457012;
	j4254443866 [label="Boolean IsDating is now false.",color=orange];
		j4254443866 -> j3311435967;
	j881457012 [label="Tuttavia, tutto questo doveva servire da pretesto per una storia che ora sembrerà piuttosto breve rispetto al resto...",shape=box,color=blue];
		j881457012 -> j4069083308;
	j4069083308 [label="Mi sono svegliato stanotte da un incubo. Quando è successo, delle ombre mi hanno circondato. Niente di estraneo o di nuovo nel mio stato. Incombevano sul mio letto e non volevo disperdersi.",shape=box,color=blue];
		j4069083308 -> j3658093130;
	j3658093130 [label="Non ero spaventanto, perché sapevo che non potevano farmi del male. Tuttavia, non volevano nemmeno sparire dalla mia mente. Solo una persona sarebbe stata in grado di mandarle via.",shape=box,color=blue];
		j3658093130 -> j3906125265;
	j3906125265 [label="Mi sono alzato dal letto, mi sono vestito, barcollando, per via della visione offuscata dell'incubo persistente. Ho afferrato il mio incensiere e sono caduto in ginocchio al centro della stanza, preparandomi a... beh. ",shape=box,color=blue];
		j3906125265 -> j912288449;
	j912288449 [label="Mi sono preparato a 'schiarirmi le idee'. Mettiamola così.",shape=box,color=blue];
		j912288449 -> j4006001228;
	j4006001228 [label="Ma con gli occhi chiusi, la mia mente vagava. I miei pensieri andavano alla deriva... verso di te, mon miracle...",shape=box,color=blue];
		j4006001228 -> j811326314;
	j811326314 [label="Il suono della tua voce. Il tocco della tua mano sulla mia spalla... ",shape=box,color=blue];
		j811326314 -> j351301391;
	j351301391 [label="E le visioni... fuggirono. Abbandonarono il loro posto, scacciate dal fantasma più forte... te.",shape=box,color=blue];
		j351301391 -> j3917271634;
	j3917271634 [label="Poi... una volta in piedi. Ho posato il mio incensiere sul comodino e... ho scelto di camminare attraverso la sabbia del Sanctum...",shape=box,color=blue];
		j3917271634 -> j965704970;
		j3917271634 -> j2505803648;
	j965704970 [label="Ora capisco perché hai sentito la necessità di questo preambolo.",shape=box,color=red];
		j965704970 -> j2071753085;
	j2505803648 [label="Non so cosa dire...",shape=box,color=red];
		j2505803648 -> j1675599313;
	j2071753085 [label="Sì. Beh. Durante la mia passeggiata... ho capito subito il pericolo oscuro di un momento simile. Che tu potessi... arrivare a considerarlo una responsabilità - arrivare a vedermi come catene che ti appesantiscono.",shape=box,color=blue];
		j2071753085 -> j1647237147;
	j1675599313 [label="+5 Chemistry",color=orange];
		j1675599313 -> j3219834394;
	j1647237147 [label="Ti supplico - prego qualsiasi dio o dei in cielo o in terra - di non farlo mai. Questo è un dono che mi hai fatto, e ogni volta nella sua novità lo custodirò gelosamente.",shape=box,color=blue];
		j1647237147 -> j2713718305;
	j3219834394 [label="Non servono parole, mon miracle... ",shape=box,color=blue];
		j3219834394 -> j3309495645;
	j2713718305 [label="Giurami, mon miracle - che se dovesse giungere il momento in cui sarò diventato per te una gabbia vuota... sarai libero da me.",shape=box,color=blue];
		j2713718305 -> j2462412172;
	j3309495645 [label="Durante la mia passeggiata... ho capito subito il pericolo oscuro di un momento simile. Che tu potessi... arrivare a considerarlo una responsabilità - arrivare a vedermi come catene che ti appesantiscono.",shape=box,color=blue];
		j3309495645 -> j1647237147;
	j2462412172 [label="Non sarò una prigione vuota per coloro che amo. Non per te. Non per Marie.",shape=box,color=blue];
		j2462412172 -> j1741343424;
		j2462412172 -> j3340941918;
	j1741343424 [label="[Lascia Lyon.] Non - non posso. Non posso prometterlo, mi dispiace.",shape=box,color=red];
		j1741343424 -> j2450019620;
	j3340941918 [label="Te lo prometto. ",shape=box,color=red];
		j3340941918 -> j1274983816;
	j2450019620 [label="+10 Chemistry",color=orange];
		j2450019620 -> j2155185514;
	j1274983816 [label="+10 Chemistry",color=orange];
		j1274983816 -> j401840743;
	j2155185514 [label="Grazie. Grazie, mon miracle, per la tua onestà. Ci è voluto coraggio, in questo momento, e ti ammiro per questo.",shape=box,color=blue];
		j2155185514 -> j1282651163;
	j401840743 [label="Grazie. Grazie, mon miracle...",shape=box,color=blue];
		j401840743 -> j750045339;
	j1282651163 [label="Farò tesoro di tutti i momenti che abbiamo trascorso insieme. Con questo, intendo molto più di quanto tu possa immaginare.",shape=box,color=blue];
		j1282651163 -> j1689630923;
	j750045339 [label="All'improvviso mi sento così stanco... come se... un grosso peso mi fosse stato tolto dalla spalle. Temo di dovermi sdraiare.",shape=box,color=blue];
		j750045339 -> j21916968;
	j21916968 [label="- Lyon",shape=box,color=blue];
		j21916968 -> j3446510588;
	j3446510588 [label="Boolean LyonDatingConfession is now true.",color=orange];
		j3446510588 -> "Chat ends.";
