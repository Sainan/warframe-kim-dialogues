	2215 [label="Chat ends.",color=orange];
	2216 [label="I wish, if I may, to discuss something briefly that I think would put both of our minds at ease, mon miracle.",shape=box,color=blue];
		2216 -> 2217;
		2216 -> 2218;
	2214 [label="Chat ends.",color=orange];
	2217 [label="[Fine.]",shape=box,color=red];
		2217 -> 2219;
	2218 [label="Is something wrong, Lyon?",shape=box,color=red];
		2218 -> 2220;
	2219 [label="Update boolean LyonConsentComplete",color=orange];
		2219 -> 2221;
	2220 [label="No, nothing is the matter. I simply wished to say that I know you spend time with another in a... amorous way, when you are not with me.",shape=box,color=blue];
		2220 -> 2222;
	2221 [label="Chat ends.",color=orange];
	2222 [label="And I simply wished to assure you that this does not give me pause nor unease. Your presence in my life has brought me nothing but peace, nothing but joy...",shape=box,color=blue];
		2222 -> 2223;
	2223 [label="And how could I ever deny that kind of gift to be bestowed upon another?",shape=box,color=blue];
		2223 -> 2224;
		2223 -> 2225;
	2224 [label="I do think they would adore you, for what it's worth.",shape=box,color=red];
		2224 -> 2226;
	2225 [label="Thank you. That means a lot to me.",shape=box,color=red];
		2225 -> 2227;
	2226 [label="The thought of it makes me smile. And who knows, perhaps in another life, or another day, we may meet. ",shape=box,color=blue];
		2226 -> 2228;
	2227 [label="As we are - as I am, with all you have brought me, all that we represent... I am content. Nay, I am... happy. For the first time in a very, very long time.",shape=box,color=blue];
		2227 -> 2229;
	2228 [label="But in this one, I am content as we are. Nay, I am... happy. For the first time in a very, very long time.",shape=box,color=blue];
		2228 -> 2229;
	2229 [label="And I have you to thank for it. For now, however, I bid you farewell.",shape=box,color=blue];
		2229 -> 2230;
	2230 [label="- Lyon",shape=box,color=blue];
