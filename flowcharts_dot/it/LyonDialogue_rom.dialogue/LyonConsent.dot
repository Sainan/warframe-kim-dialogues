	"Chat ends." [color=orange];
	j1181132753 [label="Check boolean LyonConsentComplete",color=orange];
		j1181132753 -> "Chat ends." [label=true,color=green];
		j1181132753 -> j905765498 [label=false,color=brown];
	j1316396836 [label="Check boolean LyonPolyamorySuccess",color=orange];
		j1316396836 -> j1181132753 [label=true,color=green];
		j1316396836 -> "Chat ends." [label=false,color=brown];
	j905765498 [label="Vorrei se mi è consentito, discutere brevemente di qualcosa che penso possa tranquilizzare entrambi, mon miracle.",shape=box,color=blue];
		j905765498 -> j557971759;
		j905765498 -> j976508466;
	j557971759 [label="[Fine.]",shape=box,color=red];
		j557971759 -> j3944516755;
	j976508466 [label="C'è qualcosa che non va, Lyon?",shape=box,color=red];
		j976508466 -> j4290072268;
	j3944516755 [label="Boolean LyonConsentComplete is now true.",color=orange];
		j3944516755 -> "Chat ends.";
	j4290072268 [label="No, non c'è niente che non va. Volevo solo dirti che so che trascorri del tempo con un'altra persona in modo... amoroso diciamo, quando non sei con me.",shape=box,color=blue];
		j4290072268 -> j2829999752;
	j2829999752 [label="E volevo semplicemente assicurarti che questo non mi dà ne esitazione, né disagio. La tua presenza nella mia vita non mi ha portato altro che pace, gioia...",shape=box,color=blue];
		j2829999752 -> j2322631439;
	j2322631439 [label="E come potrei mai negare che un dono del genere venga concesso a un altro?",shape=box,color=blue];
		j2322631439 -> j2540027147;
		j2322631439 -> j2525978433;
	j2540027147 [label="Penso proprio che ti adorerebbe, per quel che vale.",shape=box,color=red];
		j2540027147 -> j1277470564;
	j2525978433 [label="Grazie. Significa molto per me.",shape=box,color=red];
		j2525978433 -> j2948593731;
	j1277470564 [label="Il solo pensiero mi fa sorridere. E chissà, forse in un'altra vita, o un altro giorno, potremmo incontrarci ",shape=box,color=blue];
		j1277470564 -> j36847234;
	j2948593731 [label="Così come siamo - così come sono - con tutto ciò che mi hai portato, tutto ciò che rappresentiamo... sono contento. Anzi, sono... felice. Per la prima volta da molto, molto tempo.",shape=box,color=blue];
		j2948593731 -> j1742918516;
	j36847234 [label="Ma in questo caso, sono contento così come siamo. No anzi, sono... felice. Per la prima volta da molto, molto tempo.",shape=box,color=blue];
		j36847234 -> j1742918516;
	j1742918516 [label="E devo ringraziare te per questo. Per il momento, però, ti devo salutare.",shape=box,color=blue];
		j1742918516 -> j698039068;
	j698039068 [label="- Lyon",shape=box,color=blue];
		j698039068 -> j3944516755;
}