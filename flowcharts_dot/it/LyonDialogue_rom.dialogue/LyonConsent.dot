	2215 [label="Chat ends.",color=orange];
	2216 [label="Vorrei se mi è consentito, discutere brevemente di qualcosa che penso possa tranquilizzare entrambi, mon miracle.",shape=box,color=blue];
		2216 -> 2217;
		2216 -> 2218;
	2214 [label="Chat ends.",color=orange];
	2217 [label="[Fine.]",shape=box,color=red];
		2217 -> 2219;
	2218 [label="C'è qualcosa che non va, Lyon?",shape=box,color=red];
		2218 -> 2220;
	2219 [label="Update boolean LyonConsentComplete",color=orange];
		2219 -> 2221;
	2220 [label="No, non c'è niente che non va. Volevo solo dirti che so che trascorri del tempo con un'altra persona in modo... amoroso diciamo, quando non sei con me.",shape=box,color=blue];
		2220 -> 2222;
	2221 [label="Chat ends.",color=orange];
	2222 [label="E volevo semplicemente assicurarti che questo non mi dà ne esitazione, né disagio. La tua presenza nella mia vita non mi ha portato altro che pace, gioia...",shape=box,color=blue];
		2222 -> 2223;
	2223 [label="E come potrei mai negare che un dono del genere venga concesso a un altro?",shape=box,color=blue];
		2223 -> 2224;
		2223 -> 2225;
	2224 [label="Penso proprio che ti adorerebbe, per quel che vale.",shape=box,color=red];
		2224 -> 2226;
	2225 [label="Grazie. Significa molto per me.",shape=box,color=red];
		2225 -> 2227;
	2226 [label="Il solo pensiero mi fa sorridere. E chissà, forse in un'altra vita, o un altro giorno, potremmo incontrarci ",shape=box,color=blue];
		2226 -> 2228;
	2227 [label="Così come siamo - così come sono - con tutto ciò che mi hai portato, tutto ciò che rappresentiamo... sono contento. Anzi, sono... felice. Per la prima volta da molto, molto tempo.",shape=box,color=blue];
		2227 -> 2229;
	2228 [label="Ma in questo caso, sono contento così come siamo. No anzi, sono... felice. Per la prima volta da molto, molto tempo.",shape=box,color=blue];
		2228 -> 2229;
	2229 [label="E devo ringraziare te per questo. Per il momento, però, ti devo salutare.",shape=box,color=blue];
		2229 -> 2230;
	2230 [label="- Lyon",shape=box,color=blue];
		2230 -> 1193;
	1193 [label="Update boolean LyonConsentComplete",color=orange];
		1193 -> 1187;
