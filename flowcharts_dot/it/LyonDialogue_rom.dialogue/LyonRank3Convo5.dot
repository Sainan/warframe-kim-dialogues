digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank3Convo5 begins." [color=orange];
		"LyonRank3Convo5 begins." -> j2981729420;
	j2981729420 [label="La notte in cui il 'Cardinal Dimanche' venne da noi, c'era un forte temporale. Era in piedi nel presbiterio della chiesa, indenne dalla burrasca che infuriava fuori.",shape=box,color=blue];
		j2981729420 -> j3588907544;
	j3588907544 [label="Questo sarebbe dovuto essere il mio primo motivo di preoccupazione. Invece, chinai il capo e lo salutai come avrei fatto con qualsiasi nuovo inviato dalla Santa Madre.",shape=box,color=blue];
		j3588907544 -> j2995181601;
	j2995181601 [label="Dopotutto, aspettavamo un nuovo Cardinale, dato che il precedente era dipartito diversi mesi prima per malattia.",shape=box,color=blue];
		j2995181601 -> j2361923914;
	j2361923914 [label="Dimanche mi accolte con un caloroso sorriso e una stretta di mano decisa. Gli chiesi se il suo viaggio fosse stato lungo. Non dimenticherò mai la sua risposta.",shape=box,color=blue];
		j2361923914 -> j2466587878;
	j2466587878 [label="'È stato difficile... ma non è stato lungo.'",shape=box,color=blue];
		j2466587878 -> j4290282172;
	j4290282172 [label="All'epoca mi lascio perplesso, così come il fatto che il suo cappotto fosse completamente asciutto. Ma non ci feci caso, come tutti sono soliti fare quando ci si trova di fronte all'insolito.",shape=box,color=blue];
		j4290282172 -> j3650125353;
	j3650125353 [label="E non ebbi tempo di pensarci, perché Marie con la sua impazienza, arrivò un attimo dopo.",shape=box,color=blue];
		j3650125353 -> j3004855546;
	j3004855546 [label="Si inginocchiò per salutarla, e prese le sue mani. Avrei dovuto capire la manipolazione per quello che era.",shape=box,color=blue];
		j3004855546 -> j2220858941;
	j2220858941 [label="Dopotutto, non è stato l'unico diavolo ad arrivare alla nostra porta durante una tempesta.",shape=box,color=blue];
		j2220858941 -> j1928339452;
	j1928339452 [label="Boolean LyonEntrati1 is now true.",color=orange];
		j1928339452 -> j2100050873;
	j2100050873 [label="Check boolean MarieEntrati1",color=orange];
		j2100050873 -> j158983761 [label=true,color=green];
		j2100050873 -> j1574798329 [label=true,color=green];
		j2100050873 -> j3660650813 [label=true,color=green];
		j2100050873 -> j1087486324 [label=false,color=brown];
		j2100050873 -> j158983761 [label=false,color=brown];
	j158983761 [label="L'altro diavolo è Roathe?",shape=box,color=red];
		j158983761 -> j51959331;
	j1574798329 [label="Lei racconta questa storia in modo molto diverso.",shape=box,color=red];
		j1574798329 -> j1629789438;
	j3660650813 [label="Lei crede ancora nelle sue buone intenzioni. E tu?",shape=box,color=red];
		j3660650813 -> j3927433780;
	j1087486324 [label="Immagino che tu non sia un alleato di Entrati?",shape=box,color=red];
		j1087486324 -> j572228663;
	j51959331 [label="Sì. Ma questa è una storia per un altro giorno. Se comincio a parlare di lui, il mio umore già pessimo diventerà... ",shape=box,color=blue];
		j51959331 -> j1291062848;
	j1629789438 [label="Sì. È vero.",shape=box,color=blue];
		j1629789438 -> j2891245410;
		j1629789438 -> j2076912218;
	j3927433780 [label="+5 Chemistry",color=orange];
		j3927433780 -> j1079580635;
	j572228663 [label="Dopo aver sopportato le sue bugie e il suo tradimento, e mentre continuiamo a subire la sua manipolazione su Marie, vorresti che lo fossi? No, assolutamente non lo sono.",shape=box,color=blue];
		j572228663 -> j2754335906;
	j1291062848 [label="...insostenibile. Preferirei di gran lunga concentrare il mio attuale stato d'animo sulle malefatte di Entrati, se per te è lo stesso.",shape=box,color=blue];
		j1291062848 -> j1428371468;
	j2891245410 [label="Mi dice che a volte vedi cose che gli altri non vedono.",shape=box,color=red];
		j2891245410 -> j3737881281;
	j2076912218 [label="E? ",shape=box,color=red];
		j2076912218 -> j2846458768;
	j1079580635 [label="Marie crede nel meglio di ogni anima. È un'abilità che ha affinato e perfezionato come scudo contro il mondo che la circonda.",shape=box,color=blue];
		j1079580635 -> j2319910230;
		j1079580635 -> j3574837810;
	j2754335906 [label="+5 Chemistry",color=orange];
		j2754335906 -> j247391922;
	j1428371468 [label="Check boolean RoatheSerum1",color=orange];
		j1428371468 -> j3463706723 [label=true,color=green];
		j1428371468 -> j3114038814 [label=true,color=green];
		j1428371468 -> j3463706723 [label=false,color=brown];
		j1428371468 -> j890607004 [label=false,color=brown];
	j3737881281 [label="E cosa penseresti di questa affermazione, Drifter, se fosse vera?",shape=box,color=blue];
		j3737881281 -> j2821822155;
	j2846458768 [label="'E', niente. Ti ho raccondato di aver assistito all'evento, la verità della mia esperienza. Nient'altro.",shape=box,color=blue];
		j2846458768 -> j1079580635;
	j2319910230 [label="Marie non conosce tutti i fatti su ciò di cui Entrati è realmente capace e su tutte le cose orribili che ha fatto in nome del 'progresso' e ora della 'redenzione'.",shape=box,color=red];
		j2319910230 -> j3730526723;
	j3574837810 [label="Marie è una donna adulta. Ammiro il tuo desiderio di proteggerla, ma lei può decidere autonomamente in cosa credere e in chi riporre la propria fiducia.",shape=box,color=red];
		j3574837810 -> j1588642982;
	j247391922 [label="Contaminare i nostri corpi, distruggere i nostri futuri, corrompere il nostro passato - tutto questo, forse, potrei perdonarlo.",shape=box,color=blue];
		j247391922 -> j3699934834;
	j3463706723 [label="Entrati potrebbe non avere le maniere migliori, ma sta cercando di salvare l'universo.",shape=box,color=red];
		j3463706723 -> j247391922;
	j3114038814 [label="Ti a costretto a diventare un protoframe, come Roathe?",shape=box,color=red];
		j3114038814 -> j646480463;
	j890607004 [label="Certo. Perché sei arrabbiato con Entrati?",shape=box,color=red];
		j890607004 -> j2754335906;
	j2821822155 [label="Check boolean LyonVisions1",color=orange];
		j2821822155 -> j2558409073 [label=true,color=green];
		j2821822155 -> j2984168484 [label=true,color=green];
		j2821822155 -> j1109537565 [label=true,color=green];
		j2821822155 -> j2558409073 [label=false,color=brown];
		j2821822155 -> j3066720760 [label=false,color=brown];
		j2821822155 -> j2984168484 [label=false,color=brown];
	j3730526723 [label="La fiducia è come una vetrata. Delicata nella sua creazione. Bellissima nel suo splendore. Tragica nella sua rottura. E pericolosa una volta distrutta.",shape=box,color=blue];
		j3730526723 -> j496696310;
	j1588642982 [label="La fiducia è come una vetrata. Delicata nella sua creazione. Bellissima nel suo splendore. Tragica nella sua rottura. E pericolosa una volta distrutta.",shape=box,color=blue];
		j1588642982 -> j1896554461;
	j3699934834 [label="Ma vedere come ha distorto Marie... ha usato la sua fede nella bontà degli altri per i propri fini?",shape=box,color=blue];
		j3699934834 -> j3437134851;
	j646480463 [label="No. Avevo le mie ragioni per accettare l'elisir. Sapevo in che creatura contorta mi avrebbe trasformato. E anche Marie.",shape=box,color=blue];
		j646480463 -> j1634140430;
	j2558409073 [label="Immagino che non mi importi particolarmente in entrambi i casi?",shape=box,color=red];
		j2558409073 -> j1954076778;
	j2984168484 [label="La mia unica domanda è, se vedi delle cose, le tue visioni ti danno fastidio?",shape=box,color=red];
		j2984168484 -> j1809933902;
	j1109537565 [label="Quello che hai detto l'altro giorno - mi ha fatto domandare se stessi bene, tutto qui.",shape=box,color=red];
		j1109537565 -> j4232588723;
	j3066720760 [label="Mi chiedevo solo se stai bene, tutto qui.",shape=box,color=red];
		j3066720760 -> j4232588723;
	j496696310 [label="+15 Chemistry",color=orange];
		j496696310 -> j1113710256;
	j1896554461 [label="Nella calda luce di Sol, si crogiola nella sua luce, incapace di vedere le faglie che si formano sulla sua superficie. Incapace di sentire le crepe che si fanno più profonde.",shape=box,color=blue];
		j1896554461 -> j4257063312;
	j3437134851 [label="Questo, non lo perdonerò mai. Questo, lo desidero estrirpare dalla sua carne con il mio turibolo, finché non implorerà salvezza.",shape=box,color=blue];
		j3437134851 -> j2319910230;
		j3437134851 -> j3574837810;
	j1634140430 [label="Non siamo stati... spezzati con la forza, come il diavolo. Una parte del mio cuore è vicina a Roathe per quello che ha dovuto sopportare.",shape=box,color=blue];
		j1634140430 -> j1122622267;
	j1954076778 [label="Allora non vedo la necessità di continuare questa conversazione.",shape=box,color=blue];
		j1954076778 -> "Chat ends.";
	j1809933902 [label="Sarò molto schietto nel dire che non so come rispondere a questa domanda, Drifter.",shape=box,color=blue];
		j1809933902 -> j584910953;
	j4232588723 [label="Boolean LyonAllRight is now true.",color=orange];
		j4232588723 -> j1103209120;
	j1113710256 [label="Vorrei poterle togliere la corruzione che lui ha seminato nella sua mente. Posso solo pregare che tu possa riuscire laddove io ho fallito.",shape=box,color=blue];
		j1113710256 -> j2895678923;
	j4257063312 [label="Ignara del fatto che frammenti del suo capolavoro si sarebbero presto ritorti contro di lei, decidendo di ignorare ciò che inevitabilmente sarebbe seguito.",shape=box,color=blue];
		j4257063312 -> j2448169117;
	j1122622267 [label="Poi apre la bocca per parlare.",shape=box,color=blue];
		j1122622267 -> j3431474017;
		j1122622267 -> j1365719004;
	"Chat ends." [color=orange];
	j584910953 [label="In tutti questi anni ho visto orrori tali da mandare altri in manicomio. Ancora più tragicamente, di tanto in tanto, le mie visioni diventavano realtà.",shape=box,color=blue];
		j584910953 -> j1145287069;
	j1103209120 [label="Se 'stessi bene'? Sarò molto schietto nel dire che non so come rispondere a questa domanda, Drifter.",shape=box,color=blue];
		j1103209120 -> j584910953;
	j2895678923 [label="-P. Lyon Allard",shape=box,color=blue];
		j2895678923 -> "Chat ends.";
	j2448169117 [label="Magari potessi sopportare quella sofferenza al posto suo, la tatuerei volentieri nella mia anima. Ma questo è per lei, e solo per lei.",shape=box,color=blue];
		j2448169117 -> j1473271694;
	j3431474017 [label="Bisogna ricordare come è stato cresciuto. L'ambiente in cui ha dovuto imparare a sopravvivere. Era - è - un Orokin.",shape=box,color=red];
		j3431474017 -> j2781009586;
		j3431474017 -> j142110247;
	j1365719004 [label="Sinceramente non credo che sia poi così terribile. Comincia a piacermi sempre di più.",shape=box,color=red];
		j1365719004 -> j600202711;
	j1145287069 [label="Boolean LyonVisions1 is now true.",color=orange];
		j1145287069 -> j1483969270;
	j1473271694 [label="Quindi cercherò di prevenire questo dolore, Drifter. ",shape=box,color=blue];
		j1473271694 -> j4219997064;
	j2781009586 [label="Non significa che sia giusto, ma potrebbe aiutarti a imparare ad andargli incontro.",shape=box,color=red];
		j2781009586 -> j3651605087;
	j142110247 [label="Sta facendo ciò che ritiene di dover fare.",shape=box,color=red];
		j142110247 -> j4048615008;
	j600202711 [label="Chiederei a M. Loid per una pomata per quel malanno. Per timore che si diffonda.",shape=box,color=blue];
		j600202711 -> j356968837;
		j600202711 -> j491896186;
	j1483969270 [label="Boolean LyonBackstory1 is now true.",color=orange];
		j1483969270 -> j331431370;
	j4219997064 [label="E se vedessi in quell'atto un tentativo di rimpicciolimento?",shape=box,color=blue];
		j4219997064 -> j564307128;
	j3651605087 [label="Add 1 to Thermostat counter",color=orange];
		j3651605087 -> j3961045242;
	j4048615008 [label="Add -1 to Thermostat counter",color=orange];
		j4048615008 -> j3530152396;
	j356968837 [label="Il diavolo ha sempre un certo fascino.",shape=box,color=red];
		j356968837 -> j2320672897;
	j491896186 [label="Non preoccuparti, non mi lascerò sedurre dal suo fascino.",shape=box,color=red];
		j491896186 -> j2497214999;
	j331431370 [label="E in quanto tali, le consideravo la guida di Lua, come se fossi stato scelto dai Luminari per portare un tale fardello. O almeno così credevo all'epoca. Questo è il motivo per cui ho cercato di entrare nel sacerdozio.",shape=box,color=blue];
		j331431370 -> j3584660830;
		j331431370 -> j1971895032;
		j331431370 -> j347888346;
	j564307128 [label="Che Lua abbia pietà della tua anima.",shape=box,color=blue];
		j564307128 -> j2895678923;
	j3961045242 [label="Nelle nostre scritture, non si negozia con i demoni - si scacciano. Ma non ci hanno preparato a questa particolare condizione.",shape=box,color=blue];
		j3961045242 -> j1135529811;
	j3530152396 [label="Forse. Non sono ancora certo che nel cuore di quella creatura non ci siano dubbi.",shape=box,color=blue];
		j3530152396 -> j1135529811;
	j2320672897 [label="Add -1 to Thermostat counter",color=orange];
		j2320672897 -> j908711997;
	j2497214999 [label="Add 1 to Thermostat counter",color=orange];
		j2497214999 -> j1868312658;
	j3584660830 [label="Credevi che le visioni provenissero da Lua? Non ci credi più?",shape=box,color=red];
		j3584660830 -> j1213681597;
	j1971895032 [label="Che tipo di orrori...?",shape=box,color=red];
		j1971895032 -> j2747679256;
	j347888346 [label="E cosa ne pensi ora?",shape=box,color=red];
		j347888346 -> j3827605602;
	j1135529811 [label="Vedremo a tempo debito quale strada sceglierà di percorrere quel particolare diavolo, no?",shape=box,color=blue];
		j1135529811 -> j4051809483;
	j908711997 [label="Ed è questo che mi turba. Il diavolo sorride e dice cose sensate, mentre tutti gli altri sputano follia. ",shape=box,color=blue];
		j908711997 -> j4021649163;
	j1868312658 [label="+20 Chemistry",color=orange];
		j1868312658 -> j1672213156;
	j1213681597 [label="Che credo sia diventato... complicato, ultimamente, con l'introduzione di nuova informazione.",shape=box,color=blue];
		j1213681597 -> j3827605602;
	j2747679256 [label="Abbiamo appena iniziato a parlare di queste cose, Drifter. Non che io non creda che tu abbia visto, in prima persona, sofferenze della peggior specie, né che tu abbia bisogno di protezione da qualsiasi descrizione meschina io riesca a evocare.",shape=box,color=blue];
		j2747679256 -> j3067729624;
	j3827605602 [label="In parole povere, Drifter, sarei onesto se dicessi che non so a cosa credere.",shape=box,color=blue];
		j3827605602 -> j4161552065;
	j4051809483 [label="-P. Lyon Allard",shape=box,color=blue];
		j4051809483 -> j367054140;
	j4021649163 [label="Ci coglie nel momento più inspettato - quando siamo vulnerabili. Quando siamo deboli. Quando abbiamo bisogno di risposte.",shape=box,color=blue];
		j4021649163 -> j1718132224;
		j4021649163 -> j3332354063;
	j1672213156 [label="Bene. Fai in modo di non esserlo. Mi dispiacerebbe doverti far ragionare con la forza. Sembri il tipo che risponde al fuoco.",shape=box,color=blue];
		j1672213156 -> j1842474220;
	j3067729624 [label="Mi sfinisce semplicemente parlare di queste cose con qualcuno che ho appena incontrato, perché poi non si avvicini più a me. Preferirei che ciò non accadesse in una situazione in cui sembriamo costretti a collaborare, almeno per il momento.",shape=box,color=blue];
		j3067729624 -> j913972702;
		j3067729624 -> j3347519909;
	j4161552065 [label="Boolean LyonFaith1 is now true.",color=orange];
		j4161552065 -> j87745813;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
	j1718132224 [label="So cavarmela da solo. Prometto che non gli permetterò di entrare nella mia testa.",shape=box,color=red];
		j1718132224 -> j732945947;
	j3332354063 [label="Sembra che tu stia parlando per esperienza. Che risposte ti ha dato?",shape=box,color=red];
		j3332354063 -> j4015324992;
	j1842474220 [label="E allora in quale strano stato ci troveremo?",shape=box,color=blue];
		j1842474220 -> "Chat ends.";
	j913972702 [label="Se preferisci aspettare finché avrai più fiducia in me, capisco.",shape=box,color=red];
		j913972702 -> j4229258436;
	j3347519909 [label="Non vado da nessuna parte, Lyon. Puoi fidarti di me.",shape=box,color=red];
		j3347519909 -> j176295588;
	j87745813 [label="Ma temo che questo sia un argomento che approfondiremo un altro giorno.",shape=box,color=blue];
		j87745813 -> j596161727;
	j732945947 [label="+20 Chemistry",color=orange];
		j732945947 -> j1184932973;
	j4015324992 [label="Quelle che temo abbiano... messo in dubbio moltissime cose. Ma temo che questo sia un argomento, che affronteremo un'altra volta.",shape=box,color=blue];
		j4015324992 -> j1803692453;
	j4229258436 [label="+20 Chemistry",color=orange];
		j4229258436 -> j3814307947;
	j176295588 [label="+15 Chemistry",color=orange];
		j176295588 -> j3369849793;
	j596161727 [label="+20 Chemistry",color=orange];
		j596161727 -> j1686083929;
	j1184932973 [label="Bene. Fai attenzione. Mi dispiacerebbe doverti far ragionare con la forza. Sembri il tipo che risponde al fuoco.",shape=box,color=blue];
		j1184932973 -> j1842474220;
	j1803692453 [label="Boolean LyonFaith1 is now true.",color=orange];
		j1803692453 -> j596161727;
	j3814307947 [label="Grazie. Non è che non creda che tu sia sincero in quello che scrivi. È solo che la mia esperienza mi ha insegnato il contrario.",shape=box,color=blue];
		j3814307947 -> j1686083929;
	j3369849793 [label="Non è che non creda che tu sia sincero in quello che scrivi. È solo che la mia esperienza mi ha insegnato il contrario. ",shape=box,color=blue];
		j3369849793 -> j1686083929;
	j1686083929 [label="Nel frattempo dovrò implorare il tuo perdono e la tua pazienza. ",shape=box,color=blue];
		j1686083929 -> j2895678923;
}