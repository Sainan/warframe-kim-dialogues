		1718 -> 1720 [label="false",color=purple];
	1719 [label="Mi dispiace tanto per quello che avete dovuto passare entrambi.",shape=box,color=red];
		1719 -> 1725;
	1724 [label="Sono solo... così felice che Rell e Harrow siano potuti essere lì con te, Lyon... anche se solo nei ricordi.",shape=box,color=red];
		1724 -> 1728;
	1723 [label="Potresti considerare la possibilità che... forse è tutta opera di un dio o di più dei? Per confortarti?",shape=box,color=red];
		1723 -> 1727;
	1722 [label="Potresti considerare la possibilità che... forse è tutta opera di Lua? Per confortarti?",shape=box,color=red];
		1722 -> 1727;
	1721 [label="Non lo so, perché le due cose devono escludersi a vicenda, ma... non lo so. Non lo so perché non lo sapremo mai.",shape=box,color=red];
		1721 -> 1726;
	1720 [label="Sono solo... così felice che Rell e Harrow siano potuti essere lì con te, Lyon... anche se solo nei ricordi.",shape=box,color=red];
		1720 -> 1725;
	1725 [label="Grazie. Mi manca la loro presenza. Ma... sto imparando che in questo posto ci sono più persone che potrebbero comprendere il mio dolore piuttosto che il contrario.",shape=box,color=blue];
		1725 -> 1729;
	1728 [label="Grazie. Mi manca la loro presenza. Ma... non sono più solo, vero, mon miracle?",shape=box,color=blue];
		1728 -> 1729;
	1727 [label="Sì. Non pensare che non ci abbia pensato. Non so se la mia fede guarirà così facilmente, ma... è comunque confortante rifletterci.",shape=box,color=blue];
		1727 -> 1729;
	1726 [label="In effetti. Non pensare che non abbia considerato se Rell e Harrow siano stati mandati dai Luminari per confortarmi. Ma come hai detto, non spetta a noi saperlo.",shape=box,color=blue];
		1726 -> 1729;
	1729 [label="+20 Chemistry",color=orange];
		1729 -> 1730;
	1730 [label="Sono davvero sollevato di aver finalmente parlato di tutto questo con te. È un peso enorme, che mi è stato tolto di dosso, e non posso esprimere abbastanza la mia gratitudine.",shape=box,color=blue];
