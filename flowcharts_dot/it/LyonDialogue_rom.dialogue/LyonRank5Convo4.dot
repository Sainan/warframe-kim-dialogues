		1629 -> 1633;
	1630 [label="[Avviso: Brevi accenni ad autolesionismo e abusi sui minori. Clicca qui per terminare. Non verrà persa Chimica con Lyon.]",shape=box,color=red];
		1630 -> 1634;
	1627 [label="[Fine.]",shape=box,color=red];
		1627 -> 1631;
	2350 [label="Update boolean LyonWillDate",color=orange];
		2350 -> 2351;
	1632 [label="Suppongo di sì. Anche se credo di avere anni di esperienza in questo senso e, pertanto, gli avvertimenti di Entrati hanno reso la cosa molto più impressionante di quanto non fosse in realtà.",shape=box,color=blue];
		1632 -> 1633;
	1633 [label="Marie e io decidemmo di prendere i nostri sieri in privato. Le chiesi di lasciarmi andare per primo, di sperimentare il cambiamento e poi di aiutarla a superare il suo, ma lei, ovviamente, rifiutò categoricamente.",shape=box,color=blue];
		1633 -> 1636;
	1634 [label="+20 Chemistry",color=orange];
