		1675 -> 1678 [label="DrifterFaithNoMaybe",color=purple];
		1675 -> 1676 [label="false",color=purple];
	1681 [label="Oh, Lyon... hai sofferto così tanto. Il dubbio non è frutto di debolezza - è frutto del dolore.",shape=box,color=red];
		1681 -> 1683;
		1681 -> 1684;
		1681 -> 1685;
		1681 -> 1686;
		1681 -> 1687;
	1682 [label="La fede non deve essere costante - né ci si aspetta che lo sia. Quante storie si raccontano di persone che perdono la fede, solo per poi ritrovarla?",shape=box,color=red];
		1682 -> 1683;
		1682 -> 1684;
		1682 -> 1685;
	1680 [label="Hai dedicato la tua vita ai nostri Luminari, Lyon. Pensi che ti volterebbero le spalle per una cosa del genere?",shape=box,color=red];
		1680 -> 1683;
		1680 -> 1684;
		1680 -> 1685;
	1679 [label="Non so se gli dei esistano o no, Lyon - non credo che potremo mai saperlo veramente. Ma quello che so è che hai passato momenti difficili.",shape=box,color=red];
		1679 -> 1683;
		1679 -> 1685;
		1679 -> 1686;
	1678 [label="Anche se personalmente non credo che ci siano dei in questo mondo, so quanto questo sia stato importante per te nella tua vita. Non voglio sminuirlo.",shape=box,color=red];
		1678 -> 1685;
		1678 -> 1687;
	1677 [label="L'Indifferenza è stata creata da noi - non è una divinità, Lyon. Non lasciare che l'errore di Entrati ti distrugga. E la tua fede?",shape=box,color=red];
		1677 -> 1685;
		1677 -> 1687;
	1676 [label="Odio vederti così, intrappolato nel mezzo delle sciocchezze di tutti. Non te lo meriti.",shape=box,color=red];
		1676 -> 1683;
		1676 -> 1684;
		1676 -> 1685;
		1676 -> 1686;
		1676 -> 1687;
	1683 [label="Non sto dicendo che devi ritrovare la fede. Sto dicendo che se lo vuoi - se senti di doverlo fare - non è qualcosa che si perde per sempre.",shape=box,color=red];
		1683 -> 1688;
	1684 [label="Di sicuro, Lua può vedere cosa hai dovuto passare. Cosa hai sopportato in suo nome. ",shape=box,color=red];
		1684 -> 1689;
	1685 [label="Penso che ciò su cui dovresti concentrarti sia trovare una sorta di pace dentro di te - qualunque sia il modo in cui devi trovarla.",shape=box,color=red];
		1685 -> 1690;
	1686 [label="Se esiste un dio, se Lua esiste davvero - sicuramente può vedere cosa hai passato. Cosa hai sopportato in suo nome. Deve significare qualcosa per lei.",shape=box,color=red];
		1686 -> 1691;
	1687 [label="Penso che dovresti abbandonare qualsiasi idea sull'esistenza o meno degli dei e concentrarti prima di tutto sulla guarigione di te stesso.",shape=box,color=red];
		1687 -> 1692;
	1688 [label="Update boolean LyonFaith3Maybe",color=orange];
		1688 -> 1693;
	1689 [label="Update boolean LyonFaith3Yes",color=orange];
		1689 -> 1693;
	1690 [label="Update boolean LyonFaith3Maybe",color=orange];
		1690 -> 1693;
	1691 [label="Update boolean LyonFaith3Yes",color=orange];
		1691 -> 1693;
	1692 [label="Update boolean LyonFaith3No",color=orange];
		1692 -> 1693;
	1693 [label="Forse hai ragione... E la mia triste storia di dubbi non era certo il punto. Ma rifletterò sulle tue parole. Ne parleremo più approfonditamente domani.",shape=box,color=blue];
		1693 -> 1694;
	1694 [label="Ho visto la vita di Rell a bordo della Zariman Ten Zero, e tutto ciò che ha dovuto sopportare dopo. Ho visto la vita di Harrow da soldato, sbiadire nell'Infestazione. Proprio come loro hanno visto la mia vita in Gaule e tutto ciò che ho sofferto.",shape=box,color=blue];
		1694 -> 1695;
	1695 [label="Forse ti sembrerà strano sapere che nessuno di noi ha mai scambiato una sola parola. Non ne abbiamo mai sentito il bisogno. C'era semplicemente tra noi una... comprensione.",shape=box,color=blue];
		1695 -> 1696;
		1695 -> 1697;
	1696 [label="Davvero? Mai?",shape=box,color=red];
		1696 -> 1698;
	1697 [label="Si... lo vedo.",shape=box,color=red];
		1697 -> 1699;
	1698 [label="Potevo sentire le loro voci - conoscevo tutte le parole che avevano pronunciato nella loro vita. Ma non erano mai rivolte a me.",shape=box,color=blue];
		1698 -> 1699;
	1699 [label="Un sorriso ha bisogno di un discordo? Un'espressione accigliata? Hai bisogno di sentire un bambino piangere per sapere che sta soffrendo o è spaventato? No, sapevamo solo cosa c'era tra noi.",shape=box,color=blue];
		1699 -> 1700;
	1700 [label="Finché... finché tutto finì.",shape=box,color=blue];
		1700 -> 1701;
	1701 [label="Check boolean LyonDating",color=orange];
		1701 -> 1703 [label=true,color=green];
		1701 -> 1702 [label=false,color=brown];
	1703 [label="Non se ne sono andati, mon miracle... sono solo morti.",shape=box,color=blue];
		1703 -> 1704;
	1702 [label="Non se ne sono andati, amico mio... sono solo morti.",shape=box,color=blue];
		1702 -> 1704;
	1704 [label="Non riesco più a sentire quelle parti che erano indeterminate. Ora, credo, di riuscire a sentire solo quella parte che lo era.",shape=box,color=blue];
		1704 -> 1705;
		1704 -> 1706;
	1705 [label="Aspetta, determinate?",shape=box,color=red];
		1705 -> 1707;
	1706 [label="Quando hai... smesso di sentirlo?",shape=box,color=red];
		1706 -> 1708;
	1707 [label="Non posso spiegarlo meglio di quanto non abbia già fatto. Non so come. Perdonami.",shape=box,color=blue];
		1707 -> 1708;
	1708 [label="Nel momento in cui abbiamo attraversato l'Helminth con Roathe e siamo arrivati qui, al Sanctum. Non so... perché. O come.",shape=box,color=blue];
		1708 -> 1709;
	1709 [label="Ma attraversando quel velo di tempo, i miei amici, i miei fratelli.. gli alberi le cui radici si intrecciavano così strettamente con la mia anima... appassirono e morirono accanto a me.",shape=box,color=blue];
		1709 -> 1710;
	1710 [label="Ora c'è un vuoto. In putrefazione. Il ricordo di loro che ancora corrompono il mio. Ma non lo abbandonerei nemmeno se ne avessi la possibilità...",shape=box,color=blue];
		1710 -> 1711;
		1710 -> 1712;
	1711 [label="Oh?",shape=box,color=red];
		1711 -> 1713;
	1712 [label="Perché no?",shape=box,color=red];
		1712 -> 1713;
	1713 [label="Ricordo la prima volta che mia madre mi picchiò. Lo ricordo in due versioni, chiare come la luce più intensa di Sol, e so che entrambe sono vere.",shape=box,color=blue];
		1713 -> 1714;
	1714 [label="In una... piango da solo nell'oscurità della mia stanza. Nell'altra, due figure sono in piedi accanto a me nell'ombra.",shape=box,color=blue];
		1714 -> 1715;
	1715 [label="Ricordo due versioni della prima volta che mi sono tagliato la pelle con una lama per liberarmi delle voci nella mia mente. In una, la stanza era vuota.",shape=box,color=blue];
		1715 -> 1716;
	1716 [label="In un'altra, sento un ronzio alle mie spalle. Avverto la presenza silenziosa di un guardiano stoico.",shape=box,color=blue];
		1716 -> 1717;
	1717 [label="Se ho perso la fede nella mia dea Lua e in cambio ho ottenuto la sua guida... potrebbe essere uno scambio che sarei disposto a fare.",shape=box,color=blue];
		1717 -> 1718;
