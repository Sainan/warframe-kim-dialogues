	1631 [label="Update boolean LyonConfessionFail",color=orange];
		1631 -> 1635;
	2351 [label="Chat ends. Next chat will be Lyon5FaithDay2.",color=orange];
	1636 [label="Scherniva al solo pensiero che sarei andato da qualche parte o avrei fatto qualsiasi cosa senza averla saldamente al mio finaco e si diresse verso le sue stanze.",shape=box,color=blue];
		1636 -> 1638;
	1637 [label="Update boolean LyonFamilySuccess",color=orange];
		1637 -> 1639;
	1635 [label="Chat ends.",color=orange];
	1638 [label="Chiusi la mia porta a chiave, mi spogliai e mi sedetti sul pavimento in mezzo alla stanza, il più lontano possibile da qualsiasi oggetto, prima di conficcarmi l'ago nel fianco.",shape=box,color=blue];
		1638 -> 1640;
	1639 [label="Update boolean LyonRell3",color=orange];
		1639 -> 1641;
	1640 [label="Avevo visto cosa l'Infestazione aveva fatto a Roathe, torcendogli la carne con qualsiasi cosa indossasse in quel momento - non avevo alcun desiderio di cadere vittima della stessa sorte.",shape=box,color=blue];
		1640 -> 1642;
	1641 [label="Update boolean LyonFaith3Unknown",color=orange];
		1641 -> 1643;
	1642 [label="Quando l'agonia finì, la mia vista, già sofferente era... offuscata. In qualche modo... doppia. Come se potessi vedere non una, ma due volte.",shape=box,color=blue];
		1642 -> 1644;
	1643 [label="Chat ends. Next chat will be Lyon5FaithDay2.",color=orange];
	1644 [label="Sono piuttosto orgoglioso della mia resilienza, ma sono riuscii a indossare i pantaloni prima di vomitare e perdere i sensi.",shape=box,color=blue];
		1644 -> 1645;
	1645 [label="Quando mi svegliai, non ero solo. E non ero nemmeno sul pavimento della mia stanza. Ero seduto nella mia camera d'infanzia, sui vecchi pavimenti scricchiolanti che conoscevo così bene.",shape=box,color=blue];
		1645 -> 1646;
	1646 [label="E seduto accanto a me c'era un giovane. Accanto a lui c'era una figura che ora conosco come Harrow. Il giovane teneva tra le mani una piccola statuetta di legno. Era snodata agli arti, con la vernice ormai consumata da tempo, tranne forse nelle pieghe e nelle crepe. Era appartenuta a mio padre. Rappresentava un soldato.",shape=box,color=blue];
		1646 -> 1647;
	1647 [label="Da bambino era l'unico giocattolo che potevo considerare solo mio.",shape=box,color=blue];
		1647 -> 1648;
		1647 -> 1649;
	1648 [label="Da bambino avevo una statuetta simile. Era uno dei miei giocattoli preferiti.",shape=box,color=red];
		1648 -> 1650;
	1649 [label="Rell?",shape=box,color=red];
		1649 -> 1651;
	1650 [label="Così ho sentito dire. Credo che alla fine la mia si sia rivelata più benevola.",shape=box,color=blue];
		1650 -> 1652;
		1650 -> 1653;
		1650 -> 1654;
	1651 [label="Esatto.",shape=box,color=blue];
		1651 -> 1655;
	1652 [label="Thrax è un argomento complicato. Preferisco non addentrarmici.",shape=box,color=red];
		1652 -> 1656;
	1653 [label="In realtà non era colpa sua. Era semplicemente la persona di cui avevo bisogno in quel momento.",shape=box,color=red];
		1653 -> 1657;
	1654 [label="Tutto bene. Sta progredendo. Lentamente. In qualche modo. Anche ciò che sembra impossibile può cambiare.",shape=box,color=red];
		1654 -> 1658;
	1655 [label="Il giovane e il suo silenzioso guardiano che mi hanno fatto visita nel mio sogno - nella mia mente - mi sono apparsi all'improvviso come degli estranei e tuttavia li conoscevo, come se fossimo cresciuti insieme come fratelli.",shape=box,color=blue];
		1655 -> 1659;
	1656 [label="Esatto. Potremmo perderci qui per ore, a discutere delle implicazioni morali e teologiche di Duviri.",shape=box,color=blue];
		1656 -> 1655;
	1657 [label="Quando penso anche solo alla più piccola idea di cosa avrei potuto immaginare al tuo posto, vengo sopraffatto da ondate di orrore. Ma potremmo perderci qui per ore, a discutere di una cosa del genere.",shape=box,color=blue];
		1657 -> 1655;
	1658 [label="Se mostra segni di cambiamenti, ed è frutto delle tue emozioni, forse è indicativo di qualcos'altro. Ma forse ne parleremo un altro giorno.",shape=box,color=blue];
		1658 -> 1655;
	1659 [label="Perdonami per la metafora forzata, ma era come se fossimo tre alberi le cui radici erano cresciute così intrecciate da diventare indistinguibili l'uno dall'altro -",shape=box,color=blue];
		1659 -> 1660;
	1660 [label="che sono stati semplicemente catapultati all'esistenza in quello stato. Ricordavo la mia vita senza Rell e Harrow. Eppure, eccoli lì. In ogni momento - in ogni circostanza - accanto a me.",shape=box,color=blue];
		1660 -> 1661;
	1661 [label="A parte questo, vorrei aver avuto la possibilità di parlare con Entrati di questo, per sapere che tipo di scienza c'era - senza giochi di parole - alla radice di tutto questo, ma quando finalmente ci siamo ripresi dal nostro cambiamento, Entrati non c'era più.",shape=box,color=blue];
		1661 -> 1662;
	1662 [label="Check boolean LoidFamilyComplete",color=orange];
		1662 -> 1664 [label=true,color=green];
		1662 -> 1663 [label=false,color=brown];
		1662 -> 1664 [label=false,color=brown];
	1664 [label="Quel poco che so dell'Infestazione e di come funziona, sembra essere tipo... non saprei... fuori dal tempo?",shape=box,color=red];
		1664 -> 1666;
	1663 [label="La figlia di Entrati è di sopra. Ha studiato e lavorato accanto a lui. Potrebbe essere in grado di aiutare.",shape=box,color=red];
		1663 -> 1665;
	1666 [label="C'è una... chitarra... è tutto molto difficile da spiegare, ed entrambi abbiamo viaggiato nel tempo tramite Helminth...",shape=box,color=red];
		1666 -> 1668;
	1665 [label="Update boolean LyonFamilySuccess",color=orange];
		1665 -> 1667;
	1668 [label="Un processo che credo rimarrà nei miei incubi per molto tempo. Comunque, i dettagli di come io, Rell e Harrow abbiamo stretto un legame così... molecolare, spirituale, non li conosco.",shape=box,color=blue];
		1668 -> 1670;
	1667 [label="Add 1 to Family",color=orange];
		1667 -> 1669;
	1670 [label="Ma il bivio era in entrambe le direzioni. Dove loro erano nella mia vita, io ero nella loro. Ho visto l'Indifferenza. Ho capito da cosa ci stavamo difendendo. Ho intravisto Harrow e l'uomo che era stato un tempo.",shape=box,color=blue];
		1670 -> 1672;
	1669 [label="Ora, se solo ci fosse permesso di parlarle. Sospetto che ci siano già dei piani in tal caso. Se così fosse, puoi contare sul mio... aiuto. So essere convincente quando necessario.",shape=box,color=blue];
		1669 -> 1671;
	1672 [label="Ma la pressione dell'Indifferenza prese il sopravvento. Potevo sentirla lì - sentirla mentre picchiettava contro i muri. Rap... tap... tap...",shape=box,color=blue];
		1672 -> 1673;
	1671 [label="Comunque, i dettagli di come io, Rell e Harrow abbiamo stretto un legame così... molecolare, spirituale, non li conosco.",shape=box,color=blue];
		1671 -> 1670;
	1673 [label="Tutte le visioni della mia giovinezza, tutti gli orrori che avevo visto - erano forse l'Indifferenza? Stavo forse ricordando male? o ero davvero 'benedetto' da Lua?",shape=box,color=blue];
		1673 -> 1674;
	1674 [label="La mia fede... si accartocciò e dissolse. Nient'altro che carta carbonizzata, trasformata in polvere. E oh, quanto mi detesto per la mia debolezza...",shape=box,color=blue];
		1674 -> 1675;
