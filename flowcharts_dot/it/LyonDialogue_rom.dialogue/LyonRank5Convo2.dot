		1486 -> 1491 [label="LyonBackstory3a",color=purple];
		1486 -> 1490 [label="LyonBackstory3b",color=purple];
		1486 -> 1489 [label="LyonBackstory2",color=purple];
		1486 -> 1489 [label="LyonBackstory1",color=purple];
		1486 -> 1488 [label="false",color=purple];
	1487 [label="+20 Chemistry",color=orange];
		1487 -> 490;
	1491 [label="Amico mio, sei stato paziente e più gentile di quanto avresti dovuto essere. So che ti sei chiesto cosa pensassi di questa parte della mia storia, della notte in cui Lua era al suo apice di oscurità.",shape=box,color=blue];
		1491 -> 1493;
	1490 [label="Amico mio, sei stato paziente con me. So che ti sei chiesto cosa pensassi di questa parte della mia storia, della notte in cui Lua era al suo apice di oscurità.",shape=box,color=blue];
		1490 -> 1493;
	1489 [label="Amico mio, ti sei chiesto del mio passato. E so che devi esserti chiesto di questa parte della mia storia - della notte in cui Lua era al suo apice di oscurità.",shape=box,color=blue];
		1489 -> 1493;
	1488 [label="Amico mio, so che ti sarai chiesto qualcosa dopo aver letto la mia storia e quella della notte in cui Lua era al suo apice di oscurità.",shape=box,color=blue];
		1488 -> 1493;
	490 [label="[Conversazione saltata a causa della precedente impostazione dell'avviso di contenuto.]",shape=box,color=blue];
		490 -> 1492;
	1493 [label="È una storia che ho giurato di non raccontare mai. Solo Marie la conosce, perché l'ha letta nei miei diari. E ora, te la racconterò.",shape=box,color=blue];
		1493 -> 1495;
	1492 [label="Update boolean LyonConfession1",color=orange];
		1492 -> 1494;
	1495 [label="Una volta iniziata, non posso fermarmi, perché non potrò più ricominciare. Quindi mi perdonerai se non ti permetterò di farmi domande.",shape=box,color=blue];
		1495 -> 1499;
		1495 -> 1498;
		1495 -> 1497;
		1495 -> 1496;
	1494 [label="Chat ends.",color=orange];
	1499 [label="Certamente.",shape=box,color=red];
		1499 -> 1503;
	1498 [label="[Lascialo continuare.]",shape=box,color=red];
		1498 -> 1502;
	1497 [label="[Avviso: Discussione su autolesionismo e abusi sui minori. Clicca qui per terminare. Non verrà persa Chimica con Lyon.]",shape=box,color=red];
		1497 -> 1501;
	1496 [label="[Fine.]",shape=box,color=red];
		1496 -> 1500;
	1503 [label="Grazie.",shape=box,color=blue];
		1503 -> 1507;
	1502 [label="+5 Chemistry",color=orange];
		1502 -> 1503;
	1501 [label="Check boolean LyonSpeech",color=orange];
		1501 -> 1505 [label=true,color=green];
		1501 -> 1506 [label=false,color=brown];
	1500 [label="Update boolean LyonConfessionFail",color=orange];
		1500 -> 1504;
	1507 [label="Evaluate expressions",color=orange];
		1507 -> 1511 [label="LyonBackstory3a",color=purple];
		1507 -> 1511 [label="LyonBackstory3b",color=purple];
		1507 -> 1510 [label="false",color=purple];
	1505 [label="+20 Chemistry",color=orange];
		1505 -> 1508;
	1506 [label="Se dovessi considerarti un codardo per questa scelta - non farlo. Perché questo è un dolore che non ti spetta. È mio. Non hai chiesto tu di sopportare questo momento.",shape=box,color=blue];
		1506 -> 1509;
	1504 [label="Chat ends.",color=orange];
	1511 [label="Abbiamo parlato della mia famiglia. Del tempo trascorso nella fattoria dove sono cresciuto. Delle visioni che mi hanno tormentato e spinto alla violenza.",shape=box,color=blue];
		1511 -> 1515;
	1510 [label="So che non ti ho raccontato molto di coloro che mi hanno cresciuto. E temo che ci sia una buona ragione.",shape=box,color=blue];
		1510 -> 1514;
	1508 [label="Update boolean LyonConfession1",color=orange];
		1508 -> 1512;
	1509 [label="Questo marchingegno meccanico su cui siamo seduti crea un'impressione di velata impersonalità. Come se fossimo in qualche modo protetti da qualsiasi danno un altro potrebbe causarci attraverso le parole che ci digita.",shape=box,color=blue];
		1509 -> 1513;
	1515 [label="Ti ho raccontato delle voci che sentivo, che mi sussurravano, che mi chiamavano da altre stanze. A volte sembrava che chiamassero il mio nome -",shape=box,color=blue];
		1515 -> 1518;
	1514 [label="Mia madre... considerava le mie visioni opera del diavolo. E cercava di scacciarle con una frusta. Spesso, finché non riuscivo più a stare in piedi.",shape=box,color=blue];
		1514 -> 1517;
	1512 [label="Chat ends.",color=orange];
	1513 [label="Io sostengo invece il contrario - che liberi dall'armatrua che indossiamo nelle nostre interazioni sociali più banali, siamo privati di ciò che potrebbe proteggerci.",shape=box,color=blue];
		1513 -> 1516;
	1518 [label="Altre volte, sembravano non avere alcun significato. Un'assurdità confusa, o il linguaggio dei diavoli.",shape=box,color=blue];
		1518 -> 1521;
	1517 [label="E mio padre? Beh. Nonostante tutta la crudeltà di mia madre, mio padre era peggio. Ti risprarmio i dettagli.",shape=box,color=blue];
		1517 -> 1520;
	1516 [label="Pertanto, in situazioni come queste... sono ben consapevole che scoccherei una freccia che potrebbe colpire non il soldato pronto alla battaglia, ma la giugulare ignara di un cervo nel bosco.",shape=box,color=blue];
		1516 -> 1519;
	1521 [label="All'inizio, il delirio insensato di quelle parole mi terrorizzò. Implorai di capire. Pregai Lua affinché i suoi spiriti mi dicessero cosa desideravano da me.",shape=box,color=blue];
		1521 -> 1524;
	1520 [label="Ma la loro violenza non era eguagliata dalla mia. Le mie visioni mi rendevano spesso difficile da gestire - soprattutto quando sono diventato più grande, alto e forte di mio padre.",shape=box,color=blue];
		1520 -> 1523;
	1519 [label="Quindi ti lascio con questo:",shape=box,color=blue];
		1519 -> 1522;
	1524 [label="Ma quando ho iniziato a capire il loro desiderio - mi sono pentito di ciò per cui avevo pregato così disperatamente. Perché ora sapevo quali azioni mi chiedevano di compiere in loro nome.",shape=box,color=blue];
		1524 -> 1526;
	1523 [label="E queste visioni spesso assumevano la forma di voci. A volte sembrava che chiamassero il mio nome -",shape=box,color=blue];
		1523 -> 1518;
	1522 [label="Dobbiamo ricordarci come trovare la forza per rimetterne in piedi un altro, anche quando non riusciamo a trovare la volontà di restare in piedi.",shape=box,color=blue];
		1522 -> 1525;
	1526 [label="E oh, che prezzo orribile avrebbero pagato.",shape=box,color=blue];
		1526 -> 1528;
	1525 [label="Questo è il vero scopo della storia.",shape=box,color=blue];
		1525 -> 1527;
	1528 [label="Non fraintendermi. Non provavo alcun affetto né per mio padre né per mia madre. Qualunque lealtà familiare potessi provare per loro si era ormai esaurita sotto una litania di lividi e cicatrici.",shape=box,color=blue];
		1528 -> 1530;
	1527 [label="+20 Chemistry",color=orange];
		1527 -> 1529;
	1530 [label="Ma cosa mi hanno chiesto di fare per loro...? E cosa mi hanno costretto a fare, in quella notte buia...?",shape=box,color=blue];
		1530 -> 1532;
	1529 [label="Prenditi cura di te, Drifter. Ci risentiamo presto.",shape=box,color=blue];
		1529 -> 1531;
	1532 [label="Ero poco più di un ragazzo - non veramente un uomo. Forse avevo sedici anni? Diciotto? All'inizio, pensai che fosse tutto un altro terribile incubo - un sogno contorto.",shape=box,color=blue];
		1532 -> 1534;
	1531 [label="-P. Lyon Allard",shape=box,color=blue];
		1531 -> 1533;
	1534 [label="Intorno a me c'erano delle figure, manifestazioni scarne e contorte, fatte puramente di malizia e ombra.",shape=box,color=blue];
		1534 -> 1536;
	1533 [label="Update boolean LyonConfession1",color=orange];
		1533 -> 1535;
	1536 [label="Mi prendono in giro, mi chiedono di fare ciò che deve essere fatto - che se coloro che affermano di amarmi vogliono avere la mia carne... allora io, a mia volta, devo avere la loro...",shape=box,color=blue];
		1536 -> 1537;
	1535 [label="Chat ends.",color=orange];
	1537 [label="Quando mi svegliai dall'incubo - o forse ero sempre stato sveglio, non lo so con certezza - avevo un coltello da caccia in mano. E mi trovavo sulla porta della stanza dei miei genitori.",shape=box,color=blue];
		1537 -> 1538;
	1538 [label="La luna era nuova. E le nuvole erano fitte. Non c'era la minima luce per vedere. L'oscurità era assoluta. ",shape=box,color=blue];
		1538 -> 1539;
	1539 [label="Lua mi ha abbandonato.",shape=box,color=blue];
		1539 -> 1540;
	1540 [label="Non potevo rispondere alla chiamata delle voci. Non potevo dare loro le anime di mia madre e di mio padre.",shape=box,color=blue];
		1540 -> 1541;
	1541 [label="Fuggii nella notte vuota. Nel profondo dei boschi, i rami mi laceravano la pelle nuda, anche se non avrei potuto sopportare di meno il dolore.",shape=box,color=blue];
		1541 -> 1542;
	1542 [label="Corsi finché le gambe non mi cedettero, incapace di proseguire. Forse stavo piangendo, non lo so.",shape=box,color=blue];
		1542 -> 1543;
	1543 [label="Ma le manifestazioni erano arrivate. E ancora sussurravano per il sangue.",shape=box,color=blue];
		1543 -> 1544;
	1544 [label="Speravo che non li avesse visti, sarebbero potuti andare via... quando mi sono conficcato quel coltelo nell'orbita dell'occhio...",shape=box,color=blue];
		1544 -> 1545;
	1545 [label="Peccato che sia svenuto e non abbia potuto completare il mio compito. Ora, non lo saprò mai.",shape=box,color=blue];
		1545 -> 1546;
	1546 [label="Quando mi sono svegliato, mi trovavo nella parrocchia locale di Lua. Un Fratello mi aveva trovato e mi aveva fasciato le ferite. Mi aveva chiesto da cosa stessi scappando.",shape=box,color=blue];
		1546 -> 1547;
	1547 [label="Ero sopraffatto. Non potevo mentirgli. Confessai tutto - le visioni, quello che mi avevano detto di fare. Mi aspettavo una condanna.",shape=box,color=blue];
		1547 -> 1548;
	1548 [label="Quando finì di raccontare, lui sorrise semplicemente con una consapevole tristezza e mi mise un amuleto di Lua nel palmo della mano. \"È una benedizione e una maledizione, figlio mio.\"",shape=box,color=blue];
		1548 -> 1549;
	1549 [label="Mi mandò alla Cattedrale nella Cité de la Lumière. E lì rimasi finché Entrati non mi trovò...",shape=box,color=blue];
		1549 -> 1550;
	1550 [label="Ecco... adesso ce l'hai.",shape=box,color=blue];
		1550 -> 1551;
	1551 [label="E... ora devo andare.",shape=box,color=blue];
		1551 -> 1552;
	1552 [label="Update boolean LyonConfession1",color=orange];
		1552 -> 1553;
	1553 [label="+20 Chemistry",color=orange];
		1553 -> 1554;
	1554 [label="- Lyon",shape=box,color=blue];
		1554 -> 1555;
	1555 [label="Chat ends.",color=orange];
}