	j410090499 [label="Evaluate expressions",color=orange];
		j410090499 -> j2849564453 [label="LyonDating",color=purple];
		j410090499 -> j3600847815 [label="LyonConvession1",color=purple];
		j410090499 -> j3600847815 [label="LyonRell2a",color=purple];
		j410090499 -> j3600847815 [label="LyonRell2b",color=purple];
		j410090499 -> j3600847815 [label="LyonRell1",color=purple];
		j410090499 -> "Chat ends." [label="false",color=purple];
	j2849564453 [label="Non ne vado fiero, ma ho bevuto un'intera bottiglia di vino e ora sono pronto a raccontarti tutto quello che ho disperatamente cercato di non dirti, mon miracle...",shape=box,color=blue];
		j2849564453 -> j3092971799;
	j3600847815 [label="Non ne vado fiero, ma ho bevuto un'intera bottiglia di vino e ora sono pronto a raccontarti tutto quello che ho disperatamente cercato di non dirti...",shape=box,color=blue];
		j3600847815 -> j3092971799;
	"Chat ends." [color=orange];
	j3092971799 [label="Se questa bottiglia è, veramente, vino, dato che non era etichettata con precisione - e M. Loid non è del tutto sicuro che ciò che avevamo ai miei tempi e ciò che lui conosce come vino siano la stessa cosa.",shape=box,color=blue];
		j3092971799 -> j755289189;
	j755289189 [label="A mia discolpa, non avevo intenzione di bere l'intera bottiglia... ma stavo cercando di capire se si trattasse effettivamente della stessa sostanza, e, beh, poi è sparita...",shape=box,color=blue];
		j755289189 -> j3923360647;
		j755289189 -> j4277279542;
		j755289189 -> j4052740090;
	j3923360647 [label="No. No grazie.",shape=box,color=red];
		j3923360647 -> j1789392357;
	j4277279542 [label="Ha lo stesso sapore?",shape=box,color=red];
		j4277279542 -> j2033935304;
	j4052740090 [label="Sei ubriaco?",shape=box,color=red];
		j4052740090 -> j142589331;
	j1789392357 [label="Vorrei tanto poter scappare così facilmente. Non ti biasimo.",shape=box,color=blue];
		j1789392357 -> j3856020424;
	j2033935304 [label="Non lo so! Quella è stata la parte più frustrante di tutta la faccenda! Ma non è questo il punto. Il punto era ubriacarsi. E non so nemmeno se lo sono. Di certo non sono sobrio, comunque -",shape=box,color=blue];
		j2033935304 -> j859817619;
	j142589331 [label="Potenzialmente. Di certo non sono quello che considererebbero sobrio, in nessun modo.",shape=box,color=blue];
		j142589331 -> j2185186830;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j859817619 [label="Quindi suppongo che questo dovrà bastare.",shape=box,color=blue];
		j859817619 -> j3673684970;
		j859817619 -> j3493050661;
	j2185186830 [label="Che era esattamente lo scopo di tutta questa impresa. Quindi suppongo che dovrà bastare.",shape=box,color=blue];
		j2185186830 -> j3673684970;
		j2185186830 -> j3493050661;
	j3673684970 [label="Cos'è così terribile che devi ubriacarti per raccontarmelo?",shape=box,color=red];
		j3673684970 -> j3375269506;
	j3493050661 [label="Pronto quando lo sei tu...",shape=box,color=red];
		j3493050661 -> j3375269506;
	j3375269506 [label="Rap... tap... tap...",shape=box,color=blue];
		j3375269506 -> j2311984237;
		j3375269506 -> j3091773728;
	j2311984237 [label="... Oh.",shape=box,color=red];
		j2311984237 -> j3370702357;
	j3091773728 [label="Quello basta.",shape=box,color=red];
		j3091773728 -> j3370702357;
	j3370702357 [label="So per certo che non sono mai stati lì nella mia mente. Il Tenno noto come Rell e il suo guardiano Harrow. Non è possibile che fossero tra le mura della mia casa d'infanzia.",shape=box,color=blue];
		j3370702357 -> j597804691;
	j597804691 [label="Non è possibile che abbiano riecheggiato nella mia mente con le voci sussurrate e confuse delle mie visioni per tutti questi anni. Eppure li vedo lì, li sento lì, nei miei ricordi.",shape=box,color=blue];
		j597804691 -> j252073137;
	j252073137 [label="Check boolean LyonTime1",color=orange];
		j252073137 -> j373666917 [label=true,color=green];
		j252073137 -> j1679475832 [label=false,color=brown];
	j373666917 [label="Capii tutto ciò che Entrati aveva detto su come l'energia potesse esistere nel tempo in più luoghi contemporaneamente, in senso filosofico. Ma non lo compresi emotivamente finché non... mi iniettai il siero.",shape=box,color=blue];
		j373666917 -> j392600078;
	j1679475832 [label="È come se nel momento in cui mi sono iniettato il siero - tutte le cose sono diventate una cosa sola. Quando Entrati rivelò se stesso, e tutta la verità della sua esistenza - ",shape=box,color=blue];
		j1679475832 -> j1468497267;
	j392600078 [label="A volte vedo nella mia mente un grande lago poco profondo immobile che si estende in tutte le direzioni. Nero e calmo, come uno specchio di onice.",shape=box,color=blue];
		j392600078 -> j1372258238;
	j1468497267 [label="Mi spiegò tutto ciò che sapeva sul 'groviglio quantistico', 'sovrapposizione', 'eternalismo' e simili.",shape=box,color=blue];
		j1468497267 -> j1953535541;
	j1372258238 [label="Un grande lago nero che si estende all'infinito. Impossibile da comprendere.",shape=box,color=blue];
		j1372258238 -> j1498666993;
	j1953535541 [label="Ho capito tutto in senso scientifico, piuttosto che filosofico. Ma non l'ho capito emotivamente finché... non mi sono iniettato il siero.",shape=box,color=blue];
		j1953535541 -> j392600078;
	j1498666993 [label="Ed è lì che li avrei trovati. È lì che ci saremmo incontrati. Ed è lì che avrei anche sentito la loro presenza...",shape=box,color=blue];
		j1498666993 -> j3040418948;
	j3040418948 [label="Loro?",shape=box,color=red];
		j3040418948 -> j3272546708;
	j3272546708 [label="Gli altri Harrow... Statue vuote, echi di echi di echi... Si estendono all'infinito, in tutte le direzioni...",shape=box,color=blue];
		j3272546708 -> j798002054;
	j798002054 [label="Rell entrò in una delle tante. Si perse. E così facendo, si perse dentro tutte...",shape=box,color=blue];
		j798002054 -> j2830747923;
	j2830747923 [label="Incluso me. Incluso l'Harrow che era nel siero che mi ha creato.",shape=box,color=blue];
		j2830747923 -> j2918076562;
		j2830747923 -> j1120829426;
	j2918076562 [label="Void, non ci avevo neanche pensato...",shape=box,color=red];
		j2918076562 -> j484666895;
	j1120829426 [label="Oh no -",shape=box,color=red];
		j1120829426 -> j484666895;
	j484666895 [label="Erano lì con me, nella mia mente - Rell e il suo Harrow, così simili a me, eppure così diversi.",shape=box,color=blue];
		j484666895 -> j1135094672;
	j1135094672 [label="Lui non aveva paura. Era così sicuro. Due cose che non mi rappresentavano assolutamente.",shape=box,color=blue];
		j1135094672 -> j375538849;
	j375538849 [label="Si oppose fermamente all'Indifferenza, senza curarsi di cosa fosse e non fosse. Sapeva semplicemente cosa bisognava fare.",shape=box,color=blue];
		j375538849 -> j3392916531;
	j3392916531 [label="Anche dopo tutte le crudeltà che ha sofferto. Per tutti quegli anni, nell''adesso' e nell''ora' di quell'eternità, nel momento in cui mi sono iniettato il siero... nel 'prima' e nel 'dopo', lui era lì.",shape=box,color=blue];
		j3392916531 -> j2206809568;
	j2206809568 [label="Era mio amico. Era mio fratello.",shape=box,color=blue];
		j2206809568 -> j826364324;
	j826364324 [label="Allora? Nel presente?",shape=box,color=blue];
		j826364324 -> j1427015617;
	j1427015617 [label="Non riesco più a percepirlo.",shape=box,color=blue];
		j1427015617 -> j1951508999;
		j1427015617 -> j2569418441;
	j1951508999 [label="Lui.. riposa ora, Lyon... è in pace.",shape=box,color=red];
		j1951508999 -> j1381238340;
	j2569418441 [label="Oh, Lyon...",shape=box,color=red];
		j2569418441 -> j310763511;
	j1381238340 [label="Lo so. Ho sentito quando se n'è andato. E ho pianto. Mi manca tantissimo. Sento ancora la sua presenza - in qualche modo, anche se non capisco bene come.",shape=box,color=blue];
		j1381238340 -> j3531332398;
		j1381238340 -> j2575641018;
	j310763511 [label="Mi manca tantissimo. Sento ancora la sua presenza - in qualche modo, anche se non capisco bene come.",shape=box,color=blue];
		j310763511 -> j3531332398;
		j310763511 -> j2575641018;
	j3531332398 [label="Rell era il più forte di tutti noi. Sono felice che tu abbia avuto la possibilità di conoscerlo.",shape=box,color=red];
		j3531332398 -> j3442577138;
	j2575641018 [label="Rell è stato emarginato a causa dell'ignoranza e della crudeltà dei ragazzini... non meritava quello che gli è successo.",shape=box,color=red];
		j2575641018 -> j2753180933;
	j3442577138 [label="Sono felice di averlo conosciuto anch'io. Quanto alla sua forza? Forse sì, forse no. Alla fine, sapeva semplicemente cosa bisognava fare ed era abbastanza forte da farlo.",shape=box,color=blue];
		j3442577138 -> j3644361660;
	j2753180933 [label="Forse, ma alla fine, ha fatto ciò che era necessario. Ed è stato abbastanza forte da farlo.",shape=box,color=blue];
		j2753180933 -> j3644361660;
	j3644361660 [label="In momenti come questi, credo che 'forte abbastanza' sia tutto quello in cui possiamo sperare.",shape=box,color=blue];
		j3644361660 -> j2423624700;
	j2423624700 [label="Purtroppo, non si può dire lo stesso di questo vino... che era molto forte, ma lento a fare effetto.",shape=box,color=blue];
		j2423624700 -> j701989247;
	j701989247 [label="Dovrei andare prima ",shape=box,color=blue];
		j701989247 -> j4275297888;
	j4275297888 [label="Dovrei andare.",shape=box,color=blue];
		j4275297888 -> j111445917;
