		1059 -> 1062 [label=false,color=brown];
	1060 [label="Apprezzo il sentimento, ma non posso nemmeno minimizzare quanto fosse difficile avere a che fare con un bambino come me, soprattutto quando sono diventato più alto e più forte di loro.",shape=box,color=blue];
		1060 -> 1059;
	1061 [label="Update boolean LyonLecture2",color=orange];
		1061 -> 1049;
	1063 [label="Le mie visioni e le voci mi facevano spesso venire attacchi di violenza, Drifter. Torturami era spesso l'unico modo per risvegliarmi da ciò che vedevo.",shape=box,color=blue];
		1063 -> 1064;
	1062 [label="Le mie visioni e le voci mi facevano spesso venire attacchi di violenza, Drifter. Spesso prendevo un coltello per tagliarmi la carne, perché il dolore era l'unica cosa che mi risvegliava.",shape=box,color=blue];
		1062 -> 1064;
	1064 [label="Ma è stato quando le voci mi hanno ordinato di",shape=box,color=blue];
		1064 -> 1065;
	1065 [label="No... non ce la faccio. Semplicemente non ce la faccio. Perdonami. Mi tremano perfino le mani mentre scrivo. Devo fermarmi per ora.",shape=box,color=blue];
		1065 -> 1066;
		1065 -> 1067;
