		1043 -> 1046 [label=false,color=brown];
	1044 [label="Mia madre era morta da tempo quando siamo partiti per venire qui. E ora non è altro che polvere. Ha vissuto una vita di miseria... e miseria che era destinata a diffondere.",shape=box,color=blue];
		1044 -> 1047;
	1046 [label="Fare del male a un bambino... è imperdonabile.",shape=box,color=red];
		1046 -> 1042;
	1045 [label="È per questo che tu...?",shape=box,color=red];
		1045 -> 1048;
	1047 [label="Era spaventata. Qualunque cosa mi affliggesse, che fosse un peso degli dei, la follia - una maledizione - lei non era in grado di gestirla.",shape=box,color=blue];
		1047 -> 1049;
	1048 [label="Check boolean LyonLecture2",color=orange];
		1048 -> 1050 [label=true,color=green];
		1048 -> 1051 [label=false,color=brown];
	1049 [label="Comunque, per quanto crudele fosse mia madre? Mio padre era peggio. Ti risparmio i dettagli.",shape=box,color=blue];
		1049 -> 1052;
	1050 [label="Forse. Mi sono spesso chiesto se non facesse parte della compulsione. Ma come ti ho già detto, è anche un metodo di Lua.",shape=box,color=blue];
		1050 -> 1053;
	1051 [label="Forse. Mi sono spesso chiesto se non facesse parte della compulsione. Ma è un metodo di Lua, dei Luminari. Non sono il solo a praticarlo.",shape=box,color=blue];
		1051 -> 1054;
	1052 [label="Crescendo, le visioni si trasformano in voci. Sussurri che mi giungevano a tutte le ore. Da sveglio e in sogno. Il mio lavoro nella fattoria ne risentiva, e io ne soffriro a mia volta.",shape=box,color=blue];
