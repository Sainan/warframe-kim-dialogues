		1056 -> 1060;
	2233 [label="Ti assicuro che questo mi porta un po' di pace, anche se so che ti sembrerà strano.",shape=box,color=blue];
		2233 -> 1049;
	1058 [label="Me l'ha insegnato uno degli altri Padri della Cattedrale, per aiutarmi... a schiarirmi le idee. Coloro che vengono scelti da Lua sono spesso 'benedetti' dalle 'visioni'.",shape=box,color=blue];
