	j1985349979 [label="+20 Chemistry",color=orange];
		j1985349979 -> j2262526582;
	j1803674963 [label="Lyon, stavo parlando con Marie delle tue... abitudini e mi chiedevo se potessimo parlare?",shape=box,color=red];
		j1803674963 -> j660496129;
	j3091636711 [label="[Disattiva le conversazioni sull'autolesionismo. Questo non comporterà alcuna perdita di chimica con Lyon o con qualsiasi altro personaggio.]",shape=box,color=red];
		j3091636711 -> j1471969450;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j2897639553 [label="Lyon? Possiamo parlare di qualcosa che potrebbe metterti un po' a... disagio?",shape=box,color=red];
		j2897639553 -> j3434383727;
	j1163219991 [label="Lyon, mi chiedevo se potessi parlarti del motivo per cui ti sei - um... beh, fatto del male, se per te va bene?",shape=box,color=red];
		j1163219991 -> j3606633363;
	j2262526582 [label="[Conversazione saltata a causa della precedente impostazione dell'avviso di contenuto.]",shape=box,color=blue];
		j2262526582 -> "Chat ends.";
	j660496129 [label="Mi ha avvisato che avevate parlato - sì, certo. Potresti sorprenderti di quanto poco mi metta a disagio parlare di questo mio particolare tratto.",shape=box,color=blue];
		j660496129 -> j3855438292;
	j1471969450 [label="Boolean LyonPainOff is now true.",color=orange];
		j1471969450 -> j411815059;
	"Chat ends." [color=orange];
	j3434383727 [label="Puoi chiedere, ma mi riservo il diritto di non proseguire oltre nella conversazione se ritengo che si stia sconfinando in un argomento di discussione a cui non sono più disposto a partecipare. ",shape=box,color=blue];
		j3434383727 -> j216643661;
	j3606633363 [label="Mm. Sono sicneramente sorpreso che tu abbia impiegato così tanto tempo per informarti su questa mia particolare caratteristica. Di solito è quella su cui la maggior parte delle persone trova motivo di soffermarsi più facilmente.",shape=box,color=blue];
		j3606633363 -> j3408473949;
	j3855438292 [label="Di solito è ciò su cui la maggior parte delle persone trova più facilmente motivo di fare osservazioni, per preoccupazione, disgusto o per morbosa curiosità.",shape=box,color=blue];
		j3855438292 -> j897187574;
	j411815059 [label="Se dovessi considerarti un codardo per questa scelta - non farlo. Perché questo è un dolore che non ti spetta. È mio. Non hai chiesto tu di sopportare questo momento.",shape=box,color=blue];
		j411815059 -> j4075454862;
	j216643661 [label="Riguarda il fatto che a volte ti fai male. Volevo stare attento a come affrontavo l'argomento con te, tutto qui.",shape=box,color=red];
		j216643661 -> j3026815421;
	j3408473949 [label="Che sia per motivi di preoccupazione, di disgusto o per la morbosa curiosità che potrebbe spingere qualcuno a sbirciare attraverso le sbarre della gabbia di un pazzo, mi chiedo, tu cosa sei?",shape=box,color=blue];
		j3408473949 -> j962579268;
		j3408473949 -> j3415044490;
		j3408473949 -> j1099745562;
		j3408473949 -> j1299364578;
	j897187574 [label="Evaluate expressions",color=orange];
		j897187574 -> j962579268 [label="LyonBackstory3a",color=purple];
		j897187574 -> j1776974166 [label="LyonBackstory3a",color=purple];
		j897187574 -> j962579268 [label="LyonBackstory3b",color=purple];
		j897187574 -> j1776974166 [label="LyonBackstory3b",color=purple];
		j897187574 -> j962579268 [label="DrifterHarmHelp",color=purple];
		j897187574 -> j1099745562 [label="DrifterHarmHelp",color=purple];
		j897187574 -> j962579268 [label="DrifterHarmStop",color=purple];
		j897187574 -> j1299364578 [label="DrifterHarmStop",color=purple];
		j897187574 -> j962579268 [label="DrifterHarmLoss",color=purple];
		j897187574 -> j3415044490 [label="DrifterHarmLoss",color=purple];
		j897187574 -> j962579268 [label="false",color=purple];
	j4075454862 [label="Questo marchingegno meccanico su cui siamo seduti crea un'impressione di velata impersonalità. Come se fossimo in qualche modo protetti da qualsiasi danno un altro potrebbe causarci attraverso le parole che ci digita.",shape=box,color=blue];
		j4075454862 -> j3628821513;
	j3026815421 [label="+5 Chemistry",color=orange];
		j3026815421 -> j3811389503;
	j962579268 [label="Mi dispiace, ma a pensarci bene non ce la faccio. [Fine.]",shape=box,color=red];
		j962579268 -> j411815059;
	j3415044490 [label="[Attenzione: Discussione sul suicidio.] Una... volta ho perso qualcuno a causa di questo tipo di \"abitudine\" e io...",shape=box,color=red];
		j3415044490 -> j2503068483;
	j1099745562 [label="Voglio solo aiutarti. Per assicurarmi che tu stia bene. Tutto qui.",shape=box,color=red];
		j1099745562 -> j4278740242;
	j1299364578 [label="Ho la sensazione che tutto questo non sia salutare - che sia qualcosa che dovrebbe finire. ",shape=box,color=red];
		j1299364578 -> j2122671310;
	j1776974166 [label="So che hai detto che ti facevi del male prima del siero, ma... non riesco a immaginare che la situazione sia migliorata.",shape=box,color=red];
		j1776974166 -> j3474814721;
	j3628821513 [label="Io sostengo invece il contrario - che liberi dall'armatrua che indossiamo nelle nostre interazioni sociali più banali, siamo privati di ciò che potrebbe proteggerci.",shape=box,color=blue];
		j3628821513 -> j4270438972;
	j3811389503 [label="Apprezzo... la delicatezza con cui stai trattando la questione, Drifter. Grazie. Ma sono piuttosto abituato a questo argomento di discussione. Che sia per preoccupazione, disgusto o morbosa curiosità, anche se credo che tu abbia già dimostrato che si tratta della prima.",shape=box,color=blue];
		j3811389503 -> j962579268;
		j3811389503 -> j3415044490;
		j3811389503 -> j1099745562;
		j3811389503 -> j1299364578;
	j2503068483 [label="Boolean DrifterHarmLoss is now true.",color=orange];
		j2503068483 -> j4048854793;
	j4278740242 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j4278740242 -> j4131174356;
	j2122671310 [label="Boolean DrifterHarmStop is now true.",color=orange];
		j2122671310 -> j416894644;
	j3474814721 [label="No, temo di no. Ho preso qualcosa ce non era... un requisito per liberare la mia mente dalle visioni che mi tormentavano, e l'ha trasformato in un requisito per esercitare i \"doni\" di questo siero.",shape=box,color=blue];
		j3474814721 -> j1070110401;
	j4270438972 [label="Pertanto, in situazioni come queste... sono ben consapevole che scoccherei una freccia che potrebbe colpire non il soldato pronto alla battaglia, ma la giugulare ignara di un cervo nel bosco.",shape=box,color=blue];
		j4270438972 -> j1145358934;
	j4048854793 [label="Oh, amico mio... non ci sono parole che possano esprimere adeguatamente la mia compassione per ciò che hai sopportato.",shape=box,color=blue];
		j4048854793 -> j866562916;
	j4131174356 [label="Check boolean LyonAllRight",color=orange];
		j4131174356 -> j2062387627 [label=true,color=green];
		j4131174356 -> j3076286064 [label=false,color=brown];
	j416894644 [label="Credo che tu sia arrivato con diversi anni e un siero protoframe troppo tardi per porre fine a questa mia particolare compulsione - in effetti, temo che ora sia più un'azione necessaria, non è vero?",shape=box,color=blue];
		j416894644 -> j1962279002;
	j1070110401 [label="+5 Chemistry",color=orange];
		j1070110401 -> j274806983;
	j1145358934 [label="Quindi ti lascio con questo:",shape=box,color=blue];
		j1145358934 -> j1769814684;
	j866562916 [label="In momenti come questi, il linguaggio sembra insignificante. Ci sforziamo di usarlo al meglio delle nostre possibilità, eppure sembra sempre deluderci.",shape=box,color=blue];
		j866562916 -> j3650617569;
	j2062387627 [label="Cerco, ancora una volta, di non ridere all'idea di avvicinarmi al concetto di \"bene\". Ma apprezzo molto il tuo sentimento, Drifter.",shape=box,color=blue];
		j2062387627 -> j833720367;
	j3076286064 [label="Cerco di non ridere all'idea di avvicinarmi al concetto di \"bene\". Ma apprezzo molto il tuo sentimento, Drifter.",shape=box,color=blue];
		j3076286064 -> j833720367;
	j1962279002 [label="+5 Chemistry",color=orange];
		j1962279002 -> j1151716848;
	j274806983 [label="Se le capacità di curare la mia compulsione a farmi del male era alla mia portata prima di iniettarmi il siero, credo che unirmi al Warframe \"Harrow\" ora l'abbia resa del tutto impossibile.",shape=box,color=blue];
		j274806983 -> j903036069;
	j1769814684 [label="Dobbiamo ricordarci come trovare la forza per rimetterne in piedi un altro, anche quando non riusciamo a trovare la volontà di restare in piedi.",shape=box,color=blue];
		j1769814684 -> j84630032;
	j3650617569 [label="Ci sono tre cose che potrei fare, se mi permetti, alla luce della tua confessione.",shape=box,color=blue];
		j3650617569 -> j3468353364;
	j833720367 [label="+5 Chemistry",color=orange];
		j833720367 -> j3490774979;
		j833720367 -> j2429345928;
	j1151716848 [label="Ma non intendo essere così superficiale su quella che credo sia un'espressione di preoccupazione per il mio benessere fisico e mentale, perdonami. Semplicemente non credo che sia nelle mie possibilità smettere.",shape=box,color=blue];
		j1151716848 -> j3490774979;
		j1151716848 -> j2429345928;
	j903036069 [label="Se posso essere diretto, Drifter, non credo di essere più in grado di procurarmi un danno permanente in questo modo.",shape=box,color=blue];
		j903036069 -> j2809878698;
	j84630032 [label="Questo è il vero scopo della storia.",shape=box,color=blue];
		j84630032 -> j1606430124;
	j3468353364 [label="Innanzitutto, ti assicuro subito che non corro alcun pericolo. Se credi che sia un profondo e terribile disprezzo per me stesso a spingermi a farmi del male, vorrei dissipare questi tuoi timori.",shape=box,color=blue];
		j3468353364 -> j2662406876;
	j3490774979 [label="Posso chiederti perché lo fai?",shape=box,color=red];
		j3490774979 -> j3106172300;
	j2429345928 [label="Ho solo paura che tu possa esagerare.",shape=box,color=red];
		j2429345928 -> j903036069;
	j2809878698 [label="Sebbene io non sia capace dell'arroganza necessaria per ritenermi invulnerabile, un simile atto sembra... diaciamo... parte del progetto.",shape=box,color=blue];
		j2809878698 -> j1319576650;
	j1606430124 [label="+20 Chemistry",color=orange];
		j1606430124 -> j119050246;
	j2662406876 [label="Sebbene io... conosca quella grande malinconia, essa non ispira il mio turibolo. (Marie non lo permetterebbe mai, per esempio. Potrebbe darmelo in pasto piuttosto che lasciarmi avvicinare ancora a uno.)",shape=box,color=blue];
		j2662406876 -> j2448255915;
	j3106172300 [label="Evaluate expressions",color=orange];
		j3106172300 -> j3326181185 [label="LyonBackstory3a, LyonLecture2",color=purple];
		j3106172300 -> j3326181185 [label="LyonBackstory3b, LyonLecture2",color=purple];
		j3106172300 -> j2993282833 [label="LyonBackstory3a",color=purple];
		j3106172300 -> j2993282833 [label="LyonBackstory3b",color=purple];
		j3106172300 -> j3663002098 [label="false",color=purple];
	j1319576650 [label="+5 Chemistry",color=orange];
		j1319576650 -> j3784297376;
	j119050246 [label="Prenditi cura di te, Drifter. Ci risentiamo presto.",shape=box,color=blue];
		j119050246 -> j1765037942;
	j2448255915 [label="Ma dolori così profondi non mi hanno mai sussurrato nella notte, amico mio. Questo posso giurarti. Questo te lo prometto, su tutto ciò che mi è caro.",shape=box,color=blue];
		j2448255915 -> j1162056925;
	j3326181185 [label="Ti ho detto la verità su ciò che mi ispira ad agire - il dolore libera la mia mente dalle visioni che mi tormentano. E questa pratica non è così disprezzata tra i Fratelli di Lua come potrebbe esserlo nella vostra cultura. Posso giurare a tutto ciò che mi è caro che non c'è alcun segreto nascosto che sto nascondendo.",shape=box,color=blue];
		j3326181185 -> j1793112640;
	j2993282833 [label="È un argomento complicato, perché le ragioni per cui mi taglio la carne non sono univoche. Ti ho raccontato delle visioni che mi tormentano e del dolore che mi libera la mente. Ma l'atto in sé non è così tabù come potresti credere.",shape=box,color=blue];
		j2993282833 -> j2780924053;
	j3663002098 [label="È un argomento complicato, perché le ragioni per cui mi strappo la carne non sono univoche. Devo iniziare col dire che la questione non è poi così tabù come potrebbe sembrare al giorno d'oggi.",shape=box,color=blue];
		j3663002098 -> j2780924053;
	j3784297376 [label="Non penso che ciò che faccio sia \"giusto\". Non penso che ciò che faccio debba essere praticato da altri. Non penso che ciò che faccio sia invidiabile.",shape=box,color=blue];
		j3784297376 -> j992946241;
	j1765037942 [label="-P. Lyon Allard",shape=box,color=blue];
		j1765037942 -> j3787621160;
	j1162056925 [label="In secondo luogo, devo complimentarmi con te per il coraggio che hai dimostrato con queste parole. Sarebbe stato più facile evitarle. Non l'hai fatto.",shape=box,color=blue];
		j1162056925 -> j2406426916;
	j1793112640 [label="Se credi che sia un profondo e terribile disprezzo per me stesso a spingermi a farmi del male, vorrei dissipare questi tuoi timori.",shape=box,color=blue];
		j1793112640 -> j281697593;
	j2780924053 [label="Tra i Fratelli di Lua esiste un'antica pratica, la flagellazione. È rara, e anche ai miei tempi era considerata arcaica e utilizzata da coloro che erano \"benedetti dalle sue visioni\".",shape=box,color=blue];
		j2780924053 -> j162030016;
	j992946241 [label="Tuttavia, non è nemmeno - nel mio stato incredibilmente unico e piuttosto \"soprannaturale\" nel senso più letterale del termine - strettamente pericoloso per me.",shape=box,color=blue];
		j992946241 -> j1642072337;
	j3787621160 [label="Boolean LyonSpeech is now true.",color=orange];
		j3787621160 -> "Chat ends.";
	j2406426916 [label="Terzo; non comprendo, né comprenderò mai, il contesto di ciò che ha sofferto il tuo compagno. E, in un certo senso, nessuno tranne lui potrà mai comprenderlo.",shape=box,color=blue];
		j2406426916 -> j4012169299;
	j281697593 [label="Sebbene io... conosca quella grande malinconia, essa non ispira il mio turibolo. Marie non lo permetterebbe mai, per esempio.",shape=box,color=blue];
		j281697593 -> j1956864042;
	j162030016 [label="Me lo insegnò uno dei Padri della Cattedrale, non molto tempo dopo il mio arrivo, quando vide che anch'io ero... \"benedetto\" e ritenne opportuno aiutarmi. ",shape=box,color=blue];
		j162030016 -> j2632916461;
	j1642072337 [label="In effetti, mi sono spesso chiesto se non esistesse un miracolo della scienza moderna che potesse aiutarmi con i miei mali. Se fossi in grado di accettare un simile aiuto, lo accetterei. Dubito che la mia fisiologia, ora, me lo permetterebbe.",shape=box,color=blue];
		j1642072337 -> j145619417;
	j4012169299 [label="Soffrire in un modo così totalizzante è, per definizione, una cosa solitaria.",shape=box,color=blue];
		j4012169299 -> j1355264979;
	j1956864042 [label="Boolean LyonSNo is now true.",color=orange];
		j1956864042 -> j3056281833;
		j1956864042 -> j1658347508;
		j1956864042 -> j2670937775;
	j2632916461 [label="Boolean LyonLecture2 is now true.",color=orange];
		j2632916461 -> j2670937775;
		j2632916461 -> j1658347508;
		j2632916461 -> j3056281833;
	j145619417 [label="In ogni caso, ti assicuro che non morirò per questo. È un peso che mi porto dietro fin da bambino. Ed è un sintomo che ho deciso essere migliore della ferita purulenta sottostante, se dovessi lasciare la crosta intatta.",shape=box,color=blue];
		j145619417 -> j1511931022;
	j1355264979 [label="Prego semplicemente il mio dio, il tuo, e il loro che tu non tenga alcun senso di colpa nel tuo cuore. Perché se c'è qualcosa in questo mondo o in qualsiasi altro che possa essere perdonato, è la gentilezza di conoscere qualcuno che ha sofferto così tanto.",shape=box,color=blue];
		j1355264979 -> j99564750;
	j3056281833 [label="E sei sicuro che non... esagererai mai?",shape=box,color=red];
		j3056281833 -> j903036069;
	j1658347508 [label="Mi colpisce quanto possano essere strane, a volte, le pratiche religiose.",shape=box,color=red];
		j1658347508 -> j3093745092;
	j2670937775 [label="Immagino che questo mi faccia sentire un po' meglio.",shape=box,color=red];
		j2670937775 -> j903036069;
	j1511931022 [label="Check boolean LyonSNo",color=orange];
		j1511931022 -> j940454905 [label=true,color=green];
		j1511931022 -> j2947715773 [label=false,color=brown];
	j99564750 [label="+15 Chemistry",color=orange];
		j99564750 -> j184437327;
	j3093745092 [label="Non troverò motivo di contraddirti su questo punto. Sono affascinato dalle differenze nelle cerimonie religiose. Apprezzo molto lo studio di tutta la documentazione che le riguarda.",shape=box,color=blue];
		j3093745092 -> j1158358322;
	j940454905 [label="+10 Chemistry",color=orange];
		j940454905 -> j1891333225;
	j2947715773 [label="Se credi che sia un profondo e terribile disprezzo per me stesso a spingermi a farmi del male, vorrei dissipare questi tuoi timori.",shape=box,color=blue];
		j2947715773 -> j2885072360;
	j184437327 [label="Prenditi cura di te, Drifter. Ci risentiamo presto.",shape=box,color=blue];
		j184437327 -> j2895678923;
	j1158358322 [label="L'antropologia religiosa è una materia che mi sta molto a cuore. Si può imparare molto su una società e un popolo studiando i loro rituali. ",shape=box,color=blue];
		j1158358322 -> j2812201435;
	j1891333225 [label="Ti prometto però una cosa - se mai dovessi davvero temere che arrivi un momento in cui non potrò più fidarmi di me stesso, dirò quelle parole.",shape=box,color=blue];
		j1891333225 -> j2469821852;
	j2885072360 [label="Sebbene io... conosca quella grande malinconia, essa non ispira il mio turibolo. Marie non lo permetterebbe mai, per esempio.",shape=box,color=blue];
		j2885072360 -> j940454905;
	j2895678923 [label="-P. Lyon Allard",shape=box,color=blue];
		j2895678923 -> "Chat ends.";
	j2812201435 [label="Nell'estremo nord ghiacciato esiste una setta di Luminari che venera un cadavere rivenuto in un ghiacciaio in ritirata. Il corpo era perfettamente conservato e nessuno sa con certezza quanti anni abbia. Tuttavia, il disco di ottone che portava al collo era impresso con l'immagine di un sole.",shape=box,color=blue];
		j2812201435 -> j1592229026;
	j2469821852 [label="A Marie, a te, a M. Loid, persino a Roathe, non importerà. Sarò io a pronunciare le parole. Questo, lo giuro.",shape=box,color=blue];
		j2469821852 -> j517433559;
		j2469821852 -> j2681099671;
	j1592229026 [label="Credono che il corpo mummificato sia quello di Sol stesso. E credono che un giorno tornerà in vita e risorgerà. Ogni cento anni, si preparano per \"La Grande Vigilia\" e molti dei loro seguaci bevono vino avvelenato la notte prima.",shape=box,color=blue];
		j1592229026 -> j1718359434;
	j517433559 [label="È il massimo che potessi chiedere. Grazie, Lyon.",shape=box,color=red];
		j517433559 -> j3304712244;
	j2681099671 [label="Mi fido di te. Volevo solo affrontarlo insieme.",shape=box,color=red];
		j2681099671 -> j3304712244;
	j1718359434 [label="Inutile dire che, quando il loro corpo mummificato non è tornato al mattino, hanno un ottimo motivo per spiegare perché i loro calcoli erano sbagliati, e la data viene spostata di un altro secolo circa.",shape=box,color=blue];
		j1718359434 -> j3973031198;
	j3304712244 [label="E apprezzo profondamente il tuo desiderio di sapere che non sto agendo spinto da un irrefrenabile impulso autodistruttivo.",shape=box,color=blue];
		j3304712244 -> j24952832;
	j3973031198 [label="Ma mi sono allontanato parecchio dall'argomento in questione.",shape=box,color=blue];
		j3973031198 -> j1319576650;
	j24952832 [label="Non sono abituato ad avere compagni del genere nella mia vita.",shape=box,color=blue];
		j24952832 -> j184437327;
}