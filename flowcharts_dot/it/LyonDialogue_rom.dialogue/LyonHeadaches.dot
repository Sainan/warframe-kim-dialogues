		j2797938440 -> j153643983;
	j14118409 [label="So per esperienza personale che a volte i momenti in cui non vogliamo accettare l'aiuto degli altri sono proprio quelli in cui ne abbiamo più bisogno.",shape=box,color=red];
		j14118409 -> j2709983267;
	j2514938313 [label="Lo rispetto. Non insisterò se non ne vuoi parlare. Ma sono qui per ascoltarti se ne hai bisogno.",shape=box,color=red];
