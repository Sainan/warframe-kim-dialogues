		j3717623265 -> j3957594148;
	j401401543 [label="Boolean LyonFaithHeadache is now true.",color=orange];
		j401401543 -> j3523925928;
	j2785089448 [label="Tutto ciò che conoscevo è stato spazzato via dai luminosi raggi della 'Luce di Jade', 'dall'Impero Orokin' e dal 'Void' ed è minacciato dai 'Murmur'.",shape=box,color=blue];
		j2785089448 -> j471860463;
	j1132000502 [label="Come puoi 'vedere', mi sono ripreso completamente. E ora devi preoccuparti di te stesso. Vai a cercare un posto buio dove riprenderti.",shape=box,color=blue];
		j1132000502 -> j1559930159;
	j3957594148 [label="Posso essere schietto e chiederti perché stai cercando di socializzare con me?",shape=box,color=blue];
