	j999025097 [label="Apprezzo la tua disponibilità ad ammettere così prontamente una bugia. E apprezzo il fatto che io non sia... la creatura più affabile con cui relazionarsi.",shape=box,color=blue];
		j999025097 -> j3957594148;
