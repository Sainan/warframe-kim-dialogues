	j3671157194 [label="Sembrava insinuare che avessi delle teorie sul perché ti venissero questi mal di testa?",shape=box,color=red];
		j3671157194 -> j1340778965;
	j509833837 [label="Marie pensa che tu stia cercando di portare tutto questo peso da solo. Volevo farti sapere che sono qui.",shape=box,color=red];
		j509833837 -> j3523925928;
	j3498948806 [label="Marie crede che tu stia inutilmente soffrendo per tutta questa situazione. Mi chiedevo se potessi aiutarti.",shape=box,color=red];
