		j3957594148 -> j1578555104;
		j3957594148 -> j1397242853;
		j3957594148 -> j14118409;
	j471860463 [label="Quindi, dovrai scusarmi se trovo questa... offerta di legame da parte tua stranamente ridicola nella sua ingenuità. Né ti conosco né mi fido di te. In realtà, tutto ciò che ho a disposizione è la parola degli altri.",shape=box,color=blue];
		j471860463 -> j816734011;
	j1559930159 [label="Vattene, Drifter. Prima che ti trovi e ti costringa a riposare. E nessuno dei due ne trarrà beneficio.",shape=box,color=blue];
		j1559930159 -> j2909374449;
		j1559930159 -> j1582822795;
	j3560441646 [label="Se vogliamo essere schietti, sinceramente non riesco a smettere di pensare a te da quando ci siamo conosciuti.",shape=box,color=red];
		j3560441646 -> j2905931503;
	j1578555104 [label="Entrati vi ha trasformati in protoframe e ora siete qui, senza preparazione, senza niente. Se posso aiutarvi ad adattarvi in qualche modo, lo farò volentieri.",shape=box,color=red];
		j1578555104 -> j3523925928;
	j1397242853 [label="Beh...? penso che tu sia affascinante. Vorrei conoscerti meglio.",shape=box,color=red];
		j1397242853 -> j3523925928;
	j816734011 [label="Le parole di altri che ancora non conosco e di cui non mi fido. Tutto questo grava su di noi, senza contare i fardelli che non puoi vedere.",shape=box,color=blue];
		j816734011 -> j3520068661;
	j2909374449 [label="Ok, ok. Vado.",shape=box,color=red];
		j2909374449 -> j867353677;
