	2265 [label="Chat ends.",color=orange];
	2267 [label="Se c'è qualcosa che posso fare per aiutarti, lo farò, mon miracle. Cosa sembra essere andato storto tra voi due?",shape=box,color=blue];
		2267 -> 2269;
	2268 [label="Se c'è qualcosa che posso fare per aiutarti, lo farò, amico mio. Cosa sembra essere andato storto tra voi due?",shape=box,color=blue];
