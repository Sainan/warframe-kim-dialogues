		"LyonRoatheFail begins." -> j4115718638;
	j466099174 [label="Lyon, ho bisogno del tuo aiuto con Roathe.",shape=box,color=red];
		j466099174 -> j421763245;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j421763245 [label="Check boolean LyonDating",color=orange];
		j421763245 -> j2626570812 [label=true,color=green];
		j421763245 -> j603021313 [label=false,color=brown];
	"Chat ends." [color=orange];
	j2626570812 [label="Se c'è qualcosa che posso fare per aiutarti, lo farò, mon miracle. Cosa sembra essere andato storto tra voi due?",shape=box,color=blue];
		j2626570812 -> j1618578127;
	j603021313 [label="Se c'è qualcosa che posso fare per aiutarti, lo farò, amico mio. Cosa sembra essere andato storto tra voi due?",shape=box,color=blue];
		j603021313 -> j1618578127;
	j1618578127 [label="Evaluate expressions",color=orange];
		j1618578127 -> j2667120248 [label="RoatheFail",color=purple];
		j1618578127 -> j2667120248 [label="RoatheFailStall",color=purple];
		j1618578127 -> j87442171 [label="RoatheFailUltimate",color=purple];
		j1618578127 -> j3515967428 [label="RoatheFailNot21",color=purple];
		j1618578127 -> j394610672 [label="RoatheFailUnloved",color=purple];
	j2667120248 [label="Roathe ha dovuto affrontare la verità su... beh... sull'assunzione del siero. E non so come, ma credo di essere stato pessimo nell'aiutarlo.",shape=box,color=red];
		j2667120248 -> j3514229440;
	j87442171 [label="Non ne sono sicuro. Credo di aver detto qualcosa che non avrei dovuto.",shape=box,color=red];
		j87442171 -> j4199214288;
	j3515967428 [label="Mi ha detto di non addentrarmi ulteriormente nei suoi ricordi. Quindi non l'ho fatto. E ora sembriamo... bloccati?",shape=box,color=red];
		j3515967428 -> j4075771467;
	j394610672 [label="Gli ho detto che stavo con lui solo per un po' di compagnia, e anche se non sembrava che la cosa gli desse fastidio, ora ho la sensazione che siamo regrediti.",shape=box,color=red];
		j394610672 -> j4199214288;
	j3514229440 [label="Capisco. Può essere difficile riconcilliarsi con le proprie azioni passate quando vengono presentate sotto una nuova luce. Maledico Entrati per aver costretto lui, e noi, in questa situazione spregevole.",shape=box,color=blue];
		j3514229440 -> j2321942292;
	j4199214288 [label="Capisco. Temo di doverti dire che c'è poco che io possa fare in merito, dato che stai sperimentando le conseguenze del 'raccogliere ciò che hai seminato'.",shape=box,color=blue];
		j4199214288 -> j308571756;
	j4075771467 [label="Capisco. A volte, agire secondo i desideri di qualcuno non è la stessa cosa che seguirli alla lettera.",shape=box,color=blue];
		j4075771467 -> j1041394590;
	j2321942292 [label="Farò tutto il possibile per convincerlo ad ascoltarti. Ma ti consiglio vivamente di preparare argomentazioni più concrete sul perché dovrebbe reinterpretare le sue azioni come qualcosa di diverso dalla codardia.",shape=box,color=blue];
		j2321942292 -> j204037632;
	j308571756 [label="Agire con spietata indifferenza in questo modo provocherà reazioni altrettanto negative. Soprattutto quando si ha a che fare con una persona come Roathe.",shape=box,color=blue];
		j308571756 -> j3404654523;
	j1041394590 [label="È un atto terribile quello che dobbiamo compiere, disobbedire ai desideri di qualcuno, soprattutto frugando nei suoi ricordi e nei suoi pensieri privati.",shape=box,color=blue];
		j1041394590 -> j185326019;
	j204037632 [label="Perché so che è questo che lo divora da dentro.",shape=box,color=blue];
		j204037632 -> j3176729457;
	j3404654523 [label="Non so a cosa tu possa ricorrere per correggere la situazione. Ma non credo che io o Marie abbiamo tale soluzione, perdonami.",shape=box,color=blue];
		j3404654523 -> j3390456479;
	j185326019 [label="Maledico Entrati per aver costretto lui e noi in una posizione così spregevole.",shape=box,color=blue];
		j185326019 -> j3714863949;
	j3176729457 [label="So che avremo bisogno anche dell'aiuto di Marie. Potrebbe essere difficile convincerla, perché sai quei due sono sul piede di guerra.",shape=box,color=blue];
		j3176729457 -> j2767784080;
	j3390456479 [label="Forse è meglio prendere in considerazione altre opzioni.",shape=box,color=blue];
		j3390456479 -> "Chat ends.";
	j3714863949 [label="Ma mi sembra che l'unico modo per aiutarlo sia, purtroppo, fare proprio questo. E continuare a esplorare la Descendia finché non ci sarà più alcun ricordo da scoprire.",shape=box,color=blue];
		j3714863949 -> j2726073416;
	j2767784080 [label="Boolean LyonRoatheFailFix is now true.",color=orange];
		j2767784080 -> j51414180;
	j2726073416 [label="Non importa quanto il diavolo possa protestare.",shape=box,color=blue];
		j2726073416 -> "Chat ends.";
	j51414180 [label="Che Lua ti guidi.",shape=box,color=blue];
		j51414180 -> "Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
}