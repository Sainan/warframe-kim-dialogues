		2269 -> 2272 [label="RoatheFailUltimate",color=purple];
		2269 -> 2271 [label="RoatheFailNot21",color=purple];
		2269 -> 2270 [label="RoatheFailUnloved",color=purple];
	2273 [label="Roathe ha dovuto affrontare la verità su... beh... sull'assunzione del siero. E non so come, ma credo di essere stato pessimo nell'aiutarlo.",shape=box,color=red];
		2273 -> 2277;
	2272 [label="Non ne sono sicuro. Credo di aver detto qualcosa che non avrei dovuto.",shape=box,color=red];
		2272 -> 2276;
	2271 [label="Mi ha detto di non addentrarmi ulteriormente nei suoi ricordi. Quindi non l'ho fatto. E ora sembriamo... bloccati?",shape=box,color=red];
		2271 -> 2275;
	2270 [label="Gli ho detto che stavo con lui solo per un po' di compagnia, e anche se non sembrava che la cosa gli desse fastidio, ora ho la sensazione che siamo regrediti.",shape=box,color=red];
		2270 -> 2274;
	2277 [label="Capisco. Può essere difficile riconcilliarsi con le proprie azioni passate quando vengono presentate sotto una nuova luce. Maledico Entrati per aver costretto lui, e noi, in questa situazione spregevole.",shape=box,color=blue];
		2277 -> 2280;
	2276 [label="Capisco. Temo di doverti dire che c'è poco che io possa fare in merito, dato che stai sperimentando le conseguenze del 'raccogliere ciò che hai seminato'.",shape=box,color=blue];
		2276 -> 2278;
	2275 [label="Capisco. A volte, agire secondo i desideri di qualcuno non è la stessa cosa che seguirli alla lettera.",shape=box,color=blue];
		2275 -> 2279;
	2274 [label="Capisco. Temo di doverti dire che c'è poco che io possa fare in merito, dato che stai sperimentando le conseguenze del 'raccogliere ciò che hai seminato'.",shape=box,color=blue];
		2274 -> 2278;
	2280 [label="Farò tutto il possibile per convincerlo ad ascoltarti. Ma ti consiglio vivamente di preparare argomentazioni più concrete sul perché dovrebbe reinterpretare le sue azioni come qualcosa di diverso dalla codardia.",shape=box,color=blue];
		2280 -> 2282;
	2278 [label="Agire con spietata indifferenza in questo modo provocherà reazioni altrettanto negative. Soprattutto quando si ha a che fare con una persona come Roathe.",shape=box,color=blue];
		2278 -> 2281;
	2279 [label="È un atto terribile quello che dobbiamo compiere, disobbedire ai desideri di qualcuno, soprattutto frugando nei suoi ricordi e nei suoi pensieri privati.",shape=box,color=blue];
		2279 -> 2341;
	2282 [label="Perché so che è questo che lo divora da dentro.",shape=box,color=blue];
		2282 -> 2284;
	2281 [label="Non so a cosa tu possa ricorrere per correggere la situazione. Ma non credo che io o Marie abbiamo tale soluzione, perdonami.",shape=box,color=blue];
		2281 -> 2283;
	2341 [label="Maledico Entrati per aver costretto lui e noi in una posizione così spregevole.",shape=box,color=blue];
		2341 -> 2342;
	2284 [label="So che avremo bisogno anche dell'aiuto di Marie. Potrebbe essere difficile convincerla, perché sai quei due sono sul piede di guerra.",shape=box,color=blue];
		2284 -> 2286;
	2283 [label="Forse è meglio prendere in considerazione altre opzioni.",shape=box,color=blue];
		2283 -> 2285;
	2342 [label="Ma mi sembra che l'unico modo per aiutarlo sia, purtroppo, fare proprio questo. E continuare a esplorare la Descendia finché non ci sarà più alcun ricordo da scoprire.",shape=box,color=blue];
		2342 -> 2343;
	2286 [label="Update boolean LyonRoatheFailFix",color=orange];
		2286 -> 2287;
	2285 [label="Chat ends.",color=orange];
	2343 [label="Non importa quanto il diavolo possa protestare.",shape=box,color=blue];
