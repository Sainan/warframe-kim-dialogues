		1343 -> 1344 [label=false,color=brown];
	1345 [label="Il tempo è... aggrovigliato, per uno come me, nello stato in cui mi trovo ora. È difficile da descrivere. Una volta ci ho provato, e ho fallito miseramente.",shape=box,color=blue];
		1345 -> 1346;
	1344 [label="Il tempo è... aggrovigliato, per qualcuno come me, nello stato in cui mi trovo ora. È difficile da descrivere, e io non ci sto riuscendo molto bene.",shape=box,color=blue];
		1344 -> 1346;
