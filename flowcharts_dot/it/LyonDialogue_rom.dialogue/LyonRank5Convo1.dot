		j1644868128 -> j2862131335;
	j4161212046 [label="lacerando la mia carne\nstaccandola dalle mie ossa\nperché? a quale scopo?\ndi chi è la fame che questo alimenta?",shape=box,color=blue];
		j4161212046 -> j965056099;
		j4161212046 -> j3711429332;
	j38999857 [label="Non senza ricorrere all'... impensabile. O a quello.",shape=box,color=red];
		j38999857 -> j798401715;
	j3407454447 [label="Sei amato. Hai una famiglia e degli amici. Anche se non sembra così.",shape=box,color=red];
		j3407454447 -> j3949772187;
	j2772974512 [label="Io - Stai scherzando vero? Non puoi dire sul serio, dopo quello a cui hai appena assistito? O hai perso la ragione o la compassione ha sopraffatto i tuoi sensi.",shape=box,color=blue];
		j2772974512 -> j3923280683;
		j2772974512 -> j2531277677;
	j2862131335 [label="+10 Chemistry",color=orange];
		j2862131335 -> j4006363057;
	j965056099 [label="Di nessuno. Non devi più soffrire così. Lascialo andare.",shape=box,color=red];
		j965056099 -> j2915490524;
	j3711429332 [label="Lo so. Lo so che fa male. Mi dispiace. Mi dispiace tanto. Esci dalla stanza.",shape=box,color=red];
		j3711429332 -> j715505459;
	j798401715 [label="+10 Chemistry",color=orange];
