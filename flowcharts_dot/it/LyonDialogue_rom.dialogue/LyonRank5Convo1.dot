	1315 [label="Hai detto che volevi parlare del fatto che non credo davvero che l'Indifferenza sia una 'vera divinità'. È un buon momento?",shape=box,color=red];
		1315 -> 1320;
	1313 [label="[Fine.]",shape=box,color=red];
		1313 -> 1318;
	1314 [label="L'altro giorno mi chiedevi dell'incarnazione concettuale e dell'Indifferenza. C'è qualcosa che ti preoccupa?",shape=box,color=red];
		1314 -> 1319;
	1317 [label="Roathe è convinto che l'Uomo nel Muro non sia un vero dio. E che sia il prodotto di una 'incarnazione concettuale'. Cosa ne pensi?",shape=box,color=red];
		1317 -> 1322;
	1316 [label="Lyon, cosa succedere tra te e Roathe? Sono riuscito solo a capire qualcosina.",shape=box,color=red];
		1316 -> 1321;
	1320 [label="Non so se ci sia un momento 'buono' per discutere del problema tangibile che questo mi ha causato, Drifter.",shape=box,color=blue];
		1320 -> 1324;
	1318 [label="Chat ends.",color=orange];
	1319 [label="Ci sono moltissime cose che mi preoccupano, Drifter. Il tema dell'Indifferenza e dell'incarnazione concettuale, temo, siano solo una di queste.",shape=box,color=blue];
		1319 -> 1323;
	1322 [label="Il problema, Drifter, è che non lo so. Se conoscessi la risposta, non mi tormenterei con un simile dibattito interiore.",shape=box,color=blue];
		1322 -> 1326;
	1321 [label="Riassumerò, anche se sono scioccato dal fatto che tu abbia evitato i suoi sfoghi sull'argomento. È fin troppo ansioso di condividerli in ogni occasione.",shape=box,color=blue];
		1321 -> 1325;
	1324 [label="Ma, in quanto tale, questo è un momento 'buono' come un altro. Mi ha incuriosito il fatto che ti fossi schierato con Roathe nel credere che l'Indifferenza non fosse una vera divinità.",shape=box,color=blue];
		1324 -> 1326;
	1323 [label="O potenzialmente due, a seconda di come si vuole interpretare la situazione. Anche se suppongo che sia proprio questo il nocciolo del mio dilemma.",shape=box,color=blue];
		1323 -> 1326;
	1326 [label="Tuttavia, dovrei... cominciare dall'inizio. Non capirai esattamente perché questo argomento in particolare sia così importante per me se non hai un po' di contesto...",shape=box,color=blue];
		1326 -> 1328;
	1325 [label="Crede che l'Indifferenza non sia una divinità del Void, in nessun senso, e che sia stata in realtà creata da Entrati e da tutti coloro he hanno interagito con essa in seguito -",shape=box,color=blue];
		1325 -> 1327;
	1328 [label="Sono un Fratello di Lua. Ho dedicato la mia vita al suo culto. Per tutta la vita ho creduto in questo.",shape=box,color=blue];
		1328 -> 1330;
	1327 [label="- tramite quella che conosci come 'incarnazione concettuale'. ",shape=box,color=blue];
		1327 -> 1329;
	1330 [label="E in tutti gli anni trascorsi nella chiesa, mi sono aggrappato saldamente alla mia fede - a quella che è stata la ferma consapevolezza che la mia sofferenza, il mio dolore e le mie visioni -",shape=box,color=blue];
		1330 -> 1331;
	1329 [label="Più o meno simile la modo in cui hai creato Duviri, credo.",shape=box,color=blue];
		1329 -> 1326;
	1331 [label=" - sono stati al suo servizio. Nel suo nome. E utilizzati per un suo scopo.",shape=box,color=blue];
		1331 -> 1332;
	1332 [label="Questo... finché 'Cardinal Dimanche' non si rivelò essere Albrecht Entrati.",shape=box,color=blue];
		1332 -> 1333;
	1333 [label="E ci raccontò la verità su chi era, la storia delle sue malefatte con il Void e tutto ciò che ne è derivato. Più specificamente... tutto ciò che ne è derivato.",shape=box,color=blue];
		1333 -> 1334;
		1333 -> 1335;
	1334 [label="L'indifferenza.",shape=box,color=red];
		1334 -> 1336;
	1335 [label="E?",shape=box,color=red];
		1335 -> 1337;
	1336 [label="Esatto. Ci raccontò della cosa beffarda che lo ha accolto, delle dita che recuperò da quel posto che somigliava al suo laboratorio.",shape=box,color=blue];
		1336 -> 1338;
	1337 [label="Ci raccontò della sua discesa nel vuoto nella campana di vetro. Del luogo che somigliava al suo laboratorio. ",shape=box,color=blue];
		1337 -> 1338;
	1338 [label="Inoltre, ci raccontò del grande terrore che provava nel sapere di aver liberato qualcosa che avrebbe potuto seguirlo non solo nello spazio, ma anche nel tempo.",shape=box,color=blue];
		1338 -> 1339;
	1339 [label="Una divinità del nulla. Una cosa che deve essere contenuta. Una creatura di cui possiede dei pezzi, che avrebbe graffiato i muri per liberarsi.",shape=box,color=blue];
		1339 -> 1340;
	1340 [label="Una divinità terribile e divorante che era, e allo stesso tempo non era, già libera.",shape=box,color=blue];
		1340 -> 1341;
		1340 -> 1342;
	1341 [label="Cosa intendi?",shape=box,color=red];
		1341 -> 1343;
	1342 [label="'Era' e 'non era' già libera?",shape=box,color=red];
		1342 -> 1343;
	1343 [label="Check boolean LyonRell1",color=orange];
