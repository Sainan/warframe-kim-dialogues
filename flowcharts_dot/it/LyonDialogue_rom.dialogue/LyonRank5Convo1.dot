	j2859031297 [label="Respira, Lyon. Respira. Non sono davvero qui.",shape=box,color=red];
		j2859031297 -> j1644868128;
	j2571186639 [label="Mi... mi dispiace, Lyon. Concentrati sullo schermo. Ci sono qui io.",shape=box,color=red];
		j2571186639 -> j4161212046;
	j1679849256 [label="So che ti è stato chiesto di portare un fardello orribile. E forse non è giusto. Ma non vedo una via d'uscita.",shape=box,color=red];
		j1679849256 -> j38999857;
	j2545648049 [label="Per Marie sei tutto. Sei diventato un caro amico per me. Credo che mancheresti anche a Roathe, anche se non lo ammetterebbe mai.",shape=box,color=red];
		j2545648049 -> j3407454447;
