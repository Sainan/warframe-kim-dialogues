		1400 -> 1406;
	1401 [label="Sarebbe così facile arrendersi. Rinunciare. Deporre la mia agonia sull'altare della sofferenza e non dire altro. O fare molto peggio - fare ciò che molti hanno temuto che potessi fare con una lama nel buio della notte.",shape=box,color=blue];
