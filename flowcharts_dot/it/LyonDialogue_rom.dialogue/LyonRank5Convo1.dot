	j3327371286 [label="Arrivò con la prova delle sue impossibilità. Sapevo che era Albrecht Entrati, non il Cardinal Dimanche. Ma dire che tutto ciò che ero - tutto ciò in cui credevo - era opera dell'Indifferenza?",shape=box,color=blue];
