		j2992342352 -> j4050837477;
	j270559731 [label="Non credo che definirei 'debole' chiunque abbia dovuto sopportare ciò che hai dovuto sopportare tu, Lyon.",shape=box,color=red];
		j270559731 -> j2022472025;
	j3668033587 [label="Debole è un modo terribile per dire 'maledetto da visioni che non ha richiesto'. Ma fai come preferisci.",shape=box,color=red];
		j3668033587 -> j2022472025;
	j919755870 [label="Sai di cosa sei capace, quindi seguirò le tue indicazioni.",shape=box,color=red];
		j919755870 -> j2349558937;
	j4050837477 [label="insaguinato",shape=box,color=blue];
		j4050837477 -> j322891189;
	j2022472025 [label="Apprezzo il sentimento. Ma so che non sono altro che una vetrata in frantumi anche nei giorni migliori. Sono qui e mi chiedo dove siano finiti molti di quei pezzi.",shape=box,color=blue];
		j2022472025 -> j4049183973;
	j2349558937 [label="Grazie. Mi meraviglio della tua pazienza. So di essere solo una vetrata in frantumi anche nei giorni migliori. Sono qui e mi chiedo dove siano finiti molti dei suoi pezzi.",shape=box,color=blue];
		j2349558937 -> j4049183973;
