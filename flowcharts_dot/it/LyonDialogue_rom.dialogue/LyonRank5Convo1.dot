		1463 -> 1467;
	1464 [label="Update boolean IsDating",color=orange];
		1464 -> 1468;
	1465 [label="This is precisely the reason I attempt not to grapple with the specifics on most days...",shape=box,color=blue];
		1465 -> 1469;
	1466 [label="And lo, you see the problem I face.",shape=box,color=blue];
		1466 -> 1465;
	1467 [label="Matters grew far worse when Roathe arrived. For my crisis of faith became one layer more complicated when I learned that the Indifference is not a god at all -",shape=box,color=blue];
		1467 -> 1470;
	1468 [label="Do you still wish to hear the situation between myself and Roathe? I fear it has become suddenly and laughably unimportant in my mind today.",shape=box,color=blue];
