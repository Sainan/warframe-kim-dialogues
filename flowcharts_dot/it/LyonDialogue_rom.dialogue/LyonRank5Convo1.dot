	1454 [label="Precisely what I asked him at the time. He explained to me the concepts of \"quantum entanglement\", \"superposition\" and \"eternalism\" -",shape=box,color=blue];
		1454 -> 1458;
	1455 [label="He came with proof of his impossibilities. I knew he was Albrecht Entrati, not Cardinal Dimanche. But to say that all that I was - all that I believed - was the work of the Indifference?",shape=box,color=blue];
		1455 -> 1459;
	1456 [label="I did not know what to believe, at first. He came with proof of his impossibilities. I knew he was Albrecht Entrati, not Cardinal Dimanche. But to say that all that I was - all that I believed - was the work of the Indifference?",shape=box,color=blue];
		1456 -> 1459;
	1457 [label="Update boolean LyonDating",color=orange];
		1457 -> 1460;
	1458 [label="And while it all made sense to me in a superficial, scientific way, I did not truly understand.",shape=box,color=blue];
		1458 -> 1461;
		1458 -> 1462;
	1459 [label="That I had prayed in service to a false god and to to Lua, all my years?",shape=box,color=blue];
		1459 -> 1463;
	1460 [label="Update boolean LyonHasDated",color=orange];
		1460 -> 1464;
	1461 [label="This is going to make my head hurt.",shape=box,color=red];
		1461 -> 1465;
	1462 [label="But the Indifference wasn't free yet in your time. But was he? In ours?",shape=box,color=red];
