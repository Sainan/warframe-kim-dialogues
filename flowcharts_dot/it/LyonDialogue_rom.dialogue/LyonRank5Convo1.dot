		1351 -> 1354;
	1352 [label="So di aver evitato clamorosamente l'argomento e me ne scuso. Ma questo potrebbe farmi precipitare in una visione da cui non sono sicuro di potermi riprendere facilmente.",shape=box,color=blue];
		1352 -> 1355;
	1353 [label="Ti assicuro che lo faremo. So di aver evitato clamorosamente l'argomento e me ne scuso. Ma questo potrebbe farmi precipitare in una visione da cui non sono sicuro di potermi riprendere facilmente.",shape=box,color=blue];
