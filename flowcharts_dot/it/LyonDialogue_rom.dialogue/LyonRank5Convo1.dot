	j433218715 [label="Hai detto che volevi parlare del fatto che non credo davvero che l'Indifferenza sia una 'vera divinità'. È un buon momento?",shape=box,color=red];
		j433218715 -> j4243878914;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j434958546 [label="L'altro giorno mi chiedevi dell'incarnazione concettuale e dell'Indifferenza. C'è qualcosa che ti preoccupa?",shape=box,color=red];
		j434958546 -> j2320156118;
	j55608886 [label="Roathe è convinto che l'Uomo nel Muro non sia un vero dio. E che sia il prodotto di una 'incarnazione concettuale'. Cosa ne pensi?",shape=box,color=red];
		j55608886 -> j3664663177;
	j967047504 [label="Lyon, cosa succedere tra te e Roathe? Sono riuscito solo a capire qualcosina.",shape=box,color=red];
		j967047504 -> j3885523004;
	j4243878914 [label="Non so se ci sia un momento 'buono' per discutere del problema tangibile che questo mi ha causato, Drifter.",shape=box,color=blue];
		j4243878914 -> j172463325;
	"Chat ends." [color=orange];
	j2320156118 [label="Ci sono moltissime cose che mi preoccupano, Drifter. Il tema dell'Indifferenza e dell'incarnazione concettuale, temo, siano solo una di queste.",shape=box,color=blue];
		j2320156118 -> j2951240986;
	j3664663177 [label="Il problema, Drifter, è che non lo so. Se conoscessi la risposta, non mi tormenterei con un simile dibattito interiore.",shape=box,color=blue];
		j3664663177 -> j3335587684;
	j3885523004 [label="Riassumerò, anche se sono scioccato dal fatto che tu abbia evitato i suoi sfoghi sull'argomento. È fin troppo ansioso di condividerli in ogni occasione.",shape=box,color=blue];
		j3885523004 -> j939369277;
	j172463325 [label="Ma, in quanto tale, questo è un momento 'buono' come un altro. Mi ha incuriosito il fatto che ti fossi schierato con Roathe nel credere che l'Indifferenza non fosse una vera divinità.",shape=box,color=blue];
		j172463325 -> j3335587684;
	j2951240986 [label="O potenzialmente due, a seconda di come si vuole interpretare la situazione. Anche se suppongo che sia proprio questo il nocciolo del mio dilemma.",shape=box,color=blue];
		j2951240986 -> j3335587684;
	j3335587684 [label="Tuttavia, dovrei... cominciare dall'inizio. Non capirai esattamente perché questo argomento in particolare sia così importante per me se non hai un po' di contesto...",shape=box,color=blue];
		j3335587684 -> j3281832660;
	j939369277 [label="Crede che l'Indifferenza non sia una divinità del Void, in nessun senso, e che sia stata in realtà creata da Entrati e da tutti coloro he hanno interagito con essa in seguito -",shape=box,color=blue];
		j939369277 -> j4253189319;
	j3281832660 [label="Sono un Fratello di Lua. Ho dedicato la mia vita al suo culto. Per tutta la vita ho creduto in questo.",shape=box,color=blue];
		j3281832660 -> j944701756;
	j4253189319 [label="- tramite quella che conosci come 'incarnazione concettuale'. ",shape=box,color=blue];
		j4253189319 -> j1536256894;
	j944701756 [label="E in tutti gli anni trascorsi nella chiesa, mi sono aggrappato saldamente alla mia fede - a quella che è stata la ferma consapevolezza che la mia sofferenza, il mio dolore e le mie visioni -",shape=box,color=blue];
		j944701756 -> j3870760941;
	j1536256894 [label="Più o meno simile la modo in cui hai creato Duviri, credo.",shape=box,color=blue];
		j1536256894 -> j3335587684;
	j3870760941 [label=" - sono stati al suo servizio. Nel suo nome. E utilizzati per un suo scopo.",shape=box,color=blue];
		j3870760941 -> j3080069646;
	j3080069646 [label="Questo... finché 'Cardinal Dimanche' non si rivelò essere Albrecht Entrati.",shape=box,color=blue];
		j3080069646 -> j3389922695;
	j3389922695 [label="E ci raccontò la verità su chi era, la storia delle sue malefatte con il Void e tutto ciò che ne è derivato. Più specificamente... tutto ciò che ne è derivato.",shape=box,color=blue];
		j3389922695 -> j1164479825;
		j3389922695 -> j3689083958;
	j1164479825 [label="L'indifferenza.",shape=box,color=red];
		j1164479825 -> j3458943093;
	j3689083958 [label="E?",shape=box,color=red];
		j3689083958 -> j1202504191;
	j3458943093 [label="Esatto. Ci raccontò della cosa beffarda che lo ha accolto, delle dita che recuperò da quel posto che somigliava al suo laboratorio.",shape=box,color=blue];
		j3458943093 -> j3004634900;
	j1202504191 [label="Ci raccontò della sua discesa nel vuoto nella campana di vetro. Del luogo che somigliava al suo laboratorio. ",shape=box,color=blue];
		j1202504191 -> j3004634900;
	j3004634900 [label="Inoltre, ci raccontò del grande terrore che provava nel sapere di aver liberato qualcosa che avrebbe potuto seguirlo non solo nello spazio, ma anche nel tempo.",shape=box,color=blue];
		j3004634900 -> j2194716112;
	j2194716112 [label="Una divinità del nulla. Una cosa che deve essere contenuta. Una creatura di cui possiede dei pezzi, che avrebbe graffiato i muri per liberarsi.",shape=box,color=blue];
		j2194716112 -> j4248810127;
	j4248810127 [label="Una divinità terribile e divorante che era, e allo stesso tempo non era, già libera.",shape=box,color=blue];
		j4248810127 -> j720259656;
		j4248810127 -> j679128908;
	j720259656 [label="Cosa intendi?",shape=box,color=red];
		j720259656 -> j3826452011;
	j679128908 [label="'Era' e 'non era' già libera?",shape=box,color=red];
		j679128908 -> j3826452011;
	j3826452011 [label="Check boolean LyonRell1",color=orange];
		j3826452011 -> j3850064837 [label=true,color=green];
		j3826452011 -> j220049266 [label=false,color=brown];
	j3850064837 [label="Il tempo è... aggrovigliato, per uno come me, nello stato in cui mi trovo ora. È difficile da descrivere. Una volta ci ho provato, e ho fallito miseramente.",shape=box,color=blue];
		j3850064837 -> j3321924526;
	j220049266 [label="Il tempo è... aggrovigliato, per qualcuno come me, nello stato in cui mi trovo ora. È difficile da descrivere, e io non ci sto riuscendo molto bene.",shape=box,color=blue];
		j220049266 -> j3321924526;
	j3321924526 [label="Preferirei spiegarne i dettagli un'altra volta, perché non è questo il punto di ciò che sto cercando di dire oggi.",shape=box,color=blue];
		j3321924526 -> j366078008;
	j366078008 [label="Check boolean LyonRell1",color=orange];
		j366078008 -> j3861572777 [label=true,color=green];
		j366078008 -> j3116206188 [label=true,color=green];
		j366078008 -> j3770522305 [label=true,color=green];
		j366078008 -> j3116206188 [label=false,color=brown];
		j366078008 -> j3770522305 [label=false,color=brown];
	j3861572777 [label="Ma se senti - o hai sentito - Rell... voglio parlarne.",shape=box,color=red];
		j3861572777 -> j3948917730;
	j3116206188 [label="Ok. Come desideri.",shape=box,color=red];
		j3116206188 -> j235375499;
	j3770522305 [label="Vorrei però approfondire l'argomento...",shape=box,color=red];
		j3770522305 -> j3844064538;
	j3948917730 [label="Lo so. E ho evitato oltraggiosamente l'argomento. Solo il suo nome",shape=box,color=blue];
		j3948917730 -> j2331068185;
	j235375499 [label="So di aver evitato clamorosamente l'argomento e me ne scuso. Ma questo potrebbe farmi precipitare in una visione da cui non sono sicuro di potermi riprendere facilmente.",shape=box,color=blue];
		j235375499 -> j3056062184;
	j3844064538 [label="Ti assicuro che lo faremo. So di aver evitato clamorosamente l'argomento e me ne scuso. Ma questo potrebbe farmi precipitare in una visione da cui non sono sicuro di potermi riprendere facilmente.",shape=box,color=blue];
		j3844064538 -> j3056062184;
	j2331068185 [label="minaccia di",shape=box,color=blue];
		j2331068185 -> j2992342352;
	j3056062184 [label="Non vorrei dover interrompere ancora una volta questa conversazione perché non sono in grado di continuare a causa delle mie debolezze.",shape=box,color=blue];
