		j2228541265 -> j2923539459;
	j2923539459 [label="Interessante. Avevo dato per scontato che credessi che la tua Indifferenza fosse una divinità, più o meno come Lua o Sol. Mi sbagliavo?",shape=box,color=blue];
		j2923539459 -> j2427854861;
		j2923539459 -> j3044660137;
	j2457403655 [label="No. Ma credo che mi dia una sorta di pace pensare di poter capire cosa sta facendo l'Indifferenza.",shape=box,color=red];
		j2457403655 -> j1539714126;
	j3469684171 [label="No, suppongo di no, in fin dei conti. Ma ci ho avuto abbastanza interazioni, da sentirmi giustificato nel cercare di capirla.",shape=box,color=red];
		j3469684171 -> j1371255193;
	j1775249718 [label="Cos'altro potrebbero essere? L'indifferenza sembra prendere ogni parte del corpo umano per cercare di capirne lo scopo, una alla volta.",shape=box,color=red];
		j1775249718 -> j2263367317;
	j1106581414 [label="Perché è in questo che si trasformano una volta uccisi. Lo abbiamo dimostrato più volte.",shape=box,color=blue];
		j1106581414 -> j3974678763;
		j1106581414 -> j3038426437;
		j1106581414 -> j1664341374;
	j2860587158 [label="Mm. Sì. Marie me l'ha detto Non credi all'azione di forze invisibili nel nostro mondo - inclusa quella dell'Indifferenza. Giusto?",shape=box,color=blue];
		j2860587158 -> j1361452447;
		j2860587158 -> j4129263648;
	j2879781532 [label="Interessante. Questa è la seconda volta che ho l'impressione che non sembri credere alla realtà della tua Indifferenza. È così?",shape=box,color=blue];
		j2879781532 -> j377183091;
		j2879781532 -> j2372524699;
	j3555298213 [label="Interessante. Ho forse capito che ultimamente la tua fede è stata messa a dura prova? O non ne hai mai avuta, nella tua Indifferenza?",shape=box,color=blue];
		j3555298213 -> j377183091;
		j3555298213 -> j2372524699;
	j2427854861 [label="Non sono sicuro che l'Indifferenza fosse reale finché non l'abbiamo resa reale. Credo che l'abbiamo evocata nello stesso modo in cui ho evocato Duviri.",shape=box,color=red];
		j2427854861 -> j3668391079;
	j3044660137 [label="Penso che l'Indifferenza sia una vera divinità - con una vera sensibilità dentro di sé.",shape=box,color=red];
		j3044660137 -> j3158342348;
	j1539714126 [label="A volte mi chiedo se non sia questo il motivo per cui così tante persone alla fine della giornata si rivolgono alla fede...",shape=box,color=blue];
		j1539714126 -> j972564917;
	j1371255193 [label="Scusa, ma comincio a proccuparmi quando un individuo si sente 'giustificato' in un'azione qualsiasi, specialmente quando si tratta di prevedere le motivazioni degli altri.",shape=box,color=blue];
		j1371255193 -> j638341939;
		j1371255193 -> j1345717541;
	j2263367317 [label="Dovremmo proccuparci di cosa potrebbe accadere quando si passa alle parti meno ovvie?",shape=box,color=blue];
		j2263367317 -> j3691531649;
	j3974678763 [label="Penso che l'Indifferenza stia cercando di imparare come essere 'umana'. È sempre stata qualcosa di Più Grande. Diverso. Quindi sta imparando ad essere qualcosa di Più Piccolo, Noi.",shape=box,color=red];
		j3974678763 -> j2741587556;
	j3038426437 [label="A volte mi chiedo se l'Indifferenza non abbia mai avuto un corpo proprio prima che interagissimo con lei. Sta quindi imparando a esistere.",shape=box,color=red];
		j3038426437 -> j3705020607;
	j1664341374 [label="L'indifferenza sembra prendere ogni parte del corpo umano per cercare di capirne lo scopo, una alla volta.",shape=box,color=red];
		j1664341374 -> j2263367317;
	j1361452447 [label="Non sono sicuro che l'Indifferenza fosse reale finché non l'abbiamo resa reale. Credo che l'abbiamo evocata nello stesso modo in cui ho evocato Duviri.",shape=box,color=red];
		j1361452447 -> j3698916174;
	j4129263648 [label="Mi dispiace che te l'abbia detto. Penso che l'Indifferenza sia una vera divinità - con una vera sensibilità dentro di sé.",shape=box,color=red];
		j4129263648 -> j4217905354;
	j377183091 [label="A volte mi chiedo se l'Indifferenza non abbia mai avuto un corpo proprio prima che interagissimo con lei. Sta quindi imparando a esistere.",shape=box,color=red];
		j377183091 -> j3668391079;
	j2372524699 [label="No, non volevo insinuare questo, scusa. Penso che l'Indifferenza sia una vera divinità - con una vera sensibilità dentro di sé.",shape=box,color=red];
