	j2491759674 [label="+10 Chemistry",color=orange];
		j2491759674 -> j267823595;
	j3204791647 [label="E sono queste voci che mi rendono così dubbioso, Drifter. E il motivo per cui le mie mani tremano mentre scrivo queste parole...",shape=box,color=blue];
		j3204791647 -> j2879845655;
	j267823595 [label="Io... sì. Ancora una volta, hai ragione. Grazie. Modificherò la mia affermazione dicendo che... semplicemente non sono disposto a parlarne in questo momento.",shape=box,color=blue];
