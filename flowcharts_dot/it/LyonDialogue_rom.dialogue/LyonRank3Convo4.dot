		j822946074 -> j2631878859;
	j775397490 [label="Perché una divinità, che non ha alcuna comprensione della mente umana, dovrebbe cercare di ridere della nostra follia? Perché vorrebbe tormentarci? Deridere i nostri fallimenti e imitare le nostre forme?",shape=box,color=blue];
