		j2877687138 -> j965651369;
	j1386362227 [label="Mmm. Esatto. Come sarà, essere una divinità inconoscibile, trasformata in una formica come uno di noi?",shape=box,color=blue];
		j1386362227 -> j2631878859;
	j890390617 [label="C'è qualcosa di più terrificante che guardare nelle fauci spalancate del Nulla e vedere il Nulla che ci guarda a sua volta? Sapere quanto infinitesimali possiamo essere in realtà? ",shape=box,color=blue];
		j890390617 -> j3777136113;
	j1707934445 [label="Credo che possa avere a che fare con Entrati. E forse con l'Indifferenza.",shape=box,color=red];
		j1707934445 -> j1563575778;
	j1878159960 [label="Sì, ma siamo arrivati qui solo perché ho fatto supposizioni sulle motivazioni degli altri, no?",shape=box,color=red];
		j1878159960 -> j2491759674;
	j3777136113 [label="Cosa non darei per il silenzio del Void. Per la quiete che preannuncia. Qualsiasi cosa - qualsiasi cosa - se non per le voci esasperanti che seguono...",shape=box,color=blue];
		j3777136113 -> j3204791647;
	j1563575778 [label="Allora ho ragione, e non c'è bisogno di parlarne.",shape=box,color=blue];
