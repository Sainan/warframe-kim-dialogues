digraph {
	2100 [label="LyonRank5Convo9 begins.",color=orange];
		2100 -> 2101;
	2101 [label="Evaluate expressions",color=orange];
		2101 -> 2102 [label="LyonDating, LyonDatingConfession",color=purple];
		2101 -> 2103 [label="LyonDating",color=purple];
		2101 -> 2102 [label="false",color=purple];
	2102 [label="Chat ends.",color=orange];
	2103 [label="Mon miracle, io... devo essere assolutamente certo che tu abbia capito qualcosa prima di raccontarti questo mio prossimo aneddoto. ",shape=box,color=blue];
		2103 -> 2104;
	2104 [label="Per me è importante che tu presti molta attenzione alle prossime mie parole. Hai capito?",shape=box,color=blue];
		2104 -> 2105;
		2104 -> 2106;
	2105 [label="Mi stai rendendo nervoso. Cosa c'è che non va?",shape=box,color=red];
		2105 -> 2107;
	2106 [label="Ci sono. Procedi.",shape=box,color=red];
		2106 -> 2108;
	2107 [label="Non c'è niente che non va - anzi, è proprio questo che è fondamentale che tu comprenda - le terribili conseguenze da cui desidero liberarti, qualora tu dessi per scontato che potrebbero derivarne.",shape=box,color=blue];
		2107 -> 2109;
		2107 -> 2110;
		2107 -> 2111;
	2108 [label="+5 Chemistry",color=orange];
		2108 -> 2112;
	2109 [label="Sto ascoltando.",shape=box,color=red];
		2109 -> 2113;
	2110 [label="Non ha molto senso.",shape=box,color=red];
		2110 -> 2114;
	2111 [label="Terribili conseguenze di... cosa?",shape=box,color=red];
		2111 -> 2115;
	2112 [label="Grazie. Prima di iniziare, vorrei assicurarti che non c'è nulla che non va - ma è proprio in questo che risiedono forse le terribili conseguenze delle quali vorrei liberarti, qualora tu dessi per scontato che potrebbero derivarne.",shape=box,color=blue];
		2112 -> 2109;
		2112 -> 2110;
		2112 -> 2111;
	2113 [label="+5 Chemistry",color=orange];
		2113 -> 2116;
	2114 [label="Sì. Ne sono dolorosamente consapevole.",shape=box,color=blue];
		2114 -> 2115;
	2115 [label="Permettimi di ricominciare.",shape=box,color=blue];
		2115 -> 2116;
	2116 [label="Sono consapevole che molti potrebbero interpretarmi come... malato, e in effetti potrei benissimo esserlo. Come minimo, non ho del tutto la mente sana.",shape=box,color=blue];
		2116 -> 2117;
	2117 [label="Da tempo ho fatto pace con tutto questo. Non mi turba più. Le visioni che mi tormentano - le voci - ho trovato il modo di conviverci senza paura o odio.",shape=box,color=blue];
		2117 -> 2118;
	2118 [label="(Ultimamente, penso, un po' per dispetto, se devo essere sincero, ma non è questo il punto.)",shape=box,color=blue];
		2118 -> 2119;
	2119 [label="Ma vorrei che tu capissi che se tu dovessi porre fine a questo tra noi - a questo legame che prima pensavo fosse impossibile tra me e un'altra persona -",shape=box,color=blue];
		2119 -> 2120;
	2120 [label="Se mai lasciassi che il tuo cuore si allontanasse dal mio? ",shape=box,color=blue];
		2120 -> 2121;
	2121 [label="Saprei come resistere, mon miracle.",shape=box,color=blue];
		2121 -> 2122;
	2122 [label="Non mi lascerei consumare da ciò che mi ha tormentato. ",shape=box,color=blue];
		2122 -> 2123;
	2123 [label="Check boolean LyonAllRight",color=orange];
		2123 -> 2125 [label=true,color=green];
		2123 -> 2124 [label=false,color=brown];
	2125 [label="Per usare una tua familiare espressione, starò bene. Troverò motivo di sorridere e ridere ancora una volta.",shape=box,color=blue];
		2125 -> 2126;
		2125 -> 2127;
	2124 [label="Sopravviverei. Starei bene. Troverei motivo di sorridere e ridere ancora una volta.",shape=box,color=blue];
		2124 -> 2126;
		2124 -> 2127;
	2126 [label="Oh, Lyon... non sei un peso per me.",shape=box,color=red];
		2126 -> 2128;
	2127 [label="Mi stai dicendo... che vuoi mettere un punto alla nostra storia?",shape=box,color=red];
		2127 -> 2129;
	2128 [label="Sto semplicemente cercando di liberarti da qualsiasi difficoltà tu possa percepire nei miei confronti...",shape=box,color=blue];
		2128 -> 2130;
		2128 -> 2131;
		2128 -> 2132;
	2129 [label="No! Niente del genere! Sto semplicemente cercando di liberarti da qualsiasi difficoltà tu possa percepire nei miei confronti.",shape=box,color=blue];
		2129 -> 2130;
		2129 -> 2131;
		2129 -> 2132;
	2130 [label="Il tuo dolore... rispecchia in parte il mio. Non sarebbe mai un problema aiutarti a superarlo.",shape=box,color=red];
		2130 -> 2133;
	2131 [label="Non riesco a descrivere cosa mi attrae di te. Ma non sarai mai un dovere o un peso.",shape=box,color=red];
		2131 -> 2134;
	2132 [label="[Lascia Lyon.] Tutto questo è troppo per me, mi dispiace. Forse è meglio chiuderla qui.",shape=box,color=red];
		2132 -> 2135;
	2133 [label="Non posso esprimere quanto il mio cuore si spezzi per te. Ma sono eternamente grato che i nostri solitari fantasmi di dolore si siano ritrovati.",shape=box,color=blue];
		2133 -> 2136;
	2134 [label="Non riesco a esprimere adeguatamente la mia gratitudine, e credo che le parole non ci riusciranno mai.",shape=box,color=blue];
		2134 -> 2136;
	2135 [label="Sì. Certo. Sarebbe... ipocrita accettare qualsiasi altra risposta in questo momento... ",shape=box,color=blue];
		2135 -> 2137;
	2136 [label="Ma ora che mi sono sforzato molto per affrontare quello che è stato uno spettacolarmente autoindulgente preambolo...",shape=box,color=blue];
		2136 -> 2138;
		2136 -> 2139;
		2136 -> 2140;
	2137 [label="Capisco perfettamente. E non ti auguro altro che il meglio. Custodirò gelosamente tutti i momenti che abbiamo trascorso insieme.",shape=box,color=blue];
		2137 -> 2141;
	2138 [label="Per uno che ha iniziato con il silenzio, sei diventato veramente prolisso.",shape=box,color=red];
		2138 -> 2142;
	2139 [label="L'ho trovato accattivante, non preoccuparti.",shape=box,color=red];
		2139 -> 2143;
	2140 [label="Avresti potuto semplicemente dire 'Sai, starò bene se mai dovessimo prendere strade diverse.'",shape=box,color=red];
		2140 -> 2144;
	2141 [label="Lì ricorderò nella mia anima, anche se svaniranno nella mia mente. Arrivederci.",shape=box,color=blue];
		2141 -> 2145;
	2142 [label="+5 Chemistry",color=orange];
		2142 -> 2146;
	2143 [label="+5 Chemistry",color=orange];
		2143 -> 2147;
	2144 [label="+5 Chemistry",color=orange];
		2144 -> 2148;
	2145 [label="Update boolean LyonDating",color=orange];
		2145 -> 2149;
	2146 [label="Bah! Se non volevi essere a conoscenza dei meccanismi più intimi della mia mente, non avresti dovuto curiosarci dentro. La colpa è solo tua.",shape=box,color=blue];
		2146 -> 2150;
	2147 [label="Sono molto contento che apprezzi i miei erratismi. È proprio per questo che scelgo di parlare così poco. Riesci a immaginare cosa significhi supportare tutto questo? Marie mi avrebbe liquidato anni fa come un cane rabbioso.",shape=box,color=blue];
		2147 -> 2150;
	2148 [label="C'è una certa dose di irriverenza e sarcasmo in cui sei naturalmente portato, a cui non potrei mai sperare di arrivare. Lo lascerò per te.",shape=box,color=blue];
		2148 -> 2150;
	2149 [label="Update boolean IsDating",color=orange];
		2149 -> 2151;
	2150 [label="Tuttavia, tutto questo doveva servire da pretesto per una storia che ora sembrerà piuttosto breve rispetto al resto...",shape=box,color=blue];
		2150 -> 2152;
	2151 [label="- Lyon",shape=box,color=blue];
		2151 -> 2153;
	2152 [label="Mi sono svegliato stanotte da un incubo. Quando è successo, delle ombre mi hanno circondato. Niente di estraneo o di nuovo nel mio stato. Incombevano sul mio letto e non volevo disperdersi.",shape=box,color=blue];
		2152 -> 2154;
	2153 [label="Chat ends.",color=orange];
	2154 [label="Non ero spaventanto, perché sapevo che non potevano farmi del male. Tuttavia, non volevano nemmeno sparire dalla mia mente. Solo una persona sarebbe stata in grado di mandarle via.",shape=box,color=blue];
		2154 -> 2155;
	2155 [label="Mi sono alzato dal letto, mi sono vestito, barcollando, per via della visione offuscata dell'incubo persistente. Ho afferrato il mio incensiere e sono caduto in ginocchio al centro della stanza, preparandomi a... beh. ",shape=box,color=blue];
		2155 -> 2156;
	2156 [label="Mi sono preparato a 'schiarirmi le idee'. Mettiamola così.",shape=box,color=blue];
		2156 -> 2157;
	2157 [label="Ma con gli occhi chiusi, la mia mente vagava. I miei pensieri andavano alla deriva... verso di te, mon miracle...",shape=box,color=blue];
		2157 -> 2158;
	2158 [label="Il suono della tua voce. Il tocco della tua mano sulla mia spalla... ",shape=box,color=blue];
		2158 -> 2159;
	2159 [label="E le visioni... fuggirono. Abbandonarono il loro posto, scacciate dal fantasma più forte... te.",shape=box,color=blue];
		2159 -> 2160;
	2160 [label="Poi... una volta in piedi. Ho posato il mio incensiere sul comodino e... ho scelto di camminare attraverso la sabbia del Sanctum...",shape=box,color=blue];
		2160 -> 2161;
		2160 -> 2162;
	2161 [label="Ora capisco perché hai sentito la necessità di questo preambolo.",shape=box,color=red];
		2161 -> 2163;
	2162 [label="Non so cosa dire...",shape=box,color=red];
		2162 -> 2164;
	2163 [label="Sì. Beh. Durante la mia passeggiata... ho capito subito il pericolo oscuro di un momento simile. Che tu potessi... arrivare a considerarlo una responsabilità - arrivare a vedermi come catene che ti appesantiscono.",shape=box,color=blue];
		2163 -> 2165;
	2164 [label="+5 Chemistry",color=orange];
		2164 -> 2166;
	2165 [label="Ti supplico - prego qualsiasi dio o dei in cielo o in terra - di non farlo mai. Questo è un dono che mi hai fatto, e ogni volta nella sua novità lo custodirò gelosamente.",shape=box,color=blue];
		2165 -> 2167;
	2166 [label="Non servono parole, mon miracle... ",shape=box,color=blue];
		2166 -> 2168;
	2167 [label="Giurami, mon miracle - che se dovesse giungere il momento in cui sarò diventato per te una gabbia vuota... sarai libero da me.",shape=box,color=blue];
		2167 -> 2169;
	2168 [label="Durante la mia passeggiata... ho capito subito il pericolo oscuro di un momento simile. Che tu potessi... arrivare a considerarlo una responsabilità - arrivare a vedermi come catene che ti appesantiscono.",shape=box,color=blue];
		2168 -> 2165;
	2169 [label="Non sarò una prigione vuota per coloro che amo. Non per te. Non per Marie.",shape=box,color=blue];
		2169 -> 2170;
		2169 -> 2171;
	2170 [label="[Lascia Lyon.] Non - non posso. Non posso prometterlo, mi dispiace.",shape=box,color=red];
		2170 -> 2172;
	2171 [label="Te lo prometto. ",shape=box,color=red];
		2171 -> 2173;
	2172 [label="+10 Chemistry",color=orange];
		2172 -> 2174;
	2173 [label="+10 Chemistry",color=orange];
		2173 -> 2175;
	2174 [label="Grazie. Grazie, mon miracle, per la tua onestà. Ci è voluto coraggio, in questo momento, e ti ammiro per questo.",shape=box,color=blue];
		2174 -> 2176;
	2175 [label="Grazie. Grazie, mon miracle...",shape=box,color=blue];
		2175 -> 2177;
	2176 [label="Farò tesoro di tutti i momenti che abbiamo trascorso insieme. Con questo, intendo molto più di quanto tu possa immaginare.",shape=box,color=blue];
		2176 -> 2178;
	2177 [label="All'improvviso mi sento così stanco... come se... un grosso peso mi fosse stato tolto dalla spalle. Temo di dovermi sdraiare.",shape=box,color=blue];
		2177 -> 2179;
	2178 [label="Lì ricorderò nella mia anima, anche se svaniranno nella mia mente. Arrivederci.",shape=box,color=blue];
		2178 -> 2180;
	2179 [label="- Lyon",shape=box,color=blue];
		2179 -> 2181;
	2180 [label="Update boolean LyonDating",color=orange];
		2180 -> 2182;
	2181 [label="Update boolean LyonDatingConfession",color=orange];
		2181 -> 2183;
	2182 [label="Update boolean IsDating",color=orange];
		2182 -> 2184;
	2183 [label="Chat ends.",color=orange];
	2184 [label="- Lyon",shape=box,color=blue];
		2184 -> 2185;
	2185 [label="Chat ends.",color=orange];
}