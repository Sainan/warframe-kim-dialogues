digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank5Convo9 begins." [color=orange];
		"LyonRank5Convo9 begins." -> j3594191379;
	j3594191379 [label="Evaluate expressions",color=orange];
		j3594191379 -> "Chat ends." [label="LyonDating & LyonDatingConfession",color=purple];
		j3594191379 -> j179272829 [label="LyonDating",color=purple];
		j3594191379 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j179272829 [label="Mon miracle, io... devo essere assolutamente certo che tu abbia capito qualcosa prima di raccontarti questo mio prossimo aneddoto. ",shape=box,color=blue];
		j179272829 -> j3608122620;
	j3608122620 [label="Per me è importante che tu presti molta attenzione alle prossime mie parole. Hai capito?",shape=box,color=blue];
		j3608122620 -> j2144303048;
		j3608122620 -> j2716290591;
	j2144303048 [label="Mi stai rendendo nervoso. Cosa c'è che non va?",shape=box,color=red];
		j2144303048 -> j2226665756;
	j2716290591 [label="Ci sono. Procedi.",shape=box,color=red];
		j2716290591 -> j4244473794;
	j2226665756 [label="Non c'è niente che non va - anzi, è proprio questo che è fondamentale che tu comprenda - le terribili conseguenze da cui desidero liberarti, qualora tu dessi per scontato che potrebbero derivarne.",shape=box,color=blue];
		j2226665756 -> j2392262792;
		j2226665756 -> j2601451415;
		j2226665756 -> j2704745410;
	j4244473794 [label="+5 Chemistry",color=orange];
		j4244473794 -> j1165219858;
	j2392262792 [label="Sto ascoltando.",shape=box,color=red];
		j2392262792 -> j2015817415;
	j2601451415 [label="Non ha molto senso.",shape=box,color=red];
		j2601451415 -> j3628006722;
	j2704745410 [label="Terribili conseguenze di... cosa?",shape=box,color=red];
		j2704745410 -> j2061305763;
	j1165219858 [label="Grazie. Prima di iniziare, vorrei assicurarti che non c'è nulla che non va - ma è proprio in questo che risiedono forse le terribili conseguenze delle quali vorrei liberarti, qualora tu dessi per scontato che potrebbero derivarne.",shape=box,color=blue];
		j1165219858 -> j2392262792;
		j1165219858 -> j2601451415;
		j1165219858 -> j2704745410;
	j2015817415 [label="+5 Chemistry",color=orange];
		j2015817415 -> j475567938;
	j3628006722 [label="Sì. Ne sono dolorosamente consapevole.",shape=box,color=blue];
		j3628006722 -> j2061305763;
	j2061305763 [label="Permettimi di ricominciare.",shape=box,color=blue];
		j2061305763 -> j475567938;
	j475567938 [label="Sono consapevole che molti potrebbero pensare che io sia, e in effetti potrei benissimo esserlo in realtà... malato. O come minimo, non ho del tutto la mente sana.",shape=box,color=blue];
		j475567938 -> j3997396686;
	j3997396686 [label="Da tempo ho fatto pace con tutto questo. Non mi turba più. Le visioni che mi tormentano - le voci - ho trovato il modo di conviverci senza paura o odio.",shape=box,color=blue];
		j3997396686 -> j2722586421;
	j2722586421 [label="(Ultimamente, penso, un po' per dispetto, se devo essere sincero, ma non è questo il punto.)",shape=box,color=blue];
		j2722586421 -> j251004115;
	j251004115 [label="Ma vorrei che tu capissi che se tu dovessi porre fine a questo tra noi - a questo legame che prima pensavo fosse impossibile tra me e un'altra persona -",shape=box,color=blue];
		j251004115 -> j4120402101;
	j4120402101 [label="Se mai lasciassi che il tuo cuore si allontanasse dal mio? ",shape=box,color=blue];
		j4120402101 -> j3354216504;
	j3354216504 [label="Saprei come resistere, mon miracle.",shape=box,color=blue];
		j3354216504 -> j512641878;
	j512641878 [label="Non mi lascerei consumare da ciò che mi ha tormentato. ",shape=box,color=blue];
		j512641878 -> j2851720794;
	j2851720794 [label="Check boolean LyonAllRight",color=orange];
		j2851720794 -> j3449525741 [label=true,color=green];
		j2851720794 -> j4066736263 [label=false,color=brown];
	j3449525741 [label="Per usare una tua familiare espressione, starò bene. Troverò motivo di sorridere e ridere ancora una volta.",shape=box,color=blue];
		j3449525741 -> j2124336809;
		j3449525741 -> j1018714191;
	j4066736263 [label="Sopravviverei. Starei bene. Troverei motivo di sorridere e ridere ancora una volta.",shape=box,color=blue];
		j4066736263 -> j2124336809;
		j4066736263 -> j1018714191;
	j2124336809 [label="Oh, Lyon... non sei un peso per me.",shape=box,color=red];
		j2124336809 -> j2403915660;
	j1018714191 [label="Mi stai dicendo... che vuoi mettere un punto alla nostra storia?",shape=box,color=red];
		j1018714191 -> j2195700157;
	j2403915660 [label="Sto semplicemente cercando di liberarti da qualsiasi difficoltà tu possa percepire nei miei confronti...",shape=box,color=blue];
		j2403915660 -> j1754297767;
		j2403915660 -> j1731530559;
		j2403915660 -> j1090685052;
	j2195700157 [label="No! Niente del genere! Sto semplicemente cercando di liberarti da qualsiasi difficoltà tu possa percepire nei miei confronti.",shape=box,color=blue];
		j2195700157 -> j1754297767;
		j2195700157 -> j1731530559;
		j2195700157 -> j1090685052;
	j1754297767 [label="Il tuo dolore... rispecchia in parte il mio. Non sarebbe mai un problema aiutarti a superarlo.",shape=box,color=red];
		j1754297767 -> j1055166853;
	j1731530559 [label="Non riesco a descrivere cosa mi attrae di te. Ma non sarai mai un dovere o un peso.",shape=box,color=red];
		j1731530559 -> j1379230536;
	j1090685052 [label="[Lascia Lyon.] Tutto questo sta diventando troppo per me, mi dispiace. Forse è meglio chiuderla qui.",shape=box,color=red];
		j1090685052 -> j467734062;
	j1055166853 [label="Non posso esprimere quanto il mio cuore si spezzi per te. Ma sono eternamente grato che i nostri solitari fantasmi di dolore si siano ritrovati.",shape=box,color=blue];
		j1055166853 -> j2756016421;
	j1379230536 [label="Non riesco a esprimere adeguatamente la mia gratitudine, e credo che le parole non ci riusciranno mai.",shape=box,color=blue];
		j1379230536 -> j2756016421;
	j467734062 [label="Sì. Certo. Sarebbe... ipocrita accettare qualsiasi altra risposta in questo momento... ",shape=box,color=blue];
		j467734062 -> j2191331750;
	j2756016421 [label="Ma ora che mi sono sforzato molto per affrontare quello che è stato uno spettacolarmente autoindulgente preambolo...",shape=box,color=blue];
		j2756016421 -> j3752487590;
		j2756016421 -> j2592938818;
		j2756016421 -> j4170754132;
	j2191331750 [label="Capisco perfettamente. E non ti auguro altro che il meglio. Custodirò gelosamente tutti i momenti che abbiamo trascorso insieme.",shape=box,color=blue];
		j2191331750 -> j1689630923;
	j3752487590 [label="Per uno che ha iniziato con il silenzio, sei diventato veramente prolisso.",shape=box,color=red];
		j3752487590 -> j2370971593;
	j2592938818 [label="L'ho trovato accattivante, non preoccuparti.",shape=box,color=red];
		j2592938818 -> j3622209732;
	j4170754132 [label="Avresti potuto semplicemente dire 'Sai, starò bene se mai dovessimo prendere strade diverse.'",shape=box,color=red];
		j4170754132 -> j3491411706;
	j1689630923 [label="Lì ricorderò nella mia anima, anche se svaniranno nella mia mente. Arrivederci.",shape=box,color=blue];
		j1689630923 -> j3994460333;
	j2370971593 [label="+5 Chemistry",color=orange];
		j2370971593 -> j2604166827;
	j3622209732 [label="+5 Chemistry",color=orange];
		j3622209732 -> j2564383048;
	j3491411706 [label="+5 Chemistry",color=orange];
		j3491411706 -> j898329531;
	j3994460333 [label="Boolean LyonDating is now false.",color=orange];
		j3994460333 -> j4254443866;
	j2604166827 [label="Bah! Se non volevi essere a conoscenza dei meccanismi più intimi della mia mente, non avresti dovuto curiosarci dentro. La colpa è solo tua.",shape=box,color=blue];
		j2604166827 -> j575251818;
	j2564383048 [label="Sono molto contento che apprezzi i miei erratismi. È proprio per questo che scelgo di parlare così poco. Riesci a immaginare cosa significhi supportare tutto questo? Marie mi avrebbe liquidato anni fa come un cane rabbioso.",shape=box,color=blue];
		j2564383048 -> j575251818;
	j898329531 [label="C'è una certa dose di irriverenza e sarcasmo in cui sei naturalmente portato, a cui non potrei mai sperare di arrivare. Lo lascerò per te.",shape=box,color=blue];
		j898329531 -> j575251818;
	j4254443866 [label="Boolean IsDating is now false.",color=orange];
		j4254443866 -> j3311435967;
	j575251818 [label="Tuttavia, tutto questo doveva servire da pretesto per una storia che ora sembrerà piuttosto breve rispetto al resto...",shape=box,color=blue];
		j575251818 -> j4252515940;
	j3311435967 [label="- Lyon",shape=box,color=blue];
		j3311435967 -> "Chat ends.";
	j4252515940 [label="Mi sono svegliato stanotte da un incubo. Quando è successo, delle ombre mi hanno circondato. Niente di estraneo o di nuovo nel mio stato. Incombevano sul mio letto e non volevo disperdersi.",shape=box,color=blue];
		j4252515940 -> j685976048;
	j685976048 [label="Non ero spaventato, perché sapevo che non potevano farmi del male. Tuttavia, non volevano nemmeno sparire dalla mia mente. Solo una persona sarebbe stata in grado di mandarle via.",shape=box,color=blue];
		j685976048 -> j3651739012;
	j3651739012 [label="Mi sono alzato dal letto, mi sono vestito, barcollando, per via della visione offuscata dell'incubo persistente. Ho afferrato il mio incensiere e sono caduto in ginocchio al centro della stanza, preparandomi a... beh. ",shape=box,color=blue];
		j3651739012 -> j64232240;
	j64232240 [label="Mi sono preparato a 'schiarirmi le idee'. Mettiamola così.",shape=box,color=blue];
		j64232240 -> j3623970821;
	j3623970821 [label="Ma con gli occhi chiusi, la mia mente vagava. I miei pensieri andavano alla deriva... verso di te, mon miracle...",shape=box,color=blue];
		j3623970821 -> j2869451249;
	j2869451249 [label="Il suono della tua voce. Il tocco della tua mano sulla mia spalla... ",shape=box,color=blue];
		j2869451249 -> j1678863410;
	j1678863410 [label="E le visioni... fuggirono. Abbandonarono il loro posto, scacciate dal fantasma più forte... te.",shape=box,color=blue];
		j1678863410 -> j3987078510;
	j3987078510 [label="Poi... una volta in piedi. Ho posato il mio incensiere sul comodino e... ho scelto di camminare attraverso la sabbia del Sanctum...",shape=box,color=blue];
		j3987078510 -> j309394538;
		j3987078510 -> j81276877;
	j309394538 [label="Ora capisco perché hai sentito la necessità di questo preambolo.",shape=box,color=red];
		j309394538 -> j3964885830;
	j81276877 [label="Non so cosa dire...",shape=box,color=red];
		j81276877 -> j3984116025;
	j3964885830 [label="Sì. Beh. Durante la mia passeggiata... ho capito subito il pericolo oscuro di un momento simile. Che tu potessi... arrivare a considerarlo una responsabilità - arrivare a vedermi come catene che ti appesantiscono.",shape=box,color=blue];
		j3964885830 -> j3072309622;
	j3984116025 [label="+5 Chemistry",color=orange];
		j3984116025 -> j4181526823;
	j3072309622 [label="Ti supplico - prego qualsiasi dio o dei in cielo o in terra - di non farlo mai. Questo è un dono che mi hai fatto, e ogni volta nella sua novità lo custodirò gelosamente.",shape=box,color=blue];
		j3072309622 -> j3636050671;
	j4181526823 [label="Non servono parole, mon miracle... ",shape=box,color=blue];
		j4181526823 -> j775314867;
	j3636050671 [label="Giurami, mon miracle - che se dovesse giungere il momento in cui sarò diventato per te una gabbia vuota... sarai libero da me.",shape=box,color=blue];
		j3636050671 -> j2189540304;
	j775314867 [label="Durante la mia passeggiata... ho capito subito il pericolo oscuro di un momento simile. Che tu potessi... arrivare a considerarlo una responsabilità - arrivare a vedermi come catene che ti appesantiscono.",shape=box,color=blue];
		j775314867 -> j3072309622;
	j2189540304 [label="Non sarò una prigione vuota per coloro che amo. Non per te. Non per Marie.",shape=box,color=blue];
		j2189540304 -> j1741343424;
		j2189540304 -> j3340941918;
	j1741343424 [label="[Lascia Lyon.] Non - non posso. Non posso prometterlo, mi dispiace.",shape=box,color=red];
		j1741343424 -> j2450019620;
	j3340941918 [label="Te lo prometto. ",shape=box,color=red];
		j3340941918 -> j1274983816;
	j2450019620 [label="+10 Chemistry",color=orange];
		j2450019620 -> j2155185514;
	j1274983816 [label="+10 Chemistry",color=orange];
		j1274983816 -> j401840743;
	j2155185514 [label="Grazie. Grazie, mon miracle, per la tua onestà. Ci è voluto coraggio, in questo momento, e ti ammiro per questo.",shape=box,color=blue];
		j2155185514 -> j1282651163;
	j401840743 [label="Grazie. Grazie, mon miracle...",shape=box,color=blue];
		j401840743 -> j750045339;
	j1282651163 [label="Farò tesoro di tutti i momenti che abbiamo trascorso insieme. Con questo, intendo molto più di quanto tu possa immaginare.",shape=box,color=blue];
		j1282651163 -> j1689630923;
	j750045339 [label="All'improvviso mi sento così stanco... come se... un grosso peso mi fosse stato tolto dalla spalle. Temo di dovermi sdraiare.",shape=box,color=blue];
		j750045339 -> j21916968;
	j21916968 [label="- Lyon",shape=box,color=blue];
		j21916968 -> j3446510588;
	j3446510588 [label="Boolean LyonDatingConfession is now true.",color=orange];
		j3446510588 -> "Chat ends.";
}