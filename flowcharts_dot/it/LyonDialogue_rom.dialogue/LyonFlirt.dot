		"LyonFlirt begins." -> j679331437;
	j3837691326 [label="Lyon? Possiamo parlare? ",shape=box,color=red];
		j3837691326 -> j1727603487;
	j474982833 [label="Lyon? Mi dispiace veramente tanto se quello che ho detto ti ha messo a disagio. Non era mia intenzione.",shape=box,color=red];
		j474982833 -> j2015293418;
	j679331437 [label="[Fine.]",shape=box,color=red];
		j679331437 -> j2883342425;
	j1727603487 [label="Di cosa vorresti discutere, Drifter?",shape=box,color=blue];
		j1727603487 -> j3890994965;
	j2015293418 [label="Immagino che allora mi ritrovo semplicemente a chiedermi: se non stavi flirtando con me me per mettermi a disagio e divertirti... perché lo facevi in primo luogo?",shape=box,color=blue];
		j2015293418 -> j1233296833;
		j2015293418 -> j1000723769;
		j2015293418 -> j476669121;
	j2883342425 [label="Boolean LyonFlirtIgnored is now true.",color=orange];
		j2883342425 -> "Chat ends.";
	j3890994965 [label="Il tuoi commentini sono solo per il tuo proprio divertimento? O preferisci passare ad altri argomenti?",shape=box,color=blue];
		j3890994965 -> j4131285924;
		j3890994965 -> j1156924204;
		j3890994965 -> j476669121;
	j1233296833 [label="Mi interessi, Lyon. Semplice.",shape=box,color=red];
		j1233296833 -> j1806583887;
	j1000723769 [label="Non so cosa mi sia preso, Lyon. Chiaramente è stato tutto un errore. Mi dispiace molto.",shape=box,color=red];
		j1000723769 -> j2450816961;
	j476669121 [label="Io... pensavo veramente quello che detto. Ma capisco che è tutto troppo frettoloso.",shape=box,color=red];
		j476669121 -> j2450816961;
	"Chat ends." [color=orange];
	j4131285924 [label="Non stavo flirtando con te per divertimento, Lyon. Mi dispiace se pensi che fosse questo il motivo.",shape=box,color=red];
		j4131285924 -> j2450816961;
	j1156924204 [label="Non volevo offenderti, stavo solo scherzando. Mi dispiace.",shape=box,color=red];
		j1156924204 -> j2852983198;
	j1806583887 [label="E non è reciproco. Semplice.",shape=box,color=blue];
		j1806583887 -> "Chat ends.";
	j2450816961 [label="Io... Perdonami, Drifter.",shape=box,color=blue];
		j2450816961 -> j2462965545;
	j2852983198 [label="Capisco.",shape=box,color=blue];
		j2852983198 -> "Chat ends.";
	j2462965545 [label="E perdonami ancora una volta per la franchezza quando esprimo tutto ciò che ultimamente mi ha travolto la mente:",shape=box,color=blue];
		j2462965545 -> j126876872;
	j126876872 [label="Ora sono circondato da sconosciuti e bestie parlanti in un mondo di follia fantastica e di massacri apparentemente infiniti e dilaganti.",shape=box,color=blue];
		j126876872 -> j549216511;
	j549216511 [label="Tutto ciò che conoscevo è stato spazzato via dai luminosi raggi della 'Luce di Jade', 'dall'Impero Orokin' e dal 'Void' ed è minacciato dai 'Murmur'.",shape=box,color=blue];
		j549216511 -> j910472228;
	j910472228 [label="Quindi, dovrai scusarmi se trovo questa... offerta di attrazione da parte tua stranamente ridicola nella sua ingenuità. Né ti conosco né mi fido di te. In realtà, tutto ciò che ho a disposizione è la parola degli altri.",shape=box,color=blue];
		j910472228 -> j3570761332;
	j3570761332 [label="Parola di altri che non conosco e di cui non mi fido ancora.",shape=box,color=blue];
		j3570761332 -> j1524153513;
	j1524153513 [label="Tutto questo, mentre le forze esteriori si accumulano davanti a me e Marie - per non parlare di tutto il resto con cui mi confronto che tu non puoi vedere.",shape=box,color=blue];
		j1524153513 -> j3474824322;
	j3474824322 [label="Apprezzo la tua franchezza. So cosa stai cercando di fare e ti lodo per questo. E spero, se un giorno arriverà il momento in cui... riconsidererò la tua offerta, che sia ancora valida.",shape=box,color=blue];
		j3474824322 -> j3174995483;
		j3474824322 -> j2653856982;
		j3474824322 -> j489256756;
	j3174995483 [label="Nessuna promessa, Sacerdote.",shape=box,color=red];
		j3174995483 -> j2448556613;
	j2653856982 [label="Come direbbe un mio caro amico, 'c'ho 'na testa de coccio, amico'.",shape=box,color=red];
		j2653856982 -> j3690429284;
	j489256756 [label="Lo sarà.",shape=box,color=red];
		j489256756 -> j1013011705;
	j2448556613 [label="Certo. Non ce n'era nessuna prevista.",shape=box,color=blue];
		j2448556613 -> j2742418829;
