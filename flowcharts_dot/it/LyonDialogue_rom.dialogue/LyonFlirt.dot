		303 -> 304;
	304 [label="Apprezzo la tua franchezza. So cosa stai cercando di fare e ti lodo per questo. E spero, se un giorno arriverà il momento in cui... riconsidererò la tua offerta, che sia ancora valida.",shape=box,color=blue];
