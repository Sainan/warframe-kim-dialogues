	300 [label="Tutto ciò che conoscevo è stato spazzato via dai luminosi raggi della 'Luce di Jade', 'dall'Impero Orokin' e dal 'Void' ed è minacciato dai 'Murmur'.",shape=box,color=blue];
		300 -> 301;
	301 [label="Quindi, dovrai scusarmi se trovo questa... offerta di attrazione da parte tua stranamente ridicola nella sua ingenuità. Né ti conosco né mi fido di te. In realtà, tutto ciò che ho a disposizione è la parola degli altri.",shape=box,color=blue];
