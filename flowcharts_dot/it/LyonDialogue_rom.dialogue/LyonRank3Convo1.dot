digraph {
	"LyonRank3Convo1 begins." [color=orange];
		"LyonRank3Convo1 begins." -> j960520893;
	j960520893 [label="Saluti, Drifter.",shape=box,color=blue];
		j960520893 -> j2888995670;
	j2888995670 [label="È stato portato alla mia attenzione il tuo desiderio di parlarmi.",shape=box,color=blue];
		j2888995670 -> j1698406668;
		j2888995670 -> j181867524;
		j2888995670 -> j3260059268;
	j1698406668 [label="È un piacere parlarti, Lyon - grazie.",shape=box,color=red];
		j1698406668 -> j1863638516;
	j181867524 [label="Marie ti ha finalmente convinto che non sono un minaccia?",shape=box,color=red];
		j181867524 -> j1034200335;
	j3260059268 [label="Oh! Ciao, Lyon. Sinceramente non avrei mai pensato che riuscisse a convincerti. Sono contento che tu abbia cambiato idea.",shape=box,color=red];
		j3260059268 -> j2053007579;
	j1863638516 [label="Forse alla fine vorrai non essere stato così ansiono di parlarmi, ma va bene. Prego.",shape=box,color=blue];
		j1863638516 -> j1987778821;
		j1863638516 -> j2029359356;
	j1034200335 [label="Non ispirarmi a trovare così in fretta delle ragioni per cambiare rotta.",shape=box,color=blue];
		j1034200335 -> j1933300832;
	j2053007579 [label="Sì, beh. Potresti non esserne così felice alla fine.",shape=box,color=blue];
		j2053007579 -> j1987778821;
		j2053007579 -> j2029359356;
	j1987778821 [label="Ho capito dagli altri che ci sono questioni di cui dovremmo discutere. C'è qualcosa in cui posso aiutarti?",shape=box,color=red];
		j1987778821 -> j17189555;
	j2029359356 [label="C'è qualcosa che non va?",shape=box,color=red];
		j2029359356 -> j4216852023;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j17189555 [label="Forse, con il tempo. Ma abbiamo appena iniziato il nostro interloquio. Sono qui solo per... dirti che ho ceduto all'insistenza di Marie sulla fiducia per la tua persona riguardante queste conversazioni.",shape=box,color=blue];
		j17189555 -> j2777944732;
	j4216852023 [label="Che domanda quasi comicamente insufficiente, a cui non mi abbasserò nemmeno a rispondere, visto che abbiamo appena iniziato il nostro interloquio. Sono qui solo per... dirti che ho ceduto all'insistenza di Marie sulla fiducia per la tua persona riguardante queste conversazioni.",shape=box,color=blue];
		j4216852023 -> j2777944732;
	"Chat ends." [color=orange];
	j2777944732 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j2777944732 -> j513593936 [label="x > 0",color=purple];
		j2777944732 -> j1210828749 [label="x <= 0",color=purple];
		j2777944732 -> j1210828749 [label="false",color=purple];
	j513593936 [label="E visto che ora siamo complici di questa impresa che Roathe è \"intenzionato\" a perseguire? Mi sembra prudente che ci conosciamo a fondo. Questo sembra essere il mezzo che preferisci. Pertanto, eccomi qui.",shape=box,color=blue];
		j513593936 -> j2411551552;
		j513593936 -> j894402894;
	j1210828749 [label="E visto che potremmo o meno essere per sempre complici di questa impresa che Roathe è \"intenzionato\" a perseguire? Mi sembra prudente che ci conosciamo a fondo. Questo è il mezzo che preferisci. Pertanto, eccomi qui.",shape=box,color=blue];
		j1210828749 -> j2411551552;
		j1210828749 -> j894402894;
	j2411551552 [label="In qualche modo, ho la sensazione di aver già iniziato con il piede sbagliato.",shape=box,color=red];
		j2411551552 -> j1244857890;
	j894402894 [label="C'è... un altro modo che preferiresti?",shape=box,color=red];
		j894402894 -> j839021878;
	j1244857890 [label="No, non l'hai fatto. Semplicemente, non sono probabilmente il tipo di persona con cui sei abituato a conversare. Per questo, finora sei stato fortunato, anche se i lunatici del mio calibro sono rari.",shape=box,color=blue];
		j1244857890 -> j3768847924;
	j839021878 [label="No. È accettabile. Anzi, mi dà il tempo di modellare i miei pensieri come vorrei. Capisco perché questo dispositivo ha il suo fascino.",shape=box,color=blue];
		j839021878 -> j2460359167;
	j3768847924 [label="Sto divagando. Temo di non essere qui per passare molto tempo a \"digitare\", il che senza dubbio ti deluderà. Volevo solo informarti della mia resa.",shape=box,color=blue];
		j3768847924 -> j811784474;
		j3768847924 -> j3296572056;
	j2460359167 [label="Tuttavia, temo di non essere qui per passare molto tempo a \"digitare\", il che senza dubbio ti deluderà. Volevo solo informarti della mia resa.",shape=box,color=blue];
		j2460359167 -> j3296572056;
		j2460359167 -> j811784474;
	j811784474 [label="Marie è più pericolosa di quanto sembri, non è vero?",shape=box,color=red];
		j811784474 -> j2472789375;
	j3296572056 [label="Ancora una volta, dirò semplicemente grazie.",shape=box,color=red];
		j3296572056 -> j1825018067;
	j2472789375 [label="+20 Chemistry",color=orange];
		j2472789375 -> j1211823689;
	j1825018067 [label="+15 Chemistry",color=orange];
		j1825018067 -> j1190336553;
	j1211823689 [label="Hai appena iniziato a sospettare quanto siano profonde quelle acque.",shape=box,color=blue];
		j1211823689 -> j2895678923;
	j1190336553 [label="È stato, per... tutto quel che vale, un piacere.",shape=box,color=blue];
		j1190336553 -> j2895678923;
	j2895678923 [label="-P. Lyon Allard",shape=box,color=blue];
		j2895678923 -> "Chat ends.";
}