digraph {
	0 [label="LyonRank3Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Saluti, Drifter.",shape=box,color=blue];
		1 -> 2;
	2 [label="È stato portato alla mia attenzione il tuo desiderio di parlarmi.",shape=box,color=blue];
		2 -> 3;
		2 -> 4;
		2 -> 5;
	3 [label="È un piacere parlarti, Lyon - grazie.",shape=box,color=red];
		3 -> 6;
	4 [label="Marie ti ha finalmente convinto che non sono un minaccia?",shape=box,color=red];
		4 -> 7;
	5 [label="Oh! Ciao, Lyon. Sinceramente non avrei mai pensato che riuscisse a convincerti. Sono contento che tu abbia cambiato idea.",shape=box,color=red];
		5 -> 8;
	6 [label="Forse alla fine vorrai non essere stato così ansiono di parlarmi, ma va bene. Prego.",shape=box,color=blue];
		6 -> 9;
		6 -> 10;
	7 [label="Non ispirarmi a trovare così in fretta delle ragioni per cambiare rotta.",shape=box,color=blue];
		7 -> 11;
	8 [label="Sì, beh. Potresti non esserne così felice alla fine.",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
	9 [label="Ho capito dagli altri che ci sono questioni di cui dovremmo discutere. C'è qualcosa in cui posso aiutarti?",shape=box,color=red];
		9 -> 12;
	10 [label="C'è qualcosa che non va?",shape=box,color=red];
		10 -> 13;
	11 [label="+10 Chemistry",color=orange];
		11 -> 14;
	12 [label="Forse, con il tempo. Ma abbiamo appena iniziato il nostro interloquio. Sono qui solo per... dirti che ho ceduto all'insistenza di Marie sulla fiducia per la tua persona riguardante queste conversazioni.",shape=box,color=blue];
		12 -> 15;
	13 [label="Che domanda quasi comicamente insufficiente, a cui non mi abbasserò nemmeno a rispondere, visto che abbiamo appena iniziato il nostro interloquio. Sono qui solo per... dirti che ho ceduto all'insistenza di Marie sulla fiducia per la tua persona riguardante queste conversazioni.",shape=box,color=blue];
		13 -> 15;
	14 [label="Chat ends.",color=orange];
	15 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		15 -> 16 [label="x > 0",color=purple];
		15 -> 17 [label="x <= 0",color=purple];
		15 -> 17 [label="false",color=purple];
	16 [label="E visto che ora siamo complici di questa impresa che Roathe è \"intenzionato\" a perseguire? Mi sembra prudente che ci conosciamo a fondo. Questo sembra essere il mezzo che preferisci. Pertanto, eccomi qui.",shape=box,color=blue];
		16 -> 18;
		16 -> 19;
	17 [label="E visto che potremmo o meno essere per sempre complici di questa impresa che Roathe è \"intenzionato\" a perseguire? Mi sembra prudente che ci conosciamo a fondo. Questo è il mezzo che preferisci. Pertanto, eccomi qui.",shape=box,color=blue];
		17 -> 18;
		17 -> 19;
	18 [label="In qualche modo, ho la sensazione di aver già iniziato con il piede sbagliato.",shape=box,color=red];
		18 -> 20;
	19 [label="C'è... un altro modo che preferiresti?",shape=box,color=red];
		19 -> 21;
	20 [label="No, non l'hai fatto. Semplicemente, non sono probabilmente il tipo di persona con cui sei abituato a conversare. Per questo, finora sei stato fortunato, anche se i lunatici del mio calibro sono rari.",shape=box,color=blue];
		20 -> 22;
	21 [label="No. È accettabile. Anzi, mi dà il tempo di modellare i miei pensieri come vorrei. Capisco perché questo dispositivo ha il suo fascino.",shape=box,color=blue];
		21 -> 23;
	22 [label="Sto divagando. Temo di non essere qui per passare molto tempo a \"digitare\", il che senza dubbio ti deluderà. Volevo solo informarti della mia resa.",shape=box,color=blue];
		22 -> 24;
		22 -> 25;
	23 [label="Tuttavia, temo di non essere qui per passare molto tempo a \"digitare\", il che senza dubbio ti deluderà. Volevo solo informarti della mia resa.",shape=box,color=blue];
		23 -> 25;
		23 -> 24;
	24 [label="Marie è più pericolosa di quanto sembri, non è vero?",shape=box,color=red];
		24 -> 26;
	25 [label="Ancora una volta, dirò semplicemente grazie.",shape=box,color=red];
		25 -> 27;
	26 [label="+20 Chemistry",color=orange];
		26 -> 28;
	27 [label="+15 Chemistry",color=orange];
		27 -> 29;
	28 [label="Hai appena iniziato a sospettare quanto siano profonde quelle acque.",shape=box,color=blue];
		28 -> 30;
	29 [label="È stato, per... tutto quel che vale, un piacere.",shape=box,color=blue];
		29 -> 30;
	30 [label="-P. Lyon Allard",shape=box,color=blue];
		30 -> 31;
	31 [label="Chat ends.",color=orange];
}