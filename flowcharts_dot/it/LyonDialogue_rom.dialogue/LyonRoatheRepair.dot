	2295 [label="Non voglio perdere più tempo di quello che ho già perso ascoltando le sue argomentazioni. Dirò semplicemente, bene, molto bene.",shape=box,color=blue];
		2295 -> 2298;
	2296 [label="Il problema, correggimi se sbaglio, era che non volevi approfondire sul mio passato. Ora sembra che tu abbia cambiato idea?",shape=box,color=blue];
