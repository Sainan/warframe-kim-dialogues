		j326303177 -> j3046834331;
	"Chat ends." [color=orange];
	j813168578 [label="Ti rendi conto di quanto possa sembrare ridicolo?",shape=box,color=blue];
		j813168578 -> j926428125;
		j813168578 -> j3397866747;
	j464837026 [label="Non voglio perdere più tempo di quello che ho già perso ascoltando le sue argomentazioni. Dirò semplicemente, bene, molto bene.",shape=box,color=blue];
		j464837026 -> j2169173578;
	j3046834331 [label="Il problema, correggimi se sbaglio, era che non volevi approfondire sul mio passato. Ora sembra che tu abbia cambiato idea?",shape=box,color=blue];
		j3046834331 -> j1527794051;
	j926428125 [label="Non sapevo che avesse intenzione di dirti che mi sarei scusato.",shape=box,color=red];
		j926428125 -> j2852983198;
	j3397866747 [label="Non sapevo cos'altro fare. So che, a pensarci bene, è ridicolo.",shape=box,color=red];
		j3397866747 -> j4050075804;
	j2169173578 [label="Check boolean MarieFamilyFail",color=orange];
		j2169173578 -> j3236228035 [label=true,color=green];
		j2169173578 -> j2227426651 [label=false,color=brown];
	j1527794051 [label="Non capisco. Non possiamo tornare indietro. Quelle acque non possono essere riattraversate.",shape=box,color=blue];
		j1527794051 -> j2419070764;
		j1527794051 -> j730560213;
	j2852983198 [label="Capisco.",shape=box,color=blue];
		j2852983198 -> "Chat ends.";
	j4050075804 [label="La natura comica della cosa, lo ammetto, è parte di ciò che mi ha spinto a indagare. Sei così sconvolto? Non riesco a immaginare che la mancanza della mia compagnia nella tua vita sia una cosa così terribile.",shape=box,color=blue];
		j4050075804 -> j3609722567;
	j3236228035 [label="Avrai il mio aiuto come richiesto. Mi dispiace per quello che il tuo demone d'attacco farà a Marie.",shape=box,color=blue];
		j3236228035 -> j92487004;
	j2227426651 [label="Avrai il mio aiuto come richiesto. Ora, per cortesia, richiama il tuo diavolo.",shape=box,color=blue];
		j2227426651 -> j770168571;
	j2419070764 [label="Oh. Beh, allora è stata una grande perdita di tempo, no?",shape=box,color=red];
		j2419070764 -> "Chat ends.";
	j730560213 [label="Immagino che... allora ti chiederò semplicemente scusa. Per non averti ascoltato.",shape=box,color=red];
		j730560213 -> j1631261581;
	j3609722567 [label="Sì, Lyon. Ci tengo a te. Immensamente. E so di aver sbagliato.",shape=box,color=red];
		j3609722567 -> j112553289;
	j92487004 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j92487004 -> j547953661;
	j770168571 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j770168571 -> j3711686580;
	j1631261581 [label="Posso chiederti perché non l'hai fatto? Avevi paura dell'argomento? Ti annoiava, forse? O pensavi di non essere abbastanza forte per affrontarlo?",shape=box,color=blue];
		j1631261581 -> j2851876658;
		j1631261581 -> j3295257139;
		j1631261581 -> j2506155406;
	j112553289 [label="E mi dispiace davvero tanto.",shape=box,color=red];
		j112553289 -> j1502797561;
	j547953661 [label="Boolean LyonFamilyFail is now false.",color=orange];
		j547953661 -> "Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j3711686580 [label="Boolean LyonFamilyFail is now false.",color=orange];
		j3711686580 -> "Chat ends.";
	j2851876658 [label="Ne avevo paura.",shape=box,color=red];
		j2851876658 -> j3059771654;
	j3295257139 [label="Non pensavo di essere abbastanza forte per affrontarlo.",shape=box,color=red];
		j3295257139 -> j3059771654;
	j2506155406 [label="All'epoca non me ne importava. Ma ora sì.",shape=box,color=red];
		j2506155406 -> j657664284;
	j1502797561 [label="Non sapevo cos'altro fare se non chiedere aiuto a Roathe.",shape=box,color=red];
		j1502797561 -> j3451782485;
	"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
	j3059771654 [label="Allora non ho altra scelta che perdonarti. ",shape=box,color=blue];
		j3059771654 -> j106665696;
	j657664284 [label="E cosa è cambiato che ti ha fatto interessare così all'improvviso quando prima non te ne importava?",shape=box,color=blue];
		j657664284 -> j4189535569;
		j657664284 -> j4101472983;
	j3451782485 [label="Evaluate expressions",color=orange];
		j3451782485 -> j2592366787 [label="MarieDating",color=purple];
		j3451782485 -> j32853939 [label="RoatheDating",color=purple];
		j3451782485 -> j1806919145 [label="false",color=purple];
	j106665696 [label="Boolean LyonConfessionFail is now false.",color=orange];
		j106665696 -> "Chat ends.";
	j4189535569 [label="Ho cambiato idea su di te.",shape=box,color=red];
		j4189535569 -> j3059771654;
	j4101472983 [label="Ho la sensazione che ascoltare le tue storie possa sbloccare alcuni progressi.",shape=box,color=red];
		j4101472983 -> j3074362052;
	j2592366787 [label="Sebbene io... sia commosso e... le abitudini di questo futuro non mi siano familiari, non dubito della sincerità delle tue parole. Tuttavia, temo di dover rifiutare.",shape=box,color=blue];
		j2592366787 -> j1596556477;
	j32853939 [label="Sebbene io... sia commosso e... le abitudini di questo futuro non mi siano familiari, non dubito della sincerità delle tue parole. Tuttavia, temo di dover rifiutare.",shape=box,color=blue];
		j32853939 -> j102388169;
	j1806919145 [label="Non mi resta altra scelta se non quella di perdonarti, ovviamente. Non capisco perché continui a volere che una cosa così rotta come me invada i tuoi spazi.",shape=box,color=blue];
		j1806919145 -> j1112745369;
	j3074362052 [label="Un mezzo per raggiungere un fine.",shape=box,color=blue];
		j3074362052 -> "Chat ends.";
	j1596556477 [label="Dato che al momento sei impegnato con Marie. Lei mi è veramente troppo cara anche solo per pensare che il mio rapporto con te possa distogliere l'attenzione dal suo, o disturbarlo in qualche modo.",shape=box,color=blue];
		j1596556477 -> j2451264377;
	j102388169 [label="Dato che al momento sei... impegnato con Roathe. Non voglio nemmeno immaginare il tipo di complicazioni che un simile coinvolgimento potrebbe causare.",shape=box,color=blue];
		j102388169 -> j4066428868;
	j1112745369 [label="Ma mi accorgo che il mio fastidio per le tue parole svanisce ora che so fino a che punto sei disposto a spingerti per avermi al tuo fianco.",shape=box,color=blue];
		j1112745369 -> j2398113586;
	j2451264377 [label="Forse sono un po' antiquato in questo senso. Lei è come fosse un membro della mia famiglia, e siamo troppo uniti. Sono una reliquia ambulante. Per questo, devi perdonarmi.",shape=box,color=blue];
		j2451264377 -> j3311435967;
	j4066428868 [label="Temo che la mia mente sia già abbastanza complicata da pensare a te e a lui, un uomo che conosco così bene, insieme. Forse sono antiquato in questo senso. Sono una reliquia ambulante, a quanto pare. Per questo, devi perdonarmi.",shape=box,color=blue];
		j4066428868 -> j3311435967;
