		2985 -> 2995;
	2988 [label="Ma poi mi ricordo di tutti i bambini che non ce l'hanno fatta, e hanno lasciato i loro genitori ad ammuffire nelle gabbie per tutto il tempo necessario affinché venissero salvati. Guardando mentre si fanno a pezzi come animali feroci e pazzi. Non so quale sia la cosa peggiore.",shape=box,color=red];
