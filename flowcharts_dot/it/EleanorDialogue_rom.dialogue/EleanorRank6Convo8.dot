	3216 [label="Sono un campo minato?",shape=box,color=blue];
		3216 -> 3217;
	3217 [label="Perché Kaya dice che lo sono. E ho avuto uno di quei momenti \"oh merda\" in cui ripensi a tutte le conversazioni che hai avuto con qualcuno e all'improvviso ti vedi sotto una luce nuova.",shape=box,color=blue];
		3217 -> 3218;
		3217 -> 3219;
		3217 -> 3220;
	3218 [label="No, non lo sei.",shape=box,color=red];
		3218 -> 3221;
	3219 [label="Credo di aver capito cosa intendeva dire. Scusa, ma ha ragione.",shape=box,color=red];
		3219 -> 3222;
	3220 [label="Aspetta, Kaya ha detto questo?",shape=box,color=red];
		3220 -> 3223;
	3221 [label="+5 Chemistry",color=orange];
		3221 -> 3224;
	3222 [label="oh.",shape=box,color=blue];
		3222 -> 3225;
		3222 -> 3226;
	3223 [label="Sì. L'ha detto così per caso nel bel mezzo di una chiacchierata che stavamo facendo. \"Sei forte, ma sei un campo minato. Non so mai come reagirai a qualcosa”.",shape=box,color=blue];
		3223 -> 3218;
		3223 -> 3219;
	3224 [label="Sono felice di sentirlo. Grazie.",shape=box,color=blue];
		3224 -> 3227;
	3225 [label="Sono contento che Kaya te lo abbia detto. Ho scritto delle cose che pensavo fossero innocue e tu hai reagito come se ti avessi dato fuoco ai capelli.",shape=box,color=red];
		3225 -> 3228;
		3225 -> 3229;
	3226 [label="A volte hai delle reazioni davvero estreme. Sono sproporzionate rispetto a quello che ti dico.",shape=box,color=red];
		3226 -> 3229;
		3226 -> 3228;
	3227 [label="Adolescenti, eh? ",shape=box,color=blue];
		3227 -> 3230;
	3228 [label="È come se passassi direttamente alla peggiore interpretazione possibile di ciò che avrei potuto intendere.",shape=box,color=red];
		3228 -> 3231;
	3229 [label="A volte interrompi del tutto la conversazione e non ho nemmeno la possibilità di spiegarmi.",shape=box,color=red];
		3229 -> 3231;
	3230 [label="Chat ends.",color=orange];
	3231 [label="Beh.",shape=box,color=blue];
		3231 -> 3232;
	3232 [label="In questo momento ho davvero voglia di disconnettermi e non usare mai più KIM.",shape=box,color=blue];
		3232 -> 3233;
		3232 -> 3234;
	3233 [label="Forse dovresti riflettere su quello che hai appena detto?",shape=box,color=red];
		3233 -> 3235;
	3234 [label="Ecco fatto. Boom. Campo minato.",shape=box,color=red];
		3234 -> 3236;
		3234 -> 3235;
	3235 [label="Non lo vedi da sola?",shape=box,color=red];
		3235 -> 3237;
	3236 [label="Penso che tu abbia bisogno di un po' di tempo per pensarci. [Fine.]",shape=box,color=red];
		3236 -> 3238;
	3237 [label="Va bene. Va bene. Ascoltami.",shape=box,color=blue];
		3237 -> 3239;
	3238 [label="Chat ends.",color=orange];
	3239 [label="Per favore.",shape=box,color=blue];
		3239 -> 3240;
	3240 [label="Quindi tieni presente questo:",shape=box,color=blue];
		3240 -> 3241;
	3241 [label="Sono telepatica. Non l'ho chiesto io. Ma lo sono. Riesco a percepire i pensieri.",shape=box,color=blue];
		3241 -> 3242;
	3242 [label="Se parliamo faccia a faccia, ho tutti i tipi di indizi che mi dicono cosa stai provando",shape=box,color=blue];
		3242 -> 3243;
	3243 [label="l'espressione, il linguaggio del corpo e, a volte, un vero e proprio PENSIERO, perché, come ho detto, sono TELEPATICA",shape=box,color=blue];
		3243 -> 3244;
	3244 [label="ma qui su KIM devo tirare a indovinare e non ci sono indizi",shape=box,color=blue];
