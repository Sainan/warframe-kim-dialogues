	3249 [label="(respira profondamente, siediti dritta, ricomponiti, Eleanor)",shape=box,color=blue];
		3249 -> 3250;
	3250 [label="Farò del mio meglio per non essere un campo minato in futuro.",shape=box,color=blue];
