digraph {
	3207 [label="EleanorRank6Convo8 begins.",color=orange];
		3207 -> 3208;
	3208 [label="Hai un momento? Sono un po' arrabbiata riguardo una cosa e mi farebbe comodo un orecchio amico. O magari di una bella sgridata. Non ne sono ancora sicura.",shape=box,color=blue];
