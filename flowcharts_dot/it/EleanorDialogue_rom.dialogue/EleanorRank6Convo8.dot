	edge [fontname="Roboto Condensed"];

	"EleanorRank6Convo8 begins." [color=orange];
		"EleanorRank6Convo8 begins." -> j3955422876;
	j3955422876 [label="Hai un momento? Sono un po' arrabbiata riguardo una cosa e mi farebbe comodo un orecchio amico. O magari di una bella sgridata. Non ne sono ancora sicura.",shape=box,color=blue];
		j3955422876 -> j754387616;
	j754387616 [label="Check boolean EleanorDating",color=orange];
		j754387616 -> j1569797697 [label=true,color=green];
		j754387616 -> j951339527 [label=true,color=green];
		j754387616 -> j2252023977 [label=true,color=green];
		j754387616 -> j951339527 [label=false,color=brown];
		j754387616 -> j1569797697 [label=false,color=brown];
	j1569797697 [label="Non ora, mi dispiace. [Fine.]",shape=box,color=red];
		j1569797697 -> "Chat ends.";
	j951339527 [label="Certo.",shape=box,color=red];
		j951339527 -> j2669833843;
	j2252023977 [label="Per te, sempre.",shape=box,color=red];
		j2252023977 -> j2721001909;
	"Chat ends." [color=orange];
	j2669833843 [label="Grazie, amico.",shape=box,color=blue];
		j2669833843 -> j1599349741;
	j2721001909 [label="Grazie, amore.",shape=box,color=blue];
		j2721001909 -> j1599349741;
	j1599349741 [label="Sono un campo minato?",shape=box,color=blue];
		j1599349741 -> j2464717467;
	j2464717467 [label="Perché Kaya dice che lo sono. E ho avuto uno di quei momenti \"oh merda\" in cui ripensi a tutte le conversazioni che hai avuto con qualcuno e all'improvviso ti vedi sotto una luce nuova.",shape=box,color=blue];
		j2464717467 -> j2019794905;
		j2464717467 -> j370285632;
		j2464717467 -> j2319643017;
	j2019794905 [label="No, non lo sei.",shape=box,color=red];
		j2019794905 -> j3119468997;
	j370285632 [label="Credo di aver capito cosa intendeva dire. Scusa, ma ha ragione.",shape=box,color=red];
		j370285632 -> j2700699045;
	j2319643017 [label="Aspetta, Kaya ha detto questo?",shape=box,color=red];
		j2319643017 -> j3069349509;
	j3119468997 [label="+5 Chemistry",color=orange];
		j3119468997 -> j2668672023;
	j2700699045 [label="oh.",shape=box,color=blue];
		j2700699045 -> j887993797;
		j2700699045 -> j4053381517;
	j3069349509 [label="Sì. L'ha detto così per caso nel bel mezzo di una chiacchierata che stavamo facendo. \"Sei forte, ma sei un campo minato. Non so mai come reagirai a qualcosa”.",shape=box,color=blue];
		j3069349509 -> j2019794905;
		j3069349509 -> j370285632;
	j2668672023 [label="Sono felice di sentirlo. Grazie.",shape=box,color=blue];
		j2668672023 -> j2733978640;
	j887993797 [label="Sono contento che Kaya te lo abbia detto. Ho scritto delle cose che pensavo fossero innocue e tu hai reagito come se ti avessi dato fuoco ai capelli.",shape=box,color=red];
		j887993797 -> j764019579;
		j887993797 -> j3733929357;
	j4053381517 [label="A volte hai delle reazioni davvero estreme. Sono sproporzionate rispetto a quello che ti dico.",shape=box,color=red];
		j4053381517 -> j3733929357;
		j4053381517 -> j764019579;
	j2733978640 [label="Adolescenti, eh? ",shape=box,color=blue];
		j2733978640 -> "Chat ends.";
	j764019579 [label="È come se passassi direttamente alla peggiore interpretazione possibile di ciò che avrei potuto intendere.",shape=box,color=red];
		j764019579 -> j3246093422;
	j3733929357 [label="A volte interrompi del tutto la conversazione e non ho nemmeno la possibilità di spiegarmi.",shape=box,color=red];
		j3733929357 -> j3246093422;
	j3246093422 [label="Beh.",shape=box,color=blue];
		j3246093422 -> j2286845602;
	j2286845602 [label="In questo momento ho davvero voglia di disconnettermi e non usare mai più KIM.",shape=box,color=blue];
		j2286845602 -> j3057470541;
		j2286845602 -> j2102560169;
	j3057470541 [label="Forse dovresti riflettere su quello che hai appena detto?",shape=box,color=red];
		j3057470541 -> j4166517461;
	j2102560169 [label="Ecco fatto. Boom. Campo minato.",shape=box,color=red];
		j2102560169 -> j3838069805;
		j2102560169 -> j4166517461;
	j4166517461 [label="Non lo vedi da sola?",shape=box,color=red];
		j4166517461 -> j3739652568;
	j3838069805 [label="Penso che tu abbia bisogno di un po' di tempo per pensarci. [Fine.]",shape=box,color=red];
		j3838069805 -> "Chat ends.";
	j3739652568 [label="Va bene. Va bene. Ascoltami.",shape=box,color=blue];
		j3739652568 -> j2986324520;
	j2986324520 [label="Per favore.",shape=box,color=blue];
		j2986324520 -> j332900981;
	j332900981 [label="Quindi tieni presente questo:",shape=box,color=blue];
		j332900981 -> j2513310461;
	j2513310461 [label="Sono telepatica. Non l'ho chiesto io. Ma lo sono. Riesco a percepire i pensieri.",shape=box,color=blue];
		j2513310461 -> j1556327660;
	j1556327660 [label="Se parliamo faccia a faccia, ho tutti i tipi di indizi che mi dicono cosa stai provando",shape=box,color=blue];
		j1556327660 -> j2227272105;
	j2227272105 [label="l'espressione, il linguaggio del corpo e, a volte, un vero e proprio PENSIERO, perché, come ho detto, sono TELEPATICA",shape=box,color=blue];
		j2227272105 -> j170267053;
	j170267053 [label="ma qui su KIM devo tirare a indovinare e non ci sono indizi",shape=box,color=blue];
		j170267053 -> j1501938592;
	j1501938592 [label="quindi sì, a volte mi capita di reagire impulsivamente.",shape=box,color=blue];
		j1501938592 -> j754213903;
		j1501938592 -> j82635399;
	j754213903 [label="Ma va.",shape=box,color=red];
		j754213903 -> j2630648431;
	j82635399 [label="Sì, lo fai.",shape=box,color=red];
		j82635399 -> j2630648431;
	j2630648431 [label="Giusto. Quindi.",shape=box,color=blue];
		j2630648431 -> j576115700;
	j576115700 [label="(respira profondamente, siediti dritta, ricomponiti, Eleanor)",shape=box,color=blue];
		j576115700 -> j398707915;
	j398707915 [label="Farò del mio meglio per non essere un campo minato in futuro.",shape=box,color=blue];
		j398707915 -> j4286345705;
	j4286345705 [label="E darò un'occhiata alle nostre vecchie conversazioni per rifletterci a lungo.",shape=box,color=blue];
		j4286345705 -> j3323334747;
	j3323334747 [label="Te lo devo. Perché, campo minato o no, sei ancora qui. Hai continuato a camminarci sopra. x",shape=box,color=blue];
		j3323334747 -> j4122200191;
	j4122200191 [label="Boolean EleanorNoDate is now false.",color=orange];
		j4122200191 -> "Chat ends.";
}