digraph {
	2175 [label="EleanorRank5Convo2 begins.",color=orange];
		2175 -> 2176;
	2176 [label="Ok. Sono calma e pronta come non mai.",shape=box,color=blue];
		2176 -> 2177;
	2177 [label="Posso parlarti di Christopher?",shape=box,color=blue];
		2177 -> 2178;
	2178 [label="Check boolean EleanorChristopher1",color=orange];
		2178 -> 2184 [label=true,color=green];
		2178 -> 2180 [label=true,color=green];
		2178 -> 2185 [label=true,color=green];
		2178 -> 2179 [label=false,color=brown];
		2178 -> 2185 [label=false,color=brown];
	2184 [label="Sto ascoltando.",shape=box,color=red];
		2184 -> 2186;
	2180 [label="Perché è qualcuno di cui ho bisogno di sapere?",shape=box,color=red];
		2180 -> 2187;
	2185 [label="[Ignora.]",shape=box,color=red];
		2185 -> 2181;
	2179 [label="Chi è Christopher?",shape=box,color=red];
		2179 -> 2182;
	2186 [label="Grazie.",shape=box,color=blue];
		2186 -> 2188;
	2187 [label="Perché è una persona che non c'è più. Una persona che mi era molto cara.",shape=box,color=blue];
		2187 -> 2188;
	2181 [label="Chat ends.",color=orange];
	2182 [label="Il migliore amico di Arthur. Eravamo fidanzati. Pensavo di essere innamorata di lui.",shape=box,color=blue];
		2182 -> 2183;
	2188 [label="Check boolean EleanorDating",color=orange];
		2188 -> 2189 [label=true,color=green];
		2188 -> 2190 [label=false,color=brown];
	2183 [label="Update boolean EleanorChristopher1",color=orange];
		2183 -> 2184;
		2183 -> 2180;
	2189 [label="Dal momento che tu ed io ora siamo molto più uniti (in tanti modi molto piacevoli), dovresti sapere bene con chi hai a che fare.",shape=box,color=blue];
		2189 -> 2191;
	2190 [label="Correggimi se sbaglio, ma ultimamente ho la sensazione che io e te siamo più che semplici compagni di squadra.",shape=box,color=blue];
		2190 -> 2193;
	2191 [label="Io ho visto dentro la tua testa, ma tu non hai visto dentro la mia.",shape=box,color=blue];
		2191 -> 2192;
	2193 [label="Check boolean EleanorConfession",color=orange];
		2193 -> 2194 [label=true,color=green];
		2193 -> 2195 [label=false,color=brown];
	2192 [label="Quindi, tieniti forte e abbi pazienza.",shape=box,color=blue];
		2192 -> 2197;
	2194 [label="Mi hai espresso in modo molto chiaro i tuoi sentimenti e lo apprezzo.",shape=box,color=blue];
		2194 -> 2196;
	2195 [label="Siamo sicuramente amici. Forse anche qualcosa di più. Ma continuiamo a girarci attorno aspettando che l'altro faccia la prima mossa.",shape=box,color=blue];
		2195 -> 2196;
	2197 [label="Voglio parlarti di Christopher perché penso che meriti di saperlo.",shape=box,color=blue];
		2197 -> 2198;
		2197 -> 2199;
	2196 [label="Mi piaci, molto. Mi fido di te. Hai avuto un sacco di occasioni per trattarmi come un mostro, come fa Lettie, ma non l'hai fatto. Non pensare che non me ne sia accorta.",shape=box,color=blue];
		2196 -> 2197;
	2198 [label="Fai pure.",shape=box,color=red];
		2198 -> 2202;
	2199 [label="Adesso non ho tempo, scusa. [Fine]",shape=box,color=red];
		2199 -> 2200;
	2202 [label="Era più grande di Arthur e me di qualche anno. Non ricordo un periodo in cui non ci fosse. I nostri genitori erano amici, quindi era sempre lì.",shape=box,color=blue];
		2202 -> 2203;
	2200 [label="C'è un momento per abbandonare una conversazione con un amico. Questo non era quel il momento.",shape=box,color=blue];
		2200 -> 2201;
	2203 [label="Giocava ai soldatini con Arthur nelle zone boschive dietro la tenuta. Christopher era il comandante, Arthur il fedele tenente. Se mai mi avessero lasciata giocare, avrei dovuto fare l'infermiera. Ovviamente.",shape=box,color=blue];
		2203 -> 2204;
	2201 [label="Chat ends.",color=orange];
	2204 [label="Avrei voluto che papà guardasse Arthur lanciarsi su un'altra granata pigna, morendo coraggiosamente per salvare il suo comandante, e pensasse \"hmmm, mio figlio si sta affezionando un po' troppo a questa storia dell'esercito, forse dovrei dirgli che farsi sparare non è poi così divertente come pensa\".",shape=box,color=blue];
		2204 -> 2205;
		2204 -> 2206;
		2204 -> 2207;
	2205 [label="Credi che Arthur avrebbe ascoltato se l'avesse fatto?",shape=box,color=red];
		2205 -> 2210;
	2206 [label="Penso che tutto sommato sia andato tutto bene.",shape=box,color=red];
		2206 -> 2209;
	2207 [label="Ma se Arthur avesse ascoltato, non ci saremmo mai incontrati. :)",shape=box,color=red];
		2207 -> 2208;
	2210 [label="Probabilmente no. L'avrebbe semplicemente visto come una prova di papà.",shape=box,color=blue];
		2210 -> 2216;
	2209 [label="Per certi aspetti sì.",shape=box,color=blue];
		2209 -> 2211;
	2208 [label="Sì, il fatto che le nostre strade si siano incrociate è stata una benedizione rara nella mia vita.",shape=box,color=blue];
		2208 -> 2212;
	2216 [label="Comunque. Passarono le estati una dopo l'altra. Diventammo adolescenti. Era tutto molto imbarazzante, puzzolente e ormonale. C'erano feste ed esami. Christopher andò all'università. Il cane morì, ne prendemmo uno nuovo. Inserire qui un montaggio. ",shape=box,color=blue];
		2216 -> 2217;
	2211 [label="Ma quello che cercavo di raccontarti è un lutto.",shape=box,color=blue];
		2211 -> 2215;
	2212 [label="Ma lasciami dire che avrei preferito che il prezzo non fosse stato così alto.",shape=box,color=blue];
		2212 -> 2213;
	2217 [label="Un giorno, all'improvviso, entrai in cucina, vidi questo splendido giovane in uniforme davanti a me e pensai 'phwoar' per la seconda volta nella mia vita.",shape=box,color=blue];
		2217 -> 2218;
		2217 -> 2219;
	2215 [label="Non è proprio il momento di cercare il lato positivo.",shape=box,color=blue];
		2215 -> 2216;
	2213 [label="Soprattutto perché non ti ho ancora detto quanto sono profonde le ferite.",shape=box,color=blue];
		2213 -> 2214;
	2218 [label="Scusa, cos'era quel suono? Mi è sfuggito. :P",shape=box,color=red];
		2218 -> 2220;
	2219 [label="Chi è stato il primo? ",shape=box,color=red];
		2219 -> 2222;
	2214 [label="Chat ends.",color=orange];
	2220 [label="'Pwhoar'?",shape=box,color=blue];
		2220 -> 2221;
	2222 [label="Mandy Jellicoe. La mia cotta. Aveva abbandonato la scuola, si era tinta i capelli, si era fatta i piercing, girava per la città con una giacca di pelle fumando sigarette e lanciando occhiate a chiunque si avvicinasse troppo. La guardavo e sentivo le mie ossa sciogliersi.",shape=box,color=blue];
		2222 -> 2223;
	2221 [label="È una tradizionale espressione di ammirazione Britannica. Dovrebbe essere pronunciata con una sorta di ringhio basso, gonfiando le guance.",shape=box,color=blue];
		2221 -> 2223;
	2223 [label="Comunque. NON È RILEVANTE.",shape=box,color=blue];
		2223 -> 2224;
	2224 [label="Quindi tu e Christopher…",shape=box,color=red];
		2224 -> 2225;
	2225 [label="Si. Lui era gentile. Splendido. Forte. Era anche facile da mettere in riga, il che era un grande vantaggio. Ma era deciso ad arruolarsi nell'esercito. ",shape=box,color=blue];
		2225 -> 2226;
	2226 [label="Non la pensavamo allo stesso modo. Per lui era una vocazione. Sarebbe stato là fuori ad aiutare le persone che ne avevano bisogno, a fare la differenza nel mondo. Aveva aderito alla linea dell'eroe virile, proprio come Arthur. ",shape=box,color=blue];
		2226 -> 2227;
	2227 [label="Check boolean EleanorHeroVirus",color=orange];
		2227 -> 2228 [label=true,color=green];
		2227 -> 2229 [label=true,color=green];
		2227 -> 2230 [label=true,color=green];
		2227 -> 2229 [label=false,color=brown];
		2227 -> 2230 [label=false,color=brown];
	2228 [label="So quanto odi il concetto di eroe. È questo il motivo?",shape=box,color=red];
		2228 -> 2231;
	2229 [label="Aveva ragione. Le persone disposte a lottare per un mondo migliore sono l'unica cosa che fa la differenza.",shape=box,color=red];
		2229 -> 2233;
	2230 [label="È un'idea convincente. La gente vuole aiutare. È facile approfittarne.",shape=box,color=red];
		2230 -> 2236;
	2231 [label="Sì. Odio quello che ha fatto a Christopher, quello che sta ancora facendo ad Arthur, quello che fa a tanti come loro.",shape=box,color=blue];
		2231 -> 2232;
	2233 [label="Si può lottare per un mondo migliore senza credere alle stronzate degli eroi!",shape=box,color=blue];
		2233 -> 2234;
	2236 [label="'Perché vuoi andare a uccidere la gente in nome di un Principe a cui non frega un cazzo di te?' gli dicevo. Si sarebbe fatto male, perché non si trattava del Servizio a Sua Maestà. Per lui si trattava di eliminare i signori della guerra che facevano incetta di cibo e costringevano i loro prigionieri politici a lavorare nelle miniere di Rubedo fino alla morte per sfinimento.",shape=box,color=blue];
		2236 -> 2237;
	2232 [label="Non ho nulla contro la morale. Gli dei sanno che persino io ne ho un po'. Ma l'intera narrazione dell'eroe è una perniciosa stronzata.",shape=box,color=blue];
		2232 -> 2237;
	2234 [label="Il punto centrale dell'Hero Virus è che è un virus. NON SI PREOCCUPA DELL'OSPITE. Ti convince che morire per una causa sarebbe giusto e nobile, invece di essere un tragico spreco di sangue.",shape=box,color=blue];
		2234 -> 2235;
	2237 [label="Ero sicura che sarei riuscita a convincere Christopher a rinunciare al servizio militare. Se non parlandogli, allora seducendolo.",shape=box,color=blue];
		2237 -> 2238;
		2237 -> 2239;
		2237 -> 2240;
		2237 -> 2241;
	2235 [label="Chat ends.",color=orange];
	2238 [label="È un po' arrogante da parte tua.",shape=box,color=red];
		2238 -> 2242;
	2239 [label="Mi sto preparando per il \"ma\".",shape=box,color=red];
		2239 -> 2244;
	2240 [label="Sembra che avesse già preso una decisione.",shape=box,color=red];
		2240 -> 2247;
	2241 [label="...Nota per me stesso: Discutere con Eleanor...",shape=box,color=red];
		2241 -> 2248;
	2242 [label="Sì, e?",shape=box,color=blue];
		2242 -> 2243;
	2244 [label="C'è bisogno di dirlo?",shape=box,color=blue];
		2244 -> 2245;
	2247 [label="+10 Chemistry",color=orange];
		2247 -> 2246;
	2248 [label="... non è proprio il momento.",shape=box,color=blue];
		2248 -> 2249;
	2243 [label="Stavo cercando di salvargli la vita. Ero disposta a combattere in modo sleale, per quanto fosse necessario.",shape=box,color=blue];
		2243 -> 2251;
	2245 [label="Sono rimasta intrappolata nella stessa ragnatela che stavo cercando di tessere.",shape=box,color=blue];
		2245 -> 2251;
	2246 [label="Giusto. A quel punto, ovviamente, era troppo tardi. Ero entrata in questa storia pensando di stregarlo, ma la verità è che lui ha stregato me.",shape=box,color=blue];
		2246 -> 2250;
	2249 [label="Non è facile per me, quindi per favore scegli un momento migliore",shape=box,color=blue];
		2249 -> 2251;
	2251 [label="Gli ho detto che ero incinta. Si è offerto di sposarmi. Stupido, bellissimo idiota.",shape=box,color=blue];
		2251 -> 2252;
	2250 [label="Mi dispiace. Non riuscirò a superare questa situazione senza piangere, quindi se sono lenta a rispondere, almeno saprai perché.",shape=box,color=blue];
		2250 -> 2251;
	2252 [label="Lo eri davvero?",shape=box,color=red];
		2252 -> 2253;
	2253 [label="No. Ma pensavo di esserlo. Non ho provato a imbrogliarlo, se è questo che stai chiedendo.",shape=box,color=blue];
		2253 -> 2254;
	2254 [label="Arthur saltellava su soffici nuvole, era così felice. Il ragazzo che vedeva come un fratello sarebbe diventato suo cognato.",shape=box,color=blue];
		2254 -> 2255;
	2255 [label="Poi avanti veloce. Qualcosa su un attacco preventivo. Confini e contenimento, rischio di escalation, mandato morale sanguinario. Christopher viene schierato, Arthur si sta già arruolando, tutti i ragazzi al Crimson Watch e mia madre stava ancora cercando di organizzare i posti a sedere per le nozze.",shape=box,color=blue];
		2255 -> 2256;
		2255 -> 2257;
	2256 [label="Quindi, cosa è successo?",shape=box,color=red];
		2256 -> 2258;
	2257 [label="Riesci a continuare?",shape=box,color=red];
		2257 -> 2258;
	2258 [label="Lo hanno ucciso. Le persone che presumibilmente eravamo lì per aiutare. Hanno fatto saltare in aria il suo veicolo con una bomba di fertilizzante e chiodi da muratura.",shape=box,color=blue];
		2258 -> 2259;
	2259 [label="Mi dico \"almeno è stato veloce\". \"Almeno non ha sofferto\". Ma per quanto ne so, è morto urlando con i chiodi negli occhi",shape=box,color=blue];
		2259 -> 2260;
	2260 [label="Merda",shape=box,color=blue];
		2260 -> 2261;
	2261 [label="Merda merdosa",shape=box,color=blue];
		2261 -> 2262;
		2261 -> 2263;
	2262 [label="Almeno è morto facendo ciò che riteneva giusto...",shape=box,color=red];
		2262 -> 2264;
	2263 [label="Mi dispiace tanto...",shape=box,color=red];
		2263 -> 2266;
	2264 [label="Ho la sensazione che non hai prestato attenzione a NEMMENO UNA COSA che ti ho detto",shape=box,color=blue];
		2264 -> 2265;
	2266 [label="Ho pianto, ovviamente, ma per tutto il tempo pensavo \"cosa ti aspettavi, STUPIDA ragazza, SAPEVI in cosa ti stavi cacciando, SAPEVI che sarebbe successo\"",shape=box,color=blue];
		2266 -> 2267;
	2265 [label="Non mi interessa \"almeno...\" È morto in un modo STUPIDO e per una ragione STUPIDA",shape=box,color=blue];
		2265 -> 2269;
	2267 [label="Raccontartelo in questo modo, sembra solo una banale canzone",shape=box,color=blue];
		2267 -> 2268;
	2269 [label="Check boolean EleanorDating",color=orange];
		2269 -> 2270 [label=true,color=green];
		2269 -> 2271 [label=false,color=brown];
	2268 [label="Il mio amore è partito per la guerra, canta fol de rol de dee, oh no è morto, vagherò nelle valli solitarie e non sposerò mai un altro",shape=box,color=blue];
		2268 -> 2279;
	2270 [label="E se non mi stai ascoltando mentre parlo di questo, cos'altro non hai ascoltato? Per quanto sia stato affascinante tutto questo tra noi, io... no. È stato un errore.",shape=box,color=blue];
		2270 -> 2272;
	2271 [label="E se non mi stai ascoltando mentre parlo di questo, cos'altro non hai ascoltato?",shape=box,color=blue];
		2271 -> 2273;
	2279 [label="Scusa. Ricomponiti, Eleanor.",shape=box,color=blue];
		2279 -> 2280;
	2272 [label="Tutta questa dannata cosa è stata un errore. È finita.",shape=box,color=blue];
		2272 -> 2275;
	2273 [label="Update boolean EleanorNoDate",color=orange];
		2273 -> 2274;
	2280 [label="Penso che gli saresti piaciuto.",shape=box,color=blue];
		2280 -> 2281;
	2275 [label="Update boolean IsDating",color=orange];
		2275 -> 2276;
	2274 [label="Chat ends.",color=orange];
