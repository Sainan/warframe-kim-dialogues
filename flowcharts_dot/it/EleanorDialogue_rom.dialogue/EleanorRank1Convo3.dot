	171 [label="Non ne hanno avuto l'opportunità.",shape=box,color=red];
		171 -> 176;
	172 [label="Per plasmato intendi… Duviri? Torri, isole e cavalli volanti?",shape=box,color=blue];
		172 -> 178;
	174 [label="Che forma ha assunto?",shape=box,color=blue];
		174 -> 179;
	205 [label="Cosa intendi dire con connessa?",shape=box,color=red];
		205 -> 204;
	176 [label="Oh Sol. È orribile.",shape=box,color=blue];
		176 -> 177;
	178 [label="Sì. Letteralmente una storia per bambini che prende vita.",shape=box,color=red];
		178 -> 182;
	179 [label="C'era un libro che adoravo. “Leggende di Duviri”. Storie di un regno magico, solo che in realtà si trattava di emozioni e delle lezioni che possono insegnarti.",shape=box,color=red];
		179 -> 180;
	204 [label="Voglio dire, sono un Warframe. O meglio un Protoframe. Sono come loro.",shape=box,color=blue];
		204 -> 206;
	177 [label="Preferiresti non parlarne?",shape=box,color=blue];
		177 -> 175;
		177 -> 173;
	182 [label="E questo era reale? Non sembrava un sogno?",shape=box,color=blue];
		182 -> 189;
	180 [label="Il Void l'ha portato in vita e io ho avuto modo di viverci dentro. Poi è diventato una prigione. Ma questa è un'altra storia.",shape=box,color=red];
		180 -> 181;
	206 [label="E ora posso fare cose. Controllo mentale. Sciogliere visi.",shape=box,color=blue];
