		175 -> 186;
	173 [label="Sì, preferirei. [Fine.]",shape=box,color=red];
		173 -> 183;
	189 [label="No, Eleanor, essere assassinato ogni mattina non sembrava un sogno. Ho sentito ogni secondo.",shape=box,color=red];
		189 -> 190;
