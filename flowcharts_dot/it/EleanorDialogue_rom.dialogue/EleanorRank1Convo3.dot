	156 [label="Mi sento messo alle strette. Questa è un'intervista?",shape=box,color=red];
		156 -> 159;
	157 [label="Cosa ''significa'' per me?",shape=box,color=red];
		157 -> 160;
	158 [label="Nessuno sa davvero cosa sia il Void. È una dimensione, un campo energetico, è una scorciatoia attraverso lo spazio, è un rifugio dove si sono nascosti gli Orokin…",shape=box,color=red];
		158 -> 161;
	159 [label="Scusa. Vecchie abitudini.",shape=box,color=blue];
		159 -> 162;
	160 [label="Sì.",shape=box,color=blue];
		160 -> 163;
	161 [label="Per quanto affascinante, tutto ciò suona tecnico. Ero più interessata a cosa significasse per te. Dal momento che sembri, beh. viverlo e respirarlo. Letteralmente.",shape=box,color=blue];
		161 -> 164;
		161 -> 165;
		161 -> 166;
	162 [label="Perdonami. Non sono più una giornalista e tu non sei la storia. Sono solo profondamente interessata.",shape=box,color=blue];
		162 -> 164;
		162 -> 165;
		162 -> 166;
	163 [label="Entra nei particolari.",shape=box,color=blue];
		163 -> 164;
		163 -> 165;
		163 -> 166;
	164 [label="Il Void mi da la capacità di fare cose impossibili. Proiettare raggi di energia, diventare inconsistente e tutte quelle belle cose. Da dove vengo, è ciò che rende i Warframe in grado di fare ciò che fanno.",shape=box,color=red];
		164 -> 201;
	165 [label="Il Void fece impazzire i miei genitori.",shape=box,color=red];
		165 -> 167;
	166 [label="Il Void è stata la mia casa per non so quanto tempo. Si è plasmato su di me.. O in qualche modo l'ho plasmato io. Ancora non è chiaro cosa sia successo esattamente.",shape=box,color=red];
		166 -> 169;
	201 [label="Aspetta. Aspetta.",shape=box,color=blue];
		201 -> 202;
	167 [label="Mi dispiace. Ora mi sento terribile per averlo chiesto.",shape=box,color=blue];
		167 -> 168;
	169 [label="Ooh, hai tutta la mia attenzione.",shape=box,color=blue];
		169 -> 170;
	202 [label="Stai dicendo che, il Void è un motore miracoloso?",shape=box,color=blue];
		202 -> 203;
	168 [label="Si sono ripresi?",shape=box,color=blue];
		168 -> 171;
	170 [label="Check boolean EleanorDuviri",color=orange];
