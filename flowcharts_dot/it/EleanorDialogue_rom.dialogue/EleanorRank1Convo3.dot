	211 [label="Il Cuore di Deimos mantiene l'intero Sistema Origin immerso in una specie di aura Void. Come una radiazione di fondo. Tutto ciò che attinge energia dal Void dipende dal Cuore.",shape=box,color=red];
		211 -> 212;
	193 [label="Quindi non sono la stessa cosa?",shape=box,color=blue];
