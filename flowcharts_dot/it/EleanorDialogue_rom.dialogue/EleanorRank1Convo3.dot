		210 -> 211;
	191 [label="Sì. C'è qualcosa NEL Void. Questo lo so. L'Indifferenza, l'Occhio Senza Palpebra, l'\"Uomo nel Muro\". Quando dico che il Void ha fatto questo, intendo che LUI l'ha fatto.",shape=box,color=red];
