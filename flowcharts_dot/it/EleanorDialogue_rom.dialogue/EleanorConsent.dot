	"Chat ends." [color=orange];
	j3364311394 [label="Check boolean EleanorConsentComplete",color=orange];
		j3364311394 -> "Chat ends." [label=true,color=green];
		j3364311394 -> j983992162 [label=false,color=brown];
	j3528729371 [label="Check boolean EleanorPolyamorySuccess",color=orange];
		j3528729371 -> j3364311394 [label=true,color=green];
		j3528729371 -> "Chat ends." [label=false,color=brown];
	j983992162 [label="Penso che l'unica cosa un po' fastidiosa sia che ho trovato i pensieri riguardanti questa persona come prima cosa nella tua testa.",shape=box,color=blue];
		j983992162 -> j2208047803;
	j2208047803 [label="Sapevo comunque che saresti venuto a chiedere gentilemente il permesso. Ciao.",shape=box,color=blue];
		j2208047803 -> j3098317604;
	j3098317604 [label="La mia risposta molto imbronciata e con le braccia incrociate è un 'sì, certo', mentre io me ne sto qui seduta senza pensare a te che ti diverti con quella bellezza che ho intravisto nelle tue fantasie.",shape=box,color=blue];
		j3098317604 -> j1893878079;
	j1893878079 [label="Ora è nelle MIE fantasie, io che sono bloccata qui, in questo tempo e in questo luogo, grazie-mille-tantissime!",shape=box,color=blue];
		j1893878079 -> j1543909029;
	j1543909029 [label="Mi dispiace. Stavo veramente per venire a chiederti il consenso. So che non è qualcosa di cui abbiamo già parlato. Volevo assicurarmi che che tu fossi d'accordo.",shape=box,color=red];
		j1543909029 -> j1801193203;
	j1801193203 [label="Certo che sì! Vedo tutto con gli occhi della tua mente. E se tu di fidi, allora mi fido anche io.",shape=box,color=blue];
		j1801193203 -> j2334312234;
	j2334312234 [label="Mi dispiace solo di non potermi divertire neanche un pochino.",shape=box,color=blue];
		j2334312234 -> j2097109561;
	j2097109561 [label="+20 Chemistry",color=orange];
		j2097109561 -> j1936816333;
	j1936816333 [label="Ma forse posso farlo indirettamente tramite te ecco, solo un pensiero così.",shape=box,color=blue];
		j1936816333 -> j298331240;
	j298331240 [label="Boolean EleanorConsentComplete is now true.",color=orange];
		j298331240 -> "Chat ends.";
}