	3318 [label="Chat ends.",color=orange];
	3319 [label="Penso che l'unica cosa un po' fastidiosa sia che ho trovato i pensieri riguardanti questa persona come prima cosa nella tua testa.",shape=box,color=blue];
		3319 -> 3320;
	3317 [label="Chat ends.",color=orange];
	3320 [label="Sapevo comunque che saresti venuto a chiedere gentilemente il permesso. Ciao.",shape=box,color=blue];
		3320 -> 3321;
	3321 [label="La mia risposta molto imbronciata e con le braccia incrociate è un 'sì, certo', mentre io me ne sto qui seduta senza pensare a te che ti diverti con quella bellezza che ho intravisto nelle tue fantasie.",shape=box,color=blue];
		3321 -> 3322;
	3322 [label="Ora è nelle MIE fantasie, io che sono bloccata qui, in questo tempo e in questo luogo, grazie-mille-tantissime!",shape=box,color=blue];
		3322 -> 3323;
	3323 [label="Mi dispiace. Stavo veramente per venire a chiederti il consenso. So che non è qualcosa di cui abbiamo già parlato. Volevo assicurarmi che che tu fossi d'accordo.",shape=box,color=red];
		3323 -> 3324;
	3324 [label="Certo che sì! Vedo tutto con gli occhi della tua mente. E se tu di fidi, allora mi fido anche io.",shape=box,color=blue];
		3324 -> 3325;
	3325 [label="Mi dispiace solo di non potermi divertire neanche un pochino.",shape=box,color=blue];
		3325 -> 3326;
	3326 [label="+20 Chemistry",color=orange];
		3326 -> 3327;
	3327 [label="Ma forse posso farlo indirettamente tramite te ecco, solo un pensiero così.",shape=box,color=blue];
		3327 -> 3328;
	3328 [label="Update boolean EleanorConsentComplete",color=orange];
		3328 -> 3329;
