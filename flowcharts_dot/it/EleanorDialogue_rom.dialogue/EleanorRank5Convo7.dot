digraph {
	2607 [label="EleanorRank5Convo7 begins.",color=orange];
		2607 -> 2608;
	2608 [label="\"L'Indifferenza\" è ciò che È o ciò che VUOLE?",shape=box,color=blue];
		2608 -> 2609;
		2608 -> 2610;
		2608 -> 2611;
	2609 [label="Tu e Lettie siete uguali, sai. Vi dimenticate sempre di salutare.",shape=box,color=red];
		2609 -> 2613;
	2610 [label="La maggior parte delle persone inizierebbe con \"ciao\".",shape=box,color=red];
		2610 -> 2614;
	2611 [label="[Ignora.]",shape=box,color=red];
		2611 -> 2612;
	2613 [label="Hai trovato il nostro unico punto in comune, congratulazioni. E scusa. Ma questo è più importante.",shape=box,color=blue];
		2613 -> 2615;
	2614 [label="Mi dispiace. Questo è più importante.",shape=box,color=blue];
		2614 -> 2615;
	2612 [label="Chat ends.",color=orange];
	2615 [label="Penso che \"La Grande indifferenza\" cercherà in qualche modo di mettersi tra noi.",shape=box,color=blue];
		2615 -> 2616;
	2616 [label="Non ridere. Lo sento, nel profondo del mio essere. La cosa che era in Rusalka vorrebbe vederci farci a pezzi a vicenda.",shape=box,color=blue];
		2616 -> 2617;
	2617 [label="Non so perché. Lo so e basta.",shape=box,color=blue];
		2617 -> 2618;
		2617 -> 2619;
	2618 [label="Sì. Penso che tu abbia ragione.",shape=box,color=red];
		2618 -> 2620;
	2619 [label="Forse è quello che è successo alla famiglia Entrati. Hanno vissuto per anni proprio sopra il suo laboratorio, senza saperlo. Quando il bambino li ha trovati, tra loro erano distanti, si crogiolavano nel rancore.",shape=box,color=red];
		2619 -> 2620;
	2620 [label="L'ho visto nella tua testa. Albrecht e Loid. Madre e Padre. Tu e i tuoi genitori. Rusalka e Viktor, per quanto ne sappiamo. E noi sei, ovviamente.",shape=box,color=blue];
		2620 -> 2621;
	2621 [label="Ciò che fa questa cosa è arida. Perversa. Ma c'è una motivazione dietro, da qualche parte.",shape=box,color=blue];
		2621 -> 2622;
		2621 -> 2623;
	2622 [label="Penso che tu abbia ragione. Sulla Zariman, i genitori sono stati i primi a perdere la testa. Forse gli Holdfast hanno resistito così a lungo perché nessuno di loro aveva figli.",shape=box,color=red];
		2622 -> 2627;
	2623 [label="Non mi piace fingere di capire delle creature che sono fondamentalmente *dei*. Questa cosa sta cercando di capire le emozioni. Ma sta giocando malissimo con i suoi giocattoli.",shape=box,color=red];
		2623 -> 2624;
	2627 [label="Lascia che provi a mettersi tra noi. Per Sol, la finirò io. Troverò un modo.",shape=box,color=blue];
		2627 -> 2628;
	2624 [label="Teoria ammirevole, ma non ne siamo CERTI, no?",shape=box,color=blue];
		2624 -> 2625;
	2628 [label="Ci sono poteri nell'Universo contro cui quella cosa non può resistere. Io scelgo di crederci con ogni atomo di me stessa.",shape=box,color=blue];
		2628 -> 2629;
	2625 [label="Se è così, allora non ha colpe. Anzi, è quasi fanciullesca. Ma questo non rispecchia ciò che sappiamo. È malevole.",shape=box,color=blue];
		2625 -> 2626;
	2629 [label="Se mi ingoiasse per intero, mi infilerei nella sua gola per soffocarla.",shape=box,color=blue];
		2629 -> 2630;
		2629 -> 2631;
	2626 [label="Chat ends.",color=orange];
	2630 [label="Questo è un bel modo di morire.",shape=box,color=red];
		2630 -> 2632;
	2631 [label="Non so ancora come faremo, ma sono con te. Dobbiamo vincere.",shape=box,color=red];
		2631 -> 2635;
	2632 [label="In questo scenario sono comunque morta.",shape=box,color=blue];
		2632 -> 2633;
	2635 [label="Se questa fosse una storia, inventeresti qualche trucco ingegnoso. Dissotterreresti il ​​cuore di pietra del gigante e lo spezzeresti con una piuma di cigno, o lo indurresti a saltare in un dirupo.",shape=box,color=blue];
		2635 -> 2636;
	2633 [label="Ma almeno potrò sputarle in un occhio.",shape=box,color=blue];
		2633 -> 2634;
	2636 [label="Hai detto che eri una \"giornalista\". Non era questo il tipo di storie che raccontavi, vero? Dicevi la verità, non importa quanto fosse brutta.",shape=box,color=red];
		2636 -> 2637;
	2634 [label="Chat ends.",color=orange];
	2637 [label="Se quelle vecchie storie non fossero vere, la gente non avrebbe continuato a raccontarle.",shape=box,color=blue];
		2637 -> 2638;
	2638 [label="Non intendo dire che i giganti esistono. Voglio solo dire che le vecchie storie raccontano un tipo di verità differente.",shape=box,color=blue];
		2638 -> 2639;
		2638 -> 2640;
	2639 [label="Avremo bisogno di qualcosa di più delle favole per superare tutto questo, per quanto stimolanti possano essere.",shape=box,color=red];
		2639 -> 2641;
	2640 [label="Ho vissuto in un regno fatto di favole. So quanto possono essere potenti.",shape=box,color=red];
		2640 -> 2643;
	2641 [label="Lo so. Vorrei avere qualcosa in più del semplice istinto per capire.",shape=box,color=blue];
		2641 -> 2642;
	2643 [label="Penso che la cosa che hanno in comune tutte queste storie di ammazzagiganti sia questa: riguardano tutte l'apprendimento delle regole e l'usarle in modo intelligente.",shape=box,color=blue];
		2643 -> 2644;
	2642 [label="Stiamo affrontando qualcosa di vasto, terrificante e fuori dalla nostra comprensione. Normalmente solo i bambini possono farlo. Ecco perché esistono le fiabe.",shape=box,color=blue];
		2642 -> 2645;
		2642 -> 2646;
	2644 [label="Alcuni mostri sono stupidi. Alcuni sono costretti ad essere mostri, letteralmente. Alcuni hanno segreti. Ma non puoi vincere finché non conosci le regole a cui è vincolato il mostro.",shape=box,color=blue];
		2644 -> 2645;
		2644 -> 2646;
	2645 [label="È intrappolato nel Muro. Non sono nemmeno sicuro di cosa sia il Muro.",shape=box,color=red];
		2645 -> 2647;
	2646 [label="Non credo che l'Indifferenza sia vincolata da qualche regola.",shape=box,color=red];
		2646 -> 2649;
	2647 [label="Non importa. Se è davvero intrappolato, allora possiamo dedurre due cose, no?",shape=box,color=blue];
		2647 -> 2651;
	2649 [label="Deve esserlo! Anche gli Dei hanno delle regole! Non importa quanto potente sembri l'Indifferenza, non è un dio.",shape=box,color=blue];
		2649 -> 2650;
	2651 [label="In primis, può essere intrappolato. Forse persino imprigionato.",shape=box,color=blue];
		2651 -> 2653;
	2650 [label="Hai sconfitto Thrax. Non importa quante volte hai fallito e sei finito con le spalle al muro. HAI VINTO. Perché non dovresti sconfiggere anche l'Uomo nel Muro?",shape=box,color=blue];
		2650 -> 2648;
	2653 [label="+15 Chemistry",color=orange];
		2653 -> 2652;
	2648 [label="Quando hai smesso di averne paura, Eleanor?",shape=box,color=red];
		2648 -> 2655;
	2652 [label="In secundis, VUOLE qualcosa. Vuole uscire. Visto che sappiamo cosa vuole, siamo già un passo avanti.",shape=box,color=blue];
		2652 -> 2654;
	2655 [label="Non l'ho fatto.",shape=box,color=blue];
		2655 -> 2657;
	2654 [label="Chat ends.",color=orange];
	2657 [label="+20 Chemistry",color=orange];
		2657 -> 2656;
	2656 [label="Ho solo più paura di perdere te, ok?",shape=box,color=blue];
		2656 -> 2658;
	2658 [label="Chat ends.",color=orange];
}