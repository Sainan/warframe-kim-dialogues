digraph {
	2888 [label="EleanorRank6Convo3 begins.",color=orange];
		2888 -> 2889;
	2889 [label="Non so se te ne sei accorto, ma è successa una cosa fantastica.",shape=box,color=blue];
		2889 -> 2890;
	2890 [label="Arthur sta nuovamente cantando. Grazie agli Dei.",shape=box,color=blue];
		2890 -> 2891;
		2890 -> 2892;
		2890 -> 2893;
	2891 [label="Perché aveva smesso?",shape=box,color=red];
		2891 -> 2894;
	2892 [label="Non sono esattamente un fan del suo canto, ma se questo lo rende felice...",shape=box,color=red];
		2892 -> 2895;
	2893 [label="Sono contento. È bravo.",shape=box,color=red];
		2893 -> 2896;
	2894 [label="Ansia da prestazione. Semplice.",shape=box,color=blue];
		2894 -> 2897;
	2895 [label="Grazie per averlo espresso con tanta delicatezza.",shape=box,color=blue];
		2895 -> 2898;
	2896 [label="Non è vero?",shape=box,color=blue];
		2896 -> 2899;
	2897 [label="Difficile credere che qualcuno coraggioso come Arthur possa essere spaventato a tal punto.",shape=box,color=red];
		2897 -> 2900;
	2898 [label="Per me è importante il fatto che ti importi.",shape=box,color=blue];
		2898 -> 2901;
	2899 [label="Quando penso allo sforzo che ci è voluto per convincerlo a stare in piedi di fronte a una folla di persone e cantare...",shape=box,color=blue];
		2899 -> 2902;
	2900 [label="Qual è la crepa nella sua armatura?",shape=box,color=red];
		2900 -> 2903;
	2901 [label="Soprattutto perché ci sono delle ragioni per cui ha smesso di cantare, di cui tu non potevi essere a conoscenza.",shape=box,color=blue];
		2901 -> 2904;
		2901 -> 2905;
	2902 [label="... la prima volta che ha davvero perso la calma, intendo.",shape=box,color=blue];
		2902 -> 2906;
	2903 [label="È il suo nome. È questo il maledetto problema.",shape=box,color=blue];
		2903 -> 2907;
	2904 [label="Non aveva abbastanza supporto morale?",shape=box,color=red];
		2904 -> 2908;
	2905 [label="Pubblico difficile?",shape=box,color=red];
		2905 -> 2908;
	2906 [label="Concerto di Canti Natalizi del Solstizio negli anni ottanta. Immagina il nostro ometto in pantaloncini corti che esegue l'assolo di \"How Bright The Dew Upon That Morn\".",shape=box,color=blue];
		2906 -> 2909;
		2906 -> 2910;
	2907 [label="\"oh, nightingale non vuol dire usignolo? ah ah cantaci una canzone allora\"",shape=box,color=blue];
		2907 -> 2911;
	2908 [label="Più che altro, sentire la stessa battuta troppo spesso.",shape=box,color=blue];
		2908 -> 2903;
	2909 [label="È una bella immagine.",shape=box,color=red];
		2909 -> 2912;
	2910 [label="Non la conosco.",shape=box,color=red];
		2910 -> 2913;
	2911 [label="Simpaticoni diversi, stessa frase, per tutta la vita. Ora il loro posto lo ha preso Viktor. ",shape=box,color=blue];
		2911 -> 2914;
	2912 [label="L'ha presa molto sul serio. Settimane e settimane di pratica e poi, quella sera, ha mollato tutto. Si è nascosto dietro le quinte e si è rifiutato di uscire.",shape=box,color=blue];
		2912 -> 2915;
		2912 -> 2897;
	2913 [label="Beh. Te la canterei, ma non so che tipo di rumore verrebbe fuori se ci provassi.",shape=box,color=blue];
		2913 -> 2916;
	2914 [label="+5 Chemistry",color=orange];
		2914 -> 2917;
	2915 [label="Come lo hai convinto?",shape=box,color=red];
		2915 -> 2918;
	2916 [label="Maledetto Techrot. Ho provato a cantare \"Tanti auguri\" ad Aoi, ma sembrava una rana intrappolata in un trita documenti.",shape=box,color=blue];
		2916 -> 2919;
	2917 [label="Sinceramente sono orgogliosa di Arthur per aver avuto il coraggio di cantare.",shape=box,color=blue];
		2917 -> 2920;
	2918 [label="Gli ho letteralmente dato un calcio nel sedere. Non ne sono orgogliosa. Ma era necessario.",shape=box,color=blue];
		2918 -> 2921;
	2919 [label="Mi dispiace. Dev'essere dura non poter più cantare.",shape=box,color=red];
		2919 -> 2922;
	2920 [label="Chat ends.",color=orange];
	2921 [label="Il fatto è che non ha fatto tutta quella pratica per il bene dei nostri genitori o per rendere felice la signora Henshaw. ",shape=box,color=blue];
		2921 -> 2923;
	2922 [label="Oh, non è una grande perdita. Tanto non sapevo comunque cantare.",shape=box,color=blue];
		2922 -> 2924;
	2923 [label="Cantava perché gli piaceva. Ma quando ha avuto i riflettori puntati su di lui, si è bloccato.",shape=box,color=blue];
		2923 -> 2925;
		2923 -> 2900;
	2924 [label="La cosa più vicina a cui sono arrivata è stata urlare a squarciagola i testi delle canzoni degli Shag Cannons nella mia camera da letto, perché volevo far parte della band di Mandy Jellicoe visto che mi piaceva. ",shape=box,color=blue];
		2924 -> 2926;
	2925 [label="Forse aveva solo bisogno di ricordare quanto gli piaceva farlo.",shape=box,color=red];
		2925 -> 2927;
	2926 [label="Ma poi mio padre ha iniziato a bussare alla porta e a minacciare di lavarmi la bocca con il fenolo se avesse sentito ancora quelle porcherie.",shape=box,color=blue];
		2926 -> 2928;
	2927 [label="Arthur è più felice quando riesce a dimenticarsi di sé. Quando può darsi pace e semplicemente essere quello che È.",shape=box,color=blue];
		2927 -> 2929;
	2928 [label="(Non so se dalle tue parti esiste il “punk”, ma non saper cantare è quasi necessario e non è affatto un problema.)",shape=box,color=blue];
		2928 -> 2930;
		2928 -> 2931;
	2929 [label="La birra aiuta.",shape=box,color=blue];
		2929 -> 2932;
	2930 [label="Non abbiamo il punk, ma abbiamo lo Skeg.",shape=box,color=red];
		2930 -> 2933;
	2931 [label="Che cosa è successo alla band?",shape=box,color=red];
		2931 -> 2934;
	2932 [label="E sicuramente è d'aiuto il fatto che Velimir si comporti come il padre che Arthur avrebbe scelto, se avesse potuto sceglierne uno da un catalogo.",shape=box,color=blue];
		2932 -> 2935;
		2932 -> 2936;
	2933 [label="Non osare scrivere una cosa del genere in chat senza poi approfondire. ",shape=box,color=blue];
		2933 -> 2937;
	2934 [label="Non sono nemmeno arrivati alla fase “concerto di pietà nel pub locale”.",shape=box,color=blue];
		2934 -> 2938;
	2935 [label="Non lo biasimo.",shape=box,color=red];
		2935 -> 2939;
	2936 [label="Pensavo che Velimir e Minerva assomigliassero un po' troppo ai vostri veri genitori.",shape=box,color=red];
		2936 -> 2940;
	2937 [label="Esigo una spiegazione su cos'è lo Skeg.",shape=box,color=blue];
		2937 -> 2941;
	2938 [label="Si è sparsa la voce che Mandy aveva intenzione di sputare sul pubblico e la cosa è finita lì. Che peccato.",shape=box,color=blue];
		2938 -> 2942;
		2938 -> 2943;
	2939 [label="Arthur ha portato in giro quell'orsacchiotto per mesi. E adesso c'è Velimir. È come se il destino avesse percepito un buco a forma di orso nella vita di Arthur...",shape=box,color=blue];
		2939 -> 2944;
	2940 [label="Sì, beh. Forse i battibecchi lo fanno sentire a casa. ",shape=box,color=blue];
		2940 -> 2945;
	2941 [label="Perché sembra qualcosa di venduto in sacchetti di plastica in una tenuta di Ludston.",shape=box,color=blue];
		2941 -> 2946;
		2941 -> 2947;
	2942 [label="Chi ha paura di un po' di saliva?",shape=box,color=red];
		2942 -> 2948;
	2943 [label="Sputo? Sembra l'idea di un Technocyte Coda per una bella serata.",shape=box,color=red];
		2943 -> 2949;
	2944 [label="+5 Chemistry",color=orange];
		2944 -> 2950;
	2945 [label="+5 Chemistry",color=orange];
		2945 -> 2951;
	2946 [label="È come la musica, solo che la si produce colpendo i tubi. E le prese d'aria. E i caschi Corpus. E qualsiasi altra cosa si possa trovare da colpire, in realtà. ",shape=box,color=red];
		2946 -> 2952;
	2947 [label="È rumore inutile. Piace solo ai Ventkid.",shape=box,color=red];
		2947 -> 2953;
	2948 [label="+5 Chemistry",color=orange];
		2948 -> 2954;
	2949 [label="Erano altri tempi. Quando il punk era davvero punk. ",shape=box,color=blue];
		2949 -> 2955;
	2950 [label="... mi dispiace. Non sono cose su cui dovrei fare speculazioni. Sono solo felice che lui sia felice.",shape=box,color=blue];
		2950 -> 3311;
	2951 [label="È strano ciò per cui si può avere nostalgia di casa, non è vero?",shape=box,color=blue];
		2951 -> 2956;
	2952 [label="È una cosa dei Ventkid.",shape=box,color=red];
		2952 -> 2957;
	2953 [label="Ah. \"Rumore inutile\". L'ho già sentito dire.",shape=box,color=blue];
		2953 -> 2958;
	2954 [label="Io, perbacco, non lo ero, questo te lo posso assicurare.",shape=box,color=blue];
		2954 -> 2955;
	2955 [label="... Ho solo pensato \"Vorrei che potesse vedermi adesso\". Credo che le piacerebbe questa versione di me.",shape=box,color=blue];
		2955 -> 2959;
	3311 [label="Chat ends.",color=orange];
	2956 [label="Chat ends.",color=orange];
	2957 [label="+5 Chemistry",color=orange];
		2957 -> 2960;
	2958 [label="Non credo che ci sia nulla di così inutile da non poter essere la colonna sonora della giovinezza di qualcuno.",shape=box,color=blue];
		2958 -> 2961;
	2959 [label="Oh Dei, sono diventata tutta sdolcinata e nostalgica.",shape=box,color=blue];
		2959 -> 2962;
	2960 [label="Mmh. Sembra musica da sopravvissuti. Non mi dispiacerebbe ascoltarla, se avessi la possibilità di registrarne un po' per me.",shape=box,color=blue];
		2960 -> 2963;
	2961 [label="Meglio che la smetta. Sto diventando sentimentale.",shape=box,color=blue];
		2961 -> 2964;
	2962 [label="+5 Chemistry",color=orange];
		2962 -> 2965;
	2963 [label="Meglio tenerlo lontano dagli altoparlanti del centro commerciale, però.",shape=box,color=blue];
		2963 -> 2966;
	2964 [label="Chat ends.",color=orange];
	2965 [label="Meglio tornare al lavoro. Grazie per avermi ascoltata.",shape=box,color=blue];
		2965 -> 2967;
