digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"EleanorRank6Convo3 begins." [color=orange];
		"EleanorRank6Convo3 begins." -> j1860731604;
	j1860731604 [label="Non so se te ne sei accorto, ma è successa una cosa fantastica.",shape=box,color=blue];
		j1860731604 -> j3308023046;
	j3308023046 [label="Arthur sta nuovamente cantando. Grazie agli Dei.",shape=box,color=blue];
		j3308023046 -> j2020006762;
		j3308023046 -> j1191375651;
		j3308023046 -> j457971870;
	j2020006762 [label="Perché aveva smesso?",shape=box,color=red];
		j2020006762 -> j4207984891;
	j1191375651 [label="Non sono esattamente un fan del suo canto, ma se questo lo rende felice...",shape=box,color=red];
		j1191375651 -> j1495357403;
	j457971870 [label="Sono contento. È bravo.",shape=box,color=red];
		j457971870 -> j3600092979;
	j4207984891 [label="Ansia da prestazione. Semplice.",shape=box,color=blue];
		j4207984891 -> j1293115372;
	j1495357403 [label="Grazie per averlo espresso con tanta delicatezza.",shape=box,color=blue];
		j1495357403 -> j3497098327;
	j3600092979 [label="Non è vero?",shape=box,color=blue];
		j3600092979 -> j3946321194;
	j1293115372 [label="Difficile credere che qualcuno coraggioso come Arthur possa essere spaventato a tal punto.",shape=box,color=red];
		j1293115372 -> j2596494002;
	j3497098327 [label="Per me è importante il fatto che ti importi.",shape=box,color=blue];
		j3497098327 -> j1992155732;
	j3946321194 [label="Quando penso allo sforzo che ci è voluto per convincerlo a stare in piedi di fronte a una folla di persone e cantare...",shape=box,color=blue];
		j3946321194 -> j2701580636;
	j2596494002 [label="Qual è la crepa nella sua armatura?",shape=box,color=red];
		j2596494002 -> j3164782318;
	j1992155732 [label="Soprattutto perché ci sono delle ragioni per cui ha smesso di cantare, di cui tu non potevi essere a conoscenza.",shape=box,color=blue];
		j1992155732 -> j3843916211;
		j1992155732 -> j1330717217;
	j2701580636 [label="... la prima volta che ha davvero perso la calma, intendo.",shape=box,color=blue];
		j2701580636 -> j3615384985;
	j3164782318 [label="È il suo nome. È questo il maledetto problema.",shape=box,color=blue];
		j3164782318 -> j463259980;
	j3843916211 [label="Non aveva abbastanza supporto morale?",shape=box,color=red];
		j3843916211 -> j3087847633;
	j1330717217 [label="Pubblico difficile?",shape=box,color=red];
		j1330717217 -> j3087847633;
	j3615384985 [label="Concerto di Canti Natalizi del Solstizio negli anni ottanta. Immagina il nostro ometto in pantaloncini corti che esegue l'assolo di \"How Bright The Dew Upon That Morn\".",shape=box,color=blue];
		j3615384985 -> j3273114713;
		j3615384985 -> j1148832025;
	j463259980 [label="\"oh, nightingale non vuol dire usignolo? ah ah cantaci una canzone allora\"",shape=box,color=blue];
		j463259980 -> j4095962453;
	j3087847633 [label="Più che altro, sentire la stessa battuta troppo spesso.",shape=box,color=blue];
		j3087847633 -> j3164782318;
	j3273114713 [label="È una bella immagine.",shape=box,color=red];
		j3273114713 -> j2712901497;
	j1148832025 [label="Non la conosco.",shape=box,color=red];
		j1148832025 -> j1514429232;
	j4095962453 [label="Simpaticoni diversi, stessa frase, per tutta la vita. Ora il loro posto lo ha preso Viktor. ",shape=box,color=blue];
		j4095962453 -> j2284066493;
	j2712901497 [label="L'ha presa molto sul serio. Settimane e settimane di pratica e poi, quella sera, ha mollato tutto. Si è nascosto dietro le quinte e si è rifiutato di uscire.",shape=box,color=blue];
		j2712901497 -> j189067687;
		j2712901497 -> j1293115372;
	j1514429232 [label="Beh. Te la canterei, ma non so che tipo di rumore verrebbe fuori se ci provassi.",shape=box,color=blue];
		j1514429232 -> j2727579161;
	j2284066493 [label="+5 Chemistry",color=orange];
		j2284066493 -> j3722880921;
	j189067687 [label="Come lo hai convinto?",shape=box,color=red];
		j189067687 -> j3596904497;
	j2727579161 [label="Maledetto Techrot. Ho provato a cantare \"Tanti auguri\" ad Aoi, ma sembrava una rana intrappolata in un trita documenti.",shape=box,color=blue];
		j2727579161 -> j1039824458;
	j3722880921 [label="Sinceramente sono orgogliosa di Arthur per aver avuto il coraggio di cantare.",shape=box,color=blue];
		j3722880921 -> "Chat ends.";
	j3596904497 [label="Gli ho letteralmente dato un calcio nel sedere. Non ne sono orgogliosa. Ma era necessario.",shape=box,color=blue];
		j3596904497 -> j3798342410;
	j1039824458 [label="Mi dispiace. Dev'essere dura non poter più cantare.",shape=box,color=red];
		j1039824458 -> j3293321441;
	"Chat ends." [color=orange];
	j3798342410 [label="Il fatto è che non ha fatto tutta quella pratica per il bene dei nostri genitori o per rendere felice la signora Henshaw. ",shape=box,color=blue];
		j3798342410 -> j2931763230;
	j3293321441 [label="Oh, non è una grande perdita. Tanto non sapevo comunque cantare.",shape=box,color=blue];
		j3293321441 -> j3791319724;
	j2931763230 [label="Cantava perché gli piaceva. Ma quando ha avuto i riflettori puntati su di lui, si è bloccato.",shape=box,color=blue];
		j2931763230 -> j3169209477;
		j2931763230 -> j2596494002;
	j3791319724 [label="La cosa più vicina a cui sono arrivata è stata urlare a squarciagola i testi delle canzoni degli Shag Cannons nella mia camera da letto, perché volevo far parte della band di Mandy Jellicoe visto che mi piaceva. ",shape=box,color=blue];
		j3791319724 -> j778500706;
	j3169209477 [label="Forse aveva solo bisogno di ricordare quanto gli piaceva farlo.",shape=box,color=red];
		j3169209477 -> j1219229244;
	j778500706 [label="Ma poi mio padre ha iniziato a bussare alla porta e a minacciare di lavarmi la bocca con il fenolo se avesse sentito ancora quelle porcherie.",shape=box,color=blue];
		j778500706 -> j2151550212;
	j1219229244 [label="Arthur è più felice quando riesce a dimenticarsi di sé. Quando può darsi pace e semplicemente essere quello che È.",shape=box,color=blue];
		j1219229244 -> j3104019342;
	j2151550212 [label="(Non so se dalle tue parti esiste il “punk”, ma non saper cantare è quasi necessario e non è affatto un problema.)",shape=box,color=blue];
		j2151550212 -> j820432060;
		j2151550212 -> j2565270685;
	j3104019342 [label="La birra aiuta.",shape=box,color=blue];
		j3104019342 -> j4268333678;
	j820432060 [label="Non abbiamo il punk, ma abbiamo lo Skeg.",shape=box,color=red];
		j820432060 -> j3322208350;
	j2565270685 [label="Che cosa è successo alla band?",shape=box,color=red];
		j2565270685 -> j288604630;
	j4268333678 [label="E sicuramente è d'aiuto il fatto che Velimir si comporti come il padre che Arthur avrebbe scelto, se avesse potuto sceglierne uno da un catalogo.",shape=box,color=blue];
		j4268333678 -> j3038388366;
		j4268333678 -> j73723953;
	j3322208350 [label="Non osare scrivere una cosa del genere in chat senza poi approfondire. ",shape=box,color=blue];
		j3322208350 -> j3963957022;
	j288604630 [label="Non sono nemmeno arrivati alla fase “concerto di pietà nel pub locale”.",shape=box,color=blue];
		j288604630 -> j3899816056;
	j3038388366 [label="Non lo biasimo.",shape=box,color=red];
		j3038388366 -> j2739008458;
	j73723953 [label="Pensavo che Velimir e Minerva assomigliassero un po' troppo ai vostri veri genitori.",shape=box,color=red];
		j73723953 -> j1534011339;
	j3963957022 [label="Esigo una spiegazione su cos'è lo Skeg.",shape=box,color=blue];
		j3963957022 -> j1751906126;
	j3899816056 [label="Si è sparsa la voce che Mandy aveva intenzione di sputare sul pubblico e la cosa è finita lì. Che peccato.",shape=box,color=blue];
		j3899816056 -> j2659182093;
		j3899816056 -> j3163155948;
	j2739008458 [label="Arthur ha portato in giro quell'orsacchiotto per mesi. E adesso c'è Velimir. È come se il destino avesse percepito un buco a forma di orso nella vita di Arthur...",shape=box,color=blue];
		j2739008458 -> j122825073;
	j1534011339 [label="Sì, beh. Forse i battibecchi lo fanno sentire a casa. ",shape=box,color=blue];
		j1534011339 -> j2199438849;
	j1751906126 [label="Perché sembra qualcosa di venduto in sacchetti di plastica in una tenuta di Ludston.",shape=box,color=blue];
		j1751906126 -> j2826527068;
		j1751906126 -> j3170835770;
	j2659182093 [label="Chi ha paura di un po' di saliva?",shape=box,color=red];
		j2659182093 -> j1739858047;
	j3163155948 [label="Sputo? Sembra l'idea di un Technocyte Coda per una bella serata.",shape=box,color=red];
		j3163155948 -> j3580575172;
	j122825073 [label="+5 Chemistry",color=orange];
		j122825073 -> j2374870113;
	j2199438849 [label="+5 Chemistry",color=orange];
		j2199438849 -> j1920107272;
	j2826527068 [label="È come la musica, solo che la si produce colpendo i tubi. E le prese d'aria. E i caschi Corpus. E qualsiasi altra cosa si possa trovare da colpire, in realtà. ",shape=box,color=red];
		j2826527068 -> j70355485;
	j3170835770 [label="È rumore inutile. Piace solo ai Ventkid.",shape=box,color=red];
		j3170835770 -> j4210197012;
	j1739858047 [label="+5 Chemistry",color=orange];
		j1739858047 -> j3548035790;
	j3580575172 [label="Erano altri tempi. Quando il punk era davvero punk. ",shape=box,color=blue];
		j3580575172 -> j4201821234;
	j2374870113 [label="... mi dispiace. Non sono cose su cui dovrei fare speculazioni. Sono solo felice che lui sia felice.",shape=box,color=blue];
		j2374870113 -> "Chat ends.";
	j1920107272 [label="È strano ciò per cui si può avere nostalgia di casa, non è vero?",shape=box,color=blue];
		j1920107272 -> "Chat ends.";
	j70355485 [label="È una cosa dei Ventkid.",shape=box,color=red];
		j70355485 -> j3962189990;
	j4210197012 [label="Ah. \"Rumore inutile\". L'ho già sentito dire.",shape=box,color=blue];
		j4210197012 -> j3366298326;
	j3548035790 [label="Io, perbacco, non lo ero, questo te lo posso assicurare.",shape=box,color=blue];
		j3548035790 -> j4201821234;
	j4201821234 [label="... Ho solo pensato \"Vorrei che potesse vedermi adesso\". Credo che le piacerebbe questa versione di me.",shape=box,color=blue];
		j4201821234 -> j1811188333;
	j3962189990 [label="+5 Chemistry",color=orange];
		j3962189990 -> j3695520135;
	j3366298326 [label="Non credo che ci sia nulla di così inutile da non poter essere la colonna sonora della giovinezza di qualcuno.",shape=box,color=blue];
		j3366298326 -> j1770846333;
	j1811188333 [label="Oh Dei, sono diventata tutta sdolcinata e nostalgica.",shape=box,color=blue];
		j1811188333 -> j3633912934;
	j3695520135 [label="Mmh. Sembra musica da sopravvissuti. Non mi dispiacerebbe ascoltarla, se avessi la possibilità di registrarne un po' per me.",shape=box,color=blue];
		j3695520135 -> j660364472;
	j1770846333 [label="Meglio che la smetta. Sto diventando sentimentale.",shape=box,color=blue];
		j1770846333 -> "Chat ends.";
	j3633912934 [label="+5 Chemistry",color=orange];
		j3633912934 -> j2785164983;
	j660364472 [label="Meglio tenerlo lontano dagli altoparlanti del centro commerciale, però.",shape=box,color=blue];
		j660364472 -> "Chat ends.";
	j2785164983 [label="Meglio tornare al lavoro. Grazie per avermi ascoltata.",shape=box,color=blue];
		j2785164983 -> "Chat ends.";
}