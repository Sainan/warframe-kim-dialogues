digraph {
	1521 [label="EleanorRank4Convo2 begins.",color=orange];
		1521 -> 1522;
	1522 [label="O Drifter! O vagabondo del tempo e dello spazio! Quanto è gradita la tua presenza su questo mio piccolo schermo!",shape=box,color=blue];
		1522 -> 1523;
		1522 -> 1524;
	1523 [label="Ciao, Eleanor.",shape=box,color=red];
		1523 -> 1526;
	1524 [label="Torno subito, Kalymos sta di nuovo giocando con i cavi e potrebbe disconnet [Fine.]",shape=box,color=red];
		1524 -> 1525;
	1526 [label="Ehi amico.",shape=box,color=blue];
		1526 -> 1527;
	1525 [label="Chat ends.",color=orange];
	1527 [label="Indovina.",shape=box,color=blue];
		1527 -> 1528;
		1527 -> 1529;
	1528 [label="Hai una domanda su come sarà la vita nel futuro?",shape=box,color=red];
		1528 -> 1530;
	1529 [label="Ti è cresciuta una coda.",shape=box,color=red];
		1529 -> 1531;
	1530 [label="Ugh. Sono così noiosamente, maledettamente prevedibile.",shape=box,color=blue];
		1530 -> 1533;
	1531 [label="... ti piacerebbe, non è vero?",shape=box,color=blue];
		1531 -> 1532;
	1533 [label="Sì. Un'altra. Ma questa è davvero importante, quindi abbi pazienza, ok?",shape=box,color=blue];
		1533 -> 1534;
	1532 [label="Ahimè, no. Il mio fondoschiena non è stato migliorato dall'aggiunta di una coda. Non può essere migliorato, perché è già perfetto.",shape=box,color=blue];
		1532 -> 1535;
	1534 [label="Farò del mio meglio.",shape=box,color=red];
		1534 -> 1536;
	1535 [label="Tuttavia, ho una domanda per te.",shape=box,color=blue];
		1535 -> 1537;
	1536 [label="Bene. Ottimo. Allora.",shape=box,color=blue];
		1536 -> 1537;
	1537 [label="Come funzionano le relazioni ai tuoi tempi? Voglio dire, è tutto il solito 'due o più adulti si incontrano con vari gradi di solennità'? O ci sono tutti tipi di regole su chi può stare con chi?",shape=box,color=blue];
		1537 -> 1538;
		1537 -> 1539;
		1537 -> 1540;
	1538 [label="Non è un aspetto che ho approfondito.",shape=box,color=red];
		1538 -> 1541;
	1539 [label="Dipende dalla cultura.",shape=box,color=red];
		1539 -> 1542;
	1540 [label="… perché lo chiedi?",shape=box,color=red];
		1540 -> 1543;
	1541 [label="Oddio.",shape=box,color=blue];
		1541 -> 1547;
	1542 [label="Giusto. Certo.",shape=box,color=blue];
		1542 -> 1548;
	1543 [label="Check boolean EleanorEntrati",color=orange];
		1543 -> 1544 [label=true,color=green];
		1543 -> 1545 [label=false,color=brown];
	1547 [label="So che eri isolato a Duviri, ma non pensavo COSÌ isolato.",shape=box,color=blue];
		1547 -> 1552;
	1548 [label="Lasciami provare un'altra tattica.",shape=box,color=blue];
		1548 -> 1550;
	1544 [label="Quei due su Deimos, Padre e Madre. Sono una coppia sposata. Saranno anche dei giganteschi ex Orokin Infested, ma sono chiaramente e dolorosamente SPOSATI esattamente nello stesso modo in cui lo sono mia madre e mio padre.",shape=box,color=blue];
		1544 -> 1546;
	1545 [label="Dai frammenti che ho raccolto dalla tua mente, vedo ancora coppie standard. Persone che sono chiaramente e dolorosamente SPOSATE esattamente nello stesso modo in cui lo sono mia madre e mio padre.",shape=box,color=blue];
		1545 -> 1546;
	1552 [label="+15 Chemistry",color=orange];
		1552 -> 1549;
	1550 [label="Vediamo...",shape=box,color=blue];
		1550 -> 1554;
	1546 [label="Quindi questo era lo standard per gli Orokin?",shape=box,color=blue];
		1546 -> 1551;
	1549 [label="Ti chiedo sinceramente scusa se ti ho turbato in qualche modo chiedendotelo.",shape=box,color=blue];
		1549 -> 1553;
	1554 [label="Ok. Quindi, da dove vieni, sarebbe normale per una persona avere una relazione con, diciamo, un Cephalon?",shape=box,color=blue];
		1554 -> 1555;
		1554 -> 1556;
	1551 [label="Gli Orokin erano per regole e tabù. Amavano la gerarchia. Le relazioni non potevano oltrepassare i confini sociali. Un Dax non poteva stare con un nobile Orokin, per esempio.",shape=box,color=red];
		1551 -> 1554;
	1553 [label="Chat ends.",color=orange];
	1555 [label="Potrei provare a trascinare Ordis indietro nel tempo, se vuoi provare a scoprirlo...",shape=box,color=red];
		1555 -> 1557;
	1556 [label="… Non ne ho mai sentito parlare e non so bene come funzionerebbe.",shape=box,color=red];
		1556 -> 1560;
	1557 [label="Sto cercando di porre una domanda TEORICA!",shape=box,color=blue];
		1557 -> 1558;
	1560 [label="Cavolo. Fammi riprovare.",shape=box,color=blue];
		1560 -> 1561;
	1558 [label="Non mi va di strusciarmi contro il tuo amico vitreo, per quanto affascinante possa essere",shape=box,color=blue];
		1558 -> 1559;
	1561 [label="Immagina qualcuno del tuo tempo che sia sia femmina che pericolosa. Anche forte. Come il Maggiore Rusalka senza la possessione demoniaca.",shape=box,color=blue];
		1561 -> 1562;
		1561 -> 1563;
	1559 [label="Sto provando, e fallendo, a chiederti riguardo gli SQUILIBRI DI POTERE",shape=box,color=blue];
		1559 -> 1561;
	1562 [label="Un cecchino Grineer?",shape=box,color=red];
		1562 -> 1564;
	1563 [label="Una Dax?",shape=box,color=red];
		1563 -> 1565;
	1564 [label="Okay. Mettiamo che c'è un cecchino Grineer e si innamora di un umano. Ed è reciproco. Amanti sfortunati. Disperatamente tragici. Potrebbero stare insieme?",shape=box,color=blue];
		1564 -> 1566;
		1564 -> 1567;
		1564 -> 1568;
		1564 -> 1569;
	1565 [label="Okay. Mettiamo che c'è un soldato Dax e si innamora di un umile umano. Ed è reciproco. Amanti sfortunati. Disperatamente tragici. Potrebbero stare insieme?",shape=box,color=blue];
		1565 -> 1566;
		1565 -> 1567;
		1565 -> 1568;
		1565 -> 1569;
	1566 [label="Se era quello che volevano entrambi, certo.",shape=box,color=red];
		1566 -> 1570;
	1567 [label="Perché no?",shape=box,color=red];
		1567 -> 1570;
	1568 [label="Vorrei vedere qualcuno provare a fermarli.",shape=box,color=red];
		1568 -> 1570;
	1569 [label="Sì, ma sarebbe difficile.",shape=box,color=red];
		1569 -> 1576;
	1570 [label="Sto facendo un gran casino.",shape=box,color=blue];
		1570 -> 1572;
	1576 [label="+5 Chemistry",color=orange];
		1576 -> 1571;
	1572 [label="È normale da dove vieni che le persone si mettano insieme a partner molto più potenti e pericolosi di loro? Come 'Gumbly e i calzini del Drago' quando il principe elfo finisce per sposare il gigante?",shape=box,color=blue];
		1572 -> 1574;
	1571 [label="Grazie.",shape=box,color=blue];
		1571 -> 1573;
	1574 [label="… non sai di cosa sto parlando, vero.",shape=box,color=blue];
		1574 -> 1578;
		1574 -> 1579;
	1573 [label="Domanda: due persone con caratteristiche fisiche e livelli di letalità molto diversi possono avere una relazione? Risposta: sì.",shape=box,color=blue];
		1573 -> 1575;
	1578 [label="In realtà, credo di sì.",shape=box,color=red];
		1578 -> 1582;
	1579 [label="Non proprio, no.",shape=box,color=red];
		1579 -> 1580;
	1575 [label="Questo è tutto quello che volevo sapere.",shape=box,color=blue];
		1575 -> 1577;
	1582 [label="Non voglio rovinarti la giornata. Scusa.",shape=box,color=blue];
		1582 -> 1583;
	1580 [label="Meglio che smetta. Corro il rischio di fare veramente una figuraccia.",shape=box,color=blue];
		1580 -> 1581;
	1577 [label="Chat ends.",color=orange];
	1583 [label="Posso fare uno sfogo autocommiserativo?",shape=box,color=blue];
		1583 -> 1584;
		1583 -> 1585;
	1581 [label="Chat ends.",color=orange];
	1584 [label="Sfogati.",shape=box,color=red];
		1584 -> 1587;
	1585 [label="Mi dispiace, non ho tempo. [Fine]",shape=box,color=red];
		1585 -> 1586;
	1587 [label="NON sto dicendo che la mia vita non abbia senso senza qualcuno con cui condividerla",shape=box,color=blue];
		1587 -> 1588;
	1586 [label="Chat ends.",color=orange];
	1588 [label="NON mi definisce chi scelgo di amare",shape=box,color=blue];
		1588 -> 1589;
	1589 [label="Sono sufficiente a me stessa",shape=box,color=blue];
		1589 -> 1590;
	1590 [label="MA COME POSSO ANCHE SOLO PRENDERE IN CONSIDERAZIONE LA POSSIBILITÀ DI UNA RELAZIONE QUANDO POTREI LETTERALMENTE UCCIDERE QUALCUNO PER SBAGLIO SE MI LASCIASSI TRASPORTARE",shape=box,color=blue];
		1590 -> 1591;
	1591 [label="Benvenuto a Eleanor e ai suoi problemi da mantide religiosa",shape=box,color=blue];
		1591 -> 1592;
	1592 [label="Se mai dovessi trovare quel bastardo di Entrati, trasformerò le sue palle in orecchini. Se ha le palle.",shape=box,color=blue];
		1592 -> 1593;
		1592 -> 1594;
	1593 [label="Potresti sempre uscire con qualcun altro dell'Hex.",shape=box,color=red];
		1593 -> 1595;
	1594 [label="Aspetta un attimo. Sei single perché hai paura di ferire qualcuno?",shape=box,color=red];
		1594 -> 1596;
	1595 [label="OH PER SOL",shape=box,color=blue];
		1595 -> 1597;
	1596 [label="Sì.",shape=box,color=blue];
		1596 -> 1601;
	1597 [label="MI STO LETTERALMENTE MORDENDO LA LINGUA PER NON SCOPPIARE A RIDERE",shape=box,color=blue];
		1597 -> 1598;
	1601 [label="Tu sai meglio di me cosa sono, credo. Sono un Protoframe. Sono una macchina da guerra parzialmente trasformata, e sembra che stia diventando meno parziale di giorno in giorno.",shape=box,color=blue];
		1601 -> 1602;
	1598 [label="L'unica di questi quattro con cui potrei anche solo CONSIDERARE di uscire è Aoi e questo è complicato a causa di Arthur",shape=box,color=blue];
		1598 -> 1599;
	1602 [label="Chiunque abbia progettato la povera 'Nyx' stava costruendo un killer. Quello sono io, adesso. Efficiente. Letale. Coccolosa come una mina.",shape=box,color=blue];
		1602 -> 1603;
	1599 [label="Grazie per il suggerimento, ma no, neanche tra un milione di anni",shape=box,color=blue];
		1599 -> 1600;
	1603 [label="Tutto molto bello quando si tratta del lavoro quotidiano, ma alla festa in ufficio chi bacerebbe una trappola mortale ambulante sotto il vischio?",shape=box,color=blue];
		1603 -> 1604;
		1603 -> 1606;
	1600 [label="Chat ends.",color=orange];
	1604 [label="Questo dolore accidentale di cui ti preoccupi. È mai successo? Hai mai fatto male a qualcuno con cui eri?",shape=box,color=red];
		1604 -> 1605;
	1606 [label="Voglio dire, almeno la buona notizia è che se ci fosse un incidente, nessuno a Höllvania rimarebbe morto dopo il reset...",shape=box,color=red];
		1606 -> 1607;
	1605 [label="No, non è successo perché non l'ho lasciato succedere. OK?",shape=box,color=blue];
		1605 -> 1608;
	1607 [label="...",shape=box,color=blue];
		1607 -> 1609;
	1608 [label="Nessun partner, nessuna vittima. Non ne vale il rischio.",shape=box,color=blue];
		1608 -> 1610;
	1609 [label="Non ci avevo pensato.",shape=box,color=blue];
		1609 -> 1611;
	1610 [label="Preferisco essere sola che immersa nei sensi di colpa, grazie.",shape=box,color=blue];
		1610 -> 1612;
	1611 [label="Tuttavia i nostri ricordi persistono.",shape=box,color=blue];
		1611 -> 1613;
	1612 [label="Quindi sei single da quando hai ricevuto l'iniezione di Entrati?",shape=box,color=red];
		1612 -> 1618;
	1613 [label="Non credo che nessuno vorrebbe avere una relazione con qualcuno che una volta gli ha staccato la testa a morsi, anche se poi la situazione è migliorata.",shape=box,color=blue];
		1613 -> 1614;
	1618 [label="+20 Chemistry",color=orange];
		1618 -> 1615;
	1614 [label="Lua pianse. Ora ho bisogno di bere.",shape=box,color=blue];
		1614 -> 1620;
	1615 [label="Corretto. Un compromesso che sono disposta a fare.",shape=box,color=blue];
		1615 -> 1616;
	1620 [label="Chat ends.",color=orange];
	1616 [label="Mi dispiace. Non sono sicura che parlarne sia stata una buona idea.",shape=box,color=blue];
		1616 -> 1617;
