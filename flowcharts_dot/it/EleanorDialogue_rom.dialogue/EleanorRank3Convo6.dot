		1354 -> 1355;
	1357 [label="Sapevo che eri il tipo di compagno di squadra che fa per me.",shape=box,color=blue];
		1357 -> 1358;
	1359 [label="Sono sicura che puoi indovinarlo. Il Techrot ha distrutto molte cose. Non c'era modo di tenere aperte le terme dopo le epidemie.",shape=box,color=blue];
