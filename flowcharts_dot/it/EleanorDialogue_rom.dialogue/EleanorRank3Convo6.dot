	1341 [label="Chat ends.",color=orange];
	1347 [label="Non so se hanno qualcosa del genere dove ti trovi tu. Sono questi templi, suppongo che li chiameresti così, di solito con un set di stanze Sol e Lua. Puoi immergerti in una piscina pubblica o privata. Tutto profuma di erbe e vapore ed è COSÌ PERFETTO per rimetterti in carreggiata.",shape=box,color=blue];
		1347 -> 1348;
	1348 [label="Höllvania ha sempre avuto questa importantissima tradizione di pulizia rituale. Immagino che risalga alle sorgenti termali su cui è stata costruita la città.",shape=box,color=blue];
		1348 -> 1349;
	1349 [label="Tutte quelle sciocchezze sulla \"purezza\" che tira fuori Viktor? È la solita vecchia storia. Tutti i cittadini sanno da dove viene.",shape=box,color=blue];
