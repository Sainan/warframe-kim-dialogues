digraph {
	924 [label="EleanorRank3Convo2 begins.",color=orange];
		924 -> 926;
	926 [label="Check boolean EleanorIndifference",color=orange];
		926 -> 925 [label=true,color=green];
		926 -> 927 [label=false,color=brown];
	925 [label="Ci sei? Devo parlarti.",shape=box,color=blue];
		925 -> 928;
		925 -> 929;
	927 [label="Ci sei? Devo parlarti di una cosa. È una cosa seria.",shape=box,color=blue];
		927 -> 931;
		927 -> 929;
	928 [label="Sono qui.",shape=box,color=red];
		928 -> 932;
	929 [label="Mi dispiace davvero. Non adesso. [Fine.]",shape=box,color=red];
		929 -> 930;
	931 [label="Sono qui. Vai.",shape=box,color=red];
		931 -> 933;
	932 [label="Ti ricordi che ti ho raccontato di come ho cercato di entrare in contatto con la mente di Rusalka e invece sono entrata in contatto con L'Indifferenza?",shape=box,color=blue];
		932 -> 935;
	930 [label="Chat ends.",color=orange];
	933 [label="Grazie.",shape=box,color=blue];
		933 -> 934;
	935 [label="Certo che mi ricordo.",shape=box,color=red];
		935 -> 938;
	934 [label="Capisci cosa è successo al Maggiore Rusalka?",shape=box,color=blue];
		934 -> 936;
		934 -> 937;
	938 [label="Giusto. Non ero pronta a parlarne allora. Sono pronta adesso, se vuoi.",shape=box,color=blue];
		938 -> 945;
	936 [label="Lei veniva usata. L'Indifferenza la stava manipolando.",shape=box,color=red];
		936 -> 939;
	937 [label="Sono abbastanza sicuro che sia stata svuotata e portata in giro come un... beh... Warframe...?",shape=box,color=red];
		937 -> 940;
	945 [label="Se ne sei sicura.",shape=box,color=red];
		945 -> 946;
	939 [label="\"L'indifferenza\". È così che la chiami?",shape=box,color=blue];
		939 -> 941;
	940 [label="Svuotata, esatto.",shape=box,color=blue];
		940 -> 942;
	946 [label="Ne sono sicura.",shape=box,color=blue];
		946 -> 947;
	941 [label="Grazie.",shape=box,color=blue];
		941 -> 943;
	942 [label="Ma qualunque cosa la spingesse, non era come te.",shape=box,color=blue];
		942 -> 944;
	947 [label="Questa creatura, questa presenza, è ciò contro cui ci troviamo. Ora lo so.",shape=box,color=blue];
		947 -> 951;
	943 [label="Dargli un nome mi fa sentire come se avessi ripreso un po' di controllo.",shape=box,color=blue];
		943 -> 948;
	944 [label="Tutto ciò che aveva di umano era per lei una presa in giro.",shape=box,color=blue];
		944 -> 949;
	951 [label="Per favore, dimmi la verità. Credi che ci sia qualche speranza?",shape=box,color=blue];
		951 -> 956;
		951 -> 957;
		951 -> 958;
	948 [label="Ho toccato quella cosa con la mia mente. Pensavo di sondare la mente di Rusalka, ma… gli strati esterni sono semplicemente crollati come cartongesso bagnato e spugnoso e poi mi sono immersa. Dibattendomi.",shape=box,color=blue];
		948 -> 950;
	949 [label="Era quasi umana quanto un manichino. A pezzi.",shape=box,color=blue];
		949 -> 952;
	956 [label="A questo punto? ... No.",shape=box,color=red];
		956 -> 960;
	957 [label="Onestamente? Non ne sono... sicuro.",shape=box,color=red];
		957 -> 961;
	958 [label="Sì.",shape=box,color=red];
		958 -> 962;
	950 [label="Update boolean EleanorIndifference",color=orange];
		950 -> 951;
	952 [label="L'ho toccata, capisci. Con la mia mente. Cercavo di sondarla, ma lei non c'era.",shape=box,color=blue];
		952 -> 953;
	960 [label="Almeno sei stato onesto.",shape=box,color=blue];
		960 -> 963;
	961 [label="Capisco.",shape=box,color=blue];
		961 -> 964;
	962 [label="Non dirmi perché.",shape=box,color=blue];
		962 -> 965;
	953 [label="So cosa intendi. Noi la chiamiamo L'Indifferenza.",shape=box,color=red];
		953 -> 954;
	963 [label="Bene. Lascia che la speranza muoia.",shape=box,color=blue];
		963 -> 966;
	964 [label="Ci sono così tante cose che non sappiamo.",shape=box,color=blue];
		964 -> 967;
	965 [label="Aggrappati a quella convinzione. Fammela sentire.",shape=box,color=blue];
		965 -> 968;
	954 [label="Grazie.",shape=box,color=blue];
		954 -> 955;
	966 [label="Continuerò a lottare solo per la mia dannata testardaggine.",shape=box,color=blue];
		966 -> 969;
	967 [label="Dopo quello che è accaduto quest'anno, come possiamo pensare di elaborare dei piani sensati?",shape=box,color=blue];
		967 -> 970;
	968 [label="Per favore.",shape=box,color=blue];
		968 -> 971;
	955 [label="Dargli un nome mi fa sentire come se avessi ripreso un po' di controllo.",shape=box,color=blue];
		955 -> 959;
	969 [label="Odio. Rabbia. Qualsiasi cosa.",shape=box,color=blue];
		969 -> 973;
	970 [label="Forse la speranza è un'illusione. Non lo so.",shape=box,color=blue];
		970 -> 974;
	971 [label="Ho allungato la mano verso Rusalka, ed è stato come se le mie dita le avessero toccato il viso e l'avessero attraversato. La maschera è semplicemente crollata.",shape=box,color=blue];
		971 -> 975;
	959 [label="Update boolean EleanorIndifference",color=orange];
		959 -> 972;
	973 [label="Meglio dell'apatia. Meglio della sottomissione docile.",shape=box,color=blue];
		973 -> 978;
	974 [label="In questo momento ne avrei proprio bisogno.",shape=box,color=blue];
		974 -> 977;
	975 [label="Quello che c'era sotto era tipo…",shape=box,color=blue];
		975 -> 976;
	972 [label="Ho toccato quella cosa con la mia mente. Pensavo di sondare la mente di Rusalka, ma… gli strati esterni sono semplicemente crollati come cartongesso bagnato e spugnoso e poi mi sono immersa. Dibattendomi.",shape=box,color=blue];
		972 -> 976;
	978 [label="Sono pronta.",shape=box,color=blue];
		978 -> 979;
	977 [label="E vabbè. Così sarà. Qualsiasi cosa accada, anche se dovessimo inciampare nel buio, almeno saremo insieme.",shape=box,color=blue];
		977 -> 980;
	976 [label="C'è una parola. ‘Calenture’. È una sorta di follia che colpiva i marinai. Erano convinti che il mare verde che li circondava non fosse affatto acqua, ma prato verde.",shape=box,color=blue];
		976 -> 981;
	979 [label="Chat ends.",color=orange];
	980 [label="Chat ends.",color=orange];
	981 [label="Sentivano il bisogno di saltare giù dalla nave nei magnifici prati verdi e di correre attraverso di essi. Se un compagno di bordo li avesse trattenuti, avrebbero combattuto.",shape=box,color=blue];
		981 -> 982;
	982 [label="Ho saltato, aspettandomi di trovare dell'erba. Invece un attimo dopo mi ritrovai nell'oscurità gelida.",shape=box,color=blue];
		982 -> 983;
	983 [label="Update boolean EleanorIndifference2",color=orange];
		983 -> 984;
		983 -> 986;
	984 [label="Non credo sia sicuro per te parlarne in questo modo.",shape=box,color=red];
		984 -> 985;
	986 [label="Sono qui. Continua.",shape=box,color=red];
		986 -> 987;
	985 [label="Beh, merda.",shape=box,color=blue];
		985 -> 988;
	987 [label="C'è un sentimento per il quale non ci sono parole. Guardi il mondo e SAI che tutta la banalità - gli edifici, le auto, le persone, i posti di lavoro, il lavoro, la routine - è solo un sottilissimo strato su un orrore senza fondo, e se la gente se ne rendesse conto, inizierebbe a urlare e non smetterebbe più.",shape=box,color=blue];
		987 -> 989;
	988 [label="Ero riuscita a malapena a prepararmi mentalmente per questo, e ora cosa succede? Non facciamo il nome del Diavolo, nel caso si faccia vivo?",shape=box,color=blue];
		988 -> 990;
	989 [label="Ho attraversato quella superficie.",shape=box,color=blue];
		989 -> 992;
	990 [label="Se dovessi sentire urlare nella notte, sono io.",shape=box,color=blue];
		990 -> 991;
	992 [label="Non era il vuoto. Sarei riuscita a sopportarlo. Andava avanti all'infinito, ma non era solo uno spazio freddo. C'era qualcosa lì con me.",shape=box,color=blue];
		992 -> 993;
		992 -> 994;
		992 -> 995;
	991 [label="Chat ends.",color=orange];
	993 [label="Un occhio?",shape=box,color=red];
		993 -> 997;
	994 [label="Un uomo intrappolato in un muro?",shape=box,color=red];
		994 -> 997;
	995 [label="Cos'era?",shape=box,color=red];
		995 -> 996;
	997 [label="Non lo so. Ma sapeva che ero lì. Era CONSAPEVOLE della mia presenza. Come un elefante si accorgerebbe di una mosca che gli cammina sull'occhio.",shape=box,color=blue];
		997 -> 998;
	996 [label="+5 Chemistry",color=orange];
		996 -> 997;
	998 [label="Ricordo di aver pensato ‘Niente di così grande dovrebbe sapere che esisto’.",shape=box,color=blue];
		998 -> 999;
	999 [label="Sentivo il suo incredibile disinteresse per me, un'indifferenza così monumentale che avrei voluto cessare di esistere sul posto.",shape=box,color=blue];
		999 -> 1000;
		999 -> 1001;
	1000 [label="Sì... lo capisco.",shape=box,color=red];
		1000 -> 1002;
	1001 [label="Che cosa hai fatto?",shape=box,color=red];
		1001 -> 1002;
	1002 [label="Penso che avrei potuto farcela se mi avesse odiato. Allora avrei avuto un certo valore, un certo significato. Ma mi vedeva come insignificante, e io vedevo ciò che vedeva. Ero un granello. Un nulla.",shape=box,color=blue];
		1002 -> 1003;
	1003 [label="Tutto ciò che ero stata, ogni momento di tenerezza, ogni risata, ogni frammento di Eleanor Nightingale svanirono in quella tempesta.",shape=box,color=blue];
		1003 -> 1004;
	1004 [label="Ho sentito la mia luce svanire e, giuro, un piccolo tremito di soddisfazione lo ha attraversato. Come se fosse contento di avermi schiacciata. Una pulce sotto l'unghia.",shape=box,color=blue];
		1004 -> 1005;
	1005 [label="Ma sei tornata, no? Sei ancora qui. Hai dimostrato che quella cosa si è sbagliata.",shape=box,color=red];
		1005 -> 1006;
	1006 [label="Davvero?",shape=box,color=blue];
		1006 -> 1007;
	1007 [label="È ancora là fuori, non è vero?",shape=box,color=blue];
		1007 -> 1008;
		1007 -> 1009;
	1008 [label="Sì, lo è. Ma anche tu sei ancora qui.",shape=box,color=red];
		1008 -> 1011;
	1009 [label="Le stelle non smettono di bruciare solo perché lo spazio è grande, freddo e buio.",shape=box,color=red];
		1009 -> 1010;
	1011 [label="Alla fine vince l'indifferenza, amico mio, non importa quante banalità gettiamo nell'abisso.",shape=box,color=blue];
		1011 -> 1012;
	1010 [label="Ma smetteranno di bruciare. Un giorno. La morte termica dell'Universo.",shape=box,color=blue];
		1010 -> 1011;
	1012 [label="Ecco il problema del non impazzire. Sei maledetto dalla chiarezza di pensiero.",shape=box,color=blue];
		1012 -> 1013;
	1013 [label="Sai cosa voglio dire. Avresti potuto romperti come un uovo di passero o bruciarti il cervello con le droghe fino a non sentire più nulla. E questo avrebbe fatto meno male di questa... consapevolezza.",shape=box,color=blue];
		1013 -> 1014;
	1014 [label="Non capisco perché tu non abbia ancora abbandonato questa conversazione.",shape=box,color=blue];
		1014 -> 1015;
		1014 -> 1016;
	1015 [label="Capisco l'entropia. Forse la Grande Indifferenza è la stessa cosa. Forse vince alla fine. Non lo so. Quello che so è che non la lascerò vincere ORA.",shape=box,color=red];
		1015 -> 1017;
	1016 [label="Sto aspettando che tu prenda una fottuta decisione. Vuoi scegliere la via più facile e impazzire? O alzare il culo da quel divano e combattere?",shape=box,color=red];
		1016 -> 1018;
	1017 [label="Se mai riusciremo a sopravvivere, lo faremo insieme.",shape=box,color=red];
		1017 -> 1020;
	1018 [label="COMBATTERE COME",shape=box,color=blue];
		1018 -> 1019;
	1020 [label="Quindi sopporti i miei lamenti di disperazione esistenziale come tattica di battaglia? Questo è molto Arthur da parte tua.",shape=box,color=blue];
		1020 -> 1021;
	1019 [label="È TUTTO QUESTO CHE TU E ARTHUR POTETE CAPIRE? COMBATTERE?",shape=box,color=blue];
		1019 -> 1022;
	1021 [label="In realtà che tu ci creda o no, mi importa di te.",shape=box,color=red];
		1021 -> 1027;
	1022 [label="LA TUA RISPOSTA ALLA MANCANZA DI SENSO DELL'ESISTENZA È \"TROVARE UN MODO PER AFFRONTARLA?\"",shape=box,color=blue];
		1022 -> 1023;
	1027 [label="Anche a me importa di te, amico. Siamo compagni di squadra. Ne abbiamo passate tante.",shape=box,color=blue];
		1027 -> 1028;
	1023 [label="Non riesco a credere che pensassi di avere anche solo una cosa in comune con te.",shape=box,color=blue];
		1023 -> 1024;
	1028 [label="È giusto avvertirti che la cara nave Eleanor potrebbe affondare, nel mare insanguinato o nella palude nera come la notte, e non vorrai essere a bordo quando ciò accade.",shape=box,color=blue];
		1028 -> 1030;
	1024 [label="Che stupido da parte mia.",shape=box,color=blue];
		1024 -> 1025;
	1030 [label="+20 Chemistry",color=orange];
		1030 -> 1029;
	1025 [label="Update boolean EleanorNoDate",color=orange];
		1025 -> 1026;
	1029 [label="Grazie. Dovresti andare. Starò bene. Davvero.",shape=box,color=blue];
		1029 -> 1031;
	1026 [label="Chat ends.",color=orange];
	1031 [label="Chat ends.",color=orange];
}