digraph {
	286 [label="EleanorRank2Convo1 begins.",color=orange];
		286 -> 287;
		286 -> 288;
		286 -> 289;
	287 [label="Sei davvero malata come Lettie sembra pensare?",shape=box,color=red];
		287 -> 290;
	288 [label="Come sta andando la tua personale Infestazione?",shape=box,color=red];
		288 -> 292;
	289 [label="Qual è il problema tra te e Lettie?",shape=box,color=red];
		289 -> 294;
	290 [label="Mettiamo le cose in chiaro. Lettie non pensa che io sia malata. Lettie pensa che io sia un demone.",shape=box,color=blue];
		290 -> 291;
	292 [label="Non è sgradevole, il che è più di quanto si possa dire per la maggior parte delle infestazioni parassitarie.",shape=box,color=blue];
		292 -> 293;
	294 [label="Hai sentito come mi chiama?",shape=box,color=blue];
		294 -> 295;
		294 -> 296;
	291 [label="Mi chiedo come sia avere una visione così romantica del mondo. Si potrebbe pensare che un medico si occupi di fatti misurabili. Dieci CC di questo, identificare i microbi di quello.",shape=box,color=blue];
		291 -> 303;
		291 -> 304;
	293 [label="Posso sentire i Technocyte nuotare nel mio sangue. Se chiudo gli occhi, vedo scintille come polvere di fata.",shape=box,color=blue];
		293 -> 299;
	295 [label="Onestamente no.",shape=box,color=red];
		295 -> 298;
	296 [label="‘La Bruja Metiche‘. La strega ficcanaso.",shape=box,color=red];
		296 -> 297;
	303 [label="Molto scientifico da parte tua. Pensavo che credessi in cose più spirituali?",shape=box,color=red];
		303 -> 308;
	304 [label="Sembra che tu ritenga che la parte della \"perdita di umanità\" sia esagerata.",shape=box,color=red];
		304 -> 309;
	299 [label="Mi fa bene. Riesci a capirlo?",shape=box,color=blue];
		299 -> 302;
	298 [label="‘La Bruja Metiche‘. La strega ficcanaso. Immagino potrebbe fare di peggio, considerando il suo vocabolario e il suo talento per le oscenità creative.",shape=box,color=blue];
		298 -> 300;
	297 [label="Sì. Lei se ne sta lì tutta contenta con le sue ampolle e le sue pozioni, le sue bottiglie di sangue e le sue scaglie di pelle, il suo esercito di ratti che scorazzano dappertutto, e ha la temerarietà di chiamare ME una strega.",shape=box,color=blue];
		297 -> 305;
		297 -> 306;
		297 -> 307;
	308 [label="Beh, sì. Vivendo come noi, come si potrebbe non credere nel mondo spirituale?",shape=box,color=blue];
		308 -> 313;
	309 [label="Sono ancora Eleanor Nightingale. Per me questo è più importante dell'essere ‘umana‘.",shape=box,color=blue];
		309 -> 314;
	302 [label="Tutto ciò che fa, lo fa per il sincero desiderio di sistemarmi e migliorarmi. Se sono veloce, letale e difficile da uccidere, sarò un buon ospite. Così adempie alla sua parte del nostro patto simbiotico dandomi pelle di squalo e zanne di lupo, oltre a una lingua come una frusta di cuoio.",shape=box,color=blue];
		302 -> 303;
		302 -> 304;
	300 [label="L'ho sentita dire a Quincy di fare cose piuttosto inventive con le attrezzature del parco giochi e con parti della sua anatomia che, devo ammetterlo, mi hanno lasciata a bocca aperta per un po' di tempo.",shape=box,color=blue];
		300 -> 301;
	305 [label="Capisco, non vi piacete.",shape=box,color=red];
		305 -> 310;
	306 [label="È sempre stato così tra voi?",shape=box,color=red];
		306 -> 311;
	307 [label="Pensa che perderai il controllo.",shape=box,color=red];
		307 -> 312;
	313 [label="Check boolean EleanorVoidLove",color=orange];
		313 -> 327 [label=true,color=green];
		313 -> 328 [label=false,color=brown];
	314 [label="Ho visto di cosa sono capaci gli esseri umani. Non siamo speciali. Anzi, stando a quello che ho visto nella tua testa, col tempo diventiamo ancora peggio.",shape=box,color=blue];
		314 -> 320;
	301 [label="Sì lei se ne sta lì tutta contenta con le sue ampolle e le sue pozioni, le sue bottiglie di sangue e le sue scaglie di pelle, il suo esercito di ratti che scorazzano dappertutto, e ha la temerarietà di chiamare ME una strega.",shape=box,color=blue];
		301 -> 305;
		301 -> 306;
		301 -> 307;
	310 [label="Non fraintendermi. Le FAREI la pipì addosso se fosse in fiamme.",shape=box,color=blue];
		310 -> 315;
	311 [label="Penso che tu possa indovinare la risposta a questa domanda.",shape=box,color=blue];
		311 -> 318;
	312 [label="Lo so. E a volte lo faccio. Ho un incubo ricorrente in cui le strappo la gola proprio mentre lei mi pianta una pallottola nel cuore.",shape=box,color=blue];
		312 -> 317;
	327 [label="Il Void è la prova positiva che lo spirituale è reale tanto quanto il materiale. Tutto ciò che la vostra gente ha fatto, a parte dargli un nome diverso, è stato sviluppare un mezzo affidabile per arrivarci e tornare indietro.",shape=box,color=blue];
		327 -> 328;
	328 [label="Ascolta. Solo perché ammetto l'esistenza di forze demoniache non significa che mi accontento di essere liquidata come tale.",shape=box,color=blue];
		328 -> 335;
	320 [label="Check boolean EleanorEntrati",color=orange];
		320 -> 324 [label=true,color=green];
		320 -> 325 [label=true,color=green];
		320 -> 326 [label=true,color=green];
		320 -> 325 [label=false,color=brown];
		320 -> 326 [label=false,color=brown];
	315 [label="Ma con i miei tempi.",shape=box,color=blue];
		315 -> 316;
	318 [label="Chat ends.",color=orange];
	317 [label="Ma avere paura di qualcosa non lo rende reale. Finora non ho avuto nessuna furia sanguinaria. ZERO.",shape=box,color=blue];
		317 -> 319;
	335 [label="Ciò che sta accadendo nel mio sistema è il risultato di atomi e molecole piuttosto banali che si muovono insieme in modi inaspettati e straordinari. Qualsiasi significato spirituale a ciò sarà impartito da me. Non da Lettie.",shape=box,color=blue];
		335 -> 336;
		335 -> 337;
		335 -> 338;
	324 [label="Vuoi semplicemente rinunciare? Sembri Figlio.",shape=box,color=red];
		324 -> 329;
	325 [label="Se ne seguissi gli obiettivi, te ne accorgeresti?",shape=box,color=red];
		325 -> 330;
	326 [label="Almeno il genoma umano è naturale.",shape=box,color=red];
		326 -> 331;
	316 [label="Chat ends.",color=orange];
	319 [label="Amir ha provocato più infortuni di me.",shape=box,color=blue];
		319 -> 321;
	336 [label="Capisco, non vi piacete.",shape=box,color=red];
		336 -> 339;
	337 [label="È sempre stato così tra voi?",shape=box,color=red];
		337 -> 341;
	338 [label="Pensa che perderai il controllo.",shape=box,color=red];
		338 -> 349;
	329 [label="Non l'ho mai detto.",shape=box,color=blue];
		329 -> 332;
	330 [label="Invece di seguire il piano di una doppia elica di nucleotidi? Sai, quella cosa che gli esseri umani fanno da quando hanno iniziato a camminare in modo eretto?",shape=box,color=blue];
		330 -> 333;
	331 [label="Persone come Viktor Vodyanoi - e che razza di soprannome è QUELLO da scegliere per te stesso - giustificano le loro opinioni retrograde sostenendo di essere \"naturale\". Fondamentalismo biologico. L'uomo come specchio del Divino e tutto il resto.",shape=box,color=blue];
		331 -> 334;
	321 [label="Ma Amir è dolce e un po' svampito, non è vero? Amir non ha denti tali da poter rosicchiare e aprire una scatoletta di razioni. Quindi nessuno vede Amir come una bomba pronta a esplodere.",shape=box,color=blue];
		321 -> 322;
	339 [label="Non fraintendermi. Le FAREI la pipì addosso se fosse in fiamme.",shape=box,color=blue];
		339 -> 343;
	341 [label="Penso che tu possa indovinare la risposta a questa domanda.",shape=box,color=blue];
		341 -> 340;
	349 [label="+10 Chemistry",color=orange];
		349 -> 342;
	332 [label="Alcune persone pensavo che l'umanità sia sacra. Persone come Viktor. Io sono blasfemia ai suoi occhi. Infetta, sfacciata e donna.",shape=box,color=blue];
		332 -> 351;
		332 -> 354;
	333 [label="\"Io non eseguo gli ordini di un tiranno microscopico! Io sono un essere umano. Io sono speciale! Trova un compagno. Riproduciti. Proteggi il territorio. Ug.\"",shape=box,color=blue];
		333 -> 351;
		333 -> 354;
	334 [label="Ma siamo stati innaturali dal momento in cui abbiamo iniziato a sbattere le pietre l'una contro l'altra. Il linguaggio è un virus, amico. Essere umani è la pagina bianca su cui possiamo scarabocchiare, non l'Eden primordiale da cui siamo stati cacciati.",shape=box,color=blue];
		334 -> 351;
		334 -> 354;
	322 [label="Beh. Tranne Quincy.",shape=box,color=blue];
		322 -> 323;
	343 [label="Ma con i miei tempi.",shape=box,color=blue];
		343 -> 344;
	340 [label="Chat ends.",color=orange];
	342 [label="Lo so. E a volte lo faccio. Ho un incubo ricorrente in cui le strappo la gola proprio mentre lei mi pianta una pallottola nel cuore.",shape=box,color=blue];
		342 -> 345;
	351 [label="Il Techrot potrebbe impossessarsi della tua mente senza che tu lo sappia.",shape=box,color=red];
		351 -> 352;
	354 [label="L'ho visto assorbire intere LUNE, Eleanor!",shape=box,color=red];
		354 -> 355;
	323 [label="Chat ends.",color=orange];
	344 [label="Chat ends.",color=orange];
	345 [label="Ma avere paura di qualcosa non lo rende reale. Finora non ho avuto nessuna furia sanguinaria. ZERO.",shape=box,color=blue];
		345 -> 346;
	352 [label="Voglio dire… sì. Hai ragione. Ci sono parassiti che fanno così.",shape=box,color=blue];
		352 -> 353;
	355 [label="E cosa c'è di così dannatamente meraviglioso nell'essere una luna non assorbita? Perché la versione Infested non è un miglioramento?",shape=box,color=blue];
		355 -> 356;
	346 [label="Amir ha provocato più infortuni di me.",shape=box,color=blue];
		346 -> 347;
	353 [label="Ma se non fosse un parassita? Se fosse un simbionte?",shape=box,color=blue];
		353 -> 359;
		353 -> 360;
	356 [label="Oh no! Un grumo di roccia spaziale indifferente che avrebbe potuto vagare senza meta per altri millenni è improvvisamente viva e interessante! Che catastrofe!",shape=box,color=blue];
		356 -> 357;
	347 [label="Ma Amir è dolce e un po' svampito, non è vero? Amir non ha denti tali da poter rosicchiare e aprire una scatoletta di razioni. Quindi nessuno vede Amir come una bomba pronta a esplodere.",shape=box,color=blue];
		347 -> 348;
	359 [label="Non sai di cosa stai parlando. Quando qualcuno è perso a causa dell'Infestazione, sono PERSI. Completamente irriconoscibili.",shape=box,color=red];
		359 -> 361;
	360 [label="Capisco che devi provare ad accettare ciò che sei diventata. Stai affrontando una sfida impossibile.",shape=box,color=red];
		360 -> 362;
	357 [label="Sono esattamente le stesse stronzate che la squadra di Viktor tira fuori. Aggrapparsi sentimentalmente a qualsiasi cosa fosse STATA.",shape=box,color=blue];
		357 -> 358;
	348 [label="Beh. Tranne Quincy.",shape=box,color=blue];
		348 -> 350;
	361 [label="Non so se stai cercando di provocarmi, ma ho dovuto lottare per la mia vita contro queste cose. A volte riesci a distinguere i pezzi che un tempo erano umani. Teste e piedi che spuntano nella massa.",shape=box,color=red];
		361 -> 363;
	362 [label="O odi ciò che sei diventato o lo accetti. E qualcosa mi dice che sei una persona che ha imparato a smettere di odiare se stessa molto tempo fa.",shape=box,color=red];
		362 -> 364;
	358 [label="Come se essere primordiali fosse la stessa cosa che essere perfetti.",shape=box,color=blue];
		358 -> 359;
		358 -> 360;
	350 [label="Chat ends.",color=orange];
	363 [label="Non è un simbionte. Non gli IMPORTA cosa vuoi. Non è qui per aiutarti. È un cancro aggressivo di una forma di vita che vuole solo trasformare tutto il resto in se stesso.",shape=box,color=red];
		363 -> 365;
	364 [label="Ma questi demoni nel tuo sangue NON sono tuoi amici. Il meglio che puoi fare è tenerli al guinzaglio, Eleanor. Fidati. Di. Me.",shape=box,color=red];
		364 -> 366;
	365 [label="Ricordami di nuovo, di cosa sono fatti i tuoi Warframe?",shape=box,color=blue];
		365 -> 369;
	366 [label="Credi che non lo sappia?",shape=box,color=blue];
		366 -> 367;
	369 [label="Esseri umani infestati.",shape=box,color=red];
		369 -> 370;
	367 [label="Hai idea di cosa ci vuole per tenere a freno la rabbia? Sai qual è il prezzo di questa serenità esteriore?",shape=box,color=blue];
		367 -> 368;
	370 [label="Ma la loro infestazione era stata pianificata e controllata, non è vero?",shape=box,color=blue];
		370 -> 371;
	368 [label="Se mi vedi meditare, non sto comunicando con il grande cavolo cosmico. Sto raffreddando il fottuto reattore.",shape=box,color=blue];
		368 -> 372;
	371 [label="Proprio come l'Infestazione che è dentro di me.",shape=box,color=blue];
		371 -> 373;
	372 [label="Ci sono COSÌ tante cose che potrei fare e NON FACCIO. Posti in cui potrei portare questa... roba... che non hai nemmeno preso in considerazione.",shape=box,color=blue];
		372 -> 374;
	373 [label="Ciò significa che qualcuno, da qualche parte, ha avuto il coraggio di smettere di pensare all'Infestazione come a un mostro senza cervello e di iniziare a riflettere su cosa sarebbe potuta diventare.",shape=box,color=blue];
		373 -> 376;
		373 -> 377;
	374 [label="Potrei entrare nei loro SOGNI. E non se ne renderebbero nemmeno conto.",shape=box,color=blue];
		374 -> 380;
	376 [label="Oh, non hai appena detto che Ballas ''ha coraggio''.",shape=box,color=red];
		376 -> 385;
	377 [label="Quindi… pensi di star diventando più te stessa? non meno?",shape=box,color=red];
		377 -> 382;
	380 [label="+20 Chemistry",color=orange];
		380 -> 375;
	385 [label="+10 Chemistry",color=orange];
		385 -> 378;
	382 [label="+20 Chemistry",color=orange];
		382 -> 379;
	375 [label="Beh. È stato uno scambio di opinioni interessante, anche se poco raffinato. Mi sono divertita. Da rifare.",shape=box,color=blue];
		375 -> 381;
	378 [label="Sai, stai diventando molto emotivo. Concluderemo questa conversazione un'altra volta.",shape=box,color=blue];
		378 -> 384;
	379 [label="L'ultima volta che sono stata colpita da una mazza biochimica che mi ha costretto a stare sdraiata sul divano per mezza giornata, la gente sussurrava alle mie spalle riguardo la mia trasformazione in un mostro, si chiamava \"pubertà\".",shape=box,color=blue];
		379 -> 383;
