digraph {
	"EleanorRank6Convo2 begins." [color=orange];
		"EleanorRank6Convo2 begins." -> j784281902;
	j784281902 [label="Ciao. Ho bisogno di scambiare qualche idea con te.",shape=box,color=blue];
		j784281902 -> j2945656057;
	j2945656057 [label="Stavo pensando a Fiendsnight. Non mi travesto da anni, ma stavo sfogliando un fumetto di Amir e all'improvviso ho pensato: aspetta, potrei fare la Contessa! Ho già i canini e tutto il resto!",shape=box,color=blue];
		j2945656057 -> j2383664808;
	j2383664808 [label="Ma non è troppo banale? Dovrei fare Dandy Damage?",shape=box,color=blue];
		j2383664808 -> j3184250253;
		j2383664808 -> j2289601123;
		j2383664808 -> j795183234;
	j3184250253 [label="Chi è Dandy Damage?",shape=box,color=red];
		j3184250253 -> j82807215;
	j2289601123 [label="Potresti sempre vestirti da Lotus, se vuoi confondere le persone.",shape=box,color=red];
		j2289601123 -> j967959725;
	j795183234 [label="… dovrai dirmi cos'è Fiendsnight.",shape=box,color=red];
		j795183234 -> j2398154942;
	j82807215 [label="Oddio. ",shape=box,color=blue];
		j82807215 -> j2824568022;
	j967959725 [label="Oddio, no. L'ho vista nella tua mente. Non potrei mai renderle giustizia.",shape=box,color=blue];
		j967959725 -> j2165896005;
	j2398154942 [label="Mmh. A volte mi dimentico che sei uno straniero innocente. ",shape=box,color=blue];
		j2398154942 -> j155555214;
	j2824568022 [label="Dandy Damage ha camminato in modo che i Temple and the Rippers potessero correre. Era l'incubo di ogni madre e il sogno di ogni catastrofe adolescenziale.",shape=box,color=blue];
		j2824568022 -> j135020026;
	j2165896005 [label="E quel casco. È un casco? Fa parte di lei? Come fa a vederci attraverso?",shape=box,color=blue];
		j2165896005 -> j2599983311;
	j155555214 [label="Fiendsnight celebra la scomparsa dell'influenza di Sol sul mondo.",shape=box,color=blue];
		j155555214 -> j785707958;
	j135020026 [label="La costituzione di un insetto stecco, truccato come una regina del cinema muto. Una bocca di caramella. Gessato, pelle e guinzaglio per cani. Gli zigomi come i fianchi di uno scheletro.",shape=box,color=blue];
		j135020026 -> j420602670;
		j135020026 -> j3942568871;
	j2599983311 [label="In ogni caso, sono tre persone in un solo corpo. Non potrei mai sceglierne una.",shape=box,color=blue];
		j2599983311 -> j420602670;
		j2599983311 -> j3942568871;
	j785707958 [label="Il che, a primo impatto, non ha molto senso. Perché celebrare l'avanzata dell'oscurità? Perché gioire dell'illegalità e dell'anarchia?",shape=box,color=blue];
		j785707958 -> j2918857120;
	j420602670 [label="Travestirsi? Fare festa? In una zona di guerra? Pensi davvero che succederà?",shape=box,color=red];
		j420602670 -> j2322081078;
	j3942568871 [label="Sai, Fiendsnight ricorda molto Naberus. Alla gente piace travestirsi durante quel periodo.",shape=box,color=red];
		j3942568871 -> j2322081078;
	j2918857120 [label="Credo che sia una specie di vaccino, forse. Un pizzico di ciò che temiamo, per rafforzarci. O forse è solo una scusa per indossare la maschera del diavolo e scatenare l'inferno.",shape=box,color=blue];
		j2918857120 -> j420602670;
		j2918857120 -> j3942568871;
	j2322081078 [label="... Probabilmente mi sto comportando da sciocca. Infantile. Non è così?",shape=box,color=blue];
		j2322081078 -> j3079583208;
	j3079583208 [label="Oh, ma cosa sto pensando.",shape=box,color=blue];
		j3079583208 -> j1085217646;
	j1085217646 [label="Non ho bisogno di travestirmi, vero? Sono già un mostro. Sempre e per sempre.",shape=box,color=blue];
		j1085217646 -> j2436064064;
	j2436064064 [label="Check boolean EleanorDating",color=orange];
		j2436064064 -> j1844624667 [label=true,color=green];
		j2436064064 -> j2933335335 [label=true,color=green];
		j2436064064 -> j379672146 [label=true,color=green];
		j2436064064 -> j2933335335 [label=false,color=brown];
		j2436064064 -> j379672146 [label=false,color=brown];
	j1844624667 [label="Sei il mostro che amo, Eleanor. Non mi pento di nulla.",shape=box,color=red];
		j1844624667 -> j626658620;
	j2933335335 [label="Comincio a pensare che ti piaccia dire questo di te stessa.",shape=box,color=red];
		j2933335335 -> j109112520;
	j379672146 [label="No. Ai veri mostri non importa delle persone come a te.",shape=box,color=red];
		j379672146 -> j151493828;
	j626658620 [label="+5 Chemistry",color=orange];
		j626658620 -> j1466146476;
	j109112520 [label="Se questo è ciò che credi veramente di essere, allora Fiendsnight è l'occasione perfetta per festeggiarlo.",shape=box,color=red];
		j109112520 -> j3282211264;
		j109112520 -> j151493828;
	j151493828 [label="So che hai paura di quello che potresti diventare. Ma ORA non lo sei.",shape=box,color=red];
		j151493828 -> j2283115952;
	j1466146476 [label="Oh sì! Che sciocca! Mi ero dimenticata che il mostro ha avuto il suo lieto fine nella nostra piccola storia.",shape=box,color=blue];
		j1466146476 -> j304438562;
	j3282211264 [label="SII il mostro. Prendine possesso. Per questa notte dell'anno, indossa quel titolo con orgoglio.",shape=box,color=red];
		j3282211264 -> j3160291822;
	j2283115952 [label="Quindi travestiti. Divertiti. Il Void sa che l'Hex ha bisogno di divertirsi un po'.",shape=box,color=red];
		j2283115952 -> j3804281930;
	j304438562 [label="Perdonami. Non riesco ancora a credere che sia davvero questo ciò che VUOI. Forse ho solo bisogno di essere persuasa ancora un po'.",shape=box,color=blue];
		j304438562 -> j2487595899;
	j3160291822 [label="Oh, ci sono COSÌ TANTE ragioni per cui questa è un'IDEA TERRIBILE",shape=box,color=blue];
		j3160291822 -> j1230234753;
	j3804281930 [label="Accetto volentieri la proposta. E grazie. Di nuovo. x",shape=box,color=blue];
		j3804281930 -> "Chat ends.";
	j2487595899 [label="Divoriamoci a vicenda più tardi. xxx",shape=box,color=blue];
		j2487595899 -> "Chat ends.";
	j1230234753 [label="DAVVERO. TANTE.",shape=box,color=blue];
		j1230234753 -> j2121476769;
	"Chat ends." [color=orange];
	j2121476769 [label="(Al momento non me ne viene in mente nessuna, ma sono sicura che ce ne siano DECINE)",shape=box,color=blue];
		j2121476769 -> j1928093433;
	j1928093433 [label="... merda.",shape=box,color=blue];
		j1928093433 -> j675166557;
	j675166557 [label="mi hai infilzata agilmente sul mio stesso kebab. accidenti a te. ben fatto. x",shape=box,color=blue];
		j675166557 -> "Chat ends.";
}