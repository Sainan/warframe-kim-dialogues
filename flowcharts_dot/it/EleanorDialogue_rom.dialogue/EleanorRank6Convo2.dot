digraph {
	2845 [label="EleanorRank6Convo2 begins.",color=orange];
		2845 -> 2846;
	2846 [label="Ciao. Ho bisogno di scambiare qualche idea con te.",shape=box,color=blue];
		2846 -> 2847;
	2847 [label="Stavo pensando a Fiendsnight. Non mi travesto da anni, ma stavo sfogliando un fumetto di Amir e all'improvviso ho pensato: aspetta, potrei fare la Contessa! Ho già i canini e tutto il resto!",shape=box,color=blue];
		2847 -> 2848;
	2848 [label="Ma non è troppo banale? Dovrei fare Dandy Damage?",shape=box,color=blue];
		2848 -> 2849;
		2848 -> 2850;
		2848 -> 2851;
	2849 [label="Chi è Dandy Damage?",shape=box,color=red];
		2849 -> 2852;
	2850 [label="Potresti sempre vestirti da Lotus, se vuoi confondere le persone.",shape=box,color=red];
		2850 -> 2853;
	2851 [label="… dovrai dirmi cos'è Fiendsnight.",shape=box,color=red];
		2851 -> 2854;
	2852 [label="Oddio. ",shape=box,color=blue];
		2852 -> 2855;
	2853 [label="Oddio, no. L'ho vista nella tua mente. Non potrei mai renderle giustizia.",shape=box,color=blue];
		2853 -> 2856;
	2854 [label="Mmh. A volte mi dimentico che sei uno straniero innocente. ",shape=box,color=blue];
		2854 -> 2857;
	2855 [label="Dandy Damage ha camminato in modo che i Temple and the Rippers potessero correre. Era l'incubo di ogni madre e il sogno di ogni catastrofe adolescenziale.",shape=box,color=blue];
		2855 -> 2858;
	2856 [label="E quel casco. È un casco? Fa parte di lei? Come fa a vederci attraverso?",shape=box,color=blue];
		2856 -> 2859;
	2857 [label="Fiendsnight celebra la scomparsa dell'influenza di Sol sul mondo.",shape=box,color=blue];
		2857 -> 2860;
	2858 [label="La costituzione di un insetto stecco, truccato come una regina del cinema muto. Una bocca di caramella. Gessato, pelle e guinzaglio per cani. Gli zigomi come i fianchi di uno scheletro.",shape=box,color=blue];
		2858 -> 2861;
		2858 -> 2862;
	2859 [label="In ogni caso, sono tre persone in un solo corpo. Non potrei mai sceglierne una.",shape=box,color=blue];
		2859 -> 2861;
		2859 -> 2862;
	2860 [label="Il che, a primo impatto, non ha molto senso. Perché celebrare l'avanzata dell'oscurità? Perché gioire dell'illegalità e dell'anarchia?",shape=box,color=blue];
		2860 -> 2863;
	2861 [label="Travestirsi? Fare festa? In una zona di guerra? Pensi davvero che succederà?",shape=box,color=red];
		2861 -> 2864;
	2862 [label="Sai, Fiendsnight ricorda molto Naberus. Alla gente piace travestirsi durante quel periodo.",shape=box,color=red];
		2862 -> 2864;
	2863 [label="Credo che sia una specie di vaccino, forse. Un pizzico di ciò che temiamo, per rafforzarci. O forse è solo una scusa per indossare la maschera del diavolo e scatenare l'inferno.",shape=box,color=blue];
		2863 -> 2861;
		2863 -> 2862;
	2864 [label="... Probabilmente mi sto comportando da sciocca. Infantile. Non è così?",shape=box,color=blue];
		2864 -> 2865;
	2865 [label="Oh, ma cosa sto pensando.",shape=box,color=blue];
		2865 -> 2866;
	2866 [label="Non ho bisogno di travestirmi, vero? Sono già un mostro. Sempre e per sempre.",shape=box,color=blue];
		2866 -> 2867;
	2867 [label="Check boolean EleanorDating",color=orange];
		2867 -> 2868 [label=true,color=green];
		2867 -> 2869 [label=true,color=green];
		2867 -> 2870 [label=true,color=green];
		2867 -> 2869 [label=false,color=brown];
		2867 -> 2870 [label=false,color=brown];
	2868 [label="Sei il mostro che amo, Eleanor. Non mi pento di nulla.",shape=box,color=red];
		2868 -> 2871;
	2869 [label="Comincio a pensare che ti piaccia dire questo di te stessa.",shape=box,color=red];
		2869 -> 2872;
	2870 [label="No. Ai veri mostri non importa delle persone come a te.",shape=box,color=red];
		2870 -> 2873;
	2871 [label="+5 Chemistry",color=orange];
		2871 -> 2874;
	2872 [label="Se questo è ciò che credi veramente di essere, allora Fiendsnight è l'occasione perfetta per festeggiarlo.",shape=box,color=red];
		2872 -> 2875;
		2872 -> 2873;
	2873 [label="So che hai paura di quello che potresti diventare. Ma ORA non lo sei.",shape=box,color=red];
		2873 -> 2876;
	2874 [label="Oh sì! Che sciocca! Mi ero dimenticata che il mostro ha avuto il suo lieto fine nella nostra piccola storia.",shape=box,color=blue];
		2874 -> 2877;
	2875 [label="SII il mostro. Prendine possesso. Per questa notte dell'anno, indossa quel titolo con orgoglio.",shape=box,color=red];
		2875 -> 2878;
	2876 [label="Quindi travestiti. Divertiti. Il Void sa che l'Hex ha bisogno di divertirsi un po'.",shape=box,color=red];
		2876 -> 2879;
	2877 [label="Perdonami. Non riesco ancora a credere che sia davvero questo ciò che VUOI. Forse ho solo bisogno di essere persuasa ancora un po'.",shape=box,color=blue];
		2877 -> 2880;
	2878 [label="Oh, ci sono COSÌ TANTE ragioni per cui questa è un'IDEA TERRIBILE",shape=box,color=blue];
		2878 -> 2881;
	2879 [label="Accetto volentieri la proposta. E grazie. Di nuovo. x",shape=box,color=blue];
		2879 -> 2882;
	2880 [label="Divoriamoci a vicenda più tardi. xxx",shape=box,color=blue];
		2880 -> 2883;
	2881 [label="DAVVERO. TANTE.",shape=box,color=blue];
		2881 -> 2884;
	2882 [label="Chat ends.",color=orange];
	2883 [label="Chat ends.",color=orange];
	2884 [label="(Al momento non me ne viene in mente nessuna, ma sono sicura che ce ne siano DECINE)",shape=box,color=blue];
		2884 -> 2885;
	2885 [label="... merda.",shape=box,color=blue];
		2885 -> 2886;
	2886 [label="mi hai infilzata agilmente sul mio stesso kebab. accidenti a te. ben fatto. x",shape=box,color=blue];
		2886 -> 2887;
	2887 [label="Chat ends.",color=orange];
}