	2314 [label="Chat ends.",color=orange];
	2315 [label="Farò un patto con te. Vai da Lettie, chiedile di farti una rapida valutazione psicologica, di arrivare in fondo a qualsiasi cosa ti stia DAVVERO passando per la testa, e poi dimentichiamoci totalmente di questa conversazione.",shape=box,color=blue];
