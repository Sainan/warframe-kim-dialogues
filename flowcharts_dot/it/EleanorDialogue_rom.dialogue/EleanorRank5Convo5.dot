		2481 -> 2484;
	2482 [label="Potrebbe essere importante. Con le tue capacità, un sogno potrebbe non essere solo un sogno.",shape=box,color=red];
		2482 -> 2485;
	2475 [label="Quello non sarebbe stato imbarazzante. Questo lo è.",shape=box,color=blue];
		2475 -> 2478;
	2476 [label="Per gli dei, magari. Niente di così piacevole, temo.",shape=box,color=blue];
		2476 -> 2478;
	2477 [label="Non preoccuparti. Non è un problema in sé. Non sono spaventata. È solo che...",shape=box,color=blue];
		2477 -> 2478;
	2483 [label="Infatti non lo faccio, ed è per questo che la cosa è così preoccupante.",shape=box,color=blue];
		2483 -> 2486;
	2484 [label="No, non quello. Strano però che tutti sembrino averlo avuto.",shape=box,color=blue];
		2484 -> 2486;
	2485 [label="Questo è esattamente ciò che mi spaventa.",shape=box,color=blue];
		2485 -> 2486;
