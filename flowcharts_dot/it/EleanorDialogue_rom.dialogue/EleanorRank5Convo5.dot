	2529 [label="+20 Chemistry",color=orange];
		2529 -> 2534;
	2531 [label="Solo... se mi vedi particolarmente stanca e smunta una mattina in particolare quando ci svegliamo insieme, per favore portami un bel caffè forte e non insistere per i dettagli.",shape=box,color=blue];
		2531 -> 2535;
		2531 -> 2536;
	2532 [label="Ti piacerebbe dare al Techrot qualcosa di cui essere VERAMENTE invidioso?",shape=box,color=blue];
