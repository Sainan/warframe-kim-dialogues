		2518 -> 2522 [label=false,color=brown];
	2519 [label="Beh, immagino che la nostra relazione possa finire qua. Come posso competere con ciò?",shape=box,color=red];
		2519 -> 2523;
	2520 [label="*Brucerò tutto* prima che possa prenderti, lo giuro.",shape=box,color=red];
		2520 -> 2524;
	2521 [label="Non lascerò mai che ti prenda, Eleanor. Sei mia amica.",shape=box,color=red];
		2521 -> 2525;
	2522 [label="Sei una di famiglia per me. Non lascerò che ti prenda.",shape=box,color=red];
		2522 -> 2526;
	2523 [label="+20 Chemistry",color=orange];
		2523 -> 2530;
	2524 [label="Questo sì che è il genere di discorsi che trasformerebbe un Drifter in un Drifter sbaciucchiato.",shape=box,color=blue];
		2524 -> 2527;
	2525 [label="Lo so. Penso che lo sappia anche il Techrot, ed è per questo che è così arrabbiato. Non può competere.",shape=box,color=blue];
		2525 -> 2528;
	2526 [label="Dormirò più tranquilla sapendo che ci sei tu a coprirmi le spalle.",shape=box,color=blue];
		2526 -> 2529;
	2530 [label="Non preoccuparti, amore mio. Non ti ho intenzione di lasciarti per una massa putrescente di carne tubercolare con grumi di tecnologia orfana che galleggiano al suo interno.",shape=box,color=blue];
		2530 -> 2531;
