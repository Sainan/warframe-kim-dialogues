	2469 [label="Check boolean EleanorDating",color=orange];
		2469 -> 2470 [label=true,color=green];
		2469 -> 2471 [label=false,color=brown];
	2470 [label="Ma da quando stiamo insieme, è successo qualcos'altro. È un po' imbarazzante, in realtà. Volevo parlarne con te, ma non è stato un bel periodo.",shape=box,color=blue];
		2470 -> 2472;
		2470 -> 2473;
