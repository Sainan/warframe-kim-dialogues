		2493 -> 2497;
	2496 [label="A un livello profondamente confuso, pensa a me come a una sua proprietà. Ero destinata a essere la sua prospettiva riproduttiva. I Legacyte mi vedono come una regina rivale, sai.",shape=box,color=blue];
		2496 -> 2498;
		2496 -> 2499;
	2497 [label="A un livello profondamente confuso, pensa a me come a una sua proprietà. Ero destinata a essere la sua prospettiva riproduttiva. I Legacyte mi vedono come una regina rivale, sai.",shape=box,color=blue];
		2497 -> 2500;
		2497 -> 2501;
	2498 [label="Non è così che funzionano i Warframe. L'Infestazione in essi è domata, è dormiente. Tranne Nidus, credo, ma lui è una legge a sé stante.",shape=box,color=red];
		2498 -> 2503;
	2499 [label="Quindi il Techrot pensa che io ti abbia rubato e ora ti vuole indietro?",shape=box,color=red];
		2499 -> 2504;
	2500 [label="Non è così che funzionano i Warframe. L'Infestazione in essi è domata, è dormiente. Tranne Nidus, credo, ma lui è una legge a sé stante.",shape=box,color=red];
		2500 -> 2502;
	2501 [label="Quindi il Techrot pensa che io ti stia impedendo di tornare da lui?",shape=box,color=red];
		2501 -> 2505;
	2503 [label="Beh, forse se fossi un Warframe completo, il Techrot non mi vedrebbe in questo modo. Così com'è, le mie cellule stanno ancora friggendo e mi vede come se fossi sua.",shape=box,color=blue];
		2503 -> 2506;
	2504 [label="Non è bizzarro? L'ex abbandonato!",shape=box,color=blue];
		2504 -> 2506;
	2502 [label="Beh, forse se fossi un Warframe completo, il Techrot non mi vedrebbe in questo modo. Così com'è, le mie cellule stanno ancora friggendo e mi vede come se fossi sua.",shape=box,color=blue];
		2502 -> 2507;
	2505 [label="Sì. Mi vuole di nuovo nella sua banda.",shape=box,color=blue];
		2505 -> 2507;
	2506 [label="Da dove vengo io, dovresti andare a litigare con lui nel retro del supermercato locale. Non so come funziona ai tuoi tempi.",shape=box,color=blue];
		2506 -> 2508;
	2507 [label="Questa è la tua VERA famiglia, mi sussurra. Torna a far parte di noi, sorella separata. Sii accettata.",shape=box,color=blue];
		2507 -> 2508;
	2508 [label="Aspetta, torna un po' indietro. Come fai a sapere che il Techrot si sente così?",shape=box,color=red];
		2508 -> 2509;
	2509 [label="Oh per gli dei, questa è la parte più imbarazzante.",shape=box,color=blue];
		2509 -> 2510;
	2510 [label="I sogni di cui ho parlato prima? Sono certa che li mandi il Techrot.",shape=box,color=blue];
		2510 -> 2511;
	2511 [label="Qualunque cosa quella roba abbia come mente, è sempre stata in grado di connettersi con la mia. I pensieri che invia sono sempre così crudi e deboli che posso facilmente respingerli.",shape=box,color=blue];
		2511 -> 2512;
	2512 [label="Il più delle volte sento solo un frenetico grattare nella parte posteriore del cranio, come quando sei in bagno e c'è un gatto che cerca di aprire la porta.",shape=box,color=blue];
		2512 -> 2513;
		2512 -> 2514;
	2513 [label="Ma quando dormi è tutta un'altra storia, giusto?",shape=box,color=red];
		2513 -> 2515;
	2514 [label="Penso di aver capito dove stiamo andando a parare.",shape=box,color=red];
		2514 -> 2515;
	2515 [label="Giusto. Le mie difese sono abbassate e può raggiungermi.",shape=box,color=blue];
		2515 -> 2516;
	2516 [label="Mi ha colpita a un livello più primordiale, se capisci cosa intendo. Mi vuole con sé. Promette che potrà farmi provare un'estasi mai provata prima.",shape=box,color=blue];
		2516 -> 2517;
	2517 [label="Pianterà nella mia carne delle cisti stillanti di vita nuova. Perché pensa che sia quello che voglio, capisci.",shape=box,color=blue];
		2517 -> 2518;
