digraph {
	1458 [label="EleanorMonster begins.",color=orange];
		1458 -> 1459;
	1459 [label="Drifter. Quello che hai detto ieri. A proposito di lasciare in vita il mostro. Lo pensavi davvero? Devo saperlo.",shape=box,color=blue];
		1459 -> 1460;
		1459 -> 1461;
		1459 -> 1462;
	1460 [label="Certo che lo penso davvero.",shape=box,color=red];
		1460 -> 1464;
	1461 [label="Onestamento? Ci ho pensato. E, no. Dovrei fermarti se diventassi un mostro.",shape=box,color=red];
		1461 -> 1465;
	1462 [label="[Ignora.]",shape=box,color=red];
		1462 -> 1463;
	1464 [label="Non che non sia estremamente grata e onestamente un po' scioccata, ma... perché? PERCHÉ mi lasceresti vivere? Quando tutti gli altri qui sarebbero così disposti a spararmi una pallottola in testa?",shape=box,color=blue];
		1464 -> 1466;
		1464 -> 1467;
	1465 [label="Grazie. Per me sei un enigma in molti aspetti, ma ora so che saresti disposto a spararmi in testa, e questo genere di cose è importante sul posto di lavoro.",shape=box,color=blue];
		1465 -> 1468;
	1463 [label="Chat ends.",color=orange];
	1466 [label="Il confine tra \"eroe\" e \"mostro\" è più sfumato di quanto la maggior parte delle persone voglia ammettere. Ho combattuto contro Grineer e Corpus e ho combattuto al loro fianco.",shape=box,color=red];
		1466 -> 1473;
	1467 [label="Perché penso che tu sia una delle persone più ferocemente intelligenti e meravigliosamente sarcastiche che abbia mai incontrato. Non credo che nemmeno il Techrot potrebbe toglierti questo.",shape=box,color=red];
		1467 -> 1472;
	1468 [label="Eee ho appena sentito il Techrot nelle mie cellule avere un piccolo tremito ansioso.",shape=box,color=blue];
		1468 -> 1469;
	1473 [label="Non credo alle parole \"Bene\" e \"Male\". Solo alle persone. Perché hai meno diritto di esistere di me? Potrei anche non avere una lingua da Techrot, ma sono anche io uno scherzo della natura.",shape=box,color=red];
		1473 -> 1474;
	1472 [label="Quanto... meravigliosamente ingenuo. E meravigliosamente dolce, in un modo tragico.",shape=box,color=blue];
		1472 -> 1475;
	1469 [label="Penso che d'ora in poi si comporterà un po' meglio. Non c'è niente di meglio che minacciare l'ospite per mettere la paura di Sol nel parassita, eh?",shape=box,color=blue];
		1469 -> 1470;
	1474 [label="Ma eccoti qui, a combattere contro Scaldra e Techrot, cercando di trovare un modo per fermare l'Indifferenza. Credi chiaramente che ci sia una linea da tracciare da qualche parte.",shape=box,color=blue];
		1474 -> 1476;
		1474 -> 1477;
	1475 [label="Il fatto che tu creda che ne uscirei come una specie di ape regina, con me intatta, una bizzarra voce dell'infestazione con cui potresti fare amicizia o forse persino adorare.",shape=box,color=blue];
		1475 -> 1479;
	1470 [label="Update boolean EleanorNoDate",color=orange];
		1470 -> 1471;
	1476 [label="L'Indifferenza è stata scatenata da Entrati. Un uomo. La colpa è dell'arroganza umana.",shape=box,color=red];
		1476 -> 1483;
	1477 [label="Proteggere le persone dalla morte non è la stessa cosa che credere che qualcosa debba essere sterminato o che non abbia il diritto di esistere.",shape=box,color=red];
		1477 -> 1478;
	1479 [label="Ti rimprovererei per il fatto che il mondo non funziona come un libro di fiabe, eppure... mi viene ricordato esattamente chi sei e da dove vieni.",shape=box,color=blue];
		1479 -> 1480;
	1471 [label="Chat ends.",color=orange];
	1483 [label="Ma il Techrot non è l'Indifferenza. E questo? E la minaccia più biologica e terrestre?",shape=box,color=blue];
		1483 -> 1485;
		1483 -> 1486;
	1478 [label="Garantire che un gregge di pecore non venga mangiato dai lupi non è la stessa cosa che andare a uccidere tutti i lupi perché sono malvagi.",shape=box,color=red];
		1478 -> 1484;
	1480 [label="Quindi suppongo che non dovrei sorprendermi.",shape=box,color=blue];
		1480 -> 1481;
	1485 [label="Non sappiamo davvero da dove provenga il Techrot. Potrebbe essere stato creato dall'uomo. Potrebbe essere stato creato da qualcos'altro.",shape=box,color=red];
		1485 -> 1488;
	1486 [label="Il fatto è che non vuoi che ti uccida. Quindi non lo farei. Ti lascerei andare.",shape=box,color=red];
		1486 -> 1489;
	1484 [label="E se non rimanesse nulla di Eleanor? E se non vedessi altro che una bestia che sibila, ringhia e sputa?",shape=box,color=blue];
		1484 -> 1487;
		1484 -> 1486;
	1481 [label="In ogni caso, credo di essere grata del fatto che non mi uccideresti. Ecco. Almeno quello.",shape=box,color=blue];
		1481 -> 1482;
	1488 [label="E se il Techrot si rivelasse un'altra aberrazione scatenata dall'uomo come il tuo Uomo nel Muro? Cosa succederebbe allora? Mi daresti la caccia e mi uccideresti?",shape=box,color=blue];
		1488 -> 1491;
		1488 -> 1492;
	1489 [label="Anche se sono grata che tu abbia rispettato i desideri di una donna mostruosa, suppongo che sperassi in qualcosa di un po' più... ponderato.",shape=box,color=blue];
		1489 -> 1498;
	1487 [label="Come faccio a sapere che non è rimasto nulla di Eleanor? Parli di come pensa il Techrot. Di come ti parla. È chiaramente intelligente.",shape=box,color=red];
		1487 -> 1490;
	1482 [label="Chat ends.",color=orange];
	1491 [label="No. Non potrei.",shape=box,color=red];
		1491 -> 1500;
	1492 [label="Sì. Se il Techrot è davvero innaturale? Allora... deve sparire.",shape=box,color=red];
		1492 -> 1501;
	1498 [label="+5 Chemistry",color=orange];
		1498 -> 1493;
	1490 [label="Sembra una mente alveare. Forse Eleanor sarebbe ancora lì dentro, non in un posto, ma in un miliardo. Chi sono io per dire che è \"sbagliato\"?",shape=box,color=red];
		1490 -> 1494;
	1500 [label="Ti stai contraddicendo. Se sei disposto a fermare un'aberrazione creata dall'uomo, perché non due?",shape=box,color=blue];
		1500 -> 1506;
		1500 -> 1507;
	1501 [label="Grazie. Per me sei un enigma in molti aspetti, ma ora so che saresti disposto a spararmi in testa, e questo genere di cose è importante sul posto di lavoro.",shape=box,color=blue];
		1501 -> 1502;
	1493 [label="In ogni caso, credo di essere grata del fatto che non mi uccideresti. Ecco. Almeno quello.",shape=box,color=blue];
		1493 -> 1499;
	1494 [label="Proprio quando pensavo semplicemente di non poterti adorare di più mi ritrovo ancora una volta seduta qui a piangere lacrime di felicità",shape=box,color=blue];
		1494 -> 1496;
	1506 [label="Perché provo dei sentimenti per te. [Confessa i tuoi sentimenti.]",shape=box,color=red];
		1506 -> 1508;
	1507 [label="Perché per me sei troppo importante come amica.",shape=box,color=red];
		1507 -> 1509;
	1502 [label="Eee ho appena sentito il Techrot nelle mie cellule avere un piccolo tremito ansioso.",shape=box,color=blue];
		1502 -> 1503;
	1499 [label="Chat ends.",color=orange];
	1496 [label="+20 Chemistry",color=orange];
		1496 -> 1495;
	1508 [label="Chiedermi se ti ucciderei è semplicemente *crudele*, Eleanor. Quando il pensiero di te morta, o sofferente, semplicemente --",shape=box,color=red];
		1508 -> 1510;
	1509 [label="Chiedermi se ti ucciderei è semplicemente *crudele*, Eleanor. Sei mia amica. Sei come una famiglia per me.",shape=box,color=red];
		1509 -> 1511;
	1503 [label="Penso che d'ora in poi si comporterà un po' meglio. Non c'è niente di meglio che minacciare l'ospite per mettere la paura di Sol nel parassita, eh?",shape=box,color=blue];
		1503 -> 1504;
	1495 [label="Devo andare ma grazie grazie GRAZIE",shape=box,color=blue];
		1495 -> 1497;
	1510 [label="Il fatto è che, no. Non potrei. Perché la speranza che tu esistessi da qualche parte là fuori? In qualche forma? Ovunque? Mi basterebbe.",shape=box,color=red];
		1510 -> 1512;
	1511 [label="Il fatto è che, no. Non potrei. Perché la speranza che tu esistessi da qualche parte là fuori? In qualche forma? Ovunque? Mi basterebbe.",shape=box,color=red];
		1511 -> 1513;
	1504 [label="Update boolean EleanorNoDate",color=orange];
		1504 -> 1505;
	1497 [label="Chat ends.",color=orange];
	1512 [label="Scusa. Non posso. Devo andare.",shape=box,color=red];
		1512 -> 1514;
	1513 [label="Scusa. Non posso. Devo andare.",shape=box,color=red];
		1513 -> 1518;
	1505 [label="Chat ends.",color=orange];
	1514 [label="Update boolean EleanorConfession",color=orange];
		1514 -> 1516;
	1518 [label="+20 Chemistry",color=orange];
		1518 -> 1520;
	1516 [label="+20 Chemistry",color=orange];
		1516 -> 1515;
	1520 [label="Oh, Eleanor, questa volta hai esagerato...",shape=box,color=blue];
		1520 -> 1519;
	1515 [label="Oh... oh, cosa ho fatto...",shape=box,color=blue];
