digraph {
	808 [label="EleanorRank3Convo1 begins.",color=orange];
		808 -> 809;
		808 -> 810;
	809 [label="Ciao Eleanor, posso chiederti qualcosina sulla questione della telepatia?",shape=box,color=red];
		809 -> 811;
	810 [label="Quindi, com'è sbirciare nella testa di tutti?",shape=box,color=red];
		810 -> 813;
	811 [label="Chiedere va sempre bene, purché lo si faccia educatamente.",shape=box,color=blue];
		811 -> 812;
	813 [label="Cosa?",shape=box,color=blue];
		813 -> 814;
	812 [label="Per alcune persone è molto difficile.",shape=box,color=blue];
		812 -> 817;
		812 -> 818;
	814 [label="È questo che immagini che io faccia? Violare la privacy altrui?",shape=box,color=blue];
		814 -> 815;
	817 [label="Senti i pensieri delle persone senza sforzo? O devi sempre sforzarti per entrare nella loro testa?",shape=box,color=red];
		817 -> 819;
	818 [label="È come un interruttore della luce? O è sempre \"attiva''?",shape=box,color=red];
		818 -> 819;
	815 [label="Se questo è quello che pensi di me, allora dubito che avremo molto di cui parlare.",shape=box,color=blue];
		815 -> 816;
	819 [label="Sì a entrambi. Se mi siedo e \"ascolto\", posso cogliere monologhi interiori e forti emozioni.",shape=box,color=blue];
		819 -> 820;
	816 [label="Chat ends.",color=orange];
	820 [label="La parte più difficile è filtrare le cose RUMOROSE di cui non voglio sapere nulla.",shape=box,color=blue];
		820 -> 821;
	821 [label="Non sempre riesco a provare emozioni come se fossero di qualcun altro. Più è preverbale, più è difficile distinguere tra \"loro\" e \"me\".",shape=box,color=blue];
		821 -> 822;
	822 [label="Posso avere il permesso di addentrarmi nel regno delle \"troppe informazioni\"?",shape=box,color=blue];
		822 -> 823;
		822 -> 824;
		822 -> 825;
	823 [label="Beh, ora sono troppo curioso per dire di no...",shape=box,color=red];
		823 -> 827;
	824 [label="Permesso concesso.",shape=box,color=red];
		824 -> 828;
	825 [label="Eh... un'altra volta, forse. [Fine.]",shape=box,color=red];
		825 -> 826;
	827 [label="Un applauso al tuo coraggio.",shape=box,color=blue];
		827 -> 829;
	828 [label="Continua a leggere a tuo rischio e pericolo.",shape=box,color=blue];
		828 -> 829;
	826 [label="Chat ends.",color=orange];
	829 [label="Non molto tempo dopo che ci siamo fatti le iniezioni di Entrati, ho pensato di avere una specie di infezione secondaria alla vescica. Amico. Mi tiravo su e mi mettevo giù su quel divano come uno yo-yo. Lettie mi diede perfino la caccia con succo di mirtillo rosso e acqua minerale.",shape=box,color=blue];
		829 -> 830;
	830 [label="A quanto pare sentivo gli impulsi biologici naturali di sei persone. Il mio sistema nervoso ha naturalmente dato per scontato che fossero i miei.",shape=box,color=blue];
		830 -> 831;
		830 -> 832;
	831 [label="Cos'è stato peggio? Scoprire di non essere gravemente malata o...",shape=box,color=red];
		831 -> 833;
	832 [label="Dev'essere stato un sollievo scoprire la verità.",shape=box,color=red];
		832 -> 834;
	833 [label="Beh, io SONO catastroficamente malata. Non giriamoci intorno. Ma preferisco che sia telepatia piuttosto che una cistite senza fine.",shape=box,color=blue];
		833 -> 835;
	834 [label="Ho imparato a costruire muri attorno alla mia mente dopo quell'incidente. Lettie a volte trova delle medicine che possono spegnere del tutto il mio lato telepatico, solo per qualche ora. Ne ho una scorta, ma non le prendo a meno che non abbia davvero, davvero bisogno di dormire.",shape=box,color=blue];
		834 -> 835;
	835 [label="È un talento così utile da avere, e questo è il problema. Arthur insiste nel vederlo come una risorsa strategica.",shape=box,color=blue];
		835 -> 836;
		835 -> 837;
	836 [label="E la privacy delle persone? Non è dannosa per il morale?",shape=box,color=red];
		836 -> 838;
	837 [label="Ma cosa succede se qualcuno *non* vuole che la sua testa venga invasa?",shape=box,color=red];
		837 -> 839;
	838 [label="È davvero terribile per il morale.",shape=box,color=blue];
		838 -> 840;
	839 [label="Anche se insistessi dicendo che posso controllarlo, pensi che mi crederebbero?",shape=box,color=blue];
		839 -> 840;
	840 [label="Nessuno di noi è debole. Siamo abituati a vivere in condizioni difficili. Questo posto è un hotel a cinque stelle, in confronto a una normale caserma dell'Esercito Britannico.",shape=box,color=blue];
		840 -> 841;
	841 [label="Si fa la doccia insieme, si mangia insieme, ecc. Ci si abitua l'uno all'altro. Devi.",shape=box,color=blue];
		841 -> 842;
	842 [label="Ma come direbbe Arthur, c'è un fottuto limite.",shape=box,color=blue];
		842 -> 843;
	843 [label="Quindi, come lo gestisci?",shape=box,color=red];
		843 -> 844;
	844 [label="Semplicemente non rendo noto quanto della loro vita interiore sento e vedo. Non sondo senza invito, qualunque cosa possa pensare Lettie.",shape=box,color=blue];
		844 -> 845;
	845 [label="A volte uno di loro pensa qualcosa e poi immediatamente dopo si domanda \"mi avrà sentito pensare questo?\". Trovo più gentile lasciarli nel dubbio. Ciò che non sanno non può far loro del male.",shape=box,color=blue];
		845 -> 846;
		845 -> 847;
	846 [label="Hai sentito qualcuno dei MIEI pensieri?",shape=box,color=red];
		846 -> 848;
	847 [label="Allora... cosa hai trovato nella mia testa?",shape=box,color=red];
		847 -> 848;
	848 [label="Come ho detto, non confermo o smentisco nulla.",shape=box,color=blue];
		848 -> 849;
	849 [label="Vorrei dire subito che c'è un altro motivo importante per cui tengo questa roba per me.",shape=box,color=blue];
		849 -> 851;
	851 [label="Continua…",shape=box,color=red];
		851 -> 850;
	850 [label="Allora. Io e Arthur. Eravamo in strada, a razziare un nascondiglio degli Scaldra, e lui non era in sé. Non sparava dritto, guidava come un'anatra ubriaca agli autoscontro, non riusciva nemmeno a usare la spada.",shape=box,color=blue];
		850 -> 852;
	852 [label="Naturalmente, gli dissi di darsi una svegliata. Ha iniziato immediatamente a dare la colpa a ME. Mi disse che mi comportavo sempre come se fossi superiore a lui, non capivo la pressione del comando, che se avessi idea di cosa doveva affrontare OGNI GIORNO non resisterei, tutte queste stronzate di autocommiserazione.",shape=box,color=blue];
		852 -> 853;
	853 [label="Check boolean EleanorHeroVirus",color=orange];
		853 -> 854 [label=true,color=green];
		853 -> 855 [label=false,color=brown];
	854 [label="Ricordi l'Hero Virus di cui ti ho parlato?",shape=box,color=blue];
		854 -> 856;
	855 [label="Ho questa teoria che chiamo Hero Virus.",shape=box,color=blue];
		855 -> 858;
	856 [label="Caso terminale.",shape=box,color=blue];
		856 -> 857;
	858 [label="I bambini si mettono in testa che le storie che gli hanno raccontato sono come funziona davvero il mondo. Pensano di essere gli eroi e che tutto ruoti intorno a loro.",shape=box,color=blue];
		858 -> 859;
	857 [label="Tutto ruotava attorno ad Arthur.",shape=box,color=blue];
		857 -> 861;
	859 [label="Arthur è affetto da uno dei peggiori casi di Hero Virus che abbia mai visto.",shape=box,color=blue];
		859 -> 860;
	861 [label="Allora gli risposi: \"Sai che so quando pensi ad Aoi, vero?\"",shape=box,color=blue];
		861 -> 862;
	860 [label="Update boolean EleanorHeroVirus",color=orange];
		860 -> 861;
	862 [label="Ouch.",shape=box,color=red];
		862 -> 863;
	863 [label="Sì.",shape=box,color=blue];
		863 -> 864;
	864 [label="Non è stato il mio momento di maggior orgoglio.",shape=box,color=blue];
		864 -> 865;
	865 [label="Anche se non fosse stato mio fratello, è stata una cosa orribile. Non lo farò mai più.",shape=box,color=blue];
		865 -> 866;
	866 [label="Come ha reagito?",shape=box,color=red];
		866 -> 867;
	867 [label="… Non mi piace che tu voglia saperlo.",shape=box,color=blue];
		867 -> 868;
	868 [label="Ora mi chiedo se ti piace l'idea che Arthur venga umiliato.",shape=box,color=blue];
		868 -> 869;
	869 [label="Per favore, non lasciare che sia così. Stai iniziando a piacermi, e questo è il genere di cose che non potrei ignorare.",shape=box,color=blue];
		869 -> 870;
		869 -> 871;
		869 -> 872;
	870 [label="Lo chiedo perché mi sta simpatico.",shape=box,color=red];
		870 -> 873;
	871 [label="Cavolo. Non era mia intenzione. Volevo solo sapere come reagisce una persona del genere quando viene messa alle strette.",shape=box,color=red];
		871 -> 875;
	872 [label="Mi sta piacendo. Sembra che Arthur se lo sia meritato.",shape=box,color=red];
		872 -> 877;
	873 [label="Ok. È comprensibile. Scusa se ho perso la calma.",shape=box,color=blue];
		873 -> 874;
	875 [label="Non l'ho solo affrontato. L'ho FERITO.",shape=box,color=blue];
		875 -> 876;
	877 [label="Oh, capisco.",shape=box,color=blue];
		877 -> 878;
	874 [label="È crollato. Mi sono sentita orribile.",shape=box,color=blue];
		874 -> 879;
	876 [label="Arthur è abituato ad essere trattato male. Basta guardare Quincy!",shape=box,color=blue];
		876 -> 880;
	878 [label="Arthur è una spina nel fianco.",shape=box,color=blue];
		878 -> 881;
	879 [label="Ha rotto qualcosa di importante tra di noi. Aspetta. Devo dirti un cosa per farti capire meglio.",shape=box,color=blue];
		879 -> 885;
	880 [label="Ma sappiamo tutti che Arthur ha alzato dei muri. Si comporta come se fosse impossibile ferirlo.",shape=box,color=blue];
		880 -> 884;
	881 [label="Ma quando provo a parlarti di qualcosa per cui mi sento in colpa...",shape=box,color=blue];
		881 -> 882;
	885 [label="Quando eravamo piccoli, alcuni ragazzi più grandi rubarono l'Action Angus preferito di Arthur e lo gettarono nel falò del Solstizio.",shape=box,color=blue];
		885 -> 886;
	884 [label="Potevo sentire quanto fosse scioccato e confuso. Pensava di essere al sicuro con me. Non più.",shape=box,color=blue];
		884 -> 893;
	882 [label="Non importa.",shape=box,color=blue];
		882 -> 883;
	886 [label="Riesco ancora a vederlo, con la plastica color carne che ribolliva e gocciolava sui suoi pantaloni mimetici.",shape=box,color=blue];
		886 -> 887;
		886 -> 888;
	893 [label="Check boolean DrifterSiblingYes",color=orange];
		893 -> 895 [label=true,color=green];
		893 -> 894 [label=false,color=brown];
	883 [label="Chat ends.",color=orange];
	887 [label="Non mi manca essere bambino.",shape=box,color=red];
		887 -> 889;
	888 [label="Evviva l'infanzia.",shape=box,color=red];
		888 -> 889;
	895 [label="So cosa significa ferire un fratello. Io... ne avevo uno.",shape=box,color=red];
		895 -> 897;
	894 [label="Check boolean DrifterSiblingNo",color=orange];
		894 -> 895 [label=true,color=green];
		894 -> 896 [label=true,color=green];
		894 -> 895 [label=false,color=brown];
		894 -> 896 [label=false,color=brown];
	889 [label="I ragazzini risero e dissero che Arthur avrebbe dovuto essere felice. Action Angus stava andando alla Hall of Heroes per la festa di metà inverno come facevano i guerrieri. Volevo ucciderli. Piccoli bastardi.",shape=box,color=blue];
		889 -> 890;
	897 [label="Update boolean DrifterSiblingYes",color=orange];
		897 -> 898;
	896 [label="Sembra che tu lo abbia davvero ferito.",shape=box,color=red];
		896 -> 900;
	890 [label="Arthur non voleva che i ragazzini lo vedessero piangere, e non voleva piangere davanti a mio padre, quindi l'unica persona rimasta ero io. La sua merdosa sorella maggiore.",shape=box,color=blue];
		890 -> 891;
	898 [label="È orribile, vero? Ci si abitua così tanto al rituale, a denigrarsi a vicenda, a criticarsi e al sarcasmo...",shape=box,color=blue];
		898 -> 899;
	900 [label="Sì, l'ho fatto. Mi sono scusata, ho promesso che non avrei mai più fatto niente del genere, ma mi sento ancora una merda per questo.",shape=box,color=blue];
		900 -> 901;
	891 [label="Te lo racconto perché è lì che è andato Arthur, nella sua testa. Ricordava di essersi sentito al sicuro a piangere di fronte a me se ne avesse mai avuto davvero BISOGNO, e ora?",shape=box,color=blue];
		891 -> 892;
	899 [label="È quasi confortante. Poi un giorno esageri e non puoi più tornare indietro.",shape=box,color=blue];
		899 -> 901;
	901 [label="È giocare sporco.",shape=box,color=red];
		901 -> 902;
	892 [label="Ora non era più al sicuro.",shape=box,color=blue];
		892 -> 893;
	902 [label="SÌ.",shape=box,color=blue];
		902 -> 903;
	903 [label="Tu lo CAPISCI! Mi piace! Giocare sporco.",shape=box,color=blue];
		903 -> 904;
	904 [label="Hai presente quella cosa quando stai litigando con qualcuno e, una volta finita, ti viene in mente la cosa giusta che avresti dovuto dire?",shape=box,color=blue];
		904 -> 905;
	905 [label="Non ce l'ho più. Ho un pulsante magico per vincere. Tutto quello che dovrei fare è guardare nel loro cervello, afferrare ciò di cui si vergognano di più e sbatterglielo in faccia.",shape=box,color=blue];
		905 -> 906;
	906 [label="E NON POSSO FARLO, non importa quanto lo voglia. Perché dovrei essere una \"brava persona\".",shape=box,color=blue];
		906 -> 907;
		906 -> 908;
	907 [label="Non si tratta di cercare di essere una santa, Eleanor. Non si tratta nemmeno di essere un'eroina. Si tratta di rifiutarsi di essere una stronza.",shape=box,color=red];
		907 -> 909;
	908 [label="Stiamo tutti cercando di fare la cosa giusta qui. È davvero così tanto più difficile per te?",shape=box,color=red];
		908 -> 910;
	909 [label="Abbiamo tutti dei limiti che non supereremo mai e questo è uno dei tuoi. Lo rispetto.",shape=box,color=red];
		909 -> 912;
	910 [label="Oh cielo. Questo è ciò che ottengo per aver ostentato le mie virtù, non è vero?",shape=box,color=blue];
		910 -> 911;
	912 [label="Grazie.",shape=box,color=blue];
		912 -> 913;
	911 [label="Scusa. Mi aspettavo compassione. Ma accetto la realtà.",shape=box,color=blue];
		911 -> 914;
	913 [label="Non cerco compassione. Davvero.",shape=box,color=blue];
		913 -> 915;
	914 [label="Non è che sono l'unica che deve tenere sotto controllo i suoi poteri, no? Siamo tutti bombe a orologeria pronte a esplodere.",shape=box,color=blue];
		914 -> 920;
	915 [label="Volevo solo che qualcun altro capisse. Onestamente, sono un po' sorpresa da quanto tu CAPISCA.",shape=box,color=blue];
		915 -> 916;
	920 [label="+10 Chemistry",color=orange];
		920 -> 919;
	916 [label="Non dovevi ascoltare. Ma sono contenta che tu l'abbia fatto.",shape=box,color=blue];
		916 -> 917;
	919 [label="Apprezzo la chiacchierata.",shape=box,color=blue];
		919 -> 921;
	917 [label="È come un incubo nella mia testa. Credo che tu possa capire perché non stendo il tappeto di benvenuto agli sconosciuti.",shape=box,color=blue];
		917 -> 922;
	921 [label="Chat ends.",color=orange];
	922 [label="+20 Chemistry",color=orange];
		922 -> 918;
	918 [label="Mi aspetto che la gente scappi via urlando. Non l'hai fatto. Ancora. Mi chiedo perché. Grazie. Di nuovo. Per tutto.",shape=box,color=blue];
		918 -> 923;
	923 [label="Chat ends.",color=orange];
}