digraph {
	"EleanorRank6Convo4 begins." [color=orange];
		"EleanorRank6Convo4 begins." -> j1480617032;
	j1480617032 [label="Ti è mai capitato di fare la doccia e all'improvviso senti una strana vocina che ti fa una domanda che non avevi mai pensato di porti prima?",shape=box,color=blue];
		j1480617032 -> j2052845937;
		j1480617032 -> j1388547616;
		j1480617032 -> j1135631791;
	j2052845937 [label="Non proprio, no. [Fine.]",shape=box,color=red];
		j2052845937 -> "Chat ends.";
	j1388547616 [label="Tipo \"Cosa hanno pensato le persone sulla Terra quando Lua è riapparsa improvvisamente nel cielo?\"",shape=box,color=red];
		j1388547616 -> j3835266612;
	j1135631791 [label="Intendi una cosa tipo \"Operatore! Perché non prendi in considerazione l'idea di far imbalsamare il tuo Kubrow?\" ",shape=box,color=red];
		j1135631791 -> j930737307;
	"Chat ends." [color=orange];
	j3835266612 [label="Sì, esattamente.",shape=box,color=blue];
		j3835266612 -> j771417369;
	j930737307 [label="Questo è semplicemente Ordis. Fa così.",shape=box,color=red];
		j930737307 -> j3620894933;
	j771417369 [label="aspetta",shape=box,color=blue];
		j771417369 -> j3577902594;
	j3620894933 [label="Che gli Dei lo benedicano. No, intendo una voce interiore.",shape=box,color=blue];
		j3620894933 -> j1979916919;
	j3577902594 [label="Lua è scomparsa?",shape=box,color=blue];
		j3577902594 -> j2861874305;
	j1979916919 [label="Un po' come se il tuo cervello si tenesse impegnato mentre ti occupavi dell'importante compito chiamato igiene personale.",shape=box,color=blue];
		j1979916919 -> j1815015746;
	j2861874305 [label="Per quanto tempo? Dov'è finita? Che fine hanno fatto le maree?",shape=box,color=blue];
		j2861874305 -> j779434703;
		j2861874305 -> j3786928758;
	j1815015746 [label="Mi succede di continuo. Abbastanza casualmente. Ultimamente sono così frequenti che mi chiedo se vengano davvero dalla mia testa. ",shape=box,color=blue];
		j1815015746 -> j3377518535;
	j779434703 [label="In ordine: boh, il Void, boh.",shape=box,color=red];
		j779434703 -> j2567305784;
	j3786928758 [label="Lotus la inviò nel Void verso la fine della Vecchia Guerra. Il ragazzino l'ha tirata fuori di lì piuttosto recentemente.",shape=box,color=red];
		j3786928758 -> j3553463752;
	j3377518535 [label="Alcune le ho trasformate in dipinti.",shape=box,color=blue];
		j3377518535 -> j2567305784;
	j2567305784 [label="non preoccuparti, possiamo tornare sull'argomento in seguito.",shape=box,color=blue];
		j2567305784 -> j1649145557;
	j3553463752 [label="Non ho idea per quanto riguarda le maree.",shape=box,color=red];
		j3553463752 -> j2339652789;
	j1649145557 [label="Parlando di pensieri casuali sotto la doccia. Stamattina me ne è capitato uno fantastico.",shape=box,color=blue];
		j1649145557 -> j1957175907;
	j2339652789 [label="Come ha fatto Lotus a spostare un'intera LUNA?",shape=box,color=blue];
		j2339652789 -> j2567305784;
	j1957175907 [label="Pensavo: \"Ehi, e se gli Dei esistessero davvero?\"",shape=box,color=blue];
		j1957175907 -> j3504448799;
	j3504448799 [label="Per un attimo ho barcollato. Ho dovuto bagnarmi la faccia con l'acqua fredda per riprendermi.",shape=box,color=blue];
		j3504448799 -> j66340184;
		j3504448799 -> j119814184;
		j3504448799 -> j1014663201;
	j66340184 [label="Cosa c'è di strano? Mi sembra una domanda piuttosto banale.",shape=box,color=red];
		j66340184 -> j2224153253;
	j119814184 [label="… la gente non pensa che gli Dei siano reali? Sono abbastanza sicuro che Lettie lo pensi.",shape=box,color=red];
		j119814184 -> j976034959;
	j1014663201 [label="Sì, quello è un pensiero orribile.",shape=box,color=red];
		j1014663201 -> j3845249426;
	j2224153253 [label="Ah, ecco perché adoro parlare con te di queste cose",shape=box,color=blue];
		j2224153253 -> j4231249087;
	j976034959 [label="Oh, andiamo. Nessuno pensa davvero che gli Dei siano reali. Non nel modo in cui, boh, lo sono tavoli e sedie.",shape=box,color=blue];
		j976034959 -> j230456348;
	j3845249426 [label="Vero? E se ogni volta che pensi che l'universo ti stia inviando un messaggio, lo stia effettivamente facendo?",shape=box,color=blue];
		j3845249426 -> j2278776715;
	j4231249087 [label="La tua vita è così incredibilmente assurda che la realtà degli Dei è per te una speculazione naturale quanto i meriti relativi dei condimenti per la pizza",shape=box,color=blue];
		j4231249087 -> j2792152403;
	j230456348 [label="I veri Dei sono come i pozzi dei villaggi e i bagni pubblici. Sono qualcosa che la gente UN TEMPO aveva. ",shape=box,color=blue];
		j230456348 -> j4190474162;
	j2278776715 [label="Immagina che tutto sia nelle mani di questi bastardi meschini e immortali, che erano al comando solo perché le cose stanno così e non perché se lo meritassero",shape=box,color=blue];
		j2278776715 -> j3413478524;
	j2792152403 [label="Potresti anche aver incontrato un Dio. Se l'Indifferenza lo è.",shape=box,color=blue];
		j2792152403 -> j1049276901;
	j4190474162 [label="Al giorno d'oggi sono solo simboli, metafore o altre sciocchezze del genere.",shape=box,color=blue];
		j4190474162 -> j1443554501;
		j4190474162 -> j651748174;
	j3413478524 [label="E la cosa assurda è che la gente viveva così. Quella era la loro realtà, ogni giorno della loro vita.",shape=box,color=blue];
		j3413478524 -> j4141923591;
	j1049276901 [label="Mi hai appena ricordato una cosa di quando ero ancora sulla Zariman. La prima volta che ho incontrato l'Indifferenza.",shape=box,color=red];
		j1049276901 -> j689092053;
	j1443554501 [label="Forse le persone hanno semplicemente meno paura?",shape=box,color=red];
		j1443554501 -> j3633160526;
	j651748174 [label="Pensavo che Sol e Lua fossero i tuoi Dei.",shape=box,color=red];
		j651748174 -> j520100471;
	j4141923591 [label="Per loro gli Dei erano reali quanto il tempo atmosferico e se ne fregavano altamente di loro.",shape=box,color=blue];
		j4141923591 -> j3209266982;
	j689092053 [label="Non sapevo di cosa si trattasse, ovviamente. Ricordo però cosa mi disse. ",shape=box,color=red];
		j689092053 -> j246900526;
	j3633160526 [label="Penso che sia tutto, sì. ",shape=box,color=blue];
		j3633160526 -> j1332714813;
	j520100471 [label="Beh, sì, lo sono. Ma sono anche solo corpi celesti. ",shape=box,color=blue];
		j520100471 -> j2130336183;
	j3209266982 [label="Sinceramente non sembra tanto diverso dalla vita sotto gli Orokin.",shape=box,color=red];
		j3209266982 -> j4207355143;
	j246900526 [label="Gli dissi che poteva prendere la mia luce, e lui mi sorrise e rispose: \"Grazie, ragazzino. Credo proprio che lo farò\".",shape=box,color=red];
		j246900526 -> j1037569726;
	j1332714813 [label="Credo di sapere anche il perché.",shape=box,color=blue];
		j1332714813 -> j3682623753;
	j2130336183 [label="Come la Britannia, che è un paese, con un nome, un'identità e tutto il resto, ma è anche solo un ammasso di terra e rocce. Può essere entrambe le cose contemporaneamente.",shape=box,color=blue];
		j2130336183 -> j980959405;
	j4207355143 [label="Immortali, meschini, al comando perché sì...",shape=box,color=red];
		j4207355143 -> j723521955;
	j1037569726 [label="Oh diavolo, mi stai facendo venire i brividi",shape=box,color=blue];
		j1037569726 -> j1089900521;
	j3682623753 [label="È tutta una questione di luce.",shape=box,color=blue];
		j3682623753 -> j3551909734;
	j980959405 [label="Puoi uscire in una bella giornata di sole, sentirti grato, guardare Sol e dire \"grazie!\". E lo intendi davvero. È una cosa umana.",shape=box,color=blue];
		j980959405 -> j3764476749;
	j723521955 [label="Giusto. AVEVI degli Dei viventi. Ma li hai uccisi tutti.",shape=box,color=blue];
		j723521955 -> j2471482144;
	j1089900521 [label="In tutti i vecchi racconti popolari, il diavolo è un pignolo che rispetta la legge alla lettera",shape=box,color=blue];
		j1089900521 -> j1649430638;
	j3551909734 [label="Cosa sono Sol e Lua, dopotutto? Prima che a qualcuno venisse in mente di considerarli Dei? Erano LUCI.",shape=box,color=blue];
		j3551909734 -> j865650959;
		j3551909734 -> j1166080866;
	j3764476749 [label="Ma nessuno al giorno d'oggi pensa che Sol o Lua abbiano letteralmente messo incinta una donna umana o abbiano generato il figlio di un uomo e che da lì sia nato il Re.",shape=box,color=blue];
		j3764476749 -> j60936895;
	j2471482144 [label="(Non fraintendermi, lo adoro.)",shape=box,color=blue];
		j2471482144 -> j4043592276;
	j1649430638 [label="Credi che pensi che tu gli abbia promesso qualcosa? La tua “luce”?",shape=box,color=blue];
		j1649430638 -> j1587478163;
		j1649430638 -> j621756099;
	j865650959 [label="Giusto. La luce simboleggia il bene, ovunque tu vada.",shape=box,color=red];
		j865650959 -> j4253143799;
	j1166080866 [label="Le uniche luci che l'umanità ha avuto, per molto, molto tempo.",shape=box,color=red];
		j1166080866 -> j4253143799;
	j60936895 [label="Un tempo la gente ci credeva. Ora sappiamo che quelle storie erano solo leggende. Le abbiamo superate.",shape=box,color=blue];
		j60936895 -> j2375591434;
		j60936895 -> j1884875002;
	j4043592276 [label="Mi stai confondendo con il ragazzino. Non ho mai avuto modo di partecipare alla grande insurrezione Tenno.",shape=box,color=red];
		j4043592276 -> j816587000;
	j1587478163 [label="Dice che abbiamo fatto un \"accordo\". Quindi immagino pensi che gli debba... qualcosa.",shape=box,color=red];
		j1587478163 -> j3565630727;
	j621756099 [label="Alludevo alla lampada che portavo con me, ma chissà a cosa si riferiva quella \"cosa\".",shape=box,color=red];
		j621756099 -> j3565630727;
	j4253143799 [label="SÌ.",shape=box,color=blue];
		j4253143799 -> j849603750;
	j2375591434 [label="Dei e umani... si sono uniti?",shape=box,color=red];
		j2375591434 -> j1728842197;
	j1884875002 [label="Re con degli Dei come genitori? E io che pensavo che gli Orokin fossero degli stronzi.",shape=box,color=red];
		j1884875002 -> j1728842197;
	j816587000 [label="Non ho mai fatto parte del programma di Margulis per Bambini Molto Speciali, non ho mai avuto un Warframe, non ho mai combattuto nella Vecchia Guerra.",shape=box,color=red];
		j816587000 -> j2086897452;
	j3565630727 [label="Almeno una cosa la so. Sta giocando.",shape=box,color=red];
		j3565630727 -> j1921632911;
	j849603750 [label="Ma poi qualche piccolo nerd cavernicolo, che probabilmente era stato preso di mira dalle grandi cavernicole, ha escogitato il trucco di sbattere le rocce tra loro, e bingo.",shape=box,color=blue];
		j849603750 -> j2075921811;
	j1728842197 [label="Oh, quelle cose succedevano MOLTO spesso. In tutto il mondo.",shape=box,color=blue];
		j1728842197 -> j4243549272;
	j2086897452 [label="... ti sarebbe piaciuto accadesse?",shape=box,color=blue];
		j2086897452 -> j716369036;
		j2086897452 -> j4262504508;
		j2086897452 -> j4078926136;
	j1921632911 [label="+20 Chemistry",color=orange];
		j1921632911 -> j3168571415;
	j2075921811 [label="Luce su richiesta! Indipendenza dalle grandi luci del cielo!",shape=box,color=blue];
		j2075921811 -> j3078783489;
	j4243549272 [label="Immagina di essere un arrogante sacerdote che parte per il mare per diffondere il vangelo di Sol ai “selvaggi” del nuovo mondo, solo per scoprire che non solo sanno già tutto di Sol, ma che hanno il vero figlio di Sol a governare su di loro.",shape=box,color=blue];
		j4243549272 -> j482437189;
	j716369036 [label="In verità, non lo so.",shape=box,color=red];
		j716369036 -> j2851174652;
	j4262504508 [label="Onestamente no.",shape=box,color=red];
		j4262504508 -> j1497945984;
	j4078926136 [label="Sì.",shape=box,color=red];
		j4078926136 -> j206704313;
	j3168571415 [label="Va bene. Qualunque cosa tu faccia oggi, con chiunque tu sia, che si tratti di me, di Arthur o di chiunque altro di noi... stai attento.",shape=box,color=blue];
		j3168571415 -> j3435349021;
	j3078783489 [label="Ora guardati intorno. La luce è ovunque. L'abbiamo sminuita.",shape=box,color=blue];
		j3078783489 -> j1049276901;
	j482437189 [label="Torneresti a casa di corsa con la coda tra le gambe, oppure ti convertiresti all'istante.",shape=box,color=blue];
		j482437189 -> j3288029941;
		j482437189 -> j170682499;
	j2851174652 [label="È giusto. Lo rispetto.",shape=box,color=blue];
		j2851174652 -> j2991126293;
	j1497945984 [label="Sono contenta. Se pensi che la tua vita sarebbe potuta essere peggiore di quella che è, credo che ci sia qualcosa da festeggiare?",shape=box,color=blue];
		j1497945984 -> j2991126293;
	j206704313 [label="Capisco, credo. Ti sei perso un'ottima occasione, vero?",shape=box,color=blue];
		j206704313 -> j2991126293;
	j3435349021 [label="Check boolean EleanorDating",color=orange];
		j3435349021 -> j641215305 [label=true,color=green];
		j3435349021 -> j1412624938 [label=false,color=brown];
	j3288029941 [label="Ma pensi davvero che gli Dei esistano? O ti spaventa solo l'idea che possano esistere?",shape=box,color=red];
		j3288029941 -> j1454090980;
	j170682499 [label="Ok. Quindi quello che stai dicendo è: e se le persone del passato avessero sempre avuto ragione?",shape=box,color=red];
		j170682499 -> j1454090980;
	j2991126293 [label="Check boolean EleanorDating",color=orange];
		j2991126293 -> j300336353 [label=true,color=green];
		j2991126293 -> j3996538044 [label=false,color=brown];
	j641215305 [label="Ti amo. Qualsiasi Dio che provi a mettersi in mezzo farebbe meglio a pregare chiunque ci sia al di sopra degli Dei.",shape=box,color=blue];
		j641215305 -> "Chat ends.";
	j1412624938 [label="Sei un mio caro amico. Qualsiasi Dio che provi a portarti via da me vedrà la sua realtà messa a dura prova.",shape=box,color=blue];
		j1412624938 -> "Chat ends.";
	j1454090980 [label="Diciamo che un tempo ero molto più fiduciosa nella noiosa realtà materiale delle cose di quanto non lo sia ora.",shape=box,color=blue];
		j1454090980 -> j2486073536;
	j300336353 [label="+20 Chemistry",color=orange];
		j300336353 -> j4083898771;
	j3996538044 [label="+20 Chemistry",color=orange];
		j3996538044 -> j1305154159;
	j2486073536 [label="Dove un tempo c'era quella sicurezza, ora c'è un buco a forma di Drifter.",shape=box,color=blue];
		j2486073536 -> j3166199458;
	j4083898771 [label="Abbiamo entrambi le nostre cicatrici, amore mio. ",shape=box,color=blue];
		j4083898771 -> "Chat ends.";
	j1305154159 [label="Abbiamo entrambi le nostre cicatrici, amico mio.",shape=box,color=blue];
		j1305154159 -> "Chat ends.";
	j3166199458 [label="+20 Chemistry",color=orange];
		j3166199458 -> j1000709392;
	j1000709392 [label="Onestamente? Non mi manca, davvero. È bello lasciarsi spaventare dalle possibilità, ogni tanto.",shape=box,color=blue];
		j1000709392 -> "Chat ends.";
}