digraph {
	2659 [label="EleanorRank5Convo8 begins.",color=orange];
		2659 -> 2660;
	2660 [label="Ho pensato. C'è qualcosa che devo fare.",shape=box,color=blue];
		2660 -> 2661;
	2661 [label="Avrò bisogno di aiuto.",shape=box,color=blue];
		2661 -> 2662;
		2661 -> 2663;
	2662 [label="Sono sempre qui per te. Cosa ti passa per la testa?",shape=box,color=red];
		2662 -> 2665;
	2663 [label="Scusa, non posso chattare ora. [Fine]",shape=box,color=red];
		2663 -> 2664;
	2665 [label="Check boolean EleanorChristopher2",color=orange];
		2665 -> 2667 [label=true,color=green];
		2665 -> 2666 [label=false,color=brown];
	2664 [label="Chat ends.",color=orange];
	2667 [label="Allora, Christopher.",shape=box,color=blue];
		2667 -> 2675;
	2666 [label="Check boolean EleanorChristopher1",color=orange];
		2666 -> 2671 [label=true,color=green];
		2666 -> 2668 [label=false,color=brown];
	2675 [label="Lo mantengo legato a me da anni. E così anche Arthur. Ogni anno facciamo un rituale in sua memoria. Ma quest'anno no. Non potevo affrontarlo.",shape=box,color=blue];
		2675 -> 2676;
	2671 [label="Per... rendere breve una storia molto lunga e tragica... Christopher è morto a causa di una bomba sul ciglio della strada prima che ci sposassimo.",shape=box,color=blue];
		2671 -> 2672;
	2668 [label="È ora che ti parli di Christopher.",shape=box,color=blue];
		2668 -> 2669;
	2676 [label="Non so se i fantasmi esistano, ma potrebbero anche esistere, perché ho lasciato che lui lo diventasse.",shape=box,color=blue];
		2676 -> 2677;
	2672 [label="Forse ti racconterò tutta la storia un altro giorno. O forse non lo farò.",shape=box,color=blue];
		2672 -> 2673;
	2669 [label="Il migliore amico di Arthur. Eravamo fidanzati. Pensavo di essere innamorata di lui.",shape=box,color=blue];
		2669 -> 2670;
	2677 [label="Non essere così dura con te stessa. Eri innamorata di quel ragazzo.",shape=box,color=red];
		2677 -> 2678;
	2673 [label="Ti sto dicendo tutto questo perché...",shape=box,color=blue];
		2673 -> 2674;
	2670 [label="Update boolean EleanorChristopher1",color=orange];
		2670 -> 2671;
	2678 [label="Oh, amico. Ho CREDUTO di esserlo. Gli volevo bene, ma non sapevo nemmeno se ero INNAMORATA di lui o meno.",shape=box,color=blue];
		2678 -> 2679;
	2674 [label="Update boolean EleanorChristopher2",color=orange];
		2674 -> 2675;
	2679 [label="Sembra terribile, vero? Ma è così. All'epoca, non sembrava importante. Poi è morto, e questo è diventato il tema della nostra storia.",shape=box,color=blue];
		2679 -> 2680;
	2680 [label="Tutto ciò che ammiravo di lui è stato oscurato dal modo in cui è morto. Non riesco a pensare a lui senza che un nodo mi stringa lo stomaco.",shape=box,color=blue];
		2680 -> 2681;
	2681 [label="Non è giusto. PER LUI. Lui merita di meglio.",shape=box,color=blue];
		2681 -> 2682;
		2681 -> 2683;
	2682 [label="Capisco. Assolutamente. Ho scelto di ricordare i miei genitori nel modo in cui meritavano.",shape=box,color=red];
		2682 -> 2684;
	2683 [label="Quello che è successo è stato terribile. Non c'è modo di evitarlo. Ma non possiamo lasciare che questa sia l'unica cosa a cui aggrapparci.",shape=box,color=red];
		2683 -> 2684;
	2684 [label="Allora perché mi sento così in colpa?",shape=box,color=blue];
		2684 -> 2685;
	2685 [label="Perché ho la sensazione che lasciarlo andare sia la stessa cosa che gettarlo via?",shape=box,color=blue];
		2685 -> 2686;
		2685 -> 2688;
	2686 [label="Perché l'hai trascinato per così tanto tempo che non sai come fermarti.",shape=box,color=red];
		2686 -> 2687;
	2688 [label="Perché hai paura che nessun altro sia in grado di amarti.",shape=box,color=red];
		2688 -> 2689;
	2687 [label="Per gli dei. Hai maledettamente ragione, lo sai.",shape=box,color=blue];
		2687 -> 2692;
	2689 [label="Check boolean EleanorDating",color=orange];
		2689 -> 2690 [label=true,color=green];
		2689 -> 2691 [label=false,color=brown];
	2692 [label="Non siamo in grado di gestire questa situazione. Imbottigliamo tutto. Ci facciamo coraggio e fischiettiamo in trincea. Ci permette di andare avanti, proprio come con i nostri genitori. Ma non sappiamo come fermarci.",shape=box,color=blue];
		2692 -> 2693;
	2690 [label="È così? Sono così superficiale?",shape=box,color=blue];
		2690 -> 2694;
	2691 [label="Dubito che persino Christopher mi amerebbe nelle mie attuali condizioni.",shape=box,color=blue];
		2691 -> 2696;
	2693 [label="Cosa dovrei fare? Come posso lasciarmi andare?",shape=box,color=blue];
		2693 -> 2698;
	2694 [label="Non sento di meritare NESSUNO di voi in questo momento",shape=box,color=blue];
		2694 -> 2695;
	2696 [label="... no. Non è giusto. Non sono affatto corretta nei suoi confronti, vero?",shape=box,color=blue];
		2696 -> 2697;
	2698 [label="Check boolean LettieDiasdeMuertos",color=orange];
		2698 -> 2699 [label=true,color=green];
		2698 -> 2700 [label=true,color=green];
		2698 -> 2701 [label=true,color=green];
		2698 -> 2700 [label=false,color=brown];
		2698 -> 2701 [label=false,color=brown];
	2695 [label="Penso... di volere che tu abbia TUTTO di me. Non posso trattenere una parte di me in uno stato di lutto infinito.",shape=box,color=blue];
		2695 -> 2698;
	2697 [label="Non avrebbe voluto ostacolare la mia felicità. Era buono.",shape=box,color=blue];
		2697 -> 2698;
	2699 [label="Credo che Lettie possa essere d'aiuto.",shape=box,color=red];
		2699 -> 2702;
	2700 [label="Potresti scrivergli una lettera.",shape=box,color=red];
		2700 -> 2703;
	2701 [label="Parla con Arthur, forse. Ha affrontato questo dolore con te fin dall'inizio.",shape=box,color=red];
		2701 -> 2704;
	2702 [label="Lettie?",shape=box,color=blue];
		2702 -> 2705;
	2703 [label="Una parte di me pensa che sia un'idea stupida. Non la leggerà. È morto. Ma...",shape=box,color=blue];
		2703 -> 2706;
	2704 [label="Sì, l'ha fatto. Forse è parte del problema. So che è arrabbiato perché non ho mantenuto la nostra piccola cerimonia di commemorazione quest'anno.",shape=box,color=blue];
		2704 -> 2707;
	2705 [label="Perché lei?",shape=box,color=blue];
		2705 -> 2708;
	2706 [label="... Più ci penso, meno mi sembra un'idea stupida.",shape=box,color=blue];
		2706 -> 2710;
	2707 [label="Devo solo... dire addio a Christopher a modo MIO questa volta. Una volta per tutte.",shape=box,color=blue];
		2707 -> 2711;
	2708 [label="Ha molta esperienza. Sa tutto sulla commemorazione dei morti.",shape=box,color=red];
		2708 -> 2709;
	2710 [label="Sì, lo farò. Ci sono cose che devo dirgli. Cose che non ho mai detto quando era vivo. Forse allora potrà riposare.",shape=box,color=blue];
		2710 -> 2712;
	2711 [label="Per Arthur sarà sempre un fratello perduto, un soldato caduto. Questo è il lutto che lui conosce e comprende. Ma non è il mio.",shape=box,color=blue];
		2711 -> 2713;
	2709 [label="Sono sicuro che se le chiedessi un consiglio, con rispetto, non ti respingerebbe.",shape=box,color=red];
		2709 -> 2720;
	2712 [label="Grazie per aver ascoltato e per i consigli.",shape=box,color=blue];
		2712 -> 2714;
	2713 [label="Non posso più fare come fa Arthur. Penso... che se glielo dicessi e basta, capirà.",shape=box,color=blue];
		2713 -> 2718;
	2720 [label="…",shape=box,color=blue];
		2720 -> 2721;
	2714 [label="+20 Chemistry",color=orange];
		2714 -> 2715;
	2718 [label="+10 Chemistry",color=orange];
		2718 -> 2719;
	2721 [label="Sì.",shape=box,color=blue];
		2721 -> 2722;
	2715 [label="Non lo dimenticherò mai e poi mai.",shape=box,color=blue];
		2715 -> 2716;
	2719 [label="Grazie.",shape=box,color=blue];
		2719 -> 2717;
	2722 [label="È il momento.",shape=box,color=blue];
		2722 -> 2723;
	2716 [label="Chat ends.",color=orange];
	2717 [label="Chat ends.",color=orange];
	2723 [label="+20 Chemistry",color=orange];
		2723 -> 2724;
	2724 [label="Credo di dover lasciare andare MOLTE cose.",shape=box,color=blue];
		2724 -> 2725;
	2725 [label="Lasciami parlare con lei. Se mi manda a quel paese, allora che così sia. Ma almeno ci avrò provato, no?",shape=box,color=blue];
		2725 -> 2726;
	2726 [label="Vale la pena di provare. Lettie non è così senza cuore come si pensa.",shape=box,color=red];
		2726 -> 2727;
	2727 [label="Ci scommetto. Vivendo in questo modo, facendo quello che facciamo ogni giorno, tutti noi abbiamo eretto dei muri. Abbiamo solo dimenticato di metterci le porte.",shape=box,color=blue];
		2727 -> 2728;
	2728 [label="Grazie per aver sbattuto la tua bella testa contro il mio muro.",shape=box,color=blue];
		2728 -> 2729;
	2729 [label="Chat ends.",color=orange];
}