	787 [label="Come chiunque altro, suppongo. Perché me lo chiedi?",shape=box,color=blue];
		787 -> 788;
		787 -> 789;
	788 [label="Amir sta cercando di riunire la squadra per giocare a Fables & Frontiers, e gli ho detto che l'avrei aiutato.",shape=box,color=red];
		788 -> 790;
	789 [label="Amir vuole davvero giocare con tutti a Fables & Frontiers. Ci stai?",shape=box,color=red];
		789 -> 790;
	790 [label="Ah. Capisco. Sei l'araldo inviato dal Re Thunderbolt per arruolare la bella Eleanor. Senza dubbio mi aspetta ogni sorta di furfanteria. Storie fantastiche e così via.",shape=box,color=blue];
		790 -> 791;
		790 -> 792;
	791 [label="Sì, penso che sarà una completa perdita di tempo, ma sto cercando di essere gentile.",shape=box,color=red];
		791 -> 793;
	792 [label="Penso che sarà divertente, onestamente. E sembra significare molto per lui.",shape=box,color=red];
		792 -> 794;
	793 [label="Ti farò un favore e NON gli riferirò quello che mi hai detto. Un consiglio saggio: trattalo con più rispetto in futuro, in mia presenza.",shape=box,color=blue];
		793 -> 436;
	794 [label="Onestamente, fare una voce scema e recitare per qualche ora sembra l'ideale. Conta su di me.",shape=box,color=blue];
		794 -> 795;
	436 [label="Chat ends.",color=orange];
	795 [label="Oh! Mi piacerebbe essere un mago. O forse un bardo. O forse entrambi? Posso ESSERE entrambi?",shape=box,color=blue];
		795 -> 796;
	796 [label="Oppure potrei essere una strega della palude! A patto che possa indossare un corpetto stretto, mi raccomando. Madre Senomuschiato ti mangerà le ossa, piccolo manichino.",shape=box,color=blue];
