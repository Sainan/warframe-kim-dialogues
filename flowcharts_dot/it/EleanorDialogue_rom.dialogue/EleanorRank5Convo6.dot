digraph {
	2541 [label="EleanorRank5Convo6 begins.",color=orange];
		2541 -> 2542;
	2542 [label="Potresti notare che il Centro Commerciale sembra un po' diverso stamattina.",shape=box,color=blue];
		2542 -> 2543;
	2543 [label="Niente di troppo assurdo ed evidente. Solo qualche sorriso in più su qualche volto. Una risata qua e là. Un pizzico di felicità nell'aria.",shape=box,color=blue];
		2543 -> 2544;
		2543 -> 2545;
	2544 [label="È merito tuo, giusto?",shape=box,color=red];
		2544 -> 2547;
	2545 [label="A DOPO. [Fine.]",shape=box,color=red];
		2545 -> 2546;
	2547 [label="È il mio modo di ricambiare. Come già sai, un telepate può inviare e ricevere. Non deve essere necessariamente un getto d'acqua diretto a una persona. Può essere più simile a una pioggerellina sottile spruzzata su un'area.",shape=box,color=blue];
		2547 -> 2548;
	2546 [label="Chat ends.",color=orange];
	2548 [label="Hai degli irrigatori per il prato dove vivi?",shape=box,color=blue];
		2548 -> 2549;
		2548 -> 2550;
	2549 [label="Abbiamo VERD-IE e droni simili. Si prendevano cura delle piante sulla Zariman. È questo il genere di cose che intendi?",shape=box,color=red];
		2549 -> 2551;
	2550 [label="Irriga...tori?",shape=box,color=red];
		2550 -> 2552;
	2551 [label="Diciamo di sì.",shape=box,color=blue];
		2551 -> 2553;
	2552 [label="Sì, mio caro, irrigatori. Nebulizzatori d'acqua per mantenere il prato bello e umido.",shape=box,color=blue];
		2552 -> 2554;
	2553 [label="Quando ero bambina adoravo gli irrigatori da giardino. Erano magici. Quando il sole splendeva luminoso, in essi si potevano vedere gli arcobaleni. Ci correvi in ​​mezzo e sentivi un delizioso brivido in tutto il corpo.",shape=box,color=blue];
		2553 -> 2555;
	2554 [label="Sono ottimi anche per trattenerci il volto di tuo fratello finché non urla.",shape=box,color=blue];
		2554 -> 2555;
	2555 [label="\"La felicità è un irrigatore da giardino\". Scrivilo su un biglietto d'auguri.",shape=box,color=blue];
		2555 -> 2556;
	2556 [label="Sembri di buon umore oggi. Sono felice di ciò.",shape=box,color=red];
		2556 -> 2557;
	2557 [label="Lo sono. E non vedo perché dovrei tenermelo per me. Quindi sto irradiando questa felicità per tutto il Centro Commerciale.",shape=box,color=blue];
		2557 -> 2558;
		2557 -> 2559;
		2557 -> 2560;
	2558 [label="Non è un po' come drogare la gente?",shape=box,color=red];
		2558 -> 2561;
	2559 [label="Trasmettere uno stato d'animo positivo? Perché no. Non vedo come sia diverso dal suonare della musica.",shape=box,color=red];
		2559 -> 2562;
	2560 [label="Quindi oggi potrei vedere addirittura Arthur sorridere?",shape=box,color=red];
		2560 -> 2563;
	2561 [label="... fantastico. Io sto cercando di essere la fata segreta della felicità che sparge allegria, e invece vengo accusata di essere il folletto malvagio che droga le persone. Il mio umore è appena precipitato.",shape=box,color=blue];
		2561 -> 2564;
	2562 [label="Oh! Bella analogia!",shape=box,color=blue];
		2562 -> 2566;
	2563 [label="Forse. Spero di sì. Ha dovuto sopportare fin troppo.",shape=box,color=blue];
		2563 -> 2567;
	2564 [label="Va bene. La smetto.",shape=box,color=blue];
		2564 -> 2565;
	2566 [label="Se Aoi riesce a influenzare l'umore attraverso la musica, io posso farlo attraverso le vibrazioni, giusto?",shape=box,color=blue];
		2566 -> 2568;
	2567 [label="Sono cambiate così tante cose da quando sei arrivato. Non intendo solo tra te e me. Intendo tutto. Anche il Centro Commerciale.",shape=box,color=blue];
		2567 -> 2568;
	2565 [label="Chat ends.",color=orange];
	2568 [label="Sono felice che Aoi mi abbia convinta a restare. Che Sol la benedica.",shape=box,color=blue];
		2568 -> 2569;
		2568 -> 2570;
	2569 [label="Aspetta. Cosa ha fatto?",shape=box,color=red];
		2569 -> 2571;
	2570 [label="Frena un secondo. Mi è sfuggito qualcosa.",shape=box,color=red];
		2570 -> 2571;
	2571 [label="Non te l'ho detto?",shape=box,color=blue];
		2571 -> 2572;
	2572 [label="Ah. Non è successo molto prima che tu arrivassi. Eravamo stati fuori tutto il giorno a cercare di estirpare un alveare Techrot. C'era una tensione omicida nell'aria. Di solito combattere affievolisce la nostra rabbia e siamo troppo esausti per scagliarci l'uno contro l'altro, ma quel giorno è stato diverso.",shape=box,color=blue];
		2572 -> 2573;
	2573 [label="Ricordo che Arthur disse qualcosa del tipo \"domani dovremo rifare tutto da capo\" e la realizzazione di ciò ci colpì come una mazza. Nessuno proferì parola durante il viaggio di ritorno al Centro Commerciale.",shape=box,color=blue];
		2573 -> 2574;
		2573 -> 2575;
		2573 -> 2576;
	2574 [label="Wow. Ottimo modo per risollevare il morale della squadra, Arthur.",shape=box,color=red];
		2574 -> 2579;
	2575 [label="Sa essere davvero affascinante...",shape=box,color=red];
		2575 -> 2579;
	2576 [label="Ha un enorme peso sulle spalle. Talvolta può essere eccessivo.",shape=box,color=red];
		2576 -> 2577;
	2579 [label="Penso che stesse solo cercando di farci concentrare sul lavoro. Ma io mi sono sentita devastata. Arthur e Aoi non parlavano, Amir stava innervosendo Quincy così tanto che cominciavo a temere per la sua vita, e Lettie mi lanciava occhiatacce ogni volta che ne aveva la possibilità.",shape=box,color=blue];
		2579 -> 2580;
	2577 [label="Sì. Di solito riesce a nasconderlo, anche quando è esausto. Immagino semplicemente non ne potesse più.",shape=box,color=blue];
		2577 -> 2578;
	2580 [label="Quel giorno ho passato molto tempo a guardarmi allo specchio. Continuavo a immaginare il mio riflesso che mi afferrava per la gola e sibilava \"TU sei il problema. Se non fosse stato per te, niente di tutto questo sarebbe successo\".",shape=box,color=blue];
		2580 -> 2581;
		2580 -> 2582;
	2578 [label="Si era stancato nel tentativo di tenere unita la squadra.",shape=box,color=blue];
		2578 -> 2579;
	2581 [label="Sembra che una volta tanto fossero tutti gli altri a essere entrati nella TUA testa.",shape=box,color=red];
		2581 -> 2583;
	2582 [label="Sembra il genere di sciocchezze che direbbe Lettie.",shape=box,color=red];
		2582 -> 2584;
	2583 [label="Oh, non erano loro. Ero io. Tutti i dubbi e l'odio per me stessa che avevo represso vennero a galla quel giorno.",shape=box,color=blue];
		2583 -> 2585;
	2584 [label="Grazie. So che mi supporti e questo significa molto per me.",shape=box,color=blue];
		2584 -> 2586;
	2585 [label="Ho pensato tra me e me: ciò di cui questo gruppo ha bisogno è un capro espiatorio.",shape=box,color=blue];
		2585 -> 2587;
	2586 [label="Avevo sentito questa frase da Lettie così tante volte che ho finito per pensare che forse aveva ragione. Sto mettendo tutti in pericolo restando qui.",shape=box,color=blue];
		2586 -> 2588;
	2587 [label="Un mostro. Qualcuno da incolpare.",shape=box,color=blue];
		2587 -> 2588;
	2588 [label="Quindi ho elaborato un piano. Mi sarei allontanata di notte, mi sarei nascosta in città in un posto dove Arthur non mi avrebbe mai trovata e, questa è la parte di cui ero più orgogliosa, avrei continuato ad aiutarli a distanza di sicurezza.",shape=box,color=blue];
		2588 -> 2589;
		2588 -> 2590;
	2589 [label="Penso che ti avrebbe trovato. È parecchio determinato.",shape=box,color=red];
		2589 -> 2591;
	2590 [label="Lo scenario più plausibile è che sarebbe morto nel tentativo di trovarti.",shape=box,color=red];
		2590 -> 2592;
	2591 [label="Come? Amir non riesce a rintracciare la telepatia.",shape=box,color=blue];
		2591 -> 2593;
	2592 [label="Stai cercando di farmi sentire in colpa?",shape=box,color=blue];
		2592 -> 2594;
	2593 [label="Sarei diventata una nobile esiliata. Mi sarei accovacciata sui tetti con aria terrorizzata e determinata. Avrei potuto informarli sull'accumulo di Techrot, indicare agli Hex dove si stavano posizionando gli Scaldra, persino agire come rete di comunicazione d'emergenza. Ogni volta che avrei salvato il culo a Lettie, glielo avrei fatto capire bene. Meschino? Sicuramente.",shape=box,color=blue];
		2593 -> 2595;
	2594 [label="Non disturbarti. Mi sento già abbastanza male.",shape=box,color=blue];
		2594 -> 2598;
	2595 [label="Avevo scelto il momento perfetto. Ho aspettato che Amir si addormentasse. Poi ho indossato un lungo cappotto e mi sono diretta verso il garage il più silenziosamente possibile.",shape=box,color=blue];
		2595 -> 2596;
	2598 [label="Chat ends.",color=orange];
	2596 [label="Ma il cancello di sicurezza si è abbassato da solo. Mi sono girata e c'era Aoi.",shape=box,color=blue];
		2596 -> 2597;
	2597 [label="Abbiamo parlato tutta la notte e pianto l'una nelle braccia dell'altra. Anche lei soffriva. Profondamente. Quando è sorto il sole, avevo deciso di restare.",shape=box,color=blue];
		2597 -> 2599;
		2597 -> 2600;
		2597 -> 2601;
	2599 [label="Sei ancora in tempo per cambiare idea.",shape=box,color=red];
		2599 -> 2602;
	2600 [label="Aoi è meravigliosa. Sono felice che fosse lì per te.",shape=box,color=red];
		2600 -> 2604;
	2601 [label="È stata una grande fortuna.",shape=box,color=red];
		2601 -> 2604;
	2602 [label="Qualunque sia stato l'impulso grottesco che ti ha spinto a scrivere questo, spero che ti soffochi.",shape=box,color=blue];
		2602 -> 2603;
	2604 [label="+20 Chemistry",color=orange];
		2604 -> 2605;
	2603 [label="Chat ends.",color=orange];
	2605 [label="Sì. Dovevamo essere qui tutti e sei alla vigilia di Capodanno. E tu, naturalmente. Lo sconosciuto alla porta che portava fortuna.",shape=box,color=blue];
		2605 -> 2606;
	2606 [label="Chat ends.",color=orange];
}