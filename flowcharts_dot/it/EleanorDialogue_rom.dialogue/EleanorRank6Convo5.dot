	3101 [label="Lo chiamavano \"Il Progetto\". ",shape=box,color=red];
		3101 -> 3104;
	3105 [label="La nostra esistenza non è meno vera o valida dei quark o delle supernove. Siamo importanti, che ci piaccia o no.",shape=box,color=blue];
