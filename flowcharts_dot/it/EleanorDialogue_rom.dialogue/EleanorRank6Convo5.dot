digraph {
	3068 [label="EleanorRank6Convo5 begins.",color=orange];
		3068 -> 3069;
	3069 [label="Mi chiedevo, come spesso mi capita...",shape=box,color=blue];
		3069 -> 3070;
	3070 [label="Una volta che questo ciclo sarà definitivamente chiuso, qualunque cosa accada, cosa succederà alla Terra?",shape=box,color=blue];
		3070 -> 3071;
	3071 [label="So che per te il 2000 è un anno molto lontano nel passato, ma puoi dirmi QUALCOSA su cosa riserva il futuro al nostro piccolo pianeta?",shape=box,color=blue];
		3071 -> 3072;
		3071 -> 3074;
	3072 [label="Niente di buono, temo.",shape=box,color=red];
		3072 -> 3073;
	3074 [label="Sinceramente, non credo dovrei.",shape=box,color=red];
		3074 -> 3076;
	3073 [label="Da quel poco che posso dire, il Techrot sta diventando un problema globale. La gente lo risolve con le bombe nucleari, o almeno ci prova.",shape=box,color=red];
		3073 -> 3075;
	3076 [label="Se sapessi di ciò che sta per accadere, potresti provare a cambiarlo e questo potrebbe significare che non esisterò mai.",shape=box,color=red];
		3076 -> 3078;
	3075 [label="È così che inizia la prima delle “Guerre di Radiazione”.",shape=box,color=red];
		3075 -> 3077;
	3078 [label="Chiamami pure egoista, ma mi piace esistere.",shape=box,color=red];
		3078 -> 3080;
	3077 [label="... e alla fine il pianeta diventa così incasinato che gli Orokin vogliono abbandonarlo e andare a vivere da qualche altra parte, giusto?",shape=box,color=blue];
		3077 -> 3079;
	3080 [label="Oh, come se tutto quello che hai fatto NON avesse cambiato il futuro?",shape=box,color=blue];
		3080 -> 3082;
	3079 [label="... il che ci porta alla questione Zariman, ed è qui che entri in gioco TU.",shape=box,color=blue];
		3079 -> 3081;
	3082 [label="Potresti aver cambiato i piccoli dettagli, ma quelli più importanti sono rimasti praticamente gli stessi.",shape=box,color=blue];
		3082 -> 3085;
	3081 [label="È strano pensare che tutto abbia inizio proprio qui, in questa città.",shape=box,color=blue];
		3081 -> 3083;
		3081 -> 3084;
	3085 [label="Penso che l'Universo sappia cosa sta facendo.",shape=box,color=blue];
		3085 -> 3088;
	3083 [label="Forse è anche per questo che quest'anno è così importante.",shape=box,color=red];
		3083 -> 3086;
	3084 [label="Sì. Da Höllvania alla Zariman Ten-Zero. È un filo conduttore.",shape=box,color=red];
		3084 -> 3087;
	3088 [label="Non si tratta solo di particelle cieche che girano senza fermarsi mai.",shape=box,color=blue];
		3088 -> 3091;
		3088 -> 3092;
	3086 [label="+5 Chemistry",color=orange];
		3086 -> 3089;
	3087 [label="aspetta...",shape=box,color=blue];
		3087 -> 3090;
	3091 [label="Non condivido il tuo punto di vista. L'Universo non ha una mente.",shape=box,color=red];
		3091 -> 3095;
	3092 [label="Sono d'accordo. Se qualcosa di umano come le emozioni possono plasmare il Void...",shape=box,color=red];
		3092 -> 3096;
	3089 [label="Ha senso. Se la bomba nucleare di Albrecht fosse esplosa, non ci sarebbe stato il Techrot, quindi niente Terra distrutta, niente bisogno di fuggire, niente primo viaggio nel Void e niente Indifferenza??",shape=box,color=blue];
		3089 -> 3093;
	3090 [label="Se la tua era la Zariman Ten-Zero, cosa è successo alle Zariman da Uno a Nove?",shape=box,color=blue];
		3090 -> 3094;
	3095 [label="Forse da una prospettiva molto grande o molto piccola, ma non al livello in cui esistiamo io e te.",shape=box,color=blue];
		3095 -> 3099;
	3096 [label="+5 Chemistry",color=orange];
		3096 -> 3100;
	3093 [label="... Vado a vedere se Lettie ha del caffè pronto. ",shape=box,color=blue];
		3093 -> 3097;
	3094 [label="Droni senza pilota, da quanto mi ricordo. ",shape=box,color=red];
		3094 -> 3098;
	3099 [label="Se possiamo dare un significato e siamo parte dell'Universo, allora l'Universo è per definizione significativo.",shape=box,color=blue];
		3099 -> 3102;
	3100 [label="Esattamente. Il significato che diamo non è solo una comoda illusione.",shape=box,color=blue];
		3100 -> 3103;
	3097 [label="Chat ends.",color=orange];
	3098 [label="O moduli di terraformazione pilotati da dei Cephalon. Hanno sperimentato MOLTO.",shape=box,color=red];
		3098 -> 3101;
	3102 [label="+5 Chemistry",color=orange];
		3102 -> 3105;
	3103 [label="Ma c'è sempre quella voce che ti sussurra e insiste che tutto questo non ha importanza.",shape=box,color=blue];
