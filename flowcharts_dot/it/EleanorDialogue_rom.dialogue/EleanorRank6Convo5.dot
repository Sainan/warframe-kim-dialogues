digraph {
	"EleanorRank6Convo5 begins." [color=orange];
		"EleanorRank6Convo5 begins." -> j1242701006;
	j1242701006 [label="Mi chiedevo, come spesso mi capita...",shape=box,color=blue];
		j1242701006 -> j4131285328;
	j4131285328 [label="Una volta che questo ciclo sarà definitivamente chiuso, qualunque cosa accada, cosa succederà alla Terra?",shape=box,color=blue];
		j4131285328 -> j390815751;
	j390815751 [label="So che per te il 2000 è un anno molto lontano nel passato, ma puoi dirmi QUALCOSA su cosa riserva il futuro al nostro piccolo pianeta?",shape=box,color=blue];
		j390815751 -> j2061442351;
		j390815751 -> j751372178;
	j2061442351 [label="Niente di buono, temo.",shape=box,color=red];
		j2061442351 -> j3559064364;
	j751372178 [label="Sinceramente, non credo dovrei.",shape=box,color=red];
		j751372178 -> j532382659;
	j3559064364 [label="Da quel poco che posso dire, il Techrot sta diventando un problema globale. La gente lo risolve con le bombe nucleari, o almeno ci prova.",shape=box,color=red];
		j3559064364 -> j206034225;
	j532382659 [label="Se sapessi di ciò che sta per accadere, potresti provare a cambiarlo e questo potrebbe significare che non esisterò mai.",shape=box,color=red];
		j532382659 -> j3165314928;
	j206034225 [label="È così che inizia la prima delle “Guerre di Radiazione”.",shape=box,color=red];
		j206034225 -> j3339432592;
	j3165314928 [label="Chiamami pure egoista, ma mi piace esistere.",shape=box,color=red];
		j3165314928 -> j1732081188;
	j3339432592 [label="... e alla fine il pianeta diventa così incasinato che gli Orokin vogliono abbandonarlo e andare a vivere da qualche altra parte, giusto?",shape=box,color=blue];
		j3339432592 -> j1132792065;
	j1732081188 [label="Oh, come se tutto quello che hai fatto NON avesse cambiato il futuro?",shape=box,color=blue];
		j1732081188 -> j3737726000;
	j1132792065 [label="... il che ci porta alla questione Zariman, ed è qui che entri in gioco TU.",shape=box,color=blue];
		j1132792065 -> j3755516828;
	j3737726000 [label="Potresti aver cambiato i piccoli dettagli, ma quelli più importanti sono rimasti praticamente gli stessi.",shape=box,color=blue];
		j3737726000 -> j180540956;
	j3755516828 [label="È strano pensare che tutto abbia inizio proprio qui, in questa città.",shape=box,color=blue];
		j3755516828 -> j929340943;
		j3755516828 -> j139742774;
	j180540956 [label="Penso che l'Universo sappia cosa sta facendo.",shape=box,color=blue];
		j180540956 -> j3315276924;
	j929340943 [label="Forse è anche per questo che quest'anno è così importante.",shape=box,color=red];
		j929340943 -> j4052571303;
	j139742774 [label="Sì. Da Höllvania alla Zariman Ten-Zero. È un filo conduttore.",shape=box,color=red];
		j139742774 -> j1333993781;
	j3315276924 [label="Non si tratta solo di particelle cieche che girano senza fermarsi mai.",shape=box,color=blue];
		j3315276924 -> j2310966310;
		j3315276924 -> j650159324;
	j4052571303 [label="+5 Chemistry",color=orange];
		j4052571303 -> j1304505140;
	j1333993781 [label="aspetta...",shape=box,color=blue];
		j1333993781 -> j2928001684;
	j2310966310 [label="Non condivido il tuo punto di vista. L'Universo non ha una mente.",shape=box,color=red];
		j2310966310 -> j3137263784;
	j650159324 [label="Sono d'accordo. Se qualcosa di umano come le emozioni possono plasmare il Void...",shape=box,color=red];
		j650159324 -> j4093982677;
	j1304505140 [label="Ha senso. Se la bomba nucleare di Albrecht fosse esplosa, non ci sarebbe stato il Techrot, quindi niente Terra distrutta, niente bisogno di fuggire, niente primo viaggio nel Void e niente Indifferenza??",shape=box,color=blue];
		j1304505140 -> j3624422;
	j2928001684 [label="Se la tua era la Zariman Ten-Zero, cosa è successo alle Zariman da Uno a Nove?",shape=box,color=blue];
		j2928001684 -> j2369185992;
	j3137263784 [label="Forse da una prospettiva molto grande o molto piccola, ma non al livello in cui esistiamo io e te.",shape=box,color=blue];
		j3137263784 -> j1108084569;
	j4093982677 [label="+5 Chemistry",color=orange];
		j4093982677 -> j2300311713;
	j3624422 [label="... Vado a vedere se Lettie ha del caffè pronto. ",shape=box,color=blue];
		j3624422 -> "Chat ends.";
	j2369185992 [label="Droni senza pilota, da quanto mi ricordo. ",shape=box,color=red];
		j2369185992 -> j2214757870;
	j1108084569 [label="Se possiamo dare un significato e siamo parte dell'Universo, allora l'Universo è per definizione significativo.",shape=box,color=blue];
		j1108084569 -> j582396484;
	j2300311713 [label="Esattamente. Il significato che diamo non è solo una comoda illusione.",shape=box,color=blue];
		j2300311713 -> j2357304022;
	"Chat ends." [color=orange];
	j2214757870 [label="O moduli di terraformazione pilotati da dei Cephalon. Hanno sperimentato MOLTO.",shape=box,color=red];
		j2214757870 -> j2745163899;
	j582396484 [label="+5 Chemistry",color=orange];
		j582396484 -> j1008357705;
	j2357304022 [label="Ma c'è sempre quella voce che ti sussurra e insiste che tutto questo non ha importanza.",shape=box,color=blue];
		j2357304022 -> j1525099866;
	j2745163899 [label="Lo chiamavano \"Il Progetto\". ",shape=box,color=red];
		j2745163899 -> j3225523644;
	j1008357705 [label="La nostra esistenza non è meno vera o valida dei quark o delle supernove. Siamo importanti, che ci piaccia o no.",shape=box,color=blue];
		j1008357705 -> "Chat ends.";
	j1525099866 [label="Forse il grande scontro cosmico non è tra Bene e Male, ma tra significato e insensatezza?",shape=box,color=blue];
		j1525099866 -> "Chat ends.";
	j3225523644 [label="+5 Chemistry",color=orange];
		j3225523644 -> j2886982244;
	j2886982244 [label="Suona meglio di \"Operazione Portiamo i Nostri Irresponsabili Culi Su Un Nuovo Pianeta Che Possiamo Mandare Tutto In Merda\".",shape=box,color=blue];
		j2886982244 -> "Chat ends.";
}