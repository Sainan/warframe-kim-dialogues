	"Chat ends. Next chat will be KayaRank2Convo2." [color=orange];
	j2591287311 [label="Quindi dammi qualche giorno, forse qualche settimana, lo capirò e dirò addio al 1999.",shape=box,color=blue];
		j2591287311 -> j1639896454;
	j2165375521 [label="Gelosia. Paragoni. Ugh. Ho chiuso con quella parte della mia vita. Non cercare di mettermi contro le altre. ",shape=box,color=blue];
