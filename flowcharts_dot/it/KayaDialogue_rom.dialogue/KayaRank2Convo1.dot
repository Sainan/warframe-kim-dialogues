	j1824102512 [label="Sul serio, niente scherzi.",shape=box,color=blue];
		j1824102512 -> j3308484773;
	j349653656 [label="Arthur ed Eleanor ti vedono sicuramente come una sorella più piccola molto più intelligente di loro.",shape=box,color=red];
		j349653656 -> j2487850044;
	j1364240770 [label="Sei tu che dici che sono una ragazzina, e se mi fosse successo qualcosa?",shape=box,color=blue];
		j1364240770 -> j3783670614;
