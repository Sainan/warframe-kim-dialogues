		j720764914 -> j2290739771;
	j1938373538 [label="Ok, Nova allora. ",shape=box,color=red];
		j1938373538 -> j4224056572;
	j2290739771 [label="Capisco. Da quando?",shape=box,color=red];
		j2290739771 -> j3874301199;
	j4224056572 [label="Ok grazie, non chiamarmi Kaya online. Puoi chiamarmi così in persona, ma qui: NOVA. Ok?",shape=box,color=blue];
		j4224056572 -> j155524691;
		j4224056572 -> j23728373;
	j3874301199 [label="Um ha importanza? È l'internet, preferirei non usare il mio vero nome.",shape=box,color=blue];
		j3874301199 -> j699700144;
		j3874301199 -> j1596165781;
	j155524691 [label="Ok, ma posso chiederti perché?",shape=box,color=red];
		j155524691 -> j1507022322;
	j23728373 [label="Capito. Nova. Nova. Ok. Volevo chiederti: C'è qualcosa che posso fare per metterti più a tuo agio?",shape=box,color=red];
		j23728373 -> j3005925268;
	j699700144 [label="Giusto, non vorrei mai che la gente vedesse quante volte mi chiedi dei viaggi nel tempo.",shape=box,color=red];
		j699700144 -> j3201098022;
	j1596165781 [label="Oh? Sono abbastanza sicuro che Amir abbia la rete sotto controllo, a meno che non mi stia sfuggendo qualcosa?",shape=box,color=red];
		j1596165781 -> j4213113677;
	j1507022322 [label="Hai chiesto agli altri se hanno un soprannome che gli piace? Fallo. ",shape=box,color=blue];
		j1507022322 -> j23728373;
	j3005925268 [label="So che nessuno di noi ha realmente chiesto di ''essere qui'' ma stiamo facendo del nostro meglio.",shape=box,color=red];
		j3005925268 -> j4135644991;
	j3201098022 [label="Sei serio? L'internet è pericoloso. Ma tipo, veramente.",shape=box,color=blue];
		j3201098022 -> j4017628883;
		j3201098022 -> j2499242238;
	j4213113677 [label="È importante per me. Non voglio che nessuno trovi Kaya online.",shape=box,color=blue];
		j4213113677 -> j1052792443;
		j4213113677 -> j1550359520;
	j4135644991 [label="Hmm. Umm. Hmm. A mio agio. Nessuno ha diffuso pettegolezzi su di me vero?",shape=box,color=blue];
		j4135644991 -> j1716197165;
		j4135644991 -> j3578791779;
	j4017628883 [label="Ti è successo qualcosa?",shape=box,color=red];
		j4017628883 -> j960515419;
	j2499242238 [label="E pensi che il viaggio nel tempo non lo sia?",shape=box,color=red];
		j2499242238 -> j4294415938;
	j1052792443 [label="I poliziotti del tempo non ti prenderanno, lo prometto.",shape=box,color=red];
		j1052792443 -> j1112588163;
	j1550359520 [label="Ti sei messa nei guai?",shape=box,color=red];
		j1550359520 -> j1170826943;
