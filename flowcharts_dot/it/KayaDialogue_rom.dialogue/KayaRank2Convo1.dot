	j1170826943 [label="Ho fatto uno STUPIDO errore. Una volta. ",shape=box,color=blue];
		j1170826943 -> j1837793900;
	j3479604932 [label="Sul serio, niente scherzi.",shape=box,color=blue];
		j3479604932 -> j2399810969;
	j3083159494 [label="Arthur ed Eleanor ti vedono sicuramente come una sorella più piccola molto più intelligente di loro.",shape=box,color=red];
		j3083159494 -> j3434052102;
	j3474821557 [label="Sei tu che dici che sono una ragazzina, e se mi fosse successo qualcosa?",shape=box,color=blue];
		j3474821557 -> j4132047603;
	j1883182708 [label="Niente che io possa cambiare ora.",shape=box,color=blue];
		j1883182708 -> j3209313376;
