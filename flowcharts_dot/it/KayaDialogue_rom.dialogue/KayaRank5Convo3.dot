	908 [label="Un'ottima scelta per i principianti. ",shape=box,color=blue];
		908 -> 911;
	909 [label="Ma alla fine? La Pantera più spettacolare e maestosa è praticamente tua.",shape=box,color=blue];
		909 -> 912;
