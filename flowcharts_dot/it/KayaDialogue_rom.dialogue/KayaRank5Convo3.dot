digraph {
	"KayaRank5Convo3 begins." [color=orange];
		"KayaRank5Convo3 begins." -> j587563523;
	j587563523 [label="Ohhh ciao, potrei gentilmente presentarti un corso base per le CARTE JINYMON?",shape=box,color=blue];
		j587563523 -> j1185312067;
	j1185312067 [label="Amir è ovviamente felicissimo di avere finalmente qualcuno con cui giocare (e perdere).",shape=box,color=blue];
		j1185312067 -> j3869230874;
	j3869230874 [label="Ma entrambi pensiamo che sarebbe divertente farti conoscere Jinymon. ",shape=box,color=blue];
		j3869230874 -> j3041454356;
		j3869230874 -> j2645223270;
		j3869230874 -> j2865483448;
	j3041454356 [label="Voi giocate. Io sono occupato [Fine.]",shape=box,color=red];
		j3041454356 -> j145506587;
	j2645223270 [label="Ho degli höllari che mi stanno bruciando un buco nella tasca, da dove cominciamo?",shape=box,color=red];
		j2645223270 -> j1698541442;
	j2865483448 [label="Ricordami... di cosa stiamo parlando?",shape=box,color=red];
		j2865483448 -> j4138179022;
	j145506587 [label="+20 Chemistry",color=orange];
		j145506587 -> "Chat ends. Next chat will be KayaRank5Convo4.";
	j1698541442 [label="Oooook sì! Allora, per prima cosa. Concentriamoci su di te. Ti vedi più come un Drago, un'Aquila, o una Pantera?",shape=box,color=blue];
		j1698541442 -> j3985865770;
		j1698541442 -> j617353135;
		j1698541442 -> j2876419491;
	j4138179022 [label="È semplicemente lo show, il gioco, e collezione più popolare del 1999!",shape=box,color=blue];
		j4138179022 -> j299913731;
	"Chat ends. Next chat will be KayaRank5Convo4." [color=orange];
	j3985865770 [label="Una Pantera.",shape=box,color=red];
		j3985865770 -> j969760756;
	j617353135 [label="Un'Aquila.",shape=box,color=red];
		j617353135 -> j1129109932;
	j2876419491 [label="Un Drago.",shape=box,color=red];
		j2876419491 -> j1579958051;
	j299913731 [label="Sai personaggi e creature fighissime...",shape=box,color=blue];
		j299913731 -> j2689203715;
	j969760756 [label="Ok allora dovresti ASSOLUTAMENTE iniziare il gioco con Tailala",shape=box,color=blue];
		j969760756 -> j4125735542;
	j1129109932 [label="Ok allora dovresti DEFINITIVAMENTE iniziare il gioco con Plumbert",shape=box,color=blue];
		j1129109932 -> j2838644377;
	j1579958051 [label="Ok allora dovresti PROBABILMENTE iniziare il gioco con Frogobogo.",shape=box,color=blue];
		j1579958051 -> j4006050823;
	j2689203715 [label="Non è questo il punto suppongo. Comunque, iniziamo da te. Ti vedi più come un Drago, un'Aquila, o una Pantera?",shape=box,color=blue];
		j2689203715 -> j3985865770;
		j2689203715 -> j617353135;
		j2689203715 -> j2876419491;
	j4125735542 [label="Che è un'opzione fighissima ma sicuramente complicata, all'inizio è davvero debole.",shape=box,color=blue];
		j4125735542 -> j178542356;
	j2838644377 [label="È un po' avanzato ma davvero interessante. ",shape=box,color=blue];
		j2838644377 -> j3672950166;
	j4006050823 [label="Un'ottima scelta per i principianti. ",shape=box,color=blue];
		j4006050823 -> j460535279;
	j178542356 [label="Ma alla fine? La Pantera più spettacolare e maestosa è praticamente tua.",shape=box,color=blue];
		j178542356 -> j2682383688;
	j3672950166 [label="E Plumbert è davvero carino perché puoi dargli da mangiare l'Uva Frizzante per farlo salire di livello più velocemente degli altri.",shape=box,color=blue];
		j3672950166 -> j3188096602;
	j460535279 [label="E certo inizi con la ranetta più carina di sempre, ma alla fine se vinci abbastanza battaglie..",shape=box,color=blue];
		j460535279 -> j1008830389;
	j2682383688 [label="Una scelta decisamente di classe.",shape=box,color=blue];
		j2682383688 -> j375138124;
	j3188096602 [label="Che ti consente di sbloccare un interno sistema di Raccolti.",shape=box,color=blue];
		j3188096602 -> j375138124;
	j1008830389 [label="Puoi far salire di livello Frogobogo fino a farlo diventare DRAGO.",shape=box,color=blue];
		j1008830389 -> j375138124;
	j375138124 [label="Di che gioco si tratta esattamente...",shape=box,color=red];
		j375138124 -> j497941153;
	j497941153 [label="Giusto, ok, quindi fai la raccolta di Jinymon, loro combatteranno con te e potrai dare inizio alla tua avventura.",shape=box,color=blue];
		j497941153 -> j1148444818;
	j1148444818 [label="Ma quello è nella versione video gioco. Nella versione gioco di carte è come se STESSI combattendo solo contro qualcun altro nella vita reale.",shape=box,color=blue];
		j1148444818 -> j2384967283;
	j2384967283 [label="È come se fosse sempre la stessa idea comunque. Jinymon Jinymon Jinymon. ",shape=box,color=blue];
		j2384967283 -> j3878640774;
	j3878640774 [label="Allora, sei pronto a giocare la tua prima partita?",shape=box,color=blue];
		j3878640774 -> j2677576765;
		j3878640774 -> j1984732928;
		j3878640774 -> j3336024259;
		j3878640774 -> j1260827295;
	j2677576765 [label="Neanche per sogno. [Fine.]",shape=box,color=red];
		j2677576765 -> j145506587;
	j1984732928 [label="Certo perché no, la fortuna dei principianti sarà sicuramente dalla mia parte.",shape=box,color=red];
		j1984732928 -> j3880579410;
	j3336024259 [label="Vuoi solo vincere facile. No.",shape=box,color=red];
		j3336024259 -> j3573378491;
	j1260827295 [label="No, sono ancora più confuso ora. Non hai spiegato niente! ",shape=box,color=red];
		j1260827295 -> j3573378491;
	j3880579410 [label="Fantastico... ti basterà sborsare circa 10.000 höllari per il tuo pacchetto iniziale...",shape=box,color=blue];
		j3880579410 -> j14275801;
		j3880579410 -> j2583979652;
	j3573378491 [label="Oh, dai... ci andrò piano con te. Lascerò persino che Amir ti aiuti! ",shape=box,color=blue];
		j3573378491 -> j3676168591;
	j14275801 [label="Se lo dici tu...",shape=box,color=red];
		j14275801 -> j3763431675;
	j2583979652 [label="Ma che! Non ho tutti quei soldi.",shape=box,color=red];
		j2583979652 -> j3763431675;
	j3676168591 [label="E se vinci ti regalerò una confezione di carte Jinymon ancora sigillate!",shape=box,color=blue];
		j3676168591 -> j3718006313;
		j3676168591 -> j977374392;
		j3676168591 -> j3973810800;
	j3763431675 [label="Nessun problema, se solo potessi inserire qui i tuoi dati bancari....",shape=box,color=blue];
		j3763431675 -> j1848207422;
		j3763431675 -> j2817825239;
	j3718006313 [label="Va bene, va bene. Solo se Amir può aiutarmi.",shape=box,color=red];
		j3718006313 -> j3880579410;
	j977374392 [label="Un'altra volta?",shape=box,color=red];
		j977374392 -> j2595089288;
	j3973810800 [label="Neanche per sogno! ",shape=box,color=red];
		j3973810800 -> j2595089288;
	j1848207422 [label="Non ci casco!",shape=box,color=red];
		j1848207422 -> j455197198;
	j2817825239 [label="Va bene, 4..1",shape=box,color=red];
		j2817825239 -> j3224883964;
	j2595089288 [label="Va beeeene.",shape=box,color=blue];
		j2595089288 -> j145506587;
	j455197198 [label="Congratulazioni, hai superato il test di sicurezza K.O.L. ",shape=box,color=blue];
		j455197198 -> j767376398;
	j3224883964 [label="ODDIO NO! Era un test, NON dovresti mai inserire le tue informazioni bancarie sui servizi internet K.O.L! ",shape=box,color=blue];
		j3224883964 -> j2148150024;
	j767376398 [label="Ahah Amir era così sicuro che ci saresti cascato.",shape=box,color=blue];
		j767376398 -> j3699984030;
	j2148150024 [label="Ugh Dannazione! Devo una partita ad Amir. Ha detto che ci saresti cascato.",shape=box,color=blue];
		j2148150024 -> j145506587;
	j3699984030 [label="Ma sì, giocheremo dopo.",shape=box,color=blue];
		j3699984030 -> j145506587;
