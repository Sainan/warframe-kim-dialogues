digraph {
	"KayaRank4Convo1 begins." [color=orange];
		"KayaRank4Convo1 begins." -> j267193169;
	j267193169 [label="Vuoi sapere come ci si sente? Appare internet e promette un sacco di cose.",shape=box,color=blue];
		j267193169 -> j1030065769;
	j1030065769 [label="Immagina di essere me. Compi 18 anni. Vai online. Inizi a chattare con nuovi amici sparsi PER TUTTO IL MONDO!",shape=box,color=blue];
		j1030065769 -> j2917002671;
	j2917002671 [label="E per una cosiddetta \"ragazza intelligente\" come me, fai la cosa più stupida che puoi fare su internet. ",shape=box,color=blue];
		j2917002671 -> j31078965;
	j31078965 [label="Ti fidi della persona dall'altra parte dello schermo. ",shape=box,color=blue];
		j31078965 -> j3905341605;
	j3905341605 [label="Sei circondata da nuove tecnologie e dimentichi che le persone sono pur sempre persone. ",shape=box,color=blue];
		j3905341605 -> j296984573;
	j296984573 [label="Quindi mandi una tua foto nuda, una di quelle che farebbe arrossire Lua. Pensi di avere un legame con qualcuno che hai incontrato su internet. Puoi fidarti del tuo ragazzo online. ",shape=box,color=blue];
		j296984573 -> j3852403264;
	j3852403264 [label="E il giorno dopo, quella foto è ovunque. L'ha vista tutto il campus. È stata condivisa. Mandata ai tuoi PROFESSORI. In tutto l'INTERNET. In paesi che non sapevo nemmeno che esistessero.",shape=box,color=blue];
		j3852403264 -> j4122738514;
	j4122738514 [label="Sarei anche potuta essere la persona più intelligente su questa roccia e la gente si sarebbe ricordata di me solo per quella foto.",shape=box,color=blue];
		j4122738514 -> j4078758460;
	j4078758460 [label="Quindi quando dico che me ne andrò, lo dico sul serio. So che quella foto non significa NULLA, il mondo è andato avanti, la gente è andata avanti.",shape=box,color=blue];
		j4078758460 -> j165687570;
	j165687570 [label="Ma ha rovinato la mia vita. Voglio vivere in un futuro senza internet. Voglio dimostrare che posso andare avanti anche io. Andare nel passato dimostra che LORO hanno ragione, e che io non riesco ad andare avanti.",shape=box,color=blue];
		j165687570 -> j349826414;
	j349826414 [label="Quindi, aspetta e vedrai. Mi vedrai da dove vieni tu. ",shape=box,color=blue];
		j349826414 -> j3477633400;
	j3477633400 [label="E potremo guardare il mondo e ridere del fatto che le mie scelte non mi hanno distrutta. Tutto questo mi ha solo resa più intelligente. Abbastanza intelligente da andarmene.",shape=box,color=blue];
		j3477633400 -> j3258508148;
	j3258508148 [label="+20 Chemistry",color=orange];
		j3258508148 -> "Chat ends. Next chat will be KayaRank4Convo2.";
	"Chat ends. Next chat will be KayaRank4Convo2." [color=orange];
}