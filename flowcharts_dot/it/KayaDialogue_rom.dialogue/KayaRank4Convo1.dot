digraph {
	"KayaRank4Convo1 begins." [color=orange];
		"KayaRank4Convo1 begins." -> j3457358674;
	j3457358674 [label="Vuoi sapere com'è? L'internet arriva, e promette un sacco di cose.",shape=box,color=blue];
		j3457358674 -> j3631879536;
	j3631879536 [label="Quindi sei me. Compi 18 anni. Vai online. Inizi a chattare con nuovi amici OVUNQUE!",shape=box,color=blue];
		j3631879536 -> j443763157;
	j443763157 [label="E per una ''ragazza intelligente'' come me, fai la cosa più stupida che potesse essere fatta su internet. ",shape=box,color=blue];
		j443763157 -> j985891903;
	j985891903 [label="Ti fidi della persona dall'altra parte dello schermo. ",shape=box,color=blue];
		j985891903 -> j3274779495;
	j3274779495 [label="E vedi tutta questa nuova tecnologia, e dimentichi che le persone sono sempre persone. ",shape=box,color=blue];
		j3274779495 -> j3609814784;
	j3609814784 [label="Quindi mandi una tua foto nuda, una di quelle che farebbe arrossire Lua. Pensi di avere un legame con qualcuno che hai incontrato su internet. Puoi fidarti del tuo ragazzo online. ",shape=box,color=blue];
		j3609814784 -> j4183742184;
	j4183742184 [label="E il giorno dopo, quella foto è ovunque. L'ha vista tutto il campus. È stata condivisa. Mandata ai tuoi PROFESSORI. In tutto l'INTERNET. In paesi che non sapevo nemmeno che esistessero.",shape=box,color=blue];
		j4183742184 -> j3705462392;
	j3705462392 [label="Sarei anche potuta essere la persona più intelligente su questa roccia e la gente si sarebbe ricordata di me solo per quella foto.",shape=box,color=blue];
		j3705462392 -> j2787760320;
	j2787760320 [label="Quindi quando dico che me ne andrò, lo dico sul serio. So che quella foto non significa NULLA, il mondo è andato avanti, la gente è andata avanti.",shape=box,color=blue];
		j2787760320 -> j989954070;
	j989954070 [label="Ma ha rovinato la mia vita. Voglio vivere in un futuro senza internet. Voglio dimostrare che posso andare avanti anche io. Andare nel passato dimostra che LORO hanno ragione, e che io non riesco ad andare avanti.",shape=box,color=blue];
		j989954070 -> j2975626804;
	j2975626804 [label="Quindi, aspetta e vedrai. Mi vedrai da dove vieni tu. ",shape=box,color=blue];
		j2975626804 -> j2622828076;
	j2622828076 [label="E potremo guardare il mondo e ridere del fatto che le mie scelte non mi hanno distrutta. Tutto questo mi ha solo reso più intelligente. Abbastanza intelligente da andare avanti.",shape=box,color=blue];
		j2622828076 -> j3258508148;
	j3258508148 [label="+20 Chemistry",color=orange];
		j3258508148 -> "Chat ends. Next chat will be KayaRank4Convo2.";
	"Chat ends. Next chat will be KayaRank4Convo2." [color=orange];
}