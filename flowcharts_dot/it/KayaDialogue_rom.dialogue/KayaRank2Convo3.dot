		j561816284 -> j3400533232;
		j561816284 -> j1457634090;
	j141326503 [label="Perché per qualche motivo, tutto ciò che Nova sa fare è chiedere all'unico viaggiatore del tempo che conosce informazioni sui viaggi nel tempo.",shape=box,color=red];
		j141326503 -> j1786843158;
	j445809149 [label="Perché non vuoi rinunciare? Non che io voglia che tu lo faccia, ma non so davvero come aiutarti.",shape=box,color=red];
		j445809149 -> j3229122825;
	j731951514 [label="Il Rettore della mia università era così. Se MAI lo rivedrò..",shape=box,color=blue];
		j731951514 -> j3786331553;
	j3400533232 [label="Se vuoi venire conservata come un esperimento scientifico per il resto della tua vita, certo.",shape=box,color=red];
		j3400533232 -> j84928905;
	j1457634090 [label="Non credo che mettervi in contatto sia una buona idea, anche se fosse possibile.",shape=box,color=red];
		j1457634090 -> j2130386506;
	j1786843158 [label="+5 Chemistry",color=orange];
		j1786843158 -> j3162632059;
	j3229122825 [label="Protea, dettagli. Tipo, c'è una me di lei? Sai, un mezzo mostro?",shape=box,color=blue];
