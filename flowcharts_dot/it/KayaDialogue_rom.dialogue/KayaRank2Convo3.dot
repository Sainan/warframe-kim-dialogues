		j3229122825 -> j1823275998;
	j3786331553 [label="Pensavo che avrebbe preso le mie difese ma... ",shape=box,color=blue];
		j3786331553 -> j3088819044;
		j3786331553 -> j1323403554;
	j84928905 [label="E venduta al miglior offerente.",shape=box,color=red];
		j84928905 -> j2678830634;
	j2130386506 [label="Cerchiamo di concentrarci su ciò che potrebbe esserti utile.",shape=box,color=red];
		j2130386506 -> j1583776270;
	j3162632059 [label="Sì.",shape=box,color=blue];
		j3162632059 -> j261085532;
	j2306942846 [label="Mezzo mostro che risolverà il viaggio nel tempo però. Datti un po' di credito.",shape=box,color=red];
		j2306942846 -> j1822615253;
	j1823275998 [label="Protea Warframe, per ciò che sappiamo.",shape=box,color=red];
		j1823275998 -> j123746756;
	j3088819044 [label="Cosa ti è successo all'Università?",shape=box,color=red];
