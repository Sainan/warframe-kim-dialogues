	j941783151 [label="+5 Chemistry",color=orange];
		j941783151 -> j2012588517;
	j14052032 [label="Chiunque fosse, ciò che è adesso è colei che ha servito Parvos Granum.",shape=box,color=red];
		j14052032 -> j165943401;
	j83148952 [label="Lancia, e poi lancia ancora.",shape=box,color=red];
		j83148952 -> j1177431110;
	j2497296975 [label="Lo hai chiesto tu.",shape=box,color=red];
		j2497296975 -> j3432120835;
	j2012588517 [label="Sì.",shape=box,color=blue];
		j2012588517 -> j3748408911;
	j165943401 [label="Sì sì, un gran cattivone con un sacco di soldi e cervello. Come sempre.",shape=box,color=blue];
		j165943401 -> j396257018;
		j165943401 -> j351278167;
		j165943401 -> j959513441;
	j1177431110 [label="Ugh. Ciao? Ciao.",shape=box,color=blue];
		j1177431110 -> j2189522063;
	j3432120835 [label="Ho chiesto, aspettandomi risposte sulla sua affinità temporale, almeno da quello che posso vedere...",shape=box,color=blue];
		j3432120835 -> j3748408911;
	j3748408911 [label="Giusto. Per viaggiare nel tempo, o per avere la parvenza di poter padroneggiare la temporalità.",shape=box,color=red];
		j3748408911 -> j3510969828;
	j396257018 [label="Hai presente il tipo di persona che è?",shape=box,color=red];
		j396257018 -> j1426882714;
	j351278167 [label="Non è completamente malvagio, ma è un giudizio molto approssimativo.",shape=box,color=red];
		j351278167 -> j2338198929;
	j959513441 [label="È responsabile di molte cose. Troppe da elencare, ma Protea è una di queste.",shape=box,color=red];
		j959513441 -> j561816284;
	j3510969828 [label="Sì.",shape=box,color=blue];
		j3510969828 -> j141326503;
		j3510969828 -> j2566767272;
	j1426882714 [label="Sì.",shape=box,color=blue];
		j1426882714 -> j731951514;
	j2338198929 [label="Vabbé",shape=box,color=blue];
		j2338198929 -> j561816284;
	j561816284 [label="Quindi è LUI la persona con cui dovrei parlare?",shape=box,color=blue];
		j561816284 -> j3400533232;
		j561816284 -> j1457634090;
	j141326503 [label="Perché per qualche motivo, tutto ciò che Nova sa fare è chiedere all'unico viaggiatore del tempo che conosce informazioni sui viaggi nel tempo.",shape=box,color=red];
		j141326503 -> j1786843158;
	j2566767272 [label="Perché non vuoi rinunciare? Non che io voglia che tu lo faccia, ma non so davvero come aiutarti.",shape=box,color=red];
		j2566767272 -> j2947357153;
	j731951514 [label="Il Rettore della mia università era così. Se MAI lo rivedrò..",shape=box,color=blue];
		j731951514 -> j3786331553;
	j3400533232 [label="Se vuoi venire conservata come un esperimento scientifico per il resto della tua vita, certo.",shape=box,color=red];
		j3400533232 -> j84928905;
	j1457634090 [label="Non credo che mettervi in contatto sia una buona idea, anche se fosse possibile.",shape=box,color=red];
		j1457634090 -> j2130386506;
	j1786843158 [label="+5 Chemistry",color=orange];
		j1786843158 -> j3162632059;
	j2947357153 [label="Protea, dettagli. Tipo, c'è una come me... ma di lei? Hai capito dai, un mezzo mostro?",shape=box,color=blue];
		j2947357153 -> j2156459533;
		j2947357153 -> j2329184687;
	j3786331553 [label="Pensavo che avrebbe preso le mie difese ma... ",shape=box,color=blue];
		j3786331553 -> j3088819044;
		j3786331553 -> j1323403554;
	j84928905 [label="E venduta al miglior offerente.",shape=box,color=red];
		j84928905 -> j2678830634;
	j2130386506 [label="Cerchiamo di concentrarci su ciò che potrebbe esserti utile.",shape=box,color=red];
		j2130386506 -> j1583776270;
	j3162632059 [label="Sì.",shape=box,color=blue];
		j3162632059 -> j261085532;
	j2156459533 [label="Un mezzo mostro che capirà come funziona il viaggio nel tempo, però. Datti un po' di credito.",shape=box,color=red];
		j2156459533 -> j2592328093;
	j2329184687 [label="Protea è solo un Warframe, per quanto ne sappiamo.",shape=box,color=red];
		j2329184687 -> j4190779629;
	j3088819044 [label="Cosa ti è successo all'Università?",shape=box,color=red];
		j3088819044 -> j1219920521;
	j1323403554 [label="Prendere le tue difese in cosa?",shape=box,color=red];
		j1323403554 -> j1219920521;
	j2678830634 [label="È un uomo intelligente, non un brav'uomo. Non credo sarebbe un alleato.",shape=box,color=red];
