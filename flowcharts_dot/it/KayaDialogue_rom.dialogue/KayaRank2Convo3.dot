	j4013144184 [label="Ma",shape=box,color=blue];
		j4013144184 -> j1313544129;
	j2888977032 [label="Stupida stupida Nova.",shape=box,color=blue];
		j2888977032 -> j2596672905;
	j2133613581 [label="Hm. Beh, supponiamo che Protea abbia la comprensione temporale più avanzata di tutte queste creazioni",shape=box,color=blue];
		j2133613581 -> j1031330290;
	j1313544129 [label="Ascolta, questo è ciò che succederà.",shape=box,color=blue];
		j1313544129 -> j3374896239;
	j2596672905 [label="I voti non contano nulla se i tuoi insegnati si rifiutano di farti entrare in classe.",shape=box,color=blue];
		j2596672905 -> j801019742;
		j2596672905 -> j4242821790;
	j1031330290 [label="La comprensione si basa sulla teoria, sulla scienza, su capacità innate, o.. hm. ",shape=box,color=blue];
		j1031330290 -> j3038329347;
	j3374896239 [label="Viaggerò nel tempo, proprio come hai fatto tu. ",shape=box,color=blue];
		j3374896239 -> j3700671956;
	j801019742 [label="È un mondo diverso ora.",shape=box,color=red];
		j801019742 -> j3261975744;
	j4242821790 [label="Se mai vorrai parlarne...",shape=box,color=red];
		j4242821790 -> j3261975744;
	j3038329347 [label="Beh hm. In realtà. Sì, diciamo che il Vod c'entra qualcosa.",shape=box,color=blue];
		j3038329347 -> j4218532632;
		j3038329347 -> j1740537074;
	j3700671956 [label="Voglio andare nel futuro da dove provieni TU.",shape=box,color=blue];
