		j1740537074 -> j3141765869;
	j560233539 [label="E allora saprò se mi stai fregando o se potrò davvero fidarmi di te, saprò cosa mi riserva il futuro.",shape=box,color=blue];
		j560233539 -> j594879781;
	j3327836131 [label="Ti dirò questo, una volta capito questo \"viaggio nel tempo\", ti dirò di più. Non avrò niente da perdere.",shape=box,color=blue];
