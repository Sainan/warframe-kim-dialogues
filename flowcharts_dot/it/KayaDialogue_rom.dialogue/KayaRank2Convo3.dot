	j3261975744 [label="Lo soooo lo soooo...",shape=box,color=blue];
		j3261975744 -> j3032059243;
	j4218532632 [label="Il Void non è qualcosa che puoi semplicemente 'risolvere'.",shape=box,color=red];
		j4218532632 -> j2200408947;
	j1740537074 [label="Il Void ha a che fare con... tutto.",shape=box,color=red];
		j1740537074 -> j3141765869;
	j2332401196 [label="E allora saprò se mi stai fregando o se potrò davvero fidarmi di te, saprò cosa mi riserva il futuro.",shape=box,color=blue];
		j2332401196 -> j1549011786;
	j3032059243 [label="Ecco, una volta capito questo \"viaggio nel tempo\", ti dirò di più. Non avrò niente da perdere.",shape=box,color=blue];
		j3032059243 -> j2189522063;
	j2200408947 [label="Ma potrebbe essere qualcosa che posso USARE! Ah! È ora di provare qualcosa. ",shape=box,color=blue];
