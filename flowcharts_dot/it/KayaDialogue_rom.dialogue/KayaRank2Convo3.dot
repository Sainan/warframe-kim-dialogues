	j1583776270 [label="Cose... temporali.",shape=box,color=red];
		j1583776270 -> j141326503;
	j261085532 [label="Sono COSÌ felice che tu capisca.",shape=box,color=blue];
		j261085532 -> j3857195902;
		j261085532 -> j1815590999;
	j2592328093 [label="+5 Chemistry",color=orange];
		j2592328093 -> j3990957004;
	j4190779629 [label="Mi dispiace per lei.",shape=box,color=blue];
		j4190779629 -> j4013144184;
	j1219920521 [label="Ugh, fermiamoci a \"Nova contro l'Internet\".",shape=box,color=blue];
