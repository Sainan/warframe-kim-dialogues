		j3136819345 -> j2264371076;
	j2264371076 [label="Giusto. Per il Viaggio nel Tempo, o per l'apparenza di una qualche padronanza delle cose temporali.",shape=box,color=red];
		j2264371076 -> j3510969828;
	j1413657315 [label="Conosci il tipo?",shape=box,color=red];
		j1413657315 -> j1426882714;
	j351278167 [label="Non è completamente malvagio, ma è un giudizio molto approssimativo.",shape=box,color=red];
		j351278167 -> j2338198929;
	j959513441 [label="È responsabile di molte cose. Troppe da elencare, ma Protea è una di queste.",shape=box,color=red];
		j959513441 -> j561816284;
	j3510969828 [label="Sì.",shape=box,color=blue];
