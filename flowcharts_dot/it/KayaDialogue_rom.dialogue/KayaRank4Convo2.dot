	j3706483799 [label="Boolean KayaPromiseRegret is now true.",color=orange];
		j3706483799 -> j636956295;
	j1185118130 [label="Il che è tutto dire.",shape=box,color=red];
		j1185118130 -> j2072611246;
	j1444284801 [label="Quell'atteggiamento che avevi con me? Almeno ha un senso, eri spaventata E arrabbiata. Ero solo un altro sconosciuto su internet.",shape=box,color=red];
		j1444284801 -> j3677431063;
	j3677431063 [label="Non proverò mai a convincerti a non lasciare il 1999. ",shape=box,color=red];
		j3677431063 -> j2176459293;
	"Chat ends. Next chat will be KayaRank4Convo3." [color=orange];
	j2176459293 [label="Sono sicuro che c'è un modo. E per te andartene, non importa dove, è più importante di qualsiasi altra cosa.",shape=box,color=red];
		j2176459293 -> j145444022;
	j145444022 [label="L'aiuto è sempre disponibile. Forse sono più bravo ad ascoltare che a viaggiare nel tempo, però. Non essere timida.",shape=box,color=red];
