	j4067321081 [label="...",shape=box,color=blue];
		j4067321081 -> j2506751873;
	j2506751873 [label="Nessuno di noi ti giudicherebbe mai.",shape=box,color=red];
		j2506751873 -> j2552315770;
	j2552315770 [label="Ciò che ti è successo è una totale violazione personale.",shape=box,color=red];
		j2552315770 -> j2836558525;
	j2836558525 [label="Qualcuno ha tradito la tua fiducia e ha cercato di umiliarti.",shape=box,color=red];
		j2836558525 -> j392623283;
	j392623283 [label="Eri vulnerabile e sei stata tradita.",shape=box,color=red];
		j392623283 -> j4102658808;
	j4102658808 [label="Ti è stata tolta la terra da sotto i piedi. ",shape=box,color=red];
		j4102658808 -> j2425889830;
	j2425889830 [label="La gente ti guardava in modo diverso.",shape=box,color=red];
		j2425889830 -> j3744891498;
	j3744891498 [label="Capisci perché devo andarmene?",shape=box,color=blue];
		j3744891498 -> j4069712872;
	j4069712872 [label="È come se quello che è successo a me non fosse mai successo a NESSUNO.",shape=box,color=blue];
		j4069712872 -> j2755847939;
	j2755847939 [label="Ha fatto notizia. La gente mi prendeva in giro che diceva che fingevo di essere vittima di qualcosa, quando era stata una mia scelta condividere quella foto.",shape=box,color=blue];
		j2755847939 -> j2400135553;
	j2400135553 [label="Non potevi nemmeno cercare il mio nome nei database degli studenti senza che la gente pensasse a quella \"VCI\", ovvero Volgare Cocca dell'Insegnante.",shape=box,color=blue];
		j2400135553 -> j2236970835;
	j2236970835 [label="E anche voi troverete la foto e nessuno mi guarderà più allo stesso modo. Perderò anche... il vostro rispetto. Per sempre",shape=box,color=blue];
		j2236970835 -> j3362805398;
	j3362805398 [label="Devo andarmene, andare avanti, verso un tempo e un luogo in cui sono stata abbastanza intelligente da lasciarmi tutto alle spalle.",shape=box,color=blue];
		j3362805398 -> j4274108078;
		j3362805398 -> j1607712464;
		j3362805398 -> j4074231092;
	j4274108078 [label="Non c'è molto altro da dire. Abbiamo fatto tutti cose di cui ci siamo pentiti. ",shape=box,color=red];
		j4274108078 -> j3532951329;
	j1607712464 [label="Se non altro, ti rispetto di più.",shape=box,color=red];
		j1607712464 -> j4223769976;
	j4074231092 [label="Non ci sarà mai un momento in cui qualcuno di noi ti giudicherà per questo.",shape=box,color=red];
		j4074231092 -> j3051414897;
	j3532951329 [label="Forse un giorno potrai raccontarmi il tuo più grande rimpianto...",shape=box,color=blue];
		j3532951329 -> j1976317995;
		j3532951329 -> j1909047612;
	j4223769976 [label="Non mentirmi.",shape=box,color=blue];
		j4223769976 -> j1129523688;
		j4223769976 -> j2490159732;
	j3051414897 [label="Check boolean KayaEternalismTest",color=orange];
		j3051414897 -> j2713584327 [label=true,color=green];
		j3051414897 -> j2072611246 [label=false,color=brown];
	j1976317995 [label="Forse lo farò. Dopotutto, abbiamo un sacco di tempo.",shape=box,color=red];
		j1976317995 -> j636956295;
	j1909047612 [label="È una promessa. Non sei da sola in questo mondo. Stiamo tutti rischiando con altre persone.",shape=box,color=red];
		j1909047612 -> j3706483799;
	j1129523688 [label="Non è una bugia. Credici e basta. [Fine.]",shape=box,color=red];
		j1129523688 -> j636956295;
	j2490159732 [label="Ascoltami.",shape=box,color=red];
		j2490159732 -> j3051414897;
	j2713584327 [label="Hai evidentemente capito l'Eternalismo, forse meglio di me.",shape=box,color=red];
		j2713584327 -> j1185118130;
	j2072611246 [label="Check boolean KayaAttitude",color=orange];
		j2072611246 -> j1444284801 [label=true,color=green];
