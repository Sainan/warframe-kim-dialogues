		j1607469721 -> j3533980527;
	j3533980527 [label="La gente ti guardava in modo diverso.",shape=box,color=red];
		j3533980527 -> j2602712867;
	j2602712867 [label="Capisci perché devo andarmene?",shape=box,color=blue];
		j2602712867 -> j868973120;
	j868973120 [label="È come se quello che è successo a me non fosse mai successo a NESSUNO.",shape=box,color=blue];
		j868973120 -> j3509516269;
	j3509516269 [label="Ha fatto notizia. La gente mi prendeva in giro che diceva che fingevo di essere vittima di qualcosa, quando era stata una mia scelta condividere quella foto.",shape=box,color=blue];
		j3509516269 -> j268216442;
	j268216442 [label="Non potevi nemmeno cercare il mio nome nei database degli studenti senza che la gente pensasse a quella \"VCI\", ovvero Volgare Cocca dell'Insegnante.",shape=box,color=blue];
		j268216442 -> j4087157903;
	j4087157903 [label="E anche voi troverete la foto e nessuno mi guarderà nello stesso modo. Qualsiasi rispetto... andato. Per sempre",shape=box,color=blue];
		j4087157903 -> j3362805398;
	j3362805398 [label="Devo andarmene, andare avanti, verso un tempo e un luogo in cui sono stata abbastanza intelligente da lasciarmi tutto alle spalle.",shape=box,color=blue];
		j3362805398 -> j4274108078;
		j3362805398 -> j1607712464;
		j3362805398 -> j4074231092;
	j4274108078 [label="Non c'è molto altro da dire. Abbiamo fatto tutti cose di cui ci siamo pentiti. ",shape=box,color=red];
		j4274108078 -> j3532951329;
	j1607712464 [label="Se non altro, ti rispetto di più.",shape=box,color=red];
		j1607712464 -> j4223769976;
	j4074231092 [label="Non ci sarà mai un momento in cui qualcuno di noi ti giudicherà per questo.",shape=box,color=red];
		j4074231092 -> j3051414897;
	j3532951329 [label="Forse un giorno potrai raccontarmi il tuo più grande rimpianto...",shape=box,color=blue];
		j3532951329 -> j1976317995;
		j3532951329 -> j1909047612;
	j4223769976 [label="Non mentirmi.",shape=box,color=blue];
		j4223769976 -> j1129523688;
		j4223769976 -> j2490159732;
