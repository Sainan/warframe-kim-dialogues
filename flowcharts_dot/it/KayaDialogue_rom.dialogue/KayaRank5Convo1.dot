	j4123196853 [label="+20 Chemistry",color=orange];
		j4123196853 -> "Chat ends. Next chat will be KayaRank5Convo2.";
	j839689856 [label="Riguarda di più gli stati della materia e la teoria secondo cui il Void non è \"lineare\" nella nostra comprensione, quindi posso usarlo come trampolino di lancio per SEGUIRTI efficacemente.",shape=box,color=blue];
		j839689856 -> j3728703174;
	j3964771931 [label="Molto molto tantissimo! Vuol dire che la materia ha una connessione tra il VOID e QUI. Atomi, Materia, sono CONSISTENTI in entrambi i luoghi. ",shape=box,color=blue];
		j3964771931 -> j1278846498;
