	j3728703174 [label="Aspetta, seguirmi? ",shape=box,color=red];
		j3728703174 -> j2431167148;
	j1278846498 [label="Il Void non è \"lineare\" nella nostra comprensione, quindi posso usarlo come trampolino di lancio per SEGUIRTI efficacemente.",shape=box,color=blue];
		j1278846498 -> j3728703174;
	j2431167148 [label="Sì, non importa quante volte faccio test o equazioni, mi manca un 'faro', per così dire. Il salto dal trampolino deve atterrare da qualche parte, e se sei tornato indietro una volta dovrebbe essere sufficiente per calibrare. ",shape=box,color=blue];
		j2431167148 -> j707832755;
		j2431167148 -> j1087031311;
	j707832755 [label="Spero tu riesca a fare un salto mortale all'indietro! Faro in arrivo. ",shape=box,color=red];
		j707832755 -> j1117308512;
	j1087031311 [label="Woah non so se me la sento. E se rimani bloccata o ti perdi?! ",shape=box,color=red];
