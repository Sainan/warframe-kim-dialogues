		j1403206272 -> j1055839276;
	j977137656 [label="Riesci a conservarli, lì da dove vieni?",shape=box,color=blue];
		j977137656 -> j2383692679;
		j977137656 -> j956329088;
	j1055839276 [label="Mmm no, non si tratta nemmeno di quelle.",shape=box,color=blue];
