	j432253947 [label="Non succederà. ",shape=box,color=blue];
		j432253947 -> j2137113141;
	j1075438459 [label="Ci sta, la scienza è più efficace se fatta con sicurezza.",shape=box,color=red];
		j1075438459 -> j2541491124;
	j3587471888 [label="Proviamo! Non c'è tempo per la prudenza, andiamo! ",shape=box,color=red];
