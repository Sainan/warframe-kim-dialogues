		j1055839276 -> j2396088184;
	j2383692679 [label="Scompaiono sempre una volta che li estrai dal Void.",shape=box,color=red];
		j2383692679 -> j854436103;
	j956329088 [label="Mai, ho sempre pensato che si deteriorassero. ",shape=box,color=red];
