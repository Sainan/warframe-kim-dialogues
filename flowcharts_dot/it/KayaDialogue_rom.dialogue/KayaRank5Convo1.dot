	j2396088184 [label="Ti riferisci ai Cristalli di Argon?",shape=box,color=red];
		j2396088184 -> j3908572824;
	j854436103 [label="Beh, il punto è proprio questo - nel Void sono inerti.",shape=box,color=blue];
		j854436103 -> j2082623238;
	j3693010039 [label="Non credo, se non riusciamo a capirlo potrei non risolvere mai questo problema.",shape=box,color=blue];
