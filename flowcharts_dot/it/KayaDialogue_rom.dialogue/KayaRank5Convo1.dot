	j4123196853 [label="+20 Chemistry",color=orange];
		j4123196853 -> "Chat ends. Next chat will be KayaRank5Convo2.";
	j1254524176 [label="Si tratta più che altro degli stati della materia e della teoria secondo cui il Void non è “lineare” nella nostra comprensione, quindi posso usarlo come trampolino di lancio per SEGUIRTI efficacemente.",shape=box,color=blue];
		j1254524176 -> j614057990;
	j3152328570 [label="Tantissimissimo! Significa che la materia ha una connessione tra il VOID e QUI. Gli atomi, la materia, sono COERENTI in entrambi i luoghi. ",shape=box,color=blue];
		j3152328570 -> j3974744553;
	"Chat ends. Next chat will be KayaRank5Convo2." [color=orange];
	j614057990 [label="Aspetta, seguirmi? ",shape=box,color=red];
		j614057990 -> j1419243446;
	j3974744553 [label="Il Void non è \"lineare\" nella nostra comprensione, quindi posso usarlo come trampolino di lancio per SEGUIRTI efficacemente.",shape=box,color=blue];
		j3974744553 -> j614057990;
	j1419243446 [label="Sì, non importa quante volte faccia test o equazioni, mi manca un “faro”, per così dire. Il salto dal trampolino deve atterrare da qualche parte e, se sei tornato indietro anche solo una volta, questo dovrebbe essere sufficiente per calibrarlo. ",shape=box,color=blue];
		j1419243446 -> j2439305783;
		j1419243446 -> j1087031311;
	j2439305783 [label="Spero tu riesca a fare un salto mortale all'indietro! Faro in arrivo. ",shape=box,color=red];
		j2439305783 -> j3665588396;
	j1087031311 [label="Woah non so se me la sento. E se rimani bloccata o ti perdi?! ",shape=box,color=red];
		j1087031311 -> j432253947;
	j3665588396 [label="Naturalmente non sono ancora pronta. Misura due volte, controlla tre volte. Misura... 1000 volte. ",shape=box,color=blue];
