digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j1189780581;
	j1189780581 [label="Ciao. Tutti possono viaggiare nel tempo, o solo tu?",shape=box,color=blue];
		j1189780581 -> j621925301;
		j1189780581 -> j3916158448;
	j621925301 [label="Buon giorno anche a te, ascolta ragazzina, non è così semplice.",shape=box,color=red];
		j621925301 -> j2105000259;
	j3916158448 [label="Ciao? Kaya? Come va la tua giornata.",shape=box,color=red];
		j3916158448 -> j3112909224;
	j2105000259 [label="Non sono una ragazzina. Ho 19 anni.",shape=box,color=blue];
		j2105000259 -> j1557986057;
		j2105000259 -> j954604819;
	j3112909224 [label="Bene. ",shape=box,color=blue];
		j3112909224 -> j537079024;
	j1557986057 [label="Giusto. La più giovane di questo nuovo gruppo direi, quindi, ragazzina.",shape=box,color=red];
		j1557986057 -> j74925368;
	j954604819 [label="Sì sì, ma non buttarti a capofitto nella questione viaggi nel tempo. È... complicata.",shape=box,color=red];
		j954604819 -> j2404932222;
	j537079024 [label="Quindi. Solo tu? Ce ne sono altri? Il viaggio nel tempo viene insegnato nelle scuole nel futuro?",shape=box,color=blue];
		j537079024 -> j4017357074;
	j74925368 [label="Ugh. La più giovane, certo, ma anche chiaramente la più intenzionata a trovare risposte. Prova a tenere il passo. Quindi: Viaggio nel Tempo. Come e chi?",shape=box,color=blue];
		j74925368 -> j4100213261;
	j2404932222 [label="Ugh. Quanto complicato? Formule? Elementi chimici e atomici? Posso riuscirci, basta indicarmi una direzione.",shape=box,color=blue];
		j2404932222 -> j2463917306;
		j2404932222 -> j236495194;
	j4017357074 [label="Facciamo solo io. Per rendere le cose più semplici.",shape=box,color=red];
		j4017357074 -> j3439771447;
	j4100213261 [label="E perché tu? Hai un piano? ",shape=box,color=blue];
		j4100213261 -> j2323015620;
	j2463917306 [label="Non so proprio cosa dirti. Non si tratta solo del regno della scienza, e se lo fosse, sarebbe una scienza che Entrati conosce.",shape=box,color=red];
		j2463917306 -> j1095053904;
	j236495194 [label="Ecco una direzione: Stop [Fine.]",shape=box,color=red];
		j236495194 -> j2938341431;
	j3439771447 [label="Per quanto riguarda l'insegnamento nelle scuole, se veniva insegnato, io non l'ho mai studiato. Ma può essere? ",shape=box,color=red];
		j3439771447 -> j1657760974;
	j2323015620 [label="In caso contrario, hai qualche fonte scientifica da consigliarmi sulle tue capacità?",shape=box,color=blue];
		j2323015620 -> j2003824988;
	j1095053904 [label="Ugh quel bastardo. Sapevo che avrei dovuto fargli più domande. Ok. Almeno se è scienza, significa che posso riprodurla, e dato che tu puoi andare e venire, posso cercare di capirci qualcosa. Ciao.",shape=box,color=blue];
		j1095053904 -> j2938341431;
	j2938341431 [label="+20 Chemistry",color=orange];
		j2938341431 -> "Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue";
	j1657760974 [label="Perché, vuoi fare dei compiti? Il viaggio nel tempo è probabilmente una materia troppo avanzata per ora...",shape=box,color=red];
		j1657760974 -> j3707784691;
	j2003824988 [label="Troppe domande, ragazzina. Mi dispiace dirtelo, ma: non lo so. Solo Entrati ha le risposte.",shape=box,color=red];
		j2003824988 -> j285977890;
	"Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue" [label="Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue",color=orange];
		"Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue" -> "Chat ends. Next chat will be KayaRank1Convo2.";
	j3707784691 [label="Ugh, dici sul serio?",shape=box,color=blue];
		j3707784691 -> j3559561883;
	j285977890 [label="Boolean KayaSetKid is now true.",color=orange];
		j285977890 -> j1219546166;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j3559561883 [label="Qualcuno degli Hex l'ha capito? Hanno qualche informazione? ",shape=box,color=blue];
		j3559561883 -> j1250887415;
		j3559561883 -> j4021211590;
	j1219546166 [label="K.",shape=box,color=blue];
		j1219546166 -> j2938341431;
	j1250887415 [label="Forse Amir? Probabilmente conosce giochi con storie riguardanti il viaggio nel tempo...",shape=box,color=red];
		j1250887415 -> j613144324;
	j4021211590 [label="Non credo, ragazzina. Ma se vuoi imparare qualcosa di utile, chiedi a Lettie una guida base sulla guarigione.",shape=box,color=red];
		j4021211590 -> j1722111558;
	j613144324 [label="Boolean KayaAmirTravel is now true.",color=orange];
		j613144324 -> j3871979604;
	j1722111558 [label="Boolean KayaLettieHeal is now true.",color=orange];
		j1722111558 -> j156079075;
	j3871979604 [label="Giochi? Ho solo bisogno di risposte, una pista, qualsiasi cosa. Troverò una soluzione. Se ti viene in mente qualcosa di UTILE, contattami.",shape=box,color=blue];
		j3871979604 -> j2938341431;
	j156079075 [label="Non è il mio stile. Vabbè.",shape=box,color=blue];
		j156079075 -> j2938341431;
}