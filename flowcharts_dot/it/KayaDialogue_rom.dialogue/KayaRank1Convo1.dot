digraph {
	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j1189780581;
	j1189780581 [label="Ciao. Tutti possono viaggiare nel tempo, o solo tu?",shape=box,color=blue];
		j1189780581 -> j621925301;
		j1189780581 -> j3916158448;
	j621925301 [label="Buon giorno anche a te, ascolta ragazzina, non è così semplice.",shape=box,color=red];
		j621925301 -> j2105000259;
	j3916158448 [label="Ciao? Kaya? Come va la tua giornata.",shape=box,color=red];
		j3916158448 -> j3112909224;
	j2105000259 [label="Non sono una ragazzina. Ho 19 anni.",shape=box,color=blue];
		j2105000259 -> j1027598908;
		j2105000259 -> j954604819;
	j3112909224 [label="Bene. ",shape=box,color=blue];
		j3112909224 -> j537079024;
	j1027598908 [label="Giusto. La più giovane di questo nuovo gruppo direi, quindi, ragazzina.",shape=box,color=red];
		j1027598908 -> j1126875710;
	j954604819 [label="Sì sì, ma non buttarti a capofitto nella questione viaggi nel tempo. È... complicata.",shape=box,color=red];
		j954604819 -> j2404932222;
	j537079024 [label="Quindi. Solo tu? Ce ne sono altri? Il viaggio nel tempo viene insegnato nelle scuole nel futuro?",shape=box,color=blue];
		j537079024 -> j4017357074;
	j1126875710 [label="Ugh. La più giovane, certo, ma anche chiaramente la più intenzionata a trovare risposte. Prova a tenere il passo. Quindi: Viaggio nel Tempo. Come e chi?",shape=box,color=blue];
		j1126875710 -> j2501737814;
	j2404932222 [label="Ugh. Quanto complicato? Formule? Elementi chimici e atomici? Posso riuscirci, basta indicarmi una direzione.",shape=box,color=blue];
		j2404932222 -> j2898090232;
		j2404932222 -> j2603591647;
	j4017357074 [label="Facciamo solo io. Per rendere le cose più semplici.",shape=box,color=red];
		j4017357074 -> j3439771447;
	j2501737814 [label="E perché tu? Hai un piano? ",shape=box,color=blue];
		j2501737814 -> j3181108986;
	j2898090232 [label="Non so proprio cosa dirti. Non si tratta solo del regno della scienza, e se lo fosse, sarebbe una scienza che Entrati conosce.",shape=box,color=red];
		j2898090232 -> j2682032442;
	j2603591647 [label="Ecco una direzione: Stop [Fine.]",shape=box,color=red];
		j2603591647 -> j2547432773;
	j3439771447 [label="Per quanto riguarda l'insegnamento nelle scuole, se veniva insegnato, io non l'ho mai studiato. Ma può essere? ",shape=box,color=red];
		j3439771447 -> j1657760974;
	j3181108986 [label="In caso contrario, hai qualche fonte scientifica da consigliarmi sulle tue capacità?",shape=box,color=blue];
		j3181108986 -> j755312243;
	j2682032442 [label="Ugh quel bastardo. Sapevo che avrei dovuto fargli più domande. Ok. Almeno se è scienza, significa che posso riprodurla, e dato che tu puoi andare e venire, posso cercare di capirci qualcosa. Ciao.",shape=box,color=blue];
		j2682032442 -> j2547432773;
	j2547432773 [label="+20 Chemistry",color=orange];
		j2547432773 -> "Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue";
	j1657760974 [label="Perché, vuoi fare dei compiti? Il viaggio nel tempo è probabilmente una materia troppo avanzata per ora...",shape=box,color=red];
		j1657760974 -> j3707784691;
	j755312243 [label="Troppe domande, ragazzina. Mi dispiace dirtelo, ma: non lo so. Solo Entrati ha le risposte.",shape=box,color=red];
		j755312243 -> j2507192691;
	"Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue" [label="Queue conversation HexKayaConvo1 in HexDialogue_rom.dialogue",color=orange];
		"Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue" -> "Chat ends. Next chat will be KayaRank1Convo2.";
	j3707784691 [label="Ugh, dici sul serio?",shape=box,color=blue];
		j3707784691 -> j3559561883;
	j2507192691 [label="Boolean KayaSetKid is now true.",color=orange];
		j2507192691 -> j216897697;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j3559561883 [label="Qualcuno degli Hex l'ha capito? Hanno qualche informazione? ",shape=box,color=blue];
		j3559561883 -> j3861648574;
		j3559561883 -> j2462172155;
	j216897697 [label="K.",shape=box,color=blue];
		j216897697 -> j2547432773;
	j3861648574 [label="Forse Amir? Probabilmente conosce giochi con storie riguardanti il viaggio nel tempo...",shape=box,color=red];
		j3861648574 -> j3069910155;
	j2462172155 [label="Non credo, ragazzina. Ma se vuoi imparare qualcosa di utile, chiedi a Lettie una guida base sulla guarigione.",shape=box,color=red];
		j2462172155 -> j84647072;
	j3069910155 [label="Boolean KayaAmirTravel is now true.",color=orange];
		j3069910155 -> j2435247458;
	j84647072 [label="Boolean KayaLettieHeal is now true.",color=orange];
		j84647072 -> j335064438;
	j2435247458 [label="Giochi? Ho solo bisogno di risposte, una pista, qualsiasi cosa. Troverò una soluzione. Se ti viene in mente qualcosa di UTILE, contattami.",shape=box,color=blue];
		j2435247458 -> j2547432773;
	j335064438 [label="Non è il mio stile. Vabbè.",shape=box,color=blue];
