digraph {
	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j1189780581;
	j1189780581 [label="Ciao. Tutti possono viaggiare nel tempo, o solo tu?",shape=box,color=blue];
		j1189780581 -> j621925301;
		j1189780581 -> j1256458446;
	j621925301 [label="Buon giorno anche a te, ascolta ragazzina, non è così semplice.",shape=box,color=red];
		j621925301 -> j2105000259;
	j1256458446 [label="Ciao? Kaya? Come va la tua giornata.",shape=box,color=red];
		j1256458446 -> j555828895;
	j2105000259 [label="Non sono una ragazzina. Ho 19 anni.",shape=box,color=blue];
		j2105000259 -> j115052067;
		j2105000259 -> j2226103968;
	j555828895 [label="Bene. ",shape=box,color=blue];
		j555828895 -> j3654179384;
	j115052067 [label="Giusto. La più giovane di questo nuovo gruppo direi, quindi, ragazzina.",shape=box,color=red];
		j115052067 -> j4060760733;
	j2226103968 [label="Sì sì, ma non correre troppo con il viaggio nel tempo. È... complicato.",shape=box,color=red];
		j2226103968 -> j2404932222;
	j3654179384 [label="Quindi. Solo tu? Ce ne sono altri? Il viaggio nel tempo viene insegnato nelle scuole nel futuro?",shape=box,color=blue];
		j3654179384 -> j3980958124;
	j4060760733 [label="Ugh. La più giovane, certo, ma anche chiaramente la più intenzionata a trovare risposte. Prova a tenere il passo. Quindi: Viaggio nel Tempo. Come e chi?",shape=box,color=blue];
		j4060760733 -> j1919176807;
	j2404932222 [label="Ugh. Quanto complicato? Formule? Elementi chimici e atomici? Posso riuscirci, basta indicarmi una direzione.",shape=box,color=blue];
		j2404932222 -> j63369159;
		j2404932222 -> j2603591647;
	j3980958124 [label="Facciamo solo io. Per rendere le cose più semplici.",shape=box,color=red];
		j3980958124 -> j3822234527;
	j1919176807 [label="E perché tu? Hai un piano? ",shape=box,color=blue];
		j1919176807 -> j3531992517;
	j63369159 [label="Non so proprio cosa dirti. Non si tratta solo del regno della scienza, e se lo fosse, sarebbe una scienza che Entrati conosce.",shape=box,color=red];
		j63369159 -> j1996503410;
	j2603591647 [label="Ecco una direzione: Stop [Fine.]",shape=box,color=red];
		j2603591647 -> j2547432773;
	j3822234527 [label="Per quanto riguarda l'insegnamento nelle scuole, se veniva insegnato, io non l'ho mai studiato. Ma può essere? ",shape=box,color=red];
		j3822234527 -> j1671241292;
	j3531992517 [label="In caso contrario, cosa puoi consigliarmi per reperire fonti scientifiche sulle tue capacità?",shape=box,color=blue];
		j3531992517 -> j755312243;
	j1996503410 [label="Ugh quel bastardo. Sapevo che avrei dovuto fargli più domande. Ok. Almeno se è scienza, significa che posso riprodurla, e dato che tu puoi andare e venire, posso cercare di capirlo. Ciao.",shape=box,color=blue];
		j1996503410 -> j2547432773;
	j2547432773 [label="+20 Chemistry",color=orange];
		j2547432773 -> "Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue";
	j1671241292 [label="Perché, vuoi dei compiti? Il viaggio nel tempo è probabilmente troppo avanzato per ora...",shape=box,color=red];
		j1671241292 -> j3707784691;
	j755312243 [label="Troppe domande, ragazzina. Mi dispiace dirtelo, ma: non lo so. Solo Entrati ha le risposte.",shape=box,color=red];
		j755312243 -> j2507192691;
	"Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue" [label="Queue conversation HexKayaConvo1 in HexDialogue_rom.dialogue",color=orange];
