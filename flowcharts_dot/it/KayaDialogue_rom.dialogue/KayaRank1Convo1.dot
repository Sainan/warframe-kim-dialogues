digraph {
	0 [label="KayaRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Ciao. Tutti possono viaggiare nel tempo, o solo tu?",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="Buon giorno anche a te, ascolta ragazzina, non è così semplice.",shape=box,color=red];
		2 -> 4;
	3 [label="Ciao? Kaya? Come va la tua giornata.",shape=box,color=red];
		3 -> 5;
	4 [label="Non sono una ragazzina. Ho 19 anni.",shape=box,color=blue];
		4 -> 6;
		4 -> 7;
	5 [label="Bene. ",shape=box,color=blue];
		5 -> 8;
	6 [label="Giusto. La più giovane di questo nuovo gruppo direi, quindi, ragazzina.",shape=box,color=red];
		6 -> 9;
	7 [label="Sì sì, ma non buttarti a capofitto nella questione viaggi nel tempo. È... complicata.",shape=box,color=red];
		7 -> 10;
	8 [label="Quindi. Solo tu? Ce ne sono altri? Il viaggio nel tempo viene insegnato nelle scuole nel futuro?",shape=box,color=blue];
		8 -> 11;
	9 [label="Ugh. La più giovane, certo, ma anche chiaramente la più intenzionata a trovare risposte. Prova a tenere il passo. Quindi: Viaggio nel Tempo. Come e chi?",shape=box,color=blue];
		9 -> 12;
	10 [label="Ugh. Quanto complicato? Formule? Elementi chimici e atomici? Posso riuscirci, basta indicarmi una direzione.",shape=box,color=blue];
		10 -> 13;
		10 -> 14;
	11 [label="Facciamo solo io. Per rendere le cose più semplici.",shape=box,color=red];
		11 -> 15;
	12 [label="E perché tu? Hai un piano? ",shape=box,color=blue];
		12 -> 16;
	13 [label="Non so proprio cosa dirti. Non si tratta solo del regno della scienza, e se lo fosse, sarebbe una scienza che Entrati conosce.",shape=box,color=red];
		13 -> 17;
	14 [label="Ecco una direzione: Stop [Fine.]",shape=box,color=red];
		14 -> 1022;
	15 [label="Per quanto riguarda l'insegnamento nelle scuole, se veniva insegnato, io non l'ho mai studiato. Ma può essere? ",shape=box,color=red];
		15 -> 18;
	16 [label="In caso contrario, hai qualche fonte scientifica da consigliarmi sulle tue capacità?",shape=box,color=blue];
		16 -> 19;
	17 [label="Ugh quel bastardo. Sapevo che avrei dovuto fargli più domande. Ok. Almeno se è scienza, significa che posso riprodurla, e dato che tu puoi andare e venire, posso cercare di capirci qualcosa. Ciao.",shape=box,color=blue];
		17 -> 20;
	1022 [label="+20 Chemistry",color=orange];
		1022 -> 1018;
	18 [label="Perché, vuoi fare dei compiti? Il viaggio nel tempo è probabilmente una materia troppo avanzata per ora...",shape=box,color=red];
		18 -> 21;
	19 [label="Troppe domande, ragazzina. Mi dispiace dirtelo, ma: non lo so. Solo Entrati ha le risposte.",shape=box,color=red];
		19 -> 22;
	20 [label="+20 Chemistry",color=orange];
		20 -> 1015;
	1018 [label="{\"Id\":1018,\"Incoming\":[1022],\"Outgoing\":[1023],\"GraphPos\":[3236,718],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1018 -> 1023;
	21 [label="Ugh, dici sul serio?",shape=box,color=blue];
		21 -> 24;
	22 [label="Update boolean KayaSetKid",color=orange];
		22 -> 25;
	1015 [label="{\"Id\":1015,\"Incoming\":[20],\"Outgoing\":[23],\"GraphPos\":[3252,817],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1015 -> 23;
	1023 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	24 [label="Qualcuno degli Hex l'ha capito? Hanno qualche informazione? ",shape=box,color=blue];
		24 -> 26;
		24 -> 27;
	25 [label="K.",shape=box,color=blue];
		25 -> 28;
	23 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	26 [label="Forse Amir? Probabilmente conosce giochi con storie riguardanti il viaggio nel tempo...",shape=box,color=red];
		26 -> 29;
	27 [label="Non credo, ragazzina. Ma se vuoi imparare qualcosa di utile, chiedi a Lettie una guida base sulla guarigione.",shape=box,color=red];
		27 -> 30;
	28 [label="+20 Chemistry",color=orange];
		28 -> 996;
	29 [label="Update boolean KayaAmirTravel",color=orange];
		29 -> 32;
	30 [label="Update boolean KayaLettieHeal",color=orange];
		30 -> 33;
	996 [label="{\"Id\":996,\"Incoming\":[28],\"Outgoing\":[31],\"GraphPos\":[4241,541],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		996 -> 31;
	32 [label="Giochi? Ho solo bisogno di risposte, una pista, qualsiasi cosa. Troverò una soluzione. Se ti viene in mente qualcosa di UTILE, contattami.",shape=box,color=blue];
		32 -> 34;
	33 [label="Non è il mio stile. Vabbè.",shape=box,color=blue];
		33 -> 35;
	31 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	34 [label="+20 Chemistry",color=orange];
