		j2711152615 -> j393881830;
	j247450732 [label="Sai, Zylo è stato il primo essere vivente a vedermi piangere. ",shape=box,color=blue];
		j247450732 -> j1985217697;
	j3063000864 [label="Ma a volte sono davvero fantastici.",shape=box,color=blue];
		j3063000864 -> j2542610296;
	j1099156012 [label="Oh cielo... un motivo in più per ARRIVARCI. Wow!",shape=box,color=blue];
		j1099156012 -> j229599632;
	j393881830 [label="In realtà potresti avere ragione... ma stavo dicendo, il grande spaventoso Zylo. Era ferocemente protettivo nei miei confronti.",shape=box,color=blue];
		j393881830 -> j247450732;
	j1985217697 [label="Avevo circa 5 anni, e per quanto ne so, mi sono sempre rifiutata di piangere.",shape=box,color=blue];
		j1985217697 -> j3978434947;
	j2542610296 [label="Non possiamo definirci in base al nostro più grande rimpianto. Sento che tu mi hai aiutata a superare il mio.",shape=box,color=blue];
		j2542610296 -> j268229533;
	j229599632 [label="Il mio Zylo era ferocemente protettivo nei miei confronti. ",shape=box,color=blue];
		j229599632 -> j247450732;
	j3978434947 [label="Ma quando tornai a casa dal mio primo giorno di scuola elementare, Zylo era lì ad aspettarmi.",shape=box,color=blue];
		j3978434947 -> j1534125067;
	j268229533 [label="Ma non cambierei il fatto che sia successo. ",shape=box,color=blue];
		j268229533 -> j3336175501;
	j1534125067 [label="E mi ha seguita nella mia stanza e ha fatto la guardia alla porta mentre singhiozzavo.",shape=box,color=blue];
		j1534125067 -> j1908563244;
		j1534125067 -> j265146892;
	j3336175501 [label="Perché non odio quello che sono adesso. Nova? È la cosa più bella di sempre.",shape=box,color=blue];
		j3336175501 -> j127090052;
	j1908563244 [label="Cosa ti ha fatta stare così tanto male?",shape=box,color=red];
		j1908563244 -> j272275870;
	j265146892 [label="Come fai a ricordartelo?",shape=box,color=red];
		j265146892 -> j407097556;
	j127090052 [label="Non cambieresti nulla?",shape=box,color=red];
		j127090052 -> j3663890380;
	j272275870 [label="Qualcuno mi ha chiamata grassa.",shape=box,color=blue];
		j272275870 -> j4155465154;
	j407097556 [label="Come potrei dimenticarlo?!",shape=box,color=blue];
		j407097556 -> j272275870;
	j3663890380 [label="Niente. E spero che neanche tu.",shape=box,color=blue];
		j3663890380 -> j3219460250;
	j4155465154 [label="Che era la cosa che rendeva i ragazzini impopolari quando ero piccola.",shape=box,color=blue];
		j4155465154 -> j3886989954;
		j4155465154 -> j87703;
	j3886989954 [label="I bambini possono essere davvero crudeli.",shape=box,color=red];
		j3886989954 -> j3912862574;
