	j3912862574 [label="Tutti sono crudeli.",shape=box,color=blue];
		j3912862574 -> j818805664;
	j2675640456 [label="Lo era... finché non è successo tutto questo. Mi sento una persona migliore, mi sento come se fossi la persona che avrei dovuto sempre essere.",shape=box,color=blue];
		j2675640456 -> j4155205239;
	j818805664 [label="Tutti vogliono essere i più fighi.",shape=box,color=blue];
		j818805664 -> j2504328329;
