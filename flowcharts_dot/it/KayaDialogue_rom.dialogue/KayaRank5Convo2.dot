		j1091189395 -> j2282207261;
		j1091189395 -> j542722941;
	j1179299673 [label="Ummm suppongo... il mio primo animale domestico? ",shape=box,color=blue];
		j1179299673 -> j1671960463;
	j4085442296 [label=" Sì sì è ok, ma preferisco i cani. Sarà che ne avevo uno e ci sono cresciuta assieme. Vorrei poterlo rivedere.",shape=box,color=blue];
