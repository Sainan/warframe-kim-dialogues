	j2282207261 [label="Non aver fermato prima Ballas.",shape=box,color=red];
		j2282207261 -> j2478916701;
	j542722941 [label="Aver rinunciato a me stesso.",shape=box,color=red];
		j542722941 -> j3665487975;
	j1671960463 [label="Anche se generalmente è una di quelle domande che fanno gli hacker informatici quindi uhh non dirlo a nessuno.",shape=box,color=blue];
		j1671960463 -> j1030840197;
	j2051221149 [label="Le mie condoglianze. È meglio se la chiudiamo qui [Fine.]",shape=box,color=red];
		j2051221149 -> j3219460250;
	j3603457547 [label="Mi dispiace, raccontami di lui.",shape=box,color=red];
		j3603457547 -> j2674458131;
	j3433539324 [label="Ho perso anche io un animale. Come si chiamava?",shape=box,color=red];
		j3433539324 -> j2674458131;
	j2439866330 [label="È che, nonostante questo casino, l'ho semplicemente lasciato scappare.",shape=box,color=red];
		j2439866330 -> j2089561234;
	j2478916701 [label="Non so come avrei potuto cambiare le cose.",shape=box,color=red];
		j2478916701 -> j3643846480;
	j3665487975 [label="Non importa come sembri agli occhi degli altri. C'è stato un momento in cui nessuno mi odiava più di me stesso.",shape=box,color=red];
		j3665487975 -> j1071570851;
	j1030840197 [label="Ma il suo nome era Zylo. Credo lo tu lo chiameresti Kubrow.",shape=box,color=blue];
		j1030840197 -> j943473033;
	j3219460250 [label="+20 Chemistry",color=orange];
		j3219460250 -> "Chat ends. Next chat will be KayaRank5Convo3.";
	j2674458131 [label="In realtà è ingiusto. Entrati può viaggiare nel tempo con il suo strano felino?",shape=box,color=blue];
		j2674458131 -> j3478824199;
	j2089561234 [label="So che pensa di insegnarmi qualcosa, ma quello stronzo non si rende nemmeno conto di cosa mi ha fatto passare.",shape=box,color=red];
		j2089561234 -> j529816263;
	j3643846480 [label="Ma so che se fossi stato anche solo un minuto più veloce, qualcuno avrebbe sofferto di meno.",shape=box,color=red];
		j3643846480 -> j1393189539;
	j1071570851 [label="Non potevo nemmeno MORIRE. E lo desideravo. ",shape=box,color=red];
		j1071570851 -> j442767387;
	j943473033 [label="ENORME, tipo il cane più grande che tu possa immaginare. Potrebbe mordere e mangiarsi il Signor Volkov per metà.",shape=box,color=blue];
		j943473033 -> j4253421240;
		j943473033 -> j2711152615;
	"Chat ends. Next chat will be KayaRank5Convo3." [color=orange];
	j3478824199 [label="Se avessi Zylo con me... questo viaggio sarebbe molto più semplice.",shape=box,color=blue];
		j3478824199 -> j247450732;
	j529816263 [label="E non SOLO io. Tutti noi. E Loid, Gomaitru... è nauseante. Non so se riuscirò a trattenermi se lo vedo.",shape=box,color=red];
		j529816263 -> j442767387;
	j1393189539 [label="Ballas è tutto ciò che temo. È il peggio del peggio. ",shape=box,color=red];
		j1393189539 -> j442767387;
	j442767387 [label="Se la metti così... immagino che a volte la vita e le persone facciano un po' schifo, non è vero?",shape=box,color=blue];
		j442767387 -> j3063000864;
	j4253421240 [label="Da dove vengo io i Kubrow sono ancora molto grandi! ",shape=box,color=red];
		j4253421240 -> j1099156012;
