	j3055268107 [label="Non pretendere di più da Albercht.",shape=box,color=red];
		j3055268107 -> j2850670050;
	j1166949437 [label="Non aver fermato prima Ballas.",shape=box,color=red];
		j1166949437 -> j2720015859;
	j2590655245 [label="Aver rinunciato a me stesso.",shape=box,color=red];
		j2590655245 -> j3446167260;
	j1671960463 [label="Anche se generalmente è una di quelle domande che fanno gli hacker informatici quindi uhh non dirlo a nessuno.",shape=box,color=blue];
		j1671960463 -> j1030840197;
	j2051221149 [label="Le mie condoglianze. È meglio se la chiudiamo qui [Fine.]",shape=box,color=red];
		j2051221149 -> j3219460250;
	j3603457547 [label="Mi dispiace, raccontami di lui.",shape=box,color=red];
		j3603457547 -> j2674458131;
	j3433539324 [label="Ho perso anche io un animale. Come si chiamava?",shape=box,color=red];
		j3433539324 -> j2674458131;
	j2850670050 [label="È come se anche dopo tutto questo me lo sia lasciato scappare.",shape=box,color=red];
		j2850670050 -> j1185681969;
	j2720015859 [label="Non so come avrei potuto cambiare le cose.",shape=box,color=red];
		j2720015859 -> j3076379190;
	j3446167260 [label="Non importa come sembri agli occhi degli altri. C'è stato un momento in cui nessuno mi odiava più di me stesso.",shape=box,color=red];
		j3446167260 -> j3962583519;
	j1030840197 [label="Ma il suo nome era Zylo. Credo lo tu lo chiameresti Kubrow.",shape=box,color=blue];
		j1030840197 -> j943473033;
	j3219460250 [label="+20 Chemistry",color=orange];
		j3219460250 -> "Chat ends. Next chat will be KayaRank5Convo3.";
	j2674458131 [label="In realtà è ingiusto. Entrati può viaggiare nel tempo con il suo strano felino?",shape=box,color=blue];
		j2674458131 -> j3478824199;
	j1185681969 [label="So che pensa di insegnarmi qualcosa, ma quello stronzo non si rende nemmeno conto di cosa mi ha fatto passare.",shape=box,color=red];
		j1185681969 -> j3493795964;
	j3076379190 [label="Ma so che se fossi stato anche solo un minuto più veloce, qualcuno avrebbe sofferto di meno.",shape=box,color=red];
		j3076379190 -> j1025321547;
	j3962583519 [label="Non potevo nemmeno MORIRE. E lo desideravo. ",shape=box,color=red];
		j3962583519 -> j3018396743;
	j943473033 [label="ENORME, tipo il cane più grande che tu possa immaginare. Potrebbe mordere e mangiarsi il Signor Volkov per metà.",shape=box,color=blue];
		j943473033 -> j1538818323;
		j943473033 -> j3023721934;
	"Chat ends. Next chat will be KayaRank5Convo3." [color=orange];
	j3478824199 [label="Se avessi Zylo con me... questo viaggio sarebbe molto più semplice.",shape=box,color=blue];
		j3478824199 -> j247450732;
	j3493795964 [label="E non SOLO io. Tutti noi. E Loid, Gomaitru... è nauseante. Non so se riuscirò a trattenermi se lo vedo.",shape=box,color=red];
		j3493795964 -> j3018396743;
	j1025321547 [label="Ballas è tutto ciò che temo. È peggio della vita stessa. ",shape=box,color=red];
		j1025321547 -> j3018396743;
	j3018396743 [label="Se la metti così... immagino che a volte la vita e le persone facciano un po' schifo, non è vero?",shape=box,color=blue];
		j3018396743 -> j2812040683;
	j1538818323 [label="Da dove vengo io ci sono ancora Kubrow molto grandi ",shape=box,color=red];
		j1538818323 -> j1099156012;
	j3023721934 [label="Ehh non saprei, il Signor Volkov è piuttosto forte.",shape=box,color=red];
		j3023721934 -> j566148700;
	j247450732 [label="Sai, Zylo è stato il primo essere vivente a vedermi piangere. ",shape=box,color=blue];
		j247450732 -> j1985217697;
	j2812040683 [label="Ma a volte è davvero fantastico.",shape=box,color=blue];
		j2812040683 -> j658991;
	j1099156012 [label="Oh cielo... un motivo in più per ARRIVARCI. Wow!",shape=box,color=blue];
		j1099156012 -> j229599632;
	j566148700 [label="In realtà potresti avere ragione... ma comunque, il grande spaventoso Zylo. Ma era ferocemente protettivo nei miei confronti.",shape=box,color=blue];
		j566148700 -> j247450732;
	j1985217697 [label="Avevo circa 5 anni, e per quanto ne so, mi sono sempre rifiutata di piangere.",shape=box,color=blue];
		j1985217697 -> j3978434947;
	j658991 [label="Non possiamo definirci in base al nostro più grande rimpianto. Sento che tu mi hai aiutata a superare il mio.",shape=box,color=blue];
		j658991 -> j1506499425;
	j229599632 [label="Il mio Zylo era ferocemente protettivo nei miei confronti. ",shape=box,color=blue];
		j229599632 -> j247450732;
	j3978434947 [label="Ma quando tornai a casa dal mio primo giorno di scuola elementare, Zylo era lì ad aspettarmi.",shape=box,color=blue];
		j3978434947 -> j1534125067;
	j1506499425 [label="Ma non cambierei il fatto che sia successo. ",shape=box,color=blue];
		j1506499425 -> j167063567;
	j1534125067 [label="E mi ha seguita nella mia stanza e ha fatto la guardia alla porta mentre singhiozzavo.",shape=box,color=blue];
		j1534125067 -> j1130351827;
		j1534125067 -> j3066428220;
	j167063567 [label="Perché, tipo, non lo odio. Nova? È la cosa più bella di sempre.",shape=box,color=blue];
		j167063567 -> j127090052;
	j1130351827 [label="Cosa ti ha fatta arrabbiare così tanto?",shape=box,color=red];
		j1130351827 -> j4193745521;
	j3066428220 [label="Come fai a ricordartelo?",shape=box,color=red];
		j3066428220 -> j158348744;
	j127090052 [label="Non cambieresti nulla?",shape=box,color=red];
		j127090052 -> j3663890380;
	j4193745521 [label="Qualcuno mi ha chiamata grassa.",shape=box,color=blue];
		j4193745521 -> j3156840477;
	j158348744 [label="Come potrei dimenticarlo?!",shape=box,color=blue];
		j158348744 -> j4193745521;
	j3663890380 [label="Niente. E spero che neanche tu.",shape=box,color=blue];
		j3663890380 -> j3219460250;
	j3156840477 [label="Questo era il motivo per cui i ragazzini non erano popolari quando ero piccola.",shape=box,color=blue];
		j3156840477 -> j3886989954;
		j3156840477 -> j5165847;
	j3886989954 [label="I bambini possono essere davvero crudeli.",shape=box,color=red];
		j3886989954 -> j3912862574;
	j5165847 [label="Essere popolari è così importante?",shape=box,color=red];
		j5165847 -> j1119006573;
	j3912862574 [label="Tutti sono crudeli.",shape=box,color=blue];
		j3912862574 -> j818805664;
	j1119006573 [label="Lo ero... finché non è successo tutto questo. Mi sento una persona migliore, mi sento come se fossi la persona che avrei dovuto sempre essere.",shape=box,color=blue];
		j1119006573 -> j4155205239;
	j818805664 [label="Tutti vogliono essere i più fighi.",shape=box,color=blue];
		j818805664 -> j2504328329;
