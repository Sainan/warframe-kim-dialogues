	j3118892891 [label="Hmm ok sì certo. Cos'è? ",shape=box,color=blue];
		j3118892891 -> j3055268107;
		j3118892891 -> j1166949437;
		j3118892891 -> j2590655245;
	j1179299673 [label="Ummm suppongo... il mio primo animale domestico? ",shape=box,color=blue];
		j1179299673 -> j1671960463;
	j1593228994 [label=" Sì sì è ok, sono più una tipa da cani. Sono cresciuta con uno. Vorrei poterlo rivedere.",shape=box,color=blue];
		j1593228994 -> j2051221149;
