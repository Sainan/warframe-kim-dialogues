		j2340943645 -> j1785436966;
	j3374083775 [label="Qualunque cosa ti abbia portata a comportarti così sta rovinando la tua possibilità di essere veramente felice.",shape=box,color=red];
		j3374083775 -> j3227275102;
	j1785436966 [label="Fai pure. Prima te ne vai, meno avrò a che fare con questi atteggiamenti.",shape=box,color=red];
		j1785436966 -> j548993810;
	j3227275102 [label="Non riuscirai a farti odiare. Potrai anche infastidirmi, certo, ma quello non è odiare.",shape=box,color=red];
