	"Chat ends. Next chat will be KayaRank4Convo1." [color=orange];
	j2174460447 [label="Mi hai intrappolata nell'anno peggiore della mia vita. ",shape=box,color=blue];
		j2174460447 -> j2340943645;
	j2340943645 [label="Ti sto letteralmente usando per uscire da qui. ",shape=box,color=blue];
		j2340943645 -> j1648371559;
		j2340943645 -> j1785436966;
	j1648371559 [label="Qualunque cosa ti abbia portata a comportarti così sta rovinando la tua possibilità di essere veramente felice.",shape=box,color=red];
		j1648371559 -> j2532466443;
	j1785436966 [label="Fai pure. Prima te ne vai, meno avrò a che fare con questi atteggiamenti.",shape=box,color=red];
		j1785436966 -> j548993810;
	j2532466443 [label="Non riuscirai a farti odiare. Potrai anche infastidirmi, certo, ma non farti odiare.",shape=box,color=red];
		j2532466443 -> j1984273921;
		j2532466443 -> j4275568047;
	j548993810 [label="Sono contenta che siamo d'accordo.",shape=box,color=blue];
		j548993810 -> j1173661291;
	j1984273921 [label="Se hai bisogno di pensare che ci stai usando, fai pure. ",shape=box,color=red];
		j1984273921 -> j906956744;
	j4275568047 [label="Ti aiuterò in qualche modo.",shape=box,color=red];
		j4275568047 -> j3068908390;
	j1173661291 [label="Boolean KayaAttitude is now true.",color=orange];
		j1173661291 -> j3588492270;
	j906956744 [label="Quando lo capirai, e prima o poi lo capirai, noi saremo ancora qui.",shape=box,color=red];
		j906956744 -> j1905921942;
	j3068908390 [label="Spero che capirai presto che non stiamo cercando di farti del male.",shape=box,color=red];
		j3068908390 -> j434443432;
	j1905921942 [label="Quando lo scoprirete... nessuno di voi mi guarderà più allo stesso modo...",shape=box,color=blue];
		j1905921942 -> j3588492270;
