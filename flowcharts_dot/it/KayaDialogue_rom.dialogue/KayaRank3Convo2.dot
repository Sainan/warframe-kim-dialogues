	j886115224 [label="Ci sto lavorando. Ci sono quasi.",shape=box,color=blue];
		j886115224 -> j2105129186;
	j2105129186 [label="Una volta compreso il viaggio nel tempo, avrai un grattacapo ancora più grande. L'eternalismo. ",shape=box,color=red];
		j2105129186 -> j2800781425;
	j2800781425 [label="Um... cosa?",shape=box,color=blue];
		j2800781425 -> j2364496357;
		j2800781425 -> j1985690034;
	j2364496357 [label="Vediamo se sei abbastanza intelligente da capirlo. Grazie all'eternalismo, c'è una versione di questa conversazione che non finisce qui. [Fine.]",shape=box,color=red];
		j2364496357 -> j3655577789;
	j1985690034 [label="Spero che tu non sia impegnata, perché questo è il vero motivo per cui sono qui.",shape=box,color=red];
		j1985690034 -> j2007948810;
	j3655577789 [label="Boolean KayaEternalismTest is now true.",color=orange];
		j3655577789 -> j2156753723;
	j2007948810 [label="Non sono impegnata, spiegami. Potrebbe essere incredibilmente rilevante per gli ultimi ritocchi teorici sulla manipolazione temporale.",shape=box,color=blue];
		j2007948810 -> j3132731592;
	j2156753723 [label="+20 Chemistry",color=orange];
		j2156753723 -> "Chat ends. Next chat will be KayaRank3Convo3.";
	j3132731592 [label="Tutto questo non è accaduto perché uno scienziato ha scoperto una formula.",shape=box,color=red];
		j3132731592 -> j1890374702;
	"Chat ends. Next chat will be KayaRank3Convo3." [color=orange];
	j1890374702 [label="Beh, credo sia iniziato così.",shape=box,color=red];
		j1890374702 -> j2867205525;
	j2867205525 [label="Ma tutto quello che sta accadendo adesso? Va ben oltre. È perché Albrecht è andato da qualche parte, ha risvegliato qualcosa, e questo lo ha seguito. Il Void.",shape=box,color=red];
		j2867205525 -> j3335248648;
		j2867205525 -> j3545172363;
	j3335248648 [label="Il Void è vivo, ma al tempo stesso non lo è. Esiste ma non esiste. È un paradosso, pur essendo la causa e la ragione di tutto ciò che è accaduto a ognuno di noi.",shape=box,color=red];
		j3335248648 -> j1480639243;
	j3545172363 [label="Non esiste una 'tavola periodica' o una formula per spiegare cosa sia.",shape=box,color=red];
		j3545172363 -> j1662142927;
	j1480639243 [label="Ciao mondo.",shape=box,color=blue];
		j1480639243 -> j142670192;
		j1480639243 -> j3138234116;
	j1662142927 [label="La scienza può spiegarlo. Regola tutto.",shape=box,color=blue];
		j1662142927 -> j3668359530;
	j142670192 [label="\"Addio Albrecht\"",shape=box,color=red];
		j142670192 -> j326569207;
	j3138234116 [label="Cosa?",shape=box,color=red];
		j3138234116 -> j4248441758;
	j3668359530 [label="Check boolean KayaVoidTest",color=orange];
		j3668359530 -> j402228001 [label=true,color=green];
		j3668359530 -> j727127841 [label=false,color=brown];
	j326569207 [label="+5 Chemistry",color=orange];
		j326569207 -> j1544691157;
	j4248441758 [label="È stata la prima cosa in ASSOLUTO pubblicata su internet. Il primo messaggio. Pubblicato dal creatore dell'internet per dimostrare che \"funzionava\".",shape=box,color=blue];
		j4248441758 -> j624717433;
	j402228001 [label="Ti ho detto di fare attenzione con il Void. Ecco perché.",shape=box,color=red];
		j402228001 -> j947579103;
	j727127841 [label="E se non potesse?",shape=box,color=red];
		j727127841 -> j2502339144;
	j1544691157 [label="Ah! Magari. Ma conosci 'Ciao Mondo'?",shape=box,color=blue];
		j1544691157 -> j4248441758;
	j624717433 [label="E da lì si è scatenato l'inferno. La gente ha perso la TESTA. Scienza. Banche. Tecnologia. Intrattenimento.",shape=box,color=blue];
		j624717433 -> j1562017449;
	j947579103 [label="Alcune cose non possono essere regolate.",shape=box,color=red];
		j947579103 -> j1291824780;
	j2502339144 [label="E se tutto quello che credevi fosse una regola ferrea...",shape=box,color=red];
		j2502339144 -> j1266395078;
	j1562017449 [label="E attraverso miliardi di scelte, cause ed effetti, un giorno mi ha portata ad andare online e... ",shape=box,color=blue];
		j1562017449 -> j3713354786;
	j1291824780 [label="Alcune cose non possono essere spiegate.",shape=box,color=red];
		j1291824780 -> j2393963315;
	j1266395078 [label="Fosse successo solo perché un qualcosa là fuori voleva così.",shape=box,color=red];
		j1266395078 -> j2393963315;
	j3713354786 [label="E fu la fine di Nova, o meglio di Kaya. Il suo futuro, la sua carriera, i suoi amici, tutto. Per un errore. ",shape=box,color=blue];
		j3713354786 -> j2313033540;
	j2393963315 [label="Quindi stai dicendo che la parte mancante dei miei esperimenti, test, ricerche e ipotesi è la 'magia'.",shape=box,color=blue];
		j2393963315 -> j3692956602;
		j2393963315 -> j422676506;
	j2313033540 [label="Quindi credo di fidarmi del Void più di quanto mi fidi delle altre persone.",shape=box,color=blue];
		j2313033540 -> j1957885628;
		j2313033540 -> j2472436444;
		j2313033540 -> j918369785;
	j3692956602 [label="Non la magia. Solo... Void. Il Void. Un'altra fonte di energia.",shape=box,color=red];
		j3692956602 -> j1879122722;
	j422676506 [label="Hai visto cosa posso fare? ",shape=box,color=red];
		j422676506 -> j417476454;
	j1957885628 [label="Non farlo [Fine].",shape=box,color=red];
		j1957885628 -> j2156753723;
	j2472436444 [label="Deprimente, Nova.",shape=box,color=red];
		j2472436444 -> j331306947;
	j918369785 [label="Anch'io mi sono fidato.",shape=box,color=red];
		j918369785 -> j331306947;
	j1879122722 [label="Ci posso lavorare.",shape=box,color=blue];
		j1879122722 -> j3988328092;
		j1879122722 -> j536202822;
	j417476454 [label="Visto. Osservato. Annotato. Studiato. Ristudiato. Mhmm. Tutto può essere spiegato. È radicato in qualcosa. 'Magia' forse.",shape=box,color=blue];
		j417476454 -> j1879122722;
	j331306947 [label="Suppongo tu non abbia capito del tutto. ",shape=box,color=blue];
		j331306947 -> j1890002307;
	j3988328092 [label="Provare a fare qualcosa di avventato, potrebbe costarti caro.",shape=box,color=red];
		j3988328092 -> j331306947;
	j536202822 [label="Ci 'puoi lavorare'?",shape=box,color=red];
		j536202822 -> j331306947;
	j1890002307 [label="Ma uscirò dal 1999.",shape=box,color=blue];
		j1890002307 -> j3784413600;
	j3784413600 [label="Non mi importa assolutamente niente di cosa mi succederà nel tentativo di riuscirci.",shape=box,color=blue];
		j3784413600 -> j1036105416;
	j1036105416 [label="È l'unica cosa a cui penso.",shape=box,color=blue];
		j1036105416 -> j2896934932;
	j2896934932 [label="E per me, è una buona cosa. ",shape=box,color=blue];
		j2896934932 -> j2156753723;
