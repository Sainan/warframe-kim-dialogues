	j1452863611 [label="So che abbiamo superato il liceo da un pezzo. ",shape=box,color=blue];
		j1452863611 -> j856594010;
	"Chat ends. Next chat will be KayaRank4Convo4." [color=orange];
	j4190156413 [label="Potrei essere molto vicina, sulla strada giusta.",shape=box,color=blue];
		j4190156413 -> j3197709002;
		j4190156413 -> j2743187512;
	j856594010 [label="Ma non ci vuole una ragazzina-prodigio per capire che ci tieni davvero. E ti rispettiamo tutti.",shape=box,color=blue];
		j856594010 -> j4088901365;
	j3197709002 [label="Sei vicina a scappare dal 1999?",shape=box,color=red];
		j3197709002 -> j82449509;
	j2743187512 [label="Qual'è la tua attuale pista?",shape=box,color=red];
		j2743187512 -> j2200584115;
	j4088901365 [label="Anche Arthur. Intanto, ho una cotta pazzesca per lui.",shape=box,color=blue];
		j4088901365 -> j1211137507;
	j82449509 [label="Sì! Ci sono alcune avvertenze, ovviamente. Il percorso più certo e sicuro è tornare ESATTAMENTE da dove sei venuto, perché lì c'è una specie di \"Impronta Digitale del Void\".",shape=box,color=blue];
		j82449509 -> j3603841109;
		j82449509 -> j2528749002;
		j82449509 -> j2135240102;
	j2200584115 [label="Tu, ovviamente.",shape=box,color=blue];
		j2200584115 -> j3857378876;
		j2200584115 -> j686000745;
	j1211137507 [label="Check boolean ArthurDating",color=orange];
		j1211137507 -> j2592291764 [label=true,color=green];
		j1211137507 -> j3226887656 [label=false,color=brown];
		j1211137507 -> j689996868 [label=false,color=brown];
	j3603841109 [label="Sei ancora sicura di volerlo fare?",shape=box,color=red];
		j3603841109 -> j408855903;
	j2528749002 [label="Il mio tempo non è esattamente migliore, ma almeno sono lì per aiutare.",shape=box,color=red];
		j2528749002 -> j3965941057;
	j2135240102 [label="Mmm, in realtà il Void prende il tema \"dita\" piuttosto seriamente.",shape=box,color=red];
		j2135240102 -> j2330134599;
	j3857378876 [label="Devo essere speciale.",shape=box,color=red];
		j3857378876 -> j82449509;
	j686000745 [label="Io?",shape=box,color=red];
		j686000745 -> j82449509;
	j2592291764 [label="Sai che è impegnato, vero?",shape=box,color=red];
		j2592291764 -> j2876062474;
	j3226887656 [label="Ci metterò una buona parola.",shape=box,color=red];
		j3226887656 -> j3156783066;
	j689996868 [label="Disgustoso.",shape=box,color=red];
		j689996868 -> j1068806826;
	j408855903 [label="Quindi certo. È una sfida. Quel che succede, succede, giusto? Mi tiene impegnata, concentrata... ",shape=box,color=blue];
		j408855903 -> j3179420972;
	j3965941057 [label="Esattamente! Bruciamo le navi! Non guardiamo indietro!",shape=box,color=blue];
		j3965941057 -> j465934596;
	j2330134599 [label="Huh?",shape=box,color=blue];
		j2330134599 -> j996093051;
	j2876062474 [label="Pfft lo so, FORTUNATO! Coooomunque",shape=box,color=blue];
		j2876062474 -> j3652274251;
	j3156783066 [label="PFFT NO, non farlo te l'ho detto in CONFIDENZA! Comunque...",shape=box,color=blue];
		j3156783066 -> j3652274251;
	j1068806826 [label="Um, sei pazzo? Non disgustoso. COMUNQUE!",shape=box,color=blue];
		j1068806826 -> j3652274251;
	j3179420972 [label="Non c'è alcun lato negativo. O lo capisco, o non lo capisco. Ci vediamo qui, o ci vediamo lì. Giusto? Ci vediamo!",shape=box,color=blue];
		j3179420972 -> j465934596;
	j996093051 [label="Tutto questo, tutto ciò che Entrati ha fatto. La sua ricerca del Void, l'essenza di... tutto.",shape=box,color=red];
		j996093051 -> j2510967348;
	j3652274251 [label="Ma in un centro senso è come al liceo, piaci a tutti.",shape=box,color=blue];
		j3652274251 -> j483149573;
	j2510967348 [label="Si riduce a 1 dito. Un dito.",shape=box,color=red];
		j2510967348 -> j2388130879;
	j483149573 [label="E questo dice qualcosa di più profondo della semplice popolarità.",shape=box,color=blue];
		j483149573 -> j4110637176;
	j2388130879 [label="Ti sei fatto fuori le birre di Arthur? Perché non me lo hai detto prima?",shape=box,color=blue];
		j2388130879 -> j3590669870;
		j2388130879 -> j1550274887;
		j2388130879 -> j3928694604;
	j4110637176 [label="Siamo tutti un po' scombinati. ",shape=box,color=blue];
		j4110637176 -> j4181456133;
		j4110637176 -> j3969417353;
		j4110637176 -> j1666939268;
	j3590669870 [label="Il Void. I libri non aiutano molto riguardo a questo.",shape=box,color=red];
		j3590669870 -> j2526252132;
	j1550274887 [label="Una birra probabilmente aiuterebbe a chiarire le cose.",shape=box,color=red];
		j1550274887 -> j2526252132;
	j3928694604 [label="Non è qualcosa che viene semplicemente detto. È la fine e l'inizio.",shape=box,color=red];
		j3928694604 -> j2526252132;
	j4181456133 [label="Scombinati e impegnati! Benvenuta nella squadra [Fine.]",shape=box,color=red];
		j4181456133 -> j465934596;
	j3969417353 [label="Chi pensi che sia il più scombinato?",shape=box,color=red];
		j3969417353 -> j2414011430;
	j1666939268 [label="È un complimento?",shape=box,color=red];
		j1666939268 -> j1022534094;
	j2526252132 [label="Ma cosa intendi per dito?",shape=box,color=blue];
		j2526252132 -> j1449521345;
		j2526252132 -> j241507944;
	j2414011430 [label="Oddio... pettegolezzi? Dopo quello che ti ho appena detto? ",shape=box,color=blue];
		j2414011430 -> j4081059541;
	j1022534094 [label="Assolutamente. Al 100 percento. Perché qui non c'è nessuna competizione.",shape=box,color=blue];
		j1022534094 -> j3330589635;
	j1449521345 [label="Albrecht ha il suo dito.",shape=box,color=red];
		j1449521345 -> j270533568;
	j241507944 [label="C'è un dito di... quello. Nel mio tempo. Il nostro mondo, suppongo.",shape=box,color=red];
		j241507944 -> j270533568;
	j4081059541 [label="(Ma ovviamente Arthur, perché stavo parlando con lui e sembrava che gli avessi davvero messo confusione nella testa).",shape=box,color=blue];
		j4081059541 -> j189736566;
	j3330589635 [label="È una cosa stranissima. Ci stiamo trasformando in mostri, ma è la sensazione più umana che abbia mai sentito.",shape=box,color=blue];
		j3330589635 -> j2846583119;
	j270533568 [label="Ok quindi la materia viene mantenuta, grazie!",shape=box,color=blue];
		j270533568 -> j2787618747;
	j189736566 [label="Il che, tra l'altro, conferma un'ipotesi che avevo formulato sulla tua connessione corporea al 1999.",shape=box,color=blue];
		j189736566 -> j1960834393;
	j2846583119 [label="Ora posso davvero essere me stessa.",shape=box,color=blue];
		j2846583119 -> j3427834669;
	j2787618747 [label="Tutto qui?",shape=box,color=red];
		j2787618747 -> j2384101374;
	j1960834393 [label="Il che è rilevante perché... ah! Test finito. A presto.",shape=box,color=blue];
		j1960834393 -> j465934596;
	j3427834669 [label="Non ho più paura.",shape=box,color=blue];
		j3427834669 -> j3699263378;
	j2384101374 [label="Non 'cos'è'? Perché ha un dito?",shape=box,color=red];
		j2384101374 -> j1078864495;
	j3699263378 [label="Quindi, grazie?",shape=box,color=blue];
		j3699263378 -> j465934596;
	j1078864495 [label="Te ne puoi occupare tu. Gli stati di conservazione della materia sono più interessanti. Grazie!",shape=box,color=blue];
		j1078864495 -> j465934596;
}