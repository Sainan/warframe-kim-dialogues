	"Chat ends. Next chat will be KayaRank4Convo4." [color=orange];
	j4190156413 [label="Potrei essere molto vicina, sulla strada giusta.",shape=box,color=blue];
		j4190156413 -> j3197709002;
		j4190156413 -> j1026025540;
	j3843070036 [label="Ma non ci vuole un genio per capire che ci tieni davvero a noi. E noi ti rispettiamo tutti.",shape=box,color=blue];
		j3843070036 -> j630065031;
	j3197709002 [label="Sei vicina a scappare dal 1999?",shape=box,color=red];
		j3197709002 -> j82449509;
	j1026025540 [label="Qual è la tua pista attuale?",shape=box,color=red];
		j1026025540 -> j2200584115;
	j630065031 [label="Anche Arthur. Oddio ho una cotta pazzesca per lui.",shape=box,color=blue];
		j630065031 -> j1211137507;
	j82449509 [label="Sì! Ci sono alcune avvertenze, ovviamente. Il percorso più certo e sicuro è tornare ESATTAMENTE da dove sei venuto, perché lì c'è una specie di \"Impronta Digitale del Void\".",shape=box,color=blue];
		j82449509 -> j3413031932;
		j82449509 -> j2524445563;
		j82449509 -> j564815703;
	j2200584115 [label="Tu, ovviamente.",shape=box,color=blue];
		j2200584115 -> j3857378876;
		j2200584115 -> j686000745;
	j1211137507 [label="Check boolean ArthurDating",color=orange];
		j1211137507 -> j4284286415 [label=true,color=green];
		j1211137507 -> j3641387995 [label=false,color=brown];
		j1211137507 -> j3810966409 [label=false,color=brown];
	j3413031932 [label="Sei ancora sicura di volerlo fare?",shape=box,color=red];
		j3413031932 -> j2900215625;
	j2524445563 [label="La mia epoca non è esattamente migliore, ma almeno ci sarei io ad aiutarti.",shape=box,color=red];
		j2524445563 -> j3965941057;
	j564815703 [label="Mmh, in realtà il Void prende il tema \"dita\" piuttosto seriamente.",shape=box,color=red];
		j564815703 -> j2330134599;
	j3857378876 [label="Devo essere speciale.",shape=box,color=red];
		j3857378876 -> j82449509;
	j686000745 [label="Io?",shape=box,color=red];
		j686000745 -> j82449509;
	j4284286415 [label="Sai che è impegnato, vero?",shape=box,color=red];
		j4284286415 -> j477697691;
	j3641387995 [label="Metterò una buona parola per te.",shape=box,color=red];
		j3641387995 -> j531785337;
	j3810966409 [label="Disgustoso.",shape=box,color=red];
		j3810966409 -> j785016624;
	j2900215625 [label="Certo. È una sfida. Andrà come deve andare, giusto? Mi tiene impegnata, concentrata... ",shape=box,color=blue];
		j2900215625 -> j3179420972;
	j3965941057 [label="Esattamente! Bruciamo le navi! Non guardiamo indietro!",shape=box,color=blue];
		j3965941057 -> j465934596;
	j2330134599 [label="Huh?",shape=box,color=blue];
		j2330134599 -> j996093051;
	j477697691 [label="Pfft lo so, FORTUNELLO! Coooomunque",shape=box,color=blue];
		j477697691 -> j3852578413;
	j531785337 [label="PFFT NO, non farlo te l'ho detto in CONFIDENZA! Comunque...",shape=box,color=blue];
		j531785337 -> j3852578413;
	j785016624 [label="Um, sei pazzo? Non disgustoso. COMUNQUE!",shape=box,color=blue];
		j785016624 -> j3852578413;
	j3179420972 [label="Non c'è alcun lato negativo. O lo capisco, o non lo capisco. Ci vediamo qui, o ci vediamo lì. Giusto? Ci vediamo!",shape=box,color=blue];
		j3179420972 -> j465934596;
	j996093051 [label="Tutto questo, tutto ciò che Entrati ha fatto. La sua ricerca del Void, l'essenza di... tutto.",shape=box,color=red];
		j996093051 -> j2510967348;
	j3852578413 [label="Ma in un centro senso è come al liceo, piaci a tutti.",shape=box,color=blue];
		j3852578413 -> j3104195628;
	j2510967348 [label="Si riduce a 1 dito. Un dito.",shape=box,color=red];
		j2510967348 -> j2388130879;
	j3104195628 [label="E questo dice qualcosa di più profondo della semplice popolarità.",shape=box,color=blue];
		j3104195628 -> j3156327223;
	j2388130879 [label="Ti sei fatto fuori le birre di Arthur? Perché non me lo hai detto prima?",shape=box,color=blue];
		j2388130879 -> j3213085924;
		j2388130879 -> j1550274887;
		j2388130879 -> j213354733;
	j3156327223 [label="Siamo tutti un po' fuori di testa. ",shape=box,color=blue];
		j3156327223 -> j1035339508;
		j3156327223 -> j2767956448;
		j3156327223 -> j1666939268;
	j3213085924 [label="Il Void. I libri non sono molto d'aiuto su questo argomento.",shape=box,color=red];
		j3213085924 -> j2526252132;
	j1550274887 [label="Una birra probabilmente aiuterebbe a chiarire le cose.",shape=box,color=red];
		j1550274887 -> j2526252132;
	j213354733 [label="Non è qualcosa che si dice così casualmente. È la fine e l'inizio di tutto.",shape=box,color=red];
		j213354733 -> j2526252132;
	j1035339508 [label="Fuori di testa e impegnati! Benvenuta nella squadra [Fine.]",shape=box,color=red];
		j1035339508 -> j465934596;
	j2767956448 [label="Chi pensi che sia quello messo peggio?",shape=box,color=red];
		j2767956448 -> j2583885193;
	j1666939268 [label="È un complimento?",shape=box,color=red];
		j1666939268 -> j1022534094;
	j2526252132 [label="Ma cosa intendi per dito?",shape=box,color=blue];
		j2526252132 -> j750254426;
		j2526252132 -> j1971003440;
	j2583885193 [label="Oddio... vuoi spettegolare? Dopo quello che ti ho detto? ",shape=box,color=blue];
		j2583885193 -> j2527330443;
	j1022534094 [label="Assolutamente. Al 100 percento. Perché qui non c'è nessuna competizione.",shape=box,color=blue];
		j1022534094 -> j3330589635;
	j750254426 [label="Albrecht ha il suo dito.",shape=box,color=red];
		j750254426 -> j2390457486;
	j1971003440 [label="C'è un dito di... quello. Nel mio tempo. Il nostro mondo, suppongo.",shape=box,color=red];
		j1971003440 -> j2390457486;
	j2527330443 [label="(Ma ovviamente Arthur, perché stavo parlando con lui e sembra che tu gli abbia davvero incasinato la testa).",shape=box,color=blue];
		j2527330443 -> j189736566;
	j3330589635 [label="È una cosa stranissima. Ci stiamo trasformando in mostri, ma è la sensazione più umana che abbia mai sentito.",shape=box,color=blue];
		j3330589635 -> j2846583119;
	j2390457486 [label="Ok quindi la materia viene mantenuta, grazie!",shape=box,color=blue];
		j2390457486 -> j3301459560;
	j189736566 [label="Il che, tra l'altro, conferma un'ipotesi che avevo formulato sulla tua connessione corporea al 1999.",shape=box,color=blue];
		j189736566 -> j1960834393;
	j2846583119 [label="Ora posso davvero essere me stessa.",shape=box,color=blue];
		j2846583119 -> j3427834669;
	j3301459560 [label="Tutto qui?",shape=box,color=red];
		j3301459560 -> j2241927661;
	j1960834393 [label="Il che è rilevante perché... ah! Test finito. A presto.",shape=box,color=blue];
		j1960834393 -> j465934596;
	j3427834669 [label="Non ho più paura.",shape=box,color=blue];
		j3427834669 -> j3699263378;
	j2241927661 [label="Non \"cos'è\"? \"Perché ha un dito\"?",shape=box,color=red];
		j2241927661 -> j1078864495;
	j3699263378 [label="Quindi, grazie?",shape=box,color=blue];
		j3699263378 -> j465934596;
	j1078864495 [label="Te ne puoi occupare tu. Gli stati di conservazione della materia sono più interessanti. Grazie!",shape=box,color=blue];
		j1078864495 -> j465934596;
}