	j1615163430 [label="Se non fosse stato per... Entrati?",shape=box,color=red];
		j1615163430 -> j2428547639;
	j2867159009 [label="Oh. Cielo. Pensi davvero che non saprei come fare una torta?",shape=box,color=blue];
