		j2781099457 -> j2906669224;
	j894308459 [label="Essere popolari non è tutto, sai. E se tutti volessero vederti fallire? Se sei sulla vetta, un giorno tutti vorranno farti cadere giù. ",shape=box,color=blue];
		j894308459 -> j2676905593;
		j894308459 -> j2269597724;
	j1304681908 [label="Quindi, per prima cosa, posso mettere insieme le mie teorie e magari provare a intercettare una forma di materia, priva di vita per motivi di sicurezza.",shape=box,color=blue];
