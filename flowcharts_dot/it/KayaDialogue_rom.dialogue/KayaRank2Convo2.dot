	j4071047850 [label="Ho avuto il voto più alto nella storia del mio liceo E durante il mio primo anno di università ho ottenuto il miglior rendimento scolastico degli ultimi 100 anni.",shape=box,color=blue];
		j4071047850 -> j3231524892;
	j879446190 [label="Ma non significa che potresti preparare una torta. A meno che tu non abbia preso lezioni di pasticceria?",shape=box,color=red];
