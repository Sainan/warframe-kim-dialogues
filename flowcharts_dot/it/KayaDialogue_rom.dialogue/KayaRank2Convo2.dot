		j482672640 -> j2188718580;
	j707726388 [label="Come lo sai?",shape=box,color=red];
		j707726388 -> j152784733;
	j488439482 [label="Quanta umiltà, Nova.",shape=box,color=red];
		j488439482 -> j152784733;
	j3427632581 [label="Come puoi esserne sicura?",shape=box,color=red];
		j3427632581 -> j1023303341;
	j2188718580 [label="Devi essere stata una studentessa eccellente.",shape=box,color=red];
		j2188718580 -> j4071047850;
	j152784733 [label="Non devo essere umile. Ho avuto il voto più alto nella storia del mio liceo E durante il mio primo anno di università ho ottenuto il miglior rendimento scolastico degli ultimi 100 anni.",shape=box,color=blue];
		j152784733 -> j879446190;
		j152784733 -> j2806028785;
	j1023303341 [label="Hai mai sentito parlare di 'Nora Night'?",shape=box,color=blue];
		j1023303341 -> j783833081;
		j1023303341 -> j3237024862;
	j4071047850 [label="Ho avuto il voto più alto nella storia del mio liceo E durante il mio primo anno di università ho ottenuto il miglior rendimento scolastico degli ultimi 100 anni.",shape=box,color=blue];
		j4071047850 -> j3231524892;
	j879446190 [label="Ma non significa che potresti preparare una torta. A meno che tu non abbia preso lezioni di pasticceria?",shape=box,color=red];
		j879446190 -> j3044357124;
	j2806028785 [label="Ma non abbastanza intelligente da non iniettarti il siero di Entrati, eh?",shape=box,color=red];
