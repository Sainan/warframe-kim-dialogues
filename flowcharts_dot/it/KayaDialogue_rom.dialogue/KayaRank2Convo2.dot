		j783833081 -> j2759550543;
	j3237024862 [label="Wow, sì. Lei è del mio tempo",shape=box,color=red];
		j3237024862 -> j2759550543;
	j3231524892 [label="Ero molto più di una studentessa eccellente. C'erano università che mi volevano reclutare. Il mio primo anno sarebbe stato perfetto...",shape=box,color=blue];
