	j2894620317 [label="Umile, Nova.",shape=box,color=red];
		j2894620317 -> j152784733;
	j3427632581 [label="Come puoi esserne sicura?",shape=box,color=red];
		j3427632581 -> j1023303341;
	j2188718580 [label="Devi essere stata una studentessa eccellente.",shape=box,color=red];
		j2188718580 -> j4071047850;
	j152784733 [label="Non devo essere umile. Ho avuto il voto più alto nella storia del mio liceo E durante il mio primo anno di università ho ottenuto il miglior rendimento scolastico degli ultimi 100 anni.",shape=box,color=blue];
		j152784733 -> j879446190;
		j152784733 -> j755287387;
	j1023303341 [label="Hai mai sentito parlare di 'Nora Night'?",shape=box,color=blue];
