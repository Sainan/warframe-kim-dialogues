	j1819375505 [label="Ciao. Potresti confermarmi una cosa? ",shape=box,color=blue];
		j1819375505 -> j1669784245;
	j1669784245 [label="La chiave delle tue capacità di viaggiare nel tempo è un mix di Technocyte e Void, in una certa proporzione?",shape=box,color=blue];
