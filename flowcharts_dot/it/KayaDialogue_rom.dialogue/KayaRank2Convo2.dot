		j818858444 -> j482672640;
	j1571820748 [label="Non ne ho mai fatta una, ma scommetto che uscirebbe fantastica.",shape=box,color=blue];
		j1571820748 -> j707726388;
		j1571820748 -> j488439482;
	j482672640 [label="Molto bene. Ci sono vicina in realtà. Molto vicina.",shape=box,color=blue];
