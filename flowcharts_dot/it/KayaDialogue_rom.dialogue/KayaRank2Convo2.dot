		j807634532 -> j2284547783;
		j807634532 -> j855871549;
	j2759550543 [label="Mhmm certo. Beh, sono riuscita a creare una formula per l'intercettazione temporale che ha finito per ricevere delle onde sonore! ",shape=box,color=blue];
		j2759550543 -> j740459941;
	j757893792 [label="Se non fosse stato per... Tutto questo?",shape=box,color=red];
