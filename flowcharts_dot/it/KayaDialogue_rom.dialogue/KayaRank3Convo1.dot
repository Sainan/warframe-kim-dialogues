	j2091450243 [label="Oh, colpa mia. Colpa mia. ",shape=box,color=red];
		j2091450243 -> j359329887;
	j1285824951 [label="In realtà riguarda il mio compleanno, ma non riguarda me. ",shape=box,color=blue];
		j1285824951 -> j2178481780;
