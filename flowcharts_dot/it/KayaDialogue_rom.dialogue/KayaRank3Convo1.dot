		j421629559 -> j2244394746;
	j4251891713 [label="E ad essere sincera, all'inizio mi è sembrato strano, un po' come te. Ma poi l'ho tagliata e il mio coltello da cucina ha colpito qualcosa di duro.",shape=box,color=blue];
		j4251891713 -> j240836023;
	j240836023 [label="Schifoso vero? Mega schifoso. Poi ho guardato e c'era un contenitore di plastica nascosto sotto la torta, pieno di pacchetti di Carte Jinymon sigillate. La mia cosa preferita in assoluto.",shape=box,color=blue];
		j240836023 -> j3031926993;
	j3031926993 [label="Ma una ragazza come me non si farebbe MAI beccare con certa roba a scuola. Questo ragazzino timido ha ovviamente visto com'ero veramente e mi ha portato di nascosto il vero regalo, facendo credere di voler attirare la mia attenzione con una grande torta o qualcosa del genere, non ho idea.",shape=box,color=blue];
