		j2726920961 -> j3549570226;
	j1930827447 [label="E mi ha fatto pensare all'unica volta in cui qualcuno ha preparato una torta per me ed è proprio stato questo timido compagno di classe.",shape=box,color=blue];
		j1930827447 -> j2397054467;
	j2351351074 [label="Ma se volessi?",shape=box,color=red];
