	j1739908956 [label="E ad essere onesti mi ha fatto un po' strano, un po' come è successo a te all'inizio. Ma poi l'ho tagliata e il mio coltello da cucina ha colpito qualcosa di duro.",shape=box,color=blue];
		j1739908956 -> j418233711;
	j418233711 [label="Schifoso vero? Mega schifoso. Ma poi ho guardato ed era come un contenitore di plastica nascosto sotto la torta, pieno di pacchetti di Carte Jinymon sigillate. La mia cosa preferita in assoluto.",shape=box,color=blue];
