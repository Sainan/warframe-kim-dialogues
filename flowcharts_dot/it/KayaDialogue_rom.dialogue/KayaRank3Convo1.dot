		j2244394746 -> j4251891713;
	j2213746661 [label="Avevo dei buoni voti. Più che buoni in realtà. Ed ero capitana delle cheerleader. Era come un grande evento essere invitati alla mia festa di compleanno.",shape=box,color=blue];
		j2213746661 -> j2244394746;
