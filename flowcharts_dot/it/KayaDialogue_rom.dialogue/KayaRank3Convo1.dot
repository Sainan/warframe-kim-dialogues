	j1189043995 [label="+20 Chemistry",color=orange];
		j1189043995 -> j2303558161;
	j167148078 [label="E per qualcuno proveniente da un futuro grandioso e stimolante non hai capito il punto. Carte Jinymon! IO! Ci puoi credere? ",shape=box,color=blue];
		j167148078 -> j2032428271;
		j167148078 -> j2388156361;
	j3163047140 [label="Penso che a modo mio stia cercando di dirti che mi fido di te facendoti sapere che colleziono le Carte Jinymon. Sono un po' da sfigati.",shape=box,color=blue];
