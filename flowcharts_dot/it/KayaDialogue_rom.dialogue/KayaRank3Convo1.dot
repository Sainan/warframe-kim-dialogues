		j359329887 -> j1009711697;
	j2178481780 [label="Beh, credo che un po' lo fosse. Devo dire che, uhm, ero decisamente il tipo di persona con cui tutti volevano essere visti.",shape=box,color=blue];
		j2178481780 -> j4094731605;
