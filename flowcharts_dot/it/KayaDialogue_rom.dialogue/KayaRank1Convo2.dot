		j2041513776 -> j159911564;
	j159911564 [label="In realtà non so niente di certo. So solo che c'era una sequenza, Entrati aveva un piano, e che implicava la mia presenza qui, ora. Dovevo essere qui, per incontrarvi tutti.",shape=box,color=red];
