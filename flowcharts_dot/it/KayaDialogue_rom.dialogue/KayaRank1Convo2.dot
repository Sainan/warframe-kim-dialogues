		"KayaRank1Convo2 begins." -> j2046623589;
	j2046623589 [label="Ciao. Perché la configurazione infra-temporale di Entrati dovrebbe coinvolgere quella che sembra essere una connessione attiva alla Rete Kinemantik Online?",shape=box,color=blue];
		j2046623589 -> j2879731346;
	j2879731346 [label="Ah, ciao, comunque. Per viaggiare nel tempo è necessaria una connessione a Internet?",shape=box,color=blue];
		j2879731346 -> j3295806332;
		j2879731346 -> j3448244605;
	j3295806332 [label="Subito così, ok. No, l'\"internet\" non è arrivato fino ai miei tempi, diciamo, quindi non può essere necessario. O forse lo è. ",shape=box,color=red];
		j3295806332 -> j303283220;
	j3448244605 [label="E ciao anche a te, Kaya. ",shape=box,color=red];
		j3448244605 -> j4204739503;
	j303283220 [label="Quindi non hai bisogno di una connessione internet per andare e venire a tuo piacimento? Entrati invece?",shape=box,color=blue];
		j303283220 -> j700886294;
	j4204739503 [label="Ugh. Internet? Potrei capire come, date le proprietà di una rete..",shape=box,color=blue];
		j4204739503 -> j700886294;
	j700886294 [label="In realtà non so niente di certo. So solo che c'era una sequenza, Entrati aveva un piano che implicava la mia presenza qui e ora. Dovevo venire fin qua, per incontrarvi tutti.",shape=box,color=red];
		j700886294 -> j10307630;
	j10307630 [label="Ok, ma perché in alcuni dei suoi appunti si parla della connessione a Internet come un elemento imprescindibile?",shape=box,color=blue];
		j10307630 -> j3400076006;
		j10307630 -> j69332458;
		j10307630 -> j1824890574;
	j3400076006 [label="Glielo chiederò la prossima volta che lo vedo.",shape=box,color=red];
		j3400076006 -> j3135231552;
	j69332458 [label="Hai i suoi appunti?",shape=box,color=red];
		j69332458 -> j960512602;
	j1824890574 [label="È un problema? Una ragazzina come te non dovrebbe amare l'Internet? ",shape=box,color=red];
