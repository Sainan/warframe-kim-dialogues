		"KayaRank1Convo3 begins." -> j2493320066;
	j2493320066 [label="Viaggiare nel tempo è costoso?  Un costo associato alle materie prime? O nel tuo tempo è stato mercificato in un modo che è rilevante per la nostra situazione?",shape=box,color=blue];
