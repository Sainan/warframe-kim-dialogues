	j3644108345 [label="Perché? Vuoi risparmiare qualche höllaro e corrompermi?",shape=box,color=red];
		j3644108345 -> j1811376875;
	j1795667901 [label="Alcuni costi non hanno il simbolo dell'höllaro. Ah comunque, ciao. ",shape=box,color=red];
