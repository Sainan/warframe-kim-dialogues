		120 -> 127;
	123 [label="In effetti mi ha convinta che mi sbagliavo in alcune delle mie ipotesi, quindi è stato d'aiuto, ma mi ha ricordato che forse posso semplicemente pagare per avere una risposta, o almeno pagare per parlare con qualcun altro dal futuro se tu decidessi di non aiutarmi.",shape=box,color=blue];
