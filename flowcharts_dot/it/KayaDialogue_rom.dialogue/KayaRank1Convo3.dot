	j1811376875 [label="Ha funzionato con Entrati.",shape=box,color=blue];
		j1811376875 -> j1213482325;
		j1811376875 -> j926604984;
	j2954489726 [label="Ciao. Quindi non posso pagare semplicemente qualcuno e imparare come fare?",shape=box,color=blue];
