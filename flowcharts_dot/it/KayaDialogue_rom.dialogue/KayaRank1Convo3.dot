	j2036304050 [label="Allora, era al computer o qualcosa del genere.",shape=box,color=blue];
		j2036304050 -> j3389700054;
	j3151264304 [label="Beh, stiamo cercando di sfruttare al meglio quello che abbiamo, suppongo. Hai parlato con Amir riguardo le tue domande?",shape=box,color=red];
		j3151264304 -> j4288998752;
	j368315635 [label="Check boolean KayaLettieHeal",color=orange];
		j368315635 -> j1374785453 [label=true,color=green];
		j368315635 -> j2689544090 [label=false,color=brown];
	j693274018 [label="Sì, non ti conosco. So solo cosa sai fare. Ecco perché stiamo parlando. Sii serio.",shape=box,color=blue];
		j693274018 -> j3896877936;
	j3419943979 [label="Una promessa da un sconosciuto su internet. Ma per favore. Ah. Dimmi solo quello che voglio sapere.",shape=box,color=blue];
		j3419943979 -> j3680910042;
	j3389700054 [label="Mi sono presentata, e lui si è spaventato. Cioè, NON si aspettava nemmeno che arrivasse qualcuno.",shape=box,color=blue];
		j3389700054 -> j1091483333;
		j3389700054 -> j4198543063;
	j4288998752 [label="Sì. Siamo d'accordo su alcuni principi fondamentali ma non sembra interessato a un teorema concreto e riproducibile del viaggio nel tempo. ",shape=box,color=blue];
		j4288998752 -> j4253972227;
	j1374785453 [label="Beh, stiamo cercando di sfruttare al meglio quello che abbiamo, suppongo. Hai parlato con Lettie? Penso che tu e lei andreste d'accordo.",shape=box,color=red];
		j1374785453 -> j2635744096;
	j2689544090 [label="Giusto, intendevo solo dire che sarebbe un po' più semplice se potessi accedere a strumenti del mio tempo..",shape=box,color=red];
		j2689544090 -> j399307364;
	j3896877936 [label="Ok, torniamo seri.",shape=box,color=red];
		j3896877936 -> j3129147191;
		j3896877936 -> j3518099449;
	j3680910042 [label="Ti è successo qualcosa?",shape=box,color=red];
		j3680910042 -> j4038761822;
	j1091483333 [label="Wow, impressionante.",shape=box,color=red];
		j1091483333 -> j3626940717;
	j4198543063 [label="Wow, ti stai davvero vantando?",shape=box,color=red];
		j4198543063 -> j3626940717;
	j4253972227 [label="In effetti mi ha convinta che mi sbagliavo in alcune delle mie ipotesi, quindi è stato d'aiuto, ma mi ha ricordato che forse posso semplicemente pagare per avere una risposta, o almeno pagare per parlare con qualcun altro dal futuro se tu decidessi di non aiutarmi.",shape=box,color=blue];
		j4253972227 -> j519223617;
		j4253972227 -> j1622771068;
	j2635744096 [label="Andiamo d'accordo. Mi ricorda di un'insegnante che ho avuto, 0 cattiveria e riconosceva il mio intelletto.",shape=box,color=blue];
		j2635744096 -> j1526016341;
	j399307364 [label="È un'offerta? A cosa posso accedere? Qualsiasi cosa sarebbe d'aiuto.",shape=box,color=blue];
		j399307364 -> j856718298;
	j3129147191 [label="Vuoi viaggiare nel tempo, ma dove vuoi andare? E perché?",shape=box,color=red];
		j3129147191 -> j2755778178;
	j3518099449 [label="Ti sei guardata intorno?",shape=box,color=red];
		j3518099449 -> j1060872165;
	j4038761822 [label="È successo qualcosa a tutti noi. Fammi solo sapere se trovi il modo di aiutarmi. ",shape=box,color=blue];
		j4038761822 -> j3994434447;
	j3626940717 [label="Ugh, perché te lo sto dicendo?",shape=box,color=blue];
		j3626940717 -> j3039698863;
	j519223617 [label="Per 10 höllari ti dico come morirai.",shape=box,color=red];
		j519223617 -> j1306950629;
	j1622771068 [label="Chiunque ti stia vendendo qualcosa del genere sta mentendo. Cercherò di aiutarti, davvero. Gratuitamente.",shape=box,color=red];
		j1622771068 -> j2840921210;
	j1526016341 [label="In realtà è super rilassata. E intelligente. Mi ha detto di fidarmi davvero di te, vedremo.",shape=box,color=blue];
		j1526016341 -> j2268525944;
		j1526016341 -> j1491056229;
	j856718298 [label="Vedrò cosa riuscirò a trovare, se vuoi fare tutto di testa tua.",shape=box,color=red];
		j856718298 -> j3612402509;
	j2755778178 [label="Riesci a capire QUALCOSA da solo? Ugh.",shape=box,color=blue];
		j2755778178 -> j2703539329;
	j1060872165 [label="Sì. Ho visto tutto. Questo miracoloso cambio di millennio. Inviti a tantissime feste perché la gente voleva che ci fosse “quella ragazza”.",shape=box,color=blue];
		j1060872165 -> j1853113441;
	j3039698863 [label="Dimmi, devo cominciare a risparmiare o cosa?",shape=box,color=blue];
		j3039698863 -> j748426660;
		j3039698863 -> j2513061573;
	j1306950629 [label="Ugh. Malato.",shape=box,color=blue];
		j1306950629 -> j3994434447;
	j2840921210 [label="Vedremo. No?",shape=box,color=blue];
		j2840921210 -> j3994434447;
	j2268525944 [label="Non sono qui per tradirti o cose del genere, e non sono un manuale sui viaggi nel tempo",shape=box,color=red];
		j2268525944 -> j41162033;
	j1491056229 [label="Ti prometto che puoi fidarti di me, non capisco tutta questa tua ostilità.",shape=box,color=red];
		j1491056229 -> j1136448978;
	j3612402509 [label="Certo. Lo farò.",shape=box,color=blue];
		j3612402509 -> j3994434447;
	j2703539329 [label="Chi vorrebbe rimanere qui? Nel senso..",shape=box,color=blue];
		j2703539329 -> j3394082832;
	j1853113441 [label="Non si fermerà mai. Guarda al futuro. Vieni a cercarmi quando vorrai aiutarmi.",shape=box,color=blue];
		j1853113441 -> j3994434447;
	j748426660 [label="Kaya credo tu sia un po' troppo fissata. Cosa succederà se non riuscirai a capirlo?",shape=box,color=red];
		j748426660 -> j4038762477;
	j2513061573 [label="Non ne ho idea. Sono il presceltooooooo, Kaya. ",shape=box,color=red];
		j2513061573 -> j614920339;
	j41162033 [label="Ugh. K",shape=box,color=blue];
		j41162033 -> j3994434447;
	j1136448978 [label="Ho le mie ragioni",shape=box,color=blue];
		j1136448978 -> j3994434447;
	j3394082832 [label="Ci riuscirò, so che posso farcela. Ciao.",shape=box,color=blue];
		j3394082832 -> j3994434447;
	j4038762477 [label="Ci riuscirò.",shape=box,color=blue];
		j4038762477 -> j3994434447;
	j614920339 [label="Sì, una vera e propria MERDA prescelta",shape=box,color=blue];
