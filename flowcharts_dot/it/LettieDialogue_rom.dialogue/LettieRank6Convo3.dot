		j180431337 -> j4230924925;
	j1339292705 [label="È così triste qui\nNo necesitamos mantenerlo lúgubre y sucio\nPreferirei che parlasse con le piante piuttosto che...\nBeh... con le armi...",shape=box,color=blue];
		j1339292705 -> j1630036647;
	j4074356036 [label="Sí\nA volte è difficile lasciare andare le cose\nAmmettere quando le cose possono cambiare\nPreferirei che parlasse con le piante piuttosto che...\nBeh... con le armi...",shape=box,color=blue];
		j4074356036 -> j1630036647;
