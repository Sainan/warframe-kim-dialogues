		j4026900003 -> j180431337;
	j3967994590 [label="Aaay, non farmi piangere\nSei così dolce a pensare ai miei panquecitos\nGracias\nStavo anche pensando a qualcos'altro\nMa... eh, non ridere",shape=box,color=blue];
