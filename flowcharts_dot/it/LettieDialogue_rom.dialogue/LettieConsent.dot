		j4172583155 -> j2985555336 [label=true,color=green];
		j4172583155 -> "Chat ends." [label=false,color=brown];
	j3270842044 [label="Ehi Lettie? Sei impegnata? [Chiedi il consenso per avere più partner.]",shape=box,color=red];
		j3270842044 -> j1262059206;
	j4063199135 [label="[Fine.]",shape=box,color=red];
		j4063199135 -> j3702107533;
	j1262059206 [label="Sempre\nMa per te?\n¿Qué?",shape=box,color=blue];
		j1262059206 -> j359260076;
	j3702107533 [label="Boolean LettieConsentComplete is now true.",color=orange];
		j3702107533 -> "Chat ends.";
	j359260076 [label="Vorrei parlarti di una cosa e voglio assicurarmi che tu sia d'accordo.",shape=box,color=red];
		j359260076 -> j3617832801;
	j3617832801 [label="Per me è importante che tu non abbia la sensazione che ti stia mentendo o che sia disonesto nei tuoi confronti in alcun modo.",shape=box,color=red];
		j3617832801 -> j2678902356;
		j3617832801 -> j2177149284;
		j3617832801 -> j3549128046;
	j2678902356 [label="Per favore non farmi male.",shape=box,color=red];
		j2678902356 -> j3992875387;
	j2177149284 [label="Per favore non arrabbiarti.",shape=box,color=red];
		j2177149284 -> j4206996728;
	j3549128046 [label="Spero capirai.",shape=box,color=red];
		j3549128046 -> j1838823726;
	j3992875387 [label="Jajajajaj\nNe abbiamo già parlato\nTi faccio male solo nel modo che preferisci\nOra, di cosa stai parlando",shape=box,color=blue];
		j3992875387 -> j3367320133;
	j4206996728 [label="¿Sí?\nE cosa ci sarebbe da arrabbiarsi?",shape=box,color=blue];
		j4206996728 -> j3367320133;
	j1838823726 [label="¿Sí?\nE cosa ci sarebbe da capire?",shape=box,color=blue];
		j1838823726 -> j3367320133;
	j3367320133 [label="Non voglio metterti in una situazione che ti crea disagio. So che non ne abbiamo parlato. Quindi se non sarai d'accordo, va bene. Voglio che tu lo sappia.",shape=box,color=red];
		j3367320133 -> j4001751529;
	j4001751529 [label="Ciò che abbiamo è importante per me - molto importante - ed è reale. Non voglio che ne dubiti.",shape=box,color=red];
		j4001751529 -> j2429090410;
	j2429090410 [label="Aah, entiendo...\nSai che di solito non mi piace essere così\nCredo di voler solo sapere\nCi tieni veramente, solecito?\n¿Quiénes son?\nCi tieni veramente?",shape=box,color=blue];
		j2429090410 -> j1583949113;
		j2429090410 -> j3724468225;
	j1583949113 [label="Ci tengo tanto. Ma tengo moltissimo anche a te.",shape=box,color=red];
		j1583949113 -> j62581712;
	j3724468225 [label="Avrei dovuto immaginare che l'avresti capito in fretta.",shape=box,color=red];
		j3724468225 -> j1820359584;
	j62581712 [label="Ay, sí\nDifficile biasimarti, quando hai visto così tanto\nViaggiato così tanto\nBasta che non mi chiedi di partecipare\nPer me va bene",shape=box,color=blue];
		j62581712 -> j1321783045;
	j1820359584 [label="Ho imbrogliato\nEleanor mi ha avvertita\nJajaja è una pessima pettegola",shape=box,color=blue];
		j1820359584 -> j2925054017;
	j1321783045 [label="Basta che non sia un hex\nMi familia no, ¿por favor?\nDovrei esfoliarmi con i dischetti igienizzanti per una settimana",shape=box,color=blue];
		j1321783045 -> j4218934260;
	j2925054017 [label="Difficile biasimarti, quando hai visto così tanto\nViaggiato così tanto\nBasta che non mi chiedi di partecipare\nPer me va bene",shape=box,color=blue];
		j2925054017 -> j1321783045;
	j4218934260 [label="+20 Chemistry",color=orange];
		j4218934260 -> j330727907;
	j330727907 [label="Sei diventato molto importante per me, solecito\nE se ti rende felice?\nRende felice anche me\nSemplice",shape=box,color=blue];
		j330727907 -> j2848418804;
	j2848418804 [label="Oh\nE trova un modo per organizzare un incontro\nVorrei sapere chi è",shape=box,color=blue];
		j2848418804 -> j3996672793;
		j2848418804 -> j2838510373;
	j3996672793 [label="Sì, signora. :)",shape=box,color=red];
		j3996672793 -> j3702107533;
	j2838510373 [label="Vedrò cosa posso fare.",shape=box,color=red];
		j2838510373 -> j3702107533;
}