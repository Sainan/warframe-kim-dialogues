		j262673417 -> j1592328769;
	j4001637844 [label="Ay, sí, lo so\nE so di averli\nE a volte vorrei che\nLe persone capissero che quella parte di me\nNon è facile da assimilare",shape=box,color=blue];
		j4001637844 -> j3649209567;
	j1592328769 [label="Síí...\nAnche se a volte sono tentata jajaja\nVorrei solo che se ne andasse tutto\nMa tu mi hai raccontato cosa succede\nQuando tutto si anestetizza",shape=box,color=blue];
		j1592328769 -> j281922552;
	j3649209567 [label="Vorrei essere diversa\nMa io sono chi sono\nE ho smesso di scusarmi per questo\nMolto tempo fa",shape=box,color=blue];
