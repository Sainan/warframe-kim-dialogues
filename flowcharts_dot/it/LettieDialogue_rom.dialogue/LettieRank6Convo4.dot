		j1316842812 -> j2765023680;
	j2765023680 [label="A volte vorrei che\nFosse un problema semplice\nCosì da poterlo risolvere, ¿sí?\nParlarne, prenderlo a schiaffi jajaja",shape=box,color=blue];
