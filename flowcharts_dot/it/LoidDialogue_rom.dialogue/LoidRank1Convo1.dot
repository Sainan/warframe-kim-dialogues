digraph {
	"LoidRank1Convo1 begins." [color=orange];
		"LoidRank1Convo1 begins." -> j1113139327;
	j1113139327 [label="Drifter. Perdonami per l'inappropriatezza di questa imposizione, non volevo contattarti tramite questo dispositivo. Ma la situazione è ai limiti di un'emergenza e non sapevo a chi altro rivolgermi.",shape=box,color=blue];
		j1113139327 -> j4157346675;
		j1113139327 -> j3171160829;
	j4157346675 [label="POM2_LAB1?",shape=box,color=red];
		j4157346675 -> j40643567;
	j3171160829 [label="Chi sei...?",shape=box,color=red];
		j3171160829 -> j40643567;
	j40643567 [label="Ah, sì. Ho ancora le impostazioni predefinite. Sono Loid. Avrei dovuto... iniziare con quello, ma ultimamente le cose qui nel Sanctum Anatomica sono state profondamente caotiche.",shape=box,color=blue];
		j40643567 -> j1621375468;
	j1621375468 [label="Ecco perché ti contatto. Ho bisogno del tuo aiuto. Tre protoframe sono arrivati qui, nel Sanctum, nel mio tempo. E non sono quelli a noi precedentemente noti.",shape=box,color=blue];
		j1621375468 -> j1055904299;
	j1055904299 [label="Uno di loro è un",shape=box,color=blue];
		j1055904299 -> j690633147;
	j690633147 [label="Scusa",shape=box,color=blue];
		j690633147 -> j896351585;
	j896351585 [label="Uno di loro è Orokin, Drifter.",shape=box,color=blue];
		j896351585 -> j1561647608;
		j896351585 -> j4175725136;
		j896351585 -> j826136923;
	j1561647608 [label="Dov'è Lotus?",shape=box,color=red];
		j1561647608 -> j4131901472;
	j4175725136 [label="Oh, no... ",shape=box,color=red];
		j4175725136 -> j4159605478;
	j826136923 [label="Cosa?!",shape=box,color=red];
		j826136923 -> j4159605478;
	j4131901472 [label="Lotus e l'Operatore hanno altre questioni di cui occuparsi, credimi. Sono già stati messi a dura prova. Non ti chiederei di aiutarmi con queste questioni se sentissi di avere altre opzioni.",shape=box,color=blue];
		j4131901472 -> j4027800924;
	j4159605478 [label="Non ti chiederei di aiutarmi con queste questioni se sentissi di avere a chi altro rivolgermi. Tu sei... a quanto pare il nuovo esperto in questioni di questo tipo.",shape=box,color=blue];
		j4159605478 -> j3908367712;
	j4027800924 [label="Sembra che tu sia il nuovo esperto in questioni di questo tipo.",shape=box,color=blue];
		j4027800924 -> j3908367712;
	j3908367712 [label="Non so come descriverli al meglio. Ma se vieni al Sanctum, credo che sarà difficile non vederli. Due di loro hanno accettato di parlarti qui tramite POM-2. Uno potrebbe aver bisogno di essere ulteriormente convinto.",shape=box,color=blue];
		j3908367712 -> j2668847518;
	j2668847518 [label="Ho... fede... che avrai successo.",shape=box,color=blue];
		j2668847518 -> j3173882;
