digraph {
	0 [label="LoidRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Drifter. Perdonami per l'inappropriatezza di questa imposizione, non volevo contattarti tramite questo dispositivo. Ma la situazione è ai limiti di un'emergenza e non sapevo a chi altro rivolgermi.",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="POM2_LAB1?",shape=box,color=red];
		2 -> 4;
	3 [label="Chi sei...?",shape=box,color=red];
		3 -> 4;
	4 [label="Ah, sì. Ho ancora le impostazioni predefinite. Sono Loid. Avrei dovuto... iniziare con quello, ma ultimamente le cose qui nel Sanctum Anatomica sono state profondamente caotiche.",shape=box,color=blue];
		4 -> 5;
	5 [label="Ecco perché ti contatto. Ho bisogno del tuo aiuto. Tre protoframe sono arrivati qui, nel Sanctum, nel mio tempo. E non sono quelli a noi precedentemente noti.",shape=box,color=blue];
		5 -> 6;
	6 [label="Uno di loro è un",shape=box,color=blue];
		6 -> 7;
	7 [label="Scusa",shape=box,color=blue];
		7 -> 8;
	8 [label="Uno di loro è Orokin, Drifter.",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
		8 -> 11;
	9 [label="Dov'è Lotus?",shape=box,color=red];
		9 -> 12;
	10 [label="Oh, no... ",shape=box,color=red];
		10 -> 13;
	11 [label="Cosa?!",shape=box,color=red];
		11 -> 13;
	12 [label="Lotus e l'Operatore hanno altre questioni di cui occuparsi, credimi. Sono già stati messi a dura prova. Non ti chiederei di aiutarmi con queste questioni se sentissi di avere altre opzioni.",shape=box,color=blue];
		12 -> 14;
	13 [label="Non ti chiederei di aiutarmi con queste questioni se sentissi di avere a chi altro rivolgermi. Tu sei... a quanto pare il nuovo esperto in questioni di questo tipo.",shape=box,color=blue];
		13 -> 15;
	14 [label="Sembra che tu sia il nuovo esperto in questioni di questo tipo.",shape=box,color=blue];
		14 -> 15;
	15 [label="Non so come descriverli al meglio. Ma se vieni al Sanctum, credo che sarà difficile non vederli. Due di loro hanno accettato di parlarti qui tramite POM-2. Uno potrebbe aver bisogno di essere ulteriormente convinto.",shape=box,color=blue];
		15 -> 16;
	16 [label="Ho... fede... che avrai successo.",shape=box,color=blue];
		16 -> 29;
	29 [label="Update boolean LoidTriadAvailable",color=orange];
		29 -> 17;
	17 [label="Chat ends. Next chat will be LoidFamily.",color=orange];
}