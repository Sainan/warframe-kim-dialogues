		j2502471650 -> "Chat ends." [label="false",color=purple];
	j2918212941 [label="Drifter. Mi arrendo. Roathe, Marie e Lyon mi hanno convinto che il momento è finalmente arrivato.",shape=box,color=blue];
		j2918212941 -> j2939792412;
	j2939792412 [label="Temo ciò che dovrò fare fino al midollo. In effetti, questo potrebbe essere ciò che mi verrà tolto quando verrò fatto a pezzi in un impeto di rabbia quando Gomaitru e la sua famiglia scopriranno cosa è succedeva sotto i loro piedi per tutto questo tempo.",shape=box,color=blue];
		j2939792412 -> j1658778759;
	j1658778759 [label="È strano chiamarla con quel nome ora; ma tra noi sono cambiate così tante cose. E molto altro cambierà, a breve.",shape=box,color=blue];
		j1658778759 -> j3829736640;
		j1658778759 -> j1145282430;
	j3829736640 [label="È il momento. Andrà tutto bene.",shape=box,color=red];
		j3829736640 -> j1277932753;
	j1145282430 [label="Puoi farcela.",shape=box,color=red];
		j1145282430 -> j1277932753;
	j1277932753 [label="Sì, beh. Per favore, vieni a controllare che le mie interiora non vengano usate come decorazioni festive nel Necralisk. Temo di aver bisogno di un po' di rassicurazione, quando tutto sarà finito.",shape=box,color=blue];
		j1277932753 -> j937202740;
	j937202740 [label="Boolean LoidFamilyComplete is now true.",color=orange];
		j937202740 -> "Chat ends.";
