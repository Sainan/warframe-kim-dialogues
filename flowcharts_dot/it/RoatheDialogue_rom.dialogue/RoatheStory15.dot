	2269 [label="Trascrizione: Ero esperto con molte delle nostre armi, ma eccellevo nell'uso di una: la menzogna.",shape=box,color=blue];
		2269 -> 5711;
	5711 [label="La brandivo più spesso contro le mie truppe. Le frustavo fino all'osso con menzogne sul dovere e sulla disciplina.",shape=box,color=blue];
		5711 -> 5712;
	5712 [label="Le soffocavo con la menzogna che la guerra poteva essere vinta. Le trafiggevo con la menzogna del mio favore, della mia stima più profonda per loro.",shape=box,color=blue];
		5712 -> 2265;
	2265 [label="Solo, in privato, rivolgevo quell'arma contro me stesso. Oh, quanto sanguinavo.",shape=box,color=blue];
