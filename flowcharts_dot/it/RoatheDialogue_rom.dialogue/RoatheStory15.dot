	j2098928768 [label="MV: BUGIE",shape=box,color=blue];
		j2098928768 -> j4085122206;
	j4085122206 [label="Trascrizione: Ero esperto con molte delle nostre armi, ma eccellevo nell'uso di una: la menzogna.",shape=box,color=blue];
		j4085122206 -> j3795451178;
	j3795451178 [label="La brandivo più spesso contro le mie truppe. Le frustavo fino all'osso con menzogne sul dovere e sulla disciplina.",shape=box,color=blue];
		j3795451178 -> j3697618389;
	j3697618389 [label="Le soffocavo con la menzogna che la guerra poteva essere vinta. Le trafiggevo con la menzogna del mio favore, della mia stima più profonda per loro.",shape=box,color=blue];
		j3697618389 -> j1632402371;
	j1632402371 [label="Solo, in privato, rivolgevo quell'arma contro me stesso. Oh, quanto sanguinavo.",shape=box,color=blue];
		j1632402371 -> j1648694156;
	j1648694156 [label="Add 1 to HellStory counter",color=orange];
		j1648694156 -> "Chat ends. Next chat will be RoatheStory16.";
