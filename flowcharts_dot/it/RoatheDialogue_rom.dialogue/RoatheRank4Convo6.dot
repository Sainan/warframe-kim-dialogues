digraph {
	2743 [label="RoatheRank4Convo6 begins.",color=orange];
		2743 -> 2744;
	2744 [label="Qual è il tuo modo preferito di uccidere, Usurpatore?",shape=box,color=blue];
		2744 -> 2746;
		2744 -> 2747;
		2744 -> 2745;
	2746 [label="Scusami?",shape=box,color=red];
		2746 -> 2749;
	2747 [label="Lo stai chiedendo per scoprirlo?",shape=box,color=red];
		2747 -> 2750;
	2745 [label="[Fine.]",shape=box,color=red];
		2745 -> 2748;
	2749 [label="Ultimamente mi ritrovo a fare riflessioni filosofiche e sono semplicemente curioso.",shape=box,color=blue];
		2749 -> 2751;
	2750 [label="Ah! Difficilmente. Anche se... fare qualche partita con te sarebbe molto divertente. No, ultimamente mi ritrovo a fare riflessioni filosofiche e sono semplicemente curioso.",shape=box,color=blue];
		2750 -> 2751;
	2748 [label="Chat ends.",color=orange];
	2751 [label="Per quanto riguarda i numeri, credo che io e te saremo probabilmente abbinati. Letalità, mm... Non vorrei piazzare una scommessa, né sono particolarmente interessato a una proverbiale gara di misurazione della spada.",shape=box,color=blue];
		2751 -> 2752;
	2752 [label="Da un assassino all'altro. Quale preferisci? Preferisci qualcosa di ravvicinato e personale? Preferisci la furività o il caos del campo di battaglia?",shape=box,color=blue];
		2752 -> 2753;
		2752 -> 2754;
		2752 -> 2755;
		2752 -> 2756;
	2753 [label="Preferisco il caos. Esplosioni. Spari. Rumori forti. Più ce n'è, meglio è.",shape=box,color=red];
		2753 -> 2757;
	2754 [label="Furtività. Preferisco eliminare il nemico prima ancora che si accorga della mia presenza. Lo farei dove dorme, se potessi.",shape=box,color=red];
		2754 -> 2758;
	2755 [label="Odio litigare. Vorrei non doverlo mai fare.",shape=box,color=red];
		2755 -> 2759;
	2756 [label="Questa è una conversazione malata.",shape=box,color=red];
		2756 -> 2760;
	2757 [label="Update boolean RoatheSoldier",color=orange];
		2757 -> 2761;
	2758 [label="Update boolean RoatheAssassin",color=orange];
		2758 -> 2762;
	2759 [label="Oh mio povero, povero Usurpatore, se solo avessi potuto sentirmi ridere...",shape=box,color=blue];
		2759 -> 2763;
	2760 [label="Allora, shoo.",shape=box,color=blue];
		2760 -> 2764;
	2761 [label="Un soldato consumato dalla battaglia come me. Non mi sorprende, visto quello che so del tuo passato. Tanto sangue ti segue ovunque tu vada. Prima Duviri, poi \"Narmer\", questa Höllvania. Ora questa faccenda.",shape=box,color=blue];
		2761 -> 2765;
	2762 [label="Ah, un assassino tra noi! Così utile e così poco apprezzato. Ho sempre paragonato gli assassini a maggiordomi di talento.",shape=box,color=blue];
		2762 -> 2766;
	2763 [label="Tu miserabile e indigente creatura. Spero per il tuo bene che tu mi stia mentendo.",shape=box,color=blue];
		2763 -> 2767;
	2764 [label="Chat ends.",color=orange];
	2765 [label="Chissà cos'altro, o cosa è successo dopo, o cosa hai dimenticato nel frattempo. La morte è la tua arte e tu dipingi i mondi in essa.",shape=box,color=blue];
		2765 -> 2768;
	2766 [label="Quando svolgono il loro lavoro in modo eccezionale, passano sempre inosservati.",shape=box,color=blue];
		2766 -> 2769;
	2767 [label="+20 Chemistry",color=orange];
		2767 -> 2770;
	2768 [label="Quindi! Qual è il tuo pennello preferito? Scopriamolo.",shape=box,color=blue];
		2768 -> 2771;
		2768 -> 2772;
		2768 -> 2773;
		2768 -> 2774;
	2769 [label="Quindi. Pugnale? Veleno? Arco?",shape=box,color=blue];
		2769 -> 2775;
		2769 -> 2776;
		2769 -> 2777;
		2769 -> 2778;
		2769 -> 2779;
	2770 [label="Altrimenti questa potrebbe essere la cosa più triste che abbia mai sentito in tutti questi anni.",shape=box,color=blue];
		2770 -> 2780;
	2771 [label="Onestamente, mi arrangio con quello che posso. Mi piace improvvisare.",shape=box,color=red];
		2771 -> 2781;
	2772 [label="Un arco. Elegante e letale.",shape=box,color=red];
		2772 -> 2782;
	2773 [label="Una lama. Mi piace avvicinarmi.",shape=box,color=red];
		2773 -> 2783;
	2774 [label="Fucili e pistole. Sono rumorosi, ma fanno il loro lavoro.",shape=box,color=red];
		2774 -> 2784;
	2775 [label="Onestamente, mi arrangio con quello che posso. Mi piace improvvisare.",shape=box,color=red];
		2775 -> 2785;
	2776 [label="Un arco. Grazioso e silenzioso.",shape=box,color=red];
		2776 -> 2786;
	2777 [label="Fucile da cecchino. Un colpo? Un'uccisione.",shape=box,color=red];
		2777 -> 2787;
	2778 [label="Veleno. Me ne vado prima ancora che si accorgano di essere morti.",shape=box,color=red];
		2778 -> 2788;
	2779 [label="Pugnale. Mi piace la sua intimità.",shape=box,color=red];
		2779 -> 2789;
	2780 [label="Update boolean RoatheWeaponNone",color=orange];
		2780 -> 2790;
	2781 [label="Sono qui seduto a immaginarti mentre imperversi sul campo di battaglia con una panca da medico. Mentre fai a pezzi i soldati con uno pneumatico legato a un pezzo di tupo piegato.",shape=box,color=blue];
		2781 -> 2791;
	2782 [label="Per maneggiare un arco nel vivo della battaglia ci vogliono determinazione e lucidità mentale come pochi. E, naturalmente, mani ferme.",shape=box,color=blue];
		2782 -> 2792;
	2783 [label="Mm, attento. Non farmi agitare troppo, Usurpatore. Quanto mi piacerebbe vederti danzare sul campo di battaglia, armi in pugno, spruzzi di sangue come i petali di un fiore che sboccia...",shape=box,color=blue];
		2783 -> 2793;
	2784 [label="Sono stati il cavallo di battaglia di ogni guerra sin dal momento in cui sono stati inventati, per una ragione per precisa, Usurpatore. È tuttavia difficile negare che, quando raggiungono il bersaglio prefissato, raggiungono il loro obiettivo.",shape=box,color=blue];
		2784 -> 2794;
	2785 [label="Sono qui seduto a immaginarti mentre assassini qualcuno con una posata o la gamba di una sedia. Mentre spegni la vita di qualcuno con il fermaglio di una tenda.",shape=box,color=blue];
		2785 -> 2795;
	2786 [label="La scelta del cacciatore. Non avanzata ma elegante nella sua semplicità. A volte i metodi più semplici e antichi sono in fondo i più efficaci.",shape=box,color=blue];
		2786 -> 2796;
	2787 [label="Un po' impersonale e clinico per i miei gusti, ma non posso giudicarlo per la sua efficienza. C'è qualcosa da dire sulla calma.",shape=box,color=blue];
		2787 -> 2797;
	2788 [label="Il sinistro apotecario, mh? Che prepara tinture e versa fiale nei bicchieri degli ignari? O che inietta veleno nei propri coltelli e proiettili in modo che il minimo colpo di striscio sul campo di battaglia diventi fatale?",shape=box,color=blue];
		2788 -> 2798;
	2789 [label="Mm, attento. Non farmi agitare troppo, Usurpatore. Quanto è intrigante l'immagine di svegliarsi una notte con te che ti nascondi nell'ombra, con un pugnale in mano, pronto a colpire...",shape=box,color=blue];
		2789 -> 2799;
	2790 [label="Chat ends.",color=orange];
	2791 [label="+10 Chemistry",color=orange];
		2791 -> 2800;
	2792 [label="Il silenzio di tutto questo è da apprezzare. L'incocco di una freccia, la sua scocca, l'attesa della scoccata... e poi la dolce, dolcissima morte quando colpisce il bersaglio?",shape=box,color=blue];
		2792 -> 2801;
	2793 [label="Apprezzo il desiderio di un tocco personale. Vedere gli arti della tua vittima sgretolarsi mentre poni fine alla sua vita. Vedere i suoi corpi senza vita accartocciarsi davanti a te. Sapere che sei stato tu a farlo, e nessun altro.",shape=box,color=blue];
		2793 -> 2802;
	2794 [label="Disordinato, rumoroso, esageratamente costoso. Ma bravissimo a uccidere.",shape=box,color=blue];
		2794 -> 2803;
	2795 [label="+10 Chemistry",color=orange];
		2795 -> 2804;
	2796 [label="Il silenzio di tutto questo è da apprezzare. L'incocco di una freccia, la sua scocca, l'attesa della scoccata... e poi la dolce, dolcissima morte quando colpisce il bersaglio?",shape=box,color=blue];
		2796 -> 2805;
	2797 [label="Nel frastuono apparentemente implacabile del campo di battaglia, il cecchino deve trovare il respiro come la marea dell'oceano. Inspira, espira e togli una vita.",shape=box,color=blue];
		2797 -> 2806;
	2798 [label="Ho visto interi battaglioni ridotti in poltiglia per un singolo taglio sul braccio di un singolo soldato. Una tossina che si diffonde dal sangue ai polmoni e poi ai polmoni di un altro soldato può distruggere intere nazioni.",shape=box,color=blue];
		2798 -> 2807;
	2799 [label="Apprezzo il desiderio di un tocco personale. Guardare negli occhi un'altra persona e vederli diventare vitrei e offuscati mentre la luce svanisce e il calore abbandona il suo corpo.",shape=box,color=blue];
		2799 -> 2808;
	2800 [label="Io... non so decidere se questo ti renda più o meno terrificante, Usurpatore. Credo che mi accontenterò di qualcosa di più. In ogni caso, lo trovo divertente e sorprendente di per sé.",shape=box,color=blue];
		2800 -> 2809;
	2801 [label="+10 Chemistry",color=orange];
		2801 -> 2810;
	2802 [label="+10 Chemistry",color=orange];
		2802 -> 2811;
	2803 [label="+10 Chemistry",color=orange];
		2803 -> 2812;
	2804 [label="Io... non so decidere se questo ti renda più o meno terrificante, Usurpatore. Credo che mi accontenterò di qualcosa di più. In ogni caso, lo trovo divertente e sorprendente di per sé.",shape=box,color=blue];
		2804 -> 2813;
	2805 [label="+10 Chemistry",color=orange];
		2805 -> 2814;
	2806 [label="+10 Chemistry",color=orange];
		2806 -> 2815;
	2807 [label="+10 Chemistry",color=orange];
		2807 -> 2816;
	2808 [label="+10 Chemistry",color=orange];
		2808 -> 2817;
	2809 [label="Update boolean RoatheWeaponImprov",color=orange];
		2809 -> 2818;
		2809 -> 2819;
		2809 -> 2820;
	2810 [label="Bellissimo.",shape=box,color=blue];
		2810 -> 2821;
	2811 [label="Che bel momento.",shape=box,color=blue];
		2811 -> 2822;
	2812 [label="C'è un certo tipo di bellezza in esso.",shape=box,color=blue];
		2812 -> 2823;
	2813 [label="Update boolean RoatheWeaponImprov",color=orange];
		2813 -> 2818;
		2813 -> 2819;
		2813 -> 2820;
	2814 [label="Bellissimo.",shape=box,color=blue];
		2814 -> 2824;
	2815 [label="C'è bellezza in tutto questo.",shape=box,color=blue];
		2815 -> 2825;
	2816 [label="Una morte di queste proporzioni? C'è bellezza in essa.",shape=box,color=blue];
		2816 -> 2826;
	2817 [label="Che bel momento.",shape=box,color=blue];
		2817 -> 2827;
	2818 [label="Stai facendo sembrare tutto questo come se fosse una specie di... forma d'arte.",shape=box,color=red];
		2818 -> 2828;
	2819 [label="Non mi piace dover uccidere la gente, Roathe. ",shape=box,color=red];
		2819 -> 2829;
	2820 [label="E qual è il tuo preferito?",shape=box,color=red];
		2820 -> 2830;
	2821 [label="Update boolean RoatheWeaponBow",color=orange];
		2821 -> 2818;
		2821 -> 2819;
		2821 -> 2820;
	2822 [label="Update boolean RoatheWeaponDagger",color=orange];
		2822 -> 2818;
		2822 -> 2819;
		2822 -> 2820;
	2823 [label="Update boolean RoatheWeaponSniper",color=orange];
		2823 -> 2818;
		2823 -> 2819;
		2823 -> 2820;
	2824 [label="Update boolean RoatheWeaponBow",color=orange];
		2824 -> 2818;
		2824 -> 2819;
		2824 -> 2820;
	2825 [label="Update boolean RoatheWeaponSniper",color=orange];
		2825 -> 2818;
		2825 -> 2819;
		2825 -> 2820;
	2826 [label="Update boolean RoatheWeaponPoison",color=orange];
		2826 -> 2818;
		2826 -> 2819;
		2826 -> 2820;
	2827 [label="Update boolean RoatheWeaponDagger",color=orange];
		2827 -> 2818;
		2827 -> 2819;
		2827 -> 2820;
	2828 [label="Perché lo è. E lo sai. Infatti, metà della tua esistenza è letteralmente basata sul concetto di uccidere come forma d'arte!",shape=box,color=blue];
		2828 -> 2831;
	2829 [label="Oh? Davvero? prendiamoci un momento per esaminarlo.",shape=box,color=blue];
		2829 -> 2832;
	2830 [label="Di recente è cambiato. E questo mi dà un gran fastidio.",shape=box,color=blue];
		2830 -> 2833;
		2830 -> 2834;
	2831 [label="Vedo queste \"scuole\" che i Tenno esercitano, e che prendi in prestito per procura. Per non parlare degli insegnamenti dei Dax. Come continuavano a parlare all'infinito nelle comunicazioni, non importa quante volte gli avessimo detto che era un canale riservato.",shape=box,color=blue];
		2831 -> 2835;
	2832 [label="Dimmi, e per favore, rispondimi sinceramente. Perché mentire in questo momento da un danno a entrambi, ma in particolar modo a te stesso:",shape=box,color=blue];
		2832 -> 2836;
	2833 [label="Cambiato, come?",shape=box,color=red];
		2833 -> 2837;
	2834 [label="A causa di Uriel?",shape=box,color=red];
		2834 -> 2838;
	2835 [label="Se non sentirò mai più uno di loro dirmi che \"sono una lama\" e che \"esisto per colpire\", morirò felice, Usurpatore.",shape=box,color=blue];
		2835 -> 2839;
	2836 [label="Hai mai pensato di equipaggiarti con un'arma o un Warframe personalizzato in base ai tuoi gusti personai? Magari con una verniciatura unica o con un look che ritieni più adatto al tuo umore?",shape=box,color=blue];
		2836 -> 2840;
		2836 -> 2842;
		2836 -> 2841;
	2837 [label="Un tempo preferivo la spada come arma. Elegante. Veloce. Potevo muovermi sul campo e tagliare i nemici nelle vicinanze. Cremisi su una lama argentata, che brillava al bagliore di una stella blu.",shape=box,color=blue];
		2837 -> 2843;
	2838 [label="Immagino di sì. O forse a causa della mia perdita di memoria. Non so quali altre ragioni possano esserne la causa.",shape=box,color=blue];
		2838 -> 2837;
	2839 [label="L'umanità ha sempre considerato l'omicidio un peccato, ma l'uccisione come un'arte. Non lo hai mai trovato strano? Brandire una lama e abbattere un nemico in combattimento significa essere visti come essere quasi trascendenti.",shape=box,color=blue];
		2839 -> 2844;
	2840 [label=" Io ho... cosa c'entra con tutto questo?",shape=box,color=red];
		2840 -> 2845;
	2842 [label="No. Mai.",shape=box,color=red];
		2842 -> 2847;
	2841 [label="Non giocherò a questo gioco. [Fine.]",shape=box,color=red];
		2841 -> 2846;
	2843 [label="Ma ora? Ora desidero sentire il sapore del sangue sui miei denti. Sentirlo sgorgare sotto i miei artigli. Vorrei affondare le mie unghie nella carne e farla a pezzi.",shape=box,color=blue];
		2843 -> 2848;
	2844 [label="Uccidere un uomo con un pezzo di metallo affilato in un vicolo è da codardi e degenerati. ",shape=box,color=blue];
		2844 -> 2849;
	2845 [label="Apprezzo la tua onestà. Ora, non voglio dire che probabilmente non piace l'omicidio a sangue freddo, e che il massacro di una vita innocente non è qualcosa che ti piace (anche se forse ti piace e la tua precedente affermazione era una bugia, e quanto sarebbe delizioso rivelarlo, ma non è questo che vogliamo discutere qui).",shape=box,color=blue];
		2845 -> 2850;
	2847 [label="Ti chiedo di prenderti un lungo momento per riflettere. Ho visto i tuoi aimci Tenno scaternarsi in questo posto, come incubi multicolore da circo-arena. Come un animale selvatico caduto nei contenitori di pigmenti. ",shape=box,color=blue];
		2847 -> 2852;
	2846 [label="Molto bene.",shape=box,color=blue];
		2846 -> 2851;
	2848 [label="Voglio bere l'icore mentre spezzo i tendini e sento il corpo lacerarsi sotto di me, trasformandolo in nient'altro che una scheggia sanguigna. Sbucciarlo come un frutto dolce, mentre il midollo scorre.",shape=box,color=blue];
		2848 -> 2853;
		2848 -> 2854;
	2849 [label="Qual è la differenza? \"Onore\"? Chi decide cosa è onorevole e cosa non lo è? Il perdente? O il vincitore? O è semplicemente l'esistenza di una tradizione sufficiente a stabilire cosa è onorevole e cosa non lo è?",shape=box,color=blue];
		2849 -> 2857;
		2849 -> 2855;
		2849 -> 2856;
	2850 [label="Supponendo che non sia così e che tu stia semplicemente uccidendo perché \"devi\", come hai detto, allora perché, dovresti perdere tempo ad equipaggiare le tue armi di morte in modo personalizzato?",shape=box,color=blue];
		2850 -> 2858;
	2852 [label="Non ti sei mai sentito obbligato a fare lo stesso? Nemmeno una volta? Ti giuro che non smetterò di stimarti se lo ammetti.",shape=box,color=blue];
		2852 -> 2859;
		2852 -> 2860;
	2851 [label="Chat ends.",color=orange];
	2853 [label="Roathe?",shape=box,color=red];
		2853 -> 2861;
	2854 [label="E questo... non è normale per te?",shape=box,color=red];
		2854 -> 2862;
	2857 [label="Capisco il tuo punto di vista. La linea è sfocata. ",shape=box,color=red];
		2857 -> 2865;
	2855 [label="Uno richiede pratica e dedizione. L'altra è solo... brutalità.",shape=box,color=red];
		2855 -> 2863;
	2856 [label="Non ho intenzione di affrontare questa conversazione. [Fine.]",shape=box,color=red];
		2856 -> 2864;
	2858 [label="Perché preoccuparsi di come potresti apparire agli altri sul campo di battaglia? Di certo non per far sì che gli altri possano identificare il tuo cadavere. Non c'è modo di confonderti. No, perché se devi essere un assassino, mio caro Usurpatore, scommetto che vuoi farlo con stile.",shape=box,color=blue];
		2858 -> 2866;
	2859 [label="No.",shape=box,color=red];
		2859 -> 2846;
	2860 [label="Va bene. Sì. Perché?",shape=box,color=red];
		2860 -> 2845;
	2861 [label="Sì, lo so! Lo so. Non farò nessuna di queste cose, intendiamoci. Né darò fuoco a tutto questo intorno a me, cosa che non vedo l'ora di fare.",shape=box,color=blue];
		2861 -> 2867;
	2862 [label="No! No, non lo è! E non è normale che io sbavi all'idea di radere al suolo tutto quello che mi sta intorno!",shape=box,color=blue];
		2862 -> 2867;
	2865 [label="Tutte queste linee sono tracciate arbitrariamente. E prima lo capiremo tutti, prima potremo concordare su quali battaglie siano importanti da combattere e quali no.",shape=box,color=blue];
		2865 -> 2870;
	2863 [label="Molto bene, seguiamo questo ragionamento fino in fondo. Uccidere con sufficiente pratica lo rende onorevole? Quindi, stai dicendo, se sono come i Dax e mi limito a mascherare il mio omicidio con grande sfarzo e solennità, questo lo rende Arte?",shape=box,color=blue];
		2863 -> 2868;
	2864 [label="Molto bene.",shape=box,color=blue];
		2864 -> 2869;
	2866 [label="E cos'è questo, se non il godimento dell'azione, mi chiedo?",shape=box,color=blue];
		2866 -> 2871;
	2867 [label="Uriel dev'essere il colpevole. Ammetto di aver avuto in passato inclinazioni verso pensieri distruttivi e sanguinari, ma non erano poi così catastrofici.",shape=box,color=blue];
		2867 -> 2872;
	2870 [label="Decidere se un omicidio è stato commesso in modo onorevole è come cercare di decidere cosa sia peggio, morire bruciato o annegato. Entrambi sono modi miserabili di morire.",shape=box,color=blue];
		2870 -> 2874;
	2868 [label="Ora stiamo seguendo la linea del rituale e della religione.",shape=box,color=blue];
		2868 -> 2873;
	2869 [label="Chat ends.",color=orange];
	2871 [label="Non fraintendermi! Non ti sto giudicando. Stai traendo il meglio dalla tua situazione! La morte ti ha reso il suo compagno di danza in questa grande farsa della vita, e tu non puoi fare altro che rispondere alla sua chiamata.",shape=box,color=blue];
		2871 -> 2875;
	2872 [label="E certamento non così... apocalittici.",shape=box,color=blue];
		2872 -> 2876;
	2874 [label="E tutte le strade portano alla tomba, quindi che senso ha cercare il pelo nell'uovo? Abbiamo problemi ben più importanti da risolvere.",shape=box,color=blue];
		2874 -> 2878;
	2873 [label="Almeno c'è onestà nella semplice e facile morte per un'accoltellata nella schiena. Non c'è nulla di pio in questo. Niente di ostentato o eccessivo. È fatta.",shape=box,color=blue];
		2873 -> 2877;
	2875 [label="Avresti deposto le armi? Mi chiedo, quanti altri sarebbero morti accanto a te? No, perché non provare un po' di orgoglio per il tuo lavoro? Un po' di piacere per l'arte di tutto ciò? Ti chiedo, qual è l'alternativa? Follia? Oblio?",shape=box,color=blue];
		2875 -> 2879;
	2876 [label="Chat ends.",color=orange];
	2878 [label="Chat ends.",color=orange];
	2877 [label="Non c'è arte in questo?",shape=box,color=blue];
		2877 -> 2880;
	2879 [label="Ne ho visti troppi scegliere quella strada e trovarsi davanti a un cappio. No. Lo dico, fai ciò che vuoi, Usurpatore. Perché la vita ha certamente fatto ciò che ha voluto per te.",shape=box,color=blue];
		2879 -> 2881;
	2880 [label="Chat ends.",color=orange];
	2881 [label="Chat ends.",color=orange];
}