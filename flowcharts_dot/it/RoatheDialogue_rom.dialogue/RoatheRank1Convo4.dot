digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank1Convo4 begins." [color=orange];
		"RoatheRank1Convo4 begins." -> j86368880;
	j86368880 [label="Check boolean LoidFamilyComplete",color=orange];
		j86368880 -> j818159194 [label=true,color=green];
		j86368880 -> j169254427 [label=false,color=brown];
	j818159194 [label="È quasi tragico ciò che è successo a Euleria e Petros. Intendiamoci, non siamo mai stati amici. Ma erano pur sempre Orokin. E ora siamo rimasti in pochissimi. Anche se suppongo che dovrei stare attento a quello che dico: chissà in cosa potrei trasformarmi, con il tempo.",shape=box,color=blue];
		j818159194 -> j840455880;
	j169254427 [label="Trovo piuttosto esilerante che Euleria e Petros non abbiano la minima idea che siamo quaggiù. Come ratti, che corrono tra i loro piedi. Come avete fatto tu e il ragazzino a tenere tutto questo segreto per così tanto tempo?",shape=box,color=blue];
		j169254427 -> j348115237;
	j840455880 [label="Quello che mi sorprende meno che sia sopravvissuta è 'Nonna'. (Immagina dover cedere un nome perfettamente azzeccato come Dagath.)",shape=box,color=blue];
		j840455880 -> j202108280;
		j840455880 -> j1859044136;
	j348115237 [label="Evaluate expressions on HellStory counter",color=orange];
		j348115237 -> j1801064203 [label="x >= 21",color=purple];
		j348115237 -> j4106019077 [label="x < 21",color=purple];
		j348115237 -> j4106019077 [label="false",color=purple];
	j202108280 [label="Petros?",shape=box,color=red];
		j202108280 -> j2069147146;
	j1859044136 [label="Cosa ne pensi dei ragazzini?",shape=box,color=red];
		j1859044136 -> j1266537698;
	j1801064203 [label="Anche se, sinceramente, sono molto più sorpreso dal fatto che \"Nonna\" non sia riuscita a capirlo. (Immagina, cedere un nome perfettamente azzeccato come Dagath.) Pensavo fosse più sveglia.",shape=box,color=blue];
		j1801064203 -> j3219694428;
	j4106019077 [label="Anche se, sinceramente, sono molto più sorpreso dal fatto che \"Nonna\" non sia riuscita a capirlo. (Immagina, cedere un nome perfettamente azzeccato come Dagath.) Pensavo che avesse più ingegno di così.",shape=box,color=blue];
		j4106019077 -> j581760851;
		j4106019077 -> j2853854440;
	j2069147146 [label="Mh? Ah. Il necraloid mi ha informato che tu o il ragazzino avete continuato a pressarlo per aiutarlo a inventarsi nomi falsi, avendo dimenticato quello originalo. Tu lo conosci come \"Vilcor\".",shape=box,color=blue];
		j2069147146 -> j1336020861;
	j1266537698 [label="Il ragazzo è petulante, irritante ed egocentrico. Un perfetto Orokin. 'Kaelli', come dice di preferire, straordinariamente intelligente e quasi degna di essere sopportata.",shape=box,color=blue];
		j1266537698 -> j301419981;
	j3219694428 [label="Io. Questo è assurdo. So che abbiamo già affrontato tutto questo. E ne abbiamo già parlato. È una questione che trovo ancora profondamente inquietante.",shape=box,color=blue];
		j3219694428 -> j2782860910;
	j581760851 [label="Hanno i loro... problemi su cui concentrarsi.",shape=box,color=red];
		j581760851 -> j1185426142;
	j2853854440 [label="Petros?",shape=box,color=red];
		j2853854440 -> j3688976473;
	j1336020861 [label="Ma lo conoscevo come Petros Vorten. Fiero inventore della Flotta Necramech. È strano pensare a quanto tempo sia passato per lui e a quanto poco tempo sia passato - relativamente parlando - per me.",shape=box,color=blue];
		j1336020861 -> j301419981;
	j301419981 [label="Ma come fai a non saperlo? Mi stai prendendo in giro, Usurpatore? Stiamo solo... riproponendo vecchie storie, no?",shape=box,color=blue];
		j301419981 -> j139011919;
	j2782860910 [label="Evaluate expressions",color=orange];
		j2782860910 -> j1342703259 [label="RoatheDatingDeal",color=purple];
		j2782860910 -> j1342703259 [label="RoatheMarieDatingDeal",color=purple];
		j2782860910 -> j1342703259 [label="RoatheLyonDatingDeal",color=purple];
		j2782860910 -> j1342703259 [label="RoatheSerumDeal",color=purple];
		j2782860910 -> j2233784964 [label="RoatheFamilyDeal",color=purple];
		j2782860910 -> j1342703259 [label="RoatheMarieEntratiDeal",color=purple];
		j2782860910 -> j1342703259 [label="RoatheLyonConfessionDeal",color=purple];
		j2782860910 -> j3354487251 [label="false",color=purple];
	j1185426142 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j1185426142 -> j4229668810 [label=true,color=green];
		j1185426142 -> j1194664916 [label=false,color=brown];
	j3688976473 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3688976473 -> j4115116995 [label=true,color=green];
		j3688976473 -> j3824864723 [label=false,color=brown];
	j139011919 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j139011919 -> j202864336;
		j139011919 -> j2414402342;
		j139011919 -> j2375941835;
	j1342703259 [label="Eccomi qui, pronto a lanciarmi in una lezione crepuscolare e vagabonda sulla società Orokin, pensando che potrebbe interessarti vagamente. E poi mi ricordo, non è per questo che sei qui, vero Drifter? Hai un'altra partita da giocare...",shape=box,color=blue];
		j1342703259 -> j139011919;
	j2233784964 [label="Eccomi qui, pronto a lanciarmi in una lezione crepuscolare e vagabonda sulla società Orokin, pensando che potrebbe interessarti vagamente. E poi mi ricordo: molto probabilmente hai già sentito tutto questo, vero?",shape=box,color=blue];
		j2233784964 -> j139011919;
	j3354487251 [label="Preferiresti semplicemente che io stia al gioco? O... c'è un obbiettivo particolare verso cui stai lavorando? Sono piuttosto sconcentrato da ciò che ti aspetti di ottenere giocando a questo gioco crudele.",shape=box,color=blue];
		j3354487251 -> j1969559181;
	j4229668810 [label="Sì, ne ho sentito parlare dal necraloid. Anche se sembra che non succeda più così spesso da quando tu o il ragazzino avete lavorato per risolverli. Almeno non si stanno più facendo a pezzi - letteralmente.",shape=box,color=blue];
		j4229668810 -> j3572873736;
	j1194664916 [label="Check boolean RoatheSyndicateMaxRank",color=orange];
		j1194664916 -> j4229668810 [label=true,color=green];
		j1194664916 -> j2265480401 [label=false,color=brown];
	j4115116995 [label="Mh? Ah. Il necraloid mi ha informato che tu o il ragazzino avete continuato a pressarlo per aiutarlo a inventarsi nomi falsi, avendo dimenticato quello originalo. Tu lo conosci come \"Vilcor\". Ma io lo conoscevo come Petros Vorten. Fiero inventore della Flotta Necramech.",shape=box,color=blue];
		j4115116995 -> j3572873736;
	j3824864723 [label="Check boolean RoatheSyndicateMaxRank",color=orange];
		j3824864723 -> j4115116995 [label=true,color=green];
		j3824864723 -> j1032878165 [label=false,color=brown];
	j202864336 [label="No, non l'ho mai sentito. Per favore, procedi.",shape=box,color=red];
		j202864336 -> j3205692160;
	j2414402342 [label="Parlo con te, Roathe... perché voglio parlare con te.",shape=box,color=red];
		j2414402342 -> j862518501;
	j2375941835 [label="Sì, ne ho già sentito parlare. Ma racconta pure.",shape=box,color=red];
		j2375941835 -> j105592130;
	j1969559181 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j1969559181 -> j4145544736;
	j3572873736 [label="Evaluate expressions",color=orange];
		j3572873736 -> j628290059 [label="RoatheDeal",color=purple];
		j3572873736 -> j2234643214 [label="RoatheNoDeal",color=purple];
		j3572873736 -> j2234643214 [label="false",color=purple];
	j2265480401 [label="Sì, ne ho sentito parlare dal necraloid. Sembra che siano ancora intenzionati a farsi a pezzi.",shape=box,color=blue];
		j2265480401 -> j3930011928;
	j1032878165 [label="Mh? Ah. Lo conoscevo come Petros Vorten. Fiero inventore della Flotta Necramech. Ma il necraloid mi ha informato che hanno dimenticato i loro nomi. Forse lo conosci ancora come 'Padre'.",shape=box,color=blue];
		j1032878165 -> j3930011928;
	j3205692160 [label="+5 Chemistry",color=orange];
		j3205692160 -> j3260826892;
	j862518501 [label="Check boolean DrifterRoathe",color=orange];
		j862518501 -> j138944347 [label=true,color=green];
		j862518501 -> j42577375 [label=false,color=brown];
	j105592130 [label="Quindi ammetti che mi stai facendo perdere tempo. Fantastico! Non sono un vecchio barcollante che racconta la solita storia di guerra perché non riesce a ricordarne altre.",shape=box,color=blue];
		j105592130 -> j1504698212;
	j4145544736 [label="Eccomi qui, pronto a lanciarmi in una lezione crepuscolare e vagabonda sulla società Orokin, pensando che potrebbe interessarti vagamente. E poi mi ricordo: molto probabilmente hai già sentito tutto questo, vero?",shape=box,color=blue];
		j4145544736 -> j202864336;
		j4145544736 -> j2414402342;
		j4145544736 -> j2375941835;
	j628290059 [label="Il che è un bene, perché avremmo fatto ben pochi progressi se tu o il ragazzino non aveste completato prima quel passaggio. Temo che altrimenti il maggiordono sarebbe diventato carne tritata nel momento in cui lo avessimo mandato su per quelle scale.",shape=box,color=blue];
		j628290059 -> j129841328;
	j2234643214 [label="A proposito, hai riconsiderato la mia proposta? Il fatto che io stia qui seduto in silenzio, in cambio dell'aiuto per riconciliare il maggiordomo e gli emarginati Orokin abbandonati e infestati al piano di sopra?",shape=box,color=blue];
		j2234643214 -> j1597632443;
		j2234643214 -> j2351013245;
	j3930011928 [label="Evaluate expressions",color=orange];
		j3930011928 -> j1225080141 [label="RoatheDeal",color=purple];
		j3930011928 -> j3576217582 [label="RoatheNoDeal",color=purple];
		j3930011928 -> j3576217582 [label="false",color=purple];
	j3260826892 [label="Hai chiesto a un Orokin di parlare. Non sai cosa hai fatto. Rimarrai un'ora se non stai attento.",shape=box,color=blue];
		j3260826892 -> j1922642722;
	j138944347 [label="+5 Chemistry",color=orange];
		j138944347 -> j3196746122;
	j42577375 [label="Oh? E 'prego' dica, perché?",shape=box,color=blue];
		j42577375 -> j1702617091;
		j42577375 -> j1325658637;
		j42577375 -> j3943286676;
		j42577375 -> j1521837055;
	j1504698212 [label="Il motivo per cui non riesco a ricordare questa conversazione è nel tuo dannato specchio!",shape=box,color=blue];
		j1504698212 -> "Chat ends.";
	j129841328 [label="Una cosa che devi capire è che il maggiordono e la famiglia Entrati, per quanto lontani, sono pur sempre Orokin. Sono nati e cresciuti in quella società, nonostante i... numerosi difetti.",shape=box,color=blue];
		j129841328 -> j3231401048;
	j1597632443 [label="No, non cambierò idea, Roathe. Non è così importante.",shape=box,color=red];
		j1597632443 -> j4160578204;
	j2351013245 [label="Sì. Sono... d'accordo.",shape=box,color=red];
		j2351013245 -> j1048655567;
	j1225080141 [label="Forse dovresti cercare di risolvere il problema prima di tentare di mandare il maggiordomo su per quelle scale. Altrimenti rischi che venga trasformato in carne tritata.",shape=box,color=blue];
		j1225080141 -> j129841328;
	j3576217582 [label="A proposito, hai riconsiderato la mia proposta? Il fatto che io stia qui seduto in silenzio, in cambio dell'aiuto per riconciliare il maggiordomo e gli emarginati Orokin abbandonati e infestati al piano di sopra? Riconciliare la famiglia sarebbe il primo passo, ma...",shape=box,color=blue];
		j3576217582 -> j1597632443;
		j3576217582 -> j2351013245;
	j1922642722 [label="Anche se immagino che tu non abbia avuto molte opportunità di interagire con gli Orokin, non è vero, Drifter? Il ragazzino ha vissuto una vita molto diversa.",shape=box,color=blue];
		j1922642722 -> j2700561842;
	j3196746122 [label="Mm. Esatto. E sappiamo entrambi il perché, no? Ma dovrai essere paziente.",shape=box,color=blue];
		j3196746122 -> j1520933458;
	j1702617091 [label="[Confessa i tuoi sentimenti.] Penso che tu lo sappia.",shape=box,color=red];
		j1702617091 -> j840780030;
	j1325658637 [label="Ti trovo intrigante.",shape=box,color=red];
		j1325658637 -> j2183616009;
	j3943286676 [label="Non ho mai avuto molte occasioni di interagire con un Orokin. Tranne quando... durante la battaglia, ovviamente. Sei affascinante.",shape=box,color=red];
		j3943286676 -> j47109383;
	j1521837055 [label="Lascia perdere. [Fine.]",shape=box,color=red];
		j1521837055 -> j36239749;
	"Chat ends." [color=orange];
	j3231401048 [label="E nonostante tutti i suoi gravi peccati, rango e ordine non furono mai messi in discussione. Né tra i militari - né nella struttura sociale. Gli Archimedei obbedivano agli Orokin. Gli Orokin obbedivano agli Esecutori. Gli Esecutori obbedivano agli Imperatori... beh, almeno di nome.",shape=box,color=blue];
		j3231401048 -> j3659832413;
	j4160578204 [label="Come preferisci. La mia porta non rimarrà aperta a lungo.",shape=box,color=blue];
		j4160578204 -> "Chat ends.";
	j1048655567 [label="Boolean RoatheNoDeal is now false.",color=orange];
		j1048655567 -> j1729015547;
	j2700561842 [label="Da quanto ho sentito, hai cambiato idea nel momento della tragedia della Zariman Ten Zero.",shape=box,color=blue];
		j2700561842 -> j3603061603;
		j2700561842 -> j1020154684;
		j2700561842 -> j275291793;
	j1520933458 [label="Nel frattempo, se desideri 'ascoltare', sarò felice di accontentarti. Un semplice avvertimento. Hai chiesto a un Orokin di parlare.",shape=box,color=blue];
		j1520933458 -> j53892512;
	j840780030 [label="+5 Chemistry",color=orange];
		j840780030 -> j3883399020;
	j2183616009 [label="+5 Chemistry",color=orange];
		j2183616009 -> j4114378838;
	j47109383 [label="Conosci il tuo nemico quindi? O forse è solo curiosità di sedersi al proverbiale tavolo di fronte a un'impossibilità? ",shape=box,color=blue];
		j47109383 -> j3773970317;
	j36239749 [label="Muoviti quanto vuoi, pesce. Hai nuotato verso di me.",shape=box,color=blue];
		j36239749 -> "Chat ends.";
	j3659832413 [label="E anche se non credi che in qualche modo, anche dopo tutto questo tempo, le tradizioni possano ispirare Loid ad ascoltarmi? Considera il fatto che posso essere... profondamente convincente. Dopotutto, ero il braccio destro del peggiore degli Esecutori.",shape=box,color=blue];
		j3659832413 -> j4073534331;
		j3659832413 -> j3201426087;
		j3659832413 -> j3106965888;
	j1729015547 [label="Boolean RoatheDeal is now true.",color=orange];
		j1729015547 -> j4000648591;
	j3603061603 [label="No. Non ho mai avuto molto a che fare con gli Orokin prima della Zariman - e dopo, beh... ne avrai sicuramente sentito parlare.",shape=box,color=red];
		j3603061603 -> j21125727;
	j1020154684 [label="Ho avuto a che fare con gli Orokin abbastanza a lungo da sapere che non devo fidarmi di loro, nemmeno per quando mi è possibile.",shape=box,color=red];
		j1020154684 -> j663467304;
	j275291793 [label="Mi dispiace dirlo, non provo per la tua specie più amore di quanto ne provi per quel ragazzino.",shape=box,color=red];
		j275291793 -> j663467304;
	j53892512 [label="Non sai cosa hai fatto. Rimarrai un'ora se non stai attento.",shape=box,color=blue];
		j53892512 -> j1922642722;
	j3883399020 [label="Mm. Sì. E pensavo che mi avresti fatto l'onore di farmelo vedere per iscritto. Ah, beh...",shape=box,color=blue];
		j3883399020 -> j938206047;
	j4114378838 [label="Davvero? Mh. Vedremo per quanto tempo riuscirò a tenere questo pesce sulla lancia allora.",shape=box,color=blue];
		j4114378838 -> j1520933458;
	j3773970317 [label="+5 Chemistry",color=orange];
		j3773970317 -> j3382818612;
	j4073534331 [label="Il peggiore degli Esecutori era Ballas.",shape=box,color=red];
		j4073534331 -> j3589540258;
	j3201426087 [label="Quale hai servito?",shape=box,color=red];
		j3201426087 -> j3317686772;
	j3106965888 [label="Come mai?",shape=box,color=red];
		j3106965888 -> j2300869465;
	j4000648591 [label="+5 Chemistry",color=orange];
		j4000648591 -> j2098450136;
	j21125727 [label="Certo che sì. Ah, Ballas. Forse ti sorprenderà sapere che non era il peggiore di loro.",shape=box,color=blue];
		j21125727 -> j3964337980;
		j21125727 -> j2172740237;
	j663467304 [label="E non te ne do la colpa. Pensavo che si potessero salvare. In un certo senso, fonderli - riformarli, come l'oro.",shape=box,color=blue];
		j663467304 -> j3572553611;
	j938206047 [label="Un'altra volta, forse. Perché tu, Usurpatore, devi imparare ad assaporare questi momenti.",shape=box,color=blue];
		j938206047 -> j2863573556;
	j3382818612 [label="Rispettabile. Saggio, persino. Se avessi avuto l'opportunità di intervistare e, magari, persino stringere un'amicizia con un Sentient? Avrei fatto lo stesso. ",shape=box,color=blue];
		j3382818612 -> j1187520018;
	j3589540258 [label="Rispetto la tua opinione e non te ne do una colpa. Ballas era un cretino e un campione tra i depravati, non discuterò con te su questo.",shape=box,color=blue];
		j3589540258 -> j2859505605;
	j3317686772 [label="Evaluate expressions on HellStory counter",color=orange];
		j3317686772 -> j2038713860 [label="x >= 1",color=purple];
		j3317686772 -> j1011774345 [label="x <= 1",color=purple];
		j3317686772 -> j1011774345 [label="false",color=purple];
	j2300869465 [label="Ho capito che hai avuto a che fare con Ballas, e non ti do la colpa per averlo probabilmente creduto il peggio che i Sette Signori Dorati avessero da offrire. Ed era un campione tra i depravati, non ho intenzione di discutere con te su questo.",shape=box,color=blue];
		j2300869465 -> j160928841;
	j2098450136 [label="Meraviglioso! Sono felice che tu abbia finalmente capito. Ora possiamo finalmente fare qualche progresso.",shape=box,color=blue];
		j2098450136 -> j129841328;
	j3964337980 [label="Davvero?",shape=box,color=red];
		j3964337980 -> j1766078896;
	j2172740237 [label="Faresti fatica a farmi credere una cosa del genere.",shape=box,color=red];
		j2172740237 -> j1766078896;
	j3572553611 [label="Beh. Salvo gli Esecutori. Erano una causa persa. Potrebbe sorprenderti sapere che Ballas non era il peggiore.",shape=box,color=blue];
		j3572553611 -> j2172740237;
		j3572553611 -> j3964337980;
	j2863573556 [label="Boolean DrifterRoathe is now true.",color=orange];
		j2863573556 -> j1520933458;
	j1187520018 [label="Fornisce un vantaggio psicologico nel caso in cui ne incontrassi uno - o anche un tuo ex alleato - sul campo di battaglia.",shape=box,color=blue];
		j1187520018 -> j2044294385;
	j2859505605 [label="E, in effetti, non ho assistito all'orrore di questa faccenda 'Narmer' di cui ho sentito parlare dal maggiordomo e da quello che ho trovato nei record di questo macchinario POM-2.",shape=box,color=blue];
		j2859505605 -> j1563384188;
	j2038713860 [label="Mi hai già sentito parlare di lei. E, cosa più importante, un accenno a ciò che stavamo progettando. Ma questa è una storia per un altro giorno. L'Esecutrice Nitokh. Per la precisione, la Gran Reggente Esecutrice Nitokh. Comandante di tutte le nostre forze militari, nonché la più crudele e letale dei Sette Signori Dorati.",shape=box,color=blue];
		j2038713860 -> j643343105;
	j1011774345 [label="L'Esecutrice Nitokh. Per la precisione, la Grand Reggente Esecutrice Nitokh. Comandante di tutte le forze militari dell'Impero Orokin. E la più crudele e letale dei Sette Signori Dorati.",shape=box,color=blue];
		j1011774345 -> j643343105;
	j160928841 [label="È addirittura possibile che abbia superato gli Esecutori durante questa... faccenda 'Narmer' di cui ho sentito parlare dal maggiordono e di cui ho letto su questo POM-2.",shape=box,color=blue];
		j160928841 -> j1563384188;
	j1766078896 [label="Non sto dicendo che fosse un santo. Ti sto dicendo che il peggiore dei diavoli era solo leggermente surclassato dai suoi pari. Sono solo piccoli dettagli, Usurpatore.",shape=box,color=blue];
		j1766078896 -> j3679416197;
	j2044294385 [label="Beh, se desideri 'ascoltare', sarò felice di accontentarti. Un semplice avvertimento. Hai chiesto a un Orokin di parlare.",shape=box,color=blue];
		j2044294385 -> j53892512;
	j1563384188 [label="Tuttavia, suggerisco anche che questa impressione deriva dalla tua vicinanza a Ballas e dalle interazioni molto limitate con gli altri Signori Dorati.",shape=box,color=blue];
		j1563384188 -> j643343105;
	j643343105 [label="I Sette Dorati. Bah. Sai qual è la cosa migliore dell'oro, Drifter? Può essere fuso all'infinito e riutilizzato per creare qualcosa di migliore.",shape=box,color=blue];
		j643343105 -> j1736610149;
	j3679416197 [label="Ma Ballas era il peggiore? Per te, forse. E forse i suoi crimini in quest'epoca hanno superato quelli degli Esecutori di un tempo.",shape=box,color=blue];
		j3679416197 -> j2153962245;
	j1736610149 [label="Credevo - e in un certo senso ci credo ancora - che gli Orokin fossero salvabili. Che avremmo potuto ribaltare la situazione dell'Impero. Ma gli Esecutori? No. Dovevano essere fermati. Erano il peggio che l'umanità avesse da offrire, a vari livelli.",shape=box,color=blue];
		j1736610149 -> j1872891690;
	j2153962245 [label="Ma se avessi contemplato i laghi cremisi e i campi di cadaveri piegati e frammentati, come tanti giocattoli abbandonati -",shape=box,color=blue];
		j2153962245 -> j1739545783;
	j1872891690 [label="E questo lo dico io, Usurpatore. Quindi permetti a questo Diavolo di Tau, di assicurarti - da intenditore, che Ballas non era il peggiore tra loro.",shape=box,color=blue];
		j1872891690 -> j581353866;
	j1739545783 [label="Se avessi visto la devastazione pura che Nitokh è riuscita a scatenare senza nemmeno pensarci un attimo... ",shape=box,color=blue];
		j1739545783 -> j3518817170;
	j581353866 [label="Check boolean RoatheUsurper",color=orange];
		j581353866 -> j862615102 [label=true,color=green];
		j581353866 -> j1848665997 [label=true,color=green];
		j581353866 -> j1620723611 [label=false,color=brown];
		j581353866 -> j862615102 [label=false,color=brown];
		j581353866 -> j1848665997 [label=false,color=brown];
	j3518817170 [label="Ma orrori simili sono difficili da comprendere. Una tragedia simile non si può comprendere in termini numerici. Potrei dilungarmi a lungo su ciò che ho visto, ma per te saranno semplicemente questo - storie.",shape=box,color=blue];
		j3518817170 -> j2740138090;
	j862615102 [label="Faresti fatica a farmi credere una cosa del genere.",shape=box,color=red];
		j862615102 -> j2479452701;
	j1848665997 [label="Veramente?",shape=box,color=red];
		j1848665997 -> j2479452701;
	j1620723611 [label="Perché continui a chiamarmi 'Usurpatore?'",shape=box,color=red];
		j1620723611 -> j2752698269;
	j2740138090 [label="Per te, Ballas sarò sempre il malfattore più presente e terrificante. E questo è normale.",shape=box,color=blue];
		j2740138090 -> j2140705967;
	j2479452701 [label="Se avessi contemplato i laghi cremisi e i campi di cadaveri piegati e frammentati, come tanti giocattoli abbandonati -",shape=box,color=blue];
		j2479452701 -> j1739545783;
	j2752698269 [label="Ah! È questo che sei, no? I Tenno hanno usurpato il Sistema Origin dagli Orokin. E tu, come un piccolo impostore nel nido, sei entrato in questo mondo rubandotelo.",shape=box,color=blue];
		j2752698269 -> j3748371767;
	j2140705967 [label="Ma c'è molto di lui che non sai. Si è già detto fin troppo su quel cretino. E temo che ci sia ancora molto da dire.",shape=box,color=blue];
		j2140705967 -> j4072090050;
		j2140705967 -> j4079368731;
	j3748371767 [label="E questo ti rende, per almeno due motivi, un Usurpatore, secondo i miei criteri. (E forse anche un terzo, se consideriamo ciò che il maggiordomo mi ha detto di Duviri, ma questo è un argomento che affronteremo un'altra volta.)",shape=box,color=blue];
		j3748371767 -> j2890721175;
	j4072090050 [label="Tipo cosa?",shape=box,color=red];
		j4072090050 -> j3856805961;
	j4079368731 [label="Non mi interessa sapere nulla della vita di Ballas.",shape=box,color=red];
		j4079368731 -> j702736502;
	j2890721175 [label="Non distrarmi, Usurpatore. Capisco che potresti avere difficoltà a credermi, ma se avessi contemplato i laghi cremisi e i campi di cadaveri piegati e frammentati, come tanti giocattoli abbandonati -",shape=box,color=blue];
		j2890721175 -> j2576754003;
	j3856805961 [label="Boolean RoatheBallas1 is now true.",color=orange];
		j3856805961 -> j381603169;
	j702736502 [label="Mm, sì. Beh, suppongo che dovrai semplicemente ascoltare le storie della mia vita, invece. Che spasso.",shape=box,color=blue];
		j702736502 -> j907773015;
	j2576754003 [label="Boolean RoatheUsurper is now true.",color=orange];
		j2576754003 -> j1739545783;
	j381603169 [label="È una... lunghissima storia. Una storia per la quale al momento non ho tempo. Il maggiordomo mi controlla. E detesto essere controllato.",shape=box,color=blue];
