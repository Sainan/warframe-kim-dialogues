	"Chat ends." [color=orange];
	j3952550716 [label="MV: SOTTOMISSIONE",shape=box,color=blue];
		j3952550716 -> j2736939650;
	j2736939650 [label="Trascrizione: Ho capito fin dall'inizio - sia sul campo di battaglia che nella camera da letto, la via per la vittoria attraverso l'apparente sottomissione.",shape=box,color=blue];
		j2736939650 -> j112414958;
	j112414958 [label="Dove il nemico ti trova cedevole, lì puoi essere certo che spingerà; e quindi puoi facilmente farlo inciampare.",shape=box,color=blue];
		j112414958 -> j3598374845;
	j3598374845 [label="\"Lacchè\", mi chiamavano. \"Cagnolino da compagnia\". Nitokh credeva di avere il controllo. Con quanta delicatezza la guidavo. ",shape=box,color=blue];
		j3598374845 -> j134026935;
	j134026935 [label="Roathe, il sanguinario. Roathe, l'orco ingrassato sui corpi dei suoi uomini. Sacrificatore di vite.",shape=box,color=blue];
		j134026935 -> j1854013999;
	j1854013999 [label="Come se combattessi solo per il gusto di combattere! No. L'Impero Orokin deve finire.",shape=box,color=blue];
		j1854013999 -> j209767201;
	j209767201 [label="Perché ciò accada, la guerra deve continuare. Solo una sconfitta, assoluta e irrevocabile, avrebbe rovesciato quei sette gargoyle dorati.",shape=box,color=blue];
		j209767201 -> j3736392204;
	j3736392204 [label="Nemmeno Nitokh conosceva il mio vero cuore. Pensava che aspirassi a governare al suo fianco.",shape=box,color=blue];
		j3736392204 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}