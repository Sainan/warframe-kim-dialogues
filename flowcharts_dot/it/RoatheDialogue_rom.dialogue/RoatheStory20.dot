	"Chat ends." [color=orange];
	j4027077992 [label="MV: SOTTOMISSIONE",shape=box,color=blue];
		j4027077992 -> j4206384775;
	j4206384775 [label="Trascrizione: Ho capito fin dall'inizio - sia sul campo di battaglia che nella camera da letto, la via per la vittoria attraverso l'apparente sottomissione.",shape=box,color=blue];
		j4206384775 -> j2200799416;
	j2200799416 [label="Dove il nemico ti trova cedevole, lì puoi essere certo che spingerà; e quindi puoi facilmente farlo inciampare.",shape=box,color=blue];
		j2200799416 -> j4153475204;
	j4153475204 [label="\"Lacchè\", mi chiamavano. \"Cagnolino da compagnia\". Nitokh credeva di avere il controllo. Con quanta delicatezza la guidavo. ",shape=box,color=blue];
		j4153475204 -> j843276682;
	j843276682 [label="Roathe, il sanguinario. Roathe, l'orco ingrassato sui corpi dei suoi uomini. Sacrificatore di vite.",shape=box,color=blue];
		j843276682 -> j3549548613;
	j3549548613 [label="Come se combattessi solo per il gusto di combattere! No. L'Impero Orokin deve finire.",shape=box,color=blue];
		j3549548613 -> j1916142237;
	j1916142237 [label="Perché ciò accada, la guerra deve continuare. Solo una sconfitta, assoluta e irrevocabile, avrebbe rovesciato quei sette gargoyle dorati.",shape=box,color=blue];
		j1916142237 -> j4149805247;
	j4149805247 [label="Nemmeno Nitokh conosceva il mio vero cuore. Pensava che aspirassi a governare al suo fianco",shape=box,color=blue];
		j4149805247 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}