	2312 [label="MV: SOTTOMISSIONE",shape=box,color=blue];
		2312 -> 2311;
	2315 [label="Chat ends.",color=orange];
	2311 [label="Trascrizione: Ho capito fin dall'inizio - sia sul campo di battaglia che nella camera da letto, la via per la vittoria attraverso l'apparente sottomissione.",shape=box,color=blue];
		2311 -> 5722;
	5722 [label="Dove il nemico ti trova cedevole, lì puoi essere certo che spingerà; e quindi puoi facilmente farlo inciampare.",shape=box,color=blue];
		5722 -> 5723;
	5723 [label="\"Lacchè\", mi chiamavano. \"Cagnolino da compagnia\". Nitokh credeva di avere il controllo. Con quanta delicatezza la guidavo. ",shape=box,color=blue];
		5723 -> 2310;
	2310 [label="Roathe, il sanguinario. Roathe, l'orco ingrassato sui corpi dei suoi uomini. Sacrificatore di vite.",shape=box,color=blue];
		2310 -> 2314;
	2314 [label="Come se combattessi solo per il gusto di combattere! No. L'Impero Orokin deve finire.",shape=box,color=blue];
		2314 -> 5724;
	5724 [label="Perché ciò accada, la guerra deve continuare. Solo una sconfitta, assoluta e irrevocabile, avrebbe rovesciato quei sette gargoyle dorati.",shape=box,color=blue];
		5724 -> 2316;
	2316 [label="Nemmeno Nitokh conosceva il mio vero cuore. Pensava che aspirassi a governare al suo fianco",shape=box,color=blue];
		2316 -> 2309;
	2309 [label="Add 1 to HellStory",color=orange];
		2309 -> 2347;
