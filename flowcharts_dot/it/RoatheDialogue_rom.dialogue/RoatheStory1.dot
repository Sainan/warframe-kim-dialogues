	j426001671 [label="MV: NITOKH",shape=box,color=blue];
		j426001671 -> j141411300;
	j141411300 [label="Trascrizione: La sua follia era seducente perché ovvia.",shape=box,color=blue];
		j141411300 -> j3642564948;
	j3642564948 [label="Con lei si sapeva sempre dove ci si trovava - proprio sull'orlo del grande abisso.",shape=box,color=blue];
		j3642564948 -> j1548118085;
	j1548118085 [label="\"Salta dentro\", mi dicevano i suoi occhi, scintillanti di gioia per un colossale scherzo cosmico.",shape=box,color=blue];
		j1548118085 -> j1974305775;
	j1974305775 [label="Attraverso alle sue visioni folli potevo sfuggire alla lunga, desolata stagnazione dell'esistenza degli Orokin.",shape=box,color=blue];
		j1974305775 -> j2003342207;
	j2003342207 [label="Tutti i nostri sensi erano stati saturati fino all'intorpidimento secoli prima. Eppure lei era ancora, a suo modo, fresca.",shape=box,color=blue];
		j2003342207 -> j3722466149;
	j3722466149 [label="Eterna. Illimitata nella sua fame. Una sera mi chiamò al suo bagno. Attraversai a grandi passi le pozze d'acqua profumata e sangue che si mescolavano e mi misi diligentemente sull'attenti.",shape=box,color=blue];
		j3722466149 -> j2215054010;
	j2215054010 [label="'Mi annoio, Roathe. Uccidiamo tutti gli altri Orokin e prendiamo il controllo.'",shape=box,color=blue];
		j2215054010 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}