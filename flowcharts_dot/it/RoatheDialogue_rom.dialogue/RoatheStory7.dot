	j3434578774 [label="MV: COMMISSIONE",shape=box,color=blue];
		j3434578774 -> j2632039302;
	j2632039302 [label="Trascrizione: Tra i Sette - così mi dissero - che ero considerato il giocattolo e il concubino di Nitokh.",shape=box,color=blue];
		j2632039302 -> j3069559135;
	j3069559135 [label="Nei primi giorni della guerra mi nominarono Vice Reggente Grand Carnus su sua provocazione, pensandolo uno scherzo.",shape=box,color=blue];
		j3069559135 -> j2556357560;
	j2556357560 [label="Quanto rapidamente le loro risate si trasformarono in applausi solenni quando riportai a casa la notizia di una vittoria dopo l'altra.",shape=box,color=blue];
		j2556357560 -> j1987758791;
	j1987758791 [label="Il sangue di uomini migliori mi imbrattava come fossero medaglie. In segreto accumulai armi per Nitokh.",shape=box,color=blue];
		j1987758791 -> j3445054636;
	j3445054636 [label="Fu facile. Ero una figura troppo gloriosa per essere sospettata.",shape=box,color=blue];
		j3445054636 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
