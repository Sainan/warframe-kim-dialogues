	j2204791689 [label="MV: COMMISSIONE",shape=box,color=blue];
		j2204791689 -> j130623681;
	j130623681 [label="Trascrizione: Tra i Sette - così mi dissero - che ero considerato il giocattolo e il concubino di Nitokh.",shape=box,color=blue];
		j130623681 -> j1517141566;
	j1517141566 [label="Nei primi giorni della guerra mi nominarono Vice Reggente Grand Carnus su sua provocazione, pensandolo uno scherzo.",shape=box,color=blue];
		j1517141566 -> j1338419474;
	j1338419474 [label="Quanto rapidamente le loro risate si trasformarono in applausi solenni quando riportai a casa la notizia di una vittoria dopo l'altra.",shape=box,color=blue];
		j1338419474 -> j142836717;
	j142836717 [label="Il sangue di uomini migliori mi imbrattava come fossero medaglie. In segreto accumulai armi per Nitokh.",shape=box,color=blue];
		j142836717 -> j1937029046;
	j1937029046 [label="Fu facile. Ero una figura troppo gloriosa per essere sospettata",shape=box,color=blue];
		j1937029046 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
