	2321 [label="Trascrizione: Codardo.",shape=box,color=blue];
		2321 -> 5725;
	5725 [label="È così che mi chiamavano, non è vero? Ho letto i libri i storia sparci per questa sala polverosa. È una bugia. Non conoscevano la verità. Che sono stato strappato via dal mio tempo prima di poter completare il mio lavoro.",shape=box,color=blue];
		5725 -> 5726;
	5726 [label="Codardo.",shape=box,color=blue];
		5726 -> 5727;
	5727 [label="Ora ricordo. Si avvicinò a me, nelle Sale Dorate. Aveva un volto che non conoscevo. Ma non è poi così insolito per la nostra specie. Conoscevo la sua voce. Conoscevo il modo in cui si muoveva.",shape=box,color=blue];
		5727 -> 5728;
	5728 [label="Codardo!",shape=box,color=blue];
		5728 -> 5729;
	5729 [label="Mi ha fatto una sola domanda. Credevo davvero che sarei stato perdonato per aver ridotto tutto in cenere?",shape=box,color=blue];
		5729 -> 5730;
	5730 [label="CODARDO!",shape=box,color=blue];
		5730 -> 2320;
	2320 [label="In quella mano pallida e tesa… una siringa. Scintillante di libertà… con un'altra possibilità… con un'altra vita.",shape=box,color=blue];
		2320 -> 2324;
	2324 [label="L'ho presa.",shape=box,color=blue];
		2324 -> 5735;
	5735 [label="CODARDO!",shape=box,color=blue];
