	j3026439718 [label="MV: OBLIVIO",shape=box,color=blue];
		j3026439718 -> j1106241760;
	j1106241760 [label="Trascrizione: Codardo.",shape=box,color=blue];
		j1106241760 -> j3895963853;
	j3895963853 [label="È così che mi chiamavano, non è vero? Ho letto i libri i storia sparci per questa sala polverosa. È una bugia. Non conoscevano la verità. Che sono stato strappato via dal mio tempo prima di poter completare il mio lavoro.",shape=box,color=blue];
		j3895963853 -> j1170696713;
	j1170696713 [label="Codardo.",shape=box,color=blue];
		j1170696713 -> j4114384845;
	j4114384845 [label="Ora ricordo. Si avvicinò a me, nelle Sale Dorate. Aveva un volto che non conoscevo. Ma non è poi così insolito per la nostra specie. Conoscevo la sua voce. Conoscevo il modo in cui si muoveva.",shape=box,color=blue];
		j4114384845 -> j997305685;
	j997305685 [label="Codardo!",shape=box,color=blue];
		j997305685 -> j2192344181;
	j2192344181 [label="Mi ha fatto una sola domanda. Credevo davvero che sarei stato perdonato per aver ridotto tutto in cenere?",shape=box,color=blue];
		j2192344181 -> j2513871540;
	j2513871540 [label="CODARDO!",shape=box,color=blue];
		j2513871540 -> j1578143186;
	j1578143186 [label="In quella mano pallida e tesa… una siringa. Scintillante di libertà… con un'altra possibilità… con un'altra vita.",shape=box,color=blue];
		j1578143186 -> j3799296757;
	j3799296757 [label="L'ho presa.",shape=box,color=blue];
		j3799296757 -> j2109759931;
	j2109759931 [label="CODARDO!",shape=box,color=blue];
		j2109759931 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
