	j3646279136 [label="Hai i mezzi. Hai la forza. Hai espresso a sufficienza il tuo disappunto per la situazione.",shape=box,color=red];
		j3646279136 -> j1966955686;
	j4065707431 [label="Semplicemente non capisco perché il \"Diavolo di Tau\" si accontenti di starsene seduto in una cripta a girarsi i pollici. Anche con il nostro accordo.",shape=box,color=red];
		j4065707431 -> j2206556128;
	j120002129 [label="Sei un Orokin. È chiaro che odi tutti quelli che ti circondano. Cosa ti ferma?",shape=box,color=red];
		j120002129 -> j705083856;
	j4050215751 [label="Semplicemente non capisco perché il \"Diavolo di Tau\" si accontenti di starsene seduto in una cripta a girarsi i pollici. Soprattutto perché non abbiamo alcun tipo di accordo.",shape=box,color=red];
		j4050215751 -> j3657429577;
	j1966955686 [label="+5 Chemistry",color=orange];
		j1966955686 -> j704024682;
	j2206556128 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2206556128 -> j790449534 [label=true,color=green];
		j2206556128 -> j1903618661 [label=false,color=brown];
	j705083856 [label="Scusami se mi prendo un momento per raccogliere i miei pensieri prima di iniziare questa conversazione da un luogo alimentato interamente da rabbia e risentimento.",shape=box,color=blue];
		j705083856 -> j3519272710;
	j3657429577 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3657429577 -> j790449534 [label=true,color=green];
		j3657429577 -> j1517325072 [label=false,color=brown];
	j704024682 [label="E sono contento che tu riconosca che ho la possibilità di trasformare questo posto in un mattatoio con estrema facilità.",shape=box,color=blue];
		j704024682 -> j3944311552;
	j790449534 [label="Perché resta ancora il mistero del perché mi sono fidato di te al punto di dirti così tanto, solo per poi vederti tradire quella fiducia, Usurpatore.",shape=box,color=blue];
		j790449534 -> j3418309337;
	j1903618661 [label="C'è ancora del lavoro da fare, Usurpatore. Non posso certo avere il tuo aiuto per recuperare tutti i miei ricordi se vado in giro a uccidere tutti quelli che ho intorno, vero?",shape=box,color=blue];
		j1903618661 -> j693427139;
	j3519272710 [label="Poiché mi sforzo molto di non dimostrare subito che il tuo punto è corretto.",shape=box,color=blue];
		j3519272710 -> j2130468502;
	j1517325072 [label="Forse spero che tu diventi più saggio e cambi idea. E le probabilità che ciò accada diminuiscono drasticamente se mi metto a massacrare tutti quelli che si trovano nelle vicinanze, non è vero?",shape=box,color=blue];
		j1517325072 -> j693427139;
	j3944311552 [label="Ma non servirebbe a nulla farlo, non è vero? Se c'è una sola cosa che si impara dalla guerra, è che l'omicidio, alla fine, serve a ben poco.",shape=box,color=blue];
		j3944311552 -> j343453923;
	j3418309337 [label="E le probabilità che ciò accada diminuiscono drasticamente se mi metto a massacrare tutti quelli che ho intorno, non è vero? Se c'è una sola cosa che si impara dalla guerra, è che l'omicidio alla fine serve a ben poco.",shape=box,color=blue];
		j3418309337 -> j2912669848;
	j693427139 [label="Oltretutto, non servirebbe a nulla farlo, non è vero? Se c'è una sola cosa che si impara dalla guerra, è che l'omicidio, alla fine, serve a ben poco.",shape=box,color=blue];
		j693427139 -> j2912669848;
	j2130468502 [label="Provo simpatia per il tuo odio verso gli Orokin. Credimi. La maggior parte degli Orokin disprezzava gli Orokin. Non ignoro i nostri crimini. Le trasgressioni che abbiamo commesso. ",shape=box,color=blue];
		j2130468502 -> j1190227909;
	j343453923 [label="Per quanto possa essere piacevole provare il desiderio di dedicarsi un po' a questo di tanto in tanto.",shape=box,color=blue];
		j343453923 -> j3738122114;
		j343453923 -> j293351604;
		j343453923 -> j3503079728;
	j2912669848 [label="Per quanto possa essere piacevole provare il desiderio di dedicarsi un po' a questo di tanto in tanto.",shape=box,color=blue];
		j2912669848 -> j3503079728;
		j2912669848 -> j293351604;
		j2912669848 -> j3738122114;
	j1190227909 [label="Il teatro Yuvan da solo sarebbe motivo sufficiente per radere al suolo la nostra società. Ma tu condanni un intero popolo - di cui sei stato il prodotto, potrei aggiungere, mio Usurpatore - con un colpo solo!",shape=box,color=blue];
		j1190227909 -> j2699743282;
	j3738122114 [label="Quindi l'unica ragione per cui hai lasciato vivere tutti è perché sarebbe stato inutile ucciderli?",shape=box,color=red];
		j3738122114 -> j2991488970;
	j293351604 [label="Non c'è nessun altro motivo per cui lasci vivere tutti?",shape=box,color=red];
		j293351604 -> j3806688490;
	j3503079728 [label="Anche Marie e Lyon?",shape=box,color=red];
		j3503079728 -> j1564852489;
	j2699743282 [label="Non sai nulla di tutte le anime gentili che hanno faticato e sono morte tra quelle mura dorate. Le saghe scritte su quelle vite sono andate perdute nel tempo.",shape=box,color=blue];
		j2699743282 -> j252182733;
	j2991488970 [label="Sarebbe inutile ucciderli. Non è vero? Stai cercando di convincermi del contrario? Usurpatore, sono impressionato - non ti avrei mai immaginato un mostro così subdolo!",shape=box,color=blue];
		j2991488970 -> j1258661974;
		j2991488970 -> j2546184104;
	j3806688490 [label="Se vuoi provare a fare qualche timida insinuazione, Usurpatore, dilla e basta.",shape=box,color=blue];
		j3806688490 -> j1258661974;
		j3806688490 -> j2546184104;
	j1564852489 [label="Sono abbastanza sicuro che se tu scendessi nella cripta e trovassi due macchie di sangue dove un tempo si trovavano i fanatici, mi faresti una bella lavata di capo, non è vero?",shape=box,color=blue];
		j1564852489 -> j422851486;
	j252182733 [label="I fiumi di lacrime versati per le tragedie che rimarranno per sempre inosservate, semplicemente perché ti sono sconosciute.",shape=box,color=blue];
		j252182733 -> j1391777358;
	j1258661974 [label="Va bene ammettere che trovi piacevole la compagnia. Le persone possono fare molto di più che limitarsi a uno scopo utilitaristico.",shape=box,color=red];
		j1258661974 -> j796436421;
	j2546184104 [label="Va bene ammettere che allontaniamo la tua solitudine, anche se ti diamo fastidio.",shape=box,color=red];
		j2546184104 -> j134072315;
	j422851486 [label="Da te, o dal maggiordomo, o dal Tenno, o dalla terrificante \"Madre\" del Tenno. Ugh. Quella. Quella mi disturba. Un argomento per un'altra volta.",shape=box,color=blue];
		j422851486 -> j2546184104;
		j422851486 -> j1258661974;
	j1391777358 [label="Sento che il ragazzino piange il nome di Adis. ",shape=box,color=blue];
