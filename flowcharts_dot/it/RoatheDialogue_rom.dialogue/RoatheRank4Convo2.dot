	j1058111377 [label="Se vuoi sterminare tutti gli Orokin? Sali le scale. Hai alcuni esemplari sopravvissuti che non possono sfuggire alla tua ira. Inizia con \"Nonna\".",shape=box,color=blue];
		j1058111377 -> j2044625132;
