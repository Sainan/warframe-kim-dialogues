		2445 -> 2449 [label="RoatheBirdThree",color=purple];
		2445 -> 2450 [label="false",color=purple];
	2446 [label="Il suo nome è unico per te.",shape=box,color=blue];
		2446 -> 2451;
	2448 [label="Non sfidare la sorte, Usurpatore. \"Piacevole\" è un po' esagerato. È più che altro che i miei sentimenti... cominciano a crescere. Come la Muffa.",shape=box,color=blue];
		2448 -> 2453;
	2447 [label="\"Piacere\"? Sarebbe questo? Non mi ero mai reso conto di essere così masochista. Mh. O è semplicemente la sensazione del mio corpo che marcisce, e la sensazione che i miei sentimenti... \"cominciano a crescere?\"",shape=box,color=blue];
		2447 -> 2452;
	2449 [label="È piacevole avere qualcuno con cui parlare. Anche se, come hai detto, ogni tanto sei irritante.",shape=box,color=blue];
		2449 -> 2454;
	2450 [label="Solitudine? Bah. L'unica cosa che tieni a bada è qualsiasi tentativo di sanità mentale di tornare nella mia vita. Se stai cercando di insinuare che dei sentimenti cominciano a \"crescere dentro di me\", sai cos'altro fa così?",shape=box,color=blue];
		2450 -> 2455;
	2451 [label="Ma non per le stelle.",shape=box,color=blue];
		2451 -> 2456;
	2453 [label="+5 Chemistry",color=orange];
		2453 -> 2457;
	2452 [label="Come la muffa.",shape=box,color=blue];
		2452 -> 2457;
	2454 [label="+5 Chemistry",color=orange];
		2454 -> 2458;
	2455 [label="La muffa.",shape=box,color=blue];
		2455 -> 2457;
	2456 [label="Dipingi la mia gente di cremisi quanto vuoi. Fondi l'oro Orokin e chiamaci mostri. Ci meritiamo ogni grammo di vetriolo che puoi darci.",shape=box,color=blue];
		2456 -> 2459;
	2457 [label="Update boolean RoatheAlone2",color=orange];
		2457 -> 2460;
	2458 [label="Lo ammetto, i miei sentimenti... cominciano a crescere. Come la muffa.",shape=box,color=blue];
		2458 -> 2457;
	2459 [label="Ma non osare credere nemmeno per un secondo che fosse tutto ciò di cui eravamo capaci.",shape=box,color=blue];
		2459 -> 2461;
	2460 [label="Check boolean LoidFamilyComplete",color=orange];
		2460 -> 2462 [label=true,color=green];
		2460 -> 2463 [label=false,color=brown];
	2461 [label="Se vuoi sterminare tutti gli Orokin? Sali le scale. Hai alcuni esemplari sopravvissuti che non possono sfuggire alla tua ira. Inizia con \"Nonna\".",shape=box,color=blue];
		2461 -> 2464;
	2462 [label="+10 Chemistry",color=orange];
		2462 -> 2465;
	2463 [label="C'è un altro motivo per cui non mi sono lasciato andare a qualche folle, sanguinaria e orribile furia, Usurpatore.",shape=box,color=blue];
		2463 -> 2466;
	2464 [label="Dopotutto, è lei che ha visto la maggior parte dei nostri simili.",shape=box,color=blue];
		2464 -> 2467;
	2465 [label="Chat ends.",color=orange];
	2466 [label="Devo ancora vedere la conclusione del piccolo dramma tra il nostro caro maggiordono e la famiglia di Albrecht al piano di sopra.",shape=box,color=blue];
		2466 -> 2468;
	2467 [label="Update boolean RoatheNoDate",color=orange];
		2467 -> 2469;
	2468 [label="Ho un interesse personale in tutto questo, non dimenticarlo, che abbiamo o meno un accordo. Ho intenzione di assicurarmi che quando Albrecht metterà piede per la prima volta in questo Sanctum, il primo volto che vedrà?",shape=box,color=blue];
		2468 -> 2470;
	2469 [label="Chat ends.",color=orange];
	2470 [label="Sarà il mio.",shape=box,color=blue];
		2470 -> 2471;
	2471 [label="Non riesco ancora a decidere se sarò circondato dai cadaveri dei suoi cari oppure no quando lo farà.",shape=box,color=blue];
		2471 -> 2472;
	2472 [label="Decisioni, decisioni...",shape=box,color=blue];
