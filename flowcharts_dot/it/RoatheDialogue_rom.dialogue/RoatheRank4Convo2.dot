		j1590886754 -> j3273840607;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j3273840607 [label="Ho un interesse personale in tutto questo, non dimenticarlo, che abbiamo o meno un accordo. Ho intenzione di assicurarmi che quando Albrecht metterà piede per la prima volta in questo Sanctum, il primo volto che vedrà?",shape=box,color=blue];
		j3273840607 -> j364874024;
