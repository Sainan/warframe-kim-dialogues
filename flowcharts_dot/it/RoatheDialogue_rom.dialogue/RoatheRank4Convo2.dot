	j2855266027 [label="Il suo nome è unico per te.",shape=box,color=blue];
		j2855266027 -> j3890785699;
	j171405217 [label="Non sfidare la sorte, Usurpatore. \"Piacevole\" è un po' esagerato. È più che altro che i miei sentimenti... cominciano a crescere. Come la Muffa.",shape=box,color=blue];
		j171405217 -> j1328807703;
	j2577205444 [label="\"Piacere\"? Sarebbe questo? Non mi ero mai reso conto di essere così masochista. Mh. O è semplicemente la sensazione del mio corpo che marcisce, e la sensazione che i miei sentimenti... \"cominciano a crescere?\"",shape=box,color=blue];
		j2577205444 -> j1382816867;
	j3477965844 [label="È piacevole avere qualcuno con cui parlare. Anche se, come hai detto, ogni tanto sei irritante.",shape=box,color=blue];
		j3477965844 -> j1082152857;
	j644674166 [label="Solitudine? Bah. L'unica cosa che tieni a bada è qualsiasi tentativo di sanità mentale di tornare nella mia vita. Se stai cercando di insinuare che dei sentimenti cominciano a \"crescere dentro di me\", sai cos'altro fa così?",shape=box,color=blue];
		j644674166 -> j3435288456;
	j3890785699 [label="Ma non per le stelle.",shape=box,color=blue];
		j3890785699 -> j2337047071;
	j1328807703 [label="+5 Chemistry",color=orange];
		j1328807703 -> j689414758;
	j1382816867 [label="Come la muffa.",shape=box,color=blue];
		j1382816867 -> j689414758;
	j1082152857 [label="+5 Chemistry",color=orange];
		j1082152857 -> j2112985107;
	j3435288456 [label="La muffa.",shape=box,color=blue];
		j3435288456 -> j689414758;
	j2337047071 [label="Dipingi la mia gente di cremisi quanto vuoi. Fondi l'oro Orokin e chiamaci mostri. Ci meritiamo ogni grammo di vetriolo che puoi darci.",shape=box,color=blue];
		j2337047071 -> j2424603211;
	j689414758 [label="Boolean RoatheAlone2 is now true.",color=orange];
		j689414758 -> j1654361623;
	j2112985107 [label="Lo ammetto, i miei sentimenti... cominciano a crescere. Come la muffa.",shape=box,color=blue];
		j2112985107 -> j689414758;
	j2424603211 [label="Ma non osare credere nemmeno per un secondo che fosse tutto ciò di cui eravamo capaci.",shape=box,color=blue];
