		j1933300832 -> "Chat ends.";
	j3099258001 [label="C'è un altro motivo per cui non mi sono lasciato andare a qualche folle, sanguinaria e orribile furia, Usurpatore.",shape=box,color=blue];
		j3099258001 -> j1590886754;
	j2044625132 [label="Dopotutto, è lei che ha visto la maggior parte dei nostri simili.",shape=box,color=blue];
		j2044625132 -> j155006797;
