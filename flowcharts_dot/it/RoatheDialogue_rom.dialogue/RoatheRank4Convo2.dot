		2407 -> 2411 [label="false",color=purple];
	2409 [label="Hai i mezzi. Hai la forza. Hai espresso a sufficienza il tuo disappunto per la situazione.",shape=box,color=red];
		2409 -> 2413;
	2410 [label="Semplicemente non capisco perché il \"Diavolo di Tau\" si accontenti di starsene seduto in una cripta a girarsi i pollici. Anche con il nostro accordo.",shape=box,color=red];
		2410 -> 2414;
	2411 [label="Sei un Orokin. È chiaro che odi tutti quelli che ti circondano. Cosa ti ferma?",shape=box,color=red];
		2411 -> 2415;
	2408 [label="Semplicemente non capisco perché il \"Diavolo di Tau\" si accontenti di starsene seduto in una cripta a girarsi i pollici. Soprattutto perché non abbiamo alcun tipo di accordo.",shape=box,color=red];
		2408 -> 2412;
	2413 [label="+5 Chemistry",color=orange];
		2413 -> 2418;
	2414 [label="Check boolean RoatheKnowsReset2",color=orange];
		2414 -> 2420 [label=true,color=green];
		2414 -> 2419 [label=false,color=brown];
	2415 [label="Scusami se mi prendo un momento per raccogliere i miei pensieri prima di iniziare questa conversazione da un luogo alimentato interamente da rabbia e risentimento.",shape=box,color=blue];
		2415 -> 2421;
	2412 [label="Check boolean RoatheKnowsReset2",color=orange];
		2412 -> 2417 [label=true,color=green];
		2412 -> 2416 [label=false,color=brown];
	2418 [label="E sono contento che tu riconosca che ho la possibilità di trasformare questo posto in un mattatoio con estrema facilità.",shape=box,color=blue];
		2418 -> 2424;
	2420 [label="Perché resta ancora il mistero del perché mi sono fidato di te al punto di dirti così tanto, solo per poi vederti tradire quella fiducia, Usurpatore.",shape=box,color=blue];
		2420 -> 2423;
	2419 [label="C'è ancora del lavoro da fare, Usurpatore. Non posso certo avere il tuo aiuto per recuperare tutti i miei ricordi se vado in giro a uccidere tutti quelli che ho intorno, vero?",shape=box,color=blue];
		2419 -> 2422;
	2421 [label="Poiché mi sforzo molto di non dimostrare subito che il tuo punto è corretto.",shape=box,color=blue];
		2421 -> 2425;
	2417 [label="Perché resta ancora il mistero del perché mi sono fidato di te al punto di dirti così tanto, solo per poi vederti tradire quella fiducia, Usurpatore.",shape=box,color=blue];
		2417 -> 2423;
	2416 [label="Forse spero che tu diventi più saggio e cambi idea. E le probabilità che ciò accada diminuiscono drasticamente se mi metto a massacrare tutti quelli che si trovano nelle vicinanze, non è vero?",shape=box,color=blue];
		2416 -> 2422;
	2424 [label="Ma non servirebbe a nulla farlo, non è vero? Se c'è una sola cosa che si impara dalla guerra, è che l'omicidio, alla fine, serve a ben poco.",shape=box,color=blue];
		2424 -> 2427;
	2423 [label="E le probabilità che ciò accada diminuiscono drasticamente se mi metto a massacrare tutti quelli che ho intorno, non è vero? Se c'è una sola cosa che si impara dalla guerra, è che l'omicidio alla fine serve a ben poco.",shape=box,color=blue];
		2423 -> 2426;
	2422 [label="Oltretutto, non servirebbe a nulla farlo, non è vero? Se c'è una sola cosa che si impara dalla guerra, è che l'omicidio, alla fine, serve a ben poco.",shape=box,color=blue];
		2422 -> 2426;
	2425 [label="Provo simpatia per il tuo odio verso gli Orokin. Credimi. La maggior parte degli Orokin disprezzava gli Orokin. Non ignoro i nostri crimini. Le trasgressioni che abbiamo commesso. ",shape=box,color=blue];
		2425 -> 2428;
	2427 [label="Per quanto possa essere piacevole provare il desiderio di dedicarsi un po' a questo di tanto in tanto.",shape=box,color=blue];
		2427 -> 2431;
		2427 -> 2430;
		2427 -> 2429;
	2426 [label="Per quanto possa essere piacevole provare il desiderio di dedicarsi un po' a questo di tanto in tanto.",shape=box,color=blue];
		2426 -> 2429;
		2426 -> 2430;
		2426 -> 2431;
	2428 [label="Il teatro Yuvan da solo sarebbe motivo sufficiente per radere al suolo la nostra società. Ma tu condanni un intero popolo - di cui sei stato il prodotto, potrei aggiungere, mio Usurpatore - con un colpo solo!",shape=box,color=blue];
		2428 -> 2432;
	2431 [label="Quindi l'unica ragione per cui hai lasciato vivere tutti è perché sarebbe stato inutile ucciderli?",shape=box,color=red];
		2431 -> 2435;
	2430 [label="Non c'è nessun altro motivo per cui lasci vivere tutti?",shape=box,color=red];
		2430 -> 2434;
	2429 [label="Anche Marie e Lyon?",shape=box,color=red];
		2429 -> 2433;
	2432 [label="Non sai nulla di tutte le anime gentili che hanno faticato e sono morte tra quelle mura dorate. Le saghe scritte su quelle vite sono andate perdute nel tempo.",shape=box,color=blue];
		2432 -> 2436;
	2435 [label="Sarebbe inutile ucciderli. Non è vero? Stai cercando di convincermi del contrario? Usurpatore, sono impressionato - non ti avrei mai immaginato un mostro così subdolo!",shape=box,color=blue];
		2435 -> 2438;
		2435 -> 2439;
	2434 [label="Se vuoi provare a fare qualche timida insinuazione, Usurpatore, dilla e basta.",shape=box,color=blue];
		2434 -> 2438;
		2434 -> 2439;
	2433 [label="Sono abbastanza sicuro che se tu scendessi nella cripta e trovassi due macchie di sangue dove un tempo si trovavano i fanatici, mi faresti una bella lavata di capo, non è vero?",shape=box,color=blue];
		2433 -> 2437;
	2436 [label="I fiumi di lacrime versati per le tragedie che rimarranno per sempre inosservate, semplicemente perché ti sono sconosciute.",shape=box,color=blue];
		2436 -> 2440;
	2438 [label="Va bene ammettere che trovi piacevole la compagnia. Le persone possono fare molto di più che limitarsi a uno scopo utilitaristico.",shape=box,color=red];
		2438 -> 2441;
	2439 [label="Va bene ammettere che allontaniamo la tua solitudine, anche se ti diamo fastidio.",shape=box,color=red];
		2439 -> 2442;
	2437 [label="Da te, o dal maggiordomo, o dal Tenno, o dalla terrificante \"Madre\" del Tenno. Ugh. Quella. Quella mi disturba. Un argomento per un'altra volta.",shape=box,color=blue];
		2437 -> 2439;
		2437 -> 2438;
	2440 [label="Sento che il ragazzino piange il nome di Adis. ",shape=box,color=blue];
		2440 -> 2443;
	2441 [label="Add 1 to Thermostat",color=orange];
		2441 -> 2444;
	2442 [label="Add -1 to Thermostat",color=orange];
		2442 -> 2445;
	2443 [label="Adis era uno su un millione.",shape=box,color=blue];
		2443 -> 2446;
