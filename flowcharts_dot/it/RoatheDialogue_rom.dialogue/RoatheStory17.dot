	"Chat ends." [color=orange];
	j3085032371 [label="MV: WARFRAME",shape=box,color=blue];
		j3085032371 -> j3027782325;
	j3027782325 [label="Trascrizione: All'inizio, i Warframe sembravano più una dichiarazione d'arte che un'arma vera e propria.",shape=box,color=blue];
		j3027782325 -> j3744211125;
	j3744211125 [label="La guerra era praticamente persa; i Sentient erano invincibili; creiamo quindi questi strani e surreali guerrieri e armiamoli con armi di antica origine.",shape=box,color=blue];
		j3744211125 -> j1870060059;
	j1870060059 [label="Almeno la nostra sconfitta sarà splendida. Memorabile.",shape=box,color=blue];
		j1870060059 -> j1994982608;
	j1994982608 [label="Ma contro ogni aspettativa, prevalsero. Presto storie di eroismo incredibilmente improbabile filtrarono dal fronte.",shape=box,color=blue];
		j1994982608 -> j238193528;
	j238193528 [label="I Warframe erano apparsi dal cielo, simili ad angeli, liberando prigionieri e devastando le fortezze dei Sentient. Anche da soli erano miracoli; in gruppo, erano dei.",shape=box,color=blue];
		j238193528 -> j655230818;
	j655230818 [label="Non c'è da stupirsi, quindi, che fossero visti come mera propaganda.",shape=box,color=blue];
		j655230818 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}