	2286 [label="Trascrizione: All'inizio, i Warframe sembravano più una dichiarazione d'arte che un'arma vera e propria.",shape=box,color=blue];
		2286 -> 2285;
	2285 [label="La guerra era praticamente persa; i Sentient erano invincibili; creiamo quindi questi strani e surreali guerrieri e armiamoli con armi di antica origine.",shape=box,color=blue];
		2285 -> 2282;
	2282 [label="Almeno la nostra sconfitta sarà splendida. Memorabile.",shape=box,color=blue];
		2282 -> 2283;
	2283 [label="Ma contro ogni aspettativa, prevalsero. Presto storie di eroismo incredibilmente improbabile filtrarono dal fronte.",shape=box,color=blue];
		2283 -> 5715;
	5715 [label="I Warframe erano apparsi dal cielo, simili ad angeli, liberando prigionieri e devastando le fortezze dei Sentient. Anche da soli erano miracoli; in gruppo, erano dei.",shape=box,color=blue];
		5715 -> 5716;
	5716 [label="Non c'è da stupirsi, quindi, che fossero visti come mera propaganda.",shape=box,color=blue];
