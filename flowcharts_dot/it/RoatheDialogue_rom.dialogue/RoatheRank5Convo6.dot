		j2813753334 -> j783997323 [label="false",color=purple];
	j564291870 [label="Cosa ne penso di Marie? A parte il tentativo di convincerti a lasciarla unirsi a noi una notte o due, caro Drifter? (Scherzo. Scherzo.)",shape=box,color=blue];
		j564291870 -> j1448142395;
	j3935045226 [label="Cosa ne penso di Marie? A parte il tentativo di convincerti a lasciarmi unire a voi una notte o due? (Scherzo. Scherzo.)",shape=box,color=blue];
		j3935045226 -> j138729622;
	j1732959172 [label="Come sei riuscito a farle cambiare idea sulla purezza di Albrecht? Sei proprio un 'miracolo'. Forse non dovrebbero adorare Sol e Lua, ma te.",shape=box,color=blue];
		j1732959172 -> j2639857988;
	j662615376 [label="Non sapevo che soffrisse quotidianamente. Lo nasconde molto bene. Non ne aveva mai parlato finché non te l'ha detto. Hai colmato in qualche modo la distanza tra noi.",shape=box,color=blue];
		j662615376 -> j4219726022;
	j2762467719 [label="Fino a poco tempo fa non sapevo nulla della sua storia. Non mi aveva mai raccontato la sua storia finché non l'ha raccontata a te. Tu hai in qualche modo colmato il divario tra di noi.",shape=box,color=blue];
		j2762467719 -> j1221588573;
	j3974985352 [label="Come al solito. Passo ogni momento della mia giornata cercando di non strapparmi la faccia con gli artigli, nel disperato desiderio di soffocarla.",shape=box,color=blue];
		j3974985352 -> "Chat ends.";
	j194284406 [label="Meglio ora che ho qualcuno con cui sfogare le mie frustrazioni. Ma, a dire il vero, le tensioni tra noi sono molto diminuite.",shape=box,color=blue];
		j194284406 -> j1481038522;
	j3462515023 [label="Non sono mica io quello che 'va d'accordo' con Lyon, no? Ah! Scusa la mia orribile battuta. Non ci posso fare niente, e tu me l'hai reso fin troppo facile.",shape=box,color=blue];
		j3462515023 -> j4211331912;
	j577599437 [label="Meglio di come sembra che vadano i vostri rapporti. Come hai fatto combinare questo disastro con lui? Aveva solo bisogno di qualcuno che lo ascoltasse. ",shape=box,color=blue];
		j577599437 -> j3097423574;
	j1056919499 [label="Le tensioni tra noi sono molto migliorate, soprattutto da quando gli hai dato la sicurezza di poter parlare di ciò che lo affligge.",shape=box,color=blue];
		j1056919499 -> j3949275749;
	j2051659001 [label="Le tensioni tra noi sono molto migliorate, soprattutto da quando gli hai dato la sicurezza di poter parlare di ciò che lo affligge.",shape=box,color=blue];
		j2051659001 -> j166514840;
	j2098760333 [label="Come al solito. Passo ogni momento della mia giornata cercando di non strapparmi la faccia con gli artigli, nel disperato desiderio di soffocarlo.",shape=box,color=blue];
		j2098760333 -> "Chat ends.";
	j3352607954 [label="Ammetto che li sto trovando, poco a poco, un po' più tollerabili. Credo che ciò sia dovuto principalmente al fatto che, a poco a poco, si siano arresi con me.",shape=box,color=blue];
		j3352607954 -> j3204313346;
	j2328540283 [label="Ammetto che li sto trovando, a poco a poco, leggermente più tollerabili. Credo che le mie recenti rivelazioni possano avere qualcosa a che fare con questo.",shape=box,color=blue];
		j2328540283 -> j1944588147;
	j783997323 [label="Mi ritrovo sempre a chiedermi se, sebbene non possa usare il Refrattario Oscuro per recuperare i miei ricordi, dato che ora sono un protoframe...",shape=box,color=blue];
		j783997323 -> j3464680451;
	j1448142395 [label="Chissà se si rende conto che la mia provocazione si è trasformata da sincero fastidio in un presa in giro per divertimento?",shape=box,color=blue];
		j1448142395 -> j2573100277;
	j138729622 [label="Devo ammettere che non ti biasimo minimamente. E non solo perché è bellissima. Ho gli occhi. Quella donna ha più compassione di quanta mi sarei aspettato che sopravvivesse alla sua età.",shape=box,color=blue];
		j138729622 -> j1448142395;
	j2639857988 [label="Bah. È quel tipo di linguaggio che ha portato all'ascesa dell'Impero Orokin. È un errore che questo Sistema non dovrebbe mai ripetere.",shape=box,color=blue];
		j2639857988 -> j1448142395;
	j4219726022 [label="Ammetto di essere uno degli sciocchi di cui parla, non riesce a capacitarsi di vivere in questo modo, giorno dopo giorno.",shape=box,color=blue];
		j4219726022 -> j2479898429;
	j1221588573 [label="E pensare che la sua famiglia l'ha buttata in strada. Lei. Marie. Quella Marie. Quella con più compassione di quanta dovrebbe essere possibile?!",shape=box,color=blue];
		j1221588573 -> j165944357;
	j1481038522 [label="Conoscono il mio... segreto. La verità sul fatto che ho assunto il siero volontariamente.",shape=box,color=blue];
		j1481038522 -> j3599422421;
		j1481038522 -> j2464634209;
	j4211331912 [label="Ti faccio i miei complimenti per aver affrontato quel povero pazzo. Ha bisogno di compagnia. E di compassione.",shape=box,color=blue];
		j4211331912 -> j2998807351;
	j3097423574 [label="Eppure lo hai escluso. Vergognati.",shape=box,color=blue];
		j3097423574 -> "Chat ends.";
	j3949275749 [label="Mi ha parlato del ragazzino Tenno che sentiva. E di come non lo senta più.",shape=box,color=blue];
		j3949275749 -> j1966417163;
	j166514840 [label="Sapevo incredibilmente poco di quello che gli era stato fatto. Solo quando te l'ha raccontato, ha avuto la volontà di raccontarmelo. ",shape=box,color=blue];
		j166514840 -> j1959512051;
	j3204313346 [label="Scherzo. Mi sto affezionando stranamente a loro, nonostante il mio rinnovato impegno a ignorare le loro critiche riguardo le mie decisioni nella vita.",shape=box,color=blue];
		j3204313346 -> j3484609508;
		j3204313346 -> j3253066282;
	j1944588147 [label="Mi aspettavo che accogliessero il mio pentimento con scherno, tipo 'finalmente vede la luce' o 'te l'avevamo detto'. Tutto il contrario. Non ne hanno quasi fatto menzione.",shape=box,color=blue];
		j1944588147 -> j3643243281;
	j3464680451 [label="...se questo non mi impedisca di annegarci dentro.",shape=box,color=blue];
		j3464680451 -> "Chat ends.";
	j2573100277 [label="Spero di sì. È troppo divertente tormentarla. Vederla arrabbiarsi e urlarmi contro nella sua lingua madre è il mio nuovo sport preferito.",shape=box,color=blue];
		j2573100277 -> j177736308;
	j2479898429 [label="Come può mantenere una tale compostezza? Per non parlare della compassione? Credo che sarei impazzito quanto il prete nelle sue condizioni.",shape=box,color=blue];
		j2479898429 -> j1448142395;
	j165944357 [label="Non posso descriverti il mio desiderio di utilizzare un Helminth per viaggiare indietro nel tempo e uccidere tutta la sua famiglia. Lentamente. Ma probabilmente lei si opporrebbe. ",shape=box,color=blue];
		j165944357 -> j2677108912;
	j3599422421 [label="Io non gliel'ho detto.",shape=box,color=red];
		j3599422421 -> j3204029689;
	j2464634209 [label="Come lo hanno scoperto?",shape=box,color=red];
		j2464634209 -> j3640399117;
	j2998807351 [label="Ma parlando seriamente, le tensioni tra noi sono molto migliorate.",shape=box,color=blue];
		j2998807351 -> j1481038522;
	j1966417163 [label="Mi aspetto comunque che la voce lo perseguiti nei suoi incubi ad occhi aperti. Quel pover'uomo metterà sempre in discussione il confine tra realtà e finzione.",shape=box,color=blue];
		j1966417163 -> j3894158190;
	j1959512051 [label="Non posso descriverti il mio desiderio di utilizzare un Helminth per viaggiare indietro nel tempo e uccidere i suoi genitori. Lentamente. Ma temo che potrebbe opporsi.",shape=box,color=blue];
		j1959512051 -> j1713521855;
	j3484609508 [label="E comunque, voi tre siete bloccati insieme. Ci ha pensato Entrati. Quindi, non c'è niente di male a trarre il meglio dalla situazione.",shape=box,color=red];
		j3484609508 -> j2806937680;
	j3253066282 [label="Sono felice. Credo che ci tengano davvero a te.",shape=box,color=red];
		j3253066282 -> j3916093641;
	j3643243281 [label="Sono contento che non l'abbiano fatto. Non voglio che mi si venga strofinato il naso come una cucciolo che ha sporcato il tappeto. Ho già abbastanza di cui preoccuparmi.",shape=box,color=blue];
		j3643243281 -> j3484609508;
		j3643243281 -> j3253066282;
	j177736308 [label="Un altro motivo per cui le cose tra noi sono migliorate? Conoscono il mio segreto. La verità sul fatto che ho assunto il siero volontariamente.",shape=box,color=blue];
		j177736308 -> j1565356734;
		j177736308 -> j1099153637;
	j2677108912 [label="Gli omicidi per vendetta sono probabilmente disapprovati da Sol, ecc, ecc. ",shape=box,color=blue];
		j2677108912 -> j1448142395;
	j3204029689 [label="E non stavo nemmeno dicendo che l'hai fatto, caro Drifter. Gliel'ho detto io.",shape=box,color=blue];
		j3204029689 -> j1806500125;
	j3640399117 [label="Gliel'ho detto io, caro Drifter.",shape=box,color=blue];
		j3640399117 -> j1806500125;
