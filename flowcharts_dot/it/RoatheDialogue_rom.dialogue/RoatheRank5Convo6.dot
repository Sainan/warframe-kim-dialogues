		j32725969 -> j1254858991 [label=false,color=brown];
	j265900054 [label="Ma soprattutto, quanto avrebbe voluto dimenticare tutto. E che forse, a un livello più profondo, non eravamo uguali, noi tre.",shape=box,color=blue];
		j265900054 -> j1260070906;
		j265900054 -> j1987685753;
	j973664444 [label="Soprattutto Marie. Credo che abbia capito che confrontarsi continuamente con me su questioni del passato non servirà a nulla.",shape=box,color=blue];
		j973664444 -> j3137425038;
