		j3137425038 -> j2077824508 [label=false,color=brown];
	j2223189713 [label="Il Roathe di un tempo avrebbe colto l'occasione per asportarle i reni, ma ho scoperto di non aver più voglia di farlo. ",shape=box,color=blue];
		j2223189713 -> j4176891181;
	j30526383 [label="Ci volle ogni grammo di forza di volontà per non esportarle i reni. Ma il suo unico intento era offrirmi un semplice conforto.",shape=box,color=blue];
		j30526383 -> j3146575209;
