	j3786505839 [label="Una sera, mentre leggevo in silenzio da solo, si è avvicinato.",shape=box,color=blue];
		j3786505839 -> j1001198525;
	j2926693736 [label="Naturalmente l'ho abbracciata a mia volta. Sono un Orokin, non un mostro.",shape=box,color=blue];
		j2926693736 -> j654173032;
	j103705400 [label="Quel prete. Se dovessi concludere con una sola nota, direi che è questa: la sua resilienza è in qualche modo infinita come il tempo stesso. ",shape=box,color=blue];
		j103705400 -> j2275570194;
	j318038743 [label="Lo ha a malapena accennato. E gliene sono profondamente grato. Mi aspettavo scherni e prese in giro. 'Finalmente, il diavolo è stato umiliato.' Tutto il contrario. Sono andati avanti con le loro vite come se poco fosse cambiato.",shape=box,color=blue];
		j318038743 -> j3519984451;
	j1693468159 [label="Il Roathe di un tempo avrebbe colto l'occasione per asportarle i reni, ma ho scoperto di non aver più voglia di farlo. ",shape=box,color=blue];
		j1693468159 -> j1440949249;
	j199642233 [label="Ci volle ogni grammo di forza di volontà per non esportarle i reni. Ma il suo unico intento era offrirmi un semplice conforto.",shape=box,color=blue];
		j199642233 -> j200773070;
	j4191203337 [label="Voleva solo offrirmi del semplice conforto.",shape=box,color=blue];
		j4191203337 -> j648996441;
	j3164167791 [label="Esatto. E devo ringraziare te per questo, non è vero?",shape=box,color=blue];
		j3164167791 -> j687715555;
	j1566710066 [label="Penso che alla fine si rivelerà più di questo. Anche se detesto questa realtà. Dopotutto, sono intrappolato qui con loro.",shape=box,color=blue];
		j1566710066 -> j687715555;
	j1001198525 [label="Si è seduto accanto a me e mi ha raccontato di come avesse messo in discussione la sua fede da quando Entrati gli aveva dato il siero. Di come si vergognasse di averla messa in discussione. Di come si fosse pentito di aver preso il siero.",shape=box,color=blue];
		j1001198525 -> j721709727;
	j654173032 [label="E da allora?",shape=box,color=blue];
		j654173032 -> j3290981676;
	j2275570194 [label="Per un uomo che distrutto in mille pezzi, non è ancora crollato.",shape=box,color=blue];
		j2275570194 -> j1622505995;
	j1440949249 [label="Per una volta nella mia miserabile vita, ha accettato la semplice offerta di conforto per quello che era.",shape=box,color=blue];
		j1440949249 -> j200773070;
	j200773070 [label="Era un modo semplice per dirmi che forse a lei non importava quanto a me. E che le dispiaceva per tutto il dolore che mi ero procurato.",shape=box,color=blue];
		j200773070 -> j648996441;
	j648996441 [label="E da allora?",shape=box,color=blue];
		j648996441 -> j2811578619;
	j687715555 [label="Quella Sorella di Sol. Se dovessi concludere con una sola nota, direi che è questa: la sua gentilezza è in qualche modo infinita come il tempo stesso.",shape=box,color=blue];
		j687715555 -> j208228820;
	j721709727 [label="Ma soprattutto, quanto avrebbe voluto dimenticare tutto. E che forse, a un livello più profondo, non eravamo uguali, noi tre.",shape=box,color=blue];
		j721709727 -> j654173032;
