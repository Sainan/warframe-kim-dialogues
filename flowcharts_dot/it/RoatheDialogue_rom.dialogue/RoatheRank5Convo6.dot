		j598317519 -> j2814027212 [label="false",color=purple];
	j3943321243 [label="Penso che sappia anche cosa significa essere un prodotto della propria società e del proprio contesto. Potrebbe simpatizzare con il tuo passato più di quanto tu creda.",shape=box,color=red];
		j3943321243 -> j149409392;
