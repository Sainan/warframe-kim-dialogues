		j1958261342 -> j3883401888;
	j3519984451 [label="In particolare Lyon. Credo che capisca la difficoltà di affrontare il passato e le decisioni che abbiamo preso. Vedi: la benda sull'occhio, se mi passi il gioco di parole.",shape=box,color=blue];
		j3519984451 -> j32725969;
	j1038320401 [label="Si è seduto accanto a me e mi ha raccontato di come avesse messo in discussione la sua fede da quando Entrati gli aveva dato il siero. Di come si vergognasse di averla messa in discussione. Di come si fosse pentito di aver preso il siero.",shape=box,color=blue];
		j1038320401 -> j265900054;
	j1753897345 [label="Mi aspettavo che accogliessero la mia vergogna con scherno, con scherni del tipo \"finalmente, il diavolo è stato umiliato\". Invece. Non ne hanno quasi fatto menzione.",shape=box,color=blue];
