		j3894158190 -> j1481038522;
	j1713521855 [label="Gli omicidi per vendetta sono probabilmente disapprovati da Lua, ecc, ecc. ",shape=box,color=blue];
		j1713521855 -> j3372253621;
	j2806937680 [label="Esatto. Non ha senso farmi nemici i nuovi coinquilini. Era proprio per questo che continuavo a rubare quei dolci in Gaule.",shape=box,color=blue];
		j2806937680 -> j1723460191;
