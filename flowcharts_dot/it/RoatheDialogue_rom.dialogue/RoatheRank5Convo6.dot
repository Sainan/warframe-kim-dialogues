	j4113839126 [label="Mi aspettavo che accogliessero la mia vergogna con scherno, con scherni del tipo \"finalmente, il diavolo è stato umiliato\". Invece. Non ne hanno quasi fatto menzione.",shape=box,color=blue];
		j4113839126 -> j3519984451;
