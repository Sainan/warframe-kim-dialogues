	j149409392 [label="+10 Chemistry",color=orange];
		j149409392 -> j2002015374;
	j2901006576 [label="+5 Chemistry",color=orange];
		j2901006576 -> j2101400273;
	j1469864262 [label="Gli ho stretto la mano. E l'ho ringraziato come un amico. Sono un Orokin, non un mostro.",shape=box,color=blue];
		j1469864262 -> j3334801538;
	j934141043 [label="Quando le ho raccontato la verità che avevamo scoperto, non ha detto nulla. Si è limitata ad... abbracciarmi.",shape=box,color=blue];
		j934141043 -> j1093047434;
	j2248618356 [label="Soprattutto dopo tutto quello che ha imparato su Entrati. Sa che le persone possono essere più complicate di quanto dimostrino in superficie.",shape=box,color=red];
		j2248618356 -> j1712277082;
	j2077824508 [label="Sono semplicemente felice che si sia un qualche tipo di amicizia tra voi. Anche se si tratta solo di un cessate il fuoco.",shape=box,color=red];
		j2077824508 -> j3707545384;
	j4176891181 [label="Per una volta nella mia miserabile vita, ha accettato la semplice offerta di conforto per quello che era.",shape=box,color=blue];
		j4176891181 -> j3146575209;
	j3146575209 [label="Era un modo semplice per dirmi che forse a lei non importava quanto a me. E che le dispiaceva per tutto il dolore che mi ero procurato.",shape=box,color=blue];
		j3146575209 -> j53435111;
		j3146575209 -> j2651372443;
	j53435111 [label="E Lyon?",shape=box,color=red];
		j53435111 -> j3786505839;
	j2651372443 [label="E cosa hai fatto?",shape=box,color=red];
		j2651372443 -> j2926693736;
	j2002015374 [label="Temo che tu abbia ragione. Il destino gli ha riservato una sorte terribile e lui ha fatto tutto il possibile per resistervi.",shape=box,color=blue];
		j2002015374 -> j103705400;
