	j3468991590 [label="Tu, che hai poteri di cui non ho mai sentito parlare, di essere posseduto da un altro essere? Che viaggi nel tempo stesso. Che crei dimensioni tascabili. Eppure sei qui... a riparare relazioni. (E a collezionarne qualcuna.)",shape=box,color=blue];
