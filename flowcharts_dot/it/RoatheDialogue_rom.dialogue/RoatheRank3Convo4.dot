	1951 [label="Se pensi che sia una cosa da poco fare quello che faccio, certo. Questa è la tua opinione. Quello che ho fatto ha riscritto la storia.",shape=box,color=red];
		1951 -> 1957;
	1952 [label="Non piccolo. Invisibile. Lascia che gli altri corrano in giro ad attirare l'attenzione. Io resterò nell'ombra.",shape=box,color=red];
		1952 -> 1958;
	1953 [label="Perché aiutare le persone quando ne hanno bisogno è il modo in cui alla fine riusciremo ad uscirne.",shape=box,color=red];
		1953 -> 1959;
	1954 [label="Perché sto facendo ciò che deve essere fatto. Niente di più, niente di meno.",shape=box,color=red];
		1954 -> 1960;
	1956 [label="Hai detto che non hai mai saputo cosa significhi essere amati. Non credo che capirai quanto possa essere potente nel cambiare il modo in cui funziona il mondo intorno a te.",shape=box,color=red];
		1956 -> 1962;
	1955 [label="Ti sei mai innamorato, Roathe? O ti sei mai interessato a qualcuno così tanto da bruciare l'universo per loro?",shape=box,color=red];
		1955 -> 1961;
	1957 [label="È proprio questo il punto! Andiamo a riscrivere la storia, allora! Non restiamo qui a cercare di convincere tutti a tenersi per mano e cantare canzoni!",shape=box,color=blue];
		1957 -> 1963;
		1957 -> 1964;
		1957 -> 1965;
	1958 [label="Ah, capisco, preferisci essere l'assassino nell'ombra, vero? Colpire quando meno se l'aspettano? No. Non credo. Credo che tu stia solo girando a vuoto.",shape=box,color=blue];
		1958 -> 1966;
	1959 [label="Mmh. Fare commissioni per degli sconosciuti finché non ti adorano come un eroe locale? O convincerli tutti a tenersi per mano e cantare canzoni? Scusa, vado a vomitare nella vasca di Fibonacci.",shape=box,color=blue];
		1959 -> 1967;
		1959 -> 1968;
	1960 [label="E quello che stai \"facendo\" sembrerebbe correre in giro convincendo tutti a tenersi per mano e cantare canzoni tra uno spettacolo e l'altro di incredibile violenza. La violenza ha senso. Il resto è nauseabondo. ",shape=box,color=blue];
		1960 -> 1967;
		1960 -> 1968;
	1962 [label="Se insisti nel dire che salveremo l'universo da questa \"Indifferenza\" tenendoci per mano e cantando canzoni, perdonami, ma vado a vomitare nella vasca di Fibonacci.",shape=box,color=blue];
