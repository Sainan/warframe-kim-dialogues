		j3004485641 -> j526622791;
		j3004485641 -> j1300936376;
		j3004485641 -> j2132897283;
	j1137207568 [label="Sono felice di quello che faccio. Aiuto le persone nel modo in cui desidero aiutarle.",shape=box,color=red];
		j1137207568 -> j2003229991;
	j1657856324 [label="Non so se riesci a capirlo, ma provaci: non voglio governare un universo.",shape=box,color=red];
		j1657856324 -> j690105585;
	j2733979054 [label="Non mi renderebbe migliore di Albrecht. O degli Orokin. Infuriarmi rimodellando il mondo a mia immagine. Non mi interessa.",shape=box,color=red];
		j2733979054 -> j690105585;
	j526622791 [label="Sono felice di quello che faccio. Aiuto le persone nel modo in cui desidero aiutarle.",shape=box,color=red];
		j526622791 -> j2003229991;
	j1300936376 [label="Non so se riesci a capirlo, ma provaci: non voglio governare un universo.",shape=box,color=red];
		j1300936376 -> j116299300;
	j2132897283 [label="Non mi renderebbe migliore di Albrecht. O degli Orokin. Infuriarmi rimodellando il mondo a mia immagine. Non mi interessa.",shape=box,color=red];
		j2132897283 -> j116299300;
	j2003229991 [label="Ma perché? Questo è ciò che non capisco.",shape=box,color=blue];
		j2003229991 -> j1990388149;
