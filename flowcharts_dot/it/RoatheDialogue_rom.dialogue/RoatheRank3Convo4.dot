		1965 -> 1973;
	1966 [label="Non sai cosa fai o perché lo fai, stai semplicemente facendo quello che ti viene detto. Un altro tirapiedi presuntuoso di un Orokin arrogante. Vergogna.",shape=box,color=blue];
		1966 -> 1974;
	1967 [label="Dico solo che sembri davvero arrabbiato all'idea che le persone non siano più infelici. E sembra che tu la prenda molto sul personale.",shape=box,color=red];
		1967 -> 1975;
	1968 [label="Ciò che volevo dire è semplicemente che se 'l'Indifferenza' si nutre della mancanza di emozioni, averle potrebbe essere la chiave per sconfiggerla.",shape=box,color=red];
		1968 -> 1976;
	1970 [label="Pensi che sia impossibile per qualcuno amarti? O pensi di non essere capace di provare amore per qualcun altro? O pensi che semplicemente non sia ancora successo?",shape=box,color=red];
		1970 -> 1977;
	1969 [label="No, non l'ho fatto. E se insisti nel dire che salveremo l'universo da questa \"Indifferenza\" tenendoci per mano e cantando canzoni, perdonami, ma vado a vomitare nella vasca di Fibonacci.",shape=box,color=blue];
		1969 -> 1970;
