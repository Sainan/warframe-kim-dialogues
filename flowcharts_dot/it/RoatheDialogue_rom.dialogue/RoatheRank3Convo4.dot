	1886 [label="Sembra che tu sia deciso a correre per l'universo dietro Albrecht con un secchio e uno straccio. Guarda il tuo lavoro con il suo maggiordomo. ",shape=box,color=blue];
		1886 -> 1889;
	1887 [label="Sembra che tu sia deciso a correre per l'universo dietro Albrecht con un secchio e uno straccio.",shape=box,color=blue];
