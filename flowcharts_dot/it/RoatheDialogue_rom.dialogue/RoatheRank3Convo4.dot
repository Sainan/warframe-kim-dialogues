digraph {
	"RoatheRank3Convo4 begins." [color=orange];
		"RoatheRank3Convo4 begins." -> j3542270227;
	j3542270227 [label="Puoi rispondere a una domanda, Usurpatore? È da un po' che mi tormenta.",shape=box,color=blue];
		j3542270227 -> j3574329963;
		j3542270227 -> j3233954627;
		j3542270227 -> j4115718638;
	j3574329963 [label="Chiedi pure. ",shape=box,color=red];
		j3574329963 -> j4188144680;
	j3233954627 [label="Cosa mai potrebbe tormentarti?",shape=box,color=red];
		j3233954627 -> j261196698;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j4188144680 [label="Perché stai facendo tutto questo?",shape=box,color=blue];
		j4188144680 -> j3524964328;
	j261196698 [label="Potrei stilare un elenco, ma temo che ci vorrebbe tutto il pomeriggio. No, le mie domande al riguardo si concentrano specificatamente su un argomento particolare. Almeno per oggi.",shape=box,color=blue];
		j261196698 -> j4188144680;
	"Chat ends." [color=orange];
	j3524964328 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3524964328 -> j224159103 [label=true,color=green];
		j3524964328 -> j2768280751 [label=false,color=brown];
	j224159103 [label="E non mi riferisco al fatto che tu ti intrometta nei miei ricordi. Intendo 'tutto questo' in un senso più ampio.",shape=box,color=blue];
		j224159103 -> j2768280751;
	j2768280751 [label="Check boolean LoidFamilyComplete",color=orange];
		j2768280751 -> j647666440 [label=true,color=green];
		j2768280751 -> j3738267352 [label=false,color=brown];
	j647666440 [label="Sembra che tu sia deciso a correre per l'universo dietro Albrecht con un secchio e uno straccio. Guarda il tuo lavoro con il suo maggiordomo. ",shape=box,color=blue];
		j647666440 -> j2476974658;
	j3738267352 [label="Sembra che tu sia deciso a correre per l'universo dietro Albrecht con un secchio e uno straccio.",shape=box,color=blue];
		j3738267352 -> j2476974658;
	j2476974658 [label="Check boolean IsDating",color=orange];
		j2476974658 -> j1022806809 [label=true,color=green];
		j2476974658 -> j890747841 [label=false,color=brown];
	j1022806809 [label="Sembra proprio che nel frattempo tu abbia i tuoi pruriti da grattarti - e ti applaudo per questo, non ti sto affatto giudicando. Mi sembra solo strano che una persona così... meravigliosamente e selvaggiamente sfacciata possa essere così obbediente. ",shape=box,color=blue];
		j1022806809 -> j1699589545;
		j1022806809 -> j787290732;
		j1022806809 -> j3664305570;
	j890747841 [label="Mi sembra solo strano che una persona così... meravigliosamente e selvaggiamente sfacciata possa essere così obbediente. ",shape=box,color=blue];
		j890747841 -> j1699589545;
		j890747841 -> j787290732;
		j890747841 -> j3664305570;
	j1699589545 [label="Lasciare che l'indifferenza distrugga il Sistema Origin - o qualsiasi altro posto - non aiuta nessuno.",shape=box,color=red];
		j1699589545 -> j3288615533;
	j787290732 [label="Non obbedisco a Entrati.",shape=box,color=red];
		j787290732 -> j2355268529;
	j3664305570 [label="Ho le mie ragioni. E sono solo mie.",shape=box,color=red];
		j3664305570 -> j168703151;
	j3288615533 [label="Ah, capisco. È solo un servizio temporaneo che offri finché non verrà risolta la situazione con 'l'Indifferenza'. E cosa pensi di fare a quel punto?",shape=box,color=blue];
		j3288615533 -> j2586581268;
		j3288615533 -> j1495709721;
		j3288615533 -> j2902131059;
		j3288615533 -> j1183046924;
		j3288615533 -> j4233724829;
	j2355268529 [label="Davvero? Sembra proprio così, da dove sono seduto. Lui schiocca le dita e tu ti metti in ginocchio e ti siedi alle sue caviglie come un bravo kubrow addestrato. Lui sussurra persino il nome 'Tau' e voi tutti vi affannate a ricordare ogni possibile dettaglio sul posto che avete perso.",shape=box,color=blue];
		j2355268529 -> j3610237824;
		j2355268529 -> j1530776203;
	j168703151 [label="Così misterioso, così imperscrutabile! E un mucchio di stronzate da mandriano. Se non vuoi semplicemente ammettere di essere a sua completa disposizione, pazienza.",shape=box,color=blue];
		j168703151 -> j3020678238;
	j2586581268 [label="Perché insisti su questo? Cosa stai cercando di chiedermi veramente?",shape=box,color=red];
		j2586581268 -> j923103079;
	j1495709721 [label="A dire il vero, non ci ho pensato molto in anticipo.",shape=box,color=red];
		j1495709721 -> j713331997;
	j2902131059 [label="Ho intenzione di fargliela pagare per aver combinato un simile disastro. Ha molto da espiare. ",shape=box,color=red];
		j2902131059 -> j2533882130;
	j1183046924 [label="Intendi, ammesso che sopravviva?",shape=box,color=red];
		j1183046924 -> j3516125616;
	j4233724829 [label="Vado dove c'è bisogno di me, come sempre. Sono i problemi a trovarmi.",shape=box,color=red];
		j4233724829 -> j2892127832;
	j3610237824 [label="Perché ti sforzi così tanto di farmi arrabbiare?",shape=box,color=red];
		j3610237824 -> j3053719887;
	j1530776203 [label="Faccio semplicemente ciò che devo fare per aiutare le persone a uscire dalle situazioni miseravili in cui si trovano.",shape=box,color=red];
		j1530776203 -> j2048410339;
	j3020678238 [label="Perché dove sono seduto, sembra che schiocchi le dita e tu ti metti in ginocchio e ti siedi alle sue caviglie come un bravo kubrow addestrato. Lui sussurra persino il nome 'Tau' e voi tutti vi affannate a ricordare ogni possibile dettaglio sul posto che avete perso.",shape=box,color=blue];
		j3020678238 -> j3610237824;
		j3020678238 -> j1530776203;
	j923103079 [label="+5 Chemistry",color=orange];
		j923103079 -> j3441275081;
	j713331997 [label="Ah! Quindi ammetti di essere un idiota! Che sollievo. Adoro quando gli idioti mettono in mostra la loro mancanza di arguzia, mi rende il compito di manipolarli ancora più facile.",shape=box,color=blue];
		j713331997 -> j560859428;
	j2533882130 [label="Ah! Quindi è una vendetta vile e primordiale quella che cerchi! Glorioso. Un animale rabbioso, pronto a rosicchiare le ossa di coloro che ti hanno fatto del male.",shape=box,color=blue];
		j2533882130 -> j494164058;
	j3516125616 [label="+5 Chemistry",color=orange];
		j3516125616 -> j4124339533;
	j2892127832 [label="Ah, capisco. Apatia mascherata da nobiltà. Non sai dove stare, dove dovresti stare, quindi ti ricopri di questo \"sacrificio di giustizia\" e ti comporti come vogliono gli altri?",shape=box,color=blue];
		j2892127832 -> j3230243950;
	j3053719887 [label="Perché non riesco proprio a capire perché tu, un'entità che, per quanto ne so, proviene da un'altra versione della realtà, sia decisa a correre senza controllo attraverso il tempo e lo spazio, \"Giocando allo Psicologo\".",shape=box,color=blue];
		j3053719887 -> j328365610;
	j2048410339 [label="Sì, e questo ci porta al nocciolo della questione! Perché insisti a vagare nel tempo e nello spazio 'Giocando allo Psicologo?' Tu che sei un'entità che, per quanto ne so, proviene da un'altra versione della realtà. ",shape=box,color=blue];
		j2048410339 -> j328365610;
	j3441275081 [label="Astuto. Sì, molto bene, andrò al nocciolo della questione. Stavo cercando di provocarti e farti arrabbiare per vedere se questo ti avrebbe spinto a rispondere in modo più onesto.",shape=box,color=blue];
		j3441275081 -> j2756742621;
	j560859428 [label="Sei come un kubrow che ha finalmente catturato un kaithe. Non sai cosa fare ora che gli hai morso la zampa.",shape=box,color=blue];
		j560859428 -> j1530776203;
		j560859428 -> j3610237824;
	j494164058 [label="Una delle motivazioni umane più semplici e antiche. E quindi, una delle più facili da comprendere.",shape=box,color=blue];
		j494164058 -> j1530776203;
	j4124339533 [label="Non sono mai stato ufficialmente un soldato, eppure nel tuo tono sento la stanchezza del più temprato dalle battaglie.",shape=box,color=blue];
		j4124339533 -> j622670604;
	j3230243950 [label="Davvero tragico.",shape=box,color=blue];
		j3230243950 -> j2177829989;
		j3230243950 -> j2042864561;
	j328365610 [label="Se fossi in te, tornerei a Duviri per scoprire quali altri buchi nel tessuto del Void potrei fare! Immagina le possibilità! Immagina i mondi, pronti per essere conquistati!",shape=box,color=blue];
		j328365610 -> j4173302394;
		j328365610 -> j2601319180;
	j2756742621 [label="Ma suppongo che me lo farò bastare.",shape=box,color=blue];
		j2756742621 -> j34722693;
	j622670604 [label="Molto bene. Per rispetto, andrò subito al nocciolo della questione. Stavo cercando di provocarti e farti arrabbiare per vedere se questo ti avrebbe spinto a rispondere in modo più onesto.",shape=box,color=blue];
		j622670604 -> j34722693;
	j2177829989 [label="Ho un posto a cui appartengo.",shape=box,color=red];
		j2177829989 -> j3935022291;
	j2042864561 [label="Non so di cosa stai parlando.",shape=box,color=red];
		j2042864561 -> j1824860706;
	j4173302394 [label="Non sei diverso da Albrecht. Lui attraversa il tempo causando tutti questi problemi. E tu vuoi fare lo stesso a intere dimensioni?!",shape=box,color=red];
		j4173302394 -> j3502127137;
	j2601319180 [label="Questo è il problema di voi Orokin. Pensate che interi mondi siano solo vostri e che possiate farne ciò che volete. ",shape=box,color=red];
		j2601319180 -> j1567724244;
	j34722693 [label="+5 Chemistry",color=orange];
		j34722693 -> j94573086;
	j3935022291 [label="Raccontalo! È questa Höllvania? O forse Duviri? O forse il tuo Orbiter precipitato su ciò che resta della Terra?",shape=box,color=blue];
		j3935022291 -> j1530776203;
		j3935022291 -> j3610237824;
	j1824860706 [label="Allora raccontami dov'è casa tua! È questa Höllvania? O forse Duviri? O forse il tuo Orbiter precipitato su ciò che resta della Terra?",shape=box,color=blue];
		j1824860706 -> j1530776203;
		j1824860706 -> j3610237824;
	j3502127137 [label="E perché non dovremmo? Siamo creature superiori, non è vero? Albrecht fa quello che vuole, e tu non hai problemi ad andare in giro a ripulire al suo passaggio! Perché non dovrei avere il diritto di fare lo stesso? Cosa rende la sua ricerca \"giustificata\" e la mia no?",shape=box,color=blue];
		j3502127137 -> j739141775;
	j1567724244 [label="E perché non dovremmo? Siamo noi le creazioni superiori, no? Albrecht fa quello che vuole, imperversando nel tempo, infettando le masse con un malattia che a malapena comprende, tutto in nome della 'sconfitta di una cosiddetta divinità'.",shape=box,color=blue];
		j1567724244 -> j739141775;
	j94573086 [label="Non riesco proprio a capire perché tu, un'entità che, per quanto ne so, proviene da un'altra versione della realtà, sia decisa a correre senza controllo attraverso il tempo e lo spazio, \"Giocando allo Psicologo\".",shape=box,color=blue];
		j94573086 -> j3956801596;
	j739141775 [label="Ma guardati! ",shape=box,color=blue];
		j739141775 -> j965779903;
