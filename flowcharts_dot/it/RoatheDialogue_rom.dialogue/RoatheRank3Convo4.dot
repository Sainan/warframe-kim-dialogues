		1973 -> 1979;
	1974 [label="Chat ends.",color=orange];
	1975 [label="Perché la miseria ama la compagnia? Forse. O semplicemente perché mi confonde il fatto che tu stia correndo in giro a sprecare il tuo tempo quando c'è del vero lavoro che potremmo fare.",shape=box,color=blue];
		1975 -> 1980;
	1976 [label="Un'ulteriore prova che questa cosa è frutto della tua immaginazione! Quale tipo di vero dio o \"anti-dio\" verrebbe mai sconfitto dalla \"gentilezza delle emozioni umane\"! Ah! ",shape=box,color=blue];
		1976 -> 1981;
	1977 [label="Update boolean RoatheUnloved2",color=orange];
		1977 -> 1982;
	1978 [label="Immagino che abbiamo ancora del lavoro da fare, come dici tu. Semplicemente non riesco a capire come cose così... infantili possano avere uno scopo. Ma d'altronde, eccomi qui, da questa parte, e tu sei quello con le chiavi dell'universo.",shape=box,color=blue];
		1978 -> 1983;
