		1882 -> 1883;
	1881 [label="Potrei stilare un elenco, ma temo che ci vorrebbe tutto il pomeriggio. No, le mie domande al riguardo si concentrano specificatamente su un argomento particolare. Almeno per oggi.",shape=box,color=blue];
