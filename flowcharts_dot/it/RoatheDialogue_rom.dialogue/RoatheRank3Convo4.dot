	j1990388149 [label="Check boolean RoatheUnloved1",color=orange];
		j1990388149 -> j1030881931 [label=true,color=green];
		j1990388149 -> j2872842611 [label=true,color=green];
		j1990388149 -> j4259742922 [label=true,color=green];
		j1990388149 -> j1030881931 [label=false,color=brown];
		j1990388149 -> j2872842611 [label=false,color=brown];
		j1990388149 -> j608971715 [label=false,color=brown];
	j2446375560 [label="Se pensi che sia una cosa da poco fare quello che faccio, certo. Questa è la tua opinione. Quello che ho fatto ha riscritto la storia.",shape=box,color=red];
		j2446375560 -> j3189532483;
	j3169987058 [label="Non piccolo. Invisibile. Lascia che gli altri corrano in giro ad attirare l'attenzione. Io resterò nell'ombra.",shape=box,color=red];
		j3169987058 -> j2031345033;
	j1030881931 [label="Perché aiutare le persone quando ne hanno bisogno è il modo in cui alla fine riusciremo ad uscirne.",shape=box,color=red];
		j1030881931 -> j3171249638;
	j2872842611 [label="Perché sto facendo ciò che deve essere fatto. Niente di più, niente di meno.",shape=box,color=red];
		j2872842611 -> j3280797186;
	j4259742922 [label="Hai detto che non hai mai saputo cosa significhi essere amati. Non credo che capirai quanto possa essere potente nel cambiare il modo in cui funziona il mondo intorno a te.",shape=box,color=red];
		j4259742922 -> j1040403427;
	j608971715 [label="Ti sei mai innamorato, Roathe? O ti sei mai interessato a qualcuno così tanto da bruciare l'universo per loro?",shape=box,color=red];
		j608971715 -> j179560413;
	j3189532483 [label="È proprio questo il punto! Andiamo a riscrivere la storia, allora! Non restiamo qui a cercare di convincere tutti a tenersi per mano e cantare canzoni!",shape=box,color=blue];
		j3189532483 -> j1973659017;
		j3189532483 -> j733158487;
		j3189532483 -> j3689628352;
	j2031345033 [label="Ah, capisco, preferisci essere l'assassino nell'ombra, vero? Colpire quando meno se l'aspettano? No. Non credo. Credo che tu stia solo girando a vuoto.",shape=box,color=blue];
		j2031345033 -> j322069821;
	j3171249638 [label="Mmh. Fare commissioni per degli sconosciuti finché non ti adorano come un eroe locale? O convincerli tutti a tenersi per mano e cantare canzoni? Scusa, vado a vomitare nella vasca di Fibonacci.",shape=box,color=blue];
		j3171249638 -> j4191911900;
		j3171249638 -> j655931089;
	j3280797186 [label="E quello che stai \"facendo\" sembrerebbe correre in giro convincendo tutti a tenersi per mano e cantare canzoni tra uno spettacolo e l'altro di incredibile violenza. La violenza ha senso. Il resto è nauseabondo. ",shape=box,color=blue];
		j3280797186 -> j4191911900;
		j3280797186 -> j655931089;
	j1040403427 [label="Se insisti nel dire che salveremo l'universo da questa \"Indifferenza\" tenendoci per mano e cantando canzoni, perdonami, ma vado a vomitare nella vasca di Fibonacci.",shape=box,color=blue];
		j1040403427 -> j296697327;
		j1040403427 -> j4191911900;
		j1040403427 -> j655931089;
	j179560413 [label="Boolean RoatheUnloved1 is now true.",color=orange];
		j179560413 -> j1696627205;
	j1973659017 [label="Sii paziente. Dobbiamo prima affrontare l'Indifferenza.",shape=box,color=red];
		j1973659017 -> j1820931634;
	j733158487 [label="Forse, una volta che tutto questo sarà passato. Ma non adesso.",shape=box,color=red];
		j733158487 -> j1899382041;
	j3689628352 [label="E pensi che sceglierei te per farlo? Non farmi ridere.",shape=box,color=red];
		j3689628352 -> j630201710;
	j322069821 [label="Non sai cosa fai o perché lo fai, stai semplicemente facendo quello che ti viene detto. Un altro tirapiedi presuntuoso di un Orokin arrogante. Vergogna.",shape=box,color=blue];
		j322069821 -> "Chat ends.";
	j4191911900 [label="Dico solo che sembri davvero arrabbiato all'idea che le persone non siano più infelici. E sembra che tu la prenda molto sul personale.",shape=box,color=red];
		j4191911900 -> j3634518297;
	j655931089 [label="Ciò che volevo dire è semplicemente che se 'l'Indifferenza' si nutre della mancanza di emozioni, averle potrebbe essere la chiave per sconfiggerla.",shape=box,color=red];
		j655931089 -> j1982717767;
	j296697327 [label="Pensi che sia impossibile per qualcuno amarti? O pensi di non essere capace di provare amore per qualcun altro? O pensi che semplicemente non sia ancora successo?",shape=box,color=red];
		j296697327 -> j382890388;
	j1696627205 [label="No, non l'ho fatto. E se insisti nel dire che salveremo l'universo da questa \"Indifferenza\" tenendoci per mano e cantando canzoni, perdonami, ma vado a vomitare nella vasca di Fibonacci.",shape=box,color=blue];
		j1696627205 -> j296697327;
		j1696627205 -> j4191911900;
		j1696627205 -> j655931089;
	j1820931634 [label="+5 Chemistry",color=orange];
		j1820931634 -> j1899382041;
	j1899382041 [label="Bene. Bene! Aspetterò il momento giusto, come dici tu. Gioca a questi... giochetti stupidi.",shape=box,color=blue];
		j1899382041 -> j264242252;
	j630201710 [label="Boolean RoatheInsulted is now true.",color=orange];
		j630201710 -> j1619497679;
	j3634518297 [label="Perché la miseria ama la compagnia? Forse. O semplicemente perché mi confonde il fatto che tu stia correndo in giro a sprecare il tuo tempo quando c'è del vero lavoro che potremmo fare.",shape=box,color=blue];
		j3634518297 -> j3075381021;
	j1982717767 [label="Un'ulteriore prova che questa cosa è frutto della tua immaginazione! Quale tipo di vero dio o \"anti-dio\" verrebbe mai sconfitto dalla \"gentilezza delle emozioni umane\"! Ah! ",shape=box,color=blue];
		j1982717767 -> j377788193;
	j382890388 [label="Boolean RoatheUnloved2 is now true.",color=orange];
		j382890388 -> j3993766339;
	j264242252 [label="Immagino che abbiamo ancora del lavoro da fare, come dici tu. Semplicemente non riesco a capire come cose così... infantili possano avere uno scopo. Ma d'altronde, eccomi qui, da questa parte, e tu sei quello con le chiavi dell'universo.",shape=box,color=blue];
		j264242252 -> j4236333275;
	j1619497679 [label="Giusto. Perché mai dovresti scegliere qualcuno di così detestabile come il Diavolo di Tau?",shape=box,color=blue];
		j1619497679 -> "Chat ends.";
	j3075381021 [label="Ma ora sono convinto che non sai cosa fai o perché lo fai, stai semplicemente facendo quello che ti viene detto. Un altro tirapiedi presuntuoso di un Orokin arrogante. Vergogna.",shape=box,color=blue];
		j3075381021 -> "Chat ends.";
