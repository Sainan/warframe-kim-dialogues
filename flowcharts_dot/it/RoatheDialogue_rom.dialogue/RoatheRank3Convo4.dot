	1889 [label="Check boolean IsDating",color=orange];
		1889 -> 1891 [label=true,color=green];
		1889 -> 1890 [label=false,color=brown];
	1891 [label="Sembra proprio che nel frattempo tu abbia i tuoi pruriti da grattarti - e ti applaudo per questo, non ti sto affatto giudicando. Mi sembra solo strano che una persona così... meravigliosamente e selvaggiamente sfacciata possa essere così obbediente. ",shape=box,color=blue];
		1891 -> 1892;
		1891 -> 1893;
		1891 -> 1894;
	1890 [label="Mi sembra solo strano che una persona così... meravigliosamente e selvaggiamente sfacciata possa essere così obbediente. ",shape=box,color=blue];
		1890 -> 1892;
		1890 -> 1893;
		1890 -> 1894;
	1892 [label="Lasciare che l'indifferenza distrugga il Sistema Origin - o qualsiasi altro posto - non aiuta nessuno.",shape=box,color=red];
		1892 -> 1895;
	1893 [label="Non obbedisco a Entrati.",shape=box,color=red];
		1893 -> 1896;
	1894 [label="Ho le mie ragioni. E sono solo mie.",shape=box,color=red];
		1894 -> 1897;
	1895 [label="Ah, capisco. È solo un servizio temporaneo che offri finché non verrà risolta la situazione con 'l'Indifferenza'. E cosa pensi di fare a quel punto?",shape=box,color=blue];
		1895 -> 1898;
		1895 -> 1899;
		1895 -> 1900;
		1895 -> 1901;
		1895 -> 1902;
	1896 [label="Davvero? Sembra proprio così, da dove sono seduto. Lui schiocca le dita e tu ti metti in ginocchio e ti siedi alle sue caviglie come un bravo kubrow addestrato. Lui sussurra persino il nome 'Tau' e voi tutti vi affannate a ricordare ogni possibile dettaglio sul posto che avete perso.",shape=box,color=blue];
		1896 -> 1903;
		1896 -> 1904;
	1897 [label="Così misterioso, così imperscrutabile! E un mucchio di stronzate da mandriano. Se non vuoi semplicemente ammettere di essere a sua completa disposizione, pazienza.",shape=box,color=blue];
		1897 -> 1905;
	1898 [label="Perché insisti su questo? Cosa stai cercando di chiedermi veramente?",shape=box,color=red];
		1898 -> 1906;
	1899 [label="A dire il vero, non ci ho pensato molto in anticipo.",shape=box,color=red];
		1899 -> 1907;
	1900 [label="Ho intenzione di fargliela pagare per aver combinato un simile disastro. Ha molto da espiare. ",shape=box,color=red];
		1900 -> 1908;
	1901 [label="Intendi, ammesso che sopravviva?",shape=box,color=red];
		1901 -> 1909;
	1902 [label="Vado dove c'è bisogno di me, come sempre. Sono i problemi a trovarmi.",shape=box,color=red];
		1902 -> 1910;
	1903 [label="Perché ti sforzi così tanto di farmi arrabbiare?",shape=box,color=red];
		1903 -> 1911;
	1904 [label="Faccio semplicemente ciò che devo fare per aiutare le persone a uscire dalle situazioni miseravili in cui si trovano.",shape=box,color=red];
		1904 -> 1912;
	1905 [label="Perché dove sono seduto, sembra che schiocchi le dita e tu ti metti in ginocchio e ti siedi alle sue caviglie come un bravo kubrow addestrato. Lui sussurra persino il nome 'Tau' e voi tutti vi affannate a ricordare ogni possibile dettaglio sul posto che avete perso.",shape=box,color=blue];
		1905 -> 1903;
		1905 -> 1904;
	1906 [label="+5 Chemistry",color=orange];
		1906 -> 1913;
	1907 [label="Ah! Quindi ammetti di essere un idiota! Che sollievo. Adoro quando gli idioti mettono in mostra la loro mancanza di arguzia, mi rende il compito di manipolarli ancora più facile.",shape=box,color=blue];
		1907 -> 1914;
	1908 [label="Ah! Quindi è una vendetta vile e primordiale quella che cerchi! Glorioso. Un animale rabbioso, pronto a rosicchiare le ossa di coloro che ti hanno fatto del male.",shape=box,color=blue];
		1908 -> 1915;
	1909 [label="+5 Chemistry",color=orange];
		1909 -> 1916;
	1910 [label="Ah, capisco. Apatia mascherata da nobiltà. Non sai dove stare, dove dovresti stare, quindi ti ricopri di questo \"sacrificio di giustizia\" e ti comporti come vogliono gli altri?",shape=box,color=blue];
		1910 -> 1917;
	1911 [label="Perché non riesco proprio a capire perché tu, un'entità che, per quanto ne so, proviene da un'altra versione della realtà, sia decisa a correre senza controllo attraverso il tempo e lo spazio, \"Giocando allo Psicologo\".",shape=box,color=blue];
		1911 -> 1918;
	1912 [label="Sì, e questo ci porta al nocciolo della questione! Perché insisti a vagare nel tempo e nello spazio 'Giocando allo Psicologo?' Tu che sei un'entità che, per quanto ne so, proviene da un'altra versione della realtà. ",shape=box,color=blue];
		1912 -> 1918;
	1913 [label="Astuto. Sì, molto bene, andrò al nocciolo della questione. Stavo cercando di provocarti e farti arrabbiare per vedere se questo ti avrebbe spinto a rispondere in modo più onesto.",shape=box,color=blue];
		1913 -> 1919;
	1914 [label="Sei come un kubrow che ha finalmente catturato un kaithe. Non sai cosa fare ora che gli hai morso la zampa.",shape=box,color=blue];
		1914 -> 1904;
		1914 -> 1903;
	1915 [label="Una delle motivazioni umane più semplici e antiche. E quindi, una delle più facili da comprendere.",shape=box,color=blue];
		1915 -> 1904;
	1916 [label="Non sono mai stato ufficialmente un soldato, eppure nel tuo tono sento la stanchezza del più temprato dalle battaglie.",shape=box,color=blue];
		1916 -> 1920;
	1917 [label="Davvero tragico.",shape=box,color=blue];
		1917 -> 1921;
		1917 -> 1922;
	1918 [label="Se fossi in te, tornerei a Duviri per scoprire quali altri buchi nel tessuto del Void potrei fare! Immagina le possibilità! Immagina i mondi, pronti per essere conquistati!",shape=box,color=blue];
		1918 -> 1923;
		1918 -> 1924;
	1919 [label="Ma suppongo che me lo farò bastare.",shape=box,color=blue];
		1919 -> 1925;
	1920 [label="Molto bene. Per rispetto, andrò subito al nocciolo della questione. Stavo cercando di provocarti e farti arrabbiare per vedere se questo ti avrebbe spinto a rispondere in modo più onesto.",shape=box,color=blue];
		1920 -> 1925;
	1921 [label="Ho un posto a cui appartengo.",shape=box,color=red];
		1921 -> 1926;
	1922 [label="Non so di cosa stai parlando.",shape=box,color=red];
		1922 -> 1927;
	1923 [label="Non sei diverso da Albrecht. Lui attraversa il tempo causando tutti questi problemi. E tu vuoi fare lo stesso a intere dimensioni?!",shape=box,color=red];
		1923 -> 1928;
	1924 [label="Questo è il problema di voi Orokin. Pensate che interi mondi siano solo vostri e che possiate farne ciò che volete. ",shape=box,color=red];
		1924 -> 1929;
	1925 [label="+5 Chemistry",color=orange];
		1925 -> 1930;
	1926 [label="Raccontalo! È questa Höllvania? O forse Duviri? O forse il tuo Orbiter precipitato su ciò che resta della Terra?",shape=box,color=blue];
		1926 -> 1904;
		1926 -> 1903;
	1927 [label="Allora raccontami dov'è casa tua! È questa Höllvania? O forse Duviri? O forse il tuo Orbiter precipitato su ciò che resta della Terra?",shape=box,color=blue];
		1927 -> 1904;
		1927 -> 1903;
	1928 [label="E perché non dovremmo? Siamo creature superiori, non è vero? Albrecht fa quello che vuole, e tu non hai problemi ad andare in giro a ripulire al suo passaggio! Perché non dovrei avere il diritto di fare lo stesso? Cosa rende la sua ricerca \"giustificata\" e la mia no?",shape=box,color=blue];
		1928 -> 1931;
	1929 [label="E perché non dovremmo? Siamo noi le creazioni superiori, no? Albrecht fa quello che vuole, imperversando nel tempo, infettando le masse con un malattia che a malapena comprende, tutto in nome della 'sconfitta di una cosiddetta divinità'.",shape=box,color=blue];
		1929 -> 1931;
	1930 [label="Non riesco proprio a capire perché tu, un'entità che, per quanto ne so, proviene da un'altra versione della realtà, sia decisa a correre senza controllo attraverso il tempo e lo spazio, \"Giocando allo Psicologo\".",shape=box,color=blue];
		1930 -> 1932;
