		1979 -> 1984;
	1980 [label="Ma ora sono convinto che non sai cosa fai o perché lo fai, stai semplicemente facendo quello che ti viene detto. Un altro tirapiedi presuntuoso di un Orokin arrogante. Vergogna.",shape=box,color=blue];
		1980 -> 1985;
