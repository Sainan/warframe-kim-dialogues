	j3136897973 [label="Check boolean LoidFamilyComplete",color=orange];
		j3136897973 -> "Chat ends." [label=true,color=green];
		j3136897973 -> j2308924270 [label=false,color=brown];
	j2308924270 [label="Ora, credo che potremmo passare alla prossima battaglia, vero? Il maggiordomo.",shape=box,color=blue];
		j2308924270 -> j170379408;
	j170379408 [label="Personalmente, non vedo l'ora.",shape=box,color=blue];
