digraph {
	5182 [label="RoatheRepair begins.",color=orange];
		5182 -> 5183;
	5183 [label="Evaluate expressions",color=orange];
		5183 -> 5185 [label="LyonRoatheFailFix, MarieRoatheFailFix",color=purple];
		5183 -> 5184 [label="false",color=purple];
	5185 [label="Basta! Basta. Mi arrendo! Richiama i tuoi fanatici. Sono peggio dei kubrodon rabbiosi! Creature maledette mi seguono ovunque vada. Non riesco nemmeno a dormire!",shape=box,color=blue];
		5185 -> 5186;
	5184 [label="Chat ends.",color=orange];
	5186 [label="Cosa?! Cosa vuoi?!",shape=box,color=blue];
		5186 -> 5188;
		5186 -> 5187;
		5186 -> 5189;
	5188 [label="Un'altra occasione per parlarti dell'assunzione del siero. Roathe, è ora di smettere di correre. ",shape=box,color=red];
		5188 -> 5191;
	5187 [label="Roathe. Aver preso il siero non ti rende un codardo. Ti rende l'unico Orokin ancora in piedi. Accettalo.",shape=box,color=red];
		5187 -> 5190;
	5189 [label="Roathe. Aver preso il siero non ti rende un codardo. Ti ha dato un'altra possibilità di vivere. Di fare davvero la differenza.",shape=box,color=red];
		5189 -> 5192;
	5191 [label="Evaluate expressions on Thermostat",color=orange];
		5191 -> 5195 [label="x >= 5",color=purple];
		5191 -> 5194 [label="x <= 0",color=purple];
		5191 -> 5193 [label="x > 0 && x < 5",color=purple];
		5191 -> 5193 [label="false",color=purple];
	5190 [label="Add -5 to Thermostat",color=orange];
		5190 -> 5191;
	5192 [label="Add 5 to Thermostat",color=orange];
		5192 -> 5191;
	5195 [label="Stai lasciando che quella rabbia ti distrugga dentro. Potresti usarla per combattere le persone che ancora oggi stanno distruggendo questo mondo. Qui. Ora.",shape=box,color=red];
		5195 -> 5198;
	5194 [label="La stai puntando contro te stesso. Dovresti puntarla contro il mondo che ti sta incolpando per aver fatto del tuo meglio per salvarlo dall'Impero Orokin.",shape=box,color=red];
		5194 -> 5197;
	5193 [label="È per questo che li hai convinti a tormentarmi giorno e notte? Per questo? Un ultimo disperato tentativo di convincermi ad ascoltare le tue patetiche argomentazioni?",shape=box,color=blue];
		5193 -> 5196;
	5198 [label="Non sei definito dal tuo passato, Roathe. Sei definito dal tuo futuro. E hai ancora un futuro da vivere, a differenza di tutti gli Orokin che morirono nella Notte dei Tamburi Naga.",shape=box,color=red];
		5198 -> 5201;
	5197 [label="Non sei definito dalle opinioni di chi ti circonda. O da ciò che pensano delle tue azioni. Sei definito solo da ciò che pensi di te stesso e delle tue scelte.",shape=box,color=red];
		5197 -> 5200;
	5196 [label="No.",shape=box,color=blue];
		5196 -> 5199;
	5201 [label="Questa è l'unica cosa che ti definisce, ora. Puoi cambiare. E puoi cambiare il mondo intorno a te. Credo che la mia unica domanda sia: ci proverai almeno?",shape=box,color=red];
		5201 -> 5204;
	5200 [label="E il fatto è che sei uno dei pochissimi Orokin che conosciamo sopravvissuti alla Notte dei Tamburi Naga. Dal mio punto di vista? È stata una ritirata strategica.",shape=box,color=red];
		5200 -> 5203;
	5199 [label="Il tuo fallimento è patetico. Non un volta, ma due.",shape=box,color=blue];
		5199 -> 5202;
	5204 [label="Credi di perdonarti e di andare avanti?",shape=box,color=red];
		5204 -> 5207;
	5203 [label="Niente di più. Niente di meno.",shape=box,color=red];
		5203 -> 5206;
	5202 [label="Non consiglio di candidarti a una carica publica.",shape=box,color=blue];
		5202 -> 5205;
	5207 [label="Update boolean RoatheRedeemed",color=orange];
		5207 -> 5209;
	5206 [label="Update boolean RoatheVillain",color=orange];
		5206 -> 5208;
	5205 [label="Chat ends.",color=orange];
	5209 [label="+20 Chemistry",color=orange];
		5209 -> 5211;
	5208 [label="+20 Chemistry",color=orange];
		5208 -> 5210;
	5211 [label="Perdonarmi per quello che ho fatto? E andare avanti? Mh.",shape=box,color=blue];
		5211 -> 5213;
	5210 [label="Una ritirata per vincere la guerra. Mh. ",shape=box,color=blue];
		5210 -> 5212;
	5213 [label="Anche se sono un po' scettico sulla tua riformulazione della situazione, sono... troppo tentato da questo nuovo futuro e da ciò che potrebbe significare per me resistergli, caro Drifter.",shape=box,color=blue];
		5213 -> 5215;
	5212 [label="Anche se sono... un pochino dubbioso sul fatto che tu abbia riformulato i tuoi eventi come una ritirata tattica, ammetto che sono... comunque a favore, caro Drifter.",shape=box,color=blue];
		5212 -> 5214;
	5215 [label="Questa 'nuova prospettiva' di vita. Molto bene. Ammetto e accetto la tua argomentazione. Per quanto tardiva, è stata comunque... efficace.",shape=box,color=blue];
		5215 -> 5216;
	5214 [label="Molto bene. Ammetto e accetto la tua argomentazione. Per quanto tardiva, è stata comunque... efficace.",shape=box,color=blue];
		5214 -> 5216;
	5216 [label="Lo apprezzo. Più di quanto tu possa immaginare.",shape=box,color=blue];
		5216 -> 5217;
	5217 [label="Update boolean RoatheFail",color=orange];
		5217 -> 5218;
	5218 [label="Update boolean RoatheFamilyFail",color=orange];
		5218 -> 5793;
	5793 [label="Update boolean RoatheFailStall",color=orange];
		5793 -> 5795;
	5795 [label="Check boolean LoidFamilyComplete",color=orange];
		5795 -> 5796 [label=true,color=green];
		5795 -> 5794 [label=false,color=brown];
	5796 [label="Chat ends.",color=orange];
	5794 [label="Ora, credo che potremmo passare alla prossima battaglia, vero? Il maggiordomo.",shape=box,color=blue];
		5794 -> 5797;
	5797 [label="Personalmente, non vedo l'ora.",shape=box,color=blue];
		5797 -> 5798;
	5798 [label="Update boolean RoatheFamilyDelay",color=orange];
		5798 -> 1702;
	1702 [label="Chat ends.",color=orange];
}