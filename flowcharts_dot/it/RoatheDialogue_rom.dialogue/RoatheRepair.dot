digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRepair begins." [color=orange];
		"RoatheRepair begins." -> j2688688654;
	j2688688654 [label="Evaluate expressions",color=orange];
		j2688688654 -> j975678714 [label="LyonRoatheFailFix, MarieRoatheFailFix",color=purple];
		j2688688654 -> "Chat ends." [label="false",color=purple];
	j975678714 [label="Basta! Basta. Mi arrendo! Richiama i tuoi fanatici. Sono peggio dei kubrodon rabbiosi! Creature maledette mi seguono ovunque vada. Non riesco nemmeno a dormire!",shape=box,color=blue];
		j975678714 -> j2046642842;
	"Chat ends." [color=orange];
	j2046642842 [label="Cosa?! Cosa vuoi?!",shape=box,color=blue];
		j2046642842 -> j2800474953;
		j2046642842 -> j952823450;
		j2046642842 -> j586245343;
	j2800474953 [label="Un'altra occasione per parlarti dell'assunzione del siero. Roathe, è ora di smettere di correre. ",shape=box,color=red];
		j2800474953 -> j1979205857;
	j952823450 [label="Roathe. Aver preso il siero non ti rende un codardo. Ti rende l'unico Orokin ancora in piedi. Accettalo.",shape=box,color=red];
		j952823450 -> j1420398166;
	j586245343 [label="Roathe. Aver preso il siero non ti rende un codardo. Ti ha dato un'altra possibilità di vivere. Di fare davvero la differenza.",shape=box,color=red];
		j586245343 -> j62611055;
	j1979205857 [label="Evaluate expressions on Thermostat counter",color=orange];
		j1979205857 -> j3223758194 [label="x >= 5",color=purple];
		j1979205857 -> j3903518856 [label="x <= 0",color=purple];
		j1979205857 -> j482303008 [label="x > 0 && x < 5",color=purple];
		j1979205857 -> j482303008 [label="false",color=purple];
	j1420398166 [label="Add -5 to Thermostat counter",color=orange];
		j1420398166 -> j1979205857;
	j62611055 [label="Add 5 to Thermostat counter",color=orange];
		j62611055 -> j1979205857;
	j3223758194 [label="Stai lasciando che quella rabbia ti distrugga dentro. Potresti usarla per combattere le persone che ancora oggi stanno distruggendo questo mondo. Qui. Ora.",shape=box,color=red];
		j3223758194 -> j2681511100;
	j3903518856 [label="La stai puntando contro te stesso. Dovresti puntarla contro il mondo che ti sta incolpando per aver fatto del tuo meglio per salvarlo dall'Impero Orokin.",shape=box,color=red];
		j3903518856 -> j1430950634;
	j482303008 [label="È per questo che li hai convinti a tormentarmi giorno e notte? Per questo? Un ultimo disperato tentativo di convincermi ad ascoltare le tue patetiche argomentazioni?",shape=box,color=blue];
		j482303008 -> j2411635014;
	j2681511100 [label="Non sei definito dal tuo passato, Roathe. Sei definito dal tuo futuro. E hai ancora un futuro da vivere, a differenza di tutti gli Orokin che morirono nella Notte dei Tamburi Naga.",shape=box,color=red];
		j2681511100 -> j2815982389;
	j1430950634 [label="Non sei definito dalle opinioni di chi ti circonda. O da ciò che pensano delle tue azioni. Sei definito solo da ciò che pensi di te stesso e delle tue scelte.",shape=box,color=red];
		j1430950634 -> j3717233511;
	j2411635014 [label="No.",shape=box,color=blue];
		j2411635014 -> j1032378465;
	j2815982389 [label="Questa è l'unica cosa che ti definisce, ora. Puoi cambiare. E puoi cambiare il mondo intorno a te. Credo che la mia unica domanda sia: ci proverai almeno?",shape=box,color=red];
		j2815982389 -> j1971085254;
	j3717233511 [label="E il fatto è che sei uno dei pochissimi Orokin che conosciamo sopravvissuti alla Notte dei Tamburi Naga. Dal mio punto di vista? È stata una ritirata strategica.",shape=box,color=red];
		j3717233511 -> j3964982402;
	j1032378465 [label="Il tuo fallimento è patetico. Non un volta, ma due.",shape=box,color=blue];
		j1032378465 -> j2613565532;
	j1971085254 [label="Credi di perdonarti e di andare avanti?",shape=box,color=red];
		j1971085254 -> j1179956483;
	j3964982402 [label="Niente di più. Niente di meno.",shape=box,color=red];
		j3964982402 -> j3661125095;
	j2613565532 [label="Non consiglio di candidarti a una carica publica.",shape=box,color=blue];
		j2613565532 -> "Chat ends.";
	j1179956483 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j1179956483 -> j2773405875;
	j3661125095 [label="Boolean RoatheVillain is now true.",color=orange];
		j3661125095 -> j1977395374;
	j2773405875 [label="+20 Chemistry",color=orange];
		j2773405875 -> j3082819370;
	j1977395374 [label="+20 Chemistry",color=orange];
		j1977395374 -> j1389053223;
	j3082819370 [label="Perdonarmi per quello che ho fatto? E andare avanti? Mh.",shape=box,color=blue];
		j3082819370 -> j701072633;
	j1389053223 [label="Una ritirata per vincere la guerra. Mh. ",shape=box,color=blue];
		j1389053223 -> j1245472302;
	j701072633 [label="Anche se sono un po' scettico sulla tua riformulazione della situazione, sono... troppo tentato da questo nuovo futuro e da ciò che potrebbe significare per me resistergli, caro Drifter.",shape=box,color=blue];
		j701072633 -> j957574670;
	j1245472302 [label="Anche se sono... un pochino dubbioso sul fatto che tu abbia riformulato i tuoi eventi come una ritirata tattica, ammetto che sono... comunque a favore, caro Drifter.",shape=box,color=blue];
		j1245472302 -> j2710066457;
	j957574670 [label="Questa 'nuova prospettiva' di vita. Molto bene. Ammetto e accetto la tua argomentazione. Per quanto tardiva, è stata comunque... efficace.",shape=box,color=blue];
		j957574670 -> j1143666795;
	j2710066457 [label="Molto bene. Ammetto e accetto la tua argomentazione. Per quanto tardiva, è stata comunque... efficace.",shape=box,color=blue];
		j2710066457 -> j1143666795;
	j1143666795 [label="Lo apprezzo. Più di quanto tu possa immaginare.",shape=box,color=blue];
		j1143666795 -> j757561088;
	j757561088 [label="Boolean RoatheFail is now false.",color=orange];
