digraph {
	"RoatheRank4Convo3 begins." [color=orange];
		"RoatheRank4Convo3 begins." -> j4094842598;
	j4094842598 [label="Risolvimi questo, Usurpatore: Se la situazione lo richiedesse, pensi che potresti sconfiggere la tua controparte Tenno in uno scontro all'ultimo sangue?",shape=box,color=blue];
		j4094842598 -> j866300329;
		j4094842598 -> j3620326797;
		j4094842598 -> j4115718638;
	j866300329 [label="Cosa? Perché...?",shape=box,color=red];
		j866300329 -> j1574482106;
	j3620326797 [label="Non ho intenzione di affrontare questa conversazione.",shape=box,color=red];
		j3620326797 -> j3560686596;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j1574482106 [label="Perché non so se l'hai notato, ma 'Lotus' non è solo Sentient - e responsabile di aver messo Lua nel Void, aggiungerei - ma ha anche perso in modo quantificabile il controllo dei suoi circuiti.",shape=box,color=blue];
		j1574482106 -> j3276229431;
		j1574482106 -> j3916455626;
		j1574482106 -> j861412560;
		j1574482106 -> j2316560856;
		j1574482106 -> j1025972316;
	j3560686596 [label="Non sto cercando di essere insensibile. Sono piuttosto serio, capisci. Questa è una conversazione puramente pragmatica. ",shape=box,color=blue];
		j3560686596 -> j1574482106;
	"Chat ends." [color=orange];
	j3276229431 [label="Sta bene. Non so di cosa tu stia parlando.",shape=box,color=red];
		j3276229431 -> j437728768;
	j3916455626 [label="Ha perso il controllo dei suoi circuiti? Cosa intendi?",shape=box,color=red];
		j3916455626 -> j3123655830;
	j861412560 [label="No. Non lo farò. Lotus mi ha salvato la vita. Ha salvato la vita dei Tenno innumerevoli volte. Le dobbiamo tutto.",shape=box,color=red];
		j861412560 -> j3737432360;
	j2316560856 [label="Zitto Roathe, non lo farò. [Fine.]",shape=box,color=red];
		j2316560856 -> j2023543545;
	j1025972316 [label="Lo so, sono preoccupato anch'io. Ma ha fatto così tanto per noi, e non posso voltarle le spalle. Devo sostenerla.",shape=box,color=red];
		j1025972316 -> j643708217;
	j437728768 [label="A no? Fai attenzione! Guardati intorno! Quanti mesi ha passato in piedi sul bordo del dirupo, con in mano un cercapersone antiquato, canticchiando tra sé e sé? Con lo sguardo perso nel Void?",shape=box,color=blue];
		j437728768 -> j1989233078;
	j3123655830 [label="Quanti mesi ha passato in piedi sul bordo del dirupo, con in mano un cercapersone antiquato, canticchiando tra sé e sé? Con lo sguardo perso nel Void?",shape=box,color=blue];
		j3123655830 -> j1989233078;
	j3737432360 [label="Non sono insensibile. Capisco cosa si prova. Le devi molto. Non ti sto dicendo di ucciderla, ti sto dicendo di smetterla di permetterle di influenzare chi ti circorda.",shape=box,color=blue];
		j3737432360 -> j3123655830;
	j2023543545 [label="Come desideri. Ma quando tutto questo ti crollerà addosso? Non venire da me a cercare aiuto strisciando.",shape=box,color=blue];
		j2023543545 -> "Chat ends.";
	j643708217 [label="+5 Chemistry",color=orange];
		j643708217 -> j4157433913;
	j1989233078 [label="E ora lei è solo... incombente? Nell'oscurità? Sta spingendo il tuo io bambino sempre più in profondità nei suoi ricordi, per cosa? Per tornare a casa semplicemente perché Albrecht ha schiocchiato le dita e sussurrato la parola magica?",shape=box,color=blue];
		j1989233078 -> j2704837683;
	j4157433913 [label="Non sono insensibile. Capisco cosa si prova. Le devi molto. Non ti sto dicendo di ucciderla, ti sto dicendo di smetterla di permetterle di influenzare chi ti circorda.",shape=box,color=blue];
		j4157433913 -> j1777377961;
	j2704837683 [label="Non lo trovi sospettoso? Non lo trovi pericoloso? È una trappola. È manipolata. O da Albrecht o da questa cosiddetta 'Indifferenza.' È un programma difettoso. I suoi precetti non funzionano correttamente.",shape=box,color=blue];
		j2704837683 -> j1352271482;
	j1777377961 [label="Quando se ne stava lì, in piedi sul bordo del dirupo, con un cercapersone antiquato in mano, canticchiando tra sé e sé? Con lo sguardo perso nel Void? Non hai pensato che potesse saltare?",shape=box,color=blue];
		j1777377961 -> j1989233078;
	j1352271482 [label="Non credo che voglia farti del male. Credo che la stiano solo usando. Ma quando arriverà il momento, potresti dover difenderti. O forse dovrai metterli a tacere.",shape=box,color=blue];
		j1352271482 -> j1719709687;
	j1719709687 [label="E mentre è (spero) probabile che capirai il senso di evitare che una sorta di secondo round di Lotus che diventa problematica, il suo esercito di ragazzini selvaggi non lo capirà. Quindi chiedo di nuovo:",shape=box,color=blue];
		j1719709687 -> j2483001708;
	j2483001708 [label="Chi pensi che vincerebbe se arrivasse il terribile giorno e dovessi combattere con tutte le sue risorse? Tu e tutto ciò che hai, contro tutti i Tenno e Lotus?",shape=box,color=blue];
		j2483001708 -> j3112755005;
		j2483001708 -> j444066208;
		j2483001708 -> j4149738696;
	j3112755005 [label="È assurdo. No.",shape=box,color=red];
		j3112755005 -> j2040447694;
	j444066208 [label="Ce ne sono tipo... non saprei, un centinaio. E io sono uno solo, Roathe.",shape=box,color=red];
		j444066208 -> j1402259051;
	j4149738696 [label="Non so nemmeno da dove cominciare.",shape=box,color=red];
		j4149738696 -> j1519885203;
	j2040447694 [label="Consideralo un gioco sciocco, se proprio devi! Un gioco teorico giocato da ragazzini. ",shape=box,color=blue];
		j2040447694 -> j2037876579;
		j2040447694 -> j58947237;
	j1402259051 [label="+5 Chemistry",color=orange];
		j1402259051 -> j816143154;
	j1519885203 [label="Allora è un'ottima cosa che tu stia parlando con il 'Diavolo di Tau'. C'è un motivo per cui sono conosciuto come uno stratega. Cominciamo dall'inizio: Numeri. Sei terribilmente surclassato in quel campo. ",shape=box,color=blue];
		j1519885203 -> j4181059854;
	j2037876579 [label="Questo non è un gioco.",shape=box,color=red];
		j2037876579 -> j1388142893;
	j58947237 [label="Per l'ultima volta? No. [Fine.]",shape=box,color=red];
		j58947237 -> "Chat ends.";
	j816143154 [label="Perfetto. Abbiamo stabilito la prima regola per la preparazione del campo di battaglia: i numeri. Ovviamente, sei terribilmente surclassato.",shape=box,color=blue];
		j816143154 -> j4181059854;
	j4181059854 [label="Check boolean IsDating",color=orange];
		j4181059854 -> j3079510647 [label=true,color=green];
		j4181059854 -> j931162432 [label=false,color=brown];
	j1388142893 [label="Hai ragione. Non lo è. E un giorno potrebbe trattarsi di una questione di vita o di morte. Tu contro la tua piccola... miniatura. E il suo branco di compagni selvaggi.",shape=box,color=blue];
		j1388142893 -> j831597026;
	j3079510647 [label="Tuttavia, se le voci sulle tue 'attività personali' e sui tuoi amanti protoframe di altre linee temporali potessero essere... sfruttate, forse quelle risorse potrebbero essere evocate in qualche modo. Gli Helminth dovranno essere appositamente studiati e allevati a questo scopo...",shape=box,color=blue];
		j3079510647 -> j4136716209;
	j931162432 [label="Ho sentito parlare delle tue interazioni con altri protoframe in altre linee temporali. Forse quelle risorse potrebbero essere sfruttate in qualche modo. Gli Helminth dovranno essere studiati e allevati specificamente per questo scopo...",shape=box,color=blue];
		j931162432 -> j4136716209;
	j831597026 [label="Compagni selvaggi che, tra l'altro, hanno già dimostrato di essere violenti, indisciplinati e sono noti per aver crudelmente emarginato i propri simili perché si discostavano troppo dalle loro opinioni sulla normalità.",shape=box,color=blue];
		j831597026 -> j941854935;
		j831597026 -> j3501495641;
		j831597026 -> j4209618461;
	j4136716209 [label="Non so nemmeno se sia possibile, ma ci ha permesso di arrivare fin qui, quindi non vedo perché no...",shape=box,color=blue];
		j4136716209 -> j2501354331;
		j4136716209 -> j444680052;
		j4136716209 -> j3827129065;
	j941854935 [label="Adesso stai insinuando che i Tenno siano malvagi?",shape=box,color=red];
		j941854935 -> j4137181587;
	j3501495641 [label="Cosa stai dicendo?",shape=box,color=red];
		j3501495641 -> j1484558915;
	j4209618461 [label="No. Basta così. [Fine.]",shape=box,color=red];
		j4209618461 -> j817796998;
	j2501354331 [label="Roathe? Vai all'inferno.",shape=box,color=red];
		j2501354331 -> j101687008;
	j444680052 [label="Non ho intenzione di cacciare anche loro in questo disastro.",shape=box,color=red];
		j444680052 -> j1555333062;
	j3827129065 [label="Mi allarma la riflessione che hai dedicato a questa cosa.",shape=box,color=red];
		j3827129065 -> j4242713799;
	j4137181587 [label="No, non malvagi. Non credo nella 'malvagità', Usurpatore. Non ci ho mai creduto e non ci crederò mai. Credo che i Tenno siano meravigliosamente umani, come tutti. Semplicemente umani. E poi? Sono ragazzini.",shape=box,color=blue];
		j4137181587 -> j3973509971;
	j1484558915 [label="Che possa arrivare il momento, un giorno terribile, in cui dovrai essere pronto a fare l'impensabile.",shape=box,color=blue];
		j1484558915 -> j3483223719;
	j817796998 [label="Puoi anche scappare da questa conversazione, se vuoi, ma sai che ogni parola è la verità. Semplicemente non vuoi accettarla.",shape=box,color=blue];
		j817796998 -> "Chat ends.";
	j101687008 [label="+5 Chemistry",color=orange];
		j101687008 -> j1655893393;
	j1555333062 [label="Ah! Quindi ammetti che sia un disatro. Questo è progresso. Posso almeno esporre la mia tesi?",shape=box,color=blue];
		j1555333062 -> j1524421010;
		j1555333062 -> j3042374005;
	j4242713799 [label="E sono allarmato da quanto chiaramente non l'hai fatto. Posso almeno esporre la mia tesi?",shape=box,color=blue];
		j4242713799 -> j1524421010;
		j4242713799 -> j3042374005;
	j3973509971 [label="Ragazzini che sono stati incaricati di affrontare orrori e commettere atrocità simili a quelle che ho visto spezzare guerrieri Orokin cresciuti e temprati, la cui vita ha attraversato centinaia di anni.",shape=box,color=blue];
		j3973509971 -> j1593143910;
	j3483223719 [label="I Tenno sono meravigliosamente umani, come tutti. Semplicemente umani. E poi? Sono ragazzini.",shape=box,color=blue];
		j3483223719 -> j3973509971;
	j1655893393 [label="Sono già lì, Usurpatore. Sono già lì.",shape=box,color=blue];
		j1655893393 -> j155006797;
	j1524421010 [label="Ok. Certo. Vai avanti. Ti ascolto.",shape=box,color=red];
		j1524421010 -> j3110893091;
	j3042374005 [label="No. Basta così.",shape=box,color=red];
		j3042374005 -> j2000442102;
	j1593143910 [label="Ho visto Dax - Dax dorati, d'élite! - gettare le loro sacre spade dorate e fuggire dal campo di battaglia in cui i Tenno si erano lanciati con i loro Warframe.",shape=box,color=blue];
		j1593143910 -> j1600213281;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j3110893091 [label="+5 Chemistry",color=orange];
		j3110893091 -> j3716144124;
	j2000442102 [label="Va bene, chiudiamola qui.",shape=box,color=blue];
		j2000442102 -> "Chat ends.";
	j1600213281 [label="Il loro bozzolo di rifugio Infested proteggeva i loro corpi, ma non le loro menti. Non sono loro i responsabili del loro stato d'animo.",shape=box,color=blue];
		j1600213281 -> j2427031401;
	j3716144124 [label="Grazie. Che possa arrivare il momento, un giorno terribile, in cui dovrai essere pronto a fare l'impensabile.",shape=box,color=blue];
		j3716144124 -> j3483223719;
	j2427031401 [label="Tormentati dal Void... forzati a uccidere e ad assistere alla morte dei propri genitori... forzati alla guerra... con i ricordi rubati... persi nel criosonno per secoli...",shape=box,color=blue];
		j2427031401 -> j2949973910;
	j2949973910 [label="Che non siano dei pazzi scatenati è un miracolo, Usurpatore. Non sto dicendo che andrà male. Dico solo che potrebbe andare male. E che devi avere un piano pronto nel caso in cui quel giorno dovesse arrivare.",shape=box,color=blue];
		j2949973910 -> j2895083937;
	j2895083937 [label="Non c'è niente di male nell'essere preparati al peggio. Il male del mondo è nel non esserlo.",shape=box,color=blue];
		j2895083937 -> j3096875180;
		j2895083937 -> j1381965193;
		j2895083937 -> j751888364;
		j2895083937 -> j1278658249;
	j3096875180 [label="Io... terrò d'occhio la situazione. Ok? Ma non agirò alle spalle di nessuno.",shape=box,color=red];
		j3096875180 -> j2760921441;
	j1381965193 [label="Mi dispiace davvero tanto essere in un certo senso d'accordo con te su questo punto.",shape=box,color=red];
		j1381965193 -> j38158549;
	j751888364 [label="Ti rendi conto che ho sofferto tanto quanto i Tenno, vero?",shape=box,color=red];
		j751888364 -> j601491343;
	j1278658249 [label="Non tradirò la loro fiducia.",shape=box,color=red];
		j1278658249 -> j2023775712;
	j2760921441 [label="+5 Chemistry",color=orange];
		j2760921441 -> j508248503;
	j38158549 [label="+5 Chemistry",color=orange];
		j38158549 -> j1286244316;
	j601491343 [label="E chi può dire che non sto avendo le stesse conversazioni con loro, mh?",shape=box,color=blue];
		j601491343 -> j2547003884;
	j2023775712 [label="Né ti stavo suggerendo di fare diversamente.",shape=box,color=blue];
		j2023775712 -> j346357367;
	j508248503 [label="Certo! È tutto quello che un diavolo potrebbe chiedere, grazie.",shape=box,color=blue];
		j508248503 -> j346357367;
	j1286244316 [label="Mm. È solo la sensazione della sanità mentale che sta tornando al tuo cervello dopo tutti questi anni. Ti ci abituerai.",shape=box,color=blue];
		j1286244316 -> j321621700;
	j2547003884 [label="Dormi bene, Usurpatore. ",shape=box,color=blue];
		j2547003884 -> j321621700;
