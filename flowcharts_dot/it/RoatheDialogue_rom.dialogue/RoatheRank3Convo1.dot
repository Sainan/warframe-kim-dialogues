digraph {
	1333 [label="RoatheRank3Convo1 begins.",color=orange];
		1333 -> 1334;
	1334 [label="Stai finalmente parlando con il nostro caro Lyon? O è ancora freddo nei tuoi confronti? Onestamente, forse faresti meglio a mantenere una distanza di sicurezza.",shape=box,color=blue];
		1334 -> 1337;
		1334 -> 1336;
		1334 -> 1335;
	1337 [label="Non vai d'accordo con lui?",shape=box,color=red];
		1337 -> 1340;
	1336 [label="Se fossi un po' più gentile con Marie e Lyon, potrebbero essere più gentili con te.",shape=box,color=red];
		1336 -> 1339;
	1335 [label="[Fine.]",shape=box,color=red];
		1335 -> 1338;
	1340 [label="Andrei più d'accordo con lui se si sforzasse a capire chi sono e da dove provengo. Io sono quello che sono. E lo sono da molti secoli. Non mi aspetto di cambiare solo perché me lo chiedono.",shape=box,color=blue];
		1340 -> 1341;
	1339 [label="E che dire della loro gentilezza nei miei confronti, Usurpatore? Io sono quello che sono. E lo sono da molti secoli. Non mi aspetto di cambiare solo perché me lo chiedono.",shape=box,color=blue];
		1339 -> 1341;
	1338 [label="Chat ends.",color=orange];
	1341 [label="Evaluate expressions on HellStory",color=orange];
		1341 -> 1343 [label="x >= 21",color=purple];
		1341 -> 1342 [label="x < 21",color=purple];
		1341 -> 1342 [label="false",color=purple];
	1343 [label="Potrò anche aver preso quel siero di mia spontanea volontà - ma so che non mi sono arreso per essere importunato a tutte le ore da quei due ingrati.  ",shape=box,color=blue];
		1343 -> 1344;
	1342 [label="È colpa di Albrecht se sono così! È colpa sua se sono intrappolato qui con loro, non mia! Non ho niente a che fare con questo orribile accordo!",shape=box,color=blue];
		1342 -> 1344;
	1344 [label="Possono presentare le loro lamentele al loro prezioso \"Cardinal\", non a me.",shape=box,color=blue];
		1344 -> 1345;
		1344 -> 1346;
		1344 -> 1347;
	1345 [label="Hanno buone intezioni, anche se non lo fanno nel modo migliore.",shape=box,color=red];
		1345 -> 1348;
	1346 [label="Non senti il bisogno di essere perdonato per le cose che hai fatto?",shape=box,color=red];
		1346 -> 1349;
	1347 [label="Stanno solo cercando di aiutarti.",shape=box,color=red];
		1347 -> 1350;
	1348 [label="Add -1 to Thermostat",color=orange];
		1348 -> 1351;
	1349 [label="Add 1 to Thermostat",color=orange];
		1349 -> 1352;
	1350 [label="\"Aiuto\". Sì. \"Aiuto\". Scusa se trovo il loro stile di \"aiuto\" profondamente \"inutile\".",shape=box,color=blue];
		1350 -> 1353;
	1351 [label="Sì, questa è la tragedia di tutto questo. Credono sinceramente di cercare di fare del \"bene\".",shape=box,color=blue];
		1351 -> 1354;
	1352 [label="Perdonato da chi? Da te? Da loro? Dal maggiordomo? Da Albrecht? O \"dagli dei\"?",shape=box,color=blue];
		1352 -> 1355;
		1352 -> 1356;
		1352 -> 1357;
	1353 [label="In effetti, troverei più \"utile\" se sostituissero il mio vino con un astringente caustico, Usurpatore.",shape=box,color=blue];
		1353 -> 1358;
	1354 [label="E tu cosa ne pensi? Pensi che io abbia bisogno di una \"grande redenzione\"? Di un \"santo perdono\"?",shape=box,color=blue];
		1354 -> 1359;
	1355 [label="Stai tralasciando un punto importante da quell'elenco.",shape=box,color=red];
		1355 -> 1360;
	1356 [label="Sei un Orokin. Hai commesso atrocità in guerra e per la natura della tua società. Hai molto da espiare.",shape=box,color=red];
		1356 -> 1361;
	1357 [label="Non riconosci almeno di aver fatto cose terribili nella tua vita?",shape=box,color=red];
		1357 -> 1362;
	1358 [label="Sarebbe più efficiente.",shape=box,color=blue];
		1358 -> 1363;
	1359 [label="Evaluate expressions",color=orange];
		1359 -> 1364 [label="RoatheTraitor2",color=purple];
		1359 -> 1365 [label="RoatheTraitor2",color=purple];
		1359 -> 1366 [label="RoatheTraitor2",color=purple];
		1359 -> 1367 [label="RoatheTraitor2",color=purple];
		1359 -> 1364 [label="RoatheTraitor1",color=purple];
		1359 -> 1365 [label="RoatheTraitor1",color=purple];
		1359 -> 1366 [label="RoatheTraitor1",color=purple];
		1359 -> 1367 [label="RoatheTraitor1",color=purple];
		1359 -> 1364 [label="RoatheExecutor2",color=purple];
		1359 -> 1365 [label="RoatheExecutor2",color=purple];
		1359 -> 1366 [label="RoatheExecutor2",color=purple];
		1359 -> 1367 [label="RoatheExecutor2",color=purple];
		1359 -> 1364 [label="false",color=purple];
		1359 -> 1365 [label="false",color=purple];
		1359 -> 1366 [label="false",color=purple];
	1360 [label="Ti prego, dimmelo. ",shape=box,color=blue];
		1360 -> 1368;
		1360 -> 1369;
		1360 -> 1370;
	1361 [label="Non mi scuserò per la società Orokin, perché non ne sono stato il creatore. Ne ero solo un abitante. E se dovessi incolpare tutti coloro che prendono parte a un sistema in cui sono colpevoli solamente di esserci nati, condanneresti miliardi di persone nella tua altezzosa ipocrisia. E per quanto riguarda il resto?",shape=box,color=blue];
		1361 -> 1371;
	1362 [label="E se l'avessi fatto? Non le posso cambiare ora. Che senso ha sentirsi in colpa?",shape=box,color=blue];
		1362 -> 1372;
		1362 -> 1373;
	1363 [label="Anche se, tra i due, preferisco il prete, devo ammetterlo. Lui ascolta la ragione. Potrebbe anche arrivare alla conclusione che l'Indifferenza non sia una vera divinità.",shape=box,color=blue];
		1363 -> 1374;
	1364 [label="Penso che valga la pena riflettere sulle nostre azioni che hanno danneggiato le persone e cercare di capire come rimediare. Ma non credo che quei due stiano affrontando la questione nel modo giusto.",shape=box,color=red];
		1364 -> 1375;
	1365 [label="Non credo che alla fine sia necessario perdonare nessuno tranne se stessi. Se ti senti a tuo agio con le azioni che hai commesso? Allora tanto meglio.",shape=box,color=red];
		1365 -> 1376;
	1366 [label="Sei nato in una società in cui molti comportamenti Orokin erano semplicemente... normali. Attesi. Non erano \"sbagliati\" per te. Non sto dicendo che questo li renda accettabili, solo comprensibili.",shape=box,color=red];
		1366 -> 1377;
	1367 [label="Avevi intenzione di spodestare gli Orokin. Sapevi che erano corrotti e stavi cercando di sistemarli.",shape=box,color=red];
		1367 -> 1378;
	1368 [label="Te stesso.",shape=box,color=red];
		1368 -> 1379;
	1369 [label="La tua stessa gente che stavi per tradire.",shape=box,color=red];
		1369 -> 1380;
	1370 [label="I Sentient che hai massacrato.",shape=box,color=red];
		1370 -> 1371;
	1371 [label="Era guerra. Ed è nella natura della guerra uccidere in gran numero coloro contro cui si combatte. Piangi per i Grineer o per i \"Corpus\" che uccidi?",shape=box,color=blue];
		1371 -> 1381;
		1371 -> 1382;
		1371 -> 1383;
	1372 [label="Il perdono degli altri è importante.",shape=box,color=red];
		1372 -> 1384;
	1373 [label="Puoi cambiare il tuo comportamento in futuro.",shape=box,color=red];
		1373 -> 1385;
	1374 [label="Anzi, potrei anche convincerlo a vedere attraverso tutta la sua religione - pensa un po'. Un uomo che vede allucinazioni fantasiose e sanguinose, ma anche buon senso e logica. Che rarità.",shape=box,color=blue];
		1374 -> 1386;
		1374 -> 1387;
	1375 [label="Mm. Capisco. Non è l'azione, ma la metodologia a cui ti opponi. Con questo ritiro la mia precedente approvazione e la sostituisco con costernazione.",shape=box,color=blue];
		1375 -> 1388;
	1376 [label="Update boolean RoatheVillainSelf",color=orange];
		1376 -> 1389;
	1377 [label="Update boolean RoatheVillainOrokin",color=orange];
		1377 -> 1389;
	1378 [label="Quindi penso anche che avessi l'intenzione di rimodellarlo a tua immagine? Sapevi che doveva cambiare.",shape=box,color=red];
		1378 -> 1390;
		1378 -> 1391;
	1379 [label="Check boolean RoatheKnowsReset2",color=orange];
		1379 -> 1392 [label=true,color=green];
		1379 -> 1393 [label=false,color=brown];
	1380 [label="Non ho mai perso una notte di sonno a causa del senso di colpa per aver tradito il mio popolo, Usurpatore. Credimi.",shape=box,color=blue];
		1380 -> 1394;
	1381 [label="No. Ma i Sentient sono un'altra storia.",shape=box,color=red];
		1381 -> 1395;
	1382 [label="Sì. Lo faccio.",shape=box,color=red];
		1382 -> 1396;
	1383 [label="Come mi sento riguardo alle vite che devo togliere sono affari miei. Stiamo parlando di te.",shape=box,color=red];
		1383 -> 1397;
	1384 [label="Perché? Per lasciarmi in pace? Per non essere una specie di... anatema? Una paria sociale? ",shape=box,color=blue];
		1384 -> 1398;
	1385 [label="Imparare dai propri errori è fondamentale, certo. Ma non è necessario \"sentirsi in colpa\" per comprendere il \"fallimento\".",shape=box,color=blue];
		1385 -> 1399;
	1386 [label="Sembra che Lyon stia già affrontando abbastanza problemi, non credi?",shape=box,color=red];
		1386 -> 1400;
	1387 [label="Perdonami, stai facendo cosa?",shape=box,color=red];
		1387 -> 1401;
	1388 [label="Chat ends.",color=orange];
	1389 [label="Il tuo contesto era diverso dal nostro. E ciò che noi consideriamo crudere e terribile, tu sei stato cresciuto vedendolo solo come un'altra parte di come funziona il mondo.",shape=box,color=red];
		1389 -> 1402;
	1390 [label="Questo non giustifica tutto quello che hai fatto - le tragedie sono tragedie e gli orrori sono orrori. Ma ci stavi provando.",shape=box,color=red];
		1390 -> 1403;
	1391 [label="Dal mio punto di vista, eri in guerra e cercavi di destreggiarti in una società di sociopatici, pianificando al contempo di spodestarla. E per questo ti hanno eticchettato come un diavolo. Non credo sia giusto.",shape=box,color=red];
		1391 -> 1404;
	1392 [label="Per essere fuggito.",shape=box,color=red];
		1392 -> 1405;
	1393 [label="Per aver fallito.",shape=box,color=red];
		1393 -> 1405;
	1394 [label="Non chiederò perdono per l'Impero Orokin, poiché non ne sono il creatore, ma solo un suo abitante. Ma non mi assumerò nemmeno la colpa per aver pianificato di distruggerlo intorno a me. Ci meritavamo quello che abbiamo ricevuto, e anche di peggio.",shape=box,color=blue];
		1394 -> 1406;
	1395 [label="Ogni situazione è una \"situazione diversa\", Usurpatore. Il contesto è sempre fondamentale. E tu stai semplicemente guardando alla \"Vecchia Guerra\" con la lucidità del senno di poi.",shape=box,color=blue];
		1395 -> 1407;
	1396 [label="Allora provo un'immensa pietà per te, Usurpatore, e ti suggerisco di accettare il compito che ti è stato assegnato, oppure di ritirarti da questa vita e dedicarti all'agricoltura.",shape=box,color=blue];
		1396 -> 1408;
	1397 [label="Mm. Adoro quando mostri così chiaramente che ho premuto i tuoi pulsanti, è così meravigliosamente delizioso. Eludi malamente la conversazione.",shape=box,color=blue];
		1397 -> 1409;
	1398 [label="Guardami, Usurpatore. Guarda cosa sono. Un Orokin, rimosso dal suo impero.",shape=box,color=blue];
		1398 -> 1410;
	1399 [label="E qual è il senso del perdono alla fine? Da chi dovrei cercare il perdono? Da altri? Per non essere una sorta di anatema?",shape=box,color=blue];
		1399 -> 1398;
	1400 [label="Ed è proprio questo che cercavo di fare per aiutarlo! Sto solo cercando di aiutarlo a superare parte della sua incertezza riguardo l'Indifferenza e ciò che Entrati gli ha detto.",shape=box,color=blue];
		1400 -> 1411;
	1401 [label="Assolutamente niente di male, indipendentemente da ciò che il fastidioso moscerino svolazzante potrebbe darti. Sto solo cercando di aiutarlo a superare parte della sua incertezza riguardo a ciò che gli ha detto l'Indifferenza e ciò che gli ha detto Entrati.",shape=box,color=blue];
		1401 -> 1411;
	1402 [label="+10 Chemistry",color=orange];
		1402 -> 1412;
	1403 [label="Update boolean RoatheVillainOrokin",color=orange];
		1403 -> 1402;
	1404 [label="Update boolean RoatheVillainShortcut",color=orange];
		1404 -> 1413;
	1405 [label="Update boolean RoatheForgivenessShortcut",color=orange];
		1405 -> 1414;
	1406 [label="Se c'è una cosa per cui mi sento in colpa? È che sono stati i Tenno a bruciare tutto, e non io.",shape=box,color=blue];
		1406 -> 1415;
	1407 [label="Se dovessi giudicare le azioni passate di tutte le persone con tutte le informazioni che hai sul futuro, ti ritrovereti incessantemente mortificato.",shape=box,color=blue];
		1407 -> 1416;
	1408 [label="Anche se sarebbe un peccato. È davvero divertente vederti lavorare. Non particolarmente efficiente - ma meravigliosamente appariscente.",shape=box,color=blue];
		1408 -> 1417;
	1409 [label="Anche se immagino che passare secoli da soli, senza nessuno con cui parlare se non con le creazioni inventate della propria mente da favola, limiti le proprie possibilità di affinare le proprie armi sociali.",shape=box,color=blue];
		1409 -> 1418;
	1410 [label="Ai miei tempi ero \"il Diavolo di Tau\". E ora sono già \"il diavolo\" per tutti coloro che mi incontrano.",shape=box,color=blue];
		1410 -> 1419;
	1411 [label="Entrati gli ha detto che le sue \"visioni\" non erano frutto di Lua, ma dell'Indifferenza. Questo lo sta portando a una sorta di \"crisi di fede\".",shape=box,color=blue];
		1411 -> 1420;
	1412 [label="Che bello sapere che il concetto di sfumatura e sottigliezza non è poi così morto. Sì, hai perfettamente ragione. Sono il prodotto di un altro tempo, di un'altra epoca, di un'altra società.",shape=box,color=blue];
		1412 -> 1421;
	1413 [label="+20 Chemistry",color=orange];
		1413 -> 1422;
	1414 [label="+10 Chemistry",color=orange];
		1414 -> 1423;
	1415 [label="Update boolean RoatheForgivenessNoGuilt",color=orange];
		1415 -> 1424;
	1416 [label="Accetta ciò che è accaduto in passato e vai avanti.",shape=box,color=blue];
		1416 -> 1425;
	1417 [label="Se non altro, rendi il cambo di battaglia \"divertente\". ",shape=box,color=blue];
		1417 -> 1425;
	1418 [label="Allenati con il Prete, avete entrambi bisogno di fare pratica. ",shape=box,color=blue];
		1418 -> 1426;
	1419 [label="Albrecht ritenne opportuno che il soprannome fosse permanente. ",shape=box,color=blue];
		1419 -> 1425;
	1420 [label="Tuttavia, sto cercando di convincerlo che non è così e che nessuno dei due 'dei' li ha mandati, poiché non esistono 'dei'. Lui semplicemente non sta bene.",shape=box,color=blue];
		1420 -> 1427;
		1420 -> 1428;
	1421 [label="Tuttavia, potevo riconoscere la crudeltà e le trasgressioni della mia gente per quello che erano. C'erano livelli di bassezza a cui molti della mia specie si lasciavano andare che nemmeno io riuscivo a digerire.",shape=box,color=blue];
		1421 -> 1429;
	1422 [label="Sapevo che mi piacevi per un motivo, Usurpatore. Finalmente! Qualcuno che mi apprezza! Ci sono voluti... quanti secoli?!",shape=box,color=blue];
		1422 -> 1430;
	1423 [label="Chat ends.",color=orange];
	1424 [label="+10 Chemistry",color=orange];
		1424 -> 1431;
	1425 [label="Ecco il mio consiglio: uccidi ogni senso di colpa nel tuo cuore per le tue azioni, come ho fatto io. Conficcagli una lama nel petto finché non è morto.",shape=box,color=blue];
		1425 -> 1432;
	1426 [label="+5 Chemistry",color=orange];
		1426 -> 1433;
	1427 [label="Lyon vuole il tuo aiuto?",shape=box,color=red];
		1427 -> 1434;
	1428 [label="E pensi che questo migliori le cose per lui?",shape=box,color=red];
		1428 -> 1435;
	1429 [label="Ma queste questioni sono... complesse. E apprezzo che tu te ne accorga. Bah. Il maggiordomo mi sta lanciando un'occhiata. Devo uscire da questa conversazione. Ci sentiamo presto.",shape=box,color=blue];
		1429 -> 1436;
	1430 [label="Bah. Il maggiordomo mi sta lanciando un'occhiata. Devo uscire da questa conversazione. Ci sentiamo presto.",shape=box,color=blue];
		1430 -> 1437;
	1431 [label="Chat ends.",color=orange];
	1432 [label="Il senso di colpa non è altro che un traditore nella notte che ti deruba di tutto ciò che ti è caro. Non reca altro che dolore.",shape=box,color=blue];
		1432 -> 1438;
	1433 [label="Chat ends.",color=orange];
	1434 [label="Non si è rifiutato di ascoltare. Non mi ha detto di smettere di parlare. Lo farei, se me lo dicesse.",shape=box,color=blue];
		1434 -> 1439;
	1435 [label="È meglio che sia qualcuno che è religiosamente incline a manipolarlo semplicemente perché ne ha la possibilità? Che si limiti a sottolineare le sue allucinazioni e a chiamarle \"visioni\" invece di aiutarlo?",shape=box,color=blue];
		1435 -> 1440;
	1436 [label="Chat ends.",color=orange];
	1437 [label="Chat ends.",color=orange];
	1438 [label="Update boolean RoatheForgivenessNoGuilt",color=orange];
		1438 -> 1441;
	1439 [label="Mi fa arrabbiare vedere quelli intorno a Lyon usarlo e manipolarlo, che se ne rendano conto o meno. Tutto in nome della \"religione\" e della \"fede\".",shape=box,color=blue];
		1439 -> 1440;
	1440 [label="Ho letto i resoconti di quanto accaduto. Questo... \"Velo Rosso\" avrebbe potuto provare a recuperare quel Tenno dal suo Harrow per tutti quei secoli. Ma non l'hanno fatto. Lo hanno lasciato appassire e morire.",shape=box,color=blue];
		1440 -> 1442;
	1441 [label="+10 Chemistry",color=orange];
		1441 -> 1443;
	1442 [label="Perché? In nome della guardia contro una... teorica \"Divinità del Void\".",shape=box,color=blue];
		1442 -> 1444;
		1442 -> 1445;
	1443 [label="Chat ends.",color=orange];
	1444 [label="Pensi che il sacrificio di Rell sia stato inutile?",shape=box,color=red];
		1444 -> 1446;
	1445 [label="Rell era l'unica cosa che l'ha trattenuta, per tutti quegli anni.",shape=box,color=red];
		1445 -> 1447;
	1446 [label="No. Si stava proteggendo da qualcosa. Ma chissà quanto peggiorò la situazione? Chissà quanto di sé, della sua paura e del suo terrore l'ha alimentata, per tutti quei secoli?",shape=box,color=blue];
		1446 -> 1448;
	1447 [label="Oppure era l'unica cosa che lo alimentava, in tutti quegli anni.",shape=box,color=blue];
		1447 -> 1448;
	1448 [label="L'incarnazione concettuale manifesta solo ciò con cui è data la possibilità di creare. E il Void può operare solo con la stoffa che lui offre.",shape=box,color=blue];
		1448 -> 1449;
	1449 [label="Quanto ha investito quel singolo Tenno nella sua sola esistenza, mi chiedo? Era un vero e proprio tripudio di Agonia, Dolore, Tradimento, Tristezza... Solitudine...",shape=box,color=blue];
		1449 -> 1450;
	1450 [label="E il torpore che deve derivare dalle migliaia di anni trascorsi da solo in quel luogo, a parlare al Nulla. Cosa ne consegue, se non l'Indifferenza?",shape=box,color=blue];
		1450 -> 1451;
		1450 -> 1452;
	1451 [label="È possibile che quello che dici sia vero. È solo che... non so se lo sia. E non so nemmeno se non lo sia.",shape=box,color=red];
		1451 -> 1453;
	1452 [label="Era potente prima di arrivare a Rell. Non si sarebbe sacrificato in quel modo senza una buona ragione.",shape=box,color=red];
		1452 -> 1454;
	1453 [label="+10 Chemistry",color=orange];
		1453 -> 1455;
	1454 [label="Lo stesso vale per gli incubi dei bambini. Per un bambino di sei anni sono le creature più potenti dell'universo. Ma per un adulto non sono altro che un batuffolo di lanugine intrappolato in una presa d'aria che si è avvicinata troppo alla luce.",shape=box,color=blue];
		1454 -> 1456;
	1455 [label="Non credo di poter chiedere altro se non che tu ammetta semplicemente di non sapere con certezza con cosa abbiamo a che fare.",shape=box,color=blue];
		1455 -> 1457;
	1456 [label="Facciamo montagne di granelli di polvere semplicemente perché dobbiamo avere una ragione per essere infelici e distruggerci.",shape=box,color=blue];
		1456 -> 1458;
	1457 [label="È un punto di partenza meravigliosamente glorioso. E una caratteristica ammirevole che chiunque dovrebbe possedere: la semplice capacità di dire semplicemente... \"Non lo so\".",shape=box,color=blue];
		1457 -> 1459;
	1458 [label="L'umanità in sintesi.",shape=box,color=blue];
		1458 -> 1460;
	1459 [label="Se noi Orokin fossimo riusciti a fare una cosa del genere una volta ogni tanto, forse saremmo sopravvissuti.",shape=box,color=blue];
		1459 -> 1460;
	1460 [label="Update boolean RoatheMITW3",color=orange];
		1460 -> 1461;
	1461 [label="+10 Chemistry",color=orange];
		1461 -> 1462;
	1462 [label="Chat ends.",color=orange];
}