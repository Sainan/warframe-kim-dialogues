		j2823773332 -> j1936339154;
	j974894048 [label="Poiché ognuno vive in un certo senso all'interno della propria 'continuità' o tempo. Tutti i ceppi dell'Infestazione sono collegati, ma vivono in un certo senso in... noduli. È tutto molto complicato.",shape=box,color=red];
