		j1512562492 -> j2773877561;
	j2337310588 [label="Molto prima del lancio della Zariman Ten Zero, e che i Tenno fossero anche solo un puntino sullo schermo proverbiale, Margulis l'Archimedea e Ballas si incontrarono durante l'inaugurazione di una nuova serra a cupola.",shape=box,color=blue];
