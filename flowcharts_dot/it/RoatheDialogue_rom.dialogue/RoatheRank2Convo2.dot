	j4272599516 [label="Ti rimprovererei per quello che hai fatto per ottenere ciò che volevi, ma sono colpito dal fatto che gli Orokin siano noti per fare cose ben peggiori, se non più creative.",shape=box,color=blue];
		j4272599516 -> j3086638066;
	j1640284296 [label="Certo che sì. O meglio, i ragazzini. I Tenno. A volte mi chiedo, se quello che è successo, fosse inevitabile. O se sarebbe stato possibile convincerlo a cambiare rotta.",shape=box,color=blue];
		j1640284296 -> j3250807659;
	j2163150726 [label="Forse hai ragione. O forse, in fondo, siamo tutti gioielli grezzi. Abbiamo i nostri difetti, le nostre caratteristiche. Vene, imperfezioni.",shape=box,color=blue];
