	j4081055212 [label="+10 Chemistry",color=orange];
		j4081055212 -> j154976201;
	j3693780714 [label="O stai cercando di fare appello al mio ego, cosa per cui ti faccio i miei complimenti, o sei semplicemente estremamente poco ispirato dalla tua giornata. Cosa che, da persona che ha vissuto innumerevoli cicli di vita, quasi comprendo.",shape=box,color=blue];
		j3693780714 -> j1566001998;
	j1007749947 [label="Affascinante. O stai mentendo, oppure ho ancora delle pietre da scagliare. Il che potrebbe essere il motivo per cui sei ancora qui.",shape=box,color=blue];
		j1007749947 -> j783579435;
