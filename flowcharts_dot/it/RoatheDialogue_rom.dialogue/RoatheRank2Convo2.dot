	j22085814 [label="Personalmente, consiglierei di sederti in silenzio con i tuoi errori e accettare la sconfitta per quello che è. Ma non ho il dono, dato dal Void, di riempire le tasche di tempo e cancellare le menti.",shape=box,color=blue];
		j22085814 -> j1074799030;
	j3086638066 [label="Ti ho raccontato la storia di Ballas e Margulis? Confido nella tua sincerità, non ho assolutamente nessun modo di conoscere la verità.",shape=box,color=blue];
		j3086638066 -> j4005950680;
	j3250807659 [label="Mi piace credere che, in fondo, siamo tutti dei gioielli grezzi. Abbiamo i nostri difetti, le nostre caratteristiche. Vene, imperfezioni.",shape=box,color=blue];
		j3250807659 -> j2822751585;
	j2822751585 [label="E potremmo essere sfaccettati per catturare la luce e trasformarli in elaborate opere d'arte... o affilati per farne armi... o ridurli in polvere.",shape=box,color=blue];
