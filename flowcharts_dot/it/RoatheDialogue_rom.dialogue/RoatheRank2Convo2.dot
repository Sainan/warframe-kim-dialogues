		j1503153731 -> j2889425550;
		j1503153731 -> j2397131278;
	j283418481 [label="Comunque. Tutto questo, in nome 'dell'amore'?",shape=box,color=blue];
		j283418481 -> j4157787064;
	j3906343339 [label="Lizzie. Le piaceresti molto.",shape=box,color=red];
		j3906343339 -> j945453680;
	j3614794021 [label="Una chitarra parlante.",shape=box,color=red];
		j3614794021 -> j945453680;
	j3606519250 [label="Era un Esecutore. Uno dei più potenti dei Sette, in effetti. Avrebbe potuto convoncarla nei suoi appartamenti e lei sarebbe andata senza pensarci due volte.",shape=box,color=blue];
		j3606519250 -> j2638887550;
	j2889425550 [label="Lizzie. Le piaceresti molto.",shape=box,color=red];
		j2889425550 -> j2823773332;
	j2397131278 [label="Una chitarra parlante.",shape=box,color=red];
		j2397131278 -> j2823773332;
	j2638887550 [label="Ma non è quello che ha fatto. Ballas ha posato gli occhi su di lei quella sera ed.... è rimasto colpito, Drifter. Positivamente e completamente fuori di sé.",shape=box,color=blue];
		j2638887550 -> j2677151766;
	j2677151766 [label="Non avevo mai visto niente del genere. Era come se non esistesse nessun altro nella stanza, a parte Margulis. Sembrava persino... troppo timido per parlarle. Lui! Ballas!",shape=box,color=blue];
		j2677151766 -> j516204949;
		j2677151766 -> j3896438897;
	j516204949 [label="Davvero?",shape=box,color=red];
		j516204949 -> j1645372265;
	j3896438897 [label="Te lo stai inventando.",shape=box,color=red];
		j3896438897 -> j1323869425;
	j1645372265 [label="Lo giuro su quel che resta del mio onore! Che motivo avrei di mentire? Che me ne importa della tua opinione sulla validità della loro relazione?",shape=box,color=blue];
		j1645372265 -> j267502672;
	j1323869425 [label="Lo giuro su quel che resta del mio onore che non me lo sto inventato! E che motivo avrei di mentire? Che me ne importa della tua opinione sulla validità della loro relazione?",shape=box,color=blue];
		j1323869425 -> j267502672;
	j267502672 [label="Mi rattrista semplicemente il fatto che voi tutti vogliate semplificare così in fretta qualcosa che è decisamente molto più complicato di quando vorreste.",shape=box,color=blue];
		j267502672 -> j561613700;
	j561613700 [label="Erano innamorati, che ci si voglia credere o no. Ballas ignorò tutte le regole di classe e le tradizioni per prendere come suo amante - e unica compagna romantica - un'Archimedea. ",shape=box,color=blue];
		j561613700 -> j2164978018;
	j2164978018 [label="Solo il vero amore avrebbe potuto far impazzire un uomo in un modo così spettacolare, quando tutto andò male...",shape=box,color=blue];
		j2164978018 -> j1998520652;
		j2164978018 -> j2742261142;
	j1998520652 [label="Come sei arrivato a questa conclusione? Non fu lui il responsabile della sua morte?",shape=box,color=red];
		j1998520652 -> j4160404077;
	j2742261142 [label="Fu Ballas a farla giustiziare.",shape=box,color=red];
		j2742261142 -> j4160404077;
	j4160404077 [label="Innanzitutto, diamo per scontato che tutto ciò che sai sia corretto e che le sue azioni siano state puramente volontarie. Supponiamo che non ci siano state altre manovre politiche, estorsioni o altro dietro le quinte che possano averlo forzato a farlo.",shape=box,color=blue];
		j4160404077 -> j581491927;
	j581491927 [label="Anche se così fosse stato, e Ballas avesse chiesto la sue esecuzione senza alcuna influenza, considera che era già troppo tardi. Il tradimento che sentiva lo aveva già spezzato.",shape=box,color=blue];
		j581491927 -> j863495764;
	j863495764 [label="Il suo cuore e la sua mente erano già spezzati.",shape=box,color=blue];
		j863495764 -> j165779647;
		j863495764 -> j1578966756;
	j165779647 [label="Non ho intenzione di provare pena per lui, se è questo che mi stai chiedendo di fare.",shape=box,color=red];
		j165779647 -> j2984905033;
	j1578966756 [label="A causa dei Tenno? O per quello che le hanno fatto?",shape=box,color=red];
		j1578966756 -> j655583864;
	j2984905033 [label="Non ti sto chiedendo niente del genere! Ballas merita solo una cosa, una pisciata sulla sua tomba quando seppellirai il suo cadavere - se mai avrà una tomba.",shape=box,color=blue];
		j2984905033 -> j2123678774;
	j655583864 [label="In un certo senso, entrambe le cose. E in un altro nessuna delle due. Fu portato alla follia, il giorno in cui ne ordinò l'esecuzione. In effetti, non mi sorprenderei se una parte di lui non ricordasse del tutto di aver commesso quell'atto.",shape=box,color=blue];
		j655583864 -> j725434356;
	j2123678774 [label="Sto semplicemente affermando che il giorno in cui ne ordinò l'esecuzione, era folle. Non mi sorprenderei se un parte di lui non ricordasse di aver commesso quell'atto, dopo il fatto.",shape=box,color=blue];
		j2123678774 -> j725434356;
	j725434356 [label="Ballas amava Margulis. Con tutta la sua persona - era interamente devoto a lei. Avrebbe sacrificato qualsiasi cosa per lei. La sua anima, il suo corpo, l'Impero Orokin. Quasiasi cosa si potesse anche solo sognare.",shape=box,color=blue];
		j725434356 -> j781178040;
	j781178040 [label="Nessun prezzo era troppo elevato. Nessuna morale valeva la pena di essere sacrificata. Se gli avessi dato un neonato e gli avessi detto che Margulis avrebbe voluto che il suo cervello venisse fracassato sulle rocce, sarebbe morto prima che tu finissi la frase.",shape=box,color=blue];
		j781178040 -> j3545645721;
	j3545645721 [label="Avrebbe ridotto in cenere il Sistema Origin e lo avrebbe ricostruito a suo immagine, Usurpatore... ma è qui che risiede la tragedia.",shape=box,color=blue];
		j3545645721 -> j1616520081;
	j1616520081 [label="Margulis? Ah, Margulis. Cara, dolce, adorabile Margulis... aveva ancora una coscienza.",shape=box,color=blue];
		j1616520081 -> j1006052221;
	j1006052221 [label="E quando vide i poveri Tenno, i poveri ragazzini lacerati dal Void... ",shape=box,color=blue];
		j1006052221 -> j2289535564;
	j2289535564 [label="C'era qualcosa di più importante di Ballas nella sua vita. Qualcosa per cui valeva la pena sacrificare la propria vita... e non era lui.",shape=box,color=blue];
		j2289535564 -> j2144088302;
	j2144088302 [label="Non era il suo amore per lui.",shape=box,color=blue];
		j2144088302 -> j3067238516;
	j3067238516 [label="E lui lo sapeva, mio dolce Drifter. Lo ha saputo dal momento in cui lei posò gli occhi su di loro. E ne ebbe la conferma quando i suoi “animali impazziti” fecero sì che fossero gli ultimi che lei vedesse. O almeno così dicevano le voci che circolavano tra noi Orokin.",shape=box,color=blue];
		j3067238516 -> j2047610983;
	j2047610983 [label="Riesci ad immaginare la gioia degli Orokin? Vedere la preziosa Archimedea di Ballas lacerata dal Void, e i mocciosi rabbiosi che le bruciavano gli occhi?",shape=box,color=blue];
		j2047610983 -> j3352110605;
	j3352110605 [label="Ma credo che fosse già da prima, nel preciso momento in cui Margulis lottò per salvare il Tenno, che il cuore di Ballas si frantumò in mille pezzi, senza mai più riprendersi.",shape=box,color=blue];
		j3352110605 -> j526210976;
	j526210976 [label="Perché sapeva di essere stato soppiantato nel suo cuore.",shape=box,color=blue];
		j526210976 -> j2888363636;
	j2888363636 [label="Suppongo che per questo motivo provassi compassione per lui. Ma il resto di ciò che seguì? Una storia d'amore senza tempo... e come finì in una tragedia così straziante. ",shape=box,color=blue];
		j2888363636 -> j966077911;
	j966077911 [label="Avresti dovuto vedere come si sorridevano l'un l'altro...",shape=box,color=blue];
		j966077911 -> j3043817922;
		j966077911 -> j2067533756;
	j3043817922 [label="Potrai anche rendere romantica la loro storia, ma ciò non giustifica chi lui fosse. Ballas non può essere perdonato per tutto quello che ha fatto.",shape=box,color=red];
		j3043817922 -> j2578452813;
	j2067533756 [label="Apprezzo il fatto che il loro amore fosse reale. Che lui fosse... complicato all'epoca. E che Margulis non sia stata manipolata per tutto il tempo.",shape=box,color=red];
		j2067533756 -> j715630989;
	j2578452813 [label="Add 1 to Thermostat counter",color=orange];
		j2578452813 -> j805477051;
	j715630989 [label="Add -1 to Thermostat counter",color=orange];
		j715630989 -> j1245733281;
	j805477051 [label="+10 Chemistry",color=orange];
		j805477051 -> j1557986644;
	j1245733281 [label="+10 Chemistry",color=orange];
		j1245733281 -> j3969099433;
	j1557986644 [label="Non stavo cercando di equiparare le due cose, Usurpatore. Stavo semplicemente affermando che un uomo può essere amato ma anche capace di cose terribili. Ah, beh... Non c'è speranza per noi poveri sciocchi depravati, suppongo...",shape=box,color=blue];
		j1557986644 -> j3997523356;
	j3969099433 [label="Infatti. A volte mi dà pace pensare che se anche quel signore della depravazione è riuscito a trovare una compagna, allora c'è speranza anche per il resto di noi, eh? Ah!",shape=box,color=blue];
		j3969099433 -> j3997523356;
	j3997523356 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j3997523356 -> j2530795065;
	j2530795065 [label="Ma, ti ho rubato abbastanza tempo per oggi. Vai. ",shape=box,color=blue];
		j2530795065 -> "Chat ends.";
}