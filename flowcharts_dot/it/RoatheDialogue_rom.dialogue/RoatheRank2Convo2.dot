	j2095510686 [label="Immagino che sia stranamente romantico, seppur... distopico, arrivare a tanto per conquistare il cuore (e/o il corpo) di una persona.",shape=box,color=blue];
		j2095510686 -> j2710543277;
	j4176458187 [label="O è ancora peggio, e tu eri semplicemente curioso di vedere cosa sarebbe potuto succedere? E te ne stai lì seduto, a strappare le zampe agli insetti? Abbiamo chiarito il 'cosa' dietro le tue azioni. Ora sto cercando di interrogarmi sul 'perché'.",shape=box,color=blue];
