		j1983330397 -> j2741484950;
	j364563370 [label="Sto solo cercando di capire perché continui a usarlo come titolo per me.",shape=box,color=red];
		j364563370 -> j3617194960;
	j1303752721 [label="Ah! Difficilmente! Sei estremamente paziente se pensi che ti abbia insultato così con tanta noncuranza per giorni. ",shape=box,color=blue];
		j1303752721 -> j2389195802;
	j3747937791 [label="Beh, è questo che sei, vero? I Tenno hanno usurpato il Sistema Origin dagli Orokin. E tu, come un piccolo impostore nel nido, sei entrato in questo mondo rubandotelo.",shape=box,color=blue];
