		j1247827892 -> j1794909992;
	j2417247567 [label="Il titolo è semplicemente l'espressione della mia moderata ammirazione. Anche se è sufficientemente sarcastico per soddisfare le mie esigenze, sì, te lo concedo.",shape=box,color=blue];
