		j2417247567 -> j1171758087;
		j2417247567 -> j3267112852;
	j1478165891 [label="Non ho voglia di essere un tuo nemico, Usurpatore. No. Non è un insulto. È solo per la tua mancanza di diligenza che non ti sei reso conto di quanto il mio passato coincida con il tuo.",shape=box,color=blue];
		j1478165891 -> j452272548;
	j1794909992 [label="Non ho voglia di essere un tuo nemico, Usurpatore. No. Semmai, è un titolo onorifico. Hai fatto ciò a cui aspiravo. Niente di più.",shape=box,color=blue];
