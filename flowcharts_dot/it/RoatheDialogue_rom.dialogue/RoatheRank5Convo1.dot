		3334 -> 3356;
	3335 [label="Mi sento come se la comprensione stessa di me stesso, la base stessa delle mie fondamenta, si fosse spaccata e squarciata come la dannata Lua in persona! Riscritta con un inchiostro che cola. Codardo!",shape=box,color=blue];
