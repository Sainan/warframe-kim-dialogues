	3201 [label="Calunniati, incompresi, anatema. Cacciati dal cielo e lasciati a marcire. Spiriti affini, davvero!",shape=box,color=blue];
		3201 -> 3210;
	3202 [label="So che non è la prima volta che affrontiamo questa situazione. Ricordo di essere già stato qui una volta. E so che potrebbe non essere l'ultima. Ti chiedo continuamente di fermarti e ricominciare da capo, e per me significa moltissimo che tu lo faccia.",shape=box,color=blue];
