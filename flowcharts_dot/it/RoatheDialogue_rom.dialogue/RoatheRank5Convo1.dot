	j2176468607 [label="Non so più chi sono...",shape=box,color=blue];
		j2176468607 -> j2001418357;
	j1104797389 [label="Se mai desiderassi che il maggiordomo salga di sopra e si riconcili con la famiglia Entrati, devi fare come ti dico. Devi.",shape=box,color=blue];
		j1104797389 -> j4144481583;
		j1104797389 -> j2393502291;
	j3322432882 [label="Se diventassi chi scelgo di diventare di mia spontanea volontà? Molto bene. Scelgo questo;",shape=box,color=blue];
