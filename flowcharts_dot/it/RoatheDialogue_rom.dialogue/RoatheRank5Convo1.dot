	j67110474 [label="Mi hai dato la tua parola. La tua parola! Ma ora scopro che non sei altro che un bugiardo!",shape=box,color=blue];
		j67110474 -> j4071701190;
		j67110474 -> j3978471211;
	j527437389 [label="Avrei dovuto saperlo. Avrei dovuto sapere che non dovevo fidarmi di te, anomalia nata dal Void! Sapevi cosa mi aspettava lì?! In qualche modo sapevi la verità quando io non lo sapevo?!",shape=box,color=blue];
		j527437389 -> j207611970;
		j527437389 -> j2167061445;
	j3321995644 [label="Ed eccoci qui, ancora una volta, al punto di partenza. A calpestare ancora una volta i cadaveri del nostro passato. Non meglio di dove eravamo prima.",shape=box,color=blue];
		j3321995644 -> j279220583;
	j3594221044 [label="Per ragioni del tutto indipendenti dalla mia volontà, a quanto pare! Eppure ricordo lo stesso l'agonia della mia scelta di assumere quel siero.",shape=box,color=blue];
		j3594221044 -> j279220583;
