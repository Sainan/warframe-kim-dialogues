	j1499648295 [label="Durante tutta questa follia, dal momento in cui i miei ricordi sono svaniti, ho sentito questo... artigliare. Questo lacerare il mio petto, la mia pelle, come se una grande bestia volesse disperatamente liberarsi di me.",shape=box,color=blue];
