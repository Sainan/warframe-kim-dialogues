		j3979311135 -> j219700425;
	j2364492694 [label="Quando arrivarono i coscritti, tre energie si intrecciarono nella mia, la quarta non fu poi così sorprendente. Questa grande, orribile cosa che desiderava spaccarmi in due come la crosta dei pianeti che si riversa.",shape=box,color=blue];
		j2364492694 -> j3496922996;
	j2833495663 [label="Ricordo la promessa che mi hai fatto. E che ho trovato un posto così speciale nel tuo cuore da tenermi in questo stato di purgatorio? Grazie, mio cucciolo. Grazie.",shape=box,color=blue];
		j2833495663 -> j3785793437;
	j1063093029 [label="Che ho trovato un posto così speciale nel tuo cuore da tenermi in questo stato di purgatorio? Grazie, mio cucciolo. Grazie.",shape=box,color=blue];
		j1063093029 -> j3785793437;
	j3448079097 [label="Ricordo la promessa che mi hai fatto. E che ho trovato una tale amicizia con te, che mi tieni in questo stato di purgatorio? Grazie, amico mio.",shape=box,color=blue];
		j3448079097 -> j219700425;
	j2787039130 [label="E per aver trovato una tale amicizia con te, che mi tieni in questo stato di purgatorio? Grazie, amico mio.",shape=box,color=blue];
		j2787039130 -> j219700425;
