	j718251415 [label="Non volevo mentirti, semplicemente non mi ero reso conto che fosse una cosa così importante.",shape=box,color=red];
		j718251415 -> j1900118194;
	j2711212347 [label="So di aver infranto la promessa che ti avevo fatto. Mi dispiace. Ma possiamo affrontare questa situazione insieme.",shape=box,color=red];
		j2711212347 -> j1685056419;
	j4118779039 [label="Cosa?! Calmati. Perliamone.",shape=box,color=red];
		j4118779039 -> j2804156940;
