	j1481326682 [label="Non era...",shape=box,color=blue];
		j1481326682 -> j426418376;
	j730436557 [label="Oh sì, \"affrontarlo\". Come ho fatto io quando ho preso il siero di Entrati e sono scappato dal mio destino come un codardo?!",shape=box,color=blue];
		j730436557 -> j1052536381;
		j730436557 -> j848744416;
	j188415918 [label="Perdonami se trovo questo estremamente difficile da credere. Siamo definiti dai momenti della nostra vita. Siamo semplicemente una serie di ricordi che ci conducono a ciò che è successivo. Ecco perché i ricordi sono - ed erano - così sacri per gli Orokin.",shape=box,color=blue];
		j188415918 -> j561145729;
	j3282027543 [label="Non osare - non osare dirmi di \"calmarmi\"! Non pensi che abbia tutto il diritto di sentirmi come se mi stessero facendo a pezzi?!",shape=box,color=blue];
		j3282027543 -> j4062072677;
	j364013797 [label="Affascinante. Affascinante e inaspettato. Spiega.",shape=box,color=blue];
		j364013797 -> j1146351799;
		j364013797 -> j2565502253;
	j3979418987 [label="Non so più chi sono...",shape=box,color=blue];
