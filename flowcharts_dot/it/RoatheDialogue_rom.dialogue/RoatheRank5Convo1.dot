	j3738567608 [label="So che non è la prima volta che affrontiamo questa situazione. Ricordo di essere già stato qui una volta. E so che potrebbe non essere l'ultima. Ti chiedo continuamente di fermarti e ricominciare da capo, e per me significa moltissimo che tu lo faccia.",shape=box,color=blue];
		j3738567608 -> j3448079097;
	j2553099015 [label="Devo farti i miei complimenti, Usurpatore, per aver fatto come ti avevo chiesto e per non esserti addentrato ulteriormente nel Refrattario Oscuro e nei miei ricordi nella Descendia. Nonostante non ci sia alcuna promessa tra noi.",shape=box,color=blue];
		j2553099015 -> j2787039130;
	j3838652156 [label="Tesoro, devo farti i complimenti per aver mantenuto la tua parole e non esserti addentrato ulteriormente nella Descendia e nel Refrattario Oscuro, senza recuperare i miei ultimi ricordi. Significa tutto per me.",shape=box,color=blue];
		j3838652156 -> j3785793437;
