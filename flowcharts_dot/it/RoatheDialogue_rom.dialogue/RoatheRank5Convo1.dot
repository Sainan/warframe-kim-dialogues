	j1697632881 [label="Calunniati, incompresi, anatema. Cacciati dal cielo e lasciati a marcire. Spiriti affini, davvero!",shape=box,color=blue];
		j1697632881 -> j2364492694;
	j2294549345 [label="So che non è la prima volta che affrontiamo questa situazione. Ricordo di essere già stato qui una volta. E so che potrebbe non essere l'ultima. Ti chiedo continuamente di fermarti e ricominciare da capo, e per me significa moltissimo che tu lo faccia.",shape=box,color=blue];
		j2294549345 -> j2833495663;
	j3213880123 [label="So che non è la prima volta che affrontiamo questa situazione. Ricordo di essere già stato qui una volta. E so che potrebbe non essere l'ultima. Ti chiedo continuamente di fermarti e ricominciare da capo, e per me significa moltissimo che tu lo faccia.",shape=box,color=blue];
