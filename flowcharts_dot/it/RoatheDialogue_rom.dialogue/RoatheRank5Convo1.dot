	j2006356431 [label="Ti avevo chiesto di porre fine alle tue incursioni nella mia mente prima che fosse troppo tardi! Ti avevo detto di smettere di lavorare, eppure... eppure!",shape=box,color=blue];
		j2006356431 -> j69441938;
	j341166493 [label="Me lo hai tenuto nascosto, solo per rivelarmelo ora? È stato tutto un gioco malato per te?! Nutrire quella cosa che si nascondeva dentro di me, sapendo cosa mi avrebbe preso?!",shape=box,color=blue];
		j341166493 -> j4096981425;
