		3363 -> 3382;
	3364 [label="Hai un dono. Un dono che può annullare il tempo. Trasformarlo in una spirale, se non in un loop. E questo ha... un effetto interessante sulle menti dei Protoframe, attraverso il loro attaccamento all'Infestazione e al tempo. ",shape=box,color=blue];
