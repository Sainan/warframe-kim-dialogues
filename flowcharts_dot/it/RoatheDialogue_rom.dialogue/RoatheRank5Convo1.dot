		j3144567292 -> j1445240447;
	j3486515966 [label="Se vuoi scegliere di tracciare un percorso da solo? Per te stesso? Fallo. Non scusarti. Ma quella è la tua strada, e di nessun altro.",shape=box,color=red];
		j3486515966 -> j1848702131;
	j1152172281 [label="Se desideri chiedere perdono, puoi farlo. Ma devi volerlo. Devi scegliere tu quella strada. Nessun altro può farlo.",shape=box,color=red];
		j1152172281 -> j353697121;
	j1260862753 [label="Chi sono...?",shape=box,color=blue];
		j1260862753 -> j3581123159;
	j1299333559 [label="Chi sono...?",shape=box,color=blue];
		j1299333559 -> j1469718174;
	j43508396 [label="E il nostro attaccamento, quindi, al tempo. Te lo chiedo ora. No, ti imploro, di utilizzarlo ora su di me. Allontana da me questi pensieri. Allontana da me questi ricordi.",shape=box,color=blue];
		j43508396 -> j987196932;
	j695463407 [label="Allora molto bene. Così sia. Non te lo chiederò ora. Ma se non l'hai mai fatto per il tuo divertimento, per curiosità o per cercare di rimediare a errori ingiustificati commessi nei rapporti con gli altri?!",shape=box,color=blue];
		j695463407 -> j987196932;
	j2007340189 [label="Ho quindi deciso di trascorrere il resto dei miei giorni cercando di rimediare a tutti i torti che il mio popolo miserabile ha ritenuto opportuno commettere in questo sistema fin dall'alba dei tempi. ",shape=box,color=blue];
		j2007340189 -> j225581375;
	j2935446508 [label="I miei piani e i miei progetti per il potere sono puramente e interamente miei. E tu, mio caro dolce Drifter, sei il capo che governerà tra loro... se sceglierai di farlo.",shape=box,color=blue];
		j2935446508 -> j993282847;
