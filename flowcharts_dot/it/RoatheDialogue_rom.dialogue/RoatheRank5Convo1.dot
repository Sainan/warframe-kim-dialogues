		j1338067209 -> j1152172281;
	j1209616088 [label="Sotto i ricordi, sotto l'aspetto esteriore degli Orokin, sotto questa... pelle blu e l'Infestazione, sotto Uriel e questa maschera del Vice Reggente Grand Carnus Roathe che indosso...",shape=box,color=blue];
		j1209616088 -> j1260862753;
	j1105476206 [label="Sotto i ricordi, sotto l'aspetto esteriore degli Orokin, sotto questa... pelle blu e l'Infestazione, sotto Uriel e questa maschera del Vice Reggente Grand Carnus Roathe che indosso...",shape=box,color=blue];
		j1105476206 -> j1299333559;
	j860879960 [label="Hai un dono. Un dono che può annullare il tempo. Trasformarlo in una spirale, se non in un loop. E questo ha... un effetto interessante sulle menti dei Protoframe, attraverso il loro attaccamento all'Infestazione e al tempo. ",shape=box,color=blue];
		j860879960 -> j43508396;
	j1651245532 [label="Se potessi dirmi che non hai mai utilizzato i tuoi doni per giocare con le menti dei Protoframe che chiami amici e amanti, e potessi dirlo senza mentire?",shape=box,color=blue];
		j1651245532 -> j695463407;
	j2845346795 [label="Sono l'ultimo Orokin. Sarò incoronato tra loro finché qualcuno non si alzerà a sfidarmi. E sarò il capitatno di tutti i miei affari fino al giorno in cui la mia vita sarà spenta.",shape=box,color=blue];
