	j561145729 [label="E di recente ho dovuto riscrivere completamente quella definizione di me stesso. L'ho impressa nella mia psiche con un inchiostro che cola.",shape=box,color=blue];
		j561145729 -> j3385520421;
	j4062072677 [label="Mi sento come se la comprensione stessa di me stesso, la base stessa delle mie fondamenta, si fosse spaccata e squarciata come la dannata Lua in persona! Riscritta con un inchiostro che cola. Codardo!",shape=box,color=blue];
		j4062072677 -> j2623171435;
