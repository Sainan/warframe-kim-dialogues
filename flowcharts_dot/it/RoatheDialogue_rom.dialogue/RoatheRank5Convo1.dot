	j1445240447 [label="Dentro di me c'è una bestia rabbiosa e violenta che mi divora la cassa toracica dall'interno.",shape=box,color=blue];
		j1445240447 -> j4258797474;
	j1848702131 [label="Non sei definito dalle opinioni di chi ti circonda. O da ciò che pensano delle tue azioni. Sei definito solo da ciò che pensi di te stesso e delle tue scelte.",shape=box,color=red];
		j1848702131 -> j217767230;
	j353697121 [label="Non sei definito dal tuo passato, Roathe. Sei definito dal tuo futuro. E hai ancora un futuro da vivere, a differenza di tutti gli Orokin che morirono nella Notte dei Tamburi Naga.",shape=box,color=red];
