	2225 [label="Chat ends.",color=orange];
	2218 [label="Trascrizione: Fu Scarne, irascibile, cerebrale e caustico, a proporre per primo il Piano nei giorni precedenti la Guerra. \"Dobbiamo lasciare il nido, perché il nido è in fiamme\".",shape=box,color=blue];
		2218 -> 2221;
	2221 [label="Attraverso lo sfruttamento eccessivo e gli esperimenti sconsiderati, avevamo contaminato il Sistema oltre ogni speranza di rigenerazione.",shape=box,color=blue];
		2221 -> 2216;
	2216 [label="L'espansione verso nuovi orizzonti era ormai la nostra unica opzione. ",shape=box,color=blue];
		2216 -> 5733;
	5733 [label="Anche lui inaugurò le codarde Torri nel Void.",shape=box,color=blue];
		5733 -> 2222;
	2222 [label="Il terrore di un ritorno dei Sentient era così forte in lui che riusciva solo a immaginare una ritirata su isole nel Mare del Void.",shape=box,color=blue];
		2222 -> 5700;
	5700 [label="Quanto poco credito abbiamo dato ai Sentient per il loro coraggio.",shape=box,color=blue];
		5700 -> 5701;
	5701 [label="Sopportavano volentieri il fuoco cocente del Void solo per avere la possibilità di punirci.",shape=box,color=blue];
