	"Chat ends." [color=orange];
	j2352441610 [label="MV: PUNIZIONE",shape=box,color=blue];
		j2352441610 -> j2928119099;
	j2928119099 [label="Trascrizione: Fu Scarne, irascibile, cerebrale e caustico, a proporre per primo il Piano nei giorni precedenti la Guerra. \"Dobbiamo lasciare il nido, perché il nido è in fiamme\".",shape=box,color=blue];
		j2928119099 -> j271684083;
	j271684083 [label="Attraverso lo sfruttamento eccessivo e gli esperimenti sconsiderati, avevamo contaminato il Sistema oltre ogni speranza di rigenerazione.",shape=box,color=blue];
		j271684083 -> j2486846966;
	j2486846966 [label="L'espansione verso nuovi orizzonti era ormai la nostra unica opzione. ",shape=box,color=blue];
		j2486846966 -> j90275931;
	j90275931 [label="Anche lui inaugurò le codarde Torri nel Void.",shape=box,color=blue];
		j90275931 -> j3833308327;
	j3833308327 [label="Il terrore di un ritorno dei Sentient era così forte in lui che riusciva solo a immaginare una ritirata su isole nel Mare del Void.",shape=box,color=blue];
		j3833308327 -> j3079290069;
	j3079290069 [label="Quanto poco credito abbiamo dato ai Sentient per il loro coraggio.",shape=box,color=blue];
		j3079290069 -> j2982800889;
	j2982800889 [label="Sopportavano volentieri il fuoco cocente del Void solo per avere la possibilità di punirci.",shape=box,color=blue];
		j2982800889 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}