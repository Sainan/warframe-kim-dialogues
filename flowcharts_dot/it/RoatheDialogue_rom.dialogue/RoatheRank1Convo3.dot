	262 [label="Poi, mi colpisce l'immediata furia e rabbia che provo nel sapere che la mia mente è stata presa in giro non una, ma due volte nella storia recente. Ma c'è un'altra emozione che sopraggiunge a sconfiggere la rabbia. Una che ancora non comprendo del tutto.",shape=box,color=blue];
		262 -> 271;
	267 [label="Non ne conosco i dettagli, perché quei ricordi sono scomparsi dalla mia mente, insieme a molti altri, a causa della trasformazione che mi ha imposto.",shape=box,color=blue];
		267 -> 275;
	268 [label="Sì! Esatto! Con campioni del mio stesso sangue! Non ho iniziato nello stesso anno in cui ce ne siamo andati, questo te lo posso assicurare! Per il Void, gli strapperò la carne con questi miei nuovi artigli non appena vedrò la sua stupida faccia compiaciuta -",shape=box,color=blue];
		268 -> 276;
	269 [label="Io ti consiglierei semplicemente di avere pazienza, ma... lungi da me consigliarti di usare uno scalpello quando hai accanto un piccone laser.",shape=box,color=blue];
		269 -> 277;
