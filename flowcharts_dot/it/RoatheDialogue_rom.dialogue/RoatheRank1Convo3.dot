	5737 [label="Poi, mi colpisce l'immediata furia e rabbia che provo nel sapere che la mia mente è stata presa in giro non una, ma due volte nella storia recente. Ma c'è un'altra emozione che sopraggiunge a sconfiggere la rabbia. Una che ancora non comprendo del tutto.",shape=box,color=blue];
		5737 -> 5740;
	272 [label="Per prima cosa: Sono sorpreso! Hai portato via tutti i nostri ricordi per poter provare di nuovo a conquistare il suo affetto?!",shape=box,color=blue];
