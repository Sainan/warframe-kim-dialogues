digraph {
	186 [label="RoatheRank1Convo3 begins.",color=orange];
		186 -> 188;
		186 -> 187;
	188 [label="Posso chiederti - come sei finito di nuovo qui? Da... quando, esattamente?",shape=box,color=red];
