		356 -> 366;
	360 [label="Update boolean RoatheXata1",color=orange];
		360 -> 370;
	361 [label="Diciamo solo che non ho iniziato il processo nello stesso anno in cui me ne sono andato, eh? Beh, ora siamo qui. Albrecht, nonostante tutti i suoi sforzi, non è riuscito ad abbandonarmi in quel buco infernale.",shape=box,color=blue];
		361 -> 371;
	362 [label="Il mio corpo veniva fatto a pezzi e rimodellato. Con la forza. Non l'ho scelto io. Non so se sia stato lo stesso per gli altri.",shape=box,color=blue];
