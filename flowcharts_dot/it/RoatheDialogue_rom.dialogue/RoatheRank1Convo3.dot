		232 -> 239;
	233 [label="AH! È magnifico! Ora hai davvero la mia attenzione... chi di noi? Mmh? Dillo dai... non essere timido. Forse possiamo trovare un... accordo.",shape=box,color=blue];
		233 -> 240;
