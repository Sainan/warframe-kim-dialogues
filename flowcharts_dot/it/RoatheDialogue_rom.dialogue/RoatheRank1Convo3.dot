	332 [label="So cosa disse ai due fanatici, per quel poco che importa. \"Uriel, eretico di Xata, in esilio, rispondi - gli Orokin potranno mai essere perdonati?\"",shape=box,color=blue];
		332 -> 341;
	333 [label="Un Helminth. Non so come fosse cresciuto nel passato, dato che doveva essere già lì prima del nostro arrivo. Si seccò e morì nel processo - sospettavo che un altro potesse essere usato per un viaggio di ritorno.",shape=box,color=blue];
		333 -> 342;
	334 [label="Non ne conosco i dettagli, perché quei ricordi sono scomparsi dalla mia mente, insieme a molti altri, a causa della trasformazione che mi ha imposto.",shape=box,color=blue];
		334 -> 343;
	335 [label="Farò finta di non sapere nulla davanti ai fanatici...",shape=box,color=blue];
		335 -> 344;
	336 [label="Ma questa è una conversazione per un altro giorno. Perché ho una proposta per te. Una che credo ti interesserà molto di più.",shape=box,color=blue];
		336 -> 345;
	5746 [label="Non oggi. Non domani.",shape=box,color=blue];
