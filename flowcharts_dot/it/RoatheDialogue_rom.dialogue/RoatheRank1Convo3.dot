		339 -> 348;
	340 [label="Ma questa è una conversazione per un altro giorno. Perché ho una proposta per te. Una che credo ti interesserà molto di più.",shape=box,color=blue];
		340 -> 349;
	337 [label="Ma sarai in debito con il Diavolo.",shape=box,color=blue];
		337 -> 346;
	341 [label="Se fossi stato cosciente nel momento in cui lo disse, gli avrei riso in faccia. Perché non sono io quello qui che sta cercando perdono, no?",shape=box,color=blue];
		341 -> 350;
	342 [label="Avevo ragione. Anche se il processo di creazione è stato... laborioso e scrupoloso, per usare un eufemismo! Ho usato campioni del mio sangue per ricostruire un Helminth, con tentativi ed errori!",shape=box,color=blue];
		342 -> 351;
	343 [label="Ma ho dei flash. Frammenti e pezzetti in un corridoio dorato. Una voce che ho riconosciuto - ma non un volto. Era Albrecht, ma non quello che conoscevo.",shape=box,color=blue];
		343 -> 352;
	344 [label="E, cosa ancora più importante - mi assicurerò che tu riesca a raggiungere il tuo obiettivo di aiutare Lyon a superare il suo dolore, qualunque cosa accada, questa volta.",shape=box,color=blue];
		344 -> 353;
	345 [label="Farò finta di non sapere nulla davanti ai fanatici...",shape=box,color=blue];
		345 -> 354;
	5745 [label="Ma sarai in debito con il Diavolo.",shape=box,color=blue];
