	226 [label="+5 Chemistry",color=orange];
		226 -> 233;
	224 [label="Mh. Capisco. Avevamo un accordo, e tu non sei riuscito a rispettare la tua parte, così hai visto il tuo premio svanirti dalle mani.",shape=box,color=blue];
		224 -> 231;
	227 [label="Ma ci sono limiti che non superiamo. Azioni che non intraprendiamo. Potrei continuare nei dettagli, ma non lo farò. Riassumerò semplicemente affermando che Albrecht li ha infranti tutti.",shape=box,color=blue];
		227 -> 234;
	228 [label="Davvero? Hai provato semplicemente a dargli da mangiare e da bere una volta al giorno e vedere se funziona? Molto bene...",shape=box,color=blue];
		228 -> 235;
	229 [label="E non sei riuscito a convincere quella piccola pallina di purezza a seguirti? Io... spero... che tu non intraprenda alcuna carriera da negoziatore, mia Perenne Conoscenza.",shape=box,color=blue];
		229 -> 236;
	230 [label="+5 Chemistry",color=orange];
