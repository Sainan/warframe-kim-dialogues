		231 -> 238;
	234 [label="Mi ha abbandonato lì, in un anno orribilmente antico, in qualche buco sperduto del Sistema Origin! Sapevi che quella 'Cathédrale' abbandonata nel Void non aveva ancora nemmeno l'elettricità?! L'elettricità!",shape=box,color=blue];
		234 -> 243;
	235 [label="Cosa ti ha dato così tanti problemi? Forse possiamo trovare un accordo?",shape=box,color=blue];
