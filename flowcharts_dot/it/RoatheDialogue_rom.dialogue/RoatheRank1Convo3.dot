	189 [label="Chat ends.",color=orange];
	191 [label="Perché sospetto che tu conosca già bene la risposta a questa domanda, mio Usurpatore? A che gioco stai giocando, chiedendomi simili banalità, se hai già scandagliato i frammenti della mia mente?",shape=box,color=blue];
		191 -> 193;
	192 [label="Certo, puoi chiederlo! Mi offre l'opportunità di mettere in mostra la mia genialità e di lamentarmi della profonda capacità di Albrecht di essere allo stesso tempo un idiota e in qualche modo un supremo vigliacco!",shape=box,color=blue];
		192 -> 194;
	193 [label="Check boolean RoatheKnowsReset",color=orange];
		193 -> 196 [label=true,color=green];
		193 -> 195 [label=false,color=brown];
	194 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		194 -> 197 [label="x >= 1",color=purple];
		194 -> 198 [label="x <= 0",color=purple];
		194 -> 198 [label="false",color=purple];
	196 [label="Sei proprio come Albrecht, ti intrometti nella mente di chi ti circonda, pensando che siano i tuoi giocattoli! Allora dimmi. Perché chiedere se hai già le risposte, eh?",shape=box,color=blue];
		196 -> 201;
		196 -> 202;
	195 [label="Dimmi. Ho ragione a pensare che tu abbia già le risposte che cerchi? Sai già come sono tornato qui con i fanatici - esattamente da dove proveniamo. E probabilmente molto di più, non è vero?",shape=box,color=blue];
		195 -> 199;
		195 -> 200;
	197 [label="Ho capito che non sei stato messo lì per scelta di Albrecht.",shape=box,color=red];
		197 -> 203;
	198 [label="Ah. Quindi non sei stato messo nel passato per scelta.",shape=box,color=red];
		198 -> 203;
	201 [label="Sto cercando di guidarti in questo processo, e l'ultima volta ho sbagliato tutto. Ci sto riprovando. 'Dal preludio', per così dire.",shape=box,color=red];
		201 -> 206;
	202 [label="Non so davvero come spiegarlo. Non ho chiesto io di avere la capacità di cancellare le vostre menti, e sto cercando di gestire questa capacità al meglio delle mie possibilità.",shape=box,color=red];
		202 -> 207;
	199 [label="No. Per niente.",shape=box,color=red];
		199 -> 204;
	200 [label="Io... lo ammetto, sì.",shape=box,color=red];
		200 -> 205;
	203 [label="No. Proprio no. Ora, ecco una cosa che devi sapere sugli Orokin: Giochiamo - beh... forse meglio, giocavamo spesso tra di noi. Giochi di tutti i tipi. Politici, psicologici, sessuali. Non importava.",shape=box,color=blue];
		203 -> 208;
	206 [label="+5 Chemistry",color=orange];
		206 -> 211;
	207 [label="Allora stai facendo veramente un pessimo lavoro, mia Perenne Conoscenza. Quali obiettivi stai cercando di raggiungere che non hai già raggiunto prima?",shape=box,color=blue];
		207 -> 212;
	204 [label="Aha. E ora so che sei un bugiardo oltre che un ladro di ricordi, Usurpatore.",shape=box,color=blue];
		204 -> 209;
	205 [label="Update boolean RoatheKnowsReset",color=orange];
		205 -> 210;
	208 [label="Grazie all'utilizzo del Kuva e del Teatro Yuvan, siamo diventati fondamentalmente e funzionalmente immortali. Riesci a comprendere quanto questo diventi totalmente e interamente faticoso?",shape=box,color=blue];
		208 -> 213;
		208 -> 214;
	211 [label="Update boolean RoatheResetScrewedUp",color=orange];
		211 -> 215;
