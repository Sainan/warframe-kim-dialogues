		212 -> 217 [label=false,color=brown];
		212 -> 218 [label=false,color=brown];
	209 [label="Chat ends.",color=orange];
	210 [label="Allora perché vieni a farmi domande di cui conosci già la risposta?",shape=box,color=blue];
		210 -> 201;
		210 -> 202;
	213 [label="Che tu ci creda o no, ho una certa esperienza in merito.",shape=box,color=red];
		213 -> 219;
	214 [label="Posso, in realtà. Ma per cortesia, continua.",shape=box,color=red];
		214 -> 220;
	215 [label="Ora, questo lo trovo affascinante... hai 'mandato tutto all'aria' con me, o hai 'mandato tutto all'aria' con Lyon o Marie?",shape=box,color=blue];
		215 -> 221;
		215 -> 222;
		215 -> 223;
	217 [label="Beh, vedi, hai tutta questa... cosa sul perché hai preso il siero, e io... ti ho detto due cosine sbagliate al momento sbagliato.",shape=box,color=red];
		217 -> 225;
	218 [label="Io... sto cercando di conquistare il cuore di uno di voi, e... ho davvero... rovinato tutto...",shape=box,color=red];
		218 -> 226;
	216 [label="Sto cercando di convincere te e gli altri ad aiutarmi a riunire Loid con la famiglia al piano di sopra e... non...",shape=box,color=red];
		216 -> 224;
	219 [label="Hai vissuto un'esperienza di morte eterna, per quanto ne so. Il che è molto più interessante - eppure alla fine hai trovato un motivo per diventare insensibile a tutto ciò.",shape=box,color=blue];
		219 -> 220;
	220 [label="Il mio punto era questo - sono abituato, anzi, abbastanza abituato - alle macchinazioni e agli intrighi che noi Orokin mettiamo in atto l'uno contro l'altro per divertirci. È semplicemente il modo in cui passiamo il tempo.",shape=box,color=blue];
		220 -> 227;
