		274 -> 282;
	271 [label="Il tradimento.",shape=box,color=blue];
		271 -> 279;
	275 [label="Ma ho dei flash. Frammenti e pezzetti in un corridoio dorato. Una voce che ho riconosciuto - ma non un volto. Era Albrecht, ma non quello che conoscevo.",shape=box,color=blue];
		275 -> 283;
