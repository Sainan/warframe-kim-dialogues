	279 [label="Perché?",shape=box,color=blue];
		279 -> 287;
	283 [label="Un dolore bruciante, lancinante. Il più forte che avessi mai provato prima. E un mio precedente corpo aveva perso un braccio e una gamba in un'esplosione in guerra, Drifter. Sono stato ricoperto di ustioni troppo gravi per potermi riprendere se non fosse stato per il Kuva. Ho conosciuto l'agonia.",shape=box,color=blue];
		283 -> 291;
	284 [label="Grazie. Possiamo procedere.",shape=box,color=blue];
		284 -> 292;
	285 [label="Mi chiedo... quante battaglie avrei dovuto combattere, se avessi avuto un tale potere?",shape=box,color=blue];
