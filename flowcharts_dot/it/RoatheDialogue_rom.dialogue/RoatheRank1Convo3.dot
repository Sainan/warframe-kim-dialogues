	5741 [label="Perché?",shape=box,color=blue];
		5741 -> 5742;
	288 [label="Secondo: quanto devi essere incapetente?! Sono abbastanza certo che se provassi semplicemente a dare da mangiare e da bere al Sacerdote una volta al giorno, otterresti il suo amore e la sua adorazione eterna.",shape=box,color=blue];
		288 -> 296;
	289 [label="Secondo: Hai provato a zoppicare davanti a lei? A fingere di essere malato? A sbattere le ciglia? A dirle semplicemente che era carina? Non sembra poi così difficile da corteggiare.",shape=box,color=blue];
		289 -> 297;
	290 [label="Sono seduto qui e due cose mi colpiscono immediatamente, a conferma del mio sospetto:",shape=box,color=blue];
		290 -> 298;
	287 [label="Ma questa è una conversazione per un altro giorno. Perché ho una proposta per te. Una che credo ti interesserà molto di più.",shape=box,color=blue];
		287 -> 295;
	291 [label="Il mio corpo veniva fatto a pezzi e rimodellato. Con la forza. Non l'ho scelto io. Non so se sia stato lo stesso per gli altri.",shape=box,color=blue];
		291 -> 299;
	292 [label="Ho utilizzato campioni del mio sangue per ricostruire un Helminth, con tentativi ed errori. Non è stato un compito semplice, non avendo accesso ad alcun equipaggiamento Orokin. O ad alcun equipaggiamento, in generale, a parte quello che potevo rubare da...",shape=box,color=blue];
		292 -> 300;
	293 [label="Quante menti avrei contaminato se avessi avuto i tuoi doni a mia disposizione?",shape=box,color=blue];
		293 -> 301;
	294 [label="Mi chiedo... quante battaglie avrei dovuto combattere, se avessi avuto un tale potere?",shape=box,color=blue];
		294 -> 302;
	5742 [label="Ma questa è una conversazione per un altro giorno. Perché ho una proposta per te. Una che credo ti interesserà molto di più.",shape=box,color=blue];
		5742 -> 5739;
	296 [label="Non fraintendermi! Sono piuttosto impressionato da quanto tu sia subdolo. ",shape=box,color=blue];
		296 -> 304;
	297 [label="Terzo: mi siedo qui e all'improvviso mi ritrovo profondamente sopraffatto dalle realizzazioni, dopo aver confermato i miei sospetti: ",shape=box,color=blue];
		297 -> 305;
	298 [label="Mi chiedo... quante battaglie avrei dovuto combattere, se avessi avuto un tale potere?",shape=box,color=blue];
		298 -> 306;
	295 [label="Farò finta di non sapere nulla davanti ai fanatici...",shape=box,color=blue];
		295 -> 303;
	299 [label="Ricordo le scale fredde sotto di me, quando venni lasciato cadere su di esse. Le scale della cattedrale, che ora riconosco come tali, perché Lyon e Marie mi hanno raccontato la storia attraverso i loro ricordi.",shape=box,color=blue];
		299 -> 307;
	300 [label="Non gli farò il favore di chiamarli ospedali \"rudimentali\". Albrecht aveva usato un Helminth per trasportarci nel passato. Come se fosse cresciuto nel passato non lo so, dato che doveva essere già lì prima del nostro arrivo. Si seccò e morì nel processo - sospettavo che un altro potesse essere usato per un viaggio di ritorno.",shape=box,color=blue];
		300 -> 308;
	301 [label="Poi, mi colpisce l'immediata furia e rabbia che provo nel sapere che la mia mente è stata presa in giro non una, ma due volte nella storia recente. Ma c'è un'altra emozione che sopraggiunge a sconfiggere la rabbia. Una che ancora non comprendo del tutto.",shape=box,color=blue];
		301 -> 309;
