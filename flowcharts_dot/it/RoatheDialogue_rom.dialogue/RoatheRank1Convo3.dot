		346 -> 355;
		346 -> 356;
	350 [label="È lui che fugge dalla sua famiglia, dal suo amante, dalla lotta che ha iniziato con questo suo falso dio! Non sono io il dannato codardo tra noi!",shape=box,color=blue];
		350 -> 360;
	351 [label="Update boolean RoatheHelminth1",color=orange];
		351 -> 361;
	352 [label="Un dolore bruciante, lancinante. Il più forte che avessi mai provato prima. E un mio precedente corpo aveva perso un braccio e una gamba in un'esplosione in guerra, Drifter. Sono stato ricoperto di ustioni troppo gravi per potermi riprendere se non fosse stato per il Kuva. Ho conosciuto l'agonia.",shape=box,color=blue];
		352 -> 362;
	353 [label="Ma ricordati le mie parole, Drifter.",shape=box,color=blue];
		353 -> 363;
	354 [label="E, cosa ancora più importante - mi assicurerò che tu riesca a raggiungere il tuo obiettivo di far sì che Marie \"veda la luce\" riguardo Entrati, qualunque cosa accada, questa volta.",shape=box,color=blue];
		354 -> 364;
	5747 [label="Siamo d'accordo?",shape=box,color=blue];
