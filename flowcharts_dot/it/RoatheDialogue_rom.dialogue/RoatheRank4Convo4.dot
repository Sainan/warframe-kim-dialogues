		j1050611308 -> j3434057410;
	j1572204488 [label="Adesso sono incuriosito.",shape=box,color=red];
		j1572204488 -> j3354160134;
	j3906880177 [label="Certo. Chiedi pure.",shape=box,color=red];
		j3906880177 -> j619001112;
