	"Chat ends." [color=orange];
	j2111090797 [label="Me lo chiedi dopo avermi raccontato quella storia su Ballas e Margulis, e non riguarda lui?",shape=box,color=red];
		j2111090797 -> j4063747416;
	j1910591125 [label="Dopo quello che ti ha fatto Albrecht e tutta questa storia del \"può un Orokin essere perdonato\", e non si tratta di lui?",shape=box,color=red];
		j1910591125 -> j4063747416;
	j2244684480 [label="Ok, ci sto. Credo davvero che \"tutti meritino di essere amati\"? Chiaramente questa è una questione di moralità e valori.",shape=box,color=red];
		j2244684480 -> j1323262677;
	j3964889197 [label="L'Orokin che mi ha detto di non aver mai conosciuto l'amore mi fa proprio questa domanda, e non riguarda lui?",shape=box,color=red];
		j3964889197 -> j4063747416;
	j2741160909 [label="L'Orokin che ha servito un'Esecutrice come sua concubina ma poi ha tramato per tradirla mi chiede questo e non riguarda lui?",shape=box,color=red];
		j2741160909 -> j4063747416;
	j4218365980 [label="Ti aspetti davvero che io creda che questa sia solo una questione filosofica?",shape=box,color=red];
		j4218365980 -> j4063747416;
	j4063747416 [label="Non voglio perdermi nei dettagli. Non fa altro che complicare le cose. \"Beh, vedi, questa persona ha fatto questo, e quell'altra persona ha fatto quello, il che nega questo\", e poi ci ritroviamo tutti sul banco dei testimoni.",shape=box,color=blue];
		j4063747416 -> j3279252486;
		j4063747416 -> j167679759;
	j1323262677 [label="+5 Chemistry",color=orange];
		j1323262677 -> j730699330;
	j3279252486 [label="O parli chiaro, o non parli affatto. Se non hai intenzione di dirmi di chi si tratta, allora non perderò tempo a parlare con te.",shape=box,color=red];
		j3279252486 -> j327162714;
	j167679759 [label="Bene. Giocheremo al tuo proverbiale giochetto.",shape=box,color=red];
		j167679759 -> j9637779;
	j730699330 [label="Grazie! Togliere i nomi da questo lo rende ancora più appetibile. Altrimenti ti perdi nei dettagli e non andremo da nessuna parte.",shape=box,color=blue];
		j730699330 -> j122582249;
	j327162714 [label="E nemmeno io lo farò con te, semplice.",shape=box,color=blue];
		j327162714 -> j155006797;
	j9637779 [label="Bene. La domanda è proprio questa. Tutti meritano di essere amati?",shape=box,color=blue];
		j9637779 -> j3723596181;
	j122582249 [label="E sì, proprio così. Nessuno si chiede se l'eroe giusto meriti di amare ed essere amato. Questo non viene mai messo in discussione nelle nostre grandi favole, vero?",shape=box,color=blue];
		j122582249 -> j1679573397;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j3723596181 [label="Nessuno si chiede se l'eroe giusto meriti di amare ed essere amato. Questo non viene mai messo in discussione nelle nostre grandi favole, vero?",shape=box,color=blue];
		j3723596181 -> j1679573397;
	j1679573397 [label="Solo il Bastardo. Il Cattivo. Il Mostro. Il Distruttore di Mondi Moralmente Indigente.",shape=box,color=blue];
		j1679573397 -> j1718373384;
		j1679573397 -> j30305388;
	j1718373384 [label="[Lascialo continuare.]",shape=box,color=red];
		j1718373384 -> j2831569194;
	j30305388 [label="Il Diavolo?",shape=box,color=red];
		j30305388 -> j890048957;
	j2831569194 [label="Add 1 to Thermostat counter",color=orange];
		j2831569194 -> j3740290083;
	j890048957 [label="Ascolta, Usurpatore.",shape=box,color=blue];
		j890048957 -> j1817221348;
	j3740290083 [label="Propongo la seguente affermazione; l'unica cosa che rende queste creature moralmente emarginate è il fatto di avere altri che le emarginano moralmente.",shape=box,color=blue];
		j3740290083 -> j2056282214;
	j1817221348 [label="Add -1 to Thermostat counter",color=orange];
		j1817221348 -> j3168712525;
		j1817221348 -> j3308247384;
	j2056282214 [label="Se un individuo commettesse \"azioni malvagie\" nel vuoto, come singola persona, senza nessuno intorno a giudicare, non ci sarebbe nessuno a giudicarlo male, vero?",shape=box,color=blue];
		j2056282214 -> j506205195;
	j3168712525 [label="Voglio dire...",shape=box,color=red];
		j3168712525 -> j3526248851;
	j3308247384 [label="Mi dispiace.",shape=box,color=red];
		j3308247384 -> j3526248851;
	j506205195 [label="Se un bastardo brucia una foresta e non c'è nessuno per sentirlo, fa rumore? L'unico metro di giudizio che abbiamo per giudicare le azione \"buone\" e \"cattive\" sono le azioni degli altri.",shape=box,color=blue];
		j506205195 -> j166061405;
		j506205195 -> j1703989485;
		j506205195 -> j2164062973;
	j3526248851 [label="Ma sì, visto che hai insistito a tirarlo fuori, Il Diavolo! Il massimo di tutti i mali!",shape=box,color=blue];
		j3526248851 -> j3740290083;
	j166061405 [label="Devono esserci azionie che sono malvagie di per sé.",shape=box,color=red];
		j166061405 -> j1764175650;
	j1703989485 [label="Stai dicendo che una persona ha bisogno di un'altra persona per essere \"malvagia\"?",shape=box,color=red];
		j1703989485 -> j2337962210;
	j2164062973 [label="Non so se sono d'accordo.",shape=box,color=red];
		j2164062973 -> j1764175650;
	j1764175650 [label="Tutte le azioni più orribili che una persona possa commettere richiedono almeno una seconda persona per essere commesse. Una persona singola, nel vuoto, non può fare nulla di condannabile. Distruggere un pianeta disabitato? Oh, guai.",shape=box,color=blue];
		j1764175650 -> j2005330054;
	j2337962210 [label="Sì. Pensaci. Tutte le azioni più orribili che una persona possa commettere richiedono almeno una seconda persona per essere commesse. Una persona singola, nel vuoto, non può fare nulla di condannabile. Distruggere un pianeta disabitato? Oh, guai.",shape=box,color=blue];
		j2337962210 -> j2005330054;
	j2005330054 [label="E senza una società che li rimproveri dicendo loro \"non avreste dovuto fare quella terribile azione\", come potremmo sapere che quell'atto è stato così orribile? Non lo sapremmo.",shape=box,color=blue];
		j2005330054 -> j349145934;
	j349145934 [label="Come ho detto, è semplicemente un mentro di misura utilizzato dalla società per giudicare le tue azioni rispetto a quelle degli altri.",shape=box,color=blue];
		j349145934 -> j2688528396;
		j349145934 -> j2839233622;
	j2688528396 [label="Diciamo che hai ragione. Diciamo che mi hai convinto e che il bene e il male sono solo... costrutti sociali. E allora?",shape=box,color=red];
		j2688528396 -> j2427985703;
	j2839233622 [label="Penso che le azioni possano essere buone o cattive anche al di fuori del loro contesto sociale. Altrimenti, perché così tante di esse sarebbero simili in società così diverse?",shape=box,color=red];
		j2839233622 -> j597069442;
	j2427985703 [label="Add -1 to Thermostat counter",color=orange];
		j2427985703 -> j3099601334;
	j597069442 [label="Add 1 to Thermostat counter",color=orange];
		j597069442 -> j4098198028;
		j597069442 -> j2232065655;
	j3099601334 [label="+5 Chemistry",color=orange];
		j3099601334 -> j3177508435;
	j4098198028 [label="Ma per amore della discussione, continuiamo. ",shape=box,color=red];
		j4098198028 -> j3099601334;
	j2232065655 [label="Probabilmente è meglio fermarci qui. Non credo che terminerà bene. [Fine.]",shape=box,color=red];
		j2232065655 -> j1016638082;
	j3177508435 [label="Molto bene. Se possiamo dire che il \"malvagio\" non è uno stato dell'essere ma un costrutto sociale, allora possiamo concordare sul fatto che tutti i racconti della Grande Malvagità sono, a loro volta, costrutti sociali. Favole.",shape=box,color=blue];
		j3177508435 -> j2751726956;
	j1016638082 [label="Come desideri.",shape=box,color=blue];
		j1016638082 -> "Chat ends.";
	j2751726956 [label="Perché allora in tutte le grandi favole coloro che commettono le Peggiori Atrocità vengono lasciati a marcire da soli?",shape=box,color=blue];
		j2751726956 -> j3472641718;
		j2751726956 -> j3216729154;
		j2751726956 -> j648734863;
		j2751726956 -> j803431147;
	j3472641718 [label="Perché sono incapaci di amare?",shape=box,color=red];
		j3472641718 -> j228947752;
	j3216729154 [label="Perché non c'è spazio nel loro cuore per l'amore?",shape=box,color=red];
		j3216729154 -> j1739385870;
	j648734863 [label="Perché non meritano di essere amati?",shape=box,color=red];
		j648734863 -> j2914793019;
	j803431147 [label="Perché stiamo cercando di dare una lezione?",shape=box,color=red];
		j803431147 -> j875260205;
	j228947752 [label="A volte, sì, vengono mostrati come una sorta di malvagità disumana, incapace di amare. Ma perché? Direi che tutte le grandi favole esistono per insegnare una lezione, non è vero?",shape=box,color=blue];
		j228947752 -> j3952664275;
	j1739385870 [label="A volte, sì, viene dimostrato che sono troppo preoccupati per le loro Peggiori Atrocità per sminuirsi con queste cosiddette \"Cose Triviali\". Ma perché? Tutte le grandi favole esistono per impartire una lezione, non è vero?",shape=box,color=blue];
		j1739385870 -> j3952664275;
	j2914793019 [label="Mmm, ora mi stai semplicemente ripetendo le mie parole, Usurpatore. Abbiamo giò deciso che \"meritare\" è relativo. Rifletti. Tutte le grandi favole esistono per impartire una lezione, no?",shape=box,color=blue];
		j2914793019 -> j3952664275;
	j875260205 [label="+5 Chemistry",color=orange];
		j875260205 -> j3633075462;
	j3952664275 [label="E se dovessimo mostrare una Malvagità che vive in pace, felice, e nell'amore... beh... che tipo di lezione ci insegnerebbe?",shape=box,color=blue];
		j3952664275 -> j935369028;
		j3952664275 -> j2671975992;
		j3952664275 -> j1408185213;
	j3633075462 [label="Questa sarebbe la mia teoria, sì! Tutte le grandi favole esistono per insegnare una lezione, no?",shape=box,color=blue];
		j3633075462 -> j3952664275;
	j935369028 [label="È difficile conciliare il fatto che qualcuno sia \"malvagio\" e che sia anche capace di amare.",shape=box,color=red];
		j935369028 -> j362925635;
	j2671975992 [label="Che forse le loro \"azioni malvagie\" potrebbero ancora essere redente attraverso l'amore?",shape=box,color=red];
		j2671975992 -> j1272463361;
	j1408185213 [label="Che coloro che fanno \"cose malvagie\" potrebbero comunque avere valore per qualcun altro in questo mondo e quindi non essere \"puramente malvagi\"?",shape=box,color=red];
		j1408185213 -> j2794092928;
	j362925635 [label="Check boolean RoatheMargulis1",color=orange];
		j362925635 -> j1458888043 [label=true,color=green];
		j362925635 -> j4181974442 [label=false,color=brown];
	j1272463361 [label="Add 1 to Thermostat counter",color=orange];
		j1272463361 -> j3042733107;
	j2794092928 [label="Add -1 to Thermostat counter",color=orange];
		j2794092928 -> j903104473;
	j1458888043 [label="+5 Chemistry",color=orange];
		j1458888043 -> j3941620242;
	j4181974442 [label="+5 Chemistry",color=orange];
		j4181974442 -> j3342632906;
	j3042733107 [label="Sembri uno dei fanatici. \"Redenzione\". Ma stai bussando alla porta della verità. Perché stai insinuando che le due cose non possano esistere contemporaneamente nel nostro mondo, e questo è vero, non è vero? Amore e male non possono coesistere nella società.",shape=box,color=blue];
		j3042733107 -> j603738447;
	j903104473 [label="Ci sei vicino, ma non ci sei ancora. Sì, ma fai un passo avanti. Cosa significherebbe se una persona capace di azioni malvagie fosse comunque amata da un'altra? Che conseguenze avrebbe questo per la società?",shape=box,color=blue];
		j903104473 -> j603738447;
	j3941620242 [label="Esatto! Queste due cose non vogliono convivere nella nostra mente, no? Quando ti ho raccontato la storia di Ballas e Margulis, è stato difficile accettare che il loro amore fosse stato un tempo reale, non è vero?",shape=box,color=blue];
		j3941620242 -> j3218874121;
	j3342632906 [label="Esatto! Queste due cose non vogliono convivere nella nostra mente, vero? Se ti dicessi che Ballas e Margulis un tempo erano molto innamorati prima che andasse tutto storto, mi crederesti?",shape=box,color=blue];
		j3342632906 -> j3218874121;
	j603738447 [label="Check boolean RoatheMargulis1",color=orange];
		j603738447 -> j2367323686 [label=true,color=green];
		j603738447 -> j1749926160 [label=false,color=brown];
	j3218874121 [label="Senza addentrarmi nei dettagli e discostarmi troppo dalla mia regola di mantenere le cose puramente filosofiche, questi sono un punto di riferimento comune per entrambi.",shape=box,color=blue];
		j3218874121 -> j4122153324;
	j2367323686 [label="Quando ti ho raccontato la storia di Ballas e Margulis, è stato difficile accettare che il loro amore fosse stato un tempo reale, non è vero?",shape=box,color=blue];
		j2367323686 -> j3218874121;
	j1749926160 [label="Se ti dicessi che Ballas e Margulis un tempo erano molto innamorati prima che andasse tutto storto, mi crederesti?",shape=box,color=blue];
		j1749926160 -> j3218874121;
	j4122153324 [label="È indubbio che Ballas fosse capace di alcune delle forme più pure di crudeltà che l'umanità abbia mai conosciuto. Eppure conosceva l'amore. Reciproco. ",shape=box,color=blue];
		j4122153324 -> j818370609;
	j818370609 [label="Questo è un fatto, anche se ora potresti volerlo negare, Ballas e Margulis si amavano profondamente. Semplicemente, è andata terribilmente male.",shape=box,color=blue];
		j818370609 -> j1105431060;
	j1105431060 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j1105431060 -> j2620807664;
	j2620807664 [label="Ma dobbiamo ripulire quella storia dal loro amore. Dobbiamo dire che non è esistito. Dobbiamo dire che non era reale, che era una falsità. Perché?",shape=box,color=blue];
		j2620807664 -> j3473140487;
		j2620807664 -> j2785880007;
		j2620807664 -> j2648224466;
	j3473140487 [label="Non saprei.",shape=box,color=red];
		j3473140487 -> j2532073418;
	j2785880007 [label="Perché l'amore è l'emozione umana per eccellenza e se ci permettiamo di pensare che qualcuno possa essere amato, lo umanizziamo.",shape=box,color=red];
		j2785880007 -> j3399527894;
	j2648224466 [label="Perché il male deve guardarsi allo specchio e impegnarsi per cambiare se stesso. Deve essere punito. E amare ed essere amati è la ricompensa finale.",shape=box,color=red];
		j2648224466 -> j564193110;
	j2532073418 [label="E ho fatto tutto questo lavoro per niente. Che vergogna.",shape=box,color=blue];
		j2532073418 -> "Chat ends.";
	j3399527894 [label="Add -2 to Thermostat counter",color=orange];
		j3399527894 -> j2577333902;
	j564193110 [label="Add 2 to Thermostat counter",color=orange];
		j564193110 -> j1439466750;
	j2577333902 [label="Benissimo, Usurpatore. Benissimo. Esattamente così. Il Grande Male deve sempre essere \"altro\" e non dobbiamo mai, mai simpatizzare con lui. Se gli permettiamo di provare amore ed essere amato? Credo che il mondo intero potrebbe crollare intorno a noi.",shape=box,color=blue];
		j2577333902 -> j2132045348;
	j1439466750 [label="Molto bene, Usurpatore. Molto bene. Esattamente così. Dobbiamo tenere a freno il Grande Male. Se gli permettiamo di provare amore ed essere amato? Credo che il mondo intero potrebbe crollare intorno a noi.",shape=box,color=blue];
		j1439466750 -> j2132045348;
