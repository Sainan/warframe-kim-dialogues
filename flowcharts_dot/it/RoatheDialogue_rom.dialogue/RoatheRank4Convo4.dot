	"RoatheRank4Convo4 begins." [color=orange];
		"RoatheRank4Convo4 begins." -> j1050611308;
	j1050611308 [label=" Ho una domanda filosofica per te, Usurpatore. E prima che tu tragga conclusioni affrettate su chi mi riferisco, che sia a me stesso, a Ballas o, che il Void mi maledica, ad Albrecht, è puramente un esperimento mentale. Giochiamo?",shape=box,color=blue];
		j1050611308 -> j1572204488;
