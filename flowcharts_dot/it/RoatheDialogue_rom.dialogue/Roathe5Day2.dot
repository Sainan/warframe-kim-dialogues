		j2426506870 -> "Chat ends.";
	j457940825 [label="Ti chiedo di risolvere questo problema. È colpa tua. Lo sento, mi artiglia, mi dilania. Come una bestia immensa.",shape=box,color=blue];
		j457940825 -> j1517567407;
	j3233881022 [label="Sarebbe poco educato non riconoscere che tutto questo è dovuto in parte al tuo aiuto, tesoro. Grazie.",shape=box,color=blue];
