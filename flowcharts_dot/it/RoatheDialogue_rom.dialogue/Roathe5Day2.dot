	j2313455961 [label="Qualunque cosa tu voglia da me, non l'avrai ora. Tanto vale che tu la finisca e mi cancelli dalla memoria questa nostra farsa.",shape=box,color=blue];
		j2313455961 -> j1606932474;
	j1493680617 [label="Beh, qualunque cosa tu voglia da me, non l'avrai ora. Tanto vale che tu la finisca e mi cancelli dalla memoria questa nostra farsa.",shape=box,color=blue];
		j1493680617 -> j1606932474;
