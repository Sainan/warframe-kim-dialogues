		j617454213 -> "Chat ends." [label="x <= 21",color=purple];
		j617454213 -> "Chat ends." [label="false",color=purple];
	j4194430604 [label="Un nuovo giorno sorge e mi ritrovo a pianificare il futuro per la prima volta da... tanto tempo. A pensare a come potrei rimodellare il mondo intorno a me. A come potrei utilizzare ciò che so. Ciò che sono. Come potrei sfruttarlo al meglio.",shape=box,color=blue];
		j4194430604 -> j3984658869;
	j3263504267 [label="Un nuovo giorno sorge e mi ritrovo a pianificare il futuro per la prima volta da... tanto tempo. Rifletto su cosa questo significhi per me, su cosa voglio, su come vorrei rimodellare il mio ambiente per adattarlo a me.",shape=box,color=blue];
		j3263504267 -> j2558396776;
	j2215077507 [label="Posso chiederti esattamente cosa stai aspettanto? Sono qui seduto con il ricordo degli eventi ancora perfettamente intatto. Mi hai promesso che li avresti cancellati dalla mia mente.",shape=box,color=blue];
		j2215077507 -> j2490185972;
		j2215077507 -> j331190067;
		j2215077507 -> j2064189354;
	j1931018344 [label="Hai già deciso? Sono un diavolo paziente, ma ho i miei limiti. Vuoi cancellare dalla mia mente questi ricordi o preferisci lasciarmi indugiare?",shape=box,color=blue];
		j1931018344 -> j1141742832;
		j1931018344 -> j2604367328;
	j285344299 [label="Eccoci, e qui resteremo. In questo Purgatorio. Spero che ti piaccia, perché non credo che faremo mai un passo oltre.",shape=box,color=blue];
		j285344299 -> j2171950327;
	j3982724896 [label="Cosa intendi?",shape=box,color=red];
		j3982724896 -> j2313455961;
	j2503924193 [label="Un po' dalla colonna A, un po' dalla colonna B?",shape=box,color=red];
		j2503924193 -> j1493680617;
	j3492300314 [label="Niente di tutto questo riguarda te, Roathe. Non ha mai riguardato te.",shape=box,color=red];
		j3492300314 -> j2426506870;
	j4100516730 [label="Stupido! Cosa hai fatto?! Perché, perché vai a scavare in caverne dove non sei il benvenuto?!",shape=box,color=blue];
		j4100516730 -> j457940825;
	"Chat ends." [color=orange];
