	j1031348333 [label="Tipico.",shape=box,color=red];
		j1031348333 -> j901614892;
	j68199555 [label="Aspetta. Perché?!",shape=box,color=red];
		j68199555 -> j3952098927;
	j173472662 [label="Hai detto che mi avresti aiutato se ti avessi aiutato a recuperare i tuoi ricordi. E l'ho fatto. Era il nostro contratto!",shape=box,color=red];
		j173472662 -> j1896137509;
	j50717700 [label="Aspetta. Perché non vuoi aiutarmi?",shape=box,color=red];
		j50717700 -> j1896137509;
	j1635164868 [label="Nulla.",shape=box,color=blue];
		j1635164868 -> "Chat ends.";
	j879363667 [label="Sono certo che mi arrabbierò terribilmente con te quando mi renderò conto che hai alterato i miei ricordi, ovviamente. E ti consiglio di non dirmi che è stato per mia richiesa, tesoro.",shape=box,color=blue];
		j879363667 -> j3447090760;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j1466456391 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1466456391 -> j272437021 [label=true,color=green];
		j1466456391 -> j3998777695 [label=false,color=brown];
	j2091625771 [label="Boolean IsDating is now false.",color=orange];
		j2091625771 -> j1792336866;
	j901614892 [label="Non essere così amareggiato solo perché ora ti rendi conto di essere stato giocato. Ti ho proposto i termini del contratto senza mai specificare la mia posizione. O forse non te ne sei accorto?",shape=box,color=blue];
		j901614892 -> j3138325536;
	j3952098927 [label="Ti ho proposto i termini del contratto senza mai specificare la mia posizione. O forse non te ne sei accorto?",shape=box,color=blue];
		j3952098927 -> j3138325536;
	j1896137509 [label="\"Ho bisogno di qualcuno che mi aiuti a registrare i miei ricordi e a riconciliarli. Una specie di assistente temporaneo.\"",shape=box,color=blue];
		j1896137509 -> j612583809;
	j3447090760 [label="Mi limiterò a sostenere che stai mentendo e questo probabilmente danneggerà irreparabilmente la mia opinione su di te.",shape=box,color=blue];
		j3447090760 -> j880757275;
		j3447090760 -> j2225656822;
	j272437021 [label="Ogni volta che parliamo non posso fare a mano di chiedermi se le rive che calpestiamo ti siano familiari o sconosciute. Se mi sto semplicemente ripetendo e se ho in serbo qualche nuova sorpresa.",shape=box,color=blue];
		j272437021 -> j1575885988;
	j3998777695 [label="Hai rispettato la tua parte del contratto. Siamo ora giunti al penultimo punto, in cui dobbiamo definire i dettagli di come definiremo il nostro metodo di attacco.",shape=box,color=blue];
		j3998777695 -> j4226538354;
	j1792336866 [label="Boolean RoatheDating is now false.",color=orange];
		j1792336866 -> j4247252692;
	j3138325536 [label="Ho semplicemente detto cosa avresti voluto dall'accordo. Non ho mai detto cosa dovevi fare, o perché, per ottenerli. E tu hai accettato alla ceca.",shape=box,color=blue];
		j3138325536 -> j3197589952;
	j612583809 [label="Mentre hai soddisfatto il primo criterio, 'registrare i miei ricordi', hai fallito clamorosamente nel secondo, 'aiutarmi a riconciliarli'.",shape=box,color=blue];
		j612583809 -> j2656644415;
	j880757275 [label="No. Non posso farlo. Non lo farò. Dobbiamo affrontare questa situazione insieme. Non possiamo semplicemente parlarne?",shape=box,color=red];
		j880757275 -> j1806990105;
	j2225656822 [label="Io... non c'è davvero nessun altro modo?",shape=box,color=red];
		j2225656822 -> j1806990105;
	j1575885988 [label="Comunque, preferirei che non me lo dicessi. Odio essere troppo prevedibile. Comunque, mi hai aiutato a risolvere una questione di fondamentale importanza per me. ",shape=box,color=blue];
		j1575885988 -> j4044971173;
	j4226538354 [label="Questa battaglia deve essere combattuta su tre fronti. Tutti devono lavorare insieme affinché questa guerra sia vinta.",shape=box,color=blue];
		j4226538354 -> j3230042627;
		j4226538354 -> j1382120189;
	j4247252692 [label="Beh, qualunque cosa tu voglia da me, non l'avrai ora. Tanto vale che tu la finisca e mi cancelli dalla memoria questa nostra farsa, 'caro Drifter'.",shape=box,color=blue];
		j4247252692 -> j1606932474;
	j3197589952 [label="Credo che questo sia ciò che chiamavano un \"assegno in bianco\" in termini antichi? E tu l'hai firmato molto volentieri.",shape=box,color=blue];
		j3197589952 -> j522178933;
		j3197589952 -> j384463942;
	j2656644415 [label="Difficilmente direi che sono stati riconciliati, no?",shape=box,color=blue];
		j2656644415 -> j2705009848;
	j1806990105 [label="No. Se vuoi che il maggiordomo salga di sopra? Cancellami dalla mente tutte queste sciocchezze come ti ho chiesto. Se non ti interessa? Allora fai come vuoi. A me non importa.",shape=box,color=blue];
		j1806990105 -> j4239473415;
	j4044971173 [label="Ho dormito meglio stanotte di quanto non abbia fatto da molto tempo. Direi 'più a lungo di quanto riesca a ricordare', ma sarebbe uno scherzo di pessimo gusto.",shape=box,color=blue];
		j4044971173 -> j763644487;
	j3230042627 [label="Pardon me?",shape=box,color=red];
		j3230042627 -> j3902192914;
	j1382120189 [label="Stiamo parlando di Loid?",shape=box,color=red];
		j1382120189 -> j3491588336;
	j522178933 [label="C'è un modo per farti cambiare idea?",shape=box,color=red];
		j522178933 -> j450575188;
	j384463942 [label="Come posso uscire da questa situazione?",shape=box,color=red];
		j384463942 -> j1582990353;
	j2705009848 [label="Tu non hai rispettato la tua parte dell'accordo, quindi io non rispetterò la mia.",shape=box,color=blue];
		j2705009848 -> j522178933;
		j2705009848 -> j2665989215;
	j4239473415 [label="Questo, e beh, ovviamente, la nostra amicizia personale è l'unica leva che ho in questa situazione. È così semplice.",shape=box,color=blue];
