		j3520789593 -> j1031348333;
		j3520789593 -> j68199555;
	j2477838672 [label="Non vedevo l'ora di vederlo tremare di terrore mentre saliva le scale in preda alla vergogna.",shape=box,color=blue];
		j2477838672 -> j173472662;
		j2477838672 -> j50717700;
	j1681609437 [label="Ma a te cosa importa?",shape=box,color=blue];
		j1681609437 -> j1635164868;
	j3466092710 [label="Può darsi. Probabilmente hai ragione. Ma non ho altre opzioni, no? Vale la pena tentare.",shape=box,color=blue];
		j3466092710 -> j879363667;
	j3737237277 [label="E se così fosse, allora puoi semplicemente ripetere l'atto. È come se avessi un dono inesauribile, no?",shape=box,color=blue];
		j3737237277 -> j879363667;
	j1100838860 [label="Molto probabilmente. Farò due più due e ti darò la colpa per aver fatto qualcosa che non ti ho chiesto di fare. Sono sicuro che supererai la tempesta.",shape=box,color=blue];
		j1100838860 -> j879363667;
	j2042884806 [label="Mm, sì, beh. So quanto ti piace questa mia 'coda appuntita'. ",shape=box,color=blue];
		j2042884806 -> j2665556245;
	j747456831 [label="Volevo solo esprimere la mia gratitudine. Senza soffermarmici.",shape=box,color=blue];
		j747456831 -> j4081414586;
	j1015650029 [label="Ora che abbiamo fatto questo, credo che abbiamo qualcos'altro di cui discutere, non è vero?",shape=box,color=blue];
