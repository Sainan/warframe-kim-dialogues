		j3730136264 -> j484616797;
		j3730136264 -> j2462630939;
	j2560432501 [label="Mm. Molto bene. Sono un diavolo paziente, ma le acque di quel pozzo possono esaurirsi col tempo, fidati.",shape=box,color=blue];
		j2560432501 -> "Chat ends.";
	j2502402834 [label="Capisco. Semplice, no?",shape=box,color=blue];
		j2502402834 -> j431793363;
	j2691557917 [label="Mm. Vedi di farlo. Sono un diavolo paziente, ma le acque di quel pozzo possono esaurirsi col tempo, fidati.",shape=box,color=blue];
		j2691557917 -> "Chat ends.";
	j2761506320 [label="Anche se questo significa rimanere intrappolati per sempre in questa situazione di stallo? Povero, triste, Usurpatore... molto bene. Il purgatorio è un miglioramento rispetto all'Inferno per un diavolo, non è vero?",shape=box,color=blue];
		j2761506320 -> j8380591;
	j4018373990 [label="Bene. Mettiti all'opera. Sono stanco di vivere con questa consapevolezza nella testa.",shape=box,color=blue];
		j4018373990 -> j378811769;
	j3458632792 [label="Ma che te ne importa? Hai tutto ciò che desideri, puoi ricavarlo dal mio vuoto cadavere. Le mie costole sono nude e sbiancate.",shape=box,color=blue];
		j3458632792 -> j1776100240;
	j3313343238 [label="Tragico, vero? Sapere che la feccia della famiglia Entrati non saprà mai che il maggiordomo marcisce qui, torcendosi le mani dal dolore? Tutto solo?",shape=box,color=blue];
		j3313343238 -> j1776100240;
	j1606932474 [label="Sarà l'unica via d'uscita per te, se è questo che cerchi. Se non ti interessa a te, allora non interessa a me. Fai quello che vuoi.",shape=box,color=blue];
		j1606932474 -> j615507176;
	j1517567407 [label="Liberami da questo. Liberami da questa piaga. Libera la mia mente da questi ricordi. So che puoi. Utilizza questo dono che hai e poni fine a tutto. Ora.",shape=box,color=blue];
		j1517567407 -> j164729908;
		j1517567407 -> j2531966137;
		j1517567407 -> j2809981808;
