		j3171052610 -> j3517608982;
		j3171052610 -> j3340164079;
	j1853919113 [label="Che beneficio ci porta? Tutto il beneficio del mondo! Certo, sei tu quello che ha sempre combattuto da solo. Non sei mai stato sottoposto alle tattiche di un esercito.",shape=box,color=blue];
		j1853919113 -> j2346762237;
