	j4002100057 [label="Sì. Credo che ciò che Entrati ha liberato dal Void fosse un dio informe che era lì nell'etere prima del nostro arrivo.",shape=box,color=red];
		j4002100057 -> j570612691;
	j1216398859 [label="Sì. Penso che tu stia dicendo un sacco di cazzate.",shape=box,color=red];
		j1216398859 -> j4099310853;
	j3325050255 [label="Sì. Credo tu abbia ragione. Non credo che esistesse prima che Entrati interagisse con esso. Voleva trovare un dio... così il Void ha sputato fuori qualcosa che finge di esserlo.",shape=box,color=red];
		j3325050255 -> j1546281648;
	j216069847 [label="Sì. Credo che la risposta sia da qualche parte nel mezzo. Forse prima non era una divinità, ma ora lo è. Credo che Entrati l'abbia generato nel momento in cui ha aperto il Void.",shape=box,color=red];
		j216069847 -> j4164357943;
	j570612691 [label="Semplicemente non riesco a capire cosa siamo. ",shape=box,color=red];
