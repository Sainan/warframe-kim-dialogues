	j865738880 [label="Non lo so.",shape=box,color=red];
		j865738880 -> j3607836512;
	j1160143209 [label="C'era semplicemente una discrepanza nella terminologia abbreviata. Che buffo.",shape=box,color=blue];
		j1160143209 -> j525823858;
