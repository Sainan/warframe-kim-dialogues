	j776748929 [label="Boolean RoatheDating is now false.",color=orange];
		j776748929 -> j178902881;
	j2284450335 [label="Glorioso! Finalmente il progresso è compiuto. Suonate le trombe, suonate le campane, qualcuno finalmente ha la ragione!",shape=box,color=blue];
		j2284450335 -> j4290145;
	j3145014734 [label="Mi viene da urlare. Potete semplicemente impegnarvi in qualcosa per una volta nella vostra miserabile vita?!",shape=box,color=blue];
