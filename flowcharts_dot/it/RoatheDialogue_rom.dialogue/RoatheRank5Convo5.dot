		j1270986928 -> j1598447514;
	j3746836697 [label="Anche se non avevo dubbi che avesti cambiato idea, Drifter. Sono piuttosto convincente. ",shape=box,color=blue];
		j3746836697 -> j1598447514;
	j4205843666 [label="Capisco. Albrecht lo ha trasformato in una 'divinità' del Void. E ora abbiamo una 'divinità' in libertà. Che fascino.",shape=box,color=blue];
		j4205843666 -> j3366079523;
		j4205843666 -> j1924657033;
	j3831206429 [label="In effetti.",shape=box,color=blue];
		j3831206429 -> "Chat ends.";
	j3415081687 [label="Un essere supremo. Qualcosa che ha autorità o potere totale e indiscutibile. ",shape=box,color=red];
		j3415081687 -> j2600152689;
