		4716 -> 4729;
	4717 [label="Che beneficio ci porta? Tutto il beneficio del mondo! Certo, sei tu quello che ha sempre combattuto da solo. Non sei mai stato sottoposto alle tattiche di un esercito.",shape=box,color=blue];
