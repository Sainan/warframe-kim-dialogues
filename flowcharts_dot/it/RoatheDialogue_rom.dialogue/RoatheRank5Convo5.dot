	j2930209474 [label="E questa tua Indifferenza è un'entità o una creatura suprema? Ed esercita potere su un aspetto di... Indifferenza. Di noncuranza?",shape=box,color=blue];
		j2930209474 -> j69165838;
		j2930209474 -> j865738880;
	j3598558809 [label="Aaah, capisco. Ora c'è un problema. Sì, le nostre definizioni non coincidevano. In quanto questa 'Indifferenza' è un'entità come la descrivi? Sì. Siamo d'accordo.",shape=box,color=blue];
		j3598558809 -> j1160143209;
	j2757405397 [label="Deludente. Ti credevo più intelligente di così. Ma permettimi di chiederti questo e di andare dritto al punto:",shape=box,color=blue];
		j2757405397 -> j3171052610;
	j2450893259 [label="Deludente. Ma permettimi di chiederti questo e di andare dritto al punto:",shape=box,color=blue];
		j2450893259 -> j3171052610;
	j3961894977 [label="Pacificatori. Perché deve sempre esserci un pacifista?",shape=box,color=blue];
		j3961894977 -> j3219065849;
	j2909401554 [label="Pertanto, nella tua modesta ignoranza, insinui che stiamo tutti brancolando nel buio.",shape=box,color=blue];
		j2909401554 -> j2516762448;
	j3263611632 [label="Oh, fantastico. Pensi che gli 'dei' non possano morire!",shape=box,color=blue];
		j3263611632 -> j3219065849;
	j2913195243 [label="E la tua logica è... che gli dei possono morire perché... gli 'dei' sono come i pobber?",shape=box,color=blue];
		j2913195243 -> j4039849482;
	j3459343244 [label="Beh, sì, è ovvio, ma seguimi, Drifter. Ho bisogno che ti concentri.",shape=box,color=blue];
