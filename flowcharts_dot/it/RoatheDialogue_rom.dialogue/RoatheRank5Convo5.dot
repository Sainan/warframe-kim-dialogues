	j3040960236 [label="Boolean DrifterMITWNotGod is now true.",color=orange];
		j3040960236 -> j2614230894;
	j747119220 [label="Vi odio, tipi da Eternalismo. Lo usate come scusa per tutto. Una volta che un Archimedeo pensa di averlo capito, ecco che si perde.",shape=box,color=blue];
		j747119220 -> j4083056098;
	j1675922630 [label="Puoi provarci.",shape=box,color=red];
