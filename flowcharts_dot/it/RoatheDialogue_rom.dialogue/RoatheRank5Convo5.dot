		j4099310853 -> j1210193261 [label=false,color=brown];
	j1546281648 [label="E da allora lo abbiamo alimentato con la paura.",shape=box,color=red];
		j1546281648 -> j3040960236;
	j4164357943 [label="Allo stesso modo in cui Rell ora esiste e non esiste, l'Indifferenza non è mai stata una divinità, eppure lo è sempre stata.",shape=box,color=red];
		j4164357943 -> j747119220;
	j1591048388 [label="Posso convincerti a riconsiderare la mia posizione? O le tue opinioni sull'argomento sono immutabili?",shape=box,color=blue];
		j1591048388 -> j1675922630;
		j1591048388 -> j1215429892;
	j3713094884 [label="Non mi sarei mai aspettato che tu fossi così delicato, caro Drifter. Ma per citare i fanatici, 'c'est la vie.'",shape=box,color=blue];
