digraph {
	"RoatheRank4Convo8 begins." [color=orange];
		"RoatheRank4Convo8 begins." -> j850222382;
		"RoatheRank4Convo8 begins." -> j4115718638;
	j850222382 [label="Com'è stata la tua infanzia, Roathe?",shape=box,color=red];
		j850222382 -> j3296932937;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j3296932937 [label="Mh? Domanda interessante. Com'era? Onestamente non ricordo molto. E le stelle e le sculture che contenevano quei ricordi probabilmente si sono ormai trasformate in polvere o sono state trasformate in Endo, immagino.",shape=box,color=blue];
		j3296932937 -> j2055142617;
	"Chat ends." [color=orange];
	j2055142617 [label="Temo di poterne ricordare solo le immagini più fugaci, dato che è accaduto tanto tempo fa. Mi chiedo se gran parte di ciò non l'abbia immaginato come in un sogno, o come se stessi associando delle immagini agli eventi che ho letto in un libro di storia.",shape=box,color=blue];
		j2055142617 -> j3892576289;
	j3892576289 [label="Quindi, lo ammetto, quello che ricordo è probabilmente terribilmente inaffidabile. Perché me lo chiedi?",shape=box,color=blue];
		j3892576289 -> j570441779;
		j3892576289 -> j1175621526;
		j3892576289 -> j2105705133;
	j570441779 [label="Anche se le storie sono false, sono comunque ciò che ti racconti dei tuoi anni formativi. Vale comunque la pena conoscerle.",shape=box,color=red];
		j570441779 -> j3524516673;
	j1175621526 [label="Sono curioso di sapere com'è stato crescere come nobiltà Orokin.",shape=box,color=red];
		j1175621526 -> j1855756776;
	j2105705133 [label="Mi chiedo cosa ti abbia reso così. Come hai fatto a diventare così.",shape=box,color=red];
		j2105705133 -> j3249455350;
	j3524516673 [label="+5 Chemistry",color=orange];
		j3524516673 -> j4114957851;
	j1855756776 [label="Fui spedito in quello che i fanatici chiamerebbero un 'collegio' in giovane età, come tutti i giovani Orokin destinati alla grandezza. Lì fui messo alla prova e addestrato per le mie inclinazioni e attitudini.",shape=box,color=blue];
		j1855756776 -> j3470782232;
		j1855756776 -> j724023050;
	j3249455350 [label="+5 Chemistry",color=orange];
		j3249455350 -> j2023624523;
	j4114957851 [label="Sono d'accordo, le bugie che ci raccontiamo sono spesso più importanti della verità. Un'intuizione meravigliosa, Usurpatore.",shape=box,color=blue];
		j4114957851 -> j2752942447;
	j3470782232 [label="I tuoi genitori ti hanno semplicemente mandato via? Per quanto tempo?",shape=box,color=red];
		j3470782232 -> j3774771604;
	j724023050 [label="Com'era lì?",shape=box,color=red];
		j724023050 -> j3579620605;
	j2023624523 [label="Stai cercando di capire dove sono stato 'sbagliato' esattamente? Lo capisco! Divertente. Non lo so, perché troverai molto nella mia infanzia che ti darà le risposte che cerchi.",shape=box,color=blue];
		j2023624523 -> j854053556;
	j2752942447 [label="Add -1 to Thermostat counter",color=orange];
		j2752942447 -> j1855756776;
	j3774771604 [label="Per tutta la mia giovane vita. Non credo di aver mai più rivisto i due che mi hanno generato. Forse alla cerimonia in cui sono stato proclamato migliore della classe?",shape=box,color=blue];
		j3774771604 -> j3840527840;
	j3579620605 [label="Penso che l'opinione cambierebbe notevolmente a seconda della persona con cui si parla. Quando sono arrivato, le percosse che ricevevo dai ragazzi più grandi erano violente e le lezioni brutalmente efficaci.",shape=box,color=blue];
		j3579620605 -> j4282174890;
	j854053556 [label="Add 1 to Thermostat counter",color=orange];
		j854053556 -> j1855756776;
	j3840527840 [label="Credo che quella sia stata la prima volta che hanno ritenuto opportuno rivendicarmi. Non ci do molto peso.",shape=box,color=blue];
		j3840527840 -> j1258593392;
	j4282174890 [label="Ma io, in ogni cosa, imparo in fretta. E ho imparato che se voglio eccellere in quel particolare ambito Archimedeo, è meglio che applichi tecniche creative per non rimanere invischiato nella feccia.",shape=box,color=blue];
		j4282174890 -> j3385741508;
		j4282174890 -> j781360967;
	j1258593392 [label="Non ricordo molto dei miei genitori. Mentre alcuni Orokin erano ansiosi di allevare la propria prole, i miei no. Erano abbastanza ansiosi di liberarsi di me e andare avanti con le loro vite.",shape=box,color=blue];
		j1258593392 -> j3518682697;
		j1258593392 -> j2767939331;
	j3385741508 [label="Gli Archimedei hanno permesso che ciò accadesse?",shape=box,color=red];
		j3385741508 -> j1411722465;
	j781360967 [label="È... orribile.",shape=box,color=red];
		j781360967 -> j3925824217;
	j3518682697 [label="Non sembra che ti abbia ostacolato in alcun modo nella vita.",shape=box,color=red];
		j3518682697 -> j978514257;
	j2767939331 [label="Mi dispiace. Sembra essere una vita triste.",shape=box,color=red];
		j2767939331 -> j978514257;
	j1411722465 [label="Mio povero Usurpatore, fu il Preside in persona a portare una bottiglia di Kuva e uno dei servi, una sera, quando le cose andarono troppo oltre per uno dei nuovi iniziati.",shape=box,color=blue];
		j1411722465 -> j980298600;
	j3925824217 [label="La tradizione è uno strumento potente, Usurpatore. Uno strumento potente e pericoloso che può essere usato per intrappolare molti uomini sani di mente in modi di pensare folli.",shape=box,color=blue];
		j3925824217 -> j2216270700;
	j978514257 [label="Al contrario. A causa della mia mancanza di legami familiari, avevo più tempo di dedicare a strategie militaristiche che ai miei coetanei sembravano arcaiche e antiquate. ",shape=box,color=blue];
		j978514257 -> j950606734;
	j980298600 [label="La tradizione è uno strumento potente. Uno strumento potente e pericoloso che può essere usato per intrappolare molti uomini sani di mente in modi di pensare folli.",shape=box,color=blue];
		j980298600 -> j245365178;
		j980298600 -> j2120494306;
	j2216270700 [label="Fu il Preside in persona a portare una bottiglia di Kuva e uno dei servi, una sera, quando le cose andarono troppo oltre per uno dei nuovi iniziati.",shape=box,color=blue];
		j2216270700 -> j245365178;
		j2216270700 -> j2120494306;
	j950606734 [label="Non immaginavo quanto questo mi sarebbe stato utile in futuro.",shape=box,color=blue];
		j950606734 -> j3035585819;
		j950606734 -> j1935961574;
	j245365178 [label="E i tuoi genitori?",shape=box,color=red];
		j245365178 -> j1258593392;
	j2120494306 [label="Avevi degli amici?",shape=box,color=red];
		j2120494306 -> j2683318579;
	j3035585819 [label="Ne è valsa la pena, secondo te?",shape=box,color=red];
		j3035585819 -> j3127013502;
	j1935961574 [label="Sembra però che tu abbia vissuto una vita solitaria.",shape=box,color=red];
		j1935961574 -> j1255342103;
	j2683318579 [label="No. Sono rimasto sulle mie. Ho imparato che la paura è una cosa facile da creare e manipolare negli altri, ma è un ghiaccio delicato e merlettato che si scioglie con qualsiasi esposizione alla luce.",shape=box,color=blue];
		j2683318579 -> j3979689803;
	j3127013502 [label="I miei coetanei non immaginavano quanto gli studi mi avrebbero aiutato in futuro. Ma se mi dovessi chiedere se si trattasse di una vittoria o di una sconfitta netta?",shape=box,color=blue];
		j3127013502 -> j3738241467;
	j1255342103 [label="Sì, lo è stata. Ma è così che vanno le cose quando si vive la vita di un diavolo, no? Anche allora, venivo visto o come l'impotente servitore di seconda mano e il concubino, o come il sanguinario signore della guerra e il mostro scatenato.",shape=box,color=blue];
		j1255342103 -> j2874413881;
	j3979689803 [label="I mostri devono essere tenuti all'oscuro. E se volevo mantenere un'aura di pericolo intorno a me, allora dovevo restare da solo.",shape=box,color=blue];
		j3979689803 -> j3518682697;
		j3979689803 -> j2767939331;
	j3738241467 [label="Mh. Non lo so.",shape=box,color=blue];
		j3738241467 -> j680268803;
		j3738241467 -> j3478295525;
	j2874413881 [label="Non sono mai stato il benvenuto né tra coloro che erano al di sopra della mia posizione né tra coloro che erano al di sotto. E non avevo nessuno con cui parlare.",shape=box,color=blue];
		j2874413881 -> j299591844;
	j680268803 [label="Hai un'altra possibilità per rimediare a ciò che hai fatto. Loro no. ",shape=box,color=red];
		j680268803 -> j395988887;
	j3478295525 [label="Beh, loro sono morti e tu no. Quindi suppongo di sì.",shape=box,color=red];
		j3478295525 -> j4069498500;
	j299591844 [label="Boolean RoatheUnloved2 is now true.",color=orange];
		j299591844 -> j3726608533;
		j299591844 -> j3494093351;
	j395988887 [label="Add 1 to Thermostat counter",color=orange];
		j395988887 -> j971407618;
	j4069498500 [label="Add -1 to Thermostat counter",color=orange];
		j4069498500 -> j971407618;
	j3726608533 [label="Hai un'altra possibilità per rimediare a ciò che hai fatto. Loro no.",shape=box,color=red];
		j3726608533 -> j395988887;
	j3494093351 [label="Beh, almeno hai il resto del tuo futuro da decidere. Loro no.",shape=box,color=red];
		j3494093351 -> j4069498500;
	j971407618 [label="+5 Chemistry",color=orange];
		j971407618 -> j2250317313;
	j2250317313 [label="Vedremo, suppongo. Non è vero?",shape=box,color=blue];
		j2250317313 -> "Chat ends.";
}