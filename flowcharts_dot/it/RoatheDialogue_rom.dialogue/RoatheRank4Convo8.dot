digraph {
	3120 [label="RoatheRank4Convo8 begins.",color=orange];
		3120 -> 3121;
		3120 -> 3122;
	3121 [label="Com'è stata la tua infanzia, Roathe?",shape=box,color=red];
		3121 -> 3123;
	3122 [label="[Fine.]",shape=box,color=red];
		3122 -> 3124;
	3123 [label="Mh? Domanda interessante. Com'era? Onestamente non ricordo molto. E le stelle e le sculture che contenevano quei ricordi probabilmente si sono ormai trasformate in polvere o sono state trasformate in Endo, immagino.",shape=box,color=blue];
		3123 -> 3125;
	3124 [label="Chat ends.",color=orange];
	3125 [label="Temo di poterne ricordare solo le immagini più fugaci, dato che è accaduto tanto tempo fa. Mi chiedo se gran parte di ciò non l'abbia immaginato come in un sogno, o come se stessi associando delle immagini agli eventi che ho letto in un libro di storia.",shape=box,color=blue];
		3125 -> 3126;
	3126 [label="Quindi, lo ammetto, quello che ricordo è probabilmente terribilmente inaffidabile. Perché me lo chiedi?",shape=box,color=blue];
		3126 -> 3127;
		3126 -> 3128;
		3126 -> 3129;
	3127 [label="Anche se le storie sono false, sono comunque ciò che ti racconti dei tuoi anni formativi. Vale comunque la pena conoscerle.",shape=box,color=red];
		3127 -> 3130;
	3128 [label="Sono curioso di sapere com'è stato crescere come nobiltà Orokin.",shape=box,color=red];
		3128 -> 3131;
	3129 [label="Mi chiedo cosa ti abbia reso così. Come hai fatto a diventare così.",shape=box,color=red];
		3129 -> 3132;
	3130 [label="+5 Chemistry",color=orange];
		3130 -> 3133;
	3131 [label="Fui spedito in quello che i fanatici chiamerebbero un 'collegio' in giovane età, come tutti i giovani Orokin destinati alla grandezza. Lì fui messo alla prova e addestrato per le mie inclinazioni e attitudini.",shape=box,color=blue];
		3131 -> 3134;
		3131 -> 3135;
	3132 [label="+5 Chemistry",color=orange];
		3132 -> 3136;
	3133 [label="Sono d'accordo, le bugie che ci raccontiamo sono spesso più importanti della verità. Un'intuizione meravigliosa, Usurpatore.",shape=box,color=blue];
		3133 -> 3137;
	3134 [label="I tuoi genitori ti hanno semplicemente mandato via? Per quanto tempo?",shape=box,color=red];
		3134 -> 3138;
	3135 [label="Com'era lì?",shape=box,color=red];
		3135 -> 3139;
	3136 [label="Stai cercando di capire dove sono stato 'sbagliato' esattamente? Lo capisco! Divertente. Non lo so, perché troverai molto nella mia infanzia che ti darà le risposte che cerchi.",shape=box,color=blue];
		3136 -> 3140;
	3137 [label="Add -1 to Thermostat",color=orange];
		3137 -> 3131;
	3138 [label="Per tutta la mia giovane vita. Non credo di aver mai più rivisto i due che mi hanno generato. Forse alla cerimonia in cui sono stato proclamato migliore della classe?",shape=box,color=blue];
		3138 -> 3141;
	3139 [label="Penso che l'opinione cambierebbe notevolmente a seconda della persona con cui si parla. Quando sono arrivato, le percosse che ricevevo dai ragazzi più grandi erano violente e le lezioni brutalmente efficaci.",shape=box,color=blue];
		3139 -> 3142;
	3140 [label="Add 1 to Thermostat",color=orange];
		3140 -> 3131;
	3141 [label="Credo che quella sia stata la prima volta che hanno ritenuto opportuno rivendicarmi. Non ci do molto peso.",shape=box,color=blue];
		3141 -> 3143;
	3142 [label="Ma io, in ogni cosa, imparo in fretta. E ho imparato che se voglio eccellere in quel particolare ambito Archimedeo, è meglio che applichi tecniche creative per non rimanere invischiato nella feccia.",shape=box,color=blue];
		3142 -> 3144;
		3142 -> 3145;
	3143 [label="Non ricordo molto dei miei genitori. Mentre alcuni Orokin erano ansiosi di allevare la propria prole, i miei no. Erano abbastanza ansiosi di liberarsi di me e andare avanti con le loro vite.",shape=box,color=blue];
		3143 -> 3146;
		3143 -> 3147;
	3144 [label="Gli Archimedei hanno permesso che ciò accadesse?",shape=box,color=red];
		3144 -> 3148;
	3145 [label="È... orribile.",shape=box,color=red];
		3145 -> 3149;
	3146 [label="Non sembra che ti abbia ostacolato in alcun modo nella vita.",shape=box,color=red];
		3146 -> 3150;
	3147 [label="Mi dispiace. Sembra essere una vita triste.",shape=box,color=red];
		3147 -> 3150;
	3148 [label="Mio povero Usurpatore, fu il Preside in persona a portare una bottiglia di Kuva e uno dei servi, una sera, quando le cose andarono troppo oltre per uno dei nuovi iniziati.",shape=box,color=blue];
		3148 -> 3151;
	3149 [label="La tradizione è uno strumento potente, Usurpatore. Uno strumento potente e pericoloso che può essere usato per intrappolare molti uomini sani di mente in modi di pensare folli.",shape=box,color=blue];
		3149 -> 3152;
	3150 [label="Al contrario. A causa della mia mancanza di legami familiari, avevo più tempo di dedicare a strategie militaristiche che ai miei coetanei sembravano arcaiche e antiquate. ",shape=box,color=blue];
		3150 -> 3153;
	3151 [label="La tradizione è uno strumento potente. Uno strumento potente e pericoloso che può essere usato per intrappolare molti uomini sani di mente in modi di pensare folli.",shape=box,color=blue];
		3151 -> 3154;
		3151 -> 3155;
	3152 [label="Fu il Preside in persona a portare una bottiglia di Kuva e uno dei servi, una sera, quando le cose andarono troppo oltre per uno dei nuovi iniziati.",shape=box,color=blue];
		3152 -> 3154;
		3152 -> 3155;
	3153 [label="Non immaginavo quanto questo mi sarebbe stato utile in futuro.",shape=box,color=blue];
		3153 -> 3156;
		3153 -> 3157;
	3154 [label="E i tuoi genitori?",shape=box,color=red];
		3154 -> 3143;
	3155 [label="Avevi degli amici?",shape=box,color=red];
		3155 -> 3158;
	3156 [label="Ne è valsa la pena, secondo te?",shape=box,color=red];
		3156 -> 3159;
	3157 [label="Sembra però che tu abbia vissuto una vita solitaria.",shape=box,color=red];
		3157 -> 3160;
	3158 [label="No. Sono rimasto sulle mie. Ho imparato che la paura è una cosa facile da creare e manipolare negli altri, ma è un ghiaccio delicato e merlettato che si scioglie con qualsiasi esposizione alla luce.",shape=box,color=blue];
		3158 -> 3161;
	3159 [label="I miei coetanei non immaginavano quanto gli studi mi avrebbero aiutato in futuro. Ma se mi dovessi chiedere se si trattasse di una vittoria o di una sconfitta netta?",shape=box,color=blue];
		3159 -> 3162;
	3160 [label="Sì, lo è stata. Ma è così che vanno le cose quando si vive la vita di un diavolo, no? Anche allora, venivo visto o come l'impotente servitore di seconda mano e il concubino, o come il sanguinario signore della guerra e il mostro scatenato.",shape=box,color=blue];
		3160 -> 3163;
	3161 [label="I mostri devono essere tenuti all'oscuro. E se volevo mantenere un'aura di pericolo intorno a me, allora dovevo restare da solo.",shape=box,color=blue];
		3161 -> 3146;
		3161 -> 3147;
	3162 [label="Mh. Non lo so.",shape=box,color=blue];
		3162 -> 3164;
		3162 -> 3165;
	3163 [label="Non sono mai stato il benvenuto né tra coloro che erano al di sopra della mia posizione né tra coloro che erano al di sotto. E non avevo nessuno con cui parlare.",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="Hai un'altra possibilità per rimediare a ciò che hai fatto. Loro no. ",shape=box,color=red];
		3164 -> 3167;
	3165 [label="Beh, loro sono morti e tu no. Quindi suppongo di sì.",shape=box,color=red];
		3165 -> 3168;
	3166 [label="Update boolean RoatheUnloved2",color=orange];
		3166 -> 3169;
		3166 -> 3170;
	3167 [label="Add 1 to Thermostat",color=orange];
		3167 -> 3171;
	3168 [label="Add -1 to Thermostat",color=orange];
		3168 -> 3171;
	3169 [label="Hai un'altra possibilità per rimediare a ciò che hai fatto. Loro no.",shape=box,color=red];
		3169 -> 3172;
	3170 [label="Beh, almeno hai il resto del tuo futuro da decidere. Loro no.",shape=box,color=red];
		3170 -> 3173;
	3171 [label="+5 Chemistry",color=orange];
		3171 -> 3174;
	3172 [label="Add 1 to Thermostat",color=orange];
		3172 -> 3171;
	3173 [label="Add -1 to Thermostat",color=orange];
		3173 -> 3171;
	3174 [label="Vedremo, suppongo. Non è vero?",shape=box,color=blue];
		3174 -> 3175;
	3175 [label="Chat ends.",color=orange];
}