	3 [label="Devo davvero complimentarmi con te per la tua audacia! Davvero, sei sicuro di non essere un Orokin? Forse stai nascondendo la tua pelle cerulea per non allertare gli altri?!",shape=box,color=blue];
		3 -> 8;
