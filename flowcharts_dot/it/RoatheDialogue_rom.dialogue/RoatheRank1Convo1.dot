digraph {
	"RoatheRank1Convo1 begins." [color=orange];
		"RoatheRank1Convo1 begins." -> j3998890108;
	j3998890108 [label="Evaluate expressions on HellStory counter",color=orange];
		j3998890108 -> j301998835 [label="x >= 21",color=purple];
		j3998890108 -> j3383427993 [label="x >= 6",color=purple];
		j3998890108 -> j36488078 [label="x < 6",color=purple];
		j3998890108 -> j36488078 [label="false",color=purple];
	j301998835 [label="Devo davvero complimentarmi con te per la tua audacia! Davvero, sei sicuro di non essere un Orokin? Forse stai nascondendo la tua pelle cerulea per non allertare gli altri?!",shape=box,color=blue];
		j301998835 -> j2309001764;
		j301998835 -> j300267429;
		j301998835 -> j3880341107;
	j3383427993 [label="Boolean RoatheResetEdgeCase is now true.",color=orange];
		j3383427993 -> j36488078;
	j36488078 [label="L'anomalia nata dal Void. ''Il Drifter''. L'Usurpatore. Finalmente, parliamo. Vieni. Il Diavolo ha una proposta da farti...",shape=box,color=blue];
		j36488078 -> j4066925558;
		j36488078 -> j3409857549;
		j36488078 -> j3843423437;
		j36488078 -> j3429672210;
	j2309001764 [label="Ciao, Roathe.",shape=box,color=red];
		j2309001764 -> j846594735;
	j300267429 [label="Di cosa mi stai accusando esattamente?",shape=box,color=red];
		j300267429 -> j2314545409;
	j3880341107 [label="Scusa?",shape=box,color=red];
		j3880341107 -> j2314545409;
	j4066925558 [label="Usurpatore?",shape=box,color=red];
		j4066925558 -> j2074559790;
	j3409857549 [label="Che... tipo di proposta?",shape=box,color=red];
		j3409857549 -> j223133979;
	j3843423437 [label="Che tipo di proposta potrebbe mai farmi il 'Diavolo di Tau'?",shape=box,color=red];
		j3843423437 -> j2466268224;
	j3429672210 [label="Ciao, Roathe.",shape=box,color=red];
		j3429672210 -> j3867893546;
	j846594735 [label="Ah, bene! Conosci il mio nome! Ero certo che in qualche modo ti fosse sfuggito, visto che eri chiaramente troppo impegnato a massacrarmi!",shape=box,color=blue];
		j846594735 -> j2886556060;
	j2314545409 [label="Non hai davvero niente di più produttivo da fare?! Oppure giocare a ''Attacca il corno allo Yaznak'' è davvero il modo migliore per impiegare il tuo tempo?!",shape=box,color=blue];
		j2314545409 -> j2886556060;
	j2074559790 [label="Boolean RoatheUsurper is now true.",color=orange];
		j2074559790 -> j2211433651;
	j223133979 [label="Mm, non c'è motivo di preoccuparsi... o agitarsi. Per ora. Questo è semplicemente un accordo commerciale tra due individui che potrebbero trarne grandi benefici entrambi.",shape=box,color=blue];
		j223133979 -> j3867893546;
	j2466268224 [label="+5 Chemistry",color=orange];
		j2466268224 -> j2398971029;
	j3867893546 [label="Ora, ascolta attentamente. Quei due fanatici sono stati terribilmente e dolorosamente scialbi nel loro continuo rimprovero nei miei confronti. Mi aspetto che ti elevi al di sopra di questo comportamento correttivo.",shape=box,color=blue];
		j3867893546 -> j138464324;
		j3867893546 -> j3112503244;
	j2886556060 [label="Trovo molto difficile credere che tutto questo - tutta questa ingiustizia che ho subito per mano tua, tutto questo sgretolamento della mia psiche non sia stato puramente per dispetto nei tuoi confronti!",shape=box,color=blue];
		j2886556060 -> j272933051;
		j2886556060 -> j1898922538;
		j2886556060 -> j3258294183;
	j2211433651 [label="+5 Chemistry",color=orange];
		j2211433651 -> j772434750;
	j2398971029 [label="Vedo che la mia reputazione mi precede. Bene. Ci farà risparmiare un po' di tempo.",shape=box,color=blue];
		j2398971029 -> j1659199191;
	j138464324 [label="Non prendo ordini da te.",shape=box,color=red];
		j138464324 -> j4026548805;
	j3112503244 [label="Vedrò cosa posso fare.",shape=box,color=red];
		j3112503244 -> j3139341305;
	j272933051 [label="Non ti è sembrata una priorità?",shape=box,color=red];
		j272933051 -> j1403153337;
	j1898922538 [label="Io... semplicemente non ho avuto tempo.",shape=box,color=red];
		j1898922538 -> j2779117744;
	j3258294183 [label="Non te lo ricordi... ma ne abbiamo già parlato.",shape=box,color=red];
		j3258294183 -> j3013641288;
	j772434750 [label="Ah! È questo che sei, no? I Tenno hanno usurpato il Sistema Origin dagli Orokin. E tu, come un piccolo impostore nel nido, sei entrato in questo mondo rubandotelo.",shape=box,color=blue];
		j772434750 -> j4287810122;
	j1659199191 [label="E non c'è motivo di preoccuparsi o emozionarsi... per ora. Questo è semplicemente un accordo commerciale tra due individui che possono trarre grandi benefici l'uno dall'altro.",shape=box,color=blue];
		j1659199191 -> j3867893546;
	j4026548805 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4026548805 -> j1247391162 [label="x >= 21",color=purple];
		j4026548805 -> j2999012877 [label="x >= 1",color=purple];
		j4026548805 -> j2266657384 [label="x <= 0",color=purple];
		j4026548805 -> j2266657384 [label="false",color=purple];
	j3139341305 [label="Vedi di farlo.",shape=box,color=blue];
		j3139341305 -> j2841999567;
	j1403153337 [label="Non ti è sembrata -",shape=box,color=blue];
		j1403153337 -> j1572944671;
	j2779117744 [label="Oh! Mi dispiace tanto di averti arrecato disagio, non mi sono reso conto che la tua agenda fosse già completamente piena!",shape=box,color=blue];
		j2779117744 -> j2535628753;
	j3013641288 [label="+5 Chemistry",color=orange];
		j3013641288 -> j3661978721;
	j4287810122 [label="E questo ti rende, per almeno due motivi, un Usurpatore, secondo i miei criteri. (E forse anche un terzo, se consideriamo ciò che il maggiordomo mi ha detto di Duviri, ma questo è un argomento che affronteremo un'altra volta.)",shape=box,color=blue];
		j4287810122 -> j3867893546;
	j1247391162 [label="È brutalmente e ripetutamente chiaro, grazie.",shape=box,color=blue];
		j1247391162 -> j2841999567;
	j2999012877 [label="Tutto molto chiaro direi.",shape=box,color=blue];
		j2999012877 -> j2841999567;
	j2266657384 [label="Vedremo.",shape=box,color=blue];
		j2266657384 -> j2841999567;
	j2841999567 [label="Ora, la questione è semplice, mio nuovo affascinante, eccentrico 'amico'.",shape=box,color=blue];
		j2841999567 -> j1071362491;
	j1572944671 [label="Non ti è sembrata una priorità?!",shape=box,color=blue];
		j1572944671 -> j2634186696;
	j2535628753 [label="Davvero. Sono sbalordito. I tuoi modi sono atroci, Drifter.",shape=box,color=blue];
		j2535628753 -> j3496453248;
	j3661978721 [label="Pardon? E come ho fatto a dimenticarmi il tuo frugare nella mia mente come se fosse la Boccia di Malium a una festa di Naberus!",shape=box,color=blue];
		j3661978721 -> j3038441916;
		j3661978721 -> j2526617201;
	j1071362491 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j1071362491 -> j4120764836 [label="x >= 21",color=purple];
		j1071362491 -> j2106794233 [label="x >= 1",color=purple];
		j1071362491 -> j1970132888 [label="x <= 0",color=purple];
		j1071362491 -> j1970132888 [label="false",color=purple];
	j2634186696 [label="Di solito ti capita di curiosare nei ricordi degli altri, distruggendone le rappresentazioni, senza cogliere prima l'occasione di conoscerli?!",shape=box,color=blue];
		j2634186696 -> j3047158682;
	j3496453248 [label="Ma suppongo che ormai non ci sia più nulla da fare. Tu conosci la verità. Sono esposto davanti a te, in tutta la mia abominevole codardia.",shape=box,color=blue];
		j3496453248 -> j3132438547;
	j3038441916 [label="Per farla breve, sembrerebbe che... l'Infestazione si estenda ai sieri Protoframe...",shape=box,color=red];
		j3038441916 -> j1457781129;
	j2526617201 [label="Ah. Beh. Allora. Ho la capacità di viaggiare nel tempo.",shape=box,color=red];
		j2526617201 -> j1457781129;
	j4120764836 [label="Dal momento che hai già iniziato a frugare nella mia mente come un razaliorn ubriaco dentro una cristalleria, ho bisogno del tuo aiuto per cercare di decifrare il significato di tutto ciò.",shape=box,color=blue];
		j4120764836 -> j1827171562;
	j2106794233 [label="Tu e i due fanatici avete già iniziato a curiosare nella mia mente come dei razaliorn ubriachi dentro una cristalleria. Ho bisogno della vostra assistenza per decifrare tutto questo.",shape=box,color=blue];
		j2106794233 -> j1827171562;
	j1970132888 [label="Quando Albrecht mi ha infilato la siringa nel collo e mi ha trasformato in questa - cosa - ha fatto anche qualcos'altro. I giochetti tra Orokin sono una cosa. Questo? Questo è qualcos'altro.",shape=box,color=blue];
		j1970132888 -> j3785232793;
	j3047158682 [label="I tuoi modi sono davvero atroci!",shape=box,color=blue];
		j3047158682 -> j3496453248;
	j3132438547 [label="Suppongo che tu sia venuto qui solo per prendermi in giro. Ti chiedo di sfogarti ora così potremo proseguire senza interruzioni.",shape=box,color=blue];
		j3132438547 -> j1571709285;
	j1457781129 [label="E pensavo che funzionasse sui Protoframe del 1999 perché l'anno stesso era ciclico, ma non è così. ",shape=box,color=red];
		j1457781129 -> j2190374813;
	j1827171562 [label="Non solo ho bisogno del tuo aiuto per recuperare i miei ricordi - ma per aggiungere la beffa al danno, sembra che non riesca nemmeno a trovare il modo di discernerne la verità da solo!",shape=box,color=blue];
		j1827171562 -> j1367153550;
		j1827171562 -> j2215876328;
	j3785232793 [label="Mi ha rubato gran parte dei miei ricordi. Vedo quella piccola... versione di te, che corre in giro con tutti i tuoi amici Tenno traumatizzati. E vedo cosa Lotus la sta aiutando a recuperare.",shape=box,color=blue];
		j3785232793 -> j920508245;
		j3785232793 -> j2558807920;
	j1571709285 [label="Preferirei non dover continuamente lottare con questa cosa tra i piedi, come il kubrow abbaiante allevato a scopo ornamentale da qualche diva.",shape=box,color=blue];
		j1571709285 -> j3758533155;
		j1571709285 -> j2065051873;
	j2190374813 [label="Penso che... abbia più a che fare con l'Infestazione stessa? C'è una chitarra parlante che in un certo senso ne alludeva. E tu sei arrivano fin qui usando l'Helminth, no?",shape=box,color=red];
		j2190374813 -> j3424581425;
	j1367153550 [label="Quindi stai dicendo che... hai solo bisogno di parlare con qualcuno?",shape=box,color=red];
		j1367153550 -> j4002101081;
	j2215876328 [label="Se posso, sarò felice di aiutarti, anche se non so bene come fare.",shape=box,color=red];
		j2215876328 -> j3844004210;
	j920508245 [label="Allora... perché non vai da solo nel refrattario oscuro?",shape=box,color=red];
		j920508245 -> j1933156668;
	j2558807920 [label="Il ragazzino non è una 'cosa'.",shape=box,color=red];
		j2558807920 -> j75035325;
	j3758533155 [label="Sei scappato. Ma molte persone scappano. Si tratta di affrontare quello che è successo.",shape=box,color=red];
		j3758533155 -> j1337007374;
	j2065051873 [label="Non ti prenderò in giro. Hai scelto di combattere un altro giorno.",shape=box,color=red];
		j2065051873 -> j3936141447;
	j3424581425 [label="Sembri allarmantemente incerto su tutta questa conversazione, Drifter. Soprattutto quando si tratta del contenuto del mio cranio.",shape=box,color=blue];
		j3424581425 -> j3265761964;
	j4002101081 [label="Oh, non far sembrare che io abbia semplicemente bisogno di sdraiarmi su un divano reclinabile e di esprimere i miei 'sentimenti'.",shape=box,color=blue];
		j4002101081 -> j3844004210;
	j3844004210 [label="Ho bisogno che qualcuno utilizzi la macchina su mio ordine, perché al momento non sono in grado di farlo da solo. ",shape=box,color=blue];
		j3844004210 -> j4267847886;
	j1933156668 [label="Lo farei io stesso, credimi, ma non posso! Quel maledetto siero protoframe di Albrecht mi ha avvelenato, privandomi di ogni capacità di azionare da solo quel maledetto marchingegno!",shape=box,color=blue];
		j1933156668 -> j3933075478;
	j75035325 [label="Ti assicuro che lo è.",shape=box,color=blue];
		j75035325 -> j437080284;
	j1337007374 [label="Add 1 to Thermostat counter",color=orange];
		j1337007374 -> j727563785;
	j3936141447 [label="Add -1 to Thermostat counter",color=orange];
		j3936141447 -> j3725684801;
	j3265761964 [label="E sì. Sono arrivato qui utilizzando l'Helminth. Che ho progettato e cresciuto io stesso, grazie. Ora. Mi stai dicendo che hai... cancellato i miei ricordi?! Di cosa, delle nostre conversazioni insieme?! ",shape=box,color=blue];
		j3265761964 -> j2118491652;
	j4267847886 [label="Ho anche bisogno di qualcuno che mi aiuti a registrare i miei ricordi e a riconciliarli. Una specie di assistente temporaneo.",shape=box,color=blue];
		j4267847886 -> j205516990;
	j3933075478 [label="E oltretutto, non solo ho bisogno del tuo aiuto per recuperare i miei ricordi - ma per aggiungere la beffa al danno, sembra che non riesca nemmeno a trovare il modo di discernerne la verità da solo!",shape=box,color=blue];
		j3933075478 -> j1367153550;
		j3933075478 -> j2215876328;
	j437080284 [label="E lo farei io stesso, credimi, ma non posso! Quel maledetto siero protoframe di Albrecht mi ha avvelenato, privandomi di ogni capacità di azionare da solo quel maledetto marchingegno!",shape=box,color=blue];
		j437080284 -> j3933075478;
	j727563785 [label="Fantastico. Un'altra triste mosca che mi ronza intorno alle orecchie e mi dice che ho bisogno di introspezione e consapevolezza?",shape=box,color=blue];
		j727563785 -> j1920168991;
	j3725684801 [label="+5 Chemistry",color=orange];
		j3725684801 -> j3855225833;
	j2118491652 [label="Perché ho sicuramente dei \"cari\" ricordi di te che mi riducevi a carne macinata per il tuo sanguinario divertimento. Che senso ha tutto questo?",shape=box,color=blue];
		j2118491652 -> j2386765476;
		j2118491652 -> j1372611242;
	j205516990 [label="E in cambio - avrai la mia solenne promessa che rimarrò qui... in pace. Non rappresenterò alcuna minaccia per nessuno, e te lo assicuro... e sono perfettamente in grado di esserlo. Non farò del male ai fanatici. O al maggiordomo. O agli animali corrotti dal Void di Albrecht.",shape=box,color=blue];
		j205516990 -> j1541434905;
	j1920168991 [label="Che fortuna.",shape=box,color=blue];
		j1920168991 -> j3831758839;
	j3855225833 [label="Al momento, quello che sto facendo sembra essere \"marcire in una cripta con un paio di stupidi fanatici e distribuire cianfrusaglie a ragazzini traumatizzati dalla guerra\".",shape=box,color=blue];
		j3855225833 -> j3043144718;
	j2386765476 [label="Non lo so, e non sono qui per continuare a farmi insultare da te, Roathe. Non ho fatto passare un ciclo a tutti solo per ricevere le tue critiche.",shape=box,color=red];
		j2386765476 -> j364618945;
	j1372611242 [label="Per quanto ne so, le nostre conversazioni non hanno radici profonde. Sono ricordi superficiali. Quello che abbiamo scoperto nel tuo passato era... più parte dei tuoi ricordi più profondi, no?",shape=box,color=red];
		j1372611242 -> j2423085162;
	j1541434905 [label="E, cosa ancora più importante, non farò del male alla contorta famiglia di Albrecht che siede come una flora mutante sopra di noi - ignari della nostra nostra stessa presenza.",shape=box,color=blue];
		j1541434905 -> j922761828;
		j1541434905 -> j2270390406;
		j1541434905 -> j2998308835;
	j3831758839 [label="Ho intenzione di andare avanti e farmi i fatti miei, Drifter, ma comunque - sai troppo del mio passato e di quello che ho fatto. E dovremo semplicemente... sopravvivere in questo stato.",shape=box,color=blue];
		j3831758839 -> j1386517806;
	j3043144718 [label="Ma suppongo che adesso si chiami così.",shape=box,color=blue];
		j3043144718 -> j3831758839;
	j364618945 [label="Sì. Posso azzardare un'ipotesi sul motivo per cui hai evocato i tuoi doni del Void per cancellare dalla nostra mente i recenti eventi. È perfettamente prevedibile.",shape=box,color=blue];
		j364618945 -> j1339421529;
	j2423085162 [label="Fantastico. Assolutamente meraviglioso. Ora sono nelle mani di un lunatico che ha il potere di cancellare i miei ricordi a suo piacimento! Adorabile.",shape=box,color=blue];
		j2423085162 -> j1339421529;
	j922761828 [label="Pensavo che fosse un accordo. Ora mi minacci?",shape=box,color=red];
		j922761828 -> j1573218325;
	j2270390406 [label="Roathe? Per favore, fermati e ascoltami un attimo.",shape=box,color=red];
		j2270390406 -> j708657312;
	j2998308835 [label="Cosa hai bisogno che faccia?",shape=box,color=red];
		j2998308835 -> j1684842390;
	j1386517806 [label="Cerca di non rendere questa situazione troppo imbarazzante per me e ti prometto che cercherò di fare lo stesso a mia volta.",shape=box,color=blue];
		j1386517806 -> j617240165;
		j1386517806 -> j2459895368;
	j1339421529 [label="Bene. Se ciò che dici è vero - e suppongo che questa storia sia abbastanza folle da essere reale - cercherò di non rinfacciarti la tua conoscenza per questa mia profonda e terribile verità.",shape=box,color=blue];
		j1339421529 -> j3043891022;
	j1573218325 [label="Non stavi prestando attenzione? Seriamente, la comprensione del testo in questi giorni... Non ti stavo minacciando, Usurpatore. Né stavo minacciando nessun altro.",shape=box,color=blue];
		j1573218325 -> j3281838139;
	j708657312 [label="Questo ha tutte le promesse per essere grandioso. Per favore. Procedi; il proverbiale teatro è tuo.",shape=box,color=blue];
		j708657312 -> j952274706;
		j708657312 -> j100087194;
		j708657312 -> j2745745721;
	j1684842390 [label="Non stavi prestando attenzione? Seriamente, ultimamente la comprensione del testo... Sto cercando di trovare un accordo con te, Usurpatore. Faccio fatica a credere che tu non riesca a seguire.",shape=box,color=blue];
		j1684842390 -> j2498574119;
	j617240165 [label="No.",shape=box,color=red];
		j617240165 -> j836567128;
	j2459895368 [label="Penso che sia giusto.",shape=box,color=red];
		j2459895368 -> j1168425251;
	j3043891022 [label="Anche se vorrei chiederti - se mi è concesso - di sfogare qualsiasi presa in giro che vuoi rivolgermi ora, così possiamo procedere senza interruzioni.",shape=box,color=blue];
		j3043891022 -> j1571709285;
	j3281838139 [label="Volevo semplicemente dire che se dovessimo arrivare a un punto in cui non fossi più in grado di raggiungere i miei obiettivi finali, potrei non avere più motivo di restare seduto in silenzio.",shape=box,color=blue];
		j3281838139 -> j2498574119;
	j952274706 [label="Sono io la causa della morte di Ballas. Non mi obbligare a liberare l'agenda.",shape=box,color=red];
		j952274706 -> j3485777626;
	j100087194 [label="Se vuoi il mio aiuto, questo non è il modo migliore per ottenerlo.",shape=box,color=red];
		j100087194 -> j1866070872;
	j2745745721 [label="So che non abbiamo molta esperienza l'uno con l'altro - è vero. Ma sono qui per aiutarti.",shape=box,color=red];
		j2745745721 -> j2518248273;
	j2498574119 [label="Se la mia proposta non soddisfa i tuoi standard, posso renderla più allettante?",shape=box,color=blue];
		j2498574119 -> j3412772389;
	j836567128 [label="+5 Chemistry",color=orange];
		j836567128 -> j3998763543;
	j1168425251 [label="+15 Chemistry",color=orange];
		j1168425251 -> j952843016;
	j3485777626 [label="+5 Chemistry",color=orange];
		j3485777626 -> j1684224529;
	j1866070872 [label="E se tu vuoi il mio, allora ti suggerisco - come ho detto - di trovare un accordo.",shape=box,color=blue];
		j1866070872 -> j2498574119;
	j2518248273 [label="E? Ah, capisco. Ti disturba il mio 'tono' vero? Sono terribilmente dispiaciuto. Non avrei mai pensato che ti saresti irritato così facilmente.",shape=box,color=blue];
		j2518248273 -> j2498574119;
	j3412772389 [label="Ho scoperto che ci sono moltissime questioni riguardanti Deimos per le quali il mio aiuto potrebbe essere considerato non solo fattibile, ma oserei dire, cruciale.",shape=box,color=blue];
		j3412772389 -> j3768432614;
	j3998763543 [label="Ah! Almeno, posso rispettare la tua onestà.",shape=box,color=blue];
		j3998763543 -> j3084080304;
	j952843016 [label="Meraviglioso. È bello sapere che almeno sei... gradevole.",shape=box,color=blue];
		j952843016 -> j3084080304;
	j1684224529 [label="Se solo mi avessi sentito ridere! Grazie, Drifter, per non essere stato tedioso!",shape=box,color=blue];
		j1684224529 -> j1942726843;
	j3768432614 [label="Tra cui, ma non limitato a, la riconciliazione tra un maggiordono innamorato e la suddetta famiglia che vive al piano di sopra.",shape=box,color=blue];
		j3768432614 -> j1473483314;
	j3084080304 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j3084080304 -> j3531310900;
	j1942726843 [label="Add -1 to Thermostat counter",color=orange];
		j1942726843 -> j1697795560;
	j1473483314 [label="Una famiglia che, come ho detto, non ha la minima idea della nostra presenza quaggiù. E non sa nemmeno che Albrecht continui a esistere tra i vivi, non è vero?",shape=box,color=blue];
