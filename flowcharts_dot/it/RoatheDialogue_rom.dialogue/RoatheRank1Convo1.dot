		8 -> 15;
	9 [label="Di cosa mi stai accusando esattamente?",shape=box,color=red];
		9 -> 16;
	10 [label="Scusa?",shape=box,color=red];
		10 -> 16;
	4 [label="Usurpatore?",shape=box,color=red];
		4 -> 11;
	5 [label="Che... tipo di proposta?",shape=box,color=red];
		5 -> 12;
	6 [label="Che tipo di proposta potrebbe mai farmi il 'Diavolo di Tau'?",shape=box,color=red];
		6 -> 13;
	7 [label="Ciao, Roathe.",shape=box,color=red];
		7 -> 14;
	15 [label="Ah, bene! Conosci il mio nome! Ero certo che in qualche modo ti fosse sfuggito, visto che eri chiaramente troppo impegnato a massacrarmi!",shape=box,color=blue];
		15 -> 21;
	16 [label="Non hai davvero niente di più produttivo da fare?! Oppure giocare a ''Attacca il corno allo Yaznak'' è davvero il modo migliore per impiegare il tuo tempo?!",shape=box,color=blue];
		16 -> 21;
	11 [label="Update boolean RoatheUsurper",color=orange];
		11 -> 17;
	12 [label="Mm, non c'è motivo di preoccuparsi... o agitarsi. Per ora. Questo è semplicemente un accordo commerciale tra due individui che potrebbero trarne grandi benefici entrambi.",shape=box,color=blue];
		12 -> 14;
	13 [label="+5 Chemistry",color=orange];
		13 -> 18;
	14 [label="Ora, ascolta attentamente. Quei due fanatici sono stati terribilmente e dolorosamente scialbi nel loro continuo rimprovero nei miei confronti. Mi aspetto che ti elevi al di sopra di questo comportamento correttivo.",shape=box,color=blue];
		14 -> 19;
		14 -> 20;
	21 [label="Trovo molto difficile credere che tutto questo - tutta questa ingiustizia che ho subito per mano tua, tutto questo sgretolamento della mia psiche non sia stato puramente per dispetto nei tuoi confronti!",shape=box,color=blue];
		21 -> 26;
		21 -> 27;
		21 -> 28;
	17 [label="+5 Chemistry",color=orange];
		17 -> 22;
	18 [label="Vedo che la mia reputazione mi precede. Bene. Ci farà risparmiare un po' di tempo.",shape=box,color=blue];
		18 -> 23;
	19 [label="Non prendo ordini da te.",shape=box,color=red];
		19 -> 24;
	20 [label="Vedrò cosa posso fare.",shape=box,color=red];
		20 -> 25;
	26 [label="Non ti è sembrata una priorità?",shape=box,color=red];
		26 -> 34;
	27 [label="Io... semplicemente non ho avuto tempo.",shape=box,color=red];
		27 -> 35;
	28 [label="Non te lo ricordi... ma ne abbiamo già parlato.",shape=box,color=red];
		28 -> 36;
	22 [label="Ah! È questo che sei, no? I Tenno hanno usurpato il Sistema Origin dagli Orokin. E tu, come un piccolo impostore nel nido, sei entrato in questo mondo rubandotelo.",shape=box,color=blue];
		22 -> 29;
	23 [label="E non c'è motivo di preoccuparsi o emozionarsi... per ora. Questo è semplicemente un accordo commerciale tra due individui che possono trarre grandi benefici l'uno dall'altro.",shape=box,color=blue];
		23 -> 14;
	24 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		24 -> 30 [label="x >= 21",color=purple];
		24 -> 31 [label="x >= 1",color=purple];
		24 -> 32 [label="x <= 0",color=purple];
		24 -> 32 [label="false",color=purple];
	25 [label="Vedi di farlo.",shape=box,color=blue];
		25 -> 33;
	34 [label="Non ti è sembrata -",shape=box,color=blue];
		34 -> 38;
	35 [label="Oh! Mi dispiace tanto di averti arrecato disagio, non mi sono reso conto che la tua agenda fosse già completamente piena!",shape=box,color=blue];
		35 -> 39;
	36 [label="+5 Chemistry",color=orange];
		36 -> 40;
	29 [label="E questo ti rende, per almeno due motivi, un Usurpatore, secondo i miei criteri. (E forse anche un terzo, se consideriamo ciò che il maggiordomo mi ha detto di Duviri, ma questo è un argomento che affronteremo un'altra volta.)",shape=box,color=blue];
		29 -> 14;
	30 [label="È brutalmente e ripetutamente chiaro, grazie.",shape=box,color=blue];
		30 -> 33;
	31 [label="Tutto molto chiaro direi.",shape=box,color=blue];
		31 -> 33;
	32 [label="Vedremo.",shape=box,color=blue];
		32 -> 33;
	33 [label="Ora, la questione è semplice, mio nuovo affascinante, eccentrico 'amico'.",shape=box,color=blue];
		33 -> 37;
	38 [label="Non ti è sembrata una priorità?!",shape=box,color=blue];
		38 -> 44;
	39 [label="Davvero. Sono sbalordito. I tuoi modi sono atroci, Drifter.",shape=box,color=blue];
		39 -> 45;
	40 [label="Pardon? E come ho fatto a dimenticarmi il tuo frugare nella mia mente come se fosse la Boccia di Malium a una festa di Naberus!",shape=box,color=blue];
		40 -> 46;
		40 -> 47;
	37 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		37 -> 41 [label="x >= 21",color=purple];
		37 -> 42 [label="x >= 1",color=purple];
		37 -> 43 [label="x <= 0",color=purple];
		37 -> 43 [label="false",color=purple];
	44 [label="Di solito ti capita di curiosare nei ricordi degli altri, distruggendone le rappresentazioni, senza cogliere prima l'occasione di conoscerli?!",shape=box,color=blue];
		44 -> 50;
	45 [label="Ma suppongo che ormai non ci sia più nulla da fare. Tu conosci la verità. Sono esposto davanti a te, in tutta la mia abominevole codardia.",shape=box,color=blue];
		45 -> 51;
	46 [label="Per farla breve, sembrerebbe che... l'Infestazione si estenda ai sieri Protoframe...",shape=box,color=red];
		46 -> 52;
	47 [label="Ah. Beh. Allora. Ho la capacità di viaggiare nel tempo.",shape=box,color=red];
		47 -> 52;
	41 [label="Dal momento che hai già iniziato a frugare nella mia mente come un razaliorn ubriaco dentro una cristalleria, ho bisogno del tuo aiuto per cercare di decifrare il significato di tutto ciò.",shape=box,color=blue];
		41 -> 48;
	42 [label="Tu e i due fanatici avete già iniziato a curiosare nella mia mente come dei razaliorn ubriachi dentro una cristalleria. Ho bisogno della vostra assistenza per decifrare tutto questo.",shape=box,color=blue];
		42 -> 48;
	43 [label="Quando Albrecht mi ha infilato la siringa nel collo e mi ha trasformato in questa - cosa - ha fatto anche qualcos'altro. I giochetti tra Orokin sono una cosa. Questo? Questo è qualcos'altro.",shape=box,color=blue];
		43 -> 49;
	50 [label="I tuoi modi sono davvero atroci!",shape=box,color=blue];
		50 -> 45;
	51 [label="Suppongo che tu sia venuto qui solo per prendermi in giro. Ti chiedo di sfogarti ora così potremo proseguire senza interruzioni.",shape=box,color=blue];
		51 -> 57;
	52 [label="E pensavo che funzionasse sui Protoframe del 1999 perché l'anno stesso era ciclico, ma non è così. ",shape=box,color=red];
		52 -> 58;
	48 [label="Non solo ho bisogno del tuo aiuto per recuperare i miei ricordi - ma per aggiungere la beffa al danno, sembra che non riesca nemmeno a trovare il modo di discernerne la verità da solo!",shape=box,color=blue];
		48 -> 53;
		48 -> 54;
	49 [label="Mi ha rubato gran parte dei miei ricordi. Vedo quella piccola... versione di te, che corre in giro con tutti i tuoi amici Tenno traumatizzati. E vedo cosa Lotus la sta aiutando a recuperare.",shape=box,color=blue];
		49 -> 55;
		49 -> 56;
	57 [label="Preferirei non dover continuamente lottare con questa cosa tra i piedi, come il kubrow abbaiante allevato a scopo ornamentale da qualche diva.",shape=box,color=blue];
		57 -> 63;
		57 -> 64;
	58 [label="Penso che... abbia più a che fare con l'Infestazione stessa? C'è una chitarra parlante che in un certo senso ne alludeva. E tu sei arrivano fin qui usando l'Helminth, no?",shape=box,color=red];
		58 -> 65;
	53 [label="Quindi stai dicendo che... hai solo bisogno di parlare con qualcuno?",shape=box,color=red];
		53 -> 59;
	54 [label="Se posso, sarò felice di aiutarti, anche se non so bene come fare.",shape=box,color=red];
		54 -> 60;
	55 [label="Allora... perché non vai da solo nel refrattario oscuro?",shape=box,color=red];
		55 -> 61;
	56 [label="Il ragazzino non è una 'cosa'.",shape=box,color=red];
		56 -> 62;
	63 [label="Sei scappato. Ma molte persone scappano. Si tratta di affrontare quello che è successo.",shape=box,color=red];
		63 -> 69;
	64 [label="Non ti prenderò in giro. Hai scelto di combattere un altro giorno.",shape=box,color=red];
		64 -> 70;
	65 [label="Sembri allarmantemente incerto su tutta questa conversazione, Drifter. Soprattutto quando si tratta del contenuto del mio cranio.",shape=box,color=blue];
		65 -> 71;
	59 [label="Oh, non far sembrare che io abbia semplicemente bisogno di sdraiarmi su un divano reclinabile e di esprimere i miei 'sentimenti'.",shape=box,color=blue];
		59 -> 60;
	60 [label="Ho bisogno che qualcuno utilizzi la macchina su mio ordine, perché al momento non sono in grado di farlo da solo. ",shape=box,color=blue];
		60 -> 66;
	61 [label="Lo farei io stesso, credimi, ma non posso! Quel maledetto siero protoframe di Albrecht mi ha avvelenato, privandomi di ogni capacità di azionare da solo quel maledetto marchingegno!",shape=box,color=blue];
		61 -> 67;
	62 [label="Ti assicuro che lo è.",shape=box,color=blue];
		62 -> 68;
	69 [label="Add 1 to Thermostat",color=orange];
		69 -> 73;
	70 [label="Add -1 to Thermostat",color=orange];
		70 -> 74;
	71 [label="E sì. Sono arrivato qui utilizzando l'Helminth. Che ho progettato e cresciuto io stesso, grazie. Ora. Mi stai dicendo che hai... cancellato i miei ricordi?! Di cosa, delle nostre conversazioni insieme?! ",shape=box,color=blue];
		71 -> 75;
	66 [label="Ho anche bisogno di qualcuno che mi aiuti a registrare i miei ricordi e a riconciliarli. Una specie di assistente temporaneo.",shape=box,color=blue];
		66 -> 72;
	67 [label="E oltretutto, non solo ho bisogno del tuo aiuto per recuperare i miei ricordi - ma per aggiungere la beffa al danno, sembra che non riesca nemmeno a trovare il modo di discernerne la verità da solo!",shape=box,color=blue];
		67 -> 53;
		67 -> 54;
	68 [label="E lo farei io stesso, credimi, ma non posso! Quel maledetto siero protoframe di Albrecht mi ha avvelenato, privandomi di ogni capacità di azionare da solo quel maledetto marchingegno!",shape=box,color=blue];
		68 -> 67;
	73 [label="Fantastico. Un'altra triste mosca che mi ronza intorno alle orecchie e mi dice che ho bisogno di introspezione e consapevolezza?",shape=box,color=blue];
		73 -> 77;
	74 [label="+5 Chemistry",color=orange];
		74 -> 78;
	75 [label="Perché ho sicuramente dei \"cari\" ricordi di te che mi riducevi a carne macinata per il tuo sanguinario divertimento. Che senso ha tutto questo?",shape=box,color=blue];
		75 -> 79;
		75 -> 80;
	72 [label="E in cambio - avrai la mia solenne promessa che rimarrò qui... in pace. Non rappresenterò alcuna minaccia per nessuno, e te lo assicuro... e sono perfettamente in grado di esserlo. Non farò del male ai fanatici. O al maggiordomo. O agli animali corrotti dal Void di Albrecht.",shape=box,color=blue];
		72 -> 76;
	77 [label="Che fortuna.",shape=box,color=blue];
		77 -> 84;
	78 [label="Al momento, quello che sto facendo sembra essere \"marcire in una cripta con un paio di stupidi fanatici e distribuire cianfrusaglie a ragazzini traumatizzati dalla guerra\".",shape=box,color=blue];
		78 -> 85;
	79 [label="Non lo so, e non sono qui per continuare a farmi insultare da te, Roathe. Non ho fatto passare un ciclo a tutti solo per ricevere le tue critiche.",shape=box,color=red];
		79 -> 5634;
	80 [label="Per quanto ne so, le nostre conversazioni non hanno radici profonde. Sono ricordi superficiali. Quello che abbiamo scoperto nel tuo passato era... più parte dei tuoi ricordi più profondi, no?",shape=box,color=red];
		80 -> 86;
	76 [label="E, cosa ancora più importante, non farò del male alla contorta famiglia di Albrecht che siede come una flora mutante sopra di noi - ignari della nostra nostra stessa presenza.",shape=box,color=blue];
		76 -> 81;
		76 -> 82;
		76 -> 83;
	84 [label="Ho intenzione di andare avanti e farmi i fatti miei, Drifter, ma comunque - sai troppo del mio passato e di quello che ho fatto. E dovremo semplicemente... sopravvivere in questo stato.",shape=box,color=blue];
		84 -> 90;
	85 [label="Ma suppongo che adesso si chiami così.",shape=box,color=blue];
		85 -> 84;
	5634 [label="Sì. Posso azzardare un'ipotesi sul motivo per cui hai evocato i tuoi doni del Void per cancellare dalla nostra mente i recenti eventi. È perfettamente prevedibile.",shape=box,color=blue];
		5634 -> 91;
	86 [label="Fantastico. Assolutamente meraviglioso. Ora sono nelle mani di un lunatico che ha il potere di cancellare i miei ricordi a suo piacimento! Adorabile.",shape=box,color=blue];
		86 -> 91;
	81 [label="Pensavo che fosse un accordo. Ora mi minacci?",shape=box,color=red];
		81 -> 87;
	82 [label="Roathe? Per favore, fermati e ascoltami un attimo.",shape=box,color=red];
		82 -> 88;
	83 [label="Cosa hai bisogno che faccia?",shape=box,color=red];
		83 -> 89;
	90 [label="Cerca di non rendere questa situazione troppo imbarazzante per me e ti prometto che cercherò di fare lo stesso a mia volta.",shape=box,color=blue];
		90 -> 97;
		90 -> 98;
	91 [label="Bene. Se ciò che dici è vero - e suppongo che questa storia sia abbastanza folle da essere reale - cercherò di non rinfacciarti la tua conoscenza per questa mia profonda e terribile verità.",shape=box,color=blue];
		91 -> 99;
	87 [label="Non stavi prestando attenzione? Seriamente, la comprensione del testo in questi giorni... Non ti stavo minacciando, Usurpatore. Né stavo minacciando nessun altro.",shape=box,color=blue];
		87 -> 92;
	88 [label="Questo ha tutte le promesse per essere grandioso. Per favore. Procedi; il proverbiale teatro è tuo.",shape=box,color=blue];
		88 -> 93;
		88 -> 94;
		88 -> 95;
	89 [label="Non stavi prestando attenzione? Seriamente, ultimamente la comprensione del testo... Sto cercando di trovare un accordo con te, Usurpatore. Faccio fatica a credere che tu non riesca a seguire.",shape=box,color=blue];
		89 -> 96;
	97 [label="No.",shape=box,color=red];
		97 -> 104;
	98 [label="Penso che sia giusto.",shape=box,color=red];
		98 -> 105;
	99 [label="Anche se vorrei chiederti - se mi è concesso - di sfogare qualsiasi presa in giro che vuoi rivolgermi ora, così possiamo procedere senza interruzioni.",shape=box,color=blue];
		99 -> 57;
	92 [label="Volevo semplicemente dire che se dovessimo arrivare a un punto in cui non fossi più in grado di raggiungere i miei obiettivi finali, potrei non avere più motivo di restare seduto in silenzio.",shape=box,color=blue];
		92 -> 96;
	93 [label="Sono io la causa della morte di Ballas. Non mi obbligare a liberare l'agenda.",shape=box,color=red];
		93 -> 100;
	94 [label="Se vuoi il mio aiuto, questo non è il modo migliore per ottenerlo.",shape=box,color=red];
		94 -> 101;
	95 [label="So che non abbiamo molta esperienza l'uno con l'altro - è vero. Ma sono qui per aiutarti.",shape=box,color=red];
		95 -> 102;
	96 [label="Se la mia proposta non soddisfa i tuoi standard, posso renderla più allettante?",shape=box,color=blue];
		96 -> 103;
	104 [label="+5 Chemistry",color=orange];
		104 -> 108;
	105 [label="+15 Chemistry",color=orange];
		105 -> 109;
	100 [label="+5 Chemistry",color=orange];
		100 -> 106;
	101 [label="E se tu vuoi il mio, allora ti suggerisco - come ho detto - di trovare un accordo.",shape=box,color=blue];
		101 -> 96;
	102 [label="E? Ah, capisco. Ti disturba il mio 'tono' vero? Sono terribilmente dispiaciuto. Non avrei mai pensato che ti saresti irritato così facilmente.",shape=box,color=blue];
		102 -> 96;
	103 [label="Ho scoperto che ci sono moltissime questioni riguardanti Deimos per le quali il mio aiuto potrebbe essere considerato non solo fattibile, ma oserei dire, cruciale.",shape=box,color=blue];
		103 -> 107;
	108 [label="Ah! Almeno, posso rispettare la tua onestà.",shape=box,color=blue];
		108 -> 112;
	109 [label="Meraviglioso. È bello sapere che almeno sei... gradevole.",shape=box,color=blue];
		109 -> 112;
	106 [label="Se solo mi avessi sentito ridere! Grazie, Drifter, per non essere stato tedioso!",shape=box,color=blue];
		106 -> 110;
	107 [label="Tra cui, ma non limitato a, la riconciliazione tra un maggiordono innamorato e la suddetta famiglia che vive al piano di sopra.",shape=box,color=blue];
		107 -> 111;
	112 [label="Update boolean RoatheKnowsReset",color=orange];
		112 -> 117;
	110 [label="Add -1 to Thermostat",color=orange];
		110 -> 113;
	111 [label="Una famiglia che, come ho detto, non ha la minima idea della nostra presenza quaggiù. E non sa nemmeno che Albrecht continui a esistere tra i vivi, non è vero?",shape=box,color=blue];
		111 -> 114;
		111 -> 115;
		111 -> 116;
	117 [label="Almeno sarà interessante.",shape=box,color=blue];
		117 -> 122;
	113 [label="Che piacere! Credo proprio che diventeremo amici. È stato davvero meraviglioso.",shape=box,color=blue];
		113 -> 118;
	114 [label="Ti stai offrendo di aiutare a convincere Loid a... parlare con la famiglia Entrati?",shape=box,color=red];
		114 -> 119;
	115 [label="Non riesco a convincere Loid a fare qualcosa a riguardo. Sostiene che sarebbe troppo doloroso.",shape=box,color=red];
		115 -> 120;
	116 [label="Non sanno che Albrecht Entrati è ancora vivo, no.",shape=box,color=red];
		116 -> 121;
	122 [label="Chat ends.",color=orange];
	118 [label="Penso, che per questo ti ricompenserò. E renderò la mia parte dell'accordo ancora più dolce per te. Un'audacia simile è rara.",shape=box,color=blue];
		118 -> 103;
	119 [label="Non gratuitamente, mio Usurpatore confuso dal Void.",shape=box,color=blue];
		119 -> 123;
	120 [label="Non puoi. Ma ti prometto... di farcela.",shape=box,color=blue];
		120 -> 123;
	121 [label="E visto che non sei riuscito a convincere quel servitore sconsolato? Ti prometto... che io ci riuscirò.",shape=box,color=blue];
		121 -> 123;
	123 [label="E così arriviamo finalmente alla mia proposta: aiutami a risolvere la questione dei miei ricordi perduti e ad arrivare 'al fondo' della questione - senza giochi di parole.",shape=box,color=blue];
		123 -> 124;
	124 [label="E mi assicurerò che il nostro servo affranto salga quelle scale. E, nel frattempo, me ne starò seduto tranquillamente... e non sarò un pericolo per nessuno. Che ne dici? Abbiamo un accordo?",shape=box,color=blue];
		124 -> 125;
