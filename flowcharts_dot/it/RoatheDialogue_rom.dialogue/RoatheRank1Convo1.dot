	2349 [label="Update boolean RoatheResetEdgeCase",color=orange];
		2349 -> 2;
	2 [label="L'anomalia nata dal Void. ''Il Drifter''. L'Usurpatore. Finalmente, parliamo. Vieni. Il Diavolo ha una proposta da farti...",shape=box,color=blue];
		2 -> 4;
		2 -> 5;
		2 -> 6;
