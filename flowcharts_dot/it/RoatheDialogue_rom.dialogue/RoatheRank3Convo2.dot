	j3690820501 [label="E ti andava bene?",shape=box,color=red];
		j3690820501 -> j316542575;
	j4246127212 [label="Non è una buona idea minacciarti, se desidera la tua lealtà.",shape=box,color=red];
		j4246127212 -> j15521855;
	j2571222104 [label="Uccidere Nitokh, ovviamente. Non è stato un colpo di scena sorprendente. Sapeva anche lei che era probabile che accadesse, e me lo ripeteva di continuo.",shape=box,color=blue];
		j2571222104 -> j2817840505;
		j2571222104 -> j135524138;
	j596495675 [label="+5 Chemistry",color=orange];
		j596495675 -> j1275536292;
	j1508173366 [label="Come sai, ero uno dei suoi tanti giocattoli.",shape=box,color=blue];
		j1508173366 -> j1753526461;
	j2500908430 [label="Ero uno dei suoi tanti partner, capisci.",shape=box,color=blue];
		j2500908430 -> j2512325634;
		j2500908430 -> j911742275;
	j316542575 [label="+5 Chemistry",color=orange];
		j316542575 -> j2042132109;
	j15521855 [label="Una cosa che devi sapere sugli Orokin è che eravamo sempre impegnati a tramare l'uno con l'altro. ",shape=box,color=blue];
		j15521855 -> j3304526426;
	j2817840505 [label="E lei era d'accordo?",shape=box,color=red];
		j2817840505 -> j2479181279;
	j135524138 [label="Sapevate entrambi che volevate uccidervi a vicenda?",shape=box,color=red];
		j135524138 -> j2573902069;
	j1275536292 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1275536292 -> j1853824453 [label=true,color=green];
		j1275536292 -> j130846098 [label=false,color=brown];
	j1753526461 [label="Un tempo credevo che noi fossimo partner. In politica, negli intrighi, a letto...",shape=box,color=blue];
		j1753526461 -> j3217341114;
	j2512325634 [label="Business partner?",shape=box,color=red];
		j2512325634 -> j3779976650;
	j911742275 [label="Partner, in che senso?",shape=box,color=red];
		j911742275 -> j1764609451;
	j2042132109 [label="Difficilmente. Ma una cosa che devi sapere sugli Orokin è che eravamo sempre impegnati a tramare l'uno con l'altro. ",shape=box,color=blue];
		j2042132109 -> j3304526426;
	j3304526426 [label="Sapevo che Nitokh mi avrebbe ucciso senza esitazione in qualsiasi momento, se solo avesse potuto aiutarla a raggiungere i suoi obiettivi.",shape=box,color=blue];
		j3304526426 -> j4010667402;
	j2479181279 [label="Credo che le piacesse la sfida, Usurpatore. Il senso del pericolo. L'emozione di sapere che andava a letto con qualcuno che la volesse morta.",shape=box,color=blue];
		j2479181279 -> j4155517403;
	j2573902069 [label="Vorrei pretendere di essere tra i primi Orokin a trovarsi in una situazione del genere, ma non era nemmeno così insolito.",shape=box,color=blue];
		j2573902069 -> j4155517403;
	j1853824453 [label="Esatto! Sembra quasi che tu l'abbia già sentito. Ma non è un colpo di scena sorprendente. Mi stuzzicava con questa storia abbastanza regolarmente.",shape=box,color=blue];
		j1853824453 -> j2817840505;
		j1853824453 -> j135524138;
	j130846098 [label="Precisamente! Ma non è certo un colpo di scena sorprendente. Anche lei se l'aspettava e mi stuzzicava regolarmente.",shape=box,color=blue];
		j130846098 -> j2817840505;
		j130846098 -> j135524138;
	j3217341114 [label="Non credevo che fossimo uguali, ovviamente. Lei era un'Esecutrice. La Grande Nitokh. Ma io mi consideravo il Primo Tra i Suoi Inferiori.",shape=box,color=blue];
		j3217341114 -> j1889912275;
	j3779976650 [label="Sei adorabile. Sì, in un certo senso, eravamo partner in affari. Ma lo eravamo anche in molti altri modi più importanti.",shape=box,color=blue];
		j3779976650 -> j1764609451;
	j1764609451 [label="In guerra. In politica. Negli intrighi. A letto.",shape=box,color=blue];
		j1764609451 -> j4031031712;
	j4010667402 [label="Eppure lei sapeva che stavo affilando i miei coltelli alle sue spalle e aspettando con impazienza il momento in cui le avrei staccato la testa dalle spalle.",shape=box,color=blue];
		j4010667402 -> j164253154;
	j4155517403 [label="Più vivo e più mi rendo conto che forse la nostra specie non è stata progettata per l'immortalità.",shape=box,color=blue];
		j4155517403 -> j648586420;
	j1889912275 [label="Che stupido che ero...",shape=box,color=blue];
		j1889912275 -> j2279387611;
		j1889912275 -> j3834206124;
		j1889912275 -> j2515605232;
		j1889912275 -> j955598271;
		j1889912275 -> j3599929254;
	j4031031712 [label="Ma mi chiedo se stia ricordando male. Mi chiedo se “partner” sia una parola troppo forte per descrivere quello che eravamo realmente. ",shape=box,color=blue];
		j4031031712 -> j1503569673;
	j164253154 [label="Si potrebbe dire che avevamo una relazione... complicata.",shape=box,color=blue];
		j164253154 -> j3599929254;
		j164253154 -> j955598271;
		j164253154 -> j2515605232;
		j164253154 -> j2279387611;
		j164253154 -> j3834206124;
	j648586420 [label="Ma, sì. Si potrebbe dire che io e Nitokh avevamo una relazione... complicata.",shape=box,color=blue];
		j648586420 -> j3599929254;
		j648586420 -> j955598271;
		j648586420 -> j2515605232;
		j648586420 -> j2279387611;
		j648586420 -> j3834206124;
	j2279387611 [label="Ti importava di lei?",shape=box,color=red];
		j2279387611 -> j1860837005;
	j3834206124 [label="La amavi?",shape=box,color=red];
		j3834206124 -> j2281602090;
	j2515605232 [label="Ti fidavi di lei?",shape=box,color=red];
		j2515605232 -> j701332136;
	j955598271 [label="Non rimpiangere ciò che hai fatto. Hai fatto le tue scelte. Non si può tornare indietro. Si può solo andare avanti.",shape=box,color=red];
		j955598271 -> j729581993;
	j3599929254 [label="L'unica cosa che possiamo fare per rimediare a ciò che abbiamo fatto in passato è guardare avanti con lucidità.",shape=box,color=red];
		j3599929254 -> j323090497;
	j1503569673 [label="Dopotutto, era la Grande Nitokh. Un'Esecutrice.",shape=box,color=blue];
		j1503569673 -> j1889912275;
	j1860837005 [label="Per il Void, no! Se un pomeriggio fosse uscita ubriaca da una camera stagna, avrebbe risolto un sacco di miei dannati problemi.",shape=box,color=blue];
		j1860837005 -> j1048148444;
	j2281602090 [label="+5 Chemistry",color=orange];
		j2281602090 -> j3804769556;
	j701332136 [label="Per il Void, no! Non fidarti mai di un Orokin, Drifter. Me compreso. Soprattutto me! Amaci, odiaci, adoraci, disprezzati - ma non fidarti mai, mai, mai di noi.",shape=box,color=blue];
		j701332136 -> j66989416;
	j729581993 [label="Add -1 to Thermostat counter",color=orange];
		j729581993 -> j2460968698;
	j323090497 [label="Add 1 to Thermostat counter",color=orange];
		j323090497 -> j2442101491;
	j1048148444 [label="La disprezzavo assolutamente, e non avrei amato niente di più che staccarle lentamente, con attenzione e delicatezza la pelle blu dal corpo a mani nude.",shape=box,color=blue];
		j1048148444 -> j4241563755;
		j1048148444 -> j146727630;
	j3804769556 [label="Che domanda impertinente! Credo di adorarti per averla fatta. Sai credo di averla amata, solo un pochino. Onestamente, non mi sono nemmeno fermato a rifletterci fino a questo momento.",shape=box,color=blue];
		j3804769556 -> j2574469720;
	j66989416 [label="Siamo inclini ad attacchi di irrequietezza.",shape=box,color=blue];
		j66989416 -> j1006478186;
		j66989416 -> j1730533759;
	j2460968698 [label="+10 Chemistry",color=orange];
		j2460968698 -> j1842087327;
	j2442101491 [label="+10 Chemistry",color=orange];
		j2442101491 -> j3606088001;
	j4241563755 [label="Quello era... vivido.",shape=box,color=red];
		j4241563755 -> j1042902709;
	j146727630 [label="E nonostante ciò andavi a letto con lei?",shape=box,color=red];
		j146727630 -> j550221192;
	j2574469720 [label="Sì, credo di essermi solo un po' infatuato di lei. Che curiosa scoperta...",shape=box,color=blue];
		j2574469720 -> j2969938926;
	j1006478186 [label="Annotato.",shape=box,color=red];
		j1006478186 -> j3607220764;
	j1730533759 [label="Non sarebbe stato un problema.",shape=box,color=red];
		j1730533759 -> j912110477;
	j1842087327 [label="Potresti avere ragione. Vivere nel passato è pericoloso, perché ci carichiamo di rimpianti, vergogna e nient'altro. ",shape=box,color=blue];
		j1842087327 -> j3690699304;
	j3606088001 [label="Potresti avere ragione. Vivere nel passato è pericoloso, perché ci carichiamo di rimpianti, vergogna e nient'altro. ",shape=box,color=blue];
		j3606088001 -> j1518458677;
	j1042902709 [label="Immaginarlo nella mia mente è stata l'unica cosa che mi ha permesso di soffrire durante molte delle mie... serate obbligatorie nel suo letto. Mi scuso.",shape=box,color=blue];
		j1042902709 -> j552404260;
		j1042902709 -> j452933859;
	j550221192 [label="Il fatto che tu creda che queste due cose si escludano a vicenda è davvero adorabile. Spero che un giorno tu abbia l'opportunità di trascorrere una serata con una \"conoscenza\" del genere, è davvero magico.",shape=box,color=blue];
		j550221192 -> j716755929;
	j2969938926 [label="Devi capire che era anche offuscata dal più profondo e travolgente odio. La disprezzavo allo stesso modo e non avrei desiderato altro che strapparle lentamente, con cura e delicatezza, la pelle blu dal corpo a mani nude.",shape=box,color=blue];
		j2969938926 -> j3525451248;
		j2969938926 -> j776206187;
	j3607220764 [label="Evaluate expressions",color=orange];
		j3607220764 -> j3303568086 [label="RoatheDatingDeal",color=purple];
		j3607220764 -> j2286338942 [label="RoatheMarieDatingDeal",color=purple];
		j3607220764 -> j3939959742 [label="RoatheLyonDatingDeal",color=purple];
		j3607220764 -> j275742888 [label="DrifterRoathe",color=purple];
		j3607220764 -> j1724544328 [label="DrifterMarie",color=purple];
		j3607220764 -> j3939959742 [label="DrifterLyon",color=purple];
		j3607220764 -> j559010118 [label="false",color=purple];
	j912110477 [label="Mm, sì. Ho l'impressione di non riuscire proprio a conquistarti con il mio “fascino diabolico”, vero?",shape=box,color=blue];
		j912110477 -> j2851216734;
		j912110477 -> j2330176694;
	j3690699304 [label="Che senso ha rivivere le nostre azioni passate, i nostri fallimenti e i nostri rimpianti? Non possiamo cambiarli: anche con il dono del viaggio nel tempo, cercare di \"rifare\" ciò che è stato \"fatto\" è solo una strada che porta alla follia.",shape=box,color=blue];
		j3690699304 -> j480742719;
	j1518458677 [label="Ma non possiamo nemmeno dimenticare le azioni riprovevoli dei noi stessi del passato, perché rischiamo di diventare nient'altro che pazzi e despoti, creature bellicose che non vedono difetti in se stesse ma solo negli altri.",shape=box,color=blue];
		j1518458677 -> j3181005738;
	j552404260 [label="Hai questi pensieri riguardo a tutti i tuoi amanti? O solo riguardo a lei?",shape=box,color=red];
		j552404260 -> j2668949639;
	j452933859 [label="Non c'è bisogno di scusarsi. Sono solo ancora scioccato da quanto odiassi la tua gente.",shape=box,color=red];
		j452933859 -> j518787755;
	j716755929 [label="Ti consiglio semplicemente di non rendere queste relazioni permanenti. Diventano estremamente dannose per entrambe le parti. Di solito finiscono con un omicidio per uno o entrambi.",shape=box,color=blue];
		j716755929 -> j552404260;
		j716755929 -> j3182483743;
		j716755929 -> j1532343192;
	j3525451248 [label="Come è possibile che entrambe le cose siano vere contemporaneamente?",shape=box,color=red];
		j3525451248 -> j1169022517;
	j776206187 [label="Quello era... vivido.",shape=box,color=red];
		j776206187 -> j3051123686;
	j3303568086 [label="Ho semplicemente pensato di avvertirti, visto che abbiamo il nostro piccolo... accordo.",shape=box,color=blue];
		j3303568086 -> j2004392167;
	j2286338942 [label="Mm, comunque, non sarà mai un problema per te, no? Hai messo gli occhi più vicini a casa, con Marie, nel nostro piccolo \"accordo\".",shape=box,color=blue];
		j2286338942 -> j1704902968;
	j3939959742 [label="Mm, comunque, non sarà mai un problema per te, no? Hai messo gli occhi su quel prete pazzo, no?",shape=box,color=blue];
		j3939959742 -> j1430908486;
	j275742888 [label="Ho semplicemente pensato di avvertirti, visto che hai reso noti i tuoi... interessi.",shape=box,color=blue];
		j275742888 -> j2004392167;
	j1724544328 [label="Mm, comunque, non sarà mai un problema per te, no? Hai messo gli occhi più vicini a casa, con Marie, no?",shape=box,color=blue];
		j1724544328 -> j1704902968;
	j559010118 [label="+5 Chemistry",color=orange];
		j559010118 -> j2075180915;
	j2851216734 [label="No, mi dispiace. Non sei il mio tipo.",shape=box,color=red];
		j2851216734 -> j2687319786;
	j2330176694 [label="Lo sei. Semplicemente non mi fido di te.",shape=box,color=red];
		j2330176694 -> j4137689758;
	j480742719 [label="No. Sono quello che sono. Sono chi sono. Percorro la strada che ho scelto e ho superato il punto in cui desideravo scusarmi per quello che sono. Non cambierò ciò che sono per adeguarmi alle opinioni degli altri.",shape=box,color=blue];
		j480742719 -> j3163079979;
	j3181005738 [label="Questa era una caratteristica che ho riscontrato in molti degli Esecutori e degli Imperatori più poveri - una fede cieca solo nella propria infallibilità e innocenza. Li disprezzavo per questo e giurai che non avrei mai condiviso una tale arroganza egocentrica.",shape=box,color=blue];
		j3181005738 -> j3163079979;
	j2668949639 [label="Ho sempre avuto solo relazioni fisiche con i miei partner, Drifter. Non ho mai avuto relazioni emotive. Nessuna che fosse reciproca, almeno.",shape=box,color=blue];
		j2668949639 -> j1499742041;
		j2668949639 -> j1346033486;
	j518787755 [label="+5 Chemistry",color=orange];
		j518787755 -> j2859061487;
	j3182483743 [label="Lo prenderò a cuore.",shape=box,color=red];
		j3182483743 -> j1839214455;
	j1532343192 [label="Non lo avevo previsto, ma grazie per il consiglio.",shape=box,color=red];
		j1532343192 -> j878460869;
	j1169022517 [label="Il fatto che tu non abbia mai vissuto una cosa del genere ti rende estremamente fortunato, Usurpatore. Non ti consiglio di trovarti in una situazione del genere, perché di solito finisce con l'omicidio di uno o entrambi.",shape=box,color=blue];
		j1169022517 -> j2423905928;
		j1169022517 -> j1532343192;
		j1169022517 -> j3182483743;
	j3051123686 [label="Immaginarlo nella mia mente era l'unica cosa che mi permetteva di sopportare tante lunghe riunioni. Mi scuso.",shape=box,color=blue];
