	j1230035294 [label="+5 Chemistry",color=orange];
		j1230035294 -> j2016497462;
	j1554419982 [label="Devo spiegartelo chiaramente? Va bene. Non mi sono mai innamorato.",shape=box,color=blue];
		j1554419982 -> j1865420342;
	j82388668 [label="Nonostante tutti i nostri progressi, nonostante tutto il lavoro che abbiamo fatto per salvare l'umanità, non abbiamo mai risolto il problema più grande che affliggeva i nostri cuori. Il difetto più grande che divorava le nostre anime come un cancro atroce.",shape=box,color=blue];
		j82388668 -> j1454511207;
	j1474180563 [label="Fai in modo che sia così. Sembra che tu stia facendo del tuo meglio per vivere una vita virtuosa, Drifter. Per essere una persona \"buona\". Non vorrei vederti finire come gli Orokin. Eravamo caratterizzati dai nostri eccessi.",shape=box,color=blue];
		j1474180563 -> j2969788991;
	j1747670411 [label="Non c'è di che. Sembra che tu stia facendo del tuo meglio per vivere una vita virtuosa, Drifter. Per essere una persona \"buona\". Non vorrei vederti finire come gli Orokin. Eravamo caratterizzati dai nostri eccessi.",shape=box,color=blue];
		j1747670411 -> j2969788991;
	j1605838776 [label="Ho sempre avuto solo relazioni fisiche con i miei partner, Drifter. Non ho mai avuto relazioni emotive. Nessuna che fosse reciproca, almeno.",shape=box,color=blue];
		j1605838776 -> j1499742041;
		j1605838776 -> j1346033486;
	j3531468410 [label="Patetico, vero? Tutti i progressi compiuti nell'universo e ancora non riusciamo a capire come organizzarci senza sprecare ore della vita di tutti riuniti attorno a un tavolo a parlare senza ascoltarsi.",shape=box,color=blue];
		j3531468410 -> j82388668;
	j1908632732 [label="Beh, ora che sappiamo qual è il bersaglio a cui hai puntato il tuo arco, abbiamo qualcosa su cui lavorare, non è vero?",shape=box,color=blue];
		j1908632732 -> j3348978564;
		j1908632732 -> j2673587648;
	j162437090 [label="Non credo che mi fiderei di te per questo.",shape=box,color=red];
		j162437090 -> j3732883805;
	j3757508469 [label="Davvero? Aiuteresti?",shape=box,color=red];
		j3757508469 -> j125894962;
	j2035809670 [label="A quanto pare hai una certa inclinazione verso i \"protoframe\", dopotutto.",shape=box,color=blue];
		j2035809670 -> j2740473808;
		j2035809670 -> j562296522;
	j1246763861 [label="Oppure non hai alcuna inclinazione verso i \"protoframe\"?",shape=box,color=blue];
		j1246763861 -> j2654019545;
		j1246763861 -> j4225436158;
	j2504833740 [label="E prima che inizi a scrivere una replica furiosa e a denunciare con rabbia la mia persona per aver incoraggiato qualsiasi tipo di infedeltà da parte tua, concedimi un momento per spiegarti.",shape=box,color=blue];
		j2504833740 -> j1357175159;
	j3165957045 [label="È Lyon.",shape=box,color=red];
		j3165957045 -> j2990673833;
	j261372910 [label="È Marie.",shape=box,color=red];
		j261372910 -> j593832811;
	j3350105640 [label="[Confessa i tuoi sentimenti.] ...Sì..",shape=box,color=red];
		j3350105640 -> j2736427932;
	j3237243855 [label="No.",shape=box,color=red];
		j3237243855 -> j1640513030;
	j84380407 [label="Non sono affari tuoi.",shape=box,color=red];
		j84380407 -> j2826951630;
	j2016497462 [label="Quanto è triste? Lo so. No, mai. Mai reciprocamente.",shape=box,color=blue];
		j2016497462 -> j1865420342;
	j1865420342 [label="È mai stata una relazione a senso unico? Oh, certamente. Ma non è una storia d'amore, vero? È una tragedia.",shape=box,color=blue];
		j1865420342 -> j1789658476;
	j1454511207 [label="Burocrazia.",shape=box,color=blue];
		j1454511207 -> j572233923;
	j2969788991 [label="È un'esistenza che tende a definirti attraverso la sua solitudine.",shape=box,color=blue];
		j2969788991 -> j2423905928;
	j3348978564 [label="Non sembri sorpreso.",shape=box,color=red];
		j3348978564 -> j2025016595;
	j2673587648 [label="Non sapevo come avresti reagito.",shape=box,color=red];
		j2673587648 -> j2025016595;
	j3732883805 [label="Probabilmente saggio. Banale, ma saggio.",shape=box,color=blue];
		j3732883805 -> j1206686388;
	j125894962 [label="Certo! Nel migliore dei casi, tu distrai uno di loro dall'obiettivo apparentemente irrealizzabile di disturbarmi.",shape=box,color=blue];
		j125894962 -> j1831275363;
	j2740473808 [label="Però, sto già con qualcuno. Non sarebbe un problema per te? O per Marie o Lyon?",shape=box,color=red];
		j2740473808 -> j574205629;
	j562296522 [label="Ho già una relazione.",shape=box,color=red];
		j562296522 -> j3137251007;
