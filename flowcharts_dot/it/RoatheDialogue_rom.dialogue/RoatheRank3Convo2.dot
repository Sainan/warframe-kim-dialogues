		j2826951630 -> j3427851117;
	j1789658476 [label="Ora mi consideri un diavolo? La mia reputazione è solo migliorata in questo lontano futuro, mio Usurpatore.",shape=box,color=blue];
		j1789658476 -> j3169583327;
	j572233923 [label="Niente al mondo ostacola la grandezza umana quanto l'adesione a sistemi e burocrazia a tutti i costi.",shape=box,color=blue];
		j572233923 -> j3085569400;
	j2025016595 [label="Pensi di essere la prima persona che incontro che vuole \"ballare con il diavolo di Tau\"? Difficile. Resta solo da vedere quanto sia genuino il tuo interesse, o se finisce semplicemente dopo aver passato una notte o due a togliersi lo sfizio.",shape=box,color=blue];
		j2025016595 -> j2063606459;
	j1206686388 [label="Immagino che dovrò semplicemente sedermi e guardare tutto crollare. Oppure, se ci riesci, uno di loro si distrae troppo dalla causa apparentemente irrealizzabile di disturbarmi.",shape=box,color=blue];
		j1206686388 -> j3665214502;
	j1831275363 [label="Nel peggiore dei casi, tutto finisce in modo terribile e mi vengono concesse ore di intrattenimento gratuito. ",shape=box,color=blue];
		j1831275363 -> j3665214502;
	j574205629 [label="Potresti rimanere sorpreso. Noi Orokin eravamo famosi per avere più partner, certo, ma lo facevamo solo per l'affetto fisico.",shape=box,color=blue];
		j574205629 -> j2535299931;
