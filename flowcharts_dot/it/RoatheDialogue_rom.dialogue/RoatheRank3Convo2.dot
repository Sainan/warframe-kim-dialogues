		j2654019545 -> j1640513030;
	j4225436158 [label="Si. Il mio cuore appartiene già a qualcuno, ma queste cose richiedono tempo.",shape=box,color=red];
		j4225436158 -> j509795229;
	j1357175159 [label="Quando si vive tanto a lungo quanto noi, si arriva a capire che alcuni cuori possono nutrire affetto per molte più persone.",shape=box,color=blue];
