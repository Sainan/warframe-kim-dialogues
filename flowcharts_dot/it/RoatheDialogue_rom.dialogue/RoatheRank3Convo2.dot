		j2423905928 -> j1605838776;
	j77331713 [label="Non avevo mai pensato alle riunioni del consiglio degli Orokin, fino ad ora.",shape=box,color=red];
		j77331713 -> j3531468410;
	j323761342 [label="Com'è bello sapere che, dopotutto, il buon gusto e la classe non hanno abbandonato questo sistema.",shape=box,color=blue];
		j323761342 -> j1908632732;
	j3643106366 [label="Ma! Fai come vuoi. Fammi sapere se posso esserti d'aiuto. Mi diverte molto l'idea di vedere te e quel fanatico invischiati in ogni sorta di inutili coinvolgimenti emotivi.",shape=box,color=blue];
		j3643106366 -> j162437090;
