		j509795229 -> j3165957045;
		j509795229 -> j261372910;
		j509795229 -> j4183502316;
	j4236925035 [label="È semplicemente un altro modo di essere, per coloro che vivono la vita in questo modo.",shape=box,color=blue];
		j4236925035 -> j2961805222;
	j3744484186 [label="Cosa? Perché?! Hai davvero così poco rispetto per te stesso? O hai una propensione a collezionare cose tristi e miserabili?",shape=box,color=blue];
		j3744484186 -> j2958823509;
	j1509269875 [label="Perché non mi sorprende? Con quella cosa... che ti rimbalza continuamente nel campo visivo, non c'è da stupirsi. È un miracolo che qualcuno qui riesca a lavorare.",shape=box,color=blue];
		j1509269875 -> j2853726681;
	j2231113973 [label="+5 Chemistry",color=orange];
		j2231113973 -> j1428354630;
	j1562154857 [label="Il dolore.",shape=box,color=blue];
		j1562154857 -> j1403509775;
