		j2681580443 -> j2035809670 [label=true,color=green];
		j2681580443 -> j1246763861 [label=false,color=brown];
	j4107824157 [label="Mm. Saggio. Anche se questo solleva una domanda: ho attirato la tua attenzione, Drifter? Se pensi che mi preoccupi il fatto che tu sia coinvolto in un'altra storia, non è così.",shape=box,color=blue];
		j4107824157 -> j2504833740;
	j1064443090 [label="Mm. Saggio. Anche se questo solleva una domanda: ho attirato la tua attenzione, Drifter?",shape=box,color=blue];
