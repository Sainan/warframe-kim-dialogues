	j3931801854 [label="E se il tuo piano non avesse funzionato?",shape=box,color=red];
		j3931801854 -> j1835947540;
	j1284507757 [label="E cosa avresti fatto?",shape=box,color=red];
		j1284507757 -> j887113677;
	j3686095797 [label="Cosa pensavi di fare con Nitokh?",shape=box,color=red];
		j3686095797 -> j1932713100;
	j1835947540 [label="Era una delle migliaia di possibili esiti per i quali avevo un piano. ",shape=box,color=blue];
		j1835947540 -> j1594894633;
	j887113677 [label="C'erano mille possibili esiti per ciò che avevamo pianificato. Per ogni variabile in gioco, veniva creata una possibile variante di percorso. ",shape=box,color=blue];
		j887113677 -> j1747540036;
	j1932713100 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1932713100 -> j998979601 [label=true,color=green];
		j1932713100 -> j4059933629 [label=false,color=brown];
	j1594894633 [label="Se avessimo fallito clamorosamente, avrei semplicemente mangiato la fine di un Lex e sarebbe finita così.",shape=box,color=blue];
		j1594894633 -> j1715943653;
	j1747540036 [label="E per ciascuno di essi avevo pianificato un risultato. E per ciascuno di essi sapevo cosa intendevo fare. Molti erano simili nelle linee generali, ma diversi nei dettagli.",shape=box,color=blue];
		j1747540036 -> j1104561143;
	j998979601 [label="Cosa ti ho detto prima a riguardo? Perché mi rendo conto che non mi fido ancora abbastanza di te per dirtelo apertamente.",shape=box,color=blue];
		j998979601 -> j1453329752;
		j998979601 -> j3472113438;
	j4059933629 [label="Si trattava di una questione complessa... frutto di una grande negoziazione tra noi.",shape=box,color=blue];
		j4059933629 -> j811978568;
		j4059933629 -> j2717955827;
	j1715943653 [label="Non ha senso piangere nel Kuva versato, e tutto il resto.",shape=box,color=blue];
		j1715943653 -> j4099157774;
		j1715943653 -> j4270392567;
	j1104561143 [label="Se avessimo fallito clamorosamente, avrei semplicemente mangiato la fine di un Lex e sarebbe finita così.",shape=box,color=blue];
		j1104561143 -> j2438936959;
	j1453329752 [label="Mi hai detto tutto.",shape=box,color=red];
		j1453329752 -> j2365282496;
	j3472113438 [label="Allora non ti costringerò a dirmi più di quanto vorresti.",shape=box,color=red];
		j3472113438 -> j955581315;
	j811978568 [label="C'è molto nascosto in questa frase.",shape=box,color=red];
		j811978568 -> j3367265769;
	j2717955827 [label="Che tipo di trattative?",shape=box,color=red];
		j2717955827 -> j439059604;
	j4099157774 [label="Personalmente, sarei scappato.",shape=box,color=red];
		j4099157774 -> j2549470824;
	j4270392567 [label="Avresti semplicemente accettato la morte?",shape=box,color=red];
		j4270392567 -> j14876860;
	j2438936959 [label="Se il successo fosse stato mediocre, come era probabile che fosse, sarebbe stato necessario un lavoro di pulizia per assicurarsi che tutti i fili sciolti fossero stati “risolti”. Naturalmente, io ero uno di quei fili. E avevo preso delle misure per assicurarmi di essere ancora troppo prezioso nel breve termine per essere tagliato insieme agli altri.",shape=box,color=blue];
		j2438936959 -> j3869401309;
	j2365282496 [label="Allora non ha senso che mi ripeta, no? In realtà, questa conversazione non ha proprio alcun senso. Ti auguro una buona giornata.",shape=box,color=blue];
		j2365282496 -> "Chat ends.";
	j955581315 [label="+5 Chemistry",color=orange];
		j955581315 -> j1353068333;
	j3367265769 [label="+5 Chemistry",color=orange];
		j3367265769 -> j1672311569;
	j439059604 [label="Di tutti i tipi che puoi immaginare.",shape=box,color=blue];
		j439059604 -> j1861383400;
	j2549470824 [label="E dove corri, mio Usurpatore? Non tutti abbiamo un rifugio tascabile quando siamo nel panico.",shape=box,color=blue];
		j2549470824 -> j3183979941;
	j14876860 [label="Non avrei avuto molta scelta, vero? Nessun posto dove andare, nessun posto dove nascondermi.",shape=box,color=blue];
		j14876860 -> j3183979941;
	j3869401309 [label="Se la situazione fosse stata un successo clamoroso, avrei portato avanti la seconda fase del piano.",shape=box,color=blue];
		j3869401309 -> j1383662177;
		j3869401309 -> j1709571027;
	j1353068333 [label="Bene. Dirò che si è trattato di una questione complessa... frutto di una grande negoziazione tra noi.",shape=box,color=blue];
		j1353068333 -> j811978568;
		j1353068333 -> j2717955827;
	j1672311569 [label="Secoli sotto la sabbia.",shape=box,color=blue];
		j1672311569 -> j1861383400;
	j1861383400 [label="Boolean RoatheExecutor2 is now true.",color=orange];
		j1861383400 -> j1717274806;
