	j1381455373 [label="Come pensavi di sovvertire gli Esecutori?",shape=box,color=red];
		j1381455373 -> j3720655375;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j3720655375 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3720655375 -> j4165130508 [label=true,color=green];
		j3720655375 -> j460856517 [label=false,color=brown];
	"Chat ends." [color=orange];
	j4165130508 [label="Perché me lo chiedi? Cosa stai cercando di scoprire, Drifter? Non mi stai certo chiedendo dove si trovino le munizioni.",shape=box,color=blue];
		j4165130508 -> j743475530;
	j460856517 [label="Perché? Stai pensando di tornare indietro nel tempo e battere il record del tuo io più giovane? Hai bisogno di consigli su come sovvertire un governo totalitario? Stai cercando le munizioni sepolte che potrebbero far esplodere interi pianeti?",shape=box,color=blue];
		j460856517 -> j18788820;
	j743475530 [label="Perché dovrei fidarmi di te? Perché mi sono fidato di te?!",shape=box,color=blue];
		j743475530 -> j2310817378;
	j18788820 [label="Oppure stai semplicemente parlando tanto per parlare?",shape=box,color=blue];
		j18788820 -> j1436997558;
		j18788820 -> j2311462248;
		j18788820 -> j2237058009;
	j2310817378 [label="Check boolean RoatheResetForgiven",color=orange];
		j2310817378 -> j4058885055 [label=true,color=green];
		j2310817378 -> j210452222 [label=false,color=brown];
	j1436997558 [label="Sono curioso di sapere se ti sei pentito di qualcosa, sinceramente. Se tornernassi indietro e cambieresti qualcosa di ciò che avevi pianificato.",shape=box,color=red];
		j1436997558 -> j3942960454;
	j2311462248 [label="Sono affascinato dall'idea di cosa avrebbe significato provare a elaborare un piano del genere. Dev'essere stato un capolavoro.",shape=box,color=red];
		j2311462248 -> j571347974;
	j2237058009 [label="Onestamente, potrebbe essere utile sapere se hai nascosto qualcuna di quelle armi in un posto ancora accessibile.",shape=box,color=red];
		j2237058009 -> j1853723615;
	j4058885055 [label="Ti ho perdonato per aver commesso quell'atto. Vorrei solo ricordare il perché - il perché! Perché proprio tu, tra tutti?!",shape=box,color=blue];
		j4058885055 -> j3250781486;
		j4058885055 -> j1484809012;
	j210452222 [label="Perché! Perché proprio tu, tra tutti?!",shape=box,color=blue];
		j210452222 -> j1484809012;
		j210452222 -> j3908567422;
	j3942960454 [label="Add 1 to Thermostat counter",color=orange];
		j3942960454 -> j358612517;
	j571347974 [label="Add -1 to Thermostat counter",color=orange];
		j571347974 -> j4102836943;
	j1853723615 [label="+5 Chemistry",color=orange];
		j1853723615 -> j2749436744;
	j3250781486 [label="Lo so. E ancora mi dispiace tanto.",shape=box,color=red];
		j3250781486 -> j742100507;
	j1484809012 [label="Sto cercando di farti capire il perché.",shape=box,color=red];
		j1484809012 -> j236888249;
	j3908567422 [label="Mi dispiace ancora di aver tradito la tua fiducia, Roathe. Non era voluto, che tu ci creda o no.",shape=box,color=red];
		j3908567422 -> j950663501;
	j358612517 [label="L'unica cosa che rimpiango è che non si sia mai concretizzato. Rimpiango il tempo sprecato.",shape=box,color=blue];
		j358612517 -> j2434750850;
	j4102836943 [label="E Usurpatore, era un capolavoro.",shape=box,color=blue];
		j4102836943 -> j2434750850;
	j2749436744 [label="Pratico. Ma molti dei posti in cui ho \"nascosto\" le mie provviste probabilmente... sono andati perduti nel corso dei tanti, tanti anni trascorsi.",shape=box,color=blue];
		j2749436744 -> j3306177957;
	j742100507 [label="Sì, sì. Immagino che dovremmo continuare questa sciocca conversazione, ripercorrendo ancora una volte le nostre conversazioni precedenti.",shape=box,color=blue];
		j742100507 -> j1168754520;
	j236888249 [label="+5 Chemistry",color=orange];
		j236888249 -> j1297773704;
	j950663501 [label="Sì, probabilmente pensavi che le tue azioni non avrebbero avuto conseguenze. Ma a prescindere da tutto, dovremmo continuare con questa stupida conversazione in cui ripercorriamo il nostro passato e andare avanti e basta.",shape=box,color=blue];
		j950663501 -> j1168754520;
	j2434750850 [label="+5 Chemistry",color=orange];
		j2434750850 -> j1500290245;
	j3306177957 [label="E molti dei luoghi erano segreti persino per me. Il piano era oltremodo intricato. Strati su strati su strati.",shape=box,color=blue];
		j3306177957 -> j1504460560;
	j1168754520 [label="Quale era la tua domanda? Ah! Sì. \"Come pensavo di spodestare gli Esecutori?\" ",shape=box,color=blue];
		j1168754520 -> j3850706947;
	j1297773704 [label="Riprendendo le stesse inutili conversazioni sul perché volessi uccidere persone ormai morte e ridotte in polvere da tempo? Almeno questo è l'approccio pragmatico.",shape=box,color=blue];
		j1297773704 -> j1168754520;
	j1500290245 [label="Il piano era oltremodo intricato. Strati su strati su strati. Assassini che avrebbero ucciso gli assassini di altri assassini se il primo avesse fallito.",shape=box,color=blue];
		j1500290245 -> j1569662193;
	j1504460560 [label="Assassini che ucciderebbero gli assassini di altri assassini se il primo dovesse fallire.",shape=box,color=blue];
		j1504460560 -> j1569662193;
	j3850706947 [label="Perché?",shape=box,color=blue];
		j3850706947 -> j1436997558;
		j3850706947 -> j2311462248;
		j3850706947 -> j2237058009;
	j1569662193 [label="Bombe piazzate su diversi edifici, intere navi e un'intera luna preparate per esplodere con esplosivi rubati. Una rotaia solare pronta per uscire dall'orbita.",shape=box,color=blue];
		j1569662193 -> j3410327702;
	j3410327702 [label="E tutto questo era stato truccato per sembrare un \"Grande Disastro Sentient\" quando sarebbe arrivato il momento. Nitokh e io avremmo dichiarato l'Impero in stato di emergenza una volta che gli Esecutori e gli Imperatori fossero stati... sistemati.",shape=box,color=blue];
		j3410327702 -> j1742364006;
	j1742364006 [label="Boolean RoatheTraitor2 is now true.",color=orange];
		j1742364006 -> j285070892;
	j285070892 [label="Check boolean RoatheExecutor1",color=orange];
