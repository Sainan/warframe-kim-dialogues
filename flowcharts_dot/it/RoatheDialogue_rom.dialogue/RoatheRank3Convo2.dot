		j3051123686 -> j452933859;
		j3051123686 -> j77331713;
	j2004392167 [label="+5 Chemistry",color=orange];
		j2004392167 -> j323761342;
	j1704902968 [label="È davvero carina, non ti biasimo. Anche se personalmente non credo che potrei resistere alla sua ipocrisia.",shape=box,color=blue];
		j1704902968 -> j3643106366;
	j1430908486 [label="È abbastanza affascinante. Ma ha l'aria di uno che, se un fiore appassisce, potrebbe dichiarare che è la fine di tutto e gettarsi dalla torre più vicina.",shape=box,color=blue];
		j1430908486 -> j3643106366;
	j2075180915 [label="Mi chiedo chi di noi abbia catturato la tua attenzione, se è questo il caso.",shape=box,color=blue];
		j2075180915 -> j2681580443;
	j2687319786 [label="Peggio per te, ma hai comunque una vasta gamma di opzioni tra cui scegliere, no? Sono certo che troverai qualcuno con cui... divertirti.",shape=box,color=blue];
