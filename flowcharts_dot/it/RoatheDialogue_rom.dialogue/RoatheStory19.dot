	j3505723437 [label="MV: DIPLOMAZIA",shape=box,color=blue];
		j3505723437 -> j1847778342;
	j1847778342 [label="Trascrizione: Tra i Sette Esecutori, Ballas si era autoproclamato il prima tra pari. ",shape=box,color=blue];
		j1847778342 -> j2398819861;
	j2398819861 [label="Sempre diplomatico, sempre persuasore della voce melliflua, appianava i rancori e le dispute degli altri.",shape=box,color=blue];
		j2398819861 -> j2086700004;
	j2086700004 [label="Scoprii, con mia immensa gioia, che ora era lui la rosa intrappolata tra due cespugli di spine. ",shape=box,color=blue];
		j2086700004 -> j3963633967;
	j3963633967 [label="La fazione guerrafondaia, guidata da Nitokh, tirava da una parte. I pacifisti, guidati da Scarne, dall'altra.",shape=box,color=blue];
		j3963633967 -> j3516709009;
	j3516709009 [label="Ballas fu costretto a decidere, e a guadagnarsi la feroce inimicizia di qualsiasi gruppo con cui non si schierasse.",shape=box,color=blue];
		j3516709009 -> j2318003753;
	j2318003753 [label="Per ragioni che non riesco a immaginare, scelse la pace; era quattro a tre, e così i famelici Sentient divennero improvvisamente alleati e amici.",shape=box,color=blue];
		j2318003753 -> j3792024173;
	j3792024173 [label="\"In un modo o nell'altro, cambierà idea\", promise Nitokh, mentre venivo inviato a cercare i malcontenti tra la guarnigione Dax.",shape=box,color=blue];
		j3792024173 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}