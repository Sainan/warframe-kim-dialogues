	2300 [label="Ballas fu costretto a decidere, e a guadagnarsi la feroce inimicizia di qualsiasi gruppo con cui non si schierasse.",shape=box,color=blue];
		2300 -> 2305;
	2305 [label="Per ragioni che non riesco a immaginare, scelse la pace; era quattro a tre, e così i famelici Sentient divennero improvvisamente alleati e amici.",shape=box,color=blue];
