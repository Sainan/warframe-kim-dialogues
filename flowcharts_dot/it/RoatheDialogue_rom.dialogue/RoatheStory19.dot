	2301 [label="Scoprii, con mia immensa gioia, che ora era lui la rosa intrappolata tra due cespugli di spine. ",shape=box,color=blue];
		2301 -> 5734;
	5734 [label="La fazione guerrafondaia, guidata da Nitokh, tirava da una parte. I pacifisti, guidati da Scarne, dall'altra.",shape=box,color=blue];
