digraph {
	1042 [label="RoatheRank2Convo3 begins.",color=orange];
		1042 -> 1043;
	1043 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1043 -> 1044 [label=true,color=green];
		1043 -> 1045 [label=false,color=brown];
	1044 [label="Check boolean RoatheKnowsReset2",color=orange];
		1044 -> 1046 [label=true,color=green];
		1044 -> 1047 [label=false,color=brown];
	1045 [label="Chat ends.",color=orange];
	1046 [label="So che probabilmente l'avrai già sentito dire, ma oggi non mi interessa - non ho la pazienza.",shape=box,color=blue];
		1046 -> 1047;
	1047 [label="Penso che la causa della caduta dell'Impero Orokin sia stata l'eccessiva stratificazione del vetro.",shape=box,color=blue];
		1047 -> 1048;
		1047 -> 1049;
		1047 -> 1050;
	1048 [label="Come mai?",shape=box,color=red];
		1048 -> 1051;
	1049 [label="Troppo impersonale?",shape=box,color=red];
		1049 -> 1052;
	1050 [label="[Fine.]",shape=box,color=red];
		1050 -> 1053;
	1051 [label="Immagina una società fondata sulla consapevolezza che sei, a tutti gli effetti, al sicuro per sempre. Protetto. Anche dal grande spettro della morte.",shape=box,color=blue];
		1051 -> 1054;
	1052 [label="+5 Chemistry",color=orange];
		1052 -> 1055;
	1053 [label="Chat ends.",color=orange];
	1054 [label="Dove niente può farti del male.",shape=box,color=blue];
		1054 -> 1056;
	1055 [label="Esattamente. Troppo distante dal pericolo e dalla realtà della situazione.",shape=box,color=blue];
		1055 -> 1051;
	1056 [label="Questo porta a una sorta di noia che inizia a inventare il proprio pericolo, Usurpatore. Politica. Intrighi di corte. Improvvisamente ci siamo ritrovati a escogitare nuovi modi ingegnosi per metterci in pericolo, dato che avevamo sostituito quelli vecchi.",shape=box,color=blue];
		1056 -> 1057;
		1056 -> 1058;
	1057 [label="Perché mi parli di questo?",shape=box,color=red];
		1057 -> 1059;
	1058 [label="Cos'è peggio? Venire sparati, o dover guardarsi le spalle?",shape=box,color=red];
		1058 -> 1060;
	1059 [label="Ci sono stati pochissimi aspetti interessanti o piacevoli del mio... soggiorno forzato in 'Gaule'. Il cibo era uno di questi. Il secondo invece... erano le tempeste.",shape=box,color=blue];
		1059 -> 1061;
	1060 [label="Ah! Non sono sicuro di avere una preferenza, essendo esperto in entrambe le arti, temo. E tu quale preferisci?",shape=box,color=blue];
		1060 -> 1062;
		1060 -> 1063;
	1061 [label="Temporali come non ne avevo mai visti in tutti i miei anni da Orokin. Scuotevano la terra stessa, facevano tremare le finestre con i loro infissi di legno. Riuscivo a sentirli persino giù nella cripta polverosa dove ci tenevano rinchiusi.",shape=box,color=blue];
		1061 -> 1064;
	1062 [label="Mi piace sapere chi sono i miei nemici, in modo chiaro e semplice. Che mi attacchino a colpi di pistola.",shape=box,color=red];
		1062 -> 1065;
	1063 [label="Venire sparato. Preferisco poter tirare le fila per portare a termine il lavoro. Posso prendermi tutto il tempo necessario.",shape=box,color=red];
		1063 -> 1066;
	1064 [label="Quando attraversavano la città, mi arrampicavo sul campanile per avvicinarmi il più possibile. Volevo sentire l'elettricità nell'aria, la pioggia battente sulla mia pelle.",shape=box,color=blue];
		1064 -> 1067;
		1064 -> 1068;
		1064 -> 1069;
	1065 [label="Add 1 to Thermostat",color=orange];
		1065 -> 1070;
	1066 [label="Add -1 to Thermostat",color=orange];
		1066 -> 1071;
	1067 [label="Non era un po' pericoloso?",shape=box,color=red];
		1067 -> 1072;
	1068 [label="Sembra fantastico.",shape=box,color=red];
		1068 -> 1073;
	1069 [label="Cosa pensavano Marie e Lyon della tua fuga?",shape=box,color=red];
		1069 -> 1074;
	1070 [label="Capisco, e devo ammettere che c'è una certa semplicità da apprezzare in tutto questo. Difficile scambiare un nemico per qualcos'altro quando ti punta una pistola in faccia.",shape=box,color=blue];
		1070 -> 1075;
	1071 [label="Mm, delizioso, no? Un piano accurato, elaborato ad arte, che si concretizza? Guardare tutti i pezzi andare al loro posto... è molto divertente.",shape=box,color=blue];
		1071 -> 1075;
	1072 [label="Ed era proprio quello lo scopo dell'impresa! Non riesco a descrivere cosa si provasse a sentire un potere così puro. No, era più di quello; era potere vero. Ho guardato quelle nuvole scure e vorticose, illuminate da fulmini furiosi, e ho visto ciò che i miei antenati avevano cercato così disperatamente di sfruttare.",shape=box,color=blue];
		1072 -> 1076;
	1073 [label="+5 Chemistry",color=orange];
		1073 -> 1077;
	1074 [label="Scrivi quelle parole come se ci avessi riflettuto anche solo per un istante. Non mi hanno seguito, se è questo che mi stai chiedendo. Al prete non importava nulla se mi fossi ucciso con un fulmine, ne sono certo. E Marie? Probabilmente era troppo occupata ad adorare i suoi falsi idoli. Sol o Albrecht, scegli tu.",shape=box,color=blue];
		1074 -> 1078;
	1075 [label="+5 Chemistry",color=orange];
		1075 -> 1079;
	1076 [label="Inoltre, sapevo che la mia presenza lì avrebbe potuto uccidermi e che non ci sarebbe stato alcun Kuva nelle vicinanze per rianimarmi. In più, sapevo che il sacro Kuva non avrebbe funzionato sul mio corpo deformato e contorto. ",shape=box,color=blue];
		1076 -> 1080;
	1077 [label="Lo era! Non riesco a descrivere cosa si provasse a sentire un potere così puro. No, era più di quello; era potere vero. Ho guardato quelle nuvole scure e vorticose, illuminate da fulmini furiosi, e ho visto ciò che i miei antenati avevano cercato così disperatamente di sfruttare.",shape=box,color=blue];
		1077 -> 1076;
	1078 [label="Ma sentire un potere così puro? No, era più di quello; era potere vero. Ho guardato quelle nuvole scure e vorticose, illuminate da fulmini furiosi, e ho visto ciò che i miei antenati avevano cercato così disperatamente di sfruttare.",shape=box,color=blue];
		1078 -> 1076;
	1079 [label="Trovo tuttavia che, come per tutte le cose nella vita, la moderazione e un mix di entrambi siano la chiave del successo. Concentrarsi troppo su uno dei due aspetti rischia di portare all'abbandono dell'altro.",shape=box,color=blue];
		1079 -> 1081;
	1080 [label="Mi terrorizzava. Ho provato paura, Drifter. Paura. Per la prima volta in... secoli, forse?",shape=box,color=blue];
		1080 -> 1082;
		1080 -> 1083;
	1081 [label="È così che creiamo creature come Ballas e Nitokh, temo. Il Manipolatore e la Regina di Sangue. Bah.",shape=box,color=blue];
		1081 -> 1084;
	1082 [label="Hai paura di morire?",shape=box,color=red];
		1082 -> 1085;
	1083 [label="E cosa hai fatto?",shape=box,color=red];
		1083 -> 1086;
	1084 [label="Ma sono qui per parlare di tempeste.",shape=box,color=blue];
		1084 -> 1059;
	1085 [label="Sì, sembra proprio di sì! Anzi, molto intensamente, potrei aggiungere. E questa è stata una scoperta per me in quel momento. Non temo ciò che viene dopo la morte, Drifter. Semplicemente non desidero ancora che la mia vita finisca. Non ho ancora finito di viverla.",shape=box,color=blue];
		1085 -> 1087;
	1086 [label="Mi arrampicai sulla balaustra di pietra accanto al gargoyle contorto, stesi le braccia lungo i fianchi e... risi. Risi nella tempesta.",shape=box,color=blue];
		1086 -> 1088;
	1087 [label="Il che fu di per sé una rivelazione. Mi arrampicai sulla balaustra di pietra accanto al gargoyle contorto, stesi le braccia lungo i fianchi e... risi. Risi nella tempesta.",shape=box,color=blue];
		1087 -> 1089;
	1088 [label="Perché improvvisamente ho realizzato che non temo ciò che viene dopo la morte, Drifter. Semplicemente non desidero ancora che la mia vita finisca. Non ho ancora finito di viverla.",shape=box,color=blue];
		1088 -> 1089;
	1089 [label="Nonostante tutto. Nonostante la desolazione di Tau. Nonostante la distruzione dell'Impero Orokin che sapevo ormai inevitabile. Nonostante la deformità del mio corpo in... questo stato. Nonostante fossi stato catapultato nel passato e abbandonato al mio destino.",shape=box,color=blue];
		1089 -> 1090;
	1090 [label="Sapevo che avrei trovato un modo per tornare qui. A questo momento. In questo luogo. Dove Albrecht aveva lasciato tutte le sue cose più preziose.",shape=box,color=blue];
		1090 -> 1091;
	1091 [label="+5 Chemistry",color=orange];
		1091 -> 1092;
	1092 [label="Perché non ho ancora finito di vivere la mia vita. Ma per il Void, mi assicurerò anche che lui abbia finito di vivere la sua.",shape=box,color=blue];
		1092 -> 1093;
	1093 [label="Update boolean RoatheEntrati1",color=orange];
		1093 -> 1094;
	1094 [label="Chat ends.",color=orange];
}