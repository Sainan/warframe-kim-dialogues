		j517731503 -> j2926848596;
	j121280023 [label="Spero che questo non susciti in te sentimenti di gelosia. Non è questa la mia intenzione. Sto solo cercando di spiegare quando male abbia causato.",shape=box,color=blue];
		j121280023 -> j65740391;
	j3211720588 [label="Senza di lei, non sarei quello che sono. ho imparato tutto quello che so da lei. Ha preso l'argilla grezza e l'ha modellata.",shape=box,color=blue];
