		j2189214741 -> j3455945530;
	j630703964 [label="+5 Chemistry",color=orange];
		j630703964 -> j1667029288;
	j3343184863 [label="Non è del tutto esatto. L'ho fatto. Non la amo più. Non mi importa più se subirà una brutale morte per mano mia. Ma mi ritrovo incredibilmente curioso di sapere come è finita la sua storia.",shape=box,color=blue];
		j3343184863 -> j2082311492;
