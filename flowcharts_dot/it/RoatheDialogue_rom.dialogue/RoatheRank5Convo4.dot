		j562229145 -> j1624913536;
	j2926848596 [label="+5 Chemistry",color=orange];
		j2926848596 -> j915859398;
	j65740391 [label="Eppure, quanto le devo, allo stesso tempo. Senza di lei, non sarei quello che sono. ho imparato tutto quello che so da lei. Ha preso l'argilla grezza e l'ha modellata.",shape=box,color=blue];
