		"Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j4258663986 [label="È per il bene del passato che mi ritrovo curioso di sapere che fine ha fatto. Semplicemente perché voglio sapere come è finita la sua storia. Se mai è finita.",shape=box,color=blue];
		j4258663986 -> j2082311492;
	j3455945530 [label="Perdonami, visto sei stato tu a tirarla fuori. Sei davvero piuttosto sconcertante, caro Drifter.",shape=box,color=blue];
		j3455945530 -> "Chat ends.";
	j1667029288 [label="Allora puoi capire perchè sono curioso di sapere che fine ha fatto. Semplicemente perché voglio sapere come è finita la sua storia. Se mai è finita.",shape=box,color=blue];
		j1667029288 -> j2082311492;
	j2082311492 [label="È difficile liberarsi di coloro che sono stati protagonisti così importanti della propria storia. Non importa quanto siano velenosi.",shape=box,color=blue];
