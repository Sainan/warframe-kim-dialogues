	j915859398 [label="Consideralo fatto. Ricorda solo che l'unica cosa più pericolosa di un diavolo... è un diavolo con amici come te con debiti da pagare.",shape=box,color=blue];
		j915859398 -> "Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j1266590729 [label="Capisco. Nessun problema.",shape=box,color=red];
