		j4082858284 -> j511900548 [label=true,color=green];
		j4082858284 -> "Chat ends." [label=false,color=brown];
	j1759533559 [label="Ehi Roathe? Hai un secondo? [Chiedi il consenso per avere più partner.]",shape=box,color=red];
		j1759533559 -> j1333566090;
	j503453570 [label="[Fine.]",shape=box,color=red];
		j503453570 -> j604242687;
	j1333566090 [label="Mh? Dimmi, tesoro.",shape=box,color=blue];
		j1333566090 -> j4131818604;
	j604242687 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j604242687 -> "Chat ends.";
	j4131818604 [label="Vorrei parlarti di una cosa e voglio assicurarmi che tu sia d'accordo.",shape=box,color=red];
		j4131818604 -> j4043740547;
	j4043740547 [label="Per me è importante che tu non abbia la sensazione che ti stia mentendo o che sia disonesto nei tuoi confronti.",shape=box,color=red];
		j4043740547 -> j585856513;
	j585856513 [label="Continua. Sembra che sarà qualcosa di bello.",shape=box,color=blue];
		j585856513 -> j511094214;
	j511094214 [label="Non voglio metterti in una situazione che ti crea disagio. Quindi se non sarai d'accordo, va bene. Voglio che tu lo sappia.",shape=box,color=red];
		j511094214 -> j3904919676;
	j3904919676 [label="Ciò che abbiamo è importante per me - molto importante - ed è reale. Non voglio che ne dubiti.",shape=box,color=red];
		j3904919676 -> j3376248413;
	j3376248413 [label="Aspetta. Per il Void, stai cercando di evitare di dirmi che hai un altro partner?",shape=box,color=blue];
		j3376248413 -> j1967425915;
	j1967425915 [label="Quanto stupido pensi che io sia? Lo so già, caro Drifter!",shape=box,color=blue];
		j1967425915 -> j183219028;
		j1967425915 -> j4122121399;
	j183219028 [label="Immagino che non ti dispiaccia, allora?",shape=box,color=red];
		j183219028 -> j4142339126;
	j4122121399 [label="Tu... lo so già?",shape=box,color=red];
		j4122121399 -> j740745746;
	j4142339126 [label="Se solo potessi sentirmi ridere nel Santuario in questo momento, Drifter, tesoro. Caro dolce Drifter. Sono Orokin. Certo che non mi dispiace.",shape=box,color=blue];
		j4142339126 -> j2699985847;
	j740745746 [label="Se solo potessi sentirmi ridere nel Santuario in questo momento, Drifter, tesoro. Caro dolce Drifter.",shape=box,color=blue];
		j740745746 -> j1872560758;
	j2699985847 [label="Pensa quello che vuoi della mia società e della nostra inclinazione a godere della compagnia degli altri in un modo che potresti considerare sprezzante e sminuitivo, ma sapevamo anche cosa significasse amare.",shape=box,color=blue];
		j2699985847 -> j3380589779;
	j1872560758 [label="L'ho capito nel momento stesso in cui è successo. Ho i miei metodi. E non, non mi dispiace affatto. Sono Orokin.",shape=box,color=blue];
		j1872560758 -> j2699985847;
	j3380589779 [label="Nesuno capiva l'amore meglio degli Orokin. E sapevamo che nel cuore di ognuno poteva esserci spazio per più di una persona. ",shape=box,color=blue];
		j3380589779 -> j2443289479;
	j2443289479 [label="Sono semplicemente deluso dal fatto che i fanatici siano probabilmente troppo ottusi per unirsi al divertimento.",shape=box,color=blue];
		j2443289479 -> j4000834160;
	j4000834160 [label="Pah. A pensarci bene, probabilmente è la cosa migliore. Riesci a immaginare le assurdità che ne deriverebbero?",shape=box,color=blue];
		j4000834160 -> j3516856025;
	j3516856025 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j3516856025 -> j537750889;
	j537750889 [label="Beh, in ogni caso. Se ti rendono felice, allora goditeli. Ma lo sai quando sei con me no?",shape=box,color=blue];
		j537750889 -> j1157189802;
	j1157189802 [label="+5 Chemistry",color=orange];
		j1157189802 -> j4196573236;
	j4196573236 [label="Sei mio e solo mio.",shape=box,color=blue];
		j4196573236 -> "Chat ends.";
}