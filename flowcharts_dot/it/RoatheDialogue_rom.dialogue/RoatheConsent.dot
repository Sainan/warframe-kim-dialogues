	5408 [label="Chat ends.",color=orange];
	5407 [label="Ehi Roathe? Hai un secondo? [Chiedi il consenso per avere più partner.]",shape=box,color=red];
		5407 -> 5410;
	5406 [label="[Fine.]",shape=box,color=red];
		5406 -> 5409;
	5405 [label="Chat ends.",color=orange];
	5410 [label="Mh? Dimmi, tesoro.",shape=box,color=blue];
		5410 -> 5412;
	5409 [label="Update boolean RoatheConsentComplete",color=orange];
		5409 -> 5411;
	5412 [label="Vorrei parlarti di una cosa e voglio assicurarmi che tu sia d'accordo.",shape=box,color=red];
		5412 -> 5413;
	5411 [label="Chat ends.",color=orange];
	5413 [label="Per me è importante che tu non abbia la sensazione che ti stia mentendo o che sia disonesto nei tuoi confronti.",shape=box,color=red];
		5413 -> 5414;
	5414 [label="Continua. Sembra che sarà qualcosa di bello.",shape=box,color=blue];
		5414 -> 5415;
	5415 [label="Non voglio metterti in una situazione che ti crea disagio. Quindi se non sarai d'accordo, va bene. Voglio che tu lo sappia.",shape=box,color=red];
		5415 -> 5416;
	5416 [label="Ciò che abbiamo è importante per me - molto importante - ed è reale. Non voglio che ne dubiti.",shape=box,color=red];
		5416 -> 5417;
	5417 [label="Aspetta. Per il Void, stai cercando di evitare di dirmi che hai un altro partner?",shape=box,color=blue];
		5417 -> 5418;
	5418 [label="Quanto stupido pensi che io sia? Lo so già, caro Drifter!",shape=box,color=blue];
		5418 -> 5419;
		5418 -> 5420;
	5419 [label="Immagino che non ti dispiaccia, allora?",shape=box,color=red];
		5419 -> 5421;
	5420 [label="Tu... lo so già?",shape=box,color=red];
		5420 -> 5422;
	5421 [label="Se solo potessi sentirmi ridere nel Santuario in questo momento, Drifter, tesoro. Caro dolce Drifter. Sono Orokin. Certo che non mi dispiace.",shape=box,color=blue];
		5421 -> 5423;
	5422 [label="Se solo potessi sentirmi ridere nel Santuario in questo momento, Drifter, tesoro. Caro dolce Drifter.",shape=box,color=blue];
		5422 -> 5424;
	5423 [label="Pensa quello che vuoi della mia società e della nostra inclinazione a godere della compagnia degli altri in un modo che potresti considerare sprezzante e sminuitivo, ma sapevamo anche cosa significasse amare.",shape=box,color=blue];
		5423 -> 5425;
	5424 [label="L'ho capito nel momento stesso in cui è successo. Ho i miei metodi. E non, non mi dispiace affatto. Sono Orokin.",shape=box,color=blue];
		5424 -> 5423;
	5425 [label="Nesuno capiva l'amore meglio degli Orokin. E sapevamo che nel cuore di ognuno poteva esserci spazio per più di una persona. ",shape=box,color=blue];
		5425 -> 5426;
	5426 [label="Sono semplicemente deluso dal fatto che i fanatici siano probabilmente troppo ottusi per unirsi al divertimento.",shape=box,color=blue];
		5426 -> 5427;
	5427 [label="Pah. A pensarci bene, probabilmente è la cosa migliore. Riesci a immaginare le assurdità che ne deriverebbero?",shape=box,color=blue];
		5427 -> 5428;
	5428 [label="Update boolean RoatheConsentComplete",color=orange];
		5428 -> 5429;
	5429 [label="Beh, in ogni caso. Se ti rendono felice, allora goditeli. Ma lo sai quando sei con me no?",shape=box,color=blue];
		5429 -> 5430;
	5430 [label="+5 Chemistry",color=orange];
		5430 -> 5431;
	5431 [label="Sei mio e solo mio.",shape=box,color=blue];
		5431 -> 5432;
	5432 [label="Chat ends.",color=orange];
}