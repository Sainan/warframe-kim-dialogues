digraph {
	135 [label="RoatheRank1Convo2 begins.",color=orange];
		135 -> 136;
	136 [label="Ti rendi conto che la tua cosiddetta 'Indifferenza' non è una vera 'divinità', vero?",shape=box,color=blue];
		136 -> 139;
		136 -> 138;
		136 -> 137;
	139 [label="Si avvicina abbastanza ad esserlo.",shape=box,color=red];
		139 -> 142;
	138 [label="E cosa ti rende così sicuro?",shape=box,color=red];
		138 -> 141;
	137 [label="[Fine.]",shape=box,color=red];
		137 -> 140;
	142 [label="Tutti quelli con cui parlo in questo manicomio sono fermamente convinti che questo 'Uomo nel Muro' sia una specie di dio letterale e ridicolo. Un dio vero e proprio. Persino quei due fanatici sembrano apprezzare l'idea!",shape=box,color=blue];
		142 -> 144;
		142 -> 145;
		142 -> 146;
	141 [label="Beh, tralasciando la dura realtà che ogni credenza in un dio o in degli dei proviene da idioti che si aggrappano a: Uno, un bisogno schiacciante di stringere un animale di peluche quando ci si trova di fronte al brutale orrore della definitività della propria anima quando raggiunge la morte.",shape=box,color=blue];
		141 -> 143;
	140 [label="Chat ends.",color=orange];
	144 [label="Non pensi che sia reale?",shape=box,color=red];
		144 -> 148;
	145 [label="E se non pensi che sia una divinità, cosa pensi che sia?",shape=box,color=red];
		145 -> 149;
	146 [label="E tu no?",shape=box,color=red];
		146 -> 150;
	143 [label="Due, l'ansia che si prova quando ci si rende conto che non esiste un 'Potere Superiore' là fuori che ci presenta le nostre vite e quindi siamo semplicemente responsabili delle nostre azioni per estensione.",shape=box,color=blue];
		143 -> 147;
	148 [label="Ora, ho forse detto queste parole? Non essere così veloce a mettermi le parole in bocca, Oh Usurpatore Transitorio. Non ho negato che l'Indifferenza fosse 'reale'. Ho negato che fosse una divinità.",shape=box,color=blue];
		148 -> 152;
		148 -> 153;
	149 [label="Posso smascherare questa falsa divinità in due semplici parole che dovresti conoscere e comprendere molto bene:",shape=box,color=blue];
		149 -> 154;
	150 [label="Assolutamente no! Primo, non esiste alcun dio o dei, l'idea è assurda. Secondo, pensare che Albrecht abbia liberato un dio del Void? Ancora più ridicolo!",shape=box,color=blue];
		150 -> 155;
	147 [label="Terzo, la giusta rabbia che accompagna l'ansia e l'orrore, quando tutto ciò porta all'epifania che non c'è nessun 'Inferno' in attesa dei diavoli, né alcun 'Paradiso' in attesa degli angeli.",shape=box,color=blue];
		147 -> 151;
	152 [label="Quella è più potente di qualsiasi cosa abbia mai affrontato.",shape=box,color=red];
		152 -> 156;
	153 [label="Cosa pensi che sia allora?",shape=box,color=red];
		153 -> 149;
	154 [label="Incarnazione Concettuale.",shape=box,color=blue];
		154 -> 157;
		154 -> 158;
		154 -> 159;
	155 [label="Non c'è nulla nel Void. Ecco perché si chiama Void! ",shape=box,color=blue];
		155 -> 160;
		155 -> 161;
	151 [label="Presumo che tu non sia un fanatico sbavante che si aggrappa alla rabbia, all'orrore, all'ansia. Partendo da questo presupposto, passerò alla seconda argomentazione che desidero presentarti a favore la rivelazione della Divinità dell''Indifferenza':",shape=box,color=blue];
		151 -> 154;
	156 [label="E quando mai l'ho negato? In effetti, sembra che siate tutti riusciti a trascinarvi in una situazione di tribolazione piuttosto isterica e inutilmente esagerata.",shape=box,color=blue];
		156 -> 162;
		156 -> 163;
	157 [label="Il Void e ciò che possiamo ricavarne sono pericolosi e potenti - credetemi, lo so. Ma ha dei limiti. Pensi davvero che sia capace di manifestare qualcosa del genere? Che possa creare interi linguaggi, dita capaci di alimentare navi che saltano attraverso il Void?",shape=box,color=red];
		157 -> 164;
	158 [label="È... molto allettante credere che sia solo un mostro sotto il nostro letto, Roathe. Ma ho visto questa cosa, faccia a faccia, e non so come una cosa del genere possa uscire dalla nostra mente.",shape=box,color=red];
		158 -> 165;
	159 [label="L'Incarnazione Concettuale non può fare ciò di cui è capace l'Uomo nel Muro. Sebbene Entrati possa aver manifestato quella cosa – ed essere responsabile di averla portata qui – non credo che ne sia la fonte originale.",shape=box,color=red];
		159 -> 166;
	160 [label="No. Ho visto le cose che provengono dal Void. Angeli. Canti. Fantasmi.",shape=box,color=red];
		160 -> 167;
	161 [label="Io... ",shape=box,color=red];
		161 -> 167;
	162 [label="Cosa stai dicendo?",shape=box,color=red];
		162 -> 168;
	163 [label="Aspetta. Come possiamo essere incolpati di tutto questo? Il colpevole è Albrecht, è lui che ha scatenato tutto.",shape=box,color=red];
		163 -> 169;
	164 [label="L'umanità non è certamente nulla se non creativa nell'ampiezza e nella portata delle nuove forme di sofferenza che può inventare per sé stessa, no? Tu stesso sei stato testimone di molte forme di crudeltà che sono sicuro nessuno avrebbe potuto immaginare possibili al tempo dei nostri cari fanatici.",shape=box,color=blue];
		164 -> 170;
	165 [label="Ah, sei così vicino alla verità eppure così veloce a respingerla. Pensi che sia \"allettante\" credere che sia una creazione della tua mente, dato che sarebbe più facile respingerla se lo fosse? No, penso che sia molto più pericoloso affrontare una creazione di nostra fattura che una divinità.",shape=box,color=blue];
		165 -> 171;
	166 [label="Pur apprezzando la tua umiltà, metto in discussione la tua limitata comprensione delle potenzialità della creatività umana, soprattutto per quanto riguarda il modo in cui può concepire nuove forme di sofferenza. Non sei forse tu, in realtà, l'unico responsabile della creazione del tuo universo?",shape=box,color=blue];
		166 -> 172;
	167 [label="L'unica cosa che proviene dal Void è ciò che vi poniamo dentro - e ciò che ne ritorna. Trasforma la materia e l'energia - ma non può crearle.",shape=box,color=blue];
		167 -> 173;
	168 [label="Quello che voglio dire è questo: forse Albrecht è stato colui che in origine ha visto la propria arroganza come il volto di un dio sorridente della distruzione, sì.",shape=box,color=blue];
		168 -> 174;
	169 [label="Forse Albrecht è stato colui che in origine ha visto la propria arroganza come il volto di un dio sorridente della distruzione, sì.",shape=box,color=blue];
		169 -> 174;
	170 [label="+15 Chemistry",color=orange];
		170 -> 175;
	171 [label="Un nemico esterno può essere compreso. Manipolato. Sconfitto. E forse ci si potrebbe persino negoziare, se necessario. Ha debolezze che possono essere sfruttate. Ma un nemico interno? Uno creato da noi stessi? Quello è davvero molto più insidioso.",shape=box,color=blue];
		171 -> 176;
	172 [label="Tu stesso sei stato testimone di molte forme di crudeltà che sono sicuro nessuno avrebbe potuto immaginare possibili al tempo dei nostri cari fanatici. ",shape=box,color=blue];
		172 -> 177;
	173 [label="Pensa, Drifter. Questi 'Angeli del Void' di cui parli. Questi fantasmi. Erano forse fatti di coloro che erano già perduti nel Void?",shape=box,color=blue];
		173 -> 178;
	174 [label="Ma siete tutti ugualmente colpevoli per aver continuato a far rotolare questo escremento di insetto juba in discesa per tutto questo tempo, diventando più grande con ogni frammento di feci che raccoglie lungo il cammino!",shape=box,color=blue];
		174 -> 179;
	175 [label="Come specie, siamo davvero straordinari nella nostra capacità di alimentare le nostre paure e trovare nuovi modi per distruggerci.",shape=box,color=blue];
		175 -> 180;
	176 [label="+20 Chemistry",color=orange];
		176 -> 181;
	177 [label="+10 Chemistry",color=orange];
		177 -> 175;
	178 [label="Erano semplicemente echi di energia rigurgitati come un kutak colorato per nutrire le sue creature.",shape=box,color=blue];
		178 -> 179;
	179 [label="Permettimi di semplificarti la discussione. Posso smascherare questa falsa divinità in due semplici parole che dovresti conoscere e comprendere molto bene:",shape=box,color=blue];
		179 -> 154;
	180 [label="Mm. Temo di dover andare. Ti lascerò riflettere per un po' sulle mie parole.",shape=box,color=blue];
		180 -> 182;
		180 -> 183;
	181 [label="Perché allora dobbiamo combattere i nostri demoni. E l'umanità... non vince mai queste guerre, no?",shape=box,color=blue];
		181 -> 180;
	182 [label="Lo farò. Grazie.",shape=box,color=red];
		182 -> 184;
	183 [label="Rifletti sulle mie, potresti finire per voler credere a loro quando ti troverai di fronte a un anti-dio.",shape=box,color=red];
		183 -> 184;
	184 [label="Update boolean RoatheMITW1",color=orange];
		184 -> 185;
	185 [label="Chat ends.",color=orange];
}