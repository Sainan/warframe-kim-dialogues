	j76084064 [label="MV: CONNESSIONE",shape=box,color=blue];
		j76084064 -> j3109253458;
	j3109253458 [label="Trascrizione: Quando i Sentient completarono la Rotaia Solare verso Tau, non ci fu nessuna grande cerimonia. Semplicemente, iniziò a funzionare.",shape=box,color=blue];
		j3109253458 -> j3022893289;
	j3022893289 [label="La cerimonia fu organizzata in fretta, ovviamente, perché nessun vero Orokin può soffiarsi il naso senza osservare un minimo di solennità.",shape=box,color=blue];
		j3022893289 -> j4256050100;
	j4256050100 [label="Fu fatto un gran trambusto per il Primo Trasporto che avrebbe compiuto la Traversata.",shape=box,color=blue];
		j4256050100 -> j3018507628;
	j3018507628 [label="Era l'imponente incrociatore dell'Esecutore Tormis, e nella scelta di Tormis come spedizione si poteva leggere un rimprovero collettivo all'Esecutore Tuvul per il grottesco incidente della Zariman Ten Zero. ",shape=box,color=blue];
		j3018507628 -> j950948609;
	j950948609 [label="Tormis partì e Tormis tornò, portando con sé meravigliosi ricordi ingioiellati di un nuovo Sistema e di nuovi mondi da colonizzare. ",shape=box,color=blue];
		j950948609 -> j1732859818;
	j1732859818 [label="Nel giro di pochi giorni una flottiglia di navi coloniali partì, ansiosa di mettere piede sulla costa vergine.",shape=box,color=blue];
		j1732859818 -> j1499323639;
	j1499323639 [label="L'attacco dei Sentient che seguì rovinò l'atmosfera.",shape=box,color=blue];
		j1499323639 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}