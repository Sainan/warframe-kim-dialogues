	2147 [label="Era l'imponente incrociatore dell'Esecutore Tormis, e nella scelta di Tormis come spedizione si poteva leggere un rimprovero collettivo all'Esecutore Tuvul per il grottesco incidente della Zariman Ten Zero. ",shape=box,color=blue];
		2147 -> 2137;
	2137 [label="Tormis partì e Tormis tornò, portando con sé meravigliosi ricordi ingioiellati di un nuovo Sistema e di nuovi mondi da colonizzare. ",shape=box,color=blue];
