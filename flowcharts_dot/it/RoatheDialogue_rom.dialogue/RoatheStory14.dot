		2257 -> 2259;
	2260 [label="Chat ends.",color=orange];
	2259 [label="Trascrizione: Molti dei Sentient si evolvevano tra un incontro e l'altro, quindi non potevamo mai essere certi di affrontare lo stesso nemico due volte. Ma altri rimanevano in una forma costante, come se avessero raggiunto un punto di svolta molto tempo prima.",shape=box,color=blue];
		2259 -> 5709;
	5709 [label="Assassini perfetti, portavano con sé lo stesso gelido orrore di uno squalo.",shape=box,color=blue];
		5709 -> 2256;
	2256 [label="Era follia. Come potevo elaborare strategie per aggirare il comportamento delle navi-granchio dei Sentient, quando non appena le mie tattiche erano state perfezionate, le navi-granchio erano state sostituite dalle navi-verme?",shape=box,color=blue];
		2256 -> 2253;
	2253 [label="E quanto tempo ci sarebbe voluto prima che quelle navi-verme fossero a loro volta sostituite da qualche nuova mostruosità?",shape=box,color=blue];
		2253 -> 5710;
	5710 [label="Non potevamo fare altro che tornare indietro, il progresso era stato fatale. Le vecchie tradizioni, i sentieri consacrati dal tempo dell'onore e della disciplina, avevano il loro giusto valore.",shape=box,color=blue];
		5710 -> 2255;
