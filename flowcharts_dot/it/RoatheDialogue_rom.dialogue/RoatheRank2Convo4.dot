digraph {
	"RoatheRank2Convo4 begins." [color=orange];
		"RoatheRank2Convo4 begins." -> j1115193858;
	j1115193858 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		j1115193858 -> j1437250236 [label=true,color=green];
		j1115193858 -> "Chat ends." [label=false,color=brown];
	j1437250236 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1437250236 -> j154792100 [label=true,color=green];
		j1437250236 -> j1692949551 [label=false,color=brown];
	"Chat ends." [color=orange];
	j154792100 [label="Hm. Dimmi. Sono riuscito a convincerti, l'ultima volta che abbiamo fatto questo, che la tua \"Indifferenza\" sia solo una collezione di giocattoli per bambini messi insieme alla bell'e meglio, o hai finito continuando a credere che sia una sorta di \"grande entità inconoscibile proveniente dal Void\".",shape=box,color=blue];
		j154792100 -> j2256051099;
	j1692949551 [label="Check boolean RoatheMITW1",color=orange];
		j1692949551 -> j7419360 [label=true,color=green];
		j1692949551 -> j3983677411 [label=false,color=brown];
	j2256051099 [label="Se c'è una cosa al mondo che detesto, è rincorrere la mia coda. E mi sono appena reso conto che questa metafora era molto più proverbiale di quanto non lo sia ora.",shape=box,color=blue];
		j2256051099 -> j2148161112;
		j2256051099 -> j887823015;
		j2256051099 -> j723426506;
	j7419360 [label="Quindi, prima di continuare, vorrei solo assicurarmi di aver capito bene. Tu credi che l'Indifferenza sia una sorta di Orribile Entità Inconoscibile proveniente dal Void, che si è infiltrata nella nostra realtà a causa degli errori di Albrecht?",shape=box,color=blue];
		j7419360 -> j319433228;
	j3983677411 [label="Tutti quelli con cui parlo in questo manicomio sono fermamente convinti che questo 'Uomo nel Muro' sia una specie di dio letterale e ridicolo. Un dio vero e proprio. Persino quei due fanatici sembrano apprezzare l'idea!",shape=box,color=blue];
		j3983677411 -> j1386750509;
		j3983677411 -> j3987484219;
		j3983677411 -> j1354827137;
	j2148161112 [label="No, non ci sei riuscito, no. Mi dispiace. ",shape=box,color=red];
		j2148161112 -> j1727544454;
	j887823015 [label="Sì, in effetti.",shape=box,color=red];
		j887823015 -> j1935235103;
	j723426506 [label="Non abbiamo mai trovato un accordo.",shape=box,color=red];
		j723426506 -> j69187154;
	j319433228 [label="Consentimi di formulare la mia domanda in questo modo, prima che ci ritroviamo a girare a vuoto e finiamo ancora una volta per rincorrere la nostra coda. Il che... è una metafora che mi sono appena reso conto essere stata molto più proverbiale di quanto non lo sia ora, ma sto divagando.",shape=box,color=blue];
		j319433228 -> j1675443379;
	j1386750509 [label="Non pensi che sia reale?",shape=box,color=red];
		j1386750509 -> j1049571440;
	j3987484219 [label="E se non pensi che sia una divinità, cosa pensi che sia?",shape=box,color=red];
		j3987484219 -> j2969461838;
	j1354827137 [label="E tu no?",shape=box,color=red];
		j1354827137 -> j3736097296;
	j1727544454 [label="Boolean RoatheMITWSkip is now true.",color=orange];
		j1727544454 -> j2683318415;
	j1935235103 [label="Boolean RoatheMITWSkip is now true.",color=orange];
		j1935235103 -> j63284006;
	j69187154 [label="Ah! Beh, allora sembra che abbia ancora del lavoro da fare.",shape=box,color=blue];
		j69187154 -> j3534003857;
	j1675443379 [label="Credi che l'entità che ora chiami Indifferenza esistesse prima che Albrecht entrasse in contatto con essa? O credi che lui l'abbia creata quando ha interagito per la prima volta con il Void?",shape=box,color=blue];
		j1675443379 -> j1739825271;
		j1675443379 -> j2194400542;
		j1675443379 -> j4110266711;
		j1675443379 -> j1992193108;
	j1049571440 [label="Ora, ho forse detto queste parole? Non essere così veloce a mettermi le parole in bocca, Oh Usurpatore Transitorio. Non ho negato che l'Indifferenza fosse 'reale'. Ho negato che fosse una divinità.",shape=box,color=blue];
		j1049571440 -> j2477228542;
		j1049571440 -> j159642636;
	j2969461838 [label="Posso smascherarti questa falsa divinità in due semplici parole che dovresti conoscere e comprendere molto bene:",shape=box,color=blue];
		j2969461838 -> j4226212698;
	j3736097296 [label="Assolutamente no! Primo, non esiste alcun dio o dei, l'idea è assurda. Secondo, pensare che Albrecht abbia liberato un dio del Void? Ancora più ridicolo!",shape=box,color=blue];
		j3736097296 -> j1071535080;
	j2683318415 [label="Boolean RoatheMITW5Real is now true.",color=orange];
		j2683318415 -> j1164102255;
	j63284006 [label="Boolean RoatheMITW5Fake is now true.",color=orange];
		j63284006 -> j1623073252;
	j3534003857 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j3534003857 -> j114553150;
	j1739825271 [label="Non saprei. E credo che neanche tu possa saperlo.",shape=box,color=red];
		j1739825271 -> j834440343;
	j2194400542 [label="Penso che fosse un'entità che esisteva ancora prima che Entrati interagisse con essa. Lui le ha semplicemente dato forma e struttura tramite l'Incarnazione Concettuale.",shape=box,color=red];
		j2194400542 -> j4202997483;
	j4110266711 [label="Onestamente... non lo so.",shape=box,color=red];
		j4110266711 -> j1906190678;
	j1992193108 [label="Pensi davvero che Entrati abbia creato dal nulla una divinità maligna del Void?",shape=box,color=red];
		j1992193108 -> j1542258427;
	j2477228542 [label="Quella cosa è più potente di qualsiasi cosa abbia mai affrontato.",shape=box,color=red];
		j2477228542 -> j3931856084;
	j159642636 [label="Cosa pensi che sia allora?",shape=box,color=red];
		j159642636 -> j2969461838;
	j4226212698 [label="Incarnazione Concettuale.",shape=box,color=blue];
		j4226212698 -> j945113977;
		j4226212698 -> j3498431496;
		j4226212698 -> j1481809510;
	j1071535080 [label="Non c'è nulla nel Void. Ecco perché si chiama Void! ",shape=box,color=blue];
		j1071535080 -> j3049769739;
		j1071535080 -> j2944198714;
	j1164102255 [label="+10 Chemistry",color=orange];
		j1164102255 -> j3399909052;
	j1623073252 [label="+20 Chemistry",color=orange];
		j1623073252 -> j3490851965;
	j114553150 [label="Ma prima di continuare, vorrei solo assicurarmi di aver capito bene. Tu credi che l'Indifferenza sia una sorta di Orribile Entità Inconoscibile proveniente dal Void, che si è infiltrata nella nostra realtà a causa degli errori di Albrecht?",shape=box,color=blue];
		j114553150 -> j319433228;
	j834440343 [label="Sì! Io posso! È così dolorosamente ovvio ciò che sta accadendo, e così assolutamente ridicolo che vi siate tutti convinti che ci sia una grande bestia che graffia alla finestra, quando invece è solo un ramo di un albero mosso dal vento.",shape=box,color=blue];
		j834440343 -> j135083522;
	j4202997483 [label="Non anche tu. Avevo così tante speranze. È così dolorosamente ovvio ciò che sta accadendo, e così assolutamente ridicolo che vi siate tutti convinti che ci sia una grande bestia che graffia alla finestra, quando invece è solo un ramo di un albero mosso dal vento.",shape=box,color=blue];
		j4202997483 -> j135083522;
	j1906190678 [label="È così dolorosamente ovvio ciò che sta accadendo, e così assolutamente ridicolo che vi siate tutti convinti che ci sia una grande bestia che graffia alla finestra, quando invece è solo un ramo di un albero mosso dal vento.",shape=box,color=blue];
		j1906190678 -> j135083522;
	j1542258427 [label="Sì, lo penso! È così dolorosamente ovvio che è proprio quello che sta accadendo, e così assolutamente ridicolo che vi siate tutti convinti che ci sia una grande bestia che graffia alla finestra, quando invece è solo un ramo di un albero mosso dal vento.",shape=box,color=blue];
		j1542258427 -> j135083522;
	j3931856084 [label="E quando mai l'ho negato? In effetti, sembra che siate tutti riusciti a trascinarvi in una situazione di tribolazione piuttosto isterica e inutilmente esagerata.",shape=box,color=blue];
		j3931856084 -> j2629642953;
		j3931856084 -> j3987069987;
	j945113977 [label="Il Void ciò che possiamo ricavarne sono pericolosi e potenti - credetemi, lo so. Ma ha dei limiti. Pensi davvero che sia capace di manifestare qualcosa del genere? Che possa creare interi linguaggi, dita capaci di alimentare navi che saltano attraverso il Void?",shape=box,color=red];
		j945113977 -> j2069106779;
	j3498431496 [label="È... molto allettante credere che sia solo un mostro sotto il nostro letto, Roathe. Ma ho visto questa cosa, faccia a faccia, e non so come una cosa del genere possa uscire dalla nostra mente.",shape=box,color=red];
		j3498431496 -> j3205316089;
	j1481809510 [label="L'Incarnazione Concettuale non può fare ciò di cui è capace l'Uomo nel Muro. Sebbene Entrati possa aver manifestato quella cosa – ed essere responsabile di averla portata qui – non credo che ne sia la fonte originale.",shape=box,color=red];
		j1481809510 -> j78481362;
	j3049769739 [label="Io... ",shape=box,color=red];
		j3049769739 -> j860542792;
	j2944198714 [label="No. Ho visto cose che provengono dal Void. Angeli. Canti. Fantasmi.",shape=box,color=red];
		j2944198714 -> j860542792;
	j3399909052 [label="Sebbene sia deluso dal fatto che tu abbia mantenuto la tua posizione, trovo la tua onestà estremamente gratificante. E sono lieto di non sprecare il mio tempo mentre andiamo avanti. Sono certo che troveremo altri modi per divertirci.",shape=box,color=blue];
		j3399909052 -> j638591056;
	j3490851965 [label="Fantastico. Sono felice che il mio io del passato fosse così incredibilmente convincente. E spero che tu sia sincero e non mi stia mentendo nel tentativo di \"zittirmi\". Ma non ho altra scelta che crederti.",shape=box,color=blue];
		j3490851965 -> j4034467760;
	j135083522 [label="Solo che ora, a causa dell'influenza del Void, gli avete tutti alimentato così tanta paura e potere che esso, come in un circolo vizioso, si è trasformato in questa... Cosa. Quest'Uomo nel Muro.",shape=box,color=blue];
		j135083522 -> j3079704174;
	j2629642953 [label="Cosa stai dicendo?",shape=box,color=red];
		j2629642953 -> j2326932326;
	j3987069987 [label="Aspetta. Come possiamo essere incolpati di tutto questo? Il colpevole è Albrecht, è lui che ha scatenato tutto.",shape=box,color=red];
		j3987069987 -> j11055093;
	j2069106779 [label="L'umanità non è certamente nulla se non creativa nell'ampiezza e nella portata delle nuove forme di sofferenza che può inventare per sé stessa, no? Tu stesso sei stato testimone di molte forme di crudeltà che sono sicuro nessuno avrebbe potuto immaginare possibili al tempo dei nostri cari fanatici.",shape=box,color=blue];
		j2069106779 -> j660909855;
	j3205316089 [label="Ah, sei così vicino alla verità eppure così veloce a respingerla. Pensi che sia \"allettante\" credere che sia una creazione della tua mente, dato che sarebbe più facile respingerla se lo fosse? No, penso che sia molto più pericoloso affrontare una creazione di nostra fattura che una divinità.",shape=box,color=blue];
		j3205316089 -> j1864772099;
	j78481362 [label="Pur apprezzando la tua umiltà, metto in discussione la tua limitata comprensione delle potenzialità della creatività umana, soprattutto per quanto riguarda il modo in cui può concepire nuove forme di sofferenza. Non sei forse tu, in realtà, l'unico responsabile della creazione del tuo universo?",shape=box,color=blue];
		j78481362 -> j2433452789;
	j860542792 [label="L'unica cosa che proviene dal Void è ciò che vi poniamo dentro - e ciò che ne ritorna. Trasforma la materia e l'energia - ma non può crearle.",shape=box,color=blue];
		j860542792 -> j966776351;
	j638591056 [label="Da parte mia, sono grato di essere stato risparmiato da un secondo round di discussioni vaghe e circolari sui dettagli dell'Incarnazione Concettuale.",shape=box,color=blue];
		j638591056 -> j2906853279;
	j4034467760 [label="In ogni caso, sono certo che troveremo altri modi per divertirci piuttosto che perderci in discussioni vaghe e circolari sui dettagli dell'Incarnazione Concettuale.",shape=box,color=blue];
		j4034467760 -> j3396199564;
	j3079704174 [label="Albrecht avrà anche dato inizio a questa assurdità, ma siete tutti responsabili di aver alimentato il fuoco fino a trasformarlo in un inferno. L'indifferenza non è mai esistita. Finché, all'improvviso, è apparsa. ",shape=box,color=blue];
		j3079704174 -> j39429372;
	j2326932326 [label="Quello che voglio dire è questo: forse Albrecht è stato colui che in origine ha visto la propria arroganza come il volto di un dio sorridente della distruzione, sì.",shape=box,color=blue];
		j2326932326 -> j4115776763;
	j11055093 [label="Forse Albrecht è stato colui che in origine ha visto la propria arroganza come il volto di un dio sorridente della distruzione, sì.",shape=box,color=blue];
		j11055093 -> j4115776763;
	j660909855 [label="+5 Chemistry",color=orange];
		j660909855 -> j1238224350;
	j1864772099 [label="Un nemico esterno può essere compreso. Manipolato. Sconfitto. O forse persino ci si può negoziare, se necessario. Ha debolezze che possono essere sfruttate. Ma un nemico interno? Uno creato da noi stessi? Quello è davvero molto più insidioso.",shape=box,color=blue];
		j1864772099 -> j2649433948;
	j2433452789 [label="Tu stesso sei stato testimone di molte forme di crudeltà che sono sicuro nessuno avrebbe potuto immaginare possibili al tempo dei nostri cari fanatici. ",shape=box,color=blue];
		j2433452789 -> j660909855;
	j966776351 [label="Pensa, Drifter. Questi 'Angeli del Void' di cui parli. Questi fantasmi. Erano forse fatti di coloro che erano già perduti nel Void?",shape=box,color=blue];
		j966776351 -> j3246354102;
	j2906853279 [label="Anche se questo significa avere più tempo per ascoltare le prediche dei fanatici... bah. Scelte, scelte, scelte...",shape=box,color=blue];
		j2906853279 -> "Chat ends.";
	j3396199564 [label="Da parte mia, sono grato di essere stato risparmiato da un secondo round.",shape=box,color=blue];
		j3396199564 -> j2906853279;
	j39429372 [label="E la colpa è di tutti voi.",shape=box,color=blue];
		j39429372 -> j2775700210;
		j39429372 -> j2504265513;
		j39429372 -> j1842710557;
	j4115776763 [label="Ma siete tutti ugualmente colpevoli per aver continuato a far rotolare questa cacca di insetto juba in discesa per tutto questo tempo, diventando più grande con ogni frammento di feci che raccoglie lungo il cammino!",shape=box,color=blue];
		j4115776763 -> j4228520646;
	j1238224350 [label="Come specie, siamo davvero straordinari nella nostra capacità di alimentare le nostre paure e trovare nuovi modi per distruggerci.",shape=box,color=blue];
		j1238224350 -> j1401309824;
	j2649433948 [label="+5 Chemistry",color=orange];
		j2649433948 -> j2126542890;
	j3246354102 [label="Erano semplicemente echi di energia rigurgitati come un kutak colorato per nutrire le sue creature.",shape=box,color=blue];
		j3246354102 -> j4228520646;
	j2775700210 [label="Non possiamo creare cose del genere, Roathe - te l'ho detto. L'Incarnazione Concettuale ha i suoi limiti.",shape=box,color=red];
		j2775700210 -> j1256041391;
	j2504265513 [label="Non incolparci. Non siamo responsabili del danno che quella cosa ha causato.",shape=box,color=red];
		j2504265513 -> j2813092843;
	j1842710557 [label="Spiegami come pensi che potrebbe funzionare. La maggior parte delle cose create dal Void tramite l'Incarnazione Concettuale non possono lasciarlo, almeno non per molto tempo.",shape=box,color=red];
		j1842710557 -> j2030805781;
	j4228520646 [label="Permettimi di semplificarti la discussione. Posso smascherare questa falsa divinità in due semplici parole che dovresti conoscere e comprendere molto bene:",shape=box,color=blue];
		j4228520646 -> j4226212698;
	j1401309824 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j1401309824 -> j319433228;
	j2126542890 [label="Perché allora dobbiamo combattere i nostri demoni. E l'umanità... non vince mai queste guerre, no?",shape=box,color=blue];
		j2126542890 -> j1401309824;
	j1256041391 [label="Lo dice proprio colui che ha creato un'intera dimensione alternativa da solo? Per favore, Drifter... usa la tua immaginazione come facevi tanto tempo fa.",shape=box,color=blue];
		j1256041391 -> j2030805781;
	j2813092843 [label="Non ti sto rimproverando! Questa cosa era già in atto da tempo prima che tu entrassi in scena. Ci ha pensato Albrecht.",shape=box,color=blue];
		j2813092843 -> j3973537407;
	j2030805781 [label="L'Incarnazione Concettuale funziona così: quando si interagisce con il Void, o in prossimità del Void, emozioni e pensieri potenti possono manifestarsi fisicamente. Lo sappiamo entrambi.",shape=box,color=blue];
		j2030805781 -> j448698285;
		j2030805781 -> j1147340229;
		j2030805781 -> j3481527780;
	j3973537407 [label="Lui ha visto il proprio riflesso e ha conosciuto la vera paura. E così è scoccata la prima scintilla che ha acceso il fuoco che minaccia di bruciare tutto. Voi continuate semplicemente ad alimentare il fuoco.",shape=box,color=blue];
		j3973537407 -> j2030805781;
	j448698285 [label="Esatto. Come Duviri, condivide una connessione con questo mondo tramite la Zariman. ",shape=box,color=red];
		j448698285 -> j2523975267;
	j1147340229 [label="Come gli Zariman, gli Holdfast e gli Angeli del Void. Il Void è ovunque su quella nave.",shape=box,color=red];
		j1147340229 -> j2523975267;
	j3481527780 [label="Sì. E?",shape=box,color=red];
		j3481527780 -> j2800365236;
	j2523975267 [label="Esattamente. Dove va il Void, l'Incarnazione Concettuale può seguirlo. E solo lì.",shape=box,color=blue];
		j2523975267 -> j3861373497;
		j2523975267 -> j1839685700;
	j2800365236 [label="Dove va il Void, l'Incarnazione Concettuale può seguirlo. E solo lì.",shape=box,color=blue];
		j2800365236 -> j3861373497;
		j2800365236 -> j1839685700;
	j3861373497 [label="Ma è arrivato fino al 1999. Ha seguito Albrecht ovunque. E anche me.",shape=box,color=red];
		j3861373497 -> j1486149881;
	j1839685700 [label="Aspetta...",shape=box,color=red];
		j1839685700 -> j3740983391;
	j1486149881 [label="Quelle dannate dita. Abbiamo preso quelle maledette dita, in un disperato e folle tentativo di raggiungere Tau, e noi Orokin abbiamo trovato un modo per replicarle, non è vero?",shape=box,color=blue];
		j1486149881 -> j1737749896;
	j3740983391 [label="Sì. Ora lo vedi. Quelle dannate dita. Abbiamo preso quelle maledette dita, in un disperato e folle tentativo di raggiungere Tau, e noi Orokin abbiamo trovato un modo per replicarle, non è vero?",shape=box,color=blue];
		j3740983391 -> j1737749896;
	j1737749896 [label="Piccoli frammenti del Void, ovunque tu vada... Una rete di trincee e tunnel che permettono a quella cosa di spuntare fuori dove vuole. E peggio ancora?",shape=box,color=blue];
		j1737749896 -> j4269115318;
	j4269115318 [label="I Tenno. E voi. Tutti voi, toccati dal Void. E tutti voi, perseguitati da quella cosa, perché ovunque andiate, essa può seguirvi.",shape=box,color=blue];
		j4269115318 -> j998269196;
	j998269196 [label="E probabilmente chiunque abbia interagito con esso per un certo periodo di tempo. Lo stesso Entrati. Il suo maggiordomo. I Cavia. Io stesso, i fanatici, per la nostra vicinanza a questo Santuario. L'elenco potrebbe continuare.",shape=box,color=blue];
		j998269196 -> j2810478990;
		j998269196 -> j1922137179;
	j2810478990 [label="Quindi stai postulando che chiunque sia stato esposto abbastanza al Void, o chiunque sia una \"batteria\", diventi un'altra finestra attraverso cui l'Uomo nel Muro può sbirciare?",shape=box,color=red];
		j2810478990 -> j1119715621;
	j1922137179 [label="Ma mi chiedo, come è arrivato a Rusalka?",shape=box,color=red];
		j1922137179 -> j1436072516;
	j1119715621 [label="Precisamente. ",shape=box,color=blue];
		j1119715621 -> j3100724532;
	j1436072516 [label="Chi?",shape=box,color=blue];
		j1436072516 -> j2183721203;
		j1436072516 -> j3682125689;
	j3100724532 [label="Il che spiegherebbe perché non può mostrare il proprio volto, non è vero? Può apparire solo come coloro che sta tormentando, a coloro che sta tentando di tormentare.",shape=box,color=blue];
		j3100724532 -> j3352117038;
	j2183721203 [label="Maggiore Neci Rusalka. Era a capo della forza militare nota come Scaldra nel 1999, a Höllvania.",shape=box,color=red];
		j2183721203 -> j366485793;
	j3682125689 [label="In poche parole, non dovrei mai e poi mai permettere che vi incontriate.",shape=box,color=red];
		j3682125689 -> j504233056;
	j3352117038 [label="In realtà sembra assumere le sembianze dell'architettura solo quando lotta per mostrarsi come qualcosa di Più Grande e Diverso. Quando cerca disperatamente di suscitare un senso di Grandiosità e Divinità.",shape=box,color=blue];
		j3352117038 -> j2346333462;
		j3352117038 -> j1311107193;
	j366485793 [label="Lei era - o è - posseduta dall'Indifferenza. Sta condividendo la sua mente, usandola come un burattino. Oppure lei l'ha lasciata entrare. Non lo sappiamo. Non sappiamo nemmeno se abbia effettivamente ripreso il controllo.",shape=box,color=red];
		j366485793 -> j2755847134;
	j504233056 [label="Non sei affatto divertente, Usurpatore. Ma in che modo lei coinvolge la nostra... Indifferenza, precisamente?",shape=box,color=blue];
		j504233056 -> j366485793;
	j2346333462 [label="Quindi pensi che assuma tutti i volti delle persone con cui entra in contatto... perché non ne ha uno proprio?",shape=box,color=red];
		j2346333462 -> j717429054;
	j1311107193 [label="Credo che l'Uomo nel Muro abbia scelto di indossare i nostri volti perché non riesce a comprendere cosa significhi essere umani. Sarebbe troppo \"grande\", altrimenti.",shape=box,color=red];
		j1311107193 -> j430156413;
	j2755847134 [label="Sembra davvero una persona deliziosamente formidabile. E assolutamente incantevole. Ma questo per ora non c'entra nulla. Dici che l'indifferenza ha preso il sopravvento sulla sua mente? E che tutto è iniziato durante il tuo breve congedo nel passato?",shape=box,color=blue];
		j2755847134 -> j1762972146;
	j717429054 [label="No, sciocchezze. Perché sta solo imitando ciò che l'ha creato. Non è un'entità completa, è solo un giocattolo fatto di parti disparate di paure e terrore e sofferenza di cui è stato alimentato. ",shape=box,color=blue];
		j717429054 -> j4154939728;
	j430156413 [label="No, sciocchezze. Sta solo imitando ciò che l'ha creato. Non è un'entità completa, è solo un giocattolo fatto di parti disparate di paure e terrore e sofferenza di cui è stato alimentato.",shape=box,color=blue];
		j430156413 -> j4154939728;
	j1762972146 [label="Beh, se quello che sappiamo del Void è vero, allora sono successe due cose: o lei è finita in qualche istanza del Void nel 1999 per sua scelta (cosa che trovo molto improbabile, ma non impossibile), oppure...",shape=box,color=blue];
		j1762972146 -> j1630585705;
	j4154939728 [label="Bah. Vedo che oggi non farò alcun progresso. Va bene così, sei profondamente radicato in questa propaganda che ti è stata inculcata. Albrecht è un leader carismatico molto convincente, temo.",shape=box,color=blue];
