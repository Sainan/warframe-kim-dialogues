digraph {
	1781 [label="RoatheRank3Convo3 begins.",color=orange];
		1781 -> 1782;
	1782 [label="Evaluate expressions on HellStory",color=orange];
		1782 -> 1786 [label="x >= 21",color=purple];
		1782 -> 1785 [label="x >= 13",color=purple];
		1782 -> 1784 [label="x < 13 && x > 1",color=purple];
		1782 -> 1783 [label="x == 0",color=purple];
		1782 -> 1783 [label="false",color=purple];
	1786 [label="Mi tormenta, giorno e notte. Questa consapevolezza costante e fastidiosa che non solo ti ho affidato i miei segreti più intimi, ma che tu hai tradito quella fiducia e mi hai portato via tutto, e ora non riesco a ricordare perché...",shape=box,color=blue];
		1786 -> 1793;
	1785 [label="Stiamo facendo buoni progressi nel ribaltare queste pietre nella mia mente. Albrecht mi ha fatto un bel numero quando mi ha iniettato quel siero.",shape=box,color=blue];
		1785 -> 1791;
		1785 -> 1792;
		1785 -> 1790;
	1784 [label="Stai rallentando i tuoi progressi nell'aiutarmi a scoprire i miei ricordi. Se intendi mantenere la tua parte dell'accordo, mi aspetto che tu continui il tuo lavoro con la Descendia.",shape=box,color=blue];
		1784 -> 1789;
		1784 -> 1787;
		1784 -> 1788;
		1784 -> 1790;
	1783 [label="Non hai ancora fatto alcun progresso con la Descendia per scoprire i miei ricordi. Se vuoi che io rispetti la mia parte dell'accordo, dovresti impegnarti per rispettare la tua.",shape=box,color=blue];
		1783 -> 1787;
		1783 -> 1788;
		1783 -> 1789;
		1783 -> 1790;
	1793 [label="Check boolean RoatheResetForgiven",color=orange];
		1793 -> 1801 [label=true,color=green];
		1793 -> 1800 [label=false,color=brown];
	1791 [label="Non sembrano piacevoli. ",shape=box,color=red];
		1791 -> 1798;
	1792 [label="Non sembrano piacevoli. Sei sicuro che dovremmo continuare?",shape=box,color=red];
		1792 -> 1799;
	1790 [label="[Fine.]",shape=box,color=red];
		1790 -> 1797;
	1789 [label="Sinceramente, ho avuto qualche difficoltà... continuo a morire, non importa quanto ci provi.",shape=box,color=red];
		1789 -> 1796;
	1787 [label="Non prendo ordini da te, Roathe.",shape=box,color=red];
		1787 -> 1794;
	1788 [label="Ero impegnato. Mi metterò al lavoro.",shape=box,color=red];
		1788 -> 1795;
	1801 [label="Non solo ti ho perdonato per avermi portato via quei ricordi...",shape=box,color=blue];
		1801 -> 1807;
	1800 [label="Non solo sto iniziando a perdonarti per avermi portato via quei ricordi...",shape=box,color=blue];
		1800 -> 1807;
	1798 [label="No, non lo sono. Cosa ti aspettavi dal \"Diavolo di Tau\", ricordi di un pomeriggio soleggiato al parco, sdraiato su una coperta a mangiare uva da un vassoio?",shape=box,color=blue];
		1798 -> 1805;
	1799 [label="Non saprò cosa mi ha portato via finché non lo riavrò tutto indietro. Certo che dobbiamo andare avanti! Quei ricordi sono miei, Drifter. Costituiscono ciò che sono, ciò che ero. Sono il tessuto stesso del mio essere.",shape=box,color=blue];
		1799 -> 1806;
	1797 [label="Chat ends.",color=orange];
	1796 [label="Update boolean RoatheStrugglebus",color=orange];
		1796 -> 1804;
	1794 [label="No, non è vero. E per me non fa alcuna differenza cosa fai nella tua giornata. Sto solo dicendo che se vuoi che quel piccolo maggiordomo magrolino salga quelle scale, hai un compito da svolgere.",shape=box,color=blue];
		1794 -> 1802;
	1795 [label="Assicurati di farlo. Per me non fa alcuna differenza cosa fai nella tua giornata. Sto solo dicendo che se vuoi che quel piccolo maggiordomo magrolino salga quelle scale, hai un compito da svolgere.",shape=box,color=blue];
		1795 -> 1803;
	1807 [label="Ma sto iniziando a desiderare di fidarmi di nuovo di te. Di nuovo! Pur sapendo bene quello che hai fatto. Pur sapendo che potresti semplicemente tradirmi ancora una volta!",shape=box,color=blue];
		1807 -> 1815;
	1805 [label="Mio povero Usurpatore, temo che ciò che troveremo sepolto negli annali della mia mente sarà solo sangue, violenza e fallimento.",shape=box,color=blue];
		1805 -> 1811;
		1805 -> 1812;
	1806 [label="Da quanto ho capito dagli altri riguardo al tuo periodo a Duviri, anche tu hai sofferto di un disturbo simile, vero?",shape=box,color=blue];
		1806 -> 1813;
		1806 -> 1814;
	1804 [label="Non sento altro che storie di te che sconfiggi Narmer. Che sconfiggi orde di soldati Grineer. Che sconfiggi ondate di Murmur ad ogni svolta. Eppure sono riuscito a confonderti?",shape=box,color=blue];
		1804 -> 1810;
	1802 [label="Se a te non importa, allora non importa nemmeno a me. Ho le mie faccende da sbrigare.",shape=box,color=blue];
		1802 -> 1808;
	1803 [label="Se a te non importa, allora non importa nemmeno a me. Ho le mie faccende da sbrigare.",shape=box,color=blue];
		1803 -> 1809;
	1815 [label="Ma mi ritrovo seduto in quella cripta, mi alzo da quella sedia e penso 'Chissà se il Drifter è nei paraggi e se desidera parlare.'",shape=box,color=blue];
		1815 -> 1822;
	1811 [label="Sei tu al comando di questa nave. Se vuoi continuare a navigare verso il buco nero, vai avanti a tutta velocità.",shape=box,color=red];
		1811 -> 1818;
	1812 [label="Sei sicuro di voler continuare, allora?",shape=box,color=red];
		1812 -> 1819;
	1813 [label="Siamo persone molto diverse, Roathe.",shape=box,color=red];
		1813 -> 1820;
	1814 [label="Lo ero. Memoria e apatia. Non riesco ancora a ricordare... interi periodi di tempo.",shape=box,color=red];
		1814 -> 1821;
	1810 [label="+20 Chemistry",color=orange];
		1810 -> 1817;
	1808 [label="Chat ends.",color=orange];
	1809 [label="+10 Chemistry",color=orange];
		1809 -> 1816;
	1822 [label="Quanto è patetico tutto questo? Quanto sono caduto in basso? Io?! Un Orokin?! Roathe! Il Diavolo di Tau! Così irrequieto, così intelletualmente affamato, così disperato per qualsiasi tipo di stimolo, che sono qui a parlare con te!",shape=box,color=blue];
		1822 -> 1831;
		1822 -> 1830;
		1822 -> 1829;
		1822 -> 1828;
	1818 [label="+10 Chemistry",color=orange];
		1818 -> 1824;
	1819 [label="Non saprò cosa mi ha portato via finché non lo riavrò tutto indietro. Certo che dobbiamo andare avanti! Quei ricordi sono miei, Drifter. Costituiscono ciò che sono, ciò che ero. Sono il tessuto stesso del mio essere.",shape=box,color=blue];
		1819 -> 1825;
		1819 -> 1826;
	1820 [label="Può darsi, ma non era certo questo il punto che intendevo sottolineare. E tu stai evitando di doverlo ammettere. Molto bene. Se, in teoria, avessi perso la memoria - cercheresti di recuperarla, se potessi?",shape=box,color=blue];
		1820 -> 1825;
		1820 -> 1826;
	1821 [label="Se avessi l'opportunità di recuperare i ricordi perduti, lo faresti?",shape=box,color=blue];
		1821 -> 1827;
		1821 -> 1825;
		1821 -> 1826;
	1817 [label="Assumendo che tu non mi stia mentendo? Ammetto che è piuttosto lusinghiero. Adorabile. Estremamente triste. Ma lusinghiero.",shape=box,color=blue];
		1817 -> 1823;
	1816 [label="Chat ends.",color=orange];
	1831 [label="Non vedo l'ora di parlare con te, che tu lo voglia o no.",shape=box,color=red];
		1831 -> 1838;
	1830 [label="Cercherò di non prenderla sul personale.",shape=box,color=red];
		1830 -> 1837;
	1829 [label="Oh, ti piace semplicemente parlare con me?",shape=box,color=red];
		1829 -> 1836;
	1828 [label="[Fine.]",shape=box,color=red];
		1828 -> 1835;
	1824 [label="Ben detto Drifter. Non conoscerò l'entità di ciò che mi è stato portato via finché non lo riavrò indietro. Quei ricordi costituiscono ciò che sono, ciò che ero. Sono il tessuto del mio essere.",shape=box,color=blue];
		1824 -> 1827;
		1824 -> 1825;
		1824 -> 1826;
	1825 [label="Penso che sia meglio sapere che non sapere, ma... dobbiamo essere preparati.",shape=box,color=red];
		1825 -> 1832;
	1826 [label="A volte penso che le cose dovrebbero restare sepolte per un motivo.",shape=box,color=red];
		1826 -> 1833;
	1827 [label="Sono tue. È ora di andare a prenderle. Quanto potrà mai essere difficile? Sei un Orokin, hai fatto cose ben peggiori, senza dubbio.",shape=box,color=red];
		1827 -> 1834;
	1823 [label="Chat ends.",color=orange];
	1838 [label="Allora sono terribilmente contento di non essere stato trasformato in un idiota sbavante quando mi hai confuso il cervello con una forchetta.",shape=box,color=blue];
		1838 -> 1842;
	1837 [label="Forse dovresti. Dopotutto sei stato tu a frugare nella mia testa con una forchetta.",shape=box,color=blue];
		1837 -> 1842;
	1836 [label="Forse lo farei, se non sapessi che hai frugato nel mio cranio con una forchetta.",shape=box,color=blue];
		1836 -> 1842;
	1835 [label="Chat ends.",color=orange];
	1832 [label="Preparato, precisamente, in che modo? Credi che crollerò come un fragile castello di carte una volta appresa la terribile verità di qualche grottesco crimine di guerra?",shape=box,color=blue];
		1832 -> 1839;
	1833 [label="Non siamo quindi condannati a ripetere gli errori del passato? Senza mai imparare, senza mai evolverci, vivendo per sempre nella beata ignoranza di ciò che eravamo un tempo?",shape=box,color=blue];
		1833 -> 1840;
	1834 [label="+10 Chemistry",color=orange];
		1834 -> 1841;
	1842 [label="Check boolean RoatheResetForgiven",color=orange];
		1842 -> 1846 [label=true,color=green];
		1842 -> 1847 [label=false,color=brown];
	1839 [label="Credimi, posso immaginare ogni cosa che avrei potuto fare ai Sentient, agli Orokin o a qualsiasi combinazione di essi, e c'è ben poco che mi sconvolgerebbe o mi terrorizzerebbe.",shape=box,color=blue];
		1839 -> 1843;
	1840 [label="Hm. Mi rendo conto che forse ho appena confutato la mia stessa tesi per la maggior parte delle persone.",shape=box,color=blue];
		1840 -> 1844;
	1841 [label="Concordo! Non crollerò certo come un fragile castello di carte una volta appresa la terribile verità di qualche grottesco crimine di guerra.",shape=box,color=blue];
		1841 -> 1845;
	1846 [label="Ho detto che ti ho perdonato. E sto cercando di mantenere la promessa fatta. È solo che a volte le parole non bastano a rendere vera una cosa. E dire di perdonare qualcuno, in teoria, è molto bello, ma a volte le emozioni fanno fatica a seguire i fatti.",shape=box,color=blue];
		1846 -> 1851;
		1846 -> 1852;
	1847 [label="Davvero, tutto questo è piuttosto irritante. Vorrei conversare con te. Ma vorrei anche strangolarti per avermi insudiciato la mente.",shape=box,color=blue];
		1847 -> 1853;
		1847 -> 1854;
	1843 [label="Add 1 to Thermostat",color=orange];
		1843 -> 1848;
	1844 [label="Add -1 to Thermostat",color=orange];
		1844 -> 1849;
	1845 [label="Add -2 to Thermostat",color=orange];
		1845 -> 1850;
	1851 [label="Capisco. È difficile da accettare, e forse vorresti farlo, ma non ci riesci.",shape=box,color=red];
		1851 -> 1857;
	1852 [label="Quindi... non mi perdoni?",shape=box,color=red];
		1852 -> 1857;
	1853 [label="Dovrai semplicemente accettare quello che è successo e andare avanti, Roathe.",shape=box,color=red];
		1853 -> 1858;
	1854 [label="Pensi di potermi perdonare?",shape=box,color=red];
		1854 -> 1859;
	1848 [label="Ricordo abbastanza da sapere che avrei potuto chiedere 'perdono' all'altare dei Luminari per i successivi duemila anni e che non mi sarebbe mai stato concesso. ",shape=box,color=blue];
		1848 -> 1855;
	1849 [label="Preferirei informarmi personalmente su tutti i fatti e valutare la situazione sulla base di quelli.",shape=box,color=blue];
		1849 -> 1855;
	1850 [label="Posso immaginare ogni cosa che avrei potuto fare ai Sentient, agli Orokin o a qualsiasi combinazione di essi, e c'è ben poco che mi sconvolgerebbe o mi terrorizzerebbe.",shape=box,color=blue];
		1850 -> 1856;
	1857 [label="Sto facendo del mio meglio, Usurpatore. Perché c'è qualcosa in te che ha catturato la mia attenzione. Sei affascinante. E questa è una cosa rara nel mio mondo.",shape=box,color=blue];
		1857 -> 1862;
	1858 [label="Mmhm.",shape=box,color=blue];
		1858 -> 1863;
	1859 [label="Update boolean RoatheResetForgiven",color=orange];
		1859 -> 1857;
	1855 [label="No, ciò che mi aspetta nel profondo della mia mente non mi spaventa. Desidero semplicemente riprendere ciò che mi è stato ingiustamente sottratto.",shape=box,color=blue];
		1855 -> 1860;
	1856 [label="No, ciò che mi aspetta nel profondo della mia mente non mi spaventa. Desidero semplicemente riprendere ciò che mi è stato ingiustamente sottratto.",shape=box,color=blue];
