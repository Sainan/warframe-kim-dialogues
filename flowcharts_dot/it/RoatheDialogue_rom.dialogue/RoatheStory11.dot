	2230 [label="Non avevamo notizie dalla nostra gente bloccata su Tau, e non c'era modo di sapere se i loro segnali fossero stati disturbati o fossero stati completamente cancellati.",shape=box,color=blue];
		2230 -> 2226;
	2226 [label="Mi ritrovai a dover esprimere pareri. Come stratega, ci si aspettava che comprendessi il nemico.",shape=box,color=blue];
