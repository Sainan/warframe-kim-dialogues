	j3737804144 [label="MV: DIVISIONE",shape=box,color=blue];
		j3737804144 -> j1169831990;
	j1169831990 [label="Trascrizione: Dopo la prima invasione del Sistema da parte dei Sentient e la disastrosa risposta degli Orokin, regnò uno strano silenzio.",shape=box,color=blue];
		j1169831990 -> j1069520366;
	j1069520366 [label="Non avevamo notizie dalla nostra gente bloccata su Tau, e non c'era modo di sapere se i loro segnali fossero stati disturbati o fossero stati completamente cancellati.",shape=box,color=blue];
		j1069520366 -> j3076431167;
	j3076431167 [label="Mi ritrovai a dover esprimere pareri. Come stratega, ci si aspettava che comprendessi il nemico.",shape=box,color=blue];
		j3076431167 -> j4230762365;
	j4230762365 [label="I Sentient avrebbero potuto distruggere il Terminale della Rotaia Solare sopra Tau in qualsiasi momento, eppure la Rotaia era ancora attiva.",shape=box,color=blue];
		j4230762365 -> j3163311377;
	j3163311377 [label="Perché? Cosa ci guadagnavano nel lasciare il portale aperto?",shape=box,color=blue];
		j3163311377 -> j2468773636;
	j2468773636 [label="Erano uniti nella loro aggressione, o qualcuno sperava ancora in una coesistenza pacifica?",shape=box,color=blue];
