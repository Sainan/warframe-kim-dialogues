		818 -> 833;
	819 [label="Update boolean RoatheRank2Convo1Complete",color=orange];
		819 -> 834;
	821 [label="Quindi è vero. Ti intrufolavi a Gaule per rubacchiare cioccolatini? Con che aspetto...?",shape=box,color=red];
		821 -> 836;
	822 [label="Come li trovavi, esattamente?",shape=box,color=red];
		822 -> 837;
	820 [label="Ah! Beh. I maledetti cioccolatini erano l'unica cosa buona di quella speduta città infernale.",shape=box,color=blue];
