	856 [label="Ma ne hai portati abbastanza anche per Marie e Lyon?",shape=box,color=red];
		856 -> 858;
	857 [label="Quindi hai semplicemente rubato i dolcetti.",shape=box,color=red];
		857 -> 859;
	858 [label="Ah. Ti aspettavi che cosa? Che ne prendessi abbastanza solo per me e li lasciassi senza? Semplicemente perché non mi piace la loro compagnia e desidero liberarmene?",shape=box,color=blue];
		858 -> 860;
	859 [label="Tutto su quel pianeta sarebbe presto appartenuto all'Impero Orokin. Era comunque mio di diritto.",shape=box,color=blue];
		859 -> 861;
	860 [label="Pensi che la mia avversione per loro mi obblighi in qualche modo a essere crudele anche con loro. Perché sono un diavolo, quindi, incline a tali atti, è il ragionamento che segue.",shape=box,color=blue];
		860 -> 862;
	861 [label="E poi, non avevo soldi. Cosa ti aspettavi che facessi?",shape=box,color=blue];
		861 -> 863;
	862 [label="Che delusione! Comportamenti superficiali come questi sono riservati ai più noiosi e ai bulli del cortile della scuola. ",shape=box,color=blue];
		862 -> 864;
	863 [label="E so che ti fai strada a forza tra le navi e prendi tutto ciò di cui hai bisogno o che desideri - non guardarmi con quegli occhi innocenti, Usurpatore.",shape=box,color=blue];
		863 -> 865;
		863 -> 866;
	864 [label="Li detesto. Eppure devo convivere con loro. Non voglio che vengano privati di uno stupido pasticcino. È solo un pasticcino. Perché peggiorare inutilmente le cose?",shape=box,color=blue];
		864 -> 867;
		864 -> 868;
		864 -> 869;
	865 [label="Non importa. ",shape=box,color=red];
		865 -> 870;
	866 [label="Mi sembra giusto, direi.",shape=box,color=red];
		866 -> 871;
	867 [label="Oppure, potresti provare a essere gentile con loro solo per il gusto di farlo.",shape=box,color=red];
		867 -> 872;
	868 [label="Quindi, solo per chiarire - sei stato gentile, perché li detesti.",shape=box,color=red];
		868 -> 873;
	869 [label="Non ci avevo mai pensato in questi termini, credo.",shape=box,color=red];
		869 -> 874;
	870 [label="Fantastico. Un altro che non è in grado di concedere un punto. Come se i fanatici non fossero già abbastanza, che mi urlano contro a tutte le ore, implorandomi di pentirmi.",shape=box,color=blue];
		870 -> 758;
		870 -> 759;
		870 -> 760;
