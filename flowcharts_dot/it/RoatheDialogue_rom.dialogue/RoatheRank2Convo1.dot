	j1028752195 [label="Abbiamo appena iniziato a svelare i primi dettagli di ciò che mi era stato nascosto. Non so cosa Albrecht abbia detto loro dei miei crimini, Drifter. ",shape=box,color=blue];
		j1028752195 -> j4291809497;
	j2376881762 [label="Abbiamo appena iniziato a scalfire la superficie di ciò che mi era stato nascosto. Non so cosa Albrecht abbia detto loro dei miei crimini, Drifter.",shape=box,color=blue];
		j2376881762 -> j4291809497;
