		618 -> 622 [label="false",color=purple];
	619 [label="Dal mio punto di vista è una sfida strana, operare solo come una parte dei miei ricordi intatti e sapere di avere in mano l'altra metà del mazzo.",shape=box,color=blue];
		619 -> 623;
	620 [label="Ma tutta questa... conversazione ripetitiva? È solo una perdita di tempo. Quindi dai. Dillo. E il tuo problema sarà risolto.",shape=box,color=blue];
		620 -> 624;
		620 -> 625;
	621 [label="Dimmi cosa vuoi e raggiungiamo un accordo. Tutta questa... discussione ripetitiva è solo una perdita di tempo.",shape=box,color=blue];
