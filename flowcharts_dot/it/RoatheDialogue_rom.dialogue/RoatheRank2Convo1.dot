	j236829787 [label="Sì, con la pelle blu, la coda, il corpo infestato e tutto il resto. È incredibile cosa possono fare un mantello, un cappello e una maschera.",shape=box,color=blue];
		j236829787 -> j2502600220;
	j91717013 [label="È stato abbastanza facile. Inoltre, in qualità di “protoframe” e Orokin d'élite addestrato al combattimento, penso di essere abbastanza capace da rubare dei dolcetti da un mercato senza allertare le autorità.",shape=box,color=blue];
		j91717013 -> j1049508590;
	j3715518269 [label="Prima che tu me lo chieda, è una storia che è meglio che sia Marie a raccontare, altrimenti i fanatici cominciano a urlarmi e a inveirmi di nuovo contro.",shape=box,color=blue];
		j3715518269 -> j3423032858;
	j526618274 [label="Promesse al diavolo... una cosa pericolosa.",shape=box,color=blue];
		j526618274 -> j3866645924;
	j141562787 [label="E io sono un diavolo paziente.",shape=box,color=blue];
		j141562787 -> j3866645924;
	j462866155 [label="Vedi di farlo.",shape=box,color=blue];
		j462866155 -> j3866645924;
	j3573356003 [label="Certo che no! Che divertimento ci sarebbe?",shape=box,color=blue];
		j3573356003 -> j3866645924;
	j4186979358 [label="Che meraviglia! E non mi sorprende affatto! E cosa me ne importa se è la verità o no?! E poi -",shape=box,color=blue];
		j4186979358 -> j3142115991;
	j3142115991 [label="Sbagliato! Straordinariamente, meravigliosamente, beatamente sbagliato! Non parlarmi come se conoscessi i meandri di una rabbia che, a mio parere, non puoi nemmeno lontanamente immaginare.",shape=box,color=blue];
		j3142115991 -> j3550338677;
	j3194692666 [label="Non osare parlarmi di ciò che ha valore nella mia mente e di ciò che non lo ha, Drifter. Non è tua e non puoi rivendicarne la proprietà.",shape=box,color=blue];
		j3194692666 -> j3550338677;
	j2502600220 [label="Gli esseri umani tendono a ignorare rapidamente coloro che non desiderano vedere. Inoltre, in qualità di “protoframe” e Orokin d'élite addestrato al combattimento, penso di essere abbastanza capace da rubare dei dolcetti da un mercato senza allertare le autorità.",shape=box,color=blue];
		j2502600220 -> j4202875018;
	j1049508590 [label="Sì, con la pelle blu, la coda, il corpo infestato e tutto il resto. È incredibile cosa possono fare un mantello, un cappello e una maschera.",shape=box,color=blue];
		j1049508590 -> j4202875018;
	j3423032858 [label="Gridano e mi urlano contro parlando di peccato e di quanto io abbia bisogno di pentirmi, senza aggiungere alla lista anche il fatto di “aver mentito ancora una volta sulla mia versione dei fatti”.",shape=box,color=blue];
		j3423032858 -> j2886690281;
		j3423032858 -> j665352525;
		j3423032858 -> j1333841608;
		j3423032858 -> j122144813;
	j4202875018 [label="Boolean RoatheMariePastry1 is now true.",color=orange];
		j4202875018 -> j1434923102;
		j4202875018 -> j3382876103;
	j1434923102 [label="Ma ne hai portati abbastanza anche per Marie e Lyon?",shape=box,color=red];
		j1434923102 -> j2933358059;
	j3382876103 [label="Quindi hai semplicemente rubato i dolcetti.",shape=box,color=red];
		j3382876103 -> j401606737;
	j2933358059 [label="Ah. Ti aspettavi che cosa? Che ne prendessi abbastanza solo per me e li lasciassi senza? Semplicemente perché non mi piace la loro compagnia e desidero liberarmene?",shape=box,color=blue];
		j2933358059 -> j1926819854;
	j401606737 [label="Tutto su quel pianeta sarebbe presto appartenuto all'Impero Orokin. Era comunque mio di diritto.",shape=box,color=blue];
		j401606737 -> j2236417733;
	j1926819854 [label="Pensi che la mia avversione per loro mi obblighi in qualche modo a essere crudele anche con loro. Perché sono un diavolo, quindi, incline a tali atti, è il ragionamento che segue.",shape=box,color=blue];
		j1926819854 -> j4287843642;
	j2236417733 [label="E poi, non avevo soldi. Cosa ti aspettavi che facessi?",shape=box,color=blue];
		j2236417733 -> j2037764660;
	j4287843642 [label="Che delusione! Comportamenti superficiali come questi sono riservati ai più noiosi e ai bulli del cortile della scuola. ",shape=box,color=blue];
		j4287843642 -> j1579779297;
	j2037764660 [label="E so che ti fai strada a forza tra le navi e prendi tutto ciò di cui hai bisogno o che desideri - non guardarmi con quegli occhi innocenti, Usurpatore.",shape=box,color=blue];
		j2037764660 -> j2408603664;
		j2037764660 -> j2740468319;
	j1579779297 [label="Li detesto. Eppure devo convivere con loro. Non voglio che vengano privati di uno stupido pasticcino. È solo un pasticcino. Perché peggiorare inutilmente le cose?",shape=box,color=blue];
		j1579779297 -> j2971700026;
		j1579779297 -> j3202773612;
		j1579779297 -> j3356390661;
	j2408603664 [label="Non importa. ",shape=box,color=red];
		j2408603664 -> j2468601255;
	j2740468319 [label="Mi sembra giusto, direi.",shape=box,color=red];
		j2740468319 -> j1208978600;
	j2971700026 [label="Oppure, potresti provare a essere gentile con loro solo per il gusto di farlo.",shape=box,color=red];
		j2971700026 -> j2830082283;
	j3202773612 [label="Quindi, solo per chiarire - sei stato gentile, perché li detesti.",shape=box,color=red];
		j3202773612 -> j2826082900;
	j3356390661 [label="Non ci avevo mai pensato in questi termini, credo.",shape=box,color=red];
		j3356390661 -> j2777492300;
	j2468601255 [label="Fantastico. Un altro che non è in grado di concedere un punto. Come se i fanatici non fossero già abbastanza, che mi urlano contro a tutte le ore, implorandomi di pentirmi.",shape=box,color=blue];
		j2468601255 -> j2886690281;
		j2468601255 -> j665352525;
		j2468601255 -> j1333841608;
		j2468601255 -> j122144813;
	j1208978600 [label="+5 Chemistry",color=orange];
		j1208978600 -> j1545399173;
	j2830082283 [label="Sì, prova ad averli che ti ronzano nelle orecchie a tutte le ore del giorno e della notte, maledicendo il tuo nome e implorandoti di pentirti.",shape=box,color=blue];
		j2830082283 -> j2886690281;
		j2830082283 -> j665352525;
		j2830082283 -> j1333841608;
		j2830082283 -> j122144813;
	j2826082900 [label="Esattamente. Cosa c'è di così difficile da capire? E si vede che stai facendo del sarcasmo, Usurpatore. Ma non preoccuparti, mi diverte.",shape=box,color=blue];
		j2826082900 -> j2530437400;
	j2777492300 [label="+5 Chemistry",color=orange];
		j2777492300 -> j1849004077;
	j1545399173 [label="Grazie. Finalmente qualcuno che sa ammettere quando deve arrendersi! Se solo quei due fanatici potessero fare lo stesso, non mi urlerebbero contro a tutte le ore, implorandomi di pentirmi.",shape=box,color=blue];
		j1545399173 -> j2886690281;
		j1545399173 -> j665352525;
		j1545399173 -> j1333841608;
		j1545399173 -> j122144813;
	j2530437400 [label="È almeno meglio delle prediche rancide e interminabili dei fanatici, che mi maledicono e mi esortano continuamente a pentirmi.",shape=box,color=blue];
		j2530437400 -> j2886690281;
		j2530437400 -> j665352525;
		j2530437400 -> j1333841608;
		j2530437400 -> j122144813;
	j1849004077 [label="Prego, non c'è di che. Che sollievo avere qualcuno che è in grado di cambiare punto di vista. Se solo quei due fanatici potessero fare lo stesso, non mi urlerebbero contro a tutte le ore, implorandomi di pentirmi.",shape=box,color=blue];
		j1849004077 -> j2886690281;
		j1849004077 -> j665352525;
		j1849004077 -> j1333841608;
		j1849004077 -> j122144813;
}