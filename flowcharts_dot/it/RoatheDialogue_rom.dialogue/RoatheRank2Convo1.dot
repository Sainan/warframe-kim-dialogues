	871 [label="+5 Chemistry",color=orange];
		871 -> 875;
	872 [label="Sì, prova ad averli che ti ronzano nelle orecchie a tutte le ore del giorno e della notte, maledicendo il tuo nome e implorandoti di pentirti.",shape=box,color=blue];
		872 -> 758;
		872 -> 759;
		872 -> 760;
		872 -> 761;
	873 [label="Esattamente. Cosa c'è di così difficile da capire? E si vede che stai facendo del sarcasmo, Usurpatore. Ma non preoccuparti, mi diverte.",shape=box,color=blue];
		873 -> 876;
	874 [label="+5 Chemistry",color=orange];
		874 -> 877;
	875 [label="Grazie. Finalmente qualcuno che sa ammettere quando deve arrendersi! Se solo quei due fanatici potessero fare lo stesso, non mi urlerebbero contro a tutte le ore, implorandomi di pentirmi.",shape=box,color=blue];
		875 -> 758;
		875 -> 759;
		875 -> 760;
		875 -> 761;
	876 [label="È almeno meglio delle prediche rancide e interminabili dei fanatici, che mi maledicono e mi esortano continuamente a pentirmi.",shape=box,color=blue];
		876 -> 758;
		876 -> 759;
		876 -> 760;
		876 -> 761;
	877 [label="Prego, non c'è di che. Che sollievo avere qualcuno che è in grado di cambiare punto di vista. Se solo quei due fanatici potessero fare lo stesso, non mi urlerebbero contro a tutte le ore, implorandomi di pentirmi.",shape=box,color=blue];
		877 -> 758;
