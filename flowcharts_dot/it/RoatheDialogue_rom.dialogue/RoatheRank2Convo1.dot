	662 [label="Mh. Capisco. Ti ho offerto un accordo, ma in qualche modo non sei riuscito a rispettare la tua parte, così hai visto il tuo premio svanirti dalle mani.",shape=box,color=blue];
		662 -> 685;
	665 [label="Quando parla, generalmente rientra in due categorie - orribilmente insensato o orribilmente folle.",shape=box,color=blue];
		665 -> 688;
	666 [label="Mh? Sei riuscito a sfuggirgli finora? Ti invidio terribilmente. Non passerà molto tempo prima che tu venga coinvolto nel raggio d'azione dell'esplosione, quindi è meglio che tu sia avvisato.",shape=box,color=blue];
		666 -> 689;
	667 [label="Mio povero Drifter. Hai dimenticato quanto noi Orokin rifiutassimo ogni forma di divinità sacra? L'unica cosa che adoravamo eravamo noi stessi.",shape=box,color=blue];
		667 -> 690;
	663 [label="Come desideri. Ti avverto, questa tua decisione non può essere annullata senza conseguenze.",shape=box,color=blue];
		663 -> 686;
	664 [label="Comportati bene e aiutami a convincere Loid ad andare di sopra e a riconciliarsi con la famiglia. E io ti aiuterò a mettere ordine nei tuoi ricordi.",shape=box,color=red];
		664 -> 687;
	668 [label="Non significa che ti manchi l'iniziativa. Significa solo che alcune cose richiedono qualche tentativo in più.",shape=box,color=red];
		668 -> 691;
	669 [label="Spero non ti turbi.",shape=box,color=red];
