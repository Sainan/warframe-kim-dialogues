	609 [label="Trovo terribilmente affascinante che tu abbia complottato con me per... organizzare il mio percorso. Il diavolo, infine, agisce nella sua stessa carne.",shape=box,color=blue];
		609 -> 619;
	608 [label="Come vanno i progressi dalla tua parte, mio Usurpatore? Sono impegnato a muovere fili e leve a tuo favore, anche se la mia influenza potrebbe essere finora invisibile e inavvertita.",shape=box,color=blue];
		608 -> 619;
	610 [label="Dimmi che hai cambiato idea sulla mia offerta. Dove prima avrei potuto rappresentare una barriera di resistenza, riguardo ai tuoi... obiettivi romantici? Ora sarò docile come la neve. Mmm. A meno che non sia questo che desideri. Puoi decidere tu.",shape=box,color=blue];
		610 -> 620;
	611 [label="Dimmi che hai cambiato idea sulla mia offerta. Posso risolvere questo problema con Marie per te. Assicurarti di raggiungere i tuoi obiettivi romantici con lei senza difficoltà.",shape=box,color=blue];
		611 -> 620;
	612 [label="Dimmi che hai cambiato idea sulla mia offerta. Posso risolvere questo problema con Lyon per te. Assicurarti di raggiungere i tuoi obiettivi romantici con lui senza difficoltà.",shape=box,color=blue];
		612 -> 620;
	613 [label="Dimmi che hai cambiato idea riguardo alla mia offerta. Dove prima avrei potuto rappresentare una barriera di resistenza, riguardo alla mia... assunzione del siero? Mi dimostrerò docile come la neve.",shape=box,color=blue];
		613 -> 620;
	614 [label="Dimmi che hai cambiato idea sulla mia offerta. Dove prima avrei potuto rappresentare una barriera di resistenza, riunendo il maggiordomo e la sua famiglia? Mi dimostrerò docile come la neve.",shape=box,color=blue];
		614 -> 620;
	615 [label="Dimmi che hai cambiato idea sulla mia offerta - posso risolvere questo problema con Marie per te. Assicurarti che le tue conversazioni con lei siano senza difficoltà.",shape=box,color=blue];
		615 -> 620;
	616 [label="Dimmi che hai cambiato idea sulla mia offerta - posso risolvere questo problema con Lyon per te. Assicurarti che le tue conversazioni con lui siano senza difficoltà.",shape=box,color=blue];
		616 -> 620;
	617 [label="Non posso fare a meno di pensare che tu ti stia soffermando su queste nostre conversazioni per un motivo, Usurpatore. E che potrei aiutarti in questo.",shape=box,color=blue];
		617 -> 621;
