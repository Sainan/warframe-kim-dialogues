	842 [label="Update boolean RoatheKnowsReset2",color=orange];
		842 -> 851;
	843 [label="Che meraviglia! E non mi sorprende affatto! E cosa me ne importa se è la verità o no?! E poi -",shape=box,color=blue];
		843 -> 844;
	844 [label="Sbagliato! Straordinariamente, meravigliosamente, beatamente sbagliato! Non parlarmi come se conoscessi i meandri di una rabbia che, a mio parere, non puoi nemmeno lontanamente immaginare.",shape=box,color=blue];
		844 -> 746;
	845 [label="Non osare parlarmi di ciò che ha valore nella mia mente e di ciò che non lo ha, Drifter. Non è tua e non puoi rivendicarne la proprietà.",shape=box,color=blue];
		845 -> 746;
	847 [label="Gli esseri umani tendono a ignorare rapidamente coloro che non desiderano vedere. Inoltre, in qualità di “protoframe” e Orokin d'élite addestrato al combattimento, penso di essere abbastanza capace da rubare dei dolcetti da un mercato senza allertare le autorità.",shape=box,color=blue];
		847 -> 852;
	848 [label="Sì, con la pelle blu, la coda, il corpo infestato e tutto il resto. È incredibile cosa possono fare un mantello, un cappello e una maschera.",shape=box,color=blue];
		848 -> 852;
