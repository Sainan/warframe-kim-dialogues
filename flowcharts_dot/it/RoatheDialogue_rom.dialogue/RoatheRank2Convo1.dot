		827 -> 842;
	828 [label="Hai affermato di non essere arrabbiato con me perché ti ho cancellato la memoria, ma so che stai mentendo. Perché... non è la prima volta che lo faccio.",shape=box,color=red];
		828 -> 843;
	829 [label="Perché ti detesti per aver preso quel siero volontariamente. Ti detesti, e questo ti fa infuriare - perchè sei tutto ciò che ti rimane.",shape=box,color=red];
