	802 [label="So che siamo al limite, sento la tensione della mia mente che lotta contro di me. Stai facendo del tuo meglio per aiutarmi a recuperare i miei ricordi. E per questo ti sono grato. ",shape=box,color=blue];
		802 -> 813;
	803 [label="Abbiamo appena iniziato a svelare i primi dettagli di ciò che mi era stato nascosto. Non so cosa Albrecht abbia detto loro dei miei crimini, Drifter. ",shape=box,color=blue];
		803 -> 814;
	804 [label="Abbiamo appena iniziato a scalfire la superficie di ciò che mi era stato nascosto. Non so cosa Albrecht abbia detto loro dei miei crimini, Drifter.",shape=box,color=blue];
		804 -> 814;
	805 [label="Non so cosa Albrecht abbia detto loro dei miei crimini, perché sono ignoti persino a me. La verità è nascosta nei miei ricordi, Drifter.",shape=box,color=blue];
		805 -> 814;
	806 [label="Non molto tempo fa, ti ho confidato una terribile verità. Ora non ricordo perché.",shape=box,color=blue];
		806 -> 815;
	807 [label="Sotto la superficie, so che sei, beh, un inferno infuocato. E so che dobbiamo arrivare a un certo punto prima di poterne parlare.",shape=box,color=red];
		807 -> 816;
	808 [label="E perché dovresti fidarti di me? Tutto ciò che sai di me è che... ho manomesso la tua memoria.",shape=box,color=red];
		808 -> 817;
	809 [label="Update boolean RoatheKnowsReset2",color=orange];
		809 -> 818;
	810 [label="Beh, se non vuoi essere tedioso, Drifter, perché dovrei perdere tempo con te? Ho già i fanatici, e a quanto pare sono obbligato a passare del tempo con loro.",shape=box,color=blue];
		810 -> 819;
	812 [label="Ah, quindi te l'ha detto. Ovvio che l'ha fatto. Beh, non è certo colpa mia! Quelle dannate leccornie erano l'unica cosa buona di quella città infernale e sperduta.",shape=box,color=blue];
		812 -> 821;
