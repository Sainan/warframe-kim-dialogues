	836 [label="Sì, con la pelle blu, la coda, il corpo infestato e tutto il resto. È incredibile cosa possono fare un mantello, un cappello e una maschera.",shape=box,color=blue];
		836 -> 847;
	837 [label="È stato abbastanza facile. Inoltre, in qualità di “protoframe” e Orokin d'élite addestrato al combattimento, penso di essere abbastanza capace da rubare dei dolcetti da un mercato senza allertare le autorità.",shape=box,color=blue];
		837 -> 848;
	835 [label="Prima che tu me lo chieda, è una storia che è meglio che sia Marie a raccontare, altrimenti i fanatici cominciano a urlarmi e a inveirmi di nuovo contro.",shape=box,color=blue];
		835 -> 846;
	838 [label="Promesse al diavolo... una cosa pericolosa.",shape=box,color=blue];
		838 -> 849;
