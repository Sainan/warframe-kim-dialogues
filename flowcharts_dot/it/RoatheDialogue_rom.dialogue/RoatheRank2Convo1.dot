		640 -> 664;
	644 [label="\"Finora.\" Intrigante. E stiamo tutti tornando sui nostri passi, come cortigiani che ripetono i movimenti di una danza? Ancora e ancora, condannati a ripeterci?",shape=box,color=blue];
		644 -> 668;
		644 -> 669;
	645 [label="Immagino che tu lo sappia, vero? Interessante che sia così prevedibile. È bello sapere che anche su qualcuno distrutto come lui, ogni tanto si può ancora contare.",shape=box,color=blue];
		645 -> 670;
	646 [label="Non lo sai già? Mm. Forse non sei arrivato fino a qui. O non hai pensato di chiedere, la prima o la millesima volta, di questa piccola avventura.",shape=box,color=blue];
		646 -> 670;
	647 [label="Oh. E un'altra cosa, prima che me ne dimentichi?",shape=box,color=blue];
		647 -> 671;
	649 [label="Come hai davvero venduto l'anima al diavolo e per due volte... prendendo accordi per assicurarti che ti porti nel mio letto? O stai cercando il mio cuore, Usurpatore? Mm. Vedremo. Col tempo.",shape=box,color=blue];
		649 -> 672;
	650 [label="Quando verrà il momento, mi assicurerò che tu abbia la strada libera per corteggiare la nostra piccola leccapiedi fluttuante, Usurpatore. Considera la questione risolta.",shape=box,color=blue];
		650 -> 673;
	651 [label="Quando verrà il momento, ti assicurerò che la strada per corteggiare il povero prete distrutto, Usurpatore, sia libera. Considera la cosa fatta.",shape=box,color=blue];
		651 -> 674;
	652 [label="Quando verrà il momento, me ne ricorderò. Se dovessimo avere un ulteriore disaccordo sui miei ricordi, non ripeteremo i tuoi precedenti errori.",shape=box,color=blue];
		652 -> 675;
	655 [label="Quando arriverà il momento, mi assicurerò che il piccolo maggiordomo salga quelle scale. Considera la cosa fatta.",shape=box,color=blue];
		655 -> 678;
	654 [label="Considera il tuo problema con Marie e la sua adorazione servile per Entrati, risolto. Quando verrà il momento, me ne occuperò io.",shape=box,color=blue];
		654 -> 677;
	653 [label="Considera il tuo problema con Lyon e i suoi orrori risolti, Usurpatore. Quando verrà il momento, me ne occuperò io.",shape=box,color=blue];
		653 -> 676;
	648 [label="Io... a quanto pare ho dimenticato cosa stavi cercando. La colpa è della tua interferenza con i miei ricordi. Cos'era?",shape=box,color=blue];
		648 -> 626;
	656 [label="Io ti consiglierei semplicemente di avere pazienza, ma... lungi da me consigliarti di usare uno scalpello quando hai accanto un piccone laser.",shape=box,color=blue];
		656 -> 679;
	657 [label="Mh. Capisco. Un'impresa nobile, se devo essere sincero. Un'impresa che ho tentato io stesso, molte, moltissime volte. E ho fallito altrettante.",shape=box,color=blue];
