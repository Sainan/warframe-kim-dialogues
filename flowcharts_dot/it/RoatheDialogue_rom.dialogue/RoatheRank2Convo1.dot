	691 [label="Sono divertito dal tuo ottimismo. Eroi. È tutto quello che siete, te lo giuro. Sacchi di carne e ossa gonfiati e mossi esclusivamente dall'ottimismo e dalla speranza. È abbastanza da farti marcire i denti.",shape=box,color=blue];
