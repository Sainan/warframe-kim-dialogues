		776 -> 789;
	777 [label="Considera questo, se vuoi - se lei è in grado di guardare la verità dritta negli occhi e continuare a negarla con Albrecht? È perfettamente in grado di fare lo stesso con cose molto più pericolose.",shape=box,color=blue];
