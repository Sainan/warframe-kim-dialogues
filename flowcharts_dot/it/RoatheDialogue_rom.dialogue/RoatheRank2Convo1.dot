		j2277031776 -> j3543135409;
	j3445925235 [label="Boolean RoatheLyonConfessionDeal is now true.",color=orange];
		j3445925235 -> j3543135409;
	j4263162615 [label="Molto Orokin da parte tua.",shape=box,color=blue];
		j4263162615 -> j1249910496;
	j3709871531 [label="Molto Orokin da parte tua.",shape=box,color=blue];
		j3709871531 -> j2689337818;
	j3420720097 [label="Molto Orokin da parte tua.",shape=box,color=blue];
		j3420720097 -> j1778447231;
	j2628970840 [label="+5 Chemistry",color=orange];
		j2628970840 -> j2779185368;
	j1949516067 [label="+5 Chemistry",color=orange];
		j1949516067 -> j1954892301;
	j3841271794 [label="+5 Chemistry",color=orange];
		j3841271794 -> j3882400417;
	j1112028237 [label="Molto Orokin da parte tua.",shape=box,color=blue];
		j1112028237 -> j2375952678;
	j3251753147 [label="Sufficientemente isterico? Continuo comunque a preferirlo alla sorella. Almeno con lui si può ragionare.",shape=box,color=blue];
		j3251753147 -> j3001896684;
		j3251753147 -> j4147408644;
	j1618892867 [label="Lei è semplicemente così moralista da intorpidire la mente.",shape=box,color=blue];
		j1618892867 -> j1079593196;
		j1618892867 -> j479165856;
