	811 [label="+5 Chemistry",color=orange];
		811 -> 820;
	813 [label="Devo sapere cosa mi è stato portato via, Drifter. Devo sapere cosa mi ha rubato Albrecht quando mi ha somministrato questo siero con la forza.",shape=box,color=blue];
		813 -> 823;
		813 -> 824;
	814 [label=" Ho bisogno di sapere cosa mi ha rubato Albrecht quando mi ha somministrato questo siero con la forza. Ho bisogno di sapere cosa è rinchiuso nella mia testa, Drifter. Ovviamente, solo quando non ti crea inconvenienti...",shape=box,color=blue];
