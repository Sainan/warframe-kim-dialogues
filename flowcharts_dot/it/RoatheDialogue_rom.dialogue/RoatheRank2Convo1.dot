	634 [label="Lyon ha... così tante cose a cui pensare. E non so come aiutarlo a superare tutto.",shape=box,color=red];
		634 -> 656;
	635 [label="Marie non vedrà mai Entrati per quello che è. E io non riesco farle aprire gli occhi, non importa cosa faccia.",shape=box,color=red];
		635 -> 657;
	636 [label="Beh, vedi, hai tutta questa... cosa sul perché hai preso il siero, e io... ti ho detto due cosine sbagliate al momento sbagliato.",shape=box,color=red];
		636 -> 658;
	637 [label="Forse è un po' imbarazzante, ma... provo dei sentimenti per uno di voi tre.",shape=box,color=red];
		637 -> 659;
