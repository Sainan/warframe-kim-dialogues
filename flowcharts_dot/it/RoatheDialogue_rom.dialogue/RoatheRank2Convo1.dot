	815 [label="Tu sei sia l'unica anima di cui avrei mai potuto sperare di fidarmi... sia il motivo per cui ora non riesco a ricordare perché io abbia osato farlo.",shape=box,color=blue];
		815 -> 827;
	816 [label="E perché dovrei arrabbiarmi, Drifter?",shape=box,color=blue];
		816 -> 828;
		816 -> 829;
		816 -> 830;
	817 [label="'Hai manomesso la mia memoria'. Come se fossi una Scultura Ayatan con cui giochi. Hai fatto molto più che manomettere la mia memoria. Hai fatto centro.",shape=box,color=blue];
