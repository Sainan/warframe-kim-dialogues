	628 [label="Come procede la tua relazione con la nostra piccola leccapiedi fluttuante? Immagino che il prete non ti stia ancora rivolgendo la parola.",shape=box,color=blue];
		628 -> 641;
		628 -> 642;
		628 -> 643;
	627 [label="Dimmi, hai cambiato idea sulla mia offerta? Questa sarà la tua ultima possibilità, Usurpatore. Sono un diavolo paziente, ma non mi piace lasciare le porte aperte come un idiota.",shape=box,color=blue];
		627 -> 639;
		627 -> 640;
