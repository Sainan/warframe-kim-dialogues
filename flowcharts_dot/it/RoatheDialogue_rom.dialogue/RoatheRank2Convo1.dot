	j216863090 [label="Evaluate expressions",color=orange];
		j216863090 -> j2694130358 [label="RoatheKnowsReset",color=purple];
		j216863090 -> j2694130358 [label="RoatheDeal",color=purple];
		j216863090 -> j2694130358 [label="RoatheNoDeal",color=purple];
		j216863090 -> j2694130358 [label="false",color=purple];
	j1572213780 [label="Trovo terribilmente affascinante che tu abbia complottato con me per... organizzare il mio percorso. Il diavolo, infine, agisce nella sua stessa carne.",shape=box,color=blue];
		j1572213780 -> j1403102731;
	j3740678659 [label="Come vanno i progressi dalla tua parte, mio Usurpatore? Sono impegnato a muovere fili e leve a tuo favore, anche se la mia influenza potrebbe essere finora invisibile e inavvertita.",shape=box,color=blue];
		j3740678659 -> j1403102731;
	j2821466292 [label="Dimmi che hai cambiato idea sulla mia offerta. Dove prima avrei potuto rappresentare una barriera di resistenza, riguardo ai tuoi... obiettivi romantici? Ora sarò docile come la neve. Mmm. A meno che non sia questo che desideri. Puoi decidere tu.",shape=box,color=blue];
		j2821466292 -> j2909937805;
	j447437836 [label="Dimmi che hai cambiato idea sulla mia offerta. Posso risolvere questo problema con Marie per te. Assicurarti di raggiungere i tuoi obiettivi romantici con lei senza difficoltà.",shape=box,color=blue];
		j447437836 -> j2909937805;
	j2348679715 [label="Dimmi che hai cambiato idea sulla mia offerta. Posso risolvere questo problema con Lyon per te. Assicurarti di raggiungere i tuoi obiettivi romantici con lui senza difficoltà.",shape=box,color=blue];
		j2348679715 -> j2909937805;
	j3575170962 [label="Dimmi che hai cambiato idea riguardo alla mia offerta. Dove prima avrei potuto rappresentare una barriera di resistenza, riguardo alla mia... assunzione del siero? Mi dimostrerò docile come la neve.",shape=box,color=blue];
		j3575170962 -> j2909937805;
	j237150469 [label="Dimmi che hai cambiato idea sulla mia offerta. Dove prima avrei potuto rappresentare una barriera di resistenza, riunendo il maggiordomo e la sua famiglia? Mi dimostrerò docile come la neve.",shape=box,color=blue];
		j237150469 -> j2909937805;
	j127476998 [label="Dimmi che hai cambiato idea sulla mia offerta - posso risolvere questo problema con Marie per te. Assicurarti che le tue conversazioni con lei siano senza difficoltà.",shape=box,color=blue];
		j127476998 -> j2909937805;
	j1829341128 [label="Dimmi che hai cambiato idea sulla mia offerta - posso risolvere questo problema con Lyon per te. Assicurarti che le tue conversazioni con lui siano senza difficoltà.",shape=box,color=blue];
		j1829341128 -> j2909937805;
	j2259073834 [label="Non posso fare a meno di pensare che tu ti stia soffermando su queste nostre conversazioni per un motivo, Usurpatore. E che potrei aiutarti in questo.",shape=box,color=blue];
		j2259073834 -> j3825824691;
	j2694130358 [label="Evaluate expressions on HellStory counter",color=orange];
		j2694130358 -> j3869625108 [label="x >= 21",color=purple];
		j2694130358 -> j2075111951 [label="x < 21",color=purple];
		j2694130358 -> j2075111951 [label="false",color=purple];
	j1403102731 [label="Dal mio punto di vista è una sfida strana, operare solo come una parte dei miei ricordi intatti e sapere di avere in mano l'altra metà del mazzo.",shape=box,color=blue];
		j1403102731 -> j3337992048;
	j2909937805 [label="Ma tutta questa... conversazione ripetitiva? È solo una perdita di tempo. Quindi dai. Dillo. E il tuo problema sarà risolto.",shape=box,color=blue];
		j2909937805 -> j192837459;
		j2909937805 -> j2241057444;
	j3825824691 [label="Dimmi cosa vuoi e raggiungiamo un accordo. Tutta questa... discussione ripetitiva è solo una perdita di tempo.",shape=box,color=blue];
		j3825824691 -> j2953660143;
	j2075111951 [label="Evaluate expressions",color=orange];
		j2075111951 -> j454800500 [label="RoatheDeal",color=purple];
		j2075111951 -> j1452362688 [label="RoatheNoDeal",color=purple];
		j2075111951 -> j1452362688 [label="false",color=purple];
	j3337992048 [label="Quindi, in mancanza di niente di meglio da fare, continuerò a parlare. 'A proposito, come va con la nostra piccola leccapiedi fluttuante? Immagino il prete non ti rivolga ancora la parola.' Bah. Che farsa!",shape=box,color=blue];
		j3337992048 -> j2308517911;
		j3337992048 -> j441015439;
		j3337992048 -> j46363959;
	j192837459 [label="No, mi dispiace. Non faccio accordi con gli Orokin. Né allora, né ora, né mai.",shape=box,color=red];
		j192837459 -> j1314162571;
	j2241057444 [label="Spero davvero che tu non me ne faccia pentire, Roathe. Va bene. Sono d'accordo. Ho bisogno del tuo aiuto.",shape=box,color=red];
		j2241057444 -> j1876832257;
	j2953660143 [label="Check boolean LoidFamilyComplete",color=orange];
		j2953660143 -> j1649389940 [label=true,color=green];
		j2953660143 -> j3748841840 [label=true,color=green];
		j2953660143 -> j792794090 [label=true,color=green];
		j2953660143 -> j3988904895 [label=true,color=green];
		j2953660143 -> j1649389940 [label=false,color=brown];
		j2953660143 -> j3748841840 [label=false,color=brown];
		j2953660143 -> j792794090 [label=false,color=brown];
		j2953660143 -> j3988904895 [label=false,color=brown];
		j2953660143 -> j987286256 [label=false,color=brown];
	j454800500 [label="Come procede la tua relazione con la nostra piccola leccapiedi fluttuante? Immagino che il prete non ti stia ancora rivolgendo la parola.",shape=box,color=blue];
		j454800500 -> j1409176794;
		j454800500 -> j3411930304;
		j454800500 -> j675300444;
	j1452362688 [label="Dimmi, hai cambiato idea sulla mia offerta? Questa sarà la tua ultima possibilità, Usurpatore. Sono un diavolo paziente, ma non mi piace lasciare le porte aperte come un idiota.",shape=box,color=blue];
		j1452362688 -> j759298166;
		j1452362688 -> j4279113651;
	j2308517911 [label="Finora mi trovo bene con Marie.",shape=box,color=red];
		j2308517911 -> j4105744895;
	j441015439 [label="No, ma cambierà idea.",shape=box,color=red];
		j441015439 -> j3874459649;
	j46363959 [label="Sembra che non ti piacciano molto. Perché?",shape=box,color=red];
		j46363959 -> j2641477663;
	j1314162571 [label="Come desideri. Ti avverto, questa era la tua ultima opportunità. Ora te la sbrighi da solo.",shape=box,color=blue];
		j1314162571 -> j975544256;
	j1876832257 [label="Evaluate expressions",color=orange];
		j1876832257 -> j1694665434 [label="RoatheDatingDealNo",color=purple];
		j1876832257 -> j26120801 [label="RoatheMarieDatingDealNo",color=purple];
		j1876832257 -> j1773113552 [label="RoatheLyonDatingDealNo",color=purple];
		j1876832257 -> j1949506540 [label="RoatheSerumDealNo",color=purple];
		j1876832257 -> j807499380 [label="RoatheFamilyDealNo",color=purple];
		j1876832257 -> j3286766322 [label="RoatheMarieEntratiDealNo",color=purple];
		j1876832257 -> j3427314412 [label="RoatheLyonConfessionDealNo",color=purple];
		j1876832257 -> j3734275734 [label="false",color=purple];
	j1649389940 [label="Lyon ha... così tante cose a cui pensare. E non so come aiutarlo a superare tutto.",shape=box,color=red];
		j1649389940 -> j3612518453;
	j3748841840 [label="Marie non vedrà mai Entrati per quello che è. E io non riesco farle aprire gli occhi, non importa cosa faccia.",shape=box,color=red];
		j3748841840 -> j920074613;
	j792794090 [label="Beh, vedi, hai tutta questa... cosa sul perché hai preso il siero, e io... ti ho detto due cosine sbagliate al momento sbagliato.",shape=box,color=red];
		j792794090 -> j2332138209;
	j3988904895 [label="Forse è un po' imbarazzante, ma... provo dei sentimenti per uno di voi tre.",shape=box,color=red];
		j3988904895 -> j1759592308;
		j3988904895 -> j1259320722;
		j3988904895 -> j549098467;
	j987286256 [label="Sto cercando di convincere te e gli altri ad aiutarmi a riunire Loid con la famiglia al piano di sopra e... non...",shape=box,color=red];
		j987286256 -> j1427548765;
	j1409176794 [label="No, Lyon... non sembra parlare molto.",shape=box,color=red];
		j1409176794 -> j1128703868;
	j3411930304 [label="Mi trovo bene con Marie. Perché la chiami leccapiedi?",shape=box,color=red];
		j3411930304 -> j2508080873;
	j675300444 [label="Sembra che non ti piacciano molto. Perché?",shape=box,color=red];
		j675300444 -> j4011679002;
	j759298166 [label="No, mi dispiace. Non faccio accordi con gli Orokin. Né allora, né ora, né mai.",shape=box,color=red];
		j759298166 -> j2175271966;
	j4279113651 [label="Spero davvero che tu non me ne faccia pentire, Roathe. Va bene. Sono d'accordo.",shape=box,color=red];
		j4279113651 -> j2226093412;
	j4105744895 [label="\"Finora.\" Intrigante. E stiamo tutti tornando sui nostri passi, come cortigiani che ripetono i movimenti di una danza? Ancora e ancora, condannati a ripeterci?",shape=box,color=blue];
		j4105744895 -> j2545470743;
		j4105744895 -> j71957622;
	j3874459649 [label="Immagino che tu lo sappia, vero? Interessante che sia così prevedibile. È bello sapere che anche su qualcuno distrutto come lui, ogni tanto si può ancora contare.",shape=box,color=blue];
		j3874459649 -> j2852058109;
	j2641477663 [label="Non lo sai già? Mm. Forse non sei arrivato fino a qui. O non hai pensato di chiedere, la prima o la millesima volta, di questa piccola avventura.",shape=box,color=blue];
		j2641477663 -> j2852058109;
	j975544256 [label="Oh. E un'altra cosa, prima che me ne dimentichi?",shape=box,color=blue];
		j975544256 -> j2180445597;
	j1694665434 [label="Come hai davvero venduto l'anima al diavolo e per due volte... prendendo accordi per assicurarti che ti porti nel mio letto? O stai cercando il mio cuore, Usurpatore? Mm. Vedremo. Col tempo.",shape=box,color=blue];
		j1694665434 -> j2998702874;
	j26120801 [label="Quando verrà il momento, mi assicurerò che tu abbia la strada libera per corteggiare la nostra piccola leccapiedi fluttuante, Usurpatore. Considera la questione risolta.",shape=box,color=blue];
		j26120801 -> j2998702874;
	j1773113552 [label="Quando verrà il momento, ti assicurerò che la strada per corteggiare il povero prete distrutto, Usurpatore, sia libera. Considera la cosa fatta.",shape=box,color=blue];
		j1773113552 -> j2279831449;
	j1949506540 [label="Quando verrà il momento, me ne ricorderò. Se dovessimo avere un ulteriore disaccordo sui miei ricordi, non ripeteremo i tuoi precedenti errori.",shape=box,color=blue];
		j1949506540 -> j3308375471;
	j807499380 [label="Quando arriverà il momento, mi assicurerò che il piccolo maggiordomo salga quelle scale. Considera la cosa fatta.",shape=box,color=blue];
		j807499380 -> j2998702874;
	j3286766322 [label="Considera il tuo problema con Marie e la sua adorazione servile per Entrati, risolto. Quando verrà il momento, me ne occuperò io.",shape=box,color=blue];
		j3286766322 -> j2700511755;
	j3427314412 [label="Considera il tuo problema con Lyon e i suoi orrori risolti, Usurpatore. Quando verrà il momento, me ne occuperò io.",shape=box,color=blue];
		j3427314412 -> j3700970358;
	j3734275734 [label="Io... a quanto pare ho dimenticato cosa stavi cercando. La colpa è della tua interferenza con i miei ricordi. Cos'era?",shape=box,color=blue];
		j3734275734 -> j2953660143;
	j3612518453 [label="Io ti consiglierei semplicemente di avere pazienza, ma... lungi da me consigliarti di usare uno scalpello quando hai accanto un piccone laser.",shape=box,color=blue];
		j3612518453 -> j285284481;
	j920074613 [label="Mh. Capisco. Un'impresa nobile, se devo essere sincero. Un'impresa che ho tentato io stesso, molte, moltissime volte. E ho fallito altrettante.",shape=box,color=blue];
		j920074613 -> j1827593012;
	j2332138209 [label="Mh.",shape=box,color=blue];
		j2332138209 -> j170715461;
	j1759592308 [label="Lyon.",shape=box,color=red];
		j1759592308 -> j1436807130;
	j1259320722 [label="... Tu.",shape=box,color=red];
		j1259320722 -> j1470887359;
	j549098467 [label="Marie.",shape=box,color=red];
		j549098467 -> j3925984417;
	j1427548765 [label="Mh. Capisco. Ti ho offerto un accordo, ma in qualche modo non sei riuscito a rispettare la tua parte, così hai visto il tuo premio svanirti dalle mani.",shape=box,color=blue];
		j1427548765 -> j4235548281;
	j1128703868 [label="Quando parla, generalmente rientra in due categorie - orribilmente insensato o orribilmente folle.",shape=box,color=blue];
		j1128703868 -> j662457776;
	j2508080873 [label="Mh? Sei riuscito a sfuggirgli finora? Ti invidio terribilmente. Non passerà molto tempo prima che tu venga coinvolto nel raggio d'azione dell'esplosione, quindi è meglio che tu sia avvisato.",shape=box,color=blue];
		j2508080873 -> j1178764202;
	j4011679002 [label="Mio povero Drifter. Hai dimenticato quanto noi Orokin rifiutassimo ogni forma di divinità sacra? L'unica cosa che adoravamo eravamo noi stessi.",shape=box,color=blue];
		j4011679002 -> j1771359280;
	j2175271966 [label="Come desideri. Ti avverto, questa tua decisione non può essere annullata senza conseguenze.",shape=box,color=blue];
		j2175271966 -> j2560310026;
	j2226093412 [label="Comportati bene e aiutami a convincere Loid ad andare di sopra e a riconciliarsi con la famiglia. E io ti aiuterò a mettere ordine nei tuoi ricordi.",shape=box,color=red];
		j2226093412 -> j216657474;
	j2545470743 [label="Non significa che ti manchi l'iniziativa. Significa solo che alcune cose richiedono qualche tentativo in più.",shape=box,color=red];
		j2545470743 -> j266069016;
	j71957622 [label="Spero non ti turbi.",shape=box,color=red];
		j71957622 -> j2360713428;
	j2852058109 [label="Siamo davverro tutti condannati a ripeterci, come cortigiani che ripetono i movimenti di una danza?",shape=box,color=blue];
		j2852058109 -> j2545470743;
		j2852058109 -> j71957622;
	j2180445597 [label="Non molto tempo fa, ti ho confidato una terribile verità. Ora non ricordo perché.",shape=box,color=blue];
		j2180445597 -> j675419200;
	j2998702874 [label="Boolean RoatheFamilyDealNo is now false.",color=orange];
		j2998702874 -> j3746459105;
	j2279831449 [label="Boolean RoatheLyonDatingDealNo is now false.",color=orange];
		j2279831449 -> j1483167712;
	j3308375471 [label="Boolean RoatheSerumDealNo is now false.",color=orange];
		j3308375471 -> j4047859045;
	j2700511755 [label="Boolean RoatheMarieEntratiDealNo is now false.",color=orange];
		j2700511755 -> j2277031776;
	j3700970358 [label="Boolean RoatheLyonConfessionDealNo is now false.",color=orange];
		j3700970358 -> j3445925235;
	j285284481 [label="Credo di iniziare a capire perché ci hai cancellato la mente. Vedendo tutti i tuoi tentativi e imprese fallite... perché non fai quello che devi fare e ricominci da capo?",shape=box,color=blue];
		j285284481 -> j4263162615;
	j1827593012 [label="Vedendo con frustrazione che non riuscivi più a convincerla della semplice verità delle cose, hai fatto ricorso a ciò che era necessario - l'utilizzo di questo... tuo dono.",shape=box,color=blue];
		j1827593012 -> j3709871531;
	j170715461 [label="Non apprezzo il fatto che tu mi stia contaminando la mente per correggere i tuoi errori, Drifter. Tuttavia, che tu stia cercando di farlo per il mio bene è... suppongo, in qualche modo, accettabile.",shape=box,color=blue];
		j170715461 -> j3420720097;
	j1436807130 [label="Boolean DrifterLyon is now true.",color=orange];
		j1436807130 -> j2628970840;
	j1470887359 [label="Boolean DrifterRoathe is now true.",color=orange];
		j1470887359 -> j1949516067;
	j3925984417 [label="Boolean DrifterMarie is now true.",color=orange];
		j3925984417 -> j3841271794;
	j4235548281 [label="Quindi, sapendo che non potevi più ottenere ciò che prima era alla tua portata, hai fatto ricorso a ciò che era - l'utilizzo di questo... tuo dono.",shape=box,color=blue];
		j4235548281 -> j1112028237;
	j662457776 [label="È sempre un lancio di moneta quello che ti capita, e non riesco mai a decidere quale preferisco.",shape=box,color=blue];
		j662457776 -> j3251753147;
	j1178764202 [label="Quella donna è instancabile nella sua dedizione incrollabile e ossessiva per Albrecht. Direi che il maggiordomo dovrebbe preoccuparsi, ma onestamente credo fermamente che si tratti di una devozione innocente. E questo è il mio parere.",shape=box,color=blue];
		j1178764202 -> j1618892867;
	j1771359280 [label="Quei due fanatici non riescono a stare due minuti senza dire “Sol” qui o “Lua” là o senza cercare di benedire il vaso da notte.",shape=box,color=blue];
		j1771359280 -> j1303411274;
	j2560310026 [label="Boolean RoatheFamilyFail is now true.",color=orange];
		j2560310026 -> j2618315640;
	j216657474 [label="+5 Chemistry",color=orange];
		j216657474 -> j216946459;
	j266069016 [label="Sono divertito dal tuo ottimismo. Eroi. È tutto quello che siete, te lo giuro. Sacchi di carne e ossa gonfiati e mossi esclusivamente dall'ottimismo e dalla speranza. È abbastanza da farti marcire i denti.",shape=box,color=blue];
		j266069016 -> j3541932656;
	j2360713428 [label="No, mi hai frainteso. In un certo senso, lo trovo confortante. Significa che anche quando ci riduci ai nostri elementi essenziali, siamo sempre gli stessi. Non possiamo cambiare.",shape=box,color=blue];
		j2360713428 -> j2631304166;
	j675419200 [label="Tu sei sia l'unica anima di cui avrei mai potuto sperare di fidarmi... sia il motivo per cui ora non riesco a ricordare perché io abbia osato farlo.",shape=box,color=blue];
		j675419200 -> j2737312691;
	j3746459105 [label="Boolean RoatheFamilyDeal is now true.",color=orange];
		j3746459105 -> j3543135409;
	j1483167712 [label="Boolean RoatheLyonDatingDeal is now true.",color=orange];
		j1483167712 -> j3543135409;
