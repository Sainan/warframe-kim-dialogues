		680 -> 702;
	681 [label="Non apprezzo il fatto che tu mi stia contaminando la mente per correggere i tuoi errori, Drifter. Tuttavia, che tu stia cercando di farlo per il mio bene è... suppongo, in qualche modo, accettabile.",shape=box,color=blue];
