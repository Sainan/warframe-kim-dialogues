	"Chat ends." [color=orange];
	j2911856131 [label="MV: SACRIFICIO",shape=box,color=blue];
		j2911856131 -> j2903684432;
	j2903684432 [label="Trascrizione: Traivon. Ti ho visto scagliare il tuo Railjack nelle fauci di Praghasa. Distratta, nutrendosi avidamente di te e dei tuoi uomini, non si è mai accorta della mia nave che si allontanava a tutta velocità.",shape=box,color=blue];
		j2903684432 -> j4013685661;
	j4013685661 [label="Hai dato la vita per il tuo superiore. Ho sentito il tuo altruismo come uno schiaffo in faccia.",shape=box,color=blue];
		j4013685661 -> j3453592327;
	j3453592327 [label="Maryna. Mi hai donato il tuo corpo. Insieme, in quella trincea, abbiamo bevuto Kuva. Le mie mani tremavano e la mia gola colava, ma ho trattenuto abbastanza gocce perché si assorbisse.",shape=box,color=blue];
		j3453592327 -> j3434138899;
	j3434138899 [label="Ricordo il tuo ultimo saluto. La scomparsa. Poi ho sbattuto le palpebre per aprire gli occhi che erano stati i tuoi e ho visto il mio cadavere sventrato, morto nel fango.",shape=box,color=blue];
		j3434138899 -> j4090974599;
	j4090974599 [label="Rostig. Qualcosa non andava nel processo di clonazione, dissero. Cos'altro avrebbe potuto spingere un Grineer a rimanere nella sua torretta mentre bruciava vivo? Persino un topo capisce l'autoconservazione!",shape=box,color=blue];
		j4090974599 -> j2886438411;
	j2886438411 [label="No. Il tuo \"difetto\" ti ha posto al di sopra di loro.",shape=box,color=blue];
		j2886438411 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}