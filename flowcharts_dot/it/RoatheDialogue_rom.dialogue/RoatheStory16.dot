	2274 [label="Chat ends.",color=orange];
	2275 [label="Trascrizione: Traivon. Ti ho visto scagliare il tuo Railjack nelle fauci di Praghasa. Distratta, nutrendosi avidamente di te e dei tuoi uomini, non si è mai accorta della mia nave che si allontanava a tutta velocità.",shape=box,color=blue];
		2275 -> 5713;
	5713 [label="Hai dato la vita per il tuo superiore. Ho sentito il tuo altruismo come uno schiaffo in faccia.",shape=box,color=blue];
		5713 -> 5714;
	5714 [label="Maryna. Mi hai donato il tuo corpo. Insieme, in quella trincea, abbiamo bevuto Kuva. Le mie mani tremavano e la mia gola colava, ma ho trattenuto abbastanza gocce perché si assorbisse.",shape=box,color=blue];
		5714 -> 2278;
	2278 [label="Ricordo il tuo ultimo saluto. La scomparsa. Poi ho sbattuto le palpebre per aprire gli occhi che erano stati i tuoi e ho visto il mio cadavere sventrato, morto nel fango.",shape=box,color=blue];
		2278 -> 2272;
	2272 [label="Rostig. Qualcosa non andava nel processo di clonazione, dissero. Cos'altro avrebbe potuto spingere un Grineer a rimanere nella sua torretta mentre bruciava vivo? Persino un topo capisce l'autoconservazione!",shape=box,color=blue];
		2272 -> 2279;
	2279 [label="No. Il tuo \"difetto\" ti ha posto al di sopra di loro.",shape=box,color=blue];
		2279 -> 2271;
	2271 [label="Add 1 to HellStory",color=orange];
		2271 -> 2343;
