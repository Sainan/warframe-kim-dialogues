	2208 [label="Trascrizione: Li ricordo ora. Consorterie di giovani Orokin ridenti.",shape=box,color=blue];
		2208 -> 2212;
	2212 [label="Nobiltà avvolta in vesti ancora incontaminate dal comando.",shape=box,color=blue];
		2212 -> 2205;
	2205 [label="Amici d'infanzia ora a capo di legioni Dax, di Grineer, cellule di materia nulla, carcinatori autoreplicanti, primitivi ragni-lama biodroni, contenitori di truppe rudimentarie.",shape=box,color=blue];
		2205 -> 2213;
	2213 [label="Ragazzi e ragazze d'oro con diavoli famelici al loro comando.",shape=box,color=blue];
		2213 -> 2215;
	2215 [label="La loro arroganza mi cola nella mente come sudore pungente. Bevevano e cantavano, vantandosi dei tempi a venire.",shape=box,color=blue];
		2215 -> 5696;
	5696 [label="i sarebbero fatti un nome. Avrebbero elevato le loro famiglie all'onore.",shape=box,color=blue];
		5696 -> 5697;
	5697 [label="Molti di loro caddero. Nemmeno i loro corpi furono restituiti.",shape=box,color=blue];
		5697 -> 5698;
	5698 [label="Per impedire al nemico di carpire i nostri segreti, vennero sottoposti a scariche Kuva in modo che si liquefacessero dopo la morte.",shape=box,color=blue];
		5698 -> 5699;
	5699 [label="La speranza di una generazione trasformata in una pozzanghera oleosa, spazzata via dagli stivali Grineer.",shape=box,color=blue];
