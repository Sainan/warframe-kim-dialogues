	"Chat ends." [color=orange];
	j2302211148 [label="MV: COMANDANTI",shape=box,color=blue];
		j2302211148 -> j2234120559;
	j2234120559 [label="Trascrizione: Li ricordo ora. Consorterie di giovani Orokin ridenti.",shape=box,color=blue];
		j2234120559 -> j4261384225;
	j4261384225 [label="Nobiltà avvolta in vesti ancora incontaminate dal comando.",shape=box,color=blue];
		j4261384225 -> j3811951067;
	j3811951067 [label="Amici d'infanzia ora a capo di legioni Dax, di Grineer, cellule di materia nulla, carcinatori autoreplicanti, primitivi ragni-lama biodroni, contenitori di truppe rudimentarie.",shape=box,color=blue];
		j3811951067 -> j1855339309;
	j1855339309 [label="Ragazzi e ragazze d'oro con diavoli famelici al loro comando.",shape=box,color=blue];
		j1855339309 -> j403834667;
	j403834667 [label="La loro arroganza mi cola nella mente come sudore pungente. Bevevano e cantavano, vantandosi dei tempi a venire.",shape=box,color=blue];
		j403834667 -> j2762007412;
	j2762007412 [label="i sarebbero fatti un nome. Avrebbero elevato le loro famiglie all'onore.",shape=box,color=blue];
		j2762007412 -> j814142379;
	j814142379 [label="Molti di loro caddero. Nemmeno i loro corpi furono restituiti.",shape=box,color=blue];
		j814142379 -> j2046953484;
	j2046953484 [label="Per impedire al nemico di carpire i nostri segreti, vennero sottoposti a scariche Kuva in modo che si liquefacessero dopo la morte.",shape=box,color=blue];
		j2046953484 -> j3873348046;
	j3873348046 [label="La speranza di una generazione trasformata in una pozzanghera oleosa, spazzata via dagli stivali Grineer.",shape=box,color=blue];
		j3873348046 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}