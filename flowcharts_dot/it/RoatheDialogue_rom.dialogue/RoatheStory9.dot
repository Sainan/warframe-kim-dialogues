	"Chat ends." [color=orange];
	j1962554035 [label="MV: COMANDANTI",shape=box,color=blue];
		j1962554035 -> j3371473666;
	j3371473666 [label="Trascrizione: Li ricordo ora. Consorterie di giovani Orokin ridenti.",shape=box,color=blue];
		j3371473666 -> j285066021;
	j285066021 [label="Nobiltà avvolta in vesti ancora incontaminate dal comando.",shape=box,color=blue];
		j285066021 -> j2105027088;
	j2105027088 [label="Amici d'infanzia ora a capo di legioni Dax, di Grineer, cellule di materia nulla, carcinatori autoreplicanti, primitivi ragni-lama biodroni, contenitori di truppe rudimentarie.",shape=box,color=blue];
		j2105027088 -> j905350185;
	j905350185 [label="Ragazzi e ragazze d'oro con diavoli famelici al loro comando.",shape=box,color=blue];
		j905350185 -> j3572424346;
	j3572424346 [label="La loro arroganza mi cola nella mente come sudore pungente. Bevevano e cantavano, vantandosi dei tempi a venire.",shape=box,color=blue];
		j3572424346 -> j93182501;
	j93182501 [label="Si sarebbero fatti un nome. Avrebbero elevato le loro famiglie all'onore.",shape=box,color=blue];
		j93182501 -> j814142379;
	j814142379 [label="Molti di loro caddero. Nemmeno i loro corpi furono restituiti.",shape=box,color=blue];
		j814142379 -> j2046953484;
	j2046953484 [label="Per impedire al nemico di carpire i nostri segreti, vennero sottoposti a scariche Kuva in modo che si liquefacessero dopo la morte.",shape=box,color=blue];
		j2046953484 -> j3873348046;
	j3873348046 [label="La speranza di una generazione trasformata in una pozzanghera oleosa, spazzata via dagli stivali Grineer.",shape=box,color=blue];
		j3873348046 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}