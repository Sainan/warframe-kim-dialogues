	"Chat ends." [color=orange];
	j3782500016 [label="MV: TRADIMENTO",shape=box,color=blue];
		j3782500016 -> j982572696;
	j982572696 [label="Trascrizione: 'Pace?'",shape=box,color=blue];
		j982572696 -> j3156971926;
	j3156971926 [label="La sua voce era come un vetro rotto che mi strideva nelle orecchie.",shape=box,color=blue];
		j3156971926 -> j291599988;
	j291599988 [label="L'Esecutrice Nitokh era contrariata. Si aspettava una gloriosa escalation, battaglia dopo battaglia, che si sarebbe conclusa con l'estasi culminante della disfatta degli Orokin.",shape=box,color=blue];
		j291599988 -> j2419549416;
	j2419549416 [label="Dopo di che sarebbe emersa dal nascondiglio e… beh, qui non mi resta che fare delle ipotesi. Forse si aspettava di essere invitata a entrare nella confidenza dei Sentient.",shape=box,color=blue];
		j2419549416 -> j3131167782;
	j3131167782 [label="O forse pensava che avrebbero abbandonato i resti bruciati e inquinati del Sistema Origin e l'avrebbero lasciata a fondare un nuovo regno tutto suo.",shape=box,color=blue];
		j3131167782 -> j4037060212;
	j4037060212 [label="Comunue, la pace non sarebbe stata tollerata. Così ci siamo messi all'opera per indebolirla.",shape=box,color=blue];
		j4037060212 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}