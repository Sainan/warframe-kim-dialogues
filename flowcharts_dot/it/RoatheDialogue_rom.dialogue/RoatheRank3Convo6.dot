		j3361283050 -> j1551216802 [label="false",color=purple];
	j1814782719 [label="Mi chiedo, è questo che mi hai sottratto, Usurpatore? Che eravamo amanti che ti ho confessato il mio amore e tu non hai provato lo stesso?",shape=box,color=blue];
		j1814782719 -> j1145215865;
	j1075133384 [label="Qualunque sia la pessima opinione che ti sei fatto di me, me la merito. E non sei certo il solo ad averla. Non sei per niente il solo.",shape=box,color=blue];
		j1075133384 -> "Chat ends.";
	j2459115059 [label="Davvero tragico... vorrei quasi conoscere i dettagli, ma ho la sensazione che ciò equivalga a saltare alla fine del libro prima di esserne pronti.",shape=box,color=blue];
		j2459115059 -> j3467714462;
	j541849290 [label="Ma chi voglio prendere in giro?! Sappiamo perché l'hai fatto, vero? E non è stato per amore mio. Ma per amore di un altro. Sto semplicemente diventando poetico.",shape=box,color=blue];
		j541849290 -> j3467714462;
	j3752214194 [label="Ma chi voglio prendere in giro?! Sappiamo perché l'hai fatto, vero? E non è stato per amore mio. Non è stato nemmeno per amore. Sto semplicemente diventando poetico.",shape=box,color=blue];
		j3752214194 -> j3467714462;
	j1551216802 [label="Bah. Ma che senso ha starsene lì a fare poesia?",shape=box,color=blue];
		j1551216802 -> j3467714462;
	j3467714462 [label="Ma non sono qui per la tua compassione e la tua pietà. Tutto questo è opera mia. Qualunque sia la pessima opinione che ti sei fatto di me, me la merito. E non sei certo il solo ad averla. ",shape=box,color=blue];
		j3467714462 -> j3128553909;
