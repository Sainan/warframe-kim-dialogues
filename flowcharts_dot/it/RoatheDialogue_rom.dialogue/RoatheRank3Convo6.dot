digraph {
	2049 [label="RoatheRank3Convo6 begins.",color=orange];
		2049 -> 2052;
		2049 -> 2050;
		2049 -> 2051;
	2052 [label="Perché passi così tanto tempo con i Cavia, Roathe?",shape=box,color=red];
		2052 -> 2055;
	2050 [label="Stai lontano dai Cavia, Roathe. Mi rende nervoso.",shape=box,color=red];
		2050 -> 2053;
	2051 [label="[Fine.]",shape=box,color=red];
		2051 -> 2054;
	2055 [label="Mh? Beh, le trovo tra le creazioni più inequivocabilmente tristi e patetiche che abbia mai incontrato in tutto il Sistema Origin maledetto dal Void. ",shape=box,color=blue];
		2055 -> 2057;
	2053 [label="Per evitare il minor numero possibile di malintesi in questa situazione, eviterò la mia solita verbosità e dirò semplicemente questo: ",shape=box,color=blue];
		2053 -> 2056;
	2054 [label="Chat ends.",color=orange];
	2057 [label="Animali da laboratorio. Animali da laboratorio, Albrecht! Hai gettato gli animali nel maledetto Void e poi, quando sono usciti blaterando nel tuo linguaggio infantile inventato, hai detto al tuo maggiordomo di sopprimerli?!",shape=box,color=blue];
		2057 -> 2059;
	2056 [label="No.",shape=box,color=blue];
		2056 -> 2058;
	2059 [label="Lascia sempre che siano gli altri a fare il lavoro sporco. Ma sto divagando. Mi stai chiedendo perché mi siedo e parlo con loro. Soprattuto con l'uccello. Semplice. Ma vorrei che tu indovinassi. Vorrei vedere se riesci a capirlo.",shape=box,color=blue];
		2059 -> 2060;
		2059 -> 2061;
		2059 -> 2062;
		2059 -> 2063;
		2059 -> 2064;
	2058 [label="Chat ends.",color=orange];
	2060 [label="Lui non sa chi sei.",shape=box,color=red];
		2060 -> 2065;
	2061 [label="Bird 3 ama tutti.",shape=box,color=red];
		2061 -> 2066;
	2062 [label="Ti piace circondarti di persone che ti fanno sentire intelligente.",shape=box,color=red];
		2062 -> 2067;
	2063 [label="Ha uno spiccato senso dell'osservazione sulle persone che lo circondano.",shape=box,color=red];
		2063 -> 2068;
	2064 [label="È facile da manipolare.",shape=box,color=red];
		2064 -> 2069;
	2065 [label="Sì. In un certo senso, è proprio questo il punto. Lui non sa chi sono. Non sa nulla del \"Diavolo di Tau\". E... per di più, non gliene importa.",shape=box,color=blue];
		2065 -> 2070;
	2066 [label="Lo fa. È piuttosto affascinante nella sua stupida innocenza. Ma quello che stai dicendo, in un modo un po' più gentile e contorto, è che nessun altro potrebbe amarmi, è così?",shape=box,color=blue];
		2066 -> 2071;
	2067 [label="Vorrei che tu capissi quanto tu sia fuorviato. Quanto sia lontana la tua freccia dal bersaglio... ma non sei il solo ad avere questa opinione su di me.",shape=box,color=blue];
		2067 -> 2072;
	2068 [label="Ce l'ha. E le sue osservazioni sono molto utili, ma niente che non avrei potuto ottenere io stesso nel giro di pochi istanti.",shape=box,color=blue];
		2068 -> 2073;
	2069 [label="Vorrei che tu capissi quanto tu sia fuorviato. Quanto sia lontana la tua freccia dal bersaglio... ma non sei il solo ad avere questa opinione su di me.",shape=box,color=blue];
		2069 -> 2074;
	2070 [label="+10 Chemistry",color=orange];
		2070 -> 2075;
	2071 [label="Quindi devo affidarmi a quell'uccello idiota per farmi compagnia? Ma sei abbastanza vicino alla verità, suppongo che ti darò... una sufficienza.",shape=box,color=blue];
		2071 -> 2075;
	2072 [label="Non sei per niente il solo.",shape=box,color=blue];
		2072 -> 2076;
	2073 [label="Ciò che stai dicendo in modo un po' più gentile e contorto è che credi che io stia usando il grande uccello parlante per i miei fini? È così?",shape=box,color=blue];
		2073 -> 2077;
	2074 [label="Non sei per niente il solo.",shape=box,color=blue];
		2074 -> 2078;
	2075 [label="Per lui, non sono Roathe. Non sono Orokin. Non sono un criminale. Un traditore. Un codardo. Posso semplicemente essere... me stesso.",shape=box,color=blue];
		2075 -> 2079;
	2076 [label="Update boolean RoatheAlone1",color=orange];
		2076 -> 2080;
	2077 [label="No. Ma non sei il solo ad avere questa opinione di me. Non sei per niente il solo.",shape=box,color=blue];
		2077 -> 2078;
	2078 [label="Update boolean RoatheAlone1",color=orange];
		2078 -> 2081;
	2079 [label="Non credo di poterti descrivere quando sia semplice e raro questo sollievo...",shape=box,color=blue];
		2079 -> 2082;
		2079 -> 2083;
		2079 -> 2084;
	2080 [label="+5 Chemistry",color=orange];
		2080 -> 2085;
	2081 [label="+5 Chemistry",color=orange];
		2081 -> 2086;
	2082 [label="Puoi lasciare andare tutto sai? Puoi cambiare. Anche qui, anche ora.",shape=box,color=red];
		2082 -> 2087;
	2083 [label="Deve essere un peso enorme. Gestire le aspettative sulla tua reputazione ovunque tu vada persino qui.",shape=box,color=red];
		2083 -> 2088;
	2084 [label="Stai insinuando che il resto sia una specie di spettacolo che hai messo in scena?",shape=box,color=red];
		2084 -> 2089;
	2085 [label="Chat ends.",color=orange];
	2086 [label="Chat ends.",color=orange];
	2087 [label="Add 2 to Thermostat",color=orange];
		2087 -> 2090;
	2088 [label="Add -1 to Thermostat",color=orange];
		2088 -> 2091;
	2089 [label="Fosse così semplice, e tutto questo fosse una grande facciata che potrei cambiare come un volto mascherato! No, Usurpatore. Questo è ciò che sono, con ogni mio osso marcio.",shape=box,color=blue];
		2089 -> 2092;
	2090 [label="Fosse così semplice, Usurpatore. Lo fai sembrare tutto così allettante. Posso? Forse... Forse non è troppo tardi, nemmeno per un diavolo triste e tragico come me.",shape=box,color=blue];
		2090 -> 2093;
	2091 [label="+10 Chemistry",color=orange];
		2091 -> 2094;
	2092 [label="Ma questo non significa che non mi faccia piacere avere l'opportunità di mettere da parte tutto per un'ora e godermi semplicemente una conversazione con qualcuno che non è minimamente a conoscenza di tutti i terribili crimini che ho commesso nella mia vita.",shape=box,color=blue];
		2092 -> 2095;
	2093 [label="+10 Chemistry",color=orange];
		2093 -> 2096;
	2094 [label="È estenuante, Usurpatore. E vorrei tanto poter abbandonare la mia identità come un'immagine mascherata e non riprenderla mai più. Ma questo è ciò che sono, con ogni mio osso marcio.",shape=box,color=blue];
		2094 -> 2092;
	2095 [label="Update boolean RoatheBirdThree",color=orange];
		2095 -> 2097;
		2095 -> 2098;
	2096 [label="È solo una facciata? O è radicata nel profondo del mio essere? Non lo so ancora. Tutto quello che posso dire è che continua a piacermi l'opportunità di mettere da parte tutto per un'ora, quando posso.",shape=box,color=blue];
		2096 -> 2099;
	2097 [label="Scusa se posso sembrare scortese, ma... la tua vita sembra essere stata solitaria.",shape=box,color=red];
		2097 -> 2100;
	2098 [label="Non sei abituato ad avere molti amici, vero?",shape=box,color=red];
		2098 -> 2101;
	2099 [label="Mi libero dal peso e mi siedo con qualcuno che non è minimamente a conoscienza dei miei terribili crimini, parlo con quel gigantesco uccello affascinante e stupido e mi ritrovo... in pace. Per la prima volta da molto tempo.",shape=box,color=blue];
		2099 -> 2102;
	2100 [label="Evaluate expressions",color=orange];
		2100 -> 2106 [label="RoatheUnloved1, RoatheKnowsReset2",color=purple];
		2100 -> 2105 [label="RoatheKnowsReset2",color=purple];
		2100 -> 2104 [label="RoatheUnloved1",color=purple];
		2100 -> 2103 [label="false",color=purple];
	2101 [label="Check boolean RoatheKnowsReset2",color=orange];
		2101 -> 2108 [label=true,color=green];
		2101 -> 2107 [label=false,color=brown];
	2102 [label="Forse c'è speranza in quello che dici. O forse mi sto solo illudendo. Ed è solo un attimo di tregua.",shape=box,color=blue];
		2102 -> 2109;
	2106 [label="Sì, lo è stata. O almeno, per quel che riesco a ricordare. O è questo che mi hai sottratto, Usurpatore? Che eravamo amanti, che ti ho confessato il mio amore e tu non hai provato lo stesso?",shape=box,color=blue];
		2106 -> 2113;
	2105 [label="Lo ammetto, lo è stata. Almeno per quel che riesco a ricordare. Ti sorprenderebbe sapere che non mi sono mai innamorato? Non reciprocamente, almeno. Forse no. Dopotutto, probabilmente abbiamo già vissuto tutto.",shape=box,color=blue];
		2105 -> 2112;
	2104 [label="È stata così. Lunga e solitaria. Ma è tutta colpa mia, Usurpatore. Non sono qui per la tua compassione o la tua pietà.",shape=box,color=blue];
		2104 -> 2111;
	2103 [label="Lo ammetto, lo è stata. Almeno per quel che riesco a ricordare. Ti sorprenderebbe sapere che non mi sono mai innamorato? Ma è tutta colpa mia, Usurpatore. Non sono qui per la tua compassione o la tua pietà.",shape=box,color=blue];
		2103 -> 2110;
	2108 [label="Chissà? Forse avevo degli amici e semplicemente non riesco a ricordarli perché tu ed io eravamo amici prima che tu mettessi fine a tutto questo, mh?",shape=box,color=blue];
		2108 -> 2114;
	2107 [label="Chissà? Forse avevo degli amici e semplicemente non riesco a ricordarli perché Entrati mi ha confuso la testa e me ne ha portato via i ricordi.",shape=box,color=blue];
		2107 -> 2114;
	2109 [label="Update boolean RoatheBirdThree",color=orange];
		2109 -> 2097;
		2109 -> 2098;
	2113 [label="O era il contrario? Ti sei innamorato follemente del Diavolo in persona, ma il suo cuore è rimasto freddo nei tuoi confronti. Sconvolto, hai fatto l'unica cosa che potevi--gli hai fatto a pezzi la mente!",shape=box,color=blue];
		2113 -> 2118;
	2112 [label="Update boolean RoatheUnloved1",color=orange];
		2112 -> 2117;
	2111 [label="Update boolean RoatheAlone1",color=orange];
		2111 -> 2116;
	2110 [label="Update boolean RoatheUnloved1",color=orange];
		2110 -> 2115;
	2114 [label="Per tutto il bene che sembra avermi fatto.",shape=box,color=blue];
		2114 -> 2119;
	2118 [label="Evaluate expressions",color=orange];
		2118 -> 2124 [label="RoatheDatingDeal",color=purple];
		2118 -> 2123 [label="RoatheMarieDatingDeal",color=purple];
		2118 -> 2123 [label="RoatheLyonDatingDeal",color=purple];
		2118 -> 2122 [label="RoatheSerumDeal",color=purple];
		2118 -> 2122 [label="RoatheFamilyDeal",color=purple];
		2118 -> 2122 [label="RoatheMarieEntratiDeal",color=purple];
		2118 -> 2122 [label="RoatheLyonConfessionDeal",color=purple];
		2118 -> 2124 [label="RoatheDatingDealNo",color=purple];
		2118 -> 2123 [label="RoatheMarieDatingDealNo",color=purple];
		2118 -> 2123 [label="RoatheLyonDatingDealNo",color=purple];
		2118 -> 2122 [label="RoatheSerumDealNo",color=purple];
		2118 -> 2122 [label="RoatheFamilyDealNo",color=purple];
		2118 -> 2122 [label="RoatheMarieEntratiDealNo",color=purple];
		2118 -> 2122 [label="RoatheLyonConfessionDealNo",color=purple];
		2118 -> 2121 [label="false",color=purple];
	2117 [label="Mi chiedo, è questo che mi hai sottratto, Usurpatore? Che eravamo amanti che ti ho confessato il mio amore e tu non hai provato lo stesso?",shape=box,color=blue];
		2117 -> 2113;
	2116 [label="Qualunque sia la pessima opinione che ti sei fatto di me, me la merito. E non sei certo il solo ad averla. Non sei per niente il solo.",shape=box,color=blue];
		2116 -> 2120;
	2115 [label="Update boolean RoatheAlone1",color=orange];
		2115 -> 2116;
	2119 [label="Chat ends.",color=orange];
	2124 [label="Davvero tragico... vorrei quasi conoscere i dettagli, ma ho la sensazione che ciò equivalga a saltare alla fine del libro prima di esserne pronti.",shape=box,color=blue];
		2124 -> 2125;
	2123 [label="Ma chi voglio prendere in giro?! Sappiamo perché l'hai fatto, vero? E non è stato per amore mio. Ma per amore di un altro. Sto semplicemente diventando poetico.",shape=box,color=blue];
		2123 -> 2125;
	2122 [label="Ma chi voglio prendere in giro?! Sappiamo perché l'hai fatto, vero? E non è stato per amore mio. Non è stato nemmeno per amore. Sto semplicemente diventando poetico.",shape=box,color=blue];
		2122 -> 2125;
	2121 [label="Bah. Ma che senso ha starsene lì a fare poesia?",shape=box,color=blue];
		2121 -> 2125;
	2120 [label="Chat ends.",color=orange];
	2125 [label="Ma non sono qui per la tua compassione e la tua pietà. Tutto questo è opera mia. Qualunque sia la pessima opinione che ti sei fatto di me, me la merito. E non sei certo il solo ad averla. ",shape=box,color=blue];
		2125 -> 2126;
	2126 [label="Update boolean RoatheAlone1",color=orange];
		2126 -> 2127;
	2127 [label="Non sei per niente il solo.",shape=box,color=blue];
		2127 -> 2128;
	2128 [label="Chat ends.",color=orange];
}