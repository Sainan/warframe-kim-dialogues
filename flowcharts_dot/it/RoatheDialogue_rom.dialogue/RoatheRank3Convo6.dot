	j3048828936 [label="Perché passi così tanto tempo con i Cavia, Roathe?",shape=box,color=red];
		j3048828936 -> j932121958;
	j1655574652 [label="Stai lontano dai Cavia, Roathe. Mi rende nervoso.",shape=box,color=red];
		j1655574652 -> j8612719;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j932121958 [label="Mh? Beh, le trovo tra le creazioni più inequivocabilmente tristi e patetiche che abbia mai incontrato in tutto il Sistema Origin maledetto dal Void. ",shape=box,color=blue];
		j932121958 -> j1379233452;
	j8612719 [label="Per evitare il minor numero possibile di malintesi in questa situazione, eviterò la mia solita verbosità e dirò semplicemente questo: ",shape=box,color=blue];
		j8612719 -> j532529743;
	"Chat ends." [color=orange];
	j1379233452 [label="Animali da laboratorio. Animali da laboratorio, Albrecht! Hai gettato gli animali nel maledetto Void e poi, quando sono usciti blaterando nel tuo linguaggio infantile inventato, hai detto al tuo maggiordomo di sopprimerli?!",shape=box,color=blue];
		j1379233452 -> j1809530187;
	j532529743 [label="No.",shape=box,color=blue];
		j532529743 -> "Chat ends.";
	j1809530187 [label="Lascia sempre che siano gli altri a fare il lavoro sporco. Ma sto divagando. Mi stai chiedendo perché mi siedo e parlo con loro. Soprattuto con l'uccello. Semplice. Ma vorrei che tu indovinassi. Vorrei vedere se riesci a capirlo.",shape=box,color=blue];
		j1809530187 -> j1646737895;
		j1809530187 -> j2829846056;
		j1809530187 -> j1451771355;
		j1809530187 -> j4030225080;
		j1809530187 -> j688580098;
	j1646737895 [label="Lui non sa chi sei.",shape=box,color=red];
		j1646737895 -> j673491031;
	j2829846056 [label="Bird 3 ama tutti.",shape=box,color=red];
		j2829846056 -> j4030758432;
	j1451771355 [label="Ti piace circondarti di persone che ti fanno sentire intelligente.",shape=box,color=red];
		j1451771355 -> j3468924198;
	j4030225080 [label="Ha uno spiccato senso dell'osservazione sulle persone che lo circondano.",shape=box,color=red];
		j4030225080 -> j2994111979;
	j688580098 [label="È facile da manipolare.",shape=box,color=red];
		j688580098 -> j3468924198;
	j673491031 [label="Sì. In un certo senso, è proprio questo il punto. Lui non sa chi sono. Non sa nulla del \"Diavolo di Tau\". E... per di più, non gliene importa.",shape=box,color=blue];
		j673491031 -> j574047718;
	j4030758432 [label="Lo fa. È piuttosto affascinante nella sua stupida innocenza. Ma quello che stai dicendo, in un modo un po' più gentile e contorto, è che nessun altro potrebbe amarmi, è così?",shape=box,color=blue];
		j4030758432 -> j268714216;
	j3468924198 [label="Vorrei che tu capissi quanto tu sia fuorviato. Quanto sia lontana la tua freccia dal bersaglio... ma non sei il solo ad avere questa opinione su di me.",shape=box,color=blue];
		j3468924198 -> j2720462002;
	j2994111979 [label="Ce l'ha. E le sue osservazioni sono molto utili, ma niente che non avrei potuto ottenere io stesso nel giro di pochi istanti.",shape=box,color=blue];
		j2994111979 -> j828509582;
	j574047718 [label="+10 Chemistry",color=orange];
		j574047718 -> j496817261;
	j268714216 [label="Quindi devo affidarmi a quell'uccello idiota per farmi compagnia? Ma sei abbastanza vicino alla verità, suppongo che ti darò... una sufficienza.",shape=box,color=blue];
		j268714216 -> j496817261;
	j2720462002 [label="Non sei per niente il solo.",shape=box,color=blue];
		j2720462002 -> j3705997063;
	j828509582 [label="Ciò che stai dicendo in modo un po' più gentile e contorto è che credi che io stia usando il grande uccello parlante per i miei fini? È così?",shape=box,color=blue];
		j828509582 -> j1412192731;
	j496817261 [label="Per lui, non sono Roathe. Non sono Orokin. Non sono un criminale. Un traditore. Un codardo. Posso semplicemente essere... me stesso.",shape=box,color=blue];
		j496817261 -> j597135287;
	j3705997063 [label="Boolean RoatheAlone1 is now true.",color=orange];
		j3705997063 -> j4081414586;
	j1412192731 [label="No. Ma non sei il solo ad avere questa opinione di me. Non sei per niente il solo.",shape=box,color=blue];
		j1412192731 -> j3705997063;
	j597135287 [label="Non credo di poterti descrivere quando sia semplice e raro questo sollievo...",shape=box,color=blue];
		j597135287 -> j1772832637;
		j597135287 -> j329188547;
		j597135287 -> j699154662;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j1772832637 [label="Puoi lasciare andare tutto sai? Puoi cambiare. Anche qui, anche ora.",shape=box,color=red];
		j1772832637 -> j466361440;
	j329188547 [label="Deve essere un peso enorme. Gestire le aspettative sulla tua reputazione ovunque tu vada persino qui.",shape=box,color=red];
		j329188547 -> j382482576;
	j699154662 [label="Stai insinuando che il resto sia una specie di spettacolo che hai messo in scena?",shape=box,color=red];
		j699154662 -> j4277317668;
	j466361440 [label="Add 2 to Thermostat counter",color=orange];
		j466361440 -> j2998404983;
	j382482576 [label="Add -1 to Thermostat counter",color=orange];
		j382482576 -> j2669401021;
	j4277317668 [label="Fosse così semplice, e tutto questo fosse una grande facciata che potrei cambiare come un volto mascherato! No, Usurpatore. Questo è ciò che sono, con ogni mio osso marcio.",shape=box,color=blue];
		j4277317668 -> j2599436256;
	j2998404983 [label="Fosse così semplice, Usurpatore. Lo fai sembrare tutto così allettante. Posso? Forse... Forse non è troppo tardi, nemmeno per un diavolo triste e tragico come me.",shape=box,color=blue];
		j2998404983 -> j2488163419;
	j2669401021 [label="+10 Chemistry",color=orange];
		j2669401021 -> j1160644898;
	j2599436256 [label="Ma questo non significa che non mi faccia piacere avere l'opportunità di mettere da parte tutto per un'ora e godermi semplicemente una conversazione con qualcuno che non è minimamente a conoscenza di tutti i terribili crimini che ho commesso nella mia vita.",shape=box,color=blue];
		j2599436256 -> j172570375;
	j2488163419 [label="+10 Chemistry",color=orange];
		j2488163419 -> j2190899470;
	j1160644898 [label="È estenuante, Usurpatore. E vorrei tanto poter abbandonare la mia identità come un'immagine mascherata e non riprenderla mai più. Ma questo è ciò che sono, con ogni mio osso marcio.",shape=box,color=blue];
		j1160644898 -> j2599436256;
	j172570375 [label="Boolean RoatheBirdThree is now true.",color=orange];
		j172570375 -> j2977794886;
		j172570375 -> j2627592850;
	j2190899470 [label="È solo una facciata? O è radicata nel profondo del mio essere? Non lo so ancora. Tutto quello che posso dire è che continua a piacermi l'opportunità di mettere da parte tutto per un'ora, quando posso.",shape=box,color=blue];
		j2190899470 -> j4177368092;
	j2977794886 [label="Scusa se posso sembrare scortese, ma... la tua vita sembra essere stata solitaria.",shape=box,color=red];
		j2977794886 -> j2902082429;
	j2627592850 [label="Non sei abituato ad avere molti amici, vero?",shape=box,color=red];
		j2627592850 -> j2539663690;
	j4177368092 [label="Mi libero dal peso e mi siedo con qualcuno che non è minimamente a conoscienza dei miei terribili crimini, parlo con quel gigantesco uccello affascinante e stupido e mi ritrovo... in pace. Per la prima volta da molto tempo.",shape=box,color=blue];
		j4177368092 -> j3280257616;
	j2902082429 [label="Evaluate expressions",color=orange];
		j2902082429 -> j3386830520 [label="RoatheUnloved1, RoatheKnowsReset2",color=purple];
		j2902082429 -> j1878935356 [label="RoatheKnowsReset2",color=purple];
		j2902082429 -> j4259148986 [label="RoatheUnloved1",color=purple];
		j2902082429 -> j1021993782 [label="false",color=purple];
	j2539663690 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2539663690 -> j1198833493 [label=true,color=green];
		j2539663690 -> j1811720088 [label=false,color=brown];
	j3280257616 [label="Forse c'è speranza in quello che dici. O forse mi sto solo illudendo. Ed è solo un attimo di tregua.",shape=box,color=blue];
		j3280257616 -> j172570375;
	j3386830520 [label="Sì, lo è stata. O almeno, per quel che riesco a ricordare. O è questo che mi hai sottratto, Usurpatore? Che eravamo amanti, che ti ho confessato il mio amore e tu non hai provato lo stesso?",shape=box,color=blue];
		j3386830520 -> j1145215865;
	j1878935356 [label="Lo ammetto, lo è stata. Almeno per quel che riesco a ricordare. Ti sorprenderebbe sapere che non mi sono mai innamorato? Non reciprocamente, almeno. Forse no. Dopotutto, probabilmente abbiamo già vissuto tutto.",shape=box,color=blue];
		j1878935356 -> j2335856836;
	j4259148986 [label="È stata così. Lunga e solitaria. Ma è tutta colpa mia, Usurpatore. Non sono qui per la tua compassione o la tua pietà.",shape=box,color=blue];
		j4259148986 -> j4047978206;
	j1021993782 [label="Lo ammetto, lo è stata. Almeno per quel che riesco a ricordare. Ti sorprenderebbe sapere che non mi sono mai innamorato? Ma è tutta colpa mia, Usurpatore. Non sono qui per la tua compassione o la tua pietà.",shape=box,color=blue];
		j1021993782 -> j1029947569;
	j1198833493 [label="Chissà? Forse avevo degli amici e semplicemente non riesco a ricordarli perché tu ed io eravamo amici prima che tu mettessi fine a tutto questo, mh?",shape=box,color=blue];
		j1198833493 -> j142946414;
	j1811720088 [label="Chissà? Forse avevo degli amici e semplicemente non riesco a ricordarli perché Entrati mi ha confuso la testa e me ne ha portato via i ricordi.",shape=box,color=blue];
		j1811720088 -> j142946414;
	j1145215865 [label="O era il contrario? Ti sei innamorato follemente del Diavolo in persona, ma il suo cuore è rimasto freddo nei tuoi confronti. Sconvolto, hai fatto l'unica cosa che potevi--gli hai fatto a pezzi la mente!",shape=box,color=blue];
		j1145215865 -> j3361283050;
	j2335856836 [label="Boolean RoatheUnloved1 is now true.",color=orange];
		j2335856836 -> j1814782719;
	j4047978206 [label="Boolean RoatheAlone1 is now true.",color=orange];
		j4047978206 -> j1075133384;
	j1029947569 [label="Boolean RoatheUnloved1 is now true.",color=orange];
		j1029947569 -> j4047978206;
	j142946414 [label="Per tutto il bene che sembra avermi fatto.",shape=box,color=blue];
