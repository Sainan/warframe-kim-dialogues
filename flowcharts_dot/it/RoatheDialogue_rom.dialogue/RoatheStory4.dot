	j3544578453 [label="MV: ARROGANZA",shape=box,color=blue];
		j3544578453 -> j2663686242;
	j2663686242 [label="Trascrizione: Non ci aspettavamo di perdere. ",shape=box,color=blue];
		j2663686242 -> j2646458303;
	j2646458303 [label="Dopo il primo attacco esplorativo dei Sentient, avevamo preparato una controffensiva punitiva.",shape=box,color=blue];
		j2646458303 -> j972258679;
	j972258679 [label="L'Incantatrice Gilderglass emerse dalla nebbia di Cerere su ali letali, un galeone carico di droni e myrmidon con corazze d'argento.",shape=box,color=blue];
		j972258679 -> j4144202934;
	j4144202934 [label="Circuiti sottili come la nebbia, formavano un delicato pizzo sotto le loro placche traslucide. ",shape=box,color=blue];
		j4144202934 -> j126622671;
	j126622671 [label="Era così grande che ci stava a malapena dentro i bordi della Rotaia Solare.",shape=box,color=blue];
		j126622671 -> j1833461389;
	j1833461389 [label="I Sentient si assicurarono che vedessimo l'esito. Cantarono, e la nostra tecnologia fallì. I nostri guerrieri hanno lottato e soffocato nelle loro tute scintillanti.",shape=box,color=blue];
		j1833461389 -> j3673772211;
	j3673772211 [label="L'equipaggio dell'Incantatrice Gilderglass arrostiva vivo mentre la nave si tuffava a cigno senza motore nei cieli di Tau, un fuoco d'artificio complesso e costoso.",shape=box,color=blue];
		j3673772211 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
