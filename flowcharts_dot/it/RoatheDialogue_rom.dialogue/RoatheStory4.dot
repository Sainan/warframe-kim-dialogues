	j707364422 [label="MV: ARROGANZA",shape=box,color=blue];
		j707364422 -> j3303554398;
	j3303554398 [label="Trascrizione: Non ci aspettavamo di perdere. ",shape=box,color=blue];
		j3303554398 -> j990566413;
	j990566413 [label="Dopo il primo attacco esplorativo dei Sentient, avevamo preparato una controffensiva punitiva.",shape=box,color=blue];
		j990566413 -> j413614893;
	j413614893 [label="L'Incantatrice Gilderglass emerse dalla nebbia di Cerere su ali letali, un galeone carico di droni e myrmidon con corazze d'argento.",shape=box,color=blue];
		j413614893 -> j3068275633;
	j3068275633 [label="Circuiti, sottili come la nebbia, formavano un delicato pizzo sotto le loro placche traslucide. ",shape=box,color=blue];
		j3068275633 -> j3781008954;
	j3781008954 [label="Era così grande che ci stava a malapena dentro i bordi della Rotaia Solare.",shape=box,color=blue];
		j3781008954 -> j537861269;
	j537861269 [label="I Sentient si assicurarono che vedessimo l'esito. Cantarono, e la nostra tecnologia ha fallì. I nostri guerrieri hanno lottato e soffocato nelle loro tute scintillanti.",shape=box,color=blue];
		j537861269 -> j3673772211;
	j3673772211 [label="L'equipaggio dell'Incantatrice Gilderglass arrostiva vivo mentre la nave si tuffava a cigno senza motore nei cieli di Tau, un fuoco d'artificio complesso e costoso.",shape=box,color=blue];
		j3673772211 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}