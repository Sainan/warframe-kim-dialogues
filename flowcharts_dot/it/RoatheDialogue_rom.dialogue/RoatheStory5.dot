	j94206943 [label="MV: INVENZIONE",shape=box,color=blue];
		j94206943 -> j301025484;
	j301025484 [label="Trascrizione: Ora, ricordo che gli sviluppi dell'Archimedeo marziale furono, all'inizio, presentati come intrattenimento. ",shape=box,color=blue];
		j301025484 -> j4001938896;
	j4001938896 [label="Come dei libertini debosciati che guardavano i criminali giustiziati in un'arena-circo.",shape=box,color=blue];
		j4001938896 -> j3118532130;
	j3118532130 [label=" Immaginavamo di escogitare modi nuovi e stuzzicanti per eliminare un nemico di gran lunga inferiore.",shape=box,color=blue];
		j3118532130 -> j945162438;
	j945162438 [label="Come ci lusingavamo! In realtà, innovavamo disperatamente, sapendo di essere surclassati dai nostri nemici proteiformi.",shape=box,color=blue];
		j945162438 -> j3317536299;
	j3317536299 [label="Ci trafiggevano come creature brulicanti che divorano la loro madre gonfia.",shape=box,color=blue];
		j3317536299 -> j1220335945;
	j1220335945 [label="Disidratati, schiacciati tra le pagine del tempo, eravamo semplicemente stati superati nell'evoluzione.",shape=box,color=blue];
		j1220335945 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
