	5705 [label="Lo stormo di piccoli e malvagi droni che avevamo inviato tornò indietro volando allegramente ancora carico di bombe, ridacchiando in sillabe sconosciute, esplodendo in mezzo alle stesse navi madre che li avevano inviati.",shape=box,color=blue];
