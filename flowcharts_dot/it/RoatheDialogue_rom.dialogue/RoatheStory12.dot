	j1261944249 [label="MV: FUOCO",shape=box,color=blue];
		j1261944249 -> j1663088688;
	j1663088688 [label="Trascrizione: Mostruosità ed eccessi ci avevano servito egregiamente in passato. Ci si aspettava che li applicassi come tattiche di guerra.",shape=box,color=blue];
		j1663088688 -> j2004018268;
	j2004018268 [label="Come avevamo domato l'Infestazione ai tempi dei nostri antenati? Squarciando il cuore dell'atomo come un bocciolo di rosa, ovviamente!",shape=box,color=blue];
		j2004018268 -> j3478163869;
	j3478163869 [label="Come uno solo, i Sette mi ordinarono di diventare un Diavolo con un tridente di testate, un seminatore con radiazioni dilaganti.",shape=box,color=blue];
		j3478163869 -> j3116603383;
	j3116603383 [label="Fu il giorno in cui scoprimmo che i Sentient non solo erano in grado di annullare la nostra tecnologia, ma anche di prenderne il controllo.",shape=box,color=blue];
		j3116603383 -> j2761187320;
	j2761187320 [label="Lo stormo di piccoli e malvagi droni che avevamo inviato tornò indietro volando allegramente ancora carico di bombe, ridacchiando in sillabe sconosciute, esplodendo in mezzo alle stesse navi madre che li avevano inviati.",shape=box,color=blue];
		j2761187320 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
