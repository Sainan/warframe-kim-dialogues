	2239 [label="Come avevamo domato l'Infestazione ai tempi dei nostri antenati? Squarciando il cuore dell'atomo come un bocciolo di rosa, ovviamente!",shape=box,color=blue];
		2239 -> 2236;
	2236 [label="Come uno solo, i Sette mi ordinarono di diventare un Diavolo con un tridente di testate, un seminatore con radiazioni dilaganti.",shape=box,color=blue];
