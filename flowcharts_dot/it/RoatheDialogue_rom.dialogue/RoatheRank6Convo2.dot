	j631673681 [label="Boolean RoatheVillain is now false.",color=orange];
		j631673681 -> "Chat ends.";
	j2853307349 [label="Hai ceduto la tua anima al diavolo in persona perché... lui, senza saperlo, aveva già in mano il tuo cuore spezzato.",shape=box,color=blue];
		j2853307349 -> j1769596192;
	j4203401852 [label="Non che io ne sappia qualcosa sull'argomento.",shape=box,color=blue];
		j4203401852 -> j4081414586;
	j3151646917 [label="Come ben sai, sono un pochino esperto in materia.",shape=box,color=blue];
		j3151646917 -> j4081414586;
	j1769596192 [label="Drifter... il mio povero, dolce, Drifter...",shape=box,color=blue];
		j1769596192 -> j3285228547;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j3285228547 [label="Perdonami. Ti prego, perdonami. Non lo sapevo.",shape=box,color=blue];
		j3285228547 -> j2324062344;
	j2324062344 [label="Devi anche capire che, fino ad ora, il mio amore era una merce che nessuno aveva cercato di riscattare. Non in modo significativo.",shape=box,color=blue];
		j2324062344 -> j2240894675;
	j2240894675 [label="Sembravi disposto a vendere l'anima per un solo pezzo di relitto. Puoi immaginare la mia confusione. Quanto fossi sconcertato.",shape=box,color=blue];
		j2240894675 -> j3906705222;
	j3906705222 [label="Ora? Ora che conosco la verità? Drifter, mio Drifter... non potrei essere più felice che tu l'abbia fatto.",shape=box,color=blue];
		j3906705222 -> j2907313479;
