	j3334739089 [label="Che creatura strana e straordinaria che sei. Deliziosa, ma strana, caro Drifter.",shape=box,color=blue];
		j3334739089 -> j1178863100;
	j3287298793 [label="L'unica cosa più pericolosa di un diavolo... è un diavolo con amici come te che gli devono qualcosa. Ora, se vuoi scusarmi, ho una \"Sorella di Sol\" da infastidire.",shape=box,color=blue];
		j3287298793 -> "Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j2298281118 [label="L'unica cosa più pericolosa di un diavolo... è un diavolo con amici come te che gli devono qualcosa. Ora, se vuoi scusarmi, ho un un prete pazzo da infastidire.",shape=box,color=blue];
		j2298281118 -> "Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j1178863100 [label="Devo chiedertelo però. Perché? Perché fare un patto così scandaloso? Sei così curioso di assaggiare la carne Orokin dopo così tanti secoli?",shape=box,color=blue];
		j1178863100 -> j3857720484;
	j3857720484 [label="Evaluate expressions",color=orange];
		j3857720484 -> j203709188 [label="RoatheUnloved3",color=purple];
		j3857720484 -> j1624672535 [label="RoatheUnloved3",color=purple];
		j3857720484 -> j203709188 [label="RoatheUnloved2",color=purple];
		j3857720484 -> j1624672535 [label="RoatheUnloved2",color=purple];
		j3857720484 -> j2432258348 [label="false",color=purple];
		j3857720484 -> j203709188 [label="false",color=purple];
	j203709188 [label="Mi dispiace sembrare superficiale e volgare, ma... ti sei guardato allo specchio ultimamente?",shape=box,color=red];
		j203709188 -> j500064331;
	j1624672535 [label="Roathe. Forse non ci crederai, ma io... ti amo.",shape=box,color=red];
		j1624672535 -> j2557066778;
	j2432258348 [label="Forse non mi crederai, ma ci tengo a te.",shape=box,color=red];
		j2432258348 -> j886905773;
	j500064331 [label="+10 Chemistry",color=orange];
		j500064331 -> j613551232;
	j2557066778 [label="Scusami?",shape=box,color=blue];
		j2557066778 -> j2434946450;
	j886905773 [label="Sono certo che ci sia un certo grado di sincerità in quello che dici. O almeno, credo che tu non sia consapevole della tua illusione.",shape=box,color=blue];
		j886905773 -> j3332198271;
	j613551232 [label="L'onestà è una cosa meravigliosa, caro Drifter. Credi che ti farei vergognare perché ti diverti? Difficilmente.",shape=box,color=blue];
		j613551232 -> j2205135847;
	j2434946450 [label="No. Stai scherzando vero?",shape=box,color=blue];
		j2434946450 -> j2823033373;
	j3332198271 [label="Credo che il più grande successo dell'Impero Orokin sia stata la sua capacità di convincere coloro che ne facevano parte a credere nelle proprie convinzioni.",shape=box,color=blue];
		j3332198271 -> j2004115048;
	j2205135847 [label="Ecco a voi una relazione di reciproca soddisfazione.",shape=box,color=blue];
		j2205135847 -> j3921499284;
	j2823033373 [label="Ma perché prendere una decisione del genere, a meno che...?",shape=box,color=blue];
		j2823033373 -> j2856356663;
		j2823033373 -> j2694966216;
	j2004115048 [label="In effetti, forse è proprio questo il vero tessuto connettivo della razza umana: la nostra magistrale capacità di guardarci allo specchio e di ingannare noi stessi.",shape=box,color=blue];
		j2004115048 -> j3363873169;
	j3921499284 [label="Boolean RoatheUnloved4 is now true.",color=orange];
		j3921499284 -> j2965571546;
	j2856356663 [label="L'ultima volta ho sbagliato tutto. Non potevo correre di nuovo quel rischio.",shape=box,color=red];
		j2856356663 -> j1866449189;
	j2694966216 [label="Ho fatto questo accordo perché ero disperato e volevo che le cose andassero per il verso giusto. ",shape=box,color=red];
		j2694966216 -> j1866449189;
	j3363873169 [label="Tutto questo per evitare la terribile vergogna di ammettere quando abbiamo bisogno di cambiare.",shape=box,color=blue];
		j3363873169 -> j3699244152;
	j2965571546 [label="Boolean RoatheRedeemed is now false.",color=orange];
		j2965571546 -> j631673681;
	j1866449189 [label="Boolean RoatheLoved is now true.",color=orange];
		j1866449189 -> j2853307349;
	j3699244152 [label="Evaluate expressions",color=orange];
