		2897 -> 2908;
		2897 -> 2909;
	2893 [label="Usurpatore, ho una richiesta difficile da farti. Una richiesta che non mi procura alcun piacere. So che almeno mi desideri, e spero che ci sia un posto per me nel tuo cuore...",shape=box,color=blue];
		2893 -> 2899;
		2893 -> 2900;
		2893 -> 2901;
	2894 [label="Usurpatore, ho una richiesta difficile da farti. Una richiesta che non mi procura alcun piacere. Ma prima, ti chiedo... siamo amici? C'è un posto nel tuo cuore che ha imparato a pensare a me con affetto?",shape=box,color=blue];
		2894 -> 2902;
		2894 -> 2903;
		2894 -> 2904;
	2891 [label="Possiamo smettere di indugiare nella mia mente e di sottoporci tutti a questa flagellazione fittizia, no? (Anche se al prete piacciono cose del genere.)",shape=box,color=blue];
		2891 -> 2898;
	2892 [label="Possiamo smettere di bighellonare nella mia mente e di sottoporci tutti a una flagellazione fittizia, no? (Anche se al prete piacciono cose del genere.)",shape=box,color=blue];
		2892 -> 2898;
	2895 [label="Ora puoi scordartene. Sono certo che hai di meglio da fare nella tua giornata che una flagellazione fittizia, no? (Anche se al prete piacciono cose del genere.)",shape=box,color=blue];
		2895 -> 2905;
	2906 [label="Supereremo anche questo. ",shape=box,color=red];
