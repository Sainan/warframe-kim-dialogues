digraph {
	"RoatheRank3Convo5 begins." [color=orange];
		"RoatheRank3Convo5 begins." -> j3877408164;
	j3877408164 [label="Albrecht è sempre stato un problema fin dall'inizio. Lui e tutta questa storia con il Void. Credo che gli abbiano dato Gerivaine nella speranza che avere una famiglia potesse semplicemente sistemarlo.",shape=box,color=blue];
		j3877408164 -> j254239153;
	j254239153 [label="Penso invece che abbia solo peggiorato le cose. Quando ha avuto dei figli, li considerava come un paio di mani in più. Complici dei suoi folli esperimenti.",shape=box,color=blue];
		j254239153 -> j644137138;
	j644137138 [label="Sacrificabili. Come tutte le cose nella sua vita.",shape=box,color=blue];
		j644137138 -> j1141615159;
		j644137138 -> j3878850611;
		j644137138 -> j4115718638;
	j1141615159 [label="Gerivaine?",shape=box,color=red];
		j1141615159 -> j238186721;
	j3878850611 [label="Per lui le persone non sono semplicemente sacrificabili.",shape=box,color=red];
		j3878850611 -> j797289125;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j238186721 [label="Un nome che potrebbe essere andato perduto negli annali... la moglie di Albrecht Entrati, Usurpatore. La madre dei suoi figli.",shape=box,color=blue];
		j238186721 -> j4103666644;
	j797289125 [label="Benissimo, ammetto che ucciderebbe chiunque e qualsiasi cosa nella sua vita con la freddezza di un qualsiasi Esecutore. Ma non lo farà senza uno scopo.",shape=box,color=blue];
		j797289125 -> j2000446692;
	"Chat ends." [color=orange];
	j4103666644 [label="Check boolean LoidFamilyComplete",color=orange];
		j4103666644 -> j1168881791 [label=true,color=green];
		j4103666644 -> j3199984593 [label=false,color=brown];
	j2000446692 [label="Sai, ora che ci penso, è stata la sua natura distaccata a renderlo così profondamente pericoloso nei nostri tempi. Era capace di sacrificare qualsiasi cosa pur di raggiungere i suoi obiettivi. Qualsiasi cosa.",shape=box,color=blue];
		j2000446692 -> j2061949192;
		j2000446692 -> j2180456000;
	j1168881791 [label="Ma, probabilmente mi stai prendendo di nuovo in giro - dato che è molto probabile che conoscessi già questa informazione, ora che il maggiordomo è tornato in contatto con loro.",shape=box,color=blue];
		j1168881791 -> j1334343465;
	j3199984593 [label="Quelli che siedono ignari della nostra esistenza in questo Sanctum in rovina. Che trovo ancora così inestimabile.",shape=box,color=blue];
		j3199984593 -> j2000446692;
	j2061949192 [label="Immaginavo che gli Orokin non avrebbero avuto problemi a sacrificare ciò a cui tenevano. Sembravate tutti estremamente spietati l'uno con l'altro.",shape=box,color=red];
		j2061949192 -> j2686503317;
	j2180456000 [label="Come lo capisci?",shape=box,color=red];
		j2180456000 -> j1768941770;
	j1334343465 [label="Ma non voglio discutere ancora con te su questo argomento. Non sono dell'umore giusto.",shape=box,color=blue];
		j1334343465 -> j2000446692;
	j2686503317 [label="Sei molto propenso a fare supposizioni su cose di cui non sai nulla, Drifter.",shape=box,color=blue];
		j2686503317 -> j3106560183;
	j1768941770 [label="+10 Chemistry",color=orange];
		j1768941770 -> j1756321022;
	j3106560183 [label="O forse hai una macchia bluastra sulla pelle che mi è sfuggita? Eri un Orokin? Se è così, ti porgo le mie più sentite e sincere scuse! ",shape=box,color=blue];
		j3106560183 -> j2144736152;
		j3106560183 -> j950089654;
	j1756321022 [label="Forse è un luogo comune pensare che noi Orokin non facessimo altro che pugnalarci alle spalle e ucciderci a vicenda. Oddio succedeva, non fraintendermi. Eravamo quasi immortali, non avevamo molto altro da fare.",shape=box,color=blue];
		j1756321022 -> j995691441;
	j2144736152 [label="Mi dispiace. Non volevo offenderti. Sinceramente non ricordo molto della società Orokin - ero un osservatore esterno.",shape=box,color=red];
		j2144736152 -> j2239731039;
	j950089654 [label="Mi dispiace se quello che ricordo della società Orokin non è un granché. Per lo più si trattava di dichiarazioni registrate di ordini a me diretti dal sistema di altoparlanti. Questo è successo prima che rimanessi intrappolato nel Void...",shape=box,color=red];
		j950089654 -> j1770971650;
	j995691441 [label="Ma eravamo anche un popolo profondamente passionale. Nessuno faceva arte nel modo in cui la facevano gli Orokin. Nessuno componeva musica, o faceva teatro, poesia, come noi.",shape=box,color=blue];
		j995691441 -> j3619267752;
	j2239731039 [label="Scusa accettate. Questa volta. Ho già abbastanza a che fare con questo tipo di mancanza di rispetto da tutti qui intorno. Per quando tu sia affascinante, non sono il puntaspilli di tutti. Ho modi migliori per passare il mio tempo.",shape=box,color=blue];
		j2239731039 -> j509419963;
	j1770971650 [label="Boolean RoatheInsulted is now true.",color=orange];
		j1770971650 -> j941003195;
	j3619267752 [label="E nessuno amava così profondamente come noi, quando i nostri cuori si innamoravano di altri.",shape=box,color=blue];
		j3619267752 -> j2397456854;
	j509419963 [label="Dov'ero rimasto? Ah sì. Il nostro impassibile Entrati.",shape=box,color=blue];
		j509419963 -> j1756321022;
	j941003195 [label="Un avvertimento. Ho già abbastanza a che fare con questo tipo di mancanza di rispetto da tutti qui intorno. Per quando tu sia affascinante, non sono il puntaspilli di tutti. Ho modi migliori per passare il mio tempo.",shape=box,color=blue];
		j941003195 -> j509419963;
	j2397456854 [label="Tutti tranne Albrecht. Tutto ciò che ha fatto, tutti coloro con cui interagiva, era come se li vedesse attraverso una sezione della sua amata serigrafia.",shape=box,color=blue];
		j2397456854 -> j1757528097;
	j1757528097 [label="Rimosso. Distaccato. Indifferente. Disinteressato. Anche quando Gerivaine morì e lui si ritrovò a crescere da solo sua figlia.",shape=box,color=blue];
		j1757528097 -> j1969269467;
	j1969269467 [label="Check boolean LoidFamilyComplete",color=orange];
		j1969269467 -> j1721005596 [label=true,color=green];
		j1969269467 -> j1883990979 [label=false,color=brown];
	j1721005596 [label="Che, di diritto, era probabilmente destinata a realizzare molto più di quanto lui avesse mai fatto. Se non fosse diventata infested e inchiodata al suolo. Che spreco.",shape=box,color=blue];
		j1721005596 -> j3307152767;
		j1721005596 -> j3153848048;
	j1883990979 [label="Che, di diritto, era probabilmente destinata a realizzare molto più di quanto lui avesse mai fatto. Non vedo l'ora di vedere cosa ne sarà di lei e del resto della stirpe Entrati. In tutta la loro... gloria Infested.",shape=box,color=blue];
		j1883990979 -> j3365995693;
		j1883990979 -> j1926997920;
	j3307152767 [label="Sono felice che siamo riusciti a convincere Loid a salire di sopra.",shape=box,color=red];
		j3307152767 -> j3128269668;
	j3153848048 [label="So che non ricordi perché l'abbiamo fatto, ma è stata una fortuna che siamo riusciti a far andare Loid di sopra.",shape=box,color=red];
		j3153848048 -> j3767392496;
	j3365995693 [label="Mi chiedo ancora se questa sia l'idea migliore...",shape=box,color=red];
		j3365995693 -> j2643589767;
	j1926997920 [label="Se riusciamo a convincere Loid ad andare di sopra, cosa pensi di fare allora?",shape=box,color=red];
		j1926997920 -> j3732087333;
	j3128269668 [label="Lo dici tu. Eppure io me ne sto qui come un idiota, a sorvegliarli, ad ascoltarli parlare della riunione come se me la ricordassi. Sai quanto è imbarazzante?!",shape=box,color=blue];
		j3128269668 -> j3198864075;
	j3767392496 [label="Sai quanto è imbarazzante dover stare lì e fingere di ricordare che è avvenuta la riunione?! Quando non riesco proprio a ricordarlo?!",shape=box,color=blue];
		j3767392496 -> j3198864075;
	j2643589767 [label="Mm, molto probabilmente no. Ero curioso, hai per caso l'indirizzo di residenza di Albrecht?",shape=box,color=blue];
		j2643589767 -> j4280331823;
	j3732087333 [label="Non ho ancora deciso. Forse inizierò a tagliare loro gli arti e a conservarli in un liquido. Non è che per caso hai l'indirizzo di Albrecht?",shape=box,color=blue];
		j3732087333 -> j3749985457;
	j3198864075 [label="È come essere a un gala quando qualcuno ti si avvicina e sa chiaramente chi sei, ma tu non hai il minimo ricordo di lui e sei costretto a continuare la conversazione come se lo ricordassi!",shape=box,color=blue];
		j3198864075 -> j1716409935;
	j4280331823 [label="No, perché?",shape=box,color=red];
		j4280331823 -> j343984143;
	j3749985457 [label="Cosa?!",shape=box,color=red];
		j3749985457 -> j84262542;
	j1716409935 [label="Hai anche solo la minima consapevolezza del genere di inferno in cui mi hai cacciato?! Nessuna?! È una miseria stare lì in piedi, ed è tutta colpa tua! ",shape=box,color=blue];
		j1716409935 -> j2437871901;
	j343984143 [label="Pensavo che una volta salito di sopra avrei iniziato a tagliare gli arti della sua famiglia e a spedirglieli per posta in barattoli, uno alla volta.",shape=box,color=blue];
		j343984143 -> j3749985457;
	j84262542 [label="+10 Chemistry",color=orange];
		j84262542 -> j2870944631;
	j2437871901 [label="Bah, basta così. Ho bisogno di qualcosa da bere.",shape=box,color=blue];
		j2437871901 -> j1933300832;
	j2870944631 [label="Calmati! Nessuno qui sa stare allo scherzo?",shape=box,color=blue];
		j2870944631 -> j2606531941;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j2606531941 [label="Comunque, chi me li spedirebbe?",shape=box,color=blue];
		j2606531941 -> "Chat ends.";
}