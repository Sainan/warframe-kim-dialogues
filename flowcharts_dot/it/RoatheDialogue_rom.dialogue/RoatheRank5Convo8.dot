		j4125803273 -> j1758133089 [label=true,color=green];
		j4125803273 -> "Chat ends." [label=false,color=brown];
	j1758133089 [label="Evaluate expressions on HellStory counter",color=orange];
		j1758133089 -> j2090736320 [label="x >= 21",color=purple];
		j1758133089 -> "Chat ends." [label="x <= 21",color=purple];
		j1758133089 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j2090736320 [label="Stupido! Cosa hai fatto?! Perché, perché vai a scavare in caverne dove non sei il benvenuto?!",shape=box,color=blue];
		j2090736320 -> j3217640811;
	j3217640811 [label="Ti chiedo di risolvere questo problema. È colpa tua. Lo sento, mi artiglia, mi dilania. Come una bestia immensa.",shape=box,color=blue];
		j3217640811 -> j3088134576;
	j3088134576 [label="Liberami da questo. Liberami da questa piaga. Libera la mia mente da questi ricordi. So che puoi. Utilizza questo dono che hai e poni fine a tutto. Ora.",shape=box,color=blue];
		j3088134576 -> j2390923731;
		j3088134576 -> j568430887;
		j3088134576 -> j919431727;
	j2390923731 [label="Ne sei sicuro? Ma... sei intelligente, ho la sensazione che capirai che c'è qualcosa sotto.",shape=box,color=red];
		j2390923731 -> j3251386114;
	j568430887 [label="Quelli sono un tipo diverso di ricordo, Roathe. Non funzionerà su di loro. Sono sepolti più in profondità nella tua psiche.",shape=box,color=red];
		j568430887 -> j2449588392;
	j919431727 [label="Scappare e nascondersi dalla verità non funzionerà. Finiremo per ritrovarci al punto di partenza. ",shape=box,color=red];
		j919431727 -> j4286401056;
	j3251386114 [label="Molto probabilmente. Farò due più due e ti darò la colpa per aver fatto qualcosa che non ti ho chiesto di fare. Sono sicuro che supererai la tempesta.",shape=box,color=blue];
		j3251386114 -> j1453466216;
	j2449588392 [label="Può darsi. Probabilmente hai ragione. Ma non ho altre opzioni, no? Vale la pena tentare.",shape=box,color=blue];
		j2449588392 -> j1453466216;
	j4286401056 [label="E se così fosse, allora puoi semplicemente ripetere l'atto. È come se avessi un dono inesauribile, no?",shape=box,color=blue];
		j4286401056 -> j1453466216;
	j1453466216 [label="Sono certo che mi arrabbierò terribilmente con te quando mi renderò conto che hai alterato i miei ricordi, ovviamente. E ti consiglio di non dirmi che è stato per mia richiesa, tesoro.",shape=box,color=blue];
		j1453466216 -> j3320347481;
	j3320347481 [label="Mi limiterò a sostenere che stai mentendo e questo probabilmente danneggerà irreparabilmente la mia opinione su di te.",shape=box,color=blue];
		j3320347481 -> j4230265745;
		j3320347481 -> j2882277022;
	j4230265745 [label="No. Non posso farlo. Non lo farò. Dobbiamo affrontare questa situazione insieme. Non possiamo semplicemente parlarne?",shape=box,color=red];
		j4230265745 -> j3105449366;
	j2882277022 [label="Io... non c'è davvero nessun altro modo?",shape=box,color=red];
		j2882277022 -> j3105449366;
	j3105449366 [label="No. Se vuoi che il maggiordomo salga di sopra? Cancellami dalla mente tutte queste sciocchezze come ti ho chiesto. Se non ti interessa? Allora fai come vuoi. A me non importa.",shape=box,color=blue];
		j3105449366 -> j1838741155;
	j1838741155 [label="Questo, e beh, ovviamente, la nostra amicizia personale è l'unica leva che ho in questa situazione. È così semplice.",shape=box,color=blue];
		j1838741155 -> j504248474;
	j504248474 [label="Cosa ne dici?",shape=box,color=blue];
		j504248474 -> j115431614;
		j504248474 -> j1856138511;
	j115431614 [label="Ok. Lo farò... lo farò. Ti cancellerò la mente. Anche se ci rimetteranno anche quelle di Marie e Lyon.",shape=box,color=red];
		j115431614 -> j2122934646;
	j1856138511 [label="No. Mi rifiuto. Troverò un altro modo per convicerti ad andare avanti.",shape=box,color=red];
		j1856138511 -> j1487791141;
	j2122934646 [label="+10 Chemistry",color=orange];
		j2122934646 -> j3292821814;
	j1487791141 [label="Ti auguro buona fortuna.",shape=box,color=blue];
		j1487791141 -> "Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j3292821814 [label="Ottimo. Procedi. ",shape=box,color=blue];
		j3292821814 -> j4072107213;
	"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
