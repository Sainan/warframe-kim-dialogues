		j724271546 -> j2001952055;
	j2419924878 [label="Niente di più. Niente di meno.",shape=box,color=red];
		j2419924878 -> j1004372192;
	j773789110 [label="Che sarebbe...?",shape=box,color=red];
		j773789110 -> j2105816271;
	j102400638 [label="No. So cosa mi chiederai, e la risposta è già no.",shape=box,color=red];
		j102400638 -> j3650892646;
