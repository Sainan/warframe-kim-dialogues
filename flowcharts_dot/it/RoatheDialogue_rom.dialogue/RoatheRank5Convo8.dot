	j1004372192 [label="Boolean RoatheVillain is now true.",color=orange];
		j1004372192 -> j2059849399;
	j2105816271 [label="Hai un dono. Un dono che può annullare il tempo. Trasformarlo in una spirale, se non in un loop. E questo ha... un effetto interessante sulle menti dei Protoframe, attraverso il loro attaccamento all'Infestazione e al tempo.",shape=box,color=blue];
		j2105816271 -> j1401221542;
	j3650892646 [label="Se potessi dirmi che non hai mai utilizzato i tuoi doni per giocare con le menti dei Protoframe che chiami amici e amanti, e potessi dirlo senza mentire?",shape=box,color=blue];
		j3650892646 -> j3605139822;
	j1331283311 [label="Molto bene. Ammetto e accetto la tua argomentazione. Grazie, Drifter, per... avermi dissuaso da questo particolare ostacolo.",shape=box,color=blue];
		j1331283311 -> j163651564;
	j37027626 [label="+20 Chemistry",color=orange];
		j37027626 -> j3657696642;
	j2059849399 [label="+20 Chemistry",color=orange];
		j2059849399 -> j1547012043;
	j1401221542 [label="E il nostro attaccamento, quindi, al tempo. Te lo chiedo ora. No, ti imploro, di utilizzarlo ora su di me. Allontana da me questi pensieri. Allontana da me questi ricordi.",shape=box,color=blue];
		j1401221542 -> j4242589463;
	j3605139822 [label="Allora molto bene. Così sia. Non te lo chiederò ora. Ma se non l'hai mai fatto per il tuo divertimento, per curiosità o per cercare di rimediare a errori ingiustificati commessi nei rapporti con gli altri?!",shape=box,color=blue];
		j3605139822 -> j4242589463;
	j163651564 [label="Lo apprezzo. Più di quanto tu possa immaginare.",shape=box,color=blue];
		j163651564 -> j1629399580;
	j3657696642 [label="Perdonarmi per quello che ho fatto? E andare avanti? Mh.",shape=box,color=blue];
		j3657696642 -> j1781999392;
	j1547012043 [label="Una ritirata per vincere la guerra. Mh.",shape=box,color=blue];
		j1547012043 -> j3312019762;
	j4242589463 [label="Devo dimenticare di aver preso il siero di Entrati. Per cortesia.",shape=box,color=blue];
		j4242589463 -> j600320979;
		j4242589463 -> j578220673;
		j4242589463 -> j3164056932;
	j1629399580 [label="Devo andare. Ho voglia di bere alcol e di guardare pensieroso nel vuoto.",shape=box,color=blue];
		j1629399580 -> "Chat ends. Next chat will be Roathe5Day2.";
	j1781999392 [label="Anche se sono un po' scettico sulla tua riformulazione della situazione, sono... troppo tentato da questo nuovo futuro e da ciò che potrebbe significare per me resistergli, Usurpatore. Drifter.",shape=box,color=blue];
		j1781999392 -> j387114658;
	j3312019762 [label="Anche se sono... un pochino dubbioso sul fatto che tu abbia riformulato i tuoi eventi come una ritirata tattica, ammetto che sono... comunque a favore, Usurpatore. Drifter.",shape=box,color=blue];
