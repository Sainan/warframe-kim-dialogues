	"Chat ends." [color=orange];
	j2090736320 [label="Stupido! Cosa hai fatto?! Perché, perché vai a scavare in caverne dove non sei il benvenuto?!",shape=box,color=blue];
		j2090736320 -> j3217640811;
	j3217640811 [label="Ti chiedo di risolvere questo problema. È colpa tua. Lo sento, mi artiglia, mi dilania. Come una bestia immensa.",shape=box,color=blue];
		j3217640811 -> j3088134576;
	j3088134576 [label="Liberami da questo. Liberami da questa piaga. Libera la mia mente da questi ricordi. So che puoi. Utilizza questo dono che hai e poni fine a tutto. Ora.",shape=box,color=blue];
		j3088134576 -> j2390923731;
		j3088134576 -> j568430887;
		j3088134576 -> j919431727;
	j2390923731 [label="Ne sei sicuro? Ma... sei intelligente, ho la sensazione che capirai che c'è qualcosa sotto.",shape=box,color=red];
		j2390923731 -> j3251386114;
	j568430887 [label="Quelli sono un tipo diverso di ricordo, Roathe. Non funzionerà su di loro. Sono sepolti più in profondità nella tua psiche.",shape=box,color=red];
		j568430887 -> j2449588392;
	j919431727 [label="Scappare e nascondersi dalla verità non funzionerà. Finiremo per ritrovarci al punto di partenza. ",shape=box,color=red];
		j919431727 -> j4286401056;
	j3251386114 [label="Molto probabilmente. Farò due più due e ti darò la colpa per aver fatto qualcosa che non ti ho chiesto di fare. Sono sicuro che supererai la tempesta.",shape=box,color=blue];
		j3251386114 -> j1453466216;
	j2449588392 [label="Può darsi. Probabilmente hai ragione. Ma non ho altre opzioni, no? Vale la pena tentare.",shape=box,color=blue];
		j2449588392 -> j1453466216;
	j4286401056 [label="E se così fosse, allora puoi semplicemente ripetere l'atto. È come se avessi un dono inesauribile, no?",shape=box,color=blue];
		j4286401056 -> j1453466216;
	j1453466216 [label="Sono certo che mi arrabbierò terribilmente con te quando mi renderò conto che hai alterato i miei ricordi, ovviamente. E ti consiglio di non dirmi che è stato per mia richiesa, tesoro.",shape=box,color=blue];
		j1453466216 -> j3320347481;
	j3320347481 [label="Mi limiterò a sostenere che stai mentendo e questo probabilmente danneggerà irreparabilmente la mia opinione su di te.",shape=box,color=blue];
		j3320347481 -> j4230265745;
		j3320347481 -> j2882277022;
	j4230265745 [label="No. Non posso farlo. Non lo farò. Dobbiamo affrontare questa situazione insieme. Non possiamo semplicemente parlarne?",shape=box,color=red];
		j4230265745 -> j3105449366;
	j2882277022 [label="Io... non c'è davvero nessun altro modo?",shape=box,color=red];
		j2882277022 -> j3105449366;
	j3105449366 [label="No. Se vuoi che il maggiordomo salga di sopra? Cancellami dalla mente tutte queste sciocchezze come ti ho chiesto. Se non ti interessa? Allora fai come vuoi. A me non importa.",shape=box,color=blue];
		j3105449366 -> j1838741155;
	j1838741155 [label="Questo, e beh, ovviamente, la nostra amicizia personale è l'unica leva che ho in questa situazione. È così semplice.",shape=box,color=blue];
		j1838741155 -> j504248474;
	j504248474 [label="Cosa ne dici?",shape=box,color=blue];
		j504248474 -> j115431614;
		j504248474 -> j2672970699;
	j115431614 [label="Ok. Lo farò... lo farò. Ti cancellerò la mente. Anche se ci rimetteranno anche quelle di Marie e Lyon.",shape=box,color=red];
		j115431614 -> j2122934646;
	j2672970699 [label="No. Mi rifiuto. Mi dispiace. Dobbiamo affrontare questa situazione.",shape=box,color=red];
		j2672970699 -> j2049248578;
		j2672970699 -> j1072389985;
	j2122934646 [label="+10 Chemistry",color=orange];
		j2122934646 -> j3292821814;
	j2049248578 [label="Parliamone.",shape=box,color=red];
		j2049248578 -> j2534569924;
	j1072389985 [label="Odiami se vuoi. Ma non farò nulla finché non risolveremo prima questo problema.",shape=box,color=red];
		j1072389985 -> j3935786747;
	j3292821814 [label="Ottimo. Procedi. ",shape=box,color=blue];
		j3292821814 -> j4072107213;
	j2534569924 [label="Non osare - non osare dirmi di \"calmarmi\"! Non pensi che abbia tutto il diritto di sentirmi come se mi stessero facendo a pezzi?!",shape=box,color=blue];
		j2534569924 -> j4143645825;
	j3935786747 [label="Affascinante. Affascinante e inaspettato. Spiega.",shape=box,color=blue];
		j3935786747 -> j2182809848;
		j3935786747 -> j1444148537;
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j4143645825 [label="Mi sento come se la comprensione stessa di me stesso, la base stessa delle mie fondamenta, si fosse spaccata e squarciata come la dannata Lua in persona! Riscritta con un inchiostro che cola. Codardo!",shape=box,color=blue];
		j4143645825 -> j237283265;
	j2182809848 [label="Ma ho fatto quello che era necessario. Non potevi più nasconderti da questo.",shape=box,color=red];
		j2182809848 -> j2481587171;
	j1444148537 [label="Pensa di me quello che vuoi. Ma so riconoscere una spirale quando ne vedo una.",shape=box,color=red];
		j1444148537 -> j123466158;
	j302033967 [label="Boolean RoatheWillReset is now true.",color=orange];
		j302033967 -> "Chat ends.";
	j237283265 [label="E tu osi dirmi di \"calmarmi\"?!",shape=box,color=blue];
		j237283265 -> j1830055178;
	j2481587171 [label="Boolean RoatheFail is now true.",color=orange];
		j2481587171 -> j2516235794;
	j123466158 [label="Sì, credo proprio che tu sia un \"intenditore\" di queste cose, non è vero? Continua.",shape=box,color=blue];
		j123466158 -> j969174030;
		j123466158 -> j2977234697;
	j1830055178 [label="Evaluate expressions",color=orange];
		j1830055178 -> j543695132 [label="RoatheForgivenessShortcut",color=purple];
		j1830055178 -> j3245502425 [label="RoatheVillainyShortcut",color=purple];
		j1830055178 -> j2318547072 [label="false",color=purple];
	j2516235794 [label="Dentro di me c'è una bestia rabbiosa e violenta che mi divora la cassa toracica dall'interno.",shape=box,color=blue];
		j2516235794 -> j420888537;
	j969174030 [label="Se desideri chiedere perdono, puoi farlo. Ma devi volerlo. Devi scegliere tu quella strada. Nessun altro può farlo.",shape=box,color=red];
		j969174030 -> j1978242832;
	j2977234697 [label="Se vuoi scegliere di tracciare un percorso da solo? Per te stesso? Fallo. Non scusarti. Ma quella è la tua strada, e di nessun altro.",shape=box,color=red];
		j2977234697 -> j2361201192;
	j543695132 [label="Arrabbiarsi non risolverà nulla, Roathe. Sei arrabbiato perché hai paura di affrontare quello che hai fatto. E quello che sei diventato.",shape=box,color=red];
		j543695132 -> j2055010513;
	j3245502425 [label="Va bene. Arrabbiati. Ma usa quella rabbia per qualcosa di utile. Utilizzala per scrollarti di dosso tutto l'odio che hai dentro e che stai indirizzando nella direzione sbagliata.",shape=box,color=red];
		j3245502425 -> j1158515382;
	j2318547072 [label="Evaluate expressions on Thermostat counter",color=orange];
		j2318547072 -> j543695132 [label="x >= 5",color=purple];
		j2318547072 -> j3245502425 [label="x <= 0",color=purple];
		j2318547072 -> j2108669238 [label="x > 0 && x < 5",color=purple];
		j2318547072 -> j2108669238 [label="false",color=purple];
	j420888537 [label="E non so come soddisfarlo. Non so se ci riuscirò. Speravo che queste conversazioni mi avrebbero aiutato; ma ora capisco che è inutile.",shape=box,color=blue];
		j420888537 -> j3793958463;
	j1978242832 [label="Non sei definito dal tuo passato, Roathe. Sei definito dal tuo futuro. E hai ancora un futuro da vivere, a differenza di tutti gli Orokin che morirono nella Notte dei Tamburi Naga.",shape=box,color=red];
		j1978242832 -> j2517352043;
	j2361201192 [label="Non sei definito dalle opinioni di chi ti circonda. O da ciò che pensano delle tue azioni. Sei definito solo da ciò che pensi di te stesso e delle tue scelte.",shape=box,color=red];
		j2361201192 -> j2089172439;
	j2055010513 [label="Stai lasciando che quella rabbia ti distrugga dentro. Potresti usarla per combattere le persone che ancora oggi stanno distruggendo questo mondo. Qui. Ora.",shape=box,color=red];
		j2055010513 -> j2122087878;
	j1158515382 [label="La stai puntando contro te stesso. Dovresti puntarla contro il mondo che ti sta incolpando per aver fatto del tuo meglio per salvarlo dall'Impero Orokin.",shape=box,color=red];
		j1158515382 -> j2460342821;
	j2108669238 [label="Vorrei solo sapere come aiutarti. Vorrei sapere cosa dirti. Mi sento come se fossi diviso in due direzioni. Da che parte vuoi andare?",shape=box,color=red];
		j2108669238 -> j1107850093;
	j3793958463 [label="Ma c'è una soluzione, no? Hai il potere di risolvere questo... questo orribile tormento nella mia mente.",shape=box,color=blue];
		j3793958463 -> j3446077777;
	j2517352043 [label="Questa è l'unica cosa che ti definisce, ora. Puoi cambiare. E puoi cambiare il mondo intorno a te. Credo che la mia unica domanda sia: ci proverai almeno?",shape=box,color=red];
		j2517352043 -> j307265003;
	j2089172439 [label="E il fatto è che sei uno dei pochissimi Orokin che conosciamo sopravvissuti alla Notte dei Tamburi Naga. Dal mio punto di vista? È stata una ritirata strategica.",shape=box,color=red];
		j2089172439 -> j1736381740;
	j2122087878 [label="Stai lasciando che quella rabbia ti distrugga dentro. Potresti usarla per combattere le persone che ancora oggi stanno distruggendo questo mondo. Qui. Ora.",shape=box,color=red];
		j2122087878 -> j3004384433;
	j2460342821 [label="Non sei definito dalle opinioni di chi ti circonda. O da ciò che pensano delle tue azioni. Sei definito solo da ciò che pensi di te stesso e delle tue scelte.",shape=box,color=red];
		j2460342821 -> j2927339421;
	j1107850093 [label="Boolean RoatheFail is now true.",color=orange];
		j1107850093 -> j225857544;
	j3446077777 [label="Usurpatore. Drifter. Ti sto pregando. In effetti, credo che sia l'unico modo in cui possiamo andare avanti, vero? È anche nei i tuoi interessi.",shape=box,color=blue];
		j3446077777 -> j2989957351;
	j307265003 [label="Proverai a perdonare te stesso e ad andare avanti?",shape=box,color=red];
		j307265003 -> j661363959;
	j1736381740 [label="Niente di più. Niente di meno.",shape=box,color=red];
		j1736381740 -> j3596491381;
	j3004384433 [label="Questa è l'unica cosa che ti definisce, ora. Puoi cambiare. E puoi cambiare il mondo intorno a te. Credo che la mia unica domanda sia: ci proverai almeno?",shape=box,color=red];
		j3004384433 -> j724271546;
	j2927339421 [label="E il fatto è che sei uno dei pochissimi Orokin che conosciamo sopravvissuti alla Notte dei Tamburi Naga. Dal mio punto di vista? È stata una ritirata strategica.",shape=box,color=red];
		j2927339421 -> j2419924878;
	j225857544 [label="Non lo so, Usurpatore. Ed è proprio qui che risiede il problema più grande.",shape=box,color=blue];
		j225857544 -> j2516235794;
	j2989957351 [label="Se vuoi veramente che il maggiordomo salga di sopra e si riconcili con la famiglia Entrati, devi fare come ti dico. Devi.",shape=box,color=blue];
		j2989957351 -> j773789110;
		j2989957351 -> j102400638;
