		5154 -> 5156 [label="x <= 21",color=purple];
		5154 -> 5156 [label="false",color=purple];
	5153 [label="Chat ends.",color=orange];
	5155 [label="Stupido! Cosa hai fatto?! Perché, perché vai a scavare in caverne dove non sei il benvenuto?!",shape=box,color=blue];
		5155 -> 5157;
	5156 [label="Chat ends.",color=orange];
	5157 [label="Ti chiedo di risolvere questo problema. È colpa tua. Lo sento, mi artiglia, mi dilania. Come una bestia immensa.",shape=box,color=blue];
		5157 -> 5158;
	5158 [label="Liberami da questo. Liberami da questa piaga. Libera la mia mente da questi ricordi. So che puoi. Utilizza questo dono che hai e poni fine a tutto. Ora.",shape=box,color=blue];
		5158 -> 5159;
		5158 -> 5160;
		5158 -> 5161;
	5159 [label="Ne sei sicuro? Ma... sei intelligente, ho la sensazione che capirai che c'è qualcosa sotto.",shape=box,color=red];
		5159 -> 5162;
	5160 [label="Quelli sono un tipo diverso di ricordo, Roathe. Non funzionerà su di loro. Sono sepolti più in profondità nella tua psiche.",shape=box,color=red];
		5160 -> 5163;
	5161 [label="Scappare e nascondersi dalla verità non funzionerà. Finiremo per ritrovarci al punto di partenza. ",shape=box,color=red];
		5161 -> 5164;
	5162 [label="Molto probabilmente. Farò due più due e ti darò la colpa per aver fatto qualcosa che non ti ho chiesto di fare. Sono sicuro che supererai la tempesta.",shape=box,color=blue];
		5162 -> 5165;
	5163 [label="Può darsi. Probabilmente hai ragione. Ma non ho altre opzioni, no? Vale la pena tentare.",shape=box,color=blue];
		5163 -> 5165;
	5164 [label="E se così fosse, allora puoi semplicemente ripetere l'atto. È come se avessi un dono inesauribile, no?",shape=box,color=blue];
		5164 -> 5165;
	5165 [label="Sono certo che mi arrabbierò terribilmente con te quando mi renderò conto che hai alterato i miei ricordi, ovviamente. E ti consiglio di non dirmi che è stato per mia richiesa, tesoro.",shape=box,color=blue];
		5165 -> 5166;
	5166 [label="Mi limiterò a sostenere che stai mentendo e questo probabilmente danneggerà irreparabilmente la mia opinione su di te.",shape=box,color=blue];
		5166 -> 5167;
		5166 -> 5168;
	5167 [label="No. Non posso farlo. Non lo farò. Dobbiamo affrontare questa situazione insieme. Non possiamo semplicemente parlarne?",shape=box,color=red];
		5167 -> 5169;
	5168 [label="Io... non c'è davvero nessun altro modo?",shape=box,color=red];
		5168 -> 5169;
	5169 [label="No. Se vuoi che il maggiordomo salga di sopra? Cancellami dalla mente tutte queste sciocchezze come ti ho chiesto. Se non ti interessa? Allora fai come vuoi. A me non importa.",shape=box,color=blue];
		5169 -> 5170;
	5170 [label="Questo, e beh, ovviamente, la nostra amicizia personale è l'unica leva che ho in questa situazione. È così semplice.",shape=box,color=blue];
		5170 -> 5171;
	5171 [label="Cosa ne dici?",shape=box,color=blue];
		5171 -> 5172;
		5171 -> 5173;
	5172 [label="Ok. Lo farò... lo farò. Ti cancellerò la mente. Anche se ci rimetteranno anche quelle di Marie e Lyon.",shape=box,color=red];
		5172 -> 5174;
	5173 [label="No. Mi rifiuto. Troverò un altro modo per convicerti ad andare avanti.",shape=box,color=red];
		5173 -> 5175;
	5174 [label="+10 Chemistry",color=orange];
		5174 -> 5176;
	5175 [label="Ti auguro buona fortuna.",shape=box,color=blue];
		5175 -> 5179;
	5176 [label="Ottimo. Procedi. ",shape=box,color=blue];
		5176 -> 5178;
	5179 [label="Update boolean LyonRoatheRepair",color=orange];
