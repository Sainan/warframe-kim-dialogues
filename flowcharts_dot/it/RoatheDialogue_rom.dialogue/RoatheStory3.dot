	2150 [label="Trascrizione: Per molto tempo l'Impero Orokin non ebbe nemici. Il suo esercito esisteva solo per soddisfare meschini rancori, casa contro casa, Esecutore contro Esecutore.",shape=box,color=blue];
		2150 -> 2153;
	2153 [label="Quando i Sentient attaccarono, scoprimmo un'unità a lungo negataci. I Dax sguainarono le spade contro qualcosa di ben diverso da un contadino insolente o un mercante ladro.",shape=box,color=blue];
		2153 -> 2154;
	2154 [label="Gli Imperatori, gli immortali sovrani dell'Impero, il cui potere era conferito agli Esecutori, si svegliarono barcollando sui loro polverosi troni dorati.",shape=box,color=blue];
		2154 -> 5683;
	5683 [label="Guerra, magnifica guerra! Finalmente, l'Impero significava qualcosa. Definiti da un'estinzione più imminente della morte finale del Sole, bevemmo a piene mani il nettare della vita.",shape=box,color=blue];
