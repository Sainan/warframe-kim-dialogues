	j2486011423 [label="MV: OROKIN",shape=box,color=blue];
		j2486011423 -> j3316264133;
	j3316264133 [label="Trascrizione: Per molto tempo l'Impero Orokin non ebbe nemici. Il suo esercito esisteva solo per soddisfare meschini rancori, casa contro casa, Esecutore contro Esecutore.",shape=box,color=blue];
		j3316264133 -> j300225715;
	j300225715 [label="Quando i Sentient attaccarono, scoprimmo un'unità a lungo negataci. I Dax sguainarono le spade contro qualcosa di ben diverso da un contadino insolente o un mercante ladro.",shape=box,color=blue];
		j300225715 -> j2498967255;
	j2498967255 [label="Gli Imperatori, gli immortali sovrani dell'Impero, il cui potere era conferito agli Esecutori, si svegliarono barcollando sui loro polverosi troni dorati.",shape=box,color=blue];
		j2498967255 -> j110077676;
	j110077676 [label="Guerra, magnifica guerra! Finalmente, l'Impero significava qualcosa. Definiti da un'estinzione più imminente della morte finale del Sole, bevemmo a piene mani il nettare della vita.",shape=box,color=blue];
		j110077676 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
