		j3857362161 -> j1410385200;
	j2366743703 [label="Continua.",shape=box,color=red];
		j2366743703 -> j2301994207;
	j2193859221 [label="Sì, ma che dire di tutti gli altri che erano 'vicini' ma 'non abbastanza importanti'? Gli Archimedei? O gli Orokin di grado inferiore? C'erano sempre dei livelli dentro ai livelli. Anche se i soffitti erano di vetro, esistevano. Credimi.",shape=box,color=blue];
		j2193859221 -> j1088175257;
	j4238186536 [label="In effetti lo abbiamo fatto. A ogni occasione possibile. Ma non tutti sono stati risparmiati, vero? E quelli che erano 'vicini' ma 'non abbastanza importanti'? Gli Archimedei? Gli Orokin di grado inferiore?",shape=box,color=blue];
		j4238186536 -> j1749358623;
	j1005530701 [label="Considera tutti coloro che erano 'vicini' ma 'non abbastanza importanti'. Gli Archimedei. Gli Orokin di grado inferiore. C'erano sempre dei livelli dentro ai livelli. Anche se i soffitti erano di vetro, esistevano. Credimi.",shape=box,color=blue];
		j1005530701 -> j1088175257;
	j1410385200 [label="Sì, ma che dire di tutti gli altri che erano 'vicini' ma 'non abbastanza importanti'? Gli Archimedei? O gli Orokin di grado inferiore? C'erano sempre dei livelli dentro ai livelli. Anche se i soffitti erano di vetro, esistevano. Credimi.",shape=box,color=blue];
		j1410385200 -> j1025958631;
	j2301994207 [label="Considera tutti coloro che erano 'vicini' ma 'non abbastanza importanti'. Gli Archimedei. Gli Orokin di grado inferiore. C'erano sempre dei livelli dentro i livelli. Anche se i soffitti erano di vetro, esistevano. Credimi.",shape=box,color=blue];
		j2301994207 -> j1025958631;
	j1088175257 [label="Non tutti sono stati così fortunati da ricevere in dono nuova carne ogni volta che la loro vecchia forma bruciava. Ma sono certo che troverai il Teatro Yuvan una pratica disgustosa, non è vero?",shape=box,color=blue];
		j1088175257 -> j167658967;
		j1088175257 -> j338903145;
	j1749358623 [label="Non tutti sono stati così fortunati da ricevere in dono nuova carne ogni volta che la loro vecchia forma bruciava lentamente. Chiaramente, ritieni che il Teatro Yuvan sia una pratica disgustosa.",shape=box,color=blue];
		j1749358623 -> j2960473137;
		j1749358623 -> j338903145;
	j1025958631 [label="Non tutti sono stati così fortunati da ricevere in dono nuova carne ogni volta che la loro vecchia forma bruciava. Ma sono certo che troverai il Teatro Yuvan una pratica disgustosa, non è vero?",shape=box,color=blue];
		j1025958631 -> j3987377456;
		j1025958631 -> j4148546671;
	j167658967 [label="Non ne so abbastanza sulla pratica per esprimere un giudizio.",shape=box,color=red];
		j167658967 -> j4249252526;
	j338903145 [label="Certo. Penso che sia disgustoso quello che avete fatto. Tutto ciò che è stato scritto sul Teatro Yuvan dice che avete rapito dei bambini e gli avete cancellato la mente.",shape=box,color=red];
		j338903145 -> j21888572;
	j2960473137 [label="Come potrei non pensarlo? Avete rapito dei bambini dalle loro case e avete cancellato le loro menti per sostituirle con le vostre!",shape=box,color=red];
		j2960473137 -> j2540796605;
	j3987377456 [label="Non ne so abbastanza sulla pratica per esprimere un giudizio.",shape=box,color=red];
		j3987377456 -> j3653938103;
	j4148546671 [label="Certo. Penso che sia disgustoso quello che avete fatto. Tutto ciò che è stato scritto sul Teatro Yuvan dice che avete rapito dei bambini e gli avete cancellato la mente.",shape=box,color=red];
		j4148546671 -> j2790399448;
	j4249252526 [label="+5 Chemistry",color=orange];
		j4249252526 -> j373175715;
	j21888572 [label="'Tutto ciò che è stato scritto sul Teatro Yuvan dice...' Dove sono registrate tutte queste cose? E, cosa ancora più importante, chi ha scritto tutto questo?",shape=box,color=blue];
		j21888572 -> j3319401890;
	j2540796605 [label="E come fai a sapere tutto questo? Hai assistito personalmente a uno spettacolo del Teatro Yuvan?",shape=box,color=blue];
		j2540796605 -> j3605854529;
		j2540796605 -> j2607670357;
		j2540796605 -> j3023206482;
	j3653938103 [label="+5 Chemistry",color=orange];
		j3653938103 -> j373175715;
	j2790399448 [label="Eppure hai appena detto che rimangono solo frammenti della nostra storia e dei nostri documenti culturali. E dove sono tutti questi documenti? E soprattuto, chi li ha scritti?",shape=box,color=blue];
		j2790399448 -> j3319401890;
	j373175715 [label="Sospendere il giudizio finché non si hanno tutte le informazioni? Oddio, Usurpatore! Sembri quasi intelligente! Che rarità!",shape=box,color=blue];
		j373175715 -> j244252875;
	j3319401890 [label="Sono storie raccontate da coloro che hanno un interesse specifico nel rappresentare ogni aspetto degli Orokin nella luce più disastrosa e malvagia possibile.",shape=box,color=blue];
		j3319401890 -> j927858517;
	j3605854529 [label="No.",shape=box,color=red];
		j3605854529 -> j411172768;
	j2607670357 [label="Sì.",shape=box,color=red];
		j2607670357 -> j3150525823;
	j3023206482 [label="Non importa se l'ho fatto o no, i fatti sono chiari.",shape=box,color=red];
		j3023206482 -> j2622180776;
	j244252875 [label="Permettimi allora di cambiare la prospettiva della storia, se mi è concesso. Rifletti su dove hanno origine i resoconti del Teatro Yuvan che potresti aver sentito.",shape=box,color=blue];
		j244252875 -> j3319401890;
	j927858517 [label="Coloro che abbattono tutte le strutture di supporto della società stessa del Sistema Origin e la mandano nel caos più totale devono dare a coloro che fanno affidamento su quella società una buona ragione per farlo.",shape=box,color=blue];
		j927858517 -> j2496250660;
	j411172768 [label="Allora ti affidi a storie di seconda mano. Considera dove sono stati scritti questi resoconti. E, cosa ancora più importante, considera chi li ha scritti.",shape=box,color=blue];
		j411172768 -> j3319401890;
	j3150525823 [label="Ah! Bugiardo. ",shape=box,color=blue];
		j3150525823 -> j2251161217;
	j2622180776 [label="Davvero? Considera dove sono stati scritti questi resoconti. E, cosa ancora più importante, considera chi li ha scritti.",shape=box,color=blue];
		j2622180776 -> j3319401890;
	j2496250660 [label="Immagina la vita di un essere umano medio su una stazione, Usurpatore. Uno lontano dalle prove e dalle tribolazioni dei Tenno. Uno a cui non importava nulla della Grande Guerra.",shape=box,color=blue];
		j2496250660 -> j3385724062;
	j2251161217 [label="Ti affidi a storie di seconda mano. Considera dove sono stati scritti questi resoconti. E, cosa ancora più importante, considera chi li ha scritti.",shape=box,color=blue];
		j2251161217 -> j3319401890;
	j3385724062 [label="Quando gli Orokin caddero, le loro vite furono gettate in un vero e proprio inferno nel vuoto di potere che ne seguì. Dovettero inventarsi delle spiegazioni. Dovettero creare delle effigi e bruciarle. Dovettero trasformaci in mostri nell'oscurità.",shape=box,color=blue];
		j3385724062 -> j3382932425;
		j3385724062 -> j1361626124;
	j3382932425 [label="Mi stai dicendo che non avete rapito dei bambini per il Teatro Yuvan?",shape=box,color=red];
		j3382932425 -> j2100196106;
	j1361626124 [label="Quindi cosa è successo veramente al Teatro Yuvan?",shape=box,color=red];
		j1361626124 -> j2495290939;
	j2100196106 [label="No, quella parte è assolutamente corretta.",shape=box,color=blue];
		j2100196106 -> j2364388019;
	j2495290939 [label="+5 Chemistry",color=orange];
		j2495290939 -> j3750754833;
	j2364388019 [label="Voglio solo che tu prenda in considerazione le tue fonti, tutto qui.",shape=box,color=blue];
		j2364388019 -> j2689743830;
	j3750754833 [label="Dire che non abbiamo accettato sacrifici è sbagliato. Lo abbiamo fatto. Ma non è tutta la verità. Queste cose raramente sono così semplici e non sono mai così chiare e nette.",shape=box,color=blue];
		j3750754833 -> j1065304026;
	j2689743830 [label="Perché non è tutta la verità. Queste cose raramente sono così semplici e mai così nette. Il mondo è grigio, Usurpatore. Non è così facile tracciarne i confini. ",shape=box,color=blue];
		j2689743830 -> j1956183784;
	j1065304026 [label="Il mondo è grigio, Usurpatore. Non è così facile tracciare confini.",shape=box,color=blue];
		j1065304026 -> j1956183784;
	j1956183784 [label="La pratica non iniziò in modo così vergognoso. Inizialmente, era considerata il massimo onore. Sacrificarsi affinché l'Impero continuasse ininterrotto. Inflessibile. Affinché l'opera potesse proseguire.",shape=box,color=blue];
		j1956183784 -> j1869808183;
	j1869808183 [label="E non è iniziato con i giovani. È iniziato con coloro che semplicemente avevano più anni da vivere. Ma poi coloro che si sono offerti sono diventati... sempre più giovani. La devozione è una droga potente.",shape=box,color=blue];
		j1869808183 -> j2029130207;
	j2029130207 [label="Ho visto qualcosa di simile con coloro che si arruolavano per la guerra. Mentivano sulla loro età nei documenti per 'combattere la giusta battaglia'. Non sapevano che stavano creando un pericoloso precedente per coloro che, controvoglia, sarebbero venuti dopo.",shape=box,color=blue];
		j2029130207 -> j1359605024;
	j1359605024 [label="Da qualche parte lungo il percorso, qualche Esecutore si rese conto che poteva essere usato come... misura punitiva. Che certe città o... interi pianeti potevano essere tenuti sotto controllo se si fosse utilizzata la minaccia del Teatro Yuvan. Se i sacrifici fossero stati esercitati in modo particolarmente pesante.",shape=box,color=blue];
		j1359605024 -> j1943490174;
		j1359605024 -> j3241563932;
	j1943490174 [label="E tu cosa ne pensi?",shape=box,color=red];
		j1943490174 -> j1480793918;
	j3241563932 [label="Ti è mai capitato di partecipare a un sacrifico involontario?",shape=box,color=red];
		j3241563932 -> j742521808;
	j1480793918 [label="+5 Chemistry",color=orange];
		j1480793918 -> j2130784878;
	j742521808 [label="Non ti mentirò. L'ho fatto. E puoi considerarmi un mostro quanto vuoi. Ma quando l'intera società è costruita su centinaia di anni di normalizzazione di qualcosa, è molto difficile voltarle le spalle.",shape=box,color=blue];
		j742521808 -> j2930196645;
	j2130784878 [label="Mmm. Sentimenti misti. Da un lato, anch'io ho preso parte al Teatro molte volte. Sarei un ipocrita se lo condannassi. Quando l'intera società è costruita su centinaia di anni di normalizzazione di qualcosa, è molto difficile voltarle le spalle.",shape=box,color=blue];
		j2130784878 -> j2074026634;
	j2930196645 [label="Anche a posteriori, o in un momento di lucidità, è tutto molto chiaro. ",shape=box,color=blue];
		j2930196645 -> j297146989;
	j2074026634 [label="D'altro canto, preso singolarmente o a posteriori, l'orrore dell'atto diventa piuttosto chiaro.",shape=box,color=blue];
		j2074026634 -> j297146989;
	j297146989 [label="+5 Chemistry",color=orange];
		j297146989 -> j1038826762;
	j1038826762 [label="Nessuno dovrebbe vivere per sempre, Usurpatore. E il Teatro ne è la prova.",shape=box,color=blue];
		j1038826762 -> "Chat ends.";
}