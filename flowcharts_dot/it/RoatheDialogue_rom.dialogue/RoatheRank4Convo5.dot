	"RoatheRank4Convo5 begins." [color=orange];
		"RoatheRank4Convo5 begins." -> j819377272;
	j819377272 [label="Quanto ricordi dei tuoi giorni nell'Impero, Usurpatore? Mi sembra frammentario, nella migliore delle ipotesi. Non che io possa giudicare, intendiamoci.",shape=box,color=blue];
		j819377272 -> j3258597715;
		j819377272 -> j2081574203;
		j819377272 -> j3487236990;
		j819377272 -> j4115718638;
	j3258597715 [label="Abbastanza per sapere che meritavate tutti di bruciare.",shape=box,color=red];
		j3258597715 -> j2594875771;
	j2081574203 [label="Spizzichi e bocconi. Perché?",shape=box,color=red];
		j2081574203 -> j250947346;
	j3487236990 [label="Ero piuttosto giovane quando ci hanno messo a bordo della Zariman. E dopo... beh.",shape=box,color=red];
		j3487236990 -> j250947346;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j2594875771 [label="È più che giusto. Tuttavia, ti stai perdendo intere porzioni della nostra storia e dei nostri documenti culturali. So che dopo la caduta non eravamo molto apprezzati, ma...",shape=box,color=blue];
		j2594875771 -> j1398381672;
	j250947346 [label="Mh. Mi sembra strano che esistano così poche testimonianze complete della nostra società e della nostra cultura. So che dopo la caduta c'era poco apprezzamento per noi, ma...",shape=box,color=blue];
		j250947346 -> j4120338591;
	"Chat ends." [color=orange];
