	j2605568784 [label="Ricorderei quella parola se l'avessi già sentita.",shape=box,color=red];
		j2605568784 -> j1668132853;
	j2560944929 [label="Incredibilmente? No. Forse è perché ho trascorso gli ultimi... troppi anni intrappolato in una cripta con questi due fanatici, ma è scioccante per me che non sia sopravvissuta alcuna traccia di come gli Orokin trattassero i loro morti nel corso dei millenni.",shape=box,color=blue];
		j2560944929 -> j2604243184;
		j2560944929 -> j1364269950;
	j3216946844 [label="Forse è perché ho trascorso gli ultimi... troppi anni intrappolato in una cripta con questi due fanatici, ma è scioccante per me che non sia sopravvissuta alcuna traccia di come gli Orokin trattassero i loro morti nel corso dei millenni.",shape=box,color=blue];
		j3216946844 -> j2008994299;
