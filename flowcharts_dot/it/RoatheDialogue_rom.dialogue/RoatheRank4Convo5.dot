	j1668132853 [label="Forse è perché ho trascorso gli ultimi... troppi anni intrappolato in una cripta con questi due fanatici, ma è scioccante per me che non sia sopravvissuta alcuna traccia di come gli Orokin trattassero i loro morti nel corso dei millenni.",shape=box,color=blue];
		j1668132853 -> j3857362161;
		j1668132853 -> j2366743703;
	j2604243184 [label="Non pensavo poteste morire. Rubavate solo nuovi cadaveri dal Teatro Yuvan.",shape=box,color=red];
		j2604243184 -> j2193859221;
	j1364269950 [label="Pensavo avessi rubato degli umani per risolvere quel problema. Non hai fatto altro che simulare la morte.",shape=box,color=red];
		j1364269950 -> j4238186536;
	j2008994299 [label="Non pensavo poteste morire. Rubavate solo nuovi cadaveri dal Teatro Yuvan.",shape=box,color=red];
		j2008994299 -> j2193859221;
	j1219025301 [label="Continua.",shape=box,color=red];
		j1219025301 -> j1005530701;
