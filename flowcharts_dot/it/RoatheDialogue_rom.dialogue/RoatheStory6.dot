	j1472709700 [label="MV: COSCIENZA",shape=box,color=blue];
		j1472709700 -> j675936566;
	j675936566 [label="Trascrizione: Non consideravamo i Sentient come un \"loro\", quanto piuttosto come un \"essi\". ",shape=box,color=blue];
		j675936566 -> j730372234;
	j730372234 [label="Ci trovavamo di fronte a legioni scagliate contro di noi senza più riguardo per le loro vite individuali di quanto ne abbiano i corpuscoli.",shape=box,color=blue];
		j730372234 -> j1359437330;
	j1359437330 [label="Erano cellule nel corpo di una massa tentacolare e malevola.",shape=box,color=blue];
		j1359437330 -> j3108802314;
	j3108802314 [label="Eravamo, credo, troppo condizionati dalle nostre esperienze con l'Infestazione, una mente alveare di tutt'altro tipo.",shape=box,color=blue];
		j3108802314 -> j521554174;
	j521554174 [label="Ai Sentient era stato dato il mandato di evolversi, e il loro unico modello del punto finale di tale evoluzione eravamo noi.",shape=box,color=blue];
		j521554174 -> j3944039554;
	j3944039554 [label="Stavano tornando al Sistema Origin non solo per annientare gli Orokin, ma per sostituirli e in ultima analisi… perfezionarli.",shape=box,color=blue];
		j3944039554 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
