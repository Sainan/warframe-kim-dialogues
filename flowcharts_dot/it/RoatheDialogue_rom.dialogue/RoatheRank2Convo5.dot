	edge [fontname="Roboto Condensed"];

	"RoatheRank2Convo5 begins." [color=orange];
		"RoatheRank2Convo5 begins." -> j2554321341;
	j2554321341 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		j2554321341 -> j364889355 [label=true,color=green];
		j2554321341 -> "Chat ends." [label=false,color=brown];
	j364889355 [label="Check boolean RoatheKnowsReset2",color=orange];
		j364889355 -> j2551210479 [label=true,color=green];
		j364889355 -> j1918363296 [label=false,color=brown];
	"Chat ends." [color=orange];
	j2551210479 [label="Quanto ti ha raccontato il Roathe del Passato dei suoi rapporti con l'Esecutrice Nitokh? Bah. Cerco di ricostruire il tutto: il mio io precedente ti ha confidato informazioni così personali... solo per farti cancellare tutto dalla mia mente?",shape=box,color=blue];
		j2551210479 -> j868102700;
	j1918363296 [label="Evaluate expressions on HellStory counter",color=orange];
		j1918363296 -> j2355729831 [label="x >= 1",color=purple];
		j1918363296 -> "Chat ends." [label="x <= 1",color=purple];
		j1918363296 -> "Chat ends." [label="false",color=purple];
	j868102700 [label="Mi brucia. Il fatto che avrei potuto dirti tutto, proprio tutto - metterti a nudo ogni mio pensiero più intimo, e tu... hai cancellato tutto di nuovo. Come se fossi solo un giocattolino per te.",shape=box,color=blue];
		j868102700 -> j4290550081;
	j2355729831 [label="Mi hai già sentito parlare dell'Esecutrice Nitokg. E dei miei... rapporti con lei. Devi cercare di capire che l'Impero Orokin non era del tutto malvagio.",shape=box,color=blue];
		j2355729831 -> j1817202405;
	j4290550081 [label="Suppongo sia giusto così. È così che noi Orokin abbiamo trattato l'umanità, no? Il Teatro Yuvan? Sfilare corpi bellissimi e scegliere a nostro piacimento le nostre nuove identità, torturarci a vicenda con giochi per un divertimento malato, come meglio credevamo...",shape=box,color=blue];
		j4290550081 -> j515214164;
	j1817202405 [label="Mi spezza il cuore che venga ricordato solo per la sua devastazione e depravazione. Sì, ce n'era molta, non lo nego. ",shape=box,color=blue];
		j1817202405 -> j3096084583;
	j515214164 [label="Lo odio. Lo odio davvero, davvero tanto.",shape=box,color=blue];
		j515214164 -> j3731103768;
		j515214164 -> j1464059026;
		j515214164 -> j4115718638;
	j3096084583 [label="Ma era anche capace di tanta bellezza. Tanta gioia. Tanto amore. Tanti progressi scientifici e artistici. Guarda cosa siamo stati capaci di realizzare! ",shape=box,color=blue];
		j3096084583 -> j3556858506;
	j3731103768 [label="Anche se non era mia intenzione ferirti in questo modo, e mi dispiace di averlo fatto, se questo ti ha insegnato cosa significhi trovarsi dall'altra parte dell'Impero Orokin, allora è stata una lezione preziosa.",shape=box,color=red];
		j3731103768 -> j1119942172;
	j1464059026 [label="Non ho mai voluto che questo ti ferisse in questo modo. Non dovresti scusarti per il modo in cui funzionava la società Orokin - non l'hai costruita tu. Stavi solo cercando di salvarla.",shape=box,color=red];
		j1464059026 -> j1493050633;
	j4115718638 [label="[Fine.]",shape=box,color=red];
		j4115718638 -> "Chat ends.";
	j3556858506 [label="Quindi, quando Nitokh mi convocò al suo cospetto e mi disse che voleva uccidere tutti gli Orokin? Accettai immediatamente. Volevo tagliare la testa al serpente avvelenato. Volevo sostituirlo con un sistema più benigno. Un sovrano più benigno.",shape=box,color=blue];
		j3556858506 -> j356471089;
		j3556858506 -> j517531987;
		j3556858506 -> j4115718638;
	j1119942172 [label="Add 3 to Thermostat counter",color=orange];
		j1119942172 -> j3402440296;
	j1493050633 [label="Add -3 to Thermostat counter",color=orange];
		j1493050633 -> j1649133894;
	j356471089 [label="Volevi sostituire gli Imperatori e gli Esecutori con te stesso, intendi dire.",shape=box,color=red];
		j356471089 -> j2225242497;
	j517531987 [label="E chi sarebbe questo sovrano?",shape=box,color=red];
		j517531987 -> j3431099588;
	j3402440296 [label="L'Impero Orokin non era completamente malvagio. Mi spezza il cuore che venga ricordato solo per la sua devastazione e depravazione. Sì, ce n'era molta, non lo nego.",shape=box,color=blue];
		j3402440296 -> j4178345522;
	j1649133894 [label="Se solo gli altri avessero potuto vederla in questo modo. Se solo Nitokh l'avesse vista in questo modo. ",shape=box,color=blue];
		j1649133894 -> j3402440296;
	j2225242497 [label="Perché sì, ovvio!",shape=box,color=blue];
		j2225242497 -> j3138744279;
	j3431099588 [label="Me stesso, ovvio.",shape=box,color=blue];
		j3431099588 -> j3138744279;
	j4178345522 [label="Ma era anche capace di tanta bellezza. Tanta gioia. Tanto amore. Tanti progressi scientifici e artistici. Guarda cosa siamo stati capaci di realizzare! ",shape=box,color=blue];
		j4178345522 -> j610170643;
	j3138744279 [label="Mi sarei assicurato che tutti gli Esecutori e gli Imperatori venissero... rimossi, e avrei assunto il ruolo di Esecutore Ad Interim fino all'introduzione di un nuovo sistema.",shape=box,color=blue];
		j3138744279 -> j984373082;
	j610170643 [label="Quindi, quando Nitokh mi convocò al suo cospetto e mi disse che voleva uccidere tutti gli Orokin? Accettai immediatamente. Volevo tagliare la testa al serpente avvelenato. Volevo sostituirlo con un sistema più benigno. Un sovrano più benigno.",shape=box,color=blue];
		j610170643 -> j1691818741;
		j610170643 -> j2136411952;
	j984373082 [label="Non so quanto tempo ci sarebbe voluto, ma sarebbe stato meglio di quello che è successo dopo la Grande Guerra, no?",shape=box,color=blue];
		j984373082 -> j3335629052;
		j984373082 -> j3800113628;
		j984373082 -> j2154763076;
	j1691818741 [label="Volevi sostituire gli Imperatori e gli Esecutori con te stesso, intendi dire.",shape=box,color=red];
		j1691818741 -> j3078886627;
	j2136411952 [label="E chi sarebbe questo sovrano?",shape=box,color=red];
		j2136411952 -> j1529149160;
	j3335629052 [label="Grande Guerra?",shape=box,color=red];
		j3335629052 -> j2628192445;
	j3800113628 [label="Sii onesto con te stesso, pensi che avresti mai rinunciato al potere?",shape=box,color=red];
		j3800113628 -> j3834022301;
	j2154763076 [label="Non credo che avresti mai rinunciato al potere, Roathe.",shape=box,color=red];
		j2154763076 -> j4048204102;
	j3078886627 [label="Perché sì, ovviamente! E non fingere di non averlo mai sentito prima, sono certo di sì. ",shape=box,color=blue];
		j3078886627 -> j1532838055;
	j1529149160 [label="Me stesso, ovviamente. E non fingere di non averlo mai sentito prima, sono certo di sì.",shape=box,color=blue];
		j1529149160 -> j1532838055;
	j2628192445 [label="Ora la chiamate ''Vecchia Guerra''. Per me non è affatto ''Vecchia'', è accaduta solo pochi anni fa, almeno secondo i miei ricordi.",shape=box,color=blue];
		j2628192445 -> j368544961;
	j3834022301 [label="Mm. Non lo so. Ormai non ha più importanza, no? Ma all'epoca, ero pienamente convinto che l'avrei fatto.",shape=box,color=blue];
		j3834022301 -> j2087068588;
	j4048204102 [label="+5 Chemistry",color=orange];
		j4048204102 -> j799087713;
	j1532838055 [label="Mi sarei assicurato che tutti gli Esecutori e gli Imperatori venissero... rimossi, e avrei assunto il ruolo di Esecutore Ad Interim fino all'introduzione di un nuovo sistema.",shape=box,color=blue];
		j1532838055 -> j197975169;
	j368544961 [label="Viaggiare nel tempo è divertente in questo senso.",shape=box,color=blue];
		j368544961 -> j590295414;
	j2087068588 [label="Ho lottato così duramente per tornare qui solo per rendermi conto che... la mia gente ora è morta. Sarei stato giustiziato insieme a tutti gli altri.",shape=box,color=blue];
		j2087068588 -> j2633128159;
	j799087713 [label="Zitto, tu.",shape=box,color=blue];
		j799087713 -> j324273766;
	j197975169 [label="Non so quanto tempo ci sarebbe voluto, ma sarebbe stato meglio di quello che è successo dopo la Grande Guerra, no?",shape=box,color=blue];
		j197975169 -> j3800113628;
		j197975169 -> j2154763076;
		j197975169 -> j3335629052;
	j590295414 [label="In pochi anni, secondo la mia percezione, migliaia di persone sono morte nella \"realtà\", dove l'Impero è caduto e il mio popolo è stato sterminato. ",shape=box,color=blue];
		j590295414 -> j478598448;
	j2633128159 [label="I Tenno mi avrebbero massacrato insieme a tutti gli altri nella notte dei Tamburi Naga. Probabilmente sarei morto nel tentativo di salvare la vita di Nitokh.",shape=box,color=blue];
		j2633128159 -> j3516756255;
	j324273766 [label="All'epoca ero pienamente convinto che l'avrei fatto. Ma ora non ha più importanza, vero?",shape=box,color=blue];
		j324273766 -> j2087068588;
	j478598448 [label="Mi sono reso conto che non sarebbe importato se avessi ceduto il potere o meno, anche se in quel momento ero convinto che l'avrei fatto.",shape=box,color=blue];
		j478598448 -> j2633128159;
	j3516756255 [label="Chissà che fine ha fatto? I documenti non menzionano nemmeno il suo nome... tutti gli orrori commessi in suo nome, tutte le morti, tutte le tragedie... e forse sono l'unico a conoscerli.",shape=box,color=blue];
		j3516756255 -> j1832173597;
	j1832173597 [label="Beh. Quello e qualsiasi cosa possa essere sbloccata in futuro dalla mente del Tenno tramite quel Refrattario Oscuro. Ma questo non è certo un problema che devo risolvere io.",shape=box,color=blue];
		j1832173597 -> j3499582199;
		j1832173597 -> j3731273858;
		j1832173597 -> j62083914;
	j3499582199 [label="Sembri un po' intimidito dal ragazzo.",shape=box,color=red];
		j3499582199 -> j653565770;
	j3731273858 [label="Cosa è successo tra te e Nitokh?",shape=box,color=red];
		j3731273858 -> j2169462155;
	j62083914 [label="Quindi progettavi di tradire gli Orokin?",shape=box,color=red];
		j62083914 -> j843373347;
	j653565770 [label="Ho visto un gruppo di bambini in età scolare, devastati dal Void, pilotare a distanza macchine da guerra Infested, che un tempo furono soldati e che ora erano state trasformate in opere d'arte grottesche, belle e letali, distruggere interi battaglioni di soldati. ",shape=box,color=blue];
		j653565770 -> j1936378229;
	j2169462155 [label="Tutto.",shape=box,color=blue];
		j2169462155 -> j3435232957;
	j843373347 [label="Sì. Entrambi lo progettavamo. Anche se credo che Nitokh avesse intenzione di tradirmi, e anch'io avevo intenzione di tradire Nitokh. Sai come funzionano le cose tra noi Orokin.",shape=box,color=blue];
		j843373347 -> j2380326639;
	j1936378229 [label="Ho scoperto che hanno distrutto il mio Impero. Un Impero che governava l'intero Sistema Origin. E che stavano per spazzare via la ribellione su Tau.",shape=box,color=blue];
		j1936378229 -> j3270966780;
	j3435232957 [label="Tutto è successo tra Nitokh e me.",shape=box,color=blue];
		j3435232957 -> j3221336896;
	j2380326639 [label="Tutti complottano sempre contro tutti gli altri. È solo un altro giorno della settimana, in realtà.",shape=box,color=blue];
		j2380326639 -> j3376075756;
	j3270966780 [label="E lo fecero in una notte.",shape=box,color=blue];
		j3270966780 -> j1574681775;
	j3221336896 [label="Tutto e di più.",shape=box,color=blue];
		j3221336896 -> j2862214600;
	j3376075756 [label="I tradimenti tra Orokin erano piuttosto comuni. Ma tradire l'intero Impero? Quel tipo di tradimento meritava non solo l'esecuzione tramite Luce di Jade, ma anche il Programma Cephalon.",shape=box,color=blue];
		j3376075756 -> j1500183088;
	j1574681775 [label="Tu non lo saresti?!",shape=box,color=blue];
		j1574681775 -> j2226287410;
	j2862214600 [label="E questo è tutto ciò che desidero dire su questo argomento al momento.",shape=box,color=blue];
		j2862214600 -> j3619901052;
	j1500183088 [label="Boolean RoatheTraitor1 is now true.",color=orange];
		j1500183088 -> j737412888;
		j1500183088 -> j341255632;
	j2226287410 [label="Non riesco a esprimere ciò che abbiamo rischiato tentando di uccidere gli Esecutori - per non parlare di tutti gli Orokin, Usurpatore.",shape=box,color=blue];
		j2226287410 -> j3376075756;
	j3619901052 [label="Boolean RoatheExecutor1 is now true.",color=orange];
		j3619901052 -> j2226287410;
	j737412888 [label="Quale dei due hai ritenuto peggiore dell'altro?",shape=box,color=red];
		j737412888 -> j3907431934;
	j341255632 [label="Quindi quel tipo di schema non era normale?",shape=box,color=red];
		j341255632 -> j2566089240;
	j3907431934 [label="Il Programma Cephalon di Nihil, senza dubbio. Le creazioni del Vetraio sono...",shape=box,color=blue];
		j3907431934 -> j1520559256;
	j2566089240 [label="L'esistenza dell'Impero Orokin in bilico sulla lama di un pugnale, Usurpatore. Ronzante sull'orlo della distruzione. Solo una cosa lo manteneva operativo:",shape=box,color=blue];
		j2566089240 -> j631438282;
	j1520559256 [label="La Luce di Jade è rapida per coloro che non hanno armature o scudi per sopravvivere a un singolo colpo. È una morte misericordiosa.",shape=box,color=blue];
		j1520559256 -> j908252871;
	j631438282 [label="Norme sociali.",shape=box,color=blue];
		j631438282 -> j704664843;
	j908252871 [label="Il processo di conversione in Cephalon, se eseguito su un soggetto consenziente, può essere indolore e persino eseguito in modo non distruttivo. Tuttavia... quando è utilizzato a scopo punitivo?",shape=box,color=blue];
		j908252871 -> j502060649;
	j704664843 [label="Qualcuno non si è semplicemente ribellato e ha ucciso gli Orokin! Era impensabile, Drifter! Impensabile! Assolutamente ridicolo!",shape=box,color=blue];
		j704664843 -> j626315363;
	j502060649 [label="I ricordi sono sacri per gli Orokin, Drifter. Sono tutto ciò che siamo. I nostri corpi sono temporanei. I nostri volti, le nostre voci, il nostro sangue, è tutto mutevole. Tutto può cambiare, come la moda.",shape=box,color=blue];
		j502060649 -> j4186474857;
	j626315363 [label="Il che, alla fine, ha reso il tutto comicamente facile. Come sono sicuro abbia imparato il tuo duplicato Tenno. ",shape=box,color=blue];
		j626315363 -> j3236824143;
		j626315363 -> j2378435583;
	j4186474857 [label="Check boolean RoatheKnowsReset2",color=orange];
		j4186474857 -> j1516321376 [label=true,color=green];
		j4186474857 -> j3236824143 [label=false,color=brown];
		j4186474857 -> j2378435583 [label=false,color=brown];
	j3236824143 [label="Ma è evidente che non ti sei mai applicato abbastanza per fare un tentativo.",shape=box,color=red];
		j3236824143 -> j2745098065;
	j2378435583 [label="Cosa è successo al tuo piano?",shape=box,color=red];
		j2378435583 -> j652053828;
	j1516321376 [label="Il che, tra l'altro, potrebbe essere il motivo per cui sono così profondamente e totalmente irritato con te per esserti intromesso. ",shape=box,color=blue];
		j1516321376 -> j3236824143;
		j1516321376 -> j2378435583;
	j2745098065 [label="Evaluate expressions on HellStory counter",color=orange];
		j2745098065 -> j3167630881 [label="x >= 21",color=purple];
		j2745098065 -> j4157676668 [label="x < 21",color=purple];
		j2745098065 -> j4157676668 [label="false",color=purple];
	j652053828 [label="Evaluate expressions on HellStory counter",color=orange];
		j652053828 -> j3185182934 [label="x >= 21",color=purple];
		j652053828 -> j4103176865 [label="x < 21",color=purple];
		j652053828 -> j4103176865 [label="false",color=purple];
	j3167630881 [label="Hai ragione, è ovvio! Albercht mi ha incrociato in quel corridoio prima che Nitokh e io avessimo il tempo di far scattare la trappola per gli Esecutori.",shape=box,color=blue];
		j3167630881 -> j2926153123;
	j4157676668 [label="No, chiaramente no. Sono stato trasformato con la forza in questa... cosa da Albercht prima che io e Nitokh avessimo il tempo di tendere la trappola agli Esecutori.",shape=box,color=blue];
		j4157676668 -> j4165725750;
	j3185182934 [label="Sai benissimo cosa è successo al nostro piano, vero?! Albercht mi ha incrociato in quel corridoio prima che Nitokh e io avessimo il tempo di far scattare la trappola per gli Esecutori.",shape=box,color=blue];
		j3185182934 -> j1962101290;
	j4103176865 [label="Sono stato trasformato con la forza in questa... cosa da Albercht prima che io e Nitokh avessimo il tempo di tendere la trappola agli Esecutori.",shape=box,color=blue];
		j4103176865 -> j4165725750;
	j2926153123 [label="E mi ha offerto il siero protoframe. E... beh... sappiamo entrambi come è andata a finire.",shape=box,color=blue];
		j2926153123 -> j2403830288;
	j4165725750 [label="Un attimo prima mi ricordo di essere in piedi in un grande corridoio dorato, e quello dopo urlavo di dolore in qualche sperduto buco infernale della \"Gaule\".",shape=box,color=blue];
		j4165725750 -> j2403940174;
	j1962101290 [label="Mi ha offerto il siero Protoframe e sappiamo entrambi cosa è successo!",shape=box,color=blue];
		j1962101290 -> j2403830288;
	j2403830288 [label="Una questione per cui sono ancora. Furioso. Perché?! Perché ti ho confessato questo?! Perché lo sai?! ",shape=box,color=blue];
		j2403830288 -> j4016363549;
	j2403940174 [label="Nitokh deve aver abbandonato il piano dopo la mia scomparsa. Probabilmente, ha addossato a me tutta la responsabilità del tradimento, usandomi come capro espiatorio.",shape=box,color=blue];
		j2403940174 -> j1058734407;
	j4016363549 [label="Bah! No. Non importa. Devo andare ora, prima che in un impeto di rabbia rompa questo dannato computer.",shape=box,color=blue];
		j4016363549 -> j1933300832;
	j1058734407 [label="Questo spiega tutti i documenti che ho trovato in cui mi chiamano \"codardo\". Ovviamente mi avrebbero considerato un codardo - pensavano che fossi scappato! Pah.",shape=box,color=blue];
		j1058734407 -> j4189043807;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j4189043807 [label="+10 Chemistry",color=orange];
		j4189043807 -> j1519919111;
	j1519919111 [label="È bello sapere che il mio ruolo fosse così fondamentale per il piano che, è stato necessario abbandonarlo completamente dopo la mia partenza.",shape=box,color=blue];
		j1519919111 -> j3210427936;
		j1519919111 -> j943691941;
	j3210427936 [label="Non so se è questo che dovresti capire da tutto questo.",shape=box,color=red];
		j3210427936 -> j2126982132;
	j943691941 [label="È bello sentirsi necessari.",shape=box,color=red];
		j943691941 -> j4111731369;
	j2126982132 [label="Add 1 to Thermostat counter",color=orange];
		j2126982132 -> j89390746;
	j4111731369 [label="+5 Chemistry",color=orange];
		j4111731369 -> j748340943;
	j89390746 [label="Tu trovi il tuo valore dove vuoi, Drifter, e lascia che io trovi il mio.",shape=box,color=blue];
