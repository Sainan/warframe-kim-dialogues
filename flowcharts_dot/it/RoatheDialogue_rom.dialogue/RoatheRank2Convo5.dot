digraph {
	1224 [label="RoatheRank2Convo5 begins.",color=orange];
		1224 -> 1225;
	1225 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1225 -> 1226 [label=true,color=green];
		1225 -> 1227 [label=false,color=brown];
	1226 [label="Check boolean RoatheKnowsReset2",color=orange];
		1226 -> 1229 [label=true,color=green];
		1226 -> 1228 [label=false,color=brown];
	1227 [label="Chat ends.",color=orange];
	1229 [label="Quanto ti ha raccontato il Roathe del Passato dei suoi rapporti con l'Esecutrice Nitokh? Bah. Cerco di ricostruire il tutto: il mio io precedente ti ha confidato informazioni così personali... solo per farti cancellare tutto dalla mia mente?",shape=box,color=blue];
		1229 -> 1232;
	1228 [label="Evaluate expressions on HellStory",color=orange];
		1228 -> 1231 [label="x >= 1",color=purple];
		1228 -> 1230 [label="x <= 1",color=purple];
		1228 -> 1230 [label="false",color=purple];
	1232 [label="Mi brucia. Il fatto che avrei potuto dirti tutto, proprio tutto - metterti a nudo ogni mio pensiero più intimo, e tu... hai cancellato tutto di nuovo. Come se fossi solo un giocattolino per te.",shape=box,color=blue];
		1232 -> 1234;
	1231 [label="Mi hai già sentito parlare dell'Esecutrice Nitokg. E dei miei... rapporti con lei. Devi cercare di capire che l'Impero Orokin non era del tutto malvagio.",shape=box,color=blue];
		1231 -> 1233;
	1230 [label="Chat ends.",color=orange];
	1234 [label="Suppongo sia giusto così. È così che noi Orokin abbiamo trattato l'umanità, no? Il Teatro Yuvan? Sfilare corpi bellissimi e scegliere a nostro piacimento le nostre nuove identità, torturarci a vicenda con giochi per un divertimento malato, come meglio credevamo...",shape=box,color=blue];
		1234 -> 1236;
	1233 [label="Mi spezza il cuore che venga ricordato solo per la sua devastazione e depravazione. Sì, ce n'era molta, non lo nego. ",shape=box,color=blue];
		1233 -> 1235;
	1236 [label="Lo odio. Lo odio davvero, davvero tanto.",shape=box,color=blue];
		1236 -> 1239;
		1236 -> 1240;
		1236 -> 1238;
	1235 [label="Ma era anche capace di tanta bellezza. Tanta gioia. Tanto amore. Tanti progressi scientifici e artistici. Guarda cosa siamo stati capaci di realizzare! ",shape=box,color=blue];
		1235 -> 1237;
	1239 [label="Anche se non era mia intenzione ferirti in questo modo, e mi dispiace di averlo fatto, se questo ti ha insegnato cosa significhi trovarsi dall'altra parte dell'Impero Orokin, allora è stata una lezione preziosa.",shape=box,color=red];
		1239 -> 1245;
	1240 [label="Non ho mai voluto che questo ti ferisse in questo modo. Non dovresti scusarti per il modo in cui funzionava la società Orokin - non l'hai costruita tu. Stavi solo cercando di salvarla.",shape=box,color=red];
		1240 -> 1246;
	1238 [label="[Fine.]",shape=box,color=red];
		1238 -> 1244;
	1237 [label="Quindi, quando Nitokh mi convocò al suo cospetto e mi disse che voleva uccidere tutti gli Orokin? accettai immediatamente. Volevo tagliare la testa al serpente avvelenato. Volevo sostituirlo con un sistema più benigno. Un sovrano più benigno.",shape=box,color=blue];
		1237 -> 1241;
		1237 -> 1242;
		1237 -> 1243;
	1245 [label="Add 3 to Thermostat",color=orange];
		1245 -> 1250;
	1246 [label="Add -3 to Thermostat",color=orange];
		1246 -> 1251;
	1244 [label="Chat ends.",color=orange];
	1241 [label="Volevi sostituire gli Imperatori e gli Esecutori con te stesso, intendi dire.",shape=box,color=red];
		1241 -> 1247;
	1242 [label="E chi sarebbe questo sovrano?",shape=box,color=red];
		1242 -> 1248;
	1243 [label="[Fine.]",shape=box,color=red];
		1243 -> 1249;
	1250 [label="L'Impero Orokin non era completamente malvagio. Mi spezza il cuore che venga ricordato solo per la sua devastazione e depravazione. Sì, ce n'era molta, non lo nego.",shape=box,color=blue];
		1250 -> 1253;
	1251 [label="Se solo gli altri avessero potuto vederla in questo modo. Se solo Nitokh l'avesse vista in questo modo. ",shape=box,color=blue];
		1251 -> 1254;
	1247 [label="Perché sì, ovvio!",shape=box,color=blue];
		1247 -> 1252;
	1248 [label="Me stesso, ovvio.",shape=box,color=blue];
		1248 -> 1252;
	1249 [label="Chat ends.",color=orange];
	1253 [label="Ma era anche capace di tanta bellezza. Tanta gioia. Tanto amore. Tanti progressi scientifici e artistici. Guarda cosa siamo stati capaci di realizzare! ",shape=box,color=blue];
		1253 -> 1256;
	1254 [label="L'Impero Orokin non era completamente malvagio. Mi spezza il cuore che venga ricordato solo per la sua devastazione e depravazione. Sì, ce n'era molta, non lo nego.",shape=box,color=blue];
		1254 -> 1253;
	1252 [label="Mi sarei assicurato che tutti gli Esecutori e gli Imperatori venissero... rimossi, e avrei assunto il ruolo di Esecutore Ad Interim fino all'introduzione di un nuovo sistema.",shape=box,color=blue];
		1252 -> 1255;
	1256 [label="Quindi, quando Nitokh mi convocò al suo cospetto e mi disse che voleva uccidere tutti gli Orokin? accettai immediatamente. Volevo tagliare la testa al serpente avvelenato. Volevo sostituirlo con un sistema più benigno. Un sovrano più benigno.",shape=box,color=blue];
		1256 -> 1260;
		1256 -> 1261;
	1255 [label="Non so quanto tempo ci sarebbe voluto, ma sarebbe stato meglio di quello che è successo dopo la Grande Guerra, no?",shape=box,color=blue];
		1255 -> 1257;
		1255 -> 1258;
		1255 -> 1259;
	1260 [label="Volevi sostituire gli Imperatori e gli Esecutori con te stesso, intendi dire.",shape=box,color=red];
		1260 -> 1265;
	1261 [label="E chi sarebbe questo sovrano?",shape=box,color=red];
		1261 -> 1266;
	1257 [label="Grande Guerra?",shape=box,color=red];
		1257 -> 1262;
	1258 [label="Sii onesto con te stesso, pensi che avresti mai rinunciato al potere?",shape=box,color=red];
		1258 -> 1263;
	1259 [label="Non credo che avresti mai rinunciato al potere, Roathe.",shape=box,color=red];
		1259 -> 1264;
	1265 [label="Perché sì, ovviamente! E non fingere di non averlo mai sentito prima, sono certo di sì. ",shape=box,color=blue];
		1265 -> 1270;
	1266 [label="Me stesso, ovviamente. E non fingere di non averlo mai sentito prima, sono certo di sì.",shape=box,color=blue];
		1266 -> 1270;
	1262 [label="Ora la chiamate ''Vecchia Guerra''. Per me non è affatto ''Vecchia'', è accaduta solo pochi anni fa, almeno secondo i miei ricordi.",shape=box,color=blue];
		1262 -> 1267;
	1263 [label="Mm. Non lo so. Ormai non ha più importanza, no? Ma all'epoca, ero pienamente convinto che l'avrei fatto.",shape=box,color=blue];
		1263 -> 1268;
	1264 [label="+5 Chemistry",color=orange];
		1264 -> 1269;
	1270 [label="Mi sarei assicurato che tutti gli Esecutori e gli Imperatori venissero... rimossi, e avrei assunto il ruolo di Esecutore Ad Interim fino all'introduzione di un nuovo sistema.",shape=box,color=blue];
		1270 -> 1274;
	1267 [label="Viaggiare nel tempo è divertente in questo senso.",shape=box,color=blue];
		1267 -> 1271;
	1268 [label="Ho lottato così duramente per tornare qui solo per rendermi conto che... la mia gente ora è morta. Sarei stato giustiziato insieme a tutti gli altri.",shape=box,color=blue];
		1268 -> 1272;
	1269 [label="Zitto, tu.",shape=box,color=blue];
		1269 -> 1273;
	1274 [label="Non so quanto tempo ci sarebbe voluto, ma sarebbe stato meglio di quello che è successo dopo la Grande Guerra, no?",shape=box,color=blue];
		1274 -> 1258;
		1274 -> 1259;
		1274 -> 1257;
	1271 [label="In pochi anni, secondo la mia percezione, migliaia di persone sono morte nella \"realtà\", dove l'Impero è caduto e il mio popolo è stato sterminato. ",shape=box,color=blue];
		1271 -> 5775;
	1272 [label="I Tenno mi avrebbero massacrato insieme a tutti gli altri nella notte dei Tamburi Naga. Probabilmente sarei morto nel tentativo di salvare la vita di Nitokh.",shape=box,color=blue];
		1272 -> 1275;
	1273 [label="All'epoca ero pienamente convinto che l'avrei fatto. Ma ora non ha più importanza, vero?",shape=box,color=blue];
		1273 -> 1268;
	5775 [label="Mi sono reso conto che non sarebbe importato se avessi ceduto il potere o meno, anche se in quel momento ero convinto che l'avrei fatto.",shape=box,color=blue];
		5775 -> 1272;
	1275 [label="Chissà che fine ha fatto? I documenti non menzionano nemmeno il suo nome... tutti gli orrori commessi in suo nome, tutte le morti, tutte le tragedie... e forse sono l'unico a conoscerli.",shape=box,color=blue];
		1275 -> 1276;
	1276 [label="Beh. Quello e qualsiasi cosa possa essere sbloccata in futuro dalla mente del Tenno tramite quel Refrattario Oscuro. Ma questo non è certo un problema che devo risolvere io.",shape=box,color=blue];
		1276 -> 1277;
		1276 -> 1278;
		1276 -> 1279;
	1277 [label="Sembri un po' intimidito dal ragazzo.",shape=box,color=red];
		1277 -> 1280;
	1278 [label="Cosa è successo tra te e Nitokh?",shape=box,color=red];
		1278 -> 1281;
	1279 [label="Quindi progettavi di tradire gli Orokin?",shape=box,color=red];
		1279 -> 1282;
	1280 [label="Ho visto un gruppo di bambini in età scolare, devastati dal Void, pilotare a distanza macchine da guerra Infested, che un tempo furono soldati e che ora erano state trasformate in opere d'arte grottesche, belle e letali, distruggere interi battaglioni di soldati. ",shape=box,color=blue];
		1280 -> 1283;
	1281 [label="Tutto.",shape=box,color=blue];
		1281 -> 1284;
	1282 [label="Sì. Entrambi lo progettavamo. Anche se credo che Nitokh avesse intenzione di tradirmi, e anch'io avevo intenzione di tradire Nitokh. Sai come funzionano le cose tra noi Orokin.",shape=box,color=blue];
		1282 -> 1285;
	1283 [label="Ho scoperto che hanno distrutto il mio Impero. Un Impero che governava l'intero Sistema Origin. E che stava per spazzare via la ribellione su Tau.",shape=box,color=blue];
		1283 -> 1286;
	1284 [label="Tutto è successo tra Nitokh e me.",shape=box,color=blue];
		1284 -> 1287;
	1285 [label="Tutti complottano sempre contro tutti gli altri. È solo un altro giorno della settimana, in realtà.",shape=box,color=blue];
		1285 -> 1288;
	1286 [label="E lo fecero in una notte.",shape=box,color=blue];
		1286 -> 1289;
	1287 [label="Tutto e di più.",shape=box,color=blue];
		1287 -> 1290;
	1288 [label="I tradimenti tra Orokin erano piuttosto comuni. Ma tradire l'intero Impero? Quel tipo di tradimento meritava non solo l'esecuzione tramite Luce di Giada, ma anche il Programma Cephalon.",shape=box,color=blue];
		1288 -> 1291;
	1289 [label="Tu non lo saresti?!",shape=box,color=blue];
		1289 -> 1292;
	1290 [label="E questo è tutto ciò che desidero dire su questo argomento al momento.",shape=box,color=blue];
		1290 -> 1293;
	1291 [label="Update boolean RoatheTraitor1",color=orange];
		1291 -> 1294;
		1291 -> 1295;
	1292 [label="Non riesco a esprimere ciò che abbiamo rischiato tentando di uccidere gli Esecutori - per non parlare di tutti gli Orokin, Usurpatore.",shape=box,color=blue];
		1292 -> 1288;
	1293 [label="Update boolean RoatheExecutor1",color=orange];
		1293 -> 1292;
	1294 [label="Quale dei due hai ritenuto peggiore dell'altro?",shape=box,color=red];
		1294 -> 1296;
	1295 [label="Quindi quel tipo di schema non era normale?",shape=box,color=red];
		1295 -> 1297;
	1296 [label="Il Programma Cephalon di Nihil, senza dubbio. Le creazioni del Vetraio sono...",shape=box,color=blue];
		1296 -> 1298;
	1297 [label="L'esistenza dell'Impero Orokin in bilico sulla lama di un pugnale, Usurpatore. Ronzante sull'orlo della distruzione. Solo una cosa lo manteneva operativo:",shape=box,color=blue];
		1297 -> 1299;
	1298 [label="La Luce di Giada è rapida per coloro che non hanno armature o scudi per sopravvivere a un singolo colpo. È una morte misericordiosa.",shape=box,color=blue];
		1298 -> 1300;
	1299 [label="Norme sociali.",shape=box,color=blue];
		1299 -> 1301;
	1300 [label="I Cephalon, quando vengono convertiti da un soggetto consenziente, possono essere indolori, e persino eseguiti in modo non distruttivo. Tuttavia... quando vengono utilizzati a scopo punitivo?",shape=box,color=blue];
		1300 -> 1302;
	1301 [label="Qualcuno non si è semplicemente ribellato e ha ucciso gli Orokin! Era impensabile, Drifter! Impensabile! Assolutamente ridicolo!",shape=box,color=blue];
		1301 -> 1303;
	1302 [label="I ricordi sono sacri per gli Orokin, Drifter. Sono tutto ciò che siamo. I nostri corpi sono temporanei. I nostri volti, le nostre voci, il nostro sangue, è tutto mutevole. Tutto può cambiare, come la moda.",shape=box,color=blue];
		1302 -> 1304;
	1303 [label="Il che, alla fine, ha reso il tutto comicamente facile. Come sono sicuro abbia imparato il tuo duplicato Tenno. ",shape=box,color=blue];
		1303 -> 1305;
		1303 -> 1306;
	1304 [label="Check boolean RoatheKnowsReset2",color=orange];
		1304 -> 1307 [label=true,color=green];
		1304 -> 1305 [label=false,color=brown];
		1304 -> 1306 [label=false,color=brown];
	1305 [label="Ma è evidente che non ti sei mai applicato abbastanza per fare un tentativo.",shape=box,color=red];
		1305 -> 1308;
	1306 [label="Cosa è successo al tuo piano?",shape=box,color=red];
		1306 -> 1309;
	1307 [label="Il che, tra l'altro, potrebbe essere il motivo per cui sono così profondamente e totalmente irritato con te per esserti intromesso. ",shape=box,color=blue];
		1307 -> 1305;
		1307 -> 1306;
	1308 [label="Evaluate expressions on HellStory",color=orange];
		1308 -> 1310 [label="x >= 21",color=purple];
		1308 -> 1311 [label="x < 21",color=purple];
		1308 -> 1311 [label="false",color=purple];
	1309 [label="Evaluate expressions on HellStory",color=orange];
		1309 -> 1312 [label="x >= 21",color=purple];
		1309 -> 5777 [label="x < 21",color=purple];
		1309 -> 5777 [label="false",color=purple];
	1310 [label="Hai ragione, è ovvio! Albercht mi ha incrociato in quel corridoio prima che Nitokh e io avessimo il tempo di far scattare la trappola per gli Esecutori.",shape=box,color=blue];
		1310 -> 1313;
	1311 [label="No, chiaramente no. Sono stato trasformato con la forza in questa... cosa da Albercht prima che io e Nitokh avessimo il tempo di tendere la trappola agli Esecutori.",shape=box,color=blue];
		1311 -> 1314;
	1312 [label="Sai benissimo cosa è successo al nostro piano, vero?! Albercht mi ha incrociato in quel corridoio prima che Nitokh e io avessimo il tempo di far scattare la trappola per gli Esecutori.",shape=box,color=blue];
		1312 -> 1315;
	5777 [label="Sono stato trasformato con la forza in questa... cosa da Albercht prima che io e Nitokh avessimo il tempo di tendere la trappola agli Esecutori.",shape=box,color=blue];
		5777 -> 1314;
	1313 [label="E mi ha offerto il siero protoframe. E... beh... sappiamo entrambi come è andata a finire.",shape=box,color=blue];
		1313 -> 1316;
	1314 [label="Un attimo prima mi ricordo di essere in piedi in un grande corridoio dorato, e quello dopo urlavo di dolore in qualche sperduto buco infernale della \"Gaule\".",shape=box,color=blue];
		1314 -> 1317;
	1315 [label="Mi ha offerto il siero Protoframe e sappiamo entrambi cosa è successo!",shape=box,color=blue];
		1315 -> 1316;
	1316 [label="Una questione per cui sono ancora. Furioso. Perché?! Perché ti ho confessato questo?! Perché lo sai?! ",shape=box,color=blue];
		1316 -> 1318;
	1317 [label="Nitokh deve aver abbandonato il piano dopo la mia scomparsa. Probabilmente, ha addossato a me tutta la responsabilità del tradimento, usandomi come capro espiatorio.",shape=box,color=blue];
		1317 -> 1319;
	1318 [label="Bah! No. Non importa. Devo andare ora, prima che in un impeto di rabbia rompa questo dannato computer.",shape=box,color=blue];
		1318 -> 1320;
	1319 [label="Questo spiega tutti i documenti che ho trovato in cui mi chiamano \"codardo\". Ovviamente mi avrebbero considerato un codardo - pensavano che fossi scappato! Pah.",shape=box,color=blue];
		1319 -> 1321;
	1320 [label="+10 Chemistry",color=orange];
		1320 -> 1322;
	1321 [label="+10 Chemistry",color=orange];
		1321 -> 1323;
	1322 [label="Chat ends.",color=orange];
	1323 [label="È bello sapere che io fossi così fondamentale per il piano che, una volta andato via, fosse stato necessario abbandonarlo completamente.",shape=box,color=blue];
		1323 -> 1324;
		1323 -> 1325;
	1324 [label="Non so se è questo che dovresti capire da tutto questo.",shape=box,color=red];
		1324 -> 1326;
	1325 [label="È bello sentirsi necessari.",shape=box,color=red];
		1325 -> 1327;
	1326 [label="Add 1 to Thermostat",color=orange];
		1326 -> 1328;
	1327 [label="+5 Chemistry",color=orange];
		1327 -> 1329;
	1328 [label="Tu trovi il tuo valore dove vuoi, Drifter, e lascia che io trovi il mio.",shape=box,color=blue];
		1328 -> 1330;
	1329 [label="Add -1 to Thermostat",color=orange];
		1329 -> 1331;
	1330 [label="Chat ends.",color=orange];
	1331 [label="Vedi? Tu capisci.",shape=box,color=blue];
		1331 -> 1332;
