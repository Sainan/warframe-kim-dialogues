	j525680968 [label="MV: STANDARD",shape=box,color=blue];
		j525680968 -> j1294826822;
	j1294826822 [label="Trascrizione: Niente esprime la pomposità con cui noi creature trattiamo la carneficina della guerra quanto i portabandiera.",shape=box,color=blue];
		j1294826822 -> j2108659640;
	j2108659640 [label="Coloro che devono essere protetti a tutti i costi e seguiti senza esitazione.",shape=box,color=blue];
		j2108659640 -> j2521096315;
	j2521096315 [label="E che possono essere minacciati, aggiungerei, di eseguire ordini che nessun soldato sano di mente eseguirebbe mai, per timore di finire in qualche modo per subire un destino ancora più terribile. ",shape=box,color=blue];
		j2521096315 -> j90132552;
	j90132552 [label="Per quanto ridicolo sia.",shape=box,color=blue];
		j90132552 -> j3697588324;
	j3697588324 [label="Erano sempre le loro forme ad attirare il mio sguardo tra le altre, sebbene i loro corpi mutilati non fossero diversi da tutti gli altri. ",shape=box,color=blue];
		j3697588324 -> j340074285;
	j340074285 [label="Era sempre la base che ancora portavano, scintillante nel suo oro Orokin e macchiato di cremisi screziato.",shape=box,color=blue];
		j340074285 -> j318311576;
	j318311576 [label="Mi assicuravo sempre che svettasse fiero sul campo prima di partire.",shape=box,color=blue];
		j318311576 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}