	5694 [label="Coloro che devono essere protetti a tutti i costi e seguiti senza esitazione.",shape=box,color=blue];
		5694 -> 5695;
	5695 [label="E che possono essere minacciati, aggiungerei, di eseguire ordini che nessun soldato sano di mente eseguirebbe mai, per timore di finire in qualche modo per subire un destino ancora più terribile. ",shape=box,color=blue];
		5695 -> 2203;
	2203 [label="Per quanto ridicolo sia.",shape=box,color=blue];
		2203 -> 5731;
	5731 [label="Erano sempre le loro forme ad attirare il mio sguardo tra le altre, sebbene i loro corpi mutilati non fossero diversi da tutti gli altri. ",shape=box,color=blue];
		5731 -> 2195;
	2195 [label="Era sempre la base che ancora portavano, scintillante nel suo oro Orokin e macchiato di cremisi screziato.",shape=box,color=blue];
