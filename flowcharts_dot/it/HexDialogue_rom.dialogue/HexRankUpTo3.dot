	90 [label="Soldja1Shot1kil: famme finì. diciamo ke c'ho fame, ma nell'area de ristoro c'è 'sta pubblicità vomitevole e zuccherosa ke me rimbomba nelle orecchie. potrei riempilla de pallettoni finké nun esce solo 'n ronzio?",shape=box,color=blue];
