		3392 -> 3394;
	3393 [label="oh, lo siamo! Amir è il mio migliore amico. alcuni dei miei ricordi preferiti sono noi due nella sala giochi, a giocare e a scatenarci con gli On-lyne",shape=box,color=blue];
