		j1708908734 -> j319482257;
	j1949337514 [label="E quando rinvenne, era di nuovo nel suo laboratorio, solo che non lo era. E si stava guardando negli occhi. Solo che non era lui. E \"lui\" lo chiamò con un nome che solo sua madre avrebbe saputo.",shape=box,color=red];
