		2936 -> 2937;
	2940 [label="ugh. Gli Scaldra. Probabilmente li hanno distrutti. Perché avrebbero dovuto lasciare che qualcosa di speranzoso come uno strumento sopravvivesse in questo posto?",shape=box,color=blue];
		2940 -> 2941;
	2959 [label="E quando parlano, all'inizo era tutto così senza speranza. Così sbagliato. La Lingua Void ha lasciato che queste creature provassero solo una cosa all'inizio: la mancanza di speranza.",shape=box,color=red];
