digraph {
	2825 [label="AoiRank4Convo6 begins.",color=orange];
		2825 -> 2826;
	2826 [label="mi hai raccontato tante storie terribili sugli Orokin... c'è mai stato qualcuno che ha voltato le spalle al loro stile di vita?",shape=box,color=blue];
		2826 -> 2827;
		2826 -> 2828;
	2827 [label="Che tu ci creda o no, il Dottor Albrecht Entrati.",shape=box,color=red];
		2827 -> 2829;
	2828 [label="La maggior parte di loro è morta. Ma Albrecht Entrati sì, a modo suo.",shape=box,color=red];
		2828 -> 2830;
	2829 [label="ew.",shape=box,color=blue];
		2829 -> 2831;
	2830 [label="ugh, quel tizio. sfugge sempre alla morsa della morte.",shape=box,color=blue];
		2830 -> 2831;
	2831 [label="e io che speravo che fosse qualcuno... di più figo.",shape=box,color=blue];
		2831 -> 2835;
		2831 -> 2834;
	2835 [label="Mi dispiace deluderti. È lui. Ha rifiutato il Kuva, che permette loro di essere immortali. Non ha scelto il lungo braccio alla moda. Niente di tutto ciò.",shape=box,color=red];
		2835 -> 2833;
	2834 [label="Sì ehm... Penserò a un Orokin più figo. Dammi un minuto.",shape=box,color=red];
