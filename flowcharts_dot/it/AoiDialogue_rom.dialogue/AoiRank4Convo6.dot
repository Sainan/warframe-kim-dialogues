	2855 [label="grazie. ^_^",shape=box,color=blue];
		2855 -> 2857;
	2857 [label="non subito, ma abbastanza presto, avevo la spiacevole sensazione che stesse per accadere qualcosa di brutto ogni volta che era gentile",shape=box,color=blue];
		2857 -> 2858;
	2858 [label="e all'epoca, non avevo le parole per descriverlo, ma mi sembrava sempre che ci fosse LUI dietro qualsiasi cosa andasse storta.",shape=box,color=blue];
		2858 -> 2859;
