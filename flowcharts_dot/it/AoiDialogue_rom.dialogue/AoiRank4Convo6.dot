		2833 -> 2836;
		2833 -> 2837;
	2832 [label="beh, ci sei tu, suppongo ^_^",shape=box,color=blue];
		2832 -> 2836;
		2832 -> 2837;
		2832 -> 2838;
	2836 [label="Hai mai avuto rispetto per Entrati?",shape=box,color=red];
		2836 -> 2839;
	2837 [label="Cosa ne pensi davvero di Entrati? Al di là del “non figo”.",shape=box,color=red];
		2837 -> 2840;
	2838 [label="Hah. Non sono un Orokin. Vengo solo dal loro impero. Molto diverso.",shape=box,color=red];
		2838 -> 2841;
	2839 [label="hmm. ora tiri fuori le domande importanti, eh? immagino che te lo sia guadagnato.",shape=box,color=blue];
		2839 -> 2843;
	2840 [label="non ho più alcun rispetto per quel tizio ^_^",shape=box,color=blue];
		2840 -> 2843;
	2841 [label="ooooh. confusionario",shape=box,color=blue];
		2841 -> 2842;
	2843 [label="le persone come lui fingono di essere affascinanti solo quando fa loro comodo",shape=box,color=blue];
		2843 -> 2844;
		2843 -> 2845;
	2842 [label="non mi è mai piaciuto entrati. le persone come lui fingono di essere affascinanti solo quando fa loro comodo",shape=box,color=blue];
		2842 -> 2844;
		2842 -> 2845;
	2844 [label="Cosa pensi che stia realmente cercando?",shape=box,color=red];
		2844 -> 2846;
	2845 [label="Quindi a un certo punto l'hai trovato affascinante.",shape=box,color=red];
		2845 -> 2847;
	2846 [label="controllo. dominio completo.",shape=box,color=blue];
		2846 -> 2848;
	2847 [label="non arriverei a tanto. più che altro ero disposta a rispettarlo.",shape=box,color=blue];
