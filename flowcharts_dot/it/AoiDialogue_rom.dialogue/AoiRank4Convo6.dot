		2871 -> 2872;
		2871 -> 2873;
	2872 [label="Ha lasciato una figlia che sta ancora cercando di rimettere insieme i pezzi che lui ha frantumato. Per quanto sia arrabbiata, sento che non può fare a meno di credere in lui.",shape=box,color=red];
