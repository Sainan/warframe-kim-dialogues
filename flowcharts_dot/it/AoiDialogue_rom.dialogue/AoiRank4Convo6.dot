		2850 -> 2851;
		2850 -> 2852;
		2850 -> 2853;
	2851 [label="E lo sapevi fin dall'inizio? Sei la più intuitiva tra gli Hex. Se c'è qualcuno che avrebbe potuto avere un tale presentimento, quella sei tu.",shape=box,color=red];
		2851 -> 2854;
