	j4290824885 [label="EeeeeeEEEEEEE ci siamo. Scusa, cosa stavi cercando di dirmi?",shape=box,color=blue];
		j4290824885 -> j1368644110;
	j1368644110 [label="tu... hai un'altra persona... da qualche altra parte? o... in qualche altra epoca? non... non è degli hex... vero? ....... aaaaguughhh sarebbe così straaaaano",shape=box,color=blue];
