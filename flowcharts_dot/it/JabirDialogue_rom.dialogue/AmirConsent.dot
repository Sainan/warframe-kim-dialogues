		j1549881934 -> j3881317112;
	j812705029 [label="sì, credo che non abbiamo mai parlato molto della mia famiglia. ABBIAMO COSÌ TANTE ALTRE COSE DI CUI PARLARE, TIPO: HAI UN'ALTRA RELAZIONE?!?!?!",shape=box,color=blue];
		j812705029 -> j3881317112;
	j3881317112 [label="Capisco se questo ti mette a disagio. E voglio che tu sappia che non significa che TU conti meno per me.",shape=box,color=red];
		j3881317112 -> j758627998;
	j758627998 [label="Non è di qui, e non so nemmeno se e come riuscirete ad incontrarvi, ma... è molto importante per me. Ma lo sei anche tu.",shape=box,color=red];
		j758627998 -> j1879414019;
	j1879414019 [label="So solo che potrebbe essere difficile da accettare, e se ti mette a disagio lo comprendo perfettamente. Non volevo solo che pensassi che ti stessi mentendo o che ti stessi nascondendo qualcosa.",shape=box,color=red];
