		j2375334599 -> j1632749951;
	j1394065917 [label="''I ratti ti circondano. Ti prepari per la battaglia, ma non attaccano. Anzi, il più grande inchina la testa verso di te. Ti accorgi che indossa una collana. la catena d'argento scivola via e cade a terra. Il ratto sembra dire, 'questo è per te'.''",shape=box,color=blue];
