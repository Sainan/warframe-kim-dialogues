	j2688700465 [label="\"Perquisisci di nuovo il corpo della guardia, ma non trovi nulla di valore. Pensi di mangiare il biscotto ammuffito finché non ne senti l'odore e ci ripensi subito.\"",shape=box,color=blue];
		j2688700465 -> j3451620922;
	j4158226068 [label="''Perquisisci il corpo della guardia in cerca di qualcosa di valore. Non trovi altro che una pietra focaia e un biscotto ammuffito. Prendi la pietra focaia.''",shape=box,color=blue];
