	4267 [label="Chat ends.",color=orange];
	4268 [label="\"Ti trovi di fronte a un grande ascensore di servizio. Questa non è una semplice prigione?\"",shape=box,color=blue];
		4268 -> 4269;
		4268 -> 4270;
	4269 [label="Torno alla prigione.",shape=box,color=red];
		4269 -> 4271;
