	j935121634 [label="\"Mentre giri la chiave che ti è stata data da una banda di ratti giganteschi e sorprendentemente cordiali, preghi che ciò che si trova oltre la porta sia migliore della prigione che si trova alle tue spalle.\"",shape=box,color=blue];
		j935121634 -> j1236047074;
	"Chat ends. Next chat will be AmirRank6Convo3." [color=orange];
	"Chat ends. Next chat will be AmirRank6Convo2." [color=orange];
	j1236047074 [label="\"Ti trovi di fronte a un grande ascensore di servizio. Questa non è una semplice prigione?\"",shape=box,color=blue];
		j1236047074 -> j3634423622;
		j1236047074 -> j3852109747;
	j3634423622 [label="Torno alla prigione.",shape=box,color=red];
		j3634423622 -> j1355635817;
	j3852109747 [label="Prendo l'ascensore.",shape=box,color=red];
		j3852109747 -> j2433854173;
	j1355635817 [label="''Ti giri e guardi la prigione, pensando 'tornare lì dentro è un'idea stupida.''",shape=box,color=blue];
		j1355635817 -> j839407292;
	j2433854173 [label="''Sali con l'ascensore. Attraverso la gabbia aperta puoi vedere le mura di pietra della prigione sotterranea sostituite da tecnologie sempre più avanzate. E ti chiedi, 'dove diavolo sono?'''",shape=box,color=blue];
		j2433854173 -> j2044905272;
	j839407292 [label="haha... Va bene, prendo l'ascensore.",shape=box,color=red];
		j839407292 -> j2433854173;
	j2044905272 [label="''L'ascensore si apre in una sala piena di macchine e tubi giganti. È una specie di laboratorio?''",shape=box,color=blue];
		j2044905272 -> j1254860141;
	j1254860141 [label="Da una stanza in fondo al corridoio si sente un uomo gridare di dolore.",shape=box,color=blue];
		j1254860141 -> j2386317298;
		j1254860141 -> j436497585;
	j2386317298 [label="Ignoro le grida, e cerco una via d'uscita.",shape=box,color=red];
		j2386317298 -> j701914936;
	j436497585 [label="Mi avvicino alle grida.",shape=box,color=red];
		j436497585 -> j2031200482;
	j701914936 [label="''Ti addentri nel corridoio cercando un qualcosa di un qualche valore, ma le grida diventano impossibili da ignorare. Sei attratto da quest'uomo e devi aiutarlo.''",shape=box,color=blue];
		j701914936 -> j2031200482;
	j2031200482 [label="''Percorri il corridoio seguendo la fonte delle grida. Entri in una grande sala macchine, e vedi un uomo. Un uomo non poco attraente, legato a una macchina. Scariche elettriche danzano dalle sue dita, alimentando una turbina gigante.''",shape=box,color=blue];
		j2031200482 -> j2971755422;
		j2031200482 -> j1681737619;
	j2971755422 [label="Chiedo, ''Che succede?''",shape=box,color=red];
		j2971755422 -> j3301057325;
	j1681737619 [label="Esamino l'uomo.",shape=box,color=red];
		j1681737619 -> j3301057325;
	j3301057325 [label="''L'uomo è legato a una piattaforma rialzata, con le braccia distese. Attaccate alla punta delle sue dita ci sono delle sonde che si intrecciano formando un grosso cavo che porta a una turbina gigante. Archi di elettricità danzano dalle sue mani.''",shape=box,color=blue];
		j3301057325 -> j879894215;
	j879894215 [label="Tra grida e scosse l'uomo riesce a dire, ''FERMA... LE... TURBINE!!''",shape=box,color=blue];
		j879894215 -> j3194334787;
	j3194334787 [label="Esamino la stanza.",shape=box,color=red];
		j3194334787 -> j2588292973;
	j2588292973 [label="''Ti guardi intorno in cerca di qualcosa di utile. Vedi un banco con degli attrezzi. Un piede di porco. Un tronchese gigante. Un pannello di controllo.''",shape=box,color=blue];
		j2588292973 -> j1571667540;
