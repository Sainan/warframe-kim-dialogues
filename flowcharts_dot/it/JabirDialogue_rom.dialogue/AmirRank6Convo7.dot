		4265 -> 4267;
	4266 [label="\"Mentre giri la chiave che ti è stata data da una banda di ratti giganteschi e sorprendentemente cordiali, preghi che ciò che si trova oltre la porta sia migliore della prigione che si trova alle tue spalle.\"",shape=box,color=blue];
