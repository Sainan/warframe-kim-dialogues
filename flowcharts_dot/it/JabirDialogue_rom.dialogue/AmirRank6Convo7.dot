		4270 -> 4272;
	4271 [label="''Ti giri e guardi la prigione, pensando 'tornare lì dentro è un'idea stupida.''",shape=box,color=blue];
		4271 -> 4273;
	4272 [label="''Sali con l'ascensore. Attraverso la gabbia aperta puoi vedere le mura di pietra della prigione sotterranea sostituite da tecnologie sempre più avanzate. E ti chiedi, 'dove diavolo sono?'''",shape=box,color=blue];
		4272 -> 4274;
	4273 [label="haha... Va bene, prendo l'ascensore.",shape=box,color=red];
		4273 -> 4272;
	4274 [label="''L'ascensore si apre in una sala piena di macchine e tubi giganti. È una specie di laboratorio?''",shape=box,color=blue];
		4274 -> 4275;
	4275 [label="Da una stanza in fondo al corridoio si sente un uomo gridare di dolore.",shape=box,color=blue];
		4275 -> 4276;
		4275 -> 4277;
	4276 [label="Ignoro le grida, e cerco una via d'uscita.",shape=box,color=red];
		4276 -> 4278;
	4277 [label="Mi avvicino alle grida.",shape=box,color=red];
		4277 -> 4279;
	4278 [label="''Ti addentri nel corridoio cercando un qualcosa di un qualche valore, ma le grida diventano impossibili da ignorare. Sei attratto da quest'uomo e devi aiutarlo.''",shape=box,color=blue];
		4278 -> 4279;
	4279 [label="''Percorri il corridoio seguendo la fonte delle grida. Entri in una grande sala macchine, e vedi un uomo. Un uomo non poco attraente, legato a una macchina. Scariche elettriche danzano dalle sue dita, alimentando una turbina gigante.''",shape=box,color=blue];
		4279 -> 4280;
		4279 -> 4281;
	4280 [label="Chiedo, ''Che succede?''",shape=box,color=red];
		4280 -> 4282;
	4281 [label="Esamino l'uomo.",shape=box,color=red];
		4281 -> 4282;
	4282 [label="''L'uomo è legato a una piattaforma rialzata, con le braccia distese. Attaccate alla punta delle sue dita ci sono delle sonde che si intrecciano formando un grosso cavo che porta a una turbina gigante. Archi di elettricità danzano dalle sue mani.''",shape=box,color=blue];
		4282 -> 4283;
	4283 [label="Tra grida e scosse l'uomo riesce a dire, ''FERMA... LE... TURBINE!!''",shape=box,color=blue];
		4283 -> 4284;
	4284 [label="Esamino la stanza.",shape=box,color=red];
		4284 -> 4285;
	4285 [label="''Ti guardi intorno in cerca di qualcosa di utile. Vedi un banco con degli attrezzi. Un piede di porco. Un tronchese gigante. Un pannello di controllo.''",shape=box,color=blue];
		4285 -> 4286;
