		j769413847 -> j774369477;
	j4131329858 [label="mi stai uccidendo",shape=box,color=blue];
		j4131329858 -> "Chat ends.";
	j953217941 [label="''Metti in moto la nave e proprio mentre stai per premere il pulsante per far salire la rampa e chiudere la porta, Zabir dice, 'Aspetta! Non possiamo lasciarli qui.'''",shape=box,color=blue];
		j953217941 -> j3673324718;
		j953217941 -> j1601851960;
	j3673324718 [label="Hai ragione, dobbiamo salvarli.",shape=box,color=red];
		j3673324718 -> j1602344014;
	j1601851960 [label="No invece, dovremmo proprio lasciarli qui.",shape=box,color=red];
		j1601851960 -> j1293446080;
	j1602344014 [label="''Zabir alza il fischietto e soffia.''",shape=box,color=blue];
		j1602344014 -> j4140596042;
	j1293446080 [label="'''INACCETTABILE!' dice Zabir.''",shape=box,color=blue];
		j1293446080 -> j1602344014;
	j4140596042 [label="''Pochi secondi dopo, decine di ratti salgono sulla nave. Zabir ti guarda e grida, 'VAI!'''",shape=box,color=blue];
		j4140596042 -> j3416472601;
	j3416472601 [label="''La nave decolla. I Grineer aprono il fuoco, ma i loro proiettili rimbalzano sul potente Railjack mentre esce dall'hangar.''",shape=box,color=blue];
		j3416472601 -> j190998124;
	j190998124 [label="''Mentre i ratti corrono sul ponte, guardi la vastità dello spazio ed esclami con sicurezza, 'RAILDRIVE, ATTIVATO.' Mentre il Railjack sfreccia nello spazio.''",shape=box,color=blue];
