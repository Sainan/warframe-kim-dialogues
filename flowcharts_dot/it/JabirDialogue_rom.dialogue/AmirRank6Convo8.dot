	j143628181 [label="Uso quel fischietto per i ratti.",shape=box,color=red];
		j143628181 -> j1846472736;
	j842472675 [label="Utilizzo il pannello di controllo.",shape=box,color=red];
		j842472675 -> j994125695;
	j1625096618 [label="Corro verso il Railjack.",shape=box,color=red];
		j1625096618 -> j2980161815;
	j2077863746 [label="Faccio attaccare da Zabir la guardia che controlla la rampa.",shape=box,color=red];
		j2077863746 -> j2115990474;
	j1846472736 [label="''Zabir prende il fischietto e suona una lunga nota. Non senti altro che un respiro. Ti siedi e aspetti, ma non succede niente. Niente ratti, niente. Zabir alza le spalle.''",shape=box,color=blue];
		j1846472736 -> j2546305736;
	j994125695 [label="''Arrivi al pannello di controllo, ma non prima che una guardia attenta se ne accorga. Cerchi di alzare le mani per arrenderti, ma ti spara comunque, perché i Grineer sono così cattivi.''",shape=box,color=blue];
		j994125695 -> j4096752119;
		j994125695 -> j3474153267;
	j2980161815 [label="''Corri verso la nave, ma la guardia davanti alla rampa ti vede e apre il fuoco. La tua giornata e la tua vita, finiscono dolorosamente.''",shape=box,color=blue];
		j2980161815 -> j4096752119;
		j2980161815 -> j2851810022;
	j2115990474 [label="oh certo quando è pericoloso mandi amir",shape=box,color=blue];
		j2115990474 -> j676044557;
	j2546305736 [label="''Poi senti uno sgranocchiamento. Un suono di masticazione. Improvvisamente i ratti cominciano ad uscire dalle prese d'aria intorno all'hangar. I Grineer strillano come ragazzini e aprono il fuoco. Proiettili ovunque.''",shape=box,color=blue];
		j2546305736 -> j2382035118;
	j4096752119 [label="Ho bisogno di una pausa. [Fine.]",shape=box,color=red];
		j4096752119 -> j2249264004;
	j3474153267 [label="Ancora una volta.",shape=box,color=red];
		j3474153267 -> j318932394;
	j2851810022 [label="Di nuovo!",shape=box,color=red];
		j2851810022 -> j1595881847;
	j676044557 [label="intendo dire zabir",shape=box,color=blue];
		j676044557 -> j2803678603;
	j2382035118 [label="''I ratti hanno distratto le guardie. Cosa fai adesso?''",shape=box,color=blue];
		j2382035118 -> j2280987666;
		j2382035118 -> j4216054192;
	j2249264004 [label="tornerai",shape=box,color=blue];
		j2249264004 -> "Chat ends.";
