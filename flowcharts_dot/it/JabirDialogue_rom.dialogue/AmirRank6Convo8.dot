	4440 [label="''Urli, 'Zabir, prendilo!' indicando la guardia davanti alla rampa.''",shape=box,color=blue];
		4440 -> 4443;
	4444 [label="''Zabir si lancia verso la guardia e la folgora. Questa cade a terra, senza vita.''",shape=box,color=blue];
		4444 -> 4447;
	4445 [label="''Ti avvicini furtivamente alla postazione di controllo e cerchi di azionare la console, cercando di rimanere nascosto. Riesci ad aprire le porte dell'hangar.''",shape=box,color=blue];
		4445 -> 4448;
	4443 [label="''Contro ogni buon senso, Zabir si lancia coraggiosamente. Nemmeno lui è abbastanza veloce da passare inosservato. Le guardie aprono il fuoco e Zabir muore tragicamente.''",shape=box,color=blue];
