	j2803678603 [label="ok",shape=box,color=blue];
		j2803678603 -> j315277792;
	j2280987666 [label="Faccio fulminare la guardia davanti alla rampa da Zabir!",shape=box,color=red];
		j2280987666 -> j2657668972;
	j4216054192 [label="Apro le porte con il pannello di controllo.",shape=box,color=red];
		j4216054192 -> j789287928;
	j315277792 [label="''Urli, 'Zabir, prendilo!' indicando la guardia davanti alla rampa.''",shape=box,color=blue];
		j315277792 -> j2063649141;
	j2657668972 [label="''Zabir si lancia verso la guardia e la folgora. Questa cade a terra, senza vita.''",shape=box,color=blue];
		j2657668972 -> j3028613594;
	j789287928 [label="''Ti avvicini furtivamente alla postazione di controllo e cerchi di azionare la console, cercando di rimanere nascosto. Riesci ad aprire le porte dell'hangar.''",shape=box,color=blue];
		j789287928 -> j238267965;
	j2063649141 [label="''Contro ogni buon senso, Zabir si lancia coraggiosamente. Nemmeno lui è abbastanza veloce da passare inosservato. Le guardie aprono il fuoco e Zabir muore tragicamente.''",shape=box,color=blue];
		j2063649141 -> j882317913;
	j3028613594 [label="Boolean RampGuardZapped is now true.",color=orange];
		j3028613594 -> j1915017362;
	j238267965 [label="''Distratte dai ratti, le guardie non se ne accorgono nemmeno.''",shape=box,color=blue];
		j238267965 -> j256735146;
	j882317913 [label="game over amico",shape=box,color=blue];
		j882317913 -> j3913408851;
