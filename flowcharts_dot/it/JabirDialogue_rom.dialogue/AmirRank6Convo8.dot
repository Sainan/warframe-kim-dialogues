	j2561599055 [label="non ti biasimerei, è piuttosto affascinante",shape=box,color=blue];
		j2561599055 -> j2130185886;
	j2130185886 [label="eccoci",shape=box,color=blue];
		j2130185886 -> j3077981551;
	j3077981551 [label="''Ti trovi nel mezzo del laboratorio con Zabir. Ti guarda e ti dice, 'non c'è tempo da perdere, seguimi.'''",shape=box,color=blue];
		j3077981551 -> j3271835283;
	j3271835283 [label="''Ti guida attraverso un corridoio dopo l'altro. Conosce questo asteroide come il palmo della sua mano, ogni guardia e i loro movimenti.''",shape=box,color=blue];
		j3271835283 -> j4185094911;
		j3271835283 -> j3989486167;
		j3271835283 -> j4127387334;
	j4185094911 [label="Chiedo a Zabir una spiegazione riguardo i ratti.",shape=box,color=red];
		j4185094911 -> j560735135;
	j3989486167 [label="È un prigioniero anche lui?",shape=box,color=red];
		j3989486167 -> j4068189294;
	j4127387334 [label="Dove mi sta portando Zabir?",shape=box,color=red];
		j4127387334 -> j3027867221;
	j560735135 [label="''Zabir è scioccato. 'Ti hanno trovato i ratti? Incredibile. Ha funzionato. Guarda.' Zabir solleva un fischietto d'oro finemente decorato. 'Me l'ha dato la Regina dei Ratti. Dobbiamo trovarla.'''",shape=box,color=blue];
		j560735135 -> j2576661107;
	j4068189294 [label="''Hai chiesto a Zabir come è arrivato qui, e risponde 'Non c'è tempo per questo', 'dobbiamo uscire di qui.'''",shape=box,color=blue];
		j4068189294 -> j4185094911;
		j4068189294 -> j4127387334;
	j3027867221 [label="''Zabir si gira e dice 'Andiamo all'hangar. Rubiamo una nave, ci allontaniamo il più possibile da qui. E troviamo la Regina dei Ratti.''",shape=box,color=blue];
		j3027867221 -> j2576661107;
	j2576661107 [label="REGINA DEI RATTI?",shape=box,color=red];
		j2576661107 -> j1392234967;
	j1392234967 [label="'''Mi ha dato questo fischietto. I ratti lo sentono e obbediscono. È mia amica. Non è sempre gentile, ma ci tiene.'''",shape=box,color=blue];
		j1392234967 -> j1766458741;
		j1392234967 -> j3010752746;
	j1766458741 [label="Per caso, hai mostrato tutto questo a Lettie?",shape=box,color=red];
		j1766458741 -> j2184527559;
	j3010752746 [label="Anche lei mi suona familiare.",shape=box,color=red];
		j3010752746 -> j2358037748;
	j2184527559 [label="tengo troppo alla mia vita per rischiarla",shape=box,color=blue];
		j2184527559 -> j750287410;
	j2358037748 [label="ogni somiglianza con persone reali o immaginarie è una coincidenza",shape=box,color=blue];
		j2358037748 -> j750287410;
	j750287410 [label="''Con l'aiuto di Zabir, navighi tra i corridoi dell'asteroide. Schivando abilmente le guardie e le telecamere di sicurezza.''",shape=box,color=blue];
		j750287410 -> j2872490899;
	j2872490899 [label="''Eventualmente, arrivate a una grande porta. Zabir ti fa segno di abbassarti. Vi accovacciate entrambi ed entrate nell'hangar.''",shape=box,color=blue];
		j2872490899 -> j4058662761;
	j4058662761 [label="''Vi accovacciate all'ombra di una colonna. Si sentono delle guardie Grineer nelle vicinanze.''",shape=box,color=blue];
		j4058662761 -> j624317450;
	j624317450 [label="\"Cosa fai?\"",shape=box,color=blue];
		j624317450 -> j2212003632;
		j624317450 -> j2164917570;
	j2212003632 [label="Attacco le guardie.",shape=box,color=red];
		j2212003632 -> j1778393781;
	j2164917570 [label="Mi guardo intorno.",shape=box,color=red];
		j2164917570 -> j2101267858;
	j1778393781 [label="''Senza un briciolo di instinto di sopravvivenza ne previdenza, corri allo scoperto. Un gruppo di guardie inizia a sparare. Ti lanci a testa bassa in una raffica di proiettili che ti uccidono all'istante. Zabir scuote la testa per il tuo insensato atto di ostinato coraggio.''",shape=box,color=blue];
		j1778393781 -> j1595149981;
	j2101267858 [label="\"You peek around the corner and survey the area.\"",shape=box,color=blue];
		j2101267858 -> j3175874958;
	j1595149981 [label="vuoi riprovare e non farti uccidere così facilmente questa volta?",shape=box,color=blue];
		j1595149981 -> j1745291016;
		j1595149981 -> j677427760;
	j3175874958 [label="''Un Railjack è al centro dell'hangar. La rampa di accesso del Railjack è bloccata da una guardia. Su un lato dell'hangar ci sono una dozzina di Grineer impegnati a giocare a dadi. A pochi metri di distanza c'è una scrivania con un pannello di controllo.''",shape=box,color=blue];
		j3175874958 -> j2803274358;
	j1745291016 [label="Assolutamente sì.",shape=box,color=red];
		j1745291016 -> j1331054308;
	j677427760 [label="Per oggi basta così. [Fine.]",shape=box,color=red];
		j677427760 -> "Chat ends.";
	j2803274358 [label="'''Per uscire, dobbiamo prima aprire le porte dell'hangar', sussurra Zabir.''",shape=box,color=blue];
		j2803274358 -> j3044039625;
	j1331054308 [label="''Cosa fai questa volta?''",shape=box,color=blue];
		j1331054308 -> j3098539820;
		j1331054308 -> j2164917570;
	j3044039625 [label="''Zabir ti guarda. 'Hai qualche brillante idea?'''",shape=box,color=blue];
		j3044039625 -> j774369477;
		j3044039625 -> j3044039625;
	j3098539820 [label="... esamino l'area?",shape=box,color=red];
