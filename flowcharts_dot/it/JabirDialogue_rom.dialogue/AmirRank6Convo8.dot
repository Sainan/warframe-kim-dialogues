		j2168636784 -> j4131329858;
	j2229458430 [label="''Guardi Zabir e dici, 'Spero tu sappia pilotare questa cosa', e Zabir risponde, 'Io no, ma tu sì.'''",shape=box,color=blue];
		j2229458430 -> j953217941;
	j1710229528 [label="''Zabir indica la guardia davanti alla rampa.''",shape=box,color=blue];
