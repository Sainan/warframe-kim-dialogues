	4382 [label="eccoci",shape=box,color=blue];
		4382 -> 4383;
	4383 [label="''Ti trovi nel mezzo del laboratorio con Zabir. Ti guarda e ti dice, 'non c'è tempo da perdere, seguimi.'''",shape=box,color=blue];
		4383 -> 4384;
	4384 [label="''Ti guida attraverso un corridoio dopo l'altro. Conosce questo asteroide come il palmo della sua mano, ogni guardia e i loro movimenti.''",shape=box,color=blue];
		4384 -> 4385;
		4384 -> 4386;
		4384 -> 4387;
	4385 [label="Chiedo a Zabir una spiegazione riguardo i ratti.",shape=box,color=red];
		4385 -> 4388;
	4386 [label="È un prigioniero anche lui?",shape=box,color=red];
		4386 -> 4389;
	4387 [label="Dove mi sta portando Zabir?",shape=box,color=red];
		4387 -> 4390;
	4388 [label="''Zabir è scioccato. 'Ti hanno trovato i ratti? Incredibile. Ha funzionato. Guarda.' Zabir solleva un fischietto d'oro finemente decorato. 'Me l'ha dato la Regina dei Ratti. Dobbiamo trovarla.'''",shape=box,color=blue];
		4388 -> 4391;
	4389 [label="''Hai chiesto a Zabir come è arrivato qui, e risponde 'Non c'è tempo per questo', 'dobbiamo uscire di qui.'''",shape=box,color=blue];
		4389 -> 4385;
		4389 -> 4387;
	4390 [label="''Zabir si gira e dice 'Andiamo all'hangar. Rubiamo una nave, ci allontaniamo il più possibile da qui. E troviamo la Regina dei Ratti.''",shape=box,color=blue];
		4390 -> 4391;
	4391 [label="REGINA DEI RATTI?",shape=box,color=red];
		4391 -> 4392;
	4392 [label="'''Mi ha dato questo fischietto. I ratti lo sentono e obbediscono. È mia amica. Non è sempre gentile, ma ci tiene.'''",shape=box,color=blue];
		4392 -> 4393;
		4392 -> 4394;
	4393 [label="Per caso, hai mostrato tutto questo a Lettie?",shape=box,color=red];
		4393 -> 4395;
	4394 [label="Anche lei mi suona familiare.",shape=box,color=red];
		4394 -> 4396;
	4395 [label="tengo troppo alla mia vita per rischiarla",shape=box,color=blue];
		4395 -> 4397;
	4396 [label="ogni somiglianza con persone reali o immaginarie è una coincidenza",shape=box,color=blue];
		4396 -> 4397;
	4397 [label="''Con l'aiuto di Zabir, navighi tra i corridoi dell'asteroide. Schivando abilmente le guardie e le telecamere di sicurezza.''",shape=box,color=blue];
		4397 -> 4398;
	4398 [label="''Eventualmente, arrivate a una grande porta. Zabir ti fa segno di abbassarti. Vi accovacciate entrambi ed entrate nell'hangar.''",shape=box,color=blue];
		4398 -> 4399;
	4399 [label="''Vi accovacciate all'ombra di una colonna. Si sentono delle guardie Grineer nelle vicinanze.''",shape=box,color=blue];
		4399 -> 4400;
	4400 [label="\"Cosa fai?\"",shape=box,color=blue];
		4400 -> 4401;
		4400 -> 4402;
	4401 [label="Attacco le guardie.",shape=box,color=red];
		4401 -> 4403;
	4402 [label="Mi guardo intorno.",shape=box,color=red];
		4402 -> 4404;
	4403 [label="''Senza un briciolo di instinto di sopravvivenza ne previdenza, corri allo scoperto. Un gruppo di guardie inizia a sparare. Ti lanci a testa bassa in una raffica di proiettili che ti uccidono all'istante. Zabir scuote la testa per il tuo insensato atto di ostinato coraggio.''",shape=box,color=blue];
		4403 -> 4405;
	4404 [label="''Dai un'occhiata ed esamini la zona.''",shape=box,color=blue];
		4404 -> 4406;
	4405 [label="vuoi riprovare e non farti uccidere così facilmente questa volta?",shape=box,color=blue];
		4405 -> 4407;
		4405 -> 4408;
	4406 [label="''Un Railjack è al centro dell'hangar. La rampa di accesso del Railjack è bloccata da una guardia. Su un lato dell'hangar ci sono una dozzina di Grineer impegnati a giocare a dadi. A pochi metri di distanza c'è una scrivania con un pannello di controllo.''",shape=box,color=blue];
		4406 -> 4409;
	4407 [label="Assolutamente sì.",shape=box,color=red];
		4407 -> 4410;
	4408 [label="Per oggi basta così. [Fine.]",shape=box,color=red];
		4408 -> 4411;
	4409 [label="'''Per uscire, dobbiamo prima aprire le porte dell'hangar', sussurra Zabir.''",shape=box,color=blue];
		4409 -> 4412;
	4410 [label="''Cosa fai questa volta?''",shape=box,color=blue];
		4410 -> 4413;
		4410 -> 4402;
	4411 [label="Chat ends.",color=orange];
	4412 [label="''Zabir ti guarda. 'Hai qualche brillante idea?'''",shape=box,color=blue];
		4412 -> 4414;
		4412 -> 4412;
	4413 [label="... esamino l'area?",shape=box,color=red];
