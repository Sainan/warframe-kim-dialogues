		4422 -> 4426;
	4427 [label="''Zabir prende il fischietto e suona una lunga nota. Non senti altro che un respiro. Ti siedi e aspetti, ma non succede niente. Niente ratti, niente. Zabir alza le spalle.''",shape=box,color=blue];
		4427 -> 4432;
	4425 [label="''Arrivi al pannello di controllo, ma non prima che una guardia attenta se ne accorga. Cerchi di alzare le mani per arrenderti, ma ti spara comunque, perché i Grineer sono così cattivi.''",shape=box,color=blue];
		4425 -> 4429;
		4425 -> 4430;
	4428 [label="''Corri verso la nave, ma la guardia davanti alla rampa ti vede e apre il fuoco. La tua giornata e la tua vita, finiscono dolorosamente.''",shape=box,color=blue];
		4428 -> 4429;
		4428 -> 4433;
	4426 [label="oh certo quando è pericoloso mandi amir",shape=box,color=blue];
		4426 -> 4431;
	4432 [label="''Poi senti uno sgranocchiamento. Un suono di masticazione. Improvvisamente i ratti cominciano ad uscire dalle prese d'aria intorno all'hangar. I Grineer strillano come ragazzini e aprono il fuoco. Proiettili ovunque.''",shape=box,color=blue];
		4432 -> 4437;
	4429 [label="Ho bisogno di una pausa. [Fine.]",shape=box,color=red];
