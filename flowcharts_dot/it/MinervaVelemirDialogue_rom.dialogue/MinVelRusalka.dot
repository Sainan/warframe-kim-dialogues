	"Chat ends." [color=orange];
	j514567055 [label="Ehi... ragazzi?",shape=box,color=red];
		j514567055 -> j5931385;
	j5931385 [label="MomToxicated: Sì?",shape=box,color=blue];
		j5931385 -> j2437972154;
	j2437972154 [label="PapaPolar: che succede amichetto?",shape=box,color=blue];
		j2437972154 -> j4949660;
		j2437972154 -> j1932308426;
		j2437972154 -> j409870736;
	j4949660 [label="Ho una buona e una cattiva notizia su Neci.",shape=box,color=red];
		j4949660 -> j2278810343;
	j1932308426 [label="Ho bisogno che non vi facciate illusioni. Ho notizie su Neci, ma sono... contrastanti. E inconcludenti.",shape=box,color=red];
		j1932308426 -> j1960635277;
	j409870736 [label="Mmm... Anzi, lasciate stare. [Fine.]",shape=box,color=red];
		j409870736 -> "Chat ends.";
	j2278810343 [label="PapaPolar: fai le cose come gli adulti. prima le cattive notizie.",shape=box,color=blue];
		j2278810343 -> j2200010469;
	j1960635277 [label="+5 Chemistry",color=orange];
		j1960635277 -> j2087086794;
	j2200010469 [label="MomToxicated: Sono d'accordo. Le cattive notizie vanno sempre dette prima.",shape=box,color=blue];
		j2200010469 -> j4080604768;
	j2087086794 [label="MomToxicated: Come tutto, nella vita, generalmente. Ma grazie per l'avvertimento.",shape=box,color=blue];
		j2087086794 -> j3431347928;
	j4080604768 [label="Quindi. L'Indifferenza è andata a Duviri. E... si è portata dietro Neci.",shape=box,color=red];
		j4080604768 -> j1348379886;
	j3431347928 [label="+5 Chemistry",color=orange];
		j3431347928 -> j3967676594;
	j1348379886 [label="PapaPolar: aspetta. aspetta aspetta. intendi quella dimensione nata da un libro di fiabe?",shape=box,color=blue];
		j1348379886 -> j902889263;
	j3967676594 [label="PapaPolar: mi sto preparando alla notizia, ma questo significa che... è ancora viva?",shape=box,color=blue];
		j3967676594 -> j147113951;
	j902889263 [label="MomToxicated: Quello con il bambino dittatore che continuava a ucciderti ripetutamente?",shape=box,color=blue];
		j902889263 -> j2374237504;
		j902889263 -> j1318529960;
	j147113951 [label="Non... lo so. Credo di sì. Ma lasciate che vi dica quello che so, così potrete giudicare voi stessi.",shape=box,color=red];
		j147113951 -> j4080604768;
	j2374237504 [label="A quanto pare è stato un momento di crescita per lui? Non è questo il punto. In ogni caso...",shape=box,color=red];
		j2374237504 -> j3608745389;
	j1318529960 [label="Esattamente.",shape=box,color=red];
		j1318529960 -> j3608745389;
	j3608745389 [label="Neci... è salita al trono. I Murmur - l'\"esercito\" dell'Indifferenza, per mancanza di un termine migliore, lo ha invaso, e ha preso il potere.",shape=box,color=red];
		j3608745389 -> j2094588246;
	j2094588246 [label="MomToxicated: Heh. È proprio mia figlia.",shape=box,color=blue];
		j2094588246 -> j2836259832;
	j2836259832 [label="PapaPolar: ma era veramente *lei*? o solo quella cosa che indossava la sua faccia?",shape=box,color=blue];
		j2836259832 -> j3171893311;
		j2836259832 -> j1226328291;
	j3171893311 [label="Non lo so.",shape=box,color=red];
		j3171893311 -> j2291609104;
	j1226328291 [label="È proprio di questo che volevo parlarvi.",shape=box,color=red];
		j1226328291 -> j2291609104;
	j2291609104 [label="Ho trovato questi documenti. All'inizio erano sconnessi. Ma quando li ho messi insieme, ho... ottenuto questo messaggio.",shape=box,color=red];
		j2291609104 -> j3040066350;
	j3040066350 [label="Ero curioso di sapere se per voi avesse un senso.",shape=box,color=red];
		j3040066350 -> j1862991915;
	j1862991915 [label="MomToxicated: Enigmi e messaggi strani? Stai parlando la nostra lingua.",shape=box,color=blue];
		j1862991915 -> j2315672750;
	j2315672750 [label="PapaPolar: 1-800-merda-spionistica, sei nel posto giusto",shape=box,color=blue];
		j2315672750 -> j1811201288;
	j1811201288 [label="\"Quando Sol e Lua si allineeranno, i perduti troveranno la strada di casa.\"",shape=box,color=red];
		j1811201288 -> j1030285646;
	j1030285646 [label="PapaPolar: ....merda. M. MERDA.",shape=box,color=blue];
		j1030285646 -> j2340285645;
	j2340285645 [label="MomToxicated: Non cascarci. Se quella cosa è nella sua testa, sa quello che sa lei.",shape=box,color=blue];
		j2340285645 -> j2381624413;
		j2340285645 -> j750995874;
	j2381624413 [label="Cosa? Che significa?",shape=box,color=red];
		j2381624413 -> j3891178441;
	j750995874 [label="È l'altra metà, non è vero?",shape=box,color=red];
		j750995874 -> j2453385218;
	j3891178441 [label="PapaPolar: \"Agli incroci deserti, cerca l'eclissi.\"",shape=box,color=blue];
		j3891178441 -> j3958539455;
	j2453385218 [label="+5 Chemistry",color=orange];
		j2453385218 -> j430499574;
	j3958539455 [label="PapaPolar: quello che ti avevo detto di riferirle se mai l'avessi rivista.",shape=box,color=blue];
		j3958539455 -> j425986754;
	j430499574 [label="PapaPolar: esattamente...",shape=box,color=blue];
		j430499574 -> j1214081023;
	j425986754 [label="PapaPolar: era la nostra metà di una frase in codice. il modo in cui iniziavamo ogni telefonata per sapere di essere su una linea sicura e che potevamo stare tranquilli",shape=box,color=blue];
		j425986754 -> j3185315397;
	j1214081023 [label="PapaPolar: avevamo una frase in codice. era come iniziavamo ogni telefonata, così sapevamo di essere su una linea sicura e che potevamo stare tranquilli",shape=box,color=blue];
		j1214081023 -> j3185315397;
	j3185315397 [label="MomToxicated: Che eravamo... proprio noi.",shape=box,color=blue];
		j3185315397 -> j617208721;
	j617208721 [label="PapaPolar: \"Agli incroci deserti, cerca l'eclissi\" era la nostra metà.",shape=box,color=blue];
		j617208721 -> j1267551113;
	j1267551113 [label="MomToxicated: \"Quando Sol e Lua si allineeranno, i perduti troveranno la strada di casa.\" era la risposta.",shape=box,color=blue];
		j1267551113 -> j3427224456;
	j3427224456 [label="MomToxicated: La *sua* metà.",shape=box,color=blue];
		j3427224456 -> j977728604;
		j3427224456 -> j257588476;
	j977728604 [label="Ma non possiamo essere sicuri che sia stata lei, proprio come hai detto tu, Minerva. L'Indifferenza sa quello che sa anche lei.",shape=box,color=red];
		j977728604 -> j889400582;
	j257588476 [label="Non capisco perché l'Indifferenza dovrebbe dirvi questo...",shape=box,color=red];
		j257588476 -> j2170887858;
	j889400582 [label="MomToxicated: Ma perché dovrebbe cercare di darci un senso di speranza? A meno che non stia semplicemente cercando di farci del male.",shape=box,color=blue];
		j889400582 -> j3001750781;
	j2170887858 [label="MomToxicated: Forse per darci false speranze? Per farci del male?",shape=box,color=blue];
		j2170887858 -> j1286242484;
	j3001750781 [label="PapaPolar: perché, fa male?",shape=box,color=blue];
		j3001750781 -> j250343627;
	j1286242484 [label="PapaPolar: è falso? fa male?",shape=box,color=blue];
		j1286242484 -> j250343627;
	j250343627 [label="PapaPolar: o è una sensazione di pace sapere che la nostra bambina è ancora viva, da qualche parte là fuori?",shape=box,color=blue];
		j250343627 -> j3764668456;
	j3764668456 [label="PapaPolar: che, nonostante tutte le avversità, continua a dare spettacolo e a prendersi gioco di qualcuno?",shape=box,color=blue];
		j3764668456 -> j4071956665;
	j4071956665 [label="PapaPolar: anche se non è con noi?",shape=box,color=blue];
		j4071956665 -> j2910045077;
	j2910045077 [label="PapaPolar: questo scalda il mio grande e stupido cuore, non so a voi.",shape=box,color=blue];
		j2910045077 -> j1081618142;
	j1081618142 [label="PapaPolar: e qualcosa mi dice che non è ciò che vorrebbe questa cosiddetta indifferenza",shape=box,color=blue];
		j1081618142 -> j619286932;
	j619286932 [label="MomToxicated: Hai proprio ragione. Sentire quella frase, pensare che *potrebbe* essere ancora là fuori, non è doloroso.",shape=box,color=blue];
		j619286932 -> j1646932480;
	j1646932480 [label="MomToxicated: Sono orgogliosa di lei.",shape=box,color=blue];
		j1646932480 -> j989085993;
		j1646932480 -> j3611950127;
		j1646932480 -> j492485999;
	j989085993 [label="Anche se è ancora tenuta in ostaggio dall'Indifferenza?",shape=box,color=red];
		j989085993 -> j1771653478;
	j3611950127 [label="Anche se è un trucco dell'Indifferenza?",shape=box,color=red];
		j3611950127 -> j2689281256;
	j492485999 [label="Potrebbe star lavorando volontariamente con l'Indifferenza.",shape=box,color=red];
		j492485999 -> j561763818;
	j1771653478 [label="PapaPolar: è resistente come un sacco di chiodi da intelaiatura dentro un grande blocco di titanio fuso",shape=box,color=blue];
		j1771653478 -> j1401426761;
	j2689281256 [label="MomToxicated: Perché? Per quale motivo? Cosa ci guadagnerebbe?",shape=box,color=blue];
		j2689281256 -> j1194494784;
	j561763818 [label="MomToxicated: Allora ha uno degli alleati più potenti dell'universo. Dell'esistenza. Ha scelto da che parte stare. Così come abbiamo fatto noi.",shape=box,color=blue];
		j561763818 -> j156807543;
	j1401426761 [label="PapaPolar: e scommetto che il tuo \"uomo nel muro\" lo sapeva, ed è per questo che l'ha portata via in primo luogo",shape=box,color=blue];
		j1401426761 -> j1473979716;
	j1194494784 [label="PapaPolar: siamo dei pesci piccoli per quel coso. e lo dico nel miglior modo possibile",shape=box,color=blue];
		j1194494784 -> j2157262051;
	j156807543 [label="MomToxicated: Speriamo di non dover mai puntare le armi l'uno contro l'altro. E se dovesse succedere? Ce ne faremo una ragione.",shape=box,color=blue];
		j156807543 -> j778579366;
	j1473979716 [label="PapaPolar: nah. starà bene. o se n'è già andata da tempo, o hanno un accordo reciproco... oppure lo sta tenendo in ostaggio. lol",shape=box,color=blue];
		j1473979716 -> j2157262051;
	j2157262051 [label="MomToxicated: No, credo che il messaggio fosse reale. E credo che provenisse dalla nostra bambina. Che ci diceva... di essere ancora là fuori.",shape=box,color=blue];
		j2157262051 -> j354214984;
	j778579366 [label="PapaPolar: sa prendersi cura di se stessa. è così che l'abbiamo cresciuta",shape=box,color=blue];
		j778579366 -> j2157262051;
	j354214984 [label="MomToxicated: Dicendoci, a modo suo, che \"sta bene\".",shape=box,color=blue];
		j354214984 -> j1028168608;
	j1028168608 [label="MomToxicated: E che possiamo smettere di preoccuparci per lei.",shape=box,color=blue];
		j1028168608 -> j3011036654;
	j3011036654 [label="PapaPolar: heh. come se fosse possibile",shape=box,color=blue];
		j3011036654 -> j3706299599;
	j3706299599 [label="MomToxicated: La maledizione e la benedizione di essere genitori.",shape=box,color=blue];
		j3706299599 -> j2733270209;
	j2733270209 [label="PapaPolar: hai mai desiderato dei figli, drifter? eeeh, non rispondere. probabilmente mi tirerai fuori qualche stranezza void di cui non voglio sapere nulla.",shape=box,color=blue];
		j2733270209 -> j3495566881;
		j2733270209 -> j343899315;
		j2733270209 -> j857798543;
	j3495566881 [label="Ora di bere qualcosa? Sì, decisamente.",shape=box,color=red];
		j3495566881 -> j2418526671;
	j343899315 [label="Saggia decisione.",shape=box,color=red];
		j343899315 -> j1898635529;
	j857798543 [label="<RETRO_EMOJI_OHNO>",shape=box,color=red];
		j857798543 -> j405297202;
	j2418526671 [label="+5 Chemistry",color=orange];
		j2418526671 -> j1159786084;
	j1898635529 [label="PapaPolar: beh, non è un sorriso felicissimo. È un sorriso felice e malinconico? ma",shape=box,color=blue];
		j1898635529 -> j476201465;
	j405297202 [label="MomToxicated: È una risposta valida, concordo. Heh. Cosa ne direste di andare a prenderci qualcosa da bere?",shape=box,color=blue];
		j405297202 -> j1460510198;
	j1159786084 [label="MomToxicated: Ora parli davvero la nostra lingua.",shape=box,color=blue];
		j1159786084 -> j476201465;
	j476201465 [label="PapaPolar: vorrei raccontare qualche bella storia sulla nostra bambina",shape=box,color=blue];
		j476201465 -> j2630446440;
	j1460510198 [label="PapaPolar: questa sì che è musica per le mie orecchie",shape=box,color=blue];
		j1460510198 -> j476201465;
	j2630446440 [label="MomToxicated: E... Drifter? Grazie. Ancora. Per tutto quello che fai.",shape=box,color=blue];
		j2630446440 -> j1833476017;
	j1833476017 [label="PapaPolar: davvero, amichetto. non so come potremo mai ripagarti. ma se si presentasse l'occasione, noi ci saremo.",shape=box,color=blue];
		j1833476017 -> j3261002757;
	j3261002757 [label="PapaPolar: ora sei parte della famiglia, che ti piaccia o no. 8-)",shape=box,color=blue];
		j3261002757 -> "Chat ends.";
