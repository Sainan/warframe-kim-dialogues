	j2711305563 [label="MomToxicated: Ottima domanda.",shape=box,color=blue];
		j2711305563 -> j1112481941;
	j1112481941 [label="MomToxicated: Non devi volermi aiutare per farmi un piacere. Abbiamo un nemico in comune. Questo ''Uomo nel Muro''.",shape=box,color=blue];
		j1112481941 -> j3568016118;
	j3568016118 [label="MomToxicated: Per quanto ne so, siamo entrambi interessati a sapere dove è, cosa sta cercando e perché ha preso di mira Rusalka in primo luogo.",shape=box,color=blue];
