	j434517557 [label="Mi dispiace dirvelo, ma probabilmente dovremo aspettare che l'Uomo sul Muro faccia la sua prossima mossa.",shape=box,color=red];
		j434517557 -> j3515922138;
	j110563739 [label="PapaPolar: lo è, però. e comunque probabilmente l'ha già capito. non è che siamo esattamente discreti",shape=box,color=blue];
		j110563739 -> j3646694057;
	j1777371556 [label="Perché allora non sarei stato diverso dall'Indifferenza. Dagli Scaldra. Da Entrati. Non vado in giro ad ammazzare gente senza senso.",shape=box,color=red];
		j1777371556 -> j3524887346;
	j1722315855 [label="Perché non è stata davvero lei a fare le scelte che l'hanno portata a quel punto. Solo perché non la ucciderei per questo nel momento, non significa che mi *importi* abbastanza da fare di tutto per salvarla.",shape=box,color=red];
		j1722315855 -> j2125711787;
	j2410770075 [label="Perché non avevo intenzione di fare il lavoro sporco di Entrati per lui. Se voleva uccidere il nuovo burattino dell'Indifferenza, poteva farlo da solo.",shape=box,color=red];
		j2410770075 -> j259676927;
	j3515922138 [label="MomToxicated: E perché? Non hai modo di rintracciarlo? Quella cosa? Qualunque cosa sia? O sai cosa sta realmente cercando?",shape=box,color=blue];
		j3515922138 -> j3748189372;
		j3515922138 -> j3540390999;
	j3646694057 [label="PapaPolar: e forse, *solo forse* se ti fidassi del nostro nuovo amichetto qui con un po' di informazioni, potrebbe essere più disposto a *aiutarciiiiiiii*",shape=box,color=blue];
		j3646694057 -> j2867007161;
	j3524887346 [label="Il che implica che io uccida deliberatamente delle persone. Cosa che non faccio. Voglio dire. Uccido delle persone. Ma è diverso. Sai cosa intendo.",shape=box,color=red];
		j3524887346 -> j3115482085;
	j2125711787 [label="Non la *conosco*.",shape=box,color=red];
		j2125711787 -> j1653117880;
	j259676927 [label="Ma proprio come sospettavo, a quel vecchio bastardo piace sparare solo a chi sa che si rialzerà.",shape=box,color=red];
		j259676927 -> j3858268973;
	j3748189372 [label="Non posso di certo piazzare un segnalatore su una cosa semidio, no?",shape=box,color=red];
