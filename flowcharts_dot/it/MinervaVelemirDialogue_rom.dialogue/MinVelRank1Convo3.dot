		j535810027 -> j1641387942;
		j535810027 -> j2179565939;
		j535810027 -> j2410770075;
	j2388387151 [label="Mi dispiace dirvelo, ma probabilmente dovremo aspettare che l'Uomo nel Muro faccia la sua prossima mossa.",shape=box,color=red];
		j2388387151 -> j4196083206;
	j4146495007 [label="PapaPolar: lo è, però. e comunque probabilmente l'ha già capito. non è che siamo esattamente discreti",shape=box,color=blue];
		j4146495007 -> j1664223183;
	j1641387942 [label="Perché allora non sarei stato diverso dall'Indifferenza. Dagli Scaldra. Da Entrati. Non vado in giro ad ammazzare gente senza motivo.",shape=box,color=red];
		j1641387942 -> j3524887346;
	j2179565939 [label="Perché non è stata davvero lei a fare le scelte che l'hanno portata a quel punto. Solo perché non la ucciderei per questo nel momento, non significa che mi *importi* abbastanza da fare di tutto per salvarla.",shape=box,color=red];
		j2179565939 -> j3934858670;
	j2410770075 [label="Perché non avevo intenzione di fare il lavoro sporco di Entrati per lui. Se voleva uccidere il nuovo burattino dell'Indifferenza, poteva farlo da solo.",shape=box,color=red];
		j2410770075 -> j259676927;
	j4196083206 [label="MomToxicated: E perché? Non hai modo di rintracciarlo? Quella cosa? Qualsiasi essa sia? O non sai cosa sta cercando davvero?",shape=box,color=blue];
		j4196083206 -> j3520217826;
		j4196083206 -> j1139970086;
	j1664223183 [label="PapaPolar: e forse, *e dico forse* se ti fidassi del nostro nuovo amichetto qui che ha qualche informazione, potrebbe essere più disposto a *aiutarciiiiiiii*",shape=box,color=blue];
		j1664223183 -> j3092870489;
	j3524887346 [label="Il che implica che io uccida deliberatamente delle persone. Cosa che non faccio. Voglio dire. Uccido delle persone. Ma è diverso. Sai cosa intendo.",shape=box,color=red];
		j3524887346 -> j3115482085;
	j3934858670 [label="Non la *conoscevo*.",shape=box,color=red];
		j3934858670 -> j2409549595;
	j259676927 [label="Ma proprio come sospettavo, a quel vecchio bastardo piace sparare solo a chi sa che si rialzerà.",shape=box,color=red];
		j259676927 -> j3858268973;
	j3520217826 [label="Non posso di certo piazzare un segnalatore su una cosa semidio, no?",shape=box,color=red];
		j3520217826 -> j1886088432;
	j1139970086 [label="Le sue motivazioni ci sfuggono al momento, sì. Ma non è niente di buono.",shape=box,color=red];
		j1139970086 -> j1886088432;
	j3092870489 [label="PapaPolar: a volte è quasi come se le persone funzionassero così. ",shape=box,color=blue];
