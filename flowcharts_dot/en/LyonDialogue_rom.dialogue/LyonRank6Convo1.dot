	j3411574953 [label="Mon miracle, I will kneel at your altar, a most dedicated and devoted servant and soldier.",shape=box,color=blue];
		j3411574953 -> j2517547685;
	j3899939662 [label="My friend, I shall fight beside you, come what may. How could I not seek to guard you, who has stolen the heart of my sister?",shape=box,color=blue];
