		j8348369 -> "Chat ends." [label="false",color=purple];
	j2126726525 [label="Did you truly find yourself so otherwise bereft of options that you resorted to petitioning Roathe to badger me on your behalf in order to... consider an apology?",shape=box,color=blue];
		j2126726525 -> j3979121195;
	j1307949227 [label="Did you truly find yourself so otherwise bereft of options that you resorted to petitioning Roathe to badger me on your behalf in order to send M. Loid upstairs?",shape=box,color=blue];
		j1307949227 -> j3967428600;
	j803117044 [label="Did you truly find yourself so otherwise bereft of options that you resorted to petitioning Roathe to badger me on your behalf?",shape=box,color=blue];
		j803117044 -> j2619645044;
	"Chat ends." [color=orange];
	j3979121195 [label="You realize how farcical that sounds, yes?",shape=box,color=blue];
		j3979121195 -> j1300510244;
		j3979121195 -> j2107978863;
	j3967428600 [label="I do not wish to waste more time than I have already lost listening to his argument. I will simply say very well.",shape=box,color=blue];
		j3967428600 -> j2169173578;
	j2619645044 [label="The issue, correct me if I am wrong, was that you did not wish to wade through my past. Now you seem to have changed your mind?",shape=box,color=blue];
		j2619645044 -> j3623553770;
	j1300510244 [label="I didn't know he said I'd apologize.",shape=box,color=red];
		j1300510244 -> j2027845402;
	j2107978863 [label="I didn't know what else to do. I know it's ridiculous in hindsight.",shape=box,color=red];
		j2107978863 -> j2534007677;
	j2169173578 [label="Check boolean MarieFamilyFail",color=orange];
		j2169173578 -> j1351245872 [label=true,color=green];
		j2169173578 -> j836264493 [label=false,color=brown];
	j3623553770 [label="I do not understand. We cannot go back. Those waters cannot be retread.",shape=box,color=blue];
		j3623553770 -> j1426729737;
		j3623553770 -> j1944777460;
	j2027845402 [label="I see.",shape=box,color=blue];
		j2027845402 -> "Chat ends.";
	j2534007677 [label="The comical nature of it, I admit, is part of what made me come and investigate. Are you so distraught? I cannot imagine the lack of my companionship in your life is so terrible a thing.",shape=box,color=blue];
		j2534007677 -> j1501306186;
	j1351245872 [label="You shall have my assistance as you request. I pity what your attack devil will do next to Marie.",shape=box,color=blue];
		j1351245872 -> j92487004;
	j836264493 [label="You shall have my assistance as you request. Now please, call off your attack devil.",shape=box,color=blue];
		j836264493 -> j770168571;
	j1426729737 [label="Oh. Well, this was a massive waste of time then, wasn't it?",shape=box,color=red];
		j1426729737 -> "Chat ends.";
	j1944777460 [label="I guess I... will simply say I am sorry, then. For not listening to you.",shape=box,color=red];
		j1944777460 -> j4113935420;
	j1501306186 [label="It is, Lyon. I care about you. Immensely. And I know I misstepped with you badly.",shape=box,color=red];
		j1501306186 -> j3588662293;
	j92487004 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j92487004 -> j547953661;
	j770168571 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j770168571 -> j3711686580;
	j4113935420 [label="May I ask why you did not? Were you afraid of the subject matter? Bored by it, perhaps? Or did you think you were not strong enough to weather it?",shape=box,color=blue];
		j4113935420 -> j908579764;
		j4113935420 -> j1467628395;
		j4113935420 -> j2487495602;
	j3588662293 [label="And I am so very, very sorry.",shape=box,color=red];
		j3588662293 -> j1704193338;
	j547953661 [label="Boolean LyonFamilyFail is now false.",color=orange];
		j547953661 -> "Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j3711686580 [label="Boolean LyonFamilyFail is now false.",color=orange];
		j3711686580 -> "Chat ends.";
	j908579764 [label="I was afraid of it.",shape=box,color=red];
		j908579764 -> j3290283582;
	j1467628395 [label="I didn't think I was strong enough to take it on.",shape=box,color=red];
		j1467628395 -> j3290283582;
	j2487495602 [label="I didn't care at the time. But I do, now.",shape=box,color=red];
		j2487495602 -> j990534422;
	j1704193338 [label="I didn't know what else to do but to turn to Roathe for help.",shape=box,color=red];
		j1704193338 -> j3451782485;
	"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
	j3290283582 [label="Then I have no choice but to forgive you. ",shape=box,color=blue];
		j3290283582 -> j106665696;
	j990534422 [label="And what has changed that makes you suddenly care, when previously you did not?",shape=box,color=blue];
		j990534422 -> j171227140;
		j990534422 -> j2284160176;
	j3451782485 [label="Evaluate expressions",color=orange];
		j3451782485 -> j311530331 [label="MarieDating",color=purple];
		j3451782485 -> j2717237525 [label="RoatheDating",color=purple];
		j3451782485 -> j300637305 [label="false",color=purple];
	j106665696 [label="Boolean LyonConfessionFail is now false.",color=orange];
		j106665696 -> "Chat ends.";
	j171227140 [label="I changed my mind about you.",shape=box,color=red];
		j171227140 -> j3290283582;
	j2284160176 [label="I feel there is progress that might be blocked behind hearing your stories.",shape=box,color=red];
		j2284160176 -> j2632701785;
	j311530331 [label="While I... am touched and I am... unaccustomed to the ways of this future, so therefore I will not doubt the sincerity of your words. Still, I fear I must refuse.",shape=box,color=blue];
		j311530331 -> j571226346;
	j2717237525 [label="While I... am touched and I am... unaccustomed to the ways of this future, so therefore I will not doubt the sincerity of your words. Still, I fear I must refuse.",shape=box,color=blue];
		j2717237525 -> j3728321999;
	j300637305 [label="I am left without any other option but to forgive you, of course. I do not know why you would want such a broken thing such as I, cluttering up your spaces.",shape=box,color=blue];
		j300637305 -> j2560322242;
	j2632701785 [label="A means to an end.",shape=box,color=blue];
		j2632701785 -> "Chat ends.";
	j571226346 [label="As you are otherwise currently engaged with Marie. She is too dear to me to think that my relationship with you might detract from hers. Or distract from it in any way.",shape=box,color=blue];
		j571226346 -> j53504905;
	j3728321999 [label="As you are otherwise currently... engaged with Roathe. I do not wish to even comprehend the kind of complications such an entanglement would cause.",shape=box,color=blue];
		j3728321999 -> j708781519;
	j2560322242 [label="But I find that my annoyance over your words fades now that I know the absolutely bizarre lengths you will go to have me at your side.",shape=box,color=blue];
		j2560322242 -> j2398113586;
	j53504905 [label="Perhaps I am old fashioned in that regard. She is like my family, and we are too close. I am a walking relic, it seems. For that, you must forgive me.",shape=box,color=blue];
		j53504905 -> j3311435967;
	j708781519 [label="My mind is complicated enough, I fear, to think of you and he, a man I know so well, together. Perhaps I am old-fashioned in that regard. I am a walking relic, it seems. For that, you must forgive me.",shape=box,color=blue];
		j708781519 -> j3311435967;
