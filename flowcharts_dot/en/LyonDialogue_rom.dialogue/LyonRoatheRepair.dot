		j8348369 -> "Chat ends." [label="false",color=purple];
	j2126726525 [label="Did you truly find yourself so otherwise bereft of options that you resorted to petitioning Roathe to badger me on your behalf in order to... consider an apology?",shape=box,color=blue];
		j2126726525 -> j3979121195;
	j1307949227 [label="Did you truly find yourself so otherwise bereft of options that you resorted to petitioning Roathe to badger me on your behalf in order to send M. Loid upstairs?",shape=box,color=blue];
		j1307949227 -> j3967428600;
