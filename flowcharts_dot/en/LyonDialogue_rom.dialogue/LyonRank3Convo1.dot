	"LyonRank3Convo1 begins." [color=orange];
		"LyonRank3Convo1 begins." -> j2969096737;
	j2969096737 [label="Greetings, Drifter.",shape=box,color=blue];
		j2969096737 -> j1287144375;
	j1287144375 [label="It has come to my attention that you wish to speak to me.",shape=box,color=blue];
		j1287144375 -> j2312755168;
		j1287144375 -> j56902896;
		j1287144375 -> j1956901897;
	j2312755168 [label="It's a pleasure to talk with you here, Lyon - thank you.",shape=box,color=red];
		j2312755168 -> j356496993;
	j56902896 [label="Did Marie finally convince you I wasn't going to be a threat?",shape=box,color=red];
		j56902896 -> j2241550502;
	j1956901897 [label="Oh! Hello, Lyon. I honestly didn't think you'd be convinced. I'm glad you changed your mind.",shape=box,color=red];
		j1956901897 -> j2842337542;
	j356496993 [label="You may wish you were not so eager to do so in the end, but very well. You are welcome.",shape=box,color=blue];
		j356496993 -> j2325875215;
		j356496993 -> j157871533;
	j2241550502 [label="Do not inspire me to so quickly find reasons to reverse course.",shape=box,color=blue];
		j2241550502 -> j1933300832;
	j2842337542 [label="Yes, well. You may not be so glad for it when all is said and done.",shape=box,color=blue];
		j2842337542 -> j2325875215;
		j2842337542 -> j157871533;
	j2325875215 [label="I've gathered from the others that you have matters we should discuss. Is there anything I can help you with?",shape=box,color=red];
		j2325875215 -> j3636974660;
	j157871533 [label="Is something wrong?",shape=box,color=red];
		j157871533 -> j706815670;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j3636974660 [label="Perhaps, in time. But we have only just begun our discourse. I have merely come here to... tell you I have succumbed to Marie's insistence that you can be trusted in so far as conversation is involved.",shape=box,color=blue];
		j3636974660 -> j2777944732;
	j706815670 [label="What a nearly comically insufficient question that I will not even attempt to answer, as we have only just begun our discourse. I have merely come here to... tell you that I have succumbed to Marie's insistence that you can be trusted in so far as conversation is involved.",shape=box,color=blue];
		j706815670 -> j2777944732;
	"Chat ends." [color=orange];
	j2777944732 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j2777944732 -> j3921251793 [label="x > 0",color=purple];
		j2777944732 -> j1255015410 [label="x <= 0",color=purple];
		j2777944732 -> j1255015410 [label="false",color=purple];
	j3921251793 [label="And seeing as we are now partnered in this endeavor that Roathe is \"hell\" bent upon pursuing? It seems only prudent that we become properly acquainted. This seems to be the means by which you prefer to do so. Therefore, here I am.",shape=box,color=blue];
		j3921251793 -> j1187950557;
		j3921251793 -> j2657410843;
	j1255015410 [label="And seeing as we may or may not forever be partnered in this endeavor that Roathe is \"hell\" bent upon pursuing? It seems only prudent that we become properly acquainted. This to be the means by which you prefer to do so. Therefore, here I am.",shape=box,color=blue];
		j1255015410 -> j1187950557;
		j1255015410 -> j2657410843;
	j1187950557 [label="I feel like I've already started this off wrong, somehow.",shape=box,color=red];
		j1187950557 -> j1729555170;
	j2657410843 [label="Is... there another way that you'd prefer?",shape=box,color=red];
		j2657410843 -> j2688982781;
	j1729555170 [label="No. You have not. I simply am likely not the kind of individual with which you are accustomed to conversing. For that, you have been blessed thus far, though lunatics of my calibre are rare finds.",shape=box,color=blue];
		j1729555170 -> j3922912082;
	j2688982781 [label="No. This is acceptable. Indeed, it allows me the time to fashion my thoughts the way I would like. I can see why this device holds appeal.",shape=box,color=blue];
		j2688982781 -> j2798498937;
	j3922912082 [label="I digress. I fear I did not come here to spend much time \"typing,\" which will no doubt disappoint you. I merely wished to inform you of my surrender.",shape=box,color=blue];
		j3922912082 -> j830618906;
		j3922912082 -> j3224775614;
	j2798498937 [label="However, I fear I did not come here to spend much time \"typing,\" which will no doubt disappoint you. I merely wished to inform you of my surrender.",shape=box,color=blue];
		j2798498937 -> j3224775614;
		j2798498937 -> j830618906;
	j830618906 [label="Marie is more dangerous than she looks, isn't she?",shape=box,color=red];
		j830618906 -> j3350367490;
	j3224775614 [label="I will once again, simply say thank you.",shape=box,color=red];
		j3224775614 -> j2992190631;
	j3350367490 [label="+20 Chemistry",color=orange];
		j3350367490 -> j4145933010;
	j2992190631 [label="+15 Chemistry",color=orange];
		j2992190631 -> j2651233574;
	j4145933010 [label="You have only begun to suspect how deep those waters run.",shape=box,color=blue];
		j4145933010 -> j944546954;
	j2651233574 [label="And you are, for... all that it is worth, welcome.",shape=box,color=blue];
		j2651233574 -> j944546954;
	j944546954 [label="-F. Lyon Allard",shape=box,color=blue];
		j944546954 -> "Chat ends.";
}