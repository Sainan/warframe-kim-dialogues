	edge [fontname="Roboto Condensed"];

	"LyonRank3Convo6 begins." [color=orange];
		"LyonRank3Convo6 begins." -> j1583041298;
		"LyonRank3Convo6 begins." -> j242691715;
	j1583041298 [label="How long was Entrati at the cathedral with you, before Roathe arrived?",shape=box,color=red];
		j1583041298 -> j2379361830;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j2379361830 [label="Why are you asking me this question?",shape=box,color=blue];
		j2379361830 -> j4196769031;
	"Chat ends." [color=orange];
	j4196769031 [label="Evaluate expressions",color=orange];
		j4196769031 -> j3728405872 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j325150749 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j1720640189 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j2483866846 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j325150749 [label="LyonVisions1",color=purple];
		j4196769031 -> j1720640189 [label="LyonVisions1",color=purple];
		j4196769031 -> j2483866846 [label="LyonVisions1",color=purple];
		j4196769031 -> j3728405872 [label="LyonVisions1",color=purple];
		j4196769031 -> j325150749 [label="false",color=purple];
		j4196769031 -> j1720640189 [label="false",color=purple];
	j3728405872 [label="I've been warned that you might not see things the same way we do. But this doesn't bother me. I'm interested in what you know.",shape=box,color=red];
		j3728405872 -> j4234703709;
	j325150749 [label="Marie seems caught up in an obsession with \"le Cardinal.\" And Roathe clearly hates him. I'm looking for a neutral party. You're as close as I can get.",shape=box,color=red];
		j325150749 -> j2717580660;
	j1720640189 [label="I... don't know what else to ask you?",shape=box,color=red];
		j1720640189 -> j955252849;
	j2483866846 [label="I've been warned that you might not see things the same way we do. But I think you might see truth where others don't.",shape=box,color=red];
		j2483866846 -> j1737112434;
	j4234703709 [label="Hm. It does not bother you to sully yourself with madmen and lunatics? Curious. Though you seem to consort with talking animals and... creatures from out of time. I suppose I am no more or less outlandish than any of the rest of your collection.",shape=box,color=blue];
		j4234703709 -> j2845885253;
	j2717580660 [label="What a dearth of sensible options you have found yourself, when a madman and a lunatic is your only source for a \"neutral\" opinion. I cannot fathom why you bother speaking to me.",shape=box,color=blue];
		j2717580660 -> j2845885253;
	j955252849 [label="Why do you insist on talking to me at all? You needn't, you realize. If you wish to befriend - or even court - Marie, I am not her keeper, nor her father. And whatever your intentions with that bastard Roathe, I care little beyond the answers he owes me.",shape=box,color=blue];
		j955252849 -> j2845885253;
	j1737112434 [label="\"Truth.\" I wish you understood how laughable that was to me of late. Does it not bother you to sully yourself with madmen and lunatics? Curious. Though you seem to consort with talking animals and... creatures from out of time. I suppose I am no more or less outlandish than any of the rest of your collection.",shape=box,color=blue];
		j1737112434 -> j2845885253;
	j2845885253 [label="Evaluate expressions",color=orange];
		j2845885253 -> j759315851 [label="LyonFirstFlirt",color=purple];
		j2845885253 -> j759315851 [label="DrifterLyon",color=purple];
		j2845885253 -> j2614295175 [label="LyonOffer",color=purple];
		j2845885253 -> j2039845921 [label="false",color=purple];
	j759315851 [label="And please, do spare us both another... embarrassing moment, will you? I know what you have said is your reasons for speaking to me. And while I find then flattering, I also find them ridiculously insincere.",shape=box,color=blue];
		j759315851 -> j958696684;
		j759315851 -> j1269754054;
		j759315851 -> j3637426088;
	j2614295175 [label="And please, do spare us both another lecture on how you wish to \"help\" me, will you? I am certain you mean to be kind, but it is grating with it's ridiculous insincerity.",shape=box,color=blue];
		j2614295175 -> j958696684;
		j2614295175 -> j1269754054;
		j2614295175 -> j3637426088;
	j2039845921 [label="And please, do spare us both some lengthy lecture of how you wish to \"aid\" me or how you \"wish to be my friend.\" I am certain you mean to be kind, but it is grating with it's ridiculous insincerity.",shape=box,color=blue];
		j2039845921 -> j958696684;
		j2039845921 -> j1269754054;
		j2039845921 -> j3637426088;
	j958696684 [label="Insincere because you think I don't mean what I say, or insincere because you think I can't mean them about you?",shape=box,color=red];
		j958696684 -> j33595009;
	j1269754054 [label="Priest, all I wanted was the story of how long Entrati was pretending to be a Cardinal. That's all.",shape=box,color=red];
		j1269754054 -> j2702039275;
	j3637426088 [label="What do you mean, \"insincere?\" Are you calling me a liar?",shape=box,color=red];
		j3637426088 -> j5625625;
	j33595009 [label="Neither. Your words are charity that I neither need nor want.",shape=box,color=blue];
		j33595009 -> j2574720963;
		j33595009 -> j1946523516;
	j2702039275 [label="Quite right. Three years, two months, and eleven days, he served as Cardinal Dimanche in our Cathedral. And for all that time, Marie and I served him unknowing of what he planned for us.",shape=box,color=blue];
		j2702039275 -> j718747799;
	j5625625 [label="Evaluate expressions",color=orange];
		j5625625 -> j1975478868 [label="DrifterLiar",color=purple];
		j5625625 -> j925747064 [label="LyonSuspicious",color=purple];
		j5625625 -> j3913910062 [label="false",color=purple];
	j2574720963 [label="How does Marie put up with this...?",shape=box,color=red];
		j2574720963 -> j1332795477;
	j1946523516 [label="You think that anyone choosing to socialize with you is performing an act of charity?",shape=box,color=red];
		j1946523516 -> j2717313052;
	j718747799 [label="I know your questions before you ask them. What was he scheming? Did he infect the city, like I hear tell that he did to Höllvania? What were his plans? His discoveries?",shape=box,color=blue];
		j718747799 -> j4047898750;
	j1975478868 [label="Do you have something you wish to confess, Drifter? Is there penance you wish to pay?",shape=box,color=blue];
		j1975478868 -> j113686166;
	j925747064 [label="Hm. No. Not yet, perhaps.",shape=box,color=blue];
		j925747064 -> j3913910062;
	j3913910062 [label="Your insincerity is not a mistruth. It is meant as charity. Charity I neither need nor want. ",shape=box,color=blue];
		j3913910062 -> j2574720963;
		j3913910062 -> j1946523516;
	j1332795477 [label="Best to ask her that yourself. I have often wondered the same.",shape=box,color=blue];
		j1332795477 -> "Chat ends.";
	j2717313052 [label="Simply? Yes.",shape=box,color=blue];
		j2717313052 -> j3994772085;
	j4047898750 [label="To these I will say, you will be disappointed. For those three years, two months, and eleven days? He preached. He studied. He rested. And he prayed.",shape=box,color=blue];
		j4047898750 -> j3808334268;
		j4047898750 -> j863582923;
		j4047898750 -> j575054769;
	j113686166 [label="It is neither here nor there. You did not come to this conversation seeking forgiveness, nor are your former lies the same as your current insincerities.",shape=box,color=blue];
		j113686166 -> j372944641;
	j3994772085 [label="Boolean LyonHate1 is now true.",color=orange];
		j3994772085 -> j3101148329;
		j3994772085 -> j1978980782;
		j3994772085 -> j3165429550;
	j3808334268 [label="When did he turn you into protoframes?",shape=box,color=red];
		j3808334268 -> j1052882457;
	j863582923 [label="I am having a very hard time imagining Entrati praying.",shape=box,color=red];
		j863582923 -> j2283447799;
	j575054769 [label="So he was... on sabbatical?!",shape=box,color=red];
		j575054769 -> j3755899353;
	j372944641 [label="What you say now is merely charity. Charity neither need nor want.",shape=box,color=blue];
		j372944641 -> j2574720963;
		j372944641 -> j1946523516;
	j3101148329 [label="Something to dig into another day - I can feel this conversation spiraling out of control.",shape=box,color=red];
		j3101148329 -> j712735910;
	j1978980782 [label="What about Marie...?",shape=box,color=red];
		j1978980782 -> j168401430;
	j3165429550 [label="You must think very poorly of yourself.",shape=box,color=red];
		j3165429550 -> j2301935092;
	j1052882457 [label="After those three years and some-odd days, he disappeared in the midst of a terrible storm. The same as the one in which he appeared.",shape=box,color=blue];
		j1052882457 -> j3307858394;
	j2283447799 [label="It is impossible to know the inside workings of another's mind. He knelt at the altar and his head was bowed. Was he in prayer? Or was he simply lost within his own thoughts? I do not know.",shape=box,color=blue];
		j2283447799 -> j1052882457;
	j3755899353 [label="+5 Chemistry",color=orange];
		j3755899353 -> j2399016103;
	j712735910 [label="+5 Chemistry",color=orange];
		j712735910 -> j4004721641;
	j168401430 [label="Marie would cradle a rabid bear in her lap and let it tear out her throat if she thought it would bring the animal a moment's peace.",shape=box,color=blue];
		j168401430 -> j3875827879;
	j2301935092 [label="I would consider it a steadfast dedication to pragmatism, but define it however you like.",shape=box,color=blue];
		j2301935092 -> j2298255897;
	j3307858394 [label="Evaluate expressions",color=orange];
		j3307858394 -> j3918500297 [label="MarieLyonVisions",color=purple];
		j3307858394 -> j3918500297 [label="LyonVisions1",color=purple];
		j3307858394 -> j1318192840 [label="false",color=purple];
	j2399016103 [label="Heh. I did not think of it in such a way, but yes - perhaps he was. How perfectly infuriating for all the rest of you. It seems to fit with what little we know of his true self.",shape=box,color=blue];
		j2399016103 -> j1052882457;
	j4004721641 [label="That is likely a wise decision. You were asking after \"Cardinal Dimanche\" and his tenure at the Cathedral.",shape=box,color=blue];
		j4004721641 -> j933397303;
	j3875827879 [label="She is a singularly beautiful soul, one I will protect until my dying breath.",shape=box,color=blue];
		j3875827879 -> j2298255897;
	j2298255897 [label="+5 Chemistry",color=orange];
		j2298255897 -> j3345672254;
	j3918500297 [label="Though I am well aware the storm did not occur to others, it was quite vivid to my senses.",shape=box,color=blue];
		j3918500297 -> j1318192840;
	j1318192840 [label="One year to the day after that, he reappeared one final time, with... Roathe, as you see him now, collapsed and unconscious at his feet.",shape=box,color=blue];
		j1318192840 -> j1661403652;
	j933397303 [label="Three years, two months, and eleven days, he served as Cardinal Dimanche in our Cathedral. And for all that time, Marie and I served him unknowing of what he planned for us.",shape=box,color=blue];
		j933397303 -> j718747799;
	j3345672254 [label="But this is what you must come to expect, asking a madman a simple question is oft a wandering path. Allow me to redirect us to your original topic and away from my own.",shape=box,color=blue];
		j3345672254 -> j933397303;
	j1661403652 [label="A devil in the flesh, or so it seemed. It was then, that Entrati told us the truth of who he was - when he hailed - and the true task he had for us.",shape=box,color=blue];
		j1661403652 -> j2072683515;
	j2072683515 [label="That he had chosen us both for a most \"sacred mission.\"",shape=box,color=blue];
		j2072683515 -> j1258951219;
		j2072683515 -> j2982407252;
	j1258951219 [label="Why the quotes?",shape=box,color=red];
		j1258951219 -> j3209336581;
	j2982407252 [label="It sounds like you don't believe him.",shape=box,color=red];
		j2982407252 -> j3209336581;
	j3209336581 [label="I have learned much that makes me question Entrati's adherence to anything sacrosanct to any nature or god of any kind... if any such thing exists...",shape=box,color=blue];
		j3209336581 -> j3457841513;
		j3209336581 -> j2256095753;
	j3457841513 [label="If any such thing exists? Lyon, what do you mean?",shape=box,color=red];
		j3457841513 -> j3482240053;
	j2256095753 [label="Go on.",shape=box,color=red];
		j2256095753 -> j2671482800;
	j3482240053 [label="Boolean LyonFaith2 is now true.",color=orange];
		j3482240053 -> j2287603753;
	j2671482800 [label="Marie accepted the serum readily. Of course, she did. How could she not? And how could I not follow her? How could I not seek the truth, wherever it might lead?",shape=box,color=blue];
		j2671482800 -> j1813802388;
	j2287603753 [label="A matter for another time, kindly.",shape=box,color=blue];
		j2287603753 -> j2671482800;
	j1813802388 [label="Boolean LyonSerum1 is now true.",color=orange];
		j1813802388 -> j17063572;
		j1813802388 -> j3851745672;
		j1813802388 -> j3535948313;
	j17063572 [label="I think she still worships Entrati a bit too much.",shape=box,color=red];
		j17063572 -> j73843376;
	j3851745672 [label="What happened next?",shape=box,color=red];
		j3851745672 -> j1477835528;
	j3535948313 [label="Do you regret it?",shape=box,color=red];
		j3535948313 -> j864748503;
	j73843376 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j73843376 -> j2291578892;
	j1477835528 [label="Roathe awoke. At first, he could barely remember his name. Entrati said one parting phrase to the bastard. \"Uriel, Heretic of Xata, in banishment, answer - can the Orokin ever be forgiven?\"",shape=box,color=blue];
		j1477835528 -> j328634541;
	j864748503 [label="I regret everything, Drifter. Yes, of course I do. But would I do it again? Yes, of course I would. I cannot leave Marie alone.",shape=box,color=blue];
		j864748503 -> j1911572259;
	j2291578892 [label="In this, we are agreed. But I also cannot fault her for it. Give her time. She will come to understand. She is fiercely intelligent, Drifter. Do not treat her as a fool.",shape=box,color=blue];
		j2291578892 -> j1911572259;
	j328634541 [label="Entrati departed then for the last time. And abandoned Roathe with us, now newly changed into what you see now - better able to contend with the temperamental devil.",shape=box,color=blue];
		j328634541 -> j2832146058;
	j1911572259 [label="To finish the tale... Entrati departed then for the last time. And abandoned Roathe with us, now newly changed into what you see now - better able to contend with the temperamental devil.",shape=box,color=blue];
		j1911572259 -> j2832146058;
	j2832146058 [label="The rest, I fear, is a story that will have to wait. M. Loid requires use of the POM-2 and I am eager to relinquish it. I hope this has helped answer at least some of your questions.",shape=box,color=blue];
		j2832146058 -> j4041524014;
		j2832146058 -> j4014715343;
	j4041524014 [label="And raised double that amount in new ones.",shape=box,color=red];
		j4041524014 -> j3246634575;
	j4014715343 [label="It has, thank you.",shape=box,color=red];
		j4014715343 -> j1554883390;
	j3246634575 [label="+15 Chemistry",color=orange];
		j3246634575 -> j3488593155;
	j1554883390 [label="+10 Chemistry",color=orange];
		j1554883390 -> j3075023838;
	j3488593155 [label="Then I have done my duty as a priest. I bid thee good night.",shape=box,color=blue];
		j3488593155 -> j944546954;
	j3075023838 [label="Then I shall I bid thee good night.",shape=box,color=blue];
		j3075023838 -> j944546954;
	j944546954 [label="-F. Lyon Allard",shape=box,color=blue];
		j944546954 -> "Chat ends.";
}