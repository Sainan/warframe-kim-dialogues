digraph {
	1285 [label="LyonRank4Convo7 begins.",color=orange];
		1285 -> 1286;
	1286 [label="Drifter? May I apologize to you for something?",shape=box,color=blue];
		1286 -> 1287;
		1286 -> 1288;
		1286 -> 1289;
	1287 [label="Sure? What for?",shape=box,color=red];
		1287 -> 1290;
	1288 [label="You don't need to, Lyon. You haven't done anything wrong.",shape=box,color=red];
		1288 -> 1291;
	1289 [label="[End.]",shape=box,color=red];
		1289 -> 1292;
	1290 [label="+5 Chemistry",color=orange];
		1290 -> 1293;
	1291 [label="While I appreciate that, I do feel as though you are owed one all the same. I shall do my best to keep this brief, and not to overburden myself with needless erudition.",shape=box,color=blue];
		1291 -> 1294;
	1292 [label="Chat ends.",color=orange];
	1293 [label="Thank you. I shall do my best to keep this brief, and not to overburden myself with needless erudition.",shape=box,color=blue];
		1293 -> 1294;
	1294 [label="Conversations are difficult for me. Far more so in intimate engagements than they are in these kinds of impersonal, mechanical ones or by post.",shape=box,color=blue];
		1294 -> 1295;
	1295 [label="I do not know how to describe it - save for that it is... like I am grasping for something, only to see bits of dust slip through my fingers. ",shape=box,color=blue];
		1295 -> 1296;
	1296 [label="It feels oft as though I am an empty scrap of canvas, smearing oil paints upon its surface - uselessly attempting create a shadow of an image that I can see in my mind's eye.",shape=box,color=blue];
		1296 -> 1297;
	1297 [label="Yet the more and more I work, the more and more hopeless it becomes.",shape=box,color=blue];
		1297 -> 1298;
	1298 [label="The more I try, the more it eludes me. So I have simply learned... not to make any attempt at all.",shape=box,color=blue];
		1298 -> 1299;
	1299 [label="That is why I avoided you at first. And why I am still... prone to bouts of solitude. Words escape me.",shape=box,color=blue];
		1299 -> 1300;
		1299 -> 1301;
		1299 -> 1302;
	1300 [label="I will always be happy to have you next to me in silence.",shape=box,color=red];
		1300 -> 1303;
	1301 [label="I tend to be the same way, sometimes. It's all right.",shape=box,color=red];
		1301 -> 1304;
	1302 [label="Apology accepted.",shape=box,color=red];
		1302 -> 1305;
	1303 [label="+15 Chemistry",color=orange];
		1303 -> 1306;
	1304 [label="+15 Chemistry",color=orange];
		1304 -> 1307;
	1305 [label="+10 Chemistry",color=orange];
		1305 -> 1308;
	1306 [label="I... will remember that. Thank you, Drifter.",shape=box,color=blue];
		1306 -> 1309;
	1307 [label="I had not realized. I will remember not to assume I am so alone in this world... Thank you, Drifter.",shape=box,color=blue];
		1307 -> 1309;
	1308 [label="Of course. Thank you, Drifter.",shape=box,color=blue];
		1308 -> 1309;
	1309 [label="-F. Lyon Allard",shape=box,color=blue];
		1309 -> 1310;
	1310 [label="Chat ends.",color=orange];
}