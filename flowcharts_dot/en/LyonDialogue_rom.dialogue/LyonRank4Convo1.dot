	662 [label="I fear this are many topics I could discuss at length. But do not mistake me, I would be happy to, I simply do not wish to bore you to tears. What where would you like to begin?",shape=box,color=blue];
		662 -> 664;
		662 -> 665;
	675 [label="No, I'm more curious than anything else.",shape=box,color=red];
		675 -> 686;
	676 [label="I'm religious. It's similar to yours, though you wouldn't recognize it.",shape=box,color=red];
		676 -> 687;
	674 [label="I'm religious. You wouldn't recognize any of our practices, though.",shape=box,color=red];
		674 -> 685;
	673 [label="I'm religious. It's sort of a belief that's personal to me - it doesn't really have a name.",shape=box,color=red];
		673 -> 684;
	672 [label="I follow the path of Sol, like Marie.",shape=box,color=red];
		672 -> 679;
	671 [label="I'm like you, I follow the path of Lua.",shape=box,color=red];
		671 -> 679;
	666 [label="I follow the Luminaries, but I try to keep a balanced path.",shape=box,color=red];
		666 -> 679;
	667 [label="I believe there's something out there, but I don't think people really can know the answers at the end of the day.",shape=box,color=red];
		667 -> 680;
	668 [label="I'm not religious. I tend to think religion is a crutch of the fearful - no offense.",shape=box,color=red];
		668 -> 681;
	669 [label="I'm not religious. I won't say there couldn't be something out there, but it's just not something I worry about.",shape=box,color=red];
		669 -> 682;
	670 [label="I'm not religious. I think all gods - even the Indifference - is a product of our imagination. No offense.",shape=box,color=red];
		670 -> 683;
	664 [label="Could you tell me about your holidays?",shape=box,color=red];
