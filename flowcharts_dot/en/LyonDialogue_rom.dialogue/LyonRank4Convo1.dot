	755 [label="How so?",shape=box,color=blue];
		755 -> 760;
	754 [label="I will tell you the story of the first eclipse I witnessed another time. It has grown late here. Or perhaps it is early. I cannot quite tell.",shape=box,color=blue];
		754 -> 759;
	748 [label="I haven't.",shape=box,color=red];
		748 -> 756;
	749 [label="I have. It wasn't that impressive.",shape=box,color=red];
		749 -> 757;
	750 [label="I have. It was okay.",shape=box,color=red];
		750 -> 757;
	751 [label="I have. It was amazing.",shape=box,color=red];
		751 -> 746;
	753 [label="I have. It gave me a horrible ocular megrim, believe it or not. But it was amazing.",shape=box,color=red];
		753 -> 758;
	752 [label="I have. It gave me a horrible ocular migraine, believe it or not. But it was amazing.",shape=box,color=red];
		752 -> 758;
	760 [label="Does this phrase sound familiar to you: \"On empty crossroads, seek the eclipse - for when Sol and Lua align, the lost shall find their way home.\"",shape=box,color=red];
		760 -> 764;
	759 [label="Update boolean LyonFirstEclipse",color=orange];
