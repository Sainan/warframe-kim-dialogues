	757 [label="Would that I could share your impassiveness over the event...",shape=box,color=blue];
		757 -> 746;
	758 [label="You must be touched by the Luminaries, and their presence overwhelmed you. Or perhaps they wished to smite you for some great sin. One of the other. Heh.",shape=box,color=blue];
		758 -> 761;
	764 [label="Celestines 18:19, from the Third Orthodox Book of Lua. Where in the name of the Luminaries did you hear it?",shape=box,color=blue];
		764 -> 767;
