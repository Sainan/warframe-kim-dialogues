		763 -> 766;
	761 [label="Such is the way of the gods. Their signs can often be interpreted any which way.",shape=box,color=blue];
		761 -> 754;
	767 [label="It's a very long story. But needless to say, I think some of your scripture is now running around with the Indifference.",shape=box,color=red];
		767 -> 770;
	768 [label="From some old friends. They were using it as two halves of a spy phrase with their daughter who... never mind, actually.",shape=box,color=red];
