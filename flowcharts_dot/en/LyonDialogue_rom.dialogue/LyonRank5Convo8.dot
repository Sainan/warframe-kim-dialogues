	j3527128181 [label="You have brought him a manner of surety. Purpose. And for this, I could not be more grateful. And I know the same goes for Marie.",shape=box,color=blue];
		j3527128181 -> j2626940487;
	j3486888134 [label="I do not know what will come of his fate. I hope we can resolve it. For I worry what he will twist himself into if left to his own devices overlong.",shape=box,color=blue];
