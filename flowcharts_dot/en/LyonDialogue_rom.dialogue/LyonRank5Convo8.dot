	"Chat ends." [color=orange];
	j4170257612 [label="Things in this false crypt are much improved, I must say. Or perhaps that is simply my perception of things. I have been... distracted of late.",shape=box,color=blue];
		j4170257612 -> j1890799654;
	j3032743143 [label="Things in this false crypt are much improved, I must say. You have been giving him an outlet for his frustrations, have you not?",shape=box,color=blue];
		j3032743143 -> j2433407510;
	j1069459167 [label="You have brought him a manner of surety. Purpose. And for this, I could not be more grateful. And I know the same goes for Marie.",shape=box,color=blue];
		j1069459167 -> j3043725382;
	j2591330860 [label="Not much has changed, I fear. I think that poor beast is liable to rip himself apart in his angst before long.",shape=box,color=blue];
