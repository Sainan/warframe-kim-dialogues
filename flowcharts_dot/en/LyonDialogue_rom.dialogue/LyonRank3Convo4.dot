	"Chat ends." [color=orange];
	j801521378 [label="Boolean LyonFaith1 is now true.",color=orange];
		j801521378 -> "Chat ends.";
	j2766684444 [label="Perhaps you might have sensed my... own adherence to faith has... suffered a blow, of late.",shape=box,color=blue];
		j2766684444 -> j4063160105;
	j4287153101 [label="My own adherence to faith has... suffered a blow, of late.",shape=box,color=blue];
		j4287153101 -> j84261408;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j350519690 [label="Boolean DrifterLiar is now true.",color=orange];
		j350519690 -> j1306753959;
	j65499600 [label="Boolean LyonSuspicious is now true.",color=orange];
		j65499600 -> j1306753959;
	j744410903 [label="I know the devil has spoken to you of his theories. And I find myself wondering, in the late hours, if there is not some sense to them.",shape=box,color=blue];
		j744410903 -> j1754569992;
	j2903423775 [label="+20 Chemistry",color=orange];
		j2903423775 -> j3831189584;
	j1405559601 [label="Why would a god with no grasp of the mind of humanity, seek to laugh at our own folly? Why would it wish to torment us? To mock our failures and mimic or forms?",shape=box,color=blue];
		j1405559601 -> j1927698124;
	j4063160105 [label="I apologize again for it is not something I wish to discuss. I imagine it is not hard to deduce, given your grander familiarity with the situation, the reasons as to why.",shape=box,color=blue];
		j4063160105 -> j1686847565;
		j4063160105 -> j1209899760;
	j84261408 [label="Boolean LyonFaith1 is now true.",color=orange];
		j84261408 -> j4063160105;
	j1306753959 [label="Hm. Indeed. What must it be like, to be an unknowable god, turned into an ant like one of us?",shape=box,color=blue];
		j1306753959 -> j3831189584;
	j1927698124 [label="Is there anything more terrifying than to gaze into the gaping maw of Nothing and to see Nothing gazing back? To know how infinitesimal we may truly be? ",shape=box,color=blue];
		j1927698124 -> j3312777670;
	j1686847565 [label="I believe it might have something to do with Entrati. And perhaps the Indifference.",shape=box,color=red];
		j1686847565 -> j3341673650;
	j1209899760 [label="Yes, but we did just arrive here due to my making assumptions about the motivations of others, didn't we?",shape=box,color=red];
		j1209899760 -> j3310763948;
	j3312777670 [label="What I would not give for the silence of the Void. For the stillness that it portends. Anything - anything - but for the maddening voices that follow instead...",shape=box,color=blue];
		j3312777670 -> j2697721673;
	j3341673650 [label="Then I am correct, and we needn't speak of it.",shape=box,color=blue];
		j3341673650 -> "Chat ends.";
	j3310763948 [label="+10 Chemistry",color=orange];
		j3310763948 -> j2237940889;
	j2697721673 [label="And it is these voices that give me such doubt, Drifter. And the reason why my hands tremble as I type these words...",shape=box,color=blue];
		j2697721673 -> j4047535777;
	j2237940889 [label="I... yes. Once more, you are correct. Thank you. I will amend my statement to be that I am... simply unwilling to speak of it at the moment.",shape=box,color=blue];
		j2237940889 -> j214950852;
	j4047535777 [label="+10 Chemistry",color=orange];
		j4047535777 -> j1118965030;
	j214950852 [label="I must return to my prayers. Tepid as they may be.",shape=box,color=blue];
		j214950852 -> j944546954;
	j1118965030 [label="Forgive me. I... must go.",shape=box,color=blue];
		j1118965030 -> j944546954;
}