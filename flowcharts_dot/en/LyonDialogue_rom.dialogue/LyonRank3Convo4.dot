digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank3Convo4 begins." [color=orange];
		"LyonRank3Convo4 begins." -> j2186589947;
	j2186589947 [label="Pardon the directness of the question, but I do not know how else to phrase it. What are the Murmur?",shape=box,color=blue];
		j2186589947 -> j4181235701;
		j2186589947 -> j2114211220;
		j2186589947 -> j2771541473;
	j4181235701 [label="Anything I tell you is only guessing at the \"mind\" of \"the Indifference.\"",shape=box,color=red];
		j4181235701 -> j1307355008;
	j2114211220 [label="I believe they are the Void's attempt to... understand the human form.",shape=box,color=red];
		j2114211220 -> j1890953739;
	j2771541473 [label="Do you mean that literally or metaphorically?",shape=box,color=red];
		j2771541473 -> j3405621113;
	j1307355008 [label="Evaluate expressions",color=orange];
		j1307355008 -> j3889873528 [label="DrifterFaithNoMITW",color=purple];
		j1307355008 -> j1365852669 [label="LyonFake1",color=purple];
		j1307355008 -> j3641198648 [label="LyonFaith1",color=purple];
		j1307355008 -> j3904214618 [label="LyonReal1",color=purple];
		j1307355008 -> j3569671943 [label="false",color=purple];
	j1890953739 [label="Is that so? Are you so certain of that?",shape=box,color=blue];
		j1890953739 -> j3592508897;
		j1890953739 -> j2231013793;
		j1890953739 -> j4006254167;
	j3405621113 [label="Ah. Yes. A good clarification. I suppose I mean it metaphorically. They are clearly literally made of dust and ash.",shape=box,color=blue];
		j3405621113 -> j731518061;
	j3889873528 [label="+10 Chemistry",color=orange];
		j3889873528 -> j476134122;
	j1365852669 [label="+10 Chemistry",color=orange];
		j1365852669 -> j2777823165;
	j3641198648 [label="+10 Chemistry",color=orange];
		j3641198648 -> j668326503;
	j3904214618 [label="+10 Chemistry",color=orange];
		j3904214618 -> j3569671943;
	j3569671943 [label="Intriguing. I had assumed you believed your Indifference to be a deity, much in the same manner as Lua or Sol. Was I incorrect?",shape=box,color=blue];
		j3569671943 -> j3667141333;
		j3569671943 -> j2292991172;
	j3592508897 [label="No. But I think it gives me a kind of peace to think I can guess at what the Indifference is doing, at the end of the day.",shape=box,color=red];
		j3592508897 -> j1891031711;
	j2231013793 [label="No, I suppose I'm not, at the end of the day. But I've had enough interactions with it, that I feel like I'm justified in trying to figure it out.",shape=box,color=red];
		j2231013793 -> j1945566558;
	j4006254167 [label="What else could they be? The Indifference seems to be taking each part of the human body and trying to work out its purpose, one at a time.",shape=box,color=red];
		j4006254167 -> j266285912;
	j731518061 [label="As that is what they devolve into once slain. We have all proven that many times over.",shape=box,color=blue];
		j731518061 -> j1251344974;
		j731518061 -> j3725806402;
		j731518061 -> j3492980240;
	j476134122 [label="Mm. Yes. Marie told me of this. You do not believe in the workings of invisible forces in our world - including that of the Indifference. Is that so?",shape=box,color=blue];
		j476134122 -> j1417245943;
		j476134122 -> j1598512131;
	j2777823165 [label="Intriguing. This is the second time I have gleaned the impression from you that you do not seem to hold faith in the reality of your Indifference. Is that so?",shape=box,color=blue];
		j2777823165 -> j348876626;
		j2777823165 -> j2242047411;
	j668326503 [label="Intriguing. Do I glean from you that your own faith has been shaken as of late? Or have you never had any in your Indifference to begin with?",shape=box,color=blue];
		j668326503 -> j348876626;
		j668326503 -> j2242047411;
	j3667141333 [label="I'm not sure the Indifference was real until we made it real. I think we conjured it just the same way I conjured Duviri.",shape=box,color=red];
		j3667141333 -> j117571560;
	j2292991172 [label="I do think the Indifference is a real deity - with a real sentience behind it.",shape=box,color=red];
		j2292991172 -> j557500912;
	j1891031711 [label="Sometimes, I wonder if that is not the reason why so many turn to faith at the end of the day...",shape=box,color=blue];
		j1891031711 -> j3671249490;
	j1945566558 [label="Pardon, but I begin to worry when any individual feels \"justified\" in any action, especially when it comes to predicting the motivations of others.",shape=box,color=blue];
		j1945566558 -> j376972050;
		j1945566558 -> j707901120;
	j266285912 [label="Should we be concerned about what may happen when it moves on to the less obvious parts?",shape=box,color=blue];
		j266285912 -> j876911439;
	j1251344974 [label="I think the Indifference is trying to learn to be \"human.\" It was always something Bigger. Different. So it's learning how to exist as something Smaller, and Us.",shape=box,color=red];
		j1251344974 -> j2741587556;
	j3725806402 [label="Sometimes I wonder if the Indifference never really had a body of its own before we interacted with it. So it's learning how to exist.",shape=box,color=red];
		j3725806402 -> j1748282185;
	j3492980240 [label="I think the Indifference seems to be taking each part of the human body and trying to work out its purpose, one at a time.",shape=box,color=red];
		j3492980240 -> j266285912;
	j1417245943 [label="I'm not sure the Indifference was real until we made it real. I think we conjured it just the same way I conjured Duviri.",shape=box,color=red];
		j1417245943 -> j1006156528;
	j1598512131 [label="I'm sorry she told you that. I do think the Indifference is a real deity - with a real sentience behind it.",shape=box,color=red];
		j1598512131 -> j4217905354;
	j348876626 [label="Sometimes I wonder if the Indifference never really had a body of its own before we interacted with it. So it's learning how to exist.",shape=box,color=red];
		j348876626 -> j117571560;
	j2242047411 [label="No, I didn't mean to infer that, I'm sorry. I do think the Indifference is a real deity - with a real sentience behind it.",shape=box,color=red];
		j2242047411 -> j157182301;
	j117571560 [label="Boolean LyonFake1 is now true.",color=orange];
		j117571560 -> j2732436049;
	j557500912 [label="Ah. Forgive me, I misinterpreted. Well, I appreciate that you are honest, even in your uncertainty, though it leaves me alone in my ponderings.",shape=box,color=blue];
		j557500912 -> j4141989144;
	j3671249490 [label="Peace in invented answers where none other can be found.",shape=box,color=blue];
		j3671249490 -> j3173401280;
	j376972050 [label="And pardon me, but aren't you a priest who decides who is \"righteous\" and who is \"damned?\" Isn't that a bit hypocritical?",shape=box,color=red];
		j376972050 -> j2281533172;
	j707901120 [label="Forgive me. I didn't mean to offend you.",shape=box,color=red];
		j707901120 -> j928010462;
	j876911439 [label="That was a poor attempt at humor, forgive me. I shall pay myself ten lashes in recompense.",shape=box,color=blue];
		j876911439 -> j2372204938;
		j876911439 -> j2917186848;
	j2741587556 [label="Boolean LyonReal1 is now true.",color=orange];
		j2741587556 -> j4235260738;
	j1748282185 [label="Boolean LyonFake1 is now true.",color=orange];
		j1748282185 -> j4048205816;
	j1006156528 [label="These are the words of the devil, but the more I hear them, the more they make sense to me.",shape=box,color=blue];
		j1006156528 -> j1754569992;
	j4217905354 [label="Check boolean LyonSuspicious",color=orange];
		j4217905354 -> j886150298 [label=true,color=green];
		j4217905354 -> j2687657174 [label=false,color=brown];
	j157182301 [label="Boolean LyonReal1 is now true.",color=orange];
		j157182301 -> j299904583;
	j2732436049 [label="Boolean LyonReal1 is now false.",color=orange];
		j2732436049 -> j1006156528;
	j4141989144 [label="+10 Chemistry",color=orange];
		j4141989144 -> j3831189584;
	j3173401280 [label="Thank you. I believe that is enough for today.",shape=box,color=blue];
		j3173401280 -> j1812768186;
	j2281533172 [label="+10 Chemistry",color=orange];
		j2281533172 -> j4122544175;
	j928010462 [label="+10 Chemistry",color=orange];
		j928010462 -> j56035321;
	j2372204938 [label="Regardless, I don't know why it's imitating human parts. I think to figure out what makes us \"tick.\"",shape=box,color=red];
		j2372204938 -> j4104982277;
	j2917186848 [label="That is a mental image that will linger with me for a while. I will let you decide which one - the lashes, or the Murmur.",shape=box,color=red];
		j2917186848 -> j1616388075;
	j4235260738 [label="Boolean LyonFake1 is now false.",color=orange];
		j4235260738 -> j3368949293;
	j4048205816 [label="Boolean LyonReal1 is now false.",color=orange];
		j4048205816 -> j670095942;
	j1754569992 [label="What is the Void, but nothing at all? A scrying mirror of swirling polished onyx for us to gaze upon, waiting for our reflection to twist and deform?",shape=box,color=blue];
		j1754569992 -> j2435081139;
	j886150298 [label="Boolean DrifterLiar is now true.",color=orange];
		j886150298 -> j453648713;
	j2687657174 [label="Boolean LyonSuspicious is now true.",color=orange];
		j2687657174 -> j453648713;
	j299904583 [label="Boolean LyonFake1 is now false.",color=orange];
		j299904583 -> j557500912;
	j3831189584 [label="Thank you. I must return to my duties, I am afraid.",shape=box,color=blue];
		j3831189584 -> j944546954;
	j1812768186 [label="-F. Lyon Allard",shape=box,color=blue];
		j1812768186 -> j2379301672;
	j4122544175 [label="Yes... I fear it is. And I loathe to think your opinion of me has suffered so quickly and so incorrectly.",shape=box,color=blue];
		j4122544175 -> j637016252;
	j56035321 [label="You are forgiven.",shape=box,color=blue];
		j56035321 -> j19917125;
	j4104982277 [label="Hm. Curious. But disappointing, in its scope. You believe it is nothing more than a child playing with toys. I must return to my duties.",shape=box,color=blue];
		j4104982277 -> j789460724;
	j1616388075 [label="+20 Chemistry",color=orange];
		j1616388075 -> j514120632;
	j3368949293 [label="Evaluate expressions",color=orange];
		j3368949293 -> j1615317553 [label="DrifterFaithNoMITW",color=purple];
		j3368949293 -> j3783951817 [label="RoatheMITW1",color=purple];
		j3368949293 -> j1692949758 [label="false",color=purple];
	j670095942 [label="What is the Void, but nothing at all?",shape=box,color=blue];
		j670095942 -> j2700663633;
	j2435081139 [label="Seeking in our own selves a glimmer of eternity - of a genius that we wish may extend beyond the briefest ember of our mortal lives. In those shadows, what manner of terrors could such an emptiness create, feeding upon the darkness in our own minds, our own empty souls?",shape=box,color=blue];
		j2435081139 -> j2877830489;
	j453648713 [label="Hm. I misinterpreted. I appreciate that you are honest, even in your uncertainty, though it leaves me alone in my ponderings.",shape=box,color=blue];
		j453648713 -> j4141989144;
	j944546954 [label="-F. Lyon Allard",shape=box,color=blue];
		j944546954 -> "Chat ends.";
