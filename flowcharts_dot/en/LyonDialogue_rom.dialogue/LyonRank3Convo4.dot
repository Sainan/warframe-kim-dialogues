		j2379301672 -> j801521378;
	j637016252 [label="Check boolean LyonFaith1",color=orange];
		j637016252 -> j2766684444 [label=true,color=green];
		j637016252 -> j4287153101 [label=false,color=brown];
	j19917125 [label="I must return to my duties. Unfortunately, we have not finished our discussion, but... c'est la vie.",shape=box,color=blue];
		j19917125 -> j944546954;
	j789460724 [label="-F. Lyon Allard",shape=box,color=blue];
		j789460724 -> j1933300832;
	j514120632 [label="Marie will tell you how difficult it is to procure a smile from me. So I should tell you when you have achieved one. Well played.",shape=box,color=blue];
		j514120632 -> j19917125;
	j1615317553 [label="Check boolean LyonSuspicious",color=orange];
		j1615317553 -> j350519690 [label=true,color=green];
		j1615317553 -> j65499600 [label=false,color=brown];
	j3783951817 [label="What must it be like, to be an unknowable god, turned into an ant like one of us?",shape=box,color=blue];
		j3783951817 -> j744410903;
	j1692949758 [label="What must it be like, to be an unknowable god, turned into an ant like one of us?",shape=box,color=blue];
		j1692949758 -> j4141989144;
	j2700663633 [label="Interesting... yes, I suppose that would make a great deal of sense.",shape=box,color=blue];
		j2700663633 -> j2903423775;
