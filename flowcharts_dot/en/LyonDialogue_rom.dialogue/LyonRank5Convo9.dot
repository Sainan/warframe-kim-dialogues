digraph {
	2100 [label="LyonRank5Convo9 begins.",color=orange];
		2100 -> 2101;
	2101 [label="Evaluate expressions",color=orange];
		2101 -> 2102 [label="LyonDating, LyonDatingConfession",color=purple];
		2101 -> 2103 [label="LyonDating",color=purple];
		2101 -> 2102 [label="false",color=purple];
	2102 [label="Chat ends.",color=orange];
	2103 [label="Mon miracle, I... must make very certain you understand something before I tell you this next anecdote of mine. ",shape=box,color=blue];
		2103 -> 2104;
	2104 [label="It is important to me that you are paying very close attention to these next words that I send you. Do you understand?",shape=box,color=blue];
		2104 -> 2105;
		2104 -> 2106;
	2105 [label="You're making me nervous. What's wrong?",shape=box,color=red];
		2105 -> 2107;
	2106 [label="Yes, I'm here. Go ahead.",shape=box,color=red];
		2106 -> 2108;
	2107 [label="Nothing is wrong - quite the opposite. That is what is so imperative for you to comprehend - the dire consequences from which I wish to free you, should you assume they might follow.",shape=box,color=blue];
		2107 -> 2109;
		2107 -> 2110;
		2107 -> 2111;
	2108 [label="+5 Chemistry",color=orange];
		2108 -> 2112;
	2109 [label="I'm listening.",shape=box,color=red];
		2109 -> 2113;
	2110 [label="You're not making much sense.",shape=box,color=red];
		2110 -> 2114;
	2111 [label="Dire consequences of... what?",shape=box,color=red];
		2111 -> 2115;
	2112 [label="Thank you. Before I begin I wish to assure you that there is nothing wrong - however, therein lies perhaps the dire consequences from which I wish to free you, should you assume they might follow.",shape=box,color=blue];
		2112 -> 2109;
		2112 -> 2110;
		2112 -> 2111;
	2113 [label="+5 Chemistry",color=orange];
		2113 -> 2116;
	2114 [label="Yes. I am painfully aware of this.",shape=box,color=blue];
		2114 -> 2115;
	2115 [label="Allow me to begin again.",shape=box,color=blue];
		2115 -> 2116;
	2116 [label="I am aware that I can be construed by many, and in fact, very well might be, in reality, to be... unwell. At the very least, I am not entirely of sound mind.",shape=box,color=blue];
		2116 -> 2117;
	2117 [label="I have long since come to be at peace with this. It does not trouble me any longer. The visions that plague me - the voices - I have come to find ways to live with them without fear or hatred.",shape=box,color=blue];
		2117 -> 2118;
	2118 [label="(Lately, I think, a little out of spite if I might be honest, but that is neither here nor there.)",shape=box,color=blue];
		2118 -> 2119;
	2119 [label="But I wish you to understand that if you were to end this between us - this bond that I thought was previously heretofore impossible between myself and another -",shape=box,color=blue];
		2119 -> 2120;
	2120 [label="If you were to ever let your heart wander away from mine? ",shape=box,color=blue];
		2120 -> 2121;
	2121 [label="I will endure, mon miracle.",shape=box,color=blue];
		2121 -> 2122;
	2122 [label="I will not be consumed by that which has plagued me. ",shape=box,color=blue];
		2122 -> 2123;
	2123 [label="Check boolean LyonAllRight",color=orange];
		2123 -> 2125 [label=true,color=green];
		2123 -> 2124 [label=false,color=brown];
	2125 [label="I will be, to use your colloquialism, \"all right.\" I will find cause to smile and laugh once more.",shape=box,color=blue];
		2125 -> 2126;
		2125 -> 2127;
	2124 [label="I will survive. I will be fine. I will find cause to smile and laugh once more.",shape=box,color=blue];
		2124 -> 2126;
		2124 -> 2127;
	2126 [label="Oh, Lyon... you aren't a burden to me.",shape=box,color=red];
		2126 -> 2128;
	2127 [label="Are you... saying you want to end things between us?",shape=box,color=red];
		2127 -> 2129;
	2128 [label="I am simply attempting to free you of any perceived hardship you might feel on my account...",shape=box,color=blue];
		2128 -> 2130;
		2128 -> 2131;
		2128 -> 2132;
	2129 [label="No! Anything of the sort! I am simply attempting to free you of any perceived hardship you might feel on my account.",shape=box,color=blue];
		2129 -> 2130;
		2129 -> 2131;
		2129 -> 2132;
	2130 [label="Your pain... echoes a kind of my own. It'd never be a hardship to help you through it.",shape=box,color=red];
		2130 -> 2133;
	2131 [label="I can't describe what draws me to you. But you will never be a duty or a burden.",shape=box,color=red];
		2131 -> 2134;
	2132 [label="[Break up.] This is all just become too much for me, I'm sorry. It might be best to end things here.",shape=box,color=red];
		2132 -> 2135;
	2133 [label="To which I cannot express how much my heart breaks in turn for you. But that I am forever grateful that our lonely ghosts of pain have found each other.",shape=box,color=blue];
		2133 -> 2136;
	2134 [label="To which I cannot properly express my gratitude, and I do not think any words ever can.",shape=box,color=blue];
		2134 -> 2136;
	2135 [label="Yes. Of course. It would be... hypocritical to accept any other answer at this point in time... ",shape=box,color=blue];
		2135 -> 2137;
	2136 [label="But now that I have gone through great pains to go through what has been a most spectacularly self-indulgent preamble...",shape=box,color=blue];
		2136 -> 2138;
		2136 -> 2139;
		2136 -> 2140;
	2137 [label="I understand completely. And I wish you nothing but the best. And I will cherish all the moments we have spent together.",shape=box,color=blue];
		2137 -> 2141;
	2138 [label="For a guy who started off silent, you really did get wordy.",shape=box,color=red];
		2138 -> 2142;
	2139 [label="I find them endearing, don't worry.",shape=box,color=red];
		2139 -> 2143;
	2140 [label="You could've just said \"I'll be fine, you know, if we ever go our separate ways.\"",shape=box,color=red];
		2140 -> 2144;
	2141 [label="I will remember them in my soul, even if they vanish from my mind. Farewell.",shape=box,color=blue];
		2141 -> 2145;
	2142 [label="+5 Chemistry",color=orange];
		2142 -> 2146;
	2143 [label="+5 Chemistry",color=orange];
		2143 -> 2147;
	2144 [label="+5 Chemistry",color=orange];
		2144 -> 2148;
	2145 [label="Update boolean LyonDating",color=orange];
		2145 -> 2149;
	2146 [label="Bah! If you did not wish to be privy to the inner workings of my mind, you should not have gone poking about. You are entirely to blame for that.",shape=box,color=blue];
		2146 -> 2150;
	2147 [label="I am quite glad you enjoy my wanderings. This is precisely why I choose to speak as little as I do. Can you imagine enduring this in person? Marie would have put me down years ago like a mad dog.",shape=box,color=blue];
		2147 -> 2150;
	2148 [label="There is a certain amount of irreverence and sarcasm to which you naturally prevail that I could never hope to ascend. I will leave it to you.",shape=box,color=blue];
		2148 -> 2150;
	2149 [label="Update boolean IsDating",color=orange];
		2149 -> 2151;
	2150 [label="Nevertheless, all of this was meant to serve as pretext to a story that will now seem quite short in comparison to the rest...",shape=box,color=blue];
		2150 -> 2152;
	2151 [label="- Lyon",shape=box,color=blue];
		2151 -> 2153;
	2152 [label="I awoke last night from a nightmare. When I did, shadows surrounded me. This is nothing foreign or new in my state of mind. They loomed over my bed, and would not clear.",shape=box,color=blue];
		2152 -> 2154;
	2153 [label="Chat ends.",color=orange];
	2154 [label="I was not frightened of them, for I knew they could not harm me. However, they would not be gone from my mind, either. There was only one I knew to be rid of them.",shape=box,color=blue];
		2154 -> 2155;
	2155 [label="Pushing up from bed, I dressed as best I could, staggering through the blurry vision of the continued nightmare. I grasped my thurible and fell to my knees in the middle of my floor, and prepared to... well. ",shape=box,color=blue];
		2155 -> 2156;
	2156 [label="I prepared to \"clear my mind.\" We shall leave it at that.",shape=box,color=blue];
		2156 -> 2157;
	2157 [label="But as I shut my eyes, my mind wandered. My thoughts drifted... to you, mon miracle...",shape=box,color=blue];
		2157 -> 2158;
	2158 [label="The sound of your voice. The touch of your hand upon my shoulder... ",shape=box,color=blue];
		2158 -> 2159;
	2159 [label="And the visions... fled. They abandoned their post, chased away by the stronger ghost... of you.",shape=box,color=blue];
		2159 -> 2160;
	2160 [label="I... stood. Placed my thurible upon the nightstand, and... opted to walk through the sand of the Sanctum instead...",shape=box,color=blue];
		2160 -> 2161;
		2160 -> 2162;
	2161 [label="I can understand why you felt the need for the preamble, now.",shape=box,color=red];
		2161 -> 2163;
	2162 [label="I don't know what to say...",shape=box,color=red];
		2162 -> 2164;
	2163 [label="Yes. Well. On my walk I... instantly realized the dark danger of such a moment. That you might... come to think it a responsibility - come to see me as chains that weigh you down.",shape=box,color=blue];
		2163 -> 2165;
	2164 [label="+5 Chemistry",color=orange];
		2164 -> 2166;
	2165 [label="I beg of you - I pray, to any god or gods on high or below - that you never do. This is a gift you have given me, and each time in its newness I will cherish it.",shape=box,color=blue];
		2165 -> 2167;
	2166 [label="There are no words needed, mon miracle... ",shape=box,color=blue];
		2166 -> 2168;
	2167 [label="Vow to me, mon miracle - that should the time come, that I have become for you an empty cage... you will be free of me.",shape=box,color=blue];
		2167 -> 2169;
	2168 [label="On my walk I... instantly realized the dark danger of such a moment. That you might... come to think it a responsibility - come to see me as chains that weigh you down.",shape=box,color=blue];
		2168 -> 2165;
	2169 [label="I shall be no hollow prison for those I love. Not for you. Not for Marie.",shape=box,color=blue];
		2169 -> 2170;
		2169 -> 2171;
	2170 [label="[Break up.] I - I can't. I can't promise that, I'm sorry.",shape=box,color=red];
		2170 -> 2172;
	2171 [label="I vow it. ",shape=box,color=red];
		2171 -> 2173;
	2172 [label="+10 Chemistry",color=orange];
		2172 -> 2174;
	2173 [label="+10 Chemistry",color=orange];
		2173 -> 2175;
	2174 [label="Thank you. Thank you, mon miracle, for your honesty. This took bravery, in this moment, and I commend you for it.",shape=box,color=blue];
		2174 -> 2176;
	2175 [label="Thank you. Thank you, mon miracle...",shape=box,color=blue];
		2175 -> 2177;
	2176 [label="I will cherish all the moments we have spent together. This, I mean more than you can imagine.",shape=box,color=blue];
		2176 -> 2178;
	2177 [label="I am suddenly so very tired, as if... a great weight has been lifted from my shoulders. I fear I must go lie down.",shape=box,color=blue];
		2177 -> 2179;
	2178 [label="I will remember them in my soul, even if they vanish from my mind. Farewell.",shape=box,color=blue];
		2178 -> 2180;
	2179 [label="- Lyon",shape=box,color=blue];
		2179 -> 2181;
	2180 [label="Update boolean LyonDating",color=orange];
		2180 -> 2182;
	2181 [label="Update boolean LyonDatingConfession",color=orange];
		2181 -> 2183;
	2182 [label="Update boolean IsDating",color=orange];
