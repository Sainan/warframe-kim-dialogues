digraph {
	"LyonFlirt begins." [color=orange];
		"LyonFlirt begins." -> j242130024;
		"LyonFlirt begins." -> j2568275980;
		"LyonFlirt begins." -> j2072485823;
	j242130024 [label="Lyon? Can we talk? ",shape=box,color=red];
		j242130024 -> j1589420450;
	j2568275980 [label="Lyon? I'm very, very sorry if what I said made you uncomfortable. That wasn't my intention.",shape=box,color=red];
		j2568275980 -> j3224343848;
	j2072485823 [label="[End.]",shape=box,color=red];
		j2072485823 -> j2883342425;
	j1589420450 [label="What would you care to discuss, Drifter?",shape=box,color=blue];
		j1589420450 -> j3661057796;
	j3224343848 [label="I suppose then, I am simply left wondering, if you were not being flirtatious with me in order to make me uncomfortable for your own amusement... why were you being flirtatious in the first place?",shape=box,color=blue];
		j3224343848 -> j702246412;
		j3224343848 -> j3909137254;
		j3224343848 -> j4131499256;
	j2883342425 [label="Boolean LyonFlirtIgnored is now true.",color=orange];
		j2883342425 -> "Chat ends.";
	j3661057796 [label="Your flirtatious commentary for your own amusement? Or would you like to move on to other topics?",shape=box,color=blue];
		j3661057796 -> j917761598;
		j3661057796 -> j2437503155;
		j3661057796 -> j4131499256;
	j702246412 [label="I'm interested in you, Lyon. It's as simple as that.",shape=box,color=red];
		j702246412 -> j3234856851;
	j3909137254 [label="I don't know what got into me, Lyon. Clearly this was all a mistake. I'm very sorry.",shape=box,color=red];
		j3909137254 -> j3255945121;
	j4131499256 [label="I... meant what I said. But this is all too fast, I understand.",shape=box,color=red];
		j4131499256 -> j3255945121;
	"Chat ends." [color=orange];
	j917761598 [label="I wasn't flirting with you to amuse myself, Lyon. I'm sorry if you think that's what it was about.",shape=box,color=red];
		j917761598 -> j3255945121;
	j2437503155 [label="I didn't mean to offend you, I was just teasing. I'm sorry.",shape=box,color=red];
		j2437503155 -> j2027845402;
	j3234856851 [label="And it is not mutual. It is as simple as that.",shape=box,color=blue];
		j3234856851 -> "Chat ends.";
	j3255945121 [label="I... Forgive me, Drifter.",shape=box,color=blue];
		j3255945121 -> j3859659039;
	j2027845402 [label="I see.",shape=box,color=blue];
		j2027845402 -> "Chat ends.";
	j3859659039 [label="And pardon my bluntness once more when I express all that has come to overwhelm my mind as of late:",shape=box,color=blue];
		j3859659039 -> j2734898135;
	j2734898135 [label="I am surrounded now by strangers and talking beasts in a world of fantastical madness and seemingly endless and rampant slaughter.",shape=box,color=blue];
		j2734898135 -> j2961851108;
	j2961851108 [label="All that I have known has been swept away by glowing beams of \"Jade Light\" and \"the Orokin Empire\" and \"the Void\" and is threatened by \"the Murmur.\"",shape=box,color=blue];
		j2961851108 -> j123836827;
	j123836827 [label="So, you will have to excuse me if I find this... offer of attraction from you oddly laughable in its naïveté. I neither know you nor trust you. Indeed, all I have to go on is the word of others.",shape=box,color=blue];
		j123836827 -> j3010663279;
	j3010663279 [label="The word of others whom I also neither know nor trust as of yet.",shape=box,color=blue];
		j3010663279 -> j1075443245;
	j1075443245 [label="All this, meanwhile, is only the outward forces that are heaped up before Marie and I - let alone all the rest I contend with that you cannot see.",shape=box,color=blue];
		j1075443245 -> j1211881791;
	j1211881791 [label="I appreciate your forwardness. I know what you are attempting, and I commend you for it. And I hope, that should the time come that I... rethink your offer? That it still stands.",shape=box,color=blue];
		j1211881791 -> j106696395;
		j1211881791 -> j3834695994;
		j1211881791 -> j2436108971;
	j106696395 [label="No promises, Priest.",shape=box,color=red];
		j106696395 -> j2483209677;
	j3834695994 [label="In the words of a dear friend, \"i'm stubborn, m8.\"",shape=box,color=red];
		j3834695994 -> j230403472;
	j2436108971 [label="It will.",shape=box,color=red];
		j2436108971 -> j464818518;
	j2483209677 [label="Of course. None were expected.",shape=box,color=blue];
		j2483209677 -> j3525011136;
	j230403472 [label="Boolean LyonFlirtOffer is now true.",color=orange];
		j230403472 -> j342745273;
	j464818518 [label="Boolean LyonFlirtOffer is now true.",color=orange];
		j464818518 -> j1726508142;
	j3525011136 [label="+15 Chemistry",color=orange];
		j3525011136 -> j3444351124;
	j342745273 [label="Boolean DrifterLyon is now true.",color=orange];
		j342745273 -> j2364146676;
	j1726508142 [label="Boolean DrifterLyon is now true.",color=orange];
		j1726508142 -> j2553344595;
	j3444351124 [label="Farewell.",shape=box,color=blue];
		j3444351124 -> j944546954;
	j2364146676 [label="I... well... then...",shape=box,color=blue];
		j2364146676 -> j4022447413;
	j2553344595 [label="We shall see.",shape=box,color=blue];
		j2553344595 -> j4022447413;
