	j881787413 [label="I'm all right. I was just checking in, I heard you weren't doing well yesterday.",shape=box,color=red];
		j881787413 -> j2334873600;
	j36016330 [label="I'm fighting a bit of a megrim, personally.",shape=box,color=red];
		j36016330 -> j453963727;
	j3438847060 [label="I'm fighting a bit of a migraine, personally.",shape=box,color=red];
		j3438847060 -> j4014717271;
	j3534641122 [label="I'm fighting a bit of a headache, personally.",shape=box,color=red];
		j3534641122 -> j2779131633;
	j2603074604 [label="I just know from personal experience that sometimes the moments we don't want to accept help from others are the precise moments we need that help the most.",shape=box,color=red];
		j2603074604 -> j1770395038;
	j1147541505 [label="I respect that. I won't pry if you don't want to talk. But I am here to listen if you do.",shape=box,color=red];
		j1147541505 -> j1770395038;
	j2849513076 [label="She seemed to imply that you had theories as to why you get these headaches?",shape=box,color=red];
		j2849513076 -> j2848015776;
	j833167146 [label="Marie thinks you're trying to carry the burden of all of this alone. I wanted you to know I'm here.",shape=box,color=red];
		j833167146 -> j3392247813;
	j2440472782 [label="Marie believes you are needlessly suffering through this whole situation. I was wondering if I could help.",shape=box,color=red];
		j2440472782 -> j3392247813;
	j2334873600 [label="Ah. I see. I am feeling much recovered today, thank you for asking. Though I do not know as I enjoy overmuch that Marie has told you about my ailment.",shape=box,color=blue];
		j2334873600 -> j2792368720;
		j2334873600 -> j2674057495;
		j2334873600 -> j1731666081;
	j453963727 [label="Boolean LyonSuspicious is now true.",color=orange];
		j453963727 -> j3712321688;
	j4014717271 [label="I imagine that is this era's word for the severe headaches I suffer from as well. I cannot imagine staring at the glow of this contraption helps it. You should go and lie down.",shape=box,color=blue];
		j4014717271 -> j1021871235;
		j4014717271 -> j654160993;
		j4014717271 -> j1564508172;
	j2779131633 [label="I suffer from those as well. I cannot imagine staring at the glow of this contraption helps it. You should go and lie down.",shape=box,color=blue];
		j2779131633 -> j1021871235;
		j2779131633 -> j654160993;
		j2779131633 -> j1564508172;
	j1770395038 [label="I'm not saying this moment is that time. But if that time comes? I'm here.",shape=box,color=red];
		j1770395038 -> j1783234264;
	j2848015776 [label="And such theories are, unfortunately, now cast quite firmly into \"the Void.\"",shape=box,color=blue];
		j2848015776 -> j1615026186;
		j2848015776 -> j3462529857;
	j3392247813 [label="You will have to pardon me, Drifter, when I say this:",shape=box,color=blue];
		j3392247813 -> j685274882;
	j3712321688 [label="Hm. I suffer from those as well. I cannot imagine staring at the glow of this contraption helps it. You should go and lie down.",shape=box,color=blue];
		j3712321688 -> j1021871235;
		j3712321688 -> j654160993;
		j3712321688 -> j1564508172;
	j1021871235 [label="You're right. I'll go. I just wanted to see how you were, first.",shape=box,color=red];
		j1021871235 -> j1039518374;
	j654160993 [label="You caught me. I'm just not sure how else to... connect with you.",shape=box,color=red];
		j654160993 -> j2351002581;
	j1564508172 [label="I'll be all right for a little longer. How long have you suffered from these kinds of headaches?",shape=box,color=red];
		j1564508172 -> j635101644;
	j1783234264 [label="Boolean LyonOffer is now true.",color=orange];
		j1783234264 -> j3392247813;
	j1615026186 [label="Oh?",shape=box,color=red];
		j1615026186 -> j3574250789;
	j3462529857 [label="What is that supposed to mean?",shape=box,color=red];
		j3462529857 -> j3574250789;
	j685274882 [label="I am surrounded now by strangers and talking beasts in a world of fantastical madness and seemingly endless and rampant slaughter.",shape=box,color=blue];
		j685274882 -> j2173627064;
	j1039518374 [label="+20 Chemistry",color=orange];
		j1039518374 -> j2402938145;
	j2351002581 [label="I appreciate your willingness to admit to a lie so readily. And I appreciate the fact that I am not... the most affable creature with which you engage.",shape=box,color=blue];
		j2351002581 -> j636951470;
	j635101644 [label="It is a personal matter, Drifter. I appreciate your attempt at conversing with me. And I appreciate the fact that I am not... the most affable creature with which you engage.",shape=box,color=blue];
		j635101644 -> j636951470;
	j3574250789 [label="Boolean LyonFaithHeadache is now true.",color=orange];
		j3574250789 -> j3392247813;
	j2173627064 [label="All that I have known has been swept away by glowing beams of \"Jade Light\" and \"the Orokin Empire\" and \"the Void\" and is threatened by \"the Murmur.\"",shape=box,color=blue];
		j2173627064 -> j1777016605;
	j2402938145 [label="As you can \"see,\" I am quite recovered. And now you must worry about yourself. Now go find a dark place to recover.",shape=box,color=blue];
		j2402938145 -> j4182863348;
	j636951470 [label="May I be blunt and ask as to why you are attempting to socialize with me at all?",shape=box,color=blue];
		j636951470 -> j3382300933;
		j636951470 -> j3730667147;
		j636951470 -> j615378872;
		j636951470 -> j2603074604;
	j1777016605 [label="So, you will have to excuse me if I find this... offer of kinship from you oddly laughable in its naïveté. I neither know you nor trust you. Indeed, all I have to go on is the word of others.",shape=box,color=blue];
		j1777016605 -> j3094951870;
	j4182863348 [label="Begone, Drifter. Before I find you and force you to rest. And none of us will enjoy that.",shape=box,color=blue];
		j4182863348 -> j1471916950;
		j4182863348 -> j723989379;
	j3382300933 [label="If we're being blunt, I honestly cannot stop thinking about you ever since we met.",shape=box,color=red];
		j3382300933 -> j2905931503;
	j3730667147 [label="Entrati turned you into protoframes and now you're here, no preparation, nothing. If I can help you adapt in any way, I want to.",shape=box,color=red];
		j3730667147 -> j3392247813;
	j615378872 [label="Well...? I think you're fascinating. I want to get you know you better.",shape=box,color=red];
		j615378872 -> j3392247813;
	j3094951870 [label="The word of others whom I also neither know nor trust as of yet. All of this is heaped upon us, never mind the burdens you cannot see.",shape=box,color=blue];
		j3094951870 -> j3769213830;
	j1471916950 [label="Okay, okay. I'll go.",shape=box,color=red];
		j1471916950 -> j3475929252;
	j723989379 [label="Well... I might enjoy that more than you think.",shape=box,color=red];
		j723989379 -> j719613752;
	j2905931503 [label="+20 Chemistry",color=orange];
		j2905931503 -> j719613752;
	j3769213830 [label="So, I appreciate your affability and apologize for the lack of mine own. I know what you are attempting, and I commend you for it. And I hope, that should the time come that I am in need of your aid, the offer still stands.",shape=box,color=blue];
		j3769213830 -> j304515354;
		j3769213830 -> j2093401917;
		j3769213830 -> j316146038;
	j3475929252 [label="Good. Be well, Drifter.",shape=box,color=blue];
		j3475929252 -> j944546954;
