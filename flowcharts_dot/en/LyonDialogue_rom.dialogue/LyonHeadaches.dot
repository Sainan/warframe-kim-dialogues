	"Chat ends." [color=orange];
	j161582704 [label="I see, that must be this era's word for my severe headaches. Yes, I was. I am feeling much recovered today, thank you for asking. Though I do not know as I enjoy overmuch that Marie has told you about my ailment.",shape=box,color=blue];
		j161582704 -> j2792368720;
