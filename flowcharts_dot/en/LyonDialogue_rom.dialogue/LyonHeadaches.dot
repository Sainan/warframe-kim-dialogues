		j161582704 -> j1731666081;
	j2792368720 [label="Why's that?",shape=box,color=red];
		j2792368720 -> j1197278315;
	j2674057495 [label="She only said you weren't well out of concern for you.",shape=box,color=red];
		j2674057495 -> j291644954;
	j1731666081 [label="It just came up in passing. She didn't tell me to check on you.",shape=box,color=red];
		j1731666081 -> j291644954;
	j3463475852 [label="I am doing well, thank you kindly for asking. How are you?",shape=box,color=blue];
		j3463475852 -> j9112577;
	j1197278315 [label="It will likely come as no surprise to you that I prefer my business to remain private.",shape=box,color=blue];
		j1197278315 -> j3793588528;
	j291644954 [label="Of course. Marie would cure the world with all the rays of Sol if she could. But it will likely come as no surprise to you that I prefer my business to remain private.",shape=box,color=blue];
