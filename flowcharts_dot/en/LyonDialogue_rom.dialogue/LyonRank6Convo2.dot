	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j2164537549 [label="Marie is the sister of my soul, and the devil owes me a favor. I will not speak of what it is from, it is a secret I intend to take to my grave, so do not bother asking over what it was about.",shape=box,color=blue];
