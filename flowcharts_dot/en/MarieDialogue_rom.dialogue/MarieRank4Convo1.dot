		1976 -> 1970;
	1977 [label="We need him in one piece.",shape=box,color=red];
		1977 -> 1980;
	1978 [label="I don't need to be worrying about having to clean up his corpse.",shape=box,color=red];
		1978 -> 1981;
	1979 [label="If there is one thing I know of Lyon to be certain, it is that he will always be there when he is needed.",shape=box,color=blue];
		1979 -> 1982;
	1980 [label="You echo the words of the devil. Is it only callous need of capable hands that inspires you ?",shape=box,color=blue];
		1980 -> 1983;
		1980 -> 1984;
	1981 [label="Dégoûtant.",shape=box,color=blue];
		1981 -> 1985;
	1982 [label="He is the great protector, le bouclier sacré de Lua.... The shining light in the darkness of the night.",shape=box,color=blue];
		1982 -> 1986;
	1983 [label="No, I care about him a great deal. I just am worried when we need him, he won't be there.",shape=box,color=red];
		1983 -> 1979;
	1984 [label="I just need to know if I can count on him or not, or if he's already too broken.",shape=box,color=red];
		1984 -> 1987;
