	2002 [label="I fear he's... taken hold of my heart, and it breaks to know he's in pain.",shape=box,color=red];
		2002 -> 2006;
	2003 [label="The pain he feels is deeper than what he inflicts upon his flesh. What he does to himself now he can no longer fall from.",shape=box,color=blue];
		2003 -> 2007;
	2004 [label="Oh ! I did not know, I am so very, very sorry... What pathetic manner of platitudes and prayers I could offer you would feel empty i am certaine -",shape=box,color=blue];
