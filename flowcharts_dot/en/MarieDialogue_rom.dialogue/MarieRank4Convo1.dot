		1987 -> 2426;
	1988 [label="Chat ends.",color=orange];
	1989 [label="For the sky is filled with stars, and each of them whisper to him, and he, like Lua herself, would be lost among them.",shape=box,color=blue];
		1989 -> 1990;
	2426 [label="Or do you believe that time has already come and gone, and now you are above such reproach ?",shape=box,color=blue];
		2426 -> 1981;
	1990 [label="And like Lua, he goes through his phases. He becomes consumed by the Void only to shine so bright that we all may walk in darkness without fear.",shape=box,color=blue];
		1990 -> 1991;
	1991 [label="But like all blessings, it comes with a curse. Do I make any sense ? I fear I am only rambling.",shape=box,color=blue];
		1991 -> 1992;
