		1971 -> 1976;
		1971 -> 1977;
		1971 -> 1978;
	1972 [label="It's fairly obvious from looking at him... no offense. It wasn't hard to guess.",shape=box,color=red];
		1972 -> 1976;
		1972 -> 1977;
		1972 -> 1978;
	1973 [label="I might fear a butterfly would devour me whole, before I would I fear the brother of my soul.",shape=box,color=blue];
		1973 -> 1970;
	1974 [label="Chat ends.",color=orange];
	1975 [label="I should wish to stop him. To protect him from this desire of his to do himself such harm.",shape=box,color=blue];
