	2006 [label="+20 Chemistry",color=orange];
		2006 -> 2010;
	2007 [label="It clears his mind, steadies his soul. And now, as a protoframe - as partly this... Harrow, as I am partly Wisp, it will not kill him, oui ? ",shape=box,color=blue];
		2007 -> 2011;
		2007 -> 2012;
	2008 [label="- for what condoléances could someone you barely know give, that could serve as a balm to a tragédie such as that ?",shape=box,color=blue];
		2008 -> 2013;
	2009 [label="And for this, I cannot adore you more. But help form takes can be many things, non ?",shape=box,color=blue];
		2009 -> 2014;
