	1963 [label="Ah... it is an uncomfortable subject, oui ? Pardon, but I do not know quite how to speak of it, without twisting myself into a knot.",shape=box,color=blue];
		1963 -> 1967;
	1964 [label="I believe Lyon would take his own life before harming me. I have all faith, in all the gods, and devils -",shape=box,color=blue];
