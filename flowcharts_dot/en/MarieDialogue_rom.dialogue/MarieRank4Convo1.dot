		2020 -> 2026;
	2021 [label="Really? I didn't know how you'd feel about it.",shape=box,color=red];
		2021 -> 2027;
	2022 [label="I just wish I could tell if he could stand my presence or not...",shape=box,color=red];
		2022 -> 2028;
	2023 [label="Does more for him than speaking of what he should and should not do.",shape=box,color=blue];
		2023 -> 2029;
	2024 [label="Is this why you seek to ensure that Lyon does not befall the same fate ? Or is it simply the topic itself that upsets you ?",shape=box,color=blue];
		2024 -> 2030;
		2024 -> 2031;
	2025 [label="Even still, to have someone near to you feel so trapped within their context that there was only one manner of escape... ",shape=box,color=blue];
		2025 -> 2024;
	2026 [label="Does more for him than speaking of what he should and should not do.",shape=box,color=blue];
		2026 -> 2032;
		2026 -> 2033;
		2026 -> 2034;
	2027 [label="Oh, am I overjoyed. Tellement ravie ! Lyon is in such need of love - you do not know !",shape=box,color=blue];
		2027 -> 2035;
	2028 [label="Ah, like talking to a statue de marbre, non ? I know how you feel. I have oft found myself twenty minutes deep in a story only to realize he was not listening.",shape=box,color=blue];
		2028 -> 2036;
	2029 [label="You must learn to read between the lines, non ? He speaks in stories. In paraboles. If he is silent, listen to his actions.",shape=box,color=blue];
		2029 -> 2037;
	2030 [label="I... need to just avoid the topic, please. I can't. ",shape=box,color=red];
		2030 -> 2038;
	2031 [label="I need to be certain that Lyon doesn't suffer...",shape=box,color=red];
		2031 -> 2039;
	2032 [label="I'll do what I can to take your advice. I just don't know how to get through to him.",shape=box,color=red];
		2032 -> 2040;
	2033 [label="I'll do what I can, I just... I wish I could do more.",shape=box,color=red];
		2033 -> 2041;
	2034 [label="He can just be... frustrating.",shape=box,color=red];
		2034 -> 2040;
	2035 [label="Ah, but perhaps you do. He is, as you can tell, in such pain, despite appearances...",shape=box,color=blue];
		2035 -> 2042;
	2036 [label="Lost in the hallways of his mind again or paying attention to some other esprit in the room.",shape=box,color=blue];
		2036 -> 2043;
	2037 [label="Be patient with him, be kind, et je vous en supplie, do not hurt him, oui ?",shape=box,color=blue];
		2037 -> 2044;
