		2039 -> 2046;
	2040 [label="Ah, like talking to a statue de marbre, non ? I know how you feel. I have oft found myself twenty minutes deep in a story only to realize he was not listening.",shape=box,color=blue];
		2040 -> 2047;
	2041 [label="Oui, I understand. But there is sometimes little that we can do. But to be there for others when and how they wish for us to be there for them.",shape=box,color=blue];
		2041 -> 2048;
	2042 [label="Be patient with him, be kind, et je vous en supplie, do not hurt him, oui ?",shape=box,color=blue];
		2042 -> 2049;
	2043 [label="You must learn to read between the lines, non ? He speaks in stories. In paraboles. If he is silent, listen to his actions.",shape=box,color=blue];
		2043 -> 2042;
	2044 [label="I still don't think it's right.",shape=box,color=red];
		2044 -> 2050;
	2045 [label="I'll do what I can.",shape=box,color=red];
		2045 -> 2051;
	2046 [label="Of course... Can I tell you a story of someone I knew, who did the same ? Or would you rather we go our separate ways ?",shape=box,color=blue];
		2046 -> 2052;
		2046 -> 2053;
		2046 -> 2054;
	2047 [label="Lost in the hallways of his mind again or paying attention to some other esprit in the room.",shape=box,color=blue];
		2047 -> 2055;
	2048 [label="To do more would be to crush them or drive them away.",shape=box,color=blue];
		2048 -> 2056;
	2049 [label="That is all I ask. Oh, but I am so overjoyed ! I must work to make this pairing come to pass !",shape=box,color=blue];
		2049 -> 2057;
		2049 -> 2058;
		2049 -> 2059;
	2050 [label="Then speak to him of your concern. He will listen. He is no child. ",shape=box,color=blue];
		2050 -> 2060;
	2051 [label="+20 Chemistry",color=orange];
		2051 -> 2061;
	2052 [label="Let's end this here. ",shape=box,color=red];
		2052 -> 2062;
	2053 [label="Can we get back to talking about Lyon, instead?",shape=box,color=red];
		2053 -> 2063;
	2054 [label="I... think I'd like to hear about them.",shape=box,color=red];
		2054 -> 2064;
	2055 [label="You must learn to read between the lines, non ? He speaks in stories. In paraboles. If he is silent, listen to his actions.",shape=box,color=blue];
		2055 -> 2056;
	2056 [label="But you care, you wish to help him - and I am certain he knows this. Ah ! Here it is. He is like a stray dog, with a scar upon his leg. It is healed, healed wrong. So it hurts him still, and itches.",shape=box,color=blue];
		2056 -> 2065;
	2057 [label="Wait, I didn't mean for you to meddle!",shape=box,color=red];
		2057 -> 2066;
	2058 [label="Should I be concerned?",shape=box,color=red];
		2058 -> 2066;
	2059 [label="I could use the help.",shape=box,color=red];
		2059 -> 2067;
	2060 [label="He is like a stray dog, with a scar upon his leg. It is healed, healed wrong. So it hurts him still, and itches.",shape=box,color=blue];
		2060 -> 2065;
	2061 [label="Merci. That is all I can ask. À bientôt.",shape=box,color=blue];
		2061 -> 2068;
