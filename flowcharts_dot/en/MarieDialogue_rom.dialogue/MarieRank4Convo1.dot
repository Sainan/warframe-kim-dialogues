	j1249505350 [label="[Disable all conversations about self-harm. You will not lose any chemistry points with any characters.]",shape=box,color=red];
		j1249505350 -> j202314571;
	j2127477521 [label="I don't know if I'd rather these visions of his to be real or fake, honestly.",shape=box,color=red];
		j2127477521 -> j3916594731;
	j2492285891 [label="With talk of all the terrible things he sees. The descriptions...",shape=box,color=red];
		j2492285891 -> j3916594731;
	j774112831 [label="That he might harm himself past the point of no return someday?",shape=box,color=red];
		j774112831 -> j3084900978;
	j954212333 [label="Do you ever feel unsafe in his presence? That he might harm you, without realizing it?",shape=box,color=red];
		j954212333 -> j1751384135;
	j202314571 [label="Boolean LyonPainOff is now true.",color=orange];
		j202314571 -> j3744429094;
	j3916594731 [label="+5 Chemistry",color=orange];
		j3916594731 -> j1354224235;
	j3084900978 [label="Ah... it is an uncomfortable subject, oui ? Pardon, but I do not know quite how to speak of it, without twisting myself into a knot.",shape=box,color=blue];
		j3084900978 -> j3156166748;
	j1751384135 [label="I believe Lyon would take his own life before harming me. I have all faith, in all the gods, and devils -",shape=box,color=blue];
		j1751384135 -> j695453305;
	j3744429094 [label="+20 Chemistry",color=orange];
		j3744429094 -> j852445032;
	j1354224235 [label="The nightmares that fill his mind - Lua guides him on a difficult path, oui ?",shape=box,color=blue];
		j1354224235 -> j2345696447;
	j3156166748 [label="But I will do my best. I assume you ask out of concern for him ?",shape=box,color=blue];
		j3156166748 -> j2577092450;
		j3156166748 -> j924224451;
	j695453305 [label="- that not even your Indifférence could trick him to raise a hand to me in violence.",shape=box,color=blue];
		j695453305 -> j1539029949;
	j852445032 [label="[This will route around all conversations regarding self-harm.]",shape=box,color=blue];
		j852445032 -> "Chat ends.";
	j2345696447 [label="It is a hard thing, I fear, to speak of. For I know it is something that should not be, oui ?",shape=box,color=blue];
		j2345696447 -> j921763853;
	j2577092450 [label="The Warframe that he was given the serum to is known to... well...",shape=box,color=red];
		j2577092450 -> j3987984754;
		j2577092450 -> j1861966150;
		j2577092450 -> j1322177790;
	j924224451 [label="It's fairly obvious from looking at him... no offense. It wasn't hard to guess.",shape=box,color=red];
		j924224451 -> j3987984754;
		j924224451 -> j1861966150;
		j924224451 -> j1322177790;
	j1539029949 [label="I might fear a butterfly would devour me whole, before I would I fear the brother of my soul.",shape=box,color=blue];
		j1539029949 -> j2345696447;
	j921763853 [label="I should wish to stop him. To protect him from this desire of his to do himself such harm.",shape=box,color=blue];
		j921763853 -> j3617966760;
	j3987984754 [label="I'm just concerned he might take it too far some day.",shape=box,color=red];
		j3987984754 -> j2345696447;
	j1861966150 [label="We need him in one piece.",shape=box,color=red];
		j1861966150 -> j2885424238;
	j1322177790 [label="I don't need to be worrying about having to clean up his corpse.",shape=box,color=red];
		j1322177790 -> j698283448;
	j3617966760 [label="If there is one thing I know of Lyon to be certain, it is that he will always be there when he is needed.",shape=box,color=blue];
		j3617966760 -> j271651691;
	j2885424238 [label="You echo the words of the devil. Is it only callous need of capable hands that inspires you ?",shape=box,color=blue];
		j2885424238 -> j3904998582;
		j2885424238 -> j1213995479;
	j698283448 [label="Dégoûtant.",shape=box,color=blue];
		j698283448 -> j1508231473;
	j271651691 [label="He is the great protector, le bouclier sacré de Lua.... The shining light in the darkness of the night.",shape=box,color=blue];
		j271651691 -> j3265199910;
	j3904998582 [label="No, I care about him a great deal. I just am worried when we need him, he won't be there.",shape=box,color=red];
		j3904998582 -> j3617966760;
	j1213995479 [label="I just need to know if I can count on him or not, or if he's already too broken.",shape=box,color=red];
		j1213995479 -> j224761853;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j3265199910 [label="The pain he inflicts upon himself... he does to hear his own thoughts. To feel his own body. ",shape=box,color=blue];
		j3265199910 -> j2490481427;
	j224761853 [label="I wonder who will help you, when you are laid low and are in need of a hand.",shape=box,color=blue];
		j224761853 -> j3573198734;
	j2490481427 [label="For the sky is filled with stars, and each of them whisper to him, and he, like Lua herself, would be lost among them.",shape=box,color=blue];
		j2490481427 -> j3039211523;
	j3573198734 [label="Or do you believe that time has already come and gone, and now you are above such reproach ?",shape=box,color=blue];
		j3573198734 -> j698283448;
	j3039211523 [label="And like Lua, he goes through his phases. He becomes consumed by the Void only to shine so bright that we all may walk in darkness without fear.",shape=box,color=blue];
		j3039211523 -> j1722267735;
	j1722267735 [label="But like all blessings, it comes with a curse. Do I make any sense ? I fear I am only rambling.",shape=box,color=blue];
		j1722267735 -> j440331003;
		j1722267735 -> j194541017;
		j1722267735 -> j4106518723;
		j1722267735 -> j3774537109;
		j1722267735 -> j3658639289;
	j440331003 [label="I understand completely. And I have... a bit of a confession to make. [Confess feelings for Lyon.]",shape=box,color=red];
		j440331003 -> j3720581387;
	j194541017 [label="I understand what you're saying, but I can't condone him hurting himself. He should stop.",shape=box,color=red];
		j194541017 -> j3077121718;
	j4106518723 [label="[Warning: Discussion of suicide.] I lost someone once, to that kind of self-harm. I can't... I can't condone it.",shape=box,color=red];
		j4106518723 -> j1335434454;
	j3774537109 [label="There has to be another way.",shape=box,color=red];
		j3774537109 -> j1187692219;
	j3658639289 [label="You're making perfect sense. I just... wish I could help him.",shape=box,color=red];
		j3658639289 -> j1187692219;
	j3720581387 [label="Boolean DrifterLyon is now true.",color=orange];
		j3720581387 -> j3863013961;
	j3077121718 [label="Boolean DrifterHarmStop is now true.",color=orange];
		j3077121718 -> j2937961672;
	j1335434454 [label="Boolean DrifterHarmLoss is now true.",color=orange];
		j1335434454 -> j2235973023;
	j1187692219 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j1187692219 -> j2920425814;
	j3863013961 [label="I fear he's... taken hold of my heart, and it breaks to know he's in pain.",shape=box,color=red];
		j3863013961 -> j2109742011;
	j2937961672 [label="The pain he feels is deeper than what he inflicts upon his flesh. What he does to himself now he can no longer fall from.",shape=box,color=blue];
		j2937961672 -> j75450057;
	j2235973023 [label="Oh ! I did not know, I am so very, very sorry... What pathetic manner of platitudes and prayers I could offer you would feel empty i am certaine -",shape=box,color=blue];
		j2235973023 -> j4169858727;
	j2920425814 [label="+20 Chemistry",color=orange];
		j2920425814 -> j3549974193;
	j2109742011 [label="+20 Chemistry",color=orange];
		j2109742011 -> j2270178547;
	j75450057 [label="It clears his mind, steadies his soul. And now, as a protoframe - as partly this... Harrow, as I am partly Wisp, it will not kill him, oui ? ",shape=box,color=blue];
		j75450057 -> j2700012876;
		j75450057 -> j3495345274;
	j4169858727 [label="- for what condoléances could someone you barely know give, that could serve as a balm to a tragédie such as that ?",shape=box,color=blue];
		j4169858727 -> j4163368191;
	j3549974193 [label="And for this, I cannot adore you more. But help form takes can be many things, non ?",shape=box,color=blue];
		j3549974193 -> j1066131446;
	j2270178547 [label="Oh !! I have just screamed like I have seen a mouse and startled Monsieur Loid ! Pardon !!",shape=box,color=blue];
		j2270178547 -> j3066916057;
	j2700012876 [label="No, it won't kill him. But it's still not okay.",shape=box,color=red];
		j2700012876 -> j2850845031;
	j3495345274 [label="I guess I see your point.",shape=box,color=red];
		j3495345274 -> j3483575256;
	j4163368191 [label="This soul you lost of which you speak... were they close to you ?",shape=box,color=blue];
		j4163368191 -> j4183777516;
		j4163368191 -> j352490053;
	j1066131446 [label="To help a baby bird may be to kill it. To help a candle flame may be to blow it out in your exubérance.",shape=box,color=blue];
		j1066131446 -> j2083780586;
	j3066916057 [label="Oh, but this is such wonderful news !",shape=box,color=blue];
		j3066916057 -> j2516224401;
		j3066916057 -> j2925508944;
	j2850845031 [label="I have found that being beside him when he needs me... listening to him, holding him when he weeps ?",shape=box,color=blue];
		j2850845031 -> j4162944384;
	j3483575256 [label="+10 Chemistry",color=orange];
		j3483575256 -> j2083780586;
	j4183777516 [label="Yes.",shape=box,color=red];
		j4183777516 -> j2597183280;
	j352490053 [label="Not very.",shape=box,color=red];
		j352490053 -> j3349548751;
	j2083780586 [label="I have found that being beside him when he needs me... listening to him, merely sitting beside him when he weeps ?",shape=box,color=blue];
		j2083780586 -> j3299974639;
	j2516224401 [label="Really? I didn't know how you'd feel about it.",shape=box,color=red];
		j2516224401 -> j1242140555;
	j2925508944 [label="I just wish I could tell if he could stand my presence or not...",shape=box,color=red];
		j2925508944 -> j709186702;
	j4162944384 [label="Does more for him than speaking of what he should and should not do.",shape=box,color=blue];
		j4162944384 -> j3715000454;
	j2597183280 [label="Is this why you seek to ensure that Lyon does not befall the same fate ? Or is it simply the topic itself that upsets you ?",shape=box,color=blue];
		j2597183280 -> j330412388;
		j2597183280 -> j236015647;
	j3349548751 [label="Even still, to have someone near to you feel so trapped within their context that there was only one manner of escape... ",shape=box,color=blue];
		j3349548751 -> j2597183280;
	j3299974639 [label="Does more for him than speaking of what he should and should not do.",shape=box,color=blue];
		j3299974639 -> j1994920866;
		j3299974639 -> j3016266748;
		j3299974639 -> j2056214965;
	j1242140555 [label="Oh, am I overjoyed. Tellement ravie ! Lyon is in such need of love - you do not know !",shape=box,color=blue];
		j1242140555 -> j384785145;
	j709186702 [label="Ah, like talking to a statue de marbre, non ? I know how you feel. I have oft found myself twenty minutes deep in a story only to realize he was not listening.",shape=box,color=blue];
		j709186702 -> j3338146859;
	j3715000454 [label="You must learn to read between the lines, non ? He speaks in stories. In paraboles. If he is silent, listen to his actions.",shape=box,color=blue];
		j3715000454 -> j118949634;
	j330412388 [label="I... need to just avoid the topic, please. I can't. ",shape=box,color=red];
		j330412388 -> j3236681551;
	j236015647 [label="I need to be certain that Lyon doesn't suffer...",shape=box,color=red];
		j236015647 -> j2242346858;
	j1994920866 [label="I'll do what I can to take your advice. I just don't know how to get through to him.",shape=box,color=red];
		j1994920866 -> j3043429552;
	j3016266748 [label="I'll do what I can, I just... I wish I could do more.",shape=box,color=red];
		j3016266748 -> j480505901;
	j2056214965 [label="He can just be... frustrating.",shape=box,color=red];
		j2056214965 -> j3043429552;
	j384785145 [label="Ah, but perhaps you do. He is, as you can tell, in such pain, despite appearances...",shape=box,color=blue];
		j384785145 -> j1831063408;
	j3338146859 [label="Lost in the hallways of his mind again or paying attention to some other esprit in the room.",shape=box,color=blue];
		j3338146859 -> j226983447;
	j118949634 [label="Be patient with him, be kind, et je vous en supplie, do not hurt him, oui ?",shape=box,color=blue];
		j118949634 -> j1983808150;
		j118949634 -> j179271212;
	j3236681551 [label="Boolean LyonPainOff is now true.",color=orange];
		j3236681551 -> j2324638135;
	j2242346858 [label="Boolean LyonPainResolved is now true.",color=orange];
		j2242346858 -> j2324638135;
	j3043429552 [label="Ah, like talking to a statue de marbre, non ? I know how you feel. I have oft found myself twenty minutes deep in a story only to realize he was not listening.",shape=box,color=blue];
		j3043429552 -> j136178324;
	j480505901 [label="Oui, I understand. But there is sometimes little that we can do. But to be there for others when and how they wish for us to be there for them.",shape=box,color=blue];
		j480505901 -> j3745315271;
	j1831063408 [label="Be patient with him, be kind, et je vous en supplie, do not hurt him, oui ?",shape=box,color=blue];
		j1831063408 -> j556576556;
	j226983447 [label="You must learn to read between the lines, non ? He speaks in stories. In paraboles. If he is silent, listen to his actions.",shape=box,color=blue];
		j226983447 -> j1831063408;
	j1983808150 [label="I still don't think it's right.",shape=box,color=red];
		j1983808150 -> j3103754408;
	j179271212 [label="I'll do what I can.",shape=box,color=red];
		j179271212 -> j1679144985;
	j2324638135 [label="Of course... Can I tell you a story of someone I knew, who did the same ? Or would you rather we go our separate ways ?",shape=box,color=blue];
		j2324638135 -> j2818058620;
		j2324638135 -> j468998136;
		j2324638135 -> j380763417;
	j136178324 [label="Lost in the hallways of his mind again or paying attention to some other esprit in the room.",shape=box,color=blue];
		j136178324 -> j2930703918;
	j3745315271 [label="To do more would be to crush them or drive them away.",shape=box,color=blue];
		j3745315271 -> j2784547950;
	j556576556 [label="That is all I ask. Oh, but I am so overjoyed ! I must work to make this pairing come to pass !",shape=box,color=blue];
		j556576556 -> j2691444140;
		j556576556 -> j2012327477;
		j556576556 -> j500264666;
	j3103754408 [label="Then speak to him of your concern. He will listen. He is no child. ",shape=box,color=blue];
		j3103754408 -> j409817608;
	j1679144985 [label="+20 Chemistry",color=orange];
		j1679144985 -> j3702887446;
	j2818058620 [label="Let's end this here. ",shape=box,color=red];
		j2818058620 -> j1739544052;
	j468998136 [label="Can we get back to talking about Lyon, instead?",shape=box,color=red];
		j468998136 -> j2729785325;
	j380763417 [label="I... think I'd like to hear about them.",shape=box,color=red];
		j380763417 -> j2767069790;
	j2930703918 [label="You must learn to read between the lines, non ? He speaks in stories. In paraboles. If he is silent, listen to his actions.",shape=box,color=blue];
		j2930703918 -> j2784547950;
	j2784547950 [label="But you care, you wish to help him - and I am certain he knows this. Ah ! Here it is. He is like a stray dog, with a scar upon his leg. It is healed, healed wrong. So it hurts him still, and itches.",shape=box,color=blue];
		j2784547950 -> j393734537;
	j2691444140 [label="Wait, I didn't mean for you to meddle!",shape=box,color=red];
		j2691444140 -> j2063395929;
	j2012327477 [label="Should I be concerned?",shape=box,color=red];
		j2012327477 -> j2063395929;
	j500264666 [label="I could use the help.",shape=box,color=red];
		j500264666 -> j3029107285;
	j409817608 [label="He is like a stray dog, with a scar upon his leg. It is healed, healed wrong. So it hurts him still, and itches.",shape=box,color=blue];
		j409817608 -> j393734537;
	j3702887446 [label="Merci. That is all I can ask. À bientôt.",shape=box,color=blue];
		j3702887446 -> "Chat ends.";
	j1739544052 [label="+20 Chemistry",color=orange];
		j1739544052 -> j2712603609;
	j2729785325 [label="+20 Chemistry",color=orange];
		j2729785325 -> j1213470243;
	j2767069790 [label="Check boolean MarieBackstory1",color=orange];
		j2767069790 -> j2160104456 [label=true,color=green];
		j2767069790 -> j158122243 [label=false,color=brown];
	j393734537 [label="He chews upon the leg, and though it opens the wound and brings him pain, it also brings him relief.",shape=box,color=blue];
		j393734537 -> j3467889267;
	j2063395929 [label="Hah ! It is too late for that now. Marie, au travail ! Il y a de l'amour dans l'air !",shape=box,color=blue];
		j2063395929 -> "Chat ends.";
	j3029107285 [label="Oui ! And you could not stop me, even if you wished. Marie, to work !",shape=box,color=blue];
		j3029107285 -> "Chat ends.";
	j2712603609 [label="Oui, of course. À bientôt.",shape=box,color=blue];
		j2712603609 -> "Chat ends.";
	j1213470243 [label="Oui, of course.",shape=box,color=blue];
		j1213470243 -> j409817608;
	j2160104456 [label="You know how my story begins, but there is a portion I did not tell you.",shape=box,color=blue];
		j2160104456 -> j3215365687;
	j158122243 [label="Boolean MarieBackstory1 is now true.",color=orange];
		j158122243 -> j146780544;
	j3467889267 [label="It harms him, but it is part of him, all the same. And if you approach him avec colère, if you are harsh, he will flinch from your touch.",shape=box,color=blue];
		j3467889267 -> j876309799;
	j3215365687 [label="I told you that I was a beggar upon the streets, when I was a jeune fille. And that I did well for myself and that I had many friends.",shape=box,color=blue];
		j3215365687 -> j1748436498;
	j146780544 [label="I was born into a rich famille, which might surprise you. The bourgeois class, who are closer to the Orokin than not.",shape=box,color=blue];
		j146780544 -> j1886506651;
	j876309799 [label="You must earn the trust of the stray. Let him come to you, non ? Does this make sense ?",shape=box,color=blue];
		j876309799 -> j3453866154;
		j876309799 -> j300697660;
		j876309799 -> j2066845263;
	j1748436498 [label="One of them was a big older boy named Hugo.",shape=box,color=blue];
		j1748436498 -> j70446094;
	j1886506651 [label="But when I was born as I was... deformed, with mes pieds tordus et inutilisables ? Oh, ma mère could not have that.",shape=box,color=blue];
		j1886506651 -> j3011236423;
	j3453866154 [label="Yes, actually. Thank you.",shape=box,color=red];
		j3453866154 -> j1936013595;
	j300697660 [label="More than it should, thank you.",shape=box,color=red];
		j300697660 -> j309157818;
	j2066845263 [label="None. But thanks for trying.",shape=box,color=red];
		j2066845263 -> j3920185405;
	j70446094 [label="He was a bit of the leader of the pack. And he always made sure no one picked on me and I had all I needed.",shape=box,color=blue];
		j70446094 -> j755093854;
	j3011236423 [label="There were appearances to be maintained, oui ? Standards to be kept.",shape=box,color=blue];
		j3011236423 -> j860129427;
	j1936013595 [label="Bien ! I was afraid I let my metaphors get away from me again.",shape=box,color=blue];
		j1936013595 -> j4141824820;
	j309157818 [label="Marie and her metaphors. Ah, bon.",shape=box,color=blue];
		j309157818 -> j4141824820;
	j3920185405 [label="Mince alors. I knew I let my métaphores get away from me again.",shape=box,color=blue];
		j3920185405 -> j4141824820;
	j755093854 [label="He even helped me build des béquilles - you might call them... eh... crutches ? That I could use to drag myself about, with bits of wood we scavenged.",shape=box,color=blue];
		j755093854 -> j444454361;
	j860129427 [label="So, what was to be done, with poor malformed Marie ? I was brought to la Cité de la Lumière, where certainly I would parish upon the streets...",shape=box,color=blue];
		j860129427 -> j3249245483;
	j4141824820 [label="Hm. It occurs to me that perhaps describing Lyon as a stray dog is not the most flattering comparison to make...",shape=box,color=blue];
		j4141824820 -> j4071503027;
	j444454361 [label="One morning, we went to go wake him, and we found him -",shape=box,color=blue];
		j444454361 -> j2467433727;
	j3249245483 [label="And abandoned to die.",shape=box,color=blue];
		j3249245483 -> j449803405;
		j3249245483 -> j3244835412;
	j4071503027 [label="Perhaps do not tell him I did so, oui...?",shape=box,color=blue];
		j4071503027 -> j1672678032;
	j2467433727 [label="Je... I will spare you the details... I am certain you can guess.",shape=box,color=blue];
		j2467433727 -> j332158405;
	j449803405 [label="How old were you?",shape=box,color=red];
		j449803405 -> j3605099945;
	j3244835412 [label="Your family left you for dead?",shape=box,color=red];
		j3244835412 -> j304469797;
	j1672678032 [label="Boolean LyonStrayDog is now true.",color=orange];
		j1672678032 -> j2406238482;
		j1672678032 -> j1764251822;
	j332158405 [label="But he left us a note. It was barely legible. He was the only one of the other children who knew his letters, and I had to read it to the others. ",shape=box,color=blue];
		j332158405 -> j2680976435;
	j3605099945 [label="Six ? Seven ? In their eyes, they had tried their best to mend me for many years. Tutors to teach me to walk. Braces. Footwear.",shape=box,color=blue];
		j3605099945 -> j2024578280;
	j304469797 [label="In their eyes, they had tried their best to mend me for many years. Tutors to teach me to walk. Braces. Footwear.",shape=box,color=blue];
		j304469797 -> j2024578280;
	j2406238482 [label="I think it's adorable, and so will he.",shape=box,color=red];
		j2406238482 -> j758510050;
	j1764251822 [label="Your secret is safe with me.",shape=box,color=red];
		j1764251822 -> j2176802145;
	j2680976435 [label="I remember still how my voice choked. But I had to stay strong. Because even then, I knew that I had a duty to the others. ",shape=box,color=blue];
		j2680976435 -> j1429181606;
	j2024578280 [label="They were tired of the burden. So, barely able to even read and write my numbers and letters, I found myself in the muck.",shape=box,color=blue];
		j2024578280 -> j513960459;
		j2024578280 -> j2304556691;
	j758510050 [label="Quelle horrible personne ! J'espère que votre chaise va s'effondrer et vous donner plein d'échardes douloureuses !",shape=box,color=blue];
		j758510050 -> "Chat ends.";
	j2176802145 [label="Merci ! What a relief...",shape=box,color=blue];
		j2176802145 -> "Chat ends.";
	j1429181606 [label="Hugo had always seemed so happy to us, they said to me. Si joyeux. Always meeting life with a laugh and a sneer.",shape=box,color=blue];
		j1429181606 -> j1331965247;
	j513960459 [label="That's horrible.",shape=box,color=red];
		j513960459 -> j714426695;
	j2304556691 [label="How did you survive?",shape=box,color=red];
		j2304556691 -> j714426695;
	j1331965247 [label="Even when we were chased away or he was beaten with a stick for theft or loitering, it did not seem to bother him.",shape=box,color=blue];
		j1331965247 -> j2319753297;
	j714426695 [label="Check boolean MarieSecretPower",color=orange];
		j714426695 -> j1081268672 [label=true,color=green];
		j714426695 -> j591496065 [label=false,color=brown];
	j2319753297 [label="But we never know the depth of the pain others feel in their hearts. And in that letter, I knew he wept with Lua.",shape=box,color=blue];
		j2319753297 -> j3979586789;
	j1081268672 [label="It was like you said, non ? All inconveniences come with a secret power.",shape=box,color=blue];
		j1081268672 -> j591496065;
	j591496065 [label="What made me indésirable pour ma mère, made me quite popular amongst the other children of the streets.",shape=box,color=blue];
		j591496065 -> j1401401528;
	j3979586789 [label="But that he was now at peace at her side. For a time, I resented him for leaving. For the others looked to me for guidance. And I resented him for abandoning me.",shape=box,color=blue];
		j3979586789 -> j1488469813;
	j1401401528 [label="What is more pathétique than a child with no pieds, oui ? I could earn more in a day with open palms than they could rob in a week.",shape=box,color=blue];
		j1401401528 -> j2967129488;
	j1488469813 [label="But over time, I came to understand the truth of it.",shape=box,color=blue];
		j1488469813 -> j2805502834;
	j2967129488 [label="And I was always wont to share. So I had many friends who would look out for me, take care of me. One of them was a big older boy named Hugo.",shape=box,color=blue];
		j2967129488 -> j70446094;
	j2805502834 [label="We can only forgive ourselves for being human. And forgive ourselves the pain of their leaving.",shape=box,color=blue];
		j2805502834 -> j1312292554;
	j1312292554 [label="For it is their absence that hurts us. And the thought that we could not do more to aid them.",shape=box,color=blue];
		j1312292554 -> j4249515968;
	j4249515968 [label="The burdens that others carry are never ours to know.",shape=box,color=blue];
		j4249515968 -> j3218773287;
	j3218773287 [label="And that is a great tragédie. But it is what it means to be human.",shape=box,color=blue];
		j3218773287 -> j1775613711;
	j1775613711 [label="I do not know if this story aided you. But I can only pray that it did. I must go, Monsieur Loid is calling.",shape=box,color=blue];
		j1775613711 -> j1849472471;
		j1775613711 -> j1316993605;
	j1849472471 [label="Thank you, Marie.",shape=box,color=red];
		j1849472471 -> j2680064601;
	j1316993605 [label="[Stay silent.]",shape=box,color=red];
		j1316993605 -> j3386425480;
	j2680064601 [label="+20 Chemistry",color=orange];
		j2680064601 -> j3518898325;
	j3386425480 [label="+20 Chemistry",color=orange];
		j3386425480 -> j1123121321;
	j3518898325 [label="You are most welcome. À bientôt.",shape=box,color=blue];
		j3518898325 -> "Chat ends.";
	j1123121321 [label="À la revoyure.",shape=box,color=blue];
		j1123121321 -> "Chat ends.";
}