digraph {
	2239 [label="MarieRank4Convo3 begins.",color=orange];
		2239 -> 2240;
		2239 -> 2241;
	2240 [label="How are you today, Marie?",shape=box,color=red];
		2240 -> 2242;
	2241 [label="[End.]",shape=box,color=red];
		2241 -> 2243;
	2242 [label="I am not so grand. You may wish to come back to talk to me tomorrow. I will not be the best of company.",shape=box,color=blue];
		2242 -> 2244;
		2242 -> 2245;
		2242 -> 2246;
	2243 [label="Chat ends.",color=orange];
	2244 [label="I'll go if you want, but if you want to talk, I'm happy to listen.",shape=box,color=red];
		2244 -> 2247;
	2245 [label="All right, I understand.",shape=box,color=red];
		2245 -> 2248;
	2246 [label="May I ask what's wrong...?",shape=box,color=red];
		2246 -> 2247;
	2247 [label="C'est vraiment gentil, but it is an old problem... nothing worth troubling yourself over. I will be fine.",shape=box,color=blue];
		2247 -> 2249;
	2248 [label="Chat ends.",color=orange];
	2249 [label="Update boolean MarieChronicPain",color=orange];
		2249 -> 2250;
		2249 -> 2251;
		2249 -> 2252;
	2250 [label="If you're certain, but I'm here, if you want to talk about it.",shape=box,color=red];
		2250 -> 2253;
	2251 [label="I... know what that's like. Before I started \"looping,\" I hurt myself pretty badly in Duviri. It healed, but it still aches something awful from time to time. I try to hide my wincing when it acts up.",shape=box,color=red];
		2251 -> 2254;
	2252 [label="Old persistent problems can sometimes be as problematic as new ones. Just because they come and go, and can stay with us, doesn't mean they aren't worth talking about.",shape=box,color=red];
		2252 -> 2255;
	2253 [label="You are so very kind, and... very well. I am being little stubborn Marie again.",shape=box,color=blue];
		2253 -> 2256;
	2254 [label="Update boolean DrifterChronicPain",color=orange];
		2254 -> 2257;
	2255 [label="Oui, tu as raison. I am being little stubborn Marie again.",shape=box,color=blue];
		2255 -> 2256;
	2256 [label="It is a hard thing to explain, but I will try. Mes pieds, oui ? My feet. The sérum has changed me, given me flight -",shape=box,color=blue];
		2256 -> 2258;
	2257 [label="Par les Luminaires, I am so very sorry. You understand then, what it is like, oui ?",shape=box,color=blue];
		2257 -> 2259;
	2258 [label="But I still feel them, those twisted things that threatened to consume me, threatened to crush all hope and joie from my soul.",shape=box,color=blue];
		2258 -> 2260;
	2259 [label="To have a body that betrays you, that slows your spirit down. Even now, it is so strange. The sérum has changed me, given me flight -",shape=box,color=blue];
		2259 -> 2258;
	2260 [label="Always they hurt. Always. Even now, as I sit here, if I think of them, I feel the pain. But it is not always enough that I notice.",shape=box,color=blue];
		2260 -> 2261;
	2261 [label="Still, now, they wake me wake in the night from aching. And I wonder, Sol, pourquoi ? Why must I still feel this... agonie interminable ?",shape=box,color=blue];
		2261 -> 2262;
	2262 [label="What purpose does it serve ? Ah, but then the morning comes, and I laugh, and tell myself, \"be quiet, Marie, you are blessed. Look at all you have, all that you can do.\"",shape=box,color=blue];
		2262 -> 2263;
	2263 [label="At the Cathédrale it was \"You can read, you can write, you can eat, you can sleep. You can move about well enough. You have eyes to see and a tongue to speak. Hands with which to write. Those who care for you.\" And now, I can fly! I can protect the futur from the Void itself. From l'Indifférence !",shape=box,color=blue];
		2263 -> 2264;
	2264 [label="\"Weep now, silly girl, this constant pain will make you strong against what will come,\" I tell myself. And the day moves into another and it is not as bad when the next one comes.",shape=box,color=blue];
		2264 -> 2265;
	2265 [label="Check boolean DrifterChronicPain",color=orange];
		2265 -> 2266 [label=true,color=green];
		2265 -> 2269 [label=true,color=green];
		2265 -> 2267 [label=false,color=brown];
		2265 -> 2268 [label=false,color=brown];
	2266 [label="If there's one thing it's given us, it's a tolerance for pain, I suppose.",shape=box,color=red];
		2266 -> 2270;
	2269 [label="Sometimes, though... I wake up and I feel like it's going to be the day that I break.",shape=box,color=red];
		2269 -> 2270;
	2267 [label="It... really never stops hurting? I'm so, so sorry, Marie...",shape=box,color=red];
		2267 -> 2271;
	2268 [label="And there's no medication? No treatment?",shape=box,color=red];
		2268 -> 2272;
	2270 [label="A parishioner once asked me, \"you are in pain? Always?\" To which I replied, \"Oui, monsieur. Je le suis.\" His look of astonishment was mixed with horror.",shape=box,color=blue];
		2270 -> 2273;
	2271 [label="Sometimes, I used to sit and think of how much I could do if I were not in so much agonie, oui ? If I were not so... trapped in a cage of flesh that was so set upon hindering me at every turn.",shape=box,color=blue];
		2271 -> 2274;
	2272 [label="Would I wish there was. Mais non, there is not. Not in my time, and I fear likely not in this one.",shape=box,color=blue];
		2272 -> 2275;
	2273 [label="\"How do you go on?\" was his next question. And I remember I smiled to him and replied \"What is my other choice, Monsieur...?\"",shape=box,color=blue];
		2273 -> 2276;
		2273 -> 2277;
	2274 [label="How furious it would make me ! How jealous I would become of those whose bodies were not born a betrayal to them. But what good does it do us in the end, à part rendre nos vies plus amères ? More embittered ?",shape=box,color=blue];
		2274 -> 2278;
	2275 [label="Some ailments are beyond the cures of man, science, and faith.",shape=box,color=blue];
		2275 -> 2271;
	2276 [label="I have had that same conversation so many times...",shape=box,color=red];
		2276 -> 2271;
	2277 [label="Exactly. I'm so sorry.",shape=box,color=red];
		2277 -> 2279;
	2278 [label="Aucun. I am how I am, and I shall persevere.",shape=box,color=blue];
		2278 -> 2280;
	2279 [label="Non, I am simply sorry you have shared in such a similar agonie. ",shape=box,color=blue];
		2279 -> 2271;
	2280 [label="Check boolean DrifterChronicPain",color=orange];
		2280 -> 2281 [label=true,color=green];
		2280 -> 2282 [label=false,color=brown];
	2281 [label="And so shall you. So shall you. In this, I have faith.",shape=box,color=blue];
		2281 -> 2282;
	2282 [label="+20 Chemistry",color=orange];
		2282 -> 2283;
	2283 [label="I cannot put into words how much this conversation has meant to me. So I will simply say merci, Drifter.",shape=box,color=blue];
		2283 -> 2284;
	2284 [label="Et encore merci.",shape=box,color=blue];
		2284 -> 2285;
	2285 [label="Chat ends.",color=orange];
}