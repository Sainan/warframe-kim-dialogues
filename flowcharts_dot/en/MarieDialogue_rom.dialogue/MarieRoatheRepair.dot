		3818 -> 3823;
		3818 -> 3824;
	3819 [label="I am being hounded by the devil. He annoys me to no end with those little fiends of his ! All in the your name ! He says you wish to discuss my commitment to le Cardinal once more ?",shape=box,color=blue];
		3819 -> 3825;
		3819 -> 3826;
	3820 [label="Chat ends.",color=orange];
	3821 [label="I do.",shape=box,color=red];
		3821 -> 3827;
