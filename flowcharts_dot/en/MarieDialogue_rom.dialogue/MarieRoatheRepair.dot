		3822 -> 3828;
	3823 [label="I do.",shape=box,color=red];
		3823 -> 3829;
	3824 [label="He did?",shape=box,color=red];
		3824 -> 3828;
	3825 [label="I do.",shape=box,color=red];
		3825 -> 3830;
	3826 [label="He did?",shape=box,color=red];
		3826 -> 3828;
	3827 [label="I am so very sorry. I know I offended you. And I didn't mean to. It was the very last thing I wanted to do, trust me.",shape=box,color=red];
		3827 -> 3831;
	3828 [label="Je vais le tuer ! Je savais que ce démon était rempli de la pire merde qui soit ! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses !",shape=box,color=blue];
		3828 -> 3832;
	3829 [label="I will not linger for long, as he did much convincing already in your absence. And as the devil is wont to be, he made quite a good case for it.",shape=box,color=blue];
		3829 -> 3833;
	3830 [label="I will not linger for long, as he did much convincing already in your absence. And as the devil is wont to be, he made quite a good case for it.",shape=box,color=blue];
		3830 -> 3834;
	3831 [label="And why is that ?",shape=box,color=blue];
		3831 -> 3835;
		3831 -> 3836;
	3832 [label="Chat ends.",color=orange];
	3833 [label="And I admit I am... growing quite weary of being trapped down here with sans recours.",shape=box,color=blue];
		3833 -> 3837;
	3834 [label="But it was not his words, yet his cleverness you should thank. He sat me down with Monsieur Loid.",shape=box,color=blue];
		3834 -> 3838;
		3834 -> 3839;
	3835 [label="[Confess feelings.] Because I care about you deeply, Marie. I adore you.",shape=box,color=red];
		3835 -> 3840;
	3836 [label="Never mind. This was clearly a mistake.",shape=box,color=red];
		3836 -> 3841;
	3837 [label="So, I say, very well. I will assist you. You will have my help.",shape=box,color=blue];
		3837 -> 3842;
	3838 [label="Oh?",shape=box,color=red];
		3838 -> 3843;
	3839 [label="But Loid loves Albrecht. Doesn't he?",shape=box,color=red];
		3839 -> 3844;
	3840 [label="I knew I was going to put my foot in my mouth. And lo and behold, I did.",shape=box,color=red];
		3840 -> 3845;
	3841 [label="You are as bad as he is.",shape=box,color=blue];
		3841 -> 3846;
	3842 [label="Update boolean MarieFamilySuccess",color=orange];
		3842 -> 3847;
	3843 [label="It was Loid's clarity of sight that allowed me to see through my own clouded lens. For Loid loves le Cardinal - his Albrecht - yet he sees him for all his flaws all the same.",shape=box,color=blue];
		3843 -> 3848;
	3844 [label="Yes. He does. And yet can see him for all his flaws all the same. And it was that clarity of sight that allowed me to see through my own clouded lens.",shape=box,color=blue];
		3844 -> 3848;
	3845 [label="I am so sorry I resorted to Roathe to get your attention, but I didn't know who else to turn to.",shape=box,color=red];
		3845 -> 3849;
	3846 [label="Chat ends.",color=orange];
	3847 [label="Update boolean MarieFamilyFail",color=orange];
		3847 -> 3850;
	3848 [label="For what does it mean to love another, but to accept them for all the best and worst that they are, après tout ?",shape=box,color=blue];
		3848 -> 3851;
	3849 [label="Oh, Drifter... my poor Drifter. You did not have to go to such lengths to find my forgiveness. ",shape=box,color=blue];
		3849 -> 3852;
	3850 [label="Chat ends.",color=orange];
	3851 [label="Update boolean MarieEntratiCompleteA",color=orange];
		3851 -> 3853;
	3852 [label="I would have given it to you had you but asked. You already have a place in my heart, you know ?",shape=box,color=blue];
