		j2737891827 -> j3065315887;
	j1909125938 [label="But I fear you have already saddled yourself with the devil, non ? I will not meddle in his affairs.",shape=box,color=blue];
		j1909125938 -> j810290025;
	j3791633542 [label="But I fear you have already given your heart to the brother of my soul. I could not tear it from him.",shape=box,color=blue];
		j3791633542 -> j810290025;
	j171044204 [label="I would have given it to you had you but asked. You already have a place in my heart, you know ?",shape=box,color=blue];
		j171044204 -> j1094617544;
		j171044204 -> j742833779;
	j3065315887 [label="Boolean MarieEntratiCompleteC is now false.",color=orange];
		j3065315887 -> "Chat ends.";
