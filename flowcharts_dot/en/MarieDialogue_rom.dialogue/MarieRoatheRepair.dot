	"Chat ends." [color=orange];
	j2846144811 [label="I do.",shape=box,color=red];
		j2846144811 -> j899244716;
	j3485977538 [label="He did?",shape=box,color=red];
		j3485977538 -> j4177712951;
	j3582036748 [label="I do.",shape=box,color=red];
		j3582036748 -> j554978715;
	j1806739085 [label="I do.",shape=box,color=red];
		j1806739085 -> j2005808530;
	j899244716 [label="I am so very sorry. I know I offended you. And I didn't mean to. It was the very last thing I wanted to do, trust me.",shape=box,color=red];
		j899244716 -> j1721007164;
	j4177712951 [label="Je vais le tuer ! Je savais que ce démon était rempli de la pire merde qui soit ! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses !",shape=box,color=blue];
		j4177712951 -> "Chat ends.";
	j554978715 [label="I will not linger for long, as he did much convincing already in your absence. And as the devil is wont to be, he made quite a good case for it.",shape=box,color=blue];
		j554978715 -> j3878582722;
	j2005808530 [label="I will not linger for long, as he did much convincing already in your absence. And as the devil is wont to be, he made quite a good case for it.",shape=box,color=blue];
		j2005808530 -> j225832601;
	j1721007164 [label="And why is that ?",shape=box,color=blue];
		j1721007164 -> j2756076455;
		j1721007164 -> j466286532;
	j3878582722 [label="And I admit I am... growing quite weary of being trapped down here with sans recours.",shape=box,color=blue];
		j3878582722 -> j2299112081;
	j225832601 [label="But it was not his words, yet his cleverness you should thank. He sat me down with Monsieur Loid.",shape=box,color=blue];
		j225832601 -> j3392011993;
		j225832601 -> j4030474517;
	j2756076455 [label="[Confess feelings.] Because I care about you deeply, Marie. I adore you.",shape=box,color=red];
		j2756076455 -> j399060093;
	j466286532 [label="Never mind. This was clearly a mistake.",shape=box,color=red];
		j466286532 -> j3062614312;
	j2299112081 [label="So, I say, very well. I will assist you. You will have my help.",shape=box,color=blue];
		j2299112081 -> j3151953893;
	j3392011993 [label="Oh?",shape=box,color=red];
		j3392011993 -> j3526438694;
	j4030474517 [label="But Loid loves Albrecht. Doesn't he?",shape=box,color=red];
		j4030474517 -> j2443881829;
	j399060093 [label="I knew I was going to put my foot in my mouth. And lo and behold, I did.",shape=box,color=red];
		j399060093 -> j4055844939;
	j3062614312 [label="You are as bad as he is.",shape=box,color=blue];
		j3062614312 -> "Chat ends.";
	j3151953893 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3151953893 -> j2529015854;
	j3526438694 [label="It was Loid's clarity of sight that allowed me to see through my own clouded lens. For Loid loves le Cardinal - his Albrecht - yet he sees him for all his flaws all the same.",shape=box,color=blue];
		j3526438694 -> j3671121223;
	j2443881829 [label="Yes. He does. And yet can see him for all his flaws all the same. And it was that clarity of sight that allowed me to see through my own clouded lens.",shape=box,color=blue];
		j2443881829 -> j3671121223;
	j4055844939 [label="I am so sorry I resorted to Roathe to get your attention, but I didn't know who else to turn to.",shape=box,color=red];
		j4055844939 -> j2372730330;
	j2529015854 [label="Boolean MarieFamilyFail is now false.",color=orange];
		j2529015854 -> "Chat ends.";
	j3671121223 [label="For what does it mean to love another, but to accept them for all the best and worst that they are, après tout ?",shape=box,color=blue];
		j3671121223 -> j3722403271;
	j2372730330 [label="Oh, Drifter... my poor Drifter. You did not have to go to such lengths to find my forgiveness. ",shape=box,color=blue];
		j2372730330 -> j171044204;
	j3722403271 [label="Boolean MarieEntratiCompleteA is now true.",color=orange];
		j3722403271 -> j2737891827;
	j171044204 [label="I would have given it to you had you but asked. You already have a place in my heart, you know ?",shape=box,color=blue];
		j171044204 -> j1094617544;
		j171044204 -> j1339251059;
	j2737891827 [label="Boolean MarieEntratiCompleteB is now false.",color=orange];
