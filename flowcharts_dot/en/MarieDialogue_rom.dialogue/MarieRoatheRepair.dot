		3816 -> 3820 [label="false",color=purple];
	3817 [label="Drifter. I am being hounded by the devil. He annoys me to no end with those little fiends of his ! All in the your name ! He says you simply wish to apologize on bent knee.",shape=box,color=blue];
		3817 -> 3821;
		3817 -> 3822;
