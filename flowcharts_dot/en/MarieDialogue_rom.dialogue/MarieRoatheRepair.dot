		j1339251059 -> j378739374;
	j3065315887 [label="Boolean MarieEntratiCompleteC is now false.",color=orange];
		j3065315887 -> "Chat ends.";
	j3850517521 [label="Oui ! And if you wish to be together with me, than I would like this as well.",shape=box,color=blue];
		j3850517521 -> j38581217;
		j3850517521 -> j3143488399;
	j378739374 [label="And that is your own fault, not mine ! But if you wish to be together with me, than I would like this as well.",shape=box,color=blue];
		j378739374 -> j3143488399;
		j378739374 -> j38581217;
