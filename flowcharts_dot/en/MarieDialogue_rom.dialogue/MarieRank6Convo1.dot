		j1466675438 -> j1751544323;
	j142765746 [label="It is impure and it is imperfect but it is beautiful like the stars in the sky. A billion little dots that make a tapestry of an ocean of light.",shape=box,color=blue];
		j142765746 -> j178875210;
	j3115782295 [label="What you feel for me, I do not feel for you in return. Forgive me.",shape=box,color=blue];
		j3115782295 -> j1390605233;
	j2277077907 [label="Mon cœur t'appartient depuis notre première rencontre.",shape=box,color=blue];
		j2277077907 -> j1860593742;
	j1554471042 [label="Ah ! Where did you learn that ?! Lyon ?! Oh, never mind! Oh, my wolf !",shape=box,color=blue];
		j1554471042 -> j1860593742;
	j1056336650 [label="It is all detail with no précision, oui ? Who cares where it comes from... it is what we are.",shape=box,color=blue];
		j1056336650 -> j1675674579;
	j608763074 [label="But I think of how much they have meant to me. How much they have changed me and the course of my life like a ship at sea.",shape=box,color=blue];
		j608763074 -> j1044742900;
	j2066378881 [label="And I think to myself, is this what the Indifference wishes to destroy ? Is this what the Indifference consumes ? That power of others to influence others ?",shape=box,color=blue];
		j2066378881 -> j190637674;
	j3133120273 [label="I simply pray that you do not lead Lyon astray or hurt him needlessly. He is a delicate thing, beneath that exterior of stone.",shape=box,color=blue];
		j3133120273 -> j2402114618;
	j2722672382 [label="I do not wish Roathe suffering, for all that I needle him and lecture him. Do not cause him pain, if you can help it.",shape=box,color=blue];
		j2722672382 -> j2402114618;
	j600519549 [label="I could be at peace, even rejoice, at the notion of sharing you with another - but with family or an enemy ? I think that is too much for me.",shape=box,color=blue];
		j600519549 -> j1801109923;
		j600519549 -> j4143964152;
	j1646887348 [label="And in little Marie, trust that you have a friend who shall stand beside you until the end, come what may.",shape=box,color=blue];
		j1646887348 -> "Chat ends.";
