	j3839992462 [label="Anytime. What is it?",shape=box,color=red];
		j3839992462 -> j1308228283;
	j3360149608 [label="Heh. I'm not sure he's tame. What is it?",shape=box,color=red];
		j3360149608 -> j1663042159;
	j3108803273 [label="For you, always. What is it?",shape=box,color=red];
		j3108803273 -> j1864957210;
	j1521206189 [label="Of course, what is it?",shape=box,color=red];
		j1521206189 -> j4251347889;
	j2191831082 [label="[Confess feelings.] This is good timing, I have something I'd like to say, too... ",shape=box,color=red];
		j2191831082 -> j3198593893;
	j3611286153 [label="I think of how much time we have spent together. How little it has been, in the grand scheme of all of the years you have lived.",shape=box,color=blue];
		j3611286153 -> j3238130930;
	"Chat ends." [color=orange];
	j1308228283 [label="You have been such a good and kind friend. And ally the likes of which I could not even have possibly prayed for. ",shape=box,color=blue];
		j1308228283 -> j3352154434;
	j1663042159 [label="Oui, and I think you prefer it that way, non ? Ha ! I do not wish to picture the devil in that way - never mind ! That is not why I have come to speak.",shape=box,color=blue];
		j1663042159 -> j3470333215;
	j1864957210 [label="Evaluate expressions",color=orange];
		j1864957210 -> j3432777345 [label="RoatheDating",color=purple];
		j1864957210 -> j3432777345 [label="LyonDating",color=purple];
		j1864957210 -> j3424262336 [label="IsDating",color=purple];
		j1864957210 -> j1855736320 [label="false",color=purple];
	j4251347889 [label="I think of how much time we have spent together. How little it has been, in the grand scheme of all of the years you have lived.",shape=box,color=blue];
		j4251347889 -> j918524460;
	j3198593893 [label="Non, let me speak first, I will lose my nerve if I do not !",shape=box,color=blue];
		j3198593893 -> j1471879296;
	j3238130930 [label="But I think of how much they have meant to me. How much they have changed me and the course of my life like a ship at sea.",shape=box,color=blue];
		j3238130930 -> j3734258465;
	j3352154434 [label="Evaluate expressions",color=orange];
		j3352154434 -> j1439060373 [label="LyonFaith3Yes",color=purple];
		j3352154434 -> j519398679 [label="LyonFaith3No",color=purple];
		j3352154434 -> j1494174744 [label="LyonFaith3Maybe",color=purple];
		j3352154434 -> j1494174744 [label="false",color=purple];
	j3470333215 [label="Evaluate expressions",color=orange];
		j3470333215 -> j374756553 [label="LoidFamilyComplete",color=purple];
		j3470333215 -> j1469550377 [label="RoatheRedeemed",color=purple];
		j3470333215 -> j1528259343 [label="RoatheVillain",color=purple];
		j3470333215 -> j2113171834 [label="RoatheHellComplete",color=purple];
		j3470333215 -> j2323501481 [label="false",color=purple];
	j3432777345 [label="I know you spoke once of having feelings for me. Yet, now I see you off with another. I simply wished to tell you that I am happy for you !",shape=box,color=blue];
		j3432777345 -> j1636164836;
	j3424262336 [label="You spoke to me once that you... oh, I do not even know how to say the words. That you had feelings for me. Yet I know you also have another.",shape=box,color=blue];
		j3424262336 -> j3788786992;
		j3424262336 -> j3074758232;
	j1855736320 [label="You spoke to me once that you... oh, I do not even know how to say the words. That you had feelings for me.",shape=box,color=blue];
		j1855736320 -> j1928846357;
	j918524460 [label="But I think of how much they have meant to me. How much they have changed me and the course of my life like a ship at sea.",shape=box,color=blue];
		j918524460 -> j3729778003;
	j1471879296 [label="Evaluate expressions",color=orange];
		j1471879296 -> j507387028 [label="MarieNoDate",color=purple];
		j1471879296 -> j2314777629 [label="MarieWillDate",color=purple];
		j1471879296 -> j507387028 [label="false",color=purple];
	j3734258465 [label="And I think to myself, is this what the Indifference wishes to destroy ? Is this what the Indifference consumes ? That power of others to influence others ?",shape=box,color=blue];
		j3734258465 -> j3469850603;
	j1439060373 [label="You have brought the brother of my soul such peace. You have convinced him we have a true enemy to fight - and given him hope.",shape=box,color=blue];
		j1439060373 -> j3720503596;
	j519398679 [label="You have brought the brother of my soul solace and some manner of peace where he had none before. I think your companionship has meant more to him than he can express.",shape=box,color=blue];
		j519398679 -> j3720503596;
	j1494174744 [label="While we may never know the answer of what the Indifference truly is, we know that it does not matter. We must face it as the challenge it poses - which is real.",shape=box,color=blue];
		j1494174744 -> j3720503596;
	j374756553 [label="I did not think our devil could be convinced to help Monsieur Loid and le Cardinal's family reconnect. I know his reasons are... dubious, perhaps, and I still do not fully trust him. ",shape=box,color=blue];
		j374756553 -> j1863894681;
	j1469550377 [label="I did not think our devil could be shown the error of his ways. That he could feel regret at all for the innocent lives he has spent. You proved me wrong.",shape=box,color=blue];
		j1469550377 -> j797773932;
	j1528259343 [label="Whatever chains you keep our devil on, they are keeping him leashed. He seems more... tempered, than before. And you are to thank for this.",shape=box,color=blue];
		j1528259343 -> j797773932;
	j2113171834 [label="The memories we have helped him retrieve seem to have tempered him. Perhaps remembering the grief for all those he lost has reminded him of those he could still lose.",shape=box,color=blue];
		j2113171834 -> j797773932;
	j2323501481 [label="Perhaps it is his fondness for you that tempers him, I do not know. Whatever the reason, I know you are to thank for it.",shape=box,color=blue];
		j2323501481 -> j797773932;
	j1636164836 [label="I harbor for you no ill will and nothing but joie for you both, oui ?",shape=box,color=blue];
		j1636164836 -> j11439812;
		j1636164836 -> j1363321945;
	j3788786992 [label="Things have changed, and.. I have to stay loyal to them, I'm sorry.",shape=box,color=red];
		j3788786992 -> j945928533;
	j3074758232 [label="It may be hard to believe, or maybe even to accept, I know. But I... love you. And I love them. In equal measure.",shape=box,color=red];
		j3074758232 -> j3734127592;
	j1928846357 [label="Evaluate expressions",color=orange];
		j1928846357 -> j2178863670 [label="MarieNoDate",color=purple];
		j1928846357 -> j3414419099 [label="MarieWillDate",color=purple];
		j1928846357 -> j569177453 [label="MarieWillDate",color=purple];
		j1928846357 -> j2178863670 [label="false",color=purple];
	j3729778003 [label="And I think to myself, is this what the Indifference wishes to destroy ? Is this what the Indifference consumes ? That power of others to influence others ?",shape=box,color=blue];
		j3729778003 -> j147795983;
	j507387028 [label="I fear you are about to tell me words you will not be able to take back. And that will change things between us forever.",shape=box,color=blue];
		j507387028 -> j2299984275;
	j2314777629 [label="Mon cœur t'appartient depuis notre première rencontre...",shape=box,color=blue];
		j2314777629 -> j4072880905;
		j2314777629 -> j4076632243;
	j3469850603 [label="The gift to make each other laugh. To cry. To convince each other of truths or lies. To change each other's minds. To cheer each other when you are in pain. To hurt each other in folly.",shape=box,color=blue];
		j3469850603 -> j959825008;
	j3720503596 [label="And what is the difference, when you are there to guide Lyon through the darkest hours, and hold him in his moments of pain and agonie ?",shape=box,color=blue];
		j3720503596 -> j3508931061;
	j1863894681 [label="The results are undoubtedly because you are to thank for them. Roathe is here, and he is protecting le Cardinal's family, because of you.",shape=box,color=blue];
		j1863894681 -> j797773932;
	j797773932 [label="And I know our devil is not our enemy, oui ? It is the Indifference. And what does the Indifference teach us, if not to hold on to all that it rejects, all that it destroys ?",shape=box,color=blue];
		j797773932 -> j190400237;
	j11439812 [label="But... what if ",shape=box,color=red];
		j11439812 -> j650068158;
	j1363321945 [label="I have feelings for you too, Marie.",shape=box,color=red];
		j1363321945 -> j3382937906;
	j945928533 [label="Oui, I understand. Of course, I understand ! How could I fault you for following your soul ?",shape=box,color=blue];
		j945928533 -> j3913235429;
	j3734127592 [label="Evaluate expressions",color=orange];
		j3734127592 -> j2178863670 [label="MarieNoDate",color=purple];
		j3734127592 -> j3309224900 [label="MarieWillDate",color=purple];
		j3734127592 -> j2178863670 [label="false",color=purple];
	j2178863670 [label="I do not know how to say this without being cruel so I... will only say it simply.",shape=box,color=blue];
		j2178863670 -> j975821835;
	j3414419099 [label="I do. I... don't suppose you feel the same way?",shape=box,color=red];
		j3414419099 -> j2297928659;
	j569177453 [label="Things have changed, and... I'm sorry.",shape=box,color=red];
		j569177453 -> j1737915512;
	j147795983 [label="The gift to make each other laugh. To cry. To convince each other of truths or lies. To change each other's minds. To cheer each other when you are in pain. To hurt each other in folly.",shape=box,color=blue];
		j147795983 -> j2723668856;
	j2299984275 [label="And it grieves me, oh, how it grieves me to stop you before you do.",shape=box,color=blue];
		j2299984275 -> j2683660623;
	j4072880905 [label="I... don't know what that means, Marie.",shape=box,color=red];
		j4072880905 -> j897161278;
	j4076632243 [label="Mon cœur t'appartient également, Marie !",shape=box,color=red];
		j4076632243 -> j1424485994;
	j959825008 [label="To bring each other pleasure when you are in love. To bring each other agonie when you are lost to hatred. This is the gift of humanité - this is what the Indifference is not.",shape=box,color=blue];
		j959825008 -> j4156264944;
	j3508931061 [label="What does the Indifference teach us, regardless of its origins, if not to hold on to all that it rejects, all that it destroys ?",shape=box,color=blue];
		j3508931061 -> j2179678150;
	j190400237 [label="I think of how much time we have spent together. How little it has been, in the grand scheme of all of the years you have lived.",shape=box,color=blue];
		j190400237 -> j3341444580;
	j650068158 [label="Instead ? Then... I fear you must untangle the threads of your own heart first, Drifter. I cannot do this for you.",shape=box,color=blue];
		j650068158 -> j3699890413;
	j3382937906 [label="And that may very well be the case. I am not a jealous creature, but it is one thing to know that someone has captured your heart, when I do not know them -",shape=box,color=blue];
		j3382937906 -> j3319342357;
	j3913235429 [label="+10 Chemistry",color=orange];
		j3913235429 -> j3320555940;
	j3309224900 [label="I - oh ! Oh, mon cœur !",shape=box,color=blue];
		j3309224900 -> j3675257348;
	j975821835 [label="I fear... you should simply just pursue the other. What you feel for me, I do not feel for you in return. Forgive me.",shape=box,color=blue];
		j975821835 -> j1390605233;
	j2297928659 [label="I - oh ! Oh, mon cœur !",shape=box,color=blue];
		j2297928659 -> j141695689;
	j1737915512 [label="Oui, I understand. Of course, I understand ! How could I fault you for following your soul ?",shape=box,color=blue];
		j1737915512 -> j1466675438;
	j2723668856 [label="To bring each other pleasure when you are in love. To bring each other agonie when you are lost to hatred. This is the gift of humanité - this is what the Indifference is not.",shape=box,color=blue];
		j2723668856 -> j142765746;
	j2683660623 [label="I do not know how to say this without being cruel so I... will only say it simply.",shape=box,color=blue];
		j2683660623 -> j3115782295;
	j897161278 [label="Oui, I know ! That is the point ! I am too scared to say... to say how much I have come to care for you. ",shape=box,color=blue];
		j897161278 -> j2277077907;
	j1424485994 [label="+10 Chemistry",color=orange];
		j1424485994 -> j1554471042;
	j4156264944 [label="It is impure and it is imperfect but it is beautiful like the stars in the sky. A billion little dots that make a tapestry of an ocean of light.",shape=box,color=blue];
		j4156264944 -> j1056336650;
	j2179678150 [label="I think of how much time we have spent together. How little it has been, in the grand scheme of all of the years you have lived.",shape=box,color=blue];
		j2179678150 -> j608763074;
	j3341444580 [label="But I think of how much they have meant to me. How much they have changed me and the course of my life like a ship at sea.",shape=box,color=blue];
		j3341444580 -> j2066378881;
	j3699890413 [label="Evaluate expressions",color=orange];
		j3699890413 -> j3133120273 [label="LyonDating",color=purple];
		j3699890413 -> j2722672382 [label="RoatheDating",color=purple];
	j3319342357 [label="It is another matter when they are the brother of my soul, or the devil whom I must contend with on a daily basis.",shape=box,color=blue];
		j3319342357 -> j600519549;
	j3320555940 [label="May Sol bless you and your hearts. I merely count myself blessed to be amongst those you call friend !",shape=box,color=blue];
		j3320555940 -> j1646887348;
	j3675257348 [label="I... do not know what to say, except for that I believe you. And that I... I feel the same. Mon cœur t'appartient depuis notre première rencontre.",shape=box,color=blue];
		j3675257348 -> j1860593742;
	j1390605233 [label="But in little Marie, trust that you have an ally who shall stand beside you until the end, come what may.",shape=box,color=blue];
		j1390605233 -> "Chat ends.";
	j141695689 [label="I... do not know what to say, except for I... I feel the same. Mon cœur t'appartient depuis notre première rencontre.",shape=box,color=blue];
