		j1860593742 -> j3261083431;
	j1751544323 [label="I merely count myself blessed to be amongst those you call friend !",shape=box,color=blue];
		j1751544323 -> j1646887348;
	j178875210 [label="It is all detail with no precision, oui ? Who cares where it comes from... it is what we are.",shape=box,color=blue];
		j178875210 -> j161648134;
	j1675674579 [label="And it is all these things that you share with me, oui ?",shape=box,color=blue];
		j1675674579 -> j1505129254;
	j1044742900 [label="And I think to myself, is this what the Indifference wishes to destroy ? Is this what the Indifference consumes ? That power of others to influence others ?",shape=box,color=blue];
		j1044742900 -> j2572527923;
	j190637674 [label="The gift to make each other laugh. To cry. To convince each other of truths or lies. To change each other's minds. To cheer each other when you are in pain. To hurt each other in folly.",shape=box,color=blue];
		j190637674 -> j314934657;
	j2402114618 [label="I do not wish to cause harm to others, and I will not be the \"other woman\" in someone's pain. If you feel stronger for me at the expense of someone else ?",shape=box,color=blue];
		j2402114618 -> j1773581310;
	j1801109923 [label="I respect that.",shape=box,color=red];
		j1801109923 -> j3433005135;
	j4143964152 [label="But...",shape=box,color=red];
		j4143964152 -> j4135043593;
	j3261083431 [label="But I think of how much they have meant to me. How much they have changed me and the course of my life like a ship at sea.",shape=box,color=blue];
		j3261083431 -> j1386901126;
	j161648134 [label="And that is what I am proud to share with you, my friend, my dearest friend.",shape=box,color=blue];
		j161648134 -> j1433356046;
	j1505129254 [label="I do not know how to say this, but I feel as though I must.",shape=box,color=blue];
		j1505129254 -> j1098843197;
		j1505129254 -> j3415277530;
	j2572527923 [label="The gift to make each other laugh. To cry. To convince each other of truths or lies. To change each other's minds. To cheer each other when you are in pain. To hurt each other in folly.",shape=box,color=blue];
		j2572527923 -> j3405426288;
	j314934657 [label="To bring each other pleasure when you are in love. To bring each other agonie when you are lost to hatred. This is the gift of humanité - this is what the Indifference is not.",shape=box,color=blue];
		j314934657 -> j1597022526;
	j1773581310 [label="I recommend attending to that before speaking to me again, oui ?",shape=box,color=blue];
		j1773581310 -> "Chat ends.";
	j3433005135 [label="+20 Chemistry",color=orange];
		j3433005135 -> j1722455026;
	j4135043593 [label="I am sorry. It is simply how it must be. I expect you will find similar answers from the others.",shape=box,color=blue];
		j4135043593 -> "Chat ends.";
