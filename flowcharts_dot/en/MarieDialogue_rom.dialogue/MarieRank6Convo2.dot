		3530 -> 3534 [label="false",color=purple];
	3531 [label="Oh, Luminaries - what manner of hell have you made for him, to keep his soul trapped within that cage of science and flickering lights?",shape=box,color=blue];
		3531 -> 3535;
	3532 [label="I can only pray to the Luminaries that you are right and nothing remains inside that shell but... but science and flickering lights.",shape=box,color=blue];
		3532 -> 3536;
	3533 [label="I know you are not sure if the Cephalons contain souls - but I can only pray to the Luminaries that... that poor Otak does not suffer.",shape=box,color=blue];
		3533 -> 3537;
	3534 [label="I can only pray to the Luminaries that all that remains inside that shell is nothing but... but science and flickering lights.",shape=box,color=blue];
		3534 -> 3538;
	3535 [label="Why leave him there, broken and waiting until he is allowed to die to be given peace? I can only pray... that if there is some kind of presence there -",shape=box,color=blue];
		3535 -> 3539;
	3536 [label="And no soul is trapped within that broken thing, waiting until it is allowed to finally die to be given peace.",shape=box,color=blue];
		3536 -> 3540;
	3537 [label="That no soul is trapped within that broken thing, waiting until it is allowed to finally die to be given peace.",shape=box,color=blue];
		3537 -> 3541;
	3538 [label="And no soul is trapped within that broken thing, waiting until it is allowed to finally die to be given peace.",shape=box,color=blue];
		3538 -> 3541;
	3539 [label="It is because he remains by choice as some kind of lonely vigil...",shape=box,color=blue];
		3539 -> 3542;
	3540 [label="Because if you are wrong, and a soul remains within that cage against its will ?",shape=box,color=blue];
		3540 -> 3543;
	3541 [label="Or if there is some kind of presence there, it is because he remains by choice as some manner of lonely vigil.",shape=box,color=blue];
		3541 -> 3544;
	3542 [label="To think otherwise is enough to make one question the kindness of the gods, non ?",shape=box,color=blue];
		3542 -> 3545;
	3543 [label="It is enough to make one question the kindness of the gods, non ?",shape=box,color=blue];
		3543 -> 3545;
	3544 [label="To think otherwise is enough to make one question the kindness of the gods, non ?",shape=box,color=blue];
		3544 -> 3545;
	3545 [label="And then where would I be ?",shape=box,color=blue];
		3545 -> 3546;
