	3555 [label="+5 Chemistry",color=orange];
		3555 -> 3558;
	3556 [label="Merci. Well, I no longer wish to be. I am going to go do something more cheerful ! I think M'sieur Fibonacci's tank is due for a dusting.",shape=box,color=blue];
		3556 -> 3559;
	3557 [label="Ha ! Merci. That is sure to stop these foolish tears of mine. You do know how to cheer silly little Marie, non ?",shape=box,color=blue];
		3557 -> 3560;
		3557 -> 3561;
	3558 [label="Oui. You are quite right. They are. The world is full of no end of stories like that of Monsieur Otak, and many far worse than his. I should not weep over one. ",shape=box,color=blue];
