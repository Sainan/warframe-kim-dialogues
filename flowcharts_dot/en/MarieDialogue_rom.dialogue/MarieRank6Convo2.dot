		j3979133402 -> j3291069167 [label=true,color=green];
		j3979133402 -> j3770395357 [label=false,color=brown];
	j567000639 [label="Wolf ! My wolf ! I have met Otak ! I have finally met him !",shape=box,color=blue];
		j567000639 -> j299353507;
		j567000639 -> j4168905161;
	j2515421598 [label="I have met Otak ! I have finally met him !",shape=box,color=blue];
		j2515421598 -> j299353507;
		j2515421598 -> j4168905161;
	j3291069167 [label="Wolf ! My wolf ! The face upon the back of Monsieur Necraloid ! I have finally met him !",shape=box,color=blue];
		j3291069167 -> j996109282;
		j3291069167 -> j368335472;
		j3291069167 -> j2812741725;
	j3770395357 [label="The face upon the back of Monsieur Necraloid ! I have finally met him !",shape=box,color=blue];
		j3770395357 -> j996109282;
		j3770395357 -> j368335472;
		j3770395357 -> j2812741725;
	j299353507 [label="Did you enjoy talking to him?",shape=box,color=red];
		j299353507 -> j2058614867;
	j4168905161 [label="How did your conversation with him go?",shape=box,color=red];
		j4168905161 -> j2269472257;
	j996109282 [label="Poor Otak... How did that go?",shape=box,color=red];
		j996109282 -> j2779764308;
	j368335472 [label="I'm glad you finally met. Otak can be a little hard to explain.",shape=box,color=red];
		j368335472 -> j1162357111;
	j2812741725 [label="You met Otak? Oh boy... How did that go?",shape=box,color=red];
		j2812741725 -> j416096382;
	j2058614867 [label="I did. Though perhaps I wanted to weep for it. For he introduced himself to me thrice over in the same conversation, as though we had never been introduced.",shape=box,color=blue];
		j2058614867 -> j3692347425;
	j2269472257 [label="He... introduced himself to me thrice over in the same conversation, as though we had never been introduced.",shape=box,color=blue];
		j2269472257 -> j3692347425;
	j2779764308 [label="I found him nothing but sweet and charming ! But buried beneath a layer of humor, I felt great heartbreak.",shape=box,color=blue];
		j2779764308 -> j365443425;
	j1162357111 [label="Yes, I would think so. A child's scrawl written on the back of an automaton. I found him nothing but sweet and charming !",shape=box,color=blue];
		j1162357111 -> j1692380781;
	j416096382 [label="Why do you sound less than pleased that I met him ?",shape=box,color=blue];
		j416096382 -> j3483034551;
		j416096382 -> j2133512838;
		j416096382 -> j875037826;
	j3692347425 [label="Greeting me in the same unflinching, cheerful way he had the previous times. But he knew me as a Sœur de Sol ! ",shape=box,color=blue];
		j3692347425 -> j3245955995;
	j365443425 [label="Will you tell me the story of poor Monsieur Otak ?",shape=box,color=blue];
		j365443425 -> j3866781641;
	j1692380781 [label="But buried beneath the humor, there is great heartbreak.",shape=box,color=blue];
		j1692380781 -> j365443425;
	j3483034551 [label="He can get on my nerves sometimes, is all. ",shape=box,color=red];
		j3483034551 -> j1164274748;
	j2133512838 [label="I didn't mean to. He can just be a little... off putting for some people.",shape=box,color=red];
		j2133512838 -> j3348811234;
	j875037826 [label="I'm sorry. He can get on people's nerves sometimes. It's not his fault.",shape=box,color=red];
		j875037826 -> j3348811234;
	j3245955995 [label="Indeed, he knew much of the Luminaries ! We talked at length of the \"Ancient Religions\" as he dubbed them, in the \"days before the Orokin Empire.\"",shape=box,color=blue];
		j3245955995 -> j4027407019;
	j3866781641 [label="Otak used to be an Archimedean, an Orokin scientist and academic. What's happened to him isn't exactly the happiest story.",shape=box,color=red];
		j3866781641 -> j1309851147;
	j1164274748 [label="I would hope you would seek to be more kind with someone who is clearly infirme. Mais par la grâce de Sol, go we all.",shape=box,color=blue];
		j1164274748 -> j2319528050;
	j3348811234 [label="And I would hope they would show him kindness and patience. Mais par la grâce de Sol, go we all.",shape=box,color=blue];
		j3348811234 -> j2319528050;
	j4027407019 [label="Though he said much of that knowledge was lost now, deep in the archives, and very much forbidden. He swore me to secrecy.",shape=box,color=blue];
		j4027407019 -> j2746595683;
	j1309851147 [label="By all accounts he was a genius, and the mind behind the harnessing of argon crystals.",shape=box,color=red];
		j1309851147 -> j4038635587;
	j2319528050 [label="Such a fate could wait for any of us. Even you.",shape=box,color=blue];
		j2319528050 -> j3865142603;
		j2319528050 -> j3819554275;
	j2746595683 [label="He told me that he was deeply concerned that Executor Ballas - whoever he may be - might discover my sect of heretics and have me executed.",shape=box,color=blue];
		j2746595683 -> j1349458355;
		j2746595683 -> j261421504;
	j4038635587 [label="Which are harnessed from the Void - they're the reason we can create a lot of the powerful Warframes and weapons we make.",shape=box,color=red];
		j4038635587 -> j3205786289;
	j3865142603 [label="You're right, I'm sorry. I didn't mean that.",shape=box,color=red];
		j3865142603 -> j365443425;
	j3819554275 [label="I just don't have the time to spend on him, I'm sorry.",shape=box,color=red];
		j3819554275 -> j837231574;
	j1349458355 [label="Ballas is dead... keep going.",shape=box,color=red];
		j1349458355 -> j1046433486;
	j261421504 [label="That... won't happen. Keep talking.",shape=box,color=red];
		j261421504 -> j1046433486;
	j3205786289 [label="He specialized in crystallography. And his works were archived here, in the laboratories.",shape=box,color=red];
		j3205786289 -> j3686466455;
	j837231574 [label="Then I am sorry for wasting more of it.",shape=box,color=blue];
		j837231574 -> j3007723528;
	j1046433486 [label="+5 Chemistry",color=orange];
		j1046433486 -> j4074666668;
	j3686466455 [label="For some reason, I don't know why, he was turned into a Cephalon, and given his own necraloid shell.",shape=box,color=red];
		j3686466455 -> j3887599870;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j4074666668 [label="I suspected... Well, he asked me where I was from, and when I told him, he laughed and said \"no, that's impossible! And I should know, I'm -\"",shape=box,color=blue];
		j4074666668 -> j3432167038;
	j3887599870 [label="Not all Cephalons were made as a punishment. But things went... poorly here on Deimos, and he was badly damaged.",shape=box,color=red];
		j3887599870 -> j2105349457;
	j3432167038 [label="And then he... introduced himself to me again. And asked me if I was coming from the plains with mineral samples...",shape=box,color=blue];
		j3432167038 -> j1536610458;
		j3432167038 -> j838527418;
	j2105349457 [label="Pauvre petit...",shape=box,color=blue];
		j2105349457 -> j253530729;
	j1536610458 [label="Yeah... that's Otak.",shape=box,color=red];
		j1536610458 -> j2352381463;
	j838527418 [label="Oh, Marie. I'm so sorry...",shape=box,color=red];
		j838527418 -> j2352381463;
	j253530729 [label="Boolean MarieOtak1 is now true.",color=orange];
		j253530729 -> j299353507;
		j253530729 -> j4168905161;
	j2352381463 [label="It shatters me into a million pieces to think there is nothing to be done for him.",shape=box,color=blue];
		j2352381463 -> j457335464;
	j457335464 [label="Evaluate expressions",color=orange];
		j457335464 -> j1963851720 [label="MarieCephalonSoul",color=purple];
		j457335464 -> j747825392 [label="MarieCephalonNoSoul",color=purple];
		j457335464 -> j1192373579 [label="MarieCephalonUnsure",color=purple];
		j457335464 -> j4005254291 [label="false",color=purple];
	j1963851720 [label="Oh, Luminaries - what manner of hell have you made for him, to keep his soul trapped within that cage of science and flickering lights?",shape=box,color=blue];
		j1963851720 -> j826016461;
	j747825392 [label="I can only pray to the Luminaries that you are right and nothing remains inside that shell but... but science and flickering lights.",shape=box,color=blue];
		j747825392 -> j2880449530;
	j1192373579 [label="I know you are not sure if the Cephalons contain souls - but I can only pray to the Luminaries that... that poor Otak does not suffer.",shape=box,color=blue];
		j1192373579 -> j742684529;
	j4005254291 [label="I can only pray to the Luminaries that all that remains inside that shell is nothing but... but science and flickering lights.",shape=box,color=blue];
		j4005254291 -> j3044740562;
	j826016461 [label="Why leave him there, broken and waiting until he is allowed to die to be given peace? I can only pray... that if there is some kind of presence there -",shape=box,color=blue];
		j826016461 -> j1794756017;
	j2880449530 [label="And no soul is trapped within that broken thing, waiting until it is allowed to finally die to be given peace.",shape=box,color=blue];
		j2880449530 -> j24101861;
	j742684529 [label="That no soul is trapped within that broken thing, waiting until it is allowed to finally die to be given peace.",shape=box,color=blue];
		j742684529 -> j1850078665;
	j3044740562 [label="And no soul is trapped within that broken thing, waiting until it is allowed to finally die to be given peace.",shape=box,color=blue];
		j3044740562 -> j1850078665;
	j1794756017 [label="It is because he remains by choice as some kind of lonely vigil...",shape=box,color=blue];
		j1794756017 -> j4181414740;
	j24101861 [label="Because if you are wrong, and a soul remains within that cage against its will ?",shape=box,color=blue];
		j24101861 -> j1144645185;
	j1850078665 [label="Or if there is some kind of presence there, it is because he remains by choice as some manner of lonely vigil.",shape=box,color=blue];
		j1850078665 -> j4181414740;
	j4181414740 [label="To think otherwise is enough to make one question the kindness of the gods, non ?",shape=box,color=blue];
		j4181414740 -> j1111168100;
	j1144645185 [label="It is enough to make one question the kindness of the gods, non ?",shape=box,color=blue];
		j1144645185 -> j1111168100;
	j1111168100 [label="And then where would I be ?",shape=box,color=blue];
		j1111168100 -> j698725705;
	j698725705 [label="Forgive me, I am... I am melancholy today. ",shape=box,color=blue];
		j698725705 -> j3251038745;
	j3251038745 [label="Evaluate expressions",color=orange];
		j3251038745 -> j2829064561 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j2158437710 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j2343546773 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j1915521511 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j2829064561 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j2158437710 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j2343546773 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j1915521511 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j2829064561 [label="false",color=purple];
		j3251038745 -> j2158437710 [label="false",color=purple];
		j3251038745 -> j1915521511 [label="false",color=purple];
	j2829064561 [label="It's okay. You have every right to be.",shape=box,color=red];
		j2829064561 -> j3527391944;
	j2158437710 [label="Anything I can do to cheer you up? We could go torment Roathe.",shape=box,color=red];
		j2158437710 -> j191761778;
	j2343546773 [label="Anything I can do to cheer you up? Maybe steal some pastries?",shape=box,color=red];
		j2343546773 -> j3012928328;
	j1915521511 [label="Sometimes the gods are cruel, Marie. That's just life.",shape=box,color=red];
		j1915521511 -> j882690503;
	j3527391944 [label="+20 Chemistry",color=orange];
		j3527391944 -> j2935772658;
	j191761778 [label="+15 Chemistry",color=orange];
		j191761778 -> j4158541259;
	j3012928328 [label="+20 Chemistry",color=orange];
		j3012928328 -> j4158541259;
	j882690503 [label="+5 Chemistry",color=orange];
		j882690503 -> j1817394999;
	j2935772658 [label="Merci. Well, I no longer wish to be. I am going to go do something more cheerful ! I think M'sieur Fibonacci's tank is due for a dusting.",shape=box,color=blue];
		j2935772658 -> j2486340526;
	j4158541259 [label="Ha ! Merci. That is sure to stop these foolish tears of mine. You do know how to cheer silly little Marie, non ?",shape=box,color=blue];
		j4158541259 -> j409448838;
		j4158541259 -> j1975411380;
	j1817394999 [label="Oui. You are quite right. They are. The world is full of no end of stories like that of Monsieur Otak, and many far worse than his. I should not weep over one. ",shape=box,color=blue];
		j1817394999 -> j1796043549;
	j2486340526 [label="Check boolean MarieDating",color=orange];
		j2486340526 -> j4168335523 [label=true,color=green];
		j2486340526 -> j1783435543 [label=false,color=brown];
	j409448838 [label="It's the very least I can do for you.",shape=box,color=red];
		j409448838 -> j1350233930;
	j1975411380 [label="You're not being silly at all. I feel the same way.",shape=box,color=red];
		j1975411380 -> j1350233930;
	j1796043549 [label="Yet here I sit, doing just that. Thank you for reminding me of my foolishness. Fie! Silly little Marie. Well... I think M'sieur Fibonacci's tank is due for a dusting.",shape=box,color=blue];
		j1796043549 -> j2486340526;
	j4168335523 [label="À la revoyure, my wolf.",shape=box,color=blue];
		j4168335523 -> j3007723528;
	j1783435543 [label="À la revoyure !",shape=box,color=blue];
		j1783435543 -> j3007723528;
	j1350233930 [label="+5 Chemistry",color=orange];
		j1350233930 -> j4058209286;
	j4058209286 [label="Check boolean MarieDating",color=orange];
		j4058209286 -> j1927676598 [label=true,color=green];
		j4058209286 -> j2093572631 [label=false,color=brown];
	j1927676598 [label="Merci, merci, merci, my wolf. Let us go, then, and make mischief. ",shape=box,color=blue];
		j1927676598 -> j3007723528;
	j2093572631 [label="Merci, merci, merci. Let us go, then, and make mischief.",shape=box,color=blue];
		j2093572631 -> j3007723528;
}