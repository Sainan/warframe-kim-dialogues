	3486 [label="The face upon the back of Monsieur Necraloid ! I have finally met him !",shape=box,color=blue];
		3486 -> 3489;
		3486 -> 3490;
		3486 -> 3491;
	3487 [label="Did you enjoy talking to him?",shape=box,color=red];
		3487 -> 3492;
	3488 [label="How did your conversation with him go?",shape=box,color=red];
		3488 -> 3493;
	3489 [label="Poor Otak... How did that go?",shape=box,color=red];
		3489 -> 3494;
	3490 [label="I'm glad you finally met. Otak can be a little hard to explain.",shape=box,color=red];
		3490 -> 3495;
	3491 [label="You met Otak? Oh boy... How did that go?",shape=box,color=red];
		3491 -> 3496;
	3492 [label="I did. Though perhaps I wanted to weep for it. For he introduced himself to me thrice over in the same conversation, as though we had never been introduced.",shape=box,color=blue];
		3492 -> 3497;
	3493 [label="He... introduced himself to me thrice over in the same conversation, as though we had never been introduced.",shape=box,color=blue];
		3493 -> 3497;
	3494 [label="I found him nothing but sweet and charming ! But buried beneath a layer of humor, I felt great heartbreak.",shape=box,color=blue];
		3494 -> 3498;
	3495 [label="Yes, I would think so. A child's scrawl written on the back of an automaton. I found him nothing but sweet and charming !",shape=box,color=blue];
		3495 -> 3499;
	3496 [label="Why do you sound less than pleased that I met him ?",shape=box,color=blue];
		3496 -> 3500;
		3496 -> 3501;
		3496 -> 3502;
	3497 [label="Greeting me in the same unflinching, cheerful way he had the previous times. But he knew me as a Sœur de Sol ! ",shape=box,color=blue];
		3497 -> 3503;
	3498 [label="Will you tell me the story of poor Monsieur Otak ?",shape=box,color=blue];
		3498 -> 3504;
	3499 [label="But buried beneath the humor, there is great heartbreak.",shape=box,color=blue];
		3499 -> 3498;
	3500 [label="He can get on my nerves sometimes, is all. ",shape=box,color=red];
		3500 -> 3505;
	3501 [label="I didn't mean to. He can just be a little... off putting for some people.",shape=box,color=red];
		3501 -> 3506;
	3502 [label="I'm sorry. He can get on people's nerves sometimes. It's not his fault.",shape=box,color=red];
		3502 -> 3506;
	3503 [label="Indeed, he knew much of the Luminaries ! We talked at length of the \"Ancient Religions\" as he dubbed them, in the \"days before the Orokin Empire.\"",shape=box,color=blue];
		3503 -> 3507;
	3504 [label="Otak used to be an Archimedean, an Orokin scientist and academic. What's happened to him isn't exactly the happiest story.",shape=box,color=red];
		3504 -> 3508;
	3505 [label="I would hope you would seek to be more kind with someone who is clearly infirme. Mais par la grâce de Sol, go we all.",shape=box,color=blue];
		3505 -> 3509;
	3506 [label="And I would hope they would show him kindness and patience. Mais par la grâce de Sol, go we all.",shape=box,color=blue];
		3506 -> 3509;
	3507 [label="Though he said much of that knowledge was lost now, deep in the archives, and very much forbidden. He swore me to secrecy.",shape=box,color=blue];
		3507 -> 3510;
	3508 [label="By all accounts he was a genius, and the mind behind the harnessing of argon crystals.",shape=box,color=red];
		3508 -> 3511;
	3509 [label="Such a fate could wait for any of us. Even you.",shape=box,color=blue];
		3509 -> 3512;
		3509 -> 3513;
	3510 [label="He told me that he was deeply concerned that Executor Ballas - whoever he may be - might discover my sect of heretics and have me executed.",shape=box,color=blue];
		3510 -> 3514;
		3510 -> 3515;
	3511 [label="Which are harnessed from the Void - they're the reason we can create a lot of the powerful warframes and weapons we make.",shape=box,color=red];
		3511 -> 3516;
	3512 [label="You're right, I'm sorry. I didn't mean that.",shape=box,color=red];
		3512 -> 3498;
	3513 [label="I just don't have the time to spend on him, I'm sorry.",shape=box,color=red];
		3513 -> 3517;
	3514 [label="Ballas is dead... keep going.",shape=box,color=red];
		3514 -> 3518;
	3515 [label="That... won't happen. Keep talking.",shape=box,color=red];
		3515 -> 3518;
	3516 [label="He specialized in crystallography. And his works were archived here, in the laboratories.",shape=box,color=red];
		3516 -> 3519;
	3517 [label="Then I am sorry for wasting more of it.",shape=box,color=blue];
		3517 -> 3520;
	3518 [label="+5 Chemistry",color=orange];
		3518 -> 3521;
	3519 [label="For some reason, I don't know why, he was turned into a Cephalon, and given his own necraloid shell.",shape=box,color=red];
		3519 -> 3522;
	3520 [label="Update boolean MarieOtakComplete",color=orange];
		3520 -> 3523;
	3521 [label="I suspected... Well, he asked me where I was from, and when I told him, he laughed and said \"no, that's impossible! And I should know, I'm -\"",shape=box,color=blue];
		3521 -> 3524;
	3522 [label="Not all Cephalons were made as a punishment. But things went... poorly here on Deimos, and he was badly damaged.",shape=box,color=red];
		3522 -> 3525;
	3523 [label="Chat ends.",color=orange];
	3524 [label="And then he... introduced himself to me again. And asked me if I was coming from the plains with mineral samples...",shape=box,color=blue];
		3524 -> 3526;
		3524 -> 3527;
	3525 [label="Pauvre petit...",shape=box,color=blue];
		3525 -> 3528;
	3526 [label="Yeah... that's Otak.",shape=box,color=red];
		3526 -> 3529;
	3527 [label="Oh, Marie. I'm so sorry...",shape=box,color=red];
		3527 -> 3529;
	3528 [label="Update boolean MarieOtak1",color=orange];
		3528 -> 3487;
		3528 -> 3488;
	3529 [label="It shatters me into a million pieces to think there is nothing to be done for him.",shape=box,color=blue];
		3529 -> 3530;
	3530 [label="Evaluate expressions",color=orange];
		3530 -> 3531 [label="MarieCephalonSoul",color=purple];
