		3960 -> 2161;
	2203 [label="But I wonder if you do not find yourself upon a crossroads, and you may wish to think upon which way to go, non ?",shape=box,color=blue];
		2203 -> 2209;
	2204 [label="A soul is more than the faith they wear. I am une Sœur de Sol, but I would hope you see more than that in me, non ?",shape=box,color=blue];
		2204 -> 2210;
	2205 [label="That is why I believe. I feel Sol beside me when I arrive at the places when I am most unsure. I shut my eyes et il est là, to guide me.",shape=box,color=blue];
		2205 -> 2211;
		2205 -> 2212;
		2205 -> 2213;
	2206 [label="I do not know if you will ever find it, but I pray that you will. For what you might discover there will be un miracle. ",shape=box,color=blue];
