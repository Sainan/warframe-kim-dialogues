		j1116270187 -> j1697729097;
	j1844471690 [label="+15 Chemistry",color=orange];
		j1844471690 -> j1914082105;
	j1697729097 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j1697729097 -> j3816308296;
	j1914082105 [label="I am growing to also have faith in you.",shape=box,color=blue];
		j1914082105 -> j2979249757;
	j3816308296 [label="Boolean DrifterFaithPersonal is now false.",color=orange];
		j3816308296 -> j461955229;
