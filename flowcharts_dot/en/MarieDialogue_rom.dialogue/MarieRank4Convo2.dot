	"Chat ends." [color=orange];
	j2679105980 [label="Oui ! Did you know that when I am fully in flight, I am impossible à voir ?! Je suis invisible !",shape=box,color=blue];
		j2679105980 -> j1290213908;
	j2128463269 [label="+5 Chemistry",color=orange];
		j2128463269 -> j2894622072;
	j186264682 [label="+5 Chemistry",color=orange];
		j186264682 -> j3648719684;
	j2968616032 [label="You told me you have a faith similar to mine, non ? Why do you believe ?",shape=box,color=blue];
		j2968616032 -> j1491170426;
		j2968616032 -> j2751518712;
		j2968616032 -> j2405127115;
		j2968616032 -> j3483795578;
		j2968616032 -> j2741777757;
	j3493496200 [label="You told me you have a faith, though it was different from mine, it was faith all the same. Why do you believe ?",shape=box,color=blue];
		j3493496200 -> j1491170426;
		j3493496200 -> j2751518712;
		j3493496200 -> j2405127115;
		j3493496200 -> j3483795578;
		j3493496200 -> j2741777757;
	j1820692769 [label="I know you said your faith is personal to you, much like une histoire of your own making, but it is faith all the same. Why do you believe ?",shape=box,color=blue];
		j1820692769 -> j1491170426;
		j1820692769 -> j2751518712;
		j1820692769 -> j2405127115;
		j1820692769 -> j3483795578;
		j1820692769 -> j2741777757;
	j1488926391 [label="Why do you ?",shape=box,color=blue];
		j1488926391 -> j1491170426;
		j1488926391 -> j2751518712;
		j1488926391 -> j2405127115;
		j1488926391 -> j3483795578;
		j1488926391 -> j2741777757;
	j832281644 [label="I could ask you the same of Lua, non ? Why do you believe ?",shape=box,color=blue];
		j832281644 -> j1491170426;
		j832281644 -> j2405127115;
		j832281644 -> j3483795578;
		j832281644 -> j2741777757;
		j832281644 -> j2751518712;
	j86687863 [label="Why Sol, in particular ? Over Lua or perhaps the balance you adhere to ? A very good question. Why do you believe ?",shape=box,color=blue];
		j86687863 -> j1491170426;
		j86687863 -> j2751518712;
		j86687863 -> j2405127115;
		j86687863 -> j3483795578;
		j86687863 -> j2741777757;
	j1944889651 [label="What gives me my certainty, you wonder ? Where you say we cannot know the universe ?",shape=box,color=blue];
		j1944889651 -> j1749588406;
	j2984690083 [label="As someone who follows no faith, I could see why that could seem strange, oui.",shape=box,color=blue];
		j2984690083 -> j3588806134;
	j1181729799 [label="What gives me my certainty, you wonder ?",shape=box,color=blue];
		j1181729799 -> j1749588406;
	j1290213908 [label="Do you know what this means ?!",shape=box,color=blue];
		j1290213908 -> j1414080862;
		j1290213908 -> j1459702966;
	j2894622072 [label="Oui ! I am unfond of cut flowers. If you wish to get me a gift, I pray it will not be roses in a vase.",shape=box,color=blue];
		j2894622072 -> j1167775302;
		j2894622072 -> j1744236198;
	j3648719684 [label="Pour toi ? Bien sûr.",shape=box,color=blue];
		j3648719684 -> j3395692458;
		j3648719684 -> j242691715;
	j1491170426 [label="I... suppose I feel obligated to.",shape=box,color=red];
		j1491170426 -> j3222404579;
	j2751518712 [label="I wasn't really being honest with you when I told you that answer.",shape=box,color=red];
		j2751518712 -> j3069275248;
	j2405127115 [label="I had an experience. It changed my life.",shape=box,color=red];
		j2405127115 -> j1998657205;
	j3483795578 [label="Nothing ever happened, it's just something I've felt. It's guided me.",shape=box,color=red];
		j3483795578 -> j3192997485;
	j2741777757 [label="I want to believe. Therefore, I do.",shape=box,color=red];
		j2741777757 -> j3080931226;
	j1749588406 [label="I fear my answer may disappoint you, wolf. There has been no great miracle. No rays from the skies that shone down upon me.",shape=box,color=blue];
		j1749588406 -> j311053975;
	j3588806134 [label="\"Why does this sensible young woman believe in things that I do not think are real, that seems silly,\" non ?",shape=box,color=blue];
		j3588806134 -> j4120573018;
		j3588806134 -> j3076087467;
	j1414080862 [label="No?",shape=box,color=red];
		j1414080862 -> j1014039410;
	j1459702966 [label="Should I be worried?",shape=box,color=red];
		j1459702966 -> j2383086557;
	j1167775302 [label="How did you guess that was what I was going to ask? That's amazing.",shape=box,color=red];
		j1167775302 -> j2787571972;
	j1744236198 [label="That... wasn't what I was going to ask, but I will keep it in mind, thank you!",shape=box,color=red];
		j1744236198 -> j470421604;
	j3395692458 [label="Why do you believe in Sol?",shape=box,color=red];
		j3395692458 -> j2563733639;
	j3222404579 [label="Check boolean DrifterFaithNoPeace",color=orange];
		j3222404579 -> j1522583518 [label=true,color=green];
		j3222404579 -> j2235489945 [label=false,color=brown];
	j3069275248 [label="Oui ? I am curious, why did you lie ?",shape=box,color=blue];
		j3069275248 -> j715188189;
		j3069275248 -> j4182171338;
	j1998657205 [label="Then I am jealous ! Most are not so lucky to have an event they can point to that is so ferme, oui ?",shape=box,color=blue];
		j1998657205 -> j2316191574;
	j3192997485 [label="Ah, then our answers are the same. I have never known un miracle, save perhaps le Cardinal's arrival to the Cathédrale.",shape=box,color=blue];
		j3192997485 -> j974053803;
	j3080931226 [label="Check boolean DrifterFaithNoPeace",color=orange];
		j3080931226 -> j730460336 [label=true,color=green];
		j3080931226 -> j3260647970 [label=false,color=brown];
	j311053975 [label="Non, I have always simply felt as though there has been a présence in my life that has been there to guide me. A benefactor that smiles and points when I reach the crossroads, nothing more.",shape=box,color=blue];
		j311053975 -> j1335180133;
		j311053975 -> j43972062;
	j4120573018 [label="Honestly? Yes, kind of. I didn't want to phrase it that way, though.",shape=box,color=red];
		j4120573018 -> j3565299110;
	j3076087467 [label="I was more wondering if there was an event, or... a moment that led to it.",shape=box,color=red];
		j3076087467 -> j1749588406;
	j1014039410 [label="Neither do I ! But the possibilities are now endless !",shape=box,color=blue];
		j1014039410 -> j168221506;
	j2383086557 [label="Peut-être ! Because the possibilities are now endless !",shape=box,color=blue];
		j2383086557 -> j168221506;
	j2787571972 [label="Because the devil told me you were going to.",shape=box,color=blue];
		j2787571972 -> j3920130825;
	j470421604 [label="Oh ! Oh, forgive me ! I am sorry. What is it that you wished to ask ? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		j470421604 -> j3395692458;
		j470421604 -> j242691715;
	j1522583518 [label="And you say it does not bring you much peace... this breaks my heart.",shape=box,color=blue];
		j1522583518 -> j2235489945;
	j2235489945 [label="I will not tell you what to do. And I will not tell you what roads to seek.",shape=box,color=blue];
		j2235489945 -> j12293755;
	j715188189 [label="I'm not sure, to be blunt. It was impulsive.",shape=box,color=red];
		j715188189 -> j4122086375;
	j4182171338 [label="I thought it might be a way to get to know you better...",shape=box,color=red];
		j4182171338 -> j1688026252;
	j2316191574 [label="But your question was about why I believe, and I was quite rude in turning it about-face, je m'excuse.",shape=box,color=blue];
		j2316191574 -> j1749588406;
	j974053803 [label="Even then, that was an act of man and science, not the Luminaries, non ? This sérum that gave me the gift of flight -",shape=box,color=blue];
		j974053803 -> j1013316544;
	j730460336 [label="But you say it does not bring you much peace ? This breaks my heart...",shape=box,color=blue];
		j730460336 -> j412642102;
	j3260647970 [label="I think your faith may be the strongest of them all, non ?",shape=box,color=blue];
		j3260647970 -> j3804212007;
	j1335180133 [label="You wouldn't call Entrati's serum a miracle?",shape=box,color=red];
		j1335180133 -> j974053803;
	j43972062 [label="Not even Lyon's voices? Or the Indifference?",shape=box,color=red];
		j43972062 -> j321422213;
	j3565299110 [label="Oh, thinking me silly for believing in the Luminaries is one of the most polite things you can think about someone with a differing faith.",shape=box,color=blue];
		j3565299110 -> j2714853330;
	j168221506 [label="The devil should be very afraid ! Beware, evil one ! The light shall smite thee from above !",shape=box,color=blue];
		j168221506 -> j2718912295;
	j3920130825 [label="Non, non, non... You were not going to ask me that, were you ? Ah !! Je vais lui faire bouffer un de ces livres !",shape=box,color=blue];
		j3920130825 -> j1595618664;
	j12293755 [label="For I am a poor shelter in this Void storm in which you have found yourself.",shape=box,color=blue];
		j12293755 -> j2985654076;
	j4122086375 [label="I do not know what instinct drove you to tell me such things. But I am glad you have spoken the truth, now.",shape=box,color=blue];
		j4122086375 -> j4227456462;
	j1688026252 [label="Oh... you did not need to tell me such things to know me.",shape=box,color=blue];
		j1688026252 -> j4227456462;
	j1013316544 [label="It is the product of a man. But I believe that it was Sol who guided our roads to come together as one.",shape=box,color=blue];
		j1013316544 -> j193367720;
	j412642102 [label="It sounds to me as though you wander in the woods, desperately seeking a trail that you wish to be there.",shape=box,color=blue];
		j412642102 -> j1655098512;
	j3804212007 [label="To walk the trail in the woods simply with the hope in your heart to lead the way ?",shape=box,color=blue];
		j3804212007 -> j4019505315;
	j321422213 [label="It could be, I do not know. Perhaps the devil is right, and they it is all product of science we do not yet understand. The two are not exclusive, non ?",shape=box,color=blue];
		j321422213 -> j193367720;
	j2714853330 [label="It offends me none, and I am glad for your honesty, always. ",shape=box,color=blue];
		j2714853330 -> j1749588406;
	j2718912295 [label="+20 Chemistry",color=orange];
		j2718912295 -> j3199134152;
	j1595618664 [label="What is it that you wished to ask ? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		j1595618664 -> j3395692458;
		j1595618664 -> j242691715;
	j2985654076 [label="But I wonder if you do not find yourself upon a crossroads, and you may wish to think upon which way to go, non ?",shape=box,color=blue];
		j2985654076 -> j2207810341;
	j4227456462 [label="A soul is more than the faith they wear. I am une Sœur de Sol, but I would hope you see more than that in me, non ?",shape=box,color=blue];
		j4227456462 -> j4105745275;
	j193367720 [label="That is why I believe. I feel Sol beside me when I arrive at the places when I am most unsure. I shut my eyes et il est là, to guide me.",shape=box,color=blue];
		j193367720 -> j2721145728;
		j193367720 -> j3763697755;
		j193367720 -> j2068854172;
	j1655098512 [label="I do not know if you will ever find it, but I pray that you will. For what you might discover there will be un miracle. ",shape=box,color=blue];
		j1655098512 -> j2316191574;
	j4019505315 [label="That is beautiful...",shape=box,color=blue];
		j4019505315 -> j2316191574;
	j3199134152 [label="Sainte Mère Sol, vous avez béni votre fille aujourd'hui ! HA-HA !!",shape=box,color=blue];
		j3199134152 -> "Chat ends.";
	j2207810341 [label="Obligation is no reason to believe. It only breeds doubt at best, and hollow contempt at worst.",shape=box,color=blue];
		j2207810341 -> j2674019716;
	j4105745275 [label="There are as many topics that we could choose as there are stars in the sky !",shape=box,color=blue];
		j4105745275 -> j893508083;
		j4105745275 -> j841858375;
	j2721145728 [label="That's beautiful.",shape=box,color=red];
		j2721145728 -> j3457116991;
	j3763697755 [label="Has he ever failed to guide you?",shape=box,color=red];
		j3763697755 -> j1700397705;
	j2068854172 [label="I wish I had that...",shape=box,color=red];
		j2068854172 -> j2810145478;
	j2674019716 [label="Faith should be a balm to the soul. Not a crutch nor an excuse.",shape=box,color=blue];
		j2674019716 -> j3009012860;
	j893508083 [label="Do you forgive me, then?",shape=box,color=red];
		j893508083 -> j4082381856;
	j841858375 [label="I'm sorry. It was a silly thing to do.",shape=box,color=red];
		j841858375 -> j149898595;
	j3457116991 [label="Oui, and I know I am lucky. And it is a peace that is easy to seek to impose upon others, whether or not they want to have it.",shape=box,color=blue];
		j3457116991 -> j413263389;
	j1700397705 [label="Oui, many times. And in those moments, I reflect upon why. Perhaps I am meant to simply find my own way, non ? Ou peut-être que je suis une folle après tout, hah ! We are not always meant to know.",shape=box,color=blue];
		j1700397705 -> j413263389;
	j2810145478 [label="Oui, and I pray that you will have it some day. But it is not something that can be given or taught, it is something that must be found.",shape=box,color=blue];
		j2810145478 -> j143353526;
	j3009012860 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j3009012860 -> j2316191574;
	j4082381856 [label="Oui, I forgive you. If you were like Lyon, I would tell you ten lashes was your payment.",shape=box,color=blue];
		j4082381856 -> j1398195734;
	j149898595 [label="Oui, and if you were like Lyon, I would tell you ten lashes was your payment ! But you are not. And you are forgiven.",shape=box,color=blue];
		j149898595 -> j1398195734;
	j413263389 [label="But as long as I am harming no one with my beliefs, I see no harm in holding them, oui ?",shape=box,color=blue];
		j413263389 -> j1341978780;
	j143353526 [label="Within or without, where it may lay is different for everyone.",shape=box,color=blue];
		j143353526 -> j1341978780;
	j1398195734 [label="Boolean DrifterFaithBalance is now false.",color=orange];
		j1398195734 -> j945396843;
	j1341978780 [label="One thing has become clear to me though as of late.",shape=box,color=blue];
		j1341978780 -> j2837999324;
		j1341978780 -> j3005024914;
	j945396843 [label="Boolean DrifterFaithYesForeign is now false.",color=orange];
		j945396843 -> j1116270187;
	j2837999324 [label="What?",shape=box,color=red];
		j2837999324 -> j1844471690;
	j3005024914 [label="Oh?",shape=box,color=red];
		j3005024914 -> j1844471690;
