		2151 -> 2166;
		2151 -> 2163;
	2155 [label="Why Sol, in particular ? Over Lua or perhaps the balance you adhere to ? A very good question. Why do you believe ?",shape=box,color=blue];
		2155 -> 2162;
		2155 -> 2163;
		2155 -> 2164;
