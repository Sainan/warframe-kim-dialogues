		2190 -> 2200;
	2193 [label="The devil should be very afraid ! Beware, evil one ! The light shall smite thee from above !",shape=box,color=blue];
		2193 -> 2202;
	3959 [label="Non, non, non... You were not going to ask me that, were you ? Ah !! Je vais lui faire bouffer un de ces livres !",shape=box,color=blue];
		3959 -> 3960;
	2194 [label="For I am a poor shelter in this Void storm in which you have found yourself.",shape=box,color=blue];
		2194 -> 2203;
	2195 [label="I do not know what instinct drove you to tell me such things. But I am glad you have spoken the truth, now.",shape=box,color=blue];
		2195 -> 2204;
	2196 [label="Oh... you did not need to tell me such things to know me.",shape=box,color=blue];
		2196 -> 2204;
	2197 [label="It is the product of a man. But I believe that it was Sol who guided our roads to come together as one.",shape=box,color=blue];
		2197 -> 2205;
	2198 [label="It sounds to me as though you wander in the woods, desperately seeking a trail that you wish to be there.",shape=box,color=blue];
		2198 -> 2206;
