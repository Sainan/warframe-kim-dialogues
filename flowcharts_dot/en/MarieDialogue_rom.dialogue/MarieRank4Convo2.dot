		2217 -> 2223;
	2218 [label="Oui, and I know I am lucky. And it is a peace that is easy to seek to impose upon others, whether or not they want to have it.",shape=box,color=blue];
		2218 -> 2224;
	2219 [label="Oui, many times. And in those moments, I reflect upon why. Perhaps I am meant to simply find my own way, non ? Ou peut-être que je suis une folle après tout, hah ! We are not always meant to know.",shape=box,color=blue];
		2219 -> 2224;
