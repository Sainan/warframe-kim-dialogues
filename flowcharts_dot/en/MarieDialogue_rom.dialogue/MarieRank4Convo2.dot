	2176 [label="Check boolean DrifterFaithNoPeace",color=orange];
		2176 -> 2188 [label=true,color=green];
		2176 -> 2189 [label=false,color=brown];
	2179 [label="Non, I have always simply felt as though there has been a présence in my life that has been there to guide me. A benefactor that smiles and points when I reach the crossroads, nothing more.",shape=box,color=blue];
		2179 -> 2191;
		2179 -> 2192;
	2177 [label="Honestly? Yes, kind of. I didn't want to phrase it that way, though.",shape=box,color=red];
