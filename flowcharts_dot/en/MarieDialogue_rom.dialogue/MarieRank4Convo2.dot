	2185 [label="I thought it might be a way to get to know you better...",shape=box,color=red];
		2185 -> 2196;
	2186 [label="But your question was about why I believe, and I was quite rude in turning it about-face, je m'excuse.",shape=box,color=blue];
		2186 -> 2168;
	2187 [label="Even then, that was an act of man and science, not the Luminaries, non ? This sérum that gave me the gift of flight -",shape=box,color=blue];
		2187 -> 2197;
	2188 [label="But you say it does not bring you much peace ? This breaks my heart...",shape=box,color=blue];
		2188 -> 2198;
	2189 [label="I think your faith may be the strongest of them all, non ?",shape=box,color=blue];
		2189 -> 2199;
	2191 [label="You wouldn't call Entrati's serum a miracle?",shape=box,color=red];
		2191 -> 2187;
	2192 [label="Not even Lyon's voices? Or the Indifference?",shape=box,color=red];
		2192 -> 2201;
