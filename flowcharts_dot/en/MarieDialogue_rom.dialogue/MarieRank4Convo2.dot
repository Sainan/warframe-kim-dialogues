	2207 [label="That is beautiful...",shape=box,color=blue];
		2207 -> 2186;
	2208 [label="Sainte Mère Sol, vous avez béni votre fille aujourd'hui ! HA-HA !!",shape=box,color=blue];
		2208 -> 2214;
	2209 [label="Obligation is no reason to believe. It only breeds doubt at best, and hollow contempt at worst.",shape=box,color=blue];
