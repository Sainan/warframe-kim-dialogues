	282 [label="+5 Chemistry",color=orange];
		282 -> 285;
	281 [label="Ah, I see. You are simply in the business of collecting soldiers. But that devil would sooner sink a dagger betwixt your ribs than guard your back.",shape=box,color=blue];
		281 -> 284;
	280 [label="Le diable séduit les cœurs les plus forts. He plays the cunning game, but be careful. Make sure he meets your eye and nothing else. ",shape=box,color=blue];
		280 -> 283;
	279 [label="Seems to me he has survived for longer than anyone should. I think perhaps hell should come reclaim its own, it seems to have wandered off.",shape=box,color=blue];
		279 -> 283;
	285 [label="I laud your compassion, it fills my heart with joy. The Luminaries teach us that all can be given aid. All can be forgiven. But... only if they seek it.",shape=box,color=blue];
		285 -> 290;
	284 [label="He is no ally of yours, nor will he ever be. That devil sides only with those who serve his needs.",shape=box,color=blue];
		284 -> 287;
		284 -> 288;
		284 -> 289;
	283 [label="+5 Chemistry",color=orange];
		283 -> 286;
	290 [label="Endless toil aiding those who never sweat in the field of their own redemption is the life of a slave left wanting.",shape=box,color=blue];
		290 -> 287;
		290 -> 288;
		290 -> 289;
	287 [label="I know more about the Orokin and his situation than you. I don't need your help.",shape=box,color=red];
		287 -> 291;
	288 [label="I appreciate your warnings. I'll keep them in mind when I'm dealing with him.",shape=box,color=red];
		288 -> 292;
	289 [label="Thank you. But I can handle myself. And, more importantly? I have handled worse than him.",shape=box,color=red];
		289 -> 293;
	286 [label="But I am being unkind... you do not know him. You do not see him for what he is. I simply do not wish for you to be hurt.",shape=box,color=blue];
