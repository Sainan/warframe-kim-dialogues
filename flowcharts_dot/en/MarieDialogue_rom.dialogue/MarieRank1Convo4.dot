		245 -> 248 [label="false",color=purple];
	250 [label="Truly ? It seems then you are the only one who does not. Between the child and the devil, it seems all are seeking parts of themselves they have misplaced.",shape=box,color=blue];
		250 -> 255;
		250 -> 256;
	251 [label="Is it too much of me to ask why you find yourself so bereft ? The child and the devil's reasons are known to me, but not yours.",shape=box,color=blue];
		251 -> 255;
		251 -> 256;
	249 [label="Why have you agreed to help the devil in his endeavors ? I hear tell you are responsible for the slaughter of his kin.",shape=box,color=blue];
		249 -> 252;
		249 -> 253;
		249 -> 254;
	248 [label="Do you intend to assist the devil in his endeavors ? I hear tell you are responsible for the slaughter of his kin.",shape=box,color=blue];
		248 -> 252;
		248 -> 253;
		248 -> 254;
	255 [label="I have spent some unknown number of years dying at the hands of... well? Myself. I don't mind not being able to remember each one.",shape=box,color=red];
		255 -> 260;
	256 [label="To summarize, I spent... a great number of years suffering. I guess it's some kind of self-defense mechanism, to forget.",shape=box,color=red];
		256 -> 261;
	252 [label="That was my other self. I believe in holding blame to individuals, not societies.",shape=box,color=red];
		252 -> 257;
	253 [label="That wasn't me, that was the kid. But I hate the Orokin just as much as the kid does.",shape=box,color=red];
		253 -> 258;
	254 [label="I wasn't there, the Night of the Naga Drums, when the Tenno turned on the Orokin. That was the kid.",shape=box,color=red];
		254 -> 259;
	260 [label="Nor do I blame you. If I were subject to that manner of abuse, I would be eager enough to tuck it all away. At the very least, I would not go looking for it.",shape=box,color=blue];
		260 -> 265;
	261 [label="I have no doubt ! If I were subject to that manner of abuse, I expect my soul would do something similar. Hide away all that cannot be mended, and does no good.",shape=box,color=blue];
		261 -> 265;
	257 [label="Add 1 to Thermostat",color=orange];
		257 -> 262;
	258 [label="Add -1 to Thermostat",color=orange];
		258 -> 263;
	259 [label="Night of the Naga Drums. Oh, I can see it in my mind. Quelles couleurs magnifiques !",shape=box,color=blue];
		259 -> 264;
	265 [label="+5 Chemistry",color=orange];
		265 -> 268;
	262 [label="Oui, je comprends. So quick we are to burn the building down, when the smell is the fault of the rats within its walls.",shape=box,color=blue];
		262 -> 266;
	263 [label="Je meurs d'envie de savoir pourquoi ! But a conversation for another day. Or else we will be here forever, and Monsieur Loid will become cross with me.",shape=box,color=blue];
		263 -> 267;
	264 [label="I will need to speak to Monsieur Loid for more details. But !",shape=box,color=blue];
		264 -> 267;
	268 [label="Although, this may give me some insight over what I wished to speak with you.",shape=box,color=blue];
