digraph {
	237 [label="MarieRank1Convo4 begins.",color=orange];
		237 -> 238;
	238 [label="May I ask what I hope is not an impolite question ? It is so very early in our friendship, especially to you, who by the tell of it, have known so many years.",shape=box,color=blue];
		238 -> 241;
		238 -> 240;
		238 -> 239;
	241 [label="I've honestly forgotten most of the years I've known. ",shape=box,color=red];
		241 -> 244;
	240 [label="Of course, I don't mind. Go ahead.",shape=box,color=red];
		240 -> 243;
	239 [label="[End.]",shape=box,color=red];
		239 -> 242;
	244 [label="Sol ! You break my heart with your words. You and the devil both find your minds devoid of knowledge like a book with chapters removed, non ?",shape=box,color=blue];
		244 -> 246;
		244 -> 247;
	243 [label="+5 Chemistry",color=orange];
		243 -> 245;
	242 [label="Chat ends.",color=orange];
	246 [label="I don't miss the parts of my past I'm lacking.",shape=box,color=red];
		246 -> 250;
	247 [label="If for very different reasons, yes.",shape=box,color=red];
		247 -> 251;
