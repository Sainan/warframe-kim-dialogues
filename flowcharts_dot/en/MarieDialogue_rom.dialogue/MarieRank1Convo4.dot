		293 -> 296;
	294 [label="Pardon. I hardly know you or your capacity for withstanding manipulation. I merely worry, as we have heaped our woes upon you.",shape=box,color=blue];
		294 -> 297;
	295 [label="That is all I could ask. Merci, merci, merci. Now, I fear I must go.",shape=box,color=blue];
