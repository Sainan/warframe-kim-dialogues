digraph {
	"MarieRank1Convo4 begins." [color=orange];
		"MarieRank1Convo4 begins." -> j2971147164;
	j2971147164 [label="May I ask what I hope is not an impolite question ? It is so very early in our friendship, especially to you, who by the tell of it, have known so many years.",shape=box,color=blue];
		j2971147164 -> j2888024872;
		j2971147164 -> j895553345;
		j2971147164 -> j242691715;
	j2888024872 [label="I've honestly forgotten most of the years I've known. ",shape=box,color=red];
		j2888024872 -> j3460308369;
	j895553345 [label="Of course, I don't mind. Go ahead.",shape=box,color=red];
		j895553345 -> j2947588656;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j3460308369 [label="Sol ! You break my heart with your words. You and the devil both find your minds devoid of knowledge like a book with chapters removed, non ?",shape=box,color=blue];
		j3460308369 -> j3244955416;
		j3460308369 -> j1264037736;
	j2947588656 [label="+5 Chemistry",color=orange];
		j2947588656 -> j523704316;
	"Chat ends." [color=orange];
	j3244955416 [label="I don't miss the parts of my past I'm lacking.",shape=box,color=red];
		j3244955416 -> j1134456534;
	j1264037736 [label="If for very different reasons, yes.",shape=box,color=red];
		j1264037736 -> j3913749697;
	j523704316 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j523704316 -> j1353452016 [label="x > 0",color=purple];
		j523704316 -> j3985455187 [label="x <= 0",color=purple];
		j523704316 -> j3985455187 [label="false",color=purple];
	j1134456534 [label="Truly ? It seems then you are the only one who does not. Between the child and the devil, it seems all are seeking parts of themselves they have misplaced.",shape=box,color=blue];
		j1134456534 -> j2377630059;
		j1134456534 -> j165005813;
	j3913749697 [label="Is it too much of me to ask why you find yourself so bereft ? The child and the devil's reasons are known to me, but not yours.",shape=box,color=blue];
		j3913749697 -> j2377630059;
		j3913749697 -> j165005813;
	j1353452016 [label="Why have you agreed to help the devil in his endeavors ? I hear tell you are responsible for the slaughter of his kin.",shape=box,color=blue];
		j1353452016 -> j1349830732;
		j1353452016 -> j297201666;
		j1353452016 -> j1294830424;
	j3985455187 [label="Do you intend to assist the devil in his endeavors ? I hear tell you are responsible for the slaughter of his kin.",shape=box,color=blue];
		j3985455187 -> j1349830732;
		j3985455187 -> j297201666;
		j3985455187 -> j1294830424;
	j2377630059 [label="I have spent some unknown number of years dying at the hands of... well? Myself. I don't mind not being able to remember each one.",shape=box,color=red];
		j2377630059 -> j2909433712;
	j165005813 [label="To summarize, I spent... a great number of years suffering. I guess it's some kind of self-defense mechanism, to forget.",shape=box,color=red];
		j165005813 -> j3451785913;
	j1349830732 [label="That was my other self. I believe in holding blame to individuals, not societies.",shape=box,color=red];
		j1349830732 -> j1511220840;
	j297201666 [label="That wasn't me, that was the kid. But I hate the Orokin just as much as the kid does.",shape=box,color=red];
		j297201666 -> j1633013018;
	j1294830424 [label="I wasn't there, the Night of the Naga Drums, when the Tenno turned on the Orokin. That was the kid.",shape=box,color=red];
		j1294830424 -> j1680562208;
	j2909433712 [label="Nor do I blame you. If I were subject to that manner of abuse, I would be eager enough to tuck it all away. At the very least, I would not go looking for it.",shape=box,color=blue];
		j2909433712 -> j4167669577;
	j3451785913 [label="I have no doubt ! If I were subject to that manner of abuse, I expect my soul would do something similar. Hide away all that cannot be mended, and does no good.",shape=box,color=blue];
		j3451785913 -> j4167669577;
	j1511220840 [label="Add 1 to Thermostat counter",color=orange];
		j1511220840 -> j3130716068;
	j1633013018 [label="Add -1 to Thermostat counter",color=orange];
		j1633013018 -> j1409381473;
	j1680562208 [label="Night of the Naga Drums. Oh, I can see it in my mind. Quelles couleurs magnifiques !",shape=box,color=blue];
		j1680562208 -> j3451011257;
	j4167669577 [label="+5 Chemistry",color=orange];
		j4167669577 -> j1878653617;
	j3130716068 [label="Oui, je comprends. So quick we are to burn the building down, when the smell is the fault of the rats within its walls.",shape=box,color=blue];
		j3130716068 -> j757649432;
	j1409381473 [label="Je meurs d'envie de savoir pourquoi ! But a conversation for another day. Or else we will be here forever, and Monsieur Loid will become cross with me.",shape=box,color=blue];
		j1409381473 -> j4192617946;
	j3451011257 [label="I will need to speak to Monsieur Loid for more details. But !",shape=box,color=blue];
		j3451011257 -> j4192617946;
	j1878653617 [label="Although, this may give me some insight over what I wished to speak with you.",shape=box,color=blue];
		j1878653617 -> j523704316;
	j757649432 [label="But that is a conversation for another day, or else we will be here forever, and Monsieur Loid will become cross with me.",shape=box,color=blue];
		j757649432 -> j4192617946;
	j4192617946 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4192617946 -> j3617244048 [label="x > 0",color=purple];
		j4192617946 -> j2650707701 [label="x <= 0",color=purple];
		j4192617946 -> j2650707701 [label="false",color=purple];
	j3617244048 [label="Pardonnez-moi ! I am not giving you a chance to answer. Why lend aid to the devil, then ?",shape=box,color=blue];
		j3617244048 -> j367566950;
		j3617244048 -> j3391587249;
		j3617244048 -> j2531869660;
		j3617244048 -> j3016618876;
	j2650707701 [label="Pardonnez-moi ! I am not giving you a chance to answer. Will you lend aid to the devil, then ?",shape=box,color=blue];
		j2650707701 -> j3016618876;
		j2650707701 -> j2531869660;
		j2650707701 -> j3391587249;
		j2650707701 -> j367566950;
	j367566950 [label="He hasn't done anything to prove he isn't worth helping... yet.",shape=box,color=red];
		j367566950 -> j3237433545;
	j3391587249 [label="I don't think I can be in the business of turning away allies.",shape=box,color=red];
		j3391587249 -> j102913786;
	j2531869660 [label="[Confess interest in Roathe.] There's something compelling about him...",shape=box,color=red];
		j2531869660 -> j2408386888;
	j3016618876 [label="He seems like he's doing what he needs to survive. I can't fault him for that.",shape=box,color=red];
		j3016618876 -> j2827212580;
	j3237433545 [label="Add 1 to Thermostat counter",color=orange];
		j3237433545 -> j755180939;
	j102913786 [label="Boolean MarieRoatheSoldier is now true.",color=orange];
		j102913786 -> j1822763184;
	j2408386888 [label="Boolean DrifterRoathe is now true.",color=orange];
		j2408386888 -> j4245434808;
	j2827212580 [label="Add -1 to Thermostat counter",color=orange];
		j2827212580 -> j449389028;
	j755180939 [label="+5 Chemistry",color=orange];
		j755180939 -> j646483790;
	j1822763184 [label="Ah, I see. You are simply in the business of collecting soldiers. But that devil would sooner sink a dagger betwixt your ribs than guard your back.",shape=box,color=blue];
		j1822763184 -> j3397732849;
	j4245434808 [label="Le diable séduit les cœurs les plus forts. He plays the cunning game, but be careful. Make sure he meets your eye and nothing else. ",shape=box,color=blue];
		j4245434808 -> j327500276;
	j449389028 [label="Seems to me he has survived for longer than anyone should. I think perhaps hell should come reclaim its own, it seems to have wandered off.",shape=box,color=blue];
		j449389028 -> j327500276;
	j646483790 [label="I laud your compassion, it fills my heart with joy. The Luminaries teach us that all can be given aid. All can be forgiven. But... only if they seek it.",shape=box,color=blue];
		j646483790 -> j2323230013;
	j3397732849 [label="He is no ally of yours, nor will he ever be. That devil sides only with those who serve his needs.",shape=box,color=blue];
		j3397732849 -> j934975467;
		j3397732849 -> j1645014751;
		j3397732849 -> j977009305;
	j327500276 [label="+5 Chemistry",color=orange];
		j327500276 -> j707077970;
	j2323230013 [label="Endless toil aiding those who never sweat in the field of their own redemption is the life of a slave left wanting.",shape=box,color=blue];
		j2323230013 -> j934975467;
		j2323230013 -> j1645014751;
		j2323230013 -> j977009305;
	j934975467 [label="I know more about the Orokin and his situation than you. I don't need your help.",shape=box,color=red];
		j934975467 -> j1972622146;
	j1645014751 [label="I appreciate your warnings. I'll keep them in mind when I'm dealing with him.",shape=box,color=red];
		j1645014751 -> j4229426326;
	j977009305 [label="Thank you. But I can handle myself. And, more importantly? I have handled worse than him.",shape=box,color=red];
		j977009305 -> j1084496587;
	j707077970 [label="But I am being unkind... you do not know him. You do not see him for what he is. I simply do not wish for you to be hurt.",shape=box,color=blue];
		j707077970 -> j934975467;
		j707077970 -> j1645014751;
		j707077970 -> j977009305;
	j1972622146 [label="Boolean MarieRoatheWarning is now true.",color=orange];
		j1972622146 -> j1233696649;
	j4229426326 [label="+10 Chemistry",color=orange];
		j4229426326 -> j474001735;
	j1084496587 [label="+5 Chemistry",color=orange];
		j1084496587 -> j3339479827;
	j1233696649 [label="Pardon. I hardly know you or your capacity for withstanding manipulation. I merely worry, as we have heaped our woes upon you.",shape=box,color=blue];
		j1233696649 -> j4121985793;
	j474001735 [label="That is all I could ask. Merci, merci, merci. Now, I fear I must go.",shape=box,color=blue];
		j474001735 -> "Chat ends.";
	j3339479827 [label="Oui, vous avez raison. I hardly know you or your capacity for withstanding manipulation. I merely worry, as we have heaped our woes upon you.",shape=box,color=blue];
		j3339479827 -> j816779171;
	j4121985793 [label="I shall not overstep again.",shape=box,color=blue];
		j4121985793 -> "Chat ends.";
	j816779171 [label="And now, I fear I must go.",shape=box,color=blue];
		j816779171 -> "Chat ends.";
