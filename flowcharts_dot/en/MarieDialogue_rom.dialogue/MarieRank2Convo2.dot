digraph {
	418 [label="MarieRank2Convo2 begins.",color=orange];
		418 -> 421;
		418 -> 420;
		418 -> 419;
	421 [label="How did you meet Entrati?",shape=box,color=red];
		421 -> 424;
	420 [label="May I ask how you feel about Entrati, now that you're here?",shape=box,color=red];
		420 -> 423;
	419 [label="[End.]",shape=box,color=red];
		419 -> 422;
	424 [label="I knew of him as Cardinal Dimanche. It might surprise you how many years he spent in the church, preaching to our flock.",shape=box,color=blue];
		424 -> 426;
		424 -> 427;
	423 [label="+5 Chemistry",color=orange];
		423 -> 425;
	422 [label="Chat ends.",color=orange];
	426 [label="Do you think it was all a lie? Or do you think he believed it?",shape=box,color=red];
		426 -> 429;
	427 [label="I'm not. He's a good liar.",shape=box,color=red];
		427 -> 430;
	425 [label="Ah, a very polite question that masks a very challenging answer - quite cleverly phrased, I must admit.",shape=box,color=blue];
		425 -> 428;
	429 [label="He spoke of forgiveness, of family, and of empathy with such fervor and dedication I do not know how it could be an act.",shape=box,color=blue];
		429 -> 434;
	430 [label="I appreciate that your experiences with him are not the same as mine. But you must also understand that to me, he was nothing but kind and caring.",shape=box,color=blue];
		430 -> 435;
	428 [label="I feel the same as I did the first day I watched him deliver a sermon from the pulpit to our paroissiens. Blessed to have been in his présence.",shape=box,color=blue];
		428 -> 431;
		428 -> 432;
		428 -> 433;
	434 [label="Does he hold the faith of the Luminaries ? Of Sol and Lua ? That, I do not know any longer, knowing now from whence and when he hails. Peu importe.",shape=box,color=blue];
		434 -> 437;
	435 [label="Do your truths invalidate mine, or whose am I meant to believe ? Shall I condemn every act of mercy, every act of gentleness, he showed in his years amongst the parish ?",shape=box,color=blue];
		435 -> 438;
	431 [label="I'm glad to hear it, honestly. I think everyone is too quick to condemn him.",shape=box,color=red];
		431 -> 436;
	432 [label="Do you think he was tricking people? Or do you think he believed it?",shape=box,color=red];
		432 -> 429;
	433 [label="I'm... sorry you fell for his tricks.",shape=box,color=red];
		433 -> 430;
	437 [label="What importance is the name of the gods you pray to, if you hold their love within your heart ? None at all, I say.",shape=box,color=blue];
		437 -> 440;
		437 -> 441;
	438 [label="Non. I think not.",shape=box,color=blue];
		438 -> 442;
	436 [label="+10 Chemistry",color=orange];
		436 -> 439;
	440 [label="That's a lovely way to look at it. ",shape=box,color=red];
		440 -> 444;
	441 [label="I disagree. Being a kind person doesn't immediately make me a follower of a god of kindness.",shape=box,color=red];
		441 -> 445;
	442 [label="Forgive me, I shall not make a monster out of him simply because you say so.",shape=box,color=blue];
		442 -> 446;
	439 [label="Update boolean MarieEntratiFan1",color=orange];
		439 -> 443;
	444 [label="I believe le Cardinal truly holds the faith of the Luminaries in his soul, even if he does not believe they wait for him in the ever-after.",shape=box,color=blue];
		444 -> 450;
	445 [label="+5 Chemistry",color=orange];
		445 -> 451;
	446 [label="Update boolean MarieEntratiMonster1",color=orange];
		446 -> 452;
	443 [label="Oh ! How it brightens my heart to hear it. I thought I was alone in such regards. I am surrounded by those who think only ill of le Cardinal.",shape=box,color=blue];
		443 -> 447;
		443 -> 448;
		443 -> 449;
	450 [label="For what other man knows the value of empathy against the darkness of Indifférence, non ?",shape=box,color=blue];
		450 -> 456;
	451 [label="You are correct, it does not. I would not call you a Follower of Sol simply because you ignorantly follow His Way. More good in the world betters the world, I care not what name it wears.",shape=box,color=blue];
		451 -> 457;
	452 [label="Chat ends.",color=orange];
	447 [label="I just wish there was a way to get them all to forgive him - he's doing his best to fix things.",shape=box,color=red];
		447 -> 453;
	448 [label="They have their reasons. But he's our only chance at stopping the Indifference.",shape=box,color=red];
		448 -> 454;
	449 [label="Entrati doesn't think too highly of himself, either. ",shape=box,color=red];
		449 -> 455;
	456 [label="Check boolean DrifterFaithNoMITW",color=orange];
		456 -> 462 [label=true,color=green];
		456 -> 461 [label=false,color=brown];
	457 [label="And so I believe le Cardinal to be blessed, even if he does not truly hold the faith by the same name I would give it.",shape=box,color=blue];
		457 -> 450;
	453 [label="Add 1 to Thermostat",color=orange];
		453 -> 458;
	454 [label="Add -1 to Thermostat",color=orange];
		454 -> 459;
	455 [label="Oui, et comme c'est tragique... it makes me weep to think of it. And of Monsieur Loid alone, their love adrift.",shape=box,color=blue];
		455 -> 460;
	462 [label="Forgive me, I forgot... you do not believe your Indifférence is real. Merely a hallucination. But you believe in the emotion of it, oui ?",shape=box,color=blue];
		462 -> 467;
		462 -> 468;
	461 [label="Perfect that he comes to preach the message in counterbalance to that which he unleashed, n'est-ce pas ?",shape=box,color=blue];
		461 -> 464;
		461 -> 465;
		461 -> 466;
	458 [label="Oui, and I think that is the quest upon which we have all been set.",shape=box,color=blue];
		458 -> 460;
	459 [label="Oui, but the battle against l'Indifférence is not won with swords and stones. It is won with the heart, do you not see ?",shape=box,color=blue];
		459 -> 460;
	460 [label="It is not the devil Orokin he wishes us to forgive, non ? It is le Cardinal, that much is clear. And I think it is the love of Monsieur Loid that inspires it.",shape=box,color=blue];
		460 -> 463;
	467 [label="All emotions serve a purpose, even indifference.",shape=box,color=red];
		467 -> 474;
	468 [label="I do. I fell victim to it in Duviri. I let apathy eat away at me until that was all that was left.",shape=box,color=red];
		468 -> 475;
	464 [label="I wish I knew how I could help him fix the problem.",shape=box,color=red];
		464 -> 471;
	465 [label="I wish he had a better plan than \"preach.\"",shape=box,color=red];
		465 -> 472;
	466 [label="Well, seeing as it's his fault that thing is running rampant... yes. It's the least he could do.",shape=box,color=red];
		466 -> 473;
	463 [label="It shatters my heart. I wish for nothing more than to see them reunited !",shape=box,color=blue];
		463 -> 469;
		463 -> 470;
	474 [label="Of course it serves a purpose. Je ne le nie pas.",shape=box,color=blue];
		474 -> 482;
	475 [label="+5 Chemistry",color=orange];
		475 -> 483;
	471 [label="+5 Chemistry",color=orange];
		471 -> 478;
	472 [label="And who are we to judge his methods ? Cardinal Dimanche is a genius, blessed by the Luminaries. He will guide us.",shape=box,color=blue];
		472 -> 479;
		472 -> 480;
	473 [label="Mind your tone. Cardinal Dimanche is a genius, blessed by the Luminaries. He will guide us.",shape=box,color=blue];
		473 -> 481;
		473 -> 479;
		473 -> 480;
