		500 -> 510;
	501 [label="For not believing. In l'Indifférence. In anything at all. If I had created a world du tissu du Néant - from the cloth of the Void - perhaps I would feel the same.",shape=box,color=blue];
		501 -> 510;
	495 [label="+5 Chemistry",color=orange];
		495 -> 490;
	496 [label="I stand beside a devil who has lived for countless centuries. Not far away is a woman who is a machine with the souls of a triple goddess in her own right.",shape=box,color=blue];
		496 -> 505;
	498 [label="Hah! You of all people should know that faith is never wise. Yet souls like ours carry it anyway, though it may burn us. I suspect you know this, if our conversation earlier was the truth.",shape=box,color=blue];
