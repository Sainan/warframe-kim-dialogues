		512 -> 524;
	513 [label="It was a beautiful, sunny afternoon. I remember him standing in front of the altar, gazing up at the stained glass with a smile upon his face, though I knew not why.",shape=box,color=blue];
		513 -> 525;
	532 [label="Seeking to repair the damage one has caused is important, do not mistake me. Where at all possible, to be forgiven by those who have been harmed is a great balm.",shape=box,color=blue];
		532 -> 538;
	533 [label="Oh, I do not mean to say it is not important to seek the forgiveness of those you have harmed ! It is!",shape=box,color=blue];
		533 -> 539;
	526 [label="Speak to me again of those who are \"simply men\" once more and I shall do my level best not to laugh, I give you my word.",shape=box,color=blue];
		526 -> 536;
	528 [label="We carry it because we must. Because we know no other way to be. No matter what it means, in the end. I know how you feel.",shape=box,color=blue];
