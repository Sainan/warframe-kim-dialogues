		524 -> 534;
	525 [label="He crouched low to greet me, so that his head was below mine in my chair.",shape=box,color=blue];
		525 -> 535;
	538 [label="But in the end, when we face the Crone, when Lua sheds her silver tears for us, and death is nigh, it is the weight of our own heart we must carry.",shape=box,color=blue];
