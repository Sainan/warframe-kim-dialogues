digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank3Convo2 begins." [color=orange];
		"MarieRank3Convo2 begins." -> j3102612293;
	j3102612293 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j3102612293 -> j369807617;
	j369807617 [label="Check boolean LoidFamilyComplete",color=orange];
		j369807617 -> j2283929642 [label=true,color=green];
		j369807617 -> j1668831657 [label=false,color=brown];
	j2283929642 [label="I hope you do not think me infirme... but I get the strangest sensation sometimes as though I have done this before ?",shape=box,color=blue];
		j2283929642 -> j3715427701;
	j1668831657 [label="Check boolean MarieFamily1",color=orange];
		j1668831657 -> j3936554108 [label=true,color=green];
		j1668831657 -> j2347049738 [label=false,color=brown];
	j3715427701 [label="Had these conversations... met these people... though it is impossible, non ?",shape=box,color=blue];
		j3715427701 -> j3402498936;
	j3936554108 [label="Will you tell me more of le Cardinal's famille ? I am fascinated to know of his past.",shape=box,color=blue];
		j3936554108 -> j3841711581;
		j3936554108 -> j3195270117;
		j3936554108 -> j242691715;
	j2347049738 [label="Will you tell me of le Cardinal's famille ? I am fascinated to know of his past.",shape=box,color=blue];
		j2347049738 -> j3841711581;
		j2347049738 -> j3195270117;
		j2347049738 -> j242691715;
	j3402498936 [label="+20 Chemistry",color=orange];
		j3402498936 -> j1930388968;
	j3841711581 [label="I'll tell you all I know, but I'm afraid I don't know as much as you might think.",shape=box,color=red];
		j3841711581 -> j3808420072;
	j3195270117 [label="Oh. Sure, but... wouldn't Loid be the better person to talk to?",shape=box,color=red];
		j3195270117 -> j1117745356;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j1930388968 [label="We call it déjà vu. Must be because of the sérum and the time travel. C'est la vie !",shape=box,color=blue];
		j1930388968 -> "Chat ends.";
	j3808420072 [label="Whatever you can tell me, I shall cherish. Promis !",shape=box,color=blue];
		j3808420072 -> j1031135382;
	j1117745356 [label="Speaking of le Cardinal... seems to hurt Monsieur Loid quite deeply. I do not like to do so overmuch.",shape=box,color=blue];
		j1117745356 -> j1031135382;
	"Chat ends." [color=orange];
	j1031135382 [label="Especially as I do it avec une certaine joie, which no one else seems to do.",shape=box,color=blue];
		j1031135382 -> j2627601836;
		j1031135382 -> j3647554769;
	j2627601836 [label="Who do you want to know about?",shape=box,color=red];
		j2627601836 -> j2226009847;
	j3647554769 [label="Well, there's Mother, Father, Son, Daughter, and Grandmother upstairs.",shape=box,color=red];
		j3647554769 -> j2226009847;
	j2226009847 [label="Settle one thing first, will you ? The devil laughs at me every time I ask, as if it is a private joke. Grand-mère. Grandmother.",shape=box,color=blue];
		j2226009847 -> j18688222;
	j18688222 [label="That is not le Cardinal's wife, non ?",shape=box,color=blue];
		j18688222 -> j915074653;
	j915074653 [label="No, that's Father's mother. Mother's mother-in-law.",shape=box,color=red];
		j915074653 -> j2418867625;
	j2418867625 [label="Je... vois. And... why do they not go by their names ? Ne serait-ce pas plus simple ?",shape=box,color=blue];
		j2418867625 -> j1109873819;
		j2418867625 -> j1291327540;
	j1109873819 [label="Do you want the long story?",shape=box,color=red];
		j1109873819 -> j434976151;
	j1291327540 [label="I'll give you the short of it.",shape=box,color=red];
		j1291327540 -> j10244409;
	j434976151 [label="Oui ! I have nowhere else to be for a little while.",shape=box,color=blue];
		j434976151 -> j3708105753;
	j10244409 [label="The family upstairs was trapped here when the Orokin Empire collapsed. Son, Entrati's grandson, let the Infestation in.",shape=box,color=red];
		j10244409 -> j2693509538;
	j3708105753 [label="Well, we are on a moon called Deimos. And a biological bomb was detonated here, long ago, in a desperate attempt to repel the Sentients.",shape=box,color=red];
		j3708105753 -> j4022640158;
	j2693509538 [label="Par Sol ! On purpose ?",shape=box,color=blue];
		j2693509538 -> j2060196651;
	j4022640158 [label="The ones the Orokin were at war with, long ago ? The ones we see in the Dark Refractory with the devil, oui ?",shape=box,color=blue];
		j4022640158 -> j2182736274;
	j2060196651 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j2060196651 -> j1237448132 [label=true,color=green];
		j2060196651 -> j746353514 [label=true,color=green];
		j2060196651 -> j4255342777 [label=false,color=brown];
	j2182736274 [label="Yes. They tried to harness the Infestation to fight the Sentients. But Deimos became overrun. They locked themselves in the Necralisk - which is above us - for shelter.",shape=box,color=red];
		j2182736274 -> j2635482855;
	j1237448132 [label=" No, I think it was an accident. I think he means well.",shape=box,color=red];
		j1237448132 -> j3889035880;
	j746353514 [label="I don't know the truth yet, but I'll reserve judgement until I know more.",shape=box,color=red];
		j746353514 -> j3889035880;
	j4255342777 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j4255342777 -> j1237448132 [label=true,color=green];
		j4255342777 -> j746353514 [label=true,color=green];
		j4255342777 -> j746353514 [label=false,color=brown];
		j4255342777 -> j768470940 [label=false,color=brown];
	j2635482855 [label="Son, Entrati's Grandson, however, was intent on trying to preserve and study the infested animals.",shape=box,color=red];
		j2635482855 -> j3430174897;
	j3889035880 [label="+10 Chemistry",color=orange];
		j3889035880 -> j322530531;
	j768470940 [label="I don't know the truth yet, but he's arrogant, I can tell you that much.",shape=box,color=red];
		j768470940 -> j1726125548;
	j3430174897 [label="Oh, Sol... did he mean well ?",shape=box,color=blue];
		j3430174897 -> j616297335;
	j322530531 [label="Quite kind of you. Continuez, s'il vous plaît.",shape=box,color=blue];
		j322530531 -> j3507898586;
	j1726125548 [label="For shame. I hope that is not true, for his sake and ours. Please continue.",shape=box,color=blue];
		j1726125548 -> j3507898586;
	j616297335 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j616297335 -> j613008289 [label=true,color=green];
		j616297335 -> j429626999 [label=true,color=green];
		j616297335 -> j1097724066 [label=true,color=green];
		j616297335 -> j3220361227 [label=false,color=brown];
	j3507898586 [label="Well, trapped in the Necralisk, and consumed by grief and with no Orokin Empire to rescue them, and now with the Infestation leaking in...",shape=box,color=red];
		j3507898586 -> j994756743;
	j613008289 [label="Yes, I believe he did. I think he honestly cares about the creatures.",shape=box,color=red];
		j613008289 -> j1837585791;
	j429626999 [label="Sadly, it didn't matter, the reckless damage was done.",shape=box,color=red];
		j429626999 -> j132266698;
	j1097724066 [label="No, it was arrogance that inspired him. Even if he claims it was an accident.",shape=box,color=red];
		j1097724066 -> j1726125548;
	j3220361227 [label="Check boolean nil",color=orange];
		j3220361227 -> j613008289 [label=true,color=green];
		j3220361227 -> j429626999 [label=true,color=green];
		j3220361227 -> j1097724066 [label=true,color=green];
		j3220361227 -> j613008289 [label=false,color=brown];
		j3220361227 -> j429626999 [label=false,color=brown];
		j3220361227 -> j2693551455 [label=false,color=brown];
	j994756743 [label="They turned on each other. Ripped each other apart from the inside out. And the Infestation did the rest. Taking their very names from them. ",shape=box,color=red];
		j994756743 -> j58025733;
	j1837585791 [label="+10 Chemistry",color=orange];
		j1837585791 -> j3506244908;
	j132266698 [label="+5 Chemistry",color=orange];
		j132266698 -> j873395152;
	j2693551455 [label="I don't know the truth yet, but he's arrogant, I can tell you that much.",shape=box,color=red];
		j2693551455 -> j1726125548;
	j58025733 [label="It is the ultimate form of cruelty, to be absent of a name...",shape=box,color=blue];
		j58025733 -> j482800561;
	j3506244908 [label="I wonder what he would make of the Cavia... such a pity he cannot meet them...",shape=box,color=blue];
		j3506244908 -> j2812987738;
		j3506244908 -> j1550957560;
	j873395152 [label="If only the purity of one's intentions were all that mattered, the world would be a beautiful place, non ? C'est la vie.",shape=box,color=blue];
		j873395152 -> j1763410179;
	j482800561 [label="Boolean MarieFamily2 is now true.",color=orange];
		j482800561 -> j3320293913;
		j482800561 -> j1844535698;
		j482800561 -> j460586221;
	j2812987738 [label="I'm smiling at the idea. But I don't think it'd be wise.",shape=box,color=red];
		j2812987738 -> j2467828378;
	j1550957560 [label="I hope that'll happen someday. I really do.",shape=box,color=red];
		j1550957560 -> j3948333923;
	j1763410179 [label="Et ensuite ?",shape=box,color=blue];
		j1763410179 -> j3507898586;
	j3320293913 [label="Unless you give it away, like Grandmother.",shape=box,color=red];
		j3320293913 -> j417863788;
	j1844535698 [label="It's honestly not so bad, you get used to it.",shape=box,color=red];
		j1844535698 -> j1049162010;
	j460586221 [label="Animals don't have names, and they seem perfectly happy. We give them names simply for our own sake.",shape=box,color=red];
		j460586221 -> j3129624437;
	j2467828378 [label="And why not ?",shape=box,color=blue];
		j2467828378 -> j1542977062;
		j2467828378 -> j4256342580;
	j3948333923 [label="Add 1 to Family counter",color=orange];
		j3948333923 -> j2139319721;
	j417863788 [label="+5 Chemistry",color=orange];
		j417863788 -> j3032662219;
	j1049162010 [label="Aaah ! Quelle horreur ! I did not mean ! Oh, I am mortified ! I am so sorry, forgive me, I did not mean - oh, I am a fool !",shape=box,color=blue];
		j1049162010 -> j2473582878;
		j1049162010 -> j1525870475;
	j3129624437 [label="+5 Chemistry",color=orange];
		j3129624437 -> j3424203819;
	j1542977062 [label="I'm afraid one half will see the other half as \"the other family.\"",shape=box,color=red];
		j1542977062 -> j3606432815;
	j4256342580 [label="The situation upstairs is... fragile on the best of days. I don't want to upset them.",shape=box,color=red];
		j4256342580 -> j2981857401;
	j2139319721 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j2139319721 -> j2174375645 [label=true,color=green];
		j2139319721 -> j1740816331 [label=false,color=brown];
	j3032662219 [label="Now she sounds like a lady I would adore to meet... ",shape=box,color=blue];
		j3032662219 -> j1176095245;
	j2473582878 [label="How will you make it up to me?",shape=box,color=red];
		j2473582878 -> j3108264214;
	j1525870475 [label="It's all right, I'm only teasing. I'm not upset.",shape=box,color=red];
		j1525870475 -> j2401401464;
	j3424203819 [label="That is quite true ! I never thought of it that way. And you could choose your own. How freeing, in its own sense.",shape=box,color=blue];
		j3424203819 -> j1176095245;
	j3606432815 [label="Add 1 to Family counter",color=orange];
		j3606432815 -> j1663905866;
	j2981857401 [label="You would be surprised how resilient the soul is. And those that surround me now are so very old, so very tempered by time.",shape=box,color=blue];
		j2981857401 -> j2429322934;
	j2174375645 [label="It can be done. Easier, perhaps than you think. We must just think of how. ",shape=box,color=blue];
		j2174375645 -> j3582671429;
		j2174375645 -> j4256342580;
	j1740816331 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j1740816331 -> j2174375645 [label=true,color=green];
		j1740816331 -> j490239373 [label=false,color=brown];
	j1176095245 [label="This has been such a wonderful conversation, but I fear it is my turn to serve luncheon. Monsieur Loid is teaching me how to properly serve tea in his fashion !",shape=box,color=blue];
		j1176095245 -> "Chat ends.";
	j3108264214 [label="Maintenant, vous parlez aussi mal que le diable. No, I will not fall for your tricks.",shape=box,color=blue];
		j3108264214 -> "Chat ends.";
	j2401401464 [label="+5 Chemistry",color=orange];
		j2401401464 -> j1443376586;
	j1663905866 [label="+5 Chemistry",color=orange];
		j1663905866 -> j1870193259;
	j2429322934 [label="+5 Chemistry",color=orange];
		j2429322934 -> j1858114606;
	j3582671429 [label="We just have to be careful. I'm afraid one half will see the other half as \"the other family.\"",shape=box,color=red];
		j3582671429 -> j3606432815;
	j490239373 [label="Oui ? And how goes you or your minuscule copie's work with the famille above ?",shape=box,color=blue];
		j490239373 -> j1958828849;
		j490239373 -> j4256342580;
	j1443376586 [label="Oh, loué soit Sol ! But it does raise the question... Do you know where you received your moniker ? \"Le Drifter ?\"",shape=box,color=blue];
		j1443376586 -> j1639404312;
		j1443376586 -> j779125076;
	j1870193259 [label="Oh... Par Sol, I think you may have solved it !",shape=box,color=blue];
		j1870193259 -> j1104432155;
	j1858114606 [label="You have surprised them many times. Let them surprise you this once.",shape=box,color=blue];
		j1858114606 -> j3687797841;
	j1958828849 [label="Slowly. Carefully. I'm afraid one half will see the other half as the \"other family.\"",shape=box,color=red];
		j1958828849 -> j3606432815;
	j1639404312 [label="I hope I picked it myself.",shape=box,color=red];
		j1639404312 -> j3776600825;
	j779125076 [label="I don't remember, honestly.",shape=box,color=red];
		j779125076 -> j408028419;
	j1104432155 [label="Boolean MarieFamilyOther is now true.",color=orange];
		j1104432155 -> j1572601559;
	j3687797841 [label="But please, please, s'il vous plaît, continue your story. Your little wolf Marie must know her quarry before she properly hunts, non ?",shape=box,color=blue];
		j3687797841 -> j1526043547;
		j3687797841 -> j546542382;
		j3687797841 -> j1122953412;
	j3776600825 [label="How freeing would that be ! To pick one's own name. In the Cathédrale, I could not even pick my own clothes. Hah !",shape=box,color=blue];
		j3776600825 -> j1176095245;
	j408028419 [label="So many mystères, you bring with you ! ",shape=box,color=blue];
		j408028419 -> j1176095245;
	j1572601559 [label="I am beside myself with excitement - je suis assise ici, remuant sur ma chaise !",shape=box,color=blue];
		j1572601559 -> j3687797841;
	j1526043547 [label="Where was I?",shape=box,color=red];
		j1526043547 -> j3285312919;
	j546542382 [label="That was a little wicked of you, wasn't it?",shape=box,color=red];
		j546542382 -> j804003385;
	j1122953412 [label="Perhaps I wish you would hunt me...",shape=box,color=red];
		j1122953412 -> j155417688;
	j3285312919 [label="Son had invited the Animaux Infestés too close.",shape=box,color=blue];
		j3285312919 -> j3507898586;
	j804003385 [label="Peut-être ! But where is the harm in a little wickedness in the name of good, hm ?",shape=box,color=blue];
		j804003385 -> j2735353868;
		j804003385 -> j2457788814;
	j155417688 [label="Boolean DrifterMarie is now true.",color=orange];
		j155417688 -> j3166551294;
	j2735353868 [label="Right... Anyway, back to the story.",shape=box,color=red];
		j2735353868 -> j3507898586;
	j2457788814 [label="Don't take it the wrong way. I enjoyed it.",shape=box,color=red];
		j2457788814 -> j2948408009;
	j3166551294 [label="You are going to ruin me ! I just squeaked audibly and Monsieur Loid asked if I was all right. I had to lie and say that I saw a mouse, only for him to tell me that we have no mice in this time !",shape=box,color=blue];
		j3166551294 -> j2616478708;
	j2948408009 [label="Hah ! I thought you might. Now, enough with your silliness, and back to your story. Son had invited the Animaux Infestés too close, oui ?",shape=box,color=blue];
		j2948408009 -> j3507898586;
	j2616478708 [label="+5 Chemistry",color=orange];
		j2616478708 -> j2189726668;
	j2189726668 [label="Quelle méchanceté, tu es terrible ! Je te déteste et tu me fais rougir maintenant !",shape=box,color=blue];
		j2189726668 -> j2181748506;
		j2189726668 -> j2735353868;
	j2181748506 [label="Are you mad at me?",shape=box,color=red];
		j2181748506 -> j2157375836;
	j2157375836 [label="Non ! Just continue your story !",shape=box,color=blue];
		j2157375836 -> j3507898586;
}