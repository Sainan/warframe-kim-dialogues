		1076 -> 1052 [label=false,color=brown];
		1076 -> 1054 [label=false,color=brown];
	1053 [label="They turned on each other. Ripped each other apart from the inside out. And the Infestation did the rest. Taking their very names from them. ",shape=box,color=red];
		1053 -> 1058;
	1051 [label="Yes, I believe he did. I think he honestly cares about the creatures.",shape=box,color=red];
		1051 -> 1056;
	1052 [label="Sadly, it didn't matter, the reckless damage was done.",shape=box,color=red];
		1052 -> 1057;
	1055 [label="No, it was arrogance that inspired him. Even if he claims it was an accident.",shape=box,color=red];
		1055 -> 1059;
	1054 [label="I don't know the truth yet, but he's arrogant, I can tell you that much.",shape=box,color=red];
		1054 -> 1059;
	1058 [label="It is the ultimate form of cruelty, to be absent of a name...",shape=box,color=blue];
