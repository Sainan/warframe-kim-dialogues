	1060 [label="I wonder what he would make of the Cavia... such a pity he cannot meet them...",shape=box,color=blue];
		1060 -> 1063;
		1060 -> 1064;
	1061 [label="If only the purity of one's intentions were all that mattered, the world would be a beautiful place, non ? C'est la vie.",shape=box,color=blue];
		1061 -> 1065;
	1066 [label="Unless you give it away, like Grandmother.",shape=box,color=red];
