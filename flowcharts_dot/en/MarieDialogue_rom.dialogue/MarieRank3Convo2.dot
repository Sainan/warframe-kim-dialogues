		1021 -> 1024;
	1019 [label="[End.]",shape=box,color=red];
		1019 -> 1022;
	2927 [label="We call it déjà vu. Must be because of the sérum and the time travel. C'est la vie !",shape=box,color=blue];
		2927 -> 2928;
	1023 [label="Whatever you can tell me, I shall cherish. Promis !",shape=box,color=blue];
		1023 -> 1025;
	1024 [label="Speaking of le Cardinal... seems to hurt Monsieur Loid quite deeply. I do not like to do so overmuch.",shape=box,color=blue];
		1024 -> 1025;
	1022 [label="Chat ends.",color=orange];
	2928 [label="Chat ends.",color=orange];
	1025 [label="Especially as I do it avec une certaine joie, which no one else seems to do.",shape=box,color=blue];
		1025 -> 1026;
		1025 -> 1027;
	1026 [label="Who do you want to know about?",shape=box,color=red];
		1026 -> 1028;
	1027 [label="Well, there's Mother, Father, Son, Daughter, and Grandmother upstairs.",shape=box,color=red];
		1027 -> 1028;
	1028 [label="Settle one thing first, will you ? The devil laughs at me every time I ask, as if it is a private joke. Grand-mère. Grandmother.",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="That is not le Cardinal's wife, non ?",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="No, that's Father's mother. Mother's mother-in-law.",shape=box,color=red];
		1030 -> 1031;
	1031 [label="Je... vois. And... why do they not go by their names ? Ne serait-ce pas plus simple ?",shape=box,color=blue];
		1031 -> 1032;
		1031 -> 1033;
	1032 [label="Do you want the long story?",shape=box,color=red];
		1032 -> 1034;
	1033 [label="I'll give you the short of it.",shape=box,color=red];
		1033 -> 1035;
	1034 [label="Oui ! I have nowhere else to be for a little while.",shape=box,color=blue];
		1034 -> 1036;
	1035 [label="The family upstairs was trapped here when the Orokin Empire collapsed. Son, Entrati's grandson, let the Infestation in.",shape=box,color=red];
		1035 -> 1037;
	1036 [label="Well, we are on a moon called Deimos. And a biological bomb was detonated here, long ago, in a desperate attempt to repel the Sentients.",shape=box,color=red];
		1036 -> 1038;
	1037 [label="Par Sol ! On purpose ?",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="The ones the Orokin were at war with, long ago ? The ones we see in the Dark Refractory with the devil, oui ?",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1039 -> 1041 [label=true,color=green];
		1039 -> 1042 [label=true,color=green];
		1039 -> 1042 [label=false,color=brown];
		1039 -> 1043 [label=false,color=brown];
	1040 [label="Yes. They tried to harness the Infestation to fight the Sentients. But Deimos became overrun. They locked themselves in the Necralisk - which is above us - for shelter.",shape=box,color=red];
		1040 -> 1044;
	1041 [label=" No, I think it was an accident. I think he means well.",shape=box,color=red];
		1041 -> 1045;
	1042 [label="I don't know the truth yet, but I'll reserve judgement until I know more.",shape=box,color=red];
		1042 -> 1045;
	1043 [label="I don't know the truth yet, but he's arrogant, I can tell you that much.",shape=box,color=red];
		1043 -> 1046;
	1044 [label="Son, Entrati's Grandson, however, was intent on trying to preserve and study the infested animals.",shape=box,color=red];
		1044 -> 1047;
	1045 [label="+10 Chemistry",color=orange];
		1045 -> 1048;
	1046 [label="For shame. I hope that is not true, for his sake and ours. Please continue.",shape=box,color=blue];
		1046 -> 1049;
	1047 [label="Oh, Sol... did he mean well ?",shape=box,color=blue];
		1047 -> 1076;
	1048 [label="Quite kind of you. Continuez, s'il vous plaît.",shape=box,color=blue];
		1048 -> 1049;
	1049 [label="Well, trapped in the Necralisk, and consumed by grief and with no Orokin Empire to rescue them, and now with the Infestation leaking in...",shape=box,color=red];
		1049 -> 1053;
	1076 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
