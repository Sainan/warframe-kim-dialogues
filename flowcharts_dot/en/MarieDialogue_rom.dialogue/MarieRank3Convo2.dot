	2925 [label="Had these conversations... met these people... though it is impossible, non ?",shape=box,color=blue];
		2925 -> 2926;
	1017 [label="Will you tell me more of le Cardinal's famille ? I am fascinated to know of his past.",shape=box,color=blue];
