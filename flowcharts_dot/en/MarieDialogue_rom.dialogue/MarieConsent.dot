		3985 -> 3575 [label=true,color=green];
		3985 -> 3576 [label=false,color=brown];
	3577 [label="Chat ends.",color=orange];
	3578 [label="Mon cœur, may we speak ? Only for a moment. ",shape=box,color=blue];
		3578 -> 3580;
		3578 -> 3579;
	3576 [label="Chat ends.",color=orange];
	3580 [label="Hi, of course. What's up?",shape=box,color=red];
		3580 -> 3582;
	3579 [label="[End.]",shape=box,color=red];
		3579 -> 3581;
	3582 [label="I simply wished to say that... I know your heart also belongs to another. And while I do not know them, my heart rejoices in this.",shape=box,color=blue];
		3582 -> 3584;
	3581 [label="Update boolean MarieConsentComplete",color=orange];
		3581 -> 3583;
	3584 [label="I trust you, and if they hold a place within your soul, then I am but happy to to share it it with them.",shape=box,color=blue];
		3584 -> 3585;
	3583 [label="Chat ends.",color=orange];
	3585 [label="I simply hope that someday I can have a chance to meet them, oui ? The lover of my lover must, therefore, be mine, too...",shape=box,color=blue];
		3585 -> 3586;
	3586 [label="That is, if you think they would be so inclined.",shape=box,color=blue];
		3586 -> 3587;
		3586 -> 3588;
		3586 -> 3589;
	3587 [label="You may not be their type, honestly.",shape=box,color=red];
		3587 -> 3590;
	3588 [label="They would adore you, Marie. Like I do.",shape=box,color=red];
		3588 -> 3591;
	3589 [label="I really don't think they could resist.",shape=box,color=red];
		3589 -> 3591;
	3590 [label="Pff ! You are terrible, my wolf. Let me have my dreams. Until then, I will have you when I have you, I suppose !",shape=box,color=blue];
		3590 -> 3592;
	3591 [label="Until then, I will have you when I have you. And I will be happy to share you with those who have come to care for you as I have.",shape=box,color=blue];
		3591 -> 3592;
	3592 [label="Someone must stand guard against the Murmure while you are off galivanting and having all the fun, after all !",shape=box,color=blue];
		3592 -> 3593;
	3593 [label="And on that note, duty calls. À la revoyure !",shape=box,color=blue];
		3593 -> 3594;
	3594 [label="Update boolean MarieConsentComplete",color=orange];
		3594 -> 3595;
	3595 [label="Chat ends.",color=orange];
}