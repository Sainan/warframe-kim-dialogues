digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo1 begins." [color=orange];
		"MarieRank1Convo1 begins." -> j752199551;
	j752199551 [label="Bonjour, bonjour, Drifter ! How are you this fine day ? Or evening. I truly do not know what time it is in this place.",shape=box,color=blue];
		j752199551 -> j3217424172;
	j3217424172 [label="I am certain one of these bibelots that Monsieur Loid keeps is a clock, but I cannot for the life of me determine which it is.",shape=box,color=blue];
		j3217424172 -> j575823267;
	j575823267 [label="I fear to touch any device in this strange sanctum. I fully believe I am just as liable to send myself careening into some far-flung distant time as I am to warm a cup of tea.",shape=box,color=blue];
		j575823267 -> j3066524994;
		j575823267 -> j3434089426;
		j575823267 -> j242691715;
	j3066524994 [label="It's probably best not to press any buttons you aren't certain about, no. ",shape=box,color=red];
		j3066524994 -> j3393766703;
	j3434089426 [label="I'm sure you'll be fine.",shape=box,color=red];
		j3434089426 -> j1276117372;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j3393766703 [label="Very good advice, indeed. I have heard from Monsieur Loid that you had your own aventure temporelle. I wonder -",shape=box,color=blue];
		j3393766703 -> j2152956983;
	j1276117372 [label="C'est très gentil de votre part, but... you are not the one who has been thrown into another... ah. Right. Yes !",shape=box,color=blue];
		j1276117372 -> j680433469;
	"Chat ends." [color=orange];
	j2152956983 [label="Was it as dangerous as this one ?",shape=box,color=blue];
		j2152956983 -> j2774070407;
		j2152956983 -> j2419756360;
	j680433469 [label="You would know, wouldn't you. Forgive me. Was your own personal adventure as dangerous as this one ?",shape=box,color=blue];
		j680433469 -> j2774070407;
		j680433469 -> j2419756360;
	j2774070407 [label="The time period? Or my stay there in particular?",shape=box,color=red];
		j2774070407 -> j111867590;
	j2419756360 [label="It was different, but I promise you're safe here.",shape=box,color=red];
		j2419756360 -> j1930843019;
	j111867590 [label="+10 Chemistry",color=orange];
		j111867590 -> j982070711;
	j1930843019 [label="I very much appreciate your rousing vote of confidence, but I do not precisely share it. Especially not when I have such trouble simply discerning the time.",shape=box,color=blue];
		j1930843019 -> j3724771084;
	j982070711 [label="Good to make the distinction. I hardly doubt your experience with the past was \"normal\" by aggregate standards. I certainly hope not, by the tell of it.",shape=box,color=blue];
		j982070711 -> j2709872566;
	j3724771084 [label="One would expect there to be one in the corner of this... \"screen\" here, but there is not ! Mauvaise qualité, if you ask me.",shape=box,color=blue];
		j3724771084 -> j3575712883;
	j2709872566 [label="I meant the \"time period\" itself. Allow me to rephrase -",shape=box,color=blue];
		j2709872566 -> j4164538332;
	j3575712883 [label="Regardless, we have wandered quite far from my question !",shape=box,color=blue];
		j3575712883 -> j4164538332;
	j4164538332 [label="Was this \"past\" era that you traveled to, that is indeed far closer to the \"farther past\" from which I hail, more or less latently dangerous than this time in which we currently find ourselves ?",shape=box,color=blue];
		j4164538332 -> j3990349436;
	j3990349436 [label="(Goodness ! I do love this, I must say it is far more interesting than dusting communionware.)",shape=box,color=blue];
		j3990349436 -> j1383128467;
		j3990349436 -> j3591531957;
		j3990349436 -> j3300737671;
		j3990349436 -> j4268863721;
	j1383128467 [label="I think it's about the same. The weaponry is different and they might not know what they're up against yet, but war is war and death is death.",shape=box,color=red];
		j1383128467 -> j3355359851;
	j3591531957 [label="I think this time is less dangerous. We have more ability to deal with the challenges we're facing. They're just getting started.",shape=box,color=red];
		j3591531957 -> j2328179725;
	j3300737671 [label="I think this time is more dangerous. While we still have the Infested in common, they were dealing with far more rudimentary weaponry.",shape=box,color=red];
		j3300737671 -> j2328179725;
	j4268863721 [label="Honestly, I'm just glad you're enjoying yourself. It can be a lot to adapt to all at once.",shape=box,color=red];
		j4268863721 -> j1105747329;
	j3355359851 [label="+5 Chemistry",color=orange];
		j3355359851 -> j3411516675;
	j2328179725 [label="You may be right. I will think on it. Thank you.",shape=box,color=blue];
		j2328179725 -> "Chat ends.";
	j1105747329 [label="+5 Chemistry",color=orange];
		j1105747329 -> j2321280444;
	j3411516675 [label="Like all things, I suppose it would be relative, non ? The predator that kills us now is just as deadly as that which hunted us then. It just sharpens its teeth.",shape=box,color=blue];
		j3411516675 -> j4059778359;
		j3411516675 -> j1103471228;
	j2321280444 [label="I was prepared for this by le Cardinal Dimanche - your Albrecht Entrati. Unlike my dear Lyon, I believed his words as fact. And unlike Lyon, I see this as our great adventure, not a burden.",shape=box,color=blue];
		j2321280444 -> j1485292009;
	j4059778359 [label="Unless you're Orokin, who found a way to avoid death... in theory, if not in practice.",shape=box,color=red];
		j4059778359 -> j3182581997;
	j1103471228 [label="I'm also happy that you're adapting well to the future.",shape=box,color=red];
		j1103471228 -> j2002399423;
	j1485292009 [label="Service to the Luminaries needn't be an act of suffering. In this, we have always differed.",shape=box,color=blue];
		j1485292009 -> j4240921033;
	j3182581997 [label="And I believe the devil is a perfect example of why death is the greatest gift that Lua has ever given us.",shape=box,color=blue];
		j3182581997 -> j3039520953;
	j2002399423 [label="+5 Chemistry",color=orange];
		j2002399423 -> j2351416248;
	j4240921033 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j4240921033 -> j3678852566;
	j3039520953 [label="Boolean MarieRoathe1 is now true.",color=orange];
		j3039520953 -> j1395510218;
	j2351416248 [label="I was prepared for this by le Cardinal Dimanche - your Albrecht Entrati. Unlike my dear Lyon, I believed his words as fact. And unlike Lyon, I see this as our great adventure, not a burden.",shape=box,color=blue];
		j2351416248 -> j511324148;
	j3678852566 [label="And do not avoid my question, silly ! Which do you think is more dangerous ?",shape=box,color=blue];
		j3678852566 -> j1400904662;
		j3678852566 -> j2494294621;
		j3678852566 -> j612630645;
	j1395510218 [label="Oh ! Now that is the sound of a clock I do recognize, though I still cannot identify where the blasted thing is located. Either way, I fear I must go. This has been delightful. Until we can \"meet\" again ! Aux Dieux !",shape=box,color=blue];
		j1395510218 -> "Chat ends.";
	j511324148 [label="Service to the Luminaries needn't be an act of suffering. In this, we have always differed.",shape=box,color=blue];
		j511324148 -> j3692086785;
	j1400904662 [label="I believe this time is more deadly. We have how many impossible enemies trying to kill us?",shape=box,color=red];
		j1400904662 -> j2328179725;
	j2494294621 [label="I believe our time is less dangerous. They are just discovering new ways of killing each other. Our ways are just a bit more exciting in looks, perhaps.",shape=box,color=red];
		j2494294621 -> j2328179725;
	j612630645 [label="I believe it is probably about equal, in the end. Death is death, isn't it?",shape=box,color=red];
		j612630645 -> j2886084869;
	j3692086785 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j3692086785 -> j1395510218;
	j2886084869 [label="+5 Chemistry",color=orange];
		j2886084869 -> j3582703831;
	j3582703831 [label="Like all things, I suppose it would be relative, no ? The predator that kills us now is just as deadly as that which hunted us then. It just sharpens its teeth.",shape=box,color=blue];
		j3582703831 -> j1325461329;
		j3582703831 -> j4059778359;
	j1325461329 [label="As someone who tries to defend against the wolf, I often find myself exhausted by this.",shape=box,color=red];
		j1325461329 -> j4093782669;
	j4093782669 [label="I think you, my dear Drifter, are more likely to run off to join the pack of wolves than to sit guard against it. And I do mean that as a compliment.",shape=box,color=blue];
		j4093782669 -> j1395510218;
}