digraph {
	0 [label="MarieRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Bonjour, bonjour, Drifter ! How are you this fine day ? Or evening. I truly do not know what time it is in this place.",shape=box,color=blue];
		1 -> 2;
	2 [label="I am certain one of these bibelots that Monsieur Loid keeps is a clock, but I cannot for the life of me determine which it is.",shape=box,color=blue];
		2 -> 3;
	3 [label="I fear to touch any device in this strange sanctum. I fully believe I am just as liable to send myself careening into some far-flung distant time as I am to warm a cup of tea.",shape=box,color=blue];
		3 -> 5;
		3 -> 6;
		3 -> 4;
	5 [label="It's probably best not to press any buttons you aren't certain about, no. ",shape=box,color=red];
		5 -> 8;
	6 [label="I'm sure you'll be fine.",shape=box,color=red];
		6 -> 9;
	4 [label="[End.]",shape=box,color=red];
		4 -> 7;
	8 [label="Very good advice, indeed. I have heard from Monsieur Loid that you had your own aventure temporelle. I wonder -",shape=box,color=blue];
		8 -> 10;
	9 [label="C'est très gentil de votre part, but... you are not the one who has been thrown into another... ah. Right. Yes !",shape=box,color=blue];
		9 -> 11;
	7 [label="Chat ends.",color=orange];
	10 [label="Was it as dangerous as this one ?",shape=box,color=blue];
		10 -> 12;
		10 -> 13;
	11 [label="You would know, wouldn't you. Forgive me. Was your own personal adventure as dangerous as this one ?",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="The time period? Or my stay there in particular?",shape=box,color=red];
		12 -> 14;
	13 [label="It was different, but I promise you're safe here.",shape=box,color=red];
		13 -> 15;
	14 [label="+10 Chemistry",color=orange];
		14 -> 16;
	15 [label="I very much appreciate your rousing vote of confidence, but I do not precisely share it. Especially not when I have such trouble simply discerning the time.",shape=box,color=blue];
		15 -> 17;
	16 [label="Good to make the distinction. I hardly doubt your experience with the past was \"normal\" by aggregate standards. I certainly hope not, by the tell of it.",shape=box,color=blue];
		16 -> 18;
	17 [label="One would expect there to be one in the corner of this... \"screen\" here, but there is not ! Mauvaise qualité, if you ask me.",shape=box,color=blue];
		17 -> 19;
	18 [label="I meant the \"time period\" itself. Allow me to rephrase -",shape=box,color=blue];
		18 -> 20;
	19 [label="Regardless, we have wandered quite far from my question !",shape=box,color=blue];
		19 -> 20;
	20 [label="Was this \"past\" era that you traveled to, that is indeed far closer to the \"farther past\" from which I hail, more or less latently dangerous than this time in which we currently find ourselves ?",shape=box,color=blue];
		20 -> 21;
	21 [label="(Goodness ! I do love this, I must say it is far more interesting than dusting communionware.)",shape=box,color=blue];
		21 -> 22;
		21 -> 23;
		21 -> 24;
		21 -> 25;
	22 [label="I think it's about the same. The weaponry is different and they might not know what they're up against yet, but war is war and death is death.",shape=box,color=red];
		22 -> 26;
	23 [label="I think this time is less dangerous. We have more ability to deal with the challenges we're facing. They're just getting started.",shape=box,color=red];
		23 -> 27;
	24 [label="I think this time is more dangerous. While we still have the Infested in common, they were dealing with far more rudimentary weaponry.",shape=box,color=red];
		24 -> 27;
	25 [label="Honestly, I'm just glad you're enjoying yourself. It can be a lot to adapt to all at once.",shape=box,color=red];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="You may be right. I will think on it. Thank you.",shape=box,color=blue];
		27 -> 30;
	28 [label="+5 Chemistry",color=orange];
		28 -> 31;
	29 [label="Like all things, I suppose it would be relative, non ? The predator that kills us now is just as deadly as that which hunted us then. It just sharpens its teeth.",shape=box,color=blue];
		29 -> 32;
		29 -> 33;
	30 [label="Chat ends.",color=orange];
	31 [label="I was prepared for this by le Cardinal Dimanche - your Albrecht Entrati. Unlike my dear Lyon, I believed his words as fact. And unlike Lyon, I see this as our great adventure, not a burden.",shape=box,color=blue];
		31 -> 34;
	32 [label="Unless you're Orokin, who found a way to avoid death... in theory, if not in practice.",shape=box,color=red];
		32 -> 35;
	33 [label="I'm also happy that you're adapting well to the future.",shape=box,color=red];
		33 -> 36;
	34 [label="Service to the Luminaries needn't be an act of suffering. In this, we have always differed.",shape=box,color=blue];
		34 -> 37;
	35 [label="And I believe the devil is a perfect example of why death is the greatest gift that Lua has ever given us.",shape=box,color=blue];
		35 -> 38;
	36 [label="+5 Chemistry",color=orange];
		36 -> 39;
	37 [label="Update boolean MarieLyonSuffering1",color=orange];
		37 -> 40;
	38 [label="Update boolean MarieRoathe1",color=orange];
		38 -> 41;
	39 [label="I was prepared for this by le Cardinal Dimanche - your Albrecht Entrati. Unlike my dear Lyon, I believed his words as fact. And unlike Lyon, I see this as our great adventure, not a burden.",shape=box,color=blue];
		39 -> 42;
	40 [label="And do not avoid my question, silly ! Which do you think is more dangerous ?",shape=box,color=blue];
		40 -> 43;
		40 -> 44;
		40 -> 45;
	41 [label="Oh ! Now that is the sound of a clock I do recognize, though I still cannot identify where the blasted thing is located. Either way, I fear I must go. This has been delightful. Until we can \"meet\" again ! Aux Dieux !",shape=box,color=blue];
		41 -> 46;
	42 [label="Service to the Luminaries needn't be an act of suffering. In this, we have always differed.",shape=box,color=blue];
		42 -> 47;
	43 [label="I believe this time is more deadly. We have how many impossible enemies trying to kill us?",shape=box,color=red];
		43 -> 48;
	44 [label="I believe our time is less dangerous. They are just discovering new ways of killing each other. Our ways are just a bit more exciting in looks, perhaps.",shape=box,color=red];
		44 -> 48;
	45 [label="I believe it is probably about equal, in the end. Death is death, isn't it?",shape=box,color=red];
		45 -> 49;
	46 [label="Chat ends.",color=orange];
	47 [label="Update boolean MarieLyonSuffering1",color=orange];
		47 -> 41;
	48 [label="You may be right. I will think on it. Thank you.",shape=box,color=blue];
		48 -> 50;
	49 [label="+5 Chemistry",color=orange];
		49 -> 51;
	50 [label="Chat ends.",color=orange];
	51 [label="Like all things, I suppose it would be relative, no ? The predator that kills us now is just as deadly as that which hunted us then. It just sharpens its teeth.",shape=box,color=blue];
		51 -> 52;
		51 -> 53;
	52 [label="As someone who tries to defend against the wolf, I often find myself exhausted by this.",shape=box,color=red];
		52 -> 54;
	53 [label="Unless you're Orokin, who found a way to avoid death... in theory, if not in practice.",shape=box,color=red];
		53 -> 55;
	54 [label="I think you, my dear Drifter, are more likely to run off to join the pack of wolves than to sit guard against it. And I do mean that as a compliment.",shape=box,color=blue];
		54 -> 41;
	55 [label="And I believe the devil is a perfect example of why death is the greatest gift that Lua has ever given us.",shape=box,color=blue];
		55 -> 56;
	56 [label="Update boolean MarieRoathe1",color=orange];
		56 -> 41;
}