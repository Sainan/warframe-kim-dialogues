digraph {
	735 [label="MarieRank2Convo5 begins.",color=orange];
		735 -> 736;
	736 [label="Evaluate expressions",color=orange];
		736 -> 739 [label="MarieOtak1",color=purple];
		736 -> 738 [label="MarieFamily1",color=purple];
		736 -> 737 [label="false",color=purple];
	739 [label="I have been thinking of what you told me regarding Monsieur Otak.",shape=box,color=blue];
		739 -> 743;
	738 [label="I have been thinking of what you told me regarding le Cardinal's family.",shape=box,color=blue];
		738 -> 742;
	737 [label="I come with a question regarding Monsieur \"Necraloid\" again, if I may?",shape=box,color=blue];
		737 -> 741;
		737 -> 740;
	743 [label="I was wondering perhaps if it is similar to a story of mine own. Might I tell it to you, if you have the time ?",shape=box,color=blue];
		743 -> 749;
		743 -> 748;
	742 [label="I was wondering, would you tell me the story of Otak, the childlike face upon the back of Necraloid's skull?",shape=box,color=blue];
		742 -> 747;
		742 -> 746;
	741 [label="Yes of course, what is it?",shape=box,color=red];
		741 -> 745;
	740 [label="[End.]",shape=box,color=red];
		740 -> 744;
	749 [label="Go ahead.",shape=box,color=red];
		749 -> 754;
	748 [label="[End.]",shape=box,color=red];
		748 -> 753;
	747 [label="Sure.",shape=box,color=red];
		747 -> 752;
	746 [label="Maybe later. [End.]",shape=box,color=red];
		746 -> 751;
	745 [label="I find myself curious as to why there is another face upon his back that resembles a child's scrawl.",shape=box,color=blue];
		745 -> 750;
	744 [label="Chat ends.",color=orange];
	754 [label="There was a Sister at the Cathédrale, who once lost herself in the hallways of her past. Sister Cécilia.",shape=box,color=blue];
		754 -> 757;
	753 [label="Chat ends.",color=orange];
	752 [label="By all accounts he was a genius, and the mind behind the harnessing of argon crystals.",shape=box,color=red];
		752 -> 756;
	751 [label="Chat ends.",color=orange];
	750 [label="I inquired with Monsieur Necraloid and Monsieur Loid both, and neither wished to speak of it, they only told me a name. Otak. And it was with great sadness that they uttered it.",shape=box,color=blue];
		750 -> 755;
	757 [label="She used to stand before the great clock in the hall and proclaim that it was two in the afternoon, but she did not know what time it was.",shape=box,color=blue];
		757 -> 761;
	756 [label="Which are harnessed from the Void - they're the reason we can create a lot of the powerful warframes and weapons we make.",shape=box,color=red];
		756 -> 760;
	755 [label="So here I am, speaking with you, in hopes you might be able to aid me.",shape=box,color=blue];
		755 -> 758;
		755 -> 759;
	761 [label="We would find all the paintings in the hallways turned about the wrong way, and she would say they were whispering to her of terrible plots.",shape=box,color=blue];
		761 -> 766;
	760 [label="He specialized in crystallography. And his works were archived here, in the laboratories.",shape=box,color=red];
		760 -> 765;
	758 [label="Do you want to know about Otak? Or why you can't talk to him?",shape=box,color=red];
		758 -> 762;
	759 [label="Otak is hard to explain...",shape=box,color=red];
		759 -> 2919;
	766 [label="We learned she was simply hearing conversations in other rooms, and thinking it was the paintings that were speaking...",shape=box,color=blue];
		766 -> 770;
	765 [label="For some reason, I don't know why, he was turned into a Cephalon, and given his own necraloid shell.",shape=box,color=red];
		765 -> 769;
	762 [label="I believe I wish to know both, in time, but I will let you decide where to begin. I do not know which is more important, après tout.",shape=box,color=blue];
		762 -> 2919;
	2919 [label="Check boolean LoidFamilyComplete",color=orange];
		2919 -> 764 [label=true,color=green];
		2919 -> 764 [label=false,color=brown];
		2919 -> 763 [label=false,color=brown];
	770 [label="Once, she mistook all the cushions of a lounge for children, and hosted them all for tea...",shape=box,color=blue];
		770 -> 774;
	769 [label="Not all Cephalons were made as a punishment. But things went... poorly here on Deimos, and he was badly damaged.",shape=box,color=red];
		769 -> 773;
	764 [label="Otak used to be an Archimedean, an Orokin scientist and academic. What's happened to him isn't exactly the happiest story.",shape=box,color=red];
		764 -> 768;
	763 [label="Well... in short, some of Entrati's family is upstairs, and they aren't... exactly aware that we're down here.",shape=box,color=red];
		763 -> 767;
	774 [label="When I came into the room, she looked up at me and said, \"Oh, Sister Odette, there you are! The children from the orphanage are here, will you join me?\"",shape=box,color=blue];
		774 -> 777;
		774 -> 778;
	773 [label="+5 Chemistry",color=orange];
		773 -> 776;
	768 [label="Update boolean MarieOtak1",color=orange];
		768 -> 772;
	767 [label="Update boolean MarieFamily1",color=orange];
		767 -> 771;
	777 [label="What did you do?",shape=box,color=red];
		777 -> 781;
	778 [label="Who was Sister Odette?",shape=box,color=red];
		778 -> 782;
	776 [label="Pauvre petit...",shape=box,color=blue];
		776 -> 780;
	772 [label="Par les Luminaires... please, go on.",shape=box,color=blue];
		772 -> 752;
	771 [label="Par les Luminaires... You mean that we are all down here in secret ?! Is that why we are not allowed to leave this place ?! Mais pourquoi ?!",shape=box,color=blue];
		771 -> 775;
	781 [label="I rolled my chair up to an empty spot at the table and had tea with her and the cushions, what else could I do ?",shape=box,color=blue];
		781 -> 787;
	782 [label="Sister Odette had been dead for thirty years, I am afraid to say.",shape=box,color=blue];
		782 -> 788;
	780 [label="So, he was transferred to the main necraloid - the only Necraloid that remains - and is... well? It's hard to explain.",shape=box,color=red];
		780 -> 784;
		780 -> 785;
		780 -> 786;
	775 [label="His daughter, Euleria - known as Mother, and her family, have been taking care of Deimos this whole time.",shape=box,color=red];
		775 -> 779;
	787 [label="How we laughed together, as she told me stories from her past. Stories Sister Cécilia had never told anyone before, at least that I am aware.",shape=box,color=blue];
		787 -> 791;
	788 [label="I rolled my chair up to an empty spot at the table and had tea with her and the cushions.",shape=box,color=blue];
		788 -> 787;
	784 [label="I just wish we could fix him, honestly. Bring back the real Otak.",shape=box,color=red];
		784 -> 754;
	785 [label="He makes me smile. He's funny, but it hides something tragic and broken.",shape=box,color=red];
		785 -> 754;
	786 [label="Sadly, he's not fixable. And I think he grates on a lot of nerves. ",shape=box,color=red];
		786 -> 754;
	779 [label="Watching over this place, and the heart that pumps Void energy into the Origin System, keeping all of us... usable, really, ever since Entrati left.",shape=box,color=red];
		779 -> 783;
	791 [label="Her eyes were bright in moments but dull in others, like a child's doll...",shape=box,color=blue];
		791 -> 794;
		791 -> 795;
		791 -> 796;
		791 -> 797;
	783 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		783 -> 789 [label=true,color=green];
		783 -> 790 [label=false,color=brown];
	794 [label="Why did you sit with her?",shape=box,color=red];
		794 -> 800;
	795 [label="What happened to Sister Cécilia?",shape=box,color=red];
		795 -> 801;
	796 [label="I hope it meant something to her, that you were there.",shape=box,color=red];
		796 -> 802;
	797 [label="That was kind of you, to sit with her.",shape=box,color=red];
		797 -> 803;
	789 [label="She's come to terms with his absence, and they've made peace with each other, but it was a hard-won thing.",shape=box,color=red];
		789 -> 792;
	790 [label="She hasn't come to terms with his absence, and they're at each other's throats.",shape=box,color=red];
		790 -> 793;
	800 [label="+15 Chemistry",color=orange];
		800 -> 806;
	801 [label="What happens to all in her condition. She continued to fade, like a painting in the sun, until nothing was left. ",shape=box,color=blue];
		801 -> 807;
	802 [label="+10 Chemistry",color=orange];
		802 -> 808;
	803 [label="+5 Chemistry",color=orange];
		803 -> 809;
	792 [label="Knowing that he's still out there, running amok, and that he hasn't said a word to her, or even sent a letter...?",shape=box,color=red];
		792 -> 798;
	793 [label="Knowing that he's still out there, running amok, and that he hasn't said a word to her, or even sent a letter...?",shape=box,color=red];
		793 -> 799;
	806 [label="A wise question. A very wise question. I think many reasons inspired me. I would like to think it kindness that sent me to her table.",shape=box,color=blue];
		806 -> 812;
	807 [label="Then she left us, and we held a candlelit vigil for her. I would hope she could remember, in the end, those who were truly kind to her. ",shape=box,color=blue];
		807 -> 813;
	808 [label="I would like to believe that she understood, somewhere beneath the surface.",shape=box,color=blue];
		808 -> 813;
	809 [label="Was it kindness, though ? Or was it guilt that inspired me to do it ? Ah, but you are only being kind yourself, by saying so. ",shape=box,color=blue];
		809 -> 813;
	798 [label="I can't imagine how painful that would be for her. For them.",shape=box,color=red];
		798 -> 804;
	799 [label="It would destroy what little chance of reconciliation they might have.",shape=box,color=red];
		799 -> 805;
	812 [label="But I think it was guilt, perhaps, deep down. That if I did not, I would be neglecting her. Like one might neglect a child.",shape=box,color=blue];
		812 -> 813;
	813 [label="I would like to believe that your Otak knows those who are kind and patient with him. But, then again, he is not really there, is he ?",shape=box,color=blue];
		813 -> 817;
	804 [label="While I can see the logic behind the decision to protect them from the pain le Cardinal has caused by his necessary departure...",shape=box,color=blue];
		804 -> 810;
	805 [label="+10 Chemistry",color=orange];
		805 -> 811;
	817 [label="I am speaking of a very elaborate piece of technology made to resemble a man, am I not ? A phonographe, many many times more complex. Like Necraloid, he has no soul.",shape=box,color=blue];
		817 -> 822;
		817 -> 823;
		817 -> 824;
		817 -> 825;
		817 -> 826;
	810 [label="I do think it needlessly cruel, don't you ? They might think him dead. Or worse ! And we, living here, comme des rats d'égout ?",shape=box,color=blue];
		810 -> 814;
		810 -> 815;
	811 [label="Oui... I see the logic. I would work to mend their family, if you can, then, non ? It seems to be the only hope any of us have to get out of this place. ",shape=box,color=blue];
		811 -> 816;
	822 [label="Necraloid may not have a soul, but he's unique. Other Cephalons, like Otak, do. They were destroyed in how they were made.",shape=box,color=red];
		822 -> 831;
	823 [label="You're right. So what would you have me do about it?",shape=box,color=red];
		823 -> 832;
	824 [label="You're right. They don't. But it doesn't mean we can go around treating them poorly.",shape=box,color=red];
		824 -> 833;
	825 [label="I don't know if you're right or not. But they can still think, and feel, and we can't treat them like things.",shape=box,color=red];
		825 -> 834;
	826 [label="Necraloid has a soul. All Cephalons do.",shape=box,color=red];
		826 -> 835;
	814 [label="It's not really my decision to make.",shape=box,color=red];
		814 -> 818;
	815 [label="I actually have a friend who loves rats. I think they're adorable.",shape=box,color=red];
		815 -> 819;
	816 [label="Lest we spend the rest of our lives trapped living here, comme des rats d'égout. ",shape=box,color=blue];
		816 -> 820;
		816 -> 821;
	831 [label="Update boolean MarieCephalonSoul",color=orange];
		831 -> 839;
	832 [label="Update boolean MarieCephalonNoSoul",color=orange];
		832 -> 840;
	833 [label="Update boolean MarieCephalonNoSoul",color=orange];
		833 -> 841;
	834 [label="Update boolean MarieCephalonUnsure",color=orange];
		834 -> 842;
	835 [label="Update boolean MarieCephalonSoul",color=orange];
		835 -> 843;
	818 [label="I know. It is Monsieur Loid's, and everyone else's decision, to make themselves known.",shape=box,color=blue];
		818 -> 827;
	819 [label="+15 Chemistry",color=orange];
		819 -> 828;
	820 [label="I've been remiss. You're right. I'll get to work.",shape=box,color=red];
		820 -> 829;
	821 [label="I actually have a friend who loves rats. I think they're adorable. ",shape=box,color=red];
		821 -> 830;
	839 [label="+5 Chemistry",color=orange];
		839 -> 845;
	840 [label="Oh, do not think I mean for you to be cruel ! Non ! Treasure them, for they are precious, and through no fault of their own are they as they are !",shape=box,color=blue];
		840 -> 846;
	841 [label="+5 Chemistry",color=orange];
		841 -> 840;
	842 [label="+5 Chemistry",color=orange];
		842 -> 847;
	843 [label="+5 Chemistry",color=orange];
		843 -> 848;
	827 [label="I would suggest that it is a sense of guilt, not nobility, that keeps us down here.",shape=box,color=blue];
		827 -> 836;
	828 [label="And I would love to meet them some day, but that is hardly the point I am making, silly wolf.",shape=box,color=blue];
		828 -> 827;
	829 [label="+5 Chemistry",color=orange];
		829 -> 837;
	830 [label="+5 Chemistry",color=orange];
		830 -> 838;
	845 [label="More proof that the devil and his ilk were right to be condemned. But, perhaps you are right about Otak and his kind, or perhaps it brings you peace to believe so.",shape=box,color=blue];
		845 -> 850;
	846 [label="My heart breaks only for the broken bodies the Orokin devils left behind. They were not gods, but devourers of all in their wake. Look only at the one we travel with for proof.",shape=box,color=blue];
		846 -> 851;
	847 [label="Perhaps you are right, but I do not think the Orokin devils knew more of the workings of the soul than we. They were no great gods.",shape=box,color=blue];
		847 -> 852;
	848 [label="Perhaps you are right, or perhaps it brings you peace to believe so.",shape=box,color=blue];
		848 -> 851;
	836 [label="That we hide some great and terrible sin.",shape=box,color=blue];
		836 -> 844;
	837 [label="Thank you. I do not know if you will succeed, but sometimes, we can only help but to try.",shape=box,color=blue];
		837 -> 827;
	838 [label="And I would love to meet them some day, but that is hardly the point I am making, silly wolf.",shape=box,color=blue];
		838 -> 827;
	850 [label="Either way, I choose to believe that the Otak who died long ago would smile upon you now, should you be kind to whatever lives on in his memory.",shape=box,color=blue];
		850 -> 2920;
	851 [label="It is simply hard for me to say Necraloid has a soul when Loid is standing right beside him, oui ?",shape=box,color=blue];
		851 -> 850;
	852 [label="Technology, perhaps - science, yes - but the soul ? They hardly could master their own hearts ! Look to the devil we travel with if you need more proof of that.",shape=box,color=blue];
		852 -> 851;
	844 [label="And it is that sin that must be forgiven.",shape=box,color=blue];
		844 -> 849;
	2920 [label="Check boolean LoidFamilyComplete",color=orange];
		2920 -> 2921 [label=true,color=green];
		2920 -> 854 [label=false,color=brown];
	849 [label="Thank you, you have given me much to think on. À la revoyure.",shape=box,color=blue];
		849 -> 853;
	2921 [label="I must go. But, merci. I have much to think on.",shape=box,color=blue];
		2921 -> 2922;
	854 [label="I simply hope I get to meet whatever strange fac-similé lives on when Monsieur Necraloid wanders upstairs again, someday.",shape=box,color=blue];
		854 -> 855;
		854 -> 856;
	853 [label="Chat ends.",color=orange];
	2922 [label="Chat ends.",color=orange];
	855 [label="I'm not sure if it's wise to go meddling in other people's affairs.",shape=box,color=red];
		855 -> 857;
	856 [label="I hope someday we can tell the Entrati Family the truth. And sooner, rather than later. ",shape=box,color=red];
		856 -> 857;
	857 [label="Check boolean MarieFamily1",color=orange];
		857 -> 858 [label=true,color=green];
		857 -> 859 [label=false,color=brown];
	858 [label="We shall see, I want to learn more of the specifics from you as to why we must remain.",shape=box,color=blue];
		858 -> 860;
	859 [label="There is a story I think you are not telling me. But I think there has been enough of stories for one day, oui ?",shape=box,color=blue];
		859 -> 860;
	860 [label="We will speak more of the Entrati family again very soon.",shape=box,color=blue];
		860 -> 147;
