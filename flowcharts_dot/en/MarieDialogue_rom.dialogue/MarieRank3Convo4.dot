	j175852490 [label="Ah ! Yes.",shape=box,color=blue];
		j175852490 -> j2888020798;
	j907251828 [label="Do not mind me, I am just having a bit of fun. Silly little Marie la révolutionnaire.",shape=box,color=blue];
