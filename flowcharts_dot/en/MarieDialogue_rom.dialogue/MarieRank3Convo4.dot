		j242691715 -> "Chat ends.";
	j674156595 [label="He was telling me about his youth. Ai-je fait quelque chose qui vous a offensé ?",shape=box,color=blue];
		j674156595 -> j1109443040;
		j674156595 -> j2920487442;
	j2650810591 [label="I do not understand. Ai-je fait quelque chose qui vous avez offensé ?",shape=box,color=blue];
		j2650810591 -> j1109443040;
		j2650810591 -> j2920487442;
	j3685313169 [label="Archimedeans - were they Orokin ? Or were they not ? The word gets used with such frivolity.",shape=box,color=blue];
		j3685313169 -> j649490114;
	"Chat ends." [color=orange];
	j1109443040 [label="I guess I'm just... jealous.",shape=box,color=red];
		j1109443040 -> j4227016362;
	j2920487442 [label="I guess I'm just... surprised.",shape=box,color=red];
		j2920487442 -> j1010099276;
	j649490114 [label="I could ask the devil, I suppose. But I do not like to talk to him if I can help it.",shape=box,color=blue];
		j649490114 -> j2556414069;
		j649490114 -> j863454030;
	j4227016362 [label="De la jalousie ? Pourquoi ?",shape=box,color=blue];
		j4227016362 -> j2966120716;
	j1010099276 [label="Pourquoi ?",shape=box,color=blue];
		j1010099276 -> j2237609168;
		j1010099276 -> j3812540503;
	j2556414069 [label="No, Archimedeans were a rank below the Orokin.",shape=box,color=red];
		j2556414069 -> j3018428694;
	j863454030 [label="Orokin Empire is called that because the Orokin ran it, but the Orokin was also just the name of the ruling class.",shape=box,color=red];
		j863454030 -> j3018428694;
	j2966120716 [label="+10 Chemistry",color=orange];
		j2966120716 -> j2997233729;
	j2237609168 [label="I'm just a little taken aback you know more about him now than I do.",shape=box,color=red];
		j2237609168 -> j2966120716;
	j3812540503 [label="I don't know anything about Loid's past, and I've known him for a while.",shape=box,color=red];
		j3812540503 -> j2966120716;
	j3018428694 [label="This happens a lot. You're not alone.",shape=box,color=red];
		j3018428694 -> j431440574;
	j2997233729 [label="Oh ! Do not take it personally, s'il vous plaît !",shape=box,color=blue];
		j2997233729 -> j2068312749;
	j431440574 [label="Did the Orokin purposefully make their society confusing and obtuse ?",shape=box,color=blue];
		j431440574 -> j3625677585;
		j431440574 -> j1840121062;
		j431440574 -> j107314503;
	j2068312749 [label="Monsieur Loid is, what is the word, distant ?",shape=box,color=blue];
		j2068312749 -> j647464481;
		j2068312749 -> j1804977012;
	j3625677585 [label="Thousands of years of being in charge, and people get... bored. Bored people make complicated systems.",shape=box,color=red];
		j3625677585 -> j4097027666;
	j1840121062 [label="They had a taste for the ornate and the intricate. It extended to bureaucracy.",shape=box,color=red];
		j1840121062 -> j4097027666;
	j107314503 [label="Honestly? I'm starting to think so.",shape=box,color=red];
		j107314503 -> j4097027666;
	j647464481 [label="I don't know anything about him, really.",shape=box,color=red];
		j647464481 -> j2844830077;
	j1804977012 [label="He's a bit aloof, yes.",shape=box,color=red];
		j1804977012 -> j2844830077;
	j4097027666 [label="+10 Chemistry",color=orange];
		j4097027666 -> j4144166336;
	j2844830077 [label="Look at with whom I spend my time with, oui ? Learn to read one statue and it is not too hard to learn to read another.",shape=box,color=blue];
		j2844830077 -> j860820508;
	j4144166336 [label="I think they did it just to be annoying !",shape=box,color=blue];
		j4144166336 -> j1451255618;
	j860820508 [label="+10 Chemistry",color=orange];
		j860820508 -> j2568061881;
	j1451255618 [label="Et ils se demandent pourquoi des rébellions éclatent. Vous aviez peut-être vos warframes, mais nous avions nos guillotines !",shape=box,color=blue];
		j1451255618 -> j3566713005;
	j2568061881 [label="Though I admit Monsieur Loid is a bit more... piquant than dear Lyon.",shape=box,color=blue];
		j2568061881 -> j2821777160;
