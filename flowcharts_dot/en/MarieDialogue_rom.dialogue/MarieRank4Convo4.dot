	2353 [label="And what you said hurt him just as much.",shape=box,color=red];
		2353 -> 2363;
	2354 [label="I'm honestly on your side, but... we have to try to keep the peace, Marie.",shape=box,color=red];
		2354 -> 2364;
		2354 -> 2365;
	2355 [label="Marie, please. I'm not trying to fight. I'm just trying to get you to understand what they've been through.",shape=box,color=red];
		2355 -> 2366;
	2356 [label="If Entrati stuck around to help clean up after his own messes, he might have more friends in this world.",shape=box,color=red];
		2356 -> 2367;
	2357 [label="Marie, please. I'm not trying to fight. I'm just trying to get you to understand what they've been through.",shape=box,color=red];
		2357 -> 2366;
	2358 [label="Yes, I am taking his side. Because you're not listening to reason. You have to understand \"le Cardinal\" is not what he seems.",shape=box,color=red];
		2358 -> 2366;
	2359 [label="Has this been some great deception of yours ? Have you been playing un jeu with little Marie ?",shape=box,color=blue];
		2359 -> 2368;
		2359 -> 2369;
	2361 [label="It matters if there's nobody left around us when we're on the other side of this. They've been through a lot.",shape=box,color=red];
		2361 -> 2366;
	2362 [label="I'm sure he'll forget about it. I'm sure you will, too.",shape=box,color=red];
		2362 -> 2371;
	2360 [label="All of us have been abandoned by him ! Tell me, how are they so much more wronged, that I must tolerate such hate ?!",shape=box,color=blue];
		2360 -> 2370;
	2363 [label="Oui ?! Then tell me why !",shape=box,color=blue];
		2363 -> 2350;
	2364 [label="The situation that the Cavia have been through has been... hard.",shape=box,color=red];
		2364 -> 2350;
	2365 [label="They're animals, even if they've been given intelligence, they're still animals. There's only so much they're capable of.",shape=box,color=red];
		2365 -> 2372;
	2366 [label="Oui ? Then do play the role of La Lumière Sacrée de Sol and banish the darkness ! Enlighten little foolish Marie !",shape=box,color=blue];
		2366 -> 2350;
	2367 [label="Oui ! Yes, it is not good enough that he is attempting to save the known universe from a god of the Void, non ?!",shape=box,color=blue];
