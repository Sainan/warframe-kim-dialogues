	j1368624670 [label="That is what the Cavia were to Entrati. Disposable. \"Tagfer?\" It means \"Tag For Disposal.\"",shape=box,color=red];
		j1368624670 -> j3933770226;
	j2051332121 [label="Used in a Void experiment. Survivors in a long line of dead animals. Never intended to exist.",shape=box,color=red];
		j2051332121 -> j2334629120;
	j3933770226 [label="The last of his kind. Tag For Disposal. His mate? Minn? The only other one left? Died in the experiment.",shape=box,color=red];
		j3933770226 -> j4109125800;
	j2334629120 [label="It's only because of Loid that they're still alive. He preserved them because he couldn't bring himself to euthanize them \"per Entrati's instructions.\"",shape=box,color=red];
		j2334629120 -> j3933426006;
	j4109125800 [label="That's why he was mad, Marie. That's why he hates Entrati. And why he probably always will.",shape=box,color=red];
		j4109125800 -> j2433363310;
	j3933426006 [label="Oh, and Tagfer? He's the last of his kind. His mate, Minn? The only other one left? Died in the experiment.",shape=box,color=red];
		j3933426006 -> j2339498702;
