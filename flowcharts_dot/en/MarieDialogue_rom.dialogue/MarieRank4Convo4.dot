		2346 -> 2352;
		2346 -> 2353;
		2346 -> 2354;
	2347 [label="If this is the welcome le Cardinal looks forward to enjoying upon his return, it is no wonder he stays away !",shape=box,color=blue];
		2347 -> 2355;
		2347 -> 2356;
	2348 [label="And I am certain you take M'sieur Tagfer's side in all this, non ? You believe le Cardinal to be a monster just the same as the beast does.",shape=box,color=blue];
		2348 -> 2357;
		2348 -> 2358;
	2349 [label="I am surprised, je pensais que tu étais de mon côté ! Were you not joining me in championing le Cardinal's cause but a moment ago ?",shape=box,color=blue];
		2349 -> 2359;
	2351 [label="What does it matter, as you said before ? We are to serve him in his deeds and judge him later. This fight is meaningless, non ?",shape=box,color=blue];
		2351 -> 2361;
		2351 -> 2362;
	2350 [label="I know they were made by the Void at le Cardinal's hands. All of us have been given gifts by le Cardinal that are a curse if viewed with a broken heart !",shape=box,color=blue];
		2350 -> 2360;
	2352 [label="And do you know how deeply yours did? Do you know their whole story?",shape=box,color=red];
