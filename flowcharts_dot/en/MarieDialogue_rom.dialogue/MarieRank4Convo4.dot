		j1639327012 -> j516809325 [label="false",color=purple];
	j1176667549 [label="If you are attempting to inspire me to sympathize instead with them and turn my wrath upon you, I am suddenly tempted.",shape=box,color=blue];
		j1176667549 -> j568183550;
	j568183550 [label="Perhaps it is best we adjourn here. Before tempers get the best of all of us.",shape=box,color=blue];
		j568183550 -> "Chat ends.";
	j291213218 [label="Oui ? Well, I am pleased to tell you, you have failed.",shape=box,color=blue];
		j291213218 -> j1509439757;
	j516809325 [label="The Cavia were accidents created from experiments. Lab animals never meant to exist. The Void gave them intelligence.",shape=box,color=red];
		j516809325 -> j221421017;
	j896624896 [label="You said yourself \"It is the ultimate form of cruelty, to be absent of a name.\" Entrati never bothered to name them, they were that worthless.",shape=box,color=red];
		j896624896 -> j741466013;
	j2536152567 [label="You told me the story of how you grew up on the streets. How your family threw you out because you weren't good enough for them.",shape=box,color=red];
		j2536152567 -> j2819116386;
	j2844187064 [label="Think about how you would have felt, if you had simply been turned into a protoframe against your will and then abandoned?",shape=box,color=red];
		j2844187064 -> j1641439469;
	j2141974037 [label="Imagine how you would feel if Entrati just swooped in, turned Lyon into a protoframe, and abandoned him?",shape=box,color=red];
		j2141974037 -> j2317866339;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j221421017 [label="And when Entrati saw what he had done? When he realized what he had created? These poor animals, speaking in Void-tongue, sick from exposure?",shape=box,color=red];
		j221421017 -> j3834711729;
	j741466013 [label="They were just things to him. Things to be used and thrown away. \"Tagfer?\" It means \"Tag For Disposal.\"",shape=box,color=red];
		j741466013 -> j2930810524;
	j2819116386 [label="Your family thought you were worthless.",shape=box,color=red];
		j2819116386 -> j3047942080;
	j1641439469 [label="Imagine what it would have been like to have the Infestation in your blood, suffering, with no one there to say they cared?",shape=box,color=red];
		j1641439469 -> j1882864139;
	j2317866339 [label="Used him like a cheap science experiment, and then washed his hands of him? You all had each other to rely on before and after you changed. The Cavia didn't.",shape=box,color=red];
		j2317866339 -> j2124753711;
	j2631316640 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j2631316640 -> j1508231473;
	j3834711729 [label="He didn't care. ",shape=box,color=red];
		j3834711729 -> j1368624670;
	j2930810524 [label="Bird 3? He's a bird with a number for a name. Fibonacci gave himself his name.",shape=box,color=red];
		j2930810524 -> j2051332121;
	j3047942080 [label="That is what the Cavia were to Entrati. Disposable lab animals. \"Tagfer?\" It means \"Tag For Disposal.\"",shape=box,color=red];
		j3047942080 -> j2930810524;
	j1882864139 [label="That your suffering even mattered? The Cavia were - are - worthless to Entrati. Disposable lab animals. \"Tagfer?\" It means \"Tag For Disposal.\"",shape=box,color=red];
		j1882864139 -> j2930810524;
	j2124753711 [label="To Entrati, the Cavia were just disposable lab animals. Worthless. \"Tagfer?\" It means \"Tag For Disposal.\"",shape=box,color=red];
		j2124753711 -> j2930810524;
