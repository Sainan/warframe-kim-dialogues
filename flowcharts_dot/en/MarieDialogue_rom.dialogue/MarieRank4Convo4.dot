		j946548047 -> j2882235416 [label="MarieEntratiFan2",color=purple];
		j946548047 -> j1311763800 [label="MarieEntratiNeutral",color=purple];
		j946548047 -> j340015026 [label="false",color=purple];
	j350584114 [label="It still does not give him a right ! I do not know if he realizes how deep his words cut me. En outre -",shape=box,color=blue];
		j350584114 -> j946548047;
	j2642182748 [label="Merci, I do not know if he knows how deep the knife of his words cut me.",shape=box,color=blue];
		j2642182748 -> j4278649408;
		j2642182748 -> j1502762853;
		j2642182748 -> j2851445484;
	j2672902935 [label="If this is the welcome le Cardinal looks forward to enjoying upon his return, it is no wonder he stays away !",shape=box,color=blue];
		j2672902935 -> j448634185;
		j2672902935 -> j3730011247;
	j1300833956 [label="And I am certain you take M'sieur Tagfer's side in all this, non ? You believe le Cardinal to be a monster just the same as the beast does.",shape=box,color=blue];
		j1300833956 -> j448634185;
		j1300833956 -> j3891907750;
	j2882235416 [label="I am surprised, je pensais que tu étais de mon côté ! Were you not joining me in championing le Cardinal's cause but a moment ago ?",shape=box,color=blue];
		j2882235416 -> j287250475;
	j1311763800 [label="What does it matter, as you said before ? We are to serve him in his deeds and judge him later. This fight is meaningless, non ?",shape=box,color=blue];
		j1311763800 -> j2065386270;
		j1311763800 -> j3993377168;
	j340015026 [label="I know they were made by the Void at le Cardinal's hands. All of us have been given gifts by le Cardinal that are a curse if viewed with a broken heart !",shape=box,color=blue];
		j340015026 -> j162325153;
	j4278649408 [label="And do you know how deeply yours did? Do you know their whole story?",shape=box,color=red];
		j4278649408 -> j340015026;
	j1502762853 [label="And what you said hurt him just as much.",shape=box,color=red];
		j1502762853 -> j1829289903;
	j2851445484 [label="I'm honestly on your side, but... we have to try to keep the peace, Marie.",shape=box,color=red];
		j2851445484 -> j950081703;
		j2851445484 -> j2355058048;
	j448634185 [label="Marie, please. I'm not trying to fight. I'm just trying to get you to understand what they've been through.",shape=box,color=red];
		j448634185 -> j1425163818;
	j3730011247 [label="If Entrati stuck around to help clean up after his own messes, he might have more friends in this world.",shape=box,color=red];
		j3730011247 -> j3582361651;
	j3891907750 [label="Yes, I am taking his side. Because you're not listening to reason. You have to understand \"le Cardinal\" is not what he seems.",shape=box,color=red];
		j3891907750 -> j1425163818;
	j287250475 [label="Has this been some great deception of yours ? Have you been playing un jeu with little Marie ?",shape=box,color=blue];
		j287250475 -> j3595421778;
		j287250475 -> j2180887988;
	j2065386270 [label="It matters if there's nobody left around us when we're on the other side of this. They've been through a lot.",shape=box,color=red];
		j2065386270 -> j1425163818;
	j3993377168 [label="I'm sure he'll forget about it. I'm sure you will, too.",shape=box,color=red];
		j3993377168 -> j3395151276;
	j162325153 [label="All of us have been abandoned by him ! Tell me, how are they so much more wronged, that I must tolerate such hate ?!",shape=box,color=blue];
		j162325153 -> j1639327012;
	j1829289903 [label="Oui ?! Then tell me why !",shape=box,color=blue];
		j1829289903 -> j340015026;
	j950081703 [label="The situation that the Cavia have been through has been... hard.",shape=box,color=red];
		j950081703 -> j340015026;
	j2355058048 [label="They're animals, even if they've been given intelligence, they're still animals. There's only so much they're capable of.",shape=box,color=red];
		j2355058048 -> j1176667549;
	j1425163818 [label="Oui ? Then do play the role of La Lumière Sacrée de Sol and banish the darkness ! Enlighten little foolish Marie !",shape=box,color=blue];
		j1425163818 -> j340015026;
	j3582361651 [label="Oui ! Yes, it is not good enough that he is attempting to save the known universe from a god of the Void, non ?!",shape=box,color=blue];
		j3582361651 -> j568183550;
	j3595421778 [label="No, I'm not lying. I'm with you. I'm just saying their situation has been... hard.",shape=box,color=red];
		j3595421778 -> j1425163818;
	j2180887988 [label="No, not a game, exactly...? Entrati isn't to be trusted, and I don't know how else to convince you but to pretend to be on your side.",shape=box,color=red];
		j2180887988 -> j291213218;
	j3395151276 [label="Non ! You began this conversation, and you will continue it. Explique !",shape=box,color=blue];
		j3395151276 -> j340015026;
	j1639327012 [label="Evaluate expressions",color=orange];
		j1639327012 -> j516809325 [label="MarieFamily2",color=purple];
		j1639327012 -> j896624896 [label="MarieFamily2",color=purple];
