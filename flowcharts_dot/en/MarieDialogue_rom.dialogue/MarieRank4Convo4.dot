		2308 -> 2310 [label="false",color=purple];
		2308 -> 2312 [label="false",color=purple];
	2310 [label="He didn't need to tell me, I could guess. Entrati.",shape=box,color=red];
		2310 -> 2314;
	2311 [label="He did. Though he seemed more concerned about you than anything else.",shape=box,color=red];
		2311 -> 2315;
	2309 [label="He did. He's concerned about the situation because I think he feels for the Cavia. ",shape=box,color=red];
		2309 -> 2313;
	2312 [label="No, honestly. He said only that I should check in on you.",shape=box,color=red];
		2312 -> 2316;
	2314 [label="Oui. M'sieur Tagfer were arguing over the topic of le Cardinal.",shape=box,color=blue];
		2314 -> 2318;
		2314 -> 2319;
	2315 [label="I do not know why the devil would have you believe such a thing. Or to what end it would serve him.",shape=box,color=blue];
		2315 -> 2320;
	2313 [label="The devil sees three wounded animals and knows he can easily wield his charisme to have them fawning over him.",shape=box,color=blue];
		2313 -> 2317;
	2316 [label="I do not know why the devil would have you do such a thing. Or what ends he believes it would serve him.",shape=box,color=blue];
		2316 -> 2321;
	2318 [label="Tagfer is not the biggest supporter of Entrati, no.",shape=box,color=red];
		2318 -> 2323;
	2319 [label="I take it that the argument was a loud one.",shape=box,color=red];
		2319 -> 2324;
	2320 [label="All acts of supposed kindness toward me from the devil are in service of his goal - to turn me against le Cardinal. I know it. ",shape=box,color=blue];
		2320 -> 2322;
	2317 [label="He does this to turn the tide against me. He wishes to corrupt me against le Cardinal. To see me turn my back against him. I know it.",shape=box,color=blue];
		2317 -> 2322;
	2321 [label="But... that is not what you are here to discuss. The fight was in regards to le Cardinal. ",shape=box,color=blue];
		2321 -> 2318;
		2321 -> 2319;
	2323 [label="And this is what I do not understand ! Look at what they have been given !",shape=box,color=blue];
		2323 -> 2325;
		2323 -> 2326;
	2324 [label="Oui ! He called me stupide. He told me that I am nothing but a child.",shape=box,color=blue];
		2324 -> 2327;
		2324 -> 2325;
	2322 [label="And it was the topic of le Cardinal that M'sieur Tagfer and I were arguing over.",shape=box,color=blue];
		2322 -> 2318;
		2322 -> 2319;
	2325 [label="Please, start from the beginning. How did this whole fight start?",shape=box,color=red];
		2325 -> 2328;
	2326 [label="I can start to get a sense of why this fight happened.",shape=box,color=red];
		2326 -> 2328;
	2327 [label="Did he actually call you stupid and a child?",shape=box,color=red];
		2327 -> 2329;
	2328 [label="Oui. I made mention of le Cardinal, I do not even know what it was. ",shape=box,color=blue];
		2328 -> 2330;
	2329 [label="Worse, perhaps.",shape=box,color=blue];
		2329 -> 2331;
	2330 [label="M'sieur Tagfer rolled his eyes and snorted. I asked him to explain his derision.",shape=box,color=blue];
		2330 -> 2332;
	2331 [label="\"You're a spawnling, Marie ! Innocent. Dependent on others your whole life. Curled up in your little nest of blind faith !\"",shape=box,color=blue];
