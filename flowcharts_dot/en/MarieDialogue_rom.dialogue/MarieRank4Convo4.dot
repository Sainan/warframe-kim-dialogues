	"Chat ends." [color=orange];
	j315489333 [label="Oui, though I feel as though I know what this is about... I have behaved poorly. Who told you ?",shape=box,color=blue];
		j315489333 -> j3787189457;
		j315489333 -> j3063977456;
		j315489333 -> j1125000625;
	j1337568856 [label="Bien sûr, ce salaud de diable ouvre sa bouche et vous raconte tout ! Il ne cherche qu'à m'embarrasser !",shape=box,color=blue];
		j1337568856 -> j3514575613;
	j3787189457 [label="It's not important.",shape=box,color=red];
		j3787189457 -> j256476748;
	j3063977456 [label="Loid. ",shape=box,color=red];
		j3063977456 -> j3391523357;
	j1125000625 [label="Roathe.",shape=box,color=red];
		j1125000625 -> j1337568856;
	j3514575613 [label="Si je le pouvais, je prendrais ce couteau qu'il aime tant utiliser pour agacer les autres et je le fourrerais là où seule Lua peut le voir !",shape=box,color=blue];
		j3514575613 -> j3984064372;
	j256476748 [label="I think it is, but I think you are wishing to spare my mood. So... I will not press you for more.",shape=box,color=blue];
		j256476748 -> j79892233;
	j3391523357 [label="I think you are lying to spare my mood, so... I will not press you for more.",shape=box,color=blue];
		j3391523357 -> j79892233;
	j3984064372 [label="Forgive me. That was... untoward. I am une Sœur de Sol, and I must not lose my temper or loosen my tongue in such a way.",shape=box,color=blue];
		j3984064372 -> j2601599241;
	j79892233 [label="+5 Chemistry",color=orange];
		j79892233 -> j3559668994;
	j2601599241 [label="+5 Chemistry",color=orange];
		j2601599241 -> j1584239485;
	j3559668994 [label="I wish to keep what little dignity in this conversation that I might be allowed.",shape=box,color=blue];
		j3559668994 -> j2154874870;
	j1584239485 [label="My anger is not directed at you. And I am always grateful for your honesty.",shape=box,color=blue];
		j1584239485 -> j2682702563;
	j2154874870 [label="If you have come to speak with me about the row I had with M'sieur Tagfer, I shall not deny it occurred.",shape=box,color=blue];
		j2154874870 -> j2682702563;
	j2682702563 [label="I assume the devil told you what the fight was regarding?",shape=box,color=blue];
		j2682702563 -> j370765590;
	j370765590 [label="Evaluate expressions",color=orange];
		j370765590 -> j1891661554 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j3435613686 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j3528151173 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j1891661554 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j1891661554 [label="false",color=purple];
		j370765590 -> j2696967393 [label="false",color=purple];
	j1891661554 [label="He didn't need to tell me, I could guess. Entrati.",shape=box,color=red];
		j1891661554 -> j1294570661;
	j3435613686 [label="He did. Though he seemed more concerned about you than anything else.",shape=box,color=red];
		j3435613686 -> j2523470877;
	j3528151173 [label="He did. He's concerned about the situation because I think he feels for the Cavia. ",shape=box,color=red];
		j3528151173 -> j3103203397;
	j2696967393 [label="No, honestly. He said only that I should check in on you.",shape=box,color=red];
		j2696967393 -> j1964061934;
	j1294570661 [label="Oui. M'sieur Tagfer were arguing over the topic of le Cardinal.",shape=box,color=blue];
		j1294570661 -> j3533276194;
		j1294570661 -> j3443365265;
	j2523470877 [label="I do not know why the devil would have you believe such a thing. Or to what end it would serve him.",shape=box,color=blue];
		j2523470877 -> j1532523889;
	j3103203397 [label="The devil sees three wounded animals and knows he can easily wield his charisme to have them fawning over him.",shape=box,color=blue];
		j3103203397 -> j1776261685;
	j1964061934 [label="I do not know why the devil would have you do such a thing. Or what ends he believes it would serve him.",shape=box,color=blue];
		j1964061934 -> j2244131535;
	j3533276194 [label="Tagfer is not the biggest supporter of Entrati, no.",shape=box,color=red];
		j3533276194 -> j4224580148;
	j3443365265 [label="I take it that the argument was a loud one.",shape=box,color=red];
		j3443365265 -> j1001049691;
	j1532523889 [label="All acts of supposed kindness toward me from the devil are in service of his goal - to turn me against le Cardinal. I know it. ",shape=box,color=blue];
		j1532523889 -> j1914431976;
	j1776261685 [label="He does this to turn the tide against me. He wishes to corrupt me against le Cardinal. To see me turn my back against him. I know it.",shape=box,color=blue];
		j1776261685 -> j1914431976;
	j2244131535 [label="But... that is not what you are here to discuss. The fight was in regards to le Cardinal. ",shape=box,color=blue];
		j2244131535 -> j3533276194;
		j2244131535 -> j3443365265;
	j4224580148 [label="And this is what I do not understand ! Look at what they have been given !",shape=box,color=blue];
		j4224580148 -> j700051858;
		j4224580148 -> j2218686967;
	j1001049691 [label="Oui ! He called me stupide. He told me that I am nothing but a child.",shape=box,color=blue];
		j1001049691 -> j598887774;
		j1001049691 -> j700051858;
	j1914431976 [label="And it was the topic of le Cardinal that M'sieur Tagfer and I were arguing over.",shape=box,color=blue];
		j1914431976 -> j3533276194;
		j1914431976 -> j3443365265;
	j700051858 [label="Please, start from the beginning. How did this whole fight start?",shape=box,color=red];
		j700051858 -> j42973223;
	j2218686967 [label="I can start to get a sense of why this fight happened.",shape=box,color=red];
		j2218686967 -> j42973223;
	j598887774 [label="Did he actually call you stupid and a child?",shape=box,color=red];
		j598887774 -> j975115575;
	j42973223 [label="Oui. I made mention of le Cardinal, I do not even know what it was. ",shape=box,color=blue];
		j42973223 -> j2265098168;
	j975115575 [label="Worse, perhaps.",shape=box,color=blue];
		j975115575 -> j15467890;
	j2265098168 [label="M'sieur Tagfer rolled his eyes and snorted. I asked him to explain his derision.",shape=box,color=blue];
		j2265098168 -> j2074191935;
	j15467890 [label="\"You're a spawnling, Marie ! Innocent. Dependent on others your whole life. Curled up in your little nest of blind faith !\"",shape=box,color=blue];
		j15467890 -> j512673816;
	j2074191935 [label="\"Albrecht is a dirty, stinking liar !\"",shape=box,color=blue];
		j2074191935 -> j2622389259;
	j512673816 [label="\"Surviving on what your elders chewed up and spat into your credulous gaping mouth-hole !\"",shape=box,color=blue];
		j512673816 -> j471012429;
	j2622389259 [label="Et j'ai répondu, \"Look at the gifts you were given - the gifts of thought, of language, of Self!\"",shape=box,color=blue];
		j2622389259 -> j3490711374;
	j471012429 [label="Boolean MarieEntrati3 is now true.",color=orange];
		j471012429 -> j956182981;
		j471012429 -> j1144656429;
		j471012429 -> j1590477619;
	j3490711374 [label="\"You should be grateful to le Cardinal for all he has blessed you with.\"",shape=box,color=blue];
		j3490711374 -> j3482162566;
		j3490711374 -> j2146973782;
	j956182981 [label="Tagfer only knows his side of the story. Entrati's real motivations or opinions weren't... clearly explained.",shape=box,color=red];
		j956182981 -> j3442161619;
	j1144656429 [label="I know how you feel about being \"dependent\" on others and I'm sorry he said those things to you.",shape=box,color=red];
		j1144656429 -> j3015017109;
	j1590477619 [label="Tagfer has good reasons to feel the way he does.",shape=box,color=red];
		j1590477619 -> j946548047;
