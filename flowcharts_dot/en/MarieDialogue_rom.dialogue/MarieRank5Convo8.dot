		j2222781278 -> j2209043138;
	j520518461 [label="Evaluate expressions",color=orange];
		j520518461 -> j1383436669 [label="RoatheFamilyDelay",color=purple];
		j520518461 -> j3625488106 [label="RoatheDating",color=purple];
		j520518461 -> j199146335 [label="RoatheRedeemed",color=purple];
		j520518461 -> j4138166858 [label="RoatheVillain",color=purple];
		j520518461 -> j3033431373 [label="false",color=purple];
	"Chat ends." [color=orange];
	j2209043138 [label="Oui, qu'est-ce qu'il y a ?",shape=box,color=blue];
		j2209043138 -> j3400011719;
	j1383436669 [label="I fear I must call him \"our\" devil now, non ? For he is not leaving any time soon. Ha !",shape=box,color=blue];
		j1383436669 -> j2577643591;
	j3625488106 [label="I feel as though I should be asking you that question, non ? You are the one who is now cavorting with him !",shape=box,color=blue];
		j3625488106 -> j3744218993;
	j199146335 [label="I do not know how you achieved what you did. But he has told us the truth of taking the sérum.",shape=box,color=blue];
		j199146335 -> j2818496552;
	j4138166858 [label="I do not know how you achieved what you did. But he has told us the truth of taking the sérum.",shape=box,color=blue];
	j3033431373 [label="I worry for him. I think he hurts himself more than he lets on, n'est-ce pas?",shape=box,color=blue];
		j3033431373 -> j2113306141;
	j3400011719 [label="I'm sorry if this feels like it's coming out of nowhere, but I haven't known how to tell you earlier.",shape=box,color=red];
		j3400011719 -> j2285781170;
	j2577643591 [label="You have done well in getting his help with Monsieur Loid. I did not think it could be done.",shape=box,color=blue];
		j2577643591 -> j2725225426;
	j3744218993 [label="I am resisting the tentation to ask you toutes sortes de commérages.",shape=box,color=blue];
		j3744218993 -> j2725225426;
	j2818496552 [label="Sol, it broke my heart. His voice did not falter when he spoke. Mais je l'ai vu dans ses yeux.",shape=box,color=blue];
		j2818496552 -> j2725225426;
	j2113306141 [label="It breaks my heart. I hope his does not shatter in his chest some day. I do not know if he will survive it. I do not know if any of us will.",shape=box,color=blue];
		j2113306141 -> "Chat ends.";
	j2285781170 [label="I adore you. I simply adore you.",shape=box,color=red];
		j2285781170 -> j2766050406;
	j2725225426 [label="There has been a change in him. Subtle, but it is there. ",shape=box,color=blue];
		j2725225426 -> j228110701;
	j2766050406 [label="Well, I was wondering... if you'd like to, well... become a couple?",shape=box,color=red];
		j2766050406 -> j2298753926;
	j228110701 [label="+5 Chemistry",color=orange];
		j228110701 -> j247043399;
	j2298753926 [label="Evaluate expressions",color=orange];
		j2298753926 -> j3373762513 [label="MarieNoDate",color=purple];
		j2298753926 -> j1806564902 [label="MarieWillDate",color=purple];
		j2298753926 -> j3373762513 [label="false",color=purple];
	j247043399 [label="For that I know we have you to thank.",shape=box,color=blue];
		j247043399 -> j366977100;
	j3373762513 [label="Oh ! Oh, Drifter. I do not know how to say this, so I will just come right out with it, instead. ",shape=box,color=blue];
		j3373762513 -> j617350017;
	j1806564902 [label="Oh, I feel the same ! Mais je ne sais pas comment te l'écrire, je n'ose pas taper les mots ! I thought myself a fool to even think them !",shape=box,color=blue];
		j1806564902 -> j1944042353;
	j366977100 [label="I do not know if he will welcome it, but he will always have friendship.",shape=box,color=blue];
		j366977100 -> j3658164139;
	j617350017 [label="Non.",shape=box,color=blue];
		j617350017 -> "Chat ends.";
	j1944042353 [label="Ah ! You have made me so happy !",shape=box,color=blue];
		j1944042353 -> j2127540642;
	j3658164139 [label="Though I think I will never tire of shouting at him !",shape=box,color=blue];
		j3658164139 -> j3686863825;
		j3658164139 -> j863409478;
	j2127540642 [label="If you are asking for a more... formal courtship, then oui ! Oui ! I would like this.",shape=box,color=blue];
		j2127540642 -> j3000075799;
		j2127540642 -> j3084913410;
	j3686863825 [label="I think he enjoys teasing you too much, anyway.",shape=box,color=red];
		j3686863825 -> j440062376;
	j863409478 [label="I'm glad you two have found some kind of kinship.",shape=box,color=red];
		j863409478 -> j3775522939;
	j3000075799 [label="Definitely not offering marriage, not yet. ",shape=box,color=red];
		j3000075799 -> j2993983090;
	j3084913410 [label="Things have definitely evolved a bit. I wouldn't say they're more \"formal\" but I'm definitely happy to... show you.",shape=box,color=red];
		j3084913410 -> j1538127626;
	j440062376 [label="Comme un gros chat de gouttière. I have grown accustomed to him.",shape=box,color=blue];
		j440062376 -> j4262190050;
	j3775522939 [label="Oui ! As am I. He grows a little less insufferable every day.",shape=box,color=blue];
		j3775522939 -> j440062376;
	j2993983090 [label="Now I am the one teasing, do not worry. But, either way, je suis ravie ! And looking forward to learning these new...  romantiques customs.",shape=box,color=blue];
		j2993983090 -> j339901489;
	j1538127626 [label="Hah ! I know when you are being wicked. Well. I look forward to it.",shape=box,color=blue];
		j1538127626 -> j339901489;
	j4262190050 [label="I think I would be sad if he were gone.",shape=box,color=blue];
		j4262190050 -> "Chat ends.";
	j339901489 [label="+10 Chemistry",color=orange];
		j339901489 -> j523360200;
	j523360200 [label="Until then ? À la revoyure, mon cœur.",shape=box,color=blue];
		j523360200 -> j1559150062;
	j1559150062 [label="Boolean MarieDating is now true.",color=orange];
		j1559150062 -> j264962945;
