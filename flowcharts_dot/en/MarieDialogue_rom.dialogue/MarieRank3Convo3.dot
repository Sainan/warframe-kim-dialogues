		j971302504 -> j3593928199 [label=false,color=brown];
		j971302504 -> j242691715 [label=false,color=brown];
	j4276515017 [label="Would you tell me more about what it was like living in the Cathedral? Before Entrati came?",shape=box,color=red];
		j4276515017 -> j2826903153;
	j3593928199 [label="Where did you grow up, Marie?",shape=box,color=red];
		j3593928199 -> j3844953152;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j2893111351 [label="What was your life like at the Cathedral before Entrati showed up?",shape=box,color=red];
		j2893111351 -> j966997421;
	j2826903153 [label="Lonely, I suppose, is the truth of it. I had Lyon, but you know what he can be like sometimes. (Oh ! I am so pleased you and he are speaking, now !)",shape=box,color=blue];
		j2826903153 -> j1293157452;
	j3844953152 [label="Boolean MarieBackstory1 is now true.",color=orange];
		j3844953152 -> j3984145972;
	"Chat ends." [color=orange];
	j966997421 [label="Oh, I do not know as it would interest you terribly much, but I will tell you anyway if you are so curious. ",shape=box,color=blue];
		j966997421 -> j3235237514;
	j1293157452 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j1293157452 -> j1271029732;
	j3984145972 [label="I would have thought the language gave it away, but then I remember that you are not from my world as I would know it, hah !",shape=box,color=blue];
		j3984145972 -> j321008407;
	j3235237514 [label="I spent it going about my duties as a Sister of Sol. Polishing the communionware, setting out votives for the parishioners. ",shape=box,color=blue];
		j3235237514 -> j1167021421;
	j1271029732 [label="But that is not why I spend so much time talking to the dead.",shape=box,color=blue];
		j1271029732 -> j1299925260;
	j321008407 [label="I am from la Cité de la Lumière, the capitol city of a country called Gaule. In the grand scheme of the world, it is not too far from Höllvania on a map.",shape=box,color=blue];
		j321008407 -> j641797820;
	j1167021421 [label="Tending to the crypte and the burying ground. That was my favorite task.",shape=box,color=blue];
		j1167021421 -> j2885162588;
		j1167021421 -> j3994375442;
	j1299925260 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j1299925260 -> j979112132;
	j641797820 [label="I wonder if my Cathédrale still stands in 1999 ? What an interesting thought !",shape=box,color=blue];
		j641797820 -> j3810227238;
		j641797820 -> j1784588854;
	j2885162588 [label="Why was it your favorite?",shape=box,color=red];
		j2885162588 -> j2568676667;
	j3994375442 [label="I'm sorry. What about that last part?",shape=box,color=red];
		j3994375442 -> j974808502;
	j979112132 [label="There is a beauty in those places, a tranquillité. They are so quiet. Peaceful.",shape=box,color=blue];
		j979112132 -> j3351728468;
	j3810227238 [label="You do like to wander off topic, don't you?",shape=box,color=red];
		j3810227238 -> j4219838996;
	j1784588854 [label="I could probably ask two of my friends, they're pretty well-traveled. I think they even mentioned they've been to that city.",shape=box,color=red];
		j1784588854 -> j3916144727;
	j2568676667 [label="I enjoyed speaking to those who lay in rest very much. They would listen to my concerns without a word of judgement in return.",shape=box,color=blue];
		j2568676667 -> j506702448;
	j974808502 [label="It was my duty to tend to the dead of the Cathédrale. I would sweep the dust from the floor of the crypte, weed the grass of the yard.",shape=box,color=blue];
		j974808502 -> j2568676667;
	j3351728468 [label="I think I like to tell them of my troubles et les activités des autres because their worries are over, oui ?",shape=box,color=blue];
		j3351728468 -> j38297007;
	j4219838996 [label="+5 Chemistry",color=orange];
		j4219838996 -> j194838662;
	j3916144727 [label="+5 Chemistry",color=orange];
		j3916144727 -> j2424168838;
	j506702448 [label="Well, they had not a single word in return, mais cela me convenait tout à fait ! I would very much rather they stayed silent.",shape=box,color=blue];
		j506702448 -> j1660919080;
	j38297007 [label="Everything must seem small to them now, and that is comforting to me.",shape=box,color=blue];
		j38297007 -> j817531994;
		j38297007 -> j1910040891;
		j38297007 -> j1616116445;
	j194838662 [label="You have noticed, oui ? Lyon teases me all the time that I am a dust mote in the sun beam, drifting along wherever breeze takes me. (I am so pleased you and he are speaking now !)",shape=box,color=blue];
		j194838662 -> j4212424099;
	j2424168838 [label="Oh, do not bother them, it is simply a silly notion. I do not know how sad I would be to think it gone.",shape=box,color=blue];
		j2424168838 -> j4212424099;
	j1660919080 [label="+5 Chemistry",color=orange];
		j1660919080 -> j2327666385;
	j817531994 [label="I don't know, I'm... afraid of really dying, I've never liked being around death.",shape=box,color=red];
		j817531994 -> j2015710140;
	j1910040891 [label="I've never thought about it that way.",shape=box,color=red];
		j1910040891 -> j3802037585;
	j1616116445 [label="I've found the same kind of peace, being in graveyards and cemeteries. I completely understand.",shape=box,color=red];
		j1616116445 -> j283767140;
	j4212424099 [label="I simply am curious, non ? I want to know tout ce qui existe - all that there is - to know. I think that is why le Cardinal and I were destined to meet.",shape=box,color=blue];
		j4212424099 -> j2641104700;
	j2327666385 [label="Can you imagine ? Talking skulls, much like your necraloid ? Ha !",shape=box,color=blue];
		j2327666385 -> j1984885188;
		j2327666385 -> j823590536;
	j2015710140 [label="I know, little morbide Marie ! So strange. But to each their own, non ?",shape=box,color=blue];
		j2015710140 -> j1541308101;
	j3802037585 [label="You are not alone. We do not like to spend much of our time, thinking about what comes after. Not until we are close to it.",shape=box,color=blue];
		j3802037585 -> j2622302747;
	j283767140 [label="I am so glad you understand !",shape=box,color=blue];
		j283767140 -> j2622302747;
	j2641104700 [label="Où en étais-je ? Ah ! Oui. My story.",shape=box,color=blue];
		j2641104700 -> j3827913864;
	j1984885188 [label="That couldn't have been the easiest task, given your wheelchair.",shape=box,color=red];
		j1984885188 -> j1477917588;
	j823590536 [label="Didn't you have other friends to talk to?",shape=box,color=red];
		j823590536 -> j3902008376;
	j1541308101 [label="Someone must look after them. And I am more than happy to.",shape=box,color=blue];
		j1541308101 -> j2622302747;
	j2622302747 [label="Lyon jokes that I am closer to the ground, which is why I think of the grave so much.",shape=box,color=blue];
		j2622302747 -> j1131026700;
	j3827913864 [label="I was born into a rich famille, which might surprise you. The bourgeois class, who are closer to the Orokin than not.",shape=box,color=blue];
		j3827913864 -> j1658127204;
	j1477917588 [label="Non, it was not. But Lyon helped me up and down the stairs into the crypte when it was time, and the rest I could manage with time.",shape=box,color=blue];
		j1477917588 -> j3919607809;
	j3902008376 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j3902008376 -> j101638013;
	j1131026700 [label=" I ask him if his head is empty, which is why it is so full of ghosts.",shape=box,color=blue];
		j1131026700 -> j1153292349;
	j1658127204 [label="But when I was born as I was... deformed, with mes pieds tordus et inutilisables ? Oh, ma mère could not have that.",shape=box,color=blue];
		j1658127204 -> j2754517947;
	j3919607809 [label="It is impressive what one can do with stubbornness, oui ?",shape=box,color=blue];
		j3919607809 -> j1471878462;
	j101638013 [label="I had Lyon, of course. But you can see how well that goes, some days.",shape=box,color=blue];
		j101638013 -> j1299925260;
	j1153292349 [label="Then he would threaten to push me down a hill, and I will threaten to fill his cassock with nettles.",shape=box,color=blue];
		j1153292349 -> j1118776134;
	j2754517947 [label="There were appearances to be maintained, oui ? Standards to be kept.",shape=box,color=blue];
		j2754517947 -> j1455875031;
	j1471878462 [label="Well. Stubbornness and upper body strength, ha !",shape=box,color=blue];
		j1471878462 -> j2613366284;
	j1118776134 [label="La famille.",shape=box,color=blue];
		j1118776134 -> j858801125;
		j1118776134 -> j996126577;
		j1118776134 -> j3126925570;
		j1118776134 -> j632170782;
	j1455875031 [label="So, what was to be done, with poor malformed Marie ? I was brought to la Cité de la Lumière, where certainly I would parish upon the streets...",shape=box,color=blue];
		j1455875031 -> j1558120533;
	j2613366284 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j2613366284 -> j1299925260;
	j858801125 [label="I'm sorry Entrati upset what you had.",shape=box,color=red];
		j858801125 -> j2363234473;
	j996126577 [label="I'm so glad you two had each other.",shape=box,color=red];
		j996126577 -> j513709308;
	j3126925570 [label="You two make me smile.",shape=box,color=red];
		j3126925570 -> j293955157;
	j632170782 [label="So you and he... have never been romantic?",shape=box,color=red];
		j632170782 -> j3192651736;
	j1558120533 [label="And abandoned to die.",shape=box,color=blue];
		j1558120533 -> j4085073556;
		j1558120533 -> j3937125554;
	j2363234473 [label="+10 Chemistry",color=orange];
		j2363234473 -> j213323701;
	j513709308 [label="+20 Chemistry",color=orange];
		j513709308 -> j2249989552;
	j293955157 [label="+20 Chemistry",color=orange];
		j293955157 -> j2188280692;
	j3192651736 [label="Oh, Sol ! Non ! He is like a brother to me in all ways except by blood. I find myself complètement dégoûtée by the very notion !",shape=box,color=blue];
		j3192651736 -> j240865144;
		j3192651736 -> j981052281;
	j4085073556 [label="Your family left you for dead?",shape=box,color=red];
		j4085073556 -> j334938868;
	j3937125554 [label="How old were you?",shape=box,color=red];
		j3937125554 -> j3036137431;
	j213323701 [label="Entrati did not upset anything. Lyon and I are as strong as we have ever been. Things have simply changed, non ?",shape=box,color=blue];
		j213323701 -> j3158574317;
	j2249989552 [label="I would be nowhere with out him. Save, perhaps, the bottom of a hill. Hah !",shape=box,color=blue];
		j2249989552 -> j799337483;
	j2188280692 [label="He makes me laugh in the strangest of ways. But I find, so do you, wolf. I am finding myself happier and happier to be here.",shape=box,color=blue];
		j2188280692 -> j2443212036;
	j240865144 [label="I was just curious.",shape=box,color=red];
		j240865144 -> j3385888755;
	j981052281 [label="I admit, I'm a little relieved.",shape=box,color=red];
		j981052281 -> j1335227973;
	j334938868 [label="In their eyes, they had tried their best to mend me for many years. Tutors to teach me to walk. Braces. Footwear.",shape=box,color=blue];
		j334938868 -> j741024622;
	j3036137431 [label="Six ? Seven ? In their eyes, they had tried their best to mend me for many years. Tutors to teach me to walk. Braces. Footwear.",shape=box,color=blue];
		j3036137431 -> j741024622;
	j3158574317 [label="Lua is ever-changeable. Even Sol, constant as he may be, is influenced in his orbits.",shape=box,color=blue];
		j3158574317 -> j1398577379;
	j799337483 [label="He truly is the brother of my soul. I am finding myself happier and happier to be here.",shape=box,color=blue];
		j799337483 -> j2443212036;
	j2443212036 [label="I only hope he soon discovers the same... but the devil haunts him with his whispers and lies.",shape=box,color=blue];
		j2443212036 -> j920880053;
	j3385888755 [label="+10 Chemistry",color=orange];
		j3385888755 -> j1930259134;
	j1335227973 [label="Check boolean DrifterMarie",color=orange];
		j1335227973 -> j4276918967 [label=true,color=green];
		j1335227973 -> j2752111096 [label=false,color=brown];
	j741024622 [label="They were tired of the burden. So, barely able to even read and write my numbers and letters, I found myself in the muck.",shape=box,color=blue];
		j741024622 -> j616544290;
		j741024622 -> j801662954;
	j1398577379 [label="We must not be rigid in our ways, or we will be broken by them, wolf. Besides, I am finding myself happier and happier to be here.",shape=box,color=blue];
		j1398577379 -> j2443212036;
	j920880053 [label="Bah ! Speak of him and he calls. I must go.",shape=box,color=blue];
		j920880053 -> "Chat ends.";
	j1930259134 [label="Check boolean DrifterMarie",color=orange];
		j1930259134 -> j460485402 [label=true,color=green];
		j1930259134 -> j757310227 [label=false,color=brown];
	j4276918967 [label="Oui, you have made your intentions known. I must warn you that I will not abandon him. I have known Lyon much longer than you.",shape=box,color=blue];
		j4276918967 -> j757310227;
	j2752111096 [label="Oui ? And which one of us do you... hunt ?",shape=box,color=blue];
		j2752111096 -> j2816697078;
		j2752111096 -> j1932055918;
	j616544290 [label="How did you survive?",shape=box,color=red];
		j616544290 -> j251854413;
	j801662954 [label="That's horrible.",shape=box,color=red];
		j801662954 -> j251854413;
	j460485402 [label="Oui. Simply \"curious.\" You do not fool me. I must warn you that I will not abandon him. I have known Lyon much longer than you.",shape=box,color=blue];
		j460485402 -> j757310227;
	j757310227 [label="+20 Chemistry",color=orange];
		j757310227 -> j3640930455;
	j2816697078 [label="You.",shape=box,color=red];
		j2816697078 -> j3673872638;
	j1932055918 [label="Lyon.",shape=box,color=red];
		j1932055918 -> j3121806371;
	j251854413 [label="Check boolean MarieSecretPower",color=orange];
		j251854413 -> j1470230314 [label=true,color=green];
		j251854413 -> j1005729714 [label=false,color=brown];
	j3640930455 [label="I would be nowhere without him. Save, perhaps, the bottom of a hill. Hah !",shape=box,color=blue];
		j3640930455 -> j4172361102;
	j3673872638 [label="Boolean DrifterMarie is now true.",color=orange];
		j3673872638 -> j884605849;
	j3121806371 [label="Vraiment ?!",shape=box,color=blue];
		j3121806371 -> j85623274;
	j1470230314 [label="It was like you said, non ? All inconveniences come with a secret power.",shape=box,color=blue];
		j1470230314 -> j1005729714;
	j1005729714 [label="What made me une indésirable pour ma mère, made me quite popular amongst the other children of the streets.",shape=box,color=blue];
		j1005729714 -> j4271259819;
	j4172361102 [label="Still, you intrigue me, wolf. I am finding myself happier and happier to be here.",shape=box,color=blue];
		j4172361102 -> j2443212036;
	j884605849 [label="+10 Chemistry",color=orange];
		j884605849 -> j3095594327;
	j85623274 [label="+10 Chemistry",color=orange];
		j85623274 -> j3765213050;
	j4271259819 [label="What is more pathétique than a child without pieds, oui ? I could earn more in a day with open palms than they could rob in a week.",shape=box,color=blue];
		j4271259819 -> j2600976908;
	j3095594327 [label="Oh ! Par Sol. You catch me by surprise, I must admit. And now I am sitting here blushing, hiding my face from Monsieur Loid...",shape=box,color=blue];
		j3095594327 -> j3670694654;
	j3765213050 [label="You do not know how happy this makes me, but please, think on what you say.",shape=box,color=blue];
		j3765213050 -> j2446564784;
	j2600976908 [label="It was this, that led to my being found on the streets by one of les Sœurs de Sol. They offered to take me in.",shape=box,color=blue];
		j2600976908 -> j2237117506;
		j2600976908 -> j278508275;
	j3670694654 [label="I must warn you that I will not abandon him. I have known Lyon much longer than you.",shape=box,color=blue];
		j3670694654 -> j1264898470;
	j2446564784 [label="Boolean DrifterLyon is now true.",color=orange];
		j2446564784 -> j1671914841;
	j2237117506 [label="What about the other children?",shape=box,color=red];
		j2237117506 -> j3156337006;
	j278508275 [label="Obviously, you said yes.",shape=box,color=red];
		j278508275 -> j3822312946;
	j1264898470 [label="+10 Chemistry",color=orange];
		j1264898470 -> j2443212036;
	j1671914841 [label="Lyon is my brother. I love him more than you can possibly know, but he is a troubled man. Consider your words carefully before you pursue him, n'est-ce pas ?",shape=box,color=blue];
		j1671914841 -> j130299890;
	j3156337006 [label="+5 Chemistry",color=orange];
		j3156337006 -> j186492270;
	j3822312946 [label="Oui, what could I do ? It was only a matter of time before I fell ill. Even as an enfant I knew that.",shape=box,color=blue];
		j3822312946 -> j988508767;
		j3822312946 -> j2516922367;
	j130299890 [label="We will speak on this again soon, I think. Do not take me wrong, I am encouraging you ! I simply want you to think it through.",shape=box,color=blue];
		j130299890 -> j1264898470;
	j186492270 [label="You have such a kind heart. Obviously, they could not take them all... but I did not forget my friends.",shape=box,color=blue];
		j186492270 -> j2663794141;
	j988508767 [label="What were the sisters like?",shape=box,color=red];
		j988508767 -> j142184148;
	j2516922367 [label="How'd you adjust to life at the Cathedral?",shape=box,color=red];
		j2516922367 -> j2103729075;
	j2663794141 [label="I would return every week with my salaire, and whatever scraps I could gather from the kitchen or from the others.",shape=box,color=blue];
		j2663794141 -> j1308311689;
	j142184148 [label="Les Sœurs were so kind to me ! Though I know why you must wonder otherwise, non ?",shape=box,color=blue];
		j142184148 -> j3828790315;
	j2103729075 [label="How I adored it so ! Though I know why you must wonder otherwise, non ?",shape=box,color=blue];
		j2103729075 -> j3828790315;
	j1308311689 [label="I took as good care of them as I could, for as long as my friends remained. Many died of variole ou tuberculose...",shape=box,color=blue];
		j1308311689 -> j3575801102;
	j3828790315 [label="Three meals, a warm bed, a roof over my head. I did not need to worry about being beaten, or robbed, or worse ?",shape=box,color=blue];
		j3828790315 -> j2631367234;
	j3575801102 [label="Several moved away, some died by fighting, or violence. Most found honest work and grew. Raised famille of their own.",shape=box,color=blue];
		j3575801102 -> j1535175217;
	j2631367234 [label="I was properly schooled. Taught gospels of Sol and Lua. Told to find my way in faith. I could have left, if I chose.",shape=box,color=blue];
		j2631367234 -> j4123657589;
	j1535175217 [label="Some would even stop by the Cathédrale to see me. It warmed my heart.",shape=box,color=blue];
		j1535175217 -> j4123657589;
	j4123657589 [label="I felt guilt for a long time that I was taken from the streets when others were not. Some days, I still do.",shape=box,color=blue];
		j4123657589 -> j2956768770;
		j4123657589 -> j221882188;
	j2956768770 [label="When I remember about all those who have died around me, when I'm the one who lived? I feel the same. But we can't do that to ourselves. We have to keep on fighting to improve things when we can.",shape=box,color=red];
		j2956768770 -> j3009145050;
	j221882188 [label="You've done your best to try to help others with what you were given. Others lifted you up, and you're trying to lift others up now that you've been given that opportunity.",shape=box,color=red];
		j221882188 -> j580172373;
	j3009145050 [label="Is that always what this will forever be ? A fight ? A war against a tide that seeks to drown us ?",shape=box,color=blue];
		j3009145050 -> j3423884300;
	j580172373 [label="Add 1 to Thermostat counter",color=orange];
		j580172373 -> j1241677415;
	j3423884300 [label="Add -1 to Thermostat counter",color=orange];
		j3423884300 -> j1918713789;
	j1241677415 [label="+10 Chemistry",color=orange];
		j1241677415 -> j2362798621;
	j1918713789 [label="+10 Chemistry",color=orange];
		j1918713789 -> j2869421865;
	j2362798621 [label="Oui, that is it precisely. I have been lifted upon the raft, and now I must do so for others. ",shape=box,color=blue];
		j2362798621 -> j3848230702;
	j2869421865 [label="But I know what you mean. At the heart of it, you say not to give up. That I have been given these gifts so that I may stand as a shield for others.",shape=box,color=blue];
		j2869421865 -> j3848230702;
	j3848230702 [label="Merci. But for now I must go.",shape=box,color=blue];
		j3848230702 -> "Chat ends.";
}