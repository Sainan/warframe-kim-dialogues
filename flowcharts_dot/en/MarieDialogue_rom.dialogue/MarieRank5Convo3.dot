		j91134853 -> j1061251340;
	j684492984 [label="Oh, that is such a kind question for you to ask... but as always, it is... just a matter of comparison, I am afraid. But you know what that is like, I am certain, oui ?",shape=box,color=blue];
		j684492984 -> j529671707;
		j684492984 -> j2204852670;
	j4126066433 [label="Oh, that is such a kind question for you to ask... but as always, it is... just a matter of comparison, I am afraid.",shape=box,color=blue];
		j4126066433 -> j607497786;
		j4126066433 -> j654815728;
	j529671707 [label="I'm sorry that if by asking about it, I made it hurt.",shape=box,color=red];
		j529671707 -> j3071053902;
	j2204852670 [label="Anything I can do to make it better, or take your mind off it?",shape=box,color=red];
		j2204852670 -> j3842139880;
	j607497786 [label="Oh, I'm sorry... bad pain day? ",shape=box,color=red];
		j607497786 -> j2517406865;
	j654815728 [label="Is there something I can do?",shape=box,color=red];
		j654815728 -> j36286110;
	j3568377079 [label="Vraiment gentil of you, but it is an old problem, nothing worth troubling yourself over. I will be fine.",shape=box,color=blue];
		j3568377079 -> j3359734167;
	j1061251340 [label="+10 Chemistry",color=orange];
		j1061251340 -> j1246001669;
	j3071053902 [label="+10 Chemistry",color=orange];
		j3071053902 -> j3728428219;
	j3842139880 [label="+10 Chemistry",color=orange];
		j3842139880 -> j2103050326;
	j2517406865 [label="Oui, I am afraid. The mind is a truly marvelous thing. I think it is fascinating that they must always hurt, all the time, and yet I have learned to simply ignore them.",shape=box,color=blue];
		j2517406865 -> j2517815294;
		j2517406865 -> j1322501014;
		j2517406865 -> j2604921060;
	j36286110 [label="You are doing so now, by talking to me. The mind is a marvelous thing, is it not ? I think that mes pieds must hurt all the time, yet I have learned to simply ignore them.",shape=box,color=blue];
		j36286110 -> j2517815294;
		j36286110 -> j1322501014;
		j36286110 -> j2604921060;
	j3359734167 [label="Boolean MarieChronicPain is now true.",color=orange];
		j3359734167 -> j570932394;
		j3359734167 -> j4222041596;
		j3359734167 -> j1290475412;
	j1246001669 [label="Oui, I am quite fine, I assure you. But merci. I appreciate the concern.",shape=box,color=blue];
		j1246001669 -> "Chat ends.";
	j3728428219 [label="Ha ! Funny how what is, non ? You are right. I was not thinking about mes pieds, but now I am, and now they hurt. ",shape=box,color=blue];
		j3728428219 -> j864510056;
	j2103050326 [label="Oui ! You are doing so now, by talking to me. The mind is a marvelous thing, is it not ? I think that mes pieds must hurt all the time, yet I have learned to simply ignore them.",shape=box,color=blue];
		j2103050326 -> j3475747112;
		j2103050326 -> j2349231588;
		j2103050326 -> j2617861760;
	j2517815294 [label="That sounds exhausting...",shape=box,color=red];
		j2517815294 -> j3059776784;
	j1322501014 [label="That sounds frustrating.",shape=box,color=red];
		j1322501014 -> j2716662205;
	j2604921060 [label="There's really no cure? It never stops?",shape=box,color=red];
		j2604921060 -> j478944446;
	j570932394 [label="If you're certain, but I'm here, if you want to talk about it.",shape=box,color=red];
		j570932394 -> j3752571194;
	j4222041596 [label="I... know what that's like. Before I started \"looping,\" I hurt myself pretty badly in Duviri. It healed, but it still aches something awful from time to time. I try to hide my wincing when it acts up.",shape=box,color=red];
		j4222041596 -> j2921818132;
	j1290475412 [label="Old persistent problems can sometimes be as problematic as new ones. Just because they come and go, and can stay with us, doesn't mean they aren't worth talking about.",shape=box,color=red];
		j1290475412 -> j279562232;
	j864510056 [label="The mind is a truly marvelous thing. I think it is fascinating that they must always hurt, all the time, and yet I have learned to simply ignore them.",shape=box,color=blue];
		j864510056 -> j3475747112;
		j864510056 -> j2349231588;
		j864510056 -> j2617861760;
	j3475747112 [label="I'm the same way. The moment I focus on - yeah, there's the pain. Sometimes I wonder if that's why I keep so damn busy.",shape=box,color=red];
		j3475747112 -> j2022706897;
	j2349231588 [label="Sometimes I get angry thinking about how much I could get done if I wasn't distracted by the pain all the time.",shape=box,color=red];
		j2349231588 -> j1378819069;
	j2617861760 [label="Are you always tired all the time, too? Sometimes I wonder if that's why I'm so exhausted. I'm always spending cycles on being in pain in the background.",shape=box,color=red];
		j2617861760 -> j229643298;
	j3059776784 [label="+10 Chemistry",color=orange];
		j3059776784 -> j4164420433;
	j2716662205 [label="Check boolean MarieSecretPower",color=orange];
		j2716662205 -> j1821707805 [label=true,color=green];
		j2716662205 -> j3294955257 [label=false,color=brown];
	j478944446 [label="Non... it never stops. I can only distract myself, like in conversations like this. Or by staying busy.",shape=box,color=blue];
		j478944446 -> j1203521695;
	j3752571194 [label="You are so very kind, and... very well. I am being little stubborn Marie again.",shape=box,color=blue];
		j3752571194 -> j3852209197;
	j2921818132 [label="Boolean DrifterChronicPain is now true.",color=orange];
		j2921818132 -> j2048358803;
	j279562232 [label="Oui, you are right. I am being little stubborn Marie again.",shape=box,color=blue];
		j279562232 -> j3852209197;
	j2022706897 [label="+5 Chemistry",color=orange];
		j2022706897 -> j1108495155;
	j1378819069 [label="Check boolean MarieSecretPower",color=orange];
		j1378819069 -> j2627672181 [label=true,color=green];
		j1378819069 -> j1449397790 [label=false,color=brown];
	j229643298 [label="+5 Chemistry",color=orange];
		j229643298 -> j2346669413;
	j4164420433 [label="Oui, it is. Par exemple -",shape=box,color=blue];
		j4164420433 -> j109733424;
	j1821707805 [label="But it is like you said, non ? All inconveniences like mine come with a secret power. We must simply find them.",shape=box,color=blue];
		j1821707805 -> j1285405215;
	j3294955257 [label="Oui, it is. I sometimes would sit there and stare at a book on the top row of a case and think how unjust it was that I could not reach it.",shape=box,color=blue];
		j3294955257 -> j2342117666;
	j1203521695 [label="I was dusting all the chandeliers the other day in the Sanctum. Monsieur Loid begged me to stop.",shape=box,color=blue];
		j1203521695 -> j604117044;
	j3852209197 [label="It is a hard thing to explain, but I will try. Mes pieds, oui ? My feet. The sérum has changed me, given me flight -",shape=box,color=blue];
		j3852209197 -> j2040449123;
	j2048358803 [label="Par les Luminaires, I am so very sorry. You understand then, what it is like, oui ?",shape=box,color=blue];
		j2048358803 -> j3362616962;
	j1108495155 [label="Oui ! Oh, I was dusting all the chandeliers the other day in the Sanctum. Monsieur Loid begged me to stop.",shape=box,color=blue];
		j1108495155 -> j1038286868;
	j2627672181 [label="But it is like you said, non ? All inconveniences like ours come with a secret power. We must simply find them.",shape=box,color=blue];
		j2627672181 -> j2913643930;
	j1449397790 [label="Oui, I know your frustration. I sometimes would sit there and stare at a book on the top row of a case and think how unjust it was that I could not reach it.",shape=box,color=blue];
		j1449397790 -> j797488188;
	j2346669413 [label="Oui !! Oh, you do understand !! Par exemple -",shape=box,color=blue];
		j2346669413 -> j2971359346;
	j109733424 [label="Do you know how tiring it is to have to float all the time, jour après jour, heure après heure, when others may walk ?",shape=box,color=blue];
		j109733424 -> j3132781002;
	j1285405215 [label="But yes, it is frustrating. I sometimes would sit there and stare at a book on the top row of a case and think how unjust it was that I could not reach it.",shape=box,color=blue];
		j1285405215 -> j2342117666;
	j2342117666 [label="That it contained knowledge that I cared about, no one else, so why was I denied it ? And along would come some helpful soul who would pluck it from its place for me out of pity...",shape=box,color=blue];
		j2342117666 -> j2548880568;
	j604117044 [label="I told him I needed to stay busy, needed to keep my hands moving. I do not think he quite understood why I must stay so active.",shape=box,color=blue];
		j604117044 -> j1491658648;
	j2040449123 [label="But I still feel them, those twisted things that threatened to consume me, threatened to crush all hope and joie from my soul.",shape=box,color=blue];
		j2040449123 -> j2044996201;
	j3362616962 [label="To have a body that betrays you, that slows your spirit down. Even now, it is so strange. The sérum has changed me, given me flight -",shape=box,color=blue];
		j3362616962 -> j4126753394;
	j1038286868 [label="I told him I needed to stay busy, needed to keep my hands moving. I do not think he quite understood why I must stay so active.",shape=box,color=blue];
		j1038286868 -> j662552122;
	j2913643930 [label="But I know your frustration. Oh, I know it well. I sometimes would sit there and stare at a book on the top row of a case and think how unjust it was that I could not reach it.",shape=box,color=blue];
		j2913643930 -> j797488188;
	j797488188 [label="That it contained knowledge that I cared about, no one else, so why was I denied it ? And along would come some helpful soul who would pluck it from its place for me out of pity...",shape=box,color=blue];
		j797488188 -> j2498572706;
		j797488188 -> j2623889076;
	j2971359346 [label="Do you know how tiring it is to have to float all the time, jour après jour, heure après heure, when others may walk ?",shape=box,color=blue];
		j2971359346 -> j3552115159;
	j3132781002 [label="I am ravie to be so mobile, to be able to reach anything I wish, do not mistake me. But it is still so exhausting !",shape=box,color=blue];
		j3132781002 -> j1491658648;
	j2548880568 [label="And it is not their fault, for they are doing an act of kindness - I needed the help. And it is not their fault that I needed it. But oh, how frustrating it is to need that assistance.",shape=box,color=blue];
		j2548880568 -> j2530589018;
		j2548880568 -> j1784585217;
	j1491658648 [label="It is just... so nice to be able to speak of all this. I cannot properly put it into words. It is so rare to be able to discuss this kind of unseen, silent plague I suffer.",shape=box,color=blue];
		j1491658648 -> j2862224822;
	j2044996201 [label="Always they hurt. Always. Even now, as I sit here, if I think of them, I feel the pain. But it is not always enough that I notice.",shape=box,color=blue];
		j2044996201 -> j654815728;
		j2044996201 -> j607497786;
	j4126753394 [label="But I still feel them, those twisted things that threatened to consume me, threatened to crush all hope and joie from my soul.",shape=box,color=blue];
		j4126753394 -> j235035758;
	j662552122 [label="Ah, it just brings me happiness to know that someone here understands what it is like. It is so rare. This silent, unseen plague we suffer.",shape=box,color=blue];
		j662552122 -> j865060800;
	j2498572706 [label="What's wrong with that?",shape=box,color=red];
		j2498572706 -> j2694033450;
	j2623889076 [label="Yeah. I know. And it's not their fault.",shape=box,color=red];
		j2623889076 -> j889588977;
	j3552115159 [label="I am ravie to be so mobile, to be able to reach anything I wish, do not mistake me. But it is still so exhausting !!",shape=box,color=blue];
		j3552115159 -> j662552122;
	j2530589018 [label="I'm so sorry you have to put up with all that. ",shape=box,color=red];
		j2530589018 -> j1280012355;
	j1784585217 [label="And you can't even express that frustration.",shape=box,color=red];
		j1784585217 -> j1280012355;
	j2862224822 [label="Like a tiny little abeille that sits upon my shoulder and stings me every day. Not enough to destroy, just enough to be a nuisance.",shape=box,color=blue];
		j2862224822 -> j2983474364;
		j2862224822 -> j1115739818;
	j235035758 [label="Always they hurt. Always. Even now, as I sit here, if I think of them, I feel the pain. But it is not always enough that I notice.",shape=box,color=blue];
		j235035758 -> j2204852670;
		j235035758 -> j529671707;
	j865060800 [label="Like a tiny little abeille that sits upon us and stings us every day. Not enough to destroy us, just enough to bother us.",shape=box,color=blue];
		j865060800 -> j1115739818;
		j865060800 -> j2983474364;
	j2694033450 [label="Nothing ! Nothing is wrong. I needed the help. But that is the root of it, I needed the help. And it is, as you said... frustrating.",shape=box,color=blue];
		j2694033450 -> j1059426994;
	j889588977 [label="Oui ! It is not their fault, for they are doing an act of kindness - I needed the help. And it is not their fault that I needed it. But oh, how frustrating it is to need that assistance.",shape=box,color=blue];
		j889588977 -> j1059426994;
	j1280012355 [label="+10 Chemistry",color=orange];
		j1280012355 -> j1491658648;
	j2983474364 [label="Well, I wish it would go away...",shape=box,color=red];
		j2983474364 -> j3815931453;
	j1115739818 [label="What's an \"abeille?\"",shape=box,color=red];
		j1115739818 -> j1754583236;
	j1059426994 [label="+5 Chemistry",color=orange];
		j1059426994 -> j662552122;
	j3815931453 [label="As do I ! But in the same way, it makes us part of who we are, non ? Who are we to say what parts of us are the important ones, and what parts are not ?",shape=box,color=blue];
		j3815931453 -> j2427033551;
