	j3606768880 [label="Oh, a bee!",shape=box,color=red];
		j3606768880 -> j112998566;
	j3990818829 [label="No, not getting it... keep going.",shape=box,color=red];
		j3990818829 -> j3891834765;
	j2410508255 [label="I will not speak of faith except to say that... flawed as we must think our forms from this limited view, we must... be at peace with what we are, non ? It is all we have.",shape=box,color=blue];
		j2410508255 -> j2548984291;
	j1724918538 [label="I know our faiths are similar in shape, so I will say that... Sol saw fit to make me as I am, and I must have faith in his design, non ? Flawed as I may think it from my limited view. I would wonder if you could not consider the same of yours.",shape=box,color=blue];
		j1724918538 -> j2548984291;
	j1342462735 [label="I know our faiths are dissimilar in shape, so I will not speak where I am not knowledgable. But I will simply say that Sol saw fit to make me as I am, and I must have faith in his design, non ? Flawed as I may think it from my limited view. I would wonder if you could not consider the same of yours.",shape=box,color=blue];
		j1342462735 -> j2548984291;
	j1929840475 [label="I know your faith is personal to you, so I will not pry. But I will simply say that Sol saw fit to make me as I am, and I must have faith in his design, non ? Flawed as I may think it from my limited view. I would wonder if you could not consider the same of yours.",shape=box,color=blue];
		j1929840475 -> j2548984291;
	j2159377097 [label="Sol saw fit to make us both as we are, and we must have faith in his design, non ? Flawed as we may think it from our limited view.",shape=box,color=blue];
		j2159377097 -> j2548984291;
	j4186741996 [label="Lua saw fit to make you as you are, and Sol saw fit to make me as I am. We must have faith in their design, non ? Flawed as we may think it from our limited view.",shape=box,color=blue];
		j4186741996 -> j2548984291;
	j2662216503 [label="The Luminaries saw fit to make us as we are. We must have faith in their design, non ? Flawed as we may think it from our limited view.",shape=box,color=blue];
		j2662216503 -> j2548984291;
	j2832487661 [label="I know you adhere to that none of us can know the true answer to the universe, and I laud and respect that. But I will simply say that Sol saw fit to make me as I am, and I must have faith in his design, non ? Flawed as I may think it from my limited view.",shape=box,color=blue];
		j2832487661 -> j2548984291;
	j92331785 [label="I know you hold no faith of your own, and I respect that. But I will simply say that Sol saw fit to make me as I am, and I must have faith in his design, non ? Flawed as I may think it from my limited view.",shape=box,color=blue];
		j92331785 -> j2548984291;
