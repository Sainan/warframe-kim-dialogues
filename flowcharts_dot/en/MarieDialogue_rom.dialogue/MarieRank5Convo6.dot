		j3097375491 -> j836204394 [label=false,color=brown];
	j3994379987 [label="Wolf ! My wolf ! I have met Otak ! I have finally met him !",shape=box,color=blue];
		j3994379987 -> j2789285016;
		j3994379987 -> j3613225810;
	j878366966 [label="I have met Otak ! I have finally met him !",shape=box,color=blue];
		j878366966 -> j2789285016;
		j878366966 -> j3613225810;
	j1048067799 [label="Wolf ! My wolf ! The face upon the back of Monsieur Necraloid ! I have finally met him !",shape=box,color=blue];
		j1048067799 -> j1359814629;
		j1048067799 -> j4153542309;
		j1048067799 -> j3087346963;
	j836204394 [label="The face upon the back of Monsieur Necraloid ! I have finally met him !",shape=box,color=blue];
		j836204394 -> j1359814629;
		j836204394 -> j4153542309;
		j836204394 -> j3087346963;
	j2789285016 [label="How did your conversation with him go?",shape=box,color=red];
		j2789285016 -> j913508170;
	j3613225810 [label="Did you enjoy talking to him?",shape=box,color=red];
		j3613225810 -> j577401455;
	j1359814629 [label="You met Otak? Oh boy... How did that go?",shape=box,color=red];
		j1359814629 -> j2738263814;
	j4153542309 [label="I'm glad you finally met. Otak can be a little hard to explain.",shape=box,color=red];
		j4153542309 -> j37549744;
	j3087346963 [label="Poor Otak... How did that go?",shape=box,color=red];
		j3087346963 -> j4205173261;
	j913508170 [label="He... introduced himself to me thrice over in the same conversation, as though we had never been introduced.",shape=box,color=blue];
		j913508170 -> j3218989963;
	j577401455 [label="I did. Though perhaps I wanted to weep for it. For he introduced himself to me thrice over in the same conversation, as though we had never been introduced.",shape=box,color=blue];
		j577401455 -> j3218989963;
	j2738263814 [label="Why do you sound less than pleased that I met him ?",shape=box,color=blue];
		j2738263814 -> j3147900402;
		j2738263814 -> j3588463769;
		j2738263814 -> j423407521;
	j37549744 [label="Yes, I would think so. A child's scrawl written on the back of an automaton. I found him nothing but sweet and charming !",shape=box,color=blue];
		j37549744 -> j3059591501;
	j4205173261 [label="I found him nothing but sweet and charming ! But buried beneath a layer of humor, I felt great heartbreak.",shape=box,color=blue];
		j4205173261 -> j704808942;
	j3218989963 [label="Greeting me in the same unflinching, cheerful way he had the previous times. But he knew me as a Sœur de Sol ! ",shape=box,color=blue];
		j3218989963 -> j2672247570;
	j3147900402 [label="I'm sorry. He can get on people's nerves sometimes. It's not his fault.",shape=box,color=red];
		j3147900402 -> j3210693033;
	j3588463769 [label="I didn't mean to. He can just be a little... off putting for some people.",shape=box,color=red];
		j3588463769 -> j3210693033;
	j423407521 [label="He can get on my nerves sometimes, is all. ",shape=box,color=red];
		j423407521 -> j3673208157;
	j3059591501 [label="But buried beneath the humor, there is great heartbreak.",shape=box,color=blue];
		j3059591501 -> j704808942;
	j704808942 [label="Will you tell me the story of poor Monsieur Otak ?",shape=box,color=blue];
		j704808942 -> j2761941856;
	j2672247570 [label="Indeed, he knew much of the Luminaries ! We talked at length of the \"Ancient Religions\" as he dubbed them, in the \"days before the Orokin Empire.\"",shape=box,color=blue];
		j2672247570 -> j4064703176;
	j3210693033 [label="And I would hope they would show him kindness and patience. Mais par la grâce de Sol, go we all.",shape=box,color=blue];
		j3210693033 -> j1876176897;
	j3673208157 [label="I would hope you would seek to be more kind with someone who is clearly infirme. But for the grace of Sol go we, after all.",shape=box,color=blue];
		j3673208157 -> j1876176897;
	j2761941856 [label="Otak used to be an Archimedean, an Orokin scientist and academic. What's happened to him isn't exactly the happiest story.",shape=box,color=red];
		j2761941856 -> j3142593989;
	j4064703176 [label="Though he said much of that knowledge was lost now, deep in the archives, and very much forbidden. He swore me to secrecy.",shape=box,color=blue];
		j4064703176 -> j1625129716;
	j1876176897 [label="Such a fate could wait for any of us. Even you.",shape=box,color=blue];
		j1876176897 -> j3819554275;
		j1876176897 -> j1710404739;
	j3142593989 [label="By all accounts he was a genius, and the mind behind the harnessing of argon crystals.",shape=box,color=red];
		j3142593989 -> j2309025262;
	j1625129716 [label="He told me that he was deeply concerned that Executor Ballas - whoever he may be - might discover my sect of heretics and have me executed.",shape=box,color=blue];
		j1625129716 -> j1548546100;
		j1625129716 -> j2533507045;
	j3819554275 [label="I just don't have the time to spend on him, I'm sorry.",shape=box,color=red];
		j3819554275 -> j837231574;
	j1710404739 [label="You're right, I'm sorry. I didn't mean that.",shape=box,color=red];
		j1710404739 -> j704808942;
	j2309025262 [label="Which are harnessed from the Void - they're the reason we can create a lot of the powerful warframes and weapons we make.",shape=box,color=red];
		j2309025262 -> j2748569049;
	j1548546100 [label="That... won't happen. Keep talking.",shape=box,color=red];
		j1548546100 -> j2965968195;
	j2533507045 [label="Ballas is dead... keep going.",shape=box,color=red];
		j2533507045 -> j2965968195;
	j837231574 [label="Then I am sorry for wasting more of it.",shape=box,color=blue];
		j837231574 -> j3007723528;
	j2748569049 [label="He specialized in crystallography. And his works were archived here, in the laboratories.",shape=box,color=red];
		j2748569049 -> j2271988003;
	j2965968195 [label="+5 Chemistry",color=orange];
		j2965968195 -> j3140225857;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j2271988003 [label="For some reason, I don't know why, he was turned into a Cephalon, and given his own necraloid shell.",shape=box,color=red];
		j2271988003 -> j1290296465;
	j3140225857 [label="I suspected... Well, he asked me where I was from, and when I told him, he laughed and said \"no, that's impossible! And I should know, I'm -\"",shape=box,color=blue];
		j3140225857 -> j900147119;
	j1290296465 [label="Not all Cephalons were made as a punishment. But things went... poorly here on Deimos, and he was badly damaged.",shape=box,color=red];
		j1290296465 -> j646397063;
	j900147119 [label="And then he... introduced himself to me again. And asked me if I was coming from the plaines with mineral samples...",shape=box,color=blue];
		j900147119 -> j178161149;
		j900147119 -> j555410930;
	j646397063 [label="Pauvre petit...",shape=box,color=blue];
		j646397063 -> j1698645168;
	j178161149 [label="Oh, Marie. I'm so sorry...",shape=box,color=red];
		j178161149 -> j1373594959;
	j555410930 [label="Yeah... that's Otak.",shape=box,color=red];
		j555410930 -> j1373594959;
	j1698645168 [label="Boolean MarieOtak1 is now true.",color=orange];
		j1698645168 -> j2789285016;
		j1698645168 -> j3613225810;
	j1373594959 [label="It shatters me into a million pieces to think there is nothing to be done for him.",shape=box,color=blue];
		j1373594959 -> j1970966774;
	j1970966774 [label="Evaluate expressions",color=orange];
		j1970966774 -> j3756919503 [label="MarieCephalonSoul",color=purple];
		j1970966774 -> j2756005940 [label="MarieCephalonNoSoul",color=purple];
		j1970966774 -> j2260124093 [label="MarieCephalonUnsure",color=purple];
		j1970966774 -> j2685913724 [label="false",color=purple];
	j3756919503 [label="Oh, Luminaries - what manner of hell have you made for him, to keep his soul trapped within that cage of science and flickering lights ?",shape=box,color=blue];
		j3756919503 -> j1500916643;
	j2756005940 [label="I can only pray to the Luminaries that you are right and nothing remains inside that shell but... but science and flickering lights.",shape=box,color=blue];
		j2756005940 -> j1456441865;
	j2260124093 [label="I know you are not sure if the Cephalons contain souls - but I can only pray to the Luminaries that... that poor Otak does not suffer.",shape=box,color=blue];
		j2260124093 -> j1709516013;
	j2685913724 [label="I can only pray to the Luminaries that all that remains inside that shell is nothing but... but science and flickering lights.",shape=box,color=blue];
		j2685913724 -> j3025777707;
	j1500916643 [label="Why leave him there, broken and waiting until he is allowed to die to be given peace? I can only pray... that if there is some kind of presence there -",shape=box,color=blue];
		j1500916643 -> j1257257350;
	j1456441865 [label="And no soul is trapped within that broken thing, waiting until it is allowed to finally die to be given peace.",shape=box,color=blue];
		j1456441865 -> j1405818521;
	j1709516013 [label="That no soul is trapped within that broken thing, waiting until it is allowed to finally die to be given peace.",shape=box,color=blue];
		j1709516013 -> j1289323119;
	j3025777707 [label="And no soul is trapped within that broken thing, waiting until it is allowed to finally die to be given peace.",shape=box,color=blue];
		j3025777707 -> j1289323119;
	j1257257350 [label="It is because he remains by choice as some kind of lonely vigil...",shape=box,color=blue];
		j1257257350 -> j2028661082;
	j1405818521 [label="Because if you are wrong, and a soul remains within that cage against its will ?",shape=box,color=blue];
		j1405818521 -> j1978398003;
	j1289323119 [label="Or if there is some kind of presence there, it is because he remains by choice as some manner of lonely vigil.",shape=box,color=blue];
		j1289323119 -> j2028661082;
	j2028661082 [label="To think otherwise is enough to make one question the kindness of the gods, non ?",shape=box,color=blue];
		j2028661082 -> j3000579249;
	j1978398003 [label="It is enough to make one question the kindness of the gods, non ?",shape=box,color=blue];
		j1978398003 -> j3000579249;
	j3000579249 [label="And then where would I be ?",shape=box,color=blue];
		j3000579249 -> j368858900;
	j368858900 [label="Forgive me, I am... je suis mélancolique aujourd'hui.",shape=box,color=blue];
		j368858900 -> j4190999030;
	j4190999030 [label="Evaluate expressions",color=orange];
		j4190999030 -> j2639823184 [label="MarieRoathePastry1",color=purple];
		j4190999030 -> j2920137243 [label="MarieRoathePastry1",color=purple];
		j4190999030 -> j450613426 [label="MarieRoathePastry1",color=purple];
		j4190999030 -> j3707070222 [label="MarieRoathePastry1",color=purple];
