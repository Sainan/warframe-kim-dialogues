		j4190999030 -> j2920137243 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j450613426 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j3707070222 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j2639823184 [label="false",color=purple];
		j4190999030 -> j450613426 [label="false",color=purple];
		j4190999030 -> j3707070222 [label="false",color=purple];
	j2639823184 [label="Anything I can do to cheer you up? We could go torment Roathe.",shape=box,color=red];
		j2639823184 -> j1697204910;
	j2920137243 [label="Anything I can do to cheer you up? Maybe steal some pastries?",shape=box,color=red];
		j2920137243 -> j403170989;
	j450613426 [label="Sometimes the gods are cruel, Marie. That's just life.",shape=box,color=red];
		j450613426 -> j431517173;
	j3707070222 [label="It's okay. You have every right to be.",shape=box,color=red];
		j3707070222 -> j1098414547;
	j1697204910 [label="+15 Chemistry",color=orange];
		j1697204910 -> j3442356501;
	j403170989 [label="+20 Chemistry",color=orange];
		j403170989 -> j3442356501;
	j431517173 [label="+5 Chemistry",color=orange];
		j431517173 -> j3993896340;
	j1098414547 [label="+20 Chemistry",color=orange];
		j1098414547 -> j2616391841;
	j3442356501 [label="Ha ! Merci. That is sure to stop these foolish tears of mine. You do know how to cheer silly little Marie, non ?",shape=box,color=blue];
		j3442356501 -> j1721468518;
		j3442356501 -> j4278153021;
	j3993896340 [label="Oui. You are quite right. They are. The world is full of no end of stories like that of Monsieur Otak, and many far worse than his. I should not weep over one. ",shape=box,color=blue];
		j3993896340 -> j4132295851;
	j2616391841 [label="Merci. Well, I no longer wish to be. I am going to go do something more cheerful ! I think M'sieur Fibonacci's tank is due for a dusting.",shape=box,color=blue];
		j2616391841 -> j2425134241;
	j1721468518 [label="You're not being silly at all. I feel the same way.",shape=box,color=red];
		j1721468518 -> j2235898819;
	j4278153021 [label="It's the very least I can do for you.",shape=box,color=red];
		j4278153021 -> j2235898819;
	j4132295851 [label="Yet here I sit, doing just that. Thank you for reminding me of my foolishness. Fie ! Silly little Marie. Well... I think M'sieur Fibonacci's tank is due for a dusting.",shape=box,color=blue];
		j4132295851 -> j2425134241;
	j2425134241 [label="Check boolean MarieDating",color=orange];
		j2425134241 -> j4168335523 [label=true,color=green];
		j2425134241 -> j1783435543 [label=false,color=brown];
	j2235898819 [label="+5 Chemistry",color=orange];
		j2235898819 -> j4093292054;
	j4168335523 [label="À la revoyure, my wolf.",shape=box,color=blue];
		j4168335523 -> j3007723528;
	j1783435543 [label="À la revoyure !",shape=box,color=blue];
		j1783435543 -> j3007723528;
	j4093292054 [label="Check boolean MarieDating",color=orange];
		j4093292054 -> j1927676598 [label=true,color=green];
		j4093292054 -> j2093572631 [label=false,color=brown];
	j1927676598 [label="Merci, merci, merci, my wolf. Let us go, then, and make mischief. ",shape=box,color=blue];
		j1927676598 -> j3007723528;
