digraph {
	"MarieRank5Convo5 begins." [color=orange];
		"MarieRank5Convo5 begins." -> j20182927;
	j20182927 [label="Check boolean MarieDating",color=orange];
		j20182927 -> j2438415941 [label=true,color=green];
		j20182927 -> j2480201904 [label=false,color=brown];
	j2438415941 [label="Bonjour, bonjour, mon cœur ! I have to tell you the silliest thing.",shape=box,color=blue];
		j2438415941 -> j3715580324;
		j2438415941 -> j242691715;
	j2480201904 [label="Bonjour ! I have to tell you the silliest thing.",shape=box,color=blue];
		j2480201904 -> j3715580324;
		j2480201904 -> j242691715;
	j3715580324 [label="Oh? What happened?",shape=box,color=red];
		j3715580324 -> j402847595;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j402847595 [label="I asked M'sieur Bird Trois what his birthday was, and he did not know ! How terribly sad !",shape=box,color=blue];
		j402847595 -> j261110602;
	"Chat ends." [color=orange];
	j261110602 [label="None of the Cavia know their birthdays, which I suppose makes sense, given that they were born without the ability to speak or know the calendrier as we do.",shape=box,color=blue];
		j261110602 -> j4042041477;
	j4042041477 [label="So I thought, what a tragédie ! We must right this at once, non ?",shape=box,color=blue];
		j4042041477 -> j121202655;
		j4042041477 -> j3730322367;
		j4042041477 -> j4091678850;
	j121202655 [label="I never thought about that.",shape=box,color=red];
		j121202655 -> j2728169168;
	j3730322367 [label="How will you discover when they were born?",shape=box,color=red];
		j3730322367 -> j1191292463;
	j4091678850 [label="Will you let them pick their birthdays?",shape=box,color=red];
		j4091678850 -> j3553632443;
	j2728169168 [label="Oui ! Neither had Monsieur Loid. The look on his face when I discovered this was of pure sorrow...",shape=box,color=blue];
		j2728169168 -> j355260187;
	j1191292463 [label="At first, I thought to check le Cardinal's records - perhaps he recorded when they were born, oui ?",shape=box,color=blue];
		j1191292463 -> j2402114516;
	j3553632443 [label="\"Let ?\" You say it as if it is up to me ! ",shape=box,color=blue];
		j3553632443 -> j1191292463;
	j355260187 [label="It breaks my heart that he thinks it is his fault for not thinking of it first. It is not his fault, he does so much for so many...",shape=box,color=blue];
		j355260187 -> j4154024463;
	j2402114516 [label="Evaluate expressions",color=orange];
		j2402114516 -> j1945792765 [label="MarieEntratiComplete",color=purple];
		j2402114516 -> j1945792765 [label="MarieEntrati3a",color=purple];
		j2402114516 -> j4200274838 [label="false",color=purple];
	j4154024463 [label="We are all blessed to know the kindness of Monsieur Loid. The depth of the well he draws from knows no end.",shape=box,color=blue];
		j4154024463 -> j1995498182;
		j4154024463 -> j4237964604;
	j1945792765 [label="But then I remembered... my conversations with M'sieur Tagfer, and the others, and I thought... that may not be so wise.",shape=box,color=blue];
		j1945792765 -> j1893600756;
	j4200274838 [label="But they seemed uninterested in finding records of their past. I know how painful it can be, to think of one's origins.",shape=box,color=blue];
		j4200274838 -> j1893600756;
	j1995498182 [label="We really are lucky he's here.",shape=box,color=red];
		j1995498182 -> j3216291545;
	j4237964604 [label="I just wish he'd cheer up a bit from time to time.",shape=box,color=red];
		j4237964604 -> j2538303403;
	j1893600756 [label="I do not know my own day of birth, after all. ",shape=box,color=blue];
		j1893600756 -> j3709850919;
		j1893600756 -> j3672014979;
		j1893600756 -> j2559342319;
	j3216291545 [label="Oui, that we are. That we all are.",shape=box,color=blue];
		j3216291545 -> j3542593548;
	j2538303403 [label="He is a serious man, but I have seen him smile. There is humor in him, when one least expects it. One just has to be patient.",shape=box,color=blue];
		j2538303403 -> j3542593548;
	j3709850919 [label="If it makes you feel any better, neither do I. I suspect the kid doesn't remember, either.",shape=box,color=red];
		j3709850919 -> j1552066127;
	j3672014979 [label="Birthdays are overrated.",shape=box,color=red];
		j3672014979 -> j1524743498;
	j2559342319 [label="It's more fun to pick your own, anyway. More poignant. ",shape=box,color=red];
		j2559342319 -> j960451503;
	j3542593548 [label="Check boolean MarieDating",color=orange];
		j3542593548 -> j1931232019 [label=true,color=green];
		j3542593548 -> j3257135747 [label=false,color=brown];
	j1552066127 [label="More reasons to weep for you and your minuscule copie. Yet more things we have in common !",shape=box,color=blue];
		j1552066127 -> j3542593548;
	j1524743498 [label="I do not believe they are overrated at all ! We must celebrate those that are still with us, the same that we celebrate those who are gone.",shape=box,color=blue];
		j1524743498 -> j3542593548;
	j960451503 [label="Poignant ? I did not know you spoke any Gaullique ! Did you pick that up from me ?",shape=box,color=blue];
		j960451503 -> j721135628;
		j960451503 -> j1243924208;
	j1931232019 [label="+20 Chemistry",color=orange];
		j1931232019 -> j1084951341;
	j3257135747 [label="+20 Chemistry",color=orange];
		j3257135747 -> j505397393;
	j721135628 [label="I... think it's just the same in both languages...",shape=box,color=red];
		j721135628 -> j3322466742;
	j1243924208 [label="I must have picked it up from you.",shape=box,color=red];
		j1243924208 -> j1969145593;
	j1084951341 [label="Now ! Come along, mon cœur ! Even if nothing ever comes of this, it is always the thought that counts ! Au calendrier !",shape=box,color=blue];
		j1084951341 -> "Chat ends.";
	j505397393 [label="Now ! Come along ! Even if nothing ever comes of this, it is the thought that counts ! Au calendrier !",shape=box,color=blue];
		j505397393 -> "Chat ends.";
	j3322466742 [label="Pff ! All the other languages are always stealing the best parts of Gaullique and running away with it ! Times will never change !",shape=box,color=blue];
		j3322466742 -> j3542593548;
	j1969145593 [label="Then you are smart ! Gaullique is one of the most beautiful languages to ever be, and I am glad to bring it to this futur.",shape=box,color=blue];
		j1969145593 -> j3542593548;
}