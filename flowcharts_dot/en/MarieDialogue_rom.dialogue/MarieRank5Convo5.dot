		3092 -> 3094 [label=false,color=brown];
	3093 [label="Bonjour, bonjour, mon cœur ! I have to tell you the silliest thing.",shape=box,color=blue];
		3093 -> 3095;
		3093 -> 3096;
	3094 [label="Bonjour ! I have to tell you the silliest thing.",shape=box,color=blue];
		3094 -> 3095;
		3094 -> 3096;
	3095 [label="Oh? What happened?",shape=box,color=red];
		3095 -> 3097;
	3096 [label="[End.]",shape=box,color=red];
		3096 -> 3098;
	3097 [label="I asked M'sieur Bird Trois what his birthday was, and he did not know ! How terribly sad !",shape=box,color=blue];
		3097 -> 3099;
	3098 [label="Chat ends.",color=orange];
	3099 [label="None of the Cavia know their birthdays, which I suppose makes sense, given that they were born without the ability to speak or know the calendrier as we do.",shape=box,color=blue];
		3099 -> 3100;
	3100 [label="So I thought, what a tragédie ! We must right this at once, non ?",shape=box,color=blue];
		3100 -> 3101;
		3100 -> 3102;
		3100 -> 3103;
	3101 [label="I never thought about that.",shape=box,color=red];
		3101 -> 3104;
	3102 [label="How will you discover when they were born?",shape=box,color=red];
		3102 -> 3105;
	3103 [label="Will you let them pick their birthdays?",shape=box,color=red];
		3103 -> 3106;
	3104 [label="Oui ! Neither had Monsieur Loid. The look on his face when I discovered this was of pure sorrow...",shape=box,color=blue];
		3104 -> 3107;
	3105 [label="At first, I thought to check le Cardinal's records - perhaps he recorded when they were born, oui ?",shape=box,color=blue];
		3105 -> 3108;
	3106 [label="\"Let ?\" You say it as if it is up to me ! ",shape=box,color=blue];
		3106 -> 3105;
	3107 [label="It breaks my heart that he thinks it is his fault for not thinking of it first. It is not his fault, he does so much for so many...",shape=box,color=blue];
		3107 -> 3109;
	3108 [label="Evaluate expressions",color=orange];
		3108 -> 3110 [label="MarieEntratiComplete",color=purple];
		3108 -> 3110 [label="MarieEntrati3a",color=purple];
		3108 -> 3111 [label="false",color=purple];
	3109 [label="We are all blessed to know the kindness of Monsieur Loid. The depth of the well he draws from knows no end.",shape=box,color=blue];
		3109 -> 3112;
		3109 -> 3113;
	3110 [label="But then I remembered... my conversations with M'sieur Tagfer, and the others, and I thought... that may not be so wise.",shape=box,color=blue];
		3110 -> 3114;
	3111 [label="But they seemed uninterested in finding records of their past. I know how painful it can be, to think of one's origins.",shape=box,color=blue];
		3111 -> 3114;
	3112 [label="We really are lucky he's here.",shape=box,color=red];
		3112 -> 3115;
	3113 [label="I just wish he'd cheer up a bit from time to time.",shape=box,color=red];
		3113 -> 3116;
	3114 [label="I do not know my own day of birth, after all. ",shape=box,color=blue];
		3114 -> 3117;
		3114 -> 3118;
		3114 -> 3119;
	3115 [label="Oui, that we are. That we all are.",shape=box,color=blue];
		3115 -> 3120;
	3116 [label="He is a serious man, but I have seen him smile. There is humor in him, when one least expects it. One just has to be patient.",shape=box,color=blue];
		3116 -> 3120;
	3117 [label="If it makes you feel any better, neither do I. I suspect the kid doesn't remember, either.",shape=box,color=red];
		3117 -> 3121;
	3118 [label="Birthdays are overrated.",shape=box,color=red];
		3118 -> 3122;
	3119 [label="It's more fun to pick your own, anyway. More poignant. ",shape=box,color=red];
		3119 -> 3123;
	3120 [label="Check boolean MarieDating",color=orange];
		3120 -> 3125 [label=true,color=green];
		3120 -> 3124 [label=false,color=brown];
	3121 [label="More reasons to weep for you and your minuscule copie. Yet more things we have in common !",shape=box,color=blue];
		3121 -> 3120;
	3122 [label="I do not believe they are overrated at all ! We must celebrate those that are still with us, the same that we celebrate those who are gone.",shape=box,color=blue];
		3122 -> 3120;
	3123 [label="Poignant ? I did not know you spoke any Gaullique ! Did you pick that up from me ?",shape=box,color=blue];
		3123 -> 3126;
		3123 -> 3127;
	3125 [label="+20 Chemistry",color=orange];
		3125 -> 3129;
	3124 [label="+20 Chemistry",color=orange];
		3124 -> 3128;
	3126 [label="I... think it's just the same in both languages...",shape=box,color=red];
		3126 -> 3130;
	3127 [label="I must have picked it up from you.",shape=box,color=red];
		3127 -> 3131;
	3129 [label="Now ! Come along, mon cœur ! Even if nothing ever comes of this, it is always the thought that counts ! Au calendrier !",shape=box,color=blue];
		3129 -> 3132;
	3128 [label="Now ! Come along ! Even if nothing ever comes of this, it is the thought that counts ! Au calendrier !",shape=box,color=blue];
		3128 -> 3132;
	3130 [label="Pff ! All the other languages are always stealing the best parts of Gaullique and running away with it ! Times will never change !",shape=box,color=blue];
		3130 -> 3120;
	3131 [label="Then you are smart ! Gaullique is one of the most beautiful languages to ever be, and I am glad to bring it to this futur.",shape=box,color=blue];
		3131 -> 3120;
	3132 [label="Chat ends.",color=orange];
}