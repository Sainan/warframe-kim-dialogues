	j1591510439 [label="Evaluate expressions",color=orange];
		j1591510439 -> j1646882807 [label="DrifterFaithSol",color=purple];
		j1591510439 -> j2171490718 [label="DrifterFaithLua",color=purple];
		j1591510439 -> j4029835507 [label="DrifterFaithBalance",color=purple];
		j1591510439 -> j2905031795 [label="false",color=purple];
	j3895630915 [label="I have only been told of the Infestation, I know little of it... but I believe you. And if what I feel is the truth, and I pray that it is, I do not think she is trapped.",shape=box,color=blue];
		j3895630915 -> j1649214086;
	j2410184603 [label="That is quite sweet of you to say. If what I feel is the truth, and I pray that she is, then oui, I think you are right. I do not think she is trapped.",shape=box,color=blue];
		j2410184603 -> j1649214086;
	j3772528502 [label="If what I feel is the truth, and I pray that it is, then non, I do not think she is trapped.",shape=box,color=blue];
		j3772528502 -> j1649214086;
	j4009656619 [label="If what I feel is the truth, and I pray that it is, then oui, you are right. And they stay to help us. I do not think she is trapped.",shape=box,color=blue];
		j4009656619 -> j1649214086;
	j2473888167 [label="Oui, I have been blessed by le Cardinal... but I know I am near to singular in my love for him, for it is not sullied by sorrow, hatred, or resentment.",shape=box,color=blue];
		j2473888167 -> j3549756185;
	j3345931755 [label="I know you think him to be some kind of terrible monster. But I must ask, what made you distrust him so ?",shape=box,color=blue];
		j3345931755 -> j1903281366;
		j3345931755 -> j1124144154;
		j3345931755 -> j4219060525;
	j2294330998 [label="I thought you believed in him ? Why the sudden change in heart ? Are you so fickle ? ",shape=box,color=blue];
		j2294330998 -> j887794037;
		j2294330998 -> j3439434945;
	j477662274 [label="Why do you distrust him so ?",shape=box,color=blue];
		j477662274 -> j1903281366;
		j477662274 -> j4219060525;
		j477662274 -> j1124144154;
	j4199531101 [label="Oui, and so quickly you change your mind ? You lie. To what ends, I do not know. Et je ne veux pas le savoir.",shape=box,color=blue];
		j4199531101 -> j1508231473;
	j2354187127 [label="+5 Chemistry",color=orange];
		j2354187127 -> j2708029370;
	j3474288705 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j3474288705 -> j2708029370;
	j1646882807 [label="For those of us who follow the path of Sol, we must always be the guiding light to those who seek to walk from the crossroads, non ? ",shape=box,color=blue];
		j1646882807 -> j4000587011;
	j2171490718 [label="You are a follower of Lua, you should know we teach that some must walk in shadows alone, oui ?",shape=box,color=blue];
		j2171490718 -> j4000587011;
	j4029835507 [label="You are a follower of the Luminaries, you should know that we teach that some walk the unknown roads alone, oui ?",shape=box,color=blue];
		j4029835507 -> j4000587011;
	j2905031795 [label="In my faith, we know of those who walk the roads of life, and find themselves at the crossroads where Lua and Sol meet. ",shape=box,color=blue];
		j2905031795 -> j4000587011;
	j1649214086 [label="From her, I only feel the warmth of Sol's smile upon me. Le Cardinal was wise, I think, in his choice. I am honored to carry her in my veins.",shape=box,color=blue];
		j1649214086 -> j501053258;
		j1649214086 -> j260148839;
		j1649214086 -> j1448538005;
		j1649214086 -> j80161438;
	j3549756185 [label="I forgive him for leaving us. I do not think anyone else does...",shape=box,color=blue];
		j3549756185 -> j4236641740;
		j3549756185 -> j104362295;
		j3549756185 -> j1903281366;
		j3549756185 -> j4219060525;
	j1903281366 [label="He... came to Duviri. A long time ago...",shape=box,color=red];
		j1903281366 -> j4287364328;
	j1124144154 [label="Well, to start, he shot me in the chest and left me for dead.",shape=box,color=red];
		j1124144154 -> j3916424189;
	j4219060525 [label="He leaves nothing but pain, death, and abandonment in his wake.",shape=box,color=red];
		j4219060525 -> j1591510439;
	j887794037 [label="I've never trusted him, I just didn't want to scare you off.",shape=box,color=red];
		j887794037 -> j3992737367;
	j3439434945 [label="I didn't mean to lie earlier, I just didn't know how to approach the subject. You clearly adore him...",shape=box,color=red];
		j3439434945 -> j1020376934;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j2708029370 [label="Yes, we must stay strong ! Braves contre les ténèbres, pour toujours et à jamais !",shape=box,color=blue];
		j2708029370 -> j2139679780;
	j4000587011 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j4000587011 -> j2706317822;
	j4236641740 [label="He's hurt and abandoned a lot of people, you're right. And I think he feels like he's had to.",shape=box,color=red];
		j4236641740 -> j1763819378;
	j104362295 [label="It's hard, when someone who means that much to you - who you love and rely on, goes away. Especially if you don't know why. Or they don't come back.",shape=box,color=red];
		j104362295 -> j78613391;
	j4287364328 [label="Sol ! This world that you made, summoned from the book his daughter wrote, oui ? Monsieur Loid spoke of it... Le Cardinal was there ? Why ? ",shape=box,color=blue];
		j4287364328 -> j4220937341;
		j4287364328 -> j2610736565;
		j4287364328 -> j2776269686;
	j3916424189 [label="Et pourtant, vous êtes toujours en vie ! You are alive, are you not ? And well? And thriving, if Monsieur Loid's tales of your adventures in the past-future are to be believed.",shape=box,color=blue];
		j3916424189 -> j4231093281;
	j3992737367 [label="Ah, je vois ! Je suis une idiote, c'est ça ?! Juste une petite invalide venue d'un passé lointain, incapable de penser par elle-même ?! Mieux vaut l'approcher comme un faon dans les bois, de peur de l'effrayer !",shape=box,color=blue];
		j3992737367 -> j2523403966;
	j1020376934 [label="Ah, oui... I have not made it easy for you to speak the truth, n'est-ce pas ?",shape=box,color=blue];
		j1020376934 -> j2804914613;
	j2139679780 [label="I have forgiven him for leaving us. I do not think anyone else does...",shape=box,color=blue];
		j2139679780 -> j4236641740;
		j2139679780 -> j104362295;
	j2706317822 [label="Le Cardinal must find his way back to us. We can only do what we can to help him when he calls, and do as we are bid by those who are blessed as he.",shape=box,color=blue];
		j2706317822 -> j989297039;
	j1763819378 [label="+5 Chemistry",color=orange];
		j1763819378 -> j2832775457;
	j78613391 [label="+5 Chemistry",color=orange];
		j78613391 -> j3854774098;
	j4220937341 [label="I think at first, some part of him was there seeking a bit of the daughter he left behind. But instead, he found a way to fight the Indifference - with the emotions he sought to distance himself from.",shape=box,color=red];
		j4220937341 -> j4077772358;
	j2610736565 [label="His notes tell a very obnoxiously self-flattering story of how he went to study conceptual embodiment and instead came away learning the value of fighting the Indifference.",shape=box,color=red];
		j2610736565 -> j3950272313;
	j2776269686 [label="If his notes are to be believed, he was there to teach Duviri - and by extension me, how to defend against the Indifference. For what good it did in the end.",shape=box,color=red];
		j2776269686 -> j4175742971;
	j4231093281 [label="Check boolean IsDating",color=orange];
		j4231093281 -> j1798627189 [label=true,color=green];
		j4231093281 -> j794390499 [label=false,color=brown];
	j2523403966 [label="Va t'asseoir sur une ruche.",shape=box,color=blue];
		j2523403966 -> j1508231473;
	j2804914613 [label="Tell me the truth now then, wolf. Why do you believe he is not to be trusted? And I shall aspire to keep my temper.",shape=box,color=blue];
		j2804914613 -> j104362295;
		j2804914613 -> j1903281366;
		j2804914613 -> j4219060525;
		j2804914613 -> j1124144154;
	j989297039 [label="Evaluate expressions",color=orange];
		j989297039 -> j1819977067 [label="MarieEntratiMonster1",color=purple];
		j989297039 -> j1262794455 [label="MarieEntratiMonster1",color=purple];
		j989297039 -> j1819977067 [label="MarieEntratiFan1",color=purple];
		j989297039 -> j2387330371 [label="MarieEntratiFan1",color=purple];
		j989297039 -> j1819977067 [label="false",color=purple];
		j989297039 -> j1262794455 [label="false",color=purple];
		j989297039 -> j2387330371 [label="false",color=purple];
		j989297039 -> j3819575964 [label="false",color=purple];
	j2832775457 [label="Oui, you are correct. I think guilt haunts his him for all he has done. I think he distances himself from others very much intentionally.",shape=box,color=blue];
		j2832775457 -> j3852340984;
	j3854774098 [label="Oui, it is a terrible grief, an awful pain. To know that someone is... still alive, and seemingly chooses not to be beside you ?",shape=box,color=blue];
		j3854774098 -> j3852340984;
	j4077772358 [label="Mon cœur se brise dans la tragédie - I do not think I can take the sadness of that... and still, she will not forgive him ?",shape=box,color=blue];
		j4077772358 -> j2507584839;
		j4077772358 -> j446750294;
	j3950272313 [label="Do you know why he left ?",shape=box,color=blue];
		j3950272313 -> j2507584839;
		j3950272313 -> j1681027231;
	j4175742971 [label="What do you mean ? ",shape=box,color=blue];
		j4175742971 -> j1211718625;
		j4175742971 -> j3264158560;
	j1798627189 [label="Indeed if the rumors amongst the Cavia are true, vous y avez vraiment trouvé beaucoup de joie, non ?",shape=box,color=blue];
		j1798627189 -> j794390499;
	j794390499 [label="Non, le Cardinal has done far worse to many others, you are simply upset for being inconvenienced.",shape=box,color=blue];
		j794390499 -> j1591510439;
	j1819977067 [label="I just wish... we could get everyone around Entrati to stop blaming themselves and each other for what's happened.",shape=box,color=red];
		j1819977067 -> j4086520061;
	j1262794455 [label="I don't know as I'd ever call him blessed.",shape=box,color=red];
		j1262794455 -> j1782202851;
	j2387330371 [label="It would be a lot easier to forgive Entrati for his misdeeds if I could understand them.",shape=box,color=red];
		j2387330371 -> j2213915163;
	j3819575964 [label="I'll do what he needs me to do, to solve this problem. And then I'll judge him, when all is said and done.",shape=box,color=red];
		j3819575964 -> j4292917634;
	j3852340984 [label="Il inflige la douleur dans le cœur des autres, car la douleur vaut mieux que rien du tout. For suffering is better than emptiness, non ?",shape=box,color=blue];
		j3852340984 -> j3818428833;
	j2507584839 [label="When he doesn't explain himself, all we can do is make up our own reasons, I'm afraid.",shape=box,color=red];
		j2507584839 -> j2166422747;
	j446750294 [label="You're missing the point. He left me there. He saw someone abandoned in the Void, and he left me there.",shape=box,color=red];
		j446750294 -> j2667719376;
	j1681027231 [label="No. I just know that he left me there. He saw someone abandoned in the Void, and just... left me there.",shape=box,color=red];
		j1681027231 -> j2166422747;
	j1211718625 [label="He left me there. He arrived, at some point I don't know - and saw someone abandoned in the Void, and... left me there.",shape=box,color=red];
		j1211718625 -> j2667719376;
	j3264158560 [label="The Indifference came for Duviri anyway, in the end. (Although, it had unexpected help. But that's neither here nor there.)",shape=box,color=red];
		j3264158560 -> j500691144;
	j4086520061 [label="Boolean MarieEntratiFamily is now true.",color=orange];
		j4086520061 -> j2506986389;
	j1782202851 [label="Then we might continue to agree to disagree, I think.",shape=box,color=blue];
		j1782202851 -> j2292425301;
	j2213915163 [label="I pray in the end that we do. I pray that in the end we all survive to see it. But for now, I see the famille around me, and pray they find forgiveness in their hearts. For their own happiness.",shape=box,color=blue];
		j2213915163 -> j1661061678;
	j4292917634 [label="+10 Chemistry",color=orange];
		j4292917634 -> j390063966;
	j3818428833 [label="That is a lesson that my dearest Lyon knows more than most... I am so glad he is speaking to you now. But we speak of le Cardinal this day.",shape=box,color=blue];
		j3818428833 -> j221931327;
	j2166422747 [label="I can only assume this happened before the... murder ad infinitum.",shape=box,color=red];
		j2166422747 -> j2393206491;
	j2667719376 [label="And you do not know why he left you there ?",shape=box,color=blue];
		j2667719376 -> j1822002205;
		j2667719376 -> j2166422747;
		j2667719376 -> j1417071543;
	j500691144 [label="Non. Wait. L'Indifférence has... an ally ?",shape=box,color=blue];
