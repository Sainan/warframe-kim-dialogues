	j303027499 [label="Tell me, wolf, of this one called \"Wisp\" whose corrupted blood flows within me, who has given me this gift of flight, and whose soul I feel in the shadow of the night so closely next to mine own.",shape=box,color=blue];
		j303027499 -> j3164008886;
		j303027499 -> j2113855798;
	j169314755 [label="Tell me, wolf, of this one called \"Wisp\" whose corrupted blood flows within me, who has given me this gift of flight, and whose soul I feel in the shadow of the night so closely next to mine own.",shape=box,color=blue];
		j169314755 -> j4034498569;
	j3850694665 [label="Vraiment ? Are the records lost over time, or do you suspect they were simply deemed not important enough to remember ?",shape=box,color=blue];
		j3850694665 -> j2817406162;
		j3850694665 -> j586479668;
		j3850694665 -> j3733920290;
	j3164008886 [label="We don't know very much about the people who were turned into the original warframes, I'm afraid.",shape=box,color=red];
		j3164008886 -> j3217516764;
	j2113855798 [label="There isn't much known about the original Wisp, I'm afraid.",shape=box,color=red];
		j2113855798 -> j3217516764;
	j4034498569 [label="If the discussion of souls does not trouble you ? I understand if it shall, and we can curtail it to more practical things, I do not wish to make you uncomfortable.",shape=box,color=blue];
		j4034498569 -> j622853410;
		j4034498569 -> j69263893;
		j4034498569 -> j242691715;
	j2817406162 [label="I think they weren't important enough to remember.",shape=box,color=red];
		j2817406162 -> j778640350;
	j586479668 [label="I think they were lost over time.",shape=box,color=red];
		j586479668 -> j778640350;
	j3733920290 [label="A little bit of both, in the end. They were... part weapon, part artwork, to their primary creator.",shape=box,color=red];
		j3733920290 -> j916502181;
	j3217516764 [label="Vraiment ? For I feel as though I know her as if she were my own sister - and one of my own blood, not one of the Cathédrale.",shape=box,color=blue];
		j3217516764 -> j3168874569;
	j622853410 [label="It's all right, we can talk about souls.",shape=box,color=red];
		j622853410 -> j3164008886;
		j622853410 -> j2113855798;
		j622853410 -> j242691715;
	j69263893 [label="I don't really believe in souls, so we should keep it to hard facts, if possible?",shape=box,color=red];
		j69263893 -> j308042050;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j778640350 [label="You see ? Ces Orokin, they are devils.",shape=box,color=blue];
		j778640350 -> j292174700;
		j778640350 -> j1087617113;
	j916502181 [label="+5 Chemistry",color=orange];
		j916502181 -> j870100841;
	j3168874569 [label="I do not hear her, not the way Lyon hears the gods and his patron spirits. I do not see her. I simply feel her there, beside me.",shape=box,color=blue];
		j3168874569 -> j1196006645;
	j308042050 [label="Boolean DrifterFaithStop is now true.",color=orange];
		j308042050 -> j2344433983;
	"Chat ends." [color=orange];
	j292174700 [label="Weapons can be used to protect as well as to harm. We don't like that we need them, but... we do.",shape=box,color=red];
		j292174700 -> j2380413616;
	j1087617113 [label="Not all of them. But that one? Yes. There are still some around that I wouldn't condemn immediately.",shape=box,color=red];
		j1087617113 -> j809119197;
	j870100841 [label="Une horrible toile d'os peinte avec du sang... you see ? Ces Orokin, they are devils.",shape=box,color=blue];
		j870100841 -> j292174700;
		j870100841 -> j1087617113;
	j1196006645 [label="Like an old friend, perhaps. I know what she liked, I know how she moved. I remember the sound of her laughter on the wind...",shape=box,color=blue];
		j1196006645 -> j1406819586;
	j2344433983 [label="+5 Chemistry",color=orange];
		j2344433983 -> j18847921;
	j2380413616 [label="Add -1 to Thermostat counter",color=orange];
		j2380413616 -> j2988317971;
	j809119197 [label="Add 1 to Thermostat counter",color=orange];
		j809119197 -> j3467976608;
	j1406819586 [label="I must sound quite mad to you ! Forgive me.",shape=box,color=blue];
		j1406819586 -> j91512059;
		j1406819586 -> j4005996361;
		j1406819586 -> j377875807;
		j1406819586 -> j3832751860;
	j18847921 [label="Oui, bien sûr ! No one wishes to be lectured, least of all by a Sister. I understand. Merci, I would not have wanted to make a fool of myself.",shape=box,color=blue];
		j18847921 -> j4180710809;
		j18847921 -> j453861141;
		j18847921 -> j242691715;
	j2988317971 [label="Yes, that is true. I am a weapon now, as the Murmure well know ! But I seek to follow the path le Cardinal put me upon, blessed as it is.",shape=box,color=blue];
		j2988317971 -> j1448538005;
		j2988317971 -> j80161438;
	j3467976608 [label="Like le Cardinal. He was Orokin, non ? And he certainly is not one I would condemn. Without him, I would not be as I am now. Blessed.",shape=box,color=blue];
		j3467976608 -> j260148839;
		j3467976608 -> j501053258;
	j91512059 [label="Warframes were... not made in the kindest of ways. I just hope she's not trapped inside the Infestation.",shape=box,color=red];
		j91512059 -> j16471662;
	j4005996361 [label="I think that whoever Wisp was, she would be happy to know you.",shape=box,color=red];
		j4005996361 -> j1648401582;
	j377875807 [label="I hope their souls have been able to move on and be at rest, but I think some part of their memory remains.",shape=box,color=red];
		j377875807 -> j1384019495;
	j3832751860 [label="Not at all. I believe some part of the people who were turned into warframes remain within their core schematics.",shape=box,color=red];
		j3832751860 -> j2035882161;
	j1448538005 [label="There's a lot I could argue with him about, but I will say that he seems to have a good instinct about whom to give which protoframe serum. Even if I don't know why he does it.",shape=box,color=red];
		j1448538005 -> j500333549;
	j80161438 [label="I wish you wouldn't trust Entrati as much as you do. We don't know why he chooses to do what he does, and his motives are unclear.",shape=box,color=red];
		j80161438 -> j1722407835;
	j260148839 [label="We have to stick with Entrati. I think we have to just follow where he goes. He's our only chance of stopping the Indifference.",shape=box,color=red];
		j260148839 -> j737842484;
	j501053258 [label="He's a liar, Marie. He abandons and hurts everyone in his life. He's already abandoned you, don't you see? ",shape=box,color=red];
		j501053258 -> j1591510439;
