		j1320247306 -> j277280602 [label="false",color=purple];
	j2591814240 [label="S'il te plaît, make it stop - soon I will find myself laughing at his jokes. Then I will know I am truly lost !",shape=box,color=blue];
		j2591814240 -> j758933647;
	j2188067330 [label="Have you thought anymore about how to convince Loid to talk to the Entrati family upstairs?",shape=box,color=red];
		j2188067330 -> j3487613436;
	j1992734845 [label="I've been thinking about how to convince Loid to go up those stairs to finally talk to the family, and... I have an idea, but I don't think you'll like it.",shape=box,color=red];
		j1992734845 -> j668862974;
	j2484074520 [label="Marie, are you still on board to... maybe try to convince Loid to talk to the \"upstairs neighbors?\" I know we left that off on a weird note.",shape=box,color=red];
		j2484074520 -> j374072022;
	j1959227478 [label="On the subject of trying to get Loid and the Entrati family talking, I was... wondering if you've reconsidered Roathe's involvement at all?",shape=box,color=red];
		j1959227478 -> j374072022;
	j277280602 [label="I have been thinking of how Monsieur Loid is so frightened of speaking to le Cardinal's family.",shape=box,color=blue];
		j277280602 -> j2414740099;
