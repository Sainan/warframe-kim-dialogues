		j374072022 -> j1509157920 [label=false,color=brown];
	j2414740099 [label="And how we must break this impasse. This purgatoire in which we are trapped should not stand. It seems so needlessly painful.",shape=box,color=blue];
		j2414740099 -> j575567590;
	j2768654365 [label="Boolean MarieWillDate is now true.",color=orange];
		j2768654365 -> "Chat ends.";
	j3136824322 [label="Bonjour mon cœur ! I have given it some thought... and I am truly loath to admit it. It gives me no pleasure to say this.",shape=box,color=blue];
		j3136824322 -> j3230780562;
	j4050060435 [label="Bonjour ! I have given it some thought... And I am truly loathe to admit it. It gives me no pleasure to say this.",shape=box,color=blue];
		j4050060435 -> j3230780562;
	j2454704479 [label="Bonjour, mon cœur ! And what are you afraid I will not like ?",shape=box,color=blue];
		j2454704479 -> j1792158576;
	j2324850311 [label="Bonjour ! Oh ? And what are you afraid I will not like ?",shape=box,color=blue];
		j2324850311 -> j1792158576;
	j894703259 [label="Bonjour, bonjour, mon cœur ! I have given it some thought... and I am truly loath to admit it. It gives me no pleasure to say this.",shape=box,color=blue];
		j894703259 -> j2087056778;
	j1509157920 [label="Bonjour - I have given it some thought... and I am truly loath to admit it. It gives me no pleasure to say this.",shape=box,color=blue];
		j1509157920 -> j2087056778;
	j575567590 [label="But I feel as though we need... a bastion of some kind, non ? Do you have any ideas ?",shape=box,color=blue];
		j575567590 -> j855915289;
		j575567590 -> j1792158576;
	j3230780562 [label="But I think... I think - ah, Sol forgive me - that the devil's assistance may be required. I do not think Monsieur Loid will listen to us otherwise.",shape=box,color=blue];
		j3230780562 -> j982922696;
	j1792158576 [label="I think we might need Roathe's help to convince Loid to talk to the Entrati family. I don't think he'll do it otherwise. Without assurances that the family, and he, will be protected.",shape=box,color=red];
		j1792158576 -> j2035575141;
	j2087056778 [label="I believe you may be right. The devil may be the missing piece we need. Ah, it pains me even to type the words ! ",shape=box,color=blue];
		j2087056778 -> j409794056;
	j855915289 [label="I don't really have any good ideas that doesn't involve taking help from terrible sources. Sources that might just get us into deep trouble later. Namely, Roathe.",shape=box,color=red];
		j855915289 -> j2818157382;
	j982922696 [label="The devil is powerful, and provides certain promises of strength should things go wrong, non ?",shape=box,color=blue];
		j982922696 -> j3082966535;
		j982922696 -> j2093488210;
	j2035575141 [label="I... hate to admit it, but I think you may be right... Sol forgive me.",shape=box,color=blue];
		j2035575141 -> j409794056;
	j409794056 [label="Evaluate expressions",color=orange];
		j409794056 -> j3157697569 [label="RoatheFamilyFail",color=purple];
		j409794056 -> j1606464815 [label="RoatheRedeemed, RoatheFamilyDelay
",color=purple];
		j409794056 -> j216004359 [label="RoatheVillain, RoatheFamilyDelay",color=purple];
		j409794056 -> j3363274699 [label="false",color=purple];
	j2818157382 [label="Are you so sure ? If I can set aside my différences with the devil, certainly so can you, non ?",shape=box,color=blue];
		j2818157382 -> j2196304565;
		j2818157382 -> j527458522;
	j3082966535 [label="You're right. I didn't think you'd agree to it. I was afraid to ask.",shape=box,color=red];
		j3082966535 -> j409794056;
	j2093488210 [label="No, there has to be another way. I refuse to ask for his help on this.",shape=box,color=red];
		j2093488210 -> j2818157382;
	j3157697569 [label="Will he give us his aid in this regard ?",shape=box,color=blue];
		j3157697569 -> j3769092663;
	j1606464815 [label="Will he give us his aid in this regard ?",shape=box,color=blue];
		j1606464815 -> j668391906;
	j216004359 [label="Will he give us his aid in this regard ?",shape=box,color=blue];
		j216004359 -> j1048884772;
	j3363274699 [label="Do you think you can convince him to help us, though ?",shape=box,color=blue];
		j3363274699 -> j1155758424;
		j3363274699 -> j3548717784;
	j2196304565 [label="All right. If you're okay with it, I'll be okay with it.",shape=box,color=red];
		j2196304565 -> j2417208406;
	j527458522 [label="No, I'm sorry. ",shape=box,color=red];
		j527458522 -> j1505693693;
	j3769092663 [label="No, unfortunately... I think that was a dead end with him. Do you think there's another way?",shape=box,color=red];
		j3769092663 -> j1939224710;
	j668391906 [label="He will. I've convinced him to help reunite them - and you won't believe this - I think it's so that he can help protect Entrati's family. They're all that really remains of the Orokin, after all.",shape=box,color=red];
		j668391906 -> j513485404;
	j1048884772 [label="He will. I've convinced him to help reunite them - and you won't be surprised by this - I think it's mostly to spite Albrecht in his absence.",shape=box,color=red];
		j1048884772 -> j2969054108;
	j1155758424 [label="I'm still working on it, but I think so.",shape=box,color=red];
		j1155758424 -> j961489522;
	j3548717784 [label="Nothing is settled yet. He's... well, you know how he can be.",shape=box,color=red];
		j3548717784 -> j3827853471;
	j2417208406 [label="Oui, I do not have to enjoy it, but it is un médicament we must swallow, I suppose.",shape=box,color=blue];
		j2417208406 -> j409794056;
	j1505693693 [label="+20 Chemistry",color=orange];
		j1505693693 -> j3033577955;
	j1939224710 [label="Oh ! That is... unfortunate. I do not know ? I do not think so... Can you think of another approach with the devil ? Or a way to try again ?",shape=box,color=blue];
		j1939224710 -> j1047121376;
	j513485404 [label="He is helping to protect the family of the man who turned him into protoframe against his will, and cast him into the past, robbing him of his memories...",shape=box,color=blue];
		j513485404 -> j19534711;
	j2969054108 [label="You are right, I am... not surprised.",shape=box,color=blue];
		j2969054108 -> j2835523914;
		j2969054108 -> j2175991463;
	j961489522 [label="Check boolean RoatheDating",color=orange];
		j961489522 -> j1459068375 [label=true,color=green];
		j961489522 -> j472476332 [label=false,color=brown];
	j3827853471 [label="Check boolean RoatheDating",color=orange];
		j3827853471 -> j1166414771 [label=true,color=green];
		j3827853471 -> j4104405770 [label=false,color=brown];
	j3033577955 [label="Then I will support your choice, as well.",shape=box,color=blue];
		j3033577955 -> j1179567760;
	j1047121376 [label="I will speak to Lyon in the meanwhile, but my hopes are exceedingly low.",shape=box,color=blue];
		j1047121376 -> j3448750414;
	j19534711 [label="+20 Chemistry",color=orange];
		j19534711 -> j3344147004;
	j2835523914 [label="I think it's just the excuse he's making to cover for it.",shape=box,color=red];
		j2835523914 -> j1765421245;
	j2175991463 [label="At least he'll help, though. And I'll make sure he doesn't actually follow through with his threats.",shape=box,color=red];
		j2175991463 -> j32599190;
	j1459068375 [label="I think you have a special way of convincing him, where all others have failed, non ?",shape=box,color=blue];
		j1459068375 -> j283797572;
		j1459068375 -> j946838374;
	j472476332 [label="I wish you the best of luck. That devil can be obstinate at the best of times. Sometimes, I think he just enjoys being contrary !",shape=box,color=blue];
		j472476332 -> j302588066;
		j472476332 -> j1068639330;
	j1166414771 [label="Oui, I do. But I think you have a special way of convincing him, where all others have failed, non ?",shape=box,color=blue];
		j1166414771 -> j283797572;
		j1166414771 -> j946838374;
	j4104405770 [label="Oui, certainly I do. That devil can be obstinate at the best of times. Sometimes, I think he just enjoys being contrary !",shape=box,color=blue];
		j4104405770 -> j302588066;
		j4104405770 -> j1068639330;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j3448750414 [label="+20 Chemistry",color=orange];
		j3448750414 -> j979139064;
	j3344147004 [label="I have deeply misjudged this devil of ours...",shape=box,color=blue];
		j3344147004 -> j3767180544;
	j1765421245 [label="Oui, I hope you are correct.",shape=box,color=blue];
		j1765421245 -> j70687620;
	j32599190 [label="Oui. At least you are around to ensure we keep him from following through on his... baser instincts.",shape=box,color=blue];
		j32599190 -> j70687620;
	j283797572 [label="What're you insinuating, Marie?",shape=box,color=red];
		j283797572 -> j4098242869;
	j946838374 [label="I wouldn't want to use my relationship with him as a negotiation tool.",shape=box,color=red];
		j946838374 -> j2920833151;
	j302588066 [label="He can be, but I think a lot of that is just for show.",shape=box,color=red];
		j302588066 -> j3223989954;
	j1068639330 [label="I actually kind of enjoy it, as weird as it sounds. We get along.",shape=box,color=red];
		j1068639330 -> j297694120;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j979139064 [label="The devil is fickle ! C'est la vie, as they say !",shape=box,color=blue];
		j979139064 -> j3569999725;
	j3767180544 [label="And I am not a fool to not see the part you played in ensuring this all came to pass !",shape=box,color=blue];
		j3767180544 -> j1263896752;
	j70687620 [label="Check boolean MarieDating",color=orange];
		j70687620 -> j2884175498 [label=true,color=green];
		j70687620 -> j2074343049 [label=false,color=brown];
	j4098242869 [label="+5 Chemistry",color=orange];
		j4098242869 -> j2932981948;
	j2920833151 [label="Oh ! That is not what I was implying, pardonne-moi ! Simply that he seems to favor you, so you may have his ear where all others he may ignore.",shape=box,color=blue];
		j2920833151 -> j1095943688;
	j3223989954 [label="Oui ? What do you mean ?",shape=box,color=blue];
		j3223989954 -> j1155893159;
	j297694120 [label="Oui, he certainly does seem to favor you. Perhaps it is because you share a time and a place, where we do not ? Why else would he ?",shape=box,color=blue];
		j297694120 -> j1155893159;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j1263896752 [label="Check boolean MarieDating",color=orange];
		j1263896752 -> j4197101726 [label=true,color=green];
		j1263896752 -> j3750573947 [label=false,color=brown];
	j2884175498 [label="+10 Chemistry",color=orange];
		j2884175498 -> j3208239704;
	j2074343049 [label="+10 Chemistry",color=orange];
		j2074343049 -> j549463413;
	j2932981948 [label="I certainly have no idea what you mean ! I am not insinuating anything at all. I am a purely une innocente Sœur de Sol.",shape=box,color=blue];
		j2932981948 -> j2545548783;
	j1095943688 [label="+5 Chemistry",color=orange];
		j1095943688 -> j4102734153;
	j1155893159 [label="Evaluate expressions",color=orange];
		j1155893159 -> j842909493 [label="RoatheVillain",color=purple];
		j1155893159 -> j836580243 [label="RoatheRedeemed",color=purple];
		j1155893159 -> j474805922 [label="RoatheUnloved3",color=purple];
		j1155893159 -> j1162327759 [label="RoatheTraitor2",color=purple];
		j1155893159 -> j919081835 [label="RoatheExecutor2",color=purple];
		j1155893159 -> j2342335592 [label="false",color=purple];
	j4197101726 [label="Merci, merci, merci, mon cœur !",shape=box,color=blue];
		j4197101726 -> j171133207;
	j3750573947 [label="Merci, merci, merci !",shape=box,color=blue];
		j3750573947 -> j171133207;
	j3208239704 [label="Well ! When the time comes, I will be ready and waiting ! Until then, merci, mon cœur.",shape=box,color=blue];
		j3208239704 -> j3569999725;
	j549463413 [label="Well ! When the time comes, I will be ready and waiting ! Until then, merci.",shape=box,color=blue];
		j549463413 -> j3569999725;
	j2545548783 [label="I would never imply that since the devil seems to favor you, that perhaps he will listen to you where all others he seems to ignore.",shape=box,color=blue];
		j2545548783 -> j2712407306;
	j4102734153 [label="I am simply happy that you are happy. And if the devil has somewhere to spend his... efforts... all the better, non ?",shape=box,color=blue];
		j4102734153 -> j2630814230;
	j842909493 [label="Everyone in his life has tried to make him out to be some kind of monster. I suppose I'm the first person who hasn't.",shape=box,color=red];
		j842909493 -> j1881593101;
	j836580243 [label="There's a lot about him that he just doesn't know how to show. It's not armor, per se - but he doesn't trust people not to hurt him.",shape=box,color=red];
		j836580243 -> j1603881267;
	j474805922 [label="He's... had some real heartbreak in his many years. It's scabbed over with thorns, that's all.",shape=box,color=red];
		j474805922 -> j688488160;
	j1162327759 [label="I guess I can understand the amount of years he's lived. I've seen the same amount of death he has.",shape=box,color=red];
		j1162327759 -> j2047602151;
	j919081835 [label="He's only ever tried to do what was right. Maybe in the wrong way, sure - but he was trying to save the Origin System from the Orokin.",shape=box,color=red];
		j919081835 -> j2660064596;
	j2342335592 [label="I enjoy his wry sense of humor. He's clever, when you get past his ego.",shape=box,color=red];
		j2342335592 -> j2618000579;
	j171133207 [label="Well ! When the time comes, I will be ready and waiting ! Until then !",shape=box,color=blue];
		j171133207 -> j3569999725;
	j2712407306 [label="And never during private moments. Non. Jamais.",shape=box,color=blue];
		j2712407306 -> j3166224066;
		j2712407306 -> j1276527345;
	j2630814230 [label="Even more so for us all if you serve as a bit of un ange upon his shoulder to temper him.",shape=box,color=blue];
		j2630814230 -> j1947883996;
		j2630814230 -> j653882434;
	j1881593101 [label="And I suppose I am atop that list of late, non ? I suppose I should... consider his reasons, for why he is the way he is. Condemnation saves no souls.",shape=box,color=blue];
		j1881593101 -> j3863628794;
	j1603881267 [label="There is always a pain we hide from those around us. Something we seek to shelter, for fear others will wield it. I suppose I should strive to be kinder to him, if what you say is true.",shape=box,color=blue];
		j1603881267 -> j3863628794;
	j688488160 [label="I cannot imagine the amount of love and loss one must suffer in all those years. It seems so unreal, even given all that I have seen.",shape=box,color=blue];
		j688488160 -> j1781329024;
	j2047602151 [label="Sometimes I forget, when I speak to him, how many centuries he has lived. It seems so unreal, even given all that I have seen.",shape=box,color=blue];
		j2047602151 -> j3613440902;
	j2660064596 [label="There are always... nuances, oui ? Always reasons for acting one way or another. I suppose I should strive to be kinder to him, if what you say is true.",shape=box,color=blue];
		j2660064596 -> j3863628794;
	j2618000579 [label="No one has ever denied the devil his wit.",shape=box,color=blue];
		j2618000579 -> j2141095481;
	j3166224066 [label="You surprise me. I'm impressed. ",shape=box,color=red];
		j3166224066 -> j1095943688;
	j1276527345 [label="I never knew you had this side to you.",shape=box,color=red];
		j1276527345 -> j1095943688;
	j1947883996 [label="I can't make any promises.",shape=box,color=red];
		j1947883996 -> j1001129056;
	j653882434 [label="Who says I'm trying to temper him?",shape=box,color=red];
		j653882434 -> j1632492114;
	j3863628794 [label="+10 Chemistry",color=orange];
		j3863628794 -> j109003483;
	j1781329024 [label="Oui, what damage could that cause a soul ? I see why you would wish to find another who understood. And he, you.",shape=box,color=blue];
		j1781329024 -> j3863628794;
	j3613440902 [label="To have lived so long, to have seen so much death - to have paid so much of it yourself ?",shape=box,color=blue];
		j3613440902 -> j1781329024;
	j2141095481 [label="+5 Chemistry",color=orange];
		j2141095481 -> j109003483;
	j1001129056 [label="Add 1 to Thermostat counter",color=orange];
		j1001129056 -> j2945128303;
	j1632492114 [label="Add -1 to Thermostat counter",color=orange];
		j1632492114 -> j499605529;
	j109003483 [label="I am simply glad the devil has someone to speak with who might seek to temper him. Un ange upon his shoulder.",shape=box,color=blue];
		j109003483 -> j653882434;
		j109003483 -> j1947883996;
	j2945128303 [label="+10 Chemistry",color=orange];
		j2945128303 -> j2617418891;
	j499605529 [label="+10 Chemistry",color=orange];
		j499605529 -> j1524002402;
	j2617418891 [label="Oui, I fear there is a wickedness in him that cannot truly be cured. He enjoys it too much.",shape=box,color=blue];
		j2617418891 -> j104956296;
	j1524002402 [label="Perhaps you are right... what is un ange without son diable ? He reminds us all of what we should strive to avoid.",shape=box,color=blue];
		j1524002402 -> j104956296;
	j104956296 [label="Well ! If and when you convince the devil to aid us in our mission, I will be ready and waiting ! Until then !",shape=box,color=blue];
		j104956296 -> j3569999725;
}