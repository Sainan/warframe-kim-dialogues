	2738 [label="Au revoir.",shape=box,color=blue];
		2738 -> 2744;
	2739 [label="[Confess feelings.] You're not a fool, Marie. You're anything but. If anything, this proves to me how wonderful you really are.",shape=box,color=red];
		2739 -> 2745;
	2740 [label="And you tell me this while you also confess your love to the brother of my soul ?! Do you think to play us both to be fools ?!",shape=box,color=blue];
		2740 -> 2746;
	2741 [label="And you tell me this while you tarry with the devil ?! Do you think to play us both to be fools ?!",shape=box,color=blue];
		2741 -> 2746;
	2742 [label="I... Oh, mon cœur. Mon cœur ! Oh, how I feel the same ! But I did not dare speak the words, I did not dare write them to you - for I thought myself a fool for them.",shape=box,color=blue];
		2742 -> 2747;
	2743 [label="Oui, as you said, and so I now see plainly. I... am simply left to thank you for your patience once more.",shape=box,color=blue];
		2743 -> 2748;
