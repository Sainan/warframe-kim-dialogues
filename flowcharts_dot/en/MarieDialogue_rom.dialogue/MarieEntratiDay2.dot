		2734 -> 2742 [label="false",color=purple];
	2735 [label="No, he was kind to you. That wasn't a lie. But that doesn't mean that's all he is, and all he's capable of.",shape=box,color=red];
		2735 -> 2743;
	2736 [label="Chat ends.",color=orange];
