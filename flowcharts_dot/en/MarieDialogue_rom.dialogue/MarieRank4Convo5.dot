	1652 [label="And what could you possibly be distracted by ? What could be more important than sitting down and sorting through the complaints of mécontents ?",shape=box,color=blue];
		1652 -> 1676;
	1653 [label="What could be difficult about sitting down and sorting through the complaints of mécontents ?",shape=box,color=blue];
