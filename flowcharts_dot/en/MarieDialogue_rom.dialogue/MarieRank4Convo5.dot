	1656 [label="His daughter, Euleria - known as Mother, and her family, have been taking care of Deimos this whole time.",shape=box,color=red];
		1656 -> 1679;
	2937 [label="What is to stop us from simply moving all the furniture, letting them replace it all, and then... doing it again ? We could sell it all Make profit de ce mobilier étrange !",shape=box,color=blue];
		2937 -> 2938;
		2937 -> 2939;
		2937 -> 2940;
	1658 [label="I am well aware of our unsettled disagreements regarding le Cardinal. I am attempting to keep this conversation civilisée.",shape=box,color=blue];
		1658 -> 1680;
	1661 [label="I understand how you may not wish to discuss mending rifts without finding opportunities to point at those you feel are to blame.",shape=box,color=blue];
		1661 -> 1680;
	1657 [label="Oui ! As you are so often wont to remind me, you believe him to be un monstre ! With nothing but spite and emptiness in his heart !",shape=box,color=blue];
		1657 -> 1680;
	1659 [label="I thought you were on my side in this war for le Cardinal's soul ?",shape=box,color=blue];
		1659 -> 1681;
	1660 [label="I thought you had not made up your mind about le Cardinal ? Or has this now changed ?",shape=box,color=blue];
		1660 -> 1682;
		1660 -> 1683;
	1668 [label="Oui. This, I am learning with M'sieur Tagfer...",shape=box,color=blue];
		1668 -> 1686;
	1662 [label="Do not speak to me of scabbed wounds, wolf. I am still licking my own from our last discussion of le Cardinal.",shape=box,color=blue];
		1662 -> 1680;
	1663 [label="Oui, but you said it before - we must all stop blaming each other for these wounds we suffer.",shape=box,color=blue];
		1663 -> 1684;
	1664 [label="I know you believe le Cardinal is some kind of horrible monstre for causing such wounds.",shape=box,color=blue];
		1664 -> 1680;
	1665 [label="I know you are on my side of this war for le Cardinal's soul, for which I shall be forever grateful.",shape=box,color=blue];
		1665 -> 1666;
	1667 [label="I know you are withholding judgement on him, for which I am immensely grateful.",shape=box,color=blue];
		1667 -> 1666;
	1666 [label="And while I know the others are quick to blame him, I do not wish to see us divided and bleeding when we could be whole.",shape=box,color=blue];
		1666 -> 1685;
	1675 [label="Oui, though I am learning - as with M'sieur Tagfer, that perhaps not all to the same degree.",shape=box,color=blue];
		1675 -> 1686;
	1669 [label="And I am learning that it is not all to the same degree, as you were so \"kind\" to point out to me, non ?",shape=box,color=blue];
		1669 -> 1680;
	1670 [label="Oui, yes ! While I do not blame le Cardinal for leaving, for his work is sacro-saint -",shape=box,color=blue];
		1670 -> 1666;
	1671 [label="And I know you believe le Cardinal is some kind of horrible monstre for causing such wounds.",shape=box,color=blue];
		1671 -> 1680;
	1672 [label="I know you are on my side of this war for le Cardinal's soul, for which I shall be forever grateful.",shape=box,color=blue];
		1672 -> 1666;
	1673 [label="I know you are withholding judgement on him, for which I am immensely grateful.",shape=box,color=blue];
		1673 -> 1666;
	1674 [label="And while the others are quick to blame him for their pain, I simply do not wish to see us divided and suffering.",shape=box,color=blue];
		1674 -> 1685;
	1676 [label="I tease, I tease ! I cannot fathom how busy you are, and all the places - and times - you are needed.",shape=box,color=blue];
		1676 -> 1678;
	1677 [label="I tease, I tease ! I cannot fathom what they have endured. And how challenging it is for you to untangle it.",shape=box,color=blue];
		1677 -> 1678;
	1678 [label="I simply worry that without their issues mended, we could never hope to be welcome at their table. The greater problem remains unsolved -",shape=box,color=blue];
		1678 -> 1637;
	1679 [label="Watching over this place, and the heart that pumps Void energy into the Origin System, keeping all of us... usable, really, ever since Entrati left.",shape=box,color=red];
		1679 -> 1687;
	2938 [label="I don't know as there's much of a market for Entrati's chairs...",shape=box,color=red];
		2938 -> 2942;
	2939 [label="Wouldn't we flood the market eventually? We'd have to sell them for pretty cheap...",shape=box,color=red];
		2939 -> 2942;
	2940 [label="Brilliant. I see no problems with this.",shape=box,color=red];
		2940 -> 2941;
	1680 [label="And while I understand the two topics are inexorably linked, I would ask you to keep it productive this day, oui ?",shape=box,color=blue];
		1680 -> 1688;
	1681 [label="What is this deception of yours, wolf ? Or is little Marie only un jeu to you ?",shape=box,color=blue];
		1681 -> 1689;
		1681 -> 1683;
	1682 [label="I haven't made up my mind about the necessity of his actions. But his callous nature can't be questioned.",shape=box,color=red];
		1682 -> 1680;
	1683 [label="I'm tired of pretending, I'm sorry.",shape=box,color=red];
		1683 -> 1690;
	1686 [label="We must all stop blaming each other for these wounds we suffer.",shape=box,color=blue];
		1686 -> 1684;
	1684 [label="I do not agree with blaming le Cardinal either, mind, but I do not wish to see us divided and bleeding when we could be whole.",shape=box,color=blue];
		1684 -> 1691;
		1684 -> 1692;
	1685 [label="We must all stop blaming each other for these wounds we suffer, regardless of who is ultimately at fault.",shape=box,color=blue];
