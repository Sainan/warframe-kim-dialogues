	"MarieRank4Convo5 begins." [color=orange];
		"MarieRank4Convo5 begins." -> j1316635360;
	j1316635360 [label="Evaluate expressions",color=orange];
		j1316635360 -> j1568845637 [label="LoidFamilyComplete",color=purple];
		j1316635360 -> j1704363217 [label="MarieFamilyOther",color=purple];
		j1316635360 -> j1219003284 [label="MarieFamily2",color=purple];
		j1316635360 -> j1219003284 [label="MarieFamily1",color=purple];
		j1316635360 -> j2916189223 [label="false",color=purple];
	j1568845637 [label="Drifter ! I have been scheming.",shape=box,color=blue];
		j1568845637 -> j130917981;
		j1568845637 -> j242691715;
	j1704363217 [label="Drifter ! I have been scheming, thinking over what you said of the family above us. And how they might see us as interlopers.",shape=box,color=blue];
		j1704363217 -> j883296813;
	j1219003284 [label="Drifter ! I have been thinking over what you said of the family above us. My heart breaks for them...",shape=box,color=blue];
		j1219003284 -> j1000557311;
	j2916189223 [label="Why is it we cannot go upstairs ? Why can we not speak to those who called le Cardinal famille ?",shape=box,color=blue];
		j2916189223 -> j1815650644;
		j2916189223 -> j242691715;
	j130917981 [label="Should I be scared?",shape=box,color=red];
		j130917981 -> j111027070;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j883296813 [label="As the \"other family\" in compétition, oui ? This troubles me so.",shape=box,color=blue];
		j883296813 -> j1000557311;
	j1000557311 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j1000557311 -> j3214280635 [label=true,color=green];
		j1000557311 -> j3642914 [label=false,color=brown];
	j1815650644 [label="Well... in short, some of Entrati's family is upstairs, and they aren't... exactly aware that we're down here.",shape=box,color=red];
		j1815650644 -> j463626933;
	j111027070 [label="Oui ! The little flying robots. The necra... necra... What do you call them ?",shape=box,color=blue];
		j111027070 -> j329857471;
	"Chat ends." [color=orange];
	j3214280635 [label="We do not compete for the love of le Cardinal, how can we help them see this ?",shape=box,color=blue];
		j3214280635 -> j901043021;
		j3214280635 -> j814782805;
		j3214280635 -> j1655123363;
	j3642914 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j3642914 -> j3214280635 [label=true,color=green];
		j3642914 -> j3572447746 [label=false,color=brown];
	j463626933 [label="Boolean MarieFamily1 is now true.",color=orange];
		j463626933 -> j2459680150;
	j329857471 [label="Necramites?",shape=box,color=red];
		j329857471 -> j2350856474;
	j901043021 [label="You're right. You can't compete for something a person doesn't have to give.",shape=box,color=red];
		j901043021 -> j380005824;
	j814782805 [label="Opening scabbed-over wounds is dangerous. You might get rid of an infection... or you might bleed out in the process.",shape=box,color=red];
		j814782805 -> j2952898253;
	j1655123363 [label="You - we - all have one thing in common. At some point, we were left behind by Entrati.",shape=box,color=red];
		j1655123363 -> j2515192195;
	j3572447746 [label="How goes your work mending their inner strife ?",shape=box,color=blue];
		j3572447746 -> j421942424;
		j3572447746 -> j3624308954;
		j3572447746 -> j304566815;
		j3572447746 -> j242691715;
	j2459680150 [label="Par les Luminaires... You mean that we are all down here in secret ?! Is that why we are not allowed to leave this place ?! Mais pourquoi ?!",shape=box,color=blue];
		j2459680150 -> j3420657757;
	j2350856474 [label="Oui ! Ha ! They are so persistent in replacing furniture, non ? But I find if you move things... they do the same thing.",shape=box,color=blue];
		j2350856474 -> j2911235375;
	j380005824 [label="Evaluate expressions",color=orange];
		j380005824 -> j179815407 [label="MarieEntrati3a",color=purple];
		j380005824 -> j179815407 [label="MarieEntrati3b",color=purple];
		j380005824 -> j179815407 [label="MarieEntrati3",color=purple];
		j380005824 -> j2734738403 [label="MarieEntratiFamily",color=purple];
		j380005824 -> j3873709173 [label="MarieEntratiMonster1",color=purple];
		j380005824 -> j3873709173 [label="MarieEntratiMonster2",color=purple];
		j380005824 -> j2930639881 [label="MarieEntratiFan1",color=purple];
		j380005824 -> j2930639881 [label="MarieEntratiFan2",color=purple];
		j380005824 -> j3336918350 [label="MarieEntratiNeutral",color=purple];
		j380005824 -> j2734738403 [label="false",color=purple];
	j2952898253 [label="Evaluate expressions",color=orange];
		j2952898253 -> j2679102564 [label="MarieEntrati3a",color=purple];
		j2952898253 -> j2679102564 [label="MarieEntrati3b",color=purple];
		j2952898253 -> j302715288 [label="MarieEntrati3",color=purple];
		j2952898253 -> j949967654 [label="MarieEntratiFamily",color=purple];
		j2952898253 -> j2082929958 [label="MarieEntratiMonster1",color=purple];
		j2952898253 -> j2082929958 [label="MarieEntratiMonster2",color=purple];
		j2952898253 -> j1457016139 [label="MarieEntratiFan1",color=purple];
		j2952898253 -> j1457016139 [label="MarieEntratiFan2",color=purple];
		j2952898253 -> j4285840259 [label="MarieEntratiNeutral",color=purple];
		j2952898253 -> j1267825415 [label="false",color=purple];
	j2515192195 [label="Evaluate expressions",color=orange];
		j2515192195 -> j547808497 [label="MarieEntrati3a",color=purple];
		j2515192195 -> j547808497 [label="MarieEntrati3b",color=purple];
		j2515192195 -> j3279756362 [label="MarieEntrati3",color=purple];
		j2515192195 -> j1844365872 [label="MarieEntratiFamily",color=purple];
		j2515192195 -> j83925427 [label="MarieEntratiMonster1",color=purple];
		j2515192195 -> j83925427 [label="MarieEntratiMonster2",color=purple];
		j2515192195 -> j1457016139 [label="MarieEntratiFan1",color=purple];
		j2515192195 -> j1457016139 [label="MarieEntratiFan2",color=purple];
		j2515192195 -> j4285840259 [label="MarieEntratiNeutral",color=purple];
		j2515192195 -> j1055063086 [label="false",color=purple];
	j421942424 [label="Honestly? I got distracted.",shape=box,color=red];
		j421942424 -> j666133542;
	j3624308954 [label="It could be going better.",shape=box,color=red];
		j3624308954 -> j3776834607;
	j304566815 [label="I'm making progress.",shape=box,color=red];
		j304566815 -> j2168281754;
	j3420657757 [label="His daughter, Euleria - known as Mother, and her family, have been taking care of Deimos this whole time.",shape=box,color=red];
		j3420657757 -> j3948323697;
	j2911235375 [label="What is to stop us from simply moving all the furniture, letting them replace it all, and then... doing it again ? We could sell it all Make profit de ce mobilier étrange !",shape=box,color=blue];
		j2911235375 -> j2318861824;
		j2911235375 -> j649464820;
		j2911235375 -> j600454294;
	j179815407 [label="I am well aware of our unsettled disagreements regarding le Cardinal. I am attempting to keep this conversation civilisée.",shape=box,color=blue];
		j179815407 -> j2839778855;
	j2734738403 [label="I understand how you may not wish to discuss mending rifts without finding opportunities to point at those you feel are to blame.",shape=box,color=blue];
		j2734738403 -> j2839778855;
	j3873709173 [label="Oui ! As you are so often wont to remind me, you believe him to be un monstre ! With nothing but spite and emptiness in his heart !",shape=box,color=blue];
		j3873709173 -> j2839778855;
	j2930639881 [label="I thought you were on my side in this war for le Cardinal's soul ?",shape=box,color=blue];
		j2930639881 -> j693820214;
	j3336918350 [label="I thought you had not made up your mind about le Cardinal ? Or has this now changed ?",shape=box,color=blue];
		j3336918350 -> j1404258653;
		j3336918350 -> j155549266;
	j2679102564 [label="Oui. This, I am learning with M'sieur Tagfer...",shape=box,color=blue];
		j2679102564 -> j2584051697;
	j302715288 [label="Do not speak to me of scabbed wounds, wolf. I am still licking my own from our last discussion of le Cardinal.",shape=box,color=blue];
		j302715288 -> j2839778855;
	j949967654 [label="Oui, but you said it before - we must all stop blaming each other for these wounds we suffer.",shape=box,color=blue];
		j949967654 -> j1662883289;
	j2082929958 [label="I know you believe le Cardinal is some kind of horrible monstre for causing such wounds.",shape=box,color=blue];
		j2082929958 -> j2839778855;
	j1457016139 [label="I know you are on my side of this war for le Cardinal's soul, for which I shall be forever grateful.",shape=box,color=blue];
		j1457016139 -> j1267825415;
	j4285840259 [label="I know you are withholding judgement on him, for which I am immensely grateful.",shape=box,color=blue];
		j4285840259 -> j1267825415;
	j1267825415 [label="And while I know the others are quick to blame him, I do not wish to see us divided and bleeding when we could be whole.",shape=box,color=blue];
		j1267825415 -> j4262307208;
	j547808497 [label="Oui, though I am learning - as with M'sieur Tagfer, that perhaps not all to the same degree.",shape=box,color=blue];
		j547808497 -> j2584051697;
	j3279756362 [label="And I am learning that it is not all to the same degree, as you were so \"kind\" to point out to me, non ?",shape=box,color=blue];
		j3279756362 -> j2839778855;
	j1844365872 [label="Oui, yes ! While I do not blame le Cardinal for leaving, for his work is sacro-saint -",shape=box,color=blue];
		j1844365872 -> j1267825415;
	j83925427 [label="And I know you believe le Cardinal is some kind of horrible monstre for causing such wounds.",shape=box,color=blue];
		j83925427 -> j2839778855;
	j1055063086 [label="And while the others are quick to blame him for their pain, I simply do not wish to see us divided and suffering.",shape=box,color=blue];
		j1055063086 -> j4262307208;
	j666133542 [label="And what could you possibly be distracted by ? What could be more important than sitting down and sorting through the complaints of mécontents ?",shape=box,color=blue];
		j666133542 -> j335344031;
	j3776834607 [label="What could be difficult about sitting down and sorting through the complaints of mécontents ?",shape=box,color=blue];
		j3776834607 -> j4119544417;
	j2168281754 [label="Oh, magnifique !",shape=box,color=blue];
		j2168281754 -> j2412673648;
	j3948323697 [label="Watching over this place, and the heart that pumps Void energy into the Origin System, keeping all of us... usable, really, ever since Entrati left.",shape=box,color=red];
		j3948323697 -> j3916832970;
	j2318861824 [label="I don't know as there's much of a market for Entrati's chairs...",shape=box,color=red];
		j2318861824 -> j3755356140;
	j649464820 [label="Wouldn't we flood the market eventually? We'd have to sell them for pretty cheap...",shape=box,color=red];
		j649464820 -> j3755356140;
	j600454294 [label="Brilliant. I see no problems with this.",shape=box,color=red];
		j600454294 -> j1284319580;
	j2839778855 [label="And while I understand the two topics are inexorably linked, I would ask you to keep it productive this day, oui ?",shape=box,color=blue];
		j2839778855 -> j1254158668;
	j693820214 [label="What is this deception of yours, wolf ? Or is little Marie only un jeu to you ?",shape=box,color=blue];
		j693820214 -> j2609973870;
		j693820214 -> j155549266;
	j1404258653 [label="I haven't made up my mind about the necessity of his actions. But his callous nature can't be questioned.",shape=box,color=red];
		j1404258653 -> j2839778855;
	j155549266 [label="I'm tired of pretending, I'm sorry.",shape=box,color=red];
		j155549266 -> j2857007554;
	j2584051697 [label="We must all stop blaming each other for these wounds we suffer.",shape=box,color=blue];
		j2584051697 -> j1662883289;
	j1662883289 [label="I do not agree with blaming le Cardinal either, mind, but I do not wish to see us divided and bleeding when we could be whole.",shape=box,color=blue];
		j1662883289 -> j1138016143;
		j1662883289 -> j3662745807;
	j4262307208 [label="We must all stop blaming each other for these wounds we suffer, regardless of who is ultimately at fault.",shape=box,color=blue];
		j4262307208 -> j1138016143;
		j4262307208 -> j3662745807;
	j335344031 [label="I tease, I tease ! I cannot fathom how busy you are, and all the places - and times - you are needed.",shape=box,color=blue];
		j335344031 -> j2412673648;
	j4119544417 [label="I tease, I tease ! I cannot fathom what they have endured. And how challenging it is for you to untangle it.",shape=box,color=blue];
		j4119544417 -> j2412673648;
	j2412673648 [label="I simply worry that without their issues mended, we could never hope to be welcome at their table. The greater problem remains unsolved -",shape=box,color=blue];
		j2412673648 -> j3214280635;
	j3916832970 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3916832970 -> j1046041486 [label=true,color=green];
		j3916832970 -> j3337182392 [label=false,color=brown];
	j3755356140 [label="Pff ! I still think this is a worthy experiment. Perhaps we can wall off the devil in a sea of bookcases !",shape=box,color=blue];
		j3755356140 -> j827029302;
	j1284319580 [label="I am going to dutifully ignore your sarcasm, because I think this is a worthy experiment. Perhaps we can wall off the devil in a sea of bookcases !",shape=box,color=blue];
		j1284319580 -> j827029302;
	j1254158668 [label="I seek to aid us all in this... strange coexistence we have found ourselves, not to argue.",shape=box,color=blue];
		j1254158668 -> j2584051697;
	j2609973870 [label="No, not a game. But Entrati isn't to be trusted, and I don't know how else to convince you but to pretend to be on your side.",shape=box,color=red];
		j2609973870 -> j291213218;
	j2857007554 [label="Oui ? Well, I am pleased to tell you, needn't do so any longer.",shape=box,color=blue];
		j2857007554 -> j1509439757;
	j1138016143 [label="Together, all as one, we are... a strange family. But a family, none the less.",shape=box,color=red];
		j1138016143 -> j1625808289;
	j3662745807 [label="We would be stronger together than we are apart.",shape=box,color=red];
		j3662745807 -> j1731491872;
		j3662745807 -> j2547484601;
	j1046041486 [label="She's come to terms with his absence, and they've made peace with each other, but it was a hard-won thing.",shape=box,color=red];
		j1046041486 -> j728491544;
	j3337182392 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j3337182392 -> j1046041486 [label=true,color=green];
		j3337182392 -> j340274257 [label=false,color=brown];
	j827029302 [label="+20 Chemistry",color=orange];
		j827029302 -> j2901110044;
	j291213218 [label="Oui ? Well, I am pleased to tell you, you have failed.",shape=box,color=blue];
		j291213218 -> j1509439757;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j1625808289 [label="Add +1 to Family counter",color=orange];
		j1625808289 -> j1731491872;
		j1625808289 -> j2547484601;
	j1731491872 [label="And in times when we're suffering, sometimes all we really have is each other. Either the ones we were given, or the ones we found.",shape=box,color=red];
		j1731491872 -> j1637573316;
	j2547484601 [label="I don't know if it would help, or hurt, in the long run. But this... purgatory, isn't right, either.",shape=box,color=red];
		j2547484601 -> j799392373;
	j728491544 [label="Knowing that he's still out there, running amok, and that he hasn't said a word to her, or even sent a letter...?",shape=box,color=red];
		j728491544 -> j3018318990;
	j340274257 [label="She hasn't come to terms with his absence, and they're at each other's throats.",shape=box,color=red];
		j340274257 -> j314197745;
	j2901110044 [label="Much to do ! À la revoyure !",shape=box,color=blue];
		j2901110044 -> "Chat ends.";
	j2631316640 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j2631316640 -> j1508231473;
	j1637573316 [label="Add +1 to Family counter",color=orange];
		j1637573316 -> j799392373;
	j799392373 [label="Oui, I agree. But I cannot be the one to bridge the gap between us. I don't know how to do it ! I am a stranger to them upstairs...",shape=box,color=blue];
		j799392373 -> j2447986332;
		j799392373 -> j323424232;
	j3018318990 [label="I can't imagine how painful that would be for her. For them.",shape=box,color=red];
		j3018318990 -> j762413590;
	j314197745 [label="Knowing that he's still out there, running amok, and that he hasn't said a word to her, or even sent a letter...?",shape=box,color=red];
		j314197745 -> j4154174968;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j2447986332 [label="Loid knew the Entrati family. It should be him. Convincing him, however... is another matter.",shape=box,color=red];
		j2447986332 -> j3788512162;
	j323424232 [label="Roathe, maybe? He's Orokin, he knew them all.",shape=box,color=red];
		j323424232 -> j140210410;
	j762413590 [label="While I can see the logic behind the decision to protect them from the pain le Cardinal has caused by his necessary departure...",shape=box,color=blue];
		j762413590 -> j3193079653;
	j4154174968 [label="It would destroy what little chance of reconciliation they might have.",shape=box,color=red];
		j4154174968 -> j2054531075;
	j3788512162 [label="+5 Chemistry",color=orange];
		j3788512162 -> j2089407382;
	j140210410 [label="Non, not the devil - anyone but the devil. But you are on to something. The natural choice is Monsieur Loid, non ?",shape=box,color=blue];
		j140210410 -> j22751870;
	j3193079653 [label="I do think it needlessly cruel, don't you ? They might think him dead. Or worse ! And we, living here, comme des rats d'égout ?",shape=box,color=blue];
		j3193079653 -> j4154999171;
		j3193079653 -> j1753988278;
		j3193079653 -> j468490440;
	j2054531075 [label="Oui... I see the logic. I would work to mend their family, if you can, then, non ? It seems to be the only hope any of us have to get out of this place. ",shape=box,color=blue];
		j2054531075 -> j3105854715;
	j2089407382 [label="Oui, oui ! C'est ça ! But how do we convince him ? He has been stalwart in his position, non ?",shape=box,color=blue];
		j2089407382 -> j4217253801;
		j2089407382 -> j3390487446;
	j22751870 [label="But how do we convince him ? He has been stalwart in his position, non ?",shape=box,color=blue];
		j22751870 -> j3390487446;
		j22751870 -> j4217253801;
	j4154999171 [label="I actually have a friend who loves rats. I think they're adorable.",shape=box,color=red];
		j4154999171 -> j3840142459;
	j1753988278 [label="It's not really my decision to make.",shape=box,color=red];
		j1753988278 -> j1050259230;
	j468490440 [label="What would you suggest I do?",shape=box,color=red];
		j468490440 -> j1899539653;
	j3105854715 [label="Lest we spend the rest of our lives trapped living here, comme des rats d'égout. ",shape=box,color=blue];
		j3105854715 -> j4002007537;
		j3105854715 -> j3676510582;
	j4217253801 [label="Do you think you or Lyon might convince him?",shape=box,color=red];
		j4217253801 -> j147620024;
	j3390487446 [label="You're not going to like my answer, Marie...",shape=box,color=red];
		j3390487446 -> j422744456;
	j3840142459 [label="And I would love to meet them some day, but that is hardly the point I am making, silly wolf.",shape=box,color=blue];
		j3840142459 -> j1899539653;
	j1050259230 [label="I know. It is Monsieur Loid's, and everyone else's decision, to make themselves known.",shape=box,color=blue];
		j1050259230 -> j1899539653;
	j1899539653 [label="I would suggest that it is a sense of guilt, not nobility, that keeps us down here.",shape=box,color=blue];
		j1899539653 -> j995006244;
	j4002007537 [label="I actually have a friend who loves rats. I think they're adorable. ",shape=box,color=red];
		j4002007537 -> j3840142459;
	j3676510582 [label="I've been remiss. You're right. I'll get to work.",shape=box,color=red];
		j3676510582 -> j4203774723;
	j147620024 [label="He likes us well enough, he is kind and he is gentle. But we are étrangers to him, newcomers.",shape=box,color=blue];
		j147620024 -> j1849588085;
	j422744456 [label="Ah bon ?",shape=box,color=blue];
		j422744456 -> j1805475671;
	j995006244 [label="That we hide some great and terrible sin.",shape=box,color=blue];
		j995006244 -> j364455316;
	j4203774723 [label="Thank you. I do not know if you will succeed, but sometimes, we can only help but to try.",shape=box,color=blue];
		j4203774723 -> j1899539653;
	j1849588085 [label="I will think on it. You do the same ! A solution will be found, Sol has guided us this far !",shape=box,color=blue];
		j1849588085 -> j3229234412;
	j1805475671 [label="Loid might listen to Roathe. Him being Orokin - their shared history - might come in handy, here.",shape=box,color=red];
		j1805475671 -> j1925107010;
	j364455316 [label="And it is that sin that must be forgiven, or proven to be false, perhaps ?",shape=box,color=blue];
		j364455316 -> j1924511960;
		j364455316 -> j2919405780;
	j3229234412 [label="+15 Chemistry",color=orange];
		j3229234412 -> j3261569741;
	j1925107010 [label="Non ! He is a liar, he is a manipulator, he would only do this in exchange for some great fee !",shape=box,color=blue];
		j1925107010 -> j2169696619;
	j1924511960 [label="The situation upstairs is... fragile on the best of days. I don't want to upset them.",shape=box,color=red];
		j1924511960 -> j1568440548;
	j2919405780 [label="We just have to be careful. I'm afraid one half will see the other half as \"the other family.\"",shape=box,color=red];
		j2919405780 -> j3705427231;
