	2935 [label="Necramites?",shape=box,color=red];
		2935 -> 2936;
	1641 [label="You're right. You can't compete for something a person doesn't have to give.",shape=box,color=red];
		1641 -> 1649;
	1642 [label="Opening scabbed-over wounds is dangerous. You might get rid of an infection... or you might bleed out in the process.",shape=box,color=red];
		1642 -> 1650;
	1643 [label="You - we - all have one thing in common. At some point, we were left behind by Entrati.",shape=box,color=red];
		1643 -> 1651;
	1644 [label="Honestly? I got distracted.",shape=box,color=red];
		1644 -> 1652;
	1645 [label="It could be going better.",shape=box,color=red];
		1645 -> 1653;
	1646 [label="I'm making progress.",shape=box,color=red];
		1646 -> 1654;
	1647 [label="[End.]",shape=box,color=red];
		1647 -> 1655;
	1648 [label="Par les Luminaires... You mean that we are all down here in secret ?! Is that why we are not allowed to leave this place ?! Mais pourquoi ?!",shape=box,color=blue];
		1648 -> 1656;
	2936 [label="Oui ! Ha ! They are so persistent in replacing furniture, non ? But I find if you move things... they do the same thing.",shape=box,color=blue];
