digraph {
	1418 [label="MarieRank3Convo6 begins.",color=orange];
		1418 -> 3740;
	3740 [label="Update boolean MarieLyonAvailable",color=orange];
		3740 -> 1419;
	1419 [label="I must ask you a question, and I must implore you not to judge me for it, Drifter.",shape=box,color=blue];
		1419 -> 1420;
		1419 -> 1421;
		1419 -> 1422;
	1420 [label="You've been thrown into an outlandish situation. Of course I won't judge you.",shape=box,color=red];
		1420 -> 1423;
	1421 [label="I will do my absolute best.",shape=box,color=red];
		1421 -> 1424;
	1422 [label="[End.]",shape=box,color=red];
		1422 -> 1425;
	1423 [label="Vraiment gentil to pay me such grace without knowing me or what I was about to write to you.",shape=box,color=blue];
		1423 -> 1426;
	1424 [label="+10 Chemistry",color=orange];
		1424 -> 1427;
	1425 [label="Chat ends.",color=orange];
	1426 [label="But... does the large-headed talking fish give you a headache as well ? Fibonacci ?",shape=box,color=blue];
		1426 -> 1428;
		1426 -> 1429;
		1426 -> 1430;
	1427 [label="I do appreciate that, thank you.",shape=box,color=blue];
		1427 -> 1426;
	1428 [label="Yes. Yes, absolutely. Thank you.",shape=box,color=red];
		1428 -> 1431;
	1429 [label="The notion of you being annoyed at Fibonacci is incredibly endearing.",shape=box,color=red];
		1429 -> 1432;
	1430 [label="No, actually. I adore him.",shape=box,color=red];
		1430 -> 1433;
	1431 [label="Then I am glad I am not alone. But, to be clear, I mean him no insult. If I feel out of sorts by nature of my current state of affairs, I imagine he endures as best he can.",shape=box,color=blue];
		1431 -> 1434;
	1432 [label="Oh ? How so ? I suppose I am glad for it, but I am simply confused as to why. My headache is certainly not nearly so charming.",shape=box,color=blue];
		1432 -> 1435;
		1432 -> 1436;
	1433 [label="Then I can only beg your forgiveness, I mean him no insult. If I feel out of sorts by nature of my current state of affairs, I imagine he endures as best he can.",shape=box,color=blue];
		1433 -> 1437;
	1434 [label="His means of doing so simply disagrees with me when I am subjected to it at length, is all.",shape=box,color=blue];
		1434 -> 1438;
	1435 [label="I spend most of my time having to fight for my life. Little reminders of humanity like this is... kind of what I live for.",shape=box,color=red];
		1435 -> 1439;
	1436 [label="I suppose every now and then I have to take a step back and reflect on the absurdity of it all. A Norg and a priestess of Sol...",shape=box,color=red];
		1436 -> 1440;
	1437 [label="His means of doing so simply disagrees with me when I am subjected to it at length, is all.",shape=box,color=blue];
		1437 -> 1441;
	1438 [label="Bah. I should not be complaining at all. I must bring Lyon his dinner tonight, he is once more laid out with a terrible megrim.",shape=box,color=blue];
		1438 -> 1442;
		1438 -> 1443;
	1439 [label="+5 Chemistry",color=orange];
		1439 -> 1444;
	1440 [label="+5 Chemistry",color=orange];
		1440 -> 1445;
	1441 [label="Bah. I should not be complaining at all. I must bring Lyon his dinner tonight, he is once more laid out with a terrible megrim.",shape=box,color=blue];
		1441 -> 1442;
		1441 -> 1443;
	1442 [label="Does he get them often?",shape=box,color=red];
		1442 -> 1446;
	1443 [label="Forgive me... a what?",shape=box,color=red];
		1443 -> 1447;
	1444 [label="Never lose that part of you, Drifter. Never let go of the part of you that seeks out those sparks of life.",shape=box,color=blue];
		1444 -> 1448;
	1445 [label="Goodness me, when you put it like that, no wonder. It does sound like one of those childish jokes, n'est-ce pas ?",shape=box,color=blue];
		1445 -> 1449;
	1446 [label="Oui, oui. Once every few weeks ? Once every two months ? The longest stretch I have seen him go without one is six months, perhaps.",shape=box,color=blue];
		1446 -> 1450;
	1447 [label="Oh ! Dear. Hm. Think of a headache, but far more intense. I have heard some others call them bilious headaches. They are more common in women.",shape=box,color=blue];
		1447 -> 1451;
		1447 -> 1452;
	1448 [label="The world is all too eager to become a dark and serious place. All too ready to levy suffering upon us at every turn.",shape=box,color=blue];
		1448 -> 1453;
	1449 [label="A Sister, a Priest, and a devil from the future get sent to the past... and then to the futur... and meet up with a fish, a deer-thing, a giant bird, and a butler...",shape=box,color=blue];
		1449 -> 1454;
	1450 [label="Check boolean Megrim",color=orange];
		1450 -> 1455 [label=true,color=green];
		1450 -> 1456 [label=true,color=green];
		1450 -> 1458 [label=true,color=green];
		1450 -> 1455 [label=false,color=brown];
		1450 -> 1456 [label=false,color=brown];
		1450 -> 1457 [label=false,color=brown];
	1451 [label="I think we call them \"migraines\" now.",shape=box,color=red];
		1451 -> 1459;
	1452 [label="Huh. Megrims. Thank you.",shape=box,color=red];
		1452 -> 1460;
	1453 [label="We must seek out whatever brightness, whatever levity we can, even in the form of childishness if we must.",shape=box,color=blue];
		1453 -> 1461;
	1454 [label="It is quite amusing, you are quite right !",shape=box,color=blue];
		1454 -> 1462;
	1455 [label="I wonder what causes them.",shape=box,color=red];
		1455 -> 1463;
	1456 [label="That sounds awful...",shape=box,color=red];
		1456 -> 1464;
	1458 [label="I also get megrims. They're terrible.",shape=box,color=red];
		1458 -> 1465;
	1457 [label="I also get those kinds of headaches. They're terrible.",shape=box,color=red];
		1457 -> 1465;
	1459 [label="I wonder what other fascinating historical particularités we shall discover ! Exciting. I do love to learn new things. \"Migraine.\" The journey was clearly not far.",shape=box,color=blue];
		1459 -> 1466;
	1460 [label="Update boolean Megrim",color=orange];
		1460 -> 1467;
	1461 [label="Now only if Lyon would see it the same way.",shape=box,color=blue];
		1461 -> 1468;
	1462 [label="Now if only my dear Lyon would see the brightness in it the same way.",shape=box,color=blue];
		1462 -> 1468;
	1463 [label="He has his theories. ",shape=box,color=blue];
		1463 -> 1469;
	1464 [label="If you were to express your sympathies, I am certain they would be welcome. And despite how it may seem, he will appreciate the company.",shape=box,color=blue];
		1464 -> 1470;
	1465 [label="You do ? You should tell Lyon. He needs to know others are capable of suffering in such a similar way.",shape=box,color=blue];
		1465 -> 1471;
	1466 [label="Update boolean Migraine",color=orange];
		1466 -> 1467;
	1467 [label="No matter the name, Lyon is prostrate with one and shall be until morning. Poor man cannot see anything but a blur, nor feel his hands nor feet. And he tells me the pain is intolerable.",shape=box,color=blue];
		1467 -> 1450;
	1468 [label="Update boolean MarieLyonSuffering1",color=orange];
		1468 -> 1472;
	1469 [label="Although it may be more correct to say that he had his theories, until lately.",shape=box,color=blue];
		1469 -> 1473;
	1470 [label="Though his demeanor may attempt to dissuade you, I implore you to hold strong, Drifter. There is a man with great need buried beneath what seems a stoic and stony exterior.",shape=box,color=blue];
		1470 -> 1474;
		1470 -> 1475;
		1470 -> 1476;
	1471 [label="+5 Chemistry",color=orange];
		1471 -> 1477;
	1472 [label="Ah, speaking of. I feel terrible for complaining about headaches. I must bring Lyon his dinner tonight, he is once more laid out with a terrible megrim.",shape=box,color=blue];
		1472 -> 1443;
		1472 -> 1442;
	1473 [label="Update boolean MarieLyonFaith1",color=orange];
		1473 -> 1470;
	1474 [label="I can be exceedingly stubborn. Don't you worry.",shape=box,color=red];
		1474 -> 1478;
	1475 [label="I've already got one Man in the Wall... why not two?",shape=box,color=red];
		1475 -> 1479;
	1476 [label="He is a grown man. If he wishes to talk, he can talk.",shape=box,color=red];
		1476 -> 1480;
	1477 [label="The Luminaries know he would otherwise willingly suffer alone...",shape=box,color=blue];
		1477 -> 1481;
	1478 [label="+5 Chemistry",color=orange];
		1478 -> 1482;
	1479 [label="Jest with me in such a fashion, but do not make such remarks to him. The topic of your Indifférence is a sore one with him.",shape=box,color=blue];
		1479 -> 1483;
	1480 [label="He is grown, yes. He is a man, yes. And I believe he wishes to talk. But I challenge you to question if he can talk.",shape=box,color=blue];
		1480 -> 1484;
	1481 [label="Update boolean MarieLyonSuffering2",color=orange];
		1481 -> 1470;
	1482 [label="You will need it with him, I fear. Thank you, Drifter. He is my dearest friend, and a brother to me. And it breaks my heart to see him in such pain.",shape=box,color=blue];
		1482 -> 1485;
	1483 [label="Be resilient. And patient. And kind. He is like a brother to me and is my dearest friend, Drifter. And it breaks my heart to see him in such pain.",shape=box,color=blue];
		1483 -> 1485;
	1484 [label="Not all of us are equally gifted or feel that we are entitled to such things. He is in pain and believes it is his lot to be in pain.",shape=box,color=blue];
		1484 -> 1486;
	1485 [label="We will speak again soon. Par la grâce de Sol.",shape=box,color=blue];
		1485 -> 3734;
	1486 [label="He is also like a brother to me and is my dearest friend. And my heart shatters for him. So I simply can only ask you to... be patient. And kind. If you are capable.",shape=box,color=blue];
		1486 -> 1485;
	3734 [label="{\"Id\":3734,\"Incoming\":[1485],\"Outgoing\":[1487],\"GraphPos\":[12826,24521],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue\",\"Tag\":\"LyonHeadaches\",\"Value\":0}]}",color=orange];
		3734 -> 1487;
	1487 [label="Chat ends.",color=orange];
}