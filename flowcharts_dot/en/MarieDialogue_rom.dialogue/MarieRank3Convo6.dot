digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank3Convo6 begins." [color=orange];
		"MarieRank3Convo6 begins." -> j448118690;
	j448118690 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j448118690 -> j3407632091;
	j3407632091 [label="I must ask you a question, and I must implore you not to judge me for it, Drifter.",shape=box,color=blue];
		j3407632091 -> j2761583471;
		j3407632091 -> j2727991151;
		j3407632091 -> j242691715;
	j2761583471 [label="You've been thrown into an outlandish situation. Of course I won't judge you.",shape=box,color=red];
		j2761583471 -> j3143345953;
	j2727991151 [label="I will do my absolute best.",shape=box,color=red];
		j2727991151 -> j2148651441;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j3143345953 [label="Vraiment gentil to pay me such grace without knowing me or what I was about to write to you.",shape=box,color=blue];
		j3143345953 -> j592965991;
	j2148651441 [label="+10 Chemistry",color=orange];
		j2148651441 -> j745793660;
	"Chat ends." [color=orange];
	j592965991 [label="But... does the large-headed talking fish give you a headache as well ? Fibonacci ?",shape=box,color=blue];
		j592965991 -> j3878304846;
		j592965991 -> j3619541332;
		j592965991 -> j1864568063;
	j745793660 [label="I do appreciate that, thank you.",shape=box,color=blue];
		j745793660 -> j592965991;
	j3878304846 [label="Yes. Yes, absolutely. Thank you.",shape=box,color=red];
		j3878304846 -> j717148541;
	j3619541332 [label="The notion of you being annoyed at Fibonacci is incredibly endearing.",shape=box,color=red];
		j3619541332 -> j699095915;
	j1864568063 [label="No, actually. I adore him.",shape=box,color=red];
		j1864568063 -> j2822457500;
	j717148541 [label="Then I am glad I am not alone. But, to be clear, I mean him no insult. If I feel out of sorts by nature of my current state of affairs, I imagine he endures as best he can.",shape=box,color=blue];
		j717148541 -> j580810014;
	j699095915 [label="Oh ? How so ? I suppose I am glad for it, but I am simply confused as to why. My headache is certainly not nearly so charming.",shape=box,color=blue];
		j699095915 -> j3483879410;
		j699095915 -> j3195092416;
	j2822457500 [label="Then I can only beg your forgiveness, I mean him no insult. If I feel out of sorts by nature of my current state of affairs, I imagine he endures as best he can.",shape=box,color=blue];
		j2822457500 -> j3861053372;
	j580810014 [label="His means of doing so simply disagrees with me when I am subjected to it at length, is all.",shape=box,color=blue];
		j580810014 -> j1249574460;
	j3483879410 [label="I spend most of my time having to fight for my life. Little reminders of humanity like this is... kind of what I live for.",shape=box,color=red];
		j3483879410 -> j1641365078;
	j3195092416 [label="I suppose every now and then I have to take a step back and reflect on the absurdity of it all. A Norg and a priestess of Sol...",shape=box,color=red];
		j3195092416 -> j1152276029;
	j3861053372 [label="His means of doing so simply disagrees with me when I am subjected to it at length, is all.",shape=box,color=blue];
		j3861053372 -> j1249574460;
	j1249574460 [label="Bah. I should not be complaining at all. I must bring Lyon his dinner tonight, he is once more laid out with a terrible megrim.",shape=box,color=blue];
		j1249574460 -> j3608622710;
		j1249574460 -> j3959163785;
	j1641365078 [label="+5 Chemistry",color=orange];
		j1641365078 -> j4004916630;
	j1152276029 [label="+5 Chemistry",color=orange];
		j1152276029 -> j721257940;
	j3608622710 [label="Does he get them often?",shape=box,color=red];
		j3608622710 -> j3309269428;
	j3959163785 [label="Forgive me... a what?",shape=box,color=red];
		j3959163785 -> j2117005202;
	j4004916630 [label="Never lose that part of you, Drifter. Never let go of the part of you that seeks out those sparks of life.",shape=box,color=blue];
		j4004916630 -> j1431697324;
	j721257940 [label="Goodness me, when you put it like that, no wonder. It does sound like one of those childish jokes, n'est-ce pas ?",shape=box,color=blue];
		j721257940 -> j3151184066;
	j3309269428 [label="Oui, oui. Once every few weeks ? Once every two months ? The longest stretch I have seen him go without one is six months, perhaps.",shape=box,color=blue];
		j3309269428 -> j547018639;
	j2117005202 [label="Oh ! Dear. Hm. Think of a headache, but far more intense. I have heard some others call them bilious headaches. They are more common in women.",shape=box,color=blue];
		j2117005202 -> j2489392908;
		j2117005202 -> j480162482;
	j1431697324 [label="The world is all too eager to become a dark and serious place. All too ready to levy suffering upon us at every turn.",shape=box,color=blue];
		j1431697324 -> j861135378;
	j3151184066 [label="A Sister, a Priest, and a devil from the future get sent to the past... and then to the futur... and meet up with a fish, a deer-thing, a giant bird, and a butler...",shape=box,color=blue];
		j3151184066 -> j3694568071;
	j547018639 [label="Check boolean Megrim",color=orange];
		j547018639 -> j3955276975 [label=true,color=green];
		j547018639 -> j569307289 [label=true,color=green];
		j547018639 -> j2251312767 [label=true,color=green];
		j547018639 -> j3955276975 [label=false,color=brown];
		j547018639 -> j569307289 [label=false,color=brown];
		j547018639 -> j2987300218 [label=false,color=brown];
	j2489392908 [label="I think we call them \"migraines\" now.",shape=box,color=red];
		j2489392908 -> j1172254813;
	j480162482 [label="Huh. Megrims. Thank you.",shape=box,color=red];
		j480162482 -> j1784011073;
	j861135378 [label="We must seek out whatever brightness, whatever levity we can, even in the form of childishness if we must.",shape=box,color=blue];
		j861135378 -> j1117445974;
	j3694568071 [label="It is quite amusing, you are quite right !",shape=box,color=blue];
		j3694568071 -> j1253363938;
	j3955276975 [label="I wonder what causes them.",shape=box,color=red];
		j3955276975 -> j1175934170;
	j569307289 [label="That sounds awful...",shape=box,color=red];
		j569307289 -> j2946693720;
	j2251312767 [label="I also get megrims. They're terrible.",shape=box,color=red];
		j2251312767 -> j2820932166;
	j2987300218 [label="I also get those kinds of headaches. They're terrible.",shape=box,color=red];
		j2987300218 -> j2820932166;
	j1172254813 [label="I wonder what other fascinating historical particularités we shall discover ! Exciting. I do love to learn new things. \"Migraine.\" The journey was clearly not far.",shape=box,color=blue];
		j1172254813 -> j2441485090;
	j1784011073 [label="Boolean Megrim is now true.",color=orange];
		j1784011073 -> j4017923421;
	j1117445974 [label="Now only if Lyon would see it the same way.",shape=box,color=blue];
		j1117445974 -> j2317152322;
	j1253363938 [label="Now if only my dear Lyon would see the brightness in it the same way.",shape=box,color=blue];
		j1253363938 -> j2317152322;
	j1175934170 [label="He has his theories. ",shape=box,color=blue];
		j1175934170 -> j4154648707;
	j2946693720 [label="If you were to express your sympathies, I am certain they would be welcome. And despite how it may seem, he will appreciate the company.",shape=box,color=blue];
		j2946693720 -> j1137466502;
	j2820932166 [label="You do ? You should tell Lyon. He needs to know others are capable of suffering in such a similar way.",shape=box,color=blue];
		j2820932166 -> j951554538;
	j2441485090 [label="Boolean Migraine is now true.",color=orange];
		j2441485090 -> j4017923421;
	j4017923421 [label="No matter the name, Lyon is prostrate with one and shall be until morning. Poor man cannot see anything but a blur, nor feel his hands nor feet. And he tells me the pain is intolerable.",shape=box,color=blue];
		j4017923421 -> j547018639;
	j2317152322 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j2317152322 -> j3320008357;
	j4154648707 [label="Although it may be more correct to say that he had his theories, until lately.",shape=box,color=blue];
		j4154648707 -> j1811325836;
	j1137466502 [label="Though his demeanor may attempt to dissuade you, I implore you to hold strong, Drifter. There is a man with great need buried beneath what seems a stoic and stony exterior.",shape=box,color=blue];
		j1137466502 -> j99271195;
		j1137466502 -> j1061431929;
		j1137466502 -> j199263369;
	j951554538 [label="+5 Chemistry",color=orange];
		j951554538 -> j3040091581;
	j3320008357 [label="Ah, speaking of. I feel terrible for complaining about headaches. I must bring Lyon his dinner tonight, he is once more laid out with a terrible megrim.",shape=box,color=blue];
		j3320008357 -> j3959163785;
		j3320008357 -> j3608622710;
	j1811325836 [label="Boolean MarieLyonFaith1 is now true.",color=orange];
		j1811325836 -> j1137466502;
	j99271195 [label="I can be exceedingly stubborn. Don't you worry.",shape=box,color=red];
		j99271195 -> j4290755201;
	j1061431929 [label="I've already got one Man in the Wall... why not two?",shape=box,color=red];
		j1061431929 -> j3062635242;
	j199263369 [label="He is a grown man. If he wishes to talk, he can talk.",shape=box,color=red];
		j199263369 -> j1631950031;
	j3040091581 [label="The Luminaries know he would otherwise willingly suffer alone...",shape=box,color=blue];
		j3040091581 -> j1461956407;
	j4290755201 [label="+5 Chemistry",color=orange];
		j4290755201 -> j2311630137;
	j3062635242 [label="Jest with me in such a fashion, but do not make such remarks to him. The topic of your Indifférence is a sore one with him.",shape=box,color=blue];
		j3062635242 -> j1677485920;
	j1631950031 [label="He is grown, yes. He is a man, yes. And I believe he wishes to talk. But I challenge you to question if he can talk.",shape=box,color=blue];
		j1631950031 -> j805592687;
	j1461956407 [label="Boolean MarieLyonSuffering2 is now true.",color=orange];
		j1461956407 -> j1137466502;
	j2311630137 [label="You will need it with him, I fear. Thank you, Drifter. He is my dearest friend, and a brother to me. And it breaks my heart to see him in such pain.",shape=box,color=blue];
		j2311630137 -> j1946016611;
	j1677485920 [label="Be resilient. And patient. And kind. He is like a brother to me and is my dearest friend, Drifter. And it breaks my heart to see him in such pain.",shape=box,color=blue];
		j1677485920 -> j1946016611;
	j805592687 [label="Not all of us are equally gifted or feel that we are entitled to such things. He is in pain and believes it is his lot to be in pain.",shape=box,color=blue];
		j805592687 -> j3463066822;
	j1946016611 [label="We will speak again soon. Par la grâce de Sol.",shape=box,color=blue];
		j1946016611 -> "Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j3463066822 [label="He is also like a brother to me and is my dearest friend. And my heart shatters for him. So I simply can only ask you to... be patient. And kind. If you are capable.",shape=box,color=blue];
		j3463066822 -> j1946016611;
	"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
}