digraph {
	"MarieRank1Convo5 begins." [color=orange];
		"MarieRank1Convo5 begins." -> j814477297;
	j814477297 [label="Bonjour, bonjour ! You must be the Drifter, oui ? Monsieur Loid has told me so very much about you. I am so very pleased to \"meet\" you on this...",shape=box,color=blue];
		j814477297 -> j1232032049;
	j1232032049 [label="Appareil cliquetant, clever though it is !",shape=box,color=blue];
		j1232032049 -> j2186130974;
	j2186130974 [label="I am Sœur Marie Leroux, but you may call me Marie. I have recently come here with the brother of my soul, Father Lyon Allard and... well, I think Monsieur Loid may have warned you of the devil, n'est-ce pas ?",shape=box,color=blue];
		j2186130974 -> j1986921658;
		j2186130974 -> j41216395;
		j2186130974 -> j242691715;
	j1986921658 [label="It's lovely to meet you. And don't take this the wrong way, you're welcome here, but... what are you all doing here?",shape=box,color=red];
		j1986921658 -> j2106552108;
	j41216395 [label="The devil? You mean the Orokin?",shape=box,color=red];
		j41216395 -> j828307863;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j2106552108 [label="+5 Chemistry",color=orange];
		j2106552108 -> j2515653162;
	j828307863 [label="Oui, ce monstre irritant à la peau bleue that we have been entrusted with by le Cardinal. I believe you know him as Albrecht Entrati ? He is the reason why we are here. But that is a very long story, j'en ai bien peur.",shape=box,color=blue];
		j828307863 -> j1461078277;
		j828307863 -> j307403001;
	"Chat ends." [color=orange];
	j2515653162 [label="Merci ! The what and the how of our being here is a very long story, j'en ai bien peur. We were sent here by le Cardinal. I believe you know him as Albrecht Entrati ? He entrusted us with that blue-skinned monstre irritant.",shape=box,color=blue];
		j2515653162 -> j1461078277;
		j2515653162 -> j307403001;
	j1461078277 [label="I'll do what I can to help.",shape=box,color=red];
		j1461078277 -> j1018023310;
	j307403001 [label="\"Entrusted?\"",shape=box,color=red];
		j307403001 -> j582855217;
	j1018023310 [label="+5 Chemistry",color=orange];
		j1018023310 -> j835314781;
	j582855217 [label="We are to do what we can to guide his soul, si c'est possible. Et si ce n'est pas le cas ? Then we must ensure at the very least that he does not cause any more harm.",shape=box,color=blue];
		j582855217 -> j86265762;
		j582855217 -> j629944693;
	j835314781 [label="You are just as Monsieur Loid and the Cavia described ! I think we are bound to be good friends.",shape=box,color=blue];
		j835314781 -> j947705643;
	j86265762 [label="I'm willing to help you try.",shape=box,color=red];
		j86265762 -> j1018023310;
	j629944693 [label="He's Orokin. The only way you'll be able to do that is by putting a bullet between his eyes.",shape=box,color=red];
		j629944693 -> j3172912337;
	j947705643 [label="Ah ! I must go, forgive me. I hope we shall speak again soon ! À la revoyure !",shape=box,color=blue];
		j947705643 -> "Chat ends.";
	j3172912337 [label="You sound like Lyon. I shall not give up hope. Not yet.",shape=box,color=blue];
		j3172912337 -> j947705643;
}