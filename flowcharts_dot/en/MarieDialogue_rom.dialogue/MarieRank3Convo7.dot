digraph {
	"MarieRank3Convo7 begins." [color=orange];
		"MarieRank3Convo7 begins." -> j678565364;
	j678565364 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j678565364 -> j1112666164;
		j678565364 -> j4206560159;
		j678565364 -> j242691715;
	j1112666164 [label="How did you and Lyon meet?",shape=box,color=red];
		j1112666164 -> j664886493;
	j4206560159 [label="Is Lyon... all right?",shape=box,color=red];
		j4206560159 -> j526703688;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j664886493 [label="My dear Lyon was already long established at the Cathédrale when the Mère Supérieure took me in, and I joined the Church of the Luminaries as a Sister. (I am giddy that you are speaking !)",shape=box,color=blue];
		j664886493 -> j1414277468;
		j664886493 -> j3635690114;
	j526703688 [label="I am going to ask you to define that before we move forward. And I will ask you to do that gently, and with a careful reminder that he is the brother of my soul.",shape=box,color=blue];
		j526703688 -> j430147245;
		j526703688 -> j815296050;
	"Chat ends." [color=orange];
	j1414277468 [label="Were you... in need of a place to stay?",shape=box,color=red];
		j1414277468 -> j1789653426;
	j3635690114 [label="May I ask an indelicate question?",shape=box,color=red];
		j3635690114 -> j1410197447;
	j430147245 [label="If this conversation bothers you, we can move on to something else.",shape=box,color=red];
		j430147245 -> j576813637;
	j815296050 [label="I don't want to upset you at all. I just worry about him. He has a stoic appearance, but I get the feeling he's in pain, is all.",shape=box,color=red];
		j815296050 -> j3782482724;
	j1789653426 [label="Because I was cast there by ma famille many years earlier when I was a little girl. I spent many years as a beggar, living however I could.",shape=box,color=blue];
		j1789653426 -> j2900433413;
	j1410197447 [label="+5 Chemistry",color=orange];
		j1410197447 -> j3802099405;
	j576813637 [label="No, no. It is all right. I am simply accustomed to curious onlookers creeping about, coming to tap on the bars of his cage like he was some manner of monstre de cirque.",shape=box,color=blue];
		j576813637 -> j4189584051;
		j576813637 -> j1957453731;
		j576813637 -> j3772491859;
	j3782482724 [label="+5 Chemistry",color=orange];
		j3782482724 -> j2080045221;
	j2900433413 [label="Boolean MarieBeggar1 is now true.",color=orange];
		j2900433413 -> j3548252615;
	j3802099405 [label="By all accounts, you are told to be a wolf, and with me you have such manners ! It is so sweet to see. I think I know what you wish to ask. Why was I on the streets ?",shape=box,color=blue];
		j3802099405 -> j1789653426;
	j4189584051 [label="How did you two meet?",shape=box,color=red];
		j4189584051 -> j3455996900;
	j1957453731 [label="I'm used to being a bit of a \"local attraction,\" I understand how you could be defensive.",shape=box,color=red];
		j1957453731 -> j1069605050;
	j3772491859 [label="It's all right. I'm just worried about him.",shape=box,color=red];
		j3772491859 -> j1765329297;
	j2080045221 [label="I... apologize for my brusqueness. I am simply accustomed to curious onlookers creeping about, coming to tap on the bars of his cage like he was some manner of monstre de cirque.",shape=box,color=blue];
		j2080045221 -> j1957453731;
		j2080045221 -> j3772491859;
	j3548252615 [label="You can imagine there was not much work or places for someone like me to go, with no working legs, dans la Cité de la Lumière in my time.",shape=box,color=blue];
		j3548252615 -> j595303038;
	j3455996900 [label="My dear Lyon was already long established at the Cathédrale when the Mère Supérieure took me in, and I joined the Church of the Luminaries as a Sister.",shape=box,color=blue];
		j3455996900 -> j1719551183;
		j3455996900 -> j1586147976;
	j1069605050 [label="Oui, I imagine you must be, a time-traveling creature who can loop time and summon worlds from whole cloth ! A bit of a magician, you are, non ?",shape=box,color=blue];
		j1069605050 -> j2848989169;
		j1069605050 -> j2902067458;
	j1765329297 [label="+5 Chemistry",color=orange];
		j1765329297 -> j3274018926;
	j595303038 [label="Which is why I suppose Lyon and I became so quickly as family. Never once did he look at me with pity. Nor I he.",shape=box,color=blue];
		j595303038 -> j3005281077;
	j1719551183 [label="Were you... in need of a place to stay?",shape=box,color=red];
		j1719551183 -> j773312379;
	j1586147976 [label="May I ask an indelicate question?",shape=box,color=red];
		j1586147976 -> j1151119326;
	j2848989169 [label="That summarizes it fairly neatly.",shape=box,color=red];
		j2848989169 -> j3886805932;
	j2902067458 [label="I would hope people see me as more than that, honestly.",shape=box,color=red];
		j2902067458 -> j3953695982;
	j3274018926 [label="And I adore that you are. He is strong and can withstand what has been levied against him. But all burdens are easier to carry together.",shape=box,color=blue];
		j3274018926 -> j4132141060;
		j3274018926 -> j1421095918;
	j3005281077 [label="Where others are so quick to curiously tap upon bars of his cage like he was some manner of monstre de cirque.",shape=box,color=blue];
		j3005281077 -> j2409953385;
	j773312379 [label="Because I was cast there by ma famille many years earlier when I was a little girl. I spent many years as a beggar, living however I could.",shape=box,color=blue];
		j773312379 -> j3626700142;
	j1151119326 [label="+5 Chemistry",color=orange];
		j1151119326 -> j2574835566;
	j3886805932 [label="+10 Chemistry",color=orange];
		j3886805932 -> j665030482;
	j3953695982 [label="+15 Chemistry",color=orange];
		j3953695982 -> j923751751;
	j4132141060 [label="I feel like he won't talk to me.",shape=box,color=red];
		j4132141060 -> j133782757;
	j1421095918 [label="I want to help him, if I can. Do you have any advice?",shape=box,color=red];
		j1421095918 -> j133782757;
	j2409953385 [label="I hope that is not what you are doing here.",shape=box,color=blue];
		j2409953385 -> j3121436243;
		j2409953385 -> j3540429078;
	j3626700142 [label="Boolean MarieBeggar1 is now true.",color=orange];
		j3626700142 -> j2445468650;
	j2574835566 [label="By all accounts, you are told to be a wolf, and with me you have such manners! It is so sweet to see. I think I know what you wish to ask. Why was I on the streets ?",shape=box,color=blue];
		j2574835566 -> j773312379;
	j665030482 [label="Someday, there will be a storybook written about you, I think. How charming the thought. Perhaps I shall write it. Though it would be in Gaullique! Imaginez cela !",shape=box,color=blue];
		j665030482 -> j3075505780;
	j923751751 [label="Then you truly do understand. I am more than Sister Marie, the poor girl with no feet given the power to fly. And Lyon is more than a tragic priest who bears his burdens in silence.",shape=box,color=blue];
		j923751751 -> j1085339296;
	j133782757 [label="+10 Chemistry",color=orange];
		j133782757 -> j1749176708;
	j3121436243 [label="I'm used to being a bit of a \"local attraction,\" I know how you both feel. No, that's not what this is. ",shape=box,color=red];
		j3121436243 -> j4213013558;
	j3540429078 [label="No, I was just curious. And honestly, a little worried about him. I think he masks a lot of his pain.",shape=box,color=red];
		j3540429078 -> j425922075;
	j2445468650 [label="You can imagine there was not much work or places for someone like me to go, with no working legs, dans la Cité de la Lumière in my time.",shape=box,color=blue];
		j2445468650 -> j2421226371;
	j3075505780 [label="Or perhaps do not imagine any such thing, it may come true. Hah! And on that wonderful note, I fear I must bid you adieu. The Murmure never cease !",shape=box,color=blue];
		j3075505780 -> "Chat ends.";
	j1085339296 [label="Remember that, and we shall be good friends, I think. And on that wonderful note, I fear I must bid you adieu. The Murmure never cease !",shape=box,color=blue];
		j1085339296 -> "Chat ends.";
	j1749176708 [label="Be patient. He is... not forthcoming, at first. But he will come to you, when the time is right. If you mean well, he will know it. But now, I fear I must bid you adieu.",shape=box,color=blue];
		j1749176708 -> "Chat ends.";
	j4213013558 [label="Oui, I imagine you must be, a time-traveling creature who can loop time and summon worlds from whole cloth! A bit of a magician, you are, non ?",shape=box,color=blue];
		j4213013558 -> j2848989169;
		j4213013558 -> j2902067458;
	j425922075 [label="+15 Chemistry",color=orange];
		j425922075 -> j3645819755;
	j2421226371 [label="Which is why I suppose Lyon and I became so quickly as family. Never once did he look at me with pity. Nor I he.",shape=box,color=blue];
		j2421226371 -> j2105499311;
		j2421226371 -> j1164491345;
	j3645819755 [label="You are correct, he does. But he feels it is necessary to do so, to protect those around him. When he feels you no longer need such things, he will tell you what troubles him. Be patient. He will speak to you in time.",shape=box,color=blue];
		j3645819755 -> j2018654763;
	j2105499311 [label="I hope he feels comfortable enough to talk to me, soon.",shape=box,color=red];
		j2105499311 -> j133782757;
	j1164491345 [label="I'm glad you two found each other. We're all more than we might seem at first glance.",shape=box,color=red];
		j1164491345 -> j3422969868;
	j2018654763 [label="Bah. I fear I must bid you adieu. The Murmure never cease !",shape=box,color=blue];
		j2018654763 -> "Chat ends.";
	j3422969868 [label="+15 Chemistry",color=orange];
		j3422969868 -> j1800011957;
