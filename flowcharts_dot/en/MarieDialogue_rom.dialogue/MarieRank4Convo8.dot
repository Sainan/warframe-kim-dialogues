	1596 [label="Update boolean MarieOtak1",color=orange];
		1596 -> 2945;
	1603 [label="Oui, that is very wise. I am merely thinking aloud and wondering to you what they are. You are quite right, there is never any harm in showing kindness and respect.",shape=box,color=blue];
		1603 -> 1610;
	1604 [label="Perhaps you are right. And I hope you are ! Whatever the case may be, we must be kind - for they are thinking creatures. And what may think, may feel.",shape=box,color=blue];
