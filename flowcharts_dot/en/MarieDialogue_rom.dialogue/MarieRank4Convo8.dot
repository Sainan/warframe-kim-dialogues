	1930 [label="How so?",shape=box,color=red];
		1930 -> 1934;
	1931 [label="What specifically is the issue?",shape=box,color=red];
		1931 -> 1934;
	1928 [label="Of course. What is it?",shape=box,color=red];
		1928 -> 1932;
	1929 [label="[End.]",shape=box,color=red];
		1929 -> 1933;
	1934 [label="I asked Monsieur Necraloid if the skull that adorned him belonged to a living soul at one point or another or not.",shape=box,color=blue];
		1934 -> 1936;
	1932 [label="I find myself curious as to why there is another face upon his back that resembles a child's scrawl.",shape=box,color=blue];
		1932 -> 1935;
	1933 [label="Chat ends.",color=orange];
	1936 [label="And Monsieur Necraloid told me that it was \"his\" skull, though he admitted Monsieur Loid was the \"original.\" Monsieur Loid interjected to tell me that it was a \"replicated\" version of his own skull.",shape=box,color=blue];
		1936 -> 1938;
	1935 [label="I inquired with Monsieur Necraloid and Monsieur Loid both, and neither wished to speak of it, they only told me a name. Otak. And it was with great sadness that they uttered it.",shape=box,color=blue];
		1935 -> 1937;
	1938 [label="How can that be ? And what does \"replicated\" mean ? Is it a real skull ou bien c'est un faux ? Why would Monsieur Necraloid and Monsieur Loid have differing answers ?",shape=box,color=blue];
		1938 -> 1940;
		1938 -> 1941;
		1938 -> 1942;
	1937 [label="So here I am, speaking with you, in hopes you might be able to aid me.",shape=box,color=blue];
		1937 -> 1939;
	1940 [label="I suppose from Necraloid's perspective, it is his skull. That's true. But it is, from Loid's perspective, a replica.",shape=box,color=red];
		1940 -> 1944;
	1941 [label="I honestly don't know what it's made out of. It could be bone. Or some kind of polymer...",shape=box,color=red];
		1941 -> 1945;
	1942 [label="I think the root of the question you're grappling with is, \"is Necraloid real,\" not \"is the skull real.\"",shape=box,color=red];
		1942 -> 1946;
	1939 [label="Will you tell me the story of poor Monsieur Otak ?",shape=box,color=blue];
		1939 -> 1943;
	1944 [label="I think that is what troubles me. It is the way the two gentlemen consider its origin. One believes it to be sacro-saint, the other a copie.",shape=box,color=blue];
		1944 -> 1948;
	1945 [label="I do not know if it is what the skull is made of that troubles me so. It is its origin. Or perhaps the way the two gentlemen consider its origin. One believes it to be sacro-saint, the other a copie.",shape=box,color=blue];
		1945 -> 1948;
	1946 [label="+5 Chemistry",color=orange];
		1946 -> 1949;
	1943 [label="Otak used to be an Archimedean, an Orokin scientist and academic. What's happened to him isn't exactly the happiest story.",shape=box,color=red];
		1943 -> 1947;
	1948 [label="Evaluate expressions",color=orange];
		1948 -> 1558 [label="MarieCephalonSoul",color=purple];
		1948 -> 1557 [label="MarieCephalonNoSoul",color=purple];
		1948 -> 1559 [label="MarieCephalonUnsure",color=purple];
		1948 -> 1560 [label="false",color=purple];
	1949 [label="Oui ! You are right, that is the heart of it - or the skull of it - ha. One believes it to be sacro-saint, the other a copie.",shape=box,color=blue];
		1949 -> 1948;
	1947 [label="By all accounts he was a genius, and the mind behind the harnessing of argon crystals.",shape=box,color=red];
		1947 -> 1556;
	1558 [label="How can Monsieur Necraloid own a soul, when he does not own his own bones ?",shape=box,color=blue];
		1558 -> 1562;
		1558 -> 1563;
		1558 -> 1564;
	1557 [label="Is this more proof that Monsieur Necraloid has no soul ?",shape=box,color=blue];
		1557 -> 1562;
		1557 -> 1563;
		1557 -> 1564;
	1559 [label="I know you are uncertain if Monsieur Necraloid can own a soul. But I do not know how he could, when he does not own his own bones.",shape=box,color=blue];
		1559 -> 1562;
		1559 -> 1563;
		1559 -> 1564;
	1560 [label="I am speaking of a very elaborate piece of technology made to resemble a man, am I not ? A phonographe, many many times more complex.",shape=box,color=blue];
		1560 -> 1565;
		1560 -> 1566;
		1560 -> 1567;
		1560 -> 1568;
		1560 -> 1569;
	1556 [label="Which are harnessed from the Void - they're the reason we can create a lot of the powerful warframes and weapons we make.",shape=box,color=red];
		1556 -> 1561;
	1562 [label="Maybe you're right. Maybe they really are just copies of people. But I'm not sure, and we have to treat them as if they are people, anyway.",shape=box,color=red];
		1562 -> 1571;
	1563 [label="I think Necraloid is the exception, not the rule. He was made as a replica of a person, not from a person.",shape=box,color=red];
		1563 -> 1572;
	1564 [label="You're right. It's probably better, and more humane, if they aren't actually souls trapped inside elaborate science...",shape=box,color=red];
		1564 -> 1573;
	1565 [label="Necraloid may not have a soul, but he's unique. Other Cephalons, like Otak, do. They were destroyed in how they were made.",shape=box,color=red];
		1565 -> 1574;
	1566 [label="You're right. So what would you have me do about it?",shape=box,color=red];
		1566 -> 1575;
	1567 [label="You're right. They don't. But it doesn't mean we can go around treating them poorly.",shape=box,color=red];
		1567 -> 1576;
	1568 [label="I don't know if you're right or not. But they can still think, and feel, and we can't treat them like things.",shape=box,color=red];
		1568 -> 1577;
	1569 [label="Necraloid has a soul. All Cephalons do.",shape=box,color=red];
		1569 -> 1578;
	1561 [label="He specialized in crystallography. And his works were archived here, in the laboratories.",shape=box,color=red];
		1561 -> 1570;
