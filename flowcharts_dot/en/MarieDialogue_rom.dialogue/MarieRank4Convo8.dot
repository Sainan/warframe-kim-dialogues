	1927 [label="Drifter, the more and more I sit with the knowledge of Monsieur Necraloid and Monsieur Otak the more it troubles me...",shape=box,color=blue];
		1927 -> 1930;
		1927 -> 1931;
	1926 [label="Drifter, may I speak to you ?",shape=box,color=blue];
		1926 -> 1928;
