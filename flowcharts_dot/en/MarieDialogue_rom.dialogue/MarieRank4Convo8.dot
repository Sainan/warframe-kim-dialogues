	1591 [label="Update boolean MarieCephalonUnsure",color=orange];
		1591 -> 1599;
	1592 [label="More proof that the devil and his ilk were right to be condemned. But, perhaps you are right about Otak and his kind, or perhaps it brings you peace to believe so.",shape=box,color=blue];
		1592 -> 1593;
	1593 [label="And I may be wrong, when all is said and done. There is never any harm in showing kindness and respect.",shape=box,color=blue];
		1593 -> 1600;
	1594 [label="Perhaps you are right, but I do not think the Orokin devils knew more of the workings of the soul than we. They were no great gods.",shape=box,color=blue];
