	1762 [label="He's an adult. He can decide when he wants to talk.",shape=box,color=red];
		1762 -> 1766;
	1763 [label="My heart is breaking to see him going through this pain. I don't know how to help him.",shape=box,color=red];
		1763 -> 1767;
	1764 [label="[End.]",shape=box,color=red];
		1764 -> 1768;
	1765 [label="I don't know how to help him.",shape=box,color=red];
		1765 -> 1769;
	1766 [label="When you were trapped in this world of your making, caught in an endless cycle of death, did you have help to escape ?",shape=box,color=blue];
		1766 -> 1770;
		1766 -> 1771;
	1767 [label="Oui, and it is painful to watch him suffer... Especially now knowing how you have made room in your heart for him.",shape=box,color=blue];
		1767 -> 1769;
	1768 [label="Chat ends.",color=orange];
	1769 [label="It is a hard thing, to predict where the borders may be with him. They often shift from day to day.",shape=box,color=blue];
		1769 -> 1772;
	1770 [label="None of their help would have been worth anything if I didn't want to be helped.",shape=box,color=red];
		1770 -> 1773;
		1770 -> 1774;
	1771 [label="I did, from friends.",shape=box,color=red];
		1771 -> 1773;
		1771 -> 1774;
	1772 [label="I have seen him struggle with the agonies the gods have heaped upon his shoulders. I have known when to be silent at his side, or when to be the proverbial wall upon which he may pound his fists.",shape=box,color=blue];
		1772 -> 1775;
	1773 [label="I don't think Lyon wants my help.",shape=box,color=red];
		1773 -> 1776;
	1774 [label="I'm trying to be here for him, but he's not listening.",shape=box,color=red];
		1774 -> 1777;
	1775 [label="Mais ça ? This ? This place, the words of the devil, the uncertainty that le Cardinal has caused... This has brought him pain from which I pray he can return.",shape=box,color=blue];
		1775 -> 1778;
		1775 -> 1779;
	1776 [label="Then I suppose... there is nothing left to do but be patient, non ?",shape=box,color=blue];
		1776 -> 1780;
	1777 [label="Nor to myself, which is why I have come to discuss this with you. I have always been able to console him -",shape=box,color=blue];
		1777 -> 1781;
	1778 [label="So you admit that Entrati has hurt Lyon? And how does this sit with you?",shape=box,color=red];
		1778 -> 1782;
	1779 [label="I feel like he's teetering on the brink. How do I help pull him back?",shape=box,color=red];
		1779 -> 1783;
	1780 [label="Merci. I am sorry to waste your time.",shape=box,color=blue];
		1780 -> 1784;
	1781 [label="I find myself taken aback at his rage, his désespoir... he shuns my company in a way that he never has before.",shape=box,color=blue];
		1781 -> 1785;
	1782 [label="Pas bien... But how am I meant to choose between my love for my brother and my adoration for le Cardinal ? How must I choose between my famille ?",shape=box,color=blue];
		1782 -> 1786;
		1782 -> 1787;
		1782 -> 1788;
		1782 -> 3961;
	1783 [label="I do not know, which is why I have come to discuss this with you. I have always been able to console him - ",shape=box,color=blue];
		1783 -> 1781;
	1784 [label="Chat ends.",color=orange];
	1785 [label="What has troubled him so ? Do you know the cause ?",shape=box,color=blue];
		1785 -> 1789;
	1786 [label="You don't have to choose, Marie. People can be complicated in the way they exist in our lives.",shape=box,color=red];
		1786 -> 1790;
	1787 [label="I would choose the family who is still here. Not the one who left you.",shape=box,color=red];
		1787 -> 1791;
	1788 [label="I'm sure Entrati didn't want to cause Lyon this kind of pain.",shape=box,color=red];
		1788 -> 1792;
	3961 [label="You could choose a new family. Like me. And those around you who care, without Entrati.",shape=box,color=red];
		3961 -> 3962;
	1789 [label="Evaluate expressions",color=orange];
		1789 -> 1793 [label="DrifterFaithNoMITW",color=purple];
		1789 -> 1795 [label="DrifterFaithNoMITW",color=purple];
		1789 -> 1797 [label="LyonRell3",color=purple];
		1789 -> 1795 [label="LyonRell3",color=purple];
		1789 -> 1798 [label="LyonRoathe3",color=purple];
		1789 -> 1795 [label="LyonRoathe3",color=purple];
		1789 -> 1794 [label="LyonEntrati3",color=purple];
		1789 -> 1795 [label="LyonEntrati3",color=purple];
		1789 -> 1795 [label="LyonRell1",color=purple];
		1789 -> 1796 [label="false",color=purple];
	1790 [label="That's the problem with people like Entrati. They're not just forces for \"Good\" or \"Bad.\" They're a mix.",shape=box,color=red];
		1790 -> 1799;
	1791 [label="Let us keep this talk of le Cardinal away from this conversation, oui ? I am concerned for the brother of my soul.",shape=box,color=blue];
		1791 -> 1781;
	1792 [label="I do not think he did either, but the fact of it remains, oui ? But I appreciate your sentiment. Cela dit...",shape=box,color=blue];
		1792 -> 1791;
	3962 [label="Update boolean DrifterMarie",color=orange];
		3962 -> 3963;
	1793 [label="Lyon is trying to come to terms with the fact that the Indifference isn't a real god.",shape=box,color=red];
		1793 -> 1800;
	1795 [label="I don't think it's just one thing that's causing it. I think it's being caught between a great many things.",shape=box,color=red];
		1795 -> 1802;
	1797 [label="Lyon was hearing the voice of one of the Tenno, a kid named Rell. Rell... died. I don't think he's coping well with this.",shape=box,color=red];
		1797 -> 1804;
	1798 [label="He has Roathe whispering lies to him about the Man in the Wall.",shape=box,color=red];
		1798 -> 1805;
	1794 [label="I don't imagine having Entrati whispering to him that the voices of his gods are actually the voices from the Void helped.",shape=box,color=red];
		1794 -> 1801;
	1796 [label="I honestly don't, no.",shape=box,color=red];
		1796 -> 1803;
	1799 [label="Let us keep this talk of le Cardinal away from this conversation, oui ? I am concerned for the brother of my soul. But... I know what you say is... more and more becoming the clear truth.",shape=box,color=blue];
		1799 -> 1806;
	3963 [label="Do not think I do not see what you did, sneaking yourself in there first, wolf.",shape=box,color=blue];
		3963 -> 1799;
	1800 [label="And you have been no help in these matters, if you talk to him in such a way. Even if one's words are truth, one must be careful how they are delivered.",shape=box,color=blue];
		1800 -> 1807;
	1802 [label="Oui, he has been a shelter in the storm for so many... and now he is caught in one himself.",shape=box,color=blue];
		1802 -> 1809;
	1804 [label="I have heard him speak that name, Rell - and it breaks my heart to know of the boy's fate.",shape=box,color=blue];
		1804 -> 1811;
	1805 [label="That devil has caused more woe in his long life than so many ! But I do not think it is the only cause of his strife, non ?",shape=box,color=blue];
		1805 -> 1812;
	1801 [label="S'il te plaît, no more talk of le Cardinal. I do not deny that his words add to Lyon's strife, but it cannot be the only cause.",shape=box,color=blue];
		1801 -> 1808;
	1803 [label="Then I suppose... all we can do is be patient and hope that we discover what troubles him.",shape=box,color=blue];
		1803 -> 1810;
	1806 [label="Update boolean MarieEntrati4a",color=orange];
		1806 -> 1781;
	1807 [label="Surgery is not best performed with an axe. This is not the Brittanic Navy.",shape=box,color=blue];
		1807 -> 1813;
	1809 [label="Torn from all sides, and not knowing which way to go...",shape=box,color=blue];
		1809 -> 1815;
		1809 -> 1816;
	1811 [label="But I do not think it is the only cause of his strife ? Lyon follows the path of Lua. La mort est une compagne qui marche à ses côtés",shape=box,color=blue];
		1811 -> 1813;
	1812 [label="It has aided his uncertainty... But to put that much value into the words of a devil ? My Lyon knows better than that. I think it has been many things that now weigh him down.",shape=box,color=blue];
		1812 -> 1818;
		1812 -> 1819;
	1808 [label="Update boolean MarieEntrati4b",color=orange];
		1808 -> 1814;
	1810 [label="+15 Chemistry",color=orange];
		1810 -> 1817;
	1813 [label="Non, I think it has been many things that now weigh him down.",shape=box,color=blue];
		1813 -> 1818;
		1813 -> 1819;
	1815 [label="We have to be his shelter, then. A place he knows won't hurt him.",shape=box,color=red];
		1815 -> 1820;
	1816 [label="We need to show him the way back to safety, then. Be the light in the darkness.",shape=box,color=red];
		1816 -> 1821;
	1818 [label="I guess then... we need to show him the way back to safety, then. Be the light in the darkness.",shape=box,color=red];
		1818 -> 1821;
	1819 [label="I guess then... we just have to be his shelter. A place he knows won't hurt him.",shape=box,color=red];
		1819 -> 1823;
	1814 [label="He did not place enough weight in le Cardinal's words to let it pitch him into such darkness. I think it has been many things that now weigh him down.",shape=box,color=blue];
		1814 -> 1819;
		1814 -> 1818;
	1817 [label="Merci. I know you are trying your best. And for this, I am grateful.",shape=box,color=blue];
		1817 -> 1822;
	1820 [label="+10 Chemistry",color=orange];
		1820 -> 1824;
	1821 [label="How do you aid someone who cannot hear your call, cannot see your light ? Non, Lua has shrouded him in this darkness.",shape=box,color=blue];
		1821 -> 1825;
	1823 [label="+5 Chemistry",color=orange];
		1823 -> 1824;
	1822 [label="Chat ends.",color=orange];
	1824 [label="Oui, I suppose you are right. We must be those that he can turn to, when all else fails him.",shape=box,color=blue];
		1824 -> 1826;
	1825 [label="I do not think even the light of Sol could pierce the veil.",shape=box,color=blue];
		1825 -> 1826;
	1826 [label="Where his faith may be infirm, we must be the ground beneath his feet. ",shape=box,color=blue];
		1826 -> 1827;
	1827 [label="If all the unseen voices have turned from welcome fantômes to démons in the shadows that plague him -",shape=box,color=blue];
		1827 -> 1828;
	1828 [label="We must make ourselves all the more real, non ?",shape=box,color=blue];
		1828 -> 1829;
		1828 -> 1830;
	1829 [label="I'll keep trying.",shape=box,color=red];
		1829 -> 1831;
	1830 [label="I just hope this doesn't tear him apart.",shape=box,color=red];
		1830 -> 1832;
	1831 [label="+10 Chemistry",color=orange];
		1831 -> 1833;
	1832 [label="+5 Chemistry",color=orange];
		1832 -> 1834;
	1833 [label="That is all we can do, in the end.",shape=box,color=blue];
		1833 -> 1835;
	1834 [label="Oui... as do I. But all we can do is stand beside him and pray, non ?",shape=box,color=blue];
		1834 -> 1836;
	1835 [label="Try. And pray.",shape=box,color=blue];
		1835 -> 1837;
	1836 [label="And hope it is not too late.",shape=box,color=blue];
		1836 -> 1837;
	1837 [label="Merci... I must go. I am sorry if this conversation was not of much use. I fret when I cannot act.",shape=box,color=blue];
		1837 -> 1838;
		1837 -> 1839;
	1838 [label="I'm the same way. But sometimes, action is the wrong choice.",shape=box,color=red];
		1838 -> 1840;
	1839 [label="He'll be all right. I'm sure of it.",shape=box,color=red];
		1839 -> 1840;
	1840 [label="I pray you are correct. I do not know what I would do without him.",shape=box,color=blue];
