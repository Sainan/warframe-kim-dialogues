	"MarieRank4Convo6 begins." [color=orange];
		"MarieRank4Convo6 begins." -> j3345346052;
	j3345346052 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j3345346052 -> j3023286837;
	j3023286837 [label="Check boolean LyonIndifference1",color=orange];
		j3023286837 -> j3301517485 [label=true,color=green];
		j3023286837 -> "Chat ends." [label=false,color=brown];
	j3301517485 [label="Drifter ? Do you have a moment ? I must speak with you about Lyon...",shape=box,color=blue];
		j3301517485 -> j1531216646;
	"Chat ends." [color=orange];
	j1531216646 [label="Check boolean DrifterLyon",color=orange];
		j1531216646 -> j1736719142 [label=true,color=green];
		j1531216646 -> j1429589159 [label=true,color=green];
		j1531216646 -> j242691715 [label=true,color=green];
		j1531216646 -> j1736719142 [label=false,color=brown];
		j1531216646 -> j1678204925 [label=false,color=brown];
		j1531216646 -> j242691715 [label=false,color=brown];
	j1736719142 [label="He's an adult. He can decide when he wants to talk.",shape=box,color=red];
		j1736719142 -> j4009517550;
	j1429589159 [label="My heart is breaking to see him going through this pain. I don't know how to help him.",shape=box,color=red];
		j1429589159 -> j3621808135;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j1678204925 [label="I don't know how to help him.",shape=box,color=red];
		j1678204925 -> j901018774;
	j4009517550 [label="When you were trapped in this world of your making, caught in an endless cycle of death, did you have help to escape ?",shape=box,color=blue];
		j4009517550 -> j2960855332;
		j4009517550 -> j68161685;
	j3621808135 [label="Oui, and it is painful to watch him suffer... Especially now knowing how you have made room in your heart for him.",shape=box,color=blue];
		j3621808135 -> j901018774;
	j901018774 [label="It is a hard thing, to predict where the borders may be with him. They often shift from day to day.",shape=box,color=blue];
		j901018774 -> j69657961;
	j2960855332 [label="None of their help would have been worth anything if I didn't want to be helped.",shape=box,color=red];
		j2960855332 -> j3462959195;
		j2960855332 -> j1870027423;
	j68161685 [label="I did, from friends.",shape=box,color=red];
		j68161685 -> j3462959195;
		j68161685 -> j1870027423;
	j69657961 [label="I have seen him struggle with the agonies the gods have heaped upon his shoulders. I have known when to be silent at his side, or when to be the proverbial wall upon which he may pound his fists.",shape=box,color=blue];
		j69657961 -> j658453695;
	j3462959195 [label="I don't think Lyon wants my help.",shape=box,color=red];
		j3462959195 -> j4004220335;
	j1870027423 [label="I'm trying to be here for him, but he's not listening.",shape=box,color=red];
		j1870027423 -> j2427060347;
	j658453695 [label="Mais ça ? This ? This place, the words of the devil, the uncertainty that le Cardinal has caused... This has brought him pain from which I pray he can return.",shape=box,color=blue];
		j658453695 -> j658387046;
		j658453695 -> j94797225;
	j4004220335 [label="Then I suppose... there is nothing left to do but be patient, non ?",shape=box,color=blue];
		j4004220335 -> j2998410057;
	j2427060347 [label="Nor to myself, which is why I have come to discuss this with you. I have always been able to console him -",shape=box,color=blue];
		j2427060347 -> j3096917512;
	j658387046 [label="So you admit that Entrati has hurt Lyon? And how does this sit with you?",shape=box,color=red];
		j658387046 -> j168965323;
	j94797225 [label="I feel like he's teetering on the brink. How do I help pull him back?",shape=box,color=red];
		j94797225 -> j2167195269;
	j2998410057 [label="Merci. I am sorry to waste your time.",shape=box,color=blue];
		j2998410057 -> "Chat ends.";
	j3096917512 [label="I find myself taken aback at his rage, his désespoir... he shuns my company in a way that he never has before.",shape=box,color=blue];
		j3096917512 -> j1111008101;
	j168965323 [label="Pas bien... But how am I meant to choose between my love for my brother and my adoration for le Cardinal ? How must I choose between my famille ?",shape=box,color=blue];
		j168965323 -> j3317846290;
		j168965323 -> j89518548;
		j168965323 -> j1611607060;
		j168965323 -> j4280533004;
	j2167195269 [label="I do not know, which is why I have come to discuss this with you. I have always been able to console him - ",shape=box,color=blue];
		j2167195269 -> j3096917512;
	j1111008101 [label="What has troubled him so ? Do you know the cause ?",shape=box,color=blue];
		j1111008101 -> j2411453274;
	j3317846290 [label="You don't have to choose, Marie. People can be complicated in the way they exist in our lives.",shape=box,color=red];
		j3317846290 -> j1123264325;
	j89518548 [label="I would choose the family who is still here. Not the one who left you.",shape=box,color=red];
		j89518548 -> j896396377;
	j1611607060 [label="I'm sure Entrati didn't want to cause Lyon this kind of pain.",shape=box,color=red];
		j1611607060 -> j2359123534;
	j4280533004 [label="You could choose a new family. Like me. And those around you who care, without Entrati.",shape=box,color=red];
		j4280533004 -> j3017146389;
	j2411453274 [label="Evaluate expressions",color=orange];
		j2411453274 -> j95304696 [label="DrifterFaithNoMITW",color=purple];
		j2411453274 -> j3364109049 [label="DrifterFaithNoMITW",color=purple];
		j2411453274 -> j4025875235 [label="LyonRell3",color=purple];
		j2411453274 -> j3364109049 [label="LyonRell3",color=purple];
		j2411453274 -> j3418586826 [label="LyonRoathe3",color=purple];
		j2411453274 -> j3364109049 [label="LyonRoathe3",color=purple];
		j2411453274 -> j980207681 [label="LyonEntrati3",color=purple];
		j2411453274 -> j3364109049 [label="LyonEntrati3",color=purple];
		j2411453274 -> j3364109049 [label="LyonRell1",color=purple];
		j2411453274 -> j3209246286 [label="false",color=purple];
	j1123264325 [label="That's the problem with people like Entrati. They're not just forces for \"Good\" or \"Bad.\" They're a mix.",shape=box,color=red];
		j1123264325 -> j1455167933;
	j896396377 [label="Let us keep this talk of le Cardinal away from this conversation, oui ? I am concerned for the brother of my soul.",shape=box,color=blue];
		j896396377 -> j3096917512;
	j2359123534 [label="I do not think he did either, but the fact of it remains, oui ? But I appreciate your sentiment. Cela dit...",shape=box,color=blue];
		j2359123534 -> j896396377;
	j3017146389 [label="Boolean DrifterMarie is now true.",color=orange];
		j3017146389 -> j2662837213;
	j95304696 [label="Lyon is trying to come to terms with the fact that the Indifference isn't a real god.",shape=box,color=red];
		j95304696 -> j3899031098;
	j3364109049 [label="I don't think it's just one thing that's causing it. I think it's being caught between a great many things.",shape=box,color=red];
		j3364109049 -> j1020929832;
	j4025875235 [label="Lyon was hearing the voice of one of the Tenno, a kid named Rell. Rell... died. I don't think he's coping well with this.",shape=box,color=red];
		j4025875235 -> j515080323;
	j3418586826 [label="He has Roathe whispering lies to him about the Man in the Wall.",shape=box,color=red];
		j3418586826 -> j722182476;
	j980207681 [label="I don't imagine having Entrati whispering to him that the voices of his gods are actually the voices from the Void helped.",shape=box,color=red];
		j980207681 -> j397089088;
	j3209246286 [label="I honestly don't, no.",shape=box,color=red];
		j3209246286 -> j4277721414;
	j1455167933 [label="Let us keep this talk of le Cardinal away from this conversation, oui ? I am concerned for the brother of my soul. But... I know what you say is... more and more becoming the clear truth.",shape=box,color=blue];
		j1455167933 -> j3790667277;
	j2662837213 [label="Do not think I do not see what you did, sneaking yourself in there first, wolf.",shape=box,color=blue];
		j2662837213 -> j1455167933;
	j3899031098 [label="And you have been no help in these matters, if you talk to him in such a way. Even if one's words are truth, one must be careful how they are delivered.",shape=box,color=blue];
		j3899031098 -> j1213826615;
	j1020929832 [label="Oui, he has been a shelter in the storm for so many... and now he is caught in one himself.",shape=box,color=blue];
		j1020929832 -> j633655241;
	j515080323 [label="I have heard him speak that name, Rell - and it breaks my heart to know of the boy's fate.",shape=box,color=blue];
		j515080323 -> j2400252586;
	j722182476 [label="That devil has caused more woe in his long life than so many ! But I do not think it is the only cause of his strife, non ?",shape=box,color=blue];
		j722182476 -> j279773239;
	j397089088 [label="S'il te plaît, no more talk of le Cardinal. I do not deny that his words add to Lyon's strife, but it cannot be the only cause.",shape=box,color=blue];
		j397089088 -> j453562948;
	j4277721414 [label="Then I suppose... all we can do is be patient and hope that we discover what troubles him.",shape=box,color=blue];
		j4277721414 -> j2036447444;
	j3790667277 [label="Boolean MarieEntrati4a is now true.",color=orange];
		j3790667277 -> j3096917512;
	j1213826615 [label="Surgery is not best performed with an axe. This is not the Brittanic Navy.",shape=box,color=blue];
		j1213826615 -> j1597537659;
	j633655241 [label="Torn from all sides, and not knowing which way to go...",shape=box,color=blue];
		j633655241 -> j2494964703;
		j633655241 -> j3700551535;
	j2400252586 [label="But I do not think it is the only cause of his strife ? Lyon follows the path of Lua. La mort est une compagne qui marche à ses côtés.",shape=box,color=blue];
		j2400252586 -> j1597537659;
	j279773239 [label="It has aided his uncertainty... But to put that much value into the words of a devil ? My Lyon knows better than that. I think it has been many things that now weigh him down.",shape=box,color=blue];
		j279773239 -> j1829084554;
		j279773239 -> j2014841563;
	j453562948 [label="Boolean MarieEntrati4b is now true.",color=orange];
		j453562948 -> j4018541517;
	j2036447444 [label="+15 Chemistry",color=orange];
		j2036447444 -> j1951140113;
	j1597537659 [label="Non, I think it has been many things that now weigh him down.",shape=box,color=blue];
		j1597537659 -> j1829084554;
		j1597537659 -> j2014841563;
	j2494964703 [label="We have to be his shelter, then. A place he knows won't hurt him.",shape=box,color=red];
		j2494964703 -> j1072034689;
	j3700551535 [label="We need to show him the way back to safety, then. Be the light in the darkness.",shape=box,color=red];
		j3700551535 -> j1442222610;
	j1829084554 [label="I guess... we need to show him the way back to safety, then. Be the light in the darkness.",shape=box,color=red];
		j1829084554 -> j1442222610;
	j2014841563 [label="I guess then... we just have to be his shelter. A place he knows won't hurt him.",shape=box,color=red];
		j2014841563 -> j3970171871;
	j4018541517 [label="He did not place enough weight in le Cardinal's words to let it pitch him into such darkness. I think it has been many things that now weigh him down.",shape=box,color=blue];
		j4018541517 -> j2014841563;
		j4018541517 -> j1829084554;
	j1951140113 [label="Merci. I know you are trying your best. And for this, I am grateful.",shape=box,color=blue];
		j1951140113 -> "Chat ends.";
	j1072034689 [label="+10 Chemistry",color=orange];
		j1072034689 -> j2422613864;
	j1442222610 [label="How do you aid someone who cannot hear your call, cannot see your light ? Non, Lua has shrouded him in this darkness.",shape=box,color=blue];
		j1442222610 -> j948087490;
	j3970171871 [label="+5 Chemistry",color=orange];
		j3970171871 -> j2422613864;
	j2422613864 [label="Oui, I suppose you are right. We must be those that he can turn to, when all else fails him.",shape=box,color=blue];
		j2422613864 -> j3721968427;
	j948087490 [label="I do not think even the light of Sol could pierce the veil.",shape=box,color=blue];
		j948087490 -> j3721968427;
	j3721968427 [label="Where his faith may be infirm, we must be the ground beneath his feet. ",shape=box,color=blue];
		j3721968427 -> j2130095258;
	j2130095258 [label="If all the unseen voices have turned from welcome fantômes to démons in the shadows that plague him -",shape=box,color=blue];
		j2130095258 -> j975051374;
	j975051374 [label="We must make ourselves all the more real, non ?",shape=box,color=blue];
		j975051374 -> j4028203498;
		j975051374 -> j2234375503;
	j4028203498 [label="I'll keep trying.",shape=box,color=red];
		j4028203498 -> j1846813452;
	j2234375503 [label="I just hope this doesn't tear him apart.",shape=box,color=red];
		j2234375503 -> j278471647;
	j1846813452 [label="+10 Chemistry",color=orange];
		j1846813452 -> j1941493417;
	j278471647 [label="+5 Chemistry",color=orange];
		j278471647 -> j2729598985;
	j1941493417 [label="That is all we can do, in the end.",shape=box,color=blue];
		j1941493417 -> j1804009780;
	j2729598985 [label="Oui... as do I. But all we can do is stand beside him and pray, non ?",shape=box,color=blue];
		j2729598985 -> j3869104411;
	j1804009780 [label="Try. And pray.",shape=box,color=blue];
		j1804009780 -> j3805454251;
	j3869104411 [label="And hope it is not too late.",shape=box,color=blue];
		j3869104411 -> j3805454251;
	j3805454251 [label="Merci... I must go. I am sorry if this conversation was not of much use. I fret when I cannot act.",shape=box,color=blue];
		j3805454251 -> j2137653439;
		j3805454251 -> j2828732707;
	j2137653439 [label="I'm the same way. But sometimes, action is the wrong choice.",shape=box,color=red];
		j2137653439 -> j3377626561;
	j2828732707 [label="He'll be all right. I'm sure of it.",shape=box,color=red];
		j2828732707 -> j3377626561;
	j3377626561 [label="I pray you are correct. I do not know what I would do without him.",shape=box,color=blue];
		j3377626561 -> "Chat ends.";
}