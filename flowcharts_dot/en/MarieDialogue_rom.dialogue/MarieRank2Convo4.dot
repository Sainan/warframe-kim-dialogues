	611 [label="+5 Chemistry",color=orange];
		611 -> 615;
	609 [label="Oh! Sorry. It's a turn of phrase my friends from 1999 taught me... ",shape=box,color=red];
		609 -> 612;
		609 -> 613;
	614 [label="Merci. It was creative, but you asked me a question, and my ire should not have been pointed at you, forgive me.",shape=box,color=blue];
		614 -> 618;
	615 [label="It was not. Forgive me, I should not have pointed that you. ",shape=box,color=blue];
		615 -> 618;
	612 [label="I didn't mean it literally, I'm afraid.",shape=box,color=red];
		612 -> 616;
	613 [label="Now I can see why they think this is always so cute when I'm confused...",shape=box,color=red];
		613 -> 617;
	618 [label="Evaluate expressions",color=orange];
		618 -> 624 [label="MarieRoatheWarning",color=purple];
		618 -> 623 [label="DrifterRoathe",color=purple];
