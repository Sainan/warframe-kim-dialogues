		638 -> 647;
	639 [label="Add -1 to Thermostat",color=orange];
		639 -> 648;
	636 [label="Add -1 to Thermostat",color=orange];
		636 -> 645;
	637 [label="Add 1 to Thermostat",color=orange];
		637 -> 646;
	635 [label="I cannot imagine to most people who do not surround themselves with flying heads and talking animals, that an elephant would not be cause for conversation.",shape=box,color=blue];
		635 -> 644;
	651 [label="+5 Chemistry",color=orange];
		651 -> 660;
	652 [label="And you assume I would not comprehend ? I am no fool - I have not been reduced to hysterics, transported as I am, transfigured as I have been.",shape=box,color=blue];
		652 -> 661;
		652 -> 662;
	649 [label="Understanding to what ends, is my concern. But you do not need me lecturing you, I am not your mother, nor do I wish to sour this friendship in its early days...",shape=box,color=blue];
		649 -> 658;
	650 [label="+5 Chemistry",color=orange];
		650 -> 659;
	647 [label="+5 Chemistry",color=orange];
		647 -> 656;
	648 [label="I simply urge caution. He could charm Lua to give him the stars from the sky, I think.",shape=box,color=blue];
		648 -> 657;
	645 [label="Understanding to what ends, is my concern. But you do not need me lecturing you.",shape=box,color=blue];
		645 -> 654;
	646 [label="+5 Chemistry",color=orange];
		646 -> 655;
	644 [label="... I suspect I have answered my own question, have I not ?",shape=box,color=blue];
		644 -> 653;
	660 [label="I appreciate the apology and I accept it, but consider that I have been both transported and transfigured and find myself surrounded by l'impossible. ",shape=box,color=blue];
		660 -> 666;
	661 [label="Never mind. I'll just go talk to the devil himself.",shape=box,color=red];
		661 -> 667;
	662 [label="I'm sorry. I don't mean to be arguing with you, that's not what I meant. ",shape=box,color=red];
		662 -> 668;
		662 -> 669;
	658 [label="I simply worry over you. He is a skillful and manipulative beast... ",shape=box,color=blue];
		658 -> 664;
	659 [label="And I would declare you a Saint of Sol for even making an attempt at such a thing.",shape=box,color=blue];
		659 -> 664;
	656 [label="Oui, the curse of the soldier... Burn the town to save the country. Kill the man to save the family. Where does the horror cease, though ?",shape=box,color=blue];
		656 -> 665;
	657 [label="Remember who and what he is, at the end of the day... not a god, or even a beast, but a man. A man who thinks too highly of himself.",shape=box,color=blue];
		657 -> 664;
	654 [label="He could charm Lua to give him the stars from the sky, I think. Be careful, is all I will say.",shape=box,color=blue];
		654 -> 664;
	655 [label="Then you are wise, to not listen his honeyed words. He could charm Lua to give him the stars from the sky, I think.",shape=box,color=blue];
		655 -> 664;
	653 [label="You have. It means \"can we talk about the subject we're all avoiding, as if we were not talking about the giant elephant in the room.\"",shape=box,color=red];
		653 -> 663;
	666 [label="When you believe I cannot comprehend or can hold no sympathy for the stories of others, please reconsider, oui ?",shape=box,color=blue];
		666 -> 673;
	667 [label="Qu'il en soit ainsi.",shape=box,color=blue];
		667 -> 674;
	668 [label="He's a soldier. He's had to do terrible things in the name of a \"greater purpose.\" I know how that feels. Sometimes, that kind of life turns you... well. Like him.",shape=box,color=red];
		668 -> 675;
	669 [label="He's lived for hundreds, if not thousands of years. Who knows what that really does to a person? How much pain, how much suffering? I know how that feels.",shape=box,color=red];
		669 -> 676;
	664 [label="But you wished to ask me about the devil himself, did you not ? What would you like to know ?",shape=box,color=blue];
		664 -> 670;
		664 -> 671;
		664 -> 672;
	665 [label="We must see war through the eyes of the statistician, for if we viewed it through the eyes of the fallen, we would never cease to weep.",shape=box,color=blue];
		665 -> 664;
	663 [label="And if I may be allowed to guess a second time as to the nature of this éléphant... would he be blue of skin ?",shape=box,color=blue];
		663 -> 618;
	673 [label="And I, for my part, shall reconsider telling you your business in return.",shape=box,color=blue];
		673 -> 661;
		673 -> 680;
	674 [label="Chat ends.",color=orange];
	675 [label="+5 Chemistry",color=orange];
		675 -> 681;
	676 [label="+5 Chemistry",color=orange];
		676 -> 682;
	670 [label="Why do you dislike him so much?",shape=box,color=red];
		670 -> 677;
	671 [label="Why did Entrati leave him with you and Lyon?",shape=box,color=red];
		671 -> 678;
	672 [label="I was curious how you met?",shape=box,color=red];
		672 -> 679;
	680 [label="Agreed.",shape=box,color=red];
		680 -> 687;
	681 [label="Ah, and now I do feel the fool. Yes, of course, you would know what it is like to kill in the name of \"purpose\" as you said... Of course you would seek to understand someone who has done the same.",shape=box,color=blue];
		681 -> 688;
	682 [label="Ah, and now I do feel the fool. Yes, of course, you would know what it is like to live again and again... Of course you would seek to know someone who has done the same.",shape=box,color=blue];
		682 -> 688;
	677 [label="Is it not obvious ? His demeanor is like that of a great big cat who insists on marking his territory and knocking things from shelves.",shape=box,color=blue];
		677 -> 683;
		677 -> 684;
	678 [label="When Cardinal Dimanche - Entrati - departed for the last time, he left the devil upon our doorstep. Broken, bleeding, and barely able to even recall his own name.",shape=box,color=blue];
		678 -> 685;
	679 [label="It was storming the night the devil came to us. A terrible thundering that shook the walls of the Cathédrale.",shape=box,color=blue];
		679 -> 686;
	687 [label="Update boolean MarieRoatheWarning",color=orange];
		687 -> 694;
	688 [label="Let us come to an accord. When you believe I cannot comprehend or can hold no sympathy for the stories of others, please reconsider, oui ?",shape=box,color=blue];
		688 -> 673;
	683 [label="I rather like cats, personally. ",shape=box,color=red];
		683 -> 689;
	684 [label="Do you not like cats?",shape=box,color=red];
		684 -> 690;
	685 [label="I know now he had only just been given the sérum, and the transformation, if unwilling, is... a painful one.",shape=box,color=blue];
		685 -> 691;
	686 [label="Check boolean MarieLyonVisions",color=orange];
		686 -> 693 [label=true,color=green];
		686 -> 692 [label=false,color=brown];
	694 [label="Magnifique ! Now, you had wished to ask me about the devil himself, did you not ? What would you like to know ?",shape=box,color=blue];
		694 -> 670;
		694 -> 671;
		694 -> 672;
	689 [label="Cats are quite wonderful, when a cat is a cat ! He is a grown man, with many years of life behind him !",shape=box,color=blue];
		689 -> 695;
	690 [label=" I do, when a cat is a cat ! He is a man, a grown man, with many years of life behind him !",shape=box,color=blue];
		690 -> 695;
	691 [label="Le Cardinal looked down upon the devil and spoke, \"Uriel, Heretic of Xata, in banishment, answer - can the Orokin ever be forgiven ?\"",shape=box,color=blue];
		691 -> 696;
	693 [label="This time, if Lyon tells you of the storm that shook our home, he speaks the reality of it, that of us shared.",shape=box,color=blue];
		693 -> 692;
	692 [label="It was wonderfully cliché, I think, to have such evil arrive in such a maelstrom.",shape=box,color=blue];
		692 -> 678;
	695 [label="Many more years than any single human being, blue or otherwise transfigured beyond recognition as they would like to be, should have.",shape=box,color=blue];
		695 -> 697;
		695 -> 698;
		695 -> 3906;
	696 [label="And in a clap of thunder, like the gods themselves were summoning him away, le Cardinal was simply gone.",shape=box,color=blue];
		696 -> 699;
	697 [label="Genetically altering one's form was a fashion statement in the Orokin days. But they were just as human as we are. Or were, I suppose.",shape=box,color=red];
		697 -> 700;
	698 [label="Except for the tail, he honestly looks... more human than many of the Orokin did, back in the day.",shape=box,color=red];
		698 -> 701;
	3906 [label="Don't worry, I think you're much prettier than he is.",shape=box,color=red];
		3906 -> 3907;
	699 [label="And we were left with... him. The devil.",shape=box,color=blue];
		699 -> 702;
	700 [label="Yes, I suppose I do not know what I am, anymore. Part Marie, part... \"Wisp\" part... whatever Infested Things now share my veins.",shape=box,color=blue];
		700 -> 703;
	701 [label="Yes, I was looking upon an old portrait of le Cardinal, when he looked more like the devil. He told me of the Orokin ways, how they used to alter themselves.",shape=box,color=blue];
		701 -> 704;
	3907 [label="Check boolean DrifterMarie",color=orange];
		3907 -> 3908 [label=true,color=green];
		3907 -> 3909 [label=false,color=brown];
	702 [label="Le Cardinal left it to us to... see to his soul, perhaps ? Or at least to mind the chains that bind him. Je préférerais le renvoyer en enfer.",shape=box,color=blue];
		702 -> 705;
		702 -> 706;
	703 [label="A conversation for another time, perhaps.",shape=box,color=blue];
		703 -> 707;
	704 [label="How similar yet so foreign to how the ladies of my day would wear ostentatious wigs that could reach for the sky, or dresses that might house an entire orphanage without much effort !",shape=box,color=blue];
		704 -> 708;
	3908 [label="You must stop making me blush ! Monsieur Loid will wonder what I am doing sitting here !",shape=box,color=blue];
		3908 -> 3911;
	3909 [label="Update boolean DrifterMarie",color=orange];
		3909 -> 3910;
	705 [label="Do you think that everyone can be forgiven, in the end?",shape=box,color=red];
		705 -> 709;
	706 [label="Is there anything about him you like? Anything at all?",shape=box,color=red];
		706 -> 710;
	707 [label="Update boolean MarieInfestation",color=orange];
		707 -> 711;
	708 [label="Humans are what humans shall always be - unhappy in their own Sol-given shapes. Eager to work their own flesh like clay. I am no exception, I suppose.",shape=box,color=blue];
		708 -> 712;
	3911 [label="Besides, it is not so difficult to be prettier than the devil, non ? His features are handsome, but the blue... ce n'est pas pour moi.",shape=box,color=blue];
		3911 -> 3912;
	3910 [label="Ah ! You are making me blush ! What will Monsieur Loid think if he sees me sitting here, like so ?",shape=box,color=blue];
		3910 -> 3911;
	709 [label="Do I ? Oui. Yes. I believe all souls are capable of earning forgiveness for their transgressions.",shape=box,color=blue];
		709 -> 713;
	710 [label="Nothing. Nothing, ever.",shape=box,color=blue];
		710 -> 714;
		710 -> 715;
	711 [label="My issue with him is that he has all the murderous ego of a feline without any of the charming nature of being a small, adorable companion.",shape=box,color=blue];
		711 -> 716;
	712 [label="All too happy as I was to take the sérum that made me part Marie, part... \"Wisp\" and part... whatever Infested Things that now share my veins.",shape=box,color=blue];
		712 -> 703;
	3912 [label="I do accept your compliment, if it was sincerely meant. I was simply startled. May we... return to the topic at hand ?",shape=box,color=blue];
		3912 -> 707;
	713 [label="The question remains... does he even feel he needs such a thing to begin with ?",shape=box,color=blue];
		713 -> 717;
	714 [label="Well, I appreciate your story. So Entrati wants him to be... forgiven? For what? Tau? Or simply being Orokin?",shape=box,color=red];
		714 -> 718;
	715 [label="All right, I believe you. I don't think you'd lie to me.",shape=box,color=red];
		715 -> 719;
	716 [label="He thinks too highly of himself. He takes life without hesitation. He plays with his foes as though they were nothing but a mouse he has cornered.",shape=box,color=blue];
		716 -> 702;
	717 [label="Forgiveness cannot be given to those who do not think they requiring of it. One would be better suited to teach a fish to fly.",shape=box,color=blue];
		717 -> 720;
	718 [label="I do not know. And the other question remains, does he even feel he needs such a thing as forgiveness to begin with ?",shape=box,color=blue];
		718 -> 717;
	719 [label="Fie ! Very well. There is one thing we share... a wicked temptation for sweets. The devil was oft wont to return to the Cathédrale having lifted pastries from the shops without properly paying for them.",shape=box,color=blue];
		719 -> 721;
	720 [label="But speak to him of the topic yourself, if you wish to understand the insurmountable challenge you now face if you seek to win that particular war.",shape=box,color=blue];
		720 -> 722;
	721 [label="I would explain that this was theft, and he would go on some long-winded lecture about how the Orokin would soon rule the solar system so it was not theft in the grand scheme of things...",shape=box,color=blue];
		721 -> 723;
	722 [label="I merely wish you luck.",shape=box,color=blue];
		722 -> 724;
	723 [label="I would shout at him, Lyon would be forced to intercede...",shape=box,color=blue];
		723 -> 725;
		723 -> 726;
	724 [label="+10 Chemistry",color=orange];
		724 -> 727;
	725 [label="And the pastries...?",shape=box,color=red];
		725 -> 728;
	726 [label="Did you ever wonder if he was bringing them back for you all to enjoy together?",shape=box,color=red];
		726 -> 729;
	727 [label="Chat ends.",color=orange];
	728 [label="We could not very well let them go to waste, could we? It was a sin to eat them, but it was a worse sin to let them moulder. So we enjoyed them.",shape=box,color=blue];
		728 -> 730;
	729 [label="If that is true, he made a terrible showing of it in the process. But... you may be right. Regardless, we could not let them go to waste. It was a sin to eat them, but a worse sin to let the moulder. So, we enjoyed them.",shape=box,color=blue];
		729 -> 730;
	730 [label="+10 Chemistry",color=orange];
		730 -> 731;
	731 [label="Hm. Perhaps it was a bit of a habit of his, now that I think on it, to bring back more than he could consume alone...",shape=box,color=blue];
		731 -> 732;
	732 [label="Update boolean MarieRoathePastry1",color=orange];
		732 -> 733;
	733 [label="I will think on this. Until tomorrow. À la revoyure.",shape=box,color=blue];
		733 -> 734;
	734 [label="Chat ends.",color=orange];
}