	601 [label="Can I ask you about the elephant in the room?",shape=box,color=red];
		601 -> 604;
	600 [label="[End.]",shape=box,color=red];
		600 -> 603;
	605 [label="Ce diable est un imbécile qui se croit au-dessus de tout reproche ! Je préfèrerais boire un pot de vernis à bois plutôt que de passer une minute de plus à l'écouter s'enorgueillir comme un chat qui se lèche le pelage !",shape=box,color=blue];
		605 -> 607;
		605 -> 608;
	604 [label="Quoi! Où ça? Un éléphant ?!",shape=box,color=blue];
		604 -> 606;
	603 [label="Chat ends.",color=orange];
	607 [label="That was wonderfully creative.",shape=box,color=red];
		607 -> 610;
	608 [label="I... am going to assume none of that was kind.",shape=box,color=red];
		608 -> 611;
	606 [label="I see only a fish, a bird, and... whatever M'sieur Tagfer is. I see many strange things in this Sanctum, but no éléphant - are you making joke ?",shape=box,color=blue];
		606 -> 609;
	610 [label="+5 Chemistry",color=orange];
