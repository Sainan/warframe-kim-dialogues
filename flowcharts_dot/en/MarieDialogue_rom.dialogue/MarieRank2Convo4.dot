		618 -> 621 [label="false",color=purple];
	616 [label="+5 Chemistry",color=orange];
		616 -> 619;
	617 [label="+5 Chemistry",color=orange];
		617 -> 620;
	624 [label="Though I am surprised you come to me again for my thoughts. You were clear enough with your warning before. You do not wish to hear me speak ill of him and his ilk.",shape=box,color=blue];
		624 -> 633;
		624 -> 634;
	623 [label="I admit, I do not know as I should be continuing this conversation, if I am honest. You seem drawn to him comme un papillon vers une flamme.",shape=box,color=blue];
		623 -> 631;
		623 -> 632;
	622 [label="Still seeking him as an ally ? You play a dangerous game, adding him to your pack, wolf. He is liable to rip out your throat when you least expect it.",shape=box,color=blue];
		622 -> 629;
		622 -> 630;
	621 [label="I am surprised you come to me. It is clear that I think poorly of that devil.",shape=box,color=blue];
		621 -> 627;
		621 -> 628;
	619 [label="It would not surprise me if there was ! It seems we have all other manner of ménagerie in this place.",shape=box,color=blue];
		619 -> 625;
	620 [label="Oui, it is quite charming, isn't it ? I often will say something to Monsieur Loid and he looks at me as though I have caught him entirely unprepared.",shape=box,color=blue];
		620 -> 626;
	633 [label="I responded harshly, and I apologize for that. I don't want to condemn him for his actions yet - I'm trying to understand him from all sides.",shape=box,color=red];
		633 -> 642;
	634 [label="I don't. He's led a life that's hard to understand. But I was curious if you would tell me how you two met.",shape=box,color=red];
		634 -> 643;
	631 [label="I'm simply trying to find the explanation as to why he is the way he is. I'm trying to understand him.",shape=box,color=red];
		631 -> 640;
	632 [label="If I know more about him, it might help me figure out how to guide him down a slightly... more benign path.",shape=box,color=red];
		632 -> 641;
	629 [label="I know. But I can't hate him for doing what he needed to to serve his people. I've had to do the same thing.",shape=box,color=red];
		629 -> 638;
	630 [label="He is one of the most dangerous Orokin the empire ever knew. We'd be fools to turn away that kind of help.",shape=box,color=red];
		630 -> 639;
	627 [label="I know, but you must have insight into him. I'm trying to understand him better.",shape=box,color=red];
		627 -> 636;
	628 [label="Which is why I'm asking you about him. I want to understand him, and I don't particularly trust how he tells his side of the story.",shape=box,color=red];
		628 -> 637;
	625 [label="What does the phrase mean ? If there is an elephant in the room, why would we not speak about it?",shape=box,color=blue];
		625 -> 635;
	626 [label="And for a man who could have been manservant to the Queen herself, I take pride in it.",shape=box,color=blue];
		626 -> 625;
	642 [label="Add 1 to Thermostat",color=orange];
		642 -> 651;
	643 [label="Add 1 to Thermostat",color=orange];
		643 -> 652;
