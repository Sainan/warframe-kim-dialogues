		64 -> 67;
	65 [label="Ha ! He is one of the fastest to learn I have ever met, Drifter ! I would be wary to challenge him to any puzzles with wagers of money attached, if I were you.",shape=box,color=blue];
		65 -> 67;
	66 [label="Non, he does quite well with new things. I would not put it past him to have studied the machines ambulantes that stomp about the lairs below and have designs of his own before long.",shape=box,color=blue];
		66 -> 67;
	67 [label="It is simply that he does not know you. Lyon is not... sociable at the best of times. It is not meant to offend you.",shape=box,color=blue];
