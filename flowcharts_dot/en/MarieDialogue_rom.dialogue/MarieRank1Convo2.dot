		j1081977543 -> j3559109156;
	j316078720 [label="Right. I figured if you and Roathe were both on here...",shape=box,color=red];
		j316078720 -> j2826949240;
	j88380269 [label="Ha ! He is one of the fastest to learn I have ever met, Drifter ! I would be wary to challenge him to any puzzles with wagers of money attached, if I were you.",shape=box,color=blue];
		j88380269 -> j2826949240;
	j3559109156 [label="Non, he does quite well with new things. I would not put it past him to have studied the machines ambulantes that stomp about the lairs below and have designs of his own before long.",shape=box,color=blue];
		j3559109156 -> j2826949240;
	j2826949240 [label="It is simply that he does not know you. Lyon is not... sociable at the best of times. It is not meant to offend you.",shape=box,color=blue];
		j2826949240 -> j2181757885;
		j2826949240 -> j3389405250;
	j2181757885 [label="Is there anything you can do?",shape=box,color=red];
		j2181757885 -> j3118343995;
	j3389405250 [label="I'm glad it isn't me...",shape=box,color=red];
		j3389405250 -> j1630486809;
	j3118343995 [label="Lyon has... much loudness within his own mind. He takes great care with whom he shares it.",shape=box,color=blue];
