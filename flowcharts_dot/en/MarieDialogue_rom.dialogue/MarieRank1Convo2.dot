		68 -> 70;
	69 [label="I'm glad it isn't me...",shape=box,color=red];
		69 -> 71;
	70 [label="Lyon has... much loudness within his own mind. He takes great care with whom he shares it.",shape=box,color=blue];
		70 -> 72;
