		212 -> 220;
	205 [label="+15 Chemistry",color=orange];
		205 -> 216;
	206 [label="I would suggest that it is a sense of guilt, not nobility, that keeps us down here.",shape=box,color=blue];
		206 -> 217;
	207 [label="And I would love to meet them some day, but that is hardly the point I am making, silly wolf.",shape=box,color=blue];
