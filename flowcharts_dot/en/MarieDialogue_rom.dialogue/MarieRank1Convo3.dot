		221 -> 227;
	223 [label="You have been clever already to sniff out that Lyon holds a deep and painful burden in his heart. One that he feels he alone must carry.",shape=box,color=blue];
		223 -> 229;
	222 [label="Lyon holds a deep and painful burden in his heart. One that he feels he alone must carry.",shape=box,color=blue];
