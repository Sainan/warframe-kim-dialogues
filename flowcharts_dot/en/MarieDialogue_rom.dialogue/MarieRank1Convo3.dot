digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo3 begins." [color=orange];
		"MarieRank1Convo3 begins." -> j3472739767;
	j3472739767 [label="Il y a un crâne volant ! Keksekça ?! There is a flying talking skull and everyone is going on about their days as if nothing is happening and I need someone to acknowledge the strangeness of their whole existence.",shape=box,color=blue];
		j3472739767 -> j453260979;
		j3472739767 -> j2048476851;
		j3472739767 -> j242691715;
	j453260979 [label="That's just Necraloid. Well, a necraloid. It's complicated.",shape=box,color=red];
		j453260979 -> j1514611121;
	j2048476851 [label="That is Necraloid. He's a Cephalon, he won't hurt you.",shape=box,color=red];
		j2048476851 -> j105546188;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j1514611121 [label="Pardon, is it a name or an object ?",shape=box,color=blue];
		j1514611121 -> j3097464712;
		j1514611121 -> j2186118916;
	j105546188 [label="I do not think him a threat ! He does not frighten me.",shape=box,color=blue];
		j105546188 -> j3728967646;
	"Chat ends." [color=orange];
	j3097464712 [label="I... don't rightly know.",shape=box,color=red];
		j3097464712 -> j1729308897;
	j2186118916 [label="Yes.",shape=box,color=red];
		j2186118916 -> j1003099151;
	j3728967646 [label="Indeed, I find him perfectly charming, if a bit unyielding in conversation. Not wholly unlike his living inspiration. But given the nature of my favored traveling companion, you can tell that does not bother me overmuch.",shape=box,color=blue];
		j3728967646 -> j3436613977;
	j1729308897 [label="Firstly, of whose designs are these, \"Necraloids ?\" Of which they are a name and also, perhaps, a designation ?",shape=box,color=blue];
		j1729308897 -> j2466422486;
		j1729308897 -> j982449894;
	j1003099151 [label="I... do not understand. And how does Loid factor into this ?",shape=box,color=blue];
		j1003099151 -> j1729308897;
	j3436613977 [label="No, what you might find grotesque in his visage, I assure you, is not the issue I currently have at hand.",shape=box,color=blue];
		j3436613977 -> j4216699178;
		j3436613977 -> j3363043601;
	j2466422486 [label="Your Cardinal Dimanche. Entrati.",shape=box,color=red];
		j2466422486 -> j248951947;
	j982449894 [label="Entrati made that one. But the concept of what they are - Cephalons - was invented by the Orokin.",shape=box,color=red];
		j982449894 -> j248951947;
	j4216699178 [label="I'm surprised the skull isn't off-putting for you.",shape=box,color=red];
		j4216699178 -> j547699491;
	j3363043601 [label="I admit, taken out of context, he must be strange. But what in particular is upsetting?",shape=box,color=red];
		j3363043601 -> j695791392;
	j248951947 [label="Excusez-moi, do you mean to imply that le Cardinal made a replicant flying skull servant in the likeness of his own companion, and named them thusly ?",shape=box,color=blue];
		j248951947 -> j3579244146;
	j547699491 [label="You know little of me, which is no fault of yours. I have spent much of my life tending to the dead and the places that they repose. ",shape=box,color=blue];
		j547699491 -> j3843456867;
	j695791392 [label="I find myself curious as to why there is another face upon his back that resembles a child's scrawl.",shape=box,color=blue];
		j695791392 -> j2734695522;
	j3579244146 [label="Why are there not more of them, these necraloids, then ?",shape=box,color=blue];
		j3579244146 -> j1091092239;
		j3579244146 -> j1855046106;
		j3579244146 -> j1863317447;
	j3843456867 [label="Indeed I have spent much of my life with them as my boon companions. They are keen to listen to my troubles of the day.",shape=box,color=blue];
		j3843456867 -> j4063127048;
	j2734695522 [label="I inquired with Monsieur Necraloid and Monsieur Loid both, and neither wished to speak of it, they only told me a name. Otak. And it was with great sadness that they uttered it.",shape=box,color=blue];
		j2734695522 -> j623866689;
	j1091092239 [label="Maybe he realized how horrifying it is to make yourself a digital copy of your lover.",shape=box,color=red];
		j1091092239 -> j4204168779;
	j1855046106 [label="Maybe he only ever intended to make the one.",shape=box,color=red];
		j1855046106 -> j3778393972;
	j1863317447 [label="I'm not sure. Maybe he never got around to making more?",shape=box,color=red];
		j1863317447 -> j3374259856;
	j4063127048 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j4063127048 -> j2462045356;
		j4063127048 -> j1357088879;
	j623866689 [label="So here I am, speaking with you, in hopes you might be able to aid me.",shape=box,color=blue];
		j623866689 -> j3718481847;
		j623866689 -> j3137489120;
	j4204168779 [label="Ou bien, a tribute to his love and respect, that he did not think this strange laboratory could continue to function without Monsieur Loid.",shape=box,color=blue];
		j4204168779 -> j916385632;
		j4204168779 -> j2226496851;
	j3778393972 [label="+5 Chemistry",color=orange];
		j3778393972 -> j2641804306;
	j3374259856 [label="Imagine it, a school of flying skulls, all effortlessly and perfectly efficient !",shape=box,color=blue];
		j3374259856 -> j2226496851;
		j3374259856 -> j2735816310;
	j2462045356 [label="Did you like looking after graveyards?",shape=box,color=red];
		j2462045356 -> j1457784843;
	j1357088879 [label="Did they ever respond?",shape=box,color=red];
		j1357088879 -> j1600076105;
	j3718481847 [label="Do you want to know about Otak? Or why you can't talk to him?",shape=box,color=red];
		j3718481847 -> j1380820342;
	j3137489120 [label="Otak is hard to explain...",shape=box,color=red];
		j3137489120 -> j3287217001;
	j916385632 [label="I would say that it makes for a strange kind of romantic gesture, but I'm hardly one to talk.",shape=box,color=red];
		j916385632 -> j2433548487;
	j2226496851 [label="I wouldn't mind a necraloid buzzing around my place, honestly.",shape=box,color=red];
		j2226496851 -> j294851070;
	j2641804306 [label="Tragic and beautiful, in its way, non ? A tribute to his love and respect, that he did not think this strange laboratory could continue to function without Monsieur Loid.",shape=box,color=blue];
		j2641804306 -> j1373065656;
		j2641804306 -> j916385632;
	j2735816310 [label="I'm glad there's only one of him, honestly. I don't think the world would be ready for that.",shape=box,color=red];
		j2735816310 -> j1420384980;
	j1457784843 [label="And mausoleums and cryptes, oh yes. But I do admit I preferred the outdoor spaces, though they were challenging for my chair to navigate. No more so than stairs, I fear.",shape=box,color=blue];
		j1457784843 -> j2427967412;
	j1600076105 [label="Hah ! No, thankfully. Not until your \"Necraloid\" with such a morbid visage replied to me. If speaking to the dead is within the gifts of the Luminaries to bestow, it is not within my knowing.",shape=box,color=blue];
		j1600076105 -> j3417754328;
	j1380820342 [label="I believe I wish to know both, in time, but I will let you decide where to begin. I do not know which is more important, après tout.",shape=box,color=blue];
		j1380820342 -> j3287217001;
	j3287217001 [label="Check boolean LoidFamilyComplete",color=orange];
		j3287217001 -> j2573708091 [label=true,color=green];
		j3287217001 -> j2573708091 [label=false,color=brown];
		j3287217001 -> j2117405286 [label=false,color=brown];
	j2433548487 [label="And now I am intrigued, but that seems a story for another time. Cela dit...",shape=box,color=blue];
		j2433548487 -> j695791392;
	j294851070 [label="Then I have all certainty that you are likely beset by either a need for company or organization, or both. But that is a conversation for another time.",shape=box,color=blue];
		j294851070 -> j695791392;
	j1373065656 [label="I think it had more to do with ensuring this place didn't fall apart at the seams, than anything else.",shape=box,color=red];
		j1373065656 -> j576267845;
	j1420384980 [label="Indeed ! As am I. Which brings me to my next question.",shape=box,color=blue];
		j1420384980 -> j695791392;
	j2427967412 [label="Boolean MarieSerum1 is now true.",color=orange];
		j2427967412 -> j766360596;
		j2427967412 -> j1129673253;
	j3417754328 [label="No, hearing spirits and voices is much more within the purview of my dear Lyon than I. Though I wonder if Monsieur Necraloid is not haunted as well, judging by the child's scrawl upon the back of his head.",shape=box,color=blue];
		j3417754328 -> j813615097;
	j2573708091 [label="Otak used to be an Archimedean, an Orokin scientist and academic. What's happened to him isn't exactly the happiest story.",shape=box,color=red];
		j2573708091 -> j681615635;
	j2117405286 [label="Well... in short, some of Entrati's family is upstairs, and they aren't... exactly aware that we're down here.",shape=box,color=red];
		j2117405286 -> j2466793838;
	j576267845 [label="And you very well may be right. The flying amalgam seems to be missing much of the real Monsieur Loid's raison d'être and nuance. Cela dit...",shape=box,color=blue];
		j576267845 -> j695791392;
	j766360596 [label="I didn't know if it was appropriate to ask about whether or not your feet were changed by the serum...",shape=box,color=red];
		j766360596 -> j1137292593;
	j1129673253 [label="Your chair?",shape=box,color=red];
		j1129673253 -> j1183471322;
	j813615097 [label="That is actually why I came here to speak to you, if you do not mind.",shape=box,color=blue];
		j813615097 -> j2734695522;
	j681615635 [label="Boolean MarieOtak1 is now true.",color=orange];
		j681615635 -> j1249797575;
	j2466793838 [label="Boolean MarieFamily1 is now true.",color=orange];
		j2466793838 -> j3773465689;
	j1137292593 [label="+10 Chemistry",color=orange];
		j1137292593 -> j1275240273;
	j1183471322 [label="I do not know what you would name it ? Un fauteuil roulant, or... perhaps a term I deeply dislike, un fauteuil pour invalide.",shape=box,color=blue];
		j1183471322 -> j2029094060;
	j1249797575 [label="Par les Luminaires... please, go on.",shape=box,color=blue];
		j1249797575 -> j1601795073;
	j3773465689 [label="Par les Luminaires... You mean that we are all down here in secret ?! Is that why we are not allowed to leave this place ?! Mais pourquoi ?!",shape=box,color=blue];
		j3773465689 -> j139306309;
	j1275240273 [label="Oh ! Oh, you poor thing. Imagine you, sitting there, wondering if I had mes pieds taken from me by le Cardinal ! Non, non, non - nothing of the sort.",shape=box,color=blue];
		j1275240273 -> j3657036996;
	j2029094060 [label="Like what we perch in now, to sit at these little adorable devices to communicate. But with wheels upon the sides, to traverse. A chair with wheels, if you will.",shape=box,color=blue];
		j2029094060 -> j1855876278;
		j2029094060 -> j2055047610;
	j1601795073 [label="By all accounts he was a genius, and the mind behind the harnessing of argon crystals.",shape=box,color=red];
		j1601795073 -> j1884577198;
	j139306309 [label="His daughter, Euleria - known as Mother, and her family, have been taking care of Deimos this whole time.",shape=box,color=red];
		j139306309 -> j61250996;
	j3657036996 [label="Sol saw fit to place in my life the inconvenience of having been born with traditionally unwieldy feet. I could not walk. ",shape=box,color=blue];
		j3657036996 -> j2816015887;
	j1855876278 [label="You were an invalid before you became a protoframe?",shape=box,color=red];
		j1855876278 -> j2635877570;
	j2055047610 [label="We call them wheelchairs, believe it or not.",shape=box,color=red];
		j2055047610 -> j1139513595;
	j1884577198 [label="Which are harnessed from the Void - they're the reason we can create a lot of the powerful warframes and weapons we make.",shape=box,color=red];
		j1884577198 -> j3560032767;
	j61250996 [label="Watching over this place, and the heart that pumps Void energy into the Origin System, keeping all of us... usable, really, ever since Entrati left.",shape=box,color=red];
		j61250996 -> j3032412102;
	j2816015887 [label="But it was simply that, an inconvenience.",shape=box,color=blue];
		j2816015887 -> j3813060886;
	j2635877570 [label="Non. I very much was not.",shape=box,color=blue];
		j2635877570 -> j3350176257;
	j1139513595 [label="Hah ! Oh, how I am sitting here laughing at myself for being the fool. Yes, I suppose you would call them wheelchairs, as they are chairs with wheels. Silly me.",shape=box,color=blue];
		j1139513595 -> j3813060886;
	j3560032767 [label="He specialized in crystallography. And his works were archived here, in the laboratories.",shape=box,color=red];
		j3560032767 -> j1119768546;
	j3032412102 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3032412102 -> j1708019399 [label=true,color=green];
		j3032412102 -> j2362593335 [label=false,color=brown];
	j3813060886 [label="Though, I do not miss having to push myself about. Nor does Lyon, I imagine. What freedom it is to fly !",shape=box,color=blue];
		j3813060886 -> j3945513838;
		j3813060886 -> j856576096;
		j3813060886 -> j3969338082;
	j3350176257 [label="Boolean MarieInvalid is now true.",color=orange];
		j3350176257 -> "Chat ends.";
	j1119768546 [label="For some reason, I don't know why, he was turned into a Cephalon, and given his own necraloid shell.",shape=box,color=red];
		j1119768546 -> j2046849009;
	j1708019399 [label="She's come to terms with his absence, and they've made peace with each other, but it was a hard-won thing.",shape=box,color=red];
		j1708019399 -> j4141801606;
	j2362593335 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j2362593335 -> j1708019399 [label=true,color=green];
		j2362593335 -> j320669504 [label=false,color=brown];
	j3945513838 [label="I try to think of disabilities as things that change us. They limit us in some ways, yes, but they can give us strengths that others don't have.",shape=box,color=red];
		j3945513838 -> j1640296011;
	j856576096 [label="You never thought of your condition as a problem?",shape=box,color=red];
		j856576096 -> j2839086474;
	j3969338082 [label="Did you know the protoframe serum would do this to you?",shape=box,color=red];
		j3969338082 -> j2406915448;
	j2046849009 [label="Not all Cephalons were made as a punishment. But things went... poorly here on Deimos, and he was badly damaged.",shape=box,color=red];
		j2046849009 -> j2611416834;
	j4141801606 [label="Knowing that he's still out there, running amok, and that he hasn't said a word to her, or even sent a letter...?",shape=box,color=red];
		j4141801606 -> j282741540;
	j320669504 [label="She hasn't come to terms with his absence, and they're at each other's throats.",shape=box,color=red];
		j320669504 -> j1584553328;
	j1640296011 [label="+5 Chemistry",color=orange];
		j1640296011 -> j3708535526;
	j2839086474 [label="I never saw the point in bemoaning it. I certainly relish the ability to fetch objects from high shelves without aid, I will tell you that.",shape=box,color=blue];
		j2839086474 -> j416752662;
	j2406915448 [label="Oui, le Cardinal told Lyon and I all that would come of taking the sérums that changed our forms. We knew what it would do.",shape=box,color=blue];
		j2406915448 -> j3879875290;
	j2611416834 [label="+5 Chemistry",color=orange];
		j2611416834 -> j3798614590;
	j282741540 [label="I can't imagine how painful that would be for her. For them.",shape=box,color=red];
		j282741540 -> j1940583158;
	j1584553328 [label="Knowing that he's still out there, running amok, and that he hasn't said a word to her, or even sent a letter...?",shape=box,color=red];
		j1584553328 -> j3749549173;
	j3708535526 [label="Boolean MarieSecretPower is now true.",color=orange];
		j3708535526 -> j3843907754;
	j416752662 [label="Ce qui est fait est fait. I could not pray to Sol for a miracle, when so many were hurting more around me, when so many were of greater need. The Luminaries had already given me so much.",shape=box,color=blue];
		j416752662 -> j447098606;
	j3879875290 [label="But like all things, I took mine in joy, and Lyon took his... oh, I fear as if I am telling on him and I should not.",shape=box,color=blue];
		j3879875290 -> j1864515055;
		j3879875290 -> j55150927;
	j3798614590 [label="Pauvre petit...",shape=box,color=blue];
		j3798614590 -> j4163710607;
	j1940583158 [label="While I can see the logic behind the decision to protect them from the pain le Cardinal has caused by his necessary departure...",shape=box,color=blue];
		j1940583158 -> j411513092;
	j3749549173 [label="It would destroy what little chance of reconciliation they might have.",shape=box,color=red];
		j3749549173 -> j2802334988;
	j3843907754 [label="Oui ! You understand. I knew the world from another point of view. My arms were stronger. I am more patient. I know what it means to enjoy the moment.",shape=box,color=blue];
		j3843907754 -> j3725751063;
	j447098606 [label="I must go. Thank you for this wonderful diversion. ",shape=box,color=blue];
		j447098606 -> "Chat ends.";
	j1864515055 [label="It's all right. Don't tell me anything more than you're comfortable with.",shape=box,color=red];
		j1864515055 -> j3583117186;
	j55150927 [label="Please, keep going. I'm having a hard time getting through to him.",shape=box,color=red];
		j55150927 -> j1439324624;
	j4163710607 [label="So, he was transferred to the main necraloid - the only Necraloid that remains - and is... well? It's hard to explain.",shape=box,color=red];
		j4163710607 -> j3844835639;
		j4163710607 -> j4097928282;
		j4163710607 -> j2450181658;
	j411513092 [label="I do think it needlessly cruel, don't you ? They might think him dead. Or worse ! And we, living here, comme des rats d'égout ?",shape=box,color=blue];
		j411513092 -> j2103093387;
		j411513092 -> j872679365;
		j411513092 -> j2083848355;
	j2802334988 [label="+10 Chemistry",color=orange];
		j2802334988 -> j3400945841;
	j3725751063 [label="When I reach my destination, I bask in the elegance of it. I do not scurry about like a beetle with a billion little legs.",shape=box,color=blue];
		j3725751063 -> j1158479167;
	j3583117186 [label="+5 Chemistry",color=orange];
		j3583117186 -> j4287022074;
	j1439324624 [label="+5 Chemistry",color=orange];
		j1439324624 -> j2297188772;
	j3844835639 [label="I just wish we could fix him, honestly. Bring back the real Otak.",shape=box,color=red];
		j3844835639 -> j1303866413;
	j4097928282 [label="He makes me smile. He's funny, but it hides something tragic and broken.",shape=box,color=red];
		j4097928282 -> j1822077294;
	j2450181658 [label="Sadly, he's not fixable. And I think he grates on a lot of nerves. ",shape=box,color=red];
		j2450181658 -> j466123574;
	j2103093387 [label="You're right. I wish there was something we could do.",shape=box,color=red];
		j2103093387 -> j107713462;
	j872679365 [label="It's not really my decision to make.",shape=box,color=red];
		j872679365 -> j2011238501;
	j2083848355 [label="I actually have a friend who loves rats. I think they're adorable.",shape=box,color=red];
		j2083848355 -> j2072653542;
	j3400945841 [label="Oui... I see the logic. I would work to mend their family, if you can, then, non ? It seems to be the only hope any of us have to get out of this place. ",shape=box,color=blue];
		j3400945841 -> j3981678617;
	j1158479167 [label="I simply wish my dear Lyon could see the world in such a way as you. That all inconveniences may be a secret power, as you say.",shape=box,color=blue];
		j1158479167 -> j135398195;
	j4287022074 [label="I appreciate your kindness, Drifter. I will simply leave it at this, as to not overstep any imposition I may be placing upon you - ",shape=box,color=blue];
		j4287022074 -> j1274520092;
	j2297188772 [label="You are not alone in that, Drifter. Lyon is like family to me, and still sometimes I wonder if I know him any more than the statues of saints in the cathedral.",shape=box,color=blue];
		j2297188772 -> j873274315;
	j1303866413 [label="+15 Chemistry",color=orange];
		j1303866413 -> j2744978285;
	j1822077294 [label="+15 Chemistry",color=orange];
		j1822077294 -> j2046025044;
	j466123574 [label="+15 Chemistry",color=orange];
		j466123574 -> j315722524;
	j107713462 [label="Add 1 to Family counter",color=orange];
		j107713462 -> j3751589455;
	j2011238501 [label="I know. It is Monsieur Loid's, and everyone else's decision, to make themselves known.",shape=box,color=blue];
		j2011238501 -> j4261536068;
	j2072653542 [label="+10 Chemistry",color=orange];
		j2072653542 -> j550015347;
	j3981678617 [label="Lest we spend the rest of our lives trapped living here, comme des rats d'égout. ",shape=box,color=blue];
		j3981678617 -> j4018475200;
		j3981678617 -> j2934729504;
	j135398195 [label="Oh, I fear as if I am telling on him and I should not.",shape=box,color=blue];
		j135398195 -> j1864515055;
		j135398195 -> j55150927;
	j1274520092 [label="- Lyon paints the world in a crimson brush, whatever his outward demeanor may seem to belie. I am sorry he still does not speak to you. I am urging him to do so...",shape=box,color=blue];
		j1274520092 -> j1402156127;
	j873274315 [label="Check boolean MarieLyonSuffering1",color=orange];
		j873274315 -> j2546431673 [label=true,color=green];
		j873274315 -> j4286777302 [label=false,color=brown];
	j2744978285 [label="I know the compulsion you feel. Thank you, you have given me much to think on.",shape=box,color=blue];
		j2744978285 -> j1123121321;
	j2046025044 [label="I know how you feel. Thank you, you have given me much to think on.",shape=box,color=blue];
		j2046025044 -> j1123121321;
	j315722524 [label="Yes, I... know of a similar situation. Thank you, you have given me much to think on.",shape=box,color=blue];
		j315722524 -> j1123121321;
	j3751589455 [label="+15 Chemistry",color=orange];
		j3751589455 -> j2046947882;
	j4261536068 [label="I would suggest that it is a sense of guilt, not nobility, that keeps us down here.",shape=box,color=blue];
		j4261536068 -> j973000694;
	j550015347 [label="And I would love to meet them some day, but that is hardly the point I am making, silly wolf.",shape=box,color=blue];
		j550015347 -> j4261536068;
	j4018475200 [label="I've been remiss. You're right. I'll get to work.",shape=box,color=red];
		j4018475200 -> j1748716494;
	j2934729504 [label="I actually have a friend who loves rats. I think they're adorable. ",shape=box,color=red];
		j2934729504 -> j3487276276;
