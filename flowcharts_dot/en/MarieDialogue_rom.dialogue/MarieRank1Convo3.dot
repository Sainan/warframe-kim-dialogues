		220 -> 226;
	216 [label="Perhaps there is ! I would not give up hope. We must understand the root illness, if we are to treat it, non ?",shape=box,color=blue];
		216 -> 206;
	217 [label="That we hide some great and terrible sin.",shape=box,color=blue];
		217 -> 224;
