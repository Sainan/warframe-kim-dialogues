		3652 -> 3661 [label=false,color=brown];
	3647 [label="Then I will support your choice, as well.",shape=box,color=blue];
		3647 -> 3653;
	3657 [label="I will speak to Lyon in the meanwhile, but my hopes are exceedingly low.",shape=box,color=blue];
		3657 -> 3666;
	3656 [label="+20 Chemistry",color=orange];
		3656 -> 3665;
	3654 [label="At least he'll help, though. And I'll make sure he doesn't actually follow through with his threats.",shape=box,color=red];
		3654 -> 3663;
	3655 [label="I think it's just the excuse he's making to cover for it.",shape=box,color=red];
		3655 -> 3664;
	3659 [label="Oui, I do. But I think you have a special way of convincing him, where all others have failed, non ?",shape=box,color=blue];
		3659 -> 3669;
		3659 -> 3670;
	3658 [label="Oui, certainly I do. That devil can be obstinate at the best of times. Sometimes, I think he just enjoys being contrary !",shape=box,color=blue];
		3658 -> 3667;
		3658 -> 3668;
	3660 [label="I think you have a special way of convincing him, where all others have failed, non ?",shape=box,color=blue];
		3660 -> 3669;
		3660 -> 3670;
	3661 [label="I wish you the best of luck. That devil can be obstinate at the best of times. Sometimes, I think he just enjoys being contrary !",shape=box,color=blue];
		3661 -> 3667;
		3661 -> 3668;
	3653 [label="Update boolean MarieFamilyFail",color=orange];
		3653 -> 3662;
	3666 [label="+20 Chemistry",color=orange];
		3666 -> 3674;
	3665 [label="I have deeply misjudged this devil of ours...",shape=box,color=blue];
		3665 -> 3673;
	3663 [label="Oui. At least you are around to ensure we keep him from following through on his... baser instincts.",shape=box,color=blue];
		3663 -> 3672;
	3664 [label="Oui, I hope you are correct.",shape=box,color=blue];
		3664 -> 3672;
	3669 [label="I wouldn't want to use my relationship with him as a negotiation tool.",shape=box,color=red];
		3669 -> 3677;
	3670 [label="What're you insinuating, Marie?",shape=box,color=red];
		3670 -> 3678;
	3667 [label="I actually kind of enjoy it, as weird as it sounds. We get along.",shape=box,color=red];
		3667 -> 3675;
	3668 [label="He can be, but I think a lot of that is just for show.",shape=box,color=red];
		3668 -> 3676;
	3662 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3662 -> 3671;
	3674 [label="The devil is fickle ! C'est la vie, as they say !",shape=box,color=blue];
		3674 -> 3682;
	3673 [label="And I am not a fool to not see the part you played in ensuring this all came to pass !",shape=box,color=blue];
		3673 -> 3681;
	3672 [label="Check boolean MarieDating",color=orange];
		3672 -> 3680 [label=true,color=green];
		3672 -> 3679 [label=false,color=brown];
	3677 [label="Oh ! That is not what I was implying, pardonne-moi ! Simply that he seems to favor you, so you may have his ear where all others he may ignore.",shape=box,color=blue];
		3677 -> 3684;
	3678 [label="+5 Chemistry",color=orange];
		3678 -> 3685;
	3675 [label="Oui, he certainly does seem to favor you. Perhaps it is because you share a time and a place, where we do not ? Why else would he ?",shape=box,color=blue];
		3675 -> 3683;
	3676 [label="Oui ? What do you mean ?",shape=box,color=blue];
		3676 -> 3683;
