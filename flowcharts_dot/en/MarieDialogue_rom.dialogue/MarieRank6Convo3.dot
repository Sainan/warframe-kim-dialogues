		j506145398 -> "Chat ends." [label="false",color=purple];
	j148501058 [label="Evaluate expressions",color=orange];
		j148501058 -> j2321113540 [label="MarieFamily3a",color=purple];
		j148501058 -> j1907598485 [label="MarieFamily3a",color=purple];
		j148501058 -> j753611210 [label="MarieFamily3b",color=purple];
		j148501058 -> j2293866203 [label="MarieFamily3b",color=purple];
		j148501058 -> j2321113540 [label="MarieFamilyOther",color=purple];
		j148501058 -> j1907598485 [label="MarieFamilyOther",color=purple];
		j148501058 -> j3195965363 [label="false",color=purple];
	j2321113540 [label="I've been thinking about how to convince Loid to go up those stairs to finally talk to the family, and... I have an idea, but I don't think you'll like it.",shape=box,color=red];
		j2321113540 -> j3431982611;
	j1907598485 [label="Have you thought anymore about how to convince Loid to talk to the Entrati family upstairs?",shape=box,color=red];
		j1907598485 -> j2607534784;
	j753611210 [label="On the subject of trying to get Loid and the Entrati family talking, I was... wondering if you've reconsidered Roathe's involvement at all?",shape=box,color=red];
		j753611210 -> j1903226774;
	j2293866203 [label="Marie, are you still on board to... maybe try to convince Loid to talk to the \"upstairs neighbors?\" I know we left that off on a weird note.",shape=box,color=red];
		j2293866203 -> j1903226774;
	j3195965363 [label="I have been thinking of how Monsieur Loid is so frightened of speaking to le Cardinal's family.",shape=box,color=blue];
		j3195965363 -> j1051727586;
	j3431982611 [label="Check boolean MarieDating",color=orange];
		j3431982611 -> j534649692 [label=true,color=green];
		j3431982611 -> j3760531877 [label=false,color=brown];
	j2607534784 [label="Check boolean MarieDating",color=orange];
		j2607534784 -> j2784395847 [label=true,color=green];
		j2607534784 -> j2784395847 [label=false,color=brown];
	j1903226774 [label="Check boolean MarieDating",color=orange];
		j1903226774 -> j2371820559 [label=true,color=green];
		j1903226774 -> j2133849035 [label=false,color=brown];
	j1051727586 [label="And how we must break this impasse. This purgatoire in which we are trapped should not stand. It seems so needlessly painful.",shape=box,color=blue];
		j1051727586 -> j4294470168;
	j534649692 [label="Bonjour, mon cœur ! And what are you afraid I will not like ?",shape=box,color=blue];
		j534649692 -> j2108039726;
	j3760531877 [label="Bonjour ! Oh ? And what are you afraid I will not like ?",shape=box,color=blue];
		j3760531877 -> j2108039726;
	j2784395847 [label="Bonjour mon cœur ! I have given it some thought, oui... and I am truly loath to admit it. It gives me no pleasure to say this.",shape=box,color=blue];
		j2784395847 -> j3047415045;
	j2371820559 [label="Bonjour, bonjour, mon cœur ! I have given it some thought, oui... and I am truly loath to admit it. It gives me no pleasure to say this.",shape=box,color=blue];
		j2371820559 -> j228742710;
	j2133849035 [label="Bonjour - I have given it some thought, oui... and I am truly loath to admit it. It gives me no pleasure to say this.",shape=box,color=blue];
		j2133849035 -> j228742710;
	j4294470168 [label="But I feel as though we need... a bastion of some kind, non ? Do you have any ideas ?",shape=box,color=blue];
		j4294470168 -> j3998677600;
		j4294470168 -> j2108039726;
	j2108039726 [label="I think we might need Roathe's help to convince Loid to talk to the Entrati family. I don't think he'll do it otherwise. Without assurances that the family, and he, will be protected.",shape=box,color=red];
		j2108039726 -> j1138601703;
	j3047415045 [label="But I think... I think - ah, Sol forgive me - that the devil's assistance may be required. I do not think Monsieur Loid will listen to us otherwise.",shape=box,color=blue];
		j3047415045 -> j1438105570;
	j228742710 [label="I believe you may be right. The devil may be the missing piece we need. Ah, it pains me even to type the words ! ",shape=box,color=blue];
		j228742710 -> j636489540;
	j3998677600 [label="I don't really have any good ideas that doesn't involve taking help from terrible sources. Sources that might just get us into deep trouble later. Namely, Roathe.",shape=box,color=red];
		j3998677600 -> j3631104066;
	j1138601703 [label="I... hate to admit it, but I think you may be right... Sol forgive me.",shape=box,color=blue];
		j1138601703 -> j636489540;
	j1438105570 [label="The devil is powerful, and provides certain promises of strength should things go wrong, non ?",shape=box,color=blue];
		j1438105570 -> j90779732;
		j1438105570 -> j2760637386;
	j636489540 [label="Evaluate expressions",color=orange];
		j636489540 -> j3157697569 [label="RoatheFamilyFail",color=purple];
		j636489540 -> j1673811520 [label="RoatheRedeemed & RoatheFamilyDelay
",color=purple];
		j636489540 -> j1673811520 [label="RoatheRedeemed & RoatheFamilySuccess
",color=purple];
		j636489540 -> j2413529707 [label="RoatheVillain & RoatheFamilyDelay
",color=purple];
		j636489540 -> j2413529707 [label="RoatheVillain & RoatheFamilySuccess",color=purple];
		j636489540 -> j1360103513 [label="false",color=purple];
	j3631104066 [label="Are you so sure ? If I can set aside my différences with the devil, certainly so can you, non ?",shape=box,color=blue];
		j3631104066 -> j527458522;
		j3631104066 -> j1261551512;
	j90779732 [label="No, there has to be another way. I refuse to ask for his help on this.",shape=box,color=red];
		j90779732 -> j3631104066;
	j2760637386 [label="You're right. I didn't think you'd agree to it. I was afraid to ask.",shape=box,color=red];
		j2760637386 -> j636489540;
	j3157697569 [label="Will he give us his aid in this regard ?",shape=box,color=blue];
		j3157697569 -> j3769092663;
	j1673811520 [label="Will he give us his aid in this regard ?",shape=box,color=blue];
		j1673811520 -> j3709020051;
	j2413529707 [label="Will he give us his aid in this regard ?",shape=box,color=blue];
		j2413529707 -> j1784686791;
	j1360103513 [label="Do you think you can convince him to help us, though ?",shape=box,color=blue];
		j1360103513 -> j2983543606;
		j1360103513 -> j4243247975;
	j527458522 [label="No, I'm sorry. ",shape=box,color=red];
		j527458522 -> j1505693693;
	j1261551512 [label="All right. If you're okay with it, I'll be okay with it.",shape=box,color=red];
		j1261551512 -> j1320836340;
	j3769092663 [label="No, unfortunately... I think that was a dead end with him. Do you think there's another way?",shape=box,color=red];
		j3769092663 -> j1939224710;
	j3709020051 [label="He will. I've convinced him to help reunite them - and you won't believe this - I think it's so that he can help protect Entrati's family. They're all that really remains of the Orokin, after all.",shape=box,color=red];
		j3709020051 -> j3637109604;
	j1784686791 [label="He will. I've convinced him to help reunite them - and you won't be surprised by this - I think it's mostly to spite Albrecht in his absence.",shape=box,color=red];
		j1784686791 -> j3624817470;
	j2983543606 [label="Nothing is settled yet. He's... well, you know how he can be.",shape=box,color=red];
		j2983543606 -> j2913252443;
	j4243247975 [label="I'm still working on it, but I think so.",shape=box,color=red];
		j4243247975 -> j1104176810;
	j1505693693 [label="+20 Chemistry",color=orange];
		j1505693693 -> j3033577955;
	j1320836340 [label="Oui, I do not have to enjoy it, but it is un médicament we must swallow, I suppose.",shape=box,color=blue];
		j1320836340 -> j636489540;
	j1939224710 [label="Oh ! That is... unfortunate. I do not know ? I do not think so... Can you think of another approach with the devil ? Or a way to try again ?",shape=box,color=blue];
		j1939224710 -> j1047121376;
	j3637109604 [label="He is helping to protect the family of the man who turned him into protoframe against his will, and cast him into the past, robbing him of his memories...",shape=box,color=blue];
		j3637109604 -> j3607794091;
	j3624817470 [label="You are right, I am... not surprised.",shape=box,color=blue];
		j3624817470 -> j1184862139;
		j3624817470 -> j870849123;
	j2913252443 [label="Check boolean RoatheDating",color=orange];
		j2913252443 -> j2605065851 [label=true,color=green];
		j2913252443 -> j249759519 [label=false,color=brown];
	j1104176810 [label="Check boolean RoatheDating",color=orange];
		j1104176810 -> j1108109332 [label=true,color=green];
		j1104176810 -> j1180924055 [label=false,color=brown];
	j3033577955 [label="Then I will support your choice, as well.",shape=box,color=blue];
		j3033577955 -> j1179567760;
	j1047121376 [label="I will speak to Lyon in the meanwhile, but my hopes are exceedingly low.",shape=box,color=blue];
		j1047121376 -> j3448750414;
	j3607794091 [label="+20 Chemistry",color=orange];
		j3607794091 -> j1269611113;
	j1184862139 [label="At least he'll help, though. And I'll make sure he doesn't actually follow through with his threats.",shape=box,color=red];
		j1184862139 -> j3352304792;
	j870849123 [label="I think it's just the excuse he's making to cover for it.",shape=box,color=red];
		j870849123 -> j3874679625;
	j2605065851 [label="Oui, I do. But I think you have a special way of convincing him, where all others have failed, non ?",shape=box,color=blue];
		j2605065851 -> j3314364965;
		j2605065851 -> j3978629612;
	j249759519 [label="Oui, certainly I do. That devil can be obstinate at the best of times. Sometimes, I think he just enjoys being contrary !",shape=box,color=blue];
		j249759519 -> j1370401888;
		j249759519 -> j2928047012;
	j1108109332 [label="I think you have a special way of convincing him, where all others have failed, non ?",shape=box,color=blue];
		j1108109332 -> j3314364965;
		j1108109332 -> j3978629612;
	j1180924055 [label="I wish you the best of luck. That devil can be obstinate at the best of times. Sometimes, I think he just enjoys being contrary !",shape=box,color=blue];
		j1180924055 -> j1370401888;
		j1180924055 -> j2928047012;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j3448750414 [label="+20 Chemistry",color=orange];
		j3448750414 -> j979139064;
	j1269611113 [label="I have deeply misjudged this devil of ours...",shape=box,color=blue];
		j1269611113 -> j3504791922;
	j3352304792 [label="Oui. At least you are around to ensure we keep him from following through on his... baser instincts.",shape=box,color=blue];
		j3352304792 -> j2198758823;
	j3874679625 [label="Oui, I hope you are correct.",shape=box,color=blue];
		j3874679625 -> j2198758823;
	j3314364965 [label="I wouldn't want to use my relationship with him as a negotiation tool.",shape=box,color=red];
		j3314364965 -> j3047619945;
	j3978629612 [label="What're you insinuating, Marie?",shape=box,color=red];
		j3978629612 -> j1745569913;
	j1370401888 [label="I actually kind of enjoy it, as weird as it sounds. We get along.",shape=box,color=red];
		j1370401888 -> j3139285886;
	j2928047012 [label="He can be, but I think a lot of that is just for show.",shape=box,color=red];
		j2928047012 -> j3424505322;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j979139064 [label="The devil is fickle ! C'est la vie, as they say !",shape=box,color=blue];
		j979139064 -> j3569999725;
	j3504791922 [label="And I am not a fool to not see the part you played in ensuring this all came to pass !",shape=box,color=blue];
		j3504791922 -> j3242583483;
	j2198758823 [label="Check boolean MarieDating",color=orange];
		j2198758823 -> j2884175498 [label=true,color=green];
		j2198758823 -> j2074343049 [label=false,color=brown];
	j3047619945 [label="Oh ! That is not what I was implying, pardonne-moi ! Simply that he seems to favor you, so you may have his ear where all others he may ignore.",shape=box,color=blue];
		j3047619945 -> j1111614162;
	j1745569913 [label="+5 Chemistry",color=orange];
		j1745569913 -> j452607687;
	j3139285886 [label="Oui, he certainly does seem to favor you. Perhaps it is because you share a time and a place, where we do not ? Why else would he ?",shape=box,color=blue];
		j3139285886 -> j3822691405;
	j3424505322 [label="Oui ? What do you mean ?",shape=box,color=blue];
		j3424505322 -> j3822691405;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j3242583483 [label="Check boolean MarieDating",color=orange];
		j3242583483 -> j4197101726 [label=true,color=green];
		j3242583483 -> j3750573947 [label=false,color=brown];
	j2884175498 [label="+10 Chemistry",color=orange];
		j2884175498 -> j3208239704;
	j2074343049 [label="+10 Chemistry",color=orange];
		j2074343049 -> j549463413;
	j1111614162 [label="+5 Chemistry",color=orange];
		j1111614162 -> j4253451246;
	j452607687 [label="I certainly have no idea what you mean ! I am not insinuating anything at all. I am a purely une innocente Sœur de Sol.",shape=box,color=blue];
		j452607687 -> j3872501145;
	j3822691405 [label="Evaluate expressions",color=orange];
		j3822691405 -> j2728143957 [label="RoatheVillain",color=purple];
		j3822691405 -> j1093291024 [label="RoatheRedeemed",color=purple];
		j3822691405 -> j1866740138 [label="RoatheUnloved3",color=purple];
		j3822691405 -> j1960076355 [label="RoatheTraitor2",color=purple];
		j3822691405 -> j3372645068 [label="RoatheExecutor2",color=purple];
		j3822691405 -> j2741957359 [label="false",color=purple];
	j4197101726 [label="Merci, merci, merci, mon cœur !",shape=box,color=blue];
		j4197101726 -> j171133207;
	j3750573947 [label="Merci, merci, merci !",shape=box,color=blue];
		j3750573947 -> j171133207;
	j3208239704 [label="Well ! When the time comes, I will be ready and waiting ! Until then, merci, mon cœur.",shape=box,color=blue];
		j3208239704 -> j3569999725;
	j549463413 [label="Well ! When the time comes, I will be ready and waiting ! Until then, merci.",shape=box,color=blue];
		j549463413 -> j3569999725;
	j4253451246 [label="I am simply happy that you are happy. And if the devil has somewhere to spend his... efforts... all the better, non ?",shape=box,color=blue];
		j4253451246 -> j2404116705;
	j3872501145 [label="I would never imply that since the devil seems to favor you, perhaps he will listen to you where all others he seems to ignore.",shape=box,color=blue];
		j3872501145 -> j596531857;
	j2728143957 [label="Everyone in his life has tried to make him out to be some kind of monster. I suppose I'm the first person who hasn't.",shape=box,color=red];
		j2728143957 -> j2725359830;
	j1093291024 [label="There's a lot about him that he just doesn't know how to show. It's not armor, per se - but he doesn't trust people not to hurt him.",shape=box,color=red];
		j1093291024 -> j1511043375;
	j1866740138 [label="He's... had some real heartbreak in his many years. It's scabbed over with thorns, that's all.",shape=box,color=red];
		j1866740138 -> j2462674369;
	j1960076355 [label="I guess I can understand the amount of years he's lived. I've seen the same amount of death he has.",shape=box,color=red];
		j1960076355 -> j4225435628;
	j3372645068 [label="He's only ever tried to do what was right. Maybe in the wrong way, sure - but he was trying to save the Origin System from the Orokin.",shape=box,color=red];
		j3372645068 -> j2387677789;
	j2741957359 [label="I enjoy his wry sense of humor. He's clever, when you get past his ego.",shape=box,color=red];
		j2741957359 -> j1486861936;
	j171133207 [label="Well ! When the time comes, I will be ready and waiting ! Until then !",shape=box,color=blue];
		j171133207 -> j3569999725;
	j2404116705 [label="Even more so for us all if you serve as a bit of un ange upon his shoulder to temper him.",shape=box,color=blue];
		j2404116705 -> j653882434;
		j2404116705 -> j1947883996;
	j596531857 [label="And never during private moments. Non. Jamais.",shape=box,color=blue];
		j596531857 -> j2276285785;
		j596531857 -> j671796842;
	j2725359830 [label="And I suppose I am atop that list of late, non ? I suppose I should... consider his reasons, for why he is the way he is. Condemnation saves no souls.",shape=box,color=blue];
		j2725359830 -> j1097453354;
	j1511043375 [label="There is always a pain we hide from those around us. Something we seek to shelter, for fear others will wield it. I suppose I should strive to be kinder to him, if what you say is true.",shape=box,color=blue];
		j1511043375 -> j1097453354;
	j2462674369 [label="I cannot imagine the amount of love and loss one must suffer in all those years. It seems so unreal, even given all that I have seen.",shape=box,color=blue];
		j2462674369 -> j4126079853;
	j4225435628 [label="Sometimes I forget, when I speak to him, how many centuries he has lived. It seems so unreal, even given all that I have seen.",shape=box,color=blue];
		j4225435628 -> j2436376889;
	j2387677789 [label="There are always... nuances, oui ? Always reasons for acting one way or another. I suppose I should strive to be kinder to him, if what you say is true.",shape=box,color=blue];
		j2387677789 -> j1097453354;
	j1486861936 [label="No one has ever denied the devil his wit.",shape=box,color=blue];
		j1486861936 -> j3954330825;
	j653882434 [label="Who says I'm trying to temper him?",shape=box,color=red];
		j653882434 -> j1632492114;
	j1947883996 [label="I can't make any promises.",shape=box,color=red];
		j1947883996 -> j1001129056;
	j2276285785 [label="I never knew you had this side to you.",shape=box,color=red];
		j2276285785 -> j1111614162;
	j671796842 [label="You surprise me. I'm impressed. ",shape=box,color=red];
		j671796842 -> j1111614162;
	j1097453354 [label="+10 Chemistry",color=orange];
		j1097453354 -> j1880743110;
	j4126079853 [label="Oui, what damage could that cause a soul ? I see why you would wish to find another who understood. And he, you.",shape=box,color=blue];
		j4126079853 -> j1097453354;
	j2436376889 [label="To have lived so long, to have seen so much death - to have paid so much of it yourself ?",shape=box,color=blue];
		j2436376889 -> j4126079853;
	j3954330825 [label="+5 Chemistry",color=orange];
		j3954330825 -> j1880743110;
	j1632492114 [label="Add -1 to Thermostat counter",color=orange];
		j1632492114 -> j499605529;
	j1001129056 [label="Add 1 to Thermostat counter",color=orange];
		j1001129056 -> j2945128303;
	j1880743110 [label="I am simply glad the devil has someone to speak with who might seek to temper him. Un ange upon his shoulder.",shape=box,color=blue];
		j1880743110 -> j653882434;
		j1880743110 -> j1947883996;
	j499605529 [label="+10 Chemistry",color=orange];
		j499605529 -> j1524002402;
	j2945128303 [label="+10 Chemistry",color=orange];
		j2945128303 -> j2617418891;
	j1524002402 [label="Perhaps you are right... what is un ange without son diable ? He reminds us all of what we should strive to avoid.",shape=box,color=blue];
		j1524002402 -> j104956296;
	j2617418891 [label="Oui, I fear there is a wickedness in him that cannot truly be cured. He enjoys it too much.",shape=box,color=blue];
		j2617418891 -> j104956296;
	j104956296 [label="Well ! If and when you convince the devil to aid us in our mission, I will be ready and waiting ! Until then !",shape=box,color=blue];
		j104956296 -> j3569999725;
}