",color=purple];
		3631 -> 3636 [label="RoatheVillain, RoatheFamilyDelay
",color=purple];
		3631 -> 3636 [label="RoatheVillain, RoatheFamilySuccess",color=purple];
		3631 -> 3639 [label="false",color=purple];
	3628 [label="Are you so sure ? If I can set aside my différences with the devil, certainly so can you, non ?",shape=box,color=blue];
		3628 -> 3632;
		3628 -> 3633;
	3634 [label="No, there has to be another way. I refuse to ask for his help on this.",shape=box,color=red];
		3634 -> 3628;
	3635 [label="You're right. I didn't think you'd agree to it. I was afraid to ask.",shape=box,color=red];
		3635 -> 3631;
	3638 [label="/Lotus/Language/1999Texting/MarieRomance/Marie_MarieRank6Convo3_3118 begins.",shape=box,color=blue];
		3638 -> 3644;
	3637 [label="Will he give us his aid in this regard ?",shape=box,color=blue];
		3637 -> 3643;
	3636 [label="Will he give us his aid in this regard ?",shape=box,color=blue];
		3636 -> 3642;
	3639 [label="Do you think you can convince him to help us, though ?",shape=box,color=blue];
		3639 -> 3645;
		3639 -> 3646;
	3632 [label="No, I'm sorry. ",shape=box,color=red];
		3632 -> 3640;
	3633 [label="All right. If you're okay with it, I'll be okay with it.",shape=box,color=red];
		3633 -> 3641;
	3644 [label="No, unfortunately... I think that was a dead end with him. Do you think there's another way?",shape=box,color=red];
		3644 -> 3650;
	3643 [label="He will. I've convinced him to help reunite them - and you won't believe this - I think it's so that he can help protect Entrati's family. They're all that really remains of the Orokin, after all.",shape=box,color=red];
		3643 -> 3649;
	3642 [label="He will. I've convinced him to help reunite them - and you won't be surprised by this - I think it's mostly to spite Albrecht in his absence.",shape=box,color=red];
		3642 -> 3648;
	3645 [label="Nothing is settled yet. He's... well, you know how he can be.",shape=box,color=red];
		3645 -> 3651;
	3646 [label="I'm still working on it, but I think so.",shape=box,color=red];
		3646 -> 3652;
	3640 [label="+20 Chemistry",color=orange];
		3640 -> 3647;
	3641 [label="Oui, I do not have to enjoy it, but it is un médicament we must swallow, I suppose.",shape=box,color=blue];
		3641 -> 3631;
	3650 [label="Oh ! That is... unfortunate. I do not know ? I do not think so... Can you think of another approach with the devil ? Or a way to try again ?",shape=box,color=blue];
		3650 -> 3657;
	3649 [label="He is helping to protect the family of the man who turned him into protoframe against his will, and cast him into the past, robbing him of his memories...",shape=box,color=blue];
		3649 -> 3656;
	3648 [label="You are right, I am... not surprised.",shape=box,color=blue];
		3648 -> 3654;
		3648 -> 3655;
	3651 [label="Check boolean RoatheDating",color=orange];
		3651 -> 3659 [label=true,color=green];
