		351 -> 364;
	352 [label="Everyone dies. To fear it is silly. It comes for us all. Or at least... it should.",shape=box,color=red];
		352 -> 365;
	353 [label="I've died enough times. I don't fear what comes after. I'm eager for it.",shape=box,color=red];
		353 -> 366;
	354 [label="+5 Chemistry",color=orange];
		354 -> 367;
	348 [label="I'm a little surprised you're open to people not believing in your faith.",shape=box,color=red];
		348 -> 361;
	349 [label="That's exactly it. I don't want to say one is \"right\" or \"wrong.\"",shape=box,color=red];
		349 -> 362;
	373 [label="They have been known to change their forms to please their followers in other sects. But that is my faith, not yours.",shape=box,color=blue];
		373 -> 386;
	371 [label="I'd like that.",shape=box,color=red];
		371 -> 384;
	372 [label="I'm surprised you're open to the idea of other religions. ",shape=box,color=red];
		372 -> 385;
	368 [label="A wanderer after my own heart ! You bring such a smile to my face. I hope you do not lie to flatter me.",shape=box,color=blue];
		368 -> 382;
	369 [label="Aah, the wanderer follows the night's path like my dear Lyon. When he is ready, you should speak to him of his dark lady's ways, he will be overjoyed.",shape=box,color=blue];
		369 -> 382;
	370 [label="Balance without indecision. To journey through one's life, knowing when the sun must rise and the moon must answer it, but to never fall prey to doubt ?",shape=box,color=blue];
		370 -> 383;
