		j3319854765 -> j1568045849;
	j2430189121 [label="Boolean DrifterFaithNoMITW is now true.",color=orange];
		j2430189121 -> j4053099415;
	j3532769271 [label="Oft have I sat in the sanctuary of my Cathédrale and spoken gleefully with strangers who have come to learn and nothing more.",shape=box,color=blue];
		j3532769271 -> j552576565;
	j102141660 [label="+5 Chemistry",color=orange];
		j102141660 -> j732122156;
	j1875375304 [label="+5 Chemistry",color=orange];
		j1875375304 -> j2782931923;
	j3875327916 [label="+5 Chemistry",color=orange];
		j3875327916 -> j3651933294;
	j2762542661 [label="Boolean DrifterFaithSol is now true.",color=orange];
		j2762542661 -> j3228366499;
	j959299585 [label="Boolean DrifterFaithLua is now true.",color=orange];
		j959299585 -> j996008471;
	j159836630 [label="Boolean DrifterFaithBalance is now true.",color=orange];
		j159836630 -> j2621088984;
	j1790489741 [label="Oui, je vois... You perhaps need your own \"proof\" to be certain? Nothing has happened in your own life to give you such an emotion, like we feel of faith and fervor ?",shape=box,color=blue];
		j1790489741 -> j541939059;
		j1790489741 -> j2974450641;
	j1568045849 [label="Oui, c'est vrai - that is true. Faith answers many questions for many souls. Do you not fear what may come after death ?",shape=box,color=blue];
		j1568045849 -> j1188610232;
		j1568045849 -> j611576904;
	j4053099415 [label="Comme c'est fascinant... and now there are two, who repeat the same words... the devil has whispered the same.",shape=box,color=blue];
		j4053099415 -> j1986859435;
	j552576565 [label="So curious of our faith but not wanting to say \"yes, yes, this is the truth.\" I can only hope I gave them some part of our joy to take with them.",shape=box,color=blue];
		j552576565 -> j3212171323;
		j552576565 -> j1764903401;
	j732122156 [label="Je comprends et c'est magnifique. I have often wondered if the Luminaries did not wear other faces. Other names.",shape=box,color=blue];
		j732122156 -> j2782886016;
	j2782931923 [label="Oh, comme c'est fascinant ! How I would love to learn of your faith some day. To hear of your rituals.",shape=box,color=blue];
		j2782931923 -> j1542472472;
		j2782931923 -> j3514717752;
	j3651933294 [label="Oh, comme c'est fascinant ! How I would love to hear how it is so aligned and yet so different some day.",shape=box,color=blue];
		j3651933294 -> j1542472472;
		j3651933294 -> j3514717752;
	j3228366499 [label="+10 Chemistry",color=orange];
		j3228366499 -> j1987174452;
	j996008471 [label="+5 Chemistry",color=orange];
		j996008471 -> j2866744000;
	j2621088984 [label="+5 Chemistry",color=orange];
		j2621088984 -> j1518178185;
	j541939059 [label="No, I just don't believe.",shape=box,color=red];
		j541939059 -> j269960062;
	j2974450641 [label="That's right. I've never... \"felt\" faith. Or needed it.",shape=box,color=red];
		j2974450641 -> j3258928145;
	j1188610232 [label="Everyone dies. To fear it is silly. It comes for us all. Or at least... it should.",shape=box,color=red];
		j1188610232 -> j787360287;
	j611576904 [label="I've died enough times. I don't fear what comes after. I'm eager for it.",shape=box,color=red];
		j611576904 -> j2930103098;
	j1986859435 [label="+5 Chemistry",color=orange];
		j1986859435 -> j1072781671;
	j3212171323 [label="I'm a little surprised you're open to people not believing in your faith.",shape=box,color=red];
		j3212171323 -> j2286451660;
	j1764903401 [label="That's exactly it. I don't want to say one is \"right\" or \"wrong.\"",shape=box,color=red];
		j1764903401 -> j3647955796;
	j2782886016 [label="They have been known to change their forms to please their followers in other sects. But that is my faith, not yours.",shape=box,color=blue];
		j2782886016 -> j3431862181;
	j1542472472 [label="I'd like that.",shape=box,color=red];
		j1542472472 -> j3900146551;
	j3514717752 [label="I'm surprised you're open to the idea of other religions. ",shape=box,color=red];
		j3514717752 -> j3023607126;
	j1987174452 [label="A wanderer after my own heart ! You bring such a smile to my face. I hope you do not lie to flatter me.",shape=box,color=blue];
		j1987174452 -> j639044910;
	j2866744000 [label="Aah, the wanderer follows the night's path like my dear Lyon. When he is ready, you should speak to him of his dark lady's ways, he will be overjoyed.",shape=box,color=blue];
		j2866744000 -> j639044910;
	j1518178185 [label="Balance without indecision. To journey through one's life, knowing when the sun must rise and the moon must answer it, but to never fall prey to doubt ?",shape=box,color=blue];
		j1518178185 -> j4172874339;
	j269960062 [label="+5 Chemistry",color=orange];
		j269960062 -> j1128283911;
	j3258928145 [label="+5 Chemistry",color=orange];
		j3258928145 -> j3432495461;
	j787360287 [label="+5 Chemistry",color=orange];
		j787360287 -> j183858709;
	j2930103098 [label="+5 Chemistry",color=orange];
		j2930103098 -> j2374419806;
	j1072781671 [label="It pains my heart to give him any manner of credence but in this ? Perhaps you should speak to him. Simply be wary. The devil plays a dangerous game.",shape=box,color=blue];
		j1072781671 -> j2163488362;
		j1072781671 -> j3741076934;
	j2286451660 [label="I suppose that might be a surprise, to find someone who wears the cloth to not be strict in their expectations of others. I find preaching to those who are not seeking solace does not win much love.",shape=box,color=blue];
		j2286451660 -> j3990050470;
	j3647955796 [label="+5 Chemistry",color=orange];
		j3647955796 -> j2850969614;
	j3431862181 [label="I simply hope your faith brings you peace ?",shape=box,color=blue];
		j3431862181 -> j1741495148;
		j3431862181 -> j331710084;
		j3431862181 -> j2055124644;
	j3900146551 [label="Ô joie ! I do so much love to learn. I have often wondered if the Luminaries did not wear other faces. Other names.",shape=box,color=blue];
		j3900146551 -> j1738969560;
	j3023607126 [label="I suppose that might be a surprise, to find someone who wears the cloth to not be strict in their expectations of others. I find preaching to those who are not seeking solace does not win much love.",shape=box,color=blue];
		j3023607126 -> j2626982247;
	j639044910 [label="I simply wonder, does our faith bring you peace ?",shape=box,color=blue];
		j639044910 -> j1741495148;
		j639044910 -> j331710084;
		j639044910 -> j2055124644;
	j4172874339 [label="That is a rare gift... and one I hope you wield. To linger at the crossroads too long is to be consumed by strife, I fear.",shape=box,color=blue];
		j4172874339 -> j3926957405;
	j1128283911 [label="It must be a simpler life, then. To not live by the rules of gods and churches. I admit I am a little jealous.",shape=box,color=blue];
		j1128283911 -> j3075465002;
	j3432495461 [label="Then I am jealous of you, wanderer ! To live so many centuries, devoid of the need to know the gods.",shape=box,color=blue];
		j3432495461 -> j3075465002;
	j183858709 [label="You sound like a disciple of Lua, and I mean that with no offense. Oui, the Crone comes for us all, and weeps her silver tears. But your words make me wonder...",shape=box,color=blue];
		j183858709 -> j318290488;
	j2374419806 [label="Oui, it makes me wonder. I look upon you, the child, the devil, even Monsieur Loid, or le Cardinal... so many centuries stretch behind you all.",shape=box,color=blue];
		j2374419806 -> j2769679171;
	j2163488362 [label="What kind of dangerous game?",shape=box,color=red];
		j2163488362 -> j12868536;
	j3741076934 [label="He doesn't think the Man in the Wall is real, either?",shape=box,color=red];
		j3741076934 -> j3963060627;
	j3990050470 [label="+5 Chemistry",color=orange];
		j3990050470 -> j1990803704;
	j2850969614 [label="I am smiling at your wisdom and kindness towards the beliefs of others.",shape=box,color=blue];
		j2850969614 -> j1947875327;
	j1741495148 [label="It doesn't.",shape=box,color=red];
		j1741495148 -> j3311771219;
	j331710084 [label="I honestly don't think much about it.",shape=box,color=red];
		j331710084 -> j2040577019;
	j2055124644 [label="It does.",shape=box,color=red];
		j2055124644 -> j3087990084;
	j1738969560 [label="They have been known to change their forms to please their followers in other sects. But that is my faith, not yours. I will not preach to those who are not seeking for solace. I find it does not win much love.",shape=box,color=blue];
		j1738969560 -> j2626982247;
	j2626982247 [label="No, my faith is mine, and yours is your own. I simply hope it brings you peace ?",shape=box,color=blue];
		j2626982247 -> j1741495148;
		j2626982247 -> j331710084;
		j2626982247 -> j2055124644;
	j3926957405 [label="In the end, all must choose a path to walk. But the crossroads is where we must all begin, the balance is the foundation of all structures.",shape=box,color=blue];
		j3926957405 -> j4289413605;
	j3075465002 [label="But, I wonder... does this not believing, does it bring you peace ?",shape=box,color=blue];
		j3075465002 -> j1741495148;
		j3075465002 -> j331710084;
		j3075465002 -> j2055124644;
	j318290488 [label="Of whom do you speak of, when you say \"it should\" come for you all ? I look upon you, the child, the devil, even Monsieur Loid, or le Cardinal... so many centuries stretch behind you all.",shape=box,color=blue];
		j318290488 -> j2769679171;
	j2769679171 [label="I wonder how many centuries stretch before us now, before Lua will come for us. And I wonder how eagerly I will embrace her when that day should come. But that is my faith, not yours.",shape=box,color=blue];
		j2769679171 -> j3075465002;
	j12868536 [label="I do not know just yet. He keeps his schemes to himself like a good devil. But he believes in no gods. Save, perhaps, himself.",shape=box,color=blue];
		j12868536 -> j3075465002;
	j3963060627 [label="Non, he does not. He is much like you, he believes in no gods. Save, perhaps, himself.",shape=box,color=blue];
		j3963060627 -> j3075465002;
	j1990803704 [label="Non, anyone who comes with an open mind shall be met with open arms.",shape=box,color=blue];
		j1990803704 -> j1947875327;
	j1947875327 [label="I simply wonder, does this bring you peace ?",shape=box,color=blue];
		j1947875327 -> j1741495148;
		j1947875327 -> j331710084;
		j1947875327 -> j2055124644;
	j3311771219 [label="Boolean DrifterFaithNoPeace is now true.",color=orange];
		j3311771219 -> j2740938892;
	j2040577019 [label="+10 Chemistry",color=orange];
		j2040577019 -> j962073366;
	j3087990084 [label="+10 Chemistry",color=orange];
		j3087990084 -> j21671774;
	j4289413605 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j4289413605 -> j2968536621;
	j2740938892 [label="+10 Chemistry",color=orange];
		j2740938892 -> j1696599530;
	j962073366 [label="My jealousy abounds! It would consume me. I would... be eager to speak to you of this again, if you would allow me ? I do not wish to preach or pry. I do not wish to cause you distress.",shape=box,color=blue];
		j962073366 -> j2819863005;
	j21671774 [label="Then I know my Sol smiles upon you, whether or not you pray to him, for you have found the only path that you need.",shape=box,color=blue];
		j21671774 -> j2378590552;
	j2968536621 [label="Aah, pardonne-moi ! Little Marie is preaching, how embarrassing ! I did not come here to lecture you like a schoolteacher.",shape=box,color=blue];
		j2968536621 -> j639044910;
	j1696599530 [label="I am deeply touched by your honesty, wanderer. I would... be eager to speak to you of this again, if you would allow me? I do not wish to preach or pry. I do not wish to cause you distress.",shape=box,color=blue];
		j1696599530 -> j2819863005;
	j2819863005 [label="I am merely curious, and wish to aid you if I can. Please, tell me no, and we shall never speak of this again.",shape=box,color=blue];
		j2819863005 -> j3542881744;
		j2819863005 -> j889998962;
	j2378590552 [label="I wonder, may we speak of this again ? I am so very curious to know more.",shape=box,color=blue];
		j2378590552 -> j3542881744;
		j2378590552 -> j889998962;
	j3542881744 [label="No, thank you.",shape=box,color=red];
		j3542881744 -> j1076906881;
	j889998962 [label="Of course.",shape=box,color=red];
		j889998962 -> j1110613843;
	j1076906881 [label="Boolean DrifterFaithStop is now true.",color=orange];
		j1076906881 -> j349987009;
	j1110613843 [label="Merci, merci ! There is much trust in what you have just given me. I shall not waste it. Until then.",shape=box,color=blue];
		j1110613843 -> "Chat ends.";
	j349987009 [label="I understand completely, and I am not offended. Thank you for listening to me, and I am grateful for what you have shared. We shall speak on other matters, Sol knows we have plenty !",shape=box,color=blue];
		j349987009 -> "Chat ends.";
}