		3902 -> 3903;
	308 [label="It's... complicated. I believe there's something out there, but I don't really have a named faith.",shape=box,color=red];
		308 -> 313;
	307 [label="Yes, I do. I have a faith I believe in, though it's not one you'd know.",shape=box,color=red];
		307 -> 312;
	306 [label="I believe in the Luminaries, like you.",shape=box,color=red];
		306 -> 311;
	305 [label="No, I don't. I don't believe in gods. Just science we don't understand yet.",shape=box,color=red];
		305 -> 310;
	304 [label="I don't know, honestly. I think the world is too complicated for me to have the answer.",shape=box,color=red];
		304 -> 309;
	3901 [label="Chat ends.",color=orange];
	3903 [label="Ah, oui ? What is this ? Quelle audace, I must say I am surprised at you ! I was not expecting...",shape=box,color=blue];
