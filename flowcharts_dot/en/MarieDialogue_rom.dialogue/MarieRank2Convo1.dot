		365 -> 378;
	366 [label="+5 Chemistry",color=orange];
		366 -> 379;
	367 [label="It pains my heart to give him any manner of credence but in this ? Perhaps you should speak to him. Simply be wary. The devil plays a dangerous game.",shape=box,color=blue];
		367 -> 380;
		367 -> 381;
	361 [label="I suppose that might be a surprise, to find someone who wears the cloth to not be strict in their expectations of others. I find preaching to those who are not seeking solace does not win much love.",shape=box,color=blue];
		361 -> 374;
	362 [label="+5 Chemistry",color=orange];
