	339 [label="Oui, je vois... You perhaps need your own \"proof\" to be certain? Nothing has happened in your own life to give you such an emotion, like we feel of faith and fervor ?",shape=box,color=blue];
		339 -> 350;
		339 -> 351;
	340 [label="Oui, c'est vrai - that is true. Faith answers many questions for many souls. Do you not fear what may come after death ?",shape=box,color=blue];
		340 -> 352;
		340 -> 353;
	341 [label="Comme c'est fascinant... and now there are two, who repeat the same words... the devil has whispered the same.",shape=box,color=blue];
		341 -> 354;
	338 [label="So curious of our faith but not wanting to say \"yes, yes, this is the truth.\" I can only hope I gave them some part of our joy to take with them.",shape=box,color=blue];
		338 -> 348;
		338 -> 349;
	360 [label="Je comprends et c'est magnifique. I have often wondered if the Luminaries did not wear other faces. Other names.",shape=box,color=blue];
		360 -> 373;
	358 [label="Oh, comme c'est fascinant ! How I would love to learn of your faith some day. To hear of your rituals.",shape=box,color=blue];
		358 -> 371;
		358 -> 372;
	359 [label="Oh, comme c'est fascinant ! How I would love to hear how it is so aligned and yet so different some day.",shape=box,color=blue];
