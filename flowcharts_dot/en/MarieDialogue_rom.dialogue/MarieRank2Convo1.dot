	405 [label="My jealousy abounds! It would consume me. I would... be eager to speak to you of this again, if you would allow me ? I do not wish to preach or pry. I do not wish to cause you distress.",shape=box,color=blue];
		405 -> 409;
	406 [label="Then I know my Sol smiles upon you, whether or not you pray to him, for you have found the only path that you need.",shape=box,color=blue];
		406 -> 410;
	407 [label="Aah, pardonne-moi ! Little Marie is preaching, how embarrassing ! I did not come here to lecture you like a schoolteacher.",shape=box,color=blue];
		407 -> 382;
	408 [label="I am deeply touched by your honesty, wanderer. I would... be eager to speak to you of this again, if you would allow me? I do not wish to preach or pry. I do not wish to cause you distress.",shape=box,color=blue];
		408 -> 409;
	409 [label="I am merely curious, and wish to aid you if I can. Please, tell me no, and we shall never speak of this again.",shape=box,color=blue];
		409 -> 411;
