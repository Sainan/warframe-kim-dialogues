digraph {
	"MarieRank2Convo1 begins." [color=orange];
		"MarieRank2Convo1 begins." -> j1192606642;
	j1192606642 [label="I hope you do not think me rude for asking, but I am so terribly curious. Do you have a faith ? In the Luminaries or otherwise.",shape=box,color=blue];
		j1192606642 -> j3059093006;
		j1192606642 -> j3098453528;
		j1192606642 -> j242691715;
	j3059093006 [label="What if i said I was more interested in you, instead? Would that be blasphemous?",shape=box,color=red];
		j3059093006 -> j4205149626;
	j3098453528 [label="No, it wouldn't be rude at all.",shape=box,color=red];
		j3098453528 -> j3899125862;
		j3098453528 -> j2642970864;
		j3098453528 -> j1501486258;
		j3098453528 -> j2351307052;
		j3098453528 -> j1184006289;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j4205149626 [label="Boolean DrifterMarie is now true.",color=orange];
		j4205149626 -> j961739325;
	j3899125862 [label="It's... complicated. I believe there's something out there, but I don't really have a named faith.",shape=box,color=red];
		j3899125862 -> j1563077325;
	j2642970864 [label="Yes, I do. I have a faith I believe in, though it's not one you'd know.",shape=box,color=red];
		j2642970864 -> j3946249222;
	j1501486258 [label="I believe in the Luminaries, like you.",shape=box,color=red];
		j1501486258 -> j3187431718;
	j2351307052 [label="No, I don't. I don't believe in gods. Just science we don't understand yet.",shape=box,color=red];
		j2351307052 -> j1196803457;
	j1184006289 [label="I don't know, honestly. I think the world is too complicated for me to have the answer.",shape=box,color=red];
		j1184006289 -> j1449905473;
	"Chat ends." [color=orange];
	j961739325 [label="Ah, oui ? What is this ? Quelle audace, I must say I am surprised at you ! I was not expecting...",shape=box,color=blue];
		j961739325 -> j605772614;
	j1563077325 [label="Boolean DrifterFaithPersonal is now true.",color=orange];
		j1563077325 -> j1938344099;
	j3946249222 [label="+5 Chemistry",color=orange];
		j3946249222 -> j1695211337;
	j3187431718 [label="+5 Chemistry",color=orange];
		j3187431718 -> j987444941;
	j1196803457 [label="+5 Chemistry",color=orange];
		j1196803457 -> j568285193;
	j1449905473 [label="Boolean DrifterFaithAgnostic is now true.",color=orange];
		j1449905473 -> j3271951428;
	j605772614 [label="But you are trying to distract me ! While I am not opposed, it is far too soon for such things, n'est-ce pas ?",shape=box,color=blue];
		j605772614 -> j2637691484;
	j1938344099 [label="+5 Chemistry",color=orange];
		j1938344099 -> j4156381828;
	j1695211337 [label="Faith by any name I find beauty in. Tell me, is it new ? Old ? Would I recognize it at all ?",shape=box,color=blue];
		j1695211337 -> j3745040387;
		j1695211337 -> j2527448670;
	j987444941 [label="You do ! Oh, comme c'est fascinant ! To think someone holds the faith so far into the future, cela remplit mon cœur de joie. I am overwhelmed with joy. Though I think your time in the past may have had something to do with it, no ? Ah, no matter.",shape=box,color=blue];
		j987444941 -> j653465560;
	j568285193 [label="I respect your response. But I must ask, how are you so certain ? Is that not a kind of faith in itself ? And what is this... Indifférence of yours, if not a god ?",shape=box,color=blue];
		j568285193 -> j3280149670;
		j568285193 -> j2590706620;
		j568285193 -> j1432235435;
	j3271951428 [label="+10 Chemistry",color=orange];
		j3271951428 -> j21792740;
	j2637691484 [label="I... would still like an answer to my question, s'il vous plait, if you do not mind. Though now you have me blushing !",shape=box,color=blue];
		j2637691484 -> j3899125862;
		j2637691484 -> j2642970864;
		j2637691484 -> j1501486258;
		j2637691484 -> j2351307052;
		j2637691484 -> j1184006289;
	j4156381828 [label="Ah, oui. A wanderer, that is in your name. You have seen many cultures, many faiths, many worlds. Cela est très spirituel, non ? Collected parts of them like seashells.",shape=box,color=blue];
		j4156381828 -> j1188673658;
		j4156381828 -> j2027358488;
	j3745040387 [label="I don't think you'd recognize it at all, no.",shape=box,color=red];
		j3745040387 -> j2031164985;
	j2527448670 [label="You might recognize parts of it. But other parts would be totally foreign to you.",shape=box,color=red];
		j2527448670 -> j2250366886;
	j653465560 [label="I wonder, are you devout to one or the other ? Or do you seek the balance ?",shape=box,color=blue];
		j653465560 -> j2695298834;
		j653465560 -> j2739411071;
		j653465560 -> j1438095668;
	j3280149670 [label="I'm not perfectly certain I'm right, no one can be. But I still don't personally believe in gods.",shape=box,color=red];
		j3280149670 -> j179710790;
	j2590706620 [label="I think religion exists to fill a hole in people's lives left by the fear of death and the unknown.",shape=box,color=red];
		j2590706620 -> j3319854765;
	j1432235435 [label="I don't know what the Indifference is, but it isn't a god. We just need to get to the bottom of it. ",shape=box,color=red];
		j1432235435 -> j2430189121;
	j21792740 [label="Aah, perhaps the wisest answer of them all! For who are we mere mortals - if we can still claim to be such - to pretend to draw out the design of the Gods ?",shape=box,color=blue];
		j21792740 -> j3532769271;
	j1188673658 [label="I think there is also something older, truer, and deeper that speaks to us all. A connective tissue, kind of.",shape=box,color=red];
		j1188673658 -> j102141660;
	j2027358488 [label="Exactly. I see something beautiful in all of them, I don't know as anyone has it right or wrong.",shape=box,color=red];
		j2027358488 -> j102141660;
	j2031164985 [label="Boolean DrifterFaithYesForeign is now true.",color=orange];
		j2031164985 -> j1875375304;
	j2250366886 [label="Boolean DrifterFaithYesSimilar is now true.",color=orange];
		j2250366886 -> j3875327916;
	j2695298834 [label="I find myself drawn more towards Sol. ",shape=box,color=red];
		j2695298834 -> j2762542661;
	j2739411071 [label="I find myself drawn more towards Lua.",shape=box,color=red];
		j2739411071 -> j959299585;
	j1438095668 [label="I seek balance. I think that's the natural order of things.",shape=box,color=red];
		j1438095668 -> j159836630;
	j179710790 [label="Boolean DrifterFaithNoMaybe is now true.",color=orange];
		j179710790 -> j1790489741;
