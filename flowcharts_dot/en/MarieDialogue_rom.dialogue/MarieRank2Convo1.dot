digraph {
	302 [label="MarieRank2Convo1 begins.",color=orange];
		302 -> 303;
	303 [label="I hope you do not think me rude for asking, but I am so terribly curious. Do you have a faith ? In the Luminaries or otherwise.",shape=box,color=blue];
		303 -> 3898;
		303 -> 3899;
		303 -> 3900;
	3898 [label="What if i said I was more interested in you, instead? Would that be blasphemous?",shape=box,color=red];
		3898 -> 3902;
