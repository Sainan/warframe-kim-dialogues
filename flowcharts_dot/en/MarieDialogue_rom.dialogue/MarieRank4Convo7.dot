digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo7 begins." [color=orange];
		"MarieRank4Convo7 begins." -> j3255816954;
	j3255816954 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j3255816954 -> j2667131685 [label="x >= 0",color=purple];
		j3255816954 -> "Chat ends." [label="x <= 0",color=purple];
		j3255816954 -> "Chat ends." [label="false",color=purple];
	j2667131685 [label="Drifter, excusez-moi... Do you honestly believe it is wise to aid the devil ?",shape=box,color=blue];
		j2667131685 -> j3826186899;
	"Chat ends." [color=orange];
	j3826186899 [label="I do not wish to turn away those seeking absolution or aid, but... I do not think either is what the devil is after.",shape=box,color=blue];
		j3826186899 -> j2786893209;
		j3826186899 -> j494073316;
		j3826186899 -> j1404818416;
		j3826186899 -> j242691715;
	j2786893209 [label="And what do you think he's really after?",shape=box,color=red];
		j2786893209 -> j3705478917;
	j494073316 [label="I know you two don't get along, and I'm sorry about that. But I can't very well kick him out.",shape=box,color=red];
		j494073316 -> j4209989340;
	j1404818416 [label="Roathe has forgotten more about the Orokin - quite literally - than we will ever know. We need him.",shape=box,color=red];
		j1404818416 -> j2471566088;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j3705478917 [label="He is a feral thing. He may come close when you offer food and a warm place to stay, but all that will vanish the moment you are no longer of use to him.",shape=box,color=blue];
		j3705478917 -> j3906366570;
	j4209989340 [label="Add 1 to Thermostat counter",color=orange];
		j4209989340 -> j2112229734;
	j2471566088 [label="Add -1 to Thermostat counter",color=orange];
		j2471566088 -> j3705478917;
	j3906366570 [label="He needs something from you. From us. ",shape=box,color=blue];
		j3906366570 -> j863296879;
	j2112229734 [label="Non, nor am I suggesting that you do. Simply that he is... not to be trusted. Now, or ever.",shape=box,color=blue];
		j2112229734 -> j3705478917;
	j863296879 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j863296879 -> j4093421340 [label="x > 5",color=purple];
		j863296879 -> j1248771022 [label="x <= 5",color=purple];
		j863296879 -> j1248771022 [label="false",color=purple];
	j4093421340 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4093421340 -> j2370169343 [label="x >= 21",color=purple];
		j4093421340 -> j2376946204 [label="x < 21",color=purple];
		j4093421340 -> j2376946204 [label="false",color=purple];
	j1248771022 [label="These lost memories of his, these past horrors of Tau... I worry over what they portend.",shape=box,color=blue];
		j1248771022 -> j1584087567;
		j1248771022 -> j2329281047;
	j2370169343 [label="I know you think we have uncovered all there is to know inside his shattered mind.",shape=box,color=blue];
		j2370169343 -> j1282588049;
		j2370169343 -> j2329281047;
	j2376946204 [label="The more we learn, the deeper we delve into his shattered mind, the more unnerved I become. The more the danger becomes clear.",shape=box,color=blue];
		j2376946204 -> j2329281047;
		j2376946204 -> j1584087567;
	j1584087567 [label="I don't think he's going to just disappear the moment he has his memories back. There's more to this.",shape=box,color=red];
		j1584087567 -> j2904319083;
	j2329281047 [label="There is likely more he's still after. Not in his memories, but from us.",shape=box,color=red];
		j2329281047 -> j2069676011;
	j1282588049 [label="I believe him when he says that is all we'll discover from this. And if it was, then why is he still here?",shape=box,color=red];
		j1282588049 -> j2904319083;
	j2904319083 [label="I admit I worry more about what he intends to do with this knowledge, less the knowledge itself.",shape=box,color=blue];
		j2904319083 -> j2705740869;
	j2069676011 [label="Oui ! That is my concern, exactly. But what could it be ? What purpose do we serve him now ?",shape=box,color=blue];
		j2069676011 -> j2705740869;
	j2705740869 [label="However he intends to wield this new existence of his, I fear he means to involve us. And I simply wish for us not to go in blinded by the hope he is somehow benign.",shape=box,color=blue];
		j2705740869 -> j3529863186;
		j2705740869 -> j1715973464;
		j2705740869 -> j3764062691;
	j3529863186 [label="I'm with you. I don't trust him.",shape=box,color=red];
		j3529863186 -> j2212365379;
	j1715973464 [label="He's powerful and knowledgable. He's someone I would much prefer to have on my side.",shape=box,color=red];
		j1715973464 -> j3696884597;
	j3764062691 [label="It doesn't do any good wondering if he's going to betray us - he hasn't. And I don't call people guilty of sins they haven't committed yet.",shape=box,color=red];
		j3764062691 -> j827995457;
	j2212365379 [label="+20 Chemistry",color=orange];
		j2212365379 -> j4124526955;
	j3696884597 [label="Add -1 to Thermostat counter",color=orange];
		j3696884597 -> j2640101225;
	j827995457 [label="Add 1 to Thermostat counter",color=orange];
		j827995457 -> j330402906;
	j4124526955 [label="Bien ! I will at least be at peace knowing then I have other eyes watching that devil. It might help me sleep. Merci.",shape=box,color=blue];
		j4124526955 -> j3984234322;
	j2640101225 [label="Oui, but I wonder what the cost of that alliance shall truly be in the end. You may not be glad you paid it.",shape=box,color=blue];
		j2640101225 -> j1640731129;
	j330402906 [label="Oui... I suppose you are right. We cannot be jumping at shadows. We must stand shoulder to shoulder with any of those who wish to see the Indifference defeated.",shape=box,color=blue];
		j330402906 -> j808986917;
	j3984234322 [label="Boolean MarieRoatheNoTrust is now true.",color=orange];
		j3984234322 -> "Chat ends.";
	j1640731129 [label="I only wish to council you to be cautious... he is a monster, wearing the skin of a gentleman. Be careful with him, s'il te plaît ?",shape=box,color=blue];
		j1640731129 -> j167692276;
		j1640731129 -> j774383929;
	j808986917 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j808986917 -> j998523809 [label=true,color=green];
		j808986917 -> j138811102 [label=false,color=brown];
	j167692276 [label="I think you're being a bit unfair to him.",shape=box,color=red];
		j167692276 -> j3636453024;
	j774383929 [label="I'll be careful. I promise.",shape=box,color=red];
		j774383929 -> j3185382971;
	j998523809 [label="Even if you believe the force behind it is not born of a god but of our own minds, it is still a threat.",shape=box,color=blue];
		j998523809 -> j1640731129;
	j138811102 [label="Even if he believes the force behind it is not born of a god but of our own minds, it is still a threat.",shape=box,color=blue];
		j138811102 -> j1640731129;
	j3636453024 [label="Add -1 to Thermostat counter",color=orange];
		j3636453024 -> j1868256691;
	j3185382971 [label="+20 Chemistry",color=orange];
		j3185382971 -> j399989329;
	j1868256691 [label="Oui ? How so ? I do not mean that cruelly, I am truly curious.",shape=box,color=blue];
		j1868256691 -> j2674129116;
		j1868256691 -> j3229567146;
		j1868256691 -> j449675410;
		j1868256691 -> j3466572122;
	j399989329 [label="Merci. That is all I could ask.",shape=box,color=blue];
		j399989329 -> "Chat ends.";
	j2674129116 [label="He was raised in a different society, a different time - with different expectations. We may not like it, but he is who he is.",shape=box,color=red];
		j2674129116 -> j854360174;
	j3229567146 [label="You and Lyon accepted the protoframe serum from Entrati. Willingly. He didn't. Can you imagine what that is like?",shape=box,color=red];
		j3229567146 -> j3308965359;
		j3229567146 -> j948113555;
		j3229567146 -> j854360174;
	j449675410 [label="He's gone through entire centuries of life doing what he believes is necessary. We just disagree on what that is.",shape=box,color=red];
		j449675410 -> j3308965359;
		j449675410 -> j2560749118;
	j3466572122 [label="I think a lot of his... demeanor might be what sets you off. Not his actions.",shape=box,color=red];
		j3466572122 -> j2560749118;
		j3466572122 -> j3308965359;
	j854360174 [label="He's a high-ranking soldier and socialite. And both of those things require making shadowy decisions, sometimes.",shape=box,color=red];
		j854360174 -> j681163897;
	j3308965359 [label="I think a person can do what we feel is the \"wrong thing\" and have done it with good intentions.",shape=box,color=red];
		j3308965359 -> j3712504935;
	j948113555 [label="He did all that he's done in the name of saving the Orokin Empire - and his thank you for that was to get thrown into this mess against his will.",shape=box,color=red];
		j948113555 -> j681163897;
	j2560749118 [label="I think he rubs you the wrong way because he takes pride in what he's done.",shape=box,color=red];
		j2560749118 -> j2385021199;
	j681163897 [label="Check boolean MarieGrineer",color=orange];
		j681163897 -> j1159420165 [label=true,color=green];
		j681163897 -> j1691467596 [label=false,color=brown];
	j3712504935 [label="You might think of him as a devil, but in his mind it couldn't be farther from the truth.",shape=box,color=red];
		j3712504935 -> j681163897;
	j2385021199 [label="Oui, I do not enjoy those who revel in death. And I find his eagerness to shed blood alarming. And the fact that you do not find it unsettling, equally so.",shape=box,color=blue];
		j2385021199 -> j577995417;
	j1159420165 [label="And I think those who command any of these \"Corpus\" or \"Grineer\" that you fight would say the same. They do not think themselves wrong.",shape=box,color=blue];
		j1159420165 -> j4217175552;
	j1691467596 [label="And I think those who command any of these \"Corpus\" or \"Grin-ire\" that you fight would say the same. They do not think themselves wrong.",shape=box,color=blue];
		j1691467596 -> j4217175552;
	j577995417 [label="It is too easy to adapt the path of abnegation to the sin of violence, to reject the horror of it, to say that it is meaningless in the name of \"what matters.\"",shape=box,color=blue];
		j577995417 -> j3686062932;
	j4217175552 [label="They believe their actions to be just and good and necessary. How do you condone one devil but not another ?",shape=box,color=blue];
		j4217175552 -> j531874324;
		j4217175552 -> j943104199;
		j4217175552 -> j764063809;
		j4217175552 -> j3373446547;
	j3686062932 [label="To take pride in the act itself... is too far for me. I do not delight when I must take a life, but he does. So in that way ? We are quite different.",shape=box,color=blue];
		j3686062932 -> j1721026850;
	j531874324 [label="I'll try to stop them when they do things I disagree with. But... I'll fight beside them when I need to.",shape=box,color=red];
		j531874324 -> j3834387564;
	j943104199 [label="I don't believe those groups are \"good\" or \"bad\" by definition. Only in the actions they choose to take.",shape=box,color=red];
		j943104199 -> j3810765658;
	j764063809 [label="It isn't my place to declare that some actions are \"good\" and some \"bad.\" I do what I do to protect people that need protecting.",shape=box,color=red];
		j764063809 -> j3834387564;
	j3373446547 [label="You're asking me to judge an entire group of people on the same merits I'd use to judge an individual.",shape=box,color=red];
		j3373446547 -> j3810765658;
	j1721026850 [label="I can only pray that it is not too late if the devil decides to put that knife of his into your ribs. I do not wish for your last thoughts to be \"Marie warned me.\"",shape=box,color=blue];
		j1721026850 -> j2857109885;
		j1721026850 -> j2375495783;
	j3834387564 [label="And you believe the devil is not a threat ? That he is not dangereux to those around him ? He could do great harm.",shape=box,color=blue];
		j3834387564 -> j2589787092;
		j3834387564 -> j3282097088;
	j3810765658 [label="And what of the horrible acts he has committed ? All the death, all the slaughter ? Were these justified actions in your mind ?",shape=box,color=blue];
		j3810765658 -> j3282097088;
	j2857109885 [label="He won't. And if he tries, I'll stop him.",shape=box,color=red];
		j2857109885 -> j4248091548;
	j2375495783 [label="I promise those won't be my last thoughts.",shape=box,color=red];
		j2375495783 -> j4247429258;
	j2589787092 [label="If the time comes where he turns on us, I'll act. Until then, he's proven to be nothing but an ally. If... a bit melodramatic.",shape=box,color=red];
		j2589787092 -> j2419580127;
	j3282097088 [label="I don't see his dangerous quality as a problem. He is a weapon. And weapons can be used to murder or protect.",shape=box,color=red];
		j3282097088 -> j3278770576;
	j4248091548 [label="I adore you for your faith in yourself, even if I bemoan that you have faith in him. So I shall have faith in you, in turn, I suppose.",shape=box,color=blue];
		j4248091548 -> j3453049026;
	j4247429258 [label="I believe you mean those words not in the way that I would hope, but I shall not read too much into them.",shape=box,color=blue];
		j4247429258 -> j3453049026;
	j2419580127 [label="Add 1 to Thermostat counter",color=orange];
		j2419580127 -> j1721026850;
	j3278770576 [label="Add -1 to Thermostat counter",color=orange];
		j3278770576 -> j1721026850;
	j3453049026 [label="I must go. But again, I beg you - be wary. For my sake, if not for yours, d'accord ?",shape=box,color=blue];
		j3453049026 -> j367054140;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
}