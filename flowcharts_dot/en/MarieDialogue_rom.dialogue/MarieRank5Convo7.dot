		j3527268973 -> j840654869;
	"Chat ends." [color=orange];
	j3334011245 [label="He says that he has told you the whole of it now, oui ? It nearly brings me to tears just to think of it...",shape=box,color=blue];
		j3334011245 -> j3878099964;
		j3334011245 -> j3411889463;
		j3334011245 -> j3505239869;
		j3334011245 -> j242691715;
	j840654869 [label="He says that he has told you some of it now, oui ? I am glad he has begun to open up to you...",shape=box,color=blue];
		j840654869 -> j3411889463;
		j840654869 -> j3878099964;
		j840654869 -> j242691715;
	j3878099964 [label="I think he's okay, really. It's just... what he's been through - it's a lot.",shape=box,color=red];
		j3878099964 -> j3814136705;
	j3411889463 [label="It broke my heart... I just wish there was more I could do to help him...",shape=box,color=red];
		j3411889463 -> j1968848648;
	j3505239869 [label="I'm just glad he... finally trusted me enough to tell me his whole story...",shape=box,color=red];
		j3505239869 -> j1725503977;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j3814136705 [label="+5 Chemistry",color=orange];
		j3814136705 -> j3590788360;
	j1968848648 [label="You do so much just by listening. For being there when he feels able to speak. He is not broken - the cracks in him do not run so deep as to threaten the foundation. They are scars that are shallow.",shape=box,color=blue];
		j1968848648 -> j3327801774;
	j1725503977 [label="+5 Chemistry",color=orange];
		j1725503977 -> j3874678410;
	j3590788360 [label="Oui, you understand. He is not some broken, empty thing. The cracks in him do not threaten the foundation. They are scars that are shallow.",shape=box,color=blue];
		j3590788360 -> j3327801774;
	j3327801774 [label="Do you know, that yesterday, I found him sitting and reading a book of ancient philosophy to M'sieur Fibonacci ?",shape=box,color=blue];
		j3327801774 -> j84783129;
	j3874678410 [label="Oui. You do so much by listening. He is not some broken, empty thing. The cracks in him do not threaten the foundation. They are scars that are shallow.",shape=box,color=blue];
		j3874678410 -> j3327801774;
	j84783129 [label="M'sieur Fibonacci had been begging for someone to read it to him for ages, but everyone else refused ! Did not want to give him des munitions, ha !",shape=box,color=blue];
		j84783129 -> j2486207884;
	j2486207884 [label="Evaluate expressions",color=orange];
		j2486207884 -> j2917093272 [label="LyonDating",color=purple];
		j2486207884 -> j1121480041 [label="MarieDating",color=purple];
		j2486207884 -> j1882623927 [label="false",color=purple];
	j2917093272 [label="Our sweet Lyon never would have dreamed of doing such a thing. Talking to others in such a way. He was enjoying himself.",shape=box,color=blue];
		j2917093272 -> j3400473124;
	j1121480041 [label="Lyon never would have dreamed of doing such a thing. Talking to others in such a way. He was enjoying himself, mon cœur.",shape=box,color=blue];
		j1121480041 -> j3400473124;
	j1882623927 [label="Lyon never would have dreamed of doing such a thing. Talking to others in such a way. He was enjoying himself.",shape=box,color=blue];
		j1882623927 -> j3400473124;
	j3400473124 [label="And I know it is not either of the Luminaries that I have to thank at evening prayer for that. It is you.",shape=box,color=blue];
		j3400473124 -> j3123960711;
	j3123960711 [label="Check boolean LyonDating",color=orange];
		j3123960711 -> j1971845633 [label=true,color=green];
		j3123960711 -> j216436380 [label=true,color=green];
		j3123960711 -> j216436380 [label=false,color=brown];
		j3123960711 -> j3129710855 [label=false,color=brown];
	j1971845633 [label="I care about him more than I can describe. I'm glad I make him feel safe.",shape=box,color=red];
		j1971845633 -> j3308485133;
	j216436380 [label="Any part I've played in that, I'm happy for.",shape=box,color=red];
		j216436380 -> j3308485133;
	j3129710855 [label="He deserves a place he can feel safe. Friends. Family.",shape=box,color=red];
		j3129710855 -> j3308485133;
	j3308485133 [label="+15 Chemistry",color=orange];
		j3308485133 -> j3978371031;
	j3978371031 [label="Oui ! And it is simply more proof that we are where we are meant to be. Here. With you. In this Sanctum. And together.",shape=box,color=blue];
		j3978371031 -> j3844703164;
	j3844703164 [label="Evaluate expressions",color=orange];
		j3844703164 -> j3085064166 [label="MarieFamilyFail",color=purple];
		j3844703164 -> j731383733 [label="RoatheFamilyFail",color=purple];
		j3844703164 -> j2714175501 [label="MarieFamilySuccess",color=purple];
		j3844703164 -> j2714175501 [label="false",color=purple];
	j3085064166 [label="It... makes me reconsider my decision to work with you on mending the efforts between Monsieur Loid and the family above.",shape=box,color=blue];
		j3085064166 -> j2625162105;
		j3085064166 -> j2197101167;
	j731383733 [label="It makes me realize how much of a tragédie it is that the devil refuses to aid our efforts in rebuilding the bridge between Monsieur Loid and the family above... I wonder if there is not something to be done about it.",shape=box,color=blue];
		j731383733 -> j1527593087;
		j731383733 -> j1695425235;
	j2714175501 [label="It makes me all the more eager to mend the bridge between Monsieur Loid and the family above ! Let us to work and be quick about it !",shape=box,color=blue];
		j2714175501 -> "Chat ends.";
	j2625162105 [label="I... really didn't think I could get you to help.",shape=box,color=red];
		j2625162105 -> j1762570339;
	j2197101167 [label="Really? You're changing your mind about that?",shape=box,color=red];
		j2197101167 -> j1762570339;
	j1527593087 [label="Are you sure you want to take him on over that?",shape=box,color=red];
		j1527593087 -> j2030488455;
	j1695425235 [label="Really? You'd argue with Roathe on my behalf?",shape=box,color=red];
		j1695425235 -> j2030488455;
	j1762570339 [label="For all that you have done to help the brother of my soul ? While we may not agree on other matters - and may never see eye-to-eye, this ? This I shall do for you.",shape=box,color=blue];
		j1762570339 -> j2923944558;
	j2030488455 [label="Ha ! I have fought with the devil over far less. And for all you have done to help the brother of my soul ? I would do it with joie. ",shape=box,color=blue];
		j2030488455 -> j1456463622;
	j2923944558 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j2923944558 -> j3450208298;
	j1456463622 [label="The devil does not know his match. Watch how I destroy his will beneath my own. Marie sera victorieuse !",shape=box,color=blue];
		j1456463622 -> j4218075214;
	j3450208298 [label="Boolean MarieFamilyFail is now false.",color=orange];
