	j1138299529 [label="Check boolean VelimirEclipse",color=orange];
		j1138299529 -> j392677634 [label=true,color=green];
		j1138299529 -> "Chat ends." [label=false,color=brown];
	j392677634 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:CheckDuviriMitwCollectibles(collectibleType=/Lotus/Types/Lore/Fragments/DuviriMITWFragments/DuviriMITWCollectibleDeco)",color=orange];
		j392677634 -> j1957781517 [label=true,color=green];
		j392677634 -> "Chat ends." [label=false,color=brown];
	"Chat ends." [color=orange];
	j1957781517 [label="Hey... guys?",shape=box,color=red];
		j1957781517 -> j4204399939;
	j4204399939 [label="MomToxicated: Yes?",shape=box,color=blue];
		j4204399939 -> j3682974464;
	j3682974464 [label="PapaPolar: what's up lil buddy?",shape=box,color=blue];
		j3682974464 -> j3804243851;
		j3682974464 -> j2364347197;
		j3682974464 -> j1523382966;
	j3804243851 [label="I have good news and I have bad news. About Neci.",shape=box,color=red];
		j3804243851 -> j339206209;
	j2364347197 [label="I need you both not to get your hopes up. I have news about Neci, but it's... mixed. And inconclusive.",shape=box,color=red];
		j2364347197 -> j87471203;
	j1523382966 [label="Fff... Actually, never mind. [End.]",shape=box,color=red];
		j1523382966 -> "Chat ends.";
	j339206209 [label="PapaPolar: do it the adult way. bad news first.",shape=box,color=blue];
		j339206209 -> j3422489228;
	j87471203 [label="+5 Chemistry",color=orange];
		j87471203 -> j3344408859;
	j3422489228 [label="MomToxicated: I agree. Bad news always comes first.",shape=box,color=blue];
		j3422489228 -> j2369784922;
	j3344408859 [label="MomToxicated: All things in life generally are. But thank you for the warning.",shape=box,color=blue];
		j3344408859 -> j4116743482;
	j2369784922 [label="So. The Indifference went to Duviri. and it... took Neci there with it.",shape=box,color=red];
		j2369784922 -> j1642358943;
	j4116743482 [label="+5 Chemistry",color=orange];
		j4116743482 -> j1266889416;
	j1642358943 [label="PapaPolar: wait. wait wait. that storybook dimension thing?",shape=box,color=blue];
		j1642358943 -> j3894005793;
	j1266889416 [label="PapaPolar: bracing for the news, but it sounds like she's... not dead, at least?",shape=box,color=blue];
		j1266889416 -> j3191483663;
	j3894005793 [label="MomToxicated: The one with the child dictator that kept killing you repeatedly?",shape=box,color=blue];
		j3894005793 -> j4270279999;
		j3894005793 -> j2682093934;
	j3191483663 [label="I don't... know. I don't think so. But let me just tell you what I do know, and I'll let you two be the judges.",shape=box,color=red];
		j3191483663 -> j2369784922;
	j4270279999 [label="Turns out this was kind of a growth moment for him? Not the point. Anyway-",shape=box,color=red];
		j4270279999 -> j1052418591;
	j2682093934 [label="That's the one.",shape=box,color=red];
		j2682093934 -> j1052418591;
	j1052418591 [label="Neci... took the throne. The Murmur - The Indifference's \"army\" for lack of a better word, invaded, and she took over.",shape=box,color=red];
		j1052418591 -> j574965604;
	j574965604 [label="MomToxicated: Heh. That's my little girl.",shape=box,color=blue];
		j574965604 -> j2736723701;
	j2736723701 [label="PapaPolar: but was it really *her* though? or just that thing wearing her face?",shape=box,color=blue];
		j2736723701 -> j1779485264;
		j2736723701 -> j924820805;
	j1779485264 [label="I don't know.",shape=box,color=red];
		j1779485264 -> j1631034715;
	j924820805 [label="That's what I wanted to talk to you about.",shape=box,color=red];
		j924820805 -> j1631034715;
	j1631034715 [label="I found these records. They were disjointed at first. But when I put them all together, I... got this message.",shape=box,color=red];
		j1631034715 -> j3398355259;
	j3398355259 [label="I was curious if it made any sense to you.",shape=box,color=red];
		j3398355259 -> j3412958188;
	j3412958188 [label="MomToxicated: Riddles and strange messages? You're speaking our language.",shape=box,color=blue];
		j3412958188 -> j2711678559;
	j2711678559 [label="PapaPolar: 1-800-spy-shit, you've come to the right place",shape=box,color=blue];
		j2711678559 -> j2981190172;
	j2981190172 [label="\"For when Sol and Lua align, the lost shall find their way home.\"",shape=box,color=red];
		j2981190172 -> j3199371614;
	j3199371614 [label="PapaPolar: ....shit. M. SHIT.",shape=box,color=blue];
		j3199371614 -> j1075534443;
	j1075534443 [label="MomToxicated: Don't fall for it. If that thing's inside her head, it knows what she knows.",shape=box,color=blue];
		j1075534443 -> j1500002417;
		j1075534443 -> j3190246910;
	j1500002417 [label="What? What does it mean?",shape=box,color=red];
		j1500002417 -> j2624068937;
	j3190246910 [label="It's the other half, isn't it?",shape=box,color=red];
		j3190246910 -> j2794452938;
	j2624068937 [label="PapaPolar: \"On empty crossroads, seek the eclipse.\"",shape=box,color=blue];
		j2624068937 -> j1421952144;
	j2794452938 [label="+5 Chemistry",color=orange];
		j2794452938 -> j2303711172;
	j1421952144 [label="PapaPolar: what i told you to tell our lil girl if you saw her again.",shape=box,color=blue];
		j1421952144 -> j1780081437;
	j2303711172 [label="PapaPolar: you got it...",shape=box,color=blue];
		j2303711172 -> j1593371657;
	j1780081437 [label="PapaPolar: it was our half of a code phrase. how we started each phone call so we knew we were on a secure line and everything was safe",shape=box,color=blue];
		j1780081437 -> j1054698419;
	j1593371657 [label="PapaPolar: we had a code phrase. it was how we started each phone call so we knew we were on a secure line and everything was safe",shape=box,color=blue];
		j1593371657 -> j1054698419;
	j1054698419 [label="MomToxicated: That we were actually... ourselves.",shape=box,color=blue];
		j1054698419 -> j17816325;
	j17816325 [label="PapaPolar: \"On empty crossroads, seek the eclipse\" was our half.",shape=box,color=blue];
		j17816325 -> j1488732311;
	j1488732311 [label="MomToxicated: \"For when Sol and Lua align, the lost shall find their way home\" was the responding half.",shape=box,color=blue];
		j1488732311 -> j3730973429;
	j3730973429 [label="MomToxicated: *Her* half.",shape=box,color=blue];
		j3730973429 -> j701371379;
		j3730973429 -> j1454679532;
	j701371379 [label="But we can't be sure it was her, like you said, Minerva. The Indifference knows what she knows.",shape=box,color=red];
		j701371379 -> j3963569415;
	j1454679532 [label="I don't know why the Indifference would tell you that...",shape=box,color=red];
		j1454679532 -> j1644522989;
	j3963569415 [label="MomToxicated: But why would it be trying to give us a sense of hope? Unless it was simply trying to hurt us.",shape=box,color=blue];
		j3963569415 -> j2669670842;
	j1644522989 [label="MomToxicated: Through false hope, perhaps? To cause us pain?",shape=box,color=blue];
		j1644522989 -> j1455633978;
	j2669670842 [label="PapaPolar: is this painful?",shape=box,color=blue];
		j2669670842 -> j3503167413;
	j1455633978 [label="PapaPolar: is it false, though? is this painful?",shape=box,color=blue];
		j1455633978 -> j3503167413;
	j3503167413 [label="PapaPolar: or is it some kind of peace, to know our little girl is still alive out there, somewhere?",shape=box,color=blue];
		j3503167413 -> j3518332689;
	j3518332689 [label="PapaPolar: that despite all odds, she's still kicking ass and taking names?",shape=box,color=blue];
		j3518332689 -> j951919769;
	j951919769 [label="PapaPolar: even if it isn't with us?",shape=box,color=blue];
		j951919769 -> j3883969478;
	j3883969478 [label="PapaPolar: that warms my big dumb heart, i don't know about you.",shape=box,color=blue];
		j3883969478 -> j178838453;
	j178838453 [label="PapaPolar: 'n something tells me that's not what the so-called indifference is in the business of doing",shape=box,color=blue];
		j178838453 -> j1887005619;
	j1887005619 [label="MomToxicated: You're very right. Hearing that phrase, thinking she even *might* still be out there, isn't painful.",shape=box,color=blue];
		j1887005619 -> j4088537255;
	j4088537255 [label="MomToxicated: I'm proud of her.",shape=box,color=blue];
		j4088537255 -> j979748482;
		j4088537255 -> j691732820;
		j4088537255 -> j1847334428;
	j979748482 [label="Even if she's still being held hostage by the Indifference?",shape=box,color=red];
		j979748482 -> j4273980713;
	j691732820 [label="Even if it's a trick by the Indifference?",shape=box,color=red];
		j691732820 -> j1645805809;
	j1847334428 [label="She could be willingly working with the Indifference.",shape=box,color=red];
		j1847334428 -> j3270032581;
	j4273980713 [label="PapaPolar: she's as tough as a bag of framing nails in a big 'ol block of cast titanium",shape=box,color=blue];
		j4273980713 -> j1037068291;
	j1645805809 [label="MomToxicated: Why? What for? What does he have to gain from the two of us?",shape=box,color=blue];
		j1645805809 -> j1031151975;
	j3270032581 [label="MomToxicated: Then she has one of the most powerful allies in the universe. In existence. She picked a side. So did we.",shape=box,color=blue];
		j3270032581 -> j1214945351;
	j1037068291 [label="PapaPolar: and i'm betting yer \"man in the wall\" knew that, and that's why he took her in the first place",shape=box,color=blue];
		j1037068291 -> j2644966993;
	j1031151975 [label="PapaPolar: we're small fry to that thing. which i say in the best way possible",shape=box,color=blue];
		j1031151975 -> j2443273231;
	j1214945351 [label="MomToxicated: Hopefully, we'll never have to point guns at each other. And if we do? Then we'll deal with it.",shape=box,color=blue];
		j1214945351 -> j231693107;
	j2644966993 [label="PapaPolar: nah. she'll be fine. either she's already long gone, or they've got a mutual arrangement, or she's holding his ass hostage. lol",shape=box,color=blue];
		j2644966993 -> j2443273231;
	j2443273231 [label="MomToxicated: No, I think the message was real. And I think it was from our little girl. Telling us... she's still out there.",shape=box,color=blue];
		j2443273231 -> j3062267991;
	j231693107 [label="PapaPolar: she's can take care of herself, though. that's how we raised her",shape=box,color=blue];
		j231693107 -> j2443273231;
	j3062267991 [label="MomToxicated: Telling us, in her own way, that she's \"okay.\"",shape=box,color=blue];
		j3062267991 -> j2069894144;
	j2069894144 [label="MomToxicated: And that we can stop worrying about her.",shape=box,color=blue];
		j2069894144 -> j3078291469;
	j3078291469 [label="PapaPolar: heh. like we ever could",shape=box,color=blue];
		j3078291469 -> j2224347043;
	j2224347043 [label="MomToxicated: The curse and blessing of being a parent.",shape=box,color=blue];
		j2224347043 -> j1874537113;
	j1874537113 [label="PapaPolar: you ever want kids, drifter? eeeh, don't answer that. probably some void nonsense i don't wanna know about.",shape=box,color=blue];
		j1874537113 -> j3803697792;
		j1874537113 -> j967664429;
		j1874537113 -> j988960737;
	j3803697792 [label="Drinks? Drinks.",shape=box,color=red];
		j3803697792 -> j2636017994;
	j967664429 [label="Good call.",shape=box,color=red];
		j967664429 -> j1971653661;
	j988960737 [label="<RETRO_EMOJI_OHNO>",shape=box,color=red];
		j988960737 -> j500106890;
	j2636017994 [label="+5 Chemistry",color=orange];
		j2636017994 -> j3225910860;
	j1971653661 [label="PapaPolar: well, it's not a happy-happy smile. it's a melancholy-happy smile? but",shape=box,color=blue];
		j1971653661 -> j1103813791;
	j500106890 [label="MomToxicated: That is a valid response, I agree. Heh. What do you both say to a few drinks?",shape=box,color=blue];
		j500106890 -> j3070956713;
	j3225910860 [label="MomToxicated: Now you're really speaking our language.",shape=box,color=blue];
		j3225910860 -> j1103813791;
	j1103813791 [label="PapaPolar: i'd like to go put back a few and tell some good stories about our lil girl",shape=box,color=blue];
		j1103813791 -> j1588088953;
	j3070956713 [label="PapaPolar: now yer talkin'",shape=box,color=blue];
		j3070956713 -> j1103813791;
	j1588088953 [label="MomToxicated: And... Drifter? Thank you. Again. For all that you do.",shape=box,color=blue];
		j1588088953 -> j3370756614;
	j3370756614 [label="PapaPolar: yeah. seriously, lil buddy. i don't know how we'll ever be able to repay you. but if the chance comes? we'll be there.",shape=box,color=blue];
		j3370756614 -> j3501331032;
	j3501331032 [label="PapaPolar: you're family now, whether you like it or not. 8-)",shape=box,color=blue];
		j3501331032 -> "Chat ends.";
}