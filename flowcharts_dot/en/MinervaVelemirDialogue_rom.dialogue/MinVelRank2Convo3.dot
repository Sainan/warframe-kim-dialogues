	j1021690122 [label="PapaPolar: woof.",shape=box,color=blue];
		j1021690122 -> j1492122311;
	j1314056437 [label="MomToxicated: I believe that to Neci, at the time she joined Scaldra, it was a means to an end. She believed in the people around her, less than she had a firm adherence to the faith. Not like Vodyanoi.",shape=box,color=blue];
		j1314056437 -> j3687298018;
