		j4249450779 -> j3427101211;
	j1462128588 [label="MomToxicated: Smiling, my Neci gestured for them to sit at the table, and in their language, flawlessly, told them that they had more in common together than they did the rest of the world apart. That they were brothers. And sometimes, brothers fought. But brothers should never kill each other.",shape=box,color=blue];
