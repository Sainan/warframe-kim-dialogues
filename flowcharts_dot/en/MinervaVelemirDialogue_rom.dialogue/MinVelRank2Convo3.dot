		j1928034296 -> j2401801770;
	j3391529032 [label="MomToxicated: Ahem. Says the man who gave her a smoking problem.",shape=box,color=blue];
		j3391529032 -> j1998773118;
	j1492122311 [label="PapaPolar: look. i'm not even sure if she was even really into that much of the whole... sol-lua fanaticism stuff",shape=box,color=blue];
		j1492122311 -> j1588090678;
	j3687298018 [label="MomToxicated: She was always a woman of ambition. Ambition that I encouraged, fostered, and fed the fires of. Unlike *someone* who wished to freeze it over and keep her in some state of arrested childhood.",shape=box,color=blue];
