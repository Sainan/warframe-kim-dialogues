	j274103253 [label="I'm just curious how exactly she became such a military zealot.",shape=box,color=red];
		j274103253 -> j1021690122;
	j1489529677 [label="MomToxicated: I would challenge your assignment of the word zealot, though I understand from your point of view, and given your interaction with her, that is all you have to go on.",shape=box,color=blue];
		j1489529677 -> j1314056437;
	j4195349516 [label="MomToxicated: I raised her to live up to her full potential. What are you implying?",shape=box,color=blue];
		j4195349516 -> j1928034296;
	j471597915 [label="PapaPolar: have you *met* her mother?",shape=box,color=blue];
