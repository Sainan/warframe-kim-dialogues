		40 -> 43;
	41 [label="MomToxicated: Are you going to answer my questions? Yes or no?",shape=box,color=blue];
		41 -> 44;
		41 -> 45;
	42 [label="MomToxicated: If that is your real name.",shape=box,color=blue];
		42 -> 46;
	43 [label="MomToxicated: Like dealing with - whatever. Whatever. It doesn't matter.",shape=box,color=blue];
		43 -> 41;
	44 [label="Nah, sorry. I don't like your attitude, lady.",shape=box,color=red];
		44 -> 47;
	45 [label="Okay, fine. What is it?",shape=box,color=red];
		45 -> 39;
	46 [label="PapaPolar: (i don't think we get to judge.)",shape=box,color=blue];
		46 -> 48;
