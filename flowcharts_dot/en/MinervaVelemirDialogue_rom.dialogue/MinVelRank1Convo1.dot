digraph {
	0 [label="MinVelRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="MomToxicated: What's happened to her? I need answers.",shape=box,color=blue];
		1 -> 2;
	2 [label="MomToxicated: Real answers. And none of this \"it's hard to explain\" bullshit the other ones are giving me.",shape=box,color=blue];
		2 -> 3;
		2 -> 4;
		2 -> 5;
		2 -> 6;
	3 [label="Lol.",shape=box,color=red];
		3 -> 7;
	4 [label="Hi?",shape=box,color=red];
		4 -> 7;
	5 [label="Um.",shape=box,color=red];
		5 -> 7;
	6 [label="And this is...?",shape=box,color=red];
		6 -> 7;
	7 [label="PapaPolar: no reason to be like that. start with a \"hi, how are ya?\"",shape=box,color=blue];
		7 -> 8;
	8 [label="PapaPolar: sorry, pal. when M's got a target in sight, it's all about the Go Go Go.",shape=box,color=blue];
		8 -> 9;
	9 [label="MomToxicated: And I don't need YOU undercutting me.",shape=box,color=blue];
		9 -> 10;
	10 [label="PapaPolar: i'm not?",shape=box,color=blue];
		10 -> 11;
	11 [label="MomToxicated: Hah. Yeah. Right. Like you weren't undercutting me in Yalchesko.",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="Minerva & Velimir, I assume?",shape=box,color=red];
		12 -> 14;
	13 [label="Okay... Can we back up, please? What's going on?",shape=box,color=red];
		13 -> 15;
	14 [label="PapaPolar: yeah. sorry. hi. i was probably the easy one to guess, huh? lol",shape=box,color=blue];
		14 -> 16;
	15 [label="PapaPolar: hah! sorry, pal. velimir. and MomToxicated over here is minerva.",shape=box,color=blue];
		15 -> 17;
	16 [label="PapaPolar: MomToxicated over here is minerva.",shape=box,color=blue];
		16 -> 17;
	17 [label="MomToxicated: VELIMIR. What is the POINT of using this asset if YOU JUST - ",shape=box,color=blue];
		17 -> 18;
	18 [label="MomToxicated: DAMN IT.",shape=box,color=blue];
		18 -> 19;
	19 [label="PapaPolar: M, be reasonable. process of elimination. how many of us freaks can there reasonably be on this system?",shape=box,color=blue];
		19 -> 20;
		19 -> 21;
		19 -> 22;
	20 [label="I get the feeling there are going to just end up being more and more as time goes on.",shape=box,color=red];
		20 -> 23;
	21 [label="Can you two sort out whatever is happening and *then* come talk to me?",shape=box,color=red];
		21 -> 24;
	22 [label="I am so extremely confused.",shape=box,color=red];
		22 -> 25;
	23 [label="Update boolean VelimirFamily1",color=orange];
		23 -> 26;
	24 [label="PapaPolar: fear you'll be waiting a long time then, pal. hah.",shape=box,color=blue];
		24 -> 27;
	25 [label="PapaPolar: well, if *you're* confused, then we're all screwed. hah!",shape=box,color=blue];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="PapaPolar: here's the short of it. M here has questions she wants answers to, and wants you to answer them.",shape=box,color=blue];
		27 -> 30;
	28 [label="PapaPolar: seeing as you're the one we've come here to get answers from.",shape=box,color=blue];
		28 -> 30;
	29 [label="PapaPolar: i for one hope so! the more the merrier, i say. s'like the old saying goes, the only difference between a cult and a religion is numbers, haha.",shape=box,color=blue];
		29 -> 31;
	30 [label="PapaPolar: there. that better, M? that suit your \"good cop/bad cop\" gameplan more?",shape=box,color=blue];
		30 -> 32;
	31 [label="PapaPolar: is that a saying? ",shape=box,color=blue];
		31 -> 33;
	32 [label="MomToxicated: Sol above, I'm going to scream...",shape=box,color=blue];
		32 -> 34;
		32 -> 35;
		32 -> 36;
	33 [label="PapaPolar: i don't know. you get where i'm going. water's great, everybody in, as far as i'm concerned! well, anyway.",shape=box,color=blue];
		33 -> 27;
	34 [label="Why do I get the feeling I'm being interrogated?",shape=box,color=red];
		34 -> 37;
	35 [label="Well. Um. I'd rather if you didn't try to \"game\" the conversation with me.",shape=box,color=red];
		35 -> 38;
	36 [label="What do you have questions about? I'll help if I can.",shape=box,color=red];
		36 -> 39;
	37 [label="MomToxicated: Not a word, Velimir.",shape=box,color=blue];
		37 -> 40;
	38 [label="MomToxicated: This is anything but a game.",shape=box,color=blue];
		38 -> 41;
	39 [label="MomToxicated: Your cooperation has been noted, \"Drifter.\"",shape=box,color=blue];
