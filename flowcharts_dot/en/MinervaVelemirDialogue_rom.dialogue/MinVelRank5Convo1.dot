		j803793093 -> j2677791855 [label=false,color=brown];
	j1020393654 [label="MomToxicated: I can't help but wonder what Neci would think if she knew we were stuck here.",shape=box,color=blue];
		j1020393654 -> j4020913742;
	j2677791855 [label="MomToxicated: I can't help but wonder what Neci would think if she knew we were stuck here.",shape=box,color=blue];
		j2677791855 -> j1825306006;
	j4020913742 [label="PapaPolar: i hope she'd be happy to see we'd settled our issues.",shape=box,color=blue];
		j4020913742 -> j624083450;
		j4020913742 -> j2832332496;
	j1825306006 [label="PapaPolar: probably come back just to put us out of our misery.",shape=box,color=blue];
		j1825306006 -> j1888733057;
	j624083450 [label="Yeah... who knows. [End.]",shape=box,color=red];
		j624083450 -> j3469037119;
	j2832332496 [label="Did she know you two had fallen apart?",shape=box,color=red];
		j2832332496 -> j3589123309;
	j1888733057 [label="MomToxicated: Wouldn't blame her.",shape=box,color=blue];
		j1888733057 -> j3469037119;
	j3469037119 [label="+20 Chemistry",color=orange];
		j3469037119 -> "Chat ends. Next chat will be MinVelRank5Convo2.";
	j3589123309 [label="MomToxicated: She was perceptive. More than most. More than we'd trained her to be.",shape=box,color=blue];
		j3589123309 -> j1560915255;
	"Chat ends. Next chat will be MinVelRank5Convo2." [color=orange];
	j1560915255 [label="PapaPolar: the last time we spoke to her was on a secure line. ",shape=box,color=blue];
		j1560915255 -> j2324432063;
	j2324432063 [label="PapaPolar: and that weird lookin' little grease weasel of hers was probably listening in",shape=box,color=blue];
		j2324432063 -> j3866606018;
	j3866606018 [label="PapaPolar: at that point we were still *technically* together, but things were going south, fast...",shape=box,color=blue];
		j3866606018 -> j3199307315;
	j3199307315 [label="MomToxicated: I'd bet good money she knew. She could hear it. Even if we didn't know it at the time.",shape=box,color=blue];
		j3199307315 -> j3963073496;
		j3199307315 -> j3212418395;
	j3963073496 [label="Could you tell if she was... y'know. \"Him\" yet?",shape=box,color=red];
		j3963073496 -> j28920835;
	j3212418395 [label="What did you three talk about?",shape=box,color=red];
		j3212418395 -> j1052226903;
	j28920835 [label="PapaPolar: she sounded like our little girl, if that's what you're asking. knew what to say and how to say it.",shape=box,color=blue];
		j28920835 -> j4263845362;
	j1052226903 [label="MomToxicated: It started off business. How she was handling command. She couldn't give us numbers, or details, of course.",shape=box,color=blue];
		j1052226903 -> j2983404726;
	j4263845362 [label="MomToxicated: But all good hostage takers know how to make their captive birds sing on command.",shape=box,color=blue];
		j4263845362 -> j1794532776;
	j2983404726 [label="MomToxicated: We weren't Scaldra. Nothing more than civvies, to the people on the other end of the line. So she couldn't be giving us classified intel.",shape=box,color=blue];
		j2983404726 -> j917251947;
	j1794532776 [label="MomToxicated: That doesn't mean anything about when, or how, this \"Indifference\" took her.",shape=box,color=blue];
		j1794532776 -> j3947132261;
	j917251947 [label="PapaPolar: but she sounded... stressed. you could hear it.",shape=box,color=blue];
		j917251947 -> j4227352580;
		j917251947 -> j3243859303;
	j3947132261 [label="MomToxicated: Or who was driving her body when we spoke to her that day.",shape=box,color=blue];
		j3947132261 -> j18458673;
	j4227352580 [label="Her? Stressed? Hard to imagine.",shape=box,color=red];
		j4227352580 -> j3381987380;
	j3243859303 [label="Stressed about what?",shape=box,color=red];
		j3243859303 -> j1596134739;
	j18458673 [label="PapaPolar: i don't know how one finds a god and punches it in the [REDACTED] face but i'm gonna [REDACTED] try",shape=box,color=blue];
		j18458673 -> j917251947;
	j3381987380 [label="MomToxicated: Heh. Happens to the best of us. Especially when you're chasing a \"fugitive.\"",shape=box,color=blue];
		j3381987380 -> j421162357;
	j1596134739 [label="MomToxicated: A \"fugitive.\"",shape=box,color=blue];
		j1596134739 -> j421162357;
	j421162357 [label="MomToxicated: Entrati. At the time, I figured it was \"just\" a local drug lord or resistance leader.",shape=box,color=blue];
		j421162357 -> j3162416730;
	j3162416730 [label="PapaPolar: barely even mentioned the freakin' monster toaster tv zombies. you'd think that would've come up more.",shape=box,color=blue];
		j3162416730 -> j99878159;
	j99878159 [label="MomToxicated: I wonder if she had lost her arm yet at that point. No way to know, I suppose.",shape=box,color=blue];
		j99878159 -> j2093833345;
		j99878159 -> j2026769781;
	j2093833345 [label="How'd you end things?",shape=box,color=red];
		j2093833345 -> j361825443;
	j2026769781 [label="Did you tell her you were coming to Höllvania?",shape=box,color=red];
		j2026769781 -> j3105755325;
	j361825443 [label="MomToxicated: The way spies always end phone calls. By lying to each other.",shape=box,color=blue];
		j361825443 -> j670314707;
	j3105755325 [label="PapaPolar: lol. hells no. city was under lockdown, remember? total covert ops, us sneaking in.",shape=box,color=blue];
		j3105755325 -> j2851134631;
	j670314707 [label="MomToxicated: We told her we'd be going on a mission somewhere else, when we were planning on deploying into her locked-down city.",shape=box,color=blue];
		j670314707 -> j49702938;
	j2851134631 [label="MomToxicated: We ended the call the way spies always end phone calls. By lying.",shape=box,color=blue];
		j2851134631 -> j670314707;
	j49702938 [label="PapaPolar: and then we both told each other the biggest lie of all.",shape=box,color=blue];
		j49702938 -> j724431383;
	j724431383 [label="PapaPolar: we all said \"don't worry, we'll be fine.\"",shape=box,color=blue];
		j724431383 -> j3841602862;
	j3841602862 [label="MomToxicated: At least we did tell her one last truthful thing before we hung up.",shape=box,color=blue];
		j3841602862 -> j3403325113;
	j3403325113 [label="PapaPolar: yeah. we did.",shape=box,color=blue];
		j3403325113 -> j1723370509;
		j3403325113 -> j1817063463;
	j1723370509 [label="Oh?",shape=box,color=red];
		j1723370509 -> j2134117546;
	j1817063463 [label="Which was?",shape=box,color=red];
		j1817063463 -> j2134117546;
	j2134117546 [label="PapaPolar: \"You're our baby girl. And nothing will ever change that.\"",shape=box,color=blue];
		j2134117546 -> j3556020;
	j3556020 [label="MomToxicated: \"We'll always love you, no matter how far away you go.\"",shape=box,color=blue];
		j3556020 -> j848113030;
		j3556020 -> j1171434991;
	j848113030 [label="I'm sure she still knows that, no matter what's really happened to her.",shape=box,color=red];
		j848113030 -> j1779951525;
	j1171434991 [label="She was lucky to have you both as parents.",shape=box,color=red];
		j1171434991 -> j1779951525;
	j1779951525 [label="+10 Chemistry",color=orange];
		j1779951525 -> j211198773;
	j211198773 [label="PapaPolar: thanks.",shape=box,color=blue];
		j211198773 -> j3751085603;
	j3751085603 [label="+10 Chemistry",color=orange];
		j3751085603 -> j425371406;
	j425371406 [label="MomToxicated: I hope you're right.",shape=box,color=blue];
		j425371406 -> "Chat ends. Next chat will be MinVelRank5Convo2.";
