digraph {
	1481 [label="MinVelRank5Convo1 begins.",color=orange];
		1481 -> 1482;
	1482 [label="Check boolean MinVelTogether",color=orange];
		1482 -> 1483 [label=true,color=green];
		1482 -> 1484 [label=false,color=brown];
	1483 [label="MomToxicated: I can't help but wonder what Neci would think if she knew we were stuck here.",shape=box,color=blue];
		1483 -> 1485;
	1484 [label="MomToxicated: I can't help but wonder what Neci would think if she knew we were stuck here.",shape=box,color=blue];
		1484 -> 1486;
	1485 [label="PapaPolar: i hope she'd be happy to see we'd settled our issues.",shape=box,color=blue];
		1485 -> 1487;
		1485 -> 1488;
	1486 [label="PapaPolar: probably come back just to put us out of our misery.",shape=box,color=blue];
		1486 -> 1489;
	1487 [label="Yeah... who knows. [End.]",shape=box,color=red];
		1487 -> 1490;
	1488 [label="Did she know you two had fallen apart?",shape=box,color=red];
		1488 -> 1491;
	1489 [label="MomToxicated: Wouldn't blame her.",shape=box,color=blue];
		1489 -> 1492;
	1490 [label="+20 Chemistry",color=orange];
		1490 -> 1493;
	1491 [label="MomToxicated: She was perceptive. More than most. More than we'd trained her to be.",shape=box,color=blue];
		1491 -> 1494;
	1492 [label="+20 Chemistry",color=orange];
		1492 -> 1495;
	1493 [label="Chat ends. Next chat will be MinVelRank5Convo2.",color=orange];
	1494 [label="PapaPolar: the last time we spoke to her was on a secure line. ",shape=box,color=blue];
		1494 -> 1496;
	1495 [label="Chat ends. Next chat will be MinVelRank5Convo2.",color=orange];
	1496 [label="PapaPolar: and that weird lookin' little grease weasel of hers was probably listening in",shape=box,color=blue];
		1496 -> 1497;
	1497 [label="PapaPolar: at that point we were still *technically* together, but things were going south, fast...",shape=box,color=blue];
		1497 -> 1498;
	1498 [label="MomToxicated: I'd bet good money she knew. She could hear it. Even if we didn't know it at the time.",shape=box,color=blue];
		1498 -> 1499;
		1498 -> 1500;
	1499 [label="Could you tell if she was... y'know. \"Him\" yet?",shape=box,color=red];
		1499 -> 1501;
	1500 [label="What did you three talk about?",shape=box,color=red];
		1500 -> 1502;
	1501 [label="PapaPolar: she sounded like our little girl, if that's what you're asking. knew what to say and how to say it.",shape=box,color=blue];
		1501 -> 1503;
	1502 [label="MomToxicated: It started off business. How she was handling command. She couldn't give us numbers, or details, of course.",shape=box,color=blue];
		1502 -> 1504;
	1503 [label="MomToxicated: But all good hostage takers know how to make their captive birds sing on command.",shape=box,color=blue];
		1503 -> 1505;
	1504 [label="MomToxicated: We weren't Scaldra. Nothing more than civvies, to the people on the other end of the line. So she couldn't be giving us classified intel.",shape=box,color=blue];
		1504 -> 1506;
	1505 [label="MomToxicated: That doesn't mean anything about when, or how, this \"Indifference\" took her.",shape=box,color=blue];
		1505 -> 1507;
	1506 [label="PapaPolar: but she sounded... stressed. you could hear it.",shape=box,color=blue];
		1506 -> 1508;
		1506 -> 1509;
	1507 [label="MomToxicated: Or who was driving her body when we spoke to her that day.",shape=box,color=blue];
		1507 -> 1510;
	1508 [label="Her? Stressed? Hard to imagine.",shape=box,color=red];
		1508 -> 1511;
	1509 [label="Stressed about what?",shape=box,color=red];
		1509 -> 1512;
	1510 [label="PapaPolar: i don't know how one finds a god and punches it in the [REDACTED] face but i'm gonna [REDACTED] try",shape=box,color=blue];
		1510 -> 1506;
	1511 [label="MomToxicated: Heh. Happens to the best of us. Especially when you're chasing a \"fugitive.\"",shape=box,color=blue];
		1511 -> 1513;
	1512 [label="MomToxicated: A \"fugitive.\"",shape=box,color=blue];
		1512 -> 1513;
	1513 [label="MomToxicated: Entrati. At the time, I figured it was \"just\" a local drug lord or resistance leader.",shape=box,color=blue];
		1513 -> 1514;
	1514 [label="PapaPolar: barely even mentioned the freakin' monster toaster tv zombies. you'd think that would've come up more.",shape=box,color=blue];
		1514 -> 1515;
	1515 [label="MomToxicated: I wonder if she had lost her arm yet at that point. No way to know, I suppose.",shape=box,color=blue];
		1515 -> 1516;
		1515 -> 1517;
	1516 [label="How'd you end things?",shape=box,color=red];
		1516 -> 1518;
	1517 [label="Did you tell her you were coming to Höllvania?",shape=box,color=red];
		1517 -> 1519;
	1518 [label="MomToxicated: The way spies always end phone calls. By lying to each other.",shape=box,color=blue];
		1518 -> 1520;
	1519 [label="PapaPolar: lol. hells no. city was under lockdown, remember? total covert ops, us sneaking in.",shape=box,color=blue];
		1519 -> 1521;
	1520 [label="MomToxicated: We told her we'd be going on a mission somewhere else, when we were planning on deploying into her locked-down city.",shape=box,color=blue];
		1520 -> 1522;
	1521 [label="MomToxicated: We ended the call the way spies always end phone calls. By lying.",shape=box,color=blue];
		1521 -> 1520;
	1522 [label="PapaPolar: and then we both told each other the biggest lie of all.",shape=box,color=blue];
		1522 -> 1523;
	1523 [label="PapaPolar: we all said \"don't worry, we'll be fine.\"",shape=box,color=blue];
		1523 -> 1524;
	1524 [label="MomToxicated: At least we did tell her one last truthful thing before we hung up.",shape=box,color=blue];
		1524 -> 1525;
	1525 [label="PapaPolar: yeah. we did.",shape=box,color=blue];
		1525 -> 1526;
		1525 -> 1527;
	1526 [label="Oh?",shape=box,color=red];
		1526 -> 1528;
	1527 [label="Which was?",shape=box,color=red];
		1527 -> 1528;
	1528 [label="PapaPolar: \"You're our baby girl. And nothing will ever change that.\"",shape=box,color=blue];
		1528 -> 1529;
	1529 [label="MomToxicated: \"We'll always love you, no matter how far away you go.\"",shape=box,color=blue];
		1529 -> 1530;
		1529 -> 1531;
	1530 [label="I'm sure she still knows that, no matter what's really happened to her.",shape=box,color=red];
		1530 -> 1532;
	1531 [label="She was lucky to have you both as parents.",shape=box,color=red];
		1531 -> 1532;
	1532 [label="+10 Chemistry",color=orange];
		1532 -> 1533;
	1533 [label="PapaPolar: thanks.",shape=box,color=blue];
		1533 -> 1534;
	1534 [label="+10 Chemistry",color=orange];
		1534 -> 1535;
	1535 [label="MomToxicated: I hope you're right.",shape=box,color=blue];
		1535 -> 1536;
	1536 [label="Chat ends. Next chat will be MinVelRank5Convo2.",color=orange];
}