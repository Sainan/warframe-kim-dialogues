	edge [fontname="Roboto Condensed"];

	"MinVelRank1Convo3 begins." [color=orange];
		"MinVelRank1Convo3 begins." -> j1443093862;
	j1443093862 [label="MomToxicated: Drifter. Can we talk?",shape=box,color=blue];
		j1443093862 -> j2608962349;
		j1443093862 -> j1108964078;
		j1443093862 -> j637640821;
		j1443093862 -> j1930371320;
	j2608962349 [label="G'morning, Minerva. If that is your real name.",shape=box,color=red];
		j2608962349 -> j265431232;
	j1108964078 [label="We've dropped the \"quotes\", I see.",shape=box,color=red];
		j1108964078 -> j2258223472;
	j637640821 [label="Now you're asking?",shape=box,color=red];
		j637640821 -> j2258223472;
	j1930371320 [label="Yeah?",shape=box,color=red];
		j1930371320 -> j1644294953;
	j265431232 [label="+5 Chemistry",color=orange];
		j265431232 -> j3991922425;
	j2258223472 [label="MomToxicated: I was lectured about my so-called bedside manner.",shape=box,color=blue];
		j2258223472 -> j3650488538;
	j1644294953 [label="+5 Chemistry",color=orange];
		j1644294953 -> j4135116944;
	j3991922425 [label="MomToxicated: Believe it or not, it is.",shape=box,color=blue];
		j3991922425 -> j935222474;
	j3650488538 [label="MomToxicated: Which is hysterical, all things considered.",shape=box,color=blue];
		j3650488538 -> j1762006996;
	j4135116944 [label="MomToxicated: Right to the chase. Good.",shape=box,color=blue];
		j4135116944 -> j1762006996;
	j935222474 [label="MomToxicated: But that's not the point.",shape=box,color=blue];
		j935222474 -> j1762006996;
	j1762006996 [label="MomToxicated: We're here in Höllvania with a problem to solve. And you can help me solve that problem.",shape=box,color=blue];
		j1762006996 -> j2862732985;
	j2862732985 [label="MomToxicated: So I need you - and this is me asking - to help me.",shape=box,color=blue];
		j2862732985 -> j3997286208;
		j2862732985 -> j4084232984;
		j2862732985 -> j4179255953;
	j3997286208 [label="What is the problem I'm supposed to be solving?",shape=box,color=red];
		j3997286208 -> j2868266998;
	j4084232984 [label="Why should I help you?",shape=box,color=red];
		j4084232984 -> j2868266998;
	j4179255953 [label="And what does this have to do with Rusalka?",shape=box,color=red];
		j4179255953 -> j2868266998;
	j2868266998 [label="MomToxicated: That is a very good question.",shape=box,color=blue];
		j2868266998 -> j4136039149;
	j4136039149 [label="MomToxicated: You don't have to want to help me for my sake. We have a common enemy. This \"Man in the Wall.\"",shape=box,color=blue];
		j4136039149 -> j1126466904;
	j1126466904 [label="MomToxicated: As far as I can figure, we're both interested in where he's gone, what he's after, and why he targeted Rusalka in the first place.",shape=box,color=blue];
		j1126466904 -> j1592221077;
	j1592221077 [label="MomToxicated: Am I correct in that assessment?",shape=box,color=blue];
		j1592221077 -> j1244469894;
		j1592221077 -> j2647610061;
		j1592221077 -> j2056759131;
	j1244469894 [label="Can you back up and take a minute to explain to me why you care about Rusalka so much?",shape=box,color=red];
		j1244469894 -> j573259736;
	j2647610061 [label="For the first two, yeah. I don't actually really care two shits about why he went after Rusalka.",shape=box,color=red];
		j2647610061 -> j787185143;
	j2056759131 [label="Sure. Yeah. That's correct.",shape=box,color=red];
		j2056759131 -> j4116038899;
	j573259736 [label="MomToxicated: The why isn't important.",shape=box,color=blue];
		j573259736 -> j1092760199;
	j787185143 [label="MomToxicated: If you aren't at least mildly interested in her well-being, why spare her life like we know you did? We heard the story.",shape=box,color=blue];
		j787185143 -> j2410257606;
		j787185143 -> j4085616820;
		j787185143 -> j3515431791;
	j4116038899 [label="I hate to break it to you, but we're probably stuck waiting until the Man in the Wall makes his next move.",shape=box,color=red];
		j4116038899 -> j2590003669;
	j1092760199 [label="PapaPolar: it is, though. and they've probably worked it out already, anyway. it's not like we're exactly subtle",shape=box,color=blue];
		j1092760199 -> j326849050;
	j2410257606 [label="Because then I'd have been no different than the Indifference. Than Scaldra. Than Entrati. I don't go around senselessly murdering people.",shape=box,color=red];
		j2410257606 -> j634874136;
	j4085616820 [label="Because it wasn't really her making the choices that led her to that point. Just because I wouldn't kill her for it in the moment, doesn't mean I *care* enough to go out of my way to save her.",shape=box,color=red];
		j4085616820 -> j3951379023;
	j3515431791 [label="Because I wasn't about to do Entrati's dirty work for him. If he wanted to kill the Indifference's new puppet, he could do it himself.",shape=box,color=red];
		j3515431791 -> j2710541999;
	j2590003669 [label="MomToxicated: And why is that? You have no way of tracking him? It? Whatever it is? Or do you not know what it's really after?",shape=box,color=blue];
		j2590003669 -> j3511476508;
		j2590003669 -> j178985928;
	j326849050 [label="PapaPolar: and maybe, *just maybe* if you trusted our new lil buddy here with a little bit of information, they might be more willing to *heeeeelp uuuuuus*",shape=box,color=blue];
		j326849050 -> j3685051437;
	j634874136 [label="Which implies that I purposefully murder people. Which I don't. I mean. I do kill people. But it's different. You know what I mean.",shape=box,color=red];
		j634874136 -> j2855495730;
	j3951379023 [label="I didn't *know* her.",shape=box,color=red];
		j3951379023 -> j2553761133;
	j2710541999 [label="But just as I suspected, the old bastard only likes to shoot people he knows will get back up.",shape=box,color=red];
		j2710541999 -> j2364946716;
	j3511476508 [label="Can't exactly slap a tracking beacon on a demigod-god-thing, no.",shape=box,color=red];
		j3511476508 -> j3554273805;
	j178985928 [label="His motivations are a bit lost on us at the moment, yeah. But it's nothing good.",shape=box,color=red];
		j178985928 -> j3554273805;
	j3685051437 [label="PapaPolar: it's almost like that's how people work sometimes. ",shape=box,color=blue];
		j3685051437 -> j1018126621;
	j2855495730 [label="+5 Chemistry",color=orange];
		j2855495730 -> j1791981683;
	j2553761133 [label="PapaPolar: and we're not exactly giving you a reason to care. are we, M?",shape=box,color=blue];
		j2553761133 -> j944260778;
	j2364946716 [label="PapaPolar: a very oddly specific statement but okay",shape=box,color=blue];
		j2364946716 -> j3302977596;
		j2364946716 -> j2729552440;
	j3554273805 [label="MomToxicated: So you're suggesting we sit. And wait. For it to... what. Pop its head up? And we play a round of Whack-A-Weasel?!",shape=box,color=blue];
		j3554273805 -> j2737920194;
	j1018126621 [label="MomToxicated: What good would it do?",shape=box,color=blue];
		j1018126621 -> j3800587535;
	j1791981683 [label="PapaPolar: you're talking to a pair of ex-military special ops, we get it. lol",shape=box,color=blue];
		j1791981683 -> j3680620185;
	j944260778 [label="MomToxicated: Shut it, Velimir.",shape=box,color=blue];
		j944260778 -> j573259736;
	j3302977596 [label="It's fine. I die a lot. I'm used to it.",shape=box,color=red];
		j3302977596 -> j17356323;
	j2729552440 [label="It doesn't really matter.",shape=box,color=red];
		j2729552440 -> j4116038899;
		j2729552440 -> j2398930226;
	j2737920194 [label="PapaPolar: at least this place has good company and a nice bar?",shape=box,color=blue];
		j2737920194 -> j4257678708;
	j3800587535 [label="PapaPolar: doesn't hurt to have friends in this world, M.",shape=box,color=blue];
		j3800587535 -> j4074619233;
	j3680620185 [label="PapaPolar: what we have to do in the name of the \"greater good\" gets blurry sometimes",shape=box,color=blue];
		j3680620185 -> j2381215934;
	j17356323 [label="PapaPolar: oookie dokie... sure, lil buddy... sure...",shape=box,color=blue];
		j17356323 -> j1689203810;
	j2398930226 [label="Why are you so desperate to learn what happened to Rusalka?",shape=box,color=red];
		j2398930226 -> j573259736;
	j4257678708 [label="PapaPolar: music is pretty good. that arthur guy seems like my kinda drinking buddy",shape=box,color=blue];
		j4257678708 -> j3407634611;
	j4074619233 [label="MomToxicated: What do we need \"friends\" for?! We'll be out of here as soon as we know where we need to be to save Neci.",shape=box,color=blue];
		j4074619233 -> j2940485056;
	j2381215934 [label="PapaPolar: which is why, when we can do something that matters, we do it. which is why we're here trying to save neci",shape=box,color=blue];
		j2381215934 -> j4116038899;
		j2381215934 -> j2398930226;
	j1689203810 [label="PapaPolar: anyway...",shape=box,color=blue];
		j1689203810 -> j4116038899;
		j1689203810 -> j2398930226;
	j3407634611 [label="MomToxicated: And, what, we just go on with not knowing what's really happened to her?! Or if she's okay?! Or if she's really her anymore?!",shape=box,color=blue];
		j3407634611 -> j1442961474;
	j2940485056 [label="PapaPolar: dunno about that. seems like it's gonna be hard to predict the movements of a demigod void monster... thingy. amirite, lil buddy?",shape=box,color=blue];
		j2940485056 -> j178985928;
		j2940485056 -> j3511476508;
	j1442961474 [label="MomToxicated: How can you sit there and be OKAY with that, Velimir?!",shape=box,color=blue];
		j1442961474 -> j503904885;
	j503904885 [label="PapaPolar: i never said i was okay with it, M! i just understand when we have to sit and bide our time!",shape=box,color=blue];
		j503904885 -> j3804052371;
	j3804052371 [label="MomToxicated: I've talked to Eleanor. She told me what she felt when she touched Neci's mind. Or what was left of it.",shape=box,color=blue];
		j3804052371 -> j2768733132;
	j2768733132 [label="MomToxicated: The woman we raised. The woman we loved as our own.",shape=box,color=blue];
		j2768733132 -> j338254703;
	j338254703 [label="MomToxicated: Who knows what - ",shape=box,color=blue];
		j338254703 -> j3122582776;
	j3122582776 [label="MomToxicated: And you want to talk about drinking with Arthur.",shape=box,color=blue];
		j3122582776 -> j794567701;
	j794567701 [label="MomToxicated: Du-te dracu, Velimir.",shape=box,color=blue];
		j794567701 -> j527925381;
	j527925381 [label="PapaPolar: aaaaaand she's off...",shape=box,color=blue];
		j527925381 -> j2560379249;
		j527925381 -> j2094099037;
	j2560379249 [label="What'd she say...?",shape=box,color=red];
		j2560379249 -> j2259730985;
	j2094099037 [label="Gonna guess that was rude language.",shape=box,color=red];
		j2094099037 -> j983890413;
	j2259730985 [label="PapaPolar: joy of having been stationed on so many overseas ops. getting cussed out in 100 different languages",shape=box,color=blue];
		j2259730985 -> j3284780661;
		j2259730985 -> j834045179;
	j983890413 [label="PapaPolar: yeah. joy of having been stationed on so many overseas ops. getting cussed out in 100 different languages",shape=box,color=blue];
		j983890413 -> j3284780661;
		j983890413 -> j834045179;
	j3284780661 [label="Are you two... married?",shape=box,color=red];
		j3284780661 -> j1269960735;
	j834045179 [label="You two... raised... Rusalka?",shape=box,color=red];
		j834045179 -> j1737270665;
	j1269960735 [label="Boolean MinervaVelimir1 is now true.",color=orange];
		j1269960735 -> j1269985799;
	j1737270665 [label="Boolean MinervaNeci3a is now true.",color=orange];
		j1737270665 -> j2561585740;
	j1269985799 [label="PapaPolar: mmm. kinda. not really anymore. on paper only. somewhere. in some country that stopped existing circa 1982?",shape=box,color=blue];
		j1269985799 -> j3428870577;
	j2561585740 [label="PapaPolar: more or less. we were overseas in a lil town a few countries south of here. place got blown to bits. found her there in a building, all red hair and aaaaaangry.",shape=box,color=blue];
		j2561585740 -> j4149278766;
	j3428870577 [label="PapaPolar: does that count?",shape=box,color=blue];
		j3428870577 -> j2376939061;
		j3428870577 -> j890907450;
	j4149278766 [label="PapaPolar: she tried to stab me six times with a spoon bahahaha cutest lil thing you've ever seen.",shape=box,color=blue];
		j4149278766 -> j686305401;
	j2376939061 [label="Yeah, doesn't seem like you two are still together.",shape=box,color=red];
		j2376939061 -> j576741835;
	j890907450 [label="That explains the arguing I guess.",shape=box,color=red];
		j890907450 -> j2983703078;
	j686305401 [label="PapaPolar: had this little stuffed rabbit toy she was clinging to, though. M told her she'd protect it with her life 'n keep it safe.",shape=box,color=blue];
		j686305401 -> j1948684473;
	j576741835 [label="PapaPolar: what gave it away.",shape=box,color=blue];
		j576741835 -> j2983703078;
	j2983703078 [label="PapaPolar: when neci left to go join scaldra... things weren't ever the same between us. it was the last straw, i think.",shape=box,color=blue];
		j2983703078 -> j2459821256;
	j1948684473 [label="PapaPolar: that got neci's trust real fast. ran right for M and threw her arms around her. we quit the military then. well. officially. became \"consultants.\"",shape=box,color=blue];
		j1948684473 -> j2220832552;
	j2459821256 [label="PapaPolar: sigh.",shape=box,color=blue];
		j2459821256 -> j90881465;
	j2220832552 [label="PapaPolar: so... yeah. you could say we raised her.",shape=box,color=blue];
		j2220832552 -> j90881465;
	j90881465 [label="PapaPolar: alright, gotta go do what i do best.",shape=box,color=blue];
		j90881465 -> j719545298;
	j719545298 [label="PapaPolar: pretend i know what i said wrong and pretend i'll not screw up again like that in the future.",shape=box,color=blue];
		j719545298 -> j2017522426;
	j2017522426 [label="+20 Chemistry",color=orange];
		j2017522426 -> "Chat ends. Next chat will be MinVelRank2Convo1.";
	"Chat ends. Next chat will be MinVelRank2Convo1." [color=orange];
