digraph {
	179 [label="MinVelRank1Convo3 begins.",color=orange];
		179 -> 180;
	180 [label="MomToxicated: Drifter. Can we talk?",shape=box,color=blue];
		180 -> 181;
		180 -> 182;
		180 -> 183;
		180 -> 184;
	181 [label="G'morning, Minerva. If that is your real name.",shape=box,color=red];
		181 -> 185;
	182 [label="We've dropped the \"quotes\", I see.",shape=box,color=red];
		182 -> 186;
	183 [label="Now you're asking?",shape=box,color=red];
		183 -> 186;
	184 [label="Yeah?",shape=box,color=red];
		184 -> 187;
	185 [label="+5 Chemistry",color=orange];
		185 -> 188;
	186 [label="MomToxicated: I was lectured about my so-called bedside manner.",shape=box,color=blue];
		186 -> 189;
	187 [label="+5 Chemistry",color=orange];
		187 -> 190;
	188 [label="MomToxicated: Believe it or not, it is.",shape=box,color=blue];
		188 -> 191;
	189 [label="MomToxicated: Which is hysterical, all things considered.",shape=box,color=blue];
		189 -> 192;
	190 [label="MomToxicated: Right to the chase. Good.",shape=box,color=blue];
		190 -> 192;
	191 [label="MomToxicated: But that's not the point.",shape=box,color=blue];
		191 -> 192;
	192 [label="MomToxicated: We're here in Höllvania with a problem to solve. And you can help me solve that problem.",shape=box,color=blue];
		192 -> 193;
	193 [label="MomToxicated: So I need you - and this is me asking - to help me.",shape=box,color=blue];
		193 -> 194;
		193 -> 195;
		193 -> 196;
	194 [label="What is the problem I'm supposed to be solving?",shape=box,color=red];
		194 -> 197;
	195 [label="Why should I help you?",shape=box,color=red];
		195 -> 197;
	196 [label="And what does this have to do with Rusalka?",shape=box,color=red];
		196 -> 197;
	197 [label="MomToxicated: That is a very good question.",shape=box,color=blue];
		197 -> 198;
	198 [label="MomToxicated: You don't have to want to help me for my sake. We have a common enemy. This \"Man in the Wall.\"",shape=box,color=blue];
		198 -> 199;
	199 [label="MomToxicated: As far as I can figure, we're both interested in where he's gone, what he's after, and why he targeted Rusalka in the first place.",shape=box,color=blue];
		199 -> 200;
	200 [label="MomToxicated: Am I correct in that assessment?",shape=box,color=blue];
		200 -> 201;
		200 -> 202;
		200 -> 203;
	201 [label="Can you back up and take a minute to explain to me why you care about Rusalka so much?",shape=box,color=red];
		201 -> 204;
	202 [label="For the first two, yeah. I don't actually really care two shits about why he went after Rusalka.",shape=box,color=red];
		202 -> 205;
	203 [label="Sure. Yeah. That's correct.",shape=box,color=red];
		203 -> 206;
	204 [label="MomToxicated: The why isn't important.",shape=box,color=blue];
		204 -> 207;
	205 [label="MomToxicated: If you aren't at least mildly interested in her well-being, why spare her life like we know you did? We heard the story.",shape=box,color=blue];
		205 -> 208;
		205 -> 209;
		205 -> 210;
	206 [label="I hate to break it to you, but we're probably stuck waiting until the Man in the Wall makes his next move.",shape=box,color=red];
		206 -> 211;
	207 [label="PapaPolar: it is, though. and they've probably worked it out already, anyway. it's not like we're exactly subtle",shape=box,color=blue];
		207 -> 212;
	208 [label="Because then I'd have been no different than the Indifference. Than Scaldra. Than Entrati. I don't go around senselessly murdering people.",shape=box,color=red];
		208 -> 213;
	209 [label="Because it wasn't really her making the choices that led her to that point. Just because I wouldn't kill her for it in the moment, doesn't mean I *care* enough to go out of my way to save her.",shape=box,color=red];
		209 -> 214;
	210 [label="Because I wasn't about to do Entrati's dirty work for him. If he wanted to kill the Indifference's new puppet, he could do it himself.",shape=box,color=red];
		210 -> 215;
	211 [label="MomToxicated: And why is that? You have no way of tracking him? It? Whatever it is? Or do you not know what it's really after?",shape=box,color=blue];
		211 -> 216;
		211 -> 217;
	212 [label="PapaPolar: and maybe, *just maybe* if you trusted our new lil buddy here with a little bit of information, they might be more willing to *heeeeelp uuuuuus*",shape=box,color=blue];
		212 -> 218;
	213 [label="Which implies that I purposefully murder people. Which I don't. I mean. I do kill people. But it's different. You know what I mean.",shape=box,color=red];
		213 -> 219;
	214 [label="I didn't *know* her.",shape=box,color=red];
		214 -> 220;
	215 [label="But just as I suspected, the old bastard only likes to shoot people he knows will get back up.",shape=box,color=red];
		215 -> 221;
	216 [label="Can't exactly slap a tracking beacon on a demigod-god-thing, no.",shape=box,color=red];
		216 -> 222;
	217 [label="His motivations are a bit lost on us at the moment, yeah. But it's nothing good.",shape=box,color=red];
		217 -> 222;
	218 [label="PapaPolar: it's almost like that's how people work sometimes. ",shape=box,color=blue];
		218 -> 223;
	219 [label="+5 Chemistry",color=orange];
		219 -> 224;
	220 [label="PapaPolar: and we're not exactly giving you a reason to care. are we, M?",shape=box,color=blue];
		220 -> 225;
	221 [label="PapaPolar: a very oddly specific statement but okay",shape=box,color=blue];
		221 -> 226;
		221 -> 227;
	222 [label="MomToxicated: So you're suggesting we sit. And wait. For it to... what. Pop its head up? And we play a round of Whack-A-Weasel?!",shape=box,color=blue];
		222 -> 228;
	223 [label="MomToxicated: What good would it do?",shape=box,color=blue];
		223 -> 229;
	224 [label="PapaPolar: you're talking to a pair of ex-military special ops, we get it. lol",shape=box,color=blue];
		224 -> 230;
	225 [label="MomToxicated: Shut it, Velimir.",shape=box,color=blue];
		225 -> 204;
	226 [label="It's fine. I die a lot. I'm used to it.",shape=box,color=red];
		226 -> 231;
	227 [label="It doesn't really matter.",shape=box,color=red];
		227 -> 206;
		227 -> 232;
	228 [label="PapaPolar: at least this place has good company and a nice bar?",shape=box,color=blue];
		228 -> 233;
	229 [label="PapaPolar: doesn't hurt to have friends in this world, M.",shape=box,color=blue];
		229 -> 234;
	230 [label="PapaPolar: what we have to do in the name of the \"greater good\" gets blurry sometimes",shape=box,color=blue];
		230 -> 235;
	231 [label="PapaPolar: oookie dokie... sure, lil buddy... sure...",shape=box,color=blue];
		231 -> 236;
	232 [label="Why are you so desperate to learn what happened to Rusalka?",shape=box,color=red];
		232 -> 204;
	233 [label="PapaPolar: music is pretty good. that arthur guy seems like my kinda drinking buddy",shape=box,color=blue];
		233 -> 237;
	234 [label="MomToxicated: What do we need \"friends\" for?! We'll be out of here as soon as we know where we need to be to save Neci.",shape=box,color=blue];
		234 -> 238;
	235 [label="PapaPolar: which is why, when we can do something that matters, we do it. which is why we're here trying to save neci",shape=box,color=blue];
		235 -> 206;
		235 -> 232;
	236 [label="PapaPolar: anyway...",shape=box,color=blue];
		236 -> 206;
		236 -> 232;
	237 [label="MomToxicated: And, what, we just go on with not knowing what's really happened to her?! Or if she's okay?! Or if she's really her anymore?!",shape=box,color=blue];
		237 -> 239;
	238 [label="PapaPolar: dunno about that. seems like it's gonna be hard to predict the movements of a demigod void monster... thingy. amirite, lil buddy?",shape=box,color=blue];
		238 -> 217;
		238 -> 216;
	239 [label="MomToxicated: How can you sit there and be OKAY with that, Velimir?!",shape=box,color=blue];
		239 -> 240;
	240 [label="PapaPolar: i never said i was okay with it, M! i just understand when we have to sit and bide our time!",shape=box,color=blue];
		240 -> 241;
	241 [label="MomToxicated: I've talked to Eleanor. She told me what she felt when she touched Neci's mind. Or what was left of it.",shape=box,color=blue];
		241 -> 242;
	242 [label="MomToxicated: The woman we raised. The woman we loved as our own.",shape=box,color=blue];
		242 -> 243;
	243 [label="MomToxicated: Who knows what - ",shape=box,color=blue];
		243 -> 244;
	244 [label="MomToxicated: And you want to talk about drinking with Arthur.",shape=box,color=blue];
		244 -> 245;
	245 [label="MomToxicated: Du-te dracu, Velimir.",shape=box,color=blue];
		245 -> 246;
	246 [label="PapaPolar: aaaaaand she's off...",shape=box,color=blue];
		246 -> 247;
		246 -> 248;
	247 [label="What'd she say...?",shape=box,color=red];
		247 -> 249;
	248 [label="Gonna guess that was rude language.",shape=box,color=red];
		248 -> 250;
	249 [label="PapaPolar: joy of having been stationed on so many overseas ops. getting cussed out in 100 different languages",shape=box,color=blue];
		249 -> 251;
		249 -> 252;
	250 [label="PapaPolar: yeah. joy of having been stationed on so many overseas ops. getting cussed out in 100 different languages",shape=box,color=blue];
		250 -> 251;
		250 -> 252;
	251 [label="Are you two... married?",shape=box,color=red];
		251 -> 253;
	252 [label="You two... raised... Rusalka?",shape=box,color=red];
		252 -> 254;
	253 [label="Update boolean MinervaVelimir1",color=orange];
		253 -> 255;
	254 [label="Update boolean MinervaNeci3a",color=orange];
		254 -> 256;
	255 [label="PapaPolar: mmm. kinda. not really anymore. on paper only. somewhere. in some country that stopped existing circa 1982?",shape=box,color=blue];
		255 -> 257;
	256 [label="PapaPolar: more or less. we were overseas in a lil town a few countries south of here. place got blown to bits. found her there in a building, all red hair and aaaaaangry.",shape=box,color=blue];
		256 -> 258;
	257 [label="PapaPolar: does that count?",shape=box,color=blue];
		257 -> 259;
		257 -> 260;
	258 [label="PapaPolar: she tried to stab me six times with a spoon bahahaha cutest lil thing you've ever seen.",shape=box,color=blue];
		258 -> 261;
	259 [label="Yeah, doesn't seem like you two are still together.",shape=box,color=red];
		259 -> 262;
	260 [label="That explains the arguing I guess.",shape=box,color=red];
		260 -> 263;
	261 [label="PapaPolar: had this little stuffed rabbit toy she was clinging to, though. M told her she'd protect it with her life 'n keep it safe.",shape=box,color=blue];
		261 -> 264;
	262 [label="PapaPolar: what gave it away.",shape=box,color=blue];
		262 -> 263;
	263 [label="PapaPolar: when neci left to go join scaldra... things weren't ever the same between us. it was the last straw, i think.",shape=box,color=blue];
		263 -> 265;
	264 [label="PapaPolar: that got neci's trust real fast. ran right for M and threw her arms around her. we quit the military then. well. officially. became \"consultants.\"",shape=box,color=blue];
		264 -> 266;
