	j1403870093 [label="Ayatan Sculptures are ancient Orokin artifacts that are associated with the ritual of Orokin \"Continuity.\"",shape=box,color=red];
		j1403870093 -> j4112023452;
		j1403870093 -> j4080024591;
	j2141720277 [label="Ayatan Sculptures are used to store the favorite memories of the Orokin...",shape=box,color=red];
		j2141720277 -> j2082264928;
		j2141720277 -> j1051410088;
	j4112023452 [label="Which we... won't get into now, because that's a whole different can of evil worms.",shape=box,color=red];
		j4112023452 -> j1470357277;
	j4080024591 [label="Continuity is the ritual that the Orokin would use to transfer their consciousness into another body.",shape=box,color=red];
		j4080024591 -> j1424404278;
	j2082264928 [label="They thought they were gods. Their favorite memories were often ones of torture, whippings, massacres... executions.",shape=box,color=red];
		j2082264928 -> j3812896383;
	j1051410088 [label="When you live forever, and you can just put your consciousness into another body whenever you want...",shape=box,color=red];
