digraph {
	2845 [label="EleanorRank6Convo2 begins.",color=orange];
		2845 -> 2846;
	2846 [label="Hey. Need to bounce some ideas off you.",shape=box,color=blue];
		2846 -> 2847;
	2847 [label="Thinking about Fiendsnight. I haven’t dressed up for it for years, but I was leafing through one of Amir’s comics and I suddenly thought - hold on, I could be the Contessa! I’ve got the fangs for it and everything!",shape=box,color=blue];
		2847 -> 2848;
	2848 [label="But is that too obvious? Should I be Dandy Damage?",shape=box,color=blue];
		2848 -> 2849;
		2848 -> 2850;
		2848 -> 2851;
	2849 [label="Who's Dandy Damage?",shape=box,color=red];
		2849 -> 2852;
	2850 [label="You could always dress up as the Lotus, if you wanted to confuse people.",shape=box,color=red];
		2850 -> 2853;
	2851 [label="… you’re going to have to tell me what Fiendsnight is.",shape=box,color=red];
		2851 -> 2854;
	2852 [label="Oh mate. ",shape=box,color=blue];
		2852 -> 2855;
	2853 [label="Oh Gods no. I've seen her in your head. I could never do her justice.",shape=box,color=blue];
		2853 -> 2856;
	2854 [label="Mmm. I forget you're an innocent abroad, sometimes. ",shape=box,color=blue];
		2854 -> 2857;
	2855 [label="Dandy Damage walked so that Temple and the Rippers could run. He was every mother's nightmare and every teenage catastrophe's dream.",shape=box,color=blue];
		2855 -> 2858;
	2856 [label="And that helmet. Is it a helmet? Is it part of her? How does she see through it?",shape=box,color=blue];
		2856 -> 2859;
	2857 [label="Fiendsnight celebrates the fading of Sol's influence on the world.",shape=box,color=blue];
		2857 -> 2860;
	2858 [label="Built like a stick insect, made up like a silent movie queen. Mouth like candy. Pinstripes and leather and dog chain. Cheekbones like a skeleton's hips.",shape=box,color=blue];
		2858 -> 2861;
		2858 -> 2862;
	2859 [label="Anyway, there's three of her in the one body. I could never pick one of them over the others.",shape=box,color=blue];
		2859 -> 2861;
		2859 -> 2862;
	2860 [label="Which doesn't make a lot of sense on the face of it. Why celebrate the rising dark? Why rejoice in lawlessness and anarchy?",shape=box,color=blue];
		2860 -> 2863;
	2861 [label="Dressing up in costumes? Partying? In a war zone? Do you really think that's going to happen?",shape=box,color=red];
		2861 -> 2864;
	2862 [label="You know, Fiendsnight sounds a lot like Naberus. People like to dress up for that, too.",shape=box,color=red];
		2862 -> 2864;
	2863 [label="I think it's like an inoculation, maybe. A tiny bit of the thing we fear, to strengthen us. Or maybe it's just an excuse to put on the devil's mask and raise hell.",shape=box,color=blue];
		2863 -> 2861;
		2863 -> 2862;
	2864 [label="... I'm probably just being silly. Childish. Aren't I?",shape=box,color=blue];
		2864 -> 2865;
	2865 [label="Oh, what am I thinking.",shape=box,color=blue];
		2865 -> 2866;
	2866 [label="I don't need to dress up, do I? I'm already a monster. Forever and ever.",shape=box,color=blue];
		2866 -> 2867;
	2867 [label="Check boolean EleanorDating",color=orange];
		2867 -> 2868 [label=true,color=green];
		2867 -> 2869 [label=true,color=green];
		2867 -> 2870 [label=true,color=green];
		2867 -> 2869 [label=false,color=brown];
		2867 -> 2870 [label=false,color=brown];
	2868 [label="You're the monster that I love, Eleanor.  I don't regret a thing.",shape=box,color=red];
		2868 -> 2871;
	2869 [label="I'm starting to think you enjoy saying that about yourself.",shape=box,color=red];
		2869 -> 2872;
	2870 [label="No. Real monsters don't care for people the way that you do.",shape=box,color=red];
		2870 -> 2873;
	2871 [label="+5 Chemistry",color=orange];
		2871 -> 2874;
	2872 [label="If that's what you really believe you are, then Fiendsnight is the perfect chance to celebrate it.",shape=box,color=red];
		2872 -> 2875;
		2872 -> 2873;
	2873 [label="I know you're scared of what you might become. But that's not you NOW.",shape=box,color=red];
		2873 -> 2876;
	2874 [label="Oh yes! Silly me. I forgot the monster got the happy ending in our little story.",shape=box,color=blue];
		2874 -> 2877;
	2875 [label="BE the monster. Own it. For this one night of the year, wear that title with pride.",shape=box,color=red];
		2875 -> 2878;
	2876 [label="So dress up. Have fun. Void knows the Hex could all use some.",shape=box,color=red];
		2876 -> 2879;
	2877 [label="Forgive me. I still can't quite believe that this is what you actually WANT. Maybe I just need a tiny bit more convincing.",shape=box,color=blue];
		2877 -> 2880;
	2878 [label="Oh there are SO MANY reasons why that is a TERRIBLE IDEA",shape=box,color=blue];
		2878 -> 2881;
	2879 [label="I'll take you up on that. And thank you. Once again. x",shape=box,color=blue];
		2879 -> 2882;
	2880 [label="Let's devour one another later. xxx",shape=box,color=blue];
		2880 -> 2883;
	2881 [label="SO. MANY.",shape=box,color=blue];
		2881 -> 2884;
	2882 [label="Chat ends.",color=orange];
	2883 [label="Chat ends.",color=orange];
	2884 [label="(I can't think of any right now but I'm sure there are DOZENS)",shape=box,color=blue];
		2884 -> 2885;
	2885 [label="... shit.",shape=box,color=blue];
		2885 -> 2886;
	2886 [label="you have skewered me most nimbly upon my own kebab. damn you. well done. x",shape=box,color=blue];
		2886 -> 2887;
	2887 [label="Chat ends.",color=orange];
}