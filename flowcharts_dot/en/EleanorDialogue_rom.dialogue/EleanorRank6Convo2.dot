digraph {
	"EleanorRank6Convo2 begins." [color=orange];
		"EleanorRank6Convo2 begins." -> j391479054;
	j391479054 [label="Hey. Need to bounce some ideas off you.",shape=box,color=blue];
		j391479054 -> j1395013669;
	j1395013669 [label="Thinking about Fiendsnight. I haven’t dressed up for it for years, but I was leafing through one of Amir’s comics and I suddenly thought - hold on, I could be the Contessa! I’ve got the fangs for it and everything!",shape=box,color=blue];
		j1395013669 -> j2684666241;
	j2684666241 [label="But is that too obvious? Should I be Dandy Damage?",shape=box,color=blue];
		j2684666241 -> j3280330412;
		j2684666241 -> j2064698042;
		j2684666241 -> j2952899645;
	j3280330412 [label="Who's Dandy Damage?",shape=box,color=red];
		j3280330412 -> j1722607579;
	j2064698042 [label="You could always dress up as the Lotus, if you wanted to confuse people.",shape=box,color=red];
		j2064698042 -> j1829949696;
	j2952899645 [label="… you’re going to have to tell me what Fiendsnight is.",shape=box,color=red];
		j2952899645 -> j2866878859;
	j1722607579 [label="Oh mate. ",shape=box,color=blue];
		j1722607579 -> j2320679999;
	j1829949696 [label="Oh Gods no. I've seen her in your head. I could never do her justice.",shape=box,color=blue];
		j1829949696 -> j1659760904;
	j2866878859 [label="Mmm. I forget you're an innocent abroad, sometimes. ",shape=box,color=blue];
		j2866878859 -> j3421337652;
	j2320679999 [label="Dandy Damage walked so that Temple and the Rippers could run. He was every mother's nightmare and every teenage catastrophe's dream.",shape=box,color=blue];
		j2320679999 -> j2713814620;
	j1659760904 [label="And that helmet. Is it a helmet? Is it part of her? How does she see through it?",shape=box,color=blue];
		j1659760904 -> j2769653900;
	j3421337652 [label="Fiendsnight celebrates the fading of Sol's influence on the world.",shape=box,color=blue];
		j3421337652 -> j3001889547;
	j2713814620 [label="Built like a stick insect, made up like a silent movie queen. Mouth like candy. Pinstripes and leather and dog chain. Cheekbones like a skeleton's hips.",shape=box,color=blue];
		j2713814620 -> j256306218;
		j2713814620 -> j4098438202;
	j2769653900 [label="Anyway, there's three of her in the one body. I could never pick one of them over the others.",shape=box,color=blue];
		j2769653900 -> j256306218;
		j2769653900 -> j4098438202;
	j3001889547 [label="Which doesn't make a lot of sense on the face of it. Why celebrate the rising dark? Why rejoice in lawlessness and anarchy?",shape=box,color=blue];
		j3001889547 -> j57396640;
	j256306218 [label="Dressing up in costumes? Partying? In a war zone? Do you really think that's going to happen?",shape=box,color=red];
		j256306218 -> j877092588;
	j4098438202 [label="You know, Fiendsnight sounds a lot like Naberus. People like to dress up for that, too.",shape=box,color=red];
		j4098438202 -> j877092588;
	j57396640 [label="I think it's like an inoculation, maybe. A tiny bit of the thing we fear, to strengthen us. Or maybe it's just an excuse to put on the devil's mask and raise hell.",shape=box,color=blue];
		j57396640 -> j256306218;
		j57396640 -> j4098438202;
	j877092588 [label="... I'm probably just being silly. Childish. Aren't I?",shape=box,color=blue];
		j877092588 -> j1988335603;
	j1988335603 [label="Oh, what am I thinking.",shape=box,color=blue];
		j1988335603 -> j2615866033;
	j2615866033 [label="I don't need to dress up, do I? I'm already a monster. Forever and ever.",shape=box,color=blue];
		j2615866033 -> j2436064064;
	j2436064064 [label="Check boolean EleanorDating",color=orange];
		j2436064064 -> j1960139276 [label=true,color=green];
		j2436064064 -> j4294566504 [label=true,color=green];
		j2436064064 -> j4184479931 [label=true,color=green];
		j2436064064 -> j4294566504 [label=false,color=brown];
		j2436064064 -> j4184479931 [label=false,color=brown];
	j1960139276 [label="You're the monster that I love, Eleanor.  I don't regret a thing.",shape=box,color=red];
		j1960139276 -> j4191914052;
	j4294566504 [label="I'm starting to think you enjoy saying that about yourself.",shape=box,color=red];
		j4294566504 -> j3305611303;
	j4184479931 [label="No. Real monsters don't care for people the way that you do.",shape=box,color=red];
		j4184479931 -> j4030799483;
	j4191914052 [label="+5 Chemistry",color=orange];
		j4191914052 -> j2214744657;
	j3305611303 [label="If that's what you really believe you are, then Fiendsnight is the perfect chance to celebrate it.",shape=box,color=red];
		j3305611303 -> j541772813;
		j3305611303 -> j4030799483;
	j4030799483 [label="I know you're scared of what you might become. But that's not you NOW.",shape=box,color=red];
		j4030799483 -> j1459779272;
	j2214744657 [label="Oh yes! Silly me. I forgot the monster got the happy ending in our little story.",shape=box,color=blue];
		j2214744657 -> j793607707;
	j541772813 [label="BE the monster. Own it. For this one night of the year, wear that title with pride.",shape=box,color=red];
		j541772813 -> j3588620314;
	j1459779272 [label="So dress up. Have fun. Void knows the Hex could all use some.",shape=box,color=red];
		j1459779272 -> j928984029;
	j793607707 [label="Forgive me. I still can't quite believe that this is what you actually WANT. Maybe I just need a tiny bit more convincing.",shape=box,color=blue];
		j793607707 -> j3016399151;
	j3588620314 [label="Oh there are SO MANY reasons why that is a TERRIBLE IDEA",shape=box,color=blue];
		j3588620314 -> j1582388056;
	j928984029 [label="I'll take you up on that. And thank you. Once again. x",shape=box,color=blue];
		j928984029 -> "Chat ends.";
	j3016399151 [label="Let's devour one another later. xxx",shape=box,color=blue];
		j3016399151 -> "Chat ends.";
	j1582388056 [label="SO. MANY.",shape=box,color=blue];
		j1582388056 -> j2923882361;
	"Chat ends." [color=orange];
	j2923882361 [label="(I can't think of any right now but I'm sure there are DOZENS)",shape=box,color=blue];
		j2923882361 -> j404372411;
	j404372411 [label="... shit.",shape=box,color=blue];
		j404372411 -> j3093381077;
	j3093381077 [label="you have skewered me most nimbly upon my own kebab. damn you. well done. x",shape=box,color=blue];
		j3093381077 -> "Chat ends.";
}