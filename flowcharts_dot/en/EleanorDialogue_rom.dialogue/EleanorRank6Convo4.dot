digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"EleanorRank6Convo4 begins." [color=orange];
		"EleanorRank6Convo4 begins." -> j1574555158;
	j1574555158 [label="Do you ever get that thing where you’re having a shower and suddenly it’s like a weird little voice asks you a question you’ve never really thought to ask yourself before?",shape=box,color=blue];
		j1574555158 -> j772769296;
		j1574555158 -> j381154554;
		j1574555158 -> j642637518;
	j772769296 [label="Not really, no. [End.]",shape=box,color=red];
		j772769296 -> "Chat ends.";
	j381154554 [label="Like ‘What did people on Earth think when Lua suddenly appeared in the sky again?’",shape=box,color=red];
		j381154554 -> j2418345300;
	j642637518 [label="You mean like ‘Operator! Might you consider having your Kubrow stuffed?’ ",shape=box,color=red];
		j642637518 -> j3419566609;
	"Chat ends." [color=orange];
	j2418345300 [label="Right, exactly.",shape=box,color=blue];
		j2418345300 -> j1174355629;
	j3419566609 [label="That’s just Ordis. He does that.",shape=box,color=red];
		j3419566609 -> j2513381134;
	j1174355629 [label="wait",shape=box,color=blue];
		j1174355629 -> j4161230014;
	j2513381134 [label="Bless him. No, I mean an internal voice.",shape=box,color=blue];
		j2513381134 -> j226942613;
	j4161230014 [label="Lua disappeared?",shape=box,color=blue];
		j4161230014 -> j2846375275;
	j226942613 [label="A bit as if your brain was keeping itself occupied while you got on with the important business of personal hygiene.",shape=box,color=blue];
		j226942613 -> j1909388905;
	j2846375275 [label="For how long? Where did she go? What happened to the tides?",shape=box,color=blue];
		j2846375275 -> j2634914224;
		j2846375275 -> j2775803810;
	j1909388905 [label="I get them all the time. Weirdly random. So much so lately that I've been wondering if they really came from my own head at all. ",shape=box,color=blue];
		j1909388905 -> j4151120622;
	j2634914224 [label="In order: dunno, the Void, dunno.",shape=box,color=red];
		j2634914224 -> j54652963;
	j2775803810 [label="The Lotus sent her into the Void toward the end of the Old War. The kid brought her back out pretty recently.",shape=box,color=red];
		j2775803810 -> j1231242223;
	j4151120622 [label="Some of them I've turned into paintings.",shape=box,color=blue];
		j4151120622 -> j54652963;
	j54652963 [label="nevermind, we can come back to that.",shape=box,color=blue];
		j54652963 -> j1365795109;
	j1231242223 [label="No idea about the tides.",shape=box,color=red];
		j1231242223 -> j3065936373;
	j1365795109 [label="So, random shower thoughts. I got hit with an absolute belter this morning.",shape=box,color=blue];
		j1365795109 -> j2428408343;
	j3065936373 [label="How did the Lotus displace an entire MOON?",shape=box,color=blue];
		j3065936373 -> j54652963;
	j2428408343 [label="It went ‘hey, what if the Gods were real?’",shape=box,color=blue];
		j2428408343 -> j354045798;
	j354045798 [label="I went all wobbly for a moment. Had to run some cold in my face to snap out of it.",shape=box,color=blue];
		j354045798 -> j3870227071;
		j354045798 -> j2607967862;
		j354045798 -> j3612451742;
	j3870227071 [label="What’s weird about that? Seems like a pretty basic question to me.",shape=box,color=red];
		j3870227071 -> j2890062113;
	j2607967862 [label="… do people not think the Gods are real? I’m pretty sure Lettie does.",shape=box,color=red];
		j2607967862 -> j1923038576;
	j3612451742 [label="Yeah, that's a horrible thought.",shape=box,color=red];
		j3612451742 -> j1339422257;
	j2890062113 [label="Ah, this is why I adore talking to you about these things",shape=box,color=blue];
		j2890062113 -> j3966968886;
	j1923038576 [label="Oh, come on. Nobody actually thinks Gods are real. Not in the way that, I dunno, tables and chairs are.",shape=box,color=blue];
		j1923038576 -> j2990863838;
	j1339422257 [label="Isn't it? What if every time you thought the universe was sending you a message, it actually was?",shape=box,color=blue];
		j1339422257 -> j2409317037;
	j3966968886 [label="Your life is so fantastically absurd that the reality of Gods is as natural a speculation to you as the relative merits of pizza toppings",shape=box,color=blue];
		j3966968886 -> j1418274937;
	j2990863838 [label="Real Gods are like village wells and outdoor toilets. They’re something people USED to have. ",shape=box,color=blue];
		j2990863838 -> j2082030108;
	j2409317037 [label="Imagine everything being in the hands of these petty, immortal bastards who were in charge just because that's the way things are, not because they deserved it",shape=box,color=blue];
		j2409317037 -> j2618562375;
	j1418274937 [label="You might even have met a God. If that's what the Indifference is.",shape=box,color=blue];
		j1418274937 -> j83621721;
	j2082030108 [label="Nowadays they’re just symbols, or metaphors, or some bollocks like that.",shape=box,color=blue];
		j2082030108 -> j488439780;
		j2082030108 -> j3624660009;
	j2618562375 [label="And the mad part is that that's how people actually lived. That was their reality, every day of their lives.",shape=box,color=blue];
		j2618562375 -> j2484095036;
	j83621721 [label="You just reminded me of something, back on the Zariman. The first time I met the Indifference.",shape=box,color=red];
		j83621721 -> j3528275885;
	j488439780 [label="Maybe people are just less afraid?",shape=box,color=red];
		j488439780 -> j4120352065;
	j3624660009 [label="I thought Sol and Lua were your Gods.",shape=box,color=red];
		j3624660009 -> j3777191602;
	j2484095036 [label="To them the Gods were as real as the weather, and gave about the same number of shits about them.",shape=box,color=blue];
		j2484095036 -> j4092507053;
	j3528275885 [label="I didn't know that was what it was then, of course. I remember what it said, though. ",shape=box,color=red];
		j3528275885 -> j3552029872;
	j4120352065 [label="I think that's it, yeah. ",shape=box,color=blue];
		j4120352065 -> j3747308177;
	j3777191602 [label="Well yeah, they are. But they’re also just celestial bodies. ",shape=box,color=blue];
		j3777191602 -> j1711635370;
	j4092507053 [label="Doesn't sound that different from life under the Orokin, honestly.",shape=box,color=red];
		j4092507053 -> j2891226739;
	j3552029872 [label="I said it could take my light, and it grinned at me and said 'Thanks, kiddo. I think I will.'",shape=box,color=red];
		j3552029872 -> j736529665;
	j3747308177 [label="I think I know why, too.",shape=box,color=blue];
		j3747308177 -> j3228997253;
	j1711635370 [label="Like how Britannia is a country, with a name and an identity and stuff, but it’s also just a mass of earth and rocks. It can be both at once.",shape=box,color=blue];
		j1711635370 -> j2571593296;
	j2891226739 [label="Immortal, petty, in charge because they were in charge...",shape=box,color=red];
		j2891226739 -> j2748039584;
	j736529665 [label="Oh hell, you're giving me chills",shape=box,color=blue];
		j736529665 -> j3958800656;
	j3228997253 [label="It's all about light.",shape=box,color=blue];
		j3228997253 -> j2508333702;
	j2571593296 [label="You can go out on a lovely sunny day and feel grateful and look up at Sol and go ‘cheers!’ You mean it. That’s a human thing to do.",shape=box,color=blue];
		j2571593296 -> j1898530355;
	j2748039584 [label="Right. You HAD living Gods. But you killed them all.",shape=box,color=blue];
		j2748039584 -> j2951983657;
	j3958800656 [label="The devil is a stickler for the letter of the law, in all the old folktales",shape=box,color=blue];
		j3958800656 -> j3780133677;
	j2508333702 [label="What are Sol and Lua, after all? Before it occurred to anyone to think of them as Gods? They were LIGHTS.",shape=box,color=blue];
		j2508333702 -> j935797273;
		j2508333702 -> j617333355;
	j1898530355 [label="But nobody nowadays thinks Sol or Lua literally got some human woman pregnant or mothered some human bloke’s child and that’s where the King came from.",shape=box,color=blue];
		j1898530355 -> j1203611373;
	j2951983657 [label="(Don't get me wrong, I love that for you.)",shape=box,color=blue];
		j2951983657 -> j133560393;
	j3780133677 [label="Do you think it thinks you've pledged something to it? Your 'light'?",shape=box,color=blue];
		j3780133677 -> j1065521367;
		j3780133677 -> j1401004115;
	j935797273 [label="Right. Light symbolises good, wherever you go.",shape=box,color=red];
		j935797273 -> j2424135561;
	j617333355 [label="The only lights humanity had, for a long long time.",shape=box,color=red];
		j617333355 -> j2424135561;
	j1203611373 [label="People used to believe that stuff. Now we know those stories were just legends. We’ve outgrown them.",shape=box,color=blue];
		j1203611373 -> j2413157105;
		j1203611373 -> j2052135297;
	j133560393 [label="You're mixing me up with the kid. I never got to be part of the great Tenno insurrection.",shape=box,color=red];
		j133560393 -> j474840786;
	j1065521367 [label="It says we made a 'deal'. So I guess it thinks I owe it... something.",shape=box,color=red];
		j1065521367 -> j2893702273;
	j1401004115 [label="I meant the globelight I was carrying, but who knows what it meant.",shape=box,color=red];
		j1401004115 -> j2893702273;
	j2424135561 [label="YES.",shape=box,color=blue];
		j2424135561 -> j3080472248;
	j2413157105 [label="Gods and humans... got together?",shape=box,color=red];
		j2413157105 -> j1190501195;
	j2052135297 [label="Kings with Gods for parents? And I thought the Orokin were assholes.",shape=box,color=red];
		j2052135297 -> j1190501195;
	j474840786 [label="Never got to be part of Margulis' program for Very Special Kiddies, never got a Warframe, never fought in the Old War.",shape=box,color=red];
		j474840786 -> j4046019020;
	j2893702273 [label="I know one thing about it, at least. It plays games.",shape=box,color=red];
		j2893702273 -> j876202269;
	j3080472248 [label="But then some little cave-nerd who was probably picked on by the big cavegirls hit on the whole banging rocks together trick, and bingo.",shape=box,color=blue];
		j3080472248 -> j472936367;
	j1190501195 [label="Oh that stuff happened a LOT. All over the world.",shape=box,color=blue];
		j1190501195 -> j3012630642;
	j4046019020 [label="... would you have liked to?",shape=box,color=blue];
		j4046019020 -> j3632621432;
		j4046019020 -> j1981159169;
		j4046019020 -> j2953622911;
	j876202269 [label="+20 Chemistry",color=orange];
		j876202269 -> j2481538773;
	j472936367 [label="Light on demand! Independence from the big lights in the sky!",shape=box,color=blue];
		j472936367 -> j1964141827;
	j3012630642 [label="Imagine you’re some arrogant priest setting off over the sea to spread the gospel of Sol to the ‘savages’ in the new world, only to find that they not only know all about Sol already, they’ve got Sol’s actual son ruling over them.",shape=box,color=blue];
		j3012630642 -> j2193305863;
	j3632621432 [label="I really don't know.",shape=box,color=red];
		j3632621432 -> j37311128;
	j1981159169 [label="Honestly, no.",shape=box,color=red];
		j1981159169 -> j125837130;
	j2953622911 [label="Yeah, I would.",shape=box,color=red];
		j2953622911 -> j3234111676;
	j2481538773 [label="okay. Whatever you do today, whoever you're with, whether it's me or Arthur or any of us... stay safe.",shape=box,color=blue];
		j2481538773 -> j3435349021;
	j1964141827 [label="Now look at us. Light's everywhere. We've cheapened it.",shape=box,color=blue];
		j1964141827 -> j83621721;
	j2193305863 [label="You’d go running back home with your tail between your legs, or convert on the spot.",shape=box,color=blue];
		j2193305863 -> j2836110583;
		j2193305863 -> j2376770413;
	j37311128 [label="That's fair. I respect it.",shape=box,color=blue];
		j37311128 -> j2991126293;
	j125837130 [label="I'm glad. If you feel your life could have been worse than it is, I guess we have something to celebrate?",shape=box,color=blue];
		j125837130 -> j2991126293;
	j3234111676 [label="I understand, I think. You missed out on a great deal, didn't you?",shape=box,color=blue];
		j3234111676 -> j2991126293;
	j3435349021 [label="Check boolean EleanorDating",color=orange];
		j3435349021 -> j1583794638 [label=true,color=green];
		j3435349021 -> j3276101036 [label=false,color=brown];
	j2836110583 [label="Do you really think the Gods are real, though? Or is it just that you're scared of the idea that they might be?",shape=box,color=red];
		j2836110583 -> j3848352824;
	j2376770413 [label="Okay. So you’re saying: what if the people in the past were right all along?",shape=box,color=red];
		j2376770413 -> j3848352824;
	j2991126293 [label="Check boolean EleanorDating",color=orange];
		j2991126293 -> j440551104 [label=true,color=green];
		j2991126293 -> j1508400160 [label=false,color=brown];
	j1583794638 [label="I love you. Any God that tries to get in the way of that had better pray to whatever the hell it is that's above Gods.",shape=box,color=blue];
		j1583794638 -> "Chat ends.";
	j3276101036 [label="You're my dear friend. Any God who tries to take you from me is going to find its reality sorely tested.",shape=box,color=blue];
		j3276101036 -> "Chat ends.";
	j3848352824 [label="Let’s just say I used to be a lot more confident in the boring material reality of things than I am now.",shape=box,color=blue];
		j3848352824 -> j1263845387;
	j440551104 [label="+20 Chemistry",color=orange];
		j440551104 -> j3948303862;
	j1508400160 [label="+20 Chemistry",color=orange];
		j1508400160 -> j3865378309;
	j1263845387 [label="There’s a Drifter-shaped hole where that assurance used to be.",shape=box,color=blue];
		j1263845387 -> j464901728;
	j3948303862 [label="We both have our scars, my love. ",shape=box,color=blue];
		j3948303862 -> "Chat ends.";
	j3865378309 [label="We both have our scars, my friend.",shape=box,color=blue];
		j3865378309 -> "Chat ends.";
	j464901728 [label="+20 Chemistry",color=orange];
		j464901728 -> j936306850;
	j936306850 [label="Honestly? I don’t miss it, really. It’s nice to be freaked out by the possibilities once in a while.",shape=box,color=blue];
		j936306850 -> "Chat ends.";
}