digraph {
	3068 [label="EleanorRank6Convo5 begins.",color=orange];
		3068 -> 3069;
	3069 [label="I was wondering, as I so often do...",shape=box,color=blue];
		3069 -> 3070;
	3070 [label="Once this loop is finally closed, however that happens, what's next for Earth?",shape=box,color=blue];
		3070 -> 3071;
	3071 [label="I know 2000 is pretty far back in your past, but can you tell me ANYTHING about what's in store for our little planet?",shape=box,color=blue];
		3071 -> 3072;
		3071 -> 3074;
	3072 [label="It's not good, I'm afraid.",shape=box,color=red];
		3072 -> 3073;
	3074 [label="I don't think I should, honestly.",shape=box,color=red];
		3074 -> 3076;
	3073 [label="From what little I can tell, Techrot becomes a global problem. People solve it with nukes - or try to.",shape=box,color=red];
		3073 -> 3075;
	3076 [label="If you're forewarned about what's coming you might try to change it, and that could mean I never exist.",shape=box,color=red];
		3076 -> 3078;
	3075 [label="That's how the first of the 'Radiation Wars' begins.",shape=box,color=red];
		3075 -> 3077;
	3078 [label="Call me selfish, but I like existing.",shape=box,color=red];
		3078 -> 3080;
	3077 [label="... and eventually the planet gets so effed up that the Orokin want to bail out of it and go and live somewhere else, right?",shape=box,color=blue];
		3077 -> 3079;
	3080 [label="Oh, like everything you've done HASN'T changed the future?",shape=box,color=blue];
		3080 -> 3082;
	3079 [label="... which leads to the whole Zariman thing, which is where YOU come in.",shape=box,color=blue];
		3079 -> 3081;
	3082 [label="You might have changed the little details, but the big ones have stayed pretty much the same.",shape=box,color=blue];
		3082 -> 3085;
	3081 [label="Weird to think that it all starts right here in this city.",shape=box,color=blue];
		3081 -> 3083;
		3081 -> 3084;
	3085 [label="I think the Universe knows what she's doing.",shape=box,color=blue];
		3085 -> 3088;
	3083 [label="Maybe that's partly why this year is so important.",shape=box,color=red];
		3083 -> 3086;
	3084 [label="Yeah. From Höllvania to the Zariman Ten-Zero. It's a throughline.",shape=box,color=red];
		3084 -> 3087;
	3088 [label="There's more going on than just blind particles mucking about.",shape=box,color=blue];
		3088 -> 3091;
		3088 -> 3092;
	3086 [label="+5 Chemistry",color=orange];
		3086 -> 3089;
	3087 [label="hang about...",shape=box,color=blue];
		3087 -> 3090;
	3091 [label="I don't share your view. The Universe is mindless.",shape=box,color=red];
		3091 -> 3095;
	3092 [label="I agree. If something as human as emotion can shape the Void...",shape=box,color=red];
		3092 -> 3096;
	3089 [label="Makes sense. If Albrecht's nuke had gone off would that mean no Techrot, so no knackered Earth, no need to escape, no first trip into the Void and no Indifference??",shape=box,color=blue];
		3089 -> 3093;
	3090 [label="If yours was the Zariman Ten-Zero, what happened to Zarimans One through Nine?",shape=box,color=blue];
		3090 -> 3094;
	3095 [label="Maybe from a very big or very small perspective, but not at the level where you and I exist.",shape=box,color=blue];
		3095 -> 3099;
	3096 [label="+5 Chemistry",color=orange];
		3096 -> 3100;
	3093 [label="... I'm going to go see if Lettie has any coffee on the go. ",shape=box,color=blue];
		3093 -> 3097;
	3094 [label="Unmanned drones, from what I remember. ",shape=box,color=red];
		3094 -> 3098;
	3099 [label="If we can make meaning and we're part of the Universe, then the Universe is by definition meaningful.",shape=box,color=blue];
		3099 -> 3102;
	3100 [label="Exactly. The meaning we make isn't just comfortable delusion.",shape=box,color=blue];
		3100 -> 3103;
	3097 [label="Chat ends.",color=orange];
	3098 [label="Or Cephalon-piloted terraforming pods. They experimented a LOT.",shape=box,color=red];
		3098 -> 3101;
	3102 [label="+5 Chemistry",color=orange];
		3102 -> 3105;
	3103 [label="But there's always that voice whispering to you and insisting that none of this matters.",shape=box,color=blue];
		3103 -> 3106;
	3101 [label="'The Project', they called it. ",shape=box,color=red];
		3101 -> 3104;
	3105 [label="Our existence isn't any less true or valid than quarks or supernovas. We're important, like it or not.",shape=box,color=blue];
		3105 -> 3108;
	3106 [label="Maybe the big cosmic throwdown isn't between Good and Evil, but meaning and meaninglessness?",shape=box,color=blue];
		3106 -> 3109;
	3104 [label="+5 Chemistry",color=orange];
		3104 -> 3107;
	3108 [label="Chat ends.",color=orange];
	3109 [label="Chat ends.",color=orange];
	3107 [label="Sounds better than 'Operation Get Our Irresponsible Arses To A New Planet That We Can Proceed To Shit All Over'.",shape=box,color=blue];
		3107 -> 3110;
	3110 [label="Chat ends.",color=orange];
}