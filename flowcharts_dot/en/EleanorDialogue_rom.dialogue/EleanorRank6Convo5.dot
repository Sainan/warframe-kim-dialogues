digraph {
	"EleanorRank6Convo5 begins." [color=orange];
		"EleanorRank6Convo5 begins." -> j1697518474;
	j1697518474 [label="I was wondering, as I so often do...",shape=box,color=blue];
		j1697518474 -> j2754861435;
	j2754861435 [label="Once this loop is finally closed, however that happens, what's next for Earth?",shape=box,color=blue];
		j2754861435 -> j611747352;
	j611747352 [label="I know 2000 is pretty far back in your past, but can you tell me ANYTHING about what's in store for our little planet?",shape=box,color=blue];
		j611747352 -> j2457805742;
		j611747352 -> j1148708090;
	j2457805742 [label="It's not good, I'm afraid.",shape=box,color=red];
		j2457805742 -> j911194856;
	j1148708090 [label="I don't think I should, honestly.",shape=box,color=red];
		j1148708090 -> j2974647671;
	j911194856 [label="From what little I can tell, Techrot becomes a global problem. People solve it with nukes - or try to.",shape=box,color=red];
		j911194856 -> j3281996348;
	j2974647671 [label="If you're forewarned about what's coming you might try to change it, and that could mean I never exist.",shape=box,color=red];
		j2974647671 -> j1886771442;
	j3281996348 [label="That's how the first of the 'Radiation Wars' begins.",shape=box,color=red];
		j3281996348 -> j3153599392;
	j1886771442 [label="Call me selfish, but I like existing.",shape=box,color=red];
		j1886771442 -> j303677149;
	j3153599392 [label="... and eventually the planet gets so effed up that the Orokin want to bail out of it and go and live somewhere else, right?",shape=box,color=blue];
		j3153599392 -> j2623138926;
	j303677149 [label="Oh, like everything you've done HASN'T changed the future?",shape=box,color=blue];
		j303677149 -> j2033878403;
	j2623138926 [label="... which leads to the whole Zariman thing, which is where YOU come in.",shape=box,color=blue];
		j2623138926 -> j1309388909;
	j2033878403 [label="You might have changed the little details, but the big ones have stayed pretty much the same.",shape=box,color=blue];
		j2033878403 -> j1711704731;
	j1309388909 [label="Weird to think that it all starts right here in this city.",shape=box,color=blue];
		j1309388909 -> j1874378931;
		j1309388909 -> j3561150224;
	j1711704731 [label="I think the Universe knows what she's doing.",shape=box,color=blue];
		j1711704731 -> j3296245049;
	j1874378931 [label="Maybe that's partly why this year is so important.",shape=box,color=red];
		j1874378931 -> j780975522;
	j3561150224 [label="Yeah. From Höllvania to the Zariman Ten-Zero. It's a throughline.",shape=box,color=red];
		j3561150224 -> j2073912276;
	j3296245049 [label="There's more going on than just blind particles mucking about.",shape=box,color=blue];
		j3296245049 -> j3141260804;
		j3296245049 -> j3726445784;
	j780975522 [label="+5 Chemistry",color=orange];
		j780975522 -> j3684246175;
	j2073912276 [label="hang about...",shape=box,color=blue];
		j2073912276 -> j2440686094;
	j3141260804 [label="I don't share your view. The Universe is mindless.",shape=box,color=red];
		j3141260804 -> j2927948029;
	j3726445784 [label="I agree. If something as human as emotion can shape the Void...",shape=box,color=red];
		j3726445784 -> j134935178;
	j3684246175 [label="Makes sense. If Albrecht's nuke had gone off would that mean no Techrot, so no knackered Earth, no need to escape, no first trip into the Void and no Indifference??",shape=box,color=blue];
		j3684246175 -> j3792355819;
	j2440686094 [label="If yours was the Zariman Ten-Zero, what happened to Zarimans One through Nine?",shape=box,color=blue];
		j2440686094 -> j3388951279;
	j2927948029 [label="Maybe from a very big or very small perspective, but not at the level where you and I exist.",shape=box,color=blue];
		j2927948029 -> j1444433972;
	j134935178 [label="+5 Chemistry",color=orange];
		j134935178 -> j2189692789;
	j3792355819 [label="... I'm going to go see if Lettie has any coffee on the go. ",shape=box,color=blue];
		j3792355819 -> "Chat ends.";
	j3388951279 [label="Unmanned drones, from what I remember. ",shape=box,color=red];
		j3388951279 -> j1706227339;
	j1444433972 [label="If we can make meaning and we're part of the Universe, then the Universe is by definition meaningful.",shape=box,color=blue];
		j1444433972 -> j1858560436;
	j2189692789 [label="Exactly. The meaning we make isn't just comfortable delusion.",shape=box,color=blue];
		j2189692789 -> j522398576;
	"Chat ends." [color=orange];
	j1706227339 [label="Or Cephalon-piloted terraforming pods. They experimented a LOT.",shape=box,color=red];
		j1706227339 -> j1434359031;
	j1858560436 [label="+5 Chemistry",color=orange];
		j1858560436 -> j253307614;
	j522398576 [label="But there's always that voice whispering to you and insisting that none of this matters.",shape=box,color=blue];
		j522398576 -> j3995058019;
	j1434359031 [label="'The Project', they called it. ",shape=box,color=red];
		j1434359031 -> j2543477165;
	j253307614 [label="Our existence isn't any less true or valid than quarks or supernovas. We're important, like it or not.",shape=box,color=blue];
		j253307614 -> "Chat ends.";
	j3995058019 [label="Maybe the big cosmic throwdown isn't between Good and Evil, but meaning and meaninglessness?",shape=box,color=blue];
		j3995058019 -> "Chat ends.";
	j2543477165 [label="+5 Chemistry",color=orange];
		j2543477165 -> j176999024;
	j176999024 [label="Sounds better than 'Operation Get Our Irresponsible Arses To A New Planet That We Can Proceed To Shit All Over'.",shape=box,color=blue];
		j176999024 -> "Chat ends.";
}