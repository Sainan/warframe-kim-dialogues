digraph {
	2888 [label="EleanorRank6Convo3 begins.",color=orange];
		2888 -> 2889;
	2889 [label="I don't know if you've noticed, but something bloody fantastic has happened.",shape=box,color=blue];
		2889 -> 2890;
	2890 [label="Arthur's singing again. Thank the Gods.",shape=box,color=blue];
		2890 -> 2891;
		2890 -> 2892;
		2890 -> 2893;
	2891 [label="Why did he stop?",shape=box,color=red];
		2891 -> 2894;
	2892 [label="I'm not exactly a fan, but if it makes him happy...",shape=box,color=red];
		2892 -> 2895;
	2893 [label="I'm glad. He's good at it.",shape=box,color=red];
		2893 -> 2896;
	2894 [label="Performance anxiety. Simple as that.",shape=box,color=blue];
		2894 -> 2897;
	2895 [label="Thank you for putting that as delicately as you did.",shape=box,color=blue];
		2895 -> 2898;
	2896 [label="Isn't he?",shape=box,color=blue];
		2896 -> 2899;
	2897 [label="Hard to believe someone as brave as Arthur could be scared like that.",shape=box,color=red];
		2897 -> 2900;
	2898 [label="It matters to me that you care.",shape=box,color=blue];
		2898 -> 2901;
	2899 [label="When I think of the effort it took to get him to stand up in front of a crowd of people and sing...",shape=box,color=blue];
		2899 -> 2902;
	2900 [label="What's the crack in his armor?",shape=box,color=red];
		2900 -> 2903;
	2901 [label="Especially since there are reasons why he gave up singing, which you couldn't possibly have known about.",shape=box,color=blue];
		2901 -> 2904;
		2901 -> 2905;
	2902 [label="... the first time he really lost his nerve, I mean.",shape=box,color=blue];
		2902 -> 2906;
	2903 [label="It’s the name. That’s the sodding problem.",shape=box,color=blue];
		2903 -> 2907;
	2904 [label="Not enough moral support?",shape=box,color=red];
		2904 -> 2908;
	2905 [label="Too many tough crowds?",shape=box,color=red];
		2905 -> 2908;
	2906 [label="Solstice Carol Concert back in the eighties. Imagine our little man in short trousers doing the solo from How Bright The Dew Upon That Morn.",shape=box,color=blue];
		2906 -> 2909;
		2906 -> 2910;
	2907 [label="‘oh your name’s nightingale is it ha ha sing us a song then’",shape=box,color=blue];
		2907 -> 2911;
	2908 [label="Hearing the same joke too often, more like.",shape=box,color=blue];
		2908 -> 2903;
	2909 [label="That's quite a visual.",shape=box,color=red];
		2909 -> 2912;
	2910 [label="I don't know that one.",shape=box,color=red];
		2910 -> 2913;
	2911 [label="Different wankers, same line, all through our lives. Now Viktor’s doing it. ",shape=box,color=blue];
		2911 -> 2914;
	2912 [label="He took it so seriously. Weeks and weeks of practice and then, on the night, he bottled it. He hid in the wings and refused to go out.",shape=box,color=blue];
		2912 -> 2915;
		2912 -> 2897;
	2913 [label="Well. I’d sing it for you, but I’m not sure what sort of noise would come out if I tried.",shape=box,color=blue];
		2913 -> 2916;
	2914 [label="+5 Chemistry",color=orange];
		2914 -> 2917;
	2915 [label="How did you convince him?",shape=box,color=red];
		2915 -> 2918;
	2916 [label="Bloody Techrot. I tried to sing Happy Birthday to Aoi and it sounded like a bullfrog caught in a paper shredder.",shape=box,color=blue];
		2916 -> 2919;
	2917 [label="Honestly, I’m proud of Arthur for having the guts to sing at all.",shape=box,color=blue];
		2917 -> 2920;
	2918 [label="I literally kicked his arse. Not proud of it. But it needed doing.",shape=box,color=blue];
		2918 -> 2921;
	2919 [label="I’m sorry. It must be rough, not being able to sing any more.",shape=box,color=red];
		2919 -> 2922;
	2920 [label="Chat ends.",color=orange];
	2921 [label="The thing is, he didn’t do all that practice for our parents’ sake or to make Mrs Henshaw happy. ",shape=box,color=blue];
		2921 -> 2923;
	2922 [label="Oh, it’s not much of a loss. I couldn’t sing anyway.",shape=box,color=blue];
		2922 -> 2924;
	2923 [label="He was singing because he loved it. But when the spotlight was on him, he locked up.",shape=box,color=blue];
		2923 -> 2925;
		2923 -> 2900;
	2924 [label="The closest I came was screaming out lyrics from the Shag Cannons in my bedroom because I wanted to be in Mandy Jellicoe’s band because I fancied her. ",shape=box,color=blue];
		2924 -> 2926;
	2925 [label="Maybe he just needed to remember how much he loved to do it.",shape=box,color=red];
		2925 -> 2927;
	2926 [label="Cue my dad hammering on the door and threatening to wash my mouth out with carbolic if he heard any more of that filth.",shape=box,color=blue];
		2926 -> 2928;
	2927 [label="Arthur's at his happiest when he can forget about Arthur. When he can lay the ghost of himself to rest and just BE.",shape=box,color=blue];
		2927 -> 2929;
	2928 [label="(I don’t know if you have ‘punk’ where you come from but not being able to sing is more of a requirement than a dealbreaker.)",shape=box,color=blue];
		2928 -> 2930;
		2928 -> 2931;
	2929 [label="Beer helps.",shape=box,color=blue];
		2929 -> 2932;
	2930 [label="We don't have punk, but we do have Skeg.",shape=box,color=red];
		2930 -> 2933;
	2931 [label="What happened to the band?",shape=box,color=red];
		2931 -> 2934;
	2932 [label="And it surely doesn't hurt that Velimir is acting like the dad Arthur would have chosen, if he could have picked one out of a catalogue.",shape=box,color=blue];
		2932 -> 2935;
		2932 -> 2936;
	2933 [label="Don’t you dare drop something like that into the chat and then not elaborate. ",shape=box,color=blue];
		2933 -> 2937;
	2934 [label="They didn’t even get to the ‘pity gig in the local pub’ stage.",shape=box,color=blue];
		2934 -> 2938;
	2935 [label="I don't blame him.",shape=box,color=red];
		2935 -> 2939;
	2936 [label="I'd have thought Velimir and Minerva were a bit too much like your actual parents.",shape=box,color=red];
		2936 -> 2940;
	2937 [label="I demand you tell me what Skeg is.",shape=box,color=blue];
		2937 -> 2941;
	2938 [label="Word got around that Mandy was planning to spit on the audience and that was that. Shame.",shape=box,color=blue];
		2938 -> 2942;
		2938 -> 2943;
	2939 [label="Arthur's been carting that teddy bear around for months. Now Velimir shows up. It's like destiny sensed a bear-shaped hole in Arthur's life...",shape=box,color=blue];
		2939 -> 2944;
	2940 [label="yeah, well. Maybe the bickering makes him feel at home. ",shape=box,color=blue];
		2940 -> 2945;
	2941 [label="Because it sounds like something sold in little ziplock bags on a Ludston estate.",shape=box,color=blue];
		2941 -> 2946;
		2941 -> 2947;
	2942 [label="Who's afraid of a little spit?",shape=box,color=red];
		2942 -> 2948;
	2943 [label="Spit? Sounds like a Technocyte Coda's idea of a good night.",shape=box,color=red];
		2943 -> 2949;
	2944 [label="+5 Chemistry",color=orange];
		2944 -> 2950;
	2945 [label="+5 Chemistry",color=orange];
		2945 -> 2951;
	2946 [label="It’s like music except you make it by hitting pipes. And vents. And Corpus helmets. And anything else you can find to hit, really. ",shape=box,color=red];
		2946 -> 2952;
	2947 [label="It’s just pointless noise. Only Ventkids like it.",shape=box,color=red];
		2947 -> 2953;
	2948 [label="+5 Chemistry",color=orange];
		2948 -> 2954;
	2949 [label="It was a different time. Back when punk was real punk. ",shape=box,color=blue];
		2949 -> 2955;
	2950 [label="... sorry. Not my business to speculate. I'm just happy that he's happy.",shape=box,color=blue];
		2950 -> 3311;
	2951 [label="Weird what you can get homesick for, isn't it?",shape=box,color=blue];
		2951 -> 2956;
	2952 [label="It’s a Ventkid thing.",shape=box,color=red];
		2952 -> 2957;
	2953 [label="Huh. 'Pointless noise'. I've heard that said before.",shape=box,color=blue];
		2953 -> 2958;
	2954 [label="I bloody wasn't, I can tell you that much.",shape=box,color=blue];
		2954 -> 2955;
	2955 [label="... I just thought 'I wish she could see me now'. I think she'd like this version of me.",shape=box,color=blue];
		2955 -> 2959;
	3311 [label="Chat ends.",color=orange];
	2956 [label="Chat ends.",color=orange];
	2957 [label="+5 Chemistry",color=orange];
		2957 -> 2960;
	2958 [label="I don't think anything's so pointless that it can't be the soundtrack to someone's youth.",shape=box,color=blue];
		2958 -> 2961;
	2959 [label="Gods, look at me, I've gone all soppy and nostalgic.",shape=box,color=blue];
		2959 -> 2962;
	2960 [label="Hmm. Sounds like survivor music. Wouldn’t mind having a listen if you get the chance to record some for me.",shape=box,color=blue];
		2960 -> 2963;
	2961 [label="I'd better stop. I'm getting sentimental.",shape=box,color=blue];
		2961 -> 2964;
	2962 [label="+5 Chemistry",color=orange];
		2962 -> 2965;
	2963 [label="Best keep it off the Mall speakers, though.",shape=box,color=blue];
		2963 -> 2966;
	2964 [label="Chat ends.",color=orange];
	2965 [label="Better get back to it. Thanks for the ear.",shape=box,color=blue];
		2965 -> 2967;
