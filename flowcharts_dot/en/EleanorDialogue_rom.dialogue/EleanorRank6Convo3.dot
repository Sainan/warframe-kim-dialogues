digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"EleanorRank6Convo3 begins." [color=orange];
		"EleanorRank6Convo3 begins." -> j2378700693;
	j2378700693 [label="I don't know if you've noticed, but something bloody fantastic has happened.",shape=box,color=blue];
		j2378700693 -> j2801031595;
	j2801031595 [label="Arthur's singing again. Thank the Gods.",shape=box,color=blue];
		j2801031595 -> j1809030030;
		j2801031595 -> j4121338511;
		j2801031595 -> j3136863201;
	j1809030030 [label="Why did he stop?",shape=box,color=red];
		j1809030030 -> j501106852;
	j4121338511 [label="I'm not exactly a fan, but if it makes him happy...",shape=box,color=red];
		j4121338511 -> j2654702367;
	j3136863201 [label="I'm glad. He's good at it.",shape=box,color=red];
		j3136863201 -> j1310927957;
	j501106852 [label="Performance anxiety. Simple as that.",shape=box,color=blue];
		j501106852 -> j1321747416;
	j2654702367 [label="Thank you for putting that as delicately as you did.",shape=box,color=blue];
		j2654702367 -> j1886319428;
	j1310927957 [label="Isn't he?",shape=box,color=blue];
		j1310927957 -> j2622221224;
	j1321747416 [label="Hard to believe someone as brave as Arthur could be scared like that.",shape=box,color=red];
		j1321747416 -> j1661000684;
	j1886319428 [label="It matters to me that you care.",shape=box,color=blue];
		j1886319428 -> j2294674142;
	j2622221224 [label="When I think of the effort it took to get him to stand up in front of a crowd of people and sing...",shape=box,color=blue];
		j2622221224 -> j4130122053;
	j1661000684 [label="What's the crack in his armor?",shape=box,color=red];
		j1661000684 -> j2141842764;
	j2294674142 [label="Especially since there are reasons why he gave up singing, which you couldn't possibly have known about.",shape=box,color=blue];
		j2294674142 -> j4119618923;
		j2294674142 -> j3367284564;
	j4130122053 [label="... the first time he really lost his nerve, I mean.",shape=box,color=blue];
		j4130122053 -> j2497184182;
	j2141842764 [label="It’s the name. That’s the sodding problem.",shape=box,color=blue];
		j2141842764 -> j3619364493;
	j4119618923 [label="Not enough moral support?",shape=box,color=red];
		j4119618923 -> j1385781413;
	j3367284564 [label="Too many tough crowds?",shape=box,color=red];
		j3367284564 -> j1385781413;
	j2497184182 [label="Solstice Carol Concert back in the eighties. Imagine our little man in short trousers doing the solo from How Bright The Dew Upon That Morn.",shape=box,color=blue];
		j2497184182 -> j303417251;
		j2497184182 -> j327087128;
	j3619364493 [label="‘oh your name’s nightingale is it ha ha sing us a song then’",shape=box,color=blue];
		j3619364493 -> j1226333822;
	j1385781413 [label="Hearing the same joke too often, more like.",shape=box,color=blue];
		j1385781413 -> j2141842764;
	j303417251 [label="That's quite a visual.",shape=box,color=red];
		j303417251 -> j3871011299;
	j327087128 [label="I don't know that one.",shape=box,color=red];
		j327087128 -> j100741296;
	j1226333822 [label="Different wankers, same line, all through our lives. Now Viktor’s doing it. ",shape=box,color=blue];
		j1226333822 -> j1298366856;
	j3871011299 [label="He took it so seriously. Weeks and weeks of practice and then, on the night, he bottled it. He hid in the wings and refused to go out.",shape=box,color=blue];
		j3871011299 -> j2979897877;
		j3871011299 -> j1321747416;
	j100741296 [label="Well. I’d sing it for you, but I’m not sure what sort of noise would come out if I tried.",shape=box,color=blue];
		j100741296 -> j2344688052;
	j1298366856 [label="+5 Chemistry",color=orange];
		j1298366856 -> j474120582;
	j2979897877 [label="How did you convince him?",shape=box,color=red];
		j2979897877 -> j3180979704;
	j2344688052 [label="Bloody Techrot. I tried to sing Happy Birthday to Aoi and it sounded like a bullfrog caught in a paper shredder.",shape=box,color=blue];
		j2344688052 -> j1561252606;
	j474120582 [label="Honestly, I’m proud of Arthur for having the guts to sing at all.",shape=box,color=blue];
		j474120582 -> "Chat ends.";
	j3180979704 [label="I literally kicked his arse. Not proud of it. But it needed doing.",shape=box,color=blue];
		j3180979704 -> j1446787951;
	j1561252606 [label="I’m sorry. It must be rough, not being able to sing any more.",shape=box,color=red];
		j1561252606 -> j989752699;
	"Chat ends." [color=orange];
	j1446787951 [label="The thing is, he didn’t do all that practice for our parents’ sake or to make Mrs Henshaw happy. ",shape=box,color=blue];
		j1446787951 -> j2453294223;
	j989752699 [label="Oh, it’s not much of a loss. I couldn’t sing anyway.",shape=box,color=blue];
		j989752699 -> j2928574258;
	j2453294223 [label="He was singing because he loved it. But when the spotlight was on him, he locked up.",shape=box,color=blue];
		j2453294223 -> j216222584;
		j2453294223 -> j1661000684;
	j2928574258 [label="The closest I came was screaming out lyrics from the Shag Cannons in my bedroom because I wanted to be in Mandy Jellicoe’s band because I fancied her. ",shape=box,color=blue];
		j2928574258 -> j1529956010;
	j216222584 [label="Maybe he just needed to remember how much he loved to do it.",shape=box,color=red];
		j216222584 -> j546952527;
	j1529956010 [label="Cue my dad hammering on the door and threatening to wash my mouth out with carbolic if he heard any more of that filth.",shape=box,color=blue];
		j1529956010 -> j3528183539;
	j546952527 [label="Arthur's at his happiest when he can forget about Arthur. When he can lay the ghost of himself to rest and just BE.",shape=box,color=blue];
		j546952527 -> j3235555914;
	j3528183539 [label="(I don’t know if you have ‘punk’ where you come from but not being able to sing is more of a requirement than a dealbreaker.)",shape=box,color=blue];
		j3528183539 -> j3480652049;
		j3528183539 -> j1767074935;
	j3235555914 [label="Beer helps.",shape=box,color=blue];
		j3235555914 -> j3265085110;
	j3480652049 [label="We don't have punk, but we do have Skeg.",shape=box,color=red];
		j3480652049 -> j458140373;
	j1767074935 [label="What happened to the band?",shape=box,color=red];
		j1767074935 -> j2316604020;
	j3265085110 [label="And it surely doesn't hurt that Velimir is acting like the dad Arthur would have chosen, if he could have picked one out of a catalogue.",shape=box,color=blue];
		j3265085110 -> j2551515680;
		j3265085110 -> j4093509911;
	j458140373 [label="Don’t you dare drop something like that into the chat and then not elaborate. ",shape=box,color=blue];
		j458140373 -> j3487546374;
	j2316604020 [label="They didn’t even get to the ‘pity gig in the local pub’ stage.",shape=box,color=blue];
		j2316604020 -> j3145671462;
	j2551515680 [label="I don't blame him.",shape=box,color=red];
		j2551515680 -> j511911862;
	j4093509911 [label="I'd have thought Velimir and Minerva were a bit too much like your actual parents.",shape=box,color=red];
		j4093509911 -> j2907430407;
	j3487546374 [label="I demand you tell me what Skeg is.",shape=box,color=blue];
		j3487546374 -> j2580787413;
	j3145671462 [label="Word got around that Mandy was planning to spit on the audience and that was that. Shame.",shape=box,color=blue];
		j3145671462 -> j571986161;
		j3145671462 -> j3689532272;
	j511911862 [label="Arthur's been carting that teddy bear around for months. Now Velimir shows up. It's like destiny sensed a bear-shaped hole in Arthur's life...",shape=box,color=blue];
		j511911862 -> j2795902165;
	j2907430407 [label="yeah, well. Maybe the bickering makes him feel at home. ",shape=box,color=blue];
		j2907430407 -> j2912838946;
	j2580787413 [label="Because it sounds like something sold in little ziplock bags on a Ludston estate.",shape=box,color=blue];
		j2580787413 -> j268299921;
		j2580787413 -> j466314805;
	j571986161 [label="Who's afraid of a little spit?",shape=box,color=red];
		j571986161 -> j3179472449;
	j3689532272 [label="Spit? Sounds like a Technocyte Coda's idea of a good night.",shape=box,color=red];
		j3689532272 -> j736511760;
	j2795902165 [label="+5 Chemistry",color=orange];
		j2795902165 -> j3799199768;
	j2912838946 [label="+5 Chemistry",color=orange];
		j2912838946 -> j3884906024;
	j268299921 [label="It’s like music except you make it by hitting pipes. And vents. And Corpus helmets. And anything else you can find to hit, really. ",shape=box,color=red];
		j268299921 -> j1408853212;
	j466314805 [label="It’s just pointless noise. Only Ventkids like it.",shape=box,color=red];
		j466314805 -> j2042220366;
	j3179472449 [label="+5 Chemistry",color=orange];
		j3179472449 -> j790707326;
	j736511760 [label="It was a different time. Back when punk was real punk. ",shape=box,color=blue];
		j736511760 -> j2479049550;
	j3799199768 [label="... sorry. Not my business to speculate. I'm just happy that he's happy.",shape=box,color=blue];
		j3799199768 -> "Chat ends.";
	j3884906024 [label="Weird what you can get homesick for, isn't it?",shape=box,color=blue];
		j3884906024 -> "Chat ends.";
	j1408853212 [label="It’s a Ventkid thing.",shape=box,color=red];
		j1408853212 -> j699056071;
	j2042220366 [label="Huh. 'Pointless noise'. I've heard that said before.",shape=box,color=blue];
		j2042220366 -> j63250298;
	j790707326 [label="I bloody wasn't, I can tell you that much.",shape=box,color=blue];
		j790707326 -> j2479049550;
	j2479049550 [label="... I just thought 'I wish she could see me now'. I think she'd like this version of me.",shape=box,color=blue];
		j2479049550 -> j388012931;
	j699056071 [label="+5 Chemistry",color=orange];
		j699056071 -> j129130098;
	j63250298 [label="I don't think anything's so pointless that it can't be the soundtrack to someone's youth.",shape=box,color=blue];
		j63250298 -> j1885441735;
	j388012931 [label="Gods, look at me, I've gone all soppy and nostalgic.",shape=box,color=blue];
		j388012931 -> j2962078689;
	j129130098 [label="Hmm. Sounds like survivor music. Wouldn’t mind having a listen if you get the chance to record some for me.",shape=box,color=blue];
		j129130098 -> j81848307;
	j1885441735 [label="I'd better stop. I'm getting sentimental.",shape=box,color=blue];
		j1885441735 -> "Chat ends.";
	j2962078689 [label="+5 Chemistry",color=orange];
		j2962078689 -> j723228234;
	j81848307 [label="Best keep it off the Mall speakers, though.",shape=box,color=blue];
		j81848307 -> "Chat ends.";
	j723228234 [label="Better get back to it. Thanks for the ear.",shape=box,color=blue];
		j723228234 -> "Chat ends.";
}