	3216 [label="Am I a minefield?",shape=box,color=blue];
		3216 -> 3217;
	3217 [label="Because Kaya says I am. And I had one of those ‘oh shit’ moments when you look back on all the conversations you’ve had with someone and you suddenly see yourself in a new light.",shape=box,color=blue];
