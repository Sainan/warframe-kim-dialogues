		3217 -> 3219;
		3217 -> 3220;
	3218 [label="No, you're not a minefield.",shape=box,color=red];
		3218 -> 3221;
	3219 [label="I think I know what she meant, yeah. Sorry, but she's right.",shape=box,color=red];
		3219 -> 3222;
	3220 [label="Wait, Kaya said this?",shape=box,color=red];
		3220 -> 3223;
	3221 [label="+5 Chemistry",color=orange];
		3221 -> 3224;
	3222 [label="oh.",shape=box,color=blue];
		3222 -> 3225;
		3222 -> 3226;
	3223 [label="Yes. She just dropped it into the middle of a chat we were having. 'You're cool but you're a minefield. I never know how you're going to react to anything.'",shape=box,color=blue];
		3223 -> 3218;
		3223 -> 3219;
	3224 [label="Glad to hear it. Thank you.",shape=box,color=blue];
		3224 -> 3227;
	3225 [label="I'm glad Kaya called you out on it. I've said things here I thought were harmless and you've reacted like I set your hair on fire.",shape=box,color=red];
		3225 -> 3228;
		3225 -> 3229;
	3226 [label="You have really extreme reactions sometimes. They're out of proportion to what I've said to you.",shape=box,color=red];
		3226 -> 3229;
		3226 -> 3228;
	3227 [label="Teenagers, eh? ",shape=box,color=blue];
		3227 -> 3230;
	3228 [label="It's like you leap straight to the worst possible interpretation of what I might have meant.",shape=box,color=red];
		3228 -> 3231;
	3229 [label="Sometimes you just quit the conversation entirely and I don't even get a chance to explain myself.",shape=box,color=red];
		3229 -> 3231;
	3230 [label="Chat ends.",color=orange];
	3231 [label="Well.",shape=box,color=blue];
		3231 -> 3232;
	3232 [label="Right now I feel like logging the hell off and never using KIM again.",shape=box,color=blue];
		3232 -> 3233;
		3232 -> 3234;
	3233 [label="Maybe think about what you just said there?",shape=box,color=red];
		3233 -> 3235;
	3234 [label="There you go. Boom. Minefield.",shape=box,color=red];
		3234 -> 3236;
		3234 -> 3235;
	3235 [label="Do you not see it?",shape=box,color=red];
		3235 -> 3237;
	3236 [label="I think you need some time to think about that. [END.]",shape=box,color=red];
		3236 -> 3238;
	3237 [label="Ok. Ok. Hear me out.",shape=box,color=blue];
		3237 -> 3239;
	3238 [label="Chat ends.",color=orange];
	3239 [label="Please.",shape=box,color=blue];
		3239 -> 3240;
	3240 [label="So bear this in mind:",shape=box,color=blue];
		3240 -> 3241;
	3241 [label="I'm telepathic. Didn't ask to be. But I am. I pick up on thoughts.",shape=box,color=blue];
		3241 -> 3242;
	3242 [label="If we're talking face to face then I have all sorts of cues that tell me what you're feeling",shape=box,color=blue];
		3242 -> 3243;
	3243 [label="expression, body language, and hey sometimes an actual THOUGHT because, like I said, TELEPATH",shape=box,color=blue];
		3243 -> 3244;
	3244 [label="but here on KIM I have to guess and there are no clues",shape=box,color=blue];
		3244 -> 3245;
	3245 [label="and so yes, I kneejerk sometimes.",shape=box,color=blue];
		3245 -> 3246;
		3245 -> 3247;
	3246 [label="No shit.",shape=box,color=red];
		3246 -> 3248;
	3247 [label="Yes. You do.",shape=box,color=red];
		3247 -> 3248;
	3248 [label="Right. So.",shape=box,color=blue];
		3248 -> 3249;
	3249 [label="(deep breath, sit up straight, get it together Eleanor)",shape=box,color=blue];
		3249 -> 3250;
	3250 [label="I will try my best not to be a minefield in future.",shape=box,color=blue];
		3250 -> 3251;
	3251 [label="And I'll have a look back through our old chats and have a good long think.",shape=box,color=blue];
