		j3166074897 -> j1857981775;
	j1857981775 [label="Am I a minefield?",shape=box,color=blue];
		j1857981775 -> j3335512506;
	j3335512506 [label="Because Kaya says I am. And I had one of those ‘oh shit’ moments when you look back on all the conversations you’ve had with someone and you suddenly see yourself in a new light.",shape=box,color=blue];
		j3335512506 -> j1080219781;
		j3335512506 -> j1082226677;
		j3335512506 -> j1478094253;
	j1080219781 [label="No, you're not a minefield.",shape=box,color=red];
		j1080219781 -> j566579021;
	j1082226677 [label="I think I know what she meant, yeah. Sorry, but she's right.",shape=box,color=red];
		j1082226677 -> j2700699045;
	j1478094253 [label="Wait, Kaya said this?",shape=box,color=red];
		j1478094253 -> j1359560726;
	j566579021 [label="+5 Chemistry",color=orange];
		j566579021 -> j1103198437;
	j2700699045 [label="oh.",shape=box,color=blue];
		j2700699045 -> j1574070519;
		j2700699045 -> j3400598714;
	j1359560726 [label="Yes. She just dropped it into the middle of a chat we were having. 'You're cool but you're a minefield. I never know how you're going to react to anything.'",shape=box,color=blue];
		j1359560726 -> j1080219781;
		j1359560726 -> j1082226677;
	j1103198437 [label="Glad to hear it. Thank you.",shape=box,color=blue];
		j1103198437 -> j301508046;
	j1574070519 [label="I'm glad Kaya called you out on it. I've said things here I thought were harmless and you've reacted like I set your hair on fire.",shape=box,color=red];
		j1574070519 -> j1917762026;
		j1574070519 -> j2058799613;
	j3400598714 [label="You have really extreme reactions sometimes. They're out of proportion to what I've said to you.",shape=box,color=red];
		j3400598714 -> j2058799613;
		j3400598714 -> j1917762026;
	j301508046 [label="Teenagers, eh? ",shape=box,color=blue];
		j301508046 -> "Chat ends.";
	j1917762026 [label="It's like you leap straight to the worst possible interpretation of what I might have meant.",shape=box,color=red];
		j1917762026 -> j3162331705;
	j2058799613 [label="Sometimes you just quit the conversation entirely and I don't even get a chance to explain myself.",shape=box,color=red];
		j2058799613 -> j3162331705;
	j3162331705 [label="Well.",shape=box,color=blue];
		j3162331705 -> j2396731814;
	j2396731814 [label="Right now I feel like logging the hell off and never using KIM again.",shape=box,color=blue];
		j2396731814 -> j2973824844;
		j2396731814 -> j2925933883;
	j2973824844 [label="Maybe think about what you just said there?",shape=box,color=red];
		j2973824844 -> j1699405025;
	j2925933883 [label="There you go. Boom. Minefield.",shape=box,color=red];
		j2925933883 -> j2667627583;
		j2925933883 -> j1699405025;
	j1699405025 [label="Do you not see it?",shape=box,color=red];
		j1699405025 -> j1285593938;
	j2667627583 [label="I think you need some time to think about that. [END.]",shape=box,color=red];
		j2667627583 -> "Chat ends.";
	j1285593938 [label="Ok. Ok. Hear me out.",shape=box,color=blue];
		j1285593938 -> j3533268785;
	j3533268785 [label="Please.",shape=box,color=blue];
		j3533268785 -> j570639030;
	j570639030 [label="So bear this in mind:",shape=box,color=blue];
		j570639030 -> j3708767767;
	j3708767767 [label="I'm telepathic. Didn't ask to be. But I am. I pick up on thoughts.",shape=box,color=blue];
		j3708767767 -> j1166769242;
	j1166769242 [label="If we're talking face to face then I have all sorts of cues that tell me what you're feeling",shape=box,color=blue];
		j1166769242 -> j776307128;
	j776307128 [label="expression, body language, and hey sometimes an actual THOUGHT because, like I said, TELEPATH",shape=box,color=blue];
		j776307128 -> j1942174948;
	j1942174948 [label="but here on KIM I have to guess and there are no clues",shape=box,color=blue];
		j1942174948 -> j3452718077;
	j3452718077 [label="and so yes, I kneejerk sometimes.",shape=box,color=blue];
		j3452718077 -> j3082459343;
		j3452718077 -> j2850009377;
	j3082459343 [label="No shit.",shape=box,color=red];
		j3082459343 -> j1303949118;
	j2850009377 [label="Yes. You do.",shape=box,color=red];
		j2850009377 -> j1303949118;
	j1303949118 [label="Right. So.",shape=box,color=blue];
		j1303949118 -> j4053449967;
	j4053449967 [label="(deep breath, sit up straight, get it together Eleanor)",shape=box,color=blue];
		j4053449967 -> j3247832740;
	j3247832740 [label="I will try my best not to be a minefield in future.",shape=box,color=blue];
		j3247832740 -> j3889108971;
	j3889108971 [label="And I'll have a look back through our old chats and have a good long think.",shape=box,color=blue];
		j3889108971 -> j1599611503;
	j1599611503 [label="I owe you that. Because minefield or not, you're still here. You kept walking. x",shape=box,color=blue];
		j1599611503 -> j4122200191;
