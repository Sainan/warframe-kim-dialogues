digraph {
	3285 [label="EleanorRank6Convo10 begins.",color=orange];
		3285 -> 3286;
	3286 [label="So I was thinking: the year's going to loop at the end of December like it always does and although it'll FEEL like a whole new year, it won't REALLY be",shape=box,color=blue];
		3286 -> 3287;
	3287 [label="and although I THINK I know how many times this has happened before, I actually don't, because I MIGHT NOT REMEMBER IT",shape=box,color=blue];
		3287 -> 3288;
	3288 [label="What if what I remember as Loop One was actually Loop Fifteen Thousand and Forty Two?",shape=box,color=blue];
		3288 -> 3289;
	3289 [label="and then I thought well, screw it, might as well go completely crazy and do whatever the hell I want because you can always punch the floor again and reset everything",shape=box,color=blue];
		3289 -> 3290;
	3290 [label="but THEN I thought no, wait, what if this is the one where it actually sticks? Where we finally go all the way from 1999 to 2000?",shape=box,color=blue];
		3290 -> 3291;
	3291 [label="I don't want to have made a complete berk of myself in the one loop that turns out to be the final decisive 1999. I'd never be able to unravel it.",shape=box,color=blue];
		3291 -> 3292;
	3292 [label="One day it'll be Solstice and not just endless winter, to use the tired old analogy",shape=box,color=blue];
		3292 -> 3293;
	3293 [label="Check boolean EleanorDating",color=orange];
		3293 -> 3295 [label=true,color=green];
		3293 -> 3294 [label=false,color=brown];
	3295 [label="You and I will just have to keep each other warm until then. x",shape=box,color=blue];
		3295 -> 3297;
	3294 [label="We all just have to keep one another warm till then.",shape=box,color=blue];
		3294 -> 3296;
