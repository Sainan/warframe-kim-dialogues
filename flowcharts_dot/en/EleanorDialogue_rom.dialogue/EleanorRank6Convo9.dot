digraph {
	3255 [label="EleanorRank6Convo9 begins.",color=orange];
		3255 -> 3256;
	3256 [label="So what's a 'Mara Lohk' when it's at home, as my mum would have put it?",shape=box,color=blue];
		3256 -> 3257;
		3256 -> 3258;
	3257 [label="It's what the Indifference calls me.",shape=box,color=red];
		3257 -> 3259;
	3258 [label="I don't know. It's Voidtongue.",shape=box,color=red];
		3258 -> 3259;
	3259 [label="Ah. Because I hear it in my head sometimes, very faintly, when I look at you.",shape=box,color=blue];
		3259 -> 3260;
	3260 [label="Check boolean EleanorDating",color=orange];
		3260 -> 3262 [label=true,color=green];
		3260 -> 3261 [label=false,color=brown];
	3262 [label="(Along with other things like 'phwoar' and 'bloody hell' and 'that's MY Drifter, that is.)",shape=box,color=blue];
		3262 -> 3263;
	3261 [label="(Along with other things like 'damn, they're cool' and 'that's my mate, that is'.)",shape=box,color=blue];
		3261 -> 3263;
	3263 [label="Are there any words in this language that you DO know?",shape=box,color=blue];
		3263 -> 3264;
	3264 [label="A few. ",shape=box,color=red];
		3264 -> 3265;
	3265 [label="Netra is 'Decay', Xata is 'Truth', Ris is 'Light'...",shape=box,color=red];
		3265 -> 3266;
	3266 [label="Lohk is 'Void', Oull is 'Possibility', Khra is 'Time'...",shape=box,color=red];
		3266 -> 3267;
	3267 [label="Good luck making a fridge magnet poem with those",shape=box,color=blue];
		3267 -> 3268;
	3268 [label="Hang on. If 'Lohk' is Void, then a Mara Lohk is a Something Void. Or a Void Something.",shape=box,color=blue];
		3268 -> 3269;
	3269 [label="Void Mare? Nightmare? Void devil?",shape=box,color=blue];
		3269 -> 3270;
		3269 -> 3271;
	3270 [label="Be careful. It's more than just a language.",shape=box,color=red];
		3270 -> 3272;
	3271 [label="I've been called worse.",shape=box,color=red];
		3271 -> 3273;
	3272 [label="Is this the moment when I look over my shoulder and see a black-eyed Eleanor grinning back at me?",shape=box,color=blue];
		3272 -> 3274;
	3273 [label="Don't be surprised if I come back and nag you about this more.",shape=box,color=blue];
		3273 -> 3275;
	3274 [label="I think I'll take a little look just to be sure....",shape=box,color=blue];
		3274 -> 3276;
	3275 [label="+5 Chemistry",color=orange];
		3275 -> 3277;
	3276 [label="OMFL",shape=box,color=blue];
		3276 -> 3278;
	3277 [label="Can't help prying. It's the journalist in me.",shape=box,color=blue];
		3277 -> 3279;
	3278 [label="What?",shape=box,color=red];
		3278 -> 3280;
	3279 [label="Chat ends.",color=orange];
	3280 [label="Spider",shape=box,color=blue];
		3280 -> 3281;
	3281 [label="Seriously?",shape=box,color=red];
		3281 -> 3282;
	3282 [label="I was all set to joke with you about how there was sod all there but there was a bastard great spider dangling from the ceiling",shape=box,color=blue];
