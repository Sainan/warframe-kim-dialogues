	"EleanorRank6Convo9 begins." [color=orange];
		"EleanorRank6Convo9 begins." -> j3949557396;
	j3949557396 [label="So what's a 'Mara Lohk' when it's at home, as my mum would have put it?",shape=box,color=blue];
		j3949557396 -> j3354949159;
		j3949557396 -> j3941072074;
	j3354949159 [label="It's what the Indifference calls me.",shape=box,color=red];
		j3354949159 -> j2262491992;
	j3941072074 [label="I don't know. It's Voidtongue.",shape=box,color=red];
		j3941072074 -> j2262491992;
	j2262491992 [label="Ah. Because I hear it in my head sometimes, very faintly, when I look at you.",shape=box,color=blue];
		j2262491992 -> j1403727449;
	j1403727449 [label="Check boolean EleanorDating",color=orange];
		j1403727449 -> j1383382543 [label=true,color=green];
		j1403727449 -> j245936942 [label=false,color=brown];
	j1383382543 [label="(Along with other things like 'phwoar' and 'bloody hell' and 'that's MY Drifter, that is.)",shape=box,color=blue];
		j1383382543 -> j129761338;
	j245936942 [label="(Along with other things like 'damn, they're cool' and 'that's my mate, that is'.)",shape=box,color=blue];
		j245936942 -> j129761338;
	j129761338 [label="Are there any words in this language that you DO know?",shape=box,color=blue];
		j129761338 -> j991064749;
	j991064749 [label="A few. ",shape=box,color=red];
		j991064749 -> j68663857;
	j68663857 [label="Netra is 'Decay', Xata is 'Truth', Ris is 'Light'...",shape=box,color=red];
		j68663857 -> j592629880;
	j592629880 [label="Lohk is 'Void', Oull is 'Possibility', Khra is 'Time'...",shape=box,color=red];
		j592629880 -> j960136630;
	j960136630 [label="Good luck making a fridge magnet poem with those",shape=box,color=blue];
		j960136630 -> j3316654915;
	j3316654915 [label="Hang on. If 'Lohk' is Void, then a Mara Lohk is a Something Void. Or a Void Something.",shape=box,color=blue];
		j3316654915 -> j3912187269;
	j3912187269 [label="Void Mare? Nightmare? Void devil?",shape=box,color=blue];
		j3912187269 -> j3238229925;
		j3912187269 -> j2523987931;
	j3238229925 [label="Be careful. It's more than just a language.",shape=box,color=red];
		j3238229925 -> j3086936277;
	j2523987931 [label="I've been called worse.",shape=box,color=red];
		j2523987931 -> j3333825867;
	j3086936277 [label="Is this the moment when I look over my shoulder and see a black-eyed Eleanor grinning back at me?",shape=box,color=blue];
		j3086936277 -> j1541369274;
	j3333825867 [label="Don't be surprised if I come back and nag you about this more.",shape=box,color=blue];
		j3333825867 -> j933361874;
	j1541369274 [label="I think I'll take a little look just to be sure....",shape=box,color=blue];
		j1541369274 -> j2195877298;
	j933361874 [label="+5 Chemistry",color=orange];
		j933361874 -> j2205358657;
	j2195877298 [label="OMFL",shape=box,color=blue];
		j2195877298 -> j708984062;
	j2205358657 [label="Can't help prying. It's the journalist in me.",shape=box,color=blue];
		j2205358657 -> "Chat ends.";
	j708984062 [label="What?",shape=box,color=red];
		j708984062 -> j2810627241;
	"Chat ends." [color=orange];
	j2810627241 [label="Spider",shape=box,color=blue];
		j2810627241 -> j3188859804;
	j3188859804 [label="Seriously?",shape=box,color=red];
		j3188859804 -> j2409913288;
	j2409913288 [label="I was all set to joke with you about how there was sod all there but there was a bastard great spider dangling from the ceiling",shape=box,color=blue];
		j2409913288 -> j564543304;
	j564543304 [label="talk later, need to get a glass and a bit of card",shape=box,color=blue];
		j564543304 -> "Chat ends.";
