digraph {
	3555 [label="ArthurRank6Convo9 begins.",color=orange];
		3555 -> 3556;
	3556 [label="I'm not sure about these... Infested guns Eleanor is collecting.",shape=box,color=blue];
		3556 -> 3557;
		3556 -> 3558;
	3557 [label="Why?",shape=box,color=red];
		3557 -> 3559;
	3558 [label="At least they don't talk.",shape=box,color=red];
		3558 -> 3560;
	3559 [label="Besides the fact that I think she can talk to them?",shape=box,color=blue];
		3559 -> 3561;
	3560 [label="To *us.* I'm not entirely sure that they don't talk to *her.*",shape=box,color=blue];
		3560 -> 3561;
	3561 [label="I do know they talk to the guitar. Which I really do not want to think about more than I need to.",shape=box,color=blue];
		3561 -> 3562;
	3562 [label="But should we be concerned about them...spreading? They do seem to multiply.",shape=box,color=blue];
		3562 -> 3563;
	3563 [label="Which I don't understand. Nor do I want to think too hard about where their ammunition comes from. Or what it is comprised of in the first place.",shape=box,color=blue];
		3563 -> 3564;
		3563 -> 3565;
	3564 [label="At least these Infested things are on our side?",shape=box,color=red];
		3564 -> 3566;
	3565 [label="You might just want to stick to the normal guns, then.",shape=box,color=red];
		3565 -> 3567;
	3566 [label="Sure. For *now.*",shape=box,color=blue];
		3566 -> 3568;
	3567 [label="I think I will.",shape=box,color=blue];
		3567 -> 3568;
	3568 [label="At least if my sidearm blows a hole in my foot I know I'm the idiot responsible.",shape=box,color=blue];
		3568 -> 3569;
	3569 [label="And not because my gun decided to rethink its loyalty or got a case of the midnight munchies.",shape=box,color=blue];
		3569 -> 3570;
	3570 [label="Chat ends.",color=orange];
}