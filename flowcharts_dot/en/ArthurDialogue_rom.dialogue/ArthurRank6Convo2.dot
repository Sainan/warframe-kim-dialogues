digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo2 begins." [color=orange];
		"ArthurRank6Convo2 begins." -> j1021441573;
	j1021441573 [label="I've been thinking. How many more of us do you think are out there?",shape=box,color=blue];
		j1021441573 -> j2890139917;
		j1021441573 -> j2028219684;
	j2890139917 [label="Do you mean here in 1999, or in a broader sense?",shape=box,color=red];
		j2890139917 -> j3241181958;
	j2028219684 [label="\"Us,\" meaning?",shape=box,color=red];
		j2028219684 -> j2491418957;
	j3241181958 [label="Both, I suppose. Here, now, in the past - in the future.",shape=box,color=blue];
		j3241181958 -> j1244269784;
	j2491418957 [label="Protoframes. Here, or anywhere. Or any*when* I suppose.",shape=box,color=blue];
		j2491418957 -> j1244269784;
	j1244269784 [label="Entrati made us with a purpose. With multiple purposes. It's clear it went past just the six of us. ",shape=box,color=blue];
		j1244269784 -> j3624989469;
		j1244269784 -> j1873960535;
	j3624989469 [label="At first, I thought he was making me \"spare\" warframes in case mine didn't come through the Helminth. Now, I'm not so sure.",shape=box,color=red];
		j3624989469 -> j2685867809;
	j1873960535 [label="I just wish I knew what he was up to. Or what his motivations really were, behind making more protoframes.",shape=box,color=red];
		j1873960535 -> j2036352833;
	j2685867809 [label="It made sense when there were just six of us.",shape=box,color=blue];
		j2685867809 -> j2036352833;
	j2036352833 [label="Do you honestly believe his real motivation is to stop the Indifference?",shape=box,color=blue];
		j2036352833 -> j2837258461;
	j2837258461 [label="Can we *really* trust him?",shape=box,color=blue];
		j2837258461 -> j907858451;
		j2837258461 -> j1584261894;
		j2837258461 -> j1283556711;
	j907858451 [label="I don't know, honestly. I don't trust him as far as I can throw him. And without a warframe, my throwing arm is shit.",shape=box,color=red];
		j907858451 -> j1434502464;
	j1584261894 [label="No. We can't trust his motives any more than we can trust his methods.",shape=box,color=red];
		j1584261894 -> j2244488359;
		j1584261894 -> j4100988379;
	j1283556711 [label="Yeah. I don't agree with his methods all the time. But yeah. He wants to stop that thing.",shape=box,color=red];
		j1283556711 -> j4100988379;
		j1283556711 -> j2244488359;
	j1434502464 [label="+5 Chemistry",color=orange];
		j1434502464 -> j4116031178;
	j2244488359 [label="He's trying to put the genie back in the proverbial bottle, if it can be done. And it's a messy process.",shape=box,color=red];
		j2244488359 -> j1865582095;
	j4100988379 [label="But we don't really have a choice, do we? All me and the kid can do is follow after him, cleaning up his messes. ",shape=box,color=red];
		j4100988379 -> j2386419850;
		j4100988379 -> j767798646;
	j4116031178 [label="Heh.",shape=box,color=blue];
		j4116031178 -> j2244488359;
		j4116031178 -> j4100988379;
	j1865582095 [label="And we're the school caretakers, scrubbing the floors after him. Lovely.",shape=box,color=blue];
		j1865582095 -> j2386419850;
		j1865582095 -> j767798646;
	j2386419850 [label="Now that Kaya's got her own take on time travel, it might get easier for me to go back and forth.",shape=box,color=red];
		j2386419850 -> j3420897080;
	j767798646 [label="But I'm staying here, so it's up to the kid, now.",shape=box,color=red];
		j767798646 -> j161265069;
	j3420897080 [label="That kid's a pain in the arse sometimes, but I do appreciate that.",shape=box,color=blue];
		j3420897080 -> j593157250;
	j161265069 [label="Check boolean ArthurDating",color=orange];
		j161265069 -> j1450783028 [label=true,color=green];
		j161265069 -> j2949518413 [label=false,color=brown];
	j593157250 [label="It's nice to know when you pop off to the shops... you might actually come back... :/",shape=box,color=blue];
		j593157250 -> j2613732724;
	j1450783028 [label="Eh. We'll see. I know you well enough, love. And I know you don't know when to keep your head down.",shape=box,color=blue];
		j1450783028 -> j3357312339;
	j2949518413 [label="Eh. We'll see. I know you well enough, Drifter. And I know you don't know when to keep your head down.",shape=box,color=blue];
		j2949518413 -> j3869736365;
	j2613732724 [label="Check boolean ArthurDating",color=orange];
		j2613732724 -> j4077074198 [label=true,color=green];
		j2613732724 -> j1875550791 [label=false,color=brown];
		j2613732724 -> j85627564 [label=false,color=brown];
	j3357312339 [label="It's one of the reasons I adore you as much as I do. ;)",shape=box,color=blue];
		j3357312339 -> j85627564;
	j3869736365 [label="It's one of the reasons I put up with having you around. ;)",shape=box,color=blue];
		j3869736365 -> j1875550791;
	j4077074198 [label="I owe her a great deal, giving me some semblance of peace of mind. :)",shape=box,color=blue];
		j4077074198 -> j1875550791;
		j4077074198 -> j85627564;
	j1875550791 [label="An emoticon! :D",shape=box,color=red];
		j1875550791 -> j3952597878;
	j85627564 [label="Don't go getting all sappy on me. ",shape=box,color=red];
		j85627564 -> j992397945;
	j3952597878 [label="Yeah, yeah. Don't go getting used to it. It still feels weird.",shape=box,color=blue];
		j3952597878 -> j2196902107;
	j992397945 [label="Mm, you know me. Crunchy on the outside, squishy in the middle. Like a stale version of those horrid pastries Amir and Velimir keep going on about.",shape=box,color=blue];
		j992397945 -> j3451054378;
	j2196902107 [label="Well, I'm flattered.",shape=box,color=red];
		j2196902107 -> j299714428;
	j3451054378 [label="Tweebies?",shape=box,color=blue];
		j3451054378 -> j299714428;
	j299714428 [label="Anyway. Back on topic. Sometimes I get this sinking feeling that Entrati has a bigger purpose for us all.",shape=box,color=blue];
		j299714428 -> j1308404632;
		j299714428 -> j3114797017;
		j299714428 -> j1165299442;
	j1308404632 [label="What makes you say that?",shape=box,color=red];
		j1308404632 -> j1249167697;
	j3114797017 [label="Yeah, you might be right.",shape=box,color=red];
		j3114797017 -> j3631249275;
	j1165299442 [label="Could that just be wishful thinking?",shape=box,color=red];
		j1165299442 -> j2193818460;
	j1249167697 [label="The amount of effort he's put in to creating us? And the fact that there are more than just the six...",shape=box,color=blue];
		j1249167697 -> j3716544984;
	j3631249275 [label="What do you think it is? And what is he waiting for?",shape=box,color=blue];
		j3631249275 -> j3678796328;
		j3631249275 -> j3047666253;
	j2193818460 [label="What do you mean?",shape=box,color=blue];
		j2193818460 -> j287211398;
		j2193818460 -> j634852241;
	j3716544984 [label="You don't build weapons like these unless you know you're going to use them, mate.",shape=box,color=blue];
		j3716544984 -> j3226163207;
	j3678796328 [label="<RETRO_EMOJI_SHRUG>",shape=box,color=red];
		j3678796328 -> j3615700606;
	j3047666253 [label="I wish I knew, on both fronts.",shape=box,color=red];
		j3047666253 -> j3615700606;
	j287211398 [label="Sometimes it's hard to think that you're no longer \"important.\"",shape=box,color=red];
		j287211398 -> j2539069160;
	j634852241 [label="Well, I'm just saying that... maybe you don't want to feel abandoned by him.",shape=box,color=red];
		j634852241 -> j736254899;
	j3226163207 [label="Unless you *know* there's going to be a war.",shape=box,color=blue];
		j3226163207 -> j451125157;
		j3226163207 -> j2355107571;
		j3226163207 -> j507512401;
	j3615700606 [label="Maybe he needs an army? Maybe he's trying to find \"the one thing\" he thinks can defeat the Indifference. Maybe a lot of things.",shape=box,color=red];
		j3615700606 -> j2751101679;
	j2539069160 [label="Right...",shape=box,color=blue];
		j2539069160 -> "Chat ends.";
	j736254899 [label="That whatever he was here for, that whatever he did to you, still matters. Is still valid. That it didn't fail.",shape=box,color=red];
		j736254899 -> j2955908420;
		j736254899 -> j3759716954;
	j451125157 [label="Then all we can do is be prepared if that happens.",shape=box,color=red];
		j451125157 -> j2949633280;
	j2355107571 [label="It's possible. But Entrati also seems to be the kind of person to have contingency plans. ",shape=box,color=red];
		j2355107571 -> j2621144779;
	j507512401 [label="I don't know. Minerva and Velimir were telling me about the... \"Cold War?\" Sounds like people built a lot of crazy weapons and then never used them.",shape=box,color=red];
		j507512401 -> j2746105722;
	j2751101679 [label="Can't help but think we're bullets in a gun. Meant to be used. Spent. And thrown away.",shape=box,color=blue];
		j2751101679 -> j3133326661;
		j2751101679 -> j2193069126;
	"Chat ends." [color=orange];
	j2955908420 [label="And to be clear, you still matter.",shape=box,color=red];
		j2955908420 -> j648814371;
		j2955908420 -> j2322432679;
		j2955908420 -> j1697574406;
	j3759716954 [label="And to be clear, you still matter to *me.* ",shape=box,color=red];
		j3759716954 -> j648814371;
		j3759716954 -> j2322432679;
		j3759716954 -> j1697574406;
	j2949633280 [label="+5 Chemistry",color=orange];
		j2949633280 -> j103181199;
	j2621144779 [label="Maybe.",shape=box,color=blue];
		j2621144779 -> j706507189;
	j2746105722 [label="Fair counter point. But that's between countries, involving diplomacy. Moving parts.",shape=box,color=blue];
		j2746105722 -> j3874687273;
	j3133326661 [label="I wish I could tell you. But I will do everything I can to stop that from happening.",shape=box,color=red];
		j3133326661 -> j3746804497;
	j2193069126 [label="You don't think you're done yet?",shape=box,color=red];
		j2193069126 -> j4215329095;
	j648814371 [label="But to think your story ends here, without a part to play in how it all ends? That sucks.",shape=box,color=red];
		j648814371 -> j554937186;
	j2322432679 [label="But maybe it hurts to think you've been replaced by Arthur 2.0 out there somewhere.",shape=box,color=red];
		j2322432679 -> j3754490517;
	j1697574406 [label="But maybe you just want your sacrifices to still matter in a more cosmic sense?",shape=box,color=red];
		j1697574406 -> j2158199146;
	j103181199 [label="Agreed.",shape=box,color=blue];
		j103181199 -> j414765375;
	j706507189 [label="Part of me does hope more of us exist out there. But if they do end up coming here? We might end up needing a bigger mall.",shape=box,color=blue];
		j706507189 -> "Chat ends.";
	j3874687273 [label="This is between a literal god and a man who thinks he's one.",shape=box,color=blue];
		j3874687273 -> j3103847326;
	j3746804497 [label="I know you will. And we'll face that day together, and I have confidence in that.",shape=box,color=blue];
		j3746804497 -> j2397353713;
	j4215329095 [label="No. You don't build weapons like these unless you know you're going to use them, mate.",shape=box,color=blue];
		j4215329095 -> j3646513959;
		j4215329095 -> j2355107571;
		j4215329095 -> j451125157;
	j554937186 [label="That might be a part of it. If the Indifference is a reason I'm like this? And had to go through this?",shape=box,color=blue];
		j554937186 -> j616114508;
	j3754490517 [label="Mate, I was ready to retire before I got sucked into this nonsense. Hardly.",shape=box,color=blue];
		j3754490517 -> j2025388846;
	j2158199146 [label="Maybe. Maybe not. But how many people's sacrifices mean nothing, in life? Most.",shape=box,color=blue];
		j2158199146 -> j3386930422;
	j414765375 [label="And hope that if any more of us show up here? We won't end up needing a bigger mall.",shape=box,color=blue];
		j414765375 -> "Chat ends.";
	j3103847326 [label="My money is on an inevitable collision. I don't think their egos would allow otherwise.",shape=box,color=blue];
		j3103847326 -> j3912848122;
		j3103847326 -> j3053530201;
	j2397353713 [label="+5 Chemistry",color=orange];
		j2397353713 -> j1648722223;
	j3646513959 [label="I don't know. Minerva and Velimir were telling me about the... \"Cold War?\" Sounds like people built a lot of crazy weapons and then never used them.",shape=box,color=red];
		j3646513959 -> j4253583776;
	j616114508 [label="I want a hand in bringing it down.",shape=box,color=blue];
		j616114508 -> j3808525260;
	j2025388846 [label="I am still astonished at your ability to utterly step in it, sometimes.",shape=box,color=blue];
		j2025388846 -> "Chat ends.";
	j3386930422 [label="Maybe I'm just mourning the idea of a whole army of us out there, being made by a madman with no clear idea why. Or what for.",shape=box,color=blue];
		j3386930422 -> j2786024567;
	j3912848122 [label="You might be right.",shape=box,color=red];
		j3912848122 -> j1121317034;
	j3053530201 [label="I really hope you're wrong.",shape=box,color=red];
		j3053530201 -> j343351729;
	j1648722223 [label="Check boolean ArthurDating",color=orange];
		j1648722223 -> j532436438 [label=true,color=green];
		j1648722223 -> j2505493714 [label=false,color=brown];
	j4253583776 [label="Fair counter point. But that's between countries, involving diplomacy. Moving parts.",shape=box,color=blue];
		j4253583776 -> j280682744;
	j3808525260 [label="+5 Chemistry",color=orange];
		j3808525260 -> j2521749123;
	j2786024567 [label="Being told to suffer and being told to sacrifice - with no clear idea why. Or what for.",shape=box,color=blue];
		j2786024567 -> j1614735841;
	j1121317034 [label="+5 Chemistry",color=orange];
		j1121317034 -> j3618504663;
	j343351729 [label="+5 Chemistry",color=orange];
		j343351729 -> j373608574;
	j532436438 [label="Thanks, love.",shape=box,color=blue];
		j532436438 -> "Chat ends.";
	j2505493714 [label="Thanks, Drifter.",shape=box,color=blue];
		j2505493714 -> "Chat ends.";
	j280682744 [label="This is between a literal god and a man who thinks he's one.",shape=box,color=blue];
		j280682744 -> j2069355391;
	j2521749123 [label="I don't want to be abandoned as a footnote in history. I want to put this skana straight up its arse.",shape=box,color=blue];
		j2521749123 -> j4196185503;
		j2521749123 -> j715667738;
	j1614735841 [label="Maybe that's the pill I'm having a hard time swallowing, mate.",shape=box,color=blue];
		j1614735841 -> "Chat ends.";
	j3618504663 [label="For what it's worth? I hope I'm not.",shape=box,color=blue];
		j3618504663 -> j937801564;
	j373608574 [label="For what it's worth? I hope I am.",shape=box,color=blue];
		j373608574 -> j937801564;
	j2069355391 [label="My money is on an inevitable collision. I don't think their egos would allow otherwise.",shape=box,color=blue];
		j2069355391 -> j3912848122;
		j2069355391 -> j3053530201;
	j4196185503 [label="I'll see what I can do. ;)",shape=box,color=red];
		j4196185503 -> j3021743804;
	j715667738 [label="You 'n me both. And maybe Entrati while we're at it.",shape=box,color=red];
		j715667738 -> j2717944848;
	j937801564 [label="There are no victors in war. Only survivors.",shape=box,color=blue];
		j937801564 -> "Chat ends.";
	j3021743804 [label="Heh.",shape=box,color=blue];
		j3021743804 -> j3738824838;
	j2717944848 [label="+5 Chemistry",color=orange];
		j2717944848 -> j507740716;
	j3738824838 [label="Check boolean ArthurDating",color=orange];
		j3738824838 -> j532436438 [label=true,color=green];
		j3738824838 -> j2505493714 [label=false,color=brown];
	j507740716 [label="Now you're talking.",shape=box,color=blue];
		j507740716 -> j3738824838;
}