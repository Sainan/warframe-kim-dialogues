digraph {
	3229 [label="ArthurRank6Convo2 begins.",color=orange];
		3229 -> 3230;
	3230 [label="I've been thinking. How many more of us do you think are out there?",shape=box,color=blue];
		3230 -> 3231;
		3230 -> 3232;
	3231 [label="Do you mean here in 1999, or in a broader sense?",shape=box,color=red];
		3231 -> 3233;
	3232 [label="\"Us,\" meaning?",shape=box,color=red];
		3232 -> 3234;
	3233 [label="Both, I suppose. Here, now, in the past - in the future.",shape=box,color=blue];
		3233 -> 3235;
	3234 [label="Protoframes. Here, or anywhere. Or any*when* I suppose.",shape=box,color=blue];
		3234 -> 3235;
	3235 [label="Entrati made us with a purpose. With multiple purposes. It's clear it went past just the six of us. ",shape=box,color=blue];
		3235 -> 3236;
		3235 -> 3237;
	3236 [label="At first, I thought he was making me \"spare\" warframes in case mine didn't come through the Helminth. Now, I'm not so sure.",shape=box,color=red];
		3236 -> 3238;
	3237 [label="I just wish I knew what he was up to. Or what his motivations really were, behind making more protoframes.",shape=box,color=red];
		3237 -> 3239;
	3238 [label="It made sense when there were just six of us.",shape=box,color=blue];
		3238 -> 3239;
	3239 [label="Do you honestly believe his real motivation is to stop the Indifference?",shape=box,color=blue];
		3239 -> 3240;
	3240 [label="Can we *really* trust him?",shape=box,color=blue];
		3240 -> 3241;
		3240 -> 3242;
		3240 -> 3243;
	3241 [label="I don't know, honestly. I don't trust him as far as I can throw him. And without a warframe, my throwing arm is shit.",shape=box,color=red];
		3241 -> 3244;
	3242 [label="No. We can't trust his motives any more than we can trust his methods.",shape=box,color=red];
		3242 -> 3245;
		3242 -> 3246;
	3243 [label="Yeah. I don't agree with his methods all the time. But yeah. He wants to stop that thing.",shape=box,color=red];
		3243 -> 3246;
		3243 -> 3245;
	3244 [label="+5 Chemistry",color=orange];
		3244 -> 3247;
	3245 [label="He's trying to put the genie back in the proverbial bottle, if it can be done. And it's a messy process.",shape=box,color=red];
		3245 -> 3248;
	3246 [label="But we don't really have a choice, do we? All me and the kid can do is follow after him, cleaning up his messes. ",shape=box,color=red];
		3246 -> 3249;
		3246 -> 3250;
	3247 [label="Heh.",shape=box,color=blue];
		3247 -> 3245;
		3247 -> 3246;
	3248 [label="And we're the school caretakers, scrubbing the floors after him. Lovely.",shape=box,color=blue];
		3248 -> 3249;
		3248 -> 3250;
	3249 [label="Now that Kaya's got her own take on time travel, it might get easier for me to go back and forth.",shape=box,color=red];
		3249 -> 3251;
	3250 [label="But I'm staying here, so it's up to the kid, now.",shape=box,color=red];
		3250 -> 3254;
	3251 [label="That kid's a pain in the arse sometimes, but I do appreciate that.",shape=box,color=blue];
		3251 -> 3253;
	3254 [label="Check boolean ArthurDating",color=orange];
		3254 -> 3603 [label=true,color=green];
		3254 -> 3252 [label=false,color=brown];
	3253 [label="It's nice to know when you pop off to the shops... you might actually come back... :/",shape=box,color=blue];
		3253 -> 3255;
	3603 [label="Eh. We'll see. I know you well enough, love. And I know you don't know when to keep your head down.",shape=box,color=blue];
		3603 -> 3257;
	3252 [label="Eh. We'll see. I know you well enough, Drifter. And I know you don't know when to keep your head down.",shape=box,color=blue];
		3252 -> 3256;
	3255 [label="Check boolean ArthurDating",color=orange];
		3255 -> 3260 [label=true,color=green];
		3255 -> 3258 [label=false,color=brown];
		3255 -> 3259 [label=false,color=brown];
	3257 [label="It's one of the reasons I adore you as much as I do. ;)",shape=box,color=blue];
		3257 -> 3259;
	3256 [label="It's one of the reasons I put up with having you around. ;)",shape=box,color=blue];
		3256 -> 3258;
	3260 [label="I owe her a great deal, giving me some semblance of peace of mind. :)",shape=box,color=blue];
		3260 -> 3258;
		3260 -> 3259;
	3258 [label="An emoticon! :D",shape=box,color=red];
		3258 -> 3261;
	3259 [label="Don't go getting all sappy on me. ",shape=box,color=red];
		3259 -> 3262;
	3261 [label="Yeah, yeah. Don't go getting used to it. It still feels weird.",shape=box,color=blue];
		3261 -> 3263;
	3262 [label="Mm, you know me. Crunchy on the outside, squishy in the middle. Like a stale version of those horrid pastries Amir and Velimir keep going on about.",shape=box,color=blue];
		3262 -> 3264;
	3263 [label="Well, I'm flattered.",shape=box,color=red];
		3263 -> 3265;
	3264 [label="Tweebies?",shape=box,color=blue];
		3264 -> 3265;
	3265 [label="Anyway. Back on topic. Sometimes I get this sinking feeling that Entrati has a bigger purpose for us all.",shape=box,color=blue];
		3265 -> 3266;
		3265 -> 3267;
		3265 -> 3268;
	3266 [label="What makes you say that?",shape=box,color=red];
		3266 -> 3269;
	3267 [label="Yeah, you might be right.",shape=box,color=red];
		3267 -> 3270;
	3268 [label="Could that just be wishful thinking?",shape=box,color=red];
		3268 -> 3271;
	3269 [label="The amount of effort he's put in to creating us? And the fact that there are more than just the six...",shape=box,color=blue];
		3269 -> 3272;
	3270 [label="What do you think it is? And what is he waiting for?",shape=box,color=blue];
		3270 -> 3273;
		3270 -> 3274;
	3271 [label="What do you mean?",shape=box,color=blue];
		3271 -> 3275;
		3271 -> 3276;
	3272 [label="You don't build weapons like these unless you know you're going to use them, mate.",shape=box,color=blue];
		3272 -> 3277;
	3273 [label="<RETRO_EMOJI_SHRUG>",shape=box,color=red];
		3273 -> 3278;
	3274 [label="I wish I knew, on both fronts.",shape=box,color=red];
		3274 -> 3278;
	3275 [label="Sometimes it's hard to think that you're no longer \"important.\"",shape=box,color=red];
		3275 -> 3279;
	3276 [label="Well, I'm just saying that... maybe you don't want to feel abandoned by him.",shape=box,color=red];
		3276 -> 3280;
	3277 [label="Unless you *know* there's going to be a war.",shape=box,color=blue];
		3277 -> 3281;
		3277 -> 3282;
		3277 -> 3283;
	3278 [label="Maybe he needs an army? Maybe he's trying to find \"the one thing\" he thinks can defeat the Indifference. Maybe a lot of things.",shape=box,color=red];
		3278 -> 3284;
	3279 [label="Right...",shape=box,color=blue];
		3279 -> 3285;
	3280 [label="That whatever he was here for, that whatever he did to you, still matters. Is still valid. That it didn't fail.",shape=box,color=red];
		3280 -> 3286;
		3280 -> 3287;
	3281 [label="Then all we can do is be prepared if that happens.",shape=box,color=red];
		3281 -> 3288;
	3282 [label="It's possible. But Entrati also seems to be the kind of person to have contingency plans. ",shape=box,color=red];
		3282 -> 3289;
	3283 [label="I don't know. Minerva and Velimir were telling me about the... \"Cold War?\" Sounds like people built a lot of crazy weapons and then never used them.",shape=box,color=red];
		3283 -> 3290;
	3284 [label="Can't help but think we're bullets in a gun. Meant to be used. Spent. And thrown away.",shape=box,color=blue];
		3284 -> 3291;
		3284 -> 3292;
	3285 [label="Chat ends.",color=orange];
	3286 [label="And to be clear, you still matter.",shape=box,color=red];
		3286 -> 3293;
		3286 -> 3294;
		3286 -> 3295;
	3287 [label="And to be clear, you still matter to *me.* ",shape=box,color=red];
		3287 -> 3293;
		3287 -> 3294;
		3287 -> 3295;
	3288 [label="+5 Chemistry",color=orange];
		3288 -> 3296;
	3289 [label="Maybe.",shape=box,color=blue];
		3289 -> 3297;
	3290 [label="Fair counter point. But that's between countries, involving diplomacy. Moving parts.",shape=box,color=blue];
		3290 -> 3298;
	3291 [label="I wish I could tell you. But I will do everything I can to stop that from happening.",shape=box,color=red];
		3291 -> 3299;
	3292 [label="You don't think you're done yet?",shape=box,color=red];
		3292 -> 3300;
	3293 [label="But to think your story ends here, without a part to play in how it all ends? That sucks.",shape=box,color=red];
		3293 -> 3301;
	3294 [label="But maybe it hurts to think you've been replaced by Arthur 2.0 out there somewhere.",shape=box,color=red];
		3294 -> 3302;
	3295 [label="But maybe you just want your sacrifices to still matter in a more cosmic sense?",shape=box,color=red];
		3295 -> 3303;
	3296 [label="Agreed.",shape=box,color=blue];
		3296 -> 3304;
	3297 [label="Part of me does hope more of us exist out there. But if they do end up coming here? We might end up needing a bigger mall.",shape=box,color=blue];
		3297 -> 3305;
	3298 [label="This is between a literal god and a man who thinks he's one.",shape=box,color=blue];
		3298 -> 3306;
	3299 [label="I know you will. And we'll face that day together, and I have confidence in that.",shape=box,color=blue];
		3299 -> 3307;
	3300 [label="No. You don't build weapons like these unless you know you're going to use them, mate.",shape=box,color=blue];
		3300 -> 3308;
		3300 -> 3309;
		3300 -> 3310;
	3301 [label="That might be a part of it. If the Indifference is a reason I'm like this? And had to go through this?",shape=box,color=blue];
		3301 -> 3311;
	3302 [label="Mate, I was ready to retire before I got sucked into this nonsense. Hardly.",shape=box,color=blue];
		3302 -> 3312;
	3303 [label="Maybe. Maybe not. But how many people's sacrifices mean nothing, in life? Most.",shape=box,color=blue];
		3303 -> 3313;
	3304 [label="And hope that if any more of us show up here? We won't end up needing a bigger mall.",shape=box,color=blue];
		3304 -> 3314;
	3305 [label="Chat ends.",color=orange];
	3306 [label="My money is on an inevitable collision. I don't think their egos would allow otherwise.",shape=box,color=blue];
		3306 -> 3315;
		3306 -> 3316;
	3307 [label="+5 Chemistry",color=orange];
		3307 -> 3317;
	3308 [label="I don't know. Minerva and Velimir were telling me about the... \"Cold War?\" Sounds like people built a lot of crazy weapons and then never used them.",shape=box,color=red];
		3308 -> 3318;
	3309 [label="It's possible. But Entrati also seems to be the kind of person to have contingency plans. ",shape=box,color=red];
		3309 -> 3319;
	3310 [label="Then all we can do is be prepared if that happens.",shape=box,color=red];
		3310 -> 3320;
	3311 [label="I want a hand in bringing it down.",shape=box,color=blue];
		3311 -> 3321;
	3312 [label="I am still astonished at your ability to utterly step in it, sometimes.",shape=box,color=blue];
		3312 -> 3322;
	3313 [label="Maybe I'm just mourning the idea of a whole army of us out there, being made by a madman with no clear idea why. Or what for.",shape=box,color=blue];
		3313 -> 3323;
	3314 [label="Chat ends.",color=orange];
