digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo4 begins." [color=orange];
		"ArthurRank6Convo4 begins." -> j408319438;
	j408319438 [label="Odd question. Do they have toys in space?",shape=box,color=blue];
		j408319438 -> j1263929547;
		j408319438 -> j1578366175;
	j1263929547 [label="Like, children's toys? Of course.",shape=box,color=red];
		j1263929547 -> j387694213;
	j1578366175 [label="What... kind of toys?",shape=box,color=red];
		j1578366175 -> j525162145;
	j387694213 [label="Heh. Really?",shape=box,color=blue];
		j387694213 -> j3312790162;
	j525162145 [label="OH, SOL. That's not what I meant, and you know it!",shape=box,color=blue];
		j525162145 -> j1596767414;
	j3312790162 [label="Hard to picture some umpteenth-some-odd-whatever thousands of years in the future,",shape=box,color=blue];
		j3312790162 -> j3986594818;
	j1596767414 [label="I mean, children's toys. Dolls. Action figures. Things like that.",shape=box,color=blue];
		j1596767414 -> j1877919595;
		j1596767414 -> j3341196529;
	j3986594818 [label="Kids are still sitting around reenacting stories with little figurines and playing \"bandits\" or \"save the princess.\"",shape=box,color=blue];
		j3986594818 -> j3206087200;
		j3986594818 -> j2715800952;
		j3986594818 -> j2444560503;
	j1877919595 [label="Just giving you a hard time. :P",shape=box,color=red];
		j1877919595 -> j4260157313;
	j3341196529 [label="No, we don't. [End.]",shape=box,color=red];
		j3341196529 -> "Chat ends.";
	j3206087200 [label="What brought this on?",shape=box,color=red];
		j3206087200 -> j6193351;
	j2715800952 [label="What did you grow up playing with?",shape=box,color=red];
		j2715800952 -> j484541311;
	j2444560503 [label="We have different names for the games we play, but I definitely had toys.",shape=box,color=red];
		j2444560503 -> j3473637151;
	j4260157313 [label="Yeah, of course we do. ",shape=box,color=red];
		j4260157313 -> j387694213;
	"Chat ends." [color=orange];
	j6193351 [label="I was actually watching Amir playing one of his arcade games. ",shape=box,color=blue];
		j6193351 -> j931051472;
	j484541311 [label="It's rather comforting thinking that despite all the differences between our cultures, kids still just... sit down and play with toys.",shape=box,color=blue];
		j484541311 -> j3124688529;
	j3473637151 [label="Like what?",shape=box,color=blue];
		j3473637151 -> j518221768;
		j3473637151 -> j18304627;
	j931051472 [label="And I was thinking to myself - what I wouldn't give to have that kind of joy in my life again.",shape=box,color=blue];
		j931051472 -> j566342218;
	j3124688529 [label="I had this action figure. Action Angus. He was a soldier, no surprise there.",shape=box,color=blue];
		j3124688529 -> j1407560912;
	j518221768 [label="All sorts of figurines, and stuffed animals, and blocks. Typical kid stuff. ",shape=box,color=red];
		j518221768 -> j484541311;
	j18304627 [label="I had this one - I guess you could call it a figurine - of this Dax child, that, well, I named after a character in a book I had. Dominus Thrax.",shape=box,color=red];
		j18304627 -> j555612916;
	j566342218 [label="I've never looked down my nose at Aoi, or Amir, or even now Kaya for finding fun in \"childish\" things. It's never bothered me.",shape=box,color=blue];
		j566342218 -> j2407314059;
	j1407560912 [label="One solstice celebration, a bunch of the older boys stole it from me along with a bunch of my other toys and, well...",shape=box,color=blue];
		j1407560912 -> j719236302;
	j555612916 [label="Oh, bollocks. I should've known. I'm so sorry that I brought this up.",shape=box,color=blue];
		j555612916 -> j1367780169;
		j555612916 -> j3513696562;
	j2407314059 [label="But sometimes I'm afraid that the part of me that's capable of feeling that curled up and died a long time ago.",shape=box,color=blue];
		j2407314059 -> j3629987731;
	j719236302 [label="It's a long story. Short of it? I was \"too old,\" they said, to be playing with dollies. That was the last time I ever played with toys.",shape=box,color=blue];
		j719236302 -> j2055951009;
	j1367780169 [label="Not the best topic for me to discuss, no.",shape=box,color=red];
		j1367780169 -> j2979701950;
	j3513696562 [label="It's all right. It's not your fault.",shape=box,color=red];
		j3513696562 -> j1221557722;
	j3629987731 [label="Kind of sad, isn't it? That we tell children to love something, and then we tell them to give it up when they've \"matured.\"",shape=box,color=blue];
		j3629987731 -> j4282288749;
		j3629987731 -> j618415722;
	j2055951009 [label="The other day, I was watching Amir play one of his games. It's clear how much he's attached it. How much happiness it brings him. And I was a bit jealous that I don't have anything like that in my life.",shape=box,color=blue];
		j2055951009 -> j3629987731;
	j2979701950 [label="Now I feel like an absolute knobhead.",shape=box,color=blue];
		j2979701950 -> "Chat ends.";
	j1221557722 [label="We had all the normal toys you'd expect, I suppose. Blocks, stuffed animals, figurines, dolls.",shape=box,color=red];
		j1221557722 -> j429771563;
	j4282288749 [label="I don't know. We all have to grow up sometime. We can't hide ourselves away with make-believe. I learned that the hard way.",shape=box,color=red];
		j4282288749 -> j3624449156;
	j618415722 [label="I think life can be ugly and painful and short. And we should fill it with as much fun, and laughter, and love as we can find.",shape=box,color=red];
		j618415722 -> j1205297577;
	j429771563 [label="Mine only became a little more problematic because of the whole... Void thing.",shape=box,color=red];
		j429771563 -> j484541311;
	j3624449156 [label="You make a fair point. I think when it becomes a replacement for the real thing, it's a problem. I'm not suggesting that.",shape=box,color=blue];
		j3624449156 -> j2546049378;
	j1205297577 [label="You're right. And I hope it's something we remember, as we go forward together in... whatever this is that we're in.",shape=box,color=blue];
		j1205297577 -> j2546049378;
	j2546049378 [label="You know, I found Eleanor, Velimir, Aoi, and Amir, playing hide-and-seek with Flare and Lizzie. (Quincy said he wasn't allowed to play because the bastard was cheating and was using his scope to see through walls.)",shape=box,color=blue];
		j2546049378 -> j3697925924;
	j3697925924 [label="They were all looking at me worried I was going to be upset I caught them mucking about when they should be doing something useful.",shape=box,color=blue];
		j3697925924 -> j4237189351;
	j4237189351 [label="I was more upset that I wasn't invited. Heh. But I had to put on the grumpy leader face and pretend I was upset that the posts were left unmanned, etcetera.",shape=box,color=blue];
		j4237189351 -> j1019511816;
	j1019511816 [label="But Amir has his games. Aoi has On-lyne. Even Kaya has her stickers and her Jinymon, for all that the world has forced adulthood on her too soon.",shape=box,color=blue];
		j1019511816 -> j1122412657;
		j1019511816 -> j553041465;
	j1122412657 [label="Is there a point you're trying to make?",shape=box,color=red];
		j1122412657 -> j4146223720;
	j553041465 [label="I think it's something you could get back, if you tried. Finding joy in toys and games, I mean.",shape=box,color=red];
		j553041465 -> j885688958;
	j4146223720 [label="Honestly? I'm not even sure. Only that I feel like I'm missing something that's been gone from my life for a very long time.",shape=box,color=blue];
		j4146223720 -> j2856420394;
	j885688958 [label="I can just hear the laughter now. But I suppose that's really what's holding me back, isn't it? Embarrassment.",shape=box,color=blue];
		j885688958 -> j3546357931;
	j2856420394 [label="I'm not sure if I can ever get it back. Or if it's too far gone. But who knows. With enough time, maybe anything is possible.",shape=box,color=blue];
		j2856420394 -> "Chat ends.";
	j3546357931 [label="I'm not sure it's possible to get it back, even if I could push through the momentary shame. But who knows. With enough loops, maybe anything is possible.",shape=box,color=blue];
		j3546357931 -> "Chat ends.";
}