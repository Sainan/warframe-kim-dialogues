digraph {
	3433 [label="ArthurRank6Convo4 begins.",color=orange];
		3433 -> 3434;
	3434 [label="Odd question. Do they have toys in space?",shape=box,color=blue];
		3434 -> 3435;
		3434 -> 3436;
	3435 [label="Like, children's toys? Of course.",shape=box,color=red];
		3435 -> 3437;
	3436 [label="What... kind of toys?",shape=box,color=red];
		3436 -> 3438;
	3437 [label="Heh. Really?",shape=box,color=blue];
		3437 -> 3439;
	3438 [label="OH, SOL. That's not what I meant, and you know it!",shape=box,color=blue];
		3438 -> 3440;
	3439 [label="Hard to picture some umpteenth-some-odd-whatever thousands of years in the future,",shape=box,color=blue];
		3439 -> 3441;
	3440 [label="I mean, children's toys. Dolls. Action figures. Things like that.",shape=box,color=blue];
		3440 -> 3442;
		3440 -> 3448;
	3441 [label="Kids are still sitting around reenacting stories with little figurines and playing \"bandits\" or \"save the princess.\"",shape=box,color=blue];
		3441 -> 3444;
		3441 -> 3445;
		3441 -> 3446;
	3442 [label="Just giving you a hard time. :P",shape=box,color=red];
		3442 -> 3447;
	3448 [label="No, we don't. [End.]",shape=box,color=red];
		3448 -> 3452;
	3444 [label="What brought this on?",shape=box,color=red];
		3444 -> 3449;
	3445 [label="What did you grow up playing with?",shape=box,color=red];
		3445 -> 3450;
	3446 [label="We have different names for the games we play, but I definitely had toys.",shape=box,color=red];
		3446 -> 3451;
	3447 [label="Yeah, of course we do. ",shape=box,color=red];
		3447 -> 3437;
	3452 [label="Chat ends.",color=orange];
	3449 [label="I was actually watching Amir playing one of his arcade games. ",shape=box,color=blue];
		3449 -> 3453;
	3450 [label="It's rather comforting thinking that despite all the differences between our cultures, kids still just... sit down and play with toys.",shape=box,color=blue];
		3450 -> 3454;
	3451 [label="Like what?",shape=box,color=blue];
		3451 -> 3455;
		3451 -> 3456;
	3453 [label="And I was thinking to myself - what I wouldn't give to have that kind of joy in my life again.",shape=box,color=blue];
		3453 -> 3457;
	3454 [label="I had this action figure. Action Angus. He was a soldier, no surprise there.",shape=box,color=blue];
		3454 -> 3458;
	3455 [label="All sorts of figurines, and stuffed animals, and blocks. Typical kid stuff. ",shape=box,color=red];
		3455 -> 3450;
	3456 [label="I had this one - I guess you could call it a figurine - of this Dax child, that, well, I named after a character in a book I had. Dominus Thrax.",shape=box,color=red];
		3456 -> 3459;
	3457 [label="I've never looked down my nose at Aoi, or Amir, or even now Kaya for finding fun in \"childish\" things. It's never bothered me.",shape=box,color=blue];
		3457 -> 3460;
	3458 [label="One solstice celebration, a bunch of the older boys stole it from me along with a bunch of my other toys and, well...",shape=box,color=blue];
		3458 -> 3461;
	3459 [label="Oh, bollocks. I should've known. I'm so sorry that I brought this up.",shape=box,color=blue];
		3459 -> 3462;
		3459 -> 3463;
	3460 [label="But sometimes I'm afraid that the part of me that's capable of feeling that curled up and died a long time ago.",shape=box,color=blue];
		3460 -> 3464;
	3461 [label="It's a long story. Short of it? I was \"too old,\" they said, to be playing with dollies. That was the last time I ever played with toys.",shape=box,color=blue];
		3461 -> 3465;
	3462 [label="Not the best topic for me to discuss, no.",shape=box,color=red];
		3462 -> 3466;
	3463 [label="It's all right. It's not your fault.",shape=box,color=red];
		3463 -> 3467;
	3464 [label="Kind of sad, isn't it? That we tell children to love something, and then we tell them to give it up when they've \"matured.\"",shape=box,color=blue];
		3464 -> 3468;
		3464 -> 3469;
	3465 [label="The other day, I was watching Amir play one of his games. It's clear how much he's attached it. How much happiness it brings him. And I was a bit jealous that I don't have anything like that in my life.",shape=box,color=blue];
		3465 -> 3464;
	3466 [label="Now I feel like an absolute knobhead.",shape=box,color=blue];
		3466 -> 3470;
	3467 [label="We had all the normal toys you'd expect, I suppose. Blocks, stuffed animals, figurines, dolls.",shape=box,color=red];
		3467 -> 3471;
	3468 [label="I don't know. We all have to grow up sometime. We can't hide ourselves away with make-believe. I learned that the hard way.",shape=box,color=red];
		3468 -> 3472;
	3469 [label="I think life can be ugly and painful and short. And we should fill it with as much fun, and laughter, and love as we can find.",shape=box,color=red];
		3469 -> 3473;
	3470 [label="Chat ends.",color=orange];
	3471 [label="Mine only became a little more problematic because of the whole... Void thing.",shape=box,color=red];
		3471 -> 3450;
	3472 [label="You make a fair point. I think when it becomes a replacement for the real thing, it's a problem. I'm not suggesting that.",shape=box,color=blue];
		3472 -> 3474;
	3473 [label="You're right. And I hope it's something we remember, as we go forward together in... whatever this is that we're in.",shape=box,color=blue];
		3473 -> 3474;
	3474 [label="You know, I found Eleanor, Velimir, Aoi, and Amir, playing hide-and-seek with Flare and Lizzie. (Quincy said he wasn't allowed to play because the bastard was cheating and was using his scope to see through walls.)",shape=box,color=blue];
		3474 -> 3475;
	3475 [label="They were all looking at me worried I was going to be upset I caught them mucking about when they should be doing something useful.",shape=box,color=blue];
		3475 -> 3476;
	3476 [label="I was more upset that I wasn't invited. Heh. But I had to put on the grumpy leader face and pretend I was upset that the posts were left unmanned, etcetera.",shape=box,color=blue];
		3476 -> 3477;
	3477 [label="But Amir has his games. Aoi has On-lyne. Even Kaya has her stickers and her Jinymon, for all that the world has forced adulthood on her too soon.",shape=box,color=blue];
		3477 -> 3478;
		3477 -> 3479;
	3478 [label="Is there a point you're trying to make?",shape=box,color=red];
		3478 -> 3480;
	3479 [label="I think it's something you could get back, if you tried. Finding joy in toys and games, I mean.",shape=box,color=red];
		3479 -> 3481;
	3480 [label="Honestly? I'm not even sure. Only that I feel like I'm missing something that's been gone from my life for a very long time.",shape=box,color=blue];
		3480 -> 3482;
	3481 [label="I can just hear the laughter now. But I suppose that's really what's holding me back, isn't it? Embarrassment.",shape=box,color=blue];
		3481 -> 3483;
	3482 [label="I'm not sure if I can ever get it back. Or if it's too far gone. But who knows. With enough time, maybe anything is possible.",shape=box,color=blue];
		3482 -> 3484;
	3483 [label="I'm not sure it's possible to get it back, even if I could push through the momentary shame. But who knows. With enough loops, maybe anything is possible.",shape=box,color=blue];
		3483 -> 3485;
	3484 [label="Chat ends.",color=orange];
	3485 [label="Chat ends.",color=orange];
}