digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo3 begins." [color=orange];
		"ArthurRank6Convo3 begins." -> j65788689;
	j65788689 [label="I found myself having a conversation with the guitar the other day.",shape=box,color=blue];
		j65788689 -> j3663929217;
		j65788689 -> j2711803736;
	j3663929217 [label="I'm not a huge fan, personally.",shape=box,color=red];
		j3663929217 -> j3987917865;
	j2711803736 [label="Lizzie? How'd that go?",shape=box,color=red];
		j2711803736 -> j309083743;
	j3987917865 [label="Honestly, I rather like her. Once you get past the... oddness... of it?",shape=box,color=blue];
		j3987917865 -> j3903302343;
	j309083743 [label="Better than I would have thought. I rather like her.",shape=box,color=blue];
		j309083743 -> j3903302343;
	j3903302343 [label="Besides,",shape=box,color=blue];
		j3903302343 -> j1195187863;
	j1195187863 [label="Since she and Eleanor seem to always be laughing at jokes that no one else can hear.",shape=box,color=blue];
		j1195187863 -> j2122943170;
	j2122943170 [label="I figured I ought to go introduce myself properly.",shape=box,color=blue];
		j2122943170 -> j2007922506;
	j2007922506 [label="She has a lot of useful insights. And Flare is lovely. Honestly, that whole pack in the bar is a breath of fresh air. ",shape=box,color=blue];
		j2007922506 -> j2711870998;
	j2711870998 [label="Well. Proverbially.",shape=box,color=blue];
		j2711870998 -> j782004229;
		j2711870998 -> j3373369683;
		j2711870998 -> j2872369542;
	j782004229 [label="Sick of the Hex already?",shape=box,color=red];
		j782004229 -> j2827533607;
	j3373369683 [label="What insights did she have?",shape=box,color=red];
		j3373369683 -> j1028440125;
	j2872369542 [label="I'm glad you're making friends. lol. ",shape=box,color=red];
		j2872369542 -> j352152556;
	j2827533607 [label="What? No! Of course not.",shape=box,color=blue];
		j2827533607 -> j1277827237;
	j1028440125 [label="Fascinating ones, regarding how many times the year has looped.",shape=box,color=blue];
		j1028440125 -> j4237782956;
	j352152556 [label="I suppose it's just nice to have some folks around to talk to that I haven't been through so much with.",shape=box,color=blue];
		j352152556 -> j3762602231;
	j1277827237 [label="The Hex are my family. My team. You know that.",shape=box,color=blue];
		j1277827237 -> j352152556;
	j4237782956 [label="How many times I may or may not have forgotten years past. How she lives... outside of time? And how we do not.",shape=box,color=blue];
		j4237782956 -> j2069065352;
	j3762602231 [label="I'm not sure if that makes any sense at all. I know them, I trust them, I just haven't *been through hell and back* with them.",shape=box,color=blue];
		j3762602231 -> j2314162461;
	j2069065352 [label="And before you say anything, no. I don't want to know. It isn't my right to know.",shape=box,color=blue];
		j2069065352 -> j2068677263;
	j2314162461 [label="So it makes it easier sometimes to just sit and drink with them.",shape=box,color=blue];
		j2314162461 -> j2093693190;
		j2314162461 -> j3951201471;
		j2314162461 -> j788216505;
	j2068677263 [label="I guess I just want to say - whether you have or not? It's okay. I won't hold it against you.",shape=box,color=blue];
		j2068677263 -> j3157642269;
	j2093693190 [label="I've never really had that option.",shape=box,color=red];
		j2093693190 -> j3118415391;
	j3951201471 [label="Yeah. I get that.",shape=box,color=red];
		j3951201471 -> j3750993190;
	j788216505 [label="It also helps that some of them are a bit older and have military experience.",shape=box,color=red];
		j788216505 -> j3550271152;
	j3157642269 [label="This situation we're in? It isn't normal. We weren't meant for things like this - humans, I mean.",shape=box,color=blue];
		j3157642269 -> j1522415510;
	j3118415391 [label="I suppose not.",shape=box,color=blue];
		j3118415391 -> j3250090790;
	j3750993190 [label="There isn't so much... weight. So much past. Amir would call it baggage.",shape=box,color=blue];
		j3750993190 -> j3250090790;
	j3550271152 [label="Sol. Does it ever. Wasn't sure what to make of the Libertatians at first. But now? Quite glad they're here.",shape=box,color=blue];
		j3550271152 -> j3250090790;
	j1522415510 [label="There aren't guidebooks for this. Whatever you choose to do, I trust you to have good reasons to do it.",shape=box,color=blue];
		j1522415510 -> j2674809731;
	j3250090790 [label="But it all got me thinking.",shape=box,color=blue];
		j3250090790 -> j170981902;
		j3250090790 -> j3140713153;
	j2674809731 [label="Check boolean ArthurDating",color=orange];
		j2674809731 -> j1075846551 [label=true,color=green];
		j2674809731 -> j1305355720 [label=false,color=brown];
	j170981902 [label="Uh oh.",shape=box,color=red];
		j170981902 -> j1335485070;
	j3140713153 [label="About what?",shape=box,color=red];
		j3140713153 -> j1974197691;
	j1075846551 [label="I love you. And even if I forget that? Even if you choose to go another way? That's all right.",shape=box,color=blue];
		j1075846551 -> j2993124883;
	j1305355720 [label="I trust you with my life. And nothing is going to change that. Even if I forget it for a little while.",shape=box,color=blue];
		j1305355720 -> j252941761;
	j1335485070 [label="Heh. Hear me out. This is about you, though.",shape=box,color=blue];
		j1335485070 -> j2651634461;
	j1974197691 [label="You. ",shape=box,color=blue];
		j1974197691 -> j2651634461;
	j2993124883 [label="Before you came here, I don't think I could have accepted that. I would have been too afraid to lose you. To lose this.",shape=box,color=blue];
		j2993124883 -> j3939056407;
	j252941761 [label="Before you came here, I don't think I could have accepted that. I would have been too afraid to lose some part of myself.",shape=box,color=blue];
		j252941761 -> j3939056407;
	j2651634461 [label="And this whole... looping timeline. And it's got me thinking about how many 1999s I might not remember.",shape=box,color=blue];
		j2651634461 -> j3482420139;
		j2651634461 -> j3832663234;
		j2651634461 -> j4010409;
	j3939056407 [label="I would have clung to it like a desperate man clinging to a raft at sea. But maybe I've been in this loop enough times now, or... maybe it's just you, I don't know.",shape=box,color=blue];
		j3939056407 -> j4185616764;
	j3482420139 [label="Whatever the guitar has told you is slander, I swear.",shape=box,color=red];
		j3482420139 -> j2403387324;
	j3832663234 [label="Am I in trouble?",shape=box,color=red];
		j3832663234 -> j2403387324;
	j4010409 [label="I... don't think we should get into this, Arthur.",shape=box,color=red];
		j4010409 -> j2403387324;
	j4185616764 [label="This happiness you've given me now - this peace - is worth more in this moment than knowing it might last forever.",shape=box,color=blue];
		j4185616764 -> j3793390248;
	j2403387324 [label="Just wait a second, will you? You know I type slower than you do.",shape=box,color=blue];
		j2403387324 -> j1382612448;
	j3793390248 [label="If there's one thing in life you learn as a soldier, it's that everything is fleeting.",shape=box,color=blue];
		j3793390248 -> j746073595;
	j1382612448 [label="What I'm trying to say is this:",shape=box,color=blue];
		j1382612448 -> j2922052715;
	j746073595 [label="Here one second, gone the next. I guess I've just come to accept that. Once and for all.",shape=box,color=blue];
		j746073595 -> j3965412001;
	j2922052715 [label="Whether or not you've made me, or the rest of the Hex, forget our past interactions? It's okay.",shape=box,color=blue];
		j2922052715 -> j4065558877;
	j3965412001 [label="So, whether our time together ends because you punch the floor and I forget everything?",shape=box,color=blue];
		j3965412001 -> j899910369;
	j4065558877 [label="I won't hold it against you.",shape=box,color=blue];
		j4065558877 -> j3157642269;
	j899910369 [label="Or because the Indifference catches you off guard some day?",shape=box,color=blue];
		j899910369 -> j2252327588;
	j2252327588 [label="I'm going to enjoy this moment that I have. Here and now. Because it's what I've got.",shape=box,color=blue];
		j2252327588 -> j3233438627;
	j3233438627 [label="And that's what I know I can be sure of.",shape=box,color=blue];
		j3233438627 -> j2113247688;
		j3233438627 -> j3577022539;
		j3233438627 -> j2148823819;
	j2113247688 [label="It's nothing personal. It's mostly because I keep screwing up trying to date your sister. :P",shape=box,color=red];
		j2113247688 -> j719505997;
	j3577022539 [label="Thanks, Arthur... that means more to me than I think I can really express.",shape=box,color=red];
		j3577022539 -> j2633701019;
	j2148823819 [label="I wish I had your kind of level-headedness, sometimes. <3",shape=box,color=red];
		j2148823819 -> j200622633;
	j719505997 [label="Har har. Well, it's a good thing you have a magical super power that allows you to remove your foot from where you've lodged it so spectacularly down your trachea, isn't it?",shape=box,color=blue];
		j719505997 -> j3776634720;
	j2633701019 [label="Every now and then, I try to pull the stick out of my arse long enough to say something meaningful.",shape=box,color=blue];
		j2633701019 -> j3819260326;
	j200622633 [label="It's more because I know I functionally have no other choice but to keep a stiff upper lip. Such is the Britannic way. ",shape=box,color=blue];
		j200622633 -> j1751506053;
	j3776634720 [label="The rest of us just have to learn how to communicate. Question, though.",shape=box,color=blue];
		j3776634720 -> j3703132501;
	j3819260326 [label="Well, I think it's time for a drink. Shall we?",shape=box,color=blue];
		j3819260326 -> j1087898867;
		j3819260326 -> j406662069;
	j1751506053 [label="Like the old saying goes. \"Keep Composed and Continue Forward.\"",shape=box,color=blue];
		j1751506053 -> j3819260326;
	j3703132501 [label="Does she lower her standards with every reset?",shape=box,color=blue];
		j3703132501 -> "Chat ends.";
	j1087898867 [label="Maybe later.",shape=box,color=red];
		j1087898867 -> j3032033183;
	j406662069 [label="Meet you there. :)",shape=box,color=red];
		j406662069 -> "Chat ends.";
	"Chat ends." [color=orange];
	j3032033183 [label="Suit yourself.",shape=box,color=blue];
		j3032033183 -> "Chat ends.";
}