digraph {
	3360 [label="ArthurRank6Convo3 begins.",color=orange];
		3360 -> 3361;
	3361 [label="I found myself having a conversation with the guitar the other day.",shape=box,color=blue];
		3361 -> 3362;
		3361 -> 3363;
	3362 [label="I'm not a huge fan, personally.",shape=box,color=red];
		3362 -> 3364;
	3363 [label="Lizzie? How'd that go?",shape=box,color=red];
		3363 -> 3365;
	3364 [label="Honestly, I rather like her. Once you get past the... oddness... of it?",shape=box,color=blue];
		3364 -> 3366;
	3365 [label="Better than I would have thought. I rather like her.",shape=box,color=blue];
		3365 -> 3366;
	3366 [label="Besides,",shape=box,color=blue];
		3366 -> 3367;
	3367 [label="Since she and Eleanor seem to always be laughing at jokes that no one else can hear.",shape=box,color=blue];
		3367 -> 3368;
	3368 [label="I figured I ought to go introduce myself properly.",shape=box,color=blue];
		3368 -> 3369;
	3369 [label="She has a lot of useful insights. And Flare is lovely. Honestly, that whole pack in the bar is a breath of fresh air. ",shape=box,color=blue];
		3369 -> 3370;
	3370 [label="Well. Proverbially.",shape=box,color=blue];
		3370 -> 3371;
		3370 -> 3372;
		3370 -> 3373;
	3371 [label="Sick of the Hex already?",shape=box,color=red];
		3371 -> 3374;
	3372 [label="What insights did she have?",shape=box,color=red];
		3372 -> 3375;
	3373 [label="I'm glad you're making friends. lol. ",shape=box,color=red];
		3373 -> 3376;
	3374 [label="What? No! Of course not.",shape=box,color=blue];
		3374 -> 3377;
	3375 [label="Fascinating ones, regarding how many times the year has looped.",shape=box,color=blue];
		3375 -> 3378;
	3376 [label="I suppose it's just nice to have some folks around to talk to that I haven't been through so much with.",shape=box,color=blue];
		3376 -> 3379;
	3377 [label="The Hex are my family. My team. You know that.",shape=box,color=blue];
		3377 -> 3376;
	3378 [label="How many times I may or may not have forgotten years past. How she lives... outside of time? And how we do not.",shape=box,color=blue];
		3378 -> 3380;
	3379 [label="I'm not sure if that makes any sense at all. I know them, I trust them, I just haven't *been through hell and back* with them.",shape=box,color=blue];
		3379 -> 3381;
	3380 [label="And before you say anything, no. I don't want to know. It isn't my right to know.",shape=box,color=blue];
		3380 -> 3382;
	3381 [label="So it makes it easier sometimes to just sit and drink with them.",shape=box,color=blue];
		3381 -> 3383;
		3381 -> 3384;
		3381 -> 3385;
	3382 [label="I guess I just want to say - whether you have or not? It's okay. I won't hold it against you.",shape=box,color=blue];
		3382 -> 3386;
	3383 [label="I've never really had that option.",shape=box,color=red];
		3383 -> 3387;
	3384 [label="Yeah. I get that.",shape=box,color=red];
		3384 -> 3388;
	3385 [label="It also helps that some of them are a bit older and have military experience.",shape=box,color=red];
		3385 -> 3389;
	3386 [label="This situation we're in? It isn't normal. We weren't meant for things like this - humans, I mean.",shape=box,color=blue];
		3386 -> 3390;
	3387 [label="I suppose not.",shape=box,color=blue];
		3387 -> 3391;
	3388 [label="There isn't so much... weight. So much past. Amir would call it baggage.",shape=box,color=blue];
		3388 -> 3391;
	3389 [label="Sol. Does it ever. Wasn't sure what to make of the Libertatians at first. But now? Quite glad they're here.",shape=box,color=blue];
		3389 -> 3391;
	3390 [label="There aren't guidebooks for this. Whatever you choose to do, I trust you to have good reasons to do it.",shape=box,color=blue];
		3390 -> 3392;
	3391 [label="But it all got me thinking.",shape=box,color=blue];
		3391 -> 3393;
		3391 -> 3394;
	3392 [label="Check boolean ArthurDating",color=orange];
		3392 -> 3396 [label=true,color=green];
		3392 -> 3395 [label=false,color=brown];
	3393 [label="Uh oh.",shape=box,color=red];
		3393 -> 3397;
	3394 [label="About what?",shape=box,color=red];
		3394 -> 3398;
	3396 [label="I love you. And even if I forget that? Even if you choose to go another way? That's all right.",shape=box,color=blue];
		3396 -> 3400;
	3395 [label="I trust you with my life. And nothing is going to change that. Even if I forget it for a little while.",shape=box,color=blue];
		3395 -> 3399;
	3397 [label="Heh. Hear me out. This is about you, though.",shape=box,color=blue];
		3397 -> 3401;
	3398 [label="You. ",shape=box,color=blue];
		3398 -> 3401;
	3400 [label="Before you came here, I don't think I could have accepted that. I would have been too afraid to lose you. To lose this.",shape=box,color=blue];
		3400 -> 3402;
	3399 [label="Before you came here, I don't think I could have accepted that. I would have been too afraid to lose some part of myself.",shape=box,color=blue];
		3399 -> 3402;
	3401 [label="And this whole... looping timeline. And it's got me thinking about how many 1999s I might not remember.",shape=box,color=blue];
		3401 -> 3403;
		3401 -> 3404;
		3401 -> 3405;
	3402 [label="I would have clung to it like a desperate man clinging to a raft at sea. But maybe I've been in this loop enough times now, or... maybe it's just you, I don't know.",shape=box,color=blue];
		3402 -> 3406;
	3403 [label="Whatever the guitar has told you is slander, I swear.",shape=box,color=red];
		3403 -> 3407;
	3404 [label="Am I in trouble?",shape=box,color=red];
		3404 -> 3407;
	3405 [label="I... don't think we should get into this, Arthur.",shape=box,color=red];
		3405 -> 3407;
	3406 [label="This happiness you've given me now - this peace - is worth more in this moment than knowing it might last forever.",shape=box,color=blue];
		3406 -> 3408;
	3407 [label="Just wait a second, will you? You know I type slower than you do.",shape=box,color=blue];
		3407 -> 3409;
	3408 [label="If there's one thing in life you learn as a soldier, it's that everything is fleeting.",shape=box,color=blue];
		3408 -> 3410;
	3409 [label="What I'm trying to say is this:",shape=box,color=blue];
		3409 -> 3411;
	3410 [label="Here one second, gone the next. I guess I've just come to accept that. Once and for all.",shape=box,color=blue];
		3410 -> 3412;
	3411 [label="Whether or not you've made me, or the rest of the Hex, forget our past interactions? It's okay.",shape=box,color=blue];
		3411 -> 3413;
	3412 [label="So, whether our time together ends because you punch the floor and I forget everything?",shape=box,color=blue];
		3412 -> 3414;
	3413 [label="I won't hold it against you.",shape=box,color=blue];
		3413 -> 3386;
	3414 [label="Or because the Indifference catches you off guard some day?",shape=box,color=blue];
		3414 -> 3415;
	3415 [label="I'm going to enjoy this moment that I have. Here and now. Because it's what I've got.",shape=box,color=blue];
		3415 -> 3416;
	3416 [label="And that's what I know I can be sure of.",shape=box,color=blue];
		3416 -> 3417;
		3416 -> 3418;
		3416 -> 3419;
	3417 [label="It's nothing personal. It's mostly because I keep screwing up trying to date your sister. :P",shape=box,color=red];
		3417 -> 3420;
	3418 [label="Thanks, Arthur... that means more to me than I think I can really express.",shape=box,color=red];
		3418 -> 3421;
	3419 [label="I wish I had your kind of level-headedness, sometimes. <3",shape=box,color=red];
		3419 -> 3422;
	3420 [label="Har har. Well, it's a good thing you have a magical super power that allows you to remove your foot from where you've lodged it so spectacularly down your trachea, isn't it?",shape=box,color=blue];
		3420 -> 3423;
	3421 [label="Every now and then, I try to pull the stick out of my arse long enough to say something meaningful.",shape=box,color=blue];
		3421 -> 3424;
	3422 [label="It's more because I know I functionally have no other choice but to keep a stiff upper lip. Such is the Britannic way. ",shape=box,color=blue];
		3422 -> 3425;
	3423 [label="The rest of us just have to learn how to communicate. Question, though.",shape=box,color=blue];
		3423 -> 3426;
	3424 [label="Well, I think it's time for a drink. Shall we?",shape=box,color=blue];
		3424 -> 3427;
		3424 -> 3428;
	3425 [label="Like the old saying goes. \"Keep Composed and Continue Forward.\"",shape=box,color=blue];
		3425 -> 3424;
	3426 [label="Does she lower her standards with every reset?",shape=box,color=blue];
		3426 -> 3429;
	3427 [label="Maybe later.",shape=box,color=red];
		3427 -> 3430;
	3428 [label="Meet you there. :)",shape=box,color=red];
		3428 -> 3431;
	3429 [label="Chat ends.",color=orange];
	3430 [label="Suit yourself.",shape=box,color=blue];
		3430 -> 3432;
	3431 [label="Chat ends.",color=orange];
	3432 [label="Chat ends.",color=orange];
}