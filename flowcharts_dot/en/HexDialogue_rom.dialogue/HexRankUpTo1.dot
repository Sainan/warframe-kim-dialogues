		"HexRankUpTo1 begins." -> j1498528973;
	j1498528973 [label="Broadsword: We’re stuck here, get it? So clean up after yourselves - the Food Court is dirtier than the streets. This isn’t a bleeding zoo.",shape=box,color=blue];
