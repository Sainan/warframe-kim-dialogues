		j3726981122 -> j1894099676;
	j1894099676 [label="xX GLIMMER Xx: right!? optimism! right! so, drifter, u have fresh eyes. what do u think of the food court? <RETRO_EMOJI_FOOD>",shape=box,color=blue];
