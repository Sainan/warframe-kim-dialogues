		j3085762134 -> j1792345154;
	j3365616173 [label="i appreciate that",shape=box,color=blue];
		j3365616173 -> j1792345154;
	j1792345154 [label="and i understand what you're getting at. but if... if there's no chance for getting rid of her...",shape=box,color=blue];
		j1792345154 -> j1855767576;
	j1855767576 [label="i... don't know what i'm going to do...",shape=box,color=blue];
