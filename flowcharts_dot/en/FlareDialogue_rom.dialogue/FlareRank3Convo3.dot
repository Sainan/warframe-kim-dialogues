	j2355447398 [label="I'm saying she's *you.* So, she can't really want to hurt you, if you're the same person. So maybe you don't need to get rid of her.",shape=box,color=red];
		j2355447398 -> j1638004022;
	j634099153 [label="What I'm saying is maybe you don't need to get rid of her. Maybe it's about coming to terms with her.",shape=box,color=red];
		j634099153 -> j2586553930;
	j1638004022 [label="you really don't know much about musicians if you don't understand how many of us loathe ourselves",shape=box,color=blue];
		j1638004022 -> j1801049930;
	j2586553930 [label="If she's a part of yourself, which I think she is, talking to her - understanding her - might be a better solution.",shape=box,color=red];
		j2586553930 -> j3496500573;
	j1801049930 [label="and wouldn't gleefully die in a spectacular self-inflicted fashion if it meant we'd be famous forever for it",shape=box,color=blue];
		j1801049930 -> j3159076587;
	j3496500573 [label="and what if you're wrong? what if she's using you, to get me to open the door? the moment i let down my defenses, goodbye Flare, hello Lizzie, forever",shape=box,color=blue];
		j3496500573 -> j547610467;
		j3496500573 -> j854946996;
	j3159076587 [label="for someone so traveled and so old... you really are adorable sometimes",shape=box,color=blue];
		j3159076587 -> j1410446032;
	j547610467 [label="I don't know. I've never known the Infestation to lie. It's never really spoken like this at all. She says that's not what she wants. But I can't make promises.",shape=box,color=red];
		j547610467 -> j3194525678;
	j854946996 [label="I don't see another way forward, but I won't force you to do anything you don't want to do.",shape=box,color=red];
		j854946996 -> j2760594355;
	j3194525678 [label="+5 Chemistry",color=orange];
		j3194525678 -> j3085762134;
	j2760594355 [label="+5 Chemistry",color=orange];
