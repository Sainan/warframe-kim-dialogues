	1096 [label="Seems likely?",shape=box,color=red];
		1096 -> 1098;
	1097 [label="No clue.",shape=box,color=red];
		1097 -> 1099;
	1098 [label="great",shape=box,color=blue];
		1098 -> 1100;
	1099 [label="let's assume so for the sake of argument",shape=box,color=blue];
		1099 -> 1100;
	1100 [label="but from what i can glean from the other charming freaks...",shape=box,color=blue];
		1100 -> 1101;
	1101 [label="there is a place the Infestation *isn't*",shape=box,color=blue];
		1101 -> 1102;
	1102 [label="somewhere we could imprison her where she *couldn't* come crawling back from...",shape=box,color=blue];
		1102 -> 1103;
		1102 -> 1104;
	1103 [label="I really, really don't like where this is going, Flare... what're you talking about?",shape=box,color=red];
		1103 -> 1105;
	1104 [label="If you're talking about tossing her into the Void... the answer is no.",shape=box,color=red];
		1104 -> 1106;
	1105 [label="i'm not talking about the void",shape=box,color=blue];
		1105 -> 1107;
	1106 [label="I don't know what kind of presence the Infestation has in the Void, and I'm not about to make it worse.",shape=box,color=red];
		1106 -> 1105;
	1107 [label="i'm talking about duviri",shape=box,color=blue];
		1107 -> 1108;
		1107 -> 1109;
		1107 -> 1110;
	1108 [label="I guess that *would* teach Thrax a lesson...",shape=box,color=red];
		1108 -> 1111;
	1109 [label="WHAT. NO! Absolutely not!",shape=box,color=red];
		1109 -> 1111;
	1110 [label="I - how do you know about Duviri?!",shape=box,color=red];
		1110 -> 1112;
	1111 [label="seems like you owe it no favors after what it did to you",shape=box,color=blue];
		1111 -> 1113;
		1111 -> 1114;
		1111 -> 1115;
	1112 [label="i can *talk* to the other protoframes, you know",shape=box,color=blue];
		1112 -> 1116;
	1113 [label="What gives you the right to tell me I should let it go straight to hell?",shape=box,color=red];
		1113 -> 1117;
		1113 -> 1118;
		1113 -> 1119;
	1114 [label="Maybe. Maybe not.",shape=box,color=red];
		1114 -> 1117;
		1114 -> 1118;
		1114 -> 1119;
	1115 [label="You're oversimplifying the situation. Duviri was - and *is* - far more than just a \"place.\"",shape=box,color=red];
		1115 -> 1117;
		1115 -> 1118;
		1115 -> 1119;
	1116 [label="and they've filled me in all about the weird little wild world you lived in",shape=box,color=blue];
		1116 -> 1111;
	1117 [label="You've never been there. You didn't spend centuries there. You haven't lived and died there.",shape=box,color=red];
		1117 -> 1120;
		1117 -> 1121;
		1117 -> 1122;
	1118 [label="To cut to the chase, Flare? That place is... as much a reflection of me, as it is the storybook it's based on.",shape=box,color=red];
		1118 -> 1120;
		1118 -> 1121;
		1118 -> 1122;
	1119 [label="While my feelings on it aren't exactly... rosy... I can't very well chuck the Infestation into it and walk away.",shape=box,color=red];
		1119 -> 1120;
		1119 -> 1122;
		1119 -> 1121;
	1120 [label="And as much as sometimes I like to go back there and repeatedly punch people in the face... It's not my garbage disposal.",shape=box,color=red];
		1120 -> 1123;
	1121 [label="Whether I like it or not... I'm somehow, stupidly, the person responsible for that place.",shape=box,color=red];
		1121 -> 1124;
	1122 [label="I have just as many pleasant memories of it as I have painful ones.",shape=box,color=red];
		1122 -> 1125;
	1123 [label="So it's not your garbage disposal, either.",shape=box,color=red];
		1123 -> 1126;
		1123 -> 1127;
		1123 -> 1128;
	1124 [label="So I have to be there to protect it when it's in danger.",shape=box,color=red];
		1124 -> 1128;
		1124 -> 1127;
		1124 -> 1126;
	1125 [label="And just because I wanted to be free of it, doesn't mean I want it all to suffer.",shape=box,color=red];
		1125 -> 1128;
		1125 -> 1126;
		1125 -> 1127;
	1126 [label="You're asking me to make other people suffer.",shape=box,color=red];
		1126 -> 1129;
	1127 [label="Think about what you're asking me to do, Flare.",shape=box,color=red];
		1127 -> 1130;
	1128 [label="Would you really want to endanger a whole other world like that?",shape=box,color=red];
		1128 -> 1131;
	1129 [label="+5 Chemistry",color=orange];
		1129 -> 1132;
	1130 [label="then i'd love, and I mean *love* for you to come up with another option",shape=box,color=blue];
		1130 -> 1133;
	1131 [label="i - but duviri isn't *real*",shape=box,color=blue];
		1131 -> 1134;
		1131 -> 1135;
	1132 [label="i - but they aren't real people -",shape=box,color=blue];
		1132 -> 1136;
	1133 [label="because i don't see you coming up with any",shape=box,color=blue];
		1133 -> 1137;
	1134 [label="Fine. Okay. You come to the table in good faith, and I'll... consider imprisoning her in Duviri if she's lying.",shape=box,color=red];
		1134 -> 1142;
	1135 [label="Who're we to decide what's real and what isn't?",shape=box,color=red];
