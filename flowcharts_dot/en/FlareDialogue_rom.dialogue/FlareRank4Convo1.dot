digraph {
	"FlareRank4Convo1 begins." [color=orange];
		"FlareRank4Convo1 begins." -> j140827892;
	j140827892 [label="i've been thinking for a while today about... this whole nonsense situation i'm in...",shape=box,color=blue];
		j140827892 -> j339153298;
	j339153298 [label="and the best path forward",shape=box,color=blue];
		j339153298 -> j3330867866;
	j3330867866 [label="or... lack thereof",shape=box,color=blue];
		j3330867866 -> j1107266874;
	j1107266874 [label="and i've had an idea",shape=box,color=blue];
		j1107266874 -> j3401368072;
		j1107266874 -> j2868394665;
	j3401368072 [label="Uh oh.",shape=box,color=red];
		j3401368072 -> j3994935999;
	j2868394665 [label="Yeah?",shape=box,color=red];
		j2868394665 -> j1131551795;
	j3994935999 [label="no no, stick with me",shape=box,color=blue];
		j3994935999 -> j3469634893;
	j1131551795 [label="so",shape=box,color=blue];
		j1131551795 -> j3469634893;
	j3469634893 [label="lizzie says she is from \"everywhere and everywhen\" so...",shape=box,color=blue];
		j3469634893 -> j3326928670;
	j3326928670 [label="asking you to drag her off into the far-flung distant future won't help, she'll just crawl her way back here",shape=box,color=blue];
		j3326928670 -> j2666770624;
	j2666770624 [label="right?",shape=box,color=blue];
		j2666770624 -> j3594535571;
		j2666770624 -> j2189211652;
	j3594535571 [label="Seems likely?",shape=box,color=red];
		j3594535571 -> j3689132066;
	j2189211652 [label="No clue.",shape=box,color=red];
		j2189211652 -> j2652100626;
	j3689132066 [label="great",shape=box,color=blue];
		j3689132066 -> j3560459911;
	j2652100626 [label="let's assume so for the sake of argument",shape=box,color=blue];
		j2652100626 -> j3560459911;
	j3560459911 [label="but from what i can glean from the other charming freaks...",shape=box,color=blue];
		j3560459911 -> j2989281413;
	j2989281413 [label="there is a place the Infestation *isn't*",shape=box,color=blue];
		j2989281413 -> j3481381669;
	j3481381669 [label="somewhere we could imprison her where she *couldn't* come crawling back from...",shape=box,color=blue];
		j3481381669 -> j1519678314;
		j3481381669 -> j2917642112;
	j1519678314 [label="I really, really don't like where this is going, Flare... what're you talking about?",shape=box,color=red];
		j1519678314 -> j1239390230;
	j2917642112 [label="If you're talking about tossing her into the Void... the answer is no.",shape=box,color=red];
		j2917642112 -> j1974921227;
	j1239390230 [label="i'm not talking about the void",shape=box,color=blue];
		j1239390230 -> j3547712796;
	j1974921227 [label="I don't know what kind of presence the Infestation has in the Void, and I'm not about to make it worse.",shape=box,color=red];
		j1974921227 -> j1239390230;
	j3547712796 [label="i'm talking about duviri",shape=box,color=blue];
		j3547712796 -> j3474015990;
		j3547712796 -> j1743065167;
		j3547712796 -> j3083007100;
	j3474015990 [label="I guess that *would* teach Thrax a lesson...",shape=box,color=red];
		j3474015990 -> j2136297088;
	j1743065167 [label="WHAT. NO! Absolutely not!",shape=box,color=red];
		j1743065167 -> j2136297088;
	j3083007100 [label="I - how do you know about Duviri?!",shape=box,color=red];
		j3083007100 -> j1170740964;
	j2136297088 [label="seems like you owe it no favors after what it did to you",shape=box,color=blue];
		j2136297088 -> j1613943964;
		j2136297088 -> j577024962;
		j2136297088 -> j3428716847;
	j1170740964 [label="i can *talk* to the other protoframes, you know",shape=box,color=blue];
		j1170740964 -> j258580149;
	j1613943964 [label="What gives you the right to tell me I should let it go straight to hell?",shape=box,color=red];
		j1613943964 -> j3491081430;
		j1613943964 -> j1151062565;
		j1613943964 -> j2072719475;
	j577024962 [label="Maybe. Maybe not.",shape=box,color=red];
		j577024962 -> j3491081430;
		j577024962 -> j1151062565;
		j577024962 -> j2072719475;
	j3428716847 [label="You're oversimplifying the situation. Duviri was - and *is* - far more than just a \"place.\"",shape=box,color=red];
		j3428716847 -> j3491081430;
		j3428716847 -> j1151062565;
		j3428716847 -> j2072719475;
	j258580149 [label="and they've filled me in all about the weird little wild world you lived in",shape=box,color=blue];
		j258580149 -> j2136297088;
	j3491081430 [label="You've never been there. You didn't spend centuries there. You haven't lived and died there.",shape=box,color=red];
		j3491081430 -> j2104199857;
		j3491081430 -> j3635492351;
		j3491081430 -> j2742852379;
	j1151062565 [label="To cut to the chase, Flare? That place is... as much a reflection of me, as it is the storybook it's based on.",shape=box,color=red];
		j1151062565 -> j2104199857;
		j1151062565 -> j3635492351;
		j1151062565 -> j2742852379;
	j2072719475 [label="While my feelings on it aren't exactly... rosy... I can't very well chuck the Infestation into it and walk away.",shape=box,color=red];
		j2072719475 -> j2104199857;
		j2072719475 -> j2742852379;
		j2072719475 -> j3635492351;
	j2104199857 [label="And as much as sometimes I like to go back there and repeatedly punch people in the face... It's not my garbage disposal.",shape=box,color=red];
		j2104199857 -> j1680351110;
	j3635492351 [label="Whether I like it or not... I'm somehow, stupidly, the person responsible for that place.",shape=box,color=red];
		j3635492351 -> j201539268;
	j2742852379 [label="I have just as many pleasant memories of it as I have painful ones.",shape=box,color=red];
		j2742852379 -> j1604865659;
	j1680351110 [label="So it's not your garbage disposal, either.",shape=box,color=red];
		j1680351110 -> j863148211;
		j1680351110 -> j4190206040;
		j1680351110 -> j4281456566;
	j201539268 [label="So I have to be there to protect it when it's in danger.",shape=box,color=red];
		j201539268 -> j4281456566;
		j201539268 -> j4190206040;
		j201539268 -> j863148211;
	j1604865659 [label="And just because I wanted to be free of it, doesn't mean I want it all to suffer.",shape=box,color=red];
		j1604865659 -> j4281456566;
		j1604865659 -> j863148211;
		j1604865659 -> j4190206040;
	j863148211 [label="You're asking me to make other people suffer.",shape=box,color=red];
		j863148211 -> j3780181931;
	j4190206040 [label="Think about what you're asking me to do, Flare.",shape=box,color=red];
		j4190206040 -> j2727766829;
	j4281456566 [label="Would you really want to endanger a whole other world like that?",shape=box,color=red];
		j4281456566 -> j1435116292;
	j3780181931 [label="+5 Chemistry",color=orange];
		j3780181931 -> j1512242964;
	j2727766829 [label="then i'd love, and I mean *love* for you to come up with another option",shape=box,color=blue];
		j2727766829 -> j3564981067;
	j1435116292 [label="i - but duviri isn't *real*",shape=box,color=blue];
		j1435116292 -> j1450616500;
		j1435116292 -> j3203547474;
	j1512242964 [label="i - but they aren't real people -",shape=box,color=blue];
		j1512242964 -> j2806519499;
	j3564981067 [label="because i don't see you coming up with any",shape=box,color=blue];
		j3564981067 -> j2990166568;
	j1450616500 [label="Fine. Okay. You come to the table in good faith, and I'll... consider imprisoning her in Duviri if she's lying.",shape=box,color=red];
		j1450616500 -> j4199675053;
	j3203547474 [label="Who're we to decide what's real and what isn't?",shape=box,color=red];
		j3203547474 -> j2489521335;
	j2806519499 [label="no, no. i can hear the words in my head already",shape=box,color=blue];
		j2806519499 -> j982079741;
	j2990166568 [label="Boolean FlareWar4 is now true.",color=orange];
		j2990166568 -> j517075388;
	j4199675053 [label="Boolean FlareWar4b is now true.",color=orange];
		j4199675053 -> j889230867;
	j2489521335 [label="i... yeah... that's fair.",shape=box,color=blue];
		j2489521335 -> j178660585;
	j982079741 [label="what makes a person real, in the end? who are we to decide?",shape=box,color=blue];
		j982079741 -> j2683017997;
