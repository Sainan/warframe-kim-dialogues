		1092 -> 1093;
	1093 [label="lizzie says she is from \"everywhere and everywhen\" so...",shape=box,color=blue];
		1093 -> 1094;
	1094 [label="asking you to drag her off into the far-flung distant future won't help, she'll just crawl her way back here",shape=box,color=blue];
		1094 -> 1095;
	1095 [label="right?",shape=box,color=blue];
