		0 -> 1;
	1 [label="hey, space traveler",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="Oh, hi. Flare, right?",shape=box,color=red];
		2 -> 4;
	3 [label="Hey. What's up?",shape=box,color=red];
		3 -> 5;
	4 [label="you're the one the other science experiments have been telling me about, right?",shape=box,color=blue];
		4 -> 6;
		4 -> 7;
	5 [label="sitting here with nothing better to do. i have a bunch of questions for you, if you've got time",shape=box,color=blue];
		5 -> 8;
		5 -> 9;
		5 -> 10;
	6 [label="I'd say I can't imagine there'd be two of me around here, but. Well. Long story. Anyway.",shape=box,color=red];
		6 -> 11;
	7 [label="Depends on what they've been saying. But probably.",shape=box,color=red];
		7 -> 12;
	8 [label="Nothing better to do, so you decided to come tap on the glass of the zoo. Nice.",shape=box,color=red];
		8 -> 13;
	9 [label="Really? Nothing better to do? I'm flattered. lol.",shape=box,color=red];
		9 -> 14;
	10 [label="If you'd like to ask questions, I'm here. Ask away.",shape=box,color=red];
		10 -> 15;
	11 [label="right. well. they filled me in on the basics.",shape=box,color=blue];
		11 -> 16;
	12 [label="sure...",shape=box,color=blue];
		12 -> 17;
		12 -> 18;
	13 [label="+5 Chemistry",color=orange];
		13 -> 19;
	14 [label="heh, sorry. came off wrong.",shape=box,color=blue];
		14 -> 20;
	15 [label="great",shape=box,color=blue];
		15 -> 20;
	16 [label="amir had... details to provide, shall we say. quite quickly.",shape=box,color=blue];
		16 -> 21;
	17 [label="Have you come to tap on the glass of the zoo?",shape=box,color=red];
		17 -> 22;
	18 [label="How can I help you?",shape=box,color=red];
		18 -> 20;
	19 [label="oh, sol, never. sorry to give that impression. though i suppose you're right. we protoframes aren't the only science experiments in town, are we?",shape=box,color=blue];
		19 -> 23;
		19 -> 24;
		19 -> 25;
	20 [label="the infestation. this rot. this thing that's poisoning my blood. i need to know everything you know",shape=box,color=blue];
		20 -> 26;
	21 [label="very... very quickly...",shape=box,color=blue];
		21 -> 27;
	22 [label="+5 Chemistry",color=orange];
		22 -> 28;
	23 [label="Could be worse.",shape=box,color=red];
		23 -> 29;
	24 [label="Just something you learn to live with over time, I guess.",shape=box,color=red];
		24 -> 30;
	25 [label="Nope.",shape=box,color=red];
		25 -> 31;
	26 [label="starting at the top. if you could. kindly. *now.*",shape=box,color=blue];
		26 -> 32;
	27 [label="Check boolean QuincySpaceTrauma",color=orange];
		27 -> 34 [label=true,color=green];
