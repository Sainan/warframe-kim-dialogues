	51 [label="starting at the top",shape=box,color=blue];
		51 -> 37;
		51 -> 39;
		51 -> 38;
	52 [label="so i'll simply lay it out on the table as this. i made a mistake, taking this bizarre injection",shape=box,color=blue];
		52 -> 58;
	53 [label="Her?",shape=box,color=red];
		53 -> 59;
	54 [label="What you're going through is no different than what the Hex went through. You're not alone.",shape=box,color=red];
		54 -> 60;
	55 [label="I understand what you're going through. I can help you.",shape=box,color=red];
		55 -> 61;
	56 [label="I know what's happened is terrifying - becoming a protoframe, the situation here in Höllvania -",shape=box,color=red];
		56 -> 62;
	57 [label="I meant that there are worse things in the world than being seen as a freak. Yikes.",shape=box,color=red];
		57 -> 63;
	58 [label="i don't know what help you need, what bribing, what favors i need to do for you - but i *need* to get rid of her *now*",shape=box,color=blue];
		58 -> 53;
		58 -> 54;
		58 -> 55;
		58 -> 56;
	59 [label="Who's \"her?\"",shape=box,color=red];
		59 -> 64;
	60 [label="no. no i don't think it is at all the same. i'm starting to think that you don't understand... and *that's* what scares me",shape=box,color=blue];
