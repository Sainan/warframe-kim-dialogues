	"FlareRank1Convo1 begins." [color=orange];
		"FlareRank1Convo1 begins." -> j594340471;
	j594340471 [label="hey, space traveler",shape=box,color=blue];
		j594340471 -> j1937254633;
		j594340471 -> j3264957885;
	j1937254633 [label="Oh, hi. Flare, right?",shape=box,color=red];
		j1937254633 -> j3297559504;
	j3264957885 [label="Hey. What's up?",shape=box,color=red];
		j3264957885 -> j3999097903;
	j3297559504 [label="you're the one the other science experiments have been telling me about, right?",shape=box,color=blue];
		j3297559504 -> j382505617;
		j3297559504 -> j3634622245;
	j3999097903 [label="sitting here with nothing better to do. i have a bunch of questions for you, if you've got time",shape=box,color=blue];
		j3999097903 -> j2010710508;
		j3999097903 -> j2751133268;
		j3999097903 -> j802297139;
	j382505617 [label="I'd say I can't imagine there'd be two of me around here, but. Well. Long story. Anyway.",shape=box,color=red];
		j382505617 -> j3431022152;
	j3634622245 [label="Depends on what they've been saying. But probably.",shape=box,color=red];
		j3634622245 -> j2512634484;
	j2010710508 [label="Nothing better to do, so you decided to come tap on the glass of the zoo. Nice.",shape=box,color=red];
		j2010710508 -> j1144674809;
	j2751133268 [label="Really? Nothing better to do? I'm flattered. lol.",shape=box,color=red];
		j2751133268 -> j3169230927;
	j802297139 [label="If you'd like to ask questions, I'm here. Ask away.",shape=box,color=red];
		j802297139 -> j1767397045;
	j3431022152 [label="right. well. they filled me in on the basics.",shape=box,color=blue];
		j3431022152 -> j3531238818;
	j2512634484 [label="sure...",shape=box,color=blue];
		j2512634484 -> j1873335496;
		j2512634484 -> j3345574945;
	j1144674809 [label="+5 Chemistry",color=orange];
		j1144674809 -> j1485351534;
	j3169230927 [label="heh, sorry. came off wrong.",shape=box,color=blue];
		j3169230927 -> j4059208510;
	j1767397045 [label="great",shape=box,color=blue];
		j1767397045 -> j4059208510;
	j3531238818 [label="amir had... details to provide, shall we say. quite quickly.",shape=box,color=blue];
		j3531238818 -> j2247910288;
	j1873335496 [label="Have you come to tap on the glass of the zoo?",shape=box,color=red];
		j1873335496 -> j2576858496;
	j3345574945 [label="How can I help you?",shape=box,color=red];
		j3345574945 -> j4059208510;
	j1485351534 [label="oh, sol, never. sorry to give that impression. though i suppose you're right. we protoframes aren't the only science experiments in town, are we?",shape=box,color=blue];
		j1485351534 -> j2914248912;
		j1485351534 -> j1119582338;
		j1485351534 -> j1548994589;
	j4059208510 [label="the infestation. this rot. this thing that's poisoning my blood. i need to know everything you know",shape=box,color=blue];
		j4059208510 -> j4054321989;
	j2247910288 [label="very... very quickly...",shape=box,color=blue];
		j2247910288 -> j2850897917;
	j2576858496 [label="+5 Chemistry",color=orange];
		j2576858496 -> j1039589307;
	j2914248912 [label="Could be worse.",shape=box,color=red];
		j2914248912 -> j4029457454;
	j1119582338 [label="Just something you learn to live with over time, I guess.",shape=box,color=red];
		j1119582338 -> j4280808748;
	j1548994589 [label="Nope.",shape=box,color=red];
		j1548994589 -> j1411368159;
	j4054321989 [label="starting at the top. if you could. kindly. *now.*",shape=box,color=blue];
		j4054321989 -> j2988955069;
	j2850897917 [label="Check boolean QuincySpaceTrauma",color=orange];
		j2850897917 -> j854760230 [label=true,color=green];
		j2850897917 -> j3112148319 [label=false,color=brown];
	j1039589307 [label="oh, sol, never. sorry to give that impression. though i suppose you're right. we protoframes aren't the only experiments in town, are we?",shape=box,color=blue];
		j1039589307 -> j2914248912;
		j1039589307 -> j1119582338;
		j1039589307 -> j1548994589;
	j4029457454 [label="i would *love* to know how exactly you think it could get worse than this",shape=box,color=blue];
		j4029457454 -> j1762858108;
	j4280808748 [label="that's what i wanted to talk to you about, actually...",shape=box,color=blue];
		j4280808748 -> j4059208510;
	j1411368159 [label="so tell me",shape=box,color=blue];
		j1411368159 -> j474414405;
	j2988955069 [label="Boolean FlareInfestation1 is now true.",color=orange];
		j2988955069 -> j2846127200;
		j2988955069 -> j1586472798;
		j2988955069 -> j2629898612;
	j854760230 [label="and the other one had something to say about \"space trauma\" i believe?",shape=box,color=blue];
		j854760230 -> j3112148319;
		j854760230 -> j1955756289;
	j3112148319 [label="Lol. Well, at least we can skip the introductory stuff.",shape=box,color=red];
		j3112148319 -> j1873335496;
		j3112148319 -> j3345574945;
	j1762858108 [label="enlighten me",shape=box,color=blue];
		j1762858108 -> j2297595427;
	j474414405 [label="where did he go? entrati? the others claim they don't know. that you don't either",shape=box,color=blue];
		j474414405 -> j4141456735;
	j2846127200 [label="I'm not sure I like your attitude?",shape=box,color=red];
		j2846127200 -> j830297216;
	j1586472798 [label="Uh... That's going to take a while, and I don't think it's going to give you the answers you want.",shape=box,color=red];
		j1586472798 -> j8256852;
	j2629898612 [label="Whoa, hold on. Back up. Are you okay?",shape=box,color=red];
		j2629898612 -> j9073067;
	j1955756289 [label="Yep. That'd be Quincy.",shape=box,color=red];
		j1955756289 -> j1873335496;
		j1955756289 -> j3345574945;
	j2297595427 [label="because from where i stand, i have a poison in my blood that is slowly causing me to lose my mind and corrupting my body",shape=box,color=blue];
		j2297595427 -> j891959168;
	j4141456735 [label="i call bullshit",shape=box,color=blue];
		j4141456735 -> j3762509805;
	j830297216 [label="i... apologize. this is not usually how i like to act. however, i'm in a bit of a situation that is... very hard to describe",shape=box,color=blue];
		j830297216 -> j1444117746;
	j8256852 [label="this isn't about me wanting answers, dear space traveler. this is about me *needing* answers",shape=box,color=blue];
		j8256852 -> j364264693;
	j9073067 [label="i don't think i can adequately put into words how very not okay i am",shape=box,color=blue];
		j9073067 -> j1444117746;
	j891959168 [label="and the only man who could give me answers about it - the only man who could explain it to me or get rid of her is *gone*",shape=box,color=blue];
		j891959168 -> j1702964281;
	j3762509805 [label="so i'd like to know everything you know about him, if you don't mind",shape=box,color=blue];
		j3762509805 -> j583767273;
	j1444117746 [label="and i'll remind you that is literally my job to put my feelings into words",shape=box,color=blue];
		j1444117746 -> j2436896760;
	j364264693 [label="and I don't think i can adequately put into words how very different my situation is from the others and how I *need* to get rid of her *immediately*",shape=box,color=blue];
		j364264693 -> j2845766663;
		j364264693 -> j4088502545;
		j364264693 -> j1258113387;
		j364264693 -> j116248054;
	j1702964281 [label="Boolean FlareInfestation1 is now true.",color=orange];
		j1702964281 -> j1442473820;
		j1702964281 -> j2846127200;
		j1702964281 -> j1586472798;
		j1702964281 -> j2629898612;
	j583767273 [label="starting at the top",shape=box,color=blue];
		j583767273 -> j2846127200;
		j583767273 -> j2629898612;
		j583767273 -> j1586472798;
	j2436896760 [label="so i'll simply lay it out on the table as this. i made a mistake, taking this bizarre injection",shape=box,color=blue];
		j2436896760 -> j554678395;
	j2845766663 [label="Her?",shape=box,color=red];
		j2845766663 -> j213631361;
	j4088502545 [label="What you're going through is no different than what the Hex went through. You're not alone.",shape=box,color=red];
		j4088502545 -> j189140771;
	j1258113387 [label="I understand what you're going through. I can help you.",shape=box,color=red];
		j1258113387 -> j3497285816;
	j116248054 [label="I know what's happened is terrifying - becoming a protoframe, the situation here in Höllvania -",shape=box,color=red];
		j116248054 -> j3746845792;
	j1442473820 [label="I meant that there are worse things in the world than being seen as a freak. Yikes.",shape=box,color=red];
		j1442473820 -> j3626820187;
	j554678395 [label="i don't know what help you need, what bribing, what favors i need to do for you - but i *need* to get rid of her *now*",shape=box,color=blue];
		j554678395 -> j2845766663;
		j554678395 -> j4088502545;
		j554678395 -> j1258113387;
		j554678395 -> j116248054;
	j213631361 [label="Who's \"her?\"",shape=box,color=red];
		j213631361 -> j3210842513;
	j189140771 [label="no. no i don't think it is at all the same. i'm starting to think that you don't understand... and *that's* what scares me",shape=box,color=blue];
		j189140771 -> j2612217747;
		j189140771 -> j2707070315;
		j189140771 -> j3417613347;
	j3497285816 [label="that's just it. i'm starting to think that you don't understand... and *that's* what scares me",shape=box,color=blue];
		j3497285816 -> j2707070315;
		j3497285816 -> j2612217747;
		j3497285816 -> j3417613347;
	j3746845792 [label="that's just it. i'm starting to think that you don't understand... and *that's* what scares me",shape=box,color=blue];
		j3746845792 -> j2707070315;
		j3746845792 -> j3417613347;
