	28 [label="oh, sol, never. sorry to give that impression. though i suppose you're right. we protoframes aren't the only experiments in town, are we?",shape=box,color=blue];
		28 -> 23;
		28 -> 24;
		28 -> 25;
	29 [label="i would *love* to know how exactly you think it could get worse than this",shape=box,color=blue];
