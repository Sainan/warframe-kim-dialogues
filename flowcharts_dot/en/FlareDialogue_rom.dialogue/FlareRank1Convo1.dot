	j3626820187 [label="+5 Chemistry",color=orange];
		j3626820187 -> j1330048383;
	j3210842513 [label="Boolean FlareLizzie1 is now true.",color=orange];
		j3210842513 -> j2450017507;
	j2612217747 [label="You're going to be okay. I promise.",shape=box,color=red];
		j2612217747 -> j784115795;
	j2707070315 [label="Suit yourself. I'll be here when you want to talk.",shape=box,color=red];
		j2707070315 -> j2206140283;
