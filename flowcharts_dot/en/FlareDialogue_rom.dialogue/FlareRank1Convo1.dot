		32 -> 39;
	34 [label="and the other one had something to say about \"space trauma\" i believe?",shape=box,color=blue];
		34 -> 33;
		34 -> 40;
	33 [label="Lol. Well, at least we can skip the introductory stuff.",shape=box,color=red];
		33 -> 17;
		33 -> 18;
	35 [label="enlighten me",shape=box,color=blue];
		35 -> 41;
	36 [label="where did he go? entrati? the others claim they don't know. that you don't either",shape=box,color=blue];
		36 -> 42;
	37 [label="I'm not sure I like your attitude?",shape=box,color=red];
		37 -> 43;
	38 [label="Uh... That's going to take a while, and I don't think it's going to give you the answers you want.",shape=box,color=red];
		38 -> 44;
	39 [label="Whoa, hold on. Back up. Are you okay?",shape=box,color=red];
		39 -> 45;
	40 [label="Yep. That'd be Quincy.",shape=box,color=red];
		40 -> 17;
		40 -> 18;
	41 [label="because from where i stand, i have a poison in my blood that is slowly causing me to lose my mind and corrupting my body",shape=box,color=blue];
		41 -> 46;
	42 [label="i call bullshit",shape=box,color=blue];
		42 -> 47;
	43 [label="i... apologize. this is not usually how i like to act. however, i'm in a bit of a situation that is... very hard to describe",shape=box,color=blue];
		43 -> 48;
	44 [label="this isn't about me wanting answers, dear space traveler. this is about me *needing* answers",shape=box,color=blue];
		44 -> 49;
	45 [label="i don't think i can adequately put into words how very not okay i am",shape=box,color=blue];
		45 -> 48;
	46 [label="and the only man who could give me answers about it - the only man who could explain it to me or get rid of her is *gone*",shape=box,color=blue];
		46 -> 50;
	47 [label="so i'd like to know everything you know about him, if you don't mind",shape=box,color=blue];
		47 -> 51;
	48 [label="and i'll remind you that is literally my job to put my feelings into words",shape=box,color=blue];
		48 -> 52;
	49 [label="and I don't think i can adequately put into words how very different my situation is from the others and how I *need* to get rid of her *immediately*",shape=box,color=blue];
		49 -> 53;
