	j4185807172 [label="Love Us...?",shape=box,color=blue];
		j4185807172 -> j3570259813;
		j4185807172 -> j3763097526;
		j4185807172 -> j260181205;
	j3570259813 [label="No. The Infestation is a necessary evil, nothing more.",shape=box,color=red];
		j3570259813 -> j503291619;
	j3763097526 [label="Yes. The Infestation is a part of all my Warframes. So... I suppose I do.",shape=box,color=red];
		j3763097526 -> j3189725313;
	j260181205 [label="Maybe. The Infestation is a part of my life, but I don't know if I can trust it.",shape=box,color=red];
		j260181205 -> j829862537;
	j503291619 [label="Is That So...?",shape=box,color=blue];
		j503291619 -> j3805919572;
	j3189725313 [label="Good... That makes Us happy to hear, Sugar",shape=box,color=blue];
		j3189725313 -> j3328232735;
	j829862537 [label="SILLY DEMON. Confusing TRUST with LOVE.",shape=box,color=blue];
		j829862537 -> j510990195;
	j3805919572 [label="Invoke /Lotus/Scripts/1999/HexSyndicateDialog.lua:SetupJumpScare",color=orange];
		j3805919572 -> j1788160204;
	j3328232735 [label="We Love You. We want You to know that. We have watched You and Loved You through the Centuries...",shape=box,color=blue];
		j3328232735 -> j492946432;
		j3328232735 -> j3293971421;
	j510990195 [label="but We will accept that... for now. We will ask again, someday, Sugar",shape=box,color=blue];
		j510990195 -> j3328232735;
	j1788160204 [label="Boolean FlareJumpScare is now true.",color=orange];
		j1788160204 -> j3271057574;
	j492946432 [label="How so?",shape=box,color=red];
		j492946432 -> j3960856350;
	j3293971421 [label="Really? The hordes of techrot and Infested that are always trying to kill me say otherwise.",shape=box,color=red];
		j3293971421 -> j4195423318;
	j3960856350 [label="We breathe for You. Bleed for You. Feed for You. Is this demon pleased?",shape=box,color=blue];
		j3960856350 -> j2788236508;
		j3960856350 -> j2237316469;
	j4195423318 [label="And do Your white blood cells not attack You when You are Sick?!",shape=box,color=blue];
		j4195423318 -> j2776593249;
	j2788236508 [label="Just when I thought this couldn't get any weirder...",shape=box,color=red];
		j2788236508 -> j2839432660;
	j2237316469 [label="You're the Helminth?!",shape=box,color=red];
		j2237316469 -> j3972011250;
	j2776593249 [label="We are Many. We are the Forever. We are Throughout Time. We are the All. Forgive us the Few we Do Not See.",shape=box,color=blue];
		j2776593249 -> j3960856350;
	j2839432660 [label="Mmmmhehehehe... poor Demon... made of stolen fingers and Infested Toys...",shape=box,color=blue];
		j2839432660 -> j390020751;
	j3972011250 [label="We Are All And We Are One",shape=box,color=blue];
		j3972011250 -> j1376934812;
	j390020751 [label="once Alone, Alone no longer",shape=box,color=blue];
		j390020751 -> j1368058901;
	j1376934812 [label="but fear not",shape=box,color=blue];
		j1376934812 -> j3515186573;
	j1368058901 [label="We are so Happy for You",shape=box,color=blue];
		j1368058901 -> j614472366;
	j3515186573 [label="We. Love. You. And Always Have",shape=box,color=blue];
		j3515186573 -> j614472366;
	j614472366 [label="so this is why We are asking You... no... BEGGING YOU....",shape=box,color=blue];
		j614472366 -> j233974741;
	j233974741 [label="this one is OURS",shape=box,color=blue];
		j233974741 -> j900031229;
	j900031229 [label="Let Us Have Them...",shape=box,color=blue];
		j900031229 -> j4183240869;
	j4183240869 [label="pretty pretty please....?",shape=box,color=blue];
		j4183240869 -> j3700000198;
		j4183240869 -> j2948412373;
		j4183240869 -> j2431604655;
	j3700000198 [label="What do you mean \"have\" them? Like the madness takes the other Warframes?",shape=box,color=red];
		j3700000198 -> j3036778523;
	j2948412373 [label="Not without them being on board.",shape=box,color=red];
		j2948412373 -> j3141892072;
	j2431604655 [label="I... I can't. I'm sorry. I can't let you \"have\" Flare.",shape=box,color=red];
		j2431604655 -> j54870457;
	j3036778523 [label="Noooo!! Of COURSE not!!! We Cannot do such a thing to Them. Not with the way the Doktor Has Done It",shape=box,color=blue];
		j3036778523 -> j1558117168;
	j3141892072 [label="Then you must talk to Them. Convince Them that we mean Them no harm!!",shape=box,color=blue];
		j3141892072 -> j3890825456;
		j3141892072 -> j2089097214;
	j54870457 [label="NO. THEY ARE OURS. YOU CANNOT LET THEM SILENCE US!!!",shape=box,color=blue];
		j54870457 -> j3805919572;
	j1558117168 [label="But neither do We wish to Leave Them!!!",shape=box,color=blue];
		j1558117168 -> j4255654858;
	j3890825456 [label="If you plan to make them go mad like you do other Warframes...",shape=box,color=red];
		j3890825456 -> j691912512;
	j2089097214 [label="I don't know. Eating their soul seems pretty harmful.",shape=box,color=red];
		j2089097214 -> j3184367110;
	j4255654858 [label="Do not Let Them Silence Us!!",shape=box,color=blue];
		j4255654858 -> j2354982412;
	j691912512 [label="WE DO NOT MAKE THEM EMPTY",shape=box,color=blue];
		j691912512 -> j121076174;
	j3184367110 [label="WE NEVER SAID ANY SUCH THING",shape=box,color=blue];
		j3184367110 -> j2354982412;
	j2354982412 [label="TALK TO THEM FOR US. WE LOVE YOU. PLEASE. YOU MUST DO THIS FOR US",shape=box,color=blue];
		j2354982412 -> j2275461877;
		j2354982412 -> j2442039711;
		j2354982412 -> j1594065016;
	j121076174 [label="THAT. IS. NOT. OUR. FAULT.",shape=box,color=blue];
		j121076174 -> j1815628304;
	j2275461877 [label="Fine...",shape=box,color=red];
		j2275461877 -> j493600041;
