		602 -> 605;
	606 [label="How so?",shape=box,color=red];
		606 -> 609;
	607 [label="Really? The hordes of techrot and Infested that are always trying to kill me say otherwise.",shape=box,color=red];
		607 -> 610;
	605 [label="+20 Chemistry",color=orange];
		605 -> 608;
	609 [label="We breathe for You. Bleed for You. Feed for You. Is this demon pleased?",shape=box,color=blue];
