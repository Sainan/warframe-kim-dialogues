	2616 [label="{\"Id\":2616,\"Incoming\":[599],\"Outgoing\":[602],\"GraphPos\":[6047,7332],\"Script\":{\"Script\":\"/Lotus/Scripts/1999/HexSyndicateDialog.lua\",\"Function\":\"SetupJumpScare\",\"_dogTagSyndicate\":\"\",\"_dogTagSyndicateDialogueWRes\":\"\",\"_lichWeaponsManifest\":\"\",\"_lichWeaponVendorCurrencyType\":\"\",\"_arthurDialogue\":\"\",\"_amirDialogue\":\"\",\"_aoiDialogue\":\"\",\"_eleanorDialogue\":\"\",\"_lettieDialogue\":\"\",\"_quincyDialogue\":\"\",\"_dialogueWRes\":\"\",\"_marieDialogue\":\"\",\"_roatheDialogue\":\"\",\"_lyonDialogue\":\"\",\"_greetingTransmission\":\"\",\"_onYourMindTransmission\":\"\",\"_togetherResponseTransmission\":\"\",\"_breakUpStartTransmission\":\"\",\"_goodbyeTransmission\":\"\",\"_breakUpTransmission\":\"\",\"_breakUpUnsureTransmission\":\"\",\"_kissCinematic\":\"\",\"_cinematicInputFilter\":\"\",\"_breakUpFadeTimer\":1,\"_breakUpFadeSound\":\"\",\"_breakUpEasterEggChance\":0.02,\"_breakUpEasterEggSound\":\"\",\"_questRankLimit\":3,\"_questKey\":\"\",\"_npcAvatar\":\"\",\"_actionInst\":\"\",\"_cameraSpotInst\":\"\",\"_avatarAnimations\":[],\"_avatarPositionWaypoints\":[],\"_actionPositionWaypoints\":[],\"_cameraSpotPositionWaypoints\":[],\"_doorPortalPortForwarderTag\":\"\",\"_nodeIntro\":\"\",\"_transmissionIdleDelay\":[20,25],\"_dioramaDisplayPurchases\":[],\"_dioramaDisplays\":[],\"_dioramaCue\":\"\",\"_dioramaSound\":\"\"}}",color=orange];
