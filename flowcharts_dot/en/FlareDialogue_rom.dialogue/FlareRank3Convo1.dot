		675 -> 680;
	676 [label="I don't even know if I have a way to describe it. But I understand. Trust me.",shape=box,color=red];
		676 -> 681;
	677 [label="Sometimes I wake up and I feel like there's another me living in a stranger's skin. That I don't match what's on the surface. Like I'm a lie.",shape=box,color=red];
