		1168 -> 1171 [label=true,color=green];
		1168 -> 1172 [label=true,color=green];
		1168 -> 1173 [label=false,color=brown];
	1169 [label="but You speak to Us of ridding the world of Us",shape=box,color=blue];
		1169 -> 1174;
	1170 [label="what do You need from Us, Sweet One?",shape=box,color=blue];
		1170 -> 1175;
		1170 -> 1176;
	1171 [label="I think we take her to the Void. Make the Indifference deal with her.",shape=box,color=red];
		1171 -> 1177;
	1172 [label="I think we find a way to kill Lizzie. I've killed thousands of Infested before. One more can't be hard.",shape=box,color=red];
		1172 -> 1178;
	1173 [label="Check boolean FlareWar4b",color=orange];
		1173 -> 1171 [label=true,color=green];
		1173 -> 1179 [label=true,color=green];
		1173 -> 1171 [label=false,color=brown];
		1173 -> 1179 [label=false,color=brown];
		1173 -> 1172 [label=false,color=brown];
	1174 [label="WHY",shape=box,color=blue];
		1174 -> 1180;
	1175 [label="Flare is worried that once they let you in, you're going to consume their consciousness. They'll cease to be \"them.\"",shape=box,color=red];
		1175 -> 1181;
	1176 [label="Can you describe to me how you're going to change them, exactly, if you get what you want? In... normal, non-cosmic horror terms, I mean.",shape=box,color=red];
		1176 -> 1182;
	1177 [label="...What could possibly go wrong...",shape=box,color=red];
		1177 -> 1183;
	1178 [label="I know you scoffed at the idea before, but I have *very* unique ways of killing things.",shape=box,color=red];
		1178 -> 1183;
	1179 [label="I've thought about your idea of trapping her in Duviri and... I think you're right. I think it'll work.",shape=box,color=red];
		1179 -> 1184;
	1180 [label="WHY should we heed YOUR words when YOU seek to drive US away?!",shape=box,color=blue];
		1180 -> 1185;
		1180 -> 1186;
	1181 [label="what is so special about being Them?",shape=box,color=blue];
		1181 -> 1187;
	1182 [label="Update boolean FlareNonCosmic",color=orange];
		1182 -> 1188;
	1183 [label="i'm willing to give anything a t",shape=box,color=blue];
		1183 -> 1189;
	1184 [label="Shove her into the prison cells with Kullervo. She can keep him company.",shape=box,color=red];
		1184 -> 1183;
	1185 [label="Calm down! I was just trying to get Flare out of the way. I want to talk about negotiating some kind of peace between you two.",shape=box,color=red];
		1185 -> 1190;
	1186 [label="Because you're wrong, and they want you out of their life. So I'm going to find a way to kill you, throw you into the Void - or something. I don't care what.",shape=box,color=red];
		1186 -> 1191;
	1187 [label="They are an empty husk, a shell of a porcelain painted doll without Us",shape=box,color=blue];
		1187 -> 1192;
	1188 [label="We will do Our best... ;)",shape=box,color=blue];
		1188 -> 1187;
	1189 [label="  ",shape=box,color=blue];
		1189 -> 1193;
	1190 [label="mmmmh.... dubious methods, but We are listening... go on",shape=box,color=blue];
		1190 -> 1176;
		1190 -> 1175;
	1191 [label="I am very, *very* good at killing the unkillable. Trust me.",shape=box,color=red];
		1191 -> 1194;
	1192 [label="We seek to fill Them up with Song. With Greatness. With that which They have sought Their entire lives",shape=box,color=blue];
		1192 -> 1195;
	1193 [label="  ",shape=box,color=blue];
		1193 -> 1196;
	1194 [label="@#!$%#^$#&%$^#@$ @#$@#$%$#^!@#$#@%$##^$%#$!!@#!@$#%%#@%$^%@$@$!@#$!@$@!#",shape=box,color=blue];
		1194 -> 1197;
	1195 [label="They chase the stars, and we consume Them",shape=box,color=blue];
		1195 -> 1198;
	1196 [label=" ",shape=box,color=blue];
		1196 -> 1199;
	1197 [label="hhaaAHAHHAHHAHAHHAHA",shape=box,color=blue];
		1197 -> 1200;
	1198 [label="and in joining with us, They will know what it is to be That which They Seek",shape=box,color=blue];
		1198 -> 1201;
	1199 [label=" ",shape=box,color=blue];
		1199 -> 1194;
	1200 [label="silly, foolish... little Demooon....",shape=box,color=blue];
		1200 -> 1202;
	1201 [label="Check boolean FlareNonCosmic",color=orange];
		1201 -> 1203 [label=true,color=green];
		1201 -> 1205 [label=true,color=green];
		1201 -> 1203 [label=false,color=brown];
		1201 -> 1204 [label=false,color=brown];
	1202 [label="did You thiiink... it would honestly be... So Simple...?",shape=box,color=blue];
		1202 -> 1206;
	1203 [label="I'm starting to see why Flare thinks you're going to eat them, Lizzie.",shape=box,color=red];
		1203 -> 1207;
	1205 [label="Is that your best take on \"non-cosmic horror\" terms?",shape=box,color=red];
		1205 -> 1209;
	1204 [label="So... you *do* plan to consume their consciousness?",shape=box,color=red];
		1204 -> 1208;
	1206 [label="mmmhmmmmmmhehehehe....",shape=box,color=blue];
		1206 -> 1210;
	1207 [label=":(",shape=box,color=blue];
		1207 -> 1211;
	1209 [label="....sorry",shape=box,color=blue];
		1209 -> 1212;
	1208 [label="y...es?",shape=box,color=blue];
		1208 -> 1211;
	1210 [label="We are going to let You into a... little secret...",shape=box,color=blue];
		1210 -> 1213;
	1211 [label="We. Plan. To. Share? Their? Mind?",shape=box,color=blue];
		1211 -> 1214;
	1212 [label="We will try again. Ahem.",shape=box,color=blue];
		1212 -> 1211;
	1213 [label="We are not... the first Lizzie...",shape=box,color=blue];
		1213 -> 1215;
	1214 [label="Is that. Better?",shape=box,color=blue];
		1214 -> 1216;
	1215 [label="the first is at the bottom of the river...",shape=box,color=blue];
		1215 -> 1217;
	1216 [label="We are not very good at being Small",shape=box,color=blue];
		1216 -> 1218;
	1217 [label="the second, a charred and empty husk",shape=box,color=blue];
		1217 -> 1219;
	1218 [label="it is why We have not spoken to this Demon very often",shape=box,color=blue];
		1218 -> 1220;
		1218 -> 1221;
	1219 [label="the third, rejected, bones broken like a baby bird thrown from the nest like a neglectful mother",shape=box,color=blue];
		1219 -> 1222;
	1220 [label="I don't think \"sharing\" is going to be good enough for Flare.",shape=box,color=red];
		1220 -> 1223;
	1221 [label="When you say \"share\" though, do you mean... \"share\" like you tried to \"share\" Eleanor?",shape=box,color=red];
		1221 -> 1224;
	1222 [label="try... try... try...",shape=box,color=blue];
		1222 -> 1225;
	1223 [label="but... isn't it fair...?",shape=box,color=blue];
		1223 -> 1226;
		1223 -> 1227;
	1224 [label="Yes! Precisely like that. She is such a Lovely One. We Love Her, So Very Much...",shape=box,color=blue];
		1224 -> 1228;
	1225 [label="run... run... run...",shape=box,color=blue];
		1225 -> 1229;
	1226 [label="I don't think Flare will ever want to give up their personal identity, Lizzie. But I also don't see the value in trying to kill or destroy you.",shape=box,color=red];
		1226 -> 1230;
	1227 [label="You have to try to see things from Flare's perspective. They're afraid. They've lost everything. And now they're afraid they're going to lose the only thing they have left - themselves.",shape=box,color=red];
		1227 -> 1230;
	1228 [label="Why couldn't We have been Born to Her...",shape=box,color=blue];
		1228 -> 1231;
	1229 [label="We... are ever-present... what would You be... without Us, TENNO...?",shape=box,color=blue];
		1229 -> 1232;
	1230 [label="but we are Their friend, not Their enemy...",shape=box,color=blue];
		1230 -> 1233;
		1230 -> 1234;
	1231 [label="She would have Embraced Us...",shape=box,color=blue];
		1231 -> 1235;
		1231 -> 1236;
	1232 [label="kill us all You like for it is You who breeds us, Demon...",shape=box,color=blue];
		1232 -> 1237;
	1233 [label="Then back off on the whole \"consuming their consciousness\" thing. ",shape=box,color=red];
		1233 -> 1238;
	1234 [label="You've been doing a shit job at showing them that.",shape=box,color=red];
		1234 -> 1238;
	1235 [label="What's \"sharing\" to you, looks like \"destruction\" to us. You have to try to understand that. I know it's hard to \"be small\" but try. Remember what happened to Eleanor? And Lettie?",shape=box,color=red];
		1235 -> 1239;
	1236 [label="You have to try to see things from Flare's perspective. They're afraid. They've lost everything. And now they're afraid they're going to lose the only thing they have left - themselves.",shape=box,color=red];
		1236 -> 1240;
	1237 [label="oh... and before You go...?",shape=box,color=blue];
		1237 -> 1241;
	1238 [label="We will... think...",shape=box,color=blue];
		1238 -> 1242;
	1239 [label="We saw it a million times over, and then a half a million again in salvation...",shape=box,color=blue];
		1239 -> 1243;
	1240 [label="but We are Their friend, not Their enemy...",shape=box,color=blue];
		1240 -> 1244;
