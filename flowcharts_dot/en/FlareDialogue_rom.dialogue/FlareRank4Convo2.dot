digraph {
	1154 [label="FlareRank4Convo2 begins.",color=orange];
		1154 -> 1155;
		1154 -> 1156;
	1155 [label="I've been thinking about your problem, and I think I have an idea on how to get rid of Lizzie permanently.",shape=box,color=red];
		1155 -> 1157;
		1155 -> 1158;
	1156 [label="All right. Let's work on negotiating some kind of peace, here...",shape=box,color=red];
		1156 -> 1159;
