		j3033480968 -> j1721340422;
		j3033480968 -> j3013340660;
	j3911598996 [label="I am very, *very* good at killing the unkillable. Trust me.",shape=box,color=red];
		j3911598996 -> j1329608283;
	j3900991567 [label="We seek to fill Them up with Song. With Greatness. With that which They have sought Their entire lives",shape=box,color=blue];
