	j479985082 [label="...What could possibly go wrong...",shape=box,color=red];
		j479985082 -> j3845688426;
	j4084884995 [label="I know you scoffed at the idea before, but I have *very* unique ways of killing things.",shape=box,color=red];
		j4084884995 -> j3845688426;
	j2586022659 [label="I've thought about your idea of trapping her in Duviri and... I think you're right. I think it'll work.",shape=box,color=red];
