		1159 -> 1163;
		1159 -> 1164;
	1160 [label="We need to talk.",shape=box,color=red];
		1160 -> 1165;
	1161 [label="I don't think Lettie would appreciate if I had to sacrifice an animal...",shape=box,color=red];
