		j2359593911 -> j3033480968;
	j1356203570 [label="Because you're wrong, and they want you out of their life. So I'm going to find a way to kill you, throw you into the Void - or something. I don't care what.",shape=box,color=red];
		j1356203570 -> j3911598996;
