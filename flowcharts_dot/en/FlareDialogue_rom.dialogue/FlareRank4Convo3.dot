	j3495005846 [label="but... i don't even know if this'll resonate with you...",shape=box,color=blue];
		j3495005846 -> j3872390239;
	j3872390239 [label="but sometimes i wake up and i just don't know who the world expects me to be anymore...",shape=box,color=blue];
