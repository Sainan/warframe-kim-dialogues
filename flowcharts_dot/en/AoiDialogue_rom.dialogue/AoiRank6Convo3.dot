	3953 [label="can't u just give them back?!",shape=box,color=blue];
		3953 -> 3955;
		3953 -> 3956;
	3954 [label="second",shape=box,color=blue];
		3954 -> 3941;
	3955 [label="I... don't know where they are.",shape=box,color=red];
		3955 -> 3957;
	3956 [label="I don't know if that's a good idea?",shape=box,color=red];
		3956 -> 3957;
	3957 [label="but they were stolen...",shape=box,color=blue];
		3957 -> 3958;
		3957 -> 3959;
	3958 [label="Even if we knew where they were, I don't know if we *should* give them back.",shape=box,color=red];
		3958 -> 3960;
	3959 [label="I know. I don't feel right about it, either.",shape=box,color=red];
		3959 -> 3961;
	3960 [label="what do u mean?",shape=box,color=blue];
		3960 -> 3962;
		3960 -> 3963;
	3961 [label="But unfortunately, the damage is done. Albrecht took the fingers. And now there's no going back.",shape=box,color=red];
		3961 -> 3960;
	3962 [label="There's something about the \"Strands of Khra.\" It's super complicated? Something about it... I don't know?",shape=box,color=red];
		3962 -> 3964;
	3963 [label="I don't know if giving them back would do any good. I don't think it'd change his mind.",shape=box,color=red];
		3963 -> 3965;
	3964 [label="Binding it here? Keeping it on our playing field? We have its fingers, so its stuck playing by our rules.",shape=box,color=red];
		3964 -> 3966;
	3965 [label="I think the damage is done. ",shape=box,color=red];
		3965 -> 3966;
	3966 [label=".... i don't like any of this",shape=box,color=blue];
		3966 -> 3967;
	3967 [label="space travel was supposed to be... fun. cool. full of... exploration, and meeting new species",shape=box,color=blue];
		3967 -> 3968;
