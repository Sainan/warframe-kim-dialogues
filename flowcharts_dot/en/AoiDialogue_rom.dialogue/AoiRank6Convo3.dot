		3923 -> 3925;
	3924 [label="Well, it depends on if it's the big ship or the little ship - but they both tap into the Void to cross the big distances. They cross through the Void.",shape=box,color=red];
		3924 -> 3926;
	3925 [label="Well, that's my Railjack. It has a replica of the severed finger of the Indifference - known as the Reliquary Drive - in it.",shape=box,color=red];
		3925 -> 3927;
	3926 [label="The big ship, the Railjack, uses a thing called a Reliquary Drive - it has a replica of the severed finger of the Indifference in it.",shape=box,color=red];
		3926 -> 3928;
	3927 [label="It uses that to tap into the Void to cross the big distances between the planets. It goes through the Void.",shape=box,color=red];
