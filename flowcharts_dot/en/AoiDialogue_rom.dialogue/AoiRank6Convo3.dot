		3930 -> 3931;
		3930 -> 3932;
	3931 [label="RL;CBA: Albrecht went into the Void, panicked, wound up stealing some of the Indifference's fingers.",shape=box,color=red];
		3931 -> 3933;
	3932 [label="Well. Okay. So. Albrecht... was the first person to \"discover\" how to get into the Void.",shape=box,color=red];
		3932 -> 3934;
	3933 [label="first... RL;CBA:?",shape=box,color=blue];
		3933 -> 3935;
	3934 [label="It was a diving bell, of sorts. Made of something called seriglass. He stretched open the membrane between the worlds.",shape=box,color=red];
		3934 -> 3936;
	3935 [label="Real Long; Can't Be Arsed. Quincy taught it to me.",shape=box,color=red];
		3935 -> 3937;
	3936 [label="Things went... wrong, to put it lightly. He panicked, staggered, the thing tipped, it got knocked against the razor-sharp edge of the membrane.",shape=box,color=red];
		3936 -> 3938;
	3937 [label="huh...",shape=box,color=blue];
		3937 -> 3939;
	3938 [label="The seriglass bell shattered and he fell into the Void.",shape=box,color=red];
		3938 -> 3940;
	3939 [label="second",shape=box,color=blue];
		3939 -> 3941;
	3940 [label="And when he came to, he was back in his lab, only it wasn't his lab. And he was staring at himself. Only it wasn't himself. And \"he\" called himself a name only his mother would know.",shape=box,color=red];
		3940 -> 3942;
	3941 [label="****U HAVE ITS FINGERS?!?!?!****",shape=box,color=blue];
		3941 -> 3943;
	3942 [label="So, Albrecht ran for his life. He cut himself up on the broken seriglass, and wrote in his own blood for his daughter to close the membrane behind him -",shape=box,color=red];
		3942 -> 3944;
	3943 [label="AND U USE IT TO POWER YOUR RAILJACK?!?!",shape=box,color=blue];
		3943 -> 3945;
	3944 [label="- because he could feel that the \"man\" was reaching for him.",shape=box,color=red];
		3944 -> 3946;
	3945 [label="<RETRO_EMOJI_HORRIFIED>",shape=box,color=blue];
		3945 -> 3947;
	3946 [label="She did. And when it shut? Well... its fingers were cut off, lying on the floor.",shape=box,color=red];
		3946 -> 3948;
	3947 [label="maybe that's y it's mad!!!",shape=box,color=blue];
		3947 -> 3949;
		3947 -> 3950;
	3948 [label="....wow...",shape=box,color=blue];
		3948 -> 3951;
