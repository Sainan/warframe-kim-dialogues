		j830763996 -> j3830868140;
	j1240183097 [label="Or off to wherever, to help... fix people.",shape=box,color=red];
		j1240183097 -> j3426304298;
	j3830868140 [label="yea, it will, 1 way or another",shape=box,color=blue];
		j3830868140 -> j682214680;
	j3426304298 [label="Even if it is to clean up his messes, in a way, it's to bring exactly that to the universe. That empathy you're talking about.",shape=box,color=red];
		j3426304298 -> j2058458674;
	j682214680 [label="So, do you want to hear about the solar rails next?",shape=box,color=red];
		j682214680 -> j3356335030;
