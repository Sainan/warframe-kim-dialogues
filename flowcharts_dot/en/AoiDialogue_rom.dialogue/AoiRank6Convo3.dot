		3949 -> 3952;
	3950 [label="Probably.",shape=box,color=red];
		3950 -> 3953;
	3951 [label="first: incredible story...",shape=box,color=blue];
		3951 -> 3954;
	3952 [label="oh...",shape=box,color=blue];
		3952 -> 3955;
