		j239915034 -> j2357189232;
	j115700355 [label="both!!! start with the big ship first!!",shape=box,color=blue];
		j115700355 -> j3370668088;
	j2357189232 [label="Well, it depends on if it's the big ship or the little ship - but they both tap into the Void to cross the big distances. They cross through the Void.",shape=box,color=red];
		j2357189232 -> j2879985289;
	j3370668088 [label="Well, that's my Railjack. It has a replica of the severed finger of the Indifference - known as the Reliquary Drive - in it.",shape=box,color=red];
		j3370668088 -> j4129813401;
	j2879985289 [label="The big ship, the Railjack, uses a thing called a Reliquary Drive - it has a replica of the severed finger of the Indifference in it.",shape=box,color=red];
		j2879985289 -> j2638780175;
	j4129813401 [label="It uses that to tap into the Void to cross the big distances between the planets. It goes through the Void.",shape=box,color=red];
		j4129813401 -> j2638780175;
	j2638780175 [label="<RETRO_EMOJI_OHNO>",shape=box,color=blue];
		j2638780175 -> j3214283477;
	j3214283477 [label="i'm sorry",shape=box,color=blue];
		j3214283477 -> j3822637587;
	j3822637587 [label="wat",shape=box,color=blue];
		j3822637587 -> j2102761691;
		j3822637587 -> j253055798;
	j2102761691 [label="RL;CBA: Albrecht went into the Void, panicked, wound up stealing some of the Indifference's fingers.",shape=box,color=red];
		j2102761691 -> j762417692;
	j253055798 [label="Well. Okay. So. Albrecht... was the first person to \"discover\" how to get into the Void.",shape=box,color=red];
		j253055798 -> j1053375767;
	j762417692 [label="first... RL;CBA:?",shape=box,color=blue];
		j762417692 -> j2463589016;
	j1053375767 [label="It was a diving bell, of sorts. Made of something called seriglass. He stretched open the membrane between the worlds.",shape=box,color=red];
		j1053375767 -> j1245751715;
	j2463589016 [label="Real Long; Can't Be Arsed. Quincy taught it to me.",shape=box,color=red];
		j2463589016 -> j2765431571;
	j1245751715 [label="Things went... wrong, to put it lightly. He panicked, staggered, the thing tipped, it got knocked against the razor-sharp edge of the membrane.",shape=box,color=red];
		j1245751715 -> j2128726517;
	j2765431571 [label="huh...",shape=box,color=blue];
		j2765431571 -> j1231806794;
	j2128726517 [label="The seriglass bell shattered and he fell into the Void.",shape=box,color=red];
		j2128726517 -> j1271435377;
	j1231806794 [label="second",shape=box,color=blue];
		j1231806794 -> j455773002;
	j1271435377 [label="And when he came to, he was back in his lab, only it wasn't his lab. And he was staring at himself. Only it wasn't himself. And \"he\" called himself a name only his mother would know.",shape=box,color=red];
		j1271435377 -> j2488253738;
	j455773002 [label="****U HAVE ITS FINGERS?!?!?!****",shape=box,color=blue];
		j455773002 -> j33193911;
	j2488253738 [label="So, Albrecht ran for his life. He cut himself up on the broken seriglass, and wrote in his own blood for his daughter to close the membrane behind him -",shape=box,color=red];
		j2488253738 -> j2579433489;
	j33193911 [label="AND U USE IT TO POWER YOUR RAILJACK?!?!",shape=box,color=blue];
		j33193911 -> j1689719553;
	j2579433489 [label="- because he could feel that the \"man\" was reaching for him.",shape=box,color=red];
		j2579433489 -> j3923633251;
	j1689719553 [label="<RETRO_EMOJI_HORRIFIED>",shape=box,color=blue];
		j1689719553 -> j4292404570;
	j3923633251 [label="She did. And when it shut? Well... its fingers were cut off, lying on the floor.",shape=box,color=red];
		j3923633251 -> j417918602;
	j4292404570 [label="maybe that's y it's mad!!!",shape=box,color=blue];
		j4292404570 -> j4043324550;
		j4292404570 -> j2023765550;
	j417918602 [label="....wow...",shape=box,color=blue];
		j417918602 -> j460555694;
	j4043324550 [label="It powers a lot more than just the Railjack, that's the problem...",shape=box,color=red];
		j4043324550 -> j3964607731;
	j2023765550 [label="Probably.",shape=box,color=red];
		j2023765550 -> j823722864;
	j460555694 [label="first: incredible story...",shape=box,color=blue];
		j460555694 -> j1231806794;
	j3964607731 [label="oh...",shape=box,color=blue];
		j3964607731 -> j823722864;
	j823722864 [label="can't u just give them back?!",shape=box,color=blue];
		j823722864 -> j3404146122;
		j823722864 -> j3912249792;
	j3404146122 [label="I... don't know where they are.",shape=box,color=red];
		j3404146122 -> j2625941261;
	j3912249792 [label="I don't know if that's a good idea?",shape=box,color=red];
		j3912249792 -> j2625941261;
	j2625941261 [label="but they were stolen...",shape=box,color=blue];
		j2625941261 -> j2991509537;
		j2625941261 -> j116366106;
	j2991509537 [label="Even if we knew where they were, I don't know if we *should* give them back.",shape=box,color=red];
		j2991509537 -> j3118690576;
	j116366106 [label="I know. I don't feel right about it, either.",shape=box,color=red];
		j116366106 -> j2579421029;
	j3118690576 [label="what do u mean?",shape=box,color=blue];
		j3118690576 -> j3565384177;
		j3118690576 -> j1680900722;
	j2579421029 [label="But unfortunately, the damage is done. Albrecht took the fingers. And now there's no going back.",shape=box,color=red];
		j2579421029 -> j3118690576;
	j3565384177 [label="There's something about the \"Strands of Khra.\" It's super complicated? Something about it... I don't know?",shape=box,color=red];
		j3565384177 -> j3997343583;
	j1680900722 [label="I don't know if giving them back would do any good. I don't think it'd change his mind.",shape=box,color=red];
		j1680900722 -> j2352761718;
	j3997343583 [label="Binding it here? Keeping it on our playing field? We have its fingers, so its stuck playing by our rules.",shape=box,color=red];
		j3997343583 -> j1231070555;
	j2352761718 [label="I think the damage is done. ",shape=box,color=red];
		j2352761718 -> j1231070555;
	j1231070555 [label=".... i don't like any of this",shape=box,color=blue];
		j1231070555 -> j3488250118;
	j3488250118 [label="space travel was supposed to be... fun. cool. full of... exploration, and meeting new species",shape=box,color=blue];
		j3488250118 -> j1628674523;
	j1628674523 [label="boldly going somewhere idk amir has a whole speech from one of his shows",shape=box,color=blue];
		j1628674523 -> j2109863397;
	j2109863397 [label="but it was supposed be about... humanity and empathy and learning and adventure",shape=box,color=blue];
		j2109863397 -> j2749097678;
	j2749097678 [label="not... this",shape=box,color=blue];
		j2749097678 -> j3502423206;
		j2749097678 -> j3872239896;
	j3502423206 [label="You never know, I suppose. Time will tell.",shape=box,color=red];
		j3502423206 -> j830763996;
	j3872239896 [label="Sometimes I wonder if that isn't what Entrati was doing, sending me back here. With all of you.",shape=box,color=red];
		j3872239896 -> j1240183097;
