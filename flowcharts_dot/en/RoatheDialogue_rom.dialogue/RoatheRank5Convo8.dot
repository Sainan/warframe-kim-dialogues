		j1553255311 -> j2734552173;
	j42602089 [label="Running and hiding from the truth won't work. We'll just wind up right back where we started.",shape=box,color=red];
		j42602089 -> j305790102;
	j2993053197 [label="Very likely. I will put two and two together and blame you for doing something I did not ask you to do. I am sure you will weather the storm.",shape=box,color=blue];
		j2993053197 -> j3146182394;
	j2734552173 [label="That may be. You are very likely right. But I do not have any other options to try, now do I? It is worth the attempt.",shape=box,color=blue];
		j2734552173 -> j3146182394;
	j305790102 [label="And if that is the case, then you can simply do the deed again. It is like you have an inexhaustible gift, isn't it?",shape=box,color=blue];
		j305790102 -> j3146182394;
	j3146182394 [label="I am certain I will be hideously angry at you once I realize you have altered my memories, of course. And I recommend not telling me it was by my request, Drifter.",shape=box,color=blue];
