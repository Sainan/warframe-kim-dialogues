	"Chat ends." [color=orange];
	j352200995 [label="You fool! What have you done?! Why, why go and delve into caverns where you are not welcome?!",shape=box,color=blue];
		j352200995 -> j1847514944;
	j1847514944 [label="Boolean RoatheFailNot21 is now false.",color=orange];
		j1847514944 -> j4158844579;
	j4158844579 [label="I demand you fix this. This is your fault. I can feel it, clawing at me, tearing at me. Like some great beast.",shape=box,color=blue];
		j4158844579 -> j1963923291;
	j1963923291 [label="Rid me of this. Rid me of this plague. Clear my mind of these memories. I know you can. Use this gift that you have and end it all. Now.",shape=box,color=blue];
		j1963923291 -> j309475164;
		j1963923291 -> j4168892528;
		j1963923291 -> j3899057325;
	j309475164 [label="Are you sure? But... you're smart, I get the feeling you'll figure something is up.",shape=box,color=red];
		j309475164 -> j3919124641;
	j4168892528 [label="Those are a different kind of memory, Roathe. It won't work on them. They are buried deeper in your psyche.",shape=box,color=red];
		j4168892528 -> j2444040588;
	j3899057325 [label="Running and hiding from the truth won't work. We'll just wind up right back where we started. ",shape=box,color=red];
		j3899057325 -> j232093781;
	j3919124641 [label="Very likely. I will put two and two together and blame you for doing something I did not ask you to do. I am sure you will weather the storm.",shape=box,color=blue];
		j3919124641 -> j209895258;
	j2444040588 [label="That may be. You are very likely right. But I do not have any other options to try, now do I? It is worth the attempt.",shape=box,color=blue];
		j2444040588 -> j209895258;
	j232093781 [label="And if that is the case, then you can simply do the deed again. It is like you have an inexhaustible gift, isn't it?",shape=box,color=blue];
		j232093781 -> j209895258;
	j209895258 [label="I am certain I will be hideously angry at you once I realize you have altered my memories, of course. And I recommend not telling me it was by my request, darling.",shape=box,color=blue];
		j209895258 -> j3955635686;
	j3955635686 [label="I will simply claim you are lying, and it will likely damage my opinion of you beyond repair.",shape=box,color=blue];
		j3955635686 -> j2558182393;
		j3955635686 -> j1527171636;
	j2558182393 [label="No. I can't do this. I won't do this. We have to face down this situation together. Can't we just talk about this?",shape=box,color=red];
		j2558182393 -> j1861214590;
	j1527171636 [label="I... there's really no other way?",shape=box,color=red];
		j1527171636 -> j1861214590;
	j1861214590 [label="No. If you want the butler to go upstairs? You wipe my mind of all of this nonsense as I have asked. If you do not care? Then do as you wish. It matters not to me.",shape=box,color=blue];
		j1861214590 -> j1146256579;
	j1146256579 [label="That, and, well, of course, our personal friendship is the only leverage I own in this situation. It is that simple.",shape=box,color=blue];
		j1146256579 -> j2786721293;
	j2786721293 [label="What say you?",shape=box,color=blue];
		j2786721293 -> j172269280;
		j2786721293 -> j2710098741;
	j172269280 [label="Okay. I'll... I'll do it. I'll wipe your mind. Even if it'll take Marie and Lyon's with it.",shape=box,color=red];
		j172269280 -> j2494914914;
	j2710098741 [label="No. I refuse. I'm sorry. We have to face this.",shape=box,color=red];
		j2710098741 -> j1132597268;
		j2710098741 -> j3746202430;
	j2494914914 [label="+10 Chemistry",color=orange];
		j2494914914 -> j543348969;
	j1132597268 [label="Let's talk this through.",shape=box,color=red];
		j1132597268 -> j393124952;
	j3746202430 [label="Hate me if you want. But I'm not going to do anything until we solve this, first.",shape=box,color=red];
		j3746202430 -> j644565083;
	j543348969 [label="Good. Get to it. ",shape=box,color=blue];
		j543348969 -> j4072107213;
	j393124952 [label="Do not dare - do not dare to speak to me of \"calming down!\" Do you not think I have every right to feel as though I am being torn in half?!",shape=box,color=blue];
		j393124952 -> j4291580379;
	j644565083 [label="Fascinating. Fascinating and unexpected. Explain.",shape=box,color=blue];
		j644565083 -> j814579175;
		j644565083 -> j151939892;
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j4291580379 [label="I feel as though I have had the very understanding of myself, the very basis of my foundation, cracked and torn open like damnable Lua herself! Rewritten in ink that runs. Coward!",shape=box,color=blue];
		j4291580379 -> j3831381518;
	j814579175 [label="I did what I did because it needed to happen. You couldn't hide from this any longer.",shape=box,color=red];
		j814579175 -> j1830055178;
	j151939892 [label="Think of me what you will. But I know a spiral when I've seen one.",shape=box,color=red];
		j151939892 -> j3753345552;
	j302033967 [label="Boolean RoatheWillReset is now true.",color=orange];
		j302033967 -> "Chat ends.";
	j3831381518 [label="And you dare to tell me to \"calm down?!\"",shape=box,color=blue];
		j3831381518 -> j1830055178;
	j1830055178 [label="Evaluate expressions",color=orange];
		j1830055178 -> j3029968226 [label="RoatheForgivenessShortcut",color=purple];
		j1830055178 -> j1166668532 [label="RoatheVillainyShortcut",color=purple];
		j1830055178 -> j2318547072 [label="false",color=purple];
	j3753345552 [label="Yes, I do think you would be a bit of a \"connoisseur\" of such things, wouldn't you? Go on.",shape=box,color=blue];
		j3753345552 -> j3276969946;
		j3753345552 -> j557980458;
	j3029968226 [label="Being angry isn't going to solve anything, Roathe. You're angry because you're scared to face what you did. And what you've become.",shape=box,color=red];
		j3029968226 -> j2630764241;
	j1166668532 [label="Fine. Be angry. But use that anger for something worthwhile. Use it to shake loose all this hatred you have in you that you're pointing in the wrong direction.",shape=box,color=red];
		j1166668532 -> j1008379212;
	j2318547072 [label="Evaluate expressions on Thermostat counter",color=orange];
		j2318547072 -> j3029968226 [label="x >= 5",color=purple];
		j2318547072 -> j1166668532 [label="x <= 0",color=purple];
		j2318547072 -> j2997705170 [label="x > 0 && x < 5",color=purple];
		j2318547072 -> j2997705170 [label="false",color=purple];
	j3276969946 [label="If you wish to seek forgiveness, you can. But you need to want it. You need to choose that path. No one else can.",shape=box,color=red];
		j3276969946 -> j3217127019;
	j557980458 [label="If you want to choose to blaze a path on your own? For yourself? Do it. Don't apologize. But that is your path to choose, no one else's.",shape=box,color=red];
		j557980458 -> j3689504920;
	j2630764241 [label="You're letting that anger tear you up inside. You could be using it to help you fight the people who are still destroying this world today. Here. Now.",shape=box,color=red];
		j2630764241 -> j172187071;
	j1008379212 [label="You're pointing it at yourself. You should be pointing it at the world that is blaming you for doing the best you could to save it from the Orokin Empire.",shape=box,color=red];
		j1008379212 -> j2514075241;
	j2997705170 [label="I just wish I knew how to help you. I wish I knew what to say. It feels like you're torn in two directions. Which way do you want to go?",shape=box,color=red];
		j2997705170 -> j2516685314;
	j3217127019 [label="You are not defined by your past, Roathe. You are defined by your future. And you still have a future to spend, unlike all the Orokin who died at the Night of the Naga Drums.",shape=box,color=red];
		j3217127019 -> j1975336654;
	j3689504920 [label="You are not defined by the opinions of those around you. Or what they think of your actions. You are defined only by what you believe of yourself and your choices.",shape=box,color=red];
		j3689504920 -> j2907149580;
	j172187071 [label="That is the only thing that defines you, now. You can change. And you can change the world around you. I guess my only question is, will you at least try?",shape=box,color=red];
		j172187071 -> j3036495607;
	j2514075241 [label="You are not defined by the opinions of those around you. Or what they think of your actions. You are defined only by what you believe of yourself and your choices.",shape=box,color=red];
		j2514075241 -> j487438829;
	j2516685314 [label="Boolean RoatheFail is now true.",color=orange];
		j2516685314 -> j1652915264;
	j1975336654 [label="That is the only thing that defines you, now. You can change. And you can change the world around you. I guess my only question is, will you at least try?",shape=box,color=red];
		j1975336654 -> j3863243551;
	j2907149580 [label="And the simple fact of the matter is? You are one of the very few Orokin we know that survived the Night of the Naga drums. From my point of view? It was a strategic retreat.",shape=box,color=red];
		j2907149580 -> j3400973831;
	j3036495607 [label="Try to forgive yourself and move forward?",shape=box,color=red];
		j3036495607 -> j704216064;
	j487438829 [label="And the simple fact of the matter is? You are one of the very few Orokin we know that survived the Night of the Naga drums. From my point of view? It was a strategic retreat.",shape=box,color=red];
		j487438829 -> j2340538314;
	j1652915264 [label="I do not know, Usurper. And therein lies the greatest problem.",shape=box,color=blue];
		j1652915264 -> j3321948837;
	j3863243551 [label="Try to forgive yourself and move forward?",shape=box,color=red];
		j3863243551 -> j512731418;
	j3400973831 [label="Nothing more. Nothing less.",shape=box,color=red];
		j3400973831 -> j593329198;
	j704216064 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j704216064 -> j3215094018;
	j2340538314 [label="Nothing more. Nothing less.",shape=box,color=red];
		j2340538314 -> j2196120962;
	j3321948837 [label="Within me is a malestrom of a rabid beast, eating away at my ribcage from the inside out.",shape=box,color=blue];
		j3321948837 -> j1716045212;
	j512731418 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j512731418 -> j4184638724;
