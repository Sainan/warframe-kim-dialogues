		j593329198 -> j4184638724;
	j3215094018 [label="+20 Chemistry",color=orange];
		j3215094018 -> j485553077;
	j2196120962 [label="Boolean RoatheVillain is now true.",color=orange];
		j2196120962 -> j1562847284;
	j1716045212 [label="And I do not know how to sate it. I do not know that I can. I had hoped that these conversations might have shown me a way; but I see now that this is fruitless.",shape=box,color=blue];
		j1716045212 -> j1304063769;
	j4184638724 [label="+20 Chemistry",color=orange];
		j4184638724 -> j1804112412;
	j485553077 [label="Forgive myself for what I have done? And move forward into the future? Hm.",shape=box,color=blue];
		j485553077 -> j1373770695;
	j1562847284 [label="+20 Chemistry",color=orange];
		j1562847284 -> j2149326009;
	j1304063769 [label="There is a solution though, is there not? You have it within your power to fix this... this horrible agony within my mind.",shape=box,color=blue];
		j1304063769 -> j2626923615;
	j1804112412 [label="Very well. I concede and accept your argument. Thank you, Drifter, for... talking me off this particular ledge.",shape=box,color=blue];
		j1804112412 -> j2592420589;
	j1373770695 [label="While I am slightly dubious of your reframing of the situation, I am... too tempted by this new future an what it might mean for me to resist it, Usurper. Drifter.",shape=box,color=blue];
		j1373770695 -> j3098068334;
	j2149326009 [label="A retreat to win the war. Hm.",shape=box,color=blue];
		j2149326009 -> j3637177219;
	j2626923615 [label="Usurper. Drifter. I am begging you now. Indeed, it is the only way I believe we can move forward, yes? It is for your own self-interests as well.",shape=box,color=blue];
		j2626923615 -> j1656887379;
	j2592420589 [label="I appreciate it. More than you might know.",shape=box,color=blue];
		j2592420589 -> j2043301822;
	j3098068334 [label="This \"new lease\" on my life. Very well. I concede and accept your argument. Thank you, Drifter, for... talking me off this particular ledge.",shape=box,color=blue];
		j3098068334 -> j2592420589;
	j3637177219 [label="While I am... slightly dubious of your reframing of your events as a tactical retreat, I admit I am... in favor of it, all the same, Usurper. Drifter.",shape=box,color=blue];
		j3637177219 -> j1804112412;
	j1656887379 [label="If you ever wish for the butler to go upstairs and reconcile with the Entrati family, you must do as I say. You must.",shape=box,color=blue];
		j1656887379 -> j2751011959;
		j1656887379 -> j4166535407;
	j2043301822 [label="I must go. I am in the mood to drink a great deal of alcohol and stare off broodingly into the middle distance.",shape=box,color=blue];
		j2043301822 -> "Chat ends. Next chat will be Roathe5Day2.";
	j2751011959 [label="Which is what...?",shape=box,color=red];
		j2751011959 -> j3057454879;
	j4166535407 [label="No. I know what you're going to ask, and the answer is already no.",shape=box,color=red];
		j4166535407 -> j3643504314;
	"Chat ends. Next chat will be Roathe5Day2." [color=orange];
	j3057454879 [label="You have a gift. A gift that can undo time. Spiral it, if not loop it. And this has... an interesting effect upon the minds of Protoframes, by its attachment to the Infestation and its attachment to time.",shape=box,color=blue];
		j3057454879 -> j3431562468;
	j3643504314 [label="If you can say to me that you have never once used your gifts to play with the minds of the Protoframes you call friends and lovers, and you can say it without a lie in your soul?",shape=box,color=blue];
		j3643504314 -> j3766387529;
	j3431562468 [label="And our attachment, therefore, to time. I ask you now. No, I beseech you, to wield it now on my behalf. Take these thoughts away from me. Take these memories away from me.",shape=box,color=blue];
		j3431562468 -> j2653574986;
	j3766387529 [label="Then very well. So be it. I will not ask this of you now. But if you have never once done it for your own amusement, curiosity, or to seek to undue errors you have made in the dealings with others?!",shape=box,color=blue];
		j3766387529 -> j2653574986;
	j2653574986 [label="I have to forget taking the serum from Entrati. Please.",shape=box,color=blue];
		j2653574986 -> j614101136;
		j2653574986 -> j1553255311;
		j2653574986 -> j42602089;
	j614101136 [label="Are you sure? But... you're smart, I get the feeling you'll figure something is up.",shape=box,color=red];
		j614101136 -> j2993053197;
