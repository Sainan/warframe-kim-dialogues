	j299540511 [label="Drifter... my poor, sweet, Drifter...",shape=box,color=blue];
		j299540511 -> j1255731109;
	j2930244981 [label="I have been left down here in this replica crypt with these two zealots for a little too long, I fear.",shape=box,color=blue];
		j2930244981 -> j1482801008;
	j2795879511 [label="It baffled me at first, when you bargained with me at the start. Why? Why would you cut such a dangerously open-ended deal for such a strange request?",shape=box,color=blue];
		j2795879511 -> j519343853;
	j2284965616 [label="Albrecht and his scrawny little butler saw fit to saddle you with a collection of broken toys. Very attractive broken toys.",shape=box,color=blue];
		j2284965616 -> j2697587030;
	j704154783 [label="True compassion?",shape=box,color=blue];
		j704154783 -> j3097292092;
	j1454565939 [label="You still owe me my end of the contract, whether or not you wish me to make good upon your end of it.",shape=box,color=blue];
		j1454565939 -> j1202057647;
	j183681999 [label="Well, I hate to inform you, that while I am perfectly comfortable \"sharing,\" the zealots... are very likely not. I recommend sorting out your current situation before pursuing ours any further.",shape=box,color=blue];
		j183681999 -> j2333189479;
	j2361498985 [label="Boolean RoatheDating is now true.",color=orange];
		j2361498985 -> j920927667;
	j3791037741 [label="So you seemed willing to sell your soul for a single bit of salvage. You can imagine my confusion.",shape=box,color=blue];
