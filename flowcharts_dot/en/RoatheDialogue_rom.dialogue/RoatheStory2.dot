	2140 [label="Transcript: When the Sentients completed the Solar Rail to Tau, there was no grand ceremony. It simply began to work.",shape=box,color=blue];
		2140 -> 2143;
	2143 [label="Ceremony was hastily created, of course, for no true Orokin can blow his nose without observing some pomp and circumstance.",shape=box,color=blue];
		2143 -> 2144;
	2144 [label="A great fuss was made over the First Transport to make the Crossing.",shape=box,color=blue];
		2144 -> 2147;
	2147 [label="It was Executor Tormis’s stately cruiser, and in the choice of Tormis as expeditionary could be read a collective rebuke to Executor Tuvul for the grotesque mishap of the Zariman Ten Zero. ",shape=box,color=blue];
		2147 -> 2137;
	2137 [label="Out Tormis went and back Tormis came, carrying wondrous bejewelled memories of a new System and new worlds to settle. ",shape=box,color=blue];
		2137 -> 5682;
	5682 [label="Within days a flotilla of colonist ships had departed, eager to set foot on the virgin shore.",shape=box,color=blue];
		5682 -> 2148;
	2148 [label="The Sentient attack that followed rather spoiled the mood.",shape=box,color=blue];
