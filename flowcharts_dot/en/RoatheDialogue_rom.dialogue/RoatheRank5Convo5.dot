		j80786278 -> j1218786666;
		j80786278 -> j3474789502;
		j80786278 -> j3326493426;
	j3494019696 [label="What good does it do us? All the good in the world! Of course, you are the one who has always fought alone. You have never been subjected to the tactics of an army.",shape=box,color=blue];
		j3494019696 -> j1309980706;
	j808080305 [label="Why bother? You poor thing. Of course, you are the one who has always fought alone. You have never been subjected to the tactics of an army.",shape=box,color=blue];
		j808080305 -> j1309980706;
