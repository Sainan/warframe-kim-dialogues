		j4290145 -> j3796152741 [label=true,color=green];
		j4290145 -> j3650933134 [label=false,color=brown];
	j822491263 [label="What I am trying to say, is that it wasn't a god before, but it is one now.",shape=box,color=red];
		j822491263 -> j845672935;
	j786507426 [label="Never mind.",shape=box,color=red];
		j786507426 -> j935861405;
	j2381878288 [label="Let us begin at the top, shall we? How would you define what a \"god\" is?",shape=box,color=blue];
		j2381878288 -> j920126219;
		j2381878288 -> j3355442947;
		j2381878288 -> j59203246;
	j3796152741 [label="Though I had no doubt you would come around, Drifter darling. you already had shown to be of discerning taste already.",shape=box,color=blue];
		j3796152741 -> j375630423;
	j3650933134 [label="Though I had no doubt you would come around, Drifter. I am quite convincing. ",shape=box,color=blue];
		j3650933134 -> j375630423;
	j845672935 [label="I see. It was fashioned into a \"god\" from the Void by Albrecht. And now we have a \"god\" on the loose. How charming.",shape=box,color=blue];
		j845672935 -> j4268793210;
		j845672935 -> j1285827072;
	j935861405 [label="Indeed.",shape=box,color=blue];
		j935861405 -> "Chat ends.";
	j920126219 [label="A supreme being. Something that has total and unquestionable authority or power. ",shape=box,color=red];
		j920126219 -> j2789259656;
	j3355442947 [label="A superhuman entity or creature that has power over a particular aspect of creation or human fortune.",shape=box,color=red];
		j3355442947 -> j2040275482;
	j59203246 [label="I'm not sure. You go first.",shape=box,color=red];
		j59203246 -> j1286896356;
	j375630423 [label="Now, if only we could find a way to convince all the other lunatics around the asylum...",shape=box,color=blue];
		j375630423 -> j833144731;
		j375630423 -> j2305117481;
	j4268793210 [label="Correct, yes.",shape=box,color=red];
		j4268793210 -> j835071117;
	j1285827072 [label="Yes, but I think we might be getting caught up on how we're both defining what a \"god\" is.",shape=box,color=red];
		j1285827072 -> j2431040356;
	j2789259656 [label="And you believe that your Indifference is one of these supreme beings?",shape=box,color=blue];
		j2789259656 -> j2743992003;
		j2789259656 -> j2186025963;
	j2040275482 [label="And this Indifference of yours is a supreme entity or creature? And is wields power over an aspect of... Indifference. Of uncaring?",shape=box,color=blue];
		j2040275482 -> j2186025963;
		j2040275482 -> j2743992003;
	j1286896356 [label="Now who is a coward? Very well. Allow me to simplify matters and cut right to the chase:",shape=box,color=blue];
		j1286896356 -> j80786278;
	j833144731 [label="What I don't understand, is what good this does us?",shape=box,color=red];
		j833144731 -> j3494019696;
	j2305117481 [label="Why bother?",shape=box,color=red];
		j2305117481 -> j808080305;
	j835071117 [label="Then let me simplify matters and cut right to the chase; Do you believe a \"god\" can die?",shape=box,color=blue];
		j835071117 -> j3158630897;
	j2431040356 [label="A fair point. How would you define a \"god?\"",shape=box,color=blue];
		j2431040356 -> j1832165979;
		j2431040356 -> j3154797612;
		j2431040356 -> j411549331;
	j2743992003 [label="I don't know.",shape=box,color=red];
		j2743992003 -> j233270360;
	j2186025963 [label="Yes. I believe so.",shape=box,color=red];
		j2186025963 -> j3323216182;
	j80786278 [label="Do you believe a \"god\" can die?",shape=box,color=blue];
		j80786278 -> j500710544;
