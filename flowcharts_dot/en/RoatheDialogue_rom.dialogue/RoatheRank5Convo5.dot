		j4046008236 -> j2127443513;
		j4046008236 -> j2752602915;
	j1036783084 [label="Aaah, I see. Now there's the rub. Yes, our definitions did not match. Insomuch as this \"Indifference\" is an entity as you describe it? Yes. We are agreed.",shape=box,color=blue];
		j1036783084 -> j2105694069;
	j2156091272 [label="Disappointing. I would have thought you more clever than that. But allow me to ask you this and cut to the chase:",shape=box,color=blue];
		j2156091272 -> j80786278;
	j2488802443 [label="Disappointing. But allow me to ask you this and cut to the chase:",shape=box,color=blue];
		j2488802443 -> j80786278;
	j1739547524 [label="Peacemongers. Why must there always be a peacemonger.",shape=box,color=blue];
		j1739547524 -> j3335747066;
	j1371107730 [label="Therefore, you imply in your modest ignorance, that we are all groping about in the darkness.",shape=box,color=blue];
		j1371107730 -> j2883446565;
