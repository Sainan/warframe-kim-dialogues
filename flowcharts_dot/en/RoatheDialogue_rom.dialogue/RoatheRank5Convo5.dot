	j978907978 [label="+5 Chemistry",color=orange];
		j978907978 -> j3126395200;
	j1287722398 [label="\"I didn't forget to water your office plant like I promised, it's simply experiencing a different Eternalism branch parallel to ours.\"",shape=box,color=blue];
		j1287722398 -> j3067174232;
	j2306781812 [label="While you do not sound terribly philosophical today but I will give it a go, nonetheless.",shape=box,color=blue];
		j2306781812 -> j157377535;
	j776748929 [label="Boolean RoatheDating is now false.",color=orange];
		j776748929 -> j178902881;
	j3126395200 [label="Glorious! Finally, progress is made. Sound the trumpets, ring the bells, someone finally sees sense!",shape=box,color=blue];
		j3126395200 -> j4290145;
	j3067174232 [label="It makes me want to scream. Can you simply commit to something for once in your miserable lives?!",shape=box,color=blue];
		j3067174232 -> j822491263;
		j3067174232 -> j786507426;
	j157377535 [label="It is not as though I have anything better to be doing with my time.",shape=box,color=blue];
		j157377535 -> j2381878288;
