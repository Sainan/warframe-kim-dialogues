	"Chat ends." [color=orange];
	j1887050668 [label="Have you thought any more about my argument regarding your \"Indifference?\"",shape=box,color=blue];
		j1887050668 -> j591551899;
		j1887050668 -> j2142372200;
		j1887050668 -> j3529829331;
		j1887050668 -> j2225943748;
	j591551899 [label="I have. I think what Entrati let loose from the Void was a shapeless god that was there in the aether before we arrived.",shape=box,color=red];
		j591551899 -> j2308129209;
	j2142372200 [label="I have. I think you're full of shit.",shape=box,color=red];
		j2142372200 -> j4099310853;
	j3529829331 [label="I have. I think you're right. I don't think it existed before Entrati interacted with it. He wanted to find a god... so the Void spat something out that's pretending to be one.",shape=box,color=red];
		j3529829331 -> j1895394034;
	j2225943748 [label="I have. I think the answer is somewhere in between. It may not have been a god before, but it is now. I think Entrati blinked it into existence the moment he opened the Void.",shape=box,color=red];
		j2225943748 -> j171258716;
	j2308129209 [label="It simply cannot understand what we are. ",shape=box,color=red];
		j2308129209 -> j1897724103;
	j4099310853 [label="Check boolean RoatheDating",color=orange];
		j4099310853 -> j1786253278 [label=true,color=green];
		j4099310853 -> j1746643871 [label=false,color=brown];
	j1895394034 [label="And we've been feeding it fear ever since.",shape=box,color=red];
		j1895394034 -> j2479268686;
	j171258716 [label="Like how Rell both Exists and Doesn't now, the Indifference is never was a god, yet now, always has been.",shape=box,color=red];
		j171258716 -> j842971152;
	j1897724103 [label="Can I convince you to consider my position once more? Or are your views on the topic immutable?",shape=box,color=blue];
		j1897724103 -> j622695256;
		j1897724103 -> j3356661263;
	j1786253278 [label="I would not have expected you to have such a delicate trigger, Drifter darling. But to quote the zealots, \"c'est la vie.\"",shape=box,color=blue];
		j1786253278 -> j650387292;
	j1746643871 [label="To quote the zealots, \"c'est la vie.\"",shape=box,color=blue];
		j1746643871 -> "Chat ends.";
	j2479268686 [label="Boolean DrifterMITWNotGod is now true.",color=orange];
		j2479268686 -> j978907978;
	j842971152 [label="I hate you Eternalism types. You use it as an excuse for everything. Once an Archimedean thinks they wrap their heads around it, off they go.",shape=box,color=blue];
		j842971152 -> j1287722398;
	j622695256 [label="You can try.",shape=box,color=red];
		j622695256 -> j2306781812;
	j3356661263 [label="No use.",shape=box,color=red];
