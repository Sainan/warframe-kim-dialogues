	"Chat ends." [color=orange];
	j3688307210 [label="VM: COMMISSION",shape=box,color=blue];
		j3688307210 -> j2400639983;
	j2400639983 [label="Transcript: Among the Seven I was - so I was told - considered Nitokh’s plaything and concubine.",shape=box,color=blue];
		j2400639983 -> j600922299;
	j600922299 [label="In the early days of the War they appointed me Vice Regent Grand Carnus at her goading, thinking it a jest.",shape=box,color=blue];
		j600922299 -> j4175507198;
	j4175507198 [label="How quickly their laughter turned to solemn applause as I brought home the news of one victory after another.",shape=box,color=blue];
		j4175507198 -> j75317906;
	j75317906 [label="The blood of better men dappled me like medals. In secret I amassed weapons for Nitokh.",shape=box,color=blue];
		j75317906 -> j1371300590;
	j1371300590 [label="It was easily done. I was too glorious a figure to be suspected",shape=box,color=blue];
		j1371300590 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}