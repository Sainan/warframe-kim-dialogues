	2132 [label="Transcript: Her madness was seductive because it was obvious.",shape=box,color=blue];
		2132 -> 5636;
	5636 [label="One always knew where one stood with her - right on the precipice of the great abyss.",shape=box,color=blue];
		5636 -> 5635;
	5635 [label="Leap in, her eyes said to me, gleaming with the joy of some colossal cosmic joke.",shape=box,color=blue];
		5635 -> 5637;
	5637 [label="Through her demented visions I could escape the long, bleak stagnation of Orokin existence.",shape=box,color=blue];
		5637 -> 2136;
	2136 [label="All our senses had been glutted to numbness centuries ago. Yet she was still, in her way, fresh.",shape=box,color=blue];
		2136 -> 5638;
	5638 [label="Eternal. Limitless in her hunger. She summoned me to her bath one evening. I strode across the mingling puddles of perfumed water and blood and stood dutifully to attention.",shape=box,color=blue];
		5638 -> 5639;
	5639 [label="“I’m bored, Roathe. Let’s kill all the other Orokin and take over.”",shape=box,color=blue];
		5639 -> 2135;
