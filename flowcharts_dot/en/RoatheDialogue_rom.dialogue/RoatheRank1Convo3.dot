	j906326440 [label="I wonder... How many battles would I have struck clean from the field and done again, if I had such a power?",shape=box,color=blue];
		j906326440 -> j1009392574;
	j260071941 [label="Boolean DrifterLyon is now true.",color=orange];
		j260071941 -> j2427699606;
