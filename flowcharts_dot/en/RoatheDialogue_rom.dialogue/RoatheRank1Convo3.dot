		j2786710632 -> j4284136791;
	j3828254973 [label="I know what he told the two zealots, for what little you could piss on it. \"Uriel, Heretic of Xata, in banishment, answer - can the Orokin ever be forgiven?\"",shape=box,color=blue];
		j3828254973 -> j1443628045;
	j961108148 [label="A Helminth. How it had grown in the past I do not know, as it had to have been there already for us to arrive. It withered and died in the process - I suspected another could be used for a return trip.",shape=box,color=blue];
		j961108148 -> j1576847661;
	j2458982287 [label="I do not know the details, as the memories are missing from my mind along with a great many others due to the transformation he forced upon me.",shape=box,color=blue];
		j2458982287 -> j3234502599;
	j3646397868 [label="I will pretend to be none the wiser in front of the zealots for you...",shape=box,color=blue];
