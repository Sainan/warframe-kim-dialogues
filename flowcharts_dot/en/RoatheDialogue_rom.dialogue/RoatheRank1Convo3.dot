		j4284136791 -> j1248692725;
	j1443628045 [label="If I were conscious at the time he had said it, I would have laughed in his face. Namely, because I am not the one here who is clearly seeking forgiveness, am I?",shape=box,color=blue];
		j1443628045 -> j1345971755;
	j1576847661 [label="I was correct. Though the process of creating one was... laborious and painstaking, to say the bloody least! I used samples of my own blood to reverse engineer a Helminth, by damn trial-and-error!",shape=box,color=blue];
		j1576847661 -> j3810471476;
	j3234502599 [label="But I have flashes. Shattered bits and pieces of a golden hallway. A voice I recognized - but not a face. It was Albrecht, but not the one I knew.",shape=box,color=blue];
		j3234502599 -> j2693578540;
