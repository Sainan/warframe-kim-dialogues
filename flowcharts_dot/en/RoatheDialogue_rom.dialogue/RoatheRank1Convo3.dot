digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank1Convo3 begins." [color=orange];
		"RoatheRank1Convo3 begins." -> j3451806040;
		"RoatheRank1Convo3 begins." -> j242691715;
	j3451806040 [label="May I ask - how did you wind up back here? From... when, exactly?",shape=box,color=red];
		j3451806040 -> j1782054338;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j1782054338 [label="Evaluate expressions on HellStory counter",color=orange];
		j1782054338 -> j1884374964 [label="x >= 21",color=purple];
		j1782054338 -> j1829990063 [label="x < 21",color=purple];
		j1782054338 -> j1829990063 [label="false",color=purple];
	"Chat ends." [color=orange];
	j1884374964 [label="Why do I suspect you already very well know the answer to this, my Usurper? What games are you playing at, by asking after such trivialities, if you have already picked over the pieces of my mind?",shape=box,color=blue];
		j1884374964 -> j4011668186;
	j1829990063 [label="Yes, you may ask! It provides me an opportunity to expound on my own brilliance and complain about Albrecht's profound ability to be both brainlessly harefooted and yet somehow a supreme poltroon at precisely the same time!",shape=box,color=blue];
		j1829990063 -> j4070589250;
	j4011668186 [label="Check boolean RoatheKnowsReset",color=orange];
		j4011668186 -> j2820985231 [label=true,color=green];
		j4011668186 -> j740067805 [label=false,color=brown];
	j4070589250 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4070589250 -> j489700667 [label="x >= 1",color=purple];
		j4070589250 -> j761287842 [label="x <= 0",color=purple];
		j4070589250 -> j761287842 [label="false",color=purple];
	j2820985231 [label="You are just as foul as Albrecht, meddling with the minds of those around you - thinking they are your toys to play with! So tell me. Why ask if you already have the answers, hm?",shape=box,color=blue];
		j2820985231 -> j3976453673;
		j2820985231 -> j682991014;
	j740067805 [label="Tell me. Am I correct in thinking you already have the answers you seek? You know already how I returned here with the zealots - from precisely whence we came. And likely a great deal more than that, don't you?",shape=box,color=blue];
		j740067805 -> j1129865119;
		j740067805 -> j2076887278;
	j489700667 [label="I gathered you weren't put there by choice by Albrecht.",shape=box,color=red];
		j489700667 -> j2669622110;
	j761287842 [label="Ah. So you weren't put in the past by choice.",shape=box,color=red];
		j761287842 -> j2669622110;
	j3976453673 [label="I'm trying to help guide you all through this process, and I screwed it up royally the last time. I'm trying again. \"From the top\" so to speak.",shape=box,color=red];
		j3976453673 -> j3208445817;
	j682991014 [label="I don't really know how to explain this. I didn't ask for this ability to erase your minds, and I'm trying to navigate this ability as best I can.",shape=box,color=red];
		j682991014 -> j912374616;
	j1129865119 [label="No. I don't.",shape=box,color=red];
		j1129865119 -> j2235940055;
	j2076887278 [label="I... admit that I do, yes.",shape=box,color=red];
		j2076887278 -> j1887650504;
	j2669622110 [label="No. No I very much was not. Now, here is something you must understand about the Orokin: We play - well... more correctly, played games with each other frequently. Games of all types. Political, psychological, sexual. It did not matter.",shape=box,color=blue];
		j2669622110 -> j1831021978;
	j3208445817 [label="+5 Chemistry",color=orange];
		j3208445817 -> j1635750031;
	j912374616 [label="You are doing a rather poor job of it then, my Perennial Acquaintance. What ends are you attempting to reach that you have not already gained before?",shape=box,color=blue];
		j912374616 -> j4269406562;
	j2235940055 [label="Hah. And now I know that you are a liar as well as a memory-thief, Usurper.",shape=box,color=blue];
		j2235940055 -> "Chat ends.";
	j1887650504 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j1887650504 -> j155950995;
	j1831021978 [label="Through the use of Kuva and the Yuvan Theatre, we were fundamentally and functionally immortal. Can you comprehend how wholly and utterly tiring that becomes?",shape=box,color=blue];
		j1831021978 -> j1722040072;
		j1831021978 -> j294487210;
	j1635750031 [label="Boolean RoatheResetScrewedUp is now true.",color=orange];
		j1635750031 -> j2488529748;
	j4269406562 [label="Check boolean LoidFamilyComplete",color=orange];
		j4269406562 -> j2619823462 [label=true,color=green];
		j4269406562 -> j2820457769 [label=true,color=green];
		j4269406562 -> j3815885529 [label=false,color=brown];
		j4269406562 -> j2619823462 [label=false,color=brown];
		j4269406562 -> j2820457769 [label=false,color=brown];
	j155950995 [label="Then why come to ask me questions to which you already know the answer?",shape=box,color=blue];
		j155950995 -> j3976453673;
		j155950995 -> j682991014;
	j1722040072 [label="I have some experience with that, believe it or not.",shape=box,color=red];
		j1722040072 -> j3297803346;
	j294487210 [label="I can, actually. But please, continue.",shape=box,color=red];
		j294487210 -> j2845225733;
	j2488529748 [label="Now this, I find fascinating... did you \"screw it up\" with me, or did you \"screw it up\" with Lyon or Marie?",shape=box,color=blue];
		j2488529748 -> j3947968573;
		j2488529748 -> j445025482;
		j2488529748 -> j1763845024;
	j2619823462 [label="Well, you see, you have this whole... thing about why you took the serum, and I... said the wrong things at the wrong times.",shape=box,color=red];
		j2619823462 -> j3985608631;
	j2820457769 [label="I... am trying to win the hearts of one of you, and I... really... messed it up...",shape=box,color=red];
		j2820457769 -> j2555981465;
	j3815885529 [label="I am trying to get you and the others to help me reunite Loid with the family upstairs and... I... couldn't...",shape=box,color=red];
		j3815885529 -> j2734764919;
	j3297803346 [label="You had experience with an eternity of dying, as far as I hear tell of it. Which is far more interesting - and yet you still found reason to become numb to it all in the end.",shape=box,color=blue];
		j3297803346 -> j2845225733;
	j2845225733 [label="My point was thus - I am accustomed, quite accustomed in fact - to the machinations and the schemes we Orokin play on each other to amuse ourselves. It is simply how we pass the time.",shape=box,color=blue];
		j2845225733 -> j814786181;
	j3947968573 [label="Lyon...",shape=box,color=red];
		j3947968573 -> j3438200082;
	j445025482 [label="Marie...",shape=box,color=red];
		j445025482 -> j120437173;
	j1763845024 [label="With you...",shape=box,color=red];
		j1763845024 -> j3203677930;
	j3985608631 [label="+5 Chemistry",color=orange];
		j3985608631 -> j4292986480;
	j2555981465 [label="+5 Chemistry",color=orange];
		j2555981465 -> j3586274207;
	j2734764919 [label="Hm. I see. We had an agreement, and you could not hold up your end of the bargain somehow, so you saw your prize fade from view.",shape=box,color=blue];
		j2734764919 -> j1667800882;
	j814786181 [label="But there are lines that we do not cross. Actions that we do not take. I could go on in detail but I will not. I will summarize simply by stating that Albrecht broke them all.",shape=box,color=blue];
		j814786181 -> j3745016428;
	j3438200082 [label="Truly? Have you tried simply feeding him and watering him once a day and seeing if that does the trick? Very well...",shape=box,color=blue];
		j3438200082 -> j2298932820;
	j120437173 [label="And you couldn't get that little puffball of purity to go along with you? I... am... hoping you do not go into any sort of career as a negotiator, my Perennial Acquaintance.",shape=box,color=blue];
		j120437173 -> j1093819058;
	j3203677930 [label="+5 Chemistry",color=orange];
		j3203677930 -> j4005961875;
	j4292986480 [label="Hm.",shape=box,color=blue];
		j4292986480 -> j88212502;
	j3586274207 [label="HA! This is glorious! You truly have my attention, now... which one of us? Hm? Do tell... don't be shy. Perhaps we can make an... arrangement.",shape=box,color=blue];
		j3586274207 -> j1036813716;
		j3586274207 -> j3898421927;
		j3586274207 -> j1512163416;
	j1667800882 [label="I sit here and two things strike me immediately upon confirmation of my suspicion:",shape=box,color=blue];
		j1667800882 -> j2000745126;
	j3745016428 [label="He abandoned me there, in some hideously ancient year, in some backwater wart on the arse of the Origin System! Do you know that Void-forsaken \"Cathédrale\" didn't even have electricity yet?! Electricity!",shape=box,color=blue];
		j3745016428 -> j490769072;
	j2298932820 [label="What about him gave you such trouble? Perhaps we could come to an arrangement?",shape=box,color=blue];
		j2298932820 -> j1302134513;
	j1093819058 [label="But tell me, what about her gave you such trouble? Perhaps we could come to an... arrangement?",shape=box,color=blue];
		j1093819058 -> j256724246;
	j4005961875 [label="HA! This is glorious! You truly have my attention, now... in what way? Hm? Do tell... don't be shy. Perhaps we can make an... arrangement.",shape=box,color=blue];
		j4005961875 -> j2004525054;
	j88212502 [label="I sit here and two things strike me immediately upon confirmation of my suspicion:",shape=box,color=blue];
		j88212502 -> j906326440;
	j1036813716 [label="Lyon...",shape=box,color=red];
		j1036813716 -> j260071941;
	j3898421927 [label="Marie...",shape=box,color=red];
		j3898421927 -> j1590531849;
	j1512163416 [label="You...",shape=box,color=red];
		j1512163416 -> j1926654164;
	j2000745126 [label="I wonder... How many battles would I have struck clean from the field and done again, if I had such a power?",shape=box,color=blue];
		j2000745126 -> j1473603336;
	j490769072 [label="Do you have any conceivable idea how hard it was to reverse engineer a Helminth with no electricity?!",shape=box,color=blue];
		j490769072 -> j4039092836;
		j490769072 -> j2497492018;
