	j3810471476 [label="Boolean RoatheHelminth1 is now true.",color=orange];
		j3810471476 -> j3452434349;
	j2693578540 [label="A burning, searing pain. Like none other that I had ever known before. And a previous body of mine lost an arm and a leg in a blast in war, Drifter. I have been covered in burns too severe to have recovered from if not for Kuva. I have known agony.",shape=box,color=blue];
		j2693578540 -> j2079684307;
