		j1926654164 -> j204295949;
	j1473603336 [label="How many minds would I have defiled if I had your gifts within my purview instead?",shape=box,color=blue];
		j1473603336 -> j4012465073;
	j4039092836 [label="So... Wait. I'm confused. How and when did Entrati turn you into a protoframe?",shape=box,color=red];
		j4039092836 -> j136576303;
	j2497492018 [label="You. Wait. You did what?!",shape=box,color=red];
		j2497492018 -> j2921147428;
	j1177817722 [label="He has... there's so much he's dealing with. And I don't know how to get through it all.",shape=box,color=red];
		j1177817722 -> j3207916380;
	j3206839701 [label="I have feelings for him...",shape=box,color=red];
		j3206839701 -> j260071941;
	j2126710739 [label="She won't see Entrati for what he is. And I cannot get her to see the truth of it, no matter what I do.",shape=box,color=red];
		j2126710739 -> j3382065402;
	j2142921849 [label="I have feelings for her...",shape=box,color=red];
		j2142921849 -> j1590531849;
	j222108350 [label="Well, you see, you have this whole thing about why you took the serum, and I... kind of messed it up...",shape=box,color=red];
		j222108350 -> j3985608631;
	j670783193 [label="[Confess feelings.] This is... this is really embarrassing, but I...",shape=box,color=red];
		j670783193 -> j1926654164;
	j1009392574 [label="How many minds would I have defiled if I had your gifts within my purview instead?",shape=box,color=blue];
		j1009392574 -> j45981657;
	j2427699606 [label="+5 Chemistry",color=orange];
		j2427699606 -> j3570632881;
	j245352705 [label="+5 Chemistry",color=orange];
		j245352705 -> j4047506645;
	j204295949 [label="+5 Chemistry",color=orange];
		j204295949 -> j1473325745;
	j4012465073 [label="Second, I am struck by the immediate fury and anger at knowing that my mind has been trifled with not once but twice in recent history. But there is another emotion that comes to defeat the anger. One I do not quite yet understand.",shape=box,color=blue];
		j4012465073 -> j1357925721;
	j136576303 [label="I do not know the details, as the memories are missing from my mind along with a great many others due to the transformation he forced upon me.",shape=box,color=blue];
		j136576303 -> j3242052540;
	j2921147428 [label="Yes! Precisely! With samples of my own blood, no less! I did not start in the same year that we left, I'll tell you that much! By the Void, I am going to peel his flesh off with these new claws of mine the moment I see his stupid, smug face -",shape=box,color=blue];
		j2921147428 -> j1631043598;
	j3207916380 [label="I would counsel simple patience instead, but... far be it from me to advise you to use a chisel when there is a laser pick sitting next to you.",shape=box,color=blue];
		j3207916380 -> j3185465003;
	j3382065402 [label="+5 Chemistry",color=orange];
		j3382065402 -> j246780767;
	j45981657 [label="Second, I am struck by the immediate fury and anger at knowing that my mind has been trifled with not once but twice in recent history. But there is another emotion that comes to defeat the anger. One I do not quite yet understand.",shape=box,color=blue];
		j45981657 -> j2357461864;
	j3570632881 [label="First: I am impressed! You took away all our memories so that you could have another attempt at winning his affections?!",shape=box,color=blue];
		j3570632881 -> j1675818904;
	j4047506645 [label="First: I am impressed! You took away all our memories so that you could have another attempt at winning her affections?!",shape=box,color=blue];
		j4047506645 -> j1336873365;
	j1473325745 [label="Oh this is truly magical! You took away all our memories in an attempt to have another try at winning my affections?!",shape=box,color=blue];
		j1473325745 -> j1248319172;
	j1357925721 [label="Betrayal.",shape=box,color=blue];
		j1357925721 -> j1858073335;
	j3242052540 [label="But I have flashes. Shattered bits and pieces of a golden hallway. A voice I recognized - but not a face. It was Albrecht, but not the one I knew.",shape=box,color=blue];
		j3242052540 -> j1446252527;
	j1631043598 [label="Allow me a moment to control my temper.",shape=box,color=blue];
		j1631043598 -> j2063486900;
	j3185465003 [label="I sit here and two things strike me immediately upon confirmation of my suspicion:",shape=box,color=blue];
		j3185465003 -> j818595378;
	j246780767 [label="Hm. I see. A noble endeavor, if I am being honest. One that I have attempted myself many, many times over. And failed equally so.",shape=box,color=blue];
		j246780767 -> j3881827939;
	j2357461864 [label="Betrayal.",shape=box,color=blue];
		j2357461864 -> j2594098202;
	j1675818904 [label="How very Orokin of you.",shape=box,color=blue];
		j1675818904 -> j4173445581;
	j1336873365 [label="How very Orokin of you.",shape=box,color=blue];
		j1336873365 -> j1376918177;
	j1248319172 [label="How very Orokin of you.",shape=box,color=blue];
		j1248319172 -> j1819367657;
	j1858073335 [label="Why?",shape=box,color=blue];
		j1858073335 -> j794428853;
	j1446252527 [label="A burning, searing pain. Like none other that I had ever known before. And a previous body of mine lost an arm and a leg in a blast in war, Drifter. I have been covered in burns too severe to have recovered from if not for Kuva. I have known agony.",shape=box,color=blue];
		j1446252527 -> j1497384324;
	j2063486900 [label="Thank you. We may proceed.",shape=box,color=blue];
		j2063486900 -> j4195405352;
	j818595378 [label="I wonder... How many battles would I have struck clean from the field and done again, if I had such a power?",shape=box,color=blue];
		j818595378 -> j3937197557;
	j3881827939 [label="I sit here and two things strike me immediately upon confirmation of my suspicion:",shape=box,color=blue];
		j3881827939 -> j3356371538;
	j2594098202 [label="Why?",shape=box,color=blue];
		j2594098202 -> j1549575902;
	j4173445581 [label="Second: How inept must you be?! I am fairly certain that if you simply tried feeding and watering the Priest once a day you would have his undying love and adoration.",shape=box,color=blue];
		j4173445581 -> j2161677553;
	j1376918177 [label="Second: Did you try limping in front of her? Feigning any kind of illness? Batting your eyes? Simply telling her that she looked nice? She does not seem terribly hard to woo.",shape=box,color=blue];
		j1376918177 -> j1183499068;
	j1819367657 [label="I sit here and two things strike me immediately upon confirmation of my suspicion:",shape=box,color=blue];
		j1819367657 -> j1766036852;
	j794428853 [label="But that is a conversation for another day. For I have a proposal for you. One I believe you will be far more interested in.",shape=box,color=blue];
		j794428853 -> j1962852858;
	j1497384324 [label="My body was being torn asunder and being remade. By force. I did not choose this. I do not know if it was the same for the others.",shape=box,color=blue];
		j1497384324 -> j2813363058;
	j4195405352 [label="I used samples of my own blood to reverse engineer a Helminth, by trial-and-error. It was not an easy task, with no access to any Orokin equipment. Or any equipment, for that matter, save what I could steal from the...",shape=box,color=blue];
		j4195405352 -> j3922278839;
	j3937197557 [label="How many minds would I have defiled if I had your gifts within my purview instead?",shape=box,color=blue];
		j3937197557 -> j1576740530;
	j3356371538 [label="I wonder... How many battles would I have struck clean from the field and done again, if I had such a power?",shape=box,color=blue];
		j3356371538 -> j2324980231;
	j1549575902 [label="But that is a conversation for another day. For I have a proposal for you. One I believe you will be far more interested in.",shape=box,color=blue];
		j1549575902 -> j1265378978;
	j2161677553 [label="Do not get me wrong! I am rather impressed at how devious you are. ",shape=box,color=blue];
		j2161677553 -> j3873890341;
	j1183499068 [label="Third: I sit here and I am suddenly keenly overwhelmed by realizations upon confirmation of my suspicion: ",shape=box,color=blue];
		j1183499068 -> j2882446657;
	j1766036852 [label="I wonder... How many battles would I have struck clean from the field and done again, if I had such a power?",shape=box,color=blue];
		j1766036852 -> j4240754871;
	j1962852858 [label="I will pretend to be none the wiser in front of the zealots for you...",shape=box,color=blue];
		j1962852858 -> j3497645759;
	j2813363058 [label="I remember cold stairs beneath me, as I was dropped upon them. Cathedral stairs, I know them to be now, as Lyon and Marie have told me the story from their recollections.",shape=box,color=blue];
		j2813363058 -> j4264910114;
	j3922278839 [label="I will not do them the favor of calling them \"rudimentary\" hospitals. Albrecht had used a Helminth to transport us to the past. How it had grown in the past I do not know, as it had to have been there already for us to arrive. It withered and died in the process - I suspected another could be used for a return trip.",shape=box,color=blue];
		j3922278839 -> j3494326770;
	j1576740530 [label="Second, I am struck by the immediate fury and anger at knowing that my mind has been trifled with not once but twice in recent history. But there is another emotion that comes to defeat the anger. One I do not quite yet understand.",shape=box,color=blue];
		j1576740530 -> j3958074585;
	j2324980231 [label="How many minds would I have defiled if I had your gifts within my purview instead?",shape=box,color=blue];
		j2324980231 -> j3804540831;
	j1265378978 [label="I will pretend to be none the wiser in front of the zealots for you...",shape=box,color=blue];
		j1265378978 -> j3196702812;
	j3873890341 [label="I do not think I can condemn you, quite honestly. How many battles would I have struck clean from the field and done again, if I had such a power?",shape=box,color=blue];
		j3873890341 -> j572221784;
	j2882446657 [label="I wonder... How many battles would I have struck clean from the field and done again, if I had such a power?",shape=box,color=blue];
		j2882446657 -> j704911238;
	j4240754871 [label="How many minds would I have defiled if I had your gifts within my purview instead?",shape=box,color=blue];
		j4240754871 -> j3020767923;
	j3497645759 [label="And, more importantly - I will ensure that you will succeed in your goal of uniting Albrecht's butler and the family, no matter what, this time around.",shape=box,color=blue];
		j3497645759 -> j2959048583;
	j4264910114 [label="Albrecht had brought me to their time, and to their foolish Cathedral. And placed me into their \"care.\"",shape=box,color=blue];
		j4264910114 -> j4099779516;
	j3494326770 [label="I was correct. Though the process of creating one was... laborious and painstaking.",shape=box,color=blue];
		j3494326770 -> j1091860166;
	j3958074585 [label="Betrayal.",shape=box,color=blue];
		j3958074585 -> j4209116567;
	j3804540831 [label="Second, I am struck by the immediate fury and anger at knowing that my mind has been trifled with not once but twice in recent history. But there is another emotion that comes to defeat the anger. One I do not quite yet understand.",shape=box,color=blue];
		j3804540831 -> j3024462599;
