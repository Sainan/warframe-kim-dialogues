	j3215671036 [label="+10 Chemistry",color=orange];
		j3215671036 -> j1780934983;
	j2876610108 [label="Excuse me?",shape=box,color=blue];
		j2876610108 -> j1147580518;
	j2343096450 [label="I am certain there is a degree of something unfeigned to what you say. Or at the very least, I believe you do not know your own self-delusion.",shape=box,color=blue];
		j2343096450 -> j1812273790;
	j1780934983 [label="Honesty is a wonderful thing, Drifter dear. Do you think I would shame you for enjoying yourself? Hardly.",shape=box,color=blue];
		j1780934983 -> j1651444364;
	j1147580518 [label="No. Surely you jest?",shape=box,color=blue];
		j1147580518 -> j1798151456;
	j1812273790 [label="I believe the greatest achievement of the Orokin Empire was its ability to convince those within it to believe their own conceits.",shape=box,color=blue];
		j1812273790 -> j3417825524;
	j1651444364 [label="Here is to a relationship of mutual satisfaction.",shape=box,color=blue];
		j1651444364 -> j3921499284;
	j1798151456 [label="But why make such an arrangement, unless...?",shape=box,color=blue];
		j1798151456 -> j3142935617;
		j1798151456 -> j3981177286;
	j3417825524 [label="In fact, perhaps that is the true connective tissue of the human race: our masterful ability to look in the mirror and deceive ourselves.",shape=box,color=blue];
		j3417825524 -> j1569783590;
	j3921499284 [label="Boolean RoatheUnloved4 is now true.",color=orange];
		j3921499284 -> j2965571546;
	j3142935617 [label="I screwed it up last time. I couldn't run that risk again.",shape=box,color=red];
		j3142935617 -> j1148402602;
	j3981177286 [label="I made the deal because I was desperate to get this right. ",shape=box,color=red];
		j3981177286 -> j1148402602;
	j1569783590 [label="All in the name of avoiding the terrible shame of admitting when we need to change.",shape=box,color=blue];
		j1569783590 -> j3699244152;
	j2965571546 [label="Boolean RoatheRedeemed is now false.",color=orange];
		j2965571546 -> j631673681;
	j1148402602 [label="Boolean RoatheLoved is now true.",color=orange];
		j1148402602 -> j3203122511;
	j3699244152 [label="Evaluate expressions",color=orange];
		j3699244152 -> j1219788115 [label="RoatheVillain",color=purple];
		j3699244152 -> j1484212828 [label="RoatheRedeemed",color=purple];
		j3699244152 -> "Chat ends." [label="false",color=purple];
	j631673681 [label="Boolean RoatheVillain is now false.",color=orange];
		j631673681 -> "Chat ends.";
	j3203122511 [label="You signed your soul away to the devil himself because... he unknowingly already held your broken heart.",shape=box,color=blue];
		j3203122511 -> j3238621063;
	j1219788115 [label="Not that I would know anything on the topic.",shape=box,color=blue];
		j1219788115 -> j4081414586;
	j1484212828 [label="I am a bit of an expert on the subject, as you well know.",shape=box,color=blue];
		j1484212828 -> j4081414586;
	j3238621063 [label="Drifter... my poor, sweet, Drifter...",shape=box,color=blue];
		j3238621063 -> j1112852181;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j1112852181 [label="Forgive me. Please, forgive me. I did not know.",shape=box,color=blue];
		j1112852181 -> j3084650526;
	j3084650526 [label="You must also understand that, until now, my love was a commodity that no one had sought to claim. Not in any meaningful way.",shape=box,color=blue];
		j3084650526 -> j2123103367;
	j2123103367 [label="So you seemed willing to sell your soul for a single bit of salvage. You can imagine my confusion. How baffled I was.",shape=box,color=blue];
		j2123103367 -> j2748488393;
	j2748488393 [label="Now? Now that I know the truth? Drifter, my Drifter... I could not be more glad that you did.",shape=box,color=blue];
		j2748488393 -> j2907313479;
	j2907313479 [label="Evaluate expressions",color=orange];
		j2907313479 -> j3451829241 [label="RoatheVillain",color=purple];
		j2907313479 -> j1420814413 [label="RoatheRedeemed",color=purple];
		j2907313479 -> j4067055295 [label="false",color=purple];
	j3451829241 [label="+10 Chemistry",color=orange];
		j3451829241 -> j128860923;
	j1420814413 [label="+10 Chemistry",color=orange];
		j1420814413 -> j4080862039;
	j4067055295 [label="+5 Chemistry",color=orange];
		j4067055295 -> j1569671304;
	j128860923 [label="For I cannot wait to see what we might together wreak upon this Origin System... and countless others.",shape=box,color=blue];
		j128860923 -> "Chat ends.";
	j4080862039 [label="For together, what we are capable of boggles the mind, doesn't it?",shape=box,color=blue];
		j4080862039 -> "Chat ends.";
	j1569671304 [label="The future awaits us.",shape=box,color=blue];
		j1569671304 -> "Chat ends.";
