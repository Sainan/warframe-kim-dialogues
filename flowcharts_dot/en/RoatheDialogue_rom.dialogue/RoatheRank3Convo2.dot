	j3720655375 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3720655375 -> j193543716 [label=true,color=green];
		j3720655375 -> j3102303055 [label=false,color=brown];
	"Chat ends." [color=orange];
	j193543716 [label="Why ask me this? What are you attempting to learn, Drifter? You are not asking after the location of munitions, certainly.",shape=box,color=blue];
		j193543716 -> j2644265086;
	j3102303055 [label="Why? Planning on going back in time and beating your younger self's record? In need of advice on how to overthrow a totalitarian government? Seeking the location of buried munitions that could detonate whole planets?",shape=box,color=blue];
		j3102303055 -> j2976081616;
	j2644265086 [label="Why would I trust you? Why did I trust you?!",shape=box,color=blue];
		j2644265086 -> j2310817378;
	j2976081616 [label="Or are you merely making idle conversation?",shape=box,color=blue];
		j2976081616 -> j130409742;
		j2976081616 -> j635264071;
		j2976081616 -> j2565284186;
	j2310817378 [label="Check boolean RoatheResetForgiven",color=orange];
		j2310817378 -> j2825966902 [label=true,color=green];
		j2310817378 -> j2600496109 [label=false,color=brown];
	j130409742 [label="I'm curious to know if you regret any of it, honestly. If you'd go back and change any of what you planned.",shape=box,color=red];
		j130409742 -> j1857507879;
	j635264071 [label="I'm fascinated by the idea of what it would have been like to try to come up with a plan like that. It must have been a masterpiece.",shape=box,color=red];
		j635264071 -> j942292438;
	j2565284186 [label="It might honestly be good to know, if you hid any of those weapons anywhere that are still accessible.",shape=box,color=red];
		j2565284186 -> j1481815392;
	j2825966902 [label="I have forgiven you for doing the deed. I simply wish I remembered why - why! Why you, of all people?!",shape=box,color=blue];
		j2825966902 -> j461029194;
		j2825966902 -> j82208263;
	j2600496109 [label="Why! Why you, of all people?!",shape=box,color=blue];
		j2600496109 -> j82208263;
		j2600496109 -> j3038526430;
	j1857507879 [label="Add 1 to Thermostat counter",color=orange];
		j1857507879 -> j3231804031;
	j942292438 [label="Add -1 to Thermostat counter",color=orange];
		j942292438 -> j260639257;
	j1481815392 [label="+5 Chemistry",color=orange];
		j1481815392 -> j1819013527;
	j461029194 [label="I know. And I'm still so sorry.",shape=box,color=red];
		j461029194 -> j707276627;
	j82208263 [label="I'm trying to get you to a place where you know why.",shape=box,color=red];
		j82208263 -> j3692867731;
	j3038526430 [label="I'm still sorry I broke your trust, Roathe. I wasn't trying to, believe it or not.",shape=box,color=red];
		j3038526430 -> j883738937;
	j3231804031 [label="All I regret is that it never came to fruition. I regret the wasted time.",shape=box,color=blue];
		j3231804031 -> j557199888;
	j260639257 [label="And a masterpiece it was, Usurper.",shape=box,color=blue];
		j260639257 -> j557199888;
	j1819013527 [label="Practical. But so many of the places where I \"hid\" my supplies have likely... wandered in the many, many years that have passed.",shape=box,color=blue];
		j1819013527 -> j1383196879;
	j707276627 [label="Yes, yes. I suppose we should carry on with this silly conversation where we retread our previous conversations once more.",shape=box,color=blue];
		j707276627 -> j4273091872;
	j3692867731 [label="+5 Chemistry",color=orange];
		j3692867731 -> j551854925;
	j883738937 [label="Yes, you likely believed there would not be consequences to your actions. But regardless, we should carry on with this silly conversation where we retread our previous selves and simply get on with it.",shape=box,color=blue];
		j883738937 -> j4273091872;
	j557199888 [label="+5 Chemistry",color=orange];
		j557199888 -> j591375069;
	j1383196879 [label="And many of the locations were secret even to me. The plan was beyond intricate. Layers upon layers upon layers deep.",shape=box,color=blue];
		j1383196879 -> j3940573709;
	j4273091872 [label="What was your question again? Ah! Yes. \"How was I planning on overthrowing the Executors?\" ",shape=box,color=blue];
		j4273091872 -> j2103972086;
	j551854925 [label="By retreading the same pointless conversations about why I wanted to murder people who are long since dead and dust? At least it is the pragmatic approach.",shape=box,color=blue];
		j551854925 -> j4273091872;
	j591375069 [label="The plan was beyond intricate. Layers upon layers upon layers deep. Assassins who would kill the assassins of other assassins should the first assassin fail.",shape=box,color=blue];
		j591375069 -> j4106361757;
	j3940573709 [label="Assassins who would kill the assassins of other assassins should the first assassin fail.",shape=box,color=blue];
		j3940573709 -> j4106361757;
	j2103972086 [label="Why?",shape=box,color=blue];
		j2103972086 -> j130409742;
		j2103972086 -> j635264071;
		j2103972086 -> j2565284186;
	j4106361757 [label="Bombs laid in multiple buildings, whole ships and an entire moon rigged to detonate with stolen explosives. A solar rail ready to fall out of orbit.",shape=box,color=blue];
		j4106361757 -> j2786102933;
	j2786102933 [label="And all of it rigged to look like a \"Great Sentient Disaster\" when the time came. Nitokh and I would declare the Empire in a state of emergency once the Executors and Emperors were... dealt with.",shape=box,color=blue];
		j2786102933 -> j1742364006;
	j1742364006 [label="Boolean RoatheTraitor2 is now true.",color=orange];
		j1742364006 -> j285070892;
	j285070892 [label="Check boolean RoatheExecutor1",color=orange];
		j285070892 -> j2826466175 [label=true,color=green];
		j285070892 -> j4287794810 [label=true,color=green];
		j285070892 -> j3778486626 [label=true,color=green];
		j285070892 -> j2826466175 [label=false,color=brown];
		j285070892 -> j4287794810 [label=false,color=brown];
	j2826466175 [label="What if your plan didn't work?",shape=box,color=red];
		j2826466175 -> j4252123173;
	j4287794810 [label="And what were you going to do then?",shape=box,color=red];
		j4287794810 -> j27678670;
	j3778486626 [label="What did you plan to do about Nitokh?",shape=box,color=red];
		j3778486626 -> j1932713100;
	j4252123173 [label="It was one of the many thousands of possible outcomes for which I had a plan. ",shape=box,color=blue];
		j4252123173 -> j3262867769;
	j27678670 [label="There were a thousand possible outcomes to what we had planned. For each variable in play, a possible variant of a path was created. ",shape=box,color=blue];
		j27678670 -> j2031741063;
	j1932713100 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1932713100 -> j3913872040 [label=true,color=green];
		j1932713100 -> j3045781125 [label=false,color=brown];
	j3262867769 [label="If we failed spectacularly, I would have simply eaten the end of a Lex and called it a day.",shape=box,color=blue];
		j3262867769 -> j1963963479;
	j2031741063 [label="And for each one, I had laid out a result. And for each one, I knew what I intended to do. Many were similar in the broad strokes of things, but were dissimilar in the details.",shape=box,color=blue];
		j2031741063 -> j2530596794;
	j3913872040 [label="What have I told you before about it? Because I find I do not yet trust you enough to tell you outright.",shape=box,color=blue];
		j3913872040 -> j4028338776;
		j3913872040 -> j483783294;
	j3045781125 [label="It was a complex matter of some... great negotiation between us.",shape=box,color=blue];
		j3045781125 -> j317642642;
		j3045781125 -> j3942734803;
	j1963963479 [label="No point crying over spilled Kuva, and all that.",shape=box,color=blue];
		j1963963479 -> j2186808807;
		j1963963479 -> j3163494170;
	j2530596794 [label="If we failed spectacularly, I would have simply eaten the end of a Lex and called it a day.",shape=box,color=blue];
		j2530596794 -> j2038292945;
	j4028338776 [label="You told me everything.",shape=box,color=red];
		j4028338776 -> j3532973893;
	j483783294 [label="Then I won't push you to tell me more than you want to.",shape=box,color=red];
		j483783294 -> j1804564980;
	j317642642 [label="There is a lot buried in that sentence.",shape=box,color=red];
		j317642642 -> j1626836581;
	j3942734803 [label="What kind of negotiations?",shape=box,color=red];
		j3942734803 -> j142424655;
	j2186808807 [label="I would have run, personally.",shape=box,color=red];
		j2186808807 -> j3096574606;
	j3163494170 [label="You would have just accepted death?",shape=box,color=red];
		j3163494170 -> j185361033;
	j2038292945 [label="If it was a middling success, which was the most likely, cleanup would be required to ensure all loose strings were \"dealt with.\" Naturally, of course, I was one of those strings. And I had steps to ensure that I was still too valuable in the short term to be snipped with the rest.",shape=box,color=blue];
		j2038292945 -> j325274172;
	j3532973893 [label="Then there is no point in my repeating myself now, is there? Indeed, there is hardly a point to this conversation at all. Have a lovely rest of your day.",shape=box,color=blue];
		j3532973893 -> "Chat ends.";
	j1804564980 [label="+5 Chemistry",color=orange];
		j1804564980 -> j1118431560;
	j1626836581 [label="+5 Chemistry",color=orange];
		j1626836581 -> j3133689937;
	j142424655 [label="Every kind you can imagine.",shape=box,color=blue];
		j142424655 -> j1861383400;
	j3096574606 [label="And run to where, my Usurper? Not all of us have pocket dimensions to escape to when we are in a panic.",shape=box,color=blue];
		j3096574606 -> j3925565425;
	j185361033 [label="I would have had little other choice, would I? Nowhere to go, nowhere to hide.",shape=box,color=blue];
		j185361033 -> j3925565425;
	j325274172 [label="If the situation was a rousing success, I would have gone forward with phase two of the plan.",shape=box,color=blue];
		j325274172 -> j1328725929;
		j325274172 -> j3124536553;
	j1118431560 [label="Good. I shall say that it was a complex matter of some... great negotiation between us.",shape=box,color=blue];
		j1118431560 -> j317642642;
		j1118431560 -> j3942734803;
	j3133689937 [label="Centuries beneath the sands.",shape=box,color=blue];
		j3133689937 -> j1861383400;
	j1861383400 [label="Boolean RoatheExecutor2 is now true.",color=orange];
		j1861383400 -> j1717274806;
	j3925565425 [label="Nitokh had made it painfully clear that if we failed, I would be the public sacrifice.",shape=box,color=blue];
		j3925565425 -> j1417435782;
		j3925565425 -> j876837005;
	j1328725929 [label="What was phase two?",shape=box,color=red];
		j1328725929 -> j2490891556;
	j3124536553 [label="Killing Nitokh?",shape=box,color=red];
		j3124536553 -> j596495675;
	j1717274806 [label="Evaluate expressions on HellStory counter",color=orange];
		j1717274806 -> j3283268355 [label="x >= 7",color=purple];
		j1717274806 -> j1110742369 [label="x < 7",color=purple];
		j1717274806 -> j1110742369 [label="false",color=purple];
	j1417435782 [label="And were you okay with that?",shape=box,color=red];
		j1417435782 -> j686873236;
	j876837005 [label="Not a terribly good idea to threaten you, if she wanted your loyalty.",shape=box,color=red];
		j876837005 -> j3557903600;
	j2490891556 [label="Murdering Nitokh, of course. Hardly a surprising twist. She knew herself it was likely to happen, and taunted me with it quite regularly.",shape=box,color=blue];
		j2490891556 -> j2980506922;
		j2490891556 -> j2920472592;
	j596495675 [label="+5 Chemistry",color=orange];
		j596495675 -> j1275536292;
	j3283268355 [label="As you know, I was one of her many her many playthings.",shape=box,color=blue];
		j3283268355 -> j1443707305;
	j1110742369 [label="I was one of her many partners, you understand.",shape=box,color=blue];
		j1110742369 -> j3241492245;
		j1110742369 -> j3054567803;
	j686873236 [label="+5 Chemistry",color=orange];
		j686873236 -> j83580213;
	j3557903600 [label="One thing you must understand about Orokin is that we were always scheming against each other. ",shape=box,color=blue];
		j3557903600 -> j1753074051;
	j2980506922 [label="And she was okay with that?",shape=box,color=red];
		j2980506922 -> j1387101207;
	j2920472592 [label="You both just knew you were out to kill each other?",shape=box,color=red];
		j2920472592 -> j1318899630;
	j1275536292 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1275536292 -> j2335820028 [label=true,color=green];
		j1275536292 -> j2440794059 [label=false,color=brown];
	j1443707305 [label="I once believed us to be partners. In politics, in intrigue, in bed...",shape=box,color=blue];
		j1443707305 -> j754657845;
	j3241492245 [label="Business partners?",shape=box,color=red];
		j3241492245 -> j165939203;
	j3054567803 [label="Partners, how?",shape=box,color=red];
		j3054567803 -> j2754578162;
	j83580213 [label="Hardly. But one thing you must understand about Orokin is that we were always scheming against each other. ",shape=box,color=blue];
		j83580213 -> j1753074051;
	j1753074051 [label="I knew that Nitokh would kill me without hesitation at any point if it might even possibly aid her in the pursuit of her goals.",shape=box,color=blue];
		j1753074051 -> j3788689673;
	j1387101207 [label="I think she enjoyed the challenge, Usurper. The sense of danger. The thrill of knowing she was sleeping with someone who wanted her dead.",shape=box,color=blue];
		j1387101207 -> j358882354;
	j1318899630 [label="I would like to pretend that we were the first Orokin to find themselves in such a situation, but it was not even that uncommon.",shape=box,color=blue];
		j1318899630 -> j358882354;
	j2335820028 [label="Precisely! It is almost as though you have heard this before. But it is hardly a surprising twist. She taunted me with it quite regularly.",shape=box,color=blue];
		j2335820028 -> j2980506922;
		j2335820028 -> j2920472592;
	j2440794059 [label="Precisely! But it is hardly a surprising twist. She saw it coming as well, and taunted me with it quite regularly.",shape=box,color=blue];
		j2440794059 -> j2980506922;
		j2440794059 -> j2920472592;
	j754657845 [label="I did not believe us to be equals, of course. She was an Executor. The Great Nitokh. But I thought myself First Amongst Her Lessers.",shape=box,color=blue];
		j754657845 -> j1661704123;
	j165939203 [label="You are adorable. Yes, in a manner of speaking, we were business partners. But we were also partners in many other more important ways.",shape=box,color=blue];
		j165939203 -> j2754578162;
	j2754578162 [label="In war. In politics. In intrigue. In bed.",shape=box,color=blue];
		j2754578162 -> j3122135702;
	j3788689673 [label="Yet she knew that I was sharpening my knives behind her back and eagerly awaiting the moment where I would remove her head from her shoulders.",shape=box,color=blue];
		j3788689673 -> j3300929295;
	j358882354 [label="The longer I live the more I realize we may not have been a species designed for immortality.",shape=box,color=blue];
		j358882354 -> j371153959;
	j1661704123 [label="What I fool I was...",shape=box,color=blue];
		j1661704123 -> j3884238298;
		j1661704123 -> j2614320978;
		j1661704123 -> j2859879059;
		j1661704123 -> j16964959;
		j1661704123 -> j3771074441;
	j3122135702 [label="But I wonder if I am misremembering. I wonder if \"partner\" is too strong a word for what we really were. ",shape=box,color=blue];
		j3122135702 -> j3961314499;
	j3300929295 [label="You could say we had a... complex relationship.",shape=box,color=blue];
		j3300929295 -> j3771074441;
		j3300929295 -> j16964959;
		j3300929295 -> j2859879059;
		j3300929295 -> j3884238298;
		j3300929295 -> j2614320978;
	j371153959 [label="But, yes. You could say that Nitokh and I had a... complex relationship.",shape=box,color=blue];
		j371153959 -> j3771074441;
		j371153959 -> j16964959;
		j371153959 -> j2859879059;
		j371153959 -> j3884238298;
		j371153959 -> j2614320978;
	j3884238298 [label="Did you care about her?",shape=box,color=red];
		j3884238298 -> j1445399367;
	j2614320978 [label="Did you love her?",shape=box,color=red];
		j2614320978 -> j2866352138;
	j2859879059 [label="Did you trust her?",shape=box,color=red];
		j2859879059 -> j2892560846;
	j16964959 [label="Don't regret what you did. You made your choices. There's no going back. Only forward.",shape=box,color=red];
		j16964959 -> j250137640;
	j3771074441 [label="The only thing we can do is make up for what we've done before is to look ahead with clear eyes.",shape=box,color=red];
		j3771074441 -> j1032206747;
	j3961314499 [label="She was the Great Nitokh after all. An Executor.",shape=box,color=blue];
		j3961314499 -> j1661704123;
	j1445399367 [label="Void, no! If she drunkenly wandered out an airlock one afternoon it would have solved a great deal of my damnable problems.",shape=box,color=blue];
		j1445399367 -> j675628185;
	j2866352138 [label="+5 Chemistry",color=orange];
		j2866352138 -> j2797839429;
	j2892560846 [label="Void, no! Never trust an Orokin, Drifter. Including me. Especially me! Love us, hate us, adore us, despise us - but never, ever trust us.",shape=box,color=blue];
		j2892560846 -> j681172887;
	j250137640 [label="Add -1 to Thermostat counter",color=orange];
		j250137640 -> j3122888601;
	j1032206747 [label="Add 1 to Thermostat counter",color=orange];
		j1032206747 -> j1608528489;
	j675628185 [label="I absolutely, positively despised her, and I would have adored nothing more than to slowly, carefully, gently peel her blue skin off her body with my bare hands.",shape=box,color=blue];
		j675628185 -> j1509160783;
		j675628185 -> j1360098821;
	j2797839429 [label="What an impertinent question! I think I adore you for asking it. You know, I think I did love her, just a little. I have honestly not even stopped to ponder that until right this moment.",shape=box,color=blue];
		j2797839429 -> j3661193462;
	j681172887 [label="We are prone to fits of restlessness.",shape=box,color=blue];
		j681172887 -> j9883457;
		j681172887 -> j4269034065;
	j3122888601 [label="+10 Chemistry",color=orange];
		j3122888601 -> j2319794396;
	j1608528489 [label="+10 Chemistry",color=orange];
		j1608528489 -> j1670363753;
	j1509160783 [label="That was... vivid.",shape=box,color=red];
		j1509160783 -> j445280444;
	j1360098821 [label="And yet you were sleeping with her?",shape=box,color=red];
		j1360098821 -> j2031327618;
	j3661193462 [label="Yes, I think I was just the slightest bit infatuated with her. What a curious realization...",shape=box,color=blue];
		j3661193462 -> j3912174263;
	j9883457 [label="Noted.",shape=box,color=red];
		j9883457 -> j3607220764;
	j4269034065 [label="That wasn't going to be a problem.",shape=box,color=red];
		j4269034065 -> j2532285862;
	j2319794396 [label="You may be right. Living in the past is dangerous, for we saddle ourselves with regret and shame and nothing else. ",shape=box,color=blue];
		j2319794396 -> j4007514014;
	j1670363753 [label="You may be right. Living in the past is dangerous, for we saddle ourselves with regret and shame and nothing else. ",shape=box,color=blue];
		j1670363753 -> j2589115935;
	j445280444 [label="Picturing it in my mind was the only thing that allowed me to suffer through many of my... mandatory evenings in her bed. I apologize.",shape=box,color=blue];
		j445280444 -> j1119696217;
		j445280444 -> j4234944871;
	j2031327618 [label="The fact that you believe those two things are mutually exclusive is positively adorable. I hope you have the opportunity to experience an evening with such an \"acquaintance\" someday, it is fairly magical.",shape=box,color=blue];
		j2031327618 -> j1016852798;
	j3912174263 [label="You must understand, it was also clouded over with the deepest and most extremely overwhelming hatred as well. I despised her in the same breath and I would have adored nothing more than to slowly, carefully, gently peel her blue skin off her body with my bare hands.",shape=box,color=blue];
		j3912174263 -> j1679949405;
		j3912174263 -> j76792568;
	j3607220764 [label="Evaluate expressions",color=orange];
		j3607220764 -> j1193193359 [label="RoatheDatingDeal",color=purple];
		j3607220764 -> j2309760109 [label="RoatheMarieDatingDeal",color=purple];
		j3607220764 -> j2236860836 [label="RoatheLyonDatingDeal",color=purple];
		j3607220764 -> j2272640744 [label="DrifterRoathe",color=purple];
		j3607220764 -> j708150103 [label="DrifterMarie",color=purple];
		j3607220764 -> j2236860836 [label="DrifterLyon",color=purple];
		j3607220764 -> j2673220837 [label="false",color=purple];
	j2532285862 [label="Mm, yes. I get the sense I am not precisely winning you over with my \"devilish charm,\" am I?",shape=box,color=blue];
		j2532285862 -> j2256930578;
		j2532285862 -> j2538347332;
	j4007514014 [label="What point is there, reliving our past deeds, our past failures and regrets? We cannot change them - even with this gift of time travel, it is only a path to madness to attempt to \"redo\" that which has been \"done.\"",shape=box,color=blue];
		j4007514014 -> j1281490655;
	j2589115935 [label="But neither can we forget the misdeeds of our former selves, for we risk becoming nothing but madmen and despots, belligerent creatures who see no fault within ourselves and only within others.",shape=box,color=blue];
		j2589115935 -> j3092222697;
	j1119696217 [label="Do you have those thoughts about all your lovers? or just her?",shape=box,color=red];
		j1119696217 -> j1579246975;
	j4234944871 [label="No apology necessary. I'm just still shocked at how much you hated your own people.",shape=box,color=red];
		j4234944871 -> j2880511743;
	j1016852798 [label="I simply recommend that you do not make such relationships a permanent affair. It becomes wildly unhealthy for both parties. It usually ends in murder for one or both of you.",shape=box,color=blue];
		j1016852798 -> j1119696217;
		j1016852798 -> j1912445034;
		j1016852798 -> j3149290966;
	j1679949405 [label="How can both of those things be true at the same time?",shape=box,color=red];
		j1679949405 -> j3583235115;
