	j2673220837 [label="+5 Chemistry",color=orange];
		j2673220837 -> j1127631878;
	j2256930578 [label="No. Sorry. You aren't my type.",shape=box,color=red];
		j2256930578 -> j705993254;
	j2538347332 [label="You are. I just don't trust you.",shape=box,color=red];
		j2538347332 -> j4137689758;
	j1281490655 [label="No. I am what I am. I am who I am. I walk the path I have chosen and I am past the point of wishing to apologize for myself. I will not change what I am to suit the opinions of others.",shape=box,color=blue];
		j1281490655 -> j737812691;
	j3092222697 [label="This was a trait I saw in many of the poorest of the Executors and the Emperors - blind faith in only their own faultless and guiltless selves. I despised them for it and vowed I would never share such egotistical hubris.",shape=box,color=blue];
		j3092222697 -> j737812691;
	j1579246975 [label="I only ever truly dabbled with partners of the physical sense, Drifter. I never had emotional ones. None that were ever mutual, at any rate.",shape=box,color=blue];
		j1579246975 -> j1281467825;
		j1579246975 -> j3812884184;
