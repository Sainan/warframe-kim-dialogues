		j3384839978 -> j4232798911;
	j1062205185 [label="+5 Chemistry",color=orange];
		j1062205185 -> j3448765824;
	j2623017213 [label="Must I spell it out for you? Very well. I have never been in love.",shape=box,color=blue];
		j2623017213 -> j3078864355;
	j3435653199 [label="For all of our advances, for all the work we did to save humanity - we never solved the greatest issue that plagued us in our hearts. The greatest flaw that ate at our souls like a atrous cancer.",shape=box,color=blue];
		j3435653199 -> j903803884;
	j3948078203 [label="See that you do. You seem like you are doing your best to live a good life, Drifter. To be a \"good\" person. I would hate to see you wind up like the Orokin. We were defined by our excess.",shape=box,color=blue];
		j3948078203 -> j3514673004;
	j2319195863 [label="Quite welcome. You seem like you are doing your best to live a good life, Drifter. To be a \"good\" person. I would hate to see you wind up like the Orokin. We were defined by our excess.",shape=box,color=blue];
		j2319195863 -> j3514673004;
	j1569114633 [label="I only ever truly dabbled with partners of the physical sense, Drifter. I never had emotional ones. None that were ever mutual, at any rate.",shape=box,color=blue];
		j1569114633 -> j1281467825;
		j1569114633 -> j3812884184;
	j3595008363 [label="Pathetic, isn't it? All the advances in the universe and we still could not manage to figure out how to organize ourselves without wasting hours of everyone's lives gathered around a table talking past each other.",shape=box,color=blue];
		j3595008363 -> j3435653199;
