digraph {
	472 [label="RoatheRank1Convo4 begins.",color=orange];
		472 -> 473;
	473 [label="Check boolean LoidFamilyComplete",color=orange];
		473 -> 474 [label=true,color=green];
		473 -> 475 [label=false,color=brown];
	474 [label="It is almost tragic what's become of Euleria and Petros. We were never friends, mind. But they were still Orokin. And now there are precious few of us left. Though I suppose I should be careful what I say - who knows what I might devolve into, given enough time.",shape=box,color=blue];
		474 -> 476;
	475 [label="I find it rather hysterical that Euleria and Petros really haven't the slightest clue that we are down here. Like rats, scurrying about under their feet. How have you and the children managed to keep this all a secret for so long?",shape=box,color=blue];
		475 -> 477;
	476 [label="The one I am least surprised to have survived is \"Grandmother.\" (Imagine, giving away a perfectly good name like Dagath.)",shape=box,color=blue];
		476 -> 478;
		476 -> 479;
	477 [label="Evaluate expressions on HellStory",color=orange];
		477 -> 481 [label="x >= 21",color=purple];
		477 -> 480 [label="x < 21",color=purple];
		477 -> 480 [label="false",color=purple];
	478 [label="Petros?",shape=box,color=red];
		478 -> 482;
	479 [label="What do you think of the kids?",shape=box,color=red];
		479 -> 483;
	481 [label="Although I am honestly far more surprised at \"Grandmother\" being unable to work it out. (Imagine, giving away a perfectly good name like Dagath.) I thought she had more sense in her than that.",shape=box,color=blue];
		481 -> 486;
	480 [label="Although I am honestly far more surprised at \"Grandmother\" being unable to work it out. (Imagine, giving away a perfectly good name like Dagath.) I thought she had more nous in her than that.",shape=box,color=blue];
		480 -> 484;
		480 -> 485;
	482 [label="Hm? Ah. The necraloid informed me, that you or the child stomped about helping them concoct false names for themselves, having forgotten their original ones. You know him as \"Vilcor.\"",shape=box,color=blue];
		482 -> 487;
	483 [label="The boy is petulant, irritating, and egocentric. A perfect Orokin. \"Kaelli,\" as she says she prefers to be called now, I find remarkably intelligent and nearly worth suffering the presence of.",shape=box,color=blue];
		483 -> 488;
	486 [label="I. This is absurd. I know we have been through all this before. And we've spoken of this already. Which is a matter I still find deeply troubling.",shape=box,color=blue];
		486 -> 491;
	484 [label="They have their own... issues to focus on.",shape=box,color=red];
		484 -> 489;
	485 [label="Petros?",shape=box,color=red];
		485 -> 490;
	487 [label="But I knew him as Petros Vorten. Proud inventor of the Necramech Fleet. It is strange to think of how much time has passed for him, and how little time has passed - relatively speaking - for me.",shape=box,color=blue];
		487 -> 488;
	488 [label="But how do you not already know this? Are you playing me for a fool, Usurper? Certainly we are simply... rehashing old ground, as it were?",shape=box,color=blue];
		488 -> 492;
	491 [label="Evaluate expressions",color=orange];
		491 -> 498 [label="RoatheDatingDeal",color=purple];
		491 -> 498 [label="RoatheMarieDatingDeal",color=purple];
		491 -> 498 [label="RoatheLyonDatingDeal",color=purple];
		491 -> 498 [label="RoatheSerumDeal",color=purple];
		491 -> 497 [label="RoatheFamilyDeal",color=purple];
		491 -> 498 [label="RoatheMarieEntratiDeal",color=purple];
		491 -> 498 [label="RoatheLyonConfessionDeal",color=purple];
		491 -> 499 [label="false",color=purple];
	489 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		489 -> 494 [label=true,color=green];
		489 -> 493 [label=false,color=brown];
	490 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		490 -> 496 [label=true,color=green];
		490 -> 495 [label=false,color=brown];
	492 [label="Update boolean RoatheKnowsReset",color=orange];
		492 -> 500;
		492 -> 501;
		492 -> 502;
	498 [label="Here I am, ready to launch into some twilight and wandering lecture on Orokin society, in thinking it might be vaguely of interest to you. And then I remind myself, that is not why you are here, is it, Drifter? You have another game to play...",shape=box,color=blue];
		498 -> 506;
	497 [label="Here I am, ready to launch into some twilight and wandering lecture on Orokin society, in thinking it might be vaguely of interest to you. And then I remind myself, You have very likely heard all this before, haven't you?",shape=box,color=blue];
		497 -> 505;
	499 [label="Would you prefer I simply played along? Or... is there some particular goal you are working toward by doing this? I am all rather baffled as to what you expect to gain by playing this cruel game.",shape=box,color=blue];
		499 -> 507;
	494 [label="Yes, so I have heard from the necraloid. Though it seems they have fewer since you or the child worked to resolve them. They are at least not tearing themselves apart - literally - any longer.",shape=box,color=blue];
		494 -> 504;
	493 [label="Yes, so I have heard from the necraloid. It seems they are still intent on tearing themselves apart.",shape=box,color=blue];
		493 -> 503;
	496 [label="Hm? Ah. The necraloid informed me, that you or the child stomped about helping them concoct false names for themselves, having forgotten their original ones. You know him as \"Vilcor.\" But I knew him as Petros Vorten. Proud inventor of the Necramech Fleet.",shape=box,color=blue];
		496 -> 504;
	495 [label="Hm? Ah. I knew him as Petros Vorten. Proud inventor of the Necramech Fleet. But the necraloid informed me they have forgotten their names. You might still know him only as \"Father.\"",shape=box,color=blue];
		495 -> 503;
	500 [label="No, I haven't heard this before. Please, go on.",shape=box,color=red];
		500 -> 508;
	501 [label="I'm talking to you, Roathe... because I want to be talking to you.",shape=box,color=red];
		501 -> 509;
	502 [label="I've heard this before, yes. But please tell it to me again anyway.",shape=box,color=red];
		502 -> 510;
	506 [label="Update boolean RoatheKnowsReset",color=orange];
		506 -> 500;
		506 -> 501;
		506 -> 502;
	505 [label="Update boolean RoatheKnowsReset",color=orange];
		505 -> 500;
		505 -> 501;
		505 -> 502;
	507 [label="Update boolean RoatheKnowsReset",color=orange];
		507 -> 515;
	504 [label="Evaluate expressions",color=orange];
		504 -> 514 [label="RoatheDeal",color=purple];
		504 -> 513 [label="RoatheNoDeal",color=purple];
		504 -> 513 [label="false",color=purple];
	503 [label="Evaluate expressions",color=orange];
		503 -> 512 [label="RoatheDeal",color=purple];
		503 -> 511 [label="RoatheNoDeal",color=purple];
		503 -> 511 [label="false",color=purple];
	508 [label="+5 Chemistry",color=orange];
		508 -> 516;
	509 [label="Check boolean DrifterRoathe",color=orange];
		509 -> 517 [label=true,color=green];
		509 -> 518 [label=false,color=brown];
	510 [label="So you admit you're wasting my time. How fantastic! I am not some grizzled, doddery old man, telling the singular war saga for he cannot recall any others.",shape=box,color=blue];
		510 -> 519;
	515 [label="Here I am, ready to launch into some twilight and wandering lecture on Orokin society, in thinking it might be vaguely of interest to you. And then I remind myself, You have very likely heard all this before, haven't you?",shape=box,color=blue];
		515 -> 500;
		515 -> 501;
		515 -> 502;
	514 [label="Which is good, as we would have made little progress without you or the child completing that step first. I fear the butler would have been bound for mincemeat the moment we sent him up those stairs otherwise.",shape=box,color=blue];
		514 -> 522;
	513 [label="Have you reconsidered my proposal, by the by? My sitting here quietly, in exchange for helping you reconcile the butler and the infested abandoned Orokin outcasts upstairs?",shape=box,color=blue];
		513 -> 520;
		513 -> 521;
	512 [label="Which you may wish to work on resolving first, before we make any attempts at sending the butler up those stairs. Lest he become mincemeat in the process.",shape=box,color=blue];
		512 -> 522;
	511 [label="Have you reconsidered my proposal, by the by? My sitting here quietly, in exchange for helping you reconcile the butler and the infested abandoned Orokin outcasts upstairs? Reconciling the family would be the first step, but...",shape=box,color=blue];
		511 -> 520;
		511 -> 521;
	516 [label="You have asked an Orokin to speak. You know not what you have done. You will be here for an hour if you are not careful.",shape=box,color=blue];
		516 -> 523;
	517 [label="+5 Chemistry",color=orange];
		517 -> 524;
	518 [label="Oh? And \"pray\" tell, why is that?",shape=box,color=blue];
		518 -> 528;
		518 -> 527;
		518 -> 525;
		518 -> 526;
	519 [label="The reason I cannot recall this conversation stands in your damnable mirror!",shape=box,color=blue];
		519 -> 529;
	522 [label="One thing you must understand is that the butler and the Entrati family are, however far removed, still Orokin. They were born and raised by that society, for all its... many faults.",shape=box,color=blue];
		522 -> 532;
	520 [label="No, I'm not changing my mind, Roathe. It's not that important.",shape=box,color=red];
		520 -> 530;
	521 [label="I have. I... agree.",shape=box,color=red];
		521 -> 531;
	523 [label="Though I suppose you may not have had much opportunity to interact with Orokin, have you, Drifter? The child lived a very different life.",shape=box,color=blue];
		523 -> 533;
	524 [label="Mm. That's right. And we both know why, don't we? But you are going to be patient.",shape=box,color=blue];
		524 -> 534;
	528 [label="[Confess feelings.] I think you know.",shape=box,color=red];
		528 -> 538;
	527 [label="I find you intriguing.",shape=box,color=red];
		527 -> 537;
	525 [label="I never had much opportunity to interact with an Orokin. When... I wasn't fighting them, that is. You're fascinating.",shape=box,color=red];
		525 -> 535;
	526 [label="Never mind. [End.]",shape=box,color=red];
		526 -> 536;
	529 [label="Chat ends.",color=orange];
	532 [label="And for all of its grievous sins, rank and order were never questioned. Not amongst the military - and not amongst the social structure. The Archimedeans obeyed the Orokin. The Orokin obeyed the Executors. The Executors obeyed the Emperors... well, at least in name.",shape=box,color=blue];
		532 -> 541;
	530 [label="Suit yourself. The door will not stay open for long.",shape=box,color=blue];
		530 -> 539;
	531 [label="Update boolean RoatheNoDeal",color=orange];
		531 -> 540;
	533 [label="From what I hear tell, you veered at the point of the Zariman Ten Zero's tragedy.",shape=box,color=blue];
		533 -> 542;
		533 -> 543;
		533 -> 544;
	534 [label="In the meanwhile, if you wish to \"listen,\" I am happy to oblige. Simply, fair warning. You have asked an Orokin to speak.",shape=box,color=blue];
		534 -> 545;
	538 [label="+5 Chemistry",color=orange];
		538 -> 549;
	537 [label="+5 Chemistry",color=orange];
		537 -> 548;
	535 [label="Know thy enemy, is it then? Or perhaps just curiosity to sit across the proverbial table from an impossibility? ",shape=box,color=blue];
		535 -> 546;
	536 [label="Wriggle all you want, fish. You swam to me.",shape=box,color=blue];
		536 -> 547;
	541 [label="And even if you do not believe that somehow, even after all this time, traditions might inspire Loid to listen to me? Consider the fact that I can be... deeply convincing. I was the right hand to the worst of the Executors, after all.",shape=box,color=blue];
		541 -> 551;
		541 -> 552;
		541 -> 553;
	539 [label="Chat ends.",color=orange];
	540 [label="Update boolean RoatheDeal",color=orange];
		540 -> 550;
	542 [label="No. I never much dealt with the Orokin before the Zariman - and after, well... you've heard the gist I'm sure.",shape=box,color=red];
		542 -> 554;
	543 [label="I've had enough dealings with Orokin to know not to trust them as far as I can throw them.",shape=box,color=red];
		543 -> 555;
	544 [label="I don't have any more love for your kind than the kid does, I'm sorry to say.",shape=box,color=red];
		544 -> 555;
	545 [label="You know not what you have done. You will be here for an hour if you are not careful.",shape=box,color=blue];
		545 -> 523;
	549 [label="Mm. I do. And here I thought you were going to do me the honors of letting me see it in writing. Ah, well...",shape=box,color=blue];
		549 -> 557;
	548 [label="Do you? Hm. We shall see how long I can keep this fish on the spear, then.",shape=box,color=blue];
		548 -> 534;
	546 [label="+5 Chemistry",color=orange];
		546 -> 556;
	547 [label="Chat ends.",color=orange];
	551 [label="The worst of the Executors was Ballas.",shape=box,color=red];
		551 -> 559;
	552 [label="Which one did you serve?",shape=box,color=red];
		552 -> 560;
	553 [label="How so?",shape=box,color=red];
		553 -> 561;
	550 [label="+5 Chemistry",color=orange];
		550 -> 558;
	554 [label="Indeed I have. Ah, Ballas. It may shock you to know he was not the worst of them.",shape=box,color=blue];
		554 -> 562;
		554 -> 563;
	555 [label="Nor do I suspect I blame you. I thought they could be salvaged. Melted down, of sorts - reformed, recast, like gold.",shape=box,color=blue];
		555 -> 564;
	557 [label="Another time, perhaps. As you, Usurper, must learn to savor these moments.",shape=box,color=blue];
		557 -> 566;
	556 [label="Respectable. Wise, even. Had I the opportunity to interview and, perhaps even befriend, a Sentient? I would have done the same. ",shape=box,color=blue];
		556 -> 565;
	559 [label="I respect your opinion, and I do not fault you for it. Ballas was a cretin and he was a champion amongst the depraved, I will not argue with you over that.",shape=box,color=blue];
		559 -> 567;
	560 [label="Evaluate expressions on HellStory",color=orange];
		560 -> 569 [label="x >= 1",color=purple];
		560 -> 568 [label="x <= 1",color=purple];
		560 -> 568 [label="false",color=purple];
	561 [label="I understand you have had personal dealings with Ballas, and I do not fault you for likely believing him to be the very worst the Seven Golden Lords had to offer up. And he was a champion amongst the depraved, I will not argue with you over that.",shape=box,color=blue];
		561 -> 570;
	558 [label="Wonderful! I am glad you finally have seen sense. Now we can finally make some progress.",shape=box,color=blue];
		558 -> 522;
	562 [label="Really?",shape=box,color=red];
		562 -> 571;
	563 [label="You'd have a hard time getting me to believe that.",shape=box,color=red];
		563 -> 571;
	564 [label="Well. Save the Executors. They were a lost cause. It may shock you to know Ballas was not the worst of them.",shape=box,color=blue];
		564 -> 563;
		564 -> 562;
	566 [label="Update boolean DrifterRoathe",color=orange];
		566 -> 534;
	565 [label="It provides a psychological benefit should you ever meet one - or even your former ally - upon the battlefield.",shape=box,color=blue];
		565 -> 572;
	567 [label="And, in fact, I did not witness the horror of this \"Narmer\" business that I have learned of from the butler and gleaned from the records on this POM-2 machine here.",shape=box,color=blue];
		567 -> 573;
	569 [label="You have heard me speak of her before. And, more importantly, a hint of what we were planning. But that is a story for another day. Executor Nitokh. Grand Regent Executor Nitokh, to be precise. Commander of all our military forces, and the most vicious and deadly of the Seven Golden Lords.",shape=box,color=blue];
		569 -> 574;
	568 [label="Executor Nitokh. Grand Regent Executor Nitokh, to be precise. The commander of all the military forces of the Orokin Empire. And the most vicious and deadly of the Seven Golden Lords.",shape=box,color=blue];
		568 -> 574;
	570 [label="It is even quite possible that he outpaced the Executors of old during this... \"Narmer\" business that I have heard about from the butler and read about on this POM-2 here.",shape=box,color=blue];
		570 -> 573;
	571 [label="I am not saying he was a saint. I am telling you the worst of the devils was just slightly outclassed by his peers. It is only the barest of hairs I split, Usurper.",shape=box,color=blue];
		571 -> 575;
	572 [label="Well, if you wish to \"listen,\" I am happy to oblige. Simply, fair warning. You have asked an Orokin to speak.",shape=box,color=blue];
		572 -> 545;
	573 [label="However, I also would suggest, that it is due to your very personal proximity to Ballas and very limited interactions with the other six Golden Lords that gives you this impression.",shape=box,color=blue];
		573 -> 574;
	574 [label="Golden Seven. Bah. Do you know what the best thing about gold is, Drifter? It can be endlessly melted down and repurposed into something better.",shape=box,color=blue];
		574 -> 576;
	575 [label="But was Ballas the worst? To you, perhaps. And, perhaps his crimes in this era outpaced the Executors of old.",shape=box,color=blue];
		575 -> 577;
	576 [label="I believed - and in a way, still do - that the Orokin were salvageable. That we could have turned the Empire around. But the Executors? No. They had to be stopped. They were all the worst that humanity had to offer, by a matter of degrees.",shape=box,color=blue];
		576 -> 578;
	577 [label="But if you had gazed upon the lakes of crimson and fields of bent and fragmented corpses, like so many discarded children's toys -",shape=box,color=blue];
		577 -> 579;
	578 [label="And this is coming from me, Usurper. So allow me, this Devil of Tau himself, to assure you - as a connoisseur myself, that Ballas was not the worst amongst them.",shape=box,color=blue];
		578 -> 580;
	579 [label="If you had seen the pure devastation Nitokh could wreak with barely even a moment's thought... ",shape=box,color=blue];
		579 -> 581;
	580 [label="Check boolean RoatheUsurper",color=orange];
		580 -> 583 [label=true,color=green];
		580 -> 584 [label=true,color=green];
		580 -> 582 [label=false,color=brown];
		580 -> 583 [label=false,color=brown];
		580 -> 584 [label=false,color=brown];
	581 [label="But such horrors are hard to feel unless they are witnessed. Such tragedy is not understood in numbers. I could go on at length about what I have seen, but to you, they will be simply that - stories.",shape=box,color=blue];
		581 -> 585;
	583 [label="You'd have a hard time getting me to believe that.",shape=box,color=red];
		583 -> 587;
	584 [label="Really?",shape=box,color=red];
		584 -> 587;
	582 [label="Why do you keep calling me \"Usurper?\"",shape=box,color=red];
		582 -> 586;
	585 [label="To you, Ballas shall always be the far more present and horrifying malefactor. And such is to be expected.",shape=box,color=blue];
		585 -> 588;
	587 [label="If you had gazed upon the lakes of crimson and fields of bent and fragmented corpses, like so many discarded children's toys -",shape=box,color=blue];
		587 -> 579;
	586 [label="Ah! That is what you are, yes? The Tenno usurped the Origin System from the Orokin. And you, like a little imposter in the nest, have stolen into this world from your own.",shape=box,color=blue];
		586 -> 589;
	588 [label="But there is much to him you do not know. There is already too much that has been said about that cretin. And more that is needing to be said, I fear.",shape=box,color=blue];
		588 -> 590;
		588 -> 591;
	589 [label="And that makes you, on at least two counts, a Usurper by my measure. (And perhaps a third, if we count what the butler has told me of Duviri, but that is a debate for another time.)",shape=box,color=blue];
		589 -> 592;
	590 [label="Like what?",shape=box,color=red];
		590 -> 593;
	591 [label="I'm not interested in hearing anything about Ballas' life.",shape=box,color=red];
		591 -> 594;
	592 [label="Don't distract me, Usurper. I understand you may have a hard time believing me, but if you had gazed upon the lakes of crimson and fields of bent and fragmented corpses, like so many discarded children's toys -",shape=box,color=blue];
		592 -> 595;
	593 [label="Update boolean RoatheBallas1",color=orange];
		593 -> 596;
	594 [label="Mm, yes. Well, I suppose you will just have to sit through stories of my life, instead. How droll.",shape=box,color=blue];
		594 -> 597;
	595 [label="Update boolean RoatheUsurper",color=orange];
		595 -> 579;
	596 [label="It is a... very long story. One that I do not have time for at the moment. The butler is looming. And I despise being loomed over.",shape=box,color=blue];
		596 -> 598;
	597 [label="+5 Chemistry",color=orange];
		597 -> 599;
	598 [label="Terribly rude.",shape=box,color=blue];
		598 -> 600;
	599 [label="We shall speak again soon.",shape=box,color=blue];
		599 -> 601;
	600 [label="+15 Chemistry",color=orange];
		600 -> 602;
	601 [label="Chat ends.",color=orange];
	602 [label="We shall speak again soon.",shape=box,color=blue];
		602 -> 603;
	603 [label="Chat ends.",color=orange];
}