digraph {
	"RoatheRank2Convo5 begins." [color=orange];
		"RoatheRank2Convo5 begins." -> j2554321341;
	j2554321341 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		j2554321341 -> j364889355 [label=true,color=green];
		j2554321341 -> "Chat ends." [label=false,color=brown];
	j364889355 [label="Check boolean RoatheKnowsReset2",color=orange];
		j364889355 -> j1565036975 [label=true,color=green];
		j364889355 -> j1918363296 [label=false,color=brown];
	"Chat ends." [color=orange];
	j1565036975 [label="How much did Past Roathe tell you of his dealings with Executor Nitokh? Bah. Attempting to reconcile all this: that the former me trusted you with such personal information... only to have you strike it clean from my mind?",shape=box,color=blue];
		j1565036975 -> j2947614401;
	j1918363296 [label="Evaluate expressions on HellStory counter",color=orange];
		j1918363296 -> j743904900 [label="x >= 1",color=purple];
		j1918363296 -> "Chat ends." [label="x <= 1",color=purple];
		j1918363296 -> "Chat ends." [label="false",color=purple];
	j2947614401 [label="It burns a hole in me. That I could have told you everything, all of it - laid it all bare, down to the deepest part of me, and you... wiped it all clean again. Like I was nothing more than a little plaything to you.",shape=box,color=blue];
		j2947614401 -> j166432174;
	j743904900 [label="You have heard me mention Executor Nitokh before. And my... dealings with her. You must try to understand that the Orokin Empire was not entirely evil.",shape=box,color=blue];
		j743904900 -> j178700857;
	j166432174 [label="I suppose it is only fair. That is how we Orokin treated humanity, isn't it? The Yuvan Theatre? Parading beautiful flesh around and choosing our new selves at will, torturing each other with games for sick amusement as we saw fit...",shape=box,color=blue];
		j166432174 -> j4019354307;
	j178700857 [label="It breaks my heart that its devastation and depravity is all that it shall be remembered for. Yes, there was plenty of it, I am not arguing that. ",shape=box,color=blue];
		j178700857 -> j1168943134;
	j4019354307 [label="I hate it. I hate it so very, very much.",shape=box,color=blue];
		j4019354307 -> j2115252958;
		j4019354307 -> j4161966153;
		j4019354307 -> j242691715;
	j1168943134 [label="But it was also capable of such beauty. Such joy. Such love. Such scientific and artistic advancements. Look at what we were capable of achieving! ",shape=box,color=blue];
		j1168943134 -> j2752740063;
	j2115252958 [label="While I didn't intend to hurt you like this, and I'm sorry that I did, if this taught you what it was like to be on the other side of the Orokin Empire, that's a valuable lesson.",shape=box,color=red];
		j2115252958 -> j1961283618;
	j4161966153 [label="I never intended for this to hurt you the way that it is. You shouldn't have to apologize for the way that the Orokin society operated - you didn't build it. You were trying to salvage it.",shape=box,color=red];
		j4161966153 -> j1225025460;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j2752740063 [label="So when Nitokh summoned me to her side and told me she wished to murder all the Orokin? I immediately agreed. I wished to cut off the head of the poisoned serpent. I wished to replace it with a more benign system. A more benign ruler.",shape=box,color=blue];
		j2752740063 -> j427337321;
		j2752740063 -> j823047569;
		j2752740063 -> j242691715;
	j1961283618 [label="Add 3 to Thermostat counter",color=orange];
		j1961283618 -> j554119238;
	j1225025460 [label="Add -3 to Thermostat counter",color=orange];
		j1225025460 -> j1854620264;
	j427337321 [label="You wanted to replace the Emperors and the Executors with yourself, you mean.",shape=box,color=red];
		j427337321 -> j2575197476;
	j823047569 [label="And who would that ruler be?",shape=box,color=red];
		j823047569 -> j1994099140;
	j554119238 [label="The Orokin Empire was not entirely evil. It breaks my heart that its devastation and depravity is all that it shall be remembered for. Yes, there was plenty of it, I am not arguing that.",shape=box,color=blue];
		j554119238 -> j2195334352;
	j1854620264 [label="If only the others could have seen it that way. If only Nitokh had seen it that way. ",shape=box,color=blue];
		j1854620264 -> j554119238;
	j2575197476 [label="Why yes, of course!",shape=box,color=blue];
		j2575197476 -> j3186305408;
	j1994099140 [label="Myself, of course.",shape=box,color=blue];
		j1994099140 -> j3186305408;
	j2195334352 [label="But it was also capable of such beauty. Such joy. Such love. Such scientific and artistic advancements. Look at what we were capable of achieving! ",shape=box,color=blue];
		j2195334352 -> j1240697056;
	j3186305408 [label="I would ensure that all the Executors and the Emperors would be... removed, and I would take over as Interim Executor until a new system could be put into place.",shape=box,color=blue];
		j3186305408 -> j2456867675;
	j1240697056 [label="So when Nitokh summoned me to her side and told me she wished to murder all the Orokin? I immediately agreed. I wished to cut off the head of the poisoned serpent. I wished to replace it with a more benign system. A more benign ruler.",shape=box,color=blue];
		j1240697056 -> j1459270895;
		j1240697056 -> j3064650744;
	j2456867675 [label="However long that would take, I do not know, but it would be better than what followed in the wake of the Great War, wouldn't it?",shape=box,color=blue];
		j2456867675 -> j2020769142;
		j2456867675 -> j2047130225;
		j2456867675 -> j3061882874;
	j1459270895 [label="You wanted to replace the Emperors and the Executors with yourself, you mean.",shape=box,color=red];
		j1459270895 -> j3231647026;
	j3064650744 [label="And who would that ruler be?",shape=box,color=red];
		j3064650744 -> j4253707756;
	j2020769142 [label="Great War?",shape=box,color=red];
		j2020769142 -> j2890126418;
	j2047130225 [label="Be honest with yourself, do you think you ever would have given up power?",shape=box,color=red];
		j2047130225 -> j1182966174;
	j3061882874 [label="I don't think you ever would have given up power, Roathe.",shape=box,color=red];
		j3061882874 -> j2859770647;
	j3231647026 [label="Why yes, of course! And don't pretend as though you haven't heard this before, I am certain you have. ",shape=box,color=blue];
		j3231647026 -> j1029057216;
	j4253707756 [label="Myself, of course. And don't pretend as though you haven't heard this before, I am certain you have.",shape=box,color=blue];
		j4253707756 -> j1029057216;
	j2890126418 [label="You call it the \"Old War\" now. It is hardly \"Old\" to me, it only happened a few years ago in my recollection of events.",shape=box,color=blue];
		j2890126418 -> j2577076411;
	j1182966174 [label="Mm. I do not know. It hardly matters anymore, does it? But at the time, I was fully convinced I would.",shape=box,color=blue];
		j1182966174 -> j1902586491;
	j2859770647 [label="+5 Chemistry",color=orange];
		j2859770647 -> j142801992;
	j1029057216 [label="I would ensure that all the Executors and the Emperors would be... removed, and I would take over as Interim Executor until a new system could be put into place.",shape=box,color=blue];
		j1029057216 -> j1037652279;
	j2577076411 [label="Time travel is funny like that.",shape=box,color=blue];
		j2577076411 -> j76561969;
	j1902586491 [label="I strove so hard to travel back here only to realize that... my people are now dead.I would have been executed with the rest of them.",shape=box,color=blue];
		j1902586491 -> j1359612390;
	j142801992 [label="Quiet, you.",shape=box,color=blue];
		j142801992 -> j3314028059;
	j1037652279 [label="However long that would take, I do not know, but it would be better than what followed in the wake of the Great War, wouldn't it?",shape=box,color=blue];
		j1037652279 -> j2047130225;
		j1037652279 -> j3061882874;
		j1037652279 -> j2020769142;
	j76561969 [label="In just a few short years from my perception, thousands have passed in \"reality\" - where the Empire has fallen and my people have all died. ",shape=box,color=blue];
		j76561969 -> j2493430059;
	j1359612390 [label="The Tenno would have slaughtered me with all the rest on the night of the Naga Drums. I would have likely died, attempting to save Nitokh's life.",shape=box,color=blue];
		j1359612390 -> j1839712721;
	j3314028059 [label="At the time, I was fully convinced I would. But now, it hardly matters, does it?",shape=box,color=blue];
		j3314028059 -> j1902586491;
	j2493430059 [label="I have come to realize that it does not matter if I would have surrendered power or not, though in the time I was convinced I would.",shape=box,color=blue];
		j2493430059 -> j1359612390;
	j1839712721 [label="I wonder what became of her? The records do not even mention her name... all the horrors committed in her name, all the deaths, all the travesties... and I may be the only one who knows of them.",shape=box,color=blue];
		j1839712721 -> j1480076101;
	j1480076101 [label="Well. That and whatever might be unlocked in the future from the Tenno's head via that Dark Refractory. But that is hardly my problem to solve.",shape=box,color=blue];
		j1480076101 -> j3882664650;
		j1480076101 -> j2062218468;
		j1480076101 -> j2919077643;
	j3882664650 [label="You seem a little intimidated by the kid.",shape=box,color=red];
		j3882664650 -> j801743827;
	j2062218468 [label="What happened between you and Nitokh?",shape=box,color=red];
		j2062218468 -> j2679491934;
	j2919077643 [label="So you were planning to betray the Orokin?",shape=box,color=red];
		j2919077643 -> j3637649753;
	j801743827 [label="I watched a gaggle of school-aged, Void-ravaged children remotely pilot Infested machines of war, that had once been soldiers, that were now remade into grotesque, beautiful, and murderous works of art, destroy entire battalions of soldiers. ",shape=box,color=blue];
		j801743827 -> j2617801791;
	j2679491934 [label="Everything.",shape=box,color=blue];
		j2679491934 -> j1497798001;
	j3637649753 [label="Yes. We both were. Although I believe NItokh was planning to betray me, and I was also planning on betraying Nitokh. You know how it is with us Orokin.",shape=box,color=blue];
		j3637649753 -> j203683265;
	j2617801791 [label="I have come to discover that they destroyed my Empire. An Empire that ruled the entire Origin System. And was about to wipe out the rebellion on Tau.",shape=box,color=blue];
		j2617801791 -> j1104843815;
	j1497798001 [label="Everything happened between Nitokh and I.",shape=box,color=blue];
		j1497798001 -> j531964218;
	j203683265 [label="Everyone always scheming against everyone else. Just another day of the week, really.",shape=box,color=blue];
		j203683265 -> j2832841815;
	j1104843815 [label="And they did it in a night.",shape=box,color=blue];
		j1104843815 -> j3794113586;
	j531964218 [label="Everything and more.",shape=box,color=blue];
		j531964218 -> j1763036852;
	j2832841815 [label="Betrayals between one Orokin and another were quite common. But to betray the whole of the Empire? That manner of treason was worthy of not only execution by Jade Light, but the Cephalon Program.",shape=box,color=blue];
		j2832841815 -> j1500183088;
	j3794113586 [label="Wouldn't you be?!",shape=box,color=blue];
		j3794113586 -> j2590735251;
	j1763036852 [label="And that is all I wish to say on that subject at the moment.",shape=box,color=blue];
		j1763036852 -> j3080070763;
	j1500183088 [label="Boolean RoatheTraitor1 is now true.",color=orange];
		j1500183088 -> j3868794324;
		j1500183088 -> j707864206;
	j2590735251 [label="I cannot express what we were risking by attempting to murder the Executors - let alone all the Orokin, Usurper.",shape=box,color=blue];
		j2590735251 -> j2832841815;
	j3080070763 [label="Boolean RoatheExecutor1 is now true.",color=orange];
		j3080070763 -> j2590735251;
	j3868794324 [label="Which one did you view as being worse than the other?",shape=box,color=red];
		j3868794324 -> j2950838530;
	j707864206 [label="So that kind of scheme wasn't normal?",shape=box,color=red];
		j707864206 -> j905405335;
	j2950838530 [label="Nihil's Cephalon Program, by far. The Glassmaker's creations are...",shape=box,color=blue];
		j2950838530 -> j560955888;
	j905405335 [label="The Orokin Empire's existence balanced on the blade of a dagger, Usurper. It hummed on the very brink of destruction at all times. Only one thing kept it operational:",shape=box,color=blue];
		j905405335 -> j2144778012;
	j560955888 [label="The Jade Light is quick to those without the armor or shields to survive a single blast. It is a merciful death.",shape=box,color=blue];
		j560955888 -> j2326133526;
	j2144778012 [label="Societal norms.",shape=box,color=blue];
		j2144778012 -> j2696576787;
	j2326133526 [label="Cephalons, when converted from a willing subject, can be painless, and even performed non-destructively. However... when used punitively?",shape=box,color=blue];
		j2326133526 -> j247116365;
	j2696576787 [label="One simply did not rise up and murder the Orokin! It was just not done, Drifter! Unthinkable! Positively gauche!",shape=box,color=blue];
		j2696576787 -> j1539237664;
	j247116365 [label="Memories are sacred to the Orokin, Drifter. They are all we are, in the end. Our bodies are temporary. Our faces, our voices, our blood, all mutable. All can be changed like fashion.",shape=box,color=blue];
		j247116365 -> j4186474857;
	j1539237664 [label="Which also made it comically easy to do, in the end. As I'm sure your Tenno duplicate learned. ",shape=box,color=blue];
		j1539237664 -> j277846951;
		j1539237664 -> j3156801434;
	j4186474857 [label="Check boolean RoatheKnowsReset2",color=orange];
		j4186474857 -> j3988082569 [label=true,color=green];
		j4186474857 -> j277846951 [label=false,color=brown];
		j4186474857 -> j3156801434 [label=false,color=brown];
	j277846951 [label="But you clearly never got far enough to make your attempt.",shape=box,color=red];
		j277846951 -> j2745098065;
	j3156801434 [label="What happened to your plan?",shape=box,color=red];
		j3156801434 -> j652053828;
	j3988082569 [label="Which may likely be, by the by, why I am so deeply and utterly irritated with you for meddling with them. ",shape=box,color=blue];
		j3988082569 -> j277846951;
		j3988082569 -> j3156801434;
	j2745098065 [label="Evaluate expressions on HellStory counter",color=orange];
		j2745098065 -> j3620647039 [label="x >= 21",color=purple];
		j2745098065 -> j3353987787 [label="x < 21",color=purple];
		j2745098065 -> j3353987787 [label="false",color=purple];
	j652053828 [label="Evaluate expressions on HellStory counter",color=orange];
		j652053828 -> j1195574461 [label="x >= 21",color=purple];
		j652053828 -> j3349815363 [label="x < 21",color=purple];
		j652053828 -> j3349815363 [label="false",color=purple];
	j3620647039 [label="You are correct, quite obviously! Albrecht met me in that hallway before Nitokh and I had the time to spring our trap for the Executors.",shape=box,color=blue];
		j3620647039 -> j3998724845;
	j3353987787 [label="No, clearly not. I was forcibly turned into this... thing by Albrecht before Nitokh and I had time to spring our trap for the Executors.",shape=box,color=blue];
		j3353987787 -> j2895065538;
	j1195574461 [label="You know quite well what happened to our plan, don't you?! Albrecht met me in that hallway before Nitokh and I had the time to spring our trap for the Executors.",shape=box,color=blue];
		j1195574461 -> j2440163623;
	j3349815363 [label="I was forcibly turned into this... thing by Albrecht before Nitokh and I had time to spring our trap for the Executors.",shape=box,color=blue];
		j3349815363 -> j2895065538;
	j3998724845 [label="And offered me the protoframe serum. And... well... we both know what happened next.",shape=box,color=blue];
		j3998724845 -> j1547039671;
	j2895065538 [label="One moment, I remember standing in a great golden hallway, the next, screaming in agony in some backwater hellhole in \"Gaule.\"",shape=box,color=blue];
		j2895065538 -> j3778035266;
	j2440163623 [label="He offered me the protoframe serum, and we both know what happened next!",shape=box,color=blue];
		j2440163623 -> j1547039671;
	j1547039671 [label="A matter which I still am. Furious. Over. I. Why?! Why did I confess this to you?! Why do you know this?! ",shape=box,color=blue];
		j1547039671 -> j3182560444;
	j3778035266 [label="Nitokh must have abandoned the plan once I went missing. Likely, she pinned the whole treasonous affair on me as a convenient scapegoat.",shape=box,color=blue];
		j3778035266 -> j1356448404;
	j3182560444 [label="Bah! No. Never mind. I am going now, before I break this damnable computer in a fit of rage.",shape=box,color=blue];
		j3182560444 -> j1933300832;
	j1356448404 [label="It explains all the records I am finding in the records calling me a \"coward.\" Of course they would think me a coward - they think I ran! Pah.",shape=box,color=blue];
		j1356448404 -> j2905413282;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j2905413282 [label="+10 Chemistry",color=orange];
		j2905413282 -> j3493213190;
	j3493213190 [label="It is nice to know that I was so very crucial to the plan, however, that it had to be scuttled entirely once I was gone.",shape=box,color=blue];
		j3493213190 -> j313951505;
		j3493213190 -> j616560061;
	j313951505 [label="I'm not sure if that's what you should be taking away from this.",shape=box,color=red];
		j313951505 -> j4174984631;
	j616560061 [label="It is nice to feel needed.",shape=box,color=red];
		j616560061 -> j3707593238;
	j4174984631 [label="Add 1 to Thermostat counter",color=orange];
		j4174984631 -> j3197448215;
	j3707593238 [label="+5 Chemistry",color=orange];
		j3707593238 -> j1048087104;
	j3197448215 [label="You find your worth where you like, Drifter, and let me find mine.",shape=box,color=blue];
		j3197448215 -> "Chat ends.";
	j1048087104 [label="Add -1 to Thermostat counter",color=orange];
		j1048087104 -> j2463063059;
	j2463063059 [label="You see? You understand.",shape=box,color=blue];
		j2463063059 -> "Chat ends.";
}