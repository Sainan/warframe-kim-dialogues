	2218 [label="Transcript: It was Scarne, testy, cerebral and acerbic, who had first mooted the Plan back in the days before the War. \"We must fly the nest, for the nest is on fire.\"",shape=box,color=blue];
		2218 -> 2221;
	2221 [label="Through over-exploitation and reckless experiment, we had fouled the System beyond hope of regeneration.",shape=box,color=blue];
		2221 -> 2216;
	2216 [label="Expansion to new horizons was our only option now. ",shape=box,color=blue];
		2216 -> 5733;
	5733 [label="He, too, inaugurated the cowardly Towers in the Void.",shape=box,color=blue];
		5733 -> 2222;
	2222 [label="The dread of a Sentient return was so strong in him that he could only imagine retreat to islands within the Void-sea.",shape=box,color=blue];
		2222 -> 5700;
	5700 [label="How little credit we gave the Sentients for courage.",shape=box,color=blue];
		5700 -> 5701;
	5701 [label="They willingly endured the Void’s scalding fire purely for the chance to punish us.",shape=box,color=blue];
