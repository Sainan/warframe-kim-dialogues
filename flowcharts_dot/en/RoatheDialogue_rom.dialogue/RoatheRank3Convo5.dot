digraph {
	"RoatheRank3Convo5 begins." [color=orange];
		"RoatheRank3Convo5 begins." -> j1585641692;
	j1585641692 [label="Albrecht was always a problem from the very beginning. Him and all this business with the Void. I think he was given Gerivaine in hopes having a family might simply settle him down.",shape=box,color=blue];
		j1585641692 -> j2679847908;
	j2679847908 [label="I think instead it simply made things worse. Once he had children he viewed them as an extra set of hands. Accomplices in his mad experiments.",shape=box,color=blue];
		j2679847908 -> j1930812330;
	j1930812330 [label="Expendable. Like all things in his life.",shape=box,color=blue];
		j1930812330 -> j2053997657;
		j1930812330 -> j3320662824;
		j1930812330 -> j242691715;
	j2053997657 [label="Gerivaine?",shape=box,color=red];
		j2053997657 -> j1684657508;
	j3320662824 [label="He views people as more than simply expendable.",shape=box,color=red];
		j3320662824 -> j1091972846;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j1684657508 [label="A name that may have been lost to the annals of time... Albrecht Entrati's wife, Usurper. The mother of his children.",shape=box,color=blue];
		j1684657508 -> j4103666644;
	j1091972846 [label="Very well, I will concede that he will murder anyone and anything in his life with the coldness of any Executor. But he will not do it without purpose.",shape=box,color=blue];
		j1091972846 -> j1323840577;
	"Chat ends." [color=orange];
	j4103666644 [label="Check boolean LoidFamilyComplete",color=orange];
		j4103666644 -> j3384446970 [label=true,color=green];
		j4103666644 -> j4261324905 [label=false,color=brown];
	j1323840577 [label="You know, now that I reflect on it, it was his dispassionate nature that made him so deeply dangerous in our time. He was capable of sacrificing anything in the name of seeing his goals met. Anything at all.",shape=box,color=blue];
		j1323840577 -> j3721113300;
		j1323840577 -> j3198823055;
	j3384446970 [label="But there you go, likely playing me for the fool again - as odds are quite high that you already knew this information, now that the butler is reconnected with them.",shape=box,color=blue];
		j3384446970 -> j2773654691;
	j4261324905 [label="The ones who sit so blissfully unawares of our existence down in this moldering Sanctum. Which I still find so utterly priceless.",shape=box,color=blue];
		j4261324905 -> j1323840577;
	j3721113300 [label="I figured the Orokin wouldn't have a problem with sacrificing things they cared about. You all seemed extremely cutthroat with each other.",shape=box,color=red];
		j3721113300 -> j2980482733;
	j3198823055 [label="How do you figure?",shape=box,color=red];
		j3198823055 -> j1989678016;
	j2773654691 [label="But I will not get into yet another argument about this with you. I am not in the mood.",shape=box,color=blue];
		j2773654691 -> j1323840577;
	j2980482733 [label="You are very eager to assume much about which you know nothing, Drifter.",shape=box,color=blue];
		j2980482733 -> j231141674;
	j1989678016 [label="+10 Chemistry",color=orange];
		j1989678016 -> j610466227;
	j231141674 [label="Or does your skin have a blue twinge that I missed? Were you an Orokin? If so, I extend my deepest and most sincere apologies! ",shape=box,color=blue];
		j231141674 -> j4163448075;
		j231141674 -> j2252754360;
	j610466227 [label="It might be a common misconception that all we Orokin did was backstab and murder each other. There was plenty of that, don't misunderstand me. We were nigh immortal, we had little else to do.",shape=box,color=blue];
		j610466227 -> j322388265;
	j4163448075 [label="I'm sorry. I didn't mean to offend you. I honestly don't remember much of Orokin society myself - I was on the outside of it, looking in.",shape=box,color=red];
		j4163448075 -> j1182216981;
	j2252754360 [label="Sorry if what I remember of Orokin society wasn't great. Mostly recorded statements barking orders at me out of speaker systems. That was before I was trapped in the Void...",shape=box,color=red];
		j2252754360 -> j1256863929;
	j322388265 [label="But we were also a deeply passionate people. No one made art in the way that the Orokin did. No one composed music, or theatre, or poetry, the likes that we composed.",shape=box,color=blue];
		j322388265 -> j3500666119;
	j1182216981 [label="Apology accepted. This time. I deal with this kind of disrespect enough from everyone else around here. As fascinating as you are, I am not everyone's pincushion. I have better ways to spend my time.",shape=box,color=blue];
		j1182216981 -> j3664216424;
	j1256863929 [label="Boolean RoatheInsulted is now true.",color=orange];
		j1256863929 -> j3432143901;
	j3500666119 [label="And no one loved as deeply as we did, when our hearts fell for another.",shape=box,color=blue];
		j3500666119 -> j3483163398;
	j3664216424 [label="Where was I? Ah yes. Our impassive Entrati.",shape=box,color=blue];
		j3664216424 -> j610466227;
	j3432143901 [label="A warning. I deal with this kind of disrespect enough from everyone else around here. As fascinating as you are, I am not everyone's pincushion. I have better ways to spend my time.",shape=box,color=blue];
		j3432143901 -> j3664216424;
	j3483163398 [label="All save Albrecht. Everything he did, everyone he interacted with, it was as though he viewed it through a section of his beloved seriglass.",shape=box,color=blue];
		j3483163398 -> j867342809;
	j867342809 [label="Removed. Detached. Uninterested. Unimpacted. Even when Gerivaine died and he was left to raise his little welp of a daughter on his own.",shape=box,color=blue];
		j867342809 -> j1969269467;
	j1969269467 [label="Check boolean LoidFamilyComplete",color=orange];
		j1969269467 -> j2596465127 [label=true,color=green];
		j1969269467 -> j1927249426 [label=false,color=brown];
	j2596465127 [label="Who, by rights, was likely destined to accomplish more than he ever did. If she didn't wind up infested and rooted to the spot. What a waste.",shape=box,color=blue];
		j2596465127 -> j2621352186;
		j2596465127 -> j992323987;
	j1927249426 [label="Who, by rights, was likely destined to accomplish more than he ever did. I cannot wait to see what's become of her and the rest of the Entrati ilk. In all their... Infested glory.",shape=box,color=blue];
		j1927249426 -> j267421235;
		j1927249426 -> j4169122591;
	j2621352186 [label="I am glad we managed to convince Loid to go upstairs.",shape=box,color=red];
		j2621352186 -> j2568806650;
	j992323987 [label="I know you can't remember why we did it, but it was a good thing that we managed to get Loid upstairs.",shape=box,color=red];
		j992323987 -> j419531284;
	j267421235 [label="I still wonder if this is the best idea...",shape=box,color=red];
		j267421235 -> j3561928311;
	j4169122591 [label="If we manage to convince Loid to go upstairs, what do you plan on doing then?",shape=box,color=red];
		j4169122591 -> j1847978574;
	j2568806650 [label="So you say. And yet I stand there like a fool, guarding them, listening to them talk on the subject of the reunion as though I remember it happening. Do you know how awkward that is?!",shape=box,color=blue];
		j2568806650 -> j326978084;
	j419531284 [label="Do you know how awkward it is, having to stand there and pretend that I remember the reunion happening?! When I cannot for the life of me recall it?!",shape=box,color=blue];
		j419531284 -> j326978084;
	j3561928311 [label="Mm, very likely not. I was curious, do you happen to have Albrecht's forwarding address?",shape=box,color=blue];
		j3561928311 -> j1611281667;
	j1847978574 [label="I have not yet decided. Perhaps I will start lopping off their limbs and preserving them in liquid. You wouldn't happen to have Albrecht's forwarding address, would you?",shape=box,color=blue];
		j1847978574 -> j2523796596;
	j326978084 [label="It is like standing at a gala when someone comes up to you and clearly knows who you are, yet you have no recollection of them in the slightest, but are forced to continue the conversation as if you do!",shape=box,color=blue];
		j326978084 -> j2000285668;
	j1611281667 [label="No, why?",shape=box,color=red];
		j1611281667 -> j1918054945;
	j2523796596 [label="What?!",shape=box,color=red];
		j2523796596 -> j3262579835;
	j2000285668 [label="Do you have even the slightest recognition of the kind of hell you have placed me in?! Any at all?! It is misery standing up there like that, and it is all your fault! ",shape=box,color=blue];
		j2000285668 -> j2359969744;
	j1918054945 [label="I was thinking once I was upstairs, I would start lopping off his family's limbs and start mailing them to him in jars, one at a time.",shape=box,color=blue];
		j1918054945 -> j2523796596;
	j3262579835 [label="+10 Chemistry",color=orange];
		j3262579835 -> j3920610729;
	j2359969744 [label="Bah, enough of this. I need a drink.",shape=box,color=blue];
		j2359969744 -> j1933300832;
	j3920610729 [label="Calm yourself! Can no one around here take a joke?",shape=box,color=blue];
		j3920610729 -> j803506365;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j803506365 [label="Who would mail them for me, at any rate?",shape=box,color=blue];
		j803506365 -> "Chat ends.";
}