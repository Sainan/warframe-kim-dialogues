	2370 [label="Check boolean RoatheKnowsReset2",color=orange];
		2370 -> 2375 [label=true,color=green];
		2370 -> 2376 [label=false,color=brown];
	2372 [label="And that makes you, on at least two counts, a Usurper by my measure. (And perhaps a third, if we count what the butler has told me of Duviri, but that is a debate for another time.)",shape=box,color=blue];
		2372 -> 2377;
