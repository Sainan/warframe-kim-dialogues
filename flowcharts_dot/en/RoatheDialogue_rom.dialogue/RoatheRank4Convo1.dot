	2361 [label="Update boolean RoatheUsurper",color=orange];
		2361 -> 2367;
	2362 [label="I'm just saying that it's kind of rich coming from you as an insult, when you're guilty of the same thing.",shape=box,color=red];
		2362 -> 2368;
	2363 [label="I'm just trying to figure out why you keep using it as a title for me.",shape=box,color=red];
		2363 -> 2369;
	2366 [label="[End.]",shape=box,color=red];
		2366 -> 2371;
	2364 [label="Ha! Hardly! You are extremely patient if you think I have been so casually insulting you to your face for days, now. ",shape=box,color=blue];
		2364 -> 2370;
	2365 [label="Chat ends.",color=orange];
	2367 [label="Well, that is what you are, yes? The Tenno usurped the Origin System from the Orokin. And you, like a little imposter in the nest, have stolen into this world from your own.",shape=box,color=blue];
		2367 -> 2372;
