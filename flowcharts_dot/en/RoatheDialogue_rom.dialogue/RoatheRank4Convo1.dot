	2394 [label="Update boolean RoatheTraitor1",color=orange];
		2394 -> 2381;
	2395 [label="Ha! I could almost hear the sigh from the Sanctum. Were they all like me? No. They were vastly inferior. And far more infuriating, I am afraid.",shape=box,color=blue];
		2395 -> 2399;
	2396 [label="Hm... no. But I do appreciate the show of proper etiquette. You must earn your titles from me, Usurper. You know that.",shape=box,color=blue];
