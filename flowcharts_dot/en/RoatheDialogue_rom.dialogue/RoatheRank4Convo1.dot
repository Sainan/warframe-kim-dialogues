	2373 [label="Check boolean RoatheKnowsReset2",color=orange];
		2373 -> 2380 [label=true,color=green];
		2373 -> 2379 [label=false,color=brown];
	2374 [label="Because it is exactly that - a title. An honorific. You have accomplished that which I aspired to. ",shape=box,color=blue];
		2374 -> 2381;
	2375 [label="Particularly when it is so painfully clear you have so much power in this situation that is hardly unilateral, hm?",shape=box,color=blue];
		2375 -> 2382;
	2376 [label="Particularly when I know you could simply use your Void-given powers to step through a wall and put a few bullets into the back of my head anytime you wished.",shape=box,color=blue];
		2376 -> 2382;
	2377 [label="So... you're insulting me.",shape=box,color=red];
		2377 -> 2368;
	2378 [label="Okay. So why keep using that as a title?",shape=box,color=red];
		2378 -> 2383;
	2380 [label="Particularly when it is so painfully clear you have so much power in this situation that is hardly unilateral, hm?",shape=box,color=blue];
		2380 -> 2384;
	2379 [label="Particularly when I know you could simply use your Void-given powers to step through a wall and put a few bullets into the back of my head anytime you wished.",shape=box,color=blue];
		2379 -> 2384;
	2381 [label="The title is merely expression of my mild admiration. Even if it is one that is suitably sarcastic to suit my needs, yes, I will give you that.",shape=box,color=blue];
		2381 -> 2385;
		2381 -> 2386;
		2381 -> 2387;
		2381 -> 2388;
	2382 [label="I am not in the mood to make an enemy of you, Usurper. No. It is not an insult. It is only through your own lack of due diligence that you have not come to realize the large portion of my past that aligns with yours.",shape=box,color=blue];
		2382 -> 2389;
	2383 [label="+5 Chemistry",color=orange];
		2383 -> 2374;
	2384 [label="I am not in the mood to make an enemy of you, Usurper. No. If anything, it is an honorific. You have done that which I aspired to. Nothing more.",shape=box,color=blue];
		2384 -> 2381;
	2385 [label="Were all Orokin like you?",shape=box,color=red];
		2385 -> 2390;
	2386 [label="If I asked you nicely to call me something else, would you?",shape=box,color=red];
