		82 -> 88;
	83 [label="What do you need me to do?",shape=box,color=red];
		83 -> 89;
	90 [label="Try not to make this too unduly uncomfortable for me and I will promise that I shall try to do the same in return.",shape=box,color=blue];
		90 -> 97;
		90 -> 98;
	91 [label="Well. If what you say is true - and I suppose this tale is mad enough to be reality - I will attempt not to hold it against you that you know this deep and terrible truth of mine.",shape=box,color=blue];
