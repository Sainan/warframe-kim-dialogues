		37 -> 43 [label="x <= 0",color=purple];
		37 -> 43 [label="false",color=purple];
	44 [label="Do you normally go mouling about in the memories of others, laying waste to their representations, without taking the opportunity to know them first?!",shape=box,color=blue];
		44 -> 50;
	45 [label="But I suppose there is nothing to be done about it now. You know the truth. I am laid bare to you, in all my abhorrent cowardice.",shape=box,color=blue];
		45 -> 51;
	46 [label="Long story short, there's... the Infestation that seems to extend to the Protoframe serums...",shape=box,color=red];
		46 -> 52;
	47 [label="Ah. Well. So. I have the ability to loop time.",shape=box,color=red];
		47 -> 52;
	41 [label="Since you have already been bashing about inside my mind like a drunken razaliorn inside of a glassmaker's shop, I require your assistance in attempting to decode what it all means.",shape=box,color=blue];
		41 -> 48;
	42 [label="You and the two zealots have already begun messing about inside my mind like a drunk razaliorn inside of a glassmaker's shop. I require your assistance in helping me decode what it all means.",shape=box,color=blue];
		42 -> 48;
	43 [label="When Albrecht drove the syringe into my neck and turned me into this - thing - he did something else, as well. Games between Orokin are one thing. This? This is something else.",shape=box,color=blue];
		43 -> 49;
	50 [label="Your manners are utterly atrocious!",shape=box,color=blue];
		50 -> 45;
	51 [label="I assume you have simply come here now to mock me. I request that you have your fill of it now so that we might move on from it uninterrupted.",shape=box,color=blue];
		51 -> 57;
	52 [label="And I thought that it worked on the Protoframes in 1999 because of the year itself looping, but that's not the case. ",shape=box,color=red];
		52 -> 58;
	48 [label="Not only do I need your assistance in regaining my memories - but to add insult to injury, I seem unable to even find the means to discern their truth on my own!",shape=box,color=blue];
		48 -> 53;
		48 -> 54;
	49 [label="He robbed me of much of my memories. I see that little... version of you, running about with all its traumatized Tenno friends. I see what the Lotus is helping it regain.",shape=box,color=blue];
		49 -> 55;
		49 -> 56;
	57 [label="I would rather not have to continually contend with this being underfoot like some diva's ornamentally bred yapping kubrow.",shape=box,color=blue];
		57 -> 63;
		57 -> 64;
	58 [label="I think it's... more to do with the Infestation itself? There's a talking guitar that kind of hinted at some of it. And you traveled here in a Helminth, didn't you?",shape=box,color=red];
		58 -> 65;
	53 [label="So you're saying you... just need to talk to someone?",shape=box,color=red];
		53 -> 59;
	54 [label="I'm happy to help you if I can, I just don't really know how.",shape=box,color=red];
		54 -> 60;
	55 [label="So... why don't you go into the dark refractory on your own?",shape=box,color=red];
		55 -> 61;
	56 [label="The kid isn't an \"it.\"",shape=box,color=red];
		56 -> 62;
	63 [label="You ran. But a lot of people run. It's about facing what happened.",shape=box,color=red];
		63 -> 69;
	64 [label="I'm not going to mock you. You made the choice to fight another day.",shape=box,color=red];
		64 -> 70;
	65 [label="You seem alarmingly uncertain about this entire conversation, Drifter. Especially when it comes to the contents of my skull.",shape=box,color=blue];
		65 -> 71;
