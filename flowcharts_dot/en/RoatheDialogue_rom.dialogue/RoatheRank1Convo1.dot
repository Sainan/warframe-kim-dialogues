		6 -> 13;
	7 [label="Hello, Roathe.",shape=box,color=red];
		7 -> 14;
	15 [label="Ah, good! You do in fact know my name! I was certain you must have overlooked it somehow, since you were clearly too busy slaughtering me repeatedly!",shape=box,color=blue];
		15 -> 21;
	16 [label="Do you really have nothing more productive to do?! Or is playing round after round of \"Pin the Horn on the Yaznak\" really the best use of your time?!",shape=box,color=blue];
		16 -> 21;
	11 [label="Update boolean RoatheUsurper",color=orange];
		11 -> 17;
	12 [label="Mm, no need for concern... or excitement. Yet. This is merely a business agreement between two individuals who stand to benefit each other greatly.",shape=box,color=blue];
		12 -> 14;
	13 [label="+5 Chemistry",color=orange];
		13 -> 18;
	14 [label="Now. Listen carefully. The two zealots have been so terribly and painstakingly drab in their repeated objurgation of me. I expect you to rise above such remedial behavior.",shape=box,color=blue];
		14 -> 19;
		14 -> 20;
	21 [label="I find it very hard to believe that all this - all this injustice I have suffered at your hands, all this peeling away of my psyche has not been purely out of spite at your behest!",shape=box,color=blue];
		21 -> 26;
		21 -> 27;
		21 -> 28;
	17 [label="+5 Chemistry",color=orange];
		17 -> 22;
	18 [label="I see my reputation precedes me. Good. It will save us some time.",shape=box,color=blue];
		18 -> 23;
	19 [label="I don't take orders from you.",shape=box,color=red];
		19 -> 24;
