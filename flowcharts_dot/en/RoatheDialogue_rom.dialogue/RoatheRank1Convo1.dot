	68 [label="And I would do the deed myself, believe me - but I cannot! The blasted protoframe serum Albrecht poisoned me with removed any ability I have of operating the damnable contraption on my own!",shape=box,color=blue];
		68 -> 67;
	73 [label="Fantastic. Another buzzing dolefly to dart around my ears and tell me I am in need of self-reflection and reptentance?",shape=box,color=blue];
