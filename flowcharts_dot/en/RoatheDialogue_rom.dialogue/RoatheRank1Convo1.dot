	75 [label="Because I certainly have perfectly \"fond\" memories of you rendering me unto mincemeat for your own sanguinary entertainment. How is that meant to make any sense whatsoever?",shape=box,color=blue];
		75 -> 79;
		75 -> 80;
	72 [label="And in return - you will have my solemn pledge that I will sit here... peacefully. I will pose no one any threat, of which I assure you... I am quite capable of being. I will do no harm to the zealots. Or to the butler. Or to Albrecht's Void-corrupted animals.",shape=box,color=blue];
		72 -> 76;
	77 [label="Lucky me.",shape=box,color=blue];
		77 -> 84;
	78 [label="Currently, what I am doing seems to be \"moldering in a crypt with a pair of gormless zealots and dolling out trinkets to war-traumatized children.\"",shape=box,color=blue];
		78 -> 85;
	79 [label="I don't know, and I'm not exactly here to continue taking abuse from you, Roathe. I didn't loop everyone just so I could catch flack from you over it.",shape=box,color=red];
		79 -> 5634;
	80 [label="As far as I can guess? Our conversations aren't deep rooted. They're surface memories. What we uncovered in your past were... more part of your core memories, I guess?",shape=box,color=red];
		80 -> 86;
	76 [label="And more importantly, I will do no harm to Albrecht's twisted family that sits about like so much mutated flora above us - unwitting to our very presence.",shape=box,color=blue];
		76 -> 81;
		76 -> 82;
		76 -> 83;
	84 [label="I plan to go about my business, Drifter, but the fact remains - you know too much about my past and what I've done. And we will have to simply... exist in this state.",shape=box,color=blue];
