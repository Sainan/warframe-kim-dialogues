	101 [label="And if you want mine, then I suggest - as I said - we come to an agreement.",shape=box,color=blue];
		101 -> 96;
	102 [label="And? Ah. I see. You are objecting to my \"tone\" is it? I am so terribly sorry. I did not realize you bristle so easily.",shape=box,color=blue];
		102 -> 96;
	103 [label="It has come to my attention that there are a great many matters around Deimos where my assistance could be considered not only viable, but I dare say, crucial.",shape=box,color=blue];
