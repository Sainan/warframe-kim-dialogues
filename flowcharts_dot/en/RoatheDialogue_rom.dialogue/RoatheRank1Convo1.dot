		35 -> 39;
	36 [label="+5 Chemistry",color=orange];
		36 -> 40;
	29 [label="And that makes you, on at least two counts, a Usurper by my measure. (And perhaps a third, if we count what the butler has told me of Duviri, but that is a debate for another time.)",shape=box,color=blue];
		29 -> 14;
	30 [label="You have made that repeatedly and brutally clear, thank you.",shape=box,color=blue];
		30 -> 33;
	31 [label="You have made that quite clear.",shape=box,color=blue];
		31 -> 33;
	32 [label="We shall see.",shape=box,color=blue];
		32 -> 33;
	33 [label="Now, the deal is simple, my charmingly lubricous and vaporous new \"friend.\"",shape=box,color=blue];
		33 -> 37;
	38 [label="It didn't seem like a priority?!",shape=box,color=blue];
		38 -> 44;
	39 [label="Really. I am astonished. Your manners are utterly atrocious, Drifter.",shape=box,color=blue];
		39 -> 45;
	40 [label="Pardon? And how precisely is it that I have come to forget you rummaging through my mind like the Malium Bowl at a Naberus party!",shape=box,color=blue];
