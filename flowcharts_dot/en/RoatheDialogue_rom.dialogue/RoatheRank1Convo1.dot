digraph {
	"RoatheRank1Convo1 begins." [color=orange];
		"RoatheRank1Convo1 begins." -> j3998890108;
	j3998890108 [label="Evaluate expressions on HellStory counter",color=orange];
		j3998890108 -> j261101170 [label="x >= 21",color=purple];
		j3998890108 -> j2344310335 [label="x >= 6",color=purple];
		j3998890108 -> j398786529 [label="x < 6",color=purple];
		j3998890108 -> j398786529 [label="false",color=purple];
	j261101170 [label="I really must commend you on your audacity! Truly, are you certain you are not an Orokin in disguise? Perhaps hiding your cerulean skin to keep from alerting the others?!",shape=box,color=blue];
		j261101170 -> j3205838016;
		j261101170 -> j4120765719;
		j261101170 -> j1973333308;
	j2344310335 [label="Boolean RoatheResetEdgeCase is now true.",color=orange];
		j2344310335 -> j398786529;
	j398786529 [label="The Void-born anomaly. \"The Drifter.\" The Usurper. Finally, we speak at last. Come. The Devil has a proposal to make...",shape=box,color=blue];
		j398786529 -> j208605035;
		j398786529 -> j923736960;
		j398786529 -> j719931517;
		j398786529 -> j3934513589;
	j3205838016 [label="Hello, Roathe.",shape=box,color=red];
		j3205838016 -> j1155016608;
	j4120765719 [label="What exactly are you accusing me of?",shape=box,color=red];
		j4120765719 -> j4149812519;
	j1973333308 [label="I'm sorry?",shape=box,color=red];
		j1973333308 -> j4149812519;
	j208605035 [label="Usurper?",shape=box,color=red];
		j208605035 -> j2823843988;
	j923736960 [label="What... kind of deal?",shape=box,color=red];
		j923736960 -> j1978598127;
	j719931517 [label="What kind of proposal could \"the Devil of Tau\" possibly have for me?",shape=box,color=red];
		j719931517 -> j1885948858;
	j3934513589 [label="Hello, Roathe.",shape=box,color=red];
		j3934513589 -> j3874470642;
	j1155016608 [label="Ah, good! You do in fact know my name! I was certain you must have overlooked it somehow, since you were clearly too busy slaughtering me repeatedly!",shape=box,color=blue];
		j1155016608 -> j2832182531;
	j4149812519 [label="Do you really have nothing more productive to do?! Or is playing round after round of \"Pin the Horn on the Yaznak\" really the best use of your time?!",shape=box,color=blue];
		j4149812519 -> j2832182531;
	j2823843988 [label="Boolean RoatheUsurper is now true.",color=orange];
		j2823843988 -> j2637522294;
	j1978598127 [label="Mm, no need for concern... or excitement. Yet. This is merely a business agreement between two individuals who stand to benefit each other greatly.",shape=box,color=blue];
		j1978598127 -> j3874470642;
	j1885948858 [label="+5 Chemistry",color=orange];
		j1885948858 -> j789248820;
	j3874470642 [label="Now. Listen carefully. The two zealots have been so terribly and painstakingly drab in their repeated objurgation of me. I expect you to rise above such remedial behavior.",shape=box,color=blue];
		j3874470642 -> j541088674;
		j3874470642 -> j450840089;
	j2832182531 [label="I find it very hard to believe that all this - all this injustice I have suffered at your hands, all this peeling away of my psyche has not been purely out of spite at your behest!",shape=box,color=blue];
		j2832182531 -> j1554939954;
		j2832182531 -> j2453802371;
		j2832182531 -> j899541002;
	j2637522294 [label="+5 Chemistry",color=orange];
		j2637522294 -> j4139600396;
	j789248820 [label="I see my reputation precedes me. Good. It will save us some time.",shape=box,color=blue];
		j789248820 -> j2152112604;
	j541088674 [label="I don't take orders from you.",shape=box,color=red];
		j541088674 -> j4026548805;
	j450840089 [label="I'll see what I can do.",shape=box,color=red];
		j450840089 -> j1544445100;
	j1554939954 [label="It didn't seem like a priority?",shape=box,color=red];
		j1554939954 -> j1959542522;
	j2453802371 [label="I... just I didn't get around to this earlier.",shape=box,color=red];
		j2453802371 -> j112872753;
	j899541002 [label="You don't remember... but we've been through this before.",shape=box,color=red];
		j899541002 -> j4048772158;
	j4139600396 [label="Ah! That is what you are, yes? The Tenno usurped the Origin System from the Orokin. And you, like a little imposter in the nest, have stolen into this world from your own.",shape=box,color=blue];
		j4139600396 -> j4047247544;
	j2152112604 [label="And there is no need for concern or excitement... yet. This is merely a business agreement between two individuals who stand to benefit each other greatly.",shape=box,color=blue];
		j2152112604 -> j3874470642;
	j4026548805 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4026548805 -> j3036656298 [label="x >= 21",color=purple];
		j4026548805 -> j4151776554 [label="x >= 1",color=purple];
		j4026548805 -> j1434605902 [label="x <= 0",color=purple];
		j4026548805 -> j1434605902 [label="false",color=purple];
	j1544445100 [label="See that you do.",shape=box,color=blue];
		j1544445100 -> j628739751;
	j1959542522 [label="It didn't seem like -",shape=box,color=blue];
		j1959542522 -> j2059058136;
	j112872753 [label="Oh! I am so very sorry to have inconvenienced you, I did not realize the slots on your dance card were already booked!",shape=box,color=blue];
		j112872753 -> j3693187149;
	j4048772158 [label="+5 Chemistry",color=orange];
		j4048772158 -> j722170749;
	j4047247544 [label="And that makes you, on at least two counts, a Usurper by my measure. (And perhaps a third, if we count what the butler has told me of Duviri, but that is a debate for another time.)",shape=box,color=blue];
		j4047247544 -> j3874470642;
	j3036656298 [label="You have made that repeatedly and brutally clear, thank you.",shape=box,color=blue];
		j3036656298 -> j628739751;
	j4151776554 [label="You have made that quite clear.",shape=box,color=blue];
		j4151776554 -> j628739751;
	j1434605902 [label="We shall see.",shape=box,color=blue];
		j1434605902 -> j628739751;
	j628739751 [label="Now, the deal is simple, my charmingly lubricous and vaporous new \"friend.\"",shape=box,color=blue];
		j628739751 -> j1071362491;
	j2059058136 [label="It didn't seem like a priority?!",shape=box,color=blue];
		j2059058136 -> j3462297797;
	j3693187149 [label="Really. I am astonished. Your manners are utterly atrocious, Drifter.",shape=box,color=blue];
		j3693187149 -> j2164462441;
	j722170749 [label="Pardon? And how precisely is it that I have come to forget you rummaging through my mind like the Malium Bowl at a Naberus party!",shape=box,color=blue];
		j722170749 -> j4193578294;
		j722170749 -> j2943151773;
	j1071362491 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j1071362491 -> j367200717 [label="x >= 21",color=purple];
		j1071362491 -> j1654083186 [label="x >= 1",color=purple];
		j1071362491 -> j904201011 [label="x <= 0",color=purple];
		j1071362491 -> j904201011 [label="false",color=purple];
	j3462297797 [label="Do you normally go mouling about in the memories of others, laying waste to their representations, without taking the opportunity to know them first?!",shape=box,color=blue];
		j3462297797 -> j1192339394;
	j2164462441 [label="But I suppose there is nothing to be done about it now. You know the truth. I am laid bare to you, in all my abhorrent cowardice.",shape=box,color=blue];
		j2164462441 -> j3060459772;
	j4193578294 [label="Long story short, there's... the Infestation that seems to extend to the Protoframe serums...",shape=box,color=red];
		j4193578294 -> j2804798922;
	j2943151773 [label="Ah. Well. So. I have the ability to loop time.",shape=box,color=red];
		j2943151773 -> j2804798922;
	j367200717 [label="Since you have already been bashing about inside my mind like a drunken razaliorn inside of a glassmaker's shop, I require your assistance in attempting to decode what it all means.",shape=box,color=blue];
		j367200717 -> j2302194303;
	j1654083186 [label="You and the two zealots have already begun messing about inside my mind like a drunk razaliorn inside of a glassmaker's shop. I require your assistance in helping me decode what it all means.",shape=box,color=blue];
		j1654083186 -> j2302194303;
	j904201011 [label="When Albrecht drove the syringe into my neck and turned me into this - thing - he did something else, as well. Games between Orokin are one thing. This? This is something else.",shape=box,color=blue];
		j904201011 -> j721566316;
	j1192339394 [label="Your manners are utterly atrocious!",shape=box,color=blue];
		j1192339394 -> j2164462441;
	j3060459772 [label="I assume you have simply come here now to mock me. I request that you have your fill of it now so that we might move on from it uninterrupted.",shape=box,color=blue];
		j3060459772 -> j3216264471;
	j2804798922 [label="And I thought that it worked on the Protoframes in 1999 because of the year itself looping, but that's not the case. ",shape=box,color=red];
		j2804798922 -> j3790354511;
	j2302194303 [label="Not only do I need your assistance in regaining my memories - but to add insult to injury, I seem unable to even find the means to discern their truth on my own!",shape=box,color=blue];
		j2302194303 -> j1089778597;
		j2302194303 -> j241721445;
	j721566316 [label="He robbed me of much of my memories. I see that little... version of you, running about with all its traumatized Tenno friends. I see what the Lotus is helping it regain.",shape=box,color=blue];
		j721566316 -> j2450593060;
		j721566316 -> j1295822232;
	j3216264471 [label="I would rather not have to continually contend with this being underfoot like some diva's ornamentally bred yapping kubrow.",shape=box,color=blue];
		j3216264471 -> j1552731126;
		j3216264471 -> j748066435;
	j3790354511 [label="I think it's... more to do with the Infestation itself? There's a talking guitar that kind of hinted at some of it. And you traveled here in a Helminth, didn't you?",shape=box,color=red];
		j3790354511 -> j3014459645;
	j1089778597 [label="So you're saying you... just need to talk to someone?",shape=box,color=red];
		j1089778597 -> j1327393170;
	j241721445 [label="I'm happy to help you if I can, I just don't really know how.",shape=box,color=red];
		j241721445 -> j4003769197;
	j2450593060 [label="So... why don't you go into the dark refractory on your own?",shape=box,color=red];
		j2450593060 -> j4138408177;
	j1295822232 [label="The kid isn't an \"it.\"",shape=box,color=red];
		j1295822232 -> j2342194403;
	j1552731126 [label="You ran. But a lot of people run. It's about facing what happened.",shape=box,color=red];
		j1552731126 -> j1840721981;
	j748066435 [label="I'm not going to mock you. You made the choice to fight another day.",shape=box,color=red];
		j748066435 -> j220037017;
	j3014459645 [label="You seem alarmingly uncertain about this entire conversation, Drifter. Especially when it comes to the contents of my skull.",shape=box,color=blue];
		j3014459645 -> j2787933628;
	j1327393170 [label="Oh do not make this sound like I simply need to lay on some reclined sofa and speak through my \"feelings.\"",shape=box,color=blue];
		j1327393170 -> j4003769197;
	j4003769197 [label="I need someone to operate the machine at my behest, as I am currently incapable of doing so myself. ",shape=box,color=blue];
		j4003769197 -> j1477276666;
	j4138408177 [label="I would do the deed myself, believe me - but I cannot! The blasted protoframe serum Albrecht poisoned me with removed any ability I have of operating the damnable contraption on my own!",shape=box,color=blue];
		j4138408177 -> j1752861865;
	j2342194403 [label="I assure you, \"it\" very much is.",shape=box,color=blue];
		j2342194403 -> j1680714592;
	j1840721981 [label="Add 1 to Thermostat counter",color=orange];
		j1840721981 -> j3780424695;
	j220037017 [label="Add -1 to Thermostat counter",color=orange];
		j220037017 -> j1124017500;
	j2787933628 [label="And yes. I did come here via a Helminth. That I engineered and grew myself, thank you. Now. You mean to tell me that you have... erased my memories?! Of what, our conversations together?! ",shape=box,color=blue];
		j2787933628 -> j2875070676;
	j1477276666 [label="I am also in need of someone to help me record my memories and assist me in reconciling them. A temporary assistant of sorts.",shape=box,color=blue];
		j1477276666 -> j3273596864;
	j1752861865 [label="And in addition, not only do I need your assistance in regaining my memories - but to add insult to injury, I seem unable to even find the means to discern their truth on my own!",shape=box,color=blue];
		j1752861865 -> j1089778597;
		j1752861865 -> j241721445;
	j1680714592 [label="And I would do the deed myself, believe me - but I cannot! The blasted protoframe serum Albrecht poisoned me with removed any ability I have of operating the damnable contraption on my own!",shape=box,color=blue];
		j1680714592 -> j1752861865;
	j3780424695 [label="Fantastic. Another buzzing dolefly to dart around my ears and tell me I am in need of self-reflection and reptentance?",shape=box,color=blue];
		j3780424695 -> j1736345938;
	j1124017500 [label="+5 Chemistry",color=orange];
		j1124017500 -> j548643132;
	j2875070676 [label="Because I certainly have perfectly \"fond\" memories of you rendering me unto mincemeat for your own sanguinary entertainment. How is that meant to make any sense whatsoever?",shape=box,color=blue];
		j2875070676 -> j1181024595;
		j2875070676 -> j4211392604;
	j3273596864 [label="And in return - you will have my solemn pledge that I will sit here... peacefully. I will pose no one any threat, of which I assure you... I am quite capable of being. I will do no harm to the zealots. Or to the butler. Or to Albrecht's Void-corrupted animals.",shape=box,color=blue];
		j3273596864 -> j1245816585;
	j1736345938 [label="Lucky me.",shape=box,color=blue];
		j1736345938 -> j2189467256;
	j548643132 [label="Currently, what I am doing seems to be \"moldering in a crypt with a pair of gormless zealots and dolling out trinkets to war-traumatized children.\"",shape=box,color=blue];
		j548643132 -> j627658795;
	j1181024595 [label="I don't know, and I'm not exactly here to continue taking abuse from you, Roathe. I didn't loop everyone just so I could catch flack from you over it.",shape=box,color=red];
		j1181024595 -> j185216594;
	j4211392604 [label="As far as I can guess? Our conversations aren't deep rooted. They're surface memories. What we uncovered in your past were... more part of your core memories, I guess?",shape=box,color=red];
		j4211392604 -> j3310740470;
	j1245816585 [label="And more importantly, I will do no harm to Albrecht's twisted family that sits about like so much mutated flora above us - unwitting to our very presence.",shape=box,color=blue];
		j1245816585 -> j490930481;
		j1245816585 -> j2306372377;
		j1245816585 -> j1426809087;
	j2189467256 [label="I plan to go about my business, Drifter, but the fact remains - you know too much about my past and what I've done. And we will have to simply... exist in this state.",shape=box,color=blue];
		j2189467256 -> j4044212388;
	j627658795 [label="But I suppose that must be what they call it now.",shape=box,color=blue];
		j627658795 -> j2189467256;
	j185216594 [label="Yes. I could hazard a guess as to why you have summoned your Void-gifts to wipe our minds of recent events. How perfectly predictable.",shape=box,color=blue];
		j185216594 -> j3956244044;
	j3310740470 [label="Fantastic. Utterly marvelous. I am in the hands now of a lunatic who has the ability to wipe my memories clean at a whim! How adorable.",shape=box,color=blue];
		j3310740470 -> j3956244044;
	j490930481 [label="I thought this was a deal. Now you're threatening me?",shape=box,color=red];
		j490930481 -> j1718688280;
	j2306372377 [label="Roathe? Please stop and listen to me for a second.",shape=box,color=red];
		j2306372377 -> j1051471433;
	j1426809087 [label="What do you need me to do?",shape=box,color=red];
		j1426809087 -> j3035375799;
	j4044212388 [label="Try not to make this too unduly uncomfortable for me and I will promise that I shall try to do the same in return.",shape=box,color=blue];
		j4044212388 -> j2515996925;
		j4044212388 -> j3664448750;
	j3956244044 [label="Well. If what you say is true - and I suppose this tale is mad enough to be reality - I will attempt not to hold it against you that you know this deep and terrible truth of mine.",shape=box,color=blue];
		j3956244044 -> j2489885509;
	j1718688280 [label="Were you not paying attention? Really, reading comprehension these days... I was not threatening you, Usurper. Nor was I threatening anyone else.",shape=box,color=blue];
		j1718688280 -> j2518589157;
	j1051471433 [label="This ought to be grand. Please. Go right ahead; the proverbial theatre is yours.",shape=box,color=blue];
		j1051471433 -> j1191959298;
		j1051471433 -> j2147273050;
		j1051471433 -> j2431737121;
	j3035375799 [label="Were you not paying attention? Really, reading comprehension these days... I am attempting to strike a deal with you, Usurper. I have a hard time believing you cannot follow along.",shape=box,color=blue];
		j3035375799 -> j3504410037;
	j2515996925 [label="No.",shape=box,color=red];
		j2515996925 -> j1372488935;
	j3664448750 [label="I think that's fair.",shape=box,color=red];
		j3664448750 -> j1674042230;
	j2489885509 [label="Though I would request - if I may - that you would get your fill of whatever mocking you wish to levy in my direction so that we might move on from it uninterrupted.",shape=box,color=blue];
		j2489885509 -> j3216264471;
	j2518589157 [label="I was merely stating that should we reach a point where I am unable to reach my end goals, I may have no reason to sit quietly any longer.",shape=box,color=blue];
		j2518589157 -> j3504410037;
	j1191959298 [label="I'm the reason Ballas is dead. Don't make me clear my schedule.",shape=box,color=red];
		j1191959298 -> j533389043;
	j2147273050 [label="If you want my help, this isn't a very good way of getting it.",shape=box,color=red];
		j2147273050 -> j3794748570;
	j2431737121 [label="I know you and I don't have much experience with each other - not really. But I'm here to help you.",shape=box,color=red];
		j2431737121 -> j3373306767;
	j3504410037 [label="If my proposal does not reach your standards, shall I sweeten it for you?",shape=box,color=blue];
		j3504410037 -> j3292850606;
	j1372488935 [label="+5 Chemistry",color=orange];
		j1372488935 -> j3501278581;
	j1674042230 [label="+15 Chemistry",color=orange];
		j1674042230 -> j3158823762;
	j533389043 [label="+5 Chemistry",color=orange];
		j533389043 -> j968884166;
	j3794748570 [label="And if you want mine, then I suggest - as I said - we come to an agreement.",shape=box,color=blue];
		j3794748570 -> j3504410037;
	j3373306767 [label="And? Ah. I see. You are objecting to my \"tone\" is it? I am so terribly sorry. I did not realize you bristle so easily.",shape=box,color=blue];
		j3373306767 -> j3504410037;
	j3292850606 [label="It has come to my attention that there are a great many matters around Deimos where my assistance could be considered not only viable, but I dare say, crucial.",shape=box,color=blue];
		j3292850606 -> j4148161832;
	j3501278581 [label="Ha! I do have to respect your honesty, if nothing else.",shape=box,color=blue];
		j3501278581 -> j3441318102;
	j3158823762 [label="Wonderful. It is good to know you are at least... agreeable.",shape=box,color=blue];
		j3158823762 -> j3441318102;
	j968884166 [label="If you could have just heard me laugh! Thank you, Drifter, for very much not being tedious!",shape=box,color=blue];
		j968884166 -> j2740354885;
	j4148161832 [label="Including, but not limited to, the reconciliation of one lovelorn butler and said estranged family who lives upstairs.",shape=box,color=blue];
		j4148161832 -> j1058084919;
	j3441318102 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j3441318102 -> j765641980;
	j2740354885 [label="Add -1 to Thermostat counter",color=orange];
		j2740354885 -> j3456191803;
	j1058084919 [label="A family who, as I mentioned, has no idea that we are even down here. And has no knowledge of Albrecht's continued existence amongst the living, am I correct?",shape=box,color=blue];
		j1058084919 -> j2021818033;
		j1058084919 -> j22720529;
		j1058084919 -> j3024817668;
	j765641980 [label="At least this will be interesting.",shape=box,color=blue];
		j765641980 -> "Chat ends.";
	j3456191803 [label="What a delight that was! I think you and I will be friends, indeed. This was quite wonderful.",shape=box,color=blue];
		j3456191803 -> j2012370339;
	j2021818033 [label="You're offering to help convince Loid to... talk to the Entrati family?",shape=box,color=red];
		j2021818033 -> j1347778543;
	j22720529 [label="I can't convince Loid to do anything about it. He claims it'd be too painful for them.",shape=box,color=red];
		j22720529 -> j2226105739;
	j3024817668 [label="They don't know Albrecht Entrati is still alive, no.",shape=box,color=red];
		j3024817668 -> j4197397243;
	"Chat ends." [color=orange];
	j2012370339 [label="I think, for that, I shall reward you. And make my end of the deal just a little bit sweeter for you. Such audacity is rare.",shape=box,color=blue];
		j2012370339 -> j3292850606;
	j1347778543 [label="Not for free, my Void-addled Usurper.",shape=box,color=blue];
		j1347778543 -> j2589118510;
	j2226105739 [label="You cannot. But I promise you... I can.",shape=box,color=blue];
		j2226105739 -> j2589118510;
	j4197397243 [label="And where you have failed to convince that disconsolate manservant? I promise you... I can.",shape=box,color=blue];
		j4197397243 -> j2589118510;
	j2589118510 [label="And so we finally come to my proposal: help me sort out the matter of my missing memories, and get to the \"bottom\" of it all - no pun intended.",shape=box,color=blue];
		j2589118510 -> j3796628326;
	j3796628326 [label="And I will ensure our heartsick servant walks up those stairs. And, in the meanwhile, I will seat peacefully... and be no danger to anyone. What say you? Do we have a deal?",shape=box,color=blue];
		j3796628326 -> j1749515665;
		j3796628326 -> j2144096910;
	j1749515665 [label="No deal.",shape=box,color=red];
		j1749515665 -> j2538694841;
	j2144096910 [label="Deal.",shape=box,color=red];
		j2144096910 -> j1482641512;
	j2538694841 [label="As you wish. But fair warning:",shape=box,color=blue];
		j2538694841 -> j401033893;
	j1482641512 [label="+5 Chemistry",color=orange];
		j1482641512 -> j2758828816;
	j401033893 [label="Boolean RoatheNoDeal is now true.",color=orange];
		j401033893 -> j2023486135;
	j2758828816 [label="Good! Glad to see you aren't a fool. As they say:",shape=box,color=blue];
		j2758828816 -> j3520305401;
	j2023486135 [label="Crossing a devil is worse than dealing with one.",shape=box,color=blue];
		j2023486135 -> j355014972;
	j3520305401 [label="Boolean RoatheDeal is now true.",color=orange];
		j3520305401 -> j2023486135;
	j355014972 [label="Both you'll come to regret, but only with one do you stand to benefit.",shape=box,color=blue];
		j355014972 -> "Chat ends.";
}