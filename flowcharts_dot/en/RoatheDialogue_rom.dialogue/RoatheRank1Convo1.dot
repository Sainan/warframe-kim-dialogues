	28 [label="You don't remember... but we've been through this before.",shape=box,color=red];
		28 -> 36;
	22 [label="Ah! That is what you are, yes? The Tenno usurped the Origin System from the Orokin. And you, like a little imposter in the nest, have stolen into this world from your own.",shape=box,color=blue];
