	958 [label="+10 Chemistry",color=orange];
		958 -> 968;
	959 [label="Either you are attempting to appeal to my ego, which I commend you for, or you are simply extremely uninspired with your day. Which, as someone who has also enjoyed countless cycles of life, I nearly sympathize with.",shape=box,color=blue];
		959 -> 969;
	960 [label="Fascinating. You are either lying, or I still have stones you have yet left unturned. Which may be the reason you are here once more rereading fields already ploughed.",shape=box,color=blue];
		960 -> 970;
	961 [label="Mm, little by little, you are nearly convincing me to forgive you for this mess you've made.",shape=box,color=blue];
		961 -> 971;
	965 [label="Long before the Zariman Ten Zero launched, and the Tenno were even a blip on the proverbial screen, Margulis the Archimedean and Ballas met during the opening of a new domed conservatory.",shape=box,color=blue];
		965 -> 975;
	973 [label="As far as I've been told - and she's not exactly entirely reliable, so take this with a grain of salt - the strains of Infestation for each of the batches of Protoframes can be influenced individually.",shape=box,color=red];
		973 -> 981;
	974 [label="I... see.",shape=box,color=blue];
		974 -> 982;
	972 [label="Chat ends.",color=orange];
	966 [label="As each one sort of lives inside its own \"continuity\" or time. All the Infestation strains are connected, but they sort of live in... nodules. It's all very complicated.",shape=box,color=red];
		966 -> 976;
	967 [label="The universe has certainly become stranger since I left it...",shape=box,color=blue];
		967 -> 977;
		967 -> 978;
	968 [label="Then I shall not tire you by recounting the saga yet again, and I shall leave you to find other amusements with the rest of your day.",shape=box,color=blue];
		968 -> 979;
	969 [label="Were I not the subject of your amusement.",shape=box,color=blue];
		969 -> 970;
	970 [label="But? Regardless... ",shape=box,color=blue];
		970 -> 980;
	971 [label="Update boolean RoatheResetForgiven",color=orange];
		971 -> 970;
	975 [label="Ballas was there for the sake of ceremony - we do love our pomp and circumstance, of course - and Margulis was desperately attempting not to be noticed.",shape=box,color=blue];
		975 -> 983;
	981 [label="As each one sort of lives inside its own \"continuity\" or time. All the Infestation strains are connected, but they sort of live in... nodules. It's all very complicated.",shape=box,color=red];
