	930 [label="I would council sitting quietly with ones mistakes and accepting defeat for what it is, but that would make me quite the raging hypocrite, wouldn't it?",shape=box,color=blue];
		930 -> 940;
	929 [label="I would council sitting quietly with ones mistakes and accepting defeat for what it is, personally. But I do not have the Void-given gift of looping pockets if time and erasing minds.",shape=box,color=blue];
		929 -> 939;
	931 [label="Have I told you the story of Ballas and Margulis? I am relying on you to be honest with me, as I have absolutely no way of knowing the truth otherwise.",shape=box,color=blue];
		931 -> 941;
	937 [label="I like to believe that we are all in the end, raw jewels. We have our flaws, our characteristics. Veins here, blemishes there.",shape=box,color=blue];
		937 -> 938;
	938 [label="And we may be faceted certain ways to either catch the light and set into elaborate works of art... or sharpened into weapons... or shattered into dust.",shape=box,color=blue];
		938 -> 944;
	943 [label="I would council sitting quietly with ones mistakes and accepting defeat for what it is, but that would make me quite the raging hypocrite, wouldn't it?",shape=box,color=blue];
		943 -> 953;
	942 [label="I would council sitting quietly with ones mistakes and accepting defeat for what it is, personally. But I do not have the Void-given gift of looping pockets if time and erasing minds.",shape=box,color=blue];
		942 -> 952;
	940 [label="And who is to say that I would not have made good use of the Void-given gift of looping pockets of time and erasing minds?",shape=box,color=blue];
