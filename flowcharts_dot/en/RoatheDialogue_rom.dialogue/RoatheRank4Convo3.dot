digraph {
	"RoatheRank4Convo3 begins." [color=orange];
		"RoatheRank4Convo3 begins." -> j3809608010;
	j3809608010 [label="Riddle me this, Usurper: If it came to it, do you think you could best your Tenno counterpart in a fight to the death?",shape=box,color=blue];
		j3809608010 -> j1554094519;
		j3809608010 -> j3910960461;
		j3809608010 -> j242691715;
	j1554094519 [label="What? Why...?",shape=box,color=red];
		j1554094519 -> j3866341430;
	j3910960461 [label="I am not having this conversation.",shape=box,color=red];
		j3910960461 -> j3053637080;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j3866341430 [label="Because I am not sure if you have noticed, but \"the Lotus\" is not only a Sentient - one responsible for putting Lua in the Void I might add -  but she has also quantifiably lost control of her circuitry.",shape=box,color=blue];
		j3866341430 -> j2640903310;
		j3866341430 -> j930758299;
		j3866341430 -> j2545568649;
		j3866341430 -> j2264600525;
		j3866341430 -> j3992196321;
	j3053637080 [label="I am not attempting to be crass. I am being quite serious, you realize. This is a purely pragmatic conversation. ",shape=box,color=blue];
		j3053637080 -> j3866341430;
	"Chat ends." [color=orange];
	j2640903310 [label="She's fine. You don't know what you're talking about.",shape=box,color=red];
		j2640903310 -> j3640325531;
	j930758299 [label="Lost control of her circuitry? What do you mean?",shape=box,color=red];
		j930758299 -> j2661701567;
	j2545568649 [label="No. I'm not doing this. The Lotus saved my life. She's saved the Tenno's lives countless times. We owe everything to her.",shape=box,color=red];
		j2545568649 -> j40703162;
	j2264600525 [label="Shut up Roathe, I'm not doing this. [End.]",shape=box,color=red];
		j2264600525 -> j582976256;
	j3992196321 [label="I know, I'm worried too. But she's done so much for us, and I can't turn my back on her. I have to support her.",shape=box,color=red];
		j3992196321 -> j1319618008;
	j3640325531 [label="Don't I? Pay attention! Look around! How many months did she spend standing on the edge of a cliff, holding an antiquated pager, humming to herself? Staring off into the Void?",shape=box,color=blue];
		j3640325531 -> j75402892;
	j2661701567 [label="How many months did she spend standing on the edge of a cliff, holding an antiquated pager, humming to herself? Staring off into the Void?",shape=box,color=blue];
		j2661701567 -> j75402892;
	j40703162 [label="I am not unsympathetic. I understand what it is like. You owe her a great deal. I am not telling you to kill her, I am telling you to stop allowing her to influence those around you.",shape=box,color=blue];
		j40703162 -> j2661701567;
	j582976256 [label="As you wish. But when this all comes crashing down around you? Do not come crawling to me for assistance.",shape=box,color=blue];
		j582976256 -> "Chat ends.";
	j1319618008 [label="+5 Chemistry",color=orange];
		j1319618008 -> j1852958044;
	j75402892 [label="And now she is just... looming? In the darkness? Sending your child self deeper and deeper into their memories, for what? A way home simply because Albrecht snapped his fingers and whispered the magic word?",shape=box,color=blue];
		j75402892 -> j554633842;
	j1852958044 [label="I am not unsympathetic. I understand what it is like. You owe her a great deal. I am not telling you to kill her, I am telling you to stop allowing her to influence those around you.",shape=box,color=blue];
		j1852958044 -> j1212179140;
	j554633842 [label="Don't you find it suspicious? Don't you find it dangerous? It's a trap. She is being manipulated. Either by Albrecht or by this so-called \"Indifference.\" She is a broken program. Her precepts are malfunctioning.",shape=box,color=blue];
		j554633842 -> j2624358926;
	j1212179140 [label="When she was standing there on the edge of the cliff, holding an antiquated pager, humming to herself? Staring off into the Void? Did you not think she might jump?",shape=box,color=blue];
		j1212179140 -> j75402892;
	j2624358926 [label="I do not think she means you harm. I think she is merely being used. But when the time comes, you may need to defend yourself. Or you may need to put them down.",shape=box,color=blue];
		j2624358926 -> j960416499;
	j960416499 [label="And while it is (hopefully) likely that you will see the sense in avoiding some sort of second round of the Lotus becoming problematic, her feral child army will not. So I will ask again:",shape=box,color=blue];
		j960416499 -> j78327649;
	j78327649 [label="Who do you think would win, if the terrible day came, and you had to fight with all your resources? You and all you have, against all the Tenno and the Lotus?",shape=box,color=blue];
		j78327649 -> j1433872476;
		j78327649 -> j4008607307;
		j78327649 -> j2314304243;
	j1433872476 [label="This is asinine. No.",shape=box,color=red];
		j1433872476 -> j201534021;
	j4008607307 [label="There's like... I don't know, a hundred of them. And one of me, Roathe.",shape=box,color=red];
		j4008607307 -> j2115218318;
	j2314304243 [label="I don't even know where to start.",shape=box,color=red];
		j2314304243 -> j1015896024;
	j201534021 [label="Consider it a silly game if you must, then! A theoretical played by children. ",shape=box,color=blue];
		j201534021 -> j3233393598;
		j201534021 -> j973441539;
	j2115218318 [label="+5 Chemistry",color=orange];
		j2115218318 -> j500425928;
	j1015896024 [label="Then it is a very good thing you are speaking to \"The Devil of Tau.\" There is a reason I am known as a strategist. Let us begin at the very top: Numbers. You are horribly outclassed in that field. ",shape=box,color=blue];
		j1015896024 -> j4181059854;
	j3233393598 [label="This isn't a game.",shape=box,color=red];
		j3233393598 -> j3325969572;
	j973441539 [label="For the last time? No. [End.]",shape=box,color=red];
		j973441539 -> "Chat ends.";
	j500425928 [label="Perfect. We have established the very first rule of laying out the battlefield: numbers. Obviously, you are horribly outclassed by sheer volume.",shape=box,color=blue];
		j500425928 -> j4181059854;
	j4181059854 [label="Check boolean IsDating",color=orange];
		j4181059854 -> j2618723032 [label=true,color=green];
		j4181059854 -> j3773159168 [label=false,color=brown];
	j3325969572 [label="You are correct. It is not. And it may come down to life or death someday. You versus your little... miniature version. And their pack of feral companions.",shape=box,color=blue];
		j3325969572 -> j2562764358;
	j2618723032 [label="However, if rumor of your \"personal activities\" and paramour amongst protoframes in other timelines could be... leveraged, perhaps those resources could be summoned somehow. Helminths will need to be specially researched and bred for this purpose...",shape=box,color=blue];
		j2618723032 -> j1187175886;
	j3773159168 [label="I have heard tell of your interactions with other protoframes in other timelines. Perhaps those resources could be summoned somehow. Helminths will need to be specifically researched and bred for this purpose...",shape=box,color=blue];
		j3773159168 -> j1187175886;
	j2562764358 [label="Feral companions who, by the by, have already proven to be violent, unruly, and been known to cruelly cast out their own for differing too far from their own opinions of normalcy.",shape=box,color=blue];
		j2562764358 -> j2605041130;
		j2562764358 -> j797888985;
		j2562764358 -> j4051573006;
	j1187175886 [label="I do not even know if that is possible, but it provided us passage here, so I do not see why not...",shape=box,color=blue];
		j1187175886 -> j541960701;
		j1187175886 -> j2381232074;
		j1187175886 -> j3556081603;
	j2605041130 [label="You're implying the Tenno are evil, now?",shape=box,color=red];
		j2605041130 -> j2704774841;
	j797888985 [label="What're you saying?",shape=box,color=red];
		j797888985 -> j3936050690;
	j4051573006 [label="No. I'm done. [End.]",shape=box,color=red];
		j4051573006 -> j3824540070;
	j541960701 [label="Roathe? Go to Hell.",shape=box,color=red];
		j541960701 -> j603741415;
	j2381232074 [label="I am not going to call them into this mess.",shape=box,color=red];
		j2381232074 -> j2347063593;
	j3556081603 [label="I'm alarmed at how much thought you've put into this.",shape=box,color=red];
		j3556081603 -> j513301687;
	j2704774841 [label="No, not evil. I do not believe in \"evil,\" Usurper. I never have, and I never will. I believe that the Tenno are wonderfully and beautifully human, like everyone else. Simply human. And moreover? They are children.",shape=box,color=blue];
		j2704774841 -> j1480082705;
	j3936050690 [label="That the time may come, some terrible day, that you must be prepared to do the unthinkable.",shape=box,color=blue];
		j3936050690 -> j608456844;
	j3824540070 [label="Run from the conversation if you like, but you know every word of this is the truth. You simply do not wish to accept it.",shape=box,color=blue];
		j3824540070 -> "Chat ends.";
	j603741415 [label="+5 Chemistry",color=orange];
		j603741415 -> j276550992;
	j2347063593 [label="Ah! So you admit there is a mess. That is progress. May I at least make my case?",shape=box,color=blue];
		j2347063593 -> j906807873;
		j2347063593 -> j263356067;
	j513301687 [label="And I am alarmed by how much you clearly have not. May I at least make my case?",shape=box,color=blue];
		j513301687 -> j906807873;
		j513301687 -> j263356067;
	j1480082705 [label="Children who have been tasked with facing horrors and committing atrocities the likes of which I have seen break grown hardened Orokin warriors whose time has spanned hundreds of years.",shape=box,color=blue];
		j1480082705 -> j539819469;
	j608456844 [label="The Tenno are wonderfully and beautifully human, like everyone else. Simply human. And moreover? They are children.",shape=box,color=blue];
		j608456844 -> j1480082705;
	j276550992 [label="I am already there, Usurper. I am already there.",shape=box,color=blue];
		j276550992 -> j155006797;
	j906807873 [label="Okay. Sure. Go ahead. I'll listen.",shape=box,color=red];
		j906807873 -> j2136571607;
	j263356067 [label="No. I'm done.",shape=box,color=red];
		j263356067 -> j3982891281;
	j539819469 [label="I have seen Dax - Golden, Elite Dax! - drop their sacred, gilt swords and flee from the battlefield that the Tenno waded into with their Warframes.",shape=box,color=blue];
		j539819469 -> j1441746002;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j2136571607 [label="+5 Chemistry",color=orange];
		j2136571607 -> j1703122148;
	j3982891281 [label="And lo, so am I.",shape=box,color=blue];
		j3982891281 -> "Chat ends.";
	j1441746002 [label="Their perceived cocoon of Infested shelter protected their bodies but not their minds. They are not to blame for the way they are.",shape=box,color=blue];
		j1441746002 -> j2302967958;
	j1703122148 [label="Thank you. That the time may come, some terrible day, that you must be prepared to do the unthinkable.",shape=box,color=blue];
		j1703122148 -> j608456844;
	j2302967958 [label="Tormented by the Void... forced to murder or witness the deaths of their own parents... subjected to war... having their memories stolen... lost to cryosleep for centuries...",shape=box,color=blue];
		j2302967958 -> j509316220;
	j509316220 [label="That they are not raving lunatics entirely is miraculous, Usurper. I am not saying that it will go wrong. I am merely saying that it could. And that you must have a plan in place for if that day were to come to pass.",shape=box,color=blue];
		j509316220 -> j1167381153;
	j1167381153 [label="There is no harm in being prepared for the worst. There is all the harm in the world in not.",shape=box,color=blue];
		j1167381153 -> j2839252386;
		j1167381153 -> j3180668311;
		j1167381153 -> j4060463971;
		j1167381153 -> j1396126292;
	j2839252386 [label="I'll... keep an eye on things. Okay? But I'm not going behind anyone's backs.",shape=box,color=red];
		j2839252386 -> j2763833243;
	j3180668311 [label="I really, really hate that I kind of agree with you here.",shape=box,color=red];
		j3180668311 -> j1782173540;
	j4060463971 [label="You realize I suffered just as much as the Tenno did, right?",shape=box,color=red];
		j4060463971 -> j3013700620;
	j1396126292 [label="I'm not betraying their trust.",shape=box,color=red];
		j1396126292 -> j3057423175;
	j2763833243 [label="+5 Chemistry",color=orange];
		j2763833243 -> j163540879;
	j1782173540 [label="+5 Chemistry",color=orange];
		j1782173540 -> j2854181160;
	j3013700620 [label="And who is to say I am not having these same conversations with them, hm?",shape=box,color=blue];
		j3013700620 -> j3623926149;
	j3057423175 [label="Nor was I suggesting you do otherwise.",shape=box,color=blue];
		j3057423175 -> j346357367;
	j163540879 [label="Of course! That is all a devil could ask, thank you.",shape=box,color=blue];
		j163540879 -> j346357367;
	j2854181160 [label="Mm.  It is just the sensation of sanity returning to your brain after all these years. You'll get used to it.",shape=box,color=blue];
		j2854181160 -> j321621700;
	j3623926149 [label="Sleep well, Usurper. ",shape=box,color=blue];
		j3623926149 -> j321621700;
	j346357367 [label="Add 1 to Thermostat counter",color=orange];
		j346357367 -> "Chat ends.";
	j321621700 [label="Add -1 to Thermostat counter",color=orange];
		j321621700 -> "Chat ends.";
}