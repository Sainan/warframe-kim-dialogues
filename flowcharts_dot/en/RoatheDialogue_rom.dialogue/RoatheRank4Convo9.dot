	"Chat ends." [color=orange];
	j4042314970 [label="Well, I do not know the details precisely. Only that I was called to break up a screaming match between Marie and Tagfer. ",shape=box,color=blue];
		j4042314970 -> j142120685;
	j142120685 [label="Bird Three was inconsolable and would not tell me the nature of the conversation, and Loid did not witness it. Only Fibonacci would tell me that it had \"something to do with Entrati.\"",shape=box,color=blue];
