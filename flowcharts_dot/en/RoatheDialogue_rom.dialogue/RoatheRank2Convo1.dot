		j2953660143 -> j475786744 [label=false,color=brown];
	j2171603518 [label="How goes your progress so far with our little floating sycophant? I take it the priest is still not speaking to you.",shape=box,color=blue];
		j2171603518 -> j568971278;
		j2171603518 -> j2087445063;
		j2171603518 -> j2544677686;
	j102000582 [label="Tell me, have you changed your mind on my offer? This will be your last chance, Usurper. I am a patient devil, but I do not like to be left about to hold doors open like a fool.",shape=box,color=blue];
		j102000582 -> j3822298111;
		j102000582 -> j152445645;
	j926850260 [label="I'm getting along all right with Marie, so far.",shape=box,color=red];
		j926850260 -> j1031925304;
	j511563311 [label="No, but he'll come around.",shape=box,color=red];
		j511563311 -> j3321315650;
	j1014455088 [label="You don't seem to like them very much. Why?",shape=box,color=red];
		j1014455088 -> j662852507;
	j838671903 [label="As you wish. Fair warning, this was your last opportunity. You are on your own, now.",shape=box,color=blue];
		j838671903 -> j113242122;
	j1876832257 [label="Evaluate expressions",color=orange];
		j1876832257 -> j1052217618 [label="RoatheDatingDealNo",color=purple];
