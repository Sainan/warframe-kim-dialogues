		j773999891 -> j352243581;
	j2170421206 [label="+5 Chemistry",color=orange];
		j2170421206 -> j3063744403;
	j190051100 [label="+5 Chemistry",color=orange];
		j190051100 -> j4163618282;
	j769180499 [label="How very Orokin of you.",shape=box,color=blue];
		j769180499 -> j2364954105;
	j1791053690 [label="Hysterically enough? I still prefer him over the sister. At least he can be reasoned with.",shape=box,color=blue];
		j1791053690 -> j4213416224;
		j1791053690 -> j1116070670;
	j2545800578 [label="She simply is just that mind-numbingly sanctimonious.",shape=box,color=blue];
		j2545800578 -> j2727404050;
		j2545800578 -> j3240891417;
	j2719350922 [label="Which I will have you know, they still used in that damn cathedral! Actual -",shape=box,color=blue];
		j2719350922 -> j457515515;
	j1098002312 [label="But to quote the little floating sycophant? C'est la vie. How goes it with her, by the by? I take it the priest is still not speaking to you.",shape=box,color=blue];
		j1098002312 -> j2544677686;
		j1098002312 -> j2087445063;
		j1098002312 -> j568971278;
