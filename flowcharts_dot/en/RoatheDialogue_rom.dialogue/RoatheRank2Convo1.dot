	609 [label="I find it so terribly fascinating that you schemed with me to... arrange my own path. The devil deals in his own flesh, as it were.",shape=box,color=blue];
		609 -> 619;
	608 [label="How goes progress on your end, my Usurper? I busily pull strings and levers in your favor, though my influence may be unseen and unfelt thus far.",shape=box,color=blue];
		608 -> 619;
	610 [label="Tell me that you have changed your mind regarding my offer. Where I might have proved a barrier of resistance before, regarding your... romantic goals? Now, I shall be as docile as a snow terrisk. Hmm. Unless that is not what you desire. You can be the decider of that.",shape=box,color=blue];
