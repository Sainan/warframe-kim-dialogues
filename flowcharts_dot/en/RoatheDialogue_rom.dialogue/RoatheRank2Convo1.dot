		j4273879934 -> j3061150477;
	j352243581 [label="First: I am impressed! You took away all our memories so that you could have another attempt at winning his affections?!",shape=box,color=blue];
		j352243581 -> j1454910813;
	j3063744403 [label="Oh this is truly magical! You took away all our memories in an attempt to have another try at winning my affections?!",shape=box,color=blue];
		j3063744403 -> j1036257444;
	j4163618282 [label="First: I am impressed! You took away all our memories so that you could have another attempt at winning her affections?!",shape=box,color=blue];
		j4163618282 -> j1074370048;
	j2364954105 [label="I will pretend to be none the wiser in front of the zealots for you.",shape=box,color=blue];
		j2364954105 -> j1374221804;
	j4213416224 [label="Do you know if I upset him in some way?",shape=box,color=red];
