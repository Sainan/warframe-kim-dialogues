		j1396301825 -> j651943163;
	j3615972620 [label="I know we are at the limit, I can feel the strain of my mind fighting against me. You are doing the best you can to help me regain my memories. And for that, I am grateful. ",shape=box,color=blue];
		j3615972620 -> j2414960068;
	j1013009726 [label="We have just begun to unlock the barest drips and drabs of what was locked away from me. I do not know what Albrecht told them of my crimes, Drifter. ",shape=box,color=blue];
		j1013009726 -> j1027596901;
	j147721831 [label="We have just begun to scratch the surface of what was locked away from me. I do not know what Albrecht told them of my crimes, Drifter.",shape=box,color=blue];
		j147721831 -> j1027596901;
	j3862842448 [label="I do not know what Albrecht told them of my crimes, for they are hidden even from me. The truth is hidden in my memories, Drifter.",shape=box,color=blue];
		j3862842448 -> j1027596901;
	j192548636 [label="Under the surface, I know you're, well, a raging inferno. And I know we need to get to a certain point before we can talk it through.",shape=box,color=red];
		j192548636 -> j3017659256;
	j3187108169 [label="And why would you trust me? All you know about me is that I... tampered with your memory.",shape=box,color=red];
		j3187108169 -> j2123062448;
	j969777671 [label="Well if you aren't going to be tedious, Drifter, why would I waste my time with you? I already have the zealots, and I'm seemingly required to spend time with them.",shape=box,color=blue];
		j969777671 -> j3866645924;
	j2110747143 [label="Ah, so she told you. Of course she did. Well, it is hardly my fault! Those damnable treats were the only good thing about that backwater hellhole of a city.",shape=box,color=blue];
		j2110747143 -> j1414734523;
		j2110747143 -> j696843067;
	j2337450666 [label="+5 Chemistry",color=orange];
		j2337450666 -> j687040345;
	j2414960068 [label="I need to know what was taken away from me, Drifter. I need to know what Albrecht robbed from me when he forced this serum upon me.",shape=box,color=blue];
		j2414960068 -> j1596346582;
		j2414960068 -> j284763936;
	j1027596901 [label=" I need to know what Albrecht robbed from me when he forced this serum upon me. I need to know what is locked away inside my head, Drifter. Whenever it isn't an inconvenience for you, of course...",shape=box,color=blue];
		j1027596901 -> j4199874711;
		j1027596901 -> j3973336266;
	j3017659256 [label="And why would I be angry, Drifter?",shape=box,color=blue];
		j3017659256 -> j607794458;
		j3017659256 -> j2428305900;
		j3017659256 -> j4141890421;
	j2123062448 [label="\"Tampered with my memory.\" Like I am some Ayatan Sculpture being toyed with as a prank. You did more than just tamper with my memory. You struck it clean.",shape=box,color=blue];
		j2123062448 -> j1573545008;
		j2123062448 -> j1453116408;
	j1414734523 [label="So it's true. You'd sneak off into Gaule to steal chocolates? Looking like...?",shape=box,color=red];
		j1414734523 -> j190769497;
	j696843067 [label="How did you get them, exactly?",shape=box,color=red];
		j696843067 -> j689227620;
	j687040345 [label="Ha! Good sport. Blasted chocolates were the only good thing about that backwater hellhole of a city.",shape=box,color=blue];
		j687040345 -> j2587844668;
	j1596346582 [label="I promise.",shape=box,color=red];
		j1596346582 -> j1980651524;
	j284763936 [label="We'll get there. But this takes time.",shape=box,color=red];
		j284763936 -> j4271232763;
	j4199874711 [label="I'll get there.",shape=box,color=red];
		j4199874711 -> j3258788273;
	j3973336266 [label="I'm trying. But you're not making it easy.",shape=box,color=red];
		j3973336266 -> j2915520287;
	j607794458 [label="You claimed you weren't angry at me for wiping your memories, but I know you're lying. Because... this isn't the first time I've done this.",shape=box,color=red];
		j607794458 -> j3294003058;
	j2428305900 [label="Because you loathe yourself over taking that serum willingly. You hate yourself, and that's making you furious - because you is all you have left.",shape=box,color=red];
		j2428305900 -> j671039560;
	j4141890421 [label="You claimed you weren't angry at me for wiping your memories, but I can't imagine how you wouldn't be furious.",shape=box,color=red];
		j4141890421 -> j671039560;
	j1573545008 [label="You didn't lose anything worth keeping, just our conversations.",shape=box,color=red];
		j1573545008 -> j3335241852;
	j1453116408 [label="But not of everything - only of our conversations here. You still have everything else, even the ones we recovered in The Descendia.",shape=box,color=red];
		j1453116408 -> j3335241852;
	j190769497 [label="Yes, with the blue skin, tail, infested flesh, and all. It is astonishing what a cloak, hat and a mask can do for you.",shape=box,color=blue];
		j190769497 -> j828982574;
	j689227620 [label="It was easy enough. Besides - as a \"protoframe\" and a battle-trained Orokin elite, I think I am capable enough to take some pastries from a market without alerting the authorities.",shape=box,color=blue];
		j689227620 -> j227144189;
	j2587844668 [label="Before you ask, it's a story best told by Marie, lest I have the zealots screaming and ranting at me again.",shape=box,color=blue];
		j2587844668 -> j3397211316;
	j1980651524 [label="Promises to the devil... a dangerous thing.",shape=box,color=blue];
		j1980651524 -> j3866645924;
	j4271232763 [label="And I am a patient devil.",shape=box,color=blue];
		j4271232763 -> j3866645924;
	j3258788273 [label="See that you do.",shape=box,color=blue];
		j3258788273 -> j3866645924;
	j2915520287 [label="Of course not! Where would the fun in that be?",shape=box,color=blue];
		j2915520287 -> j3866645924;
	j3294003058 [label="How wonderfully charming! And I am hardly even surprised! And what do I even care if that is the truth or not?! And besides which -",shape=box,color=blue];
		j3294003058 -> j671039560;
	j671039560 [label="Wrong! Breathtakingly, beautifully, blissfully wrong! Do not speak to me as though you know the intricacies of a rage I think you can so clearly not even begin to comprehend.",shape=box,color=blue];
		j671039560 -> j3514862716;
	j3335241852 [label="Do not dare to speak to me of what is valuable in my mind and what is not, Drifter. It is not yours over which to claim ownership.",shape=box,color=blue];
		j3335241852 -> j3514862716;
	j828982574 [label="Humans are quick to dismiss those they wish not to see. Besides - as a \"protoframe\" and a battle-trained Orokin elite, I think I am capable enough to take some pastries from a market without alerting the authorities.",shape=box,color=blue];
		j828982574 -> j4202875018;
	j227144189 [label="Yes, with the blue skin, tail, infested flesh, and all. It is astonishing what a cloak, hat and a mask can do for you.",shape=box,color=blue];
		j227144189 -> j4202875018;
	j3397211316 [label="They shout and yell at me about sin and how I am in need of repenting enough, without adding \"lying about my side of the story yet again\" to the pile.",shape=box,color=blue];
		j3397211316 -> j1918062745;
		j3397211316 -> j2958868449;
		j3397211316 -> j2350987449;
		j3397211316 -> j651943163;
	j4202875018 [label="Boolean RoatheMariePastry1 is now true.",color=orange];
		j4202875018 -> j690916714;
		j4202875018 -> j1942728004;
	j690916714 [label="But you brought back enough for Marie and Lyon?",shape=box,color=red];
		j690916714 -> j2142201040;
	j1942728004 [label="So you just stole the pastries.",shape=box,color=red];
		j1942728004 -> j1172663178;
	j2142201040 [label="Ah. You expected me to, what, take enough just for myself and leave them without? Why, simply because I do not enjoy their company and wish to rid myself of them?",shape=box,color=blue];
		j2142201040 -> j2197962567;
	j1172663178 [label="Everything on that planet was going to shortly belong to the Orokin Empire. It was mine by right, anyway.",shape=box,color=blue];
		j1172663178 -> j3367317834;
	j2197962567 [label="You think that my dislike of them somehow necessitates that I also be cruel to them. Because I am a devil, and, therefore, prone to such acts, is the reasoning that follows.",shape=box,color=blue];
		j2197962567 -> j4007601479;
	j3367317834 [label="Besides, I had no money. What did you expect me to do?",shape=box,color=blue];
		j3367317834 -> j386527546;
	j4007601479 [label="How utterly disappointing. Shallow acts like that are reserved for the extremely dull and the schoolyard bully. ",shape=box,color=blue];
		j4007601479 -> j349712165;
	j386527546 [label="And I know you stampede your way through ships and take whatever it is you need or want - do not bat your innocent eyes at me, Usurper.",shape=box,color=blue];
		j386527546 -> j991049834;
		j386527546 -> j3189121654;
	j349712165 [label="I hate them. Yet I have to coexist with them. I do not wish them to be deprived of a silly pastry. It is a pastry. Why worsen matters so needlessly?",shape=box,color=blue];
		j349712165 -> j3216881872;
		j349712165 -> j3883575062;
		j349712165 -> j2796378981;
	j991049834 [label="Never mind. ",shape=box,color=red];
		j991049834 -> j563661257;
	j3189121654 [label="Fair point, I guess.",shape=box,color=red];
		j3189121654 -> j318174657;
	j3216881872 [label="Or, you could try being kind to them for the sake of it.",shape=box,color=red];
		j3216881872 -> j2358228239;
	j3883575062 [label="So, just to be clear - you were being nice, because you hate them.",shape=box,color=red];
		j3883575062 -> j1940759081;
	j2796378981 [label="I never thought about it that way, I guess.",shape=box,color=red];
		j2796378981 -> j1941174391;
	j563661257 [label="Fantastic. Another one who is incapable of conceding a point. As if the zealots weren't enough, screaming at me at all hours, begging me to repent.",shape=box,color=blue];
		j563661257 -> j1918062745;
		j563661257 -> j2958868449;
		j563661257 -> j2350987449;
		j563661257 -> j651943163;
	j318174657 [label="+5 Chemistry",color=orange];
		j318174657 -> j1807795856;
	j2358228239 [label="Yes, try having them buzzing about your ears all hours of every day and night cursing your name and crying at you to repent.",shape=box,color=blue];
