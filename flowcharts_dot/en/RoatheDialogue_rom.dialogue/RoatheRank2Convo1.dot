	802 [label="I know we are at the limit, I can feel the strain of my mind fighting against me. You are doing the best you can to help me regain my memories. And for that, I am grateful. ",shape=box,color=blue];
		802 -> 813;
	803 [label="We have just begun to unlock the barest drips and drabs of what was locked away from me. I do not know what Albrecht told them of my crimes, Drifter. ",shape=box,color=blue];
