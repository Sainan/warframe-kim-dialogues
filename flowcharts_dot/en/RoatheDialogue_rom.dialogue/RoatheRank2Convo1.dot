		j1201743634 -> j2018207743;
	j2322312000 [label="How very Orokin of you.",shape=box,color=blue];
		j2322312000 -> j223135574;
	j1563784489 [label="How very Orokin of you.",shape=box,color=blue];
		j1563784489 -> j4273879934;
