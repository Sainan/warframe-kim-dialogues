		j216863090 -> j2694130358 [label="false",color=purple];
	j2875350431 [label="I find it so terribly fascinating that you schemed with me to... arrange my own path. The devil deals in his own flesh, as it were.",shape=box,color=blue];
		j2875350431 -> j4118653242;
	j3040500673 [label="How goes progress on your end, my Usurper? I busily pull strings and levers in your favor, though my influence may be unseen and unfelt thus far.",shape=box,color=blue];
		j3040500673 -> j4118653242;
	j1123061095 [label="Tell me that you have changed your mind regarding my offer. Where I might have proved a barrier of resistance before, regarding your... romantic goals? Now, I shall be as docile as a snow terrisk. Hmm. Unless that is not what you desire. You can be the decider of that.",shape=box,color=blue];
		j1123061095 -> j4195590714;
	j4274911833 [label="Tell me that you have changed your mind regarding my offer. I can solve this Marie problem for you. Ensure that you navigate to your romantic goals with her with ease.",shape=box,color=blue];
		j4274911833 -> j4195590714;
	j3352727399 [label="Tell me that you have changed your mind regarding my offer. I can solve this Lyon problem for you. Ensure that you navigate to your romantic goals with him with ease.",shape=box,color=blue];
		j3352727399 -> j4195590714;
	j582445024 [label="Tell me that you have changed your mind regarding my offer. Where I might have proved a barrier of resistance before, regarding my... taking of the serum? I will prove as docile as a snow terrisk.",shape=box,color=blue];
		j582445024 -> j4195590714;
	j1245397613 [label="Tell me that you have changed your mind regarding my offer. Where I might have proved a barrier of resistance before, reuniting the butler and his family? I will prove as docile as a snow terrisk.",shape=box,color=blue];
		j1245397613 -> j4195590714;
	j1578852357 [label="Tell me that you have changed your mind regarding my offer - I can solve this Marie problem for you. Ensure that you navigate your conversations with her with ease.",shape=box,color=blue];
		j1578852357 -> j4195590714;
	j774990038 [label="Tell me that you have changed your mind regarding my offer - I can solve this Lyon problem for you. Ensure that you navigate your conversations with him with ease.",shape=box,color=blue];
		j774990038 -> j4195590714;
	j4096163837 [label="I cannot help but think that you are lingering in these conversations of ours for a reason, Usurper. And that it might be something I can help you with.",shape=box,color=blue];
		j4096163837 -> j2639682456;
	j2694130358 [label="Evaluate expressions on HellStory counter",color=orange];
		j2694130358 -> j3869625108 [label="x >= 21",color=purple];
		j2694130358 -> j2075111951 [label="x < 21",color=purple];
		j2694130358 -> j2075111951 [label="false",color=purple];
	j4118653242 [label="It is an odd challenge from my perspective, to only be operating with part of my memories intact and knowing you hold the other half of the deck in your hand.",shape=box,color=blue];
		j4118653242 -> j4015830994;
	j4195590714 [label="But all this... milling about that you are doing? It is merely wasting time. So come now. Say the word. And your problem will be solved.",shape=box,color=blue];
		j4195590714 -> j77183960;
		j4195590714 -> j3240686939;
	j2639682456 [label="Tell me what you're after, and let us come to an agreement. All this... milling about is merely wasting time.",shape=box,color=blue];
		j2639682456 -> j2953660143;
	j2075111951 [label="Evaluate expressions",color=orange];
		j2075111951 -> j2171603518 [label="RoatheDeal",color=purple];
		j2075111951 -> j102000582 [label="RoatheNoDeal",color=purple];
		j2075111951 -> j102000582 [label="false",color=purple];
	j4015830994 [label="So I shall just carry on, then, for lack of anything better to do. \"How goes it with our little floating sycophant, by the by? I take it the priest is still not speaking to you.\" Bah. What a farce.",shape=box,color=blue];
		j4015830994 -> j926850260;
		j4015830994 -> j511563311;
		j4015830994 -> j1014455088;
	j77183960 [label="No. I'm sorry. I don't make arrangements with Orokin. Not then, not now, not ever.",shape=box,color=red];
		j77183960 -> j838671903;
	j3240686939 [label="I really hope you don't make me regret this, Roathe. Fine. Agreed. I need your help.",shape=box,color=red];
		j3240686939 -> j1876832257;
	j2953660143 [label="Check boolean LoidFamilyComplete",color=orange];
