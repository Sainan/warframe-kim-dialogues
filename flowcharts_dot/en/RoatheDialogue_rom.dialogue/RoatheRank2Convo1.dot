		j1876832257 -> j4170632380 [label="RoatheLyonConfessionDealNo",color=purple];
		j1876832257 -> j1231027373 [label="false",color=purple];
	j432382584 [label="Lyon has... there's so much he's dealing with. And I don't know how to get through it all.",shape=box,color=red];
		j432382584 -> j4140125890;
	j1378222389 [label="Marie won't see Entrati for what he is. And I cannot get her to see the truth of it, no matter what I do.",shape=box,color=red];
		j1378222389 -> j4030764894;
	j963473320 [label="Well, you see, you have this whole... thing about why you took the serum, and I... said the wrong things at the wrong times.",shape=box,color=red];
		j963473320 -> j2696378933;
	j304545581 [label="It might be a little embarrassing, but... I have feelings for one of you three.",shape=box,color=red];
		j304545581 -> j3553461153;
		j304545581 -> j456479209;
		j304545581 -> j1130953151;
	j475786744 [label="I am trying to get you and the others to help me reunite Loid with the family upstairs and... I... couldn't...",shape=box,color=red];
		j475786744 -> j3918720428;
	j568971278 [label="No, Lyon... doesn't seem to talk much.",shape=box,color=red];
		j568971278 -> j4181519821;
	j2087445063 [label="I'm getting on well with Marie. Why do you call her a sycophant?",shape=box,color=red];
		j2087445063 -> j3110192734;
	j2544677686 [label="You don't seem to like them very much. Why?",shape=box,color=red];
		j2544677686 -> j81386535;
	j3822298111 [label="No. I'm sorry. I don't make agreements with Orokin. Not then, not now, not ever.",shape=box,color=red];
		j3822298111 -> j1942911382;
	j152445645 [label="I really hope you don't make me regret this, Roathe. Fine. Agreed.",shape=box,color=red];
		j152445645 -> j221037881;
	j1031925304 [label="\"So far.\" Intriguing. And we really are all just retracing our steps, like courtiers echoing the moves of a dance? Again and again, doomed to repeat ourselves?",shape=box,color=blue];
		j1031925304 -> j2932790564;
		j1031925304 -> j1546742368;
	j3321315650 [label="I suppose you would know, wouldn't you? Interesting that it is so predictable. Nice to know even someone as shattered as he is, can still be counted upon now and then.",shape=box,color=blue];
		j3321315650 -> j3532872981;
	j662852507 [label="Don't you already know? Mm. Perhaps you did not make it that far. Or you did not think to ask the first or twenty-thousandth time through this little romp.",shape=box,color=blue];
		j662852507 -> j3532872981;
	j113242122 [label="Oh. And one more thing, before I forget?",shape=box,color=blue];
		j113242122 -> j1928402330;
	j1052217618 [label="How you have truly sold your soul to the devil and twice over... making an arrangement to ensure I take you to my bed? Or are you after my heart, Usurper? Mm. We shall see. But in time.",shape=box,color=blue];
		j1052217618 -> j926694468;
	j4266297471 [label="When the time comes, I shall ensure your path is clear to woo our little floating sycophant, Usurper. Consider it dealt with.",shape=box,color=blue];
		j4266297471 -> j926694468;
	j3537689908 [label="When the time comes, I shall ensure your path is clear to woo the poor shattered priest, Usurper. Consider it dealt with.",shape=box,color=blue];
		j3537689908 -> j121818852;
	j2239222002 [label="When the time comes, I shall remember this. Should we have a further disagreement about my memories, we shall not repeat your previous mistakes.",shape=box,color=blue];
		j2239222002 -> j2085775682;
	j49853574 [label="When the time comes, I will ensure that little butler walks up those stairs. Consider it dealt with.",shape=box,color=blue];
		j49853574 -> j926694468;
	j1622804986 [label="Consider your issue with Marie and her sycophantic adoration of Entrati dealt with. When the time comes, I shall handle it.",shape=box,color=blue];
		j1622804986 -> j3462266243;
	j4170632380 [label="Consider your issue with Lyon and his horrors dealt with, Usurper. When the time comes, I shall handle it.",shape=box,color=blue];
		j4170632380 -> j4269396371;
	j1231027373 [label="I... appear to have forgotten what it was you were after. Blame your meddling with my memories. What was it again?",shape=box,color=blue];
		j1231027373 -> j2953660143;
	j4140125890 [label="I would council simple patience instead, but... far be it from me to advise you to use a chisel when there is a laser pick sitting next to you.",shape=box,color=blue];
		j4140125890 -> j2995668280;
	j4030764894 [label="Hm. I see. A noble endeavor, if I am being honest. One that I have attempted myself many, many times over. And failed equally so.",shape=box,color=blue];
		j4030764894 -> j464502831;
	j2696378933 [label="Hm.",shape=box,color=blue];
		j2696378933 -> j3852084340;
	j3553461153 [label="Lyon.",shape=box,color=red];
		j3553461153 -> j1045097103;
	j456479209 [label="... You.",shape=box,color=red];
		j456479209 -> j1353142197;
	j1130953151 [label="Marie.",shape=box,color=red];
		j1130953151 -> j3924947113;
	j3918720428 [label="Hm. I see. I offered you an arrangement, and you could not hold up your end of the bargain somehow, so you saw your prize fade from view.",shape=box,color=blue];
		j3918720428 -> j1171129388;
	j4181519821 [label="When he does speak, it generally falls into two categories - horrifically inane or horrifically insane.",shape=box,color=blue];
		j4181519821 -> j1246947180;
	j3110192734 [label="Hm? Have you escaped it thus far? I am so terribly envious of you. It won't be long before you are caught up in the blast radius however, so it's best you have fair warning.",shape=box,color=blue];
		j3110192734 -> j727160247;
	j81386535 [label="My poor Drifter. Have you forgotten how strictly we Orokin rejected any sense of holy deities? The only thing we worshiped was ourselves.",shape=box,color=blue];
		j81386535 -> j507127564;
	j1942911382 [label="As you wish. I warn you, this decision of yours cannot be undone without consequences.",shape=box,color=blue];
		j1942911382 -> j3004451806;
	j221037881 [label="You behave and help me get Loid to go upstairs and reconcile with the family? And I'll help you sort out your memories.",shape=box,color=red];
		j221037881 -> j2170049129;
	j2932790564 [label="It doesn't mean you lack agency. It just means some things take a few more tries.",shape=box,color=red];
		j2932790564 -> j3403619673;
	j1546742368 [label="I hope it doesn't upset you.",shape=box,color=red];
		j1546742368 -> j2315471601;
	j3532872981 [label="Are we truly all doomed to repeat ourselves, like courtiers echoing the moves of a dance?",shape=box,color=blue];
		j3532872981 -> j2932790564;
		j3532872981 -> j1546742368;
	j1928402330 [label="Not so very long ago, I trusted you with a horrible truth. Now I cannot remember why.",shape=box,color=blue];
		j1928402330 -> j3936514315;
	j926694468 [label="Boolean RoatheFamilyDealNo is now false.",color=orange];
		j926694468 -> j2376422441;
