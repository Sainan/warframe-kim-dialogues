	j4269396371 [label="Boolean RoatheLyonConfessionDealNo is now false.",color=orange];
		j4269396371 -> j2107652340;
	j2995668280 [label="I think I am also starting to understand why you have wiped our minds clean. Seeing all your failed attempts and endeavors... why not strike the board and try again?",shape=box,color=blue];
		j2995668280 -> j1201743634;
	j464502831 [label="Seeing in frustration that you could no longer convince her of the simple truth of things, you resorted to that which was - using this... gift of yours.",shape=box,color=blue];
		j464502831 -> j2322312000;
	j3852084340 [label="I do not appreciate you fouling my mind to fix your mistakes, Drifter. However, that you are attempting to do it for my sake is... I suppose, somehow, acceptable.",shape=box,color=blue];
		j3852084340 -> j1563784489;
	j1045097103 [label="Boolean DrifterLyon is now true.",color=orange];
		j1045097103 -> j773999891;
	j1353142197 [label="Boolean DrifterRoathe is now true.",color=orange];
		j1353142197 -> j2170421206;
	j3924947113 [label="Boolean DrifterMarie is now true.",color=orange];
		j3924947113 -> j190051100;
	j1171129388 [label="So, knowing you could no longer achieve that which was previously in your grasp, you resorted to that which was - using this... gift of yours.",shape=box,color=blue];
		j1171129388 -> j769180499;
	j1246947180 [label="It is always a flip of the coin which one you're liable to get, and I can never decide which one I prefer more.",shape=box,color=blue];
		j1246947180 -> j1791053690;
	j727160247 [label="That woman is interminable in her unwavering and obsessive dedication for Albrecht. I would say the butler should be worried, but I honestly firmly believe it is an innocent devotion. And this is coming from me.",shape=box,color=blue];
		j727160247 -> j2545800578;
	j507127564 [label="Those two zealots cannot go two minutes without \"Sol\" this or \"Lua\" that or without trying to bless the piss pot.",shape=box,color=blue];
		j507127564 -> j2719350922;
	j3004451806 [label="Boolean RoatheFamilyFail is now true.",color=orange];
		j3004451806 -> j1098002312;
	j2170049129 [label="+5 Chemistry",color=orange];
		j2170049129 -> j130497891;
	j3403619673 [label="I am amused by your optimism. Heroes. That's all you people are, I swear. Bags of meat and bone inflated and operated purely by optimism and hope. It's enough to make your teeth rot.",shape=box,color=blue];
		j3403619673 -> j3541932656;
	j2315471601 [label="No, you misunderstand me. In a way, I find it comforting. It means that even when you strip us down to our bare components, we are still the same. We cannot change.",shape=box,color=blue];
		j2315471601 -> j2631304166;
	j3936514315 [label="You are both the one soul I may have ever hoped to trust... and the reason I now cannot recall why I had dared.",shape=box,color=blue];
		j3936514315 -> j524649683;
	j2376422441 [label="Boolean RoatheFamilyDeal is now true.",color=orange];
		j2376422441 -> j2271527703;
