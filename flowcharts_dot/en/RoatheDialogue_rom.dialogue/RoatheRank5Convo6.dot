	j1494945655 [label="But the other reason why relations have improved between us?",shape=box,color=blue];
		j1494945655 -> j2933620971;
	j3650784721 [label="Hm. Perhaps I will attempt to replicate the recipe here. But, either way, I will do what I can to keep the peace. Well. Mostly.",shape=box,color=blue];
		j3650784721 -> j135803434;
	j802523954 [label="+10 Chemistry",color=orange];
		j802523954 -> j2293378198;
	j3359650490 [label="I told them, Drifter darling.",shape=box,color=blue];
		j3359650490 -> j4131114853;
	j729678418 [label="Nor was I claiming that you did, Drifter darling. I told them.",shape=box,color=blue];
		j729678418 -> j4131114853;
	j3089535758 [label="It is just another thing for which I must make amends. They would learn the truth eventually, regardless. Better they hear it from my own lips.",shape=box,color=blue];
		j3089535758 -> j2023023692;
		j3089535758 -> j1851419478;
	j2927099560 [label="I have nothing to be ashamed of. It seemed pointless to hide it. They would learn the truth somehow, soon enough. Better they hear it from my own lips.",shape=box,color=blue];
		j2927099560 -> j2023023692;
		j2927099560 -> j1851419478;
	j428656984 [label="They would learn the truth eventually, regardless. Better they hear it from my own lips.",shape=box,color=blue];
		j428656984 -> j2023023692;
		j428656984 -> j1851419478;
	j135803434 [label="+10 Chemistry",color=orange];
		j135803434 -> j2732975578;
	j2293378198 [label="I will do what I can not to ruin everything for you, hm? Well. Naught that can't be repaired. Can't make your days too dull, you might go mad like the priest.",shape=box,color=blue];
		j2293378198 -> "Chat ends.";
