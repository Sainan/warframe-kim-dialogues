		j1172864870 -> j3902810082 [label="false",color=purple];
	j2813753334 [label="Evaluate expressions",color=orange];
		j2813753334 -> j3202869338 [label="RoatheVillain",color=purple];
		j2813753334 -> j3113108381 [label="RoatheRedeemed",color=purple];
		j2813753334 -> j1691220130 [label="false",color=purple];
	j2804883332 [label="What do I think about Marie? Besides attempting to convince you to let her join us for a night or two, Drifter dear? (I jest. I jest.)",shape=box,color=blue];
		j2804883332 -> j349703282;
	j1069579400 [label="What do I think about Marie? Besides attempting to convince you to let me join in for a night or two? (I jest. I jest.)",shape=box,color=blue];
		j1069579400 -> j424902374;
	j884775091 [label="However did you manage to convince her to change her mind on Albrecht's purity? Quite the \"miracle worker\" you are. Perhaps they should not be worshipping Sol and Lua, but you.",shape=box,color=blue];
		j884775091 -> j2300166066;
	j584960488 [label="I never knew that she is still in daily pain. She hides it as though it is not there. She did not speak of it until she told you. You have bridged some manner of gap between us.",shape=box,color=blue];
		j584960488 -> j2057004046;
	j4036644076 [label="I did not know of her upbringing until recently. She never told me her story until she told it to you. You have bridged some manner of gap between us.",shape=box,color=blue];
		j4036644076 -> j120477537;
	j3961303391 [label="The same as per usual. I am spending every waking moment attempting not to peel my own face off with my claws out of a desperate desire to drown her out.",shape=box,color=blue];
		j3961303391 -> "Chat ends.";
	j3854774697 [label="Better now that I have someone with whom to vent my frustrations upon. But in all seriousness, tensions between us are much improved.",shape=box,color=blue];
		j3854774697 -> j2933620971;
	j1373353519 [label="I am not the one who is \"getting on\" with Lyon, now am I? Ha! Pardon the awful joke. I cannot help myself, and you made that far too easy.",shape=box,color=blue];
		j1373353519 -> j1460520493;
	j3082352283 [label="Better than it seems you and he have managed. How have you bungled it with him? All he needed was someone to listen to him. ",shape=box,color=blue];
		j3082352283 -> j910777340;
	j2254906829 [label="Tensions between us are much improved, particularly since you have given him the confidence to speak of what has been ailing him.",shape=box,color=blue];
		j2254906829 -> j1695530978;
	j3271055028 [label="Tensions between us are much improved, particularly since you have given him the confidence to speak of what has been ailing him.",shape=box,color=blue];
		j3271055028 -> j1584480695;
	j3902810082 [label="The same as per usual. I am spending every waking moment attempting not to peel my own face off with my claws out of a desperate desire to drown him out.",shape=box,color=blue];
		j3902810082 -> "Chat ends.";
	j3202869338 [label="I admit I am finding them, little by little, slightly more tolerable. I think largely because, little by little, they are giving up on me.",shape=box,color=blue];
		j3202869338 -> j4085553423;
	j3113108381 [label="I admit I am finding them, little by little, slightly more tolerable. I think my recent revelations might have something to do with that.",shape=box,color=blue];
		j3113108381 -> j632232542;
	j1691220130 [label="I find myself, more and more, wondering that although I cannot use the Dark Refractory to recover my memories as I am now a Protoframe...",shape=box,color=blue];
		j1691220130 -> j1397115854;
	j349703282 [label="I wonder if she realizes that my goading has turned from honest annoyance into teasing in good fun?",shape=box,color=blue];
		j349703282 -> j3160362414;
	j424902374 [label="I must admit I do not blame you in the slightest. And not simply because she is gorgeous. I have eyes. That woman has more compassion in her than I would have expected to survive to her age.",shape=box,color=blue];
		j424902374 -> j349703282;
	j2300166066 [label="Bah. It is that kind of language that led to the rise of the Orokin Empire. That is a mistake this System should never make twice.",shape=box,color=blue];
		j2300166066 -> j349703282;
	j2057004046 [label="I admit I am one of the fools she speaks of, who cannot wrap their minds around living in such a way, day in and day out.",shape=box,color=blue];
		j2057004046 -> j1329138762;
	j120477537 [label="To think her family threw her onto the streets. Her. Marie. That Marie. The one with more compassion in her than should be possible?!",shape=box,color=blue];
		j120477537 -> j1498110484;
	j2933620971 [label="They know my... secret. The truth of my taking of the serum willingly.",shape=box,color=blue];
		j2933620971 -> j4056042800;
		j2933620971 -> j3015450732;
	j1460520493 [label="I commend you for braving that poor madman. He needs the company. And the compassion.",shape=box,color=blue];
		j1460520493 -> j654399265;
	j910777340 [label="Yet you shut him out. Shame on you.",shape=box,color=blue];
		j910777340 -> "Chat ends.";
	j1695530978 [label="He spoke to me of the Tenno child he had been hearing. And how he does not hear him any longer.",shape=box,color=blue];
		j1695530978 -> j3001904175;
	j1584480695 [label="I knew shockingly little of what had been done to him. It was not until he told you, that he had the willingness to tell me. ",shape=box,color=blue];
		j1584480695 -> j3062059940;
	j4085553423 [label="I tease. I am growing oddly fond of them, despite my renewed commitment to shut out their criticism of my decisions in life.",shape=box,color=blue];
		j4085553423 -> j121942355;
		j4085553423 -> j2394944004;
	j632232542 [label="I expected them to greet my penitence with mockery, with jeers of \"finally, he sees the light\" or \"we told you so.\" Anything but. They have hardly made mention of it.",shape=box,color=blue];
		j632232542 -> j2801718971;
	j1397115854 [label="...if that does not yet preclude me from drowning myself in it.",shape=box,color=blue];
		j1397115854 -> "Chat ends.";
	j3160362414 [label="I hope so. It is too much fun to pester her. Watching her grow angry and shout at me in her native tongue is my new favorite sport.",shape=box,color=blue];
		j3160362414 -> j1407112933;
	j1329138762 [label="How can she maintain such composure? Let alone compassion? I think I would have gone as mad as the priest in her condition.",shape=box,color=blue];
		j1329138762 -> j349703282;
	j1498110484 [label="I cannot describe to you my desire to use a Helminth to travel back in time to murder her entire family. Slowly. But she would likely object to that. ",shape=box,color=blue];
		j1498110484 -> j962415589;
	j4056042800 [label="I didn't tell them.",shape=box,color=red];
		j4056042800 -> j3299783285;
	j3015450732 [label="How did they find out?",shape=box,color=red];
		j3015450732 -> j1356810958;
	j654399265 [label="But in all seriousness, tensions between us are much improved.",shape=box,color=blue];
		j654399265 -> j2933620971;
	j3001904175 [label="I expect the voice will haunt him in his waking nightmares, all the same. That poor man will always question the line between reality and fiction.",shape=box,color=blue];
		j3001904175 -> j3170310757;
	j3062059940 [label="I cannot describe to you my desire to use a Helminth to travel back in time to murder his parents. Slowly. But I fear he might object to that.",shape=box,color=blue];
		j3062059940 -> j2169647584;
	j121942355 [label="You three are stuck together anyway. Entrati saw to that. So, no harm in making the best of it.",shape=box,color=red];
		j121942355 -> j1172017267;
	j2394944004 [label="I'm glad. I think they honestly care about you.",shape=box,color=red];
		j2394944004 -> j4025967464;
	j2801718971 [label="I am glad they have not. I do not want my nose rubbed in it like a pup who has messed the carpet. I have enough to dwell on as it is.",shape=box,color=blue];
		j2801718971 -> j121942355;
		j2801718971 -> j2394944004;
	j1407112933 [label="Another reason matters are improved between us? They know my secret. The truth of my taking the serum willingly.",shape=box,color=blue];
		j1407112933 -> j1720091814;
		j1407112933 -> j3894425732;
	j962415589 [label="Revenge killings are likely frowned upon by Sol, etcetera, etcetera. ",shape=box,color=blue];
		j962415589 -> j349703282;
	j3299783285 [label="Nor was I claiming that you did, Drifter darling. I told them.",shape=box,color=blue];
		j3299783285 -> j1806500125;
	j1356810958 [label="I told them, Drifter darling.",shape=box,color=blue];
		j1356810958 -> j1806500125;
	j3170310757 [label="Another reason matters are improved between us?",shape=box,color=blue];
		j3170310757 -> j2933620971;
	j2169647584 [label="Revenge killings are likely frowned upon by Lua, etcetera, etcetera. ",shape=box,color=blue];
		j2169647584 -> j1494945655;
	j1172017267 [label="Precisely. No sense in making enemies of one's new housemates. That was exactly why I kept stealing those pastries back in Gaule.",shape=box,color=blue];
		j1172017267 -> j3650784721;
	j4025967464 [label="Despite my best efforts, yes. And it boggles the mind. Yet here are, all the same.",shape=box,color=blue];
		j4025967464 -> j802523954;
	j1720091814 [label="How did they find out?",shape=box,color=red];
		j1720091814 -> j3359650490;
	j3894425732 [label="I didn't tell them.",shape=box,color=red];
		j3894425732 -> j729678418;
