		j1072643156 -> j3670222271;
		j1072643156 -> j120520872;
	j2173484742 [label="I have nothing to be ashamed of. It seemed pointless to hide it. They would learn the truth somehow, soon enough. Better they hear it from my own lips.",shape=box,color=blue];
		j2173484742 -> j3670222271;
		j2173484742 -> j120520872;
