		j2140900457 -> j3670222271;
		j2140900457 -> j120520872;
	j3167573562 [label="I expected them to greet my shame with mockery, with jeers of \"finally, the devil is brought low.\" Anything but. They have hardly made mention of it.",shape=box,color=blue];
		j3167573562 -> j3419132174;
	j1086262298 [label="Not how I would have expected. When I was reading silently by myself one evening, a few nights later, he approached on his own.",shape=box,color=blue];
		j1086262298 -> j725425518;
	j3670222271 [label="Has anything changed because of it?",shape=box,color=red];
		j3670222271 -> j3338843033;
	j120520872 [label="How did Marie react?",shape=box,color=red];
		j120520872 -> j3879683701;
	j3419132174 [label="Particularly Lyon. I think he understands the difficulty of facing down the past and the decisions we have made. See: eyepatch, if you will pardon the pun.",shape=box,color=blue];
		j3419132174 -> j32725969;
	j725425518 [label="He sat down beside me and told me of how he has questioned his faith ever since Entrati gave him the serum. How he was ashamed of his questioning. How he regretted taking the serum.",shape=box,color=blue];
		j725425518 -> j2235548277;
	j3338843033 [label="I expected them to greet my shame with mockery, with jeers of \"finally, the devil is brought low.\" Anything but. They have hardly made mention of it.",shape=box,color=blue];
		j3338843033 -> j672751827;
	j3879683701 [label="Not how I would have expected. She said nothing. Instead, she simply... hugged me. ",shape=box,color=blue];
		j3879683701 -> j598317519;
	j32725969 [label="Check boolean LyonConfession2",color=orange];
		j32725969 -> j1271598608 [label=true,color=green];
		j32725969 -> j1116350588 [label=true,color=green];
		j32725969 -> j1116350588 [label=false,color=brown];
	j2235548277 [label="Most importantly, how he wished he could forget it all. And that perhaps, on some deeper level, we were all the same, the three of us.",shape=box,color=blue];
		j2235548277 -> j194016738;
		j2235548277 -> j2664976769;
	j672751827 [label="Particularly Marie. I think she understands that continually confronting me over matters of the past will do no good.",shape=box,color=blue];
		j672751827 -> j3137425038;
	j598317519 [label="Evaluate expressions",color=orange];
		j598317519 -> j2399968049 [label="RoatheRedeemed",color=purple];
		j598317519 -> j3387968785 [label="RoatheVillain",color=purple];
		j598317519 -> j998471481 [label="false",color=purple];
	j1271598608 [label="I think he also knows what it's like to be a product of your society and your context. He might sympathize more with your past than you think.",shape=box,color=red];
		j1271598608 -> j686490258;
	j1116350588 [label="I am just simply glad you two have found any kind of friendship at all. Even if it is just a ceasefire. ",shape=box,color=red];
		j1116350588 -> j465085549;
	j194016738 [label="What did you do?",shape=box,color=red];
		j194016738 -> j2786609123;
	j2664976769 [label="What about Marie?",shape=box,color=red];
		j2664976769 -> j2507797264;
	j3137425038 [label="Check boolean MarieEntratiCompleteA",color=orange];
		j3137425038 -> j4279517996 [label=true,color=green];
		j3137425038 -> j2263005775 [label=true,color=green];
		j3137425038 -> j2263005775 [label=false,color=brown];
	j2399968049 [label="The Roathe of Old would have used the opportunity to remove her kidneys from her body, but I found I no longer had the desire to do so. ",shape=box,color=blue];
		j2399968049 -> j1773945151;
	j3387968785 [label="It took every ounce of willpower not to remove her kidneys from her body. But she meant only to offer me simple comfort.",shape=box,color=blue];
		j3387968785 -> j642736248;
	j998471481 [label="She meant only to offer me simple comfort.",shape=box,color=blue];
		j998471481 -> j809892866;
		j998471481 -> j2417445170;
	j686490258 [label="+10 Chemistry",color=orange];
		j686490258 -> j2531029197;
	j465085549 [label="+5 Chemistry",color=orange];
		j465085549 -> j1094183234;
	j2786609123 [label="I shook his hand. And I thanked him as a friend. I am an Orokin, but I am not a monster.",shape=box,color=blue];
		j2786609123 -> j1595761694;
	j2507797264 [label="When I told her the truth that we learned, she said nothing. Instead, she simply... hugged me.",shape=box,color=blue];
		j2507797264 -> j1093047434;
	j4279517996 [label="Especially after everything she's learned about Entrati. She knows that people can be more complicated than simple black and white.",shape=box,color=red];
		j4279517996 -> j1276217154;
	j2263005775 [label="I am just simply glad you two have found any kind of friendship at all. Even if it is just a ceasefire.",shape=box,color=red];
		j2263005775 -> j1293481049;
	j1773945151 [label="For once in my miserable life, I accepted the simple offer of comfort for what it was.",shape=box,color=blue];
		j1773945151 -> j642736248;
	j642736248 [label="It was a simple way of telling me that perhaps she did not care nearly as much as I did. And that she was sorry for all the pain I had put myself through over it.",shape=box,color=blue];
		j642736248 -> j809892866;
		j642736248 -> j2417445170;
	j809892866 [label="What about Lyon?",shape=box,color=red];
		j809892866 -> j2237892721;
	j2417445170 [label="What did you do?",shape=box,color=red];
		j2417445170 -> j1224094047;
	j2531029197 [label="I am afraid you are likely right. He was dealt a terrible hand by fate, and he has done all he can to withstand it.",shape=box,color=blue];
		j2531029197 -> j1924541518;
	j1094183234 [label="I think in the end it will prove to be more than that. Even if I despise that fact. I cannot help but be trapped with them, after all.",shape=box,color=blue];
		j1094183234 -> j1924541518;
	j1595761694 [label="Since then?",shape=box,color=blue];
		j1595761694 -> j758635786;
	j1093047434 [label="Evaluate expressions",color=orange];
		j1093047434 -> j2199243932 [label="RoatheRedeemed",color=purple];
		j1093047434 -> j3760554028 [label="RoatheVillain",color=purple];
		j1093047434 -> j475790982 [label="false",color=purple];
	j1276217154 [label="+10 Chemistry",color=orange];
		j1276217154 -> j3457122744;
	j1293481049 [label="+5 Chemistry",color=orange];
		j1293481049 -> j1868517803;
	j2237892721 [label="When I was reading silently by myself one evening, a few nights later, he approached on his own.",shape=box,color=blue];
		j2237892721 -> j2831581805;
	j1224094047 [label="I embraced her in return, of course. I am an Orokin, but I am not a monster.",shape=box,color=blue];
		j1224094047 -> j667712612;
	j1924541518 [label="That priest. If I will end on a single note, I will let it be this: his resilience is somehow as endless as time itself. ",shape=box,color=blue];
		j1924541518 -> j321225626;
	j758635786 [label="He has barely made mention of any of it. Which I am deeply grateful for. I expected jeers and mockery. \"Finally, the devil is brought low.\" Anything but. They have gone on as though little has changed.",shape=box,color=blue];
		j758635786 -> j3419132174;
	j2199243932 [label="The Roathe of Old would have used the opportunity to remove her kidneys from her body, but I found I no longer had the desire to do so. ",shape=box,color=blue];
		j2199243932 -> j1041898643;
	j3760554028 [label="It took every ounce of willpower not to remove her kidneys from her body. But she meant only to offer me simple comfort.",shape=box,color=blue];
		j3760554028 -> j3154470196;
	j475790982 [label="She meant only to offer me simple comfort.",shape=box,color=blue];
		j475790982 -> j1248135392;
	j3457122744 [label="Indeed. And I have you to thank for that, don't I?",shape=box,color=blue];
		j3457122744 -> j2923293728;
	j1868517803 [label="I think in the end it will prove to be more than that. Even if I despise that fact. I cannot help but be trapped with them, after all.",shape=box,color=blue];
		j1868517803 -> j2923293728;
	j2831581805 [label="He sat down beside me and told me of how he has questioned his faith ever since Entrati gave him the serum. How he was ashamed of his questioning. How he regretted taking the serum.",shape=box,color=blue];
		j2831581805 -> j1424931481;
	j667712612 [label="Since then?",shape=box,color=blue];
		j667712612 -> j3036074794;
	j321225626 [label="For a man who has shattered, he has yet to fall apart.",shape=box,color=blue];
		j321225626 -> j1622505995;
	j1041898643 [label="For once in my miserable life, I accepted the simple offer of comfort for what it was.",shape=box,color=blue];
		j1041898643 -> j3154470196;
	j3154470196 [label="It was a simple way of telling me that perhaps she did not care nearly as much as I did. And that she was sorry for all the pain I had put myself through over it.",shape=box,color=blue];
		j3154470196 -> j1248135392;
	j1248135392 [label="Since then?",shape=box,color=blue];
		j1248135392 -> j988990889;
	j2923293728 [label="That Sister of Sol. If I will end on a single note, I will let it be this: her kindness is somehow as endless as time itself.",shape=box,color=blue];
		j2923293728 -> j2412048728;
	j1424931481 [label="Most importantly, how he wished he could forget it all. And that perhaps, on some deeper level, we were all the same, the three of us.",shape=box,color=blue];
		j1424931481 -> j667712612;
	j3036074794 [label="They have barely made mention of any of it. Which I am deeply grateful for. I expected jeers and mockery. \"Finally, the devil is brought low.\" Anything but. They have gone on as though little has changed.",shape=box,color=blue];
		j3036074794 -> j672751827;
	j1622505995 [label="Check boolean LyonDating",color=orange];
		j1622505995 -> j3362991874 [label=true,color=green];
		j1622505995 -> j1690665004 [label=false,color=brown];
	j988990889 [label="They have barely made mention of any of it. Which I am deeply grateful for. I expected jeers and mockery. \"Finally, the devil is brought low.\" Anything but. They have gone on as though little has changed.",shape=box,color=blue];
		j988990889 -> j3419132174;
	j2412048728 [label="The forgiveness and compassion she will extend to others comes with no conditions.",shape=box,color=blue];
		j2412048728 -> j3143903595;
	j3362991874 [label="+5 Chemistry",color=orange];
		j3362991874 -> j2592702680;
