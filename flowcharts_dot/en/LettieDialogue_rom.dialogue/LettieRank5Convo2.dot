	edge [fontname="Roboto Condensed"];

	"LettieRank5Convo2 begins." [color=orange];
		"LettieRank5Convo2 begins." -> j3526029970;
	j3526029970 [label="Check boolean LettieDating",color=orange];
		j3526029970 -> j2402278526 [label=true,color=green];
		j3526029970 -> j2098890142 [label=false,color=brown];
	j2402278526 [label="Solecito \nYou there? \nI have a few minutes to spare and I wanted to talk",shape=box,color=blue];
		j2402278526 -> j2950249813;
		j2402278526 -> j2257783930;
		j2402278526 -> j3506946018;
	j2098890142 [label="Hey\nYou there? \nI have a few minutes to spare and I wanted to talk",shape=box,color=blue];
		j2098890142 -> j2257783930;
		j2098890142 -> j3506946018;
	j2950249813 [label="You're not breaking up with me, are you?",shape=box,color=red];
		j2950249813 -> j1795132000;
	j2257783930 [label="YOU want to talk...? Are you feeling okay? Did somebody die?",shape=box,color=red];
		j2257783930 -> j1724278575;
	j3506946018 [label="I'm sorry, I can't chat right now. [End.]",shape=box,color=red];
		j3506946018 -> "Chat ends.";
	j1795132000 [label="¡Ay, no! \nNonono \nNot what this is about jajaja \nThough YOU might change YOUR mind when I'm done talking",shape=box,color=blue];
		j1795132000 -> j3876047667;
		j1795132000 -> j3615795235;
	j1724278575 [label="Jaja very funny \nAnd who hasn't died once at this point \nAy, no, what I wanted to talk about \nIs serious \nAnd something I've been avoiding",shape=box,color=blue];
		j1724278575 -> j3615795235;
		j1724278575 -> j3876047667;
	"Chat ends." [color=orange];
	j3876047667 [label="Okay... What's this about?",shape=box,color=red];
		j3876047667 -> j2818670173;
	j3615795235 [label="All right. I'm listening.",shape=box,color=red];
		j3615795235 -> j2818670173;
	j2818670173 [label="Check boolean LettieHexAsked",color=orange];
		j2818670173 -> j430140621 [label=true,color=green];
		j2818670173 -> j3172424732 [label=false,color=brown];
	j430140621 [label="You asked how we became these monstruos \nWhat that pinche cabrón did to us \nWhy I hate him so much \nWhat that piece of shit made us do",shape=box,color=blue];
		j430140621 -> j4085873486;
	j3172424732 [label="Check boolean LettieEntrati",color=orange];
		j3172424732 -> j2202146174 [label=true,color=green];
		j3172424732 -> j3038561522 [label=false,color=brown];
	j4085873486 [label="So \nI followed Arthur into the ICR \nGot sent here to this cuchitril to deal with some weird plague nobody'd seen before",shape=box,color=blue];
		j4085873486 -> j2683223317;
	j2202146174 [label="You should know what that pinche cabrón did to us \nWhy I hate him so much \nWhat that piece of shit made us do",shape=box,color=blue];
		j2202146174 -> j4085873486;
	j3038561522 [label="Check boolean LettieArthur1",color=orange];
		j3038561522 -> j423588122 [label=true,color=green];
		j3038561522 -> j824380994 [label=false,color=brown];
	j2683223317 [label="A disease that chews up people \nSpits them out half person half machine \nOr some things that weren't ever human beings at all, más bien computadoras",shape=box,color=blue];
		j2683223317 -> j3467949020;
	j423588122 [label="I told you how Arthur and I became hermanos \nBut not how we got turned into these monstruos \nYou should know what that pinche cabrón did to us \nWhy I hate him so much \nWhat that piece of shit made us do",shape=box,color=blue];
		j423588122 -> j4085873486;
	j824380994 [label="You've done a lot for us \nSaved our lives, stayed with us... when you could leave \nTime you hear the whole story",shape=box,color=blue];
		j824380994 -> j4085873486;
	j3467949020 [label="We get deployed to \"deal with it\" \nBest way we know how \nHalf bandages \nHalf bullets",shape=box,color=blue];
		j3467949020 -> j1469862827;
	j1469862827 [label="This was early 1998 \nBefore you came \nThat Entrati cabrón was already here \nSelling his MENTIRAS",shape=box,color=blue];
		j1469862827 -> j3241930566;
	j3241930566 [label="But the best lies are the ones you want to believe, ¿verdad? \nWe had no cure for this disease except a dance with La Flaca \nBut here he comes \nDoktor F and his magical bag of miracles will cure what ails you \nSaying he can fix it all with his medicina milagrosa",shape=box,color=blue];
		j3241930566 -> j4058096961;
	j4058096961 [label="And we bought it como una bola de mensos \nAnd when the ICR stomps its feet and says \"nonono, you cannot help him distribute his drug\" should have listened \nVaccines come from scientists not an old man in some ugly-ass trench coat \nSelling lies like some old world snake oil \nBut people are dying all around you? \nYou help him anyway because you signed up to HELP people",shape=box,color=blue];
		j4058096961 -> j8143123;
	j8143123 [label="So we helped him inject the people of this city with his drug \nLined them up in our tents and that cabrón and I shot them full of it one after another \nAnd the others kept the operation safe while we worked",shape=box,color=blue];
		j8143123 -> j2638928454;
	j2638928454 [label="NOSOTROS CREÍMOS EN ÉL \nWe trusted him \n¿Y por tan poco? \nIt seemed like it was working \nThe people we were shooting up weren't getting sick \nThe problem...?",shape=box,color=blue];
		j2638928454 -> j1355611287;
	j1355611287 [label="Everybody around them WAS \nDo you know what \"silent carriers\" are? \nVolunteered in an animal shelter one summer cuando estaba chiquita \nHad all these raccoons \nCouldn't release them, because they might be silent carriers of rabies \nTHEY looked healthy, seemed healthy, seemed normal...",shape=box,color=blue];
		j1355611287 -> j597942432;
	j597942432 [label="But if we let them go? \nThey'd infect everything they came across... \nThat's what we were doing to people \nTHAT'S WHAT HE WAS MAKING US DO TO PEOPLE \n¡LO HIZO A PROPÓSITO!\nThis place is the edge of Mictlán POR SU CULPA",shape=box,color=blue];
		j597942432 -> j4051938850;
	j4051938850 [label="Even when we started to suspect \nWe could not believe \nWe whispered to each other \nBut shook our heads and said \nNonono, it cannot be \nNot him \nNot us",shape=box,color=blue];
		j4051938850 -> j1382766468;
	j1382766468 [label="Boolean LettieHex is now true.",color=orange];
		j1382766468 -> j86733959;
	j86733959 [label="Check boolean LettieDating",color=orange];
		j86733959 -> j3703392212 [label=true,color=green];
		j86733959 -> j393327263 [label=false,color=brown];
	j3703392212 [label="We did not want to believe \nThat our trust had been broken \nWe... we had taken the drug too, solecito... \nWe were spreading the plague...",shape=box,color=blue];
		j3703392212 -> j1405084064;
	j393327263 [label="We did not want to believe \nThat our trust had been broken \nWe... we had taken the drug too... \nWe were spreading the plague...",shape=box,color=blue];
		j393327263 -> j1405084064;
	j1405084064 [label="So when he said the Techrot strain had mutated... and we were no longer safe...",shape=box,color=blue];
		j1405084064 -> j3600796950;
	j3600796950 [label="We lined right up \nLike good little soldaditos",shape=box,color=blue];
		j3600796950 -> j954278334;
	j954278334 [label="Lua, it hurt \nWasn't the fun kind, either... \nAoi's screams were the worst \nI could not help her, I was too busy dying too \nShe wept in fear and all I wanted to do was hold her",shape=box,color=blue];
		j954278334 -> j1682188633;
	j1682188633 [label="Tell her it would be okay \nThat the pain would pass and La Flaca would take her home \nShe was so afraid and I could not help her \nMy legs would not work...",shape=box,color=blue];
		j1682188633 -> j3892504635;
	j3892504635 [label="And I will hate that piece of shit \nEvery day of my endless life \nFor that betrayal",shape=box,color=blue];
		j3892504635 -> j1637927243;
	j1637927243 [label="And if I ever see him again? \nYou better be there to hold me back \nOr I will teach him what real hurt is like",shape=box,color=blue];
		j1637927243 -> j622469793;
		j1637927243 -> j405512062;
		j1637927243 -> j3537446072;
		j1637927243 -> j2489247184;
	j622469793 [label="Holding a grudge like that isn't healthy, even if what he did to you was wrong.",shape=box,color=red];
		j622469793 -> j3910446306;
	j405512062 [label="Holy shit... I didn't realize. I - I'm so sorry he used you like that. Yeah... I'd hate him, too.",shape=box,color=red];
		j405512062 -> j2438939384;
	j3537446072 [label="I - so - wait. You all are partially to blame for the Techrot spreading?",shape=box,color=red];
		j3537446072 -> j3389227046;
	j2489247184 [label="Sorry I fell asleep there for a second. What were you saying?",shape=box,color=red];
		j2489247184 -> j2548450594;
	j3910446306 [label="Look at you \nAll Hail San Babas \nForgiving sins \nNo \nSome things cannot be forgiven \nWhat he did to us is one of them \nWhat we did to the people of this city is another",shape=box,color=blue];
		j3910446306 -> j1756881841;
		j3910446306 -> j2948312450;
		j3910446306 -> j1571832609;
	j2438939384 [label="Sí \nI do not take betrayal well \nBut we wanted to believe him and it made us stupid \nIf you do not want to be around us anymore, I understand\nThe others will, too",shape=box,color=blue];
		j2438939384 -> j1756881841;
		j2438939384 -> j2948312450;
		j2438939384 -> j1571832609;
	j3389227046 [label="Sí \nWe were \nBut we wanted to believe him and it made us stupid \nIf you do not want to be around us anymore, I understand \nThe others will, too",shape=box,color=blue];
		j3389227046 -> j1756881841;
		j3389227046 -> j2948312450;
		j3389227046 -> j1571832609;
	j2548450594 [label="Boolean LettieDating is now false.",color=orange];
		j2548450594 -> j4086907321;
	j1756881841 [label="I'm not here to tell you what you did can be forgiven or not. That's not something I can do, and honestly - I don't think what you're describing is something that CAN be forgiven.",shape=box,color=red];
		j1756881841 -> j2619401078;
	j2948312450 [label="Entrati came here and found exactly what he was looking for - useful, skilled people he could trick into doing what he wanted. Who wouldn't think too hard about it. You fell for his shtick like so many people who came before you.",shape=box,color=red];
		j2948312450 -> j2455991200;
	j1571832609 [label="What happened wasn't your fault. You were lied to. Yeah, sure - maybe you were a little willingly blind after things started to go wrong. But who can blame you? Hope is a dangerous drug. And he shot you full of it.",shape=box,color=red];
		j1571832609 -> j638622045;
	j4086907321 [label="Boolean IsDating is now false.",color=orange];
		j4086907321 -> j2703113057;
	j2619401078 [label="People died. People who won't come back. Because you wanted to believe in a miracle drug hawked by some \"old man in some ugly-ass trench coat.\"",shape=box,color=red];
		j2619401078 -> j2300875561;
	j2455991200 [label="You wanted to believe his lies. And so you did. And that's on you. And all the people who got sick because of it? That's also on you.",shape=box,color=red];
		j2455991200 -> j2619401078;
		j2455991200 -> j532412179;
	j638622045 [label="So of course, you went along with it. Of course, you wanted to believe there was a chance.",shape=box,color=red];
		j638622045 -> j1988722023;
	j2703113057 [label="Boolean LettieNoDate is now true.",color=orange];
		j2703113057 -> "Chat ends.";
	j2300875561 [label="And it's not on me to absolve you of that. Sorry.",shape=box,color=red];
		j2300875561 -> j44039935;
	j532412179 [label="But people make mistakes. And people own up to them. And you're here, trying to own up to them. So... I see people trying to do what's right with what they did wrong.",shape=box,color=red];
		j532412179 -> j1554797817;
	j1988722023 [label="I would have done the same thing.",shape=box,color=red];
		j1988722023 -> j1056555511;
	j44039935 [label="Check boolean LettieDating",color=orange];
		j44039935 -> j1068884591 [label=true,color=green];
		j44039935 -> j1544961654 [label=false,color=brown];
	j1554797817 [label="And I don't think a reasonable person can ask for much more than that. I don't think less of you. I see people who failed. But were willing to try again. And I know what that's like. Trust me.",shape=box,color=red];
		j1554797817 -> j1927512488;
	j1056555511 [label="¿Sí? \nAy... then we're both idiots jajaja \nMaybe you DO belong here with us \nSigh \nMy feet hurt \nMierda, everything hurts",shape=box,color=blue];
		j1056555511 -> j1927512488;
	j1068884591 [label="Sí \nYou're right \nWe made mistakes \nAnd I made another one in thinking  THIS could work out",shape=box,color=blue];
		j1068884591 -> j2548450594;
	j1544961654 [label="Sí \nYou're right \nWe made mistakes \nAnd I made another one in thinking I could trust you with this story",shape=box,color=blue];
		j1544961654 -> j193369797;
