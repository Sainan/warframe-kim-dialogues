		j1340976031 -> j745803398;
		j1340976031 -> j3049302595;
	j874640848 [label="Aaay, don't make me cry\nThat's so sweet, thinking of my panquecitos\nGracias\nI was thinking of something else, too\nBut... eh, don't laugh",shape=box,color=blue];
		j874640848 -> j1340976031;
	j3127131267 [label="I remember she likes plants. I think she'd love it.",shape=box,color=red];
