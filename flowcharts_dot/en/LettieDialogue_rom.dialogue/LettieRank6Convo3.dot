		j3049302595 -> j2161108766;
	j1207278379 [label="It's so dreary in here\nNo necesitamos mantenerlo lúgubre y sucio\nRather she be talking to the plants instead of...\nWell... the guns...",shape=box,color=blue];
		j1207278379 -> j3946493511;
	j3899946507 [label="Sí\nHard sometimes to let things go\nAdmit when things can change\nRather she be talking to the plants than...\nWell... the guns...",shape=box,color=blue];
		j3899946507 -> j3946493511;
	j2161108766 [label="She and I haven't always been \"besties\"\nHard sometimes to let things go\nAdmit when things can change\nRather she be talking to the plants than...\nWell... the guns...",shape=box,color=blue];
		j2161108766 -> j3946493511;
	j3946493511 [label="But I've found that when she smiles\nI smile\nProbably more of su onda de bruja jajaja",shape=box,color=blue];
