		j1664541118 -> j2692704724;
	j934447715 [label="We can't hurt some random teenager.",shape=box,color=red];
		j934447715 -> j1129414626;
	j2692704724 [label="I want to make him feel what it's like when he's the one who's scared and the whole world is against them\nWhen everyone is laughing at him\nMocking him",shape=box,color=blue];
		j2692704724 -> j3513876651;
	j1129414626 [label="Who says that was the plan\nI know his type\nCowards, all of them, whipping words from where they think its safe",shape=box,color=blue];
		j1129414626 -> j2692704724;
	j3513876651 [label="Do you know what it was like growing up looking like me?\nSounding like me?\nDressing like me?\nSurrounded by children on military bases who didn't?",shape=box,color=blue];
		j3513876651 -> j1589483256;
	j1589483256 [label="I'd come home beat up more often than not because I stood up for myself\nMi mamá would always tsk and say I should've kept my head down\n¿Quedarme callada?\nLike hell",shape=box,color=blue];
		j1589483256 -> j580547789;
	j580547789 [label="Check boolean KayaFutureWin2",color=orange];
