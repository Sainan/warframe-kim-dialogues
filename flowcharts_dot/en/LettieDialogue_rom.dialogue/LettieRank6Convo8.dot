		j1315773324 -> j2590712682;
	j2590712682 [label="I do not know how\nI do not know if it is ever possible\nBut you break the laws of time and space",shape=box,color=blue];
		j2590712682 -> j2614887243;
	j2614887243 [label="I want to find him\nAnd I want to bring him here\nAnd I want to sit him down in front of all of us",shape=box,color=blue];
		j2614887243 -> j1664541118;
		j2614887243 -> j934447715;
