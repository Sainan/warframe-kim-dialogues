		j3472800951 -> j397029273;
	j2461734651 [label="JAJAJA remind me never to set you as emergency contact\nSííí, she goes for stretches but she comes back here\nFor Temporal Archi-whatever\nBut also for... us, I think",shape=box,color=blue];
		j2461734651 -> j3880885156;
	j3032653173 [label="Sííí, Temporal Archi-whatever\nBut also for... us, I think",shape=box,color=blue];
		j3032653173 -> j3880885156;
	j397029273 [label="Sometimes it just takes time\nBut I'll try to help her if I can\nLua knows she's curious enough about medical science jajaja\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
		j397029273 -> j2263576110;
	j3880885156 [label="I like having her around\nI think she knows that\nShe likes to help me in surgery, though...\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
		j3880885156 -> j898585898;
	j2263576110 [label="Doesn't help that she teleports\nI love watching her startle Amir\nFast bastard deserves it, does it to us enough JAJAJAJA",shape=box,color=blue];
