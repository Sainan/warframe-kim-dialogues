		j4130249013 -> j1394848684;
	j1394848684 [label="Sometimes I wish\nIt was as easy as a problem\nThen I could fix it, ¿sí?\nTalk it out, smack it around jajaja",shape=box,color=blue];
		j1394848684 -> j3414849361;
	j3414849361 [label="Problems can be solved\nProblems have answers\nLos sentimientos no se arreglan\nBelieve me, I've tried",shape=box,color=blue];
		j3414849361 -> j4073524959;
		j3414849361 -> j3413058418;
	j4073524959 [label="You have a ton to be happy about, though.",shape=box,color=red];
		j4073524959 -> j1101055654;
	j3413058418 [label="I learned the hard way in Duviri that \"fixing feelings\" is sometimes the worse choice.",shape=box,color=red];
		j3413058418 -> j2940043776;
	j1101055654 [label="Ay, sí, I do\nAnd I know I do\nAnd I wish sometimes\nPeople understood that part of me\nWill never let that sink in",shape=box,color=blue];
		j1101055654 -> j3825720703;
	j2940043776 [label="Síí...\nThough sometimes it's tempting jajaja\nJust wish it all away\nBut you've told me about what happens\nWhen it all goes numb",shape=box,color=blue];
		j2940043776 -> j3304773402;
	j3825720703 [label="I wish I could be different\nBut I am who I am\nAnd I gave up apologizing for that\nLong ago",shape=box,color=blue];
		j3825720703 -> "Chat ends.";
	j3304773402 [label="Wouldn't wish that on anyone\nOk maybe Albrecht\nPinche güey\nHis heart is too cold as it is tho",shape=box,color=blue];
		j3304773402 -> j2670730543;
		j3304773402 -> j2797672;
	j2670730543 [label="What can we do to get your mind off things? Or would you prefer to stay in?",shape=box,color=red];
