		j2797672 -> j2360483693;
	j1039940225 [label="Eeeh, good question\nHonestly not sure\nStaying in might be nice \nOr, we could go out and kill things\n¿Te quedas?, ¿o vamos a matar cosas? \nChoices choices...",shape=box,color=blue];
		j1039940225 -> j3816622243;
		j1039940225 -> j1704832502;
	j2360483693 [label="The only thing I hope for where that cabrón is involved\nIs a long ride in an elevator\nWith me\nAnd a baseball bat",shape=box,color=blue];
