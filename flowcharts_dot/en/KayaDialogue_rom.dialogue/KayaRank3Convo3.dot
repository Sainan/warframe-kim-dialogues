	j1606285168 [label="I'll be 'ok' when I can leave this year.",shape=box,color=blue];
		j1606285168 -> j2161937516;
	j208129844 [label="I just don't know if I can trust people anymore. Even you.",shape=box,color=blue];
		j208129844 -> j2803932986;
	"Chat ends. Next chat will be KayaRank4Convo1." [color=orange];
	j2161937516 [label="You trapped me in the worst year of my life. ",shape=box,color=blue];
		j2161937516 -> j2803932986;
	j2803932986 [label="Like I'm basically using you to get out of here. ",shape=box,color=blue];
		j2803932986 -> j309336089;
		j2803932986 -> j2095298814;
	j309336089 [label="Whatever caused you to be like this is ruining your chance at real happiness.",shape=box,color=red];
		j309336089 -> j2251412343;
	j2095298814 [label="Go ahead. The sooner you're gone the less attitude I have to deal with.",shape=box,color=red];
		j2095298814 -> j136165862;
	j2251412343 [label="You can't make me hate you. You can annoy me sure, but that's not hate.",shape=box,color=red];
