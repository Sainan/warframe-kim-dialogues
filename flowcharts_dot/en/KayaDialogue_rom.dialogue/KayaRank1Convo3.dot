		j2777631197 -> j2970037045;
	j3345679033 [label="Wow are you actually bragging?",shape=box,color=red];
		j3345679033 -> j2970037045;
	j1620038761 [label="In fact, he's convinced me that I was wrong in some of my original hypothesis so it did help, but he reminded me that maybe I can just pay my way to an answer, or at least pay to talk to someone else from the future if you don't help me.",shape=box,color=blue];
		j1620038761 -> j3732042773;
		j1620038761 -> j2435421397;
	j163100643 [label="We do get along. She reminds me of a teacher I had once, 0 nastiness and saw me for my brain.",shape=box,color=blue];
		j163100643 -> j1092399836;
	j3133187938 [label="Is that an offer? What can I access? Anything would help.",shape=box,color=blue];
		j3133187938 -> j1175708151;
	j4285909497 [label="You want to time travel, but where? Why?",shape=box,color=red];
