		j368315635 -> j3944524196 [label=false,color=brown];
	j3876170803 [label="Yeah, I don't know you. I just know what you can do. Which is why we're talking. Like, be serious.",shape=box,color=blue];
		j3876170803 -> j988946811;
	j537634424 [label="A promise from a stranger on the internet. Give me a break. Ha. Just tell me what I want to know.",shape=box,color=blue];
		j537634424 -> j2436786705;
	j3044227435 [label="And I show up, and he actually gets scared. Like, he did NOT even expect someone to show up.",shape=box,color=blue];
		j3044227435 -> j2777631197;
		j3044227435 -> j3345679033;
	j1907090275 [label="I did. We agree on some fundamentals but he doesn't seem interested in a concrete and reproducible time travel theorem. ",shape=box,color=blue];
		j1907090275 -> j1620038761;
	j3157189933 [label="Well, we're trying to make the most of our tools I guess. Did you talk to Lettie? I feel like you and her would get along.",shape=box,color=red];
