digraph {
	"KayaRank4Convo1 begins." [color=orange];
		"KayaRank4Convo1 begins." -> j3151677297;
	j3151677297 [label="You want to know what it's like? The internet shows up, promises so much to us.",shape=box,color=blue];
		j3151677297 -> j2840378248;
	j2840378248 [label="So you're me. You turn 18. You go online. You start chatting to new friends EVERYWHERE!",shape=box,color=blue];
		j2840378248 -> j524238004;
	j524238004 [label="And for a so called 'smart girl' like me, you do the stupidest thing ever on the internet. ",shape=box,color=blue];
		j524238004 -> j1863542067;
	j1863542067 [label="You trust the person on the other side. ",shape=box,color=blue];
		j1863542067 -> j3224109975;
	j3224109975 [label="And you look at all this new technology and forget that people are still people. ",shape=box,color=blue];
		j3224109975 -> j2394324137;
	j2394324137 [label="So you send a nude picture of yourself that would make Lua blush. You think you have a connection with someone you met on the internet. You can trust your online boyfriend. ",shape=box,color=blue];
		j2394324137 -> j3087057277;
	j3087057277 [label="And the next day, that photo is everywhere. Everyone on campus has seen it. Shared. Sent it to your PROFESSORS. All over the INTERNET. Countries I didn't even know existed.",shape=box,color=blue];
		j3087057277 -> j3855647040;
	j3855647040 [label="I could have been the smartest person on this rock and all people would remember me for is that picture.",shape=box,color=blue];
		j3855647040 -> j953952141;
	j953952141 [label="So when I say I'm going to get out of here, I mean it. I know that picture means NOTHING, the future moved on, people got their kicks.",shape=box,color=blue];
		j953952141 -> j3658023210;
	j3658023210 [label="But to me it ruined my life. I want to live in a future with no internet. I want to prove that I can move forward from this. Going to the past proves THEM right, that I can't move on from this.",shape=box,color=blue];
		j3658023210 -> j626478577;
	j626478577 [label="So, just wait. You'll see me where you come from. ",shape=box,color=blue];
		j626478577 -> j1925723732;
	j1925723732 [label="And we can look at the world and laugh that my choices didn't destroy me. It all just made me smarter. Smart enough to get out.",shape=box,color=blue];
		j1925723732 -> j3258508148;
	j3258508148 [label="+20 Chemistry",color=orange];
		j3258508148 -> "Chat ends. Next chat will be KayaRank4Convo2.";
	"Chat ends. Next chat will be KayaRank4Convo2." [color=orange];
}