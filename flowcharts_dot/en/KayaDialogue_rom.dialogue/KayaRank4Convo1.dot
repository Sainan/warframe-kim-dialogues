digraph {
	541 [label="KayaRank4Convo1 begins.",color=orange];
		541 -> 542;
	542 [label="You want to know what it's like? The internet shows up, promises so much to us.",shape=box,color=blue];
		542 -> 543;
	543 [label="So you're me. You turn 18. You go online. You start chatting to new friends EVERYWHERE!",shape=box,color=blue];
		543 -> 544;
	544 [label="And for a so called 'smart girl' like me, you do the stupidest thing ever on the internet. ",shape=box,color=blue];
		544 -> 545;
	545 [label="You trust the person on the other side. ",shape=box,color=blue];
		545 -> 546;
	546 [label="And you look at all this new technology and forget that people are still people. ",shape=box,color=blue];
		546 -> 547;
	547 [label="So you send a nude picture of yourself that would make Lua blush. You think you have a connection with someone you met on the internet. You can trust your online boyfriend. ",shape=box,color=blue];
		547 -> 548;
	548 [label="And the next day, that photo is everywhere. Everyone on campus has seen it. Shared. Sent it to your PROFESSORS. All over the INTERNET. Countries I didn't even know existed.",shape=box,color=blue];
		548 -> 549;
	549 [label="I could have been the smartest person on this rock and all people would remember me for is that picture.",shape=box,color=blue];
		549 -> 550;
	550 [label="So when I say I'm going to get out of here, I mean it. I know that picture means NOTHING, the future moved on, people got their kicks.",shape=box,color=blue];
		550 -> 551;
	551 [label="But to me it ruined my life. I want to live in a future with no internet. I want to prove that I can move forward from this. Going to the past proves THEM right, that I can't move on from this.",shape=box,color=blue];
		551 -> 552;
	552 [label="So, just wait. You'll see me where you come from. ",shape=box,color=blue];
		552 -> 553;
	553 [label="And we can look at the world and laugh that my choices didn't destroy me. It all just made me smarter. Smart enough to get out.",shape=box,color=blue];
		553 -> 554;
	554 [label="+20 Chemistry",color=orange];
		554 -> 555;
	555 [label="Chat ends. Next chat will be KayaRank4Convo2.",color=orange];
}