		j1594413658 -> j2556061167;
	j1060965115 [label="You don't seem to have many of those.",shape=box,color=red];
		j1060965115 -> j932123066;
	j2033134693 [label="And it made me think about the only time someone baked a cake for me was this shy classmate.",shape=box,color=blue];
		j2033134693 -> j915299915;
	j3229626808 [label="But what if I wanted to?",shape=box,color=red];
