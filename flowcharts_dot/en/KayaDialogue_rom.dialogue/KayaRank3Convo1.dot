		j2555968868 -> j3881378485;
	j3185248370 [label="Anyway, this student baked me a birthday cake but told me not to share it with anyone and to wait until I got home to eat it. ",shape=box,color=blue];
		j3185248370 -> j4231681852;
	j972135761 [label="I had good grades. Beyond good actually. And captain of the cheer-force. It was like a big deal to get invited to my birthday party.",shape=box,color=blue];
		j972135761 -> j3185248370;
	j3881378485 [label="Fine.",shape=box,color=blue];
		j3881378485 -> j3185248370;
	j4231681852 [label="And to be honest it weirded me out, kind of like you did at first. But then I cut it open and my kitchen knife hit something hard.",shape=box,color=blue];
		j4231681852 -> j2886746883;
	j2886746883 [label="Gross right? Mega gross. But then I looked and it was like a plastic container they hid under the cake filled with sealed Jinymon Card packs. My favourite things ever.",shape=box,color=blue];
		j2886746883 -> j650316563;
	j650316563 [label="But a girl like me would not be caught DEAD with those at school. But obviously this shy kid saw what I was really like and snuck me the real gift while making it look like they wanted my attention with a big cake or something idk.",shape=box,color=blue];
		j650316563 -> j1319803157;
		j650316563 -> j1150079266;
		j650316563 -> j74179843;
	j1319803157 [label="I'm not baking you a cake.",shape=box,color=red];
		j1319803157 -> j15475854;
	j1150079266 [label="For someone who is supposed to be some kid genius you really take a while to make a point...",shape=box,color=red];
		j1150079266 -> j3852875601;
	j74179843 [label="And how does that remind you of me exactly?",shape=box,color=red];
		j74179843 -> j1370238810;
	j15475854 [label="+20 Chemistry",color=orange];
		j15475854 -> j3010999530;
