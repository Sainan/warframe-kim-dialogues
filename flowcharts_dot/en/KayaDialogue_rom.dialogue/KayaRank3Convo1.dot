		j2519689607 -> j4279708313;
	j3980538633 [label="Well like I guess a bit it was. I should say that um I definitely was the type of person that everyone wanted to be seen with.",shape=box,color=blue];
		j3980538633 -> j3078063401;
	j3412364375 [label="And they brought me a vanilla cake with vanilla icing, the cake was like three layers tall I swear.",shape=box,color=blue];
