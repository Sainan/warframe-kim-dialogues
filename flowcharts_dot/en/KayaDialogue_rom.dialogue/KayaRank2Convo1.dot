digraph {
	"KayaRank2Convo1 begins." [color=orange];
		"KayaRank2Convo1 begins." -> j2263752133;
	j2263752133 [label="Hey Kaya!",shape=box,color=red];
		j2263752133 -> j3829678237;
	j3829678237 [label="Nova, I go by Nova online.",shape=box,color=blue];
		j3829678237 -> j4224155818;
		j3829678237 -> j2739032532;
	j4224155818 [label="Okay, Nova then. ",shape=box,color=red];
		j4224155818 -> j3703157791;
	j2739032532 [label="I see. Since when?",shape=box,color=red];
		j2739032532 -> j3151524087;
	j3703157791 [label="K thanks, just don't call me Kaya on the internet. You can call me that in person, but here: NOVA. Ok?",shape=box,color=blue];
		j3703157791 -> j466945844;
		j3703157791 -> j3246526554;
	j3151524087 [label="Um does it matter? It's the internet, I'd rather not use my real name.",shape=box,color=blue];
		j3151524087 -> j578044180;
		j3151524087 -> j1270361079;
	j466945844 [label="Okay, but can I ask why?",shape=box,color=red];
		j466945844 -> j3904602681;
	j3246526554 [label="Got it. Nova. Nova. Right. I wanted to ask: Is there anything I can do to make things more comfortable for you here?",shape=box,color=red];
		j3246526554 -> j2857489788;
	j578044180 [label="Right yah, wouldn't want people seeing how often you ask me about time travel.",shape=box,color=red];
		j578044180 -> j2052285451;
	j1270361079 [label="Oh? I'm pretty sure Amir has this network pretty locked down, unless I'm missing something?",shape=box,color=red];
		j1270361079 -> j1517344650;
	j3904602681 [label="Did you ask anyone else if they had a nickname they liked? Just get with it. ",shape=box,color=blue];
		j3904602681 -> j3246526554;
	j2857489788 [label="I know none of us really asked to 'be here' in this makeshift home but we're doing our best.",shape=box,color=red];
		j2857489788 -> j1036347057;
	j2052285451 [label="Are you for real? The internet is dangerous. Like, actually.",shape=box,color=blue];
		j2052285451 -> j2107718988;
		j2052285451 -> j2511376898;
	j1517344650 [label="It matters to me. I don't want anyone to ever find Kaya online again.",shape=box,color=blue];
		j1517344650 -> j1356771172;
		j1517344650 -> j3987989002;
	j1036347057 [label="Hmm. Umm. Hmm. Comfortable. No one has spread any rumors about me have they?",shape=box,color=blue];
		j1036347057 -> j2377522714;
		j1036347057 -> j3642963891;
	j2107718988 [label="Did something happen to you?",shape=box,color=red];
		j2107718988 -> j960515419;
	j2511376898 [label="And you think time travel isn't?",shape=box,color=red];
		j2511376898 -> j4294415938;
	j1356771172 [label="The time cops won't get you I swear.",shape=box,color=red];
		j1356771172 -> j3298161901;
	j3987989002 [label="Get yourself into some trouble?",shape=box,color=red];
		j3987989002 -> j2173315211;
	j2377522714 [label="Well Aoi did say...",shape=box,color=red];
		j2377522714 -> j505536242;
	j3642963891 [label="Not a word. Only happy you're here.",shape=box,color=red];
		j3642963891 -> j3406141100;
	j960515419 [label="Check boolean KayaSetKid",color=orange];
		j960515419 -> j2385617024 [label=true,color=green];
		j960515419 -> j1753738107 [label=false,color=brown];
	j4294415938 [label="Check boolean KayaSetKid",color=orange];
		j4294415938 -> j1671781286 [label=true,color=green];
		j4294415938 -> j3813213600 [label=false,color=brown];
	j3298161901 [label="Ugh. Not funny. ",shape=box,color=blue];
		j3298161901 -> j2292283515;
	j2173315211 [label="I made a DUMB Mistake. Once. ",shape=box,color=blue];
		j2173315211 -> j3645297935;
	j505536242 [label="Don't even joke actually.",shape=box,color=blue];
		j505536242 -> j624506980;
	j3406141100 [label="Arthur and Eleanor definitely see you as a little sister who is way smarter than them.",shape=box,color=red];
		j3406141100 -> j710978250;
	j2385617024 [label="You're the one that says I'm like a kid, what if something did happen to me?",shape=box,color=blue];
		j2385617024 -> j500475234;
	j1753738107 [label="Nothing that I can change now.",shape=box,color=blue];
		j1753738107 -> j2988068299;
	j1671781286 [label="Listen I know you think I'm just a kid.",shape=box,color=blue];
		j1671781286 -> j1427231920;
	j3813213600 [label="Fine. You're right.",shape=box,color=blue];
	j2292283515 [label="+20 Chemistry",color=orange];
		j2292283515 -> "Chat ends. Next chat will be KayaRank2Convo2.";
	j3645297935 [label="And I don't make mistakes.",shape=box,color=blue];
		j3645297935 -> j3086939292;
	j624506980 [label="It's not even funny. You put girls like us in a room and everyone expect us to be at each other's throats.",shape=box,color=blue];
		j624506980 -> j2298992991;
	j710978250 [label="Amir and Quincy cannot get over your Wormhole and I swear when you aren't looking they jump through it.",shape=box,color=red];
		j710978250 -> j1244987413;
	j500475234 [label="Then I would hope you can see from the people around you that we're a team that helps each other.",shape=box,color=red];
		j500475234 -> j1835122856;
	j2988068299 [label="Well, is that why you want to figure out this time travel thing? To prove something?",shape=box,color=red];
		j2988068299 -> j2711042857;
	j1427231920 [label="But ",shape=box,color=blue];
		j1427231920 -> j2173315211;
	"Chat ends. Next chat will be KayaRank2Convo2." [color=orange];
	j3086939292 [label="So give me just a few more days, maybe a few weeks, and I'll have this whole thing figured out and it's goodbye 1999.",shape=box,color=blue];
		j3086939292 -> j2892505843;
	j2298992991 [label="Jealousy. Comparisons. Ugh. I'm done with that part of my life. Do not try and turn me against the other girls. ",shape=box,color=blue];
		j2298992991 -> j2292283515;
	j1244987413 [label="Aoi and Lettie can't seem to decide if they want to be your best friend or your mother.",shape=box,color=red];
		j1244987413 -> j1209691337;
	j1835122856 [label="Mmm. ",shape=box,color=blue];
		j1835122856 -> j787700223;
	j2711042857 [label="Maybe.",shape=box,color=blue];
		j2711042857 -> j3898456205;
	j2892505843 [label="Bet on it.",shape=box,color=blue];
		j2892505843 -> j2292283515;
	j1209691337 [label="And of course me, I'm happy someone wants to understand how the hell I ended up here.",shape=box,color=red];
		j1209691337 -> j915401444;
	j787700223 [label="You are right. You aren't exactly unpopular.",shape=box,color=blue];
		j787700223 -> j3272885779;
	j3898456205 [label="Why do you care, actually?",shape=box,color=blue];
		j3898456205 -> j1173333211;
		j3898456205 -> j3603946852;
		j3898456205 -> j2673243050;
	j915401444 [label="You guys actually... like me?",shape=box,color=blue];
		j915401444 -> j165978842;
		j915401444 -> j414014320;
	j3272885779 [label="And everyone does seem to trust you, or at least say they do.",shape=box,color=blue];
		j3272885779 -> j2673243050;
		j3272885779 -> j3603946852;
		j3272885779 -> j1173333211;
	j1173333211 [label="Trusting people and working together is what makes us us. ",shape=box,color=red];
		j1173333211 -> j394766465;
	j3603946852 [label="Caring about my friends is a strength. It's a reason to endure all this shit.",shape=box,color=red];
		j3603946852 -> j394766465;
	j2673243050 [label="We all have our shit to deal with. It's hard to do alone.",shape=box,color=red];
		j2673243050 -> j394766465;
	j165978842 [label="We're just waiting for you to feel comfortable around us.",shape=box,color=red];
		j165978842 -> j2546257714;
	j414014320 [label="How could we not? ",shape=box,color=red];
		j414014320 -> j2546257714;
