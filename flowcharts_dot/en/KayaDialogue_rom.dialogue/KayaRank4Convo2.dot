	j943684840 [label="Which is saying something.",shape=box,color=red];
		j943684840 -> j2072611246;
	j703387857 [label="All that attitude you've given me? At least it makes sense, you were afraid AND angry. I was another stranger on the internet.",shape=box,color=red];
