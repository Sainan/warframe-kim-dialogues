		j1063848072 -> j3599304286;
	j3599304286 [label="You were vulnerable and you were betrayed.",shape=box,color=red];
		j3599304286 -> j1346366185;
	j1346366185 [label="Your world was pulled from under you. ",shape=box,color=red];
		j1346366185 -> j505380487;
	j505380487 [label="People looked at you differently.",shape=box,color=red];
		j505380487 -> j1002407475;
	j1002407475 [label="Do you see why I need to get away?",shape=box,color=blue];
		j1002407475 -> j722808725;
	j722808725 [label="It's like, what happened to me had never happened to ANYONE.",shape=box,color=blue];
		j722808725 -> j3415623974;
	j3415623974 [label="It made headlines. People mocked me for pretending I was a victim of something when it was my own choice to share that photo.",shape=box,color=blue];
		j3415623974 -> j2074467183;
	j2074467183 [label="You can't even look up my name in the student databases without people thinking of that 'STP', Slutty Teachers Pet.",shape=box,color=blue];
		j2074467183 -> j1633601060;
	j1633601060 [label="And you guys will find the picture too and none of you will ever look at me the same again. Like any respect... gone. Forever",shape=box,color=blue];
		j1633601060 -> j1805025257;
	j1805025257 [label="I have to get out, I have to move forward, to a time and place where I was smart enough to leave this all behind.",shape=box,color=blue];
		j1805025257 -> j421334132;
		j1805025257 -> j4149189896;
		j1805025257 -> j2278114645;
	j421334132 [label="There's nothing more for me to say. We've all done things we regret. ",shape=box,color=red];
		j421334132 -> j538110091;
	j4149189896 [label="If anything I respect you more.",shape=box,color=red];
		j4149189896 -> j3022223918;
	j2278114645 [label="There will never be a moment where any of us judge you for this.",shape=box,color=red];
		j2278114645 -> j3051414897;
	j538110091 [label="Maybe one day you can tell me the biggest regret you have...",shape=box,color=blue];
		j538110091 -> j626007672;
