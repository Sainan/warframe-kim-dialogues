		j3051414897 -> j2366591228 [label=true,color=green];
		j3051414897 -> j2072611246 [label=false,color=brown];
	j626007672 [label="Maybe I will. We have lots of time, after all.",shape=box,color=red];
		j626007672 -> j636956295;
	j1764682337 [label="It's a promise. You're not alone in this world. We're all just taking chances on other people.",shape=box,color=red];
		j1764682337 -> j3706483799;
	j89168196 [label="Not a lie. Just believe it. [End.]",shape=box,color=red];
