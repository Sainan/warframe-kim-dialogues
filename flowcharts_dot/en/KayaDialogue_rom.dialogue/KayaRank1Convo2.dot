	"KayaRank1Convo2 begins." [color=orange];
		"KayaRank1Convo2 begins." -> j1104156299;
	j1104156299 [label="Hi. Why would Entrati's cross-temporal setup involve what appears to be an active connection to the Kinemantik Online Network?",shape=box,color=blue];
		j1104156299 -> j3785611984;
	j3785611984 [label="Or, I guess, Hi. Is the internet required for time travel?",shape=box,color=blue];
		j3785611984 -> j3393030710;
		j3785611984 -> j1182211251;
	j3393030710 [label="Right to it then, okay. No, the ‘internet’ didn’t make it to my time, really, so it can’t be required. Or maybe it is. ",shape=box,color=red];
		j3393030710 -> j1754853053;
	j1182211251 [label="And hello to you too, Kaya. ",shape=box,color=red];
		j1182211251 -> j2587256468;
	j1754853053 [label="So you do not need an internet connection to come and go as you please? Did Entrati?",shape=box,color=blue];
		j1754853053 -> j3275110905;
	j2587256468 [label="Ugh. Internet? I could see how given the properties of a network..",shape=box,color=blue];
		j2587256468 -> j3275110905;
	j3275110905 [label="I really don't know anything for sure. I just know there was a sequence, Entrati had a plan, and it involved me, here, now. I needed to get here, to meet you all.",shape=box,color=red];
		j3275110905 -> j559333601;
	j559333601 [label="Okay, but why does there seem to be an internet connection that is non-negotiable in some of his notes?",shape=box,color=blue];
		j559333601 -> j2736360748;
		j559333601 -> j2583678213;
		j559333601 -> j131950519;
	j2736360748 [label="I'll ask him next time I see him.",shape=box,color=red];
		j2736360748 -> j3135231552;
	j2583678213 [label="You have his notes?",shape=box,color=red];
		j2583678213 -> j1653679705;
	j131950519 [label="Is that a problem? Wouldn't a kid like you love the internet? ",shape=box,color=red];
		j131950519 -> j2322558332;
	j3135231552 [label="?",shape=box,color=blue];
		j3135231552 -> j2325996856;
		j3135231552 -> j1916629896;
	j1653679705 [label="Not literally. Just what I saw when I found him. I don't think he expected to be found.",shape=box,color=blue];
		j1653679705 -> j448789439;
	j2322558332 [label="Check boolean KayaSetKid",color=orange];
		j2322558332 -> j1106498539 [label=true,color=green];
		j2322558332 -> j170702684 [label=false,color=brown];
	j2325996856 [label="Sorry, was making a joke... They have those in the future.",shape=box,color=red];
		j2325996856 -> j1838092426;
	j1916629896 [label="A joke. Lighten up.",shape=box,color=red];
		j1916629896 -> j874650605;
	j448789439 [label="Boolean KayaSetFound is now true.",color=orange];
		j448789439 -> j1912372578;
		j448789439 -> j4291946302;
	j1106498539 [label="Does it make you feel better to keep calling me a kid? Like, don't you get it?",shape=box,color=blue];
		j1106498539 -> j142804569;
	j170702684 [label="You don't know anything about me.",shape=box,color=blue];
		j170702684 -> j1557784581;
	j1838092426 [label="Fine.",shape=box,color=blue];
		j1838092426 -> j837379113;
	j874650605 [label="No.",shape=box,color=blue];
		j874650605 -> j1557784581;
	j1912372578 [label="YOU? You found Entrati, when no one else could?",shape=box,color=red];
		j1912372578 -> j4107403813;
	j4291946302 [label="You found him? How?",shape=box,color=red];
		j4291946302 -> j4107403813;
	j142804569 [label="I had to grow up FAST. The people on this f**** internet made sure of that.",shape=box,color=blue];
		j142804569 -> j1557784581;
	j1557784581 [label="+20 Chemistry",color=orange];
		j1557784581 -> "Chat ends. Next chat will be KayaRank1Convo3.";
	j837379113 [label="+20 Chemistry",color=orange];
		j837379113 -> j2679431777;
	j4107403813 [label="I wanted answers.",shape=box,color=blue];
		j4107403813 -> j47211250;
	"Chat ends. Next chat will be KayaRank1Convo3." [color=orange];
	j2679431777 [label="And you're sure there's not internet in your future? Like totally sure?",shape=box,color=blue];
		j2679431777 -> j2885656583;
	j47211250 [label="+20 Chemistry",color=orange];
		j47211250 -> j767896213;
	j2885656583 [label="Actually, forget I said anything. I'll find out when I get there.",shape=box,color=blue];
		j2885656583 -> j1557784581;
	j767896213 [label="Things changed too fast in this shithole. Especially in the internet backrooms talking about this Doktor.",shape=box,color=blue];
		j767896213 -> j3027039915;
	j3027039915 [label="So I found him, surprised him. And ohh my god. Grandpa Doktor was not happy but, I cut right to it.",shape=box,color=blue];
		j3027039915 -> j3252278142;
	j3252278142 [label="I knew he was from the future. He knew I knew. He gave me a choice and well whatever. Now I found you. ",shape=box,color=blue];
		j3252278142 -> j4280559115;
	j4280559115 [label="And in a way I'm giving you a choice too. Help me, or regret it.",shape=box,color=blue];
		j4280559115 -> j3079435009;
		j4280559115 -> j1978441183;
	j3079435009 [label="Charming. I'm not your enemy you know.",shape=box,color=red];
		j3079435009 -> j2107881851;
	j1978441183 [label="Do you threaten all your new friends?",shape=box,color=red];
		j1978441183 -> j3122110215;
	j2107881851 [label="Not yet anyway. People change. Guess we'll see.",shape=box,color=blue];
		j2107881851 -> j1557784581;
	j3122110215 [label="Just protecting myself. ",shape=box,color=blue];
		j3122110215 -> j1557784581;
