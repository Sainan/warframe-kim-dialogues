	41 [label="Right to it then, okay. No, the ‘internet’ didn’t make it to my time, really, so it can’t be required. Or maybe it is. ",shape=box,color=red];
		41 -> 43;
	42 [label="And hello to you too, Kaya. ",shape=box,color=red];
