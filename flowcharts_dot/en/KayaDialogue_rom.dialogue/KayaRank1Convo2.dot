digraph {
	38 [label="KayaRank1Convo2 begins.",color=orange];
		38 -> 39;
	39 [label="Hi. Why would Entrati's cross-temporal setup involve what appears to be an active connection to the Kinemantik Online Network?",shape=box,color=blue];
		39 -> 40;
