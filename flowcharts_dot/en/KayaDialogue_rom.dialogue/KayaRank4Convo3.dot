	j192628177 [label="Um, are you crazy? Not Gross. ANYWAY!",shape=box,color=blue];
		j192628177 -> j537645247;
	j1411638823 [label="There's no downside. Either I figure it out, or I don't. See ya here, or see ya there. Right? See ya!",shape=box,color=blue];
		j1411638823 -> j465934596;
	j3178235360 [label="All of this, everything Entrati did. His pursuit of the Void, the essence of... it all.",shape=box,color=red];
