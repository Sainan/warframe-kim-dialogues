	j696615229 [label="Well I guess that's how it started.",shape=box,color=red];
		j696615229 -> j883826205;
	j883826205 [label="But all this now? It's beyond. It's because Albrecht went somewhere, woke something up, and it followed him back. The Void.",shape=box,color=red];
