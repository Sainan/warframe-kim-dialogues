digraph {
	0 [label="KayaRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Hi. Can everybody time travel, or just you?",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="Good day to you too, listen kid, it’s not that simple.",shape=box,color=red];
		2 -> 4;
	3 [label="Hello? Kaya? How is your day.",shape=box,color=red];
		3 -> 5;
	4 [label="I'm not a kid. I'm 19.",shape=box,color=blue];
		4 -> 6;
		4 -> 7;
	5 [label="Fine. ",shape=box,color=blue];
		5 -> 8;
	6 [label="Right. Youngest of this new group I'd say, though, kid.",shape=box,color=red];
		6 -> 9;
	7 [label="Yeah yeah, just don't rush into the time travel thing. It's... complicated.",shape=box,color=red];
		7 -> 10;
	8 [label="So. Just you? Are there others? Is time travel taught in schools in the future?",shape=box,color=blue];
		8 -> 11;
	9 [label="Ugh. Youngest, sure, but also clearly most intent on doing something to find answers. Try and keep up. So: Time travel. How and who?",shape=box,color=blue];
		9 -> 12;
	10 [label="Ugh. How complicated? Formulas? Chemical and atomic elements? I'll figure it out just point me in a direction.",shape=box,color=blue];
		10 -> 13;
		10 -> 14;
	11 [label="Let's say it's just me. Keeps it simpler.",shape=box,color=red];
		11 -> 15;
	12 [label="And why you? Do you have a plan? ",shape=box,color=blue];
		12 -> 16;
	13 [label="I don't really know what to tell you. It's not just the realm of science, or if it is, it's a science that Entrati knows.",shape=box,color=red];
		13 -> 17;
	14 [label="Here's a direction: Stop [End.]",shape=box,color=red];
		14 -> 1022;
	15 [label="As for teaching in schools, if it was I didn't study it. But it might have been? ",shape=box,color=red];
		15 -> 18;
	16 [label="And if not, what can you recommend so I can get any scientific sources on your abilites?",shape=box,color=blue];
		16 -> 19;
	17 [label="Ugh that bastard. I knew I should have asked him more questions. Ok. At least if it's science, it means I can reproduce it, and since you can come and go, I can figure it out. Bye.",shape=box,color=blue];
		17 -> 20;
	1022 [label="+20 Chemistry",color=orange];
		1022 -> 1018;
	18 [label="Why, want some homework? Time travel is probably too advanced for now...",shape=box,color=red];
		18 -> 21;
	19 [label="So many questions, kid.  Hate to break it to you but: I don't know. Only Entrati has the answers.",shape=box,color=red];
		19 -> 22;
	20 [label="+20 Chemistry",color=orange];
		20 -> 1015;
	1018 [label="{\"Id\":1018,\"Incoming\":[1022],\"Outgoing\":[1023],\"GraphPos\":[3236,718],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1018 -> 1023;
	21 [label="Ugh, are you serious?",shape=box,color=blue];
		21 -> 24;
	22 [label="Update boolean KayaSetKid",color=orange];
		22 -> 25;
	1015 [label="{\"Id\":1015,\"Incoming\":[20],\"Outgoing\":[23],\"GraphPos\":[3252,817],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1015 -> 23;
	1023 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	24 [label="Have any of the Hex figured it out? Do they have any info? ",shape=box,color=blue];
		24 -> 26;
		24 -> 27;
	25 [label="K.",shape=box,color=blue];
		25 -> 28;
	23 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	26 [label="Maybe Amir? He probably plays games with time travel plots...",shape=box,color=red];
		26 -> 29;
	27 [label="Don't think so, kid. But if you want to learn something useful, ask Lettie for a 101 on healing.",shape=box,color=red];
		27 -> 30;
	28 [label="+20 Chemistry",color=orange];
		28 -> 996;
	29 [label="Update boolean KayaAmirTravel",color=orange];
		29 -> 32;
