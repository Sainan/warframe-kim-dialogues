	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j2871206983;
	j2871206983 [label="Hi. Can everybody time travel, or just you?",shape=box,color=blue];
		j2871206983 -> j3942430961;
		j2871206983 -> j3528886670;
	j3942430961 [label="Good day to you too, listen kid, it’s not that simple.",shape=box,color=red];
		j3942430961 -> j3364877932;
	j3528886670 [label="Hello? Kaya? How is your day.",shape=box,color=red];
		j3528886670 -> j3619260307;
	j3364877932 [label="I'm not a kid. I'm 19.",shape=box,color=blue];
		j3364877932 -> j2861341954;
		j3364877932 -> j3954318070;
	j3619260307 [label="Fine. ",shape=box,color=blue];
		j3619260307 -> j1710701234;
	j2861341954 [label="Right. Youngest of this new group I'd say, though, kid.",shape=box,color=red];
		j2861341954 -> j433290330;
	j3954318070 [label="Yeah yeah, just don't rush into the time travel thing. It's... complicated.",shape=box,color=red];
		j3954318070 -> j3262348257;
	j1710701234 [label="So. Just you? Are there others? Is time travel taught in schools in the future?",shape=box,color=blue];
		j1710701234 -> j3019316111;
	j433290330 [label="Ugh. Youngest, sure, but also clearly most intent on doing something to find answers. Try and keep up. So: Time travel. How and who?",shape=box,color=blue];
		j433290330 -> j4563622;
	j3262348257 [label="Ugh. How complicated? Formulas? Chemical and atomic elements? I'll figure it out just point me in a direction.",shape=box,color=blue];
		j3262348257 -> j2395647686;
		j3262348257 -> j3779913851;
	j3019316111 [label="Let's say it's just me. Keeps it simpler.",shape=box,color=red];
		j3019316111 -> j1730610389;
	j4563622 [label="And why you? Do you have a plan? ",shape=box,color=blue];
		j4563622 -> j718343296;
	j2395647686 [label="I don't really know what to tell you. It's not just the realm of science, or if it is, it's a science that Entrati knows.",shape=box,color=red];
		j2395647686 -> j1743192026;
	j3779913851 [label="Here's a direction: Stop [End.]",shape=box,color=red];
		j3779913851 -> j2938341431;
	j1730610389 [label="As for teaching in schools, if it was I didn't study it. But it might have been? ",shape=box,color=red];
		j1730610389 -> j466595356;
	j718343296 [label="And if not, what can you recommend so I can get any scientific sources on your abilites?",shape=box,color=blue];
		j718343296 -> j2382616420;
	j1743192026 [label="Ugh that bastard. I knew I should have asked him more questions. Ok. At least if it's science, it means I can reproduce it, and since you can come and go, I can figure it out. Bye.",shape=box,color=blue];
		j1743192026 -> j2938341431;
	j2938341431 [label="+20 Chemistry",color=orange];
		j2938341431 -> "Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue";
	j466595356 [label="Why, want some homework? Time travel is probably too advanced for now...",shape=box,color=red];
		j466595356 -> j70736456;
	j2382616420 [label="So many questions, kid.  Hate to break it to you but: I don't know. Only Entrati has the answers.",shape=box,color=red];
		j2382616420 -> j285977890;
	"Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue" [label="Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue",color=orange];
		"Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue" -> "Chat ends. Next chat will be KayaRank1Convo2.";
	j70736456 [label="Ugh, are you serious?",shape=box,color=blue];
		j70736456 -> j3567266033;
	j285977890 [label="Boolean KayaSetKid is now true.",color=orange];
		j285977890 -> j1219546166;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j3567266033 [label="Have any of the Hex figured it out? Do they have any info? ",shape=box,color=blue];
		j3567266033 -> j1522801768;
		j3567266033 -> j3448119180;
	j1219546166 [label="K.",shape=box,color=blue];
		j1219546166 -> j2938341431;
	j1522801768 [label="Maybe Amir? He probably plays games with time travel plots...",shape=box,color=red];
		j1522801768 -> j431626553;
	j3448119180 [label="Don't think so, kid. But if you want to learn something useful, ask Lettie for a 101 on healing.",shape=box,color=red];
		j3448119180 -> j4054184902;
	j431626553 [label="Boolean KayaAmirTravel is now true.",color=orange];
		j431626553 -> j59560849;
	j4054184902 [label="Boolean KayaLettieHeal is now true.",color=orange];
		j4054184902 -> j594184557;
	j59560849 [label="Games? I just need answers, a direction, anything. I'll figure it out. If you think of anything HELPFUL, find me.",shape=box,color=blue];
		j59560849 -> j2938341431;
	j594184557 [label="Not my style. Whatever.",shape=box,color=blue];
		j594184557 -> j2938341431;
}