	j3567266033 [label="Have any of the Hex figured it out? Do they have any info? ",shape=box,color=blue];
		j3567266033 -> j1825952152;
		j3567266033 -> j789279494;
	j216897697 [label="K.",shape=box,color=blue];
		j216897697 -> j2547432773;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j1825952152 [label="Maybe Amir? He probably plays games with time travel plots...",shape=box,color=red];
		j1825952152 -> j825606714;
	j789279494 [label="Don't think so, kid. But if you want to learn something useful, ask Lettie for a 101 on healing.",shape=box,color=red];
