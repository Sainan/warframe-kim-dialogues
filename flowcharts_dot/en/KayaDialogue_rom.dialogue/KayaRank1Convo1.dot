digraph {
	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j2871206983;
	j2871206983 [label="Hi. Can everybody time travel, or just you?",shape=box,color=blue];
		j2871206983 -> j3942430961;
		j2871206983 -> j3528886670;
	j3942430961 [label="Good day to you too, listen kid, it’s not that simple.",shape=box,color=red];
		j3942430961 -> j3364877932;
	j3528886670 [label="Hello? Kaya? How is your day.",shape=box,color=red];
		j3528886670 -> j3619260307;
	j3364877932 [label="I'm not a kid. I'm 19.",shape=box,color=blue];
		j3364877932 -> j3859531922;
		j3364877932 -> j3954318070;
	j3619260307 [label="Fine. ",shape=box,color=blue];
		j3619260307 -> j1710701234;
	j3859531922 [label="Right. Youngest of this new group I'd say, though, kid.",shape=box,color=red];
		j3859531922 -> j3361339688;
	j3954318070 [label="Yeah yeah, just don't rush into the time travel thing. It's... complicated.",shape=box,color=red];
		j3954318070 -> j3262348257;
	j1710701234 [label="So. Just you? Are there others? Is time travel taught in schools in the future?",shape=box,color=blue];
		j1710701234 -> j3019316111;
	j3361339688 [label="Ugh. Youngest, sure, but also clearly most intent on doing something to find answers. Try and keep up. So: Time travel. How and who?",shape=box,color=blue];
		j3361339688 -> j143046502;
	j3262348257 [label="Ugh. How complicated? Formulas? Chemical and atomic elements? I'll figure it out just point me in a direction.",shape=box,color=blue];
		j3262348257 -> j194801737;
		j3262348257 -> j317738574;
	j3019316111 [label="Let's say it's just me. Keeps it simpler.",shape=box,color=red];
		j3019316111 -> j1730610389;
	j143046502 [label="And why you? Do you have a plan? ",shape=box,color=blue];
		j143046502 -> j2870595315;
	j194801737 [label="I don't really know what to tell you. It's not just the realm of science, or if it is, it's a science that Entrati knows.",shape=box,color=red];
		j194801737 -> j1198731927;
	j317738574 [label="Here's a direction: Stop [End.]",shape=box,color=red];
	j1730610389 [label="As for teaching in schools, if it was I didn't study it. But it might have been? ",shape=box,color=red];
		j1730610389 -> j466595356;
	j2870595315 [label="And if not, what can you recommend so I can get any scientific sources on your abilites?",shape=box,color=blue];
		j2870595315 -> j510229508;
	j1198731927 [label="Ugh that bastard. I knew I should have asked him more questions. Ok. At least if it's science, it means I can reproduce it, and since you can come and go, I can figure it out. Bye.",shape=box,color=blue];
		j1198731927 -> j2547432773;
	j466595356 [label="Why, want some homework? Time travel is probably too advanced for now...",shape=box,color=red];
		j466595356 -> j70736456;
	j510229508 [label="So many questions, kid.  Hate to break it to you but: I don't know. Only Entrati has the answers.",shape=box,color=red];
		j510229508 -> j2507192691;
	j2547432773 [label="+20 Chemistry",color=orange];
		j2547432773 -> "Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue";
	j70736456 [label="Ugh, are you serious?",shape=box,color=blue];
		j70736456 -> j3567266033;
