		30 -> 33;
	996 [label="{\"Id\":996,\"Incoming\":[28],\"Outgoing\":[31],\"GraphPos\":[4241,541],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		996 -> 31;
	32 [label="Games? I just need answers, a direction, anything. I'll figure it out. If you think of anything HELPFUL, find me.",shape=box,color=blue];
		32 -> 34;
	33 [label="Not my style. Whatever.",shape=box,color=blue];
		33 -> 35;
