	843 [label="If I had Zylo with me... this trip would be a lot easier.",shape=box,color=blue];
		843 -> 848;
	849 [label="And not JUST me. All of us. And Loid, Gomaitru... it's sickening. I don't know if I'll be able to hold back if I see him.",shape=box,color=red];
