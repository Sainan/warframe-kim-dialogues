digraph {
	"LoidRank1Convo1 begins." [color=orange];
		"LoidRank1Convo1 begins." -> j4030344503;
	j4030344503 [label="Drifter. Forgive me for the impropriety of this imposition, I did not wish to contact you using this device. But this is verging on an emergency and I did not know to whom else I could turn.",shape=box,color=blue];
		j4030344503 -> j2628737416;
		j4030344503 -> j2797458674;
	j2628737416 [label="POM2_LAB1?",shape=box,color=red];
		j2628737416 -> j2998182249;
	j2797458674 [label="Who is this...?",shape=box,color=red];
		j2797458674 -> j2998182249;
	j2998182249 [label="Ah, yes. This is still on default settings. This is Loid. I should have... led with that, but matters here in the Sanctum Anatomica have been deeply chaotic of late.",shape=box,color=blue];
		j2998182249 -> j397851011;
	j397851011 [label="Which is why I am contacting you. I am in need of your assistance. Three protoframes have arrived here, in the Sanctum, in my time. And not ones previously known to us.",shape=box,color=blue];
		j397851011 -> j3382400454;
	j3382400454 [label="One of them is an",shape=box,color=blue];
		j3382400454 -> j1906641705;
	j1906641705 [label="Apologies",shape=box,color=blue];
		j1906641705 -> j2982013912;
	j2982013912 [label="One of them is Orokin, Drifter.",shape=box,color=blue];
		j2982013912 -> j1405556009;
		j2982013912 -> j194160605;
		j2982013912 -> j952787493;
	j1405556009 [label="Where's the Lotus?",shape=box,color=red];
		j1405556009 -> j189340548;
	j194160605 [label="Oh, no... ",shape=box,color=red];
		j194160605 -> j1350646366;
	j952787493 [label="What?!",shape=box,color=red];
		j952787493 -> j1350646366;
	j189340548 [label="The Lotus and the Operator have other matters to attend to, believe me. They have been taxed well and truly enough to their limits as it is. I would not ask you to help me with these matters if I felt I had anywhere else to turn.",shape=box,color=blue];
		j189340548 -> j3693550221;
	j1350646366 [label="I would not ask you to help me with these matters if I felt I had anywhere else to turn. You are... seemingly the new expert in matters of this kind.",shape=box,color=blue];
		j1350646366 -> j2612241998;
	j3693550221 [label="You are... seemingly the new expert in matters of this kind.",shape=box,color=blue];
		j3693550221 -> j2612241998;
	j2612241998 [label="I do not know how best to describe them. But if you come to the Sanctum, I believe it will be hard to miss them. Two of them have agreed to speak to you here on the POM-2. One may need some further convincing.",shape=box,color=blue];
		j2612241998 -> j480927686;
	j480927686 [label="I have... faith... you will be successful.",shape=box,color=blue];
		j480927686 -> j3173882;
	j3173882 [label="Boolean LoidTriadAvailable is now true.",color=orange];
		j3173882 -> "Chat ends. Next chat will be LoidFamily.";
	"Chat ends. Next chat will be LoidFamily." [color=orange];
}