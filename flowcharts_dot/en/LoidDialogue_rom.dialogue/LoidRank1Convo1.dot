digraph {
	0 [label="LoidRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Drifter. Forgive me for the impropriety of this imposition, I did not wish to contact you using this device. But this is verging on an emergency and I did not know to whom else I could turn.",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="POM2_LAB1?",shape=box,color=red];
		2 -> 4;
	3 [label="Who is this...?",shape=box,color=red];
		3 -> 4;
	4 [label="Ah, yes. This is still on default settings. This is Loid. I should have... led with that, but matters here in the Sanctum Anatomica have been deeply chaotic of late.",shape=box,color=blue];
		4 -> 5;
	5 [label="Which is why I am contacting you. I am in need of your assistance. Three protoframes have arrived here, in the Sanctum, in my time. And not ones previously known to us.",shape=box,color=blue];
		5 -> 6;
	6 [label="One of them is an",shape=box,color=blue];
		6 -> 7;
	7 [label="Apologies",shape=box,color=blue];
		7 -> 8;
	8 [label="One of them is Orokin, Drifter.",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
		8 -> 11;
	9 [label="Where's the Lotus?",shape=box,color=red];
		9 -> 12;
	10 [label="Oh, no... ",shape=box,color=red];
		10 -> 13;
	11 [label="What?!",shape=box,color=red];
		11 -> 13;
	12 [label="The Lotus and the Operator have other matters to attend to, believe me. They have been taxed well and truly enough to their limits as it is. I would not ask you to help me with these matters if I felt I had anywhere else to turn.",shape=box,color=blue];
		12 -> 14;
	13 [label="I would not ask you to help me with these matters if I felt I had anywhere else to turn. You are... seemingly the new expert in matters of this kind.",shape=box,color=blue];
		13 -> 15;
	14 [label="You are... seemingly the new expert in matters of this kind.",shape=box,color=blue];
		14 -> 15;
	15 [label="I do not know how best to describe them. But if you come to the Sanctum, I believe it will be hard to miss them. Two of them have agreed to speak to you here on the POM-2. One may need some further convincing.",shape=box,color=blue];
		15 -> 16;
	16 [label="I have... faith... you will be successful.",shape=box,color=blue];
		16 -> 29;
	29 [label="Update boolean LoidTriadAvailable",color=orange];
		29 -> 17;
	17 [label="Chat ends. Next chat will be LoidFamily.",color=orange];
}