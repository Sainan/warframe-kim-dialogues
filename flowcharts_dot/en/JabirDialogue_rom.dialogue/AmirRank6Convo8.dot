		j1301864678 -> j3131522606;
	j3131522606 [label="\"You stand in the middle of the electrical lab with the now free Zabir. He looks at you, 'there's no time to waste, follow me.'\"",shape=box,color=blue];
		j3131522606 -> j2618117225;
	j2618117225 [label="\"He leads you through corridor after corridor. He knows this asteroid like the back of his hand, every guard and their movements.\"",shape=box,color=blue];
		j2618117225 -> j3308647778;
		j2618117225 -> j1596915634;
		j2618117225 -> j2136566655;
	j3308647778 [label="Ask Zabir about the rats.",shape=box,color=red];
		j3308647778 -> j2317673039;
	j1596915634 [label="Is he a prisoner too?",shape=box,color=red];
		j1596915634 -> j474725522;
	j2136566655 [label="Where is Zabir taking me?",shape=box,color=red];
		j2136566655 -> j1752439480;
	j2317673039 [label="\"Zabir is shocked. 'The rats found you? That’s amazing. It worked. Check it.' Zabir holds up an intricately embossed gold whistle. 'Rat Queen gave it to me. We need to find her.'\"",shape=box,color=blue];
		j2317673039 -> j1411656700;
	j474725522 [label="\"You ask Zabir how he got here, 'No time for that,' he says, ‘we need to focus on getting out of here.'\"",shape=box,color=blue];
		j474725522 -> j3308647778;
		j474725522 -> j2136566655;
	j1752439480 [label="\"Zabir looks back, 'Taking you to the hangar bay. We steal a ship and we get as far away from here as possible. Find the Rat Queen.'\"",shape=box,color=blue];
		j1752439480 -> j1411656700;
	j1411656700 [label="RAT QUEEN?",shape=box,color=red];
		j1411656700 -> j3682438837;
	j3682438837 [label="\"'She gave me this whistle. The rats listen to it. She’s my friend. She’s not always nice, but she cares.'\"",shape=box,color=blue];
		j3682438837 -> j1023891238;
		j3682438837 -> j3730832739;
	j1023891238 [label="Have you shown this to Lettie by any chance?",shape=box,color=red];
		j1023891238 -> j3137992034;
	j3730832739 [label="She sounds familiar, too.",shape=box,color=red];
		j3730832739 -> j3851017045;
	j3137992034 [label="i value my life too much to risk that",shape=box,color=blue];
		j3137992034 -> j2593048948;
	j3851017045 [label="any resemblance to people real or imagined is merely a coincidence",shape=box,color=blue];
		j3851017045 -> j2593048948;
	j2593048948 [label="\"With Zabir's help you zigzag through the asteroid's corridors. He deftly dodges guards and security cameras.\"",shape=box,color=blue];
		j2593048948 -> j397335452;
	j397335452 [label="\"Eventually, you come to a large door. Zabir signals to get low. You both crouch down as sneak into the ship’s hangar.\"",shape=box,color=blue];
		j397335452 -> j909318506;
	j909318506 [label="\"You crouch in the shadow of a pillar. Grineer guards can be heard nearby.\"",shape=box,color=blue];
		j909318506 -> j796376164;
	j796376164 [label="\"What do you do?\"",shape=box,color=blue];
		j796376164 -> j3344790315;
		j796376164 -> j3650397563;
	j3344790315 [label="Attack the guards.",shape=box,color=red];
		j3344790315 -> j139398752;
	j3650397563 [label="Look around.",shape=box,color=red];
		j3650397563 -> j3308339167;
	j139398752 [label="\"Without an ounce of self-preservation or forethought you run out into the open. A group of guards on the other side starts blasting. You charge head long into a stream of bullets that kill you instantly. Zabir shakes his head at your senseless act of stubborn bravery.\"",shape=box,color=blue];
		j139398752 -> j3626998615;
	j3308339167 [label="\"You peek around the corner and survey the area.\"",shape=box,color=blue];
