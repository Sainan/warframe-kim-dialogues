		j3626998615 -> j3415096322;
	j944665330 [label="\"A Railjack is parked in the center of the hangar. The ramp into the Railjack is blocked by a guard. On one side of the hangar a dozen Grineer are busy playing a raucous game of dice. A few feet in front of you is a desk with a control panel.\"",shape=box,color=blue];
