	4267 [label="Chat ends.",color=orange];
	4268 [label="“You find yourself in front of a large service elevator. This is no mere dungeon?”",shape=box,color=blue];
		4268 -> 4269;
		4268 -> 4270;
	4269 [label="Return to the dungeon.",shape=box,color=red];
		4269 -> 4271;
	4270 [label="Take the elevator.",shape=box,color=red];
		4270 -> 4272;
	4271 [label="“You turn around and look at the dungeon, thinking to yourself ‘going back in there is a dumb idea.’”",shape=box,color=blue];
		4271 -> 4273;
	4272 [label="“You ride the elevator up. Through its open cage you can see the stone walls of the dungeon being replaced by more and more advanced technology. You wonder again, ‘where the hell am I?’”",shape=box,color=blue];
		4272 -> 4274;
	4273 [label="haha... Fine, take that elevator.",shape=box,color=red];
		4273 -> 4272;
	4274 [label="“The elevator exits into a hall of gurgling machines, and giant tubes. Is this some sort of laboratory?”",shape=box,color=blue];
		4274 -> 4275;
	4275 [label="From a room down the hall, you hear a man crying out in pain.",shape=box,color=blue];
		4275 -> 4276;
		4275 -> 4277;
	4276 [label="Ignore the cries, find a way out.",shape=box,color=red];
		4276 -> 4278;
	4277 [label="Go to the crying man.",shape=box,color=red];
		4277 -> 4279;
	4278 [label="\"You search around the hall for anything of value, but the cries become impossible to ignore. You are drawn to this man and must help him.\"",shape=box,color=blue];
		4278 -> 4279;
	4279 [label="“You walk down the hall following the source of the agonizing screams. You enter a large mechanical room, there you see a man. A not unattractive man, who is strapped to a machine. Bolts of electricity dance out of his fingers feeding a giant turbine.”",shape=box,color=blue];
		4279 -> 4280;
		4279 -> 4281;
	4280 [label="Ask, \"what's up?\"",shape=box,color=red];
		4280 -> 4282;
	4281 [label="Examine the man.",shape=box,color=red];
		4281 -> 4282;
	4282 [label="\"The man is strapped to a raised platform, arms splayed out. Attached to his fingertips are probes that twist together into a heavy gauge cable that lead to a giant turbine. Arcs of electricity dance nimbly from his hands.\"",shape=box,color=blue];
		4282 -> 4283;
	4283 [label="Between cries and zaps the man manages to say, \"STOP... THE... TURBINES!!\"",shape=box,color=blue];
