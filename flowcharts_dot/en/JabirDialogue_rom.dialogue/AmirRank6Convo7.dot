		j3370928784 -> j889458608;
	j387326326 [label="\"You notice his strong hands, ample foreams, and wirery legs. 'Built for speed' you think with eyebrows raised.\"",shape=box,color=blue];
		j387326326 -> j2104930464;
	j3138027737 [label="\"Name's Zabir. He says, confidently.\"",shape=box,color=blue];
		j3138027737 -> j652852575;
	j889458608 [label="\"Removing his circular glasses, the man takes a long look at the person who was trying to save him.\"",shape=box,color=blue];
		j889458608 -> j3499241272;
	j2104930464 [label="Settle down there big guy. What's this handsome man's name?",shape=box,color=red];
		j2104930464 -> j3138027737;
