		j2954329399 -> "Chat ends.";
	j3134602748 [label="“As you turn the key given to you by a surprisingly cordial gang of oversized rats, you pray that whatever is beyond the door is better than the dungeon that lay behind you.”",shape=box,color=blue];
		j3134602748 -> j235768666;
	"Chat ends. Next chat will be AmirRank6Convo3." [color=orange];
	"Chat ends. Next chat will be AmirRank6Convo2." [color=orange];
	j235768666 [label="“You find yourself in front of a large service elevator. This is no mere dungeon?”",shape=box,color=blue];
		j235768666 -> j2395396906;
		j235768666 -> j2366304333;
	j2395396906 [label="Return to the dungeon.",shape=box,color=red];
		j2395396906 -> j1579842175;
	j2366304333 [label="Take the elevator.",shape=box,color=red];
		j2366304333 -> j4277505320;
	j1579842175 [label="“You turn around and look at the dungeon, thinking to yourself ‘going back in there is a dumb idea.’”",shape=box,color=blue];
		j1579842175 -> j1138208872;
	j4277505320 [label="“You ride the elevator up. Through its open cage you can see the stone walls of the dungeon being replaced by more and more advanced technology. You wonder again, ‘where the hell am I?’”",shape=box,color=blue];
		j4277505320 -> j3477801055;
	j1138208872 [label="haha... Fine, take that elevator.",shape=box,color=red];
		j1138208872 -> j4277505320;
	j3477801055 [label="“The elevator exits into a hall of gurgling machines, and giant tubes. Is this some sort of laboratory?”",shape=box,color=blue];
		j3477801055 -> j2488654532;
	j2488654532 [label="From a room down the hall, you hear a man crying out in pain.",shape=box,color=blue];
		j2488654532 -> j8720586;
		j2488654532 -> j481207438;
	j8720586 [label="Ignore the cries, find a way out.",shape=box,color=red];
		j8720586 -> j2192990239;
	j481207438 [label="Go to the crying man.",shape=box,color=red];
		j481207438 -> j1945165031;
	j2192990239 [label="\"You search around the hall for anything of value, but the cries become impossible to ignore. You are drawn to this man and must help him.\"",shape=box,color=blue];
		j2192990239 -> j1945165031;
	j1945165031 [label="“You walk down the hall following the source of the agonizing screams. You enter a large mechanical room, there you see a man. A not unattractive man, who is strapped to a machine. Bolts of electricity dance out of his fingers feeding a giant turbine.”",shape=box,color=blue];
		j1945165031 -> j3139327230;
		j1945165031 -> j1187275805;
	j3139327230 [label="Ask, \"what's up?\"",shape=box,color=red];
		j3139327230 -> j2745686492;
	j1187275805 [label="Examine the man.",shape=box,color=red];
		j1187275805 -> j2745686492;
	j2745686492 [label="\"The man is strapped to a raised platform, arms splayed out. Attached to his fingertips are probes that twist together into a heavy gauge cable that lead to a giant turbine. Arcs of electricity dance nimbly from his hands.\"",shape=box,color=blue];
		j2745686492 -> j1131040134;
	j1131040134 [label="Between cries and zaps the man manages to say, \"STOP... THE... TURBINES!!\"",shape=box,color=blue];
		j1131040134 -> j581943601;
	j581943601 [label="Examine the room.",shape=box,color=red];
		j581943601 -> j2974814074;
	j2974814074 [label="\"You look around the room for something useful. You see a bench with tools. A crowbar. Giant wirecutters. A control panel.\"",shape=box,color=blue];
		j2974814074 -> j1571667540;
