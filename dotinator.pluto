local { json } = require "*"

local dict, nodes

local function format_script_data(data)
	local str = data.Script .. ":" .. data.Function
	local args = {}
	if data.Function == "IsResetCounterGreaterThan" then
		args = { data._counter }
	else
		for data.__order as k do
			local v = data[k]
			if k:startswith("_") then
				if (type(v) == "string" and v ~= "") or (type(v) == "number" and v ~= 0) then
					args:insert(k:sub(2) .. "=" .. v)
				end
			end
		end
	end
	if #args ~= 0 then
		str ..= "(" .. args:concat(", ") .. ")"
	end
	return str
end

local function get_node_label(node)
	switch node.type do
		case "/EE/Types/Engine/ChemistryDialogueNode":
			return $"+{node.ChemistryDelta} Chemistry"
		case "/EE/Types/Engine/SetBooleanDialogueNode":
			return $"Boolean {node.Content} is now true."
		case "/EE/Types/Engine/ResetBooleanDialogueNode":
			return $"Boolean {node.Content} is now false."
		case "/EE/Types/Engine/IncCounterDialogueNode":
			do
				local arr = node.Content:split(" ")
				return $"Add {arr[2]} to {arr[1]} counter"
			end
			break
		case "/EE/Types/Engine/CheckBooleanDialogueNode":
			return $"Check boolean {node.Content}"
		case "/EE/Types/Engine/CheckBooleanScriptDialogueNode":
			return $"Check {format_script_data(node.Script)}"
		case "/EE/Types/Engine/CheckMultiBooleanDialogueNode":
			if #node.Outputs == 1 then
				return $"Evaluate expression: {node.Outputs[1].Expression}"
			end
			return "Evaluate expressions"
		case "/EE/Types/Engine/CheckCounterDialogueNode":
			return $"Evaluate expressions on {node.CounterName} counter"
		case "/EE/Types/Engine/DialogueNode":
		case "/EE/Types/Engine/PlayerChoiceDialogueNode":
			if node.Content then
				local text = (dict[node.Content] or node.Content)
				--[[if node.vars then
					for k, v in node.vars do
						text = text:replace("|"..k.."|", dict[v] or v)
					end
				end]]
				if node.Speaker then
					text = (dict[node.Speaker] or node.Speaker)..": "..text
				end
				return text:replace("<RETRO_EMOJI_HEART>", "<3")
			else
				return json.encode(node)
			end
			break
		case "/EE/Types/Engine/EndDialogueNode":
			return node.Content ? $"Chat ends. Next chat will be {node.Content}." : "Chat ends."
		case "/EE/Types/Engine/StartDialogueNode":
			return node.Content.." begins."
		case "/EE/Types/Engine/SpecialCompletionDialogueNode":
			if !node.OtherDialogueInfos or #node.OtherDialogueInfos == 0 then
				assert(#node.Outgoing == 1)
				return get_node_label(nodes[1 + node.Outgoing[1]])
			end
			if node.OtherDialogueInfos and #node.OtherDialogueInfos == 1 and node.OtherDialogueInfos[1].Value == 0 then
				return "Initiate conversation "..node.OtherDialogueInfos[1].Tag.." in "..node.OtherDialogueInfos[1].Dialogue
			end
			return json.encode(node)
		case "/EE/Types/Engine/ScriptDialogueNode":
			return $"Invoke {format_script_data(node.Script)}"
		default:
			return json.encode(node)
	end
end

local function joaat(str, hash)
	for i = 1, #str do
		hash = (hash + str:byte(i)) & 0xff_ff_ff_ff
		hash = (hash + (hash << 10)) & 0xff_ff_ff_ff
		hash = (hash ~ (hash >> 6)) & 0xff_ff_ff_ff
	end
	hash = (hash + (hash << 3)) & 0xff_ff_ff_ff
	hash = (hash ~ (hash >> 11)) & 0xff_ff_ff_ff
	hash = (hash + (hash << 15)) & 0xff_ff_ff_ff
	return hash
end

local function get_node_name(node)
	if node.type == "/EE/Types/Engine/EndDialogueNode" or node.type == "/EE/Types/Engine/SpecialCompletionDialogueNode" or node.type == "/EE/Types/Engine/StartDialogueNode" then
		return '"'..get_node_label(node):replace('"', '\\"')..'"'
	end

	local hash = joaat(node.type, 0)
	hash = joaat(get_node_label(node), hash)
	local n = node
	while n.Outgoing and #n.Outgoing == 1 do
		n = nodes[1 + n.Outgoing[1]]
		hash = joaat(n.type, hash)
		hash = joaat(get_node_label(n), hash)
		if n.type == "/EE/Types/Engine/EndDialogueNode" then
			-- This node goes straight to the end.
			return "j"..tostring(hash)
		end
	end

	-- Merge nodes with the same type + label + outgoing edges (e.g. LettieRank5Convo4 has 2x "+5 Chemistry" with the same outgoing edges.)
	if node.Outgoing then
		for node.Outgoing as choice do
			hash = joaat(tostring(choice), hash)
		end
	elseif node.TrueNodes then
		for node.TrueNodes as choice do
			hash = joaat(tostring(choice), hash)
		end
		if node.FalseNodes then
			for node.FalseNodes as choice do
				hash = joaat(tostring(choice), hash)
			end
		end
	elseif node.Outputs then
		for node.Outputs as output do
			for output.Outgoing as choice do
				hash = joaat(tostring(choice), hash)
			end
		end
	end
	return "j"..tostring(hash)
end

local function emit_dot(filename, start)
	local pending_nodes = { start }
	local emitted_nodes = {}

	local fh <close> = io.open(filename, "w")
	fh:write("digraph {\n")
	local function write_node_name(node)
		fh:write(get_node_name(node))
	end
	local function write_node_label(node)
		fh:write('"')
		fh:write(get_node_label(node):replace("\\", "\\\\"):replace('"', '\\"'):replace("\r\n", "\\n"))
		fh:write('"')
	end
	while #pending_nodes ~= 0 do
		local node_id = pending_nodes:remove()
		local node = nodes[1 + node_id]
		local node_name = get_node_name(node)

		if emitted_nodes[node_name] then
			continue
		end
		emitted_nodes[node_name] = true

		fh:write("\t")
		fh:write(node_name)
		switch node.type do
			case "/EE/Types/Engine/DialogueNode":
				fh:write(" [label=")
				write_node_label(node)
				fh:write(",shape=box,color=blue];\n")
				break
			case "/EE/Types/Engine/PlayerChoiceDialogueNode":
				fh:write(" [label=")
				write_node_label(node)
				fh:write(",shape=box,color=red];\n")
				break
			case "/EE/Types/Engine/StartDialogueNode":
			case "/EE/Types/Engine/EndDialogueNode":
				fh:write(" [color=orange];\n")
				break
			case "/EE/Types/Engine/SpecialCompletionDialogueNode":
				if !node.OtherDialogueInfos or #node.OtherDialogueInfos == 0 then
					fh:write(" [color=orange];\n")
					continue -- Don't write transition to EndDialogueNode
				end
				--@fallthrough
			default:
				fh:write(" [label=")
				write_node_label(node)
				fh:write(",color=orange];\n")
				break
		end

		if node.Outgoing then
			for node.Outgoing as choice do
				fh:write("\t\t")
				fh:write(node_name)
				fh:write(" -> ")
				write_node_name(nodes[1 + choice])
				fh:write(";\n")
				pending_nodes:insert(1, choice)
			end
		elseif node.TrueNodes then
			for node.TrueNodes as choice do
				fh:write("\t\t")
				fh:write(node_name)
				fh:write(" -> ")
				write_node_name(nodes[1 + choice])
				fh:write(" [label=true,color=green];\n")
				pending_nodes:insert(1, choice)
			end
			if node.FalseNodes then
				for node.FalseNodes as choice do
					fh:write("\t\t")
					fh:write(node_name)
					fh:write(" -> ")
					write_node_name(nodes[1 + choice])
					fh:write(" [label=false,color=brown];\n")
					pending_nodes:insert(1, choice)
				end
			end
		elseif node.Outputs then
			for node.Outputs as output do
				for output.Outgoing as choice do
					fh:write("\t\t")
					fh:write(node_name)
					fh:write(" -> ")
					write_node_name(nodes[1 + choice])
					fh:write(" [label=\""..output.Expression.."\",color=purple];\n")
					pending_nodes:insert(1, choice)
				end
			end
		end
	end
	fh:write("}")
end

local DIAG_NAMES <const> = {
	"AoiDialogue_rom.dialogue",
	"ArthurDialogue_rom.dialogue",
	"EleanorDialogue_rom.dialogue",
	"FlareDialogue_rom.dialogue",
	"HexDialogue_rom.dialogue",
	"JabirDialogue_rom.dialogue",
	"KayaDialogue_rom.dialogue",
	"LettieDialogue_rom.dialogue",
	"LoidDialogue_rom.dialogue",
	"LyonDialogue_rom.dialogue",
	"MarieDialogue_rom.dialogue",
	"MinervaDialogue_rom.dialogue",
	"MinervaVelemirDialogue_rom.dialogue",
	"QuincyDialogue_rom.dialogue",
	"RoatheDialogue_rom.dialogue",
	"VelimirDialogue_rom.dialogue",
}

local diags = {}
for DIAG_NAMES as diag_name do
	diags[diag_name] = json.decode(io.contents("data/"..diag_name..".json"), json.withorder)
end

io.makedir("flowcharts")
io.makedir("flowcharts_dot")
io.makedir("flowcharts_svg")
for { "en", "de", "es", "fr", "it", "ja", "ko", "pl", "pt", "ru", "tc", "th", "tr", "uk", "zh" } as lang do
	print(lang)

	dict = io.contents("dicts/"..lang..".json") |> json.decode

	io.makedir("flowcharts_dot/"..lang)
	io.makedir("flowcharts_svg/"..lang)

	for DIAG_NAMES as diag_name do
		print("\t"..diag_name)

		nodes = diags[diag_name]

		io.makedir("flowcharts/"..diag_name)
		io.makedir("flowcharts_dot/"..lang.."/"..diag_name)
		io.makedir("flowcharts_svg/"..lang.."/"..diag_name)

		for nodes as node do
			if node.type == "/EE/Types/Engine/StartDialogueNode" then
				print("\t\t"..node.Content)
				local prev_dot = io.contents("flowcharts_dot/"..lang.."/"..diag_name.."/"..node.Content..".dot")
				emit_dot("flowcharts_dot/"..lang.."/"..diag_name.."/"..node.Content..".dot", node.Id)
				if prev_dot ~= io.contents("flowcharts_dot/"..lang.."/"..diag_name.."/"..node.Content..".dot") then
					if lang == "en" then
						os.execute("dot flowcharts_dot/"..lang.."/"..diag_name.."/"..node.Content..".dot -T png -o flowcharts/"..diag_name.."/"..node.Content..".png")
					end
					os.execute("dot flowcharts_dot/"..lang.."/"..diag_name.."/"..node.Content..".dot -T svg -o flowcharts_svg/"..lang.."/"..diag_name.."/"..node.Content..".svg")
				end
			end
		end
	end
end
